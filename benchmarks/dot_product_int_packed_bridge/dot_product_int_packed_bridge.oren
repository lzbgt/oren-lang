import list "std:list"
import buffer "std:buffer"
import linalg "std:linalg"

fn _parse_u64(s) {
    if s == nil { return 0 }
    var bs = oren_bytes_from_string(s)
    if bs == nil || oren_list_len(bs) == 0 { return 0 }
    var i = 0
    var out = 0
    while i < oren_list_len(bs) {
        var c = bs[i]
        if c < 48 || c > 57 { return 0 }
        out = out * 10 + (c - 48)
        i = i + 1
    }
    return out
}

fn _env_truthy(key) {
    var v = oren_env(key)
    if v == nil { return false }
    if v == "" { return false }
    if v == "0" { return false }
    return true
}

fn main() {
    var args = oren_args()
    var n = 2000000
    var reps = 1
    if oren_list_len(args) >= 2 {
        var v = oren_trunc_int(_parse_u64(args[1]))
        if v >= 0 { n = v }
    }
    if oren_list_len(args) >= 3 {
        var r = oren_trunc_int(_parse_u64(args[2]))
        if r >= 0 { reps = r }
    }

    var a = list.int_new(n)
    var b = list.int_new(n)
    var i = 0
    while i < n {
        list.int_push(a, (i * 3 + 1) % 1000)
        list.int_push(b, (i * 7 + 2) % 1000)
        i = i + 1
    }

    var scalar = _env_truthy("OREN_BENCH_PACKED_BRIDGE_SCALAR")
    var sum = 0
    if scalar {
        var rep = 0
        while rep < reps {
            sum = linalg.dot_i32_list_int_packed(a, b)
            rep = rep + 1
        }
    } else {
        var packed_a: []i32 = buffer.i32_pack_list_int(a)
        if oren_is_err(packed_a) {
            print("dot_product_int_packed_bridge pack A failed")
            return 1
        }
        var packed_b: []i32 = buffer.i32_pack_list_int(b)
        if oren_is_err(packed_b) {
            print("dot_product_int_packed_bridge pack B failed")
            return 1
        }
        var rep2 = 0
        while rep2 < reps {
            sum = linalg.dot_i32_buf(packed_a, packed_b)
            rep2 = rep2 + 1
        }
    }

    print(sum)
    return 0
}
