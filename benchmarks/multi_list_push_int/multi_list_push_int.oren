import list "std:list"

fn main() {
    var n = 2000000
    var xs = list.int_new(n)
    var ys = list.int_new(n)
    var zs = list.int_new(n)

    var i = 0
    while i < n {
        list.int_push(xs, (i * 3 + 7) % 1000)
        list.int_push(ys, (i * 5 + 11) % 1000)
        list.int_push(zs, (i * 7 + 13) % 1000)
        i = i + 1
    }

    var sum = 0
    i = 0
    while i < n {
        sum = sum + list.int_get(xs, i)
        sum = sum + list.int_get(ys, i)
        sum = sum + list.int_get(zs, i)
        i = i + 1
    }

    print(sum)
    return 0
}
