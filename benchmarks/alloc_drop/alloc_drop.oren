fn main() {
    var fallback = 10000
    var env = oren_env("OREN_BENCH_ITERS")
    var iters = fallback
    if env != nil {
        var n = 0
        var i = 0
        var neg = 0
        if oren_string_len(env) > 0 {
            var b0 = oren_string_char_code_at(env, 0)
            if b0 == 45 { neg = 1; i = 1 }
            if b0 == 43 { i = 1 }
        }
        while i < oren_string_len(env) {
            var b = oren_string_char_code_at(env, i)
            if b < 48 || b > 57 { break }
            n = n * 10 + (b - 48)
            i = i + 1
        }
        if neg == 1 { n = 0 - n }
        if n != 0 { iters = n }
    }

    var keep = []
    var keep_mod = 0

    var i = 0
    while i < iters {
        var s = "s" + oren_int_to_string(i)
        var l = [i, s, i + 1, s + "x"]
        if keep_mod == 0 {
            oren_list_push(keep, l)
        }
        keep_mod = keep_mod + 1
        if keep_mod == 97 { keep_mod = 0 }

        if (i % 1000) == 0 { keep = [] }
        i = i + 1
    }

    print("alloc_drop keep=" + oren_int_to_string(oren_list_len(keep)))
}
