fn _env_int(key, fallback) {
    var env = oren_env(key)
    var out = fallback
    if env != nil {
        var n = 0
        var i = 0
        var neg = 0
        if oren_string_len(env) > 0 {
            var b0 = oren_string_char_code_at(env, 0)
            if b0 == 45 { neg = 1; i = 1 }
            if b0 == 43 { i = 1 }
        }
        while i < oren_string_len(env) {
            var b = oren_string_char_code_at(env, i)
            if b < 48 || b > 57 { break }
            n = n * 10 + (b - 48)
            i = i + 1
        }
        if neg == 1 { n = 0 - n }
        if n != 0 { out = n }
    }
    return out
}

fn main() {
    // Allocation churn to surface leaks / GC regressions.
    // Note: we trigger GC periodically to keep live set bounded.
    var n = _env_int("OREN_BENCH_ITERS", 20000)
    var gc_every = _env_int("OREN_BENCH_GC_EVERY", 0)
    var clear_list = _env_int("OREN_BENCH_CLEAR_LIST", 0)
    var small_ints = _env_int("OREN_BENCH_SMALL_INTS", 0)
    var force_list_int = _env_int("OREN_BENCH_FORCE_LIST_INT", 0)
    var list_len = _env_int("OREN_BENCH_LIST_LEN", 128)
    var gc_count = 0
    var i = 0
    var acc = 0
    while i < n {
        var xs = []
        if force_list_int != 0 { xs = oren_new_list_int(0) }
        var j = 0
        while j < list_len {
            var v = i + j
            if small_ints != 0 { v = j }
            if force_list_int != 0 { oren_list_int_push(xs, v) }
            else { oren_list_push(xs, v) }
            j = j + 1
        }
        if force_list_int != 0 { acc = acc + oren_list_int_get(xs, 0) }
        else { acc = acc + xs[0] }
        if gc_every > 0 && i > 0 {
            gc_count = gc_count + 1
            if gc_count == gc_every {
                gc_count = 0
                oren_gc_collect()
            }
        }
        if clear_list != 0 { xs = nil }
        i = i + 1
    }
    print(acc)
}
