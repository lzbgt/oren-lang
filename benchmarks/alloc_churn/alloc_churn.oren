fn _alloc_churn_list_int(n, gc_every, clear_list, small_ints, list_len) {
    var acc = 0
    if clear_list != 0 {
        var gc_count = 0
        var i = 0
        while i < n {
            var xs = oren_new_list_int(0)
            var j = 0
            while j < list_len {
                var v = i + j
                if small_ints != 0 { v = j }
                oren_list_int_push(xs, v)
                j = j + 1
            }
            acc = acc + oren_list_int_get(xs, 0)
            if gc_every > 0 && i > 0 {
                gc_count = gc_count + 1
                if gc_count == gc_every {
                    gc_count = 0
                    oren_gc_collect()
