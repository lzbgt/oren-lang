fn main() {
    // Allocation churn to surface leaks / GC regressions.
    // Note: we trigger GC periodically to keep live set bounded.
    var n = _env_int("OREN_BENCH_ITERS", 20000)
    var gc_every = _env_int("OREN_BENCH_GC_EVERY", 0)
    var clear_list = _env_int("OREN_BENCH_CLEAR_LIST", 0)
    var small_ints = _env_int("OREN_BENCH_SMALL_INTS", 0)
    var force_list_int = _env_int("OREN_BENCH_FORCE_LIST_INT", 0)
    var list_len = 128
    var list_len_override = 0
    var list_len_env = oren_env("OREN_BENCH_LIST_LEN")
    if list_len_env != nil {
        list_len = _env_int("OREN_BENCH_LIST_LEN", 128)
        list_len_override = 1
    }
    var acc = 0
    if force_list_int != 0 {
        if list_len_override != 0 {
            acc = _alloc_churn_list_int(n, gc_every, clear_list, small_ints, list_len)
        } else {
            acc = _alloc_churn_list_int_len128(n, gc_every, clear_list, small_ints)
        }
    } else {
        if list_len_override != 0 {
            acc = _alloc_churn_list(n, gc_every, clear_list, small_ints, list_len)
        } else {
            acc = _alloc_churn_list_len128(n, gc_every, clear_list, small_ints)
        }
    }
    print(acc)
}
