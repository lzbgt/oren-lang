fn _env_int(key, fallback) {
    var env = oren_env(key)
    var out = fallback
    if env != nil {
        var n = 0
        var i = 0
        var neg = 0
        if oren_string_len(env) > 0 {
            var b0 = oren_string_char_code_at(env, 0)
            if b0 == 45 { neg = 1; i = 1 }
            if b0 == 43 { i = 1 }
        }
        while i < oren_string_len(env) {
            var b = oren_string_char_code_at(env, i)
            if b < 48 || b > 57 { break }
            n = n * 10 + (b - 48)
            i = i + 1
        }
        if neg == 1 { n = 0 - n }
        if n != 0 { out = n }
    }
    return out
}

fn _alloc_churn_list(n, gc_every, clear_list, small_ints, list_len) {
    var acc = 0
    if clear_list != 0 {
        var gc_count = 0
        var i = 0
        while i < n {
            var xs = []
            var j = 0
            while j < list_len {
                var v = i + j
                if small_ints != 0 { v = j }
                oren_list_push(xs, v)
                j = j + 1
            }
            acc = acc + xs[0]
            if gc_every > 0 && i > 0 {
                gc_count = gc_count + 1
                if gc_count == gc_every {
                    gc_count = 0
                    oren_gc_collect()
                }
            }
            xs = nil
            i = i + 1
        }
    } else {
        var gc_count2 = 0
        var i2 = 0
        while i2 < n {
            var xs2 = []
            var j2 = 0
            while j2 < list_len {
                var v2 = i2 + j2
                if small_ints != 0 { v2 = j2 }
                oren_list_push(xs2, v2)
                j2 = j2 + 1
            }
            acc = acc + xs2[0]
            if gc_every > 0 && i2 > 0 {
                gc_count2 = gc_count2 + 1
                if gc_count2 == gc_every {
                    gc_count2 = 0
                    oren_gc_collect()
                }
            }
            i2 = i2 + 1
        }
    }
    return acc
}

