// Oren native runtime (native backend) — core profile
//
// Goal (rolling):
// - Provide a smaller injected runtime surface for typical programs so a cold runtime-object build
//   stays bounded (<10s) even when the rtobj seed/cache is empty.
// - Keep the full runtime available via `lib/runtime_native.oren` (default profile).
//
// Notes:
// - Include order remains semantically significant for the runtime.
// - This profile intentionally excludes heavier subsystems:
//   - typed numeric buffers (HPC/SIMD surfaces)
//   - TCP/UDP networking surfaces
//   - AVM bridge
//   - `oren_net_get` helper (depends on TCP surface)
//   - AVM-only helpers (kept in full runtime)
//
// Edit the runtime sources under `lib/runtime_native/*.oren`.

// @include "runtime_native/000_prelude_sys.oren"
// @include "runtime_native/010_channels_globals_consts.oren"
// @include "runtime_native/015_raw_alloc.oren"
// @include "runtime_native/020_fork_runtime_init.oren"
// @include "runtime_native/030_envp_helpers.oren"
// @include "runtime_native/035_capsule_stubs.oren"
// @include "runtime_native/090_env.oren"
// @include "runtime_native/100_time.oren"
// Entropy is part of the “typical program” surface (crypto, randomness, UUIDs).
// @include "runtime_native/102_entropy.oren"
