// std/linalg matmul (list baseline) (rolling)

import common "std:linalg/common"
import list "std:list"
import buffer "std:buffer"
import mf32 "std:linalg/matmul_f32"
import mf64 "std:linalg/matmul_f64"

fn _err_invalid_arg(msg) { return common._err_invalid_arg(msg) }

fn matmul_f64(a, b, m, n, p) {
    if m < 0 || n < 0 || p < 0 {
        return _err_invalid_arg("matmul_f64: negative dims")
    }
    if list.len(a) != m * n {
        return _err_invalid_arg("matmul_f64: A length mismatch")
    }
    if list.len(b) != n * p {
        return _err_invalid_arg("matmul_f64: B length mismatch")
    }

    var ab: []f64 = buffer.f64_pack_list(a)
    if oren_is_err(ab) { return ab }
    var bb: []f64 = buffer.f64_pack_list(b)
    if oren_is_err(bb) { return bb }
    var outb: []f64 = mf64.matmul_f64_buf(ab, bb, m, n, p)
    if oren_is_err(outb) { return outb }
    return buffer.f64_unpack_list(outb)
}

fn matmul_f32(a, b, m, n, p) {
    if m < 0 || n < 0 || p < 0 {
        return _err_invalid_arg("matmul_f32: negative dims")
    }
    if list.len(a) != m * n {
        return _err_invalid_arg("matmul_f32: A length mismatch")
    }
    if list.len(b) != n * p {
        return _err_invalid_arg("matmul_f32: B length mismatch")
    }
    var ab: []f32 = buffer.f32_pack_list(a)
    if oren_is_err(ab) { return ab }
    var bb: []f32 = buffer.f32_pack_list(b)
    if oren_is_err(bb) { return bb }
    var outb: []f32 = mf32.matmul_f32_buf(ab, bb, m, n, p)
    if oren_is_err(outb) { return outb }
    return buffer.f32_unpack_list(outb)
}

// --- typed-buffer matmul ---
//
// These are the baseline building blocks for HPC workloads. They are scalar-first
// but designed so future NEON kernels can replace the hot loops behind a stable
// intrinsic/runtime boundary.
//
// Row-major, flat buffers:
// - A is m x n, length m*n, indexed as A[i*n + k]
// - B is n x p, length n*p, indexed as B[k*p + j]
// - Out is m x p, length m*p, indexed as Out[i*p + j]
