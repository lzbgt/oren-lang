// std/linalg axpy (rolling)

import buffer "std:buffer"
import common "std:linalg/common"
import list "std:list"

fn _err_invalid_arg(msg) { return common._err_invalid_arg(msg) }
fn _vec2_len(a, b, ctx) { return common._vec2_len(a, b, ctx) }

fn axpy_f64(alpha: f64, x, y) {
    var n = _vec2_len(x, y, "axpy_f64")
    if oren_is_err(n) { return n }
    var xb: []f64 = buffer.f64_pack_list(x)
    if oren_is_err(xb) { return xb }
    var yb: []f64 = buffer.f64_pack_list(y)
    if oren_is_err(yb) { return yb }
    var out = []
    var i = 0
    while i < n {
        var xv: f64 = oren_buf_load_f64(xb, i)
        var yv: f64 = oren_buf_load_f64(yb, i)
        list.push(out, alpha * xv + yv)
        i = i + 1
    }
    return out
}

fn axpy_f64_in_place(alpha: f64, x, y) {
    var n = _vec2_len(x, y, "axpy_f64_in_place")
    if oren_is_err(n) { return n }
    var xb: []f64 = buffer.f64_pack_list(x)
    if oren_is_err(xb) { return xb }
    var yb: []f64 = buffer.f64_pack_list(y)
    if oren_is_err(yb) { return yb }
    var i = 0
    while i < n {
        var xv: f64 = oren_buf_load_f64(xb, i)
        var yv: f64 = oren_buf_load_f64(yb, i)
        y[i] = alpha * xv + yv
        i = i + 1
    }
    return y
}

fn axpy_f32(alpha: f64, x, y) {
    var out = axpy_f64(alpha, x, y)
    if oren_is_err(out) { return out }
    // Round each element to float32 boundary.
    var i = 0
    while i < list.len(out) {
        out[i] = f32(out[i])
        i = i + 1
    }
    return out
}

fn axpy_f32_buf_in_place(alpha, x: []f32, y: []f32) {
    return oren_buf_axpy_f32_in_place(alpha, x, y)
}

fn axpy_f32_buf(alpha, x: []f32, y: []f32) {
    var n = buffer.len(x)
    if oren_is_err(n) { return n }
    var ny = buffer.len(y)
    if oren_is_err(ny) { return ny }
    if n != ny { return _err_invalid_arg("axpy_f32_buf: length mismatch") }
    var out: []f32 = buffer.f32_new_uninit(n)
    if oren_is_err(out) { return out }
    return oren_buf_axpy_f32_into(out, alpha, x, y)
}

fn axpy_i32_buf_in_place(alpha, x: []i32, y: []i32) {
    return oren_buf_axpy_i32_in_place(alpha, x, y)
}

fn axpy_i32_buf(alpha, x: []i32, y: []i32) {
    var n = buffer.len(x)
    if oren_is_err(n) { return n }
    var ny = buffer.len(y)
    if oren_is_err(ny) { return ny }
    if n != ny { return _err_invalid_arg("axpy_i32_buf: length mismatch") }
    var out: []i32 = buffer.i32_new_uninit(n)
    if oren_is_err(out) { return out }
    return oren_buf_axpy_i32_into(out, alpha, x, y)
}

// --- matrix multiplication ---
//
// Row-major, flat arrays:
// - A is m x n, length m*n, indexed as A[i*n + k]
// - B is n x p, length n*p, indexed as B[k*p + j]
// - Out is m x p, length m*p, indexed as Out[i*p + j]
