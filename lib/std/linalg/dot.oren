// std/linalg dot + views (rolling)

import common "std:linalg/common"
import list "std:list"
import buffer "std:buffer"

fn _err_invalid_arg(msg) { return common._err_invalid_arg(msg) }
fn _vec2_len(a, b, ctx) { return common._vec2_len(a, b, ctx) }

fn _is_int(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 1 { return true }
    if tag == 0 || tag == 3 || tag == 4 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn dot_f64(a, b) {
    var n = _vec2_len(a, b, "dot_f64")
    if oren_is_err(n) { return n }
    var i = 0
    var s = 0.0
    while i < n {
        s = s + a[i] * b[i]
        i = i + 1
    }
    return s
}

fn dot_f32(a, b) {
    // v0 implementation: compute in f64 then round the *result* to f32.
    // This provides deterministic behavior without per-element rounding overhead.
    var s = dot_f64(a, b)
    if oren_is_err(s) { return s }
    return f32(s)
}

// --- typed-buffer HPC variants ---
//
// These operate on runtime typed buffers (`[]i32`, `[]f32`, ...). They avoid the
// per-element boxed list overhead and enable runtime kernels (including NEON
// where semantics are safe).

fn dot_i32_buf(a: []i32, b: []i32) {
    return oren_buf_dot_i32(a, b)
}

fn dot_i32_buf_scalar(a: []i32, b: []i32) {
    var na = oren_buf_len(a)
    if oren_is_err(na) { return na }
    var nb = oren_buf_len(b)
    if oren_is_err(nb) { return nb }
    if na != nb { return _err_invalid_arg("dot_i32_buf_scalar: length mismatch") }
    var sum = 0
    var i = 0
    while i < na {
        sum = sum + oren_buf_load_i32(a, i) * oren_buf_load_i32(b, i)
        i = i + 1
    }
    return sum
}

fn reduce_sum_i32_buf(a: []i32) {
    return oren_buf_reduce_sum_i32(a)
}

fn _reduce_sum_i64_list_scalar(a, n, ctx) {
    var sum = 0
    var i = 0
    while i < n {
        var v = a[i]
        if _is_int(v) == false { return _err_invalid_arg(ctx + ": expects list<int>") }
        sum = sum + v
        i = i + 1
    }
    return sum
}

fn _dot_i64_list_scalar(a, b, n, ctx) {
    var sum = 0
    var i = 0
    while i < n {
        var av = a[i]
        if _is_int(av) == false { return _err_invalid_arg(ctx + ": expects list<int>") }
        var bv = b[i]
        if _is_int(bv) == false { return _err_invalid_arg(ctx + ": expects list<int>") }
        sum = sum + av * bv
        i = i + 1
    }
    return sum
}

// Shared slot-direct helpers:
// - fast path: backend-native list<int> slot ABI when the input is already an all-int list
// - fallback: scalar list walk to keep semantics portable for generic list inputs
fn reduce_sum_i64_list_int_slots(a) {
    if oren_is_list_int(a) == true { return oren_list_int_reduce_sum_slots_unchecked(a) }
    var n = list.len(a)
    if oren_is_err(n) { return _err_invalid_arg("reduce_sum_i64_list_int_slots: expects list<int>") }
    return _reduce_sum_i64_list_scalar(a, n, "reduce_sum_i64_list_int_slots")
}

fn dot_i64_list_int_slots(a, b) {
    if oren_is_list_int(a) == true && oren_is_list_int(b) == true {
        var na = oren_list_int_len_unchecked(a)
        var nb = oren_list_int_len_unchecked(b)
        if na != nb {
            return _err_invalid_arg("dot_i64_list_int_slots: length mismatch (" + oren_int_to_string(na) + " != " + oren_int_to_string(nb) + ")")
        }
        return oren_list_int_dot_slots_unchecked(a, b)
    }
    var n = _vec2_len(a, b, "dot_i64_list_int_slots")
    if oren_is_err(n) { return n }
    return _dot_i64_list_scalar(a, b, n, "dot_i64_list_int_slots")
}

fn dot_i32_list_int_packed(a, b) {
    var ap: []i32 = buffer.i32_pack_list_int(a)
    if oren_is_err(ap) { return ap }
    var bp: []i32 = buffer.i32_pack_list_int(b)
    if oren_is_err(bp) { return bp }
    return dot_i32_buf(ap, bp)
}

// Explicit workspace-reuse surface for callers that want to amortize bridge setup
// without pretending the current list<int> slot ABI is already a packed []i32 view.
fn dot_i32_list_int_packed_reuse(packed_a: []i32, packed_b: []i32, a, b) {
    var ap = buffer.i32_pack_list_int_into(packed_a, a)
    if oren_is_err(ap) { return ap }
    var bp = buffer.i32_pack_list_int_into(packed_b, b)
    if oren_is_err(bp) { return bp }
    return dot_i32_buf(packed_a, packed_b)
}

fn reduce_sum_i32_list_int_packed(a) {
    var ap: []i32 = buffer.i32_pack_list_int(a)
    if oren_is_err(ap) { return ap }
    return reduce_sum_i32_buf(ap)
}

fn reduce_sum_i32_list_int_packed_reuse(packed_a: []i32, a) {
    var ap = buffer.i32_pack_list_int_into(packed_a, a)
    if oren_is_err(ap) { return ap }
    return reduce_sum_i32_buf(packed_a)
}

fn dot_f32_buf(a: []f32, b: []f32) {
    // Semantics: deterministic dot in f64 accumulation order (runtime-defined).
    return oren_buf_dot_f32(a, b)
}

fn dot_f64_buf(a: []f64, b: []f64) {
    // Semantics: deterministic dot in strict increasing-index accumulation order.
    return oren_buf_dot_f64(a, b)
}

fn reduce_sum_f64_buf(a: []f64) {
    return oren_buf_reduce_sum_f64(a)
}

// --- zero-copy views (slice / strided) ---
//
// View shapes (portable list encodings; see std/buffer):
// - slice:   [buf, off, len]
// - strided: [buf, off, len, stride]
//
// These helpers exist so HPC code can keep data zero-copy while still using
// backend-optimized dot kernels (`*_slice` / `*_strided`) where available.

fn _view_len(v) {
    if v == nil || oren_is_err(v) { return -1 }
    var n = list.len(v)
    if oren_is_err(n) { return -1 }
    return n
}

fn dot_i32_view(a, b) {
    var al = _view_len(a)
    var bl = _view_len(b)
    if al < 0 || bl < 0 { return _err_invalid_arg("dot_i32_view: expects view lists") }
    if al != 3 && al != 4 || bl != 3 && bl != 4 { return _err_invalid_arg("dot_i32_view: expects slice/strided") }

    var a_buf: []i32 = a[0]
    var b_buf: []i32 = b[0]
    var a_off = a[1]
    var b_off = b[1]
    var n = a[2]
    var bn = b[2]
    if n != bn { return _err_invalid_arg("dot_i32_view: length mismatch") }
    var a_stride = 1
    var b_stride = 1
    if al == 4 { a_stride = a[3] }
    if bl == 4 { b_stride = b[3] }

    if a_stride == 1 && b_stride == 1 {
        return oren_buf_dot_i32_slice(a_buf, a_off, b_buf, b_off, n)
    }
    return oren_buf_dot_i32_strided(a_buf, a_off, a_stride, b_buf, b_off, b_stride, n)
}

fn dot_f32_view(a, b) {
    var al = _view_len(a)
    var bl = _view_len(b)
    if al < 0 || bl < 0 { return _err_invalid_arg("dot_f32_view: expects view lists") }
    if al != 3 && al != 4 || bl != 3 && bl != 4 { return _err_invalid_arg("dot_f32_view: expects slice/strided") }

    var a_buf: []f32 = a[0]
    var b_buf: []f32 = b[0]
    var a_off = a[1]
    var b_off = b[1]
    var n = a[2]
    var bn = b[2]
    if n != bn { return _err_invalid_arg("dot_f32_view: length mismatch") }
    var a_stride = 1
    var b_stride = 1
    if al == 4 { a_stride = a[3] }
    if bl == 4 { b_stride = b[3] }

    if a_stride == 1 && b_stride == 1 {
        return oren_buf_dot_f32_slice(a_buf, a_off, b_buf, b_off, n)
    }
    return oren_buf_dot_f32_strided(a_buf, a_off, a_stride, b_buf, b_off, b_stride, n)
}

fn dot_f64_view(a, b) {
    var al = _view_len(a)
    var bl = _view_len(b)
    if al < 0 || bl < 0 { return _err_invalid_arg("dot_f64_view: expects view lists") }
    if al != 3 && al != 4 || bl != 3 && bl != 4 { return _err_invalid_arg("dot_f64_view: expects slice/strided") }

    var a_buf: []f64 = a[0]
    var b_buf: []f64 = b[0]
    var a_off = a[1]
    var b_off = b[1]
    var n = a[2]
    var bn = b[2]
    if n != bn { return _err_invalid_arg("dot_f64_view: length mismatch") }
    var a_stride = 1
    var b_stride = 1
    if al == 4 { a_stride = a[3] }
    if bl == 4 { b_stride = b[3] }

    if a_stride == 1 && b_stride == 1 {
        return oren_buf_dot_f64_slice(a_buf, a_off, b_buf, b_off, n)
    }
    return oren_buf_dot_f64_strided(a_buf, a_off, a_stride, b_buf, b_off, b_stride, n)
}

