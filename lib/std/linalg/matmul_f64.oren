// std/linalg matmul f64 typed-buffer (rolling)

import buffer "std:buffer"
import common "std:linalg/common"

fn _err_invalid_arg(msg) { return common._err_invalid_arg(msg) }

fn _store_f64_from_f64(out: []f64, idx, v: f64) {
    return oren_buf_store_f64(out, idx, v)
}

fn matmul_f64_buf(a: []f64, b: []f64, m, n, p) {
    if m < 0 || n < 0 || p < 0 { return _err_invalid_arg("matmul_f64_buf: negative dims") }
    var na = buffer.len(a)
    if oren_is_err(na) { return na }
    var nb = buffer.len(b)
    if oren_is_err(nb) { return nb }
    if na != m * n { return _err_invalid_arg("matmul_f64_buf: A length mismatch") }
    if nb != n * p { return _err_invalid_arg("matmul_f64_buf: B length mismatch") }

    var out: []f64 = buffer.f64_new_uninit(m * p)
    if oren_is_err(out) { return out }

    var rc = matmul_f64_buf_into(out, a, b, m, n, p)
    if oren_is_err(rc) { return rc }
    return out
}

fn matmul_f64_buf_into(out: []f64, a: []f64, b: []f64, m, n, p) {
    // In-place variant of f64 matmul for allocation-free HPC loops.
    if m < 0 || n < 0 || p < 0 { return _err_invalid_arg("matmul_f64_buf_into: negative dims") }
    var na = buffer.len(a)
    if oren_is_err(na) { return na }
    var nb = buffer.len(b)
    if oren_is_err(nb) { return nb }
    var no = buffer.len(out)
    if oren_is_err(no) { return no }
    if na != m * n { return _err_invalid_arg("matmul_f64_buf_into: A length mismatch") }
    if nb != n * p { return _err_invalid_arg("matmul_f64_buf_into: B length mismatch") }
    if no != m * p { return _err_invalid_arg("matmul_f64_buf_into: out length mismatch") }
    return _matmul_f64_buf_kernel(out, a, b, m, n, p)
}

fn _matmul_f64_buf_kernel(out: []f64, a: []f64, b: []f64, m, n, p) {
    // Transpose B so each column becomes a contiguous row in Bt, then compute each
    // output as a sum of deterministic dot slices (increasing-k blocks).
    //
    // Bt is p x n, indexed Bt[j*n + k] = B[k*p + j].
    var bt: []f64 = buffer.f64_new_uninit(n * p)
    if oren_is_err(bt) { return bt }
    var k0 = 0
    while k0 < n {
        var j0 = 0
        while j0 < p {
            var v = oren_buf_load_f64(b, k0 * p + j0)
            if oren_is_err(v) { return v }
            _store_f64_from_f64(bt, j0 * n + k0, v)
            j0 = j0 + 1
        }
        k0 = k0 + 1
    }

    var JB = 4
    var KB = 64
    var tiles_j = (p + JB - 1) / JB
    var tiles_k = (n + KB - 1) / KB
    var use_packed = (n >= KB) && (p >= JB) && (n * p >= 4096)

    var bp: []f64 = nil
    if use_packed {
        bp = buffer.f64_new_uninit(tiles_j * tiles_k * JB * KB)
        if oren_is_err(bp) { return bp }
        var bj = 0
        while bj < tiles_j {
            var bk = 0
            while bk < tiles_k {
                var j_in = 0
                while j_in < JB {
                    var global_j = bj * JB + j_in
                    var k_in = 0
                    while k_in < KB {
                        var global_k = bk * KB + k_in
                        var v2 = 0.0
                        if global_j < p && global_k < n {
                            v2 = oren_buf_load_f64(bt, global_j * n + global_k)
                            if oren_is_err(v2) { return v2 }
                        }
                        var dst = (((bj * tiles_k + bk) * JB + j_in) * KB + k_in)
                        _store_f64_from_f64(bp, dst, v2)
                        k_in = k_in + 1
                    }
                    j_in = j_in + 1
                }
                bk = bk + 1
            }
            bj = bj + 1
        }
    }

    // Reusable scratch for the 1x4 dot microkernel (avoid 4 passes over A in tight loops).
    var tmp4: []f64 = buffer.f64_new_uninit(4)
    if oren_is_err(tmp4) { return tmp4 }

    // Reusable scratch for the 4x4 GEMM microkernel (reduces boundary overhead for 4-row blocks).
    var tmp16: []f64 = nil
    if m >= 4 && p >= 4 {
        tmp16 = buffer.f64_new_uninit(16)
        if oren_is_err(tmp16) { return tmp16 }
    }

    var i = 0
    while i < m {
        // 4x4 microkernel: reuse B across 4 rows when we have a full 4-row block.
        if i + 3 < m && tmp16 != nil {
            // Packed-B path: compute per k-tile so we preserve deterministic k-block order.
            if use_packed {
                var bj_blk = 0
                while bj_blk < tiles_j {
                    var base_j_blk = bj_blk * JB

                    // Accumulators for 4x4 block.
                    var s00 = 0.0; var s01 = 0.0; var s02 = 0.0; var s03 = 0.0
                    var s10 = 0.0; var s11 = 0.0; var s12 = 0.0; var s13 = 0.0
                    var s20 = 0.0; var s21 = 0.0; var s22 = 0.0; var s23 = 0.0
                    var s30 = 0.0; var s31 = 0.0; var s32 = 0.0; var s33 = 0.0

                    var bk_blk = 0
                    while bk_blk < tiles_k {
                        var kbase_blk = bk_blk * KB
                        var kn_blk = n - kbase_blk
                        if kn_blk > KB { kn_blk = KB }
                        var base_tile_blk = (bj_blk * tiles_k + bk_blk) * JB * KB

                        // Packed B is zero-padded for out-of-range cols; safe to call even for tail columns.
                        var rr = oren_buf_gemm_f64_4x4_slice_into(
                            tmp16, 0,
                            a,
                            (i + 0) * n + kbase_blk,
                            (i + 1) * n + kbase_blk,
                            (i + 2) * n + kbase_blk,
                            (i + 3) * n + kbase_blk,
                            bp,
                            base_tile_blk + 0 * KB,
                            base_tile_blk + 1 * KB,
                            base_tile_blk + 2 * KB,
                            base_tile_blk + 3 * KB,
                            kn_blk)
                        if oren_is_err(rr) { return rr }

                        // Accumulate partials in deterministic increasing-k order (per k-block).
                        s00 = s00 + oren_buf_load_f64(tmp16, 0)
                        s01 = s01 + oren_buf_load_f64(tmp16, 1)
                        s02 = s02 + oren_buf_load_f64(tmp16, 2)
                        s03 = s03 + oren_buf_load_f64(tmp16, 3)

                        s10 = s10 + oren_buf_load_f64(tmp16, 4)
                        s11 = s11 + oren_buf_load_f64(tmp16, 5)
                        s12 = s12 + oren_buf_load_f64(tmp16, 6)
                        s13 = s13 + oren_buf_load_f64(tmp16, 7)

                        s20 = s20 + oren_buf_load_f64(tmp16, 8)
                        s21 = s21 + oren_buf_load_f64(tmp16, 9)
                        s22 = s22 + oren_buf_load_f64(tmp16, 10)
                        s23 = s23 + oren_buf_load_f64(tmp16, 11)

                        s30 = s30 + oren_buf_load_f64(tmp16, 12)
                        s31 = s31 + oren_buf_load_f64(tmp16, 13)
                        s32 = s32 + oren_buf_load_f64(tmp16, 14)
                        s33 = s33 + oren_buf_load_f64(tmp16, 15)

                        bk_blk = bk_blk + 1
                    }

                    // Store only in-range columns (packed B may include zero-padded columns).
                    if base_j_blk + 0 < p {
                        _store_f64_from_f64(out, (i + 0) * p + (base_j_blk + 0), s00)
                        _store_f64_from_f64(out, (i + 1) * p + (base_j_blk + 0), s10)
                        _store_f64_from_f64(out, (i + 2) * p + (base_j_blk + 0), s20)
                        _store_f64_from_f64(out, (i + 3) * p + (base_j_blk + 0), s30)
                    }
                    if base_j_blk + 1 < p {
                        _store_f64_from_f64(out, (i + 0) * p + (base_j_blk + 1), s01)
                        _store_f64_from_f64(out, (i + 1) * p + (base_j_blk + 1), s11)
                        _store_f64_from_f64(out, (i + 2) * p + (base_j_blk + 1), s21)
                        _store_f64_from_f64(out, (i + 3) * p + (base_j_blk + 1), s31)
                    }
                    if base_j_blk + 2 < p {
                        _store_f64_from_f64(out, (i + 0) * p + (base_j_blk + 2), s02)
                        _store_f64_from_f64(out, (i + 1) * p + (base_j_blk + 2), s12)
                        _store_f64_from_f64(out, (i + 2) * p + (base_j_blk + 2), s22)
                        _store_f64_from_f64(out, (i + 3) * p + (base_j_blk + 2), s32)
                    }
                    if base_j_blk + 3 < p {
                        _store_f64_from_f64(out, (i + 0) * p + (base_j_blk + 3), s03)
                        _store_f64_from_f64(out, (i + 1) * p + (base_j_blk + 3), s13)
                        _store_f64_from_f64(out, (i + 2) * p + (base_j_blk + 3), s23)
                        _store_f64_from_f64(out, (i + 3) * p + (base_j_blk + 3), s33)
                    }

                    bj_blk = bj_blk + 1
                }

                i = i + 4
                continue
            }

            // Non-packed path: Bt columns are contiguous, so compute a full 4x4 block over the
            // entire n in a single call (no k-tiling needed).
            var bj_blk2 = 0
            while bj_blk2 < tiles_j {
                var base_j_blk2 = bj_blk2 * JB
                if base_j_blk2 + 3 < p {
                    var rr2 = oren_buf_gemm_f64_4x4_slice_into(
                        tmp16, 0,
                        a,
                        (i + 0) * n,
                        (i + 1) * n,
                        (i + 2) * n,
                        (i + 3) * n,
                        bt,
                        (base_j_blk2 + 0) * n,
                        (base_j_blk2 + 1) * n,
                        (base_j_blk2 + 2) * n,
                        (base_j_blk2 + 3) * n,
                        n)
                    if oren_is_err(rr2) { return rr2 }

                    // Store 4x4 block.
                    _store_f64_from_f64(out, (i + 0) * p + (base_j_blk2 + 0), oren_buf_load_f64(tmp16, 0))
                    _store_f64_from_f64(out, (i + 0) * p + (base_j_blk2 + 1), oren_buf_load_f64(tmp16, 1))
                    _store_f64_from_f64(out, (i + 0) * p + (base_j_blk2 + 2), oren_buf_load_f64(tmp16, 2))
                    _store_f64_from_f64(out, (i + 0) * p + (base_j_blk2 + 3), oren_buf_load_f64(tmp16, 3))

                    _store_f64_from_f64(out, (i + 1) * p + (base_j_blk2 + 0), oren_buf_load_f64(tmp16, 4))
                    _store_f64_from_f64(out, (i + 1) * p + (base_j_blk2 + 1), oren_buf_load_f64(tmp16, 5))
                    _store_f64_from_f64(out, (i + 1) * p + (base_j_blk2 + 2), oren_buf_load_f64(tmp16, 6))
                    _store_f64_from_f64(out, (i + 1) * p + (base_j_blk2 + 3), oren_buf_load_f64(tmp16, 7))

                    _store_f64_from_f64(out, (i + 2) * p + (base_j_blk2 + 0), oren_buf_load_f64(tmp16, 8))
                    _store_f64_from_f64(out, (i + 2) * p + (base_j_blk2 + 1), oren_buf_load_f64(tmp16, 9))
                    _store_f64_from_f64(out, (i + 2) * p + (base_j_blk2 + 2), oren_buf_load_f64(tmp16, 10))
                    _store_f64_from_f64(out, (i + 2) * p + (base_j_blk2 + 3), oren_buf_load_f64(tmp16, 11))

                    _store_f64_from_f64(out, (i + 3) * p + (base_j_blk2 + 0), oren_buf_load_f64(tmp16, 12))
                    _store_f64_from_f64(out, (i + 3) * p + (base_j_blk2 + 1), oren_buf_load_f64(tmp16, 13))
                    _store_f64_from_f64(out, (i + 3) * p + (base_j_blk2 + 2), oren_buf_load_f64(tmp16, 14))
                    _store_f64_from_f64(out, (i + 3) * p + (base_j_blk2 + 3), oren_buf_load_f64(tmp16, 15))
                } else {
                    // Tail columns: fall back to the existing per-row dot kernels below.
                    var row2 = 0
                    while row2 < 4 {
                        if base_j_blk2 + 0 < p { _store_f64_from_f64(out, (i + row2) * p + (base_j_blk2 + 0), oren_buf_dot_f64_slice(a, (i + row2) * n, bt, (base_j_blk2 + 0) * n, n)) }
                        if base_j_blk2 + 1 < p { _store_f64_from_f64(out, (i + row2) * p + (base_j_blk2 + 1), oren_buf_dot_f64_slice(a, (i + row2) * n, bt, (base_j_blk2 + 1) * n, n)) }
                        if base_j_blk2 + 2 < p { _store_f64_from_f64(out, (i + row2) * p + (base_j_blk2 + 2), oren_buf_dot_f64_slice(a, (i + row2) * n, bt, (base_j_blk2 + 2) * n, n)) }
                        if base_j_blk2 + 3 < p { _store_f64_from_f64(out, (i + row2) * p + (base_j_blk2 + 3), oren_buf_dot_f64_slice(a, (i + row2) * n, bt, (base_j_blk2 + 3) * n, n)) }
                        row2 = row2 + 1
                    }
                }
                bj_blk2 = bj_blk2 + 1
            }

            i = i + 4
            continue
        }

        var bj2 = 0
        while bj2 < tiles_j {
            var base_j = bj2 * JB
            var s0 = 0.0
            var s1 = 0.0
            var s2 = 0.0
            var s3 = 0.0

            var bk2 = 0
            while bk2 < tiles_k {
                var kbase = bk2 * KB
                var kn = n - kbase
                if kn > KB { kn = KB }

                if base_j + 3 < p {
                    if use_packed {
                        var base_tile = (bj2 * tiles_k + bk2) * JB * KB
                        var r = oren_buf_dot_f64_4_slice_into(
                            tmp4, 0,
                            a, i * n + kbase,
                            bp,
                            base_tile + 0 * KB,
                            base_tile + 1 * KB,
                            base_tile + 2 * KB,
                            base_tile + 3 * KB,
                            kn)
                        if oren_is_err(r) { return r }
                        s0 = s0 + oren_buf_load_f64(tmp4, 0)
                        s1 = s1 + oren_buf_load_f64(tmp4, 1)
                        s2 = s2 + oren_buf_load_f64(tmp4, 2)
                        s3 = s3 + oren_buf_load_f64(tmp4, 3)
                    } else {
                        var r2 = oren_buf_dot_f64_4_slice_into(
                            tmp4, 0,
                            a, i * n + kbase,
                            bt,
                            (base_j + 0) * n + kbase,
                            (base_j + 1) * n + kbase,
                            (base_j + 2) * n + kbase,
                            (base_j + 3) * n + kbase,
                            kn)
                        if oren_is_err(r2) { return r2 }
                        s0 = s0 + oren_buf_load_f64(tmp4, 0)
                        s1 = s1 + oren_buf_load_f64(tmp4, 1)
                        s2 = s2 + oren_buf_load_f64(tmp4, 2)
                        s3 = s3 + oren_buf_load_f64(tmp4, 3)
                    }
                } else {
                    if use_packed {
                        var base_tile2 = (bj2 * tiles_k + bk2) * JB * KB
                        if base_j + 0 < p { s0 = s0 + oren_buf_dot_f64_slice(a, i * n + kbase, bp, base_tile2 + 0 * KB, kn) }
                        if base_j + 1 < p { s1 = s1 + oren_buf_dot_f64_slice(a, i * n + kbase, bp, base_tile2 + 1 * KB, kn) }
                        if base_j + 2 < p { s2 = s2 + oren_buf_dot_f64_slice(a, i * n + kbase, bp, base_tile2 + 2 * KB, kn) }
                        if base_j + 3 < p { s3 = s3 + oren_buf_dot_f64_slice(a, i * n + kbase, bp, base_tile2 + 3 * KB, kn) }
                    } else {
                        if base_j + 0 < p { s0 = s0 + oren_buf_dot_f64_slice(a, i * n + kbase, bt, (base_j + 0) * n + kbase, kn) }
                        if base_j + 1 < p { s1 = s1 + oren_buf_dot_f64_slice(a, i * n + kbase, bt, (base_j + 1) * n + kbase, kn) }
                        if base_j + 2 < p { s2 = s2 + oren_buf_dot_f64_slice(a, i * n + kbase, bt, (base_j + 2) * n + kbase, kn) }
                        if base_j + 3 < p { s3 = s3 + oren_buf_dot_f64_slice(a, i * n + kbase, bt, (base_j + 3) * n + kbase, kn) }
                    }
                }
                bk2 = bk2 + 1
            }

            if base_j + 0 < p { _store_f64_from_f64(out, i * p + (base_j + 0), s0) }
            if base_j + 1 < p { _store_f64_from_f64(out, i * p + (base_j + 1), s1) }
            if base_j + 2 < p { _store_f64_from_f64(out, i * p + (base_j + 2), s2) }
            if base_j + 3 < p { _store_f64_from_f64(out, i * p + (base_j + 3), s3) }

            bj2 = bj2 + 1
        }
        i = i + 1
    }
    return 0
}

// Matmul over matrix views (strided rows).
//
// View shape (see std/buffer):
//   [buf, off, rows, cols, row_stride]
//
// This is a correctness + ergonomics baseline. Hot loops can later be replaced
// by packed tiles/NEON microkernels while preserving semantics.
