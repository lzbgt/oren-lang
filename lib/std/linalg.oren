// std/linalg (rolling)
//
// This file is intentionally small.
// Implementation lives under `lib/std/linalg/*.oren` to avoid context overflow.

import common "linalg/common.oren"
import dot "linalg/dot.oren"
import axpy "linalg/axpy.oren"
import ml "linalg/matmul_list.oren"
import mf32 "linalg/matmul_f32.oren"
import mf64 "linalg/matmul_f64.oren"
import mi32 "linalg/matmul_i32.oren"

fn dot_f64(a, b) {
    return dot.dot_f64(a, b)
}

fn dot_f32(a, b) {
    return dot.dot_f32(a, b)
}

fn dot_i32_buf(a: []i32, b: []i32) {
    return dot.dot_i32_buf(a, b)
}

fn dot_f32_buf(a: []f32, b: []f32) {
    return dot.dot_f32_buf(a, b)
}

fn dot_f64_buf(a: []f64, b: []f64) {
    return dot.dot_f64_buf(a, b)
}

fn reduce_sum_f64_buf(a: []f64) {
    return dot.reduce_sum_f64_buf(a)
}

fn dot_i32_view(a, b) {
    return dot.dot_i32_view(a, b)
}

fn dot_f32_view(a, b) {
    return dot.dot_f32_view(a, b)
}

fn dot_f64_view(a, b) {
    return dot.dot_f64_view(a, b)
}

fn axpy_f64(alpha, x, y) {
    return axpy.axpy_f64(alpha, x, y)
}

fn axpy_f64_in_place(alpha, x, y) {
    return axpy.axpy_f64_in_place(alpha, x, y)
}

fn axpy_f32(alpha, x, y) {
    return axpy.axpy_f32(alpha, x, y)
}

fn axpy_f32_buf_in_place(alpha, x: []f32, y: []f32) {
    return axpy.axpy_f32_buf_in_place(alpha, x, y)
}

fn axpy_f32_buf(alpha, x: []f32, y: []f32) {
    return axpy.axpy_f32_buf(alpha, x, y)
}

fn axpy_i32_buf_in_place(alpha, x: []i32, y: []i32) {
    return axpy.axpy_i32_buf_in_place(alpha, x, y)
}

fn axpy_i32_buf(alpha, x: []i32, y: []i32) {
    return axpy.axpy_i32_buf(alpha, x, y)
}

fn matmul_f64(a, b, m, n, p) {
    return ml.matmul_f64(a, b, m, n, p)
}

fn matmul_f32(a, b, m, n, p) {
    return ml.matmul_f32(a, b, m, n, p)
}

fn matmul_f32_buf(a: []f32, b: []f32, m, n, p) {
    return mf32.matmul_f32_buf(a, b, m, n, p)
}

fn matmul_f32_buf_into(out: []f32, a: []f32, b: []f32, m, n, p) {
    return mf32.matmul_f32_buf_into(out, a, b, m, n, p)
}

fn matmul_f64_buf(a: []f64, b: []f64, m, n, p) {
    return mf64.matmul_f64_buf(a, b, m, n, p)
}

fn matmul_f64_buf_into(out: []f64, a: []f64, b: []f64, m, n, p) {
    return mf64.matmul_f64_buf_into(out, a, b, m, n, p)
}

fn matmul_f32_mat_view(a, b) {
    return mf32.matmul_f32_mat_view(a, b)
}

fn matmul_i32_buf(a: []i32, b: []i32, m, n, p) {
    return mi32.matmul_i32_buf(a, b, m, n, p)
}

fn matmul_i32_buf_into(out: []i32, a: []i32, b: []i32, m, n, p) {
    return mi32.matmul_i32_buf_into(out, a, b, m, n, p)
}

fn matmul_i32_buf_wide(a: []i32, b: []i32, m, n, p) {
    return mi32.matmul_i32_buf_wide(a, b, m, n, p)
}

fn matmul_i32_buf_wide_into(out: []i64, a: []i32, b: []i32, m, n, p) {
    return mi32.matmul_i32_buf_wide_into(out, a, b, m, n, p)
}
