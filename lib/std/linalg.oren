// std/linalg (rolling)
//
// Scope: minimal linear algebra primitives, scalar-first.
//
// Design goals:
// - Deterministic and portable across backends.
// - Correctness-first (no host math libs, no UB).
// - SIMD-ready later: keep hot loops isolated so NEON kernels can replace them.
//
// IMPORTANT: v0 float at runtime is f64 (tagged float).
// `*_f32` APIs provide a deterministic float32 *boundary* by rounding outputs to f32,
// but computations still occur in f64 unless/until we have a true f32 container.

import buffer "../../lib/std/buffer.oren"

fn _err_invalid_arg(msg) {
    // Code 4 matches existing stdlib convention (see std/ints).
    return oren_err(4, msg)
}

fn _vec2_len(a, b, ctx) {
    var na = oren_list_len(a)
    var nb = oren_list_len(b)
    if na != nb {
        var where = ctx
        if where == nil { where = "linalg" }
        return _err_invalid_arg(where + ": length mismatch (" + oren_int_to_string(na) + " != " + oren_int_to_string(nb) + ")")
    }
    return na
}

// --- dot products ---

fn dot_f64(a, b) {
    var n = _vec2_len(a, b, "dot_f64")
    if oren_is_err(n) { return n }
    var i = 0
    var s = 0.0
    while i < n {
        s = s + a[i] * b[i]
        i = i + 1
    }
    return s
}

fn dot_f32(a, b) {
    // v0 implementation: compute in f64 then round the *result* to f32.
    // This provides deterministic behavior without per-element rounding overhead.
    var s = dot_f64(a, b)
    if oren_is_err(s) { return s }
    return f32(s)
}

// --- typed-buffer HPC variants ---
//
// These operate on runtime typed buffers (`[]i32`, `[]f32`, ...). They avoid the
// per-element boxed list overhead and enable runtime kernels (including NEON
// where semantics are safe).

fn dot_i32_buf(a: []i32, b: []i32) {
    return oren_buf_dot_i32(a, b)
}

fn dot_f32_buf(a: []f32, b: []f32) {
    // Semantics: deterministic dot in f64 accumulation order (runtime-defined).
    return oren_buf_dot_f32(a, b)
}

fn dot_f64_buf(a: []f64, b: []f64) {
    // Semantics: deterministic dot in strict increasing-index accumulation order.
    return oren_buf_dot_f64(a, b)
}

fn reduce_sum_f64_buf(a: []f64) {
    return oren_buf_reduce_sum_f64(a)
}

// --- zero-copy views (slice / strided) ---
//
// View shapes (portable list encodings; see std/buffer):
// - slice:   [buf, off, len]
// - strided: [buf, off, len, stride]
//
// These helpers exist so HPC code can keep data zero-copy while still using
// backend-optimized dot kernels (`*_slice` / `*_strided`) where available.

fn _view_len(v) {
    if v == nil || oren_is_err(v) { return -1 }
    var n = oren_list_len(v)
    if oren_is_err(n) { return -1 }
    return n
}

fn dot_i32_view(a, b) {
    var al = _view_len(a)
    var bl = _view_len(b)
    if al < 0 || bl < 0 { return _err_invalid_arg("dot_i32_view: expects view lists") }
    if (al != 3 && al != 4) || (bl != 3 && bl != 4) { return _err_invalid_arg("dot_i32_view: expects slice/strided") }

    var a_buf: []i32 = a[0]
    var b_buf: []i32 = b[0]
    var a_off = a[1]
    var b_off = b[1]
    var n = a[2]
    var bn = b[2]
    if n != bn { return _err_invalid_arg("dot_i32_view: length mismatch") }
    var a_stride = 1
    var b_stride = 1
    if al == 4 { a_stride = a[3] }
    if bl == 4 { b_stride = b[3] }

    if a_stride == 1 && b_stride == 1 {
        return oren_buf_dot_i32_slice(a_buf, a_off, b_buf, b_off, n)
    }
    return oren_buf_dot_i32_strided(a_buf, a_off, a_stride, b_buf, b_off, b_stride, n)
}

fn dot_f32_view(a, b) {
    var al = _view_len(a)
    var bl = _view_len(b)
    if al < 0 || bl < 0 { return _err_invalid_arg("dot_f32_view: expects view lists") }
    if (al != 3 && al != 4) || (bl != 3 && bl != 4) { return _err_invalid_arg("dot_f32_view: expects slice/strided") }

    var a_buf: []f32 = a[0]
    var b_buf: []f32 = b[0]
    var a_off = a[1]
    var b_off = b[1]
    var n = a[2]
    var bn = b[2]
    if n != bn { return _err_invalid_arg("dot_f32_view: length mismatch") }
    var a_stride = 1
    var b_stride = 1
    if al == 4 { a_stride = a[3] }
    if bl == 4 { b_stride = b[3] }

    if a_stride == 1 && b_stride == 1 {
        return oren_buf_dot_f32_slice(a_buf, a_off, b_buf, b_off, n)
    }
    return oren_buf_dot_f32_strided(a_buf, a_off, a_stride, b_buf, b_off, b_stride, n)
}

fn dot_f64_view(a, b) {
    var al = _view_len(a)
    var bl = _view_len(b)
    if al < 0 || bl < 0 { return _err_invalid_arg("dot_f64_view: expects view lists") }
    if (al != 3 && al != 4) || (bl != 3 && bl != 4) { return _err_invalid_arg("dot_f64_view: expects slice/strided") }

    var a_buf: []f64 = a[0]
    var b_buf: []f64 = b[0]
    var a_off = a[1]
    var b_off = b[1]
    var n = a[2]
    var bn = b[2]
    if n != bn { return _err_invalid_arg("dot_f64_view: length mismatch") }
    var a_stride = 1
    var b_stride = 1
    if al == 4 { a_stride = a[3] }
    if bl == 4 { b_stride = b[3] }

    if a_stride == 1 && b_stride == 1 {
        return oren_buf_dot_f64_slice(a_buf, a_off, b_buf, b_off, n)
    }
    return oren_buf_dot_f64_strided(a_buf, a_off, a_stride, b_buf, b_off, b_stride, n)
}

// --- axpy (y := a*x + y) ---

fn axpy_f64(alpha, x, y) {
    var n = _vec2_len(x, y, "axpy_f64")
    if oren_is_err(n) { return n }
    var out = []
    var i = 0
    while i < n {
        oren_list_push(out, alpha * x[i] + y[i])
        i = i + 1
    }
    return out
}

fn axpy_f64_in_place(alpha, x, y) {
    var n = _vec2_len(x, y, "axpy_f64_in_place")
    if oren_is_err(n) { return n }
    var i = 0
    while i < n {
        y[i] = alpha * x[i] + y[i]
        i = i + 1
    }
    return y
}

fn axpy_f32(alpha, x, y) {
    var out = axpy_f64(alpha, x, y)
    if oren_is_err(out) { return out }
    // Round each element to float32 boundary.
    var i = 0
    while i < oren_list_len(out) {
        out[i] = f32(out[i])
        i = i + 1
    }
    return out
}

fn axpy_f32_buf_in_place(alpha, x: []f32, y: []f32) {
    return oren_buf_axpy_f32_in_place(alpha, x, y)
}

fn axpy_f32_buf(alpha, x: []f32, y: []f32) {
    var n = buffer.len(x)
    if oren_is_err(n) { return n }
    var ny = buffer.len(y)
    if oren_is_err(ny) { return ny }
    if n != ny { return _err_invalid_arg("axpy_f32_buf: length mismatch") }
    var out: []f32 = buffer.f32_new(n)
    if oren_is_err(out) { return out }
    return oren_buf_axpy_f32_into(out, alpha, x, y)
}

fn axpy_i32_buf_in_place(alpha, x: []i32, y: []i32) {
    return oren_buf_axpy_i32_in_place(alpha, x, y)
}

fn axpy_i32_buf(alpha, x: []i32, y: []i32) {
    var n = buffer.len(x)
    if oren_is_err(n) { return n }
    var ny = buffer.len(y)
    if oren_is_err(ny) { return ny }
    if n != ny { return _err_invalid_arg("axpy_i32_buf: length mismatch") }
    var out: []i32 = buffer.i32_new(n)
    if oren_is_err(out) { return out }
    return oren_buf_axpy_i32_into(out, alpha, x, y)
}

// --- matrix multiplication ---
//
// Row-major, flat arrays:
// - A is m x n, length m*n, indexed as A[i*n + k]
// - B is n x p, length n*p, indexed as B[k*p + j]
// - Out is m x p, length m*p, indexed as Out[i*p + j]

fn matmul_f64(a, b, m, n, p) {
    if m < 0 || n < 0 || p < 0 {
        return _err_invalid_arg("matmul_f64: negative dims")
    }
    if oren_list_len(a) != m * n {
        return _err_invalid_arg("matmul_f64: A length mismatch")
    }
    if oren_list_len(b) != n * p {
        return _err_invalid_arg("matmul_f64: B length mismatch")
    }

    var out = []
    var i = 0
    while i < m {
        var j = 0
        while j < p {
            var k = 0
            var s = 0.0
            while k < n {
                s = s + a[i * n + k] * b[k * p + j]
                k = k + 1
            }
            oren_list_push(out, s)
            j = j + 1
        }
        i = i + 1
    }
    return out
}

fn matmul_f32(a, b, m, n, p) {
    var out = matmul_f64(a, b, m, n, p)
    if oren_is_err(out) { return out }
    var i = 0
    while i < oren_list_len(out) {
        out[i] = f32(out[i])
        i = i + 1
    }
    return out
}

// --- typed-buffer matmul ---
//
// These are the baseline building blocks for HPC workloads. They are scalar-first
// but designed so future NEON kernels can replace the hot loops behind a stable
// intrinsic/runtime boundary.
//
// Row-major, flat buffers:
// - A is m x n, length m*n, indexed as A[i*n + k]
// - B is n x p, length n*p, indexed as B[k*p + j]
// - Out is m x p, length m*p, indexed as Out[i*p + j]

fn matmul_f32_buf(a: []f32, b: []f32, m, n, p) {
    if m < 0 || n < 0 || p < 0 { return _err_invalid_arg("matmul_f32_buf: negative dims") }
    var na = buffer.len(a)
    if oren_is_err(na) { return na }
    var nb = buffer.len(b)
    if oren_is_err(nb) { return nb }
    if na != m * n { return _err_invalid_arg("matmul_f32_buf: A length mismatch") }
    if nb != n * p { return _err_invalid_arg("matmul_f32_buf: B length mismatch") }

    var out: []f32 = buffer.f32_new(m * p)
    if oren_is_err(out) { return out }

    var rc = matmul_f32_buf_into(out, a, b, m, n, p)
    if oren_is_err(rc) { return rc }
    return out
}

fn matmul_f32_buf_into(out: []f32, a: []f32, b: []f32, m, n, p) {
    // In-place variant of matmul for HPC workloads.
    if m < 0 || n < 0 || p < 0 { return _err_invalid_arg("matmul_f32_buf_into: negative dims") }
    var na = buffer.len(a)
    if oren_is_err(na) { return na }
    var nb = buffer.len(b)
    if oren_is_err(nb) { return nb }
    var no = buffer.len(out)
    if oren_is_err(no) { return no }
    if na != m * n { return _err_invalid_arg("matmul_f32_buf_into: A length mismatch") }
    if nb != n * p { return _err_invalid_arg("matmul_f32_buf_into: B length mismatch") }
    if no != m * p { return _err_invalid_arg("matmul_f32_buf_into: out length mismatch") }

    return _matmul_f32_buf_kernel(out, a, b, m, n, p)
}

fn _matmul_f32_buf_kernel(out: []f32, a: []f32, b: []f32, m, n, p) {
    // Shared implementation for `matmul_f32_buf` and `matmul_f32_buf_into`.
    //
    // Keep scalar-first deterministic semantics; allow packed layout and microkernel
    // dispatch behind stable runtime boundaries.
    var JB = 4
    var KB = 64
    var tiles_j = (p + JB - 1) / JB
    var tiles_k = (n + KB - 1) / KB
    var use_packed = (n >= KB) && (p >= JB) && (n * p >= 4096)

    // If we are packing, pack directly from B without materializing Bt.
    // If we are not packing, build Bt (transpose) so each column is contiguous.
    var bt: []f32 = nil
    var bp: []f32 = nil
    if use_packed {
        bp = buffer.f32_new(tiles_j * tiles_k * JB * KB)
        if oren_is_err(bp) { return bp }
        var bj = 0
        while bj < tiles_j {
            var bk = 0
            while bk < tiles_k {
                var j_in = 0
                while j_in < JB {
                    var global_j = bj * JB + j_in
                    var k_in = 0
                    while k_in < KB {
                        var global_k = bk * KB + k_in
                        var v = 0.0
                        if global_j < p && global_k < n {
                            v = oren_buf_load_f32(b, global_k * p + global_j)
                            if oren_is_err(v) { return v }
                        }
                        var dst = (((bj * tiles_k + bk) * JB + j_in) * KB + k_in)
                        oren_buf_store_f32(bp, dst, v)
                        k_in = k_in + 1
                    }
                    j_in = j_in + 1
                }
                bk = bk + 1
            }
            bj = bj + 1
        }
    } else {
        // Bt is p x n, indexed Bt[j*n + k] = B[k*p + j].
        bt = buffer.f32_new(n * p)
        if oren_is_err(bt) { return bt }
        var k0 = 0
        while k0 < n {
            var j0 = 0
            while j0 < p {
                var v2 = oren_buf_load_f32(b, k0 * p + j0)
                if oren_is_err(v2) { return v2 }
                oren_buf_store_f32(bt, j0 * n + k0, v2)
                j0 = j0 + 1
            }
            k0 = k0 + 1
        }
    }

    // Reusable scratch for the 1x4 dot microkernel.
    // Allocate once (instead of per-row) to avoid O(m) allocations in HPC workloads.
    var tmp4: []f64 = buffer.f64_new(4)
    if oren_is_err(tmp4) { return tmp4 }

    // Reusable scratch for the 4x4 GEMM microkernel (used by packed and non-packed paths).
    // Allocate once to avoid repeated allocs in HPC workloads.
    var tmp16: []f64 = nil
    if m >= 4 && p >= 4 {
        tmp16 = buffer.f64_new(16)
        if oren_is_err(tmp16) { return tmp16 }
    }

    var i = 0
    while i < m {
        // 4x4 microkernel: reuse B across 4 rows when we have a full 4-row block.
        // This reduces interpreter/native boundary overhead in HPC workloads.
        if use_packed && i + 3 < m {
            var bj_blk = 0
            while bj_blk < tiles_j {
                var base_j_blk = bj_blk * JB

                if base_j_blk + 3 < p {
                    // Full 4-column block: use the 4x4 microkernel per k-block.
                    var s00 = 0.0; var s01 = 0.0; var s02 = 0.0; var s03 = 0.0
                    var s10 = 0.0; var s11 = 0.0; var s12 = 0.0; var s13 = 0.0
                    var s20 = 0.0; var s21 = 0.0; var s22 = 0.0; var s23 = 0.0
                    var s30 = 0.0; var s31 = 0.0; var s32 = 0.0; var s33 = 0.0

                    var bk_blk = 0
                    while bk_blk < tiles_k {
                        var kbase_blk = bk_blk * KB
                        var kn_blk = n - kbase_blk
                        if kn_blk > KB { kn_blk = KB }
                        var base_tile_blk = (bj_blk * tiles_k + bk_blk) * JB * KB

                        var rr = oren_buf_gemm_f32_4x4_slice_into(
                            tmp16, 0,
                            a,
                            (i + 0) * n + kbase_blk,
                            (i + 1) * n + kbase_blk,
                            (i + 2) * n + kbase_blk,
                            (i + 3) * n + kbase_blk,
                            bp,
                            base_tile_blk + 0 * KB,
                            base_tile_blk + 1 * KB,
                            base_tile_blk + 2 * KB,
                            base_tile_blk + 3 * KB,
                            kn_blk)
                        if oren_is_err(rr) { return rr }

                        // Accumulate partials in deterministic increasing-k order (per k-block).
                        s00 = s00 + oren_buf_load_f64(tmp16, 0)
                        s01 = s01 + oren_buf_load_f64(tmp16, 1)
                        s02 = s02 + oren_buf_load_f64(tmp16, 2)
                        s03 = s03 + oren_buf_load_f64(tmp16, 3)

                        s10 = s10 + oren_buf_load_f64(tmp16, 4)
                        s11 = s11 + oren_buf_load_f64(tmp16, 5)
                        s12 = s12 + oren_buf_load_f64(tmp16, 6)
                        s13 = s13 + oren_buf_load_f64(tmp16, 7)

                        s20 = s20 + oren_buf_load_f64(tmp16, 8)
                        s21 = s21 + oren_buf_load_f64(tmp16, 9)
                        s22 = s22 + oren_buf_load_f64(tmp16, 10)
                        s23 = s23 + oren_buf_load_f64(tmp16, 11)

                        s30 = s30 + oren_buf_load_f64(tmp16, 12)
                        s31 = s31 + oren_buf_load_f64(tmp16, 13)
                        s32 = s32 + oren_buf_load_f64(tmp16, 14)
                        s33 = s33 + oren_buf_load_f64(tmp16, 15)

                        bk_blk = bk_blk + 1
                    }

                    // Store 4x4 block (round to f32 boundary at store).
                    oren_buf_store_f32(out, (i + 0) * p + (base_j_blk + 0), f32(s00))
                    oren_buf_store_f32(out, (i + 0) * p + (base_j_blk + 1), f32(s01))
                    oren_buf_store_f32(out, (i + 0) * p + (base_j_blk + 2), f32(s02))
                    oren_buf_store_f32(out, (i + 0) * p + (base_j_blk + 3), f32(s03))

                    oren_buf_store_f32(out, (i + 1) * p + (base_j_blk + 0), f32(s10))
                    oren_buf_store_f32(out, (i + 1) * p + (base_j_blk + 1), f32(s11))
                    oren_buf_store_f32(out, (i + 1) * p + (base_j_blk + 2), f32(s12))
                    oren_buf_store_f32(out, (i + 1) * p + (base_j_blk + 3), f32(s13))

                    oren_buf_store_f32(out, (i + 2) * p + (base_j_blk + 0), f32(s20))
                    oren_buf_store_f32(out, (i + 2) * p + (base_j_blk + 1), f32(s21))
                    oren_buf_store_f32(out, (i + 2) * p + (base_j_blk + 2), f32(s22))
                    oren_buf_store_f32(out, (i + 2) * p + (base_j_blk + 3), f32(s23))

                    oren_buf_store_f32(out, (i + 3) * p + (base_j_blk + 0), f32(s30))
                    oren_buf_store_f32(out, (i + 3) * p + (base_j_blk + 1), f32(s31))
                    oren_buf_store_f32(out, (i + 3) * p + (base_j_blk + 2), f32(s32))
                    oren_buf_store_f32(out, (i + 3) * p + (base_j_blk + 3), f32(s33))
                } else {
                    // Tail columns: packed-B zero-pads out-of-range columns, so we can still use
                    // the 4x4 microkernel and only store the in-range columns.
                    var s00 = 0.0; var s01 = 0.0; var s02 = 0.0; var s03 = 0.0
                    var s10 = 0.0; var s11 = 0.0; var s12 = 0.0; var s13 = 0.0
                    var s20 = 0.0; var s21 = 0.0; var s22 = 0.0; var s23 = 0.0
                    var s30 = 0.0; var s31 = 0.0; var s32 = 0.0; var s33 = 0.0

                    var bk_blk = 0
                    while bk_blk < tiles_k {
                        var kbase_blk = bk_blk * KB
                        var kn_blk = n - kbase_blk
                        if kn_blk > KB { kn_blk = KB }
                        var base_tile_blk = (bj_blk * tiles_k + bk_blk) * JB * KB

                        var rr = oren_buf_gemm_f32_4x4_slice_into(
                            tmp16, 0,
                            a,
                            (i + 0) * n + kbase_blk,
                            (i + 1) * n + kbase_blk,
                            (i + 2) * n + kbase_blk,
                            (i + 3) * n + kbase_blk,
                            bp,
                            base_tile_blk + 0 * KB,
                            base_tile_blk + 1 * KB,
                            base_tile_blk + 2 * KB,
                            base_tile_blk + 3 * KB,
                            kn_blk)
                        if oren_is_err(rr) { return rr }

                        // Accumulate partials in deterministic increasing-k order (per k-block).
                        s00 = s00 + oren_buf_load_f64(tmp16, 0)
                        s01 = s01 + oren_buf_load_f64(tmp16, 1)
                        s02 = s02 + oren_buf_load_f64(tmp16, 2)
                        s03 = s03 + oren_buf_load_f64(tmp16, 3)

                        s10 = s10 + oren_buf_load_f64(tmp16, 4)
                        s11 = s11 + oren_buf_load_f64(tmp16, 5)
                        s12 = s12 + oren_buf_load_f64(tmp16, 6)
                        s13 = s13 + oren_buf_load_f64(tmp16, 7)

                        s20 = s20 + oren_buf_load_f64(tmp16, 8)
                        s21 = s21 + oren_buf_load_f64(tmp16, 9)
                        s22 = s22 + oren_buf_load_f64(tmp16, 10)
                        s23 = s23 + oren_buf_load_f64(tmp16, 11)

                        s30 = s30 + oren_buf_load_f64(tmp16, 12)
                        s31 = s31 + oren_buf_load_f64(tmp16, 13)
                        s32 = s32 + oren_buf_load_f64(tmp16, 14)
                        s33 = s33 + oren_buf_load_f64(tmp16, 15)

                        bk_blk = bk_blk + 1
                    }

                    // Store only in-range columns.
                    if base_j_blk + 0 < p {
                        oren_buf_store_f32(out, (i + 0) * p + (base_j_blk + 0), f32(s00))
                        oren_buf_store_f32(out, (i + 1) * p + (base_j_blk + 0), f32(s10))
                        oren_buf_store_f32(out, (i + 2) * p + (base_j_blk + 0), f32(s20))
                        oren_buf_store_f32(out, (i + 3) * p + (base_j_blk + 0), f32(s30))
                    }
                    if base_j_blk + 1 < p {
                        oren_buf_store_f32(out, (i + 0) * p + (base_j_blk + 1), f32(s01))
                        oren_buf_store_f32(out, (i + 1) * p + (base_j_blk + 1), f32(s11))
                        oren_buf_store_f32(out, (i + 2) * p + (base_j_blk + 1), f32(s21))
                        oren_buf_store_f32(out, (i + 3) * p + (base_j_blk + 1), f32(s31))
                    }
                    if base_j_blk + 2 < p {
                        oren_buf_store_f32(out, (i + 0) * p + (base_j_blk + 2), f32(s02))
                        oren_buf_store_f32(out, (i + 1) * p + (base_j_blk + 2), f32(s12))
                        oren_buf_store_f32(out, (i + 2) * p + (base_j_blk + 2), f32(s22))
                        oren_buf_store_f32(out, (i + 3) * p + (base_j_blk + 2), f32(s32))
                    }
                    if base_j_blk + 3 < p {
                        oren_buf_store_f32(out, (i + 0) * p + (base_j_blk + 3), f32(s03))
                        oren_buf_store_f32(out, (i + 1) * p + (base_j_blk + 3), f32(s13))
                        oren_buf_store_f32(out, (i + 2) * p + (base_j_blk + 3), f32(s23))
                        oren_buf_store_f32(out, (i + 3) * p + (base_j_blk + 3), f32(s33))
                    }
                }

                bj_blk = bj_blk + 1
            }

            i = i + 4
            continue
        }

        // Non-packed 4x4 microkernel: Bt columns are contiguous, so we can compute a full 4x4
        // block over the entire n in a single call.
        if use_packed == 0 && i + 3 < m && tmp16 != nil {
            var bj_blk2 = 0
            while bj_blk2 < tiles_j {
                var base_j_blk2 = bj_blk2 * JB
                if base_j_blk2 + 3 < p {
                    var rr2 = oren_buf_gemm_f32_4x4_slice_into(
                        tmp16, 0,
                        a,
                        (i + 0) * n,
                        (i + 1) * n,
                        (i + 2) * n,
                        (i + 3) * n,
                        bt,
                        (base_j_blk2 + 0) * n,
                        (base_j_blk2 + 1) * n,
                        (base_j_blk2 + 2) * n,
                        (base_j_blk2 + 3) * n,
                        n)
                    if oren_is_err(rr2) { return rr2 }

                    // Store 4x4 block (round to f32 boundary at store).
                    oren_buf_store_f32(out, (i + 0) * p + (base_j_blk2 + 0), f32(oren_buf_load_f64(tmp16, 0)))
                    oren_buf_store_f32(out, (i + 0) * p + (base_j_blk2 + 1), f32(oren_buf_load_f64(tmp16, 1)))
                    oren_buf_store_f32(out, (i + 0) * p + (base_j_blk2 + 2), f32(oren_buf_load_f64(tmp16, 2)))
                    oren_buf_store_f32(out, (i + 0) * p + (base_j_blk2 + 3), f32(oren_buf_load_f64(tmp16, 3)))

                    oren_buf_store_f32(out, (i + 1) * p + (base_j_blk2 + 0), f32(oren_buf_load_f64(tmp16, 4)))
                    oren_buf_store_f32(out, (i + 1) * p + (base_j_blk2 + 1), f32(oren_buf_load_f64(tmp16, 5)))
                    oren_buf_store_f32(out, (i + 1) * p + (base_j_blk2 + 2), f32(oren_buf_load_f64(tmp16, 6)))
                    oren_buf_store_f32(out, (i + 1) * p + (base_j_blk2 + 3), f32(oren_buf_load_f64(tmp16, 7)))

                    oren_buf_store_f32(out, (i + 2) * p + (base_j_blk2 + 0), f32(oren_buf_load_f64(tmp16, 8)))
                    oren_buf_store_f32(out, (i + 2) * p + (base_j_blk2 + 1), f32(oren_buf_load_f64(tmp16, 9)))
                    oren_buf_store_f32(out, (i + 2) * p + (base_j_blk2 + 2), f32(oren_buf_load_f64(tmp16, 10)))
                    oren_buf_store_f32(out, (i + 2) * p + (base_j_blk2 + 3), f32(oren_buf_load_f64(tmp16, 11)))

                    oren_buf_store_f32(out, (i + 3) * p + (base_j_blk2 + 0), f32(oren_buf_load_f64(tmp16, 12)))
                    oren_buf_store_f32(out, (i + 3) * p + (base_j_blk2 + 1), f32(oren_buf_load_f64(tmp16, 13)))
                    oren_buf_store_f32(out, (i + 3) * p + (base_j_blk2 + 2), f32(oren_buf_load_f64(tmp16, 14)))
                    oren_buf_store_f32(out, (i + 3) * p + (base_j_blk2 + 3), f32(oren_buf_load_f64(tmp16, 15)))
                } else {
                    // Tail columns: fall back to the existing 1-row dot kernels below.
                    var row2 = 0
                    while row2 < 4 {
                        if base_j_blk2 + 0 < p {
                            oren_buf_store_f32(
                                out,
                                (i + row2) * p + (base_j_blk2 + 0),
                                f32(oren_buf_dot_f32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 0) * n, n)))
                        }
                        if base_j_blk2 + 1 < p {
                            oren_buf_store_f32(
                                out,
                                (i + row2) * p + (base_j_blk2 + 1),
                                f32(oren_buf_dot_f32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 1) * n, n)))
                        }
                        if base_j_blk2 + 2 < p {
                            oren_buf_store_f32(
                                out,
                                (i + row2) * p + (base_j_blk2 + 2),
                                f32(oren_buf_dot_f32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 2) * n, n)))
                        }
                        if base_j_blk2 + 3 < p {
                            oren_buf_store_f32(
                                out,
                                (i + row2) * p + (base_j_blk2 + 3),
                                f32(oren_buf_dot_f32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 3) * n, n)))
                        }
                        row2 = row2 + 1
                    }
                }
                bj_blk2 = bj_blk2 + 1
            }
            i = i + 4
            continue
        }

        // Scalar / 1-row path (still uses dot kernels, but not the 4x4 microkernel).
        var bj2 = 0
        while bj2 < tiles_j {
            var base_j = bj2 * JB

            var s0 = 0.0
            var s1 = 0.0
            var s2 = 0.0
            var s3 = 0.0

            if use_packed {
                var bk2 = 0
                while bk2 < tiles_k {
                    var kbase = bk2 * KB
                    var kn = n - kbase
                    if kn > KB { kn = KB }
                    var base_tile = (bj2 * tiles_k + bk2) * JB * KB

                    if base_j + 0 < p { s0 = s0 + oren_buf_dot_f32_slice(a, i * n + kbase, bp, base_tile + 0 * KB, kn) }
                    if base_j + 1 < p { s1 = s1 + oren_buf_dot_f32_slice(a, i * n + kbase, bp, base_tile + 1 * KB, kn) }
                    if base_j + 2 < p { s2 = s2 + oren_buf_dot_f32_slice(a, i * n + kbase, bp, base_tile + 2 * KB, kn) }
                    if base_j + 3 < p { s3 = s3 + oren_buf_dot_f32_slice(a, i * n + kbase, bp, base_tile + 3 * KB, kn) }
                    bk2 = bk2 + 1
                }
            } else {
                // Bt path: each column is contiguous so we can compute up to 4 dots in one call.
                if base_j + 3 < p {
                    var r2 = oren_buf_dot_f32_4_slice_into(
                        tmp4, 0,
                        a, i * n,
                        bt,
                        (base_j + 0) * n,
                        (base_j + 1) * n,
                        (base_j + 2) * n,
                        (base_j + 3) * n,
                        n)
                    if oren_is_err(r2) { return r2 }
                    s0 = oren_buf_load_f64(tmp4, 0)
                    s1 = oren_buf_load_f64(tmp4, 1)
                    s2 = oren_buf_load_f64(tmp4, 2)
                    s3 = oren_buf_load_f64(tmp4, 3)
                    if oren_is_err(s0) { return s0 }
                    if oren_is_err(s1) { return s1 }
                    if oren_is_err(s2) { return s2 }
                    if oren_is_err(s3) { return s3 }
                } else {
                    if base_j + 0 < p { s0 = oren_buf_dot_f32_slice(a, i * n, bt, (base_j + 0) * n, n) }
                    if base_j + 1 < p { s1 = oren_buf_dot_f32_slice(a, i * n, bt, (base_j + 1) * n, n) }
                    if base_j + 2 < p { s2 = oren_buf_dot_f32_slice(a, i * n, bt, (base_j + 2) * n, n) }
                    if base_j + 3 < p { s3 = oren_buf_dot_f32_slice(a, i * n, bt, (base_j + 3) * n, n) }
                }
            }

            if base_j + 0 < p { oren_buf_store_f32(out, i * p + (base_j + 0), f32(s0)) }
            if base_j + 1 < p { oren_buf_store_f32(out, i * p + (base_j + 1), f32(s1)) }
            if base_j + 2 < p { oren_buf_store_f32(out, i * p + (base_j + 2), f32(s2)) }
            if base_j + 3 < p { oren_buf_store_f32(out, i * p + (base_j + 3), f32(s3)) }

            bj2 = bj2 + 1
        }
        i = i + 1
    }

    return 0
}

fn matmul_f64_buf(a: []f64, b: []f64, m, n, p) {
    if m < 0 || n < 0 || p < 0 { return _err_invalid_arg("matmul_f64_buf: negative dims") }
    var na = buffer.len(a)
    if oren_is_err(na) { return na }
    var nb = buffer.len(b)
    if oren_is_err(nb) { return nb }
    if na != m * n { return _err_invalid_arg("matmul_f64_buf: A length mismatch") }
    if nb != n * p { return _err_invalid_arg("matmul_f64_buf: B length mismatch") }

    var out: []f64 = buffer.f64_new(m * p)
    if oren_is_err(out) { return out }

    // Transpose B so each column becomes a contiguous row in Bt, then compute each
    // output as a sum of deterministic dot slices (increasing-k blocks).
    //
    // Bt is p x n, indexed Bt[j*n + k] = B[k*p + j].
    var bt: []f64 = buffer.f64_new(n * p)
    if oren_is_err(bt) { return bt }
    var k0 = 0
    while k0 < n {
        var j0 = 0
        while j0 < p {
            var v = oren_buf_load_f64(b, k0 * p + j0)
            if oren_is_err(v) { return v }
            oren_buf_store_f64(bt, j0 * n + k0, v)
            j0 = j0 + 1
        }
        k0 = k0 + 1
    }

    var JB = 4
    var KB = 64
    var tiles_j = (p + JB - 1) / JB
    var tiles_k = (n + KB - 1) / KB
    var use_packed = (n >= KB) && (p >= JB) && (n * p >= 4096)

    var bp: []f64 = nil
    if use_packed {
        bp = buffer.f64_new(tiles_j * tiles_k * JB * KB)
        if oren_is_err(bp) { return bp }
        var bj = 0
        while bj < tiles_j {
            var bk = 0
            while bk < tiles_k {
                var j_in = 0
                while j_in < JB {
                    var global_j = bj * JB + j_in
                    var k_in = 0
                    while k_in < KB {
                        var global_k = bk * KB + k_in
                        var v2 = 0.0
                        if global_j < p && global_k < n {
                            v2 = oren_buf_load_f64(bt, global_j * n + global_k)
                            if oren_is_err(v2) { return v2 }
                        }
                        var dst = (((bj * tiles_k + bk) * JB + j_in) * KB + k_in)
                        oren_buf_store_f64(bp, dst, v2)
                        k_in = k_in + 1
                    }
                    j_in = j_in + 1
                }
                bk = bk + 1
            }
            bj = bj + 1
        }
    }

    var i = 0
    while i < m {
        var bj2 = 0
        while bj2 < tiles_j {
            var base_j = bj2 * JB
            var s0 = 0.0
            var s1 = 0.0
            var s2 = 0.0
            var s3 = 0.0

            var bk2 = 0
            while bk2 < tiles_k {
                var kbase = bk2 * KB
                var kn = n - kbase
                if kn > KB { kn = KB }

                if use_packed {
                    var base_tile = (bj2 * tiles_k + bk2) * JB * KB
                    if base_j + 0 < p { s0 = s0 + oren_buf_dot_f64_slice(a, i * n + kbase, bp, base_tile + 0 * KB, kn) }
                    if base_j + 1 < p { s1 = s1 + oren_buf_dot_f64_slice(a, i * n + kbase, bp, base_tile + 1 * KB, kn) }
                    if base_j + 2 < p { s2 = s2 + oren_buf_dot_f64_slice(a, i * n + kbase, bp, base_tile + 2 * KB, kn) }
                    if base_j + 3 < p { s3 = s3 + oren_buf_dot_f64_slice(a, i * n + kbase, bp, base_tile + 3 * KB, kn) }
                } else {
                    if base_j + 0 < p { s0 = s0 + oren_buf_dot_f64_slice(a, i * n + kbase, bt, (base_j + 0) * n + kbase, kn) }
                    if base_j + 1 < p { s1 = s1 + oren_buf_dot_f64_slice(a, i * n + kbase, bt, (base_j + 1) * n + kbase, kn) }
                    if base_j + 2 < p { s2 = s2 + oren_buf_dot_f64_slice(a, i * n + kbase, bt, (base_j + 2) * n + kbase, kn) }
                    if base_j + 3 < p { s3 = s3 + oren_buf_dot_f64_slice(a, i * n + kbase, bt, (base_j + 3) * n + kbase, kn) }
                }
                bk2 = bk2 + 1
            }

            if base_j + 0 < p { oren_buf_store_f64(out, i * p + (base_j + 0), s0) }
            if base_j + 1 < p { oren_buf_store_f64(out, i * p + (base_j + 1), s1) }
            if base_j + 2 < p { oren_buf_store_f64(out, i * p + (base_j + 2), s2) }
            if base_j + 3 < p { oren_buf_store_f64(out, i * p + (base_j + 3), s3) }

            bj2 = bj2 + 1
        }
        i = i + 1
    }
    return out
}

// Matmul over matrix views (strided rows).
//
// View shape (see std/buffer):
//   [buf, off, rows, cols, row_stride]
//
// This is a correctness + ergonomics baseline. Hot loops can later be replaced
// by packed tiles/NEON microkernels while preserving semantics.
fn matmul_f32_mat_view(a, b) {
    if a == nil || b == nil { return _err_invalid_arg("matmul_f32_mat_view: nil view") }
    if oren_list_len(a) != 5 || oren_list_len(b) != 5 { return _err_invalid_arg("matmul_f32_mat_view: expects mat views") }

    var a_buf: []f32 = a[0]
    var b_buf: []f32 = b[0]
    var a_off = a[1]
    var m = a[2]
    var n = a[3]
    var a_stride = a[4]

    var b_off = b[1]
    var bn = b[2]
    var p = b[3]
    var b_stride = b[4]

    if bn != n { return _err_invalid_arg("matmul_f32_mat_view: dim mismatch") }
    if m < 0 || n < 0 || p < 0 { return _err_invalid_arg("matmul_f32_mat_view: negative dims") }

    var out: []f32 = buffer.f32_new(m * p)
    if oren_is_err(out) { return out }

    var i = 0
    while i < m {
        var j = 0
        while j < p {
            var s = 0.0
            var k = 0
            while k < n {
                var av = oren_buf_load_f32(a_buf, a_off + i * a_stride + k)
                var bv = oren_buf_load_f32(b_buf, b_off + k * b_stride + j)
                if oren_is_err(av) { return av }
                if oren_is_err(bv) { return bv }
                s = s + av * bv
                k = k + 1
            }
            var w = oren_buf_store_f32(out, i * p + j, s)
            if oren_is_err(w) { return w }
            j = j + 1
        }
        i = i + 1
    }
    return out
}

fn matmul_i32_buf(a: []i32, b: []i32, m, n, p) {
    // Semantics: compute each output element in i64 accumulation, then truncate/wrap to i32 at store boundary.
    // This matches the typed-buffer design: i32 is a width boundary, not the VM's arithmetic type.
    if m < 0 || n < 0 || p < 0 { return _err_invalid_arg("matmul_i32_buf: negative dims") }
    var na = buffer.len(a)
    if oren_is_err(na) { return na }
    var nb = buffer.len(b)
    if oren_is_err(nb) { return nb }
    if na != m * n { return _err_invalid_arg("matmul_i32_buf: A length mismatch") }
    if nb != n * p { return _err_invalid_arg("matmul_i32_buf: B length mismatch") }

    var out: []i32 = buffer.i32_new(m * p)
    if oren_is_err(out) { return out }

    // Optional packed-B layout (tile-major) for cache locality.
    // Mirrors the f32 matmul packing strategy, but for i32.
    var JB = 4
    var KB = 64
    var tiles_j = (p + JB - 1) / JB
    var tiles_k = (n + KB - 1) / KB
    var use_packed = (n >= KB) && (p >= JB) && (n * p >= 4096)

    // If we are packing, pack directly from B without materializing Bt.
    // If we are not packing, build Bt (transpose) so each column is contiguous.
    var bt: []i32 = nil
    var bp: []i32 = nil
    if use_packed {
        bp = buffer.i32_new(tiles_j * tiles_k * JB * KB)
        if oren_is_err(bp) { return bp }
        var bj0 = 0
        while bj0 < tiles_j {
            var bk0 = 0
            while bk0 < tiles_k {
                var j_in0 = 0
                while j_in0 < JB {
                    var global_j0 = bj0 * JB + j_in0
                    var k_in0 = 0
                    while k_in0 < KB {
                        var global_k0 = bk0 * KB + k_in0
                        var v0 = 0
                        if global_j0 < p && global_k0 < n {
                            v0 = oren_buf_load_i32(b, global_k0 * p + global_j0)
                            if oren_is_err(v0) { return v0 }
                        }
                        var dst0 = (((bj0 * tiles_k + bk0) * JB + j_in0) * KB + k_in0)
                        oren_buf_store_i32(bp, dst0, v0)
                        k_in0 = k_in0 + 1
                    }
                    j_in0 = j_in0 + 1
                }
                bk0 = bk0 + 1
            }
            bj0 = bj0 + 1
        }
    } else {
        // Transpose B to enable contiguous slice dot kernels.
        bt = buffer.i32_new(n * p)
        if oren_is_err(bt) { return bt }
        var k0 = 0
        while k0 < n {
            var j0 = 0
            while j0 < p {
                var v = oren_buf_load_i32(b, k0 * p + j0)
                if oren_is_err(v) { return v }
                oren_buf_store_i32(bt, j0 * n + k0, v)
                j0 = j0 + 1
            }
            k0 = k0 + 1
        }
    }

    // Reusable scratch for the 1x4 dot microkernel.
    // Allocate once (instead of per-row) to avoid O(m) allocations in HPC workloads.
    var tmp4: []i64 = buffer.i64_new(4)
    if oren_is_err(tmp4) { return tmp4 }

    // Reusable scratch for the 4x4 GEMM microkernel (used by packed and non-packed paths).
    var tmp16: []i64 = nil
    if m >= 4 && p >= 4 {
        tmp16 = buffer.i64_new(16)
        if oren_is_err(tmp16) { return tmp16 }
    }

    var i = 0
    while i < m {
        // 4x4 microkernel: reuse B across 4 rows when we have a full 4-row block.
        if use_packed && i + 3 < m {
            var bj_blk = 0
            while bj_blk < tiles_j {
                var base_j_blk = bj_blk * JB

                if base_j_blk + 3 < p {
                    // Full 4-column block: use the 4x4 microkernel per k-block.
                    var s00 = 0; var s01 = 0; var s02 = 0; var s03 = 0
                    var s10 = 0; var s11 = 0; var s12 = 0; var s13 = 0
                    var s20 = 0; var s21 = 0; var s22 = 0; var s23 = 0
                    var s30 = 0; var s31 = 0; var s32 = 0; var s33 = 0

                    var bk_blk = 0
                    while bk_blk < tiles_k {
                        var kbase_blk = bk_blk * KB
                        var kn_blk = n - kbase_blk
                        if kn_blk > KB { kn_blk = KB }
                        var base_tile_blk = (bj_blk * tiles_k + bk_blk) * JB * KB

                        var rr = oren_buf_gemm_i32_4x4_slice_into(
                            tmp16, 0,
                            a,
                            (i + 0) * n + kbase_blk,
                            (i + 1) * n + kbase_blk,
                            (i + 2) * n + kbase_blk,
                            (i + 3) * n + kbase_blk,
                            bp,
                            base_tile_blk + 0 * KB,
                            base_tile_blk + 1 * KB,
                            base_tile_blk + 2 * KB,
                            base_tile_blk + 3 * KB,
                            kn_blk)
                        if oren_is_err(rr) { return rr }

                        // Accumulate partials (k-blocks in increasing order).
                        s00 = s00 + oren_buf_load_i64(tmp16, 0)
                        s01 = s01 + oren_buf_load_i64(tmp16, 1)
                        s02 = s02 + oren_buf_load_i64(tmp16, 2)
                        s03 = s03 + oren_buf_load_i64(tmp16, 3)

                        s10 = s10 + oren_buf_load_i64(tmp16, 4)
                        s11 = s11 + oren_buf_load_i64(tmp16, 5)
                        s12 = s12 + oren_buf_load_i64(tmp16, 6)
                        s13 = s13 + oren_buf_load_i64(tmp16, 7)

                        s20 = s20 + oren_buf_load_i64(tmp16, 8)
                        s21 = s21 + oren_buf_load_i64(tmp16, 9)
                        s22 = s22 + oren_buf_load_i64(tmp16, 10)
                        s23 = s23 + oren_buf_load_i64(tmp16, 11)

                        s30 = s30 + oren_buf_load_i64(tmp16, 12)
                        s31 = s31 + oren_buf_load_i64(tmp16, 13)
                        s32 = s32 + oren_buf_load_i64(tmp16, 14)
                        s33 = s33 + oren_buf_load_i64(tmp16, 15)

                        bk_blk = bk_blk + 1
                    }

                    // Store 4x4 block (truncate/wrap to i32 boundary at store).
                    oren_buf_store_i32(out, (i + 0) * p + (base_j_blk + 0), i32(s00))
                    oren_buf_store_i32(out, (i + 0) * p + (base_j_blk + 1), i32(s01))
                    oren_buf_store_i32(out, (i + 0) * p + (base_j_blk + 2), i32(s02))
                    oren_buf_store_i32(out, (i + 0) * p + (base_j_blk + 3), i32(s03))

                    oren_buf_store_i32(out, (i + 1) * p + (base_j_blk + 0), i32(s10))
                    oren_buf_store_i32(out, (i + 1) * p + (base_j_blk + 1), i32(s11))
                    oren_buf_store_i32(out, (i + 1) * p + (base_j_blk + 2), i32(s12))
                    oren_buf_store_i32(out, (i + 1) * p + (base_j_blk + 3), i32(s13))

                    oren_buf_store_i32(out, (i + 2) * p + (base_j_blk + 0), i32(s20))
                    oren_buf_store_i32(out, (i + 2) * p + (base_j_blk + 1), i32(s21))
                    oren_buf_store_i32(out, (i + 2) * p + (base_j_blk + 2), i32(s22))
                    oren_buf_store_i32(out, (i + 2) * p + (base_j_blk + 3), i32(s23))

                    oren_buf_store_i32(out, (i + 3) * p + (base_j_blk + 0), i32(s30))
                    oren_buf_store_i32(out, (i + 3) * p + (base_j_blk + 1), i32(s31))
                    oren_buf_store_i32(out, (i + 3) * p + (base_j_blk + 2), i32(s32))
                    oren_buf_store_i32(out, (i + 3) * p + (base_j_blk + 3), i32(s33))
                } else {
                    // Tail columns: packed-B zero-pads out-of-range columns, so we can still use
                    // the 4x4 microkernel and only store the in-range columns.
                    var s00 = 0; var s01 = 0; var s02 = 0; var s03 = 0
                    var s10 = 0; var s11 = 0; var s12 = 0; var s13 = 0
                    var s20 = 0; var s21 = 0; var s22 = 0; var s23 = 0
                    var s30 = 0; var s31 = 0; var s32 = 0; var s33 = 0

                    var bk_blk = 0
                    while bk_blk < tiles_k {
                        var kbase_blk = bk_blk * KB
                        var kn_blk = n - kbase_blk
                        if kn_blk > KB { kn_blk = KB }
                        var base_tile_blk = (bj_blk * tiles_k + bk_blk) * JB * KB

                        var rr = oren_buf_gemm_i32_4x4_slice_into(
                            tmp16, 0,
                            a,
                            (i + 0) * n + kbase_blk,
                            (i + 1) * n + kbase_blk,
                            (i + 2) * n + kbase_blk,
                            (i + 3) * n + kbase_blk,
                            bp,
                            base_tile_blk + 0 * KB,
                            base_tile_blk + 1 * KB,
                            base_tile_blk + 2 * KB,
                            base_tile_blk + 3 * KB,
                            kn_blk)
                        if oren_is_err(rr) { return rr }

                        // Accumulate partials (k-blocks in increasing order).
                        s00 = s00 + oren_buf_load_i64(tmp16, 0)
                        s01 = s01 + oren_buf_load_i64(tmp16, 1)
                        s02 = s02 + oren_buf_load_i64(tmp16, 2)
                        s03 = s03 + oren_buf_load_i64(tmp16, 3)

                        s10 = s10 + oren_buf_load_i64(tmp16, 4)
                        s11 = s11 + oren_buf_load_i64(tmp16, 5)
                        s12 = s12 + oren_buf_load_i64(tmp16, 6)
                        s13 = s13 + oren_buf_load_i64(tmp16, 7)

                        s20 = s20 + oren_buf_load_i64(tmp16, 8)
                        s21 = s21 + oren_buf_load_i64(tmp16, 9)
                        s22 = s22 + oren_buf_load_i64(tmp16, 10)
                        s23 = s23 + oren_buf_load_i64(tmp16, 11)

                        s30 = s30 + oren_buf_load_i64(tmp16, 12)
                        s31 = s31 + oren_buf_load_i64(tmp16, 13)
                        s32 = s32 + oren_buf_load_i64(tmp16, 14)
                        s33 = s33 + oren_buf_load_i64(tmp16, 15)

                        bk_blk = bk_blk + 1
                    }

                    if base_j_blk + 0 < p {
                        oren_buf_store_i32(out, (i + 0) * p + (base_j_blk + 0), i32(s00))
                        oren_buf_store_i32(out, (i + 1) * p + (base_j_blk + 0), i32(s10))
                        oren_buf_store_i32(out, (i + 2) * p + (base_j_blk + 0), i32(s20))
                        oren_buf_store_i32(out, (i + 3) * p + (base_j_blk + 0), i32(s30))
                    }
                    if base_j_blk + 1 < p {
                        oren_buf_store_i32(out, (i + 0) * p + (base_j_blk + 1), i32(s01))
                        oren_buf_store_i32(out, (i + 1) * p + (base_j_blk + 1), i32(s11))
                        oren_buf_store_i32(out, (i + 2) * p + (base_j_blk + 1), i32(s21))
                        oren_buf_store_i32(out, (i + 3) * p + (base_j_blk + 1), i32(s31))
                    }
                    if base_j_blk + 2 < p {
                        oren_buf_store_i32(out, (i + 0) * p + (base_j_blk + 2), i32(s02))
                        oren_buf_store_i32(out, (i + 1) * p + (base_j_blk + 2), i32(s12))
                        oren_buf_store_i32(out, (i + 2) * p + (base_j_blk + 2), i32(s22))
                        oren_buf_store_i32(out, (i + 3) * p + (base_j_blk + 2), i32(s32))
                    }
                    if base_j_blk + 3 < p {
                        oren_buf_store_i32(out, (i + 0) * p + (base_j_blk + 3), i32(s03))
                        oren_buf_store_i32(out, (i + 1) * p + (base_j_blk + 3), i32(s13))
                        oren_buf_store_i32(out, (i + 2) * p + (base_j_blk + 3), i32(s23))
                        oren_buf_store_i32(out, (i + 3) * p + (base_j_blk + 3), i32(s33))
                    }
                }

                bj_blk = bj_blk + 1
            }

            i = i + 4
            continue
        }

        // Non-packed 4x4 microkernel: Bt columns are contiguous, so we can compute a full 4x4
        // block over the entire n in a single call.
        if use_packed == 0 && i + 3 < m && tmp16 != nil {
            var bj_blk2 = 0
            while bj_blk2 < tiles_j {
                var base_j_blk2 = bj_blk2 * JB
                if base_j_blk2 + 3 < p {
                    var rr2 = oren_buf_gemm_i32_4x4_slice_into(
                        tmp16, 0,
                        a,
                        (i + 0) * n,
                        (i + 1) * n,
                        (i + 2) * n,
                        (i + 3) * n,
                        bt,
                        (base_j_blk2 + 0) * n,
                        (base_j_blk2 + 1) * n,
                        (base_j_blk2 + 2) * n,
                        (base_j_blk2 + 3) * n,
                        n)
                    if oren_is_err(rr2) { return rr2 }

                    // Store 4x4 block (truncate/wrap to i32 boundary at store).
                    oren_buf_store_i32(out, (i + 0) * p + (base_j_blk2 + 0), i32(oren_buf_load_i64(tmp16, 0)))
                    oren_buf_store_i32(out, (i + 0) * p + (base_j_blk2 + 1), i32(oren_buf_load_i64(tmp16, 1)))
                    oren_buf_store_i32(out, (i + 0) * p + (base_j_blk2 + 2), i32(oren_buf_load_i64(tmp16, 2)))
                    oren_buf_store_i32(out, (i + 0) * p + (base_j_blk2 + 3), i32(oren_buf_load_i64(tmp16, 3)))

                    oren_buf_store_i32(out, (i + 1) * p + (base_j_blk2 + 0), i32(oren_buf_load_i64(tmp16, 4)))
                    oren_buf_store_i32(out, (i + 1) * p + (base_j_blk2 + 1), i32(oren_buf_load_i64(tmp16, 5)))
                    oren_buf_store_i32(out, (i + 1) * p + (base_j_blk2 + 2), i32(oren_buf_load_i64(tmp16, 6)))
                    oren_buf_store_i32(out, (i + 1) * p + (base_j_blk2 + 3), i32(oren_buf_load_i64(tmp16, 7)))

                    oren_buf_store_i32(out, (i + 2) * p + (base_j_blk2 + 0), i32(oren_buf_load_i64(tmp16, 8)))
                    oren_buf_store_i32(out, (i + 2) * p + (base_j_blk2 + 1), i32(oren_buf_load_i64(tmp16, 9)))
                    oren_buf_store_i32(out, (i + 2) * p + (base_j_blk2 + 2), i32(oren_buf_load_i64(tmp16, 10)))
                    oren_buf_store_i32(out, (i + 2) * p + (base_j_blk2 + 3), i32(oren_buf_load_i64(tmp16, 11)))

                    oren_buf_store_i32(out, (i + 3) * p + (base_j_blk2 + 0), i32(oren_buf_load_i64(tmp16, 12)))
                    oren_buf_store_i32(out, (i + 3) * p + (base_j_blk2 + 1), i32(oren_buf_load_i64(tmp16, 13)))
                    oren_buf_store_i32(out, (i + 3) * p + (base_j_blk2 + 2), i32(oren_buf_load_i64(tmp16, 14)))
                    oren_buf_store_i32(out, (i + 3) * p + (base_j_blk2 + 3), i32(oren_buf_load_i64(tmp16, 15)))
                } else {
                    // Tail columns: fall back to the existing 1-row dot kernels below.
                    var row2 = 0
                    while row2 < 4 {
                        if base_j_blk2 + 0 < p {
                            oren_buf_store_i32(
                                out,
                                (i + row2) * p + (base_j_blk2 + 0),
                                i32(oren_buf_dot_i32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 0) * n, n)))
                        }
                        if base_j_blk2 + 1 < p {
                            oren_buf_store_i32(
                                out,
                                (i + row2) * p + (base_j_blk2 + 1),
                                i32(oren_buf_dot_i32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 1) * n, n)))
                        }
                        if base_j_blk2 + 2 < p {
                            oren_buf_store_i32(
                                out,
                                (i + row2) * p + (base_j_blk2 + 2),
                                i32(oren_buf_dot_i32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 2) * n, n)))
                        }
                        if base_j_blk2 + 3 < p {
                            oren_buf_store_i32(
                                out,
                                (i + row2) * p + (base_j_blk2 + 3),
                                i32(oren_buf_dot_i32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 3) * n, n)))
                        }
                        row2 = row2 + 1
                    }
                }
                bj_blk2 = bj_blk2 + 1
            }
            i = i + 4
            continue
        }

        // Kernel dispatch: use dot-slice per k-block to allow native NEON dot kernels,
        // while preserving deterministic k order (k blocks in increasing order; dot slice iterates k in order).
        var bj = 0
        while bj < tiles_j {
            var base_j = bj * JB
            var s0 = 0
            var s1 = 0
            var s2 = 0
            var s3 = 0

            if use_packed {
                var bk = 0
                while bk < tiles_k {
                    var kbase = bk * KB
                    var kn = n - kbase
                    if kn > KB { kn = KB }

                    var base_tile = (bj * tiles_k + bk) * JB * KB
                    var r = oren_buf_dot_i32_4_slice_into(
                        tmp4, 0,
                        a, i * n + kbase,
                        bp,
                        base_tile + 0 * KB,
                        base_tile + 1 * KB,
                        base_tile + 2 * KB,
                        base_tile + 3 * KB,
                        kn)
                    if oren_is_err(r) { return r }
                    var t0 = oren_buf_load_i64(tmp4, 0)
                    var t1 = oren_buf_load_i64(tmp4, 1)
                    var t2 = oren_buf_load_i64(tmp4, 2)
                    var t3 = oren_buf_load_i64(tmp4, 3)
                    if oren_is_err(t0) { return t0 }
                    if oren_is_err(t1) { return t1 }
                    if oren_is_err(t2) { return t2 }
                    if oren_is_err(t3) { return t3 }
                    s0 = s0 + t0
                    s1 = s1 + t1
                    s2 = s2 + t2
                    s3 = s3 + t3
                    bk = bk + 1
                }
            } else {
                // Non-packed Bt is fully contiguous per column, so do a single dot over full n.
                if base_j + 3 < p {
                    var r2 = oren_buf_dot_i32_4_slice_into(
                        tmp4, 0,
                        a, i * n,
                        bt,
                        (base_j + 0) * n,
                        (base_j + 1) * n,
                        (base_j + 2) * n,
                        (base_j + 3) * n,
                        n)
                    if oren_is_err(r2) { return r2 }
                    s0 = oren_buf_load_i64(tmp4, 0)
                    s1 = oren_buf_load_i64(tmp4, 1)
                    s2 = oren_buf_load_i64(tmp4, 2)
                    s3 = oren_buf_load_i64(tmp4, 3)
                    if oren_is_err(s0) { return s0 }
                    if oren_is_err(s1) { return s1 }
                    if oren_is_err(s2) { return s2 }
                    if oren_is_err(s3) { return s3 }
                } else {
                    if base_j + 0 < p { s0 = oren_buf_dot_i32_slice(a, i * n, bt, (base_j + 0) * n, n) }
                    if base_j + 1 < p { s1 = oren_buf_dot_i32_slice(a, i * n, bt, (base_j + 1) * n, n) }
                    if base_j + 2 < p { s2 = oren_buf_dot_i32_slice(a, i * n, bt, (base_j + 2) * n, n) }
                    if base_j + 3 < p { s3 = oren_buf_dot_i32_slice(a, i * n, bt, (base_j + 3) * n, n) }
                }
            }

            if base_j + 0 < p { oren_buf_store_i32(out, i * p + (base_j + 0), i32(s0)) }
            if base_j + 1 < p { oren_buf_store_i32(out, i * p + (base_j + 1), i32(s1)) }
            if base_j + 2 < p { oren_buf_store_i32(out, i * p + (base_j + 2), i32(s2)) }
            if base_j + 3 < p { oren_buf_store_i32(out, i * p + (base_j + 3), i32(s3)) }

            bj = bj + 1
        }
        i = i + 1
    }
    return out
}

fn matmul_i32_buf_wide(a: []i32, b: []i32, m, n, p) {
    // Wide variant: return i64 buffer so callers can keep full accumulation results.
    if m < 0 || n < 0 || p < 0 { return _err_invalid_arg("matmul_i32_buf_wide: negative dims") }
    var na = buffer.len(a)
    if oren_is_err(na) { return na }
    var nb = buffer.len(b)
    if oren_is_err(nb) { return nb }
    if na != m * n { return _err_invalid_arg("matmul_i32_buf_wide: A length mismatch") }
    if nb != n * p { return _err_invalid_arg("matmul_i32_buf_wide: B length mismatch") }

    var out: []i64 = buffer.i64_new(m * p)
    if oren_is_err(out) { return out }

    // Optional packed-B layout (tile-major) for cache locality.
    // Mirrors `matmul_i32_buf`, but keeps full i64 results at the store boundary.
    var JB = 4
    var KB = 64
    var tiles_j = (p + JB - 1) / JB
    var tiles_k = (n + KB - 1) / KB
    var use_packed = (n >= KB) && (p >= JB) && (n * p >= 4096)

    // If we are packing, pack directly from B without materializing Bt.
    // If we are not packing, build Bt (transpose) so each column is contiguous.
    var bt: []i32 = nil
    var bp: []i32 = nil
    if use_packed {
        bp = buffer.i32_new(tiles_j * tiles_k * JB * KB)
        if oren_is_err(bp) { return bp }
        var bj0 = 0
        while bj0 < tiles_j {
            var bk0 = 0
            while bk0 < tiles_k {
                var j_in0 = 0
                while j_in0 < JB {
                    var global_j0 = bj0 * JB + j_in0
                    var k_in0 = 0
                    while k_in0 < KB {
                        var global_k0 = bk0 * KB + k_in0
                        var v0 = 0
                        if global_j0 < p && global_k0 < n {
                            v0 = oren_buf_load_i32(b, global_k0 * p + global_j0)
                            if oren_is_err(v0) { return v0 }
                        }
                        var dst0 = (((bj0 * tiles_k + bk0) * JB + j_in0) * KB + k_in0)
                        oren_buf_store_i32(bp, dst0, v0)
                        k_in0 = k_in0 + 1
                    }
                    j_in0 = j_in0 + 1
                }
                bk0 = bk0 + 1
            }
            bj0 = bj0 + 1
        }
    } else {
        bt = buffer.i32_new(n * p)
        if oren_is_err(bt) { return bt }
        var k0 = 0
        while k0 < n {
            var j0 = 0
            while j0 < p {
                var v = oren_buf_load_i32(b, k0 * p + j0)
                if oren_is_err(v) { return v }
                oren_buf_store_i32(bt, j0 * n + k0, v)
                j0 = j0 + 1
            }
            k0 = k0 + 1
        }
    }

    // Reusable scratch for the 1x4 dot microkernel.
    var tmp4: []i64 = buffer.i64_new(4)
    if oren_is_err(tmp4) { return tmp4 }

    // Reusable scratch for the 4x4 GEMM microkernel (used by packed and non-packed paths).
    var tmp16: []i64 = nil
    if m >= 4 && p >= 4 {
        tmp16 = buffer.i64_new(16)
        if oren_is_err(tmp16) { return tmp16 }
    }

    var i = 0
    while i < m {
        // Packed 4x4 microkernel: reuse B across 4 rows.
        // Only applies when:
        // - we are using packed-B layout
        // - we have at least 4 rows remaining
        if use_packed && i + 3 < m {
            var bj_blk = 0
            while bj_blk < tiles_j {
                var base_j_blk = bj_blk * JB

                if base_j_blk + 3 < p {
                    // Full 4-column block: use the 4x4 microkernel per k-block.
                    var s00 = 0; var s01 = 0; var s02 = 0; var s03 = 0
                    var s10 = 0; var s11 = 0; var s12 = 0; var s13 = 0
                    var s20 = 0; var s21 = 0; var s22 = 0; var s23 = 0
                    var s30 = 0; var s31 = 0; var s32 = 0; var s33 = 0

                    var bk_blk = 0
                    while bk_blk < tiles_k {
                        var kbase_blk = bk_blk * KB
                        var kn_blk = n - kbase_blk
                        if kn_blk > KB { kn_blk = KB }
                        var base_tile_blk = (bj_blk * tiles_k + bk_blk) * JB * KB

                        var rr = oren_buf_gemm_i32_4x4_slice_into(
                            tmp16, 0,
                            a,
                            (i + 0) * n + kbase_blk,
                            (i + 1) * n + kbase_blk,
                            (i + 2) * n + kbase_blk,
                            (i + 3) * n + kbase_blk,
                            bp,
                            base_tile_blk + 0 * KB,
                            base_tile_blk + 1 * KB,
                            base_tile_blk + 2 * KB,
                            base_tile_blk + 3 * KB,
                            kn_blk)
                        if oren_is_err(rr) { return rr }

                        // Accumulate partials (k-blocks in increasing order).
                        s00 = s00 + oren_buf_load_i64(tmp16, 0)
                        s01 = s01 + oren_buf_load_i64(tmp16, 1)
                        s02 = s02 + oren_buf_load_i64(tmp16, 2)
                        s03 = s03 + oren_buf_load_i64(tmp16, 3)

                        s10 = s10 + oren_buf_load_i64(tmp16, 4)
                        s11 = s11 + oren_buf_load_i64(tmp16, 5)
                        s12 = s12 + oren_buf_load_i64(tmp16, 6)
                        s13 = s13 + oren_buf_load_i64(tmp16, 7)

                        s20 = s20 + oren_buf_load_i64(tmp16, 8)
                        s21 = s21 + oren_buf_load_i64(tmp16, 9)
                        s22 = s22 + oren_buf_load_i64(tmp16, 10)
                        s23 = s23 + oren_buf_load_i64(tmp16, 11)

                        s30 = s30 + oren_buf_load_i64(tmp16, 12)
                        s31 = s31 + oren_buf_load_i64(tmp16, 13)
                        s32 = s32 + oren_buf_load_i64(tmp16, 14)
                        s33 = s33 + oren_buf_load_i64(tmp16, 15)

                        bk_blk = bk_blk + 1
                    }

                    // Store 4x4 block directly to i64 output.
                    oren_buf_store_i64(out, (i + 0) * p + (base_j_blk + 0), s00)
                    oren_buf_store_i64(out, (i + 0) * p + (base_j_blk + 1), s01)
                    oren_buf_store_i64(out, (i + 0) * p + (base_j_blk + 2), s02)
                    oren_buf_store_i64(out, (i + 0) * p + (base_j_blk + 3), s03)

                    oren_buf_store_i64(out, (i + 1) * p + (base_j_blk + 0), s10)
                    oren_buf_store_i64(out, (i + 1) * p + (base_j_blk + 1), s11)
                    oren_buf_store_i64(out, (i + 1) * p + (base_j_blk + 2), s12)
                    oren_buf_store_i64(out, (i + 1) * p + (base_j_blk + 3), s13)

                    oren_buf_store_i64(out, (i + 2) * p + (base_j_blk + 0), s20)
                    oren_buf_store_i64(out, (i + 2) * p + (base_j_blk + 1), s21)
                    oren_buf_store_i64(out, (i + 2) * p + (base_j_blk + 2), s22)
                    oren_buf_store_i64(out, (i + 2) * p + (base_j_blk + 3), s23)

                    oren_buf_store_i64(out, (i + 3) * p + (base_j_blk + 0), s30)
                    oren_buf_store_i64(out, (i + 3) * p + (base_j_blk + 1), s31)
                    oren_buf_store_i64(out, (i + 3) * p + (base_j_blk + 2), s32)
                    oren_buf_store_i64(out, (i + 3) * p + (base_j_blk + 3), s33)
                } else {
                    // Tail columns: packed-B zero-pads out-of-range columns, so we can still use
                    // the 4x4 microkernel and only store the in-range columns.
                    var s00 = 0; var s01 = 0; var s02 = 0; var s03 = 0
                    var s10 = 0; var s11 = 0; var s12 = 0; var s13 = 0
                    var s20 = 0; var s21 = 0; var s22 = 0; var s23 = 0
                    var s30 = 0; var s31 = 0; var s32 = 0; var s33 = 0

                    var bk_blk = 0
                    while bk_blk < tiles_k {
                        var kbase_blk = bk_blk * KB
                        var kn_blk = n - kbase_blk
                        if kn_blk > KB { kn_blk = KB }
                        var base_tile_blk = (bj_blk * tiles_k + bk_blk) * JB * KB

                        var rr = oren_buf_gemm_i32_4x4_slice_into(
                            tmp16, 0,
                            a,
                            (i + 0) * n + kbase_blk,
                            (i + 1) * n + kbase_blk,
                            (i + 2) * n + kbase_blk,
                            (i + 3) * n + kbase_blk,
                            bp,
                            base_tile_blk + 0 * KB,
                            base_tile_blk + 1 * KB,
                            base_tile_blk + 2 * KB,
                            base_tile_blk + 3 * KB,
                            kn_blk)
                        if oren_is_err(rr) { return rr }

                        // Accumulate partials (k-blocks in increasing order).
                        s00 = s00 + oren_buf_load_i64(tmp16, 0)
                        s01 = s01 + oren_buf_load_i64(tmp16, 1)
                        s02 = s02 + oren_buf_load_i64(tmp16, 2)
                        s03 = s03 + oren_buf_load_i64(tmp16, 3)

                        s10 = s10 + oren_buf_load_i64(tmp16, 4)
                        s11 = s11 + oren_buf_load_i64(tmp16, 5)
                        s12 = s12 + oren_buf_load_i64(tmp16, 6)
                        s13 = s13 + oren_buf_load_i64(tmp16, 7)

                        s20 = s20 + oren_buf_load_i64(tmp16, 8)
                        s21 = s21 + oren_buf_load_i64(tmp16, 9)
                        s22 = s22 + oren_buf_load_i64(tmp16, 10)
                        s23 = s23 + oren_buf_load_i64(tmp16, 11)

                        s30 = s30 + oren_buf_load_i64(tmp16, 12)
                        s31 = s31 + oren_buf_load_i64(tmp16, 13)
                        s32 = s32 + oren_buf_load_i64(tmp16, 14)
                        s33 = s33 + oren_buf_load_i64(tmp16, 15)

                        bk_blk = bk_blk + 1
                    }

                    if base_j_blk + 0 < p {
                        oren_buf_store_i64(out, (i + 0) * p + (base_j_blk + 0), s00)
                        oren_buf_store_i64(out, (i + 1) * p + (base_j_blk + 0), s10)
                        oren_buf_store_i64(out, (i + 2) * p + (base_j_blk + 0), s20)
                        oren_buf_store_i64(out, (i + 3) * p + (base_j_blk + 0), s30)
                    }
                    if base_j_blk + 1 < p {
                        oren_buf_store_i64(out, (i + 0) * p + (base_j_blk + 1), s01)
                        oren_buf_store_i64(out, (i + 1) * p + (base_j_blk + 1), s11)
                        oren_buf_store_i64(out, (i + 2) * p + (base_j_blk + 1), s21)
                        oren_buf_store_i64(out, (i + 3) * p + (base_j_blk + 1), s31)
                    }
                    if base_j_blk + 2 < p {
                        oren_buf_store_i64(out, (i + 0) * p + (base_j_blk + 2), s02)
                        oren_buf_store_i64(out, (i + 1) * p + (base_j_blk + 2), s12)
                        oren_buf_store_i64(out, (i + 2) * p + (base_j_blk + 2), s22)
                        oren_buf_store_i64(out, (i + 3) * p + (base_j_blk + 2), s32)
                    }
                    if base_j_blk + 3 < p {
                        oren_buf_store_i64(out, (i + 0) * p + (base_j_blk + 3), s03)
                        oren_buf_store_i64(out, (i + 1) * p + (base_j_blk + 3), s13)
                        oren_buf_store_i64(out, (i + 2) * p + (base_j_blk + 3), s23)
                        oren_buf_store_i64(out, (i + 3) * p + (base_j_blk + 3), s33)
                    }
                }

                bj_blk = bj_blk + 1
            }

            i = i + 4
            continue
        }

        // Non-packed 4x4 microkernel: Bt columns are contiguous, so we can compute a full 4x4
        // block over the entire n in a single call and store directly to the i64 output.
        if use_packed == 0 && i + 3 < m && tmp16 != nil {
            var bj_blk2 = 0
            while bj_blk2 < tiles_j {
                var base_j_blk2 = bj_blk2 * JB
                if base_j_blk2 + 3 < p {
                    var rr2 = oren_buf_gemm_i32_4x4_slice_into(
                        tmp16, 0,
                        a,
                        (i + 0) * n,
                        (i + 1) * n,
                        (i + 2) * n,
                        (i + 3) * n,
                        bt,
                        (base_j_blk2 + 0) * n,
                        (base_j_blk2 + 1) * n,
                        (base_j_blk2 + 2) * n,
                        (base_j_blk2 + 3) * n,
                        n)
                    if oren_is_err(rr2) { return rr2 }

                    // Store 4x4 block (row-major) directly to i64 output.
                    oren_buf_store_i64(out, (i + 0) * p + (base_j_blk2 + 0), oren_buf_load_i64(tmp16, 0))
                    oren_buf_store_i64(out, (i + 0) * p + (base_j_blk2 + 1), oren_buf_load_i64(tmp16, 1))
                    oren_buf_store_i64(out, (i + 0) * p + (base_j_blk2 + 2), oren_buf_load_i64(tmp16, 2))
                    oren_buf_store_i64(out, (i + 0) * p + (base_j_blk2 + 3), oren_buf_load_i64(tmp16, 3))

                    oren_buf_store_i64(out, (i + 1) * p + (base_j_blk2 + 0), oren_buf_load_i64(tmp16, 4))
                    oren_buf_store_i64(out, (i + 1) * p + (base_j_blk2 + 1), oren_buf_load_i64(tmp16, 5))
                    oren_buf_store_i64(out, (i + 1) * p + (base_j_blk2 + 2), oren_buf_load_i64(tmp16, 6))
                    oren_buf_store_i64(out, (i + 1) * p + (base_j_blk2 + 3), oren_buf_load_i64(tmp16, 7))

                    oren_buf_store_i64(out, (i + 2) * p + (base_j_blk2 + 0), oren_buf_load_i64(tmp16, 8))
                    oren_buf_store_i64(out, (i + 2) * p + (base_j_blk2 + 1), oren_buf_load_i64(tmp16, 9))
                    oren_buf_store_i64(out, (i + 2) * p + (base_j_blk2 + 2), oren_buf_load_i64(tmp16, 10))
                    oren_buf_store_i64(out, (i + 2) * p + (base_j_blk2 + 3), oren_buf_load_i64(tmp16, 11))

                    oren_buf_store_i64(out, (i + 3) * p + (base_j_blk2 + 0), oren_buf_load_i64(tmp16, 12))
                    oren_buf_store_i64(out, (i + 3) * p + (base_j_blk2 + 1), oren_buf_load_i64(tmp16, 13))
                    oren_buf_store_i64(out, (i + 3) * p + (base_j_blk2 + 2), oren_buf_load_i64(tmp16, 14))
                    oren_buf_store_i64(out, (i + 3) * p + (base_j_blk2 + 3), oren_buf_load_i64(tmp16, 15))
                } else {
                    // Tail columns: fall back to the existing 1-row dot kernels below.
                    var row2 = 0
                    while row2 < 4 {
                        if base_j_blk2 + 0 < p {
                            oren_buf_store_i64(
                                out,
                                (i + row2) * p + (base_j_blk2 + 0),
                                oren_buf_dot_i32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 0) * n, n))
                        }
                        if base_j_blk2 + 1 < p {
                            oren_buf_store_i64(
                                out,
                                (i + row2) * p + (base_j_blk2 + 1),
                                oren_buf_dot_i32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 1) * n, n))
                        }
                        if base_j_blk2 + 2 < p {
                            oren_buf_store_i64(
                                out,
                                (i + row2) * p + (base_j_blk2 + 2),
                                oren_buf_dot_i32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 2) * n, n))
                        }
                        if base_j_blk2 + 3 < p {
                            oren_buf_store_i64(
                                out,
                                (i + row2) * p + (base_j_blk2 + 3),
                                oren_buf_dot_i32_slice(a, (i + row2) * n, bt, (base_j_blk2 + 3) * n, n))
                        }
                        row2 = row2 + 1
                    }
                }
                bj_blk2 = bj_blk2 + 1
            }
            i = i + 4
            continue
        }

        var bj = 0
        while bj < tiles_j {
            var base_j = bj * JB
            var s0 = 0
            var s1 = 0
            var s2 = 0
            var s3 = 0

            if use_packed {
                var bk = 0
                while bk < tiles_k {
                    var kbase = bk * KB
                    var kn = n - kbase
                    if kn > KB { kn = KB }

                    var base_tile = (bj * tiles_k + bk) * JB * KB
                    var r = oren_buf_dot_i32_4_slice_into(
                        tmp4, 0,
                        a, i * n + kbase,
                        bp,
                        base_tile + 0 * KB,
                        base_tile + 1 * KB,
                        base_tile + 2 * KB,
                        base_tile + 3 * KB,
                        kn)
                    if oren_is_err(r) { return r }
                    var t0 = oren_buf_load_i64(tmp4, 0)
                    var t1 = oren_buf_load_i64(tmp4, 1)
                    var t2 = oren_buf_load_i64(tmp4, 2)
                    var t3 = oren_buf_load_i64(tmp4, 3)
                    if oren_is_err(t0) { return t0 }
                    if oren_is_err(t1) { return t1 }
                    if oren_is_err(t2) { return t2 }
                    if oren_is_err(t3) { return t3 }
                    s0 = s0 + t0
                    s1 = s1 + t1
                    s2 = s2 + t2
                    s3 = s3 + t3
                    bk = bk + 1
                }
            } else {
                // Non-packed Bt is fully contiguous per column, so do a single dot over full n.
                if base_j + 3 < p {
                    var r2 = oren_buf_dot_i32_4_slice_into(
                        tmp4, 0,
                        a, i * n,
                        bt,
                        (base_j + 0) * n,
                        (base_j + 1) * n,
                        (base_j + 2) * n,
                        (base_j + 3) * n,
                        n)
                    if oren_is_err(r2) { return r2 }
                    s0 = oren_buf_load_i64(tmp4, 0)
                    s1 = oren_buf_load_i64(tmp4, 1)
                    s2 = oren_buf_load_i64(tmp4, 2)
                    s3 = oren_buf_load_i64(tmp4, 3)
                    if oren_is_err(s0) { return s0 }
                    if oren_is_err(s1) { return s1 }
                    if oren_is_err(s2) { return s2 }
                    if oren_is_err(s3) { return s3 }
                } else {
                    if base_j + 0 < p { s0 = oren_buf_dot_i32_slice(a, i * n, bt, (base_j + 0) * n, n) }
                    if base_j + 1 < p { s1 = oren_buf_dot_i32_slice(a, i * n, bt, (base_j + 1) * n, n) }
                    if base_j + 2 < p { s2 = oren_buf_dot_i32_slice(a, i * n, bt, (base_j + 2) * n, n) }
                    if base_j + 3 < p { s3 = oren_buf_dot_i32_slice(a, i * n, bt, (base_j + 3) * n, n) }
                }
            }

            if base_j + 0 < p { oren_buf_store_i64(out, i * p + (base_j + 0), s0) }
            if base_j + 1 < p { oren_buf_store_i64(out, i * p + (base_j + 1), s1) }
            if base_j + 2 < p { oren_buf_store_i64(out, i * p + (base_j + 2), s2) }
            if base_j + 3 < p { oren_buf_store_i64(out, i * p + (base_j + 3), s3) }

            bj = bj + 1
        }
        i = i + 1
    }
    return out
}
