import list "std:list"

// Basic wrappers around string intrinsics to avoid direct `oren_*` usage in user code.
fn len(s) { return oren_string_len(s) }

fn char_at(s, i) { return oren_string_char_at(s, i) }

fn slice(s, start, end) { return oren_string_slice(s, start, end) }

fn to_bytes(s) { return oren_bytes_from_string(s) }

fn from_bytes(bs) { return oren_string_from_bytes(bs) }

fn _is_int(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 1 { return true }
    if tag == 0 || tag == 3 || tag == 4 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn _is_string(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 4 { return true }
    if tag == 0 || tag == 1 || tag == 3 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var n = oren_string_len(v)
    if n == nil { return false }
    return oren_is_err(n) == false
}

fn _len_or_err(s, ctx) {
    if _is_string(s) == false { return oren_err(4, ctx + ": s must be string") }
    var n = oren_string_len(s)
    if n == nil || oren_is_err(n) { return oren_err(4, ctx + ": s must be string") }
    return n
}

// --- structured error helpers (value-or-err) ---

fn try_len(s) {
    return _len_or_err(s, "strings.try_len")
}

fn try_char_at(s, i) {
    var n = _len_or_err(s, "strings.try_char_at")
    if oren_is_err(n) { return n }
    if _is_int(i) == false { return oren_err(4, "strings.try_char_at: index not int") }
    if i < 0 || i >= n { return oren_err(4, "strings.try_char_at: index out of bounds") }
    return oren_string_char_at(s, i)
}

fn try_slice(s, start, end) {
    var n = _len_or_err(s, "strings.try_slice")
    if oren_is_err(n) { return n }
    if _is_int(start) == false || _is_int(end) == false { return oren_err(4, "strings.try_slice: start/end not int") }
    if start < 0 || end < 0 { return oren_err(4, "strings.try_slice: negative range") }
    if start > end { return oren_err(4, "strings.try_slice: start > end") }
    if end > n { return oren_err(4, "strings.try_slice: out of bounds") }
    return oren_string_slice(s, start, end)
}

fn starts_with(s, prefix) {
    if s == nil || prefix == nil { return false }
    var sb = oren_bytes_from_string(s)
    var pb = oren_bytes_from_string(prefix)
    var sl = list.len(sb)
    var pl = list.len(pb)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if sb[i] != pb[i] { return false }
        i = i + 1
    }
    return true
}

fn ends_with(s, suffix) {
    if s == nil || suffix == nil { return false }
    var sb = oren_bytes_from_string(s)
    var pb = oren_bytes_from_string(suffix)
    var sl = list.len(sb)
    var pl = list.len(pb)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if sb[(sl - pl) + i] != pb[i] { return false }
        i = i + 1
    }
    return true
}

fn contains(s, sub) {
    if s == nil || sub == nil { return false }
    return index_of(s, sub) != -1
}

fn index_of(s, sub) {
    if s == nil || sub == nil { return -1 }
    var sb = oren_bytes_from_string(s)
    var pb = oren_bytes_from_string(sub)
    var sl = list.len(sb)
    var pl = list.len(pb)
    if pl == 0 { return 0 }
    if sl < pl { return -1 }
    var i = 0
    while i + pl <= sl {
        var j = 0
        var ok = 1
        while j < pl {
            if sb[i + j] != pb[j] { ok = 0; break }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn streq(a, b) {
    if a == nil || b == nil { return false }
    var ab = oren_bytes_from_string(a)
    var bb = oren_bytes_from_string(b)
    var al = list.len(ab)
    var bl = list.len(bb)
    if al != bl { return false }
    var i = 0
    while i < al {
        if ab[i] != bb[i] { return false }
        i = i + 1
    }
    return true
}

fn trim(s) {
    if s == nil { return nil }
    // Cross-backend: avoid relying on `oren_string_char_at` representation differences.
    // Normalize by trimming based on byte codes from `oren_bytes_from_string`.
    var bs = oren_bytes_from_string(s)
    var n = list.len(bs)
    var i = 0
    while i < n {
        var b = bs[i]
        if !(b == 32 || b == 9 || b == 10 || b == 13) { break }
        i = i + 1
    }
    var j = n
    while j > i {
        var b2 = bs[j - 1]
        if !(b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13) { break }
        j = j - 1
    }
    if i == 0 && j == n { return s }
    var out_bytes = []
    var k = i
    while k < j {
        list.push(out_bytes, bs[k])
        k = k + 1
    }
    return oren_string_from_bytes(out_bytes)
}
