fn starts_with(s, prefix) {
    if s == nil || prefix == nil { return false }
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return false }
    return oren_string_slice(s, 0, pl) == prefix
}

fn ends_with(s, suffix) {
    if s == nil || suffix == nil { return false }
    var sl = oren_string_len(s)
    var pl = oren_string_len(suffix)
    if sl < pl { return false }
    return oren_string_slice(s, sl - pl, sl) == suffix
}

fn contains(s, sub) {
    if s == nil || sub == nil { return false }
    var sl = oren_string_len(s)
    var pl = oren_string_len(sub)
    if pl == 0 { return true }
    if sl < pl { return false }
    var i = 0
    while i + pl <= sl {
        if oren_string_slice(s, i, i + pl) == sub { return true }
        i = i + 1
    }
    return false
}

fn index_of(s, sub) {
    if s == nil || sub == nil { return -1 }
    var sl = oren_string_len(s)
    var pl = oren_string_len(sub)
    if pl == 0 { return 0 }
    if sl < pl { return -1 }
    var i = 0
    while i + pl <= sl {
        if oren_string_slice(s, i, i + pl) == sub { return i }
        i = i + 1
    }
    return -1
}

fn trim(s) {
    if s == nil { return nil }
    // Cross-backend: avoid relying on `oren_string_char_at` representation differences.
    // Normalize by trimming based on byte codes from `oren_bytes_from_string`.
    var bs = oren_bytes_from_string(s)
    var n = oren_list_len(bs)
    var i = 0
    while i < n {
        var b = bs[i]
        if !(b == 32 || b == 9 || b == 10 || b == 13) { break }
        i = i + 1
    }
    var j = n
    while j > i {
        var b2 = bs[j - 1]
        if !(b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13) { break }
        j = j - 1
    }
    if i == 0 && j == n { return s }
    var out_bytes = []
    var k = i
    while k < j {
        oren_list_push(out_bytes, bs[k])
        k = k + 1
    }
    return oren_string_from_bytes(out_bytes)
}
