// Basic wrappers around string intrinsics to avoid direct `oren_*` usage in user code.
// Public verbs are checked and return `value | oren_err`; raw intrinsic access stays private.
fn _len_raw(s) { return oren_string_len(s) }

fn _char_at_raw(s, i) { return oren_string_char_at(s, i) }

fn _slice_raw(s, start, end) { return oren_string_slice(s, start, end) }

fn _byte_at_raw(s, i) { return oren_string_byte_at_unchecked(s, i) & 255 }

fn to_bytes(s) {
    if _is_string(s) == false { return oren_err(4, "strings.to_bytes: s must be string") }
    var n = _len_raw(s)
    var out = oren_u8_buf_new_uninit(n)
    var data = oren_buf_data_ptr_unchecked(out)
    var i = 0
    while i < n {
        ptr_set_byte(data + i, _byte_at_raw(s, i))
        i = i + 1
    }
    return out
}

fn from_bytes(bs) {
    var n = oren_bytes_len(bs)
    if n == nil || oren_is_err(n) { return oren_err(4, "strings.from_bytes: bs must be bytes") }
    return oren_string_from_bytes_slice(bs, 0, n)
}

fn _is_int(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 1 { return true }
    if tag == 0 || tag == 3 || tag == 4 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn _is_string(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 4 { return true }
    if tag == 0 || tag == 1 || tag == 3 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var n = oren_string_len(v)
    if n == nil { return false }
    return oren_is_err(n) == false
}

fn _len_or_err(s, ctx) {
    if _is_string(s) == false { return oren_err(4, ctx + ": s must be string") }
    var n = oren_string_len(s)
    if n == nil || oren_is_err(n) { return oren_err(4, ctx + ": s must be string") }
    return n
}

fn len(s) {
    return _len_or_err(s, "strings.len")
}

fn char_at(s, i) {
    var n = _len_or_err(s, "strings.char_at")
    if oren_is_err(n) { return n }
    if _is_int(i) == false { return oren_err(4, "strings.char_at: index not int") }
    if i < 0 || i >= n { return oren_err(4, "strings.char_at: index out of bounds") }
    return _char_at_raw(s, i)
}

fn slice(s, start, end) {
    var n = _len_or_err(s, "strings.slice")
    if oren_is_err(n) { return n }
    if _is_int(start) == false || _is_int(end) == false { return oren_err(4, "strings.slice: start/end not int") }
    if start < 0 || end < 0 { return oren_err(4, "strings.slice: negative range") }
    if start > end { return oren_err(4, "strings.slice: start > end") }
    if end > n { return oren_err(4, "strings.slice: out of bounds") }
    return _slice_raw(s, start, end)
}

fn _two_strings_or_err(a, b, ctx) {
    if _is_string(a) == false { return oren_err(4, ctx + ": first argument must be string") }
    if _is_string(b) == false { return oren_err(4, ctx + ": second argument must be string") }
    return nil
}

fn starts_with(s, prefix) {
    var ok = _two_strings_or_err(s, prefix, "strings.starts_with")
    if oren_is_err(ok) { return ok }
    return _starts_with_raw(s, prefix)
}

fn ends_with(s, suffix) {
    var ok = _two_strings_or_err(s, suffix, "strings.ends_with")
    if oren_is_err(ok) { return ok }
    return _ends_with_raw(s, suffix)
}

fn contains(s, sub) {
    var ok = _two_strings_or_err(s, sub, "strings.contains")
    if oren_is_err(ok) { return ok }
    return _contains_raw(s, sub)
}

fn index_of(s, sub) {
    var ok = _two_strings_or_err(s, sub, "strings.index_of")
    if oren_is_err(ok) { return ok }
    return _index_of_raw(s, sub)
}

fn streq(a, b) {
    var ok = _two_strings_or_err(a, b, "strings.streq")
    if oren_is_err(ok) { return ok }
    return _streq_raw(a, b)
}

fn trim(s) {
    var n = _len_or_err(s, "strings.trim")
    if oren_is_err(n) { return n }
    return _trim_raw(s)
}

fn _starts_with_raw(s, prefix) {
    if s == nil || prefix == nil { return false }
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if _byte_at_raw(s, i) != _byte_at_raw(prefix, i) { return false }
        i = i + 1
    }
    return true
}

fn _ends_with_raw(s, suffix) {
    if s == nil || suffix == nil { return false }
    var sl = oren_string_len(s)
    var pl = oren_string_len(suffix)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if _byte_at_raw(s, (sl - pl) + i) != _byte_at_raw(suffix, i) { return false }
        i = i + 1
    }
    return true
}

fn _contains_raw(s, sub) {
    if s == nil || sub == nil { return false }
    return _index_of_raw(s, sub) != -1
}

fn _index_of_raw(s, sub) {
    if s == nil || sub == nil { return -1 }
    var sl = oren_string_len(s)
    var pl = oren_string_len(sub)
    if pl == 0 { return 0 }
    if sl < pl { return -1 }
    var i = 0
    while i + pl <= sl {
        var j = 0
        var ok = 1
        while j < pl {
            if _byte_at_raw(s, i + j) != _byte_at_raw(sub, j) { ok = 0; break }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn _streq_raw(a, b) {
    if a == nil || b == nil { return false }
    var al = oren_string_len(a)
    var bl = oren_string_len(b)
    if al != bl { return false }
    var i = 0
    while i < al {
        if _byte_at_raw(a, i) != _byte_at_raw(b, i) { return false }
        i = i + 1
    }
    return true
}

fn _trim_raw(s) {
    if s == nil { return nil }
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        var b = _byte_at_raw(s, i)
        if !(b == 32 || b == 9 || b == 10 || b == 13) { break }
        i = i + 1
    }
    var j = n
    while j > i {
        var b2 = _byte_at_raw(s, j - 1)
        if !(b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13) { break }
        j = j - 1
    }
    if i == 0 && j == n { return s }
    return _slice_raw(s, i, j)
}
