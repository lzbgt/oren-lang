fn starts_with(s, prefix) {
    if s == nil || prefix == nil { return false }
    var sb = oren_bytes_from_string(s)
    var pb = oren_bytes_from_string(prefix)
    var sl = oren_list_len(sb)
    var pl = oren_list_len(pb)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if sb[i] != pb[i] { return false }
        i = i + 1
    }
    return true
}

fn ends_with(s, suffix) {
    if s == nil || suffix == nil { return false }
    var sb = oren_bytes_from_string(s)
    var pb = oren_bytes_from_string(suffix)
    var sl = oren_list_len(sb)
    var pl = oren_list_len(pb)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if sb[(sl - pl) + i] != pb[i] { return false }
        i = i + 1
    }
    return true
}

fn contains(s, sub) {
    if s == nil || sub == nil { return false }
    return index_of(s, sub) != -1
}

fn index_of(s, sub) {
    if s == nil || sub == nil { return -1 }
    var sb = oren_bytes_from_string(s)
    var pb = oren_bytes_from_string(sub)
    var sl = oren_list_len(sb)
    var pl = oren_list_len(pb)
    if pl == 0 { return 0 }
    if sl < pl { return -1 }
    var i = 0
    while i + pl <= sl {
        var j = 0
        var ok = 1
        while j < pl {
            if sb[i + j] != pb[j] { ok = 0; break }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn streq(a, b) {
    if a == nil || b == nil { return false }
    var ab = oren_bytes_from_string(a)
    var bb = oren_bytes_from_string(b)
    var al = oren_list_len(ab)
    var bl = oren_list_len(bb)
    if al != bl { return false }
    var i = 0
    while i < al {
        if ab[i] != bb[i] { return false }
        i = i + 1
    }
    return true
}

fn trim(s) {
    if s == nil { return nil }
    // Cross-backend: avoid relying on `oren_string_char_at` representation differences.
    // Normalize by trimming based on byte codes from `oren_bytes_from_string`.
    var bs = oren_bytes_from_string(s)
    var n = oren_list_len(bs)
    var i = 0
    while i < n {
        var b = bs[i]
        if !(b == 32 || b == 9 || b == 10 || b == 13) { break }
        i = i + 1
    }
    var j = n
    while j > i {
        var b2 = bs[j - 1]
        if !(b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13) { break }
        j = j - 1
    }
    if i == 0 && j == n { return s }
    var out_bytes = []
    var k = i
    while k < j {
        oren_list_push(out_bytes, bs[k])
        k = k + 1
    }
    return oren_string_from_bytes(out_bytes)
}
