// Stdlib bundle root (rolling)
//
// This file exists to build a precompiled stdlib `.obc` bundle for AVM/bytecode
// workflows where shipping stdlib sources is undesirable.
//
// It contains only imports; linking removes Import statements, but loading this
// module pulls all referenced std modules into the linked program.

import argparse "std:argparse"
import buffer "std:buffer"
import bytes "std:bytes"
import casts "std:casts"
import cbor "std:cbor"
import ints "std:ints"
import iter "std:iter"
import json "std:json"
import linalg "std:linalg"
import list "std:list"
import math "std:math"
import regex "std:regex"
import result "std:result"
import strings "std:strings"
import time "std:time"
import yaml "std:yaml"
import assert "std:assert"
import sha256 "std:crypto/sha256"
import sha1 "std:crypto/sha1"
import pem "std:crypto/pem"
import x509 "std:crypto/x509"
import base64 "std:encoding/base64"
