// std/math (rolling)
//
// Scope: deterministic, portable math building blocks.
//
// Design goals:
// - No host `libm` dependency (works the same across C/native/AVM backends).
// - Deterministic semantics (fixed iteration counts; no CPU-specific rounding modes).
// - Provide HPC-relevant primitives incrementally (sqrt, powi, etc.) so higher-level
//   linalg/scientific libraries can build on them.

fn abs_i(x) {
    if x < 0 { return -x }
    return x
}

fn min_i(a, b) {
    if a < b { return a }
    return b
}

fn max_i(a, b) {
    if a > b { return a }
    return b
}

fn clamp_i(x, lo, hi) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fn abs_f(x) {
    if x < 0.0 { return -x }
    return x
}

fn min_f(a, b) {
    if a < b { return a }
    return b
}

fn max_f(a, b) {
    if a > b { return a }
    return b
}

fn clamp_f(x, lo, hi) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fn is_nan(x) {
    // IEEE-ish: NaN != NaN
    return x != x
}

fn _f64_bits(x) {
    return oren_f64_to_u64_bits(x)
}

fn _f64_from_bits(u) {
    return oren_u64_bits_to_f64(u)
}

fn is_inf(x) {
    if is_nan(x) { return false }
    var b = _f64_bits(x)
    if oren_is_err(b) { return false }
    // exp==0x7ff and mantissa==0
    return ((b >> 52) & 2047) == 2047 && (b & 4503599627370495) == 0
}

fn is_finite(x) {
    if is_nan(x) { return false }
    var b = _f64_bits(x)
    if oren_is_err(b) { return false }
    return ((b >> 52) & 2047) != 2047
}

fn signbit(x) {
    var b = _f64_bits(x)
    if oren_is_err(b) { return false }
    return (b >> 63) != 0
}

fn copysign(x, y) {
    var xb = _f64_bits(x)
    if oren_is_err(xb) { return xb }
    var yb = _f64_bits(y)
    if oren_is_err(yb) { return yb }
    var sign = yb & 9223372036854775808
    var mag = xb & 9223372036854775807
    return _f64_from_bits(mag | sign)
}

fn inf() {
    return _f64_from_bits(9218868437227405312) // +inf: 0x7ff0000000000000
}

fn neg_inf() {
    return _f64_from_bits(18442240474082181120) // -inf: 0xfff0000000000000
}

// --- rounding helpers (float, deterministic, no host libm) ---
//
// Semantics (rolling, v0):
// - `floor(x)` / `ceil(x)` / `round(x)` operate on float values and return a float.
// - Errors:
//   - NaN returns `Err(code=4, msg=...)` (OREN_ERR_INVALID_ARG)
// - Large magnitude:
//   - For |x| >= 2^63, we return x unchanged (it cannot be meaningfully truncated to i64).
//     This is deterministic and avoids spurious errors for large-but-integral floats.
//
// Rounding rule:
// - `round(x)` is **half away from zero**.
//   (Bankers rounding can be added later as a separate API if needed.)

fn trunc_i64_from_f(x) {
    // Returns int or Err.
    return oren_trunc_int(x)
}

fn floor(x) {
    if is_nan(x) { return oren_err(4, "floor: NaN") }
    // Preserve -0.0 by returning the input.
    if x == 0.0 { return x }
    var lim = 9223372036854775808.0 // 2^63
    if x >= lim || x <= 0.0 - lim { return x }

    var ti = trunc_i64_from_f(x)
    if oren_is_err(ti) { return ti }
    var t = f64(ti)
    if t == x { return x }
    if x > 0.0 { return t }
    return t - 1.0
}

fn ceil(x) {
    if is_nan(x) { return oren_err(4, "ceil: NaN") }
    if x == 0.0 { return x }
    var lim = 9223372036854775808.0 // 2^63
    if x >= lim || x <= 0.0 - lim { return x }

    var ti = trunc_i64_from_f(x)
    if oren_is_err(ti) { return ti }
    var t = f64(ti)
    if t == x { return x }
    if x < 0.0 { return t }
    return t + 1.0
}

fn round(x) {
    if is_nan(x) { return oren_err(4, "round: NaN") }
    if x == 0.0 { return x }
    var lim = 9223372036854775808.0 // 2^63
    if x >= lim || x <= 0.0 - lim { return x }

    var ti = trunc_i64_from_f(x)
    if oren_is_err(ti) { return ti }
    var t = f64(ti)
    if t == x { return x }

    var frac = x - t
    // abs(frac)
    var af = frac
    if af < 0.0 { af = 0.0 - af }

    if af > 0.5 {
        if x > 0.0 { return t + 1.0 }
        return t - 1.0
    }
    if af < 0.5 { return t }
    // exactly half: away from zero
    if x > 0.0 { return t + 1.0 }
    return t - 1.0
}

// --- sqrt / pow (HPC foundation) ---
//
// sqrt(x) semantics:
// - If x < 0: Err(OREN_ERR_INVALID_ARG)
// - If x is NaN: Err
// - If x is +inf: +inf
// - If x is +/-0.0: returns x (preserve sign of zero deterministically)
//
// Implementation:
// - Uses exponent-only initial guess derived from IEEE-754 bits, plus an optional
//   sqrt(2) correction for odd exponents.
// - Uses a fixed number of Newton iterations for determinism.
//
// This is not a replacement for a tuned libm yet, but it is a correct, portable
// building block for stdlib linalg/scientific code.

fn sqrt(x) {
    if is_nan(x) { return oren_err(4, "sqrt: NaN") }
    if x < 0.0 { return oren_err(4, "sqrt: negative") }
    if x == 0.0 { return x }
    if is_inf(x) { return x }

    var b0 = _f64_bits(x)
    if oren_is_err(b0) { return b0 }
    var exp0 = (b0 >> 52) & 2047

    // Normalize subnormals by scaling. This keeps the exponent path well-defined.
    var xn = x
    var exp = exp0
    var adjust = 0
    if exp == 0 {
        // x != 0.0 here, so it is subnormal.
        // Multiply by 2^54 (exact in f64) and later subtract 54 from the exponent.
        xn = x * 18014398509481984.0
        var b1 = _f64_bits(xn)
        if oren_is_err(b1) { return b1 }
        exp = (b1 >> 52) & 2047
        adjust = 54
    }

    // Unbias exponent.
    var e = exp - 1023 - adjust
    var ge = e / 2
    // Initial guess: 2^ge (mantissa=0).
    var gb = (u64(ge + 1023) << 52)
    var g = _f64_from_bits(gb)
    if oren_is_err(g) { return g }

    // If exponent is odd, multiply guess by sqrt(2) to improve convergence.
    if (e & 1) != 0 {
        g = g * 1.4142135623730951
    }

    // Fixed-iteration Newton-Raphson: g_{n+1} = 0.5 * (g + xn/g)
    // 8 iterations is ample for f64 from this guess and remains deterministic.
    var i = 0
    while i < 8 {
        g = 0.5 * (g + xn / g)
        i = i + 1
    }
    return g
}

fn powi(x, n) {
    // Integer exponent power (deterministic, no libm).
    // For negative n, we return 1/(x^(-n)).
    if n == 0 { return 1.0 }
    var nn = n
    var inv = false
    if nn < 0 {
        inv = true
        nn = 0 - nn
    }
    var base = x
    var acc = 1.0
    while nn > 0 {
        if (nn & 1) != 0 { acc = acc * base }
        base = base * base
        nn = nn >> 1
    }
    if inv { return 1.0 / acc }
    return acc
}

// --- exponent helpers (frexp/ldexp equivalents) ---

fn pow2i(e) {
    // Return 2^e as an f64 (deterministic via bit construction).
    // - for e > 1023: +inf
    // - for e < -1074: 0.0
    if e > 1023 { return inf() }
    if e < -1074 { return 0.0 }
    if e >= -1022 {
        // normal
        return _f64_from_bits(u64(e + 1023) << 52)
    }
    // subnormal: mantissa = 2^(e+1074)
    return _f64_from_bits(u64(1) << u64(e + 1074))
}

fn ldexp(x, e) {
    // x * 2^e
    if is_nan(x) { return oren_err(4, "ldexp: NaN") }
    if x == 0.0 { return x }
    if is_inf(x) { return x }
    return x * pow2i(e)
}

fn frexp(x) {
    // Returns [mantissa, exp] where x = mantissa * 2^exp and mantissa in [0.5, 1).
    // For x==0: returns [0.0, 0].
    if is_nan(x) { return oren_err(4, "frexp: NaN") }
    if x == 0.0 { return [x, 0] }
    if is_inf(x) { return [x, 0] }

    var b0 = _f64_bits(x)
    if oren_is_err(b0) { return b0 }
    var sign = b0 & 9223372036854775808
    var exp0 = (b0 >> 52) & 2047
    var mant = b0 & 4503599627370495

    var xn = x
    var exp = exp0
    var adjust = 0
    if exp == 0 {
        // subnormal: scale by 2^54 (exact), then compensate exponent by -54
        xn = x * 18014398509481984.0
        var b1 = _f64_bits(xn)
        if oren_is_err(b1) { return b1 }
        exp = (b1 >> 52) & 2047
        mant = b1 & 4503599627370495
        adjust = 54
    }

    // x = (1.mant)*2^(exp-1023-adjust)
    // We want m in [0.5,1): m = (1.mant)*2^-1, exp_out = (exp-1023-adjust)+1 = exp-1022-adjust
    var exp_out = exp - 1022 - adjust
    var mb = sign | (u64(1022) << 52) | mant
    var m = _f64_from_bits(mb)
    if oren_is_err(m) { return m }
    return [m, exp_out]
}

// --- exp/log (deterministic, no host libm) ---

fn _exp_taylor(z) {
    // exp(z) for z in [0, ln2] via fixed-term Taylor series.
    // 12 terms is enough for good accuracy on this small interval.
    var term = 1.0
    var sum = 1.0
    var i = 1
    while i <= 12 {
        term = term * z / f64(i)
        sum = sum + term
        i = i + 1
    }
    return sum
}

fn exp2(x) {
    // 2^x via integer+fraction decomposition.
    if is_nan(x) { return oren_err(4, "exp2: NaN") }
    if x == 0.0 { return 1.0 }
    if is_inf(x) {
        if signbit(x) { return 0.0 }
        return x
    }
    if x > 1024.0 { return inf() }
    if x < -1075.0 { return 0.0 }

    var fx = floor(x)
    if oren_is_err(fx) { return fx }
    var ni = trunc_i64_from_f(fx)
    if oren_is_err(ni) { return ni }
    var f = x - f64(ni) // in [0,1)

    var LN2 = 0.6931471805599453
    var frac = _exp_taylor(f * LN2)
    var scale = pow2i(ni)
    return scale * frac
}

fn exp(x) {
    if is_nan(x) { return oren_err(4, "exp: NaN") }
    if x == 0.0 { return 1.0 }
    // exp(x) = 2^(x / ln2)
    var INV_LN2 = 1.4426950408889634
    return exp2(x * INV_LN2)
}

fn log2(x) {
    // Returns log2(x) for x > 0.
    if is_nan(x) { return oren_err(4, "log2: NaN") }
    if x == 0.0 { return neg_inf() }
    if x < 0.0 { return oren_err(4, "log2: negative") }
    if is_inf(x) { return x }

    var fe = frexp(x)
    if oren_is_err(fe) { return fe }
    var m = fe[0]
    var e = fe[1]

    // ln(m) using atanh series: ln(m) = 2 * (t + t^3/3 + t^5/5 + ...)
    // where t = (m-1)/(m+1), |t| <= 1/3 for m in [0.5,1)
    var t = (m - 1.0) / (m + 1.0)
    var t2 = t * t
    var term = t
    var s = t
    // Use enough odd terms to be accurate even at the worst-case `m=0.5` (t=-1/3).
    // This is still deterministic (fixed iteration count).
    var k = 3
    while k <= 41 {
        term = term * t2
        s = s + term / f64(k)
        k = k + 2
    }
    var ln_m = 2.0 * s
    var INV_LN2 = 1.4426950408889634
    return f64(e) + ln_m * INV_LN2
}

fn ln(x) {
    var v = log2(x)
    if oren_is_err(v) { return v }
    var LN2 = 0.6931471805599453
    return v * LN2
}

// --- trig (deterministic, no host libm) ---
//
// v0 design:
// - Provide `sin(x)` / `cos(x)` for moderate |x| (range-reduced).
// - Deterministic: fixed reduction strategy + fixed polynomial degrees.
// - For very large |x|, range reduction without a big-precision Payne–Hanek
//   implementation becomes inaccurate; we currently return Err to avoid silently
//   returning garbage.
//
// Range reduction:
// - k = round(x / (pi/2))  (half away from zero; deterministic via math.round)
// - r = x - k*(pi/2)       where r is in approximately [-pi/4, +pi/4]
// - quadrant = k & 3
//
// Polynomial:
// - Use truncated Taylor (sufficient on |r| <= pi/4):
//   sin(r) ~ r - r^3/6 + r^5/120 - r^7/5040 + r^9/362880 - r^11/39916800
//   cos(r) ~ 1 - r^2/2 + r^4/24 - r^6/720 + r^8/40320 - r^10/3628800

fn pi() { return 3.141592653589793 }
fn tau() { return 6.283185307179586 }

fn _sin_poly(r) {
    var r2 = r * r
    // Horner, odd polynomial:
    // r * (1 + r2*(c3 + r2*(c5 + ...)))
    var c11 = -1.0 / 39916800.0
    var c9 = 1.0 / 362880.0
    var c7 = -1.0 / 5040.0
    var c5 = 1.0 / 120.0
    var c3 = -1.0 / 6.0
    var p = (((c11 * r2 + c9) * r2 + c7) * r2 + c5) * r2 + c3
    return r + r * r2 * p
}

fn _cos_poly(r) {
    var r2 = r * r
    var c10 = -1.0 / 3628800.0
    var c8 = 1.0 / 40320.0
    var c6 = -1.0 / 720.0
    var c4 = 1.0 / 24.0
    var c2 = -1.0 / 2.0
    // 1 + r2*(c2 + r2*(c4 + ...))
    var p = (((c10 * r2 + c8) * r2 + c6) * r2 + c4) * r2 + c2
    return 1.0 + r2 * p
}

fn _reduce_pio2(x) {
    // Returns [r, q] or Err where q in [0..3].
    if is_nan(x) { return oren_err(4, "_reduce_pio2: NaN") }
    if is_inf(x) { return oren_err(4, "_reduce_pio2: inf") }
    // Conservative bound: avoids inaccurate reduction for huge magnitude.
    if abs_f(x) > 1000000.0 { return oren_err(4, "_reduce_pio2: |x| too large") }

    var PIO2 = 1.5707963267948966
    var kf = round(x / PIO2)
    if oren_is_err(kf) { return kf }
    var ki = trunc_i64_from_f(kf)
    if oren_is_err(ki) { return ki }
    var r = x - f64(ki) * PIO2
    var q = ki & 3
    return [r, q]
}

fn sin(x) {
    if x == 0.0 { return x } // preserve signed zero
    var rq = _reduce_pio2(x)
    if oren_is_err(rq) { return rq }
    var r = rq[0]
    var q = rq[1]
    var sr = _sin_poly(r)
    var cr = _cos_poly(r)
    if q == 0 { return sr }
    if q == 1 { return cr }
    if q == 2 { return 0.0 - sr }
    return 0.0 - cr
}

fn cos(x) {
    if is_nan(x) { return oren_err(4, "cos: NaN") }
    if is_inf(x) { return oren_err(4, "cos: inf") }
    if x == 0.0 { return 1.0 }
    var rq = _reduce_pio2(x)
    if oren_is_err(rq) { return rq }
    var r = rq[0]
    var q = rq[1]
    var sr = _sin_poly(r)
    var cr = _cos_poly(r)
    if q == 0 { return cr }
    if q == 1 { return 0.0 - sr }
    if q == 2 { return 0.0 - cr }
    return sr
}

// --- atan / atan2 (deterministic, no host libm) ---
//
// Implemented based on the classical fdlibm/openlibm range-reduction scheme
// (see `docs/refs/openlibm/s_atan.c` and `docs/refs/openlibm/e_atan2.c`).
//
// Semantics:
// - NaN inputs return Err(OREN_ERR_INVALID_ARG)
// - atan2 matches the usual mathematical definition with sign handling for zeros.
//

fn atan(x) {
    if is_nan(x) { return oren_err(4, "atan: NaN") }
    if x == 0.0 { return x } // preserve signed zero
    if is_inf(x) {
        if signbit(x) { return 0.0 - (pi() / 2.0) }
        return pi() / 2.0
    }

    var hx = x
    var ax = abs_f(x)

    // Constants from openlibm (split hi/lo for accuracy near reduction points).
    var atanhi0 = 4.63647609000806093515e-01
    var atanhi1 = 7.85398163397448278999e-01
    var atanhi2 = 9.82793723247329054082e-01
    var atanhi3 = 1.57079632679489655800e+00
    var atanlo0 = 2.26987774529616870924e-17
    var atanlo1 = 3.06161699786838301793e-17
    var atanlo2 = 1.39033110312309984516e-17
    var atanlo3 = 6.12323399573676603587e-17

    // Polynomial coefficients aT[0..10] (openlibm).
    var aT0 = 3.33333333333329318027e-01
    var aT1 = -1.99999999998764832476e-01
    var aT2 = 1.42857142725034663711e-01
    var aT3 = -1.11111104054623557880e-01
    var aT4 = 9.09088713343650656196e-02
    var aT5 = -7.69187620504482999495e-02
    var aT6 = 6.66107313738753120669e-02
    var aT7 = -5.83357013379057348645e-02
    var aT8 = 4.97687799461593236017e-02
    var aT9 = -3.65315727442169155270e-02
    var aT10 = 1.62858201153657823623e-02

    // Argument reduction (numeric threshold equivalents of the bit checks).
    var id = -1
    var t = ax
    if ax < 0.4375 {
        id = -1
        t = ax
    } else {
        if ax < 1.1875 {
            if ax < 0.6875 {
                id = 0
                t = (2.0 * ax - 1.0) / (2.0 + ax)
            } else {
                id = 1
                t = (ax - 1.0) / (ax + 1.0)
            }
        } else {
            if ax < 2.4375 {
                id = 2
                t = (ax - 1.5) / (1.0 + 1.5 * ax)
            } else {
                id = 3
                t = -1.0 / ax
            }
        }
    }

    var z = t * t
    var w = z * z
    var s1 = z * (aT0 + w * (aT2 + w * (aT4 + w * (aT6 + w * (aT8 + w * aT10)))))
    var s2 = w * (aT1 + w * (aT3 + w * (aT5 + w * (aT7 + w * aT9))))
    var r = t - t * (s1 + s2)

    var res = r
    if id >= 0 {
        if id == 0 { res = atanhi0 - ((t * (s1 + s2) - atanlo0) - t) }
        if id == 1 { res = atanhi1 - ((t * (s1 + s2) - atanlo1) - t) }
        if id == 2 { res = atanhi2 - ((t * (s1 + s2) - atanlo2) - t) }
        if id == 3 { res = atanhi3 - ((t * (s1 + s2) - atanlo3) - t) }
    }

    if hx < 0.0 { return 0.0 - res }
    return res
}

fn atan2(y, x) {
    if is_nan(x) || is_nan(y) { return oren_err(4, "atan2: NaN") }
    if is_inf(x) || is_inf(y) {
        // Defer to the generic logic below; it handles infinities with atan.
    }

    // y == 0: return +/-0 or +/-pi depending on sign of x.
    if y == 0.0 {
        if x >= 0.0 { return y } // preserves sign of y (±0)
        if signbit(y) { return 0.0 - pi() }
        return pi()
    }

    // x == 0: return +/- pi/2
    if x == 0.0 {
        if y < 0.0 { return 0.0 - (pi() / 2.0) }
        return pi() / 2.0
    }

    // General case.
    var z = atan(abs_f(y / x))
    if oren_is_err(z) { return z }

    // Quadrant adjustments (match fdlibm/openlibm intent).
    if x > 0.0 {
        if y < 0.0 { return 0.0 - z }
        return z
    }
    // x < 0
    if y < 0.0 { return (z - pi()) }
    return (pi() - z)
}
