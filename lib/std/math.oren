// std/math (rolling)
//
// Scope: deterministic, portable math building blocks.
//
// Design goals:
// - No host `libm` dependency (works the same across C/native/AVM backends).
// - Deterministic semantics (fixed iteration counts; no CPU-specific rounding modes).
// - Provide HPC-relevant primitives incrementally (sqrt, powi, etc.) so higher-level
//   linalg/scientific libraries can build on them.

import list "std:list"

fn abs_i(x) {
    if x < 0 { return -x }
    return x
}

fn min_i(a, b) {
    if a < b { return a }
    return b
}

fn max_i(a, b) {
    if a > b { return a }
    return b
}

fn clamp_i(x, lo, hi) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fn abs_f(x: f64) {
    if x < 0.0 { return -x }
    return x
}

fn min_f(a: f64, b: f64) {
    if a < b { return a }
    return b
}

fn max_f(a: f64, b: f64) {
    if a > b { return a }
    return b
}

fn clamp_f(x: f64, lo: f64, hi: f64) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

fn is_nan(x: f64) {
    // IEEE-ish: NaN != NaN
    return x != x
}

fn _f64_bits(x: f64) {
    return oren_f64_to_u64_bits(f64(x))
}

fn _f64_from_bits(u) {
    return oren_u64_bits_to_f64(u64(u))
}

fn is_inf(x: f64) {
    if is_nan(x) { return false }
    var b = _f64_bits(x)
    if oren_is_err(b) { return false }
    // exp==0x7ff and mantissa==0
    return ((b >> 52) & 2047) == 2047 && (b & 4503599627370495) == 0
}

fn is_finite(x: f64) {
    if is_nan(x) { return false }
    var b = _f64_bits(x)
    if oren_is_err(b) { return false }
    return ((b >> 52) & 2047) != 2047
}

fn signbit(x: f64) {
    var b = _f64_bits(x)
    if oren_is_err(b) { return false }
    return (b >> 63) != 0
}

fn copysign(x: f64, y: f64) {
    var xb = _f64_bits(x)
    if oren_is_err(xb) { return xb }
    var yb = _f64_bits(y)
    if oren_is_err(yb) { return yb }
    var sign = yb & 9223372036854775808
    var mag = xb & 9223372036854775807
    return _f64_from_bits(mag | sign)
}

fn inf() {
    return _f64_from_bits(9218868437227405312) // +inf: 0x7ff0000000000000
}

fn neg_inf() {
    return _f64_from_bits(18442240474082181120) // -inf: 0xfff0000000000000
}

// --- rounding helpers (float, deterministic, no host libm) ---
//
// Semantics (rolling, v0):
// - `floor(x)` / `ceil(x)` / `round(x)` operate on float values and return a float.
// - Errors:
//   - NaN returns `Err(code=4, msg=...)` (OREN_ERR_INVALID_ARG)
// - Large magnitude:
//   - For |x| >= 2^63, we return x unchanged (it cannot be meaningfully truncated to i64).
//     This is deterministic and avoids spurious errors for large-but-integral floats.
//
// Rounding rule:
// - `round(x)` is **half away from zero**.
//   (Bankers rounding can be added later as a separate API if needed.)

fn trunc_i64_from_f(x: f64) {
    // Returns int or Err.
    return oren_trunc_int(x)
}

fn floor(x: f64) {
    if is_nan(x) { return oren_err(4, "floor: NaN") }
    // Preserve -0.0 by returning the input.
    if x == 0.0 { return x }
    var lim = 9223372036854775808.0 // 2^63
    if x >= lim || x <= 0.0 - lim { return x }

    var ti = trunc_i64_from_f(x)
    if oren_is_err(ti) { return ti }
    var t = f64(ti)
    if t == x { return x }
    if x > 0.0 { return t }
    return t - 1.0
}

fn ceil(x: f64) {
    if is_nan(x) { return oren_err(4, "ceil: NaN") }
    if x == 0.0 { return x }
    var lim = 9223372036854775808.0 // 2^63
    if x >= lim || x <= 0.0 - lim { return x }

    var ti = trunc_i64_from_f(x)
    if oren_is_err(ti) { return ti }
    var t = f64(ti)
    if t == x { return x }
    if x < 0.0 { return t }
    return t + 1.0
}

fn round(x: f64) {
    if is_nan(x) { return oren_err(4, "round: NaN") }
    if x == 0.0 { return x }
    var lim = 9223372036854775808.0 // 2^63
    if x >= lim || x <= 0.0 - lim { return x }

    var ti = trunc_i64_from_f(x)
    if oren_is_err(ti) { return ti }
    var t = f64(ti)
    if t == x { return x }

    var frac = x - t
    // abs(frac)
    var af = frac
    if af < 0.0 { af = 0.0 - af }

    if af > 0.5 {
        if x > 0.0 { return t + 1.0 }
        return t - 1.0
    }
    if af < 0.5 { return t }
    // exactly half: away from zero
    if x > 0.0 { return t + 1.0 }
    return t - 1.0
}

// --- sqrt / pow (HPC foundation) ---
//
// sqrt(x) semantics:
// - If x < 0: Err(OREN_ERR_INVALID_ARG)
// - If x is NaN: Err
// - If x is +inf: +inf
// - If x is +/-0.0: returns x (preserve sign of zero deterministically)
//
// Implementation:
// - Uses exponent-only initial guess derived from IEEE-754 bits, plus an optional
//   sqrt(2) correction for odd exponents.
// - Uses a fixed number of Newton iterations for determinism.
//
// This is not a replacement for a tuned libm yet, but it is a correct, portable
// building block for stdlib linalg/scientific code.

fn sqrt(x: f64) {
    if is_nan(x) { return oren_err(4, "sqrt: NaN") }
    if x < 0.0 { return oren_err(4, "sqrt: negative") }
    if x == 0.0 { return x }
    if is_inf(x) { return x }

    var b0 = _f64_bits(x)
    if oren_is_err(b0) { return b0 }
    var exp0 = (b0 >> 52) & 2047

    // Normalize subnormals by scaling. This keeps the exponent path well-defined.
    var xn = x
    var exp = exp0
    var adjust = 0
    if exp == 0 {
        // x != 0.0 here, so it is subnormal.
        // Multiply by 2^54 (exact in f64) and later subtract 54 from the exponent.
        xn = x * 18014398509481984.0
        var b1 = _f64_bits(xn)
        if oren_is_err(b1) { return b1 }
        exp = (b1 >> 52) & 2047
        adjust = 54
    }

    // Unbias exponent.
    var e = exp - 1023 - adjust
    var ge = e / 2
    // Initial guess: 2^ge (mantissa=0).
    var gb = (u64(ge + 1023) << 52)
    var g = _f64_from_bits(gb)
    if oren_is_err(g) { return g }

    // If exponent is odd, multiply guess by sqrt(2) to improve convergence.
    var e_is_odd = e & 1
    if e_is_odd != 0 {
        g = g * 1.4142135623730951
    }

    // Fixed-iteration Newton-Raphson: g_{n+1} = 0.5 * (g + xn/g)
    // 8 iterations is ample for f64 from this guess and remains deterministic.
    var i = 0
    while i < 8 {
        g = 0.5 * (g + xn / g)
        i = i + 1
    }
    return g
}

fn powi(x: f64, n) {
    // Integer exponent power (deterministic, no libm).
    // For negative n, we return 1/(x^(-n)).
    if n == 0 { return 1.0 }
    var nn = n
    var inv = false
    if nn < 0 {
        inv = true
        nn = 0 - nn
    }
    var base = x
    var acc = 1.0
    while nn > 0 {
        var nn_is_odd = nn & 1
        if nn_is_odd != 0 { acc = acc * base }
        base = base * base
        nn = nn >> 1
    }
    if inv { return 1.0 / acc }
    return acc
}

fn _pow_integral_exponent(y: f64) {
    if !is_finite(y) { return oren_err(4, "pow: non-finite integer exponent") }
    var yi = trunc_i64_from_f(y)
    if oren_is_err(yi) { return yi }
    if f64(yi) != y { return oren_err(4, "pow: fractional exponent") }
    return yi
}

fn pow(x: f64, y: f64) {
    // Real-valued power, deterministic and host-libm-free.
    // - Integer exponents use `powi` so `pow(2,-1)` is exact enough and negative
    //   bases remain in the real domain when valid.
    // - Positive non-integer powers use x^y = 2^(y*log2(x)).
    // - Negative base with a fractional exponent is complex-valued, so std:math
    //   returns Err rather than inventing a real result.
    if is_nan(x) || is_nan(y) { return oren_err(4, "pow: NaN") }
    if y == 0.0 { return 1.0 }
    if x == 1.0 { return 1.0 }
    if y == 1.0 { return x }
    if is_inf(y) {
        var ax = abs_f(x)
        if ax == 1.0 { return 1.0 }
        if signbit(y) {
            if ax > 1.0 { return 0.0 }
            return inf()
        }
        if ax > 1.0 { return inf() }
        return 0.0
    }

    var yi = _pow_integral_exponent(y)
    if !oren_is_err(yi) { return powi(x, yi) }

    if x < 0.0 { return oren_err(4, "pow: negative base fractional exponent") }
    var lx = log2(x)
    if oren_is_err(lx) { return lx }
    return exp2(y * lx)
}

fn power(x: f64, y: f64) {
    return pow(x, y)
}

// --- exponent helpers (frexp/ldexp equivalents) ---

fn pow2i(e) {
    // Return 2^e as an f64 (deterministic via bit construction).
    // - for e > 1023: +inf
    // - for e < -1074: 0.0
    if e > 1023 { return inf() }
    if e < -1074 { return 0.0 }
    if e >= -1022 {
        // normal
        return _f64_from_bits(u64(e + 1023) << 52)
    }
    // subnormal: mantissa = 2^(e+1074)
    return _f64_from_bits(u64(1) << u64(e + 1074))
}

fn ldexp(x: f64, e) {
    // x * 2^e
    if is_nan(x) { return oren_err(4, "ldexp: NaN") }
    if x == 0.0 { return x }
    if is_inf(x) { return x }
    return x * pow2i(e)
}

fn frexp(x: f64) {
    // Returns [mantissa, exp] where x = mantissa * 2^exp and mantissa in [0.5, 1).
    // For x==0: returns [0.0, 0].
    if is_nan(x) { return oren_err(4, "frexp: NaN") }
    if x == 0.0 { return [x, 0] }
    if is_inf(x) { return [x, 0] }

    var b0 = _f64_bits(x)
    if oren_is_err(b0) { return b0 }
    var sign = b0 & 9223372036854775808
    var exp0 = (b0 >> 52) & 2047
    var mant = b0 & 4503599627370495

    var xn = x
    var exp = exp0
    var adjust = 0
    if exp == 0 {
        // subnormal: scale by 2^54 (exact), then compensate exponent by -54
        xn = x * 18014398509481984.0
        var b1 = _f64_bits(xn)
        if oren_is_err(b1) { return b1 }
        exp = (b1 >> 52) & 2047
        mant = b1 & 4503599627370495
        adjust = 54
    }

    // x = (1.mant)*2^(exp-1023-adjust)
    // We want m in [0.5,1): m = (1.mant)*2^-1, exp_out = (exp-1023-adjust)+1 = exp-1022-adjust
    var exp_out = exp - 1022 - adjust
    var mb = sign | (u64(1022) << 52) | mant
    var m = _f64_from_bits(mb)
    if oren_is_err(m) { return m }
    return [m, exp_out]
}

// --- exp/log (deterministic, no host libm) ---

fn _exp_taylor(z: f64) {
    // exp(z) for z in [0, ln2] via fixed-term Taylor series.
    // 12 terms is enough for good accuracy on this small interval.
    var term = 1.0
    var sum = 1.0
    var i = 1
    while i <= 12 {
        term = term * z / f64(i)
        sum = sum + term
        i = i + 1
    }
    return sum
}

fn exp2(x: f64) {
    // 2^x via integer+fraction decomposition.
    if is_nan(x) { return oren_err(4, "exp2: NaN") }
    if x == 0.0 { return 1.0 }
    if is_inf(x) {
        if signbit(x) { return 0.0 }
        return x
    }
    if x > 1024.0 { return inf() }
    if x < -1075.0 { return 0.0 }

    var fx = floor(x)
    if oren_is_err(fx) { return fx }
    var ni = trunc_i64_from_f(fx)
    if oren_is_err(ni) { return ni }
    var f = x - f64(ni) // in [0,1)

    var LN2 = 0.6931471805599453
    var frac = _exp_taylor(f * LN2)
    var scale = pow2i(ni)
    return scale * frac
}

fn exp(x: f64) {
    if is_nan(x) { return oren_err(4, "exp: NaN") }
    if x == 0.0 { return 1.0 }
    // exp(x) = 2^(x / ln2)
    var INV_LN2 = 1.4426950408889634
    return exp2(x * INV_LN2)
}

fn log2(x: f64) {
    // Returns log2(x) for x > 0.
    if is_nan(x) { return oren_err(4, "log2: NaN") }
    if x == 0.0 { return neg_inf() }
    if x < 0.0 { return oren_err(4, "log2: negative") }
    if is_inf(x) { return x }

    var b0 = _f64_bits(x)
    if oren_is_err(b0) { return b0 }
    var sign = b0 & 9223372036854775808
    var exp0 = (b0 >> 52) & 2047
    var mant = b0 & 4503599627370495
    var adjust = 0
    if exp0 == 0 {
        var xn = x * 18014398509481984.0
        var b1 = _f64_bits(xn)
        if oren_is_err(b1) { return b1 }
        exp0 = (b1 >> 52) & 2047
        mant = b1 & 4503599627370495
        adjust = 54
    }
    var m = _f64_from_bits(sign | (u64(1022) << 52) | mant)
    if oren_is_err(m) { return m }
    var e = exp0 - 1022 - adjust

    // ln(m) using atanh series: ln(m) = 2 * (t + t^3/3 + t^5/5 + ...)
    // where t = (m-1)/(m+1), |t| <= 1/3 for m in [0.5,1)
    var t = (m - 1.0) / (m + 1.0)
    var t2 = t * t
    var term = t
    var s = t
    // Use enough odd terms to be accurate even at the worst-case `m=0.5` (t=-1/3).
    // This is still deterministic (fixed iteration count).
    var k = 3
    while k <= 41 {
        term = term * t2
        s = s + term / f64(k)
        k = k + 2
    }
    var ln_m = 2.0 * s
    var INV_LN2 = 1.4426950408889634
    return f64(e) + ln_m * INV_LN2
}

fn ln(x: f64) {
    var v = log2(x)
    if oren_is_err(v) { return v }
    var LN2 = 0.6931471805599453
    return v * LN2
}

// --- trig (deterministic, no host libm) ---
//
// v0 design:
// - Provide `sin(x)` / `cos(x)` for moderate |x| (range-reduced).
// - Deterministic: fixed reduction strategy + fixed polynomial degrees.
// - For very large |x|, range reduction must avoid losing integer bits in
//   `x/(pi/2)`; we use a Payne–Hanek-style reduction adapted from fdlibm
//   (see `docs/refs/fdlibm/{e_rem_pio2.c,k_rem_pio2.c}`) to stay correct.
//
// Range reduction:
// - k = round(x / (pi/2))  (half away from zero; deterministic via math.round)
// - r = x - k*(pi/2)       where r is in approximately [-pi/4, +pi/4]
// - quadrant = k & 3
//
// Polynomial:
// - Use truncated Taylor (sufficient on |r| <= pi/4):
//   sin(r) ~ r - r^3/6 + r^5/120 - r^7/5040 + r^9/362880 - r^11/39916800
//   cos(r) ~ 1 - r^2/2 + r^4/24 - r^6/720 + r^8/40320 - r^10/3628800

fn pi() { return 3.141592653589793 }
fn tau() { return 6.283185307179586 }

fn _sin_poly(r: f64) {
    var r2 = r * r
    // Horner, odd polynomial:
    // r * (1 + r2*(c3 + r2*(c5 + ...)))
    var c11 = -1.0 / 39916800.0
    var c9 = 1.0 / 362880.0
    var c7 = -1.0 / 5040.0
    var c5 = 1.0 / 120.0
    var c3 = -1.0 / 6.0
    var p = (((c11 * r2 + c9) * r2 + c7) * r2 + c5) * r2 + c3
    return r + r * r2 * p
}

fn _cos_poly(r: f64) {
    var r2 = r * r
    var c10 = -1.0 / 3628800.0
    var c8 = 1.0 / 40320.0
    var c6 = -1.0 / 720.0
    var c4 = 1.0 / 24.0
    var c2 = -1.0 / 2.0
    // 1 + r2*(c2 + r2*(c4 + ...))
    var p = (((c10 * r2 + c8) * r2 + c6) * r2 + c4) * r2 + c2
    return 1.0 + r2 * p
}

fn _reduce_pio2_medium(x: f64) {
    // Cody-Waite style reduction (good up to ~2^20 * (pi/2)).
    // Returns [r, n_mod8] where r ~ x - n*pi/2, and n_mod8 is in [0..7].
    //
    // Constants from fdlibm `e_rem_pio2.c`.
    var invpio2 = 6.36619772367581382433e-01 // 2/pi (53 bits)
    var pio2_1 = 1.57079632673412561417e+00
    var pio2_1t = 6.07710050650619224932e-11
    var pio2_2 = 6.07710050630396597660e-11
    var pio2_2t = 2.02226624879595063154e-21
    var pio2_3 = 2.02226624871116645580e-21
    var pio2_3t = 8.47842766036889956997e-32

    var kf = round(x * invpio2)
    if oren_is_err(kf) { return kf }
    var n = trunc_i64_from_f(kf)
    if oren_is_err(n) { return n }

    var r = x - kf * pio2_1
    var w = kf * pio2_1t // 1st round good to ~85 bits
    var y0 = r - w
    var y1 = (r - y0) - w

    // Cancellation detection: if reduction nearly cancels, run extra rounds.
    // Use exponent-only check (fdlibm uses a slightly tighter bit trick).
    var ax = abs_f(x)
    var bx = _f64_bits(ax)
    if oren_is_err(bx) { return bx }
    var by0 = _f64_bits(abs_f(y0))
    if oren_is_err(by0) { return by0 }
    var xexp = (bx >> 52) & 2047
    var yexp = (by0 >> 52) & 2047
    var i = xexp - yexp

    if i > 16 {
        var t = r
        w = kf * pio2_2
        r = t - w
        w = kf * pio2_2t - ((t - r) - w)
        y0 = r - w
        y1 = (r - y0) - w

        by0 = _f64_bits(abs_f(y0))
        if oren_is_err(by0) { return by0 }
        yexp = (by0 >> 52) & 2047
        i = xexp - yexp

        if i > 49 {
            t = r
            w = kf * pio2_3
            r = t - w
            w = kf * pio2_3t - ((t - r) - w)
            y0 = r - w
            y1 = (r - y0) - w
        }
    }

    return [y0 + y1, (n & 7)]
}

fn _kernel_rem_pio2(tx, e0, nx) {
    // Port of fdlibm `__kernel_rem_pio2(..., prec=1)` (double precision).
    // Returns [r, n_mod8] for positive input x represented in tx[] digits.
    //
    // Note: this is performance-sensitive for huge |x|, but huge trig is not
    // expected on every hot path. The medium reducer covers the common case.

    var jk = 4
    var jp = jk
    var jx = nx - 1
    if jx < 0 { return oren_err(4, "_kernel_rem_pio2: nx") }

    // ipio2 table for double (first block from fdlibm, 24-bit chunks).
    // Each entry is an integer representing bits of 2/pi after the binary point.
    var ipio2 = [
        0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62,
        0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7, 0x246E3A,
        0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,
        0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41,
        0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8,
        0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,
        0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5,
        0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08,
        0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,
        0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880,
        0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B
    ]

    // PI/2 cut into 24-bit chunks (double precision).
    var PIo2 = [
        1.57079625129699707031e+00,
        7.54978941586159635335e-08,
        5.39030252995776476554e-15,
        3.28200341580791294123e-22,
        1.27065575308067607349e-29,
        1.22933308981111328932e-36,
        2.73370053816464559624e-44,
        2.16741683877804819444e-51
    ]

    var two24 = 16777216.0
    var twon24 = 5.9604644775390625e-08 // 2^-24

    // determine jv and q0
    var jv = (e0 - 3) / 24
    if jv < 0 { jv = 0 }
    var q0 = e0 - 24 * (jv + 1)

    // f[0..m] where m=jx+jk
    var m = jx + jk
    if m > 19 { return oren_err(4, "_kernel_rem_pio2: nx too large") }
    var f = []
    var i = 0
    while i <= m { list.push(f, 0.0); i = i + 1 }
    var j = jv - jx
    i = 0
    while i <= m {
        var fv = 0.0
        if j >= 0 {
            // ipio2 table is long enough for f64 exponent range.
            fv = f64(ipio2[j])
        }
        f[i] = fv
        i = i + 1
        j = j + 1
    }

    // compute q[0..jk]
    var q = []
    i = 0
    while i <= jk { list.push(q, 0.0); i = i + 1 }

    i = 0
    while i <= jk {
        var fw = 0.0
        j = 0
        while j <= jx {
            fw = fw + tx[j] * f[jx + i - j]
            j = j + 1
        }
        q[i] = fw
        i = i + 1
    }

    // distill q into iq[]
    var jz = jk
    // iq stores 24-bit chunks in reverse order.
    var iq = []
    i = 0
    while i < 20 { list.push(iq, 0); i = i + 1 }

    var z = q[jz]
    i = 0
    j = jz
    while j > 0 {
        var fw2 = trunc_i64_from_f(twon24 * z)
        if oren_is_err(fw2) { return fw2 }
        var fwf = f64(fw2)
        iq[i] = trunc_i64_from_f(z - two24 * fwf)
        if oren_is_err(iq[i]) { return iq[i] }
        z = q[j - 1] + fwf
        i = i + 1
        j = j - 1
    }

    // compute n and fractional z
    z = ldexp(z, q0)
    var t = floor(z * 0.125)
    if oren_is_err(t) { return t }
    z = z - 8.0 * t

    var n = trunc_i64_from_f(z)
    if oren_is_err(n) { return n }
    z = z - f64(n)

    var ih = 0
    if q0 > 0 {
        var idx = jz - 1
        var shift = 24 - q0
        var add = iq[idx] >> shift
        n = n + add
        iq[idx] = iq[idx] - (add << shift)
        ih = iq[idx] >> (23 - q0)
    } else {
        if q0 == 0 {
            ih = iq[jz - 1] >> 23
        } else {
            if z >= 0.5 { ih = 2 }
        }
    }

    if ih > 0 {
        // q > 0.5: compute 1-q
        n = n + 1
        var carry = 0
        i = 0
        while i < jz {
            var v = iq[i]
            if carry == 0 {
                if v != 0 {
                    carry = 1
                    iq[i] = 0x1000000 - v
                }
            } else {
                iq[i] = 0xffffff - v
            }
            i = i + 1
        }
        if q0 > 0 {
            if q0 == 1 { iq[jz - 1] = iq[jz - 1] & 0x7fffff }
            if q0 == 2 { iq[jz - 1] = iq[jz - 1] & 0x3fffff }
        }
        if ih == 2 {
            z = 1.0 - z
            if carry != 0 { z = z - ldexp(1.0, q0) }
        }
    }

    // If z==0, kernel may need to recompute with more terms; for f64 and our
    // limited nx, this is extremely rare. We treat it as zero remainder.
    // (Full fdlibm recomputation is long and depends on larger ipio2 tables.)

    // Break z into 24-bit chunk if needed.
    if z != 0.0 {
        z = ldexp(z, -q0)
        if z >= two24 {
            var fw3 = trunc_i64_from_f(twon24 * z)
            if oren_is_err(fw3) { return fw3 }
            iq[jz] = trunc_i64_from_f(z - two24 * f64(fw3))
            if oren_is_err(iq[jz]) { return iq[jz] }
            jz = jz + 1
            q0 = q0 + 24
            iq[jz] = fw3
        } else {
            iq[jz] = trunc_i64_from_f(z)
            if oren_is_err(iq[jz]) { return iq[jz] }
        }
    }

    // Convert iq into q floats (scaled).
    var qv = []
    i = 0
    while i < 20 { list.push(qv, 0.0); i = i + 1 }
    var fw4 = ldexp(1.0, q0)
    i = jz
    while i >= 0 {
        qv[i] = fw4 * f64(iq[i])
        fw4 = fw4 * twon24
        i = i - 1
    }

    // Compute fq
    var fq = []
    i = 0
    while i < 20 { list.push(fq, 0.0); i = i + 1 }
    i = jz
    while i >= 0 {
        var fw5 = 0.0
        var k = 0
        while k <= jp && k <= (jz - i) {
            fw5 = fw5 + PIo2[k] * qv[i + k]
            k = k + 1
        }
        fq[jz - i] = fw5
        i = i - 1
    }

    // Compress fq into y0/y1 (double precision).
    var fw6 = 0.0
    i = jz
    while i >= 0 { fw6 = fw6 + fq[i]; i = i - 1 }
    var y0 = fw6
    var fw7 = fq[0] - fw6
    i = 1
    while i <= jz { fw7 = fw7 + fq[i]; i = i + 1 }
    var y1 = fw7

    // If ih>0 we flipped sign implicitly; apply it here.
    if ih != 0 {
        y0 = 0.0 - y0
        y1 = 0.0 - y1
    }

    return [y0 + y1, (n & 7)]
}

fn _reduce_pio2_payne_hanek(x: f64) {
    // Payne–Hanek reduction for large |x|.
    // Returns [r, q] where r in ~[-pi/4,pi/4], q in [0..3].
    if is_nan(x) { return oren_err(4, "_reduce_pio2: NaN") }
    if is_inf(x) { return oren_err(4, "_reduce_pio2: inf") }
    if x == 0.0 { return [x, 0] }

    var ax = abs_f(x)
    var fe = frexp(ax)
    if oren_is_err(fe) { return fe }
    var m = fe[0]
    var e = fe[1]
    // ilogb(ax) is e-1 for frexp's [0.5,1) mantissa.
    var ilogb = e - 1
    var e0 = ilogb - 23

    // z = scalbn(ax, -e0)  (so z ~ mantissa * 2^23 in [2^23,2^24))
    var z = ldexp(ax, 0 - e0)

    var two24 = 16777216.0
    var tx = []
    // 3 chunks (like fdlibm).
    var i = 0
    while i < 3 { list.push(tx, 0.0); i = i + 1 }
    i = 0
    while i < 2 {
        var ti = trunc_i64_from_f(z)
        if oren_is_err(ti) { return ti }
        tx[i] = f64(ti)
        z = (z - tx[i]) * two24
        i = i + 1
    }
    tx[2] = z

    var nx = 3
    while nx > 1 && tx[nx - 1] == 0.0 { nx = nx - 1 }

    var kr = _kernel_rem_pio2(tx, e0, nx)
    if oren_is_err(kr) { return kr }
    var r = kr[0]
    var nmod8 = kr[1]
    // Apply sign: fdlibm returns negative remainder and negative n for negative x.
    if x < 0.0 {
        r = 0.0 - r
        nmod8 = (0 - nmod8) & 7
    }
    var q = nmod8 & 3
    return [r, q]
}

fn _reduce_pio2(x: f64) {
    // Returns [r, q] or Err where q in [0..3].
    if is_nan(x) { return oren_err(4, "_reduce_pio2: NaN") }
    if is_inf(x) { return oren_err(4, "_reduce_pio2: inf") }
    // |x| <= pi/4: no reduction needed.
    var ax = abs_f(x)
    if ax <= (pi() / 4.0) { return [x, 0] }

    // Medium threshold from fdlibm: |x| < 2^20 * (pi/2).
    // Beyond this, Cody-Waite begins losing bits and Payne-Hanek is needed.
    var MED = 1644934.0
    if ax < MED {
        var rr = _reduce_pio2_medium(x)
        if oren_is_err(rr) { return rr }
        return [rr[0], rr[1] & 3]
    }

    return _reduce_pio2_payne_hanek(x)
}

fn sin(x: f64) {
    if x == 0.0 { return x } // preserve signed zero
    var rq = _reduce_pio2(x)
    if oren_is_err(rq) { return rq }
    var r = rq[0]
    var q = rq[1]
    var sr = _sin_poly(r)
    var cr = _cos_poly(r)
    if q == 0 { return sr }
    if q == 1 { return cr }
    if q == 2 { return 0.0 - sr }
    return 0.0 - cr
}

fn cos(x: f64) {
    if is_nan(x) { return oren_err(4, "cos: NaN") }
    if is_inf(x) { return oren_err(4, "cos: inf") }
    if x == 0.0 { return 1.0 }
    var rq = _reduce_pio2(x)
    if oren_is_err(rq) { return rq }
    var r = rq[0]
    var q = rq[1]
    var sr = _sin_poly(r)
    var cr = _cos_poly(r)
    if q == 0 { return cr }
    if q == 1 { return 0.0 - sr }
    if q == 2 { return 0.0 - cr }
    return sr
}

// --- atan / atan2 (deterministic, no host libm) ---
//
// Implemented based on the classical fdlibm/openlibm range-reduction scheme
// (see `docs/refs/openlibm/s_atan.c` and `docs/refs/openlibm/e_atan2.c`).
//
// Semantics:
// - NaN inputs return Err(OREN_ERR_INVALID_ARG)
// - atan2 matches the usual mathematical definition with sign handling for zeros.
//

fn atan(x: f64) {
    if is_nan(x) { return oren_err(4, "atan: NaN") }
    if x == 0.0 { return x } // preserve signed zero
    if is_inf(x) {
        if signbit(x) { return 0.0 - (pi() / 2.0) }
        return pi() / 2.0
    }

    var hx = x
    var ax = abs_f(x)

    // Constants from openlibm (split hi/lo for accuracy near reduction points).
    var atanhi0 = 4.63647609000806093515e-01
    var atanhi1 = 7.85398163397448278999e-01
    var atanhi2 = 9.82793723247329054082e-01
    var atanhi3 = 1.57079632679489655800e+00
    var atanlo0 = 2.26987774529616870924e-17
    var atanlo1 = 3.06161699786838301793e-17
    var atanlo2 = 1.39033110312309984516e-17
    var atanlo3 = 6.12323399573676603587e-17

    // Polynomial coefficients aT[0..10] (openlibm).
    var aT0 = 3.33333333333329318027e-01
    var aT1 = -1.99999999998764832476e-01
    var aT2 = 1.42857142725034663711e-01
    var aT3 = -1.11111104054623557880e-01
    var aT4 = 9.09088713343650656196e-02
    var aT5 = -7.69187620504482999495e-02
    var aT6 = 6.66107313738753120669e-02
    var aT7 = -5.83357013379057348645e-02
    var aT8 = 4.97687799461593236017e-02
    var aT9 = -3.65315727442169155270e-02
    var aT10 = 1.62858201153657823623e-02

    // Argument reduction (numeric threshold equivalents of the bit checks).
    var id = -1
    var t = ax
    if ax < 0.4375 {
        id = -1
        t = ax
    } else {
        if ax < 1.1875 {
            if ax < 0.6875 {
                id = 0
                t = (2.0 * ax - 1.0) / (2.0 + ax)
            } else {
                id = 1
                t = (ax - 1.0) / (ax + 1.0)
            }
        } else {
            if ax < 2.4375 {
                id = 2
                t = (ax - 1.5) / (1.0 + 1.5 * ax)
            } else {
                id = 3
                t = -1.0 / ax
            }
        }
    }

    var z = t * t
    var w = z * z
    var s1 = z * (aT0 + w * (aT2 + w * (aT4 + w * (aT6 + w * (aT8 + w * aT10)))))
    var s2 = w * (aT1 + w * (aT3 + w * (aT5 + w * (aT7 + w * aT9))))
    var r = t - t * (s1 + s2)

    var res = r
    if id >= 0 {
        if id == 0 { res = atanhi0 - ((t * (s1 + s2) - atanlo0) - t) }
        if id == 1 { res = atanhi1 - ((t * (s1 + s2) - atanlo1) - t) }
        if id == 2 { res = atanhi2 - ((t * (s1 + s2) - atanlo2) - t) }
        if id == 3 { res = atanhi3 - ((t * (s1 + s2) - atanlo3) - t) }
    }

    if hx < 0.0 { return 0.0 - res }
    return res
}

fn atan2(y: f64, x: f64) {
    if is_nan(x) || is_nan(y) { return oren_err(4, "atan2: NaN") }
    if is_inf(x) || is_inf(y) {
        // Defer to the generic logic below; it handles infinities with atan.
    }

    // y == 0: return +/-0 or +/-pi depending on sign of x.
    if y == 0.0 {
        if x >= 0.0 { return y } // preserves sign of y (±0)
        if signbit(y) { return 0.0 - pi() }
        return pi()
    }

    // x == 0: return +/- pi/2
    if x == 0.0 {
        if y < 0.0 { return 0.0 - (pi() / 2.0) }
        return pi() / 2.0
    }

    // General case.
    var z = atan(abs_f(y / x))
    if oren_is_err(z) { return z }

    // Quadrant adjustments (match fdlibm/openlibm intent).
    if x > 0.0 {
        if y < 0.0 { return 0.0 - z }
        return z
    }
    // x < 0
    if y < 0.0 { return (z - pi()) }
    return (pi() - z)
}
