// std/json (rolling)
//
// Key constraint: native backend currently cannot reliably distinguish `nil`/`false`/`0`
// at runtime (all may be represented as small integers). To stay portable and deterministic
// across backends, this module uses an explicit tagged JsonValue representation.
//
// JsonValue shape (map):
//   {"t":"null"}
//   {"t":"bool","b":0|1}
//   {"t":"int","i":<int>}
//   {"t":"string","s":<string>}
//   {"t":"array","a":[JsonValue...]}
//   {"t":"object","o":{ string_key: JsonValue, ... }}  // map iteration yields keys in sorted order

import raw "std:buffer/raw"
import list "std:list"

struct JsonValue {
    t,
    b,
    i,
    s,
    a,
    o
}

fn jnull(): JsonValue { return {"t": "null"} }
fn jbool(b): JsonValue { return {"t": "bool", "b": b} }
fn jint(i): JsonValue { return {"t": "int", "i": i} }
fn jstring(s): JsonValue { return {"t": "string", "s": s} }
fn jarray(a): JsonValue { return {"t": "array", "a": a} }
fn jobject(o): JsonValue { return {"t": "object", "o": o} }

trait JsonText {
    fn json(self): JsonValue;
}

trait JsonValueCodec {
    fn text(self);
}

fn _is_ws(b) {
    return b == 32 || b == 9 || b == 10 || b == 13
}

fn _byte_at(s, i) {
    return oren_string_byte_at_unchecked(s, i) & 255
}

fn _streq(a, b) {
    if a == nil || b == nil { return false }
    var al = oren_string_len(a)
    var bl = oren_string_len(b)
    if al != bl { return false }
    var i = 0
    while i < al {
        if _byte_at(a, i) != _byte_at(b, i) { return false }
        i = i + 1
    }
    return true
}

fn _buf_put_u8(out, pos, b) {
    raw._store_u8_buf_unchecked_direct(out, pos, b)
    return pos + 1
}

fn _skip_ws(src, pos) {
    // Skip whitespace and tolerate C-style comments in decode.
    // Supported:
    //   - line comments: // ... (to end of line)
    //   - block comments: /* ... */
    // Comments are only recognized outside strings.
    var n = oren_string_len(src)
    var i = pos
    while i < n {
        // whitespace
        while i < n && _is_ws(_byte_at(src, i)) { i = i + 1 }
        if i >= n { return i }

        // comments
        if _byte_at(src, i) == 47 { // '/'
            if i + 1 >= n { return i }
            var n2 = _byte_at(src, i + 1)
            if n2 == 47 {
                // // ...

                i = i + 2
                while i < n {
                    var b = _byte_at(src, i)
                    if b == 10 || b == 13 { break }
                    i = i + 1
                }
                continue
            }
            if n2 == 42 {
                // /* ... */
                i = i + 2
                while i + 1 < n {
                    if _byte_at(src, i) == 42 && _byte_at(src, i + 1) == 47 {
                        i = i + 2
                        break
                    }
                    i = i + 1
                }
                // Unterminated block comment: treat as EOF; callers will error.
                continue
            }
        }

        return i
    }
    return i
}


fn _err(msg, pos) {
    return {"ok": 0, "err": msg, "pos": pos}
}

fn _ok(v, pos) {
    return {"ok": 1, "v": v, "pos": pos}
}

fn _match_lit(src, pos, lit_bytes) {
    var i = 0
    var n = list.len(lit_bytes)
    while i < n {
        if _byte_at(src, pos + i) != lit_bytes[i] { return 0 }
        i = i + 1
    }
    return 1
}

fn _parse_string(src, pos) {
    var n = oren_string_len(src)
    if pos >= n { return _err("unexpected EOF", pos) }
    if _byte_at(src, pos) != 34 { return _err("expected '\"'", pos) }
    pos = pos + 1

    var out = raw.u8_new_uninit(n - pos)
    if oren_is_err(out) { return _err("string buffer allocation failed", pos) }
    var out_pos = 0
    while pos < n {
        var ch = _byte_at(src, pos)
        if ch == 34 {
            // closing quote
            pos = pos + 1
            var s = oren_string_from_bytes_slice(out, 0, out_pos)
            if s == nil { return _err("string_from_bytes failed", pos) }
            return _ok(jstring(s), pos)
        }
        if ch == 92 {
            // escape
            pos = pos + 1
            if pos >= n { return _err("unexpected EOF in escape", pos) }
            var e = _byte_at(src, pos)
            if e == 34 { out_pos = _buf_put_u8(out, out_pos, 34) }
            else {
                if e == 92 { out_pos = _buf_put_u8(out, out_pos, 92) }
                else {
                    if e == 47 { out_pos = _buf_put_u8(out, out_pos, 47) }
                    else {
                        if e == 98 { out_pos = _buf_put_u8(out, out_pos, 8) }    // \b
                        else {
                            if e == 102 { out_pos = _buf_put_u8(out, out_pos, 12) }  // \f
                            else {
                                if e == 110 { out_pos = _buf_put_u8(out, out_pos, 10) }  // \n
                                else {
                                    if e == 114 { out_pos = _buf_put_u8(out, out_pos, 13) }  // \r
                                    else {
                                        if e == 116 { out_pos = _buf_put_u8(out, out_pos, 9) }   // \t
                                        else {
                                            if e == 117 {
                                                // \uXXXX not supported in rolling v0 (no unicode scalar model yet).
                                                return _err("unsupported escape: \\uXXXX", pos)
                                            } else {
                                                return _err("invalid escape sequence", pos)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            pos = pos + 1
        } else {
            // raw byte (UTF-8 passthrough)
            out_pos = _buf_put_u8(out, out_pos, ch)
            pos = pos + 1
        }
    }
    return _err("unexpected EOF in string", pos)
}

fn _parse_int(src, pos) {
    var n = oren_string_len(src)
    if pos >= n { return _err("unexpected EOF", pos) }

    var neg = 0
    if _byte_at(src, pos) == 45 {
        neg = 1
        pos = pos + 1
        if pos >= n { return _err("expected digit after '-'", pos) }
    }

    var any = 0
    var v = 0
    while pos < n {
        var b = _byte_at(src, pos)
        if b < 48 || b > 57 { break }
        any = 1
        v = v * 10 + (b - 48)
        pos = pos + 1
    }
    if any == 0 { return _err("expected digit", pos) }
    if neg == 1 { v = -v }
    return _ok(jint(v), pos)
}

fn _parse_array(src, pos) {
    var n = oren_string_len(src)
    if pos >= n { return _err("unexpected EOF", pos) }
    if _byte_at(src, pos) != 91 { return _err("expected '['", pos) }
    pos = pos + 1
    pos = _skip_ws(src, pos)

    var items = []
    if pos < n && _byte_at(src, pos) == 93 {
        return _ok(jarray(items), pos + 1)
    }

    while 1 {
        pos = _skip_ws(src, pos)
        var r = _parse_value(src, pos)
        if r["ok"] != 1 { return r }
        list.push(items, r["v"])
        pos = _skip_ws(src, r["pos"])
        if pos >= n { return _err("unexpected EOF in array", pos) }
        if _byte_at(src, pos) == 44 {
            pos = pos + 1
            continue
        }
        if _byte_at(src, pos) == 93 {
            pos = pos + 1
            return _ok(jarray(items), pos)
        }
        return _err("expected ',' or ']'", pos)
    }
    return _err("unreachable", pos)
}

fn _parse_object(src, pos) {
    var n = oren_string_len(src)
    if pos >= n { return _err("unexpected EOF", pos) }
    if _byte_at(src, pos) != 123 { return _err("expected '{'", pos) }
    pos = pos + 1
    pos = _skip_ws(src, pos)

    var obj = {}
    if pos < n && _byte_at(src, pos) == 125 {
        return _ok(jobject(obj), pos + 1)
    }

    while 1 {
        pos = _skip_ws(src, pos)
        var rk = _parse_string(src, pos)
        if rk["ok"] != 1 { return rk }
        var k = rk["v"].s
        pos = _skip_ws(src, rk["pos"])
        if pos >= n { return _err("unexpected EOF in object", pos) }
        if _byte_at(src, pos) != 58 { return _err("expected ':'", pos) }
        pos = pos + 1
        pos = _skip_ws(src, pos)
        var rv = _parse_value(src, pos)
        if rv["ok"] != 1 { return rv }
        // JSON object keys are always strings.
        oren_map_set_str(obj, k, rv["v"])
        pos = _skip_ws(src, rv["pos"])
        if pos >= n { return _err("unexpected EOF in object", pos) }
        if _byte_at(src, pos) == 44 {
            pos = pos + 1
            continue
        }
        if _byte_at(src, pos) == 125 {
            pos = pos + 1
            return _ok(jobject(obj), pos)
        }
        return _err("expected ',' or '}'", pos)
    }
    return _err("unreachable", pos)
}

fn _parse_value(src, pos) {
    var n = oren_string_len(src)
    pos = _skip_ws(src, pos)
    if pos >= n { return _err("unexpected EOF", pos) }
    var b = _byte_at(src, pos)

    if b == 34 { return _parse_string(src, pos) }
    if b == 91 { return _parse_array(src, pos) }
    if b == 123 { return _parse_object(src, pos) }
    if b == 45 { return _parse_int(src, pos) }
    if b >= 48 && b <= 57 { return _parse_int(src, pos) }

    // Literals: true/false/null
    if b == 116 { // 't'
        var lit = [116, 114, 117, 101] // true
        if pos + 4 <= n && _match_lit(src, pos, lit) == 1 {
            return _ok(jbool(1), pos + 4)
        }
        return _err("invalid literal", pos)
    }
    if b == 102 { // 'f'
        var lit2 = [102, 97, 108, 115, 101] // false
        if pos + 5 <= n && _match_lit(src, pos, lit2) == 1 {
            return _ok(jbool(0), pos + 5)
        }
        return _err("invalid literal", pos)
    }
    if b == 110 { // 'n'
        var lit3 = [110, 117, 108, 108] // null
        if pos + 4 <= n && _match_lit(src, pos, lit3) == 1 {
            return _ok(jnull(), pos + 4)
        }
        return _err("invalid literal", pos)
    }

    return _err("unexpected token", pos)
}

fn decode(s) {
    if s == nil { s = "" }
    var r = _parse_value(s, 0)
    if r["ok"] != 1 { return r }
    var pos = _skip_ws(s, r["pos"])
    if pos != oren_string_len(s) {
        return _err("trailing input", pos)
    }
    return r
}

fn parse(s): JsonValue {
    var r = decode(s)
    if r["ok"] == 1 { return r["v"] }
    var msg = r["err"]
    if msg == nil || msg == "" { msg = "json decode failed" }
    return oren_err(4, msg)
}

fn _escape_string(s) {
    var n = oren_string_len(s)
    var out = raw.u8_new_uninit(n * 2)
    if oren_is_err(out) { return out }
    var out_pos = 0
    var i = 0
    while i < n {
        var b = _byte_at(s, i)
        if b == 34 { // "
            out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 34)
        } else {
            if b == 92 { // \
                out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 92)
            } else {
                if b == 10 { // \n
                    out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 110)
                } else {
                    if b == 13 { // \r
                        out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 114)
                    } else {
                        if b == 9 { // \t
                            out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 116)
                        } else {
                            // pass through raw byte (UTF-8)
                            out_pos = _buf_put_u8(out, out_pos, b)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return oren_string_from_bytes_slice(out, 0, out_pos)
}

fn encode(jv) {
    var t = jv.t
    if _streq(t, "null") { return "null" }
    if _streq(t, "bool") {
        if jv.b != 0 { return "true" }
        return "false"
    }
    if _streq(t, "int") {
        return oren_int_to_string(jv.i)
    }
    if _streq(t, "string") {
        return "\"" + _escape_string(jv.s) + "\""
    }
    if _streq(t, "array") {
        var a = jv.a
        var out = "["
        var i = 0
        var n = list.len(a)
        while i < n {
            if i > 0 { out = out + "," }
            out = out + encode(a[i])
            i = i + 1
        }
        out = out + "]"
        return out
    }
    if _streq(t, "object") {
        var o = jv.o
        var out2 = "{"
        var first = 1
        for k in o {
            if first != 1 { out2 = out2 + "," }
            first = 0
            out2 = out2 + "\"" + _escape_string(k) + "\":" + encode(oren_map_get_str(o, k))
        }
        out2 = out2 + "}"
        return out2
    }
    // Unknown tag: encode as null (rolling safety).
    return "null"
}

fn text(jv: JsonValue) { return encode(jv) }

impl JsonText for string {
    fn json(self): JsonValue { return parse(self) }
}

impl JsonValueCodec for JsonValue {
    fn text(self) { return encode(self) }
}
