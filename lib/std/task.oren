// std/task.oren
//
// Safe facade for generic language-level `spawn` handles.
//
// Rolling scope:
// - wraps the existing `spawn` / `oren_join(_timeout)` / `oren_detach` runtime surface
// - adds a safe reflected predicate (`is_handle`) before destructive operations
// - supports the default scheduler-backed task handles on native, plus AVM/C task handles
// - exposes cooperative cancel-request state plus bounded cancel/stop policy for generic task handles
// - immediate cancel/stop execution is runtime-owned through `oren_task_cancel_now(...)`; bounded
//   and delayed synchronous cancel waits are runtime/scheduler-owned on C, native, and AVM
// - `stop_capabilities()` exposes that runtime boundary as a stable, testable feature contract
// - legacy native raw fallback handles (fork / Windows thread fallback) still use the low-level
//   raw helpers directly and are not yet reflected by `is_handle(...)`

import list "std:list"
import time "std:time"

fn _task_err(ctx, msg) {
    return oren_err(4, ctx + ": " + msg)
}

fn _task_handle_ok(handle) {
    return oren_task_is_handle(handle) == true
}

fn _task_is_int(v) { return oren_type_tag(v) == 1 }
fn _task_is_string(v) { return oren_type_tag(v) == 4 }

fn _task_timeout_ms(ctx, timeout_ms) {
    if oren_type_tag(timeout_ms) == 0 { return -1 }
    if _task_is_int(timeout_ms) != true {
        return _task_err(ctx, "expected int timeout_ms")
    }
    return timeout_ms
}

fn _task_policy_map(ctx, policy) {
    if oren_type_tag(policy) == 0 { return {} }
    if oren_type_name(policy) != "map" {
        return _task_err(ctx, "expected map policy")
    }
    return policy
}

fn _task_stop_mode(ctx, mode0) {
    if oren_type_tag(mode0) == 0 { return "stop" }
    if _task_is_string(mode0) != true {
        return _task_err(ctx, "expected string mode")
    }
    var mode = mode0
    if mode == "request" { mode = "request_cancel" }
    if mode != "stop" && mode != "request_cancel" && mode != "cancel" {
        return _task_err(ctx, "task handles support mode=request_cancel|cancel|stop")
    }
    return mode
}

fn _task_stop_timeout_ms(ctx, timeout_ms) {
    if oren_type_tag(timeout_ms) == 0 { return 0 }
    if _task_is_int(timeout_ms) != true {
        return _task_err(ctx, "expected int timeout_ms")
    }
    if timeout_ms < 0 { return 0 }
    return timeout_ms
}

fn _task_stop_deadline_ns_arg(ctx, deadline_ns) {
    if oren_type_tag(deadline_ns) == 0 { return nil }
    if _task_is_int(deadline_ns) != true {
        return _task_err(ctx, "expected int deadline_ns")
    }
    return deadline_ns
}

fn _task_stop_grace_ms(ctx, grace_ms) {
    if oren_type_tag(grace_ms) == 0 { return 0 }
    if _task_is_int(grace_ms) != true {
        return _task_err(ctx, "expected int grace_ms")
    }
    if grace_ms < 0 { return 0 }
    return grace_ms
}

fn _task_stop_delay_ms(deadline_ns, timeout_ms) {
    if oren_type_tag(deadline_ns) == 0 { return timeout_ms }
    var now_ns = time.now_ns()
    if now_ns == 0 { return 0 }
    var delta_ns = deadline_ns - now_ns
    if delta_ns <= 0 { return 0 }
    var delay_ms = delta_ns / 1000000
    if delay_ms <= 0 { return 0 }
    if delay_ms > 2147483647 { return 2147483647 }
    return delay_ms
}

fn _task_stop_join_timeout_arg(ctx, join_timeout_ms) {
    if oren_type_tag(join_timeout_ms) == 0 { return nil }
    if _task_is_int(join_timeout_ms) != true {
        return _task_err(ctx, "expected int join_timeout_ms")
    }
    return join_timeout_ms
}

fn _task_stop_wait_ms(delay_ms, grace_ms) {
    var total = delay_ms + grace_ms
    if total < delay_ms || total < grace_ms || total < 0 { return 2147483647 }
    return total
}

fn _task_stop_wait_budget_ms(ctx, join_timeout_ms, default_wait_ms) {
    if oren_type_tag(join_timeout_ms) == 0 { return default_wait_ms }
    if _task_is_int(join_timeout_ms) != true {
        return _task_err(ctx, "expected int join_timeout_ms")
    }
    if join_timeout_ms < 0 { return default_wait_ms }
    return join_timeout_ms
}

fn _task_request_wait_default_ms(delay_ms) {
    var total = delay_ms + 2000
    if total < delay_ms || total < 0 { return 2147483647 }
    return total
}

fn _task_stop_fields(ctx, policy0, want_join_timeout) {
    var policy = _task_policy_map(ctx, policy0)
    if oren_is_err(policy) == true { return policy }
    var mode = _task_stop_mode(ctx, oren_map_get_str(policy, "mode"))
    if oren_is_err(mode) == true { return mode }
    var timeout_ms = oren_map_get_str(policy, "timeout_ms")
    var deadline_ns = oren_map_get_str(policy, "deadline_ns")
    if oren_type_tag(timeout_ms) != 0 && oren_type_tag(deadline_ns) != 0 {
        return _task_err(ctx, "timeout_ms and deadline_ns are mutually exclusive")
    }
    timeout_ms = _task_stop_timeout_ms(ctx, timeout_ms)
    if oren_is_err(timeout_ms) == true { return timeout_ms }
    deadline_ns = _task_stop_deadline_ns_arg(ctx, deadline_ns)
    if oren_is_err(deadline_ns) == true { return deadline_ns }
    var grace_ms = _task_stop_grace_ms(ctx, oren_map_get_str(policy, "grace_ms"))
    if oren_is_err(grace_ms) == true { return grace_ms }
    if mode != "stop" && grace_ms > 0 {
        return _task_err(ctx, "grace_ms is only valid for mode=stop")
    }
    var join_timeout_ms = nil
    if want_join_timeout == true {
        join_timeout_ms = _task_stop_join_timeout_arg(ctx, oren_map_get_str(policy, "join_timeout_ms"))
        if oren_is_err(join_timeout_ms) == true { return join_timeout_ms }
    }
    return {
        "mode": mode,
        "delay_ms": _task_stop_delay_ms(deadline_ns, timeout_ms),
        "deadline_ns": deadline_ns,
        "grace_ms": grace_ms,
        "reason": oren_map_get_str(policy, "reason"),
        "join_timeout_ms": join_timeout_ms,
    }
}

fn _task_stop_result(status, result, reason, detach_result) {
    return {
        "status": status,
        "result": result,
        "reason": reason,
        "detach_result": detach_result,
    }
}

fn _task_stop_handle(handle, wait_ms, reason) {
    var rv = join_timeout(handle, wait_ms)
    if oren_is_err(rv) == true { return rv }
    var timeout_rv = _task_timeout_detach_result(handle, rv, reason)
    if timeout_rv != nil { return timeout_rv }
    return _task_stop_result("joined", rv, reason, nil)
}

fn _task_timeout_detach_result(handle, rv, reason) {
    if rv != -60 { return nil }
    var detach_rv = nil
    if is_handle(handle) == true {
        detach_rv = detach(handle)
        if oren_is_err(detach_rv) == true {
            return _task_stop_result("detach_error", rv, reason, detach_rv)
        }
    }
    return _task_stop_result("detached", rv, reason, detach_rv)
}

fn _task_request_then_stop_handle(handle, wait_ms, reason) {
    if wait_ms == 0 {
        return oren_task_cancel_now(handle, reason)
    }
    if wait_ms > 0 {
        if _task_stop_capability("bounded_wait_native_call") == true {
            return oren_task_cancel_wait(handle, wait_ms, reason)
        }
    }
    if is_done(handle) != true {
        var rv0 = request_cancel(handle, reason)
        if oren_is_err(rv0) == true { return rv0 }
    }
    return _task_stop_handle(handle, wait_ms, reason)
}

fn _task_stop_capability(name) {
    var caps = stop_capabilities()
    return oren_type_name(caps) == "map" && caps[name] == true
}

fn _task_can_use_delayed_native_wait(delay_ms, join_timeout_ms) {
    if delay_ms <= 0 { return false }
    if _task_stop_capability("delayed_wait_native_call") != true { return false }
    if oren_type_tag(join_timeout_ms) == 0 { return true }
    if join_timeout_ms < 0 { return true }
    return join_timeout_ms >= delay_ms
}

fn _task_stop_after_worker(handle, delay_ms, wait_ms, reason) {
    if delay_ms > 0 { time.sleep_ms(delay_ms) }
    return _task_request_then_stop_handle(handle, wait_ms, reason)
}

fn _task_request_cancel_after_worker(handle, timeout_ms, reason) {
    if timeout_ms > 0 { time.sleep_ms(timeout_ms) }
    return request_cancel(handle, reason)
}

fn _task_nil_worker(_) {
    time.sleep_ms(1)
    return nil
}

fn is_handle(handle) {
    return oren_task_is_handle(handle)
}

fn is_done(handle) {
    return oren_task_is_done(handle)
}

fn current() {
    return oren_task_current_handle()
}

fn stop_capabilities() {
    return oren_task_stop_capabilities()
}

fn request_cancel(handle, reason) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.request_cancel", "expected task handle")
    }
    return oren_task_request_cancel(handle, reason)
}

fn is_cancel_requested(handle) {
    return oren_task_is_cancel_requested(handle)
}

fn cancel_reason(handle) {
    return oren_task_cancel_reason(handle)
}

fn join(handle) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.join", "expected task handle")
    }
    return oren_join(handle)
}

fn join_timeout(handle, timeout_ms) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.join_timeout", "expected task handle")
    }
    var wait_ms = _task_timeout_ms("task.join_timeout", timeout_ms)
    if oren_is_err(wait_ms) == true { return wait_ms }
    return oren_join_timeout(handle, wait_ms)
}

fn detach(handle) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.detach", "expected task handle")
    }
    oren_detach(handle)
    return nil
}

fn join_all(handles, timeout_ms) {
    if oren_type_name(handles) != "list" {
        return _task_err("task.join_all", "expected list handles")
    }
    var wait_ms = _task_timeout_ms("task.join_all", timeout_ms)
    if oren_is_err(wait_ms) == true { return wait_ms }
    var out = []
    var i = 0
    var n = list.len(handles)
    while i < n {
        var handle = handles[i]
        if _task_handle_ok(handle) != true {
            return _task_err("task.join_all", "expected task handle")
        }
        list.push(out, oren_join_timeout(handle, wait_ms))
        i = i + 1
    }
    return out
}

fn request_cancel_after(handle, timeout_ms, reason) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.request_cancel_after", "expected task handle")
    }
    var delay_ms = _task_stop_timeout_ms("task.request_cancel_after", timeout_ms)
    if oren_is_err(delay_ms) == true { return delay_ms }
    if delay_ms <= 0 {
        var rv0 = request_cancel(handle, reason)
        if oren_is_err(rv0) == true { return rv0 }
        return spawn _task_nil_worker(nil)
    }
    return spawn _task_request_cancel_after_worker(handle, delay_ms, reason)
}

fn cancel(handle, reason) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.cancel", "expected task handle")
    }
    return _task_request_then_stop_handle(handle, 0, reason)
}

fn cancel_after(handle, timeout_ms, reason) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.cancel_after", "expected task handle")
    }
    var delay_ms = _task_stop_timeout_ms("task.cancel_after", timeout_ms)
    if oren_is_err(delay_ms) == true { return delay_ms }
    var watcher = spawn _task_stop_after_worker(handle, delay_ms, 0, reason)
    if _task_handle_ok(watcher) != true {
        return _task_err("task.cancel_after", "failed to spawn cancel watcher")
    }
    return watcher
}

fn cancel_after_wait(handle, timeout_ms, reason, join_timeout_ms) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.cancel_after_wait", "expected task handle")
    }
    var delay = _task_stop_timeout_ms("task.cancel_after_wait", timeout_ms)
    if oren_is_err(delay) == true { return delay }
    if delay <= 0 {
        var immediate_wait = _task_stop_wait_budget_ms("task.cancel_after_wait", join_timeout_ms, 0)
        if oren_is_err(immediate_wait) == true { return immediate_wait }
        return _task_request_then_stop_handle(handle, immediate_wait, reason)
    }
    var wait = _task_stop_wait_budget_ms("task.cancel_after_wait", join_timeout_ms, _task_request_wait_default_ms(delay))
    if oren_is_err(wait) == true { return wait }
    if _task_can_use_delayed_native_wait(delay, join_timeout_ms) == true {
        return oren_task_cancel_after_wait(handle, delay, 0, reason)
    }
    var watcher = cancel_after(handle, delay, reason)
    if oren_is_err(watcher) == true { return watcher }
    var rv = join_timeout(watcher, wait)
    if oren_is_err(rv) == true { return rv }
    var timeout_rv = _task_timeout_detach_result(watcher, rv, reason)
    if timeout_rv != nil { return timeout_rv }
    return rv
}

fn request_cancel_after_wait(handle, timeout_ms, reason, join_timeout_ms) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.request_cancel_after_wait", "expected task handle")
    }
    var delay = _task_stop_timeout_ms("task.request_cancel_after_wait", timeout_ms)
    if oren_is_err(delay) == true { return delay }
    if delay <= 0 { return request_cancel(handle, reason) }
    var wait = _task_stop_wait_budget_ms("task.request_cancel_after_wait", join_timeout_ms, _task_request_wait_default_ms(delay))
    if oren_is_err(wait) == true { return wait }
    return join_timeout(request_cancel_after(handle, delay, reason), wait)
}

fn request_cancel_at(handle, deadline_ns, reason) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.request_cancel_at", "expected task handle")
    }
    var deadline = _task_stop_deadline_ns_arg("task.request_cancel_at", deadline_ns)
    if oren_is_err(deadline) == true { return deadline }
    var delay = _task_stop_delay_ms(deadline, 0)
    return request_cancel_after(handle, delay, reason)
}

fn cancel_at(handle, deadline_ns, reason) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.cancel_at", "expected task handle")
    }
    var deadline = _task_stop_deadline_ns_arg("task.cancel_at", deadline_ns)
    if oren_is_err(deadline) == true { return deadline }
    var delay = _task_stop_delay_ms(deadline, 0)
    return cancel_after(handle, delay, reason)
}

fn cancel_at_wait(handle, deadline_ns, reason, join_timeout_ms) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.cancel_at_wait", "expected task handle")
    }
    var deadline = _task_stop_deadline_ns_arg("task.cancel_at_wait", deadline_ns)
    if oren_is_err(deadline) == true { return deadline }
    var delay = _task_stop_delay_ms(deadline, 0)
    return cancel_after_wait(handle, delay, reason, join_timeout_ms)
}

fn request_cancel_at_wait(handle, deadline_ns, reason, join_timeout_ms) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.request_cancel_at_wait", "expected task handle")
    }
    var deadline = _task_stop_deadline_ns_arg("task.request_cancel_at_wait", deadline_ns)
    if oren_is_err(deadline) == true { return deadline }
    var delay = _task_stop_delay_ms(deadline, 0)
    if delay <= 0 { return request_cancel(handle, reason) }
    var wait = _task_stop_wait_budget_ms("task.request_cancel_at_wait", join_timeout_ms, _task_request_wait_default_ms(delay))
    if oren_is_err(wait) == true { return wait }
    return join_timeout(request_cancel_at(handle, deadline, reason), wait)
}

fn stop_after(handle, timeout_ms, grace_ms, reason) {
    return stop_policy(handle, {
        "mode": "stop",
        "timeout_ms": timeout_ms,
        "grace_ms": grace_ms,
        "reason": reason,
    })
}

fn stop_after_wait(handle, timeout_ms, grace_ms, reason, join_timeout_ms) {
    return stop_policy_wait(handle, {
        "mode": "stop",
        "timeout_ms": timeout_ms,
        "grace_ms": grace_ms,
        "reason": reason,
        "join_timeout_ms": join_timeout_ms,
    })
}

fn stop_at(handle, deadline_ns, grace_ms, reason) {
    return stop_policy(handle, {
        "mode": "stop",
        "deadline_ns": deadline_ns,
        "grace_ms": grace_ms,
        "reason": reason,
    })
}

fn stop_at_wait(handle, deadline_ns, grace_ms, reason, join_timeout_ms) {
    return stop_policy_wait(handle, {
        "mode": "stop",
        "deadline_ns": deadline_ns,
        "grace_ms": grace_ms,
        "reason": reason,
        "join_timeout_ms": join_timeout_ms,
    })
}

fn stop_policy(handle, policy0) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.stop_policy", "expected task handle")
    }
    var fields = _task_stop_fields("task.stop_policy", policy0, false)
    if oren_is_err(fields) == true { return fields }
    if fields["mode"] == "request_cancel" {
        if oren_type_tag(fields["deadline_ns"]) != 0 {
            return request_cancel_at(handle, fields["deadline_ns"], fields["reason"])
        }
        return request_cancel_after(handle, fields["delay_ms"], fields["reason"])
    }
    if fields["mode"] == "cancel" {
        if oren_type_tag(fields["deadline_ns"]) != 0 {
            return cancel_at(handle, fields["deadline_ns"], fields["reason"])
        }
        return cancel_after(handle, fields["delay_ms"], fields["reason"])
    }
    var watcher = spawn _task_stop_after_worker(handle, fields["delay_ms"], fields["grace_ms"], fields["reason"])
    if _task_handle_ok(watcher) != true {
        return _task_err("task.stop_policy", "failed to spawn stop watcher")
    }
    return watcher
}

fn stop_policy_wait(handle, policy0) {
    if _task_handle_ok(handle) != true {
        return _task_err("task.stop_policy_wait", "expected task handle")
    }
    var fields = _task_stop_fields("task.stop_policy_wait", policy0, true)
    if oren_is_err(fields) == true { return fields }
    if fields["mode"] == "request_cancel" {
        if oren_type_tag(fields["deadline_ns"]) != 0 {
            return request_cancel_at_wait(handle, fields["deadline_ns"], fields["reason"], fields["join_timeout_ms"])
        }
        return request_cancel_after_wait(handle, fields["delay_ms"], fields["reason"], fields["join_timeout_ms"])
    }
    if fields["mode"] == "cancel" {
        if oren_type_tag(fields["deadline_ns"]) != 0 {
            return cancel_at_wait(handle, fields["deadline_ns"], fields["reason"], fields["join_timeout_ms"])
        }
        return cancel_after_wait(handle, fields["delay_ms"], fields["reason"], fields["join_timeout_ms"])
    }
    var wait_ms = _task_stop_wait_budget_ms(
        "task.stop_policy_wait",
        fields["join_timeout_ms"],
        _task_stop_wait_ms(fields["delay_ms"], fields["grace_ms"])
    )
    if oren_is_err(wait_ms) == true { return wait_ms }
    var target_wait_ms = fields["grace_ms"]
    if oren_type_tag(fields["join_timeout_ms"]) != 0 && fields["join_timeout_ms"] >= 0 {
        if wait_ms <= fields["delay_ms"] {
            target_wait_ms = 0
        } else {
            target_wait_ms = wait_ms - fields["delay_ms"]
        }
    }
    var watcher_wait_ms = wait_ms
    if oren_type_tag(fields["join_timeout_ms"]) == 0 || fields["join_timeout_ms"] < 0 {
        watcher_wait_ms = _task_request_wait_default_ms(wait_ms)
    }
    if _task_can_use_delayed_native_wait(fields["delay_ms"], fields["join_timeout_ms"]) == true {
        return oren_task_cancel_after_wait(handle, fields["delay_ms"], target_wait_ms, fields["reason"])
    }
    var watcher = spawn _task_stop_after_worker(handle, fields["delay_ms"], target_wait_ms, fields["reason"])
    if _task_handle_ok(watcher) != true {
        return _task_err("task.stop_policy_wait", "failed to spawn stop watcher")
    }
    var rv = join_timeout(watcher, watcher_wait_ms)
    if oren_is_err(rv) == true { return rv }
    var timeout_rv = _task_timeout_detach_result(watcher, rv, fields["reason"])
    if timeout_rv != nil { return timeout_rv }
    if oren_type_name(rv) != "map" {
        return _task_err("task.stop_policy_wait", "stop watcher returned invalid result")
    }
    return rv
}
