// Minimal assert helpers (stdlib; rolling).
//
// Usage:
//   import assert "std:assert"
//   assert.assert(cond, "message")
//   assert.assert_eq(a, b, "message")
//
// Notes:
// - This is a lightweight stdlib helper while built-in `assert`/`test` are still planned.
// - Pass nil or "" for msg if you want a generic failure line.

fn _assert_fail(prefix, msg) {
    var out = prefix
    if msg != nil && msg != "" { out = out + msg }
    oren_fail(1, out)
    return 0
}

fn assert(cond, msg) {
    if cond { return 0 }
    _assert_fail("assert failed: ", msg)
    return 0
}

fn assert_eq(a, b, msg) {
    if a == b { return 0 }
    _assert_fail("assert_eq failed: ", msg)
    return 0
}

fn assert_ne(a, b, msg) {
    if a != b { return 0 }
    _assert_fail("assert_ne failed: ", msg)
    return 0
}

fn assert_streq(a, b, msg) {
    if strcmp(a, b) == 0 { return 0 }
    _assert_fail("assert_streq failed: ", msg)
    return 0
}

fn assert_err(v, msg) {
    if oren_is_err(v) { return 0 }
    _assert_fail("assert_err failed: ", msg)
    return 0
}

fn assert_ok(v, msg) {
    if oren_is_err(v) { _assert_fail("assert_ok failed: ", msg) }
    return v
}
