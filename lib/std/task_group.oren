// std/task_group.oren
//
// First structured-concurrency group layer above the current generator/coroutine
// stop-policy helpers.
//
// Scope:
// - owns a mutable list of generator/coroutine handles, active contexts, or safe generic task handles
// - optionally owns a default stop-policy map, including for runtime-backed task-only groups
// - applies the shipped per-handle `std:generator.stop_policy(...)` /
//   `stop_policy_wait(...)` plus the safe `std:task.stop_policy(...)` /
//   `stop_policy_wait(...)` surface across runtime-classified members by kind
// - exposes watcher-list joins, task joins, and final terminal-result collection
// - runtime-backed task groups now own stored default policy and atomic member/kind/policy snapshots for mixed task/generator members
//
// Non-goals (still rolling):
// - implicit parent/child task lifetime enforcement
// - unsafe preemptive killing of generic `spawn` workers
// - moving generator/coroutine stop execution fully into the runtime scheduler instead of this stdlib policy layer

import gen "std:generator"
import list "std:list"
import task "std:task"

fn _task_group_surface() { return "task_group_v1" }

fn _task_group_err(ctx, msg) {
    return oren_err(4, ctx + ": " + msg)
}

fn _task_group_target_kind(target) {
    var name = oren_type_name(target)
    if name == "generator" || name == "generator_context" { return name }
    if oren_task_is_handle(target) == true { return "task" }
    return nil
}

fn _task_group_runtime_add_target(ctx, group, target) {
    var rv = oren_task_group_add(group, target)
    if oren_is_err(rv) == true { return rv }
    if oren_type_tag(rv) == 0 {
        return _task_group_err(ctx, "failed to add target to runtime task group")
    }
    return group
}

fn _task_group_runtime_default_policy(ctx, group) {
    var policy = oren_task_group_default_policy(group)
    if oren_is_err(policy) == true { return policy }
    if oren_type_tag(policy) == 0 { return {} }
    return _task_group_copy_policy(ctx, policy)
}

fn _task_group_runtime_set_default_policy(ctx, group, policy0) {
    var policy = _task_group_copy_policy(ctx, policy0)
    if oren_is_err(policy) == true { return policy }
    var rv = oren_task_group_set_default_policy(group, policy)
    if oren_is_err(rv) == true { return rv }
    if oren_type_name(rv) != "map" {
        return _task_group_err(ctx, "expected runtime task group handle")
    }
    return policy
}

fn _task_group_policy_map(ctx, policy) {
    if oren_type_tag(policy) == 0 { return {} }
    if oren_type_name(policy) != "map" {
        return _task_group_err(ctx, "expected map policy")
    }
    return policy
}

fn _task_group_copy_policy(ctx, policy0) {
    var policy = _task_group_policy_map(ctx, policy0)
    if oren_is_err(policy) == true { return policy }
    return {
        "mode": oren_map_get_str(policy, "mode"),
        "timeout_ms": oren_map_get_str(policy, "timeout_ms"),
        "deadline_ns": oren_map_get_str(policy, "deadline_ns"),
        "grace_ms": oren_map_get_str(policy, "grace_ms"),
        "reason": oren_map_get_str(policy, "reason"),
        "join_timeout_ms": oren_map_get_str(policy, "join_timeout_ms"),
    }
}

fn _task_group_merge_policy(ctx, base0, override0) {
    var merged = _task_group_copy_policy(ctx, base0)
    if oren_is_err(merged) == true { return merged }
    var override = _task_group_policy_map(ctx, override0)
    if oren_is_err(override) == true { return override }
    var keys = ["mode", "timeout_ms", "deadline_ns", "grace_ms", "reason", "join_timeout_ms"]
    var i = 0
    while i < 6 {
        var key = keys[i]
        var value = oren_map_get_str(override, key)
        if oren_type_tag(value) != 0 {
            oren_map_set_str(merged, key, value)
        }
        i = i + 1
    }
    return merged
}

fn _task_group_validate_policy_shape(ctx, policy0) {
    var policy = _task_group_policy_map(ctx, policy0)
    if oren_is_err(policy) == true { return policy }
    var mode = oren_map_get_str(policy, "mode")
    if oren_type_tag(mode) == 0 {
        mode = "stop"
    } else {
        if oren_type_tag(mode) != 4 {
            return _task_group_err(ctx, "expected string mode")
        }
        if mode == "request" { mode = "request_cancel" }
        if mode != "stop" && mode != "request_cancel" && mode != "cancel" {
            return _task_group_err(ctx, "expected mode request_cancel|cancel|stop")
        }
    }
    var timeout_ms = oren_map_get_str(policy, "timeout_ms")
    var deadline_ns = oren_map_get_str(policy, "deadline_ns")
    if oren_type_tag(timeout_ms) != 0 && oren_type_tag(timeout_ms) != 1 {
        return _task_group_err(ctx, "expected int timeout_ms")
    }
    if oren_type_tag(deadline_ns) != 0 && oren_type_tag(deadline_ns) != 1 {
        return _task_group_err(ctx, "expected int deadline_ns")
    }
    if oren_type_tag(timeout_ms) != 0 && oren_type_tag(deadline_ns) != 0 {
        return _task_group_err(ctx, "timeout_ms and deadline_ns are mutually exclusive")
    }
    var grace_ms = oren_map_get_str(policy, "grace_ms")
    if oren_type_tag(grace_ms) != 0 {
        if oren_type_tag(grace_ms) != 1 {
            return _task_group_err(ctx, "expected int grace_ms")
        }
        if mode != "stop" && grace_ms > 0 {
            return _task_group_err(ctx, "grace_ms is only valid for mode=stop")
        }
    }
    var join_timeout_ms = oren_map_get_str(policy, "join_timeout_ms")
    if oren_type_tag(join_timeout_ms) != 0 && oren_type_tag(join_timeout_ms) != 1 {
        return _task_group_err(ctx, "expected int join_timeout_ms")
    }
    return nil
}

fn _task_group_members_ref(ctx, group) {
    if oren_type_name(group) != "map" {
        return _task_group_err(ctx, "expected task group map")
    }
    if oren_map_get_str(group, "__task_group_surface") != _task_group_surface() {
        return _task_group_err(ctx, "expected task group surface " + _task_group_surface())
    }
    var members = oren_map_get_str(group, "members")
    if oren_type_name(members) != "list" {
        return _task_group_err(ctx, "group members must be list")
    }
    var policy = oren_map_get_str(group, "default_policy")
    if oren_type_tag(policy) != 0 && oren_type_name(policy) != "map" {
        return _task_group_err(ctx, "default_policy must be map")
    }
    return members
}

fn _task_group_join_timeout_ms(ctx, join_timeout_ms) {
    if oren_type_tag(join_timeout_ms) == 0 { return 2000 }
    if oren_type_tag(join_timeout_ms) != 1 {
        return _task_group_err(ctx, "expected int join_timeout_ms")
    }
    if join_timeout_ms < 0 { return 2000 }
    return join_timeout_ms
}

fn _task_group_target_stop_watch_kind(ctx, kind, target, policy0) {
    if kind != "task" && kind != "generator" && kind != "generator_context" {
        return _task_group_err(ctx, "expected runtime member kind")
    }
    if kind == "task" { return task.stop_policy(target, policy0) }
    return gen.stop_policy(target, policy0)
}

fn _task_group_target_stop_wait_kind(ctx, kind, target, policy0) {
    if kind != "task" && kind != "generator" && kind != "generator_context" {
        return _task_group_err(ctx, "expected runtime member kind")
    }
    if kind == "task" { return task.stop_policy_wait(target, policy0) }
    return gen.stop_policy_wait(target, policy0)
}

fn _task_group_runtime_snapshot(ctx, group) {
    return _task_group_runtime_snapshot_from_raw(ctx, oren_task_group_snapshot(group))
}

fn _task_group_runtime_take_snapshot(ctx, group) {
    return _task_group_runtime_snapshot_from_raw(ctx, oren_task_group_take_snapshot(group))
}

fn _task_group_runtime_snapshot_from_raw(ctx, snapshot) {
    if oren_is_err(snapshot) == true { return snapshot }
    if oren_type_name(snapshot) != "list" || oren_list_len(snapshot) != 3 {
        return _task_group_err(ctx, "runtime snapshot must be [members, kinds, default_policy]")
    }
    var refs = snapshot[0]
    var kinds = snapshot[1]
    if oren_type_name(refs) != "list" || oren_type_name(kinds) != "list" {
        return _task_group_err(ctx, "runtime snapshot member fields must be lists")
    }
    if oren_list_len(refs) != oren_list_len(kinds) {
        return _task_group_err(ctx, "runtime snapshot member-kind mismatch")
    }
    var policy = _task_group_copy_policy(ctx, snapshot[2])
    if oren_is_err(policy) == true { return policy }
    return {
        "members": refs,
        "member_kinds": kinds,
        "default_policy": policy,
    }
}

fn _task_group_map_snapshot(ctx, group) {
    var refs = _task_group_members_ref(ctx, group)
    if oren_is_err(refs) == true { return refs }
    var kinds = _task_group_kinds_for_refs(ctx, refs)
    if oren_is_err(kinds) == true { return kinds }
    var policy = _task_group_copy_policy(ctx, oren_map_get_str(group, "default_policy"))
    if oren_is_err(policy) == true { return policy }
    return {
        "members": list.clone(refs),
        "member_kinds": kinds,
        "default_policy": policy,
    }
}

fn _task_group_kinds_for_refs(ctx, refs) {
    var kinds = []
    var i = 0
    var n = oren_list_len(refs)
    while i < n {
        var kind = _task_group_target_kind(refs[i])
        if kind == nil {
            return _task_group_err(ctx, "expected generator handle, generator context, or task handle")
        }
        oren_list_push(kinds, kind)
        i = i + 1
    }
    return kinds
}

fn _task_group_member_kind_or_scan(ctx, refs, kinds, i) {
    if kinds != nil { return kinds[i] }
    var kind = _task_group_target_kind(refs[i])
    if kind == nil {
        return _task_group_err(ctx, "expected generator handle, generator context, or task handle")
    }
    return kind
}

fn _task_group_stop_watchers(ctx, refs, kinds, policy0) {
    var watchers = []
    var i = 0
    var n = oren_list_len(refs)
    while i < n {
        var kind = _task_group_member_kind_or_scan(ctx, refs, kinds, i)
        if oren_is_err(kind) == true { return kind }
        var watcher = _task_group_target_stop_watch_kind(ctx, kind, refs[i], policy0)
        if oren_is_err(watcher) == true { return watcher }
        oren_list_push(watchers, watcher)
        i = i + 1
    }
    return watchers
}

fn _task_group_stop_wait_results(ctx, refs, kinds, policy0) {
    var out = []
    var i = 0
    var n = oren_list_len(refs)
    while i < n {
        var kind = _task_group_member_kind_or_scan(ctx, refs, kinds, i)
        if oren_is_err(kind) == true { return kind }
        var result = _task_group_target_stop_wait_kind(ctx, kind, refs[i], policy0)
        if oren_is_err(result) == true { return result }
        oren_list_push(out, result)
        i = i + 1
    }
    return out
}

fn _task_group_runtime_stop_snapshot(ctx, group, policy0) {
    var preflight0 = _task_group_runtime_snapshot(ctx, group)
    if oren_is_err(preflight0) == true { return preflight0 }
    if oren_list_len(preflight0["members"]) == 0 {
        return {
            "members": [],
            "member_kinds": [],
            "default_policy": {},
        }
    }
    var policy_pre0 = _task_group_merge_policy(ctx, preflight0["default_policy"], policy0)
    if oren_is_err(policy_pre0) == true { return policy_pre0 }
    var valid0 = _task_group_validate_policy_shape(ctx, policy_pre0)
    if oren_is_err(valid0) == true { return valid0 }
    var snapshot0 = _task_group_runtime_take_snapshot(ctx, group)
    if oren_is_err(snapshot0) == true { return snapshot0 }
    var policy0r = _task_group_merge_policy(ctx, snapshot0["default_policy"], policy0)
    if oren_is_err(policy0r) == true { return policy0r }
    snapshot0["default_policy"] = policy0r
    return snapshot0
}

fn _task_group_terminal_results_for(ctx, refs, kinds) {
    var out = []
    var i = 0
    var n = oren_list_len(refs)
    while i < n {
        var kind = _task_group_member_kind_or_scan(ctx, refs, kinds, i)
        if oren_is_err(kind) == true { return kind }
        if kind == "task" {
            return _task_group_err(ctx, "task handles require join_all")
        }
        if kind == "generator_context" {
            return _task_group_err(ctx, "generator contexts do not have terminal results")
        }
        var result = gen.terminal_result(refs[i])
        if oren_is_err(result) == true { return result }
        oren_list_push(out, result)
        i = i + 1
    }
    return out
}

fn _task_group_task_member_kind(refs, kinds, i) {
    if kinds != nil { return kinds[i] }
    return _task_group_target_kind(refs[i])
}

fn _task_group_join_task_refs(ctx, refs, kinds, wait_ms, err_msg) {
    var out = []
    var i = 0
    var n = oren_list_len(refs)
    while i < n {
        if _task_group_task_member_kind(refs, kinds, i) != "task" {
            return _task_group_err(ctx, err_msg)
        }
        oren_list_push(out, task.join_timeout(refs[i], wait_ms))
        i = i + 1
    }
    return out
}

fn _task_group_detach_task_refs(ctx, refs, kinds, err_msg) {
    var i = 0
    var n = oren_list_len(refs)
    while i < n {
        if _task_group_task_member_kind(refs, kinds, i) != "task" {
            return _task_group_err(ctx, err_msg)
        }
        var rv = task.detach(refs[i])
        if oren_is_err(rv) == true { return rv }
        i = i + 1
    }
    return n
}

fn is_group(group) {
    if oren_task_group_is_handle(group) == true { return true }
    if oren_type_name(group) != "map" { return false }
    if oren_map_get_str(group, "__task_group_surface") != _task_group_surface() { return false }
    var members = oren_map_get_str(group, "members")
    return oren_type_name(members) == "list"
}

fn is_runtime_group(group) {
    return oren_task_group_is_handle(group)
}

fn new(default_policy) {
    var policy = _task_group_copy_policy("task_group.new", default_policy)
    if oren_is_err(policy) == true { return policy }
    return {
        "__task_group_surface": _task_group_surface(),
        "members": [],
        "default_policy": policy,
    }
}

fn new_runtime() {
    return oren_task_group_new()
}

fn new_runtime_with_policy(default_policy) {
    var group = new_runtime()
    if oren_task_group_is_handle(group) != true { return group }
    var policy = _task_group_runtime_set_default_policy("task_group.new_runtime_with_policy", group, default_policy)
    if oren_is_err(policy) == true { return policy }
    return group
}

fn from_list(targets, default_policy) {
    var group = new(default_policy)
    if oren_is_err(group) == true { return group }
    return extend(group, targets)
}

fn from_task_list(targets) {
    var group = new_runtime()
    if oren_is_err(group) == true { return group }
    return extend(group, targets)
}

fn from_runtime_list(targets, default_policy) {
    var group = new_runtime_with_policy(default_policy)
    if oren_is_err(group) == true { return group }
    return extend(group, targets)
}

fn from_task_list_with_policy(targets, default_policy) {
    var group = new_runtime_with_policy(default_policy)
    if oren_is_err(group) == true { return group }
    return extend(group, targets)
}

fn count(group) {
    if oren_task_group_is_handle(group) == true {
        return oren_task_group_count(group)
    }
    var members = _task_group_members_ref("task_group.count", group)
    if oren_is_err(members) == true { return members }
    return oren_list_len(members)
}

fn members(group) {
    if oren_task_group_is_handle(group) == true {
        return oren_task_group_members(group)
    }
    var refs = _task_group_members_ref("task_group.members", group)
    if oren_is_err(refs) == true { return refs }
    return list.clone(refs)
}

fn member_kinds(group) {
    if oren_task_group_is_handle(group) == true {
        return oren_task_group_member_kinds(group)
    }
    var refs = _task_group_members_ref("task_group.member_kinds", group)
    if oren_is_err(refs) == true { return refs }
    return _task_group_kinds_for_refs("task_group.member_kinds", refs)
}

fn snapshot(group) {
    if oren_task_group_is_handle(group) == true {
        return _task_group_runtime_snapshot("task_group.snapshot", group)
    }
    return _task_group_map_snapshot("task_group.snapshot", group)
}

fn default_policy(group) {
    if oren_task_group_is_handle(group) == true {
        return _task_group_runtime_default_policy("task_group.default_policy", group)
    }
    var refs = _task_group_members_ref("task_group.default_policy", group)
    if oren_is_err(refs) == true { return refs }
    return _task_group_copy_policy("task_group.default_policy", oren_map_get_str(group, "default_policy"))
}

fn set_default_policy(group, policy0) {
    if oren_task_group_is_handle(group) == true {
        var policy0r = _task_group_runtime_set_default_policy("task_group.set_default_policy", group, policy0)
        if oren_is_err(policy0r) == true { return policy0r }
        return group
    }
    var refs = _task_group_members_ref("task_group.set_default_policy", group)
    if oren_is_err(refs) == true { return refs }
    var policy = _task_group_copy_policy("task_group.set_default_policy", policy0)
    if oren_is_err(policy) == true { return policy }
    group["default_policy"] = policy
    return group
}

fn add(group, target) {
    if oren_task_group_is_handle(group) == true {
        return _task_group_runtime_add_target("task_group.add", group, target)
    }
    var refs = _task_group_members_ref("task_group.add", group)
    if oren_is_err(refs) == true { return refs }
    if _task_group_target_kind(target) == nil {
        return _task_group_err("task_group.add", "expected generator handle, generator context, or task handle")
    }
    oren_list_push(refs, target)
    return group
}

fn extend(group, targets) {
    if oren_task_group_is_handle(group) == true {
        if oren_type_name(targets) != "list" {
            return _task_group_err("task_group.extend", "expected list targets")
        }
        var n0 = oren_list_len(targets)
        var j = 0
        while j < n0 {
            var rv0 = _task_group_runtime_add_target("task_group.extend", group, targets[j])
            if oren_is_err(rv0) == true { return rv0 }
            j = j + 1
        }
        return group
    }
    var refs = _task_group_members_ref("task_group.extend", group)
    if oren_is_err(refs) == true { return refs }
    if oren_type_name(targets) != "list" {
        return _task_group_err("task_group.extend", "expected list targets")
    }
    var n = oren_list_len(targets)
    var i = 0
    while i < n {
        var target = targets[i]
        if _task_group_target_kind(target) == nil {
            return _task_group_err("task_group.extend", "expected generator handle, generator context, or task handle")
        }
        oren_list_push(refs, target)
        i = i + 1
    }
    return group
}

fn stop_policy(group, policy0) {
    if oren_task_group_is_handle(group) == true {
        var snapshot0 = _task_group_runtime_stop_snapshot("task_group.stop_policy", group, policy0)
        if oren_is_err(snapshot0) == true { return snapshot0 }
        if oren_list_len(snapshot0["members"]) == 0 { return [] }
        return _task_group_stop_watchers("task_group.stop_policy", snapshot0["members"], snapshot0["member_kinds"], snapshot0["default_policy"])
    }
    var refs = _task_group_members_ref("task_group.stop_policy", group)
    if oren_is_err(refs) == true { return refs }
    var policy = _task_group_merge_policy("task_group.stop_policy", oren_map_get_str(group, "default_policy"), policy0)
    if oren_is_err(policy) == true { return policy }
    return _task_group_stop_watchers("task_group.stop_policy", refs, nil, policy)
}

fn stop_policy_wait(group, policy0) {
    if oren_task_group_is_handle(group) == true {
        var snapshot0 = _task_group_runtime_stop_snapshot("task_group.stop_policy_wait", group, policy0)
        if oren_is_err(snapshot0) == true { return snapshot0 }
        if oren_list_len(snapshot0["members"]) == 0 { return [] }
        return _task_group_stop_wait_results("task_group.stop_policy_wait", snapshot0["members"], snapshot0["member_kinds"], snapshot0["default_policy"])
    }
    var refs = _task_group_members_ref("task_group.stop_policy_wait", group)
    if oren_is_err(refs) == true { return refs }
    var policy = _task_group_merge_policy("task_group.stop_policy_wait", oren_map_get_str(group, "default_policy"), policy0)
    if oren_is_err(policy) == true { return policy }
    return _task_group_stop_wait_results("task_group.stop_policy_wait", refs, nil, policy)
}

fn request_cancel(group, reason) {
    return stop_policy(group, {
        "mode": "request_cancel",
        "timeout_ms": 0,
        "reason": reason,
    })
}

fn request_cancel_wait(group, reason, join_timeout_ms) {
    return stop_policy_wait(group, {
        "mode": "request_cancel",
        "timeout_ms": 0,
        "reason": reason,
        "join_timeout_ms": join_timeout_ms,
    })
}

fn cancel(group, reason) {
    return stop_policy(group, {
        "mode": "cancel",
        "timeout_ms": 0,
        "reason": reason,
    })
}

fn cancel_wait(group, reason, join_timeout_ms) {
    return stop_policy_wait(group, {
        "mode": "cancel",
        "timeout_ms": 0,
        "reason": reason,
        "join_timeout_ms": join_timeout_ms,
    })
}

fn stop_after(group, timeout_ms, grace_ms, reason) {
    return stop_policy(group, {
        "mode": "stop",
        "timeout_ms": timeout_ms,
        "grace_ms": grace_ms,
        "reason": reason,
    })
}

fn stop_after_wait(group, timeout_ms, grace_ms, reason, join_timeout_ms) {
    return stop_policy_wait(group, {
        "mode": "stop",
        "timeout_ms": timeout_ms,
        "grace_ms": grace_ms,
        "reason": reason,
        "join_timeout_ms": join_timeout_ms,
    })
}

fn stop_at(group, deadline_ns, grace_ms, reason) {
    return stop_policy(group, {
        "mode": "stop",
        "deadline_ns": deadline_ns,
        "grace_ms": grace_ms,
        "reason": reason,
    })
}

fn stop_at_wait(group, deadline_ns, grace_ms, reason, join_timeout_ms) {
    return stop_policy_wait(group, {
        "mode": "stop",
        "deadline_ns": deadline_ns,
        "grace_ms": grace_ms,
        "reason": reason,
        "join_timeout_ms": join_timeout_ms,
    })
}

fn join_all(group, join_timeout_ms) {
    if oren_task_group_is_handle(group) == true {
        var snapshot0 = _task_group_runtime_snapshot("task_group.join_all", group)
        if oren_is_err(snapshot0) == true { return snapshot0 }
        var wait_ms0 = _task_group_join_timeout_ms("task_group.join_all", join_timeout_ms)
        if oren_is_err(wait_ms0) == true { return wait_ms0 }
        var out0 = _task_group_join_task_refs(
            "task_group.join_all",
            snapshot0["members"],
            snapshot0["member_kinds"],
            wait_ms0,
            "expected task-handle-only runtime group"
        )
        if oren_is_err(out0) == true { return out0 }
        oren_task_group_clear(group)
        return out0
    }
    var refs = _task_group_members_ref("task_group.join_all", group)
    if oren_is_err(refs) == true { return refs }
    var wait_ms = _task_group_join_timeout_ms("task_group.join_all", join_timeout_ms)
    if oren_is_err(wait_ms) == true { return wait_ms }
    return _task_group_join_task_refs("task_group.join_all", refs, nil, wait_ms, "expected task-handle-only group")
}

