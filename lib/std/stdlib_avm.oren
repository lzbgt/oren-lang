// Stdlib bundle root for AVM / bytecode (rolling)
//
// Goal:
// - Build a precompiled `.obc` stdlib bundle that is safe to run inside a sandboxed AVM universe
//   (e.g. iOS app, deterministic replay, no host pointers).
//
// Notes:
// - Keep this file "imports-only". Linking removes Import statements, but importing a module pulls it
//   into the linked program and exports its public symbols via `--obc-lib`.
// - Include compiler-facing pure stdlib modules needed by the iOS compiler-in-AVM chain.
// - Modules that depend on host-only effects remain excluded until they have AVM capability-domain shims.
//
// Build:
//   ./oren_stage2 build lib/std/stdlib_avm.oren --backend bytecode -o build/plugins/stdlib_bundle.obc --obc-lib

import buffer "std:buffer"
import bytes "std:bytes"
import cbor "std:cbor"
import fs "std:fs"
import casts "std:casts"
import ints "std:ints"
import iter "std:iter"
import linalg "std:linalg"
import list "std:list"
import math "std:math"
import assert_mod "std:assert"
import regex "std:regex"
import result "std:result"
import strings "std:strings"
import json "std:json"
import sys "std:sys"
import net_avm_dns "std:net/avm/dns"
import net_avm_http "std:net/avm/http"
import net_avm_socket "std:net/avm/socket"
import net_avm_tcp "std:net/avm/tcp"
import net_avm_udp "std:net/avm/udp"
import net_avm_ws "std:net/avm/ws"
import yaml "std:yaml"
import time "std:time"
import timer "std:timer"
import argparse "std:argparse"
import avm_events "std:avm/events"
import avm_permission "std:avm/permission"
import base64 "std:encoding/base64"
import pem "std:crypto/pem"
import sha1 "std:crypto/sha1"
import sha256 "std:crypto/sha256"
import x509 "std:crypto/x509"
import ui_color "std:ui/color"
import ui_commands "std:ui/commands"
import ui_core "std:ui/core"
import ui_layout "std:ui/layout"
import ui_render "std:ui/render"
import ui_avm "std:ui/avm"
import ui_scene3d "std:ui/scene3d"
