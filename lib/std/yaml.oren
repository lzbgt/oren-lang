// std/yaml (rolling)
//
// YAML 1.2.2 spec (audit reference): docs/refs/yaml/yaml-1.2.2.html
//
// v1 scope (explicitly limited):
// - Deterministic and portable encode/decode across backends.
// - Supports a small, useful subset:
//   - mappings (string keys only): `key: value` and `key:` nested blocks
//   - sequences: `- value` and `-` nested blocks
//   - scalars: null, bool, int (base10), string (quoted or bare)
//   - optional document start `---`
//   - comment tolerance:
//     - YAML-style `# ...` (when `#` is at start or preceded by whitespace)
//     - JSON/C-style `// ...` and `/* ... */` (same whitespace rule; `/* */` may span lines)
// - No anchors, tags, merge keys, multi-doc, flow style, or complex scalars.
//
// NOTE: YAML 1.2 is a superset of JSON. This module also accepts JSON text as input
// in `decode(...)` / `parse(...)` by delegating to std/json as a fallback.
//
// YamlValue representation mirrors std/json's JsonValue (tagged) so serde lowering can
// reuse the same shape across formats:
//   {"t":"null"}
//   {"t":"bool","b":0|1}
//   {"t":"int","i":<int>}
//   {"t":"string","s":<string>}
//   {"t":"array","a":[YamlValue...]}
//   {"t":"object","o":{ string_key: YamlValue, ... }}
//
// Encoding is deterministic:
// - objects are emitted with keys sorted lexicographically (bytewise)
// - indentation is 2 spaces per level

import json "std:json"

import raw "std:buffer/raw"
import list "std:list"

struct YamlValue {
    t,
    b,
    i,
    s,
    a,
    o
}

fn ynull(): YamlValue { return {"t": "null"} }
fn ybool(b): YamlValue { return {"t": "bool", "b": b} }
fn yint(i): YamlValue { return {"t": "int", "i": i} }
fn ystring(s): YamlValue { return {"t": "string", "s": s} }
fn yarray(a): YamlValue { return {"t": "array", "a": a} }
fn yobject(o): YamlValue { return {"t": "object", "o": o} }

trait YamlText {
    fn yaml(self): YamlValue;
}

trait YamlValueCodec {
    fn text(self);
}

fn _err(msg, line) { return {"ok": 0, "err": msg, "line": line} }
fn _ok(v) { return {"ok": 1, "v": v} }

fn _is_ws(b) { return b == 32 || b == 9 || b == 13 }
fn _is_digit(b) { return b >= 48 && b <= 57 }

fn _byte_at(s, i) {
    return oren_string_byte_at_unchecked(s, i) & 255
}

fn _streq(a, b) {
    if a == nil || b == nil { return false }
    var al = oren_string_len(a)
    var bl = oren_string_len(b)
    if al != bl { return false }
    var i = 0
    while i < al {
        if _byte_at(a, i) != _byte_at(b, i) { return false }
        i = i + 1
    }
    return true
}

fn _trim(s) {
    if s == nil { return nil }
    var n = oren_string_len(s)
    var i = 0
    while i < n && _is_ws(_byte_at(s, i)) { i = i + 1 }
    var j = n
    while j > i && _is_ws(_byte_at(s, j - 1)) { j = j - 1 }
    if i == 0 && j == n { return s }
    return oren_string_slice(s, i, j)
}

fn _split_lines(s) {
    var out = []
    var start = 0
    var i = 0
    var n = oren_string_len(s)
    while i < n {
        var b = _byte_at(s, i)
        if b == 10 { // \n
            list.push(out, oren_string_slice(s, start, i))
            i = i + 1
            start = i
            continue
        }
        if b == 13 { // \r
            list.push(out, oren_string_slice(s, start, i))
            if i + 1 < n && _byte_at(s, i + 1) == 10 { i = i + 2 } else { i = i + 1 }
            start = i
            continue
        }
        i = i + 1
    }
    list.push(out, oren_string_slice(s, start, n))
    return out
}

fn _buf_put_u8(out, pos, b) {
    raw._store_u8_buf_unchecked_direct(out, pos, b)
    return pos + 1
}

fn _strip_comments_text(s) {
    // Comment tolerance for config files:
    // - YAML '# ...' comment when preceded by whitespace (or at start).
    // - C/JSON style '//' and '/* */' (same whitespace rule).
    //   Block comments may span lines; we preserve '\n'/'\r' inside block comments so
    //   line numbers remain stable.
    //
    // Not a full YAML tokenizer; designed to be deterministic and safe for common inputs.
    if s == nil { return nil }
    var n = oren_string_len(s)
    var out = raw.u8_new_uninit(n)
    if oren_is_err(out) { return out }
    var o = 0

    var in_quote = false
    var in_line_comment = false
    var in_block_comment = false

    var i = 0
    while i < n {
        var b = _byte_at(s, i)

        if in_line_comment {
            // Consume until newline, but keep newline bytes.
            if b == 10 { // \n
                raw._store_u8_buf_unchecked_direct(out, o, 10)
                o = o + 1
                in_line_comment = false
            } else {
                if b == 13 { // \r
                    raw._store_u8_buf_unchecked_direct(out, o, 13)
                    o = o + 1
                    // keep optional \n if present
                    if i + 1 < n && _byte_at(s, i + 1) == 10 {
                        raw._store_u8_buf_unchecked_direct(out, o, 10)
                        o = o + 1
                        i = i + 1
                    }
                    in_line_comment = false
                }
            }
            i = i + 1
            continue
        }

        if in_block_comment {
            // Preserve newlines; otherwise drop bytes until closing '*/'.
            if b == 42 && i + 1 < n && _byte_at(s, i + 1) == 47 {
                in_block_comment = false
                i = i + 2
                continue
            }
            if b == 10 {
                raw._store_u8_buf_unchecked_direct(out, o, 10)
                o = o + 1
            }
            if b == 13 {
                raw._store_u8_buf_unchecked_direct(out, o, 13)
                o = o + 1
            }
            i = i + 1
            continue
        }

        if in_quote {
            // Preserve escapes so we don't accidentally terminate on an escaped quote.
            if b == 92 { // '\\'
                raw._store_u8_buf_unchecked_direct(out, o, b)
                o = o + 1
                if i + 1 < n {
                    raw._store_u8_buf_unchecked_direct(out, o, _byte_at(s, i + 1))
                    o = o + 1
                    i = i + 2
                    continue
                }
            }
            raw._store_u8_buf_unchecked_direct(out, o, b)
            o = o + 1
            if b == 34 { in_quote = false } // '"'
            i = i + 1
            continue
        }

        // Not in quote/comment: detect comment starts with a safe rule:
        // only treat as comment if at start or preceded by whitespace.
        var ws_ok = false
        if i == 0 { ws_ok = true } else {
            var pb = _byte_at(s, i - 1)
            // Treat newline as whitespace for comment-start purposes so full-line comments work.
            if _is_ws(pb) || pb == 10 { ws_ok = true }
        }

        if b == 34 { // '"'
            in_quote = true
            raw._store_u8_buf_unchecked_direct(out, o, b)
            o = o + 1
            i = i + 1
            continue
        }

        if ws_ok {
            if b == 35 { // '#'
                in_line_comment = true
                i = i + 1
                continue
            }
            if b == 47 && i + 1 < n {
                var nb = _byte_at(s, i + 1)
                if nb == 47 { // '//'
                    in_line_comment = true
                    i = i + 2
                    continue
                }
                if nb == 42 { // '/*'
                    in_block_comment = true
                    i = i + 2
                    continue
                }
            }
        }

        // normal byte
        raw._store_u8_buf_unchecked_direct(out, o, b)
        o = o + 1
        i = i + 1
    }

    return oren_string_from_bytes_slice(out, 0, o)
}

fn _line_indent(line) {
    var n = oren_string_len(line)
    var i = 0
    while i < n && _byte_at(line, i) == 32 { i = i + 1 }
    // tabs are not supported in v1 (explicit).
    if i < n && _byte_at(line, i) == 9 { return -1 }
    return i
}

fn _parse_quoted_string(s, line_no) {
    var n = oren_string_len(s)
    if n < 2 { return _err("invalid quoted string", line_no) }
    if _byte_at(s, 0) != 34 { return _err("expected '\"'", line_no) }
    var out = raw.u8_new_uninit(n)
    if oren_is_err(out) { return _err("string buffer allocation failed", line_no) }
    var out_pos = 0
    var i = 1
    while i < n {
        var b = _byte_at(s, i)
        if b == 34 {
            if i != n - 1 { return _err("trailing content after quoted string", line_no) }
            var ss = oren_string_from_bytes_slice(out, 0, out_pos)
            return _ok(ystring(ss))
        }
        if b == 92 { // backslash
            i = i + 1
            if i >= n { return _err("unterminated escape", line_no) }
            var e = _byte_at(s, i)
            if e == 34 { out_pos = _buf_put_u8(out, out_pos, 34) }
            else {
                if e == 92 { out_pos = _buf_put_u8(out, out_pos, 92) }
                else {
                    if e == 110 { out_pos = _buf_put_u8(out, out_pos, 10) } // \n
                    else {
                        if e == 114 { out_pos = _buf_put_u8(out, out_pos, 13) } // \r
                        else {
                            if e == 116 { out_pos = _buf_put_u8(out, out_pos, 9) }  // \t
                            else { return _err("unsupported escape", line_no) }
                        }
                    }
                }
            }
            i = i + 1
            continue
        }
        out_pos = _buf_put_u8(out, out_pos, b)
        i = i + 1
    }
    return _err("unterminated quoted string", line_no)
}

fn _parse_scalar(tok, line_no) {
    tok = _trim(tok)
    if tok == nil || _streq(tok, "") { return _err("expected scalar", line_no) }
    if _streq(tok, "null") || _streq(tok, "~") { return _ok(ynull()) }
    if _streq(tok, "true") { return _ok(ybool(1)) }
    if _streq(tok, "false") { return _ok(ybool(0)) }
    // quoted string
    var n = oren_string_len(tok)
    if n >= 2 && _byte_at(tok, 0) == 34 {
        return _parse_quoted_string(tok, line_no)
    }
    // int (base10)
    var i = 0
    var neg = false
    if _byte_at(tok, 0) == 45 { neg = true; i = 1 }
    var any = false
    var v = 0
    while i < n {
        var b = _byte_at(tok, i)
        if !_is_digit(b) { any = false; break }
        any = true
        v = v * 10 + (b - 48)
        i = i + 1
    }
    if any == true && i == n {
        if neg { v = -v }
        return _ok(yint(v))
    }
    // bare string
    return _ok(ystring(tok))
}

fn _peek_next_nonempty(lines, idx) {
    var i = idx
    var n = list.len(lines)
    while i < n {
        var ln = lines[i]
        if ln != nil && _streq(_trim(ln), "") != true { return i }
        i = i + 1
    }
    return -1
}

fn _parse_block(lines, idx, indent) {
    // returns {"ok":1,"v":YamlValue,"idx":newidx} or err
    // Decide block kind from first line at this indent: sequence or mapping.
    var first_i = _peek_next_nonempty(lines, idx)
    if first_i < 0 { return {"ok": 1, "v": ynull(), "idx": idx} }
    var line = lines[first_i]
    var ind = _line_indent(line)
    if ind < 0 { return _err("tabs not supported", first_i + 1) }
    if ind < indent { return {"ok": 1, "v": ynull(), "idx": idx} }
    if ind > indent { return _err("unexpected indentation", first_i + 1) }
    var body = _trim(oren_string_slice(line, indent, oren_string_len(line)))

    var is_seq = false
    if oren_string_len(body) >= 1 && _streq(oren_string_slice(body, 0, 1), "-") { is_seq = true }

    if is_seq {
        var items = []
        var i = first_i
        var line_count = list.len(lines)
        while i < line_count {
            var raw = lines[i]
            if raw == nil { i = i + 1; continue }
            var raw2 = _trim(raw)
            if _streq(raw2, "") { i = i + 1; continue }
            var ind2 = _line_indent(raw)
            if ind2 < 0 { return _err("tabs not supported", i + 1) }
            if ind2 < indent { break }
            if ind2 != indent { return _err("mixed indentation in sequence", i + 1) }
            var rest = _trim(oren_string_slice(raw, indent, oren_string_len(raw)))
            if oren_string_len(rest) < 1 || _streq(oren_string_slice(rest, 0, 1), "-") != true {
                return _err("expected '-'", i + 1)
            }
            var after = _trim(oren_string_slice(rest, 1, oren_string_len(rest)))
            if _streq(after, "") {
                // nested block
                var ni = _peek_next_nonempty(lines, i + 1)
                if ni < 0 { return _err("expected nested block", i + 1) }
                var indn = _line_indent(lines[ni])
                if indn <= indent { return _err("expected indented nested block", ni + 1) }
                var r = _parse_block(lines, i + 1, indn)
                if r["ok"] != 1 { return r }
                list.push(items, r["v"])
                i = r["idx"]
                continue
            }
            var rv = _parse_scalar(after, i + 1)
            if rv["ok"] != 1 { return rv }
            list.push(items, rv["v"])
            i = i + 1
        }
        return {"ok": 1, "v": yarray(items), "idx": i}
    }

    // mapping
    var obj = {}
    var i2 = first_i
    var line_count2 = list.len(lines)
    while i2 < line_count2 {
        var rawm = lines[i2]
        if rawm == nil { i2 = i2 + 1; continue }
        var rawm2 = _trim(rawm)
        if _streq(rawm2, "") { i2 = i2 + 1; continue }
        var indm = _line_indent(rawm)
        if indm < 0 { return _err("tabs not supported", i2 + 1) }
        if indm < indent { break }
        if indm != indent { return _err("mixed indentation in mapping", i2 + 1) }

        var line_no = i2 + 1
        var restm = _trim(oren_string_slice(rawm, indent, oren_string_len(rawm)))

        // split at first ':'
        var n = oren_string_len(restm)
        var kpos = -1
        var j = 0
        while j < n {
            if _byte_at(restm, j) == 58 { kpos = j; break }
            j = j + 1
        }
        if kpos < 0 { return _err("expected ':' in mapping entry", line_no) }

        var key_raw = oren_string_slice(restm, 0, kpos)
        var val_raw = oren_string_slice(restm, kpos + 1, n)
        key_raw = _trim(key_raw)
        val_raw = _trim(val_raw)
        if _streq(key_raw, "") { return _err("empty key", line_no) }

        // key may be quoted
        var key = key_raw
        if oren_string_len(key_raw) >= 2 && _byte_at(key_raw, 0) == 34 {
            var rk = _parse_quoted_string(key_raw, line_no)
            if rk["ok"] != 1 { return rk }
            key = rk["v"]["s"]
        }

        if _streq(val_raw, "") {
            // nested block
            var ni2 = _peek_next_nonempty(lines, i2 + 1)
            if ni2 < 0 { return _err("expected nested block", line_no) }
            var indn2 = _line_indent(lines[ni2])
            if indn2 <= indent { return _err("expected indented nested block", ni2 + 1) }
            var r2 = _parse_block(lines, i2 + 1, indn2)
            if r2["ok"] != 1 { return r2 }
            // YAML object keys are strings in v0 subset.
            oren_map_set_str(obj, key, r2["v"])
            i2 = r2["idx"]
            continue
        }

        var rv2 = _parse_scalar(val_raw, line_no)
        if rv2["ok"] != 1 { return rv2 }
        // YAML object keys are strings in v0 subset.
        oren_map_set_str(obj, key, rv2["v"])
        i2 = i2 + 1
    }
    return {"ok": 1, "v": yobject(obj), "idx": i2}
}

fn decode(s) {
    if s == nil { return _err("input is nil", 1) }

    // 1) Fallback: YAML 1.2 JSON subset => accept JSON text.
    // This makes config files that are JSON always work, even if our YAML subset parser
    // doesn't cover a corner case.
    var jr = json.decode(s)
    if jr != nil && jr["ok"] == 1 {
        // JsonValue representation is identical to YamlValue representation.
        return {"ok": 1, "v": jr["v"]}
    }

    // 2) Subset YAML parser (block style).
    // Keep original indentation, but strip comments first (YAML '#' and C/JSON '//'/'/* */').
    var s2 = _strip_comments_text(s)
    var lines0 = _split_lines(s2)
    var plines = []
    var i = 0
    var nlines0 = list.len(lines0)
    while i < nlines0 {
        var raw = lines0[i]
        if raw == nil { raw = "" }
        list.push(plines, raw)
        i = i + 1
    }

    // normalize: drop leading empty lines and optional document start '---'
    var start = _peek_next_nonempty(plines, 0)
    if start < 0 { return {"ok": 1, "v": ynull()} }
    if _streq(_trim(plines[start]), "---") { start = start + 1 }
    start = _peek_next_nonempty(plines, start)
    if start < 0 { return {"ok": 1, "v": ynull()} }

    var ind = _line_indent(plines[start])
    if ind < 0 { return _err("tabs not supported", start + 1) }
    var r = _parse_block(plines, start, ind)
    if r["ok"] != 1 { return r }
    return {"ok": 1, "v": r["v"]}
}

fn parse(s): YamlValue {
    var r = decode(s)
    if r["ok"] == 1 { return r["v"] }
    var msg = r["err"]
    if msg == nil || _streq(msg, "") { msg = "yaml decode failed" }
    var line = r["line"]
    if line != nil {
        msg = "line " + oren_int_to_string(line) + ": " + msg
    }
    return oren_err(4, msg)
}

fn _string_cmp(a, b) {
    var al = oren_string_len(a)
    var bl = oren_string_len(b)
    var i = 0
    var n = al
    if bl < n { n = bl }
    while i < n {
        var av = _byte_at(a, i)
        var bv = _byte_at(b, i)
        if av < bv { return -1 }
        if av > bv { return 1 }
        i = i + 1
    }
    if al < bl { return -1 }
    if al > bl { return 1 }
    return 0
}

fn _key_lt(a, b) {
    return _string_cmp(a, b) < 0
}

fn _sort_keys(keys) {
    var i = 1
    var n = list.len(keys)
    while i < n {
        var k = keys[i]
        var j = i - 1
        while j >= 0 && _key_lt(k, keys[j]) {
            keys[j + 1] = keys[j]
            j = j - 1
        }
        keys[j + 1] = k
        i = i + 1
    }
    return keys
}

fn _safe_bare_ident(s) {
    if s == nil || _streq(s, "") { return false }
    // Disallow reserved scalars (avoid ambiguity on decode).
    if _streq(s, "null") || _streq(s, "~") || _streq(s, "true") || _streq(s, "false") { return false }
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        var b = _byte_at(s, i)
        var ok = false
        if b >= 65 && b <= 90 { ok = true }
        if b >= 97 && b <= 122 { ok = true }
        if b >= 48 && b <= 57 { ok = true }
        if b == 95 || b == 45 || b == 46 || b == 47 { ok = true } // _ - . /
        if ok != true { return false }
        i = i + 1
    }
    // Avoid leading '-' which could be parsed as a sequence item.
    if _byte_at(s, 0) == 45 { return false }
    return true
}

fn _escape_string(s) {
    var n = oren_string_len(s)
    var out = raw.u8_new_uninit(n * 2)
    if oren_is_err(out) { return out }
    var out_pos = 0
    var i = 0
    while i < n {
        var b = _byte_at(s, i)
        if b == 34 { // "
            out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 34)
        } else {
            if b == 92 { // \
                out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 92)
            } else {
                if b == 10 { // \n
                    out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 110)
                } else {
                    if b == 13 { // \r
                        out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 114)
                    } else {
                        if b == 9 { // \t
                            out_pos = _buf_put_u8(out, out_pos, 92); out_pos = _buf_put_u8(out, out_pos, 116)
                        } else {
                            out_pos = _buf_put_u8(out, out_pos, b)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return oren_string_from_bytes_slice(out, 0, out_pos)
}

fn _indent(n) {
    var out = ""
    var i = 0
    while i < n {
        out = out + " "
        i = i + 1
    }
    return out
}

fn _encode_inline(v) {
    var t = v["t"]
    if _streq(t, "null") { return "null" }
    if _streq(t, "bool") { if v["b"] != 0 { return "true" } else { return "false" } }
    if _streq(t, "int") { return oren_int_to_string(v["i"]) }
    if _streq(t, "string") {
        var s = v["s"]
        if _safe_bare_ident(s) { return s }
        return "\"" + _escape_string(s) + "\""
    }
    return nil // arrays/objects handled by block emitter
}

fn _encode_block(v, indent) {
    var t = v["t"]
    var inl = _encode_inline(v)
    if inl != nil { return inl }
    if _streq(t, "array") {
        var a = v["a"]
        if a == nil || list.len(a) == 0 { return "[]" }
        var out = ""
        var i = 0
        var an = list.len(a)
        while i < an {
            var item = a[i]
            var inl2 = _encode_inline(item)
            if inl2 != nil {
                out = out + _indent(indent) + "- " + inl2 + "\n"
            } else {
                out = out + _indent(indent) + "-\n"
                out = out + _encode_block(item, indent + 2)
                if !ends_with(out, "\n") { out = out + "\n" }
            }
            i = i + 1
        }
        return out
    }
    if _streq(t, "object") {
        var o = v["o"]
        if o == nil { return "{}" }
        var keys = []
        for k in o { list.push(keys, k) }
        _sort_keys(keys)
        var kn = list.len(keys)
        if kn == 0 { return "{}" }
        var out2 = ""
        var i2 = 0
        while i2 < kn {
            var k2 = keys[i2]
            var key_enc = k2
            if !_safe_bare_ident(k2) { key_enc = "\"" + _escape_string(k2) + "\"" }
            var vv = oren_map_get_str(o, k2)
            var inl3 = _encode_inline(vv)
            if inl3 != nil {
                out2 = out2 + _indent(indent) + key_enc + ": " + inl3 + "\n"
            } else {
                out2 = out2 + _indent(indent) + key_enc + ":\n"
                out2 = out2 + _encode_block(vv, indent + 2)
                if !ends_with(out2, "\n") { out2 = out2 + "\n" }
            }
            i2 = i2 + 1
        }
        return out2
    }
    // Unknown tag: encode as null
    return "null"
}

fn starts_with(s, prefix) {
    if s == nil || prefix == nil { return false }
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if _byte_at(s, i) != _byte_at(prefix, i) { return false }
        i = i + 1
    }
    return true
}

fn ends_with(s, suffix) {
    if s == nil || suffix == nil { return false }
    var sl = oren_string_len(s)
    var pl = oren_string_len(suffix)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if _byte_at(s, (sl - pl) + i) != _byte_at(suffix, i) { return false }
        i = i + 1
    }
    return true
}

fn encode(v) {
    // Emit in canonical block style (no '---' header for now).
    var out = _encode_block(v, 0)
    // Normalize final newline (present).
    if !ends_with(out, "\n") { out = out + "\n" }
    return out
}

fn text(v: YamlValue) { return encode(v) }

impl YamlText for string {
    fn yaml(self): YamlValue { return parse(self) }
}

impl YamlValueCodec for YamlValue {
    fn text(self) { return encode(self) }
}
