// std/coroutine.oren
//
// Thin stdlib facade over the current coroutine-capable generator substrate.
// Today the user-facing coroutine alias reuses the same underlying dedicated
// handle and generator-context runtime objects as `std:generator`:
// - handle type remains `generator`
// - worker shape remains `worker(co, args_list)`
// - inside that worker, `yield [expr] in co` is the shared exchange contract
// - cooperative cancel requests stay observable as request state via `request_cancel(...)`
// - `request_cancel_after(...)` / `cancel_after(...)` schedule that same protocol on a joinable
//   watcher task after a relative timeout
// - `request_cancel_at(...)` / `cancel_at(...)` schedule that same protocol against an absolute
//   `deadline_ns` in the `time.now_ns()` domain
// - `cancel(...)` is the hard-stop layer above that state: it records the request and then
//   forces the existing close/detach/finalize path
//
// This module exists to make the shipped coroutine surface explicit at the
// language/std layer while the broader coroutine state-machine lowering backlog
// is still rolling.

import gen "std:generator"

fn start(worker, args_list) {
    return oren_generator_start(worker, args_list)
}

fn resume(co) {
    return oren_generator_next(co)
}

fn next(co) {
    return resume(co)
}

fn send(co, value) {
    return oren_generator_send(co, value)
}

fn on_finalize(co, hook) {
    return oren_generator_on_finalize(co, hook)
}

fn on_close(co, hook) {
    return oren_generator_on_close(co, hook)
}

fn close(co) {
    return oren_generator_close(co)
}

fn cancel(co, reason) {
    return oren_generator_cancel(co, reason)
}

fn request_cancel(co, reason) {
    return oren_generator_request_cancel(co, reason)
}

fn request_cancel_after(co, timeout_ms, reason) {
    return gen.request_cancel_after(co, timeout_ms, reason)
}

fn cancel_after(co, timeout_ms, reason) {
    return gen.cancel_after(co, timeout_ms, reason)
}

fn request_cancel_at(co, deadline_ns, reason) {
    return gen.request_cancel_at(co, deadline_ns, reason)
}

fn cancel_at(co, deadline_ns, reason) {
    return gen.cancel_at(co, deadline_ns, reason)
}

fn delegate(co, inner) {
    return oren_generator_delegate(co, inner)
}

fn delegate_step(co, inner, step) {
    return oren_generator_delegate_step(co, inner, step)
}

fn is_started(co) {
    return oren_generator_is_started(co)
}

fn is_done(co) { return oren_generator_is_done(co) }

fn is_closed(co) { return oren_generator_is_closed(co) }

fn is_cancel_requested(co) { return oren_generator_is_cancel_requested(co) }

fn current_step(co) { return oren_generator_current_step(co) }

fn return_value(co) { return oren_generator_return_value(co) }

fn terminal_error(co) { return oren_generator_terminal_error(co) }

fn cancel_reason(co) { return oren_generator_cancel_reason(co) }

fn collect(co) {
    return oren_generator_collect(co)
}
