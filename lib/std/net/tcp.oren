// std/net/tcp (rolling)
//
// Goal:
// - Expose the syscall-first TCP substrate as a stable stdlib surface.
// - Keep the API small and predictable (no DNS/TLS here; those can be layered later).
//
// Notes:
// - All operations are capability-gated by the runtime capsule (`domain="NET"`).
// - All potentially-blocking operations accept `timeout_ms` to avoid hangs.
//   - `timeout_ms < 0` is treated as "no wait" (0ms) in rolling mode to avoid accidental hangs.
// - Return convention (rolling):
//   - `fd` / byte-count: `>= 0` on success
//   - negative errno: `< 0` on failure
//
// If you prefer structured errors, wrap with `std/result.ok_or_errno`.

import result "std:result"

// --- Raw syscall-style wrappers (recommended for performance) ---

fn connect(ip, port, timeout_ms) {
    return oren_tcp_connect(ip, port, timeout_ms)
}

fn listen_local(port) {
    // Binds to 127.0.0.1:<port> and listens with a small backlog.
    // Returns listening fd or -errno.
    return oren_tcp_listen_local(port)
}

fn accept(listen_fd, timeout_ms) {
    // Returns accepted fd or -errno.
    return oren_tcp_accept(listen_fd, timeout_ms)
}

fn read_into(fd, buf, len, timeout_ms) {
    // Reads up to len bytes into buf.
    // Returns number of bytes read, or -errno.
    return oren_tcp_read_into(fd, buf, len, timeout_ms)
}

fn write_from(fd, buf, len, timeout_ms) {
    // Writes len bytes from buf.
    // Returns number of bytes written, or -errno.
    return oren_tcp_write_from(fd, buf, len, timeout_ms)
}

fn close(fd) {
    return oren_tcp_close(fd)
}

fn set_keepalive(fd, enable) {
    // Enable/disable TCP keepalive on a connected socket.
    //
    // This is a portable wrapper over:
    //   sys_setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &on, sizeof(int))
    //
    // Return: 0 on success, or -errno on failure.
    var one = malloc(8)
    if one == 0 { return 0 - 12 } // ENOMEM
    // `sys_setsockopt` expects a pointer to an int (4 bytes). We store the value in an 8-byte slot
    // but still pass optlen=4, matching other runtime uses (e.g. SO_REUSEADDR).
    if enable == 0 { ptr_set(one, 0) } else { ptr_set(one, 1) }
    var rc = sys_setsockopt(fd, OREN_SOL_SOCKET, OREN_SO_KEEPALIVE, one, 4)
    free(one)
    return rc
}

fn set_nodelay(fd, enable) {
    // Enable/disable TCP_NODELAY (disable/enable Nagle).
    //
    // This is a portable wrapper over:
    //   sys_setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &on, sizeof(int))
    //
    // Return: 0 on success, or -errno on failure.
    var one = malloc(8)
    if one == 0 { return 0 - 12 } // ENOMEM
    if enable == 0 { ptr_set(one, 0) } else { ptr_set(one, 1) }
    var rc = sys_setsockopt(fd, OREN_IPPROTO_TCP, OREN_TCP_NODELAY, one, 4)
    free(one)
    return rc
}

fn wait_readable(fd, timeout_ms) {
    // Returns:
    // - 1: ready
    // - 0: timeout
    // - <0: error
    return oren_fd_wait_readable(fd, timeout_ms)
}

fn wait_writable(fd, timeout_ms) {
    // Returns:
    // - 1: ready
    // - 0: timeout
    // - <0: error
    return oren_fd_wait_writable(fd, timeout_ms)
}

fn wait_any_readable(fds, timeout_ms) {
    // Wait for any fd in `fds` to become readable.
    //
    // Returns:
    // - ready fd (>= 0) on success
    // - -ETIMEDOUT (-60) on timeout
    // - negative errno on failure
    var out = malloc(8)
    if out == 0 { return 0 - 12 } // ENOMEM
    var rc = oren_fd_wait_any_readable(fds, timeout_ms, out)
    if rc == 0 { free(out); return 0 - 60 } // ETIMEDOUT
    if rc < 0 { free(out); return rc }
    var fd = ptr_get(out)
    free(out)
    return fd
}

fn wait_any_writable(fds, timeout_ms) {
    // Wait for any fd in `fds` to become writable.
    //
    // Returns:
    // - ready fd (>= 0) on success
    // - -ETIMEDOUT (-60) on timeout
    // - negative errno on failure
    var out = malloc(8)
    if out == 0 { return 0 - 12 } // ENOMEM
    var rc = oren_fd_wait_any_writable(fds, timeout_ms, out)
    if rc == 0 { free(out); return 0 - 60 } // ETIMEDOUT
    if rc < 0 { free(out); return rc }
    var fd = ptr_get(out)
    free(out)
    return fd
}

// --- Structured Result helpers (optional) ---

fn connect_ok(ip, port, timeout_ms) {
    return result.ok_or_errno(connect(ip, port, timeout_ms), "tcp.connect")
}

fn listen_local_ok(port) {
    return result.ok_or_errno(listen_local(port), "tcp.listen_local")
}

fn accept_ok(listen_fd, timeout_ms) {
    return result.ok_or_errno(accept(listen_fd, timeout_ms), "tcp.accept")
}

fn read_into_ok(fd, buf, len, timeout_ms) {
    return result.ok_or_errno(read_into(fd, buf, len, timeout_ms), "tcp.read_into")
}

fn write_from_ok(fd, buf, len, timeout_ms) {
    return result.ok_or_errno(write_from(fd, buf, len, timeout_ms), "tcp.write_from")
}

fn set_keepalive_ok(fd, enable) {
    return result.ok_or_errno(set_keepalive(fd, enable), "tcp.set_keepalive")
}

fn wait_any_readable_ok(fds, timeout_ms) {
    return result.ok_or_errno(wait_any_readable(fds, timeout_ms), "tcp.wait_any_readable")
}

fn wait_any_writable_ok(fds, timeout_ms) {
    return result.ok_or_errno(wait_any_writable(fds, timeout_ms), "tcp.wait_any_writable")
}
