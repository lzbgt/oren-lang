// AVM-safe virtual socket/session primitives.
//
// This is the low-level OBC socket-like surface: programs see only virtual
// session ids. The host app owns real sockets, allowlists, readiness, and budgets.

import neturl "std:net/url"

struct Session {
    id
}

trait VirtualSocketSession {
    fn write(self, data, timeout_ms);
    fn read(self, max_len, timeout_ms);
    fn poll(self, events, timeout_ms);
    fn select(self, events, timeout_ms);
    fn poll_read(self, timeout_ms);
    fn poll_write(self, timeout_ms);
    fn select_read(self, timeout_ms);
    fn select_write(self, timeout_ms);
    fn accept(self, timeout_ms): Session;
    fn close(self);
}

fn clean_spec(spec) {
    if spec == nil { return oren_err(4, "std:net/avm/socket.clean_spec: spec is nil") }
    var clean = neturl.without_fragment(spec)
    if oren_is_err(clean) { return clean }
    var origin = neturl.endpoint_origin(clean)
    if oren_is_err(origin) { return origin }
    return clean
}

fn open(spec, timeout_ms): Session {
    var clean = clean_spec(spec)
    if oren_is_err(clean) { return clean }
    return oren_vnet_session_open(clean, timeout_ms)
}

fn _open_host_port(scheme, host, port, timeout_ms): Session {
    var authority = neturl.authority_from_host_port(host, port)
    if oren_is_err(authority) { return authority }
    return open(scheme + "://" + authority, timeout_ms)
}

fn open_tcp(host, port, timeout_ms): Session {
    return _open_host_port("tcp", host, port, timeout_ms)
}

fn listen_tcp(host, port, timeout_ms): Session {
    return _open_host_port("tcp-listen", host, port, timeout_ms)
}

fn open_udp(host, port, timeout_ms): Session {
    return _open_host_port("udp", host, port, timeout_ms)
}

fn write(session_id, data, timeout_ms) {
    return oren_vnet_session_write(session_id, data, timeout_ms)
}

fn read(session_id, max_len, timeout_ms) {
    return oren_vnet_session_read(session_id, max_len, timeout_ms)
}

fn read_kind(session_id, max_len, payload_kind, timeout_ms) {
    return oren_vnet_session_read_kind(session_id, max_len, timeout_ms, payload_kind)
}

fn poll(session_id, events, timeout_ms) {
    return oren_vnet_session_poll(session_id, events, timeout_ms)
}

fn select(session_id, events, timeout_ms) {
    return poll(session_id, events, timeout_ms)
}

fn poll_read(session_id, timeout_ms) {
    return poll(session_id, 1, timeout_ms)
}

fn poll_write(session_id, timeout_ms) {
    return poll(session_id, 2, timeout_ms)
}

fn select_read(session_id, timeout_ms) {
    return select(session_id, 1, timeout_ms)
}

fn select_write(session_id, timeout_ms) {
    return select(session_id, 2, timeout_ms)
}

fn accept(listener_session_id, timeout_ms) {
    return oren_vnet_session_accept(listener_session_id, timeout_ms)
}

fn close(session_id) {
    return oren_vnet_session_close(session_id)
}

impl VirtualSocketSession for Session {
    fn write(self, data, timeout_ms) { return write(self, data, timeout_ms) }
    fn read(self, max_len, timeout_ms) { return read(self, max_len, timeout_ms) }
    fn poll(self, events, timeout_ms) { return poll(self, events, timeout_ms) }
    fn select(self, events, timeout_ms) { return select(self, events, timeout_ms) }
    fn poll_read(self, timeout_ms) { return poll_read(self, timeout_ms) }
    fn poll_write(self, timeout_ms) { return poll_write(self, timeout_ms) }
    fn select_read(self, timeout_ms) { return select_read(self, timeout_ms) }
    fn select_write(self, timeout_ms) { return select_write(self, timeout_ms) }
    fn accept(self, timeout_ms): Session { return accept(self, timeout_ms) }
    fn close(self) { return close(self) }
}
