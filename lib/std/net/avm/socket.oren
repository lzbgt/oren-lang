// AVM-safe virtual socket/session primitives.
//
// This is the low-level OBC socket-like surface: programs see only virtual
// session ids. The host app owns real sockets, allowlists, readiness, and budgets.

fn open(spec, timeout_ms) {
    if spec == nil { return oren_err(4, "std:net/avm/socket.open: spec is nil") }
    return oren_vnet_session_open(spec, timeout_ms)
}

fn open_tcp(host, port, timeout_ms) {
    if host == nil { return oren_err(4, "std:net/avm/socket.open_tcp: host is nil") }
    return open("tcp://" + host + ":" + oren_int_to_string(port), timeout_ms)
}

fn listen_tcp(host, port, timeout_ms) {
    if host == nil { return oren_err(4, "std:net/avm/socket.listen_tcp: host is nil") }
    return open("tcp-listen://" + host + ":" + oren_int_to_string(port), timeout_ms)
}

fn open_udp(host, port, timeout_ms) {
    if host == nil { return oren_err(4, "std:net/avm/socket.open_udp: host is nil") }
    return open("udp://" + host + ":" + oren_int_to_string(port), timeout_ms)
}

fn write(session_id, data, timeout_ms) {
    return oren_vnet_session_write(session_id, data, timeout_ms)
}

fn read(session_id, max_len, timeout_ms) {
    return oren_vnet_session_read(session_id, max_len, timeout_ms)
}

fn poll(session_id, events, timeout_ms) {
    return oren_vnet_session_poll(session_id, events, timeout_ms)
}

fn select(session_id, events, timeout_ms) {
    return poll(session_id, events, timeout_ms)
}

fn poll_read(session_id, timeout_ms) {
    return poll(session_id, 1, timeout_ms)
}

fn poll_write(session_id, timeout_ms) {
    return poll(session_id, 2, timeout_ms)
}

fn select_read(session_id, timeout_ms) {
    return select(session_id, 1, timeout_ms)
}

fn select_write(session_id, timeout_ms) {
    return select(session_id, 2, timeout_ms)
}

fn accept(listener_session_id, timeout_ms) {
    return oren_vnet_session_accept(listener_session_id, timeout_ms)
}

fn close(session_id) {
    return oren_vnet_session_close(session_id)
}
