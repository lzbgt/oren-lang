// AVM-safe WebSocket facade over host-backed virtual network sessions.
//
// OBC opens `ws://` virtual sessions and exchanges payload bytes/text. The iOS
// SDK owns the HTTP upgrade, masking/framing, host sockets, policy, and budgets.

import events "std:avm/events"
import socket "std:net/avm/socket"
import neturl "std:net/url"

struct Session {
    id
}

trait WebSocketSession {
    fn send(self, data, timeout_ms);
    fn send_text(self, text, timeout_ms);
    fn recv(self, max_len, timeout_ms);
    fn recv_bytes(self, max_len, timeout_ms);
    fn recv_text(self, max_len, timeout_ms);
    fn close(self);
    fn select(self, event_mask, timeout_ms);
    fn wait_readable(self, timeout_ms);
    fn wait_writable(self, timeout_ms);
}

fn event_read() { return events.event_read() }
fn event_write() { return events.event_write() }
fn event_read_write() { return events.event_read_write() }

fn connect_spec(spec, timeout_ms): Session {
    if spec == nil { return oren_err(4, "std:net/avm/ws.connect_spec: spec is nil") }
    return socket.open(spec, timeout_ms)
}

fn connect(host, port, path, timeout_ms): Session {
    if host == nil { return oren_err(4, "std:net/avm/ws.connect: host is nil") }
    var authority = neturl.authority_from_host_port(host, port)
    if oren_is_err(authority) { return authority }
    var p = path
    if p == nil || p == "" { p = "/" }
    if oren_string_slice(p, 0, 1) != "/" { p = "/" + p }
    return connect_spec("ws://" + authority + p, timeout_ms)
}

fn send(session_id, data, timeout_ms) {
    return socket.write(session_id, data, timeout_ms)
}

fn send_text(session_id, text, timeout_ms) {
    if text == nil { return oren_err(4, "std:net/avm/ws.send_text: text is nil") }
    return send(session_id, text, timeout_ms)
}

fn recv(session_id, max_len, timeout_ms) {
    return recv_bytes(session_id, max_len, timeout_ms)
}

fn recv_bytes(session_id, max_len, timeout_ms) {
    return socket.read_kind(session_id, max_len, 2, timeout_ms)
}

fn recv_text(session_id, max_len, timeout_ms) {
    var data = socket.read_kind(session_id, max_len, 1, timeout_ms)
    if oren_is_err(data) { return data }
    return oren_string_from_bytes_slice(data, 0, oren_bytes_len(data))
}

fn close(session_id) {
    return socket.close(session_id)
}

fn select(session_id, event_mask, timeout_ms) {
    return events.select([{
        "kind": "net",
        "session_id": session_id,
        "events": event_mask
    }], timeout_ms)
}

fn wait_readable(session_id, timeout_ms) {
    var ev = select(session_id, events.event_read(), timeout_ms)
    if oren_is_err(ev) { return ev }
    if ev == nil { return 0 }
    if (ev["ready"] & events.event_read()) != 0 { return 1 }
    return 0
}

fn wait_writable(session_id, timeout_ms) {
    var ev = select(session_id, events.event_write(), timeout_ms)
    if oren_is_err(ev) { return ev }
    if ev == nil { return 0 }
    if (ev["ready"] & events.event_write()) != 0 { return 1 }
    return 0
}

impl WebSocketSession for Session {
    fn send(self, data, timeout_ms) { return send(self, data, timeout_ms) }
    fn send_text(self, text, timeout_ms) { return send_text(self, text, timeout_ms) }
    fn recv(self, max_len, timeout_ms) { return recv(self, max_len, timeout_ms) }
    fn recv_bytes(self, max_len, timeout_ms) { return recv_bytes(self, max_len, timeout_ms) }
    fn recv_text(self, max_len, timeout_ms) { return recv_text(self, max_len, timeout_ms) }
    fn close(self) { return close(self) }
    fn select(self, event_mask, timeout_ms) { return select(self, event_mask, timeout_ms) }
    fn wait_readable(self, timeout_ms) { return wait_readable(self, timeout_ms) }
    fn wait_writable(self, timeout_ms) { return wait_writable(self, timeout_ms) }
}
