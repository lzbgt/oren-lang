// std/net/host (rolling)
//
// Goal:
// - Keep small, shared helpers for higher-level net modules (http/ws/tls).
// - Avoid duplicating host parsing and DNS resolution logic across modules.
//
// Scope (v0):
// - IPv4-literal heuristic
// - "host -> IPv4" resolution via std:net/dns (A queries only)
//
// Return shape convention:
// - {"ok":1, "ip": string, "owned":0|1} (owned=1 => caller must free(ip))
// - {"ok":0, "err": string}

import dns "std:net/dns"

fn _err_result(r, fallback) {
    var msg = r["err"]
    if msg == nil || msg == "" { msg = fallback }
    return oren_err(4, msg)
}

fn looks_like_ipv4(host) {
    // Conservative "is this probably an IPv4 literal?" check.
    // (We keep it cheap; `tcp.connect` still validates.)
    if host == nil { return 0 }
    var n = oren_string_len(host)
    if n <= 0 || n > 15 { return 0 }
    var dots = 0
    var i = 0
    while i < n {
        var b = ptr_get_byte(host + i) & 255
        if b == 46 {
            dots = dots + 1
        } else if b < 48 || b > 57 {
            return 0
        }
        i = i + 1
    }
    if dots != 3 { return 0 }
    return 1
}

fn resolve_host_ipv4(who, host, timeout_ms, resolver) {
    // Returns:
    // - {"ok":1, "ip": string, "owned":0|1} (owned=1 => caller must free(ip))
    // - {"ok":0, "err": string}
    //
    // Notes:
    // - DNS is IPv4-only (A query) in rolling v0.
    // - If `resolver` is nil, uses `dns.default_resolver(timeout_ms)` and frees it before returning.
    if who == nil { who = "net" }
    if host == nil { return {"ok": 0, "err": who + ": host is nil"} }
    if looks_like_ipv4(host) == 1 { return {"ok": 1, "ip": host, "owned": 0} }

    var r0 = 0
    if resolver != nil {
        r0 = dns.resolve_a(resolver, host)
    } else {
        var dr = dns.default_resolver(timeout_ms)
        if oren_map_get_str(dr, "ok") != 1 {
            return {"ok": 0, "err": who + ": hostname requires DNS (set OREN_DNS_SERVER or pass resolver): " + oren_map_get_str(dr, "err")}
        }
        var rconf = oren_map_get_str(dr, "resolver")
        r0 = dns.resolve_a(rconf, host)
        dns.resolver_free(rconf)
    }

    if oren_map_get_str(r0, "ok") != 1 { return {"ok": 0, "err": who + ": dns failed: " + oren_map_get_str(r0, "err")} }
    var ip = oren_map_get_str(r0, "ip")
    if ip == 0 { return {"ok": 0, "err": who + ": dns returned nil ip"} }
    return {"ok": 1, "ip": ip, "owned": 1}
}

fn try_resolve_host_ipv4(who, host, timeout_ms, resolver) {
    var r = resolve_host_ipv4(who, host, timeout_ms, resolver)
    if r["ok"] == 1 { return {"ip": r["ip"], "owned": r["owned"]} }
    return _err_result(r, "host.resolve_host_ipv4 failed")
}
