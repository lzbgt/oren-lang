// AVM-safe network facade.
//
// This module is intentionally small: OBC programs call portable stdlib helpers,
// while the host app controls actual networking and injects bytes through AVM
// VirtualNET. It must not import the socket/TLS-backed std:net modules.

fn _err_msg(v, fallback) {
    var msg = oren_err_msg(v)
    if msg == nil || msg == "" { return fallback }
    return msg
}

fn get_text(url) {
    if url == nil { return {"ok": 0, "code": 4, "err": "std:net/avm.get_text: url is nil"} }
    var body = oren_net_get(url)
    if oren_is_err(body) {
        return {
            "ok": 0,
            "code": oren_err_code(body),
            "err": _err_msg(body, "std:net/avm.get_text failed")
        }
    }
    return {"ok": 1, "v": body}
}

fn try_get_text(url) {
    var r = get_text(url)
    if r["ok"] == 1 { return r["v"] }
    var code = r["code"]
    if oren_type_tag(code) != 1 { code = 4 }
    var msg = r["err"]
    if msg == nil || msg == "" { msg = "std:net/avm.try_get_text failed" }
    return oren_err(code, msg)
}

fn get(url) {
    var r = get_text(url)
    if r["ok"] != 1 { return 0 }
    return r["v"]
}

fn session_open(spec, timeout_ms) {
    if spec == nil { return oren_err(4, "std:net/avm.session_open: spec is nil") }
    return oren_vnet_session_open(spec, timeout_ms)
}

fn session_write(session_id, data, timeout_ms) {
    return oren_vnet_session_write(session_id, data, timeout_ms)
}

fn session_read(session_id, max_len, timeout_ms) {
    return oren_vnet_session_read(session_id, max_len, timeout_ms)
}

fn session_close(session_id) {
    return oren_vnet_session_close(session_id)
}
