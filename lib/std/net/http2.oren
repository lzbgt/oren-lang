// std/net/http2 (rolling)
//
// Goal:
// - Provide a small, deterministic HTTP/2 core to build on top of `std:net/tls`.
// - Start with **framing** (RFC 7540) primitives:
//   - client connection preface (bytes)
//   - frame header encode/decode
//
// This module intentionally does NOT implement:
// - HPACK (header compression)
// - stream state machine
// - flow control
//
// Those will be layered later once this framing core is stable and tested across Tier‑1.

// --- Constants (RFC 7540) ---

// Frame types
var FRAME_DATA = 0
var FRAME_HEADERS = 1
var FRAME_PRIORITY = 2
var FRAME_RST_STREAM = 3
var FRAME_SETTINGS = 4
var FRAME_PUSH_PROMISE = 5
var FRAME_PING = 6
var FRAME_GOAWAY = 7
var FRAME_WINDOW_UPDATE = 8
var FRAME_CONTINUATION = 9

// Flags (per-frame; shared ones)
var FLAG_ACK = 1
var FLAG_END_STREAM = 1
var FLAG_END_HEADERS = 4
var FLAG_PADDED = 8
var FLAG_PRIORITY = 32

// SETTINGS identifiers (RFC 7540 §6.5.2)
var SETTINGS_HEADER_TABLE_SIZE = 1
var SETTINGS_ENABLE_PUSH = 2
var SETTINGS_MAX_CONCURRENT_STREAMS = 3
var SETTINGS_INITIAL_WINDOW_SIZE = 4
var SETTINGS_MAX_FRAME_SIZE = 5
var SETTINGS_MAX_HEADER_LIST_SIZE = 6

// Client connection preface (exact bytes).
var CLIENT_PREFACE = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
var CLIENT_PREFACE_LEN = 24

fn _err_from_record(r, fallback) {
    var msg = r["err"]
    if msg == nil || msg == "" { msg = fallback }
    return oren_err(4, msg)
}

fn _u16_be_read(ptr0, off) {
    var b0 = ptr_get_byte(ptr0 + off + 0) & 255
    var b1 = ptr_get_byte(ptr0 + off + 1) & 255
    return (b0 << 8) | b1
}

fn _u16_be_write(ptr0, off, v) {
    if v < 0 { v = 0 }
    if v > 65535 { v = v % 65536 }
    ptr_set_byte(ptr0 + off + 0, (v >> 8) & 255)
    ptr_set_byte(ptr0 + off + 1, v & 255)
    return nil
}

fn _u24_be_write(ptr0, off, v) {
    // Writes v as big-endian 24-bit (v mod 2^24).
    //
    // Caller must ensure ptr0 is a valid writable pointer.
    if v < 0 { v = 0 }
    if v >= 16777216 { v = v % 16777216 }
    ptr_set_byte(ptr0 + off + 0, (v >> 16) & 255)
    ptr_set_byte(ptr0 + off + 1, (v >> 8) & 255)
    ptr_set_byte(ptr0 + off + 2, v & 255)
    return nil
}

fn _u24_be_read(ptr0, off) {
    var b0 = ptr_get_byte(ptr0 + off + 0) & 255
    var b1 = ptr_get_byte(ptr0 + off + 1) & 255
    var b2 = ptr_get_byte(ptr0 + off + 2) & 255
    return (b0 << 16) | (b1 << 8) | b2
}

fn _u32_be_read(ptr0, off) {
    var b0 = ptr_get_byte(ptr0 + off + 0) & 255
    var b1 = ptr_get_byte(ptr0 + off + 1) & 255
    var b2 = ptr_get_byte(ptr0 + off + 2) & 255
    var b3 = ptr_get_byte(ptr0 + off + 3) & 255
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

fn _u32_be_write(ptr0, off, v) {
    if v < 0 { v = 0 }
    ptr_set_byte(ptr0 + off + 0, (v >> 24) & 255)
    ptr_set_byte(ptr0 + off + 1, (v >> 16) & 255)
    ptr_set_byte(ptr0 + off + 2, (v >> 8) & 255)
    ptr_set_byte(ptr0 + off + 3, v & 255)
    return nil
}

fn write_frame_header(ptr0, length, typ, flags, stream_id) {
    // Encode an HTTP/2 frame header (9 bytes) into ptr0[0..9).
    //
    // - length: 24-bit unsigned
    // - typ: 8-bit
    // - flags: 8-bit
    // - stream_id: 31-bit (highest bit reserved, must be 0)
    if ptr0 == 0 { return 0 - 22 } // EINVAL
    if length < 0 || length > 16777215 { return 0 - 22 }
    if typ < 0 || typ > 255 { return 0 - 22 }
    if flags < 0 || flags > 255 { return 0 - 22 }
    if oren_type_tag(stream_id) == 0 { stream_id = 0 }
    if stream_id < 0 { return 0 - 22 }
    if stream_id > 2147483647 { return 0 - 22 }

    _u24_be_write(ptr0, 0, length)
    ptr_set_byte(ptr0 + 3, typ & 255)
    ptr_set_byte(ptr0 + 4, flags & 255)
    // Stream identifier is 31 bits, big-endian u32 with reserved bit cleared.
    _u32_be_write(ptr0, 5, stream_id & 2147483647)
    return 0
}

fn try_write_frame_header(ptr0, length, typ, flags, stream_id) {
    var rc = write_frame_header(ptr0, length, typ, flags, stream_id)
    if rc == 0 { return 0 }
    return oren_err(0 - rc, "http2.write_frame_header failed (errno=" + oren_int_to_string(0 - rc) + ")")
}

fn parse_frame_header(ptr0) {
    // Decode an HTTP/2 frame header (9 bytes) from ptr0[0..9).
    //
    // Returns:
    // - {"ok":1,"len":int,"type":int,"flags":int,"stream":int}
    // - {"ok":0,"err":string}
    if ptr0 == 0 { return {"ok": 0, "err": "http2.parse_frame_header: nil ptr"} }
    var length = _u24_be_read(ptr0, 0)
    var typ = ptr_get_byte(ptr0 + 3) & 255
    var flags = ptr_get_byte(ptr0 + 4) & 255
    var sid_raw = _u32_be_read(ptr0, 5)
    var stream_id = sid_raw & 2147483647
    return {"ok": 1, "len": length, "type": typ, "flags": flags, "stream": stream_id}
}

fn try_parse_frame_header(ptr0) {
    var r = parse_frame_header(ptr0)
    if r["ok"] == 1 {
        return {"len": r["len"], "type": r["type"], "flags": r["flags"], "stream": r["stream"]}
    }
    return _err_from_record(r, "http2.parse_frame_header failed")
}

// --- SETTINGS payload helpers (RFC 7540 §6.5) ---

fn settings_payload_from_list(pairs) {
    // Encode a SETTINGS payload from a list of pairs `[[id, value], ...]`.
    //
    // This is deterministic (list order) and avoids depending on map iteration order.
    if pairs == nil { pairs = [] }
    var n = oren_list_len(pairs)
    if n < 0 { n = 0 }
    var out = oren_u8_buf_new_uninit(n * 6)
    if oren_is_err(out) { return out }
    var p = native_buf_data_ptr(out)
    if p == 0 && (n * 6) > 0 { return oren_err(4, "http2.settings_payload_from_list: nil ptr") }
    var i = 0
    while i < n {
        var it = pairs[i]
        if it == nil || oren_list_len(it) < 2 { return oren_err(4, "http2.settings_payload_from_list: expects [id, value] pairs") }
        var id = it[0]
        var val = it[1]
        if id < 0 || id > 65535 { return oren_err(4, "http2.settings_payload_from_list: id out of range") }
        if val < 0 { return oren_err(4, "http2.settings_payload_from_list: value out of range") }
        // Values are 32-bit unsigned in the wire format (we store as Oren int).
        if val > 4294967295 { return oren_err(4, "http2.settings_payload_from_list: value out of range") }
        _u16_be_write(p, i * 6 + 0, id)
        _u32_be_write(p, i * 6 + 2, val)
        i = i + 1
    }
    return out
}

fn parse_settings_payload(payload_bytes) {
    // Decode a SETTINGS payload into a map<int,int>.
    //
    // Returns:
    // - {"ok":1,"settings":map}
    // - {"ok":0,"err":string}
    if payload_bytes == nil { payload_bytes = oren_u8_buf_new(0) }
    var n = oren_buf_len(payload_bytes)
    if oren_is_err(n) { return {"ok": 0, "err": "http2.parse_settings_payload: bad payload"} }
    if n % 6 != 0 { return {"ok": 0, "err": "http2.parse_settings_payload: length must be multiple of 6"} }
    var p = native_buf_data_ptr(payload_bytes)
    if p == 0 && n > 0 { return {"ok": 0, "err": "http2.parse_settings_payload: nil ptr"} }
    var m = {}
    var i = 0
    while i < n {
        var id = _u16_be_read(p, i)
        var val = _u32_be_read(p, i + 2)
        // "last wins" for duplicates (simplest contract).
        oren_map_set_int(m, id, val)
        i = i + 6
    }
    return {"ok": 1, "settings": m}
}

fn try_parse_settings_payload(payload_bytes) {
    var r = parse_settings_payload(payload_bytes)
    if r["ok"] == 1 { return r["settings"] }
    return _err_from_record(r, "http2.parse_settings_payload failed")
}
