// std/net/dns (rolling)
//
// Goal (v0):
// - Provide a minimal DNS client substrate on top of `std:net/udp`.
// - Keep it syscall-first and testable under loopback without external network access.
//
// Current scope:
// - DNS over UDP
// - A (IPv4) queries only
// - Caller can supply server (ip, port) explicitly
// - Best-effort "default resolver" for hostname URLs:
//   - reads `OREN_DNS_SERVER` env var, else
//   - parses `/etc/resolv.conf` (first `nameserver <ipv4>`)
//
// This is a prerequisite for:
// - HTTPS / WSS (TLS SNI + certificate validation needs hostname)
// - Hostname URLs (HTTP client should not be IP-only forever)

import udp "std:net/udp"
import rand "std:crypto/rand"

fn _err_result(r, fallback) {
    var msg = r["err"]
    if msg == nil || msg == "" { msg = fallback }
    return oren_err(4, msg)
}

// --- Resolver helpers (small stable surface) ---

fn resolver(server_ip, server_port, timeout_ms) {
    // Return a small resolver config object (map).
    //
    // Fields:
    // - server_ip (string)
    // - server_port (int)
    // - timeout_ms (int)
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 2000 }
    if timeout_ms < 0 { timeout_ms = 0 }
    if oren_type_tag(server_port) == 0 || server_port <= 0 || server_port > 65535 {
        server_port = 53
    }
    return {
        "server_ip": server_ip,
        "server_port": server_port,
        "timeout_ms": timeout_ms,
        // Ownership model (rolling):
        // - If `server_ip_owned==1`, the resolver "owns" server_ip and the caller should free it via `dns.resolver_free`.
        // - Default is 0 for manually-constructed resolvers (string literals, stable buffers, etc).
        "server_ip_owned": 0,
    }
}

fn resolve_a(res, name) {
    // Resolve an A record using a resolver config map returned by `dns.resolver(...)`.
    //
    // Returns the same shape as `dns.query_a`:
    // - {"ok":1, "ip": "<ipv4>"} on success
    // - {"ok":0, "err": "..."} on failure
    if res == nil { return {"ok": 0, "err": "dns.resolve_a: resolver is nil"} }
    var ip = res["server_ip"]
    var port = res["server_port"]
    var timeout_ms = res["timeout_ms"]
    return query_a(name, ip, port, timeout_ms)
}

fn try_resolve_a(res, name) {
    var r = resolve_a(res, name)
    if r["ok"] == 1 { return r["ip"] }
    return _err_result(r, "dns.resolve_a failed")
}

fn resolver_free(res) {
    // Free any owned resources inside a resolver map returned by `dns.resolver` / `dns.default_resolver`.
    //
    // This does NOT free the map itself (maps are runtime-managed); it only frees the owned strings.
    if res == nil { return 0 }
    if res["server_ip_owned"] == 1 {
        var ip = res["server_ip"]
        if ip != nil && ip != 0 { free(ip) }
        res["server_ip"] = nil
        res["server_ip_owned"] = 0
    }
    return 0
}

fn _ascii_lower(b) {
    if b >= 65 && b <= 90 { return b + 32 } // A..Z -> a..z
    return b
}

fn _is_space(b) {
    return b == 32 || b == 9
}

fn _is_eol(b) {
    return b == 10 || b == 13
}

fn _find_nameserver_ipv4_in_resolv_conf(s) {
    // Return an IPv4 string (malloc'd) or 0.
    if s == 0 { return 0 }
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        // Skip leading whitespace.
        while i < n && _is_space(ptr_get_byte(s + i) & 255) { i = i + 1 }
        if i >= n { break }

        var b0 = ptr_get_byte(s + i) & 255
        // Comment or empty line.
        if b0 == 35 || b0 == 59 { // '#' or ';'
            while i < n && _is_eol(ptr_get_byte(s + i) & 255) == 0 { i = i + 1 }
            while i < n && _is_eol(ptr_get_byte(s + i) & 255) == 1 { i = i + 1 }
            continue
        }
        if _is_eol(b0) {
            i = i + 1
            continue
        }

        // Match "nameserver" (case-insensitive ASCII).
        // Length = 10.
        if i + 10 <= n {
            var ok = 1
            // Compare bytes with ascii-lower.
            var j = 0
            while j < 10 {
                var bj = ptr_get_byte(s + i + j) & 255
                if _ascii_lower(bj) != ptr_get_byte("nameserver" + j) {
                    ok = 0
                    break
                }
                j = j + 1
            }
            if ok == 1 {
                // Require whitespace after directive.
                if i + 10 < n && _is_space(ptr_get_byte(s + i + 10) & 255) == 1 {
                    i = i + 10
                    while i < n && _is_space(ptr_get_byte(s + i) & 255) { i = i + 1 }
                    var start = i
                    while i < n {
                        var b = ptr_get_byte(s + i) & 255
                        if _is_space(b) || _is_eol(b) || b == 35 || b == 59 { break } // ws/eol/comment
                        i = i + 1
                    }
                    var end = i
                    if end > start {
                        var tok = oren_string_slice(s, start, end)
                        if tok != 0 {
                            // v0: ignore IPv6 nameservers.
                            var tl = oren_string_len(tok)
                            var k = 0
                            var has_colon = 0
                            while k < tl {
                                if (ptr_get_byte(tok + k) & 255) == 58 { has_colon = 1; break } // ':'
                                k = k + 1
                            }
                            if has_colon == 0 { return tok }
                            free(tok)
                        }
                    }
                }
            }
        }

        // Skip to next line.
        while i < n && _is_eol(ptr_get_byte(s + i) & 255) == 0 { i = i + 1 }
        while i < n && _is_eol(ptr_get_byte(s + i) & 255) == 1 { i = i + 1 }
    }
    return 0
}

// --- Windows system resolver (IPv4) ---
//
// On Windows, `/etc/resolv.conf` does not exist. For hostname URLs we want a best-effort
// default resolver without requiring `OREN_DNS_SERVER` to be set.
//
// Strategy (rolling):
// - Query the configured IPv4 DNS server via `GetNetworkParams` (iphlpapi).
// - Return the first IPv4 nameserver string (like "192.168.1.1") as a malloc'd cstr0.
//
// Notes:
// - This keeps the rest of the DNS client deterministic: `dns.query_a` still speaks UDP to an explicit server.
// - This avoids calling external tools (`ipconfig`) and avoids parsing localized text.

import iphlp "std:ffi/iphlpapi"

@cfg(os="windows")
// FFI is centralized in `std:ffi/iphlpapi`.
// Note: `GetNetworkParams` returns a u32 Win32 error code.

@cfg(os="windows")
@abi
struct WIN_IP_ADDR_STRING {
    Next: *u8,
    IpAddress: u8[16],
    IpMask: u8[16],
    Context: u32,
}

@cfg(os="windows")
@abi
struct WIN_FIXED_INFO {
    HostName: u8[132],
    DomainName: u8[132],
    CurrentDnsServer: *u8,
    DnsServerList: WIN_IP_ADDR_STRING,
    NodeType: u32,
    ScopeId: u8[260],
    EnableRouting: u32,
    EnableProxy: u32,
    EnableDns: u32,
}

@cfg(os="windows")
fn _win_dns_default_nameserver_ipv4() {
    // Returns malloc'd IPv4 string or 0.
    // ERROR_BUFFER_OVERFLOW = 111, NO_ERROR = 0.
    var lenp = malloc(8)
    if lenp == 0 { return 0 }
    oren_ptr_set_u32_le(lenp, 0)

    var rc = iphlp.GetNetworkParams(0, lenp)
    var need = oren_ptr_get_u32_le(lenp)
    if rc != 111 && rc != 0 { free(lenp); return 0 }
    if need <= 0 || need > 1048576 { free(lenp); return 0 } // 1 MiB sanity cap

    var buf = malloc(need)
    if buf == 0 { free(lenp); return 0 }
    oren_ptr_set_u32_le(lenp, need)
    rc = iphlp.GetNetworkParams(buf, lenp)
    free(lenp)
    if rc != 0 { free(buf); return 0 }

    // Extract an IPv4 nameserver from FIXED_INFO.
    //
    // Note: `@abi` layout lowering runs after module linking, so type names may be linker-prefixed.
    // The `oren_abi_offsetof` builtin supports resolving bare names via a unique suffix match.
    //
    // Implementation notes:
    // - `DnsServerList` is an IP_ADDR_STRING node embedded in FIXED_INFO. It can be an empty/zero
    //   entry; the real server may be in the linked list.
    // - `CurrentDnsServer` points at the currently-used node within that list; prefer it when present.
    // - IP_ADDR_STRING.IpAddress is a fixed `char[16]` buffer; do not scan past 16 bytes even if the
    //   content is malformed (avoid reading beyond `buf`).
    fn _cstr0_len_max(p, max_n) {
        if p == 0 { return 0 }
        if max_n <= 0 { return 0 }
        var i = 0
        while i < max_n {
            if (ptr_get_byte(p + i) & 255) == 0 { return i }
            i = i + 1
        }
        return max_n
    }
    fn _looks_like_ipv4_cstr0(p, max_n) {
        // Cheap IPv4 literal check:
        // - must contain at least one dot
        // - only digits + dots (no spaces)
        var n = _cstr0_len_max(p, max_n)
        if n < 7 || n > 15 { return false }
        var has_dot = 0
        var i = 0
        while i < n {
            var b = ptr_get_byte(p + i) & 255
            if b == 46 { has_dot = 1 } // '.'
            else if b >= 48 && b <= 57 { /* digit */ }
            else { return false }
            i = i + 1
        }
        return has_dot == 1
    }
    var off_list = oren_abi_offsetof("WIN_FIXED_INFO", "DnsServerList")
    var off_cur = oren_abi_offsetof("WIN_FIXED_INFO", "CurrentDnsServer")
    var off_next = oren_abi_offsetof("WIN_IP_ADDR_STRING", "Next")
    var off_ip = oren_abi_offsetof("WIN_IP_ADDR_STRING", "IpAddress")

    var node = buf + off_list
    var cur = ptr_get(buf + off_cur)
    if cur != 0 { node = cur }

    var tries = 0
    while node != 0 && tries < 16 {
        var ip_ptr = node + off_ip
        if _looks_like_ipv4_cstr0(ip_ptr, 16) {
            var n = _cstr0_len_max(ip_ptr, 16)
            var out = oren_string_slice(ip_ptr, 0, n)
            free(buf)
            return out
        }
        var next = ptr_get(node + off_next)
        if next == 0 { break }
        node = next
        tries = tries + 1
    }

    free(buf)
    return 0
}

@cfg(os="windows")
fn default_resolver(timeout_ms) {
    // Best-effort resolver selection for hostname URLs (Windows).
    //
    // Source order:
    // 1) `OREN_DNS_SERVER` env var (value is an IPv4 string)
    // 2) Windows system config via iphlpapi `GetNetworkParams` (first IPv4 DNS server)
    //
    // Returns:
    // - {"ok":1, "resolver": <map>, "src": "env"|"windows"} on success
    // - {"ok":0, "err": "..."} on failure
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 2000 }
    if timeout_ms < 0 { timeout_ms = 0 }

    var env_ip = oren_env("OREN_DNS_SERVER")
    if env_ip != nil && env_ip != 0 && env_ip != "" {
        var r = resolver(env_ip, 53, timeout_ms)
        r["server_ip_owned"] = 1
        return {"ok": 1, "resolver": r, "src": "env"}
    }

    var ip = _win_dns_default_nameserver_ipv4()
    if ip == 0 {
        return {"ok": 0, "err": "dns.default_resolver: missing OREN_DNS_SERVER and cannot read Windows system resolver"}
    }
    var r2 = resolver(ip, 53, timeout_ms)
    r2["server_ip_owned"] = 1
    return {"ok": 1, "resolver": r2, "src": "windows"}
}

@cfg(not_os="windows")
fn default_resolver(timeout_ms) {
    // Best-effort resolver selection for hostname URLs.
    //
    // Source order:
    // 1) `OREN_DNS_SERVER` env var (value is an IPv4 string)
    // 2) `/etc/resolv.conf` first `nameserver <ipv4>`
    //
    // Returns:
    // - {"ok":1, "resolver": <map>, "src": "env"|"resolv.conf"} on success
    // - {"ok":0, "err": "..."} on failure
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 2000 }
    if timeout_ms < 0 { timeout_ms = 0 }

    var env_ip = oren_env("OREN_DNS_SERVER")
    if env_ip != nil && env_ip != 0 && env_ip != "" {
        var r = resolver(env_ip, 53, timeout_ms)
        r["server_ip_owned"] = 1
        return {"ok": 1, "resolver": r, "src": "env"}
    }

    var rc = oren_read_file("/etc/resolv.conf")
    if oren_is_err(rc) {
        return {"ok": 0, "err": "dns.default_resolver: missing OREN_DNS_SERVER and cannot read /etc/resolv.conf"}
    }

    var ip = _find_nameserver_ipv4_in_resolv_conf(rc)
    free(rc)
    if ip == 0 {
        return {"ok": 0, "err": "dns.default_resolver: no IPv4 nameserver found (set OREN_DNS_SERVER=...)"}
    }
    var r2 = resolver(ip, 53, timeout_ms)
    r2["server_ip_owned"] = 1
    return {"ok": 1, "resolver": r2, "src": "resolv.conf"}
}

fn _u16be_get(p, off) {
    var hi = ptr_get_byte(p + off) & 255
    var lo = ptr_get_byte(p + off + 1) & 255
    return (hi << 8) | lo
}

fn _u16be_set(p, off, v) {
    ptr_set_byte(p + off + 0, (v >> 8) & 255)
    ptr_set_byte(p + off + 1, v & 255)
    return 0
}

fn _write_qname(buf, cap, off, name) {
    // Write DNS QNAME encoding (labels) for an ASCII hostname like "a.b.c".
    // Returns {ok:1, off:<new_off>} or {ok:0, err:string}.
    if name == nil { return {"ok": 0, "err": "dns.qname: name is nil"} }
    var n = oren_string_len(name)
    if n <= 0 { return {"ok": 0, "err": "dns.qname: empty name"} }

    // Reject names that would obviously encode to an empty label (leading dot).
    if (ptr_get_byte(iadd(name, 0)) & 255) == 46 { // '.'
        return {"ok": 0, "err": "dns.qname: leading dot"}
    }

    var label_start = 0
    var i = 0
    var out = off
    // Iterate to n inclusive by treating i==n as '.' terminator.
    while i <= n {
        var b = 46
        if i < n { b = ptr_get_byte(iadd(name, i)) & 255 }
        if b == 46 { // '.'
            var label_len = i - label_start
            if label_len == 0 {
                // Trailing dot (FQDN) is allowed; consecutive dots are not.
                if i == n { break }
                return {"ok": 0, "err": "dns.qname: empty label"}
            }
            if label_len > 63 { return {"ok": 0, "err": "dns.qname: label too long"} }
            if out + 1 + label_len + 1 > cap { return {"ok": 0, "err": "dns.qname: buffer too small"} }
            ptr_set_byte(buf + out, label_len)
            out = out + 1
            var j = 0
            while j < label_len {
                ptr_set_byte(buf + out + j, ptr_get_byte(iadd(name, label_start + j)))
                j = j + 1
            }
            out = out + label_len
            label_start = i + 1
        } else {
            // Only allow [a-zA-Z0-9-] for v0. (Enough for basic hostnames; IDNA is out of scope.)
            var ok = 0
            if b >= 48 && b <= 57 { ok = 1 } // 0..9
            else if b >= 65 && b <= 90 { ok = 1 } // A..Z
            else if b >= 97 && b <= 122 { ok = 1 } // a..z
            else if b == 45 { ok = 1 } // '-'
            if ok == 0 {
                return {"ok": 0, "err": "dns.qname: invalid byte in name"}
            }
        }
        i = i + 1
    }

    if out + 1 > cap { return {"ok": 0, "err": "dns.qname: buffer too small"} }
    ptr_set_byte(buf + out, 0)
    out = out + 1
    return {"ok": 1, "off": out}
}

fn _skip_name(buf, len, off) {
    // Skip a DNS NAME field at buf[off..], including compression pointers.
    // Returns {ok:1, off:<new_off>} or {ok:0, err:string}.
    var i = off
    while 1 {
        if i >= len { return {"ok": 0, "err": "dns.name: truncated"} }
        var b = ptr_get_byte(buf + i) & 255
        if b == 0 {
            return {"ok": 1, "off": i + 1}
        }
        // Compression pointer: 11xxxxxx xxxxxxxx
        if (b & 192) == 192 {
            if i + 1 >= len { return {"ok": 0, "err": "dns.name: truncated pointer"} }
            return {"ok": 1, "off": i + 2}
        }
        // Label
        if b > 63 { return {"ok": 0, "err": "dns.name: invalid label length"} }
        i = i + 1 + b
    }
}

fn _write_u8_dec(out, off, v) {
    // Write decimal for 0..255; return new off.
    var x = v & 255
    if x >= 100 {
        ptr_set_byte(out + off + 0, 48 + (x / 100))
        x = x % 100
        ptr_set_byte(out + off + 1, 48 + (x / 10))
        ptr_set_byte(out + off + 2, 48 + (x % 10))
        return off + 3
    }
    if x >= 10 {
        ptr_set_byte(out + off + 0, 48 + (x / 10))
        ptr_set_byte(out + off + 1, 48 + (x % 10))
        return off + 2
    }
    ptr_set_byte(out + off + 0, 48 + x)
    return off + 1
}

fn _ipv4_to_string(b0, b1, b2, b3) {
    // Max length: "255.255.255.255" = 15 + NUL
    var out = malloc_k(16, 1)
    if out == 0 { return 0 }
    var off = 0
    off = _write_u8_dec(out, off, b0)
    ptr_set_byte(out + off, 46); off = off + 1
    off = _write_u8_dec(out, off, b1)
    ptr_set_byte(out + off, 46); off = off + 1
    off = _write_u8_dec(out, off, b2)
    ptr_set_byte(out + off, 46); off = off + 1
    off = _write_u8_dec(out, off, b3)
    ptr_set_byte(out + off, 0)
    return out
}

fn _parse_response_a(buf, n, want_id) {
    // Returns {ok:1, ip:string} or {ok:0, err:string}.
    if buf == 0 { return {"ok": 0, "err": "dns.resp: buf is nil"} }
    if n < 12 { return {"ok": 0, "err": "dns.resp: too short"} }

    var id = _u16be_get(buf, 0)
    if id != want_id { return {"ok": 0, "err": "dns.resp: id mismatch"} }

    var flags = _u16be_get(buf, 2)
    if (flags & 32768) == 0 { return {"ok": 0, "err": "dns.resp: not a response"} } // QR
    var rcode = flags & 15
    if rcode != 0 { return {"ok": 0, "err": "dns.resp: rcode=" + oren_int_to_string(rcode)} }

    var qd = _u16be_get(buf, 4)
    var an = _u16be_get(buf, 6)
    if qd <= 0 { return {"ok": 0, "err": "dns.resp: no question"} }
    if an <= 0 { return {"ok": 0, "err": "dns.resp: no answers"} }

    var off = 12
    var qi = 0
    while qi < qd {
        var sk = _skip_name(buf, n, off)
        if sk["ok"] != 1 { return {"ok": 0, "err": "dns.resp: bad question name: " + sk["err"]} }
        off = sk["off"]
        if off + 4 > n { return {"ok": 0, "err": "dns.resp: truncated question"} }
        off = off + 4 // QTYPE + QCLASS
        qi = qi + 1
    }

    var ai = 0
    while ai < an {
        var sk2 = _skip_name(buf, n, off)
        if sk2["ok"] != 1 { return {"ok": 0, "err": "dns.resp: bad answer name: " + sk2["err"]} }
        off = sk2["off"]
        if off + 10 > n { return {"ok": 0, "err": "dns.resp: truncated answer header"} }

        var typ = _u16be_get(buf, off + 0)
        var cls = _u16be_get(buf, off + 2)
        // ttl at +4 (ignored)
        var rdlen = _u16be_get(buf, off + 8)
        off = off + 10
        if off + rdlen > n { return {"ok": 0, "err": "dns.resp: truncated rdata"} }

        if typ == 1 && cls == 1 && rdlen == 4 {
            var b0 = ptr_get_byte(buf + off + 0) & 255
            var b1 = ptr_get_byte(buf + off + 1) & 255
            var b2 = ptr_get_byte(buf + off + 2) & 255
            var b3 = ptr_get_byte(buf + off + 3) & 255
            return {"ok": 1, "ip": _ipv4_to_string(b0, b1, b2, b3)}
        }

        off = off + rdlen
        ai = ai + 1
    }

    return {"ok": 0, "err": "dns.resp: no A record found"}
}

fn query_a(name, server_ip, server_port, timeout_ms) {
    // Query a DNS server for an A record.
    //
    // Returns:
    // - {"ok":1, "ip": "<ipv4>"} on success
    // - {"ok":0, "err": "..."} on failure
    //
    // Notes:
    // - `dns.query_a` always takes a server explicitly. Use `dns.default_resolver` if you want a best-effort
    //   system resolver selection (env `OREN_DNS_SERVER`, else `/etc/resolv.conf` on POSIX).
    // - Uses an ephemeral UDP socket per query (simplest correct behavior for now).
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 2000 }
    if timeout_ms < 0 { timeout_ms = 0 }
    if server_ip == nil { return {"ok": 0, "err": "dns.query_a: server_ip is nil"} }
    if oren_type_tag(server_port) == 0 || server_port <= 0 || server_port > 65535 {
        return {"ok": 0, "err": "dns.query_a: invalid server_port"}
    }

    var cap = 512
    var q = malloc(cap)
    if q == 0 { return {"ok": 0, "err": "dns.query_a: malloc failed"} }

    // Fill transaction ID with OS entropy (2 bytes).
    var rc = rand.fill(q, 2)
    if rc < 0 {
        free(q)
        return {"ok": 0, "err": "dns.query_a: rand.fill failed (errno=" + oren_int_to_string(0 - rc) + ")"}
    }
    var id = _u16be_get(q, 0)

    // Header:
    // - flags: 0x0100 recursion desired
    // - qdcount: 1
    _u16be_set(q, 2, 256)
    _u16be_set(q, 4, 1)
    _u16be_set(q, 6, 0)
    _u16be_set(q, 8, 0)
    _u16be_set(q, 10, 0)

    var off = 12
    var w = _write_qname(q, cap, off, name)
    if w["ok"] != 1 {
        free(q)
        return {"ok": 0, "err": "dns.query_a: " + w["err"]}
    }
    off = w["off"]
    if off + 4 > cap {
        free(q)
        return {"ok": 0, "err": "dns.query_a: buffer too small (question)"}
    }
    // QTYPE=A, QCLASS=IN
    _u16be_set(q, off + 0, 1)
    _u16be_set(q, off + 2, 1)
    off = off + 4

    var qlen = off

    var fd = udp.bind_local(0)
    if fd < 0 {
        free(q)
        return {"ok": 0, "err": "dns.query_a: udp.bind_local failed (errno=" + oren_int_to_string(0 - fd) + ")"}
    }

    var wn = udp.send_to(fd, server_ip, server_port, q, qlen, timeout_ms)
    free(q)
    if wn < 0 {
        udp.close(fd)
        return {"ok": 0, "err": "dns.query_a: send failed (errno=" + oren_int_to_string(0 - wn) + ")"}
    }
    if wn != qlen {
        udp.close(fd)
        return {"ok": 0, "err": "dns.query_a: short send"}
    }

    var rbuf = malloc(cap)
    if rbuf == 0 {
        udp.close(fd)
        return {"ok": 0, "err": "dns.query_a: malloc recv failed"}
    }
    var sa = malloc(16)
    if sa == 0 {
        free(rbuf)
        udp.close(fd)
        return {"ok": 0, "err": "dns.query_a: malloc addr failed"}
    }
    var lenp = malloc(8)
    if lenp == 0 {
        free(rbuf)
        free(sa)
        udp.close(fd)
        return {"ok": 0, "err": "dns.query_a: malloc addr len failed"}
    }
    ptr_set(lenp, 16)

    var rn = udp.recv_from_into(fd, rbuf, cap, timeout_ms, sa, lenp)
    udp.close(fd)
    free(sa)
    free(lenp)
    if rn < 0 {
        free(rbuf)
        return {"ok": 0, "err": "dns.query_a: recv failed (errno=" + oren_int_to_string(0 - rn) + ")"}
    }

    var out = _parse_response_a(rbuf, rn, id)
    free(rbuf)
    return out
}

fn try_query_a(name, server_ip, server_port, timeout_ms) {
    var r = query_a(name, server_ip, server_port, timeout_ms)
    if r["ok"] == 1 { return r["ip"] }
    return _err_result(r, "dns.query_a failed")
}
