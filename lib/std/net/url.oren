// std/net/url (v0, rolling)
//
// Pure URL parsing helpers for the std NET family. This module intentionally
// does not perform DNS, socket, TLS, or host I/O; callers decide which runtime
// capability backend handles the parsed endpoint.

import raw "std:buffer/raw"

fn _byte_at(s, i) {
    return oren_string_byte_at_unchecked(s, i) & 255
}

fn _starts_with(s, prefix) {
    if s == nil || prefix == nil { return 0 }
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return 0 }
    var i = 0
    while i < pl {
        if _byte_at(s, i) != _byte_at(prefix, i) { return 0 }
        i = i + 1
    }
    return 1
}

fn _parse_positive_int(s) {
    if s == nil { return -1 }
    var n = oren_string_len(s)
    if n <= 0 { return -1 }
    var acc = 0
    var i = 0
    while i < n {
        var b = _byte_at(s, i)
        if b < 48 || b > 57 { return -1 }
        acc = acc * 10 + (b - 48)
        i = i + 1
    }
    if acc <= 0 { return -1 }
    return acc
}

fn _hex_value(b) {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 65 && b <= 70 { return b - 55 }
    if b >= 97 && b <= 102 { return b - 87 }
    return -1
}

fn _hex_digit(n) {
    return oren_string_byte_at_unchecked("0123456789ABCDEF", n & 15) & 255
}

fn _is_unreserved(b) {
    if b >= 48 && b <= 57 { return true }
    if b >= 65 && b <= 90 { return true }
    if b >= 97 && b <= 122 { return true }
    if b == 45 || b == 46 || b == 95 || b == 126 { return true } // - . _ ~
    return false
}

fn _find_byte(s, start, want) {
    var n = oren_string_len(s)
    var i = start
    while i < n {
        if _byte_at(s, i) == want { return i }
        i = i + 1
    }
    return -1
}

fn _find_byte_before(s, start, end, want) {
    var i = start
    while i < end {
        if _byte_at(s, i) == want { return i }
        i = i + 1
    }
    return -1
}

fn _path_query_end(s, start) {
    var hash = _find_byte(s, start, 35) // '#'
    if hash >= 0 { return hash }
    return oren_string_len(s)
}

fn _slice_or_empty(s, start, end) {
    if end < start { end = start }
    return oren_string_slice(s, start, end)
}

fn _path_from_url_suffix(url, start) {
    var n = oren_string_len(url)
    if start >= n { return oren_string_slice("/", 0, 1) }
    var b = _byte_at(url, start)
    if b == 47 { return oren_string_slice(url, start, n) } // '/'
    var suffix = oren_string_slice(url, start, n)
    if suffix == 0 { return 0 }
    return _concat3("/", suffix, "")
}

fn _write_string(out, off, s) {
    var n = oren_string_len(s)
    var rc = oren_u8_buf_copy_from_string_slice_at(out, off, s, 0, n)
    if oren_is_err(rc) { return -1 }
    return off + n
}

fn _concat3(a, b, c) {
    var na = oren_string_len(a)
    var nb = oren_string_len(b)
    var nc = oren_string_len(c)
    var out = raw.u8_new_uninit(na + nb + nc)
    if oren_is_err(out) { return out }
    var off = _write_string(out, 0, a)
    if off < 0 { return oren_err(1, "url.concat: copy failed") }
    off = _write_string(out, off, b)
    if off < 0 { return oren_err(1, "url.concat: copy failed") }
    off = _write_string(out, off, c)
    if off < 0 { return oren_err(1, "url.concat: copy failed") }
    return oren_string_from_bytes_slice(out, 0, na + nb + nc)
}

fn _concat5(a, b, c, d, e) {
    var na = oren_string_len(a)
    var nb = oren_string_len(b)
    var nc = oren_string_len(c)
    var nd = oren_string_len(d)
    var ne = oren_string_len(e)
    var out = raw.u8_new_uninit(na + nb + nc + nd + ne)
    if oren_is_err(out) { return out }
    var off = _write_string(out, 0, a)
    if off < 0 { return oren_err(1, "url.concat: copy failed") }
    off = _write_string(out, off, b)
    if off < 0 { return oren_err(1, "url.concat: copy failed") }
    off = _write_string(out, off, c)
    if off < 0 { return oren_err(1, "url.concat: copy failed") }
    off = _write_string(out, off, d)
    if off < 0 { return oren_err(1, "url.concat: copy failed") }
    off = _write_string(out, off, e)
    if off < 0 { return oren_err(1, "url.concat: copy failed") }
    return oren_string_from_bytes_slice(out, 0, na + nb + nc + nd + ne)
}

fn _lower_ascii(s) {
    var n = oren_string_len(s)
    var changed = 0
    var i = 0
    while i < n {
        var b = _byte_at(s, i)
        if b >= 65 && b <= 90 { changed = 1; break }
        i = i + 1
    }
    if changed == 0 { return s }
    var out = raw.u8_new_uninit(n)
    if oren_is_err(out) { return out }
    var p = oren_buf_data_ptr_unchecked(out)
    i = 0
    while i < n {
        var b2 = _byte_at(s, i)
        if b2 >= 65 && b2 <= 90 { b2 = b2 + 32 }
        ptr_set_byte(p + i, b2)
        i = i + 1
    }
    return oren_string_from_bytes_slice(out, 0, n)
}

fn _has_colon(s) {
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        if _byte_at(s, i) == 58 { return 1 } // ':'
        i = i + 1
    }
    return 0
}

fn _is_bracketed_host(s) {
    var n = oren_string_len(s)
    if n < 2 { return 0 }
    if _byte_at(s, 0) != 91 { return 0 } // '['
    if _byte_at(s, n - 1) != 93 { return 0 } // ']'
    return 1
}

fn _scheme_separator_pos(s) {
    var n = oren_string_len(s)
    var i = 0
    while i + 2 < n {
        if _byte_at(s, i) == 58 && _byte_at(s, i + 1) == 47 && _byte_at(s, i + 2) == 47 { return i } // ://
        i = i + 1
    }
    return -1
}

fn _default_port_for_scheme(scheme) {
    if scheme == "https" || scheme == "wss" { return 443 }
    return 80
}

fn _optional_default_port_for_scheme(scheme) {
    if scheme == "http" || scheme == "ws" { return 80 }
    if scheme == "https" || scheme == "wss" { return 443 }
    return 0
}

fn _origin_from_parts(scheme, host, port) {
    var host_l = _lower_ascii(host)
    if oren_is_err(host_l) { return host_l }
    var prefix = scheme + "://"
    var port_s = ""
    if port != _default_port_for_scheme(scheme) {
        port_s = ":" + oren_int_to_string(port)
    }
    if _has_colon(host_l) == 1 {
        return _concat5(prefix, "[", host_l, "]", port_s)
    }
    return _concat3(prefix, host_l, port_s)
}

fn authority_from_host_port(host, port) {
    if oren_type_tag(host) != 4 { return oren_err(4, "url.authority_from_host_port: host must be string") }
    if port <= 0 || port > 65535 { return oren_err(4, "url.authority_from_host_port: invalid port") }
    var n = oren_string_len(host)
    if n <= 0 { return oren_err(4, "url.authority_from_host_port: host is empty") }
    var port_s = ":" + oren_int_to_string(port)
    if _is_bracketed_host(host) == 1 {
        if n <= 2 { return oren_err(4, "url.authority_from_host_port: host is empty") }
        var inner = oren_string_slice(host, 1, n - 1)
        if inner == 0 { return oren_err(4, "url.authority_from_host_port: host slice failed") }
        var inner_l = _lower_ascii(inner)
        if oren_is_err(inner_l) { return inner_l }
        return _concat5("[", inner_l, "]", port_s, "")
    }
    if _byte_at(host, 0) == 91 { return oren_err(4, "url.authority_from_host_port: invalid bracketed host") }
    if _find_byte(host, 0, 93) >= 0 { return oren_err(4, "url.authority_from_host_port: invalid bracketed host") } // ']'
    var host_l = _lower_ascii(host)
    if oren_is_err(host_l) { return host_l }
    if _has_colon(host_l) == 1 {
        return _concat5("[", host_l, "]", port_s, "")
    }
    return _concat3(host_l, port_s, "")
}

fn _origin_from_endpoint_parts(scheme, host, port, has_port) {
    var scheme_l = _lower_ascii(scheme)
    if oren_is_err(scheme_l) { return scheme_l }
    var host_l = _lower_ascii(host)
    if oren_is_err(host_l) { return host_l }
    var prefix = scheme_l + "://"
    var port_s = ""
    var default_port = _optional_default_port_for_scheme(scheme_l)
    if has_port && (default_port == 0 || port != default_port) {
        port_s = ":" + oren_int_to_string(port)
    }
    if _has_colon(host_l) == 1 {
        return _concat5(prefix, "[", host_l, "]", port_s)
    }
    return _concat3(prefix, host_l, port_s)
}

fn path_part(target) {
    if target == nil { return oren_err(4, "url.path_part: target is nil") }
    var end = _path_query_end(target, 0)
    var q = _find_byte(target, 0, 63) // '?'
    if q >= 0 && q < end { end = q }
    if end == 0 { return "/" }
    return _slice_or_empty(target, 0, end)
}

fn query_part(target) {
    if target == nil { return oren_err(4, "url.query_part: target is nil") }
    var end = _path_query_end(target, 0)
    var q = _find_byte(target, 0, 63) // '?'
    if q < 0 || q >= end { return "" }
    return _slice_or_empty(target, q + 1, end)
}

fn fragment_part(target) {
    if target == nil { return oren_err(4, "url.fragment_part: target is nil") }
    var hash = _find_byte(target, 0, 35) // '#'
    if hash < 0 { return "" }
    return _slice_or_empty(target, hash + 1, oren_string_len(target))
}

fn without_fragment(target) {
    if target == nil { return oren_err(4, "url.without_fragment: target is nil") }
    var end = _path_query_end(target, 0)
    return _slice_or_empty(target, 0, end)
}

fn request_target(target) {
    if target == nil { return oren_err(4, "url.request_target: target is nil") }
    var end = _path_query_end(target, 0)
    if end == 0 { return "/" }
    return _slice_or_empty(target, 0, end)
}

fn encode_component(s) {
    if oren_type_tag(s) != 4 { return oren_err(4, "url.encode_component: s must be string") }
    var n = oren_string_len(s)
    var extra = 0
    var i = 0
    while i < n {
        if _is_unreserved(_byte_at(s, i)) == false { extra = extra + 2 }
        i = i + 1
    }
    if extra == 0 { return s }
    var out = raw.u8_new_uninit(n + extra)
    if oren_is_err(out) { return out }
    var p = oren_buf_data_ptr_unchecked(out)
    var j = 0
    i = 0
    while i < n {
        var b = _byte_at(s, i)
        if _is_unreserved(b) {
            var start = i
            i = i + 1
            while i < n && _is_unreserved(_byte_at(s, i)) { i = i + 1 }
            var run_n = i - start
            var rc = oren_u8_buf_copy_from_string_slice_at(out, j, s, start, run_n)
            if oren_is_err(rc) { return rc }
            j = j + run_n
        } else {
            ptr_set_byte(p + j, 37) // '%'
            ptr_set_byte(p + j + 1, _hex_digit((b >> 4) & 15))
            ptr_set_byte(p + j + 2, _hex_digit(b & 15))
            j = j + 3
            i = i + 1
        }
    }
    return oren_string_from_bytes_slice(out, 0, n + extra)
}

fn _decode_component(s, plus_as_space, ctx) {
    if oren_type_tag(s) != 4 { return oren_err(4, ctx + ": s must be string") }
    var n = oren_string_len(s)
    var out_n = 0
    var i = 0
    while i < n {
        var b = _byte_at(s, i)
        if b == 37 {
            if i + 2 >= n { return oren_err(4, ctx + ": truncated percent escape") }
            var hi = _hex_value(_byte_at(s, i + 1))
            var lo = _hex_value(_byte_at(s, i + 2))
            if hi < 0 || lo < 0 { return oren_err(4, ctx + ": invalid percent escape") }
            i = i + 3
        } else {
            i = i + 1
        }
        out_n = out_n + 1
    }
    if out_n == n && plus_as_space == false { return s }
    var out = raw.u8_new_uninit(out_n)
    if oren_is_err(out) { return out }
    var p = oren_buf_data_ptr_unchecked(out)
    var j = 0
    i = 0
    while i < n {
        var b2 = _byte_at(s, i)
        if b2 == 37 {
            var hi2 = _hex_value(_byte_at(s, i + 1))
            var lo2 = _hex_value(_byte_at(s, i + 2))
            ptr_set_byte(p + j, ((hi2 << 4) | lo2) & 255)
            i = i + 3
            j = j + 1
        } else if plus_as_space && b2 == 43 {
            ptr_set_byte(p + j, 32)
            i = i + 1
            j = j + 1
        } else {
            var start = i
            i = i + 1
            while i < n {
                var rb = _byte_at(s, i)
                if rb == 37 || (plus_as_space && rb == 43) { break }
                i = i + 1
            }
            var run_n = i - start
            var rc = oren_u8_buf_copy_from_string_slice_at(out, j, s, start, run_n)
            if oren_is_err(rc) { return rc }
            j = j + run_n
        }
    }
    return oren_string_from_bytes_slice(out, 0, out_n)
}

fn decode_component(s) {
    return _decode_component(s, false, "url.decode_component")
}

fn decode_query_component(s) {
    return _decode_component(s, true, "url.decode_query_component")
}

fn query_params(target) {
    var q = query_part(target)
    if oren_is_err(q) { return q }
    var n = oren_string_len(q)
    var out = []
    var start = 0
    while start <= n {
        var amp = start
        while amp < n && _byte_at(q, amp) != 38 { amp = amp + 1 } // '&'
        if amp > start {
            var eq = start
            while eq < amp && _byte_at(q, eq) != 61 { eq = eq + 1 } // '='
            var raw_k = _slice_or_empty(q, start, eq)
            var raw_v = ""
            if eq < amp { raw_v = _slice_or_empty(q, eq + 1, amp) }
            var k = decode_query_component(raw_k)
            if oren_is_err(k) { return k }
            var v = decode_query_component(raw_v)
            if oren_is_err(v) { return v }
            oren_list_push(out, [k, v])
        }
        if amp >= n { break }
        start = amp + 1
    }
    return out
}

fn query_get(target, name) {
    var ps = query_params(target)
    if oren_is_err(ps) { return ps }
    var n = oren_list_len(ps)
    var i = 0
    while i < n {
        var p = ps[i]
        if p[0] == name { return p[1] }
        i = i + 1
    }
    return nil
}

fn _encoded_len(s) {
    if oren_type_tag(s) != 4 { return oren_err(4, "url.build_query: pair values must be strings") }
    var n = oren_string_len(s)
    var out = 0
    var i = 0
    while i < n {
        if _is_unreserved(_byte_at(s, i)) { out = out + 1 } else { out = out + 3 }
        i = i + 1
    }
    return out
}

fn _write_encoded(out, outp, off, s) {
    var n = oren_string_len(s)
    var j = off
    var i = 0
    while i < n {
        var b = _byte_at(s, i)
        if _is_unreserved(b) {
            var start = i
            i = i + 1
            while i < n && _is_unreserved(_byte_at(s, i)) { i = i + 1 }
            var run_n = i - start
            var rc = oren_u8_buf_copy_from_string_slice_at(out, j, s, start, run_n)
            if oren_is_err(rc) { return -1 }
            j = j + run_n
        } else {
            ptr_set_byte(outp + j, 37)
            ptr_set_byte(outp + j + 1, _hex_digit((b >> 4) & 15))
            ptr_set_byte(outp + j + 2, _hex_digit(b & 15))
            j = j + 3
            i = i + 1
        }
    }
    return j
}

fn build_query(pairs) {
    if oren_type_tag(pairs) != 6 { return oren_err(4, "url.build_query: pairs must be list") }
    var n = oren_list_len(pairs)
    var total = 0
    var i = 0
    while i < n {
        var p = pairs[i]
        if oren_type_tag(p) != 6 || oren_list_len(p) < 2 { return oren_err(4, "url.build_query: each pair must be [key, value]") }
        var kl = _encoded_len(p[0])
        if oren_is_err(kl) { return kl }
        var vl = _encoded_len(p[1])
        if oren_is_err(vl) { return vl }
        total = total + kl + 1 + vl
        if i > 0 { total = total + 1 }
        i = i + 1
    }
    if total == 0 { return "" }
    var out = raw.u8_new_uninit(total)
    if oren_is_err(out) { return out }
    var outp = oren_buf_data_ptr_unchecked(out)
    var j = 0
    i = 0
    while i < n {
        if i > 0 {
            ptr_set_byte(outp + j, 38) // '&'
            j = j + 1
        }
        var pair = pairs[i]
        j = _write_encoded(out, outp, j, pair[0])
        if j < 0 { return oren_err(5, "url.build_query: failed to copy key") }
        ptr_set_byte(outp + j, 61) // '='
        j = j + 1
        j = _write_encoded(out, outp, j, pair[1])
        if j < 0 { return oren_err(5, "url.build_query: failed to copy value") }
        i = i + 1
    }
    return oren_string_from_bytes_slice(out, 0, total)
}

fn with_query(target, pairs) {
    if oren_type_tag(target) != 4 { return oren_err(4, "url.with_query: target must be string") }
    var q = build_query(pairs)
    if oren_is_err(q) { return q }
    var n = oren_string_len(target)
    var hash = _find_byte(target, 0, 35) // '#'
    var end = n
    if hash >= 0 { end = hash }
    var qpos = _find_byte(target, 0, 63) // '?'
    var base_end = end
    if qpos >= 0 && qpos < end { base_end = qpos }
    var base = _slice_or_empty(target, 0, base_end)
    var frag = ""
    if hash >= 0 { frag = _slice_or_empty(target, hash, n) }
    if q == "" { return _concat3(base, "", frag) }
    return _concat5(base, "?", q, "", frag)
}

fn append_query(target, pairs) {
    if oren_type_tag(target) != 4 { return oren_err(4, "url.append_query: target must be string") }
    var q = build_query(pairs)
    if oren_is_err(q) { return q }
    if q == "" { return target }
    var n = oren_string_len(target)
    var hash = _find_byte(target, 0, 35) // '#'
    var end = n
    if hash >= 0 { end = hash }
    var head = _slice_or_empty(target, 0, end)
    var frag = ""
    if hash >= 0 { frag = _slice_or_empty(target, hash, n) }
    var sep = "?"
    var qpos = _find_byte(target, 0, 63) // '?'
    if qpos >= 0 && qpos < end {
        if qpos + 1 >= end { sep = "" } else { sep = "&" }
    }
    return _concat5(head, sep, q, "", frag)
}

fn _parse_two_schemes(url, scheme_a, default_port_a, scheme_b, default_port_b) {
    var prefix_a = scheme_a + "://"
    var prefix_b = scheme_b + "://"
    var r = _parse_endpoint_origin_record(url)
    if r["ok"] != 1 { return r }
    var scheme = r["scheme"]
    if scheme != scheme_a && scheme != scheme_b {
        return {"ok": 0, "err": "only " + prefix_a + " and " + prefix_b + " are supported"}
    }

    var port = default_port_a
    if scheme == scheme_b { port = default_port_b }
    if r["has_port"] { port = r["port"] }

    var auth_end = r["auth_end"]
    var path = _path_from_url_suffix(url, auth_end)
    if path == 0 { return {"ok": 0, "err": "path slice failed"} }

    var clean_path = path_part(path)
    if oren_is_err(clean_path) { return {"ok": 0, "err": "path parse failed"} }
    var query = query_part(path)
    if oren_is_err(query) { return {"ok": 0, "err": "query parse failed"} }
    var wire_target = request_target(path)
    if oren_is_err(wire_target) { return {"ok": 0, "err": "request-target parse failed"} }
    var authority = r["authority"]
    if authority == 0 { return {"ok": 0, "err": "authority slice failed"} }

    return {"ok": 1, "scheme": scheme, "host": r["host"], "authority": authority, "port": port, "path": path, "path_only": clean_path, "query": query, "request_target": wire_target}
}

fn _err_from_record(r, fallback) {
    var msg = r["err"]
    if msg == nil || msg == "" { msg = fallback }
    return oren_err(4, msg)
}

fn _parse_endpoint_origin_record(url) {
    if oren_type_tag(url) != 4 { return {"ok": 0, "err": "url must be string"} }
    var sep = _scheme_separator_pos(url)
    if sep <= 0 { return {"ok": 0, "err": "missing scheme"} }
    var scheme = oren_string_slice(url, 0, sep)
    if scheme == 0 { return {"ok": 0, "err": "scheme slice failed"} }
    scheme = _lower_ascii(scheme)
    if oren_is_err(scheme) { return {"ok": 0, "err": "scheme lower failed"} }

    var pos = sep + 3
    var ul = oren_string_len(url)
    var auth_end = -1
    var i = pos
    while i < ul {
        var ab = _byte_at(url, i)
        if ab == 47 || ab == 63 || ab == 35 { auth_end = i; break } // '/', '?', '#'
        i = i + 1
    }
    if auth_end == -1 { auth_end = ul }
    if auth_end <= pos { return {"ok": 0, "err": "missing host"} }
    if _find_byte_before(url, pos, auth_end, 64) >= 0 { return {"ok": 0, "err": "userinfo is not supported"} } // '@'

    var host_start = pos
    var host_end = auth_end
    var port_start = -1

    if _byte_at(url, pos) == 91 { // '['
        var close = _find_byte_before(url, pos + 1, auth_end, 93) // ']'
        if close < 0 { return {"ok": 0, "err": "unterminated IPv6 host"} }
        if close <= pos + 1 { return {"ok": 0, "err": "missing host"} }
        host_start = pos + 1
        host_end = close
        if close + 1 < auth_end {
            if _byte_at(url, close + 1) != 58 { return {"ok": 0, "err": "invalid IPv6 authority"} }
            port_start = close + 2
            if port_start >= auth_end { return {"ok": 0, "err": "invalid port"} }
        }
    } else {
        var colon = _find_byte_before(url, pos, auth_end, 58) // ':'
        if colon >= 0 {
            if _find_byte_before(url, colon + 1, auth_end, 58) >= 0 {
                return {"ok": 0, "err": "IPv6 host must be bracketed"}
            }
            host_end = colon
            port_start = colon + 1
            if port_start >= auth_end { return {"ok": 0, "err": "invalid port"} }
        }
    }

    if host_end <= host_start { return {"ok": 0, "err": "missing host"} }
    var host = oren_string_slice(url, host_start, host_end)
    if host == 0 { return {"ok": 0, "err": "host slice failed"} }

    var has_port = false
    var port = 0
    if port_start != -1 {
        var port_s = oren_string_slice(url, port_start, auth_end)
        if port_s == 0 { return {"ok": 0, "err": "port slice failed"} }
        var pv = _parse_positive_int(port_s)
        if pv <= 0 || pv > 65535 { return {"ok": 0, "err": "invalid port"} }
        port = pv
        has_port = true
    }

    var authority = oren_string_slice(url, pos, auth_end)
    if authority == 0 { return {"ok": 0, "err": "authority slice failed"} }
    return {"ok": 1, "scheme": scheme, "host": host, "authority": authority, "port": port, "has_port": has_port, "auth_end": auth_end}
}

fn parse_http_record(url) {
    return _parse_two_schemes(url, "http", 80, "https", 443)
}

fn parse_ws_record(url) {
    return _parse_two_schemes(url, "ws", 80, "wss", 443)
}

fn parse_http(url) {
    var r = parse_http_record(url)
    if r["ok"] == 1 {
        return {"scheme": r["scheme"], "host": r["host"], "authority": r["authority"], "port": r["port"], "path": r["path"], "path_only": r["path_only"], "query": r["query"], "request_target": r["request_target"]}
    }
    return _err_from_record(r, "url.parse_http failed")
}

fn parse_ws(url) {
    var r = parse_ws_record(url)
    if r["ok"] == 1 {
        return {"scheme": r["scheme"], "host": r["host"], "authority": r["authority"], "port": r["port"], "path": r["path"], "path_only": r["path_only"], "query": r["query"], "request_target": r["request_target"]}
    }
    return _err_from_record(r, "url.parse_ws failed")
}

fn parse(url) {
    var h = parse_http_record(url)
    if h["ok"] == 1 {
        return {"scheme": h["scheme"], "host": h["host"], "authority": h["authority"], "port": h["port"], "path": h["path"], "path_only": h["path_only"], "query": h["query"], "request_target": h["request_target"]}
    }
    var w = parse_ws_record(url)
    if w["ok"] == 1 {
        return {"scheme": w["scheme"], "host": w["host"], "authority": w["authority"], "port": w["port"], "path": w["path"], "path_only": w["path_only"], "query": w["query"], "request_target": w["request_target"]}
    }
    return _err_from_record(h, "url.parse failed")
}

fn origin(url) {
    var r = parse(url)
    if oren_is_err(r) { return r }
    return _origin_from_parts(r["scheme"], r["host"], r["port"])
}

fn same_origin(a, b) {
    var oa = origin(a)
    if oren_is_err(oa) { return oa }
    var ob = origin(b)
    if oren_is_err(ob) { return ob }
    return oa == ob
}

fn endpoint_origin(url) {
    var r = _parse_endpoint_origin_record(url)
    if r["ok"] != 1 { return _err_from_record(r, "url.endpoint_origin failed") }
    return _origin_from_endpoint_parts(r["scheme"], r["host"], r["port"], r["has_port"])
}

fn allowed_by_host_or_origin(url, allowed) {
    if allowed == nil { return true }
    if oren_type_tag(allowed) != 6 { return oren_err(4, "url.allowed_by_host_or_origin: allowed must be list") }
    if oren_list_len(allowed) == 0 { return true }

    var r = _parse_endpoint_origin_record(url)
    if r["ok"] != 1 { return _err_from_record(r, "url.allowed_by_host_or_origin failed") }
    var target_host = _lower_ascii(r["host"])
    if oren_is_err(target_host) { return target_host }
    var target_origin = _origin_from_endpoint_parts(r["scheme"], r["host"], r["port"], r["has_port"])
    if oren_is_err(target_origin) { return target_origin }

    var i = 0
    while i < oren_list_len(allowed) {
        var entry = allowed[i]
        if oren_type_tag(entry) == 4 && oren_string_len(entry) > 0 {
            if _scheme_separator_pos(entry) >= 0 {
                var entry_origin = endpoint_origin(entry)
                if !oren_is_err(entry_origin) && entry_origin == target_origin { return true }
            } else {
                var entry_host = _lower_ascii(entry)
                if !oren_is_err(entry_host) && entry_host == target_host { return true }
            }
        }
        i = i + 1
    }
    return false
}
