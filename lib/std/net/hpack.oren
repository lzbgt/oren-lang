// std/net/hpack (rolling)
//
// HPACK (RFC 7541) is the header compression format used by HTTP/2.
//
// Scope (v0 bring-up):
// - Deterministic integer decoding/encoding (RFC 7541 §5.1)
// - Deterministic string literal decoding (RFC 7541 §5.2)
// - Header block decoding for the common representations (RFC 7541 §6)
// - Dynamic table maintenance (RFC 7541 §2.3)
//
// Not yet implemented (planned, tracked in docs/STATUS.md):
// - Header block encoding (beyond small helpers) (in progress)
// - Full HTTP/2 HEADERS/CONTINUATION stream integration
//
// References (vendored for exact wording/examples):
// - `project-doc/web/rfc/rfc7541.txt` (HPACK)
// - `project-doc/web/rfc/rfc7540.txt` (HTTP/2)

import list "std:list"

// Static table (RFC 7541 Appendix A).
// Indexes are 1-based in the spec; we store them 0-based in these lists.
var _STATIC_NAMES = [
    ":authority",
    ":method",
    ":method",
    ":path",
    ":path",
    ":scheme",
    ":scheme",
    ":status",
    ":status",
    ":status",
