// HTTP stdlib (native backend, rolling).
//
// Current scope (rolling, syscall-first):
// - HTTP/1.1 over TCP
// - IPv4 literal URLs (no DNS needed)
// - Hostname URLs via DNS A lookup:
//   - either pass an explicit resolver config (`http.get_text_resolver`)
//   - or rely on `dns.default_resolver` (env `OREN_DNS_SERVER`, else `/etc/resolv.conf` on POSIX)
// - Content-Length and Transfer-Encoding: chunked bodies
// - https:// via `std:net/tls` when a TLS provider exists for the target OS (see docs/NET_TLS.md)
//
// The goal is to provide a stable module path for native Oren libraries to build on
// while we iterate toward a full production NET stack (HTTP/2 + WebSocket + TLS + DNS).

import tcp "std:net/tcp"
import tls "std:net/tls"
import hostutil "std:net/host"

fn _trim_right_ws_in_buf(buf, start, end) {
    var i = end
    while i > start {
        var b = ptr_get_byte(buf + (i - 1)) & 255
        if b != 32 && b != 9 { break } // space/tab
        i = i - 1
    }
    return i
}

fn _string_from_buf_range(buf, start, end) {
    // Copy buf[start:end] into a NUL-terminated string.
    if buf == 0 { return 0 }
    var n = end - start
    if n < 0 { return 0 }
    var out = malloc(n + 1)
    if out == 0 { return 0 }
    if n > 0 { oren_memcpy(out, buf + start, n) }
    ptr_set_byte(out + n, 0)
    return out
}

fn _status_code_from_status_line(buf, line_end) {
    // Parse "HTTP/1.1 200 OK" => 200
    // Returns status code >=0, or -1 on failure.
    if buf == 0 { return -1 }
    if line_end <= 0 { return -1 }
    var i = 0
    // Find first space.
    while i < line_end {
        var b = ptr_get_byte(buf + i) & 255
        if b == 32 { break }
        i = i + 1
    }
    if i >= line_end { return -1 }
    // Skip spaces.
    while i < line_end && (ptr_get_byte(buf + i) & 255) == 32 { i = i + 1 }
    if i >= line_end { return -1 }
    // Parse digits until space or EOL.
    var acc = 0
    var seen = 0
    while i < line_end {
        var b2 = ptr_get_byte(buf + i) & 255
        if b2 == 32 { break }
        if b2 < 48 || b2 > 57 { return -1 }
        acc = acc * 10 + (b2 - 48)
        seen = 1
        i = i + 1
    }
    if seen == 0 { return -1 }
    return acc
}

fn _starts_with(s, prefix) {
    if s == nil || prefix == nil { return 0 }
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return 0 }
    var i = 0
    while i < pl {
        if ptr_get_byte(s + i) != ptr_get_byte(prefix + i) { return 0 }
        i = i + 1
    }
    return 1
}

fn _parse_http_url(url) {
    // Supported:
    //   http://<host>[:port][/path]
    //   https://<host>[:port][/path]  (TLS provider availability is OS-dependent; see docs/NET_TLS.md)
    //
    // Where <host> can be an IPv4 literal or a hostname (resolved separately).
    //
    // Returns {ok:1, scheme:string, host:string, port:int, path:string} or {ok:0, err:string}.
    if url == nil { return {"ok": 0, "err": "url is nil"} }
    var scheme = 0
    var pos = 0
    if _starts_with(url, "http://") == 1 {
        scheme = "http"
        pos = 7 // len("http://")
    } else if _starts_with(url, "https://") == 1 {
        scheme = "https"
        pos = 8 // len("https://")
    } else {
        return {"ok": 0, "err": "only http:// and https:// are supported"}
    }

    var ul = oren_string_len(url)

    // Find '/' for path start
    var slash = -1
    var i = pos
    while i < ul {
        if ptr_get_byte(url + i) == 47 { slash = i; break } // '/'
        i = i + 1
    }
    if slash == -1 { slash = ul }

    // Find ':' for port separator (only within host segment)
    var colon = -1
    i = pos
    while i < slash {
        if ptr_get_byte(url + i) == 58 { colon = i; break } // ':'
        i = i + 1
    }

    var host_end = slash
    if colon != -1 { host_end = colon }
    if host_end <= pos { return {"ok": 0, "err": "missing host"} }

    var host = oren_string_slice(url, pos, host_end)
    if host == 0 { return {"ok": 0, "err": "host slice failed"} }

    var port = 80
    if scheme == "https" { port = 443 }
    if colon != -1 {
        var port_s = oren_string_slice(url, colon + 1, slash)
        if port_s == 0 {
            free(host)
            return {"ok": 0, "err": "port slice failed"}
        }
        var pv = oren_int_from_string(port_s)
        free(port_s)
        if pv <= 0 {
            free(host)
            return {"ok": 0, "err": "invalid port"}
        }
        port = pv
    }

    // Always allocate `path` so callers can safely `free(...)` without worrying about string literals.
    var path = oren_string_slice("/", 0, 1)
    if path == 0 {
        free(host)
        return {"ok": 0, "err": "path slice failed"}
    }
    if slash < ul {
        free(path)
        path = oren_string_slice(url, slash, ul)
        if path == 0 {
            free(host)
            return {"ok": 0, "err": "path slice failed"}
        }
    }

    return {"ok": 1, "scheme": scheme, "host": host, "port": port, "path": path}
}

fn _build_get_request(host, path) {
    // Minimal HTTP/1.1 request (connection-close).
    //
    // Prefer `+` for string concatenation (native backend lowers to `oren_add`).
    // This avoids manual lifetime management of intermediate concat results.
    return "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
}

fn _resolve_host_ipv4(host, timeout_ms, resolver) {
    return hostutil.resolve_host_ipv4("http", host, timeout_ms, resolver)
}

fn _find_header_body_split(buf, used) {
    // Returns offset of body start, or 0 if not found.
    var i = 0
    while i + 3 < used {
        if ptr_get_byte(buf + i) == 13 {
            if ptr_get_byte(buf + i + 1) == 10 {
                if ptr_get_byte(buf + i + 2) == 13 {
                    if ptr_get_byte(buf + i + 3) == 10 {
                        return i + 4
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn _ascii_lower(b) {
    // Input is a byte (0..255); return lowercase ASCII byte if A..Z.
    if b >= 65 && b <= 90 { return b + 32 }
    return b
}

fn _header_name_eq_ci(buf, name_start, name_end, want) {
    // Case-insensitive ASCII compare of buf[name_start:name_end] vs want string.
    var wl = oren_string_len(want)
    if (name_end - name_start) != wl { return 0 }
    var i = 0
    while i < wl {
        var b1 = ptr_get_byte(buf + name_start + i) & 255
        var b2 = ptr_get_byte(want + i) & 255
        if _ascii_lower(b1) != _ascii_lower(b2) { return 0 }
        i = i + 1
    }
    return 1
}

fn _trim_left_ws_in_buf(buf, start, end) {
    var i = start
    while i < end {
        var b = ptr_get_byte(buf + i) & 255
        if b != 32 && b != 9 { break } // space/tab
        i = i + 1
    }
    return i
}

fn _parse_dec_int_in_buf(buf, start, end) {
    // Returns integer >=0 on success, or -1 on failure.
    var i = start
    if i >= end { return -1 }
    var acc = 0
    while i < end {
        var b = ptr_get_byte(buf + i) & 255
        if b < 48 || b > 57 { return -1 }
        acc = acc * 10 + (b - 48)
        i = i + 1
    }
    return acc
}

fn _hex_val(b) {
    // Returns 0..15, or -1 on failure.
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 65 && b <= 70 { return b - 55 } // A..F
    if b >= 97 && b <= 102 { return b - 87 } // a..f
    return -1
}

fn _decode_chunked_into_string(body_ptr, body_len) {
    // Decode Transfer-Encoding: chunked body bytes into a single NUL-terminated string.
    // Returns out string pointer, or 0 on failure.
    if body_ptr == 0 { return 0 }
    if body_len <= 0 {
        var out0 = malloc(1)
        if out0 == 0 { return 0 }
        ptr_set_byte(out0 + 0, 0)
        return out0
    }

    // Worst-case output size <= input size (chunk framing adds overhead),
    // so allocate body_len+1 and shrink-by-copy if needed.
    var out = malloc(body_len + 1)
    if out == 0 { return 0 }
    var out_used = 0

    var i = 0
    while i < body_len {
        // Parse chunk size line (hex digits + optional extensions until CRLF).
        var size = 0
        var seen_digit = 0
        while i < body_len {
            var b = ptr_get_byte(body_ptr + i) & 255
            if b == 13 { break } // CR
            if b == 10 { break } // LF (tolerate)
            if b == 59 { // ';' => chunk extensions, ignore rest of line
                while i < body_len {
                    var b2 = ptr_get_byte(body_ptr + i) & 255
                    if b2 == 13 || b2 == 10 { break }
                    i = i + 1
                }
                break
            }
            var hv = _hex_val(b)
            if hv < 0 { free(out); return 0 }
            size = size * 16 + hv
            seen_digit = 1
            i = i + 1
        }
        if seen_digit == 0 { free(out); return 0 }

        // Consume CRLF
        if i < body_len && (ptr_get_byte(body_ptr + i) & 255) == 13 { i = i + 1 }
        if i < body_len && (ptr_get_byte(body_ptr + i) & 255) == 10 { i = i + 1 }

        if size == 0 {
            // Done. Ignore optional trailers.
            ptr_set_byte(out + out_used, 0)
            return out
        }

        if i + size > body_len { free(out); return 0 }
        oren_memcpy(out + out_used, body_ptr + i, size)
        out_used = out_used + size
        i = i + size

        // Consume trailing CRLF after chunk data.
        if i < body_len && (ptr_get_byte(body_ptr + i) & 255) == 13 { i = i + 1 }
        if i < body_len && (ptr_get_byte(body_ptr + i) & 255) == 10 { i = i + 1 }
    }

    // Unterminated stream.
    free(out)
    return 0
}

fn headers_get(headers, name) {
    // Convenience helper: fetch a header value from a `headers` list returned by `get_response*`.
    //
    // - `headers` is a list of pairs: [[name:string, value:string], ...]
    // - Matching is ASCII case-insensitive on `name`.
    //
    // Returns header value string pointer, or nil if not found.
    if headers == nil || name == nil { return nil }
    var want = name
    var want_len = oren_string_len(want)
    var n = oren_list_len(headers)
    var i = 0
    while i < n {
        var pair = headers[i]
        if pair != nil {
            var k = pair[0]
            var v = pair[1]
            if k != nil && v != nil {
                var kl = oren_string_len(k)
                if kl == want_len {
                    var j = 0
                    var ok = 1
                    while j < kl {
                        var b1 = _ascii_lower(ptr_get_byte(k + j) & 255)
                        var b2 = _ascii_lower(ptr_get_byte(want + j) & 255)
                        if b1 != b2 { ok = 0; break }
                        j = j + 1
                    }
                    if ok == 1 { return v }
                }
            }
        }
        i = i + 1
    }
    return nil
}

fn response_free(resp) {
    // Free owned allocations inside a response returned by `get_response*`.
    //
    // Contract:
    // - after calling `response_free(resp)`, the caller must not use `resp` (or its nested fields).
    // - this does not free the response map/list containers (GC-managed); it only frees the owned strings.
    if resp == nil { return nil }
    var body = resp["body"]
    if body != nil && body != 0 { free(body) }
    var hs = resp["headers"]
    if hs != nil {
        var n = oren_list_len(hs)
        var i = 0
        while i < n {
            var pair = hs[i]
            if pair != nil {
                var k = pair[0]
                var v = pair[1]
                if k != nil && k != 0 { free(k) }
                if v != nil && v != 0 { free(v) }
            }
            i = i + 1
        }
    }
    return nil
}

fn get_response_resolver_opts(url, timeout_ms, resolver, opts) {
    // Structured HTTP/1.1 response (v0):
    //
    // Returns:
    //   {"ok":1, "status":int, "headers":[[k,v],...], "body":string}
    //   {"ok":0, "err":string}
    //
    // Notes:
    // - supports http:// and https:// (TLS provider availability is OS-dependent; see docs/NET_TLS.md)
    // - connection-close only (no keep-alive pooling yet)
    // - headers are returned as a list of owned strings (caller may free via `response_free`)
    //
    // This is intended as the stable foundation for:
    // - HTTPS/WSS (TLS layer)
    // - streaming bodies
    // - HTTP/2 framing
    if timeout_ms == nil { timeout_ms = 5000 }

    var pu = _parse_http_url(url)
    if pu["ok"] != 1 { return {"ok": 0, "err": "http.get_response: " + pu["err"]} }

    var is_tls = 0
    if pu["scheme"] == "https" { is_tls = 1 }
    var host = pu["host"]
    var port = pu["port"]
    var path = pu["path"]

    var rh = _resolve_host_ipv4(host, timeout_ms, resolver)
    if rh["ok"] != 1 {
        free(host)
        free(path)
        return {"ok": 0, "err": "http.get_response: " + rh["err"]}
    }
    var ip = rh["ip"]
    var owned_ip = rh["owned"]

    var fd = tcp.connect(ip, port, timeout_ms)
    if owned_ip == 1 { free(ip) }
    if fd < 0 {
        free(host)
        free(path)
        return {"ok": 0, "err": "http.get_response: connect failed (errno=" + oren_int_to_string(0 - fd) + ")"}
    }

    var tls_conn = 0
    if is_tls == 1 {
        var tls_opts = 0
        if opts != nil && oren_is_map(opts) == true {
            tls_opts = oren_map_get_str(opts, "tls")
        }
        var server_name = host
        if tls_opts != 0 && oren_is_map(tls_opts) == true {
            var sn = oren_map_get_str(tls_opts, "server_name")
            if sn != 0 { server_name = sn }
        }
        var cr = tls.wrap_client(fd, server_name, timeout_ms, tls_opts)
        if oren_map_get_str(cr, "ok") != 1 {
            // Best-effort: ensure fd isn't leaked on providers that don't close on failure.
            tcp.close(fd)
            free(host)
            free(path)
            return {"ok": 0, "err": "http.get_response: " + oren_map_get_str(cr, "err")}
        }
        tls_conn = oren_map_get_str(cr, "conn")
        if tls_conn == 0 {
            tcp.close(fd)
            free(host)
            free(path)
            return {"ok": 0, "err": "http.get_response: tls.wrap_client returned nil conn"}
        }

        // NOTE: deterministic pinning is enforced by `std:net/tls` itself when
        // `tls_opts["pin_cert_sha256_hex"]` is provided (see docs/NET_TLS.md).
    }

    var req = _build_get_request(host, path)
    free(host)
    free(path)
    if req == 0 {
        if is_tls == 1 { tls.close(tls_conn) } else { tcp.close(fd) }
        return {"ok": 0, "err": "http.get_response: request build failed"}
    }

    var req_len = oren_string_len(req)
    var wr = 0
    if is_tls == 1 { wr = tls.write_from(tls_conn, req, req_len, timeout_ms) }
    else { wr = tcp.write_from(fd, req, req_len, timeout_ms) }
    free(req)
    if wr < 0 {
        if is_tls == 1 { tls.close(tls_conn) } else { tcp.close(fd) }
        return {"ok": 0, "err": "http.get_response: write failed (errno=" + oren_int_to_string(0 - wr) + ")"} }

    var cap = 8192
    var used = 0
    var buf = malloc(cap)
    if buf == 0 {
        tcp.close(fd)
        return {"ok": 0, "err": "http.get_response: malloc failed"}
    }

    var headers = [] // [[name,value], ...] (owned strings)
    var status_code = -1

    var header_done = 0
    var body_off = 0
    var content_len = -1
    var is_chunked = 0
    var last_n = 0

    while 1 {
        var tmp = malloc(2048)
        if tmp == 0 { break }
        var n = 0
        if is_tls == 1 { n = tls.read_into(tls_conn, tmp, 2048, timeout_ms) }
        else { n = tcp.read_into(fd, tmp, 2048, timeout_ms) }
        last_n = n
        if n == 0 {
            free(tmp)
            break
        }
        if n < 0 {
            free(tmp)
            break
        }

        while used + n > cap {
            var new_cap = cap * 2
            if new_cap < used + n { new_cap = used + n }
            var new_buf = malloc(new_cap)
            if new_buf == 0 { break }
            oren_memcpy(new_buf, buf, used)
            free(buf)
            buf = new_buf
            cap = new_cap
        }

        oren_memcpy(buf + used, tmp, n)
        used = used + n
        free(tmp)

        if header_done == 0 {
            body_off = _find_header_body_split(buf, used)
            if body_off != 0 {
                header_done = 1

                var line0_end = -1
                var i0 = 0
                while i0 + 1 < body_off {
                    if (ptr_get_byte(buf + i0) & 255) == 13 && (ptr_get_byte(buf + i0 + 1) & 255) == 10 {
                        line0_end = i0
                        break
                    }
                    i0 = i0 + 1
                }
                if line0_end > 0 { status_code = _status_code_from_status_line(buf, line0_end) }

                var hpos = 0
                if line0_end >= 0 { hpos = line0_end + 2 }
                while hpos + 1 < body_off {
                    if (ptr_get_byte(buf + hpos) & 255) == 13 && (ptr_get_byte(buf + hpos + 1) & 255) == 10 {
                        break
                    }
                    var lend = -1
                    var j = hpos
                    while j + 1 < body_off {
                        if (ptr_get_byte(buf + j) & 255) == 13 && (ptr_get_byte(buf + j + 1) & 255) == 10 {
                            lend = j
                            break
                        }
                        j = j + 1
                    }
                    if lend < 0 { break }

                    var colon = -1
                    var k = hpos
                    while k < lend {
                        if (ptr_get_byte(buf + k) & 255) == 58 { colon = k; break } // ':'
                        k = k + 1
                    }
                    if colon >= 0 {
                        var name_start = hpos
                        var name_end = colon
                        var val_start = _trim_left_ws_in_buf(buf, colon + 1, lend)
                        var val_end = _trim_right_ws_in_buf(buf, val_start, lend)

                        var name_s = _string_from_buf_range(buf, name_start, name_end)
                        var val_s = _string_from_buf_range(buf, val_start, val_end)
                        if name_s != 0 && val_s != 0 {
                            oren_list_push(headers, [name_s, val_s])
                        } else {
                            if name_s != 0 { free(name_s) }
                            if val_s != 0 { free(val_s) }
                        }

                        if _header_name_eq_ci(buf, name_start, name_end, "content-length") == 1 {
                            var v = _parse_dec_int_in_buf(buf, val_start, val_end)
                            if v >= 0 { content_len = v }
                        } else if _header_name_eq_ci(buf, name_start, name_end, "transfer-encoding") == 1 {
                            var ti = val_start
                            while ti + 6 < val_end {
                                var c0 = _ascii_lower(ptr_get_byte(buf + ti) & 255)
                                var c1 = _ascii_lower(ptr_get_byte(buf + ti + 1) & 255)
                                var c2 = _ascii_lower(ptr_get_byte(buf + ti + 2) & 255)
                                var c3 = _ascii_lower(ptr_get_byte(buf + ti + 3) & 255)
                                var c4 = _ascii_lower(ptr_get_byte(buf + ti + 4) & 255)
                                var c5 = _ascii_lower(ptr_get_byte(buf + ti + 5) & 255)
                                var c6 = _ascii_lower(ptr_get_byte(buf + ti + 6) & 255)
                                if c0 == 99 && c1 == 104 && c2 == 117 && c3 == 110 && c4 == 107 && c5 == 101 && c6 == 100 {
                                    is_chunked = 1
                                    break
                                }
                                ti = ti + 1
                            }
                        }
                    }

                    hpos = lend + 2
                }
            }
        }

        if header_done == 1 && is_chunked == 0 && content_len >= 0 {
            var need = body_off + content_len
            if used >= need { break }
        }
    }

    if is_tls == 1 { tls.close(tls_conn) } else { tcp.close(fd) }

    if header_done == 0 {
        free(buf)
        response_free({"headers": headers, "body": nil})
        return {"ok": 0, "err": "http.get_response: missing header terminator (used=" + oren_int_to_string(used) + " last_n=" + oren_int_to_string(last_n) + ")"}
    }
    if status_code < 0 {
        free(buf)
        response_free({"headers": headers, "body": nil})
        return {"ok": 0, "err": "http.get_response: failed to parse status line"}
    }

    if body_off > used { body_off = used }
    var body_len0 = used - body_off

    var body_len = body_len0
    if is_chunked == 0 && content_len >= 0 {
        body_len = content_len
        if body_len > body_len0 { body_len = body_len0 }
        if body_len < 0 { body_len = 0 }
    }

    if is_chunked == 1 {
        var outc = _decode_chunked_into_string(buf + body_off, body_len0)
        free(buf)
        if outc == 0 {
            response_free({"headers": headers, "body": nil})
            return {"ok": 0, "err": "http.get_response: chunked decode failed"}
        }
        return {"ok": 1, "status": status_code, "headers": headers, "body": outc}
    }

    var out = malloc(body_len + 1)
    if out == 0 {
        free(buf)
        response_free({"headers": headers, "body": nil})
        return {"ok": 0, "err": "http.get_response: malloc body failed"}
    }
    if body_len > 0 { oren_memcpy(out, buf + body_off, body_len) }
    ptr_set_byte(out + body_len, 0)
    free(buf)
    return {"ok": 1, "status": status_code, "headers": headers, "body": out}
}

fn get_response_resolver(url, timeout_ms, resolver) {
    return get_response_resolver_opts(url, timeout_ms, resolver, 0)
}

fn get_response_opts(url, timeout_ms, opts) {
    return get_response_resolver_opts(url, timeout_ms, 0, opts)
}

fn get_response(url, timeout_ms) {
    return get_response_resolver_opts(url, timeout_ms, 0, 0)
}

fn get_text_resolver(url, timeout_ms, resolver) {
    // Returns:
    //   {"ok":1,"v":string} on success
    //   {"ok":0,"err":string} on failure
    //
    var rr = get_response_resolver_opts(url, timeout_ms, resolver, 0)
    if rr["ok"] != 1 { return {"ok": 0, "err": rr["err"]} }
    var body = rr["body"]
    // Free headers immediately; return only the body (legacy API).
    response_free({"headers": rr["headers"], "body": nil})
    return {"ok": 1, "v": body}
}

fn get_text(url, timeout_ms) {
    // Default behavior:
    // - IPv4 literal hosts work without DNS
    // - hostname hosts use `dns.default_resolver` (env `OREN_DNS_SERVER` or `/etc/resolv.conf`)
    return get_text_resolver(url, timeout_ms, 0)
}

fn get(url) {
    // Legacy convenience API: return body string pointer, or 0 on failure.
    // Prefer `get_text(url, timeout_ms)` for errors.
    var r = get_text(url, 5000)
    if r["ok"] != 1 { return 0 }
    return r["v"]
}
