// std/net/tls_linux_openssl (rolling)
//
// Linux TLS provider for std:net/tls using OpenSSL 3.
// This file is factored out of std:net/tls to keep provider code isolated.

import tcp "std:net/tcp"
import sha256 "std:crypto/sha256"
import dl "std:ffi/libdl"

// --- Linux provider (OpenSSL) ---
//
// Provider goal (rolling v0):
// - deterministic offline loopback fixtures (TLS/HTTPS/WSS)
// - timeout-bounded handshake and IO
//
// Link deps:
// - OpenSSL 3 is the Tier‑1 baseline in our current linux/arm64 container and remote WSL2 host.
//   Evidence is captured under `project-doc/web/openssl/` (downloaded from openssl.org manpages).

