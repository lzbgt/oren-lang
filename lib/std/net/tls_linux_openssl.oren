@cfg(os="linux")
var _openssl_inited = 0
@cfg(os="linux")
var _openssl_libs_loaded = 0

@cfg(os="linux")
fn _rtld_now() { return 2 }
@cfg(os="linux")
fn _rtld_global() { return 256 }
@cfg(os="linux")
fn _rtld_flags() { return _rtld_now() | _rtld_global() }

@cfg(os="linux")
fn _RTLD_DEFAULT() { return 0 }

@cfg(os="linux")
fn _ssl_tlsext_err_ok() { return 0 } // SSL_TLSEXT_ERR_OK
@cfg(os="linux")
fn _ssl_tlsext_err_noack() { return 3 } // SSL_TLSEXT_ERR_NOACK

@cfg(os="linux")
fn _openssl_dlopen_libs() {
    // Important: use RTLD_GLOBAL so OpenSSL symbols become visible to dlsym(RTLD_DEFAULT,...),
    // which is how the native backend resolves `ffi` on Linux.
    if _openssl_libs_loaded == 1 { return 0 }
    var flags = _rtld_flags()
    // Order: libcrypto first, then libssl.
    var h1 = dl.dlopen("libcrypto.so.3", flags)
    if h1 == 0 { return 0 - 5 } // EIO
    var h2 = dl.dlopen("libssl.so.3", flags)
    if h2 == 0 { return 0 - 5 } // EIO
    _openssl_libs_loaded = 1
    return 0
}

@cfg(os="linux")
fn _openssl_init() {
    if _openssl_inited == 1 { return 0 }
    // Do not force DT_NEEDED on libssl/libcrypto for binaries that merely import std:net/http/ws.
    // Instead, load OpenSSL lazily and make it available in RTLD_DEFAULT for subsequent `ffi` calls.
    var dlrc = _openssl_dlopen_libs()
    if dlrc < 0 { return dlrc }
    // OPENSSL_init_ssl returns 1 on success. It's idempotent.
    var rc = OPENSSL_init_ssl(0, 0)
    if rc != 1 { return 0 - 5 } // EIO
    // Linux correctness: ignore SIGPIPE so failed socket writes return EPIPE instead of killing the process.
    // Verified SIGPIPE number: 13 (bash: `kill -l PIPE`).
    signal(13, 1) // SIG_IGN
    _openssl_inited = 1
    return 0
}

@cfg(os="linux")
fn _ssl_error_want_read() { return 2 }
@cfg(os="linux")
fn _ssl_error_want_write() { return 3 }
@cfg(os="linux")
fn _ssl_error_zero_return() { return 6 }

@cfg(os="linux")
fn _openssl_ssl_ctrl_set_tlsext_hostname_cmd() {
    // From OpenSSL headers (Ubuntu noble libssl-dev):
    // - /usr/include/openssl/ssl.h: `# define SSL_CTRL_SET_TLSEXT_HOSTNAME 55`
    return 55
}

@cfg(os="linux")
fn _openssl_tlsext_nametype_host_name() {
    // From OpenSSL headers (Ubuntu noble libssl-dev):
    // - /usr/include/openssl/tls1.h: `# define TLSEXT_NAMETYPE_host_name 0`
    return 0
}

@cfg(os="linux")
fn _openssl_set_sni_if_requested(ssl, server_name, opts) {
    // Wire SNI using SSL_ctrl, because SSL_set_tlsext_host_name is a macro (not a linkable symbol).
    //
    // Server-name selection (rolling):
    // - prefer explicit `server_name` argument
    // - if missing, allow `opts["server_name"]` as an override (useful for already-connected IP sockets / proxies)
    var sn = server_name
    if (sn == nil || sn == 0) && opts != nil && opts != 0 && oren_is_map(opts) == true {
        var sn2 = oren_map_get_str(opts, "server_name")
        if sn2 != 0 { sn = sn2 }
    }
    if sn == nil || sn == 0 { return 0 }
    if oren_string_len(sn) <= 0 { return 0 }
    var rc = SSL_ctrl(ssl, _openssl_ssl_ctrl_set_tlsext_hostname_cmd(), _openssl_tlsext_nametype_host_name(), sn)
    if rc != 1 { return 0 - 5 } // EIO
    return 0
}

@cfg(os="linux")
fn _openssl_set_alpn_if_requested(ssl, opts) {
    // Client ALPN offer.
    //
    // Docs:
    // - OpenSSL man3 `SSL_CTX_set_alpn_select_cb` (covers SSL_set_alpn_protos):
    //   project-doc/web/openssl/SSL_CTX_set_alpn_select_cb.html
    //
    // Return convention:
    // - SSL_set_alpn_protos returns 0 on success (reversed convention).
    if opts == nil || opts == 0 { return 0 }
    if oren_is_map(opts) != true { return 0 }
    var ps = oren_map_get_str(opts, "alpn")
    if ps == 0 { return 0 }
    if oren_is_list(ps) != true { return 0 - 22 } // EINVAL
    var n = oren_list_len(ps)
    if n <= 0 { return 0 }

    // Compute total length and validate elements.
    var total = 0
    var i = 0
    while i < n {
        var p = ps[i]
        if p == 0 || oren_is_string(p) != true { return 0 - 22 }
        var l = oren_string_len(p)
        if l <= 0 || l > 255 { return 0 - 22 }
        total = total + 1 + l
        if total > 1024 { return 0 - 22 } // sanity cap
        i = i + 1
    }
    if total <= 0 { return 0 }

    var buf = malloc(total)
    if buf == 0 { return 0 - 12 } // ENOMEM
    var off = 0
    i = 0
    while i < n {
        var p2 = ps[i]
        var l2 = oren_string_len(p2)
        ptr_set_byte(buf + off, l2 & 255)
        off = off + 1
        var j = 0
        while j < l2 {
            ptr_set_byte(buf + off + j, oren_string_byte_at_unchecked(p2, j) & 255)
            j = j + 1
        }
        off = off + l2
        i = i + 1
    }

    var rc = SSL_set_alpn_protos(ssl, buf, total)
    free(buf)
    if rc != 0 { return 0 - 5 } // EIO
    return 0
}

// OpenSSL server-side ALPN selection callback.
//
// Signature from /usr/include/openssl/ssl.h (OpenSSL 3):
//   typedef int (*SSL_CTX_alpn_select_cb_func)(SSL *ssl,
//     const unsigned char **out, unsigned char *outlen,
//     const unsigned char *in, unsigned int inlen, void *arg);
//
// `arg` points to a small heap block we allocate in `_openssl_set_server_alpn_select_if_requested`:
//   u32 len (little-endian)
//   u8  protos[len] (wire-format protocol list, RFC 7301)
//
// Important: keep this function alive even if it is only referenced via dlsym.
@cfg(os="linux")
@oren.keep
@ffi.export
fn __oren_tls_openssl_alpn_select_cb(ssl, out_pp, outlen_p, in_p, inlen, arg) {
    if out_pp == 0 || outlen_p == 0 { return _ssl_tlsext_err_noack() }
    if in_p == 0 || inlen == 0 { return _ssl_tlsext_err_noack() }
    if arg == 0 { return _ssl_tlsext_err_noack() }

    var s_len = oren_ptr_get_u32_le(arg)
    if s_len <= 0 || s_len > 1024 { return _ssl_tlsext_err_noack() }
    var s_p = arg + 4

    // Prefer server order: pick the first server protocol that appears in the client list.
    var s_off = 0
    while s_off < s_len {
        var sl = ptr_get_byte(s_p + s_off) & 255
        if sl <= 0 { return _ssl_tlsext_err_noack() }
        if s_off + 1 + sl > s_len { return _ssl_tlsext_err_noack() }
        var sp = s_p + s_off + 1

        // Scan client list for an equal protocol.
        var c_off = 0
        while c_off < inlen {
            var cl = ptr_get_byte(in_p + c_off) & 255
            if cl <= 0 { break }
            if c_off + 1 + cl > inlen { break }
            if cl == sl {
                var j = 0
                var same = 1
                while j < sl {
                    if (ptr_get_byte(in_p + c_off + 1 + j) & 255) != (ptr_get_byte(sp + j) & 255) {
                        same = 0
                        break
                    }
                    j = j + 1
                }
                if same == 1 {
                    ptr_set(out_pp, sp)
                    ptr_set_byte(outlen_p, sl & 255)
                    return _ssl_tlsext_err_ok()
                }
            }
            c_off = c_off + 1 + cl
        }

        s_off = s_off + 1 + sl
    }

    // No overlap: leave ALPN unselected (do not fail the handshake).
    return _ssl_tlsext_err_noack()
}

@cfg(os="linux")
fn _openssl_resolve_self_export(name) {
    if name == nil || name == "" { return 0 }
    return dl.dlsym(_RTLD_DEFAULT(), name)
}

@cfg(os="linux")
fn _openssl_set_server_alpn_select_if_requested(ctx, opts) {
    // Server-side ALPN selection (RFC 7301) via SSL_CTX_set_alpn_select_cb.
    //
    // We interpret `opts["alpn"]` as the server's preferred protocol list (wire-format encoded),
    // and select the first overlapping protocol with the client offer.
    //
    // Returns:
    // - {"ok":1,"arg":0} when not requested
    // - {"ok":1,"arg":ptr} when configured (caller owns and must free the returned ptr)
    // - {"ok":0,"err":string} on failure
    if ctx == 0 { return {"ok": 0, "err": "tls: ALPN setup failed"} }
    if opts == nil || opts == 0 { return {"ok": 1, "arg": 0} }
    if oren_is_map(opts) != true { return {"ok": 1, "arg": 0} }
    var ps = oren_map_get_str(opts, "alpn")
    if ps == 0 { return {"ok": 1, "arg": 0} }
    if oren_is_list(ps) != true { return {"ok": 0, "err": "tls: alpn: opts[\"alpn\"] must be list<string>"} }
    var n = oren_list_len(ps)
    if n <= 0 { return {"ok": 1, "arg": 0} }

    // Encode protocol list (wire-format, RFC 7301).
    var total = 0
    var i = 0
    while i < n {
        var p = ps[i]
        if p == 0 || oren_is_string(p) != true { return {"ok": 0, "err": "tls: alpn: protocols must be strings"} }
        var l = oren_string_len(p)
        if l <= 0 || l > 255 { return {"ok": 0, "err": "tls: alpn: protocol length must be 1..255"} }
        total = total + 1 + l
        if total > 1024 { return {"ok": 0, "err": "tls: alpn: protocol list too large"} }
        i = i + 1
    }
    if total <= 0 { return {"ok": 1, "arg": 0} }

    // Allocate arg block: u32 len + bytes.
    var arg = malloc(4 + total)
    if arg == 0 { return {"ok": 0, "err": "tls: alpn: alloc failed"} }
    oren_ptr_set_u32_le(arg, total)
    var off = 0
    i = 0
    while i < n {
        var s = ps[i]
        var l2 = oren_string_len(s)
        ptr_set_byte(arg + 4 + off, l2 & 255)
        off = off + 1
        var j = 0
        while j < l2 {
            ptr_set_byte(arg + 4 + off + j, oren_string_byte_at_unchecked(s, j) & 255)
            j = j + 1
        }
        off = off + l2
        i = i + 1
    }

    // Resolve the exported callback symbol from the main program image.
    // The native backend exports the *linked* name; prefer that, with small fallbacks.
    var cb = _openssl_resolve_self_export("STD_net_tls_linux_openssl___oren_tls_openssl_alpn_select_cb")
    if cb == 0 { cb = _openssl_resolve_self_export("_STD_net_tls_linux_openssl___oren_tls_openssl_alpn_select_cb") }
    if cb == 0 { cb = _openssl_resolve_self_export("__oren_tls_openssl_alpn_select_cb") }
    if cb == 0 { cb = _openssl_resolve_self_export("_oren_tls_openssl_alpn_select_cb") }
    if cb == 0 {
        free(arg)
        return {"ok": 0, "err": "tls: missing exported OpenSSL ALPN select callback symbol (need @ffi.export + native backend export support)"}
    }

    SSL_CTX_set_alpn_select_cb(ctx, cb, arg)
    return {"ok": 1, "arg": arg}
}

@cfg(os="linux")
fn _openssl_wait_io(fd, timeout_ms, want) {
    if want == 1 { return tcp.wait_readable_raw(fd, timeout_ms) }
    return tcp.wait_writable_raw(fd, timeout_ms)
}

@cfg(os="linux")
fn _openssl_handshake(ssl, fd, timeout_ms, is_server) {
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }
    if timeout_ms < 0 { timeout_ms = 0 }
    var t0 = oren_time_unix_ns()
    var rem_ms = timeout_ms

    while true {
        var rc = 0
        if is_server == 1 { rc = SSL_accept(ssl) }
        else { rc = SSL_connect(ssl) }

        if rc == 1 { return 0 }

        var err = SSL_get_error(ssl, rc)
        if err == _ssl_error_want_read() {
            var w = _openssl_wait_io(fd, rem_ms, 1)
            if w == 0 { return 0 - 60 } // ETIMEDOUT
            if w < 0 { return w }
        } else if err == _ssl_error_want_write() {
            var w2 = _openssl_wait_io(fd, rem_ms, 2)
            if w2 == 0 { return 0 - 60 }
            if w2 < 0 { return w2 }
        } else {
            return 0 - 5 // EIO
        }

        var now = oren_time_unix_ns()
        var dt_ms = (now - t0) / 1000000
        if dt_ms < 0 { dt_ms = 0 }
        rem_ms = timeout_ms - dt_ms
        if rem_ms <= 0 { return 0 - 60 }
    }
}

@cfg(os="linux")
fn _openssl_setup_ctx_client(fd, server_name, opts) {
    if fd < 0 { return {"ok": 0, "err": "tls: fd invalid"} }
    var init = _openssl_init()
    if init < 0 { tcp.close_raw(fd); return {"ok": 0, "err": "tls: OPENSSL_init_ssl failed"} }

    var fl = sys_fcntl_getfl(fd)
    // Oren-level O_NONBLOCK flag (translated by sys_fcntl_setfl on each OS).
    if fl >= 0 { sys_fcntl_setfl(fd, fl | 1024) }

    var meth = TLS_client_method()
    if meth == 0 { tcp.close_raw(fd); return {"ok": 0, "err": "tls: TLS_client_method failed"} }
    var ctx = SSL_CTX_new(meth)
    if ctx == 0 { tcp.close_raw(fd); return {"ok": 0, "err": "tls: SSL_CTX_new failed"} }

    var insecure = 0
    if opts != nil && oren_is_map(opts) == true {
        if oren_map_get_str(opts, "insecure_skip_verify") == 1 { insecure = 1 }
    }
    if insecure == 1 {
        // SSL_VERIFY_NONE = 0
        SSL_CTX_set_verify(ctx, 0, 0)
    } else {
        // SSL_VERIFY_PEER = 1
        SSL_CTX_set_verify(ctx, 1, 0)
        SSL_CTX_set_default_verify_paths(ctx)
    }

    var ssl = SSL_new(ctx)
    if ssl == 0 {
        SSL_CTX_free(ctx)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: SSL_new failed"}
    }
    var rc_fd = SSL_set_fd(ssl, fd)
    if rc_fd != 1 {
        SSL_free(ssl)
        SSL_CTX_free(ctx)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: SSL_set_fd failed"}
    }

    // SNI/ALPN (rolling, Linux/OpenSSL):
    // - SNI is wired via SSL_ctrl(...SSL_CTRL_SET_TLSEXT_HOSTNAME...) using constants from libssl-dev headers.
    // - ALPN client offer is wired via SSL_set_alpn_protos using protocol-list wire format.
    var rc_sni = _openssl_set_sni_if_requested(ssl, server_name, opts)
    if rc_sni < 0 {
        SSL_free(ssl)
        SSL_CTX_free(ctx)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: SNI setup failed"}
    }
    var rc_alpn = _openssl_set_alpn_if_requested(ssl, opts)
    if rc_alpn < 0 {
        SSL_free(ssl)
        SSL_CTX_free(ctx)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: ALPN setup failed"}
    }

    return {"ok": 1, "ctx": ctx, "ssl": ssl}
}

@cfg(os="linux")
fn wrap_client(fd, server_name, timeout_ms, opts) {
    if fd == nil || fd < 0 { return {"ok": 0, "err": "tls.wrap_client: fd invalid"} }
    var r = _openssl_setup_ctx_client(fd, server_name, opts)
    if r["ok"] != 1 { return {"ok": 0, "err": r["err"]} }
    var ctx = r["ctx"]
    var ssl = r["ssl"]
    var hs = _openssl_handshake(ssl, fd, timeout_ms, 0)
    if hs != 0 {
        SSL_free(ssl)
        SSL_CTX_free(ctx)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: handshake failed (errno=" + oren_int_to_string(0 - hs) + ")"}
    }
    var conn = {"impl": "linux_openssl", "fd": fd, "ctx": ctx, "ssl": ssl}
    return {"ok": 1, "conn": conn}
}

@cfg(os="linux")
fn _openssl_setup_ctx_server_from_pkcs12(fd, pkcs12_bytes, passphrase, opts) {
    if fd < 0 { return {"ok": 0, "err": "tls: fd invalid"} }
    if pkcs12_bytes == nil { tcp.close_raw(fd); return {"ok": 0, "err": "tls: pkcs12_bytes is nil"} }
    if passphrase == nil { passphrase = "" }
    var init = _openssl_init()
    if init < 0 { tcp.close_raw(fd); return {"ok": 0, "err": "tls: OPENSSL_init_ssl failed"} }

    var fl = sys_fcntl_getfl(fd)
    if fl >= 0 { sys_fcntl_setfl(fd, fl | 1024) }

    var n = oren_buf_len(pkcs12_bytes)
    if oren_is_err(n) || n <= 0 { tcp.close_raw(fd); return {"ok": 0, "err": "tls: pkcs12 len invalid"} }
    var src = native_buf_data_ptr(pkcs12_bytes)
    if src == 0 { tcp.close_raw(fd); return {"ok": 0, "err": "tls: pkcs12 data ptr nil"} }

    // Decode DER PKCS#12.
    var in_ptr = malloc(8)
    if in_ptr == 0 { tcp.close_raw(fd); return {"ok": 0, "err": "tls: alloc failed"} }
    ptr_set(in_ptr, src)
    var p12 = d2i_PKCS12(0, in_ptr, n)
    free(in_ptr)
    if p12 == 0 { tcp.close_raw(fd); return {"ok": 0, "err": "tls: d2i_PKCS12 failed"} }

    // Parse identity.
    var pkey_ptr = malloc(8)
    var cert_ptr = malloc(8)
    var ca_ptr = malloc(8)
    if pkey_ptr == 0 || cert_ptr == 0 || ca_ptr == 0 {
        if pkey_ptr != 0 { free(pkey_ptr) }
        if cert_ptr != 0 { free(cert_ptr) }
        if ca_ptr != 0 { free(ca_ptr) }
        PKCS12_free(p12)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: alloc failed"}
    }
    ptr_set(pkey_ptr, 0)
    ptr_set(cert_ptr, 0)
    ptr_set(ca_ptr, 0)
    var prc = PKCS12_parse(p12, passphrase, pkey_ptr, cert_ptr, ca_ptr)
    PKCS12_free(p12)
    if prc != 1 {
        free(pkey_ptr); free(cert_ptr); free(ca_ptr)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: PKCS12_parse failed"}
    }
    var pkey = ptr_get(pkey_ptr)
    var cert = ptr_get(cert_ptr)
    // ca list ignored in v0.
    free(pkey_ptr); free(cert_ptr); free(ca_ptr)
    if pkey == 0 || cert == 0 {
        if pkey != 0 { EVP_PKEY_free(pkey) }
        if cert != 0 { X509_free(cert) }
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: PKCS12_parse returned nil key/cert"}
    }

    var meth = TLS_server_method()
    if meth == 0 {
        EVP_PKEY_free(pkey)
        X509_free(cert)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: TLS_server_method failed"}
    }
    var ctx = SSL_CTX_new(meth)
    if ctx == 0 {
        EVP_PKEY_free(pkey)
        X509_free(cert)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: SSL_CTX_new failed"}
    }

    // Load identity into the ctx.
    if SSL_CTX_use_certificate(ctx, cert) != 1 {
        SSL_CTX_free(ctx)
        EVP_PKEY_free(pkey)
        X509_free(cert)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: SSL_CTX_use_certificate failed"}
    }
    if SSL_CTX_use_PrivateKey(ctx, pkey) != 1 {
        SSL_CTX_free(ctx)
        EVP_PKEY_free(pkey)
        X509_free(cert)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: SSL_CTX_use_PrivateKey failed"}
    }
    if SSL_CTX_check_private_key(ctx) != 1 {
        SSL_CTX_free(ctx)
        EVP_PKEY_free(pkey)
        X509_free(cert)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: SSL_CTX_check_private_key failed"}
    }

    // Free the parsed objects; ctx holds references.
    EVP_PKEY_free(pkey)
    X509_free(cert)

    // Optional: server ALPN selection callback (RFC 7301).
    var alpn_arg = 0
    var alpn_r = _openssl_set_server_alpn_select_if_requested(ctx, opts)
    if alpn_r["ok"] != 1 {
        SSL_CTX_free(ctx)
        tcp.close_raw(fd)
        return {"ok": 0, "err": alpn_r["err"]}
    }
    alpn_arg = alpn_r["arg"]

    var ssl = SSL_new(ctx)
    if ssl == 0 {
        if alpn_arg != 0 { free(alpn_arg) }
        SSL_CTX_free(ctx)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: SSL_new failed"}
    }
    if SSL_set_fd(ssl, fd) != 1 {
        SSL_free(ssl)
        if alpn_arg != 0 { free(alpn_arg) }
        SSL_CTX_free(ctx)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls: SSL_set_fd failed"}
    }

    return {"ok": 1, "ctx": ctx, "ssl": ssl, "alpn_arg": alpn_arg}
}

@cfg(os="linux")
fn wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts) {
    if fd == nil || fd < 0 { return {"ok": 0, "err": "tls.wrap_server: fd invalid"} }
    var r = _openssl_setup_ctx_server_from_pkcs12(fd, pkcs12_bytes, passphrase, opts)
    if r["ok"] != 1 { return {"ok": 0, "err": r["err"]} }
    var ctx = r["ctx"]
    var ssl = r["ssl"]
    var alpn_arg = r["alpn_arg"]
    if oren_type_tag(alpn_arg) == 0 { alpn_arg = 0 }
    var hs = _openssl_handshake(ssl, fd, timeout_ms, 1)
    if hs != 0 {
        SSL_free(ssl)
        if alpn_arg != 0 { free(alpn_arg) }
        SSL_CTX_free(ctx)
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls.wrap_server: handshake failed (errno=" + oren_int_to_string(0 - hs) + ")"}
    }
    return {"ok": 1, "conn": {"impl": "linux_openssl", "fd": fd, "ctx": ctx, "ssl": ssl, "alpn_arg": alpn_arg}}
}

@cfg(os="linux")
fn read_into(conn, buf, cap, timeout_ms) {
    if conn == nil { return 0 - 22 } // EINVAL
    var ssl = conn["ssl"]
    var fd = conn["fd"]
    if ssl == 0 || fd == nil || fd < 0 { return 0 - 22 }
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }
    if timeout_ms < 0 { timeout_ms = 0 }

    var t0 = oren_time_unix_ns()
    var rem_ms = timeout_ms
    while true {
        var n = SSL_read(ssl, buf, cap)
        if n > 0 { return n }
        if n == 0 { return 0 }
        var err = SSL_get_error(ssl, n)
        if err == _ssl_error_want_read() {
            var w = _openssl_wait_io(fd, rem_ms, 1)
            if w == 0 { return 0 - 60 }
            if w < 0 { return w }
        } else if err == _ssl_error_want_write() {
            var w2 = _openssl_wait_io(fd, rem_ms, 2)
            if w2 == 0 { return 0 - 60 }
            if w2 < 0 { return w2 }
        } else if err == _ssl_error_zero_return() {
            return 0
        } else {
            return 0 - 5
        }
        var now = oren_time_unix_ns()
        var dt_ms = (now - t0) / 1000000
        if dt_ms < 0 { dt_ms = 0 }
        rem_ms = timeout_ms - dt_ms
        if rem_ms <= 0 { return 0 - 60 }
    }
}

@cfg(os="linux")
fn write_from(conn, ptr0, len, timeout_ms) {
    if conn == nil { return 0 - 22 } // EINVAL
    if oren_type_tag(ptr0) == 0 { ptr0 = 0 }
    if oren_type_tag(len) == 0 { len = 0 }
    if len < 0 { len = 0 }
    var ssl = conn["ssl"]
    var fd = conn["fd"]
    if ssl == 0 || fd == nil || fd < 0 { return 0 - 22 }
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }
    if timeout_ms < 0 { timeout_ms = 0 }

    var t0 = oren_time_unix_ns()
    var rem_ms = timeout_ms
    var off = 0
    while off < len {
        var n = SSL_write(ssl, ptr0 + off, len - off)
        if n > 0 {
            off = off + n
            continue
        }
        var err = SSL_get_error(ssl, n)
        if err == _ssl_error_want_read() {
            var w = _openssl_wait_io(fd, rem_ms, 1)
            if w == 0 { return 0 - 60 }
            if w < 0 { return w }
        } else if err == _ssl_error_want_write() {
            var w2 = _openssl_wait_io(fd, rem_ms, 2)
            if w2 == 0 { return 0 - 60 }
            if w2 < 0 { return w2 }
        } else {
            return 0 - 5
        }
        var now = oren_time_unix_ns()
        var dt_ms = (now - t0) / 1000000
        if dt_ms < 0 { dt_ms = 0 }
        rem_ms = timeout_ms - dt_ms
        if rem_ms <= 0 { return 0 - 60 }
    }
    return off
}

@cfg(os="linux")
fn close(conn) {
    if conn == nil { return 0 }
    var ssl = conn["ssl"]
    var ctx = conn["ctx"]
    var fd = conn["fd"]
    var alpn_arg = conn["alpn_arg"]
    if oren_type_tag(alpn_arg) == 0 { alpn_arg = 0 }
    if ssl != 0 {
        SSL_shutdown(ssl)
        SSL_free(ssl)
    }
    if ctx != 0 { SSL_CTX_free(ctx) }
    if alpn_arg != 0 { free(alpn_arg) }
    if fd != nil && fd >= 0 { tcp.close_raw(fd) }
    return 0
}

@cfg(os="linux")
fn peer_cert_sha256_hex(conn) {
    if conn == nil { return {"ok": 0, "err": "tls.peer_cert_sha256_hex: conn is nil"} }
    var ssl = conn["ssl"]
    if ssl == 0 { return {"ok": 0, "err": "tls.peer_cert_sha256_hex: ssl is nil"} }
    var cert = SSL_get1_peer_certificate(ssl)
    if cert == 0 { return {"ok": 0, "err": "tls.peer_cert_sha256_hex: no leaf cert"} }

    var der_len = i2d_X509(cert, 0)
    if der_len <= 0 {
        X509_free(cert)
        return {"ok": 0, "err": "tls.peer_cert_sha256_hex: i2d_X509 len failed"}
    }

    var b = oren_u8_buf_new(der_len)
    if oren_is_err(b) {
        X509_free(cert)
        return {"ok": 0, "err": "tls.peer_cert_sha256_hex: alloc bytes failed"}
    }
    var dst = native_buf_data_ptr(b)
    if dst == 0 {
        X509_free(cert)
        return {"ok": 0, "err": "tls.peer_cert_sha256_hex: bytes data ptr nil"}
    }
    var pp = malloc(8)
    if pp == 0 {
        X509_free(cert)
        return {"ok": 0, "err": "tls.peer_cert_sha256_hex: alloc ptr failed"}
    }
    ptr_set(pp, dst)
    var wrote = i2d_X509(cert, pp)
    free(pp)
    X509_free(cert)
    if wrote != der_len {
        return {"ok": 0, "err": "tls.peer_cert_sha256_hex: i2d_X509 wrote mismatch"}
    }
    var hex = sha256.sha256_hex(b)
    return {"ok": 1, "v": hex}
}

@cfg(os="linux")
fn negotiated_alpn(conn) {
    // Query the negotiated ALPN protocol (if any).
    //
    // OpenSSL API:
    // - SSL_get0_alpn_selected(ssl, &data, &len)
    // Returns:
    // - len=0 if ALPN was not negotiated.
    if conn == nil { return {"ok": 0, "err": "tls.negotiated_alpn: conn is nil"} }
    var ssl = conn["ssl"]
    if ssl == 0 { return {"ok": 0, "err": "tls.negotiated_alpn: ssl is nil"} }

    var pptr = malloc(8)
    var lptr = malloc(8)
    if pptr == 0 || lptr == 0 {
        if pptr != 0 { free(pptr) }
        if lptr != 0 { free(lptr) }
        return {"ok": 0, "err": "tls.negotiated_alpn: alloc failed"}
    }
    ptr_set(pptr, 0)
    oren_ptr_set_u32_le(lptr + 0, 0)
    oren_ptr_set_u32_le(lptr + 4, 0)

    SSL_get0_alpn_selected(ssl, pptr, lptr)
    var p = ptr_get(pptr)
    var n = oren_ptr_get_u32_le(lptr)
    free(pptr)
    free(lptr)
    if n <= 0 || p == 0 { return {"ok": 1, "v": nil} }

    var b = oren_u8_buf_new(n)
    if oren_is_err(b) { return {"ok": 0, "err": "tls.negotiated_alpn: alloc bytes failed"} }
    var dst = native_buf_data_ptr(b)
    if dst == 0 { return {"ok": 0, "err": "tls.negotiated_alpn: buf ptr nil"} }
    oren_memcpy(dst, p, n)
    var s = oren_string_from_bytes_slice(b, 0, n)
    if s == 0 { return {"ok": 0, "err": "tls.negotiated_alpn: string_from_bytes failed"} }
    return {"ok": 1, "v": s}
}
