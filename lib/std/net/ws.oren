// std/net/ws (WebSocket over TCP, rolling)
//
// Scope (v0):
// - ws://<host>[:port][/path]
//   - IPv4 literal hosts work without DNS
//   - hostname hosts resolve via DNS A:
//     - pass an explicit resolver config (`ws.connect_resolver`)
//     - or use `dns.default_resolver` (env `OREN_DNS_SERVER`, else `/etc/resolv.conf` on POSIX)
// - wss://<host>[:port][/path] (TLS wrapper; provider availability is OS-dependent; see docs/DESIGN.md#tls-provider-availability)
// - Text frames (opcode=1) for small messages
// - Client frames are masked (required by RFC6455); server frames are unmasked
//
// This module is intentionally small and syscall-first. Production maturity work
// (HTTP/2, TLS, DNS, streaming APIs) is tracked in `docs/STATUS.md`.

import tcp "std:net/tcp"
import tls "std:net/tls"
import hostutil "std:net/host"
import neturl "std:net/url"
import sha1 "std:crypto/sha1"
import rand "std:crypto/rand"
import base64 "std:encoding/base64"

struct Conn {
    kind,
    fd,
    conn
}

trait WebSocketConn {
    fn send_text_client(self, text, timeout_ms);
    fn send_text_server(self, text, timeout_ms);
    fn send_bytes_client(self, bytes, timeout_ms);
    fn send_bytes_server(self, bytes, timeout_ms);
    fn recv_text(self, timeout_ms);
    fn recv_bytes(self, timeout_ms);
    fn close(self);
}

fn _err_from_record(r, fallback) {
    var msg = r["err"]
    if msg == nil || msg == "" { msg = fallback }
    return oren_err(4, msg)
}

fn _err_from_errno(rc, fallback) {
    var code = 4
    if rc < 0 { code = 0 - rc }
    return oren_err(code, fallback)
}

// --- Transport abstraction (TCP or TLS) ---
//
// Rolling v0:
// - ws:// uses raw TCP
// - wss:// wraps TCP with std:net/tls
//
// We use a tiny tagged map so the rest of the protocol code can remain IO-agnostic.

fn _conn_tcp(fd): Conn { return {"kind": "tcp", "fd": fd} }
fn _conn_tls(conn): Conn { return {"kind": "tls", "conn": conn} }

fn _io_read_into(conn, buf, cap, timeout_ms) {
    if conn == nil || oren_is_map(conn) != true { return 0 - 22 } // EINVAL
    if conn["kind"] == "tls" {
        var c = conn["conn"]
        return tls.read_into_raw(c, buf, cap, timeout_ms)
    }
    var fd = conn["fd"]
    return tcp.read_into_raw(fd, buf, cap, timeout_ms)
}

fn _io_write_from(conn, ptr0, len, timeout_ms) {
    if conn == nil || oren_is_map(conn) != true { return 0 - 22 } // EINVAL
    if conn["kind"] == "tls" {
        var c = conn["conn"]
        return tls.write_from_raw(c, ptr0, len, timeout_ms)
    }
    var fd = conn["fd"]
    return tcp.write_from_raw(fd, ptr0, len, timeout_ms)
}

fn _io_close(conn) {
    if conn == nil || oren_is_map(conn) != true { return 0 }
    if conn["kind"] == "tls" {
        var c = conn["conn"]
        if c != 0 { tls.close_raw(c) }
        return 0
    }
    var fd = conn["fd"]
    if fd != nil && fd >= 0 { tcp.close_raw(fd) }
    return 0
}

// Entropy note (v0.2):
// - Protocol fields require OS entropy (RFC6455 client key + masking).
// - We use `std:crypto/rand` (backed by `oren_getentropy`) instead of time-seeded xorshift.

fn _ws_new_client_key_base64() {
    // RFC6455: Sec-WebSocket-Key is base64 of 16 random bytes.
    var b = rand.bytes(16)
    if oren_is_err(b) {
        return {"ok": 0, "err": "ws.key: " + oren_err_msg(b)}
    }
    return {"ok": 1, "v": base64.encode_bytes(b)}
}

fn _client_key_record() {
    return _ws_new_client_key_base64()
}

fn client_key_base64() {
    var r = _client_key_record()
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "v") }
    return _err_from_record(r, "ws.client_key_base64 failed")
}

fn _parse_ws_url(url) {
    return neturl.parse_ws_record(url)
}

fn _parse_url_record(url) {
    return _parse_ws_url(url)
}

fn parse_url(url) {
    var r = _parse_url_record(url)
    if oren_map_get_str(r, "ok") == 1 {
        return {"scheme": r["scheme"], "host": r["host"], "authority": r["authority"], "port": r["port"], "path": r["path"], "path_only": r["path_only"], "query": r["query"], "request_target": r["request_target"]}
    }
    return _err_from_record(r, "ws.parse_url failed")
}

fn _resolve_host_ipv4(host, timeout_ms, resolver) {
    return hostutil.resolve_host_ipv4("ws", host, timeout_ms, resolver)
}

fn _find_header_body_split(buf, used) {
    // Returns offset of body start, or 0 if not found.
    var i = 0
    while i + 3 < used {
        if ptr_get_byte(buf + i) == 13 {
            if ptr_get_byte(buf + i + 1) == 10 {
                if ptr_get_byte(buf + i + 2) == 13 {
                    if ptr_get_byte(buf + i + 3) == 10 {
                        return i + 4
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn _ascii_lower(b) {
    if b >= 65 && b <= 90 { return b + 32 }
    return b
}

fn _header_name_eq_ci(buf, name_start, name_end, want) {
    var wl = oren_string_len(want)
    if (name_end - name_start) != wl { return 0 }
    var i = 0
    while i < wl {
        var b1 = ptr_get_byte(buf + name_start + i) & 255
        var b2 = ptr_get_byte(want + i) & 255
        if _ascii_lower(b1) != _ascii_lower(b2) { return 0 }
        i = i + 1
    }
    return 1
}

fn _trim_left_ws_in_buf(buf, start, end) {
    var i = start
    while i < end {
        var b = ptr_get_byte(buf + i) & 255
        if b != 32 && b != 9 { break }
        i = i + 1
    }
    return i
}

fn _trim_right_ws_in_buf(buf, start, end) {
    var i = end
    while i > start {
        var b = ptr_get_byte(buf + (i - 1)) & 255
        if b != 32 && b != 9 && b != 13 && b != 10 { break }
        i = i - 1
    }
    return i
}

fn _buf_slice_to_string(buf, start, end) {
    if buf == 0 { return 0 }
    if end < start { return 0 }
    var n = end - start
    // Allocate as a tracked STRING so `+` concatenation works under the native runtime
    // (string concatenation is kind-gated; untracked strings behave like integers).
    var out = malloc_k(n + 1, 1)
    if out == 0 { return 0 }
    if n > 0 { oren_memcpy(out, buf + start, n) }
    ptr_set_byte(out + n, 0)
    return out
}

fn _read_http_header_into_buf(conn, timeout_ms, max_bytes) {
    // Returns:
    //   {"ok":1,"buf":ptr,"used":int,"body_off":int} on success
    //   {"ok":0,"err":string} on failure
    if oren_type_tag(max_bytes) == 0 { max_bytes = 8192 }
    if max_bytes < 256 { max_bytes = 256 }
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }
    if timeout_ms < 0 { timeout_ms = 0 }

    var cap = max_bytes
    var buf = malloc(cap)
    if buf == 0 { return {"ok": 0, "err": "malloc failed"} }
    var used = 0

    var deadline = 0
    if timeout_ms > 0 {
        var t0 = oren_time_unix_ns()
        if t0 != 0 { deadline = t0 + timeout_ms * 1000000 }
    }
    var spins = 0

    var body_off = 0
    while 1 {
        var rem = timeout_ms
        if deadline != 0 {
            var now = oren_time_unix_ns()
            if now != 0 {
                var rem_ns = deadline - now
                if rem_ns <= 0 {
                    free(buf)
                    return {"ok": 0, "err": "read timeout"}
                }
                rem = rem_ns / 1000000
                if rem < 0 { rem = 0 }
            }
        } else {
            // TIME might be unavailable in some bring-up environments; keep bounded.
            spins = spins + 1
            if spins > 64 {
                free(buf)
                return {"ok": 0, "err": "read timeout"}
            }
        }

        var read_cap = cap - used
        if read_cap <= 0 {
            free(buf)
            return {"ok": 0, "err": "header too large"}
        }
        if read_cap > 1024 { read_cap = 1024 }

        var n = _io_read_into(conn, buf + used, read_cap, rem)
        if n == 0 {
            free(buf)
            return {"ok": 0, "err": "eof before header complete"}
        }
        if n < 0 {
            free(buf)
            return {"ok": 0, "err": "read failed (errno=" + oren_int_to_string(0 - n) + ")"}
        }
        used = used + n
        body_off = _find_header_body_split(buf, used)
        if body_off != 0 { break }
    }

    return {"ok": 1, "buf": buf, "used": used, "body_off": body_off}
}

fn _ws_accept_for_key(key) {
    // Sec-WebSocket-Accept = base64( sha1( key + GUID ) )
    //
    // GUID: RFC6455
    var guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
    var s = key + guid
    var digest = sha1.sha1_string(s)
    free(s)
    return base64.encode_bytes(digest)
}

fn _extract_header_value_ci(buf, body_off, want_name) {
    // Returns string value (malloc) or 0 if not found.
    //
    // buf contains at least the full header section ending at body_off.
    // Layout: status line + headers + CRLF.
    if buf == 0 { return 0 }
    if body_off <= 4 { return 0 }

    // Find end of status line.
    var line0_end = -1
    var i0 = 0
    while i0 + 1 < body_off {
        if (ptr_get_byte(buf + i0) & 255) == 13 && (ptr_get_byte(buf + i0 + 1) & 255) == 10 {
            line0_end = i0
            break
        }
        i0 = i0 + 1
    }

    var hpos = 0
    if line0_end >= 0 { hpos = line0_end + 2 }
    while hpos + 1 < body_off {
        // Empty line => end.
        if (ptr_get_byte(buf + hpos) & 255) == 13 && (ptr_get_byte(buf + hpos + 1) & 255) == 10 {
            break
        }
        // Find end of line.
        var lend = -1
        var j = hpos
        while j + 1 < body_off {
            if (ptr_get_byte(buf + j) & 255) == 13 && (ptr_get_byte(buf + j + 1) & 255) == 10 {
                lend = j
                break
            }
            j = j + 1
        }
        if lend < 0 { break }

        // Find ':' separator.
        var colon = -1
        var k = hpos
        while k < lend {
            if (ptr_get_byte(buf + k) & 255) == 58 { colon = k; break }
            k = k + 1
        }
        if colon >= 0 {
            var name_start = hpos
            var name_end = colon
            if _header_name_eq_ci(buf, name_start, name_end, want_name) == 1 {
                var val_start0 = _trim_left_ws_in_buf(buf, colon + 1, lend)
                var val_end0 = _trim_right_ws_in_buf(buf, val_start0, lend)
                return _buf_slice_to_string(buf, val_start0, val_end0)
            }
        }

        hpos = lend + 2
    }
    return 0
}

fn _status_is_101(buf, body_off) {
    // Very small status check: require " 101 " on the status line.
    if buf == 0 { return 0 }
    if body_off <= 0 { return 0 }
    var i = 0
    while i + 4 < body_off {
        if (ptr_get_byte(buf + i) & 255) == 32 {
            if (ptr_get_byte(buf + i + 1) & 255) == 49 &&
               (ptr_get_byte(buf + i + 2) & 255) == 48 &&
               (ptr_get_byte(buf + i + 3) & 255) == 49 &&
               (ptr_get_byte(buf + i + 4) & 255) == 32 {
                return 1
            }
        }
        // Stop at CRLF of status line.
        if (ptr_get_byte(buf + i) & 255) == 13 { break }
        i = i + 1
    }
    return 0
}

fn connect_resolver_opts(url, timeout_ms, resolver, opts): Conn {
    var r = _connect_record(url, timeout_ms, resolver, opts)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "conn") }
    return _err_from_record(r, "ws.connect failed")
}

fn connect_resolver(url, timeout_ms, resolver): Conn {
    return connect_resolver_opts(url, timeout_ms, resolver, 0)
}

fn _connect_record(url, timeout_ms, resolver, opts) {
    // Client handshake. Returns {"ok":1,"conn":map} or {"ok":0,"err":string}.
    //
    // - If `resolver` is provided, it must be a `dns.resolver(...)` config map.
    // - If `resolver` is nil, hostname URLs use `dns.default_resolver` (env `OREN_DNS_SERVER`, else `/etc/resolv.conf` on POSIX).
    //
    // Options (rolling):
    // - opts["tls"] is passed through to `tls.wrap_client` for wss:// URLs.
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }
    if timeout_ms < 0 { timeout_ms = 0 }
    var pu = _parse_ws_url(url)
    if oren_map_get_str(pu, "ok") != 1 { return {"ok": 0, "err": "ws.connect: " + oren_map_get_str(pu, "err")} }

    var is_tls = 0
    if pu["scheme"] == "wss" { is_tls = 1 }

    var host = pu["host"]
    var authority = pu["authority"]
    var port = pu["port"]
    var path = pu["request_target"]

    var rh = _resolve_host_ipv4(host, timeout_ms, resolver)
    if oren_map_get_str(rh, "ok") != 1 {
        free(host)
        free(authority)
        free(path)
        return {"ok": 0, "err": "ws.connect: " + oren_map_get_str(rh, "err")}
    }
    var ip = oren_map_get_str(rh, "ip")
    var owned_ip = oren_map_get_str(rh, "owned")

    var fd = tcp.connect_raw(ip, port, timeout_ms)
    if owned_ip == 1 { free(ip) }
    if fd < 0 {
        free(host)
        free(authority)
        free(path)
        return {"ok": 0, "err": "ws.connect: connect failed (errno=" + oren_int_to_string(0 - fd) + ")"}
    }

    var conn = _conn_tcp(fd)
    var tls_opts = 0
    if is_tls == 1 {
        if opts != nil && oren_is_map(opts) == true {
            tls_opts = oren_map_get_str(opts, "tls")
        }
        var server_name = host
        if tls_opts != 0 && oren_is_map(tls_opts) == true {
            var sn = oren_map_get_str(tls_opts, "server_name")
            if sn != 0 { server_name = sn }
        }
        var cr = tls.wrap_client(fd, server_name, timeout_ms, tls_opts)
        if oren_is_err(cr) {
            // Best-effort: ensure fd isn't leaked on providers that don't close on failure.
            tcp.close_raw(fd)
            free(host)
            free(authority)
            free(path)
            return {"ok": 0, "err": "ws.connect: " + oren_err_msg(cr)}
        }
        var tls_conn = cr
        if tls_conn == 0 {
            tcp.close_raw(fd)
            free(host)
            free(authority)
            free(path)
            return {"ok": 0, "err": "ws.connect: tls.wrap_client returned nil conn"}
        }
        conn = _conn_tls(tls_conn)
    }

    // Best-effort per-connection key (v0.1).
    // RFC6455: base64(random(16))
    var kr = _ws_new_client_key_base64()
    if oren_map_get_str(kr, "ok") != 1 {
        _io_close(conn)
        free(host)
        free(authority)
        free(path)
        return {"ok": 0, "err": "ws.connect: " + oren_map_get_str(kr, "err")}
    }
    var key = oren_map_get_str(kr, "v")
    var req = "GET " + path + " HTTP/1.1\r\nHost: " + authority +
              "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + key +
              "\r\nSec-WebSocket-Version: 13\r\n\r\n"

    var wr = _io_write_from(conn, req, oren_string_len(req), timeout_ms)
    free(req)
    if wr < 0 {
        _io_close(conn)
        free(key)
        free(host)
        free(authority)
        free(path)
        return {"ok": 0, "err": "ws.connect: write failed (errno=" + oren_int_to_string(0 - wr) + ")"}
    }

    var hdr = _read_http_header_into_buf(conn, timeout_ms, 8192)
    if oren_map_get_str(hdr, "ok") != 1 {
        _io_close(conn)
        free(key)
        free(host)
        free(authority)
        free(path)
        return {"ok": 0, "err": "ws.connect: " + oren_map_get_str(hdr, "err")}
    }

    var hbuf = oren_map_get_str(hdr, "buf")
    var body_off = oren_map_get_str(hdr, "body_off")
    if _status_is_101(hbuf, body_off) == 0 {
        free(hbuf)
        _io_close(conn)
        free(key)
        free(host)
        free(authority)
        free(path)
        return {"ok": 0, "err": "ws.connect: expected HTTP 101"}
    }

    var accept = _extract_header_value_ci(hbuf, body_off, "sec-websocket-accept")
    if accept == 0 {
        free(hbuf)
        _io_close(conn)
        free(key)
        free(host)
        free(authority)
        free(path)
        return {"ok": 0, "err": "ws.connect: missing Sec-WebSocket-Accept"}
    }

    var want = _ws_accept_for_key(key)
    free(key)
    var ok = (strcmp(accept, want) == 0)
    var got_accept = accept
    var want_accept = want
    free(hbuf)
    if ok != true {
        _io_close(conn)
        free(host)
        free(authority)
        free(path)
        // Keep diagnostics short: base64 accept values are small (28 chars).
        var msg = "ws.connect: accept mismatch (got=" + got_accept + " want=" + want_accept + ")"
        free(got_accept)
        free(want_accept)
        return {"ok": 0, "err": msg}
    }

    free(got_accept)
    free(want_accept)
    free(host)
    free(authority)
    free(path)
    return {"ok": 1, "conn": conn}
}

fn connect(url, timeout_ms): Conn {
    // Convenience API: connect without an explicit resolver.
    // - IPv4 literal URLs work without DNS.
    // - hostname URLs use `dns.default_resolver` (env `OREN_DNS_SERVER`, else `/etc/resolv.conf` on POSIX).
    return connect_resolver_opts(url, timeout_ms, 0, 0)
}

fn _server_handshake(conn, timeout_ms) {
    // Returns {"ok":1} or {"ok":0,"err":string}.
    var hdr = _read_http_header_into_buf(conn, timeout_ms, 8192)
    if oren_map_get_str(hdr, "ok") != 1 {
        return {"ok": 0, "err": "ws.accept: " + oren_map_get_str(hdr, "err")}
    }
    var hbuf = oren_map_get_str(hdr, "buf")
    var body_off = oren_map_get_str(hdr, "body_off")

    var key = _extract_header_value_ci(hbuf, body_off, "sec-websocket-key")
    if key == 0 {
        free(hbuf)
        return {"ok": 0, "err": "ws.accept: missing Sec-WebSocket-Key"}
    }

    var accept = _ws_accept_for_key(key)
    free(key)
    if accept == 0 {
        free(hbuf)
        return {"ok": 0, "err": "ws.accept: accept compute failed"}
    }

    var resp = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n"
    free(accept)
    var wr = _io_write_from(conn, resp, oren_string_len(resp), timeout_ms)
    free(resp)
    free(hbuf)
    if wr < 0 {
        return {"ok": 0, "err": "ws.accept: write failed (errno=" + oren_int_to_string(0 - wr) + ")"}
    }
    return {"ok": 1}
}

fn _accept_record(listen_fd, timeout_ms) {
    // Server accept + handshake. Returns {"ok":1,"conn":map} or {"ok":0,"err":string}.
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }
    if timeout_ms < 0 { timeout_ms = 0 }
    var fd = tcp.accept_raw(listen_fd, timeout_ms)
    if fd < 0 {
        return {"ok": 0, "err": "ws.accept: accept failed (errno=" + oren_int_to_string(0 - fd) + ")"}
    }
    var conn = _conn_tcp(fd)
    var r = _server_handshake(conn, timeout_ms)
    if oren_map_get_str(r, "ok") != 1 {
        _io_close(conn)
        return r
    }
    return {"ok": 1, "conn": conn}
}

fn accept(listen_fd, timeout_ms): Conn {
    var r = _accept_record(listen_fd, timeout_ms)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "conn") }
    return _err_from_record(r, "ws.accept failed")
}

fn _accept_tls_pkcs12_record(listen_fd, timeout_ms, pkcs12_bytes, passphrase, tls_opts) {
    // TLS server accept + handshake for wss:// loopback fixtures and basic servers.
    // Returns {"ok":1,"conn":map} or {"ok":0,"err":string}.
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }
    if timeout_ms < 0 { timeout_ms = 0 }
    var fd = tcp.accept_raw(listen_fd, timeout_ms)
    if fd < 0 {
        return {"ok": 0, "err": "ws.accept_tls: accept failed (errno=" + oren_int_to_string(0 - fd) + ")"}
    }
    var wr = tls.wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, tls_opts)
    if oren_is_err(wr) {
        // wrap_server_pkcs12 closes fd on many failure paths, but keep best-effort cleanup here.
        tcp.close_raw(fd)
        return {"ok": 0, "err": "ws.accept_tls: " + oren_err_msg(wr)}
    }
    var tls_conn = wr
    if tls_conn == 0 {
        tcp.close_raw(fd)
        return {"ok": 0, "err": "ws.accept_tls: tls.wrap_server returned nil conn"}
    }
    var conn = _conn_tls(tls_conn)
    var r = _server_handshake(conn, timeout_ms)
    if oren_map_get_str(r, "ok") != 1 {
        _io_close(conn)
        return r
    }
    return {"ok": 1, "conn": conn}
}

fn accept_tls_pkcs12(listen_fd, timeout_ms, pkcs12_bytes, passphrase, tls_opts): Conn {
    var r = _accept_tls_pkcs12_record(listen_fd, timeout_ms, pkcs12_bytes, passphrase, tls_opts)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "conn") }
    return _err_from_record(r, "ws.accept_tls failed")
}

fn close(conn) {
    return _io_close(conn)
}

fn _read_exact(conn, buf, want, timeout_ms) {
    // Returns 0 on success, or -errno.
    if want <= 0 { return 0 }
    if buf == 0 { return 0 - 22 } // EINVAL
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }

    var deadline = 0
    if timeout_ms > 0 {
        var t0 = oren_time_unix_ns()
        if t0 != 0 { deadline = t0 + timeout_ms * 1000000 }
    }

    var off = 0
    var spins = 0
    while off < want {
        // Rolling correctness guard (Win64 bring-up):
        // ensure loop indices used for pointer arithmetic are canonical i32 values.
        off = native_canon_i32_arg(off)
        want = native_canon_i32_arg(want)
        var rem = timeout_ms
        if deadline != 0 {
            var now = oren_time_unix_ns()
            if now != 0 {
                var rem_ns = deadline - now
                if rem_ns <= 0 { return 0 - 60 } // ETIMEDOUT
                rem = rem_ns / 1000000
                if rem < 0 { rem = 0 }
            }
        } else {
            // Worst-case guard: if TIME is unavailable, do not loop forever on partial reads.
            spins = spins + 1
            if spins > 64 { return 0 - 60 } // ETIMEDOUT (best-effort)
        }

        var need = native_canon_i32_arg(want - off)
        var n = _io_read_into(conn, iadd(buf, off), need, rem)
        if n == 0 { return 0 - 5 } // EIO (EOF)
        if n == 0 - 60 { continue } // ETIMEDOUT
        if n < 0 { return n }
        off = native_canon_i32_arg(off + n)
    }
    return 0
}

fn _write_u16_be(buf, off, v) {
    ptr_set_byte(buf + off + 0, (v >> 8) & 255)
    ptr_set_byte(buf + off + 1, v & 255)
    return nil
}

fn _write_u64_be(buf, off, v) {
    // v is treated as unsigned 64-bit.
    var i = 0
    while i < 8 {
        var shift = (7 - i) * 8
        ptr_set_byte(buf + off + i, (v >> shift) & 255)
        i = i + 1
    }
    return nil
}

fn _mask_byte(mask0, mask1, mask2, mask3, i) {
    var m = mask0
    var r = i % 4
    if r == 1 { m = mask1 }
    else if r == 2 { m = mask2 }
    else if r == 3 { m = mask3 }
    return m & 255
}

fn _send_frame_raw(conn, opcode, payload_ptr, payload_len, timeout_ms, masked) {
    // Low-level “build a single frame and write it”. Used by text/ping/pong/close.
    //
    // payload_ptr may be 0 when payload_len==0.
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }
    if oren_type_tag(payload_ptr) == 0 { payload_ptr = 0 }
    if oren_type_tag(payload_len) == 0 { payload_len = 0 }
    if payload_len < 0 { payload_len = 0 }
    if payload_len > 0 && payload_ptr == 0 { return 0 - 22 } // EINVAL

    // Header sizing: 2 + ext + mask + payload
    var ext = 0
    if payload_len < 126 { ext = 0 }
    else if payload_len < 65536 { ext = 2 }
    else { ext = 8 }

    if masked != 1 {
        var hdr_len = 2 + ext
        var hdr = malloc(14)
        if hdr == 0 { return 0 - 12 } // ENOMEM
        ptr_set_byte(hdr + 0, 128 | (opcode & 15))
        if ext == 0 {
            ptr_set_byte(hdr + 1, payload_len & 127)
        } else if ext == 2 {
            ptr_set_byte(hdr + 1, 126)
            _write_u16_be(hdr, 2, payload_len)
        } else {
            ptr_set_byte(hdr + 1, 127)
            _write_u64_be(hdr, 2, payload_len)
        }
        var hw = _io_write_from(conn, hdr, hdr_len, timeout_ms)
        free(hdr)
        if hw < 0 { return hw }
        if hw != hdr_len { return 0 - 5 } // EIO
        if payload_len <= 0 { return 0 }
        var pw = _io_write_from(conn, payload_ptr, payload_len, timeout_ms)
        if pw < 0 { return pw }
        if pw != payload_len { return 0 - 5 } // EIO
        return 0
    }

    var mask_bytes = 4
    var hdr_len = 2 + ext + mask_bytes
    var hdr = malloc(14)
    if hdr == 0 { return 0 - 12 } // ENOMEM

    // FIN=1, opcode
    ptr_set_byte(hdr + 0, 128 | (opcode & 15))
    if ext == 0 {
        ptr_set_byte(hdr + 1, 128 | (payload_len & 127))
    } else if ext == 2 {
        ptr_set_byte(hdr + 1, 128 | 126)
        _write_u16_be(hdr, 2, payload_len)
    } else {
        ptr_set_byte(hdr + 1, 128 | 127)
        _write_u64_be(hdr, 2, payload_len)
    }

    // Best-effort mask (v0.1): not constant.
    var mask0 = 0
    var mask1 = 0
    var mask2 = 0
    var mask3 = 0

    var mask_off = 2 + ext
    var rc_r = rand.fill_raw(hdr + mask_off, 4)
    if rc_r < 0 { free(hdr); return rc_r }
    mask0 = ptr_get_byte(hdr + mask_off + 0) & 255
    mask1 = ptr_get_byte(hdr + mask_off + 1) & 255
    mask2 = ptr_get_byte(hdr + mask_off + 2) & 255
    mask3 = ptr_get_byte(hdr + mask_off + 3) & 255

    // Rolling correctness guard (Win64 bring-up):
    // copy critical args to fresh locals before calling into the NET runtime so local-slot overlap
    // bugs in the native backend are less likely to corrupt the send length/pointers.
    var fd2 = conn
    var buf2 = hdr
    var total2 = hdr_len
    var tm2 = timeout_ms
    var wr = _io_write_from(fd2, buf2, total2, tm2)
    free(hdr)
    if wr < 0 { return wr }
    if wr != total2 { return 0 - 5 } // EIO
    if payload_len <= 0 { return 0 }

    var scratch_len = payload_len
    if scratch_len > 4096 { scratch_len = 4096 }
    var scratch = malloc(scratch_len)
    if scratch == 0 { return 0 - 12 } // ENOMEM
    var sent = 0
    while sent < payload_len {
        var take = payload_len - sent
        if take > scratch_len { take = scratch_len }
        var i = 0
        while i < take {
            var b = ptr_get_byte(payload_ptr + sent + i) & 255
            b = b ^ _mask_byte(mask0, mask1, mask2, mask3, sent + i)
            ptr_set_byte(scratch + i, b)
            i = i + 1
        }
        var fd3 = conn
        var buf3 = scratch
        var take3 = take
        var tm3 = timeout_ms
        wr = _io_write_from(fd3, buf3, take3, tm3)
        if wr < 0 { free(scratch); return wr }
        if wr != take3 { free(scratch); return 0 - 5 } // EIO
        sent = sent + take
    }
    free(scratch)
    return 0
}

fn _send_frame_str(conn, opcode, text, timeout_ms, masked) {
    if text == nil { text = "" }
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }
    return _send_frame_raw(conn, opcode, text, oren_string_len(text), timeout_ms, masked)
}

fn _send_frame_text(conn, text, timeout_ms, masked) {
    return _send_frame_str(conn, 1, text, timeout_ms, masked)
}

fn _send_frame_bytes(conn, opcode, bytes, timeout_ms, masked) {
    if bytes == nil { return 0 - 22 } // EINVAL
    if oren_is_u8_buf(bytes) != true { return 0 - 22 } // EINVAL
    var n = oren_bytes_len(bytes)
    var p = 0
    if n > 0 { p = native_buf_data_ptr(bytes) }
    return _send_frame_raw(conn, opcode, p, n, timeout_ms, masked)
}

fn send_text_client(conn, text, timeout_ms) {
    return _send_frame_text(conn, text, timeout_ms, 1)
}

fn _send_text_client_value(conn, text, timeout_ms) {
    var rc = send_text_client(conn, text, timeout_ms)
    if rc >= 0 { return 0 }
    return _err_from_errno(rc, "ws.send_text_client failed")
}

fn send_text_server(conn, text, timeout_ms) {
    return _send_frame_text(conn, text, timeout_ms, 0)
}

fn _send_text_server_value(conn, text, timeout_ms) {
    var rc = send_text_server(conn, text, timeout_ms)
    if rc >= 0 { return 0 }
    return _err_from_errno(rc, "ws.send_text_server failed")
}

fn send_bytes_client(conn, bytes, timeout_ms) {
    return _send_frame_bytes(conn, 2, bytes, timeout_ms, 1)
}

fn _send_bytes_client_value(conn, bytes, timeout_ms) {
    var rc = send_bytes_client(conn, bytes, timeout_ms)
    if rc >= 0 { return 0 }
    return _err_from_errno(rc, "ws.send_bytes_client failed")
}

fn send_bytes_server(conn, bytes, timeout_ms) {
    return _send_frame_bytes(conn, 2, bytes, timeout_ms, 0)
}

fn _send_bytes_server_value(conn, bytes, timeout_ms) {
    var rc = send_bytes_server(conn, bytes, timeout_ms)
    if rc >= 0 { return 0 }
    return _err_from_errno(rc, "ws.send_bytes_server failed")
}

fn send_ping_client(conn, payload, timeout_ms) {
    // Client-to-server ping must be masked.
    return _send_frame_str(conn, 9, payload, timeout_ms, 1)
}

fn send_ping_server(conn, payload, timeout_ms) {
    // Server-to-client ping must be unmasked.
    return _send_frame_str(conn, 9, payload, timeout_ms, 0)
}

fn _recv_payload(conn, timeout_ms, want_opcode, want_bytes) {
    // Returns {"ok":1,"v":string/u8_buf} or {"ok":0,"err":string}.
    if oren_type_tag(timeout_ms) == 0 { timeout_ms = 5000 }

    var frame_hdr = malloc(14)
    if frame_hdr == 0 { return {"ok": 0, "err": "ws.recv_text: malloc frame header failed"} }

    // Ping/pong and close are handled internally and do not escape to callers:
    // - ping => auto-pong + continue
    // - pong => ignore + continue
    // - close => respond with close and return ok=0
    while 1 {
        var rc = _read_exact(conn, frame_hdr, 2, timeout_ms)
        if rc < 0 { free(frame_hdr); return {"ok": 0, "err": "ws.recv_text: read hdr failed (errno=" + oren_int_to_string(0 - rc) + ")"} }

        var b0 = ptr_get_byte(frame_hdr + 0) & 255
        var b1 = ptr_get_byte(frame_hdr + 1) & 255

        var fin = (b0 >> 7) & 1
        var opcode = b0 & 15
        var masked = (b1 >> 7) & 1
        var plen7 = b1 & 127

        if fin != 1 {
            free(frame_hdr)
            return {"ok": 0, "err": "ws.recv_text: fragmented frames not supported"}
        }

        var plen = plen7
        var ext_len = 0
        if plen7 == 126 {
            ext_len = 2
            rc = _read_exact(conn, frame_hdr + 2, ext_len, timeout_ms)
            if rc < 0 { free(frame_hdr); return {"ok": 0, "err": "ws.recv_text: read ext16 failed (errno=" + oren_int_to_string(0 - rc) + ", opcode=" + oren_int_to_string(opcode) + ", masked=" + oren_int_to_string(masked) + ", plen7=" + oren_int_to_string(plen7) + ")"} }
            plen = ((ptr_get_byte(frame_hdr + 2) & 255) << 8) | (ptr_get_byte(frame_hdr + 3) & 255)
        } else if plen7 == 127 {
            ext_len = 8
            rc = _read_exact(conn, frame_hdr + 2, ext_len, timeout_ms)
            if rc < 0 { free(frame_hdr); return {"ok": 0, "err": "ws.recv_text: read ext64 failed (errno=" + oren_int_to_string(0 - rc) + ", opcode=" + oren_int_to_string(opcode) + ", masked=" + oren_int_to_string(masked) + ", plen7=" + oren_int_to_string(plen7) + ")"} }
            // u64 be (best-effort; reject huge sizes)
            plen = 0
            var i = 0
            while i < 8 {
                plen = plen * 256 + (ptr_get_byte(frame_hdr + 2 + i) & 255)
                i = i + 1
            }
        }

        // Rolling safety: cap payload size.
        if plen < 0 || plen > 1048576 {
            free(frame_hdr)
            return {"ok": 0, "err": "ws.recv_text: payload too large"}
        }

        var mask0 = 0
        var mask1 = 0
        var mask2 = 0
        var mask3 = 0
        if masked == 1 {
            var mask_off = 2 + ext_len
            rc = _read_exact(conn, frame_hdr + mask_off, 4, timeout_ms)
            if rc < 0 { free(frame_hdr); return {"ok": 0, "err": "ws.recv_text: read mask failed (errno=" + oren_int_to_string(0 - rc) + ", opcode=" + oren_int_to_string(opcode) + ", plen=" + oren_int_to_string(plen) + ")"} }
            mask0 = ptr_get_byte(frame_hdr + mask_off + 0) & 255
            mask1 = ptr_get_byte(frame_hdr + mask_off + 1) & 255
            mask2 = ptr_get_byte(frame_hdr + mask_off + 2) & 255
            mask3 = ptr_get_byte(frame_hdr + mask_off + 3) & 255
        }

        var out = 0
        var outp = 0
        if want_bytes == 1 {
            out = oren_u8_buf_new_uninit(plen)
            if oren_is_err(out) { free(frame_hdr); return {"ok": 0, "err": "ws.recv_bytes: alloc payload"} }
            if plen > 0 {
                outp = native_buf_data_ptr(out)
                if outp == 0 { free(frame_hdr); return {"ok": 0, "err": "ws.recv_bytes: payload data ptr nil"} }
            }
        } else {
            out = malloc(plen + 1)
            if out == 0 { free(frame_hdr); return {"ok": 0, "err": "ws.recv_text: malloc payload"} }
            outp = out
        }
        rc = _read_exact(conn, outp, plen, timeout_ms)
        if rc < 0 {
            if want_bytes != 1 { free(out) }
            free(frame_hdr)
            return {"ok": 0, "err": "ws.recv_text: read payload failed (errno=" + oren_int_to_string(0 - rc) + ", opcode=" + oren_int_to_string(opcode) + ", plen=" + oren_int_to_string(plen) + ", masked=" + oren_int_to_string(masked) + ")"}
        }
        var i2 = 0
        while masked == 1 && i2 < plen {
            var b = ptr_get_byte(outp + i2) & 255
            b = b ^ _mask_byte(mask0, mask1, mask2, mask3, i2)
            ptr_set_byte(outp + i2, b)
            i2 = i2 + 1
        }
        if want_bytes != 1 { ptr_set_byte(out + plen, 0) }

        // RFC6455: client->server frames are masked; server->client are not.
        // Use the incoming masked bit as a heuristic for the role when responding.
        var out_masked = 0
        if masked == 0 { out_masked = 1 }

        if opcode == 9 {
            // ping => pong + continue
            var prc = _send_frame_raw(conn, 10, outp, plen, timeout_ms, out_masked)
            if want_bytes != 1 { free(out) }
            if prc < 0 {
                free(frame_hdr)
                return {"ok": 0, "err": "ws.recv_text: auto-pong failed (errno=" + oren_int_to_string(0 - prc) + ")"}
            }
            continue
        }
        if opcode == 10 {
            // pong => ignore + continue
            if want_bytes != 1 { free(out) }
            continue
        }
        if opcode == 8 {
            // close => echo close + return (caller may close the fd)
            var crc = _send_frame_raw(conn, 8, outp, plen, timeout_ms, out_masked)
            if want_bytes != 1 { free(out) }
            if crc < 0 {
                free(frame_hdr)
                return {"ok": 0, "err": "ws.recv_text: close send failed (errno=" + oren_int_to_string(0 - crc) + ")"}
            }
            free(frame_hdr)
            return {"ok": 0, "err": "ws.recv_text: close"}
        }
        if opcode != want_opcode {
            if want_bytes != 1 { free(out) }
            free(frame_hdr)
            return {"ok": 0, "err": "ws.recv_text: unsupported opcode " + oren_int_to_string(opcode)}
        }

        free(frame_hdr)
        return {"ok": 1, "v": out}
    }
}

fn recv_text(conn, timeout_ms) {
    return _recv_payload(conn, timeout_ms, 1, 0)
}

fn _recv_text_value(conn, timeout_ms) {
    var r = recv_text(conn, timeout_ms)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "v") }
    return _err_from_record(r, "ws.recv_text failed")
}

fn recv_bytes(conn, timeout_ms) {
    return _recv_payload(conn, timeout_ms, 2, 1)
}

fn _recv_bytes_value(conn, timeout_ms) {
    var r = recv_bytes(conn, timeout_ms)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "v") }
    return _err_from_record(r, "ws.recv_bytes failed")
}

impl WebSocketConn for Conn {
    fn send_text_client(self, text, timeout_ms) { return _send_text_client_value(self, text, timeout_ms) }
    fn send_text_server(self, text, timeout_ms) { return _send_text_server_value(self, text, timeout_ms) }
    fn send_bytes_client(self, bytes, timeout_ms) { return _send_bytes_client_value(self, bytes, timeout_ms) }
    fn send_bytes_server(self, bytes, timeout_ms) { return _send_bytes_server_value(self, bytes, timeout_ms) }
    fn recv_text(self, timeout_ms) { return _recv_text_value(self, timeout_ms) }
    fn recv_bytes(self, timeout_ms) { return _recv_bytes_value(self, timeout_ms) }
    fn close(self) { return close(self) }
}
