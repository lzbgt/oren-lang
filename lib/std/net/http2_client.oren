// std/net/http2_client (rolling)
//
// Goal:
// - Provide a minimal HTTP/2 client layer on top of:
//   - `std:net/tls` (transport)
//   - `std:net/http2` (framing primitives)
//   - `std:net/hpack` (header compression)
//
// Non-goals (v0):
// - multiplexing multiple concurrent streams
// - full RFC 7540 stream state machine / flow control
// - server push
//
// This module is designed so Tier‑1 loopback tests can exercise real stdlib behavior
// without embedding framing logic in every test.

import tls "std:net/tls"
import h2 "std:net/http2"
import hpack "std:net/hpack"
import buffer "std:buffer"

struct Client {
    state
}

struct Response {
    status,
    headers,
    body
}

trait Http2Client {
    fn request(self, headers, body_bytes, opts): Response;
    fn raw_state(self);
}

trait Http2ResponseBody {
    fn bytes(self);
    fn text(self);
}

fn _err(msg) { return {"ok": 0, "err": msg} }

fn _err_from_record(r, fallback) {
    var msg = r["err"]
    if msg == nil || msg == "" { msg = fallback }
    return oren_err(4, msg)
}

fn _wrap_response(r) {
    return Response(r["status"], r["headers"], r["body"])
}

fn _str_eq_bytes(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _read_exact(conn, buf, need, timeout_ms) {
    if need < 0 { return 0 - 22 }
    var off = 0
    while off < need {
        var n = tls.read_into_raw(conn, buf + off, need - off, timeout_ms)
        if n < 0 { return n }
        if n == 0 { return 0 - 104 }
        off = off + n
    }
    return 0
}

fn _write_all_ptr(conn, ptr0, n, timeout_ms) {
    if n < 0 { return 0 - 22 }
    var off = 0
    while off < n {
        var w = tls.write_from_raw(conn, ptr0 + off, n - off, timeout_ms)
        if w < 0 { return w }
        if w == 0 { return 0 - 104 }
        off = off + w
    }
    return 0
}

fn _write_all_str(conn, s, n, timeout_ms) {
    return _write_all_ptr(conn, s, n, timeout_ms)
}

fn _u8_acc_new(initial_cap) {
    if initial_cap < 64 { initial_cap = 64 }
    var buf = oren_u8_buf_new_uninit(initial_cap)
    if oren_is_err(buf) { return buf }
    return {"buf": buf, "len": 0, "cap": initial_cap}
}

fn _u8_acc_new_exact(capacity) {
    if capacity < 0 { return oren_err(4, "http2_client: acc negative capacity") }
    var buf = oren_u8_buf_new_uninit(capacity)
    if oren_is_err(buf) { return buf }
    return {"buf": buf, "len": 0, "cap": capacity}
}

fn _u8_acc_reserve(acc, extra) {
    if extra < 0 { return oren_err(4, "http2_client: acc negative extra") }
    var len = acc["len"]
    var cap = acc["cap"]
    var need = len + extra
    if need <= cap { return 0 }
    var new_cap = cap
    if new_cap < 64 { new_cap = 64 }
    while new_cap < need {
        new_cap = new_cap * 2
    }
    var nb = oren_u8_buf_new_uninit(new_cap)
    if oren_is_err(nb) { return nb }
    if len > 0 {
        var oldp = native_buf_data_ptr(acc["buf"])
        var newp = native_buf_data_ptr(nb)
        if oldp == 0 || newp == 0 { return oren_err(4, "http2_client: acc grow nil ptr") }
        oren_memcpy(newp, oldp, len)
    }
    acc["buf"] = nb
    acc["cap"] = new_cap
    return 0
}

fn _u8_acc_append(acc, b) {
    if b == nil { return 0 }
    var n = oren_buf_len(b)
    if oren_is_err(n) { return oren_err(4, "http2_client: acc append bad buf") }
    if n == 0 { return 0 }
    var rc = _u8_acc_reserve(acc, n)
    if oren_is_err(rc) { return rc }
    var src = native_buf_data_ptr(b)
    var dst = native_buf_data_ptr(acc["buf"])
    if src == 0 || dst == 0 { return oren_err(4, "http2_client: acc append nil ptr") }
    oren_memcpy(dst + acc["len"], src, n)
    acc["len"] = acc["len"] + n
    return 0
}

fn _u8_acc_finish(acc) {
    var len = acc["len"]
    if len == acc["cap"] { return acc["buf"] }
    var out = oren_u8_buf_new_uninit(len)
    if oren_is_err(out) { return out }
    if len > 0 {
        var src = native_buf_data_ptr(acc["buf"])
        var dst = native_buf_data_ptr(out)
        if src == 0 || dst == 0 { return oren_err(4, "http2_client: acc finish nil ptr") }
        oren_memcpy(dst, src, len)
    }
    return out
}

fn _parse_content_length_value(v) {
    if v == nil { return 0 - 2 }
    var n = oren_string_len(v)
    if n <= 0 { return 0 - 2 }
    var out = 0
    var i = 0
    while i < n {
        var c = oren_string_byte_at_unchecked(v, i) & 255
        if c < 48 || c > 57 { return 0 - 2 }
        var d = c - 48
        if out > 214748364 { return 0 - 2 }
        if out == 214748364 && d > 7 { return 0 - 2 }
        out = out * 10 + d
        i = i + 1
    }
    return out
}

fn _headers_content_length(hs) {
    var found = 0 - 1
    var header_count = oren_list_len(hs)
    var i = 0
    while i < header_count {
        var h = hs[i]
        if h != nil && h["name"] != nil && h["value"] != nil && _str_eq_bytes(h["name"], "content-length") == true {
            var v = _parse_content_length_value(h["value"])
            if v < 0 { return 0 - 2 }
            if found >= 0 && found != v { return 0 - 2 }
            found = v
        }
        i = i + 1
    }
    return found
}

fn _read_frame(conn, timeout_ms) {
    var hdr = malloc(16)
    if hdr == 0 { return _err("http2_client._read_frame: oom hdr") }
    var rr0 = _read_exact(conn, hdr, 9, timeout_ms)
    if rr0 != 0 { free(hdr); return _err("http2_client._read_frame: read header") }
    var fh = h2.parse_frame_header(hdr)
    free(hdr)
    if fh["ok"] != 1 { return _err("http2_client._read_frame: bad header") }
    var length = fh["len"]
    var payload = oren_u8_buf_new_uninit(length)
    if oren_is_err(payload) { return _err("http2_client._read_frame: oom payload") }
    if length > 0 {
        var p = native_buf_data_ptr(payload)
        if p == 0 { return _err("http2_client._read_frame: nil payload ptr") }
        rr0 = _read_exact(conn, p, length, timeout_ms)
        if rr0 != 0 { return _err("http2_client._read_frame: read payload") }
    }
    return {"ok": 1, "type": fh["type"], "flags": fh["flags"], "stream": fh["stream"], "payload": payload}
}

fn _send_frame_raw_payload(conn, typ, flags, stream_id, payload_ptr, payload_len, timeout_ms) {
    if payload_len < 0 { return 0 - 22 }
    if payload_len > 0 && payload_ptr == 0 { return 0 - 22 }
    var hdr = malloc(16)
    if hdr == 0 { return 0 - 12 }
    var rc0 = h2.write_frame_header_raw(hdr, payload_len, typ, flags, stream_id)
    if rc0 != 0 { free(hdr); return rc0 }
    var wr0 = _write_all_ptr(conn, hdr, 9, timeout_ms)
    free(hdr)
    if wr0 != 0 { return wr0 }
    if payload_len == 0 { return 0 }
    return _write_all_ptr(conn, payload_ptr, payload_len, timeout_ms)
}

fn _send_frame(conn, typ, flags, stream_id, payload_bytes, timeout_ms) {
    if payload_bytes == nil { payload_bytes = oren_u8_buf_new(0) }
    var plen = oren_buf_len(payload_bytes)
    if oren_is_err(plen) { return 0 - 22 }
    var ptr0 = 0
    if plen > 0 {
        ptr0 = native_buf_data_ptr(payload_bytes)
        if ptr0 == 0 { return 0 - 22 }
    }
    return _send_frame_raw_payload(conn, typ, flags, stream_id, ptr0, plen, timeout_ms)
}

fn _read_header_block(conn, first_fr, timeout_ms) {
    if first_fr == nil { return _err("http2_client: nil frame") }
    if first_fr["type"] != h2.FRAME_HEADERS { return _err("http2_client: expected HEADERS") }
    var stream = first_fr["stream"]
    var flags = first_fr["flags"]
    if (flags & h2.FLAG_PADDED) != 0 { return _err("http2_client: PADDED not supported") }
    if (flags & h2.FLAG_PRIORITY) != 0 { return _err("http2_client: PRIORITY not supported") }
    var hb = first_fr["payload"]
    if (flags & h2.FLAG_END_HEADERS) != 0 {
        return {"ok": 1, "b": hb, "flags": flags, "stream": stream}
    }
    var hb_len = oren_buf_len(hb)
    if oren_is_err(hb_len) { return _err("http2_client: bad header block") }

    var fr = _read_frame(conn, timeout_ms)
    if fr["ok"] != 1 { return _err("http2_client: read CONTINUATION") }
    if fr["type"] != h2.FRAME_CONTINUATION { return _err("http2_client: expected CONTINUATION") }
    if fr["stream"] != stream { return _err("http2_client: CONTINUATION stream mismatch") }
    var fr_len = oren_buf_len(fr["payload"])
    if oren_is_err(fr_len) { return _err("http2_client: bad CONTINUATION payload") }
    if (fr["flags"] & h2.FLAG_END_HEADERS) != 0 {
        var exact_acc = _u8_acc_new_exact(hb_len + fr_len)
        if oren_is_err(exact_acc) { return _err("http2_client: alloc header block") }
        var exact_rc = _u8_acc_append(exact_acc, hb)
        if oren_is_err(exact_rc) { return _err("http2_client: append header block") }
        exact_rc = _u8_acc_append(exact_acc, fr["payload"])
        if oren_is_err(exact_rc) { return _err("http2_client: append header block") }
        hb = _u8_acc_finish(exact_acc)
        if oren_is_err(hb) { return _err("http2_client: finish header block") }
        return {"ok": 1, "b": hb, "flags": flags, "stream": stream}
    }

    var acc = _u8_acc_new(hb_len + fr_len + 64)
    if oren_is_err(acc) { return _err("http2_client: alloc header block") }
    var arc = _u8_acc_append(acc, hb)
    if oren_is_err(arc) { return _err("http2_client: append header block") }
    arc = _u8_acc_append(acc, fr["payload"])
    if oren_is_err(arc) { return _err("http2_client: append header block") }
    while true {
        fr = _read_frame(conn, timeout_ms)
        if fr["ok"] != 1 { return _err("http2_client: read CONTINUATION") }
        if fr["type"] != h2.FRAME_CONTINUATION { return _err("http2_client: expected CONTINUATION") }
        if fr["stream"] != stream { return _err("http2_client: CONTINUATION stream mismatch") }
        arc = _u8_acc_append(acc, fr["payload"])
        if oren_is_err(arc) { return _err("http2_client: append header block") }
        if (fr["flags"] & h2.FLAG_END_HEADERS) != 0 {
            hb = _u8_acc_finish(acc)
            if oren_is_err(hb) { return _err("http2_client: finish header block") }
            return {"ok": 1, "b": hb, "flags": flags, "stream": stream}
        }
    }
}

fn _send_headers_fragmented(conn, stream_id, headers_flags, header_block, split_at, max_frame_size, timeout_ms) {
    if header_block == nil { header_block = oren_u8_buf_new_uninit(0) }
    var n = oren_buf_len(header_block)
    if oren_is_err(n) { return 0 - 22 }
    if max_frame_size <= 0 { max_frame_size = 16384 }
    if max_frame_size > 16777215 { max_frame_size = 16777215 }
    if split_at < 0 { split_at = 0 }
    if split_at == 0 || split_at > max_frame_size { split_at = max_frame_size }
    if split_at >= n {
        return _send_frame(conn, h2.FRAME_HEADERS, headers_flags | h2.FLAG_END_HEADERS, stream_id, header_block, timeout_ms)
    }
    var p = native_buf_data_ptr(header_block)
    if p == 0 { return 0 - 22 }
    var rc = _send_frame_raw_payload(conn, h2.FRAME_HEADERS, headers_flags, stream_id, p, split_at, timeout_ms)
    if rc != 0 { return rc }
    var off = split_at
    while off < n {
        var take = n - off
        if take > max_frame_size { take = max_frame_size }
        var cflags = 0
        if off + take >= n { cflags = h2.FLAG_END_HEADERS }
        rc = _send_frame_raw_payload(conn, h2.FRAME_CONTINUATION, cflags, stream_id, p + off, take, timeout_ms)
        if rc != 0 { return rc }
        off = off + take
    }
    return 0
}

fn _new_record(conn, timeout_ms, opts) {
    // Returns {"ok":1,"c":Client} or {"ok":0,"err":...}
    if conn == 0 { return _err("http2_client.new: nil conn") }
    // NOTE: native backend currently treats `0 == nil`, so do not rely on `== nil`
    // checks for numeric arguments.
    if timeout_ms <= 0 { timeout_ms = 5000 }
    if opts == nil { opts = {} }

    var settings_pairs = oren_map_get_str(opts, "settings")
    if settings_pairs == nil { settings_pairs = [] }
    var payload = h2.settings_payload_from_list(settings_pairs)
    if oren_is_err(payload) { return _err("http2_client.new: bad settings") }

    // Send preface + SETTINGS.
    var wr0 = _write_all_str(conn, h2.CLIENT_PREFACE, h2.CLIENT_PREFACE_LEN, timeout_ms)
    if wr0 != 0 { return _err("http2_client.new: write preface") }
    wr0 = _send_frame(conn, h2.FRAME_SETTINGS, 0, 0, payload, timeout_ms)
    if wr0 != 0 { return _err("http2_client.new: write settings") }

    // Read server SETTINGS.
    var fr0 = _read_frame(conn, timeout_ms)
    if fr0["ok"] != 1 { return _err("http2_client.new: read server settings") }
    if fr0["type"] != h2.FRAME_SETTINGS || fr0["stream"] != 0 || fr0["flags"] != 0 { return _err("http2_client.new: bad server settings") }

    // Read server ACK for our SETTINGS.
    var fr1 = _read_frame(conn, timeout_ms)
    if fr1["ok"] != 1 { return _err("http2_client.new: read settings ack") }
    if fr1["type"] != h2.FRAME_SETTINGS || fr1["stream"] != 0 || fr1["flags"] != h2.FLAG_ACK { return _err("http2_client.new: bad settings ack") }
    if oren_buf_len(fr1["payload"]) != 0 { return _err("http2_client.new: settings ack must be empty") }

    // ACK server SETTINGS.
    wr0 = _send_frame(conn, h2.FRAME_SETTINGS, h2.FLAG_ACK, 0, oren_u8_buf_new(0), timeout_ms)
    if wr0 != 0 { return _err("http2_client.new: write server settings ack") }

    var c = {
        "conn": conn,
        "timeout_ms": timeout_ms,
        "enc_tbl": hpack.table_new(4096),
        "dec_tbl": hpack.table_new(4096),
        "next_stream": 1
    }
    return {"ok": 1, "c": Client(c)}
}

fn new(conn, timeout_ms, opts): Client {
    var r = _new_record(conn, timeout_ms, opts)
    if r["ok"] == 1 { return r["c"] }
    return _err_from_record(r, "http2_client.new failed")
}

fn _request_state(c, headers, body_bytes, opts) {
    // Minimal request/response:
    // - single stream
    // - HEADERS (+CONTINUATION) then optional DATA
    // - expects response HEADERS (+CONTINUATION) then DATA until END_STREAM
    if c == nil { return _err("http2_client.request: nil client") }
    var conn = oren_map_get_str(c, "conn")
    if conn == 0 { return _err("http2_client.request: nil conn") }
    var timeout_ms = oren_map_get_str(c, "timeout_ms")
    if timeout_ms <= 0 { timeout_ms = 5000 }
    if opts == nil { opts = {} }

    var split_at = oren_map_get_str(opts, "split_headers_at")
    if split_at < 0 { split_at = 0 }
    var max_header_frame_size = oren_map_get_str(opts, "max_header_frame_size")
    if max_header_frame_size <= 0 { max_header_frame_size = 16384 }

    // Allocate stream id.
    var sid = oren_map_get_str(c, "next_stream")
    if sid <= 0 { sid = 1 }
    oren_map_set_str(c, "next_stream", sid + 2)

    // Encode headers.
    var enc_tbl = oren_map_get_str(c, "enc_tbl")
    if enc_tbl == nil { enc_tbl = hpack.table_new(4096); oren_map_set_str(c, "enc_tbl", enc_tbl) }
    var hr = hpack.encode_header_block(enc_tbl, headers, {"huffman": 1})
    if hr["ok"] != 1 { return _err("http2_client.request: hpack encode") }
    var hb = hr["b"]

    var end_stream = 0
    var body_len = 0
    if body_bytes != nil {
        body_len = oren_buf_len(body_bytes)
        if oren_is_err(body_len) { return _err("http2_client.request: bad body") }
    }
    if body_bytes == nil || body_len == 0 { end_stream = 1 }

    var hflags = 0
    if end_stream != 0 { hflags = hflags | h2.FLAG_END_STREAM }
    var wr0 = _send_headers_fragmented(conn, sid, hflags, hb, split_at, max_header_frame_size, timeout_ms)
    if wr0 != 0 { return _err("http2_client.request: send HEADERS") }

    // Optional DATA.
    if end_stream == 0 {
        wr0 = _send_frame(conn, h2.FRAME_DATA, h2.FLAG_END_STREAM, sid, body_bytes, timeout_ms)
        if wr0 != 0 { return _err("http2_client.request: send DATA") }
    }

    // Read response HEADERS (ignore SETTINGS frames if they show up).
    var fr = nil
    while true {
        fr = _read_frame(conn, timeout_ms)
        if fr["ok"] != 1 { return _err("http2_client.request: read response") }
        if fr["type"] == h2.FRAME_SETTINGS {
            // Minimal policy: ignore (server can send additional settings); do not ACK here.
            // (Future: apply settings + ACK when required.)
            continue
        }
        break
    }
    if fr["type"] != h2.FRAME_HEADERS { return _err("http2_client.request: expected HEADERS") }
    if fr["stream"] != sid { return _err("http2_client.request: stream mismatch") }
    var hb2 = _read_header_block(conn, fr, timeout_ms)
    if hb2["ok"] != 1 { return _err("http2_client.request: read header block") }

    var dec_tbl = oren_map_get_str(c, "dec_tbl")
    if dec_tbl == nil { dec_tbl = hpack.table_new(4096); oren_map_set_str(c, "dec_tbl", dec_tbl) }
    var dr = hpack.decode_header_block(dec_tbl, hb2["b"])
    if dr["ok"] != 1 { return _err("http2_client.request: hpack decode") }
    var hs = dr["headers"]

    // Extract :status (first match).
    var status = 0
    var header_count = oren_list_len(hs)
    var i = 0
    while i < header_count {
        var h = hs[i]
        if h != nil && h["name"] != nil && h["value"] != nil && _str_eq_bytes(h["name"], ":status") == true {
            status = oren_int_from_string(h["value"])
            break
        }
        i = i + 1
    }
    var body_expected_len = _headers_content_length(hs)
    if body_expected_len < -1 { return _err("http2_client.request: bad content-length") }

    // Read DATA frames until END_STREAM on our stream. Header-only responses
    // terminate on the response HEADERS frame and do not require a DATA frame.
    if (hb2["flags"] & h2.FLAG_END_STREAM) != 0 {
        if body_expected_len > 0 { return _err("http2_client.request: content-length mismatch") }
        var empty_body = oren_u8_buf_new_uninit(0)
        if oren_is_err(empty_body) { return _err("http2_client.request: alloc empty body") }
        return {"ok": 1, "status": status, "headers": hs, "body": empty_body}
    }
    var body_acc = nil
    if body_expected_len >= 0 {
        body_acc = _u8_acc_new_exact(body_expected_len)
    } else {
        body_acc = _u8_acc_new(0)
    }
    if oren_is_err(body_acc) { return _err("http2_client.request: alloc body") }
    var body = nil
    while true {
        var frd = _read_frame(conn, timeout_ms)
        if frd["ok"] != 1 { return _err("http2_client.request: read DATA") }
        if frd["type"] == h2.FRAME_DATA && frd["stream"] == sid {
            if body_expected_len >= 0 {
                var pn = oren_buf_len(frd["payload"])
                if oren_is_err(pn) { return _err("http2_client.request: bad DATA payload") }
                if body_acc["len"] + pn > body_expected_len { return _err("http2_client.request: content-length overflow") }
            }
            var brc = _u8_acc_append(body_acc, frd["payload"])
            if oren_is_err(brc) { return _err("http2_client.request: append body") }
            if (frd["flags"] & h2.FLAG_END_STREAM) != 0 {
                if body_expected_len >= 0 && body_acc["len"] != body_expected_len { return _err("http2_client.request: content-length mismatch") }
                body = _u8_acc_finish(body_acc)
                if oren_is_err(body) { return _err("http2_client.request: finish body") }
                break
            }
            continue
        }
        // Ignore other frames for now.
    }

    return {"ok": 1, "status": status, "headers": hs, "body": body}
}

fn _request_value(c: Client, headers, body_bytes, opts): Response {
    var r = _request_state(c.state, headers, body_bytes, opts)
    if r["ok"] == 1 {
        return _wrap_response(r)
    }
    return _err_from_record(r, "http2_client.request failed")
}

fn status(resp: Response) { return resp.status }
fn headers(resp: Response) { return resp.headers }
fn bytes(resp: Response) { return resp.body }
fn text(resp: Response) { return buffer.u8_to_string(resp.body) }

impl Http2Client for Client {
    fn request(self, headers, body_bytes, opts): Response { return _request_value(self, headers, body_bytes, opts) }
    fn raw_state(self) { return self.state }
}

impl Http2ResponseBody for Response {
    fn bytes(self) { return self.body }
    fn text(self) { return buffer.u8_to_string(self.body) }
}
