// std/net/http2_client (rolling)
//
// Goal:
// - Provide a minimal HTTP/2 client layer on top of:
//   - `std:net/tls` (transport)
//   - `std:net/http2` (framing primitives)
//   - `std:net/hpack` (header compression)
//
// Non-goals (v0):
// - multiplexing multiple concurrent streams
// - full RFC 7540 stream state machine / flow control
// - server push
//
// This module is designed so Tier‑1 loopback tests can exercise real stdlib behavior
// without embedding framing logic in every test.

import tls "std:net/tls"
import h2 "std:net/http2"
import hpack "std:net/hpack"

fn _err(msg) { return {"ok": 0, "err": msg} }

fn _str_eq_bytes(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _read_exact(conn, buf, need, timeout_ms) {
    if need < 0 { return 0 - 22 }
    var off = 0
    while off < need {
        var n = tls.read_into(conn, buf + off, need - off, timeout_ms)
        if n < 0 { return n }
        if n == 0 { return 0 - 104 }
        off = off + n
    }
    return 0
}

fn _write_all_ptr(conn, ptr0, n, timeout_ms) {
    if n < 0 { return 0 - 22 }
    var off = 0
    while off < n {
        var w = tls.write_from(conn, ptr0 + off, n - off, timeout_ms)
        if w < 0 { return w }
        if w == 0 { return 0 - 104 }
        off = off + w
    }
    return 0
}

fn _write_all_str(conn, s, n, timeout_ms) {
    return _write_all_ptr(conn, s, n, timeout_ms)
}

fn _write_all_bytes(conn, b, timeout_ms) {
    if b == nil { return 0 }
    var n = oren_buf_len(b)
    if oren_is_err(n) { return 0 - 22 }
    if n == 0 { return 0 }
    var p = native_buf_data_ptr(b)
    if p == 0 { return 0 - 22 }
    return _write_all_ptr(conn, p, n, timeout_ms)
}

fn _u8_concat2(a, b) {
    if a == nil { a = oren_u8_buf_new_uninit(0) }
    if b == nil { b = oren_u8_buf_new_uninit(0) }
    var na = oren_buf_len(a)
    var nb = oren_buf_len(b)
    if oren_is_err(na) || oren_is_err(nb) { return oren_err(4, "http2_client: concat: bad buf") }
    var out = oren_u8_buf_new_uninit(na + nb)
    if oren_is_err(out) { return out }
    var p = native_buf_data_ptr(out)
    if p == 0 && (na + nb) > 0 { return oren_err(4, "http2_client: concat: nil ptr") }
    if na > 0 {
        var pa = native_buf_data_ptr(a)
        if pa == 0 { return oren_err(4, "http2_client: concat: nil pa") }
        var i = 0
        while i < na {
            ptr_set_byte(p + i, ptr_get_byte(pa + i) & 255)
            i = i + 1
        }
    }
    if nb > 0 {
        var pb = native_buf_data_ptr(b)
        if pb == 0 { return oren_err(4, "http2_client: concat: nil pb") }
        var j = 0
        while j < nb {
            ptr_set_byte(p + na + j, ptr_get_byte(pb + j) & 255)
            j = j + 1
        }
    }
    return out
}

fn _read_frame(conn, timeout_ms) {
    var hdr = malloc(16)
    if hdr == 0 { return _err("http2_client._read_frame: oom hdr") }
    var rr0 = _read_exact(conn, hdr, 9, timeout_ms)
    if rr0 != 0 { free(hdr); return _err("http2_client._read_frame: read header") }
    var fh = h2.parse_frame_header(hdr)
    free(hdr)
    if fh["ok"] != 1 { return _err("http2_client._read_frame: bad header") }
    var length = fh["len"]
    var payload = oren_u8_buf_new_uninit(length)
    if oren_is_err(payload) { return _err("http2_client._read_frame: oom payload") }
    if length > 0 {
        var p = native_buf_data_ptr(payload)
        if p == 0 { return _err("http2_client._read_frame: nil payload ptr") }
        rr0 = _read_exact(conn, p, length, timeout_ms)
        if rr0 != 0 { return _err("http2_client._read_frame: read payload") }
    }
    return {"ok": 1, "type": fh["type"], "flags": fh["flags"], "stream": fh["stream"], "payload": payload}
}

fn _send_frame(conn, typ, flags, stream_id, payload_bytes, timeout_ms) {
    if payload_bytes == nil { payload_bytes = oren_u8_buf_new(0) }
    var plen = oren_buf_len(payload_bytes)
    if oren_is_err(plen) { return 0 - 22 }
    var hdr = malloc(16)
    if hdr == 0 { return 0 - 12 }
    var rc0 = h2.write_frame_header(hdr, plen, typ, flags, stream_id)
    if rc0 != 0 { free(hdr); return rc0 }
    var wr0 = _write_all_ptr(conn, hdr, 9, timeout_ms)
    free(hdr)
    if wr0 != 0 { return wr0 }
    return _write_all_bytes(conn, payload_bytes, timeout_ms)
}

fn _read_header_block(conn, first_fr, timeout_ms) {
    if first_fr == nil { return _err("http2_client: nil frame") }
    if first_fr["type"] != h2.FRAME_HEADERS { return _err("http2_client: expected HEADERS") }
    var stream = first_fr["stream"]
    var flags = first_fr["flags"]
    if (flags & h2.FLAG_PADDED) != 0 { return _err("http2_client: PADDED not supported") }
    if (flags & h2.FLAG_PRIORITY) != 0 { return _err("http2_client: PRIORITY not supported") }
    var hb = first_fr["payload"]
    if (flags & h2.FLAG_END_HEADERS) != 0 {
        return {"ok": 1, "b": hb, "flags": flags, "stream": stream}
    }
    while true {
        var fr = _read_frame(conn, timeout_ms)
        if fr["ok"] != 1 { return _err("http2_client: read CONTINUATION") }
        if fr["type"] != h2.FRAME_CONTINUATION { return _err("http2_client: expected CONTINUATION") }
        if fr["stream"] != stream { return _err("http2_client: CONTINUATION stream mismatch") }
        hb = _u8_concat2(hb, fr["payload"])
        if oren_is_err(hb) { return _err("http2_client: concat header block") }
        if (fr["flags"] & h2.FLAG_END_HEADERS) != 0 {
            return {"ok": 1, "b": hb, "flags": flags, "stream": stream}
        }
    }
}

fn _send_headers_fragmented(conn, stream_id, headers_flags, header_block, split_at, timeout_ms) {
    if header_block == nil { header_block = oren_u8_buf_new_uninit(0) }
    var n = oren_buf_len(header_block)
    if oren_is_err(n) { return 0 - 22 }
    if split_at < 0 { split_at = 0 }
    if split_at == 0 || split_at >= n {
        return _send_frame(conn, h2.FRAME_HEADERS, headers_flags | h2.FLAG_END_HEADERS, stream_id, header_block, timeout_ms)
    }
    var p = native_buf_data_ptr(header_block)
    if p == 0 { return 0 - 22 }
    var b0 = oren_u8_buf_new_uninit(split_at)
    var b1 = oren_u8_buf_new_uninit(n - split_at)
    if oren_is_err(b0) || oren_is_err(b1) { return 0 - 12 }
    var p0 = native_buf_data_ptr(b0)
    var p1 = native_buf_data_ptr(b1)
    if p0 == 0 || p1 == 0 { return 0 - 12 }
    var i = 0
    while i < split_at {
        ptr_set_byte(p0 + i, ptr_get_byte(p + i) & 255)
        i = i + 1
    }
    var j = 0
    while j < (n - split_at) {
        ptr_set_byte(p1 + j, ptr_get_byte(p + split_at + j) & 255)
        j = j + 1
    }
    var rc = _send_frame(conn, h2.FRAME_HEADERS, headers_flags, stream_id, b0, timeout_ms)
    if rc != 0 { return rc }
    return _send_frame(conn, h2.FRAME_CONTINUATION, h2.FLAG_END_HEADERS, stream_id, b1, timeout_ms)
}

fn new(conn, timeout_ms, opts) {
    // Returns {"ok":1,"c":client} or {"ok":0,"err":...}
    if conn == 0 { return _err("http2_client.new: nil conn") }
    // NOTE: native backend currently treats `0 == nil`, so do not rely on `== nil`
    // checks for numeric arguments.
    if timeout_ms <= 0 { timeout_ms = 5000 }
    if opts == nil { opts = {} }

    var settings_pairs = oren_map_get_str(opts, "settings")
    if settings_pairs == nil { settings_pairs = [] }
    var payload = h2.settings_payload_from_list(settings_pairs)
    if oren_is_err(payload) { return _err("http2_client.new: bad settings") }

    // Send preface + SETTINGS.
    var wr0 = _write_all_str(conn, h2.CLIENT_PREFACE, h2.CLIENT_PREFACE_LEN, timeout_ms)
    if wr0 != 0 { return _err("http2_client.new: write preface") }
    wr0 = _send_frame(conn, h2.FRAME_SETTINGS, 0, 0, payload, timeout_ms)
    if wr0 != 0 { return _err("http2_client.new: write settings") }

    // Read server SETTINGS.
    var fr0 = _read_frame(conn, timeout_ms)
    if fr0["ok"] != 1 { return _err("http2_client.new: read server settings") }
    if fr0["type"] != h2.FRAME_SETTINGS || fr0["stream"] != 0 || fr0["flags"] != 0 { return _err("http2_client.new: bad server settings") }

    // Read server ACK for our SETTINGS.
    var fr1 = _read_frame(conn, timeout_ms)
    if fr1["ok"] != 1 { return _err("http2_client.new: read settings ack") }
    if fr1["type"] != h2.FRAME_SETTINGS || fr1["stream"] != 0 || fr1["flags"] != h2.FLAG_ACK { return _err("http2_client.new: bad settings ack") }
    if oren_buf_len(fr1["payload"]) != 0 { return _err("http2_client.new: settings ack must be empty") }

    // ACK server SETTINGS.
    wr0 = _send_frame(conn, h2.FRAME_SETTINGS, h2.FLAG_ACK, 0, oren_u8_buf_new(0), timeout_ms)
    if wr0 != 0 { return _err("http2_client.new: write server settings ack") }

    var c = {
        "conn": conn,
        "timeout_ms": timeout_ms,
        "enc_tbl": hpack.table_new(4096),
        "dec_tbl": hpack.table_new(4096),
        "next_stream": 1
    }
    return {"ok": 1, "c": c}
}

fn request(c, headers, body_bytes, opts) {
    // Minimal request/response:
    // - single stream
    // - HEADERS (+CONTINUATION) then optional DATA
    // - expects response HEADERS (+CONTINUATION) then DATA until END_STREAM
    if c == nil { return _err("http2_client.request: nil client") }
    var conn = oren_map_get_str(c, "conn")
    if conn == 0 { return _err("http2_client.request: nil conn") }
    var timeout_ms = oren_map_get_str(c, "timeout_ms")
    if timeout_ms <= 0 { timeout_ms = 5000 }
    if opts == nil { opts = {} }

    var split_at = oren_map_get_str(opts, "split_headers_at")
    if split_at < 0 { split_at = 0 }

    // Allocate stream id.
    var sid = oren_map_get_str(c, "next_stream")
    if sid <= 0 { sid = 1 }
    oren_map_set_str(c, "next_stream", sid + 2)

    // Encode headers.
    var enc_tbl = oren_map_get_str(c, "enc_tbl")
    if enc_tbl == nil { enc_tbl = hpack.table_new(4096); oren_map_set_str(c, "enc_tbl", enc_tbl) }
    var hr = hpack.encode_header_block(enc_tbl, headers, {"huffman": 1})
    if hr["ok"] != 1 { return _err("http2_client.request: hpack encode") }
    var hb = hr["b"]

    var end_stream = 0
    var body_len = 0
    if body_bytes != nil {
        body_len = oren_buf_len(body_bytes)
        if oren_is_err(body_len) { return _err("http2_client.request: bad body") }
    }
    if body_bytes == nil || body_len == 0 { end_stream = 1 }

    var hflags = 0
    if end_stream != 0 { hflags = hflags | h2.FLAG_END_STREAM }
    var wr0 = _send_headers_fragmented(conn, sid, hflags, hb, split_at, timeout_ms)
    if wr0 != 0 { return _err("http2_client.request: send HEADERS") }

    // Optional DATA.
    if end_stream == 0 {
        wr0 = _send_frame(conn, h2.FRAME_DATA, h2.FLAG_END_STREAM, sid, body_bytes, timeout_ms)
        if wr0 != 0 { return _err("http2_client.request: send DATA") }
    }

    // Read response HEADERS (ignore SETTINGS frames if they show up).
    var fr = nil
    while true {
        fr = _read_frame(conn, timeout_ms)
        if fr["ok"] != 1 { return _err("http2_client.request: read response") }
        if fr["type"] == h2.FRAME_SETTINGS {
            // Minimal policy: ignore (server can send additional settings); do not ACK here.
            // (Future: apply settings + ACK when required.)
            continue
        }
        break
    }
    if fr["type"] != h2.FRAME_HEADERS { return _err("http2_client.request: expected HEADERS") }
    if fr["stream"] != sid { return _err("http2_client.request: stream mismatch") }
    var hb2 = _read_header_block(conn, fr, timeout_ms)
    if hb2["ok"] != 1 { return _err("http2_client.request: read header block") }

    var dec_tbl = oren_map_get_str(c, "dec_tbl")
    if dec_tbl == nil { dec_tbl = hpack.table_new(4096); oren_map_set_str(c, "dec_tbl", dec_tbl) }
    var dr = hpack.decode_header_block(dec_tbl, hb2["b"])
    if dr["ok"] != 1 { return _err("http2_client.request: hpack decode") }
    var hs = dr["headers"]

    // Extract :status (first match).
    var status = 0
    var i = 0
    while i < oren_list_len(hs) {
        var h = hs[i]
        if h != nil && h["name"] != nil && h["value"] != nil && _str_eq_bytes(h["name"], ":status") == true {
            status = oren_int_from_string(h["value"])
            break
        }
        i = i + 1
    }

    // Read DATA frames until END_STREAM on our stream.
    var body = oren_u8_buf_new(0)
    while true {
        var frd = _read_frame(conn, timeout_ms)
        if frd["ok"] != 1 { return _err("http2_client.request: read DATA") }
        if frd["type"] == h2.FRAME_DATA && frd["stream"] == sid {
            body = _u8_concat2(body, frd["payload"])
            if oren_is_err(body) { return _err("http2_client.request: concat body") }
            if (frd["flags"] & h2.FLAG_END_STREAM) != 0 { break }
            continue
        }
        // Ignore other frames for now.
    }

    return {"ok": 1, "status": status, "headers": hs, "body": body}
}
