// std/net/tls (rolling v0)
//
// Goal:
// - Provide a minimal, syscall-first shaped TLS wrapper that can be used by:
//   - https:// in std:net/http
//   - wss:// in std:net/ws
// - Keep the API small and predictable (timeouts; explicit ownership).
//
// Status (2026-01-08, rolling):
// - macOS provider is the first bring-up target (SecureTransport via Security.framework).
// - Other Tier‑1 OS providers (Windows Schannel, Linux OpenSSL) are tracked in `docs/NET_TLS.md`.
//
// API (v0, rolling):
// - `wrap_client(fd, server_name, timeout_ms, opts)` -> {"ok":1,"conn":map} or {"ok":0,"err":string}
// - `wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts)` -> {"ok":1,"conn":map} or {"ok":0,"err":string}
// - `read_into(conn, buf, cap, timeout_ms)` -> n or -errno
// - `write_from(conn, ptr, len, timeout_ms)` -> n or -errno
// - `close(conn)` -> 0 or -errno
// - `peer_cert_sha256_hex(conn)` -> {"ok":1,"v":string} or {"ok":0,"err":string}
//
// Notes:
// - `conn` owns the underlying TCP fd; `tls.close(conn)` closes the socket.
// - This module is intentionally biased toward deterministic testability (loopback fixtures).

import tcp "std:net/tcp"
import hostutil "std:net/host"
import tls_linux "std:net/tls_linux_openssl"
import tls_win "std:net/tls_windows_schannel"
import tls_macos "std:net/tls_macos_securetransport"

fn connect(host_or_ip, port, timeout_ms, opts) {
    // Dial TCP + do a client TLS handshake.
    //
    // Inputs:
    // - host_or_ip: IPv4 literal (no DNS) or hostname (resolved via DNS A query)
    // - port: remote port
    // - timeout_ms: passed to DNS (default resolver) and connect/handshake
    // - opts: forwarded to wrap_client (supports `server_name`, `alpn`, pinning, etc.)
    //
    // DNS:
    // - If `opts["resolver"]` is provided, it is used as the DNS resolver config.
    // - Otherwise, `dns.default_resolver(timeout_ms)` is used internally.
    var resolver = 0
    if opts != nil && opts != 0 && oren_is_map(opts) == true {
        resolver = oren_map_get_str(opts, "resolver")
    }

    var rh = hostutil.resolve_host_ipv4("tls.connect", host_or_ip, timeout_ms, resolver)
    if rh["ok"] != 1 { return {"ok": 0, "err": rh["err"]} }
    var ip = rh["ip"]
    var owned_ip = rh["owned"]

    var fd = tcp.connect(ip, port, timeout_ms)
    if owned_ip == 1 { free(ip) }
    if fd < 0 {
        return {"ok": 0, "err": "tls.connect: connect failed (errno=" + oren_int_to_string(0 - fd) + ")"}
    }

    // Avoid sending IPv4 literals as SNI by default. For IP dials, callers can pass
    // `opts["server_name"]` to override SNI to a hostname (common for fixtures and proxies).
    var server_name = host_or_ip
    if hostutil.looks_like_ipv4(host_or_ip) == 1 { server_name = 0 }

    var cr = wrap_client(fd, server_name, timeout_ms, opts)
    if oren_map_get_str(cr, "ok") != 1 {
        // Best-effort: ensure fd isn't leaked on providers that don't close on failure.
        tcp.close(fd)
        return {"ok": 0, "err": "tls.connect: " + oren_map_get_str(cr, "err")}
    }
    return cr
}

fn _pin_peer_cert_if_requested(conn, opts) {
    // Centralized pinning hook for deterministic offline fixtures.
    //
    // If opts contains:
    //   - opts["pin_cert_sha256_hex"] = "<hex>"
    // then enforce that the peer leaf certificate hash matches.
    //
    // Returns {"ok":1} or {"ok":0,"err":string}.
    if opts == nil || opts == 0 { return {"ok": 1} }
    if oren_is_map(opts) != true { return {"ok": 1} }
    var want_pin = oren_map_get_str(opts, "pin_cert_sha256_hex")
    if want_pin == 0 { return {"ok": 1} }

    var pr = peer_cert_sha256_hex(conn)
    if oren_map_get_str(pr, "ok") != 1 {
        return {"ok": 0, "err": "tls pin: " + oren_map_get_str(pr, "err")}
    }
    var got_pin = oren_map_get_str(pr, "v")
    if got_pin == 0 || strcmp(got_pin, want_pin) != 0 {
        if got_pin != 0 { free(got_pin) }
        return {"ok": 0, "err": "tls pin mismatch"}
    }
    free(got_pin)
    return {"ok": 1}
}

// --- Default stub (Tier‑1 providers missing) ---

@cfg(not_os="macos,linux,windows")
fn wrap_client(fd, server_name, timeout_ms, opts) {
    if fd == nil { fd = -1 }
    if fd >= 0 { tcp.close(fd) }
    return {"ok": 0, "err": "tls.wrap_client: TLS provider not implemented for this OS yet (see docs/NET_TLS.md)"}
}

@cfg(not_os="macos,linux,windows")
fn wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts) {
    if fd == nil { fd = -1 }
    if fd >= 0 { tcp.close(fd) }
    return {"ok": 0, "err": "tls.wrap_server: TLS provider not implemented for this OS yet (see docs/NET_TLS.md)"}
}

@cfg(not_os="macos,linux,windows")
fn read_into(conn, buf, cap, timeout_ms) {
    return 0 - 38 // ENOSYS
}

@cfg(not_os="macos,linux,windows")
fn write_from(conn, ptr0, len, timeout_ms) {
    return 0 - 38 // ENOSYS
}

@cfg(not_os="macos,linux,windows")
fn close(conn) {
    return 0 - 38 // ENOSYS
}

@cfg(not_os="macos,linux,windows")
fn peer_cert_sha256_hex(conn) {
    return {"ok": 0, "err": "tls.peer_cert_sha256_hex: not implemented (see docs/NET_TLS.md)"}
}

// --- Provider dispatch (Tier‑1) ---
//
// Split provider implementations into separate modules to keep this facade file small and stable.
// This also keeps OS-specific FFI blocks isolated.

@cfg(os="linux")
fn wrap_client(fd, server_name, timeout_ms, opts) {
    var r = tls_linux.wrap_client(fd, server_name, timeout_ms, opts)
    if oren_map_get_str(r, "ok") != 1 { return r }
    var conn = oren_map_get_str(r, "conn")
    var pinr = _pin_peer_cert_if_requested(conn, opts)
    if pinr["ok"] != 1 {
        close(conn)
        return {"ok": 0, "err": pinr["err"]}
    }
    return r
}

@cfg(os="linux")
fn wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts) {
    return tls_linux.wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts)
}

@cfg(os="linux")
fn read_into(conn, buf, cap, timeout_ms) {
    return tls_linux.read_into(conn, buf, cap, timeout_ms)
}

@cfg(os="linux")
fn write_from(conn, ptr0, len, timeout_ms) {
    return tls_linux.write_from(conn, ptr0, len, timeout_ms)
}

@cfg(os="linux")
fn close(conn) {
    return tls_linux.close(conn)
}

@cfg(os="linux")
fn peer_cert_sha256_hex(conn) {
    return tls_linux.peer_cert_sha256_hex(conn)
}

