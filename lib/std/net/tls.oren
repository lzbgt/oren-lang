// std/net/tls (rolling v0)
//
// Goal:
// - Provide a minimal, syscall-first shaped TLS wrapper that can be used by:
//   - https:// in std:net/http
//   - wss:// in std:net/ws
// - Keep the API small and predictable (timeouts; explicit ownership).
//
// Status (2026-01-08, rolling):
// - macOS provider is the first bring-up target (SecureTransport via Security.framework).
// - Other Tier‑1 OS providers (Windows Schannel, Linux OpenSSL) are tracked in `docs/NET_TLS.md`.
//
// API (v0, rolling):
// - `wrap_client(fd, server_name, timeout_ms, opts)` -> {"ok":1,"conn":map} or {"ok":0,"err":string}
// - `wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts)` -> {"ok":1,"conn":map} or {"ok":0,"err":string}
// - `read_into(conn, buf, cap, timeout_ms)` -> n or -errno
// - `write_from(conn, ptr, len, timeout_ms)` -> n or -errno
// - `close(conn)` -> 0 or -errno
// - `peer_cert_sha256_hex(conn)` -> {"ok":1,"v":string} or {"ok":0,"err":string}
//
// Notes:
// - `conn` owns the underlying TCP fd; `tls.close(conn)` closes the socket.
// - This module is intentionally biased toward deterministic testability (loopback fixtures).

import tcp "std:net/tcp"
import sha256 "std:crypto/sha256"

fn _pin_peer_cert_if_requested(conn, opts) {
    // Centralized pinning hook for deterministic offline fixtures.
    //
    // If opts contains:
    //   - opts["pin_cert_sha256_hex"] = "<hex>"
    // then enforce that the peer leaf certificate hash matches.
    //
    // Returns {"ok":1} or {"ok":0,"err":string}.
    if opts == nil || opts == 0 { return {"ok": 1} }
    if oren_is_map(opts) != true { return {"ok": 1} }
    var want_pin = oren_map_get_str(opts, "pin_cert_sha256_hex")
    if want_pin == 0 { return {"ok": 1} }

    var pr = peer_cert_sha256_hex(conn)
    if oren_map_get_str(pr, "ok") != 1 {
        return {"ok": 0, "err": "tls pin: " + oren_map_get_str(pr, "err")}
    }
    var got_pin = oren_map_get_str(pr, "v")
    if got_pin == 0 || strcmp(got_pin, want_pin) != 0 {
        if got_pin != 0 { free(got_pin) }
        return {"ok": 0, "err": "tls pin mismatch"}
    }
    free(got_pin)
    return {"ok": 1}
}

