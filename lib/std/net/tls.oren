impl TlsConn for Conn {
    fn read_into(self, buf, cap, timeout_ms) { return read_into(self, buf, cap, timeout_ms) }
    fn write_from(self, ptr0, len, timeout_ms) { return write_from(self, ptr0, len, timeout_ms) }
    fn close(self) { return close(self) }
    fn peer_cert_sha256_hex(self) { return peer_cert_sha256_hex(self) }
    fn negotiated_alpn(self) { return negotiated_alpn(self) }
}
