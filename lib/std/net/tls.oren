// std/net/tls (rolling v0)
//
// Goal:
// - Provide a minimal, syscall-first shaped TLS wrapper that can be used by:
//   - https:// in std:net/http
//   - wss:// in std:net/ws
// - Keep the API small and predictable (timeouts; explicit ownership).
//
// Status (2026-01-08, rolling):
// - macOS provider is the first bring-up target (SecureTransport via Security.framework).
// - Other Tier‑1 OS providers (Windows Schannel, Linux OpenSSL) are tracked in `docs/DESIGN.md#tls-provider-availability`.
//
// API (v0, rolling):
// - `wrap_client(fd, server_name, timeout_ms, opts)` -> conn or `oren_err`
// - `wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts)` -> conn or `oren_err`
// - `connect(...)` -> conn or `oren_err`
// - `read_into(conn, buf, cap, timeout_ms)` -> n or `oren_err`
// - `write_from(conn, ptr, len, timeout_ms)` -> n or `oren_err`
// - `close(conn)` -> 0 or `oren_err`
// - Receiver methods (`conn.read_into(...)`, `conn.write_from(...)`,
//   `conn.close()`, etc.) -> value or `oren_err`
// - `win_cleanup()` -> 0 (no-op on non-Windows; releases cached Schannel creds on Windows)
// - `peer_cert_sha256_hex(conn)` / `negotiated_alpn(conn)` -> value or `oren_err`
// - Internal `*_raw` functions return syscall-style -errno values.
// - Internal `*_record` functions return legacy `{ok,...}` maps for protocol
//   composition that needs an envelope.
//
// Notes:
// - `conn` owns the underlying TCP fd; `tls.close(conn)` closes the socket.
// - This module is intentionally biased toward deterministic testability (loopback fixtures).

import tcp "std:net/tcp"
import hostutil "std:net/host"
import tls_linux "std:net/tls_linux_openssl"
import tls_win "std:net/tls_windows_schannel"
import tls_macos "std:net/tls_macos_securetransport"

struct Conn {
    fd,
    ssl,
    ctx,
    mode
}

trait TlsConn {
    fn read_into(self, buf, cap, timeout_ms);
    fn write_from(self, ptr0, len, timeout_ms);
    fn close(self);
    fn peer_cert_sha256_hex(self);
    fn negotiated_alpn(self);
}

fn _err_from_record(r, fallback) {
    var msg = r["err"]
    if msg == nil || msg == "" { msg = fallback }
    return oren_err(4, msg)
}

fn _err_from_errno(rc, fallback) {
    if rc >= 0 { return rc }
    return oren_err(0 - rc, fallback + " failed (errno=" + oren_int_to_string(0 - rc) + ")")
}

fn _connect_record(host_or_ip, port, timeout_ms, opts) {
    // Dial TCP + do a client TLS handshake.
    //
    // Inputs:
    // - host_or_ip: IPv4 literal (no DNS) or hostname (resolved via DNS A query)
    // - port: remote port
    // - timeout_ms: passed to DNS (default resolver) and connect/handshake
    // - opts: forwarded to wrap_client (supports `server_name`, `alpn`, pinning, etc.)
    //
    // DNS:
    // - If `opts["resolver"]` is provided, it is used as the DNS resolver config.
    // - Otherwise, `dns.default_resolver(timeout_ms)` is used internally.
    var resolver = 0
    if opts != nil && opts != 0 && oren_is_map(opts) == true {
        resolver = oren_map_get_str(opts, "resolver")
    }

    var rh = hostutil.resolve_host_ipv4("tls.connect", host_or_ip, timeout_ms, resolver)
    if rh["ok"] != 1 { return {"ok": 0, "err": rh["err"]} }
    var ip = rh["ip"]
    var owned_ip = rh["owned"]

    var fd = tcp.connect_raw(ip, port, timeout_ms)
    if owned_ip == 1 { free(ip) }
    if fd < 0 {
        return {"ok": 0, "err": "tls.connect: connect failed (errno=" + oren_int_to_string(0 - fd) + ")"}
    }

    // Avoid sending IPv4 literals as SNI by default. For IP dials, callers can pass
    // `opts["server_name"]` to override SNI to a hostname (common for fixtures and proxies).
    var server_name = host_or_ip
    if hostutil.looks_like_ipv4(host_or_ip) == 1 { server_name = 0 }

    var cr = _wrap_client_record(fd, server_name, timeout_ms, opts)
    if oren_map_get_str(cr, "ok") != 1 {
        // Best-effort: ensure fd isn't leaked on providers that don't close on failure.
        tcp.close_raw(fd)
        return {"ok": 0, "err": "tls.connect: " + oren_map_get_str(cr, "err")}
    }
    return cr
}

fn connect(host_or_ip, port, timeout_ms, opts): Conn {
    var r = _connect_record(host_or_ip, port, timeout_ms, opts)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "conn") }
    return _err_from_record(r, "tls.connect failed")
}

fn _pin_peer_cert_if_requested(conn, opts) {
    // Centralized pinning hook for deterministic offline fixtures.
    //
    // If opts contains:
    //   - opts["pin_cert_sha256_hex"] = "<hex>"
    // then enforce that the peer leaf certificate hash matches.
    //
    // Returns {"ok":1} or {"ok":0,"err":string}.
    if opts == nil || opts == 0 { return {"ok": 1} }
    if oren_is_map(opts) != true { return {"ok": 1} }
    var want_pin = oren_map_get_str(opts, "pin_cert_sha256_hex")
    if want_pin == 0 { return {"ok": 1} }

    var pr = _peer_cert_sha256_hex_record(conn)
    if oren_map_get_str(pr, "ok") != 1 {
        return {"ok": 0, "err": "tls pin: " + oren_map_get_str(pr, "err")}
    }
    var got_pin = oren_map_get_str(pr, "v")
    if got_pin == 0 || strcmp(got_pin, want_pin) != 0 {
        if got_pin != 0 { free(got_pin) }
        return {"ok": 0, "err": "tls pin mismatch"}
    }
    free(got_pin)
    return {"ok": 1}
}

// --- Provider lifecycle helpers (rolling) ---

@cfg(os="windows")
fn win_cleanup() {
    // Best-effort: allow test harnesses / long-running processes to release cached Schannel creds.
    return tls_win.win_cleanup()
}

@cfg(not_os="windows")
fn win_cleanup() {
    return 0
}

fn wrap_client(fd, server_name, timeout_ms, opts): Conn {
    var r = _wrap_client_record(fd, server_name, timeout_ms, opts)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "conn") }
    return _err_from_record(r, "tls.wrap_client failed")
}

fn wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts): Conn {
    var r = _wrap_server_pkcs12_record(fd, timeout_ms, pkcs12_bytes, passphrase, opts)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "conn") }
    return _err_from_record(r, "tls.wrap_server_pkcs12 failed")
}

fn read_into(conn, buf, cap, timeout_ms) {
    return _err_from_errno(read_into_raw(conn, buf, cap, timeout_ms), "tls.read_into")
}

fn write_from(conn, ptr0, len, timeout_ms) {
    return _err_from_errno(write_from_raw(conn, ptr0, len, timeout_ms), "tls.write_from")
}

fn close(conn) {
    return _err_from_errno(close_raw(conn), "tls.close")
}

fn peer_cert_sha256_hex(conn) {
    var r = _peer_cert_sha256_hex_record(conn)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "v") }
    return _err_from_record(r, "tls.peer_cert_sha256_hex failed")
}

fn negotiated_alpn(conn) {
    var r = _negotiated_alpn_record(conn)
    if oren_map_get_str(r, "ok") == 1 { return oren_map_get_str(r, "v") }
    return _err_from_record(r, "tls.negotiated_alpn failed")
}

// --- Default stub (Tier‑1 providers missing) ---

@cfg(not_os="macos,linux,windows")
fn _wrap_client_record(fd, server_name, timeout_ms, opts) {
    if fd == nil { fd = -1 }
    if fd >= 0 { tcp.close_raw(fd) }
    return {"ok": 0, "err": "tls.wrap_client: TLS provider not implemented for this OS yet (see docs/DESIGN.md#tls-provider-availability)"}
}

@cfg(not_os="macos,linux,windows")
fn _wrap_server_pkcs12_record(fd, timeout_ms, pkcs12_bytes, passphrase, opts) {
    if fd == nil { fd = -1 }
    if fd >= 0 { tcp.close_raw(fd) }
    return {"ok": 0, "err": "tls.wrap_server: TLS provider not implemented for this OS yet (see docs/DESIGN.md#tls-provider-availability)"}
}

@cfg(not_os="macos,linux,windows")
fn read_into_raw(conn, buf, cap, timeout_ms) {
    return 0 - 38 // ENOSYS
}

@cfg(not_os="macos,linux,windows")
fn write_from_raw(conn, ptr0, len, timeout_ms) {
    return 0 - 38 // ENOSYS
}

@cfg(not_os="macos,linux,windows")
fn close_raw(conn) {
    return 0 - 38 // ENOSYS
}

@cfg(not_os="macos,linux,windows")
fn _peer_cert_sha256_hex_record(conn) {
    return {"ok": 0, "err": "tls.peer_cert_sha256_hex: not implemented (see docs/DESIGN.md#tls-provider-availability)"}
}

@cfg(not_os="macos,linux,windows")
fn _negotiated_alpn_record(conn) {
    return {"ok": 0, "err": "tls.negotiated_alpn: not implemented (see docs/DESIGN.md#tls-provider-availability)"}
}

// --- Provider dispatch (Tier‑1) ---
//
// Split provider implementations into separate modules to keep this facade file small and stable.
// This also keeps OS-specific FFI blocks isolated.

@cfg(os="linux")
fn _wrap_client_record(fd, server_name, timeout_ms, opts) {
    var r = tls_linux.wrap_client(fd, server_name, timeout_ms, opts)
    if oren_map_get_str(r, "ok") != 1 { return r }
    var conn = oren_map_get_str(r, "conn")
    var pinr = _pin_peer_cert_if_requested(conn, opts)
    if pinr["ok"] != 1 {
        close_raw(conn)
        return {"ok": 0, "err": pinr["err"]}
    }
    return r
}

@cfg(os="linux")
fn _wrap_server_pkcs12_record(fd, timeout_ms, pkcs12_bytes, passphrase, opts) {
    return tls_linux.wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts)
}

@cfg(os="linux")
fn read_into_raw(conn, buf, cap, timeout_ms) {
    return tls_linux.read_into(conn, buf, cap, timeout_ms)
}

@cfg(os="linux")
fn write_from_raw(conn, ptr0, len, timeout_ms) {
    return tls_linux.write_from(conn, ptr0, len, timeout_ms)
}

@cfg(os="linux")
fn close_raw(conn) {
    return tls_linux.close(conn)
}

@cfg(os="linux")
fn _peer_cert_sha256_hex_record(conn) {
    return tls_linux.peer_cert_sha256_hex(conn)
}

@cfg(os="linux")
fn _negotiated_alpn_record(conn) {
    return tls_linux.negotiated_alpn(conn)
}

