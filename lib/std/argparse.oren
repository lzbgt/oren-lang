// Minimal, modern argument parser for Oren tools.
//
// Goals:
// - deterministic help text (stable ordering)
// - supports: long/short flags, --opt value, --opt=value, bool flags
// - supports: -abc (chained short flags), -ovalue (short value), -o=value
// - supports: subcommands + positionals
// - supports: global options before subcommand (click-style)
// - supports: interspersed options/args (options after positionals)
// - returns structured results (no implicit global state)
//
// This is intentionally small: evolve it as Oren's own tooling grows.

import list "std:list"

fn _lower_ascii(s) {
    if s == nil { return "" }
    var n = oren_string_len(s)
    var out = oren_u8_buf_new_uninit(n)
    if oren_is_err(out) { return out }
    var data = oren_buf_data_ptr_unchecked(out)
    var i = 0
    while i < n {
        var b = oren_string_byte_at_unchecked(s, i) & 255
        if b >= 65 && b <= 90 { b = b + 32 }
        ptr_set_byte(data + i, b)
        i = i + 1
    }
    return oren_string_from_bytes_slice(out, 0, n)
}

fn _trim_spaces(s) {
    if s == nil { return "" }
    var n = oren_string_len(s)
    var i = 0
    while i < n && oren_string_char_at(s, i) == " " { i = i + 1 }
    var j = n
    while j > i && oren_string_char_at(s, j - 1) == " " { j = j - 1 }
    return oren_string_slice(s, i, j)
}

fn _split_csv_simple(s) {
    // Minimal CSV splitting: comma-separated, no quoting.
    // Trims spaces around elements and drops empty segments.
    var out = []
    if s == nil { return out }
    var n = oren_string_len(s)
    var i = 0
    var start = 0
    while i < n {
        if oren_string_char_at(s, i) == "," {
            var seg = _trim_spaces(oren_string_slice(s, start, i))
            if _streq(seg, "") != true { list.push(out, seg) }
            start = i + 1
        }
        i = i + 1
    }
    var last = _trim_spaces(oren_string_slice(s, start, n))
    if _streq(last, "") != true { list.push(out, last) }
    return out
}

fn _parse_bool_env(v) {
    // Env semantics:
    // - if env var is present but empty => true (compat with "presence means on")
    // - accepts: 1/0, true/false, yes/no, on/off (case-insensitive)
    if v == nil { return nil }
    if _streq(v, "") { return true }
    var x = _lower_ascii(_trim_spaces(v))
    if _streq(x, "1") || _streq(x, "true") || _streq(x, "yes") || _streq(x, "on") { return true }
    if _streq(x, "0") || _streq(x, "false") || _streq(x, "no") || _streq(x, "off") { return false }
    // Unknown token => treat as true for backward compatibility (env presence means enabled).
    return true
}

fn _starts_with(s, pref) {
    if s == nil || pref == nil { return false }
    var sl = oren_string_len(s)
    var pl = oren_string_len(pref)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if oren_string_char_at(s, i) != oren_string_char_at(pref, i) { return false }
        i = i + 1
    }
    return true
}

fn _streq(a, b) {
    if a == nil || b == nil { return false }
    var al = oren_string_len(a)
    var bl = oren_string_len(b)
    if al != bl { return false }
    var i = 0
    while i < al {
        if oren_string_char_at(a, i) != oren_string_char_at(b, i) { return false }
        i = i + 1
    }
    return true
}

fn _contains(s, ch) {
    if s == nil || ch == nil { return false }
    if oren_string_len(ch) != 1 { return false }
    var target = oren_string_char_at(ch, 0)
    var i = 0
    var n = oren_string_len(s)
    while i < n {
        if oren_string_char_at(s, i) == target { return true }
        i = i + 1
    }
    return false
}

fn _split_once(s, sep) {
    // Returns [left, right] or [s, nil] if sep not found.
    var i = 0
    var n = oren_string_len(s)
    while i < n {
        if _streq(oren_string_slice(s, i, i + 1), sep) {
            return [oren_string_slice(s, 0, i), oren_string_slice(s, i + 1, n)]
        }
        i = i + 1
    }
    return [s, nil]
}

fn _to_int(s) {
    // v1: accept base-10, optional leading '-'.
    if s == nil || _streq(s, "") { return nil }
    var len = oren_string_len(s)
    var i = 0
    var sign = 1
    if len > 0 && _streq(oren_string_slice(s, 0, 1), "-") {
        sign = -1
        i = 1
        if i >= len { return nil }
    }
    var n = 0
    while i < len {
        var c = oren_string_slice(s, i, i + 1)
        var d = -1
        if _streq(c, "0") { d = 0 }
        else {
            if _streq(c, "1") { d = 1 }
            else {
                if _streq(c, "2") { d = 2 }
                else {
                    if _streq(c, "3") { d = 3 }
                    else {
                        if _streq(c, "4") { d = 4 }
                        else {
                            if _streq(c, "5") { d = 5 }
                            else {
                                if _streq(c, "6") { d = 6 }
                                else {
                                    if _streq(c, "7") { d = 7 }
                                    else {
                                        if _streq(c, "8") { d = 8 }
                                        else {
                                            if _streq(c, "9") { d = 9 }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if d < 0 { return nil }
        n = n * 10 + d
        i = i + 1
    }
    return n * sign
}

fn _normalize_key(name) {
    // Normalize option storage keys:
    // - "--backend" => "backend"
    // - "-o" => "o"
    // - "---weird" => "weird"
    if name == nil { return "" }
    var n = oren_string_len(name)
    if n == 0 { return "" }
    var i = 0
    while i < n {
        if !_streq(oren_string_char_at(name, i), "-") { break }
        i = i + 1
    }
    if i == 0 { return name }
    if i >= n { return "" }
    return oren_string_slice(name, i, n)
}

fn _opt_env(opt) {
    // Option spec tail field (rolling):
    // [kind, long, short, help, default, required, multiple, env]
    if opt != nil && list.len(opt) >= 8 { return opt[7] }
    return nil
}

fn new_parser(name, desc) {
    var p = {
        "name": name,
        "desc": desc,
        "root": new_command("", ""), // for CLIs without subcommands
        "commands": [],
        "settings": {
            // Click-style defaults:
            // - allow global options before subcommand
            // - allow options after positionals (interspersed)
            "allow_opts_before_cmd": true,
            "allow_interspersed_args": true,
        },
    }
    // Always provide help on root as well.
    cmd_flag(p["root"], "--help", "-h", "Show help and exit")
    return p
}

fn set_allow_opts_before_cmd(p, v) {
    if p == nil { return nil }
    if p["settings"] == nil { p["settings"] = {} }
    p["settings"]["allow_opts_before_cmd"] = v
    return nil
}

fn set_allow_interspersed_args(p, v) {
    if p == nil { return nil }
    if p["settings"] == nil { p["settings"] = {} }
    p["settings"]["allow_interspersed_args"] = v
    return nil
}

fn new_command(name, desc) {
    return {
        "name": name,
        "desc": desc,
        "options": [],     // list of option specs (stable order)
        "positionals": [], // list of positional specs (stable order)
    }
}

fn root(p) { return p["root"] }

fn add_command(p, name, desc) {
    var c = new_command(name, desc)
    // Per-command help
    cmd_flag(c, "--help", "-h", "Show help for this command and exit")
    list.push(p["commands"], c)
    return c
}

fn cmd_flag(cmd, long_name, short_name, help) {
    // Option spec is a list to avoid map-key lookup pitfalls in early runtimes:
    // [kind, long, short, help, default, required, multiple]
    var opt = [1, long_name, short_name, help, false, false, false]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_flag_env(cmd, long_name, short_name, help, env_name) {
    var opt = [1, long_name, short_name, help, false, false, false, env_name]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_flag_count(cmd, long_name, short_name, help) {
    // Counted flag (like `-v -vv -vvv`).
    //
    // Storage: integer count, default 0. Each occurrence increments by 1.
    // [kind, long, short, help, default, required, multiple]
    //
    // kind=4 => counted flag
    var opt = [4, long_name, short_name, help, 0, false, false]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_flag_count_env(cmd, long_name, short_name, help, env_name) {
    var opt = [4, long_name, short_name, help, 0, false, false, env_name]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_option(cmd, long_name, short_name, kind, default_value, help) {
    // kind: "string" | "int"
    var kind_code = 0
    if _streq(kind, "string") { kind_code = 2 }
    if _streq(kind, "int") { kind_code = 3 }
    if kind_code == 0 { kind_code = 2 }
    // [kind, long, short, help, default, required, multiple]
    var opt = [kind_code, long_name, short_name, help, default_value, false, false]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_option_env(cmd, long_name, short_name, kind, default_value, help, env_name) {
    var kind_code = 0
    if _streq(kind, "string") { kind_code = 2 }
    if _streq(kind, "int") { kind_code = 3 }
    if kind_code == 0 { kind_code = 2 }
    var opt = [kind_code, long_name, short_name, help, default_value, false, false, env_name]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_option_required(cmd, long_name, short_name, kind, help) {
    // Required option (must be present in argv).
    //
    // kind: "string" | "int"
    var kind_code = 0
    if _streq(kind, "string") { kind_code = 2 }
    if _streq(kind, "int") { kind_code = 3 }
    if kind_code == 0 { kind_code = 2 }
    // default is nil; required flag is true.
    var opt = [kind_code, long_name, short_name, help, nil, true, false]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_option_required_env(cmd, long_name, short_name, kind, help, env_name) {
    var kind_code = 0
    if _streq(kind, "string") { kind_code = 2 }
    if _streq(kind, "int") { kind_code = 3 }
    if kind_code == 0 { kind_code = 2 }
    var opt = [kind_code, long_name, short_name, help, nil, true, false, env_name]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_option_multi(cmd, long_name, short_name, kind, help) {
    // Repeatable option; collects values into a list.
    // Default is [].
    var kind_code = 0
    if _streq(kind, "string") { kind_code = 2 }
    if _streq(kind, "int") { kind_code = 3 }
    if kind_code == 0 { kind_code = 2 }
    var opt = [kind_code, long_name, short_name, help, [], false, true]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_option_multi_env(cmd, long_name, short_name, kind, help, env_name) {
    var kind_code = 0
    if _streq(kind, "string") { kind_code = 2 }
    if _streq(kind, "int") { kind_code = 3 }
    if kind_code == 0 { kind_code = 2 }
    var opt = [kind_code, long_name, short_name, help, [], false, true, env_name]
    list.push(cmd["options"], opt)
    return nil
}

fn cmd_positional(cmd, name, required, help) {
    // Positional spec: [name, required, help]
    var pos = [name, required, help]
    list.push(cmd["positionals"], pos)
    return nil
}

fn _find_cmd(p, name) {
    for c in p["commands"] {
        if _streq(c["name"], name) { return c }
    }
    return nil
}

fn _find_opt(cmd, tok) {
    // tok is a flag token: "--foo" or "-f"
    for o in cmd["options"] {
        var ln = o[1]
        if _streq(ln, tok) { return o }
        var sh = o[2]
        if sh != nil && _streq(sh, tok) { return o }
    }
    return nil
}

fn _abs_int(x) {
    if x < 0 { return -x }
    return x
}

fn _min2(a, b) {
    if a < b { return a }
    return b
}

fn _min3(a, b, c) {
    return _min2(_min2(a, b), c)
}

fn _edit_distance_limited(a, b, maxd) {
    // Levenshtein distance with an optional cutoff (maxd).
    // Returns maxd+1 when distance is definitely > maxd.
    //
    // NOTE (native backend parity):
    // Do not use `maxd == nil` as "no cutoff" because `nil` can alias `0` in some value paths.
    // Use a negative maxd to disable the cutoff.
    if a == nil { a = "" }
    if b == nil { b = "" }
    var al = oren_string_len(a)
    var bl = oren_string_len(b)
    if al == 0 { return bl }
    if bl == 0 { return al }
    var use_cutoff = maxd >= 0
    if use_cutoff && _abs_int(al - bl) > maxd { return maxd + 1 }

    // prev row: 0..bl
    var prev = []
    var j = 0
    while j <= bl {
        list.push(prev, j)
        j = j + 1
    }

    var i = 1
    while i <= al {
        var cur = [i]
        var min_row = i
        j = 1
        while j <= bl {
            var cost = 0
            if oren_string_char_at(a, i - 1) != oren_string_char_at(b, j - 1) { cost = 1 }
            var del = prev[j] + 1
            var ins = cur[j - 1] + 1
            var sub = prev[j - 1] + cost
            var v = _min3(del, ins, sub)
            list.push(cur, v)
            if v < min_row { min_row = v }
            j = j + 1
        }
        if use_cutoff && min_row > maxd { return maxd + 1 }
        prev = cur
        i = i + 1
    }
    return prev[bl]
}

fn _suggest_option(cmd, tok) {
    // Suggest the closest long option in cmd for a token like "--bakend".
    // Returns e.g. "--backend" or nil.
    if cmd == nil || tok == nil { return nil }
    if !_starts_with(tok, "--") { return nil }
    var want = _normalize_key(tok)
    if _streq(want, "") { return nil }

    var best = nil
    var bestd = 999
    var oi = 0
    var opts = cmd["options"]
    var opts_len = list.len(opts)
    while oi < opts_len {
        var o = opts[oi]
        var ln = o[1]
        if ln != nil && _starts_with(ln, "--") {
            var cand = _normalize_key(ln)
            var d = _edit_distance_limited(want, cand, 3)
            if d < bestd {
                bestd = d
                best = ln
            }
        }
        oi = oi + 1
    }
    if best != nil && bestd <= 3 { return best }
    return nil
}

fn _suggest_command(p, name) {
    // Suggest the closest command name.
    if p == nil || name == nil { return nil }
    if p["commands"] == nil { return nil }
    var want = name
    if _streq(want, "") { return nil }

    var best = nil
    var bestd = 999
    var ci = 0
    var commands = p["commands"]
    var commands_len = list.len(commands)
    while ci < commands_len {
        var c = commands[ci]
        var cn = c["name"]
        if cn != nil && !_streq(cn, "") {
            var d = _edit_distance_limited(want, cn, 3)
            if d < bestd {
                bestd = d
                best = cn
            }
        }
        ci = ci + 1
    }
    if best != nil && bestd <= 3 { return best }
    return nil
}

fn _opts_defaults(cmd) {
    var m = {}
    var dbg_ap = oren_env("OREN_DEBUG_ARGPARSE")
    if dbg_ap != nil { print("DEBUG_ARGPARSE opts_defaults enter") }
    var skip_opts = oren_env("OREN_DEBUG_ARGPARSE_SKIP_OPTS")
    if skip_opts != nil && !_streq(skip_opts, "") {
        if dbg_ap != nil { print("DEBUG_ARGPARSE opts_defaults skip") }
        return m
    }
    var dbg_opt_trace = nil
    if dbg_ap != nil { dbg_opt_trace = oren_env("OREN_DEBUG_ARGPARSE_OPT_TRACE") }
    if cmd == nil { return m }
    if dbg_ap != nil { print("DEBUG_ARGPARSE opts_defaults cmd_tag=" + oren_int_to_string(oren_type_tag(cmd))) }
    if oren_type_tag(cmd) != 7 { return m }
    var opts = cmd["options"]
    if dbg_ap != nil { print("DEBUG_ARGPARSE opts_defaults opts_tag=" + oren_int_to_string(oren_type_tag(opts))) }
    if opts == nil || oren_type_tag(opts) != 6 { return m }
    var oi = 0
    var on = list.len(opts)
    if dbg_ap != nil { print("DEBUG_ARGPARSE opts_defaults opts_len=" + oren_int_to_string(on)) }
    while oi < on {
        var o = opts[oi]
        if o == nil || oren_type_tag(o) != 6 || list.len(o) < 5 { oi = oi + 1; continue }
        if dbg_opt_trace != nil && !_streq(dbg_opt_trace, "") {
            print("DEBUG_ARGPARSE opts_defaults opt_i=" + oren_int_to_string(oi))
        }
        var key_src = o[1]
        if dbg_opt_trace != nil && !_streq(dbg_opt_trace, "") {
            print("DEBUG_ARGPARSE opts_defaults opt_i=" + oren_int_to_string(oi) + " key_tag=" + oren_int_to_string(oren_type_tag(key_src)))
        }
        if key_src == nil || oren_type_tag(key_src) != 4 { oi = oi + 1; continue }
        var key = _normalize_key(key_src)
        if dbg_opt_trace != nil && !_streq(dbg_opt_trace, "") {
            print("DEBUG_ARGPARSE opts_defaults opt_i=" + oren_int_to_string(oi) + " norm_ok")
        }
        var defv = o[4]
        // If marked repeatable, ensure default is a list.
        var multiple = false
        if list.len(o) >= 7 { multiple = o[6] }
        if multiple {
            defv = []
        }
        // Env default injection (rolling):
        // CLI precedence remains: explicit argv options override defaults, and env-based defaults do
        // NOT mark res["seen"] (seen only reflects argv).
        var env_name = _opt_env(o)
        if env_name != nil && !_streq(env_name, "") {
            var ev = oren_env(env_name)
            if ev != nil {
                var kind = o[0]
                if multiple {
                    // CSV for repeatable options (minimal, deterministic).
                    defv = _split_csv_simple(ev)
                } else {
                    if kind == 1 {
                        defv = _parse_bool_env(ev)
                    } else {
                        if kind == 4 {
                            var nn = _to_int(ev)
                            if nn != nil { defv = nn }
                        } else {
                            if kind == 3 {
                                var n2 = _to_int(ev)
                                if n2 != nil { defv = n2 }
                            } else {
                                // string
                                defv = ev
                            }
                        }
                    }
                }
            }
        }
        // Options are always normalized string keys.
        oren_map_set_str(m, key, defv)
        oi = oi + 1
    }
    return m
}

fn _opts_required_keys(cmd) {
    var out = []
    for o in cmd["options"] {
        var req = false
        if list.len(o) >= 6 { req = o[5] }
        if req {
            list.push(out, _normalize_key(o[1]))
        }
    }
    return out
}

fn _render_command_usage_line(p, cmd) {
    var name = p["name"]
    if cmd != nil && !_streq(cmd["name"], "") { name = name + " " + cmd["name"] }
    var s = name
    if cmd != nil {
        if list.len(cmd["options"]) > 0 { s = s + " [options]" }
        var pi = 0
        var positionals = cmd["positionals"]
        var positionals_len = list.len(positionals)
        while pi < positionals_len {
            var pos = positionals[pi]
            if pos[1] { s = s + " <" + pos[0] + ">" }
            else { s = s + " [" + pos[0] + "]" }
            pi = pi + 1
        }
    }
    return s
}

fn render_help_lines(p, cmd_name) {
    // Returns list of lines (without trailing newlines).
    var cmd = nil
    if cmd_name != nil && !_streq(cmd_name, "") {
        cmd = _find_cmd(p, cmd_name)
        if cmd == nil { cmd = p["root"] }
    } else {
        cmd = p["root"]
    }

    var lines = []
    if p["desc"] != nil && !_streq(p["desc"], "") {
        list.push(lines, p["desc"])
        list.push(lines, "")
    }

    list.push(lines, "Usage:")
    list.push(lines, "  " + _render_command_usage_line(p, cmd))
    list.push(lines, "")

    if cmd == p["root"] && list.len(p["commands"]) > 0 {
        list.push(lines, "Commands:")
        for c in p["commands"] {
            var line = "  " + c["name"]
            if c["desc"] != nil && !_streq(c["desc"], "") {
                line = line + "    " + c["desc"]
            }
            list.push(lines, line)
        }
        list.push(lines, "")
    }

    if cmd != nil && list.len(cmd["options"]) > 0 {
        list.push(lines, "Options:")
        for o in cmd["options"] {
            var kind = o[0]
            var line2 = "  " + o[1]
            if o[2] != nil && !_streq(o[2], "") { line2 = line2 + ", " + o[2] }
            if kind == 2 { line2 = line2 + " <str>" }
            if kind == 3 { line2 = line2 + " <int>" }
            if o[3] != nil && !_streq(o[3], "") { line2 = line2 + "    " + o[3] }
            var envn = _opt_env(o)
            if envn != nil && !_streq(envn, "") { line2 = line2 + " (env: " + envn + ")" }
            list.push(lines, line2)
        }
        list.push(lines, "")
    }

    if cmd != nil && list.len(cmd["positionals"]) > 0 {
        list.push(lines, "Args:")
        for pos in cmd["positionals"] {
            var line3 = "  " + pos[0]
            if pos[1] { line3 = line3 + " (required)" } else { line3 = line3 + " (optional)" }
            if pos[2] != nil && !_streq(pos[2], "") { line3 = line3 + "    " + pos[2] }
            list.push(lines, line3)
        }
        list.push(lines, "")
    }

    return lines
}

fn render_help(p, cmd_name) {
    var lines = render_help_lines(p, cmd_name)
    var out = ""
    for line in lines { out = out + line + "\n" }
    return out
}

fn _json_escape(s) {
    if s == nil { return "" }
    var out = ""
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        var c = oren_string_char_at(s, i)
        if _streq(c, "\\") { out = out + "\\\\"; i = i + 1; continue }
        if _streq(c, "\"") { out = out + "\\\""; i = i + 1; continue }
        if _streq(c, "\n") { out = out + "\\n"; i = i + 1; continue }
        if _streq(c, "\r") { out = out + "\\r"; i = i + 1; continue }
        if _streq(c, "\t") { out = out + "\\t"; i = i + 1; continue }
        out = out + c
        i = i + 1
    }
    return out
}

fn _json_str(s) { return "\"" + _json_escape(s) + "\"" }

fn render_help_json(p, cmd_name) {
    // Machine-readable help for tooling: stable ordering, no implicit global state.
    //
    // Schema (rolling):
    // {
    //   "name": "<prog>",
    //   "desc": "<desc>",
    //   "cmd": "<cmd|''>",
    //   "usage": "<usage line>",
    //   "commands": [{"name":"...", "desc":"..."}],
    //   "options": [{"kind":"flag|count|string|int", "long":"--x", "short":"-x", "help":"...", "default":..., "required":bool, "multiple":bool}],
    //   "positionals": [{"name":"file", "required":bool, "help":"..."}]
    // }
    var cmd = nil
    if cmd_name != nil && !_streq(cmd_name, "") {
        cmd = _find_cmd(p, cmd_name)
        if cmd == nil { cmd = p["root"] }
    } else {
        cmd = p["root"]
        cmd_name = ""
    }

    var out = "{"
    out = out + "\"name\":" + _json_str(p["name"]) + ","
    out = out + "\"desc\":" + _json_str(p["desc"]) + ","
    out = out + "\"cmd\":" + _json_str(cmd_name) + ","
    out = out + "\"usage\":" + _json_str(_render_command_usage_line(p, cmd)) + ","

    // Commands list only at root.
    out = out + "\"commands\":["
    if cmd == p["root"] && p["commands"] != nil {
        var ci = 0
        var commands = p["commands"]
        var commands_len = list.len(commands)
        while ci < commands_len {
            var c = commands[ci]
            if ci != 0 { out = out + "," }
            out = out + "{"
            out = out + "\"name\":" + _json_str(c["name"]) + ","
            out = out + "\"desc\":" + _json_str(c["desc"])
            out = out + "}"
            ci = ci + 1
        }
    }
    out = out + "],"

    // Options (stable order).
    out = out + "\"options\":["
    if cmd != nil && cmd["options"] != nil {
        var oi = 0
        var opts = cmd["options"]
        var opts_len = list.len(opts)
        while oi < opts_len {
            var o = opts[oi]
            if oi != 0 { out = out + "," }
            var kind = o[0]
            var kind_s = "flag"
            if kind == 2 { kind_s = "string" }
            if kind == 3 { kind_s = "int" }
            if kind == 4 { kind_s = "count" }
            var req = false
            var multiple = false
            if list.len(o) >= 6 { req = o[5] }
            if list.len(o) >= 7 { multiple = o[6] }

            out = out + "{"
            out = out + "\"kind\":" + _json_str(kind_s) + ","
            out = out + "\"long\":" + _json_str(o[1]) + ","
            out = out + "\"short\":" + _json_str(o[2]) + ","
            out = out + "\"help\":" + _json_str(o[3]) + ","
            // Optional env binding.
            var envn = _opt_env(o)
            if envn == nil { envn = "" }
            out = out + "\"env\":" + _json_str(envn) + ","

            // Default value (kept simple and deterministic):
            // - flags: true/false/null
            // - int/count: number or null
            // - string: string or null
            // - multiple: [] (even when default is nil)
            out = out + "\"default\":"
            if multiple {
                out = out + "[]"
            } else {
                var defv = o[4]
                if defv == nil {
                    out = out + "null"
                } else {
                    if kind == 1 {
                        if defv == true { out = out + "true" }
                        else {
                            if defv == false { out = out + "false" }
                            else { out = out + "null" }
                        }
                    } else {
                        if kind == 3 || kind == 4 {
                            out = out + oren_int_to_string(defv)
                        } else {
                            out = out + _json_str(defv)
                        }
                    }
                }
            }

            var req_s = "false"
            if req { req_s = "true" }
            var multi_s = "false"
            if multiple { multi_s = "true" }
            out = out + ",\"required\":" + req_s
            out = out + ",\"multiple\":" + multi_s
            out = out + "}"
            oi = oi + 1
        }
    }
    out = out + "],"

    // Positionals.
    out = out + "\"positionals\":["
    if cmd != nil && cmd["positionals"] != nil {
        var pi = 0
        var positionals = cmd["positionals"]
        var positionals_len = list.len(positionals)
        while pi < positionals_len {
            var pos = positionals[pi]
            if pi != 0 { out = out + "," }
            out = out + "{"
            out = out + "\"name\":" + _json_str(pos[0]) + ","
            var preq_s = "false"
            if pos[1] { preq_s = "true" }
            out = out + "\"required\":" + preq_s + ","
            out = out + "\"help\":" + _json_str(pos[2])
            out = out + "}"
            pi = pi + 1
        }
    }
    out = out + "]"

    out = out + "}"
    return out
}

fn _render_help_with_format(p, cmd_name, fmt) {
    if fmt == nil || _streq(fmt, "") { return render_help(p, cmd_name) }
    if _streq(fmt, "json") { return render_help_json(p, cmd_name) }
    // Unknown format: default to text (rolling).
    return render_help(p, cmd_name)
}

fn _tokenize_short(tok) {
    // Classify a non-long token starting with '-' (but not '--').
    // Returns:
    // - {"kind":"short", "flag":"-o", "tail":""} for "-o" or "-ovalue"
    // - {"kind":"chain", "flags":["-a","-b","-c"]} for "-abc"
    // - {"kind":"invalid"} for "-" (just dash)
    if tok == nil { return {"kind": "invalid"} }
    if !_starts_with(tok, "-") { return {"kind": "invalid"} }
    if _starts_with(tok, "--") { return {"kind": "invalid"} }
    if oren_string_len(tok) == 1 { return {"kind": "invalid"} } // "-"

    // First short flag is always tok[0:2].
    var flag = oren_string_slice(tok, 0, 2)
    var tail = ""
    if oren_string_len(tok) > 2 { tail = oren_string_slice(tok, 2, oren_string_len(tok)) }
    return {"kind": "short", "flag": flag, "tail": tail}
}

fn _set_opt_value(res, key, opt, value) {
    // Stores option value into res["opts"] and tracks seen-ness.
    // Repeatable options collect values into a list.
    if res["seen"] == nil { res["seen"] = {} }
    oren_map_set_str(res["seen"], key, true)

    var multiple = false
    if opt != nil && list.len(opt) >= 7 { multiple = opt[6] }
    if multiple {
        var cur = oren_map_get_str(res["opts"], key)
        // Repeatable options always store a list (defaults ensure list-typed storage).
        if cur == nil { cur = [] }
        list.push(cur, value)
        oren_map_set_str(res["opts"], key, cur)
        return nil
    }
    oren_map_set_str(res["opts"], key, value)
    return nil
}

fn _parse_one_option(cmd, p, cmd_name, argv, i, res) {
    // Parses argv[i] as an option token for cmd; mutates res and returns:
    // {"ok":true, "next_i": <int>} or {"ok":false, "res": <res>}
    var tok = argv[i]

    // Long form: --opt or --opt=value
    if _starts_with(tok, "--") {
        // Click-style boolean negation: --no-foo sets --foo to false (if foo is a bool flag).
        //
        // Only applies when the flag is not otherwise defined as a real long option.
        // (If the CLI defines a literal `--no-foo` option, that wins.)
        if _starts_with(tok, "--no-") && !_contains(tok, "=") {
            var base = "--" + oren_string_slice(tok, 5, oren_string_len(tok))
            var optN = _find_opt(cmd, tok)
            if optN == nil {
                var optBase = _find_opt(cmd, base)
                if optBase != nil && optBase[0] == 1 {
                    _set_opt_value(res, _normalize_key(optBase[1]), optBase, false)
                    return {"ok": true, "next_i": i + 1}
                }
            }
        }

        var flag = tok
        var value_inline = nil
        if _contains(tok, "=") {
            var parts = _split_once(tok, "=")
            flag = parts[0]
            value_inline = parts[1]
        }

        var opt = _find_opt(cmd, flag)
        if opt == nil {
            // Best-effort suggestion for UX (click-style): nearest option name.
            var sugg = _suggest_option(cmd, flag)
            if sugg != nil && !_streq(sugg, "") {
                res["err"] = "unknown option: " + tok + " (did you mean " + sugg + "?)"
            } else {
                res["err"] = "unknown option: " + tok
            }
            res["help"] = render_help(p, cmd_name)
            return {"ok": false, "res": res}
        }

        var key = _normalize_key(opt[1])
        var kind = opt[0]
        var is_value_opt = (kind == 2 || kind == 3)

        if !is_value_opt {
            if kind == 4 {
                // Counted flag: increment.
                var curc = oren_map_get_str(res["opts"], key)
                if oren_type_tag(curc) == 0 { curc = 0 }
                _set_opt_value(res, key, opt, curc + 1)
            } else {
                _set_opt_value(res, key, opt, true)
            }
            if _streq(key, "help") {
                res["ok"] = false
                res["code"] = 0
                // Support `--help=json` for machine-readable output.
                res["help"] = _render_help_with_format(p, cmd_name, value_inline)
                res["err"] = nil
                return {"ok": false, "res": res}
            }
            return {"ok": true, "next_i": i + 1}
        }

        var val = value_inline
        var next_i = i + 1
        if val == nil {
            if i + 1 >= list.len(argv) {
                res["err"] = "Missing value for " + flag
                res["help"] = render_help(p, cmd_name)
                return {"ok": false, "res": res}
            }
            val = argv[i + 1]
            next_i = i + 2
        }

        if kind == 2 {
            _set_opt_value(res, key, opt, val)
        } else {
            var n = _to_int(val)
            if n == nil {
                res["err"] = "invalid int for " + flag + ": " + val
                res["help"] = render_help(p, cmd_name)
                return {"ok": false, "res": res}
            }
            _set_opt_value(res, key, opt, n)
        }
        return {"ok": true, "next_i": next_i}
    }

    // Short form: -o, -o=value, -ovalue, -abc
    var tok_short = tok
    if _contains(tok_short, "=") {
        var partsS = _split_once(tok_short, "=")
        tok_short = partsS[0] + partsS[1]
    }

    var t = _tokenize_short(tok_short)
    if !_streq(t["kind"], "short") {
        res["err"] = "unknown option: " + tok
        res["help"] = render_help(p, cmd_name)
        return {"ok": false, "res": res}
    }

    var flag0 = t["flag"]
    var tail = t["tail"]

    var opt0 = _find_opt(cmd, flag0)
    if opt0 == nil {
        res["err"] = "unknown option: " + flag0
        res["help"] = render_help(p, cmd_name)
        return {"ok": false, "res": res}
    }

    var key0 = _normalize_key(opt0[1])
    var kind0 = opt0[0]
    var is_value0 = (kind0 == 2 || kind0 == 3)

    if is_value0 {
        var val0 = nil
        var next_i0 = i + 1
        if tail != nil && !_streq(tail, "") {
            val0 = tail
        } else {
            if i + 1 >= list.len(argv) {
                res["err"] = "Missing value for " + flag0
                res["help"] = render_help(p, cmd_name)
                return {"ok": false, "res": res}
            }
            val0 = argv[i + 1]
            next_i0 = i + 2
        }
        if kind0 == 2 {
            _set_opt_value(res, key0, opt0, val0)
        } else {
            var n0 = _to_int(val0)
            if n0 == nil {
                res["err"] = "invalid int for " + flag0 + ": " + val0
                res["help"] = render_help(p, cmd_name)
                return {"ok": false, "res": res}
            }
            _set_opt_value(res, key0, opt0, n0)
        }
        return {"ok": true, "next_i": next_i0}
    }

    // Bool flags: allow -abc chaining (tail is remaining letters).
    if kind0 == 4 {
        var curc0 = oren_map_get_str(res["opts"], key0)
        if oren_type_tag(curc0) == 0 { curc0 = 0 }
        _set_opt_value(res, key0, opt0, curc0 + 1)
    } else {
        _set_opt_value(res, key0, opt0, true)
    }
    if _streq(key0, "help") {
        res["ok"] = false
        res["code"] = 0
        // Support `-hjson` and `-h=json` (rewritten earlier into `-hjson`).
        res["help"] = _render_help_with_format(p, cmd_name, tail)
        res["err"] = nil
        return {"ok": false, "res": res}
    }

    if tail == nil || _streq(tail, "") {
        return {"ok": true, "next_i": i + 1}
    }

    // Chain remaining chars.
    var tail_len = oren_string_len(tail)
    var ci = 0
    while ci < tail_len {
        var ch = oren_string_slice(tail, ci, ci + 1)
        var f = "-" + ch
        var o = _find_opt(cmd, f)
        if o == nil {
            res["err"] = "unknown option: " + f
            res["help"] = render_help(p, cmd_name)
            return {"ok": false, "res": res}
        }
        var k = _normalize_key(o[1])
        var kk = o[0]
        if kk == 2 || kk == 3 {
            res["err"] = "option requires a value: " + f
            res["help"] = render_help(p, cmd_name)
            return {"ok": false, "res": res}
        }
        if kk == 4 {
            var curci = oren_map_get_str(res["opts"], k)
            if oren_type_tag(curci) == 0 { curci = 0 }
            _set_opt_value(res, k, o, curci + 1)
        } else {
            _set_opt_value(res, k, o, true)
        }
        if _streq(k, "help") {
            res["ok"] = false
            res["code"] = 0
            res["help"] = render_help(p, cmd_name)
            res["err"] = nil
            return {"ok": false, "res": res}
        }
        ci = ci + 1
    }

    return {"ok": true, "next_i": i + 1}
}

fn parse(p, argv) {
    // Returns:
    // {
    //   "ok": bool,
    //   "code": int,
    //   "err": string|nil,
    //   "help": string|nil,
    //   "cmd": string|nil,
    //   "root_opts": map,
    //   "opts": map,
    //   "all_opts": map,    // merged (root_opts + opts), opts wins on key collision
    //   "seen": map,        // which opts were explicitly set
    //   "pos": list,
    //   "rest": list
    // }

    var res = { "ok": false, "code": 2, "err": nil, "help": nil, "cmd": nil, "root_opts": {}, "opts": {}, "all_opts": {}, "seen": {}, "pos": [], "rest": [] }
    var dbg_ap = oren_env("OREN_DEBUG_ARGPARSE")
    var dbg_exit = oren_env("OREN_DEBUG_ARGPARSE_EXIT")
    var dbg_ret = oren_env("OREN_DEBUG_ARGPARSE_RETURN")
    if dbg_ap != nil {
        print("DEBUG_ARGPARSE start argv_len=" + oren_int_to_string(list.len(argv)))
    }
    if dbg_exit != nil && _streq(dbg_exit, "start") { oren_exit(200) }
    if argv == nil { argv = [] }

    // Read settings (default to click-style).
    var allow_opts_before_cmd = true
    var allow_interspersed = true
    if p != nil && p["settings"] != nil {
        if p["settings"]["allow_opts_before_cmd"] == false { allow_opts_before_cmd = false }
        if p["settings"]["allow_interspersed_args"] == false { allow_interspersed = false }
    }

    // Root parsing phase (global options + command selection).
    var root_cmd = p["root"]
    if dbg_ap != nil { print("DEBUG_ARGPARSE root defaults") }
    res["root_opts"] = _opts_defaults(root_cmd)
    if dbg_exit != nil && _streq(dbg_exit, "root_defaults") { oren_exit(200) }
    if dbg_ret != nil && _streq(dbg_ret, "root_defaults") { res["ok"] = true; return res }
    // During root parsing, write option values into root_opts (click-style global options).
    res["opts"] = res["root_opts"]

    var cmd = root_cmd
    var cmd_name = ""
    var i = 0
    var argv_len = list.len(argv)

    while i < argv_len {
        var tok0 = argv[i]
        if _streq(tok0, "--") {
            // End of option parsing on root; remaining tokens are treated as root args (no command).
            i = i + 1
            break
        }

        if allow_opts_before_cmd && _starts_with(tok0, "-") {
            // Parse a root option token.
            var parsed0 = _parse_one_option(root_cmd, p, "", argv, i, res)
            if parsed0["ok"] != true { return parsed0["res"] }
            var next_i0 = parsed0["next_i"]
            // Safety: never allow the parser to spin if an option parser regresses and makes no progress.
            if next_i0 == nil || next_i0 <= i {
                res["err"] = "internal argparse error: option parser made no progress on token: " + tok0
                res["help"] = render_help(p, nil)
                return res
            }
            i = next_i0
            continue
        }

        // Non-option token: either a command or a root positional.
        var maybe_cmd0 = _find_cmd(p, tok0)
        if maybe_cmd0 != nil {
            cmd = maybe_cmd0
            cmd_name = tok0
            i = i + 1
            break
        }

        // If there are commands, this is an unknown command.
        if p != nil && p["commands"] != nil && list.len(p["commands"]) > 0 {
            var cs = _suggest_command(p, tok0)
            if cs != nil && !_streq(cs, "") {
                res["err"] = "unknown command: " + tok0 + " (did you mean " + cs + "?)"
            } else {
                res["err"] = "unknown command: " + tok0
            }
            res["help"] = render_help(p, nil)
            return res
        }

        // No commands defined => treat as root positional.
        break
    }
    
    if dbg_ap != nil { print("DEBUG_ARGPARSE root parse done cmd=" + cmd_name) }
    if dbg_exit != nil && _streq(dbg_exit, "root_parse") { oren_exit(200) }
    if dbg_ret != nil && _streq(dbg_ret, "root_parse") { res["ok"] = true; res["cmd"] = cmd_name; return res }
    res["cmd"] = cmd_name
    // If no subcommand is selected, treat the root options map as the effective opts.
    // This prevents root options like `--version` from being overwritten by defaults.
    if _streq(cmd_name, "") {
        res["opts"] = res["root_opts"]
    } else {
        res["opts"] = _opts_defaults(cmd)
    }
    if dbg_ap != nil { print("DEBUG_ARGPARSE cmd defaults done") }
    if dbg_exit != nil && _streq(dbg_exit, "cmd_defaults") { oren_exit(200) }
    if dbg_ret != nil && _streq(dbg_ret, "cmd_defaults") { res["ok"] = true; res["cmd"] = cmd_name; return res }

    // Command args parsing phase.
    var pos = []
    var rest = []
    var stop_opts = false

    while i < argv_len {
        var tok = argv[i]
        if stop_opts != true && _streq(tok, "--") {
            stop_opts = true
            i = i + 1
            continue
        }

        if stop_opts != true && _starts_with(tok, "-") {
            // In non-interspersed mode, once we have positionals, stop parsing options.
            if allow_interspersed == false && list.len(pos) > 0 {
                list.push(pos, tok)
                i = i + 1
                continue
            }

            var parsed = _parse_one_option(cmd, p, cmd_name, argv, i, res)
            if parsed["ok"] != true { return parsed["res"] }
            var next_i1 = parsed["next_i"]
            if next_i1 == nil || next_i1 <= i {
                res["err"] = "internal argparse error: option parser made no progress on token: " + tok
                res["help"] = render_help(p, cmd_name)
                return res
            }
            i = next_i1
            continue
        }

        // Positional or rest.
        if stop_opts {
            list.push(rest, tok)
        } else {
            list.push(pos, tok)
        }
        i = i + 1
    }
    if dbg_ap != nil {
        print("DEBUG_ARGPARSE cmd_parse done pos_len=" + oren_int_to_string(list.len(pos)) + " rest_len=" + oren_int_to_string(list.len(rest)))
    }
    if dbg_ret != nil && _streq(dbg_ret, "cmd_parse") {
        res["ok"] = true
        res["cmd"] = cmd_name
        res["pos"] = pos
        res["rest"] = rest
        return res
    }

    // Validate positionals (required + max count).
    if dbg_ap != nil { print("DEBUG_ARGPARSE validate_pos start") }
    var required = 0
    for ps in cmd["positionals"] { if ps[1] { required = required + 1 } }
    if list.len(pos) < required {
        res["err"] = "missing required args"
        res["help"] = render_help(p, cmd_name)
        return res
    }
    if list.len(cmd["positionals"]) > 0 && list.len(pos) > list.len(cmd["positionals"]) {
        res["err"] = "too many args"
        res["help"] = render_help(p, cmd_name)
        return res
    }
    if list.len(cmd["positionals"]) == 0 && !_streq(cmd_name, "") && list.len(pos) > 0 {
        res["err"] = "unexpected args"
        res["help"] = render_help(p, cmd_name)
        return res
    }

    // Validate required options (command scope only, plus root options if present).
    //
    // We treat root opts as "global options" and allow them to satisfy required root options
    // even when a subcommand is selected.
    var req_cmd = _opts_required_keys(cmd)
    var ri = 0
    var req_cmd_len = list.len(req_cmd)
    while ri < req_cmd_len {
        var rk = req_cmd[ri]
        if oren_map_get_str(res["seen"], rk) != true {
            res["err"] = "missing required option: --" + rk
            res["help"] = render_help(p, cmd_name)
            return res
        }
        ri = ri + 1
    }
    var req_root = _opts_required_keys(root_cmd)
    var rj = 0
    var req_root_len = list.len(req_root)
    while rj < req_root_len {
        var rk2 = req_root[rj]
        if oren_map_get_str(res["seen"], rk2) != true {
            res["err"] = "missing required option: --" + rk2
            res["help"] = render_help(p, cmd_name)
            return res
        }
        rj = rj + 1
    }

    // Compute merged view for click-style access.
    var merged = {}
    for k0 in res["root_opts"] { oren_map_set_str(merged, k0, oren_map_get_str(res["root_opts"], k0)) }
    for k1 in res["opts"] { oren_map_set_str(merged, k1, oren_map_get_str(res["opts"], k1)) }
    res["all_opts"] = merged

    res["ok"] = true
    res["code"] = 0
    res["pos"] = pos
    res["rest"] = rest
    return res
}
