// std/generator.oren
//
// Thin stdlib facade over the compiler-injected generator core surface.
// The underlying handle is now a dedicated tagged object (`oren_type_name(gen) == "generator"`),
// while the worker protocol remains the same:
// - `start(worker, args_list)` expects `worker(co, args_list)`
// - `co["yield_ch"]` / `co["resume_ch"]` carry the explicit channel exchange surface
// - `next/send/is_done/return_value/collect` delegate to the shared runtime/compiler helpers

fn start(worker, args_list) {
    return oren_generator_start(worker, args_list)
}

fn next(gen) {
    return oren_generator_next(gen)
}

fn send(gen, value) {
    return oren_generator_send(gen, value)
}

fn is_done(gen) {
    return oren_generator_is_done(gen)
}

fn return_value(gen) {
    return oren_generator_return_value(gen)
}

fn collect(gen) {
    return oren_generator_collect(gen)
}
