// Base64 encoding (pure Oren, rolling)
//
// Scope:
// - Minimal encode surface used by protocols like WebSocket (Sec-WebSocket-Accept).
// - This is not a streaming API (v0); keep it small and predictable.
//
// Canonical API:
// - `encode(input_bytes)` / `input_bytes.base64()` -> string
// - `decode(b64_string)` / `b64_string.base64_bytes()` -> bytes (u8_buf)
// - `decode_strict(b64_string)` / `b64_string.base64_bytes_strict()` -> bytes

import bytesm "std:bytes"

trait Base64Bytes {
    fn base64(self);
}

trait Base64Text {
    fn base64_bytes(self): bytes;
    fn base64_bytes_strict(self): bytes;
}

fn _str_byte(s, i) {
    return oren_string_char_code_at(s, i) & 255
}

fn _b64_table_ptr() {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

fn _b64_char(idx) {
    // idx in [0..63] => ASCII byte code
    return _str_byte(_b64_table_ptr(), idx)
}

fn b64_is_ws(c) {
    // ASCII whitespace we accept in decode (RFC4648 allows newlines in MIME variants).
    if c == 9 { return 1 }  // '\t'
    if c == 10 { return 1 } // '\n'
    if c == 13 { return 1 } // '\r'
    if c == 32 { return 1 } // ' '
    return 0
}

fn _set_out(out, idx, v) {
    var rc = oren_bytes_set_u8(out, idx, v)
    if oren_is_err(rc) { return rc }
    return nil
}

fn encode_bytes(input_bytes) {
    if input_bytes == nil {
        input_bytes = oren_bytes_pack([])
    }

    var n = bytesm.len(input_bytes)
    if oren_is_err(n) { return oren_err(4, "base64.encode_bytes: input must be list<int> or u8_buf") }

    var out_len = ((n + 2) / 3) * 4
    var out = oren_u8_buf_new_uninit(out_len)
    if oren_is_err(out) { return out }
    var i = 0
    var oi = 0
    while i < n {
        var b0 = bytesm.get_u8(input_bytes, i)
        if oren_is_err(b0) { return b0 }
        var b1 = 0
        var b2 = 0
        var have1 = 0
        var have2 = 0
        if i + 1 < n {
            b1 = bytesm.get_u8(input_bytes, i + 1)
            if oren_is_err(b1) { return b1 }
            have1 = 1
        }
        if i + 2 < n {
            b2 = bytesm.get_u8(input_bytes, i + 2)
            if oren_is_err(b2) { return b2 }
            have2 = 1
        }

        var triple = (b0 << 16) | (b1 << 8) | b2
        var c0 = (triple >> 18) & 63
        var c1 = (triple >> 12) & 63
        var c2 = (triple >> 6) & 63
        var c3 = triple & 63

        var rc0 = _set_out(out, oi, _b64_char(c0))
        if oren_is_err(rc0) { return rc0 }
        var rc1 = _set_out(out, oi + 1, _b64_char(c1))
        if oren_is_err(rc1) { return rc1 }
        var rc2 = nil
        if have1 == 1 { rc2 = _set_out(out, oi + 2, _b64_char(c2)) }
        else { rc2 = _set_out(out, oi + 2, 61) } // '='
        if oren_is_err(rc2) { return rc2 }
        var rc3 = nil
        if have2 == 1 { rc3 = _set_out(out, oi + 3, _b64_char(c3)) }
        else { rc3 = _set_out(out, oi + 3, 61) } // '='
        if oren_is_err(rc3) { return rc3 }

        i = i + 3
        oi = oi + 4
    }

    return oren_string_from_bytes_slice(out, 0, out_len)
}

fn encode(input_bytes) { return encode_bytes(input_bytes) }

fn _b64_val(c) {
    // Returns:
    // - 0..63 for valid alphabet
    // - -1 for '=' padding
    // - -2 for whitespace (caller may skip)
    // - -3 for invalid
    if b64_is_ws(c) == 1 { return -2 }
    if c == 61 { return -1 } // '='
    if c >= 65 && c <= 90 { return c - 65 } // 'A'..'Z'
    if c >= 97 && c <= 122 { return 26 + (c - 97) } // 'a'..'z'
    if c >= 48 && c <= 57 { return 52 + (c - 48) } // '0'..'9'
    if c == 43 { return 62 } // '+'
    if c == 47 { return 63 } // '/'
    return -3
}

fn _b64_count_clean_chars(s) {
    var n = oren_string_len(s)
    var i = 0
    var out = 0
    while i < n {
        var c = _str_byte(s, i)
        if b64_is_ws(c) == 0 { out = out + 1 }
        i = i + 1
    }
    return out
}

fn decode_bytes(s) {
    // Decode a base64 string into bytes (u8_buf).
    //
    // Accepts whitespace (space, \t, \r, \n) anywhere.
    // Requires standard RFC4648 alphabet (+/ with '=' padding).
    if s == nil { return oren_err(4, "base64.decode_bytes: string is nil") }

    var clean = _b64_count_clean_chars(s)
    if clean == 0 { return oren_u8_buf_new_uninit(0) }
    if (clean % 4) != 0 { return oren_err(4, "base64.decode_bytes: invalid length (not multiple of 4)") }

    // Compute output length from padding (look at last 2 non-ws chars).
    var n = oren_string_len(s)
    var pad = 0
    var seen = 0
    var i = n - 1
    while i >= 0 && seen < 2 {
        var c = _str_byte(s, i)
        if b64_is_ws(c) == 0 {
            seen = seen + 1
            if c == 61 { pad = pad + 1 }
        }
        i = i - 1
    }
    if pad > 2 { return oren_err(4, "base64.decode_bytes: invalid padding") }

    var groups = clean / 4
    var out_len = groups * 3 - pad
    if out_len < 0 { out_len = 0 }

    var out = oren_u8_buf_new_uninit(out_len)
    if oren_is_err(out) { return out }

    // Decode loop: read 4 non-ws chars at a time.
    var si = 0
    var outi = 0
    var slen = n

    var g = 0
    while g < groups {
        var v0 = -9999
        while si < slen {
            var c0 = _str_byte(s, si)
            si = si + 1
            v0 = _b64_val(c0)
            if v0 == -2 { continue } // ws
            break
        }
        var v1 = -9999
        while si < slen {
            var c1 = _str_byte(s, si)
            si = si + 1
            v1 = _b64_val(c1)
            if v1 == -2 { continue } // ws
            break
        }
        var v2 = -9999
        while si < slen {
            var c2 = _str_byte(s, si)
            si = si + 1
            v2 = _b64_val(c2)
            if v2 == -2 { continue } // ws
            break
        }
        var v3 = -9999
        while si < slen {
            var c3 = _str_byte(s, si)
            si = si + 1
            v3 = _b64_val(c3)
            if v3 == -2 { continue } // ws
            break
        }
        if v0 < 0 || v1 < 0 { return oren_err(4, "base64.decode_bytes: invalid base64") }
        if v0 == -1 || v1 == -1 { return oren_err(4, "base64.decode_bytes: padding in first 2 chars") }
        if v2 < -1 || v3 < -1 { return oren_err(4, "base64.decode_bytes: invalid base64") }

        var triple = (v0 << 18) | (v1 << 12)
        if v2 >= 0 { triple = triple | (v2 << 6) }
        if v3 >= 0 { triple = triple | v3 }

        // First byte always present.
        if outi < out_len {
            var rc0 = oren_bytes_set_u8(out, outi, (triple >> 16) & 255)
            if oren_is_err(rc0) { return rc0 }
            outi = outi + 1
        }
        // Second byte present unless v2 is '='.
        if v2 >= 0 && outi < out_len {
            var rc1 = oren_bytes_set_u8(out, outi, (triple >> 8) & 255)
            if oren_is_err(rc1) { return rc1 }
            outi = outi + 1
        }
        // Third byte present unless v3 is '='.
        if v3 >= 0 && outi < out_len {
            var rc2 = oren_bytes_set_u8(out, outi, triple & 255)
            if oren_is_err(rc2) { return rc2 }
            outi = outi + 1
        }

        g = g + 1
    }

    return out
}

fn decode(s): bytes { return decode_bytes(s) }

fn decode_bytes_strict(s) {
    // Strict variant: rejects any whitespace (for protocols that require exact base64).
    if s == nil { return oren_err(4, "base64.decode_bytes_strict: string is nil") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return oren_err(4, "base64.decode_bytes_strict: s must be string") }
    var i = 0
    while i < n {
        var c = _str_byte(s, i)
        if b64_is_ws(c) == 1 { return oren_err(4, "base64.decode_bytes_strict: whitespace not allowed") }
        i = i + 1
    }
    return decode_bytes(s)
}

fn decode_strict(s): bytes { return decode_bytes_strict(s) }

impl Base64Bytes for bytes {
    fn base64(self) { return encode(self) }
}

impl Base64Text for string {
    fn base64_bytes(self): bytes { return decode(self) }
    fn base64_bytes_strict(self): bytes { return decode_strict(self) }
}
