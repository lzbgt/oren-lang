// Base64 encoding (pure Oren, rolling)
//
// Scope:
// - Minimal encode surface used by protocols like WebSocket (Sec-WebSocket-Accept).
// - This is not a streaming API (v0); keep it small and predictable.
//
// Canonical API:
// - `encode(input_bytes)` / `input_bytes.base64()` -> string
// - `decode(b64_string)` / `b64_string.base64_bytes()` -> bytes (u8_buf)
// - `decode_strict(b64_string)` / `b64_string.base64_bytes_strict()` -> bytes
// - `encode_url(input_bytes)` / `input_bytes.base64_url()` -> unpadded Base64URL string
// - `decode_url(b64url_string)` / `b64url_string.base64_url_bytes()` -> bytes

import bytesm "std:bytes"
import list "std:list"
import raw "std:buffer/raw"

trait Base64Bytes {
    fn base64(self);
    fn base64_url(self);
}

trait Base64Text {
    fn base64_bytes(self): bytes;
    fn base64_bytes_strict(self): bytes;
    fn base64_url_bytes(self): bytes;
}

var _B64_DECODE = nil
var _B64URL_DECODE = nil

fn _str_byte(s, i) {
    return oren_string_byte_at_unchecked(s, i) & 255
}

fn _b64_table_ptr() {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

fn _b64url_table_ptr() {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
}

fn b64_is_ws(c) {
    // ASCII whitespace we accept in decode (RFC4648 allows newlines in MIME variants).
    if c == 9 { return 1 }  // '\t'
    if c == 10 { return 1 } // '\n'
    if c == 13 { return 1 } // '\r'
    if c == 32 { return 1 } // ' '
    return 0
}

fn _set_out(out, idx, v) {
    raw._store_u8_buf_unchecked_direct(out, idx, v & 255)
    return out
}

fn _input_byte_direct(input_bytes, input_ptr, idx) {
    if input_ptr != nil { return ptr_get_byte(input_ptr + idx) & 255 }
    return oren_bytes_get_u8(input_bytes, idx)
}

fn _new_decode_table(default_value) {
    var t = list.int_new(128)
    var i = 0
    while i < 128 {
        list.int_push(t, default_value)
        i = i + 1
    }
    return t
}

fn _set_decode_range(t, lo, hi, base) {
    var i = lo
    while i <= hi {
        list.int_set(t, i, base + (i - lo))
        i = i + 1
    }
    return t
}

fn _b64_decode_table() {
    if _B64_DECODE != nil { return _B64_DECODE }
    var t = _new_decode_table(-3)
    _set_decode_range(t, 65, 90, 0)   // 'A'..'Z'
    _set_decode_range(t, 97, 122, 26) // 'a'..'z'
    _set_decode_range(t, 48, 57, 52)  // '0'..'9'
    list.int_set(t, 43, 62) // '+'
    list.int_set(t, 47, 63) // '/'
    list.int_set(t, 61, -1) // '='
    list.int_set(t, 9, -2)
    list.int_set(t, 10, -2)
    list.int_set(t, 13, -2)
    list.int_set(t, 32, -2)
    _B64_DECODE = t
    return t
}

fn _b64url_decode_table() {
    if _B64URL_DECODE != nil { return _B64URL_DECODE }
    var t = _new_decode_table(-1)
    _set_decode_range(t, 65, 90, 0)   // 'A'..'Z'
    _set_decode_range(t, 97, 122, 26) // 'a'..'z'
    _set_decode_range(t, 48, 57, 52)  // '0'..'9'
    list.int_set(t, 45, 62) // '-'
    list.int_set(t, 95, 63) // '_'
    _B64URL_DECODE = t
    return t
}

fn encode_bytes(input_bytes) {
    if input_bytes == nil {
        input_bytes = oren_u8_buf_new(0)
    }

    var input_view = bytesm.view(input_bytes, "base64.encode_bytes")
    if oren_is_err(input_view) { return oren_err(4, "base64.encode_bytes: input must be list<int> or u8_buf") }
    var n = bytesm.view_len(input_view)
    var input_data = bytesm.view_bytes(input_view)
    var input_ptr = bytesm.view_ptr(input_view)

    var out_len = ((n + 2) / 3) * 4
    var out = oren_u8_buf_new_uninit(out_len)
    if oren_is_err(out) { return out }
    var table = _b64_table_ptr()
    var i = 0
    var oi = 0
    while i < n {
        var b0 = _input_byte_direct(input_data, input_ptr, i)
        if oren_is_err(b0) { return b0 }
        var b1 = 0
        var b2 = 0
        var have1 = 0
        var have2 = 0
        if i + 1 < n {
            b1 = _input_byte_direct(input_data, input_ptr, i + 1)
            if oren_is_err(b1) { return b1 }
            have1 = 1
        }
        if i + 2 < n {
            b2 = _input_byte_direct(input_data, input_ptr, i + 2)
            if oren_is_err(b2) { return b2 }
            have2 = 1
        }

        var triple = (b0 << 16) | (b1 << 8) | b2
        var c0 = (triple >> 18) & 63
        var c1 = (triple >> 12) & 63
        var c2 = (triple >> 6) & 63
        var c3 = triple & 63

        var rc0 = _set_out(out, oi, _str_byte(table, c0))
        if oren_is_err(rc0) { return rc0 }
        var rc1 = _set_out(out, oi + 1, _str_byte(table, c1))
        if oren_is_err(rc1) { return rc1 }
        var rc2 = nil
        if have1 == 1 { rc2 = _set_out(out, oi + 2, _str_byte(table, c2)) }
        else { rc2 = _set_out(out, oi + 2, 61) } // '='
        if oren_is_err(rc2) { return rc2 }
        var rc3 = nil
        if have2 == 1 { rc3 = _set_out(out, oi + 3, _str_byte(table, c3)) }
        else { rc3 = _set_out(out, oi + 3, 61) } // '='
        if oren_is_err(rc3) { return rc3 }

        i = i + 3
        oi = oi + 4
    }

    return oren_string_from_bytes_slice(out, 0, out_len)
}

fn encode(input_bytes) { return encode_bytes(input_bytes) }

fn encode_url_bytes(input_bytes) {
    if input_bytes == nil {
        input_bytes = oren_u8_buf_new(0)
    }

    var input_view = bytesm.view(input_bytes, "base64.encode_url_bytes")
    if oren_is_err(input_view) { return oren_err(4, "base64.encode_url_bytes: input must be list<int> or u8_buf") }
    var n = bytesm.view_len(input_view)
    var input_data = bytesm.view_bytes(input_view)
    var input_ptr = bytesm.view_ptr(input_view)

    var out_len = (n / 3) * 4
    var rem = n % 3
    if rem == 1 { out_len = out_len + 2 }
    if rem == 2 { out_len = out_len + 3 }
    var out = oren_u8_buf_new_uninit(out_len)
    if oren_is_err(out) { return out }
    var table = _b64url_table_ptr()
    var i = 0
    var oi = 0
    while i < n {
        var b0 = _input_byte_direct(input_data, input_ptr, i)
        if oren_is_err(b0) { return b0 }
        var b1 = 0
        var b2 = 0
        var have1 = 0
        var have2 = 0
        if i + 1 < n {
            b1 = _input_byte_direct(input_data, input_ptr, i + 1)
            if oren_is_err(b1) { return b1 }
            have1 = 1
        }
        if i + 2 < n {
            b2 = _input_byte_direct(input_data, input_ptr, i + 2)
            if oren_is_err(b2) { return b2 }
            have2 = 1
        }

        var triple = (b0 << 16) | (b1 << 8) | b2
        var rc0 = _set_out(out, oi, _str_byte(table, (triple >> 18) & 63))
        if oren_is_err(rc0) { return rc0 }
        var rc1 = _set_out(out, oi + 1, _str_byte(table, (triple >> 12) & 63))
        if oren_is_err(rc1) { return rc1 }
        if have1 == 1 {
            var rc2 = _set_out(out, oi + 2, _str_byte(table, (triple >> 6) & 63))
            if oren_is_err(rc2) { return rc2 }
        }
        if have2 == 1 {
            var rc3 = _set_out(out, oi + 3, _str_byte(table, triple & 63))
            if oren_is_err(rc3) { return rc3 }
        }

        i = i + 3
        oi = oi + 4
    }

    return oren_string_from_bytes_slice(out, 0, out_len)
}

fn encode_url(input_bytes) { return encode_url_bytes(input_bytes) }

fn _b64_val(c) {
    // Returns:
    // - 0..63 for valid alphabet
    // - -1 for '=' padding
    // - -2 for whitespace (caller may skip)
    // - -3 for invalid
    if c < 0 || c >= 128 { return -3 }
    return list.int_get(_b64_decode_table(), c)
}

fn _b64url_val(c) {
    if c < 0 || c >= 128 { return -1 }
    return list.int_get(_b64url_decode_table(), c)
}

fn _b64_clean_meta_range(s, start, end) {
    var i = start
    var clean = 0
    var trailing_pad = 0
    while i < end {
        var c = _str_byte(s, i)
        if b64_is_ws(c) == 0 {
            clean = clean + 1
            if c == 61 {
                trailing_pad = trailing_pad + 1
            } else {
                trailing_pad = 0
            }
        }
        i = i + 1
    }
    return clean * 4 + trailing_pad
}

fn _range_end(s, start, count, ctx) {
    if s == nil { return oren_err(4, ctx + ": string is nil") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return oren_err(4, ctx + ": s must be string") }
    if start < 0 || count < 0 || start > n || count > n - start {
        return oren_err(4, ctx + ": invalid range")
    }
    return start + count
}

fn _decode_bytes_range_impl(s, start, end, ctx) {
    var meta = _b64_clean_meta_range(s, start, end)
    var clean = meta / 4
    if clean == 0 { return oren_u8_buf_new_uninit(0) }
    if (clean % 4) != 0 { return oren_err(4, ctx + ": invalid length (not multiple of 4)") }

    // Output length comes from the same clean-character metadata pass.
    var pad = meta % 4
    if pad > 2 { return oren_err(4, ctx + ": invalid padding") }

    var groups = clean / 4
    var out_len = groups * 3 - pad
    if out_len < 0 { out_len = 0 }

    var out = oren_u8_buf_new_uninit(out_len)
    if oren_is_err(out) { return out }

    // Decode loop: read 4 non-ws chars at a time.
    var si = start
    var outi = 0
    var slen = end

    var g = 0
    while g < groups {
        var v0 = -9999
        while si < slen {
            var c0 = _str_byte(s, si)
            si = si + 1
            v0 = _b64_val(c0)
            if v0 == -2 { continue } // ws
            break
        }
        var v1 = -9999
        while si < slen {
            var c1 = _str_byte(s, si)
            si = si + 1
            v1 = _b64_val(c1)
            if v1 == -2 { continue } // ws
            break
        }
        var v2 = -9999
        while si < slen {
            var c2 = _str_byte(s, si)
            si = si + 1
            v2 = _b64_val(c2)
            if v2 == -2 { continue } // ws
            break
        }
        var v3 = -9999
        while si < slen {
            var c3 = _str_byte(s, si)
            si = si + 1
            v3 = _b64_val(c3)
            if v3 == -2 { continue } // ws
            break
        }
        if v0 < 0 || v1 < 0 { return oren_err(4, ctx + ": invalid base64") }
        if v0 == -1 || v1 == -1 { return oren_err(4, ctx + ": padding in first 2 chars") }
        if v2 < -1 || v3 < -1 { return oren_err(4, ctx + ": invalid base64") }
        if (v2 == -1 || v3 == -1) && g + 1 < groups {
            return oren_err(4, ctx + ": padding before final group")
        }
        if v2 == -1 && v3 != -1 {
            return oren_err(4, ctx + ": invalid padding")
        }
        if v2 == -1 {
            if (v1 & 15) != 0 { return oren_err(4, ctx + ": nonzero padding bits") }
        } else if v3 == -1 {
            if (v2 & 3) != 0 { return oren_err(4, ctx + ": nonzero padding bits") }
        }

        var triple = (v0 << 18) | (v1 << 12)
        if v2 >= 0 { triple = triple | (v2 << 6) }
        if v3 >= 0 { triple = triple | v3 }

        // First byte always present.
        if outi < out_len {
            var rc0 = raw._store_u8_buf_unchecked_direct(out, outi, (triple >> 16) & 255)
            if oren_is_err(rc0) { return rc0 }
            outi = outi + 1
        }
        // Second byte present unless v2 is '='.
        if v2 >= 0 && outi < out_len {
            var rc1 = raw._store_u8_buf_unchecked_direct(out, outi, (triple >> 8) & 255)
            if oren_is_err(rc1) { return rc1 }
            outi = outi + 1
        }
        // Third byte present unless v3 is '='.
        if v3 >= 0 && outi < out_len {
            var rc2 = raw._store_u8_buf_unchecked_direct(out, outi, triple & 255)
            if oren_is_err(rc2) { return rc2 }
            outi = outi + 1
        }

        g = g + 1
    }

    return out
}

fn decode_bytes_range(s, start, count) {
    var end = _range_end(s, start, count, "base64.decode_bytes_range")
    if oren_is_err(end) { return end }
    return _decode_bytes_range_impl(s, start, end, "base64.decode_bytes_range")
}

fn decode_bytes(s) {
    // Decode a base64 string into bytes (u8_buf).
    //
    // Accepts whitespace (space, \t, \r, \n) anywhere.
    // Requires standard RFC4648 alphabet (+/ with '=' padding).
    if s == nil { return oren_err(4, "base64.decode_bytes: string is nil") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return oren_err(4, "base64.decode_bytes: s must be string") }
    return _decode_bytes_range_impl(s, 0, n, "base64.decode_bytes")
}

fn decode(s): bytes { return decode_bytes(s) }

fn _store_decoded_triple(out, outi, out_len, triple, count) {
    if count >= 1 && outi < out_len {
        var rc0 = raw._store_u8_buf_unchecked_direct(out, outi, (triple >> 16) & 255)
        if oren_is_err(rc0) { return rc0 }
    }
    if count >= 2 && outi + 1 < out_len {
        var rc1 = raw._store_u8_buf_unchecked_direct(out, outi + 1, (triple >> 8) & 255)
        if oren_is_err(rc1) { return rc1 }
    }
    if count >= 3 && outi + 2 < out_len {
        var rc2 = raw._store_u8_buf_unchecked_direct(out, outi + 2, triple & 255)
        if oren_is_err(rc2) { return rc2 }
    }
    return 0
}

fn decode_url_bytes(s) {
    if s == nil { return oren_err(4, "base64.decode_url_bytes: string is nil") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return oren_err(4, "base64.decode_url_bytes: s must be string") }
    if n == 0 { return oren_u8_buf_new_uninit(0) }

    var pad = 0
    var i = n - 1
    while i >= 0 && _str_byte(s, i) == 61 {
        pad = pad + 1
        i = i - 1
    }
    if pad > 2 { return oren_err(4, "base64.decode_url_bytes: invalid padding") }
    var core_len = n - pad
    if core_len <= 0 { return oren_err(4, "base64.decode_url_bytes: invalid length") }
    var rem = core_len % 4
    if rem == 1 { return oren_err(4, "base64.decode_url_bytes: invalid length") }
    if pad > 0 {
        if (n % 4) != 0 { return oren_err(4, "base64.decode_url_bytes: invalid padded length") }
        if pad == 1 && rem != 3 { return oren_err(4, "base64.decode_url_bytes: invalid padding") }
        if pad == 2 && rem != 2 { return oren_err(4, "base64.decode_url_bytes: invalid padding") }
    }

    var out_len = (core_len / 4) * 3
    if rem == 2 { out_len = out_len + 1 }
    if rem == 3 { out_len = out_len + 2 }
    var out = oren_u8_buf_new_uninit(out_len)
    if oren_is_err(out) { return out }

    var si = 0
    var outi = 0
    while si + 4 <= core_len {
        var v0 = _b64url_val(_str_byte(s, si))
        var v1 = _b64url_val(_str_byte(s, si + 1))
        var v2 = _b64url_val(_str_byte(s, si + 2))
        var v3 = _b64url_val(_str_byte(s, si + 3))
        if v0 < 0 || v1 < 0 || v2 < 0 || v3 < 0 { return oren_err(4, "base64.decode_url_bytes: invalid base64url") }
        var triple = (v0 << 18) | (v1 << 12) | (v2 << 6) | v3
        var rc = _store_decoded_triple(out, outi, out_len, triple, 3)
        if oren_is_err(rc) { return rc }
        si = si + 4
        outi = outi + 3
    }
    if rem == 2 {
        var r0 = _b64url_val(_str_byte(s, si))
        var r1 = _b64url_val(_str_byte(s, si + 1))
        if r0 < 0 || r1 < 0 { return oren_err(4, "base64.decode_url_bytes: invalid base64url") }
        if (r1 & 15) != 0 { return oren_err(4, "base64.decode_url_bytes: nonzero padding bits") }
        var triple2 = (r0 << 18) | (r1 << 12)
        var rc2 = _store_decoded_triple(out, outi, out_len, triple2, 1)
        if oren_is_err(rc2) { return rc2 }
    } else if rem == 3 {
        var r20 = _b64url_val(_str_byte(s, si))
        var r21 = _b64url_val(_str_byte(s, si + 1))
        var r22 = _b64url_val(_str_byte(s, si + 2))
        if r20 < 0 || r21 < 0 || r22 < 0 { return oren_err(4, "base64.decode_url_bytes: invalid base64url") }
        if (r22 & 3) != 0 { return oren_err(4, "base64.decode_url_bytes: nonzero padding bits") }
        var triple3 = (r20 << 18) | (r21 << 12) | (r22 << 6)
        var rc3 = _store_decoded_triple(out, outi, out_len, triple3, 2)
        if oren_is_err(rc3) { return rc3 }
    }
    return out
}

fn decode_url(s): bytes { return decode_url_bytes(s) }

fn _decode_bytes_strict_range_impl(s, start, end, ctx, allow_line_breaks) {
    var n = end - start
    if n == 0 { return oren_u8_buf_new_uninit(0) }
    if allow_line_breaks == 1 {
        var meta = _b64_clean_meta_lines_strict_range(s, start, end, ctx)
        if oren_is_err(meta) { return meta }
        n = meta
    }
    if (n % 4) != 0 { return oren_err(4, ctx + ": invalid length (not multiple of 4)") }

    var pad = 0
    if allow_line_breaks == 0 {
        if _str_byte(s, end - 1) == 61 { pad = pad + 1 }
        if n >= 2 && _str_byte(s, end - 2) == 61 { pad = pad + 1 }
    } else {
        var back = end - 1
        var seen = 0
        while back >= start && seen < 2 {
            var bc = _str_byte(s, back)
            if bc == 10 || bc == 13 {
                back = back - 1
                continue
            }
            if bc == 61 { pad = pad + 1 }
            seen = seen + 1
            back = back - 1
        }
    }
    if pad > 2 { return oren_err(4, ctx + ": invalid padding") }

    var groups = n / 4
    var out_len = groups * 3 - pad
    if out_len < 0 { out_len = 0 }
    var out = oren_u8_buf_new_uninit(out_len)
    if oren_is_err(out) { return out }

    var si = 0
    if allow_line_breaks == 1 { si = start }
    var outi = 0
    var g = 0
    while g < groups {
        var v0 = -9999
        var v1 = -9999
        var v2 = -9999
        var v3 = -9999
        if allow_line_breaks == 0 {
            v0 = _b64_val(_str_byte(s, start + si))
            v1 = _b64_val(_str_byte(s, start + si + 1))
            v2 = _b64_val(_str_byte(s, start + si + 2))
            v3 = _b64_val(_str_byte(s, start + si + 3))
        } else {
            while si < end {
                var c0 = _str_byte(s, si)
                si = si + 1
                if c0 == 10 || c0 == 13 { continue }
                if b64_is_ws(c0) == 1 { return oren_err(4, ctx + ": whitespace not allowed") }
                v0 = _b64_val(c0)
                break
            }
            while si < end {
                var c1 = _str_byte(s, si)
                si = si + 1
                if c1 == 10 || c1 == 13 { continue }
                if b64_is_ws(c1) == 1 { return oren_err(4, ctx + ": whitespace not allowed") }
                v1 = _b64_val(c1)
                break
            }
            while si < end {
                var c2 = _str_byte(s, si)
                si = si + 1
                if c2 == 10 || c2 == 13 { continue }
                if b64_is_ws(c2) == 1 { return oren_err(4, ctx + ": whitespace not allowed") }
                v2 = _b64_val(c2)
                break
            }
            while si < end {
                var c3 = _str_byte(s, si)
                si = si + 1
                if c3 == 10 || c3 == 13 { continue }
                if b64_is_ws(c3) == 1 { return oren_err(4, ctx + ": whitespace not allowed") }
                v3 = _b64_val(c3)
                break
            }
            if v0 == -9999 || v1 == -9999 || v2 == -9999 || v3 == -9999 {
                return oren_err(4, ctx + ": truncated base64")
            }
        }
        if v0 == -2 || v1 == -2 || v2 == -2 || v3 == -2 {
            return oren_err(4, ctx + ": whitespace not allowed")
        }
        if v0 < 0 || v1 < 0 { return oren_err(4, ctx + ": invalid base64") }
        if v0 == -1 || v1 == -1 { return oren_err(4, ctx + ": padding in first 2 chars") }
        if v2 < -1 || v3 < -1 { return oren_err(4, ctx + ": invalid base64") }
        if (v2 == -1 || v3 == -1) && g + 1 < groups {
            return oren_err(4, ctx + ": padding before final group")
        }
        if v2 == -1 && v3 != -1 {
            return oren_err(4, ctx + ": invalid padding")
        }
        if v2 == -1 {
            if (v1 & 15) != 0 { return oren_err(4, ctx + ": nonzero padding bits") }
        } else if v3 == -1 {
            if (v2 & 3) != 0 { return oren_err(4, ctx + ": nonzero padding bits") }
        }

        var triple = (v0 << 18) | (v1 << 12)
        if v2 >= 0 { triple = triple | (v2 << 6) }
        if v3 >= 0 { triple = triple | v3 }
        var count = 3
        if v2 == -1 {
            count = 1
        } else {
            if v3 == -1 { count = 2 }
        }
        var rc = _store_decoded_triple(out, outi, out_len, triple, count)
        if oren_is_err(rc) { return rc }

        if allow_line_breaks == 0 { si = si + 4 }
        outi = outi + count
        g = g + 1
    }
    return out
}

fn _b64_clean_meta_lines_strict_range(s, start, end, ctx) {
    var i = start
    var clean = 0
    while i < end {
        var c = _str_byte(s, i)
        if c == 10 || c == 13 {
            i = i + 1
            continue
        }
        if b64_is_ws(c) == 1 { return oren_err(4, ctx + ": whitespace not allowed") }
        clean = clean + 1
        i = i + 1
    }
    return clean
}

fn decode_bytes_strict_range(s, start, count) {
    var end = _range_end(s, start, count, "base64.decode_bytes_strict_range")
    if oren_is_err(end) { return end }
    return _decode_bytes_strict_range_impl(s, start, end, "base64.decode_bytes_strict_range", 0)
}

fn decode_bytes_strict_lines_range(s, start, count) {
    var end = _range_end(s, start, count, "base64.decode_bytes_strict_lines_range")
    if oren_is_err(end) { return end }
    return _decode_bytes_strict_range_impl(s, start, end, "base64.decode_bytes_strict_lines_range", 1)
}

fn decode_bytes_strict(s) {
    // Strict variant: rejects any whitespace and decodes in one forward pass.
    if s == nil { return oren_err(4, "base64.decode_bytes_strict: string is nil") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return oren_err(4, "base64.decode_bytes_strict: s must be string") }
    return _decode_bytes_strict_range_impl(s, 0, n, "base64.decode_bytes_strict", 0)
}

fn decode_strict(s): bytes { return decode_bytes_strict(s) }

impl Base64Bytes for bytes {
    fn base64(self) { return encode(self) }
    fn base64_url(self) { return encode_url(self) }
}

impl Base64Text for string {
    fn base64_bytes(self): bytes { return decode(self) }
    fn base64_bytes_strict(self): bytes { return decode_strict(self) }
    fn base64_url_bytes(self): bytes { return decode_url(self) }
}
