// std/env (v0, rolling)
//
// Capability-gated environment facade over the existing ENV runtime intrinsic.
// Host environment access, AVM record/replay, and capsule policy remain
// runtime-controlled.

fn get(name) {
    return oren_env(name)
}

fn get_or(name, fallback) {
    var v = get(name)
    if v == nil { return fallback }
    return v
}

fn has(name) {
    return get(name) != nil
}

fn require(name) {
    var v = get(name)
    if v != nil { return v }
    return oren_err(4, "std:env.require: missing environment variable " + name)
}

fn truthy(name) {
    var v = get(name)
    if v == nil { return false }
    if v == "" { return false }
    if v == "0" { return false }
    if v == "false" || v == "FALSE" { return false }
    return true
}
