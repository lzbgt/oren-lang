// std/regex (rolling)
//
// Deterministic Thompson NFA regex engine.
// - No backtracking blowups.
// - ASCII/UTF-8 byte-wise matching (no unicode classes yet).
// - Supported syntax (v1):
//   literals, ., ?, *, +, |, ( ), ^, $
//   character classes: [abc], [a-z], [^...], and escapes \\ \/ \" \[ \] \( \) \| \* \+ \? \.^ \$
//
// API:
//   var r = regex.compile(pattern)
//   if r["ok"]==1 { regex.is_match_compiled(r["v"], text) }
//
// Convenience:
//   regex.is_match(pattern, text)

fn _err(msg) { return {"ok": 0, "err": msg} }
fn _ok(v) { return {"ok": 1, "v": v} }

fn _slice(xs, start, end) {
    if xs == nil { return nil }
    var n = oren_list_len(xs)
    if start < 0 { start = 0 }
    if end > n { end = n }
    if end < start { end = start }
    var out = []
    var i = start
    while i < end {
        oren_list_push(out, xs[i])
        i = i + 1
    }
    return out
}

fn _streq(a, b) {
    if a == nil || b == nil { return false }
    var ab = oren_bytes_from_string(a)
    var bb = oren_bytes_from_string(b)
    var al = oren_list_len(ab)
    var bl = oren_list_len(bb)
    if al != bl { return false }
    var i = 0
    while i < al {
        if ab[i] != bb[i] { return false }
        i = i + 1
    }
    return true
}

// State kinds:
//   kind="char" c=<byte>
//   kind="any"
//   kind="split" out/out1
//   kind="match"
//   kind="bol" (assert start)
//   kind="eol" (assert end)
//   kind="class" ranges=[[lo,hi]...] neg=0|1

fn _state(kind) {
    return {"kind": kind, "c": 0, "out": -1, "out1": -1, "ranges": nil, "neg": 0}
}

fn _patch(list, states, target) {
    // list items: {"s":idx,"which":0|1}
    var i = 0
    while i < oren_list_len(list) {
        var p = list[i]
        var si = p["s"]
        if p["which"] == 0 { states[si]["out"] = target } else { states[si]["out1"] = target }
        i = i + 1
    }
    return nil
}

fn _append(a, b) {
    if a == nil { return b }
    if b == nil { return a }
    var out = []
    var i = 0
    while i < oren_list_len(a) { oren_list_push(out, a[i]); i = i + 1 }
    i = 0
    while i < oren_list_len(b) { oren_list_push(out, b[i]); i = i + 1 }
    return out
}

fn _list1(sidx, which) {
    return [{"s": sidx, "which": which}]
}

fn _frag(start, out_list) {
    return {"start": start, "out": out_list}
}

fn _is_meta(b) {
    // meta chars that need escaping when literal
    return b == 40 || b == 41 || b == 124 || b == 42 || b == 43 || b == 63 || b == 46 || b == 91 || b == 93 || b == 94 || b == 36 || b == 92
}

fn _re2post(pattern) {
    // Shunting-yard to postfix with explicit concat.
    // Based on Thompson construction style.
    var bs = oren_bytes_from_string(pattern)
    var out = []
    var nalt = []
    var natom = []

    var i = 0
    var n = oren_list_len(bs)
    var esc = false

    // init
    oren_list_push(nalt, 0)
    oren_list_push(natom, 0)

    while i < n {
        var c = bs[i]
        if esc {
            // escaped literal
            if natom[oren_list_len(natom)-1] > 1 {
                // emit concat
                natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
                oren_list_push(out, 46) // '.' concat marker
            }
            // emit literal token as negative byte marker: 1000 + byte
            oren_list_push(out, 1000 + c)
            natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] + 1
            esc = false
            i = i + 1
            continue
        }
        if c == 92 { // '\\'
            esc = true
            i = i + 1
            continue
        }

        if c == 40 { // (
            if natom[oren_list_len(natom)-1] > 1 {
                natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
                oren_list_push(out, 46)
            }
            oren_list_push(nalt, 0)
            oren_list_push(natom, 0)
            i = i + 1
            continue
        }
        if c == 41 { // )
            if oren_list_len(natom) <= 1 { return _err("unmatched )") }
            // close concat
            while natom[oren_list_len(natom)-1] > 1 {
                natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
                oren_list_push(out, 46)
            }
            // close alternations
            while nalt[oren_list_len(nalt)-1] > 0 {
                oren_list_push(out, 124)
                nalt[oren_list_len(nalt)-1] = nalt[oren_list_len(nalt)-1] - 1
            }
            nalt = _slice(nalt, 0, oren_list_len(nalt)-1)
            natom = _slice(natom, 0, oren_list_len(natom)-1)
            natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] + 1
            i = i + 1
            continue
        }
        if c == 124 { // |
            // close concat
            while natom[oren_list_len(natom)-1] > 1 {
                natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
                oren_list_push(out, 46)
            }
            nalt[oren_list_len(nalt)-1] = nalt[oren_list_len(nalt)-1] + 1
            natom[oren_list_len(natom)-1] = 0
            i = i + 1
            continue
        }
        if c == 42 || c == 43 || c == 63 { // * + ?
            if natom[oren_list_len(natom)-1] == 0 { return _err("nothing to repeat") }
            oren_list_push(out, c)
            i = i + 1
            continue
        }
        // char class
        if c == 91 { // '['
            if natom[oren_list_len(natom)-1] > 1 {
                natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
                oren_list_push(out, 46)
            }
            i = i + 1
            if i >= n { return _err("unterminated [") }
            var neg = 0
            if bs[i] == 94 { neg = 1; i = i + 1 }
            var ranges = []
            var first = true
            var prev = -1
            while i < n {
                var cc = bs[i]
                if cc == 93 && first != true { break }
                first = false
                if cc == 92 {
                    i = i + 1
                    if i >= n { return _err("unterminated escape in []") }
                    cc = bs[i]
                }
                if cc == 45 && prev != -1 && i + 1 < n && bs[i+1] != 93 {
                    // range
                    i = i + 1
                    var hi = bs[i]
                    if hi == 92 {
                        i = i + 1
                        if i >= n { return _err("unterminated escape in range") }
                        hi = bs[i]
                    }
                    oren_list_push(ranges, [prev, hi])
                    prev = -1
                    i = i + 1
                    continue
                }
                if prev != -1 {
                    oren_list_push(ranges, [prev, prev])
                }
                prev = cc
                i = i + 1
            }
            if prev != -1 {
                oren_list_push(ranges, [prev, prev])
            }
            if i >= n || bs[i] != 93 { return _err("unterminated []") }
            // token encoding: 2000 + neg flag, then count, then ranges pairs
            oren_list_push(out, 2000 + neg)
            oren_list_push(out, oren_list_len(ranges))
            var ri = 0
            while ri < oren_list_len(ranges) {
                oren_list_push(out, ranges[ri][0])
                oren_list_push(out, ranges[ri][1])
                ri = ri + 1
            }
            natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] + 1
            i = i + 1
            continue
        }

        // anchors
        if c == 94 { // ^
            if natom[oren_list_len(natom)-1] > 1 {
                natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
                oren_list_push(out, 46)
            }
            oren_list_push(out, 3000) // bol
            natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] + 1
            i = i + 1
            continue
        }
        if c == 36 { // $
            if natom[oren_list_len(natom)-1] > 1 {
                natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
                oren_list_push(out, 46)
            }
            oren_list_push(out, 3001) // eol
            natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] + 1
            i = i + 1
            continue
        }

        // any '.'
        if c == 46 {
            if natom[oren_list_len(natom)-1] > 1 {
                natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
                oren_list_push(out, 46)
            }
            oren_list_push(out, 4000) // any token
            natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] + 1
            i = i + 1
            continue
        }

        // literal
        if natom[oren_list_len(natom)-1] > 1 {
            natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
            oren_list_push(out, 46)
        }
        oren_list_push(out, 1000 + c)
        natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] + 1
        i = i + 1
    }

    if esc { return _err("dangling escape") }

    while natom[oren_list_len(natom)-1] > 1 {
        natom[oren_list_len(natom)-1] = natom[oren_list_len(natom)-1] - 1
        oren_list_push(out, 46)
    }
    while nalt[oren_list_len(nalt)-1] > 0 {
        oren_list_push(out, 124)
        nalt[oren_list_len(nalt)-1] = nalt[oren_list_len(nalt)-1] - 1
    }
    if oren_list_len(natom) != 1 { return _err("unmatched (") }
    return _ok(out)
}

fn _post2nfa(post) {
    var states = []

    var stack = []
    var i = 0
    while i < oren_list_len(post) {
        var tok = post[i]
        if tok == 46 { // concat
            var e2 = stack[oren_list_len(stack)-1]
            stack = _slice(stack, 0, oren_list_len(stack)-1)
            var e1 = stack[oren_list_len(stack)-1]
            stack = _slice(stack, 0, oren_list_len(stack)-1)
            _patch(e1["out"], states, e2["start"])
            oren_list_push(stack, _frag(e1["start"], e2["out"]))
            i = i + 1
            continue
        }
        if tok == 124 { // alt
            var e4 = stack[oren_list_len(stack)-1]
            stack = _slice(stack, 0, oren_list_len(stack)-1)
            var e3 = stack[oren_list_len(stack)-1]
            stack = _slice(stack, 0, oren_list_len(stack)-1)
            var s = _state("split")
            oren_list_push(states, s)
            var si = oren_list_len(states) - 1
            states[si]["out"] = e3["start"]
            states[si]["out1"] = e4["start"]
            oren_list_push(stack, _frag(si, _append(e3["out"], e4["out"])))
            i = i + 1
            continue
        }
        if tok == 42 { // *
            var e = stack[oren_list_len(stack)-1]
            stack = _slice(stack, 0, oren_list_len(stack)-1)
            var s2 = _state("split")
            oren_list_push(states, s2)
            var si2 = oren_list_len(states) - 1
            states[si2]["out"] = e["start"]
            _patch(e["out"], states, si2)
            oren_list_push(stack, _frag(si2, _list1(si2, 1)))
            i = i + 1
            continue
        }
        if tok == 43 { // +
            var e5 = stack[oren_list_len(stack)-1]
            stack = _slice(stack, 0, oren_list_len(stack)-1)
            var s3 = _state("split")
            oren_list_push(states, s3)
            var si3 = oren_list_len(states) - 1
            states[si3]["out"] = e5["start"]
            _patch(e5["out"], states, si3)
            oren_list_push(stack, _frag(e5["start"], _list1(si3, 1)))
            i = i + 1
            continue
        }
        if tok == 63 { // ?
            var e6 = stack[oren_list_len(stack)-1]
            stack = _slice(stack, 0, oren_list_len(stack)-1)
            var s4 = _state("split")
            oren_list_push(states, s4)
            var si4 = oren_list_len(states) - 1
            states[si4]["out"] = e6["start"]
            oren_list_push(stack, _frag(si4, _append(e6["out"], _list1(si4, 1))))
            i = i + 1
            continue
        }
        if tok == 3000 {
            var st = _state("bol")
            oren_list_push(states, st)
            var si = oren_list_len(states) - 1
            oren_list_push(stack, _frag(si, _list1(si, 0)))
            i = i + 1
            continue
        }
        if tok == 3001 {
            var st2 = _state("eol")
            oren_list_push(states, st2)
            var si2 = oren_list_len(states) - 1
            oren_list_push(stack, _frag(si2, _list1(si2, 0)))
            i = i + 1
            continue
        }
        if tok == 4000 {
            var st3 = _state("any")
            oren_list_push(states, st3)
            var si3 = oren_list_len(states) - 1
            oren_list_push(stack, _frag(si3, _list1(si3, 0)))
            i = i + 1
            continue
        }
        if tok >= 2000 && tok < 3000 {
            var neg = tok - 2000
            var count = post[i+1]
            var ranges = []
            var ri = 0
            var base = i + 2
            while ri < count {
                var lo = post[base + ri*2]
                var hi = post[base + ri*2 + 1]
                oren_list_push(ranges, [lo, hi])
                ri = ri + 1
            }
            var stc = _state("class")
            stc["neg"] = neg
            stc["ranges"] = ranges
            oren_list_push(states, stc)
            var sic = oren_list_len(states) - 1
            oren_list_push(stack, _frag(sic, _list1(sic, 0)))
            i = base + count*2
            continue
        }
        if tok >= 1000 {
            var ch = tok - 1000
            var st4 = _state("char")
            st4["c"] = ch
            oren_list_push(states, st4)
            var si4 = oren_list_len(states) - 1
            oren_list_push(stack, _frag(si4, _list1(si4, 0)))
            i = i + 1
            continue
        }
        return _err("bad postfix token")
    }

    if oren_list_len(stack) != 1 { return _err("invalid regex") }
    var e = stack[0]
    var m = _state("match")
    oren_list_push(states, m)
    var mi = oren_list_len(states) - 1
    _patch(e["out"], states, mi)
    return _ok({"start": e["start"], "states": states})
}

fn compile(pattern) {
    var p = _re2post(pattern)
    if p["ok"] != 1 { return p }
    return _post2nfa(p["v"])
}

fn _class_match(st, b) {
    var ranges = st["ranges"]
    var i = 0
    var hit = false
    while ranges != nil && i < oren_list_len(ranges) {
        var lo = ranges[i][0]
        var hi = ranges[i][1]
        if b >= lo && b <= hi { hit = true; break }
        i = i + 1
    }
    if st["neg"] != 0 { return hit != true }
    return hit
}

fn _add_state(states, lst, si, visited, pos, endpos) {
    if si < 0 { return nil }
    if visited[si] == 1 { return nil }
    visited[si] = 1
    var st = states[si]
    var k = st["kind"]
    if k == "split" {
        _add_state(states, lst, st["out"], visited, pos, endpos)
        _add_state(states, lst, st["out1"], visited, pos, endpos)
        return nil
    }
    if k == "bol" {
        if pos == 0 { _add_state(states, lst, st["out"], visited, pos, endpos) }
        return nil
    }
    if k == "eol" {
        if pos == endpos { _add_state(states, lst, st["out"], visited, pos, endpos) }
        return nil
    }
    // normal consuming or match
    oren_list_push(lst, si)
    return nil
}

fn _step(nfa, clist, b, pos, endpos) {
    var states = nfa["states"]
    var nlist = []
    var visited = {}
    var i = 0
    while i < oren_list_len(clist) {
        var si = clist[i]
        var st = states[si]
        var k = st["kind"]
        if k == "char" {
            if b == st["c"] { _add_state(states, nlist, st["out"], visited, pos, endpos) }
        } else {
            if k == "any" {
                _add_state(states, nlist, st["out"], visited, pos, endpos)
            } else {
                if k == "class" {
                    if _class_match(st, b) { _add_state(states, nlist, st["out"], visited, pos, endpos) }
                }
            }
        }
        i = i + 1
    }
    return nlist
}

fn is_match_compiled(nfa, text) {
    var bs = oren_bytes_from_string(text)
    var n = oren_list_len(bs)

    // search anywhere: start simulation at each position.
    var startpos = 0
    while startpos <= n {
        var clist = []
        var visited = {}
        _add_state(nfa["states"], clist, nfa["start"], visited, startpos, n)
        var i = startpos
        while true {
            // check match state present
            var mi = 0
            while mi < oren_list_len(clist) {
                if nfa["states"][clist[mi]]["kind"] == "match" { return true }
                mi = mi + 1
            }
            if i >= n { break }
            clist = _step(nfa, clist, bs[i], i + 1, n)
            i = i + 1
            if oren_list_len(clist) == 0 { break }
        }
        // one more check at end
        var mi2 = 0
        while mi2 < oren_list_len(clist) {
            if nfa["states"][clist[mi2]]["kind"] == "match" { return true }
            mi2 = mi2 + 1
        }
        startpos = startpos + 1
    }
    return false
}

fn is_match(pattern, text) {
    var r = compile(pattern)
    if r["ok"] != 1 { return false }
    return is_match_compiled(r["v"], text)
}
