// std/cbor (rolling)
//
// RFC 8949: docs/refs/cbor/rfc8949.txt (audit reference)
// CBOR Sequences (streaming): RFC 8742 docs/refs/cbor/rfc8742.txt (audit reference)
//
// Goal:
// - Deterministic and portable CBOR encode/decode across backends.
// - Keep representation explicit (tagged) like std/json.oren so we don't depend on
//   runtime type introspection.
//
// CborValue shape (map):
//   {"t":"null"}
//   {"t":"bool","b":0|1}                  // b is int for cross-backend stability
//   {"t":"int","i":<int>}
//   {"t":"bytes","bs": bytes}                 // list<int> or u8_buf
//   {"t":"string","s":<string>}
//   {"t":"array","a":[CborValue...]}
//   {"t":"map","m":{ string_key: CborValue, ... }}
//
// Canonical encoding:
// - definite-length only
// - maps are encoded with canonical key ordering (RFC 8949 §4.2.1):
//     sort keys by (byte length, then bytewise lexicographic)

import list "std:list"

struct CborValue {
    t,
    b,
    i,
    bs,
    s,
    a,
    m
}

fn cnull(): CborValue { return {"t": "null"} }
fn _bool_int01(b) {
    if b == true { return 1 }
    if b == 1 { return 1 }
    return 0
}

fn cbool(b): CborValue { return {"t": "bool", "b": _bool_int01(b)} }
fn cint(i): CborValue { return {"t": "int", "i": i} }
fn cbytes(bs): CborValue { return {"t": "bytes", "bs": bs} }
fn cstring(s): CborValue { return {"t": "string", "s": s} }
fn carray(a): CborValue { return {"t": "array", "a": a} }
fn cmap(m): CborValue { return {"t": "map", "m": m} }

trait CborBytes {
    fn cbor(self): CborValue;
}

trait CborValueCodec {
    fn bytes(self): bytes;
}

fn _byte_at(s, i) {
    return oren_string_byte_at_unchecked(s, i) & 255
}

fn _streq(a, b) {
    if a == nil || b == nil { return false }
    var al = oren_string_len(a)
    var bl = oren_string_len(b)
    if al != bl { return false }
    var i = 0
    while i < al {
        if _byte_at(a, i) != _byte_at(b, i) { return false }
        i = i + 1
    }
    return true
}

fn _err(msg, pos) {
    return {"ok": 0, "err": msg, "pos": pos}
}

fn _ok(v, pos) {
    return {"ok": 1, "v": v, "pos": pos}
}

fn _push_u8(out, b) { list.push(out, b & 255) }

fn _bytes_len(bs) {
    var n = oren_bytes_len(bs)
    if n == nil || oren_is_err(n) { return -1 }
    return n
}

fn _bytes_get(bs, i) {
    return oren_bytes_get_u8(bs, i) & 255
}

fn _push_u16be(out, n) {
    _push_u8(out, (n >> 8) & 255)
    _push_u8(out, n & 255)
}

fn _push_u32be(out, n) {
    _push_u8(out, (n >> 24) & 255)
    _push_u8(out, (n >> 16) & 255)
    _push_u8(out, (n >> 8) & 255)
    _push_u8(out, n & 255)
}

fn _push_u64be(out, n) {
    // Rolling: Oren int is assumed to be at least 64-bit signed for now.
    var i = 7
    while i >= 0 {
        _push_u8(out, (n >> (i * 8)) & 255)
        i = i - 1
    }
}

fn _emit_uint(out, major, n) {
    // Emit major type + uint argument using the shortest definite-length form.
    if n < 0 { n = 0 }
    if n < 24 {
        _push_u8(out, (major << 5) | (n & 31))
        return nil
    }
    if n < 256 {
        _push_u8(out, (major << 5) | 24)
        _push_u8(out, n)
        return nil
    }
    if n < 65536 {
        _push_u8(out, (major << 5) | 25)
        _push_u16be(out, n)
        return nil
    }
    // Prefer 32-bit unless a 64-bit payload is needed.
    // NOTE: we avoid unsigned > 2^31-1 in v0 tests; still, keep 64-bit path.
    if n < 4294967296 {
        _push_u8(out, (major << 5) | 26)
        _push_u32be(out, n)
        return nil
    }
    _push_u8(out, (major << 5) | 27)
    _push_u64be(out, n)
    return nil
}

fn _key_lt(a, b) {
    // Canonical map key ordering (RFC 8949 §4.2.1): length, then bytewise.
    if a == nil { a = "" }
    if b == nil { b = "" }
    var al = oren_string_len(a)
    var bl = oren_string_len(b)
    if al < bl { return true }
    if al > bl { return false }
    var i = 0
    while i < al {
        var av = _byte_at(a, i)
        var bv = _byte_at(b, i)
        if av < bv { return true }
        if av > bv { return false }
        i = i + 1
    }
    return false
}

fn _sort_keys_canonical(keys) {
    // Insertion sort (small N typical; deterministic).
    var i = 1
    while i < list.len(keys) {
        var k = keys[i]
        var j = i - 1
        while j >= 0 && _key_lt(k, keys[j]) {
            keys[j + 1] = keys[j]
            j = j - 1
        }
        keys[j + 1] = k
        i = i + 1
    }
    return keys
}

fn _encode_value(out, v) {
    var t = v["t"]
    if _streq(t, "null") {
        _push_u8(out, 246) // 0xf6 null
        return nil
    }
    if _streq(t, "bool") {
        if _bool_int01(v["b"]) == 1 { _push_u8(out, 245) } // 0xf5 true
        else { _push_u8(out, 244) }                       // 0xf4 false
        return nil
    }
    if _streq(t, "int") {
        var i = v["i"]
        if i >= 0 {
            _emit_uint(out, 0, i) // major 0 unsigned
        } else {
            var u = (-1 - i)
            _emit_uint(out, 1, u) // major 1 negative
        }
        return nil
    }
    if _streq(t, "bytes") {
        var bs = v["bs"]
        var bn = _bytes_len(bs)
        if bn < 0 { bn = 0 }
        _emit_uint(out, 2, bn) // major 2 byte string
        var bi = 0
        while bi < bn {
            _push_u8(out, _bytes_get(bs, bi))
            bi = bi + 1
        }
        return nil
    }
    if _streq(t, "string") {
        var s = v["s"]
        if s == nil { s = "" }
        var sn = oren_string_len(s)
        _emit_uint(out, 3, sn) // major 3 text string (utf-8 bytes)
        var si = 0
        while si < sn {
            _push_u8(out, _byte_at(s, si))
            si = si + 1
        }
        return nil
    }
    if _streq(t, "array") {
        var a = v["a"]
        _emit_uint(out, 4, list.len(a))
        var i4 = 0
        while i4 < list.len(a) {
            _encode_value(out, a[i4])
            i4 = i4 + 1
        }
        return nil
    }
    if _streq(t, "map") {
        var m = v["m"]
        // Collect keys then sort canonically.
        var keys = []
        for k in m {
            list.push(keys, k)
        }
        _sort_keys_canonical(keys)
        _emit_uint(out, 5, list.len(keys))
        var i5 = 0
        while i5 < list.len(keys) {
            var k2 = keys[i5]
            _encode_value(out, cstring(k2))
            _encode_value(out, oren_map_get_str(m, k2))
            i5 = i5 + 1
        }
        return nil
    }
    // Unknown tag: encode as null (rolling safety).
    _push_u8(out, 246)
    return nil
}

fn encode(v): bytes {
    var out = []
    _encode_value(out, v)
    return out
}

fn _need(bs, pos, n) {
    var bn = _bytes_len(bs)
    if bn < 0 { return 0 }
    if pos + n > bn { return 0 }
    return 1
}

fn _read_u16be(bs, pos) {
    return (_bytes_get(bs, pos) << 8) | _bytes_get(bs, pos + 1)
}

fn _read_u32be(bs, pos) {
    return (_bytes_get(bs, pos) << 24) |
        (_bytes_get(bs, pos + 1) << 16) |
        (_bytes_get(bs, pos + 2) << 8) |
        _bytes_get(bs, pos + 3)
}

fn _read_u64be(bs, pos) {
    var v = 0
    var i = 0
    while i < 8 {
        v = (v << 8) | _bytes_get(bs, pos + i)
        i = i + 1
    }
    return v
}

fn _read_uint_arg(bs, pos, ai) {
    // Returns {"ok":1,"n":<uint>,"pos":newpos} or err
    if ai < 24 { return {"ok": 1, "n": ai, "pos": pos} }
    if ai == 24 {
        if _need(bs, pos, 1) != 1 { return _err("unexpected EOF", pos) }
        return {"ok": 1, "n": _bytes_get(bs, pos), "pos": pos + 1}
    }
    if ai == 25 {
        if _need(bs, pos, 2) != 1 { return _err("unexpected EOF", pos) }
        return {"ok": 1, "n": _read_u16be(bs, pos), "pos": pos + 2}
    }
    if ai == 26 {
        if _need(bs, pos, 4) != 1 { return _err("unexpected EOF", pos) }
        return {"ok": 1, "n": _read_u32be(bs, pos), "pos": pos + 4}
    }
    if ai == 27 {
        if _need(bs, pos, 8) != 1 { return _err("unexpected EOF", pos) }
        return {"ok": 1, "n": _read_u64be(bs, pos), "pos": pos + 8}
    }
    return _err("unsupported additional info", pos)
}

fn _decode_value(bs, pos) {
    var n = _bytes_len(bs)
    if n < 0 { return _err("input must be bytes", pos) }
    if pos >= n { return _err("unexpected EOF", pos) }
    var b = _bytes_get(bs, pos)
    pos = pos + 1
    var major = (b >> 5) & 7
    var ai = b & 31

    // Simple values (major 7) we need (false/true/null).
    if major == 7 {
        if ai == 20 { return _ok(cbool(0), pos) } // false
        if ai == 21 { return _ok(cbool(1), pos) } // true
        if ai == 22 { return _ok(cnull(), pos) }  // null
        return _err("unsupported simple value", pos - 1)
    }

    var r = _read_uint_arg(bs, pos, ai)
    if r["ok"] != 1 { return r }
    var arg = r["n"]
    pos = r["pos"]

    if major == 0 {
        return _ok(cint(arg), pos)
    }
    if major == 1 {
        // negative: -1 - n
        return _ok(cint(-1 - arg), pos)
    }
    if major == 2 {
        // bytes
        if _need(bs, pos, arg) != 1 { return _err("unexpected EOF in bytes", pos) }
        var out = oren_u8_buf_from_bytes_slice(bs, pos, arg)
        if out == nil || oren_is_err(out) { return _err("bytes slice failed", pos) }
        return _ok(cbytes(out), pos + arg)
    }
    if major == 3 {
        // text
        if _need(bs, pos, arg) != 1 { return _err("unexpected EOF in string", pos) }
        var s = oren_string_from_bytes_slice(bs, pos, arg)
        if s == nil || oren_is_err(s) { return _err("string_from_bytes failed", pos) }
        return _ok(cstring(s), pos + arg)
    }
    if major == 4 {
        // array
        var items = []
        var i4 = 0
        var p2 = pos
        while i4 < arg {
            var rv = _decode_value(bs, p2)
            if rv["ok"] != 1 { return rv }
            list.push(items, rv["v"])
            p2 = rv["pos"]
            i4 = i4 + 1
        }
        return _ok(carray(items), p2)
    }
    if major == 5 {
        // map (string keys only in v0)
        var m = {}
        var i5 = 0
        var p3 = pos
        while i5 < arg {
            var rk = _decode_value(bs, p3)
            if rk["ok"] != 1 { return rk }
            if rk["v"]["t"] != "string" { return _err("map key must be string", p3) }
            var key = rk["v"]["s"]
            var rv2 = _decode_value(bs, rk["pos"])
            if rv2["ok"] != 1 { return rv2 }
            oren_map_set_str(m, key, rv2["v"])
            p3 = rv2["pos"]
            i5 = i5 + 1
        }
        return _ok(cmap(m), p3)
    }
    return _err("unsupported major type", pos - 1)
}

fn decode(bs) {
    var r = _decode_value(bs, 0)
    if r["ok"] != 1 { return r }
    if r["pos"] != _bytes_len(bs) {
        return _err("trailing input", r["pos"])
    }
    return r
}

fn _decode_err(r) {
    var msg = r["err"]
    if msg == nil || msg == "" { msg = "cbor decode failed" }
    return oren_err(4, msg)
}

fn parse(bs): CborValue {
    var r = decode(bs)
    if r["ok"] == 1 { return r["v"] }
    return _decode_err(r)
}

fn bytes(v: CborValue): bytes { return encode(v) }

impl CborBytes for bytes {
    fn cbor(self): CborValue { return parse(self) }
}

impl CborValueCodec for CborValue {
    fn bytes(self): bytes { return encode(self) }
}

// Streaming / sequence API (RFC 8742)
//
// A CBOR sequence is a concatenation of 1+ CBOR items. This is the CBOR-native
// way to stream without wrapping everything in a top-level array.
//
// We expose a "decode next" primitive so higher-level IO can incrementally
// parse from buffers, and a convenience decode_sequence for whole buffers.

fn decode_next(bs, pos) {
    // Returns {"ok":1,"v":CborValue,"pos":newpos} or {"ok":0,"err":...,"pos":...}.
    if oren_type_tag(pos) == 0 { pos = 0 }
    return _decode_value(bs, pos)
}

fn next(bs, pos) {
    var r = decode_next(bs, pos)
    if r["ok"] == 1 {
        return {"v": r["v"], "pos": r["pos"]}
    }
    return _decode_err(r)
}

fn decode_sequence(bs) {
    var out = []
    var pos = 0
    var n = _bytes_len(bs)
    if n < 0 { return _err("input must be bytes", pos) }
    while pos < n {
        var r = _decode_value(bs, pos)
        if r["ok"] != 1 { return r }
        list.push(out, r["v"])
        pos = r["pos"]
    }
    return {"ok": 1, "v": out, "pos": pos}
}

fn sequence(bs) {
    var r = decode_sequence(bs)
    if r["ok"] == 1 { return r["v"] }
    return _decode_err(r)
}

fn encode_sequence(items) {
    var out = []
    if items != nil { for it in items { _encode_value(out, it) } }
    return out
}

// Typed helpers for serde-generated encode/decode functions.
//
// These helpers make it easy to build streaming protocols using the compiler-generated
// `<Type>__cbor_encode` / `<Type>__cbor_decode` helpers without reimplementing sequence loops.
//
// Example:
//   var bs = cbor.encode_sequence_typed(users, User__cbor_encode)
//   var r = cbor.decode_sequence_typed(bs, User__cbor_decode)

fn encode_sequence_typed(items, encode_fn) {
    // encode_fn: T -> CborValue
    var cvs = []
    if items != nil {
        for it2 in items {
            var cv = encode_fn(it2)
            list.push(cvs, cv)
        }
    }
    return encode_sequence(cvs)
}

fn decode_next_typed(bs, pos, decode_fn) {
    // decode_fn: CborValue -> {ok, err?, v?}
    var r = decode_next(bs, pos)
    if r["ok"] != 1 { return r }
    var rr = decode_fn(r["v"])
    if rr["ok"] != 1 {
        return {"ok": 0, "err": rr["err"], "pos": r["pos"]}
    }
    return {"ok": 1, "v": rr["v"], "pos": r["pos"]}
}

fn next_typed(bs, pos, decode_fn) {
    var r = decode_next_typed(bs, pos, decode_fn)
    if r["ok"] == 1 {
        return {"v": r["v"], "pos": r["pos"]}
    }
    return _decode_err(r)
}

fn decode_sequence_typed(bs, decode_fn) {
    var out = []
    var pos = 0
    var n = _bytes_len(bs)
    if n < 0 { return _err("input must be bytes", pos) }
    while pos < n {
        var r = decode_next_typed(bs, pos, decode_fn)
        if r["ok"] != 1 { return r }
        list.push(out, r["v"])
        pos = r["pos"]
    }
    return {"ok": 1, "v": out, "pos": pos}
}

fn sequence_typed(bs, decode_fn) {
    var r = decode_sequence_typed(bs, decode_fn)
    if r["ok"] == 1 { return r["v"] }
    return _decode_err(r)
}
