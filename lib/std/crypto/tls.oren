// std/crypto/tls (rolling v0)
//
// This module is a **crypto-facing facade** over the existing socket-oriented TLS API
// in `std:net/tls`.
//
// Rationale (rolling):
// - TLS is primarily a crypto protocol (certs, handshake, key schedule, record protection),
//   but it is exercised through IO.
// - Today, Oren’s TLS implementation lives under `std:net/tls` because it directly wraps TCP fds.
// - Long-term, the intended direction is:
//     - `std:crypto/tls_*` (core handshake + record layer over an abstract IO trait),
//     - `std:net/tls` (socket integration + convenience dialing; depends on crypto core).
//
// Until that split lands, `std:crypto/tls` provides a stable import path for callers that
// conceptually want “TLS is crypto”, while keeping existing tests and stdlib (HTTP/WS)
// on the proven `std:net/tls` implementation.
//
// API surface mirrors `std:net/tls`: public functions and receiver methods return
// values or `oren_err`; raw syscall-style operations stay under explicit
// `std:net/tls` internals.

import tls "std:net/tls"

struct Conn {
    fd,
    ssl,
    ctx,
    mode
}

trait TlsConn {
    fn read_into(self, buf, cap, timeout_ms);
    fn write_from(self, ptr0, len, timeout_ms);
    fn close(self);
    fn peer_cert_sha256_hex(self);
    fn negotiated_alpn(self);
}

fn connect(host_or_ip, port, timeout_ms, opts) {
    return tls.connect(host_or_ip, port, timeout_ms, opts)
}

fn wrap_client(fd, server_name, timeout_ms, opts) {
    return tls.wrap_client(fd, server_name, timeout_ms, opts)
}

fn wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts) {
    return tls.wrap_server_pkcs12(fd, timeout_ms, pkcs12_bytes, passphrase, opts)
}

fn read_into(conn, buf, cap, timeout_ms) {
    return tls.read_into(conn, buf, cap, timeout_ms)
}

fn write_from(conn, ptr0, len, timeout_ms) {
    return tls.write_from(conn, ptr0, len, timeout_ms)
}

fn close(conn) {
    return tls.close(conn)
}

fn peer_cert_sha256_hex(conn) {
    return tls.peer_cert_sha256_hex(conn)
}

fn negotiated_alpn(conn) {
    return tls.negotiated_alpn(conn)
}

fn win_cleanup() {
    // Mirrors `std:net/tls.win_cleanup` for callers that treat TLS as a crypto concern.
    return tls.win_cleanup()
}

impl TlsConn for Conn {
    fn read_into(self, buf, cap, timeout_ms) { return read_into(self, buf, cap, timeout_ms) }
    fn write_from(self, ptr0, len, timeout_ms) { return write_from(self, ptr0, len, timeout_ms) }
    fn close(self) { return close(self) }
    fn peer_cert_sha256_hex(self) { return peer_cert_sha256_hex(self) }
    fn negotiated_alpn(self) { return negotiated_alpn(self) }
}
