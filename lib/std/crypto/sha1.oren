// SHA-1 (pure Oren, rolling)
//
// Scope:
// - Deterministic, correctness-first SHA-1 for workflows that need it (WebSocket handshake, etc).
// - Not optimized; avoid using this in hot perf paths until we have profiling + SIMD plans.
//
// Canonical API:
// - `digest(input_bytes)` / `input_bytes.sha1()` -> BYTES (len=20)
// - `hex(input_bytes)` / `input_bytes.sha1_hex()` -> lowercase hex string
// - `try_digest(...)` / `try_hex(...)` validate byte-like inputs and return `oren_err`.

import list "std:list"
import bytesm "std:bytes"

trait Sha1Bytes {
    fn sha1(self): bytes;
    fn sha1_hex(self);
}

fn _input_bytes_or_err(input_bytes, ctx) {
    if input_bytes == nil { return oren_bytes_pack([]) }
    var n = bytesm.try_len(input_bytes)
    if oren_is_err(n) {
        return oren_err(4, ctx + ": expected list<int 0..255> or u8_buf")
    }
    var i = 0
    while i < n {
        var b = bytesm.try_get_u8(input_bytes, i)
        if oren_is_err(b) {
            return oren_err(4, ctx + ": expected list<int 0..255> or u8_buf")
        }
        i = i + 1
    }
    return input_bytes
}

fn _u32(x) { return x & 4294967295 } // 0xFFFFFFFF

fn _rotl32(x, n) {
    x = _u32(x)
    if n == 0 { return x }
    var a = _u32(x << n)
    var b = _u32(x >> (32 - n))
    return _u32(a | b)
}

fn _padded_len(orig_len) {
    var total = orig_len + 1 + 8
    var rem = total % 64
    if rem != 0 { total = total + (64 - rem) }
    return total
}

fn _padded_byte_at(input_bytes, orig_len, bit_len, pos) {
    if pos < orig_len { return bytesm.try_get_u8(input_bytes, pos) }
    if pos == orig_len { return 128 }
    var len_start = _padded_len(orig_len) - 8
    if pos < len_start { return 0 }
    var shift = (7 - (pos - len_start)) * 8
    return (bit_len >> shift) & 255
}

fn _u32_be_at(input_bytes, orig_len, bit_len, pos) {
    var b0 = _padded_byte_at(input_bytes, orig_len, bit_len, pos + 0) & 255
    var b1 = _padded_byte_at(input_bytes, orig_len, bit_len, pos + 1) & 255
    var b2 = _padded_byte_at(input_bytes, orig_len, bit_len, pos + 2) & 255
    var b3 = _padded_byte_at(input_bytes, orig_len, bit_len, pos + 3) & 255
    return _u32((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
}

fn _push_u32_be(out, x) {
    x = _u32(x)
    list.push(out, (x >> 24) & 255)
    list.push(out, (x >> 16) & 255)
    list.push(out, (x >> 8) & 255)
    list.push(out, x & 255)
    return nil
}

fn sha1_bytes(input_bytes) {
    // Returns BYTES (len=20).
    if input_bytes == nil {
        input_bytes = oren_bytes_pack([])
    }

    var orig_len = bytesm.try_len(input_bytes)
    if oren_is_err(orig_len) { return orig_len }
    var bit_len = orig_len * 8
    var total_len = _padded_len(orig_len)

    // Initial hash values
    var h0 = 1732584193  // 0x67452301
    var h1 = 4023233417  // 0xEFCDAB89
    var h2 = 2562383102  // 0x98BADCFE
    var h3 = 271733878   // 0x10325476
    var h4 = 3285377520  // 0xC3D2E1F0

    var off = 0
    while off < total_len {
        // message schedule
        var w = []
        var t = 0
        while t < 16 {
            list.push(w, _u32_be_at(input_bytes, orig_len, bit_len, off + t * 4))
            t = t + 1
        }
        while t < 80 {
            var v = w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]
            list.push(w, _rotl32(v, 1))
            t = t + 1
        }

        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4

        t = 0
        while t < 80 {
            var f = 0
            var k = 0
            if t < 20 {
                f = (b & c) | ((~b) & d)
                k = 1518500249  // 0x5A827999
            } else if t < 40 {
                f = b ^ c ^ d
                k = 1859775393  // 0x6ED9EBA1
            } else if t < 60 {
                f = (b & c) | (b & d) | (c & d)
                k = 2400959708  // 0x8F1BBCDC
            } else {
                f = b ^ c ^ d
                k = 3395469782  // 0xCA62C1D6
            }

            var temp = _u32(_rotl32(a, 5) + _u32(f) + e + k + w[t])
            e = d
            d = c
            c = _rotl32(b, 30)
            b = a
            a = temp
            t = t + 1
        }

        h0 = _u32(h0 + a)
        h1 = _u32(h1 + b)
        h2 = _u32(h2 + c)
        h3 = _u32(h3 + d)
        h4 = _u32(h4 + e)

        off = off + 64
    }

    var out = []
    _push_u32_be(out, h0)
    _push_u32_be(out, h1)
    _push_u32_be(out, h2)
    _push_u32_be(out, h3)
    _push_u32_be(out, h4)
    return oren_bytes_pack(out)
}

fn sha1_hex(input_bytes) {
    return oren_bytes_to_hex(sha1_bytes(input_bytes))
}

fn digest(input_bytes): bytes { return sha1_bytes(input_bytes) }

fn hex(input_bytes) { return sha1_hex(input_bytes) }

fn try_sha1_bytes(input_bytes) {
    var checked = _input_bytes_or_err(input_bytes, "sha1.try_sha1_bytes")
    if oren_is_err(checked) { return checked }
    return sha1_bytes(checked)
}

fn try_sha1_hex(input_bytes) {
    var d = try_sha1_bytes(input_bytes)
    if oren_is_err(d) { return d }
    return oren_bytes_to_hex(d)
}

fn try_digest(input_bytes): bytes { return try_sha1_bytes(input_bytes) }

fn try_hex(input_bytes) { return try_sha1_hex(input_bytes) }

impl Sha1Bytes for bytes {
    fn sha1(self): bytes { return digest(self) }
    fn sha1_hex(self) { return hex(self) }
}
