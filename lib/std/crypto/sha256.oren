// SHA-256 (pure Oren, rolling)
//
// Goal: provide a crypto primitive that can run inside AVM bytecode without FFI/libc.
// Byte-native list/u8_buf and string inputs share one compression path without materializing strings.
//
// Canonical API:
// - `digest(input_bytes)` / `input_bytes.sha256()` -> BYTES (len=32)
// - `hex(input_bytes)` / `input_bytes.sha256_hex()` -> lowercase hex string
// - `digest_string(s)` / `hex_string(s)` hash UTF-8 string bytes directly.

import list "std:list"
import bytesm "std:bytes"
import raw "std:buffer/raw"

trait Sha256Bytes {
    fn sha256(self): bytes;
    fn sha256_hex(self);
}

var _SHA256_K = nil

fn _input_view_or_err(input_bytes, ctx) {
    if input_bytes == nil { input_bytes = oren_u8_buf_new(0) }
    var v = bytesm.view(input_bytes, ctx)
    if oren_is_err(v) {
        return oren_err(4, ctx + ": expected list<int 0..255> or u8_buf")
    }
    return [0, v, bytesm.view_len(v), ctx]
}

fn _string_view_or_err(s, ctx) {
    if s == nil { s = "" }
    if oren_type_tag(s) != 4 { return oren_err(4, ctx + ": expected string") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return n }
    return [1, s, n, ctx]
}

fn _source_len(input_view) { return input_view[2] }

fn _source_get_u8_unchecked(input_view, pos) {
    if input_view[0] == 1 { return oren_string_byte_at_unchecked(input_view[1], pos) & 255 }
    return bytesm.view_get_u8_unchecked(input_view[1], pos)
}

fn _u32(x) { return x & 4294967295 } // 0xFFFFFFFF

fn _rotr32(x, n) {
    x = _u32(x)
    // n in [0..31]
    if n == 0 { return x }
    var a = (x >> n)
    var b = _u32(x << (32 - n))
    return _u32(a | b)
}

fn _shr32(x, n) {
    x = _u32(x)
    return _u32(x >> n)
}

fn _ch(x, y, z) { return _u32((x & y) ^ ((~x) & z)) }
fn _maj(x, y, z) { return _u32((x & y) ^ (x & z) ^ (y & z)) }
fn _bsig0(x) { return _u32(_rotr32(x, 2) ^ _rotr32(x, 13) ^ _rotr32(x, 22)) }
fn _bsig1(x) { return _u32(_rotr32(x, 6) ^ _rotr32(x, 11) ^ _rotr32(x, 25)) }
fn _ssig0(x) { return _u32(_rotr32(x, 7) ^ _rotr32(x, 18) ^ _shr32(x, 3)) }
fn _ssig1(x) { return _u32(_rotr32(x, 17) ^ _rotr32(x, 19) ^ _shr32(x, 10)) }

fn _padded_len(orig_len) {
    var total = orig_len + 1 + 8
    var rem = total % 64
    if rem != 0 { total = total + (64 - rem) }
    return total
}

fn _padded_byte_at(input_view, orig_len, bit_len, pos) {
    if pos < orig_len {
        return _source_get_u8_unchecked(input_view, pos)
    }
    if pos == orig_len { return 128 }
    var len_start = _padded_len(orig_len) - 8
    if pos < len_start { return 0 }
    var shift = (7 - (pos - len_start)) * 8
    return (bit_len >> shift) & 255
}

fn _u32_be_at(input_view, orig_len, bit_len, pos) {
    var b0 = _padded_byte_at(input_view, orig_len, bit_len, pos + 0)
    if oren_is_err(b0) { return b0 }
    var b1 = _padded_byte_at(input_view, orig_len, bit_len, pos + 1)
    if oren_is_err(b1) { return b1 }
    var b2 = _padded_byte_at(input_view, orig_len, bit_len, pos + 2)
    if oren_is_err(b2) { return b2 }
    var b3 = _padded_byte_at(input_view, orig_len, bit_len, pos + 3)
    if oren_is_err(b3) { return b3 }
    b0 = b0 & 255
    b1 = b1 & 255
    b2 = b2 & 255
    b3 = b3 & 255
    return _u32((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
}

fn _store_u32_be(out, off, x) {
    x = _u32(x)
    raw._store_u8_buf_unchecked_direct(out, off + 0, (x >> 24) & 255)
    raw._store_u8_buf_unchecked_direct(out, off + 1, (x >> 16) & 255)
    raw._store_u8_buf_unchecked_direct(out, off + 2, (x >> 8) & 255)
    raw._store_u8_buf_unchecked_direct(out, off + 3, x & 255)
    return off + 4
}

fn _round_constants() {
    if _SHA256_K != nil { return _SHA256_K }
    var k = list.int_new(64)
    list.int_push(k, 1116352408)
    list.int_push(k, 1899447441)
    list.int_push(k, 3049323471)
    list.int_push(k, 3921009573)
    list.int_push(k, 961987163)
    list.int_push(k, 1508970993)
    list.int_push(k, 2453635748)
    list.int_push(k, 2870763221)
    list.int_push(k, 3624381080)
    list.int_push(k, 310598401)
    list.int_push(k, 607225278)
    list.int_push(k, 1426881987)
    list.int_push(k, 1925078388)
    list.int_push(k, 2162078206)
    list.int_push(k, 2614888103)
    list.int_push(k, 3248222580)
    list.int_push(k, 3835390401)
    list.int_push(k, 4022224774)
    list.int_push(k, 264347078)
    list.int_push(k, 604807628)
    list.int_push(k, 770255983)
    list.int_push(k, 1249150122)
    list.int_push(k, 1555081692)
    list.int_push(k, 1996064986)
    list.int_push(k, 2554220882)
    list.int_push(k, 2821834349)
    list.int_push(k, 2952996808)
    list.int_push(k, 3210313671)
    list.int_push(k, 3336571891)
    list.int_push(k, 3584528711)
    list.int_push(k, 113926993)
    list.int_push(k, 338241895)
    list.int_push(k, 666307205)
    list.int_push(k, 773529912)
    list.int_push(k, 1294757372)
    list.int_push(k, 1396182291)
    list.int_push(k, 1695183700)
    list.int_push(k, 1986661051)
    list.int_push(k, 2177026350)
    list.int_push(k, 2456956037)
    list.int_push(k, 2730485921)
    list.int_push(k, 2820302411)
    list.int_push(k, 3259730800)
    list.int_push(k, 3345764771)
    list.int_push(k, 3516065817)
    list.int_push(k, 3600352804)
    list.int_push(k, 4094571909)
    list.int_push(k, 275423344)
    list.int_push(k, 430227734)
    list.int_push(k, 506948616)
    list.int_push(k, 659060556)
    list.int_push(k, 883997877)
    list.int_push(k, 958139571)
    list.int_push(k, 1322822218)
    list.int_push(k, 1537002063)
    list.int_push(k, 1747873779)
    list.int_push(k, 1955562222)
    list.int_push(k, 2024104815)
    list.int_push(k, 2227730452)
    list.int_push(k, 2361852424)
    list.int_push(k, 2428436474)
    list.int_push(k, 2756734187)
    list.int_push(k, 3204031479)
    list.int_push(k, 3329325298)
    _SHA256_K = k
    return k
}

fn _sha256_digest_view(input_view) {
    var orig_len = _source_len(input_view)
    var bit_len = orig_len * 8
    var total_len = _padded_len(orig_len)

    // Initial hash values
    var h0 = 1779033703
    var h1 = 3144134277
    var h2 = 1013904242
    var h3 = 2773480762
    var h4 = 1359893119
    var h5 = 2600822924
    var h6 = 528734635
    var h7 = 1541459225

    var K = _round_constants()

    var off = 0
    while off < total_len {
        // message schedule
        var w = list.int_new(64)
        var t = 0
        while t < 16 {
            var word = _u32_be_at(input_view, orig_len, bit_len, off + t * 4)
            if oren_is_err(word) { return oren_err(4, "sha256.digest: expected list<int 0..255> or u8_buf") }
            list.int_push(w, word)
            t = t + 1
        }
        while t < 64 {
            var v = _u32(_ssig1(list.int_get(w, t - 2)) + list.int_get(w, t - 7) + _ssig0(list.int_get(w, t - 15)) + list.int_get(w, t - 16))
            list.int_push(w, v)
            t = t + 1
        }

        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var f = h5
        var g = h6
        var h = h7

        t = 0
        while t < 64 {
            var t1 = _u32(h + _bsig1(e) + _ch(e, f, g) + list.int_get(K, t) + list.int_get(w, t))
            var t2 = _u32(_bsig0(a) + _maj(a, b, c))
            h = g
            g = f
            f = e
            e = _u32(d + t1)
            d = c
            c = b
            b = a
            a = _u32(t1 + t2)
            t = t + 1
        }

        h0 = _u32(h0 + a)
        h1 = _u32(h1 + b)
        h2 = _u32(h2 + c)
        h3 = _u32(h3 + d)
        h4 = _u32(h4 + e)
        h5 = _u32(h5 + f)
        h6 = _u32(h6 + g)
        h7 = _u32(h7 + h)

        off = off + 64
    }

    var out = oren_u8_buf_new_uninit(32)
    if oren_is_err(out) { return out }
    var out_off = 0
    out_off = _store_u32_be(out, out_off, h0)
    out_off = _store_u32_be(out, out_off, h1)
    out_off = _store_u32_be(out, out_off, h2)
    out_off = _store_u32_be(out, out_off, h3)
    out_off = _store_u32_be(out, out_off, h4)
    out_off = _store_u32_be(out, out_off, h5)
    out_off = _store_u32_be(out, out_off, h6)
    out_off = _store_u32_be(out, out_off, h7)
    return out
}

fn sha256_bytes(input_bytes) {
    // Returns BYTES (len=32).
    var input_view = _input_view_or_err(input_bytes, "sha256.digest")
    if oren_is_err(input_view) { return input_view }
    return _sha256_digest_view(input_view)
}

fn sha256_string(s) {
    var input_view = _string_view_or_err(s, "sha256.digest_string")
    if oren_is_err(input_view) { return input_view }
    return _sha256_digest_view(input_view)
}

fn sha256_hex(input_bytes) {
    var d = sha256_bytes(input_bytes)
    if oren_is_err(d) { return d }
    return bytesm.to_hex(d)
}

fn sha256_hex_string(s) {
    var d = sha256_string(s)
    if oren_is_err(d) { return d }
    return bytesm.to_hex(d)
}

fn digest(input_bytes): bytes { return sha256_bytes(input_bytes) }

fn hex(input_bytes) { return sha256_hex(input_bytes) }

fn digest_string(s): bytes { return sha256_string(s) }

fn hex_string(s) { return sha256_hex_string(s) }

impl Sha256Bytes for bytes {
    fn sha256(self): bytes { return digest(self) }
    fn sha256_hex(self) { return hex(self) }
}
