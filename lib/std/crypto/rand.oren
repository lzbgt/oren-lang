// Crypto-grade random bytes (host / native backend).
//
// This module provides a small, protocol-oriented entropy surface:
// - WebSocket client key and masking
// - future TLS (HTTPS/WSS) and session IDs
//
// Contract (v0):
// - `fill_raw(ptr, len)` fills `len` bytes at `ptr` and returns 0 on success, or -errno.
// - `fill(ptr, len)` returns 0 or `oren_err`.
// - `bytes(n)` returns BYTES (u8_buf) of length `n`, or `oren_err`.
//
// NOTE:
// - This is a host effect and is not intended for AVM deterministic execution.
// - Native runtime implementation: `oren_getentropy` (syscall/Win32 backed).

import result "std:result"

fn fill_raw(ptr, len) {
    if ptr == nil { return 0 - 14 } // EFAULT
    if oren_type_tag(len) == 0 { len = 0 }
    if len <= 0 { return 0 }
    return oren_getentropy(ptr, len)
}

fn fill(ptr, len) {
    return result.ok_or_errno(fill_raw(ptr, len), "rand.fill")
}

fn bytes(n) {
    if oren_type_tag(n) == 0 { n = 0 }
    if n < 0 { return oren_err(4, "rand.bytes: n < 0") }
    var out = oren_u8_buf_new_uninit(n)
    if oren_is_err(out) { return out }
    if n == 0 { return out }

    var p = native_buf_data_ptr(out)
    if p == 0 { return oren_err(12, "rand.bytes: bytes ptr nil") }
    var rc = oren_getentropy(p, n)
    if rc < 0 {
        return result.ok_or_errno(rc, "rand.bytes")
    }
    return out
}
