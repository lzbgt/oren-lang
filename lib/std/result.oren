// Minimal Result-style helpers for the rolling structured-error convention.
//
// Convention:
// - success: any non-error value
// - error: map {"__err": true, "code": int, "msg": string}

fn is_err(v) {
    if oren_is_err(v) { return true }
    return false
}

fn is_ok(v) {
    if oren_is_err(v) { return false }
    return true
}

fn unwrap(v) {
    if oren_is_err(v) {
        var msg = oren_err_msg(v)
        if msg != nil { print(msg) }
        oren_exit(1)
    }
    return v
}

fn unwrap_or(v, default_value) {
    if oren_is_err(v) { return default_value }
    return v
}

fn code(v) {
    if oren_is_err(v) { return oren_err_code(v) }
    return nil
}

fn msg(v) {
    if oren_is_err(v) { return oren_err_msg(v) }
    return nil
}

fn map_ok(v, f) {
    if oren_is_err(v) { return v }
    return f(v)
}

fn and_then(v, f) {
    if oren_is_err(v) { return v }
    return f(v)
}

fn map_err(v, f) {
    if oren_is_err(v) { return f(v) }
    return v
}

fn or_else(v, f) {
    if oren_is_err(v) { return f(v) }
    return v
}

fn from_ok_map(m) {
    if oren_is_err(m) { return m }
    if oren_type_name(m) != "map" { return oren_err(4, "result.from_ok_map: expects map") }
    var ok = m["ok"]
    if ok == true || ok == 1 { return m["v"] }
    if ok == false || ok == 0 {
        var code0 = m["code"]
        if oren_type_tag(code0) != 1 { code0 = 4 }
        var msg0 = m["msg"]
        if msg0 == nil { msg0 = m["err"] }
        if msg0 == nil || msg0 == "" { msg0 = "operation failed" }
        return oren_err(code0, msg0)
    }
    return oren_err(4, "result.from_ok_map: missing ok")
}

fn to_ok_map(v) {
    if oren_is_err(v) {
        return {"ok": 0, "code": oren_err_code(v), "err": oren_err_msg(v)}
    }
    return {"ok": 1, "v": v}
}

fn expect(v, message) {
    if oren_is_err(v) {
        if message != nil { print(message) }
        var msg = oren_err_msg(v)
        if msg != nil { print(msg) }
        oren_exit(1)
    }
    return v
}

fn with_context(v, context) {
    if oren_is_err(v) == false { return v }
    var ctx = context
    if ctx == nil || ctx == "" { return v }
    var code = oren_err_code(v)
    var msg = oren_err_msg(v)
    if msg == nil || msg == "" { return oren_err(code, ctx) }
    return oren_err(code, ctx + ": " + msg)
}

// --- errno / syscall helpers (rolling) ---
//
// Many syscall-first runtime APIs return:
//   - success: >= 0 (fd, byte count, etc)
//   - failure: negative errno (e.g. -12 for ENOMEM)
//
// These helpers convert that convention into the structured error map:
//   {"__err": true, "code": errno, "msg": "..."}
//
// Design:
// - Keep syscall wrappers cheap and low-level (they can keep returning -errno).
// - Provide library-level adapters for app code to opt into structured errors.

fn err(code, msg) {
    return oren_err(code, msg)
}

fn ok_or_errno(rc, context) {
    // If rc is a syscall-style return value:
    // - rc >= 0 => return rc
    // - rc < 0  => return structured error with code = -rc
    if rc >= 0 { return rc }
    var code = 0 - rc
    var ctx = context
    if ctx == nil { ctx = "syscall" }
    var msg = ctx + " failed (errno=" + oren_int_to_string(code) + ")"
    return oren_err(code, msg)
}

fn unwrap_errno(rc, context) {
    // Like ok_or_errno, but exits on error.
    return unwrap(ok_or_errno(rc, context))
}
