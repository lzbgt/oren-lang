import math "std:math"
import chk "std:math/mat4_checks"
import norms "std:math/mat4_norms"

fn _cell_index(row: int, column: int, ctx) {
    if row < 0 || row >= 4 || column < 0 || column >= 4 {
        return oren_err(4, ctx + ": index out of range")
    }
    return row * 4 + column
}

fn determinant(m) {
    var cm = chk._check(m, "mat4.determinant")
    if oren_is_err(cm) { return cm }
    var m0: f64 = m[0]
    var m1: f64 = m[1]
    var m2: f64 = m[2]
    var m3: f64 = m[3]
    var m4: f64 = m[4]
    var m5: f64 = m[5]
    var m6: f64 = m[6]
    var m7: f64 = m[7]
    var m8: f64 = m[8]
    var m9: f64 = m[9]
    var m10: f64 = m[10]
    var m11: f64 = m[11]
    var m12: f64 = m[12]
    var m13: f64 = m[13]
    var m14: f64 = m[14]
    var m15: f64 = m[15]
    var c0: f64 = m5 * m10 * m15
    c0 = c0 - m5 * m11 * m14
    c0 = c0 - m9 * m6 * m15
    c0 = c0 + m9 * m7 * m14
    c0 = c0 + m13 * m6 * m11
    c0 = c0 - m13 * m7 * m10
    var c1: f64 = 0.0 - m4 * m10 * m15
    c1 = c1 + m4 * m11 * m14
    c1 = c1 + m8 * m6 * m15
    c1 = c1 - m8 * m7 * m14
    c1 = c1 - m12 * m6 * m11
    c1 = c1 + m12 * m7 * m10
    var c2: f64 = m4 * m9 * m15
    c2 = c2 - m4 * m11 * m13
    c2 = c2 - m8 * m5 * m15
    c2 = c2 + m8 * m7 * m13
    c2 = c2 + m12 * m5 * m11
    c2 = c2 - m12 * m7 * m9
    var c3: f64 = 0.0 - m4 * m9 * m14
    c3 = c3 + m4 * m10 * m13
    c3 = c3 + m8 * m5 * m14
    c3 = c3 - m8 * m6 * m13
    c3 = c3 - m12 * m5 * m10
    c3 = c3 + m12 * m6 * m9
    var out: f64 = m0 * c0 + m1 * c1 + m2 * c2 + m3 * c3
    if !math.is_finite(out) { return oren_err(4, "mat4.determinant: non-finite") }
    return out
}

fn det(m) {
    return determinant(m)
}

fn is_invertible_abs(m, abs_tol: f64) {
    var det0 = determinant(m)
    if oren_is_err(det0) { return det0 }
    var det: f64 = det0
    var near_zero = chk._close_abs_scalar(det, 0.0, abs_tol, "mat4.is_invertible_abs")
    if oren_is_err(near_zero) { return near_zero }
    return !near_zero
}

fn is_invertible(m) {
    return is_invertible_abs(m, 0.0)
}

fn is_singular_abs(m, abs_tol: f64) {
    var inv = is_invertible_abs(m, abs_tol)
    if oren_is_err(inv) { return inv }
    return !inv
}

fn is_singular(m) {
    return is_singular_abs(m, 0.0)
}

fn _adjugate_checked(m, ctx) {
    var cm = chk._check(m, ctx)
    if oren_is_err(cm) { return cm }
    var m0: f64 = m[0]
    var m1: f64 = m[1]
    var m2: f64 = m[2]
    var m3: f64 = m[3]
    var m4: f64 = m[4]
    var m5: f64 = m[5]
    var m6: f64 = m[6]
    var m7: f64 = m[7]
    var m8: f64 = m[8]
    var m9: f64 = m[9]
    var m10: f64 = m[10]
    var m11: f64 = m[11]
    var m12: f64 = m[12]
    var m13: f64 = m[13]
    var m14: f64 = m[14]
    var m15: f64 = m[15]
    var inv0: f64 = m5 * m10 * m15 - m5 * m11 * m14 - m9 * m6 * m15 + m9 * m7 * m14 + m13 * m6 * m11 - m13 * m7 * m10
    var inv4: f64 = 0.0 - m4 * m10 * m15 + m4 * m11 * m14 + m8 * m6 * m15 - m8 * m7 * m14 - m12 * m6 * m11 + m12 * m7 * m10
    var inv8: f64 = m4 * m9 * m15 - m4 * m11 * m13 - m8 * m5 * m15 + m8 * m7 * m13 + m12 * m5 * m11 - m12 * m7 * m9
    var inv12: f64 = 0.0 - m4 * m9 * m14 + m4 * m10 * m13 + m8 * m5 * m14 - m8 * m6 * m13 - m12 * m5 * m10 + m12 * m6 * m9
    var inv1: f64 = 0.0 - m1 * m10 * m15 + m1 * m11 * m14 + m9 * m2 * m15 - m9 * m3 * m14 - m13 * m2 * m11 + m13 * m3 * m10
    var inv5: f64 = m0 * m10 * m15 - m0 * m11 * m14 - m8 * m2 * m15 + m8 * m3 * m14 + m12 * m2 * m11 - m12 * m3 * m10
    var inv9: f64 = 0.0 - m0 * m9 * m15 + m0 * m11 * m13 + m8 * m1 * m15 - m8 * m3 * m13 - m12 * m1 * m11 + m12 * m3 * m9
    var inv13: f64 = m0 * m9 * m14 - m0 * m10 * m13 - m8 * m1 * m14 + m8 * m2 * m13 + m12 * m1 * m10 - m12 * m2 * m9
    var inv2: f64 = m1 * m6 * m15 - m1 * m7 * m14 - m5 * m2 * m15 + m5 * m3 * m14 + m13 * m2 * m7 - m13 * m3 * m6
    var inv6: f64 = 0.0 - m0 * m6 * m15 + m0 * m7 * m14 + m4 * m2 * m15 - m4 * m3 * m14 - m12 * m2 * m7 + m12 * m3 * m6
    var inv10: f64 = m0 * m5 * m15 - m0 * m7 * m13 - m4 * m1 * m15 + m4 * m3 * m13 + m12 * m1 * m7 - m12 * m3 * m5
    var inv14: f64 = 0.0 - m0 * m5 * m14 + m0 * m6 * m13 + m4 * m1 * m14 - m4 * m2 * m13 - m12 * m1 * m6 + m12 * m2 * m5
    var inv3: f64 = 0.0 - m1 * m6 * m11 + m1 * m7 * m10 + m5 * m2 * m11 - m5 * m3 * m10 - m9 * m2 * m7 + m9 * m3 * m6
    var inv7: f64 = m0 * m6 * m11 - m0 * m7 * m10 - m4 * m2 * m11 + m4 * m3 * m10 + m8 * m2 * m7 - m8 * m3 * m6
    var inv11: f64 = 0.0 - m0 * m5 * m11 + m0 * m7 * m9 + m4 * m1 * m11 - m4 * m3 * m9 - m8 * m1 * m7 + m8 * m3 * m5
    var inv15: f64 = m0 * m5 * m10 - m0 * m6 * m9 - m4 * m1 * m10 + m4 * m2 * m9 + m8 * m1 * m6 - m8 * m2 * m5
    var out = [
        inv0, inv1, inv2, inv3,
        inv4, inv5, inv6, inv7,
        inv8, inv9, inv10, inv11,
        inv12, inv13, inv14, inv15
    ]
    var ok = chk._check(out, ctx)
    if oren_is_err(ok) { return ok }
    return out
}

fn adjugate(m) {
    return _adjugate_checked(m, "mat4.adjugate")
}

fn adjoint(m) {
    return adjugate(m)
}

fn cofactor(m, row_index: int, column_index: int) {
    var idx = _cell_index(row_index, column_index, "mat4.cofactor")
    if oren_is_err(idx) { return idx }
    var adj = _adjugate_checked(m, "mat4.cofactor")
    if oren_is_err(adj) { return adj }
    return adj[column_index * 4 + row_index]
}

fn minor3(m, row_index: int, column_index: int) {
    var c = cofactor(m, row_index, column_index)
    if oren_is_err(c) { return c }
    if (row_index + column_index) % 2 != 0 { return 0.0 - c }
    return c
}

fn minor(m, row_index: int, column_index: int) {
    return minor3(m, row_index, column_index)
}

fn inverse(m) {
    var adj = _adjugate_checked(m, "mat4.inverse")
    if oren_is_err(adj) { return adj }
    var det0 = determinant(m)
    if oren_is_err(det0) { return det0 }
    var det: f64 = det0
    if !math.is_finite(det) { return oren_err(4, "mat4.inverse: non-finite determinant") }
    if det == 0.0 { return oren_err(4, "mat4.inverse: singular") }
    var inv_det: f64 = 1.0 / det
    var out = []
    var i = 0
    while i < 16 {
        var v: f64 = adj[i]
        oren_list_push(out, v * inv_det)
        i = i + 1
    }
    var ok = chk._check(out, "mat4.inverse")
    if oren_is_err(ok) { return ok }
    return out
}

fn invert(m) {
    return inverse(m)
}

fn inverted(m) {
    return inverse(m)
}

fn condition_number_one(m) {
    var n0 = norms.norm_one(m)
    if oren_is_err(n0) { return n0 }
    var n: f64 = n0
    var inv = inverse(m)
    if oren_is_err(inv) { return inv }
    var inv_n0 = norms.norm_one(inv)
    if oren_is_err(inv_n0) { return inv_n0 }
    var inv_n: f64 = inv_n0
    var out: f64 = n * inv_n
    if !math.is_finite(out) { return oren_err(4, "mat4.condition_number_one: non-finite") }
    return out
}

fn cond_one(m) {
    return condition_number_one(m)
}

fn condition_number_inf(m) {
    var n0 = norms.norm_inf(m)
    if oren_is_err(n0) { return n0 }
    var n: f64 = n0
    var inv = inverse(m)
    if oren_is_err(inv) { return inv }
    var inv_n0 = norms.norm_inf(inv)
    if oren_is_err(inv_n0) { return inv_n0 }
    var inv_n: f64 = inv_n0
    var out: f64 = n * inv_n
    if !math.is_finite(out) { return oren_err(4, "mat4.condition_number_inf: non-finite") }
    return out
}

fn cond_inf(m) {
    return condition_number_inf(m)
}

fn inverse_affine(m) {
    var cm = chk._check(m, "mat4.inverse_affine")
    if oren_is_err(cm) { return cm }
    var m12: f64 = m[12]
    var m13: f64 = m[13]
    var m14: f64 = m[14]
    var m15: f64 = m[15]
    if m12 != 0.0 { return oren_err(4, "mat4.inverse_affine: expected affine bottom row") }
    if m13 != 0.0 { return oren_err(4, "mat4.inverse_affine: expected affine bottom row") }
    if m14 != 0.0 { return oren_err(4, "mat4.inverse_affine: expected affine bottom row") }
    if m15 != 1.0 { return oren_err(4, "mat4.inverse_affine: expected affine bottom row") }
    var a: f64 = m[0]
    var b: f64 = m[1]
    var c: f64 = m[2]
    var d: f64 = m[4]
    var e: f64 = m[5]
    var f: f64 = m[6]
    var g: f64 = m[8]
    var h: f64 = m[9]
    var i: f64 = m[10]
    var det3: f64 = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
    if !math.is_finite(det3) { return oren_err(4, "mat4.inverse_affine: non-finite determinant") }
    if det3 == 0.0 { return oren_err(4, "mat4.inverse_affine: singular") }
    var inv_det: f64 = 1.0 / det3
    var i00: f64 = (e * i - f * h) * inv_det
    var i01: f64 = (c * h - b * i) * inv_det
    var i02: f64 = (b * f - c * e) * inv_det
    var i10: f64 = (f * g - d * i) * inv_det
    var i11: f64 = (a * i - c * g) * inv_det
    var i12: f64 = (c * d - a * f) * inv_det
    var i20: f64 = (d * h - e * g) * inv_det
    var i21: f64 = (b * g - a * h) * inv_det
    var i22: f64 = (a * e - b * d) * inv_det
    var tx: f64 = m[3]
    var ty: f64 = m[7]
    var tz: f64 = m[11]
    var out = [
        i00, i01, i02, 0.0 - (i00 * tx + i01 * ty + i02 * tz),
        i10, i11, i12, 0.0 - (i10 * tx + i11 * ty + i12 * tz),
        i20, i21, i22, 0.0 - (i20 * tx + i21 * ty + i22 * tz),
        0.0, 0.0, 0.0, 1.0
    ]
    var ok = chk._check(out, "mat4.inverse_affine")
    if oren_is_err(ok) { return ok }
    return out
}

fn affine_inverse(m) {
    return inverse_affine(m)
}

fn affine_inverse_transform(m) {
    return inverse_affine(m)
}

fn normal_matrix3(m) {
    var cm = chk._check(m, "mat4.normal_matrix3")
    if oren_is_err(cm) { return cm }
    var inv = inverse(m)
    if oren_is_err(inv) { return inv }
    return [
        inv[0], inv[4], inv[8],
        inv[1], inv[5], inv[9],
        inv[2], inv[6], inv[10]
    ]
}

fn normal_matrix(m) {
    return normal_matrix3(m)
}
