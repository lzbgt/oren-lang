    ]
}

fn _compose_normalized_quat_trs(qx: f64, qy: f64, qz: f64, qw: f64, sx: f64, sy: f64, sz: f64, tx: f64, ty: f64, tz: f64) {
    var xx: f64 = qx * qx
    var yy: f64 = qy * qy
    var zz: f64 = qz * qz
    var xy: f64 = qx * qy
    var xz: f64 = qx * qz
    var yz: f64 = qy * qz
    var wx: f64 = qw * qx
    var wy: f64 = qw * qy
    var wz: f64 = qw * qz
    return [
        (1.0 - 2.0 * (yy + zz)) * sx, (2.0 * (xy - wz)) * sy, (2.0 * (xz + wy)) * sz, tx,
        (2.0 * (xy + wz)) * sx, (1.0 - 2.0 * (xx + zz)) * sy, (2.0 * (yz - wx)) * sz, ty,
        (2.0 * (xz - wy)) * sx, (2.0 * (yz + wx)) * sy, (1.0 - 2.0 * (xx + yy)) * sz, tz,
        0.0, 0.0, 0.0, 1.0
    ]
}

fn from_quat(x: f64, y: f64, z: f64, w: f64) {
    var q = quat.normalize(x, y, z, w)
    if oren_is_err(q) { return q }
    return _compose_normalized_quat_trs(q[0], q[1], q[2], q[3], 1.0, 1.0, 1.0, 0.0, 0.0, 0.0)
}

fn from_axis_angle(ax: f64, ay: f64, az: f64, radians: f64) {
    var q = quat.from_axis_angle(ax, ay, az, radians)
    if oren_is_err(q) { return q }
    return from_quat(q[0], q[1], q[2], q[3])
}

fn rotation_axis(ax: f64, ay: f64, az: f64, radians: f64) {
