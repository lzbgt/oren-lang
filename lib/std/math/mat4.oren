import math "std:math"
import quat "std:math/quat"

fn _finite_scalar(x: f64, ctx) {
    if math.is_nan(x) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite3(x: f64, y: f64, z: f64, ctx) {
    var a = _finite_scalar(x, ctx)
    if oren_is_err(a) { return a }
    var b = _finite_scalar(y, ctx)
    if oren_is_err(b) { return b }
    return _finite_scalar(z, ctx)
}

fn _finite4(a: f64, b: f64, c: f64, d: f64, ctx) {
    var x = _finite3(a, b, c, ctx)
    if oren_is_err(x) { return x }
    return _finite_scalar(d, ctx)
}

fn _finite6(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, ctx) {
    var x = _finite3(a, b, c, ctx)
    if oren_is_err(x) { return x }
    return _finite3(d, e, f, ctx)
}

fn _viewport(viewport_x: f64, viewport_y: f64, viewport_w: f64, viewport_h: f64, ctx) {
    var ok = _finite3(viewport_x, viewport_y, viewport_w, ctx)
    if oren_is_err(ok) { return ok }
    ok = _finite_scalar(viewport_h, ctx)
    if oren_is_err(ok) { return ok }
    if viewport_w <= 0.0 { return oren_err(4, ctx + ": invalid viewport width") }
    if viewport_h <= 0.0 { return oren_err(4, ctx + ": invalid viewport height") }
    return 0
}

fn _depth_from_ndc_z(ndc_z: f64, ctx) {
    var ok = _finite_scalar(ndc_z, ctx)
    if oren_is_err(ok) { return ok }
    var depth: f64 = (ndc_z + 1.0) * 0.5
    if depth < 0.0 {
        if depth < -1e-9 { return oren_err(4, ctx + ": invalid depth") }
        depth = 0.0
    }
    if depth > 1.0 {
        if depth > 1.000000001 { return oren_err(4, ctx + ": invalid depth") }
        depth = 1.0
    }
    return depth
}

fn _depth_to_ndc_z(win_z: f64, ctx) {
    var ok = _finite_scalar(win_z, ctx)
    if oren_is_err(ok) { return ok }
    var depth: f64 = win_z
    if depth < 0.0 {
        if depth < -1e-9 { return oren_err(4, ctx + ": invalid depth") }
        depth = 0.0
    }
    if depth > 1.0 {
        if depth > 1.000000001 { return oren_err(4, ctx + ": invalid depth") }
        depth = 1.0
    }
    return depth * 2.0 - 1.0
}

fn _check(m, ctx) {
    if oren_list_len(m) != 16 { return oren_err(4, ctx + ": expected 16 values") }
    var i = 0
    while i < 16 {
        var ok = _finite_scalar(m[i], ctx)
        if oren_is_err(ok) { return ok }
        i = i + 1
    }
    return 0
}

fn _check_vec4(v, ctx) {
    if oren_list_len(v) != 4 { return oren_err(4, ctx + ": expected 4 values") }
    var i = 0
    while i < 4 {
        var ok = _finite_scalar(v[i], ctx)
        if oren_is_err(ok) { return ok }
        i = i + 1
    }
    return 0
}

fn _check_vec3(v, ctx) {
    if oren_list_len(v) != 3 { return oren_err(4, ctx + ": expected 3 values") }
    var i = 0
    while i < 3 {
        var ok = _finite_scalar(v[i], ctx)
        if oren_is_err(ok) { return ok }
        i = i + 1
    }
    return 0
}

fn is_finite(m) {
    return !oren_is_err(_check(m, "mat4.is_finite"))
}

fn isfinite(m) {
    return is_finite(m)
}

fn is_affine(m) {
    var ok = _check(m, "mat4.is_affine")
    if oren_is_err(ok) { return false }
    var m12: f64 = m[12]
    var m13: f64 = m[13]
    var m14: f64 = m[14]
    var m15: f64 = m[15]
    if m12 != 0.0 { return false }
    if m13 != 0.0 { return false }
    if m14 != 0.0 { return false }
    if m15 != 1.0 { return false }
    return true
}

fn has_perspective(m) {
    var ok = _check(m, "mat4.has_perspective")
    if oren_is_err(ok) { return false }
    return !is_affine(m)
}

fn equals(a, b) {
    var ca = _check(a, "mat4.equals")
    if oren_is_err(ca) { return ca }
    var cb = _check(b, "mat4.equals")
    if oren_is_err(cb) { return cb }
    var i = 0
    while i < 16 {
        var av: f64 = a[i]
        var bv: f64 = b[i]
        if av != bv { return false }
        i = i + 1
    }
    return true
}

fn allclose_abs(a, b, abs_tol: f64) {
    var ca = _check(a, "mat4.allclose_abs")
    if oren_is_err(ca) { return ca }
    var cb = _check(b, "mat4.allclose_abs")
    if oren_is_err(cb) { return cb }
    var i = 0
    while i < 16 {
        var av: f64 = a[i]
        var bv: f64 = b[i]
        var ok = math.isclose_abs(av, bv, abs_tol)
        if oren_is_err(ok) { return ok }
        if !ok { return false }
        i = i + 1
    }
    return true
}

fn allclose(a, b, rel_tol: f64, abs_tol: f64) {
    var ca = _check(a, "mat4.allclose")
    if oren_is_err(ca) { return ca }
    var cb = _check(b, "mat4.allclose")
    if oren_is_err(cb) { return cb }
    var i = 0
    while i < 16 {
        var av: f64 = a[i]
        var bv: f64 = b[i]
        var ok = math.isclose(av, bv, rel_tol, abs_tol)
        if oren_is_err(ok) { return ok }
        if !ok { return false }
        i = i + 1
    }
    return true
}

fn is_identity(m) {
    return equals(m, identity())
}

fn is_identity_abs(m, abs_tol: f64) {
    return allclose_abs(m, identity(), abs_tol)
}

fn _basis_dot(x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64, ctx) {
    var out: f64 = x0 * x1 + y0 * y1 + z0 * z1
    var ok = _finite_scalar(out, ctx)
    if oren_is_err(ok) { return ok }
    return out
}

fn _close_abs_scalar(a: f64, b: f64, abs_tol: f64, ctx) {
    var ok = math.isclose_abs(a, b, abs_tol)
    if oren_is_err(ok) { return oren_err(4, ctx + ": invalid tolerance") }
    return ok
}

fn is_orthonormal_abs(m, abs_tol: f64) {
    var ok = _check(m, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    var xx = _basis_dot(m[0], m[4], m[8], m[0], m[4], m[8], "mat4.is_orthonormal_abs")
    if oren_is_err(xx) { return xx }
    var yy = _basis_dot(m[1], m[5], m[9], m[1], m[5], m[9], "mat4.is_orthonormal_abs")
    if oren_is_err(yy) { return yy }
    var zz = _basis_dot(m[2], m[6], m[10], m[2], m[6], m[10], "mat4.is_orthonormal_abs")
    if oren_is_err(zz) { return zz }
    var xy = _basis_dot(m[0], m[4], m[8], m[1], m[5], m[9], "mat4.is_orthonormal_abs")
    if oren_is_err(xy) { return xy }
    var xz = _basis_dot(m[0], m[4], m[8], m[2], m[6], m[10], "mat4.is_orthonormal_abs")
    if oren_is_err(xz) { return xz }
    var yz = _basis_dot(m[1], m[5], m[9], m[2], m[6], m[10], "mat4.is_orthonormal_abs")
    if oren_is_err(yz) { return yz }

    ok = _close_abs_scalar(xx, 1.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _close_abs_scalar(yy, 1.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _close_abs_scalar(zz, 1.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _close_abs_scalar(xy, 0.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _close_abs_scalar(xz, 0.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _close_abs_scalar(yz, 0.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return true
}

fn is_rigid_transform_abs(m, abs_tol: f64) {
    var ok = _check(m, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    ok = _close_abs_scalar(m[12], 0.0, abs_tol, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _close_abs_scalar(m[13], 0.0, abs_tol, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _close_abs_scalar(m[14], 0.0, abs_tol, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _close_abs_scalar(m[15], 1.0, abs_tol, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return is_orthonormal_abs(m, abs_tol)
}

fn inverse_rigid_transform_abs(m, abs_tol: f64) {
    var rigid = is_rigid_transform_abs(m, abs_tol)
    if oren_is_err(rigid) { return rigid }
    if !rigid { return oren_err(4, "mat4.inverse_rigid_transform_abs: non-rigid transform") }

    var m0: f64 = m[0]
    var m1: f64 = m[1]
    var m2: f64 = m[2]
    var m4: f64 = m[4]
    var m5: f64 = m[5]
    var m6: f64 = m[6]
    var m8: f64 = m[8]
    var m9: f64 = m[9]
    var m10: f64 = m[10]
    var tx: f64 = m[3]
    var ty: f64 = m[7]
    var tz: f64 = m[11]
    var itx: f64 = 0.0 - (m0 * tx + m4 * ty + m8 * tz)
    var ity: f64 = 0.0 - (m1 * tx + m5 * ty + m9 * tz)
    var itz: f64 = 0.0 - (m2 * tx + m6 * ty + m10 * tz)
    var out = [
        m0, m4, m8, itx,
        m1, m5, m9, ity,
        m2, m6, m10, itz,
        0.0, 0.0, 0.0, 1.0
    ]
    var ok = _check(out, "mat4.inverse_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    return out
}

fn rigid_inverse_abs(m, abs_tol: f64) {
    return inverse_rigid_transform_abs(m, abs_tol)
}

fn inverse_rigid_transform(m) {
    return inverse_rigid_transform_abs(m, 0.000000000001)
}

fn rigid_inverse(m) {
    return inverse_rigid_transform(m)
}

fn basis_x(m) {
    var ok = _check(m, "mat4.basis_x")
    if oren_is_err(ok) { return ok }
    return [m[0], m[4], m[8]]
}

fn basis_y(m) {
    var ok = _check(m, "mat4.basis_y")
    if oren_is_err(ok) { return ok }
    return [m[1], m[5], m[9]]
}

fn basis_z(m) {
    var ok = _check(m, "mat4.basis_z")
    if oren_is_err(ok) { return ok }
    return [m[2], m[6], m[10]]
}

fn right(m) {
    return basis_x(m)
}

fn up(m) {
    return basis_y(m)
}

fn forward(m) {
    return basis_z(m)
}

fn row0(m) {
    var ok = _check(m, "mat4.row0")
    if oren_is_err(ok) { return ok }
    return [m[0], m[1], m[2], m[3]]
}

fn row1(m) {
    var ok = _check(m, "mat4.row1")
    if oren_is_err(ok) { return ok }
    return [m[4], m[5], m[6], m[7]]
}

fn row2(m) {
    var ok = _check(m, "mat4.row2")
    if oren_is_err(ok) { return ok }
    return [m[8], m[9], m[10], m[11]]
}

fn row3(m) {
    var ok = _check(m, "mat4.row3")
    if oren_is_err(ok) { return ok }
    return [m[12], m[13], m[14], m[15]]
}

fn row(m, index: int) {
    var ok = _check(m, "mat4.row")
    if oren_is_err(ok) { return ok }
    if index == 0 { return [m[0], m[1], m[2], m[3]] }
    if index == 1 { return [m[4], m[5], m[6], m[7]] }
    if index == 2 { return [m[8], m[9], m[10], m[11]] }
    if index == 3 { return [m[12], m[13], m[14], m[15]] }
    return oren_err(4, "mat4.row: index out of range")
}

fn column0(m) {
    var ok = _check(m, "mat4.column0")
    if oren_is_err(ok) { return ok }
    return [m[0], m[4], m[8], m[12]]
}

fn col0(m) {
    return column0(m)
}

fn column1(m) {
    var ok = _check(m, "mat4.column1")
    if oren_is_err(ok) { return ok }
    return [m[1], m[5], m[9], m[13]]
}

fn col1(m) {
    return column1(m)
}

fn column2(m) {
    var ok = _check(m, "mat4.column2")
    if oren_is_err(ok) { return ok }
    return [m[2], m[6], m[10], m[14]]
}

fn col2(m) {
    return column2(m)
}

fn column3(m) {
    var ok = _check(m, "mat4.column3")
    if oren_is_err(ok) { return ok }
    return [m[3], m[7], m[11], m[15]]
}

fn col3(m) {
    return column3(m)
}

fn column(m, index: int) {
    var ok = _check(m, "mat4.column")
    if oren_is_err(ok) { return ok }
    if index == 0 { return [m[0], m[4], m[8], m[12]] }
    if index == 1 { return [m[1], m[5], m[9], m[13]] }
    if index == 2 { return [m[2], m[6], m[10], m[14]] }
    if index == 3 { return [m[3], m[7], m[11], m[15]] }
    return oren_err(4, "mat4.column: index out of range")
}

fn col(m, index: int) {
    return column(m, index)
}

fn _cell_index(row_index: int, column_index: int, ctx) {
    if row_index < 0 || row_index > 3 { return oren_err(4, ctx + ": row index out of range") }
    if column_index < 0 || column_index > 3 { return oren_err(4, ctx + ": column index out of range") }
    return row_index * 4 + column_index
}

fn at(m, row_index: int, column_index: int) {
    var ok = _check(m, "mat4.at")
    if oren_is_err(ok) { return ok }
    var idx = _cell_index(row_index, column_index, "mat4.at")
    if oren_is_err(idx) { return idx }
    return m[idx]
}

fn element(m, row_index: int, column_index: int) {
    return at(m, row_index, column_index)
}

fn with_cell(m, row_index: int, column_index: int, value: f64) {
    var ok = _check(m, "mat4.with_cell")
    if oren_is_err(ok) { return ok }
    var idx = _cell_index(row_index, column_index, "mat4.with_cell")
    if oren_is_err(idx) { return idx }
    ok = _finite_scalar(value, "mat4.with_cell")
    if oren_is_err(ok) { return ok }
    var out = [
        m[0], m[1], m[2], m[3],
        m[4], m[5], m[6], m[7],
        m[8], m[9], m[10], m[11],
        m[12], m[13], m[14], m[15]
    ]
    out[idx] = value
    return out
}

fn set_cell(m, row_index: int, column_index: int, value: f64) {
    return with_cell(m, row_index, column_index, value)
}

fn with_row(m, index: int, row_values) {
    var ok = _check(m, "mat4.with_row")
    if oren_is_err(ok) { return ok }
    ok = _check_vec4(row_values, "mat4.with_row")
    if oren_is_err(ok) { return ok }
    if index == 0 {
        return [
            row_values[0], row_values[1], row_values[2], row_values[3],
            m[4], m[5], m[6], m[7],
            m[8], m[9], m[10], m[11],
            m[12], m[13], m[14], m[15]
        ]
    }
    if index == 1 {
        return [
            m[0], m[1], m[2], m[3],
            row_values[0], row_values[1], row_values[2], row_values[3],
            m[8], m[9], m[10], m[11],
            m[12], m[13], m[14], m[15]
        ]
    }
    if index == 2 {
        return [
            m[0], m[1], m[2], m[3],
            m[4], m[5], m[6], m[7],
            row_values[0], row_values[1], row_values[2], row_values[3],
            m[12], m[13], m[14], m[15]
        ]
    }
    if index == 3 {
        return [
            m[0], m[1], m[2], m[3],
            m[4], m[5], m[6], m[7],
            m[8], m[9], m[10], m[11],
            row_values[0], row_values[1], row_values[2], row_values[3]
        ]
    }
    return oren_err(4, "mat4.with_row: index out of range")
}

fn set_row(m, index: int, row_values) {
    return with_row(m, index, row_values)
}

fn with_column(m, index: int, column_values) {
    var ok = _check(m, "mat4.with_column")
    if oren_is_err(ok) { return ok }
    ok = _check_vec4(column_values, "mat4.with_column")
    if oren_is_err(ok) { return ok }
    if index == 0 {
        return [
            column_values[0], m[1], m[2], m[3],
            column_values[1], m[5], m[6], m[7],
            column_values[2], m[9], m[10], m[11],
            column_values[3], m[13], m[14], m[15]
        ]
    }
    if index == 1 {
        return [
            m[0], column_values[0], m[2], m[3],
            m[4], column_values[1], m[6], m[7],
            m[8], column_values[2], m[10], m[11],
            m[12], column_values[3], m[14], m[15]
        ]
    }
    if index == 2 {
        return [
            m[0], m[1], column_values[0], m[3],
            m[4], m[5], column_values[1], m[7],
            m[8], m[9], column_values[2], m[11],
            m[12], m[13], column_values[3], m[15]
        ]
    }
    if index == 3 {
        return [
            m[0], m[1], m[2], column_values[0],
            m[4], m[5], m[6], column_values[1],
            m[8], m[9], m[10], column_values[2],
            m[12], m[13], m[14], column_values[3]
        ]
    }
    return oren_err(4, "mat4.with_column: index out of range")
}

fn set_column(m, index: int, column_values) {
    return with_column(m, index, column_values)
}

fn with_col(m, index: int, column_values) {
    return with_column(m, index, column_values)
}

fn set_col(m, index: int, column_values) {
    return with_column(m, index, column_values)
}

fn from_rows(r0, r1, r2, r3) {
    var ok = _check_vec4(r0, "mat4.from_rows")
    if oren_is_err(ok) { return ok }
    ok = _check_vec4(r1, "mat4.from_rows")
    if oren_is_err(ok) { return ok }
    ok = _check_vec4(r2, "mat4.from_rows")
    if oren_is_err(ok) { return ok }
    ok = _check_vec4(r3, "mat4.from_rows")
    if oren_is_err(ok) { return ok }
    return [
        r0[0], r0[1], r0[2], r0[3],
        r1[0], r1[1], r1[2], r1[3],
        r2[0], r2[1], r2[2], r2[3],
        r3[0], r3[1], r3[2], r3[3]
    ]
}

fn from_columns(c0, c1, c2, c3) {
    var ok = _check_vec4(c0, "mat4.from_columns")
    if oren_is_err(ok) { return ok }
    ok = _check_vec4(c1, "mat4.from_columns")
    if oren_is_err(ok) { return ok }
    ok = _check_vec4(c2, "mat4.from_columns")
    if oren_is_err(ok) { return ok }
    ok = _check_vec4(c3, "mat4.from_columns")
    if oren_is_err(ok) { return ok }
    return [
        c0[0], c1[0], c2[0], c3[0],
        c0[1], c1[1], c2[1], c3[1],
        c0[2], c1[2], c2[2], c3[2],
        c0[3], c1[3], c2[3], c3[3]
    ]
}

fn from_basis_translation(x_axis, y_axis, z_axis, translation_vec) {
    var ok = _check_vec3(x_axis, "mat4.from_basis_translation")
    if oren_is_err(ok) { return ok }
    ok = _check_vec3(y_axis, "mat4.from_basis_translation")
    if oren_is_err(ok) { return ok }
    ok = _check_vec3(z_axis, "mat4.from_basis_translation")
    if oren_is_err(ok) { return ok }
    ok = _check_vec3(translation_vec, "mat4.from_basis_translation")
    if oren_is_err(ok) { return ok }
    return [
        x_axis[0], y_axis[0], z_axis[0], translation_vec[0],
        x_axis[1], y_axis[1], z_axis[1], translation_vec[1],
        x_axis[2], y_axis[2], z_axis[2], translation_vec[2],
        0.0, 0.0, 0.0, 1.0
    ]
}

fn from_basis(x_axis, y_axis, z_axis) {
    return from_basis_translation(x_axis, y_axis, z_axis, [0.0, 0.0, 0.0])
}

fn from_axes_translation(x_axis, y_axis, z_axis, translation_vec) {
    return from_basis_translation(x_axis, y_axis, z_axis, translation_vec)
}

