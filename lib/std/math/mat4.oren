fn look_at(eye_x: f64, eye_y: f64, eye_z: f64, target_x: f64, target_y: f64, target_z: f64, up_x: f64, up_y: f64, up_z: f64) {
    return proj.look_at(eye_x, eye_y, eye_z, target_x, target_y, target_z, up_x, up_y, up_z)
}

fn _cell(a, b, r, c) {
    var base = r * 4
    var a0: f64 = a[base]
    var a1: f64 = a[base + 1]
    var a2: f64 = a[base + 2]
    var a3: f64 = a[base + 3]
    var b0: f64 = b[c]
    var b1: f64 = b[4 + c]
    var b2: f64 = b[8 + c]
    var b3: f64 = b[12 + c]
    var out: f64 = a0 * b0 + a1 * b1 + a2 * b2 + a3 * b3
    return out
}

fn mul(a, b) {
    var ca = chk._check(a, "mat4.mul")
    if oren_is_err(ca) { return ca }
    var cb = chk._check(b, "mat4.mul")
    if oren_is_err(cb) { return cb }
    var c00: f64 = _cell(a, b, 0, 0)
    var c01: f64 = _cell(a, b, 0, 1)
    var c02: f64 = _cell(a, b, 0, 2)
    var c03: f64 = _cell(a, b, 0, 3)
    var c10: f64 = _cell(a, b, 1, 0)
    var c11: f64 = _cell(a, b, 1, 1)
    var c12: f64 = _cell(a, b, 1, 2)
    var c13: f64 = _cell(a, b, 1, 3)
    var c20: f64 = _cell(a, b, 2, 0)
    var c21: f64 = _cell(a, b, 2, 1)
    var c22: f64 = _cell(a, b, 2, 2)
    var c23: f64 = _cell(a, b, 2, 3)
    var c30: f64 = _cell(a, b, 3, 0)
    var c31: f64 = _cell(a, b, 3, 1)
    var c32: f64 = _cell(a, b, 3, 2)
    var c33: f64 = _cell(a, b, 3, 3)
    return [
        c00, c01, c02, c03,
        c10, c11, c12, c13,
        c20, c21, c22, c23,
        c30, c31, c32, c33
    ]
}

fn multiply(a, b) {
    return mul(a, b)
}

fn model_view(model, view) {
    return mul(view, model)
}

fn view_projection(view, projection) {
    return mul(projection, view)
}

fn model_view_projection(model, view, projection) {
    var vm = model_view(model, view)
    if oren_is_err(vm) { return vm }
    return mul(projection, vm)
}

fn transpose(m) {
    var cm = chk._check(m, "mat4.transpose")
    if oren_is_err(cm) { return cm }
    return [
        m[0], m[4], m[8], m[12],
        m[1], m[5], m[9], m[13],
        m[2], m[6], m[10], m[14],
        m[3], m[7], m[11], m[15]
    ]
}

fn transposed(m) {
    return transpose(m)
}

