fn compose_trs(tx: f64, ty: f64, tz: f64, qx0: f64, qy0: f64, qz0: f64, qw0: f64, sx: f64, sy: f64, sz: f64) {
    var t = _finite3(tx, ty, tz, "mat4.compose_trs")
    if oren_is_err(t) { return t }
    var s = _finite3(sx, sy, sz, "mat4.compose_trs")
    if oren_is_err(s) { return s }
    var q = quat.normalize(qx0, qy0, qz0, qw0)
    if oren_is_err(q) { return q }
    return _compose_normalized_quat_trs(q[0], q[1], q[2], q[3], sx, sy, sz, tx, ty, tz)
}

fn compose_transform(tx: f64, ty: f64, tz: f64, qx0: f64, qy0: f64, qz0: f64, qw0: f64, sx: f64, sy: f64, sz: f64) {
