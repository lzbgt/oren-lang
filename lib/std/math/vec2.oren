}

fn scalbln(x: f64, y: f64, nx, ny) {
    return ldexp(x, y, nx, ny)
}

fn frexp(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.frexp")
    if oren_is_err(ok) { return ok }
    var fx = math.frexp(x)
    if oren_is_err(fx) { return fx }
    var fy = math.frexp(y)
    if oren_is_err(fy) { return fy }
    return [fx[0], fy[0], fx[1], fy[1]]
}

