fn pow(x: f64, y: f64, ex: f64, ey: f64) {
    var ok = _finite4(x, y, ex, ey, "vec2.pow")
    if oren_is_err(ok) { return ok }
    var ox = math.pow(x, ex)
    if oren_is_err(ox) { return ox }
    var oy = math.pow(y, ey)
    if oren_is_err(oy) { return oy }
    return [ox, oy]
}

fn power(x: f64, y: f64, ex: f64, ey: f64) {
    return pow(x, y, ex, ey)
}

fn hypot(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.hypot")
    if oren_is_err(ok) { return ok }
    return [math.hypot(ax, bx), math.hypot(ay, by)]
}

fn hypot3(ax: f64, ay: f64, bx: f64, by: f64, cx: f64, cy: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.hypot3")
    if oren_is_err(ok) { return ok }
    ok = _finite2(cx, cy, "vec2.hypot3")
    if oren_is_err(ok) { return ok }
    return [math.hypot3(ax, bx, cx), math.hypot3(ay, by, cy)]
}

