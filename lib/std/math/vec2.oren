import math "std:math"

fn _finite2(x: f64, y: f64, ctx) {
    if math.is_nan(x) || math.is_nan(y) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) || !math.is_finite(y) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite4(ax: f64, ay: f64, bx: f64, by: f64, ctx) {
    var a = _finite2(ax, ay, ctx)
    if oren_is_err(a) { return a }
    return _finite2(bx, by, ctx)
}

fn _finite_scalar(x: f64, ctx) {
    if math.is_nan(x) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn add(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.add")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax + bx
    var y: f64 = ay + by
    return [x, y]
}

fn sub(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.sub")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax - bx
    var y: f64 = ay - by
    return [x, y]
}

fn scale(x: f64, y: f64, s: f64) {
    var ok = _finite2(x, y, "vec2.scale")
    if oren_is_err(ok) { return ok }
    var os = _finite_scalar(s, "vec2.scale")
    if oren_is_err(os) { return os }
    var ox: f64 = x * s
    var oy: f64 = y * s
    return [ox, oy]
}

fn lerp(ax: f64, ay: f64, bx: f64, by: f64, t: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.lerp")
    if oren_is_err(ok) { return ok }
    var ot = _finite_scalar(t, "vec2.lerp")
    if oren_is_err(ot) { return ot }
    var x: f64 = ax + (bx - ax) * t
    var y: f64 = ay + (by - ay) * t
    return [x, y]
}

fn abs(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.abs")
    if oren_is_err(ok) { return ok }
    return [math.fabs(x), math.fabs(y)]
}

fn sign(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.sign")
    if oren_is_err(ok) { return ok }
    var sx: f64 = x
    var sy: f64 = y
    if x > 0.0 { sx = 1.0 }
    if x < 0.0 { sx = 0.0 - 1.0 }
    if y > 0.0 { sy = 1.0 }
    if y < 0.0 { sy = 0.0 - 1.0 }
    return [sx, sy]
}

fn floor(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.floor")
    if oren_is_err(ok) { return ok }
    return [math.floor(x), math.floor(y)]
}

fn ceil(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.ceil")
    if oren_is_err(ok) { return ok }
    return [math.ceil(x), math.ceil(y)]
}

fn round(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.round")
    if oren_is_err(ok) { return ok }
    return [math.round(x), math.round(y)]
}

fn trunc(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.trunc")
    if oren_is_err(ok) { return ok }
    return [math.trunc(x), math.trunc(y)]
}

fn fract(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.fract")
    if oren_is_err(ok) { return ok }
    return [math.fract(x), math.fract(y)]
}

fn saturate(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.saturate")
    if oren_is_err(ok) { return ok }
    return [math.saturate(x), math.saturate(y)]
}

fn step(edge_x: f64, edge_y: f64, x: f64, y: f64) {
    var ok = _finite4(edge_x, edge_y, x, y, "vec2.step")
    if oren_is_err(ok) { return ok }
    return [math.step(edge_x, x), math.step(edge_y, y)]
}

fn smoothstep(edge0_x: f64, edge0_y: f64, edge1_x: f64, edge1_y: f64, x: f64, y: f64) {
    var ok = _finite4(edge0_x, edge0_y, edge1_x, edge1_y, "vec2.smoothstep")
    if oren_is_err(ok) { return ok }
    ok = _finite2(x, y, "vec2.smoothstep")
    if oren_is_err(ok) { return ok }
    if edge1_x <= edge0_x || edge1_y <= edge0_y { return oren_err(4, "vec2.smoothstep: edge1 <= edge0") }
    return [math.smoothstep(edge0_x, edge1_x, x), math.smoothstep(edge0_y, edge1_y, y)]
}

fn smootherstep(edge0_x: f64, edge0_y: f64, edge1_x: f64, edge1_y: f64, x: f64, y: f64) {
    var ok = _finite4(edge0_x, edge0_y, edge1_x, edge1_y, "vec2.smootherstep")
    if oren_is_err(ok) { return ok }
    ok = _finite2(x, y, "vec2.smootherstep")
    if oren_is_err(ok) { return ok }
    if edge1_x <= edge0_x || edge1_y <= edge0_y { return oren_err(4, "vec2.smootherstep: edge1 <= edge0") }
    return [math.smootherstep(edge0_x, edge1_x, x), math.smootherstep(edge0_y, edge1_y, y)]
}

fn min(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.min")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax
    var y: f64 = ay
    if bx < x { x = bx }
    if by < y { y = by }
    return [x, y]
}

fn max(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.max")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax
    var y: f64 = ay
    if bx > x { x = bx }
    if by > y { y = by }
    return [x, y]
}

fn clamp(x: f64, y: f64, lo_x: f64, lo_y: f64, hi_x: f64, hi_y: f64) {
    var ok = _finite2(x, y, "vec2.clamp")
    if oren_is_err(ok) { return ok }
    ok = _finite4(lo_x, lo_y, hi_x, hi_y, "vec2.clamp")
    if oren_is_err(ok) { return ok }
    if hi_x < lo_x || hi_y < lo_y { return oren_err(4, "vec2.clamp: hi < lo") }
    var ox: f64 = x
    var oy: f64 = y
    if ox < lo_x { ox = lo_x }
    if ox > hi_x { ox = hi_x }
    if oy < lo_y { oy = lo_y }
    if oy > hi_y { oy = hi_y }
    return [ox, oy]
}

fn length_sq(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.length_sq")
    if oren_is_err(ok) { return ok }
    var out: f64 = x * x + y * y
    return out
}

fn length(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.length")
    if oren_is_err(ok) { return ok }
    return math.hypot(x, y)
}

fn distance_sq(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.distance_sq")
    if oren_is_err(ok) { return ok }
    var dx: f64 = bx - ax
    var dy: f64 = by - ay
    var out: f64 = dx * dx + dy * dy
    return out
}

fn distance(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.distance")
    if oren_is_err(ok) { return ok }
    return math.hypot(bx - ax, by - ay)
}

fn dot(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.dot")
    if oren_is_err(ok) { return ok }
    var out: f64 = ax * bx + ay * by
    return out
}

fn cross(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.cross")
    if oren_is_err(ok) { return ok }
    var out: f64 = ax * by - ay * bx
    return out
}

fn normalize(x: f64, y: f64) {
    var l0 = length(x, y)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return oren_err(4, "vec2.normalize: zero length") }
    return [x / l, y / l]
}

fn normalize_or_zero(x: f64, y: f64) {
    var l0 = length(x, y)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return [0.0, 0.0] }
    return [x / l, y / l]
}

fn project(ax: f64, ay: f64, bx: f64, by: f64) {
    var d0 = dot(bx, by, bx, by)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    if d == 0.0 { return oren_err(4, "vec2.project: zero target") }
    var n0 = dot(ax, ay, bx, by)
    if oren_is_err(n0) { return n0 }
    var n: f64 = n0
    var s: f64 = n / d
    return scale(bx, by, s)
}

fn reject(ax: f64, ay: f64, bx: f64, by: f64) {
    var p = project(ax, ay, bx, by)
    if oren_is_err(p) { return p }
    var px: f64 = p[0]
    var py: f64 = p[1]
    return sub(ax, ay, px, py)
}

fn reflect(x: f64, y: f64, nx: f64, ny: f64) {
    var n = normalize(nx, ny)
    if oren_is_err(n) { return n }
    var ux: f64 = n[0]
    var uy: f64 = n[1]
    var d0 = dot(x, y, ux, uy)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    var rx: f64 = x - 2.0 * d * ux
    var ry: f64 = y - 2.0 * d * uy
    return [rx, ry]
}

fn angle(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.angle")
    if oren_is_err(ok) { return ok }
    return math.atan2(y, x)
}

fn from_angle(rad: f64) {
    if math.is_nan(rad) { return oren_err(4, "vec2.from_angle: NaN") }
    if !math.is_finite(rad) { return oren_err(4, "vec2.from_angle: non-finite") }
    return [math.cos(rad), math.sin(rad)]
}

fn rotate(x: f64, y: f64, rad: f64) {
    var ok = _finite2(x, y, "vec2.rotate")
    if oren_is_err(ok) { return ok }
    if math.is_nan(rad) { return oren_err(4, "vec2.rotate: NaN") }
    if !math.is_finite(rad) { return oren_err(4, "vec2.rotate: non-finite") }
    var c: f64 = math.cos(rad)
    var s: f64 = math.sin(rad)
    return [x * c - y * s, x * s + y * c]
}
