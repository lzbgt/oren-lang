fn lerp_angle_radians(from_x: f64, from_y: f64, to_x: f64, to_y: f64, t: f64) {
    var ok = _finite4(from_x, from_y, to_x, to_y, "vec2.lerp_angle_radians")
    if oren_is_err(ok) { return ok }
    ok = _finite_scalar(t, "vec2.lerp_angle_radians")
