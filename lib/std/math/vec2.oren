    if oren_is_err(x) { return x }
    var y = math.remquo(ay, by)
    if oren_is_err(y) { return y }
    return [x[0], y[0], x[1], y[1]]
}

fn fdim(ax: f64, ay: f64, bx: f64, by: f64) {
