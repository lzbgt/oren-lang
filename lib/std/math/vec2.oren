}

fn wrap(x: f64, y: f64, lo_x: f64, lo_y: f64, hi_x: f64, hi_y: f64) {
    var ok = _finite4(x, y, lo_x, lo_y, "vec2.wrap")
    if oren_is_err(ok) { return ok }
    ok = _finite2(hi_x, hi_y, "vec2.wrap")
    if oren_is_err(ok) { return ok }
    if hi_x <= lo_x || hi_y <= lo_y { return oren_err(4, "vec2.wrap: hi <= lo") }
    return [math.wrap(x, lo_x, hi_x), math.wrap(y, lo_y, hi_y)]
}

fn wrap_radians(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.wrap_radians")
