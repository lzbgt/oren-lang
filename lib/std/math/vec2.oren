import math "std:math"

fn _finite2(x: f64, y: f64, ctx) {
    if math.is_nan(x) || math.is_nan(y) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) || !math.is_finite(y) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite4(ax: f64, ay: f64, bx: f64, by: f64, ctx) {
    var a = _finite2(ax, ay, ctx)
    if oren_is_err(a) { return a }
    return _finite2(bx, by, ctx)
}

fn _finite_scalar(x: f64, ctx) {
    if math.is_nan(x) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn is_nan(x: f64, y: f64) {
    return [math.is_nan(x), math.is_nan(y)]
}

fn isnan(x: f64, y: f64) {
    return is_nan(x, y)
}

fn is_inf(x: f64, y: f64) {
    return [math.is_inf(x), math.is_inf(y)]
}

fn isinf(x: f64, y: f64) {
    return is_inf(x, y)
}

fn is_finite(x: f64, y: f64) {
    return [math.is_finite(x), math.is_finite(y)]
}

fn isfinite(x: f64, y: f64) {
    return is_finite(x, y)
}

fn is_subnormal(x: f64, y: f64) {
    return [math.is_subnormal(x), math.is_subnormal(y)]
}

fn is_normal(x: f64, y: f64) {
    return [math.is_normal(x), math.is_normal(y)]
}

fn isnormal(x: f64, y: f64) {
    return is_normal(x, y)
}

fn fpclassify(x: f64, y: f64) {
    return [math.fpclassify(x), math.fpclassify(y)]
}

fn isunordered(ax: f64, ay: f64, bx: f64, by: f64) {
    return [math.isunordered(ax, bx), math.isunordered(ay, by)]
}

fn isgreater(ax: f64, ay: f64, bx: f64, by: f64) {
    return [math.isgreater(ax, bx), math.isgreater(ay, by)]
}

fn isgreaterequal(ax: f64, ay: f64, bx: f64, by: f64) {
    return [math.isgreaterequal(ax, bx), math.isgreaterequal(ay, by)]
}

fn isless(ax: f64, ay: f64, bx: f64, by: f64) {
    return [math.isless(ax, bx), math.isless(ay, by)]
}

fn islessequal(ax: f64, ay: f64, bx: f64, by: f64) {
    return [math.islessequal(ax, bx), math.islessequal(ay, by)]
}

fn islessgreater(ax: f64, ay: f64, bx: f64, by: f64) {
    return [math.islessgreater(ax, bx), math.islessgreater(ay, by)]
}

fn signbit(x: f64, y: f64) {
    return [math.signbit(x), math.signbit(y)]
}

fn copysign(x: f64, y: f64, sx: f64, sy: f64) {
    return [math.copysign(x, sx), math.copysign(y, sy)]
}

fn add(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.add")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax + bx
    var y: f64 = ay + by
    return [x, y]
}

fn sub(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.sub")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax - bx
    var y: f64 = ay - by
    return [x, y]
}

fn scale(x: f64, y: f64, s: f64) {
    var ok = _finite2(x, y, "vec2.scale")
    if oren_is_err(ok) { return ok }
    var os = _finite_scalar(s, "vec2.scale")
    if oren_is_err(os) { return os }
    var ox: f64 = x * s
    var oy: f64 = y * s
    return [ox, oy]
}

fn lerp(ax: f64, ay: f64, bx: f64, by: f64, t: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.lerp")
    if oren_is_err(ok) { return ok }
    var ot = _finite_scalar(t, "vec2.lerp")
    if oren_is_err(ot) { return ot }
    var x: f64 = ax + (bx - ax) * t
    var y: f64 = ay + (by - ay) * t
    return [x, y]
}

fn midpoint(ax: f64, ay: f64, bx: f64, by: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.midpoint")
    if oren_is_err(ok) { return ok }
    return [math.midpoint(ax, bx), math.midpoint(ay, by)]
}

fn isclose_abs(ax: f64, ay: f64, bx: f64, by: f64, abs_tol: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.isclose_abs")
    if oren_is_err(ok) { return ok }
    var cx = math.isclose_abs(ax, bx, abs_tol)
    if oren_is_err(cx) { return cx }
    var cy = math.isclose_abs(ay, by, abs_tol)
    if oren_is_err(cy) { return cy }
    return [cx, cy]
}

fn isclose(ax: f64, ay: f64, bx: f64, by: f64, rel_tol: f64, abs_tol: f64) {
    var ok = _finite4(ax, ay, bx, by, "vec2.isclose")
    if oren_is_err(ok) { return ok }
    var cx = math.isclose(ax, bx, rel_tol, abs_tol)
    if oren_is_err(cx) { return cx }
    var cy = math.isclose(ay, by, rel_tol, abs_tol)
    if oren_is_err(cy) { return cy }
    return [cx, cy]
}

fn abs(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.abs")
    if oren_is_err(ok) { return ok }
    return [math.fabs(x), math.fabs(y)]
}

fn sign(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.sign")
    if oren_is_err(ok) { return ok }
    var sx: f64 = x
    var sy: f64 = y
    if x > 0.0 { sx = 1.0 }
    if x < 0.0 { sx = 0.0 - 1.0 }
    if y > 0.0 { sy = 1.0 }
    if y < 0.0 { sy = 0.0 - 1.0 }
    return [sx, sy]
}

fn sqrt(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.sqrt")
    if oren_is_err(ok) { return ok }
    if x < 0.0 || y < 0.0 { return oren_err(4, "vec2.sqrt: domain") }
    return [math.sqrt(x), math.sqrt(y)]
}

fn cbrt(x: f64, y: f64) {
    var ok = _finite2(x, y, "vec2.cbrt")
    if oren_is_err(ok) { return ok }
    return [math.cbrt(x), math.cbrt(y)]
}

fn powi(x: f64, y: f64, nx, ny) {
    var ok = _finite2(x, y, "vec2.powi")
    if oren_is_err(ok) { return ok }
    return [math.powi(x, nx), math.powi(y, ny)]
}

fn pow2i(nx, ny) {
    return [math.pow2i(nx), math.pow2i(ny)]
}

fn ldexp(x: f64, y: f64, nx, ny) {
