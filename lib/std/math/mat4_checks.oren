import math "std:math"

fn _finite_scalar(x: f64, ctx) {
    if math.is_nan(x) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite3(x: f64, y: f64, z: f64, ctx) {
    var a = _finite_scalar(x, ctx)
    if oren_is_err(a) { return a }
    var b = _finite_scalar(y, ctx)
    if oren_is_err(b) { return b }
    return _finite_scalar(z, ctx)
}

fn _finite4(a: f64, b: f64, c: f64, d: f64, ctx) {
    var x = _finite3(a, b, c, ctx)
    if oren_is_err(x) { return x }
    return _finite_scalar(d, ctx)
}

fn _finite6(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, ctx) {
    var x = _finite3(a, b, c, ctx)
    if oren_is_err(x) { return x }
    return _finite3(d, e, f, ctx)
}

fn _check(m, ctx) {
    if oren_list_len(m) != 16 { return oren_err(4, ctx + ": expected 16 values") }
    var a = _finite4(m[0], m[1], m[2], m[3], ctx)
    if oren_is_err(a) { return a }
    var b = _finite4(m[4], m[5], m[6], m[7], ctx)
    if oren_is_err(b) { return b }
    var c = _finite4(m[8], m[9], m[10], m[11], ctx)
    if oren_is_err(c) { return c }
    return _finite4(m[12], m[13], m[14], m[15], ctx)
}

fn _check_vec4(v, ctx) {
    if oren_list_len(v) != 4 { return oren_err(4, ctx + ": expected 4 values") }
    return _finite4(v[0], v[1], v[2], v[3], ctx)
}

fn _check_vec3(v, ctx) {
    if oren_list_len(v) != 3 { return oren_err(4, ctx + ": expected 3 values") }
    return _finite3(v[0], v[1], v[2], ctx)
}

fn _close_abs_scalar(a: f64, b: f64, abs_tol: f64, ctx) {
    var ok = math.isclose_abs(a, b, abs_tol)
    if oren_is_err(ok) { return oren_err(4, ctx + ": invalid tolerance") }
    return ok
}
