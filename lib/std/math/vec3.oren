fn wrap(x: f64, y: f64, z: f64, lo_x: f64, lo_y: f64, lo_z: f64, hi_x: f64, hi_y: f64, hi_z: f64) {
    var ok = _finite6(x, y, z, lo_x, lo_y, lo_z, "vec3.wrap")
    if oren_is_err(ok) { return ok }
    ok = _finite3(hi_x, hi_y, hi_z, "vec3.wrap")
    if oren_is_err(ok) { return ok }
    if hi_x <= lo_x || hi_y <= lo_y || hi_z <= lo_z { return oren_err(4, "vec3.wrap: hi <= lo") }
    return [math.wrap(x, lo_x, hi_x), math.wrap(y, lo_y, hi_y), math.wrap(z, lo_z, hi_z)]
}

