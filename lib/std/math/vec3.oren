fn asin(x: f64, y: f64, z: f64) {
    var ok = _finite3(x, y, z, "vec3.asin")
    if oren_is_err(ok) { return ok }
    if x < -1.0 || x > 1.0 || y < -1.0 || y > 1.0 || z < -1.0 || z > 1.0 { return oren_err(4, "vec3.asin: domain") }
    return [math.asin(x), math.asin(y), math.asin(z)]
}

fn acos(x: f64, y: f64, z: f64) {
    var ok = _finite3(x, y, z, "vec3.acos")
    if oren_is_err(ok) { return ok }
    if x < -1.0 || x > 1.0 || y < -1.0 || y > 1.0 || z < -1.0 || z > 1.0 { return oren_err(4, "vec3.acos: domain") }
    return [math.acos(x), math.acos(y), math.acos(z)]
