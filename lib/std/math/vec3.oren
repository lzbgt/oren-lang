fn log10(x: f64, y: f64, z: f64) {
    var ok = _finite3(x, y, z, "vec3.log10")
    if oren_is_err(ok) { return ok }
    if x <= 0.0 || y <= 0.0 || z <= 0.0 { return oren_err(4, "vec3.log10: domain") }
    return [math.log10(x), math.log10(y), math.log10(z)]
}

