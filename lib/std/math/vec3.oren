fn hypot3(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, cx: f64, cy: f64, cz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.hypot3")
    if oren_is_err(ok) { return ok }
