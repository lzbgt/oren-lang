fn atanh(x: f64, y: f64, z: f64) {
    var ok = _finite3(x, y, z, "vec3.atanh")
    if oren_is_err(ok) { return ok }
    if x <= -1.0 || x >= 1.0 || y <= -1.0 || y >= 1.0 || z <= -1.0 || z >= 1.0 { return oren_err(4, "vec3.atanh: domain") }
    return [math.atanh(x), math.atanh(y), math.atanh(z)]
