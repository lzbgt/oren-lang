fn atan2(yx: f64, yy: f64, yz: f64, xx: f64, xy: f64, xz: f64) {
    var ok = _finite6(yx, yy, yz, xx, xy, xz, "vec3.atan2")
    if oren_is_err(ok) { return ok }
    return [math.atan2(yx, xx), math.atan2(yy, xy), math.atan2(yz, xz)]
}

fn min(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.min")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax
    var y: f64 = ay
    var z: f64 = az
    if bx < x { x = bx }
    if by < y { y = by }
    if bz < z { z = bz }
    return [x, y, z]
}

fn max(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.max")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax
    var y: f64 = ay
    var z: f64 = az
    if bx > x { x = bx }
    if by > y { y = by }
    if bz > z { z = bz }
    return [x, y, z]
}

fn clamp(x: f64, y: f64, z: f64, lo_x: f64, lo_y: f64, lo_z: f64, hi_x: f64, hi_y: f64, hi_z: f64) {
    var ok = _finite3(x, y, z, "vec3.clamp")
    if oren_is_err(ok) { return ok }
    ok = _finite6(lo_x, lo_y, lo_z, hi_x, hi_y, hi_z, "vec3.clamp")
    if oren_is_err(ok) { return ok }
    if hi_x < lo_x || hi_y < lo_y || hi_z < lo_z { return oren_err(4, "vec3.clamp: hi < lo") }
    var ox: f64 = x
    var oy: f64 = y
    var oz: f64 = z
    if ox < lo_x { ox = lo_x }
    if ox > hi_x { ox = hi_x }
    if oy < lo_y { oy = lo_y }
    if oy > hi_y { oy = hi_y }
    if oz < lo_z { oz = lo_z }
    if oz > hi_z { oz = hi_z }
    return [ox, oy, oz]
}

fn length_sq(x: f64, y: f64, z: f64) {
    var ok = _finite3(x, y, z, "vec3.length_sq")
    if oren_is_err(ok) { return ok }
    var out: f64 = x * x + y * y + z * z
    return out
}

fn length(x: f64, y: f64, z: f64) {
    var ok = _finite3(x, y, z, "vec3.length")
    if oren_is_err(ok) { return ok }
    return math.hypot3(x, y, z)
}

fn distance_sq(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.distance_sq")
    if oren_is_err(ok) { return ok }
    var dx: f64 = bx - ax
    var dy: f64 = by - ay
    var dz: f64 = bz - az
    var out: f64 = dx * dx + dy * dy + dz * dz
    return out
}

fn distance(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.distance")
    if oren_is_err(ok) { return ok }
    return math.hypot3(bx - ax, by - ay, bz - az)
}

fn dot(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.dot")
    if oren_is_err(ok) { return ok }
    var out: f64 = ax * bx + ay * by + az * bz
    return out
}

fn cross(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.cross")
    if oren_is_err(ok) { return ok }
    return [ay * bz - az * by, az * bx - ax * bz, ax * by - ay * bx]
}

fn normalize(x: f64, y: f64, z: f64) {
    var l0 = length(x, y, z)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return oren_err(4, "vec3.normalize: zero length") }
    return [x / l, y / l, z / l]
}

fn normalize_or_zero(x: f64, y: f64, z: f64) {
    var l0 = length(x, y, z)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return [0.0, 0.0, 0.0] }
    return [x / l, y / l, z / l]
}

fn project(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var d0 = dot(bx, by, bz, bx, by, bz)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    if d == 0.0 { return oren_err(4, "vec3.project: zero target") }
    var n0 = dot(ax, ay, az, bx, by, bz)
    if oren_is_err(n0) { return n0 }
    var n: f64 = n0
    var s: f64 = n / d
    return scale(bx, by, bz, s)
}

fn reject(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var p = project(ax, ay, az, bx, by, bz)
    if oren_is_err(p) { return p }
    var px: f64 = p[0]
    var py: f64 = p[1]
    var pz: f64 = p[2]
    return sub(ax, ay, az, px, py, pz)
}

fn reflect(x: f64, y: f64, z: f64, nx: f64, ny: f64, nz: f64) {
    var n = normalize(nx, ny, nz)
    if oren_is_err(n) { return n }
    var ux: f64 = n[0]
    var uy: f64 = n[1]
    var uz: f64 = n[2]
    var d0 = dot(x, y, z, ux, uy, uz)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    var rx: f64 = x - 2.0 * d * ux
    var ry: f64 = y - 2.0 * d * uy
    var rz: f64 = z - 2.0 * d * uz
    return [rx, ry, rz]
}

fn angle_between(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var la0 = length(ax, ay, az)
    if oren_is_err(la0) { return la0 }
    var lb0 = length(bx, by, bz)
    if oren_is_err(lb0) { return lb0 }
    var la: f64 = la0
    var lb: f64 = lb0
    if la == 0.0 || lb == 0.0 { return oren_err(4, "vec3.angle_between: zero length") }
    var d0 = dot(ax, ay, az, bx, by, bz)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    var c = math.clamp(d / (la * lb), 0.0 - 1.0, 1.0)
    if oren_is_err(c) { return c }
    var cf: f64 = c
    return math.acos(cf)
}
