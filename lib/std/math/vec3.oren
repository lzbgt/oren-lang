import math "std:math"

fn _finite3(x: f64, y: f64, z: f64, ctx) {
    if math.is_nan(x) || math.is_nan(y) || math.is_nan(z) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) || !math.is_finite(y) || !math.is_finite(z) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite6(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, ctx) {
    var a = _finite3(ax, ay, az, ctx)
    if oren_is_err(a) { return a }
    return _finite3(bx, by, bz, ctx)
}

fn _finite_scalar(x: f64, ctx) {
    if math.is_nan(x) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn add(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.add")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax + bx
    var y: f64 = ay + by
    var z: f64 = az + bz
    return [x, y, z]
}

fn sub(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.sub")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax - bx
    var y: f64 = ay - by
    var z: f64 = az - bz
    return [x, y, z]
}

fn scale(x: f64, y: f64, z: f64, s: f64) {
    var ok = _finite3(x, y, z, "vec3.scale")
    if oren_is_err(ok) { return ok }
    var os = _finite_scalar(s, "vec3.scale")
    if oren_is_err(os) { return os }
    var ox: f64 = x * s
    var oy: f64 = y * s
    var oz: f64 = z * s
    return [ox, oy, oz]
}

fn lerp(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, t: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.lerp")
    if oren_is_err(ok) { return ok }
    var ot = _finite_scalar(t, "vec3.lerp")
    if oren_is_err(ot) { return ot }
    var x: f64 = ax + (bx - ax) * t
    var y: f64 = ay + (by - ay) * t
    var z: f64 = az + (bz - az) * t
    return [x, y, z]
}

fn midpoint(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.midpoint")
    if oren_is_err(ok) { return ok }
    return [math.midpoint(ax, bx), math.midpoint(ay, by), math.midpoint(az, bz)]
}

fn isclose_abs(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, abs_tol: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.isclose_abs")
    if oren_is_err(ok) { return ok }
    var cx = math.isclose_abs(ax, bx, abs_tol)
    if oren_is_err(cx) { return cx }
    var cy = math.isclose_abs(ay, by, abs_tol)
    if oren_is_err(cy) { return cy }
    var cz = math.isclose_abs(az, bz, abs_tol)
    if oren_is_err(cz) { return cz }
    return [cx, cy, cz]
}

fn isclose(ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, rel_tol: f64, abs_tol: f64) {
    var ok = _finite6(ax, ay, az, bx, by, bz, "vec3.isclose")
    if oren_is_err(ok) { return ok }
    var cx = math.isclose(ax, bx, rel_tol, abs_tol)
    if oren_is_err(cx) { return cx }
    var cy = math.isclose(ay, by, rel_tol, abs_tol)
    if oren_is_err(cy) { return cy }
    var cz = math.isclose(az, bz, rel_tol, abs_tol)
    if oren_is_err(cz) { return cz }
    return [cx, cy, cz]
}

fn abs(x: f64, y: f64, z: f64) {
    var ok = _finite3(x, y, z, "vec3.abs")
    if oren_is_err(ok) { return ok }
    return [math.fabs(x), math.fabs(y), math.fabs(z)]
}

fn sign(x: f64, y: f64, z: f64) {
    var ok = _finite3(x, y, z, "vec3.sign")
    if oren_is_err(ok) { return ok }
    var sx: f64 = x
    var sy: f64 = y
    var sz: f64 = z
    if x > 0.0 { sx = 1.0 }
    if x < 0.0 { sx = 0.0 - 1.0 }
    if y > 0.0 { sy = 1.0 }
    if y < 0.0 { sy = 0.0 - 1.0 }
    if z > 0.0 { sz = 1.0 }
    if z < 0.0 { sz = 0.0 - 1.0 }
    return [sx, sy, sz]
}

fn sqrt(x: f64, y: f64, z: f64) {
    var ok = _finite3(x, y, z, "vec3.sqrt")
    if oren_is_err(ok) { return ok }
    if x < 0.0 || y < 0.0 || z < 0.0 { return oren_err(4, "vec3.sqrt: domain") }
    return [math.sqrt(x), math.sqrt(y), math.sqrt(z)]
}

