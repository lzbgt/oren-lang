// --- atan / atan2 (deterministic, no host libm) ---
//
// Implemented based on the classical fdlibm/openlibm range-reduction scheme
// (see `docs/refs/openlibm/s_atan.c` and `docs/refs/openlibm/e_atan2.c`).
//
// Semantics:
// - NaN inputs return Err(OREN_ERR_INVALID_ARG)
// - atan2 matches the usual mathematical definition with sign handling for zeros.
//

fn atan(x: f64) {
    if is_nan(x) { return oren_err(4, "atan: NaN") }
    if x == 0.0 { return x } // preserve signed zero
    if is_inf(x) {
        if signbit(x) { return 0.0 - (pi() / 2.0) }
        return pi() / 2.0
    }

    var hx = x
    var ax = abs_f(x)

    // Constants from openlibm (split hi/lo for accuracy near reduction points).
    var atanhi0 = 4.63647609000806093515e-01
    var atanhi1 = 7.85398163397448278999e-01
    var atanhi2 = 9.82793723247329054082e-01
    var atanhi3 = 1.57079632679489655800e+00
    var atanlo0 = 2.26987774529616870924e-17
    var atanlo1 = 3.06161699786838301793e-17
    var atanlo2 = 1.39033110312309984516e-17
    var atanlo3 = 6.12323399573676603587e-17

    // Polynomial coefficients aT[0..10] (openlibm).
    var aT0 = 3.33333333333329318027e-01
    var aT1 = -1.99999999998764832476e-01
    var aT2 = 1.42857142725034663711e-01
    var aT3 = -1.11111104054623557880e-01
    var aT4 = 9.09088713343650656196e-02
    var aT5 = -7.69187620504482999495e-02
    var aT6 = 6.66107313738753120669e-02
    var aT7 = -5.83357013379057348645e-02
    var aT8 = 4.97687799461593236017e-02
    var aT9 = -3.65315727442169155270e-02
    var aT10 = 1.62858201153657823623e-02

    // Argument reduction (numeric threshold equivalents of the bit checks).
    var id = -1
    var t = ax
    if ax < 0.4375 {
        id = -1
        t = ax
    } else {
        if ax < 1.1875 {
            if ax < 0.6875 {
                id = 0
                t = (2.0 * ax - 1.0) / (2.0 + ax)
            } else {
                id = 1
                t = (ax - 1.0) / (ax + 1.0)
            }
        } else {
            if ax < 2.4375 {
                id = 2
                t = (ax - 1.5) / (1.0 + 1.5 * ax)
            } else {
                id = 3
                t = -1.0 / ax
            }
        }
    }

    var z = t * t
    var w = z * z
    var s1 = z * (aT0 + w * (aT2 + w * (aT4 + w * (aT6 + w * (aT8 + w * aT10)))))
    var s2 = w * (aT1 + w * (aT3 + w * (aT5 + w * (aT7 + w * aT9))))
    var r = t - t * (s1 + s2)

    var res = r
    if id >= 0 {
        if id == 0 { res = atanhi0 - ((t * (s1 + s2) - atanlo0) - t) }
        if id == 1 { res = atanhi1 - ((t * (s1 + s2) - atanlo1) - t) }
        if id == 2 { res = atanhi2 - ((t * (s1 + s2) - atanlo2) - t) }
        if id == 3 { res = atanhi3 - ((t * (s1 + s2) - atanlo3) - t) }
    }

    if hx < 0.0 { return 0.0 - res }
    return res
}

fn atan2(y: f64, x: f64) {
    if is_nan(x) || is_nan(y) { return oren_err(4, "atan2: NaN") }
    if is_inf(x) || is_inf(y) {
        // Defer to the generic logic below; it handles infinities with atan.
    }

    // y == 0: return +/-0 or +/-pi depending on sign of x.
    if y == 0.0 {
        if x >= 0.0 { return y } // preserves sign of y (±0)
        if signbit(y) { return 0.0 - pi() }
        return pi()
    }

    // x == 0: return +/- pi/2
    if x == 0.0 {
        if y < 0.0 { return 0.0 - (pi() / 2.0) }
        return pi() / 2.0
    }

    // General case.
    var z = atan(abs_f(y / x))
    if oren_is_err(z) { return z }
    var zf: f64 = z

    // Quadrant adjustments (match fdlibm/openlibm intent).
    if x > 0.0 {
        if y < 0.0 { return 0.0 - zf }
        return zf
    }
    // x < 0
    if y < 0.0 { return (zf - pi()) }
    return (pi() - zf)
}

fn asin(x: f64) {
    if is_nan(x) { return oren_err(4, "asin: NaN") }
    if x < -1.0 || x > 1.0 { return oren_err(4, "asin: domain") }
    if x == 0.0 { return x }
    if x == 1.0 { return pi() / 2.0 }
    if x == -1.0 { return 0.0 - (pi() / 2.0) }
    var y = sqrt(1.0 - x * x)
    if oren_is_err(y) { return y }
    return atan2(x, y)
}

fn acos(x: f64) {
    if is_nan(x) { return oren_err(4, "acos: NaN") }
    if x < -1.0 || x > 1.0 { return oren_err(4, "acos: domain") }
    if x == 1.0 { return 0.0 }
    if x == -1.0 { return pi() }
    var y = sqrt(1.0 - x * x)
    if oren_is_err(y) { return y }
    return atan2(y, x)
}

fn hypot(x: f64, y: f64) {
    if is_nan(x) || is_nan(y) { return oren_err(4, "hypot: NaN") }
    if is_inf(x) || is_inf(y) { return inf() }
    var ax = abs_f(x)
    var ay = abs_f(y)
    if ax < ay {
        var tmp = ax
        ax = ay
        ay = tmp
    }
    if ax == 0.0 { return 0.0 }
    var r = ay / ax
    return ax * _sqrt_nonnegative_f64(1.0 + r * r)
}

fn hypot3(x: f64, y: f64, z: f64) {
    var xy = hypot(x, y)
    if oren_is_err(xy) { return xy }
    return hypot(xy, z)
}
