import math "std:math"

fn _finite4(x: f64, y: f64, z: f64, w: f64, ctx) {
    if math.is_nan(x) || math.is_nan(y) || math.is_nan(z) || math.is_nan(w) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) || !math.is_finite(y) || !math.is_finite(z) || !math.is_finite(w) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite3(x: f64, y: f64, z: f64, ctx) {
    if math.is_nan(x) || math.is_nan(y) || math.is_nan(z) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) || !math.is_finite(y) || !math.is_finite(z) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite_scalar(x: f64, ctx) {
    if math.is_nan(x) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _quat_list4(q, ctx) {
    if oren_list_len(q) != 4 { return oren_err(4, ctx + ": expected 4 values") }
    return _finite4(q[0], q[1], q[2], q[3], ctx)
}

fn identity() {
    return [0.0, 0.0, 0.0, 1.0]
}

fn length_sq(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "quat.length_sq")
    if oren_is_err(ok) { return ok }
    var out: f64 = x * x + y * y + z * z + w * w
    return out
}

fn length_squared(x: f64, y: f64, z: f64, w: f64) {
    return length_sq(x, y, z, w)
}

fn length(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "quat.length")
    if oren_is_err(ok) { return ok }
    return math.hypot(math.hypot(x, y), math.hypot(z, w))
}

fn normalize(x: f64, y: f64, z: f64, w: f64) {
    var l0 = length(x, y, z, w)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return oren_err(4, "quat.normalize: zero length") }
    return [x / l, y / l, z / l, w / l]
}

fn normalize_or_identity(x: f64, y: f64, z: f64, w: f64) {
    var l0 = length(x, y, z, w)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return identity() }
    return [x / l, y / l, z / l, w / l]
}

fn conjugate(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "quat.conjugate")
    if oren_is_err(ok) { return ok }
    return [0.0 - x, 0.0 - y, 0.0 - z, w]
}

fn dot(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var a = _finite4(ax, ay, az, aw, "quat.dot")
    if oren_is_err(a) { return a }
    var b = _finite4(bx, by, bz, bw, "quat.dot")
    if oren_is_err(b) { return b }
    var out: f64 = ax * bx + ay * by + az * bz + aw * bw
    return out
}

fn inverse(x: f64, y: f64, z: f64, w: f64) {
    var ls0 = length_sq(x, y, z, w)
    if oren_is_err(ls0) { return ls0 }
    var ls: f64 = ls0
    if ls == 0.0 { return oren_err(4, "quat.inverse: zero length") }
    return [(0.0 - x) / ls, (0.0 - y) / ls, (0.0 - z) / ls, w / ls]
}

fn mul(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var a = _finite4(ax, ay, az, aw, "quat.mul")
    if oren_is_err(a) { return a }
    var b = _finite4(bx, by, bz, bw, "quat.mul")
    if oren_is_err(b) { return b }
    var x: f64 = aw * bx + ax * bw + ay * bz - az * by
    var y: f64 = aw * by - ax * bz + ay * bw + az * bx
    var z: f64 = aw * bz + ax * by - ay * bx + az * bw
    var w: f64 = aw * bw - ax * bx - ay * by - az * bz
    return [x, y, z, w]
}

fn multiply(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return mul(ax, ay, az, aw, bx, by, bz, bw)
}

fn from_axis_angle(ax: f64, ay: f64, az: f64, radians: f64) {
    var ok = _finite3(ax, ay, az, "quat.from_axis_angle")
    if oren_is_err(ok) { return ok }
    var ar = _finite_scalar(radians, "quat.from_axis_angle")
    if oren_is_err(ar) { return ar }
    var l0 = math.hypot3(ax, ay, az)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return oren_err(4, "quat.from_axis_angle: zero axis") }
    var half: f64 = radians * 0.5
    var s: f64 = math.sin(half)
    var c: f64 = math.cos(half)
    return [ax / l * s, ay / l * s, az / l * s, c]
}

fn axis_angle(ax: f64, ay: f64, az: f64, radians: f64) {
    return from_axis_angle(ax, ay, az, radians)
}

fn to_axis_angle(x: f64, y: f64, z: f64, w: f64) {
    var q = normalize(x, y, z, w)
    if oren_is_err(q) { return q }
    var qx: f64 = q[0]
    var qy: f64 = q[1]
    var qz: f64 = q[2]
    var qw: f64 = q[3]
    if qw < 0.0 {
        qx = 0.0 - qx
        qy = 0.0 - qy
        qz = 0.0 - qz
        qw = 0.0 - qw
    }
    var vl0 = math.hypot3(qx, qy, qz)
    if oren_is_err(vl0) { return vl0 }
    var vl: f64 = vl0
    if vl == 0.0 { return [1.0, 0.0, 0.0, 0.0] }
    var a0 = math.atan2(vl, qw)
    if oren_is_err(a0) { return a0 }
    var a: f64 = a0
    return [qx / vl, qy / vl, qz / vl, a * 2.0]
}

fn axis(x: f64, y: f64, z: f64, w: f64) {
    var aa = to_axis_angle(x, y, z, w)
    if oren_is_err(aa) { return aa }
    return [aa[0], aa[1], aa[2]]
}

fn angle(x: f64, y: f64, z: f64, w: f64) {
    var aa = to_axis_angle(x, y, z, w)
    if oren_is_err(aa) { return aa }
    return aa[3]
}

fn angle_between(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var qa = normalize(ax, ay, az, aw)
    if oren_is_err(qa) { return qa }
    var qb = normalize(bx, by, bz, bw)
    if oren_is_err(qb) { return qb }
    var d0 = dot(qa[0], qa[1], qa[2], qa[3], qb[0], qb[1], qb[2], qb[3])
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    if d < 0.0 { d = 0.0 - d }
    if d > 1.0 { d = 1.0 }
    var a0 = math.acos(d)
    if oren_is_err(a0) { return a0 }
    var a: f64 = a0
    return a * 2.0
}

fn angular_distance(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return angle_between(ax, ay, az, aw, bx, by, bz, bw)
}

fn rotation_power(x: f64, y: f64, z: f64, w: f64, t: f64) {
    var ot = _finite_scalar(t, "quat.rotation_power")
    if oren_is_err(ot) { return ot }
    var q = normalize(x, y, z, w)
    if oren_is_err(q) { return q }
    var qx: f64 = q[0]
    var qy: f64 = q[1]
    var qz: f64 = q[2]
    var qw: f64 = q[3]
    if qw < 0.0 {
        qx = 0.0 - qx
        qy = 0.0 - qy
        qz = 0.0 - qz
        qw = 0.0 - qw
    }
    var vl0 = math.hypot3(qx, qy, qz)
    if oren_is_err(vl0) { return vl0 }
    var vl: f64 = vl0
    if vl == 0.0 { return identity() }
    var base0 = math.atan2(vl, qw)
    if oren_is_err(base0) { return base0 }
    var half: f64 = base0 * t
    var s: f64 = math.sin(half)
    var c: f64 = math.cos(half)
    return [qx / vl * s, qy / vl * s, qz / vl * s, c]
}

fn scale_angle(x: f64, y: f64, z: f64, w: f64, scale: f64) {
    return rotation_power(x, y, z, w, scale)
}

fn pow(x: f64, y: f64, z: f64, w: f64, t: f64) {
    return rotation_power(x, y, z, w, t)
}

fn power(x: f64, y: f64, z: f64, w: f64, t: f64) {
    return rotation_power(x, y, z, w, t)
}

fn exp(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "quat.exp")
    if oren_is_err(ok) { return ok }
    var vl0 = math.hypot3(x, y, z)
    if oren_is_err(vl0) { return vl0 }
    var vl: f64 = vl0
    var ew: f64 = math.exp(w)
    if !math.is_finite(ew) { return oren_err(4, "quat.exp: overflow") }
    if vl == 0.0 { return [0.0, 0.0, 0.0, ew] }
    var s: f64 = math.sin(vl)
    var c: f64 = math.cos(vl)
    var k: f64 = ew * s / vl
    return [x * k, y * k, z * k, ew * c]
}

fn log(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "quat.log")
    if oren_is_err(ok) { return ok }
    var l0 = length(x, y, z, w)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return oren_err(4, "quat.log: zero length") }
    var vl0 = math.hypot3(x, y, z)
    if oren_is_err(vl0) { return vl0 }
    var lw0 = math.log(l)
    if oren_is_err(lw0) { return lw0 }
    var vl: f64 = vl0
    if vl == 0.0 {
        if w < 0.0 { return [math.pi(), 0.0, 0.0, lw0] }
        return [0.0, 0.0, 0.0, lw0]
    }
    var theta0 = math.atan2(vl, w)
    if oren_is_err(theta0) { return theta0 }
    var theta: f64 = theta0
    return [x / vl * theta, y / vl * theta, z / vl * theta, lw0]
}

fn ln(x: f64, y: f64, z: f64, w: f64) {
    return log(x, y, z, w)
}

fn from_euler_xyz(rx: f64, ry: f64, rz: f64) {
    var ok = _finite3(rx, ry, rz, "quat.from_euler_xyz")
    if oren_is_err(ok) { return ok }
    var hx: f64 = rx * 0.5
    var hy: f64 = ry * 0.5
    var hz: f64 = rz * 0.5
    var sx: f64 = math.sin(hx)
    var cx: f64 = math.cos(hx)
    var sy: f64 = math.sin(hy)
    var cy: f64 = math.cos(hy)
    var sz: f64 = math.sin(hz)
    var cz: f64 = math.cos(hz)
    return normalize(
        cz * cy * sx - sz * sy * cx,
        cz * sy * cx + sz * cy * sx,
        sz * cy * cx - cz * sy * sx,
        cz * cy * cx + sz * sy * sx
    )
}

fn euler_xyz(rx: f64, ry: f64, rz: f64) {
    return from_euler_xyz(rx, ry, rz)
}

fn from_euler(rx: f64, ry: f64, rz: f64) {
    return from_euler_xyz(rx, ry, rz)
}

fn to_euler_xyz(x: f64, y: f64, z: f64, w: f64) {
    var q = normalize(x, y, z, w)
    if oren_is_err(q) { return q }
    var qx: f64 = q[0]
    var qy: f64 = q[1]
    var qz: f64 = q[2]
    var qw: f64 = q[3]
    var sx: f64 = 2.0 * (qw * qx + qy * qz)
    var cx: f64 = 1.0 - 2.0 * (qx * qx + qy * qy)
    var rx0 = math.atan2(sx, cx)
    if oren_is_err(rx0) { return rx0 }
    var sy: f64 = 2.0 * (qw * qy - qz * qx)
    if sy > 1.0 { sy = 1.0 }
    if sy < 0.0 - 1.0 { sy = 0.0 - 1.0 }
    var ry0 = math.asin(sy)
    if oren_is_err(ry0) { return ry0 }
    var sz: f64 = 2.0 * (qw * qz + qx * qy)
    var cz: f64 = 1.0 - 2.0 * (qy * qy + qz * qz)
    var rz0 = math.atan2(sz, cz)
    if oren_is_err(rz0) { return rz0 }
    return [rx0, ry0, rz0]
}

fn to_euler(x: f64, y: f64, z: f64, w: f64) {
    return to_euler_xyz(x, y, z, w)
}

fn euler_angles(x: f64, y: f64, z: f64, w: f64) {
    return to_euler_xyz(x, y, z, w)
}

fn from_to_rotation(from_x: f64, from_y: f64, from_z: f64, to_x: f64, to_y: f64, to_z: f64) {
    var f_ok = _finite3(from_x, from_y, from_z, "quat.from_to_rotation")
    if oren_is_err(f_ok) { return f_ok }
    var t_ok = _finite3(to_x, to_y, to_z, "quat.from_to_rotation")
    if oren_is_err(t_ok) { return t_ok }
    var fl0 = math.hypot3(from_x, from_y, from_z)
    if oren_is_err(fl0) { return fl0 }
    var tl0 = math.hypot3(to_x, to_y, to_z)
    if oren_is_err(tl0) { return tl0 }
    var fl: f64 = fl0
    var tl: f64 = tl0
    if fl == 0.0 { return oren_err(4, "quat.from_to_rotation: zero from") }
    if tl == 0.0 { return oren_err(4, "quat.from_to_rotation: zero to") }
    var fx: f64 = from_x / fl
    var fy: f64 = from_y / fl
    var fz: f64 = from_z / fl
    var tx: f64 = to_x / tl
    var ty: f64 = to_y / tl
    var tz: f64 = to_z / tl
    var d: f64 = fx * tx + fy * ty + fz * tz
    if d > 0.999999999 { return identity() }
    if d < -0.999999999 {
        var ax: f64 = 0.0
        var ay: f64 = fz
        var az: f64 = 0.0 - fy
        var afx: f64 = fx
        if afx < 0.0 { afx = 0.0 - afx }
        if afx > 0.9 {
            ax = 0.0 - fz
            ay = 0.0
            az = fx
        }
        return from_axis_angle(ax, ay, az, math.pi())
    }
    var cx: f64 = fy * tz - fz * ty
    var cy: f64 = fz * tx - fx * tz
    var cz: f64 = fx * ty - fy * tx
    return normalize(cx, cy, cz, 1.0 + d)
}

fn rotation_between(from_x: f64, from_y: f64, from_z: f64, to_x: f64, to_y: f64, to_z: f64) {
    return from_to_rotation(from_x, from_y, from_z, to_x, to_y, to_z)
}

fn from_vectors(from_x: f64, from_y: f64, from_z: f64, to_x: f64, to_y: f64, to_z: f64) {
    return from_to_rotation(from_x, from_y, from_z, to_x, to_y, to_z)
}

fn relative_rotation(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var qa = normalize(ax, ay, az, aw)
    if oren_is_err(qa) { return qa }
    var qb = normalize(bx, by, bz, bw)
    if oren_is_err(qb) { return qb }
    var ia = inverse(qa[0], qa[1], qa[2], qa[3])
    if oren_is_err(ia) { return ia }
    var out = mul(qb[0], qb[1], qb[2], qb[3], ia[0], ia[1], ia[2], ia[3])
    if oren_is_err(out) { return out }
    return normalize(out[0], out[1], out[2], out[3])
}

fn difference(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return relative_rotation(ax, ay, az, aw, bx, by, bz, bw)
}

fn _check_basis_rows(m00: f64, m01: f64, m02: f64, m10: f64, m11: f64, m12: f64, m20: f64, m21: f64, m22: f64) {
    var ctx = "quat.from_basis_rows"
    var r0 = _finite3(m00, m01, m02, ctx)
    if oren_is_err(r0) { return r0 }
    var r1 = _finite3(m10, m11, m12, ctx)
    if oren_is_err(r1) { return r1 }
    var r2 = _finite3(m20, m21, m22, ctx)
    if oren_is_err(r2) { return r2 }
    var l0 = math.hypot3(m00, m01, m02)
    if oren_is_err(l0) { return l0 }
    var l1 = math.hypot3(m10, m11, m12)
    if oren_is_err(l1) { return l1 }
    var l2 = math.hypot3(m20, m21, m22)
    if oren_is_err(l2) { return l2 }
    var lf0: f64 = l0
    var lf1: f64 = l1
    var lf2: f64 = l2
    var e0: f64 = lf0 - 1.0
    var e1: f64 = lf1 - 1.0
    var e2: f64 = lf2 - 1.0
    if e0 < 0.0 { e0 = 0.0 - e0 }
    if e1 < 0.0 { e1 = 0.0 - e1 }
    if e2 < 0.0 { e2 = 0.0 - e2 }
    if e0 > 1e-6 || e1 > 1e-6 || e2 > 1e-6 {
        return oren_err(4, ctx + ": rows must be unit length")
    }
    var d01: f64 = m00 * m10 + m01 * m11 + m02 * m12
    var d02: f64 = m00 * m20 + m01 * m21 + m02 * m22
    var d12: f64 = m10 * m20 + m11 * m21 + m12 * m22
    if d01 < 0.0 { d01 = 0.0 - d01 }
    if d02 < 0.0 { d02 = 0.0 - d02 }
    if d12 < 0.0 { d12 = 0.0 - d12 }
    if d01 > 1e-6 || d02 > 1e-6 || d12 > 1e-6 {
        return oren_err(4, ctx + ": rows must be orthogonal")
    }
    var cx: f64 = m11 * m22 - m12 * m21
    var cy: f64 = m12 * m20 - m10 * m22
    var cz: f64 = m10 * m21 - m11 * m20
    var det: f64 = m00 * cx + m01 * cy + m02 * cz
    var de: f64 = det - 1.0
    if de < 0.0 { de = 0.0 - de }
    if de > 1e-6 { return oren_err(4, ctx + ": rows must be right-handed") }
    return 0
}

fn _from_basis_rows(m00: f64, m01: f64, m02: f64, m10: f64, m11: f64, m12: f64, m20: f64, m21: f64, m22: f64) {
    var tr: f64 = m00 + m11 + m22
    if tr > 0.0 {
        var root0 = math.sqrt(tr + 1.0)
        if oren_is_err(root0) { return root0 }
        var root: f64 = root0
        var s: f64 = root * 2.0
        if s == 0.0 { return oren_err(4, "quat.look_rotation: degenerate basis") }
        return normalize((m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s, 0.25 * s)
    }
    if m00 > m11 && m00 > m22 {
        var root1 = math.sqrt(1.0 + m00 - m11 - m22)
        if oren_is_err(root1) { return root1 }
        var r1: f64 = root1
        var s1: f64 = r1 * 2.0
        if s1 == 0.0 { return oren_err(4, "quat.look_rotation: degenerate basis") }
        return normalize(0.25 * s1, (m01 + m10) / s1, (m02 + m20) / s1, (m21 - m12) / s1)
    }
    if m11 > m22 {
        var root2 = math.sqrt(1.0 + m11 - m00 - m22)
        if oren_is_err(root2) { return root2 }
        var r2: f64 = root2
        var s2: f64 = r2 * 2.0
        if s2 == 0.0 { return oren_err(4, "quat.look_rotation: degenerate basis") }
        return normalize((m01 + m10) / s2, 0.25 * s2, (m12 + m21) / s2, (m02 - m20) / s2)
    }
    var root3 = math.sqrt(1.0 + m22 - m00 - m11)
    if oren_is_err(root3) { return root3 }
    var r3: f64 = root3
    var s3: f64 = r3 * 2.0
    if s3 == 0.0 { return oren_err(4, "quat.look_rotation: degenerate basis") }
    return normalize((m02 + m20) / s3, (m12 + m21) / s3, 0.25 * s3, (m10 - m01) / s3)
}

fn from_basis_rows(m00: f64, m01: f64, m02: f64, m10: f64, m11: f64, m12: f64, m20: f64, m21: f64, m22: f64) {
    var ok = _check_basis_rows(m00, m01, m02, m10, m11, m12, m20, m21, m22)
    if oren_is_err(ok) { return ok }
    return _from_basis_rows(m00, m01, m02, m10, m11, m12, m20, m21, m22)
}

fn from_rotation_matrix(m) {
    if oren_list_len(m) != 16 { return oren_err(4, "quat.from_rotation_matrix: expected 16 values") }
    return from_basis_rows(m[0], m[1], m[2], m[4], m[5], m[6], m[8], m[9], m[10])
}

fn from_mat4(m) {
    return from_rotation_matrix(m)
}

fn look_rotation(forward_x: f64, forward_y: f64, forward_z: f64, up_x: f64, up_y: f64, up_z: f64) {
    var fok = _finite3(forward_x, forward_y, forward_z, "quat.look_rotation")
    if oren_is_err(fok) { return fok }
    var uok = _finite3(up_x, up_y, up_z, "quat.look_rotation")
    if oren_is_err(uok) { return uok }
    var fl0 = math.hypot3(forward_x, forward_y, forward_z)
    if oren_is_err(fl0) { return fl0 }
    var ul0 = math.hypot3(up_x, up_y, up_z)
    if oren_is_err(ul0) { return ul0 }
    var fl: f64 = fl0
    var ul: f64 = ul0
    if fl == 0.0 { return oren_err(4, "quat.look_rotation: zero forward") }
    if ul == 0.0 { return oren_err(4, "quat.look_rotation: zero up") }
    var fx: f64 = forward_x / fl
    var fy: f64 = forward_y / fl
    var fz: f64 = forward_z / fl
    var ux0: f64 = up_x / ul
    var uy0: f64 = up_y / ul
    var uz0: f64 = up_z / ul
    var rx: f64 = uy0 * fz - uz0 * fy
    var ry: f64 = uz0 * fx - ux0 * fz
    var rz: f64 = ux0 * fy - uy0 * fx
    var rl0 = math.hypot3(rx, ry, rz)
    if oren_is_err(rl0) { return rl0 }
    var rl: f64 = rl0
    if rl == 0.0 { return oren_err(4, "quat.look_rotation: parallel up") }
    rx = rx / rl
    ry = ry / rl
    rz = rz / rl
    var ux: f64 = fy * rz - fz * ry
    var uy: f64 = fz * rx - fx * rz
    var uz: f64 = fx * ry - fy * rx
    return _from_basis_rows(rx, ux, fx, ry, uy, fy, rz, uz, fz)
}

fn from_forward_up(forward_x: f64, forward_y: f64, forward_z: f64, up_x: f64, up_y: f64, up_z: f64) {
    return look_rotation(forward_x, forward_y, forward_z, up_x, up_y, up_z)
}

fn look_at_rotation(eye_x: f64, eye_y: f64, eye_z: f64, target_x: f64, target_y: f64, target_z: f64, up_x: f64, up_y: f64, up_z: f64) {
    var et = _finite3(eye_x, eye_y, eye_z, "quat.look_at_rotation")
    if oren_is_err(et) { return et }
    var tt = _finite3(target_x, target_y, target_z, "quat.look_at_rotation")
    if oren_is_err(tt) { return tt }
    return look_rotation(target_x - eye_x, target_y - eye_y, target_z - eye_z, up_x, up_y, up_z)
}

fn rotate_vec3(qx: f64, qy: f64, qz: f64, qw: f64, vx: f64, vy: f64, vz: f64) {
    var q = normalize(qx, qy, qz, qw)
    if oren_is_err(q) { return q }
    var ok = _finite3(vx, vy, vz, "quat.rotate_vec3")
    if oren_is_err(ok) { return ok }
    var x: f64 = q[0]
    var y: f64 = q[1]
    var z: f64 = q[2]
    var w: f64 = q[3]
    var tx: f64 = 2.0 * (y * vz - z * vy)
    var ty: f64 = 2.0 * (z * vx - x * vz)
    var tz: f64 = 2.0 * (x * vy - y * vx)
    var rx: f64 = vx + w * tx + (y * tz - z * ty)
    var ry: f64 = vy + w * ty + (z * tx - x * tz)
    var rz: f64 = vz + w * tz + (x * ty - y * tx)
    return [rx, ry, rz]
}

fn rotate_vector(qx: f64, qy: f64, qz: f64, qw: f64, vx: f64, vy: f64, vz: f64) {
    return rotate_vec3(qx, qy, qz, qw, vx, vy, vz)
}

fn inverse_rotate_vec3(qx: f64, qy: f64, qz: f64, qw: f64, vx: f64, vy: f64, vz: f64) {
    var iq = inverse(qx, qy, qz, qw)
    if oren_is_err(iq) { return iq }
    return rotate_vec3(iq[0], iq[1], iq[2], iq[3], vx, vy, vz)
}

fn inverse_rotate_vector(qx: f64, qy: f64, qz: f64, qw: f64, vx: f64, vy: f64, vz: f64) {
    return inverse_rotate_vec3(qx, qy, qz, qw, vx, vy, vz)
}

fn right(x: f64, y: f64, z: f64, w: f64) {
    return rotate_vec3(x, y, z, w, 1.0, 0.0, 0.0)
}

fn up(x: f64, y: f64, z: f64, w: f64) {
    return rotate_vec3(x, y, z, w, 0.0, 1.0, 0.0)
}

fn forward(x: f64, y: f64, z: f64, w: f64) {
    return rotate_vec3(x, y, z, w, 0.0, 0.0, 1.0)
}

fn nlerp(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, t: f64) {
    var a = _finite4(ax, ay, az, aw, "quat.nlerp")
    if oren_is_err(a) { return a }
    var b = _finite4(bx, by, bz, bw, "quat.nlerp")
    if oren_is_err(b) { return b }
    var ot = _finite_scalar(t, "quat.nlerp")
    if oren_is_err(ot) { return ot }
    var d0 = dot(ax, ay, az, aw, bx, by, bz, bw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    var sx: f64 = bx
    var sy: f64 = by
    var sz: f64 = bz
    var sw: f64 = bw
    if d < 0.0 {
        sx = 0.0 - sx
        sy = 0.0 - sy
        sz = 0.0 - sz
        sw = 0.0 - sw
    }
    var x: f64 = ax + (sx - ax) * t
    var y: f64 = ay + (sy - ay) * t
    var z: f64 = az + (sz - az) * t
    var w: f64 = aw + (sw - aw) * t
    return normalize(x, y, z, w)
}

fn slerp(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, t: f64) {
    var qa = normalize(ax, ay, az, aw)
    if oren_is_err(qa) { return qa }
    var qb = normalize(bx, by, bz, bw)
    if oren_is_err(qb) { return qb }
    var ot = _finite_scalar(t, "quat.slerp")
    if oren_is_err(ot) { return ot }
    var qax: f64 = qa[0]
    var qay: f64 = qa[1]
    var qaz: f64 = qa[2]
    var qaw: f64 = qa[3]
    var qbx: f64 = qb[0]
    var qby: f64 = qb[1]
    var qbz: f64 = qb[2]
    var qbw: f64 = qb[3]
    var d0 = dot(qax, qay, qaz, qaw, qbx, qby, qbz, qbw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    if d < 0.0 {
        d = 0.0 - d
        qbx = 0.0 - qbx
        qby = 0.0 - qby
        qbz = 0.0 - qbz
        qbw = 0.0 - qbw
    }
    if d > 0.9995 {
        return nlerp(qax, qay, qaz, qaw, qbx, qby, qbz, qbw, t)
    }
    var dc = math.clamp(d, 0.0 - 1.0, 1.0)
    if oren_is_err(dc) { return dc }
    var dcl: f64 = dc
    var theta0 = math.acos(dcl)
    if oren_is_err(theta0) { return theta0 }
    var th0: f64 = theta0
    var theta: f64 = th0 * t
    var sin_theta: f64 = math.sin(theta)
    var sin_theta0: f64 = math.sin(th0)
    if sin_theta0 == 0.0 { return nlerp(qax, qay, qaz, qaw, qbx, qby, qbz, qbw, t) }
    var s1: f64 = sin_theta / sin_theta0
    var s0: f64 = math.cos(theta) - dcl * s1
    var x: f64 = s0 * qax + s1 * qbx
    var y: f64 = s0 * qay + s1 * qby
    var z: f64 = s0 * qaz + s1 * qbz
    var w: f64 = s0 * qaw + s1 * qbw
    return normalize(x, y, z, w)
}

fn squad(a, b, c, d, t: f64) {
    var qa = _quat_list4(a, "quat.squad")
    if oren_is_err(qa) { return qa }
    var qb = _quat_list4(b, "quat.squad")
    if oren_is_err(qb) { return qb }
    var qc = _quat_list4(c, "quat.squad")
    if oren_is_err(qc) { return qc }
    var qd = _quat_list4(d, "quat.squad")
    if oren_is_err(qd) { return qd }
    var ab = slerp(a[0], a[1], a[2], a[3], b[0], b[1], b[2], b[3], t)
    if oren_is_err(ab) { return ab }
    var cd = slerp(c[0], c[1], c[2], c[3], d[0], d[1], d[2], d[3], t)
    if oren_is_err(cd) { return cd }
    return slerp(ab[0], ab[1], ab[2], ab[3], cd[0], cd[1], cd[2], cd[3], 2.0 * t * (1.0 - t))
}

fn rotate_toward(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, max_radians: f64) {
    var qa = normalize(ax, ay, az, aw)
    if oren_is_err(qa) { return qa }
    var qb = normalize(bx, by, bz, bw)
    if oren_is_err(qb) { return qb }
    var om = _finite_scalar(max_radians, "quat.rotate_toward")
    if oren_is_err(om) { return om }
    if max_radians < 0.0 { return oren_err(4, "quat.rotate_toward: negative max angle") }
    var dist0 = angle_between(qa[0], qa[1], qa[2], qa[3], qb[0], qb[1], qb[2], qb[3])
    if oren_is_err(dist0) { return dist0 }
    var dist: f64 = dist0
    if dist <= max_radians { return qb }
    if dist == 0.0 { return qb }
    return slerp(qa[0], qa[1], qa[2], qa[3], qb[0], qb[1], qb[2], qb[3], max_radians / dist)
}
