import math "std:math"

fn _finite4(x: f64, y: f64, z: f64, w: f64, ctx) {
    if math.is_nan(x) || math.is_nan(y) || math.is_nan(z) || math.is_nan(w) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) || !math.is_finite(y) || !math.is_finite(z) || !math.is_finite(w) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite3(x: f64, y: f64, z: f64, ctx) {
    if math.is_nan(x) || math.is_nan(y) || math.is_nan(z) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) || !math.is_finite(y) || !math.is_finite(z) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite_scalar(x: f64, ctx) {
    if math.is_nan(x) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn identity() {
    return [0.0, 0.0, 0.0, 1.0]
}

fn length_sq(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "quat.length_sq")
    if oren_is_err(ok) { return ok }
    var out: f64 = x * x + y * y + z * z + w * w
    return out
}

fn length_squared(x: f64, y: f64, z: f64, w: f64) {
    return length_sq(x, y, z, w)
}

fn length(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "quat.length")
    if oren_is_err(ok) { return ok }
    return math.hypot(math.hypot(x, y), math.hypot(z, w))
}

fn normalize(x: f64, y: f64, z: f64, w: f64) {
    var l0 = length(x, y, z, w)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return oren_err(4, "quat.normalize: zero length") }
    return [x / l, y / l, z / l, w / l]
}

fn normalize_or_identity(x: f64, y: f64, z: f64, w: f64) {
    var l0 = length(x, y, z, w)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return identity() }
    return [x / l, y / l, z / l, w / l]
}

fn conjugate(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "quat.conjugate")
    if oren_is_err(ok) { return ok }
    return [0.0 - x, 0.0 - y, 0.0 - z, w]
}

fn dot(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var a = _finite4(ax, ay, az, aw, "quat.dot")
    if oren_is_err(a) { return a }
    var b = _finite4(bx, by, bz, bw, "quat.dot")
    if oren_is_err(b) { return b }
    var out: f64 = ax * bx + ay * by + az * bz + aw * bw
    return out
}

fn inverse(x: f64, y: f64, z: f64, w: f64) {
    var ls0 = length_sq(x, y, z, w)
    if oren_is_err(ls0) { return ls0 }
    var ls: f64 = ls0
    if ls == 0.0 { return oren_err(4, "quat.inverse: zero length") }
    return [(0.0 - x) / ls, (0.0 - y) / ls, (0.0 - z) / ls, w / ls]
}

fn mul(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var a = _finite4(ax, ay, az, aw, "quat.mul")
    if oren_is_err(a) { return a }
    var b = _finite4(bx, by, bz, bw, "quat.mul")
    if oren_is_err(b) { return b }
    var x: f64 = aw * bx + ax * bw + ay * bz - az * by
    var y: f64 = aw * by - ax * bz + ay * bw + az * bx
    var z: f64 = aw * bz + ax * by - ay * bx + az * bw
    var w: f64 = aw * bw - ax * bx - ay * by - az * bz
    return [x, y, z, w]
}

fn multiply(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return mul(ax, ay, az, aw, bx, by, bz, bw)
}

fn from_axis_angle(ax: f64, ay: f64, az: f64, radians: f64) {
    var ok = _finite3(ax, ay, az, "quat.from_axis_angle")
    if oren_is_err(ok) { return ok }
    var ar = _finite_scalar(radians, "quat.from_axis_angle")
    if oren_is_err(ar) { return ar }
    var l0 = math.hypot3(ax, ay, az)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return oren_err(4, "quat.from_axis_angle: zero axis") }
    var half: f64 = radians * 0.5
    var s: f64 = math.sin(half)
    var c: f64 = math.cos(half)
    return [ax / l * s, ay / l * s, az / l * s, c]
}

fn axis_angle(ax: f64, ay: f64, az: f64, radians: f64) {
    return from_axis_angle(ax, ay, az, radians)
}

fn from_euler_xyz(rx: f64, ry: f64, rz: f64) {
    var ok = _finite3(rx, ry, rz, "quat.from_euler_xyz")
    if oren_is_err(ok) { return ok }
    var hx: f64 = rx * 0.5
    var hy: f64 = ry * 0.5
    var hz: f64 = rz * 0.5
    var sx: f64 = math.sin(hx)
    var cx: f64 = math.cos(hx)
    var sy: f64 = math.sin(hy)
    var cy: f64 = math.cos(hy)
    var sz: f64 = math.sin(hz)
    var cz: f64 = math.cos(hz)
    return normalize(
        cz * cy * sx - sz * sy * cx,
        cz * sy * cx + sz * cy * sx,
        sz * cy * cx - cz * sy * sx,
        cz * cy * cx + sz * sy * sx
    )
}

fn euler_xyz(rx: f64, ry: f64, rz: f64) {
    return from_euler_xyz(rx, ry, rz)
}

fn from_euler(rx: f64, ry: f64, rz: f64) {
    return from_euler_xyz(rx, ry, rz)
}

fn from_to_rotation(from_x: f64, from_y: f64, from_z: f64, to_x: f64, to_y: f64, to_z: f64) {
    var f_ok = _finite3(from_x, from_y, from_z, "quat.from_to_rotation")
    if oren_is_err(f_ok) { return f_ok }
    var t_ok = _finite3(to_x, to_y, to_z, "quat.from_to_rotation")
    if oren_is_err(t_ok) { return t_ok }
    var fl0 = math.hypot3(from_x, from_y, from_z)
    if oren_is_err(fl0) { return fl0 }
    var tl0 = math.hypot3(to_x, to_y, to_z)
    if oren_is_err(tl0) { return tl0 }
    var fl: f64 = fl0
    var tl: f64 = tl0
    if fl == 0.0 { return oren_err(4, "quat.from_to_rotation: zero from") }
    if tl == 0.0 { return oren_err(4, "quat.from_to_rotation: zero to") }
    var fx: f64 = from_x / fl
    var fy: f64 = from_y / fl
    var fz: f64 = from_z / fl
    var tx: f64 = to_x / tl
    var ty: f64 = to_y / tl
    var tz: f64 = to_z / tl
    var d: f64 = fx * tx + fy * ty + fz * tz
    if d > 0.999999999 { return identity() }
    if d < -0.999999999 {
        var ax: f64 = 0.0
        var ay: f64 = fz
        var az: f64 = 0.0 - fy
        var afx: f64 = fx
        if afx < 0.0 { afx = 0.0 - afx }
        if afx > 0.9 {
            ax = 0.0 - fz
            ay = 0.0
            az = fx
        }
        return from_axis_angle(ax, ay, az, math.pi())
    }
    var cx: f64 = fy * tz - fz * ty
    var cy: f64 = fz * tx - fx * tz
    var cz: f64 = fx * ty - fy * tx
    return normalize(cx, cy, cz, 1.0 + d)
}

fn rotation_between(from_x: f64, from_y: f64, from_z: f64, to_x: f64, to_y: f64, to_z: f64) {
    return from_to_rotation(from_x, from_y, from_z, to_x, to_y, to_z)
}

fn from_vectors(from_x: f64, from_y: f64, from_z: f64, to_x: f64, to_y: f64, to_z: f64) {
    return from_to_rotation(from_x, from_y, from_z, to_x, to_y, to_z)
}

fn rotate_vec3(qx: f64, qy: f64, qz: f64, qw: f64, vx: f64, vy: f64, vz: f64) {
    var q = normalize(qx, qy, qz, qw)
    if oren_is_err(q) { return q }
    var ok = _finite3(vx, vy, vz, "quat.rotate_vec3")
    if oren_is_err(ok) { return ok }
    var x: f64 = q[0]
    var y: f64 = q[1]
    var z: f64 = q[2]
    var w: f64 = q[3]
    var tx: f64 = 2.0 * (y * vz - z * vy)
    var ty: f64 = 2.0 * (z * vx - x * vz)
    var tz: f64 = 2.0 * (x * vy - y * vx)
    var rx: f64 = vx + w * tx + (y * tz - z * ty)
    var ry: f64 = vy + w * ty + (z * tx - x * tz)
    var rz: f64 = vz + w * tz + (x * ty - y * tx)
    return [rx, ry, rz]
}

fn rotate_vector(qx: f64, qy: f64, qz: f64, qw: f64, vx: f64, vy: f64, vz: f64) {
    return rotate_vec3(qx, qy, qz, qw, vx, vy, vz)
}

fn nlerp(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, t: f64) {
    var a = _finite4(ax, ay, az, aw, "quat.nlerp")
    if oren_is_err(a) { return a }
    var b = _finite4(bx, by, bz, bw, "quat.nlerp")
    if oren_is_err(b) { return b }
    var ot = _finite_scalar(t, "quat.nlerp")
    if oren_is_err(ot) { return ot }
    var d0 = dot(ax, ay, az, aw, bx, by, bz, bw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    var sx: f64 = bx
    var sy: f64 = by
    var sz: f64 = bz
    var sw: f64 = bw
    if d < 0.0 {
        sx = 0.0 - sx
        sy = 0.0 - sy
        sz = 0.0 - sz
        sw = 0.0 - sw
    }
    var x: f64 = ax + (sx - ax) * t
    var y: f64 = ay + (sy - ay) * t
    var z: f64 = az + (sz - az) * t
    var w: f64 = aw + (sw - aw) * t
    return normalize(x, y, z, w)
}

fn slerp(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, t: f64) {
    var qa = normalize(ax, ay, az, aw)
    if oren_is_err(qa) { return qa }
    var qb = normalize(bx, by, bz, bw)
    if oren_is_err(qb) { return qb }
    var ot = _finite_scalar(t, "quat.slerp")
    if oren_is_err(ot) { return ot }
    var qax: f64 = qa[0]
    var qay: f64 = qa[1]
    var qaz: f64 = qa[2]
    var qaw: f64 = qa[3]
    var qbx: f64 = qb[0]
    var qby: f64 = qb[1]
    var qbz: f64 = qb[2]
    var qbw: f64 = qb[3]
    var d0 = dot(qax, qay, qaz, qaw, qbx, qby, qbz, qbw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    if d < 0.0 {
        d = 0.0 - d
        qbx = 0.0 - qbx
        qby = 0.0 - qby
        qbz = 0.0 - qbz
        qbw = 0.0 - qbw
    }
    if d > 0.9995 {
        return nlerp(qax, qay, qaz, qaw, qbx, qby, qbz, qbw, t)
    }
    var dc = math.clamp(d, 0.0 - 1.0, 1.0)
    if oren_is_err(dc) { return dc }
    var dcl: f64 = dc
    var theta0 = math.acos(dcl)
    if oren_is_err(theta0) { return theta0 }
    var th0: f64 = theta0
    var theta: f64 = th0 * t
    var sin_theta: f64 = math.sin(theta)
    var sin_theta0: f64 = math.sin(th0)
    if sin_theta0 == 0.0 { return nlerp(qax, qay, qaz, qaw, qbx, qby, qbz, qbw, t) }
    var s1: f64 = sin_theta / sin_theta0
    var s0: f64 = math.cos(theta) - dcl * s1
    var x: f64 = s0 * qax + s1 * qbx
    var y: f64 = s0 * qay + s1 * qby
    var z: f64 = s0 * qaz + s1 * qbz
    var w: f64 = s0 * qaw + s1 * qbw
    return normalize(x, y, z, w)
}
