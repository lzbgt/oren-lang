}

fn scalbn(x: f64, y: f64, z: f64, w: f64, nx, ny, nz, nw) {
    return ldexp(x, y, z, w, nx, ny, nz, nw)
}

fn scalbln(x: f64, y: f64, z: f64, w: f64, nx, ny, nz, nw) {
    return ldexp(x, y, z, w, nx, ny, nz, nw)
}

fn frexp(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.frexp")
    if oren_is_err(ok) { return ok }
    var fx = math.frexp(x)
    if oren_is_err(fx) { return fx }
    var fy = math.frexp(y)
    if oren_is_err(fy) { return fy }
    var fz = math.frexp(z)
    if oren_is_err(fz) { return fz }
    var fw = math.frexp(w)
    if oren_is_err(fw) { return fw }
    return [fx[0], fy[0], fz[0], fw[0], fx[1], fy[1], fz[1], fw[1]]
}

fn ilogb(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.ilogb")
