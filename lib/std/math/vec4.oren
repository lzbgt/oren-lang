import math "std:math"

fn _finite4(x: f64, y: f64, z: f64, w: f64, ctx) {
    if math.is_nan(x) || math.is_nan(y) || math.is_nan(z) || math.is_nan(w) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) || !math.is_finite(y) || !math.is_finite(z) || !math.is_finite(w) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite8(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, ctx) {
    var a = _finite4(ax, ay, az, aw, ctx)
    if oren_is_err(a) { return a }
    return _finite4(bx, by, bz, bw, ctx)
}

fn _finite12(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, cx: f64, cy: f64, cz: f64, cw: f64, ctx) {
    var a = _finite8(ax, ay, az, aw, bx, by, bz, bw, ctx)
    if oren_is_err(a) { return a }
    return _finite4(cx, cy, cz, cw, ctx)
}

fn _check_vec4(v, ctx) {
    if oren_list_len(v) != 4 { return oren_err(4, ctx + ": expected 4 values") }
    return _finite4(v[0], v[1], v[2], v[3], ctx)
}

fn _finite_scalar(x: f64, ctx) {
    if math.is_nan(x) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn is_nan(x: f64, y: f64, z: f64, w: f64) {
    return [math.is_nan(x), math.is_nan(y), math.is_nan(z), math.is_nan(w)]
}

fn isnan(x: f64, y: f64, z: f64, w: f64) {
    return is_nan(x, y, z, w)
}

fn is_inf(x: f64, y: f64, z: f64, w: f64) {
    return [math.is_inf(x), math.is_inf(y), math.is_inf(z), math.is_inf(w)]
}

fn isinf(x: f64, y: f64, z: f64, w: f64) {
    return is_inf(x, y, z, w)
}

fn is_finite(x: f64, y: f64, z: f64, w: f64) {
    return [math.is_finite(x), math.is_finite(y), math.is_finite(z), math.is_finite(w)]
}

fn isfinite(x: f64, y: f64, z: f64, w: f64) {
    return is_finite(x, y, z, w)
}

fn is_subnormal(x: f64, y: f64, z: f64, w: f64) {
    return [math.is_subnormal(x), math.is_subnormal(y), math.is_subnormal(z), math.is_subnormal(w)]
}

fn is_normal(x: f64, y: f64, z: f64, w: f64) {
    return [math.is_normal(x), math.is_normal(y), math.is_normal(z), math.is_normal(w)]
}

fn isnormal(x: f64, y: f64, z: f64, w: f64) {
    return is_normal(x, y, z, w)
}

fn fpclassify(x: f64, y: f64, z: f64, w: f64) {
    return [math.fpclassify(x), math.fpclassify(y), math.fpclassify(z), math.fpclassify(w)]
}

fn isunordered(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return [math.isunordered(ax, bx), math.isunordered(ay, by), math.isunordered(az, bz), math.isunordered(aw, bw)]
}

fn isgreater(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return [math.isgreater(ax, bx), math.isgreater(ay, by), math.isgreater(az, bz), math.isgreater(aw, bw)]
}

fn isgreaterequal(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return [math.isgreaterequal(ax, bx), math.isgreaterequal(ay, by), math.isgreaterequal(az, bz), math.isgreaterequal(aw, bw)]
}

fn isless(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return [math.isless(ax, bx), math.isless(ay, by), math.isless(az, bz), math.isless(aw, bw)]
}

fn islessequal(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return [math.islessequal(ax, bx), math.islessequal(ay, by), math.islessequal(az, bz), math.islessequal(aw, bw)]
}

fn islessgreater(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return [math.islessgreater(ax, bx), math.islessgreater(ay, by), math.islessgreater(az, bz), math.islessgreater(aw, bw)]
}

fn signbit(x: f64, y: f64, z: f64, w: f64) {
    return [math.signbit(x), math.signbit(y), math.signbit(z), math.signbit(w)]
}

fn copysign(x: f64, y: f64, z: f64, w: f64, sx: f64, sy: f64, sz: f64, sw: f64) {
    return [math.copysign(x, sx), math.copysign(y, sy), math.copysign(z, sz), math.copysign(w, sw)]
}

fn fabs(x: f64, y: f64, z: f64, w: f64) {
    return [math.fabs(x), math.fabs(y), math.fabs(z), math.fabs(w)]
}

fn fmin(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return [math.fmin(ax, bx), math.fmin(ay, by), math.fmin(az, bz), math.fmin(aw, bw)]
}

fn fmax(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return [math.fmax(ax, bx), math.fmax(ay, by), math.fmax(az, bz), math.fmax(aw, bw)]
}

fn add(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.add")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax + bx
    var y: f64 = ay + by
    var z: f64 = az + bz
    var w: f64 = aw + bw
    return [x, y, z, w]
}

fn sub(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.sub")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax - bx
    var y: f64 = ay - by
    var z: f64 = az - bz
    var w: f64 = aw - bw
    return [x, y, z, w]
}

fn scale(x: f64, y: f64, z: f64, w: f64, s: f64) {
    var ok = _finite4(x, y, z, w, "vec4.scale")
    if oren_is_err(ok) { return ok }
    var os = _finite_scalar(s, "vec4.scale")
    if oren_is_err(os) { return os }
    var ox: f64 = x * s
    var oy: f64 = y * s
    var oz: f64 = z * s
    var ow: f64 = w * s
    return [ox, oy, oz, ow]
}

fn lerp(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, t: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.lerp")
    if oren_is_err(ok) { return ok }
    var ot = _finite_scalar(t, "vec4.lerp")
    if oren_is_err(ot) { return ot }
    var x: f64 = ax + (bx - ax) * t
    var y: f64 = ay + (by - ay) * t
    var z: f64 = az + (bz - az) * t
    var w: f64 = aw + (bw - aw) * t
    return [x, y, z, w]
}

fn midpoint(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.midpoint")
    if oren_is_err(ok) { return ok }
    return [math.midpoint(ax, bx), math.midpoint(ay, by), math.midpoint(az, bz), math.midpoint(aw, bw)]
}

fn isclose_abs(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, abs_tol: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.isclose_abs")
    if oren_is_err(ok) { return ok }
    var cx = math.isclose_abs(ax, bx, abs_tol)
    if oren_is_err(cx) { return cx }
    var cy = math.isclose_abs(ay, by, abs_tol)
    if oren_is_err(cy) { return cy }
    var cz = math.isclose_abs(az, bz, abs_tol)
    if oren_is_err(cz) { return cz }
    var cw = math.isclose_abs(aw, bw, abs_tol)
    if oren_is_err(cw) { return cw }
    return [cx, cy, cz, cw]
}

fn isclose(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, rel_tol: f64, abs_tol: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.isclose")
    if oren_is_err(ok) { return ok }
    var cx = math.isclose(ax, bx, rel_tol, abs_tol)
    if oren_is_err(cx) { return cx }
    var cy = math.isclose(ay, by, rel_tol, abs_tol)
    if oren_is_err(cy) { return cy }
    var cz = math.isclose(az, bz, rel_tol, abs_tol)
    if oren_is_err(cz) { return cz }
    var cw = math.isclose(aw, bw, rel_tol, abs_tol)
    if oren_is_err(cw) { return cw }
    return [cx, cy, cz, cw]
}

fn abs(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.abs")
    if oren_is_err(ok) { return ok }
    return [math.fabs(x), math.fabs(y), math.fabs(z), math.fabs(w)]
}

fn sign(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.sign")
    if oren_is_err(ok) { return ok }
    var sx: f64 = x
    var sy: f64 = y
    var sz: f64 = z
    var sw: f64 = w
    if x > 0.0 { sx = 1.0 }
    if x < 0.0 { sx = 0.0 - 1.0 }
    if y > 0.0 { sy = 1.0 }
    if y < 0.0 { sy = 0.0 - 1.0 }
    if z > 0.0 { sz = 1.0 }
    if z < 0.0 { sz = 0.0 - 1.0 }
    if w > 0.0 { sw = 1.0 }
    if w < 0.0 { sw = 0.0 - 1.0 }
    return [sx, sy, sz, sw]
}

fn sqrt(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.sqrt")
    if oren_is_err(ok) { return ok }
    if x < 0.0 || y < 0.0 || z < 0.0 || w < 0.0 { return oren_err(4, "vec4.sqrt: domain") }
    return [math.sqrt(x), math.sqrt(y), math.sqrt(z), math.sqrt(w)]
}

fn cbrt(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.cbrt")
    if oren_is_err(ok) { return ok }
    return [math.cbrt(x), math.cbrt(y), math.cbrt(z), math.cbrt(w)]
}

fn powi(x: f64, y: f64, z: f64, w: f64, nx, ny, nz, nw) {
    var ok = _finite4(x, y, z, w, "vec4.powi")
