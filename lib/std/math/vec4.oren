fn log(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.log")
    if oren_is_err(ok) { return ok }
    if x <= 0.0 || y <= 0.0 || z <= 0.0 || w <= 0.0 { return oren_err(4, "vec4.log: domain") }
    return [math.log(x), math.log(y), math.log(z), math.log(w)]
}

fn log2(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.log2")
