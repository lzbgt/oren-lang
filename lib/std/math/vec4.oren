}

fn tgamma(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.tgamma")
    if oren_is_err(ok) { return ok }
    var ox = math.tgamma(x)
    if oren_is_err(ox) { return ox }
    var oy = math.tgamma(y)
    if oren_is_err(oy) { return oy }
    var oz = math.tgamma(z)
    if oren_is_err(oz) { return oz }
