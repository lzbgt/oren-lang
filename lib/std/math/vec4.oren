    return [math.atan(x), math.atan(y), math.atan(z), math.atan(w)]
}

fn atan2(yx: f64, yy: f64, yz: f64, yw: f64, xx: f64, xy: f64, xz: f64, xw: f64) {
    var ok = _finite8(yx, yy, yz, yw, xx, xy, xz, xw, "vec4.atan2")
    if oren_is_err(ok) { return ok }
    return [math.atan2(yx, xx), math.atan2(yy, xy), math.atan2(yz, xz), math.atan2(yw, xw)]
}

fn min(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.min")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax
    var y: f64 = ay
    var z: f64 = az
    var w: f64 = aw
    if bx < x { x = bx }
    if by < y { y = by }
    if bz < z { z = bz }
    if bw < w { w = bw }
    return [x, y, z, w]
}

fn max(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.max")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax
    var y: f64 = ay
    var z: f64 = az
    var w: f64 = aw
    if bx > x { x = bx }
    if by > y { y = by }
    if bz > z { z = bz }
    if bw > w { w = bw }
    return [x, y, z, w]
}

fn clamp(x: f64, y: f64, z: f64, w: f64, lo_x: f64, lo_y: f64, lo_z: f64, lo_w: f64, hi_x: f64, hi_y: f64, hi_z: f64, hi_w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.clamp")
    if oren_is_err(ok) { return ok }
    ok = _finite8(lo_x, lo_y, lo_z, lo_w, hi_x, hi_y, hi_z, hi_w, "vec4.clamp")
    if oren_is_err(ok) { return ok }
    if hi_x < lo_x || hi_y < lo_y || hi_z < lo_z || hi_w < lo_w { return oren_err(4, "vec4.clamp: hi < lo") }
    var ox: f64 = x
    var oy: f64 = y
    var oz: f64 = z
    var ow: f64 = w
    if ox < lo_x { ox = lo_x }
    if ox > hi_x { ox = hi_x }
    if oy < lo_y { oy = lo_y }
    if oy > hi_y { oy = hi_y }
    if oz < lo_z { oz = lo_z }
    if oz > hi_z { oz = hi_z }
    if ow < lo_w { ow = lo_w }
    if ow > hi_w { ow = hi_w }
    return [ox, oy, oz, ow]
}

fn length_sq(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.length_sq")
    if oren_is_err(ok) { return ok }
    var out: f64 = x * x + y * y + z * z + w * w
    return out
}

fn length_squared(x: f64, y: f64, z: f64, w: f64) {
    return length_sq(x, y, z, w)
}

fn length(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.length")
    if oren_is_err(ok) { return ok }
    var ax: f64 = math.fabs(x)
    var ay: f64 = math.fabs(y)
    var az: f64 = math.fabs(z)
    var aw: f64 = math.fabs(w)
    var m: f64 = ax
    if ay > m { m = ay }
    if az > m { m = az }
    if aw > m { m = aw }
    if m == 0.0 { return 0.0 }
    var sx: f64 = x / m
    var sy: f64 = y / m
    var sz: f64 = z / m
    var sw: f64 = w / m
    var r0 = math.sqrt(sx * sx + sy * sy + sz * sz + sw * sw)
    if oren_is_err(r0) { return r0 }
    var r: f64 = r0
    return m * r
}

fn distance_sq(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.distance_sq")
    if oren_is_err(ok) { return ok }
    var dx: f64 = bx - ax
    var dy: f64 = by - ay
    var dz: f64 = bz - az
    var dw: f64 = bw - aw
    var out: f64 = dx * dx + dy * dy + dz * dz + dw * dw
    return out
}

fn distance_squared(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return distance_sq(ax, ay, az, aw, bx, by, bz, bw)
}

fn distance(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.distance")
    if oren_is_err(ok) { return ok }
    return length(bx - ax, by - ay, bz - az, bw - aw)
}

fn dot(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.dot")
    if oren_is_err(ok) { return ok }
    var out: f64 = ax * bx + ay * by + az * bz + aw * bw
    return out
}

fn normalize(x: f64, y: f64, z: f64, w: f64) {
    var l0 = length(x, y, z, w)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return oren_err(4, "vec4.normalize: zero length") }
    return [x / l, y / l, z / l, w / l]
}

fn normalize_or_zero(x: f64, y: f64, z: f64, w: f64) {
    var l0 = length(x, y, z, w)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 { return [0.0, 0.0, 0.0, 0.0] }
    return [x / l, y / l, z / l, w / l]
}

fn clamp_length(x: f64, y: f64, z: f64, w: f64, max_len: f64) {
    var ok = _finite_scalar(max_len, "vec4.clamp_length")
    if oren_is_err(ok) { return ok }
    if max_len < 0.0 { return oren_err(4, "vec4.clamp_length: negative max_len") }
    var l0 = length(x, y, z, w)
    if oren_is_err(l0) { return l0 }
    var l: f64 = l0
    if l == 0.0 || l <= max_len { return [x, y, z, w] }
    var s: f64 = max_len / l
    return [x * s, y * s, z * s, w * s]
}

fn clamp_len(x: f64, y: f64, z: f64, w: f64, max_len: f64) {
    return clamp_length(x, y, z, w, max_len)
}

fn limit_length(x: f64, y: f64, z: f64, w: f64, max_len: f64) {
    return clamp_length(x, y, z, w, max_len)
}

fn direction_to(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    return normalize(bx - ax, by - ay, bz - az, bw - aw)
}

fn move_toward(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, delta: f64) {
    var ok = _finite_scalar(delta, "vec4.move_toward")
    if oren_is_err(ok) { return ok }
    if delta < 0.0 { return oren_err(4, "vec4.move_toward: negative delta") }
    var d0 = distance(ax, ay, az, aw, bx, by, bz, bw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    if d == 0.0 || d <= delta { return [bx, by, bz, bw] }
    var s: f64 = delta / d
    return [ax + (bx - ax) * s, ay + (by - ay) * s, az + (bz - az) * s, aw + (bw - aw) * s]
}

fn closest_point_on_segment(px: f64, py: f64, pz: f64, pw: f64, ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite12(px, py, pz, pw, ax, ay, az, aw, bx, by, bz, bw, "vec4.closest_point_on_segment")
    if oren_is_err(ok) { return ok }
    var vx: f64 = bx - ax
    var vy: f64 = by - ay
    var vz: f64 = bz - az
    var vw: f64 = bw - aw
    var len: f64 = vx * vx + vy * vy + vz * vz + vw * vw
    if len == 0.0 { return [ax, ay, az, aw] }
    var t: f64 = ((px - ax) * vx + (py - ay) * vy + (pz - az) * vz + (pw - aw) * vw) / len
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    return [ax + vx * t, ay + vy * t, az + vz * t, aw + vw * t]
}

fn distance_to_segment(px: f64, py: f64, pz: f64, pw: f64, ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var p = closest_point_on_segment(px, py, pz, pw, ax, ay, az, aw, bx, by, bz, bw)
    if oren_is_err(p) { return p }
    return distance(px, py, pz, pw, p[0], p[1], p[2], p[3])
}

fn project(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var d0 = dot(bx, by, bz, bw, bx, by, bz, bw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    if d == 0.0 { return oren_err(4, "vec4.project: zero target") }
    var n0 = dot(ax, ay, az, aw, bx, by, bz, bw)
    if oren_is_err(n0) { return n0 }
    var n: f64 = n0
    var s: f64 = n / d
    return scale(bx, by, bz, bw, s)
}

fn reject(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var p = project(ax, ay, az, aw, bx, by, bz, bw)
    if oren_is_err(p) { return p }
    var px: f64 = p[0]
    var py: f64 = p[1]
    var pz: f64 = p[2]
    var pw: f64 = p[3]
    return sub(ax, ay, az, aw, px, py, pz, pw)
}

fn reflect(x: f64, y: f64, z: f64, w: f64, nx: f64, ny: f64, nz: f64, nw: f64) {
    var n = normalize(nx, ny, nz, nw)
    if oren_is_err(n) { return n }
    var ux: f64 = n[0]
    var uy: f64 = n[1]
    var uz: f64 = n[2]
    var uw: f64 = n[3]
    var d0 = dot(x, y, z, w, ux, uy, uz, uw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    var rx: f64 = x - 2.0 * d * ux
    var ry: f64 = y - 2.0 * d * uy
    var rz: f64 = z - 2.0 * d * uz
    var rw: f64 = w - 2.0 * d * uw
    return [rx, ry, rz, rw]
}

fn faceforward(nx: f64, ny: f64, nz: f64, nw: f64, ix: f64, iy: f64, iz: f64, iw: f64, nrefx: f64, nrefy: f64, nrefz: f64, nrefw: f64) {
    var ok = _finite4(nx, ny, nz, nw, "vec4.faceforward")
    if oren_is_err(ok) { return ok }
    var d0 = dot(nrefx, nrefy, nrefz, nrefw, ix, iy, iz, iw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    if d < 0.0 { return [nx, ny, nz, nw] }
    return [0.0 - nx, 0.0 - ny, 0.0 - nz, 0.0 - nw]
}

fn refract(x: f64, y: f64, z: f64, w: f64, nx: f64, ny: f64, nz: f64, nw: f64, eta: f64) {
    var ok = _finite_scalar(eta, "vec4.refract")
    if oren_is_err(ok) { return ok }
    var n = normalize(nx, ny, nz, nw)
    if oren_is_err(n) { return n }
    var ux: f64 = n[0]
    var uy: f64 = n[1]
    var uz: f64 = n[2]
    var uw: f64 = n[3]
    var d0 = dot(x, y, z, w, ux, uy, uz, uw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    var k: f64 = 1.0 - eta * eta * (1.0 - d * d)
    if k < 0.0 { return [0.0, 0.0, 0.0, 0.0] }
    var s: f64 = math.sqrt(k)
    var t: f64 = eta * d + s
    return [eta * x - t * ux, eta * y - t * uy, eta * z - t * uz, eta * w - t * uw]
}

fn angle_between(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var la0 = length(ax, ay, az, aw)
    if oren_is_err(la0) { return la0 }
    var lb0 = length(bx, by, bz, bw)
    if oren_is_err(lb0) { return lb0 }
    var la: f64 = la0
    var lb: f64 = lb0
    if la == 0.0 || lb == 0.0 { return oren_err(4, "vec4.angle_between: zero length") }
    var d0 = dot(ax, ay, az, aw, bx, by, bz, bw)
    if oren_is_err(d0) { return d0 }
    var d: f64 = d0
    var c = math.clamp(d / (la * lb), 0.0 - 1.0, 1.0)
    if oren_is_err(c) { return c }
    var cf: f64 = c
    return math.acos(cf)
}
