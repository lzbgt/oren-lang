import math "std:math"

fn _finite4(x: f64, y: f64, z: f64, w: f64, ctx) {
    if math.is_nan(x) || math.is_nan(y) || math.is_nan(z) || math.is_nan(w) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) || !math.is_finite(y) || !math.is_finite(z) || !math.is_finite(w) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn _finite8(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, ctx) {
    var a = _finite4(ax, ay, az, aw, ctx)
    if oren_is_err(a) { return a }
    return _finite4(bx, by, bz, bw, ctx)
}

fn _check_vec4(v, ctx) {
    if oren_list_len(v) != 4 { return oren_err(4, ctx + ": expected 4 values") }
    return _finite4(v[0], v[1], v[2], v[3], ctx)
}

fn _finite_scalar(x: f64, ctx) {
    if math.is_nan(x) { return oren_err(4, ctx + ": NaN") }
    if !math.is_finite(x) { return oren_err(4, ctx + ": non-finite") }
    return 0
}

fn add(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.add")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax + bx
    var y: f64 = ay + by
    var z: f64 = az + bz
    var w: f64 = aw + bw
    return [x, y, z, w]
}

fn sub(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.sub")
    if oren_is_err(ok) { return ok }
    var x: f64 = ax - bx
    var y: f64 = ay - by
    var z: f64 = az - bz
    var w: f64 = aw - bw
    return [x, y, z, w]
}

fn scale(x: f64, y: f64, z: f64, w: f64, s: f64) {
    var ok = _finite4(x, y, z, w, "vec4.scale")
    if oren_is_err(ok) { return ok }
    var os = _finite_scalar(s, "vec4.scale")
    if oren_is_err(os) { return os }
    var ox: f64 = x * s
    var oy: f64 = y * s
    var oz: f64 = z * s
    var ow: f64 = w * s
    return [ox, oy, oz, ow]
}

fn lerp(ax: f64, ay: f64, az: f64, aw: f64, bx: f64, by: f64, bz: f64, bw: f64, t: f64) {
    var ok = _finite8(ax, ay, az, aw, bx, by, bz, bw, "vec4.lerp")
    if oren_is_err(ok) { return ok }
    var ot = _finite_scalar(t, "vec4.lerp")
    if oren_is_err(ot) { return ot }
    var x: f64 = ax + (bx - ax) * t
    var y: f64 = ay + (by - ay) * t
    var z: f64 = az + (bz - az) * t
    var w: f64 = aw + (bw - aw) * t
    return [x, y, z, w]
}

fn abs(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.abs")
    if oren_is_err(ok) { return ok }
    return [math.fabs(x), math.fabs(y), math.fabs(z), math.fabs(w)]
}

fn sign(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.sign")
    if oren_is_err(ok) { return ok }
    var sx: f64 = x
    var sy: f64 = y
    var sz: f64 = z
    var sw: f64 = w
    if x > 0.0 { sx = 1.0 }
    if x < 0.0 { sx = 0.0 - 1.0 }
    if y > 0.0 { sy = 1.0 }
    if y < 0.0 { sy = 0.0 - 1.0 }
    if z > 0.0 { sz = 1.0 }
    if z < 0.0 { sz = 0.0 - 1.0 }
    if w > 0.0 { sw = 1.0 }
    if w < 0.0 { sw = 0.0 - 1.0 }
    return [sx, sy, sz, sw]
}

fn sqrt(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.sqrt")
    if oren_is_err(ok) { return ok }
    if x < 0.0 || y < 0.0 || z < 0.0 || w < 0.0 { return oren_err(4, "vec4.sqrt: domain") }
    return [math.sqrt(x), math.sqrt(y), math.sqrt(z), math.sqrt(w)]
}

fn cbrt(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.cbrt")
    if oren_is_err(ok) { return ok }
    return [math.cbrt(x), math.cbrt(y), math.cbrt(z), math.cbrt(w)]
}

fn pow(x: f64, y: f64, z: f64, w: f64, ex: f64, ey: f64, ez: f64, ew: f64) {
    var ok = _finite8(x, y, z, w, ex, ey, ez, ew, "vec4.pow")
    if oren_is_err(ok) { return ok }
    var ox = math.pow(x, ex)
    if oren_is_err(ox) { return ox }
    var oy = math.pow(y, ey)
    if oren_is_err(oy) { return oy }
    var oz = math.pow(z, ez)
    if oren_is_err(oz) { return oz }
    var ow = math.pow(w, ew)
    if oren_is_err(ow) { return ow }
    return [ox, oy, oz, ow]
}

fn power(x: f64, y: f64, z: f64, w: f64, ex: f64, ey: f64, ez: f64, ew: f64) {
    return pow(x, y, z, w, ex, ey, ez, ew)
}

fn erf(x: f64, y: f64, z: f64, w: f64) {
    var ok = _finite4(x, y, z, w, "vec4.erf")
    if oren_is_err(ok) { return ok }
    return [math.erf(x), math.erf(y), math.erf(z), math.erf(w)]
}

