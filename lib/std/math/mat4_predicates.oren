import chk "std:math/mat4_checks"
import math "std:math"

fn _shape_cell_ok(v: f64, idx: i64, diag0: f64, diag5: f64, diag10: f64, diag15: f64, allow_translation: bool, abs_tol: f64, ctx) {
    var expect: f64 = 0.0
    var fixed = true
    if idx == 0 { expect = diag0 }
    else if idx == 5 { expect = diag5 }
    else if idx == 10 { expect = diag10 }
    else if idx == 15 { expect = diag15 }
    else if allow_translation && (idx == 3 || idx == 7 || idx == 11) { fixed = false }
    if !fixed { return true }
    return chk._close_abs_scalar(v, expect, abs_tol, ctx)
}

fn _shape_abs4(m, base: i64, diag0: f64, diag5: f64, diag10: f64, diag15: f64, allow_translation: bool, abs_tol: f64, ctx) {
    var ok = _shape_cell_ok(m[base], base, diag0, diag5, diag10, diag15, allow_translation, abs_tol, ctx)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _shape_cell_ok(m[base + 1], base + 1, diag0, diag5, diag10, diag15, allow_translation, abs_tol, ctx)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _shape_cell_ok(m[base + 2], base + 2, diag0, diag5, diag10, diag15, allow_translation, abs_tol, ctx)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _shape_cell_ok(m[base + 3], base + 3, diag0, diag5, diag10, diag15, allow_translation, abs_tol, ctx)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return true
}

fn _shape_abs(m, diag0: f64, diag5: f64, diag10: f64, diag15: f64, allow_translation: bool, abs_tol: f64, ctx) {
    var ok = chk._check(m, ctx)
    if oren_is_err(ok) { return ok }
    ok = _shape_abs4(m, 0, diag0, diag5, diag10, diag15, allow_translation, abs_tol, ctx)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _shape_abs4(m, 4, diag0, diag5, diag10, diag15, allow_translation, abs_tol, ctx)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _shape_abs4(m, 8, diag0, diag5, diag10, diag15, allow_translation, abs_tol, ctx)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return _shape_abs4(m, 12, diag0, diag5, diag10, diag15, allow_translation, abs_tol, ctx)
}

fn _basis_dot(x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64, ctx) {
    var out: f64 = x0 * x1 + y0 * y1 + z0 * z1
    var ok = chk._finite_scalar(out, ctx)
    if oren_is_err(ok) { return ok }
    return out
}

fn is_finite(m) {
    return !oren_is_err(chk._check(m, "mat4.is_finite"))
}

fn isfinite(m) {
    return is_finite(m)
}

fn is_affine(m) {
    var ok = chk._check(m, "mat4.is_affine")
    if oren_is_err(ok) { return false }
    var m12: f64 = m[12]
    var m13: f64 = m[13]
    var m14: f64 = m[14]
    var m15: f64 = m[15]
    if m12 != 0.0 { return false }
    if m13 != 0.0 { return false }
    if m14 != 0.0 { return false }
    if m15 != 1.0 { return false }
    return true
}

fn is_affine_abs(m, abs_tol: f64) {
    var ok = chk._check(m, "mat4.is_affine_abs")
    if oren_is_err(ok) { return ok }
    ok = math.isclose_abs(m[12], 0.0, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = math.isclose_abs(m[13], 0.0, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = math.isclose_abs(m[14], 0.0, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return math.isclose_abs(m[15], 1.0, abs_tol)
}

fn has_perspective(m) {
    var ok = chk._check(m, "mat4.has_perspective")
    if oren_is_err(ok) { return false }
    return !is_affine(m)
}

fn has_perspective_abs(m, abs_tol: f64) {
    var ok = is_affine_abs(m, abs_tol)
    if oren_is_err(ok) { return ok }
    return !ok
}

fn equals(a, b) {
    var ca = chk._check(a, "mat4.equals")
    if oren_is_err(ca) { return ca }
    var cb = chk._check(b, "mat4.equals")
    if oren_is_err(cb) { return cb }
    if a[0] != b[0] { return false }
    if a[1] != b[1] { return false }
    if a[2] != b[2] { return false }
    if a[3] != b[3] { return false }
    if a[4] != b[4] { return false }
    if a[5] != b[5] { return false }
    if a[6] != b[6] { return false }
    if a[7] != b[7] { return false }
    if a[8] != b[8] { return false }
    if a[9] != b[9] { return false }
    if a[10] != b[10] { return false }
    if a[11] != b[11] { return false }
    if a[12] != b[12] { return false }
    if a[13] != b[13] { return false }
    if a[14] != b[14] { return false }
    if a[15] != b[15] { return false }
    return true
}

fn _allclose_abs4(a0: f64, b0: f64, a1: f64, b1: f64, a2: f64, b2: f64, a3: f64, b3: f64, abs_tol: f64) {
    var ok = math.isclose_abs(a0, b0, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = math.isclose_abs(a1, b1, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = math.isclose_abs(a2, b2, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = math.isclose_abs(a3, b3, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return true
}

fn allclose_abs(a, b, abs_tol: f64) {
    var ca = chk._check(a, "mat4.allclose_abs")
    if oren_is_err(ca) { return ca }
    var cb = chk._check(b, "mat4.allclose_abs")
    if oren_is_err(cb) { return cb }
    var ok = _allclose_abs4(a[0], b[0], a[1], b[1], a[2], b[2], a[3], b[3], abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _allclose_abs4(a[4], b[4], a[5], b[5], a[6], b[6], a[7], b[7], abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _allclose_abs4(a[8], b[8], a[9], b[9], a[10], b[10], a[11], b[11], abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return _allclose_abs4(a[12], b[12], a[13], b[13], a[14], b[14], a[15], b[15], abs_tol)
}

fn _allclose4(a0: f64, b0: f64, a1: f64, b1: f64, a2: f64, b2: f64, a3: f64, b3: f64, rel_tol: f64, abs_tol: f64) {
    var ok = math.isclose(a0, b0, rel_tol, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = math.isclose(a1, b1, rel_tol, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = math.isclose(a2, b2, rel_tol, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = math.isclose(a3, b3, rel_tol, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return true
}

fn allclose(a, b, rel_tol: f64, abs_tol: f64) {
    var ca = chk._check(a, "mat4.allclose")
    if oren_is_err(ca) { return ca }
    var cb = chk._check(b, "mat4.allclose")
    if oren_is_err(cb) { return cb }
    var ok = _allclose4(a[0], b[0], a[1], b[1], a[2], b[2], a[3], b[3], rel_tol, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _allclose4(a[4], b[4], a[5], b[5], a[6], b[6], a[7], b[7], rel_tol, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = _allclose4(a[8], b[8], a[9], b[9], a[10], b[10], a[11], b[11], rel_tol, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return _allclose4(a[12], b[12], a[13], b[13], a[14], b[14], a[15], b[15], rel_tol, abs_tol)
}

fn is_identity(m) {
    return _shape_abs(m, 1.0, 1.0, 1.0, 1.0, false, 0.0, "mat4.is_identity")
}

fn is_identity_abs(m, abs_tol: f64) {
    return _shape_abs(m, 1.0, 1.0, 1.0, 1.0, false, abs_tol, "mat4.is_identity_abs")
}

fn is_diagonal(m) {
    var ok = chk._check(m, "mat4.is_diagonal")
    if oren_is_err(ok) { return ok }
    return _shape_abs(m, m[0], m[5], m[10], m[15], false, 0.0, "mat4.is_diagonal")
}

fn is_diagonal_abs(m, abs_tol: f64) {
    var ok = chk._check(m, "mat4.is_diagonal_abs")
    if oren_is_err(ok) { return ok }
    return _shape_abs(m, m[0], m[5], m[10], m[15], false, abs_tol, "mat4.is_diagonal_abs")
}

fn is_translation(m) {
    return _shape_abs(m, 1.0, 1.0, 1.0, 1.0, true, 0.0, "mat4.is_translation")
}

fn is_translation_abs(m, abs_tol: f64) {
    return _shape_abs(m, 1.0, 1.0, 1.0, 1.0, true, abs_tol, "mat4.is_translation_abs")
}

fn is_scale(m) {
    var ok = chk._check(m, "mat4.is_scale")
    if oren_is_err(ok) { return ok }
    return _shape_abs(m, m[0], m[5], m[10], 1.0, false, 0.0, "mat4.is_scale")
}

fn is_scale_abs(m, abs_tol: f64) {
    var ok = chk._check(m, "mat4.is_scale_abs")
    if oren_is_err(ok) { return ok }
    return _shape_abs(m, m[0], m[5], m[10], 1.0, false, abs_tol, "mat4.is_scale_abs")
}

fn is_uniform_scale(m) {
    return is_uniform_scale_abs(m, 0.0)
}

fn is_uniform_scale_abs(m, abs_tol: f64) {
    var ok = is_scale_abs(m, abs_tol)
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[0], m[5], abs_tol, "mat4.is_uniform_scale_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[0], m[10], abs_tol, "mat4.is_uniform_scale_abs")
    if oren_is_err(ok) { return ok }
    return ok
}

fn is_symmetric_abs(m, abs_tol: f64) {
    var ok = chk._check(m, "mat4.is_symmetric_abs")
    if oren_is_err(ok) { return ok }
    ok = chk._close_abs_scalar(m[1], m[4], abs_tol, "mat4.is_symmetric_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[2], m[8], abs_tol, "mat4.is_symmetric_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[3], m[12], abs_tol, "mat4.is_symmetric_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[6], m[9], abs_tol, "mat4.is_symmetric_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[7], m[13], abs_tol, "mat4.is_symmetric_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[11], m[14], abs_tol, "mat4.is_symmetric_abs")
    if oren_is_err(ok) { return ok }
    return ok
}

fn is_symmetric(m) {
    return is_symmetric_abs(m, 0.0)
}

fn is_upper_triangular_abs(m, abs_tol: f64) {
    var ok = chk._check(m, "mat4.is_upper_triangular_abs")
    if oren_is_err(ok) { return ok }
    ok = chk._close_abs_scalar(m[4], 0.0, abs_tol, "mat4.is_upper_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[8], 0.0, abs_tol, "mat4.is_upper_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[9], 0.0, abs_tol, "mat4.is_upper_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[12], 0.0, abs_tol, "mat4.is_upper_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[13], 0.0, abs_tol, "mat4.is_upper_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[14], 0.0, abs_tol, "mat4.is_upper_triangular_abs")
    if oren_is_err(ok) { return ok }
    return ok
}

fn is_upper_triangular(m) {
    return is_upper_triangular_abs(m, 0.0)
}

fn is_lower_triangular_abs(m, abs_tol: f64) {
    var ok = chk._check(m, "mat4.is_lower_triangular_abs")
    if oren_is_err(ok) { return ok }
    ok = chk._close_abs_scalar(m[1], 0.0, abs_tol, "mat4.is_lower_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[2], 0.0, abs_tol, "mat4.is_lower_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[3], 0.0, abs_tol, "mat4.is_lower_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[6], 0.0, abs_tol, "mat4.is_lower_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[7], 0.0, abs_tol, "mat4.is_lower_triangular_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[11], 0.0, abs_tol, "mat4.is_lower_triangular_abs")
    if oren_is_err(ok) { return ok }
    return ok
}

fn is_lower_triangular(m) {
    return is_lower_triangular_abs(m, 0.0)
}

fn is_orthonormal_abs(m, abs_tol: f64) {
    var ok = chk._check(m, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    var xx = _basis_dot(m[0], m[4], m[8], m[0], m[4], m[8], "mat4.is_orthonormal_abs")
    if oren_is_err(xx) { return xx }
    var yy = _basis_dot(m[1], m[5], m[9], m[1], m[5], m[9], "mat4.is_orthonormal_abs")
    if oren_is_err(yy) { return yy }
    var zz = _basis_dot(m[2], m[6], m[10], m[2], m[6], m[10], "mat4.is_orthonormal_abs")
    if oren_is_err(zz) { return zz }
    var xy = _basis_dot(m[0], m[4], m[8], m[1], m[5], m[9], "mat4.is_orthonormal_abs")
    if oren_is_err(xy) { return xy }
    var xz = _basis_dot(m[0], m[4], m[8], m[2], m[6], m[10], "mat4.is_orthonormal_abs")
    if oren_is_err(xz) { return xz }
    var yz = _basis_dot(m[1], m[5], m[9], m[2], m[6], m[10], "mat4.is_orthonormal_abs")
    if oren_is_err(yz) { return yz }

    ok = chk._close_abs_scalar(xx, 1.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(yy, 1.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(zz, 1.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(xy, 0.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(xz, 0.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(yz, 0.0, abs_tol, "mat4.is_orthonormal_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return true
}

fn is_orthonormal(m) {
    return is_orthonormal_abs(m, 0.0)
}

fn is_rigid_transform_abs(m, abs_tol: f64) {
    var ok = chk._check(m, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    ok = chk._close_abs_scalar(m[12], 0.0, abs_tol, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[13], 0.0, abs_tol, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[14], 0.0, abs_tol, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    ok = chk._close_abs_scalar(m[15], 1.0, abs_tol, "mat4.is_rigid_transform_abs")
    if oren_is_err(ok) { return ok }
    if !ok { return false }
    return is_orthonormal_abs(m, abs_tol)
}

fn is_rigid_abs(m, abs_tol: f64) {
    return is_rigid_transform_abs(m, abs_tol)
}

fn is_rigid_transform(m) {
    return is_rigid_transform_abs(m, 0.0)
}

fn is_rigid(m) {
    return is_rigid_transform(m)
}
