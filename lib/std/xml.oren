// std/xml (rolling)
//
// Minimal deterministic XML/markup DOM for stdlib composition. This is not a
// validating XML parser; it is the portable DOM/query layer needed by HTTP and
// agent tooling before richer namespace/DTD support lands.

import list "std:list"

struct XmlNode {
    kind,
    tag,
    attrs,
    children,
    text
}

struct XmlReader {
    bytes,
    pos
}

trait XmlText {
    fn xml(self): XmlNode;
    fn xml_reader(self): XmlReader;
}

trait XmlNodeQuery {
    fn find(self, selector): XmlNode;
    fn find_all(self, selector);
    fn select(self, selector);
    fn text(self);
    fn attr(self, name);
    fn tag(self);
}

trait XmlReaderStream {
    fn next(self);
}

fn document(children): XmlNode { return {"kind": "document", "children": children} }
fn element(tag, attrs, children): XmlNode { return {"kind": "element", "tag": tag, "attrs": attrs, "children": children} }
fn text_node(s): XmlNode { return {"kind": "text", "text": s} }

fn _len(bs) { return list.len(bs) }

fn _streq(a, b) {
    if a == nil || b == nil { return false }
    return a == b
}

fn _is_space(b) { return b == 32 || b == 9 || b == 10 || b == 13 }

fn _is_name_char(b) {
    if b >= 65 && b <= 90 { return true }
    if b >= 97 && b <= 122 { return true }
    if b >= 48 && b <= 57 { return true }
    if b == 45 || b == 95 || b == 58 { return true }
    return false
}

fn _slice(bs, start, end) {
    if end <= start { return "" }
    return oren_string_from_bytes_slice(bs, start, end - start)
}

fn _starts(bs, pos, lit) {
    var lb = oren_bytes_from_string(lit)
    if pos + list.len(lb) > _len(bs) { return false }
    var i = 0
    while i < list.len(lb) {
        if bs[pos + i] != lb[i] { return false }
        i = i + 1
    }
    return true
}

fn _skip_ws(bs, pos) {
    while pos < _len(bs) && _is_space(bs[pos]) { pos = pos + 1 }
    return pos
}

fn _skip_until(bs, pos, lit) {
    while pos < _len(bs) {
        if _starts(bs, pos, lit) { return pos + list.len(oren_bytes_from_string(lit)) }
        pos = pos + 1
    }
    return pos
}

fn _read_name(bs, pos) {
    var start = pos
    while pos < _len(bs) && _is_name_char(bs[pos]) { pos = pos + 1 }
    return {"s": _slice(bs, start, pos), "pos": pos}
}

fn _read_attr_value(bs, pos) {
    pos = _skip_ws(bs, pos)
    if pos >= _len(bs) { return {"s": "", "pos": pos} }
    var quote = bs[pos]
    if quote == 34 || quote == 39 {
        pos = pos + 1
        var start = pos
        while pos < _len(bs) && bs[pos] != quote { pos = pos + 1 }
        var s = _slice(bs, start, pos)
        if pos < _len(bs) { pos = pos + 1 }
        return {"s": s, "pos": pos}
    }
    var start2 = pos
    while pos < _len(bs) && !_is_space(bs[pos]) && bs[pos] != 62 && bs[pos] != 47 { pos = pos + 1 }
    return {"s": _slice(bs, start2, pos), "pos": pos}
}

fn _parse_open(bs, pos) {
    // pos is after '<'.
    var nr = _read_name(bs, pos)
    var tag = nr["s"]
    pos = nr["pos"]
    var attrs = {}
    var self_close = false
    while pos < _len(bs) {
        pos = _skip_ws(bs, pos)
        if pos >= _len(bs) { break }
        if bs[pos] == 47 {
            pos = pos + 1
            pos = _skip_ws(bs, pos)
            if pos < _len(bs) && bs[pos] == 62 { pos = pos + 1 }
            self_close = true
            break
        }
        if bs[pos] == 62 {
            pos = pos + 1
            break
        }
        var ar = _read_name(bs, pos)
        var an = ar["s"]
        pos = ar["pos"]
        var av = "true"
        pos = _skip_ws(bs, pos)
        if pos < _len(bs) && bs[pos] == 61 {
            pos = pos + 1
            var vr = _read_attr_value(bs, pos)
            av = vr["s"]
            pos = vr["pos"]
        }
        if an != "" { attrs[an] = av }
    }
    return {"tag": tag, "attrs": attrs, "pos": pos, "self_close": self_close}
}

fn _parse_nodes(bs, pos, closing) {
    var out = []
    while pos < _len(bs) {
        if _starts(bs, pos, "<!--") {
            pos = _skip_until(bs, pos + 4, "-->")
            continue
        }
        if _starts(bs, pos, "</") {
            var cr = _read_name(bs, pos + 2)
            pos = _skip_until(bs, cr["pos"], ">")
            return {"children": out, "pos": pos, "closed": _streq(cr["s"], closing)}
        }
        if _starts(bs, pos, "<!") || _starts(bs, pos, "<?") {
            pos = _skip_until(bs, pos + 2, ">")
            continue
        }
        if bs[pos] == 60 {
            var op = _parse_open(bs, pos + 1)
            if op["tag"] == "" {
                pos = op["pos"]
                continue
            }
            var children = []
            pos = op["pos"]
            if op["self_close"] != true {
                var inner = _parse_nodes(bs, pos, op["tag"])
                children = inner["children"]
                pos = inner["pos"]
            }
            list.push(out, element(op["tag"], op["attrs"], children))
            continue
        }
        var start = pos
        while pos < _len(bs) && bs[pos] != 60 { pos = pos + 1 }
        var txt = _slice(bs, start, pos)
        if txt != "" { list.push(out, text_node(txt)) }
    }
    return {"children": out, "pos": pos, "closed": closing == nil || closing == ""}
}

fn parse(s): XmlNode {
    var bs = oren_bytes_from_string(s)
    var r = _parse_nodes(bs, 0, "")
    return document(r["children"])
}

fn try_parse(s): XmlNode { return parse(s) }

fn reader(s): XmlReader {
    return {"bytes": oren_bytes_from_string(s), "pos": 0}
}

fn _event(kind, tag, attrs, text, self_close) {
    return {"kind": kind, "tag": tag, "attrs": attrs, "text": text, "self_close": self_close}
}

fn read_next(r) {
    if r == nil { return nil }
    var bs = r["bytes"]
    if bs == nil { return nil }
    var pos = r["pos"]
    if oren_type_tag(pos) == 0 { pos = 0 }
    while pos < _len(bs) {
        if _starts(bs, pos, "<!--") {
            pos = _skip_until(bs, pos + 4, "-->")
            r["pos"] = pos
            continue
        }
        if _starts(bs, pos, "<!") || _starts(bs, pos, "<?") {
            pos = _skip_until(bs, pos + 2, ">")
            r["pos"] = pos
            continue
        }
        if _starts(bs, pos, "</") {
            var cr = _read_name(bs, pos + 2)
            pos = _skip_until(bs, cr["pos"], ">")
            r["pos"] = pos
            return _event("end", cr["s"], {}, "", false)
        }
        if bs[pos] == 60 {
            var op = _parse_open(bs, pos + 1)
            r["pos"] = op["pos"]
            return _event("start", op["tag"], op["attrs"], "", op["self_close"])
        }
        var start = pos
        while pos < _len(bs) && bs[pos] != 60 { pos = pos + 1 }
        r["pos"] = pos
        var txt = _slice(bs, start, pos)
        if txt == "" { continue }
        return _event("text", "", {}, txt, false)
    }
    r["pos"] = pos
    return nil
}

fn _class_has(classes, want) {
    if classes == nil || want == nil { return false }
    var bs = oren_bytes_from_string(classes)
    var start = 0
    var i = 0
    while i <= list.len(bs) {
        if i == list.len(bs) || _is_space(bs[i]) {
            if i > start && _slice(bs, start, i) == want { return true }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

fn _matches(n, selector) {
    if n == nil || n["kind"] != "element" { return false }
    if selector == nil || selector == "" { return false }
    var first = oren_string_char_at(selector, 0)
    if first == "#" { return attr(n, "id") == oren_string_slice(selector, 1, oren_string_len(selector)) }
    if first == "." { return _class_has(attr(n, "class"), oren_string_slice(selector, 1, oren_string_len(selector))) }
    return tag(n) == selector
}

fn _find_into(n, selector, out) {
    if n == nil { return nil }
    if _matches(n, selector) { list.push(out, n) }
    var cs = n["children"]
    if cs == nil { return nil }
    var i = 0
    while i < list.len(cs) {
        _find_into(cs[i], selector, out)
        i = i + 1
    }
    return nil
}

fn find_all(n, selector) {
    var out = []
    _find_into(n, selector, out)
    return out
}

fn select(n, selector) { return find_all(n, selector) }

fn find(n, selector): XmlNode {
    var xs = find_all(n, selector)
    if list.len(xs) == 0 { return nil }
    return xs[0]
}

fn tag(n) {
    if n == nil { return nil }
    return n["tag"]
}

fn attr(n, name) {
    if n == nil || n["attrs"] == nil { return nil }
    return n["attrs"][name]
}

fn text(n) {
    if n == nil { return "" }
    if n["kind"] == "text" { return n["text"] }
    var out = ""
    var cs = n["children"]
    if cs == nil { return out }
    var i = 0
    while i < list.len(cs) {
        out = out + text(cs[i])
        i = i + 1
    }
    return out
}

impl XmlText for string {
    fn xml(self): XmlNode { return parse(self) }
    fn xml_reader(self): XmlReader { return reader(self) }
}

impl XmlNodeQuery for XmlNode {
    fn find(self, selector): XmlNode { return find(self, selector) }
    fn find_all(self, selector) { return find_all(self, selector) }
    fn select(self, selector) { return select(self, selector) }
    fn text(self) { return text(self) }
    fn attr(self, name) { return attr(self, name) }
    fn tag(self) { return tag(self) }
}

impl XmlReaderStream for XmlReader {
    fn next(self) { return read_next(self) }
}
