// Fixed-width integer cast helpers (v0, rolling).
//
// Oren v0 uses a single machine-sized `int` for arithmetic.
// For network/protocol/scientific code, you often need explicit width semantics.
//
// These are pure functions (deterministic) and work across backends.
// Semantics are "wrap/truncate" (two's complement) rather than checked.

fn u8(x) {
    x = oren_trunc_int(x)
    return x & 255
}

fn i8(x) {
    x = oren_trunc_int(x)
    var u = x & 255
    if u >= 128 { return u - 256 }
    return u
}

fn u16(x) {
    x = oren_trunc_int(x)
    return x & 65535
}

fn i16(x) {
    x = oren_trunc_int(x)
    var u = x & 65535
    if u >= 32768 { return u - 65536 }
    return u
}

fn u32(x) {
    x = oren_trunc_int(x)
    return x & 4294967295
}

fn i32(x) {
    x = oren_trunc_int(x)
    var u = x & 4294967295
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

// Checked casts (return structured error on out-of-range).
// Error code uses OREN_ERR_INVALID_ARG = 4 (rolling; consistent with C backend).

fn checked_u8(x) {
    if x < 0 || x > 255 { return oren_err(4, "checked_u8: out of range") }
    return x
}

fn checked_i8(x) {
    if x < -128 || x > 127 { return oren_err(4, "checked_i8: out of range") }
    return x
}

fn checked_u16(x) {
    if x < 0 || x > 65535 { return oren_err(4, "checked_u16: out of range") }
    return x
}

fn checked_i16(x) {
    if x < -32768 || x > 32767 { return oren_err(4, "checked_i16: out of range") }
    return x
}

fn checked_u32(x) {
    if x < 0 || x > 4294967295 { return oren_err(4, "checked_u32: out of range") }
    return x
}

fn checked_i32(x) {
    if x < -2147483648 || x > 2147483647 { return oren_err(4, "checked_i32: out of range") }
    return x
}

// 64-bit notes:
// - v0 uses a signed machine int; values above 2^63-1 cannot be represented as an `int`.
// - `u64`/`checked_u64` therefore only support 0..MAX_I64 in v0.
var MAX_I64 = 9223372036854775807

fn i64(x) { return oren_trunc_int(x) }
fn u64(x) { return oren_trunc_int(x) }

fn checked_i64(x) { return x }
fn checked_u64(x) {
    if x < 0 || x > MAX_I64 { return oren_err(4, "checked_u64: out of range for v0 int") }
    return x
}
