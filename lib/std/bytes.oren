fn try_set_i16_be(bytes, idx, v) {
    var ok = _check_span(bytes, idx, 2, "bytes.try_set_i16_be")
    if oren_is_err(ok) { return ok }
    var vv = _check_signed(v, -32768, 32767, "bytes.try_set_i16_be")
    if oren_is_err(vv) { return vv }
    return oren_bytes_set_i16_be(bytes, idx, v)
}

