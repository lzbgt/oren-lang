// std/bytes.oren
//
// Lightweight wrappers around the kernel bytes intrinsics (`oren_bytes_*`).
//
// Design notes:
// - `oren_*` is the kernel ABI namespace (reserved, stable, non-idiomatic).
// - This module exposes a portable stdlib surface for byte operations.

import raw "std:buffer/raw"

trait ByteText {
    fn bytes(self): bytes;
}

trait ByteSeq {
    fn text(self);
    fn hex(self);
    fn slice(self, off, n): bytes;
    fn concat(self, other): bytes;
    fn u8_buf(self);
}

fn _is_int(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 1 { return true }
    if tag == 0 || tag == 3 || tag == 4 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn _len_or_err(bytes, ctx) {
    if oren_type_tag(bytes) == 6 {
        var n2 = oren_list_len(bytes)
        if n2 == nil || oren_is_err(n2) { return oren_err(4, ctx + ": bytes must be list<int> or u8_buf") }
        return n2
    }
    var n = oren_bytes_len(bytes)
    if n == nil || oren_is_err(n) { return oren_err(4, ctx + ": bytes must be list<int> or u8_buf") }
    return n
}

fn _check_span(bytes, idx, width, ctx) {
    var n = _len_or_err(bytes, ctx)
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, ctx + ": index not int") }
    if idx < 0 || idx + width > n { return oren_err(4, ctx + ": index out of bounds") }
    return n
}

fn _check_unsigned(v, maxv, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    if v < 0 || v > maxv { return oren_err(4, ctx + ": value out of range") }
    return v
}

fn _check_signed(v, minv, maxv, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    if v < minv || v > maxv { return oren_err(4, ctx + ": value out of range") }
    return v
}

fn _check_nonneg_int(v, ctx, label) {
    if _is_int(v) == false { return oren_err(4, ctx + ": " + label + " not int") }
    if v < 0 { return oren_err(4, ctx + ": negative " + label) }
    return v
}

fn _check_slice_span(bytes, off, n, ctx) {
    var ok_off = _check_nonneg_int(off, ctx, "off")
    if oren_is_err(ok_off) { return ok_off }
    var ok_n = _check_nonneg_int(n, ctx, "len")
    if oren_is_err(ok_n) { return ok_n }
    var nb = _len_or_err(bytes, ctx)
    if oren_is_err(nb) { return nb }
    if off + n > nb { return oren_err(4, ctx + ": slice out of bounds") }
    return nb
}

fn _load_u8(bytes, idx) {
    if oren_is_u8_buf(bytes) == true {
        return ptr_get_byte(oren_buf_data_ptr_unchecked(bytes) + idx) & 255
    }
    return oren_bytes_get_u8(bytes, idx)
}

fn _u32_le_from_ptr(p, off) {
    return (ptr_get_byte(p + off) & 255) |
        ((ptr_get_byte(p + off + 1) & 255) << 8) |
        ((ptr_get_byte(p + off + 2) & 255) << 16) |
        ((ptr_get_byte(p + off + 3) & 255) << 24)
}

fn _u16_be_from_ptr(p, off) {
    return ((ptr_get_byte(p + off) & 255) << 8) |
        (ptr_get_byte(p + off + 1) & 255)
}

fn _u16_le_from_ptr(p, off) {
    return (ptr_get_byte(p + off) & 255) |
        ((ptr_get_byte(p + off + 1) & 255) << 8)
}

fn _u32_be_from_ptr(p, off) {
    return ((ptr_get_byte(p + off) & 255) << 24) |
        ((ptr_get_byte(p + off + 1) & 255) << 16) |
        ((ptr_get_byte(p + off + 2) & 255) << 8) |
        (ptr_get_byte(p + off + 3) & 255)
}

fn _u64_le_from_ptr(p, off) {
    var lo = _u32_le_from_ptr(p, off)
    var hi = _u32_le_from_ptr(p, off + 4)
    return lo | (hi << 32)
}

fn _u64_be_from_ptr(p, off) {
    var acc = 0
    var i = 0
    while i < 8 {
        acc = (acc << 8) | (ptr_get_byte(p + off + i) & 255)
        i = i + 1
    }
    return acc
}

fn _i16_from_u16(x) {
    if x >= 32768 { return x - 65536 }
    return x
}

fn _i32_from_u32(x) {
    if x >= 2147483648 { return x - 4294967296 }
    return x
}

fn view(bs, ctx) {
    var n = _len_or_err(bs, ctx)
    if oren_is_err(n) { return n }
    var p = nil
    if oren_is_u8_buf(bs) == true { p = oren_buf_data_ptr_unchecked(bs) }
    return [bs, n, p, ctx]
}

fn view_bytes(v) { return v[0] }
fn view_len(v) { return v[1] }
fn view_ptr(v) { return v[2] }
fn view_ctx(v) { return v[3] }

fn _view_check(v, idx, width, label) {
    if idx < 0 || idx + width > view_len(v) {
        return oren_err(4, view_ctx(v) + ": " + label + " out of bounds")
    }
    return 0
}

fn view_get_u8_unchecked(v, idx) {
    var p = view_ptr(v)
    if p != nil { return ptr_get_byte(p + idx) & 255 }
    return oren_bytes_get_u8(view_bytes(v), idx)
}

fn view_get_u8(v, idx) {
    var ok = _view_check(v, idx, 1, "u8 read")
    if oren_is_err(ok) { return ok }
    return view_get_u8_unchecked(v, idx)
}

fn view_get_u16_be_unchecked(v, idx) {
    var p = view_ptr(v)
    if p != nil { return _u16_be_from_ptr(p, idx) }
    return get_u16_be(view_bytes(v), idx)
}

fn view_get_u16_be(v, idx) {
    var ok = _view_check(v, idx, 2, "u16 read")
    if oren_is_err(ok) { return ok }
    return view_get_u16_be_unchecked(v, idx)
}

fn view_get_u32_be_unchecked(v, idx) {
    var p = view_ptr(v)
    if p != nil { return _u32_be_from_ptr(p, idx) }
    return get_u32_be(view_bytes(v), idx)
}

fn view_get_u32_be(v, idx) {
    var ok = _view_check(v, idx, 4, "u32 read")
    if oren_is_err(ok) { return ok }
    return view_get_u32_be_unchecked(v, idx)
}

fn view_get_u32_le_unchecked(v, idx) {
    var p = view_ptr(v)
    if p != nil { return _u32_le_from_ptr(p, idx) }
    return get_u32_le(view_bytes(v), idx)
}

fn view_get_u32_le(v, idx) {
    var ok = _view_check(v, idx, 4, "u32 read")
    if oren_is_err(ok) { return ok }
    return view_get_u32_le_unchecked(v, idx)
}

fn view_get_i32_le_unchecked(v, idx) {
    var x = view_get_u32_le_unchecked(v, idx)
    if oren_is_err(x) { return x }
    if x >= 2147483648 { return x - 4294967296 }
    return x
}

fn view_get_i32_le(v, idx) {
    var ok = _view_check(v, idx, 4, "i32 read")
    if oren_is_err(ok) { return ok }
    return view_get_i32_le_unchecked(v, idx)
}

fn view_get_u64_le_unchecked(v, idx) {
    var p = view_ptr(v)
    if p != nil { return _u64_le_from_ptr(p, idx) }
    return get_u64_le(view_bytes(v), idx)
}

fn view_get_u64_le(v, idx) {
    var ok = _view_check(v, idx, 8, "u64 read")
    if oren_is_err(ok) { return ok }
    return view_get_u64_le_unchecked(v, idx)
}

fn view_get_u64_be_unchecked(v, idx) {
    var p = view_ptr(v)
    if p != nil { return _u64_be_from_ptr(p, idx) }
    return get_u64_be(view_bytes(v), idx)
}

fn view_get_u64_be(v, idx) {
    var ok = _view_check(v, idx, 8, "u64 read")
    if oren_is_err(ok) { return ok }
    return view_get_u64_be_unchecked(v, idx)
}

fn _store_u16_be(bytes, idx, v) {
    if oren_is_u8_buf(bytes) == true {
        var p = oren_buf_data_ptr_unchecked(bytes) + idx
        ptr_set_byte(p + 0, (v >> 8) & 255)
        ptr_set_byte(p + 1, v & 255)
        return v
    }
    return oren_bytes_set_u16_be(bytes, idx, v)
}

fn _store_u16_le(bytes, idx, v) {
    if oren_is_u8_buf(bytes) == true {
        var p = oren_buf_data_ptr_unchecked(bytes) + idx
        ptr_set_byte(p + 0, v & 255)
        ptr_set_byte(p + 1, (v >> 8) & 255)
        return v
    }
    return oren_bytes_set_u16_le(bytes, idx, v)
}

fn _store_u32_be(bytes, idx, v) {
    if oren_is_u8_buf(bytes) == true {
        var p = oren_buf_data_ptr_unchecked(bytes) + idx
        ptr_set_byte(p + 0, (v >> 24) & 255)
        ptr_set_byte(p + 1, (v >> 16) & 255)
        ptr_set_byte(p + 2, (v >> 8) & 255)
        ptr_set_byte(p + 3, v & 255)
        return v
    }
    return oren_bytes_set_u32_be(bytes, idx, v)
}

fn _store_u32_le(bytes, idx, v) {
    if oren_is_u8_buf(bytes) == true {
        var p = oren_buf_data_ptr_unchecked(bytes) + idx
        ptr_set_byte(p + 0, v & 255)
        ptr_set_byte(p + 1, (v >> 8) & 255)
        ptr_set_byte(p + 2, (v >> 16) & 255)
        ptr_set_byte(p + 3, (v >> 24) & 255)
        return v
    }
    return oren_bytes_set_u32_le(bytes, idx, v)
}

fn _store_u64_be(bytes, idx, v) {
    if oren_is_u8_buf(bytes) == true {
        var p = oren_buf_data_ptr_unchecked(bytes) + idx
        var i = 0
        while i < 8 {
            ptr_set_byte(p + i, (v >> ((7 - i) * 8)) & 255)
            i = i + 1
        }
        return v
    }
    return oren_bytes_set_u64_be(bytes, idx, v)
}

fn _store_u64_le(bytes, idx, v) {
    if oren_is_u8_buf(bytes) == true {
        var p = oren_buf_data_ptr_unchecked(bytes) + idx
        var i = 0
        while i < 8 {
            ptr_set_byte(p + i, (v >> (i * 8)) & 255)
            i = i + 1
        }
        return v
    }
    return oren_bytes_set_u64_le(bytes, idx, v)
}

fn _copy_u8_ptr_forward(dstp, srcp, n) {
    var i = 0
    while i < n {
        ptr_set_byte(dstp + i, ptr_get_byte(srcp + i) & 255)
        i = i + 1
    }
    return n
}

fn _copy_u8_ptr_nonoverlap(dstp, srcp, n) {
    if n <= 0 { return 0 }
    return oren_memcpy(dstp, srcp, n)
}

fn _hex_digit_value(b) {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 65 && b <= 70 { return b - 55 }
    if b >= 97 && b <= 102 { return b - 87 }
    return -1
}

fn _bytes_to_int_list(bytes, ctx) {
    if oren_type_tag(bytes) == 6 {
        var n2 = oren_list_len(bytes)
        var out2 = []
        var i2 = 0
        while i2 < n2 {
            var b2 = bytes[i2]
            if _is_int(b2) == false || b2 < 0 || b2 > 255 {
                return oren_err(4, ctx + ": expected list<int 0..255>")
            }
            oren_list_push(out2, b2)
            i2 = i2 + 1
        }
        return out2
    }
    var n = _len_or_err(bytes, ctx)
    if oren_is_err(n) { return n }
    var out = []
    var i = 0
    while i < n {
        var b = _load_u8(bytes, i)
        if oren_is_err(b) { return b }
        oren_list_push(out, b)
        i = i + 1
    }
    return out
}


fn len(bytes) {
    return _len_or_err(bytes, "bytes.len")
}

fn get_u8(bytes, idx) {
    var n = _len_or_err(bytes, "bytes.get_u8")
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, "bytes.get_u8: index not int") }
    if idx < 0 || idx >= n { return oren_err(4, "bytes.get_u8: index out of bounds") }
    return _load_u8(bytes, idx)
}

fn set_u8(bytes, idx, v) {
    var n = _len_or_err(bytes, "bytes.set_u8")
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, "bytes.set_u8: index not int") }
    if _is_int(v) == false { return oren_err(4, "bytes.set_u8: value not int") }
    if idx < 0 || idx >= n { return oren_err(4, "bytes.set_u8: index out of bounds") }
    if v < 0 || v > 255 { return oren_err(4, "bytes.set_u8: byte out of range") }
    if oren_is_u8_buf(bytes) == true {
        return raw._store_u8_buf_unchecked_direct(bytes, idx, v)
    }
    return oren_bytes_set_u8(bytes, idx, v)
}

fn from_hex(s): bytes {
    if oren_type_tag(s) != 4 { return oren_err(4, "bytes.from_hex: s must be string") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return oren_err(4, "bytes.from_hex: invalid string") }
    if n % 2 != 0 { return oren_err(4, "bytes.from_hex: odd length") }
    var out_n = n / 2
    var out = raw.u8_new_uninit(out_n)
    if oren_is_err(out) { return out }
    var p = oren_buf_data_ptr_unchecked(out)
    if p == 0 && out_n > 0 { return oren_err(4, "bytes.from_hex: output data ptr is nil") }
    var i = 0
    while i < out_n {
        var hi = _hex_digit_value(oren_string_byte_at_unchecked(s, i * 2))
        var lo = _hex_digit_value(oren_string_byte_at_unchecked(s, i * 2 + 1))
        if hi < 0 || lo < 0 { return oren_err(4, "bytes.from_hex: invalid hex digit") }
        ptr_set_byte(p + i, hi * 16 + lo)
        i = i + 1
    }
    return out
}

fn from_string(s): bytes {
    if oren_type_tag(s) != 4 { return oren_err(4, "bytes.from_string: s must be string") }
    return raw.u8_from_string(s)
}

fn to_hex(bytes) {
    var n = _len_or_err(bytes, "bytes.to_hex")
    if oren_is_err(n) { return n }
    if n == 0 { return "" }
    var out = raw.u8_new_uninit(n * 2)
    if oren_is_err(out) { return out }
    var outp = oren_buf_data_ptr_unchecked(out)
    var digits = "0123456789abcdef"
    var i = 0
    while i < n {
        var b = _load_u8(bytes, i)
        if oren_is_err(b) { return b }
        ptr_set_byte(outp + i * 2, oren_string_byte_at_unchecked(digits, (b >> 4) & 15))
        ptr_set_byte(outp + i * 2 + 1, oren_string_byte_at_unchecked(digits, b & 15))
        i = i + 1
    }
    return oren_string_from_bytes_slice(out, 0, n * 2)
}

fn to_string(bytes) {
    var n = _len_or_err(bytes, "bytes.to_string")
    if oren_is_err(n) { return n }
    return oren_string_from_bytes_slice(bytes, 0, n)
}

fn pack(xs): bytes {
    if oren_type_tag(xs) != 6 { return oren_bytes_pack(xs) }
    var n = oren_list_len(xs)
    if n == nil || oren_is_err(n) { return oren_bytes_pack(xs) }
    var out = raw.u8_new_uninit(n)
    if oren_is_err(out) { return out }
    var p = oren_buf_data_ptr_unchecked(out)
    var i = 0
    while i < n {
        var b = xs[i]
        if _is_int(b) == false || b < 0 || b > 255 { return oren_err(4, "bytes.pack: expected list<int 0..255>") }
        ptr_set_byte(p + i, b & 255)
        i = i + 1
    }
    return out
}

fn unpack(bytes) {
    if oren_is_u8_buf(bytes) == true { return oren_bytes_unpack(bytes) }
    return _bytes_to_int_list(bytes, "bytes.unpack")
}

fn slice(bytes, off, n): bytes {
    var ok = _check_slice_span(bytes, off, n, "bytes.slice")
    if oren_is_err(ok) { return ok }
    return oren_u8_buf_from_bytes_slice(bytes, off, n)
}

fn concat(a, b): bytes {
    var na = _len_or_err(a, "bytes.concat")
    if oren_is_err(na) { return na }
    var nb = _len_or_err(b, "bytes.concat")
    if oren_is_err(nb) { return nb }
    var out = raw.u8_new_uninit(na + nb)
    if oren_is_err(out) { return out }
    var outp = oren_buf_data_ptr_unchecked(out)
    var i = 0
    if na > 0 && oren_is_u8_buf(a) == true {
        _copy_u8_ptr_forward(outp, oren_buf_data_ptr_unchecked(a), na)
    } else {
        while i < na {
            var av = _load_u8(a, i)
            if oren_is_err(av) { return av }
            raw._store_u8_buf_unchecked_direct(out, i, av)
            i = i + 1
        }
    }
    var j = 0
    if nb > 0 && oren_is_u8_buf(b) == true {
        _copy_u8_ptr_forward(outp + na, oren_buf_data_ptr_unchecked(b), nb)
    } else {
        while j < nb {
            var bv = _load_u8(b, j)
            if oren_is_err(bv) { return bv }
            raw._store_u8_buf_unchecked_direct(out, na + j, bv)
            j = j + 1
        }
    }
    return out
}

fn copy_into(dst, dst_off, src, src_off, n) {
    var ok_dst_off = _check_nonneg_int(dst_off, "bytes.copy_into", "dst_off")
    if oren_is_err(ok_dst_off) { return ok_dst_off }
    var ok_src_off = _check_nonneg_int(src_off, "bytes.copy_into", "src_off")
    if oren_is_err(ok_src_off) { return ok_src_off }
    var ok_n = _check_nonneg_int(n, "bytes.copy_into", "len")
    if oren_is_err(ok_n) { return ok_n }
    var nd = _len_or_err(dst, "bytes.copy_into")
    if oren_is_err(nd) { return nd }
    var ns = _len_or_err(src, "bytes.copy_into")
    if oren_is_err(ns) { return ns }
    if dst_off + n > nd { return oren_err(4, "bytes.copy_into: dst range out of bounds") }
    if src_off + n > ns { return oren_err(4, "bytes.copy_into: src range out of bounds") }
    if oren_is_u8_buf(dst) == true {
        var dstp = oren_buf_data_ptr_unchecked(dst)
        var src_is_u8 = (oren_is_u8_buf(src) == true)
        var srcp = nil
        if src_is_u8 { srcp = oren_buf_data_ptr_unchecked(src) }
        if src_is_u8 && n > 0 {
            var overlap = (dst == src && dst_off < src_off + n && src_off < dst_off + n)
            if overlap == false {
                _copy_u8_ptr_nonoverlap(dstp + dst_off, srcp + src_off, n)
            } else if dst_off > src_off {
                var k = n - 1
                while k >= 0 {
                    ptr_set_byte(dstp + dst_off + k, ptr_get_byte(srcp + src_off + k) & 255)
                    k = k - 1
                }
            } else {
                _copy_u8_ptr_forward(dstp + dst_off, srcp + src_off, n)
            }
            return dst
        }
        var i = 0
        while i < n {
            var b = 0
            b = _load_u8(src, src_off + i)
            if oren_is_err(b) { return b }
            ptr_set_byte(dstp + dst_off + i, b & 255)
            i = i + 1
        }
        return dst
    }
    if dst == src && dst_off > src_off && dst_off < src_off + n {
        var k2 = n - 1
        while k2 >= 0 {
            var bk = _load_u8(src, src_off + k2)
            if oren_is_err(bk) { return bk }
            var rc2 = oren_bytes_set_u8(dst, dst_off + k2, bk)
            if oren_is_err(rc2) { return rc2 }
            k2 = k2 - 1
        }
        return dst
    }
    var j = 0
    while j < n {
        var bj = _load_u8(src, src_off + j)
        if oren_is_err(bj) { return bj }
        var rc = oren_bytes_set_u8(dst, dst_off + j, bj)
        if oren_is_err(rc) { return rc }
        j = j + 1
    }
    return dst
}

fn from_u8_buf(buf): bytes {
    var n = oren_buf_len(buf)
    if n == nil || oren_is_err(n) { return oren_err(4, "bytes.from_u8_buf: buf must be []u8") }
    return oren_u8_buf_from_bytes_slice(buf, 0, n)
}

fn to_u8_buf(bytes) {
    var n = _len_or_err(bytes, "bytes.to_u8_buf")
    if oren_is_err(n) { return n }
    return oren_u8_buf_from_bytes_slice(bytes, 0, n)
}

fn to_string_slice(bytes, off, n) {
    var ok = _check_slice_span(bytes, off, n, "bytes.to_string_slice")
    if oren_is_err(ok) { return ok }
    return oren_string_from_bytes_slice(bytes, off, n)
}

fn to_u8_buf_slice(bytes, off, n) {
    var ok = _check_slice_span(bytes, off, n, "bytes.to_u8_buf_slice")
    if oren_is_err(ok) { return ok }
    return oren_u8_buf_from_bytes_slice(bytes, off, n)
}

fn get_u16_be(bytes, idx) {
    var ok = _check_span(bytes, idx, 2, "bytes.get_u16_be")
    if oren_is_err(ok) { return ok }
    if oren_is_u8_buf(bytes) == true { return _u16_be_from_ptr(oren_buf_data_ptr_unchecked(bytes), idx) }
    return oren_bytes_get_u16_be(bytes, idx)
}

fn get_u16_le(bytes, idx) {
    var ok = _check_span(bytes, idx, 2, "bytes.get_u16_le")
