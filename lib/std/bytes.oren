impl ByteText for string {
    fn bytes(self): bytes { return from_string(self) }
}

impl ByteSeq for bytes {
    fn text(self) { return to_string(self) }
    fn hex(self) { return to_hex(self) }
    fn slice(self, off, n): bytes { return slice(self, off, n) }
    fn concat(self, other): bytes { return concat(self, other) }
    fn u8_buf(self) { return to_u8_buf(self) }
}
