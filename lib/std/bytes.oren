fn try_set_u16_be(bytes, idx, v) {
    var ok = _check_span(bytes, idx, 2, "bytes.try_set_u16_be")
    if oren_is_err(ok) { return ok }
    var vv = _check_unsigned(v, 65535, "bytes.try_set_u16_be")
    if oren_is_err(vv) { return vv }
    return oren_bytes_set_u16_be(bytes, idx, v)
}

