// std/bytes.oren
//
// Lightweight wrappers around the kernel bytes intrinsics (`oren_bytes_*`).
//
// Design notes:
// - `oren_*` is the kernel ABI namespace (reserved, stable, non-idiomatic).
// - This module exposes a portable stdlib surface for byte operations.

fn len(bytes) { return oren_bytes_len(bytes) }

fn _is_int(v) {
    if v == nil { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn _len_or_err(bytes, ctx) {
    var n = oren_bytes_len(bytes)
    if n == nil || oren_is_err(n) { return oren_err(4, ctx + ": bytes must be list<int> or u8_buf") }
    return n
}

fn _check_span(bytes, idx, width, ctx) {
    var n = _len_or_err(bytes, ctx)
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, ctx + ": index not int") }
    if idx < 0 || idx + width > n { return oren_err(4, ctx + ": index out of bounds") }
    return n
}

fn _check_unsigned(v, maxv, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    if v < 0 || v > maxv { return oren_err(4, ctx + ": value out of range") }
    return v
}

fn _check_signed(v, minv, maxv, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    if v < minv || v > maxv { return oren_err(4, ctx + ": value out of range") }
    return v
}

fn _bytes_to_int_list(bytes, ctx) {
    if oren_type_tag(bytes) == 6 {
        var n2 = oren_list_len(bytes)
        var out2 = []
        var i2 = 0
        while i2 < n2 {
            var b2 = bytes[i2]
            if _is_int(b2) == false || b2 < 0 || b2 > 255 {
                return oren_err(4, ctx + ": expected list<int 0..255>")
            }
            oren_list_push(out2, b2)
            i2 = i2 + 1
        }
        return out2
    }
    var n = _len_or_err(bytes, ctx)
    if oren_is_err(n) { return n }
    var out = []
    var i = 0
    while i < n {
        var b = oren_bytes_get_u8(bytes, i)
        if oren_is_err(b) { return b }
        oren_list_push(out, b)
        i = i + 1
    }
    return out
}

// --- structured error helpers (value-or-err) ---

fn try_len(bytes) {
    return _len_or_err(bytes, "bytes.try_len")
}

fn try_get_u8(bytes, idx) {
    var n = _len_or_err(bytes, "bytes.try_get_u8")
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, "bytes.try_get_u8: index not int") }
    if idx < 0 || idx >= n { return oren_err(4, "bytes.try_get_u8: index out of bounds") }
    return oren_bytes_get_u8(bytes, idx)
}

fn try_set_u8(bytes, idx, v) {
    var n = _len_or_err(bytes, "bytes.try_set_u8")
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, "bytes.try_set_u8: index not int") }
    if _is_int(v) == false { return oren_err(4, "bytes.try_set_u8: value not int") }
    if idx < 0 || idx >= n { return oren_err(4, "bytes.try_set_u8: index out of bounds") }
    if v < 0 || v > 255 { return oren_err(4, "bytes.try_set_u8: byte out of range") }
    return oren_bytes_set_u8(bytes, idx, v)
}

fn try_from_hex(s) {
    if oren_type_tag(s) != 4 { return oren_err(4, "bytes.try_from_hex: s must be string") }
    return oren_bytes_from_hex(s)
}

fn try_from_string(s) {
    if oren_type_tag(s) != 4 { return oren_err(4, "bytes.try_from_string: s must be string") }
    return oren_bytes_from_string(s)
}

fn try_to_hex(bytes) {
    var n = _len_or_err(bytes, "bytes.try_to_hex")
    if oren_is_err(n) { return n }
    return oren_bytes_to_hex(bytes)
}

fn try_to_string(bytes) {
    var xs = _bytes_to_int_list(bytes, "bytes.try_to_string")
    if oren_is_err(xs) { return xs }
    return oren_string_from_bytes(xs)
}

fn try_pack(xs) {
    return oren_bytes_pack(xs)
}

fn try_unpack(bytes) {
    return _bytes_to_int_list(bytes, "bytes.try_unpack")
}

