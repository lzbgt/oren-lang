// std/bytes.oren
//
// Lightweight wrappers around the kernel bytes intrinsics (`oren_bytes_*`).
//
// Design notes:
// - `oren_*` is the kernel ABI namespace (reserved, stable, non-idiomatic).
// - This module exposes a portable stdlib surface for byte operations.

fn len(bytes) { return oren_bytes_len(bytes) }

fn from_hex(s) { return oren_bytes_from_hex(s) }

fn to_hex(bytes) { return oren_bytes_to_hex(bytes) }

fn pack(xs) { return oren_bytes_pack(xs) }

fn unpack(bytes) { return oren_bytes_unpack(bytes) }

fn from_string(s) { return oren_bytes_from_string(s) }

fn to_string(bytes) { return oren_string_from_bytes(bytes) }

fn get_u8(bytes, idx) { return oren_bytes_get_u8(bytes, idx) }

fn set_u8(bytes, idx, v) { return oren_bytes_set_u8(bytes, idx, v) }

fn get_u16_be(bytes, idx) { return oren_bytes_get_u16_be(bytes, idx) }

fn get_u16_le(bytes, idx) { return oren_bytes_get_u16_le(bytes, idx) }

fn get_i16_be(bytes, idx) { return oren_bytes_get_i16_be(bytes, idx) }

fn get_i16_le(bytes, idx) { return oren_bytes_get_i16_le(bytes, idx) }

fn set_u16_be(bytes, idx, v) { return oren_bytes_set_u16_be(bytes, idx, v) }

fn set_u16_le(bytes, idx, v) { return oren_bytes_set_u16_le(bytes, idx, v) }

fn set_i16_be(bytes, idx, v) { return oren_bytes_set_i16_be(bytes, idx, v) }

fn set_i16_le(bytes, idx, v) { return oren_bytes_set_i16_le(bytes, idx, v) }

fn put_u16_be(bytes, idx, v) { return oren_bytes_put_u16_be(bytes, idx, v) }

fn put_u16_le(bytes, idx, v) { return oren_bytes_put_u16_le(bytes, idx, v) }

fn get_u32_be(bytes, idx) { return oren_bytes_get_u32_be(bytes, idx) }

fn get_u32_le(bytes, idx) { return oren_bytes_get_u32_le(bytes, idx) }

fn get_i32_be(bytes, idx) { return oren_bytes_get_i32_be(bytes, idx) }

fn get_i32_le(bytes, idx) { return oren_bytes_get_i32_le(bytes, idx) }

fn set_u32_be(bytes, idx, v) { return oren_bytes_set_u32_be(bytes, idx, v) }

fn set_u32_le(bytes, idx, v) { return oren_bytes_set_u32_le(bytes, idx, v) }

fn set_i32_be(bytes, idx, v) { return oren_bytes_set_i32_be(bytes, idx, v) }

fn set_i32_le(bytes, idx, v) { return oren_bytes_set_i32_le(bytes, idx, v) }

fn put_u32_be(bytes, idx, v) { return oren_bytes_put_u32_be(bytes, idx, v) }

fn put_u32_le(bytes, idx, v) { return oren_bytes_put_u32_le(bytes, idx, v) }

fn get_u64_be(bytes, idx) { return oren_bytes_get_u64_be(bytes, idx) }

fn get_u64_le(bytes, idx) { return oren_bytes_get_u64_le(bytes, idx) }

fn get_i64_be(bytes, idx) { return oren_bytes_get_i64_be(bytes, idx) }

fn get_i64_le(bytes, idx) { return oren_bytes_get_i64_le(bytes, idx) }

fn set_u64_be(bytes, idx, v) { return oren_bytes_set_u64_be(bytes, idx, v) }

fn set_u64_le(bytes, idx, v) { return oren_bytes_set_u64_le(bytes, idx, v) }

fn set_i64_be(bytes, idx, v) { return oren_bytes_set_i64_be(bytes, idx, v) }

fn set_i64_le(bytes, idx, v) { return oren_bytes_set_i64_le(bytes, idx, v) }
