// std/list.oren
//
// Ergonomic wrappers around the kernel list intrinsics (`oren_list_*`).
//
// Design notes:
// - `oren_*` is treated as the "kernel ABI" namespace (reserved, stable, non-idiomatic).
// - This module is the first step toward language-level container operations like `push(...)`.
// - Today these wrappers only target built-in list values (`[]T`).
// - Future: compiler can lower `push(xs, v)` to either an intrinsic fast path or trait dispatch.

fn len(xs) { return oren_list_len(xs) }

fn is_empty(xs) { return oren_list_len(xs) == 0 }

fn _is_int(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 1 { return true }
    if tag == 0 || tag == 3 || tag == 4 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn _len_or_err(xs, ctx) {
    if oren_type_tag(xs) != 6 { return oren_err(4, ctx + ": xs must be list") }
    var n = oren_list_len(xs)
    if n == nil || oren_is_err(n) { return oren_err(4, ctx + ": xs must be list") }
    return n
}

// --- list<int> (unboxed, native backend) ---
// Explicit opt-in; falls back to boxed list on non-native backends.
// Note: index syntax (`xs[i]`) now works for list<int> on native backend (uses list-int checks).
fn int_new(cap) { return oren_new_list_int(cap) }

fn int_len(xs) { return oren_list_int_len(xs) }

fn int_push(xs, v) { oren_list_int_push(xs, v); return nil }

fn int_get(xs, i) { return oren_list_int_get(xs, i) }

fn int_set(xs, i, v) { oren_list_int_set(xs, i, v); return nil }

fn int_reserve(xs, cap) { oren_list_int_reserve(xs, cap); return nil }

fn clone(xs) {
    // Shallow clone:
    // - returns a new list with the same element values
    // - does not deep-copy nested lists/maps (reference semantics for heap values)
    var out = []
    var n = oren_list_len(xs)
    var i = 0
    while i < n {
        oren_list_push(out, xs[i])
        i = i + 1
    }
    return out
}

fn slice_copy(xs, off, n) {
    // Copying slice (not a view).
    //
    // Errors are returned as Err maps (not panics) so callers can keep servers/HPC jobs alive.
    if xs == nil { return oren_err(4, "list.slice_copy: xs is nil") }
    if oren_type_tag(xs) != 6 { return oren_err(4, "list.slice_copy: xs must be list") }
    if oren_type_tag(off) == 0 { off = 0 }
    if oren_type_tag(n) == 0 { n = 0 }
    if _is_int(off) == false { return oren_err(4, "list.slice_copy: off not int") }
    if _is_int(n) == false { return oren_err(4, "list.slice_copy: n not int") }
    if off < 0 { return oren_err(4, "list.slice_copy: off < 0") }
    if n < 0 { return oren_err(4, "list.slice_copy: n < 0") }
    var total = oren_list_len(xs)
    if total == nil || oren_is_err(total) { return oren_err(4, "list.slice_copy: xs must be list") }
    if off > total { return oren_err(4, "list.slice_copy: off out of bounds") }
    if n > (total - off) { return oren_err(4, "list.slice_copy: range out of bounds") }

    var out = []
    var i = 0
    while i < n {
        oren_list_push(out, xs[off + i])
        i = i + 1
    }
    return out
}

fn slice_view(xs, off, n) {
    // Cheap O(1) slice view (no copy):
    //
    // Returns an "iterable map" that `for x in view {}` can consume via `oren_iter_next`.
    //
    // Shape:
    //   {"__iter":"list_slice","base":xs,"off":off,"len":n}
    //
    // Notes:
    // - The marker value **must** be a string literal in native mode so the runtime can use pointer equality safely.
    // - Malformed views iterate as an empty sequence (deterministic, avoids crashes).
    if oren_type_tag(xs) != 6 { return {"__iter": "list_slice", "base": [], "off": 0, "len": 0} }
    var total = oren_list_len(xs)
    if total == nil || oren_is_err(total) { return {"__iter": "list_slice", "base": [], "off": 0, "len": 0} }
    if oren_type_tag(off) == 0 { off = 0 }
    if oren_type_tag(n) == 0 { n = 0 }
    if _is_int(off) == false || _is_int(n) == false { return {"__iter": "list_slice", "base": xs, "off": 0, "len": 0} }
    if off < 0 || n < 0 { return {"__iter": "list_slice", "base": xs, "off": 0, "len": 0} }
    if off > total || n > (total - off) { return {"__iter": "list_slice", "base": xs, "off": 0, "len": 0} }
    return {"__iter": "list_slice", "base": xs, "off": off, "len": n}
}

fn push(xs, v) {
    oren_list_push(xs, v)
    return nil
}

// --- structured error helpers (value-or-err) ---

fn try_len(xs) {
    return _len_or_err(xs, "list.try_len")
}

fn try_is_empty(xs) {
    var n = _len_or_err(xs, "list.try_is_empty")
    if oren_is_err(n) { return n }
    return n == 0
}

fn try_push(xs, v) {
    var n = _len_or_err(xs, "list.try_push")
    if oren_is_err(n) { return n }
    oren_list_push(xs, v)
    return nil
}

fn try_clone(xs) {
    var n = _len_or_err(xs, "list.try_clone")
    if oren_is_err(n) { return n }
    var out = []
    var i = 0
    while i < n {
        oren_list_push(out, xs[i])
        i = i + 1
    }
    return out
}

fn try_slice_copy(xs, off, n) {
    return slice_copy(xs, off, n)
}

fn try_get(xs, i) {
    var n = _len_or_err(xs, "list.try_get")
    if oren_is_err(n) { return n }
    if _is_int(i) == false { return oren_err(4, "list.try_get: index not int") }
    if i < 0 || i >= n { return oren_err(4, "list.try_get: index out of bounds") }
    return xs[i]
}

fn try_set(xs, i, v) {
    var n = _len_or_err(xs, "list.try_set")
    if oren_is_err(n) { return n }
    if _is_int(i) == false { return oren_err(4, "list.try_set: index not int") }
    if i < 0 || i >= n { return oren_err(4, "list.try_set: index out of bounds") }
    xs[i] = v
    return nil
}

fn try_last(xs) {
    var n = _len_or_err(xs, "list.try_last")
    if oren_is_err(n) { return n }
    if n <= 0 { return oren_err(4, "list.try_last: empty list") }
    return xs[n - 1]
}

fn get(xs, i) { return xs[i] }

fn set(xs, i, v) {
    xs[i] = v
    return nil
}

fn last(xs) {
    var n = oren_list_len(xs)
    if n <= 0 { return nil }
    return xs[n - 1]
}
