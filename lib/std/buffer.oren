// std/buffer (rolling)
//
// Goal:
// - Provide a minimal, cross-backend typed-buffer surface for HPC-style code.
// - Keep views zero-copy by using offsets/strides over a shared buffer object.
//
// Reality in v0:
// - Typed buffers are currently runtime primitives (C backend + AVM + native runtime).
// - Oren does not have full generics yet, so this module provides structural
//   "views" that rely on passing the right load/store function.

import list "std:list"
import bytesm "std:bytes"
import common "std:buffer/common"
import view "std:buffer/view"
import mat "std:buffer/mat"

fn _err_invalid(msg) { return common._err_invalid(msg) }
fn _is_int(v) { return common._is_int(v) }

fn _len_or_err(buf, ctx) {
    var n = oren_buf_len(buf)
    if n == nil || oren_is_err(n) { return oren_err(4, ctx + ": buf must be typed buffer") }
    return n
}

fn _check_idx(buf, idx, ctx) {
    var n = _len_or_err(buf, ctx)
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, ctx + ": index not int") }
    if idx < 0 || idx >= n { return oren_err(4, ctx + ": index out of bounds") }
    return n
}

fn _check_int(v, ctx, label) { return common._check_int(v, ctx, label) }
fn _check_nonneg_int(v, ctx, label) { return common._check_nonneg_int(v, ctx, label) }
fn _check_positive_int(v, ctx, label) { return common._check_positive_int(v, ctx, label) }

fn _list_len_like_or_err(xs, ctx) {
    if oren_type_tag(xs) != 6 { return _err_invalid(ctx + ": expects list<int>") }
    var n = list.len(xs)
    if oren_is_err(n) { return _err_invalid(ctx + ": expects list<int>") }
    return n
}

fn _plain_list_len_or_err(xs, ctx) { return common._plain_list_len_or_err(xs, ctx) }

// Constructors (thin wrappers)
fn u8_new(n) { return oren_u8_buf_new(n) }
fn i32_new(n) { return oren_i32_buf_new(n) }
fn i64_new(n) { return oren_i64_buf_new(n) }
fn f32_new(n) { return oren_f32_buf_new(n) }
fn f64_new(n) { return oren_f64_buf_new(n) }

fn len(buf) { return oren_buf_len(buf) }

// --- structured error helpers (value-or-err) ---

fn try_len(buf) {
    return _len_or_err(buf, "buffer.try_len")
}

fn try_load_u8(buf, idx) {
    var n = _len_or_err(buf, "buffer.try_load_u8")
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, "buffer.try_load_u8: index not int") }
    if idx < 0 || idx >= n { return oren_err(4, "buffer.try_load_u8: index out of bounds") }
    return oren_buf_load_u8(buf, idx)
}

fn try_store_u8(buf, idx, v) {
    var n = _check_idx(buf, idx, "buffer.try_store_u8")
    if oren_is_err(n) { return n }
    if _is_int(v) == false { return oren_err(4, "buffer.try_store_u8: value not int") }
    if v < 0 || v > 255 { return oren_err(4, "buffer.try_store_u8: byte out of range") }
    return oren_buf_store_u8(buf, idx, v)
}

