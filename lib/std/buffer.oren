fn mat_view_new(buf, off, rows, cols, row_stride) {
    if off < 0 || rows < 0 || cols < 0 || row_stride < 0 {
        return _err_invalid("mat_view_new: negative arg")
    }
    if row_stride < cols {
        return _err_invalid("mat_view_new: stride < cols")
    }
    // Bounds: last element index = off + (rows-1)*row_stride + (cols-1)
    var bl = oren_buf_len(buf)
    if oren_is_err(bl) { return bl }
    if rows == 0 || cols == 0 { return [buf, off, rows, cols, row_stride] }
    var last = off + (rows - 1) * row_stride + (cols - 1)
    if last < 0 || last >= bl { return _err_invalid("mat_view_new: out of bounds") }
    return [buf, off, rows, cols, row_stride]
}

fn mat_load_f32(m, r, c) {
    if !_mat_is_list(m) { return _err_invalid("mat_load_f32: expects mat view") }
    var rows = m[2]
    var cols = m[3]
    if r < 0 || c < 0 || r >= rows || c >= cols { return _err_invalid("mat_load_f32: index out of bounds") }
    var idx = m[1] + r * m[4] + c
    return oren_buf_load_f32(m[0], idx)
}

fn mat_store_f32(m, r, c, v) {
    if !_mat_is_list(m) { return _err_invalid("mat_store_f32: expects mat view") }
    var rows = m[2]
    var cols = m[3]
    if r < 0 || c < 0 || r >= rows || c >= cols { return _err_invalid("mat_store_f32: index out of bounds") }
    var idx = m[1] + r * m[4] + c
    return oren_buf_store_f32(m[0], idx, v)
}

