    return oren_buf_load_f64(m[0], idx)
}

fn mat_store_f64(m, r, c, v) {
    if !_mat_is_list(m) { return _err_invalid("mat_store_f64: expects mat view") }
    var rows = m[2]
    var cols = m[3]
    if r < 0 || c < 0 || r >= rows || c >= cols { return _err_invalid("mat_store_f64: index out of bounds") }
    var idx = m[1] + r * m[4] + c
    return oren_buf_store_f64(m[0], idx, v)
}
