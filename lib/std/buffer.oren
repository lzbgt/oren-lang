// Safe copying bridge: pack a `list<int>` into a contiguous `[]i32` typed buffer.
//
// This is intentionally explicit and checked:
// - accepts ordinary `list` values and native `list_int` values
// - rejects elements outside the signed i32 range
// - copies into a fresh/explicit buffer instead of pretending the current 8-byte slots
//   are already a packed i32 view
fn i32_pack_list_int(xs) { return raw.try_i32_pack_list_int(xs) }

fn i32_pack_list_int_into(out: []i32, xs) { return raw.try_i32_pack_list_int_into(out, xs) }

fn i32_unpack_list(buf: []i32) { return raw.try_i32_unpack_list(buf) }

fn i64_pack_list_int(xs) { return raw.try_i64_pack_list_int(xs) }

fn i64_pack_list_int_into(out: []i64, xs) { return raw.try_i64_pack_list_int_into(out, xs) }

fn i64_unpack_list(buf: []i64) { return raw.try_i64_unpack_list(buf) }

fn f32_pack_list(xs) { return raw.try_f32_pack_list(xs) }

fn f32_pack_list_into(out: []f32, xs) { return raw.try_f32_pack_list_into(out, xs) }

fn f32_unpack_list(buf: []f32) { return raw.try_f32_unpack_list(buf) }

fn f64_pack_list(xs) { return raw.try_f64_pack_list(xs) }

fn f64_pack_list_into(out: []f64, xs) { return raw.try_f64_pack_list_into(out, xs) }

