// std/buffer (rolling)
//
// Goal:
// - Provide a minimal, cross-backend typed-buffer surface for HPC-style code.
// - Keep views zero-copy by using offsets/strides over a shared buffer object.
//
// Reality in v0:
// - Typed buffers are currently runtime primitives (C backend + AVM + native runtime).
// - Oren does not have full generics yet, so this module provides structural
//   "views" that rely on passing the right load/store function.

import raw "std:buffer/raw"
import view "std:buffer/view"
import core "std:buffer/mat_core"
import proj "std:buffer/mat_proj"
import mnum "std:buffer/mat_numeric"
import mu8 "std:buffer/mat_u8"

// Constructors (thin wrappers)
fn u8_new(n) { return raw.u8_new(n) }
fn i32_new(n) { return raw.i32_new(n) }
fn i64_new(n) { return raw.i64_new(n) }
fn f32_new(n) { return raw.f32_new(n) }
fn f64_new(n) { return raw.f64_new(n) }

fn len(buf) { return oren_buf_len(buf) }

