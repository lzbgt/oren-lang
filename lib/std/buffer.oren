// std/buffer (rolling)
//
// Goal:
// - Provide a minimal, cross-backend typed-buffer surface for HPC-style code.
// - Keep views zero-copy by using offsets/strides over a shared buffer object.
//
// Reality in v0:
// - Typed buffers are currently runtime primitives (C backend + AVM + native runtime).
// - Oren does not have full generics yet, so this module provides structural
//   "views" that rely on passing the right load/store function.

import list "std:list"
import bytesm "std:bytes"

fn _err_invalid(msg) { return oren_err(4, msg) }

fn _is_int(v) {
    if v == nil { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn _len_or_err(buf, ctx) {
    var n = oren_buf_len(buf)
    if n == nil || oren_is_err(n) { return oren_err(4, ctx + ": buf must be typed buffer") }
    return n
}

fn _check_idx(buf, idx, ctx) {
    var n = _len_or_err(buf, ctx)
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, ctx + ": index not int") }
    if idx < 0 || idx >= n { return oren_err(4, ctx + ": index out of bounds") }
    return n
}

fn _check_int(v, ctx, label) {
    if _is_int(v) == false { return oren_err(4, ctx + ": " + label + " not int") }
    return v
}

fn _check_nonneg_int(v, ctx, label) {
    var ok = _check_int(v, ctx, label)
    if oren_is_err(ok) { return ok }
    if v < 0 { return oren_err(4, ctx + ": negative " + label) }
    return v
}

fn _check_positive_int(v, ctx, label) {
    var ok = _check_int(v, ctx, label)
    if oren_is_err(ok) { return ok }
    if v <= 0 { return oren_err(4, ctx + ": " + label + " must be > 0") }
    return v
}

fn _list_len_like_or_err(xs, ctx) {
    if oren_type_tag(xs) != 6 { return _err_invalid(ctx + ": expects list<int>") }
    var n = list.len(xs)
    if oren_is_err(n) { return _err_invalid(ctx + ": expects list<int>") }
    return n
}

// Constructors (thin wrappers)
fn u8_new(n) { return oren_u8_buf_new(n) }
fn i32_new(n) { return oren_i32_buf_new(n) }
fn i64_new(n) { return oren_i64_buf_new(n) }
fn f32_new(n) { return oren_f32_buf_new(n) }
fn f64_new(n) { return oren_f64_buf_new(n) }

fn len(buf) { return oren_buf_len(buf) }

// --- structured error helpers (value-or-err) ---

fn try_len(buf) {
    return _len_or_err(buf, "buffer.try_len")
}

fn try_load_u8(buf, idx) {
    var n = _len_or_err(buf, "buffer.try_load_u8")
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, "buffer.try_load_u8: index not int") }
    if idx < 0 || idx >= n { return oren_err(4, "buffer.try_load_u8: index out of bounds") }
    return oren_buf_load_u8(buf, idx)
}

fn try_store_u8(buf, idx, v) {
    var n = _check_idx(buf, idx, "buffer.try_store_u8")
    if oren_is_err(n) { return n }
    if _is_int(v) == false { return oren_err(4, "buffer.try_store_u8: value not int") }
    if v < 0 || v > 255 { return oren_err(4, "buffer.try_store_u8: byte out of range") }
    return oren_buf_store_u8(buf, idx, v)
}

fn try_load_i32(buf, idx) {
    var n = _check_idx(buf, idx, "buffer.try_load_i32")
    if oren_is_err(n) { return n }
    return oren_buf_load_i32(buf, idx)
}

fn try_store_i32(buf, idx, v) {
    var n = _check_idx(buf, idx, "buffer.try_store_i32")
    if oren_is_err(n) { return n }
    if _is_int(v) == false { return oren_err(4, "buffer.try_store_i32: value not int") }
    return oren_buf_store_i32(buf, idx, v)
}

fn try_load_i64(buf, idx) {
    var n = _check_idx(buf, idx, "buffer.try_load_i64")
    if oren_is_err(n) { return n }
    return oren_buf_load_i64(buf, idx)
}

fn try_store_i64(buf, idx, v) {
    var n = _check_idx(buf, idx, "buffer.try_store_i64")
    if oren_is_err(n) { return n }
    if _is_int(v) == false { return oren_err(4, "buffer.try_store_i64: value not int") }
    return oren_buf_store_i64(buf, idx, v)
}

fn try_load_f32(buf, idx) {
    var n = _check_idx(buf, idx, "buffer.try_load_f32")
    if oren_is_err(n) { return n }
    return oren_buf_load_f32(buf, idx)
}

fn try_store_f32(buf, idx, v) {
    var n = _check_idx(buf, idx, "buffer.try_store_f32")
    if oren_is_err(n) { return n }
    return oren_buf_store_f32(buf, idx, v)
}

fn try_load_f64(buf, idx) {
    var n = _check_idx(buf, idx, "buffer.try_load_f64")
    if oren_is_err(n) { return n }
    return oren_buf_load_f64(buf, idx)
}

fn try_store_f64(buf, idx, v) {
    var n = _check_idx(buf, idx, "buffer.try_store_f64")
    if oren_is_err(n) { return n }
    return oren_buf_store_f64(buf, idx, v)
}

// Safe copying bridge: pack a `list<int>` into a contiguous `[]i32` typed buffer.
//
// This is intentionally explicit and checked:
// - accepts ordinary `list` values and native `list_int` values
// - rejects elements outside the signed i32 range
// - copies into a fresh/explicit buffer instead of pretending the current 8-byte slots
//   are already a packed i32 view
fn i32_pack_list_int(xs) {
    var n = _list_len_like_or_err(xs, "buffer.i32_pack_list_int")
    if oren_is_err(n) { return n }
    var out: []i32 = i32_new(n)
    if oren_is_err(out) { return out }
    return i32_pack_list_int_into(out, xs)
}

fn i32_pack_list_int_into(out: []i32, xs) {
    var n = _list_len_like_or_err(xs, "buffer.i32_pack_list_int_into")
    if oren_is_err(n) { return n }
    var no = len(out)
    if oren_is_err(no) { return no }
    if no != n { return _err_invalid("buffer.i32_pack_list_int_into: length mismatch") }
    var i = 0
    while i < n {
        var v = xs[i]
        if _is_int(v) == false {
            return _err_invalid("buffer.i32_pack_list_int_into: value not int")
        }
        if v < -2147483648 || v > 2147483647 {
            return _err_invalid("buffer.i32_pack_list_int_into: value out of i32 range")
        }
        var rc = oren_buf_store_i32(out, i, v)
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return out
}

fn try_i32_pack_list_int(xs) {
    return i32_pack_list_int(xs)
}

fn try_i32_pack_list_int_into(out: []i32, xs) {
    return i32_pack_list_int_into(out, xs)
}

fn try_i32_unpack_list(buf: []i32) {
    var n = _len_or_err(buf, "buffer.try_i32_unpack_list")
    if oren_is_err(n) { return n }
    var out = []
    var i = 0
    while i < n {
        var v = oren_buf_load_i32(buf, i)
        if oren_is_err(v) { return v }
        oren_list_push(out, v)
        i = i + 1
    }
    return out
}

fn i32_unpack_list(buf: []i32) {
    return try_i32_unpack_list(buf)
}

fn try_u8_pack(xs) {
    var n = _list_len_like_or_err(xs, "buffer.try_u8_pack")
    if oren_is_err(n) { return n }
    var out: []u8 = u8_new(n)
    if oren_is_err(out) { return out }
    return try_u8_pack_into(out, xs)
}

fn try_u8_pack_into(out: []u8, xs) {
    var n = _list_len_like_or_err(xs, "buffer.try_u8_pack_into")
    if oren_is_err(n) { return n }
    var no = _len_or_err(out, "buffer.try_u8_pack_into")
    if oren_is_err(no) { return no }
    if no != n { return _err_invalid("buffer.try_u8_pack_into: length mismatch") }
    var i = 0
    while i < n {
        var v = xs[i]
        if _is_int(v) == false { return oren_err(4, "buffer.try_u8_pack_into: value not int") }
        if v < 0 || v > 255 { return oren_err(4, "buffer.try_u8_pack_into: byte out of range") }
        var rc = oren_buf_store_u8(out, i, v)
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return out
}

fn u8_pack(xs) {
    return try_u8_pack(xs)
}

fn u8_pack_into(out: []u8, xs) {
    return try_u8_pack_into(out, xs)
}

fn try_u8_unpack(buf: []u8) {
    var n = _len_or_err(buf, "buffer.try_u8_unpack")
    if oren_is_err(n) { return n }
    var out = []
    var i = 0
    while i < n {
        var v = oren_buf_load_u8(buf, i)
        if oren_is_err(v) { return v }
        oren_list_push(out, v)
        i = i + 1
    }
    return out
}

fn u8_unpack(buf: []u8) {
    return try_u8_unpack(buf)
}

fn try_u8_from_string(s) {
    if oren_type_tag(s) != 4 { return oren_err(4, "buffer.try_u8_from_string: s must be string") }
    var xs = oren_bytes_from_string(s)
    if oren_is_err(xs) { return xs }
    return try_u8_pack(xs)
}

fn u8_from_string(s) {
    return try_u8_from_string(s)
}

fn try_u8_to_string(buf: []u8) {
    var xs = try_u8_unpack(buf)
    if oren_is_err(xs) { return xs }
    return oren_string_from_bytes(xs)
}

fn u8_to_string(buf: []u8) {
    return try_u8_to_string(buf)
}

fn try_u8_from_bytes(bytes) {
    return bytesm.try_to_u8_buf(bytes)
}

fn u8_from_bytes(bytes) {
    return try_u8_from_bytes(bytes)
}

fn try_u8_from_bytes_slice(bytes, off, n) {
    return bytesm.try_to_u8_buf_slice(bytes, off, n)
}

fn u8_from_bytes_slice(bytes, off, n) {
    return try_u8_from_bytes_slice(bytes, off, n)
}

fn try_u8_to_bytes(buf: []u8) {
    return bytesm.try_from_u8_buf(buf)
}

fn u8_to_bytes(buf: []u8) {
    return try_u8_to_bytes(buf)
}

fn _u8_view_unpack(load_fn, view, n, ctx) {
    var out = []
    var i = 0
    while i < n {
        var b = load_fn(view, i)
        if oren_is_err(b) { return oren_err(4, ctx + ": expected []u8 view") }
        oren_list_push(out, b)
        i = i + 1
    }
    return out
}

fn _u8_view_to_u8_buf(load_fn, view, n, ctx) {
    var xs = _u8_view_unpack(load_fn, view, n, ctx)
    if oren_is_err(xs) { return xs }
    return try_u8_pack(xs)
}

fn _u8_view_copy_from_bytes(store_fn, view, n, bytes, ctx) {
    var xs = bytesm.try_unpack(bytes)
    if oren_is_err(xs) { return xs }
    if oren_list_len(xs) != n { return _err_invalid(ctx + ": length mismatch") }
    var i = 0
    while i < n {
        var rc = store_fn(view, i, xs[i])
        if oren_is_err(rc) { return oren_err(4, ctx + ": expected []u8 view") }
        i = i + 1
    }
    return view[0]
}

fn _u8_view_copy_from_string(store_fn, view, n, s, ctx) {
    var bs = bytesm.try_from_string(s)
    if oren_is_err(bs) { return bs }
    return _u8_view_copy_from_bytes(store_fn, view, n, bs, ctx)
}

// --- generic zero-copy views ---

// View representation (rolling, perf-oriented):
//
// - slice view: [buf, off, len]
// - strided view: [buf, off, len, stride]
// - matrix view: [buf, off, rows, cols, row_stride]
//
// We use a fixed-position list instead of a map to avoid hash/key overhead in hot loops.
// (Still portable across C/native/AVM because lists are core values.)

fn _list_len_or_err(v) {
    if oren_type_tag(v) != 6 { return _err_invalid("buffer: expects list view") }
    return list.len(v)
}

fn _slice_is_list(s) {
    if s == nil || oren_is_err(s) { return false }
    var ln = _list_len_or_err(s)
    if oren_is_err(ln) { return false }
    return ln == 3
}

fn _mat_is_list(m) {
    if m == nil || oren_is_err(m) { return false }
    var ln = _list_len_or_err(m)
    if oren_is_err(ln) { return false }
    return ln == 5
}

fn _strided_is_list(s) {
    if s == nil || oren_is_err(s) { return false }
    var ln = _list_len_or_err(s)
    if oren_is_err(ln) { return false }
    return ln == 4
}

fn slice_new(buf, off, n) {
    // Oren scalar values (bool/int/float) are never nil; use `oren_type_tag(x) == 0` to detect nil.
    if oren_type_tag(off) == 0 || oren_type_tag(n) == 0 { return _err_invalid("slice_new: nil off/len") }
    if off < 0 || n < 0 { return _err_invalid("slice_new: negative off/len") }
    var bl = oren_buf_len(buf)
    if oren_is_err(bl) { return bl }
    if off + n > bl { return _err_invalid("slice_new: out of bounds") }
    return [buf, off, n]
}

fn try_slice_new(buf, off, n) {
    var ok_off = _check_nonneg_int(off, "buffer.try_slice_new", "off")
    if oren_is_err(ok_off) { return ok_off }
    var ok_n = _check_nonneg_int(n, "buffer.try_slice_new", "len")
    if oren_is_err(ok_n) { return ok_n }
    return slice_new(buf, off, n)
}

fn slice_slice(s, off, n) {
    if !_slice_is_list(s) { return _err_invalid("slice_slice: expects slice") }
    if oren_type_tag(off) == 0 || oren_type_tag(n) == 0 { return _err_invalid("slice_slice: nil off/len") }
    if off < 0 || n < 0 { return _err_invalid("slice_slice: negative off/len") }
    var base_off = s[1]
    var base_n = s[2]
    if off + n > base_n { return _err_invalid("slice_slice: out of bounds") }
    return [s[0], base_off + off, n]
}

fn try_slice_slice(s, off, n) {
    if !_slice_is_list(s) { return _err_invalid("buffer.try_slice_slice: expects slice") }
    var ok_off = _check_nonneg_int(off, "buffer.try_slice_slice", "off")
    if oren_is_err(ok_off) { return ok_off }
    var ok_n = _check_nonneg_int(n, "buffer.try_slice_slice", "len")
    if oren_is_err(ok_n) { return ok_n }
    return slice_slice(s, off, n)
}

fn slice_len(s) {
    if !_slice_is_list(s) { return _err_invalid("slice_len: expects slice") }
    return s[2]
}

fn try_slice_len(s) {
    if !_slice_is_list(s) { return _err_invalid("buffer.try_slice_len: expects slice") }
    return s[2]
}

fn strided_new(buf, off, n, stride) {
    if oren_type_tag(off) == 0 || oren_type_tag(n) == 0 || oren_type_tag(stride) == 0 { return _err_invalid("strided_new: nil arg") }
    if off < 0 || n < 0 { return _err_invalid("strided_new: negative off/len") }
    if stride <= 0 { return _err_invalid("strided_new: stride must be > 0") }
    var bl = oren_buf_len(buf)
    if oren_is_err(bl) { return bl }
    if n == 0 { return [buf, off, 0, stride] }
    // Bounds: last element index = off + (n-1)*stride
    var last = off + (n - 1) * stride
    if off > bl || last < 0 || last >= bl { return _err_invalid("strided_new: out of bounds") }
    return [buf, off, n, stride]
}

fn try_strided_new(buf, off, n, stride) {
    var ok_off = _check_nonneg_int(off, "buffer.try_strided_new", "off")
    if oren_is_err(ok_off) { return ok_off }
    var ok_n = _check_nonneg_int(n, "buffer.try_strided_new", "len")
    if oren_is_err(ok_n) { return ok_n }
    var ok_stride = _check_positive_int(stride, "buffer.try_strided_new", "stride")
    if oren_is_err(ok_stride) { return ok_stride }
    return strided_new(buf, off, n, stride)
}

fn strided_len(s) {
    if !_strided_is_list(s) { return _err_invalid("strided_len: expects strided") }
    return s[2]
}

fn try_strided_len(s) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_len: expects strided") }
    return s[2]
}

fn strided_load_i32(s, idx) {
    if !_strided_is_list(s) { return _err_invalid("strided_load_i32: expects strided") }
    var n = s[2]
    if idx < 0 || idx >= n { return _err_invalid("strided_load_i32: index out of bounds") }
    return oren_buf_load_i32(s[0], s[1] + idx * s[3])
}

fn try_strided_load_i32(s, idx) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_load_i32: expects strided") }
    var n = s[2]
    var ok_idx = _check_int(idx, "buffer.try_strided_load_i32", "index")
    if oren_is_err(ok_idx) { return ok_idx }
    if idx < 0 || idx >= n { return oren_err(4, "buffer.try_strided_load_i32: index out of bounds") }
    return strided_load_i32(s, idx)
}

fn strided_store_i32(s, idx, v) {
    if !_strided_is_list(s) { return _err_invalid("strided_store_i32: expects strided") }
    var n = s[2]
    if idx < 0 || idx >= n { return _err_invalid("strided_store_i32: index out of bounds") }
    return oren_buf_store_i32(s[0], s[1] + idx * s[3], v)
}

fn try_strided_store_i32(s, idx, v) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_store_i32: expects strided") }
    var n = s[2]
    var ok_idx = _check_int(idx, "buffer.try_strided_store_i32", "index")
    if oren_is_err(ok_idx) { return ok_idx }
    if idx < 0 || idx >= n { return oren_err(4, "buffer.try_strided_store_i32: index out of bounds") }
    if _is_int(v) == false { return oren_err(4, "buffer.try_strided_store_i32: value not int") }
    return strided_store_i32(s, idx, v)
}

fn strided_load_u8(s, idx) {
    if !_strided_is_list(s) { return _err_invalid("strided_load_u8: expects strided") }
    var n = s[2]
    if idx < 0 || idx >= n { return _err_invalid("strided_load_u8: index out of bounds") }
    return oren_buf_load_u8(s[0], s[1] + idx * s[3])
}

fn try_strided_load_u8(s, idx) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_load_u8: expects strided") }
    var n = s[2]
    var ok_idx = _check_int(idx, "buffer.try_strided_load_u8", "index")
    if oren_is_err(ok_idx) { return ok_idx }
    if idx < 0 || idx >= n { return oren_err(4, "buffer.try_strided_load_u8: index out of bounds") }
    return strided_load_u8(s, idx)
}

fn strided_store_u8(s, idx, v) {
    if !_strided_is_list(s) { return _err_invalid("strided_store_u8: expects strided") }
    var n = s[2]
    if idx < 0 || idx >= n { return _err_invalid("strided_store_u8: index out of bounds") }
    return oren_buf_store_u8(s[0], s[1] + idx * s[3], v)
}

fn try_strided_store_u8(s, idx, v) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_store_u8: expects strided") }
    var n = s[2]
    var ok_idx = _check_int(idx, "buffer.try_strided_store_u8", "index")
    if oren_is_err(ok_idx) { return ok_idx }
    if idx < 0 || idx >= n { return oren_err(4, "buffer.try_strided_store_u8: index out of bounds") }
    if _is_int(v) == false { return oren_err(4, "buffer.try_strided_store_u8: value not int") }
    if v < 0 || v > 255 { return oren_err(4, "buffer.try_strided_store_u8: byte out of range") }
    return strided_store_u8(s, idx, v)
}

fn try_strided_to_bytes(s) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_to_bytes: expects strided") }
    var xs = _u8_view_unpack(try_strided_load_u8, s, s[2], "buffer.try_strided_to_bytes")
    if oren_is_err(xs) { return xs }
    return bytesm.try_pack(xs)
}

fn strided_to_bytes(s) {
    return try_strided_to_bytes(s)
}

fn try_strided_to_u8_buf(s) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_to_u8_buf: expects strided") }
    return _u8_view_to_u8_buf(try_strided_load_u8, s, s[2], "buffer.try_strided_to_u8_buf")
}

fn strided_to_u8_buf(s) {
    return try_strided_to_u8_buf(s)
}

fn try_strided_to_string(s) {
    var bs = try_strided_to_bytes(s)
    if oren_is_err(bs) { return bs }
    return bytesm.try_to_string(bs)
}

fn strided_to_string(s) {
    return try_strided_to_string(s)
}

fn try_strided_copy_from_bytes(s, bytes) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_copy_from_bytes: expects strided") }
    return _u8_view_copy_from_bytes(try_strided_store_u8, s, s[2], bytes, "buffer.try_strided_copy_from_bytes")
}

fn strided_copy_from_bytes(s, bytes) {
    return try_strided_copy_from_bytes(s, bytes)
}

fn try_strided_copy_from_string(s, text) {
