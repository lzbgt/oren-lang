// std/buffer (rolling)
//
// Goal:
// - Provide a minimal, cross-backend typed-buffer surface for HPC-style code.
// - Keep views zero-copy by using offsets/strides over a shared buffer object.
//
// Reality in v0:
// - Typed buffers are currently runtime primitives (C backend + AVM + native runtime).
// - Oren does not have full generics yet, so this module provides structural
//   "views" that rely on passing the right load/store function.

fn _err_invalid(msg) { return oren_err(4, msg) }

// Constructors (thin wrappers)
fn u8_new(n) { return oren_u8_buf_new(n) }
fn i32_new(n) { return oren_i32_buf_new(n) }
fn i64_new(n) { return oren_i64_buf_new(n) }
fn f32_new(n) { return oren_f32_buf_new(n) }
fn f64_new(n) { return oren_f64_buf_new(n) }

fn len(buf) { return oren_buf_len(buf) }

// --- generic zero-copy views ---

// View representation (rolling, perf-oriented):
//
// - slice view: [buf, off, len]
// - matrix view: [buf, off, rows, cols, row_stride]
//
// We use a fixed-position list instead of a map to avoid hash/key overhead in hot loops.
// (Still portable across C/native/AVM because lists are core values.)

fn _list_len_or_err(v) { return oren_list_len(v) }

fn _slice_is_list(s) {
    if s == nil || oren_is_err(s) { return false }
    var ln = _list_len_or_err(s)
    if oren_is_err(ln) { return false }
    return ln == 3
}

fn _mat_is_list(m) {
    if m == nil || oren_is_err(m) { return false }
    var ln = _list_len_or_err(m)
    if oren_is_err(ln) { return false }
    return ln == 5
}

fn slice_new(buf, off, n) {
    if off == nil || n == nil { return _err_invalid("slice_new: nil off/len") }
    if off < 0 || n < 0 { return _err_invalid("slice_new: negative off/len") }
    var bl = oren_buf_len(buf)
    if oren_is_err(bl) { return bl }
    if off + n > bl { return _err_invalid("slice_new: out of bounds") }
    return [buf, off, n]
}

fn slice_len(s) {
    if !_slice_is_list(s) { return _err_invalid("slice_len: expects slice") }
    return s[2]
}

fn slice_load_i32(s, idx) {
    if !_slice_is_list(s) { return _err_invalid("slice_load_i32: expects slice") }
    var n = s[2]
    if idx < 0 || idx >= n { return _err_invalid("slice_load_i32: index out of bounds") }
    return oren_buf_load_i32(s[0], s[1] + idx)
}

fn slice_store_i32(s, idx, v) {
    if !_slice_is_list(s) { return _err_invalid("slice_store_i32: expects slice") }
    var n = s[2]
    if idx < 0 || idx >= n { return _err_invalid("slice_store_i32: index out of bounds") }
    return oren_buf_store_i32(s[0], s[1] + idx, v)
}

