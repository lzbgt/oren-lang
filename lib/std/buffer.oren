// std/buffer (rolling)
//
// Goal:
// - Provide a minimal, cross-backend typed-buffer surface for HPC-style code.
// - Keep views zero-copy by using offsets/strides over a shared buffer object.
//
// Reality in v0:
// - Typed buffers are currently runtime primitives (C backend + AVM + native runtime).
// - Oren does not have full generics yet, so this module provides structural
//   "views" that rely on passing the right load/store function.

import raw "std:buffer/raw"
import view "std:buffer/view"
import core "std:buffer/mat_core"
import proj "std:buffer/mat_proj"
import mnum "std:buffer/mat_numeric"
import mu8 "std:buffer/mat_u8"

struct Slice {
    view
}

struct Strided {
    view
}

struct Matrix {
    view
}

trait U8BufferViews {
    fn slice(self, off, n): Slice;
    fn strided(self, off, n, stride): Strided;
    fn matrix(self, rows, cols): Matrix;
    fn matrix_at(self, off, rows, cols, row_stride): Matrix;
}

trait SliceView {
    fn raw_view(self);
    fn len(self);
    fn slice(self, off, n): Slice;
    fn to_bytes(self): bytes;
    fn bytes(self): bytes;
    fn to_u8_buf(self);
    fn text(self);
    fn copy_from_bytes(self, bytes);
    fn copy_from_u8_buf(self, src);
    fn copy_from_string(self, text);
}

trait StridedView {
    fn raw_view(self);
    fn len(self);
    fn to_bytes(self): bytes;
    fn bytes(self): bytes;
    fn to_u8_buf(self);
    fn text(self);
    fn copy_from_bytes(self, bytes);
    fn copy_from_u8_buf(self, src);
    fn copy_from_string(self, text);
}

trait MatrixView {
    fn raw_view(self);
    fn rows(self);
    fn cols(self);
    fn row_stride(self);
    fn row(self, r): Slice;
    fn col(self, c): Strided;
    fn diag(self): Strided;
    fn subview(self, row_off, col_off, rows, cols): Matrix;
    fn to_u8_buf(self);
    fn text(self);
    fn copy_from_string(self, text);
}

fn _slice_wrap(v) {
    if oren_is_err(v) { return v }
    return Slice(v)
}

fn _strided_wrap(v) {
    if oren_is_err(v) { return v }
    return Strided(v)
}

fn _matrix_wrap(v) {
    if oren_is_err(v) { return v }
    return Matrix(v)
}

