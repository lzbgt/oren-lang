impl U8BufferViews for []u8 {
    fn slice(self, off, n): Slice { return slice(self, off, n) }
    fn strided(self, off, n, stride): Strided { return strided(self, off, n, stride) }
    fn matrix(self, rows, cols): Matrix { return matrix(self, rows, cols) }
    fn matrix_at(self, off, rows, cols, row_stride): Matrix { return matrix_at(self, off, rows, cols, row_stride) }
}

impl SliceView for Slice {
    fn raw_view(self) { return self.view }
    fn len(self) { return view.try_slice_len(self.view) }
    fn slice(self, off, n): Slice { return _slice_wrap(view.try_slice_slice(self.view, off, n)) }
    fn to_bytes(self): bytes { return view.try_slice_to_bytes(self.view) }
    fn bytes(self): bytes { return view.try_slice_to_bytes(self.view) }
    fn to_u8_buf(self) { return view.try_slice_to_u8_buf(self.view) }
    fn text(self) { return view.try_slice_to_string(self.view) }
    fn copy_from_bytes(self, bytes) { return view.try_slice_copy_from_bytes(self.view, bytes) }
    fn copy_from_u8_buf(self, src) { return view.try_slice_copy_from_u8_buf(self.view, src) }
    fn copy_from_string(self, text) { return view.try_slice_copy_from_string(self.view, text) }
}

impl StridedView for Strided {
    fn raw_view(self) { return self.view }
    fn len(self) { return view.try_strided_len(self.view) }
    fn to_bytes(self): bytes { return view.try_strided_to_bytes(self.view) }
    fn bytes(self): bytes { return view.try_strided_to_bytes(self.view) }
    fn to_u8_buf(self) { return view.try_strided_to_u8_buf(self.view) }
    fn text(self) { return view.try_strided_to_string(self.view) }
    fn copy_from_bytes(self, bytes) { return view.try_strided_copy_from_bytes(self.view, bytes) }
    fn copy_from_u8_buf(self, src) { return view.try_strided_copy_from_u8_buf(self.view, src) }
    fn copy_from_string(self, text) { return view.try_strided_copy_from_string(self.view, text) }
}

impl MatrixView for Matrix {
    fn raw_view(self) { return self.view }
    fn rows(self) { return core.try_mat_rows(self.view) }
    fn cols(self) { return core.try_mat_cols(self.view) }
    fn row_stride(self) { return core.try_mat_row_stride(self.view) }
    fn row(self, r): Slice { return _slice_wrap(proj.mat_row_slice(self.view, r)) }
    fn col(self, c): Strided { return _strided_wrap(proj.mat_col_strided(self.view, c)) }
    fn diag(self): Strided { return _strided_wrap(proj.mat_diag_strided(self.view)) }
    fn subview(self, row_off, col_off, rows, cols): Matrix {
        return _matrix_wrap(proj.mat_subview(self.view, row_off, col_off, rows, cols))
    }
    fn to_u8_buf(self) { return mu8.try_u8_mat_to_u8_buf(self.view) }
    fn text(self) { return mu8.try_u8_mat_to_string(self.view) }
    fn copy_from_string(self, text) { return mu8.try_u8_mat_copy_from_string(self.view, text) }
}
