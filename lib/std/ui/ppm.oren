// std:ui/ppm (rolling)
//
// Minimal PPM (P6) encoder for debugging and golden tests.
//
// Why PPM (instead of PNG) for v0:
// - deterministic and trivial to encode (no CRC/deflate dependencies)
// - can be opened by many viewers and easily converted
//
// Encoding:
// - Header: "P6\n<w> <h>\n255\n"
// - Body: binary RGB bytes (alpha ignored; premultiply is not performed)

fn _push_ascii_u8(out, b) {
    // out is {"buf": u8_buf, "ptr": data_ptr, "pos": int}
    var ptr = out["ptr"]
    var pos = out["pos"]
    ptr_set_byte(iadd(ptr, pos), b & 255)
    out["pos"] = pos + 1
}

fn _push_ascii_str(out, s) {
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        var b = oren_string_byte_at_unchecked(s, i) & 255
        _push_ascii_u8(out, b)
        i = i + 1
    }
}

fn _digits(n) {
    // Return decimal string for a non-negative int.
    // Use built-in int_to_string (stable across backends).
    return oren_int_to_string(n)
}

fn _bytes_get_u8(bs, data_ptr, i) {
    if data_ptr != nil { return ptr_get_byte(data_ptr + i) & 255 }
    return oren_bytes_get_u8(bs, i)
}

fn encode_rgba(rgba, w, h) {
    if w < 0 || h < 0 { return oren_err(4, "ppm.encode_rgba: invalid size") }
    var n = w * h * 4
    var ln = oren_bytes_len(rgba)
    if oren_is_err(ln) { return ln }
    if ln != n { return oren_err(4, "ppm.encode_rgba: rgba length mismatch") }
    var inp = nil
    if oren_is_u8_buf(rgba) == true { inp = oren_buf_data_ptr_unchecked(rgba) }

    // Allocate exact output length: header + w*h*3 (RGB).
    var ws = _digits(w)
    var hs = _digits(h)
    var header_len = 3 + oren_string_len(ws) + 1 + oren_string_len(hs) + 5
    var out_len = header_len + (w * h * 3)
    var buf = oren_u8_buf_new_uninit(out_len)
    if oren_is_err(buf) { return buf }
    var outp = oren_buf_data_ptr_unchecked(buf)
    if outp == 0 { return oren_err(4, "ppm.encode_rgba: output data ptr is nil") }
    var cur = {"buf": buf, "ptr": outp, "pos": 0}

    // Emit header (ASCII).
    _push_ascii_str(cur, "P6\n")
    _push_ascii_str(cur, ws)
    _push_ascii_str(cur, " ")
    _push_ascii_str(cur, hs)
    _push_ascii_str(cur, "\n255\n")

    // Emit binary RGB.
    var pos = cur["pos"]
    var i = 0
    while i < w * h {
        var r = _bytes_get_u8(rgba, inp, i * 4 + 0)
        var g = _bytes_get_u8(rgba, inp, i * 4 + 1)
        var b = _bytes_get_u8(rgba, inp, i * 4 + 2)
        if oren_is_err(r) || oren_is_err(g) || oren_is_err(b) { return oren_err(4, "ppm.encode_rgba: invalid rgba") }
        ptr_set_byte(iadd(outp, pos + 0), r & 255)
        ptr_set_byte(iadd(outp, pos + 1), g & 255)
        ptr_set_byte(iadd(outp, pos + 2), b & 255)
        pos = pos + 3
        i = i + 1
    }
    // We allocated exact length; pos should match out_len.
    return buf
}

fn write_rgba_ppm(path, rgba, w, h) {
    // `oren_write_bytes` accepts both list<int> and u8_buf on the shared C/native runtimes,
    // so the encoded buffer can be written directly without unpacking back through a list.
    var b = encode_rgba(rgba, w, h)
    if oren_is_err(b) { return b }
    return oren_write_bytes(path, b)
}
