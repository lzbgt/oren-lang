// std:ui/scene3d_shapes (rolling)
//
// Exact-size byte packers for human-readable Scene3D package primitives.
// This keeps shape authoring growth out of the retained-scene orchestration
// module while preserving the existing OGF0 mesh byte ABI.

import ints "std:ints"
import math "std:math"
import raw "std:buffer/raw"

fn _is_int(v) {
    if v == nil { return false }
    return oren_type_tag(v) == 1
}

fn _store_u32_le(out, off, v) {
    raw._store_u8_buf_unchecked_direct(out, off + 0, v & 255)
    raw._store_u8_buf_unchecked_direct(out, off + 1, (v >> 8) & 255)
    raw._store_u8_buf_unchecked_direct(out, off + 2, (v >> 16) & 255)
    raw._store_u8_buf_unchecked_direct(out, off + 3, (v >> 24) & 255)
    return 0
}

fn _store_i32_le(out, off, v) {
    if _is_int(v) == false { return oren_err(4, "ui.scene3d: expected i32") }
    if v < -2147483648 || v > 2147483647 { return oren_err(4, "ui.scene3d: i32 out of range") }
    var u = v
    if u < 0 { u = u + 4294967296 }
    return _store_u32_le(out, off, u)
}

fn _store_xyz_values(out, off, x, y, z, ctx) {
    var rc = _store_i32_le(out, off + 0, x)
    if oren_is_err(rc) { return oren_err(4, ctx + ": x must be i32") }
    rc = _store_i32_le(out, off + 4, y)
    if oren_is_err(rc) { return oren_err(4, ctx + ": y must be i32") }
    rc = _store_i32_le(out, off + 8, z)
    if oren_is_err(rc) { return oren_err(4, ctx + ": z must be i32") }
    return 0
}

fn _center_xy(shape, label, ctx) {
    var center = shape["center"]
    if center == nil { center = shape["center_xy"] }
    if center == nil || oren_list_len(center) != 2 {
        return oren_err(4, ctx + ": " + label + " center must be [x,y]")
    }
    if _is_int(center[0]) == false || _is_int(center[1]) == false {
        return oren_err(4, ctx + ": " + label + " center must contain i32")
    }
    return center
}

fn _radius(shape, label, ctx) {
    var radius = shape["radius"]
    if radius == nil { radius = shape["radius_xy"] }
    if _is_int(radius) == false || radius <= 0 {
        return oren_err(4, ctx + ": " + label + " radius must be positive i32")
    }
    return radius
}

fn _z(shape, primary, fallback, ctx) {
    var v = shape[primary]
    if v == nil { v = shape[fallback] }
    if _is_int(v) == false { return oren_err(4, ctx + ": expected i32") }
    return v
}

fn _segments(shape, label, min_segments, ctx) {
    var segments = shape["segments"]
    if segments == nil { segments = 16 }
    if _is_int(segments) == false || segments < min_segments || segments > 96 {
        return oren_err(4, ctx + ": " + label + " segments must be " + oren_int_to_string(min_segments) + "..96")
    }
    return segments
}

fn _circle_coord(center, radius, segments, index, axis) {
    var angle = math.tau() * f64(index) / f64(segments)
    var unit = math.cos(angle)
    if axis == 1 { unit = math.sin(angle) }
    var rounded = math.round(f64(center) + f64(radius) * unit)
    if oren_is_err(rounded) { return rounded }
    return ints.i32(rounded)
}

fn _store_triangle(out, off, ax, ay, az, bx, by, bz, cx, cy, cz, ctx) {
    var rc = _store_xyz_values(out, off + 0, ax, ay, az, ctx + ".a")
    if oren_is_err(rc) { return rc }
    rc = _store_xyz_values(out, off + 12, bx, by, bz, ctx + ".b")
    if oren_is_err(rc) { return rc }
    return _store_xyz_values(out, off + 24, cx, cy, cz, ctx + ".c")
}

fn _xy_pair(v, label, ctx) {
    if v == nil || oren_list_len(v) != 2 { return oren_err(4, ctx + ": " + label + " must be [x,y]") }
    if _is_int(v[0]) == false || _is_int(v[1]) == false {
        return oren_err(4, ctx + ": " + label + " must contain i32")
    }
    return v
}

fn _xyz_point(v, label, ctx) {
    if v == nil || oren_list_len(v) != 3 { return oren_err(4, ctx + ": " + label + " must be [x,y,z]") }
    if _is_int(v[0]) == false || _is_int(v[1]) == false || _is_int(v[2]) == false {
        return oren_err(4, ctx + ": " + label + " must contain i32")
    }
    return v
}

fn _plane_xy_bounds(plane, ctx) {
    var lo = plane["min"]
    if lo == nil { lo = plane["min_xy"] }
    var hi = plane["max"]
    if hi == nil { hi = plane["max_xy"] }
    if lo != nil || hi != nil {
        lo = _xy_pair(lo, "plane min", ctx)
        if oren_is_err(lo) { return lo }
        hi = _xy_pair(hi, "plane max", ctx)
        if oren_is_err(hi) { return hi }
        var z = plane["z"]
        if z == nil { z = plane["z_milli"] }
        if z == nil { z = 0 }
        if _is_int(z) == false { return oren_err(4, ctx + ": plane z must be i32") }
        if hi[0] <= lo[0] || hi[1] <= lo[1] { return oren_err(4, ctx + ": plane max must be greater than min") }
        return [lo[0], lo[1], hi[0], hi[1], z]
    }
    var origin = plane["origin"]
    if origin == nil { origin = plane["origin_xyz"] }
    origin = _xyz_point(origin, "plane origin", ctx)
    if oren_is_err(origin) { return origin }
    var size = plane["size"]
    if size == nil { size = plane["size_xy"] }
    size = _xy_pair(size, "plane size", ctx)
    if oren_is_err(size) { return size }
    if size[0] <= 0 || size[1] <= 0 { return oren_err(4, ctx + ": plane size must be positive") }
    return [origin[0], origin[1], origin[0] + size[0], origin[1] + size[1], origin[2]]
}

fn _planes_xy_triangle_count(planes, ctx) {
    if planes == nil { return oren_err(4, ctx + ": missing planes_xy") }
    var np = oren_list_len(planes)
    if oren_is_err(np) { return oren_err(4, ctx + ": planes_xy must be list") }
    var i = 0
    while i < np {
        var plane = planes[i]
        if plane == nil { return oren_err(4, ctx + ": plane must be object") }
        var bounds = _plane_xy_bounds(plane, ctx)
        if oren_is_err(bounds) { return bounds }
        i = i + 1
    }
    return np * 2
}

fn pack_planes_xy(planes, ctx) {
    var tri_count = _planes_xy_triangle_count(planes, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var i = 0
    var np = oren_list_len(planes)
    while i < np {
        var bounds = _plane_xy_bounds(planes[i], ctx)
        var x0 = bounds[0]
        var y0 = bounds[1]
        var x1 = bounds[2]
        var y1 = bounds[3]
        var z = bounds[4]
        var rc = _store_triangle(out, off, x0, y0, z, x1, y0, z, x1, y1, z, ctx + ".plane0")
        if oren_is_err(rc) { return rc }
        off = off + 36
        rc = _store_triangle(out, off, x0, y0, z, x1, y1, z, x0, y1, z, ctx + ".plane1")
        if oren_is_err(rc) { return rc }
        off = off + 36
        i = i + 1
    }
    return out
}

fn _polygon_points(poly) {
    var points = poly["points"]
    if points == nil { points = poly["points_xy"] }
    return points
}

fn _polygon_z(poly, ctx) {
    var z = poly["z"]
    if z == nil { z = poly["z_milli"] }
    if z == nil { z = 0 }
    if _is_int(z) == false { return oren_err(4, ctx + ": polygon z must be i32") }
    return z
}

fn _flat_z(shape, label, ctx) {
    var z = shape["z"]
    if z == nil { z = shape["z_milli"] }
    if z == nil { z = 0 }
    if _is_int(z) == false { return oren_err(4, ctx + ": " + label + " z must be i32") }
    return z
}

fn _polygons_xy_triangle_count(polygons, ctx) {
    if polygons == nil { return oren_err(4, ctx + ": missing polygons_xy") }
    var np = oren_list_len(polygons)
    if oren_is_err(np) { return oren_err(4, ctx + ": polygons_xy must be list") }
    var total = 0
    var i = 0
    while i < np {
        var poly = polygons[i]
        if poly == nil { return oren_err(4, ctx + ": polygon must be object") }
        var points = _polygon_points(poly)
        var n = oren_list_len(points)
        if oren_is_err(n) || n < 3 || n > 128 { return oren_err(4, ctx + ": polygon points must contain 3..128 [x,y] entries") }
        var z = _polygon_z(poly, ctx)
        if oren_is_err(z) { return z }
        var j = 0
        while j < n {
            var rc = _xy_pair(points[j], "polygon point", ctx)
            if oren_is_err(rc) { return rc }
            j = j + 1
        }
        total = total + n - 2
        i = i + 1
    }
    if total > 2048 { return oren_err(4, ctx + ": polygons exceed mesh3d triangle budget") }
    return total
}

fn pack_polygons_xy(polygons, ctx) {
    var tri_count = _polygons_xy_triangle_count(polygons, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var pi = 0
    var np = oren_list_len(polygons)
    while pi < np {
        var poly = polygons[pi]
        var points = _polygon_points(poly)
        var z = _polygon_z(poly, ctx)
        var p0 = points[0]
        var i = 1
        while i < oren_list_len(points) - 1 {
            var p1 = points[i]
            var p2 = points[i + 1]
            var rc = _store_triangle(out, off, p0[0], p0[1], z, p1[0], p1[1], z, p2[0], p2[1], z, ctx + ".polygon")
            if oren_is_err(rc) { return rc }
            off = off + 36
            i = i + 1
        }
        pi = pi + 1
    }
    return out
}

fn _discs_xy_triangle_count(discs, ctx) {
    if discs == nil { return oren_err(4, ctx + ": missing discs_xy") }
    var nd = oren_list_len(discs)
    if oren_is_err(nd) { return oren_err(4, ctx + ": discs_xy must be list") }
    var total = 0
    var i = 0
    while i < nd {
        var disc = discs[i]
        if disc == nil { return oren_err(4, ctx + ": disc must be object") }
        var center = _center_xy(disc, "disc", ctx)
        if oren_is_err(center) { return center }
        var radius = _radius(disc, "disc", ctx)
        if oren_is_err(radius) { return radius }
        var z = _flat_z(disc, "disc", ctx)
        if oren_is_err(z) { return z }
        var segments = _segments(disc, "disc", 3, ctx)
        if oren_is_err(segments) { return segments }
        total = total + segments
        i = i + 1
    }
    if total > 2048 { return oren_err(4, ctx + ": discs exceed mesh3d triangle budget") }
    return total
}

fn pack_discs_xy(discs, ctx) {
    var tri_count = _discs_xy_triangle_count(discs, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var di = 0
    var nd = oren_list_len(discs)
    while di < nd {
        var disc = discs[di]
        var center = _center_xy(disc, "disc", ctx)
        var radius = _radius(disc, "disc", ctx)
        var z = _flat_z(disc, "disc", ctx)
        var segments = _segments(disc, "disc", 3, ctx)
        var seg = 0
        while seg < segments {
            var next_seg = seg + 1
            if next_seg == segments { next_seg = 0 }
            var ax = _circle_coord(center[0], radius, segments, seg, 0)
            var ay = _circle_coord(center[1], radius, segments, seg, 1)
            var bx = _circle_coord(center[0], radius, segments, next_seg, 0)
            var by = _circle_coord(center[1], radius, segments, next_seg, 1)
            var rc = _store_triangle(out, off, center[0], center[1], z, ax, ay, z, bx, by, z, ctx + ".disc")
            if oren_is_err(rc) { return rc }
            off = off + 36
            seg = seg + 1
        }
        di = di + 1
    }
    return out
}

fn _radii_xy(shape, primary, fallback, label, ctx) {
    var radii = shape[primary]
    if radii == nil { radii = shape[fallback] }
    radii = _xy_pair(radii, label + " radii", ctx)
    if oren_is_err(radii) { return radii }
    if radii[0] <= 0 || radii[1] <= 0 {
        return oren_err(4, ctx + ": " + label + " radii must be positive i32")
    }
    return radii
}

fn _ellipse_coord(center, radius_x, radius_y, segments, index, axis) {
    var angle = math.tau() * f64(index) / f64(segments)
    var radius = radius_x
    var unit = math.cos(angle)
    if axis == 1 {
        radius = radius_y
        unit = math.sin(angle)
    }
    var rounded = math.round(f64(center) + f64(radius) * unit)
    if oren_is_err(rounded) { return rounded }
    return ints.i32(rounded)
}

fn _ellipses_xy_triangle_count(ellipses, ctx) {
    if ellipses == nil { return oren_err(4, ctx + ": missing ellipses_xy") }
    var ne = oren_list_len(ellipses)
    if oren_is_err(ne) { return oren_err(4, ctx + ": ellipses_xy must be list") }
    var total = 0
    var i = 0
    while i < ne {
        var ellipse = ellipses[i]
        if ellipse == nil { return oren_err(4, ctx + ": ellipse must be object") }
        var center = _center_xy(ellipse, "ellipse", ctx)
        if oren_is_err(center) { return center }
        var radii = _radii_xy(ellipse, "radii", "radii_xy", "ellipse", ctx)
        if oren_is_err(radii) { return radii }
        var z = _flat_z(ellipse, "ellipse", ctx)
        if oren_is_err(z) { return z }
        var segments = _segments(ellipse, "ellipse", 3, ctx)
        if oren_is_err(segments) { return segments }
        total = total + segments
        i = i + 1
    }
    if total > 2048 { return oren_err(4, ctx + ": ellipses exceed mesh3d triangle budget") }
    return total
}

fn pack_ellipses_xy(ellipses, ctx) {
    var tri_count = _ellipses_xy_triangle_count(ellipses, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ei = 0
    var ne = oren_list_len(ellipses)
    while ei < ne {
        var ellipse = ellipses[ei]
        var center = _center_xy(ellipse, "ellipse", ctx)
        var radii = _radii_xy(ellipse, "radii", "radii_xy", "ellipse", ctx)
        var z = _flat_z(ellipse, "ellipse", ctx)
        var segments = _segments(ellipse, "ellipse", 3, ctx)
        var seg = 0
        while seg < segments {
            var next_seg = seg + 1
            if next_seg == segments { next_seg = 0 }
            var ax = _ellipse_coord(center[0], radii[0], radii[1], segments, seg, 0)
            var ay = _ellipse_coord(center[1], radii[0], radii[1], segments, seg, 1)
            var bx = _ellipse_coord(center[0], radii[0], radii[1], segments, next_seg, 0)
            var by = _ellipse_coord(center[1], radii[0], radii[1], segments, next_seg, 1)
            var rc = _store_triangle(out, off, center[0], center[1], z, ax, ay, z, bx, by, z, ctx + ".ellipse")
            if oren_is_err(rc) { return rc }
            off = off + 36
            seg = seg + 1
        }
        ei = ei + 1
    }
    return out
}

fn _ellipse_rings_xy_triangle_count(rings, ctx) {
    if rings == nil { return oren_err(4, ctx + ": missing ellipse_rings_xy") }
    var nr = oren_list_len(rings)
    if oren_is_err(nr) { return oren_err(4, ctx + ": ellipse_rings_xy must be list") }
    var total = 0
    var i = 0
    while i < nr {
        var ring = rings[i]
        if ring == nil { return oren_err(4, ctx + ": ellipse ring must be object") }
        var center = _center_xy(ring, "ellipse ring", ctx)
        if oren_is_err(center) { return center }
        var inner = _radii_xy(ring, "inner_radii", "radii_inner", "ellipse ring inner", ctx)
        if oren_is_err(inner) { return inner }
        var outer = _radii_xy(ring, "outer_radii", "radii_outer", "ellipse ring outer", ctx)
        if oren_is_err(outer) { return outer }
        if outer[0] <= inner[0] || outer[1] <= inner[1] {
            return oren_err(4, ctx + ": ellipse ring outer radii must be greater than inner radii")
        }
        var z = _flat_z(ring, "ellipse ring", ctx)
        if oren_is_err(z) { return z }
        var segments = _segments(ring, "ellipse ring", 3, ctx)
        if oren_is_err(segments) { return segments }
        total = total + segments * 2
        i = i + 1
    }
    if total > 4096 { return oren_err(4, ctx + ": ellipse rings exceed mesh3d triangle budget") }
    return total
}

fn pack_ellipse_rings_xy(rings, ctx) {
    var tri_count = _ellipse_rings_xy_triangle_count(rings, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ri = 0
    var nr = oren_list_len(rings)
    while ri < nr {
        var ring = rings[ri]
        var center = _center_xy(ring, "ellipse ring", ctx)
        var inner = _radii_xy(ring, "inner_radii", "radii_inner", "ellipse ring inner", ctx)
        var outer = _radii_xy(ring, "outer_radii", "radii_outer", "ellipse ring outer", ctx)
        var z = _flat_z(ring, "ellipse ring", ctx)
        var segments = _segments(ring, "ellipse ring", 3, ctx)
        var seg = 0
        while seg < segments {
            var next_seg = seg + 1
            if next_seg == segments { next_seg = 0 }
            var ox0 = _ellipse_coord(center[0], outer[0], outer[1], segments, seg, 0)
            var oy0 = _ellipse_coord(center[1], outer[0], outer[1], segments, seg, 1)
            var ox1 = _ellipse_coord(center[0], outer[0], outer[1], segments, next_seg, 0)
            var oy1 = _ellipse_coord(center[1], outer[0], outer[1], segments, next_seg, 1)
            var ix0 = _ellipse_coord(center[0], inner[0], inner[1], segments, seg, 0)
            var iy0 = _ellipse_coord(center[1], inner[0], inner[1], segments, seg, 1)
            var ix1 = _ellipse_coord(center[0], inner[0], inner[1], segments, next_seg, 0)
            var iy1 = _ellipse_coord(center[1], inner[0], inner[1], segments, next_seg, 1)
            var rc = _store_triangle(out, off, ox0, oy0, z, ox1, oy1, z, ix1, iy1, z, ctx + ".ellipse_ring0")
            if oren_is_err(rc) { return rc }
            off = off + 36
            rc = _store_triangle(out, off, ox0, oy0, z, ix1, iy1, z, ix0, iy0, z, ctx + ".ellipse_ring1")
            if oren_is_err(rc) { return rc }
            off = off + 36
            seg = seg + 1
        }
        ri = ri + 1
    }
    return out
}

fn _regular_polygons_xy_triangle_count(polys, ctx) {
    if polys == nil { return oren_err(4, ctx + ": missing regular_polygons_xy") }
    var np = oren_list_len(polys)
    if oren_is_err(np) { return oren_err(4, ctx + ": regular_polygons_xy must be list") }
    var total = 0
    var i = 0
    while i < np {
        var poly = polys[i]
        if poly == nil { return oren_err(4, ctx + ": regular polygon must be object") }
        var center = _center_xy(poly, "regular polygon", ctx)
        if oren_is_err(center) { return center }
        var radius = _radius(poly, "regular polygon", ctx)
        if oren_is_err(radius) { return radius }
        var z = _flat_z(poly, "regular polygon", ctx)
        if oren_is_err(z) { return z }
        var sides = poly["sides"]
        if sides == nil { sides = poly["segments"] }
        if _is_int(sides) == false || sides < 3 || sides > 96 {
            return oren_err(4, ctx + ": regular polygon sides must be 3..96")
        }
        total = total + sides
        i = i + 1
    }
    if total > 2048 { return oren_err(4, ctx + ": regular polygons exceed mesh3d triangle budget") }
    return total
}

fn pack_regular_polygons_xy(polys, ctx) {
    var tri_count = _regular_polygons_xy_triangle_count(polys, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var pi = 0
    var np = oren_list_len(polys)
    while pi < np {
        var poly = polys[pi]
        var center = _center_xy(poly, "regular polygon", ctx)
        var radius = _radius(poly, "regular polygon", ctx)
        var z = _flat_z(poly, "regular polygon", ctx)
        var sides = poly["sides"]
        if sides == nil { sides = poly["segments"] }
        var side = 0
        while side < sides {
            var next_side = side + 1
            if next_side == sides { next_side = 0 }
            var ax = _circle_coord(center[0], radius, sides, side, 0)
            var ay = _circle_coord(center[1], radius, sides, side, 1)
            var bx = _circle_coord(center[0], radius, sides, next_side, 0)
            var by = _circle_coord(center[1], radius, sides, next_side, 1)
            var rc = _store_triangle(out, off, center[0], center[1], z, ax, ay, z, bx, by, z, ctx + ".regular_polygon")
            if oren_is_err(rc) { return rc }
            off = off + 36
            side = side + 1
        }
        pi = pi + 1
    }
    return out
}

fn _star_points(star, ctx) {
    var n = star["points"]
    if n == nil { n = 5 }
    if _is_int(n) == false || n < 3 || n > 48 {
        return oren_err(4, ctx + ": star points must be 3..48")
    }
    return n
}

fn _stars_xy_triangle_count(stars, ctx) {
    if stars == nil { return oren_err(4, ctx + ": missing stars_xy") }
    var ns = oren_list_len(stars)
    if oren_is_err(ns) { return oren_err(4, ctx + ": stars_xy must be list") }
    var total = 0
    var i = 0
    while i < ns {
        var star = stars[i]
        if star == nil { return oren_err(4, ctx + ": star must be object") }
        var center = _center_xy(star, "star", ctx)
        if oren_is_err(center) { return center }
        var inner = _ring_radius(star, "inner_radius", "radius_inner", "inner", ctx)
        if oren_is_err(inner) { return inner }
        var outer = _ring_radius(star, "outer_radius", "radius_outer", "outer", ctx)
        if oren_is_err(outer) { return outer }
        if outer <= inner { return oren_err(4, ctx + ": star outer radius must be greater than inner radius") }
        var z = _flat_z(star, "star", ctx)
        if oren_is_err(z) { return z }
        var points = _star_points(star, ctx)
        if oren_is_err(points) { return points }
        total = total + points * 2
        i = i + 1
    }
    if total > 2048 { return oren_err(4, ctx + ": stars exceed mesh3d triangle budget") }
    return total
}

fn pack_stars_xy(stars, ctx) {
    var tri_count = _stars_xy_triangle_count(stars, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var si = 0
    var ns = oren_list_len(stars)
    while si < ns {
        var star = stars[si]
        var center = _center_xy(star, "star", ctx)
        var inner = _ring_radius(star, "inner_radius", "radius_inner", "inner", ctx)
        var outer = _ring_radius(star, "outer_radius", "radius_outer", "outer", ctx)
        var z = _flat_z(star, "star", ctx)
        var points = _star_points(star, ctx)
        var vertices = points * 2
        var vi = 0
        while vi < vertices {
            var next_vi = vi + 1
            if next_vi == vertices { next_vi = 0 }
            var ar = outer
            if vi % 2 == 1 { ar = inner }
            var br = outer
            if next_vi % 2 == 1 { br = inner }
            var ax = _circle_coord(center[0], ar, vertices, vi, 0)
            var ay = _circle_coord(center[1], ar, vertices, vi, 1)
            var bx = _circle_coord(center[0], br, vertices, next_vi, 0)
            var by = _circle_coord(center[1], br, vertices, next_vi, 1)
            var rc = _store_triangle(out, off, center[0], center[1], z, ax, ay, z, bx, by, z, ctx + ".star")
            if oren_is_err(rc) { return rc }
            off = off + 36
            vi = vi + 1
        }
        si = si + 1
    }
    return out
}

fn _ring_radius(ring, primary, fallback, label, ctx) {
    var radius = ring[primary]
    if radius == nil { radius = ring[fallback] }
    if _is_int(radius) == false || radius <= 0 {
        return oren_err(4, ctx + ": ring " + label + " radius must be positive i32")
    }
    return radius
}

fn _rings_xy_triangle_count(rings, ctx) {
    if rings == nil { return oren_err(4, ctx + ": missing rings_xy") }
    var nr = oren_list_len(rings)
    if oren_is_err(nr) { return oren_err(4, ctx + ": rings_xy must be list") }
    var total = 0
    var i = 0
    while i < nr {
        var ring = rings[i]
        if ring == nil { return oren_err(4, ctx + ": ring must be object") }
        var center = _center_xy(ring, "ring", ctx)
        if oren_is_err(center) { return center }
        var inner = _ring_radius(ring, "inner_radius", "radius_inner", "inner", ctx)
        if oren_is_err(inner) { return inner }
        var outer = _ring_radius(ring, "outer_radius", "radius_outer", "outer", ctx)
        if oren_is_err(outer) { return outer }
        if outer <= inner { return oren_err(4, ctx + ": ring outer radius must be greater than inner radius") }
        var z = _flat_z(ring, "ring", ctx)
        if oren_is_err(z) { return z }
        var segments = _segments(ring, "ring", 3, ctx)
        if oren_is_err(segments) { return segments }
        total = total + segments * 2
        i = i + 1
    }
    if total > 4096 { return oren_err(4, ctx + ": rings exceed mesh3d triangle budget") }
    return total
}

fn pack_rings_xy(rings, ctx) {
    var tri_count = _rings_xy_triangle_count(rings, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ri = 0
    var nr = oren_list_len(rings)
    while ri < nr {
        var ring = rings[ri]
        var center = _center_xy(ring, "ring", ctx)
        var inner = _ring_radius(ring, "inner_radius", "radius_inner", "inner", ctx)
        var outer = _ring_radius(ring, "outer_radius", "radius_outer", "outer", ctx)
        var z = _flat_z(ring, "ring", ctx)
        var segments = _segments(ring, "ring", 3, ctx)
        var seg = 0
        while seg < segments {
            var next_seg = seg + 1
            if next_seg == segments { next_seg = 0 }
            var ox0 = _circle_coord(center[0], outer, segments, seg, 0)
            var oy0 = _circle_coord(center[1], outer, segments, seg, 1)
            var ox1 = _circle_coord(center[0], outer, segments, next_seg, 0)
            var oy1 = _circle_coord(center[1], outer, segments, next_seg, 1)
            var ix0 = _circle_coord(center[0], inner, segments, seg, 0)
            var iy0 = _circle_coord(center[1], inner, segments, seg, 1)
            var ix1 = _circle_coord(center[0], inner, segments, next_seg, 0)
            var iy1 = _circle_coord(center[1], inner, segments, next_seg, 1)
            var rc = _store_triangle(out, off, ox0, oy0, z, ox1, oy1, z, ix1, iy1, z, ctx + ".ring0")
            if oren_is_err(rc) { return rc }
            off = off + 36
            rc = _store_triangle(out, off, ox0, oy0, z, ix1, iy1, z, ix0, iy0, z, ctx + ".ring1")
            if oren_is_err(rc) { return rc }
            off = off + 36
            seg = seg + 1
        }
        ri = ri + 1
    }
    return out
}

fn _line_width(shape, label, ctx) {
    var width = shape["width"]
    if width == nil { width = shape["width_milli"] }
    if width == nil { width = 1 }
    if _is_int(width) == false || width <= 0 {
        return oren_err(4, ctx + ": " + label + " width must be positive i32")
    }
    return width
}

fn _segment_point(seg, primary, fallback, label, ctx) {
    var point = seg[primary]
    if point == nil { point = seg[fallback] }
    return _xy_pair(point, label, ctx)
}

fn _path_points(path) {
    var points = path["points"]
    if points == nil { points = path["points_xy"] }
    return points
}

fn _line_offset(dx, dy, width, axis, ctx) {
    var len = math.sqrt(f64(dx) * f64(dx) + f64(dy) * f64(dy))
    if oren_is_err(len) || len <= 0.0 { return oren_err(4, ctx + ": line segment must be nonzero") }
    var scale = f64(width) * 0.5 / len
    var v = (0.0 - f64(dy)) * scale
    if axis == 1 { v = f64(dx) * scale }
    var rounded = math.round(v)
    if oren_is_err(rounded) { return rounded }
    return ints.i32(rounded)
}

fn _store_line_segment(out, off, x0, y0, x1, y1, z, width, ctx) {
    var dx = x1 - x0
    var dy = y1 - y0
    var ox = _line_offset(dx, dy, width, 0, ctx)
    if oren_is_err(ox) { return ox }
    var oy = _line_offset(dx, dy, width, 1, ctx)
    if oren_is_err(oy) { return oy }
    if ox == 0 && oy == 0 { return oren_err(4, ctx + ": line width rounds to zero") }
    var ax = x0 + ox
    var ay = y0 + oy
    var bx = x1 + ox
    var by = y1 + oy
    var cx = x1 - ox
    var cy = y1 - oy
    var dxp = x0 - ox
    var dyp = y0 - oy
    var rc = _store_triangle(out, off, ax, ay, z, bx, by, z, cx, cy, z, ctx + ".line0")
    if oren_is_err(rc) { return rc }
    return _store_triangle(out, off + 36, ax, ay, z, cx, cy, z, dxp, dyp, z, ctx + ".line1")
}

fn _segments_xy_triangle_count(segments, ctx) {
    if segments == nil { return oren_err(4, ctx + ": missing segments_xy") }
    var ns = oren_list_len(segments)
    if oren_is_err(ns) { return oren_err(4, ctx + ": segments_xy must be list") }
    var i = 0
    while i < ns {
        var seg = segments[i]
        if seg == nil { return oren_err(4, ctx + ": segment must be object") }
        var p0 = _segment_point(seg, "from", "start", "segment from", ctx)
        if oren_is_err(p0) { return p0 }
        var p1 = _segment_point(seg, "to", "end", "segment to", ctx)
        if oren_is_err(p1) { return p1 }
        if p0[0] == p1[0] && p0[1] == p1[1] { return oren_err(4, ctx + ": segment must be nonzero") }
        var width = _line_width(seg, "segment", ctx)
        if oren_is_err(width) { return width }
        var z = _flat_z(seg, "segment", ctx)
        if oren_is_err(z) { return z }
        i = i + 1
    }
    if ns * 2 > 4096 { return oren_err(4, ctx + ": segments exceed mesh3d triangle budget") }
    return ns * 2
}

fn pack_segments_xy(segments, ctx) {
    var tri_count = _segments_xy_triangle_count(segments, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var i = 0
    var ns = oren_list_len(segments)
    while i < ns {
        var seg = segments[i]
        var p0 = _segment_point(seg, "from", "start", "segment from", ctx)
        var p1 = _segment_point(seg, "to", "end", "segment to", ctx)
        var width = _line_width(seg, "segment", ctx)
        var z = _flat_z(seg, "segment", ctx)
        var rc = _store_line_segment(out, off, p0[0], p0[1], p1[0], p1[1], z, width, ctx + ".segment")
        if oren_is_err(rc) { return rc }
        off = off + 72
        i = i + 1
    }
    return out
}

fn _paths_xy_triangle_count(paths, ctx) {
    if paths == nil { return oren_err(4, ctx + ": missing paths_xy") }
    var np = oren_list_len(paths)
    if oren_is_err(np) { return oren_err(4, ctx + ": paths_xy must be list") }
    var total = 0
    var i = 0
    while i < np {
        var path = paths[i]
        if path == nil { return oren_err(4, ctx + ": path must be object") }
        var points = _path_points(path)
        var n = oren_list_len(points)
        if oren_is_err(n) || n < 2 || n > 128 { return oren_err(4, ctx + ": path points must contain 2..128 [x,y] entries") }
        var width = _line_width(path, "path", ctx)
        if oren_is_err(width) { return width }
        var z = _flat_z(path, "path", ctx)
        if oren_is_err(z) { return z }
        var j = 0
        while j < n {
            var rc = _xy_pair(points[j], "path point", ctx)
            if oren_is_err(rc) { return rc }
            if j > 0 && points[j - 1][0] == points[j][0] && points[j - 1][1] == points[j][1] {
                return oren_err(4, ctx + ": path segment must be nonzero")
            }
            j = j + 1
        }
        total = total + (n - 1) * 2
        i = i + 1
    }
    if total > 4096 { return oren_err(4, ctx + ": paths exceed mesh3d triangle budget") }
    return total
}

fn pack_paths_xy(paths, ctx) {
    var tri_count = _paths_xy_triangle_count(paths, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var pi = 0
    var np = oren_list_len(paths)
    while pi < np {
        var path = paths[pi]
        var points = _path_points(path)
        var width = _line_width(path, "path", ctx)
        var z = _flat_z(path, "path", ctx)
        var i = 1
        while i < oren_list_len(points) {
            var p0 = points[i - 1]
            var p1 = points[i]
            var rc = _store_line_segment(out, off, p0[0], p0[1], p1[0], p1[1], z, width, ctx + ".path")
            if oren_is_err(rc) { return rc }
            off = off + 72
            i = i + 1
        }
        pi = pi + 1
    }
    return out
}

fn _angle_milli(shape, primary, fallback, label, ctx) {
    var angle = shape[primary]
    if angle == nil { angle = shape[fallback] }
    if _is_int(angle) == false {
        return oren_err(4, ctx + ": " + label + " angle must be i32 milli-degrees")
    }
    return angle
}

fn _angle_coord(center, radius, angle_milli_deg, axis) {
    var angle = math.tau() * f64(angle_milli_deg) / 360000.0
    var unit = math.cos(angle)
    if axis == 1 { unit = math.sin(angle) }
    var rounded = math.round(f64(center) + f64(radius) * unit)
    if oren_is_err(rounded) { return rounded }
    return ints.i32(rounded)
}

fn _angle_span(shape, ctx) {
    var start = _angle_milli(shape, "start_angle_milli_deg", "start_milli_deg", "start", ctx)
    if oren_is_err(start) { return start }
    var end = _angle_milli(shape, "end_angle_milli_deg", "end_milli_deg", "end", ctx)
    if oren_is_err(end) { return end }
    if end <= start { return oren_err(4, ctx + ": end angle must be greater than start angle") }
    if end - start > 360000 { return oren_err(4, ctx + ": angle span must be <= 360000 milli-degrees") }
    return [start, end]
}

fn _sector_triangle_count(sectors, ctx) {
    if sectors == nil { return oren_err(4, ctx + ": missing sectors_xy") }
    var ns = oren_list_len(sectors)
    if oren_is_err(ns) { return oren_err(4, ctx + ": sectors_xy must be list") }
    var total = 0
    var i = 0
    while i < ns {
        var sector = sectors[i]
        if sector == nil { return oren_err(4, ctx + ": sector must be object") }
        var center = _center_xy(sector, "sector", ctx)
        if oren_is_err(center) { return center }
        var radius = _radius(sector, "sector", ctx)
        if oren_is_err(radius) { return radius }
        var span = _angle_span(sector, ctx)
        if oren_is_err(span) { return span }
        var z = _flat_z(sector, "sector", ctx)
        if oren_is_err(z) { return z }
        var segments = _segments(sector, "sector", 1, ctx)
        if oren_is_err(segments) { return segments }
        total = total + segments
        i = i + 1
    }
    if total > 2048 { return oren_err(4, ctx + ": sectors exceed mesh3d triangle budget") }
    return total
}

fn pack_sectors_xy(sectors, ctx) {
    var tri_count = _sector_triangle_count(sectors, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var si = 0
    var ns = oren_list_len(sectors)
    while si < ns {
        var sector = sectors[si]
        var center = _center_xy(sector, "sector", ctx)
        var radius = _radius(sector, "sector", ctx)
        var span = _angle_span(sector, ctx)
        var z = _flat_z(sector, "sector", ctx)
        var segments = _segments(sector, "sector", 1, ctx)
        var seg = 0
        while seg < segments {
            var a0 = span[0] + (span[1] - span[0]) * seg / segments
            var a1 = span[0] + (span[1] - span[0]) * (seg + 1) / segments
            var x0 = _angle_coord(center[0], radius, a0, 0)
            var y0 = _angle_coord(center[1], radius, a0, 1)
            var x1 = _angle_coord(center[0], radius, a1, 0)
            var y1 = _angle_coord(center[1], radius, a1, 1)
            var rc = _store_triangle(out, off, center[0], center[1], z, x0, y0, z, x1, y1, z, ctx + ".sector")
            if oren_is_err(rc) { return rc }
            off = off + 36
            seg = seg + 1
        }
        si = si + 1
    }
    return out
}

fn _arc_band_triangle_count(arcs, ctx) {
    if arcs == nil { return oren_err(4, ctx + ": missing arc_bands_xy") }
    var na = oren_list_len(arcs)
    if oren_is_err(na) { return oren_err(4, ctx + ": arc_bands_xy must be list") }
    var total = 0
    var i = 0
    while i < na {
        var arc = arcs[i]
        if arc == nil { return oren_err(4, ctx + ": arc band must be object") }
        var center = _center_xy(arc, "arc band", ctx)
        if oren_is_err(center) { return center }
        var inner = _ring_radius(arc, "inner_radius", "radius_inner", "inner", ctx)
        if oren_is_err(inner) { return inner }
        var outer = _ring_radius(arc, "outer_radius", "radius_outer", "outer", ctx)
        if oren_is_err(outer) { return outer }
        if outer <= inner { return oren_err(4, ctx + ": arc band outer radius must be greater than inner radius") }
        var span = _angle_span(arc, ctx)
        if oren_is_err(span) { return span }
        var z = _flat_z(arc, "arc band", ctx)
        if oren_is_err(z) { return z }
        var segments = _segments(arc, "arc band", 1, ctx)
        if oren_is_err(segments) { return segments }
        total = total + segments * 2
        i = i + 1
    }
    if total > 4096 { return oren_err(4, ctx + ": arc bands exceed mesh3d triangle budget") }
    return total
}

fn pack_arc_bands_xy(arcs, ctx) {
    var tri_count = _arc_band_triangle_count(arcs, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ai = 0
    var na = oren_list_len(arcs)
    while ai < na {
        var arc = arcs[ai]
        var center = _center_xy(arc, "arc band", ctx)
        var inner = _ring_radius(arc, "inner_radius", "radius_inner", "inner", ctx)
        var outer = _ring_radius(arc, "outer_radius", "radius_outer", "outer", ctx)
        var span = _angle_span(arc, ctx)
        var z = _flat_z(arc, "arc band", ctx)
        var segments = _segments(arc, "arc band", 1, ctx)
        var seg = 0
        while seg < segments {
            var a0 = span[0] + (span[1] - span[0]) * seg / segments
            var a1 = span[0] + (span[1] - span[0]) * (seg + 1) / segments
            var ox0 = _angle_coord(center[0], outer, a0, 0)
            var oy0 = _angle_coord(center[1], outer, a0, 1)
            var ox1 = _angle_coord(center[0], outer, a1, 0)
            var oy1 = _angle_coord(center[1], outer, a1, 1)
            var ix0 = _angle_coord(center[0], inner, a0, 0)
            var iy0 = _angle_coord(center[1], inner, a0, 1)
            var ix1 = _angle_coord(center[0], inner, a1, 0)
            var iy1 = _angle_coord(center[1], inner, a1, 1)
            var rc = _store_triangle(out, off, ox0, oy0, z, ox1, oy1, z, ix1, iy1, z, ctx + ".arc0")
            if oren_is_err(rc) { return rc }
            off = off + 36
            rc = _store_triangle(out, off, ox0, oy0, z, ix1, iy1, z, ix0, iy0, z, ctx + ".arc1")
            if oren_is_err(rc) { return rc }
            off = off + 36
            seg = seg + 1
        }
        ai = ai + 1
    }
    return out
}

fn _rounded_rect_segments(rect, ctx) {
    var segments = rect["corner_segments"]
    if segments == nil { segments = rect["segments"] }
    if segments == nil { segments = 4 }
    if _is_int(segments) == false || segments < 1 || segments > 24 {
        return oren_err(4, ctx + ": rounded rect corner_segments must be 1..24")
    }
    return segments
}

fn _rounded_rect_radius(rect, bounds, ctx) {
    var radius = rect["radius"]
    if radius == nil { radius = rect["corner_radius"] }
    if radius == nil { radius = rect["radius_xy"] }
    if _is_int(radius) == false || radius <= 0 {
        return oren_err(4, ctx + ": rounded rect radius must be positive i32")
    }
    var max_radius = (bounds[2] - bounds[0]) / 2
    var y_radius = (bounds[3] - bounds[1]) / 2
    if y_radius < max_radius { max_radius = y_radius }
    if radius > max_radius { return oren_err(4, ctx + ": rounded rect radius exceeds half extent") }
    return radius
}

fn _rounded_rect_vertex(bounds, radius, corner_segments, index, axis) {
    var points_per_corner = corner_segments + 1
    var corner = index / points_per_corner
    var step = index - corner * points_per_corner
    var cx = bounds[2] - radius
    var cy = bounds[3] - radius
    var start = 0
    if corner == 1 {
        cx = bounds[0] + radius
        cy = bounds[3] - radius
        start = 90000
    } else if corner == 2 {
        cx = bounds[0] + radius
        cy = bounds[1] + radius
        start = 180000
    } else if corner == 3 {
        cx = bounds[2] - radius
        cy = bounds[1] + radius
        start = 270000
    }
    var angle = start + 90000 * step / corner_segments
    return _angle_coord(cx, radius, angle, axis)
}

fn _rounded_rects_triangle_count(rects, ctx) {
    if rects == nil { return oren_err(4, ctx + ": missing rounded_rects_xy") }
    var nr = oren_list_len(rects)
    if oren_is_err(nr) { return oren_err(4, ctx + ": rounded_rects_xy must be list") }
    var total = 0
    var i = 0
    while i < nr {
        var rect = rects[i]
        if rect == nil { return oren_err(4, ctx + ": rounded rect must be object") }
        var bounds = _plane_xy_bounds(rect, ctx)
        if oren_is_err(bounds) { return bounds }
        var radius = _rounded_rect_radius(rect, bounds, ctx)
        if oren_is_err(radius) { return radius }
        var segments = _rounded_rect_segments(rect, ctx)
        if oren_is_err(segments) { return segments }
        total = total + (segments + 1) * 4
        i = i + 1
    }
    if total > 4096 { return oren_err(4, ctx + ": rounded rects exceed mesh3d triangle budget") }
    return total
}

fn pack_rounded_rects_xy(rects, ctx) {
    var tri_count = _rounded_rects_triangle_count(rects, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ri = 0
    var nr = oren_list_len(rects)
    while ri < nr {
        var rect = rects[ri]
        var bounds = _plane_xy_bounds(rect, ctx)
        var radius = _rounded_rect_radius(rect, bounds, ctx)
        var segments = _rounded_rect_segments(rect, ctx)
        var z = bounds[4]
        var cx = (bounds[0] + bounds[2]) / 2
        var cy = (bounds[1] + bounds[3]) / 2
        var points = (segments + 1) * 4
        var i = 0
        while i < points {
            var next_i = i + 1
            if next_i == points { next_i = 0 }
            var x0 = _rounded_rect_vertex(bounds, radius, segments, i, 0)
            var y0 = _rounded_rect_vertex(bounds, radius, segments, i, 1)
            var x1 = _rounded_rect_vertex(bounds, radius, segments, next_i, 0)
            var y1 = _rounded_rect_vertex(bounds, radius, segments, next_i, 1)
            var rc = _store_triangle(out, off, cx, cy, z, x0, y0, z, x1, y1, z, ctx + ".rounded_rect")
            if oren_is_err(rc) { return rc }
            off = off + 36
            i = i + 1
        }
        ri = ri + 1
    }
    return out
}

fn _cylinders_triangle_count(cylinders, ctx) {
    if cylinders == nil { return oren_err(4, ctx + ": missing cylinders_z") }
    var nc = oren_list_len(cylinders)
    if oren_is_err(nc) { return oren_err(4, ctx + ": cylinders_z must be list") }
    var total = 0
    var i = 0
    while i < nc {
        var cyl = cylinders[i]
        if cyl == nil { return oren_err(4, ctx + ": cylinder must be object") }
        var center = _center_xy(cyl, "cylinder", ctx)
        if oren_is_err(center) { return center }
        var radius = _radius(cyl, "cylinder", ctx)
        if oren_is_err(radius) { return radius }
        var z0 = _z(cyl, "z_min", "min_z", ctx + ".z_min")
        if oren_is_err(z0) { return z0 }
        var z1 = _z(cyl, "z_max", "max_z", ctx + ".z_max")
        if oren_is_err(z1) { return z1 }
        if z1 <= z0 { return oren_err(4, ctx + ": cylinder z_max must be greater than z_min") }
        var segments = _segments(cyl, "cylinder", 3, ctx)
        if oren_is_err(segments) { return segments }
        total = total + segments * 4
        i = i + 1
    }
    return total
}

fn pack_cylinders_z(cylinders, ctx) {
    var tri_count = _cylinders_triangle_count(cylinders, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ci = 0
    var nc = oren_list_len(cylinders)
    while ci < nc {
        var cyl = cylinders[ci]
        var center = _center_xy(cyl, "cylinder", ctx)
        var radius = _radius(cyl, "cylinder", ctx)
        var z0 = _z(cyl, "z_min", "min_z", ctx + ".z_min")
        var z1 = _z(cyl, "z_max", "max_z", ctx + ".z_max")
        var segments = _segments(cyl, "cylinder", 3, ctx)
        var cx = center[0]
        var cy = center[1]
        var i = 0
        while i < segments {
            var next = i + 1
            if next == segments { next = 0 }
            var ax = _circle_coord(cx, radius, segments, i, 0)
            if oren_is_err(ax) { return ax }
            var ay = _circle_coord(cy, radius, segments, i, 1)
            if oren_is_err(ay) { return ay }
            var bx = _circle_coord(cx, radius, segments, next, 0)
            if oren_is_err(bx) { return bx }
            var by = _circle_coord(cy, radius, segments, next, 1)
            if oren_is_err(by) { return by }
            var rc = _store_triangle(out, off, cx, cy, z0, bx, by, z0, ax, ay, z0, ctx + ".bottom")
            if oren_is_err(rc) { return rc }
            off = off + 36
            rc = _store_triangle(out, off, cx, cy, z1, ax, ay, z1, bx, by, z1, ctx + ".top")
            if oren_is_err(rc) { return rc }
            off = off + 36
            rc = _store_triangle(out, off, ax, ay, z0, bx, by, z0, bx, by, z1, ctx + ".side0")
            if oren_is_err(rc) { return rc }
            off = off + 36
            rc = _store_triangle(out, off, ax, ay, z0, bx, by, z1, ax, ay, z1, ctx + ".side1")
            if oren_is_err(rc) { return rc }
            off = off + 36
            i = i + 1
        }
        ci = ci + 1
    }
    return out
}

fn _cones_triangle_count(cones, ctx) {
    if cones == nil { return oren_err(4, ctx + ": missing cones_z") }
    var nc = oren_list_len(cones)
    if oren_is_err(nc) { return oren_err(4, ctx + ": cones_z must be list") }
    var total = 0
    var i = 0
    while i < nc {
        var cone = cones[i]
        if cone == nil { return oren_err(4, ctx + ": cone must be object") }
        var center = _center_xy(cone, "cone", ctx)
        if oren_is_err(center) { return center }
        var radius = _radius(cone, "cone", ctx)
        if oren_is_err(radius) { return radius }
        var z0 = _z(cone, "z_min", "min_z", ctx + ".z_min")
        if oren_is_err(z0) { return z0 }
        var z1 = _z(cone, "z_max", "max_z", ctx + ".z_max")
        if oren_is_err(z1) { return z1 }
        if z1 <= z0 { return oren_err(4, ctx + ": cone z_max must be greater than z_min") }
        var segments = _segments(cone, "cone", 3, ctx)
        if oren_is_err(segments) { return segments }
        total = total + segments * 2
        i = i + 1
    }
    return total
}

fn pack_cones_z(cones, ctx) {
    var tri_count = _cones_triangle_count(cones, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ci = 0
    var nc = oren_list_len(cones)
    while ci < nc {
        var cone = cones[ci]
        var center = _center_xy(cone, "cone", ctx)
        var radius = _radius(cone, "cone", ctx)
        var z0 = _z(cone, "z_min", "min_z", ctx + ".z_min")
        var z1 = _z(cone, "z_max", "max_z", ctx + ".z_max")
        var segments = _segments(cone, "cone", 3, ctx)
        var cx = center[0]
        var cy = center[1]
        var i = 0
        while i < segments {
            var next = i + 1
            if next == segments { next = 0 }
            var ax = _circle_coord(cx, radius, segments, i, 0)
            if oren_is_err(ax) { return ax }
            var ay = _circle_coord(cy, radius, segments, i, 1)
            if oren_is_err(ay) { return ay }
            var bx = _circle_coord(cx, radius, segments, next, 0)
            if oren_is_err(bx) { return bx }
            var by = _circle_coord(cy, radius, segments, next, 1)
            if oren_is_err(by) { return by }
            var rc = _store_triangle(out, off, cx, cy, z0, bx, by, z0, ax, ay, z0, ctx + ".base")
            if oren_is_err(rc) { return rc }
            off = off + 36
            rc = _store_triangle(out, off, ax, ay, z0, bx, by, z0, cx, cy, z1, ctx + ".side")
            if oren_is_err(rc) { return rc }
            off = off + 36
            i = i + 1
        }
        ci = ci + 1
    }
    return out
}

fn _sphere_center(sphere, ctx) {
    var center = sphere["center"]
    if center == nil { center = sphere["center_xyz"] }
    if center == nil || oren_list_len(center) != 3 {
        return oren_err(4, ctx + ": sphere center must be [x,y,z]")
    }
    if _is_int(center[0]) == false || _is_int(center[1]) == false || _is_int(center[2]) == false {
        return oren_err(4, ctx + ": sphere center must contain i32")
    }
    return center
}

fn _sphere_radius(sphere, ctx) {
    var radius = sphere["radius"]
    if _is_int(radius) == false || radius <= 0 {
        return oren_err(4, ctx + ": sphere radius must be positive i32")
    }
    return radius
}

fn _ellipsoid_radii(ellipsoid, ctx) {
    var radii = ellipsoid["radii"]
    if radii == nil { radii = ellipsoid["radii_xyz"] }
    if radii != nil {
        if oren_list_len(radii) != 3 {
            return oren_err(4, ctx + ": ellipsoid radii must be [rx,ry,rz]")
        }
        if _is_int(radii[0]) == false || _is_int(radii[1]) == false || _is_int(radii[2]) == false {
            return oren_err(4, ctx + ": ellipsoid radii must contain i32")
        }
        if radii[0] <= 0 || radii[1] <= 0 || radii[2] <= 0 {
            return oren_err(4, ctx + ": ellipsoid radii must be positive")
        }
        return radii
    }
    var rx = ellipsoid["radius_x"]
    var ry = ellipsoid["radius_y"]
    var rz = ellipsoid["radius_z"]
    if _is_int(rx) == false || _is_int(ry) == false || _is_int(rz) == false {
        return oren_err(4, ctx + ": ellipsoid needs radii or radius_x/y/z")
    }
    if rx <= 0 || ry <= 0 || rz <= 0 {
        return oren_err(4, ctx + ": ellipsoid radii must be positive")
    }
    return [rx, ry, rz]
}

fn _sphere_segments(sphere, ctx) {
    return _segments(sphere, "sphere", 4, ctx)
}

fn _sphere_rings(sphere, ctx) {
    var rings = sphere["rings"]
    if rings == nil { rings = 8 }
    if _is_int(rings) == false || rings < 2 || rings > 48 {
        return oren_err(4, ctx + ": sphere rings must be 2..48")
    }
    return rings
}

fn _capsule_rings(capsule, ctx) {
    var rings = capsule["rings"]
    if rings == nil { rings = 4 }
    if _is_int(rings) == false || rings < 1 || rings > 48 {
        return oren_err(4, ctx + ": capsule rings must be 1..48")
    }
    return rings
}

fn _spheres_triangle_count(spheres, ctx) {
    if spheres == nil { return oren_err(4, ctx + ": missing spheres_xyz") }
    var ns = oren_list_len(spheres)
    if oren_is_err(ns) { return oren_err(4, ctx + ": spheres_xyz must be list") }
    var total = 0
    var i = 0
    while i < ns {
        var sphere = spheres[i]
        if sphere == nil { return oren_err(4, ctx + ": sphere must be object") }
        var center = _sphere_center(sphere, ctx)
        if oren_is_err(center) { return center }
        var radius = _sphere_radius(sphere, ctx)
        if oren_is_err(radius) { return radius }
        var segments = _sphere_segments(sphere, ctx)
        if oren_is_err(segments) { return segments }
        var rings = _sphere_rings(sphere, ctx)
        if oren_is_err(rings) { return rings }
        total = total + segments * rings * 2
        i = i + 1
    }
    return total
}

fn _spherical_point_axis(center, radius, segments, rings, seg, ring, axis) {
    var theta = math.pi() * f64(ring) / f64(rings)
    var phi = math.tau() * f64(seg) / f64(segments)
    var x = math.sin(theta) * math.cos(phi)
    var y = math.sin(theta) * math.sin(phi)
    var z = math.cos(theta)
    var unit = x
    if axis == 1 { unit = y }
    if axis == 2 { unit = z }
    var rounded = math.round(f64(center) + f64(radius) * unit)
    if oren_is_err(rounded) { return rounded }
    return ints.i32(rounded)
}

fn _store_sphere_point(out, off, center, radius, segments, rings, seg, ring, ctx) {
    var x = _spherical_point_axis(center[0], radius, segments, rings, seg, ring, 0)
    if oren_is_err(x) { return x }
    var y = _spherical_point_axis(center[1], radius, segments, rings, seg, ring, 1)
    if oren_is_err(y) { return y }
    var z = _spherical_point_axis(center[2], radius, segments, rings, seg, ring, 2)
    if oren_is_err(z) { return z }
    return _store_xyz_values(out, off, x, y, z, ctx)
}

fn _store_sphere_triangle(out, off, center, radius, segments, rings, a_seg, a_ring, b_seg, b_ring, c_seg, c_ring, ctx) {
    var rc = _store_sphere_point(out, off + 0, center, radius, segments, rings, a_seg, a_ring, ctx + ".a")
    if oren_is_err(rc) { return rc }
    rc = _store_sphere_point(out, off + 12, center, radius, segments, rings, b_seg, b_ring, ctx + ".b")
    if oren_is_err(rc) { return rc }
    return _store_sphere_point(out, off + 24, center, radius, segments, rings, c_seg, c_ring, ctx + ".c")
}

fn pack_spheres_xyz(spheres, ctx) {
    var tri_count = _spheres_triangle_count(spheres, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var si = 0
    var ns = oren_list_len(spheres)
    while si < ns {
        var sphere = spheres[si]
        var center = _sphere_center(sphere, ctx)
        var radius = _sphere_radius(sphere, ctx)
        var segments = _sphere_segments(sphere, ctx)
        var rings = _sphere_rings(sphere, ctx)
        var ring = 0
        while ring < rings {
            var next_ring = ring + 1
            var seg = 0
            while seg < segments {
                var next_seg = seg + 1
                if next_seg == segments { next_seg = 0 }
                var rc = _store_sphere_triangle(out, off, center, radius, segments, rings, seg, ring, next_seg, next_ring, next_seg, ring, ctx + ".band0")
                if oren_is_err(rc) { return rc }
                off = off + 36
                rc = _store_sphere_triangle(out, off, center, radius, segments, rings, seg, ring, seg, next_ring, next_seg, next_ring, ctx + ".band1")
                if oren_is_err(rc) { return rc }
                off = off + 36
                seg = seg + 1
            }
            ring = ring + 1
        }
        si = si + 1
    }
    return out
}

fn _ellipsoids_triangle_count(ellipsoids, ctx) {
    if ellipsoids == nil { return oren_err(4, ctx + ": missing ellipsoids_xyz") }
    var ne = oren_list_len(ellipsoids)
    if oren_is_err(ne) { return oren_err(4, ctx + ": ellipsoids_xyz must be list") }
    var total = 0
    var i = 0
    while i < ne {
        var ellipsoid = ellipsoids[i]
        if ellipsoid == nil { return oren_err(4, ctx + ": ellipsoid must be object") }
        var center = _sphere_center(ellipsoid, ctx)
        if oren_is_err(center) { return center }
        var radii = _ellipsoid_radii(ellipsoid, ctx)
        if oren_is_err(radii) { return radii }
        var segments = _sphere_segments(ellipsoid, ctx)
        if oren_is_err(segments) { return segments }
        var rings = _sphere_rings(ellipsoid, ctx)
        if oren_is_err(rings) { return rings }
        total = total + segments * rings * 2
        i = i + 1
    }
    return total
}

fn _store_ellipsoid_point(out, off, center, radii, segments, rings, seg, ring, ctx) {
    var x = _spherical_point_axis(center[0], radii[0], segments, rings, seg, ring, 0)
    if oren_is_err(x) { return x }
    var y = _spherical_point_axis(center[1], radii[1], segments, rings, seg, ring, 1)
    if oren_is_err(y) { return y }
    var z = _spherical_point_axis(center[2], radii[2], segments, rings, seg, ring, 2)
    if oren_is_err(z) { return z }
    return _store_xyz_values(out, off, x, y, z, ctx)
}

fn _store_ellipsoid_triangle(out, off, center, radii, segments, rings, a_seg, a_ring, b_seg, b_ring, c_seg, c_ring, ctx) {
    var rc = _store_ellipsoid_point(out, off + 0, center, radii, segments, rings, a_seg, a_ring, ctx + ".a")
    if oren_is_err(rc) { return rc }
    rc = _store_ellipsoid_point(out, off + 12, center, radii, segments, rings, b_seg, b_ring, ctx + ".b")
    if oren_is_err(rc) { return rc }
    return _store_ellipsoid_point(out, off + 24, center, radii, segments, rings, c_seg, c_ring, ctx + ".c")
}

fn pack_ellipsoids_xyz(ellipsoids, ctx) {
    var tri_count = _ellipsoids_triangle_count(ellipsoids, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ei = 0
    var ne = oren_list_len(ellipsoids)
    while ei < ne {
        var ellipsoid = ellipsoids[ei]
        var center = _sphere_center(ellipsoid, ctx)
        var radii = _ellipsoid_radii(ellipsoid, ctx)
        var segments = _sphere_segments(ellipsoid, ctx)
        var rings = _sphere_rings(ellipsoid, ctx)
        var ring = 0
        while ring < rings {
            var next_ring = ring + 1
            var seg = 0
            while seg < segments {
                var next_seg = seg + 1
                if next_seg == segments { next_seg = 0 }
                var rc = _store_ellipsoid_triangle(out, off, center, radii, segments, rings, seg, ring, next_seg, next_ring, next_seg, ring, ctx + ".band0")
                if oren_is_err(rc) { return rc }
                off = off + 36
                rc = _store_ellipsoid_triangle(out, off, center, radii, segments, rings, seg, ring, seg, next_ring, next_seg, next_ring, ctx + ".band1")
                if oren_is_err(rc) { return rc }
                off = off + 36
                seg = seg + 1
            }
            ring = ring + 1
        }
        ei = ei + 1
    }
    return out
}

fn _torus_radius(torus, primary, fallback, label, ctx) {
    var radius = torus[primary]
    if radius == nil { radius = torus[fallback] }
    if _is_int(radius) == false || radius <= 0 {
        return oren_err(4, ctx + ": torus " + label + " must be positive i32")
    }
    return radius
}

fn _torus_segments(torus, primary, fallback, default_value, min_segments, max_segments, label, ctx) {
    var segments = torus[primary]
    if segments == nil { segments = torus[fallback] }
    if segments == nil { segments = default_value }
    if _is_int(segments) == false || segments < min_segments || segments > max_segments {
        return oren_err(4, ctx + ": torus " + label + " must be " + oren_int_to_string(min_segments) + ".." + oren_int_to_string(max_segments))
    }
    return segments
}

fn _toruses_triangle_count(toruses, ctx) {
    if toruses == nil { return oren_err(4, ctx + ": missing toruses_xyz") }
    var nt = oren_list_len(toruses)
    if oren_is_err(nt) { return oren_err(4, ctx + ": toruses_xyz must be list") }
    var total = 0
    var i = 0
    while i < nt {
        var torus = toruses[i]
        if torus == nil { return oren_err(4, ctx + ": torus must be object") }
        var center = _sphere_center(torus, ctx)
        if oren_is_err(center) { return center }
        var major_radius = _torus_radius(torus, "major_radius", "radius", "major_radius", ctx)
        if oren_is_err(major_radius) { return major_radius }
        var minor_radius = _torus_radius(torus, "minor_radius", "tube_radius", "minor_radius", ctx)
        if oren_is_err(minor_radius) { return minor_radius }
        if minor_radius >= major_radius {
            return oren_err(4, ctx + ": torus minor_radius must be smaller than major_radius")
        }
        var segments = _torus_segments(torus, "major_segments", "segments", 16, 4, 96, "major_segments", ctx)
        if oren_is_err(segments) { return segments }
        var tube_segments = _torus_segments(torus, "minor_segments", "tube_segments", 8, 3, 48, "minor_segments", ctx)
        if oren_is_err(tube_segments) { return tube_segments }
        total = total + segments * tube_segments * 2
        i = i + 1
    }
    return total
}

fn _torus_point_axis(center, major_radius, minor_radius, segments, tube_segments, seg, tube, axis) {
    var theta = math.tau() * f64(seg) / f64(segments)
    var phi = math.tau() * f64(tube) / f64(tube_segments)
    var ring_radius = f64(major_radius) + f64(minor_radius) * math.cos(phi)
    var unit = ring_radius * math.cos(theta)
    if axis == 1 { unit = ring_radius * math.sin(theta) }
    if axis == 2 { unit = f64(minor_radius) * math.sin(phi) }
    var rounded = math.round(f64(center) + unit)
    if oren_is_err(rounded) { return rounded }
    return ints.i32(rounded)
}

fn _store_torus_point(out, off, center, major_radius, minor_radius, segments, tube_segments, seg, tube, ctx) {
    var x = _torus_point_axis(center[0], major_radius, minor_radius, segments, tube_segments, seg, tube, 0)
    if oren_is_err(x) { return x }
    var y = _torus_point_axis(center[1], major_radius, minor_radius, segments, tube_segments, seg, tube, 1)
    if oren_is_err(y) { return y }
    var z = _torus_point_axis(center[2], major_radius, minor_radius, segments, tube_segments, seg, tube, 2)
    if oren_is_err(z) { return z }
    return _store_xyz_values(out, off, x, y, z, ctx)
}

fn _store_torus_triangle(out, off, center, major_radius, minor_radius, segments, tube_segments, a_seg, a_tube, b_seg, b_tube, c_seg, c_tube, ctx) {
    var rc = _store_torus_point(out, off + 0, center, major_radius, minor_radius, segments, tube_segments, a_seg, a_tube, ctx + ".a")
    if oren_is_err(rc) { return rc }
    rc = _store_torus_point(out, off + 12, center, major_radius, minor_radius, segments, tube_segments, b_seg, b_tube, ctx + ".b")
    if oren_is_err(rc) { return rc }
    return _store_torus_point(out, off + 24, center, major_radius, minor_radius, segments, tube_segments, c_seg, c_tube, ctx + ".c")
}

fn pack_toruses_xyz(toruses, ctx) {
    var tri_count = _toruses_triangle_count(toruses, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ti = 0
    var nt = oren_list_len(toruses)
    while ti < nt {
        var torus = toruses[ti]
        var center = _sphere_center(torus, ctx)
        var major_radius = _torus_radius(torus, "major_radius", "radius", "major_radius", ctx)
        var minor_radius = _torus_radius(torus, "minor_radius", "tube_radius", "minor_radius", ctx)
        var segments = _torus_segments(torus, "major_segments", "segments", 16, 4, 96, "major_segments", ctx)
        var tube_segments = _torus_segments(torus, "minor_segments", "tube_segments", 8, 3, 48, "minor_segments", ctx)
        var seg = 0
        while seg < segments {
            var next_seg = seg + 1
            if next_seg == segments { next_seg = 0 }
            var tube = 0
            while tube < tube_segments {
                var next_tube = tube + 1
                if next_tube == tube_segments { next_tube = 0 }
                var rc = _store_torus_triangle(out, off, center, major_radius, minor_radius, segments, tube_segments, seg, tube, next_seg, next_tube, next_seg, tube, ctx + ".band0")
                if oren_is_err(rc) { return rc }
                off = off + 36
                rc = _store_torus_triangle(out, off, center, major_radius, minor_radius, segments, tube_segments, seg, tube, seg, next_tube, next_seg, next_tube, ctx + ".band1")
                if oren_is_err(rc) { return rc }
                off = off + 36
                tube = tube + 1
            }
            seg = seg + 1
        }
        ti = ti + 1
    }
    return out
}

fn _capsules_triangle_count(capsules, ctx) {
    if capsules == nil { return oren_err(4, ctx + ": missing capsules_z") }
    var nc = oren_list_len(capsules)
    if oren_is_err(nc) { return oren_err(4, ctx + ": capsules_z must be list") }
    var total = 0
    var i = 0
    while i < nc {
        var capsule = capsules[i]
        if capsule == nil { return oren_err(4, ctx + ": capsule must be object") }
        var center = _center_xy(capsule, "capsule", ctx)
        if oren_is_err(center) { return center }
        var radius = _radius(capsule, "capsule", ctx)
        if oren_is_err(radius) { return radius }
        var z0 = _z(capsule, "z_min", "min_z", ctx + ".z_min")
        if oren_is_err(z0) { return z0 }
        var z1 = _z(capsule, "z_max", "max_z", ctx + ".z_max")
        if oren_is_err(z1) { return z1 }
        if z1 <= z0 { return oren_err(4, ctx + ": capsule z_max must be greater than z_min") }
        var segments = _segments(capsule, "capsule", 4, ctx)
        if oren_is_err(segments) { return segments }
        var rings = _capsule_rings(capsule, ctx)
        if oren_is_err(rings) { return rings }
        total = total + segments * (2 + rings * 4)
        i = i + 1
    }
    return total
}

fn _capsule_cap_axis(center, radius, z_center, segments, rings, seg, ring, top, axis) {
    var theta = (math.pi() * 0.5) * f64(ring) / f64(rings)
    var phi = math.tau() * f64(seg) / f64(segments)
    var radial = f64(radius) * math.sin(theta)
    var unit = radial * math.cos(phi)
    if axis == 1 { unit = radial * math.sin(phi) }
    if axis == 2 {
        unit = f64(z_center) + f64(radius) * math.cos(theta)
        if top == false { unit = f64(z_center) - f64(radius) * math.cos(theta) }
        var z_rounded = math.round(unit)
        if oren_is_err(z_rounded) { return z_rounded }
        return ints.i32(z_rounded)
    }
    var rounded = math.round(f64(center) + unit)
    if oren_is_err(rounded) { return rounded }
    return ints.i32(rounded)
}

fn _store_capsule_cap_point(out, off, cx, cy, radius, z_center, segments, rings, seg, ring, top, ctx) {
    var x = _capsule_cap_axis(cx, radius, z_center, segments, rings, seg, ring, top, 0)
    if oren_is_err(x) { return x }
    var y = _capsule_cap_axis(cy, radius, z_center, segments, rings, seg, ring, top, 1)
    if oren_is_err(y) { return y }
    var z = _capsule_cap_axis(0, radius, z_center, segments, rings, seg, ring, top, 2)
    if oren_is_err(z) { return z }
    return _store_xyz_values(out, off, x, y, z, ctx)
}

fn _store_capsule_cap_triangle(out, off, cx, cy, radius, z_center, segments, rings, a_seg, a_ring, b_seg, b_ring, c_seg, c_ring, top, ctx) {
    var rc = _store_capsule_cap_point(out, off + 0, cx, cy, radius, z_center, segments, rings, a_seg, a_ring, top, ctx + ".a")
    if oren_is_err(rc) { return rc }
    rc = _store_capsule_cap_point(out, off + 12, cx, cy, radius, z_center, segments, rings, b_seg, b_ring, top, ctx + ".b")
    if oren_is_err(rc) { return rc }
    return _store_capsule_cap_point(out, off + 24, cx, cy, radius, z_center, segments, rings, c_seg, c_ring, top, ctx + ".c")
}

fn pack_capsules_z(capsules, ctx) {
    var tri_count = _capsules_triangle_count(capsules, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ci = 0
    var nc = oren_list_len(capsules)
    while ci < nc {
        var capsule = capsules[ci]
        var center = _center_xy(capsule, "capsule", ctx)
        var radius = _radius(capsule, "capsule", ctx)
        var z0 = _z(capsule, "z_min", "min_z", ctx + ".z_min")
        var z1 = _z(capsule, "z_max", "max_z", ctx + ".z_max")
        var segments = _segments(capsule, "capsule", 4, ctx)
        var rings = _capsule_rings(capsule, ctx)
        var cx = center[0]
        var cy = center[1]
        var seg = 0
        while seg < segments {
            var next_seg = seg + 1
            if next_seg == segments { next_seg = 0 }
            var a0x = _circle_coord(cx, radius, segments, seg, 0)
            var a0y = _circle_coord(cy, radius, segments, seg, 1)
            var b0x = _circle_coord(cx, radius, segments, next_seg, 0)
            var b0y = _circle_coord(cy, radius, segments, next_seg, 1)
            var rc = _store_triangle(out, off, a0x, a0y, z0, b0x, b0y, z0, b0x, b0y, z1, ctx + ".side0")
            if oren_is_err(rc) { return rc }
            off = off + 36
            rc = _store_triangle(out, off, a0x, a0y, z0, b0x, b0y, z1, a0x, a0y, z1, ctx + ".side1")
            if oren_is_err(rc) { return rc }
            off = off + 36
            var ring = 0
            while ring < rings {
                var next_ring = ring + 1
                rc = _store_capsule_cap_triangle(out, off, cx, cy, radius, z1, segments, rings, seg, ring, next_seg, next_ring, next_seg, ring, true, ctx + ".top0")
                if oren_is_err(rc) { return rc }
                off = off + 36
                rc = _store_capsule_cap_triangle(out, off, cx, cy, radius, z1, segments, rings, seg, ring, seg, next_ring, next_seg, next_ring, true, ctx + ".top1")
                if oren_is_err(rc) { return rc }
                off = off + 36
                rc = _store_capsule_cap_triangle(out, off, cx, cy, radius, z0, segments, rings, seg, next_ring, next_seg, next_ring, next_seg, ring, false, ctx + ".bottom0")
                if oren_is_err(rc) { return rc }
                off = off + 36
                rc = _store_capsule_cap_triangle(out, off, cx, cy, radius, z0, segments, rings, seg, next_ring, next_seg, ring, seg, ring, false, ctx + ".bottom1")
                if oren_is_err(rc) { return rc }
                off = off + 36
                ring = ring + 1
            }
            seg = seg + 1
        }
        ci = ci + 1
    }
    return out
}
