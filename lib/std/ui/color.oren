// std:ui/color (rolling)
//
// Small, backend-neutral color helpers for `std:ui`.
//
// v0 supported formats:
// - "#RRGGBB"
// - "#RRGGBBAA"
//
// This module is intentionally tiny so it can be reused by:
// - command-buffer validators (`std:ui/commands`)
// - deterministic headless rasterizer (`std:ui/raster`)
// - future platform shims (Skia/CoreGraphics/D2D/etc)

import result "std:result"

fn _hex_digit_value(b) {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 65 && b <= 70 { return b - 55 }
    if b >= 97 && b <= 102 { return b - 87 }
    return -1
}

fn _hex_byte_at(s, off) {
    var hi = _hex_digit_value(oren_string_byte_at_unchecked(s, off))
    var lo = _hex_digit_value(oren_string_byte_at_unchecked(s, off + 1))
    if hi < 0 || lo < 0 { return -1 }
    return hi * 16 + lo
}

fn parse_hex(s) {
    // Returns either:
    // - {"r":u8,"g":u8,"b":u8,"a":u8}
    // - structured err(code=4, msg=...)
    if s == nil { return oren_err(4, "color is nil") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return oren_err(4, "color must be string") }
    if n != 7 && n != 9 { return oren_err(4, "color must be #RRGGBB or #RRGGBBAA") }
    if oren_string_byte_at_unchecked(s, 0) != 35 { return oren_err(4, "color must start with #") }

    var r = _hex_byte_at(s, 1)
    var g = _hex_byte_at(s, 3)
    var b = _hex_byte_at(s, 5)
    if r < 0 || g < 0 || b < 0 { return oren_err(4, "invalid hex digits") }
    var a = 255
    if n == 9 {
        a = _hex_byte_at(s, 7)
        if a < 0 { return oren_err(4, "invalid hex digits") }
    }
    return {"r": r, "g": g, "b": b, "a": a}
}

fn is_hex(s) {
    var r = parse_hex(s)
    return result.is_err(r) == false
}
