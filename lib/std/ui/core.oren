// std:ui/core (rolling)
//
// UI node representation is intentionally "boring data" (maps/lists/ints/strings)
// so it stays portable across Oren backends and can be serialized/diffed easily.
//
// Node shape (map):
//   {"t": <string tag>, "k": <string key>, "p": <map props>, "c": <list children>}
//
// Conventions (v0):
// - Keys `t`, `k`, `p`, `c` are reserved and stable.
// - `k` should be stable across updates; it is used for diffing.

fn node(tag, key, props, children) {
    if props == nil { props = {} }
    if children == nil { children = [] }
    return {"t": tag, "k": key, "p": props, "c": children}
}

fn tag(n) { return n["t"] }
fn key(n) { return n["k"] }
fn props(n) { return n["p"] }
fn children(n) { return n["c"] }

fn box(key, w, h) {
    return node("Box", key, {"w": w, "h": h}, [])
}

fn row(key, children) {
    return node("Row", key, {}, children)
}

fn column(key, children) {
    return node("Column", key, {}, children)
}

fn stack(key, children) {
    return node("Stack", key, {}, children)
}

fn text(key, s, w, h) {
    // v0: text measurement is not implemented yet; caller supplies w/h.
    return node("Text", key, {"text": s, "w": w, "h": h}, [])
}

fn _idx_by_key(cs) {
    // Return map: key(string) -> index(int)
    // If duplicate keys exist, the first wins.
    var m = {}
    if cs == nil { return m }
    var i = 0
    while i < oren_list_len(cs) {
        var n = cs[i]
        var k = n["k"]
        if k != nil && m[k] == nil {
            m[k] = i
        }
        i = i + 1
    }
    return m
}

fn diff(old_node, new_node) {
    // Minimal diff that produces an *actionable* patch for `apply_patch`.
    //
    // Path conventions:
    // - `path` is a list of *keys* from the root to a node.
    // - `[]` means "the root node".
    //
    // Patch op shape (list of maps):
    // - {"op":"replace","path":[...],"node":<node|nil>}         // replace node at `path`
    // - {"op":"set_props","path":[...],"props":<map|nil>}       // replace node["p"]
    // - {"op":"insert","path":[parent...],"idx":<int>,"node":<node>} // insert into parent children at idx
    // - {"op":"remove","path":[parent...],"key":<string>}       // remove child by key from parent
    //
    // Notes:
    // - For now we treat props as atomic and emit `set_props` when they differ.
    // - Children are diffed by key; unkeyed children force a subtree `replace`.
    if old_node == nil && new_node == nil { return [] }
    if old_node == nil { return [{"op": "replace", "path": [], "node": new_node}] }
    if new_node == nil { return [{"op": "replace", "path": [], "node": new_node}] }

    if old_node["t"] != new_node["t"] || old_node["k"] != new_node["k"] {
        return [{"op": "replace", "path": [], "node": new_node}]
    }

    var out = []

    // Props: treat as atomic for v0.
    var op0 = old_node["p"]
    var np0 = new_node["p"]
    if op0 != np0 {
        oren_list_push(out, {"op": "set_props", "path": [], "props": np0})
    }

    var old_c = old_node["c"]
    var new_c = new_node["c"]
    if old_c == nil { old_c = [] }
    if new_c == nil { new_c = [] }

    var old_idx = _idx_by_key(old_c)
    var new_idx = _idx_by_key(new_c)

    // Removals: any old key not present in new.
    var i = 0
    while i < oren_list_len(old_c) {
        var ok = old_c[i]["k"]
        if ok != nil && new_idx[ok] == nil {
            oren_list_push(out, {"op": "remove", "path": [], "key": ok})
        }
        i = i + 1
    }

    // Inserts + replaces (by key).
    var j = 0
    while j < oren_list_len(new_c) {
        var nn = new_c[j]
        var nk = nn["k"]
        if nk == nil {
            // If the child is unkeyed, treat as replace of the entire subtree.
            return [{"op": "replace", "path": [], "node": new_node}]
        }
        var oi = old_idx[nk]
        if oi == nil {
            oren_list_push(out, {"op": "insert", "path": [], "idx": j, "node": nn})
        } else {
            var sub = diff(old_c[oi], nn)
            // Prefix child key path.
            var k = 0
            while k < oren_list_len(sub) {
                var op = sub[k]
                var p = op["path"]
                if p == nil { p = [] }
                op["path"] = [nk] + p
                oren_list_push(out, op)
                k = k + 1
            }
        }
        j = j + 1
    }

    return out
}

fn _clone_map_shallow(m) {
    if m == nil { return nil }
    var out = {}
    for k in m {
        out[k] = m[k]
    }
    return out
}

fn clone_node(n) {
    // Clone UI node recursively.
    // Props map is cloned shallowly (values are reused).
    if n == nil { return nil }
    var tag = n["t"]
    var key = n["k"]
    var p = _clone_map_shallow(n["p"])
    var cs = n["c"]
    if cs == nil { cs = [] }
    var out_children = []
    var i = 0
    while i < oren_list_len(cs) {
        oren_list_push(out_children, clone_node(cs[i]))
        i = i + 1
    }
    return {"t": tag, "k": key, "p": p, "c": out_children}
}

fn _find_child_index_by_key(cs, k) {
    if cs == nil || k == nil { return nil }
    var i = 0
    while i < oren_list_len(cs) {
        var n = cs[i]
        if n != nil && n["k"] == k { return i }
        i = i + 1
    }
    return nil
}

fn _get_node_at_path(root, path) {
    if root == nil { return nil }
    if path == nil { return root }
    var cur = root
    var i = 0
    while i < oren_list_len(path) {
        var k = path[i]
        var cs = cur["c"]
        if cs == nil { return nil }
        var idx = _find_child_index_by_key(cs, k)
        if idx == nil { return nil }
        cur = cs[idx]
        i = i + 1
    }
    return cur
}

fn _list_insert_at(xs, idx, v) {
    if xs == nil { xs = [] }
    var n = oren_list_len(xs)
    // Guardrail: avoid `idx == nil` when `idx` is later treated as numeric.
    // Use a tag check so the code stays portable across Tier‑1 backends.
    if oren_type_tag(idx) == 0 { idx = n }
    if idx < 0 { idx = 0 }
    if idx > n { idx = n }
    var out = []
    var i = 0
    while i < n {
        if i == idx { oren_list_push(out, v) }
        oren_list_push(out, xs[i])
        i = i + 1
    }
    if idx == n { oren_list_push(out, v) }
    return out
}

fn _list_remove_key(xs, k) {
    if xs == nil { return [] }
    var out = []
    var i = 0
    while i < oren_list_len(xs) {
        var n = xs[i]
        if n == nil || n["k"] != k {
            oren_list_push(out, n)
        }
        i = i + 1
    }
    return out
}

fn _path_parent(path) {
    // Returns {"parent":<list prefix>, "leaf":<last>} for non-empty path; {"parent":[], "leaf":nil} for empty.
    if path == nil || oren_list_len(path) == 0 { return {"parent": [], "leaf": nil} }
    var n = oren_list_len(path)
    var out = []
    var i = 0
    while i < n - 1 {
        oren_list_push(out, path[i])
        i = i + 1
    }
    return {"parent": out, "leaf": path[n - 1]}
}

fn apply_patch(root, ops) {
    // Apply ops to `root` and return the updated tree.
    //
    // This is intentionally tolerant (rolling):
    // - missing paths are ignored (best-effort)
    // - replace at missing path becomes insert-at-end under the parent
    //
    // Note: this may mutate nodes reachable from `root`. Use `clone_node` first if you need persistence.
    if ops == nil { return root }
    var out_root = root
    var i = 0
    while i < oren_list_len(ops) {
        var opm = ops[i]
        if opm == nil { i = i + 1; continue }
        var op = opm["op"]
        var path = opm["path"]
        if path == nil { path = [] }

        if op == "replace" {
            if oren_list_len(path) == 0 {
                out_root = opm["node"]
            } else {
                var pp = _path_parent(path)
                var parent_path = pp["parent"]
                var leaf_key = pp["leaf"]
                var parent = _get_node_at_path(out_root, parent_path)
                if parent != nil {
                    var cs = parent["c"]
                    if cs == nil { cs = [] }
                    var idx = _find_child_index_by_key(cs, leaf_key)
                    if idx == nil {
                        // Insert at end.
                        parent["c"] = _list_insert_at(cs, oren_list_len(cs), opm["node"])
                    } else {
                        cs[idx] = opm["node"]
                        parent["c"] = cs
                    }
                }
            }
        } else if op == "set_props" {
            var n = _get_node_at_path(out_root, path)
            if n != nil {
                n["p"] = opm["props"]
            }
        } else if op == "insert" {
            var parent2 = _get_node_at_path(out_root, path)
            if parent2 != nil {
                var cs2 = parent2["c"]
                if cs2 == nil { cs2 = [] }
                // If a node with the same key already exists, treat as replace.
                var nk = opm["node"]
                var k2 = nil
                if nk != nil { k2 = nk["k"] }
                if k2 != nil {
                    var existing = _find_child_index_by_key(cs2, k2)
                    if existing != nil {
                        cs2[existing] = nk
                        parent2["c"] = cs2
                    } else {
                        parent2["c"] = _list_insert_at(cs2, opm["idx"], nk)
                    }
                } else {
                    parent2["c"] = _list_insert_at(cs2, opm["idx"], nk)
                }
            }
        } else if op == "remove" {
            var parent3 = _get_node_at_path(out_root, path)
            if parent3 != nil {
                var cs3 = parent3["c"]
                parent3["c"] = _list_remove_key(cs3, opm["key"])
            }
        }

        i = i + 1
    }
    return out_root
}
