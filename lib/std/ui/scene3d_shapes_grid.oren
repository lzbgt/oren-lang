// std:ui/scene3d_shapes_grid (rolling)
//
// Exact-size byte packers for grid-based Scene3D package primitives.
// Split from scene3d_shapes so procedural shape growth stays below the
// source-line guard without changing the OGF0 mesh byte ABI.

import raw "std:buffer/raw"

fn _is_int(v) {
    if v == nil { return false }
    return oren_type_tag(v) == 1
}

fn _store_u32_le(out, off, v) {
    raw._store_u8_buf_unchecked_direct(out, off + 0, v & 255)
    raw._store_u8_buf_unchecked_direct(out, off + 1, (v >> 8) & 255)
    raw._store_u8_buf_unchecked_direct(out, off + 2, (v >> 16) & 255)
    raw._store_u8_buf_unchecked_direct(out, off + 3, (v >> 24) & 255)
    return 0
}

fn _store_i32_le(out, off, v) {
    if _is_int(v) == false { return oren_err(4, "ui.scene3d grid: expected i32") }
    if v < -2147483648 || v > 2147483647 { return oren_err(4, "ui.scene3d grid: i32 out of range") }
    var u = v
    if u < 0 { u = u + 4294967296 }
    return _store_u32_le(out, off, u)
}

fn _store_xyz_values(out, off, x, y, z, ctx) {
    var rc = _store_i32_le(out, off + 0, x)
    if oren_is_err(rc) { return oren_err(4, ctx + ": x must be i32") }
    rc = _store_i32_le(out, off + 4, y)
    if oren_is_err(rc) { return oren_err(4, ctx + ": y must be i32") }
    rc = _store_i32_le(out, off + 8, z)
    if oren_is_err(rc) { return oren_err(4, ctx + ": z must be i32") }
    return 0
}

fn _store_triangle(out, off, ax, ay, az, bx, by, bz, cx, cy, cz, ctx) {
    var rc = _store_xyz_values(out, off + 0, ax, ay, az, ctx + ".a")
    if oren_is_err(rc) { return rc }
    rc = _store_xyz_values(out, off + 12, bx, by, bz, ctx + ".b")
    if oren_is_err(rc) { return rc }
    return _store_xyz_values(out, off + 24, cx, cy, cz, ctx + ".c")
}

fn _heightfield_origin(h, ctx) {
    var origin = h["origin"]
    if origin == nil { origin = h["origin_xy"] }
    if origin == nil { origin = [0, 0] }
    if oren_list_len(origin) != 2 { return oren_err(4, ctx + ": heightfield origin must be [x,y]") }
    if _is_int(origin[0]) == false || _is_int(origin[1]) == false {
        return oren_err(4, ctx + ": heightfield origin must contain i32")
    }
    return origin
}

fn _heightfield_step(h, ctx) {
    var step = h["step_xy"]
    if step == nil { step = h["cell_size_xy"] }
    if step != nil {
        if oren_list_len(step) != 2 { return oren_err(4, ctx + ": heightfield step_xy must be [sx,sy]") }
        if _is_int(step[0]) == false || _is_int(step[1]) == false || step[0] <= 0 || step[1] <= 0 {
            return oren_err(4, ctx + ": heightfield step_xy must contain positive i32")
        }
        return step
    }
    var cell = h["cell_size"]
    if cell == nil { cell = h["step"] }
    if cell == nil { cell = 1 }
    if _is_int(cell) == false || cell <= 0 { return oren_err(4, ctx + ": heightfield cell_size must be positive i32") }
    return [cell, cell]
}

fn _heightfield_rows(h) {
    var rows = h["z_values"]
    if rows == nil { rows = h["heights"] }
    return rows
}

fn _heightfield_dims(h, ctx) {
    var rows = _heightfield_rows(h)
    var nr = oren_list_len(rows)
    if oren_is_err(nr) || nr < 2 || nr > 31 {
        return oren_err(4, ctx + ": heightfield rows must be 2..31")
    }
    var first = rows[0]
    var nc = oren_list_len(first)
    if oren_is_err(nc) || nc < 2 || nc > 31 {
        return oren_err(4, ctx + ": heightfield columns must be 2..31")
    }
    var r = 0
    while r < nr {
        var row = rows[r]
        if oren_list_len(row) != nc { return oren_err(4, ctx + ": heightfield rows must have equal width") }
        var c = 0
        while c < nc {
            if _is_int(row[c]) == false { return oren_err(4, ctx + ": heightfield heights must be i32") }
            c = c + 1
        }
        r = r + 1
    }
    return [nr, nc]
}

fn _heightfields_triangle_count(heightfields, ctx) {
    if heightfields == nil { return oren_err(4, ctx + ": missing heightfields_xy") }
    var nh = oren_list_len(heightfields)
    if oren_is_err(nh) { return oren_err(4, ctx + ": heightfields_xy must be list") }
    var total = 0
    var i = 0
    while i < nh {
        var h = heightfields[i]
        if h == nil { return oren_err(4, ctx + ": heightfield must be object") }
        var origin = _heightfield_origin(h, ctx)
        if oren_is_err(origin) { return origin }
        var step = _heightfield_step(h, ctx)
        if oren_is_err(step) { return step }
        var dims = _heightfield_dims(h, ctx)
        if oren_is_err(dims) { return dims }
        total = total + (dims[0] - 1) * (dims[1] - 1) * 2
        if total > 1820 { return oren_err(4, ctx + ": heightfield exceeds mesh3d triangle budget") }
        i = i + 1
    }
    return total
}

fn pack_heightfields_xy(heightfields, ctx) {
    var tri_count = _heightfields_triangle_count(heightfields, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var hi = 0
    var nh = oren_list_len(heightfields)
    while hi < nh {
        var h = heightfields[hi]
        var origin = _heightfield_origin(h, ctx)
        var step = _heightfield_step(h, ctx)
        var rows = _heightfield_rows(h)
        var dims = _heightfield_dims(h, ctx)
        var nr = dims[0]
        var nc = dims[1]
        var oy = origin[1]
        var sx = step[0]
        var sy = step[1]
        var r = 0
        while r < nr - 1 {
            var ox = origin[0]
            var y0 = oy + r * sy
            var y1 = y0 + sy
            var c = 0
            while c < nc - 1 {
                var x0 = ox + c * sx
                var x1 = x0 + sx
                var z00 = rows[r][c]
                var z10 = rows[r][c + 1]
                var z01 = rows[r + 1][c]
                var z11 = rows[r + 1][c + 1]
                var rc = _store_triangle(out, off, x0, y0, z00, x1, y0, z10, x1, y1, z11, ctx + ".cell0")
                if oren_is_err(rc) { return rc }
                off = off + 36
                rc = _store_triangle(out, off, x0, y0, z00, x1, y1, z11, x0, y1, z01, ctx + ".cell1")
                if oren_is_err(rc) { return rc }
                off = off + 36
                c = c + 1
            }
            r = r + 1
        }
        hi = hi + 1
    }
    return out
}

fn _surface_rows(s) {
    var rows = s["vertices"]
    if rows == nil { rows = s["vertices_xyz"] }
    if rows == nil { rows = s["points"] }
    if rows == nil { rows = s["points_xyz"] }
    return rows
}

fn _surface_dims(s, ctx) {
    var rows = _surface_rows(s)
    var nr = oren_list_len(rows)
    if oren_is_err(nr) || nr < 2 || nr > 31 {
        return oren_err(4, ctx + ": surface rows must be 2..31")
    }
    var first = rows[0]
    var nc = oren_list_len(first)
    if oren_is_err(nc) || nc < 2 || nc > 31 {
        return oren_err(4, ctx + ": surface columns must be 2..31")
    }
    var r = 0
    while r < nr {
        var row = rows[r]
        if oren_list_len(row) != nc { return oren_err(4, ctx + ": surface rows must have equal width") }
        var c = 0
        while c < nc {
            var p = row[c]
            if p == nil || oren_list_len(p) != 3 {
                return oren_err(4, ctx + ": surface vertex must be [x,y,z]")
            }
            if _is_int(p[0]) == false || _is_int(p[1]) == false || _is_int(p[2]) == false {
                return oren_err(4, ctx + ": surface vertex must contain i32")
            }
            c = c + 1
        }
        r = r + 1
    }
    return [nr, nc]
}

fn _surfaces_triangle_count(surfaces, ctx) {
    if surfaces == nil { return oren_err(4, ctx + ": missing surfaces_xyz") }
    var ns = oren_list_len(surfaces)
    if oren_is_err(ns) { return oren_err(4, ctx + ": surfaces_xyz must be list") }
    var total = 0
    var i = 0
    while i < ns {
        var s = surfaces[i]
        if s == nil { return oren_err(4, ctx + ": surface must be object") }
        var dims = _surface_dims(s, ctx)
        if oren_is_err(dims) { return dims }
        total = total + (dims[0] - 1) * (dims[1] - 1) * 2
        if total > 1820 { return oren_err(4, ctx + ": surface exceeds mesh3d triangle budget") }
        i = i + 1
    }
    return total
}

fn pack_surfaces_xyz(surfaces, ctx) {
    var tri_count = _surfaces_triangle_count(surfaces, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var si = 0
    var ns = oren_list_len(surfaces)
    while si < ns {
        var s = surfaces[si]
        var rows = _surface_rows(s)
        var dims = _surface_dims(s, ctx)
        var nr = dims[0]
        var nc = dims[1]
        var r = 0
        while r < nr - 1 {
            var c = 0
            while c < nc - 1 {
                var p00 = rows[r][c]
                var p10 = rows[r][c + 1]
                var p01 = rows[r + 1][c]
                var p11 = rows[r + 1][c + 1]
                var rc = _store_triangle(out, off, p00[0], p00[1], p00[2], p10[0], p10[1], p10[2], p11[0], p11[1], p11[2], ctx + ".cell0")
                if oren_is_err(rc) { return rc }
                off = off + 36
                rc = _store_triangle(out, off, p00[0], p00[1], p00[2], p11[0], p11[1], p11[2], p01[0], p01[1], p01[2], ctx + ".cell1")
                if oren_is_err(rc) { return rc }
                off = off + 36
                c = c + 1
            }
            r = r + 1
        }
        si = si + 1
    }
    return out
}
