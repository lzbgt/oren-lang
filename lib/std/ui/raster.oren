// std:ui/raster (rolling)
//
// Deterministic software rasterizer for `std:ui/render` command buffers.
//
// This is intentionally minimal and headless: it produces a flat RGBA byte buffer.
// The purpose is:
// - enable pixel-level golden tests (without any OS GUI),
// - provide a reference implementation for future platform shims.
//
// Output format:
// - BYTES (u8_buf) length = w * h * 4
// - row-major, top-to-bottom
// - pixel order: R, G, B, A (8-bit each)
//
// Supported ops (v0):
// - {"op":"fill_rect","x":int,"y":int,"w":int,"h":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"stroke_line","x1":int,"y1":int,"x2":int,"y2":int,"width":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"circle","cx":int,"cy":int,"r":int,"fill":bool,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"fill_triangle","x1":int,"y1":int,"x2":int,"y2":int,"x3":int,"y3":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"text","x":int,"y":int,"text":string,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"text_bytes","x":int,"y":int,"data":bytes,"color":"#RRGGBB"|"#RRGGBBAA"}
//   - v0 rasterizes text as a simple 1px-high run of pixels (one per byte/char),
//     purely as a deterministic marker for tests.

import ui_cmds "std:ui/commands"
import ui_color "std:ui/color"
import result "std:result"
import bytes "std:bytes"

fn _set_px_rgba(buf, w, h, x, y, r, g, b, a) {
    if x < 0 || y < 0 || x >= w || y >= h { return 0 }
    var idx = (y * w + x) * 4
    oren_buf_store_u8(buf, idx + 0, r)
    oren_buf_store_u8(buf, idx + 1, g)
    oren_buf_store_u8(buf, idx + 2, b)
    oren_buf_store_u8(buf, idx + 3, a)
    return 0
}

fn _abs_i(v) {
    if v < 0 { return 0 - v }
    return v
}

fn _draw_line(buf, w, h, x1, y1, x2, y2, lw, c) {
    var dx = _abs_i(x2 - x1)
    var dy = _abs_i(y2 - y1)
    var steps = dx
    if dy > steps { steps = dy }
    if steps == 0 {
        _set_px_rgba(buf, w, h, x1, y1, c["r"], c["g"], c["b"], c["a"])
        return 0
    }
    var i = 0
    while i <= steps {
        var x = x1 + ((x2 - x1) * i) / steps
        var y = y1 + ((y2 - y1) * i) / steps
        var oy = 0
        while oy < lw {
            var ox = 0
            while ox < lw {
                _set_px_rgba(buf, w, h, x + ox, y + oy, c["r"], c["g"], c["b"], c["a"])
                ox = ox + 1
            }
            oy = oy + 1
        }
        i = i + 1
    }
    return 0
}

fn _draw_circle(buf, w, h, cx, cy, r, fill, c) {
    var r2 = r * r
    var inner = r - 1
    if inner < 0 { inner = 0 }
    var inner2 = inner * inner
    var yy = cy - r
    while yy <= cy + r {
        var xx = cx - r
        while xx <= cx + r {
            var dx = xx - cx
            var dy = yy - cy
            var d2 = dx * dx + dy * dy
            if fill != 0 {
                if d2 <= r2 { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            } else {
                if d2 <= r2 && d2 >= inner2 { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    return 0
}

fn _min3(a, b, c) {
    var out = a
    if b < out { out = b }
    if c < out { out = c }
    return out
}

fn _max3(a, b, c) {
    var out = a
    if b > out { out = b }
    if c > out { out = c }
    return out
}

fn _edge(ax, ay, bx, by, px, py) {
    return (px - ax) * (by - ay) - (py - ay) * (bx - ax)
}

fn _draw_fill_triangle(buf, w, h, x1, y1, x2, y2, x3, y3, c) {
    var min_x = _min3(x1, x2, x3)
    var max_x = _max3(x1, x2, x3)
    var min_y = _min3(y1, y2, y3)
    var max_y = _max3(y1, y2, y3)
    if min_x < 0 { min_x = 0 }
    if min_y < 0 { min_y = 0 }
    if max_x >= w { max_x = w - 1 }
    if max_y >= h { max_y = h - 1 }
    var area = _edge(x1, y1, x2, y2, x3, y3)
    if area == 0 { return 0 }
    var yy = min_y
    while yy <= max_y {
        var xx = min_x
        while xx <= max_x {
            var e1 = _edge(x1, y1, x2, y2, xx, yy)
            var e2 = _edge(x2, y2, x3, y3, xx, yy)
            var e3 = _edge(x3, y3, x1, y1, xx, yy)
            if area > 0 {
                if e1 >= 0 && e2 >= 0 && e3 >= 0 { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            } else {
                if e1 <= 0 && e2 <= 0 && e3 <= 0 { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    return 0
}

fn rasterize(cmds, w, h, opts) {
    if opts == nil { opts = {} }
    if w < 0 || h < 0 { return oren_err(4, "rasterize: invalid size") }

    // Default: validate command buffer (fast, and prevents confusing partial output).
    // Disable via opts["validate"] = 0.
    var do_validate = opts["validate"]
    if do_validate == nil { do_validate = 1 }
    if do_validate != 0 {
        var vr = ui_cmds.try_validate(cmds, w, h, opts)
        if oren_is_err(vr) { return vr }
    }

    var n = w * h * 4
    var buf = oren_u8_buf_new(n)
    if oren_is_err(buf) { return buf }

    // Clear to transparent black by default.
    var i = 0
    while i < n {
        oren_buf_store_u8(buf, i, 0)
        i = i + 1
    }

    var bg = opts["clear_color"]
    if bg != nil {
        var c0 = ui_color.try_parse_hex(bg)
        if oren_is_err(c0) { return result.with_context(c0, "rasterize: clear_color") }
        var y = 0
        while y < h {
            var x = 0
            while x < w {
                _set_px_rgba(buf, w, h, x, y, c0["r"], c0["g"], c0["b"], c0["a"])
                x = x + 1
            }
            y = y + 1
        }
    }

    if cmds == nil { return buf }

    var ci = 0
    while ci < oren_list_len(cmds) {
        var opm = cmds[ci]
        var op = opm["op"]
        if op == "fill_rect" {
            var c = ui_color.try_parse_hex(opm["color"])
            if oren_is_err(c) { return result.with_context(c, "rasterize: fill_rect color") }
            var rx = opm["x"]
            var ry = opm["y"]
            var rw = opm["w"]
            var rh = opm["h"]
            if rw == nil || rh == nil { return oren_err(4, "rasterize: fill_rect missing size") }
            var yy = 0
            while yy < rh {
                var xx = 0
                while xx < rw {
                    _set_px_rgba(buf, w, h, rx + xx, ry + yy, c["r"], c["g"], c["b"], c["a"])
                    xx = xx + 1
                }
                yy = yy + 1
            }
        } else if op == "stroke_line" {
            var lc = ui_color.try_parse_hex(opm["color"])
            if oren_is_err(lc) { return result.with_context(lc, "rasterize: stroke_line color") }
            var lw = opm["width"]
            if lw == nil { lw = 1 }
            _draw_line(buf, w, h, opm["x1"], opm["y1"], opm["x2"], opm["y2"], lw, lc)
        } else if op == "circle" {
            var cc = ui_color.try_parse_hex(opm["color"])
            if oren_is_err(cc) { return result.with_context(cc, "rasterize: circle color") }
            var fill = opm["fill"]
            if fill == nil { fill = true }
            _draw_circle(buf, w, h, opm["cx"], opm["cy"], opm["r"], fill, cc)
        } else if op == "fill_triangle" {
            var tc = ui_color.try_parse_hex(opm["color"])
            if oren_is_err(tc) { return result.with_context(tc, "rasterize: fill_triangle color") }
            _draw_fill_triangle(buf, w, h, opm["x1"], opm["y1"], opm["x2"], opm["y2"], opm["x3"], opm["y3"], tc)
        } else if op == "text" {
            // Deterministic marker: draw 1 pixel per character in the string at y.
            var c2 = ui_color.try_parse_hex(opm["color"])
            if oren_is_err(c2) { return result.with_context(c2, "rasterize: text color") }
            var tx = opm["x"]
            var ty = opm["y"]
            var s = opm["text"]
            if s == nil { s = "" }
            var ln = oren_string_len(s)
            var j = 0
            while j < ln {
                _set_px_rgba(buf, w, h, tx + j, ty, c2["r"], c2["g"], c2["b"], c2["a"])
                j = j + 1
            }
        } else if op == "text_bytes" {
            // Deterministic marker: draw 1 pixel per byte at y.
            var c3 = ui_color.try_parse_hex(opm["color"])
            if oren_is_err(c3) { return result.with_context(c3, "rasterize: text_bytes color") }
            var bx = opm["x"]
            var by = opm["y"]
            var data = opm["data"]
            var bn = bytes.try_len(data)
            if oren_is_err(bn) { return result.with_context(bn, "rasterize: text_bytes data") }
            var bj = 0
            while bj < bn {
                _set_px_rgba(buf, w, h, bx + bj, by, c3["r"], c3["g"], c3["b"], c3["a"])
                bj = bj + 1
            }
        }
        ci = ci + 1
    }

    return buf
}

fn try_rasterize(cmds, w, h, opts) {
    return rasterize(cmds, w, h, opts)
}
