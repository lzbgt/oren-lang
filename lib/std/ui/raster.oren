// std:ui/raster (rolling)
//
// Deterministic software rasterizer for `std:ui/render` command buffers.
//
// This is intentionally minimal and headless: it produces a flat RGBA byte buffer.
// The purpose is:
// - enable pixel-level golden tests (without any OS GUI),
// - provide a reference implementation for future platform shims.
//
// Output format:
// - BYTES (u8_buf) length = w * h * 4
// - row-major, top-to-bottom
// - pixel order: R, G, B, A (8-bit each)
//
// Supported ops (v0):
// - {"op":"fill_rect","x":int,"y":int,"w":int,"h":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"push_clip_rect","x":int,"y":int,"w":int,"h":int}
// - {"op":"pop_clip"}
// - {"op":"push_translate","dx":int,"dy":int}
// - {"op":"pop_transform"}
// - {"op":"push_opacity","alpha_milli":int} where 1000 is fully opaque
// - {"op":"pop_opacity"}
// - {"op":"push_camera_ortho","near_z":int,"far_z":int}
// - {"op":"pop_camera"}
// - {"op":"stroke_line","x1":int,"y1":int,"x2":int,"y2":int,"width":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"stroke_rect","x":int,"y":int,"w":int,"h":int,"width":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"round_rect","x":int,"y":int,"w":int,"h":int,"r":int,"fill":bool,"width":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"circle","cx":int,"cy":int,"r":int,"fill":bool,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"ellipse","x":int,"y":int,"w":int,"h":int,"fill":bool,"width":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"polyline","points":bytes,"width":int,"color":"#RRGGBB"|"#RRGGBBAA"} where each point is u32le x,y
// - {"op":"fill_triangle","x1":int,"y1":int,"x2":int,"y2":int,"x3":int,"y3":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"fill_triangles","triangles":bytes,"color":"#RRGGBB"|"#RRGGBBAA"} where each triangle is three u32le x,y vertices
// - {"op":"mesh2d","id":int,"triangles":bytes,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"draw_mesh2d","id":int}
// - {"op":"destroy_mesh2d","id":int}
// - {"op":"mesh3d","id":int,"triangles":bytes,"color":"#RRGGBB"|"#RRGGBBAA"}
//   where each triangle is three i32le x,y,z vertices; v0 raster uses
//   orthographic XY and deterministic painter-depth order (higher average Z first).
// - {"op":"mesh3d_rgba","id":int,"triangles":bytes} where each triangle is
//   three i32le x,y,z vertices plus RGBA bytes.
// - {"op":"mesh3d_indexed","id":int,"vertices":bytes,"indices":bytes,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"draw_mesh3d","id":int}
// - {"op":"draw_mesh3d_at","id":int,"x":int,"y":int,"z":int,"scale_milli":int}
// - {"op":"destroy_mesh3d","id":int}
// - {"op":"material3d","id":int,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"draw_mesh3d_material","id":int,"material_id":int}
// - {"op":"draw_mesh3d_at_material","id":int,"material_id":int,"x":int,"y":int,"z":int,"scale_milli":int}
// - {"op":"destroy_material3d","id":int}
// - {"op":"model3d","id":int,"mesh_id":int,"material_id":int|0,"x":int,"y":int,"z":int,"scale_milli":int}
// - {"op":"draw_model3d","id":int}
// - {"op":"destroy_model3d","id":int}
// - {"op":"text","x":int,"y":int,"text":string,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"text_bytes","x":int,"y":int,"data":bytes,"color":"#RRGGBB"|"#RRGGBBAA"}
//   - v0 rasterizes text as a simple 1px-high run of pixels (one per byte/char),
//     purely as a deterministic marker for tests.
// - {"op":"text_resource","id":int,"data":bytes,"color":"#RRGGBB"|"#RRGGBBAA"}
// - {"op":"draw_text","id":int,"x":int,"y":int}
// - {"op":"draw_texts","id":int,"positions":bytes} where each position is u32le x,y
// - {"op":"destroy_text","id":int}
// - {"op":"image_rgba","id":int,"w":int,"h":int,"data":bytes}
// - {"op":"draw_image","id":int,"x":int,"y":int,"w":int,"h":int}
// - {"op":"destroy_image","id":int}
// - {"op":"draw_image_rect","id":int,"sx":int,"sy":int,"sw":int,"sh":int,"x":int,"y":int,"w":int,"h":int}
// - {"op":"draw_image_rects","id":int,"rects":bytes} where each rect is
//   sx,sy,sw,sh,x,y,w,h as little-endian u32.

import ui_cmds "std:ui/commands"
import ui_color "std:ui/color"
import result "std:result"
import bytes "std:bytes"

var _clip_enabled = 0
var _clip_x = 0
var _clip_y = 0
var _clip_w = 0
var _clip_h = 0
var _tx = 0
var _ty = 0
var _opacity_milli = 1000
var _out_ptr = 0

fn _max_i(a, b) {
    if a > b { return a }
    return b
}

fn _min_i(a, b) {
    if a < b { return a }
    return b
}

fn _clip_snapshot() {
    return [_clip_enabled, _clip_x, _clip_y, _clip_w, _clip_h]
}

fn _clip_restore(s) {
    _clip_enabled = s[0]
    _clip_x = s[1]
    _clip_y = s[2]
    _clip_w = s[3]
    _clip_h = s[4]
    return 0
}

fn _clip_push(x, y, cw, ch) {
    if _clip_enabled == 0 {
        _clip_enabled = 1
        _clip_x = x
        _clip_y = y
        _clip_w = cw
        _clip_h = ch
        return 0
    }
    var x0 = _max_i(_clip_x, x)
    var y0 = _max_i(_clip_y, y)
    var x1 = _min_i(_clip_x + _clip_w, x + cw)
    var y1 = _min_i(_clip_y + _clip_h, y + ch)
    _clip_x = x0
    _clip_y = y0
    _clip_w = x1 - x0
    _clip_h = y1 - y0
    if _clip_w < 0 { _clip_w = 0 }
    if _clip_h < 0 { _clip_h = 0 }
    return 0
}

fn _set_px_rgba(buf, w, h, x, y, r, g, b, a) {
    x = x + _tx
    y = y + _ty
    if x < 0 || y < 0 || x >= w || y >= h { return 0 }
    if _clip_enabled != 0 {
        if x < _clip_x || y < _clip_y || x >= _clip_x + _clip_w || y >= _clip_y + _clip_h { return 0 }
    }
    a = (a * _opacity_milli) / 1000
    var idx = (y * w + x) * 4
    ptr_set_byte(iadd(_out_ptr, idx + 0), r & 255)
    ptr_set_byte(iadd(_out_ptr, idx + 1), g & 255)
    ptr_set_byte(iadd(_out_ptr, idx + 2), b & 255)
    ptr_set_byte(iadd(_out_ptr, idx + 3), a & 255)
    return 0
}

fn _abs_i(v) {
    if v < 0 { return 0 - v }
    return v
}

fn _draw_line(buf, w, h, x1, y1, x2, y2, lw, c) {
    var dx = _abs_i(x2 - x1)
    var dy = _abs_i(y2 - y1)
    var steps = dx
    if dy > steps { steps = dy }
    if steps == 0 {
        _set_px_rgba(buf, w, h, x1, y1, c["r"], c["g"], c["b"], c["a"])
        return 0
    }
    var i = 0
    while i <= steps {
        var x = x1 + ((x2 - x1) * i) / steps
        var y = y1 + ((y2 - y1) * i) / steps
        var oy = 0
        while oy < lw {
            var ox = 0
            while ox < lw {
                _set_px_rgba(buf, w, h, x + ox, y + oy, c["r"], c["g"], c["b"], c["a"])
                ox = ox + 1
            }
            oy = oy + 1
        }
        i = i + 1
    }
    return 0
}

fn _draw_circle(buf, w, h, cx, cy, r, fill, c) {
    var r2 = r * r
    var inner = r - 1
    if inner < 0 { inner = 0 }
    var inner2 = inner * inner
    var yy = cy - r
    while yy <= cy + r {
        var xx = cx - r
        while xx <= cx + r {
            var dx = xx - cx
            var dy = yy - cy
            var d2 = dx * dx + dy * dy
            if fill != 0 {
                if d2 <= r2 { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            } else {
                if d2 <= r2 && d2 >= inner2 { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    return 0
}

fn _ellipse_inside(px, py, x, y, ew, eh) {
    var cx2 = (x * 2) + ew - 1
    var cy2 = (y * 2) + eh - 1
    var dx2 = (px * 2) - cx2
    var dy2 = (py * 2) - cy2
    var ww = ew * ew
    var hh = eh * eh
    return (dx2 * dx2 * hh) + (dy2 * dy2 * ww) <= ww * hh
}

fn _draw_ellipse(buf, w, h, x, y, ew, eh, lw, fill, c) {
    var yy = y
    while yy < y + eh {
        var xx = x
        while xx < x + ew {
            var outer = _ellipse_inside(xx, yy, x, y, ew, eh)
            var draw = false
            if fill != 0 {
                draw = outer
            } else if outer {
                var iw = ew - (lw * 2)
                var ih = eh - (lw * 2)
                if iw <= 0 || ih <= 0 {
                    draw = true
                } else {
                    draw = _ellipse_inside(xx, yy, x + lw, y + lw, iw, ih) == false
                }
            }
            if draw { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            xx = xx + 1
        }
        yy = yy + 1
    }
    return 0
}

fn _round_rect_inside(px, py, x, y, rw, rh, rr) {
    if px < x || py < y || px >= x + rw || py >= y + rh { return false }
    if rr <= 0 { return true }
    var left = px < x + rr
    var right = px >= x + rw - rr
    var top = py < y + rr
    var bottom = py >= y + rh - rr
    if (left == false && right == false) || (top == false && bottom == false) { return true }
    var cx2 = 0
    if left {
        cx2 = ((x + rr) * 2) - 1
    } else {
        cx2 = ((x + rw - rr) * 2) - 1
    }
    var cy2 = 0
    if top {
        cy2 = ((y + rr) * 2) - 1
    } else {
        cy2 = ((y + rh - rr) * 2) - 1
    }
    var dx2 = ((px * 2) + 1) - cx2
    var dy2 = ((py * 2) + 1) - cy2
    var rr2 = rr * 2
    return (dx2 * dx2) + (dy2 * dy2) <= rr2 * rr2
}

fn _draw_round_rect(buf, w, h, x, y, rw, rh, rr, lw, fill, c) {
    var yy = y
    while yy < y + rh {
        var xx = x
        while xx < x + rw {
            var outer = _round_rect_inside(xx, yy, x, y, rw, rh, rr)
            var draw = false
            if fill != 0 {
                draw = outer
            } else if outer {
                var iw = rw - (lw * 2)
                var ih = rh - (lw * 2)
                if iw <= 0 || ih <= 0 {
                    draw = true
                } else {
                    var ir = rr - lw
                    if ir < 0 { ir = 0 }
                    draw = _round_rect_inside(xx, yy, x + lw, y + lw, iw, ih, ir) == false
                }
            }
            if draw { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            xx = xx + 1
        }
        yy = yy + 1
    }
    return 0
}

fn _draw_polyline(buf, w, h, points, lw, c) {
    var plen = bytes.len(points)
    if oren_is_err(plen) { return plen }
    var last_x = bytes.get_u32_le(points, 0)
    var last_y = bytes.get_u32_le(points, 4)
    if oren_is_err(last_x) || oren_is_err(last_y) { return oren_err(4, "rasterize: polyline malformed point") }
    var off = 8
    while off < plen {
        var x = bytes.get_u32_le(points, off)
        var y = bytes.get_u32_le(points, off + 4)
        if oren_is_err(x) || oren_is_err(y) { return oren_err(4, "rasterize: polyline malformed point") }
        _draw_line(buf, w, h, last_x, last_y, x, y, lw, c)
        last_x = x
        last_y = y
        off = off + 8
    }
    return 0
}

fn _draw_text_marker(buf, w, h, text_resource, x, y) {
    var tc = ui_color.parse_hex(text_resource["color"])
    if oren_is_err(tc) { return result.with_context(tc, "rasterize: draw_text color") }
    var tb = text_resource["data"]
    var tn = bytes.len(tb)
    if oren_is_err(tn) { return result.with_context(tn, "rasterize: draw_text data") }
    var ti = 0
    while ti < tn {
        _set_px_rgba(buf, w, h, x + ti, y, tc["r"], tc["g"], tc["b"], tc["a"])
        ti = ti + 1
    }
    return 0
}

fn _min3(a, b, c) {
    var out = a
    if b < out { out = b }
    if c < out { out = c }
    return out
}

fn _max3(a, b, c) {
    var out = a
    if b > out { out = b }
    if c > out { out = c }
    return out
}

fn _edge(ax, ay, bx, by, px, py) {
    return (px - ax) * (by - ay) - (py - ay) * (bx - ax)
}

fn _draw_fill_triangle(buf, w, h, x1, y1, x2, y2, x3, y3, c) {
    var min_x = _min3(x1, x2, x3)
    var max_x = _max3(x1, x2, x3)
    var min_y = _min3(y1, y2, y3)
    var max_y = _max3(y1, y2, y3)
    if min_x < 0 { min_x = 0 }
    if min_y < 0 { min_y = 0 }
    if max_x >= w { max_x = w - 1 }
    if max_y >= h { max_y = h - 1 }
    var area = _edge(x1, y1, x2, y2, x3, y3)
    if area == 0 { return 0 }
    var yy = min_y
    while yy <= max_y {
        var xx = min_x
        while xx <= max_x {
            var e1 = _edge(x1, y1, x2, y2, xx, yy)
            var e2 = _edge(x2, y2, x3, y3, xx, yy)
            var e3 = _edge(x3, y3, x1, y1, xx, yy)
            if area > 0 {
                if e1 >= 0 && e2 >= 0 && e3 >= 0 { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            } else {
                if e1 <= 0 && e2 <= 0 && e3 <= 0 { _set_px_rgba(buf, w, h, xx, yy, c["r"], c["g"], c["b"], c["a"]) }
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
    return 0
}

fn _draw_triangle_bytes(buf, w, h, tris, c, err_prefix) {
    var tris_len = bytes.len(tris)
    if oren_is_err(tris_len) { return result.with_context(tris_len, err_prefix) }
    var toff = 0
    while toff < tris_len {
        var tx1 = bytes.get_u32_le(tris, toff)
        var ty1 = bytes.get_u32_le(tris, toff + 4)
        var tx2 = bytes.get_u32_le(tris, toff + 8)
        var ty2 = bytes.get_u32_le(tris, toff + 12)
        var tx3 = bytes.get_u32_le(tris, toff + 16)
        var ty3 = bytes.get_u32_le(tris, toff + 20)
        if oren_is_err(tx1) || oren_is_err(ty1) || oren_is_err(tx2) || oren_is_err(ty2) || oren_is_err(tx3) || oren_is_err(ty3) {
            return oren_err(4, err_prefix + " malformed triangle")
        }
        _draw_fill_triangle(buf, w, h, tx1, ty1, tx2, ty2, tx3, ty3, c)
        toff = toff + 24
    }
    return 0
}

fn _mesh3d_zsum(tris, off) {
    var z1 = bytes.get_i32_le(tris, off + 8)
    var z2 = bytes.get_i32_le(tris, off + 20)
    var z3 = bytes.get_i32_le(tris, off + 32)
    if oren_is_err(z1) || oren_is_err(z2) || oren_is_err(z3) { return oren_err(4, "rasterize: mesh3d malformed z") }
    return z1 + z2 + z3
}

fn _mesh3d_zsum_model(tris, off, mz, scale_milli) {
    var zsum = _mesh3d_zsum(tris, off)
    if oren_is_err(zsum) { return zsum }
    return (zsum * scale_milli) / 1000 + mz * 3
}

fn _mesh3d_rgba_zsum(tris, off) {
    var z1 = bytes.get_i32_le(tris, off + 8)
    var z2 = bytes.get_i32_le(tris, off + 20)
    var z3 = bytes.get_i32_le(tris, off + 32)
    if oren_is_err(z1) || oren_is_err(z2) || oren_is_err(z3) { return oren_err(4, "rasterize: mesh3d_rgba malformed z") }
    return z1 + z2 + z3
}

fn _mesh3d_rgba_zsum_model(tris, off, mz, scale_milli) {
    var zsum = _mesh3d_rgba_zsum(tris, off)
    if oren_is_err(zsum) { return zsum }
    return (zsum * scale_milli) / 1000 + mz * 3
}

fn _mesh3d_indexed_zsum_model(vertices, indices, off, mz, scale_milli) {
    var i1 = bytes.get_u32_le(indices, off)
    var i2 = bytes.get_u32_le(indices, off + 4)
    var i3 = bytes.get_u32_le(indices, off + 8)
    if oren_is_err(i1) || oren_is_err(i2) || oren_is_err(i3) { return oren_err(4, "rasterize: mesh3d_indexed malformed index") }
    var z1 = bytes.get_i32_le(vertices, i1 * 12 + 8)
    var z2 = bytes.get_i32_le(vertices, i2 * 12 + 8)
    var z3 = bytes.get_i32_le(vertices, i3 * 12 + 8)
    if oren_is_err(z1) || oren_is_err(z2) || oren_is_err(z3) { return oren_err(4, "rasterize: mesh3d_indexed malformed z") }
    return ((z1 + z2 + z3) * scale_milli) / 1000 + mz * 3
}

fn _depth_zsum_visible(zsum, depth_enabled, near_z, far_z) {
    if depth_enabled == 0 { return true }
    return zsum >= near_z * 3 && zsum <= far_z * 3
}

fn _model_coord(v, offset, scale_milli) {
    return (v * scale_milli) / 1000 + offset
}

fn _draw_triangle3d_at_model(buf, w, h, tris, off, c, err_prefix, mx, my, mz, scale_milli) {
    var tx1 = bytes.get_i32_le(tris, off)
    var ty1 = bytes.get_i32_le(tris, off + 4)
    var tz1 = bytes.get_i32_le(tris, off + 8)
    var tx2 = bytes.get_i32_le(tris, off + 12)
    var ty2 = bytes.get_i32_le(tris, off + 16)
    var tz2 = bytes.get_i32_le(tris, off + 20)
    var tx3 = bytes.get_i32_le(tris, off + 24)
    var ty3 = bytes.get_i32_le(tris, off + 28)
    var tz3 = bytes.get_i32_le(tris, off + 32)
    if oren_is_err(tx1) || oren_is_err(ty1) || oren_is_err(tz1) || oren_is_err(tx2) || oren_is_err(ty2) || oren_is_err(tz2) || oren_is_err(tx3) || oren_is_err(ty3) || oren_is_err(tz3) {
        return oren_err(4, err_prefix + " malformed triangle")
    }
    _draw_fill_triangle(buf, w, h,
        _model_coord(tx1, mx, scale_milli),
        _model_coord(ty1, my, scale_milli),
        _model_coord(tx2, mx, scale_milli),
        _model_coord(ty2, my, scale_milli),
        _model_coord(tx3, mx, scale_milli),
        _model_coord(ty3, my, scale_milli),
        c)
    return 0
}

fn _draw_triangle3d_at(buf, w, h, tris, off, c, err_prefix) {
    return _draw_triangle3d_at_model(buf, w, h, tris, off, c, err_prefix, 0, 0, 0, 1000)
}

fn _draw_triangle3d_indexed_at_model(buf, w, h, vertices, indices, off, c, err_prefix, mx, my, mz, scale_milli) {
    var i1 = bytes.get_u32_le(indices, off)
    var i2 = bytes.get_u32_le(indices, off + 4)
    var i3 = bytes.get_u32_le(indices, off + 8)
    if oren_is_err(i1) || oren_is_err(i2) || oren_is_err(i3) { return oren_err(4, err_prefix + " malformed index") }
    var v1 = i1 * 12; var v2 = i2 * 12; var v3 = i3 * 12
    var tx1 = bytes.get_i32_le(vertices, v1)
    var ty1 = bytes.get_i32_le(vertices, v1 + 4)
    var tz1 = bytes.get_i32_le(vertices, v1 + 8)
    var tx2 = bytes.get_i32_le(vertices, v2)
    var ty2 = bytes.get_i32_le(vertices, v2 + 4)
    var tz2 = bytes.get_i32_le(vertices, v2 + 8)
    var tx3 = bytes.get_i32_le(vertices, v3)
    var ty3 = bytes.get_i32_le(vertices, v3 + 4)
    var tz3 = bytes.get_i32_le(vertices, v3 + 8)
    if oren_is_err(tx1) || oren_is_err(ty1) || oren_is_err(tz1) || oren_is_err(tx2) || oren_is_err(ty2) || oren_is_err(tz2) || oren_is_err(tx3) || oren_is_err(ty3) || oren_is_err(tz3) {
        return oren_err(4, err_prefix + " malformed vertex")
    }
    _draw_fill_triangle(buf, w, h,
        _model_coord(tx1, mx, scale_milli),
        _model_coord(ty1, my, scale_milli),
        _model_coord(tx2, mx, scale_milli),
        _model_coord(ty2, my, scale_milli),
        _model_coord(tx3, mx, scale_milli),
        _model_coord(ty3, my, scale_milli),
        c)
    return 0
}

fn _draw_triangle3d_indexed_bytes_model(buf, w, h, vertices, indices, c, err_prefix, mx, my, mz, scale_milli, depth_enabled, near_z, far_z) {
    var index_len = bytes.len(indices)
    if oren_is_err(index_len) { return result.with_context(index_len, err_prefix) }
    var triangle_count = index_len / 12
    var drawn = {}
    var drawn_count = 0
    while drawn_count < triangle_count {
        var best = -1
        var best_z = -9223372036854775807
        var ti = 0
        while ti < triangle_count {
            var key = oren_int_to_string(ti)
            if drawn[key] == nil {
                var zsum = _mesh3d_indexed_zsum_model(vertices, indices, ti * 12, mz, scale_milli)
                if oren_is_err(zsum) { return result.with_context(zsum, err_prefix) }
                if _depth_zsum_visible(zsum, depth_enabled, near_z, far_z) && (best < 0 || zsum > best_z) {
                    best = ti
                    best_z = zsum
                }
            }
            ti = ti + 1
        }
        if best < 0 { return 0 }
        var dr = _draw_triangle3d_indexed_at_model(buf, w, h, vertices, indices, best * 12, c, err_prefix, mx, my, mz, scale_milli)
        if oren_is_err(dr) { return dr }
        drawn[oren_int_to_string(best)] = true
        drawn_count = drawn_count + 1
    }
    return 0
}

fn _draw_triangle3d_bytes_model(buf, w, h, tris, c, err_prefix, mx, my, mz, scale_milli, depth_enabled, near_z, far_z) {
    var tris_len = bytes.len(tris)
    if oren_is_err(tris_len) { return result.with_context(tris_len, err_prefix) }
    var triangle_count = tris_len / 36
    var drawn = {}
    var drawn_count = 0
    while drawn_count < triangle_count {
        var best = -1
        var best_z = -9223372036854775807
        var ti = 0
        while ti < triangle_count {
            var key = oren_int_to_string(ti)
            if drawn[key] == nil {
                var zsum = _mesh3d_zsum_model(tris, ti * 36, mz, scale_milli)
                if oren_is_err(zsum) { return result.with_context(zsum, err_prefix) }
                if _depth_zsum_visible(zsum, depth_enabled, near_z, far_z) && (best < 0 || zsum > best_z) {
                    best = ti
                    best_z = zsum
                }
            }
            ti = ti + 1
        }
        if best < 0 { return 0 }
        var dr = _draw_triangle3d_at_model(buf, w, h, tris, best * 36, c, err_prefix, mx, my, mz, scale_milli)
        if oren_is_err(dr) { return dr }
        drawn[oren_int_to_string(best)] = true
        drawn_count = drawn_count + 1
    }
    return 0
}

fn _draw_triangle3d_bytes(buf, w, h, tris, c, err_prefix) {
    return _draw_triangle3d_bytes_model(buf, w, h, tris, c, err_prefix, 0, 0, 0, 1000, 0, 0, 0)
}

fn _draw_triangle3d_stride_bytes_model(buf, w, h, tris, stride, c, err_prefix, mx, my, mz, scale_milli, depth_enabled, near_z, far_z) {
    var tris_len = bytes.len(tris)
    if oren_is_err(tris_len) { return result.with_context(tris_len, err_prefix) }
    var triangle_count = tris_len / stride
    var drawn = {}
    var drawn_count = 0
    while drawn_count < triangle_count {
        var best = -1
        var best_z = -9223372036854775807
        var ti = 0
        while ti < triangle_count {
            var key = oren_int_to_string(ti)
            if drawn[key] == nil {
                var zsum = _mesh3d_zsum_model(tris, ti * stride, mz, scale_milli)
                if oren_is_err(zsum) { return result.with_context(zsum, err_prefix) }
                if _depth_zsum_visible(zsum, depth_enabled, near_z, far_z) && (best < 0 || zsum > best_z) {
                    best = ti
                    best_z = zsum
                }
            }
            ti = ti + 1
        }
        if best < 0 { return 0 }
        var dr = _draw_triangle3d_at_model(buf, w, h, tris, best * stride, c, err_prefix, mx, my, mz, scale_milli)
        if oren_is_err(dr) { return dr }
        drawn[oren_int_to_string(best)] = true
        drawn_count = drawn_count + 1
    }
    return 0
}

fn _draw_triangle3d_rgba_bytes_model(buf, w, h, tris, err_prefix, mx, my, mz, scale_milli, depth_enabled, near_z, far_z) {
    var tris_len = bytes.len(tris)
    if oren_is_err(tris_len) { return result.with_context(tris_len, err_prefix) }
    var triangle_count = tris_len / 40
    var drawn = {}
    var drawn_count = 0
    while drawn_count < triangle_count {
        var best = -1
        var best_z = -9223372036854775807
        var ti = 0
        while ti < triangle_count {
            var key = oren_int_to_string(ti)
            if drawn[key] == nil {
                var zsum = _mesh3d_rgba_zsum_model(tris, ti * 40, mz, scale_milli)
                if oren_is_err(zsum) { return result.with_context(zsum, err_prefix) }
                if _depth_zsum_visible(zsum, depth_enabled, near_z, far_z) && (best < 0 || zsum > best_z) {
                    best = ti
                    best_z = zsum
                }
            }
            ti = ti + 1
        }
        if best < 0 { return 0 }
        var off = best * 40
        var c = {
            "r": bytes.get_u8(tris, off + 36),
            "g": bytes.get_u8(tris, off + 37),
            "b": bytes.get_u8(tris, off + 38),
            "a": bytes.get_u8(tris, off + 39)
        }
        var dr = _draw_triangle3d_at_model(buf, w, h, tris, off, c, err_prefix, mx, my, mz, scale_milli)
        if oren_is_err(dr) { return dr }
        drawn[oren_int_to_string(best)] = true
        drawn_count = drawn_count + 1
    }
    return 0
}

fn _draw_triangle3d_rgba_bytes(buf, w, h, tris, err_prefix) {
    return _draw_triangle3d_rgba_bytes_model(buf, w, h, tris, err_prefix, 0, 0, 0, 1000, 0, 0, 0)
}

fn _draw_mesh3d_resource(buf, w, h, mesh3d, material, err_prefix, mx, my, mz, scale_milli, depth_enabled, near_z, far_z) {
    if mesh3d == nil { return oren_err(4, err_prefix + " missing mesh") }
    var material_color = nil
    if material != nil {
        material_color = ui_color.parse_hex(material["color"])
        if oren_is_err(material_color) { return result.with_context(material_color, err_prefix + " material color") }
    }
    if mesh3d["op"] == "mesh3d_rgba" {
        if material_color != nil {
            return _draw_triangle3d_stride_bytes_model(buf, w, h, mesh3d["triangles"], 40, material_color, err_prefix, mx, my, mz, scale_milli, depth_enabled, near_z, far_z)
        }
        return _draw_triangle3d_rgba_bytes_model(buf, w, h, mesh3d["triangles"], err_prefix, mx, my, mz, scale_milli, depth_enabled, near_z, far_z)
    }
    var m3c = ui_color.parse_hex(mesh3d["color"])
    if oren_is_err(m3c) { return result.with_context(m3c, err_prefix + " mesh3d color") }
    if material_color != nil { m3c = material_color }
    if mesh3d["op"] == "mesh3d_indexed" {
        return _draw_triangle3d_indexed_bytes_model(buf, w, h, mesh3d["vertices"], mesh3d["indices"], m3c, err_prefix, mx, my, mz, scale_milli, depth_enabled, near_z, far_z)
    }
    return _draw_triangle3d_bytes_model(buf, w, h, mesh3d["triangles"], m3c, err_prefix, mx, my, mz, scale_milli, depth_enabled, near_z, far_z)
}

fn rasterize(cmds, w, h, opts) {
    if opts == nil { opts = {} }
    if w < 0 || h < 0 { return oren_err(4, "rasterize: invalid size") }

    // Default: validate command buffer (fast, and prevents confusing partial output).
    // Disable via opts["validate"] = 0.
    var do_validate = opts["validate"]
    if do_validate == nil { do_validate = 1 }
    if do_validate != 0 {
        var vr = ui_cmds.validate(cmds, w, h, opts)
        if oren_is_err(vr) { return vr }
    }

    var n = w * h * 4
    var buf = oren_u8_buf_new(n)
    if oren_is_err(buf) { return buf }
    _out_ptr = 0
    if n > 0 {
        _out_ptr = oren_buf_data_ptr_unchecked(buf)
        if _out_ptr == 0 { return oren_err(4, "rasterize: output data ptr is nil") }
    }

    _clip_enabled = 0
    _tx = 0
    _ty = 0
    _opacity_milli = 1000

    // Clear to transparent black by default.
    var i = 0
    while i < n {
        ptr_set_byte(iadd(_out_ptr, i), 0)
        i = i + 1
    }

    var bg = opts["clear_color"]
    if bg != nil {
        var c0 = ui_color.parse_hex(bg)
        if oren_is_err(c0) { return result.with_context(c0, "rasterize: clear_color") }
        var y = 0
        while y < h {
            var x = 0
            while x < w {
                _set_px_rgba(buf, w, h, x, y, c0["r"], c0["g"], c0["b"], c0["a"])
                x = x + 1
            }
            y = y + 1
        }
    }

    if cmds == nil { return buf }

    var clip_stack = {}
    var clip_depth = 0
    var transform_stack = {}
    var transform_depth = 0
    var opacity_stack = {}
    var opacity_depth = 0
    var camera_stack = {}
    var camera_depth = 0
    var depth_enabled = 0
    var near_z = 0
    var far_z = 0
    var images = {}
    var texts = {}
    var meshes = {}
    var materials = {}
    var models = {}
    var ci = 0
    while ci < oren_list_len(cmds) {
        var opm = cmds[ci]
        var op = opm["op"]
        if op == "push_clip_rect" {
            clip_stack[oren_int_to_string(clip_depth)] = _clip_snapshot()
            clip_depth = clip_depth + 1
            _clip_push(opm["x"] + _tx, opm["y"] + _ty, opm["w"], opm["h"])
        } else if op == "pop_clip" {
            if clip_depth <= 0 { return oren_err(4, "rasterize: clip stack underflow") }
            clip_depth = clip_depth - 1
            var ckey = oren_int_to_string(clip_depth)
            _clip_restore(clip_stack[ckey])
            clip_stack[ckey] = nil
        } else if op == "push_translate" {
            transform_stack[oren_int_to_string(transform_depth)] = [_tx, _ty]
            transform_depth = transform_depth + 1
            _tx = _tx + opm["dx"]
            _ty = _ty + opm["dy"]
        } else if op == "pop_transform" {
            if transform_depth <= 0 { return oren_err(4, "rasterize: transform stack underflow") }
            transform_depth = transform_depth - 1
            var tkey = oren_int_to_string(transform_depth)
            var prev = transform_stack[tkey]
            _tx = prev[0]
            _ty = prev[1]
            transform_stack[tkey] = nil
        } else if op == "push_opacity" {
            opacity_stack[oren_int_to_string(opacity_depth)] = _opacity_milli
            opacity_depth = opacity_depth + 1
            var alpha_milli = opm["alpha_milli"]
            if alpha_milli == nil { alpha_milli = opm["alpha"] }
            _opacity_milli = (_opacity_milli * alpha_milli) / 1000
        } else if op == "pop_opacity" {
            if opacity_depth <= 0 { return oren_err(4, "rasterize: opacity stack underflow") }
            opacity_depth = opacity_depth - 1
            var okey = oren_int_to_string(opacity_depth)
            _opacity_milli = opacity_stack[okey]
            opacity_stack[okey] = nil
        } else if op == "push_camera_ortho" {
            camera_stack[oren_int_to_string(camera_depth)] = [depth_enabled, near_z, far_z]
            camera_depth = camera_depth + 1
            depth_enabled = 1
            near_z = opm["near_z"]
            far_z = opm["far_z"]
        } else if op == "pop_camera" {
            if camera_depth <= 0 { return oren_err(4, "rasterize: camera stack underflow") }
            camera_depth = camera_depth - 1
            var dkey = oren_int_to_string(camera_depth)
            var dprev = camera_stack[dkey]
            depth_enabled = dprev[0]
            near_z = dprev[1]
            far_z = dprev[2]
            camera_stack[dkey] = nil
        } else if op == "fill_rect" {
            var c = ui_color.parse_hex(opm["color"])
            if oren_is_err(c) { return result.with_context(c, "rasterize: fill_rect color") }
            var rx = opm["x"]
            var ry = opm["y"]
            var rw = opm["w"]
            var rh = opm["h"]
            if rw == nil || rh == nil { return oren_err(4, "rasterize: fill_rect missing size") }
            var yy = 0
            while yy < rh {
                var xx = 0
                while xx < rw {
                    _set_px_rgba(buf, w, h, rx + xx, ry + yy, c["r"], c["g"], c["b"], c["a"])
                    xx = xx + 1
                }
                yy = yy + 1
            }
        } else if op == "stroke_line" {
            var lc = ui_color.parse_hex(opm["color"])
            if oren_is_err(lc) { return result.with_context(lc, "rasterize: stroke_line color") }
            var lw = opm["width"]
            if lw == nil { lw = 1 }
            _draw_line(buf, w, h, opm["x1"], opm["y1"], opm["x2"], opm["y2"], lw, lc)
        } else if op == "stroke_rect" {
            var sc = ui_color.parse_hex(opm["color"])
            if oren_is_err(sc) { return result.with_context(sc, "rasterize: stroke_rect color") }
            var slw = opm["width"]
            if slw == nil { slw = 1 }
            var sx = opm["x"]
            var sy = opm["y"]
            var sw = opm["w"]
            var sh = opm["h"]
            var si = 0
            while si < slw {
                _draw_line(buf, w, h, sx + si, sy + si, sx + sw - 1 - si, sy + si, 1, sc)
                _draw_line(buf, w, h, sx + si, sy + sh - 1 - si, sx + sw - 1 - si, sy + sh - 1 - si, 1, sc)
                _draw_line(buf, w, h, sx + si, sy + si, sx + si, sy + sh - 1 - si, 1, sc)
                _draw_line(buf, w, h, sx + sw - 1 - si, sy + si, sx + sw - 1 - si, sy + sh - 1 - si, 1, sc)
                si = si + 1
            }
        } else if op == "round_rect" {
            var rc = ui_color.parse_hex(opm["color"])
            if oren_is_err(rc) { return result.with_context(rc, "rasterize: round_rect color") }
            var rfill = opm["fill"]
            if rfill == nil { rfill = true }
            var rlw = opm["width"]
            if rlw == nil { rlw = 1 }
            _draw_round_rect(buf, w, h, opm["x"], opm["y"], opm["w"], opm["h"], opm["r"], rlw, rfill, rc)
        } else if op == "circle" {
            var cc = ui_color.parse_hex(opm["color"])
            if oren_is_err(cc) { return result.with_context(cc, "rasterize: circle color") }
            var fill = opm["fill"]
            if fill == nil { fill = true }
            _draw_circle(buf, w, h, opm["cx"], opm["cy"], opm["r"], fill, cc)
        } else if op == "ellipse" {
            var ec = ui_color.parse_hex(opm["color"])
            if oren_is_err(ec) { return result.with_context(ec, "rasterize: ellipse color") }
            var efill = opm["fill"]
            if efill == nil { efill = true }
            var elw = opm["width"]
            if elw == nil { elw = 1 }
            _draw_ellipse(buf, w, h, opm["x"], opm["y"], opm["w"], opm["h"], elw, efill, ec)
        } else if op == "polyline" {
            var pc = ui_color.parse_hex(opm["color"])
            if oren_is_err(pc) { return result.with_context(pc, "rasterize: polyline color") }
            var plw = opm["width"]
            if plw == nil { plw = 1 }
            var pr = _draw_polyline(buf, w, h, opm["points"], plw, pc)
            if oren_is_err(pr) { return result.with_context(pr, "rasterize: polyline") }
        } else if op == "fill_triangle" {
            var tc = ui_color.parse_hex(opm["color"])
            if oren_is_err(tc) { return result.with_context(tc, "rasterize: fill_triangle color") }
            _draw_fill_triangle(buf, w, h, opm["x1"], opm["y1"], opm["x2"], opm["y2"], opm["x3"], opm["y3"], tc)
        } else if op == "fill_triangles" {
            var btc = ui_color.parse_hex(opm["color"])
            if oren_is_err(btc) { return result.with_context(btc, "rasterize: fill_triangles color") }
            var btr = _draw_triangle_bytes(buf, w, h, opm["triangles"], btc, "rasterize: fill_triangles")
            if oren_is_err(btr) { return btr }
        } else if op == "mesh2d" {
            meshes[oren_int_to_string(opm["id"])] = opm
        } else if op == "draw_mesh2d" {
            var mesh2d = meshes[oren_int_to_string(opm["id"])]
            if mesh2d == nil { return oren_err(4, "rasterize: draw_mesh2d missing mesh") }
            var mc = ui_color.parse_hex(mesh2d["color"])
            if oren_is_err(mc) { return result.with_context(mc, "rasterize: mesh2d color") }
            var mr = _draw_triangle_bytes(buf, w, h, mesh2d["triangles"], mc, "rasterize: draw_mesh2d")
            if oren_is_err(mr) { return mr }
        } else if op == "destroy_mesh2d" {
            meshes[oren_int_to_string(opm["id"])] = nil
        } else if op == "mesh3d" {
            meshes[oren_int_to_string(opm["id"])] = opm
        } else if op == "mesh3d_rgba" {
            meshes[oren_int_to_string(opm["id"])] = opm
        } else if op == "mesh3d_indexed" {
            meshes[oren_int_to_string(opm["id"])] = opm
        } else if op == "material3d" {
            materials[oren_int_to_string(opm["id"])] = opm
        } else if op == "draw_mesh3d" {
            var mesh3d = meshes[oren_int_to_string(opm["id"])]
            var m3r = _draw_mesh3d_resource(buf, w, h, mesh3d, nil, "rasterize: draw_mesh3d", 0, 0, 0, 1000, depth_enabled, near_z, far_z)
            if oren_is_err(m3r) { return m3r }
        } else if op == "draw_mesh3d_at" {
            var mesh3da = meshes[oren_int_to_string(opm["id"])]
            var m3ar = _draw_mesh3d_resource(buf, w, h, mesh3da, nil, "rasterize: draw_mesh3d_at", opm["x"], opm["y"], opm["z"], opm["scale_milli"], depth_enabled, near_z, far_z)
            if oren_is_err(m3ar) { return m3ar }
        } else if op == "draw_mesh3d_material" {
            var mesh3dm = meshes[oren_int_to_string(opm["id"])]
            var mat3dm = materials[oren_int_to_string(opm["material_id"])]
            if mat3dm == nil { return oren_err(4, "rasterize: draw_mesh3d_material missing material") }
            var m3mr = _draw_mesh3d_resource(buf, w, h, mesh3dm, mat3dm, "rasterize: draw_mesh3d_material", 0, 0, 0, 1000, depth_enabled, near_z, far_z)
            if oren_is_err(m3mr) { return m3mr }
        } else if op == "draw_mesh3d_at_material" {
            var mesh3dam = meshes[oren_int_to_string(opm["id"])]
            var mat3dam = materials[oren_int_to_string(opm["material_id"])]
            if mat3dam == nil { return oren_err(4, "rasterize: draw_mesh3d_at_material missing material") }
            var m3amr = _draw_mesh3d_resource(buf, w, h, mesh3dam, mat3dam, "rasterize: draw_mesh3d_at_material", opm["x"], opm["y"], opm["z"], opm["scale_milli"], depth_enabled, near_z, far_z)
            if oren_is_err(m3amr) { return m3amr }
        } else if op == "model3d" {
            models[oren_int_to_string(opm["id"])] = opm
        } else if op == "draw_model3d" {
            var model3d = models[oren_int_to_string(opm["id"])]
            if model3d == nil { return oren_err(4, "rasterize: draw_model3d missing model") }
            var model_mesh = meshes[oren_int_to_string(model3d["mesh_id"])]
            var model_mat = nil
            var model_mat_id = model3d["material_id"]
            if model_mat_id != nil && model_mat_id != 0 {
                model_mat = materials[oren_int_to_string(model_mat_id)]
                if model_mat == nil { return oren_err(4, "rasterize: draw_model3d missing material") }
            }
            var modelr = _draw_mesh3d_resource(buf, w, h, model_mesh, model_mat, "rasterize: draw_model3d", model3d["x"], model3d["y"], model3d["z"], model3d["scale_milli"], depth_enabled, near_z, far_z)
            if oren_is_err(modelr) { return modelr }
        } else if op == "destroy_model3d" {
            models[oren_int_to_string(opm["id"])] = nil
        } else if op == "destroy_mesh3d" {
            meshes[oren_int_to_string(opm["id"])] = nil
        } else if op == "destroy_material3d" {
            materials[oren_int_to_string(opm["id"])] = nil
        } else if op == "text" {
            // Deterministic marker: draw 1 pixel per character in the string at y.
            var c2 = ui_color.parse_hex(opm["color"])
            if oren_is_err(c2) { return result.with_context(c2, "rasterize: text color") }
            var tx = opm["x"]
            var ty = opm["y"]
            var s = opm["text"]
            if s == nil { s = "" }
            var ln = oren_string_len(s)
            var j = 0
            while j < ln {
                _set_px_rgba(buf, w, h, tx + j, ty, c2["r"], c2["g"], c2["b"], c2["a"])
                j = j + 1
            }
        } else if op == "text_bytes" {
            // Deterministic marker: draw 1 pixel per byte at y.
            var c3 = ui_color.parse_hex(opm["color"])
            if oren_is_err(c3) { return result.with_context(c3, "rasterize: text_bytes color") }
            var bx = opm["x"]
            var by = opm["y"]
            var data = opm["data"]
            var bn = bytes.len(data)
            if oren_is_err(bn) { return result.with_context(bn, "rasterize: text_bytes data") }
            var bj = 0
            while bj < bn {
                _set_px_rgba(buf, w, h, bx + bj, by, c3["r"], c3["g"], c3["b"], c3["a"])
                bj = bj + 1
            }
        } else if op == "text_resource" {
            texts[oren_int_to_string(opm["id"])] = opm
        } else if op == "draw_text" {
            var text_resource = texts[oren_int_to_string(opm["id"])]
            if text_resource == nil { return oren_err(4, "rasterize: draw_text missing text") }
            var dtr = _draw_text_marker(buf, w, h, text_resource, opm["x"], opm["y"])
            if oren_is_err(dtr) { return dtr }
        } else if op == "draw_texts" {
            var batch_text_resource = texts[oren_int_to_string(opm["id"])]
            if batch_text_resource == nil { return oren_err(4, "rasterize: draw_texts missing text") }
            var positions = opm["positions"]
            var pos_len = bytes.len(positions)
            if oren_is_err(pos_len) { return result.with_context(pos_len, "rasterize: draw_texts positions") }
            var poff = 0
            while poff < pos_len {
                var px = bytes.get_u32_le(positions, poff)
                var py = bytes.get_u32_le(positions, poff + 4)
                if oren_is_err(px) || oren_is_err(py) { return oren_err(4, "rasterize: draw_texts malformed position") }
                var btr = _draw_text_marker(buf, w, h, batch_text_resource, px, py)
                if oren_is_err(btr) { return btr }
                poff = poff + 8
            }
        } else if op == "destroy_text" {
            texts[oren_int_to_string(opm["id"])] = nil
        } else if op == "image_rgba" {
            images[oren_int_to_string(opm["id"])] = opm
        } else if op == "draw_image" {
            var image = images[oren_int_to_string(opm["id"])]
            if image == nil { return oren_err(4, "rasterize: draw_image missing image") }
            var data = image["data"]
            var sx_w = image["w"]
            var sx_h = image["h"]
            var dx = opm["x"]
            var dy = opm["y"]
            var dw = opm["w"]
            var dh = opm["h"]
            var yy2 = 0
            while yy2 < dh {
                var xx2 = 0
                while xx2 < dw {
                    var sx = (xx2 * sx_w) / dw
                    var sy = (yy2 * sx_h) / dh
                    var si = (sy * sx_w + sx) * 4
                    _set_px_rgba(buf, w, h, dx + xx2, dy + yy2,
                        bytes.get_u8(data, si),
                        bytes.get_u8(data, si + 1),
                        bytes.get_u8(data, si + 2),
                        bytes.get_u8(data, si + 3))
                    xx2 = xx2 + 1
                }
                yy2 = yy2 + 1
            }
        } else if op == "destroy_image" {
            images[oren_int_to_string(opm["id"])] = nil
        } else if op == "draw_image_rect" {
            var rimage = images[oren_int_to_string(opm["id"])]
            if rimage == nil { return oren_err(4, "rasterize: draw_image_rect missing image") }
            var rdata = rimage["data"]
            var riw = rimage["w"]
            var rih = rimage["h"]
            var rsx = opm["sx"]
            var rsy = opm["sy"]
            var rsw = opm["sw"]
            var rsh = opm["sh"]
            if rsx + rsw > riw || rsy + rsh > rih { return oren_err(4, "rasterize: draw_image_rect source out of bounds") }
            var rdx = opm["x"]
            var rdy = opm["y"]
            var rdw = opm["w"]
            var rdh = opm["h"]
            var ryy = 0
            while ryy < rdh {
                var rxx = 0
                while rxx < rdw {
                    var srcx = rsx + (rxx * rsw) / rdw
                    var srcy = rsy + (ryy * rsh) / rdh
                    var rsi = (srcy * riw + srcx) * 4
                    _set_px_rgba(buf, w, h, rdx + rxx, rdy + ryy,
                        bytes.get_u8(rdata, rsi),
                        bytes.get_u8(rdata, rsi + 1),
                        bytes.get_u8(rdata, rsi + 2),
                        bytes.get_u8(rdata, rsi + 3))
                    rxx = rxx + 1
                }
                ryy = ryy + 1
            }
        } else if op == "draw_image_rects" {
            var bimage = images[oren_int_to_string(opm["id"])]
            if bimage == nil { return oren_err(4, "rasterize: draw_image_rects missing image") }
            var bdata = bimage["data"]
            var biw = bimage["w"]
            var bih = bimage["h"]
            var rects = opm["rects"]
            var rect_len = bytes.len(rects)
            if oren_is_err(rect_len) { return result.with_context(rect_len, "rasterize: draw_image_rects rects") }
            var roff = 0
            while roff < rect_len {
                var bsx = bytes.get_u32_le(rects, roff)
                var bsy = bytes.get_u32_le(rects, roff + 4)
                var bsw = bytes.get_u32_le(rects, roff + 8)
                var bsh = bytes.get_u32_le(rects, roff + 12)
                var bdx = bytes.get_u32_le(rects, roff + 16)
                var bdy = bytes.get_u32_le(rects, roff + 20)
                var bdw = bytes.get_u32_le(rects, roff + 24)
                var bdh = bytes.get_u32_le(rects, roff + 28)
                if bsx + bsw > biw || bsy + bsh > bih { return oren_err(4, "rasterize: draw_image_rects source out of bounds") }
                var byy = 0
                while byy < bdh {
                    var bxx = 0
                    while bxx < bdw {
                        var bsrcx = bsx + (bxx * bsw) / bdw
                        var bsrcy = bsy + (byy * bsh) / bdh
                        var bsi = (bsrcy * biw + bsrcx) * 4
                        _set_px_rgba(buf, w, h, bdx + bxx, bdy + byy,
                            bytes.get_u8(bdata, bsi),
                            bytes.get_u8(bdata, bsi + 1),
                            bytes.get_u8(bdata, bsi + 2),
                            bytes.get_u8(bdata, bsi + 3))
                        bxx = bxx + 1
                    }
                    byy = byy + 1
                }
                roff = roff + 32
            }
        }
        ci = ci + 1
    }

    return buf
}
