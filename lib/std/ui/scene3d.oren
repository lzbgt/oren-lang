// std:ui/scene3d (rolling)
//
// Small retained-3D scene helpers for the AVM UI command protocol.
//
// This module stays host-neutral: it returns ordinary `std:ui` command maps.
// `std:ui/avm` encodes them into OGF0 bytes and host SDK renderers map them to
// CoreGraphics/Metal. The v0 scene shape is intentionally simple so OBC packages
// can bundle scene metadata without depending on host objects.

import list "std:list"
import bytes "std:bytes"
import json "std:json"
import raw "std:buffer/raw"
import shapes "std:ui/scene3d_shapes"
import ui_color "std:ui/color"

fn _is_int(v) {
    if v == nil { return false }
    return oren_type_tag(v) == 1
}

fn mesh(id, triangles, color) {
    return {"op": "mesh3d", "id": id, "triangles": triangles, "color": color}
}

fn mesh_rgba(id, triangles) {
    return {"op": "mesh3d_rgba", "id": id, "triangles": triangles}
}

fn mesh_indexed(id, vertices, indices, color) {
    return {"op": "mesh3d_indexed", "id": id, "vertices": vertices, "indices": indices, "color": color}
}

fn material(id, color) {
    return {"op": "material3d", "id": id, "color": color}
}

fn model(id, mesh_id, material_id, x, y, z, scale_milli) {
    if material_id == nil { material_id = 0 }
    return {
        "op": "model3d",
        "id": id,
        "mesh_id": mesh_id,
        "material_id": material_id,
        "x": x,
        "y": y,
        "z": z,
        "scale_milli": scale_milli
    }
}

fn model_default(id, mesh_id) {
    return model(id, mesh_id, 0, 0, 0, 0, 1000)
}

fn draw_model(id) {
    return {"op": "draw_model3d", "id": id}
}

fn push_camera_ortho(near_z, far_z) {
    return {"op": "push_camera_ortho", "near_z": near_z, "far_z": far_z}
}

fn pop_camera() {
    return {"op": "pop_camera"}
}

fn destroy_model(id) {
    return {"op": "destroy_model3d", "id": id}
}

fn destroy_mesh(id) {
    return {"op": "destroy_mesh3d", "id": id}
}

fn destroy_material(id) {
    return {"op": "destroy_material3d", "id": id}
}

fn _push_all(out, xs) {
    if xs == nil { return 0 }
    var i = 0
    while i < oren_list_len(xs) {
        list.push(out, xs[i])
        i = i + 1
    }
    return 0
}

fn _push_draws(out, xs) {
    if xs == nil { return 0 }
    var i = 0
    while i < oren_list_len(xs) {
        var d = xs[i]
        if _is_int(d) {
            list.push(out, draw_model(d))
        } else {
            list.push(out, d)
        }
        i = i + 1
    }
    return 0
}

fn _push_camera(out, camera) {
    if camera == nil { return false }
    var near_z = camera["near_z"]
    var far_z = camera["far_z"]
    if near_z == nil || far_z == nil { return false }
    list.push(out, push_camera_ortho(near_z, far_z))
    return true
}

fn _push_destroy(out, xs, destroy_fn) {
    if xs == nil { return 0 }
    var i = oren_list_len(xs) - 1
    while i >= 0 {
        var item = xs[i]
        var id = item
        if _is_int(item) == false && item["id"] != nil { id = item["id"] }
        list.push(out, destroy_fn(id))
        i = i - 1
    }
    return 0
}

fn _pack_bytes(v, ctx) {
    if v == nil { return oren_err(4, ctx + ": missing byte array") }
    if oren_type_tag(v) == 6 { return bytes.pack(v) }
    var n = bytes.len(v)
    if oren_is_err(n) { return oren_err(4, ctx + ": expected byte array") }
    return v
}

fn _store_u32_le(out, off, v, ctx) {
    if _is_int(v) == false || v < 0 || v > 4294967295 {
        return oren_err(4, ctx + ": expected u32")
    }
    raw._store_u8_buf_unchecked_direct(out, off + 0, v % 256)
    raw._store_u8_buf_unchecked_direct(out, off + 1, (v / 256) % 256)
    raw._store_u8_buf_unchecked_direct(out, off + 2, (v / 65536) % 256)
    raw._store_u8_buf_unchecked_direct(out, off + 3, (v / 16777216) % 256)
    return 0
}

fn _store_i32_le(out, off, v, ctx) {
    if _is_int(v) == false || v < -2147483648 || v > 2147483647 {
        return oren_err(4, ctx + ": expected i32")
    }
    var u = v
    if u < 0 { u = u + 4294967296 }
    return _store_u32_le(out, off, u, ctx)
}

fn _store_xyz_values(out, off, x, y, z, ctx) {
    var rc = _store_i32_le(out, off + 0, x, ctx + ".x"); if oren_is_err(rc) { return rc }
    rc = _store_i32_le(out, off + 4, y, ctx + ".y"); if oren_is_err(rc) { return rc }
    return _store_i32_le(out, off + 8, z, ctx + ".z")
}

fn _pack_vertices_xyz(points, ctx) {
    if points == nil { return oren_err(4, ctx + ": missing vertices_xyz") }
    var np = oren_list_len(points)
    if oren_is_err(np) { return oren_err(4, ctx + ": vertices_xyz must be list") }
    var out = raw.u8_new_uninit(np * 12)
    if oren_is_err(out) { return out }
    var i = 0
    while i < np {
        var p = points[i]
        if p == nil || oren_list_len(p) != 3 { return oren_err(4, ctx + ": vertex must be [x,y,z]") }
        var off = i * 12
        var rc = _store_xyz_values(out, off, p[0], p[1], p[2], ctx)
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return bytes.from_u8_buf(out)
}

fn _pack_faces(faces, vertex_count, ctx) {
    if faces == nil { return oren_err(4, ctx + ": missing faces") }
    var nf = oren_list_len(faces)
    if oren_is_err(nf) { return oren_err(4, ctx + ": faces must be list") }
    var out = raw.u8_new_uninit(nf * 12)
    if oren_is_err(out) { return out }
    var i = 0
    while i < nf {
        var f = faces[i]
        if f == nil || oren_list_len(f) != 3 { return oren_err(4, ctx + ": face must be [a,b,c]") }
        if _is_int(f[0]) == false || _is_int(f[1]) == false || _is_int(f[2]) == false {
            return oren_err(4, ctx + ": face index not int")
        }
        if vertex_count >= 0 {
            if f[0] >= vertex_count || f[1] >= vertex_count || f[2] >= vertex_count {
                return oren_err(4, ctx + ": face index out of bounds")
            }
        }
        var off = i * 12
        var rc = _store_u32_le(out, off + 0, f[0], ctx + ".a"); if oren_is_err(rc) { return rc }
        rc = _store_u32_le(out, off + 4, f[1], ctx + ".b"); if oren_is_err(rc) { return rc }
        rc = _store_u32_le(out, off + 8, f[2], ctx + ".c"); if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return bytes.from_u8_buf(out)
}

fn _pack_quads(quads, vertex_count, ctx) {
    if quads == nil { return oren_err(4, ctx + ": missing quads") }
    var nq = oren_list_len(quads)
    if oren_is_err(nq) { return oren_err(4, ctx + ": quads must be list") }
    var out = raw.u8_new_uninit(nq * 24)
    if oren_is_err(out) { return out }
    var i = 0
    while i < nq {
        var q = quads[i]
        if q == nil || oren_list_len(q) != 4 { return oren_err(4, ctx + ": quad must be [a,b,c,d]") }
        var j = 0
        while j < 4 {
            if _is_int(q[j]) == false {
                return oren_err(4, ctx + ": quad index not int")
            }
            if q[j] < 0 || q[j] >= vertex_count {
                return oren_err(4, ctx + ": quad index out of bounds")
            }
            j = j + 1
        }
        var off = i * 24
        var rc = _store_u32_le(out, off + 0, q[0], ctx + ".a"); if oren_is_err(rc) { return rc }
        rc = _store_u32_le(out, off + 4, q[1], ctx + ".b"); if oren_is_err(rc) { return rc }
        rc = _store_u32_le(out, off + 8, q[2], ctx + ".c"); if oren_is_err(rc) { return rc }
        rc = _store_u32_le(out, off + 12, q[0], ctx + ".a"); if oren_is_err(rc) { return rc }
        rc = _store_u32_le(out, off + 16, q[2], ctx + ".c"); if oren_is_err(rc) { return rc }
        rc = _store_u32_le(out, off + 20, q[3], ctx + ".d"); if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return bytes.from_u8_buf(out)
}

fn _vertex_count_from_bytes(vertices, ctx) {
    var n = bytes.len(vertices)
    if oren_is_err(n) { return oren_err(4, ctx + ": expected vertex bytes") }
    if n % 12 != 0 { return oren_err(4, ctx + ": vertex byte length must be multiple of 12") }
    return n / 12
}

fn _position_axis(m, axis) {
    var pos = m["position_xyz"]
    var transform = m["transform"]
    if pos == nil && transform != nil { pos = transform["position_xyz"] }
    if pos == nil { return nil }
    if oren_list_len(pos) != 3 { return oren_err(4, "ui.scene3d: position_xyz must be [x,y,z]") }
    return pos[axis]
}

fn _scale_milli(m, fallback, ctx) {
    var v = m["scale_milli"]
    var transform = m["transform"]
    if v == nil && transform != nil { v = transform["scale_milli"] }
    if v == nil { return fallback }
    if _is_int(v) == false || v <= 0 { return oren_err(4, ctx + ": invalid scale_milli") }
    return v
}

fn _pack_triangles_xyz(triangles, ctx) {
    if triangles == nil { return oren_err(4, ctx + ": missing triangles_xyz") }
    var nt = oren_list_len(triangles)
    if oren_is_err(nt) { return oren_err(4, ctx + ": triangles_xyz must be list") }
    var out = raw.u8_new_uninit(nt * 36)
    if oren_is_err(out) { return out }
    var i = 0
    while i < nt {
        var tri = triangles[i]
        if tri == nil || oren_list_len(tri) != 3 { return oren_err(4, ctx + ": triangle must have 3 vertices") }
        var j = 0
        while j < 3 {
            var p = tri[j]
            if p == nil || oren_list_len(p) != 3 { return oren_err(4, ctx + ": triangle vertex must be [x,y,z]") }
            var off = i * 36 + j * 12
            var rc = _store_i32_le(out, off + 0, p[0], ctx + ".x"); if oren_is_err(rc) { return rc }
            rc = _store_i32_le(out, off + 4, p[1], ctx + ".y"); if oren_is_err(rc) { return rc }
            rc = _store_i32_le(out, off + 8, p[2], ctx + ".z"); if oren_is_err(rc) { return rc }
            j = j + 1
        }
        i = i + 1
    }
    return bytes.from_u8_buf(out)
}

fn _store_point_xyz(out, off, p, ctx) {
    if p == nil || oren_list_len(p) != 3 { return oren_err(4, ctx + ": vertex must be [x,y,z]") }
    return _store_xyz_values(out, off, p[0], p[1], p[2], ctx)
}

fn _pack_quads_xyz(quads, ctx) {
    if quads == nil { return oren_err(4, ctx + ": missing quads_xyz") }
    var nq = oren_list_len(quads)
    if oren_is_err(nq) { return oren_err(4, ctx + ": quads_xyz must be list") }
    var out = raw.u8_new_uninit(nq * 72)
    if oren_is_err(out) { return out }
    var i = 0
    while i < nq {
        var q = quads[i]
        if q == nil || oren_list_len(q) != 4 { return oren_err(4, ctx + ": quad must have 4 vertices") }
        var off = i * 72
        var rc = _store_point_xyz(out, off + 0, q[0], ctx + ".a"); if oren_is_err(rc) { return rc }
        rc = _store_point_xyz(out, off + 12, q[1], ctx + ".b"); if oren_is_err(rc) { return rc }
        rc = _store_point_xyz(out, off + 24, q[2], ctx + ".c"); if oren_is_err(rc) { return rc }
        rc = _store_point_xyz(out, off + 36, q[0], ctx + ".a"); if oren_is_err(rc) { return rc }
        rc = _store_point_xyz(out, off + 48, q[2], ctx + ".c"); if oren_is_err(rc) { return rc }
        rc = _store_point_xyz(out, off + 60, q[3], ctx + ".d"); if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return bytes.from_u8_buf(out)
}

fn _store_box_triangle(out, off, ax, ay, az, bx, by, bz, cx, cy, cz, ctx) {
    var rc = _store_xyz_values(out, off + 0, ax, ay, az, ctx + ".a")
    if oren_is_err(rc) { return rc }
    rc = _store_xyz_values(out, off + 12, bx, by, bz, ctx + ".b")
    if oren_is_err(rc) { return rc }
    return _store_xyz_values(out, off + 24, cx, cy, cz, ctx + ".c")
}

fn _pack_boxes_xyz(boxes, ctx) {
    if boxes == nil { return oren_err(4, ctx + ": missing boxes_xyz") }
    var nb = oren_list_len(boxes)
    if oren_is_err(nb) { return oren_err(4, ctx + ": boxes_xyz must be list") }
    var out = raw.u8_new_uninit(nb * 432)
    if oren_is_err(out) { return out }
    var i = 0
    while i < nb {
        var box = boxes[i]
        if box == nil { return oren_err(4, ctx + ": box must be object") }
        var lo = box["min"]
        if lo == nil { lo = box["min_xyz"] }
        var hi = box["max"]
        if hi == nil { hi = box["max_xyz"] }
        if lo == nil || hi == nil {
            return oren_err(4, ctx + ": box must include min/max")
        }
        if oren_list_len(lo) != 3 || oren_list_len(hi) != 3 {
            return oren_err(4, ctx + ": box min/max must be [x,y,z]")
        }
        var x0 = lo[0]; var y0 = lo[1]; var z0 = lo[2]
        var x1 = hi[0]; var y1 = hi[1]; var z1 = hi[2]
        if _is_int(x0) == false || _is_int(y0) == false || _is_int(z0) == false ||
           _is_int(x1) == false || _is_int(y1) == false || _is_int(z1) == false {
            return oren_err(4, ctx + ": box min/max must be i32")
        }
        if x1 <= x0 || y1 <= y0 || z1 <= z0 {
            return oren_err(4, ctx + ": box max must be greater than min")
        }
        var off = i * 432
        var rc = _store_box_triangle(out, off + 0, x0, y0, z0, x1, y0, z0, x1, y1, z0, ctx + ".front0")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 36, x0, y0, z0, x1, y1, z0, x0, y1, z0, ctx + ".front1")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 72, x0, y0, z1, x1, y1, z1, x1, y0, z1, ctx + ".back0")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 108, x0, y0, z1, x0, y1, z1, x1, y1, z1, ctx + ".back1")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 144, x0, y0, z0, x0, y1, z0, x0, y1, z1, ctx + ".left0")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 180, x0, y0, z0, x0, y1, z1, x0, y0, z1, ctx + ".left1")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 216, x1, y0, z0, x1, y0, z1, x1, y1, z1, ctx + ".right0")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 252, x1, y0, z0, x1, y1, z1, x1, y1, z0, ctx + ".right1")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 288, x0, y1, z0, x1, y1, z0, x1, y1, z1, ctx + ".top0")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 324, x0, y1, z0, x1, y1, z1, x0, y1, z1, ctx + ".top1")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 360, x0, y0, z0, x0, y0, z1, x1, y0, z1, ctx + ".bottom0")
        if oren_is_err(rc) { return rc }
        rc = _store_box_triangle(out, off + 396, x0, y0, z0, x1, y0, z1, x1, y0, z0, ctx + ".bottom1")
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return bytes.from_u8_buf(out)
}

fn _prism_points(prism) {
    var points = prism["points"]
    if points == nil { points = prism["points_xy"] }
    return points
}

fn _prism_z(prism, primary, fallback, ctx) {
    var v = prism[primary]
    if v == nil { v = prism[fallback] }
    if _is_int(v) == false { return oren_err(4, ctx + ": expected i32") }
    return v
}

fn _validate_xy_point(p, ctx) {
    if p == nil || oren_list_len(p) != 2 { return oren_err(4, ctx + ": point must be [x,y]") }
    if _is_int(p[0]) == false || _is_int(p[1]) == false {
        return oren_err(4, ctx + ": point must contain i32")
    }
    return 0
}

fn _prisms_triangle_count(prisms, ctx) {
    if prisms == nil { return oren_err(4, ctx + ": missing prisms_xy") }
    var np = oren_list_len(prisms)
    if oren_is_err(np) { return oren_err(4, ctx + ": prisms_xy must be list") }
    var total = 0
    var i = 0
    while i < np {
        var prism = prisms[i]
        if prism == nil { return oren_err(4, ctx + ": prism must be object") }
        var points = _prism_points(prism)
        var n = oren_list_len(points)
        if oren_is_err(n) || n < 3 { return oren_err(4, ctx + ": prism points must contain at least 3 [x,y] entries") }
        var z0 = _prism_z(prism, "z_min", "min_z", ctx + ".z_min")
        if oren_is_err(z0) { return z0 }
        var z1 = _prism_z(prism, "z_max", "max_z", ctx + ".z_max")
        if oren_is_err(z1) { return z1 }
        if z1 <= z0 { return oren_err(4, ctx + ": prism z_max must be greater than z_min") }
        var j = 0
        while j < n {
            var rc = _validate_xy_point(points[j], ctx + ".point")
            if oren_is_err(rc) { return rc }
            j = j + 1
        }
        total = total + n * 4 - 4
        i = i + 1
    }
    return total
}

fn _store_prism_point(out, off, p, z, ctx) {
    return _store_xyz_values(out, off, p[0], p[1], z, ctx)
}

fn _store_prism_triangle(out, off, a, za, b, zb, c, zc, ctx) {
    var rc = _store_prism_point(out, off + 0, a, za, ctx + ".a")
    if oren_is_err(rc) { return rc }
    rc = _store_prism_point(out, off + 12, b, zb, ctx + ".b")
    if oren_is_err(rc) { return rc }
    return _store_prism_point(out, off + 24, c, zc, ctx + ".c")
}

fn _pack_prisms_xy(prisms, ctx) {
    var tri_count = _prisms_triangle_count(prisms, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var pi = 0
    var np = oren_list_len(prisms)
    while pi < np {
        var prism = prisms[pi]
        var points = _prism_points(prism)
        var n = oren_list_len(points)
        var z0 = _prism_z(prism, "z_min", "min_z", ctx + ".z_min")
        var z1 = _prism_z(prism, "z_max", "max_z", ctx + ".z_max")
        var p0 = points[0]
        var i = 1
        while i < n - 1 {
            var rc = _store_prism_triangle(out, off, p0, z0, points[i + 1], z0, points[i], z0, ctx + ".bottom")
            if oren_is_err(rc) { return rc }
            off = off + 36
            rc = _store_prism_triangle(out, off, p0, z1, points[i], z1, points[i + 1], z1, ctx + ".top")
            if oren_is_err(rc) { return rc }
            off = off + 36
            i = i + 1
        }
        i = 0
        while i < n {
            var next = i + 1
            if next == n { next = 0 }
            var a = points[i]
            var b = points[next]
            var rc2 = _store_prism_triangle(out, off, a, z0, b, z0, b, z1, ctx + ".side0")
            if oren_is_err(rc2) { return rc2 }
            off = off + 36
            rc2 = _store_prism_triangle(out, off, a, z0, b, z1, a, z1, ctx + ".side1")
            if oren_is_err(rc2) { return rc2 }
            off = off + 36
            i = i + 1
        }
        pi = pi + 1
    }
    return bytes.from_u8_buf(out)
}

fn _store_rgba(out, off, color, ctx) {
    var c = ui_color.parse_hex(color)
    if oren_is_err(c) { return oren_err(4, ctx + ": invalid color") }
    raw._store_u8_buf_unchecked_direct(out, off + 0, c["r"])
    raw._store_u8_buf_unchecked_direct(out, off + 1, c["g"])
    raw._store_u8_buf_unchecked_direct(out, off + 2, c["b"])
    raw._store_u8_buf_unchecked_direct(out, off + 3, c["a"])
    return 0
}

fn _pack_triangles_xyz_rgba(triangles, ctx) {
    if triangles == nil { return oren_err(4, ctx + ": missing triangles_xyz_rgba") }
    var nt = oren_list_len(triangles)
    if oren_is_err(nt) { return oren_err(4, ctx + ": triangles_xyz_rgba must be list") }
    var out = raw.u8_new_uninit(nt * 40)
    if oren_is_err(out) { return out }
    var i = 0
    while i < nt {
        var tri = triangles[i]
        var verts = tri["vertices"]
        var color = tri["color"]
        if verts == nil || color == nil { return oren_err(4, ctx + ": triangle must have vertices and color") }
        if oren_list_len(verts) != 3 { return oren_err(4, ctx + ": triangle must have 3 vertices") }
        var j = 0
        while j < 3 {
            var p = verts[j]
            if p == nil || oren_list_len(p) != 3 { return oren_err(4, ctx + ": triangle vertex must be [x,y,z]") }
            var off = i * 40 + j * 12
            var rc = _store_i32_le(out, off + 0, p[0], ctx + ".x"); if oren_is_err(rc) { return rc }
            rc = _store_i32_le(out, off + 4, p[1], ctx + ".y"); if oren_is_err(rc) { return rc }
            rc = _store_i32_le(out, off + 8, p[2], ctx + ".z"); if oren_is_err(rc) { return rc }
            j = j + 1
        }
        var cr = _store_rgba(out, i * 40 + 36, color, ctx + ".color")
        if oren_is_err(cr) { return cr }
        i = i + 1
    }
    return bytes.from_u8_buf(out)
}

fn _asset_mesh(m) {
    if m == nil { return oren_err(4, "ui.scene3d: mesh is nil") }
    var id = m["id"]
    var kind = m["kind"]
    if kind == nil { kind = "triangles" }
    if kind == "triangles" {
        var tris = nil
        if m["triangles_xyz"] != nil {
            tris = _pack_triangles_xyz(m["triangles_xyz"], "ui.scene3d mesh.triangles_xyz")
        } else if m["quads_xyz"] != nil {
            tris = _pack_quads_xyz(m["quads_xyz"], "ui.scene3d mesh.quads_xyz")
        } else if m["boxes_xyz"] != nil {
            tris = _pack_boxes_xyz(m["boxes_xyz"], "ui.scene3d mesh.boxes_xyz")
        } else if m["prisms_xy"] != nil {
            tris = _pack_prisms_xy(m["prisms_xy"], "ui.scene3d mesh.prisms_xy")
        } else if m["cylinders_z"] != nil {
            tris = shapes.pack_cylinders_z(m["cylinders_z"], "ui.scene3d mesh.cylinders_z")
        } else if m["cones_z"] != nil {
            tris = shapes.pack_cones_z(m["cones_z"], "ui.scene3d mesh.cones_z")
        } else if m["spheres_xyz"] != nil {
            tris = shapes.pack_spheres_xyz(m["spheres_xyz"], "ui.scene3d mesh.spheres_xyz")
        } else if m["ellipsoids_xyz"] != nil {
            tris = shapes.pack_ellipsoids_xyz(m["ellipsoids_xyz"], "ui.scene3d mesh.ellipsoids_xyz")
        } else if m["toruses_xyz"] != nil {
            tris = shapes.pack_toruses_xyz(m["toruses_xyz"], "ui.scene3d mesh.toruses_xyz")
        } else if m["capsules_z"] != nil {
            tris = shapes.pack_capsules_z(m["capsules_z"], "ui.scene3d mesh.capsules_z")
        } else {
            tris = _pack_bytes(m["triangles"], "ui.scene3d mesh.triangles")
        }
        if oren_is_err(tris) { return tris }
        var tri_color = _asset_color(m, "ui.scene3d mesh")
        if oren_is_err(tri_color) { return tri_color }
        return mesh(id, tris, tri_color)
    }
    if kind == "triangles_rgba" {
        var tris_rgba = nil
        if m["triangles_xyz_rgba"] != nil {
            tris_rgba = _pack_triangles_xyz_rgba(m["triangles_xyz_rgba"], "ui.scene3d mesh.triangles_xyz_rgba")
        } else {
            tris_rgba = _pack_bytes(m["triangles"], "ui.scene3d mesh.triangles_rgba")
        }
        if oren_is_err(tris_rgba) { return tris_rgba }
        return mesh_rgba(id, tris_rgba)
    }
    if kind == "indexed" {
        var vertices = nil
        var vertex_count = -1
        if m["vertices_xyz"] != nil {
            vertices = _pack_vertices_xyz(m["vertices_xyz"], "ui.scene3d mesh.vertices_xyz")
            vertex_count = oren_list_len(m["vertices_xyz"])
        } else {
            vertices = _pack_bytes(m["vertices"], "ui.scene3d mesh.vertices")
        }
        if oren_is_err(vertices) { return vertices }
        if vertex_count < 0 {
            vertex_count = _vertex_count_from_bytes(vertices, "ui.scene3d mesh.vertices")
            if oren_is_err(vertex_count) { return vertex_count }
        }
        var indices = nil
        if m["faces"] != nil {
            indices = _pack_faces(m["faces"], vertex_count, "ui.scene3d mesh.faces")
        } else if m["quads"] != nil {
            indices = _pack_quads(m["quads"], vertex_count, "ui.scene3d mesh.quads")
        } else {
            indices = _pack_bytes(m["indices"], "ui.scene3d mesh.indices")
        }
        if oren_is_err(indices) { return indices }
        var indexed_color = _asset_color(m, "ui.scene3d mesh")
        if oren_is_err(indexed_color) { return indexed_color }
        return mesh_indexed(id, vertices, indices, indexed_color)
    }
    return oren_err(4, "ui.scene3d: unsupported mesh kind")
}

fn _index_names(xs) {
    var out = {}
    if xs == nil { return out }
    var i = 0
    while i < oren_list_len(xs) {
        var item = xs[i]
        if item != nil {
            var name = item["name"]
            var id = item["id"]
            if name != nil && id != nil { oren_map_set_str(out, name, id) }
        }
        i = i + 1
    }
    return out
}

fn _resolve_named_id(m, id_key, name_key, names, fallback) {
    var id = m[id_key]
    if id != nil { return id }
    var name = m[name_key]
    if name == nil { return fallback }
    var resolved = oren_map_get_str(names, name)
    if resolved == nil { return oren_err(4, "ui.scene3d: unknown " + name_key) }
    return resolved
}

fn _asset_model(m, mesh_names, material_names) {
    if m == nil { return oren_err(4, "ui.scene3d: model is nil") }
    var mesh_id = _resolve_named_id(m, "mesh_id", "mesh", mesh_names, nil)
    if oren_is_err(mesh_id) { return mesh_id }
    var material_id = _resolve_named_id(m, "material_id", "material", material_names, 0)
    if oren_is_err(material_id) { return material_id }
    var x = m["x"]; if x == nil { x = 0 }
    var y = m["y"]; if y == nil { y = 0 }
    var z = m["z"]; if z == nil { z = 0 }
    var px = _position_axis(m, 0); if oren_is_err(px) { return px }
    var py = _position_axis(m, 1); if oren_is_err(py) { return py }
    var pz = _position_axis(m, 2); if oren_is_err(pz) { return pz }
    if px != nil { x = px }
    if py != nil { y = py }
    if pz != nil { z = pz }
    var scale_milli = _scale_milli(m, 1000, "ui.scene3d model")
    if oren_is_err(scale_milli) { return scale_milli }
    var out = model(m["id"], mesh_id, material_id, x, y, z, scale_milli)
    if m["name"] != nil { oren_map_set_str(out, "name", m["name"]) }
    return out
}

fn _asset_instance(inst, templates, mesh_names, material_names) {
    if inst == nil { return oren_err(4, "ui.scene3d: instance is nil") }
    var template_name = inst["template"]
    var tpl = nil
    if template_name != nil { tpl = oren_map_get_str(templates, template_name) }
    if template_name != nil && tpl == nil { return oren_err(4, "ui.scene3d: unknown template") }
    if tpl == nil { tpl = {} }
    var m = {}
    var id = inst["id"]; if id == nil { id = tpl["id"] }
    var name = inst["name"]; if name == nil { name = tpl["name"] }
    var mesh_id = inst["mesh_id"]; if mesh_id == nil { mesh_id = tpl["mesh_id"] }
    var mesh_name = inst["mesh"]; if mesh_name == nil { mesh_name = tpl["mesh"] }
    var material_id = inst["material_id"]; if material_id == nil { material_id = tpl["material_id"] }
    var material_name = inst["material"]; if material_name == nil { material_name = tpl["material"] }
    var position = inst["position_xyz"]; if position == nil { position = tpl["position_xyz"] }
    var transform = inst["transform"]; if transform == nil { transform = tpl["transform"] }
    var x = inst["x"]; if x == nil { x = tpl["x"] }
    var y = inst["y"]; if y == nil { y = tpl["y"] }
    var z = inst["z"]; if z == nil { z = tpl["z"] }
    var scale_milli = inst["scale_milli"]; if scale_milli == nil { scale_milli = tpl["scale_milli"] }
    oren_map_set_str(m, "id", id)
    if name != nil { oren_map_set_str(m, "name", name) }
    if mesh_id != nil { oren_map_set_str(m, "mesh_id", mesh_id) }
    if mesh_name != nil { oren_map_set_str(m, "mesh", mesh_name) }
    if material_id != nil { oren_map_set_str(m, "material_id", material_id) }
    if material_name != nil { oren_map_set_str(m, "material", material_name) }
    if position != nil { oren_map_set_str(m, "position_xyz", position) }
    if transform != nil { oren_map_set_str(m, "transform", transform) }
    if x != nil { oren_map_set_str(m, "x", x) }
    if y != nil { oren_map_set_str(m, "y", y) }
    if z != nil { oren_map_set_str(m, "z", z) }
    if scale_milli != nil { oren_map_set_str(m, "scale_milli", scale_milli) }
    return _asset_model(m, mesh_names, material_names)
}

fn _compose_group_model(m, gx, gy, gz, gscale, ctx) {
    var x = m["x"]
    var y = m["y"]
    var z = m["z"]
    var scale = m["scale_milli"]
    if _is_int(x) == false || _is_int(y) == false || _is_int(z) == false || _is_int(scale) == false {
        return oren_err(4, ctx + ": model transform must be integer")
    }
    var out_scale = (scale * gscale) / 1000
    if out_scale <= 0 { return oren_err(4, ctx + ": composed scale_milli must be positive") }
    oren_map_set_str(m, "x", gx + (x * gscale) / 1000)
    oren_map_set_str(m, "y", gy + (y * gscale) / 1000)
    oren_map_set_str(m, "z", gz + (z * gscale) / 1000)
    oren_map_set_str(m, "scale_milli", out_scale)
    return m
}

fn _keyframe_time(k, ctx) {
    var t = k["time_milli"]
    if _is_int(t) == false || t < 0 { return oren_err(4, ctx + ": invalid time_milli") }
    return t
}

fn _key_axis(k, axis, key, fallback, ctx) {
    var pos = k["position_xyz"]
    var transform = k["transform"]
    if pos == nil && transform != nil { pos = transform["position_xyz"] }
    if pos != nil {
        if oren_list_len(pos) != 3 { return oren_err(4, ctx + ": position_xyz must be [x,y,z]") }
        return pos[axis]
    }
    var v = k[key]
    if v == nil { return fallback }
    if _is_int(v) == false { return oren_err(4, ctx + ": expected int " + key) }
    return v
}

fn _key_scale(k, fallback, ctx) {
    var v = k["scale_milli"]
    var transform = k["transform"]
    if v == nil && transform != nil { v = transform["scale_milli"] }
    if v == nil { return fallback }
    if _is_int(v) == false || v <= 0 { return oren_err(4, ctx + ": invalid scale_milli") }
    return v
}

fn _lerp_int(a, b, num, den) {
    if den <= 0 { return a }
    return a + ((b - a) * num) / den
}

fn _sample_keyframes(kfs, time_milli, model, ctx) {
    if kfs == nil || oren_list_len(kfs) == 0 { return oren_err(4, ctx + ": missing keyframes") }
    if _is_int(time_milli) == false || time_milli < 0 { return oren_err(4, ctx + ": invalid sample time") }
    var prev = nil; var prev_t = -1
    var next = nil; var next_t = -1
    var i = 0
    while i < oren_list_len(kfs) {
        var k = kfs[i]
        if k == nil { return oren_err(4, ctx + ": keyframe is nil") }
        var kt = _keyframe_time(k, ctx)
        if oren_is_err(kt) { return kt }
        if kt <= time_milli {
            if prev == nil || kt >= prev_t { prev = k; prev_t = kt }
        }
        if kt >= time_milli {
            if next == nil || kt <= next_t { next = k; next_t = kt }
        }
        i = i + 1
    }
    if prev == nil { prev = next; prev_t = next_t }
    if next == nil { next = prev; next_t = prev_t }
    var base_x = model["x"]; var base_y = model["y"]; var base_z = model["z"]; var base_s = model["scale_milli"]
    var ax = _key_axis(prev, 0, "x", base_x, ctx); if oren_is_err(ax) { return ax }
    var ay = _key_axis(prev, 1, "y", base_y, ctx); if oren_is_err(ay) { return ay }
    var az = _key_axis(prev, 2, "z", base_z, ctx); if oren_is_err(az) { return az }
    var a_scale = _key_scale(prev, base_s, ctx); if oren_is_err(a_scale) { return a_scale }
    var bx = _key_axis(next, 0, "x", ax, ctx); if oren_is_err(bx) { return bx }
    var by = _key_axis(next, 1, "y", ay, ctx); if oren_is_err(by) { return by }
    var bz = _key_axis(next, 2, "z", az, ctx); if oren_is_err(bz) { return bz }
    var b_scale = _key_scale(next, a_scale, ctx); if oren_is_err(b_scale) { return b_scale }
    var den = next_t - prev_t
    var num = time_milli - prev_t
    return {
        "x": _lerp_int(ax, bx, num, den),
        "y": _lerp_int(ay, by, num, den),
        "z": _lerp_int(az, bz, num, den),
        "scale_milli": _lerp_int(a_scale, b_scale, num, den)
    }
}

fn _find_model(models, target, target_id) {
    var i = 0
    while i < oren_list_len(models) {
        var m = models[i]
        if target_id != nil && m["id"] == target_id { return m }
        if target != nil && m["name"] == target { return m }
        i = i + 1
    }
    return nil
}

fn _max_model_id(models) {
    var out = 0
    var i = 0
    while i < oren_list_len(models) {
        var m = models[i]
        if m != nil && m["id"] != nil && m["id"] > out { out = m["id"] }
        i = i + 1
    }
    return out
}

fn _draw_model_override(d, models, model_names, mesh_names, material_names, generated_id) {
    var target = d["model"]
    var target_id = d["model_id"]
    var base = _find_model(models, target, target_id)
    if (target != nil || target_id != nil) && base == nil { return oren_err(4, "ui.scene3d: unknown draw model") }
    var mesh_id = _resolve_named_id(d, "mesh_id", "mesh", mesh_names, nil)
    if oren_is_err(mesh_id) { return mesh_id }
    var material_id = _resolve_named_id(d, "material_id", "material", material_names, nil)
    if oren_is_err(material_id) { return material_id }
    var x = d["x"]; var y = d["y"]; var z = d["z"]; var scale = d["scale_milli"]
    if base != nil {
        if mesh_id == nil { mesh_id = base["mesh_id"] }
        if material_id == nil { material_id = base["material_id"] }
        if x == nil { x = base["x"] }
        if y == nil { y = base["y"] }
        if z == nil { z = base["z"] }
        if scale == nil { scale = base["scale_milli"] }
    }
    if mesh_id == nil { return oren_err(4, "ui.scene3d: draw object missing mesh/model") }
    if material_id == nil { material_id = 0 }
    if x == nil { x = 0 }
    if y == nil { y = 0 }
    if z == nil { z = 0 }
    var px = _position_axis(d, 0); if oren_is_err(px) { return px }
    var py = _position_axis(d, 1); if oren_is_err(py) { return py }
    var pz = _position_axis(d, 2); if oren_is_err(pz) { return pz }
    if px != nil { x = px }
    if py != nil { y = py }
    if pz != nil { z = pz }
    scale = _scale_milli(d, scale, "ui.scene3d draw")
    if oren_is_err(scale) { return scale }
    var id = d["id"]
    if id == nil { id = generated_id }
    var out = model(id, mesh_id, material_id, x, y, z, scale)
    if d["name"] != nil { oren_map_set_str(out, "name", d["name"]) }
    return out
}

fn _apply_animations(models, animations, time_milli) {
    if animations == nil { return 0 }
    var i = 0
    while i < oren_list_len(animations) {
        var a = animations[i]
        if a == nil { return oren_err(4, "ui.scene3d: animation is nil") }
        var target = a["target"]
        var target_id = a["target_id"]
        var m = _find_model(models, target, target_id)
        if m == nil { return oren_err(4, "ui.scene3d: animation target missing") }
        var sample = _sample_keyframes(a["keyframes"], time_milli, m, "ui.scene3d animation")
        if oren_is_err(sample) { return sample }
        oren_map_set_str(m, "x", sample["x"])
        oren_map_set_str(m, "y", sample["y"])
        oren_map_set_str(m, "z", sample["z"])
        oren_map_set_str(m, "scale_milli", sample["scale_milli"])
        i = i + 1
    }
    return 0
}

fn _map_list(xs, map_fn) {
    var out = []
    if xs == nil { return out }
    var i = 0
    while i < oren_list_len(xs) {
        var item = map_fn(xs[i])
        if oren_is_err(item) { return item }
        list.push(out, item)
        i = i + 1
    }
    return out
}

fn _push_asset_models(out, xs, mesh_names, material_names) {
    if xs == nil { return 0 }
    var i = 0
    while i < oren_list_len(xs) {
        var item = _asset_model(xs[i], mesh_names, material_names)
        if oren_is_err(item) { return item }
        list.push(out, item)
        i = i + 1
    }
    return 0
}

fn _push_asset_instances(out, xs, templates, mesh_names, material_names) {
    if xs == nil { return 0 }
    var i = 0
    while i < oren_list_len(xs) {
        var item = _asset_instance(xs[i], templates, mesh_names, material_names)
        if oren_is_err(item) { return item }
        list.push(out, item)
        i = i + 1
    }
    return 0
}

fn _push_asset_instance_groups(out, groups, templates, mesh_names, material_names) {
    if groups == nil { return 0 }
    var gi = 0
    while gi < oren_list_len(groups) {
        var g = groups[gi]
        if g == nil { return oren_err(4, "ui.scene3d: instance_group is nil") }
        var gx = _position_axis(g, 0); if oren_is_err(gx) { return gx }
        var gy = _position_axis(g, 1); if oren_is_err(gy) { return gy }
        var gz = _position_axis(g, 2); if oren_is_err(gz) { return gz }
        if gx == nil { gx = 0 }
        if gy == nil { gy = 0 }
        if gz == nil { gz = 0 }
        var gscale = _scale_milli(g, 1000, "ui.scene3d instance_group")
        if oren_is_err(gscale) { return gscale }
        var xs = g["instances"]
        if xs == nil { return oren_err(4, "ui.scene3d: instance_group missing instances") }
        var i = 0
        while i < oren_list_len(xs) {
            var item = _asset_instance(xs[i], templates, mesh_names, material_names)
            if oren_is_err(item) { return item }
            item = _compose_group_model(item, gx, gy, gz, gscale, "ui.scene3d instance_group")
            if oren_is_err(item) { return item }
            list.push(out, item)
            i = i + 1
        }
        gi = gi + 1
    }
    return 0
}

fn _json_to_plain(jv) {
    if jv == nil { return nil }
    var t = jv["t"]
    if t == "null" { return nil }
    if t == "bool" { return jv["b"] != 0 }
    if t == "int" { return jv["i"] }
    if t == "string" { return jv["s"] }
    if t == "array" {
        var a = jv["a"]
        var out = []
        var i = 0
        while i < oren_list_len(a) {
            list.push(out, _json_to_plain(a[i]))
            i = i + 1
        }
        return out
    }
    if t == "object" {
        var o = jv["o"]
        var out2 = {}
        for k in o {
            oren_map_set_str(out2, k, _json_to_plain(oren_map_get_str(o, k)))
        }
        return out2
    }
    return oren_err(4, "ui.scene3d: invalid JSON value")
}

fn _hex_digit(n) {
    if n < 10 { return oren_string_from_bytes([48 + n]) }
    return oren_string_from_bytes([87 + n])
}

fn _hex_byte(v) {
    return _hex_digit(v / 16) + _hex_digit(v % 16)
}

fn _color_hex(rgba) {
    var r = (rgba / 16777216) % 256
    var g = (rgba / 65536) % 256
    var b = (rgba / 256) % 256
    var a = rgba % 256
    return "#" + _hex_byte(r) + _hex_byte(g) + _hex_byte(b) + _hex_byte(a)
}

fn _asset_color(m, ctx) {
    var color = m["color"]
    if color == nil { color = m["base_color"] }
    if color == nil { return oren_err(4, ctx + ": missing color") }
    var c = ui_color.parse_hex(color)
    if oren_is_err(c) { return oren_err(4, ctx + ": invalid color") }
    var opacity = m["opacity_milli"]
    if opacity != nil {
        if _is_int(opacity) == false || opacity < 0 || opacity > 1000 {
            return oren_err(4, ctx + ": invalid opacity_milli")
        }
        c["a"] = (c["a"] * opacity) / 1000
    }
    var roughness = m["roughness_milli"]
    if roughness != nil && (_is_int(roughness) == false || roughness < 0 || roughness > 1000) {
        return oren_err(4, ctx + ": invalid roughness_milli")
    }
    var metallic = m["metallic_milli"]
    if metallic != nil && (_is_int(metallic) == false || metallic < 0 || metallic > 1000) {
        return oren_err(4, ctx + ": invalid metallic_milli")
    }
    return _color_hex(c["r"] * 16777216 + c["g"] * 65536 + c["b"] * 256 + c["a"])
}

fn _bin_u32(data, off) {
    var v = bytes.get_u32_le(data, off)
    if oren_is_err(v) { return v }
    return [v, off + 4]
}

fn _bin_i32(data, off) {
    var v = bytes.get_i32_le(data, off)
    if oren_is_err(v) { return v }
    return [v, off + 4]
}

fn _bin_slice(data, off, n) {
    if n < 0 { return oren_err(4, "ui.scene3d binary: negative slice") }
    return bytes.slice(data, off, n)
}

fn _bin_magic_ok(data) {
    if bytes.len(data) < 28 { return false }
    return bytes.get_u8(data, 0) == 79 &&
        bytes.get_u8(data, 1) == 83 &&
        bytes.get_u8(data, 2) == 51 &&
        bytes.get_u8(data, 3) == 68 &&
        bytes.get_u8(data, 4) == 48 &&
        bytes.get_u8(data, 5) == 49 &&
        bytes.get_u8(data, 6) == 0 &&
        bytes.get_u8(data, 7) == 0
}

fn scene_from_binary(data) {
    if _bin_magic_ok(data) == false { return oren_err(4, "ui.scene3d.scene_from_binary: bad magic") }
    var n = bytes.len(data)
    if oren_is_err(n) { return n }
    var off = 8
    var r = _bin_u32(data, off); if oren_is_err(r) { return r }; var mesh_count = r[0]; off = r[1]
    r = _bin_u32(data, off); if oren_is_err(r) { return r }; var material_count = r[0]; off = r[1]
    r = _bin_u32(data, off); if oren_is_err(r) { return r }; var model_count = r[0]; off = r[1]
    r = _bin_u32(data, off); if oren_is_err(r) { return r }; var draw_count = r[0]; off = r[1]
    r = _bin_u32(data, off); if oren_is_err(r) { return r }; var flags = r[0]; off = r[1]
    var camera = nil
    if (flags / 2) % 2 == 1 {
        r = _bin_i32(data, off); if oren_is_err(r) { return r }; var near_z = r[0]; off = r[1]
        r = _bin_i32(data, off); if oren_is_err(r) { return r }; var far_z = r[0]; off = r[1]
        camera = {"near_z": near_z, "far_z": far_z}
    }

    var meshes = []
    var mi = 0
    while mi < mesh_count {
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var mesh_id = r[0]; off = r[1]
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var kind = r[0]; off = r[1]
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var color = r[0]; off = r[1]
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var data_len = r[0]; off = r[1]
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var index_len = r[0]; off = r[1]
        var payload = _bin_slice(data, off, data_len)
        if oren_is_err(payload) { return payload }
        off = off + data_len
        if kind == 1 {
            var indices = _bin_slice(data, off, index_len)
            if oren_is_err(indices) { return indices }
            off = off + index_len
            list.push(meshes, mesh_indexed(mesh_id, payload, indices, _color_hex(color)))
        } else if kind == 2 {
            if index_len != 0 { return oren_err(4, "ui.scene3d binary: triangles index_len must be 0") }
            list.push(meshes, mesh(mesh_id, payload, _color_hex(color)))
        } else if kind == 3 {
            if index_len != 0 { return oren_err(4, "ui.scene3d binary: rgba index_len must be 0") }
            list.push(meshes, mesh_rgba(mesh_id, payload))
        } else {
            return oren_err(4, "ui.scene3d binary: unsupported mesh kind")
        }
        mi = mi + 1
    }

    var materials = []
    var mati = 0
    while mati < material_count {
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var mat_id = r[0]; off = r[1]
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var mat_color = r[0]; off = r[1]
        list.push(materials, material(mat_id, _color_hex(mat_color)))
        mati = mati + 1
    }

    var models = []
    var modi = 0
    while modi < model_count {
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var model_id = r[0]; off = r[1]
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var model_mesh = r[0]; off = r[1]
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var model_mat = r[0]; off = r[1]
        r = _bin_i32(data, off); if oren_is_err(r) { return r }; var x = r[0]; off = r[1]
        r = _bin_i32(data, off); if oren_is_err(r) { return r }; var y = r[0]; off = r[1]
        r = _bin_i32(data, off); if oren_is_err(r) { return r }; var z = r[0]; off = r[1]
        r = _bin_u32(data, off); if oren_is_err(r) { return r }; var scale = r[0]; off = r[1]
        list.push(models, model(model_id, model_mesh, model_mat, x, y, z, scale))
        modi = modi + 1
    }

    var draws = []
    var di = 0
    while di < draw_count {
        r = _bin_u32(data, off); if oren_is_err(r) { return r }
        list.push(draws, r[0])
        off = r[1]
        di = di + 1
    }
    if off != n { return oren_err(4, "ui.scene3d binary: trailing bytes") }
    return {
        "meshes": meshes,
        "materials": materials,
        "models": models,
        "camera": camera,
        "draw": draws,
        "destroy": (flags % 2) == 1
    }
}

fn scene_from_asset_at(asset, time_milli) {
    if asset == nil { return oren_err(4, "ui.scene3d.scene_from_asset: asset is nil") }
    var schema = asset["schema"]
    if schema != nil && schema != "oren.ui.scene3d.v0" {
        return oren_err(4, "ui.scene3d.scene_from_asset: unsupported schema")
    }
    var meshes = _map_list(asset["meshes"], _asset_mesh)
    if oren_is_err(meshes) { return meshes }
    var mesh_names = _index_names(asset["meshes"])
    var materials = []
    var mats = asset["materials"]
    if mats != nil {
        var mi = 0
        while mi < oren_list_len(mats) {
            var mat = mats[mi]
            var mat_color = _asset_color(mat, "ui.scene3d material")
            if oren_is_err(mat_color) { return mat_color }
            list.push(materials, material(mat["id"], mat_color))
            mi = mi + 1
        }
    }
    var material_names = _index_names(asset["materials"])
    var templates = {}
    var model_templates = asset["model_templates"]
    if model_templates != nil {
        var ti = 0
        while ti < oren_list_len(model_templates) {
            var tpl = model_templates[ti]
            var tpl_name = tpl["name"]
            if tpl_name != nil { oren_map_set_str(templates, tpl_name, tpl) }
            ti = ti + 1
        }
    }
    var models = []
    var model_push = _push_asset_models(models, asset["models"], mesh_names, material_names)
    if oren_is_err(model_push) { return model_push }
    var instance_push = _push_asset_instances(models, asset["instances"], templates, mesh_names, material_names)
    if oren_is_err(instance_push) { return instance_push }
    var group_push = _push_asset_instance_groups(models, asset["instance_groups"], templates, mesh_names, material_names)
    if oren_is_err(group_push) { return group_push }
    if time_milli != nil {
        var anim_push = _apply_animations(models, asset["animations"], time_milli)
        if oren_is_err(anim_push) { return anim_push }
    }
    var model_names = _index_names(models)
    var draws = []
    var raw_draws = asset["draw"]
    if raw_draws != nil {
        var di = 0
        var next_draw_model_id = _max_model_id(models) + 1
        while di < oren_list_len(raw_draws) {
            var d = raw_draws[di]
            if oren_type_tag(d) == 4 {
                var draw_id = oren_map_get_str(model_names, d)
                if draw_id == nil { return oren_err(4, "ui.scene3d: unknown draw model") }
                list.push(draws, draw_id)
            } else if _is_int(d) {
                list.push(draws, d)
            } else if d["op"] != nil {
                list.push(draws, d)
            } else if d["model"] != nil || d["model_id"] != nil || d["mesh"] != nil || d["mesh_id"] != nil {
                var draw_model = _draw_model_override(d, models, model_names, mesh_names, material_names, next_draw_model_id)
                if oren_is_err(draw_model) { return draw_model }
                list.push(models, draw_model)
                if draw_model["name"] != nil { oren_map_set_str(model_names, draw_model["name"], draw_model["id"]) }
                list.push(draws, draw_model["id"])
                if d["id"] == nil { next_draw_model_id = next_draw_model_id + 1 }
            } else {
                list.push(draws, d)
            }
            di = di + 1
        }
    }
    return {
        "meshes": meshes,
        "materials": materials,
        "models": models,
        "camera": asset["camera"],
        "draw": draws,
        "destroy": asset["destroy"]
    }
}

fn scene_from_asset(asset) {
    return scene_from_asset_at(asset, nil)
}

fn commands_from_asset(asset) {
    var scene = scene_from_asset(asset)
    if oren_is_err(scene) { return scene }
    return commands(scene)
}

fn commands_from_asset_at(asset, time_milli) {
    var scene = scene_from_asset_at(asset, time_milli)
    if oren_is_err(scene) { return scene }
    return commands(scene)
}

fn commands_from_json(s) {
    var jv = json.parse(s)
    if oren_is_err(jv) { return jv }
    var asset = _json_to_plain(jv)
    if oren_is_err(asset) { return asset }
    return commands_from_asset(asset)
}

fn commands_from_json_at(s, time_milli) {
    var jv = json.parse(s)
    if oren_is_err(jv) { return jv }
    var asset = _json_to_plain(jv)
    if oren_is_err(asset) { return asset }
    return commands_from_asset_at(asset, time_milli)
}

fn commands_from_binary(data) {
    var scene = scene_from_binary(data)
    if oren_is_err(scene) { return scene }
    return commands(scene)
}

fn commands_from_file(path) {
    var s = oren_read_file(path)
    if oren_is_err(s) { return s }
    return commands_from_json(s)
}

fn commands_from_file_at(path, time_milli) {
    var s = oren_read_file(path)
    if oren_is_err(s) { return s }
    return commands_from_json_at(s, time_milli)
}

fn commands_from_binary_file(path) {
    var data = oren_read_bytes(path)
    if oren_is_err(data) { return data }
    return commands_from_binary(data)
}

fn commands(scene) {
    if scene == nil { return oren_err(4, "ui.scene3d.commands: scene is nil") }
    var out = []
    var meshes = scene["meshes"]
    var materials = scene["materials"]
    var models = scene["models"]
    _push_all(out, meshes)
    _push_all(out, materials)
    _push_all(out, models)
    var camera_active = _push_camera(out, scene["camera"])
    _push_draws(out, scene["draw"])
    if camera_active { list.push(out, pop_camera()) }
    if scene["destroy"] != nil && scene["destroy"] != 0 {
        _push_destroy(out, models, destroy_model)
        _push_destroy(out, materials, destroy_material)
        _push_destroy(out, meshes, destroy_mesh)
    }
    return out
}
