// std:ui/scene3d (rolling)
//
// Small retained-3D scene helpers for the AVM UI command protocol.
//
// This module stays host-neutral: it returns ordinary `std:ui` command maps.
// `std:ui/avm` encodes them into OGF0 bytes and host SDK renderers map them to
// CoreGraphics/Metal. The v0 scene shape is intentionally simple so OBC packages
// can bundle scene metadata without depending on host objects.

import list "std:list"
import bytes "std:bytes"
import json "std:json"

fn _is_int(v) {
    if v == nil { return false }
    return oren_type_tag(v) == 1
}

fn mesh(id, triangles, color) {
    return {"op": "mesh3d", "id": id, "triangles": triangles, "color": color}
}

fn mesh_rgba(id, triangles) {
    return {"op": "mesh3d_rgba", "id": id, "triangles": triangles}
}

fn mesh_indexed(id, vertices, indices, color) {
    return {"op": "mesh3d_indexed", "id": id, "vertices": vertices, "indices": indices, "color": color}
}

fn material(id, color) {
    return {"op": "material3d", "id": id, "color": color}
}

fn model(id, mesh_id, material_id, x, y, z, scale_milli) {
    if material_id == nil { material_id = 0 }
    return {
        "op": "model3d",
        "id": id,
        "mesh_id": mesh_id,
        "material_id": material_id,
        "x": x,
        "y": y,
        "z": z,
        "scale_milli": scale_milli
    }
}

fn model_default(id, mesh_id) {
    return model(id, mesh_id, 0, 0, 0, 0, 1000)
}

fn draw_model(id) {
    return {"op": "draw_model3d", "id": id}
}

fn destroy_model(id) {
    return {"op": "destroy_model3d", "id": id}
}

fn destroy_mesh(id) {
    return {"op": "destroy_mesh3d", "id": id}
}

fn destroy_material(id) {
    return {"op": "destroy_material3d", "id": id}
}

fn _push_all(out, xs) {
    if xs == nil { return 0 }
    var i = 0
    while i < oren_list_len(xs) {
        list.push(out, xs[i])
        i = i + 1
    }
    return 0
}

fn _push_draws(out, xs) {
    if xs == nil { return 0 }
    var i = 0
    while i < oren_list_len(xs) {
        var d = xs[i]
        if _is_int(d) {
            list.push(out, draw_model(d))
        } else {
            list.push(out, d)
        }
        i = i + 1
    }
    return 0
}

fn _push_destroy(out, xs, destroy_fn) {
    if xs == nil { return 0 }
    var i = oren_list_len(xs) - 1
    while i >= 0 {
        var item = xs[i]
        var id = item
        if _is_int(item) == false && item["id"] != nil { id = item["id"] }
        list.push(out, destroy_fn(id))
        i = i - 1
    }
    return 0
}

fn _pack_bytes(v, ctx) {
    if v == nil { return oren_err(4, ctx + ": missing byte array") }
    if oren_type_tag(v) == 6 { return bytes.try_pack(v) }
    var n = bytes.try_len(v)
    if oren_is_err(n) { return oren_err(4, ctx + ": expected byte array") }
    return v
}

fn _asset_mesh(m) {
    if m == nil { return oren_err(4, "ui.scene3d: mesh is nil") }
    var id = m["id"]
    var kind = m["kind"]
    if kind == nil { kind = "triangles" }
    if kind == "triangles" {
        var tris = _pack_bytes(m["triangles"], "ui.scene3d mesh.triangles")
        if oren_is_err(tris) { return tris }
        return mesh(id, tris, m["color"])
    }
    if kind == "triangles_rgba" {
        var tris_rgba = _pack_bytes(m["triangles"], "ui.scene3d mesh.triangles_rgba")
        if oren_is_err(tris_rgba) { return tris_rgba }
        return mesh_rgba(id, tris_rgba)
    }
    if kind == "indexed" {
        var vertices = _pack_bytes(m["vertices"], "ui.scene3d mesh.vertices")
        if oren_is_err(vertices) { return vertices }
        var indices = _pack_bytes(m["indices"], "ui.scene3d mesh.indices")
        if oren_is_err(indices) { return indices }
        return mesh_indexed(id, vertices, indices, m["color"])
    }
    return oren_err(4, "ui.scene3d: unsupported mesh kind")
}

fn _asset_model(m) {
    if m == nil { return oren_err(4, "ui.scene3d: model is nil") }
    var material_id = m["material_id"]
    if material_id == nil { material_id = 0 }
    var x = m["x"]; if x == nil { x = 0 }
    var y = m["y"]; if y == nil { y = 0 }
    var z = m["z"]; if z == nil { z = 0 }
    var scale_milli = m["scale_milli"]; if scale_milli == nil { scale_milli = 1000 }
    return model(m["id"], m["mesh_id"], material_id, x, y, z, scale_milli)
}

fn _map_list(xs, map_fn) {
    var out = []
    if xs == nil { return out }
    var i = 0
    while i < oren_list_len(xs) {
        var item = map_fn(xs[i])
        if oren_is_err(item) { return item }
        list.push(out, item)
        i = i + 1
    }
    return out
}

fn _json_to_plain(jv) {
    if jv == nil { return nil }
    var t = jv["t"]
    if t == "null" { return nil }
    if t == "bool" { return jv["b"] != 0 }
    if t == "int" { return jv["i"] }
    if t == "string" { return jv["s"] }
    if t == "array" {
        var a = jv["a"]
        var out = []
        var i = 0
        while i < oren_list_len(a) {
            list.push(out, _json_to_plain(a[i]))
            i = i + 1
        }
        return out
    }
    if t == "object" {
        var o = jv["o"]
        var out2 = {}
        for k in o {
            oren_map_set_str(out2, k, _json_to_plain(oren_map_get_str(o, k)))
        }
        return out2
    }
    return oren_err(4, "ui.scene3d: invalid JSON value")
}

fn scene_from_asset(asset) {
    if asset == nil { return oren_err(4, "ui.scene3d.scene_from_asset: asset is nil") }
    var schema = asset["schema"]
    if schema != nil && schema != "oren.ui.scene3d.v0" {
        return oren_err(4, "ui.scene3d.scene_from_asset: unsupported schema")
    }
    var meshes = _map_list(asset["meshes"], _asset_mesh)
    if oren_is_err(meshes) { return meshes }
    var materials = []
    var mats = asset["materials"]
    if mats != nil {
        var mi = 0
        while mi < oren_list_len(mats) {
            var mat = mats[mi]
            list.push(materials, material(mat["id"], mat["color"]))
            mi = mi + 1
        }
    }
    var models = _map_list(asset["models"], _asset_model)
    if oren_is_err(models) { return models }
    return {
        "meshes": meshes,
        "materials": materials,
        "models": models,
        "draw": asset["draw"],
        "destroy": asset["destroy"]
    }
}

fn commands_from_asset(asset) {
    var scene = scene_from_asset(asset)
    if oren_is_err(scene) { return scene }
    return commands(scene)
}

fn commands_from_json(s) {
    var jv = json.try_decode(s)
    if oren_is_err(jv) { return jv }
    var asset = _json_to_plain(jv)
    if oren_is_err(asset) { return asset }
    return commands_from_asset(asset)
}

fn commands_from_file(path) {
    var s = oren_read_file(path)
    if oren_is_err(s) { return s }
    return commands_from_json(s)
}

fn commands(scene) {
    if scene == nil { return oren_err(4, "ui.scene3d.commands: scene is nil") }
    var out = []
    var meshes = scene["meshes"]
    var materials = scene["materials"]
    var models = scene["models"]
    _push_all(out, meshes)
    _push_all(out, materials)
    _push_all(out, models)
    _push_draws(out, scene["draw"])
    if scene["destroy"] != nil && scene["destroy"] != 0 {
        _push_destroy(out, models, destroy_model)
        _push_destroy(out, materials, destroy_material)
        _push_destroy(out, meshes, destroy_mesh)
    }
    return out
}
