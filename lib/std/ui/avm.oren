// std:ui/avm (rolling)
//
// AVM graphics bridge for host-rendered UI frames. The production mailbox payload
// is a compact little-endian byte stream; host apps own actual drawing.

import ui_cmds "std:ui/commands"
import ui_color "std:ui/color"
import bytes "std:bytes"
import raw "std:buffer/raw"

fn _writer(buf) {
    return [buf, 0]
}

fn _writer_buf(wr) {
    return wr[0]
}

fn _writer_pos(wr) {
    return wr[1]
}

fn _push_u8(wr, v) {
    raw._store_u8_buf_unchecked_direct(wr[0], wr[1], v & 255)
    wr[1] = wr[1] + 1
}

fn _push_u16_le(wr, v) {
    _push_u8(wr, v)
    _push_u8(wr, v >> 8)
}

fn _u32_bits(v) {
    if v < 0 { return 4294967296 + v }
    return v
}

fn _push_u32_le(wr, v) {
    var x = _u32_bits(v)
    _push_u8(wr, x)
    _push_u8(wr, x >> 8)
    _push_u8(wr, x >> 16)
    _push_u8(wr, x >> 24)
}

fn _push_color_rgba(wr, s) {
    var c = ui_color.parse_hex(s)
    if oren_is_err(c) { return c }
    _push_u8(wr, c["r"])
    _push_u8(wr, c["g"])
    _push_u8(wr, c["b"])
    _push_u8(wr, c["a"])
    return 0
}

fn _truthy_flag(v) {
    if v == nil { return false }
    if v == false { return false }
    if v == 0 { return false }
    return true
}

fn _append_bytes(wr, bs) {
    var bv = bytes.view(bs, "ui.avm frame bytes")
    if oren_is_err(bv) { return bv }
    var n = bytes.view_len(bv)
    var p = bytes.view_ptr(bv)
    if p != nil {
        if n > 0 {
            raw._copy_u8_ptr_forward(oren_buf_data_ptr_unchecked(wr[0]) + wr[1], p, n)
        }
        wr[1] = wr[1] + n
        return 0
    }
    var i = 0
    while i < n {
        var b = bytes.view_get_u8_unchecked(bv, i)
        _push_u8(wr, b)
        i = i + 1
    }
    return 0
}

fn _string_byte_len(s, ctx) {
    if oren_type_tag(s) != 4 { return oren_err(4, ctx + ": text must be string") }
    return oren_string_len(s)
}

fn _append_string(wr, s, n) {
    var i = 0
    while i < n {
        _push_u8(wr, oren_string_byte_at_unchecked(s, i))
        i = i + 1
    }
    return 0
}

fn _push_frame_header(wr, w, h, scale_milli, op_count, sequence, drawable_w, drawable_h, target_hz_milli) {
    // Magic "OGF0", version=1, flags=0, header_len=40.
    _push_u8(wr, 79)
    _push_u8(wr, 71)
    _push_u8(wr, 70)
    _push_u8(wr, 48)
    _push_u8(wr, 1)
    _push_u8(wr, 0)
    _push_u16_le(wr, 40)
    _push_u32_le(wr, w)
    _push_u32_le(wr, h)
    _push_u32_le(wr, scale_milli)
    _push_u32_le(wr, op_count)
    _push_u32_le(wr, sequence)
    _push_u32_le(wr, drawable_w)
    _push_u32_le(wr, drawable_h)
    _push_u32_le(wr, target_hz_milli)
}

fn _push_op_header(wr, opcode, payload_len) {
    _push_u8(wr, opcode)
    _push_u8(wr, 0)
    _push_u16_le(wr, payload_len)
}

fn _cmd_frame_len(c) {
    var op = c["op"]
    if op == "fill_rect" { return 24 }
    if op == "push_clip_rect" { return 20 }
    if op == "pop_clip" { return 4 }
    if op == "push_translate" { return 12 }
    if op == "pop_transform" { return 4 }
    if op == "push_opacity" { return 8 }
    if op == "pop_opacity" { return 4 }
    if op == "push_camera_ortho" { return 12 }
    if op == "pop_camera" { return 4 }
    if op == "stroke_line" { return 28 }
    if op == "stroke_rect" { return 28 }
    if op == "round_rect" { return 36 }
    if op == "circle" { return 24 }
    if op == "ellipse" { return 32 }
    if op == "polyline" {
        var pn = bytes.len(c["points"])
        if oren_is_err(pn) { return pn }
        if pn < 16 || pn > 65520 || pn % 8 != 0 { return oren_err(4, "ui.avm.frame_bytes: polyline invalid point bytes") }
        return 16 + pn
    }
    if op == "fill_triangle" { return 32 }
    if op == "fill_triangles" {
        var tris_n = bytes.len(c["triangles"])
        if oren_is_err(tris_n) { return tris_n }
        if tris_n == 0 || tris_n > 65512 || tris_n % 24 != 0 { return oren_err(4, "ui.avm.frame_bytes: fill_triangles invalid triangle bytes") }
        return 12 + tris_n
    }
    if op == "mesh2d" {
        var mesh_tris_n = bytes.len(c["triangles"])
        if oren_is_err(mesh_tris_n) { return mesh_tris_n }
        if mesh_tris_n == 0 || mesh_tris_n > 65504 || mesh_tris_n % 24 != 0 { return oren_err(4, "ui.avm.frame_bytes: mesh2d invalid triangle bytes") }
        return 16 + mesh_tris_n
    }
    if op == "draw_mesh2d" { return 8 }
    if op == "destroy_mesh2d" { return 8 }
    if op == "mesh3d" {
        var mesh3d_tris_n = bytes.len(c["triangles"])
        if oren_is_err(mesh3d_tris_n) { return mesh3d_tris_n }
        if mesh3d_tris_n == 0 || mesh3d_tris_n > 65520 || mesh3d_tris_n % 36 != 0 { return oren_err(4, "ui.avm.frame_bytes: mesh3d invalid triangle bytes") }
        return 16 + mesh3d_tris_n
    }
    if op == "mesh3d_rgba" {
        var mesh3d_rgba_n = bytes.len(c["triangles"])
        if oren_is_err(mesh3d_rgba_n) { return mesh3d_rgba_n }
        if mesh3d_rgba_n == 0 || mesh3d_rgba_n > 65520 || mesh3d_rgba_n % 40 != 0 { return oren_err(4, "ui.avm.frame_bytes: mesh3d_rgba invalid triangle bytes") }
        return 12 + mesh3d_rgba_n
    }
    if op == "mesh3d_indexed" {
        var mesh3d_vertices_n = bytes.len(c["vertices"])
        if oren_is_err(mesh3d_vertices_n) { return mesh3d_vertices_n }
        var mesh3d_indices_n = bytes.len(c["indices"])
        if oren_is_err(mesh3d_indices_n) { return mesh3d_indices_n }
        if mesh3d_vertices_n < 36 || mesh3d_vertices_n > 65508 || mesh3d_vertices_n % 12 != 0 { return oren_err(4, "ui.avm.frame_bytes: mesh3d_indexed invalid vertex bytes") }
        if mesh3d_indices_n < 12 || mesh3d_indices_n > 65508 || mesh3d_indices_n % 12 != 0 || mesh3d_vertices_n + mesh3d_indices_n > 65519 { return oren_err(4, "ui.avm.frame_bytes: mesh3d_indexed invalid index bytes") }
        return 20 + mesh3d_vertices_n + mesh3d_indices_n
    }
    if op == "draw_mesh3d" { return 8 }
    if op == "draw_mesh3d_at" { return 24 }
    if op == "material3d" { return 12 }
    if op == "draw_mesh3d_material" { return 12 }
    if op == "draw_mesh3d_at_material" { return 28 }
    if op == "model3d" { return 32 }
    if op == "draw_model3d" { return 8 }
    if op == "destroy_model3d" { return 8 }
    if op == "destroy_mesh3d" { return 8 }
    if op == "destroy_material3d" { return 8 }
    if op == "text" {
        var tn = _string_byte_len(c["text"], "ui.avm.frame_bytes")
        if oren_is_err(tn) { return tn }
        if tn > 65519 { return oren_err(4, "ui.avm.frame_bytes: text too large") }
        return 20 + tn
    }
    if op == "text_bytes" {
        var tn2 = bytes.len(c["data"])
        if oren_is_err(tn2) { return tn2 }
        if tn2 > 65519 { return oren_err(4, "ui.avm.frame_bytes: text_bytes too large") }
        return 20 + tn2
    }
    if op == "text_resource" {
        var trn = bytes.len(c["data"])
        if oren_is_err(trn) { return trn }
        if trn > 65519 { return oren_err(4, "ui.avm.frame_bytes: text_resource too large") }
        return 16 + trn
    }
    if op == "draw_text" { return 16 }
    if op == "draw_texts" {
        var pos_n = bytes.len(c["positions"])
        if oren_is_err(pos_n) { return pos_n }
        if pos_n == 0 || pos_n > 65520 || pos_n % 8 != 0 { return oren_err(4, "ui.avm.frame_bytes: draw_texts invalid position bytes") }
        return 12 + pos_n
    }
    if op == "destroy_text" { return 8 }
    if op == "image_rgba" {
        var image_n = bytes.len(c["data"])
        if oren_is_err(image_n) { return image_n }
        if image_n > 65519 { return oren_err(4, "ui.avm.frame_bytes: image_rgba too large") }
        return 20 + image_n
    }
    if op == "draw_image" { return 24 }
    if op == "destroy_image" { return 8 }
    if op == "draw_image_rect" { return 40 }
    if op == "draw_image_rects" {
        var rn = bytes.len(c["rects"])
        if oren_is_err(rn) { return rn }
        if rn == 0 || rn > 65504 || rn % 32 != 0 { return oren_err(4, "ui.avm.frame_bytes: draw_image_rects invalid rect bytes") }
        return 12 + rn
    }
    return oren_err(4, "ui.avm.frame_bytes: unsupported op")
}

fn _frame_len(cmds) {
    var total = 40
    var i = 0
    while i < oren_list_len(cmds) {
        var n = _cmd_frame_len(cmds[i])
        if oren_is_err(n) { return n }
        total = total + n
        i = i + 1
    }
    return total
}

fn _push_cmd(out, c) {
    var op = c["op"]
    if op == "fill_rect" {
        _push_op_header(out, 1, 20)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        return _push_color_rgba(out, c["color"])
    }
    if op == "push_clip_rect" {
        _push_op_header(out, 16, 16)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        return 0
    }
    if op == "pop_clip" {
        _push_op_header(out, 17, 0)
        return 0
    }
    if op == "push_translate" {
        _push_op_header(out, 18, 8)
        _push_u32_le(out, c["dx"])
        _push_u32_le(out, c["dy"])
        return 0
    }
    if op == "pop_transform" {
        _push_op_header(out, 19, 0)
        return 0
    }
    if op == "push_opacity" {
        var alpha_milli = c["alpha_milli"]
        if alpha_milli == nil { alpha_milli = c["alpha"] }
        _push_op_header(out, 20, 4)
        _push_u32_le(out, alpha_milli)
        return 0
    }
    if op == "pop_opacity" {
        _push_op_header(out, 21, 0)
        return 0
    }
    if op == "push_camera_ortho" {
        _push_op_header(out, 22, 8)
        _push_u32_le(out, c["near_z"])
        _push_u32_le(out, c["far_z"])
        return 0
    }
    if op == "pop_camera" {
        _push_op_header(out, 23, 0)
        return 0
    }
    if op == "stroke_line" {
        var lw = c["width"]
        if lw == nil { lw = 1 }
        _push_op_header(out, 3, 24)
        _push_u32_le(out, c["x1"])
        _push_u32_le(out, c["y1"])
        _push_u32_le(out, c["x2"])
        _push_u32_le(out, c["y2"])
        _push_u32_le(out, lw)
        return _push_color_rgba(out, c["color"])
    }
    if op == "stroke_rect" {
        var rw = c["width"]
        if rw == nil { rw = 1 }
        _push_op_header(out, 6, 24)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        _push_u32_le(out, rw)
        return _push_color_rgba(out, c["color"])
    }
    if op == "round_rect" {
        var rrw = c["width"]
        if rrw == nil { rrw = 1 }
        var rrfill = c["fill"]
        if rrfill == nil { rrfill = true }
        var rrflags = 0
        if _truthy_flag(rrfill) { rrflags = rrflags | 1 }
        _push_op_header(out, 9, 32)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        _push_u32_le(out, c["r"])
        _push_u32_le(out, rrw)
        _push_u32_le(out, rrflags)
        return _push_color_rgba(out, c["color"])
    }
    if op == "circle" {
        var fill = c["fill"]
        if fill == nil { fill = true }
        var flags = 0
        if _truthy_flag(fill) { flags = flags | 1 }
        _push_op_header(out, 4, 20)
        _push_u32_le(out, c["cx"])
        _push_u32_le(out, c["cy"])
        _push_u32_le(out, c["r"])
        _push_u32_le(out, flags)
        return _push_color_rgba(out, c["color"])
    }
    if op == "ellipse" {
        var efill = c["fill"]
        if efill == nil { efill = true }
        var eflags = 0
        if _truthy_flag(efill) { eflags = eflags | 1 }
        var elw = c["width"]
        if elw == nil { elw = 1 }
        _push_op_header(out, 7, 28)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        _push_u32_le(out, elw)
        _push_u32_le(out, eflags)
        return _push_color_rgba(out, c["color"])
    }
    if op == "polyline" {
        var points = c["points"]
        var pn = bytes.len(points)
        if oren_is_err(pn) { return pn }
        if pn < 16 || pn > 65520 || pn % 8 != 0 { return oren_err(4, "ui.avm.frame_bytes: polyline invalid point bytes") }
        var plw = c["width"]
        if plw == nil { plw = 1 }
        _push_op_header(out, 8, 12 + pn)
        _push_u32_le(out, plw)
        _push_u32_le(out, pn / 8)
        var prc = _push_color_rgba(out, c["color"])
        if oren_is_err(prc) { return prc }
        return _append_bytes(out, points)
    }
    if op == "fill_triangle" {
        _push_op_header(out, 5, 28)
        _push_u32_le(out, c["x1"])
        _push_u32_le(out, c["y1"])
        _push_u32_le(out, c["x2"])
        _push_u32_le(out, c["y2"])
        _push_u32_le(out, c["x3"])
        _push_u32_le(out, c["y3"])
        return _push_color_rgba(out, c["color"])
    }
    if op == "fill_triangles" {
        var tris = c["triangles"]
        var tris_n = bytes.len(tris)
        if oren_is_err(tris_n) { return tris_n }
        if tris_n == 0 || tris_n > 65512 || tris_n % 24 != 0 { return oren_err(4, "ui.avm.frame_bytes: fill_triangles invalid triangle bytes") }
        _push_op_header(out, 10, 8 + tris_n)
        _push_u32_le(out, tris_n / 24)
        var trc = _push_color_rgba(out, c["color"])
        if oren_is_err(trc) { return trc }
        return _append_bytes(out, tris)
    }
    if op == "mesh2d" {
        var mesh_tris = c["triangles"]
        var mesh_tris_n = bytes.len(mesh_tris)
        if oren_is_err(mesh_tris_n) { return mesh_tris_n }
        if mesh_tris_n == 0 || mesh_tris_n > 65504 || mesh_tris_n % 24 != 0 { return oren_err(4, "ui.avm.frame_bytes: mesh2d invalid triangle bytes") }
        _push_op_header(out, 80, 12 + mesh_tris_n)
        _push_u32_le(out, c["id"])
        var mesh_col = _push_color_rgba(out, c["color"])
        if oren_is_err(mesh_col) { return mesh_col }
        _push_u32_le(out, mesh_tris_n / 24)
        return _append_bytes(out, mesh_tris)
    }
    if op == "draw_mesh2d" {
        _push_op_header(out, 81, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "destroy_mesh2d" {
        _push_op_header(out, 82, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "mesh3d" {
        var mesh3d_tris = c["triangles"]
        var mesh3d_tris_n = bytes.len(mesh3d_tris)
        if oren_is_err(mesh3d_tris_n) { return mesh3d_tris_n }
        if mesh3d_tris_n == 0 || mesh3d_tris_n > 65520 || mesh3d_tris_n % 36 != 0 { return oren_err(4, "ui.avm.frame_bytes: mesh3d invalid triangle bytes") }
        _push_op_header(out, 83, 12 + mesh3d_tris_n)
        _push_u32_le(out, c["id"])
        var mesh3d_col = _push_color_rgba(out, c["color"])
        if oren_is_err(mesh3d_col) { return mesh3d_col }
        _push_u32_le(out, mesh3d_tris_n / 36)
        return _append_bytes(out, mesh3d_tris)
    }
    if op == "mesh3d_rgba" {
        var mesh3d_rgba_tris = c["triangles"]
        var mesh3d_rgba_n = bytes.len(mesh3d_rgba_tris)
        if oren_is_err(mesh3d_rgba_n) { return mesh3d_rgba_n }
        if mesh3d_rgba_n == 0 || mesh3d_rgba_n > 65520 || mesh3d_rgba_n % 40 != 0 { return oren_err(4, "ui.avm.frame_bytes: mesh3d_rgba invalid triangle bytes") }
        _push_op_header(out, 86, 8 + mesh3d_rgba_n)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, mesh3d_rgba_n / 40)
        return _append_bytes(out, mesh3d_rgba_tris)
    }
    if op == "mesh3d_indexed" {
        var mesh3d_vertices = c["vertices"]
        var mesh3d_vertices_n = bytes.len(mesh3d_vertices)
        if oren_is_err(mesh3d_vertices_n) { return mesh3d_vertices_n }
        var mesh3d_indices = c["indices"]
        var mesh3d_indices_n = bytes.len(mesh3d_indices)
        if oren_is_err(mesh3d_indices_n) { return mesh3d_indices_n }
        if mesh3d_vertices_n < 36 || mesh3d_vertices_n > 65508 || mesh3d_vertices_n % 12 != 0 { return oren_err(4, "ui.avm.frame_bytes: mesh3d_indexed invalid vertex bytes") }
        if mesh3d_indices_n < 12 || mesh3d_indices_n > 65508 || mesh3d_indices_n % 12 != 0 || mesh3d_vertices_n + mesh3d_indices_n > 65519 { return oren_err(4, "ui.avm.frame_bytes: mesh3d_indexed invalid index bytes") }
        _push_op_header(out, 88, 16 + mesh3d_vertices_n + mesh3d_indices_n)
        _push_u32_le(out, c["id"])
        var mesh3d_indexed_col = _push_color_rgba(out, c["color"])
        if oren_is_err(mesh3d_indexed_col) { return mesh3d_indexed_col }
        _push_u32_le(out, mesh3d_vertices_n / 12)
        _push_u32_le(out, mesh3d_indices_n / 4)
        var mesh3d_indexed_vr = _append_bytes(out, mesh3d_vertices)
        if oren_is_err(mesh3d_indexed_vr) { return mesh3d_indexed_vr }
        return _append_bytes(out, mesh3d_indices)
    }
    if op == "draw_mesh3d" {
        _push_op_header(out, 84, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "draw_mesh3d_at" {
        _push_op_header(out, 87, 20)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["z"])
        _push_u32_le(out, c["scale_milli"])
        return 0
    }
    if op == "material3d" {
        _push_op_header(out, 89, 8)
        _push_u32_le(out, c["id"])
        return _push_color_rgba(out, c["color"])
    }
    if op == "draw_mesh3d_material" {
        _push_op_header(out, 90, 8)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["material_id"])
        return 0
    }
    if op == "draw_mesh3d_at_material" {
        _push_op_header(out, 91, 24)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["material_id"])
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["z"])
        _push_u32_le(out, c["scale_milli"])
        return 0
    }
    if op == "model3d" {
        _push_op_header(out, 93, 28)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["mesh_id"])
        var model_mat = c["material_id"]
        if model_mat == nil { model_mat = 0 }
        _push_u32_le(out, model_mat)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["z"])
        _push_u32_le(out, c["scale_milli"])
        return 0
    }
    if op == "draw_model3d" {
        _push_op_header(out, 94, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "destroy_model3d" {
        _push_op_header(out, 95, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "destroy_mesh3d" {
        _push_op_header(out, 85, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "destroy_material3d" {
        _push_op_header(out, 92, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "text" {
        var text = c["text"]
        var tn = _string_byte_len(text, "ui.avm.frame_bytes")
        if oren_is_err(tn) { return tn }
        if tn > 65519 { return oren_err(4, "ui.avm.frame_bytes: text too large") }
        _push_op_header(out, 2, 16 + tn)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        var rc = _push_color_rgba(out, c["color"])
        if oren_is_err(rc) { return rc }
        _push_u32_le(out, tn)
        return _append_string(out, text, tn)
    }
    if op == "text_bytes" {
        var tb2 = c["data"]
        var tn2 = bytes.len(tb2)
        if oren_is_err(tn2) { return tn2 }
        if tn2 > 65519 { return oren_err(4, "ui.avm.frame_bytes: text_bytes too large") }
        _push_op_header(out, 2, 16 + tn2)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        var rc2 = _push_color_rgba(out, c["color"])
        if oren_is_err(rc2) { return rc2 }
        _push_u32_le(out, tn2)
        return _append_bytes(out, tb2)
    }
    if op == "text_resource" {
        var trb = c["data"]
        var trn = bytes.len(trb)
        if oren_is_err(trn) { return trn }
        if trn > 65519 { return oren_err(4, "ui.avm.frame_bytes: text_resource too large") }
        _push_op_header(out, 68, 12 + trn)
        _push_u32_le(out, c["id"])
        var trc = _push_color_rgba(out, c["color"])
        if oren_is_err(trc) { return trc }
        _push_u32_le(out, trn)
        return _append_bytes(out, trb)
    }
    if op == "draw_text" {
        _push_op_header(out, 69, 12)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        return 0
    }
    if op == "draw_texts" {
        var positions = c["positions"]
        var pos_n = bytes.len(positions)
        if oren_is_err(pos_n) { return pos_n }
        if pos_n == 0 || pos_n > 65520 || pos_n % 8 != 0 { return oren_err(4, "ui.avm.frame_bytes: draw_texts invalid position bytes") }
        _push_op_header(out, 72, 8 + pos_n)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, pos_n / 8)
        return _append_bytes(out, positions)
    }
    if op == "destroy_text" {
        _push_op_header(out, 70, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "image_rgba" {
        var ib = c["data"]
        var image_n = bytes.len(ib)
        if oren_is_err(image_n) { return image_n }
        if image_n > 65519 { return oren_err(4, "ui.avm.frame_bytes: image_rgba too large") }
        _push_op_header(out, 64, 16 + image_n)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        _push_u32_le(out, image_n)
        return _append_bytes(out, ib)
    }
    if op == "draw_image" {
        _push_op_header(out, 65, 20)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        return 0
    }
    if op == "destroy_image" {
        _push_op_header(out, 66, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "draw_image_rect" {
        _push_op_header(out, 67, 36)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["sx"])
        _push_u32_le(out, c["sy"])
        _push_u32_le(out, c["sw"])
        _push_u32_le(out, c["sh"])
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        return 0
    }
    if op == "draw_image_rects" {
        var rects = c["rects"]
        var rn = bytes.len(rects)
        if oren_is_err(rn) { return rn }
        if rn == 0 || rn > 65504 || rn % 32 != 0 { return oren_err(4, "ui.avm.frame_bytes: draw_image_rects invalid rect bytes") }
        _push_op_header(out, 71, 8 + rn)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, rn / 32)
        return _append_bytes(out, rects)
    }
    return oren_err(4, "ui.avm.frame_bytes: unsupported op")
}

fn frame_bytes(cmds, w, h, opts) {
    if opts == nil { opts = {} }
    var vr = ui_cmds.validate(cmds, w, h, opts)
    if oren_is_err(vr) { return vr }

    var scale_milli = opts["scale_milli"]
    if scale_milli == nil { scale_milli = opts["scale"] }
    if scale_milli == nil { scale_milli = 1000 }
    var sequence = opts["sequence"]
    if sequence == nil { sequence = 0 }
    var drawable_w = opts["drawable_w"]
    if drawable_w == nil { drawable_w = w }
    var drawable_h = opts["drawable_h"]
    if drawable_h == nil { drawable_h = h }
    var target_hz_milli = opts["target_hz_milli"]
    if target_hz_milli == nil { target_hz_milli = 0 }
    var frame_len = _frame_len(cmds)
    if oren_is_err(frame_len) { return frame_len }
    var out = raw.u8_new_uninit(frame_len)
    if oren_is_err(out) { return out }
    var wr = _writer(out)
    _push_frame_header(wr, w, h, scale_milli, oren_list_len(cmds), sequence, drawable_w, drawable_h, target_hz_milli)

    var i = 0
    while i < oren_list_len(cmds) {
        var rc = _push_cmd(wr, cmds[i])
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    if _writer_pos(wr) != frame_len { return oren_err(4, "ui.avm.frame_bytes: internal size mismatch") }
    return _writer_buf(wr)
}

fn present_bytes(frame) {
    return oren_gfx_present_frame(frame)
}

fn present_frame(cmds, w, h, opts) {
    var frame = frame_bytes(cmds, w, h, opts)
    if oren_is_err(frame) { return frame }
    return present_bytes(frame)
}

fn pull_event_bytes() {
    return oren_gfx_poll_input()
}

fn poll_event_bytes() {
    return pull_event_bytes()
}

fn screen(id) {
    if id == nil { id = 0 }
    return oren_gfx_screen(id)
}

fn screen0() {
    return screen(0)
}

fn screen_available(id) {
    return screen(id) != nil
}

fn _signed_u32(v) {
    if v >= 2147483648 { return v - 4294967296 }
    return v
}

fn _pointer_phase(opcode) {
    if opcode == 1 { return "down" }
    if opcode == 2 { return "move" }
    if opcode == 3 { return "up" }
    if opcode == 4 { return "cancel" }
    return "unknown"
}

fn _key_phase(opcode) {
    if opcode == 32 { return "down" }
    if opcode == 33 { return "up" }
    return "unknown"
}

fn _focus_phase(opcode) {
    if opcode == 112 { return "gained" }
    if opcode == 113 { return "lost" }
    return "unknown"
}

fn _composition_phase(opcode) {
    if opcode == 128 { return "update" }
    if opcode == 129 { return "commit" }
    if opcode == 130 { return "cancel" }
    return "unknown"
}

fn decode_event_bytes(ev) {
    if ev == nil { return nil }
    var n = bytes.len(ev)
    if oren_is_err(n) { return n }
    if n < 12 { return oren_err(4, "ui.avm.decode_event_bytes: short event") }
    var ev_view = bytes.view(ev, "ui.avm.decode_event_bytes")
    if oren_is_err(ev_view) { return ev_view }
    if bytes.view_get_u8_unchecked(ev_view, 0) != 79 || bytes.view_get_u8_unchecked(ev_view, 1) != 71 || bytes.view_get_u8_unchecked(ev_view, 2) != 69 || bytes.view_get_u8_unchecked(ev_view, 3) != 48 {
        return oren_err(4, "ui.avm.decode_event_bytes: bad OGE0 magic")
    }
    var opcode = bytes.view_get_u8_unchecked(ev_view, 8)
    if oren_is_err(opcode) { return opcode }
    var payload_len = bytes.view_get_u16_le_unchecked(ev_view, 10)
    if n < 12 + payload_len { return oren_err(4, "ui.avm.decode_event_bytes: truncated payload") }

    if opcode >= 1 && opcode <= 4 {
        if payload_len != 12 { return oren_err(4, "ui.avm.decode_event_bytes: bad pointer payload") }
        var x = bytes.view_get_u32_le_unchecked(ev_view, 12)
        var y = bytes.view_get_u32_le_unchecked(ev_view, 16)
        var pid = bytes.view_get_u32_le_unchecked(ev_view, 20)
        if oren_is_err(x) { return x }
        if oren_is_err(y) { return y }
        if oren_is_err(pid) { return pid }
        return {"kind": "pointer", "phase": _pointer_phase(opcode), "opcode": opcode, "x": x, "y": y, "pointer_id": pid}
    }

    if opcode == 16 {
        if payload_len != 12 { return oren_err(4, "ui.avm.decode_event_bytes: bad resize payload") }
        var w = bytes.view_get_u32_le_unchecked(ev_view, 12)
        var h = bytes.view_get_u32_le_unchecked(ev_view, 16)
        var scale = bytes.view_get_u32_le_unchecked(ev_view, 20)
        if oren_is_err(w) { return w }
        if oren_is_err(h) { return h }
        if oren_is_err(scale) { return scale }
        return {"kind": "resize", "opcode": opcode, "width": w, "height": h, "scale_milli": scale}
    }

    if opcode == 17 {
        if payload_len != 28 { return oren_err(4, "ui.avm.decode_event_bytes: bad media payload") }
        var mw = bytes.view_get_u32_le_unchecked(ev_view, 12)
        var mh = bytes.view_get_u32_le_unchecked(ev_view, 16)
        var mscale = bytes.view_get_u32_le_unchecked(ev_view, 20)
        var drawable_w = bytes.view_get_u32_le_unchecked(ev_view, 24)
        var drawable_h = bytes.view_get_u32_le_unchecked(ev_view, 28)
        var target_hz = bytes.view_get_u32_le_unchecked(ev_view, 32)
        var flags = bytes.view_get_u32_le_unchecked(ev_view, 36)
        if oren_is_err(mw) { return mw }
        if oren_is_err(mh) { return mh }
        if oren_is_err(mscale) { return mscale }
        if oren_is_err(drawable_w) { return drawable_w }
        if oren_is_err(drawable_h) { return drawable_h }
        if oren_is_err(target_hz) { return target_hz }
        if oren_is_err(flags) { return flags }
        return {
            "kind": "media",
            "opcode": opcode,
            "width": mw,
            "height": mh,
            "scale_milli": mscale,
            "drawable_w": drawable_w,
            "drawable_h": drawable_h,
            "target_hz_milli": target_hz,
            "flags": flags
        }
    }

    if opcode == 18 {
        if payload_len != 28 { return oren_err(4, "ui.avm.decode_event_bytes: bad frame_tick payload") }
        var seq = bytes.view_get_u32_le_unchecked(ev_view, 12)
        var now_ns = bytes.view_get_u64_le_unchecked(ev_view, 16)
        var delta_ns = bytes.view_get_u64_le_unchecked(ev_view, 24)
        var tick_hz = bytes.view_get_u32_le_unchecked(ev_view, 32)
        var tick_flags = bytes.view_get_u32_le_unchecked(ev_view, 36)
        if oren_is_err(seq) { return seq }
        if oren_is_err(now_ns) { return now_ns }
        if oren_is_err(delta_ns) { return delta_ns }
        if oren_is_err(tick_hz) { return tick_hz }
        if oren_is_err(tick_flags) { return tick_flags }
        return {
            "kind": "frame_tick",
            "opcode": opcode,
            "sequence": seq,
            "now_ns": now_ns,
            "delta_ns": delta_ns,
            "target_hz_milli": tick_hz,
            "flags": tick_flags
        }
    }

    if opcode == 32 || opcode == 33 {
        if payload_len != 8 { return oren_err(4, "ui.avm.decode_event_bytes: bad key payload") }
        var key_code = bytes.view_get_u32_le_unchecked(ev_view, 12)
        var mods = bytes.view_get_u32_le_unchecked(ev_view, 16)
        if oren_is_err(key_code) { return key_code }
        if oren_is_err(mods) { return mods }
        return {"kind": "key", "phase": _key_phase(opcode), "opcode": opcode, "key_code": key_code, "modifiers": mods}
    }

    if opcode == 48 {
        if payload_len < 4 { return oren_err(4, "ui.avm.decode_event_bytes: bad text payload") }
        var text_len = bytes.view_get_u32_le_unchecked(ev_view, 12)
        if oren_is_err(text_len) { return text_len }
        if text_len != payload_len - 4 { return oren_err(4, "ui.avm.decode_event_bytes: text length mismatch") }
        var text = bytes.to_string_slice(ev, 16, text_len)
        if oren_is_err(text) { return text }
        return {"kind": "text", "opcode": opcode, "text": text}
    }

    if opcode == 64 {
        if payload_len != 24 { return oren_err(4, "ui.avm.decode_event_bytes: bad gamepad payload") }
        var controller_id = bytes.view_get_u32_le_unchecked(ev_view, 12)
        var buttons = bytes.view_get_u32_le_unchecked(ev_view, 16)
        var lx = bytes.view_get_u32_le_unchecked(ev_view, 20)
        var ly = bytes.view_get_u32_le_unchecked(ev_view, 24)
        var rx = bytes.view_get_u32_le_unchecked(ev_view, 28)
        var ry = bytes.view_get_u32_le_unchecked(ev_view, 32)
        if oren_is_err(controller_id) { return controller_id }
        if oren_is_err(buttons) { return buttons }
        if oren_is_err(lx) { return lx }
        if oren_is_err(ly) { return ly }
        if oren_is_err(rx) { return rx }
        if oren_is_err(ry) { return ry }
        return {
            "kind": "gamepad",
            "opcode": opcode,
            "controller_id": controller_id,
            "buttons": buttons,
            "lx_milli": _signed_u32(lx),
            "ly_milli": _signed_u32(ly),
            "rx_milli": _signed_u32(rx),
            "ry_milli": _signed_u32(ry)
        }
    }

    if opcode == 96 {
        if payload_len != 40 { return oren_err(4, "ui.avm.decode_event_bytes: bad motion payload") }
        var source_id = bytes.view_get_u32_le_unchecked(ev_view, 12)
        var motion_seq = bytes.view_get_u32_le_unchecked(ev_view, 16)
        var ts_ns = bytes.view_get_u64_le_unchecked(ev_view, 20)
        var ax = bytes.view_get_u32_le_unchecked(ev_view, 28)
        var ay = bytes.view_get_u32_le_unchecked(ev_view, 32)
        var az = bytes.view_get_u32_le_unchecked(ev_view, 36)
        var gx = bytes.view_get_u32_le_unchecked(ev_view, 40)
        var gy = bytes.view_get_u32_le_unchecked(ev_view, 44)
        var gz = bytes.view_get_u32_le_unchecked(ev_view, 48)
        if oren_is_err(source_id) { return source_id }
        if oren_is_err(motion_seq) { return motion_seq }
        if oren_is_err(ts_ns) { return ts_ns }
        if oren_is_err(ax) { return ax }
        if oren_is_err(ay) { return ay }
        if oren_is_err(az) { return az }
        if oren_is_err(gx) { return gx }
        if oren_is_err(gy) { return gy }
        if oren_is_err(gz) { return gz }
        return {
            "kind": "motion",
            "opcode": opcode,
            "source_id": source_id,
            "sequence": motion_seq,
            "timestamp_ns": ts_ns,
            "accel_x_milli": _signed_u32(ax),
            "accel_y_milli": _signed_u32(ay),
            "accel_z_milli": _signed_u32(az),
            "gyro_x_milli": _signed_u32(gx),
            "gyro_y_milli": _signed_u32(gy),
            "gyro_z_milli": _signed_u32(gz)
        }
    }

    if opcode == 112 || opcode == 113 {
        if payload_len != 8 { return oren_err(4, "ui.avm.decode_event_bytes: bad focus payload") }
        var focus_id = bytes.view_get_u32_le_unchecked(ev_view, 12)
        var focus_flags = bytes.view_get_u32_le_unchecked(ev_view, 16)
        if oren_is_err(focus_id) { return focus_id }
        if oren_is_err(focus_flags) { return focus_flags }
        return {"kind": "focus", "phase": _focus_phase(opcode), "opcode": opcode, "focus_id": focus_id, "flags": focus_flags}
    }

    if opcode >= 128 && opcode <= 130 {
        if payload_len < 12 { return oren_err(4, "ui.avm.decode_event_bytes: bad composition payload") }
        var comp_len = bytes.view_get_u32_le_unchecked(ev_view, 12)
        var sel_start = bytes.view_get_u32_le_unchecked(ev_view, 16)
        var sel_end = bytes.view_get_u32_le_unchecked(ev_view, 20)
        if oren_is_err(comp_len) { return comp_len }
        if oren_is_err(sel_start) { return sel_start }
        if oren_is_err(sel_end) { return sel_end }
        if comp_len != payload_len - 12 { return oren_err(4, "ui.avm.decode_event_bytes: composition length mismatch") }
        var comp_text = bytes.to_string_slice(ev, 24, comp_len)
        if oren_is_err(comp_text) { return comp_text }
        return {
            "kind": "composition",
            "phase": _composition_phase(opcode),
            "opcode": opcode,
            "text": comp_text,
            "selection_start": sel_start,
            "selection_end": sel_end
        }
    }

    return {"kind": "unknown", "opcode": opcode, "payload_len": payload_len}
}

fn next_event() {
    return decode_event_bytes(pull_event_bytes())
}
