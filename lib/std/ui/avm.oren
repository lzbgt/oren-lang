// std:ui/avm (rolling)
//
// AVM graphics bridge for host-rendered UI frames. The production mailbox payload
// is a compact little-endian byte stream; host apps own actual drawing.

import ui_cmds "std:ui/commands"
import ui_color "std:ui/color"
import bytes "std:bytes"

fn _push_u8(out, v) {
    oren_list_push(out, v & 255)
}

fn _push_u16_le(out, v) {
    _push_u8(out, v)
    _push_u8(out, v >> 8)
}

fn _u32_bits(v) {
    if v < 0 { return 4294967296 + v }
    return v
}

fn _push_u32_le(out, v) {
    var x = _u32_bits(v)
    _push_u8(out, x)
    _push_u8(out, x >> 8)
    _push_u8(out, x >> 16)
    _push_u8(out, x >> 24)
}

fn _push_color_rgba(out, s) {
    var c = ui_color.parse_hex(s)
    if oren_is_err(c) { return c }
    _push_u8(out, c["r"])
    _push_u8(out, c["g"])
    _push_u8(out, c["b"])
    _push_u8(out, c["a"])
    return 0
}

fn _append_bytes(out, bs) {
    var n = bytes.try_len(bs)
    if oren_is_err(n) { return n }
    var i = 0
    while i < n {
        var b = bytes.try_get_u8(bs, i)
        if oren_is_err(b) { return b }
        _push_u8(out, b)
        i = i + 1
    }
    return 0
}

fn _push_frame_header(out, w, h, scale_milli, op_count, sequence, drawable_w, drawable_h, target_hz_milli) {
    // Magic "OGF0", version=1, flags=0, header_len=40.
    _push_u8(out, 79)
    _push_u8(out, 71)
    _push_u8(out, 70)
    _push_u8(out, 48)
    _push_u8(out, 1)
    _push_u8(out, 0)
    _push_u16_le(out, 40)
    _push_u32_le(out, w)
    _push_u32_le(out, h)
    _push_u32_le(out, scale_milli)
    _push_u32_le(out, op_count)
    _push_u32_le(out, sequence)
    _push_u32_le(out, drawable_w)
    _push_u32_le(out, drawable_h)
    _push_u32_le(out, target_hz_milli)
}

fn _push_op_header(out, opcode, payload_len) {
    _push_u8(out, opcode)
    _push_u8(out, 0)
    _push_u16_le(out, payload_len)
}

fn _push_cmd(out, c) {
    var op = c["op"]
    if op == "fill_rect" {
        _push_op_header(out, 1, 20)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        return _push_color_rgba(out, c["color"])
    }
    if op == "stroke_line" {
        var lw = c["width"]
        if lw == nil { lw = 1 }
        _push_op_header(out, 3, 24)
        _push_u32_le(out, c["x1"])
        _push_u32_le(out, c["y1"])
        _push_u32_le(out, c["x2"])
        _push_u32_le(out, c["y2"])
        _push_u32_le(out, lw)
        return _push_color_rgba(out, c["color"])
    }
    if op == "circle" {
        var fill = c["fill"]
        if fill == nil { fill = true }
        var flags = 0
        if fill != 0 { flags = flags | 1 }
        _push_op_header(out, 4, 20)
        _push_u32_le(out, c["cx"])
        _push_u32_le(out, c["cy"])
        _push_u32_le(out, c["r"])
        _push_u32_le(out, flags)
        return _push_color_rgba(out, c["color"])
    }
    if op == "text" {
        var tb = bytes.try_from_string(c["text"])
        if oren_is_err(tb) { return tb }
        var tn = bytes.try_len(tb)
        if oren_is_err(tn) { return tn }
        if tn > 65519 { return oren_err(4, "ui.avm.frame_bytes: text too large") }
        _push_op_header(out, 2, 16 + tn)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        var rc = _push_color_rgba(out, c["color"])
        if oren_is_err(rc) { return rc }
        _push_u32_le(out, tn)
        return _append_bytes(out, tb)
    }
    return oren_err(4, "ui.avm.frame_bytes: unsupported op")
}

fn frame_bytes(cmds, w, h, opts) {
    if opts == nil { opts = {} }
    var vr = ui_cmds.try_validate(cmds, w, h, opts)
    if oren_is_err(vr) { return vr }

    var scale_milli = opts["scale_milli"]
    if scale_milli == nil { scale_milli = opts["scale"] }
    if scale_milli == nil { scale_milli = 1000 }
    var sequence = opts["sequence"]
    if sequence == nil { sequence = 0 }
    var drawable_w = opts["drawable_w"]
    if drawable_w == nil { drawable_w = w }
    var drawable_h = opts["drawable_h"]
    if drawable_h == nil { drawable_h = h }
    var target_hz_milli = opts["target_hz_milli"]
    if target_hz_milli == nil { target_hz_milli = 0 }
    var out = []
    _push_frame_header(out, w, h, scale_milli, oren_list_len(cmds), sequence, drawable_w, drawable_h, target_hz_milli)

    var i = 0
    while i < oren_list_len(cmds) {
        var rc = _push_cmd(out, cmds[i])
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return bytes.try_pack(out)
}

fn present_bytes(frame) {
    return oren_gfx_present_frame(frame)
}

fn present_frame(cmds, w, h, opts) {
    var frame = frame_bytes(cmds, w, h, opts)
    if oren_is_err(frame) { return frame }
    return present_bytes(frame)
}

fn pull_event_bytes() {
    return oren_gfx_poll_input()
}

fn poll_event_bytes() {
    return pull_event_bytes()
}

fn screen(id) {
    if id == nil { id = 0 }
    return oren_gfx_screen(id)
}

fn screen0() {
    return screen(0)
}

fn screen_available(id) {
    return screen(id) != nil
}

fn _read_u16_le(bs, off, ctx) {
    var b0 = bytes.try_get_u8(bs, off)
    if oren_is_err(b0) { return oren_err(4, ctx + ": truncated u16") }
    var b1 = bytes.try_get_u8(bs, off + 1)
    if oren_is_err(b1) { return oren_err(4, ctx + ": truncated u16") }
    return b0 | (b1 << 8)
}

fn _read_u32_le(bs, off, ctx) {
    var v = oren_bytes_get_u32_le(bs, off)
    if oren_is_err(v) { return oren_err(4, ctx + ": truncated u32") }
    return v
}

fn _pointer_phase(opcode) {
    if opcode == 1 { return "down" }
    if opcode == 2 { return "move" }
    if opcode == 3 { return "up" }
    if opcode == 4 { return "cancel" }
    return "unknown"
}

fn _key_phase(opcode) {
    if opcode == 32 { return "down" }
    if opcode == 33 { return "up" }
    return "unknown"
}

fn decode_event_bytes(ev) {
    if ev == nil { return nil }
    var n = bytes.try_len(ev)
    if oren_is_err(n) { return n }
    if n < 12 { return oren_err(4, "ui.avm.decode_event_bytes: short event") }
    if bytes.try_get_u8(ev, 0) != 79 || bytes.try_get_u8(ev, 1) != 71 || bytes.try_get_u8(ev, 2) != 69 || bytes.try_get_u8(ev, 3) != 48 {
        return oren_err(4, "ui.avm.decode_event_bytes: bad OGE0 magic")
    }
    var opcode = bytes.try_get_u8(ev, 8)
    if oren_is_err(opcode) { return opcode }
    var payload_len = _read_u16_le(ev, 10, "ui.avm.decode_event_bytes")
    if oren_is_err(payload_len) { return payload_len }
    if n < 12 + payload_len { return oren_err(4, "ui.avm.decode_event_bytes: truncated payload") }

    if opcode >= 1 && opcode <= 4 {
        if payload_len != 12 { return oren_err(4, "ui.avm.decode_event_bytes: bad pointer payload") }
        var x = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var y = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        var pid = _read_u32_le(ev, 20, "ui.avm.decode_event_bytes")
        if oren_is_err(x) { return x }
        if oren_is_err(y) { return y }
        if oren_is_err(pid) { return pid }
        return {"kind": "pointer", "phase": _pointer_phase(opcode), "opcode": opcode, "x": x, "y": y, "pointer_id": pid}
    }

    if opcode == 16 {
        if payload_len != 12 { return oren_err(4, "ui.avm.decode_event_bytes: bad resize payload") }
        var w = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var h = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        var scale = _read_u32_le(ev, 20, "ui.avm.decode_event_bytes")
        if oren_is_err(w) { return w }
        if oren_is_err(h) { return h }
        if oren_is_err(scale) { return scale }
        return {"kind": "resize", "opcode": opcode, "width": w, "height": h, "scale_milli": scale}
    }

    if opcode == 17 {
        if payload_len != 28 { return oren_err(4, "ui.avm.decode_event_bytes: bad media payload") }
        var mw = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var mh = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        var mscale = _read_u32_le(ev, 20, "ui.avm.decode_event_bytes")
        var drawable_w = _read_u32_le(ev, 24, "ui.avm.decode_event_bytes")
        var drawable_h = _read_u32_le(ev, 28, "ui.avm.decode_event_bytes")
        var target_hz = _read_u32_le(ev, 32, "ui.avm.decode_event_bytes")
        var flags = _read_u32_le(ev, 36, "ui.avm.decode_event_bytes")
        if oren_is_err(mw) { return mw }
        if oren_is_err(mh) { return mh }
        if oren_is_err(mscale) { return mscale }
        if oren_is_err(drawable_w) { return drawable_w }
        if oren_is_err(drawable_h) { return drawable_h }
        if oren_is_err(target_hz) { return target_hz }
        if oren_is_err(flags) { return flags }
        return {
            "kind": "media",
            "opcode": opcode,
            "width": mw,
            "height": mh,
            "scale_milli": mscale,
            "drawable_w": drawable_w,
            "drawable_h": drawable_h,
            "target_hz_milli": target_hz,
            "flags": flags
        }
    }

    if opcode == 32 || opcode == 33 {
        if payload_len != 8 { return oren_err(4, "ui.avm.decode_event_bytes: bad key payload") }
        var key_code = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var mods = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        if oren_is_err(key_code) { return key_code }
        if oren_is_err(mods) { return mods }
        return {"kind": "key", "phase": _key_phase(opcode), "opcode": opcode, "key_code": key_code, "modifiers": mods}
    }

    if opcode == 48 {
        if payload_len < 4 { return oren_err(4, "ui.avm.decode_event_bytes: bad text payload") }
        var text_len = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        if oren_is_err(text_len) { return text_len }
        if text_len != payload_len - 4 { return oren_err(4, "ui.avm.decode_event_bytes: text length mismatch") }
        var text_bytes = bytes.try_slice(ev, 16, text_len)
        if oren_is_err(text_bytes) { return text_bytes }
        var text = bytes.try_to_string(text_bytes)
        if oren_is_err(text) { return text }
        return {"kind": "text", "opcode": opcode, "text": text}
    }

    return {"kind": "unknown", "opcode": opcode, "payload_len": payload_len}
}

fn next_event() {
    return decode_event_bytes(pull_event_bytes())
}
