// std:ui/avm (rolling)
//
// AVM graphics bridge for host-rendered UI frames. The production mailbox payload
// is a compact little-endian byte stream; host apps own actual drawing.

import ui_cmds "std:ui/commands"
import ui_color "std:ui/color"
import bytes "std:bytes"

fn _push_u8(out, v) {
    oren_list_push(out, v & 255)
}

fn _push_u16_le(out, v) {
    _push_u8(out, v)
    _push_u8(out, v >> 8)
}

fn _u32_bits(v) {
    if v < 0 { return 4294967296 + v }
    return v
}

fn _push_u32_le(out, v) {
    var x = _u32_bits(v)
    _push_u8(out, x)
    _push_u8(out, x >> 8)
    _push_u8(out, x >> 16)
    _push_u8(out, x >> 24)
}

fn _push_color_rgba(out, s) {
    var c = ui_color.parse_hex(s)
    if oren_is_err(c) { return c }
    _push_u8(out, c["r"])
    _push_u8(out, c["g"])
    _push_u8(out, c["b"])
    _push_u8(out, c["a"])
    return 0
}

fn _truthy_flag(v) {
    if v == nil { return false }
    if v == false { return false }
    if v == 0 { return false }
    return true
}

fn _append_bytes(out, bs) {
    var n = bytes.try_len(bs)
    if oren_is_err(n) { return n }
    var i = 0
    while i < n {
        var b = bytes.try_get_u8(bs, i)
        if oren_is_err(b) { return b }
        _push_u8(out, b)
        i = i + 1
    }
    return 0
}

fn _push_frame_header(out, w, h, scale_milli, op_count, sequence, drawable_w, drawable_h, target_hz_milli) {
    // Magic "OGF0", version=1, flags=0, header_len=40.
    _push_u8(out, 79)
    _push_u8(out, 71)
    _push_u8(out, 70)
    _push_u8(out, 48)
    _push_u8(out, 1)
    _push_u8(out, 0)
    _push_u16_le(out, 40)
    _push_u32_le(out, w)
    _push_u32_le(out, h)
    _push_u32_le(out, scale_milli)
    _push_u32_le(out, op_count)
    _push_u32_le(out, sequence)
    _push_u32_le(out, drawable_w)
    _push_u32_le(out, drawable_h)
    _push_u32_le(out, target_hz_milli)
}

fn _push_op_header(out, opcode, payload_len) {
    _push_u8(out, opcode)
    _push_u8(out, 0)
    _push_u16_le(out, payload_len)
}

fn _push_cmd(out, c) {
    var op = c["op"]
    if op == "fill_rect" {
        _push_op_header(out, 1, 20)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        return _push_color_rgba(out, c["color"])
    }
    if op == "stroke_line" {
        var lw = c["width"]
        if lw == nil { lw = 1 }
        _push_op_header(out, 3, 24)
        _push_u32_le(out, c["x1"])
        _push_u32_le(out, c["y1"])
        _push_u32_le(out, c["x2"])
        _push_u32_le(out, c["y2"])
        _push_u32_le(out, lw)
        return _push_color_rgba(out, c["color"])
    }
    if op == "stroke_rect" {
        var rw = c["width"]
        if rw == nil { rw = 1 }
        _push_op_header(out, 6, 24)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        _push_u32_le(out, rw)
        return _push_color_rgba(out, c["color"])
    }
    if op == "circle" {
        var fill = c["fill"]
        if fill == nil { fill = true }
        var flags = 0
        if _truthy_flag(fill) { flags = flags | 1 }
        _push_op_header(out, 4, 20)
        _push_u32_le(out, c["cx"])
        _push_u32_le(out, c["cy"])
        _push_u32_le(out, c["r"])
        _push_u32_le(out, flags)
        return _push_color_rgba(out, c["color"])
    }
    if op == "ellipse" {
        var efill = c["fill"]
        if efill == nil { efill = true }
        var eflags = 0
        if _truthy_flag(efill) { eflags = eflags | 1 }
        var elw = c["width"]
        if elw == nil { elw = 1 }
        _push_op_header(out, 7, 28)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        _push_u32_le(out, elw)
        _push_u32_le(out, eflags)
        return _push_color_rgba(out, c["color"])
    }
    if op == "polyline" {
        var points = c["points"]
        var pn = bytes.try_len(points)
        if oren_is_err(pn) { return pn }
        if pn < 16 || pn > 65520 || pn % 8 != 0 { return oren_err(4, "ui.avm.frame_bytes: polyline invalid point bytes") }
        var plw = c["width"]
        if plw == nil { plw = 1 }
        _push_op_header(out, 8, 12 + pn)
        _push_u32_le(out, plw)
        _push_u32_le(out, pn / 8)
        var prc = _push_color_rgba(out, c["color"])
        if oren_is_err(prc) { return prc }
        return _append_bytes(out, points)
    }
    if op == "fill_triangle" {
        _push_op_header(out, 5, 28)
        _push_u32_le(out, c["x1"])
        _push_u32_le(out, c["y1"])
        _push_u32_le(out, c["x2"])
        _push_u32_le(out, c["y2"])
        _push_u32_le(out, c["x3"])
        _push_u32_le(out, c["y3"])
        return _push_color_rgba(out, c["color"])
    }
    if op == "text" {
        var tb = bytes.try_from_string(c["text"])
        if oren_is_err(tb) { return tb }
        var tn = bytes.try_len(tb)
        if oren_is_err(tn) { return tn }
        if tn > 65519 { return oren_err(4, "ui.avm.frame_bytes: text too large") }
        _push_op_header(out, 2, 16 + tn)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        var rc = _push_color_rgba(out, c["color"])
        if oren_is_err(rc) { return rc }
        _push_u32_le(out, tn)
        return _append_bytes(out, tb)
    }
    if op == "text_bytes" {
        var tb2 = c["data"]
        var tn2 = bytes.try_len(tb2)
        if oren_is_err(tn2) { return tn2 }
        if tn2 > 65519 { return oren_err(4, "ui.avm.frame_bytes: text_bytes too large") }
        _push_op_header(out, 2, 16 + tn2)
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        var rc2 = _push_color_rgba(out, c["color"])
        if oren_is_err(rc2) { return rc2 }
        _push_u32_le(out, tn2)
        return _append_bytes(out, tb2)
    }
    if op == "text_resource" {
        var trb = c["data"]
        var trn = bytes.try_len(trb)
        if oren_is_err(trn) { return trn }
        if trn > 65519 { return oren_err(4, "ui.avm.frame_bytes: text_resource too large") }
        _push_op_header(out, 68, 12 + trn)
        _push_u32_le(out, c["id"])
        var trc = _push_color_rgba(out, c["color"])
        if oren_is_err(trc) { return trc }
        _push_u32_le(out, trn)
        return _append_bytes(out, trb)
    }
    if op == "draw_text" {
        _push_op_header(out, 69, 12)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        return 0
    }
    if op == "destroy_text" {
        _push_op_header(out, 70, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "image_rgba" {
        var ib = c["data"]
        var image_n = bytes.try_len(ib)
        if oren_is_err(image_n) { return image_n }
        if image_n > 65519 { return oren_err(4, "ui.avm.frame_bytes: image_rgba too large") }
        _push_op_header(out, 64, 16 + image_n)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        _push_u32_le(out, image_n)
        return _append_bytes(out, ib)
    }
    if op == "draw_image" {
        _push_op_header(out, 65, 20)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        return 0
    }
    if op == "destroy_image" {
        _push_op_header(out, 66, 4)
        _push_u32_le(out, c["id"])
        return 0
    }
    if op == "draw_image_rect" {
        _push_op_header(out, 67, 36)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, c["sx"])
        _push_u32_le(out, c["sy"])
        _push_u32_le(out, c["sw"])
        _push_u32_le(out, c["sh"])
        _push_u32_le(out, c["x"])
        _push_u32_le(out, c["y"])
        _push_u32_le(out, c["w"])
        _push_u32_le(out, c["h"])
        return 0
    }
    if op == "draw_image_rects" {
        var rects = c["rects"]
        var rn = bytes.try_len(rects)
        if oren_is_err(rn) { return rn }
        if rn == 0 || rn > 65504 || rn % 32 != 0 { return oren_err(4, "ui.avm.frame_bytes: draw_image_rects invalid rect bytes") }
        _push_op_header(out, 71, 8 + rn)
        _push_u32_le(out, c["id"])
        _push_u32_le(out, rn / 32)
        return _append_bytes(out, rects)
    }
    return oren_err(4, "ui.avm.frame_bytes: unsupported op")
}

fn frame_bytes(cmds, w, h, opts) {
    if opts == nil { opts = {} }
    var vr = ui_cmds.try_validate(cmds, w, h, opts)
    if oren_is_err(vr) { return vr }

    var scale_milli = opts["scale_milli"]
    if scale_milli == nil { scale_milli = opts["scale"] }
    if scale_milli == nil { scale_milli = 1000 }
    var sequence = opts["sequence"]
    if sequence == nil { sequence = 0 }
    var drawable_w = opts["drawable_w"]
    if drawable_w == nil { drawable_w = w }
    var drawable_h = opts["drawable_h"]
    if drawable_h == nil { drawable_h = h }
    var target_hz_milli = opts["target_hz_milli"]
    if target_hz_milli == nil { target_hz_milli = 0 }
    var out = []
    _push_frame_header(out, w, h, scale_milli, oren_list_len(cmds), sequence, drawable_w, drawable_h, target_hz_milli)

    var i = 0
    while i < oren_list_len(cmds) {
        var rc = _push_cmd(out, cmds[i])
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return bytes.try_pack(out)
}

fn present_bytes(frame) {
    return oren_gfx_present_frame(frame)
}

fn present_frame(cmds, w, h, opts) {
    var frame = frame_bytes(cmds, w, h, opts)
    if oren_is_err(frame) { return frame }
    return present_bytes(frame)
}

fn pull_event_bytes() {
    return oren_gfx_poll_input()
}

fn poll_event_bytes() {
    return pull_event_bytes()
}

fn screen(id) {
    if id == nil { id = 0 }
    return oren_gfx_screen(id)
}

fn screen0() {
    return screen(0)
}

fn screen_available(id) {
    return screen(id) != nil
}

fn _read_u16_le(bs, off, ctx) {
    var b0 = bytes.try_get_u8(bs, off)
    if oren_is_err(b0) { return oren_err(4, ctx + ": truncated u16") }
    var b1 = bytes.try_get_u8(bs, off + 1)
    if oren_is_err(b1) { return oren_err(4, ctx + ": truncated u16") }
    return b0 | (b1 << 8)
}

fn _read_u32_le(bs, off, ctx) {
    var v = oren_bytes_get_u32_le(bs, off)
    if oren_is_err(v) { return oren_err(4, ctx + ": truncated u32") }
    return v
}

fn _read_u64_le(bs, off, ctx) {
    var v = oren_bytes_get_u64_le(bs, off)
    if oren_is_err(v) { return oren_err(4, ctx + ": truncated u64") }
    return v
}

fn _signed_u32(v) {
    if v >= 2147483648 { return v - 4294967296 }
    return v
}

fn _pointer_phase(opcode) {
    if opcode == 1 { return "down" }
    if opcode == 2 { return "move" }
    if opcode == 3 { return "up" }
    if opcode == 4 { return "cancel" }
    return "unknown"
}

fn _key_phase(opcode) {
    if opcode == 32 { return "down" }
    if opcode == 33 { return "up" }
    return "unknown"
}

fn _focus_phase(opcode) {
    if opcode == 112 { return "gained" }
    if opcode == 113 { return "lost" }
    return "unknown"
}

fn _composition_phase(opcode) {
    if opcode == 128 { return "update" }
    if opcode == 129 { return "commit" }
    if opcode == 130 { return "cancel" }
    return "unknown"
}

fn decode_event_bytes(ev) {
    if ev == nil { return nil }
    var n = bytes.try_len(ev)
    if oren_is_err(n) { return n }
    if n < 12 { return oren_err(4, "ui.avm.decode_event_bytes: short event") }
    if bytes.try_get_u8(ev, 0) != 79 || bytes.try_get_u8(ev, 1) != 71 || bytes.try_get_u8(ev, 2) != 69 || bytes.try_get_u8(ev, 3) != 48 {
        return oren_err(4, "ui.avm.decode_event_bytes: bad OGE0 magic")
    }
    var opcode = bytes.try_get_u8(ev, 8)
    if oren_is_err(opcode) { return opcode }
    var payload_len = _read_u16_le(ev, 10, "ui.avm.decode_event_bytes")
    if oren_is_err(payload_len) { return payload_len }
    if n < 12 + payload_len { return oren_err(4, "ui.avm.decode_event_bytes: truncated payload") }

    if opcode >= 1 && opcode <= 4 {
        if payload_len != 12 { return oren_err(4, "ui.avm.decode_event_bytes: bad pointer payload") }
        var x = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var y = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        var pid = _read_u32_le(ev, 20, "ui.avm.decode_event_bytes")
        if oren_is_err(x) { return x }
        if oren_is_err(y) { return y }
        if oren_is_err(pid) { return pid }
        return {"kind": "pointer", "phase": _pointer_phase(opcode), "opcode": opcode, "x": x, "y": y, "pointer_id": pid}
    }

    if opcode == 16 {
        if payload_len != 12 { return oren_err(4, "ui.avm.decode_event_bytes: bad resize payload") }
        var w = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var h = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        var scale = _read_u32_le(ev, 20, "ui.avm.decode_event_bytes")
        if oren_is_err(w) { return w }
        if oren_is_err(h) { return h }
        if oren_is_err(scale) { return scale }
        return {"kind": "resize", "opcode": opcode, "width": w, "height": h, "scale_milli": scale}
    }

    if opcode == 17 {
        if payload_len != 28 { return oren_err(4, "ui.avm.decode_event_bytes: bad media payload") }
        var mw = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var mh = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        var mscale = _read_u32_le(ev, 20, "ui.avm.decode_event_bytes")
        var drawable_w = _read_u32_le(ev, 24, "ui.avm.decode_event_bytes")
        var drawable_h = _read_u32_le(ev, 28, "ui.avm.decode_event_bytes")
        var target_hz = _read_u32_le(ev, 32, "ui.avm.decode_event_bytes")
        var flags = _read_u32_le(ev, 36, "ui.avm.decode_event_bytes")
        if oren_is_err(mw) { return mw }
        if oren_is_err(mh) { return mh }
        if oren_is_err(mscale) { return mscale }
        if oren_is_err(drawable_w) { return drawable_w }
        if oren_is_err(drawable_h) { return drawable_h }
        if oren_is_err(target_hz) { return target_hz }
        if oren_is_err(flags) { return flags }
        return {
            "kind": "media",
            "opcode": opcode,
            "width": mw,
            "height": mh,
            "scale_milli": mscale,
            "drawable_w": drawable_w,
            "drawable_h": drawable_h,
            "target_hz_milli": target_hz,
            "flags": flags
        }
    }

    if opcode == 18 {
        if payload_len != 28 { return oren_err(4, "ui.avm.decode_event_bytes: bad frame_tick payload") }
        var seq = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var now_ns = _read_u64_le(ev, 16, "ui.avm.decode_event_bytes")
        var delta_ns = _read_u64_le(ev, 24, "ui.avm.decode_event_bytes")
        var tick_hz = _read_u32_le(ev, 32, "ui.avm.decode_event_bytes")
        var tick_flags = _read_u32_le(ev, 36, "ui.avm.decode_event_bytes")
        if oren_is_err(seq) { return seq }
        if oren_is_err(now_ns) { return now_ns }
        if oren_is_err(delta_ns) { return delta_ns }
        if oren_is_err(tick_hz) { return tick_hz }
        if oren_is_err(tick_flags) { return tick_flags }
        return {
            "kind": "frame_tick",
            "opcode": opcode,
            "sequence": seq,
            "now_ns": now_ns,
            "delta_ns": delta_ns,
            "target_hz_milli": tick_hz,
            "flags": tick_flags
        }
    }

    if opcode == 32 || opcode == 33 {
        if payload_len != 8 { return oren_err(4, "ui.avm.decode_event_bytes: bad key payload") }
        var key_code = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var mods = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        if oren_is_err(key_code) { return key_code }
        if oren_is_err(mods) { return mods }
        return {"kind": "key", "phase": _key_phase(opcode), "opcode": opcode, "key_code": key_code, "modifiers": mods}
    }

    if opcode == 48 {
        if payload_len < 4 { return oren_err(4, "ui.avm.decode_event_bytes: bad text payload") }
        var text_len = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        if oren_is_err(text_len) { return text_len }
        if text_len != payload_len - 4 { return oren_err(4, "ui.avm.decode_event_bytes: text length mismatch") }
        var text_bytes = bytes.try_slice(ev, 16, text_len)
        if oren_is_err(text_bytes) { return text_bytes }
        var text = bytes.try_to_string(text_bytes)
        if oren_is_err(text) { return text }
        return {"kind": "text", "opcode": opcode, "text": text}
    }

    if opcode == 64 {
        if payload_len != 24 { return oren_err(4, "ui.avm.decode_event_bytes: bad gamepad payload") }
        var controller_id = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var buttons = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        var lx = _read_u32_le(ev, 20, "ui.avm.decode_event_bytes")
        var ly = _read_u32_le(ev, 24, "ui.avm.decode_event_bytes")
        var rx = _read_u32_le(ev, 28, "ui.avm.decode_event_bytes")
        var ry = _read_u32_le(ev, 32, "ui.avm.decode_event_bytes")
        if oren_is_err(controller_id) { return controller_id }
        if oren_is_err(buttons) { return buttons }
        if oren_is_err(lx) { return lx }
        if oren_is_err(ly) { return ly }
        if oren_is_err(rx) { return rx }
        if oren_is_err(ry) { return ry }
        return {
            "kind": "gamepad",
            "opcode": opcode,
            "controller_id": controller_id,
            "buttons": buttons,
            "lx_milli": _signed_u32(lx),
            "ly_milli": _signed_u32(ly),
            "rx_milli": _signed_u32(rx),
            "ry_milli": _signed_u32(ry)
        }
    }

    if opcode == 96 {
        if payload_len != 40 { return oren_err(4, "ui.avm.decode_event_bytes: bad motion payload") }
        var source_id = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var motion_seq = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        var ts_ns = _read_u64_le(ev, 20, "ui.avm.decode_event_bytes")
        var ax = _read_u32_le(ev, 28, "ui.avm.decode_event_bytes")
        var ay = _read_u32_le(ev, 32, "ui.avm.decode_event_bytes")
        var az = _read_u32_le(ev, 36, "ui.avm.decode_event_bytes")
        var gx = _read_u32_le(ev, 40, "ui.avm.decode_event_bytes")
        var gy = _read_u32_le(ev, 44, "ui.avm.decode_event_bytes")
        var gz = _read_u32_le(ev, 48, "ui.avm.decode_event_bytes")
        if oren_is_err(source_id) { return source_id }
        if oren_is_err(motion_seq) { return motion_seq }
        if oren_is_err(ts_ns) { return ts_ns }
        if oren_is_err(ax) { return ax }
        if oren_is_err(ay) { return ay }
        if oren_is_err(az) { return az }
        if oren_is_err(gx) { return gx }
        if oren_is_err(gy) { return gy }
        if oren_is_err(gz) { return gz }
        return {
            "kind": "motion",
            "opcode": opcode,
            "source_id": source_id,
            "sequence": motion_seq,
            "timestamp_ns": ts_ns,
            "accel_x_milli": _signed_u32(ax),
            "accel_y_milli": _signed_u32(ay),
            "accel_z_milli": _signed_u32(az),
            "gyro_x_milli": _signed_u32(gx),
            "gyro_y_milli": _signed_u32(gy),
            "gyro_z_milli": _signed_u32(gz)
        }
    }

    if opcode == 112 || opcode == 113 {
        if payload_len != 8 { return oren_err(4, "ui.avm.decode_event_bytes: bad focus payload") }
        var focus_id = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var focus_flags = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        if oren_is_err(focus_id) { return focus_id }
        if oren_is_err(focus_flags) { return focus_flags }
        return {"kind": "focus", "phase": _focus_phase(opcode), "opcode": opcode, "focus_id": focus_id, "flags": focus_flags}
    }

    if opcode >= 128 && opcode <= 130 {
        if payload_len < 12 { return oren_err(4, "ui.avm.decode_event_bytes: bad composition payload") }
        var comp_len = _read_u32_le(ev, 12, "ui.avm.decode_event_bytes")
        var sel_start = _read_u32_le(ev, 16, "ui.avm.decode_event_bytes")
        var sel_end = _read_u32_le(ev, 20, "ui.avm.decode_event_bytes")
        if oren_is_err(comp_len) { return comp_len }
        if oren_is_err(sel_start) { return sel_start }
        if oren_is_err(sel_end) { return sel_end }
        if comp_len != payload_len - 12 { return oren_err(4, "ui.avm.decode_event_bytes: composition length mismatch") }
        var comp_bytes = bytes.try_slice(ev, 24, comp_len)
        if oren_is_err(comp_bytes) { return comp_bytes }
        var comp_text = bytes.try_to_string(comp_bytes)
        if oren_is_err(comp_text) { return comp_text }
        return {
            "kind": "composition",
            "phase": _composition_phase(opcode),
            "opcode": opcode,
            "text": comp_text,
            "selection_start": sel_start,
            "selection_end": sel_end
        }
    }

    return {"kind": "unknown", "opcode": opcode, "payload_len": payload_len}
}

fn next_event() {
    return decode_event_bytes(pull_event_bytes())
}
