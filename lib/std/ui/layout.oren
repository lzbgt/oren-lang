// std:ui/layout (rolling)
//
// Minimal deterministic layout engine for early GUI bring-up and headless tests.
//
// Supported tags (v0):
// - "Box": fixed size from props {w,h}
// - "Text": fixed size from props {w,h} (no measurement yet)
// - "Row": children laid out left-to-right
// - "Column": children laid out top-to-bottom
// - "Stack": children overlaid at (0,0)
//
// Layout output is a "box tree" (map):
//   {"t":<tag>, "k":<key>, "x":<int>, "y":<int>, "w":<int>, "h":<int>, "children":[...]}

fn _i(v) {
    if v == nil { return 0 }
    return v
}

fn _leaf_size(n) {
    var p = n["p"]
    if p == nil { p = {} }
    return {"w": _i(p["w"]), "h": _i(p["h"])}
}

fn _box(tag, key, x, y, w, h, children_boxes) {
    if children_boxes == nil { children_boxes = [] }
    return {"t": tag, "k": key, "x": x, "y": y, "w": w, "h": h, "children": children_boxes}
}

fn layout(root, constraints) {
    // constraints is currently reserved for future use (max_w/max_h).
    // v0 ignores constraints and uses only intrinsic sizes.
    return _layout_at(root, 0, 0)
}

fn _layout_at(n, x0, y0) {
    if n == nil { return _box("Nil", "nil", x0, y0, 0, 0, []) }

    var tag = n["t"]
    var key = n["k"]
    var cs = n["c"]
    if cs == nil { cs = [] }

    if tag == "Box" || tag == "Text" {
        var sz = _leaf_size(n)
        return _box(tag, key, x0, y0, sz["w"], sz["h"], [])
    }

    if tag == "Row" {
        var out_children = []
        var x = x0
        var wsum = 0
        var hmax = 0
        var i = 0
        while i < oren_list_len(cs) {
            var cb = _layout_at(cs[i], x, y0)
            oren_list_push(out_children, cb)
            var cw = cb["w"]
            var ch = cb["h"]
            x = x + cw
            wsum = wsum + cw
            if ch > hmax { hmax = ch }
            i = i + 1
        }
        return _box(tag, key, x0, y0, wsum, hmax, out_children)
    }

    if tag == "Column" {
        var out_children2 = []
        var y = y0
        var hsum = 0
        var wmax = 0
        var j = 0
        while j < oren_list_len(cs) {
            var cb2 = _layout_at(cs[j], x0, y)
            oren_list_push(out_children2, cb2)
            var cw2 = cb2["w"]
            var ch2 = cb2["h"]
            y = y + ch2
            hsum = hsum + ch2
            if cw2 > wmax { wmax = cw2 }
            j = j + 1
        }
        return _box(tag, key, x0, y0, wmax, hsum, out_children2)
    }

    if tag == "Stack" {
        var out_children3 = []
        var wmax2 = 0
        var hmax2 = 0
        var k = 0
        while k < oren_list_len(cs) {
            var cb3 = _layout_at(cs[k], x0, y0)
            oren_list_push(out_children3, cb3)
            var cw3 = cb3["w"]
            var ch3 = cb3["h"]
            if cw3 > wmax2 { wmax2 = cw3 }
            if ch3 > hmax2 { hmax2 = ch3 }
            k = k + 1
        }
        return _box(tag, key, x0, y0, wmax2, hmax2, out_children3)
    }

    // Unknown tag: treat as zero-sized container, still layout children at origin.
    var out_children4 = []
    var m = 0
    while m < oren_list_len(cs) {
        oren_list_push(out_children4, _layout_at(cs[m], x0, y0))
        m = m + 1
    }
    return _box(tag, key, x0, y0, 0, 0, out_children4)
}

