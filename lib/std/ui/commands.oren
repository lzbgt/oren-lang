// std:ui/commands (rolling)
//
// Validation and normalization helpers for the render command buffer schema.
//
// This module exists so:
// - headless rasterizer and future platform shims can share a single validator
// - tests can assert that emitters produce valid command buffers
//
// See `docs/DESIGN.md#ui-v0-schema-headless-core` for the current v0 schema.

import ui_color "std:ui/color"
import bytes "std:bytes"

fn _is_int(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 1 { return true }
    if tag == 0 || tag == 3 || tag == 4 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn _is_string(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 4 { return true }
    if tag == 0 || tag == 1 || tag == 3 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var n = oren_string_len(v)
    if n == nil { return false }
    return oren_is_err(n) == false
}

fn _hex_ok(s) {
    // Accept "#RRGGBB" or "#RRGGBBAA" (case-insensitive hex).
    return ui_color.is_hex(s)
}

fn _bytes_ptr_or_nil(bs) {
    if oren_is_u8_buf(bs) == true { return oren_buf_data_ptr_unchecked(bs) }
    return nil
}

fn _u32_le_from_ptr(p, off) {
    return (ptr_get_byte(p + off) & 255) |
        ((ptr_get_byte(p + off + 1) & 255) << 8) |
        ((ptr_get_byte(p + off + 2) & 255) << 16) |
        ((ptr_get_byte(p + off + 3) & 255) << 24)
}

fn _read_u32_le(bs, data, off) {
    if data != nil { return _u32_le_from_ptr(data, off) }
    return bytes.get_u32_le(bs, off)
}

fn _read_i32_le(bs, data, off) {
    var v = _read_u32_le(bs, data, off)
    if oren_is_err(v) { return v }
    if v >= 2147483648 { return v - 4294967296 }
    return v
}

fn validate(cmds, w, h, opts) {
    // Returns:
    // - 0 on success
    // - err on failure
    //
    // opts (rolling):
    // - strict_bounds: bool (default false) — reject ops that extend outside the framebuffer.
    // - max_image_bytes: int (optional) — reject frames uploading more RGBA image bytes.
    // - max_image_count: int (optional) — reject frames uploading more retained images.
    if opts == nil { opts = {} }
    var strict = opts["strict_bounds"]
    if strict == nil { strict = false }
    strict = strict != 0
    var max_image_bytes = opts["max_image_bytes"]
    var max_image_count = opts["max_image_count"]
    var image_bytes = 0
    var image_count = 0
    var clip_depth = 0
    var transform_depth = 0
    var transform_stack = {}
    var opacity_depth = 0
    var camera_depth = 0
    var state_depth = 0
    var state_stack = {}
    var tx = 0
    var ty = 0
    if max_image_bytes != nil && (_is_int(max_image_bytes) == false || max_image_bytes < 0) {
        return oren_err(4, "ui.validate: invalid max_image_bytes")
    }
    if max_image_count != nil && (_is_int(max_image_count) == false || max_image_count < 0) {
        return oren_err(4, "ui.validate: invalid max_image_count")
    }

    if _is_int(w) == false || _is_int(h) == false { return oren_err(4, "ui.validate: invalid framebuffer size") }
    if w < 0 || h < 0 { return oren_err(4, "ui.validate: negative framebuffer size") }

    if cmds == nil { return 0 }
    // Lists are the only stable "sequence" container across backends right now.
    // In some backends `oren_list_len(non_list)` yields nil rather than an error.
    var _n = oren_list_len(cmds)
    if _n == nil || oren_is_err(_n) { return oren_err(4, "ui.validate: cmds must be list") }

    var i = 0
    while i < oren_list_len(cmds) {
        var c = cmds[i]
        if c == nil { return oren_err(4, "ui.validate: cmd is nil") }
        // Command is expected to be a map-like value (indexing by string keys).
        var op = c["op"]
        if _is_string(op) == false { return oren_err(4, "ui.validate: cmd missing op") }

        if op == "fill_rect" {
            var x = c["x"]; var y = c["y"]; var rw = c["w"]; var rh = c["h"]; var col = c["color"]
            if _is_int(x) == false || _is_int(y) == false || _is_int(rw) == false || _is_int(rh) == false { return oren_err(4, "ui.validate: fill_rect expects int x,y,w,h") }
            if rw < 0 || rh < 0 { return oren_err(4, "ui.validate: fill_rect negative size") }
            if _hex_ok(col) == false { return oren_err(4, "ui.validate: fill_rect invalid color") }
            if strict {
                var x_t = x + tx; var y_t = y + ty
                if x_t < 0 || y_t < 0 || x_t + rw > w || y_t + rh > h { return oren_err(4, "ui.validate: fill_rect out of bounds") }
            }
        } else if op == "push_clip_rect" {
            var cx = c["x"]; var cy = c["y"]; var cw = c["w"]; var ch = c["h"]
            if _is_int(cx) == false || _is_int(cy) == false || _is_int(cw) == false || _is_int(ch) == false { return oren_err(4, "ui.validate: push_clip_rect expects int x,y,w,h") }
            if cw < 1 || ch < 1 { return oren_err(4, "ui.validate: push_clip_rect invalid size") }
            if strict {
                var cx_t = cx + tx; var cy_t = cy + ty
                if cx_t < 0 || cy_t < 0 || cx_t + cw > w || cy_t + ch > h { return oren_err(4, "ui.validate: push_clip_rect out of bounds") }
            }
            clip_depth = clip_depth + 1
            if clip_depth > 64 { return oren_err(4, "ui.validate: clip stack too deep") }
            state_stack[oren_int_to_string(state_depth)] = "clip"
            state_depth = state_depth + 1
            if state_depth > 64 { return oren_err(4, "ui.validate: state stack too deep") }
        } else if op == "pop_clip" {
            if clip_depth <= 0 { return oren_err(4, "ui.validate: clip stack underflow") }
            var cstate_i = state_depth - 1
            if cstate_i < 0 || state_stack[oren_int_to_string(cstate_i)] != "clip" { return oren_err(4, "ui.validate: clip stack order mismatch") }
            state_stack[oren_int_to_string(cstate_i)] = nil
            state_depth = cstate_i
            clip_depth = clip_depth - 1
        } else if op == "push_translate" {
            var dx_t = c["dx"]; var dy_t = c["dy"]
            if _is_int(dx_t) == false || _is_int(dy_t) == false { return oren_err(4, "ui.validate: push_translate expects int dx,dy") }
            transform_stack[oren_int_to_string(transform_depth)] = [tx, ty]
            transform_depth = transform_depth + 1
            if transform_depth > 64 { return oren_err(4, "ui.validate: transform stack too deep") }
            state_stack[oren_int_to_string(state_depth)] = "transform"
            state_depth = state_depth + 1
            if state_depth > 64 { return oren_err(4, "ui.validate: state stack too deep") }
            tx = tx + dx_t
            ty = ty + dy_t
        } else if op == "pop_transform" {
            if transform_depth <= 0 { return oren_err(4, "ui.validate: transform stack underflow") }
            var tstate_i = state_depth - 1
            if tstate_i < 0 || state_stack[oren_int_to_string(tstate_i)] != "transform" { return oren_err(4, "ui.validate: transform stack order mismatch") }
            state_stack[oren_int_to_string(tstate_i)] = nil
            state_depth = tstate_i
            transform_depth = transform_depth - 1
            var tprev = transform_stack[oren_int_to_string(transform_depth)]
            tx = tprev[0]
            ty = tprev[1]
        } else if op == "push_opacity" {
            var alpha_milli = c["alpha_milli"]
            if alpha_milli == nil { alpha_milli = c["alpha"] }
            if _is_int(alpha_milli) == false || alpha_milli < 0 || alpha_milli > 1000 {
                return oren_err(4, "ui.validate: push_opacity expects alpha_milli 0..1000")
            }
            opacity_depth = opacity_depth + 1
            if opacity_depth > 64 { return oren_err(4, "ui.validate: opacity stack too deep") }
            state_stack[oren_int_to_string(state_depth)] = "opacity"
            state_depth = state_depth + 1
            if state_depth > 64 { return oren_err(4, "ui.validate: state stack too deep") }
        } else if op == "pop_opacity" {
            if opacity_depth <= 0 { return oren_err(4, "ui.validate: opacity stack underflow") }
            var ostate_i = state_depth - 1
            if ostate_i < 0 || state_stack[oren_int_to_string(ostate_i)] != "opacity" { return oren_err(4, "ui.validate: opacity stack order mismatch") }
            state_stack[oren_int_to_string(ostate_i)] = nil
            state_depth = ostate_i
            opacity_depth = opacity_depth - 1
        } else if op == "push_camera_ortho" {
            var near_z = c["near_z"]; var far_z = c["far_z"]
            if _is_int(near_z) == false || _is_int(far_z) == false { return oren_err(4, "ui.validate: push_camera_ortho expects int near_z,far_z") }
            if near_z > far_z { return oren_err(4, "ui.validate: push_camera_ortho invalid depth range") }
            camera_depth = camera_depth + 1
            if camera_depth > 64 { return oren_err(4, "ui.validate: camera stack too deep") }
            state_stack[oren_int_to_string(state_depth)] = "camera"
            state_depth = state_depth + 1
            if state_depth > 64 { return oren_err(4, "ui.validate: state stack too deep") }
        } else if op == "pop_camera" {
            if camera_depth <= 0 { return oren_err(4, "ui.validate: camera stack underflow") }
            var dstate_i = state_depth - 1
            if dstate_i < 0 || state_stack[oren_int_to_string(dstate_i)] != "camera" { return oren_err(4, "ui.validate: camera stack order mismatch") }
            state_stack[oren_int_to_string(dstate_i)] = nil
            state_depth = dstate_i
            camera_depth = camera_depth - 1
        } else if op == "stroke_line" {
            var x1 = c["x1"]; var y1 = c["y1"]; var x2 = c["x2"]; var y2 = c["y2"]; var lw = c["width"]; var lcol = c["color"]
            if _is_int(x1) == false || _is_int(y1) == false || _is_int(x2) == false || _is_int(y2) == false { return oren_err(4, "ui.validate: stroke_line expects int x1,y1,x2,y2") }
            if lw == nil { lw = 1 }
            if _is_int(lw) == false || lw < 1 { return oren_err(4, "ui.validate: stroke_line invalid width") }
            if _hex_ok(lcol) == false { return oren_err(4, "ui.validate: stroke_line invalid color") }
            if strict {
                var x1_t = x1 + tx; var y1_t = y1 + ty; var x2_t = x2 + tx; var y2_t = y2 + ty
                if x1_t < 0 || y1_t < 0 || x1_t >= w || y1_t >= h || x2_t < 0 || y2_t < 0 || x2_t >= w || y2_t >= h { return oren_err(4, "ui.validate: stroke_line out of bounds") }
            }
        } else if op == "stroke_rect" {
            var sx = c["x"]; var sy = c["y"]; var sw = c["w"]; var sh = c["h"]; var slw = c["width"]; var scol = c["color"]
            if _is_int(sx) == false || _is_int(sy) == false || _is_int(sw) == false || _is_int(sh) == false { return oren_err(4, "ui.validate: stroke_rect expects int x,y,w,h") }
            if slw == nil { slw = 1 }
            if _is_int(slw) == false || slw < 1 { return oren_err(4, "ui.validate: stroke_rect invalid width") }
            if sw < 1 || sh < 1 { return oren_err(4, "ui.validate: stroke_rect invalid size") }
            if _hex_ok(scol) == false { return oren_err(4, "ui.validate: stroke_rect invalid color") }
            if strict {
                var sx_t = sx + tx; var sy_t = sy + ty
                if sx_t < 0 || sy_t < 0 || sx_t + sw > w || sy_t + sh > h { return oren_err(4, "ui.validate: stroke_rect out of bounds") }
            }
        } else if op == "round_rect" {
            var rx = c["x"]; var ry = c["y"]; var rw2 = c["w"]; var rh2 = c["h"]; var rr = c["r"]; var rlw = c["width"]; var rcol = c["color"]
            if _is_int(rx) == false || _is_int(ry) == false || _is_int(rw2) == false || _is_int(rh2) == false || _is_int(rr) == false {
                return oren_err(4, "ui.validate: round_rect expects int x,y,w,h,r")
            }
            if rlw == nil { rlw = 1 }
            if _is_int(rlw) == false || rlw < 1 { return oren_err(4, "ui.validate: round_rect invalid width") }
            if rw2 < 1 || rh2 < 1 { return oren_err(4, "ui.validate: round_rect invalid size") }
            if rr < 0 || rr * 2 > rw2 || rr * 2 > rh2 { return oren_err(4, "ui.validate: round_rect invalid radius") }
            if _hex_ok(rcol) == false { return oren_err(4, "ui.validate: round_rect invalid color") }
            if strict {
                var rx_t = rx + tx; var ry_t = ry + ty
                if rx_t < 0 || ry_t < 0 || rx_t + rw2 > w || ry_t + rh2 > h { return oren_err(4, "ui.validate: round_rect out of bounds") }
            }
        } else if op == "circle" {
            var cx = c["cx"]; var cy = c["cy"]; var cr = c["r"]; var ccol = c["color"]
            if _is_int(cx) == false || _is_int(cy) == false || _is_int(cr) == false { return oren_err(4, "ui.validate: circle expects int cx,cy,r") }
            if cr < 0 { return oren_err(4, "ui.validate: circle negative radius") }
            if _hex_ok(ccol) == false { return oren_err(4, "ui.validate: circle invalid color") }
            if strict {
                var ccx_t = cx + tx; var ccy_t = cy + ty
                if ccx_t - cr < 0 || ccy_t - cr < 0 || ccx_t + cr >= w || ccy_t + cr >= h { return oren_err(4, "ui.validate: circle out of bounds") }
            }
        } else if op == "ellipse" {
            var ex = c["x"]; var ey = c["y"]; var ew = c["w"]; var eh = c["h"]; var elw = c["width"]; var ecol = c["color"]
            if _is_int(ex) == false || _is_int(ey) == false || _is_int(ew) == false || _is_int(eh) == false { return oren_err(4, "ui.validate: ellipse expects int x,y,w,h") }
            if elw == nil { elw = 1 }
            if _is_int(elw) == false || elw < 1 { return oren_err(4, "ui.validate: ellipse invalid width") }
            if ew < 1 || eh < 1 { return oren_err(4, "ui.validate: ellipse invalid size") }
            if _hex_ok(ecol) == false { return oren_err(4, "ui.validate: ellipse invalid color") }
            if strict {
                var ex_t = ex + tx; var ey_t = ey + ty
                if ex_t < 0 || ey_t < 0 || ex_t + ew > w || ey_t + eh > h { return oren_err(4, "ui.validate: ellipse out of bounds") }
            }
        } else if op == "polyline" {
            var plw = c["width"]; var pcol = c["color"]; var points = c["points"]
            if plw == nil { plw = 1 }
            if _is_int(plw) == false || plw < 1 { return oren_err(4, "ui.validate: polyline invalid width") }
            if _hex_ok(pcol) == false { return oren_err(4, "ui.validate: polyline invalid color") }
            var plen = bytes.len(points)
            if oren_is_err(plen) { return oren_err(4, "ui.validate: polyline expects byte points") }
            if plen < 16 || plen > 65520 || plen % 8 != 0 { return oren_err(4, "ui.validate: polyline invalid point bytes") }
            if strict {
                var points_ptr = _bytes_ptr_or_nil(points)
                var poff = 0
                while poff < plen {
                    var px = _read_u32_le(points, points_ptr, poff)
                    var py = _read_u32_le(points, points_ptr, poff + 4)
                    if oren_is_err(px) || oren_is_err(py) { return oren_err(4, "ui.validate: polyline malformed point") }
                    var px_t = px + tx; var py_t = py + ty
                    if px_t < 0 || py_t < 0 || px_t >= w || py_t >= h { return oren_err(4, "ui.validate: polyline out of bounds") }
                    poff = poff + 8
                }
            }
        } else if op == "fill_triangle" {
            var tx1 = c["x1"]; var ty1 = c["y1"]; var tx2 = c["x2"]; var ty2 = c["y2"]; var tx3 = c["x3"]; var ty3 = c["y3"]; var tcol = c["color"]
            if _is_int(tx1) == false || _is_int(ty1) == false || _is_int(tx2) == false || _is_int(ty2) == false || _is_int(tx3) == false || _is_int(ty3) == false {
                return oren_err(4, "ui.validate: fill_triangle expects int x1,y1,x2,y2,x3,y3")
            }
            if _hex_ok(tcol) == false { return oren_err(4, "ui.validate: fill_triangle invalid color") }
            if strict {
                var tx1_t = tx1 + tx; var ty1_t = ty1 + ty; var tx2_t = tx2 + tx; var ty2_t = ty2 + ty; var tx3_t = tx3 + tx; var ty3_t = ty3 + ty
                if tx1_t < 0 || ty1_t < 0 || tx1_t >= w || ty1_t >= h || tx2_t < 0 || ty2_t < 0 || tx2_t >= w || ty2_t >= h || tx3_t < 0 || ty3_t < 0 || tx3_t >= w || ty3_t >= h {
                    return oren_err(4, "ui.validate: fill_triangle out of bounds")
                }
            }
        } else if op == "fill_triangles" {
            var tris = c["triangles"]; var tris_col = c["color"]
            if _hex_ok(tris_col) == false { return oren_err(4, "ui.validate: fill_triangles invalid color") }
            var tris_len = bytes.len(tris)
            if oren_is_err(tris_len) { return oren_err(4, "ui.validate: fill_triangles expects byte triangles") }
            if tris_len == 0 || tris_len > 65512 || tris_len % 24 != 0 { return oren_err(4, "ui.validate: fill_triangles invalid triangle bytes") }
            if strict {
                var tris_ptr = _bytes_ptr_or_nil(tris)
                var toff = 0
                while toff < tris_len {
                    var vi = 0
                    while vi < 3 {
                        var vx = _read_u32_le(tris, tris_ptr, toff + vi * 8)
                        var vy = _read_u32_le(tris, tris_ptr, toff + vi * 8 + 4)
                        if oren_is_err(vx) || oren_is_err(vy) { return oren_err(4, "ui.validate: fill_triangles malformed vertex") }
                        var vx_t = vx + tx; var vy_t = vy + ty
                        if vx_t < 0 || vy_t < 0 || vx_t >= w || vy_t >= h { return oren_err(4, "ui.validate: fill_triangles out of bounds") }
                        vi = vi + 1
                    }
                    toff = toff + 24
                }
            }
        } else if op == "mesh2d" {
            var mid = c["id"]; var mesh_tris = c["triangles"]; var mesh_col = c["color"]
            if _is_int(mid) == false || mid < 1 { return oren_err(4, "ui.validate: mesh2d invalid id") }
            if _hex_ok(mesh_col) == false { return oren_err(4, "ui.validate: mesh2d invalid color") }
            var mesh_tris_len = bytes.len(mesh_tris)
            if oren_is_err(mesh_tris_len) { return oren_err(4, "ui.validate: mesh2d expects byte triangles") }
            if mesh_tris_len == 0 || mesh_tris_len > 65504 || mesh_tris_len % 24 != 0 { return oren_err(4, "ui.validate: mesh2d invalid triangle bytes") }
            if strict {
                var mesh_tris_ptr = _bytes_ptr_or_nil(mesh_tris)
                var moff = 0
                while moff < mesh_tris_len {
                    var mvi = 0
                    while mvi < 3 {
                        var mvx = _read_u32_le(mesh_tris, mesh_tris_ptr, moff + mvi * 8)
                        var mvy = _read_u32_le(mesh_tris, mesh_tris_ptr, moff + mvi * 8 + 4)
                        if oren_is_err(mvx) || oren_is_err(mvy) { return oren_err(4, "ui.validate: mesh2d malformed vertex") }
                        var mvx_t = mvx + tx; var mvy_t = mvy + ty
                        if mvx_t < 0 || mvy_t < 0 || mvx_t >= w || mvy_t >= h { return oren_err(4, "ui.validate: mesh2d out of bounds") }
                        mvi = mvi + 1
                    }
                    moff = moff + 24
                }
            }
        } else if op == "draw_mesh2d" {
            var dmid = c["id"]
            if _is_int(dmid) == false || dmid < 1 { return oren_err(4, "ui.validate: draw_mesh2d invalid id") }
        } else if op == "destroy_mesh2d" {
            var xmid = c["id"]
            if _is_int(xmid) == false || xmid < 1 { return oren_err(4, "ui.validate: destroy_mesh2d invalid id") }
        } else if op == "mesh3d" {
            var m3id = c["id"]; var m3tris = c["triangles"]; var m3col = c["color"]
            if _is_int(m3id) == false || m3id < 1 { return oren_err(4, "ui.validate: mesh3d invalid id") }
            if _hex_ok(m3col) == false { return oren_err(4, "ui.validate: mesh3d invalid color") }
            var m3tris_len = bytes.len(m3tris)
            if oren_is_err(m3tris_len) { return oren_err(4, "ui.validate: mesh3d expects byte triangles") }
            if m3tris_len == 0 || m3tris_len > 65520 || m3tris_len % 36 != 0 { return oren_err(4, "ui.validate: mesh3d invalid triangle bytes") }
            if strict {
                var m3tris_ptr = _bytes_ptr_or_nil(m3tris)
                var m3off = 0
                while m3off < m3tris_len {
                    var m3vi = 0
                    while m3vi < 3 {
                        var m3x = _read_i32_le(m3tris, m3tris_ptr, m3off + m3vi * 12)
                        var m3y = _read_i32_le(m3tris, m3tris_ptr, m3off + m3vi * 12 + 4)
                        var m3z = _read_i32_le(m3tris, m3tris_ptr, m3off + m3vi * 12 + 8)
                        if oren_is_err(m3x) || oren_is_err(m3y) || oren_is_err(m3z) { return oren_err(4, "ui.validate: mesh3d malformed vertex") }
                        var m3x_t = m3x + tx; var m3y_t = m3y + ty
                        if m3x_t < 0 || m3y_t < 0 || m3x_t >= w || m3y_t >= h { return oren_err(4, "ui.validate: mesh3d projected out of bounds") }
                        m3vi = m3vi + 1
                    }
                    m3off = m3off + 36
                }
            }
        } else if op == "mesh3d_rgba" {
            var m3rid = c["id"]; var m3rtris = c["triangles"]
            if _is_int(m3rid) == false || m3rid < 1 { return oren_err(4, "ui.validate: mesh3d_rgba invalid id") }
            var m3rtris_len = bytes.len(m3rtris)
            if oren_is_err(m3rtris_len) { return oren_err(4, "ui.validate: mesh3d_rgba expects byte triangles") }
            if m3rtris_len == 0 || m3rtris_len > 65520 || m3rtris_len % 40 != 0 { return oren_err(4, "ui.validate: mesh3d_rgba invalid triangle bytes") }
            if strict {
                var m3rtris_ptr = _bytes_ptr_or_nil(m3rtris)
                var m3roff = 0
                while m3roff < m3rtris_len {
                    var m3rvi = 0
                    while m3rvi < 3 {
                        var m3rx = _read_i32_le(m3rtris, m3rtris_ptr, m3roff + m3rvi * 12)
                        var m3ry = _read_i32_le(m3rtris, m3rtris_ptr, m3roff + m3rvi * 12 + 4)
                        var m3rz = _read_i32_le(m3rtris, m3rtris_ptr, m3roff + m3rvi * 12 + 8)
                        if oren_is_err(m3rx) || oren_is_err(m3ry) || oren_is_err(m3rz) { return oren_err(4, "ui.validate: mesh3d_rgba malformed vertex") }
                        var m3rx_t = m3rx + tx; var m3ry_t = m3ry + ty
                        if m3rx_t < 0 || m3ry_t < 0 || m3rx_t >= w || m3ry_t >= h { return oren_err(4, "ui.validate: mesh3d_rgba projected out of bounds") }
                        m3rvi = m3rvi + 1
                    }
                    m3roff = m3roff + 40
                }
            }
        } else if op == "mesh3d_indexed" {
            var m3iid = c["id"]; var m3iverts = c["vertices"]; var m3iidx = c["indices"]; var m3icol = c["color"]
            if _is_int(m3iid) == false || m3iid < 1 { return oren_err(4, "ui.validate: mesh3d_indexed invalid id") }
            if _hex_ok(m3icol) == false { return oren_err(4, "ui.validate: mesh3d_indexed invalid color") }
            var m3iverts_len = bytes.len(m3iverts)
            if oren_is_err(m3iverts_len) { return oren_err(4, "ui.validate: mesh3d_indexed expects byte vertices") }
            if m3iverts_len < 36 || m3iverts_len > 65508 || m3iverts_len % 12 != 0 { return oren_err(4, "ui.validate: mesh3d_indexed invalid vertex bytes") }
            var m3iidx_len = bytes.len(m3iidx)
            if oren_is_err(m3iidx_len) { return oren_err(4, "ui.validate: mesh3d_indexed expects byte indices") }
            if m3iidx_len < 12 || m3iidx_len > 65508 || m3iidx_len % 12 != 0 || m3iverts_len + m3iidx_len > 65519 { return oren_err(4, "ui.validate: mesh3d_indexed invalid index bytes") }
            var m3ivc = m3iverts_len / 12
            var m3iidx_ptr = _bytes_ptr_or_nil(m3iidx)
            var m3iioff = 0
            while m3iioff < m3iidx_len {
                var m3ii = _read_u32_le(m3iidx, m3iidx_ptr, m3iioff)
                if oren_is_err(m3ii) { return oren_err(4, "ui.validate: mesh3d_indexed malformed index") }
                if m3ii < 0 || m3ii >= m3ivc { return oren_err(4, "ui.validate: mesh3d_indexed index out of range") }
                m3iioff = m3iioff + 4
            }
            if strict {
                var m3iverts_ptr = _bytes_ptr_or_nil(m3iverts)
                var m3ivoff = 0
                while m3ivoff < m3iverts_len {
                    var m3ix = _read_i32_le(m3iverts, m3iverts_ptr, m3ivoff)
                    var m3iy = _read_i32_le(m3iverts, m3iverts_ptr, m3ivoff + 4)
                    var m3iz = _read_i32_le(m3iverts, m3iverts_ptr, m3ivoff + 8)
                    if oren_is_err(m3ix) || oren_is_err(m3iy) || oren_is_err(m3iz) { return oren_err(4, "ui.validate: mesh3d_indexed malformed vertex") }
                    var m3ix_t = m3ix + tx; var m3iy_t = m3iy + ty
                    if m3ix_t < 0 || m3iy_t < 0 || m3ix_t >= w || m3iy_t >= h { return oren_err(4, "ui.validate: mesh3d_indexed projected out of bounds") }
                    m3ivoff = m3ivoff + 12
                }
            }
        } else if op == "material3d" {
            var matid = c["id"]; var matcol = c["color"]
            if _is_int(matid) == false || matid < 1 { return oren_err(4, "ui.validate: material3d invalid id") }
            if _hex_ok(matcol) == false { return oren_err(4, "ui.validate: material3d invalid color") }
        } else if op == "draw_mesh3d" {
            var dm3id = c["id"]
            if _is_int(dm3id) == false || dm3id < 1 { return oren_err(4, "ui.validate: draw_mesh3d invalid id") }
        } else if op == "draw_mesh3d_at" {
            var dm3aid = c["id"]; var dm3ax = c["x"]; var dm3ay = c["y"]; var dm3az = c["z"]; var dm3as = c["scale_milli"]
            if _is_int(dm3aid) == false || dm3aid < 1 { return oren_err(4, "ui.validate: draw_mesh3d_at invalid id") }
            if _is_int(dm3ax) == false || _is_int(dm3ay) == false || _is_int(dm3az) == false { return oren_err(4, "ui.validate: draw_mesh3d_at expects int x,y,z") }
            if _is_int(dm3as) == false || dm3as <= 0 { return oren_err(4, "ui.validate: draw_mesh3d_at invalid scale_milli") }
        } else if op == "draw_mesh3d_material" {
            var dm3mid = c["id"]; var dm3mmid = c["material_id"]
            if _is_int(dm3mid) == false || dm3mid < 1 { return oren_err(4, "ui.validate: draw_mesh3d_material invalid id") }
            if _is_int(dm3mmid) == false || dm3mmid < 1 { return oren_err(4, "ui.validate: draw_mesh3d_material invalid material_id") }
        } else if op == "draw_mesh3d_at_material" {
            var dm3amid = c["id"]; var dm3ammat = c["material_id"]; var dm3amx = c["x"]; var dm3amy = c["y"]; var dm3amz = c["z"]; var dm3ams = c["scale_milli"]
            if _is_int(dm3amid) == false || dm3amid < 1 { return oren_err(4, "ui.validate: draw_mesh3d_at_material invalid id") }
            if _is_int(dm3ammat) == false || dm3ammat < 1 { return oren_err(4, "ui.validate: draw_mesh3d_at_material invalid material_id") }
            if _is_int(dm3amx) == false || _is_int(dm3amy) == false || _is_int(dm3amz) == false { return oren_err(4, "ui.validate: draw_mesh3d_at_material expects int x,y,z") }
            if _is_int(dm3ams) == false || dm3ams <= 0 { return oren_err(4, "ui.validate: draw_mesh3d_at_material invalid scale_milli") }
        } else if op == "model3d" {
            var modid = c["id"]; var modmesh = c["mesh_id"]; var modmat = c["material_id"]; var modx = c["x"]; var mody = c["y"]; var modz = c["z"]; var mods = c["scale_milli"]
            if _is_int(modid) == false || modid < 1 { return oren_err(4, "ui.validate: model3d invalid id") }
            if _is_int(modmesh) == false || modmesh < 1 { return oren_err(4, "ui.validate: model3d invalid mesh_id") }
            if modmat == nil { modmat = 0 }
            if _is_int(modmat) == false || modmat < 0 { return oren_err(4, "ui.validate: model3d invalid material_id") }
            if _is_int(modx) == false || _is_int(mody) == false || _is_int(modz) == false { return oren_err(4, "ui.validate: model3d expects int x,y,z") }
            if _is_int(mods) == false || mods <= 0 { return oren_err(4, "ui.validate: model3d invalid scale_milli") }
        } else if op == "draw_model3d" {
            var dmodid = c["id"]
            if _is_int(dmodid) == false || dmodid < 1 { return oren_err(4, "ui.validate: draw_model3d invalid id") }
        } else if op == "destroy_model3d" {
            var xmodid = c["id"]
            if _is_int(xmodid) == false || xmodid < 1 { return oren_err(4, "ui.validate: destroy_model3d invalid id") }
        } else if op == "destroy_mesh3d" {
            var xm3id = c["id"]
            if _is_int(xm3id) == false || xm3id < 1 { return oren_err(4, "ui.validate: destroy_mesh3d invalid id") }
        } else if op == "destroy_material3d" {
            var xmatid = c["id"]
            if _is_int(xmatid) == false || xmatid < 1 { return oren_err(4, "ui.validate: destroy_material3d invalid id") }
        } else if op == "text" {
            var x2 = c["x"]; var y2 = c["y"]; var s = c["text"]; var col2 = c["color"]
            if _is_int(x2) == false || _is_int(y2) == false { return oren_err(4, "ui.validate: text expects int x,y") }
            if _is_string(s) == false { return oren_err(4, "ui.validate: text expects string text") }
            if _hex_ok(col2) == false { return oren_err(4, "ui.validate: text invalid color") }
            if strict {
                var ln = oren_string_len(s)
                var x2_t = x2 + tx; var y2_t = y2 + ty
                if y2_t < 0 || y2_t >= h || x2_t < 0 || x2_t + ln > w { return oren_err(4, "ui.validate: text out of bounds") }
            }
        } else if op == "text_bytes" {
            var bx = c["x"]; var by = c["y"]; var bd = c["data"]; var bcol = c["color"]
            if _is_int(bx) == false || _is_int(by) == false { return oren_err(4, "ui.validate: text_bytes expects int x,y") }
            var blen = bytes.len(bd)
            if oren_is_err(blen) { return oren_err(4, "ui.validate: text_bytes expects byte data") }
            if blen > 65519 { return oren_err(4, "ui.validate: text_bytes data too large") }
            if _hex_ok(bcol) == false { return oren_err(4, "ui.validate: text_bytes invalid color") }
            if strict {
                var bx_t = bx + tx; var by_t = by + ty
                if by_t < 0 || by_t >= h || bx_t < 0 || bx_t + blen > w { return oren_err(4, "ui.validate: text_bytes out of bounds") }
            }
        } else if op == "text_resource" {
            var tid = c["id"]; var td = c["data"]; var tcolr = c["color"]
            if _is_int(tid) == false || tid < 1 { return oren_err(4, "ui.validate: text_resource invalid id") }
            var tlen = bytes.len(td)
            if oren_is_err(tlen) { return oren_err(4, "ui.validate: text_resource expects byte data") }
            if tlen > 65519 { return oren_err(4, "ui.validate: text_resource data too large") }
            if _hex_ok(tcolr) == false { return oren_err(4, "ui.validate: text_resource invalid color") }
        } else if op == "draw_text" {
            var dtid = c["id"]; var dtx = c["x"]; var dty = c["y"]
            if _is_int(dtid) == false || dtid < 1 { return oren_err(4, "ui.validate: draw_text invalid id") }
            if _is_int(dtx) == false || _is_int(dty) == false { return oren_err(4, "ui.validate: draw_text expects int x,y") }
            if strict {
                var dtx_t = dtx + tx; var dty_t = dty + ty
                if dtx_t < 0 || dty_t < 0 || dtx_t >= w || dty_t >= h { return oren_err(4, "ui.validate: draw_text out of bounds") }
            }
        } else if op == "draw_texts" {
            var btid = c["id"]; var positions = c["positions"]
            if _is_int(btid) == false || btid < 1 { return oren_err(4, "ui.validate: draw_texts invalid id") }
            var pos_len = bytes.len(positions)
            if oren_is_err(pos_len) { return oren_err(4, "ui.validate: draw_texts expects byte positions") }
            if pos_len == 0 || pos_len > 65520 || pos_len % 8 != 0 { return oren_err(4, "ui.validate: draw_texts invalid position bytes") }
            if strict {
                var positions_ptr = _bytes_ptr_or_nil(positions)
                var poff2 = 0
                while poff2 < pos_len {
                    var ptx = _read_u32_le(positions, positions_ptr, poff2)
                    var pty = _read_u32_le(positions, positions_ptr, poff2 + 4)
                    if oren_is_err(ptx) || oren_is_err(pty) { return oren_err(4, "ui.validate: draw_texts malformed position") }
                    var ptx_t = ptx + tx; var pty_t = pty + ty
                    if ptx_t < 0 || pty_t < 0 || ptx_t >= w || pty_t >= h { return oren_err(4, "ui.validate: draw_texts out of bounds") }
                    poff2 = poff2 + 8
                }
            }
        } else if op == "destroy_text" {
            var xtid = c["id"]
            if _is_int(xtid) == false || xtid < 1 { return oren_err(4, "ui.validate: destroy_text invalid id") }
        } else if op == "image_rgba" {
            var iid = c["id"]; var iw = c["w"]; var ih = c["h"]; var idata = c["data"]
            if _is_int(iid) == false || iid < 1 { return oren_err(4, "ui.validate: image_rgba invalid id") }
            if _is_int(iw) == false || _is_int(ih) == false || iw < 1 || ih < 1 { return oren_err(4, "ui.validate: image_rgba invalid size") }
            var ilen = bytes.len(idata)
            if oren_is_err(ilen) { return oren_err(4, "ui.validate: image_rgba expects byte data") }
            if ilen != iw * ih * 4 { return oren_err(4, "ui.validate: image_rgba data length mismatch") }
            if ilen > 65519 { return oren_err(4, "ui.validate: image_rgba data too large") }
            image_bytes = image_bytes + ilen
            image_count = image_count + 1
            if max_image_bytes != nil && image_bytes > max_image_bytes { return oren_err(4, "ui.validate: image byte budget exceeded") }
            if max_image_count != nil && image_count > max_image_count { return oren_err(4, "ui.validate: image count budget exceeded") }
        } else if op == "draw_image" {
            var did = c["id"]; var dx = c["x"]; var dy = c["y"]; var dw = c["w"]; var dh = c["h"]
            if _is_int(did) == false || did < 1 { return oren_err(4, "ui.validate: draw_image invalid id") }
            if _is_int(dx) == false || _is_int(dy) == false || _is_int(dw) == false || _is_int(dh) == false {
                return oren_err(4, "ui.validate: draw_image expects int x,y,w,h")
            }
            if dw < 1 || dh < 1 { return oren_err(4, "ui.validate: draw_image invalid size") }
            if strict {
                var dx_t = dx + tx; var dy_t = dy + ty
                if dx_t < 0 || dy_t < 0 || dx_t + dw > w || dy_t + dh > h { return oren_err(4, "ui.validate: draw_image out of bounds") }
            }
        } else if op == "draw_image_rect" {
            var rid = c["id"]; var rsx = c["sx"]; var rsy = c["sy"]; var rsw = c["sw"]; var rsh = c["sh"]
            var rx = c["x"]; var ry = c["y"]; var rw = c["w"]; var rh = c["h"]
            if _is_int(rid) == false || rid < 1 { return oren_err(4, "ui.validate: draw_image_rect invalid id") }
            if _is_int(rsx) == false || _is_int(rsy) == false || _is_int(rsw) == false || _is_int(rsh) == false ||
                    _is_int(rx) == false || _is_int(ry) == false || _is_int(rw) == false || _is_int(rh) == false {
                return oren_err(4, "ui.validate: draw_image_rect expects int source and destination rects")
            }
            if rsx < 0 || rsy < 0 || rsw < 1 || rsh < 1 || rw < 1 || rh < 1 {
                return oren_err(4, "ui.validate: draw_image_rect invalid rect")
            }
            if strict {
                var rx_t = rx + tx; var ry_t = ry + ty
                if rx_t < 0 || ry_t < 0 || rx_t + rw > w || ry_t + rh > h { return oren_err(4, "ui.validate: draw_image_rect out of bounds") }
            }
        } else if op == "draw_image_rects" {
            var bid = c["id"]; var rects = c["rects"]
            if _is_int(bid) == false || bid < 1 { return oren_err(4, "ui.validate: draw_image_rects invalid id") }
            var rect_len = bytes.len(rects)
            if oren_is_err(rect_len) { return oren_err(4, "ui.validate: draw_image_rects expects byte rects") }
            if rect_len == 0 || rect_len > 65504 || rect_len % 32 != 0 {
                return oren_err(4, "ui.validate: draw_image_rects invalid rect bytes")
            }
            var rects_ptr = _bytes_ptr_or_nil(rects)
            var roff = 0
            while roff < rect_len {
                var bsx = _read_u32_le(rects, rects_ptr, roff)
                var bsy = _read_u32_le(rects, rects_ptr, roff + 4)
                var bsw = _read_u32_le(rects, rects_ptr, roff + 8)
                var bsh = _read_u32_le(rects, rects_ptr, roff + 12)
                var bx = _read_u32_le(rects, rects_ptr, roff + 16)
                var by = _read_u32_le(rects, rects_ptr, roff + 20)
                var bw = _read_u32_le(rects, rects_ptr, roff + 24)
                var bh = _read_u32_le(rects, rects_ptr, roff + 28)
                if oren_is_err(bsx) || oren_is_err(bsy) || oren_is_err(bsw) || oren_is_err(bsh) || oren_is_err(bx) || oren_is_err(by) || oren_is_err(bw) || oren_is_err(bh) {
                    return oren_err(4, "ui.validate: draw_image_rects malformed rect")
                }
                if bsw < 1 || bsh < 1 || bw < 1 || bh < 1 {
                    return oren_err(4, "ui.validate: draw_image_rects invalid rect")
                }
                if strict {
                    var bx_t = bx + tx; var by_t = by + ty
                    if bx_t < 0 || by_t < 0 || bx_t + bw > w || by_t + bh > h { return oren_err(4, "ui.validate: draw_image_rects out of bounds") }
                }
                roff = roff + 32
            }
        } else if op == "destroy_image" {
            var xid = c["id"]
            if _is_int(xid) == false || xid < 1 { return oren_err(4, "ui.validate: destroy_image invalid id") }
        } else {
            return oren_err(4, "ui.validate: unknown op")
        }

        i = i + 1
    }

    if clip_depth != 0 { return oren_err(4, "ui.validate: unbalanced clip stack") }
    if transform_depth != 0 { return oren_err(4, "ui.validate: unbalanced transform stack") }
    if opacity_depth != 0 { return oren_err(4, "ui.validate: unbalanced opacity stack") }
    if camera_depth != 0 { return oren_err(4, "ui.validate: unbalanced camera stack") }
    if state_depth != 0 { return oren_err(4, "ui.validate: unbalanced state stack") }

    return 0
}
