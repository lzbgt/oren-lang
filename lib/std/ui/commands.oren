// std:ui/commands (rolling)
//
// Validation and normalization helpers for the render command buffer schema.
//
// This module exists so:
// - headless rasterizer and future platform shims can share a single validator
// - tests can assert that emitters produce valid command buffers
//
// See `docs/DESIGN.md#ui-v0-schema-headless-core` for the current v0 schema.

import ui_color "std:ui/color"
import bytes "std:bytes"

fn _is_int(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 1 { return true }
    if tag == 0 || tag == 3 || tag == 4 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn _is_string(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 4 { return true }
    if tag == 0 || tag == 1 || tag == 3 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var n = oren_string_len(v)
    if n == nil { return false }
    return oren_is_err(n) == false
}

fn _hex_ok(s) {
    // Accept "#RRGGBB" or "#RRGGBBAA" (case-insensitive hex).
    return ui_color.is_hex(s)
}

fn validate(cmds, w, h, opts) {
    // Returns:
    // - 0 on success
    // - err on failure
    //
    // opts (rolling):
    // - strict_bounds: bool (default false) — reject ops that extend outside the framebuffer.
    // - max_image_bytes: int (optional) — reject frames uploading more RGBA image bytes.
    // - max_image_count: int (optional) — reject frames uploading more retained images.
    if opts == nil { opts = {} }
    var strict = opts["strict_bounds"]
    if strict == nil { strict = false }
    strict = strict != 0
    var max_image_bytes = opts["max_image_bytes"]
    var max_image_count = opts["max_image_count"]
    var image_bytes = 0
    var image_count = 0
    if max_image_bytes != nil && (_is_int(max_image_bytes) == false || max_image_bytes < 0) {
        return oren_err(4, "ui.validate: invalid max_image_bytes")
    }
    if max_image_count != nil && (_is_int(max_image_count) == false || max_image_count < 0) {
        return oren_err(4, "ui.validate: invalid max_image_count")
    }

    if _is_int(w) == false || _is_int(h) == false { return oren_err(4, "ui.validate: invalid framebuffer size") }
    if w < 0 || h < 0 { return oren_err(4, "ui.validate: negative framebuffer size") }

    if cmds == nil { return 0 }
    // Lists are the only stable "sequence" container across backends right now.
    // In some backends `oren_list_len(non_list)` yields nil rather than an error.
    var _n = oren_list_len(cmds)
    if _n == nil || oren_is_err(_n) { return oren_err(4, "ui.validate: cmds must be list") }

    var i = 0
    while i < oren_list_len(cmds) {
        var c = cmds[i]
        if c == nil { return oren_err(4, "ui.validate: cmd is nil") }
        // Command is expected to be a map-like value (indexing by string keys).
        var op = c["op"]
        if _is_string(op) == false { return oren_err(4, "ui.validate: cmd missing op") }

        if op == "fill_rect" {
            var x = c["x"]; var y = c["y"]; var rw = c["w"]; var rh = c["h"]; var col = c["color"]
            if _is_int(x) == false || _is_int(y) == false || _is_int(rw) == false || _is_int(rh) == false { return oren_err(4, "ui.validate: fill_rect expects int x,y,w,h") }
            if rw < 0 || rh < 0 { return oren_err(4, "ui.validate: fill_rect negative size") }
            if _hex_ok(col) == false { return oren_err(4, "ui.validate: fill_rect invalid color") }
            if strict {
                if x < 0 || y < 0 || x + rw > w || y + rh > h { return oren_err(4, "ui.validate: fill_rect out of bounds") }
            }
        } else if op == "stroke_line" {
            var x1 = c["x1"]; var y1 = c["y1"]; var x2 = c["x2"]; var y2 = c["y2"]; var lw = c["width"]; var lcol = c["color"]
            if _is_int(x1) == false || _is_int(y1) == false || _is_int(x2) == false || _is_int(y2) == false { return oren_err(4, "ui.validate: stroke_line expects int x1,y1,x2,y2") }
            if lw == nil { lw = 1 }
            if _is_int(lw) == false || lw < 1 { return oren_err(4, "ui.validate: stroke_line invalid width") }
            if _hex_ok(lcol) == false { return oren_err(4, "ui.validate: stroke_line invalid color") }
            if strict {
                if x1 < 0 || y1 < 0 || x1 >= w || y1 >= h || x2 < 0 || y2 < 0 || x2 >= w || y2 >= h { return oren_err(4, "ui.validate: stroke_line out of bounds") }
            }
        } else if op == "circle" {
            var cx = c["cx"]; var cy = c["cy"]; var cr = c["r"]; var ccol = c["color"]
            if _is_int(cx) == false || _is_int(cy) == false || _is_int(cr) == false { return oren_err(4, "ui.validate: circle expects int cx,cy,r") }
            if cr < 0 { return oren_err(4, "ui.validate: circle negative radius") }
            if _hex_ok(ccol) == false { return oren_err(4, "ui.validate: circle invalid color") }
            if strict {
                if cx - cr < 0 || cy - cr < 0 || cx + cr >= w || cy + cr >= h { return oren_err(4, "ui.validate: circle out of bounds") }
            }
        } else if op == "fill_triangle" {
            var tx1 = c["x1"]; var ty1 = c["y1"]; var tx2 = c["x2"]; var ty2 = c["y2"]; var tx3 = c["x3"]; var ty3 = c["y3"]; var tcol = c["color"]
            if _is_int(tx1) == false || _is_int(ty1) == false || _is_int(tx2) == false || _is_int(ty2) == false || _is_int(tx3) == false || _is_int(ty3) == false {
                return oren_err(4, "ui.validate: fill_triangle expects int x1,y1,x2,y2,x3,y3")
            }
            if _hex_ok(tcol) == false { return oren_err(4, "ui.validate: fill_triangle invalid color") }
            if strict {
                if tx1 < 0 || ty1 < 0 || tx1 >= w || ty1 >= h || tx2 < 0 || ty2 < 0 || tx2 >= w || ty2 >= h || tx3 < 0 || ty3 < 0 || tx3 >= w || ty3 >= h {
                    return oren_err(4, "ui.validate: fill_triangle out of bounds")
                }
            }
        } else if op == "text" {
            var x2 = c["x"]; var y2 = c["y"]; var s = c["text"]; var col2 = c["color"]
            if _is_int(x2) == false || _is_int(y2) == false { return oren_err(4, "ui.validate: text expects int x,y") }
            if _is_string(s) == false { return oren_err(4, "ui.validate: text expects string text") }
            if _hex_ok(col2) == false { return oren_err(4, "ui.validate: text invalid color") }
            if strict {
                var ln = oren_string_len(s)
                if y2 < 0 || y2 >= h || x2 < 0 || x2 + ln > w { return oren_err(4, "ui.validate: text out of bounds") }
            }
        } else if op == "text_bytes" {
            var bx = c["x"]; var by = c["y"]; var bd = c["data"]; var bcol = c["color"]
            if _is_int(bx) == false || _is_int(by) == false { return oren_err(4, "ui.validate: text_bytes expects int x,y") }
            var blen = bytes.try_len(bd)
            if oren_is_err(blen) { return oren_err(4, "ui.validate: text_bytes expects byte data") }
            if blen > 65519 { return oren_err(4, "ui.validate: text_bytes data too large") }
            if _hex_ok(bcol) == false { return oren_err(4, "ui.validate: text_bytes invalid color") }
            if strict {
                if by < 0 || by >= h || bx < 0 || bx + blen > w { return oren_err(4, "ui.validate: text_bytes out of bounds") }
            }
        } else if op == "image_rgba" {
            var iid = c["id"]; var iw = c["w"]; var ih = c["h"]; var idata = c["data"]
            if _is_int(iid) == false || iid < 1 { return oren_err(4, "ui.validate: image_rgba invalid id") }
            if _is_int(iw) == false || _is_int(ih) == false || iw < 1 || ih < 1 { return oren_err(4, "ui.validate: image_rgba invalid size") }
            var ilen = bytes.try_len(idata)
            if oren_is_err(ilen) { return oren_err(4, "ui.validate: image_rgba expects byte data") }
            if ilen != iw * ih * 4 { return oren_err(4, "ui.validate: image_rgba data length mismatch") }
            if ilen > 65519 { return oren_err(4, "ui.validate: image_rgba data too large") }
            image_bytes = image_bytes + ilen
            image_count = image_count + 1
            if max_image_bytes != nil && image_bytes > max_image_bytes { return oren_err(4, "ui.validate: image byte budget exceeded") }
            if max_image_count != nil && image_count > max_image_count { return oren_err(4, "ui.validate: image count budget exceeded") }
        } else if op == "draw_image" {
            var did = c["id"]; var dx = c["x"]; var dy = c["y"]; var dw = c["w"]; var dh = c["h"]
            if _is_int(did) == false || did < 1 { return oren_err(4, "ui.validate: draw_image invalid id") }
            if _is_int(dx) == false || _is_int(dy) == false || _is_int(dw) == false || _is_int(dh) == false {
                return oren_err(4, "ui.validate: draw_image expects int x,y,w,h")
            }
            if dw < 1 || dh < 1 { return oren_err(4, "ui.validate: draw_image invalid size") }
            if strict {
                if dx < 0 || dy < 0 || dx + dw > w || dy + dh > h { return oren_err(4, "ui.validate: draw_image out of bounds") }
            }
        } else if op == "draw_image_rect" {
            var rid = c["id"]; var rsx = c["sx"]; var rsy = c["sy"]; var rsw = c["sw"]; var rsh = c["sh"]
            var rx = c["x"]; var ry = c["y"]; var rw = c["w"]; var rh = c["h"]
            if _is_int(rid) == false || rid < 1 { return oren_err(4, "ui.validate: draw_image_rect invalid id") }
            if _is_int(rsx) == false || _is_int(rsy) == false || _is_int(rsw) == false || _is_int(rsh) == false ||
                    _is_int(rx) == false || _is_int(ry) == false || _is_int(rw) == false || _is_int(rh) == false {
                return oren_err(4, "ui.validate: draw_image_rect expects int source and destination rects")
            }
            if rsx < 0 || rsy < 0 || rsw < 1 || rsh < 1 || rw < 1 || rh < 1 {
                return oren_err(4, "ui.validate: draw_image_rect invalid rect")
            }
            if strict {
                if rx < 0 || ry < 0 || rx + rw > w || ry + rh > h { return oren_err(4, "ui.validate: draw_image_rect out of bounds") }
            }
        } else if op == "destroy_image" {
            var xid = c["id"]
            if _is_int(xid) == false || xid < 1 { return oren_err(4, "ui.validate: destroy_image invalid id") }
        } else {
            return oren_err(4, "ui.validate: unknown op")
        }

        i = i + 1
    }

    return 0
}

fn try_validate(cmds, w, h, opts) {
    return validate(cmds, w, h, opts)
}
