// std:ui/scene3d_shapes_arch (rolling)
//
// Architectural Scene3D package mesh packers. These reuse the core solid-shape
// byte writers so package-format breadth can keep growing without pushing one
// helper module toward the source-line guard.

import raw "std:buffer/raw"
import shapes "std:ui/scene3d_shapes"

fn _curb_points(curb) {
    var points = curb["points"]
    if points == nil { points = curb["points_xy"] }
    return points
}

fn _curbs_xy_triangle_count(curbs, ctx) {
    if curbs == nil { return oren_err(4, ctx + ": missing curbs_xy") }
    var nc = oren_list_len(curbs)
    if oren_is_err(nc) { return oren_err(4, ctx + ": curbs_xy must be list") }
    var total = 0
    var i = 0
    while i < nc {
        var curb = curbs[i]
        if curb == nil { return oren_err(4, ctx + ": curb must be object") }
        var points = _curb_points(curb)
        var n = oren_list_len(points)
        if oren_is_err(n) || n < 2 || n > 128 { return oren_err(4, ctx + ": curb points must contain 2..128 [x,y] entries") }
        var width = shapes._line_width(curb, "curb", ctx)
        if oren_is_err(width) { return width }
        var z0 = shapes._z(curb, "z_min", "min_z", ctx + ".z_min")
        if oren_is_err(z0) { return z0 }
        var z1 = shapes._z(curb, "z_max", "max_z", ctx + ".z_max")
        if oren_is_err(z1) { return z1 }
        if z1 <= z0 { return oren_err(4, ctx + ": curb z_max must be greater than z_min") }
        var j = 0
        while j < n {
            var rc = shapes._xy_pair(points[j], "curb point", ctx)
            if oren_is_err(rc) { return rc }
            if j > 0 {
                var p0 = points[j - 1]
                var p1 = points[j]
                if p0[0] == p1[0] && p0[1] == p1[1] { return oren_err(4, ctx + ": curb segment must be nonzero") }
                var ox = shapes._line_offset(p1[0] - p0[0], p1[1] - p0[1], width, 0, ctx)
                if oren_is_err(ox) { return ox }
                var oy = shapes._line_offset(p1[0] - p0[0], p1[1] - p0[1], width, 1, ctx)
                if oren_is_err(oy) { return oy }
                if ox == 0 && oy == 0 { return oren_err(4, ctx + ": curb width rounds to zero") }
            }
            j = j + 1
        }
        total = total + (n - 1) * 12
        i = i + 1
    }
    if total > 4096 { return oren_err(4, ctx + ": curbs exceed mesh3d triangle budget") }
    return total
}

fn _store_curb_segment(out, off, p0, p1, width, z0, z1, ctx) {
    var ox = shapes._line_offset(p1[0] - p0[0], p1[1] - p0[1], width, 0, ctx)
    if oren_is_err(ox) { return ox }
    var oy = shapes._line_offset(p1[0] - p0[0], p1[1] - p0[1], width, 1, ctx)
    if oren_is_err(oy) { return oy }
    var l0x = p0[0] + ox
    var l0y = p0[1] + oy
    var l1x = p1[0] + ox
    var l1y = p1[1] + oy
    var r1x = p1[0] - ox
    var r1y = p1[1] - oy
    var r0x = p0[0] - ox
    var r0y = p0[1] - oy
    var rc = shapes._store_triangle(out, off, l0x, l0y, z1, l1x, l1y, z1, r1x, r1y, z1, ctx + ".top0")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, l0x, l0y, z1, r1x, r1y, z1, r0x, r0y, z1, ctx + ".top1")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, l0x, l0y, z0, r1x, r1y, z0, l1x, l1y, z0, ctx + ".bottom0")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, l0x, l0y, z0, r0x, r0y, z0, r1x, r1y, z0, ctx + ".bottom1")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, l0x, l0y, z0, l1x, l1y, z0, l1x, l1y, z1, ctx + ".left0")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, l0x, l0y, z0, l1x, l1y, z1, l0x, l0y, z1, ctx + ".left1")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, r0x, r0y, z0, r1x, r1y, z1, r1x, r1y, z0, ctx + ".right0")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, r0x, r0y, z0, r0x, r0y, z1, r1x, r1y, z1, ctx + ".right1")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, l0x, l0y, z0, l0x, l0y, z1, r0x, r0y, z1, ctx + ".start0")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, l0x, l0y, z0, r0x, r0y, z1, r0x, r0y, z0, ctx + ".start1")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, l1x, l1y, z0, r1x, r1y, z1, l1x, l1y, z1, ctx + ".end0")
    if oren_is_err(rc) { return rc }
    off = off + 36
    rc = shapes._store_triangle(out, off, l1x, l1y, z0, r1x, r1y, z0, r1x, r1y, z1, ctx + ".end1")
    if oren_is_err(rc) { return rc }
    return 0
}

fn pack_curbs_xy(curbs, ctx) {
    var tri_count = _curbs_xy_triangle_count(curbs, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var ci = 0
    var nc = oren_list_len(curbs)
    while ci < nc {
        var curb = curbs[ci]
        var points = _curb_points(curb)
        var width = shapes._line_width(curb, "curb", ctx)
        var z0 = shapes._z(curb, "z_min", "min_z", ctx + ".z_min")
        var z1 = shapes._z(curb, "z_max", "max_z", ctx + ".z_max")
        var i = 1
        while i < oren_list_len(points) {
            var rc = _store_curb_segment(out, off, points[i - 1], points[i], width, z0, z1, ctx + ".curb")
            if oren_is_err(rc) { return rc }
            off = off + 432
            i = i + 1
        }
        ci = ci + 1
    }
    return out
}

fn _fence_points(fence) {
    var points = fence["points"]
    if points == nil { points = fence["points_xy"] }
    return points
}

fn _fence_width(fence, primary, fallback, label, ctx) {
    var width = fence[primary]
    if width == nil { width = fence[fallback] }
    if width == nil { width = fence["width"] }
    if width == nil { width = 1 }
    if shapes._is_int(width) == false || width <= 0 {
        return oren_err(4, ctx + ": " + label + " width must be positive i32")
    }
    return width
}

fn _fence_z(fence, primary, fallback, default_value, label, ctx) {
    var z = fence[primary]
    if z == nil { z = fence[fallback] }
    if z == nil { z = default_value }
    if shapes._is_int(z) == false { return oren_err(4, ctx + ": " + label + " must be i32") }
    return z
}

fn _store_box(out, off, x0, y0, z0, x1, y1, z1, ctx) {
    var rc = shapes._store_triangle(out, off + 0, x0, y0, z0, x1, y0, z0, x1, y1, z0, ctx + ".bottom0")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 36, x0, y0, z0, x1, y1, z0, x0, y1, z0, ctx + ".bottom1")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 72, x0, y0, z1, x1, y1, z1, x1, y0, z1, ctx + ".top0")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 108, x0, y0, z1, x0, y1, z1, x1, y1, z1, ctx + ".top1")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 144, x0, y0, z0, x0, y1, z0, x0, y1, z1, ctx + ".left0")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 180, x0, y0, z0, x0, y1, z1, x0, y0, z1, ctx + ".left1")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 216, x1, y0, z0, x1, y0, z1, x1, y1, z1, ctx + ".right0")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 252, x1, y0, z0, x1, y1, z1, x1, y1, z0, ctx + ".right1")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 288, x0, y1, z0, x1, y1, z0, x1, y1, z1, ctx + ".front0")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 324, x0, y1, z0, x1, y1, z1, x0, y1, z1, ctx + ".front1")
    if oren_is_err(rc) { return rc }
    rc = shapes._store_triangle(out, off + 360, x0, y0, z0, x0, y0, z1, x1, y0, z1, ctx + ".back0")
    if oren_is_err(rc) { return rc }
    return shapes._store_triangle(out, off + 396, x0, y0, z0, x1, y0, z1, x1, y0, z0, ctx + ".back1")
}

fn _store_post(out, off, p, width, z0, z1, ctx) {
    var half = width / 2
    var x0 = p[0] - half
    var x1 = p[0] + (width - half)
    var y0 = p[1] - half
    var y1 = p[1] + (width - half)
    return _store_box(out, off, x0, y0, z0, x1, y1, z1, ctx)
}

fn _fences_xy_triangle_count(fences, ctx) {
    if fences == nil { return oren_err(4, ctx + ": missing fences_xy") }
    var nf = oren_list_len(fences)
    if oren_is_err(nf) { return oren_err(4, ctx + ": fences_xy must be list") }
    var total = 0
    var i = 0
    while i < nf {
        var fence = fences[i]
        if fence == nil { return oren_err(4, ctx + ": fence must be object") }
        var points = _fence_points(fence)
        var n = oren_list_len(points)
        if oren_is_err(n) || n < 2 || n > 128 { return oren_err(4, ctx + ": fence points must contain 2..128 [x,y] entries") }
        var post_width = _fence_width(fence, "post_width", "post_width_milli", "post", ctx)
        if oren_is_err(post_width) { return post_width }
        var rail_width = _fence_width(fence, "rail_width", "rail_width_milli", "rail", ctx)
        if oren_is_err(rail_width) { return rail_width }
        var z0 = shapes._z(fence, "z_min", "min_z", ctx + ".z_min")
        if oren_is_err(z0) { return z0 }
        var z1 = shapes._z(fence, "z_max", "max_z", ctx + ".z_max")
        if oren_is_err(z1) { return z1 }
        if z1 <= z0 { return oren_err(4, ctx + ": fence z_max must be greater than z_min") }
        var rail_z0 = _fence_z(fence, "rail_z_min", "rail_min_z", z0, "rail_z_min", ctx)
        if oren_is_err(rail_z0) { return rail_z0 }
        var rail_z1 = _fence_z(fence, "rail_z_max", "rail_max_z", z1, "rail_z_max", ctx)
        if oren_is_err(rail_z1) { return rail_z1 }
        if rail_z1 <= rail_z0 || rail_z0 < z0 || rail_z1 > z1 {
            return oren_err(4, ctx + ": fence rail z range must be inside z_min..z_max")
        }
        var j = 0
        while j < n {
            var rc = shapes._xy_pair(points[j], "fence point", ctx)
            if oren_is_err(rc) { return rc }
            if j > 0 {
                var p0 = points[j - 1]
                var p1 = points[j]
                if p0[0] == p1[0] && p0[1] == p1[1] { return oren_err(4, ctx + ": fence segment must be nonzero") }
                var ox = shapes._line_offset(p1[0] - p0[0], p1[1] - p0[1], rail_width, 0, ctx)
                if oren_is_err(ox) { return ox }
                var oy = shapes._line_offset(p1[0] - p0[0], p1[1] - p0[1], rail_width, 1, ctx)
                if oren_is_err(oy) { return oy }
                if ox == 0 && oy == 0 { return oren_err(4, ctx + ": fence rail width rounds to zero") }
            }
            j = j + 1
        }
        total = total + ((n * 12) + ((n - 1) * 12))
        i = i + 1
    }
    if total > 4096 { return oren_err(4, ctx + ": fences exceed mesh3d triangle budget") }
    return total
}

fn pack_fences_xy(fences, ctx) {
    var tri_count = _fences_xy_triangle_count(fences, ctx)
    if oren_is_err(tri_count) { return tri_count }
    var out = raw.u8_new_uninit(tri_count * 36)
    if oren_is_err(out) { return out }
    var off = 0
    var fi = 0
    var nf = oren_list_len(fences)
    while fi < nf {
        var fence = fences[fi]
        var points = _fence_points(fence)
        var post_width = _fence_width(fence, "post_width", "post_width_milli", "post", ctx)
        var rail_width = _fence_width(fence, "rail_width", "rail_width_milli", "rail", ctx)
        var z0 = shapes._z(fence, "z_min", "min_z", ctx + ".z_min")
        var z1 = shapes._z(fence, "z_max", "max_z", ctx + ".z_max")
        var rail_z0 = _fence_z(fence, "rail_z_min", "rail_min_z", z0, "rail_z_min", ctx)
        var rail_z1 = _fence_z(fence, "rail_z_max", "rail_max_z", z1, "rail_z_max", ctx)
        var i = 0
        while i < oren_list_len(points) {
            var rc = _store_post(out, off, points[i], post_width, z0, z1, ctx + ".post")
            if oren_is_err(rc) { return rc }
            off = off + 432
            if i > 0 {
                rc = _store_curb_segment(out, off, points[i - 1], points[i], rail_width, rail_z0, rail_z1, ctx + ".rail")
                if oren_is_err(rc) { return rc }
                off = off + 432
            }
            i = i + 1
        }
        fi = fi + 1
    }
    return out
}
