// std/buffer/common (rolling)
//
// Shared validation helpers for the split std:buffer facade/view/matrix modules.

import list "std:list"
import stringsm "std:strings"

fn _err_invalid(msg) { return oren_err(4, msg) }

fn _is_int(v) {
    if v == nil { return false }
    var tag = oren_type_tag(v)
    if tag == 1 { return true }
    if tag == 0 || tag == 3 || tag == 4 || tag == 6 || tag == 7 || tag == 8 { return false }
    if tag >= 9 && tag <= 13 { return false }
    var s = oren_int_to_string(v)
    if s == nil { return false }
    return oren_is_err(s) == false
}

fn _check_int(v, ctx, label) {
    if _is_int(v) == false { return oren_err(4, ctx + ": " + label + " not int") }
    return v
}

fn _check_nonneg_int(v, ctx, label) {
    var ok = _check_int(v, ctx, label)
    if oren_is_err(ok) { return ok }
    if v < 0 { return oren_err(4, ctx + ": negative " + label) }
    return v
}

fn _check_positive_int(v, ctx, label) {
    var ok = _check_int(v, ctx, label)
    if oren_is_err(ok) { return ok }
    if v <= 0 { return oren_err(4, ctx + ": " + label + " must be > 0") }
    return v
}

fn _string_slice_or_err(s, off, n, ctx) {
    if oren_type_tag(s) != 4 { return oren_err(4, ctx + ": s must be string") }
    var ok_off = _check_nonneg_int(off, ctx, "off")
    if oren_is_err(ok_off) { return ok_off }
    var ok_n = _check_nonneg_int(n, ctx, "len")
    if oren_is_err(ok_n) { return ok_n }
    return stringsm.slice(s, off, off + n)
}

fn _plain_list_len_or_err(xs, ctx) {
    if oren_type_tag(xs) != 6 { return _err_invalid(ctx + ": expects list") }
    var n = list.len(xs)
    if oren_is_err(n) { return _err_invalid(ctx + ": expects list") }
    return n
}

fn _list_view_len_or_err(v) {
    if oren_type_tag(v) != 6 { return _err_invalid("buffer: expects list view") }
    var n = list.len(v)
    if oren_is_err(n) { return _err_invalid("buffer: expects list view") }
    return n
}

fn _slice_is_list(s) {
    if s == nil || oren_is_err(s) { return false }
    var ln = _list_view_len_or_err(s)
    if oren_is_err(ln) { return false }
    return ln == 3
}

fn _strided_is_list(s) {
    if s == nil || oren_is_err(s) { return false }
    var ln = _list_view_len_or_err(s)
    if oren_is_err(ln) { return false }
    return ln == 4
}

fn _mat_is_list(m) {
    if m == nil || oren_is_err(m) { return false }
    var ln = _list_view_len_or_err(m)
    if oren_is_err(ln) { return false }
    return ln == 5
}

fn _validate_i32_or_err(v, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    if v < -2147483648 || v > 2147483647 {
        return _err_invalid(ctx + ": value out of i32 range")
    }
    return v
}

fn _validate_u8_or_err(v, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    if v < 0 || v > 255 { return oren_err(4, ctx + ": byte out of range") }
    return v
}

fn _validate_i64_or_err(v, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    return v
}

fn _validate_passthru_or_err(v, ctx) {
    return v
}

fn _buf_len_or_err(buf, ctx) {
    var n = oren_buf_len(buf)
    if n == nil || oren_is_err(n) { return _err_invalid(ctx + ": expects typed buffer") }
    return n
}

fn _buf_len_with_tag_or_err(buf, want_tag, ctx, want_label) {
    if oren_type_tag(buf) != want_tag {
        return _err_invalid(ctx + ": expects " + want_label)
    }
    return _buf_len_or_err(buf, ctx)
}
