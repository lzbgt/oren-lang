    var n = s[2]
    var ok_idx = _check_int(idx, "buffer.try_strided_load_u8", "index")
    if oren_is_err(ok_idx) { return ok_idx }
    if idx < 0 || idx >= n { return oren_err(4, "buffer.try_strided_load_u8: index out of bounds") }
    return strided_load_u8(s, idx)
}

fn strided_store_u8(s, idx, v) {
    if !_strided_is_list(s) { return _err_invalid("strided_store_u8: expects strided") }
    var n = s[2]
    if idx < 0 || idx >= n { return _err_invalid("strided_store_u8: index out of bounds") }
    return oren_buf_store_u8(s[0], s[1] + idx * s[3], v)
}

fn try_strided_store_u8(s, idx, v) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_store_u8: expects strided") }
    var n = s[2]
    var ok_idx = _check_int(idx, "buffer.try_strided_store_u8", "index")
    if oren_is_err(ok_idx) { return ok_idx }
    if idx < 0 || idx >= n { return oren_err(4, "buffer.try_strided_store_u8: index out of bounds") }
    if _is_int(v) == false { return oren_err(4, "buffer.try_strided_store_u8: value not int") }
    if v < 0 || v > 255 { return oren_err(4, "buffer.try_strided_store_u8: byte out of range") }
    return strided_store_u8(s, idx, v)
}

fn try_strided_to_bytes(s) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_to_bytes: expects strided") }
    var xs = _u8_view_unpack(try_strided_load_u8, s, s[2], "buffer.try_strided_to_bytes")
    if oren_is_err(xs) { return xs }
    return bytesm.try_pack(xs)
}

fn strided_to_bytes(s) {
    return try_strided_to_bytes(s)
}

fn try_strided_unpack_u8(s) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_unpack_u8: expects strided") }
    return _u8_view_unpack(try_strided_load_u8, s, s[2], "buffer.try_strided_unpack_u8")
