// std/buffer/view (rolling)
//
// Slice/strided implementation lives here so `std:buffer` can stay as the
// public facade while matrix helpers remain in the top-level module.

import bytesm "std:bytes"
import common "std:buffer/common"
import raw "std:buffer/raw"

fn _err_invalid(msg) { return common._err_invalid(msg) }
fn _is_int(v) { return common._is_int(v) }
fn _check_int(v, ctx, label) { return common._check_int(v, ctx, label) }
fn _check_nonneg_int(v, ctx, label) { return common._check_nonneg_int(v, ctx, label) }
fn _string_slice_or_err(s, off, n, ctx) { return common._string_slice_or_err(s, off, n, ctx) }
fn _check_positive_int(v, ctx, label) { return common._check_positive_int(v, ctx, label) }
fn _plain_list_len_or_err(xs, ctx) { return common._plain_list_len_or_err(xs, ctx) }
fn _slice_is_list(s) { return common._slice_is_list(s) }
fn _strided_is_list(s) { return common._strided_is_list(s) }
fn _validate_u8_or_err(v, ctx) { return common._validate_u8_or_err(v, ctx) }
fn _validate_i32_or_err(v, ctx) { return common._validate_i32_or_err(v, ctx) }
fn _validate_i64_or_err(v, ctx) { return common._validate_i64_or_err(v, ctx) }
fn _validate_passthru_or_err(v, ctx) { return common._validate_passthru_or_err(v, ctx) }

fn _u8_buf_unpack(src, ctx) {
    var n = oren_buf_len(src)
    if n == nil || oren_is_err(n) { return _err_invalid(ctx + ": expects []u8") }
    var out = []
    var i = 0
    while i < n {
        var v = oren_buf_load_u8(src, i)
        if oren_is_err(v) { return _err_invalid(ctx + ": expects []u8") }
        oren_list_push(out, v)
        i = i + 1
    }
    return out
}

fn _u8_view_unpack(load_fn, view, n, ctx) {
    return _view_unpack(load_fn, view, n, ctx)
}

fn _view_unpack(load_fn, view, n, ctx) {
    var out = []
    var i = 0
    while i < n {
        var b = load_fn(view, i)
        if oren_is_err(b) { return oren_err(4, ctx + ": expected numeric/[]u8 view") }
        oren_list_push(out, b)
        i = i + 1
    }
    return out
}

fn _u8_view_to_u8_buf(load_fn, view, n, ctx) {
    var out: []u8 = raw.u8_new_uninit(n)
    if oren_is_err(out) { return out }
    var data = oren_buf_data_ptr_unchecked(out)
    var i = 0
    while i < n {
        var b = load_fn(view, i)
        if oren_is_err(b) { return oren_err(4, ctx + ": expected numeric/[]u8 view") }
        ptr_set_byte(data + i, b & 255)
        i = i + 1
    }
    return out
}

fn _buf_len_with_tag_or_err(buf, want_tag, ctx, want_label) {
    return common._buf_len_with_tag_or_err(buf, want_tag, ctx, want_label)
}

fn _new_i32_buf(n) { return raw.i32_new(n) }
fn _new_i32_buf_uninit(n) { return raw.i32_new_uninit(n) }
fn _new_i64_buf(n) { return raw.i64_new(n) }
fn _new_i64_buf_uninit(n) { return raw.i64_new_uninit(n) }
fn _new_f32_buf(n) { return raw.f32_new(n) }
fn _new_f32_buf_uninit(n) { return raw.f32_new_uninit(n) }
fn _new_f64_buf(n) { return raw.f64_new(n) }
fn _new_f64_buf_uninit(n) { return raw.f64_new_uninit(n) }
fn _store_i32_buf_direct(buf, idx, v) { return raw._store_i32_buf_direct(buf, idx, v) }
fn _store_i32_buf_unchecked_direct(buf, idx, v) { return raw._store_i32_buf_unchecked_direct(buf, idx, v) }
fn _load_i32_buf_direct(buf, idx) { return raw._load_i32_buf_direct(buf, idx) }
fn _store_i64_buf_direct(buf, idx, v) { return raw._store_i64_buf_direct(buf, idx, v) }
fn _store_i64_buf_unchecked_direct(buf, idx, v) { return raw._store_i64_buf_unchecked_direct(buf, idx, v) }
fn _load_i64_buf_direct(buf, idx) { return raw._load_i64_buf_direct(buf, idx) }
fn _store_f32_buf_direct(buf, idx, v) { return raw._store_f32_buf_direct(buf, idx, v) }
fn _store_f32_buf_unchecked_direct(buf, idx, v) { return raw._store_f32_buf_unchecked_direct(buf, idx, v) }
fn _load_f32_buf_direct(buf, idx) { return raw._load_f32_buf_direct(buf, idx) }
fn _store_f64_buf_direct(buf, idx, v) { return raw._store_f64_buf_direct(buf, idx, v) }
fn _store_f64_buf_unchecked_direct(buf, idx, v) { return raw._store_f64_buf_unchecked_direct(buf, idx, v) }
fn _load_f64_buf_direct(buf, idx) { return raw._load_f64_buf_direct(buf, idx) }

fn _view_to_typed_buf(load_fn, view, n, ctx, newf, storef) {
    var out = newf(n)
    if oren_is_err(out) { return out }
    var i = 0
    while i < n {
        var v = load_fn(view, i)
        if oren_is_err(v) { return oren_err(4, ctx + ": expected numeric/[]u8 view") }
        var rc = storef(out, i, v)
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return out
}

fn _view_copy_from_typed_buf(store_fn, view, n, src, ctx, want_tag, want_label, loadf) {
    var nx = _buf_len_with_tag_or_err(src, want_tag, ctx, want_label)
    if oren_is_err(nx) { return nx }
    if nx != n { return _err_invalid(ctx + ": length mismatch") }
    var i = 0
    while i < n {
        var v = loadf(src, i)
        if oren_is_err(v) { return _err_invalid(ctx + ": expects " + want_label) }
        var rc = store_fn(view, i, v)
        if oren_is_err(rc) { return oren_err(4, ctx + ": expected numeric/[]u8 view") }
        i = i + 1
    }
    return view[0]
}

fn _u8_view_copy_from_list(store_fn, view, n, xs, ctx) {
    return _view_copy_from_list(store_fn, view, n, xs, ctx, _validate_u8_or_err)
}

fn _view_copy_from_list(store_fn, view, n, xs, ctx, validatef) {
    var nx = _plain_list_len_or_err(xs, ctx)
    if oren_is_err(nx) { return nx }
    if nx != n { return _err_invalid(ctx + ": length mismatch") }
    var i = 0
    while i < n {
        var v = validatef(xs[i], ctx)
        if oren_is_err(v) { return v }
        var rc = store_fn(view, i, v)
        if oren_is_err(rc) { return oren_err(4, ctx + ": expected numeric/[]u8 view") }
        i = i + 1
    }
    return view[0]
}

fn _validate_int_or_err(v, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    return v
}

fn _u8_view_copy_from_bytes(store_fn, view, n, bytes, ctx) {
    var xs = bytesm.try_unpack(bytes)
    if oren_is_err(xs) { return xs }
    return _u8_view_copy_from_list(store_fn, view, n, xs, ctx)
}

fn _u8_view_copy_from_bytes_slice(store_fn, view, n, bytes, off, count, ctx) {
    var bs = bytesm.try_slice(bytes, off, count)
    if oren_is_err(bs) { return bs }
    return _u8_view_copy_from_bytes(store_fn, view, n, bs, ctx)
}

fn _u8_view_copy_from_string(store_fn, view, n, s, ctx) {
    var bs = bytesm.try_from_string(s)
    if oren_is_err(bs) { return bs }
    return _u8_view_copy_from_bytes(store_fn, view, n, bs, ctx)
}

fn _u8_view_copy_from_string_slice(store_fn, view, n, s, off, count, ctx) {
    var sub = _string_slice_or_err(s, off, count, ctx)
    if oren_is_err(sub) { return sub }
    return _u8_view_copy_from_string(store_fn, view, n, sub, ctx)
}

fn _u8_view_copy_from_u8_buf(store_fn, view, n, src, ctx) {
    var xs = _u8_buf_unpack(src, ctx)
    if oren_is_err(xs) { return xs }
    return _u8_view_copy_from_list(store_fn, view, n, xs, ctx)
}

fn slice_new(buf, off, n) {
    if oren_type_tag(off) == 0 || oren_type_tag(n) == 0 { return _err_invalid("slice_new: nil off/len") }
    if off < 0 || n < 0 { return _err_invalid("slice_new: negative off/len") }
    var bl = oren_buf_len(buf)
    if oren_is_err(bl) { return bl }
    if off + n > bl { return _err_invalid("slice_new: out of bounds") }
    return [buf, off, n]
}

fn try_slice_new(buf, off, n) {
    var ok_off = _check_nonneg_int(off, "buffer.try_slice_new", "off")
    if oren_is_err(ok_off) { return ok_off }
    var ok_n = _check_nonneg_int(n, "buffer.try_slice_new", "len")
    if oren_is_err(ok_n) { return ok_n }
    return slice_new(buf, off, n)
}

fn slice_slice(s, off, n) {
    if !_slice_is_list(s) { return _err_invalid("slice_slice: expects slice") }
    if oren_type_tag(off) == 0 || oren_type_tag(n) == 0 { return _err_invalid("slice_slice: nil off/len") }
    if off < 0 || n < 0 { return _err_invalid("slice_slice: negative off/len") }
    var base_off = s[1]
    var base_n = s[2]
    if off + n > base_n { return _err_invalid("slice_slice: out of bounds") }
    return [s[0], base_off + off, n]
}

fn try_slice_slice(s, off, n) {
    if !_slice_is_list(s) { return _err_invalid("buffer.try_slice_slice: expects slice") }
    var ok_off = _check_nonneg_int(off, "buffer.try_slice_slice", "off")
    if oren_is_err(ok_off) { return ok_off }
    var ok_n = _check_nonneg_int(n, "buffer.try_slice_slice", "len")
    if oren_is_err(ok_n) { return ok_n }
    return slice_slice(s, off, n)
}

fn slice_len(s) {
    if !_slice_is_list(s) { return _err_invalid("slice_len: expects slice") }
    return s[2]
}

fn try_slice_len(s) {
    if !_slice_is_list(s) { return _err_invalid("buffer.try_slice_len: expects slice") }
    return s[2]
}

fn strided_new(buf, off, n, stride) {
    if oren_type_tag(off) == 0 || oren_type_tag(n) == 0 || oren_type_tag(stride) == 0 { return _err_invalid("strided_new: nil arg") }
    if off < 0 || n < 0 { return _err_invalid("strided_new: negative off/len") }
    if stride <= 0 { return _err_invalid("strided_new: stride must be > 0") }
    var bl = oren_buf_len(buf)
    if oren_is_err(bl) { return bl }
    if n == 0 { return [buf, off, 0, stride] }
    var last = off + (n - 1) * stride
    if off > bl || last < 0 || last >= bl { return _err_invalid("strided_new: out of bounds") }
    return [buf, off, n, stride]
}

fn try_strided_new(buf, off, n, stride) {
    var ok_off = _check_nonneg_int(off, "buffer.try_strided_new", "off")
    if oren_is_err(ok_off) { return ok_off }
    var ok_n = _check_nonneg_int(n, "buffer.try_strided_new", "len")
    if oren_is_err(ok_n) { return ok_n }
    var ok_stride = _check_positive_int(stride, "buffer.try_strided_new", "stride")
    if oren_is_err(ok_stride) { return ok_stride }
    return strided_new(buf, off, n, stride)
}

fn strided_len(s) {
    if !_strided_is_list(s) { return _err_invalid("strided_len: expects strided") }
    return s[2]
}

fn try_strided_len(s) {
    if !_strided_is_list(s) { return _err_invalid("buffer.try_strided_len: expects strided") }
    return s[2]
}

fn _slice_pos(s, idx) { return s[1] + idx }
fn _strided_pos(s, idx) { return s[1] + idx * s[3] }
fn _buf_load_i32(buf, idx) { return oren_buf_load_i32(buf, idx) }
fn _buf_store_i32(buf, idx, v) { return oren_buf_store_i32(buf, idx, v) }
fn _buf_load_u8(buf, idx) { return oren_buf_load_u8(buf, idx) }
fn _buf_store_u8(buf, idx, v) { return oren_buf_store_u8(buf, idx, v) }
fn _buf_load_f32(buf, idx) { return oren_buf_load_f32(buf, idx) }
fn _buf_store_f32(buf, idx, v) { return oren_buf_store_f32(buf, idx, v) }
fn _buf_load_i64(buf, idx) { return oren_buf_load_i64(buf, idx) }
fn _buf_store_i64(buf, idx, v) { return oren_buf_store_i64(buf, idx, v) }
fn _buf_load_f64(buf, idx) { return oren_buf_load_f64(buf, idx) }
fn _buf_store_f64(buf, idx, v) { return oren_buf_store_f64(buf, idx, v) }

fn _view_load_with(is_viewf, kind_label, posf, loadf, s, idx, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    var n = s[2]
    if idx < 0 || idx >= n { return _err_invalid(ctx + ": index out of bounds") }
    return loadf(s[0], posf(s, idx))
}

fn _view_store_with(is_viewf, kind_label, posf, storef, s, idx, v, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    var n = s[2]
    if idx < 0 || idx >= n { return _err_invalid(ctx + ": index out of bounds") }
    return storef(s[0], posf(s, idx), v)
}

fn _try_view_load(directf, is_viewf, kind_label, s, idx, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    var n = s[2]
    var ok_idx = _check_int(idx, ctx, "index")
    if oren_is_err(ok_idx) { return ok_idx }
    if idx < 0 || idx >= n { return oren_err(4, ctx + ": index out of bounds") }
    return directf(s, idx)
}

fn _try_view_store(directf, validatef, is_viewf, kind_label, s, idx, v, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    var n = s[2]
    var ok_idx = _check_int(idx, ctx, "index")
    if oren_is_err(ok_idx) { return ok_idx }
    if idx < 0 || idx >= n { return oren_err(4, ctx + ": index out of bounds") }
    var ok_v = validatef(v, ctx)
    if oren_is_err(ok_v) { return ok_v }
    return directf(s, idx, ok_v)
}

fn _try_view_unpack(try_loadf, is_viewf, kind_label, s, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    return _view_unpack(try_loadf, s, s[2], ctx)
}

fn _try_u8_view_unpack(try_loadf, is_viewf, kind_label, s, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    return _u8_view_unpack(try_loadf, s, s[2], ctx)
}

fn _try_view_to_typed_buf(try_loadf, is_viewf, kind_label, s, ctx, newf, storef) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    return _view_to_typed_buf(try_loadf, s, s[2], ctx, newf, storef)
}

fn _try_u8_view_to_u8_buf(try_loadf, is_viewf, kind_label, s, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    return _u8_view_to_u8_buf(try_loadf, s, s[2], ctx)
}

fn _try_view_copy_from_list(try_storef, validatef, is_viewf, kind_label, s, xs, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    return _view_copy_from_list(try_storef, s, s[2], xs, ctx, validatef)
}

fn _try_view_copy_from_typed_buf(try_storef, is_viewf, kind_label, s, src, ctx, want_tag, want_label, loadf) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    return _view_copy_from_typed_buf(try_storef, s, s[2], src, ctx, want_tag, want_label, loadf)
}

fn _try_u8_view_to_bytes(try_loadf, is_viewf, kind_label, s, ctx) {
    var xs = _try_u8_view_unpack(try_loadf, is_viewf, kind_label, s, ctx)
    if oren_is_err(xs) { return xs }
    return bytesm.try_pack(xs)
}

fn _try_u8_view_to_string(to_bytesf, s) {
    var bs = to_bytesf(s)
    if oren_is_err(bs) { return bs }
    return bytesm.try_to_string(bs)
}

fn _try_u8_view_copy_from_bytes(try_storef, is_viewf, kind_label, s, bytes, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    return _u8_view_copy_from_bytes(try_storef, s, s[2], bytes, ctx)
}

fn _try_u8_view_copy_from_bytes_slice(try_storef, is_viewf, kind_label, s, bytes, off, count, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    if !_is_int(off) { return oren_err(4, ctx + ": off must be int") }
    if !_is_int(count) { return oren_err(4, ctx + ": n must be int") }
    return _u8_view_copy_from_bytes_slice(try_storef, s, s[2], bytes, off, count, ctx)
}

fn _try_u8_view_copy_from_u8_buf(try_storef, is_viewf, kind_label, s, src, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    return _u8_view_copy_from_u8_buf(try_storef, s, s[2], src, ctx)
}

fn _try_u8_view_copy_from_string(try_storef, is_viewf, kind_label, s, text, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    if oren_type_tag(text) != 4 { return oren_err(4, ctx + ": s must be string") }
    return _u8_view_copy_from_string(try_storef, s, s[2], text, ctx)
}

fn _try_u8_view_copy_from_string_slice(try_storef, is_viewf, kind_label, s, text, off, count, ctx) {
    if !is_viewf(s) { return _err_invalid(ctx + ": expects " + kind_label) }
    return _u8_view_copy_from_string_slice(try_storef, s, s[2], text, off, count, ctx)
}

fn strided_load_i32(s, idx) { return _view_load_with(_strided_is_list, "strided", _strided_pos, _buf_load_i32, s, idx, "strided_load_i32") }
fn try_strided_load_i32(s, idx) { return _try_view_load(strided_load_i32, _strided_is_list, "strided", s, idx, "buffer.try_strided_load_i32") }
fn strided_store_i32(s, idx, v) { return _view_store_with(_strided_is_list, "strided", _strided_pos, _buf_store_i32, s, idx, v, "strided_store_i32") }
fn try_strided_store_i32(s, idx, v) { return _try_view_store(strided_store_i32, _validate_int_or_err, _strided_is_list, "strided", s, idx, v, "buffer.try_strided_store_i32") }
fn try_strided_unpack_i32(s) { return _try_view_unpack(try_strided_load_i32, _strided_is_list, "strided", s, "buffer.try_strided_unpack_i32") }
fn strided_unpack_i32(s) { return try_strided_unpack_i32(s) }
// Safe: fresh output buffer is fully written before any successful return.
fn try_strided_to_i32_buf(s) { return _try_view_to_typed_buf(try_strided_load_i32, _strided_is_list, "strided", s, "buffer.try_strided_to_i32_buf", _new_i32_buf_uninit, _store_i32_buf_unchecked_direct) }
fn strided_to_i32_buf(s) { return try_strided_to_i32_buf(s) }
fn try_strided_copy_from_list_i32(s, xs) { return _try_view_copy_from_list(try_strided_store_i32, _validate_i32_or_err, _strided_is_list, "strided", s, xs, "buffer.try_strided_copy_from_list_i32") }
fn strided_copy_from_list_i32(s, xs) { return try_strided_copy_from_list_i32(s, xs) }
fn try_strided_copy_from_i32_buf(s, src) { return _try_view_copy_from_typed_buf(try_strided_store_i32, _strided_is_list, "strided", s, src, "buffer.try_strided_copy_from_i32_buf", 10, "i32_buf", _load_i32_buf_direct) }
fn strided_copy_from_i32_buf(s, src) { return try_strided_copy_from_i32_buf(s, src) }

fn strided_load_u8(s, idx) { return _view_load_with(_strided_is_list, "strided", _strided_pos, _buf_load_u8, s, idx, "strided_load_u8") }
fn try_strided_load_u8(s, idx) { return _try_view_load(strided_load_u8, _strided_is_list, "strided", s, idx, "buffer.try_strided_load_u8") }
fn strided_store_u8(s, idx, v) { return _view_store_with(_strided_is_list, "strided", _strided_pos, _buf_store_u8, s, idx, v, "strided_store_u8") }
fn try_strided_store_u8(s, idx, v) { return _try_view_store(strided_store_u8, _validate_u8_or_err, _strided_is_list, "strided", s, idx, v, "buffer.try_strided_store_u8") }
fn try_strided_to_bytes(s) { return _try_u8_view_to_bytes(try_strided_load_u8, _strided_is_list, "strided", s, "buffer.try_strided_to_bytes") }
fn strided_to_bytes(s) { return try_strided_to_bytes(s) }
fn try_strided_unpack_u8(s) { return _try_u8_view_unpack(try_strided_load_u8, _strided_is_list, "strided", s, "buffer.try_strided_unpack_u8") }
fn strided_unpack_u8(s) { return try_strided_unpack_u8(s) }
fn try_strided_to_u8_buf(s) { return _try_u8_view_to_u8_buf(try_strided_load_u8, _strided_is_list, "strided", s, "buffer.try_strided_to_u8_buf") }
fn strided_to_u8_buf(s) { return try_strided_to_u8_buf(s) }
