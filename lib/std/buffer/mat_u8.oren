// std/buffer/mat_u8 (rolling)
//
// Dense []u8/string whole-matrix conversion/copy helpers are split out so the
// matrix layer can keep byte/text behavior separate from numeric helpers.

import bytesm "std:bytes"
import mshared "std:buffer/mat_shared"
import core "std:buffer/mat_core"
import proj "std:buffer/mat_proj"
import raw "std:buffer/raw"
import view "std:buffer/view"

fn _err_invalid(msg) { return core._err_invalid(msg) }
fn _u8_validate_or_err(v, ctx) { return mshared._mat_validate_u8_or_err(v, ctx) }

fn _mat_unpack_projected_rows(m, ctx, rowf) {
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    var out = []
    var nrows = m[2]
    var r = 0
    while r < nrows {
        var row = rowf(m, r)
        if oren_is_err(row) { return row }
        oren_list_push(out, row)
        r = r + 1
    }
    return out
}

fn u8_mat_pack_rows(rows) {
    var shape = mshared._rows_shape_or_err(rows, "buffer.u8_mat_pack_rows")
    if oren_is_err(shape) { return shape }
    var nrows = shape[0]
    var ncols = shape[1]
    // Safe: rows pack writes every element of the fresh buffer before successful return.
    var out = raw.u8_new_uninit(nrows * ncols)
    if oren_is_err(out) { return out }
    var data = oren_buf_data_ptr_unchecked(out)
    var i = 0
    var r = 0
    while r < nrows {
        var row = rows[r]
        var c = 0
        while c < ncols {
            var v = _u8_validate_or_err(row[c], "buffer.u8_mat_pack_rows")
            if oren_is_err(v) { return v }
            ptr_set_byte(data + i, v & 255)
            i = i + 1
            c = c + 1
        }
        r = r + 1
    }
    return core.mat_view_new(out, 0, nrows, ncols, ncols)
}

fn u8_mat_unpack_rows(m) {
    return _mat_unpack_projected_rows(m, "buffer.u8_mat_unpack_rows", proj.mat_row_unpack_u8)
}

fn u8_mat_pack_strings(rows) {
    var shape = mshared._string_rows_shape_or_err(rows, "buffer.u8_mat_pack_strings")
    if oren_is_err(shape) { return shape }
    var nrows = shape[0]
    var ncols = shape[1]
    // Safe: string rows pack writes every element of the fresh buffer before successful return.
    var out = raw.u8_new_uninit(nrows * ncols)
    if oren_is_err(out) { return out }
    var data = oren_buf_data_ptr_unchecked(out)
    var i = 0
    var r = 0
    while r < nrows {
        var row = rows[r]
        var c = 0
        while c < ncols {
            ptr_set_byte(data + i, oren_string_byte_at_unchecked(row, c) & 255)
            i = i + 1
            c = c + 1
        }
        r = r + 1
    }
    return core.mat_view_new(out, 0, nrows, ncols, ncols)
}

fn u8_mat_unpack_strings(m) {
    return _mat_unpack_projected_rows(m, "buffer.u8_mat_unpack_strings", proj.mat_row_to_string)
}

fn u8_mat_unpack_u8(m) {
    if !mshared._mat_is_list(m) { return _err_invalid("buffer.u8_mat_unpack_u8: expects mat view") }
    var out = []
    var nrows = m[2]
    var r = 0
    while r < nrows {
        var row = proj.mat_row_unpack_u8(m, r)
        if oren_is_err(row) { return row }
        var ncols = oren_list_len(row)
        var c = 0
        while c < ncols {
            oren_list_push(out, row[c])
            c = c + 1
        }
        r = r + 1
    }
    return out
}

fn u8_mat_unpack_flat(m) {
    return u8_mat_unpack_u8(m)
}

fn _u8_mat_is_dense_u8_buf(m) {
    return mshared._mat_is_list(m) && oren_is_u8_buf(m[0]) == true && m[4] == m[3]
}

fn _u8_mat_is_direct_u8_buf_view(m) {
    if !mshared._mat_is_list(m) { return false }
    if oren_is_u8_buf(m[0]) != true { return false }
    if mshared._is_int(m[1]) == false || mshared._is_int(m[2]) == false || mshared._is_int(m[3]) == false || mshared._is_int(m[4]) == false {
        return false
    }
    if m[1] < 0 || m[2] < 0 || m[3] < 0 || m[4] < 0 { return false }
    if m[4] < m[3] { return false }
    var bl = oren_buf_len(m[0])
    if bl == nil || oren_is_err(bl) { return false }
    if m[2] == 0 || m[3] == 0 { return true }
    var last = m[1] + (m[2] - 1) * m[4] + (m[3] - 1)
    if last < 0 || last >= bl { return false }
    return true
}

fn _u8_mat_to_u8_buf_direct(m, ctx) {
    if _u8_mat_is_direct_u8_buf_view(m) {
        var out: []u8 = raw.u8_new_uninit(m[2] * m[3])
        if oren_is_err(out) { return out }
        var src = oren_buf_data_ptr_unchecked(m[0])
        var dst = oren_buf_data_ptr_unchecked(out)
        var i = 0
        var r = 0
        while r < m[2] {
            var row_src = src + m[1] + r * m[4]
            var c = 0
            while c < m[3] {
                ptr_set_byte(dst + i, ptr_get_byte(row_src + c) & 255)
                i = i + 1
                c = c + 1
            }
            r = r + 1
        }
        return out
    }
    return mshared._mat_to_typed_buf_with(m, ctx, raw.u8_new_uninit, core.mat_load_u8, raw._store_u8_buf_unchecked_direct)
}

fn u8_mat_to_bytes(m) {
    var ctx = "buffer.u8_mat_to_bytes"
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    if _u8_mat_is_dense_u8_buf(m) { return bytesm.slice(m[0], m[1], m[2] * m[3]) }
    var buf = u8_mat_to_u8_buf(m)
    if oren_is_err(buf) { return buf }
    return raw.u8_to_bytes(buf)
}

fn u8_mat_to_u8_buf(m) {
    var ctx = "buffer.u8_mat_to_u8_buf"
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    if _u8_mat_is_dense_u8_buf(m) { return bytesm.to_u8_buf_slice(m[0], m[1], m[2] * m[3]) }
    // Safe: whole-matrix export overwrites every lane of the fresh buffer before return.
    return _u8_mat_to_u8_buf_direct(m, ctx)
}

fn u8_mat_to_string(m) {
    var ctx = "buffer.u8_mat_to_string"
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    if _u8_mat_is_dense_u8_buf(m) { return bytesm.to_string_slice(m[0], m[1], m[2] * m[3]) }
    var bytes = u8_mat_to_bytes(m)
    if oren_is_err(bytes) { return bytes }
    return bytesm.to_string(bytes)
}

fn _u8_mat_copy_flat_list(m, xs, ctx) {
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    if oren_type_tag(xs) != 6 { return _err_invalid(ctx + ": expects list<int>") }
    var total = m[2] * m[3]
    var nx = oren_list_len(xs)
    if nx == nil || oren_is_err(nx) { return _err_invalid(ctx + ": expects list<int>") }
    if nx != total { return _err_invalid(ctx + ": byte count mismatch") }
    var i = 0
    while i < nx {
        var v = _u8_validate_or_err(xs[i], ctx)
        if oren_is_err(v) { return v }
        i = i + 1
    }
    if _u8_mat_is_dense_u8_buf(m) {
        var data = oren_buf_data_ptr_unchecked(m[0])
        i = 0
        while i < nx {
            ptr_set_byte(data + m[1] + i, xs[i] & 255)
            i = i + 1
        }
        return m[0]
    }
    var r = 0
    while r < m[2] {
        var row = proj.mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < m[3] {
            var rc = view.slice_store_u8(row, c, xs[r * m[3] + c])
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn _u8_mat_copy_from_u8_buf(m, src, ctx) {
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    var total = m[2] * m[3]
    var nx = oren_buf_len(src)
    if nx == nil || oren_is_err(nx) { return _err_invalid(ctx + ": src must be []u8") }
    if nx != total { return _err_invalid(ctx + ": byte count mismatch") }
    if oren_is_u8_buf(m[0]) == true && m[4] == m[3] && oren_is_u8_buf(src) == true {
        var rc0 = bytesm.copy_into(m[0], m[1], src, 0, total)
        if oren_is_err(rc0) { return rc0 }
        return m[0]
    }
    var r = 0
    while r < m[2] {
        var row = proj.mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < m[3] {
            var v = raw._load_u8_direct(src, r * m[3] + c)
            if oren_is_err(v) { return v }
            var rc = view.slice_store_u8(row, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn _u8_mat_copy_from_string_range(m, text, off, n, ctx) {
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    if oren_type_tag(text) != 4 { return oren_err(4, ctx + ": text must be string") }
    if mshared._is_int(off) == false { return oren_err(4, ctx + ": off must be int") }
    if mshared._is_int(n) == false { return oren_err(4, ctx + ": len must be int") }
    if off < 0 || n < 0 { return oren_err(4, ctx + ": negative off/len") }
    var total = m[2] * m[3]
    if n != total { return _err_invalid(ctx + ": byte count mismatch") }
    var text_len = oren_string_len(text)
    if oren_is_err(text_len) { return text_len }
    if off + n > text_len { return oren_err(4, ctx + ": slice out of bounds") }
    if oren_is_u8_buf(m[0]) == true && m[4] == m[3] {
        var data = oren_buf_data_ptr_unchecked(m[0])
        var i = 0
        while i < total {
            ptr_set_byte(data + m[1] + i, oren_string_byte_at_unchecked(text, off + i) & 255)
            i = i + 1
        }
        return m[0]
    }
    var r = 0
    while r < m[2] {
        var row = proj.mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < m[3] {
            var idx = off + r * m[3] + c
            var rc = view.slice_store_u8(row, c, oren_string_byte_at_unchecked(text, idx) & 255)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn u8_mat_copy_from_bytes(m, bytes) {
    var ctx = "buffer.u8_mat_copy_from_bytes"
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    var total = m[2] * m[3]
    var bv = bytesm.view(bytes, ctx)
    if oren_is_err(bv) { return bv }
    var nb = bytesm.view_len(bv)
    if nb != total { return _err_invalid(ctx + ": byte count mismatch") }
    if oren_is_u8_buf(m[0]) == true && m[4] == m[3] {
        var rc0 = bytesm.copy_into(m[0], m[1], bytes, 0, total)
        if oren_is_err(rc0) { return rc0 }
        return m[0]
    }
    var input_data = bytesm.view_bytes(bv)
    var input_ptr = bytesm.view_ptr(bv)
    var r = 0
    while r < m[2] {
        var row = proj.mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < m[3] {
            var v = bytesm.view_get_u8_from(input_data, input_ptr, r * m[3] + c)
            var rc = view.slice_store_u8(row, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn u8_mat_copy_from_bytes_slice(m, bytes, off, n) {
    var ctx = "buffer.u8_mat_copy_from_bytes_slice"
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    if mshared._is_int(off) == false { return oren_err(4, ctx + ": off must be int") }
    if mshared._is_int(n) == false { return oren_err(4, ctx + ": len must be int") }
    var total = m[2] * m[3]
    var bv = bytesm.view(bytes, ctx)
    if oren_is_err(bv) { return bv }
    var nb = bytesm.view_len(bv)
    if off < 0 || n < 0 || off + n > nb { return oren_err(4, ctx + ": slice out of bounds") }
    if n != total { return _err_invalid(ctx + ": byte count mismatch") }
    if oren_is_u8_buf(m[0]) == true && m[4] == m[3] {
        var rc0 = bytesm.copy_into(m[0], m[1], bytes, off, n)
        if oren_is_err(rc0) { return rc0 }
        return m[0]
    }
    var input_data = bytesm.view_bytes(bv)
    var input_ptr = bytesm.view_ptr(bv)
    var r = 0
    while r < m[2] {
        var row = proj.mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < m[3] {
            var v = bytesm.view_get_u8_from(input_data, input_ptr, off + r * m[3] + c)
            var rc = view.slice_store_u8(row, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn u8_mat_copy_from_u8_buf(m, src) {
    return _u8_mat_copy_from_u8_buf(m, src, "buffer.u8_mat_copy_from_u8_buf")
}

fn u8_mat_copy_from_string(m, text) {
    if oren_type_tag(text) != 4 { return oren_err(4, "buffer.u8_mat_copy_from_string: text must be string") }
    var n = oren_string_len(text)
    if oren_is_err(n) { return n }
    return _u8_mat_copy_from_string_range(m, text, 0, n, "buffer.u8_mat_copy_from_string")
}

fn u8_mat_copy_from_string_slice(m, text, off, n) {
    return _u8_mat_copy_from_string_range(m, text, off, n, "buffer.u8_mat_copy_from_string_slice")
}

fn u8_mat_copy_from_flat(m, xs) {
    return _u8_mat_copy_flat_list(m, xs, "buffer.u8_mat_copy_from_flat")
}

fn u8_mat_copy_from_rows(m, rows) {
    var shape = mshared._mat_rows_shape_match_or_err(m, rows, "buffer.u8_mat_copy_from_rows")
    if oren_is_err(shape) { return shape }
    if _u8_mat_is_dense_u8_buf(m) {
        var vr = 0
        while vr < shape[0] {
            var vc = 0
            while vc < shape[1] {
                var vv = _u8_validate_or_err(rows[vr][vc], "buffer.u8_mat_copy_from_rows")
                if oren_is_err(vv) { return vv }
                vc = vc + 1
            }
            vr = vr + 1
        }
        var data = oren_buf_data_ptr_unchecked(m[0])
        var i = 0
        var wr = 0
        while wr < shape[0] {
            var wc = 0
            while wc < shape[1] {
                ptr_set_byte(data + m[1] + i, rows[wr][wc] & 255)
                i = i + 1
                wc = wc + 1
            }
            wr = wr + 1
        }
        return m[0]
    }
    var r = 0
    while r < shape[0] {
        var row = proj.mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < shape[1] {
            var v = _u8_validate_or_err(rows[r][c], "buffer.u8_mat_copy_from_rows")
            if oren_is_err(v) { return v }
            var rc = view.slice_store_u8(row, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn u8_mat_copy_from_strings(m, rows) {
    var shape = mshared._mat_string_rows_shape_match_or_err(m, rows, "buffer.u8_mat_copy_from_strings")
    if oren_is_err(shape) { return shape }
    var r = 0
    while r < shape[0] {
        var rc = proj.mat_row_copy_from_string(m, r, rows[r])
        if oren_is_err(rc) { return rc }
        r = r + 1
    }
    return m[0]
}
