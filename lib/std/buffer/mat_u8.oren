// std/buffer/mat_u8 (rolling)
//
// Dense []u8/string whole-matrix conversion/copy helpers are split out so the
// matrix layer can keep byte/text behavior separate from numeric helpers.

import bytesm "std:bytes"
import mshared "std:buffer/mat_shared"
import core "std:buffer/mat_core"
import proj "std:buffer/mat_proj"
import raw "std:buffer/raw"
import view "std:buffer/view"

fn _err_invalid(msg) { return core._err_invalid(msg) }
fn _u8_validate_or_err(v, ctx) { return mshared._mat_validate_u8_or_err(v, ctx) }

fn _mat_unpack_projected_rows(m, ctx, rowf) {
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    var out = []
    var nrows = m[2]
    var r = 0
    while r < nrows {
        var row = rowf(m, r)
        if oren_is_err(row) { return row }
        oren_list_push(out, row)
        r = r + 1
    }
    return out
}

fn u8_mat_pack_rows(rows) {
    var shape = mshared._rows_shape_or_err(rows, "buffer.u8_mat_pack_rows")
    if oren_is_err(shape) { return shape }
    var nrows = shape[0]
    var ncols = shape[1]
    // Safe: rows pack writes every element of the fresh buffer before successful return.
    var out = raw.u8_new_uninit(nrows * ncols)
    if oren_is_err(out) { return out }
    var i = 0
    var r = 0
    while r < nrows {
        var row = rows[r]
        var c = 0
        while c < ncols {
            var v = _u8_validate_or_err(row[c], "buffer.u8_mat_pack_rows")
            if oren_is_err(v) { return v }
            var rc = raw._store_u8_buf_unchecked_direct(out, i, v)
            if oren_is_err(rc) { return rc }
            i = i + 1
            c = c + 1
        }
        r = r + 1
    }
    return core.try_mat_view_new(out, 0, nrows, ncols, ncols)
}

fn u8_mat_unpack_rows(m) {
    return _mat_unpack_projected_rows(m, "buffer.u8_mat_unpack_rows", proj.mat_row_unpack_u8)
}

fn u8_mat_pack_strings(rows) {
    var shape = mshared._string_rows_shape_or_err(rows, "buffer.u8_mat_pack_strings")
    if oren_is_err(shape) { return shape }
    var nrows = shape[0]
    var ncols = shape[1]
    // Safe: string rows pack writes every element of the fresh buffer before successful return.
    var out = raw.u8_new_uninit(nrows * ncols)
    if oren_is_err(out) { return out }
    var i = 0
    var r = 0
    while r < nrows {
        var row = rows[r]
        var c = 0
        while c < ncols {
            var rc = raw._store_u8_buf_unchecked_direct(out, i, oren_string_byte_at_unchecked(row, c) & 255)
            if oren_is_err(rc) { return rc }
            i = i + 1
            c = c + 1
        }
        r = r + 1
    }
    return core.try_mat_view_new(out, 0, nrows, ncols, ncols)
}

fn u8_mat_unpack_strings(m) {
    return _mat_unpack_projected_rows(m, "buffer.u8_mat_unpack_strings", proj.mat_row_to_string)
}

fn u8_mat_unpack_u8(m) {
    if !mshared._mat_is_list(m) { return _err_invalid("buffer.u8_mat_unpack_u8: expects mat view") }
    var out = []
    var nrows = m[2]
    var r = 0
    while r < nrows {
        var row = proj.mat_row_unpack_u8(m, r)
        if oren_is_err(row) { return row }
        var ncols = oren_list_len(row)
        var c = 0
        while c < ncols {
            oren_list_push(out, row[c])
            c = c + 1
        }
        r = r + 1
    }
    return out
}

fn u8_mat_unpack_flat(m) {
    return u8_mat_unpack_u8(m)
}

fn u8_mat_to_bytes(m) {
    var buf = u8_mat_to_u8_buf(m)
    if oren_is_err(buf) { return buf }
    return raw.u8_to_bytes(buf)
}

fn u8_mat_to_u8_buf(m) {
    // Safe: whole-matrix export overwrites every lane of the fresh buffer before return.
    return mshared._mat_to_typed_buf_with(m, "buffer.u8_mat_to_u8_buf", raw.u8_new_uninit, core.try_mat_load_u8, raw._store_u8_buf_unchecked_direct)
}

fn u8_mat_to_string(m) {
    var bytes = u8_mat_to_bytes(m)
    if oren_is_err(bytes) { return bytes }
    return bytesm.to_string(bytes)
}

fn _u8_mat_copy_flat_list(m, xs, ctx) {
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    if oren_type_tag(xs) != 6 { return _err_invalid(ctx + ": expects list<int>") }
    var total = m[2] * m[3]
    var nx = oren_list_len(xs)
    if nx == nil || oren_is_err(nx) { return _err_invalid(ctx + ": expects list<int>") }
    if nx != total { return _err_invalid(ctx + ": byte count mismatch") }
    var i = 0
    while i < nx {
        var v = _u8_validate_or_err(xs[i], ctx)
        if oren_is_err(v) { return v }
        i = i + 1
    }
    var r = 0
    while r < m[2] {
        var row = proj.mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < m[3] {
            var rc = view.try_slice_store_u8(row, c, xs[r * m[3] + c])
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn _u8_mat_copy_from_u8_buf(m, src, ctx) {
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    var total = m[2] * m[3]
    var nx = oren_buf_len(src)
    if nx == nil || oren_is_err(nx) { return _err_invalid(ctx + ": src must be []u8") }
    if nx != total { return _err_invalid(ctx + ": byte count mismatch") }
    var r = 0
    while r < m[2] {
        var row = proj.mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < m[3] {
            var v = oren_buf_load_u8(src, r * m[3] + c)
            if oren_is_err(v) { return v }
            var rc = view.try_slice_store_u8(row, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn u8_mat_copy_from_bytes(m, bytes) {
    var src = bytesm.to_u8_buf(bytes)
    if oren_is_err(src) { return src }
    return _u8_mat_copy_from_u8_buf(m, src, "buffer.u8_mat_copy_from_bytes")
}

fn u8_mat_copy_from_bytes_slice(m, bytes, off, n) {
    var src = bytesm.to_u8_buf_slice(bytes, off, n)
    if oren_is_err(src) { return src }
    return _u8_mat_copy_from_u8_buf(m, src, "buffer.u8_mat_copy_from_bytes_slice")
}

fn u8_mat_copy_from_u8_buf(m, src) {
    return _u8_mat_copy_from_u8_buf(m, src, "buffer.u8_mat_copy_from_u8_buf")
}

fn u8_mat_copy_from_string(m, text) {
    var src = raw.u8_from_string(text)
    if oren_is_err(src) { return src }
    return _u8_mat_copy_from_u8_buf(m, src, "buffer.u8_mat_copy_from_string")
}

fn u8_mat_copy_from_string_slice(m, text, off, n) {
    var src = raw.u8_from_string_slice(text, off, n)
    if oren_is_err(src) { return src }
    return _u8_mat_copy_from_u8_buf(m, src, "buffer.u8_mat_copy_from_string_slice")
}

fn u8_mat_copy_from_flat(m, xs) {
    return _u8_mat_copy_flat_list(m, xs, "buffer.u8_mat_copy_from_flat")
}

fn u8_mat_copy_from_rows(m, rows) {
    var shape = mshared._mat_rows_shape_match_or_err(m, rows, "buffer.u8_mat_copy_from_rows")
    if oren_is_err(shape) { return shape }
    var r = 0
    while r < shape[0] {
        var row = proj.mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < shape[1] {
            var v = _u8_validate_or_err(rows[r][c], "buffer.u8_mat_copy_from_rows")
            if oren_is_err(v) { return v }
            var rc = view.try_slice_store_u8(row, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn u8_mat_copy_from_strings(m, rows) {
    var shape = mshared._mat_string_rows_shape_match_or_err(m, rows, "buffer.u8_mat_copy_from_strings")
    if oren_is_err(shape) { return shape }
    var r = 0
    while r < shape[0] {
        var rc = proj.mat_row_copy_from_string(m, r, rows[r])
        if oren_is_err(rc) { return rc }
        r = r + 1
    }
    return m[0]
}

