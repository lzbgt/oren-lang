// std/buffer/mat_numeric (rolling)
//
// Dense numeric whole-matrix conversion/copy helpers are split out so the
// matrix layer can keep numeric and u8/string behavior in separate modules.

import mshared "std:buffer/mat_shared"
import core "std:buffer/mat_core"
import raw "std:buffer/raw"

fn _mat_pack_rows_with(rows, ctx, shapef, newf, validatef, storef) {
    var shape = shapef(rows, ctx)
    if oren_is_err(shape) { return shape }
    var nrows = shape[0]
    var ncols = shape[1]
    var out = newf(nrows * ncols)
    if oren_is_err(out) { return out }
    var mat = core.try_mat_view_new(out, 0, nrows, ncols, ncols)
    if oren_is_err(mat) { return mat }
    var r = 0
    while r < nrows {
        var row = rows[r]
        var c = 0
        while c < ncols {
            var v = validatef(row[c], ctx)
            if oren_is_err(v) { return v }
            var rc = storef(mat, r, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return mat
}

fn _mat_copy_from_rows_with(m, rows, ctx, validatef, storef) {
    var shape = mshared._mat_rows_shape_match_or_err(m, rows, ctx)
    if oren_is_err(shape) { return shape }
    var r = 0
    while r < shape[0] {
        var row = rows[r]
        var c = 0
        while c < shape[1] {
            var v = validatef(row[c], ctx)
            if oren_is_err(v) { return v }
            var rc = storef(m, r, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn i32_mat_pack_rows(rows) {
    // Safe: rows pack writes every element of the fresh buffer before successful return.
    return _mat_pack_rows_with(rows, "buffer.i32_mat_pack_rows", mshared._rows_shape_or_err, raw.i32_new_uninit, mshared._mat_validate_i32_or_err, core.try_mat_store_i32)
}

fn try_i32_mat_pack_rows(rows) {
    return i32_mat_pack_rows(rows)
}

fn i32_mat_unpack_rows(m) {
    return mshared._mat_unpack_rows_with(m, "buffer.i32_mat_unpack_rows", core.try_mat_load_i32)
}

fn try_i32_mat_unpack_rows(m) {
    return i32_mat_unpack_rows(m)
}

fn i32_mat_unpack_flat(m) {
    return mshared._mat_unpack_flat_with(m, "buffer.i32_mat_unpack_flat", core.try_mat_load_i32)
}

fn try_i32_mat_unpack_flat(m) {
    return i32_mat_unpack_flat(m)
}

fn i32_mat_to_i32_buf(m) {
    // Safe: whole-matrix export overwrites every lane of the fresh buffer before return.
    return mshared._mat_to_typed_buf_with(m, "buffer.i32_mat_to_i32_buf", raw.i32_new_uninit, core.try_mat_load_i32, raw._store_i32_buf_unchecked_direct)
}

fn try_i32_mat_to_i32_buf(m) {
    return i32_mat_to_i32_buf(m)
}

fn i32_mat_copy_from_rows(m, rows) {
    return _mat_copy_from_rows_with(m, rows, "buffer.i32_mat_copy_from_rows", mshared._mat_validate_i32_or_err, core.try_mat_store_i32)
}

fn try_i32_mat_copy_from_rows(m, rows) {
    return i32_mat_copy_from_rows(m, rows)
}

fn i32_mat_copy_from_flat(m, xs) {
    return mshared._mat_copy_from_flat_with(m, xs, "buffer.i32_mat_copy_from_flat", mshared._mat_validate_i32_or_err, core.try_mat_store_i32)
}

fn try_i32_mat_copy_from_flat(m, xs) {
    return i32_mat_copy_from_flat(m, xs)
}

fn i32_mat_copy_from_i32_buf(m, src) {
    return mshared._mat_copy_from_typed_buf_with(m, src, "buffer.i32_mat_copy_from_i32_buf", 10, "i32_buf", raw._load_i32_buf_direct, core.try_mat_store_i32)
}

fn try_i32_mat_copy_from_i32_buf(m, src) {
    return i32_mat_copy_from_i32_buf(m, src)
}

