fn i32_mat_pack_rows(rows) {
    var shape = _rows_shape_or_err(rows, "buffer.i32_mat_pack_rows")
    if oren_is_err(shape) { return shape }
    var nrows = shape[0]
    var ncols = shape[1]
    var out = i32_new(nrows * ncols)
    if oren_is_err(out) { return out }
    var mat = try_mat_view_new(out, 0, nrows, ncols, ncols)
    if oren_is_err(mat) { return mat }
    var r = 0
    while r < nrows {
        var row = rows[r]
        var c = 0
        while c < ncols {
            var v = row[c]
            if _is_int(v) == false { return oren_err(4, "buffer.i32_mat_pack_rows: value not int") }
            if v < -2147483648 || v > 2147483647 {
                return _err_invalid("buffer.i32_mat_pack_rows: value out of i32 range")
            }
            var rc = try_mat_store_i32(mat, r, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return mat
}

fn try_i32_mat_pack_rows(rows) {
    return i32_mat_pack_rows(rows)
}

fn i32_mat_unpack_rows(m) {
    return _mat_unpack_rows_with(m, "buffer.i32_mat_unpack_rows", try_mat_load_i32)
}

