    return u8_mat_to_bytes(m)
}

fn u8_mat_to_u8_buf(m) {
    var bytes = u8_mat_to_bytes(m)
    if oren_is_err(bytes) { return bytes }
    return bytesm.try_to_u8_buf(bytes)
}

