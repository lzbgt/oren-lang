// std/buffer/mat_dense (rolling)
//
// Dense whole-matrix conversion/copy helpers are split out so `mat_core`
// can stay focused on shared matrix-view primitives and row/column bridges.

import bytesm "std:bytes"
import mshared "std:buffer/mat_shared"
import core "std:buffer/mat_core"
import proj "std:buffer/mat_proj"
import raw "std:buffer/raw"
import view "std:buffer/view"

fn _err_invalid(msg) { return core._err_invalid(msg) }
fn _is_int(v) { return core._is_int(v) }

fn _u8_validate_or_err(v, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    if v < 0 || v > 255 { return oren_err(4, ctx + ": byte out of range") }
    return v
}

fn _mat_pack_rows_with(rows, ctx, shapef, newf, validatef, storef) {
    var shape = shapef(rows, ctx)
    if oren_is_err(shape) { return shape }
    var nrows = shape[0]
    var ncols = shape[1]
    var out = newf(nrows * ncols)
    if oren_is_err(out) { return out }
    var mat = core.try_mat_view_new(out, 0, nrows, ncols, ncols)
    if oren_is_err(mat) { return mat }
    var r = 0
    while r < nrows {
        var row = rows[r]
        var c = 0
        while c < ncols {
            var v = validatef(row[c], ctx)
            if oren_is_err(v) { return v }
            var rc = storef(mat, r, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return mat
}

fn _mat_copy_from_rows_with(m, rows, ctx, validatef, storef) {
    var shape = mshared._mat_rows_shape_match_or_err(m, rows, ctx)
    if oren_is_err(shape) { return shape }
    var r = 0
    while r < shape[0] {
        var row = rows[r]
        var c = 0
        while c < shape[1] {
            var v = validatef(row[c], ctx)
            if oren_is_err(v) { return v }
            var rc = storef(m, r, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn _mat_unpack_projected_rows(m, ctx, rowf) {
    if !mshared._mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    var out = []
    var nrows = m[2]
    var r = 0
    while r < nrows {
        var row = rowf(m, r)
        if oren_is_err(row) { return row }
        oren_list_push(out, row)
        r = r + 1
    }
    return out
}

fn i32_mat_pack_rows(rows) {
    return _mat_pack_rows_with(rows, "buffer.i32_mat_pack_rows", mshared._rows_shape_or_err, raw.i32_new, mshared._mat_validate_i32_or_err, core.try_mat_store_i32)
}

fn try_i32_mat_pack_rows(rows) {
    return i32_mat_pack_rows(rows)
}

fn i32_mat_unpack_rows(m) {
