fn _u8_mat_copy_flat_list(m, xs, ctx) {
    if !_mat_is_list(m) { return _err_invalid(ctx + ": expects mat view") }
    if oren_type_tag(xs) != 6 { return _err_invalid(ctx + ": expects list<int>") }
    var total = m[2] * m[3]
    var nx = oren_list_len(xs)
    if nx == nil || oren_is_err(nx) { return _err_invalid(ctx + ": expects list<int>") }
    if nx != total { return _err_invalid(ctx + ": byte count mismatch") }
    var i = 0
    while i < nx {
        var v = xs[i]
        if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
        if v < 0 || v > 255 { return oren_err(4, ctx + ": byte out of range") }
        i = i + 1
    }
    var r = 0
    while r < m[2] {
        var row = try_mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < m[3] {
            var rc = try_slice_store_u8(row, c, xs[r * m[3] + c])
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn u8_mat_copy_from_bytes(m, bytes) {
    var xs = bytesm.try_unpack(bytes)
    if oren_is_err(xs) { return xs }
    return _u8_mat_copy_flat_list(m, xs, "buffer.u8_mat_copy_from_bytes")
}

fn try_u8_mat_copy_from_bytes(m, bytes) {
    return u8_mat_copy_from_bytes(m, bytes)
}

fn u8_mat_copy_from_u8_buf(m, src) {
    var bytes = try_u8_to_bytes(src)
    if oren_is_err(bytes) { return bytes }
    return u8_mat_copy_from_bytes(m, bytes)
}

fn try_u8_mat_copy_from_u8_buf(m, src) {
    return u8_mat_copy_from_u8_buf(m, src)
}

fn u8_mat_copy_from_string(m, text) {
    var bytes = bytesm.try_from_string(text)
    if oren_is_err(bytes) { return bytes }
    return u8_mat_copy_from_bytes(m, bytes)
}

fn try_u8_mat_copy_from_string(m, text) {
    return u8_mat_copy_from_string(m, text)
}

fn u8_mat_copy_from_rows(m, rows) {
    var shape = _mat_rows_shape_match_or_err(m, rows, "buffer.u8_mat_copy_from_rows")
    if oren_is_err(shape) { return shape }
    var r = 0
    while r < shape[0] {
        var row = try_mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var c = 0
        while c < shape[1] {
            var v = rows[r][c]
            if _is_int(v) == false { return oren_err(4, "buffer.u8_mat_copy_from_rows: value not int") }
            if v < 0 || v > 255 { return oren_err(4, "buffer.u8_mat_copy_from_rows: byte out of range") }
            var rc = try_slice_store_u8(row, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

fn try_u8_mat_copy_from_rows(m, rows) {
    return u8_mat_copy_from_rows(m, rows)
}

fn u8_mat_copy_from_strings(m, rows) {
    var shape = _mat_string_rows_shape_match_or_err(m, rows, "buffer.u8_mat_copy_from_strings")
    if oren_is_err(shape) { return shape }
    var r = 0
    while r < shape[0] {
        var rc = try_mat_row_copy_from_string(m, r, rows[r])
        if oren_is_err(rc) { return rc }
        r = r + 1
    }
    return m[0]
}

fn try_u8_mat_copy_from_strings(m, rows) {
    return u8_mat_copy_from_strings(m, rows)
}
