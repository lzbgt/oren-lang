fn i32_mat_copy_from_rows(m, rows) {
    var shape = _mat_rows_shape_match_or_err(m, rows, "buffer.i32_mat_copy_from_rows")
    if oren_is_err(shape) { return shape }
    var r = 0
    while r < shape[0] {
        var c = 0
        while c < shape[1] {
            var v = rows[r][c]
            if _is_int(v) == false { return oren_err(4, "buffer.i32_mat_copy_from_rows: value not int") }
            if v < -2147483648 || v > 2147483647 {
                return _err_invalid("buffer.i32_mat_copy_from_rows: value out of i32 range")
            }
            var rc = try_mat_store_i32(m, r, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return m[0]
}

