fn u8_mat_pack_rows(rows) {
    var shape = _rows_shape_or_err(rows, "buffer.u8_mat_pack_rows")
    if oren_is_err(shape) { return shape }
    var nrows = shape[0]
    var ncols = shape[1]
    var out = u8_new(nrows * ncols)
    if oren_is_err(out) { return out }
    var mat = try_mat_view_new(out, 0, nrows, ncols, ncols)
    if oren_is_err(mat) { return mat }
    var r = 0
    while r < nrows {
        var row_view = try_mat_row_slice(mat, r)
        if oren_is_err(row_view) { return row_view }
        var row = rows[r]
        var c = 0
        while c < ncols {
            var v = row[c]
            if _is_int(v) == false { return oren_err(4, "buffer.u8_mat_pack_rows: value not int") }
            if v < 0 || v > 255 { return oren_err(4, "buffer.u8_mat_pack_rows: byte out of range") }
            var rc = try_slice_store_u8(row_view, c, v)
            if oren_is_err(rc) { return rc }
            c = c + 1
        }
        r = r + 1
    }
    return mat
}

fn try_u8_mat_pack_rows(rows) {
    return u8_mat_pack_rows(rows)
}

fn u8_mat_unpack_rows(m) {
    if !_mat_is_list(m) { return _err_invalid("buffer.u8_mat_unpack_rows: expects mat view") }
    var nrows = m[2]
    var out = []
    var r = 0
    while r < nrows {
        var row = try_mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var xs = try_slice_unpack_u8(row)
        if oren_is_err(xs) { return xs }
        oren_list_push(out, xs)
        r = r + 1
    }
    return out
}

fn try_u8_mat_unpack_rows(m) {
    return u8_mat_unpack_rows(m)
}

fn u8_mat_pack_strings(rows) {
    var shape = _string_rows_shape_or_err(rows, "buffer.u8_mat_pack_strings")
    if oren_is_err(shape) { return shape }
    var nrows = shape[0]
    var ncols = shape[1]
    var out = u8_new(nrows * ncols)
    if oren_is_err(out) { return out }
    var mat = try_mat_view_new(out, 0, nrows, ncols, ncols)
    if oren_is_err(mat) { return mat }
    var r = 0
    while r < nrows {
        var row_view = try_mat_row_slice(mat, r)
        if oren_is_err(row_view) { return row_view }
        var rc = try_slice_copy_from_string(row_view, rows[r])
        if oren_is_err(rc) { return rc }
        r = r + 1
    }
    return mat
}

fn try_u8_mat_pack_strings(rows) {
    return u8_mat_pack_strings(rows)
}

fn u8_mat_unpack_strings(m) {
    if !_mat_is_list(m) { return _err_invalid("buffer.u8_mat_unpack_strings: expects mat view") }
    var nrows = m[2]
    var out = []
    var r = 0
    while r < nrows {
        var row = try_mat_row_slice(m, r)
        if oren_is_err(row) { return row }
        var s = try_slice_to_string(row)
        if oren_is_err(s) { return s }
        oren_list_push(out, s)
        r = r + 1
    }
    return out
}

fn try_u8_mat_unpack_strings(m) {
    return u8_mat_unpack_strings(m)
}

fn u8_mat_unpack_u8(m) {
    if !_mat_is_list(m) { return _err_invalid("buffer.u8_mat_unpack_u8: expects mat view") }
    var out = []
    var nrows = m[2]
    var r = 0
    while r < nrows {
        var row = try_mat_row_unpack_u8(m, r)
        if oren_is_err(row) { return row }
        var ncols = oren_list_len(row)
        var c = 0
        while c < ncols {
            oren_list_push(out, row[c])
            c = c + 1
        }
        r = r + 1
    }
    return out
}

fn try_u8_mat_unpack_u8(m) {
    return u8_mat_unpack_u8(m)
}

fn u8_mat_to_bytes(m) {
    var xs = u8_mat_unpack_u8(m)
    if oren_is_err(xs) { return xs }
    return bytesm.try_pack(xs)
}

