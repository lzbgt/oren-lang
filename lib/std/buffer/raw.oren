// std/buffer/raw (rolling)
//
// Shared raw typed-buffer constructors, direct typed load/store helpers, and
// checked raw/list/string bridge surface for the split std:buffer modules.

import list "std:list"
import bytesm "std:bytes"
import common "std:buffer/common"

fn _err_invalid(msg) { return common._err_invalid(msg) }
fn _is_int(v) { return common._is_int(v) }

fn u8_new(n) { return oren_u8_buf_new(n) }
// Internal fast-path for fresh buffers that will be fully initialized before return.
fn u8_new_uninit(n) { return oren_u8_buf_new_uninit(n) }
fn i32_new(n) { return oren_i32_buf_new(n) }
// Internal fast-path for fresh buffers that will be fully initialized before return.
fn i32_new_uninit(n) { return oren_i32_buf_new_uninit(n) }
fn i64_new(n) { return oren_i64_buf_new(n) }
fn i64_new_uninit(n) { return oren_i64_buf_new_uninit(n) }
fn f32_new(n) { return oren_f32_buf_new(n) }
fn f32_new_uninit(n) { return oren_f32_buf_new_uninit(n) }
fn f64_new(n) { return oren_f64_buf_new(n) }
fn f64_new_uninit(n) { return oren_f64_buf_new_uninit(n) }

fn _len_or_err(buf, ctx) {
    var n = oren_buf_len(buf)
    if n == nil || oren_is_err(n) { return oren_err(4, ctx + ": buf must be typed buffer") }
    return n
}

fn _check_idx(buf, idx, ctx) {
    var n = _len_or_err(buf, ctx)
    if oren_is_err(n) { return n }
    if _is_int(idx) == false { return oren_err(4, ctx + ": index not int") }
    if idx < 0 || idx >= n { return oren_err(4, ctx + ": index out of bounds") }
    return n
}

fn _validate_i32_or_err(v, ctx) { return common._validate_i32_or_err(v, ctx) }
fn _validate_i64_or_err(v, ctx) { return common._validate_i64_or_err(v, ctx) }
fn _validate_passthru_or_err(v, ctx) { return common._validate_passthru_or_err(v, ctx) }

fn _list_len_like_or_err(xs, ctx) {
    if oren_type_tag(xs) != 6 { return _err_invalid(ctx + ": expects list<int>") }
    var n = list.len(xs)
    if oren_is_err(n) { return _err_invalid(ctx + ": expects list<int>") }
    return n
}

fn _validate_u8_or_err(v, ctx) { return common._validate_u8_or_err(v, ctx) }

fn _validate_int_or_err(v, ctx) {
    if _is_int(v) == false { return oren_err(4, ctx + ": value not int") }
    return v
}

fn _copy_u8_ptr_forward(dstp, srcp, n) {
    var i = 0
    while i < n {
        ptr_set_byte(dstp + i, ptr_get_byte(srcp + i) & 255)
        i = i + 1
    }
    return n
}

fn _load_u8_direct(buf, idx) {
    if oren_is_u8_buf(buf) == true { return ptr_get_byte(oren_buf_data_ptr_unchecked(buf) + idx) & 255 }
    return oren_buf_load_u8(buf, idx)
}
fn _store_u8_direct(buf, idx, v) {
    if oren_is_u8_buf(buf) == true { return _store_u8_unchecked_direct(buf, idx, v) }
    return oren_buf_store_u8(buf, idx, v)
}
fn _store_u8_unchecked_direct(buf, idx, v) {
    var data = oren_buf_data_ptr_unchecked(buf)
    ptr_set_byte(data + idx, v)
    return buf
}
fn _load_i32_direct(buf, idx) { return oren_buf_load_i32(buf, idx) }
fn _store_i32_direct(buf, idx, v) { return oren_buf_store_i32(buf, idx, v) }
fn _store_i32_unchecked_direct(buf, idx, v) {
    var data = oren_buf_data_ptr_unchecked(buf)
    var off = idx * 4
    var u = v & 4294967295
    ptr_set_byte(data + off + 0, u & 255)
    ptr_set_byte(data + off + 1, (u >> 8) & 255)
    ptr_set_byte(data + off + 2, (u >> 16) & 255)
    ptr_set_byte(data + off + 3, (u >> 24) & 255)
    return buf
}
fn _load_i64_direct(buf, idx) { return oren_buf_load_i64(buf, idx) }
fn _store_i64_direct(buf, idx, v) { return oren_buf_store_i64(buf, idx, v) }
fn _load_f32_direct(buf, idx) { return oren_buf_load_f32(buf, idx) }
fn _store_f32_direct(buf, idx, v) { return oren_buf_store_f32(buf, idx, v) }
fn _load_f64_direct(buf, idx) { return oren_buf_load_f64(buf, idx) }
fn _store_f64_direct(buf, idx, v) { return oren_buf_store_f64(buf, idx, v) }
fn _store_i64_unchecked_direct(buf, idx, v) {
    var data = oren_buf_data_ptr_unchecked(buf)
    var off = idx * 8
    var i = 0
    while i < 8 {
        ptr_set_byte(data + off + i, (v >> (i * 8)) & 255)
        i = i + 1
    }
    return buf
}
fn _store_f32_unchecked_direct(buf, idx, v: f64) {
    var data = oren_buf_data_ptr_unchecked(buf)
    var off = idx * 4
    var bits = oren_f32_to_u32_bits(v)
    ptr_set_byte(data + off + 0, bits & 255)
    ptr_set_byte(data + off + 1, (bits >> 8) & 255)
    ptr_set_byte(data + off + 2, (bits >> 16) & 255)
    ptr_set_byte(data + off + 3, (bits >> 24) & 255)
    return buf
}
fn _store_f64_unchecked_direct(buf, idx, v: f64) {
    var data = oren_buf_data_ptr_unchecked(buf)
    var off = idx * 8
    var bits = oren_f64_to_u64_bits(v)
    ptr_set_byte(data + off + 0, bits & 255)
    ptr_set_byte(data + off + 1, (bits >> 8) & 255)
    ptr_set_byte(data + off + 2, (bits >> 16) & 255)
    ptr_set_byte(data + off + 3, (bits >> 24) & 255)
    ptr_set_byte(data + off + 4, (bits >> 32) & 255)
    ptr_set_byte(data + off + 5, (bits >> 40) & 255)
    ptr_set_byte(data + off + 6, (bits >> 48) & 255)
    ptr_set_byte(data + off + 7, (bits >> 56) & 255)
    return buf
}

fn _store_u8_buf_unchecked_direct(buf, idx, v) { return _store_u8_unchecked_direct(buf, idx, v) }
fn _store_i32_buf_direct(buf, idx, v) { return oren_buf_store_i32(buf, idx, v) }
fn _store_i32_buf_unchecked_direct(buf, idx, v) { return _store_i32_unchecked_direct(buf, idx, v) }
fn _load_i32_buf_direct(buf, idx) { return oren_buf_load_i32(buf, idx) }
fn _store_i64_buf_direct(buf, idx, v) { return oren_buf_store_i64(buf, idx, v) }
fn _store_i64_buf_unchecked_direct(buf, idx, v) { return _store_i64_unchecked_direct(buf, idx, v) }
fn _load_i64_buf_direct(buf, idx) { return oren_buf_load_i64(buf, idx) }
fn _store_f32_buf_direct(buf, idx, v) { return oren_buf_store_f32(buf, idx, v) }
fn _store_f32_buf_unchecked_direct(buf, idx, v) { return _store_f32_unchecked_direct(buf, idx, v) }
fn _load_f32_buf_direct(buf, idx) { return oren_buf_load_f32(buf, idx) }
fn _store_f64_buf_direct(buf, idx, v) { return oren_buf_store_f64(buf, idx, v) }
fn _store_f64_buf_unchecked_direct(buf, idx, v) { return _store_f64_unchecked_direct(buf, idx, v) }
fn _load_f64_buf_direct(buf, idx) { return oren_buf_load_f64(buf, idx) }

fn _checked_load_with(buf, idx, ctx, loadf) {
    var n = _check_idx(buf, idx, ctx)
    if oren_is_err(n) { return n }
    return loadf(buf, idx)
}

fn _checked_store_with(buf, idx, v, ctx, validatef, storef) {
    var n = _check_idx(buf, idx, ctx)
    if oren_is_err(n) { return n }
    var ok_v = validatef(v, ctx)
    if oren_is_err(ok_v) { return ok_v }
    return storef(buf, idx, ok_v)
}

fn _unpack_list_like_with(buf, ctx, loadf) {
    var n = _len_or_err(buf, ctx)
    if oren_is_err(n) { return n }
    var out = []
    var i = 0
    while i < n {
        var v = loadf(buf, i)
        if oren_is_err(v) { return v }
        oren_list_push(out, v)
        i = i + 1
    }
    return out
}

fn _pack_list_like_into_with(out, xs, ctx, storef, validatef) {
    var n = _list_len_like_or_err(xs, ctx)
    if oren_is_err(n) { return n }
    var no = _len_or_err(out, ctx)
    if oren_is_err(no) { return no }
    if no != n { return _err_invalid(ctx + ": length mismatch") }
    var i = 0
    while i < n {
        var v = validatef(xs[i], ctx)
        if oren_is_err(v) { return v }
        var rc = storef(out, i, v)
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return out
}

fn _pack_list_like_new_buf_with(xs, ctx, newf, storef, validatef) {
    var n = _list_len_like_or_err(xs, ctx)
    if oren_is_err(n) { return n }
    var out = newf(n)
    if oren_is_err(out) { return out }
    var i = 0
    while i < n {
        var v = validatef(xs[i], ctx)
        if oren_is_err(v) { return v }
        var rc = storef(out, i, v)
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return out
}

fn _copy_from_typed_buf_with(out, src, ctx, want_label, loadf, storef) {
    var no = _len_or_err(out, ctx)
    if oren_is_err(no) { return no }
    var ns = _len_or_err(src, ctx)
    if oren_is_err(ns) { return ns }
    if no != ns { return _err_invalid(ctx + ": length mismatch") }
    var i = 0
    while i < no {
        var v = loadf(src, i)
        if oren_is_err(v) { return _err_invalid(ctx + ": expects " + want_label) }
        var rc = storef(out, i, v)
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return out
}

fn len(buf) {
    return _len_or_err(buf, "buffer.len")
}

fn load_u8(buf, idx) {
    return _checked_load_with(buf, idx, "buffer.load_u8", _load_u8_direct)
}

fn store_u8(buf, idx, v) {
    return _checked_store_with(buf, idx, v, "buffer.store_u8", _validate_u8_or_err, _store_u8_direct)
}

fn load_i32(buf, idx) {
    return _checked_load_with(buf, idx, "buffer.load_i32", _load_i32_direct)
}

fn store_i32(buf, idx, v) {
    return _checked_store_with(buf, idx, v, "buffer.store_i32", _validate_int_or_err, _store_i32_direct)
}

fn load_i64(buf, idx) {
    return _checked_load_with(buf, idx, "buffer.load_i64", _load_i64_direct)
}

fn store_i64(buf, idx, v) {
    return _checked_store_with(buf, idx, v, "buffer.store_i64", _validate_i64_or_err, _store_i64_direct)
}

fn load_f32(buf, idx) {
    return _checked_load_with(buf, idx, "buffer.load_f32", _load_f32_direct)
}

fn store_f32(buf, idx, v) {
    return _checked_store_with(buf, idx, v, "buffer.store_f32", _validate_passthru_or_err, _store_f32_direct)
}

fn load_f64(buf, idx) {
    return _checked_load_with(buf, idx, "buffer.load_f64", _load_f64_direct)
}

fn store_f64(buf, idx, v) {
    return _checked_store_with(buf, idx, v, "buffer.store_f64", _validate_passthru_or_err, _store_f64_direct)
}

fn i32_pack_list_int(xs) {
    return oren_i32_buf_pack_list_int(xs)
}

fn i32_pack_list_int_into(out: []i32, xs) {
    return oren_i32_buf_pack_list_int_into(out, xs)
}

fn i32_unpack_list(buf: []i32) {
    return _unpack_list_like_with(buf, "buffer.i32_unpack_list", _load_i32_direct)
}

fn i64_pack_list_int(xs) {
    // Safe: on success this path overwrites every lane before the fresh buffer is returned.
    return _pack_list_like_new_buf_with(xs, "buffer.i64_pack_list_int", i64_new_uninit, _store_i64_buf_unchecked_direct, _validate_i64_or_err)
}

fn i64_pack_list_int_into(out: []i64, xs) {
    return _pack_list_like_into_with(out, xs, "buffer.i64_pack_list_int_into", _store_i64_direct, _validate_i64_or_err)
}

fn i64_unpack_list(buf: []i64) {
    return _unpack_list_like_with(buf, "buffer.i64_unpack_list", _load_i64_direct)
}

fn f32_pack_list(xs) {
    // Safe: on success this path overwrites every lane before the fresh buffer is returned.
    return _pack_list_like_new_buf_with(xs, "buffer.f32_pack_list", f32_new_uninit, _store_f32_buf_direct, _validate_passthru_or_err)
}

fn f32_pack_list_into(out: []f32, xs) {
    return _pack_list_like_into_with(out, xs, "buffer.f32_pack_list_into", _store_f32_direct, _validate_passthru_or_err)
}

fn f32_unpack_list(buf: []f32) {
    return _unpack_list_like_with(buf, "buffer.f32_unpack_list", _load_f32_direct)
}

fn f64_pack_list(xs) {
    // Safe: on success this path overwrites every lane before the fresh buffer is returned.
    return _pack_list_like_new_buf_with(xs, "buffer.f64_pack_list", f64_new_uninit, _store_f64_buf_direct, _validate_passthru_or_err)
}

fn f64_pack_list_into(out: []f64, xs) {
    return _pack_list_like_into_with(out, xs, "buffer.f64_pack_list_into", _store_f64_direct, _validate_passthru_or_err)
}

fn f64_unpack_list(buf: []f64) {
    return _unpack_list_like_with(buf, "buffer.f64_unpack_list", _load_f64_direct)
}

fn u8_pack(xs) {
    // Safe: on success this path overwrites every lane before the fresh buffer is returned.
    return _pack_list_like_new_buf_with(xs, "buffer.u8_pack", u8_new_uninit, _store_u8_buf_unchecked_direct, _validate_u8_or_err)
}

fn u8_pack_into(out: []u8, xs) {
    return _pack_list_like_into_with(out, xs, "buffer.u8_pack_into", _store_u8_direct, _validate_u8_or_err)
}

fn u8_unpack(buf: []u8) {
    if oren_is_u8_buf(buf) == true { return bytesm.unpack(buf) }
    return _unpack_list_like_with(buf, "buffer.u8_unpack", _load_u8_direct)
}

fn u8_from_string(s) {
    if oren_type_tag(s) != 4 { return oren_err(4, "buffer.u8_from_string: s must be string") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return n }
    var out: []u8 = u8_new_uninit(n)
    if oren_is_err(out) { return out }
    var data = oren_buf_data_ptr_unchecked(out)
    var i = 0
    while i < n {
        ptr_set_byte(data + i, oren_string_byte_at_unchecked(s, i) & 255)
        i = i + 1
    }
    return out
}

fn u8_to_string(buf: []u8) {
    var n = oren_buf_len(buf)
    if n == nil || oren_is_err(n) { return oren_err(4, "buffer.u8_to_string: buf must be []u8") }
    return oren_string_from_bytes_slice(buf, 0, n)
}

fn u8_from_bytes(bytes) {
    return bytesm.to_u8_buf(bytes)
}

fn u8_from_string_slice(s, off, n) {
    if oren_type_tag(s) != 4 { return oren_err(4, "buffer.u8_from_string_slice: s must be string") }
    if _is_int(off) == false { return oren_err(4, "buffer.u8_from_string_slice: off must be int") }
    if _is_int(n) == false { return oren_err(4, "buffer.u8_from_string_slice: n must be int") }
    if off < 0 || n < 0 { return oren_err(4, "buffer.u8_from_string_slice: negative off/len") }
    var total = oren_string_len(s)
    if oren_is_err(total) { return total }
    if off + n > total { return oren_err(4, "buffer.u8_from_string_slice: slice out of bounds") }
    var out: []u8 = u8_new_uninit(n)
    if oren_is_err(out) { return out }
    var data = oren_buf_data_ptr_unchecked(out)
    var i = 0
    while i < n {
        ptr_set_byte(data + i, oren_string_byte_at_unchecked(s, off + i) & 255)
        i = i + 1
    }
    return out
}

fn u8_from_bytes_slice(bytes, off, n) {
    return bytesm.to_u8_buf_slice(bytes, off, n)
}

fn u8_to_bytes(buf: []u8) { return bytesm.from_u8_buf(buf) }

fn u8_copy_from_u8_buf(out: []u8, src) {
    var ctx = "buffer.u8_copy_from_u8_buf"
    var no = _len_or_err(out, ctx)
    if oren_is_err(no) { return no }
    var ns = _len_or_err(src, ctx)
    if oren_is_err(ns) { return ns }
    if oren_is_u8_buf(out) != true || oren_is_u8_buf(src) != true { return _err_invalid(ctx + ": expects u8_buf") }
    if no != ns { return _err_invalid(ctx + ": length mismatch") }
    if no > 0 { _copy_u8_ptr_forward(oren_buf_data_ptr_unchecked(out), oren_buf_data_ptr_unchecked(src), no) }
    return out
}

fn u8_copy_from_bytes(out: []u8, bytes) {
    var ctx = "buffer.u8_copy_from_bytes"
    var no = _len_or_err(out, ctx)
    if oren_is_err(no) { return no }
    var nb = bytesm.len(bytes)
    if oren_is_err(nb) { return nb }
    if no != nb { return _err_invalid(ctx + ": length mismatch") }
    return bytesm.copy_into(out, 0, bytes, 0, no)
}

fn u8_copy_from_bytes_slice(out: []u8, bytes, off, n) {
    var ctx = "buffer.u8_copy_from_bytes_slice"
    var no = _len_or_err(out, ctx)
    if oren_is_err(no) { return no }
    if _is_int(n) == false { return oren_err(4, ctx + ": len must be int") }
    if no != n { return _err_invalid(ctx + ": length mismatch") }
    return bytesm.copy_into(out, 0, bytes, off, n)
}

fn _u8_copy_from_string_range(out: []u8, s, off, n, ctx) {
    if oren_type_tag(s) != 4 { return oren_err(4, ctx + ": s must be string") }
    if _is_int(off) == false { return oren_err(4, ctx + ": off must be int") }
    if _is_int(n) == false { return oren_err(4, ctx + ": len must be int") }
    if off < 0 || n < 0 { return oren_err(4, ctx + ": negative off/len") }
    var no = _len_or_err(out, ctx)
    if oren_is_err(no) { return no }
    if no != n { return _err_invalid(ctx + ": length mismatch") }
    var total = oren_string_len(s)
    if oren_is_err(total) { return total }
    if off + n > total { return oren_err(4, ctx + ": slice out of bounds") }
    var i = 0
    while i < n {
        var rc = _store_u8_direct(out, i, oren_string_byte_at_unchecked(s, off + i) & 255)
        if oren_is_err(rc) { return rc }
        i = i + 1
    }
    return out
}

fn u8_copy_from_string(out: []u8, s) {
    if oren_type_tag(s) != 4 { return oren_err(4, "buffer.u8_copy_from_string: s must be string") }
    var n = oren_string_len(s)
    if oren_is_err(n) { return n }
    return _u8_copy_from_string_range(out, s, 0, n, "buffer.u8_copy_from_string")
}

fn u8_copy_from_string_slice(out: []u8, s, off, n) {
    return _u8_copy_from_string_range(out, s, off, n, "buffer.u8_copy_from_string_slice")
}

fn i32_copy_from_i32_buf(out: []i32, src) {
    return _copy_from_typed_buf_with(out, src, "buffer.i32_copy_from_i32_buf", "i32_buf", _load_i32_direct, _store_i32_direct)
}

fn i64_copy_from_i64_buf(out: []i64, src) {
    return _copy_from_typed_buf_with(out, src, "buffer.i64_copy_from_i64_buf", "i64_buf", _load_i64_direct, _store_i64_direct)
}

fn f32_copy_from_f32_buf(out: []f32, src) {
    return _copy_from_typed_buf_with(out, src, "buffer.f32_copy_from_f32_buf", "f32_buf", _load_f32_direct, _store_f32_direct)
}

fn f64_copy_from_f64_buf(out: []f64, src) {
    return _copy_from_typed_buf_with(out, src, "buffer.f64_copy_from_f64_buf", "f64_buf", _load_f64_direct, _store_f64_direct)
}
