// std/buffer/mat_proj (rolling)
//
// Matrix projection helpers live here so `mat_core` can stay focused on the
// matrix-view object and typed cell load/store primitives.

import common "std:buffer/common"
import core "std:buffer/mat_core"
import view "std:buffer/view"

fn _err_invalid(msg) { return common._err_invalid(msg) }
fn _check_int(v, ctx, label) { return common._check_int(v, ctx, label) }
fn _check_nonneg_int(v, ctx, label) { return common._check_nonneg_int(v, ctx, label) }
fn _mat_is_list(m) { return common._mat_is_list(m) }

fn mat_row_slice(m, r) {
    if !_mat_is_list(m) { return _err_invalid("mat_row_slice: expects mat view") }
    var rows = m[2]
    if r < 0 || r >= rows { return _err_invalid("mat_row_slice: row out of bounds") }
    return view.slice_new(m[0], m[1] + r * m[4], m[3])
}

fn try_mat_row_slice(m, r) {
    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_row_slice: expects mat view") }
    var ok_r = _check_int(r, "buffer.try_mat_row_slice", "row")
    if oren_is_err(ok_r) { return ok_r }
    return mat_row_slice(m, r)
}

fn mat_col_strided(m, c) {
    if !_mat_is_list(m) { return _err_invalid("mat_col_strided: expects mat view") }
    var cols = m[3]
    if c < 0 || c >= cols { return _err_invalid("mat_col_strided: col out of bounds") }
    return view.strided_new(m[0], m[1] + c, m[2], m[4])
}

fn try_mat_col_strided(m, c) {
    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_col_strided: expects mat view") }
    var ok_c = _check_int(c, "buffer.try_mat_col_strided", "col")
    if oren_is_err(ok_c) { return ok_c }
    return mat_col_strided(m, c)
}

fn mat_subview(m, row_off, col_off, rows, cols) {
    if !_mat_is_list(m) { return _err_invalid("mat_subview: expects mat view") }
    if row_off < 0 || col_off < 0 || rows < 0 || cols < 0 {
        return _err_invalid("mat_subview: negative arg")
    }
    if row_off > m[2] || col_off > m[3] { return _err_invalid("mat_subview: offset out of bounds") }
    if row_off + rows > m[2] || col_off + cols > m[3] { return _err_invalid("mat_subview: subview out of bounds") }
    return core.mat_view_new(m[0], m[1] + row_off * m[4] + col_off, rows, cols, m[4])
}

fn try_mat_subview(m, row_off, col_off, rows, cols) {
    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_subview: expects mat view") }
    var ok_row_off = _check_nonneg_int(row_off, "buffer.try_mat_subview", "row_off")
    if oren_is_err(ok_row_off) { return ok_row_off }
    var ok_col_off = _check_nonneg_int(col_off, "buffer.try_mat_subview", "col_off")
    if oren_is_err(ok_col_off) { return ok_col_off }
    var ok_rows = _check_nonneg_int(rows, "buffer.try_mat_subview", "rows")
    if oren_is_err(ok_rows) { return ok_rows }
    var ok_cols = _check_nonneg_int(cols, "buffer.try_mat_subview", "cols")
    if oren_is_err(ok_cols) { return ok_cols }
    return mat_subview(m, row_off, col_off, rows, cols)
}

fn mat_diag_strided(m) {
    if !_mat_is_list(m) { return _err_invalid("mat_diag_strided: expects mat view") }
    var n = m[2]
    if m[3] < n { n = m[3] }
    return view.strided_new(m[0], m[1], n, m[4] + 1)
}

fn try_mat_diag_strided(m) {
    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_diag_strided: expects mat view") }
    return mat_diag_strided(m)
}

fn _proj0(m, projectf, opf) {
    var v = projectf(m)
    if oren_is_err(v) { return v }
    return opf(v)
}

fn _proj1(m, key, projectf, opf) {
    var v = projectf(m, key)
    if oren_is_err(v) { return v }
    return opf(v)
}

fn _proj0_copy(m, src, projectf, opf) {
    var v = projectf(m)
    if oren_is_err(v) { return v }
    return opf(v, src)
}

fn _proj1_copy(m, key, src, projectf, opf) {
    var v = projectf(m, key)
    if oren_is_err(v) { return v }
    return opf(v, src)
}

fn mat_diag_to_bytes(m) { return _proj0(m, mat_diag_strided, view.try_strided_to_bytes) }
fn try_mat_diag_to_bytes(m) { return _proj0(m, try_mat_diag_strided, view.try_strided_to_bytes) }
fn mat_diag_unpack_u8(m) { return _proj0(m, mat_diag_strided, view.try_strided_unpack_u8) }
fn try_mat_diag_unpack_u8(m) { return _proj0(m, try_mat_diag_strided, view.try_strided_unpack_u8) }
