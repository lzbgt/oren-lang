fn mat_diag_copy_from_list_i32(m, xs) { return _proj0_copy(m, xs, try_mat_diag_strided, view.try_strided_copy_from_list_i32) }
fn try_mat_diag_copy_from_i32_buf(m, src) { return _proj0_copy(m, src, try_mat_diag_strided, view.try_strided_copy_from_i32_buf) }
fn mat_diag_copy_from_i32_buf(m, src) { return _proj0_copy(m, src, try_mat_diag_strided, view.try_strided_copy_from_i32_buf) }
