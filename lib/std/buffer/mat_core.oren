    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_load_f32: expects mat view") }
    var ok_r = _check_int(r, "buffer.try_mat_load_f32", "row")
    if oren_is_err(ok_r) { return ok_r }
    var ok_c = _check_int(c, "buffer.try_mat_load_f32", "col")
    if oren_is_err(ok_c) { return ok_c }
    return mat_load_f32(m, r, c)
}

