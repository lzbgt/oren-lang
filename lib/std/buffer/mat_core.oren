// std/buffer/mat_core (rolling)
//
// Matrix-view core primitives live here so projection/bridge helpers can stay
// in separate modules.

import common "std:buffer/common"

fn _err_invalid(msg) { return common._err_invalid(msg) }
fn _is_int(v) { return common._is_int(v) }
fn _check_int(v, ctx, label) { return common._check_int(v, ctx, label) }
fn _check_nonneg_int(v, ctx, label) { return common._check_nonneg_int(v, ctx, label) }
fn _mat_is_list(m) { return common._mat_is_list(m) }

fn mat_view_new(buf, off, rows, cols, row_stride) {
    if off < 0 || rows < 0 || cols < 0 || row_stride < 0 {
        return _err_invalid("mat_view_new: negative arg")
    }
    if row_stride < cols {
        return _err_invalid("mat_view_new: stride < cols")
    }
    // Bounds: last element index = off + (rows-1)*row_stride + (cols-1)
    var bl = oren_buf_len(buf)
    if oren_is_err(bl) { return bl }
    if rows == 0 || cols == 0 { return [buf, off, rows, cols, row_stride] }
    var last = off + (rows - 1) * row_stride + (cols - 1)
    if last < 0 || last >= bl { return _err_invalid("mat_view_new: out of bounds") }
    return [buf, off, rows, cols, row_stride]
}

fn try_mat_view_new(buf, off, rows, cols, row_stride) {
    var ok_off = _check_nonneg_int(off, "buffer.try_mat_view_new", "off")
    if oren_is_err(ok_off) { return ok_off }
    var ok_rows = _check_nonneg_int(rows, "buffer.try_mat_view_new", "rows")
    if oren_is_err(ok_rows) { return ok_rows }
    var ok_cols = _check_nonneg_int(cols, "buffer.try_mat_view_new", "cols")
    if oren_is_err(ok_cols) { return ok_cols }
    var ok_stride = _check_nonneg_int(row_stride, "buffer.try_mat_view_new", "row_stride")
    if oren_is_err(ok_stride) { return ok_stride }
    return mat_view_new(buf, off, rows, cols, row_stride)
}

fn mat_rows(m) {
    if !_mat_is_list(m) { return _err_invalid("mat_rows: expects mat view") }
    return m[2]
}

fn try_mat_rows(m) {
    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_rows: expects mat view") }
    return m[2]
}

fn mat_cols(m) {
    if !_mat_is_list(m) { return _err_invalid("mat_cols: expects mat view") }
    return m[3]
}

fn try_mat_cols(m) {
    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_cols: expects mat view") }
    return m[3]
}

fn mat_row_stride(m) {
    if !_mat_is_list(m) { return _err_invalid("mat_row_stride: expects mat view") }
    return m[4]
}

fn try_mat_row_stride(m) {
    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_row_stride: expects mat view") }
    return m[4]
}

fn mat_load_f32(m, r, c) {
    if !_mat_is_list(m) { return _err_invalid("mat_load_f32: expects mat view") }
    var rows = m[2]
    var cols = m[3]
    if r < 0 || c < 0 || r >= rows || c >= cols { return _err_invalid("mat_load_f32: index out of bounds") }
    var idx = m[1] + r * m[4] + c
    return oren_buf_load_f32(m[0], idx)
}

fn try_mat_load_f32(m, r, c) {
    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_load_f32: expects mat view") }
    var ok_r = _check_int(r, "buffer.try_mat_load_f32", "row")
    if oren_is_err(ok_r) { return ok_r }
    var ok_c = _check_int(c, "buffer.try_mat_load_f32", "col")
    if oren_is_err(ok_c) { return ok_c }
    return mat_load_f32(m, r, c)
}

fn mat_store_f32(m, r, c, v) {
    if !_mat_is_list(m) { return _err_invalid("mat_store_f32: expects mat view") }
    var rows = m[2]
    var cols = m[3]
    if r < 0 || c < 0 || r >= rows || c >= cols { return _err_invalid("mat_store_f32: index out of bounds") }
    var idx = m[1] + r * m[4] + c
    return oren_buf_store_f32(m[0], idx, v)
}

fn try_mat_store_f32(m, r, c, v) {
    if !_mat_is_list(m) { return _err_invalid("buffer.try_mat_store_f32: expects mat view") }
    var ok_r = _check_int(r, "buffer.try_mat_store_f32", "row")
    if oren_is_err(ok_r) { return ok_r }
    var ok_c = _check_int(c, "buffer.try_mat_store_f32", "col")
    if oren_is_err(ok_c) { return ok_c }
    return mat_store_f32(m, r, c, v)
}

fn mat_load_i32(m, r, c) {
    if !_mat_is_list(m) { return _err_invalid("mat_load_i32: expects mat view") }
    var rows = m[2]
    var cols = m[3]
    if r < 0 || c < 0 || r >= rows || c >= cols { return _err_invalid("mat_load_i32: index out of bounds") }
    var idx = m[1] + r * m[4] + c
    return oren_buf_load_i32(m[0], idx)
