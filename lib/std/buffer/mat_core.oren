    if !_mat_is_list(m) { return _err_invalid("mat_store_i32: expects mat view") }
    var rows = m[2]
    var cols = m[3]
    if r < 0 || c < 0 || r >= rows || c >= cols { return _err_invalid("mat_store_i32: index out of bounds") }
    var idx = m[1] + r * m[4] + c
    return oren_buf_store_i32(m[0], idx, v)
}

fn mat_store_i32(m, r, c, v) {
    if !_mat_is_list(m) { return _err_invalid("buffer.mat_store_i32: expects mat view") }
    var ok_r = _check_int(r, "buffer.mat_store_i32", "row")
    if oren_is_err(ok_r) { return ok_r }
    var ok_c = _check_int(c, "buffer.mat_store_i32", "col")
    if oren_is_err(ok_c) { return ok_c }
    if _is_int(v) == false { return oren_err(4, "buffer.mat_store_i32: value not int") }
    return _mat_store_i32_unchecked(m, r, c, v)
}

