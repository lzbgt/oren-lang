var GLOBAL_OFF_PROC_ALLOW_EXEC_PREFIXES_PTR = 176
var GLOBAL_OFF_PROC_INHERIT_ENV = 184
var GLOBAL_OFF_PROC_ALLOW_ENV_KEYS_PTR = 192
var GLOBAL_OFF_PROC_ALLOW_ARGV_PTR = 200
var GLOBAL_OFF_PROC_ALLOWED_PIDS_PTR = 240
var GLOBAL_OFF_PROC_ALLOWED_PIDS_LEN = 248
var GLOBAL_OFF_PROC_ALLOWED_PIDS_CAP = 256
var GLOBAL_OFF_ENABLE_SIMD = 264
