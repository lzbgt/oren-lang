fn oren_memcpy(dst, src, len) {
    var i = 0
    while i < len {
        if len - i >= 8 {
            ptr_set(dst + i, ptr_get(src + i))
            i = i + 8
        } else {
            ptr_set_byte(dst + i, ptr_get_byte(src + i))
            i = i + 1
        }
    }
    return 0
}

// --- Channels (Pipe-based) ---
fn oren_new_channel() {
    return oren_pipe() // Returns [r, w]
}

fn oren_chan_send(ch, val) {
    var w = oren_list_get(ch, 1)
    var buf = malloc(8)
    if buf == 0 { return 0 }
    ptr_set(buf, val)
    sys_write(w, buf, 8)
    // free(buf) - no free yet
    return 1
}

fn oren_chan_recv(ch) {
    var r = oren_list_get(ch, 0)
    var buf = malloc(8)
    if buf == 0 { return 0 }
    sys_read(r, buf, 8)
    var val = ptr_get(buf)
    // free(buf)
    return val
}

// --- Native GC/Heap Tracking ---
fn oren_pipe() {
    var buf = malloc(16)
    if buf == 0 { return oren_new_list(0) }
    
    var res = sys_pipe(buf)
    if res != 0 { return oren_new_list(0) }
    
    var r = ptr_get(buf)
    var w = ptr_get(buf + 8)
    
    var l = oren_new_list(2)
    oren_list_push(l, r)
    oren_list_push(l, w)
    return l
}

// --- Native GC/Heap Tracking ---

// We use a string literal in a function to get a stable pointer to writable memory for globals.
// Layout (8-byte slots):
//   0:allocs
//   8:roots
//   16:lock_owner_tid
//   24:free
//   32:threads
//   40:argc
//   48:argv
//   56:lock_recurse_count
//   64:envp
var g_storage = 0

fn oren_globals() {
    return g_storage
}

fn global_get_allocs() { return ptr_get(oren_globals()) }
fn global_set_allocs(v) { ptr_set(oren_globals(), v) }

fn global_get_roots() { return ptr_get(iadd(oren_globals(), 8)) }
fn global_set_roots(v) { ptr_set(iadd(oren_globals(), 8), v) }

fn global_get_lock() { return ptr_get(iadd(oren_globals(), 16)) }
fn global_set_lock(v) { ptr_set(iadd(oren_globals(), 16), v) }

fn global_get_free() { return ptr_get(iadd(oren_globals(), 24)) }
fn global_set_free(v) { ptr_set(iadd(oren_globals(), 24), v) }

fn global_get_threads() { return ptr_get(iadd(oren_globals(), 32)) }
fn global_set_threads(v) { ptr_set(iadd(oren_globals(), 32), v) }

fn global_get_argc() { return ptr_get(iadd(oren_globals(), 40)) }
fn global_set_argc(v) { ptr_set(iadd(oren_globals(), 40), v) }

fn global_get_argv() { return ptr_get(iadd(oren_globals(), 48)) }
fn global_set_argv(v) { ptr_set(iadd(oren_globals(), 48), v) }

fn global_get_lock_count() { return ptr_get(iadd(oren_globals(), 56)) }
fn global_set_lock_count(v) { ptr_set(iadd(oren_globals(), 56), v) }

fn global_get_envp() { return ptr_get(iadd(oren_globals(), 64)) }
fn global_set_envp(v) { ptr_set(iadd(oren_globals(), 64), v) }

fn native_runtime_init() {
    // Reserve room for current globals + some growth slack (rolling ABI).
    // 10 * 8 = 80 bytes.
    g_storage = malloc(80)
    if g_storage == 0 { exit(199) }
    
    // Zero it
    var i = 0
    while i < 10 {
        ptr_set(g_storage + i * 8, 0)
        i = i + 1
    }
    return 0
}

// macOS syscall-first threading init (Darwin bsdthread + ulock model).
//
// NOTE:
// - This is intentionally "best-effort" for now: if the process is already
//   registered (because the host runtime registered earlier), the syscall
//   will fail with EINVAL; we treat that as non-fatal for v0.
// - For Oren's syscall-first runtime we want the kernel threadstart function
//   to be OUR stub (emitted by the native backend), not libpthread.
//
// Args are code pointers to the native backend's thread entry stubs.
fn native_runtime_threading_init(threadstart, wqthread) {
    // Some Darwin kernels validate pthsize for bsdthread_register; use 16KB (page-sized) like libpthread.
    var pthsize = 16384

    // NOTE: Modern Darwin bsdthread_register has multiple historical ABIs.
    // Passing a pthread init-data struct can trigger EINVAL on some kernels.
    // For v0 syscall-first spawn, we register only threadstart/wqthread + pthsize
    // and omit init-data / workqueue settings.
    var rv = sys_bsdthread_register(threadstart, wqthread, pthsize, 0, 0, 0, 0)
    // For syscall-first spawn to work, the process must be registered.
    // If registration fails, bsdthread_create will start threads with the system's default
    // threadstart (libsystem_pthread), which expects a full pthread runtime and will crash.
    // sys_bsdthread_register returns -errno on failure.
    if rv < 0 { exit(0 - rv) }
    return rv
}

fn native_runtime_set_args(argc, argv) {
    global_set_argc(argc)
    global_set_argv(argv)
    return 0
}

fn native_runtime_set_envp(envp) {
    // Keep this function leaf-like (no calls) to avoid any stack-offset bugs
    // while the compiler/runtime ABI is still evolving.
    ptr_set(iadd(oren_globals(), 64), envp)
    return 0
}

// --- ENV (syscall-free; reads process initial envp block) ---
//
// Returns pointer to value substring for KEY in envp ("KEY=VALUE"), or 0 if not found.
// NOTE: This returns a pointer into the process environment strings (not a copy).
fn oren_getenv(key) {
    // Keep this leaf-like (no calls) to avoid any cross-call local slot issues
    // while the native backend ABI is still rolling.
    if key == 0 { return 0 }

    var g = oren_globals()
    var envp = ptr_get(iadd(g, 64))

    // If envp wasn't captured at entry, derive it from argv/argc layout:
    // envp starts right after argv[argc] and the NULL terminator.
    var argc = ptr_get(iadd(g, 40))
    var argv = ptr_get(iadd(g, 48))
    if envp == 0 {
        if argv == 0 { return 0 }
        envp = iadd(argv, (iadd(argc, 1)) * 8)
    }
    if envp == 0 { return 0 }

    // key_len = strlen(key)
    var key_len = 0
    while ptr_get_byte(iadd(key, key_len)) != 0 {
        key_len = key_len + 1
    }

    // Hard cap to avoid hangs if envp is malformed / unterminated.
    var i = 0
    while i < 4096 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { return 0 }

        // Check prefix match "KEY="
        var j = 0
        while j < key_len {
            if ptr_get_byte(iadd(ent, j)) != ptr_get_byte(iadd(key, j)) {
                j = -1
                break
            }
            j = j + 1
        }

        if j != -1 {
            if ptr_get_byte(iadd(ent, key_len)) == 61 { // '='
                return iadd(ent, key_len + 1)
            }
        }

        i = i + 1
    }
    return 0
}

fn oren_register_thread(top) {
    // Thread Node: [top, saved_sp, next] (24 bytes)
    // We use malloc.
    // Note: oren_register_thread is called from entry stub.
    // malloc depends on globals being init.
    // entry stub calls native_runtime_init BEFORE this. So it's safe.
    var node = malloc(24)
    if node != 0 {
        ptr_set(node, top)
        ptr_set(node + 8, 0) // saved_sp
        
        // Link
        acquire_lock()
        
        ptr_set(node + 16, global_get_threads())
        global_set_threads(node)
        
        release_lock()
    }
    return node
}

fn get_sp() { return 0 } // Intrinsic

fn native_gc_scan_stack() {
    var sp = get_sp()
    var cur = global_get_threads()
    
    while cur != 0 {
        var top = ptr_get(cur)
        var saved = ptr_get(cur + 8)
        var start = 0
        
        // Check if this is current thread
        // Heuristic: sp is within 8MB below top
        // 8MB = 8388608
        if sp < top {
            var diff = top - sp
            if diff < 8388608 {
                start = sp
            }
        }
        
        if start == 0 {
            start = saved
        }
        
        if start != 0 {
            while start < top {
                var val = ptr_get(start)
                oren_mark_value(val)
                start = start + 8
            }
        }
        
        cur = ptr_get(cur + 16)
    }
    return 0
}

// Node layout: [ptr, size, kind, freed, next] (5 * 8 = 40 bytes)
// Offsets: 0=ptr, 8=size, 16=kind, 24=freed, 32=next

fn native_try_reuse(size) {
    if oren_globals() == 0 { return 0 }
    // Simple first-fit
    var prev = 0
    var cur = global_get_free()
    while cur != 0 {
        var chunk_size = ptr_get(cur + 8)
        if chunk_size >= size {
            // Found a fit.
            if prev == 0 {
                global_set_free(ptr_get(cur + 32))
            } else {
                ptr_set(prev + 32, ptr_get(cur + 32))
            }
            return ptr_get(cur)
        }
        prev = cur
        cur = ptr_get(cur + 32)
    }
    return 0
}

var g_panicking = 0

fn acquire_lock() {
    if g_panicking == 1 { return 0 }
    if oren_globals() == 0 { return 0 }
    
    var tid = sys_gettid()
    var lock_ptr = iadd(oren_globals(), 16)
    var owner = ptr_get(lock_ptr)
    
    if owner == tid {
        var count_ptr = iadd(oren_globals(), 56)
        var count = ptr_get(count_ptr)
        ptr_set(count_ptr, iadd(count, 1))
        return 0
    }
    
    var spin = 0
    while atomic_cas(lock_ptr, 0, tid) != 0 {
        if g_panicking == 1 { return 0 }
        spin = iadd(spin, 1)
        // Park after a small amount of spinning to avoid burning CPU.
        if spin > 1000 {
            // Wait while lock owner hasn't changed.
            var owner_now = ptr_get(lock_ptr)
            if owner_now != 0 {
                // operation=UL_COMPARE_AND_WAIT (1), timeout_us=0 => forever
                sys_ulock_wait(1, lock_ptr, owner_now, 0)
            }
            spin = 0
        }
    }
    
    var count_ptr = iadd(oren_globals(), 56)
    ptr_set(count_ptr, 1)
    return 0
}

fn release_lock() {
    if g_panicking == 1 { return 0 }
    if oren_globals() == 0 { return 0 }
    
    var tid = sys_gettid()
    var lock_ptr = iadd(oren_globals(), 16)
    var owner = ptr_get(lock_ptr)
    
    if owner != tid {
        return 0
    }
    
    var count_ptr = iadd(oren_globals(), 56)
    var count = ptr_get(count_ptr)
    if count > 1 {
        ptr_set(count_ptr, count - 1)
        return 0
    }
    
    ptr_set(count_ptr, 0)
    atomic_cas(lock_ptr, tid, 0)
    // Wake any waiters that parked in acquire_lock.
    // operation=UL_COMPARE_AND_WAIT|ULF_WAKE_ALL = 1|0x100 = 257
    sys_ulock_wake(257, lock_ptr, 0)
    return 0
}

fn malloc_raw(size) { return 0 }

fn oren_track_alloc(ptr, size, kind) {
    if oren_globals() == 0 { return ptr }
    acquire_lock()
    
    // Allocate tracking node.
    var node = malloc_raw(40)
    
    if node != 0 {
        ptr_set(node, ptr)
        ptr_set(node + 8, size)
        ptr_set(node + 16, kind)
        ptr_set(node + 24, 0) // freed = 0
        ptr_set(node + 32, global_get_allocs())
        global_set_allocs(node)
    }
    
    release_lock()
    return ptr
}

fn native_gc_register_root(ptr) {
    if ptr == 0 { return 0 }
    acquire_lock()
    
    var node = malloc_raw(40)
    if node != 0 {
        ptr_set(node, ptr)
        ptr_set(node + 8, 0)
        ptr_set(node + 16, 0) // kind 0 for root
        ptr_set(node + 24, 0)
        ptr_set(node + 32, global_get_roots())
        global_set_roots(node)
    }
    
    release_lock()
    return 0
}

fn native_gc_unregister_root(ptr) {
    // TODO: implement removal
    return 0
}

fn oren_find_node(ptr) {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var cur = global_get_allocs()
    while cur != 0 {
        if ptr_get(cur) == ptr { 
            release_lock()
            return cur 
        }
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return 0
}

fn oren_mark_value(val) {
    if val == 0 { return 0 }
    
    var node = oren_find_node(val)
    if node != 0 {
        var freed = ptr_get(node + 24)
        if freed == 0 {
            // Mark it
            ptr_set(node + 24, -1)
            
            var kind = ptr_get(node + 16)
            if kind == 2 { // LIST
                var count = ptr_get(val)
                var buf = ptr_get(val + 16)
                if buf != 0 {
                    var i = 0
                    while i < count {
                        var item = ptr_get(buf + i * 8)
                        oren_mark_value(item)
                        i = i + 1
                    }
                    oren_mark_value(buf)
                }
            }
            if kind == 3 { // MAP
                var count = ptr_get(val + 8)
                var base = val + 16
                var i = 0
                while i < count {
                    var k = ptr_get(base + i * 16)
                    var v = ptr_get(base + i * 16 + 8)
                    oren_mark_value(k)
                    oren_mark_value(v)
                    i = i + 1
                }
            }
        }
    }
    return 0
}

fn native_gc_collect() {
    // 1. Clear marks
    var cur = global_get_allocs()
    while cur != 0 {
        if ptr_get(cur + 24) == -1 {
            ptr_set(cur + 24, 0)
        }
        cur = ptr_get(cur + 32)
    }
    
    // 2. Mark stack
    native_gc_scan_stack()

    // 3. Mark roots
    var r = global_get_roots()
    while r != 0 {
        var slot = ptr_get(r)
        if slot != 0 {
            var val = ptr_get(slot)
            oren_mark_value(val)
        }
        r = ptr_get(r + 32)
    }
    
    // 4. Sweep
    var prev = 0
    cur = global_get_allocs()
    while cur != 0 {
        var marked = 0
        if ptr_get(cur + 24) == -1 { marked = 1 }
        
        var next_node = ptr_get(cur + 32)
        
        if marked == 1 {
            ptr_set(cur + 24, 0)
            prev = cur
        } else {
            // Garbage
            if prev == 0 {
                global_set_allocs(next_node)
            } else {
                ptr_set(prev + 32, next_node)
            }
            
            ptr_set(cur + 32, global_get_free())
            global_set_free(cur)
        }
        cur = next_node
    }
    return 0
}

fn native_gc_shutdown() {
    return 0
}

var g_debug_info = 0
var g_debug_static_addr = 0
var g_slide = 0

fn oren_set_debug_info(ptr, static_addr) {
    g_debug_info = ptr
    g_debug_static_addr = static_addr
    g_slide = ptr - static_addr
    return 0
}

fn ptr_get_u64(ptr) { return ptr_get(ptr) }

fn read_string_at(ptr, len) {
    var s = malloc(len + 1)
    var i = 0
    while i < len {
        ptr_set_byte(s + i, ptr_get_byte(ptr + i))
        i = i + 1
    }
    ptr_set_byte(s + len, 0)
    oren_track_alloc(s, len + 1, 1)
    return s
}

fn find_func_info(pc) {
    if g_debug_info == 0 { return 0 }
    
    // Un-slide PC to match static table
    var static_pc = pc - g_slide
    
    var ptr = g_debug_info
    var count = ptr_get_u64(ptr)
    ptr = ptr + 8
    
    var i = 0
    while i < count {
        var start = ptr_get_u64(ptr)
        ptr = ptr + 8
        var end = ptr_get_u64(ptr)
        ptr = ptr + 8
        
        if static_pc >= start {
            if static_pc < end {
                return ptr
            }
        }
        
        var name_len = ptr_get_u64(ptr)
        ptr = ptr + 8 + name_len
        var p_count = ptr_get_u64(ptr)
        ptr = ptr + 8
        var j = 0
        while j < p_count {
            var pname_len = ptr_get_u64(ptr)
            ptr = ptr + 8 + pname_len + 8 // +8 for offset
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

fn stack_trace_debug() {
    print("Traceback (most recent call last):")
    var fp = get_fp()
    var i = 0
    while fp != 0 {
        if i > 50 { 
            print("  ... (truncated)")
            return 0 
        }
        var pc = ptr_get(fp + 8)
        var info_ptr = find_func_info(pc)
        
        if info_ptr != 0 {
            var name_len = ptr_get_u64(info_ptr)
            var name = read_string_at(info_ptr + 8, name_len)
            
            // Format: File "...", line 10, in <module>
            // We don't have file/line info yet, only func name.
            // Python style:
            //   File "<unknown>", line 0, in func_name
            //     args...
            
            print(string_concat("  File \"?\", line ?, in ", name))
            
            var ptr = info_ptr + 8 + name_len
            var p_count = ptr_get_u64(ptr)
            ptr = ptr + 8
            var j = 0
            while j < p_count {
                var pname_len = ptr_get_u64(ptr)
                var pname = read_string_at(ptr + 8, pname_len)
                ptr = ptr + 8 + pname_len
                var offset = ptr_get_u64(ptr)
                ptr = ptr + 8
                
                var val_ptr = fp - offset
                var val = ptr_get(val_ptr)
                var s1 = string_concat("    ", pname)
                var s2 = string_concat(s1, " = ")
                print(string_concat(s2, oren_int_to_string(val)))
                j = j + 1
            }
        } else {
            var s = string_concat("  File \"?\", line ?, in ??? (pc=", oren_int_to_string(pc))
            print(string_concat(s, ")"))
        }
        
        fp = ptr_get(fp)
        i = i + 1
    }
    return 0
}

fn oren_ensure_tracked(ptr, kind) {
    if ptr == 0 { return 0 }
    if oren_find_node(ptr) == 0 {
        var size = 0
        if kind == 1 {
            size = oren_string_len(ptr) + 1
        }
        oren_track_alloc(ptr, size, kind)
    }
    return ptr
}

fn oren_raw_print_str(s) {
    if s == 0 { return 0 }
    var len = oren_string_len(s)
    sys_write(1, s, len)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn oren_panic(msg) {
    g_panicking = 1
    print("Runtime Panic: ")
    oren_raw_print_str(msg)
    if g_debug_info != 0 {
        stack_trace_debug()
    } else {
        stack_trace()
    }
    exit(1)
    return 0
}

