    // Find node, mark as available, move to free chunks?
    // For now, no-op or rely on GC.
    return 0
}

fn strcmp(s1, s2) {
    var i = 0
    while 1 {
        var b1 = ptr_get_byte(s1 + i)
        var b2 = ptr_get_byte(s2 + i)
        if b1 == 0 {
            if b2 == 0 { return 0 }
            return -1
        }
        if b2 == 0 { return 1 }
        if b1 < b2 { return -1 }
        if b1 > b2 { return 1 }
        i = i + 1
    }
    return 0
}

fn oren_int_to_string(n) {
    var buf = malloc(32)
    if buf == 0 { exit(300) }
    var i = 0
    var neg = 0
    if n < 0 {
        neg = 1
        n = -n
    }
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        while n > 0 {
            var digit = n - (n / 10) * 10
            ptr_set_byte(buf + i, 48 + digit)
            i = i + 1
            n = n / 10
        }
        if neg == 1 {
            ptr_set_byte(buf + i, 45)
            i = i + 1
        }
        // reverse
        var s = 0
        var e = i - 1
        while s < e {
            var t = ptr_get_byte(buf + s)
            ptr_set_byte(buf + s, ptr_get_byte(buf + e))
            ptr_set_byte(buf + e, t)
            s = s + 1
            e = e - 1
        }
    }
    ptr_set_byte(buf + i, 0) // null term
    oren_track_alloc(buf, 32, 1) // 1=STRING
    return buf
}

// --- Printing ---
fn print_int(n) {
    // crude itoa
    var buf = malloc(32)
    if buf == 0 { exit(300) }
    var i = 0
    var neg = 0
    if n < 0 {
        neg = 1
        n = -n
    }
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        while n > 0 {
            var digit = n - (n / 10) * 10
            ptr_set_byte(buf + i, 48 + digit)
            i = i + 1
            n = n / 10
        }
        if neg == 1 {
            ptr_set_byte(buf + i, 45)
            i = i + 1
        }
        // reverse
        var s = 0
        var e = i - 1
        while s < e {
            var t = ptr_get_byte(buf + s)
            ptr_set_byte(buf + s, ptr_get_byte(buf + e))
            ptr_set_byte(buf + e, t)
            s = s + 1
            e = e - 1
        }
    }
    ptr_set_byte(buf + i, 10) // newline
    var len = i + 1
    sys_write(1, buf, len)
    return 0
}

fn print_bytes(ptr, len) {
    sys_write(1, ptr, len)
}

fn oren_print(v) {
    // Only support ints for now (native backend lacks type tags)
    print_int(v)
    return 0
}

fn list_magic() { return 1279870019 } // 'LIST'

fn oren_new_map(cap) {
    var size = 16 + cap * 16
    var m = malloc(size)
    if m == 0 {
        print("MALLOC ZERO")
        exit(1)
    }
    if m == -1 {
        print("MALLOC FAILED")
        exit(1)
    }
    ptr_set(m, cap)
    ptr_set(m + 8, 0)
    oren_track_alloc(m, size, 0)
    return m
}

fn oren_map_set(m, k, v) {
    // stack_trace()
    if m == 0 { exit(110) }
    if m < 4096 { exit(111) }
    if k == 0 { exit(112) }
    // if m > 4096 { exit(12) } 
    
    var cap = ptr_get(m)
    var count = ptr_get(m + 8)
    if cap <= 0 {
        cap = 1024
        ptr_set(m, cap)
    }
    if count < 0 {
        count = 0
        ptr_set(m + 8, 0)
    }
    if count > cap {
        count = cap
        ptr_set(m + 8, cap)
    }
    var i = 0
    var base = m + 16
    if base < 4096 { exit(115) }
    while i < count {
        var kp = ptr_get(base + i * 16)
        if strcmp(kp, k) == 0 {
            ptr_set(base + i * 16 + 8, v)
            return m
        }
        i = i + 1
    }
    if count >= cap {
        exit(99)
    }
    ptr_set(base + (count << 4), k)
    ptr_set(base + (count << 4) + 8, v)
    ptr_set(m + 8, count + 1)
    return m
}

fn oren_map_get(m, k) {
    var count = ptr_get(m + 8)
    var i = 0
    var base = m + 16
    while i < count {
        var kp = ptr_get(base + i * 16)
        if strcmp(kp, k) == 0 {
            return ptr_get(base + i * 16 + 8)
        }
        i = i + 1
    }
    return 0
}

// Centralized struct allocation hook (uses the compiler's special-cased malloc).
fn oren_alloc_struct(size) {
    return malloc(size)
}

fn oren_free_struct(ptr) {
    // No-op placeholder; free/GC will be wired later.
    return 0
