// Minimal index_set for lists; maps still use oren_map_set directly.
fn oren_index_set(container, index, value) {
    if container == 0 { exit(230) }
    // Detect list by magic tag.
    if ptr_get(container + 24) == list_magic() {
        var buf = ptr_get(container + 16)
        var count = ptr_get(container)
        var cap = ptr_get(container + 8)
        if index < 0 { exit(231) }
        if index >= cap {
            var new_cap = cap
            if new_cap == 0 { new_cap = index + 1 }
            while new_cap <= index { new_cap = new_cap * 2 }
            var new_buf = malloc(new_cap * 8)
            oren_track_alloc(new_buf, new_cap * 8, 0)
            var i = 0
            while i < count {
                ptr_set(new_buf + i * 8, ptr_get(buf + i * 8))
                i = i + 1
            }
            buf = new_buf
            cap = new_cap
            ptr_set(container + 8, cap)
            ptr_set(container + 16, buf)
        }
        if index >= count {
            // zero-fill new slots
            var i2 = count
            while i2 <= index {
                ptr_set(buf + i2 * 8, 0)
                i2 = i2 + 1
            }
            ptr_set(container, index + 1)
        }
        ptr_set(buf + index * 8, value)
        return value
    }
    // Fallback: behave like map set
    return oren_map_set(container, index, value)
}

// --- Typed numeric buffers (native backend, libc-free) ---
//
// Design:
// - Typed buffers are heap objects with a small header + a raw byte payload.
// - Payload bytes are canonical little-endian element encodings to match AVM semantics.
// - These APIs mirror the AVM typed buffer surface so higher-level code can be backend-agnostic.
//
// Header layout (56 bytes):
//   [0]  len (element count)
//   [8]  elem_size (1/4/8)
//   [16] data_base (GC keep-alive anchor for the payload allocation)
//   [24] magic ('BUF\\0')
//   [32] type_tag (1=i32, 2=i64, 3=f32, 4=f64, 5=u8)
//   [40] data_ptr (payload pointer used for load/store; may be aligned)

fn buf_magic() { return 4609346 } // 'BUF\0'
// BUF_TAG_* are defined near global constants (used by iterator and native codegen).

// RAW mmap header for large typed-buffer payloads:
// [magic:u64, total_len:u64, backend:u64, ...padding... ] (64 bytes)
fn raw_magic() { return 5715707079776360240 } // 0x4f52454e52415730 ("ORENRAW0") as u64 (rolling)
fn raw_hdr_size() { return 64 }
fn raw_mmap_threshold() {
    var v = global_get_raw_mmap_threshold()
    if v < 0 { return 1048576 }
    return v
}

// Default alignment for typed-buffer payload pointers (cache-line, NEON-friendly).
// This is a performance property only; it must not change semantics.
fn buf_align_default() {
    var v = global_get_buf_align()
    if v != 8 && v != 16 && v != 32 && v != 64 { return 64 }
    return v
}

fn native_align_up(p, align) {
    if align <= 1 { return p }
    var u = p + align - 1
    // Mod-based alignment to avoid relying on bitwise ops during early bootstrap.
    return u - (u % align)
}

fn native_buf_data_ptr(buf) {
    var p = ptr_get(buf + 40)
    if p != 0 { return p }
    return ptr_get(buf + 16)
}

fn native_buf_as_node(buf) {
    if buf == 0 { return 0 }
    if buf < 4096 { return 0 }
    var node = oren_find_node(buf)
    if node == 0 { return 0 }
    if ptr_get(iadd(node, 16)) != 7 { return 0 } // kind=7 => BUF
    if ptr_get(buf + 24) != buf_magic() { return 0 }
    return node
}

fn native_buf_check(buf, tag, elem_size) {
    if buf == 0 { return oren_err(4, "buf: nil") }
    if native_buf_as_node(buf) == 0 { return oren_err(4, "buf: invalid buffer") }
    if ptr_get(buf + 32) != tag { return oren_err(4, "buf: wrong buffer type") }
    if ptr_get(buf + 8) != elem_size { return oren_err(4, "buf: wrong element size") }
    var data = ptr_get(buf + 16)
    if data == 0 && ptr_get(buf + 0) != 0 { return oren_err(4, "buf: payload is nil") }
    return 0
}

fn native_buf_payload_is_mmap(buf) {
    if native_buf_as_node(buf) == 0 { return 0 }
    var len = ptr_get(buf + 0)
    if len == 0 { return 0 }
    var p = ptr_get(buf + 16)
    if p == 0 { return 0 }
    var base = p - raw_hdr_size()
    if ptr_get(base + 0) != raw_magic() { return 0 }
    if ptr_get(base + 16) != 1 { return 0 }
    return 1
}

fn native_buf_new(len, elem_size, tag) {
    if len < 0 { return oren_err(4, "buf_new: negative length") }
    if len > 2147483647 { return oren_err(4, "buf_new: length too large") }
    if elem_size != 1 && elem_size != 4 && elem_size != 8 { return oren_err(4, "buf_new: invalid elem_size") }

    var header = malloc(56)
    if header == 0 || header == -1 { return oren_err(8, "buf_new: alloc failed") }
    oren_track_alloc(header, 56, 0)
    // Mark header kind=7 (BUF) so GC can keep payload alive.
    var node = oren_find_node(header)
    if node != 0 { ptr_set(iadd(node, 16), 7) }

    var bytes_len = len * elem_size
    var data = 0
    var data_ptr = 0
    if bytes_len > 0 {
        var lim2 = global_get_buf_payload_limit()
        if lim2 != 0 && bytes_len > lim2 { return oren_err(9, "buf_new: payload limit exceeded") }
        var thr = raw_mmap_threshold()
        var force_mmap = global_get_buf_force_mmap()
        if force_mmap != 0 || (thr != 0 && bytes_len >= thr) {
            // Large payload: mmap-backed so GC/free can return memory to OS.
            var total = raw_hdr_size() + bytes_len
            var base = sys_mmap_private_anon(total)
            if base < 0 { return oren_err(8, "buf_new: mmap failed") }

            // Write header.
            ptr_set(base + 0, raw_magic())
            ptr_set(base + 8, total)
            ptr_set(base + 16, 1) // backend=1 (mmap)

            data = base + raw_hdr_size()
            data_ptr = data // already aligned due to 64-byte header
            // Mark payload kind=9 (RAW_MMAP).
            oren_track_alloc(data, bytes_len, 9)

            // Zero-fill (mmap does not guarantee zero? In practice anonymous is zeroed, but keep explicit).
            var i = 0
            while i < bytes_len {
                ptr_set_byte(data + i, 0)
                i = i + 1
            }
        } else {
            // Small payload: heap allocate and align within the block.
            // Over-allocate so we can align the working payload pointer while keeping the GC anchor stable.
            var cap = bytes_len + (buf_align_default() - 1)
            data = malloc(cap)
            if data == 0 || data == -1 { return oren_err(8, "buf_new: payload alloc failed") }
            // Mark payload kind=8 (RAW) so GC never treats it as pointer-containing memory.
            // This is an explicit contract for typed buffers (HPC).
            oren_track_alloc(data, cap, 8)
            data_ptr = native_align_up(data, buf_align_default())
            // Zero-fill (malloc does not promise zeroed memory).
            var i2 = 0
            while i2 < bytes_len {
                ptr_set_byte(data_ptr + i2, 0)
                i2 = i2 + 1
            }
        }
    }

    ptr_set(header + 0, len)
    ptr_set(header + 8, elem_size)
    ptr_set(header + 16, data)
    ptr_set(header + 24, buf_magic())
    ptr_set(header + 32, tag)
    ptr_set(header + 40, data_ptr)
    return header
}

fn native_buf_wrap_ptr(data, len, elem_size, tag) {
    // Wrap an existing tracked allocation as a typed buffer payload.
    //
    // This enables true zero-copy pipelines:
    //   sys_read(fd, malloc(N), N) -> wrap -> pack_view / bytes helpers
    //
    // SAFETY / CONTRACT:
    // - `data` must be a tracked allocation (so GC can validate it and keep it alive).
    // - The underlying allocation size must be >= len*elem_size.
    // - This buffer does not "own" the payload at a language level; GC reachability keeps
    //   the payload alive. Manual `free(data)` while the wrapper is reachable is undefined
    //   behavior in v0 (similar to freeing list/map internal buffers).
    if len < 0 { return oren_err(4, "buf_wrap_ptr: negative length") }
    if elem_size != 1 && elem_size != 4 && elem_size != 8 { return oren_err(4, "buf_wrap_ptr: invalid elem_size") }
    if len > 2147483647 { return oren_err(4, "buf_wrap_ptr: length too large") }
    if len != 0 && (data == 0 || data == -1) { return oren_err(4, "buf_wrap_ptr: nil payload") }

    var bytes_len = len * elem_size
    if bytes_len < 0 { return oren_err(4, "buf_wrap_ptr: size overflow") }
    if bytes_len != 0 {
        var node = oren_find_node(data)
        if node == 0 { return oren_err(4, "buf_wrap_ptr: payload must be tracked") }
        var cap = ptr_get(iadd(node, 8))
        if cap < bytes_len { return oren_err(4, "buf_wrap_ptr: payload too small") }
    }

    var header = malloc(56)
    if header == 0 || header == -1 { return oren_err(8, "buf_wrap_ptr: alloc failed") }
    oren_track_alloc(header, 56, 0)
    // Mark header kind=7 (BUF) so GC can keep payload alive.
    var node2 = oren_find_node(header)
    if node2 != 0 { ptr_set(iadd(node2, 16), 7) }

    ptr_set(header + 0, len)
    ptr_set(header + 8, elem_size)
    ptr_set(header + 16, data)
    ptr_set(header + 24, buf_magic())
    ptr_set(header + 32, tag)
    ptr_set(header + 40, data)
    return header
}

fn oren_i32_buf_new(len) { return native_buf_new(len, 4, BUF_TAG_I32) }
fn oren_i64_buf_new(len) { return native_buf_new(len, 8, BUF_TAG_I64) }
fn oren_f32_buf_new(len) { return native_buf_new(len, 4, BUF_TAG_F32) }
fn oren_f64_buf_new(len) { return native_buf_new(len, 8, BUF_TAG_F64) }
fn oren_u8_buf_new(len) { return native_buf_new(len, 1, BUF_TAG_U8) }
fn oren_u8_buf_wrap_ptr(ptr, len) { return native_buf_wrap_ptr(ptr, len, 1, BUF_TAG_U8) }

fn oren_buf_len(buf) {
    if native_buf_as_node(buf) == 0 { return oren_err(4, "buf_len expects (buf)") }
    return ptr_get(buf + 0)
}

fn oren_buf_load_i32(buf, idx) {
    var err = native_buf_check(buf, BUF_TAG_I32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_load_i32: index out of bounds") }
    var data = native_buf_data_ptr(buf)
    var off = idx * 4
    var b0 = ptr_get_byte(data + off + 0)
    var b1 = ptr_get_byte(data + off + 1)
    var b2 = ptr_get_byte(data + off + 2)
    var b3 = ptr_get_byte(data + off + 3)
    var u = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_buf_load_u8(buf, idx) {
    var err = native_buf_check(buf, BUF_TAG_U8, 1)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_load_u8: index out of bounds") }
    var data = native_buf_data_ptr(buf)
    return ptr_get_byte(data + idx) & 255
}

fn oren_buf_store_i32(buf, idx, v) {
    var err = native_buf_check(buf, BUF_TAG_I32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_store_i32: index out of bounds") }
    var data = native_buf_data_ptr(buf)
    var off = idx * 4
    var u = v & 4294967295
    ptr_set_byte(data + off + 0, u & 255)
    ptr_set_byte(data + off + 1, (u >> 8) & 255)
    ptr_set_byte(data + off + 2, (u >> 16) & 255)
    ptr_set_byte(data + off + 3, (u >> 24) & 255)
    return buf
}

fn oren_buf_store_u8(buf, idx, v) {
    var err = native_buf_check(buf, BUF_TAG_U8, 1)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_store_u8: index out of bounds") }
    if v < 0 || v > 255 { return oren_err(4, "buf_store_u8: byte out of range") }
    var data = native_buf_data_ptr(buf)
    ptr_set_byte(data + idx, v)
    return buf
}

fn oren_buf_load_i64(buf, idx) {
    var err = native_buf_check(buf, BUF_TAG_I64, 8)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_load_i64: index out of bounds") }
    var data = native_buf_data_ptr(buf)
    var off = idx * 8
    var u = 0
    var i = 0
    while i < 8 {
        var b = ptr_get_byte(data + off + i)
        u = u | (b << (i * 8))
        i = i + 1
    }
    return u
}

fn oren_buf_store_i64(buf, idx, v) {
    var err = native_buf_check(buf, BUF_TAG_I64, 8)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_store_i64: index out of bounds") }
    var data = native_buf_data_ptr(buf)
    var off = idx * 8
    var i = 0
    while i < 8 {
        ptr_set_byte(data + off + i, (v >> (i * 8)) & 255)
        i = i + 1
    }
    return buf
}

fn oren_buf_load_f64(buf, idx): f64 {
    // Returns f64 as raw bits (native backend float container).
    var err = native_buf_check(buf, BUF_TAG_F64, 8)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_load_f64: index out of bounds") }
    var data = native_buf_data_ptr(buf)
    var off = idx * 8
    var bits = 0
    var i = 0
    while i < 8 {
        var b = ptr_get_byte(data + off + i)
        bits = bits | (b << (i * 8))
        i = i + 1
    }
    return bits
}

fn oren_buf_store_f64(buf, idx, v: f64) {
    // `v` is f64 bits (native backend float container).
    var err = native_buf_check(buf, BUF_TAG_F64, 8)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_store_f64: index out of bounds") }
    var data = native_buf_data_ptr(buf)
    var off = idx * 8
    var i = 0
    while i < 8 {
        ptr_set_byte(data + off + i, (v >> (i * 8)) & 255)
        i = i + 1
    }
    return buf
}

fn oren_buf_load_f32(buf, idx): f64 {
    // Load f32 bits from payload and widen to f64 bits (native float container).
    var err = native_buf_check(buf, BUF_TAG_F32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_load_f32: index out of bounds") }
    var data = native_buf_data_ptr(buf)
    var off = idx * 4
    var b0 = ptr_get_byte(data + off + 0)
    var b1 = ptr_get_byte(data + off + 1)
    var b2 = ptr_get_byte(data + off + 2)
    var b3 = ptr_get_byte(data + off + 3)
    var bits = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
    return oren_u32_bits_to_f32(bits)
}

fn oren_buf_store_f32(buf, idx, v: f64) {
    // Store f32 bits (rounded) into payload.
    var err = native_buf_check(buf, BUF_TAG_F32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    if idx < 0 || idx >= n { return oren_err(4, "buf_store_f32: index out of bounds") }
    var data = native_buf_data_ptr(buf)
    var off = idx * 4
    var bits = oren_f32_to_u32_bits(v)
    ptr_set_byte(data + off + 0, bits & 255)
    ptr_set_byte(data + off + 1, (bits >> 8) & 255)
    ptr_set_byte(data + off + 2, (bits >> 16) & 255)
    ptr_set_byte(data + off + 3, (bits >> 24) & 255)
    return buf
}

fn oren_buf_fill_u8(buf, v) {
    var err = native_buf_check(buf, BUF_TAG_U8, 1)
    if oren_is_err(err) { return err }
    if v < 0 || v > 255 { return oren_err(4, "buf_fill_u8: byte out of range") }
    var n = ptr_get(buf + 0)
    var data = native_buf_data_ptr(buf)
    var i = 0
    while i < n {
        ptr_set_byte(data + i, v)
        i = i + 1
    }
    return buf
}

fn sys_read_u8_buf(fd, buf, off, nbytes) {
    var err = native_buf_check(buf, BUF_TAG_U8, 1)
    if oren_is_err(err) { return err }
    if off < 0 || nbytes < 0 { return oren_err(4, "sys_read_u8_buf: negative offset/len") }
    var n = ptr_get(buf + 0)
    if off > n { return oren_err(4, "sys_read_u8_buf: offset out of bounds") }
    if off + nbytes > n { return oren_err(4, "sys_read_u8_buf: length out of bounds") }
    var data = native_buf_data_ptr(buf)
    return sys_read(fd, data + off, nbytes)
}

fn sys_write_u8_buf(fd, buf, off, nbytes) {
    var err = native_buf_check(buf, BUF_TAG_U8, 1)
    if oren_is_err(err) { return err }
    if off < 0 || nbytes < 0 { return oren_err(4, "sys_write_u8_buf: negative offset/len") }
    var n = ptr_get(buf + 0)
    if off > n { return oren_err(4, "sys_write_u8_buf: offset out of bounds") }
    if off + nbytes > n { return oren_err(4, "sys_write_u8_buf: length out of bounds") }
    var data = native_buf_data_ptr(buf)
    return sys_write(fd, data + off, nbytes)
}

// Bulk helpers (scalar baseline; SIMD can replace later).
fn oren_buf_fill_i32(buf, v) {
    var err = native_buf_check(buf, BUF_TAG_I32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var i = 0
    while i < n {
        oren_buf_store_i32(buf, i, v)
        i = i + 1
    }
    return buf
}

fn oren_buf_fill_i64(buf, v) {
    var err = native_buf_check(buf, BUF_TAG_I64, 8)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var i = 0
    while i < n {
        oren_buf_store_i64(buf, i, v)
        i = i + 1
    }
    return buf
}

fn oren_buf_fill_f32(buf, v: f64) {
    var err = native_buf_check(buf, BUF_TAG_F32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var i = 0
    while i < n {
        oren_buf_store_f32(buf, i, v)
        i = i + 1
    }
    return buf
}

fn oren_buf_fill_f64(buf, v: f64) {
    var err = native_buf_check(buf, BUF_TAG_F64, 8)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var i = 0
    while i < n {
        oren_buf_store_f64(buf, i, v)
        i = i + 1
    }
    return buf
}

fn oren_buf_add_i32(a, b) {
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_add_i32: length mismatch") }
    var out = oren_i32_buf_new(n)
    if oren_is_err(out) { return out }
    var i = 0
    while i < n {
        var x = oren_buf_load_i32(a, i)
        var y = oren_buf_load_i32(b, i)
        oren_buf_store_i32(out, i, x + y)
        i = i + 1
    }
    return out
}

fn oren_buf_add_f32(a, b) {
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_add_f32: length mismatch") }
    var out = oren_f32_buf_new(n)
    if oren_is_err(out) { return out }
    var i = 0
    while i < n {
        var x = oren_buf_load_f32(a, i)
        var y = oren_buf_load_f32(b, i)
        oren_buf_store_f32(out, i, x + y)
        i = i + 1
    }
    return out
}

fn oren_buf_add_i64(a, b) {
    var ea = native_buf_check(a, BUF_TAG_I64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_add_i64: length mismatch") }
    var out = oren_i64_buf_new(n)
    if oren_is_err(out) { return out }
    var r = oren_buf_add_i64_into(out, a, b)
    if oren_is_err(r) { return r }
    return out
}

fn oren_buf_add_f64(a, b) {
    var ea = native_buf_check(a, BUF_TAG_F64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_add_f64: length mismatch") }
    var out = oren_f64_buf_new(n)
    if oren_is_err(out) { return out }
    var r = oren_buf_add_f64_into(out, a, b)
    if oren_is_err(r) { return r }
    return out
}

fn oren_buf_mul_i64(a, b) {
    var ea = native_buf_check(a, BUF_TAG_I64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_mul_i64: length mismatch") }
    var out = oren_i64_buf_new(n)
    if oren_is_err(out) { return out }
    var r = oren_buf_mul_i64_into(out, a, b)
    if oren_is_err(r) { return r }
    return out
}

fn oren_buf_mul_f64(a, b) {
    var ea = native_buf_check(a, BUF_TAG_F64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_mul_f64: length mismatch") }
    var out = oren_f64_buf_new(n)
    if oren_is_err(out) { return out }
    var r = oren_buf_mul_f64_into(out, a, b)
    if oren_is_err(r) { return r }
    return out
}

fn oren_buf_add_i32_into(dst, a, b) {
    var ed = native_buf_check(dst, BUF_TAG_I32, 4)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) || n != ptr_get(dst + 0) { return oren_err(4, "buf_add_i32_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 4 {
        var pd = native_buf_data_ptr(dst)
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        simd_add_i32_ptr(pd, pa, pb, n)
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_i32(dst, i, oren_buf_load_i32(a, i) + oren_buf_load_i32(b, i))
        i = i + 1
    }
    return dst
}

fn oren_buf_add_f32_into(dst, a, b) {
    var ed = native_buf_check(dst, BUF_TAG_F32, 4)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) || n != ptr_get(dst + 0) { return oren_err(4, "buf_add_f32_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 4 {
        var pd = native_buf_data_ptr(dst)
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        simd_add_f32_ptr(pd, pa, pb, n)
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_f32(dst, i, oren_buf_load_f32(a, i) + oren_buf_load_f32(b, i))
        i = i + 1
    }
    return dst
}

