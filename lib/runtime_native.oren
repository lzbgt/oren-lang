var GLOBAL_OFF_BUF_FORCE_MMAP = 288
var GLOBAL_OFF_BUF_PAYLOAD_LIMIT = 296

// Reserve extra room for rolling ABI growth.
var GLOBAL_SLOTS_RESERVED = 56

