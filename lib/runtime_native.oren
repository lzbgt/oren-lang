        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        var n2 = n - (n % 2)
        if n2 >= 2 {
            simd_mul_f64_ptr(pd, pa, pb, n2)
        }
        if n2 != n {
            oren_buf_store_f64(dst, n2, oren_buf_load_f64(a, n2) * oren_buf_load_f64(b, n2))
        }
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_f64(dst, i, oren_buf_load_f64(a, i) * oren_buf_load_f64(b, i))
        i = i + 1
    }
    return dst
}

fn oren_buf_dot_i32(a, b) {
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_dot_i32: length mismatch") }

    // SIMD fast path (native backend only): NEON dot over raw pointers.
    // Gated by startup-parsed env (OREN_ENABLE_SIMD / OREN_NO_SIMD).
    if native_simd_enabled() != 0 && n >= 4 {
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        return simd_dot_i32_ptr(pa, pb, n)
    }

    var sum = 0
    var i = 0
    while i < n {
        sum = sum + (oren_buf_load_i32(a, i) * oren_buf_load_i32(b, i))
        i = i + 1
    }
    return sum
}

fn oren_buf_dot_f64(a, b): f64 {
    var ea = native_buf_check(a, BUF_TAG_F64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_dot_f64: length mismatch") }

    if native_simd_enabled() != 0 && n >= 2 {
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        // Native SIMD returns f64 bits in an integer register (X0) for a pure ABI boundary.
        // Convert back to f64 at the Oren level so call sites see a real float.
        return oren_u64_bits_to_f64(simd_dot_f64_ptr(pa, pb, n))
    }

    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + (oren_buf_load_f64(a, i) * oren_buf_load_f64(b, i))
        i = i + 1
    }
    return sum
}

fn oren_buf_dot_f64_slice(a, a_off, b, b_off, n): f64 {
    var ea = native_buf_check(a, BUF_TAG_F64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F64, 8)
    if oren_is_err(eb) { return eb }
    if a_off < 0 || b_off < 0 || n < 0 { return oren_err(4, "buf_dot_f64_slice: negative arg") }
    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a_off > na || b_off > nb { return oren_err(4, "buf_dot_f64_slice: offset out of bounds") }
    if a_off + n > na || b_off + n > nb { return oren_err(4, "buf_dot_f64_slice: range out of bounds") }

    if native_simd_enabled() != 0 && n >= 2 {
        var pa = native_buf_data_ptr(a) + a_off * 8
        var pb = native_buf_data_ptr(b) + b_off * 8
        return oren_u64_bits_to_f64(simd_dot_f64_ptr(pa, pb, n))
    }

    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + (oren_buf_load_f64(a, a_off + i) * oren_buf_load_f64(b, b_off + i))
        i = i + 1
    }
    return sum
}

fn oren_buf_dot_f64_strided(a, a_off, a_stride, b, b_off, b_stride, n): f64 {
    var ea = native_buf_check(a, BUF_TAG_F64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F64, 8)
    if oren_is_err(eb) { return eb }
    if a_off < 0 || b_off < 0 || n < 0 { return oren_err(4, "buf_dot_f64_strided: negative arg") }
    if a_stride <= 0 || b_stride <= 0 { return oren_err(4, "buf_dot_f64_strided: stride must be > 0") }
    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a_off > na || b_off > nb { return oren_err(4, "buf_dot_f64_strided: offset out of bounds") }
    if n > 0 {
        var alast = a_off + (n - 1) * a_stride
        var blast = b_off + (n - 1) * b_stride
        if alast < 0 || alast >= na { return oren_err(4, "buf_dot_f64_strided: a range out of bounds") }
        if blast < 0 || blast >= nb { return oren_err(4, "buf_dot_f64_strided: b range out of bounds") }
    }

    // NOTE: no SIMD fast path for strided access today (requires gather).
    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + (oren_buf_load_f64(a, a_off + i * a_stride) * oren_buf_load_f64(b, b_off + i * b_stride))
        i = i + 1
    }
    return sum
}

fn oren_buf_dot_i32_slice(a, a_off, b, b_off, n) {
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I32, 4)
    if oren_is_err(eb) { return eb }
    if a_off < 0 || b_off < 0 || n < 0 { return oren_err(4, "buf_dot_i32_slice: negative arg") }
    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a_off > na || b_off > nb { return oren_err(4, "buf_dot_i32_slice: offset out of bounds") }
    if a_off + n > na || b_off + n > nb { return oren_err(4, "buf_dot_i32_slice: range out of bounds") }

    if native_simd_enabled() != 0 && n >= 4 {
        var pa = native_buf_data_ptr(a) + a_off * 4
        var pb = native_buf_data_ptr(b) + b_off * 4
        return simd_dot_i32_ptr(pa, pb, n)
    }

    var sum = 0
    var i = 0
    while i < n {
        sum = sum + (oren_buf_load_i32(a, a_off + i) * oren_buf_load_i32(b, b_off + i))
        i = i + 1
    }
    return sum
}

fn oren_buf_dot_i32_4_slice_into(out, out_off, a, a_off, b, b0_off, b1_off, b2_off, b3_off, n) {
    // Compute 4 dot-products sharing the same `a` slice and store into an i64 buffer.
    //
    // Semantics: i64 wrap accumulation (via Oren's integer wrap rules).
    var eo = native_buf_check(out, BUF_TAG_I64, 8)
    if oren_is_err(eo) { return eo }
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I32, 4)
    if oren_is_err(eb) { return eb }
    if out_off < 0 || a_off < 0 || b0_off < 0 || b1_off < 0 || b2_off < 0 || b3_off < 0 || n < 0 { return oren_err(4, "buf_dot_i32_4_slice_into: negative arg") }

    var no = ptr_get(out + 0)
    if out_off > no || no - out_off < 4 { return oren_err(4, "buf_dot_i32_4_slice_into: out range out of bounds") }

    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a_off > na { return oren_err(4, "buf_dot_i32_4_slice_into: a_off out of bounds") }
    if n > na - a_off { return oren_err(4, "buf_dot_i32_4_slice_into: a range out of bounds") }
    if b0_off > nb || b1_off > nb || b2_off > nb || b3_off > nb { return oren_err(4, "buf_dot_i32_4_slice_into: b_off out of bounds") }
    if n > nb - b0_off || n > nb - b1_off || n > nb - b2_off || n > nb - b3_off { return oren_err(4, "buf_dot_i32_4_slice_into: b range out of bounds") }

    // Native SIMD fast path: 1×4 i32 dot microkernel intrinsic (single-pass over A).
    if native_simd_enabled() != 0 && n >= 4 {
        var outp = native_buf_data_ptr(out) + out_off * 8
        var pa = native_buf_data_ptr(a) + a_off * 4
        var pb0 = native_buf_data_ptr(b) + b0_off * 4
        var pb1 = native_buf_data_ptr(b) + b1_off * 4
        var pb2 = native_buf_data_ptr(b) + b2_off * 4
        var pb3 = native_buf_data_ptr(b) + b3_off * 4
        simd_dot_i32_4_ptr(outp, pa, pb0, pb1, pb2, pb3, n)
        return out
    }

    // Scalar fallback.
    var s0 = 0
    var s1 = 0
    var s2 = 0
    var s3 = 0
    var i = 0
    while i < n {
        var av = oren_buf_load_i32(a, a_off + i)
        s0 = s0 + av * oren_buf_load_i32(b, b0_off + i)
        s1 = s1 + av * oren_buf_load_i32(b, b1_off + i)
        s2 = s2 + av * oren_buf_load_i32(b, b2_off + i)
        s3 = s3 + av * oren_buf_load_i32(b, b3_off + i)
        i = i + 1
    }
    oren_buf_store_i64(out, out_off + 0, s0)
    oren_buf_store_i64(out, out_off + 1, s1)
    oren_buf_store_i64(out, out_off + 2, s2)
    oren_buf_store_i64(out, out_off + 3, s3)
    return out
}

fn oren_buf_dot_f32_4_slice_into(out, out_off, a, a_off, b, b0_off, b1_off, b2_off, b3_off, n) {
    // Compute 4 dot-products sharing the same `a` slice and store into an f64 buffer.
    //
    // Semantics:
    // - widen each f32 element to f64
    // - multiply in f64
    // - accumulate in fixed increasing-k order
    var eo = native_buf_check(out, BUF_TAG_F64, 8)
    if oren_is_err(eo) { return eo }
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F32, 4)
    if oren_is_err(eb) { return eb }
    if out_off < 0 || a_off < 0 || b0_off < 0 || b1_off < 0 || b2_off < 0 || b3_off < 0 || n < 0 { return oren_err(4, "buf_dot_f32_4_slice_into: negative arg") }

    var no = ptr_get(out + 0)
    if out_off > no || no - out_off < 4 { return oren_err(4, "buf_dot_f32_4_slice_into: out range out of bounds") }

    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a_off > na { return oren_err(4, "buf_dot_f32_4_slice_into: a_off out of bounds") }
    if n > na - a_off { return oren_err(4, "buf_dot_f32_4_slice_into: a range out of bounds") }
    if b0_off > nb || b1_off > nb || b2_off > nb || b3_off > nb { return oren_err(4, "buf_dot_f32_4_slice_into: b_off out of bounds") }
    if n > nb - b0_off || n > nb - b1_off || n > nb - b2_off || n > nb - b3_off { return oren_err(4, "buf_dot_f32_4_slice_into: b range out of bounds") }

    // Native SIMD fast path: 1×4 dot microkernel intrinsic (single-pass over A).
    if native_simd_enabled() != 0 && n >= 4 {
        var outp = native_buf_data_ptr(out) + out_off * 8
        var pa = native_buf_data_ptr(a) + a_off * 4
        var pb0 = native_buf_data_ptr(b) + b0_off * 4
        var pb1 = native_buf_data_ptr(b) + b1_off * 4
        var pb2 = native_buf_data_ptr(b) + b2_off * 4
        var pb3 = native_buf_data_ptr(b) + b3_off * 4
        simd_dot_f32_4_ptr(outp, pa, pb0, pb1, pb2, pb3, n)
        return out
    }

    // Scalar fallback: deterministic, fixed increasing-k order.
    var s0 = 0.0
    var s1 = 0.0
    var s2 = 0.0
    var s3 = 0.0
    var i = 0
    while i < n {
        var av = oren_buf_load_f32(a, a_off + i)
        s0 = s0 + av * oren_buf_load_f32(b, b0_off + i)
        s1 = s1 + av * oren_buf_load_f32(b, b1_off + i)
        s2 = s2 + av * oren_buf_load_f32(b, b2_off + i)
        s3 = s3 + av * oren_buf_load_f32(b, b3_off + i)
        i = i + 1
    }
    oren_buf_store_f64(out, out_off + 0, s0)
    oren_buf_store_f64(out, out_off + 1, s1)
    oren_buf_store_f64(out, out_off + 2, s2)
    oren_buf_store_f64(out, out_off + 3, s3)
    return out
}

fn oren_buf_gemm_i32_4x4_slice_into(out, out_off, a, a0_off, a1_off, a2_off, a3_off, b, b0_off, b1_off, b2_off, b3_off, n) {
    // Compute a 4x4 block of dot-products in one pass over the shared k range.
    //
    // Writes 16 i64 results into `out` starting at `out_off`, row-major:
    //   out[out_off + (r*4 + c)] = dot_i32(a[a_r_off..a_r_off+n), b[b_c_off..b_c_off+n))
    //
    // Semantics:
    // - sign-extend i32 values to i64 for multiplication
    // - accumulate with i64 wrap semantics
    var eo = native_buf_check(out, BUF_TAG_I64, 8)
    if oren_is_err(eo) { return eo }
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I32, 4)
    if oren_is_err(eb) { return eb }
    if out_off < 0 || a0_off < 0 || a1_off < 0 || a2_off < 0 || a3_off < 0 || b0_off < 0 || b1_off < 0 || b2_off < 0 || b3_off < 0 || n < 0 { return oren_err(4, "buf_gemm_i32_4x4_slice_into: negative arg") }

    var no = ptr_get(out + 0)
    if out_off > no || no - out_off < 16 { return oren_err(4, "buf_gemm_i32_4x4_slice_into: out range out of bounds") }

    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a0_off > na || a1_off > na || a2_off > na || a3_off > na { return oren_err(4, "buf_gemm_i32_4x4_slice_into: a_off out of bounds") }
    if n > na - a0_off || n > na - a1_off || n > na - a2_off || n > na - a3_off { return oren_err(4, "buf_gemm_i32_4x4_slice_into: a range out of bounds") }
    if b0_off > nb || b1_off > nb || b2_off > nb || b3_off > nb { return oren_err(4, "buf_gemm_i32_4x4_slice_into: b_off out of bounds") }
    if n > nb - b0_off || n > nb - b1_off || n > nb - b2_off || n > nb - b3_off { return oren_err(4, "buf_gemm_i32_4x4_slice_into: b range out of bounds") }

    // Native SIMD fast path: true single-pass 4x4 GEMM microkernel intrinsic.
    if native_simd_enabled() != 0 && n >= 4 {
        var outp = native_buf_data_ptr(out) + out_off * 8
        var pa0 = native_buf_data_ptr(a) + a0_off * 4
        var pa1 = native_buf_data_ptr(a) + a1_off * 4
        var pa2 = native_buf_data_ptr(a) + a2_off * 4
        var pa3 = native_buf_data_ptr(a) + a3_off * 4
        var pb0 = native_buf_data_ptr(b) + b0_off * 4
        var pb1 = native_buf_data_ptr(b) + b1_off * 4
        var pb2 = native_buf_data_ptr(b) + b2_off * 4
        var pb3 = native_buf_data_ptr(b) + b3_off * 4
        simd_gemm_i32_4x4_ptr(outp, pa0, pa1, pa2, pa3, pb0, pb1, pb2, pb3, n)
        return out
    }

    // Scalar fallback.
    var c00 = 0; var c01 = 0; var c02 = 0; var c03 = 0
    var c10 = 0; var c11 = 0; var c12 = 0; var c13 = 0
    var c20 = 0; var c21 = 0; var c22 = 0; var c23 = 0
    var c30 = 0; var c31 = 0; var c32 = 0; var c33 = 0
    var i = 0
    while i < n {
        var a0 = oren_buf_load_i32(a, a0_off + i)
        var a1 = oren_buf_load_i32(a, a1_off + i)
        var a2 = oren_buf_load_i32(a, a2_off + i)
        var a3 = oren_buf_load_i32(a, a3_off + i)
        var b0 = oren_buf_load_i32(b, b0_off + i)
        var b1 = oren_buf_load_i32(b, b1_off + i)
        var b2 = oren_buf_load_i32(b, b2_off + i)
        var b3 = oren_buf_load_i32(b, b3_off + i)
        c00 = c00 + a0 * b0; c01 = c01 + a0 * b1; c02 = c02 + a0 * b2; c03 = c03 + a0 * b3
        c10 = c10 + a1 * b0; c11 = c11 + a1 * b1; c12 = c12 + a1 * b2; c13 = c13 + a1 * b3
        c20 = c20 + a2 * b0; c21 = c21 + a2 * b1; c22 = c22 + a2 * b2; c23 = c23 + a2 * b3
        c30 = c30 + a3 * b0; c31 = c31 + a3 * b1; c32 = c32 + a3 * b2; c33 = c33 + a3 * b3
        i = i + 1
    }
    oren_buf_store_i64(out, out_off + 0, c00); oren_buf_store_i64(out, out_off + 1, c01); oren_buf_store_i64(out, out_off + 2, c02); oren_buf_store_i64(out, out_off + 3, c03)
    oren_buf_store_i64(out, out_off + 4, c10); oren_buf_store_i64(out, out_off + 5, c11); oren_buf_store_i64(out, out_off + 6, c12); oren_buf_store_i64(out, out_off + 7, c13)
    oren_buf_store_i64(out, out_off + 8, c20); oren_buf_store_i64(out, out_off + 9, c21); oren_buf_store_i64(out, out_off + 10, c22); oren_buf_store_i64(out, out_off + 11, c23)
    oren_buf_store_i64(out, out_off + 12, c30); oren_buf_store_i64(out, out_off + 13, c31); oren_buf_store_i64(out, out_off + 14, c32); oren_buf_store_i64(out, out_off + 15, c33)
    return out
}

fn oren_buf_gemm_f32_4x4_slice_into(out, out_off, a, a0_off, a1_off, a2_off, a3_off, b, b0_off, b1_off, b2_off, b3_off, n) {
    // Compute a 4x4 block of dot-products in one pass over the shared k range.
    //
    // Writes 16 f64 results into `out` starting at `out_off`, row-major:
    //   out[out_off + (r*4 + c)] = dot_f32(a[a_r_off..a_r_off+n), b[b_c_off..b_c_off+n))
    //
    // Semantics:
    // - widen f32 -> f64
    // - multiply in f64
    // - accumulate in fixed increasing-k order (deterministic)
    var eo = native_buf_check(out, BUF_TAG_F64, 8)
    if oren_is_err(eo) { return eo }
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F32, 4)
    if oren_is_err(eb) { return eb }
    if out_off < 0 || a0_off < 0 || a1_off < 0 || a2_off < 0 || a3_off < 0 || b0_off < 0 || b1_off < 0 || b2_off < 0 || b3_off < 0 || n < 0 { return oren_err(4, "buf_gemm_f32_4x4_slice_into: negative arg") }

    var no = ptr_get(out + 0)
    if out_off > no || no - out_off < 16 { return oren_err(4, "buf_gemm_f32_4x4_slice_into: out range out of bounds") }

    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a0_off > na || a1_off > na || a2_off > na || a3_off > na { return oren_err(4, "buf_gemm_f32_4x4_slice_into: a_off out of bounds") }
    if n > na - a0_off || n > na - a1_off || n > na - a2_off || n > na - a3_off { return oren_err(4, "buf_gemm_f32_4x4_slice_into: a range out of bounds") }
    if b0_off > nb || b1_off > nb || b2_off > nb || b3_off > nb { return oren_err(4, "buf_gemm_f32_4x4_slice_into: b_off out of bounds") }
    if n > nb - b0_off || n > nb - b1_off || n > nb - b2_off || n > nb - b3_off { return oren_err(4, "buf_gemm_f32_4x4_slice_into: b range out of bounds") }

    // Native fast path (rolling):
    // Reuse the existing, already bit-exact 1x4 dot microkernel to fill 4 rows.
    //
    // This is not a "true" single-pass 4x4 GEMM microkernel yet, but it preserves:
    // - correctness (bitwise match to scalar reference)
    // - deterministic k-order semantics (each dot accumulates k=0..n-1 in order)
    if native_simd_enabled() != 0 && n >= 4 {
        var outp = native_buf_data_ptr(out) + out_off * 8
        var pa0 = native_buf_data_ptr(a) + a0_off * 4
        var pa1 = native_buf_data_ptr(a) + a1_off * 4
        var pa2 = native_buf_data_ptr(a) + a2_off * 4
        var pa3 = native_buf_data_ptr(a) + a3_off * 4
        var pb0 = native_buf_data_ptr(b) + b0_off * 4
        var pb1 = native_buf_data_ptr(b) + b1_off * 4
        var pb2 = native_buf_data_ptr(b) + b2_off * 4
        var pb3 = native_buf_data_ptr(b) + b3_off * 4

        // True single-pass 4x4 GEMM microkernel:
        // - loads/widens each B column once per k-block
        // - widens A rows to f64
        // - multiplies in f64 and accumulates in deterministic increasing-k order
        simd_gemm_f32_4x4_ptr(outp, pa0, pa1, pa2, pa3, pb0, pb1, pb2, pb3, n)
        return out
    }

    // Scalar fallback (deterministic).
    var c00 = 0.0; var c01 = 0.0; var c02 = 0.0; var c03 = 0.0
    var c10 = 0.0; var c11 = 0.0; var c12 = 0.0; var c13 = 0.0
    var c20 = 0.0; var c21 = 0.0; var c22 = 0.0; var c23 = 0.0
    var c30 = 0.0; var c31 = 0.0; var c32 = 0.0; var c33 = 0.0
    var i = 0
    while i < n {
        var a0 = oren_buf_load_f32(a, a0_off + i)
        var a1 = oren_buf_load_f32(a, a1_off + i)
        var a2 = oren_buf_load_f32(a, a2_off + i)
        var a3 = oren_buf_load_f32(a, a3_off + i)
        var b0 = oren_buf_load_f32(b, b0_off + i)
        var b1 = oren_buf_load_f32(b, b1_off + i)
        var b2 = oren_buf_load_f32(b, b2_off + i)
        var b3 = oren_buf_load_f32(b, b3_off + i)
        c00 = c00 + a0 * b0; c01 = c01 + a0 * b1; c02 = c02 + a0 * b2; c03 = c03 + a0 * b3
        c10 = c10 + a1 * b0; c11 = c11 + a1 * b1; c12 = c12 + a1 * b2; c13 = c13 + a1 * b3
        c20 = c20 + a2 * b0; c21 = c21 + a2 * b1; c22 = c22 + a2 * b2; c23 = c23 + a2 * b3
        c30 = c30 + a3 * b0; c31 = c31 + a3 * b1; c32 = c32 + a3 * b2; c33 = c33 + a3 * b3
        i = i + 1
    }
    oren_buf_store_f64(out, out_off + 0, c00); oren_buf_store_f64(out, out_off + 1, c01); oren_buf_store_f64(out, out_off + 2, c02); oren_buf_store_f64(out, out_off + 3, c03)
    oren_buf_store_f64(out, out_off + 4, c10); oren_buf_store_f64(out, out_off + 5, c11); oren_buf_store_f64(out, out_off + 6, c12); oren_buf_store_f64(out, out_off + 7, c13)
    oren_buf_store_f64(out, out_off + 8, c20); oren_buf_store_f64(out, out_off + 9, c21); oren_buf_store_f64(out, out_off + 10, c22); oren_buf_store_f64(out, out_off + 11, c23)
    oren_buf_store_f64(out, out_off + 12, c30); oren_buf_store_f64(out, out_off + 13, c31); oren_buf_store_f64(out, out_off + 14, c32); oren_buf_store_f64(out, out_off + 15, c33)
    return out
}

fn oren_buf_dot_f32(a, b): f64 {
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_dot_f32: length mismatch") }

    // SIMD fast path (native backend only): NEON dot over raw f32 pointers.
    // Must preserve scalar semantics: widen to f64 and accumulate in scalar order.
    if native_simd_enabled() != 0 && n >= 4 {
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        return simd_dot_f32_ptr(pa, pb, n)
    }

    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + (oren_buf_load_f32(a, i) * oren_buf_load_f32(b, i))
        i = i + 1
    }
    return sum
}

fn oren_buf_dot_f32_slice(a, a_off, b, b_off, n): f64 {
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F32, 4)
    if oren_is_err(eb) { return eb }
    if a_off < 0 || b_off < 0 || n < 0 { return oren_err(4, "buf_dot_f32_slice: negative arg") }
    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a_off > na || b_off > nb { return oren_err(4, "buf_dot_f32_slice: offset out of bounds") }
    if a_off + n > na || b_off + n > nb { return oren_err(4, "buf_dot_f32_slice: range out of bounds") }

    if native_simd_enabled() != 0 && n >= 4 {
        var pa = native_buf_data_ptr(a) + a_off * 4
        var pb = native_buf_data_ptr(b) + b_off * 4
        return simd_dot_f32_ptr(pa, pb, n)
    }

    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + (oren_buf_load_f32(a, a_off + i) * oren_buf_load_f32(b, b_off + i))
        i = i + 1
    }
    return sum
}

fn oren_buf_dot_f64_into(out, a, b) {
    var eo = native_buf_check(out, BUF_TAG_F64, 8)
    if oren_is_err(eo) { return eo }
    var sum = oren_buf_dot_f64(a, b)
    if oren_is_err(sum) { return sum }
    oren_buf_store_f64(out, 0, sum)
    return out
}

fn oren_buf_dot_i32_strided(a, a_off, a_stride, b, b_off, b_stride, n) {
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I32, 4)
    if oren_is_err(eb) { return eb }
    if a_off < 0 || b_off < 0 || n < 0 { return oren_err(4, "buf_dot_i32_strided: negative arg") }
    if a_stride <= 0 || b_stride <= 0 { return oren_err(4, "buf_dot_i32_strided: stride must be > 0") }
    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a_off > na || b_off > nb { return oren_err(4, "buf_dot_i32_strided: offset out of bounds") }
    if n > 0 {
        var alast = a_off + (n - 1) * a_stride
        var blast = b_off + (n - 1) * b_stride
        if alast < 0 || alast >= na { return oren_err(4, "buf_dot_i32_strided: a range out of bounds") }
        if blast < 0 || blast >= nb { return oren_err(4, "buf_dot_i32_strided: b range out of bounds") }
    }

    var sum = 0
    var i = 0
    while i < n {
        sum = sum + (oren_buf_load_i32(a, a_off + i * a_stride) * oren_buf_load_i32(b, b_off + i * b_stride))
        i = i + 1
    }
    return sum
}

fn oren_buf_dot_f32_strided(a, a_off, a_stride, b, b_off, b_stride, n): f64 {
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F32, 4)
    if oren_is_err(eb) { return eb }
    if a_off < 0 || b_off < 0 || n < 0 { return oren_err(4, "buf_dot_f32_strided: negative arg") }
    if a_stride <= 0 || b_stride <= 0 { return oren_err(4, "buf_dot_f32_strided: stride must be > 0") }
    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a_off > na || b_off > nb { return oren_err(4, "buf_dot_f32_strided: offset out of bounds") }
    if n > 0 {
        var alast = a_off + (n - 1) * a_stride
        var blast = b_off + (n - 1) * b_stride
        if alast < 0 || alast >= na { return oren_err(4, "buf_dot_f32_strided: a range out of bounds") }
        if blast < 0 || blast >= nb { return oren_err(4, "buf_dot_f32_strided: b range out of bounds") }
    }

    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + (oren_buf_load_f32(a, a_off + i * a_stride) * oren_buf_load_f32(b, b_off + i * b_stride))
        i = i + 1
    }
    return sum
}

fn oren_buf_dot_i32_into(out, a, b) {
    var eo = native_buf_check(out, BUF_TAG_I64, 8)
    if oren_is_err(eo) { return eo }
    var sum = oren_buf_dot_i32(a, b)
    if oren_is_err(sum) { return sum }
    oren_buf_store_i64(out, 0, sum)
    return out
}

fn oren_buf_dot_f32_into(out, a, b) {
    var eo = native_buf_check(out, BUF_TAG_F64, 8)
    if oren_is_err(eo) { return eo }
    var sum = oren_buf_dot_f32(a, b)
    if oren_is_err(sum) { return sum }
    oren_buf_store_f64(out, 0, sum)
    return out
}

fn oren_buf_reduce_sum_f64(buf): f64 {
    var err = native_buf_check(buf, BUF_TAG_F64, 8)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)

    if native_simd_enabled() != 0 && n >= 2 {
        var pa = native_buf_data_ptr(buf)
        // Native SIMD returns f64 bits in an integer register (X0) for a pure ABI boundary.
        // Convert back to f64 at the Oren level so call sites see a real float.
        return oren_u64_bits_to_f64(simd_reduce_sum_f64_ptr(pa, n))
    }

    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + oren_buf_load_f64(buf, i)
        i = i + 1
    }
    return sum
}

fn oren_buf_reduce_sum_f64_into(out, buf) {
    var eo = native_buf_check(out, BUF_TAG_F64, 8)
    if oren_is_err(eo) { return eo }
    var sum = oren_buf_reduce_sum_f64(buf)
    if oren_is_err(sum) { return sum }
    oren_buf_store_f64(out, 0, sum)
    return out
}

fn oren_buf_mul_f32_into(dst, a, b) {
    var ed = native_buf_check(dst, BUF_TAG_F32, 4)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) || n != ptr_get(dst + 0) { return oren_err(4, "buf_mul_f32_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 4 {
        var pd2 = native_buf_data_ptr(dst)
        var pa2 = native_buf_data_ptr(a)
        var pb2 = native_buf_data_ptr(b)
        simd_mul_f32_ptr(pd2, pa2, pb2, n)
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_f32(dst, i, oren_buf_load_f32(a, i) * oren_buf_load_f32(b, i))
        i = i + 1
    }
    return dst
}

fn oren_buf_mul_f32(a, b) {
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var n = ptr_get(a + 0)
    var out = oren_f32_buf_new(n)
