fn oren_buf_scale_f32(buf, scalar: f64) {
    var err = native_buf_check(buf, BUF_TAG_F32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    // f32 scalar boundary (matches AVM/C runtime semantics).
    var sbits = oren_f32_to_u32_bits(scalar)
    var s32 = oren_u32_bits_to_f32(sbits)

    if native_simd_enabled() != 0 && n >= 4 {
        var pd = native_buf_data_ptr(buf)
        // In-place scale is safe (dst_ptr == a_ptr).
        simd_scale_f32_ptr(pd, pd, sbits, n)
        return buf
    }

    var i = 0
    while i < n {
        oren_buf_store_f32(buf, i, oren_buf_load_f32(buf, i) * s32)
        i = i + 1
    }
    return buf
}

fn oren_buf_scale_f32_into(dst, a, scalar: f64) {
    var ed = native_buf_check(dst, BUF_TAG_F32, 4)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var n = ptr_get(a + 0)
    if n != ptr_get(dst + 0) { return oren_err(4, "buf_scale_f32_into: length mismatch") }
    var sbits = oren_f32_to_u32_bits(scalar)
    var s32 = oren_u32_bits_to_f32(sbits)

    if native_simd_enabled() != 0 && n >= 4 {
        var pd2 = native_buf_data_ptr(dst)
        var pa2 = native_buf_data_ptr(a)
        simd_scale_f32_ptr(pd2, pa2, sbits, n)
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_f32(dst, i, oren_buf_load_f32(a, i) * s32)
        i = i + 1
    }
    return dst
}

fn oren_buf_scale_i32_into(dst, a, scalar) {
    var ed = native_buf_check(dst, BUF_TAG_I32, 4)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var n = ptr_get(a + 0)
    if n != ptr_get(dst + 0) { return oren_err(4, "buf_scale_i32_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 4 {
        var pd2 = native_buf_data_ptr(dst)
        var pa2 = native_buf_data_ptr(a)
        simd_scale_i32_ptr(pd2, pa2, scalar, n)
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_i32(dst, i, oren_buf_load_i32(a, i) * scalar)
        i = i + 1
    }
    return dst
}

fn oren_buf_axpy_f32_into(dst, alpha: f64, x, y) {
    // y := alpha*x + y (into dst)
    var ed = native_buf_check(dst, BUF_TAG_F32, 4)
    if oren_is_err(ed) { return ed }
    var ex = native_buf_check(x, BUF_TAG_F32, 4)
    if oren_is_err(ex) { return ex }
    var ey = native_buf_check(y, BUF_TAG_F32, 4)
    if oren_is_err(ey) { return ey }
    var n = ptr_get(dst + 0)
    if n != ptr_get(x + 0) || n != ptr_get(y + 0) { return oren_err(4, "buf_axpy_f32_into: length mismatch") }

    // Semantics: alpha is rounded to float32 once, then each element does float32 mul then float32 add.
    // This matches the C runtime / AVM behavior and keeps deterministic results (no FMA).
    var abits = oren_f32_to_u32_bits(alpha)
    var a32 = oren_u32_bits_to_f32(abits)

    if native_simd_enabled() != 0 && n >= 4 {
        var pd2 = native_buf_data_ptr(dst)
        var px2 = native_buf_data_ptr(x)
        var py2 = native_buf_data_ptr(y)
        simd_axpy_f32_ptr(pd2, abits, px2, py2, n)
        return dst
    }

    var i = 0
    while i < n {
        var xv = oren_buf_load_f32(x, i)
        var yv = oren_buf_load_f32(y, i)
        // Force float32 rounding points explicitly for scalar semantics parity.
        var m = oren_u32_bits_to_f32(oren_f32_to_u32_bits(a32 * xv))
        var outv = oren_u32_bits_to_f32(oren_f32_to_u32_bits(m + yv))
        oren_buf_store_f32(dst, i, outv)
        i = i + 1
    }
    return dst
}

fn oren_buf_axpy_f32_in_place(alpha: f64, x, y) {
    return oren_buf_axpy_f32_into(y, alpha, x, y)
}

fn oren_buf_axpy_i32_into(dst, alpha, x, y) {
    var ed = native_buf_check(dst, BUF_TAG_I32, 4)
    if oren_is_err(ed) { return ed }
    var ex = native_buf_check(x, BUF_TAG_I32, 4)
    if oren_is_err(ex) { return ex }
    var ey = native_buf_check(y, BUF_TAG_I32, 4)
    if oren_is_err(ey) { return ey }
    var n = ptr_get(dst + 0)
    if n != ptr_get(x + 0) || n != ptr_get(y + 0) { return oren_err(4, "buf_axpy_i32_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 4 {
        var pd2 = native_buf_data_ptr(dst)
        var px2 = native_buf_data_ptr(x)
        var py2 = native_buf_data_ptr(y)
        simd_axpy_i32_ptr(pd2, alpha, px2, py2, n)
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_i32(dst, i, (alpha * oren_buf_load_i32(x, i)) + oren_buf_load_i32(y, i))
        i = i + 1
    }
    return dst
}

fn oren_buf_axpy_i32_in_place(alpha, x, y) {
    return oren_buf_axpy_i32_into(y, alpha, x, y)
}

fn oren_buf_reduce_sum_f32(buf): f64 {
    var err = native_buf_check(buf, BUF_TAG_F32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var sum = 0.0
    var i = 0
    while i < n {
        sum = sum + oren_buf_load_f32(buf, i)
        i = i + 1
    }
    return sum
}

fn oren_buf_reduce_sum_f32_into(out, buf) {
    var eo = native_buf_check(out, BUF_TAG_F64, 8)
    if oren_is_err(eo) { return eo }
    var sum = oren_buf_reduce_sum_f32(buf)
    if oren_is_err(sum) { return sum }
    oren_buf_store_f64(out, 0, sum)
    return out
}

fn oren_buf_reduce_sum_i32(buf) {
    var err = native_buf_check(buf, BUF_TAG_I32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var sum = 0
    var i = 0
    while i < n {
        sum = sum + oren_buf_load_i32(buf, i)
        i = i + 1
    }
    return sum
}

fn oren_buf_reduce_sum_i32_into(out, buf) {
    var eo = native_buf_check(out, BUF_TAG_I64, 8)
    if oren_is_err(eo) { return eo }
    var sum = oren_buf_reduce_sum_i32(buf)
    if oren_is_err(sum) { return sum }
    oren_buf_store_i64(out, 0, sum)
    return out
}

// --- Args ---
fn oren_args() {
    var argc = global_get_argc()
    var argv = global_get_argv()
    if argc <= 0 { return oren_new_list(0) }
    if argv == 0 { return oren_new_list(0) }

    var out = oren_new_list(argc)
    var i = 0
    while i < argc {
        var s = ptr_get(argv + i * 8)
        oren_list_push(out, s)
        i = i + 1
    }
    return out
}

// --- Path helpers (pure, deterministic) ---
// NOTE: v0 `oren_realpath()` is purely lexical normalization:
// - collapses repeated '/'
// - removes '.' segments
// - resolves '..' segments without touching the filesystem
// - does NOT check existence and does NOT consult the host
fn oren_realpath(path) {
    if path == 0 { return 0 }

    var n = oren_string_len(path)
    var is_abs = false
    if n > 0 {
        if ptr_get_byte(path) == 47 { is_abs = true } // '/'
    }

    // Stack of segments encoded as (start<<32)|len.
    var segs = oren_new_list(0)

    var i = 0
    while i <= n {
        // Skip separators
        while i < n {
            if ptr_get_byte(path + i) != 47 { break }
            i = i + 1
        }
        if i >= n { break }

        var start = i
        while i < n {
            if ptr_get_byte(path + i) == 47 { break }
            i = i + 1
        }
        var end = i
        var seg_len = end - start

        // '.'
        if seg_len == 1 {
            if ptr_get_byte(path + start) == 46 {
                // skip
                continue
            }
        }

        // '..'
        if seg_len == 2 {
            if ptr_get_byte(path + start) == 46 {
                if ptr_get_byte(path + start + 1) == 46 {
                    var cnt = oren_list_len(segs)
                    if cnt > 0 {
                        // Pop if last is not '..' (for relative) OR always for absolute.
                        var last = oren_list_get(segs, cnt - 1)
                        var last_len = last & 4294967295
                        var last_start = last >> 32
                        var last_is_dd = false
                        if last_len == 2 {
                            if ptr_get_byte(path + last_start) == 46 {
                                if ptr_get_byte(path + last_start + 1) == 46 { last_is_dd = true }
                            }
                        }
                        if is_abs || last_is_dd != true {
                            ptr_set(segs, cnt - 1) // shrink list (pop)
                            continue
                        }
                    }
                    if is_abs != true {
                        // Preserve leading '..' for relative paths.
                        oren_list_push(segs, (start << 32) | seg_len)
                    }
                    continue
                }
            }
        }

        oren_list_push(segs, (start << 32) | seg_len)
    }

    var cnt2 = oren_list_len(segs)
    if is_abs {
        if cnt2 == 0 {
            var out0 = malloc(2)
            if out0 == 0 { exit(277) }
            ptr_set_byte(out0, 47)
            ptr_set_byte(out0 + 1, 0)
            oren_track_alloc(out0, 2, 1)
            return out0
        }
    } else {
        if cnt2 == 0 {
            var out1 = malloc(2)
            if out1 == 0 { exit(278) }
            ptr_set_byte(out1, 46)
            ptr_set_byte(out1 + 1, 0)
            oren_track_alloc(out1, 2, 1)
            return out1
        }
    }

    var total = 0
    if is_abs { total = 1 }
    var j = 0
    while j < cnt2 {
        var seg = oren_list_get(segs, j)
        var seg_len2 = seg & 4294967295
        total = total + seg_len2
        if j + 1 < cnt2 { total = total + 1 }
        j = j + 1
    }

    var out = malloc(total + 1)
    if out == 0 { exit(279) }

    var off = 0
    if is_abs {
        ptr_set_byte(out, 47)
        off = 1
    }

    var k = 0
    while k < cnt2 {
        var seg2 = oren_list_get(segs, k)
        var seg_len3 = seg2 & 4294967295
        var seg_start3 = seg2 >> 32
        var t = 0
        while t < seg_len3 {
            ptr_set_byte(out + off + t, ptr_get_byte(path + seg_start3 + t))
            t = t + 1
        }
        off = off + seg_len3
        if k + 1 < cnt2 {
            ptr_set_byte(out + off, 47)
            off = off + 1
        }
        k = k + 1
    }

    ptr_set_byte(out + total, 0)
    oren_track_alloc(out, total + 1, 1)
    return out
}

@cap.requires(domain="FS")
fn oren_exists(path) {
    // Returns true if the path exists (stat succeeds), false if it does not.
    // Capsule-safe: path resolution and FS capability checks are enforced.
    var pair = native_capsule_fs_path_resolve_pair(path, 0)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    // Darwin: stat64 syscall; Linux: newfstatat.
    // We only use the return code here (no struct layout dependency).
    var st = malloc(144)
    if st == 0 { exit(285) }
    var rc = sys_stat(rpath, st)
    free(st)

    if owned == 1 { free(rpath) }
    if rc < 0 { return false }
    return true
}

@cap.requires(domain="FS")
fn oren_realpath_checked(path) {
    // Deterministic helper: lexical normalize (oren_realpath) and then check existence.
    // In capsule mode, existence is checked only within enrolled mounts/prefixes.
    var rp = oren_realpath(path)
    if rp == 0 { return 0 }
    if oren_exists(rp) != true {
        // Keep failure explicit and non-silent in v0.
        print("FS NOT FOUND")
        exit(78)
    }
    return rp
}

@cap.requires(domain="FS")
fn oren_getcwd() {
    // Returns the current working directory.
    //
    // Security/determinism note:
    // - In capsule mode we must not leak host paths. Return "/" (virtual root).
    // - In host mode (non-capsule) on macOS we use fcntl(F_GETPATH).
    // - On Linux we will use sys_getcwd when running natively.

    native_capsule_require(CAP_FS, "FS")
    if global_get_capsule_mode() == 1 {
        // VirtualFS has no host cwd. Returning "/" is deterministic and avoids
        // leaking host paths. This also makes it safe for libraries that use
        // getcwd as part of path normalization.
        var out = malloc(2)
        if out == 0 { exit(280) }
        ptr_set_byte(out + 0, 47) // '/'
        ptr_set_byte(out + 1, 0)
        oren_track_alloc(out, 2, 1) // STRING
        return out
    }

    // macOS implementation: open(".") + fcntl(F_GETPATH)
    // (works without libc; relies on sys_open + sys_fcntl_getpath intrinsics)
    var fd = sys_open(".", 0, 0)
    if fd < 0 { exit(281) }

    var buf = malloc(4096)
    if buf == 0 { sys_close(fd); exit(282) }

    var rc = sys_fcntl_getpath(fd, buf)
    if rc < 0 { sys_close(fd); exit(283) }

    var cc = sys_close(fd)
    if cc < 0 { exit(284) }

    // Treat the buffer as a returned string.
    // fcntl(F_GETPATH) NUL-terminates.
    oren_track_alloc(buf, 4096, 1) // STRING
    return buf
}

// --- Binary I/O (byte-accurate) ---
// Note: implemented via syscalls (see codegen intrinsics for sys_open/sys_read/sys_write/sys_close).

@cap.requires(domain="FS")
fn oren_write_bytes(path, bytes) {
    var pair = native_capsule_fs_path_resolve_pair(path, 1)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    var flags = 1 | OREN_O_CREAT | OREN_O_TRUNC // WRONLY|CREAT|TRUNC (Oren-level flags)
    var fd = sys_open(rpath, flags, 420) // 0644
    if fd < 0 { exit(260) }

    var n = oren_list_len(bytes)
    if n > 0 {
        var buf = malloc(n)
        if buf == 0 { exit(261) }
        var i = 0
        while i < n {
            // bytes[i] is an int 0..255
            var v = bytes[i]
            if v < 0 { sys_close(fd); exit(264) }
            if v > 255 { sys_close(fd); exit(265) }
            ptr_set_byte(buf + i, v)
            i = i + 1
        }
        // Handle short writes and propagate errno deterministically.
        var off = 0
        while off < n {
            var wn = sys_write(fd, buf + off, n - off)
            if wn < 0 { sys_close(fd); exit(266) }
            if wn == 0 { sys_close(fd); exit(267) } // can't make progress
            off = off + wn
        }
        free(buf)
    }

    var crc = sys_close(fd)
    if crc < 0 { exit(268) }
    if owned == 1 { free(rpath) }
    return 0
}

@cap.requires(domain="FS")
fn oren_read_bytes(path) {
    var pair = native_capsule_fs_path_resolve_pair(path, 0)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    var fd = sys_open(rpath, 0, 0) // O_RDONLY
    if fd < 0 { exit(262) }

    var out = oren_new_list(0)
    var buf = malloc(4096)
    if buf == 0 { exit(263) }

    while 1 {
        var rn = sys_read(fd, buf, 4096)
        if rn == 0 { break } // EOF
        if rn < 0 { sys_close(fd); exit(269) } // errno propagated by syscall lowering
        var i = 0
        while i < rn {
            oren_list_push(out, ptr_get_byte(buf + i))
            i = i + 1
        }
    }

    free(buf)
    var crc = sys_close(fd)
    if crc < 0 { exit(270) }
    if owned == 1 { free(rpath) }
    return out
}


@cap.requires(domain="FS")
fn oren_readdir(path) {
    // Returns a list of entry names (strings) in the directory at `path`.
    // Implemented via syscalls (sys_open + sys_getdirentries64 + sys_close) and is capsule-safe.
    //
    // Record formats supported (detected per-entry):
    // - Darwin: struct dirent64 (sys/dirent.h): name @ +21, namlen @ +18 (u16)
    // - Linux:  linux_dirent64 (getdents64):      name @ +19, no namlen field

    var pair = native_capsule_fs_path_resolve_pair(path, 0)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    var fd = sys_open(rpath, 0, 0) // O_RDONLY
    if fd < 0 { exit(271) }

    var out = oren_new_list(0)

    var buf = malloc(4096)
    if buf == 0 { exit(272) }

    var pos = malloc(8)
    if pos == 0 { exit(273) }
    ptr_set(pos, 0)

    while 1 {
        var n = sys_getdirentries64(fd, buf, 4096, pos)
        if n == 0 { break }
        if n < 0 { sys_close(fd); exit(274) }

        var off = 0
        while off < n {
            // d_reclen is u16 little-endian at offset 16 in both Darwin and Linux formats.
            var r0 = ptr_get_byte(buf + off + 16)
            var r1 = ptr_get_byte(buf + off + 17)
            var reclen = r0 | (r1 << 8)
            if reclen <= 0 { break }
            if off + reclen > n { break }

            // Try Darwin format first (has namlen u16 at +18).
            var b18 = ptr_get_byte(buf + off + 18)
            var b19 = ptr_get_byte(buf + off + 19)
            var namlen = b18 | (b19 << 8)

            var name_ptr = buf + off + 19
            var name_len = 0

            // Darwin: name starts at +21 and namlen must fit in record.
            if namlen >= 0 {
                if 21 + namlen <= reclen {
                    name_ptr = buf + off + 21
                    name_len = namlen
                }
            }

            // Linux fallback: name starts at +19 and is NUL-terminated.
            if name_len == 0 {
                name_ptr = buf + off + 19
                var max_len = reclen - 19
                var k = 0
                while k < max_len {
                    if ptr_get_byte(name_ptr + k) == 0 { break }
                    k = k + 1
                }
                name_len = k
            }

            // Skip empty / '.' / '..'
            var skip = false
            if name_len <= 0 { skip = true }
            if skip != true {
                if name_len == 1 {
                    if ptr_get_byte(name_ptr) == 46 { skip = true }
                }
                if name_len == 2 {
                    if ptr_get_byte(name_ptr) == 46 {
                        if ptr_get_byte(name_ptr + 1) == 46 { skip = true }
                    }
                }
            }

            if skip != true {
                var s2 = malloc(name_len + 1)
                if s2 == 0 { exit(275) }
                var j = 0
                while j < name_len {
                    ptr_set_byte(s2 + j, ptr_get_byte(name_ptr + j))
                    j = j + 1
                }
                ptr_set_byte(s2 + name_len, 0)
                oren_track_alloc(s2, name_len + 1, 1) // STRING
                oren_list_push(out, s2)
            }

            off = off + reclen
        }
    }

    free(pos)
    free(buf)
    var crc = sys_close(fd)
    if crc < 0 { exit(276) }
    if owned == 1 { free(rpath) }
    return out
}

// --- TCP/IP (syscall-first) ---
// Notes:
// - macOS/BSD socket structs are built manually (byte-by-byte) without libc.
// - All potentially-blocking operations use kqueue/kevent with a caller-provided timeout.
// - Return convention: functions return fd/nbytes on success, or negative errno on failure.
//
// IMPORTANT (rolling): avoid relying on initialized global integer vars for numeric constants.
// Use numeric literals inside the functions to keep behavior robust during bootstrap.

fn oren_tcp_parse_ipv4_into(ip, out4_ptr) {
    if ip == 0 { return 0 }
    if out4_ptr == 0 { return 0 }

    var part = 0
    var acc = 0
    var digits = 0
    var i = 0
    while 1 {
        var ch = ptr_get_byte(ip + i)
        if ch == 0 { break }
        if ch >= 48 {
            if ch <= 57 {
                acc = acc * 10 + (ch - 48)
                if acc > 255 { return 0 }
                digits = digits + 1
            } else {
                return 0
            }
        } else {
            if ch == 46 {
                if digits == 0 { return 0 }
                if part >= 3 { return 0 }
                ptr_set_byte(out4_ptr + part, acc)
                part = part + 1
                acc = 0
                digits = 0
            } else {
                return 0
            }
        }
        i = i + 1
    }

    if part != 3 { return 0 }
    if digits == 0 { return 0 }
    ptr_set_byte(out4_ptr + 3, acc)
    return 1
}

fn oren_tcp_sockaddr_in(ip, port) {
    // struct sockaddr_in:
    //
    // - macOS/BSD layout (16 bytes):
    //     u8  sin_len
    //     u8  sin_family
    //     u16 sin_port (big-endian)
    //     u32 sin_addr (bytes)
    //     u8  sin_zero[8]
    //
    // - Linux layout (16 bytes):
    //     u16 sin_family (little-endian)
    //     u16 sin_port   (big-endian)
    //     u32 sin_addr   (bytes)
    //     u8  sin_zero[8]
    //
    // Rolling portability rule:
    // - Do not rely on host SDK headers.
    // - Select layout by probing kqueue availability once (macOS has it, Linux doesn't).
    var sa = malloc(16)
    if sa == 0 { return 0 }
    if sa == -1 { return 0 }
    oren_track_alloc(sa, 16, 0)

    // zero-fill
    var zi = 0
    while zi < 16 {
        ptr_set_byte(sa + zi, 0)
        zi = zi + 1
    }

    // Ensure we know whether this target has kqueue.
    // In rolling mode, native codegen should pass target_os into native_runtime_init,
    // which sets g_net_has_kqueue deterministically. Keep this probe as a last-resort
    // fallback for older binaries.
    if g_net_has_kqueue == -1 {
        var kq0 = sys_kqueue()
        if kq0 < 0 { g_net_has_kqueue = 0 }
        else { g_net_has_kqueue = 1; sys_close(kq0) }
    }

    if g_net_has_kqueue == 1 {
        // macOS/BSD: len + family
        ptr_set_byte(sa + 0, 16) // len
        ptr_set_byte(sa + 1, OREN_AF_INET) // AF_INET
    } else {
        // Linux: family u16 LE at [0..1]
        ptr_set_byte(sa + 0, OREN_AF_INET)
        ptr_set_byte(sa + 1, 0)
    }

    // port in network order
    var hi = (port >> 8) & 255
    var lo = port & 255
    ptr_set_byte(sa + 2, hi)
    ptr_set_byte(sa + 3, lo)

    // address bytes
    if ip == 0 {
        // default: 127.0.0.1
        ptr_set_byte(sa + 4, 127)
        ptr_set_byte(sa + 5, 0)
        ptr_set_byte(sa + 6, 0)
        ptr_set_byte(sa + 7, 1)
    } else {
        var ok = oren_tcp_parse_ipv4_into(ip, sa + 4)
        if ok == 0 { return 0 }
    }

    return sa
}

fn oren_sockaddr_in6(ip6_bytes, port) {
    // struct sockaddr_in6:
    //
    // - macOS/BSD (28 bytes):
    //     u8  sin6_len
    //     u8  sin6_family
    //     u16 sin6_port (big-endian)
    //     u32 sin6_flowinfo (native-endian; little on arm64)
    //     u8  sin6_addr[16]
    //     u32 sin6_scope_id (native-endian; little on arm64)
    //
    // - Linux (28 bytes):
    //     u16 sin6_family (little-endian)
    //     u16 sin6_port   (big-endian)
    //     u32 sin6_flowinfo (little-endian)
    //     u8  sin6_addr[16]
    //     u32 sin6_scope_id (little-endian)
    //
    // Input:
    // - ip6_bytes: bytes container (list<int 0..255> or u8_buf) of length 16; if nil => ::1.
    var sa = malloc(28)
    if sa == 0 { return 0 }
    oren_track_alloc(sa, 28, 0)

    // zero-fill
    var zi = 0
    while zi < 28 {
        ptr_set_byte(sa + zi, 0)
        zi = zi + 1
    }

    if g_target_os == 1 {
        // macOS/BSD
        ptr_set_byte(sa + 0, 28)
        ptr_set_byte(sa + 1, OREN_AF_INET6)
    } else {
        // Linux: family u16 LE
        ptr_set_byte(sa + 0, OREN_AF_INET6 & 255)
        ptr_set_byte(sa + 1, (OREN_AF_INET6 >> 8) & 255)
    }

    // port in network order
    ptr_set_byte(sa + 2, (port >> 8) & 255)
    ptr_set_byte(sa + 3, port & 255)

    // addr bytes
    if ip6_bytes == 0 {
        // default ::1 (last byte = 1)
        ptr_set_byte(sa + 8 + 15, 1)
    } else {
        var n = oren_bytes_len(ip6_bytes)
        if oren_is_err(n) { return 0 }
        if n != 16 { return 0 }
        var i = 0
        while i < 16 {
            var b = oren_bytes_get_u8(ip6_bytes, i)
            if b < 0 || b > 255 { return 0 }
            ptr_set_byte(sa + 8 + i, b)
            i = i + 1
        }
    }
    return sa
}

fn oren_sockaddr_un(path) {
    // struct sockaddr_un:
    // - macOS/BSD: len(u8) + family(u8) + path[104], sizeof=106
    // - Linux: family(u16) + path[108], sizeof=110
    //
    // Input:
    // - path: string (NUL not required; we NUL-terminate if room)
    if path == 0 { return 0 }
    var n = oren_string_len(path)
    if n < 0 { return 0 }

    if g_target_os == 1 {
        var sa = malloc(106)
        if sa == 0 { return 0 }
        oren_track_alloc(sa, 106, 0)
        var zi = 0
        while zi < 106 { ptr_set_byte(sa + zi, 0); zi = zi + 1 }
        ptr_set_byte(sa + 0, 106)
        ptr_set_byte(sa + 1, OREN_AF_UNIX)
        var i = 0
        while i < n {
            if i >= 104 { break }
            ptr_set_byte(sa + 2 + i, ptr_get_byte(path + i))
            i = i + 1
        }
        // NUL terminate if there is space
        if i < 104 { ptr_set_byte(sa + 2 + i, 0) }
        return sa
    }

    // Linux
    var sa2 = malloc(110)
    if sa2 == 0 { return 0 }
    oren_track_alloc(sa2, 110, 0)
    var zj = 0
    while zj < 110 { ptr_set_byte(sa2 + zj, 0); zj = zj + 1 }
    ptr_set_byte(sa2 + 0, OREN_AF_UNIX)
    ptr_set_byte(sa2 + 1, 0)
    var j = 0
    while j < n {
        if j >= 108 { break }
        ptr_set_byte(sa2 + 2 + j, ptr_get_byte(path + j))
        j = j + 1
    }
    if j < 108 { ptr_set_byte(sa2 + 2 + j, 0) }
    return sa2
}

@cap.requires(domain="NET")
fn oren_tcp_set_nonblock(fd) {
    native_capsule_require(CAP_NET, "NET")
    var flags = sys_fcntl_getfl(fd)
    if flags < 0 { return flags }
    var r = sys_fcntl_setfl(fd, flags | OREN_O_NONBLOCK)
    return r
}

@cap.requires(domain="NET")
fn oren_tcp_wait_kqueue(fd, filter, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    // Returns 1 if ready, 0 if timed out, or negative errno.
    if timeout_ms < 0 { timeout_ms = 0 }
    if g_net_has_kqueue == 0 { return -1 }
    var kq = sys_kqueue()
    if g_net_has_kqueue == -1 {
        // First-time detection.
        if kq < 0 {
            g_net_has_kqueue = 0
            return -1
        }
        g_net_has_kqueue = 1
    } else {
        if kq < 0 { return kq }
    }

    var change = malloc(32)
    if change == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(change, 32, 0)
    var ev = malloc(32)
    if ev == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(ev, 32, 0)

    // Zero-fill the kevent structs (malloc does not promise zeroed memory).
    var zi = 0
    while zi < 32 {
        ptr_set_byte(change + zi, 0)
        ptr_set_byte(ev + zi, 0)
        zi = zi + 1
    }

    // struct kevent:
    // ident (u64) @0
    // filter (i16) @8
    // flags (u16)  @10
    // fflags (u32) @12
    // data (i64)   @16
    // udata (ptr)  @24
    ptr_set(change + 0, fd)
    ptr_set_byte(change + 8, filter & 255)
    ptr_set_byte(change + 9, (filter >> 8) & 255)
    var kflags = 1 | 4 | 16 // EV_ADD | EV_ENABLE | EV_ONESHOT
    ptr_set_byte(change + 10, kflags & 255)
    ptr_set_byte(change + 11, (kflags >> 8) & 255)
    ptr_set(change + 16, 0)
    ptr_set(change + 24, 0)

    // timespec*
    var ts = 0
    ts = malloc(16)
    if ts == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(ts, 16, 0)
    var sec = timeout_ms / 1000
    var nsec = (timeout_ms - sec * 1000) * 1000000
    ptr_set(ts + 0, sec)
    ptr_set(ts + 8, nsec)

    var n = sys_kevent(kq, change, 1, ev, 1, ts)
    sys_close(kq)
    // Avoid leaking temporaries; free() is deterministic and reuses blocks.
    free(change)
    free(ev)
    free(ts)
    return n
}

@cap.requires(domain="NET")
fn oren_fd_wait_epoll(fd, events_mask, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    // Returns 1 if ready, 0 if timed out, or negative errno.
    //
    // Linux only. Darwin does not have epoll (return -ENOSYS).
    if g_target_os == 1 { return 0 - 78 } // ENOSYS
    if timeout_ms < 0 { timeout_ms = -1 } // epoll uses -1 for infinite

    var epfd = sys_epoll_create1(0)
    if epfd < 0 { return epfd }

    // struct epoll_event (Linux arm64):
    //   u32 events @0
    //   u32 pad    @4
    //   u64 data   @8
    var ev = malloc(16)
    if ev == 0 { sys_close(epfd); return 0 - 12 } // ENOMEM
    oren_track_alloc(ev, 16, 0)
    var out = malloc(16)
    if out == 0 { sys_close(epfd); free(ev); return 0 - 12 } // ENOMEM
    oren_track_alloc(out, 16, 0)

    var zi = 0
    while zi < 16 {
        ptr_set_byte(ev + zi, 0)
        ptr_set_byte(out + zi, 0)
        zi = zi + 1
    }

    oren_ptr_set_u32_le(ev + 0, events_mask)
    oren_ptr_set_u64_le(ev + 8, fd)

    var rc = sys_epoll_ctl(epfd, OREN_EPOLL_CTL_ADD, fd, ev)
    if rc < 0 {
        sys_close(epfd)
        free(ev)
        free(out)
        return rc
    }

    var n = sys_epoll_pwait(epfd, out, 1, timeout_ms, 0, 0)
    sys_close(epfd)
    free(ev)
    free(out)
    if n > 0 { return 1 }
    return n
}

@cap.requires(domain="NET")
fn oren_fd_wait_readable(fd, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if g_net_has_kqueue == 1 {
        return oren_tcp_wait_kqueue(fd, -1, timeout_ms) // EVFILT_READ
    }
    return oren_fd_wait_epoll(fd, OREN_EPOLLIN, timeout_ms)
}

@cap.requires(domain="NET")
fn oren_fd_wait_writable(fd, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if g_net_has_kqueue == 1 {
        return oren_tcp_wait_kqueue(fd, -2, timeout_ms) // EVFILT_WRITE
    }
    return oren_fd_wait_epoll(fd, OREN_EPOLLOUT, timeout_ms)
}

@cap.requires(domain="NET")
fn oren_tcp_connect(ip, port, timeout_ms) {
    native_capsule_require_net_connect(ip, port)
    var fd = sys_socket(OREN_AF_INET, OREN_SOCK_STREAM, OREN_IPPROTO_TCP)
    if fd < 0 { return fd }

    // Non-blocking + explicit wait for connect completion.
    var nb = oren_tcp_set_nonblock(fd)
    if nb < 0 {
        sys_close(fd)
        return nb
    }

    var sa = oren_tcp_sockaddr_in(ip, port)
    if sa == 0 {
        sys_close(fd)
        return 0 - 22 // EINVAL
    }

    var rc = sys_connect(fd, sa, 16)
    free(sa)
    if rc == 0 { return fd }
    // EINPROGRESS:
    // - macOS: 36
    // - Linux: 115
    if rc != 0 - 36 && rc != 0 - 115 {
        sys_close(fd)
        return rc
    }

    // Check SO_ERROR to determine connect result.
    var soerr_buf = malloc(8)
    if soerr_buf == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(soerr_buf, 8, 0)
    ptr_set(soerr_buf, 0)
    var olen = malloc(8)
    if olen == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(olen, 8, 0)
    ptr_set(olen, 4)

    // Readiness wait for connect completion:
    // - macOS: kqueue-backed
    // - Linux: epoll-backed (syscall-first, no libc)
    var n = oren_fd_wait_writable(fd, timeout_ms)
    if n == 0 {
        free(soerr_buf)
        free(olen)
        sys_close(fd)
        return 0 - 60 // ETIMEDOUT
    }
    if n < 0 {
        free(soerr_buf)
        free(olen)
        sys_close(fd)
        return n
    }

    var grc = sys_getsockopt(fd, OREN_SOL_SOCKET, OREN_SO_ERROR, soerr_buf, olen)
    if grc < 0 {
        free(soerr_buf)
        free(olen)
        sys_close(fd)
        return grc
    }
    var soerr = ptr_get(soerr_buf)
    free(soerr_buf)
    free(olen)
    if soerr != 0 {
        sys_close(fd)
        return 0 - soerr
    }

    return fd
}

@cap.requires(domain="NET")
fn oren_tcp_listen_local(port) {
    native_capsule_require_net_listen(0, port)
    var fd = sys_socket(OREN_AF_INET, OREN_SOCK_STREAM, OREN_IPPROTO_TCP)
    if fd < 0 { return fd }

    // Allow quick reuse during tests.
    var one = malloc(8)
    if one == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(one, 8, 0)
    ptr_set(one, 1)
    var sroc = sys_setsockopt(fd, OREN_SOL_SOCKET, OREN_SO_REUSEADDR, one, 4)
    free(one)
    if sroc < 0 {
        sys_close(fd)
        return sroc
    }

    var nb = oren_tcp_set_nonblock(fd)
    if nb < 0 {
        sys_close(fd)
        return nb
    }

    var sa = oren_tcp_sockaddr_in(0, port) // 127.0.0.1
    if sa == 0 {
        sys_close(fd)
        return 0 - 22 // EINVAL
    }

    var brc = sys_bind(fd, sa, 16)
    free(sa)
    if brc < 0 {
        sys_close(fd)
        return brc
    }

    var lrc = sys_listen(fd, 16)
    if lrc < 0 {
        sys_close(fd)
        return lrc
    }

    return fd
}

@cap.requires(domain="NET")
fn oren_tcp_accept(listen_fd, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    var n = oren_fd_wait_readable(listen_fd, timeout_ms)
    if n == 0 { return 0 - 60 } // ETIMEDOUT
    if n < 0 { return n }
    return sys_accept(listen_fd, 0, 0)
}

@cap.requires(domain="NET")
fn oren_tcp_read_into(fd, buf, len, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if len <= 0 { return 0 }
    var n = oren_fd_wait_readable(fd, timeout_ms)
    if n == 0 { return 0 - 60 } // ETIMEDOUT
    if n < 0 { return n }
    var r = sys_recvfrom(fd, buf, len, 0, 0, 0)
    // EAGAIN/EWOULDBLOCK:
    // - macOS: 35
    // - Linux: 11
    if r == 0 - 35 || r == 0 - 11 { return 0 }
    return r
}

@cap.requires(domain="NET")
fn oren_tcp_write_from(fd, buf, len, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if len <= 0 { return 0 }
    var n = oren_fd_wait_writable(fd, timeout_ms)
    if n == 0 { return 0 - 60 } // ETIMEDOUT
    if n < 0 { return n }
    var w = sys_sendto(fd, buf, len, 0, 0, 0)
    if w == 0 - 35 || w == 0 - 11 { return 0 }
    return w
}

@cap.requires(domain="NET")
fn oren_tcp_close(fd) {
    native_capsule_require(CAP_NET, "NET")
    if fd < 0 { return 0 }
    // best-effort shutdown; ignore errors
    sys_shutdown(fd, 2) // SHUT_RDWR
    sys_close(fd)
    return 0
}

// --- Threads ---
@cap.requires(domain="PROC")
fn oren_system(cmd) {
    native_capsule_require(CAP_PROC, "PROC")
    return oren_system_timeout(cmd, -1)
}

fn native_runtime_get_envp_ptr() {
    // Preserve parent environment without libc.
    // Prefer the envp captured at process entry; fallback to deriving envp from argv/argc.
    var envp = global_get_envp()
    if envp == 0 {
        var argc = global_get_argc()
        var parent_argv = global_get_argv()
        if parent_argv != 0 {
            // Cap derived pointer math so a corrupted argc can't walk arbitrarily.
            if argc >= 0 && argc <= 1048576 {
                envp = iadd(parent_argv, (iadd(argc, 1)) * 8)
            }
        }
    }
    if envp == 0 {
        envp = malloc(8) // 1 pointer (NULL-terminated)
        if envp == 0 { return 0 }
        ptr_set(envp, 0)
    }
    return envp
}

fn native_csv_has_key(csv_cstr, key_ptr, key_len) {
    if csv_cstr == 0 { return false }
    if key_ptr == 0 { return false }
    if key_len <= 0 { return false }

    var n = native_cstr_len(csv_cstr)
    var i = 0
    var start = 0
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(csv_cstr, i)) }

        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var tok_start = start
            var tok_end = i
            while tok_start < tok_end && ptr_get_byte(iadd(csv_cstr, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(csv_cstr, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            if tok_end - tok_start == key_len {
                var j = 0
                var ok = true
                while j < key_len {
                    if ptr_get_byte(iadd(csv_cstr, tok_start + j)) != ptr_get_byte(iadd(key_ptr, j)) {
                        ok = false
                        j = key_len
                    } else {
                        j = j + 1
                    }
                }
                if ok { return true }
            }

            start = i + 1
        }
        i = i + 1
    }
    return false
}

fn native_envp_push_unique(out, oi, max_out, ptr) {
    if ptr == 0 { return oi }
    var j = 0
    while j < oi {
        if ptr_get(out + (j * 8)) == ptr { return oi }
        j = j + 1
    }
    if oi >= max_out { return oi }
    ptr_set(out + (oi * 8), ptr)
    return oi + 1
}

fn native_runtime_get_envp_for_proc_child() {
    // Determine envp for subprocess exec in the child (after fork, before execve).
    //
    // Policy (capsule mode):
    // - If OREN_PROC_INHERIT_ENV=1 => inherit all env.
    // - Else build a filtered env consisting of:
    //     - Mandatory OREN_* capsule controls (so the child cannot "escape capsule" by env filtering)
    //     - Plus keys allowlisted by OREN_PROC_ALLOW_ENV_KEYS (if set).
    //
    // Non-capsule: inherit all env.
    var parent_envp = native_runtime_get_envp_ptr()
    if global_get_capsule_mode() != 1 { return parent_envp }

    if global_get_proc_inherit_env() == 1 { return parent_envp }

    var keys = global_get_proc_allow_env_keys_ptr()

    // Conservative cap; we don't want huge env arrays during bootstrap.
    var max_out = 256
    var out = malloc((max_out + 1) * 8)
    if out == 0 { return 0 }
    var oi = 0

    // --- Mandatory capsule env entries (best-effort) ---
    // Keep this list small and focused: only OREN_* capability and resource enrollment vars.
    // These are NOT secrets; they are the mechanism that prevents child escape.
    var must_capsule = native_envp_get_entry_ptr("OREN_CAPSULE")
    if must_capsule != 0 {
        oi = native_envp_push_unique(out, oi, max_out, must_capsule)
    } else {
        // The parent is in capsule mode, so this should exist, but be robust anyway.
        oi = native_envp_push_unique(out, oi, max_out, "OREN_CAPSULE=1")
    }
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_CAP_ALLOW_DOMAINS"))
    // FS enrollment
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_ALLOW_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_ALLOW_READ_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_ALLOW_WRITE_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_MOUNTS"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_MOUNTS_READ"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_MOUNTS_WRITE"))
    // NET enrollment
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_ALLOW_LOOPBACK"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_ALLOW_TCP_CONNECT"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_ALLOW_TCP_LISTEN"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_TCP_CONNECT_MAP"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_TCP_LISTEN_MAP"))
    // PROC enrollment
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_EXEC_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_SYSTEM"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_INHERIT_ENV"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_ENV_KEYS"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_ARGV"))

    // --- Optional allowlisted parent env keys ---
    if keys != 0 {
        var i = 0
        while i < 4096 && oi < max_out {
            var ent = ptr_get(iadd(parent_envp, i * 8))
            if ent == 0 { break }

            var key_len = 0
            while key_len < 256 {
                var ch = ptr_get_byte(iadd(ent, key_len))
                if ch == 0 { key_len = 0; break }
                if ch == 61 { break } // '='
                key_len = key_len + 1
            }

            if key_len > 0 && key_len < 256 {
                if native_csv_has_key(keys, ent, key_len) {
                    oi = native_envp_push_unique(out, oi, max_out, ent)
                }
            }
            i = i + 1
        }
    }

    ptr_set(out + (oi * 8), 0)
    return out
}

@cap.requires(domain="PROC")
fn oren_proc_spawn(path, argv, timeout_ms) {
    // Syscall-first subprocess spawn (no libc, no PATH search).
    //
    // - path: explicit exec path (e.g. "/usr/bin/true")
    // - argv: list of argv entries (including argv0), or [] for default argv0=path
    // - timeout_ms < 0: wait forever
    // - timeout_ms >= 0: poll wait4(WNOHANG) up to timeout_ms iterations (rolling: not wall-clock)
    //
    // Returns wait status (raw), or negative on internal failure, or -60 on timeout.
    native_capsule_require_proc_exec(path)
    if path == 0 { return -1 }

    var argc = 0
    if argv != 0 { argc = oren_list_len(argv) }

    // Ensure argv0 exists.
    var out_argc = argc
    if out_argc < 1 { out_argc = 1 }

    var child_argv = malloc((out_argc + 1) * 8) // argv pointers + NULL
    if child_argv == 0 { return -1 }

    var i = 0
    while i < out_argc {
        var a = 0
        if argc == 0 {
            if i == 0 { a = path }
        } else {
            a = argv[i]
            if i == 0 && a == 0 { a = path }
        }
        // Best-effort validation: require a NUL-terminated string within a cap.
        if native_cstr_len(a) >= 4096 {
            free(child_argv)
            return -1
        }
        ptr_set(child_argv + (i * 8), a)
        i = i + 1
    }
    ptr_set(child_argv + (out_argc * 8), 0)

    // In capsule mode, enforce argv allowlist before forking.
    native_capsule_require_proc_argv(path, child_argv, out_argc)

    var pid = oren_fork()
    if pid < 0 {
        free(child_argv)
        return -1
    }

    if pid == 0 {
        var envp = native_runtime_get_envp_for_proc_child()
        if envp == 0 { exit(127) }
        sys_execve(path, child_argv, envp)
        exit(127)
    }

    // Parent: record ownership so capsule sys_wait4/sys_kill cannot target arbitrary pids.
    native_capsule_proc_register_pid(pid)

    // Parent: wait4(pid, &status, options, 0)
    free(child_argv)
    var status_ptr = malloc(8)
    if status_ptr == 0 { return -1 }
    ptr_set(status_ptr, 0)

    if timeout_ms < 0 {
        var wpid = sys_wait4(pid, status_ptr, 0, 0)
        if wpid < 0 {
            free(status_ptr)
            return -1
        }
        var status = ptr_get(status_ptr)
        free(status_ptr)
        return status
    }

    // Poll: wait4(..., WNOHANG=1) until budget exhausted (deterministic; no TIME domain required).
    var remaining = timeout_ms
    while remaining > 0 {
        var wpid2 = sys_wait4(pid, status_ptr, 1, 0) // WNOHANG
        if wpid2 == pid {
            var status2 = ptr_get(status_ptr)
            free(status_ptr)
            return status2
        }
        if wpid2 < 0 {
            free(status_ptr)
            return -1
        }
        remaining = remaining - 1
    }

    // Timeout: kill child and reap to avoid zombies.
    oren_kill(pid, 9) // SIGKILL
    sys_wait4(pid, status_ptr, 0, 0) // best-effort reap
    free(status_ptr)
    return 0 - 60 // ETIMEDOUT (BSD)
}

fn oren_system_timeout(cmd, timeout_ms) {
    // Syscall-first `system(3)` equivalent with an optional timeout.
    //
    // In capsule mode this is intentionally blocked unless explicitly enabled:
    // it executes a shell (/bin/sh -c), which is too powerful to allow by default.
    native_capsule_require_proc_system()

    if cmd == 0 { return -1 }
    var args = ["sh", "-c", cmd]
    return oren_proc_spawn("/bin/sh", args, timeout_ms)
}

fn oren_net_get(url) {
    // Minimal HTTP/1.0 GET for native backend (macOS v0):
    // - Supports: http://<ipv4>[:port][/path]
    // - No TLS, no DNS, no chunked transfer decoding.
    if url == 0 { return 0 }

    // Require "http://"
    var prefix = "http://"
    var pl = oren_string_len(prefix)
    var ul = oren_string_len(url)
    if ul < pl { return 0 }
    var pi = 0
    while pi < pl {
        if ptr_get_byte(url + pi) != ptr_get_byte(prefix + pi) { return 0 }
        pi = pi + 1
    }

    var pos = pl
    // Find '/' for path start
    var slash = -1
    var i = pos
    while i < ul {
        if ptr_get_byte(url + i) == 47 { slash = i; break } // '/'
        i = i + 1
    }
    if slash == -1 { slash = ul }

    // Find ':' for port separator (only within host segment)
    var colon = -1
    i = pos
    while i < slash {
        if ptr_get_byte(url + i) == 58 { colon = i; break } // ':'
        i = i + 1
    }

    var host_end = slash
    if colon != -1 { host_end = colon }
    var host = oren_string_slice(url, pos, host_end)
    if host == 0 { return 0 }

    var port = 80
    if colon != -1 {
        var port_s = oren_string_slice(url, colon + 1, slash)
        var pv = oren_int_from_string(port_s)
        if pv <= 0 { return 0 }
        port = pv
    }

    var path = "/"
    if slash < ul {
        path = oren_string_slice(url, slash, ul)
        if path == 0 { return 0 }
    }

    // Connect (5s timeout)
    var fd = oren_tcp_connect(host, port, 5000)
    if fd < 0 { return 0 }

    // Build request: "GET <path> HTTP/1.0\r\nHost: <host>\r\nConnection: close\r\n\r\n"
    var r0 = string_concat("GET ", path)
    var r1 = string_concat(r0, " HTTP/1.0\r\nHost: ")
    var r2 = string_concat(r1, host)
    var r3 = string_concat(r2, "\r\nConnection: close\r\n\r\n")
    // Free intermediate concatenation buffers to avoid unbounded growth on repeated calls.
    free(r0)
    free(r1)
    free(r2)

    var req_len = oren_string_len(r3)
    var wr = oren_tcp_write_from(fd, r3, req_len, 5000)
    free(r3)
    if wr < 0 {
        oren_tcp_close(fd)
        return 0
    }

    // Read entire response into a growing buffer.
    var cap = 4096
    var used = 0
    var buf = malloc(cap)
    if buf == 0 {
        oren_tcp_close(fd)
        return 0
    }

    while 1 {
        var tmp = malloc(1024)
        if tmp == 0 { break }
        var n = oren_tcp_read_into(fd, tmp, 1024, 5000)
        if n <= 0 {
            free(tmp)
            break
        }

        // Ensure capacity for used+n
        while used + n > cap {
            var new_cap = cap * 2
            if new_cap < used + n { new_cap = used + n }
            var new_buf = malloc(new_cap)
            if new_buf == 0 { break }
            oren_memcpy(new_buf, buf, used)
            free(buf)
            buf = new_buf
            cap = new_cap
        }
        oren_memcpy(buf + used, tmp, n)
        used = used + n
        free(tmp)
    }

    oren_tcp_close(fd)

    // Find header terminator "\r\n\r\n"
    var body_off = 0
    i = 0
    while i + 3 < used {
        if ptr_get_byte(buf + i) == 13 {
            if ptr_get_byte(buf + i + 1) == 10 {
                if ptr_get_byte(buf + i + 2) == 13 {
                    if ptr_get_byte(buf + i + 3) == 10 {
                        body_off = i + 4
                        break
                    }
                }
            }
        }
        i = i + 1
    }

    if body_off < 0 { body_off = 0 }
    if body_off > used { body_off = used }

    var body_len = used - body_off
    var out = malloc(body_len + 1)
    if out == 0 {
        free(buf)
        return 0
    }
    oren_memcpy(out, buf + body_off, body_len)
    ptr_set_byte(out + body_len, 0)
    oren_track_alloc(out, body_len + 1, 1)
    free(buf)
    return out
}

fn free(ptr) {
    if ptr == 0 { return 0 }
    if oren_globals() == 0 { return 0 }
    acquire_lock()

    // Deterministic/manual-friendly free:
    // - remove from allocs list immediately
    // - push into free_blocks so future malloc() can reuse the block
    //
    // This must work even when GC scanning is disabled (`--no-gc` / OREN_NO_GC=1).
    var prev = 0
    var cur = global_get_allocs()
    while cur != 0 {
        var next = ptr_get(iadd(cur, 32))
        if ptr_get(cur) == ptr {
            if prev == 0 {
                global_set_allocs(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }
            var kind = ptr_get(iadd(cur, 16))
            ptr_set(iadd(cur, 24), 0) // clear freed/mark flags

            if kind == 9 {
                // RAW_MMAP: return to OS now; do not keep for reuse.
                var base = ptr - raw_hdr_size()
                if ptr_get(base + 0) == raw_magic() {
                    var total = ptr_get(base + 8)
                    var backend = ptr_get(base + 16)
                    if backend == 1 && total > 0 {
                        sys_munmap(base, total)
                    }
                }
                // Reuse tracking node storage.
                ptr_set(cur, 0)
                ptr_set(iadd(cur, 8), 40)
                ptr_set(iadd(cur, 16), 0)
                ptr_set(iadd(cur, 24), 0)
                ptr_set(iadd(cur, 32), global_get_free_nodes())
                global_set_free_nodes(cur)
            } else {
                ptr_set(iadd(cur, 32), global_get_free_blocks())
                global_set_free_blocks(cur)
            }
            release_lock()
            return 0
        }
        prev = cur
        cur = next
    }

    release_lock()
    return 0
}

fn oren_join_timeout(handle, timeout_ms) {
    if handle == 0 { return 0 }

    // Spawn handle layout (native backend, macOS v0 fork+pipe):
    // 0: pid (u64)
    // 8: read_fd (u64)

    var pid = ptr_get(handle)
    var fd = ptr_get(handle + 8)

    var buf = malloc(8)
    if buf == 0 { exit(270) }
    ptr_set(buf, 0)

    // Read exactly 8 bytes (result value) with an optional timeout budget.
    var got = 0

    // Timeout semantics (rolling, syscall-first):
    // - `timeout_ms < 0`: wait forever (blocking read).
    // - `timeout_ms >= 0`: deterministic poll budget (no kqueue/epoll dependency).
    //
    // Rationale:
    // - Linux does not have kqueue, and we don't want libc poll()/select() shims.
    // - For spawn/join, we can wait on child termination via wait4(WNOHANG) and only
    //   attempt to read the pipe once the child has exited.
    // - This keeps behavior portable and makes tests deterministic.
    var reaped = 0
    if timeout_ms >= 0 {
        var remaining = timeout_ms
        while remaining > 0 {
            var wpid0 = sys_wait4(pid, 0, 1, 0) // WNOHANG
            if wpid0 == pid {
                reaped = 1
                break
            }
            if wpid0 < 0 {
                sys_close(fd)
                free(handle)
                return wpid0
            }
            remaining = remaining - 1
        }
        if reaped == 0 {
            // Timeout: kill child and reap to avoid zombies.
            oren_kill(pid, 9) // SIGKILL
            sys_wait4(pid, 0, 0, 0) // best-effort reap
            sys_close(fd)
            free(handle)
            return 0 - 60 // ETIMEDOUT (BSD)
        }
        // Child is already reaped by the WNOHANG wait4 above; proceed to read pipe.
    }

    while got < 8 {
        var n = sys_read(fd, buf + got, 8 - got)
        if n == 0 { break } // EOF
        if n < 0 {
            sys_close(fd)
            if reaped == 0 { sys_wait4(pid, 0, 0, 0) }
            free(handle)
            return n
        }
        got = got + n
    }

    sys_close(fd)

    // Reap child (best-effort).
    if reaped == 0 { sys_wait4(pid, 0, 0, 0) }

    if got != 8 {
        free(handle)
        return -1
    }

    var ret_val = ptr_get(buf)
    free(handle)
    return ret_val
}

fn oren_join(handle) {
    return oren_join_timeout(handle, -1)
}
