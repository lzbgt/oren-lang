fn stack_trace() {
    print("Traceback (most recent call first):")
    var fp = get_fp()
    var i = 0
    while fp != 0 {
        if i > 20 { 
            print("  ... (truncated)")
            return 0 
        }
        var lr = ptr_get(fp + 8)
        var name = resolve_symbol(lr)
        print(string_concat("  File \"?\", line ?, in ", name))
        // print_hex(lr)
        fp = ptr_get(fp)
        i = i + 1
    }
}

