fn oren_memcpy(dst, src, len) {
    var i = 0
    while i < len {
        if len - i >= 8 {
            ptr_set(iadd(dst, i), ptr_get(iadd(src, i)))
            i = i + 8
        } else {
            ptr_set_byte(iadd(dst, i), ptr_get_byte(iadd(src, i)))
            i = i + 1
        }
    }
    return 0
}

// --- Channels (Pipe-based) ---
fn oren_new_channel() {
    return oren_pipe() // Returns [r, w]
}

fn oren_chan_send(ch, val) {
    var w = oren_list_get(ch, 1)
    var buf = malloc(8)
    if buf == 0 { return 0 }
    ptr_set(buf, val)
    sys_write(w, buf, 8)
    // free(buf) - no free yet
    return 1
}

fn oren_chan_recv(ch) {
    var r = oren_list_get(ch, 0)
    var buf = malloc(8)
    if buf == 0 { return 0 }
    sys_read(r, buf, 8)
    var val = ptr_get(buf)
    // free(buf)
    return val
}

// --- Native GC/Heap Tracking ---
fn oren_pipe() {
    var buf = malloc(16)
    if buf == 0 { return oren_new_list(0) }
    
    var res = sys_pipe(buf)
    if res != 0 { return oren_new_list(0) }
    
    var r = ptr_get(buf)
    var w = ptr_get(iadd(buf, 8))
    
    var l = oren_new_list(2)
    oren_list_push(l, r)
    oren_list_push(l, w)
    return l
}

// --- Native GC/Heap Tracking ---

// We use a string literal in a function to get a stable pointer to writable memory for globals.
// Layout (8-byte slots):
//   0:allocs
//   8:roots
//   16:lock_owner_tid
//   24:free_nodes
//   32:threads
//   40:argc
//   48:argv
//   56:lock_recurse_count
//   64:envp
//   72:free_blocks
//   80:capsule_mode (0|1) (rolling: deny-by-default capability enforcement)
//   88:cap_allow_mask (bitmask; rolling)
var g_storage = 0

fn oren_globals() {
    return g_storage
}

// NOTE (ABI hygiene; rolling):
// - Keep a single authoritative definition of global slot offsets.
// - Do not reuse slots for unrelated purposes.
// - Prefer global_get_*/global_set_* helpers over raw offsets.
var GLOBAL_SLOT_BYTES = 8
var GLOBAL_OFF_ALLOCS = 0
var GLOBAL_OFF_ROOTS = 8
var GLOBAL_OFF_LOCK_OWNER_TID = 16
var GLOBAL_OFF_FREE_NODES = 24
var GLOBAL_OFF_THREADS = 32
var GLOBAL_OFF_ARGC = 40
var GLOBAL_OFF_ARGV = 48
var GLOBAL_OFF_LOCK_RECURSE_COUNT = 56
var GLOBAL_OFF_ENVP = 64
var GLOBAL_OFF_FREE_BLOCKS = 72
var GLOBAL_OFF_CAPSULE_MODE = 80
var GLOBAL_OFF_CAP_ALLOW_MASK = 88

// Reserve extra room for rolling ABI growth (must be >= 9 slots today).
var GLOBAL_SLOTS_RESERVED = 16

fn global_get_allocs() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_ALLOCS)) }
fn global_set_allocs(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_ALLOCS), v) }

fn global_get_roots() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_ROOTS)) }
fn global_set_roots(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_ROOTS), v) }

fn global_get_lock() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_LOCK_OWNER_TID)) }
fn global_set_lock(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_LOCK_OWNER_TID), v) }

fn global_get_free_nodes() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_FREE_NODES)) }
fn global_set_free_nodes(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_FREE_NODES), v) }

fn global_get_free_blocks() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_FREE_BLOCKS)) }
fn global_set_free_blocks(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_FREE_BLOCKS), v) }

fn global_get_threads() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_THREADS)) }
fn global_set_threads(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_THREADS), v) }

fn global_get_argc() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_ARGC)) }
fn global_set_argc(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_ARGC), v) }

fn global_get_argv() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_ARGV)) }
fn global_set_argv(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_ARGV), v) }

fn global_get_lock_count() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_LOCK_RECURSE_COUNT)) }
fn global_set_lock_count(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_LOCK_RECURSE_COUNT), v) }

fn global_get_envp() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_ENVP)) }
fn global_set_envp(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_ENVP), v) }

fn global_get_capsule_mode() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_CAPSULE_MODE)) }
fn global_set_capsule_mode(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_CAPSULE_MODE), v) }

fn global_get_cap_allow_mask() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_CAP_ALLOW_MASK)) }
fn global_set_cap_allow_mask(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_CAP_ALLOW_MASK), v) }

// Capsule/capability mask bits (rolling; native backend only).
var CAP_FS = 1
var CAP_NET = 2
var CAP_PROC = 4
var CAP_ENV = 8
var CAP_TIME = 16

// --- Fork hygiene (rolling; syscall-first) ---
// After fork(), the child process inherits any in-memory locks held at the moment of fork.
// Our native runtime allocator uses an in-memory lock keyed by a thread-id token.
// If a lock is held by the parent at fork time, the child must reset those lock fields
// before doing further allocations, or it can deadlock (classic "fork while locked" issue).
//
// This is not a "pthread atfork" shim; it's purely internal runtime hygiene for fork-based v0 features.
fn native_runtime_after_fork_child() {
    var g = oren_globals()
    if g == 0 { return 0 }
    // lock_owner_tid
    global_set_lock(0)
    // lock_recurse_count
    global_set_lock_count(0)
    return 0
}

fn oren_fork() {
    var pid = sys_fork()
    if pid == 0 {
        native_runtime_after_fork_child()
    }
    return pid
}

fn native_runtime_init() {
    // The native backend is still rolling and does not reliably run global initializers
    // before entering the runtime. Ensure globals used by early allocation are safe.
    g_storage = 0

    // IMPORTANT: today the native backend does not reliably run global initializers
    // before entering the runtime. Treat these as "constants" that must be set here.
    GLOBAL_SLOT_BYTES = 8
    GLOBAL_OFF_ALLOCS = 0
    GLOBAL_OFF_ROOTS = 8
    GLOBAL_OFF_LOCK_OWNER_TID = 16
    GLOBAL_OFF_FREE_NODES = 24
    GLOBAL_OFF_THREADS = 32
    GLOBAL_OFF_ARGC = 40
    GLOBAL_OFF_ARGV = 48
    GLOBAL_OFF_LOCK_RECURSE_COUNT = 56
    GLOBAL_OFF_ENVP = 64
    GLOBAL_OFF_FREE_BLOCKS = 72
    GLOBAL_OFF_CAPSULE_MODE = 80
    GLOBAL_OFF_CAP_ALLOW_MASK = 88
    GLOBAL_SLOTS_RESERVED = 16

    // IMPORTANT: do not rely on global initializers for these constants.
    // Capability mask bits (used by capsule runtime enforcement).
    CAP_FS = 1
    CAP_NET = 2
    CAP_PROC = 4
    CAP_ENV = 8
    CAP_TIME = 16

    // Reserve room for current globals + some growth slack (rolling ABI).
    //
    // IMPORTANT: allocate globals storage with malloc_raw so it is NOT tracked by GC.
    // This is runtime metadata and must never be reclaimed by mark/sweep.
    g_storage = malloc_raw(GLOBAL_SLOTS_RESERVED * GLOBAL_SLOT_BYTES)
    if g_storage == 0 { exit(199) }
    
    // Zero it
    var i = 0
    while i < GLOBAL_SLOTS_RESERVED {
        ptr_set(iadd(g_storage, i * GLOBAL_SLOT_BYTES), 0)
        i = i + 1
    }
    return 0
}

// macOS syscall-first threading init (Darwin bsdthread + ulock model).
//
// NOTE:
// - This is intentionally "best-effort" for now: if the process is already
//   registered (because the host runtime registered earlier), the syscall
//   will fail with EINVAL; we treat that as non-fatal for v0.
// - For Oren's syscall-first runtime we want the kernel threadstart function
//   to be OUR stub (emitted by the native backend), not libpthread.
//
// Args are code pointers to the native backend's thread entry stubs.
fn native_runtime_threading_init(threadstart, wqthread) {
    // Some Darwin kernels validate pthsize for bsdthread_register; use 16KB (page-sized) like libpthread.
    var pthsize = 16384

    // NOTE: Modern Darwin bsdthread_register has multiple historical ABIs.
    // Passing a pthread init-data struct can trigger EINVAL on some kernels.
    // For v0 syscall-first spawn, we register only threadstart/wqthread + pthsize
    // and omit init-data / workqueue settings.
    var rv = sys_bsdthread_register(threadstart, wqthread, pthsize, 0, 0, 0, 0)
    // For syscall-first spawn to work, the process must be registered.
    // If registration fails, bsdthread_create will start threads with the system's default
    // threadstart (libsystem_pthread), which expects a full pthread runtime and will crash.
    // sys_bsdthread_register returns -errno on failure.
    if rv < 0 { exit(0 - rv) }
    return rv
}

fn native_runtime_set_args(argc, argv) {
    global_set_argc(argc)
    global_set_argv(argv)
    return 0
}

fn native_runtime_set_envp(envp) {
    // Keep this function leaf-like (no calls) to avoid any stack-offset bugs
    // while the compiler/runtime ABI is still evolving.
    global_set_envp(envp)
    return 0
}

fn native_cstr_len(s) {
    if s == 0 { return 0 }
    var n = 0
    while n < 65536 {
        if ptr_get_byte(iadd(s, n)) == 0 { return n }
        n = n + 1
    }
    return 65536
}

fn native_envp_get_value_ptr(key_cstr) {
    // Low-level envp scanner for early init and capsule enforcement.
    // Returns pointer to value substring for KEY in envp ("KEY=VALUE"), or 0 if not found.
    if key_cstr == 0 { return 0 }

    var envp = global_get_envp()
    if envp == 0 { return 0 }

    var key_len = native_cstr_len(key_cstr)
    if key_len <= 0 { return 0 }
    if key_len >= 4096 { return 0 }

    var i = 0
    while i < 4096 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { return 0 }

        // Check prefix match "KEY="
        var j = 0
        while j < key_len {
            if ptr_get_byte(iadd(ent, j)) != ptr_get_byte(iadd(key_cstr, j)) {
                j = -1
                break
            }
            j = j + 1
        }

        if j != -1 {
            if ptr_get_byte(iadd(ent, key_len)) == 61 { // '='
                return iadd(ent, key_len + 1)
            }
        }
        i = i + 1
    }
    return 0
}

fn native_parse_cap_allow_mask(csv_cstr) {
    if csv_cstr == 0 { return 0 }

    var mask = 0
    var i = 0
    var start = 0
    var n = native_cstr_len(csv_cstr)
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(csv_cstr, i)) }

        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var tok_start = start
            var tok_end = i
            // Trim spaces
            while tok_start < tok_end && ptr_get_byte(iadd(csv_cstr, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(csv_cstr, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            var tok_len = tok_end - tok_start
            if tok_len > 0 {
                // ASCII fold to uppercase for matching (a-z -> A-Z).
                var b0 = ptr_get_byte(iadd(csv_cstr, tok_start + 0))
                if b0 >= 97 && b0 <= 122 { b0 = b0 - 32 }

                if tok_len == 2 {
                    var b1 = ptr_get_byte(iadd(csv_cstr, tok_start + 1))
                    if b1 >= 97 && b1 <= 122 { b1 = b1 - 32 }
                    // FS
                    if b0 == 70 && b1 == 83 { mask = mask | CAP_FS }
                } else {
                    if tok_len == 3 {
                        var b1a = ptr_get_byte(iadd(csv_cstr, tok_start + 1))
                        var b2a = ptr_get_byte(iadd(csv_cstr, tok_start + 2))
                        if b1a >= 97 && b1a <= 122 { b1a = b1a - 32 }
                        if b2a >= 97 && b2a <= 122 { b2a = b2a - 32 }
                        // NET / ENV
                        if b0 == 78 && b1a == 69 && b2a == 84 {
                            mask = mask | CAP_NET
                        } else {
                            if b0 == 69 && b1a == 78 && b2a == 86 { mask = mask | CAP_ENV }
                        }
                    } else {
                        if tok_len == 4 {
                            var b1b = ptr_get_byte(iadd(csv_cstr, tok_start + 1))
                            var b2b = ptr_get_byte(iadd(csv_cstr, tok_start + 2))
                            var b3b = ptr_get_byte(iadd(csv_cstr, tok_start + 3))
                            if b1b >= 97 && b1b <= 122 { b1b = b1b - 32 }
                            if b2b >= 97 && b2b <= 122 { b2b = b2b - 32 }
                            if b3b >= 97 && b3b <= 122 { b3b = b3b - 32 }
                            // PROC / TIME
                            if b0 == 80 && b1b == 82 && b2b == 79 && b3b == 67 {
                                mask = mask | CAP_PROC
                            } else {
                                if b0 == 84 && b1b == 73 && b2b == 77 && b3b == 69 { mask = mask | CAP_TIME }
                            }
                        }
                    }
                }
            }

            start = i + 1
        }
        i = i + 1
    }
    return mask
}

fn native_runtime_capsule_init() {
    // Initialize runtime capsule enforcement from env:
    // - OREN_CAPSULE=1 enables deny-by-default enforcement for host-effectful APIs.
    // - OREN_CAP_ALLOW_DOMAINS="FS,NET,PROC,ENV,TIME" enrolls domains.
    //
    // Defaults (non-capsule): allow everything (mask ignored).
    global_set_capsule_mode(0)
    global_set_cap_allow_mask(0)

    var k_capsule = "OREN_CAPSULE"
    var v_capsule = native_envp_get_value_ptr(k_capsule)
    if v_capsule == 0 { return 0 }
    if ptr_get_byte(v_capsule) == 0 { return 0 }
    if ptr_get_byte(v_capsule) == 48 { return 0 } // '0'

    global_set_capsule_mode(1)

    var k_allow = "OREN_CAP_ALLOW_DOMAINS"
    var v_allow = native_envp_get_value_ptr(k_allow)
    if v_allow == 0 {
        global_set_cap_allow_mask(0)
        return 0
    }
    var mask = native_parse_cap_allow_mask(v_allow)
    global_set_cap_allow_mask(mask)
    return 0
}

fn native_capsule_require(mask_bit, name) {
    if global_get_capsule_mode() != 1 { return 0 }
    var allow = global_get_cap_allow_mask()
    if (allow & mask_bit) != 0 { return 0 }
    print("CAPSULE DENY: " + name)
    exit(77)
    return 0
}

// --- ENV (syscall-free; reads process initial envp block) ---
//
// Returns pointer to value substring for KEY in envp ("KEY=VALUE"), or 0 if not found.
// NOTE: This returns a pointer into the process environment strings (not a copy).
@cap.requires(domain="ENV")
fn oren_getenv(key) {
    native_capsule_require(CAP_ENV, "ENV")
    // Keep this leaf-like (no calls) to avoid any cross-call local slot issues
    // while the native backend ABI is still rolling.
    if key == 0 { return 0 }

    var g = oren_globals()
    var envp = ptr_get(iadd(g, GLOBAL_OFF_ENVP))

    // If envp wasn't captured at entry, derive it from argv/argc layout:
    // envp starts right after argv[argc] and the NULL terminator.
    var argc = ptr_get(iadd(g, GLOBAL_OFF_ARGC))
    var argv = ptr_get(iadd(g, GLOBAL_OFF_ARGV))
    if envp == 0 {
        if argv == 0 { return 0 }
        envp = iadd(argv, (iadd(argc, 1)) * 8)
    }
    if envp == 0 { return 0 }

    // key_len = strlen(key)
    var key_len = 0
    // Hard cap to avoid hangs if `key` is malformed / unterminated.
    while key_len < 4096 {
        if ptr_get_byte(iadd(key, key_len)) == 0 { break }
        key_len = key_len + 1
    }
    if key_len >= 4096 { return 0 }

    // Hard cap to avoid hangs if envp is malformed / unterminated.
    var i = 0
    while i < 4096 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { return 0 }

        // Check prefix match "KEY="
        var j = 0
        while j < key_len {
            if ptr_get_byte(iadd(ent, j)) != ptr_get_byte(iadd(key, j)) {
                j = -1
                break
            }
            j = j + 1
        }

        if j != -1 {
            if ptr_get_byte(iadd(ent, key_len)) == 61 { // '='
                return iadd(ent, key_len + 1)
            }
        }

        i = i + 1
    }
    return 0
}

// --- TIME (syscall-first) ---
//
// Provide a minimal “sleep” primitive without libc.
// We keep TIME intentionally small in v0: higher-level deadlines/cancellation can be built on top.
//
// sys_nanosleep(ns) is a native-backend intrinsic implemented per-OS:
// - macOS: kqueue/kevent timeout (no libc shims)
// - Linux: nanosleep syscall
//
// Returns 0 on success, or -errno.
@cap.requires(domain="TIME")
fn oren_sleep_ns(ns) {
    native_capsule_require(CAP_TIME, "TIME")
    if ns <= 0 { return 0 }
    return sys_nanosleep(ns)
}

@cap.requires(domain="TIME")
fn oren_sleep_ms(ms) {
    native_capsule_require(CAP_TIME, "TIME")
    if ms <= 0 { return 0 }
    // ms -> ns
    return sys_nanosleep(ms * 1000000)
}

fn oren_kill(pid, signum) {
    return sys_kill(pid, signum)
}

// Wall time in nanoseconds since Unix epoch (best-effort; not monotonic).
fn oren_time_unix_ns() {
    // struct timeval { tv_sec(u64), tv_usec(u64) } (we use 2x u64 for simplicity)
    var tv = malloc(16)
    if tv == 0 { return 0 }
    ptr_set(tv + 0, 0)
    ptr_set(tv + 8, 0)

    var rc = sys_gettimeofday(tv, 0, 0)
    if rc < 0 {
        free(tv)
        return 0
    }

    var sec = ptr_get(tv + 0)
    var usec = ptr_get(tv + 8)
    free(tv)
    return sec * 1000000000 + usec * 1000
}

// Monotonic “raw” time. For correctness, treat as compare-only (do not assume units).
// On Linux, this will be nanoseconds (via clock_gettime64 monotonic in the intrinsic).
// On macOS, this is mach_absolute_time units (returned by gettimeofday's 3rd out-arg).
fn oren_time_mono_raw() {
    var tv = malloc(16)
    if tv == 0 { return 0 }
    ptr_set(tv + 0, 0)
    ptr_set(tv + 8, 0)

    var abs_ptr = malloc(8)
    if abs_ptr == 0 {
        free(tv)
        return 0
    }
    ptr_set(abs_ptr, 0)

    var rc = sys_gettimeofday(tv, 0, abs_ptr)
    if rc < 0 {
        free(abs_ptr)
        free(tv)
        return 0
    }

    var t = ptr_get(abs_ptr)
    free(abs_ptr)
    free(tv)
    return t
}

fn oren_register_thread(top) {
    // Thread Node: [top, saved_sp, next] (24 bytes)
    // Runtime metadata: use malloc_raw so GC never reclaims thread nodes.
    var node = malloc_raw(24)
    if node != 0 {
        ptr_set(node, top)
        ptr_set(iadd(node, 8), 0) // saved_sp
        
        // Link
        acquire_lock()
        
        ptr_set(iadd(node, 16), global_get_threads())
        global_set_threads(node)
        
        release_lock()
    }
    return node
}

fn get_sp() { return 0 } // Intrinsic

// GC mode toggle (native backend):
// - enabled (default): conservative mark/sweep from stack + registered roots
// - disabled (deterministic/manual): disable scanning/collection; keep tracking so `free()` can reuse blocks
var g_gc_enabled = 1

fn native_runtime_init_gc_mode(default_enabled) {
    // default_enabled is provided by the compiler from `--no-gc`.
    g_gc_enabled = default_enabled

    // Runtime override: allow disabling GC via environment variable.
    // Any non-empty value disables scanning/collection.
    var v = native_envp_get_value_ptr("OREN_NO_GC")
    if v != 0 {
        if ptr_get_byte(v) != 0 { g_gc_enabled = 0 }
    }
    return 0
}

fn native_gc_scan_stack() {
    if g_gc_enabled == 0 { return 0 }
    var sp = get_sp()
    var cur = global_get_threads()
    
    while cur != 0 {
        var top = ptr_get(cur)
        var saved = ptr_get(iadd(cur, 8))
        var start = 0
        
        // Check if this is current thread
        // Heuristic: sp is within 8MB below top
        // 8MB = 8388608
        if sp < top {
            var diff = top - sp
            if diff < 8388608 {
                start = sp
            }
        }
        
        if start == 0 {
            start = saved
        }
        
        if start != 0 {
            while start < top {
                var val = ptr_get(start)
                oren_mark_value(val)
                start = iadd(start, 8)
            }
        }
        
        cur = ptr_get(iadd(cur, 16))
    }
    return 0
}

// Node layout: [ptr, size, kind, freed, next] (5 * 8 = 40 bytes)
// Offsets: 0=ptr, 8=size, 16=kind, 24=freed, 32=next

// Try to reuse a raw node allocation (used by malloc_raw callers like root lists).
// This must NOT reuse freed "blocks" (which are tracked allocation records pointing at object memory),
// otherwise we'd lose pointers to freed object memory and create leaks/corruption.
fn native_try_reuse_node(size) {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var prev = 0
    var cur = global_get_free_nodes()
    while cur != 0 {
        var node_size = ptr_get(iadd(cur, 8))
        if node_size >= size {
            var next = ptr_get(iadd(cur, 32))
            if prev == 0 {
                global_set_free_nodes(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }
            // Clear next pointer; caller will overwrite fields.
            ptr_set(iadd(cur, 32), 0)
            release_lock()
            return cur
        }
        prev = cur
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return 0
}

fn native_try_reuse(size) {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    // Simple first-fit from the free list.
    var prev = 0
    var cur = global_get_free_blocks()
    while cur != 0 {
        var chunk_size = ptr_get(iadd(cur, 8))
        if chunk_size >= size {
            // Unlink from free list.
            var next = ptr_get(iadd(cur, 32))
            if prev == 0 {
                global_set_free_blocks(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }

            // Reactivate this tracking node by placing it back into allocs.
            // NOTE:
            // - We keep chunk_size (capacity) as-is; size is the requested logical size.
            // - kind defaults to 5 (misc). Callers may later call `oren_track_alloc(...)`
            //   to specialize kind (e.g. string/list/map/struct/func).
            ptr_set(iadd(cur, 8), size)
            ptr_set(iadd(cur, 16), 5)
            ptr_set(iadd(cur, 24), 0) // not freed, not marked
            ptr_set(iadd(cur, 32), global_get_allocs())
            global_set_allocs(cur)

            var out = ptr_get(cur)
            release_lock()
            return out
        }
        prev = cur
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return 0
}

var g_panicking = 0

fn acquire_lock() {
    if g_panicking == 1 { return 0 }
    if oren_globals() == 0 { return 0 }
    
    var tid = sys_gettid()
    var lock_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_OWNER_TID)
    var owner = ptr_get(lock_ptr)
    
    if owner == tid {
        var count_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_RECURSE_COUNT)
        var count = ptr_get(count_ptr)
        ptr_set(count_ptr, iadd(count, 1))
        return 0
    }
    
    var spin = 0
    while atomic_cas(lock_ptr, 0, tid) != 0 {
        if g_panicking == 1 { return 0 }
        spin = iadd(spin, 1)
        // Park after a small amount of spinning to avoid burning CPU.
        if spin > 1000 {
            // Wait while lock owner hasn't changed.
            var owner_now = ptr_get(lock_ptr)
            if owner_now != 0 {
                // operation=UL_COMPARE_AND_WAIT (1), timeout_us=0 => forever
                sys_ulock_wait(1, lock_ptr, owner_now, 0)
            }
            spin = 0
        }
    }
    
    var count_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_RECURSE_COUNT)
    ptr_set(count_ptr, 1)
    return 0
}

fn release_lock() {
    if g_panicking == 1 { return 0 }
    if oren_globals() == 0 { return 0 }
    
    var tid = sys_gettid()
    var lock_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_OWNER_TID)
    var owner = ptr_get(lock_ptr)
    
    if owner != tid {
        return 0
    }
    
    var count_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_RECURSE_COUNT)
    var count = ptr_get(count_ptr)
    if count > 1 {
        ptr_set(count_ptr, count - 1)
        return 0
    }
    
    ptr_set(count_ptr, 0)
    atomic_cas(lock_ptr, tid, 0)
    // Wake any waiters that parked in acquire_lock.
    // operation=UL_COMPARE_AND_WAIT|ULF_WAKE_ALL = 1|0x100 = 257
    sys_ulock_wake(257, lock_ptr, 0)
    return 0
}

fn malloc_raw(size) { return 0 }

fn oren_track_alloc(ptr, size, kind) {
    if oren_globals() == 0 { return ptr }
    acquire_lock()

    // De-duplicate: if already tracked (allocs), update in place.
    var cur = global_get_allocs()
    while cur != 0 {
        if ptr_get(cur) == ptr {
            if size != 0 { ptr_set(iadd(cur, 8), size) }
            if kind != 0 { ptr_set(iadd(cur, 16), kind) }
            // Clear "freed" and mark flags on re-track.
            ptr_set(iadd(cur, 24), 0)
            release_lock()
            return ptr
        }
        cur = ptr_get(iadd(cur, 32))
    }

    // If it exists in the free list (reused pointer or manual re-track),
    // move it back into allocs to avoid duplicate nodes pointing at the same ptr.
    var prev = 0
    cur = global_get_free_blocks()
    while cur != 0 {
        if ptr_get(cur) == ptr {
            var next = ptr_get(iadd(cur, 32))
            if prev == 0 {
                global_set_free_blocks(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }

            ptr_set(iadd(cur, 8), size)
            ptr_set(iadd(cur, 16), kind)
            ptr_set(iadd(cur, 24), 0)
            ptr_set(iadd(cur, 32), global_get_allocs())
            global_set_allocs(cur)

            release_lock()
            return ptr
        }
        prev = cur
        cur = ptr_get(iadd(cur, 32))
    }

    // Allocate a new tracking node.
    var node = malloc_raw(40)
    if node != 0 {
        ptr_set(node, ptr)
        ptr_set(iadd(node, 8), size)
        ptr_set(iadd(node, 16), kind)
        ptr_set(iadd(node, 24), 0) // not freed, not marked
        ptr_set(iadd(node, 32), global_get_allocs())
        global_set_allocs(node)
    }

    release_lock()
    return ptr
}

fn native_gc_register_root(ptr) {
    if g_gc_enabled == 0 { return 0 }
    if ptr == 0 { return 0 }
    acquire_lock()
    
    var node = malloc_raw(40)
    if node != 0 {
        ptr_set(node, ptr)
        ptr_set(iadd(node, 8), 0)
        ptr_set(iadd(node, 16), 0) // kind 0 for root
        ptr_set(iadd(node, 24), 0)
        ptr_set(iadd(node, 32), global_get_roots())
        global_set_roots(node)
    }
    
    release_lock()
    return 0
}

fn native_gc_unregister_root(ptr) {
    if g_gc_enabled == 0 { return 0 }
    if ptr == 0 { return 0 }
    acquire_lock()

    var prev = 0
    var cur = global_get_roots()
    while cur != 0 {
        var next = ptr_get(iadd(cur, 32))
        if ptr_get(cur) == ptr {
            if prev == 0 {
                global_set_roots(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }
            // Reuse node storage via free list.
            ptr_set(cur, 0)
            ptr_set(iadd(cur, 8), 40)
            ptr_set(iadd(cur, 16), 0)
            ptr_set(iadd(cur, 24), 0)
            ptr_set(iadd(cur, 32), global_get_free_nodes())
            global_set_free_nodes(cur)
            release_lock()
            return 0
        }
        prev = cur
        cur = next
    }

    release_lock()
    return 0
}

fn oren_find_node(ptr) {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var cur = global_get_allocs()
    while cur != 0 {
        if ptr_get(cur) == ptr { 
            release_lock()
            return cur 
        }
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return 0
}

fn oren_mark_value(val) {
    if g_gc_enabled == 0 { return 0 }
    if val == 0 { return 0 }
    
    var node = oren_find_node(val)
    if node != 0 {
        var freed = ptr_get(iadd(node, 24))
        if freed == 0 {
            // Mark it
            ptr_set(iadd(node, 24), -1)
            
            var kind = ptr_get(iadd(node, 16))
            if kind == 2 { // LIST
                var count = ptr_get(val)
                var buf = ptr_get(iadd(val, 16))
                if buf != 0 {
                    var i = 0
                    while i < count {
                        var item = ptr_get(iadd(buf, i * 8))
                        oren_mark_value(item)
                        i = i + 1
                    }
                    oren_mark_value(buf)
                }
            }
            if kind == 3 { // MAP
                var count = ptr_get(iadd(val, 8))
                var base = iadd(val, 16)
                var i = 0
                while i < count {
                    var k = ptr_get(iadd(base, i * 16))
                    var v = ptr_get(iadd(base, i * 16 + 8))
                    oren_mark_value(k)
                    oren_mark_value(v)
                    i = i + 1
                }
            }
            if kind == 6 { // FUNC (closure env)
                var env = ptr_get(iadd(val, 8))
                oren_mark_value(env)
            }
        }
    }
    return 0
}

fn native_gc_collect() {
    if g_gc_enabled == 0 { return 0 }
    // 1. Clear marks
    var cur = global_get_allocs()
    while cur != 0 {
        if ptr_get(iadd(cur, 24)) == -1 {
            ptr_set(iadd(cur, 24), 0)
        }
        cur = ptr_get(iadd(cur, 32))
    }
    
    // 2. Mark stack
    native_gc_scan_stack()

    // 3. Mark roots
    var r = global_get_roots()
    while r != 0 {
        var slot = ptr_get(r)
        if slot != 0 {
            var val = ptr_get(slot)
            oren_mark_value(val)
        }
        r = ptr_get(iadd(r, 32))
    }
    
    // 4. Sweep
    var prev = 0
    cur = global_get_allocs()
    while cur != 0 {
        var marked = 0
        if ptr_get(iadd(cur, 24)) == -1 { marked = 1 }
        
        var next_node = ptr_get(iadd(cur, 32))
        
        if marked == 1 {
            ptr_set(iadd(cur, 24), 0)
            prev = cur
        } else {
            // Garbage
            if prev == 0 {
                global_set_allocs(next_node)
            } else {
                ptr_set(iadd(prev, 32), next_node)
            }

            ptr_set(iadd(cur, 32), global_get_free_blocks())
            global_set_free_blocks(cur)
        }
        cur = next_node
    }
    return 0
}

// --- Memory diagnostics (native backend; failure-only surfaces) ---
//
// These helpers intentionally return plain integers and do not allocate, so they can be used
// inside tests and long-running processes without perturbing the heap significantly.
//
// NOTE:
// - `global_get_allocs()` includes live allocations (tracked nodes).
// - `global_get_free_blocks()` includes freed blocks kept for reuse (not returned to OS).
// - These diagnostics are about "leaks / runaway growth" in the runtime sense, not RSS.

fn native_mem_live_count() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var n = 0
    var cur = global_get_allocs()
    while cur != 0 {
        n = n + 1
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return n
}

fn native_mem_live_bytes() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var sum = 0
    var cur = global_get_allocs()
    while cur != 0 {
        sum = sum + ptr_get(iadd(cur, 8))
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return sum
}

fn native_mem_free_blocks_count() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var n = 0
    var cur = global_get_free_blocks()
    while cur != 0 {
        n = n + 1
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return n
}

fn native_mem_free_blocks_bytes() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var sum = 0
    var cur = global_get_free_blocks()
    while cur != 0 {
        sum = sum + ptr_get(iadd(cur, 8))
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return sum
}

fn native_mem_roots_count() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var n = 0
    var cur = global_get_roots()
    while cur != 0 {
        n = n + 1
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return n
}

fn native_mem_free_nodes_count() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var n = 0
    var cur = global_get_free_nodes()
    while cur != 0 {
        n = n + 1
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return n
}

fn native_gc_shutdown() {
    return 0
}

var g_debug_info = 0
var g_debug_static_addr = 0
var g_slide = 0
var g_prog_pc_min = 0
var g_prog_pc_max = 0

fn compute_program_pc_bounds() {
    // Best-effort: compute min/max static PC covered by debug function ranges.
    // This is used to avoid mis-labeling host/shared-library PCs via resolve_symbol().
    g_prog_pc_min = 0
    g_prog_pc_max = 0
    if g_debug_info == 0 { return 0 }
    var ptr = g_debug_info
    var count = ptr_get_u64(ptr)
    ptr = ptr + 8
    var i = 0
    while i < count {
        var start = ptr_get_u64(ptr)
        ptr = ptr + 8
        var end = ptr_get_u64(ptr)
        ptr = ptr + 8
        if g_prog_pc_min == 0 || start < g_prog_pc_min { g_prog_pc_min = start }
        if end > g_prog_pc_max { g_prog_pc_max = end }

        var name_len = ptr_get_u64(ptr)
        ptr = ptr + 8 + name_len
        var p_count = ptr_get_u64(ptr)
        ptr = ptr + 8
        var j = 0
        while j < p_count {
            var pname_len = ptr_get_u64(ptr)
            ptr = ptr + 8 + pname_len + 8 // +8 for offset
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

fn oren_set_debug_info(ptr, static_addr) {
    g_debug_info = ptr
    g_debug_static_addr = static_addr
    g_slide = ptr - static_addr
    compute_program_pc_bounds()
    return 0
}

fn ptr_get_u64(ptr) { return ptr_get(ptr) }

fn read_string_at(ptr, len) {
    var s = malloc(len + 1)
    var i = 0
    while i < len {
        ptr_set_byte(s + i, ptr_get_byte(ptr + i))
        i = i + 1
    }
    ptr_set_byte(s + len, 0)
    oren_track_alloc(s, len + 1, 1)
    return s
}

fn find_func_info(pc) {
    if g_debug_info == 0 { return 0 }
    
    // Un-slide PC to match static table
    var static_pc = pc - g_slide
    
    var ptr = g_debug_info
    var count = ptr_get_u64(ptr)
    ptr = ptr + 8
    
    var i = 0
    while i < count {
        var start = ptr_get_u64(ptr)
        ptr = ptr + 8
        var end = ptr_get_u64(ptr)
        ptr = ptr + 8
        
        if static_pc >= start {
            if static_pc < end {
                return ptr
            }
        }
        
        var name_len = ptr_get_u64(ptr)
        ptr = ptr + 8 + name_len
        var p_count = ptr_get_u64(ptr)
        ptr = ptr + 8
        var j = 0
        while j < p_count {
            var pname_len = ptr_get_u64(ptr)
            ptr = ptr + 8 + pname_len + 8 // +8 for offset
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

fn debug_value_to_string(val) {
    var node = oren_find_node(val)
    if node != 0 {
        var kind = ptr_get(node + 16)
        if kind == 1 { // STRING
            return val
        }
        if kind == 2 { // LIST
            var s0 = "<list ptr="
            var s1 = string_concat(s0, oren_int_to_string(val))
            return string_concat(s1, ">"
            )
        }
        if kind == 3 { // MAP
            var s0 = "<map ptr="
            var s1 = string_concat(s0, oren_int_to_string(val))
            return string_concat(s1, ">"
            )
        }
        if kind == 4 { // STRUCT
            var s0 = "<struct ptr="
            var s1 = string_concat(s0, oren_int_to_string(val))
            return string_concat(s1, ">"
            )
        }
        if kind == 6 { // FUNC
            var s0 = "<func ptr="
            var s1 = string_concat(s0, oren_int_to_string(val))
            return string_concat(s1, ">"
            )
        }
    }
    return oren_int_to_string(val)
}

fn stack_trace_debug() {
    // Native backend debug stack trace (best-effort):
    // - prints function name + pc offset
    // - prints parameter values when available
    print("Traceback (most recent call first):")
    var fp = get_fp()
    var i = 0
    while fp != 0 {
        if i > 50 { 
            print("  ... (truncated)")
            return 0 
        }
        // ABI note: at [fp+8] we have the *saved LR* (return address) for this frame,
        // which is an address in the *caller*'s code. For readable traces we associate
        // that PC with the caller function, and print caller params from the caller's FP.
        var pc = ptr_get(fp + 8)
        var caller_fp = ptr_get(fp)
        var info_ptr = find_func_info(pc)
        
        if info_ptr != 0 {
            var f_start = ptr_get_u64(info_ptr - 16)
            // var f_end = ptr_get_u64(info_ptr - 8)
            var static_pc = pc - g_slide
            var off_in_func = static_pc - f_start

            var name_len = ptr_get_u64(info_ptr)
            var name = read_string_at(info_ptr + 8, name_len)
            
            // We don't have file/line info yet; print a stable, useful shape:
            //   at func +off (pc=...)
            var s0 = string_concat("  at ", name)
            var s1 = string_concat(s0, " +")
            var s2 = string_concat(s1, oren_int_to_string(off_in_func))
            var s3 = string_concat(s2, " (pc=")
            var s4 = string_concat(s3, oren_int_to_string(pc))
            print(string_concat(s4, ")"))
            
            var ptr = info_ptr + 8 + name_len
            var p_count = ptr_get_u64(ptr)
            ptr = ptr + 8
            var j = 0
            while j < p_count {
                var pname_len = ptr_get_u64(ptr)
                var pname = read_string_at(ptr + 8, pname_len)
                ptr = ptr + 8 + pname_len
                var offset = ptr_get_u64(ptr)
                ptr = ptr + 8

                // Param locals live in the caller's frame (because PC maps to caller).
                if caller_fp != 0 {
                    var val_ptr = caller_fp - offset
                    var val = ptr_get(val_ptr)
                    var s1 = string_concat("    ", pname)
                    var s2 = string_concat(s1, " = ")
                    print(string_concat(s2, debug_value_to_string(val)))
                }
                j = j + 1
            }
        } else {
            // Fallback: try best-effort symbol resolution even when debug-info
            // range lookup fails (e.g. top-level code regions or entry stub).
            var name = "<unknown>"
            if g_debug_info != 0 && g_prog_pc_min != 0 && g_prog_pc_max != 0 {
                var static_pc = pc - g_slide
                if static_pc >= g_prog_pc_min && static_pc < g_prog_pc_max {
                    name = resolve_symbol(pc)
                    if name == nil { name = "<unknown>" }
                } else {
                    name = "<unknown host>"
                }
            }
            var s0 = string_concat("  at ", name)
            var s1 = string_concat(s0, " (pc=")
            var s2 = string_concat(s1, oren_int_to_string(pc))
            print(string_concat(s2, ")"))
        }
        
        fp = caller_fp
        i = i + 1
    }
    return 0
}

fn oren_ensure_tracked(ptr, kind) {
    if ptr == 0 { return 0 }
    if oren_find_node(ptr) == 0 {
        var size = 0
        if kind == 1 {
            size = oren_string_len(ptr) + 1
        }
        oren_track_alloc(ptr, size, kind)
    }
    return ptr
}

fn oren_raw_print_str(s) {
    if s == 0 { return 0 }
    var len = oren_string_len(s)
    sys_write(1, s, len)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn oren_panic(msg) {
    g_panicking = 1
    print("Runtime Panic: ")
    oren_raw_print_str(msg)
    if g_debug_info != 0 {
        stack_trace_debug()
    } else {
        stack_trace()
    }
    exit(1)
    return 0
}

// --- First-class functions (native backend) ---
//
// Representation (tracked allocation kind=6):
//   [0] code_ptr (u64)  - entrypoint taking (env, args_list)
//   [8] env_ptr  (u64)  - closure environment (typically a list), or 0
fn oren_func(code_ptr, env_ptr) {
    if code_ptr == 0 { return 0 }
    var obj = malloc(16)
    if obj == 0 { exit(320) }
    ptr_set(obj, code_ptr)
    ptr_set(obj + 8, env_ptr)
    // Update kind to 6 (FUNC) so GC can traverse env_ptr.
    var node = oren_find_node(obj)
    if node != 0 {
        ptr_set(node + 16, 6)
    }
    return obj
}

// Spawn a callable object with an args list.
//
// This is the syscall-first native analogue of the C backend's spawn-callable helper.
// It returns the same handle layout expected by `oren_join(handle)`:
//   0: pid (u64)
//   8: read_fd (u64)
fn oren_spawn_call_list(fn_obj, args_list) {
    var pipe_buf = malloc(16)
    if pipe_buf == 0 { exit(321) }
    var rv = sys_pipe(pipe_buf)
    if rv != 0 { exit(322) }

    var rfd = ptr_get(pipe_buf)
    var wfd = ptr_get(pipe_buf + 8)

    var pid = sys_fork()
    if pid == 0 {
        // Child
        sys_close(rfd)
        var ret = oren_call_obj_list(fn_obj, args_list)
        var out = malloc(8)
        if out == 0 { exit(323) }
        ptr_set(out, ret)
        sys_write(wfd, out, 8)
        sys_close(wfd)
        exit(0)
        return 0
    }

    // Parent
    sys_close(wfd)

    var handle = malloc(16)
    if handle == 0 { exit(324) }
    ptr_set(handle, pid)
    ptr_set(handle + 8, rfd)
    return handle
}

// ... existing code ...

// Centralized struct allocation hook (uses the compiler's special-cased malloc).
fn oren_alloc_struct(size) {
    var ptr = malloc(size)
    // Update kind to 4 (STRUCT)
    var node = oren_find_node(ptr)
    if node != 0 {
        ptr_set(node + 16, 4)
    }
    return ptr
}

fn oren_free_struct(ptr) {
    // Best-effort explicit free for large struct buffers.
    // (Allocator is bump-based; `free` marks the node as freed so GC can reclaim metadata.)
    return free(ptr)
}

fn strcmp(s1, s2) {
    var i = 0
    while 1 {
        var b1 = ptr_get_byte(s1 + i)
        var b2 = ptr_get_byte(s2 + i)
        if b1 == 0 {
            if b2 == 0 { return 0 }
            return -1
        }
        if b2 == 0 { return 1 }
        if b1 < b2 { return -1 }
        if b1 > b2 { return 1 }
        i = i + 1
    }
    return 0
}

fn oren_add(a, b) {
    var na = oren_find_node(a)
    if na != 0 {
        var nb = oren_find_node(b)
        if nb != 0 {
            var ka = ptr_get(iadd(na, 16))
            var kb = ptr_get(iadd(nb, 16))
            if ka == 1 { // STRING
                if kb == 1 {
                    return string_concat(a, b)
                }
            }
        }
    }
    return iadd(a, b)
}

fn oren_int_to_string(n) {
    var buf = malloc(32)
    if buf == 0 { exit(300) }
    var i = 0
    var neg = 0
    if n < 0 {
        neg = 1
        n = -n
    }
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        while n > 0 {
            var digit = n - (n / 10) * 10
            ptr_set_byte(buf + i, 48 + digit)
            i = i + 1
            n = n / 10
        }
        if neg == 1 {
            ptr_set_byte(buf + i, 45)
            i = i + 1
        }
        // reverse
        var s = 0
        var e = i - 1
        while s < e {
            var t = ptr_get_byte(buf + s)
            ptr_set_byte(buf + s, ptr_get_byte(buf + e))
            ptr_set_byte(buf + e, t)
            s = s + 1
            e = e - 1
        }
    }
    ptr_set_byte(buf + i, 0) // null term
    oren_track_alloc(buf, 32, 1) // 1=STRING
    return buf
}

// --- Printing ---
fn print_int_no_nl(n) {
    var buf = malloc(32)
    if buf == 0 { exit(300) }
    var i = 0
    var neg = 0
    if n < 0 {
        neg = 1
        n = -n
    }
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        while n > 0 {
            var digit = n - (n / 10) * 10
            ptr_set_byte(buf + i, 48 + digit)
            i = i + 1
            n = n / 10
        }
        if neg == 1 {
            ptr_set_byte(buf + i, 45)
            i = i + 1
        }
        // reverse
        var s = 0
        var e = i - 1
        while s < e {
            var t = ptr_get_byte(buf + s)
            ptr_set_byte(buf + s, ptr_get_byte(buf + e))
            ptr_set_byte(buf + e, t)
            s = s + 1
            e = e - 1
        }
    }
    sys_write(1, buf, i)
    return 0
}

fn print_int(n) {
    print_int_no_nl(n)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn oren_print_any_no_nl(val) {
    var node = oren_find_node(val)
    if node != 0 {
        var kind = ptr_get(node + 16)
        if kind == 1 { // STRING
            var len = oren_string_len(val)
            sys_write(1, val, len)
            return 0
        }
    }
    print_int_no_nl(val)
    return 0
}

fn oren_print_fmt(fmt, args) {
    // fmt is string ptr, args is list ptr
    var len = oren_string_len(fmt)
    var i = 0
    var arg_idx = 0
    var arg_count = 0
    if args != 0 { arg_count = oren_list_len(args) }
    
    while i < len {
        var c = ptr_get_byte(fmt + i)
        if c == 123 { // '{'
            if i + 1 < len {
                if ptr_get_byte(fmt + i + 1) == 125 { // '}'
                    if arg_idx < arg_count {
                        var val = oren_list_get(args, arg_idx)
                        oren_print_any_no_nl(val)
                        arg_idx = arg_idx + 1
                    } else {
                        // Print {}
                        sys_write(1, fmt + i, 2)
                    }
                    i = i + 2
                } else {
                    sys_write(1, fmt + i, 1)
                    i = i + 1
                }
            } else {
                sys_write(1, fmt + i, 1)
                i = i + 1
            }
        } else {
            sys_write(1, fmt + i, 1)
            i = i + 1
        }
    }
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn print_bytes(ptr, len) {
    sys_write(1, ptr, len)
}

fn oren_print(v) {
    oren_print_any_no_nl(v)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn list_magic() { return 1279870019 } // 'LIST'
fn map_magic() { return 1296121168 } // 'MAP\0' (rolling; used only for type discrimination in native runtime)

fn oren_new_map(cap) {
    // Layout:
    //   [cap][count][magic][reserved] then entries:
    //   entry i: [key_ptr][value]
    // This gives the native runtime a reliable discriminator between map pointers and
    // string pointers (which are otherwise both raw addresses).
    var size = 32 + cap * 16
    var m = malloc(size)
    if m == 0 {
        print("MALLOC ZERO")
        exit(1)
    }
    if m == -1 {
        print("MALLOC FAILED")
        exit(1)
    }
    ptr_set(m, cap)
    ptr_set(m + 8, 0)
    ptr_set(m + 16, map_magic())
    ptr_set(m + 24, 0)
    oren_track_alloc(m, size, 0)
    // Mark map header kind for GC traversal (kind=3 => MAP).
    var node = oren_find_node(m)
    if node != 0 { ptr_set(iadd(node, 16), 3) }
    return m
}

fn oren_map_set(m, k, v) {
    // stack_trace()
    if m == 0 { exit(110) }
    if m < 4096 { exit(111) }
    if k == 0 { exit(112) }
    // if m > 4096 { exit(12) } 
    if ptr_get(m + 16) != map_magic() { exit(113) }
    
    var cap = ptr_get(m)
    var count = ptr_get(m + 8)
    if cap <= 0 {
        cap = 1024
        ptr_set(m, cap)
    }
    if count < 0 {
        count = 0
        ptr_set(m + 8, 0)
    }
    if count > cap {
        count = cap
        ptr_set(m + 8, cap)
    }
    var i = 0
    var base = m + 32
    if base < 4096 { exit(115) }
    while i < count {
        var kp = ptr_get(base + i * 16)
        if strcmp(kp, k) == 0 {
            ptr_set(base + i * 16 + 8, v)
            return m
        }
        i = i + 1
    }
    if count >= cap {
        exit(99)
    }

    // Deterministic ordered maps (rolling): keep keys sorted by strcmp (ascending).
    // Keys are assumed to be string pointers; do not use non-string keys in v0.
    var insert_at = 0
    while insert_at < count {
        var ek = ptr_get(base + insert_at * 16)
        if strcmp(ek, k) > 0 { break }
        insert_at = insert_at + 1
    }

    // Shift entries right to make space.
    var j = count
    while j > insert_at {
        var from = base + (j - 1) * 16
        var to = base + j * 16
        ptr_set(to + 0, ptr_get(from + 0))
        ptr_set(to + 8, ptr_get(from + 8))
        j = j - 1
    }

    ptr_set(base + insert_at * 16, k)
    ptr_set(base + insert_at * 16 + 8, v)
    ptr_set(m + 8, count + 1)
    return m
}

fn oren_map_get(m, k) {
    if m == 0 { return 0 }
    if ptr_get(m + 16) != map_magic() { return 0 }
    var count = ptr_get(m + 8)
    var i = 0
    var base = m + 32
    while i < count {
        var kp = ptr_get(base + i * 16)
        if strcmp(kp, k) == 0 {
            return ptr_get(base + i * 16 + 8)
        }
        i = i + 1
    }
    return 0
}

fn oren_map_len(m) {
    if m == 0 { return 0 }
    if ptr_get(m + 16) != map_magic() { return 0 }
    return ptr_get(m + 8)
}

fn oren_map_key_at(m, idx) {
    if m == 0 { return 0 }
    if ptr_get(m + 16) != map_magic() { return 0 }
    var count = ptr_get(m + 8)
    if idx < 0 { return 0 }
    if idx >= count { return 0 }
    var base = m + 32
    return ptr_get(base + idx * 16)
}

// --- Structured errors (rolling, portable) ---
// Convention matches C/AVM:
//   error = map {"__err": true, "code": int, "msg": string}
//
// NOTE: in native v0, `nil/false/0` collapse to 0 in some contexts. This convention
// uses a tagged map pointer (map_magic) so `oren_is_err` can discriminate reliably.
fn oren_err(code, msg) {
    var m = oren_new_map(8)
    oren_map_set(m, "__err", 1)
    oren_map_set(m, "code", code)
    oren_map_set(m, "msg", msg)
    return m
}

fn oren_is_err(v) {
    if v == 0 { return 0 }
    if v < 4096 { return 0 }
    if ptr_get(v + 16) != map_magic() { return 0 }
    var marker = oren_map_get(v, "__err")
    if marker == 0 { return 0 }
    return 1
}

fn oren_err_code(v) {
    if oren_is_err(v) == 0 { return -1 }
    return oren_map_get(v, "code")
}

fn oren_err_msg(v) {
    if oren_is_err(v) == 0 { return 0 }
    return oren_map_get(v, "msg")
}

// --- Strings ---
fn oren_string_len(s) {
    if s == 0 { return 0 }
    var i = 0
    while ptr_get_byte(iadd(s, i)) != 0 {
        i = i + 1
    }
    return i
}

fn oren_string_char_at(s, idx) {
    if s == 0 { oren_panic("char_at expects string") }
    var len = oren_string_len(s)
    if idx < 0 || idx >= len {
        oren_panic("char_at index out of range")
    }
    var out = malloc(2)
    if out == 0 { oren_panic("malloc failed") }
    ptr_set_byte(out + 0, ptr_get_byte(iadd(s, idx)))
    ptr_set_byte(out + 1, 0)
    oren_track_alloc(out, 2, 1)
    return out
}

// Slice a C-string into a newly allocated, NUL-terminated string.
// Semantics match the C-backend helper: out-of-range clamps, empty slice returns "".
fn oren_string_slice(s, start, end) {
    if s == 0 { return 0 }
    var len = oren_string_len(s)
    var i = start
    var j = end
    if i < 0 { i = 0 }
    if j < 0 { j = 0 }
    if i > len { i = len }
    if j > len { j = len }
    if i >= j {
        // Return empty string (stable allocation).
        var out0 = malloc(1)
        if out0 == 0 { return 0 }
        ptr_set_byte(out0, 0)
        oren_track_alloc(out0, 1, 1)
        return out0
    }
    var n = j - i
    var out = malloc(n + 1)
    if out == 0 { return 0 }
    var k = 0
    while k < n {
        ptr_set_byte(out + k, ptr_get_byte(s + i + k))
        k = k + 1
    }
    ptr_set_byte(out + n, 0)
    oren_track_alloc(out, n + 1, 1)
    return out
}

// Parse a non-negative decimal integer from a C-string (best-effort).
// Returns -1 on invalid input.
fn oren_int_from_string(s) {
    if s == 0 { return -1 }
    var i = 0
    var v = 0
    var any = 0
    while 1 {
        var c = ptr_get_byte(s + i)
        if c == 0 { break }
        if c < 48 { return -1 }
        if c > 57 { return -1 }
        any = 1
        v = v * 10 + (c - 48)
        i = i + 1
        if i > 32 { return -1 } // bound
    }
    if any == 0 { return -1 }
    return v
}

// --- Iteration (generic `for x in ...`) ---
// Iterator contract:
//   oren_iter_next(container, idx) -> [ok, value]
// Where ok is 1 when value exists, 0 when iteration is complete.
//
// Native backend note:
// - Lists and maps are heap objects with magic tags.
// - Strings are raw pointers (C strings); iteration stops at NUL byte.
// - "bytes" in native v0 is typically `list<int 0..255>` (from `oren_read_bytes`).
fn oren_iter_next(container, idx) {
    // Compute result first, then allocate the return list last.
    // This avoids reliance on any particular native backend local/param storage strategy.
    var ok = 0
    var val = 0

    // Prevent accidental deref of small integers/null in rolling native mode.
    // (This is a safety guard; iterating non-containers is still a logic error.)
    if container >= 4096 {
        // List: yield elements.
        if container != 0 {
            if ptr_get(container + 24) == list_magic() {
                var count = ptr_get(container)
                if idx >= 0 {
                    if idx < count {
                        ok = 1
                        // Use the well-tested list accessor to avoid relying on raw buffer math here.
                        val = oren_list_get(container, idx)
                    }
                }
            } else {
                // Map: yield keys in deterministic order (stored sorted).
                if ptr_get(container + 16) == map_magic() {
                    var count2 = ptr_get(container + 8)
                    if idx >= 0 {
                        if idx < count2 {
                            ok = 1
                            val = oren_map_key_at(container, idx)
                        }
                    }
                } else {
                    // String: yield byte codepoints until NUL terminator.
                    if idx >= 0 {
                        var ch = ptr_get_byte(iadd(container, idx))
                        if ch != 0 {
                            ok = 1
                            val = ch
                        }
                    }
                }
            }
        }
    }

    // NOTE (rolling native backend):
    // Construct the `[ok, value]` pair by directly writing into the list buffer.
    var out = oren_new_list(2)
    var out_buf = ptr_get(out + 16)
    ptr_set(out, 2) // count
    ptr_set(out_buf + 0, ok)
    ptr_set(out_buf + 8, val)
    return out
}

// Return a freshly allocated byte buffer (list) from a string literal pointer.
fn oren_bytes_from_string_ptr(s_ptr) {
    var len = oren_string_len(s_ptr)
    var lst = oren_new_list(len)
    var i = 0
    while i < len {
        var b = ptr_get_byte(s_ptr + i)
        oren_list_push(lst, b)
        i = i + 1
    }
    return lst
}

// Public wrapper (portable name used by stdlib/compiler):
// Build a byte list from a string pointer.
fn oren_bytes_from_string(s) {
    return oren_bytes_from_string_ptr(s)
}

// Build a string (NUL-terminated) from a list<int 0..255>.
// This is the inverse of `oren_bytes_from_string(...)` in other backends.
fn oren_string_from_bytes(bytes) {
    if bytes == 0 { return 0 }
    var n = oren_list_len(bytes)
    if n < 0 { return 0 }
    var out = malloc(n + 1)
    if out == 0 { return 0 }
    var i = 0
    while i < n {
        var b = oren_list_get(bytes, i)
        // Best-effort clamp for rolling native mode.
        if b < 0 { b = 0 }
        if b > 255 { b = 255 }
        ptr_set_byte(out + i, b)
        i = i + 1
    }
    ptr_set_byte(out + n, 0)
    oren_track_alloc(out, n + 1, 1) // 1=STRING
    return out
}

fn string_concat(a, b) {
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    var buf = malloc(la + lb + 1)
    if buf == 0 { exit(301) }
    
    var i = 0
    while i < la {
        ptr_set_byte(buf + i, ptr_get_byte(a + i))
        i = i + 1
    }
    
    var j = 0
    while j < lb {
        ptr_set_byte(buf + la + j, ptr_get_byte(b + j))
        j = j + 1
    }
    ptr_set_byte(buf + la + lb, 0)
    oren_track_alloc(buf, la + lb + 1, 1)
    return buf
}

// --- Lists ---
// Layout: [count][capacity][buffer_ptr][magic]
fn oren_new_list(cap) {
    if cap < 0 { cap = 0 }
    var header = malloc(32)
    if header == 0 { exit(200) }
    if header == -1 { exit(200) }
    oren_track_alloc(header, 32, 0)
    var buf = 0
    if cap > 0 {
        buf = malloc(cap * 8)
        if buf == 0 { exit(201) }
        if buf == -1 { exit(201) }
        oren_track_alloc(buf, cap * 8, 0)
    }
    ptr_set(header, 0)      // count
    ptr_set(header + 8, cap) // capacity
    ptr_set(header + 16, buf) // data buffer
    ptr_set(header + 24, list_magic())
    // Mark list header kind for GC traversal (kind=2 => LIST).
    var node = oren_find_node(header)
    if node != 0 { ptr_set(iadd(node, 16), 2) }
    return header
}

fn oren_list_len(list) {
    if list == 0 { return 0 }
    if ptr_get(list + 24) != list_magic() { exit(205) }
    return ptr_get(list)
}

fn oren_list_push(list, value) {
    if list == 0 { exit(210) }
    if ptr_get(list + 24) != list_magic() { exit(206) }
    var count = ptr_get(list)
    var cap = ptr_get(list + 8)
    var buf = ptr_get(list + 16)
    if count >= cap {
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        var new_buf = malloc(new_cap * 8)
        if new_buf == 0 { exit(211) }
        if new_buf == -1 { exit(211) }
        oren_track_alloc(new_buf, new_cap * 8, 0)
        var i = 0
        while i < count {
            ptr_set(new_buf + i * 8, ptr_get(buf + i * 8))
            i = i + 1
        }
        buf = new_buf
        cap = new_cap
        ptr_set(list + 8, cap)
        ptr_set(list + 16, buf)
    }
    ptr_set(buf + count * 8, value)
    ptr_set(list, count + 1)
    return list
}

fn oren_list_get(list, idx) {
    if list == 0 { exit(220) }
    if ptr_get(list + 24) != list_magic() {
        // Not a list, try map get
        return oren_map_get(list, idx)
    }
    var count = ptr_get(list)
    if idx < 0 { 
        oren_panic("Index out of bounds (negative)")
        return 0
    }
    if idx >= count { 
        oren_panic("Index out of bounds")
        return 0
    }
    var buf = ptr_get(list + 16)
    return ptr_get(buf + idx * 8)
}

// Set list element in-bounds (does not grow). Returns the written value.
fn oren_list_set(list, idx, value) {
    if list == 0 { oren_panic("list_set on nil") }
    if ptr_get(list + 24) != list_magic() { oren_panic("list_set on non-list") }
    var count = ptr_get(list)
    if idx < 0 { oren_panic("Index out of bounds (negative)") }
    if idx >= count { oren_panic("Index out of bounds") }
    var buf = ptr_get(list + 16)
    if buf == 0 { oren_panic("list buffer is nil") }
    ptr_set(buf + idx * 8, value)
    return value
}

// --- Byte-order helpers (network parsing / serialization) ---
//
// In native v0, "bytes" are typically `list<int 0..255>`.
// These helpers are deterministic and libc-free.

fn oren_bytes_get_u8(bytes, idx) {
    var v = oren_list_get(bytes, idx)
    if v < 0 || v > 255 { oren_panic("byte out of range") }
    return v
}

fn oren_bytes_set_u8(bytes, idx, v) {
    if v < 0 || v > 255 { oren_panic("byte out of range") }
    return oren_list_set(bytes, idx, v)
}

fn oren_bytes_get_u16_be(bytes, idx) {
    var b0 = oren_bytes_get_u8(bytes, idx)
    var b1 = oren_bytes_get_u8(bytes, idx + 1)
    return (b0 << 8) | b1
}

fn oren_bytes_get_u16_le(bytes, idx) {
    var b0 = oren_bytes_get_u8(bytes, idx)
    var b1 = oren_bytes_get_u8(bytes, idx + 1)
    return (b1 << 8) | b0
}

fn oren_bytes_get_i16_be(bytes, idx) {
    var u = oren_bytes_get_u16_be(bytes, idx)
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_bytes_get_i16_le(bytes, idx) {
    var u = oren_bytes_get_u16_le(bytes, idx)
    if u >= 32768 { return u - 65536 }
    return u
}

// Endian-aware writes (masking / truncating semantics; no allocation).
// These write the low N bits of `v` into `bytes` and return the canonical value.

fn oren_bytes_set_u16_be(bytes, idx, v) {
    var u = v & 65535
    oren_bytes_set_u8(bytes, idx, (u >> 8) & 255)
    oren_bytes_set_u8(bytes, idx + 1, u & 255)
    return u
}

fn oren_bytes_set_u16_le(bytes, idx, v) {
    var u = v & 65535
    oren_bytes_set_u8(bytes, idx, u & 255)
    oren_bytes_set_u8(bytes, idx + 1, (u >> 8) & 255)
    return u
}

fn oren_bytes_set_i16_be(bytes, idx, v) {
    var u = v & 65535
    oren_bytes_set_u8(bytes, idx, (u >> 8) & 255)
    oren_bytes_set_u8(bytes, idx + 1, u & 255)
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_bytes_set_i16_le(bytes, idx, v) {
    var u = v & 65535
    oren_bytes_set_u8(bytes, idx, u & 255)
    oren_bytes_set_u8(bytes, idx + 1, (u >> 8) & 255)
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_bytes_put_u16_be(bytes, idx, v) {
    if v < 0 || v > 65535 { oren_panic("u16 out of range") }
    oren_bytes_set_u8(bytes, idx, (v >> 8) & 255)
    oren_bytes_set_u8(bytes, idx + 1, v & 255)
    return bytes
}

fn oren_bytes_put_u16_le(bytes, idx, v) {
    if v < 0 || v > 65535 { oren_panic("u16 out of range") }
    oren_bytes_set_u8(bytes, idx, v & 255)
    oren_bytes_set_u8(bytes, idx + 1, (v >> 8) & 255)
    return bytes
}

fn oren_bytes_get_u32_be(bytes, idx) {
    var b0 = oren_bytes_get_u8(bytes, idx)
    var b1 = oren_bytes_get_u8(bytes, idx + 1)
    var b2 = oren_bytes_get_u8(bytes, idx + 2)
    var b3 = oren_bytes_get_u8(bytes, idx + 3)
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

fn oren_bytes_get_u32_le(bytes, idx) {
    var b0 = oren_bytes_get_u8(bytes, idx)
    var b1 = oren_bytes_get_u8(bytes, idx + 1)
    var b2 = oren_bytes_get_u8(bytes, idx + 2)
    var b3 = oren_bytes_get_u8(bytes, idx + 3)
    return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0
}

fn oren_bytes_get_i32_be(bytes, idx) {
    var u = oren_bytes_get_u32_be(bytes, idx)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_bytes_get_i32_le(bytes, idx) {
    var u = oren_bytes_get_u32_le(bytes, idx)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_bytes_set_u32_be(bytes, idx, v) {
    var u = v & 4294967295
    oren_bytes_set_u8(bytes, idx, (u >> 24) & 255)
    oren_bytes_set_u8(bytes, idx + 1, (u >> 16) & 255)
    oren_bytes_set_u8(bytes, idx + 2, (u >> 8) & 255)
    oren_bytes_set_u8(bytes, idx + 3, u & 255)
    return u
}

fn oren_bytes_set_u32_le(bytes, idx, v) {
    var u = v & 4294967295
    oren_bytes_set_u8(bytes, idx, u & 255)
    oren_bytes_set_u8(bytes, idx + 1, (u >> 8) & 255)
    oren_bytes_set_u8(bytes, idx + 2, (u >> 16) & 255)
    oren_bytes_set_u8(bytes, idx + 3, (u >> 24) & 255)
    return u
}

fn oren_bytes_set_i32_be(bytes, idx, v) {
    var u = v & 4294967295
    oren_bytes_set_u8(bytes, idx, (u >> 24) & 255)
    oren_bytes_set_u8(bytes, idx + 1, (u >> 16) & 255)
    oren_bytes_set_u8(bytes, idx + 2, (u >> 8) & 255)
    oren_bytes_set_u8(bytes, idx + 3, u & 255)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_bytes_set_i32_le(bytes, idx, v) {
    var u = v & 4294967295
    oren_bytes_set_u8(bytes, idx, u & 255)
    oren_bytes_set_u8(bytes, idx + 1, (u >> 8) & 255)
    oren_bytes_set_u8(bytes, idx + 2, (u >> 16) & 255)
    oren_bytes_set_u8(bytes, idx + 3, (u >> 24) & 255)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_bytes_put_u32_be(bytes, idx, v) {
    if v < 0 || v > 4294967295 { oren_panic("u32 out of range") }
    oren_bytes_set_u8(bytes, idx, (v >> 24) & 255)
    oren_bytes_set_u8(bytes, idx + 1, (v >> 16) & 255)
    oren_bytes_set_u8(bytes, idx + 2, (v >> 8) & 255)
    oren_bytes_set_u8(bytes, idx + 3, v & 255)
    return bytes
}

fn oren_bytes_put_u32_le(bytes, idx, v) {
    if v < 0 || v > 4294967295 { oren_panic("u32 out of range") }
    oren_bytes_set_u8(bytes, idx, v & 255)
    oren_bytes_set_u8(bytes, idx + 1, (v >> 8) & 255)
    oren_bytes_set_u8(bytes, idx + 2, (v >> 16) & 255)
    oren_bytes_set_u8(bytes, idx + 3, (v >> 24) & 255)
    return bytes
}

// Minimal index_set for lists; maps still use oren_map_set directly.
fn oren_index_set(container, index, value) {
    if container == 0 { exit(230) }
    // Detect list by magic tag.
    if ptr_get(container + 24) == list_magic() {
        var buf = ptr_get(container + 16)
        var count = ptr_get(container)
        var cap = ptr_get(container + 8)
        if index < 0 { exit(231) }
        if index >= cap {
            var new_cap = cap
            if new_cap == 0 { new_cap = index + 1 }
            while new_cap <= index { new_cap = new_cap * 2 }
            var new_buf = malloc(new_cap * 8)
            oren_track_alloc(new_buf, new_cap * 8, 0)
            var i = 0
            while i < count {
                ptr_set(new_buf + i * 8, ptr_get(buf + i * 8))
                i = i + 1
            }
            buf = new_buf
            cap = new_cap
            ptr_set(container + 8, cap)
            ptr_set(container + 16, buf)
        }
        if index >= count {
            // zero-fill new slots
            var i2 = count
            while i2 <= index {
                ptr_set(buf + i2 * 8, 0)
                i2 = i2 + 1
            }
            ptr_set(container, index + 1)
        }
        ptr_set(buf + index * 8, value)
        return value
    }
    // Fallback: behave like map set
    return oren_map_set(container, index, value)
}

// --- Args ---
fn oren_args() {
    var argc = global_get_argc()
    var argv = global_get_argv()
    if argc <= 0 { return oren_new_list(0) }
    if argv == 0 { return oren_new_list(0) }

    var out = oren_new_list(argc)
    var i = 0
    while i < argc {
        var s = ptr_get(argv + i * 8)
        oren_list_push(out, s)
        i = i + 1
    }
    return out
}

// --- Binary I/O (byte-accurate) ---
// Note: implemented via syscalls (see codegen intrinsics for sys_open/sys_read/sys_write/sys_close).

@cap.requires(domain="FS")
fn oren_write_bytes(path, bytes) {
    native_capsule_require(CAP_FS, "FS")
    var fd = sys_open(path, 1537, 420) // O_WRONLY|O_CREAT|O_TRUNC, 0644
    if fd < 0 { exit(260) }

    var n = oren_list_len(bytes)
    if n > 0 {
        var buf = malloc(n)
        if buf == 0 { exit(261) }
        var i = 0
        while i < n {
            // bytes[i] is an int 0..255
            var v = bytes[i]
            if v < 0 { sys_close(fd); exit(264) }
            if v > 255 { sys_close(fd); exit(265) }
            ptr_set_byte(buf + i, v)
            i = i + 1
        }
        // Handle short writes and propagate errno deterministically.
        var off = 0
        while off < n {
            var wn = sys_write(fd, buf + off, n - off)
            if wn < 0 { sys_close(fd); exit(266) }
            if wn == 0 { sys_close(fd); exit(267) } // can't make progress
            off = off + wn
        }
        free(buf)
    }

    var crc = sys_close(fd)
    if crc < 0 { exit(268) }
    return 0
}

@cap.requires(domain="FS")
fn oren_read_bytes(path) {
    native_capsule_require(CAP_FS, "FS")
    var fd = sys_open(path, 0, 0) // O_RDONLY
    if fd < 0 { exit(262) }

    var out = oren_new_list(0)
    var buf = malloc(4096)
    if buf == 0 { exit(263) }

    while 1 {
        var rn = sys_read(fd, buf, 4096)
        if rn == 0 { break } // EOF
        if rn < 0 { sys_close(fd); exit(269) } // errno propagated by syscall lowering
        var i = 0
        while i < rn {
            oren_list_push(out, ptr_get_byte(buf + i))
            i = i + 1
        }
    }

    free(buf)
    var crc = sys_close(fd)
    if crc < 0 { exit(270) }
    return out
}

// --- TCP/IP (syscall-first) ---
// Notes:
// - macOS/BSD socket structs are built manually (byte-by-byte) without libc.
// - All potentially-blocking operations use kqueue/kevent with a caller-provided timeout.
// - Return convention: functions return fd/nbytes on success, or negative errno on failure.
//
// IMPORTANT (rolling): avoid relying on initialized global integer vars for numeric constants.
// Use numeric literals inside the functions to keep behavior robust during bootstrap.

fn oren_tcp_parse_ipv4_into(ip, out4_ptr) {
    if ip == 0 { return 0 }
    if out4_ptr == 0 { return 0 }

    var part = 0
    var acc = 0
    var digits = 0
    var i = 0
    while 1 {
        var ch = ptr_get_byte(ip + i)
        if ch == 0 { break }
        if ch >= 48 {
            if ch <= 57 {
                acc = acc * 10 + (ch - 48)
                if acc > 255 { return 0 }
                digits = digits + 1
            } else {
                return 0
            }
        } else {
            if ch == 46 {
                if digits == 0 { return 0 }
                if part >= 3 { return 0 }
                ptr_set_byte(out4_ptr + part, acc)
                part = part + 1
                acc = 0
                digits = 0
            } else {
                return 0
            }
        }
        i = i + 1
    }

    if part != 3 { return 0 }
    if digits == 0 { return 0 }
    ptr_set_byte(out4_ptr + 3, acc)
    return 1
}

fn oren_tcp_sockaddr_in(ip, port) {
    // struct sockaddr_in (BSD):
    //   u8  sin_len
    //   u8  sin_family
    //   u16 sin_port (big-endian)
    //   u32 sin_addr (bytes)
    //   u8  sin_zero[8]
    var sa = malloc(16)
    if sa == 0 { return 0 }
    if sa == -1 { return 0 }
    oren_track_alloc(sa, 16, 0)

    // zero-fill
    var zi = 0
    while zi < 16 {
        ptr_set_byte(sa + zi, 0)
        zi = zi + 1
    }

    ptr_set_byte(sa + 0, 16) // len
    ptr_set_byte(sa + 1, 2) // AF_INET
    // port in network order
    var hi = (port >> 8) & 255
    var lo = port & 255
    ptr_set_byte(sa + 2, hi)
    ptr_set_byte(sa + 3, lo)

    // address bytes
    if ip == 0 {
        // default: 127.0.0.1
        ptr_set_byte(sa + 4, 127)
        ptr_set_byte(sa + 5, 0)
        ptr_set_byte(sa + 6, 0)
        ptr_set_byte(sa + 7, 1)
    } else {
        var ok = oren_tcp_parse_ipv4_into(ip, sa + 4)
        if ok == 0 { return 0 }
    }

    return sa
}

@cap.requires(domain="NET")
fn oren_tcp_set_nonblock(fd) {
    native_capsule_require(CAP_NET, "NET")
    var flags = sys_fcntl(fd, 3, 0) // F_GETFL
    if flags < 0 { return flags }
    var r = sys_fcntl(fd, 4, flags | 4) // F_SETFL, O_NONBLOCK
    return r
}

@cap.requires(domain="NET")
fn oren_tcp_wait_kqueue(fd, filter, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    // Returns 1 if ready, 0 if timed out, or negative errno.
    if timeout_ms < 0 { timeout_ms = 0 }
    var kq = sys_kqueue()
    if kq < 0 { return kq }

    var change = malloc(32)
    if change == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(change, 32, 0)
    var ev = malloc(32)
    if ev == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(ev, 32, 0)

    // Zero-fill the kevent structs (malloc does not promise zeroed memory).
    var zi = 0
    while zi < 32 {
        ptr_set_byte(change + zi, 0)
        ptr_set_byte(ev + zi, 0)
        zi = zi + 1
    }

    // struct kevent:
    // ident (u64) @0
    // filter (i16) @8
    // flags (u16)  @10
    // fflags (u32) @12
    // data (i64)   @16
    // udata (ptr)  @24
    ptr_set(change + 0, fd)
    ptr_set_byte(change + 8, filter & 255)
    ptr_set_byte(change + 9, (filter >> 8) & 255)
    var kflags = 1 | 4 | 16 // EV_ADD | EV_ENABLE | EV_ONESHOT
    ptr_set_byte(change + 10, kflags & 255)
    ptr_set_byte(change + 11, (kflags >> 8) & 255)
    ptr_set(change + 16, 0)
    ptr_set(change + 24, 0)

    // timespec*
    var ts = 0
    ts = malloc(16)
    if ts == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(ts, 16, 0)
    var sec = timeout_ms / 1000
    var nsec = (timeout_ms - sec * 1000) * 1000000
    ptr_set(ts + 0, sec)
    ptr_set(ts + 8, nsec)

    var n = sys_kevent(kq, change, 1, ev, 1, ts)
    sys_close(kq)
    // Avoid leaking temporaries; free() is deterministic and reuses blocks.
    free(change)
    free(ev)
    free(ts)
    return n
}

@cap.requires(domain="NET")
fn oren_tcp_connect(ip, port, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    var fd = sys_socket(2, 1, 6) // AF_INET, SOCK_STREAM, IPPROTO_TCP
    if fd < 0 { return fd }

    // Non-blocking + explicit wait for connect completion.
    var nb = oren_tcp_set_nonblock(fd)
    if nb < 0 {
        sys_close(fd)
        return nb
    }

    var sa = oren_tcp_sockaddr_in(ip, port)
    if sa == 0 {
        sys_close(fd)
        return 0 - 22 // EINVAL
    }

    var rc = sys_connect(fd, sa, 16)
    free(sa)
    if rc == 0 { return fd }
    if rc != 0 - 36 { // EINPROGRESS
        sys_close(fd)
        return rc
    }

    var n = oren_tcp_wait_kqueue(fd, -2, timeout_ms) // EVFILT_WRITE
    if n == 0 {
        sys_close(fd)
        return 0 - 60 // ETIMEDOUT
    }
    if n < 0 {
        sys_close(fd)
        return n
    }

    // Check SO_ERROR to determine connect result.
    var soerr_buf = malloc(8)
    if soerr_buf == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(soerr_buf, 8, 0)
    ptr_set(soerr_buf, 0)
    var olen = malloc(8)
    if olen == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(olen, 8, 0)
    ptr_set(olen, 4)

    var grc = sys_getsockopt(fd, 65535, 4103, soerr_buf, olen) // SOL_SOCKET, SO_ERROR
    if grc < 0 {
        free(soerr_buf)
        free(olen)
        sys_close(fd)
        return grc
    }
    var soerr = ptr_get(soerr_buf)
    free(soerr_buf)
    free(olen)
    if soerr != 0 {
        sys_close(fd)
        return 0 - soerr
    }

    return fd
}

@cap.requires(domain="NET")
fn oren_tcp_listen_local(port) {
    var fd = sys_socket(2, 1, 6) // AF_INET, SOCK_STREAM, IPPROTO_TCP
    if fd < 0 { return fd }

    // Allow quick reuse during tests.
    var one = malloc(8)
    if one == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(one, 8, 0)
    ptr_set(one, 1)
    var sroc = sys_setsockopt(fd, 65535, 4, one, 4) // SOL_SOCKET, SO_REUSEADDR
    free(one)
    if sroc < 0 {
        sys_close(fd)
        return sroc
    }

    var nb = oren_tcp_set_nonblock(fd)
    if nb < 0 {
        sys_close(fd)
        return nb
    }

    var sa = oren_tcp_sockaddr_in(0, port) // 127.0.0.1
    if sa == 0 {
        sys_close(fd)
        return 0 - 22 // EINVAL
    }

    var brc = sys_bind(fd, sa, 16)
    free(sa)
    if brc < 0 {
        sys_close(fd)
        return brc
    }

    var lrc = sys_listen(fd, 16)
    if lrc < 0 {
        sys_close(fd)
        return lrc
    }

    return fd
}

@cap.requires(domain="NET")
fn oren_tcp_accept(listen_fd, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    var n = oren_tcp_wait_kqueue(listen_fd, -1, timeout_ms) // EVFILT_READ
    if n == 0 { return 0 - 60 } // ETIMEDOUT
    if n < 0 { return n }
    return sys_accept(listen_fd, 0, 0)
}

@cap.requires(domain="NET")
fn oren_tcp_read_into(fd, buf, len, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if len <= 0 { return 0 }
    var n = oren_tcp_wait_kqueue(fd, -1, timeout_ms) // EVFILT_READ
    if n == 0 { return 0 - 60 } // ETIMEDOUT
    if n < 0 { return n }
    var r = sys_recvfrom(fd, buf, len, 0, 0, 0)
    if r == 0 - 35 { return 0 } // EAGAIN: treat as no data
    return r
}

@cap.requires(domain="NET")
fn oren_tcp_write_from(fd, buf, len, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if len <= 0 { return 0 }
    var n = oren_tcp_wait_kqueue(fd, -2, timeout_ms) // EVFILT_WRITE
    if n == 0 { return 0 - 60 } // ETIMEDOUT
    if n < 0 { return n }
    return sys_sendto(fd, buf, len, 0, 0, 0)
}

@cap.requires(domain="NET")
fn oren_tcp_close(fd) {
    native_capsule_require(CAP_NET, "NET")
    if fd < 0 { return 0 }
    // best-effort shutdown; ignore errors
    sys_shutdown(fd, 2) // SHUT_RDWR
    sys_close(fd)
    return 0
}

// --- Threads ---
@cap.requires(domain="PROC")
fn oren_system(cmd) {
    native_capsule_require(CAP_PROC, "PROC")
    return oren_system_timeout(cmd, -1)
}

fn oren_system_timeout(cmd, timeout_ms) {
    // Syscall-first `system(3)` equivalent with an optional timeout.
    // - timeout_ms < 0: wait forever (system-like)
    // - timeout_ms >= 0: poll wait4(WNOHANG) and kill child on timeout
    //
    // Returns wait status (raw), or negative on internal failure, or -60 on timeout.
    if cmd == 0 { return -1 }

    var pid = oren_fork()
    if pid < 0 { return -1 }

    if pid == 0 {
        // Child: execve /bin/sh -c <cmd>
        var sh = "/bin/sh"
        var arg0 = "sh"
        var arg1 = "-c"

        var child_argv = malloc(32) // 4 pointers
        if child_argv == 0 { exit(127) }
        ptr_set(child_argv + 0, arg0)
        ptr_set(child_argv + 8, arg1)
        ptr_set(child_argv + 16, cmd)
        ptr_set(child_argv + 24, 0)

        // Preserve parent environment without libc.
        // Prefer the envp captured at process entry; fallback to deriving envp from argv/argc.
        var envp = global_get_envp()
        if envp == 0 {
            var argc = global_get_argc()
            var parent_argv = global_get_argv()
            if parent_argv != 0 {
                // Cap derived pointer math so a corrupted argc can't walk arbitrarily.
                if argc >= 0 && argc <= 1048576 {
                    envp = iadd(parent_argv, (iadd(argc, 1)) * 8)
                }
            }
        }
        if envp == 0 {
            envp = malloc(8) // 1 pointer (NULL-terminated)
            if envp == 0 { exit(127) }
            ptr_set(envp, 0)
        }

        sys_execve(sh, child_argv, envp)
        // If execve returns, it failed.
        exit(127)
    }

    // Parent: wait4(pid, &status, options, 0)
    var status_ptr = malloc(8)
    if status_ptr == 0 { return -1 }
    ptr_set(status_ptr, 0)

    if timeout_ms < 0 {
        var wpid = sys_wait4(pid, status_ptr, 0, 0)
        if wpid < 0 {
            free(status_ptr)
            return -1
        }
        var status = ptr_get(status_ptr)
        free(status_ptr)
        return status
    }

    // Poll: wait4(..., WNOHANG=1) + sleep(1ms) until timeout.
    var remaining = timeout_ms
    while remaining > 0 {
        var wpid2 = sys_wait4(pid, status_ptr, 1, 0) // WNOHANG
        if wpid2 == pid {
            var status2 = ptr_get(status_ptr)
            free(status_ptr)
            return status2
        }
        if wpid2 < 0 {
            free(status_ptr)
            return -1
        }
        // wpid2 == 0 => child still running
        oren_sleep_ms(1)
        remaining = remaining - 1
    }

    // Timeout: kill child and reap to avoid zombies.
    oren_kill(pid, 9) // SIGKILL
    sys_wait4(pid, status_ptr, 0, 0) // best-effort reap
    free(status_ptr)
    return 0 - 60 // ETIMEDOUT (BSD)
}

fn oren_net_get(url) {
    // Minimal HTTP/1.0 GET for native backend (macOS v0):
    // - Supports: http://<ipv4>[:port][/path]
    // - No TLS, no DNS, no chunked transfer decoding.
    if url == 0 { return 0 }

    // Require "http://"
    var prefix = "http://"
    var pl = oren_string_len(prefix)
    var ul = oren_string_len(url)
    if ul < pl { return 0 }
    var pi = 0
    while pi < pl {
        if ptr_get_byte(url + pi) != ptr_get_byte(prefix + pi) { return 0 }
        pi = pi + 1
    }

    var pos = pl
    // Find '/' for path start
    var slash = -1
    var i = pos
    while i < ul {
        if ptr_get_byte(url + i) == 47 { slash = i; break } // '/'
        i = i + 1
    }
    if slash == -1 { slash = ul }

    // Find ':' for port separator (only within host segment)
    var colon = -1
    i = pos
    while i < slash {
        if ptr_get_byte(url + i) == 58 { colon = i; break } // ':'
        i = i + 1
    }

    var host_end = slash
    if colon != -1 { host_end = colon }
    var host = oren_string_slice(url, pos, host_end)
    if host == 0 { return 0 }

    var port = 80
    if colon != -1 {
        var port_s = oren_string_slice(url, colon + 1, slash)
        var pv = oren_int_from_string(port_s)
        if pv <= 0 { return 0 }
        port = pv
    }

    var path = "/"
    if slash < ul {
        path = oren_string_slice(url, slash, ul)
        if path == 0 { return 0 }
    }

    // Connect (5s timeout)
    var fd = oren_tcp_connect(host, port, 5000)
    if fd < 0 { return 0 }

    // Build request: "GET <path> HTTP/1.0\r\nHost: <host>\r\nConnection: close\r\n\r\n"
    var r0 = string_concat("GET ", path)
    var r1 = string_concat(r0, " HTTP/1.0\r\nHost: ")
    var r2 = string_concat(r1, host)
    var r3 = string_concat(r2, "\r\nConnection: close\r\n\r\n")
    // Free intermediate concatenation buffers to avoid unbounded growth on repeated calls.
    free(r0)
    free(r1)
    free(r2)

    var req_len = oren_string_len(r3)
    var wr = oren_tcp_write_from(fd, r3, req_len, 5000)
    free(r3)
    if wr < 0 {
        oren_tcp_close(fd)
        return 0
    }

    // Read entire response into a growing buffer.
    var cap = 4096
    var used = 0
    var buf = malloc(cap)
    if buf == 0 {
        oren_tcp_close(fd)
        return 0
    }

    while 1 {
        var tmp = malloc(1024)
        if tmp == 0 { break }
        var n = oren_tcp_read_into(fd, tmp, 1024, 5000)
        if n <= 0 {
            free(tmp)
            break
        }

        // Ensure capacity for used+n
        while used + n > cap {
            var new_cap = cap * 2
            if new_cap < used + n { new_cap = used + n }
            var new_buf = malloc(new_cap)
            if new_buf == 0 { break }
            oren_memcpy(new_buf, buf, used)
            free(buf)
            buf = new_buf
            cap = new_cap
        }
        oren_memcpy(buf + used, tmp, n)
        used = used + n
        free(tmp)
    }

    oren_tcp_close(fd)

    // Find header terminator "\r\n\r\n"
    var body_off = 0
    i = 0
    while i + 3 < used {
        if ptr_get_byte(buf + i) == 13 {
            if ptr_get_byte(buf + i + 1) == 10 {
                if ptr_get_byte(buf + i + 2) == 13 {
                    if ptr_get_byte(buf + i + 3) == 10 {
                        body_off = i + 4
                        break
                    }
                }
            }
        }
        i = i + 1
    }

    if body_off < 0 { body_off = 0 }
    if body_off > used { body_off = used }

    var body_len = used - body_off
    var out = malloc(body_len + 1)
    if out == 0 {
        free(buf)
        return 0
    }
    oren_memcpy(out, buf + body_off, body_len)
    ptr_set_byte(out + body_len, 0)
    oren_track_alloc(out, body_len + 1, 1)
    free(buf)
    return out
}

fn free(ptr) {
    if ptr == 0 { return 0 }
    if oren_globals() == 0 { return 0 }
    acquire_lock()

    // Deterministic/manual-friendly free:
    // - remove from allocs list immediately
    // - push into free_blocks so future malloc() can reuse the block
    //
    // This must work even when GC scanning is disabled (`--no-gc` / OREN_NO_GC=1).
    var prev = 0
    var cur = global_get_allocs()
    while cur != 0 {
        var next = ptr_get(iadd(cur, 32))
        if ptr_get(cur) == ptr {
            if prev == 0 {
                global_set_allocs(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }
            ptr_set(iadd(cur, 24), 0) // clear freed/mark flags
            ptr_set(iadd(cur, 32), global_get_free_blocks())
            global_set_free_blocks(cur)
            release_lock()
            return 0
        }
        prev = cur
        cur = next
    }

    release_lock()
    return 0
}

fn oren_join_timeout(handle, timeout_ms) {
    if handle == 0 { return 0 }

    // Spawn handle layout (native backend, macOS v0 fork+pipe):
    // 0: pid (u64)
    // 8: read_fd (u64)

    var pid = ptr_get(handle)
    var fd = ptr_get(handle + 8)

    var buf = malloc(8)
    if buf == 0 { exit(270) }
    ptr_set(buf, 0)

    // Read exactly 8 bytes (result value) with an optional wall-time timeout.
    var got = 0

    var deadline_ns = 0
    if timeout_ms >= 0 {
        // NOTE: `oren_time_mono_raw()` is not guaranteed to be nanoseconds on macOS
        // (it can be mach_absolute_time units). For timeout math, use unix-ns.
        var start_ns = oren_time_unix_ns()
        deadline_ns = start_ns + (timeout_ms * 1000000)
    }

    while got < 8 {
        if timeout_ms >= 0 {
            var now = oren_time_unix_ns()
            var rem_ns = deadline_ns - now
            if rem_ns <= 0 {
                // Timeout: kill child and reap to avoid zombies.
                oren_kill(pid, 9) // SIGKILL
                sys_wait4(pid, 0, 0, 0) // best-effort reap
                sys_close(fd)
                free(handle)
                return 0 - 60 // ETIMEDOUT (BSD)
            }
            var wait_ms = rem_ns / 1000000
            if wait_ms < 1 { wait_ms = 1 }
            var ready = oren_tcp_wait_kqueue(fd, -1, wait_ms) // EVFILT_READ
            if ready == 0 {
                // Continue loop: re-check deadline and try again.
                continue
            }
            if ready < 0 {
                sys_close(fd)
                // Reap child (best-effort).
                sys_wait4(pid, 0, 0, 0)
                free(handle)
                return ready
            }
        }

        var n = sys_read(fd, buf + got, 8 - got)
        if n == 0 { break } // EOF
        if n < 0 {
            sys_close(fd)
            sys_wait4(pid, 0, 0, 0)
            free(handle)
            return n
        }
        got = got + n
    }

    sys_close(fd)

    // Reap child (best-effort).
    sys_wait4(pid, 0, 0, 0)

    if got != 8 {
        free(handle)
        return -1
    }

    var ret_val = ptr_get(buf)
    free(handle)
    return ret_val
}

fn oren_join(handle) {
    return oren_join_timeout(handle, -1)
}
