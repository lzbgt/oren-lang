// Capsule/capability mask bits (rolling; native backend only).
var CAP_FS = 1
var CAP_NET = 2
var CAP_PROC = 4
var CAP_ENV = 8
var CAP_TIME = 16

// Oren-level open(2) flags (rolling ABI; translated by native codegen).
//
// Design:
// - Lower 2 bits match POSIX access modes: 0=RDONLY, 1=WRONLY, 2=RDWR.
// - Higher bits are Oren-stable feature flags and must be translated to OS-specific
//   O_* bits in `arm64_native_expr_syscalls.oren` (Darwin/Linux differ).
var OREN_O_CREAT = 256
var OREN_O_TRUNC = 512
var OREN_O_NONBLOCK = 1024

// POSIX socket constants used by syscall-first runtime (no SDK headers).
// Values are stable across Darwin/Linux for IPv4 + TCP/UDP in practice.
var OREN_AF_INET = 2
// NOTE: AF_INET6 differs across Darwin/Linux:
// - macOS: 30
// - Linux: 10
// We initialize this deterministically in `native_runtime_init` based on target_os.
var OREN_AF_INET6 = 30
var OREN_AF_UNIX = 1
var OREN_SOCK_STREAM = 1
var OREN_SOCK_DGRAM = 2
var OREN_IPPROTO_TCP = 6

// Oren-level getsockopt/setsockopt constants (rolling ABI).
// These are translated to OS-specific values in the native syscall lowering layer.
var OREN_SOL_SOCKET = 1
var OREN_SO_REUSEADDR = 2
var OREN_SO_ERROR = 4

// Typed buffer tags:
// `ore_iter_next` needs BUF_TAG_U8 early to support `for x in u8_buf`.
// Keep this as a top-level constant so the native backend doesn't depend on
// global forward references (rolling parser/codegen constraint).
var BUF_TAG_U8 = 5
var BUF_TAG_I32 = 1
var BUF_TAG_I64 = 2
var BUF_TAG_F32 = 3
var BUF_TAG_F64 = 4

// Capsule per-fd kind tags (rolling; native backend only).
// Stored in `net_fd_caps_ptr` (byte-per-fd).
//
// NOTE: In rolling mode this table is shared for:
// - NET sockets (stream/listen/dgram)
// - PROC IPC fds (pipes used by spawn/join)
var FD_KIND_NONE = 0
var FD_KIND_TCP_STREAM = 1
var FD_KIND_TCP_LISTEN = 2
var FD_KIND_UDP_DGRAM = 3
var FD_KIND_PROC_PIPE = 10
var FD_KIND_KQUEUE = 20
var FD_KIND_EPOLL = 21

// NET wait backend detection (rolling):
// - macOS: kqueue/kevent is available
// - Linux: kqueue does not exist
//
// Values:
// - -1: unknown (not detected yet)
// -  0: no kqueue backend
// -  1: has kqueue backend
var g_net_has_kqueue = -1

// Native target OS (rolling):
// - 0: unknown (should not happen after runtime init)
// - 1: macOS
// - 2: Linux
var g_target_os = 0

// Linux epoll constants (stable on Linux; unused on macOS).
// Used by syscall-first NET wait to avoid libc poll/select shims.
var OREN_EPOLL_CTL_ADD = 1
var OREN_EPOLL_CTL_DEL = 2
var OREN_EPOLL_CTL_MOD = 3
var OREN_EPOLLIN = 1
var OREN_EPOLLOUT = 4

// fcntl(2) commands used for fd duplication (stable across Darwin/Linux).
// Verified via Apple SDK headers for macOS (audit only; not a build dependency).
var FCNTL_F_DUPFD = 0
var FCNTL_F_DUPFD_CLOEXEC = 67

// --- Fork hygiene (rolling; syscall-first) ---
// After fork(), the child process inherits any in-memory locks held at the moment of fork.
// Our native runtime allocator uses an in-memory lock keyed by a thread-id token.
// If a lock is held by the parent at fork time, the child must reset those lock fields
// before doing further allocations, or it can deadlock (classic "fork while locked" issue).
//
// This is not a "pthread atfork" shim; it's purely internal runtime hygiene for fork-based v0 features.
fn native_runtime_after_fork_child() {
    var g = oren_globals()
    if g == 0 { return 0 }
    // lock_owner_tid
    global_set_lock(0)
    // lock_recurse_count
    global_set_lock_count(0)
    return 0
}

fn oren_fork() {
    var pid = sys_fork()
    if pid == 0 {
        native_runtime_after_fork_child()
    }
    return pid
}

fn native_runtime_init(target_os) {
    // The native backend is still rolling and does not reliably run global initializers
    // before entering the runtime. Ensure globals used by early allocation are safe.
    g_storage = 0

    // NET wait backend probe state (must not rely on global initializers).
    g_target_os = target_os
    // Prefer target knowledge from codegen over probing syscalls at runtime.
    // This avoids unnecessary OS feature probes in tight paths and keeps behavior
    // deterministic across nested execution.
    if target_os == 1 {
        // macOS: kqueue exists
        g_net_has_kqueue = 1
    } else {
        // Linux (and any other non-macOS target): treat as no kqueue
        g_net_has_kqueue = 0
    }

    // IMPORTANT: today the native backend does not reliably run global initializers
    // before entering the runtime. Treat these as "constants" that must be set here.
    GLOBAL_SLOT_BYTES = 8
    GLOBAL_OFF_ALLOCS = 0
    GLOBAL_OFF_ROOTS = 8
    GLOBAL_OFF_LOCK_OWNER_TID = 16
    GLOBAL_OFF_FREE_NODES = 24
    GLOBAL_OFF_THREADS = 32
    GLOBAL_OFF_ARGC = 40
    GLOBAL_OFF_ARGV = 48
    GLOBAL_OFF_LOCK_RECURSE_COUNT = 56
    GLOBAL_OFF_ENVP = 64
    GLOBAL_OFF_FREE_BLOCKS = 72
    GLOBAL_OFF_CAPSULE_MODE = 80
    GLOBAL_OFF_CAP_ALLOW_MASK = 88
    GLOBAL_OFF_FS_ALLOW_PREFIXES_PTR = 96
    GLOBAL_OFF_FS_ALLOW_READ_PREFIXES_PTR = 104
    GLOBAL_OFF_FS_ALLOW_WRITE_PREFIXES_PTR = 112
    GLOBAL_OFF_FS_MOUNTS_PTR = 120
    GLOBAL_OFF_FS_MOUNTS_READ_PTR = 128
    GLOBAL_OFF_FS_MOUNTS_WRITE_PTR = 136
    GLOBAL_OFF_NET_ALLOW_LOOPBACK = 144
    GLOBAL_OFF_NET_ALLOW_TCP_CONNECT_PTR = 152
    GLOBAL_OFF_NET_ALLOW_TCP_LISTEN_PTR = 160
    GLOBAL_OFF_NET_TCP_CONNECT_MAP_PTR = 208
    GLOBAL_OFF_NET_TCP_LISTEN_MAP_PTR = 216
    GLOBAL_OFF_NET_FD_CAPS_PTR = 224
    GLOBAL_OFF_NET_FD_CAPS_LEN = 232
    GLOBAL_OFF_PROC_ALLOW_SYSTEM = 168
    GLOBAL_OFF_PROC_ALLOW_EXEC_PREFIXES_PTR = 176
    GLOBAL_OFF_PROC_INHERIT_ENV = 184
    GLOBAL_OFF_PROC_ALLOW_ENV_KEYS_PTR = 192
    GLOBAL_OFF_PROC_ALLOW_ARGV_PTR = 200
    GLOBAL_OFF_PROC_ALLOWED_PIDS_PTR = 240
    GLOBAL_OFF_PROC_ALLOWED_PIDS_LEN = 248
    GLOBAL_OFF_PROC_ALLOWED_PIDS_CAP = 256
    GLOBAL_OFF_ENABLE_SIMD = 264
    GLOBAL_OFF_RAW_MMAP_THRESHOLD = 272
    GLOBAL_OFF_BUF_ALIGN = 280
    GLOBAL_OFF_BUF_FORCE_MMAP = 288
    GLOBAL_OFF_BUF_PAYLOAD_LIMIT = 296
    GLOBAL_SLOTS_RESERVED = 56

    // IMPORTANT: do not rely on global initializers for these constants.
    // Capability mask bits (used by capsule runtime enforcement).
    CAP_FS = 1
    CAP_NET = 2
    CAP_PROC = 4
    CAP_ENV = 8
    CAP_TIME = 16

    // Oren-level open(2) flags (translated by native syscall lowering).
    OREN_O_CREAT = 256
    OREN_O_TRUNC = 512
    OREN_O_NONBLOCK = 1024

    // POSIX socket constants.
    OREN_AF_INET = 2
    // AF_INET6 differs across macOS/Linux.
    if target_os == 1 { OREN_AF_INET6 = 30 } else { OREN_AF_INET6 = 10 }
    OREN_AF_UNIX = 1
    OREN_SOCK_STREAM = 1
    OREN_SOCK_DGRAM = 2
    OREN_IPPROTO_TCP = 6

    // Sockopt constants (Oren-level; translated by native syscall lowering).
    OREN_SOL_SOCKET = 1
    OREN_SO_REUSEADDR = 2
    OREN_SO_ERROR = 4

    // Per-fd kind tags (capsule hardening).
    FD_KIND_NONE = 0
    FD_KIND_TCP_STREAM = 1
    FD_KIND_TCP_LISTEN = 2
    FD_KIND_UDP_DGRAM = 3
    FD_KIND_PROC_PIPE = 10
    FD_KIND_KQUEUE = 20
    FD_KIND_EPOLL = 21

    FCNTL_F_DUPFD = 0
    FCNTL_F_DUPFD_CLOEXEC = 67

    // Linux epoll constants (unused on macOS; safe to define).
    OREN_EPOLL_CTL_ADD = 1
    OREN_EPOLL_CTL_DEL = 2
    OREN_EPOLL_CTL_MOD = 3
    OREN_EPOLLIN = 1
    OREN_EPOLLOUT = 4

    // Reserve room for current globals + some growth slack (rolling ABI).
    //
    // IMPORTANT: allocate globals storage with malloc_raw so it is NOT tracked by GC.
    // This is runtime metadata and must never be reclaimed by mark/sweep.
    g_storage = malloc_raw(GLOBAL_SLOTS_RESERVED * GLOBAL_SLOT_BYTES)
    if g_storage == 0 { exit(199) }
    
    // Zero it
    var i = 0
    while i < GLOBAL_SLOTS_RESERVED {
        ptr_set(iadd(g_storage, i * GLOBAL_SLOT_BYTES), 0)
        i = i + 1
    }

    // Defaults for allocator policy (rolling):
    // - threshold: 1 MiB (matches C runtime)
    // - align: 64 bytes (cache-line / NEON friendly)
    // - force_mmap: off
    // - payload_limit: unlimited (0)
    global_set_raw_mmap_threshold(1048576)
    global_set_buf_align(64)
    global_set_buf_force_mmap(0)
    global_set_buf_payload_limit(0)

    // NET per-fd capability tags (rolling; capsule hardening).
    // We intentionally keep this simple: a byte-per-fd kind table.
    //
    // NOTE:
    // - This is not a general-purpose fd table; it only exists to prevent bypass
    //   via raw `sys_*` NET syscalls in capsule mode.
    // - Allocation uses malloc_raw so GC never reclaims it.
    var max_fds = 4096
    var caps = malloc_raw(max_fds)
    if caps == 0 { exit(199) }
    var zi = 0
    while zi < max_fds {
        ptr_set_byte(caps + zi, 0)
        zi = zi + 1
    }
    global_set_net_fd_caps_ptr(caps)
    global_set_net_fd_caps_len(max_fds)

    // PROC allowed pid table (rolling; capsule hardening).
    //
    // Tracks subprocess pids created by syscall-first spawn so raw sys_wait4/sys_kill
    // cannot target arbitrary host processes in capsule mode.
    var pid_cap = 1024
    var ptab = malloc_raw(pid_cap * 8)
    if ptab == 0 { exit(199) }
    zi = 0
    while zi < pid_cap {
        ptr_set(iadd(ptab, zi * 8), 0)
        zi = zi + 1
    }
    global_set_proc_allowed_pids_ptr(ptab)
    global_set_proc_allowed_pids_len(0)
    global_set_proc_allowed_pids_cap(pid_cap)
    return 0
}

// macOS syscall-first threading init (Darwin bsdthread + ulock model).
//
// NOTE:
// - This is intentionally "best-effort" for now: if the process is already
//   registered (because the host runtime registered earlier), the syscall
//   will fail with EINVAL; we treat that as non-fatal for v0.
// - For Oren's syscall-first runtime we want the kernel threadstart function
//   to be OUR stub (emitted by the native backend), not libpthread.
//
// Args are code pointers to the native backend's thread entry stubs.
fn native_runtime_threading_init(threadstart, wqthread) {
    // Some Darwin kernels validate pthsize for bsdthread_register; use 16KB (page-sized) like libpthread.
    var pthsize = 16384

    // NOTE: Modern Darwin bsdthread_register has multiple historical ABIs.
    // Passing a pthread init-data struct can trigger EINVAL on some kernels.
    // For v0 syscall-first spawn, we register only threadstart/wqthread + pthsize
    // and omit init-data / workqueue settings.
    var rv = sys_bsdthread_register(threadstart, wqthread, pthsize, 0, 0, 0, 0)
    // For syscall-first spawn to work, the process must be registered.
    // If registration fails, bsdthread_create will start threads with the system's default
    // threadstart (libsystem_pthread), which expects a full pthread runtime and will crash.
    // sys_bsdthread_register returns -errno on failure.
    if rv < 0 { exit(0 - rv) }
    return rv
}

fn native_runtime_set_args(argc, argv) {
    global_set_argc(argc)
    global_set_argv(argv)
    return 0
}

fn native_runtime_set_envp(envp) {
    // Keep this function leaf-like (no calls) to avoid any stack-offset bugs
    // while the compiler/runtime ABI is still evolving.
    global_set_envp(envp)
    return 0
}

fn native_cstr_len(s) {
    if s == 0 { return 0 }
    var n = 0
    while n < 65536 {
        if ptr_get_byte(iadd(s, n)) == 0 { return n }
        n = n + 1
    }
    return 65536
}

fn native_envp_get_value_ptr(key_cstr) {
    // Low-level envp scanner for early init and capsule enforcement.
    // Returns pointer to value substring for KEY in envp ("KEY=VALUE"), or 0 if not found.
    if key_cstr == 0 { return 0 }

    var envp = global_get_envp()
    if envp == 0 { return 0 }

    var key_len = native_cstr_len(key_cstr)
    if key_len <= 0 { return 0 }
    if key_len >= 4096 { return 0 }

    var i = 0
    while i < 4096 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { return 0 }

        // Check prefix match "KEY="
        var j = 0
        while j < key_len {
            if ptr_get_byte(iadd(ent, j)) != ptr_get_byte(iadd(key_cstr, j)) {
                j = -1
                break
            }
            j = j + 1
        }

        if j != -1 {
            if ptr_get_byte(iadd(ent, key_len)) == 61 { // '='
                return iadd(ent, key_len + 1)
            }
        }
        i = i + 1
    }
    return 0
}

fn native_envp_get_entry_ptr(key_cstr) {
    // Returns pointer to the full "KEY=VALUE" entry in envp, or 0 if not found.
    if key_cstr == 0 { return 0 }

    var envp = global_get_envp()
    if envp == 0 { return 0 }

    var key_len = native_cstr_len(key_cstr)
    if key_len <= 0 { return 0 }
    if key_len >= 4096 { return 0 }

    var i = 0
    while i < 4096 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { return 0 }

        var j = 0
        while j < key_len {
            if ptr_get_byte(iadd(ent, j)) != ptr_get_byte(iadd(key_cstr, j)) {
                j = -1
                break
            }
            j = j + 1
        }

        if j != -1 {
            if ptr_get_byte(iadd(ent, key_len)) == 61 { // '='
                return ent
            }
        }

        i = i + 1
    }
    return 0
}

fn native_parse_cap_allow_mask(csv_cstr) {
    if csv_cstr == 0 { return 0 }

    var mask = 0
    var i = 0
    var start = 0
    var n = native_cstr_len(csv_cstr)
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(csv_cstr, i)) }

        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var tok_start = start
            var tok_end = i
            // Trim spaces
            while tok_start < tok_end && ptr_get_byte(iadd(csv_cstr, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(csv_cstr, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            var tok_len = tok_end - tok_start
            if tok_len > 0 {
                // ASCII fold to uppercase for matching (a-z -> A-Z).
                var b0 = ptr_get_byte(iadd(csv_cstr, tok_start + 0))
                if b0 >= 97 && b0 <= 122 { b0 = b0 - 32 }

                if tok_len == 2 {
                    var b1 = ptr_get_byte(iadd(csv_cstr, tok_start + 1))
                    if b1 >= 97 && b1 <= 122 { b1 = b1 - 32 }
                    // FS
                    if b0 == 70 && b1 == 83 { mask = mask | CAP_FS }
                } else {
                    if tok_len == 3 {
                        var b1a = ptr_get_byte(iadd(csv_cstr, tok_start + 1))
                        var b2a = ptr_get_byte(iadd(csv_cstr, tok_start + 2))
                        if b1a >= 97 && b1a <= 122 { b1a = b1a - 32 }
                        if b2a >= 97 && b2a <= 122 { b2a = b2a - 32 }
                        // NET / ENV
                        if b0 == 78 && b1a == 69 && b2a == 84 {
                            mask = mask | CAP_NET
                        } else {
                            if b0 == 69 && b1a == 78 && b2a == 86 { mask = mask | CAP_ENV }
                        }
                    } else {
                        if tok_len == 4 {
                            var b1b = ptr_get_byte(iadd(csv_cstr, tok_start + 1))
                            var b2b = ptr_get_byte(iadd(csv_cstr, tok_start + 2))
                            var b3b = ptr_get_byte(iadd(csv_cstr, tok_start + 3))
                            if b1b >= 97 && b1b <= 122 { b1b = b1b - 32 }
                            if b2b >= 97 && b2b <= 122 { b2b = b2b - 32 }
                            if b3b >= 97 && b3b <= 122 { b3b = b3b - 32 }
                            // PROC / TIME
                            if b0 == 80 && b1b == 82 && b2b == 79 && b3b == 67 {
                                mask = mask | CAP_PROC
                            } else {
                                if b0 == 84 && b1b == 73 && b2b == 77 && b3b == 69 { mask = mask | CAP_TIME }
                            }
                        }
                    }
                }
            }

            start = i + 1
        }
        i = i + 1
    }
    return mask
}

fn native_runtime_capsule_init() {
    // Initialize runtime capsule enforcement from env:
    // - OREN_CAPSULE=1 enables deny-by-default enforcement for host-effectful APIs.
    // - OREN_CAP_ALLOW_DOMAINS="FS,NET,PROC,ENV,TIME" enrolls domains.
    //
    // Defaults (non-capsule): allow everything (mask ignored).
    global_set_capsule_mode(0)
    global_set_cap_allow_mask(0)

    // SIMD runtime opt-in (rolling):
    // - Must never change semantics; scalar behavior is authoritative.
    // - Default off; enable explicitly via env.
    //
    // Env:
    // - OREN_ENABLE_SIMD=1 enables SIMD fast paths (when implemented).
    // - OREN_NO_SIMD=1 disables SIMD (wins over enable).
    global_set_enable_simd(0)
    var v_no_simd = native_envp_get_value_ptr("OREN_NO_SIMD")
    if v_no_simd != 0 {
        if ptr_get_byte(v_no_simd) != 0 {
            if ptr_get_byte(v_no_simd) != 48 { global_set_enable_simd(0) } // not '0'
        }
    } else {
        var v_simd = native_envp_get_value_ptr("OREN_ENABLE_SIMD")
        if v_simd != 0 {
            if ptr_get_byte(v_simd) != 0 {
                if ptr_get_byte(v_simd) != 48 { global_set_enable_simd(1) } // not '0'
            }
        }
    }

    // Allocator policy (rolling; affects typed buffers + raw blocks).
    //
    // Env:
    // - OREN_RAW_MMAP_THRESHOLD=<bytes>  (0 disables mmap path; default 1 MiB)
    // - OREN_BUF_ALIGN=8|16|32|64        (default 64)
    // - OREN_BUF_FORCE_MMAP=1            (force mmap for any non-empty typed buffer payload)
    // - OREN_BUF_PAYLOAD_LIMIT_BYTES=<bytes> (0 means unlimited; caps typed-buffer payload bytes)
    var v_thr = native_envp_get_value_ptr("OREN_RAW_MMAP_THRESHOLD")
    if v_thr != 0 {
        var thr = native_parse_i64_dec_cstr_or_neg1(v_thr)
        if thr >= 0 { global_set_raw_mmap_threshold(thr) }
    }
    var v_align = native_envp_get_value_ptr("OREN_BUF_ALIGN")
    if v_align != 0 {
        var a = native_parse_i64_dec_cstr_or_neg1(v_align)
        if a == 8 || a == 16 || a == 32 || a == 64 { global_set_buf_align(a) }
    }
    global_set_buf_force_mmap(0)
    var v_force = native_envp_get_value_ptr("OREN_BUF_FORCE_MMAP")
    if v_force != 0 {
        if ptr_get_byte(v_force) != 0 {
            if ptr_get_byte(v_force) != 48 { global_set_buf_force_mmap(1) } // not '0'
        }
    }
    global_set_buf_payload_limit(0)
    var v_lim = native_envp_get_value_ptr("OREN_BUF_PAYLOAD_LIMIT_BYTES")
    if v_lim != 0 {
        var lim = native_parse_i64_dec_cstr_or_neg1(v_lim)
        if lim >= 0 { global_set_buf_payload_limit(lim) }
    }

    var k_capsule = "OREN_CAPSULE"
    var v_capsule = native_envp_get_value_ptr(k_capsule)
    if v_capsule == 0 { return 0 }
    if ptr_get_byte(v_capsule) == 0 { return 0 }
    if ptr_get_byte(v_capsule) == 48 { return 0 } // '0'

    global_set_capsule_mode(1)

    var k_allow = "OREN_CAP_ALLOW_DOMAINS"
    var v_allow = native_envp_get_value_ptr(k_allow)
    if v_allow == 0 {
        global_set_cap_allow_mask(0)
        return 0
    }
    var mask = native_parse_cap_allow_mask(v_allow)
    global_set_cap_allow_mask(mask)

    // FS path prefix allowlist (rolling):
    // Legacy env (applies to both read+write): OREN_FS_ALLOW_PREFIXES="build/,tmp/"
    var v_fs = native_envp_get_value_ptr("OREN_FS_ALLOW_PREFIXES")
    global_set_fs_allow_prefixes_ptr(v_fs)

    // Split allowlists (preferred):
    //   OREN_FS_ALLOW_READ_PREFIXES=...
    //   OREN_FS_ALLOW_WRITE_PREFIXES=...
    // If unset, fall back to OREN_FS_ALLOW_PREFIXES.
    var v_r = native_envp_get_value_ptr("OREN_FS_ALLOW_READ_PREFIXES")
    var v_w = native_envp_get_value_ptr("OREN_FS_ALLOW_WRITE_PREFIXES")
    if v_r == 0 { v_r = v_fs }
    if v_w == 0 { v_w = v_fs }
    global_set_fs_allow_read_prefixes_ptr(v_r)
    global_set_fs_allow_write_prefixes_ptr(v_w)

    // FS mounts (preferred over prefixes when set):
    // - In capsule mode, mounts provide an explicit virtual->host mapping and are sufficient by themselves.
    // - When mounts are configured for an operation (read/write), direct host paths are denied unless they match a mount.
    //
    // Env:
    // - OREN_FS_MOUNTS="v/=build/mnt/" (legacy applies to both)
    // - OREN_FS_MOUNTS_READ=...
    // - OREN_FS_MOUNTS_WRITE=...
    //
    // Notes:
    // - Tokens are CSV.
    // - Each token is "<virt_prefix>=<host_prefix>".
    // - Use trailing '/' in virt_prefix to avoid accidental prefix matches.
    var v_m = native_envp_get_value_ptr("OREN_FS_MOUNTS")
    var v_mr = native_envp_get_value_ptr("OREN_FS_MOUNTS_READ")
    var v_mw = native_envp_get_value_ptr("OREN_FS_MOUNTS_WRITE")
    if v_mr == 0 { v_mr = v_m }
    if v_mw == 0 { v_mw = v_m }
    global_set_fs_mounts_ptr(v_m)
    global_set_fs_mounts_read_ptr(v_mr)
    global_set_fs_mounts_write_ptr(v_mw)

    // NET enrollment (rolling; native backend):
    // - Default: deny all NET endpoints in capsule mode unless explicitly enrolled.
    // - Allow loopback endpoints via OREN_NET_ALLOW_LOOPBACK=1.
    // - Optional explicit endpoint allowlists:
    //     OREN_NET_ALLOW_TCP_CONNECT="127.0.0.1:8080,10.0.0.1:*"
    //     OREN_NET_ALLOW_TCP_LISTEN="127.0.0.1:*"
    // Tokens:
    // - "<ipv4>" allows any port for that ip
    // - "<ipv4>:<port>" allows a single port
    // - "<ipv4>:*" allows any port
    // - "*:<port>" allows that port to any ip
    // - "*" allows any ip/port (dangerous; only honored if explicitly set)
    var v_loop = native_envp_get_value_ptr("OREN_NET_ALLOW_LOOPBACK")
    var loop = 0
    if v_loop != 0 {
        if ptr_get_byte(v_loop) != 0 {
            if ptr_get_byte(v_loop) != 48 { loop = 1 } // not '0'
        }
    }
    global_set_net_allow_loopback(loop)
    global_set_net_allow_tcp_connect_ptr(native_envp_get_value_ptr("OREN_NET_ALLOW_TCP_CONNECT"))
    global_set_net_allow_tcp_listen_ptr(native_envp_get_value_ptr("OREN_NET_ALLOW_TCP_LISTEN"))
    // NET endpoint vnet-style mapping (rolling; native backend):
    // - Explicit enrollment mechanism that can rewrite a *virtual* endpoint into a *host* endpoint
    //   without requiring a relay between nested AVMs.
    // - Format: CSV of "<virt_ip>:<virt_port>=<host_ip>:<host_port>"
    // - When a mapping matches, it is sufficient by itself (it is the enrollment).
    global_set_net_tcp_connect_map_ptr(native_envp_get_value_ptr("OREN_NET_TCP_CONNECT_MAP"))
    global_set_net_tcp_listen_map_ptr(native_envp_get_value_ptr("OREN_NET_TCP_LISTEN_MAP"))

    // PROC enrollment (rolling; native backend):
    //
    // We intentionally do NOT rely on a host shell or PATH lookups:
    // - When you need processes in capsule mode, use explicit exec paths.
    // - `oren_system` is considered a convenience API and must be explicitly enabled.
    //
    // Env:
    // - OREN_PROC_ALLOW_EXEC_PREFIXES="/usr/bin/,/bin/" (CSV path prefixes)
    // - OREN_PROC_ALLOW_SYSTEM=1 (enables /bin/sh only; convenience for bootstrapping)
    // - OREN_PROC_INHERIT_ENV=1 (dangerous: inherit all parent env vars)
    // - OREN_PROC_ALLOW_ENV_KEYS="PATH,HOME" (CSV keys; only these are inherited)
    // - OREN_PROC_ALLOW_ARGV="/usr/bin/true|/usr/bin/true,/usr/bin/printenv|printenv|X,/bin/sh|sh|-c|*" (CSV specs; '|' delims argv)
    var v_proc_exec = native_envp_get_value_ptr("OREN_PROC_ALLOW_EXEC_PREFIXES")
    var v_allow_system = native_envp_get_value_ptr("OREN_PROC_ALLOW_SYSTEM")
    var allow_system = 0
    if v_allow_system != 0 {
        if ptr_get_byte(v_allow_system) != 0 {
            if ptr_get_byte(v_allow_system) != 48 { allow_system = 1 } // not '0'
        }
    }
    global_set_proc_allow_system(allow_system)
    if v_proc_exec == 0 {
        if allow_system == 1 {
            // Allow just the shell path for oren_system_timeout().
            v_proc_exec = "/bin/sh"
        }
    }
    global_set_proc_allow_exec_prefixes_ptr(v_proc_exec)

    var v_inherit = native_envp_get_value_ptr("OREN_PROC_INHERIT_ENV")
    var inherit = 0
    if v_inherit != 0 {
        if ptr_get_byte(v_inherit) != 0 {
            if ptr_get_byte(v_inherit) != 48 { inherit = 1 } // not '0'
        }
    }
    global_set_proc_inherit_env(inherit)
    global_set_proc_allow_env_keys_ptr(native_envp_get_value_ptr("OREN_PROC_ALLOW_ENV_KEYS"))
    global_set_proc_allow_argv_ptr(native_envp_get_value_ptr("OREN_PROC_ALLOW_ARGV"))
    return 0
}

fn native_capsule_require(mask_bit, name) {
    if global_get_capsule_mode() != 1 { return 0 }
    var allow = global_get_cap_allow_mask()
    if (allow & mask_bit) != 0 { return 0 }
    native_capsule_diag_print("CAPSULE DENY: " + name)
    native_capsule_diag_print("hint: set OREN_CAP_ALLOW_DOMAINS to include " + name + " (or pass --cap-allow-domains)")
    exit(77)
    return 0
}

fn native_capsule_require_any(mask_bits, name_hint) {
    if global_get_capsule_mode() != 1 { return 0 }
    var allow = global_get_cap_allow_mask()
    if (allow & mask_bits) != 0 { return 0 }
    native_capsule_diag_print("CAPSULE DENY: " + name_hint)
    native_capsule_diag_print("hint: set OREN_CAP_ALLOW_DOMAINS to include one of: " + name_hint + " (or pass --cap-allow-domains)")
    exit(77)
    return 0
}

fn native_capsule_diag_print(msg) {
    // Diagnostic printing helper for capsule deny paths.
    //
    // Design goal:
    // - Capsule enforcement must be able to explain *why* it denied an operation.
    // - Those diagnostics must not themselves be blocked by FS/NET/PROC enrollment rules.
    //
    // Implementation:
    // - Temporarily disable capsule_mode while calling print(), so sys_write gating does not recurse.
    if msg == 0 { return 0 }
    if global_get_capsule_mode() != 1 {
        print(msg)
        return 0
    }
    global_set_capsule_mode(0)
    print(msg)
    global_set_capsule_mode(1)
    return 0
}

fn native_capsule_require_fd_domain(fd) {
    // Require an appropriate domain for an existing fd in capsule mode.
    //
    // Rules:
    // - NET-tagged fds require NET.
    // - PROC pipe fds require PROC.
    // - Other fds require FS (stdio/files).
    if global_get_capsule_mode() != 1 { return 0 }
    if fd < 0 { return 0 }
    var k = native_capsule_net_fd_kind_get(fd)
    if k != 0 {
        if k == FD_KIND_PROC_PIPE {
            native_capsule_require(CAP_PROC, "PROC")
            return 0
        }
        if k == FD_KIND_KQUEUE {
            // Event-loop fds are shared across domains (TIME/NET/PROC).
            native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
            return 0
        }
        if k == FD_KIND_EPOLL {
            // Linux epoll fds serve the same "event loop" role as kqueue fds.
            native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
            return 0
        }
        native_capsule_require(CAP_NET, "NET")
        return 0
    }
    native_capsule_require(CAP_FS, "FS")
    return 0
}

fn native_capsule_fs_path_allowed(path, prefs) {
    if path == 0 { return false }
    // prefs is a CSV cstr
    if prefs == 0 { return false }

    var i = 0
    var start = 0
    var n = native_cstr_len(prefs)
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(prefs, i)) }

        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var tok_start = start
            var tok_end = i
            while tok_start < tok_end && ptr_get_byte(iadd(prefs, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(prefs, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            var tok_len = tok_end - tok_start
            if tok_len > 0 {
                var j = 0
                var ok = true
                while j < tok_len {
                    var pc = ptr_get_byte(iadd(path, j))
                    if pc == 0 { ok = false; j = tok_len }
                    else {
                        var tc = ptr_get_byte(iadd(prefs, tok_start + j))
                        if pc != tc { ok = false; j = tok_len }
                        else { j = j + 1 }
                    }
                }
                if ok {
                    // Boundary check when prefix does not end with '/':
                    // Avoid accidental matches like "build" matching "build2".
                    var last = ptr_get_byte(iadd(prefs, tok_start + tok_len - 1))
                    if last != 47 {
                        var nextc = ptr_get_byte(iadd(path, tok_len))
                        if nextc != 0 && nextc != 47 { ok = false }
                    }
                }
                if ok { return true }
            }

            start = i + 1
        }
        i = i + 1
    }
    return false
}

fn native_capsule_fs_mount_resolve(path, mounts_csv) {
    // mounts_csv: CSV of "<virt_prefix>=<host_prefix>" tokens.
    // Returns newly allocated host path string on match, or 0 if no match.
    //
    // Security + determinism rules (rolling):
    // - Use LONGEST matching virt_prefix (order-independent).
    // - Enforce a path boundary when prefix does not end with '/':
    //     prefix matches only if next char is '/' or NUL.
    if path == 0 { return 0 }
    if mounts_csv == 0 { return 0 }
    if ptr_get_byte(mounts_csv) == 0 { return 0 }

    var path_len = oren_string_len(path)

    // Track best match by virt_len.
    var best_virt_len = 0
    var best_host_start = 0
    var best_host_len = 0

    var n = native_cstr_len(mounts_csv)
    var i = 0
    var start = 0
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(mounts_csv, i)) }

        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var tok_start = start
            var tok_end = i
            while tok_start < tok_end && ptr_get_byte(iadd(mounts_csv, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(mounts_csv, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            // Find '=' inside token
            var eq = -1
            var j = tok_start
            while j < tok_end {
                if ptr_get_byte(iadd(mounts_csv, j)) == 61 { eq = j; break } // '='
                j = j + 1
            }

            if eq != -1 {
                var virt_start = tok_start
                var virt_end = eq
                var host_start = eq + 1
                var host_end = tok_end

                while virt_start < virt_end && ptr_get_byte(iadd(mounts_csv, virt_start)) == 32 { virt_start = virt_start + 1 }
                while virt_end > virt_start && ptr_get_byte(iadd(mounts_csv, virt_end - 1)) == 32 { virt_end = virt_end - 1 }
                while host_start < host_end && ptr_get_byte(iadd(mounts_csv, host_start)) == 32 { host_start = host_start + 1 }
                while host_end > host_start && ptr_get_byte(iadd(mounts_csv, host_end - 1)) == 32 { host_end = host_end - 1 }

                var virt_len = virt_end - virt_start
                var host_len = host_end - host_start
                if virt_len > 0 && host_len > 0 {
                    // Prefix match of virt_prefix against path.
                    if path_len >= virt_len {
                        var k = 0
                        var is_match = true
                        while k < virt_len {
                            var pc = ptr_get_byte(path + k)
                            if pc == 0 { is_match = false; k = virt_len }
                            else {
                                var vc = ptr_get_byte(iadd(mounts_csv, virt_start + k))
                                if pc != vc { is_match = false; k = virt_len }
                                else { k = k + 1 }
                            }
                        }

                        if is_match {
                            // Boundary check when virt_prefix does not end with '/'.
                            var last = ptr_get_byte(iadd(mounts_csv, virt_start + virt_len - 1))
                            if last != 47 {
                                var nextc = 0
                                if path_len > virt_len { nextc = ptr_get_byte(path + virt_len) }
                                if nextc != 0 && nextc != 47 { is_match = false }
                            }
                        }

                        if is_match {
                            if virt_len > best_virt_len {
                                best_virt_len = virt_len
                                best_host_start = host_start
                                best_host_len = host_len
                            }
                        }
                    }
                }
            }

            start = i + 1
        }
        i = i + 1
    }

    if best_virt_len == 0 { return 0 }

    var rem_len = path_len - best_virt_len
    var out = malloc(best_host_len + rem_len + 1)
    if out == 0 { exit(301) }

    // host prefix
    var a = 0
    while a < best_host_len {
        ptr_set_byte(out + a, ptr_get_byte(iadd(mounts_csv, best_host_start + a)))
        a = a + 1
    }
    // remainder
    var b = 0
    while b < rem_len {
        ptr_set_byte(out + best_host_len + b, ptr_get_byte(path + best_virt_len + b))
        b = b + 1
    }
    ptr_set_byte(out + best_host_len + rem_len, 0)
    oren_track_alloc(out, best_host_len + rem_len + 1, 1) // STRING
    return out
}

fn native_capsule_fs_path_resolve_pair(path, op_kind) {
    // Returns pointer to [resolved_path_ptr, owned(0|1)] (16 bytes).
    // owned=1 means resolved_path_ptr must be free()'d by the caller.
    var pair = malloc(16)
    if pair == 0 { exit(301) }
    ptr_set(pair + 0, path)
    ptr_set(pair + 8, 0)

    native_capsule_require(CAP_FS, "FS")
    if global_get_capsule_mode() != 1 { return pair }

    // Prefer mounts if configured for this operation.
    var mounts = global_get_fs_mounts_ptr()
    if op_kind == 0 { mounts = global_get_fs_mounts_read_ptr() }
    if op_kind == 1 { mounts = global_get_fs_mounts_write_ptr() }
    if mounts != 0 {
        if ptr_get_byte(mounts) == 0 { mounts = 0 }
    }

    if mounts != 0 {
        // Fast path: if caller already provides a host path, allow it if it is within
        // any enrolled host_prefix in mounts.
        //
        // This is important because higher-level helpers may pre-resolve paths; mounts
        // are still the enrollment mechanism, regardless of whether the caller uses
        // virtual or host paths.
        var n2 = native_cstr_len(mounts)
        var ii = 0
        var start2 = 0
        while ii <= n2 {
            var ch2 = 0
            if ii < n2 { ch2 = ptr_get_byte(iadd(mounts, ii)) }
            var is_sep2 = false
            if ii == n2 { is_sep2 = true }
            if ch2 == 44 { is_sep2 = true } // ','

            if is_sep2 {
                var tok_start = start2
                var tok_end = ii
                while tok_start < tok_end && ptr_get_byte(iadd(mounts, tok_start)) == 32 { tok_start = tok_start + 1 }
                while tok_end > tok_start && ptr_get_byte(iadd(mounts, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

                // Find '='
                var eq = -1
                var j2 = tok_start
                while j2 < tok_end {
                    if ptr_get_byte(iadd(mounts, j2)) == 61 { eq = j2; break } // '='
                    j2 = j2 + 1
                }

                if eq != -1 {
                    var host_start = eq + 1
                    var host_end = tok_end
                    while host_start < host_end && ptr_get_byte(iadd(mounts, host_start)) == 32 { host_start = host_start + 1 }
                    while host_end > host_start && ptr_get_byte(iadd(mounts, host_end - 1)) == 32 { host_end = host_end - 1 }
                    var host_len = host_end - host_start
                    if host_len > 0 {
                        var k = 0
                        var ok = true
                        while k < host_len {
                            var pc = ptr_get_byte(iadd(path, k))
                            if pc == 0 { ok = false; break }
                            if pc != ptr_get_byte(iadd(mounts, host_start + k)) { ok = false; break }
                            k = k + 1
                        }
                        if ok {
                            // Boundary check when host_prefix does not end with '/':
                            // Avoid accidental enrollment bypass like "/mnt" matching "/mnt2".
                            var last = ptr_get_byte(iadd(mounts, host_start + host_len - 1))
                            if last != 47 {
                                var nextc = ptr_get_byte(iadd(path, host_len))
                                if nextc != 0 && nextc != 47 { ok = false }
                            }
                        }

                        if ok {
                            // Path already starts with enrolled host prefix; allow as-is.
                            return pair
                        }
                    }
                }

                start2 = ii + 1
            }
            ii = ii + 1
        }

        // Otherwise treat the path as virtual and try to resolve it.
        var host_path = native_capsule_fs_mount_resolve(path, mounts)
        if host_path == 0 {
            free(pair)
            print("CAPSULE DENY: FS_MOUNT")
            print("hint: enroll FS mounts via OREN_FS_MOUNTS / OREN_FS_MOUNTS_READ / OREN_FS_MOUNTS_WRITE")
            exit(78)
        }
        ptr_set(pair + 0, host_path)
        ptr_set(pair + 8, 1)
        return pair
    }

    // Fallback: path prefix allowlists (legacy).
    var prefs = global_get_fs_allow_prefixes_ptr()
    // Prefer split read/write allowlists when present.
    // op_kind: 0=read, 1=write (avoid string pointer equality issues).
    if op_kind == 0 { prefs = global_get_fs_allow_read_prefixes_ptr() }
    if op_kind == 1 { prefs = global_get_fs_allow_write_prefixes_ptr() }
    if native_capsule_fs_path_allowed(path, prefs) { return pair }
    free(pair)
    print("CAPSULE DENY: FS_PATH")
    print("hint: allow FS prefixes via OREN_FS_ALLOW_PREFIXES or OREN_FS_ALLOW_READ_PREFIXES / OREN_FS_ALLOW_WRITE_PREFIXES (or use mounts via OREN_FS_MOUNTS[_READ|_WRITE])")
    exit(78)
    return 0
}

fn native_capsule_sys_open_pre(path, flags) {
    // Enforce FS enrollment at raw sys_open boundary (no bypass).
    //
    // Returns a pair [path_ptr, owned(0|1)] to use for the syscall.
    // owned=1 => path_ptr must be free()'d after the syscall.
    //
    // op_kind: 0=read, 1=write
    var op_kind = 0
    // POSIX: O_RDONLY=0, O_WRONLY=1, O_RDWR=2.
    // Any non-zero access bits imply write capability.
    if (flags & 3) != 0 { op_kind = 1 }
    return native_capsule_fs_path_resolve_pair(path, op_kind)
}

fn native_capsule_sys_open_post(pair, rc) {
    // Free any allocated mount-resolved host path and the pair itself.
    if pair != 0 {
        var owns = ptr_get(pair + 8)
        if owns != 0 {
            var p = ptr_get(pair + 0)
            if p != 0 { free(p) }
        }
        free(pair)
    }
    return rc
}

fn native_capsule_sys_unlink_pre(path) {
    // unlink is a write op.
    return native_capsule_fs_path_resolve_pair(path, 1)
}

fn native_capsule_sys_unlink_post(pair, rc) {
    return native_capsule_sys_open_post(pair, rc)
}

fn native_capsule_sys_access_pre(path) {
    // access is a read op.
    return native_capsule_fs_path_resolve_pair(path, 0)
}

fn native_capsule_sys_access_post(pair, rc) {
    return native_capsule_sys_open_post(pair, rc)
}

fn native_capsule_sys_stat_pre(path) {
    // stat is a read op.
    return native_capsule_fs_path_resolve_pair(path, 0)
}

fn native_capsule_sys_stat_post(pair, rc) {
    return native_capsule_sys_open_post(pair, rc)
}

fn native_capsule_sys_lstat_pre(path) {
    // lstat is a read op.
    return native_capsule_fs_path_resolve_pair(path, 0)
}

fn native_capsule_sys_lstat_post(pair, rc) {
    return native_capsule_sys_open_post(pair, rc)
}

fn native_capsule_sys_fstat_pre(fd) {
    // fstat is a read op on an existing fd. The path enrollment is enforced at open-time;
    // here we just require FS domain in capsule mode.
    native_capsule_require(CAP_FS, "FS")
    return fd
}

fn native_capsule_sys_fstat_post(rc) {
    return rc
}

fn native_capsule_sys_read_pre(fd) {
    // sys_read is a read operation on an existing fd.
    //
    // Capsule hardening:
    // - If the fd is a NET-tagged fd (socket), require NET domain so programs cannot bypass
    //   NET enrollment by calling sys_read/sys_write directly.
    // - Otherwise treat it as FS/stdio and require FS domain (prevents bypass via inherited fds, incl stdin).
    if global_get_capsule_mode() != 1 { return fd }
    var k = native_capsule_net_fd_kind_get(fd)
    if k != 0 {
        if k == FD_KIND_PROC_PIPE {
            native_capsule_require(CAP_PROC, "PROC")
            return fd
        } else {
            native_capsule_require(CAP_NET, "NET")
            // Disallow reading from listening sockets (kind=2).
            if k == FD_KIND_TCP_LISTEN {
                print("CAPSULE DENY: NET_RECV_LISTEN")
                exit(79)
            }
            return fd
        }
    }

    native_capsule_require(CAP_FS, "FS")
    return fd
}

fn native_capsule_sys_pipe_pre(ptr) {
    // pipe creates two new fds (host effect).
    //
    // For v0 capsule domains, classify it under PROC because it is primarily used for IPC
    // (spawn/join, subprocess pipes) rather than path-based filesystem access.
    // Capsule hardening: enforce FS at syscall boundary (no bypass).
    native_capsule_require(CAP_PROC, "PROC")
    return ptr
}

fn native_capsule_sys_pipe_post(ptr, rc) {
    // Tag newly-created pipe fds as PROC-kind so sys_read/sys_write can allow IPC under PROC domain
    // (without requiring FS and without confusing them as NET fds).
    if global_get_capsule_mode() != 1 { return rc }
    if rc != 0 { return rc }
    if ptr == 0 { return rc }
    var rfd = ptr_get(ptr + 0)
    var wfd = ptr_get(ptr + 8)
    native_capsule_net_fd_kind_set(rfd, FD_KIND_PROC_PIPE)
    native_capsule_net_fd_kind_set(wfd, FD_KIND_PROC_PIPE)
    return rc
}

fn native_capsule_sys_write_pre(fd) {
    // sys_write is a write operation on an existing fd.
    //
    // Capsule hardening:
    // - If the fd is NET-tagged (socket), require NET domain to prevent NET bypass.
    // - Stdout/stderr (fd=1/2) are treated as a diagnostic channel and are always allowed.
    // - Otherwise treat it as FS/stdio and require FS domain.
    if global_get_capsule_mode() != 1 { return fd }
    if fd == 1 || fd == 2 { return fd }
    var k = native_capsule_net_fd_kind_get(fd)
    if k != 0 {
        if k == FD_KIND_PROC_PIPE {
            native_capsule_require(CAP_PROC, "PROC")
            return fd
        } else {
            native_capsule_require(CAP_NET, "NET")
            // Disallow sending on listening sockets (kind=2).
            if k == FD_KIND_TCP_LISTEN {
                print("CAPSULE DENY: NET_SEND_LISTEN")
                exit(79)
            }
            return fd
        }
    }

    native_capsule_require(CAP_FS, "FS")
    return fd
}

fn native_capsule_sys_close_pre(fd) {
    // Enforce domain for raw sys_close boundary (no bypass).
    native_capsule_require_fd_domain(fd)
    return fd
}

fn native_capsule_sys_fcntl_pre(fd, cmd, arg) {
    // Enforce domain for raw sys_fcntl boundary (no bypass).
    // fcntl can mutate fd state and is used for FS (e.g. F_GETPATH) and NET (socket flags).
    native_capsule_require_fd_domain(fd)
    return 0
}

fn native_capsule_sys_fcntl_post(rc, fd, cmd, arg) {
    // Post-hook for sys_fcntl to propagate fd kind tags for commands that produce a new fd.
    //
    // Without this, a tagged socket fd can be duplicated via fcntl(F_DUPFD) into an untagged fd,
    // which then breaks downstream syscall gating that relies on fd kind tags (sys_read/sys_write/etc).
    if global_get_capsule_mode() != 1 { return rc }
    if rc < 0 { return rc }
    if cmd != FCNTL_F_DUPFD && cmd != FCNTL_F_DUPFD_CLOEXEC { return rc }
    var newfd = rc
    if newfd < 0 { return rc }
    var k = native_capsule_net_fd_kind_get(fd)
    native_capsule_net_fd_kind_clear(newfd)
    if k != 0 {
        native_capsule_net_fd_kind_set(newfd, k)
    }
    return rc
}

fn native_capsule_sys_mkdir_pre(path) {
    // mkdir is a write op.
    return native_capsule_fs_path_resolve_pair(path, 1)
}

fn native_capsule_sys_mkdir_post(pair, rc) {
    return native_capsule_sys_open_post(pair, rc)
}

fn native_capsule_sys_rename_pre(from, to) {
    // rename touches both paths and is a write op for both.
    var b = malloc(32)
    if b == 0 { exit(301) }

    var p1 = native_capsule_fs_path_resolve_pair(from, 1)
    var p2 = native_capsule_fs_path_resolve_pair(to, 1)

    ptr_set(b + 0, ptr_get(p1 + 0))
    ptr_set(b + 8, ptr_get(p1 + 8))
    ptr_set(b + 16, ptr_get(p2 + 0))
    ptr_set(b + 24, ptr_get(p2 + 8))
    free(p1)
    free(p2)
    return b
}

fn native_capsule_sys_rename_post(bundle, rc) {
    if bundle != 0 {
        var o1 = ptr_get(bundle + 8)
        if o1 != 0 {
            var p1 = ptr_get(bundle + 0)
            if p1 != 0 { free(p1) }
        }
        var o2 = ptr_get(bundle + 24)
        if o2 != 0 {
            var p2 = ptr_get(bundle + 16)
            if p2 != 0 { free(p2) }
        }
        free(bundle)
    }
    return rc
}

fn native_capsule_sys_rmdir_pre(path) {
    // rmdir is a write op.
    return native_capsule_fs_path_resolve_pair(path, 1)
}

fn native_capsule_sys_rmdir_post(pair, rc) {
    return native_capsule_sys_open_post(pair, rc)
}

fn native_capsule_sys_getdirentries64_pre(fd) {
    // getdirentries is a read op on an existing directory fd. Enrollment is enforced at open-time;
    // here we require FS domain in capsule mode to prevent bypass via inherited fds.
    native_capsule_require(CAP_FS, "FS")
    return fd
}

fn native_capsule_sys_getdirentries64_post(rc) {
    return rc
}

fn native_ipv4_is_loopback(ip) {
    // Accept 127.0.0.0/8 as loopback.
    // ip==0 is treated as loopback because oren_tcp_sockaddr_in defaults to 127.0.0.1.
    if ip == 0 { return true }

    var acc = 0
    var digits = 0
    var i = 0
    while 1 {
        var ch = ptr_get_byte(ip + i)
        if ch == 0 { return false }
        if ch >= 48 && ch <= 57 {
            acc = acc * 10 + (ch - 48)
            if acc > 255 { return false }
            digits = digits + 1
        } else {
            if ch == 46 { // '.'
                if digits == 0 { return false }
                if acc == 127 { return true }
                return false
            }
            return false
        }
        i = i + 1
        if i > 64 { return false }
    }
}

fn native_capsule_net_endpoint_allowed(ip, port, prefs) {
    // prefs: CSV cstr containing endpoint tokens.
    // ip: oren string (cstr), may be 0.
    if prefs == 0 { return false }
    if port < 0 { return false }

    var n = native_cstr_len(prefs)
    var i = 0
    var start = 0
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(prefs, i)) }

        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var tok_start = start
            var tok_end = i
            while tok_start < tok_end && ptr_get_byte(iadd(prefs, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(prefs, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            var tok_len = tok_end - tok_start
            if tok_len > 0 {
                // Find ':' in token
                var colon = -1
                var j = tok_start
                while j < tok_end {
                    if ptr_get_byte(iadd(prefs, j)) == 58 { colon = j; break } // ':'
                    j = j + 1
                }

                var ip_start = tok_start
                var ip_end = tok_end
                var port_start = -1
                var port_end = -1
                if colon != -1 {
                    ip_end = colon
                    port_start = colon + 1
                    port_end = tok_end
                }

                // Match ip (supports '*' wildcard).
                var ip_ok = true
                if ip_end - ip_start == 1 && ptr_get_byte(iadd(prefs, ip_start)) == 42 { // '*'
                    ip_ok = true
                } else {
                    if ip == 0 { ip_ok = false }
                    else {
                        var k = 0
                        while 1 {
                            if ip_start + k >= ip_end {
                                // Token ended; ip must also end here.
                                if ptr_get_byte(ip + k) != 0 { ip_ok = false }
                                break
                            }
                            var ic = ptr_get_byte(ip + k)
                            if ic == 0 { ip_ok = false; break }
                            var tc = ptr_get_byte(iadd(prefs, ip_start + k))
                            if ic != tc { ip_ok = false; break }
                            k = k + 1
                            if k > 256 { ip_ok = false; break }
                        }
                    }
                }

                if ip_ok {
                    // Match port (optional, supports '*').
                    var port_ok = true
                    if port_start != -1 {
                        while port_start < port_end && ptr_get_byte(iadd(prefs, port_start)) == 32 { port_start = port_start + 1 }
                        while port_end > port_start && ptr_get_byte(iadd(prefs, port_end - 1)) == 32 { port_end = port_end - 1 }

                        if port_end - port_start == 1 && ptr_get_byte(iadd(prefs, port_start)) == 42 { // '*'
                            port_ok = true
                        } else {
                            var pv = 0
                            var pd = 0
                            var pi = port_start
                            while pi < port_end {
                                var pc = ptr_get_byte(iadd(prefs, pi))
                                if pc < 48 || pc > 57 { port_ok = false; pi = port_end }
                                else {
                                    pv = pv * 10 + (pc - 48)
                                    if pv > 65535 { port_ok = false; pi = port_end }
                                    else { pd = pd + 1; pi = pi + 1 }
                                }
                            }
                            if port_ok {
                                if pd == 0 { port_ok = false }
                                else { if pv != port { port_ok = false } }
                            }
                        }
                    }

                    if port_ok { return true }
                }
            }

            start = i + 1
        }
        i = i + 1
    }
    return false
}

fn native_capsule_require_net_connect(ip, port) {
    native_capsule_require(CAP_NET, "NET")
    if global_get_capsule_mode() != 1 { return 0 }
    if global_get_net_allow_loopback() == 1 {
        if native_ipv4_is_loopback(ip) { return 0 }
    }
    var prefs = global_get_net_allow_tcp_connect_ptr()
    if native_capsule_net_endpoint_allowed(ip, port, prefs) { return 0 }
    print("CAPSULE DENY: NET_CONNECT")
    exit(79)
    return 0
}

fn native_capsule_require_net_listen(ip, port) {
    native_capsule_require(CAP_NET, "NET")
    if global_get_capsule_mode() != 1 { return 0 }
    if global_get_net_allow_loopback() == 1 {
        if native_ipv4_is_loopback(ip) { return 0 }
    }
    var prefs = global_get_net_allow_tcp_listen_ptr()
    if native_capsule_net_endpoint_allowed(ip, port, prefs) { return 0 }
    print("CAPSULE DENY: NET_LISTEN")
    exit(79)
    return 0
}

fn native_capsule_net_fd_kind_get(fd) {
    if global_get_capsule_mode() != 1 { return 0 }
    if fd < 0 { return 0 }
    var caps = global_get_net_fd_caps_ptr()
    if caps == 0 { return 0 }
    var max_fds = global_get_net_fd_caps_len()
    if max_fds <= 0 { return 0 }
    if fd >= max_fds { return 0 }
    return ptr_get_byte(caps + fd)
}

fn native_capsule_net_fd_kind_set(fd, kind) {
    if global_get_capsule_mode() != 1 { return 0 }
    if fd < 0 { return 0 }
    var caps = global_get_net_fd_caps_ptr()
    if caps == 0 { return 0 }
    var max_fds = global_get_net_fd_caps_len()
    if max_fds <= 0 { return 0 }
    if fd >= max_fds { return 0 }
    if kind < 0 { kind = 0 }
    if kind > 255 { kind = 255 }
    ptr_set_byte(caps + fd, kind)
    return 0
}

fn native_capsule_net_fd_kind_clear(fd) {
    return native_capsule_net_fd_kind_set(fd, 0)
}

fn native_parse_ipv4_sub(s, start, end, out4_ptr) {
    // Parse dotted-decimal IPv4 from s[start:end) into 4 bytes at out4_ptr.
    // Returns 1 on success.
    if s == 0 { return 0 }
    if out4_ptr == 0 { return 0 }
    if end <= start { return 0 }

    var part = 0
    var acc = 0
    var digits = 0
    var i = start
    while i < end {
        var ch = ptr_get_byte(iadd(s, i))
        if ch >= 48 && ch <= 57 {
            acc = acc * 10 + (ch - 48)
            if acc > 255 { return 0 }
            digits = digits + 1
        } else {
            if ch == 46 { // '.'
                if digits == 0 { return 0 }
                if part >= 3 { return 0 }
                ptr_set_byte(out4_ptr + part, acc)
                part = part + 1
                acc = 0
                digits = 0
            } else {
                return 0
            }
        }
        i = i + 1
    }
    if part != 3 { return 0 }
    if digits == 0 { return 0 }
    ptr_set_byte(out4_ptr + 3, acc)
    return 1
}

fn native_parse_u16_sub(s, start, end, out_ok_ptr) {
    // Parses 0..65535 from s[start:end). Returns value; writes 1/0 to out_ok_ptr.
    if out_ok_ptr != 0 { ptr_set(out_ok_ptr, 0) }
    if s == 0 { return 0 }
    if end <= start { return 0 }
    var v = 0
    var i = start
    var digits = 0
    while i < end {
        var ch = ptr_get_byte(iadd(s, i))
        if ch < 48 || ch > 57 { return 0 }
        v = v * 10 + (ch - 48)
        if v > 65535 { return 0 }
        digits = digits + 1
        i = i + 1
    }
    if digits == 0 { return 0 }
    if out_ok_ptr != 0 { ptr_set(out_ok_ptr, 1) }
    return v
}

fn native_parse_i64_dec_cstr_or_neg1(s) {
    // Parse a non-negative decimal integer from a NUL-terminated cstr.
    // Returns parsed value on success; -1 on failure.
    //
    // Deterministic: decimal digits only (no spaces, signs, or suffixes).
    if s == 0 { return -1 }
    if ptr_get_byte(s) == 0 { return -1 }
    var v = 0
    var i = 0
    while true {
        var ch = ptr_get_byte(iadd(s, i))
        if ch == 0 { break }
        if ch < 48 || ch > 57 { return -1 }
        var d = ch - 48
        // Clamp to signed i64 max (9223372036854775807) to avoid overflow.
        if v > 922337203685477580 { return -1 }
        if v == 922337203685477580 && d > 7 { return -1 }
        v = v * 10 + d
        i = i + 1
    }
    return v
}

fn native_ipv4_is_loopback_ip4(ip4_ptr) {
    // Accept 127.0.0.0/8 as loopback.
    if ip4_ptr == 0 { return false }
    return ptr_get_byte(ip4_ptr + 0) == 127
}

fn native_capsule_net_endpoint_allowed_ip4(ip4_ptr, port, prefs) {
    // prefs: CSV cstr containing endpoint tokens.
    // ip4_ptr: 4 bytes (network order) or NULL.
    if prefs == 0 { return false }
    if ip4_ptr == 0 { return false }
    if port < 0 { return false }

    var n = native_cstr_len(prefs)
    var i = 0
    var start = 0
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(prefs, i)) }

        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var tok_start = start
            var tok_end = i
            while tok_start < tok_end && ptr_get_byte(iadd(prefs, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(prefs, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            var tok_len = tok_end - tok_start
            if tok_len > 0 {
                var colon = -1
                var j = tok_start
                while j < tok_end {
                    if ptr_get_byte(iadd(prefs, j)) == 58 { colon = j; break } // ':'
                    j = j + 1
                }

                var ip_start = tok_start
                var ip_end = tok_end
                var port_start = -1
                var port_end = -1
                if colon != -1 {
                    ip_end = colon
                    port_start = colon + 1
                    port_end = tok_end
                }

                // Match ip (supports '*' wildcard).
                var ip_ok = true
                while ip_start < ip_end && ptr_get_byte(iadd(prefs, ip_start)) == 32 { ip_start = ip_start + 1 }
                while ip_end > ip_start && ptr_get_byte(iadd(prefs, ip_end - 1)) == 32 { ip_end = ip_end - 1 }

                if ip_end - ip_start == 1 && ptr_get_byte(iadd(prefs, ip_start)) == 42 { // '*'
                    ip_ok = true
                } else {
                    // Parse token ip into tmp4 and compare bytes.
                    var tmp4 = malloc(4)
                    if tmp4 == 0 { return false }
                    oren_track_alloc(tmp4, 4, 0)
                    var ok = native_parse_ipv4_sub(prefs, ip_start, ip_end, tmp4)
                    if ok == 0 { ip_ok = false }
                    else {
                        if ptr_get_byte(tmp4 + 0) != ptr_get_byte(ip4_ptr + 0) { ip_ok = false }
                        if ptr_get_byte(tmp4 + 1) != ptr_get_byte(ip4_ptr + 1) { ip_ok = false }
                        if ptr_get_byte(tmp4 + 2) != ptr_get_byte(ip4_ptr + 2) { ip_ok = false }
                        if ptr_get_byte(tmp4 + 3) != ptr_get_byte(ip4_ptr + 3) { ip_ok = false }
                    }
                    free(tmp4)
                }

                if ip_ok {
                    // Match port (optional, supports '*').
                    var port_ok = true
                    if port_start != -1 {
                        while port_start < port_end && ptr_get_byte(iadd(prefs, port_start)) == 32 { port_start = port_start + 1 }
                        while port_end > port_start && ptr_get_byte(iadd(prefs, port_end - 1)) == 32 { port_end = port_end - 1 }

                        if port_end - port_start == 1 && ptr_get_byte(iadd(prefs, port_start)) == 42 { // '*'
                            port_ok = true
                        } else {
                            var ok2 = malloc(8)
                            if ok2 == 0 { return false }
                            oren_track_alloc(ok2, 8, 0)
                            var pv = native_parse_u16_sub(prefs, port_start, port_end, ok2)
                            var okv = ptr_get(ok2)
                            free(ok2)
                            if okv == 0 { port_ok = false }
                            else { if pv != port { port_ok = false } }
                        }
                    }
                    if port_ok { return true }
                }
            }

            start = i + 1
        }
        i = i + 1
    }
    return false
}

fn native_sockaddr_in_read_ip_port(addr, addrlen, out_ip4_ptr, out_port_ptr) {
    // Reads sockaddr_in into out buffers. Returns 1 on success.
    if addr == 0 { return 0 }
    if addrlen < 8 { return 0 }
    if out_ip4_ptr == 0 { return 0 }
    if out_port_ptr == 0 { return 0 }
    // sockaddr_in: [1]=AF_INET, [2..3]=port be, [4..7]=ip bytes
    if ptr_get_byte(addr + 1) != OREN_AF_INET { return 0 }
    ptr_set_byte(out_ip4_ptr + 0, ptr_get_byte(addr + 4))
    ptr_set_byte(out_ip4_ptr + 1, ptr_get_byte(addr + 5))
    ptr_set_byte(out_ip4_ptr + 2, ptr_get_byte(addr + 6))
    ptr_set_byte(out_ip4_ptr + 3, ptr_get_byte(addr + 7))
    var hi = ptr_get_byte(addr + 2)
    var lo = ptr_get_byte(addr + 3)
    var port = (hi << 8) | lo
    ptr_set(out_port_ptr, port)
    return 1
}

fn native_capsule_net_tcp_map_apply(addr, addrlen, map_csv) {
    // map_csv: CSV of "<virt_ip>:<virt_port>=<host_ip>:<host_port>".
    // If a mapping matches (virt == requested), rewrite sockaddr_in in place to host endpoint and return 1.
    if map_csv == 0 { return 0 }
    if ptr_get_byte(map_csv) == 0 { return 0 }
    if addr == 0 { return 0 }
    if addrlen < 8 { return 0 }
    if ptr_get_byte(addr + 1) != OREN_AF_INET { return 0 } // AF_INET only

    var req_ip4 = malloc(4)
    if req_ip4 == 0 { return 0 }
    oren_track_alloc(req_ip4, 4, 0)
    var req_port_ptr = malloc(8)
    if req_port_ptr == 0 { free(req_ip4); return 0 }
    oren_track_alloc(req_port_ptr, 8, 0)
    var ok = native_sockaddr_in_read_ip_port(addr, addrlen, req_ip4, req_port_ptr)
    if ok == 0 { free(req_ip4); free(req_port_ptr); return 0 }
    var req_port = ptr_get(req_port_ptr)

    var n = native_cstr_len(map_csv)
    var i = 0
    var start = 0
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(map_csv, i)) }
        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','
        if is_sep {
            var tok_start = start
            var tok_end = i
            while tok_start < tok_end && ptr_get_byte(iadd(map_csv, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(map_csv, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            // Find '='
            var eq = -1
            var j = tok_start
            while j < tok_end {
                if ptr_get_byte(iadd(map_csv, j)) == 61 { eq = j; break } // '='
                j = j + 1
            }
            if eq != -1 {
                var left_s = tok_start
                var left_e = eq
                var right_s = eq + 1
                var right_e = tok_end

                // Left: virt_ip:virt_port
                var l_colon = -1
                j = left_s
                while j < left_e {
                    if ptr_get_byte(iadd(map_csv, j)) == 58 { l_colon = j; break } // ':'
                    j = j + 1
                }
                // Right: host_ip:host_port
                var r_colon = -1
                j = right_s
                while j < right_e {
                    if ptr_get_byte(iadd(map_csv, j)) == 58 { r_colon = j; break } // ':'
                    j = j + 1
                }

                if l_colon != -1 && r_colon != -1 {
                    var virt_ip4 = malloc(4)
                    if virt_ip4 == 0 { free(req_ip4); free(req_port_ptr); return 0 }
                    oren_track_alloc(virt_ip4, 4, 0)
                    var host_ip4 = malloc(4)
                    if host_ip4 == 0 { free(req_ip4); free(req_port_ptr); free(virt_ip4); return 0 }
                    oren_track_alloc(host_ip4, 4, 0)

                    var ok_l_ip = native_parse_ipv4_sub(map_csv, left_s, l_colon, virt_ip4)
                    var ok_r_ip = native_parse_ipv4_sub(map_csv, right_s, r_colon, host_ip4)
                    var okp = malloc(8)
                    if okp == 0 { free(req_ip4); free(req_port_ptr); free(virt_ip4); free(host_ip4); return 0 }
                    oren_track_alloc(okp, 8, 0)
                    var virt_port = native_parse_u16_sub(map_csv, l_colon + 1, left_e, okp)
                    var ok_l_port = ptr_get(okp)
                    ptr_set(okp, 0)
                    var host_port = native_parse_u16_sub(map_csv, r_colon + 1, right_e, okp)
                    var ok_r_port = ptr_get(okp)
                    free(okp)

                    if ok_l_ip == 1 && ok_r_ip == 1 && ok_l_port == 1 && ok_r_port == 1 {
                        var ip_match = true
                        if ptr_get_byte(virt_ip4 + 0) != ptr_get_byte(req_ip4 + 0) { ip_match = false }
                        if ptr_get_byte(virt_ip4 + 1) != ptr_get_byte(req_ip4 + 1) { ip_match = false }
                        if ptr_get_byte(virt_ip4 + 2) != ptr_get_byte(req_ip4 + 2) { ip_match = false }
                        if ptr_get_byte(virt_ip4 + 3) != ptr_get_byte(req_ip4 + 3) { ip_match = false }
                        if ip_match && virt_port == req_port {
                            // Rewrite sockaddr to host endpoint.
                            ptr_set_byte(addr + 2, (host_port >> 8) & 255)
                            ptr_set_byte(addr + 3, host_port & 255)
                            ptr_set_byte(addr + 4, ptr_get_byte(host_ip4 + 0))
                            ptr_set_byte(addr + 5, ptr_get_byte(host_ip4 + 1))
                            ptr_set_byte(addr + 6, ptr_get_byte(host_ip4 + 2))
                            ptr_set_byte(addr + 7, ptr_get_byte(host_ip4 + 3))
                            free(req_ip4)
                            free(req_port_ptr)
                            free(virt_ip4)
                            free(host_ip4)
                            return 1
                        }
                    }
                    free(virt_ip4)
                    free(host_ip4)
                }
            }
            start = i + 1
        }
        i = i + 1
    }

    free(req_ip4)
    free(req_port_ptr)
    return 0
}

fn native_capsule_sys_socket_pre(domain, type, protocol) {
    // Enforce NET enrollment on raw syscalls in capsule mode (no bypass).
    native_capsule_require(CAP_NET, "NET")
    if global_get_capsule_mode() != 1 { return 0 }

    // Allow only AF_INET in v0.
    if domain != OREN_AF_INET {
        print("CAPSULE DENY: NET_SOCKET_DOMAIN")
        exit(79)
    }

    // Allow TCP/UDP only.
    if type == OREN_SOCK_STREAM { // SOCK_STREAM
        if protocol != 0 && protocol != OREN_IPPROTO_TCP {
            print("CAPSULE DENY: NET_SOCKET_PROTO")
            exit(79)
        }
        return 0
    }
    if type == OREN_SOCK_DGRAM { // SOCK_DGRAM
        if protocol != 0 && protocol != 17 {
            print("CAPSULE DENY: NET_SOCKET_PROTO")
            exit(79)
        }
        return 0
    }

    print("CAPSULE DENY: NET_SOCKET_TYPE")
    exit(79)
    return 0
}

fn native_capsule_sys_socket_post(fd, domain, type, protocol) {
    if global_get_capsule_mode() != 1 { return fd }
    if fd < 0 { return fd }
    // Tag fd kind (rolling):
    if domain == OREN_AF_INET {
        if type == OREN_SOCK_STREAM { native_capsule_net_fd_kind_set(fd, FD_KIND_TCP_STREAM) }
        if type == OREN_SOCK_DGRAM { native_capsule_net_fd_kind_set(fd, FD_KIND_UDP_DGRAM) }
    }
    return fd
}

fn native_capsule_sys_connect_pre(fd, addr, addrlen) {
    native_capsule_require(CAP_NET, "NET")
    if global_get_capsule_mode() != 1 { return 0 }

    // Require fd to be a socket created in this process (simple per-fd capability).
    if native_capsule_net_fd_kind_get(fd) == 0 {
        print("CAPSULE DENY: NET_FD")
        exit(79)
    }

    if addr == 0 || addrlen < 8 {
        print("CAPSULE DENY: NET_CONNECT_SOCKADDR")
        exit(79)
    }

    // Optional vnet-style mapping (enrollment mechanism).
    var map_csv = global_get_net_tcp_connect_map_ptr()
    var mapped = native_capsule_net_tcp_map_apply(addr, addrlen, map_csv)
    if mapped == 1 { return 0 }

    // Parse sockaddr_in and enforce endpoint allowlist / loopback.
    var ip4 = addr + 4
    var hi = ptr_get_byte(addr + 2)
    var lo = ptr_get_byte(addr + 3)
    var port = (hi << 8) | lo
    if ptr_get_byte(addr + 1) != OREN_AF_INET {
        print("CAPSULE DENY: NET_CONNECT_SOCKADDR")
        exit(79)
    }
    if global_get_net_allow_loopback() == 1 {
        if native_ipv4_is_loopback_ip4(ip4) { return 0 }
    }
    var prefs = global_get_net_allow_tcp_connect_ptr()
    if native_capsule_net_endpoint_allowed_ip4(ip4, port, prefs) { return 0 }
    print("CAPSULE DENY: NET_CONNECT")
    exit(79)
    return 0
}

fn native_capsule_sys_connect_post(rc, fd, addr, addrlen) {
    if global_get_capsule_mode() != 1 { return rc }
    if rc == 0 {
        // Mark stream socket as connected (still kind=1).
        if native_capsule_net_fd_kind_get(fd) == FD_KIND_TCP_STREAM {
            native_capsule_net_fd_kind_set(fd, FD_KIND_TCP_STREAM)
        }
    }
    return rc
}

fn native_capsule_sys_bind_pre(fd, addr, addrlen) {
    native_capsule_require(CAP_NET, "NET")
    if global_get_capsule_mode() != 1 { return 0 }
    if native_capsule_net_fd_kind_get(fd) == 0 {
        print("CAPSULE DENY: NET_FD")
        exit(79)
    }

    if addr == 0 || addrlen < 8 {
        print("CAPSULE DENY: NET_BIND_SOCKADDR")
        exit(79)
    }

    var map_csv = global_get_net_tcp_listen_map_ptr()
    var mapped = native_capsule_net_tcp_map_apply(addr, addrlen, map_csv)
    if mapped == 1 { return 0 }

    if ptr_get_byte(addr + 1) != OREN_AF_INET {
        print("CAPSULE DENY: NET_BIND_SOCKADDR")
        exit(79)
    }
    var ip4 = addr + 4
    var hi = ptr_get_byte(addr + 2)
    var lo = ptr_get_byte(addr + 3)
    var port = (hi << 8) | lo

    if global_get_net_allow_loopback() == 1 {
        if native_ipv4_is_loopback_ip4(ip4) { return 0 }
    }
    var prefs = global_get_net_allow_tcp_listen_ptr()
    if native_capsule_net_endpoint_allowed_ip4(ip4, port, prefs) { return 0 }
    print("CAPSULE DENY: NET_LISTEN")
    exit(79)
    return 0
}

fn native_capsule_sys_bind_post(rc, fd, addr, addrlen) {
    return rc
}

fn native_capsule_sys_listen_pre(fd, backlog) {
    native_capsule_require(CAP_NET, "NET")
    if global_get_capsule_mode() != 1 { return 0 }
    if native_capsule_net_fd_kind_get(fd) == 0 {
        print("CAPSULE DENY: NET_FD")
        exit(79)
    }
    return 0
}

fn native_capsule_sys_listen_post(rc, fd, backlog) {
    if global_get_capsule_mode() != 1 { return rc }
    if rc == 0 {
        // Mark as listening (kind=2).
        native_capsule_net_fd_kind_set(fd, FD_KIND_TCP_LISTEN)
    }
    return rc
}

fn native_capsule_sys_accept_pre(fd, addr, addrlen_ptr) {
    native_capsule_require(CAP_NET, "NET")
    if global_get_capsule_mode() != 1 { return 0 }
    if native_capsule_net_fd_kind_get(fd) != FD_KIND_TCP_LISTEN {
        print("CAPSULE DENY: NET_ACCEPT")
        exit(79)
    }
    return 0
}

fn native_capsule_sys_accept_post(newfd, listen_fd, addr, addrlen_ptr) {
    if global_get_capsule_mode() != 1 { return newfd }
    if newfd >= 0 {
        // Inherit "tcp stream" capability (kind=1).
        native_capsule_net_fd_kind_set(newfd, FD_KIND_TCP_STREAM)
    }
    return newfd
}

fn native_capsule_sys_getpeername_pre(fd, addr, addrlen_ptr) {
    // Enforce NET enrollment on raw syscalls in capsule mode (no bypass).
    native_capsule_require(CAP_NET, "NET")
    return 0
}

fn native_capsule_sys_getsockname_pre(fd, addr, addrlen_ptr) {
    // Enforce NET enrollment on raw syscalls in capsule mode (no bypass).
    native_capsule_require(CAP_NET, "NET")
    return 0
}

fn native_capsule_sys_getsockopt_pre(fd, level, optname, optval, optlen_ptr) {
    // Enforce NET enrollment on raw syscalls in capsule mode (no bypass).
    native_capsule_require(CAP_NET, "NET")
    return 0
}

fn native_capsule_sys_setsockopt_pre(fd, level, optname, optval, optlen) {
    // Enforce NET enrollment on raw syscalls in capsule mode (no bypass).
    native_capsule_require(CAP_NET, "NET")
    return 0
}

fn native_capsule_sys_shutdown_pre(fd, how) {
    // Enforce NET enrollment on raw syscalls in capsule mode (no bypass).
    native_capsule_require(CAP_NET, "NET")
    return 0
}

fn native_capsule_sys_dup_pre(fd) {
    // Enforce domain for raw sys_dup boundary (no bypass).
    native_capsule_require_fd_domain(fd)
    return fd
}

fn native_capsule_sys_dup_post(newfd, oldfd) {
    // Propagate fd kind tags across duplication so later fd-based gating (read/write/close/fcntl)
    // cannot be bypassed by dup'ing a tagged fd into an untagged slot.
    if global_get_capsule_mode() != 1 { return newfd }
    if newfd < 0 { return newfd }
    if oldfd < 0 { return newfd }
    var k = native_capsule_net_fd_kind_get(oldfd)
    native_capsule_net_fd_kind_clear(newfd)
    if k != 0 {
        native_capsule_net_fd_kind_set(newfd, k)
    }
    return newfd
}

fn native_capsule_sys_dup2_pre(oldfd, newfd) {
    // Enforce domain for raw sys_dup2 boundary (no bypass).
    native_capsule_require_fd_domain(oldfd)
    if global_get_capsule_mode() != 1 { return 0 }
    // dup2/dup3 can implicitly close `newfd` if it is already open.
    // For tagged fds (NET/PROC/TIME eventloop), require the corresponding domain as well
    // so programs cannot drop capabilities by dup-clobbering a tagged fd slot.
    if newfd >= 0 {
        var k = native_capsule_net_fd_kind_get(newfd)
        if k != 0 {
            native_capsule_require_fd_domain(newfd)
        }
    }
    return 0
}

fn native_capsule_sys_dup2_post(rc, oldfd, newfd) {
    // dup2/dup3 returns newfd on success.
    if global_get_capsule_mode() != 1 { return rc }
    if rc < 0 { return rc }
    var k = 0
    if oldfd >= 0 { k = native_capsule_net_fd_kind_get(oldfd) }
    if newfd >= 0 {
        native_capsule_net_fd_kind_clear(newfd)
        if k != 0 {
            native_capsule_net_fd_kind_set(newfd, k)
        }
    }
    return rc
}

fn native_capsule_sys_ioctl_pre(fd, req, argp) {
    // Enforce domain for raw sys_ioctl boundary (no bypass).
    //
    // ioctl is extremely powerful: it can mutate kernel-visible state associated with an fd,
    // including socket flags, tty/pty settings, and various device controls.
    // In capsule mode, we gate it based on fd kind:
    // - NET-tagged fds require NET
    // - PROC pipes require PROC
    // - other fds require FS
    native_capsule_require_fd_domain(fd)
    return 0
}

fn native_capsule_sys_sendto_pre(fd, buf, len, flags, to, tolen) {
    native_capsule_require(CAP_NET, "NET")
    if global_get_capsule_mode() != 1 { return 0 }
    var k = native_capsule_net_fd_kind_get(fd)
    if k == 0 {
        print("CAPSULE DENY: NET_FD")
        exit(79)
    }
    // Disallow sending on listening sockets.
    if k == FD_KIND_TCP_LISTEN {
        print("CAPSULE DENY: NET_SEND_LISTEN")
        exit(79)
    }

    // For datagrams with explicit destination, enforce endpoint allowlist.
    if to != 0 {
        if tolen < 8 || ptr_get_byte(to + 1) != OREN_AF_INET {
            print("CAPSULE DENY: NET_SENDTO_SOCKADDR")
            exit(79)
        }
        var ip4 = to + 4
        var hi = ptr_get_byte(to + 2)
        var lo = ptr_get_byte(to + 3)
        var port = (hi << 8) | lo
        var map_csv = global_get_net_tcp_connect_map_ptr()
        var mapped = native_capsule_net_tcp_map_apply(to, tolen, map_csv)
        if mapped == 1 { return 0 }
        if global_get_net_allow_loopback() == 1 {
            if native_ipv4_is_loopback_ip4(ip4) { return 0 }
        }
        var prefs = global_get_net_allow_tcp_connect_ptr()
        if native_capsule_net_endpoint_allowed_ip4(ip4, port, prefs) { return 0 }
        print("CAPSULE DENY: NET_SENDTO")
        exit(79)
    }
    return 0
}

fn native_capsule_sys_recvfrom_pre(fd, buf, len, flags, from, fromlen) {
    native_capsule_require(CAP_NET, "NET")
    if global_get_capsule_mode() != 1 { return 0 }
    var k = native_capsule_net_fd_kind_get(fd)
    if k == 0 {
        print("CAPSULE DENY: NET_FD")
        exit(79)
    }
    if k == FD_KIND_TCP_LISTEN {
        print("CAPSULE DENY: NET_RECV_LISTEN")
        exit(79)
    }
    return 0
}

fn native_capsule_sys_close_post(rc, fd) {
    if global_get_capsule_mode() != 1 { return rc }
    if rc == 0 {
        native_capsule_net_fd_kind_clear(fd)
    }
    return rc
}

fn native_capsule_require_proc_system() {
    // `oren_system(_timeout)` is considered a convenience API and is intentionally
    // blocked in capsule mode unless explicitly enabled (it executes a shell).
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }
    if global_get_proc_allow_system() == 1 { return 0 }
    print("CAPSULE DENY: PROC_SYSTEM")
    exit(81)
    return 0
}

fn native_capsule_require_proc_exec(path) {
    // Deny-by-default subprocess exec in capsule mode unless an explicit exec prefix allowlist is provided.
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }
    var prefs = global_get_proc_allow_exec_prefixes_ptr()
    if native_capsule_fs_path_allowed(path, prefs) { return 0 }
    print("CAPSULE DENY: PROC_EXEC")
    exit(80)
    return 0
}

fn native_capsule_proc_match_token(arg, tok_ptr, tok_len) {
    // Supports:
    // - "*" wildcard token (matches any string, including empty)
    // - "<prefix>*" suffix-wildcard token (matches any string starting with <prefix>)
    if tok_len == 1 {
        if ptr_get_byte(tok_ptr) == 42 { return true } // '*'
    }

    if arg == 0 { return false }

    // Prefix wildcard: "abc*" matches "abc", "abcd", "abcXYZ", ...
    // Rolling: we only support '*' as the last byte to keep the matcher simple and deterministic.
    if tok_len > 1 {
        if ptr_get_byte(tok_ptr + (tok_len - 1)) == 42 { // '*'
            var plen = tok_len - 1
            var i2 = 0
            while i2 < plen {
                var ac2 = ptr_get_byte(arg + i2)
                if ac2 == 0 { return false }
                if ac2 != ptr_get_byte(tok_ptr + i2) { return false }
                i2 = i2 + 1
                if i2 > 4096 { return false }
            }
            return true
        }
    }

    var i = 0
    while i < tok_len {
        var ac = ptr_get_byte(arg + i)
        if ac == 0 { return false }
        if ac != ptr_get_byte(tok_ptr + i) { return false }
        i = i + 1
        if i > 4096 { return false }
    }
    // Must end exactly here.
    if ptr_get_byte(arg + tok_len) != 0 { return false }
    return true
}

fn native_capsule_require_proc_argv(exec_path, argv_ptrs, argc) {
    // argv allowlist (capsule mode):
    // - Deny-by-default when PROC is enabled in capsule mode.
    // - Allowlist is configured via OREN_PROC_ALLOW_ARGV.
    //
    // Format:
    //   OREN_PROC_ALLOW_ARGV="<path>|<argv0>[|<arg1>...],<path>|...,..."
    //
    // Matching:
    // - First field must match exec_path exactly.
    // - Remaining fields match argv[0..] exactly.
    // - A trailing "*" token matches any remaining argv items (including none).
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }

    var allow = global_get_proc_allow_argv_ptr()
    if allow == 0 {
        print("CAPSULE DENY: PROC_ARGV (missing OREN_PROC_ALLOW_ARGV)")
        exit(82)
        return 0
    }
    if ptr_get_byte(allow) == 0 {
        print("CAPSULE DENY: PROC_ARGV (empty OREN_PROC_ALLOW_ARGV)")
        exit(82)
        return 0
    }

    var n = native_cstr_len(allow)
    var i = 0
    var start = 0
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(allow + i) }
        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var spec_start = start
            var spec_end = i
            while spec_start < spec_end && ptr_get_byte(allow + spec_start) == 32 { spec_start = spec_start + 1 }
            while spec_end > spec_start && ptr_get_byte(allow + spec_end - 1) == 32 { spec_end = spec_end - 1 }

            if spec_end > spec_start {
                // Parse exec_path token (up to first '|')
                var bar = -1
                var j = spec_start
                while j < spec_end {
                    if ptr_get_byte(allow + j) == 124 { bar = j; break } // '|'
                    j = j + 1
                }

                if bar != -1 {
                    var p0 = spec_start
                    var p1 = bar
                    while p0 < p1 && ptr_get_byte(allow + p0) == 32 { p0 = p0 + 1 }
                    while p1 > p0 && ptr_get_byte(allow + p1 - 1) == 32 { p1 = p1 - 1 }
                    var plen = p1 - p0
                    if plen > 0 {
                        // Compare exec_path
                        var match_path = native_capsule_proc_match_token(exec_path, allow + p0, plen)
                        if match_path {
                            // Parse argv tokens and compare.
                            var ok = true
                            var argi = 0
                            var tstart = bar + 1
                            var saw_trailing_star = false
                            while tstart <= spec_end {
                                var tend = tstart
                                while tend < spec_end && ptr_get_byte(allow + tend) != 124 { tend = tend + 1 }

                                // Trim token
                                var a0 = tstart
                                var a1 = tend
                                while a0 < a1 && ptr_get_byte(allow + a0) == 32 { a0 = a0 + 1 }
                                while a1 > a0 && ptr_get_byte(allow + a1 - 1) == 32 { a1 = a1 - 1 }
                                var alen = a1 - a0
                                if alen <= 0 { ok = false }
                                else {
                                    // Trailing "*" matches rest.
                                    if alen == 1 && ptr_get_byte(allow + a0) == 42 {
                                        // '*' token
                                        if tend == spec_end {
                                            saw_trailing_star = true
                                            break
                                        }
                                    }

                                    if argi >= argc { ok = false }
                                    else {
                                        var arg = ptr_get(argv_ptrs + (argi * 8))
                                        if native_capsule_proc_match_token(arg, allow + a0, alen) != true { ok = false }
                                    }
                                }

                                if ok != true { break }
                                argi = argi + 1
                                if tend == spec_end { break }
                                tstart = tend + 1
                            }

                            if ok {
                                if saw_trailing_star { return 0 }
                                if argi == argc { return 0 }
                            }
                        }
                    }
                }
            }

            start = i + 1
        }
        i = i + 1
    }

    print("CAPSULE DENY: PROC_ARGV")
    exit(82)
    return 0
}

fn native_capsule_proc_register_pid(pid) {
    // Register a child pid as "owned" by this process so capsule mode can allow
    // wait/kill only for those pids.
    if global_get_capsule_mode() != 1 { return 0 }
    if pid <= 0 { return 0 }
    var tab = global_get_proc_allowed_pids_ptr()
    if tab == 0 { return 0 }
    var cap = global_get_proc_allowed_pids_cap()
    if cap <= 0 { return 0 }
    var len = global_get_proc_allowed_pids_len()
    if len < 0 { len = 0 }

    // Already present?
    var i = 0
    while i < cap {
        var v = ptr_get(iadd(tab, i * 8))
        if v == pid { return 0 }
        i = i + 1
    }

    // Insert into first empty slot.
    i = 0
    while i < cap {
        if ptr_get(iadd(tab, i * 8)) == 0 {
            ptr_set(iadd(tab, i * 8), pid)
            global_set_proc_allowed_pids_len(len + 1)
            return 0
        }
        i = i + 1
    }
    return 0
}

fn native_capsule_proc_pid_allowed(pid) {
    if global_get_capsule_mode() != 1 { return true }
    if pid <= 0 { return false }
    var tab = global_get_proc_allowed_pids_ptr()
    if tab == 0 { return false }
    var cap = global_get_proc_allowed_pids_cap()
    if cap <= 0 { return false }
    var i = 0
    while i < cap {
        if ptr_get(iadd(tab, i * 8)) == pid { return true }
        i = i + 1
    }
    return false
}

fn native_argv_ptrs_count(argv_ptrs) {
    // Count argv pointers until NULL, capped.
    if argv_ptrs == 0 { return 0 }
    var i = 0
    while i < 4096 {
        var p = ptr_get(iadd(argv_ptrs, i * 8))
        if p == 0 { return i }
        i = i + 1
    }
    return -1
}

fn native_capsule_sys_getcwd_pre() {
    // Reading the host cwd leaks host FS state; require FS enrollment in capsule mode.
    native_capsule_require(CAP_FS, "FS")
    return 0
}

fn native_capsule_sys_clone_pre() {
    // clone is a process/thread creation primitive; require PROC enrollment in capsule mode.
    native_capsule_require(CAP_PROC, "PROC")
    return 0
}

fn native_capsule_sys_bsdthread_register_pre() {
    // bsdthread_register initializes the OS thread substrate; treat it as PROC-domain in capsule mode.
    native_capsule_require(CAP_PROC, "PROC")
    return 0
}

fn native_capsule_sys_fork_pre() {
    // PROC is required for fork in capsule mode.
    native_capsule_require(CAP_PROC, "PROC")
    return 0
}

fn native_capsule_sys_fork_post(pid) {
    // Register the returned pid so raw sys_wait4/sys_kill can operate on it in capsule mode.
    // This is required for syscall-first spawn/join (fork+pipe) to work under PROC-only enrollment.
    native_capsule_proc_register_pid(pid)
    return pid
}

fn native_capsule_sys_gettimeofday_pre(tv_ptr, tz_ptr, abs_ptr) {
    // Enforce TIME enrollment at raw sys_gettimeofday boundary (no bypass).
    native_capsule_require(CAP_TIME, "TIME")
    return 0
}

fn native_capsule_sys_nanosleep_pre(ns) {
    // Enforce TIME enrollment at raw sys_nanosleep boundary (no bypass).
    //
    // Optimization: ns<=0 is a no-op; allow it without TIME to avoid surprising callers.
    if ns <= 0 { return ns }
    native_capsule_require(CAP_TIME, "TIME")
    return ns
}

fn native_capsule_sys_kqueue_pre() {
    // Enforce enrollment on raw sys_kqueue (no bypass).
    //
    // kqueue/kevent are a general "event loop" primitive used by multiple domains:
    // - TIME: syscall-first sleep (nanosleep on macOS uses kevent timeout)
    // - NET: socket readiness waits / connect timeouts
    // - PROC: cancellable waits / IPC support
    //
    // Rolling rule: allow if any of NET/PROC/TIME is enrolled.
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    return 0
}

fn native_capsule_sys_kqueue_post(kq_fd) {
    // Tag returned kqueue fd so fd-based syscalls (close/fcntl) enforce the right domain.
    if global_get_capsule_mode() != 1 { return kq_fd }
    if kq_fd < 0 { return kq_fd }
    native_capsule_net_fd_kind_set(kq_fd, FD_KIND_KQUEUE)
    return kq_fd
}

fn native_capsule_sys_kevent_pre() {
    // Enforce enrollment on raw sys_kevent (no bypass).
    // Rolling rule: allow if any of NET/PROC/TIME is enrolled.
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    return 0
}

fn native_capsule_sys_epoll_create1_pre(flags) {
    // Enforce enrollment on raw sys_epoll_create1 (no bypass).
    // Rolling rule: allow if any of NET/PROC/TIME is enrolled.
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    return flags
}

fn native_capsule_sys_epoll_create1_post(epfd) {
    // Tag returned epoll fd so fd-based syscalls (close/fcntl) enforce the right domain.
    if global_get_capsule_mode() != 1 { return epfd }
    if epfd < 0 { return epfd }
    native_capsule_net_fd_kind_set(epfd, FD_KIND_EPOLL)
    return epfd
}

fn native_capsule_sys_epoll_ctl_pre(epfd, op, fd, event_ptr) {
    // Enforce enrollment on raw sys_epoll_ctl (no bypass).
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    // Ensure the epoll fd itself is within an allowed domain.
    native_capsule_require_fd_domain(epfd)
    // Ensure the target fd is within an allowed domain (NET socket, PROC pipe, etc).
    native_capsule_require_fd_domain(fd)
    return 0
}

fn native_capsule_sys_epoll_pwait_pre(epfd, events_ptr, maxevents, timeout_ms, sigmask_ptr, sigsetsize) {
    // Enforce enrollment on raw sys_epoll_pwait (no bypass).
    // Rolling rule: allow if any of NET/PROC/TIME is enrolled.
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    native_capsule_require_fd_domain(epfd)
    return 0
}

fn native_capsule_sys_execve_pre(path, argv_ptrs, envp_ptrs) {
    // Enforce PROC enrollment on raw sys_execve (no bypass).
    //
    // Returns the envp pointer to use for the syscall:
    // - non-capsule: returns envp_ptrs unchanged
    // - capsule: returns a filtered envp that preserves OREN_* capsule enforcement
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return envp_ptrs }

    native_capsule_require_proc_exec(path)

    var argc = native_argv_ptrs_count(argv_ptrs)
    if argc <= 0 {
        print("CAPSULE DENY: PROC_ARGV (invalid argv)")
        exit(80)
    }
    native_capsule_require_proc_argv(path, argv_ptrs, argc)

    // Ignore the caller-provided envp to prevent "escape capsule" by env filtering.
    var envp = native_runtime_get_envp_for_proc_child()
    if envp == 0 { exit(127) }
    return envp
}

fn native_capsule_sys_wait4_pre(pid, options) {
    // Enforce PROC enrollment on raw sys_wait4 (no bypass).
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }
    // Deny pid=-1/0 in capsule mode for now; require explicit registered child pid.
    if pid <= 0 {
        print("CAPSULE DENY: PROC_WAIT")
        exit(80)
    }
    if native_capsule_proc_pid_allowed(pid) != true {
        print("CAPSULE DENY: PROC_WAIT")
        exit(80)
    }
    return 0
}

fn native_capsule_sys_kill_pre(pid, signum) {
    // Enforce PROC enrollment on raw sys_kill (no bypass).
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }
    if pid <= 0 {
        print("CAPSULE DENY: PROC_KILL")
        exit(80)
    }
    if native_capsule_proc_pid_allowed(pid) != true {
        print("CAPSULE DENY: PROC_KILL")
        exit(80)
    }
    if signum < 0 || signum > 64 {
        print("CAPSULE DENY: PROC_KILL")
        exit(80)
    }
    return 0
}

// --- ENV (syscall-free; reads process initial envp block) ---
//
// Returns pointer to value substring for KEY in envp ("KEY=VALUE"), or 0 if not found.
// NOTE: This returns a pointer into the process environment strings (not a copy).
@cap.requires(domain="ENV")
fn oren_getenv(key) {
    native_capsule_require(CAP_ENV, "ENV")
    // Keep this leaf-like (no calls) to avoid any cross-call local slot issues
    // while the native backend ABI is still rolling.
    if key == 0 { return 0 }

    var g = oren_globals()
    var envp = ptr_get(iadd(g, GLOBAL_OFF_ENVP))

    // If envp wasn't captured at entry, derive it from argv/argc layout:
    // envp starts right after argv[argc] and the NULL terminator.
    var argc = ptr_get(iadd(g, GLOBAL_OFF_ARGC))
    var argv = ptr_get(iadd(g, GLOBAL_OFF_ARGV))
    if envp == 0 {
        if argv == 0 { return 0 }
        envp = iadd(argv, (iadd(argc, 1)) * 8)
    }
    if envp == 0 { return 0 }

    // key_len = strlen(key)
    var key_len = 0
    // Hard cap to avoid hangs if `key` is malformed / unterminated.
    while key_len < 4096 {
        if ptr_get_byte(iadd(key, key_len)) == 0 { break }
        key_len = key_len + 1
    }
    if key_len >= 4096 { return 0 }

    // Hard cap to avoid hangs if envp is malformed / unterminated.
    var i = 0
    while i < 4096 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { return 0 }

        // Check prefix match "KEY="
        var j = 0
        while j < key_len {
            if ptr_get_byte(iadd(ent, j)) != ptr_get_byte(iadd(key, j)) {
                j = -1
                break
            }
            j = j + 1
        }

        if j != -1 {
            if ptr_get_byte(iadd(ent, key_len)) == 61 { // '='
                return iadd(ent, key_len + 1)
            }
        }

        i = i + 1
    }
    return 0
}

// --- TIME (syscall-first) ---
//
// Provide a minimal “sleep” primitive without libc.
// We keep TIME intentionally small in v0: higher-level deadlines/cancellation can be built on top.
//
// sys_nanosleep(ns) is a native-backend intrinsic implemented per-OS:
// - macOS: kqueue/kevent timeout (no libc shims)
// - Linux: nanosleep syscall
//
// Returns 0 on success, or -errno.
@cap.requires(domain="TIME")
fn oren_sleep_ns(ns) {
    native_capsule_require(CAP_TIME, "TIME")
    if ns <= 0 { return 0 }
    return sys_nanosleep(ns)
}

@cap.requires(domain="TIME")
fn oren_sleep_ms(ms) {
    native_capsule_require(CAP_TIME, "TIME")
    if ms <= 0 { return 0 }
    // ms -> ns
    return sys_nanosleep(ms * 1000000)
}

fn oren_kill(pid, signum) {
    return sys_kill(pid, signum)
}

// Wall time in nanoseconds since Unix epoch (best-effort; not monotonic).
fn oren_time_unix_ns() {
    // struct timeval { tv_sec(u64), tv_usec(u64) } (we use 2x u64 for simplicity)
    var tv = malloc(16)
    if tv == 0 { return 0 }
    ptr_set(tv + 0, 0)
    ptr_set(tv + 8, 0)

    var rc = sys_gettimeofday(tv, 0, 0)
    if rc < 0 {
        free(tv)
        return 0
    }

    var sec = ptr_get(tv + 0)
    var usec = ptr_get(tv + 8)
    free(tv)
    return sec * 1000000000 + usec * 1000
}

// Rolling alias used by stdlib + AVM parity.
fn oren_time_now_ns() {
    return oren_time_unix_ns()
}

// Monotonic “raw” time. For correctness, treat as compare-only (do not assume units).
// On Linux, this will be nanoseconds (via clock_gettime64 monotonic in the intrinsic).
// On macOS, this is mach_absolute_time units (returned by gettimeofday's 3rd out-arg).
fn oren_time_mono_raw() {
    var tv = malloc(16)
    if tv == 0 { return 0 }
    ptr_set(tv + 0, 0)
    ptr_set(tv + 8, 0)

    var abs_ptr = malloc(8)
    if abs_ptr == 0 {
        free(tv)
        return 0
    }
    ptr_set(abs_ptr, 0)

    var rc = sys_gettimeofday(tv, 0, abs_ptr)
    if rc < 0 {
        free(abs_ptr)
        free(tv)
        return 0
    }

    var t = ptr_get(abs_ptr)
    free(abs_ptr)
    free(tv)
    return t
}

fn oren_register_thread(top) {
    // Thread Node: [top, saved_sp, next] (24 bytes)
    // Runtime metadata: use malloc_raw so GC never reclaims thread nodes.
    var node = malloc_raw(24)
    if node != 0 {
        ptr_set(node, top)
        ptr_set(iadd(node, 8), 0) // saved_sp
        
        // Link
        acquire_lock()
        
        ptr_set(iadd(node, 16), global_get_threads())
        global_set_threads(node)
        
        release_lock()
    }
    return node
}

fn get_sp() { return 0 } // Intrinsic

// GC mode toggle (native backend):
// - enabled (default): conservative mark/sweep from stack + registered roots
// - disabled (deterministic/manual): disable scanning/collection; keep tracking so `free()` can reuse blocks
var g_gc_enabled = 1

fn native_runtime_init_gc_mode(default_enabled) {
    // default_enabled is provided by the compiler from `--no-gc`.
    g_gc_enabled = default_enabled

    // Runtime override: allow disabling GC via environment variable.
    // Any non-empty value disables scanning/collection.
    var v = native_envp_get_value_ptr("OREN_NO_GC")
    if v != 0 {
        if ptr_get_byte(v) != 0 { g_gc_enabled = 0 }
    }
    return 0
}

fn native_gc_scan_stack() {
    if g_gc_enabled == 0 { return 0 }
    var sp = get_sp()
    var cur = global_get_threads()
    
    while cur != 0 {
        var top = ptr_get(cur)
        var saved = ptr_get(iadd(cur, 8))
        var start = 0
        
        // Check if this is current thread
        // Heuristic: sp is within 8MB below top
        // 8MB = 8388608
        if sp < top {
            var diff = top - sp
            if diff < 8388608 {
                start = sp
            }
        }
        
        if start == 0 {
            start = saved
        }
        
        if start != 0 {
            while start < top {
                var val = ptr_get(start)
                oren_mark_value(val)
                start = iadd(start, 8)
            }
        }
        
        cur = ptr_get(iadd(cur, 16))
    }
    return 0
}

// Node layout: [ptr, size, kind, freed, next] (5 * 8 = 40 bytes)
// Offsets: 0=ptr, 8=size, 16=kind, 24=freed, 32=next

// Try to reuse a raw node allocation (used by malloc_raw callers like root lists).
// This must NOT reuse freed "blocks" (which are tracked allocation records pointing at object memory),
// otherwise we'd lose pointers to freed object memory and create leaks/corruption.
fn native_try_reuse_node(size) {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var prev = 0
    var cur = global_get_free_nodes()
    while cur != 0 {
        var node_size = ptr_get(iadd(cur, 8))
        if node_size >= size {
            var next = ptr_get(iadd(cur, 32))
            if prev == 0 {
                global_set_free_nodes(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }
            // Clear next pointer; caller will overwrite fields.
            ptr_set(iadd(cur, 32), 0)
            release_lock()
            return cur
        }
        prev = cur
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return 0
}

fn native_try_reuse(size) {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    // Simple first-fit from the free list.
    var prev = 0
    var cur = global_get_free_blocks()
    while cur != 0 {
        var chunk_size = ptr_get(iadd(cur, 8))
        if chunk_size >= size {
            // Unlink from free list.
            var next = ptr_get(iadd(cur, 32))
            if prev == 0 {
                global_set_free_blocks(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }

            // Reactivate this tracking node by placing it back into allocs.
            // NOTE:
            // - We keep chunk_size (capacity) as-is; size is the requested logical size.
            // - kind defaults to 5 (misc). Callers may later call `oren_track_alloc(...)`
            //   to specialize kind (e.g. string/list/map/struct/func).
            ptr_set(iadd(cur, 8), size)
            ptr_set(iadd(cur, 16), 5)
            ptr_set(iadd(cur, 24), 0) // not freed, not marked
            ptr_set(iadd(cur, 32), global_get_allocs())
            global_set_allocs(cur)

            var out = ptr_get(cur)
            release_lock()
            return out
        }
        prev = cur
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return 0
}

var g_panicking = 0

fn acquire_lock() {
    if g_panicking == 1 { return 0 }
    if oren_globals() == 0 { return 0 }
    
    var tid = sys_gettid()
    var lock_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_OWNER_TID)
    var owner = ptr_get(lock_ptr)
    
    if owner == tid {
        var count_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_RECURSE_COUNT)
        var count = ptr_get(count_ptr)
        ptr_set(count_ptr, iadd(count, 1))
        return 0
    }
    
    var spin = 0
    while atomic_cas(lock_ptr, 0, tid) != 0 {
        if g_panicking == 1 { return 0 }
        spin = iadd(spin, 1)
        // Park after a small amount of spinning to avoid burning CPU.
        if spin > 1000 {
            // Wait while lock owner hasn't changed.
            var owner_now = ptr_get(lock_ptr)
            if owner_now != 0 {
                // operation=UL_COMPARE_AND_WAIT (1), timeout_us=0 => forever
                sys_ulock_wait(1, lock_ptr, owner_now, 0)
            }
            spin = 0
        }
    }
    
    var count_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_RECURSE_COUNT)
    ptr_set(count_ptr, 1)
    return 0
}

fn release_lock() {
    if g_panicking == 1 { return 0 }
    if oren_globals() == 0 { return 0 }
    
    var tid = sys_gettid()
    var lock_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_OWNER_TID)
    var owner = ptr_get(lock_ptr)
    
    if owner != tid {
        return 0
    }
    
    var count_ptr = iadd(oren_globals(), GLOBAL_OFF_LOCK_RECURSE_COUNT)
    var count = ptr_get(count_ptr)
    if count > 1 {
        ptr_set(count_ptr, count - 1)
        return 0
    }
    
    ptr_set(count_ptr, 0)
    atomic_cas(lock_ptr, tid, 0)
    // Wake any waiters that parked in acquire_lock.
    // operation=UL_COMPARE_AND_WAIT|ULF_WAKE_ALL = 1|0x100 = 257
    sys_ulock_wake(257, lock_ptr, 0)
    return 0
}

fn malloc_raw(size) { return 0 }

fn oren_track_alloc(ptr, size, kind) {
    if oren_globals() == 0 { return ptr }
    acquire_lock()

    // De-duplicate: if already tracked (allocs), update in place.
    var cur = global_get_allocs()
    while cur != 0 {
        if ptr_get(cur) == ptr {
            if size != 0 { ptr_set(iadd(cur, 8), size) }
            if kind != 0 { ptr_set(iadd(cur, 16), kind) }
            // Clear "freed" and mark flags on re-track.
            ptr_set(iadd(cur, 24), 0)
            release_lock()
            return ptr
        }
        cur = ptr_get(iadd(cur, 32))
    }

    // If it exists in the free list (reused pointer or manual re-track),
    // move it back into allocs to avoid duplicate nodes pointing at the same ptr.
    var prev = 0
    cur = global_get_free_blocks()
    while cur != 0 {
        if ptr_get(cur) == ptr {
            var next = ptr_get(iadd(cur, 32))
            if prev == 0 {
                global_set_free_blocks(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }

            ptr_set(iadd(cur, 8), size)
            ptr_set(iadd(cur, 16), kind)
            ptr_set(iadd(cur, 24), 0)
            ptr_set(iadd(cur, 32), global_get_allocs())
            global_set_allocs(cur)

            release_lock()
            return ptr
        }
        prev = cur
        cur = ptr_get(iadd(cur, 32))
    }

    // Allocate a new tracking node.
    var node = malloc_raw(40)
    if node != 0 {
        ptr_set(node, ptr)
        ptr_set(iadd(node, 8), size)
        ptr_set(iadd(node, 16), kind)
        ptr_set(iadd(node, 24), 0) // not freed, not marked
        ptr_set(iadd(node, 32), global_get_allocs())
        global_set_allocs(node)
    }

    release_lock()
    return ptr
}

fn native_gc_register_root(ptr) {
    if g_gc_enabled == 0 { return 0 }
    if ptr == 0 { return 0 }
    acquire_lock()
    
    var node = malloc_raw(40)
    if node != 0 {
        ptr_set(node, ptr)
        ptr_set(iadd(node, 8), 0)
        ptr_set(iadd(node, 16), 0) // kind 0 for root
        ptr_set(iadd(node, 24), 0)
        ptr_set(iadd(node, 32), global_get_roots())
        global_set_roots(node)
    }
    
    release_lock()
    return 0
}

fn native_gc_unregister_root(ptr) {
    if g_gc_enabled == 0 { return 0 }
    if ptr == 0 { return 0 }
    acquire_lock()

    var prev = 0
    var cur = global_get_roots()
    while cur != 0 {
        var next = ptr_get(iadd(cur, 32))
        if ptr_get(cur) == ptr {
            if prev == 0 {
                global_set_roots(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }
            // Reuse node storage via free list.
            ptr_set(cur, 0)
            ptr_set(iadd(cur, 8), 40)
            ptr_set(iadd(cur, 16), 0)
            ptr_set(iadd(cur, 24), 0)
            ptr_set(iadd(cur, 32), global_get_free_nodes())
            global_set_free_nodes(cur)
            release_lock()
            return 0
        }
        prev = cur
        cur = next
    }

    release_lock()
    return 0
}

fn oren_find_node(ptr) {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var cur = global_get_allocs()
    while cur != 0 {
        if ptr_get(cur) == ptr { 
            release_lock()
            return cur 
        }
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return 0
}

fn oren_mark_value(val) {
    if g_gc_enabled == 0 { return 0 }
    if val == 0 { return 0 }
    
    var node = oren_find_node(val)
    if node != 0 {
        var freed = ptr_get(iadd(node, 24))
        if freed == 0 {
            // Mark it
            ptr_set(iadd(node, 24), -1)
            
            var kind = ptr_get(iadd(node, 16))
            if kind == 2 { // LIST
                var count = ptr_get(val)
                var buf = ptr_get(iadd(val, 16))
                if buf != 0 {
                    var i = 0
                    while i < count {
                        var item = ptr_get(iadd(buf, i * 8))
                        oren_mark_value(item)
                        i = i + 1
                    }
                    oren_mark_value(buf)
                }
            }
            if kind == 3 { // MAP
                var count = ptr_get(iadd(val, 0))
                var buf = ptr_get(iadd(val, 16))
                var i = 0
                while i < count {
                    var k = ptr_get(iadd(buf, i * 16))
                    var v = ptr_get(iadd(buf, i * 16 + 8))
                    oren_mark_value(k)
                    oren_mark_value(v)
                    i = i + 1
                }
                // Keep the entries buffer alive (tracked allocation).
                oren_mark_value(buf)
            }
            if kind == 6 { // FUNC (closure env)
                var env = ptr_get(iadd(val, 8))
                oren_mark_value(env)
            }
            if kind == 7 { // BUF (typed buffers)
                // Buffer header holds an owned payload pointer at +16.
                // Keep the payload alive while the header is reachable.
                var buf = ptr_get(iadd(val, 16))
                oren_mark_value(buf)
            }
        }
    }
    return 0
}

fn native_gc_collect() {
    if g_gc_enabled == 0 { return 0 }
    // 1. Clear marks
    var cur = global_get_allocs()
    while cur != 0 {
        if ptr_get(iadd(cur, 24)) == -1 {
            ptr_set(iadd(cur, 24), 0)
        }
        cur = ptr_get(iadd(cur, 32))
    }
    
    // 2. Mark stack
    native_gc_scan_stack()

    // 3. Mark roots
    var r = global_get_roots()
    while r != 0 {
        var slot = ptr_get(r)
        if slot != 0 {
            var val = ptr_get(slot)
            oren_mark_value(val)
        }
        r = ptr_get(iadd(r, 32))
    }
    
    // 4. Sweep
    var prev = 0
    cur = global_get_allocs()
    while cur != 0 {
        var marked = 0
        if ptr_get(iadd(cur, 24)) == -1 { marked = 1 }
        
        var next_node = ptr_get(iadd(cur, 32))
        
        if marked == 1 {
            ptr_set(iadd(cur, 24), 0)
            prev = cur
        } else {
            // Garbage
            if prev == 0 {
                global_set_allocs(next_node)
            } else {
                ptr_set(iadd(prev, 32), next_node)
            }

            var kind = ptr_get(iadd(cur, 16))
            if kind == 9 {
                // RAW_MMAP: return memory to OS immediately (do not keep in free_blocks).
                var p = ptr_get(cur)
                if p != 0 {
                    var base = p - raw_hdr_size()
                    if ptr_get(base + 0) == raw_magic() {
                        var total = ptr_get(base + 8)
                        var backend = ptr_get(base + 16)
                        if backend == 1 && total > 0 {
                            // best-effort
                            sys_munmap(base, total)
                        }
                    }
                }

                // Reuse the tracking node storage via free_nodes list.
                ptr_set(cur, 0)
                ptr_set(iadd(cur, 8), 40)
                ptr_set(iadd(cur, 16), 0)
                ptr_set(iadd(cur, 24), 0)
                ptr_set(iadd(cur, 32), global_get_free_nodes())
                global_set_free_nodes(cur)
            } else {
                ptr_set(iadd(cur, 32), global_get_free_blocks())
                global_set_free_blocks(cur)
            }
        }
        cur = next_node
    }
    return 0
}

// --- Memory diagnostics (native backend; failure-only surfaces) ---
//
// These helpers intentionally return plain integers and do not allocate, so they can be used
// inside tests and long-running processes without perturbing the heap significantly.
//
// NOTE:
// - `global_get_allocs()` includes live allocations (tracked nodes).
// - `global_get_free_blocks()` includes freed blocks kept for reuse (not returned to OS).
// - These diagnostics are about "leaks / runaway growth" in the runtime sense, not RSS.

fn native_mem_live_count() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var n = 0
    var cur = global_get_allocs()
    while cur != 0 {
        n = n + 1
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return n
}

fn native_mem_live_bytes() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var sum = 0
    var cur = global_get_allocs()
    while cur != 0 {
        sum = sum + ptr_get(iadd(cur, 8))
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return sum
}

fn native_mem_free_blocks_count() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var n = 0
    var cur = global_get_free_blocks()
    while cur != 0 {
        n = n + 1
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return n
}

fn native_mem_free_blocks_bytes() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var sum = 0
    var cur = global_get_free_blocks()
    while cur != 0 {
        sum = sum + ptr_get(iadd(cur, 8))
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return sum
}

fn native_mem_roots_count() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var n = 0
    var cur = global_get_roots()
    while cur != 0 {
        n = n + 1
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return n
}

fn native_mem_free_nodes_count() {
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var n = 0
    var cur = global_get_free_nodes()
    while cur != 0 {
        n = n + 1
        cur = ptr_get(iadd(cur, 32))
    }
    release_lock()
    return n
}

fn native_gc_shutdown() {
    return 0
}

var g_debug_info = 0
var g_debug_static_addr = 0
var g_slide = 0
var g_prog_pc_min = 0
var g_prog_pc_max = 0

fn align_ptr8(ptr) {
    while (ptr & 7) != 0 { ptr = ptr + 1 }
    return ptr
}

fn compute_program_pc_bounds() {
    // Best-effort: compute min/max static PC covered by debug function ranges.
    // This is used to avoid mis-labeling host/shared-library PCs via resolve_symbol().
    g_prog_pc_min = 0
    g_prog_pc_max = 0
    if g_debug_info == 0 { return 0 }
    var ptr = g_debug_info
    var count = ptr_get_u64(ptr)
    ptr = ptr + 8
    var i = 0
    while i < count {
        var start = ptr_get_u64(ptr)
        ptr = ptr + 8
        var end = ptr_get_u64(ptr)
        ptr = ptr + 8
        if g_prog_pc_min == 0 || start < g_prog_pc_min { g_prog_pc_min = start }
        if end > g_prog_pc_max { g_prog_pc_max = end }

        var name_len = ptr_get_u64(ptr)
        ptr = ptr + 8 + name_len
        ptr = align_ptr8(ptr)

        // file + (line,col)
        var file_len = ptr_get_u64(ptr)
        ptr = ptr + 8 + file_len
        ptr = align_ptr8(ptr)
        ptr = ptr + 16 // line + col

        var p_count = ptr_get_u64(ptr)
        ptr = ptr + 8
        var j = 0
        while j < p_count {
            var pname_len = ptr_get_u64(ptr)
            ptr = ptr + 8 + pname_len
            ptr = align_ptr8(ptr)
            ptr = ptr + 8 // offset
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

fn oren_set_debug_info(ptr, static_addr) {
    g_debug_info = ptr
    g_debug_static_addr = static_addr
    g_slide = ptr - static_addr
    compute_program_pc_bounds()
    return 0
}

fn ptr_get_u64(ptr) { return ptr_get(ptr) }

fn read_string_at(ptr, len) {
    var s = malloc(len + 1)
    var i = 0
    while i < len {
        ptr_set_byte(s + i, ptr_get_byte(ptr + i))
        i = i + 1
    }
    ptr_set_byte(s + len, 0)
    oren_track_alloc(s, len + 1, 1)
    return s
}

fn find_func_info(pc) {
    if g_debug_info == 0 { return 0 }
    
    // Un-slide PC to match static table
    var static_pc = pc - g_slide
    
    var ptr = g_debug_info
    var count = ptr_get_u64(ptr)
    ptr = ptr + 8
    
    var i = 0
    while i < count {
        var start = ptr_get_u64(ptr)
        ptr = ptr + 8
        var end = ptr_get_u64(ptr)
        ptr = ptr + 8
        
        if static_pc >= start {
            if static_pc < end {
                return ptr
            }
        }
        
        var name_len = ptr_get_u64(ptr)
        ptr = ptr + 8 + name_len
        ptr = align_ptr8(ptr)

        // file + (line,col)
        var file_len = ptr_get_u64(ptr)
        ptr = ptr + 8 + file_len
        ptr = align_ptr8(ptr)
        ptr = ptr + 16 // line + col

        var p_count = ptr_get_u64(ptr)
        ptr = ptr + 8
        var j = 0
        while j < p_count {
            var pname_len = ptr_get_u64(ptr)
            ptr = ptr + 8 + pname_len
            ptr = align_ptr8(ptr)
            ptr = ptr + 8 // offset
            j = j + 1
        }
        i = i + 1
    }
    return 0
}

fn debug_value_to_string(val) {
    var node = oren_find_node(val)
    if node != 0 {
        var kind = ptr_get(node + 16)
        if kind == 1 { // STRING
            return val
        }
        if kind == 2 { // LIST
            var s0 = "<list ptr="
            var s1 = string_concat(s0, oren_int_to_string(val))
            return string_concat(s1, ">"
            )
        }
        if kind == 3 { // MAP
            var s0 = "<map ptr="
            var s1 = string_concat(s0, oren_int_to_string(val))
            return string_concat(s1, ">"
            )
        }
        if kind == 4 { // STRUCT
            var s0 = "<struct ptr="
            var s1 = string_concat(s0, oren_int_to_string(val))
            return string_concat(s1, ">"
            )
        }
        if kind == 6 { // FUNC
            var s0 = "<func ptr="
            var s1 = string_concat(s0, oren_int_to_string(val))
            return string_concat(s1, ">"
            )
        }
    }
    return oren_int_to_string(val)
}

fn stack_trace_debug() {
    // Native backend debug stack trace (best-effort):
    // - prints function name + pc offset
    // - prints parameter values when available
    print("Traceback (most recent call first):")
    var fp = get_fp()
    var i = 0
    while fp != 0 {
        if i > 50 { 
            print("  ... (truncated)")
            return 0 
        }
        // ABI note: at [fp+8] we have the *saved LR* (return address) for this frame,
        // which is an address in the *caller*'s code. For readable traces we associate
        // that PC with the caller function, and print caller params from the caller's FP.
        var pc = ptr_get(fp + 8)
        var caller_fp = ptr_get(fp)
        var info_ptr = find_func_info(pc)
        
        if info_ptr != 0 {
            var f_start = ptr_get_u64(info_ptr - 16)
            // var f_end = ptr_get_u64(info_ptr - 8)
            var static_pc = pc - g_slide
            var off_in_func = static_pc - f_start

            var name_len = ptr_get_u64(info_ptr)
            var name = read_string_at(info_ptr + 8, name_len)
            
            var ptr = info_ptr + 8 + name_len
            ptr = align_ptr8(ptr)

            var file_len = ptr_get_u64(ptr)
            ptr = ptr + 8
            var file = "<unknown>"
            if file_len > 0 {
                file = read_string_at(ptr, file_len)
            }
            ptr = ptr + file_len
            ptr = align_ptr8(ptr)
            var line = ptr_get_u64(ptr)
            var col = ptr_get_u64(ptr + 8)
            ptr = ptr + 16

            // Print stable shape:
            //   at func file:line:col +off (pc=...)
            var s0 = string_concat("  at ", name)
            if line != 0 && col != 0 {
                var sF = string_concat(s0, " ")
                sF = string_concat(sF, file)
                sF = string_concat(sF, ":")
                sF = string_concat(sF, oren_int_to_string(line))
                sF = string_concat(sF, ":")
                s0 = string_concat(sF, oren_int_to_string(col))
            }
            var s1 = string_concat(s0, " +")
            var s2 = string_concat(s1, oren_int_to_string(off_in_func))
            var s3 = string_concat(s2, " (pc=")
            var s4 = string_concat(s3, oren_int_to_string(pc))
            print(string_concat(s4, ")"))

            var p_count = ptr_get_u64(ptr)
            ptr = ptr + 8
            var j = 0
            while j < p_count {
                var pname_len = ptr_get_u64(ptr)
                var pname = read_string_at(ptr + 8, pname_len)
                ptr = ptr + 8 + pname_len
                ptr = align_ptr8(ptr)
                var offset = ptr_get_u64(ptr)
                ptr = ptr + 8

                // Param locals live in the caller's frame (because PC maps to caller).
                if caller_fp != 0 {
                    var val_ptr = caller_fp - offset
                    var val = ptr_get(val_ptr)
                    var s1 = string_concat("    ", pname)
                    var s2 = string_concat(s1, " = ")
                    print(string_concat(s2, debug_value_to_string(val)))
                }
                j = j + 1
            }
        } else {
            // Fallback: try best-effort symbol resolution even when debug-info
            // range lookup fails (e.g. top-level code regions or entry stub).
            var name = "<unknown>"
            if g_debug_info != 0 && g_prog_pc_min != 0 && g_prog_pc_max != 0 {
                var static_pc = pc - g_slide
                if static_pc >= g_prog_pc_min && static_pc < g_prog_pc_max {
                    name = resolve_symbol(pc)
                    if name == nil { name = "<unknown>" }
                } else {
                    name = "<unknown host>"
                }
            }
            var s0 = string_concat("  at ", name)
            var s1 = string_concat(s0, " (pc=")
            var s2 = string_concat(s1, oren_int_to_string(pc))
            print(string_concat(s2, ")"))
        }
        
        fp = caller_fp
        i = i + 1
    }
    return 0
}

fn oren_ensure_tracked(ptr, kind) {
    if ptr == 0 { return 0 }
    if oren_find_node(ptr) == 0 {
        var size = 0
        if kind == 1 {
            size = oren_string_len(ptr) + 1
        }
        oren_track_alloc(ptr, size, kind)
    }
    return ptr
}

fn oren_raw_print_str(s) {
    if s == 0 { return 0 }
    var len = oren_string_len(s)
    sys_write(1, s, len)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn oren_diag_sanitize(msg) {
    // Best-effort: make msg single-line and ASCII-safe for log parsing.
    // Replaces '\n' -> '\\n', '\r' -> '\\r', '\t' -> '\\t'.
    if msg == 0 { return 0 }
    var n = oren_string_len(msg)
    if n <= 0 { return msg }
    if n > 1024 { n = 1024 }
    // Worst case each char expands to 2 bytes.
    var out = malloc(n * 2 + 1)
    if out == 0 { return msg }
    var i = 0
    var j = 0
    while i < n {
        var c = ptr_get_byte(msg + i)
        if c == 10 { // '\n'
            ptr_set_byte(out + j, 92) // '\\'
            ptr_set_byte(out + j + 1, 110) // 'n'
            j = j + 2
        } else {
            if c == 13 { // '\r'
                ptr_set_byte(out + j, 92)
                ptr_set_byte(out + j + 1, 114) // 'r'
                j = j + 2
            } else {
                if c == 9 { // '\t'
                    ptr_set_byte(out + j, 92)
                    ptr_set_byte(out + j + 1, 116) // 't'
                    j = j + 2
                } else {
                    ptr_set_byte(out + j, c)
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    ptr_set_byte(out + j, 0)
    oren_track_alloc(out, j + 1, 1)
    return out
}

fn oren_diag_emit(kind, code, msg) {
    // Stable, machine-readable diagnostic header for AI agents/tools.
    // Format (single line):
    //   OREN_DIAG kind=<kind> code=<code> msg=<sanitized>
    //
    // Keep this best-effort and non-fatal; diagnostics must not crash.
    var m = oren_diag_sanitize(msg)
    var s0 = "OREN_DIAG kind="
    var s1 = string_concat(s0, kind)
    var s2 = string_concat(s1, " code=")
    var s3 = string_concat(s2, oren_int_to_string(code))
    var s4 = string_concat(s3, " msg=")
    var s5 = string_concat(s4, m)
    print(s5)
    return 0
}

fn oren_fail(code, msg) {
    // Fail-fast helper for tests + internal invariants.
    // Emits an AI-friendly diagnostic line + a stack trace.
    g_panicking = 1
    oren_diag_emit("fail", code, msg)
    if g_debug_info != 0 {
        stack_trace_debug()
    } else {
        stack_trace()
    }
    exit(code)
    return 0
}

fn oren_panic(msg) {
    g_panicking = 1
    oren_diag_emit("panic", 1, msg)
    print("Runtime Panic: ")
    oren_raw_print_str(msg)
    if g_debug_info != 0 {
        stack_trace_debug()
    } else {
        stack_trace()
    }
    exit(1)
    return 0
}

// --- First-class functions (native backend) ---
//
// Representation (tracked allocation kind=6):
//   [0] code_ptr (u64)  - entrypoint taking (env, args_list)
//   [8] env_ptr  (u64)  - closure environment (typically a list), or 0
fn oren_func(code_ptr, env_ptr) {
    if code_ptr == 0 { return 0 }
    var obj = malloc(16)
    if obj == 0 { exit(320) }
    ptr_set(obj, code_ptr)
    ptr_set(obj + 8, env_ptr)
    // Update kind to 6 (FUNC) so GC can traverse env_ptr.
    var node = oren_find_node(obj)
    if node != 0 {
        ptr_set(node + 16, 6)
    }
    return obj
}

// Spawn a callable object with an args list.
//
// This is the syscall-first native analogue of the C backend's spawn-callable helper.
// It returns the same handle layout expected by `oren_join(handle)`:
//   0: pid (u64)
//   8: read_fd (u64)
fn oren_spawn_call_list(fn_obj, args_list) {
    var pipe_buf = malloc(16)
    if pipe_buf == 0 { exit(321) }
    var rv = sys_pipe(pipe_buf)
    if rv != 0 { exit(322) }

    var rfd = ptr_get(pipe_buf)
    var wfd = ptr_get(pipe_buf + 8)

    // IMPORTANT (fork hygiene):
    // Use `oren_fork()` (not raw `sys_fork()`) so the child resets any inherited
    // in-memory locks before doing further allocations/capsule bookkeeping.
    var pid = oren_fork()
    if pid == 0 {
        // Child
        var dbg = native_envp_get_value_ptr("OREN_DEBUG_SPAWN")
        if dbg != 0 {
            if ptr_get_byte(dbg) != 0 {
                print("spawn debug (child):")
                print("  pipe.rfd=" + oren_int_to_string(rfd))
                print("  pipe.wfd=" + oren_int_to_string(wfd))
            }
        }
        sys_close(rfd)
        var ret = 0
        if dbg != 0 {
            if ptr_get_byte(dbg) != 0 {
                print("  fn_obj=" + oren_int_to_string(fn_obj))
                if fn_obj != 0 {
                    print("  fn.code_ptr=" + oren_int_to_string(ptr_get(fn_obj)))
                    print("  fn.env_ptr=" + oren_int_to_string(ptr_get(fn_obj + 8)))
                }
                print("  args_list=" + oren_int_to_string(args_list))
                print("  args_len=" + oren_int_to_string(oren_list_len(args_list)))
                if oren_list_len(args_list) > 0 {
                    print("  args[0]=" + oren_int_to_string(oren_list_get(args_list, 0)))
                }
            }
        }

        ret = oren_call_obj_list(fn_obj, args_list)
        if dbg != 0 {
            if ptr_get_byte(dbg) != 0 {
                print("  ret=" + oren_int_to_string(ret))
            }
        }
        // Reuse the pre-fork heap buffer as the 8-byte write buffer.
        // This avoids taking the allocator lock in the child before user code runs.
        ptr_set(pipe_buf, ret)
        sys_write(wfd, pipe_buf, 8)
        sys_close(wfd)
        exit(0)
        return 0
    }

        // Parent
    sys_close(wfd)
    var dbg_p = native_envp_get_value_ptr("OREN_DEBUG_SPAWN")
    if dbg_p != 0 {
        if ptr_get_byte(dbg_p) != 0 {
            print("spawn debug (parent):")
            print("  pid=" + oren_int_to_string(pid))
            print("  pipe.rfd=" + oren_int_to_string(rfd))
            print("  pipe.wfd=" + oren_int_to_string(wfd))
        }
    }
    free(pipe_buf)

    var handle = malloc(16)
    if handle == 0 { exit(324) }
    ptr_set(handle, pid)
    ptr_set(handle + 8, rfd)
    return handle
}

// ... existing code ...

// Centralized struct allocation hook (uses the compiler's special-cased malloc).
fn oren_alloc_struct(size) {
    var ptr = malloc(size)
    // Update kind to 4 (STRUCT)
    var node = oren_find_node(ptr)
    if node != 0 {
        ptr_set(node + 16, 4)
    }
    return ptr
}

fn oren_free_struct(ptr) {
    // Best-effort explicit free for large struct buffers.
    // (Allocator is bump-based; `free` marks the node as freed so GC can reclaim metadata.)
    return free(ptr)
}

fn strcmp(s1, s2) {
    // Nil-safe lexicographic compare for NUL-terminated strings.
    // This is intentionally defensive: native codegen may still compare against 0 in rolling mode.
    if s1 == 0 {
        if s2 == 0 { return 0 }
        return -1
    }
    if s2 == 0 { return 1 }
    var i = 0
    while 1 {
        var b1 = ptr_get_byte(s1 + i)
        var b2 = ptr_get_byte(s2 + i)
        if b1 == 0 {
            if b2 == 0 { return 0 }
            return -1
        }
        if b2 == 0 { return 1 }
        if b1 < b2 { return -1 }
        if b1 > b2 { return 1 }
        i = i + 1
    }
    return 0
}


fn oren_add(a, b) {
    var na = oren_find_node(a)
    if na != 0 {
        var nb = oren_find_node(b)
        if nb != 0 {
            var ka = ptr_get(iadd(na, 16))
            var kb = ptr_get(iadd(nb, 16))
            if ka == 1 { // STRING
                if kb == 1 {
                    return string_concat(a, b)
                }
            }
        }
    }
    return iadd(a, b)
}

fn oren_mod(a, b) {
    // Deterministic signed remainder with explicit error on:
    // - modulo by zero
    // - i64_min % -1 (would imply division overflow)
    //
    // Native codegen's `/` uses unsigned division (rolling), so we implement the
    // signed behavior explicitly using abs() + unsigned division on positives.
    if b == 0 {
        oren_panic("modulo by zero")
        return 0
    }

    // INT64_MIN = -(1<<63). In Oren's rolling int model, this constant is safe.
    var i64_min = 0 - (1 << 63)
    if a == i64_min && b == -1 {
        oren_panic("modulo overflow (i64_min % -1)")
        return 0
    }

    var ua = a
    var ub = b
    if ua < 0 { ua = 0 - ua }
    if ub < 0 { ub = 0 - ub }
    // quotient for positive operands (unsigned division semantics are fine here)
    var q = ua / ub
    var rpos = ua - (q * ub)
    if a < 0 { return 0 - rpos }
    return rpos
}

fn oren_int_to_string(n) {
    var buf = malloc(32)
    if buf == 0 { exit(300) }
    var i = 0
    var neg = 0
    if n < 0 {
        neg = 1
        n = -n
    }
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        while n > 0 {
            var digit = n - (n / 10) * 10
            ptr_set_byte(buf + i, 48 + digit)
            i = i + 1
            n = n / 10
        }
        if neg == 1 {
            ptr_set_byte(buf + i, 45)
            i = i + 1
        }
        // reverse
        var s = 0
        var e = i - 1
        while s < e {
            var t = ptr_get_byte(buf + s)
            ptr_set_byte(buf + s, ptr_get_byte(buf + e))
            ptr_set_byte(buf + e, t)
            s = s + 1
            e = e - 1
        }
    }
    ptr_set_byte(buf + i, 0) // null term
    oren_track_alloc(buf, 32, 1) // 1=STRING
    return buf
}

// --- Printing ---
fn print_int_no_nl(n) {
    var buf = malloc(32)
    if buf == 0 { exit(300) }
    var i = 0
    var neg = 0
    if n < 0 {
        neg = 1
        n = -n
    }
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        while n > 0 {
            var digit = n - (n / 10) * 10
            ptr_set_byte(buf + i, 48 + digit)
            i = i + 1
            n = n / 10
        }
        if neg == 1 {
            ptr_set_byte(buf + i, 45)
            i = i + 1
        }
        // reverse
        var s = 0
        var e = i - 1
        while s < e {
            var t = ptr_get_byte(buf + s)
            ptr_set_byte(buf + s, ptr_get_byte(buf + e))
            ptr_set_byte(buf + e, t)
            s = s + 1
            e = e - 1
        }
    }
    sys_write(1, buf, i)
    return 0
}

fn print_int(n) {
    print_int_no_nl(n)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn oren_print_any_no_nl(val) {
    var node = oren_find_node(val)
    if node != 0 {
        var kind = ptr_get(node + 16)
        if kind == 1 { // STRING
            var len = oren_string_len(val)
            sys_write(1, val, len)
            return 0
        }
    }
    print_int_no_nl(val)
    return 0
}

fn oren_print_fmt(fmt, args) {
    // fmt is string ptr, args is list ptr
    var len = oren_string_len(fmt)
    var i = 0
    var arg_idx = 0
    var arg_count = 0
    if args != 0 { arg_count = oren_list_len(args) }
    
    while i < len {
        var c = ptr_get_byte(fmt + i)
        if c == 123 { // '{'
            if i + 1 < len {
                if ptr_get_byte(fmt + i + 1) == 125 { // '}'
                    if arg_idx < arg_count {
                        var val = oren_list_get(args, arg_idx)
                        oren_print_any_no_nl(val)
                        arg_idx = arg_idx + 1
                    } else {
                        // Print {}
                        sys_write(1, fmt + i, 2)
                    }
                    i = i + 2
                } else {
                    sys_write(1, fmt + i, 1)
                    i = i + 1
                }
            } else {
                sys_write(1, fmt + i, 1)
                i = i + 1
            }
        } else {
            sys_write(1, fmt + i, 1)
            i = i + 1
        }
    }
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn print_bytes(ptr, len) {
    sys_write(1, ptr, len)
}

fn oren_print(v) {
    oren_print_any_no_nl(v)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn oren_print_list(args_list) {
    // Print list elements separated by spaces and trailing newline.
    if args_list == 0 {
        var nl = malloc(1)
        ptr_set_byte(nl, 10)
        sys_write(1, nl, 1)
        return 0
    }
    var n = oren_list_len(args_list)
    var i = 0
    while i < n {
        var v = oren_list_get(args_list, i)
        oren_print_any_no_nl(v)
        if i < n - 1 {
            var sp = malloc(1)
            ptr_set_byte(sp, 32)
            sys_write(1, sp, 1)
        }
        i = i + 1
    }
    var nl2 = malloc(1)
    ptr_set_byte(nl2, 10)
    sys_write(1, nl2, 1)
    return 0
}

fn oren_print_fmt_list(fmt, args_list) { return oren_print_fmt(fmt, args_list) }

fn oren_print_spread(fixed_args, spread_list) {
    var args = oren_new_list(0)
    if fixed_args != 0 {
        var n0 = oren_list_len(fixed_args)
        var i0 = 0
        while i0 < n0 {
            oren_list_push(args, oren_list_get(fixed_args, i0))
            i0 = i0 + 1
        }
    }
    if spread_list != 0 {
        var n1 = oren_list_len(spread_list)
        var i1 = 0
        while i1 < n1 {
            oren_list_push(args, oren_list_get(spread_list, i1))
            i1 = i1 + 1
        }
    }
    return oren_print_list(args)
}

fn oren_print_fmt_spread(fmt, fixed_args, spread_list) {
    var args = oren_new_list(0)
    if fixed_args != 0 {
        var n0 = oren_list_len(fixed_args)
        var i0 = 0
        while i0 < n0 {
            oren_list_push(args, oren_list_get(fixed_args, i0))
            i0 = i0 + 1
        }
    }
    if spread_list != 0 {
        var n1 = oren_list_len(spread_list)
        var i1 = 0
        while i1 < n1 {
            oren_list_push(args, oren_list_get(spread_list, i1))
            i1 = i1 + 1
        }
    }
    return oren_print_fmt(fmt, args)
}

fn oren_call_obj_spread(fn_obj, fixed_args, spread_list) {
    var args = oren_new_list(0)
    if fixed_args != 0 {
        var n0 = oren_list_len(fixed_args)
        var i0 = 0
        while i0 < n0 {
            oren_list_push(args, oren_list_get(fixed_args, i0))
            i0 = i0 + 1
        }
    }
    if spread_list != 0 {
        var n1 = oren_list_len(spread_list)
        var i1 = 0
        while i1 < n1 {
            oren_list_push(args, oren_list_get(spread_list, i1))
            i1 = i1 + 1
        }
    }
    return oren_call_obj_list(fn_obj, args)
}

fn list_magic() { return 1279870019 } // 'LIST'
fn map_magic() { return 1296121168 } // 'MAP\0' (rolling; used only for type discrimination in native runtime)

fn oren_new_map(cap) {
    // Map layout mirrors list layout for safety and future growth:
    //   [count][cap][entries_ptr][magic]
    // Where entries_ptr points to an array of `[key_ptr][value]` pairs (16 bytes each).
    //
    // Rationale:
    // - The previous v0 layout stored entries inline after the header and attempted to
    //   "grow" by mutating cap without resizing the allocation. That caused OOB writes
    //   for maps created with cap=0 (e.g. `{}`) and corrupted the allocator metadata.
    // - By using an indirection (entries_ptr) we can grow like lists, without needing
    //   to update every reference to the map pointer.
    if cap < 0 { cap = 0 }
    if cap > 0 && cap < 4 { cap = 4 }

    var header = malloc(32)
    if header == 0 { exit(1) }
    if header == -1 { exit(1) }
    oren_track_alloc(header, 32, 0)

    var buf = 0
    if cap > 0 {
        buf = malloc(cap * 16)
        if buf == 0 { exit(1) }
        if buf == -1 { exit(1) }
        oren_track_alloc(buf, cap * 16, 0)
    }

    ptr_set(header + 0, 0)       // count
    ptr_set(header + 8, cap)     // cap
    ptr_set(header + 16, buf)    // entries_ptr
    ptr_set(header + 24, map_magic())

    // Mark map header kind for GC traversal (kind=3 => MAP).
    var node = oren_find_node(header)
    if node != 0 { ptr_set(iadd(node, 16), 3) }
    return header
}

fn oren_map_set(m, k, v) {
    // stack_trace()
    if m == 0 { exit(110) }
    if m < 4096 { exit(111) }
    if k == 0 { exit(112) }
    // if m > 4096 { exit(12) } 
    if ptr_get(m + 24) != map_magic() { exit(113) }
    
    var count = ptr_get(m + 0)
    var cap = ptr_get(m + 8)
    if count < 0 { count = 0; ptr_set(m + 0, 0) }
    if cap < 0 { cap = 0; ptr_set(m + 8, 0) }

    var buf = ptr_get(m + 16)
    if buf == 0 && cap > 0 { exit(114) }
    if cap == 0 && buf != 0 { exit(114) }

    var i = 0
    while i < count {
        var kp = ptr_get(buf + i * 16)
        if strcmp(kp, k) == 0 {
            ptr_set(buf + i * 16 + 8, v)
            return m
        }
        i = i + 1
    }

    // Grow if needed (like lists).
    if count >= cap {
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        var new_buf = malloc(new_cap * 16)
        if new_buf == 0 { exit(99) }
        if new_buf == -1 { exit(99) }
        oren_track_alloc(new_buf, new_cap * 16, 0)
        var ci = 0
        while ci < count {
            ptr_set(new_buf + ci * 16 + 0, ptr_get(buf + ci * 16 + 0))
            ptr_set(new_buf + ci * 16 + 8, ptr_get(buf + ci * 16 + 8))
            ci = ci + 1
        }
        buf = new_buf
        cap = new_cap
        ptr_set(m + 8, cap)
        ptr_set(m + 16, buf)
    }

    // Deterministic ordered maps (rolling): keep keys sorted by strcmp (ascending).
    // Keys are assumed to be string pointers; do not use non-string keys in v0.
    var insert_at = 0
    while insert_at < count {
        var ek = ptr_get(buf + insert_at * 16)
        if strcmp(ek, k) > 0 { break }
        insert_at = insert_at + 1
    }

    // Shift entries right to make space.
    var j = count
    while j > insert_at {
        var from = buf + (j - 1) * 16
        var to = buf + j * 16
        ptr_set(to + 0, ptr_get(from + 0))
        ptr_set(to + 8, ptr_get(from + 8))
        j = j - 1
    }

    ptr_set(buf + insert_at * 16, k)
    ptr_set(buf + insert_at * 16 + 8, v)
    ptr_set(m + 0, count + 1)
    return m
}

fn oren_map_get(m, k) {
    if m == 0 { return 0 }
    if ptr_get(m + 24) != map_magic() { return 0 }
    var count = ptr_get(m + 0)
    var buf = ptr_get(m + 16)
    var i = 0
    while i < count {
        var kp = ptr_get(buf + i * 16)
        if strcmp(kp, k) == 0 {
            return ptr_get(buf + i * 16 + 8)
        }
        i = i + 1
    }
    return 0
}

fn oren_map_len(m) {
    if m == 0 { return 0 }
    if ptr_get(m + 24) != map_magic() { return 0 }
    return ptr_get(m + 0)
}

fn oren_map_key_at(m, idx) {
    if m == 0 { return 0 }
    if ptr_get(m + 24) != map_magic() { return 0 }
    var count = ptr_get(m + 0)
    if idx < 0 { return 0 }
    if idx >= count { return 0 }
    var buf = ptr_get(m + 16)
    return ptr_get(buf + idx * 16)
}

// --- Structured errors (rolling, portable) ---
// Convention matches C/AVM:
//   error = map {"__err": true, "code": int, "msg": string}
//
// NOTE: in native v0, `nil/false/0` collapse to 0 in some contexts. This convention
// uses a tagged map pointer (map_magic) so `oren_is_err` can discriminate reliably.
fn oren_err(code, msg) {
    var m = oren_new_map(8)
    oren_map_set(m, "__err", 1)
    oren_map_set(m, "code", code)
    oren_map_set(m, "msg", msg)
    return m
}

fn oren_is_err(v) {
    // Safe for arbitrary ints:
    // - integers can be >= 4096 (e.g. 16909060), so we must NOT probe memory
    //   at `v+24` unless `v` is a tracked heap pointer.
    if v == 0 { return 0 }
    var node = oren_find_node(v)
    if node == 0 { return 0 }
    if ptr_get(v + 24) != map_magic() { return 0 }
    var marker = oren_map_get(v, "__err")
    if marker == 0 { return 0 }
    return 1
}

fn oren_err_code(v) {
    if oren_is_err(v) == 0 { return -1 }
    return oren_map_get(v, "code")
}

fn oren_err_msg(v) {
    if oren_is_err(v) == 0 { return 0 }
    return oren_map_get(v, "msg")
}

// --- Strings ---
fn oren_string_len(s) {
    if s == 0 { return 0 }
    var i = 0
    while ptr_get_byte(iadd(s, i)) != 0 {
        i = i + 1
    }
    return i
}

fn oren_string_char_at(s, idx) {
    if s == 0 { oren_panic("char_at expects string") }
    var len = oren_string_len(s)
    if idx < 0 || idx >= len {
        oren_panic("char_at index out of range")
    }
    var out = malloc(2)
    if out == 0 { oren_panic("malloc failed") }
    ptr_set_byte(out + 0, ptr_get_byte(iadd(s, idx)))
    ptr_set_byte(out + 1, 0)
    oren_track_alloc(out, 2, 1)
    return out
}

// Slice a C-string into a newly allocated, NUL-terminated string.
// Semantics match the C-backend helper: out-of-range clamps, empty slice returns "".
fn oren_string_slice(s, start, end) {
    if s == 0 { return 0 }
    var len = oren_string_len(s)
    var i = start
    var j = end
    if i < 0 { i = 0 }
    if j < 0 { j = 0 }
    if i > len { i = len }
    if j > len { j = len }
    if i >= j {
        // Return empty string (stable allocation).
        var out0 = malloc(1)
        if out0 == 0 { return 0 }
        ptr_set_byte(out0, 0)
        oren_track_alloc(out0, 1, 1)
        return out0
    }
    var n = j - i
    var out = malloc(n + 1)
    if out == 0 { return 0 }
    var k = 0
    while k < n {
        ptr_set_byte(out + k, ptr_get_byte(s + i + k))
        k = k + 1
    }
    ptr_set_byte(out + n, 0)
    oren_track_alloc(out, n + 1, 1)
    return out
}

// Parse a non-negative decimal integer from a C-string (best-effort).
// Returns -1 on invalid input.
fn oren_int_from_string(s) {
    if s == 0 { return -1 }
    var i = 0
    var v = 0
    var any = 0
    while 1 {
        var c = ptr_get_byte(s + i)
        if c == 0 { break }
        if c < 48 { return -1 }
        if c > 57 { return -1 }
        any = 1
        v = v * 10 + (c - 48)
        i = i + 1
        if i > 32 { return -1 } // bound
    }
    if any == 0 { return -1 }
    return v
}

// --- Iteration (generic `for x in ...`) ---
// Iterator contract:
//   oren_iter_next(container, idx) -> [ok, value]
// Where ok is 1 when value exists, 0 when iteration is complete.
//
// Native backend note:
// - Lists and maps are heap objects with magic tags.
// - Strings are raw pointers (C strings); iteration stops at NUL byte.
// - "bytes" in native v0 is typically `list<int 0..255>` (from `oren_read_bytes`).
fn oren_iter_next(container, idx) {
    // Compute result first, then allocate the return list last.
    // This avoids reliance on any particular native backend local/param storage strategy.
    var ok = 0
    var val = 0

    if container != 0 && idx >= 0 {
        // Avoid unsafe probing of arbitrary large integers: only dereference pointers that are
        // tracked by the native GC list, or use a string-style byte read as a last resort.
        var node = oren_find_node(container)
        if node != 0 {
            var kind = ptr_get(iadd(node, 16))

            // List: yield elements.
            if kind == 2 {
                var count = ptr_get(container)

                // Typed buffer views are represented as lists for portability:
                // - slice view:   [buf, off, len]
                // - strided view: [buf, off, len, stride]
                //
                // `for x in view` should iterate the underlying buffer values, not the metadata fields.
                if (count == 3 || count == 4) && idx >= 0 {
                    var b = oren_list_get(container, 0)
                    var off = oren_list_get(container, 1)
                    var n = oren_list_get(container, 2)
                    var stride = 1
                    if count == 4 { stride = oren_list_get(container, 3) }

                    if off >= 0 && n >= 0 && stride > 0 && idx < n {
                        var bnode = oren_find_node(b)
                        if bnode != 0 {
                            var bkind = ptr_get(iadd(bnode, 16))
                            if bkind == 7 {
                                if ptr_get(b + 24) == buf_magic() {
                                    var tag = ptr_get(b + 32)
                                    var blen = ptr_get(b + 0)
                                    var elem_idx = off + (idx * stride)
                                    if elem_idx >= 0 && elem_idx < blen {
                                        var data = native_buf_data_ptr(b)
                                        if tag == BUF_TAG_U8 {
                                            ok = 1
                                            val = ptr_get_byte(data + elem_idx) & 255
                                        } else {
                                            if tag == BUF_TAG_I32 {
                                                ok = 1
                                                val = oren_ptr_get_i32_le(data + elem_idx * 4)
                                            } else {
                                                if tag == BUF_TAG_I64 {
                                                    ok = 1
                                                    val = oren_ptr_get_i64_le(data + elem_idx * 8)
                                                } else {
                                                    if tag == BUF_TAG_F32 {
                                                        ok = 1
                                                        val = oren_u32_bits_to_f32(oren_ptr_get_u32_le(data + elem_idx * 4))
                                                    } else {
                                                        if tag == BUF_TAG_F64 {
                                                            ok = 1
                                                            val = oren_u64_bits_to_f64(oren_ptr_get_u64_le(data + elem_idx * 8))
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if ok == 0 && idx < count {
                    ok = 1
                    // Use the well-tested list accessor to avoid relying on raw buffer math here.
                    val = oren_list_get(container, idx)
                }
            } else {
                // Map: yield keys in deterministic order (stored sorted).
                if kind == 3 {
                    // Iterable map protocol (rolling): allow maps to represent stream-like iterables.
                    //
                    // Used by std/iter.oren:
                    //   {"__iter":"range","start":0,"end":N,"step":1}
                    //
                    // Normal maps still iterate keys deterministically.
                    var it = oren_map_get(container, "__iter")
                    // Important native backend safety note:
                    // - Values are not tagged at runtime, so we must not call `strcmp` on an integer.
                    // - The stdlib `range(...)` helper uses a string literal "range", so pointer equality
                    //   is sufficient and avoids crashing on non-string values.
                    if it == "range" {
                        var start = oren_map_get(container, "start")
                        var end = oren_map_get(container, "end")
                        var step = oren_map_get(container, "step")
                        if step != 0 {
                            var v = start + (idx * step)
                            if step > 0 {
                                if v < end { ok = 1; val = v }
                            } else {
                                if step < 0 {
                                    if v > end { ok = 1; val = v }
                                }
                            }
                        }
                    } else {
                    var count2 = ptr_get(container + 0)
                    if idx < count2 {
                        ok = 1
                        val = oren_map_key_at(container, idx)
                    }
                    }
                } else {
                    // Typed buffers: allow numeric buffers to be iterated.
                    //
                    // Notes:
                    // - buf is a native heap object with:
                    //   - len @ +0
                    //   - data ptr @ +16
                    //   - magic @ +24
                    //   - tag @ +32
                    // - We read raw little-endian payload and return:
                    //   - i32/i64 -> int
                    //   - f32/f64 -> float bits (native float container)
                    if kind == 7 {
                        if ptr_get(container + 24) == buf_magic() {
                            var tag = ptr_get(container + 32)
                            var n = ptr_get(container + 0)
                            if idx < n {
                                var data = native_buf_data_ptr(container)
                                if tag == BUF_TAG_U8 {
                                    ok = 1
                                    val = ptr_get_byte(data + idx) & 255
                                } else {
                                    if tag == BUF_TAG_I32 {
                                        ok = 1
                                        val = oren_ptr_get_i32_le(data + idx * 4)
                                    } else {
                                        if tag == BUF_TAG_I64 {
                                            ok = 1
                                            val = oren_ptr_get_i64_le(data + idx * 8)
                                        } else {
                                            if tag == BUF_TAG_F32 {
                                                ok = 1
                                                val = oren_u32_bits_to_f32(oren_ptr_get_u32_le(data + idx * 4))
                                            } else {
                                                if tag == BUF_TAG_F64 {
                                                    ok = 1
                                                    val = oren_u64_bits_to_f64(oren_ptr_get_u64_le(data + idx * 8))
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        // String: yield byte codepoints until NUL terminator.
                        var ch = ptr_get_byte(iadd(container, idx))
                        if ch != 0 {
                            ok = 1
                            val = ch
                        }
                    }
                }
            }
        } else {
            // Fallback: allow iterating a raw pointer as a C string (best-effort).
            // Keep the old behavior for untracked pointers, but do not attempt this for small ints.
            if container >= 4096 {
                var ch2 = ptr_get_byte(iadd(container, idx))
                if ch2 != 0 {
                    ok = 1
                    val = ch2
                }
            }
        }
    }

    // NOTE (rolling native backend):
    // Construct the `[ok, value]` pair by directly writing into the list buffer.
    var out = oren_new_list(2)
    var out_buf = ptr_get(out + 16)
    ptr_set(out, 2) // count
    ptr_set(out_buf + 0, ok)
    ptr_set(out_buf + 8, val)
    return out
}

// Return a freshly allocated byte buffer (list) from a string literal pointer.
fn oren_string_eq(a, b) {
    if a == 0 { return false }
    if b == 0 { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if ptr_get_byte(a + i) != ptr_get_byte(b + i) { return false }
        i = i + 1
    }
    return true
}

fn oren_bytes_from_string_ptr(s_ptr) {
    var len = oren_string_len(s_ptr)
    var lst = oren_new_list(len)
    var i = 0
    while i < len {
        var b = ptr_get_byte(s_ptr + i)
        oren_list_push(lst, b)
        i = i + 1
    }
    return lst
}

// Public wrapper (portable name used by stdlib/compiler):
// Build a byte list from a string pointer.
fn oren_bytes_from_string(s) {
    return oren_bytes_from_string_ptr(s)
}

// Build a string (NUL-terminated) from a list<int 0..255>.
// This is the inverse of `oren_bytes_from_string(...)` in other backends.
fn oren_string_from_bytes(bytes) {
    if bytes == 0 { return 0 }
    var n = oren_list_len(bytes)
    if n < 0 { return 0 }
    var out = malloc(n + 1)
    if out == 0 { return 0 }
    var i = 0
    while i < n {
        var b = oren_list_get(bytes, i)
        // Best-effort clamp for rolling native mode.
        if b < 0 { b = 0 }
        if b > 255 { b = 255 }
        ptr_set_byte(out + i, b)
        i = i + 1
    }
    ptr_set_byte(out + n, 0)
    oren_track_alloc(out, n + 1, 1) // 1=STRING
    return out
}

fn string_concat(a, b) {
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    var buf = malloc(la + lb + 1)
    if buf == 0 { exit(301) }
    
    var i = 0
    while i < la {
        ptr_set_byte(buf + i, ptr_get_byte(a + i))
        i = i + 1
    }
    
    var j = 0
    while j < lb {
        ptr_set_byte(buf + la + j, ptr_get_byte(b + j))
        j = j + 1
    }
    ptr_set_byte(buf + la + lb, 0)
    oren_track_alloc(buf, la + lb + 1, 1)
    return buf
}

// --- Lists ---
// Layout: [count][capacity][buffer_ptr][magic]
fn oren_new_list(cap) {
    if cap < 0 { cap = 0 }
    var header = malloc(32)
    if header == 0 { exit(200) }
    if header == -1 { exit(200) }
    oren_track_alloc(header, 32, 0)
    var buf = 0
    if cap > 0 {
        buf = malloc(cap * 8)
        if buf == 0 { exit(201) }
        if buf == -1 { exit(201) }
        oren_track_alloc(buf, cap * 8, 0)
    }
    ptr_set(header, 0)      // count
    ptr_set(header + 8, cap) // capacity
    ptr_set(header + 16, buf) // data buffer
    ptr_set(header + 24, list_magic())
    // Mark list header kind for GC traversal (kind=2 => LIST).
    var node = oren_find_node(header)
    if node != 0 { ptr_set(iadd(node, 16), 2) }
    return header
}

fn oren_list_len(list) {
    if list == 0 { return 0 }
    if ptr_get(list + 24) != list_magic() { exit(205) }
    return ptr_get(list)
}

fn oren_list_push(list, value) {
    if list == 0 { exit(210) }
    if ptr_get(list + 24) != list_magic() { exit(206) }
    var count = ptr_get(list)
    var cap = ptr_get(list + 8)
    var buf = ptr_get(list + 16)
    if count >= cap {
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        var new_buf = malloc(new_cap * 8)
        if new_buf == 0 { exit(211) }
        if new_buf == -1 { exit(211) }
        oren_track_alloc(new_buf, new_cap * 8, 0)
        var i = 0
        while i < count {
            ptr_set(new_buf + i * 8, ptr_get(buf + i * 8))
            i = i + 1
        }
        buf = new_buf
        cap = new_cap
        ptr_set(list + 8, cap)
        ptr_set(list + 16, buf)
    }
    ptr_set(buf + count * 8, value)
    ptr_set(list, count + 1)
    return list
}

fn oren_list_get(list, idx) {
    if list == 0 { exit(220) }
    if ptr_get(list + 24) != list_magic() {
        // Not a list, try map get
        return oren_map_get(list, idx)
    }
    var count = ptr_get(list)
    if idx < 0 { 
        oren_panic("Index out of bounds (negative)")
        return 0
    }
    if idx >= count { 
        oren_panic("Index out of bounds")
        return 0
    }
    var buf = ptr_get(list + 16)
    return ptr_get(buf + idx * 8)
}

// Set list element in-bounds (does not grow). Returns the written value.
fn oren_list_set(list, idx, value) {
    if list == 0 { oren_panic("list_set on nil") }
    if ptr_get(list + 24) != list_magic() { oren_panic("list_set on non-list") }
    var count = ptr_get(list)
    if idx < 0 { oren_panic("Index out of bounds (negative)") }
    if idx >= count { oren_panic("Index out of bounds") }
    var buf = ptr_get(list + 16)
    if buf == 0 { oren_panic("list buffer is nil") }
    ptr_set(buf + idx * 8, value)
    return value
}

// --- Bytes helpers (portable API surface; native runtime implementation) ---
//
// In native mode we represent "bytes" as:
// - `list<int 0..255>` (legacy; still supported)
// - `u8_buf` (preferred; zero-copy IO + pack_view compatible)
//
// These helpers unify the surface so higher-level libraries can be backend-agnostic.

fn oren_bytes_len(bytes) {
    if bytes == 0 { return oren_err(4, "bytes_len: bytes is nil") }
    if native_bytes_is_list(bytes) == true { return ptr_get(bytes) }
    if native_bytes_is_u8_buf(bytes) == true { return ptr_get(bytes + 0) }
    return oren_err(4, "bytes_len expects list<int> or u8_buf")
}

fn bytes_hex_nibble(c) {
    // Return 0..15 or -1.
    if c >= 48 && c <= 57 { return c - 48 } // '0'..'9'
    if c >= 97 && c <= 102 { return c - 87 } // 'a'..'f'
    if c >= 65 && c <= 70 { return c - 55 } // 'A'..'F'
    return -1
}

fn oren_bytes_from_hex(s) {
    if s == 0 { return oren_err(4, "bytes_from_hex: string is nil") }
    var n = oren_string_len(s)
    if n < 0 { return oren_err(4, "bytes_from_hex: invalid string") }
    if (n & 1) != 0 { return oren_err(4, "bytes_from_hex: odd length") }
    var outn = n / 2
    var out = oren_u8_buf_new(outn)
    if oren_is_err(out) { return out }
    var i = 0
    while i < outn {
        var c0 = ptr_get_byte(s + i * 2 + 0)
        var c1 = ptr_get_byte(s + i * 2 + 1)
        var hi = bytes_hex_nibble(c0)
        var lo = bytes_hex_nibble(c1)
        if hi < 0 || lo < 0 { return oren_err(4, "bytes_from_hex: invalid hex digit") }
        oren_buf_store_u8(out, i, (hi << 4) | lo)
        i = i + 1
    }
    return out
}

fn bytes_hex_char(n) {
    // n is 0..15
    if n < 10 { return 48 + n } // '0'..'9'
    return 87 + n // 'a'..'f'
}

fn oren_bytes_to_hex(bytes) {
    var n = oren_bytes_len(bytes)
    if oren_is_err(n) { return n }
    var out = malloc(n * 2 + 1)
    if out == 0 { return oren_err(8, "bytes_to_hex: alloc failed") }
    var i = 0
    while i < n {
        var b = oren_bytes_get_u8(bytes, i)
        if oren_is_err(b) { return b }
        ptr_set_byte(out + i * 2 + 0, bytes_hex_char((b >> 4) & 15))
        ptr_set_byte(out + i * 2 + 1, bytes_hex_char(b & 15))
        i = i + 1
    }
    ptr_set_byte(out + n * 2, 0)
    oren_track_alloc(out, n * 2 + 1, 1) // STRING
    return out
}

fn oren_bytes_unpack(bytes) {
    var n = oren_bytes_len(bytes)
    if oren_is_err(n) { return n }
    var out = oren_new_list(n)
    var i = 0
    while i < n {
        var b = oren_bytes_get_u8(bytes, i)
        if oren_is_err(b) { return b }
        oren_list_push(out, b)
        i = i + 1
    }
    return out
}

fn oren_bytes_pack(xs) {
    if xs == 0 { return oren_err(4, "bytes_pack: list is nil") }
    if native_bytes_is_list(xs) != true { return oren_err(4, "bytes_pack expects list<int 0..255>") }
    var n = ptr_get(xs)
    var out = oren_u8_buf_new(n)
    if oren_is_err(out) { return out }
    var i = 0
    while i < n {
        var v = oren_list_get(xs, i)
        if v < 0 || v > 255 { return oren_err(4, "bytes_pack: byte out of range") }
        oren_buf_store_u8(out, i, v)
        i = i + 1
    }
    return out
}

fn oren_bool_norm(x) {
    // Native backend values are untagged; treat "bool" as numeric != 0.
    // This matches the value-level meaning we want for `bool` annotations.
    return x != 0
}

fn oren_ptr_alloc(bytes) {
    // Portable name for allocating a raw byte region for ABI/FFI struct layouts.
    // In the native backend, `malloc` is syscall-first and GC-tracked.
    return malloc(bytes)
}

fn oren_ptr_free(ptr) {
    free(ptr)
    return 0
}

// --- Byte-order helpers (network parsing / serialization) ---
//
// In native v0, "bytes" are typically `list<int 0..255>`.
// These helpers are deterministic and libc-free.

// Pointer byte-order helpers (native syscall-first path).
//
// Use case:
// - syscalls read into a raw pointer buffer (returned by malloc)
// - libraries parse/serialize structured packets directly from/to that buffer
//
// IMPORTANT:
// - These functions do NOT bounds-check (they only have a pointer, no length).
// - They are unaligned-safe because they use ptr_get_byte/ptr_set_byte.
// - All encodings are canonical little-endian in memory when using *_le helpers,
//   and big-endian for *_be helpers.
//
// NOTE: like the list<bytes> helpers, `u64` values above MAX_I64 are not representable
// in v0's signed int container; the bit pattern is still correct for negative values.

fn oren_ptr_get_u8(p) { return ptr_get_byte(p) & 255 }
fn oren_ptr_set_u8(p, v) { ptr_set_byte(p, v & 255); return v & 255 }

fn oren_ptr_get_u16_be(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    return (b0 << 8) | b1
}
fn oren_ptr_get_u16_le(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    return (b1 << 8) | b0
}
fn oren_ptr_get_i16_be(p) {
    var u = oren_ptr_get_u16_be(p)
    if u >= 32768 { return u - 65536 }
    return u
}
fn oren_ptr_get_i16_le(p) {
    var u = oren_ptr_get_u16_le(p)
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_ptr_set_u16_be(p, v) {
    var u = v & 65535
    oren_ptr_set_u8(p + 0, (u >> 8) & 255)
    oren_ptr_set_u8(p + 1, u & 255)
    return u
}
fn oren_ptr_set_u16_le(p, v) {
    var u = v & 65535
    oren_ptr_set_u8(p + 0, u & 255)
    oren_ptr_set_u8(p + 1, (u >> 8) & 255)
    return u
}
fn oren_ptr_set_i16_be(p, v) {
    var u = v & 65535
    oren_ptr_set_u8(p + 0, (u >> 8) & 255)
    oren_ptr_set_u8(p + 1, u & 255)
    if u >= 32768 { return u - 65536 }
    return u
}
fn oren_ptr_set_i16_le(p, v) {
    var u = v & 65535
    oren_ptr_set_u8(p + 0, u & 255)
    oren_ptr_set_u8(p + 1, (u >> 8) & 255)
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_ptr_get_u32_be(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    var b2 = oren_ptr_get_u8(p + 2)
    var b3 = oren_ptr_get_u8(p + 3)
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}
fn oren_ptr_get_u32_le(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    var b2 = oren_ptr_get_u8(p + 2)
    var b3 = oren_ptr_get_u8(p + 3)
    return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0
}
fn oren_ptr_get_i32_be(p) {
    var u = oren_ptr_get_u32_be(p)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}
fn oren_ptr_get_i32_le(p) {
    var u = oren_ptr_get_u32_le(p)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_ptr_set_u32_be(p, v) {
    var u = v & 4294967295
    oren_ptr_set_u8(p + 0, (u >> 24) & 255)
    oren_ptr_set_u8(p + 1, (u >> 16) & 255)
    oren_ptr_set_u8(p + 2, (u >> 8) & 255)
    oren_ptr_set_u8(p + 3, u & 255)
    return u
}
fn oren_ptr_set_u32_le(p, v) {
    var u = v & 4294967295
    oren_ptr_set_u8(p + 0, u & 255)
    oren_ptr_set_u8(p + 1, (u >> 8) & 255)
    oren_ptr_set_u8(p + 2, (u >> 16) & 255)
    oren_ptr_set_u8(p + 3, (u >> 24) & 255)
    return u
}
fn oren_ptr_set_i32_be(p, v) {
    var u = v & 4294967295
    oren_ptr_set_u8(p + 0, (u >> 24) & 255)
    oren_ptr_set_u8(p + 1, (u >> 16) & 255)
    oren_ptr_set_u8(p + 2, (u >> 8) & 255)
    oren_ptr_set_u8(p + 3, u & 255)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}
fn oren_ptr_set_i32_le(p, v) {
    var u = v & 4294967295
    oren_ptr_set_u8(p + 0, u & 255)
    oren_ptr_set_u8(p + 1, (u >> 8) & 255)
    oren_ptr_set_u8(p + 2, (u >> 16) & 255)
    oren_ptr_set_u8(p + 3, (u >> 24) & 255)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_ptr_get_u64_be(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    var b2 = oren_ptr_get_u8(p + 2)
    var b3 = oren_ptr_get_u8(p + 3)
    var b4 = oren_ptr_get_u8(p + 4)
    var b5 = oren_ptr_get_u8(p + 5)
    var b6 = oren_ptr_get_u8(p + 6)
    var b7 = oren_ptr_get_u8(p + 7)
    return (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
}
