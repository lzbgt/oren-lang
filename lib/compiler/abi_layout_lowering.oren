import ast "ast.oren"

// ABI layout lowering (rolling).
//
// Purpose:
// - Provide a deterministic, cross-backend way to compute C-like struct layout
//   for fixed-width primitive fields (u8/i8/u16/i16/u32/i32/u64/i64/f32/f64/bool).
// - Expose compile-time-only builtins:
//     oren_abi_sizeof("Type") -> int literal
//     oren_abi_alignof("Type") -> int literal
//     oren_abi_offsetof("Type", "field") -> int literal
//
// This is an opt-in mode enabled by annotating a type declaration:
//     @oren.abi
//     struct Foo { a: u8, b: u32, c: u16 }
//
// Non-goals (future work):
// - Pointers/usize/isize, arrays, nested ABI structs, unions
// - Emitting ABI structs as raw bytes by default (this pass is layout-only)
// - Replacing the current map/list-based struct representation in v0

fn is_attr_name(a, name) {
    if a == nil || name == nil { return false }
    return a["type"] == "Attr" && a["name"] == name
}

fn has_attr_list(stmt, name) {
    if stmt == nil { return false }
    var attrs = stmt["attrs"]
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        if is_attr_name(attrs[i], name) { return true }
        i = i + 1
    }
    return false
}

fn strip_oren_prefix(kind) {
    if kind == nil { return nil }
    if oren_string_len(kind) > 5 {
        if oren_string_slice(kind, 0, 5) == "oren." {
            return oren_string_slice(kind, 5, oren_string_len(kind))
        }
    }
    return kind
}

fn normalize_kind_for_layout(kind) {
    kind = strip_oren_prefix(kind)
    if kind == nil { return nil }
    // Endian tags are still the same width in memory for ABI purposes.
    if kind == "u16be" || kind == "u16le" { return "u16" }
    if kind == "i16be" || kind == "i16le" { return "i16" }
    if kind == "u32be" || kind == "u32le" { return "u32" }
    if kind == "i32be" || kind == "i32le" { return "i32" }
    if kind == "u64be" || kind == "u64le" { return "u64" }
    if kind == "i64be" || kind == "i64le" { return "i64" }
    return kind
}

fn abi_size_align_for_kind(kind) {
    // Returns {"size": int, "align": int} or nil if unsupported.
    var k = normalize_kind_for_layout(kind)
    if k == nil { return nil }
    if k == "u8" || k == "i8" || k == "bool" { return {"size": 1, "align": 1} }
    if k == "u16" || k == "i16" { return {"size": 2, "align": 2} }
    if k == "u32" || k == "i32" || k == "f32" { return {"size": 4, "align": 4} }
    if k == "u64" || k == "i64" || k == "f64" { return {"size": 8, "align": 8} }
    return nil
}

fn align_up(off, align) {
    if align <= 1 { return off }
    var mask = align - 1
    var r = off & mask
    if r == 0 { return off }
    return off + (align - r)
}

fn compute_abi_layout_for_type(stmt) {
    // Returns:
    //  {"size": int, "align": int, "offsets": {fieldName: int}}
    var tname = stmt["name"]["value"]
    var fields = stmt["fields"]
    var offsets = {}
    var off = 0
    var max_align = 1

    var i = 0
    while i < oren_list_len(fields) {
        var fid = fields[i]
        var fname = fid["value"]
        var kind = fid["ann_type"]
        if kind == nil {
            print("ABI struct field missing type annotation: " + tname + "." + fname)
            oren_exit(1)
        }
        var sa = abi_size_align_for_kind(kind)
        if sa == nil {
            print("ABI struct field has unsupported type: " + tname + "." + fname + ": " + kind)
            oren_exit(1)
        }
        var sz = sa["size"]
        var al = sa["align"]
        if al > max_align { max_align = al }
        off = align_up(off, al)
        offsets[fname] = off
        off = off + sz
        i = i + 1
    }

    var size = align_up(off, max_align)
    return {"size": size, "align": max_align, "offsets": offsets}
}

fn int_lit(v) { return {"type": "Integer", "token": nil, "value": oren_int_to_string(v)} }

fn lower_expr_in_place(expr, abi_layouts) {
    if expr == nil { return nil }
    var t = expr["type"]

    if t == "Function" {
        lower_stmt_in_place(expr["body"], abi_layouts)
        return expr
    }
    if t == "Prefix" {
        expr["right"] = lower_expr_in_place(expr["right"], abi_layouts)
        return expr
    }
    if t == "Infix" {
        expr["left"] = lower_expr_in_place(expr["left"], abi_layouts)
        expr["right"] = lower_expr_in_place(expr["right"], abi_layouts)
        return expr
    }
    if t == "If" {
        expr["cond"] = lower_expr_in_place(expr["cond"], abi_layouts)
        lower_stmt_in_place(expr["consq"], abi_layouts)
        if expr["alt"] != nil { lower_stmt_in_place(expr["alt"], abi_layouts) }
        return expr
    }
    if t == "Array" {
        var xs = expr["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            xs[i] = lower_expr_in_place(xs[i], abi_layouts)
            i = i + 1
        }
        return expr
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            ps[i2]["key"] = lower_expr_in_place(ps[i2]["key"], abi_layouts)
            ps[i2]["value"] = lower_expr_in_place(ps[i2]["value"], abi_layouts)
            i2 = i2 + 1
        }
        return expr
    }
    if t == "Index" {
        expr["left"] = lower_expr_in_place(expr["left"], abi_layouts)
        expr["index"] = lower_expr_in_place(expr["index"], abi_layouts)
        return expr
    }
    if t == "Member" {
        expr["left"] = lower_expr_in_place(expr["left"], abi_layouts)
        return expr
    }
    if t == "SpawnExpr" {
        expr["call"] = lower_expr_in_place(expr["call"], abi_layouts)
        return expr
    }
    if t == "Call" {
        expr["fn"] = lower_expr_in_place(expr["fn"], abi_layouts)
        var args = expr["args"]
        var i3 = 0
        while i3 < oren_list_len(args) {
            args[i3] = lower_expr_in_place(args[i3], abi_layouts)
            i3 = i3 + 1
        }
        if expr["spread"] != nil {
            expr["spread"] = lower_expr_in_place(expr["spread"], abi_layouts)
        }

        var fn_expr = expr["fn"]
        if fn_expr != nil && fn_expr["type"] == "Identifier" {
            var name = fn_expr["value"]
            if name == "oren_abi_sizeof" || name == "oren_abi_alignof" {
                if oren_list_len(args) != 1 || args[0] == nil || args[0]["type"] != "String" {
                    print(name + " expects (\"Type\")")
                    oren_exit(1)
                }
                var tname = args[0]["value"]
                var lay = abi_layouts[tname]
                if lay == nil {
                    print(name + ": unknown ABI type: " + tname)
                    oren_exit(1)
                }
                if name == "oren_abi_sizeof" { return int_lit(lay["size"]) }
                return int_lit(lay["align"])
            }
            if name == "oren_abi_offsetof" {
                if oren_list_len(args) != 2 || args[0] == nil || args[0]["type"] != "String" || args[1] == nil || args[1]["type"] != "String" {
                    print("oren_abi_offsetof expects (\"Type\", \"field\")")
                    oren_exit(1)
                }
                var tname2 = args[0]["value"]
                var fname2 = args[1]["value"]
                var lay2 = abi_layouts[tname2]
                if lay2 == nil {
                    print("oren_abi_offsetof: unknown ABI type: " + tname2)
                    oren_exit(1)
                }
                var off = lay2["offsets"][fname2]
                if off == nil {
                    print("oren_abi_offsetof: unknown field: " + tname2 + "." + fname2)
                    oren_exit(1)
                }
                return int_lit(off)
            }
        }
        return expr
    }
    return expr
}

fn lower_stmt_in_place(stmt, abi_layouts) {
    if stmt == nil { return nil }
    var t = stmt["type"]

    if t == "Block" {
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            lower_stmt_in_place(stmts[i], abi_layouts)
            i = i + 1
        }
        return nil
    }
    if t == "StmtList" {
        var xs = stmt["stmts"]
        var i2 = 0
        while i2 < oren_list_len(xs) {
            lower_stmt_in_place(xs[i2], abi_layouts)
            i2 = i2 + 1
        }
        return nil
    }
    if t == "Var" {
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        return nil
    }
    if t == "Assign" {
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        return nil
    }
    if t == "Set" {
        stmt["left"] = lower_expr_in_place(stmt["left"], abi_layouts)
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        return nil
    }
    if t == "Return" {
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        return nil
    }
    if t == "ExprStmt" {
        stmt["expr"] = lower_expr_in_place(stmt["expr"], abi_layouts)
        return nil
    }
    if t == "While" {
        stmt["cond"] = lower_expr_in_place(stmt["cond"], abi_layouts)
        lower_stmt_in_place(stmt["body"], abi_layouts)
        return nil
    }
    if t == "For" {
        if stmt["init"] != nil { lower_stmt_in_place(stmt["init"], abi_layouts) }
        if stmt["cond"] != nil { stmt["cond"] = lower_expr_in_place(stmt["cond"], abi_layouts) }
        if stmt["post"] != nil { lower_stmt_in_place(stmt["post"], abi_layouts) }
        lower_stmt_in_place(stmt["body"], abi_layouts)
        return nil
    }
    if t == "Spawn" {
        stmt["call"] = lower_expr_in_place(stmt["call"], abi_layouts)
        return nil
    }
    if t == "Switch" {
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        var cases = stmt["cases"]
        var ci = 0
        while ci < oren_list_len(cases) {
            var vals = cases[ci]["values"]
            var vi = 0
            while vi < oren_list_len(vals) {
                vals[vi] = lower_expr_in_place(vals[vi], abi_layouts)
                vi = vi + 1
            }
            lower_stmt_in_place(cases[ci]["body"], abi_layouts)
            ci = ci + 1
        }
        if stmt["default"] != nil { lower_stmt_in_place(stmt["default"], abi_layouts) }
        return nil
    }
    return nil
}

fn lower_linked_program_in_place(linked) {
    if linked == nil { return nil }
    var stmts = linked["statements"]
    var abi_layouts = {}

    // Collect ABI-marked type layouts.
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st != nil && st["type"] == "Type" && has_attr_list(st, "oren.abi") {
            var tname = st["name"]["value"]
            abi_layouts[tname] = compute_abi_layout_for_type(st)
        }
        i = i + 1
    }

    // Rewrite expressions in all statements (compile-time-only builtins).
    i = 0
    while i < oren_list_len(stmts) {
        lower_stmt_in_place(stmts[i], abi_layouts)
        i = i + 1
    }

    linked["abi_layouts"] = abi_layouts
    return linked
}

