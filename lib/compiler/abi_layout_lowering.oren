import ast "ast.oren"

var ABI_LAYOUT_ERRS = nil

fn abi_layout_error(msg) {
    if ABI_LAYOUT_ERRS == nil { ABI_LAYOUT_ERRS = [] }
    oren_list_push(ABI_LAYOUT_ERRS, msg)
    return nil
}


// ABI layout lowering (rolling).
//
// Purpose:
// - Provide a deterministic, cross-backend way to compute C-like struct layout
//   for fixed-width primitive fields (u8/i8/u16/i16/u32/i32/u64/i64/f32/f64/bool).
// - Expose compile-time-only builtins:
//     oren_abi_sizeof("Type") -> int literal
//     oren_abi_alignof("Type") -> int literal
//     oren_abi_offsetof("Type", "field") -> int literal
//
// This is an opt-in mode enabled by annotating a type declaration:
//     @oren.abi
//     struct Foo { a: u8, b: u32, c: u16 }
//
// Non-goals (future work):
// - usize/isize, unions, bitfields, long double, platform-specific vector types
// - Emitting ABI structs as raw bytes by default (this pass is layout-only)
// - Replacing the current map/list-based struct representation in v0

fn is_attr_name(a, name) {
    if a == nil || name == nil { return false }
    return a["type"] == "Attr" && a["name"] == name
}

fn has_attr_list(stmt, name) {
    if stmt == nil { return false }
    var attrs = stmt["attrs"]
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        if is_attr_name(attrs[i], name) { return true }
        i = i + 1
    }
    return false
}

fn strip_oren_prefix(kind) {
    if kind == nil { return nil }
    if oren_string_len(kind) > 5 {
        if oren_string_slice(kind, 0, 5) == "oren." {
            return oren_string_slice(kind, 5, oren_string_len(kind))
        }
    }
    return kind
}

fn normalize_kind_for_layout(kind) {
    kind = strip_oren_prefix(kind)
    if kind == nil { return nil }
    // Endian tags are still the same width in memory for ABI purposes.
    if kind == "u16be" || kind == "u16le" { return "u16" }
    if kind == "i16be" || kind == "i16le" { return "i16" }
    if kind == "u32be" || kind == "u32le" { return "u32" }
    if kind == "i32be" || kind == "i32le" { return "i32" }
    if kind == "u64be" || kind == "u64le" { return "u64" }
    if kind == "i64be" || kind == "i64le" { return "i64" }
    return kind
}

fn abi_size_align_for_kind(kind) {
    // Returns {"size": int, "align": int} or nil if unsupported.
    var k = normalize_kind_for_layout(kind)
    if k == nil { return nil }
    if k == "u8" || k == "i8" || k == "bool" { return {"size": 1, "align": 1} }
    if k == "u16" || k == "i16" { return {"size": 2, "align": 2} }
    if k == "u32" || k == "i32" || k == "f32" { return {"size": 4, "align": 4} }
    if k == "u64" || k == "i64" || k == "f64" { return {"size": 8, "align": 8} }
    if k == "u128" || k == "i128" { return {"size": 16, "align": 16} }
    return nil
}

fn parse_uint_dec(s) {
    // Returns int or nil.
    if s == nil { return nil }
    if s == "" { return nil }
    var n = 0
    var i = 0
    while i < oren_string_len(s) {
        var c = oren_string_slice(s, i, i + 1)
        if c == "0" { n = n * 10 + 0 }
        else {
            if c == "1" { n = n * 10 + 1 }
            else {
                if c == "2" { n = n * 10 + 2 }
                else {
                    if c == "3" { n = n * 10 + 3 }
                    else {
                        if c == "4" { n = n * 10 + 4 }
                        else {
                            if c == "5" { n = n * 10 + 5 }
                            else {
                                if c == "6" { n = n * 10 + 6 }
                                else {
                                    if c == "7" { n = n * 10 + 7 }
                                    else {
                                        if c == "8" { n = n * 10 + 8 }
                                        else {
                                            if c == "9" { n = n * 10 + 9 }
                                            else { return nil }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return n
}

fn abi_ptr_size_align_for_target(target, arch) {
    // Returns {"size": int, "align": int}
    //
    // Rolling: all currently supported native targets are arm64 and use 64-bit pointers.
    // We keep this centralized so future arch additions can update here.
    if target == nil { return nil }
    if arch == nil { arch = "arm64" }
    if arch == "arm64" {
        if target == "macos" { return {"size": 8, "align": 8} }
        if target == "linux" { return {"size": 8, "align": 8} }
        return {"size": 8, "align": 8}
    }
    return nil
}

fn abi_strip_ptr_prefix(kind) {
    // Returns {"ptr_depth": int, "rest": string}
    var d = 0
    var i = 0
    while i < oren_string_len(kind) {
        if oren_string_slice(kind, i, i + 1) != "*" { break }
        d = d + 1
        i = i + 1
    }
    return {"ptr_depth": d, "rest": oren_string_slice(kind, i, oren_string_len(kind))}
}

fn abi_parse_array_suffixes(rest) {
    // Parses T[N][M]... suffixes.
    // Returns {"base": string, "dims": [int,...]}.
    var base = rest
    var dims = []
    while true {
        var l = oren_string_len(base)
        if l < 3 { break }

        // Find the last ']' and the matching '[' for a suffix.
        if oren_string_slice(base, l - 1, l) != "]" { break }
        var j = l - 2
        while j >= 0 {
            if oren_string_slice(base, j, j + 1) == "[" { break }
            j = j - 1
        }
        if j < 0 { break }
        var num_str = oren_string_slice(base, j + 1, l - 1)
        var n = parse_uint_dec(num_str)
        if n == nil {
            return nil
        }
        // NOTE: dim order doesn't matter for size computation (product),
        // and C array alignment is the element alignment regardless of nesting.
        oren_list_push(dims, n)
        base = oren_string_slice(base, 0, j)
    }
    return {"base": base, "dims": dims}
}

fn abi_size_align_for_ann_type(kind, abi_types, abi_layouts, target, arch, visiting) {
    // Returns {"size": int, "align": int} or nil.
    if kind == nil { return nil }
    kind = strip_oren_prefix(kind)
    if kind == nil { return nil }

    var pref = abi_strip_ptr_prefix(kind)
    var ptr_depth = pref["ptr_depth"]
    var rest = pref["rest"]

    var arr = abi_parse_array_suffixes(rest)
    if arr == nil { return nil }
    var base = arr["base"]
    var dims = arr["dims"]

    var sa = nil

    if ptr_depth > 0 {
        sa = abi_ptr_size_align_for_target(target, arch)
    } else {
        if base == "usize" || base == "isize" {
            // size_t/ssize_t (pointer-sized integers).
            sa = abi_ptr_size_align_for_target(target, arch)
        } else {
        sa = abi_size_align_for_kind(base)
        }
        if sa == nil {
            // Nested ABI struct by name.
            var lay = abi_layouts[base]
            if lay == nil {
                var st = nil
                if abi_types != nil { st = abi_types[base] }
                if st == nil { return nil }

                if visiting != nil && visiting[base] == true {
                    abi_layout_error("ABI layout cycle detected involving: " + base)
                    return nil
                }
                visiting[base] = true
                lay = compute_abi_layout_for_type(st, abi_types, abi_layouts, target, arch, visiting)
                visiting[base] = false
                abi_layouts[base] = lay
                if lay == nil { return nil }
            }
            sa = {"size": lay["size"], "align": lay["align"]}
        }
    }

    if sa == nil { return nil }

    // Apply fixed array dims.
    var sz = sa["size"]
    var al = sa["align"]
    var i = 0
    while i < oren_list_len(dims) {
        var n = dims[i]
        if n == nil || n < 0 {
            return nil
        }
        sz = sz * n
        i = i + 1
    }
    return {"size": sz, "align": al}
}

fn align_up(off, align) {
    if align <= 1 { return off }
    var mask = align - 1
    var r = off & mask
    if r == 0 { return off }
    return off + (align - r)
}

fn compute_abi_layout_for_type(stmt, abi_types, abi_layouts, target, arch, visiting) {
    // Returns:
    //  {"size": int, "align": int, "offsets": {fieldName: int}}
    var tname = stmt["name"]["value"]
    var fields = stmt["fields"]
    var offsets = {}
    var off = 0
    var max_align = 1

    var i = 0
    while i < oren_list_len(fields) {
        var fid = fields[i]
        var fname = fid["value"]
        var kind = fid["ann_type"]
        if kind == nil {
            abi_layout_error("ABI struct field missing type annotation: " + tname + "." + fname)
            return nil
        }
        var sa = abi_size_align_for_ann_type(kind, abi_types, abi_layouts, target, arch, visiting)
        if sa == nil {
            abi_layout_error("ABI struct field has unsupported type: " + tname + "." + fname + ": " + kind)
            return nil
        }
        var sz = sa["size"]
        var al = sa["align"]
        if al > max_align { max_align = al }
        off = align_up(off, al)
        offsets[fname] = off
        off = off + sz
        i = i + 1
    }

    var size = align_up(off, max_align)
    return {"size": size, "align": max_align, "offsets": offsets}
}

fn int_lit(v) { return {"type": "Integer", "token": nil, "value": oren_int_to_string(v)} }
fn string_lit(s) { return {"type": "String", "token": nil, "value": s} }

fn lower_expr_in_place(expr, abi_layouts) {
    if expr == nil { return nil }
    var t = expr["type"]

    if t == "Function" {
        lower_stmt_in_place(expr["body"], abi_layouts)
        return expr
    }
    if t == "Prefix" {
        expr["right"] = lower_expr_in_place(expr["right"], abi_layouts)
        return expr
    }
    if t == "Infix" {
        expr["left"] = lower_expr_in_place(expr["left"], abi_layouts)
        expr["right"] = lower_expr_in_place(expr["right"], abi_layouts)
        return expr
    }
    if t == "If" {
        expr["cond"] = lower_expr_in_place(expr["cond"], abi_layouts)
        lower_stmt_in_place(expr["consq"], abi_layouts)
        if expr["alt"] != nil { lower_stmt_in_place(expr["alt"], abi_layouts) }
        return expr
    }
    if t == "Array" {
        var xs = expr["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            xs[i] = lower_expr_in_place(xs[i], abi_layouts)
            i = i + 1
        }
        return expr
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            ps[i2]["key"] = lower_expr_in_place(ps[i2]["key"], abi_layouts)
            ps[i2]["value"] = lower_expr_in_place(ps[i2]["value"], abi_layouts)
            i2 = i2 + 1
        }
        return expr
    }
    if t == "Index" {
        expr["left"] = lower_expr_in_place(expr["left"], abi_layouts)
        expr["index"] = lower_expr_in_place(expr["index"], abi_layouts)
        return expr
    }
    if t == "Member" {
        expr["left"] = lower_expr_in_place(expr["left"], abi_layouts)
        return expr
    }
    if t == "SpawnExpr" {
        expr["call"] = lower_expr_in_place(expr["call"], abi_layouts)
        return expr
    }
    if t == "Call" {
        expr["fn"] = lower_expr_in_place(expr["fn"], abi_layouts)
        var args = expr["args"]
        var i3 = 0
        while i3 < oren_list_len(args) {
            args[i3] = lower_expr_in_place(args[i3], abi_layouts)
            i3 = i3 + 1
        }
        if expr["spread"] != nil {
            expr["spread"] = lower_expr_in_place(expr["spread"], abi_layouts)
        }

        var fn_expr = expr["fn"]
        if fn_expr != nil && fn_expr["type"] == "Identifier" {
            var name = fn_expr["value"]
            if name == "oren_build_target" || name == "oren_build_arch" {
                if oren_list_len(args) != 0 {
                    abi_layout_error(name + " expects ()")
                    return expr
                }
                if name == "oren_build_target" {
                    var v = abi_layouts["__oren_config_target"]
                    if v == nil { v = "macos" }
                    return string_lit(v)
                }
                var a = abi_layouts["__oren_config_arch"]
                if a == nil { a = "arm64" }
                return string_lit(a)
            }
            if name == "oren_abi_sizeof" || name == "oren_abi_alignof" {
                if oren_list_len(args) != 1 || args[0] == nil || args[0]["type"] != "String" {
                    abi_layout_error(name + " expects (\"Type\")")
                    return expr
                }
                var tname = args[0]["value"]
                var lay = abi_layouts[tname]
                if lay == nil {
                    abi_layout_error(name + ": unknown ABI type: " + tname)
                    return expr
                }
                if name == "oren_abi_sizeof" { return int_lit(lay["size"]) }
                return int_lit(lay["align"])
            }
            if name == "oren_abi_offsetof" {
                if oren_list_len(args) != 2 || args[0] == nil || args[0]["type"] != "String" || args[1] == nil || args[1]["type"] != "String" {
                    abi_layout_error("oren_abi_offsetof expects (\"Type\", \"field\")")
                    return expr
                }
                var tname2 = args[0]["value"]
                var fname2 = args[1]["value"]
                var lay2 = abi_layouts[tname2]
                if lay2 == nil {
                    abi_layout_error("oren_abi_offsetof: unknown ABI type: " + tname2)
                    return expr
                }
                var off = lay2["offsets"][fname2]
                if off == nil {
                    abi_layout_error("oren_abi_offsetof: unknown field: " + tname2 + "." + fname2)
                    return expr
                }
                return int_lit(off)
            }
        }
        return expr
    }
    return expr
}

fn lower_stmt_in_place(stmt, abi_layouts) {
    if stmt == nil { return nil }
    var t = stmt["type"]

    if t == "Block" {
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            lower_stmt_in_place(stmts[i], abi_layouts)
            i = i + 1
        }
        return nil
    }
    if t == "StmtList" {
        var xs = stmt["stmts"]
        var i2 = 0
        while i2 < oren_list_len(xs) {
            lower_stmt_in_place(xs[i2], abi_layouts)
            i2 = i2 + 1
        }
        return nil
    }
    if t == "Var" {
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        return nil
    }
    if t == "Assign" {
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        return nil
    }
    if t == "Set" {
        stmt["left"] = lower_expr_in_place(stmt["left"], abi_layouts)
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        return nil
    }
    if t == "Return" {
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        return nil
    }
    if t == "ExprStmt" {
        stmt["expr"] = lower_expr_in_place(stmt["expr"], abi_layouts)
        return nil
    }
    if t == "While" {
        stmt["cond"] = lower_expr_in_place(stmt["cond"], abi_layouts)
        lower_stmt_in_place(stmt["body"], abi_layouts)
        return nil
    }
    if t == "For" {
        if stmt["init"] != nil { lower_stmt_in_place(stmt["init"], abi_layouts) }
        if stmt["cond"] != nil { stmt["cond"] = lower_expr_in_place(stmt["cond"], abi_layouts) }
        if stmt["post"] != nil { lower_stmt_in_place(stmt["post"], abi_layouts) }
        lower_stmt_in_place(stmt["body"], abi_layouts)
        return nil
    }
    if t == "Spawn" {
        stmt["call"] = lower_expr_in_place(stmt["call"], abi_layouts)
        return nil
    }
    if t == "Switch" {
        stmt["value"] = lower_expr_in_place(stmt["value"], abi_layouts)
        var cases = stmt["cases"]
        var ci = 0
        while ci < oren_list_len(cases) {
            var vals = cases[ci]["values"]
            var vi = 0
            while vi < oren_list_len(vals) {
                vals[vi] = lower_expr_in_place(vals[vi], abi_layouts)
                vi = vi + 1
            }
            lower_stmt_in_place(cases[ci]["body"], abi_layouts)
            ci = ci + 1
        }
        if stmt["default"] != nil { lower_stmt_in_place(stmt["default"], abi_layouts) }
        return nil
    }
    return nil
}

fn lower_linked_program_in_place(linked) {
    ABI_LAYOUT_ERRS = []
    if linked == nil { return nil }
    var stmts = linked["statements"]
    var abi_layouts = {}
    var abi_types = {}
    var target = nil
    if linked["config"] != nil {
        target = linked["config"]["target"]
    }
    if target == nil {
        // Rolling default: macOS first.
        target = "macos"
    }
    var arch = nil
    if linked["config"] != nil {
        arch = linked["config"]["arch"]
    }
    if arch == nil { arch = "arm64" }

    // Reserve config keys inside abi_layouts for compile-time builtins.
    // (Type names can't reasonably collide with these.)
    abi_layouts["__oren_config_target"] = target
    abi_layouts["__oren_config_arch"] = arch

    // Collect ABI-marked type layouts.
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st != nil && st["type"] == "Type" && has_attr_list(st, "oren.abi") {
            var tname = st["name"]["value"]
            abi_types[tname] = st
            abi_layouts[tname] = nil
        }
        i = i + 1
    }

    // Compute layouts with nested type support (lazy recursion).
    var visiting = {}
    var it = 0
    while it < oren_list_len(stmts) {
        var st2 = stmts[it]
        if st2 != nil && st2["type"] == "Type" && has_attr_list(st2, "oren.abi") {
            var tname2 = st2["name"]["value"]
            if abi_layouts[tname2] == nil {
                visiting[tname2] = true
                abi_layouts[tname2] = compute_abi_layout_for_type(st2, abi_types, abi_layouts, target, arch, visiting)
                visiting[tname2] = false
            }
        }
        it = it + 1
    }

    // Rewrite expressions in all statements (compile-time-only builtins).
    i = 0
    while i < oren_list_len(stmts) {
        lower_stmt_in_place(stmts[i], abi_layouts)
        i = i + 1
    }

    if ABI_LAYOUT_ERRS != nil && oren_list_len(ABI_LAYOUT_ERRS) > 0 {
        linked["abi_layout_errors"] = ABI_LAYOUT_ERRS
    }

    linked["abi_layouts"] = abi_layouts
    return linked
}
