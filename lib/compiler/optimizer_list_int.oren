import ast "ast.oren"
import opthelp "optimizer_helpers.oren"
import optcore "optimizer_core.oren"

fn _opt_trace_list_int(msg) { return optcore._opt_trace_list_int(msg) }
fn _opt_backend_allows_list_int_unchecked() { return optcore._opt_backend_allows_list_int_unchecked() }

var OPT_LIST_INT_TRACE_ENABLED = nil
var OPT_LIST_INT_PROFILE_ENABLED = false
var OPT_LIST_INT_LOCALS_NS = 0
var OPT_LIST_INT_NESTED_NS = 0
var OPT_LIST_INT_SCAN_NS = 0
var OPT_LIST_INT_LOWER_NS = 0
var OPT_LIST_INT_USE_SCAN_NS = 0
var OPT_LIST_INT_TOUCH_NS = 0
var OPT_LIST_INT_CANDIDATE_NS = 0
var OPT_LIST_INT_REWRITE_INIT_NS = 0
var OPT_LIST_INT_REWRITE_USES_NS = 0

fn _opt_trace_list_int_enabled() {
    if OPT_LIST_INT_TRACE_ENABLED == nil {
        OPT_LIST_INT_TRACE_ENABLED = oren_env("OREN_TRACE_LIST_INT") != nil
    }
    return OPT_LIST_INT_TRACE_ENABLED == true
}

fn _opt_list_int_profile_reset(enabled) {
    OPT_LIST_INT_PROFILE_ENABLED = enabled == true
    OPT_LIST_INT_LOCALS_NS = 0
    OPT_LIST_INT_NESTED_NS = 0
    OPT_LIST_INT_SCAN_NS = 0
    OPT_LIST_INT_LOWER_NS = 0
    OPT_LIST_INT_USE_SCAN_NS = 0
    OPT_LIST_INT_TOUCH_NS = 0
    OPT_LIST_INT_CANDIDATE_NS = 0
    OPT_LIST_INT_REWRITE_INIT_NS = 0
    OPT_LIST_INT_REWRITE_USES_NS = 0
    return nil
}

fn _opt_list_int_profile_add(kind, start_ns) {
    if OPT_LIST_INT_PROFILE_ENABLED != true { return nil }
    if start_ns == nil || start_ns <= 0 { return nil }
    var dt = oren_time_now_ns() - start_ns
    if kind == "locals" { OPT_LIST_INT_LOCALS_NS = OPT_LIST_INT_LOCALS_NS + dt }
    else if kind == "nested" { OPT_LIST_INT_NESTED_NS = OPT_LIST_INT_NESTED_NS + dt }
    else if kind == "scan" { OPT_LIST_INT_SCAN_NS = OPT_LIST_INT_SCAN_NS + dt }
    else if kind == "lower" { OPT_LIST_INT_LOWER_NS = OPT_LIST_INT_LOWER_NS + dt }
    else if kind == "use_scan" { OPT_LIST_INT_USE_SCAN_NS = OPT_LIST_INT_USE_SCAN_NS + dt }
    else if kind == "touch" { OPT_LIST_INT_TOUCH_NS = OPT_LIST_INT_TOUCH_NS + dt }
    else if kind == "candidate" { OPT_LIST_INT_CANDIDATE_NS = OPT_LIST_INT_CANDIDATE_NS + dt }
    else if kind == "rewrite_init" { OPT_LIST_INT_REWRITE_INIT_NS = OPT_LIST_INT_REWRITE_INIT_NS + dt }
    else if kind == "rewrite_uses" { OPT_LIST_INT_REWRITE_USES_NS = OPT_LIST_INT_REWRITE_USES_NS + dt }
    return nil
}

fn _opt_list_int_profile_detail() {
    if OPT_LIST_INT_PROFILE_ENABLED != true { return "" }
    return " list_int_locals_ms=" + oren_int_to_string(OPT_LIST_INT_LOCALS_NS / 1000000) +
        " list_int_nested_ms=" + oren_int_to_string(OPT_LIST_INT_NESTED_NS / 1000000) +
        " list_int_scan_ms2=" + oren_int_to_string(OPT_LIST_INT_SCAN_NS / 1000000) +
        " list_int_lower_ms=" + oren_int_to_string(OPT_LIST_INT_LOWER_NS / 1000000) +
        " list_int_use_scan_ms=" + oren_int_to_string(OPT_LIST_INT_USE_SCAN_NS / 1000000) +
        " list_int_touch_ms=" + oren_int_to_string(OPT_LIST_INT_TOUCH_NS / 1000000) +
        " list_int_candidate_ms=" + oren_int_to_string(OPT_LIST_INT_CANDIDATE_NS / 1000000) +
        " list_int_rewrite_init_ms=" + oren_int_to_string(OPT_LIST_INT_REWRITE_INIT_NS / 1000000) +
        " list_int_rewrite_uses_ms=" + oren_int_to_string(OPT_LIST_INT_REWRITE_USES_NS / 1000000)
}

fn _opt_is_len_call(expr) {
    if expr == nil || expr["type"] != "Call" { return false }
    var fnn = expr["fn"]
    if fnn == nil || fnn["type"] != "Identifier" { return false }
    var nm = fnn["value"]
    if nm != "oren_list_len" && nm != "oren_list_int_len" && nm != "oren_list_int_len_unchecked" &&
        nm != "oren_map_len" && nm != "oren_buf_len" && nm != "oren_string_len" {
        return false
    }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 { return false }
    var arg0 = args[0]
    if arg0 == nil || arg0["type"] != "Identifier" { return false }
    return true
}

fn _opt_safe_int_call_name(expr) {
    if expr == nil || expr["type"] != "Call" { return nil }
    var nm = _opt_call_name(expr)
    if nm != nil { return nm }
    var fnn = expr["fn"]
    if fnn != nil && fnn["type"] == "Identifier" { return fnn["value"] }
    return nil
}


fn _opt_is_safe_int_expr(expr, last_int_safe) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Integer" { return true }
    if t == "Identifier" {
        var nm = expr["value"]
        if nm != nil && last_int_safe != nil && last_int_safe[nm] == true { return true }
        return false
    }
    if _opt_is_len_call(expr) { return true }
    if t == "Call" {
        var nm2 = _opt_safe_int_call_name(expr)
        var args2 = expr["args"]
        var argc2 = 0
        if args2 != nil { argc2 = oren_list_len(args2) }
        if argc2 == 1 {
            if nm2 == "oren_int" || nm2 == "oren_trunc_int" || nm2 == "oren_bool_norm" ||
               nm2 == "oren_f32_to_u32_bits" || nm2 == "oren_f64_to_u64_bits" {
                return true
            }
            if nm2 == "oren_list_int_get" || nm2 == "STD_list_int_get" ||
               nm2 == "oren_list_int_get_unchecked" || nm2 == "STD_list_int_get_unchecked" {
                return true
            }
        }
        return false
    }
    if t == "Prefix" {
        var op0 = expr["op"]
        if op0 == "-" || op0 == "+" { return _opt_is_safe_int_expr(expr["right"], last_int_safe) }
        return false
    }
    if t == "Infix" {
        var op = expr["op"]
        if op == "+" || op == "-" || op == "*" || op == "%" {
            if _opt_is_safe_int_expr(expr["left"], last_int_safe) && _opt_is_safe_int_expr(expr["right"], last_int_safe) { return true }
        }
        return false
    }
    return false
}


fn _opt_is_empty_list_lit(expr) {
    if expr == nil || expr["type"] != "Array" { return false }
    var els = expr["elements"]
    if els == nil { return true }
    return oren_list_len(els) == 0
}


fn _opt_call_name(expr) {
    if expr == nil || expr["type"] != "Call" { return nil }
    var fnn = expr["fn"]
    if fnn == nil { return nil }
    if fnn["type"] == "Identifier" { return fnn["value"] }
    if fnn["type"] == "Member" {
        var left = fnn["left"]
        var prop = fnn["prop"]
        if left != nil && prop != nil && left["type"] == "Identifier" && left["value"] == "list" {
            var p = prop["value"]
            if p == "push" { return "STD_list_push" }
            if p == "len" { return "STD_list_len" }
            if p == "get" { return "STD_list_get" }
            if p == "set" { return "STD_list_set" }
            if p == "reserve" { return "STD_list_reserve" }
            if p == "int_new" { return "STD_list_int_new" }
            if p == "int_push" { return "STD_list_int_push" }
            if p == "int_get" { return "STD_list_int_get" }
            if p == "int_set" { return "STD_list_int_set" }
            if p == "int_len" { return "STD_list_int_len" }
            if p == "int_reserve" { return "STD_list_int_reserve" }
        }
    }
    return nil
}


fn _opt_list_int_call_is_safe(nm, args, safe_ints) {
    if nm == nil { return false }
    if args == nil || oren_list_len(args) < 1 { return false }
    if nm == "oren_list_len" || nm == "STD_list_len" ||
        nm == "oren_list_int_len" || nm == "STD_list_int_len" ||
        nm == "oren_list_int_len_unchecked" || nm == "STD_list_int_len_unchecked" {
        return true
    }
    if nm == "oren_list_push" || nm == "STD_list_push" || nm == "oren_list_int_push" || nm == "STD_list_int_push" {
        if oren_list_len(args) < 2 { return false }
        if _opt_is_safe_int_expr(args[1], safe_ints) != true {
            var arg_name = opthelp.is_ident(args[1])
            if arg_name != nil {
                var arg_safe = "nil"
                var map_len = 0
                var keys = ""
                if safe_ints != nil {
                    map_len = oren_map_len(safe_ints)
                    if safe_ints[arg_name] == true { arg_safe = "1" }
                    else { arg_safe = "0" }
                    for k in safe_ints {
                        if safe_ints[k] == true {
                            if keys != "" { keys = keys + "," }
                            keys = keys + k
                        }
                    }
                }
                _opt_trace_list_int("[opt] list_int push_arg_unsafe name=" + arg_name + " safe=" + arg_safe + " map=" + oren_int_to_string(map_len) + " keys=" + keys)
            } else if args[1] != nil {
                _opt_trace_list_int("[opt] list_int push_arg_unsafe type=" + args[1]["type"])
            }
            return false
        }
        return true
    }
    if nm == "oren_list_get" || nm == "STD_list_get" ||
        nm == "oren_list_int_get" || nm == "STD_list_int_get" ||
        nm == "oren_list_int_get_unchecked" || nm == "STD_list_int_get_unchecked" {
        if oren_list_len(args) < 2 { return false }
        return _opt_is_safe_int_expr(args[1], safe_ints)
    }
    if nm == "oren_list_set" || nm == "STD_list_set" || nm == "oren_list_int_set" || nm == "STD_list_int_set" {
        if oren_list_len(args) < 3 { return false }
        if _opt_is_safe_int_expr(args[1], safe_ints) != true { return false }
        return _opt_is_safe_int_expr(args[2], safe_ints)
    }
    if nm == "oren_list_reserve" || nm == "STD_list_reserve" ||
        nm == "oren_list_int_reserve" || nm == "STD_list_int_reserve" {
        if oren_list_len(args) < 2 { return false }
        return _opt_is_safe_int_expr(args[1], safe_ints)
    }
    return false
}


fn _opt_list_int_rewrite_name(nm) {
    if nm == "oren_list_push" || nm == "STD_list_push" { return "oren_list_int_push" }
    if nm == "oren_list_len" || nm == "STD_list_len" { return "oren_list_int_len" }
    if nm == "oren_list_get" || nm == "STD_list_get" { return "oren_list_int_get" }
    if nm == "oren_list_set" || nm == "STD_list_set" { return "oren_list_int_set" }
    if nm == "oren_list_reserve" || nm == "STD_list_reserve" { return "oren_list_int_reserve" }
    return nil
}


fn _opt_list_state_is_candidate(list_state, name) {
    if list_state == nil || name == nil { return false }
    return list_state[name] != nil
}


fn _opt_list_state_is_safe(list_state, name) {
    if list_state == nil || name == nil { return false }
    return list_state[name] == true
}


fn _opt_list_state_mark_unsafe(list_state, name) {
    return _opt_list_state_mark_unsafe_reason(list_state, name, nil)
}

fn _opt_list_state_mark_unsafe_reason(list_state, name, reason) {
    if list_state == nil || name == nil { return nil }
    if list_state[name] != nil {
        list_state[name] = false
        if reason != nil { _opt_trace_list_int("[opt] list_int unsafe name=" + name + " reason=" + reason) }
        else { _opt_trace_list_int("[opt] list_int unsafe name=" + name) }
    }
    return nil
}


fn _opt_list_touch_mark(list_touch, name) {
    if list_touch == nil || name == nil { return nil }
    list_touch[name] = true
    _opt_trace_list_int("[opt] list_int touch name=" + name)
    return nil
}


fn _opt_map_clone_safe(m) {
    var out = {}
    if m != nil {
        for k in m {
            out[k] = m[k]
        }
    }
    return out
}


fn _opt_safe_ints_invalidate_in_stmt(stmt, safe_ints) {
    if stmt == nil || safe_ints == nil { return nil }
    var t = stmt["type"]
    if t == "Var" || t == "Assign" {
        var nm = opthelp.is_ident(stmt["name"])
        if nm != nil { safe_ints[nm] = false }
        return nil
    }
    if t == "Set" {
        var left = stmt["left"]
        if left != nil && left["type"] == "Identifier" {
            var nm2 = left["value"]
            if nm2 != nil { safe_ints[nm2] = false }
        }
        return nil
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                _opt_safe_ints_invalidate_in_stmt(ss[i], safe_ints)
                i = i + 1
            }
        }
        return nil
    }
    if t == "If" {
        _opt_safe_ints_invalidate_in_stmt(stmt["consq"], safe_ints)
        if stmt["alt"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["alt"], safe_ints) }
        return nil
    }
    if t == "While" {
        _opt_safe_ints_invalidate_in_stmt(stmt["body"], safe_ints)
        return nil
    }
    if t == "For" {
        if stmt["init"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["init"], safe_ints) }
        if stmt["post"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["post"], safe_ints) }
        if stmt["body"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["body"], safe_ints) }
        return nil
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil { _opt_safe_ints_invalidate_in_stmt(c["body"], safe_ints) }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["default"], safe_ints) }
        return nil
    }
    if t == "Function" { return nil }
    return nil
}

fn _opt_safe_ints_with_loop_idx(safe_ints, cond_expr) {
    var out = _opt_map_clone_safe(safe_ints)
    if cond_expr != nil && cond_expr["type"] == "Infix" && cond_expr["op"] == "<" {
        var left_name = opthelp.is_ident(cond_expr["left"])
        if left_name != nil && _opt_is_safe_int_expr(cond_expr["right"], out) {
            out[left_name] = true
        }
    }
    return out
}

fn _opt_safe_ints_intersect(a, b) {
    var out = {}
    if a != nil {
        for k in a {
            if a[k] == true && b != nil && b[k] == true { out[k] = true }
            else { out[k] = false }
        }
    }
    if b != nil {
        for k in b {
            if out[k] == nil {
                if a != nil && a[k] == true && b[k] == true { out[k] = true }
                else { out[k] = false }
            }
        }
    }
    return out
}

fn _opt_safe_ints_after_stmt(stmt, safe_ints, tag) {
    if stmt == nil { return safe_ints }
    var t = stmt["type"]
    if t == "Var" || t == "Assign" {
        var nm = opthelp.is_ident(stmt["name"])
        if nm != nil {
            var is_safe = _opt_is_safe_int_expr(stmt["value"], safe_ints)
            if is_safe { safe_ints[nm] = true }
            else { safe_ints[nm] = false }
            var safe_flag = "0"
            if is_safe { safe_flag = "1" }
            if tag == "uses" && (nm == "v" || nm == "v2") && _opt_trace_list_int_enabled() == true {
                var keys = ""
                for k in safe_ints {
                    if safe_ints[k] == true {
                        if keys != "" { keys = keys + "," }
                        keys = keys + k
                    }
                }
                _opt_trace_list_int("[opt] list_int safe_int tag=" + tag + " name=" + nm + " safe=" + safe_flag + " keys=" + keys)
            } else {
                _opt_trace_list_int("[opt] list_int safe_int tag=" + tag + " name=" + nm + " safe=" + safe_flag)
            }
        }
        return safe_ints
    }
    if t == "Set" {
        var left = stmt["left"]
        if left != nil && left["type"] == "Identifier" {
            var nm2 = left["value"]
            if nm2 != nil {
                var is_safe2 = _opt_is_safe_int_expr(stmt["value"], safe_ints)
                if is_safe2 { safe_ints[nm2] = true }
                else { safe_ints[nm2] = false }
                var safe_flag2 = "0"
                if is_safe2 { safe_flag2 = "1" }
                _opt_trace_list_int("[opt] list_int safe_int tag=" + tag + " name=" + nm2 + " safe=" + safe_flag2)
            }
        }
        return safe_ints
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        var out = safe_ints
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                out = _opt_safe_ints_after_stmt(ss[i], out, tag)
                i = i + 1
            }
        }
        return out
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && (e["type"] == "If" || e["type"] == "Switch") {
            return _opt_safe_ints_after_stmt(e, safe_ints, tag)
        }
        _opt_safe_ints_invalidate_in_stmt(stmt, safe_ints)
        return safe_ints
    }
    if t == "If" {
        if tag == "uses" && safe_ints != nil && safe_ints["j"] == true && _opt_trace_list_int_enabled() == true {
            var keys_before = ""
            for k in safe_ints {
                if safe_ints[k] == true {
                    if keys_before != "" { keys_before = keys_before + "," }
                    keys_before = keys_before + k
                }
            }
            _opt_trace_list_int("[opt] list_int safe_int_if_before keys=" + keys_before)
        }
        var consq = _opt_map_clone_safe(safe_ints)
        if stmt["consq"] != nil { consq = _opt_safe_ints_after_stmt(stmt["consq"], consq, tag) }
        var alt = _opt_map_clone_safe(safe_ints)
        if stmt["alt"] != nil { alt = _opt_safe_ints_after_stmt(stmt["alt"], alt, tag) }
        var out = _opt_safe_ints_intersect(consq, alt)
        if tag == "uses" && out != nil && out["j"] == true && _opt_trace_list_int_enabled() == true {
            var keys_after = ""
            for k2 in out {
                if out[k2] == true {
                    if keys_after != "" { keys_after = keys_after + "," }
                    keys_after = keys_after + k2
                }
            }
            _opt_trace_list_int("[opt] list_int safe_int_if_after keys=" + keys_after)
        }
        return out
    }
    _opt_safe_ints_invalidate_in_stmt(stmt, safe_ints)
    return safe_ints
}


fn _opt_scan_list_int_uses_expr(expr, list_state, safe_ints) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Identifier" {
        _opt_list_state_mark_unsafe_reason(list_state, expr["value"], "ident")
        return nil
    }
    if t == "Index" {
        var list_name = opthelp.is_ident(expr["left"])
        if list_name != nil && _opt_list_state_is_candidate(list_state, list_name) {
            if _opt_is_safe_int_expr(expr["index"], safe_ints) != true {
                _opt_list_state_mark_unsafe_reason(list_state, list_name, "index")
            }
            _opt_scan_list_int_uses_expr(expr["index"], list_state, safe_ints)
            return nil
        }
        _opt_scan_list_int_uses_expr(expr["left"], list_state, safe_ints)
        _opt_scan_list_int_uses_expr(expr["index"], list_state, safe_ints)
        return nil
    }
    if t == "Call" {
        var nm = _opt_call_name(expr)
        var args = expr["args"]
        if nm != nil && args != nil && oren_list_len(args) > 0 {
            var recv_name = opthelp.is_ident(args[0])
            if recv_name != nil && _opt_list_state_is_candidate(list_state, recv_name) {
                if _opt_list_int_call_is_safe(nm, args, safe_ints) != true {
                    _opt_list_state_mark_unsafe_reason(list_state, recv_name, "call:" + nm)
                }
                var ai = 1
                while ai < oren_list_len(args) {
                    _opt_scan_list_int_uses_expr(args[ai], list_state, safe_ints)
                    ai = ai + 1
                }
                if expr["spread"] != nil { _opt_scan_list_int_uses_expr(expr["spread"], list_state, safe_ints) }
                return nil
            }
        }
        if expr["fn"] != nil { _opt_scan_list_int_uses_expr(expr["fn"], list_state, safe_ints) }
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                _opt_scan_list_int_uses_expr(args[i], list_state, safe_ints)
                i = i + 1
            }
        }
        if expr["spread"] != nil { _opt_scan_list_int_uses_expr(expr["spread"], list_state, safe_ints) }
        return nil
    }
    if t == "Prefix" { return _opt_scan_list_int_uses_expr(expr["right"], list_state, safe_ints) }
    if t == "Infix" {
        _opt_scan_list_int_uses_expr(expr["left"], list_state, safe_ints)
        _opt_scan_list_int_uses_expr(expr["right"], list_state, safe_ints)
        return nil
    }
    if t == "If" {
        _opt_scan_list_int_uses_expr(expr["cond"], list_state, safe_ints)
        _opt_scan_list_int_uses_stmt(expr["consq"], list_state, _opt_map_clone_safe(safe_ints))
        if expr["alt"] != nil { _opt_scan_list_int_uses_stmt(expr["alt"], list_state, _opt_map_clone_safe(safe_ints)) }
        _opt_safe_ints_invalidate_in_stmt(expr["consq"], safe_ints)
        if expr["alt"] != nil { _opt_safe_ints_invalidate_in_stmt(expr["alt"], safe_ints) }
        return nil
    }
    if t == "Function" {
        // Captures cross block boundaries; treat any candidate list use as unsafe.
        if expr["body"] != nil { _opt_mark_list_state_unsafe_in_stmt(expr["body"], list_state) }
        return nil
    }
    if t == "Array" {
        var els = expr["elements"]
        if els != nil {
            var i2 = 0
            while i2 < oren_list_len(els) {
                _opt_scan_list_int_uses_expr(els[i2], list_state, safe_ints)
                i2 = i2 + 1
            }
        }
        return nil
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        if ps != nil {
            var i3 = 0
            while i3 < oren_list_len(ps) {
                _opt_scan_list_int_uses_expr(ps[i3]["key"], list_state, safe_ints)
                _opt_scan_list_int_uses_expr(ps[i3]["value"], list_state, safe_ints)
                i3 = i3 + 1
            }
        }
        return nil
    }
    if t == "Member" { return _opt_scan_list_int_uses_expr(expr["left"], list_state, safe_ints) }
    if t == "Switch" {
        _opt_scan_list_int_uses_expr(expr["cond"], list_state, safe_ints)
        var cases = expr["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
