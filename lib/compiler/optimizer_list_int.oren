}


fn _opt_mark_list_state_unsafe_in_stmt(stmt, list_state) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "ExprStmt" { return _opt_mark_list_state_unsafe_in_expr(stmt["expr"], list_state) }
    if t == "Return" { return _opt_mark_list_state_unsafe_in_expr(stmt["value"], list_state) }
    if t == "Var" || t == "Assign" {
        return _opt_mark_list_state_unsafe_in_expr(stmt["value"], list_state)
    }
    if t == "Set" {
        _opt_mark_list_state_unsafe_in_expr(stmt["left"], list_state)
        _opt_mark_list_state_unsafe_in_expr(stmt["value"], list_state)
