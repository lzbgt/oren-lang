fn _opt_scan_list_int_uses_stmt(stmt, list_state, safe_ints) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "ExprStmt" { return _opt_scan_list_int_uses_expr(stmt["expr"], list_state, safe_ints) }
    if t == "Return" { return _opt_scan_list_int_uses_expr(stmt["value"], list_state, safe_ints) }
    if t == "Var" || t == "Assign" {
        return _opt_scan_list_int_uses_expr(stmt["value"], list_state, safe_ints)
    }
    if t == "Set" {
        var left = stmt["left"]
        if left != nil && left["type"] == "Index" {
            var list_name = opthelp.is_ident(left["left"])
            if list_name != nil && _opt_list_state_is_candidate(list_state, list_name) {
                if _opt_is_safe_int_expr(left["index"], safe_ints) != true {
                    _opt_list_state_mark_unsafe_reason(list_state, list_name, "set_index")
                }
                if _opt_is_safe_int_expr(stmt["value"], safe_ints) != true {
                    _opt_list_state_mark_unsafe_reason(list_state, list_name, "set_value")
                }
                _opt_scan_list_int_uses_expr(stmt["value"], list_state, safe_ints)
                return nil
            }
        }
        _opt_scan_list_int_uses_expr(stmt["left"], list_state, safe_ints)
        _opt_scan_list_int_uses_expr(stmt["value"], list_state, safe_ints)
        return nil
    }
    if t == "If" {
        _opt_scan_list_int_uses_expr(stmt["cond"], list_state, safe_ints)
        _opt_scan_list_int_uses_stmt(stmt["consq"], list_state, _opt_map_clone_safe(safe_ints))
        if stmt["alt"] != nil { _opt_scan_list_int_uses_stmt(stmt["alt"], list_state, _opt_map_clone_safe(safe_ints)) }
        return nil
    }
    if t == "While" {
        _opt_scan_list_int_uses_expr(stmt["cond"], list_state, safe_ints)
        var safe_body = _opt_safe_ints_with_loop_idx(safe_ints, stmt["cond"])
        _opt_scan_list_int_uses_stmt(stmt["body"], list_state, safe_body)
        _opt_safe_ints_invalidate_in_stmt(stmt["body"], safe_ints)
        return nil
    }
    if t == "For" {
        if stmt["init"] != nil { _opt_scan_list_int_uses_stmt(stmt["init"], list_state, safe_ints) }
        if stmt["cond"] != nil { _opt_scan_list_int_uses_expr(stmt["cond"], list_state, safe_ints) }
        if stmt["post"] != nil { _opt_scan_list_int_uses_stmt(stmt["post"], list_state, safe_ints) }
        if stmt["body"] != nil {
            var safe_body = _opt_safe_ints_with_loop_idx(safe_ints, stmt["cond"])
            _opt_scan_list_int_uses_stmt(stmt["body"], list_state, safe_body)
        }
        if stmt["init"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["init"], safe_ints) }
        if stmt["post"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["post"], safe_ints) }
        if stmt["body"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["body"], safe_ints) }
        return nil
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var snap_ints = _opt_map_clone_safe(safe_ints)
            var trace_list_int = _opt_trace_list_int_enabled()
            var i = 0
            var ss_len = oren_list_len(ss)
            while i < ss_len {
                var st0 = ss[i]
                if trace_list_int == true && st0 != nil && st0["type"] == "ExprStmt" {
                    var en = st0["expr"]
                    var cn = _opt_call_name(en)
                    if cn == "oren_list_push" || cn == "STD_list_push" || cn == "oren_list_int_push" || cn == "STD_list_int_push" {
                        if i > 0 {
                            var prev = ss[i - 1]
                            if prev != nil {
                                var ptype = prev["type"]
                                var pname = opthelp.is_ident(prev["name"])
                                if pname == nil { pname = "" }
                                var pextra = ""
                                if ptype == "ExprStmt" {
                                    var pexpr = prev["expr"]
                                    if pexpr != nil {
                                        pextra = pexpr["type"]
                                        if pextra == "Call" {
                                            var pcall = _opt_call_name(pexpr)
                                            if pcall != nil { pextra = "Call:" + pcall }
                                        }
                                    }
                                }
                                _opt_trace_list_int("[opt] list_int uses_prev_stmt type=" + ptype + " name=" + pname + " extra=" + pextra)
                            }
                        }
                        var wstart = i - 2
                        if wstart < 0 { wstart = 0 }
                        var wend = i + 2
                        if wend >= ss_len { wend = ss_len - 1 }
                        var w = ""
                        var wi = wstart
                        while wi <= wend {
                            var stw = ss[wi]
                            var wtype = ""
                            var wname = ""
                            if stw != nil {
                                wtype = stw["type"]
                                wname = opthelp.is_ident(stw["name"])
                                if wname == nil { wname = "" }
                                if wtype == "ExprStmt" {
                                    var ew = stw["expr"]
                                    if ew != nil {
                                        var et = ew["type"]
                                        if et == "Call" {
                                            var ewcall = _opt_call_name(ew)
                                            if ewcall != nil { wtype = "ExprStmt(Call:" + ewcall + ")" }
                                        } else {
                                            wtype = "ExprStmt(" + et + ")"
                                        }
                                    }
                                }
                            }
                            if w != "" { w = w + " | " }
                            w = w + oren_int_to_string(wi) + ":" + wtype
                            if wname != "" { w = w + "(" + wname + ")" }
                            wi = wi + 1
                        }
                        _opt_trace_list_int("[opt] list_int uses_window " + w)
                        var keys = ""
                        for k in snap_ints {
                            if snap_ints[k] == true {
                                if keys != "" { keys = keys + "," }
                                keys = keys + k
                            }
                        }
                        _opt_trace_list_int("[opt] list_int uses_pre_call name=" + cn + " keys=" + keys)
                    }
                }
                var scan_ints = snap_ints
                if _opt_scan_list_int_uses_stmt_mutates_safe_ints(ss[i]) {
                    scan_ints = _opt_map_clone_safe(snap_ints)
                }
                _opt_scan_list_int_uses_stmt(ss[i], list_state, scan_ints)
                if opthelp.stmt_may_assign_name(ss[i]) {
                    snap_ints = _opt_safe_ints_after_stmt(ss[i], snap_ints, "uses")
                }
                if trace_list_int == true && i + 1 < ss_len {
                    var nxt = ss[i + 1]
                    var log_next = false
                    if nxt != nil && nxt["type"] == "ExprStmt" {
                        var nexpr = nxt["expr"]
                        var ncall = _opt_call_name(nexpr)
                        if ncall == "oren_list_push" || ncall == "STD_list_push" || ncall == "oren_list_int_push" || ncall == "STD_list_int_push" {
                            log_next = true
                        } else if nexpr != nil && nexpr["type"] == "If" && i + 2 < ss_len {
                            var nxt2 = ss[i + 2]
                            if nxt2 != nil && nxt2["type"] == "ExprStmt" {
                                var n2call = _opt_call_name(nxt2["expr"])
                                if n2call == "oren_list_push" || n2call == "STD_list_push" || n2call == "oren_list_int_push" || n2call == "STD_list_int_push" {
                                    log_next = true
                                }
                            }
                        }
                    }
                    if log_next {
                        var keys_after = ""
                        for k3 in snap_ints {
                            if snap_ints[k3] == true {
                                if keys_after != "" { keys_after = keys_after + "," }
                                keys_after = keys_after + k3
                            }
                        }
                        _opt_trace_list_int("[opt] list_int uses_keys_after_stmt idx=" + oren_int_to_string(i) + " keys=" + keys_after)
                    }
                }
                i = i + 1
            }
        }
        return nil
    }
    if t == "Switch" {
        _opt_scan_list_int_uses_expr(stmt["cond"], list_state, safe_ints)
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            var cases_len = oren_list_len(cases)
            while ci < cases_len {
                var c = cases[ci]
                if c != nil && c["body"] != nil {
                    _opt_scan_list_int_uses_stmt(c["body"], list_state, _opt_map_clone_safe(safe_ints))
                }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil { _opt_scan_list_int_uses_stmt(stmt["default"], list_state, _opt_map_clone_safe(safe_ints)) }
        return nil
    }
    if t == "Function" { return nil }
    return nil
}


