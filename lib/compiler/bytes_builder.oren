// Shared growable byte builder for compiler backends.
//
// Rationale:
// - Using `list<int>` for bytes is extremely memory-expensive in the native backend
//   (each byte becomes a boxed value).
// - `u8_buf` is compact but fixed-length; we wrap it in a small builder map:
//     {"buf": u8_buf(cap), "len": used_bytes+1, "cap": capacity_bytes}
//
// Store length as `len+1` (native backend self-hosting):
// - In the native backend, small integers are untagged immediates; `0` is a valid int payload.
// - Many low-level/native helper paths also use raw `0` as a null-pointer / "missing" sentinel.
//   Keeping `len` non-zero avoids accidental conflation when plumbing this value through pointer-ish code.
// - `1` means logical length 0.

fn bytes_new() {
    var cap = 256
    var buf = oren_u8_buf_new(cap)
    if oren_is_err(buf) { oren_fail(1, "bytes_new: u8_buf alloc failed") }
    return {"buf": buf, "len": 1, "cap": cap}
}

fn bytes_new_cap(cap) {
    if cap < 1 { cap = 1 }
    var buf = oren_u8_buf_new(cap)
    if oren_is_err(buf) { oren_fail(1, "bytes_new_cap: u8_buf alloc failed") }
    return {"buf": buf, "len": 1, "cap": cap}
}

fn _bytes_len_raw(b) {
    // `len` is stored as (logical_len + 1), so valid values are always >= 1.
    // Treat 0 (which can come from missing keys / nil-ish values) as "empty".
    var enc = 0
    if b != nil { enc = b["len"] }
    if enc <= 0 { return 0 }
    return enc - 1
}

fn _bytes_set_len_raw(b, n) {
    if b == nil { return nil }
    b["len"] = n + 1
    return nil
}

fn bytes_len(b) { return _bytes_len_raw(b) }

fn _memcpy8(dst, src, len) {
    // Copy `len` bytes from src to dst.
    //
    // PERF (native self-hosted compiler):
    // Avoid per-byte `oren_buf_load_u8` / `oren_buf_store_u8` calls (function-call overhead).
    // Use raw pointer loads/stores in 8-byte chunks where possible.
    var i = 0
    while i < len {
        if len - i >= 8 {
            ptr_set(iadd(dst, i), ptr_get(iadd(src, i)))
            i = i + 8
        } else {
            ptr_set_byte(iadd(dst, i), ptr_get_byte(iadd(src, i)))
            i = i + 1
        }
    }
    return nil
}

fn _bytes_ensure_capacity(b, want) {
    // Ensure capacity >= want.
    if want <= b["cap"] { return nil }
    var new_cap = b["cap"]
    if new_cap < 16 { new_cap = 16 }
    while new_cap < want { new_cap = new_cap * 2 }
    var nb = oren_u8_buf_new(new_cap)
    if oren_is_err(nb) { oren_fail(1, "bytes_grow: u8_buf alloc failed") }
    var used = _bytes_len_raw(b)
    if used > 0 {
        var srcp = oren_buf_data_ptr_unchecked(b["buf"])
        var dstp = oren_buf_data_ptr_unchecked(nb)
        if srcp == 0 || dstp == 0 { oren_fail(1, "bytes_grow: buf data ptr is nil") }
        _memcpy8(dstp, srcp, used)
    }
    b["buf"] = nb
    b["cap"] = new_cap
    return nil
}

fn bytes_push(b, v) {
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + 1)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_push: buf data ptr is nil") }
    ptr_set_byte(iadd(dstp, used), v & 255)
    _bytes_set_len_raw(b, used + 1)
    return nil
}

fn bytes_extend(b, other) {
    var other_enc = 0
    if other != nil { other_enc = other["len"] }
    if other_enc <= 0 { oren_fail(1, "bytes_extend: expected bytes builder") }
    var n = other_enc - 1
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + n)
    if n > 0 {
        var srcp = oren_buf_data_ptr_unchecked(other["buf"])
        var dstp = oren_buf_data_ptr_unchecked(b["buf"])
        if srcp == 0 || dstp == 0 { oren_fail(1, "bytes_extend: buf data ptr is nil") }
        _memcpy8(iadd(dstp, used), srcp, n)
    }
    _bytes_set_len_raw(b, used + n)
    return nil
}

fn bytes_extend_zeros(b, n) {
    // Extend the builder by `n` zero bytes without per-byte bounds/type checks.
    if n <= 0 { return nil }
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + n)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_extend_zeros: buf data ptr is nil") }
    var i = 0
    while i < n {
        if n - i >= 8 {
            ptr_set(iadd(dstp, used + i), 0)
            i = i + 8
        } else {
            ptr_set_byte(iadd(dstp, used + i), 0)
            i = i + 1
        }
    }
    _bytes_set_len_raw(b, used + n)
    return nil
}

fn bytes_extend_list(b, xs) {
    // Extend from a legacy `list<int 0..255>` byte carrier.
    var n = oren_list_len(xs)
    if n <= 0 { return nil }
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + n)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_extend_list: buf data ptr is nil") }
    var i = 0
    while i < n {
        ptr_set_byte(iadd(dstp, used + i), xs[i] & 255)
        i = i + 1
    }
    _bytes_set_len_raw(b, used + n)
    return nil
}

fn bytes_extend_u8_buf(b, ubuf) {
    // Extend a bytes builder from a `u8_buf` (typed byte buffer).
    //
    // Used by cache layers that store large blobs (code/data) as typed buffers and then
    // splice them into a bigger output.
    if ubuf == nil { return nil }
    if oren_is_u8_buf(ubuf) != true { oren_fail(1, "bytes_extend_u8_buf: expected u8_buf") }
    var n = oren_buf_len(ubuf)
    if n <= 0 { return nil }
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + n)
    var srcp = oren_buf_data_ptr_unchecked(ubuf)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if srcp == 0 || dstp == 0 { oren_fail(1, "bytes_extend_u8_buf: buf data ptr is nil") }
    _memcpy8(iadd(dstp, used), srcp, n)
    _bytes_set_len_raw(b, used + n)
    return nil
}

fn bytes_carrier_len(bs) {
    if bs == nil || bs == 0 { return 0 }
    var n = oren_bytes_len(bs)
    if !oren_is_err(n) { return n }
    return oren_list_len(bs)
}

fn bytes_extend_carrier(b, bs) {
    // Extend from any validated compiler byte carrier: u8_buf fast path, with
    // byte-list/LIST_INT fallback through the runtime byte API.
    var n = bytes_carrier_len(bs)
    if n <= 0 { return nil }
    if oren_is_u8_buf(bs) == true { return bytes_extend_u8_buf(b, bs) }
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + n)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_extend_carrier: buf data ptr is nil") }
    var i = 0
    while i < n {
        ptr_set_byte(iadd(dstp, used + i), oren_bytes_get_u8(bs, i) & 255)
        i = i + 1
    }
    _bytes_set_len_raw(b, used + n)
    return nil
}

fn bytes_extend_string(b, s) {
    // Extend a bytes builder from a string without materializing an intermediate list<int>.
    //
    // PERF (native self-hosted compiler):
    // - `oren_bytes_from_string(...)` is byte-native, but still allocates an intermediate buffer
    //   when the caller only wants to append into an existing builder.
    // - Grow once, then store directly into the backing u8 buffer; do not treat the Oren string
    //   value as a raw pointer because native codegen keeps strings as tagged/runtime values.
    if s == nil { return nil }
    var n = oren_string_len(s)
    if n <= 0 { return nil }
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + n)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_extend_string: buf data ptr is nil") }
    var i = 0
    while i < n {
        ptr_set_byte(iadd(dstp, used + i), oren_string_byte_at_unchecked(s, i) & 255)
        i = i + 1
    }
    _bytes_set_len_raw(b, used + n)
    return nil
}

fn bytes_set_u8(b, idx, v) {
    var used = _bytes_len_raw(b)
    if idx < 0 || idx >= used { oren_fail(1, "bytes_set_u8: index out of bounds") }
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_set_u8: buf data ptr is nil") }
    ptr_set_byte(iadd(dstp, idx), v & 255)
    return nil
}

fn _int_mod_pos(a, b) {
    // Positive modulus (result in [0, b) for b>0).
    var r = a - (a / b) * b
    if r < 0 { r = r + b }
    return r
}

fn _bytes_set_u32_le_ptr(dstp, off, n) {
    // Write little-endian u32 at dstp+off (no bounds checks).
    var u = n & 4294967295
    ptr_set_byte(iadd(dstp, off + 0), u & 255)
    ptr_set_byte(iadd(dstp, off + 1), (u / 256) & 255)
    ptr_set_byte(iadd(dstp, off + 2), (u / 65536) & 255)
    ptr_set_byte(iadd(dstp, off + 3), (u / 16777216) & 255)
    return nil
}

fn bytes_push_u16_le(b, n) {
    // Append little-endian u16.
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + 2)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_push_u16_le: buf data ptr is nil") }
    var u = n & 65535
    ptr_set_byte(iadd(dstp, used + 0), u & 255)
    ptr_set_byte(iadd(dstp, used + 1), (u / 256) & 255)
    _bytes_set_len_raw(b, used + 2)
    return nil
}

fn bytes_push_u32_le(b, n) {
    // Append little-endian u32.
    //
    // PERF: one capacity check + raw byte stores (used heavily by native backends).
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + 4)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_push_u32_le: buf data ptr is nil") }
    _bytes_set_u32_le_ptr(dstp, used, n)
    _bytes_set_len_raw(b, used + 4)
    return nil
}

fn bytes_push_u64_le(b, n) {
    // Append little-endian u64.
    //
    // Encode low 64 bits deterministically for signed carrier ints.
    var used = _bytes_len_raw(b)
    _bytes_ensure_capacity(b, used + 8)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_push_u64_le: buf data ptr is nil") }
    var lo = _int_mod_pos(n, 4294967296)
    var hi = _int_mod_pos((n - lo) / 4294967296, 4294967296)
    _bytes_set_u32_le_ptr(dstp, used + 0, lo)
    _bytes_set_u32_le_ptr(dstp, used + 4, hi)
    _bytes_set_len_raw(b, used + 8)
    return nil
}

fn bytes_set_u32_le(b, offset, n) {
    // Patch a u32 into an existing bytes builder (little-endian).
    //
    // PERF: used heavily in x64 PE/ELF fixup application. Do one bounds check and then
    // write bytes via raw pointer stores.
    var used = _bytes_len_raw(b)
    if offset < 0 || offset + 3 >= used { oren_fail(1, "bytes_set_u32_le: index out of bounds") }
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_set_u32_le: buf data ptr is nil") }
    _bytes_set_u32_le_ptr(dstp, offset, n)
    return nil
}

fn bytes_set_u16_le(b, offset, n) {
    // Patch a u16 into an existing bytes builder (little-endian).
    var used = _bytes_len_raw(b)
    if offset < 0 || offset + 1 >= used { oren_fail(1, "bytes_set_u16_le: index out of bounds") }
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_set_u16_le: buf data ptr is nil") }
    ptr_set_byte(iadd(dstp, offset + 0), _int_mod_pos(n, 256))
    ptr_set_byte(iadd(dstp, offset + 1), _int_mod_pos(n / 256, 256))
    return nil
}

fn bytes_set_u64_le(b, offset, n) {
    // Patch a u64 into an existing bytes builder (little-endian).
    //
    // Encode low 64 bits deterministically for signed carrier ints.
    var used = _bytes_len_raw(b)
    if offset < 0 || offset + 7 >= used { oren_fail(1, "bytes_set_u64_le: index out of bounds") }
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "bytes_set_u64_le: buf data ptr is nil") }
    var lo = _int_mod_pos(n, 4294967296)
    var hi = _int_mod_pos((n - lo) / 4294967296, 4294967296)
    _bytes_set_u32_le_ptr(dstp, offset, lo)
    _bytes_set_u32_le_ptr(dstp, offset + 4, hi)
    return nil
}

fn bytes_finalize(b) {
    // Materialize a tight `u8_buf` (len==used) for IO/hashing.
    var n = _bytes_len_raw(b)
    var out = oren_u8_buf_new(n)
    if oren_is_err(out) { oren_fail(1, "bytes_finalize: u8_buf alloc failed") }
    if n > 0 {
        var srcp = oren_buf_data_ptr_unchecked(b["buf"])
        var dstp = oren_buf_data_ptr_unchecked(out)
        if srcp == 0 || dstp == 0 { oren_fail(1, "bytes_finalize: buf data ptr is nil") }
        _memcpy8(dstp, srcp, n)
    }
    return out
}
