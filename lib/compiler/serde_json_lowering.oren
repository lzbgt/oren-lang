import ast "ast.oren"

// Attribute-driven serde lowering (rolling): JSON + YAML + CBOR v1.
//
// Goal:
// - Use struct field type annotations + `@serde.*` attributes to generate
//   deterministic helper functions:
//     - <Type>__json_encode(x) -> JsonValue
//     - <Type>__json_decode(jv) -> {"ok":0|1,"err":string,"v":<Type>}
//     - <Type>__yaml_encode(x) -> YamlValue (same tagged representation as JsonValue)
//     - <Type>__yaml_decode(yv) -> {"ok":0|1,"err":string,"v":<Type>}
//     - <Type>__cbor_encode(x) -> CborValue
//     - <Type>__cbor_decode(cv) -> {"ok":0|1,"err":string,"v":<Type>}
//
// Constraints:
// - No runtime reflection.
// - No host effects.
// - Deterministic across backends (C/native/bytecode).
//
// JsonValue is the portable tagged representation defined in `lib/std/json.oren`.
// YamlValue (std/yaml) uses the same representation.
//   {"t":"null"}
//   {"t":"bool","b":0|1}
//   {"t":"int","i":<int>}
//   {"t":"string","s":<string>}
//   {"t":"array","a":[JsonValue...]}
//   {"t":"object","o":{ string_key: JsonValue, ... }}

fn serde_json_error(errs, msg) {
    if errs == nil { return nil }
    oren_list_push(errs, msg)
    return nil
}

fn serde_str_eq(a, b) {
    if oren_is_string(a) && oren_is_string(b) { return oren_string_eq(a, b) }
    return a == b
}

fn has_attr(node, name) {
    if node == nil { return false }
    var attrs = node["attrs"]
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        if attrs[i] != nil && serde_str_eq(attrs[i]["name"], name) { return true }
        i = i + 1
    }
    return false
}

fn get_attr(node, name) {
    if node == nil { return nil }
    var attrs = node["attrs"]
    if attrs == nil { return nil }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && serde_str_eq(a["name"], name) { return a }
        i = i + 1
    }
    return nil
}

fn attr_arg0(attr) {
    if attr == nil { return nil }
    var args = attr["args"]
    if args == nil || oren_list_len(args) < 1 { return nil }
    var a0 = args[0]
    if a0 == nil { return nil }
    return a0["value"]
}

fn attr_arg0_string(attr) {
    var v = attr_arg0(attr)
    if v == nil { return nil }
    if v["type"] != "String" { return nil }
    return v["value"]
}

fn attr_kw_value(attr, key) {
    // Returns the literal value node for a keyword argument `key=...`, or nil.
    if attr == nil { return nil }
    var args = attr["args"]
    if args == nil { return nil }
    var i = 0
    while i < oren_list_len(args) {
        var a = args[i]
        if a != nil && serde_str_eq(a["key"], key) {
            return a["value"]
        }
        i = i + 1
    }
    return nil
}

fn attr_kw_string(attr, key) {
    var v = attr_kw_value(attr, key)
    if v == nil { return nil }
    if v["type"] != "String" { return nil }
    return v["value"]
}

fn attr_kw_bool(attr, key) {
    var v = attr_kw_value(attr, key)
    if v == nil { return nil }
    if v["type"] == "Boolean" { return v["value"] }
    // Accept 0/1 ints for convenience (still literal-only).
    if v["type"] == "Integer" {
        if serde_str_eq(v["value"], "0") { return false }
        if serde_str_eq(v["value"], "1") { return true }
    }
    return nil
}

fn str_lit(s) { return {"type": "String", "token": nil, "value": s} }
fn int_lit(s) { return {"type": "Integer", "token": nil, "value": s} }
fn ident(name) { return {"type": "Identifier", "token": nil, "value": name} }

fn member(obj, name) {
    return ast.new_member(nil, obj, {"type": "Identifier", "token": nil, "value": name})
}

fn index(left, key) {
    return ast.new_index(nil, left, str_lit(key))
}

fn call0(name, args) { return ast.new_call(nil, ident(name), args) }

fn json_null() {
    return ast.new_hash(nil, [
        {"key": str_lit("t"), "value": str_lit("null")}
    ])
}

fn json_int(expr) {
    return ast.new_hash(nil, [
        {"key": str_lit("t"), "value": str_lit("int")},
        {"key": str_lit("i"), "value": expr}
    ])
}

fn json_string(expr) {
    return ast.new_hash(nil, [
        {"key": str_lit("t"), "value": str_lit("string")},
        {"key": str_lit("s"), "value": expr}
    ])
}

fn json_bool_int(expr_int01) {
    return ast.new_hash(nil, [
        {"key": str_lit("t"), "value": str_lit("bool")},
        {"key": str_lit("b"), "value": expr_int01}
    ])
}

fn json_object(obj_map_expr) {
    return ast.new_hash(nil, [
        {"key": str_lit("t"), "value": str_lit("object")},
        {"key": str_lit("o"), "value": obj_map_expr}
    ])
}

// CBOR tagged value constructors (compatible with `lib/std/cbor.oren`).
fn cbor_int(expr) {
    return ast.new_hash(nil, [
        {"key": str_lit("t"), "value": str_lit("int")},
        {"key": str_lit("i"), "value": expr}
    ])
}

fn cbor_string(expr) {
    return ast.new_hash(nil, [
        {"key": str_lit("t"), "value": str_lit("string")},
        {"key": str_lit("s"), "value": expr}
    ])
}

fn cbor_bool_int(expr_int01) {
    return ast.new_hash(nil, [
        {"key": str_lit("t"), "value": str_lit("bool")},
        {"key": str_lit("b"), "value": expr_int01}
    ])
}

fn cbor_map(map_expr) {
    return ast.new_hash(nil, [
        {"key": str_lit("t"), "value": str_lit("map")},
        {"key": str_lit("m"), "value": map_expr}
    ])
}

fn normalize_kind(kind) {
    if kind == nil { return nil }
    // Strip optional `oren.` prefix for internal uniformity.
    if oren_string_len(kind) > 5 && serde_str_eq(oren_string_slice(kind, 0, 5), "oren.") {
        kind = oren_string_slice(kind, 5, oren_string_len(kind))
    }
    // Endian tags behave as the same width for value semantics.
    if serde_str_eq(kind, "u16be") || serde_str_eq(kind, "u16le") { return "u16" }
    if serde_str_eq(kind, "i16be") || serde_str_eq(kind, "i16le") { return "i16" }
    if serde_str_eq(kind, "u32be") || serde_str_eq(kind, "u32le") { return "u32" }
    if serde_str_eq(kind, "i32be") || serde_str_eq(kind, "i32le") { return "i32" }
    if serde_str_eq(kind, "u64be") || serde_str_eq(kind, "u64le") { return "u64" }
    if serde_str_eq(kind, "i64be") || serde_str_eq(kind, "i64le") { return "i64" }
    return kind
}

fn serde_kind_for_ann(ann) {
    // Rolling v0 serde kinds: int/string/bool only.
    // (float support needs a stable JSON float story; add later.)
    if ann == nil { return nil }
    var k = normalize_kind(ann)
    if serde_str_eq(k, "string") { return "string" }
    if serde_str_eq(k, "bool") { return "bool" }
    if serde_str_eq(k, "u8") || serde_str_eq(k, "i8") || serde_str_eq(k, "u16") || serde_str_eq(k, "i16") || serde_str_eq(k, "u32") || serde_str_eq(k, "i32") || serde_str_eq(k, "u64") || serde_str_eq(k, "i64") {
        return "int"
    }
    return nil
}

fn field_wire_name(fid) {
    var a = get_attr(fid, "serde.rename")
    if a != nil {
        var s = attr_arg0_string(a)
        if s != nil { return s }
    }
    // Compact form: `@json(rename="wire")` canonicalizes to attr name `serde`.
    var b = get_attr(fid, "serde")
    if b != nil {
        var s2 = attr_kw_string(b, "rename")
        if s2 != nil { return s2 }
    }
    return fid["value"]
}

fn field_default_literal(fid) {
    // Literal-only in v0.
    var a = get_attr(fid, "serde.default")
    if a == nil { return nil }
    return attr_arg0(a)
}

fn field_default_literal_any(fid) {
    // Prefer explicit attribute form.
    var a = get_attr(fid, "serde.default")
    if a != nil { return attr_arg0(a) }
    // Compact form: `@serde(default=...)` (also works via `@json(...)` alias).
    var b = get_attr(fid, "serde")
    if b != nil {
        var v = attr_kw_value(b, "default")
        if v != nil { return v }
    }
    return nil
}

fn field_is_skip(fid) {
    if has_attr(fid, "serde.skip") { return true }
    var b = get_attr(fid, "serde")
    if b != nil {
        var sv = attr_kw_bool(b, "skip")
        if sv == true { return true }
    }
    return false
}

fn struct_tag_value(type_stmt) {
    // `@json.tag("X")` / canonical `@serde.tag("X")`
    var a = get_attr(type_stmt, "serde.tag")
    if a == nil { return nil }
    return attr_arg0_string(a)
}

fn struct_tag_value_any(type_stmt) {
    var a = get_attr(type_stmt, "serde.tag")
    if a != nil {
        var s = attr_arg0_string(a)
        if s != nil { return s }
    }
    // Compact form: `@serde(tag="X")` (or `@json(tag="X")` alias).
    var b = get_attr(type_stmt, "serde")
    if b != nil {
        var s2 = attr_kw_string(b, "tag")
        if s2 != nil { return s2 }
    }
    return nil
}

fn struct_derive_value_any(type_stmt) {
    // Returns a string (format) or nil if no derive requested.
    var a = get_attr(type_stmt, "serde.derive")
    if a != nil {
        var s = attr_arg0_string(a)
        if s != nil { return s }
        // `@serde.derive()` defaults to json.
        return "json"
    }

    // Compact form: `@serde(format="json")` (preferred) or `@serde("json")` (positional).
    // This is explicit enough to opt-in codegen and removes the redundant `derive="json"`.
    var b = get_attr(type_stmt, "serde")
    if b != nil {
        var fmt = attr_kw_string(b, "format")
        if fmt != nil { return fmt }
        var p0 = attr_arg0_string(b)
        if p0 != nil { return p0 }

        // Back-compat: `@serde(derive="json")` or `@serde(derive=true)`.
        var s2 = attr_kw_string(b, "derive")
        if s2 != nil { return s2 }
        var bv = attr_kw_bool(b, "derive")
        if bv == true { return "json" }
    }
    return nil
}

fn _serde_split_formats(s) {
    // Split a formats string like:
    //   "json,yaml,cbor"
    //   "json yaml"
    //   " json, yaml ,cbor "
    // into a list of non-empty tokens.
    //
    // Keep it deterministic and avoid relying on stdlib helpers from the compiler.
    var out = []
    if s == nil { return out }
    var cur = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        var is_sep = serde_str_eq(ch, ",") || serde_str_eq(ch, " ") || serde_str_eq(ch, "\t") || serde_str_eq(ch, "\n") || serde_str_eq(ch, "\r")
        if is_sep {
            if serde_str_eq(cur, "") != true { oren_list_push(out, cur) }
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    if serde_str_eq(cur, "") != true { oren_list_push(out, cur) }
    return out
}

fn _serde_list_contains(xs, v) {
    if xs == nil { return false }
    var i = 0
    while i < oren_list_len(xs) {
        if serde_str_eq(xs[i], v) { return true }
        i = i + 1
    }
    return false
}

fn _serde_list_push_unique(xs, v) {
    if xs == nil { return nil }
    if v == nil || serde_str_eq(v, "") { return nil }
    if _serde_list_contains(xs, v) { return nil }
    oren_list_push(xs, v)
    return nil
}

fn struct_derive_formats_any(type_stmt) {
    // Returns a list of formats ("json"|"yaml"|"cbor") or nil if no derive requested.
    //
    // New (rolling): multi-format opt-in.
    //   @serde(formats="json,yaml,cbor")
    //
    // Existing single-format opt-ins remain supported:
    //   @serde(format="json")
    //   @serde("json")
    //   @serde.derive("json") / @serde.derive()
    //   @serde(derive="json") / @serde(derive=true)
    var b = get_attr(type_stmt, "serde")
    if b != nil {
        var fmts = attr_kw_string(b, "formats")
        if fmts != nil {
            var parts = _serde_split_formats(fmts)
            if parts != nil && oren_list_len(parts) > 0 { return parts }
            return nil
        }
    }

    var one = struct_derive_value_any(type_stmt)
    if one == nil { return nil }
    return [one]
}

fn ensure_bool_to_int_helper(stmts, prefix) {
    // Insert once per program. The helper is pure and deterministic.
    //
    // __oren_serde_bool_to_int(x):
    //   if x == true { return 1 }
    //   if x == 1 { return 1 }
    //   return 0
    //
    // Serde bool fields should already be bool-like. Keep the carrier normalization
    // explicit so a native runtime false singleton is never treated as a nonzero int.
    if prefix == nil { prefix = "" }
    var fn_name = prefix + "__oren_serde_bool_to_int"

    var i = 0
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        if s != nil && s["type"] == "Function" && serde_str_eq(s["name"], fn_name) {
            return nil
        }
        if s != nil && s["type"] == "ExprStmt" && s["expr"] != nil && s["expr"]["type"] == "Function" && serde_str_eq(s["expr"]["name"], fn_name) {
            return nil
        }
        i = i + 1
    }

    var body = ast.new_block(nil)
    var if_true = ast.new_if(
        nil,
        ast.new_infix(nil, ident("x"), "==", {"type": "Boolean", "token": nil, "value": true}),
        ast.new_block(nil),
        ast.new_block(nil)
    )
    if_true["consq"]["stmts"] = [ast.new_return(nil, int_lit("1"))]
    if_true["alt"]["stmts"] = []
    var if_one = ast.new_if(
        nil,
        ast.new_infix(nil, ident("x"), "==", int_lit("1")),
        ast.new_block(nil),
        ast.new_block(nil)
    )
    if_one["consq"]["stmts"] = [ast.new_return(nil, int_lit("1"))]
    if_one["alt"]["stmts"] = []
    body["stmts"] = [
        // If is an expression node; wrap it as a statement for C backend transpilation.
        ast.new_expr_stmt(nil, if_true),
        ast.new_expr_stmt(nil, if_one),
        ast.new_return(nil, int_lit("0"))
    ]

    var fnn = {"type": "Function", "token": nil, "name": fn_name, "params": [ident("x")], "body": body}
    // Keep top-level named functions as ExprStmt(Function) for C backend compatibility.
    oren_list_push(stmts, ast.new_expr_stmt(nil, fnn))
    return nil
}

fn make_result_ok(v) {
    return ast.new_hash(nil, [
        {"key": str_lit("ok"), "value": int_lit("1")},
        {"key": str_lit("v"), "value": v}
    ])
}

fn make_result_err(msg) {
    return ast.new_hash(nil, [
        {"key": str_lit("ok"), "value": int_lit("0")},
        {"key": str_lit("err"), "value": str_lit(msg)}
    ])
}

fn lower_one_type_cbor(type_stmt, stmts, prefix, field_info) {
    var tname = type_stmt["name"]["value"]
    var tagv = struct_tag_value_any(type_stmt)

    // Encode: build {"t":"map","m":{...}} tagged value.
    var map_pairs = []
    if tagv != nil {
        oren_list_push(map_pairs, {"key": str_lit("t"), "value": cbor_string(str_lit(tagv))})
    }

    var i = 0
    while i < oren_list_len(field_info) {
        var fi = field_info[i]
        if fi != nil && fi["skip"] != true {
            var wire = fi["wire"]
            var k = fi["kind"]
            var val_expr = member(ident("x"), fi["fname"])
            if k == "int" {
                oren_list_push(map_pairs, {"key": str_lit(wire), "value": cbor_int(val_expr)})
            } else {
                if k == "string" {
                    oren_list_push(map_pairs, {"key": str_lit(wire), "value": cbor_string(val_expr)})
                } else {
                    if k == "bool" {
                        ensure_bool_to_int_helper(stmts, prefix)
                        var helper = prefix + "__oren_serde_bool_to_int"
                        oren_list_push(map_pairs, {"key": str_lit(wire), "value": cbor_bool_int(call0(helper, [val_expr]))})
                    }
                }
            }
        }
        i = i + 1
    }

    var enc_body = ast.new_block(nil)
    enc_body["stmts"] = [
        ast.new_return(nil, cbor_map(ast.new_hash(nil, map_pairs)))
    ]
    var enc_name = tname + "__cbor_encode"
    if prefix != nil && prefix != "" { enc_name = prefix + enc_name }
    var enc_fn = {"type": "Function", "token": nil, "name": enc_name, "params": [ident("x")], "body": enc_body}
    oren_list_push(stmts, ast.new_expr_stmt(nil, enc_fn))

    // Decode: validate CborValue map + extract fields by kind.
    var dec_stmts = []

    var if_cv_nil = ast.new_if(nil, ast.new_infix(nil, ident("cv"), "==", {"type": "Nil", "token": nil}), ast.new_block(nil), ast.new_block(nil))
    if_cv_nil["consq"]["stmts"] = [ast.new_return(nil, make_result_err("expected CborValue (got nil)"))]
    if_cv_nil["alt"]["stmts"] = []
    oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_cv_nil))

    var if_not_map = ast.new_if(nil, ast.new_infix(nil, index(ident("cv"), "t"), "!=", str_lit("map")), ast.new_block(nil), ast.new_block(nil))
    if_not_map["consq"]["stmts"] = [ast.new_return(nil, make_result_err("expected CborValue map"))]
    if_not_map["alt"]["stmts"] = []
    oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_not_map))

    oren_list_push(dec_stmts, ast.new_var(nil, ident("m"), index(ident("cv"), "m")))
    var if_m_nil = ast.new_if(nil, ast.new_infix(nil, ident("m"), "==", {"type": "Nil", "token": nil}), ast.new_block(nil), ast.new_block(nil))
    if_m_nil["consq"]["stmts"] = [ast.new_return(nil, make_result_err("expected CborValue map.m map"))]
    if_m_nil["alt"]["stmts"] = []
    oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_m_nil))

    if tagv != nil {
        oren_list_push(dec_stmts, ast.new_var(nil, ident("tv"), index(ident("m"), "t")))
        var if_tv_nil = ast.new_if(nil, ast.new_infix(nil, ident("tv"), "==", {"type": "Nil", "token": nil}), ast.new_block(nil), ast.new_block(nil))
        if_tv_nil["consq"]["stmts"] = [ast.new_return(nil, make_result_err("missing tag field t"))]
        if_tv_nil["alt"]["stmts"] = []
        oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_tv_nil))
        var if_tv_kind = ast.new_if(nil, ast.new_infix(nil, index(ident("tv"), "t"), "!=", str_lit("string")), ast.new_block(nil), ast.new_block(nil))
        if_tv_kind["consq"]["stmts"] = [ast.new_return(nil, make_result_err("tag field t must be a CBOR string"))]
        if_tv_kind["alt"]["stmts"] = []
        oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_tv_kind))
        var if_tv_mismatch = ast.new_if(nil, ast.new_infix(nil, index(ident("tv"), "s"), "!=", str_lit(tagv)), ast.new_block(nil), ast.new_block(nil))
        if_tv_mismatch["consq"]["stmts"] = [ast.new_return(nil, make_result_err("tag mismatch"))]
        if_tv_mismatch["alt"]["stmts"] = []
        oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_tv_mismatch))
    }

    var ctor_args = []
    i = 0
    while i < oren_list_len(field_info) {
        var fi2 = field_info[i]
        if fi2 != nil {
            var fname2 = fi2["fname"]
            var wire2 = fi2["wire"]
            var kind2 = fi2["kind"]
            var skip2 = fi2["skip"]
            var def2 = fi2["default"]

            oren_list_push(dec_stmts, ast.new_var(nil, ident(fname2), {"type": "Nil", "token": nil}))
            var tmp = "__fv_" + oren_int_to_string(i)
            oren_list_push(dec_stmts, ast.new_var(nil, ident(tmp), index(ident("m"), wire2)))

            var miss_if = ast.new_if(nil, ast.new_infix(nil, ident(tmp), "==", {"type": "Nil", "token": nil}), ast.new_block(nil), ast.new_block(nil))
            var miss_consq = []
            if def2 != nil {
                miss_consq = [ast.new_assign(nil, ident(fname2), def2)]
            } else {
                if skip2 == true {
                    miss_consq = [ast.new_return(nil, make_result_err("missing skipped field default"))]
                } else {
                    miss_consq = [ast.new_return(nil, make_result_err("missing field: " + wire2))]
                }
            }
            miss_if["consq"]["stmts"] = miss_consq

            var pres = []
            // Validate tag type + extract for non-skipped fields.
            if kind2 == "int" {
                var if_k = ast.new_if(nil, ast.new_infix(nil, index(ident(tmp), "t"), "!=", str_lit("int")), ast.new_block(nil), ast.new_block(nil))
                if_k["consq"]["stmts"] = [ast.new_return(nil, make_result_err("field " + wire2 + " must be CBOR int"))]
                if_k["alt"]["stmts"] = []
                pres = [ast.new_expr_stmt(nil, if_k), ast.new_assign(nil, ident(fname2), index(ident(tmp), "i"))]
            } else {
                if kind2 == "string" {
                    var if_s = ast.new_if(nil, ast.new_infix(nil, index(ident(tmp), "t"), "!=", str_lit("string")), ast.new_block(nil), ast.new_block(nil))
                    if_s["consq"]["stmts"] = [ast.new_return(nil, make_result_err("field " + wire2 + " must be CBOR string"))]
                    if_s["alt"]["stmts"] = []
                    pres = [ast.new_expr_stmt(nil, if_s), ast.new_assign(nil, ident(fname2), index(ident(tmp), "s"))]
                } else {
                    if kind2 == "bool" {
                        var if_b = ast.new_if(nil, ast.new_infix(nil, index(ident(tmp), "t"), "!=", str_lit("bool")), ast.new_block(nil), ast.new_block(nil))
                        if_b["consq"]["stmts"] = [ast.new_return(nil, make_result_err("field " + wire2 + " must be CBOR bool"))]
                        if_b["alt"]["stmts"] = []
                        pres = [ast.new_expr_stmt(nil, if_b), ast.new_assign(nil, ident(fname2), ast.new_infix(nil, index(ident(tmp), "b"), "!=", int_lit("0")))]
                    } else {
                        pres = [ast.new_return(nil, make_result_err("unsupported field kind"))]
                    }
                }
            }

            miss_if["alt"]["stmts"] = pres
            oren_list_push(dec_stmts, ast.new_expr_stmt(nil, miss_if))

            oren_list_push(ctor_args, ident(fname2))
        }
        i = i + 1
    }

    var ctor = ast.new_call(nil, ident(tname), ctor_args)
    oren_list_push(dec_stmts, ast.new_return(nil, make_result_ok(ctor)))

    var dec_body = ast.new_block(nil)
    dec_body["stmts"] = dec_stmts
    var dec_name = tname + "__cbor_decode"
    if prefix != nil && prefix != "" { dec_name = prefix + dec_name }
    var dec_fn = {"type": "Function", "token": nil, "name": dec_name, "params": [ident("cv")], "body": dec_body}
    oren_list_push(stmts, ast.new_expr_stmt(nil, dec_fn))
    return nil
}

fn lower_one_type(type_stmt, stmts, prefix, errs) {
    var tname = type_stmt["name"]["value"]
    var fields = type_stmt["fields"]
    if fields == nil { return nil }

    // Normalize prefix to a string for safe concatenation.
    // (Some callers pass nil to mean "no prefix".)
    var pfx = prefix
    if pfx == nil { pfx = "" }

    // Serde lowering is opt-in via an explicit derive attribute.
    //
    // This keeps `@json.*` usable as pure metadata (docs/tooling) without forcing
    // codegen constraints onto every annotated struct.
    //
    // Supported (canonical) opt-in:
    //   @serde(format="json")   // preferred (future multi-format friendly)
    //   @serde("json")          // positional shorthand
    //
    // Back-compat forms (rolling mode):
    //   @serde.derive("json")   // or @json.derive("json")
    //   @serde.derive()         // defaults to json in v0
    //   @serde(derive="json")   // previous compact form
    //
    // Rolling addition:
    //   @serde(formats="json,yaml,cbor")
    // which generates multiple encode/decode pairs for the same type.
    var fmts0 = struct_derive_formats_any(type_stmt)
    if fmts0 == nil { return nil }
    var fmts = []
    var fi0 = 0
    while fi0 < oren_list_len(fmts0) {
        _serde_list_push_unique(fmts, fmts0[fi0])
        fi0 = fi0 + 1
    }
    if fmts == nil || oren_list_len(fmts) == 0 { return nil }

    // Validate formats early (and deterministically) so we don't partially-generate.
    fi0 = 0
    while fi0 < oren_list_len(fmts) {
        var fmt0 = fmts[fi0]
        if serde_str_eq(fmt0, "json") != true && serde_str_eq(fmt0, "yaml") != true && serde_str_eq(fmt0, "cbor") != true {
            serde_json_error(errs, "serde: unknown derive format '" + fmt0 + "' (supported: \"json\"|\"yaml\"|\"cbor\") (struct " + tname + ")")
            return nil
        }
        fi0 = fi0 + 1
    }

    // Validate fields: every non-skipped field must have a supported type annotation.
    var field_info = []
    var i = 0
    while i < oren_list_len(fields) {
        var f2 = fields[i]
        if f2 != nil {
            var fname = f2["value"]
            var ann = f2["ann_type"]
            var skip = field_is_skip(f2)
            var dflt = field_default_literal_any(f2)
            var kind = serde_kind_for_ann(ann)
            if skip && dflt == nil {
                serde_json_error(errs, "serde: skipped field requires @serde.default(...) (struct " + tname + " field " + fname + ")")
            }
            if !skip {
                if ann == nil {
                    serde_json_error(errs, "serde: field requires type annotation (e.g. name: string) (struct " + tname + " field " + fname + ")")
                } else {
                    if kind == nil {
                        serde_json_error(errs, "serde: unsupported field type '" + ann + "' (rolling supports string|bool|int widths) (struct " + tname + " field " + fname + ")")
                    }
                }
            }
            oren_list_push(field_info, {
                "fname": fname,
                "wire": field_wire_name(f2),
                "kind": kind,
                "skip": skip,
                "default": dflt
            })
        }
        i = i + 1
    }

    var tagv = struct_tag_value_any(type_stmt)

    // Emit requested serde formats in one pass.
    var fmt_i = 0
    while fmt_i < oren_list_len(fmts) {
        var fmt = fmts[fmt_i]
        if serde_str_eq(fmt, "cbor") {
            lower_one_type_cbor(type_stmt, stmts, pfx, field_info)
            fmt_i = fmt_i + 1
            continue
        }

        var is_yaml = false
        if serde_str_eq(fmt, "yaml") { is_yaml = true }
        var enc_name = tname + "__json_encode"
        var dec_name = tname + "__json_decode"
        var kind_label = "JsonValue"
        if is_yaml {
            enc_name = tname + "__yaml_encode"
            dec_name = tname + "__yaml_decode"
            kind_label = "YamlValue"
        }
        if serde_str_eq(pfx, "") != true {
            enc_name = pfx + enc_name
            dec_name = pfx + dec_name
        }

        // Encode: build {"t":"object","o":{...}} literal.
        var obj_pairs = []

        if tagv != nil {
            // Use fixed key "t" for now (rolling). (Matches existing fixture usage.)
            oren_list_push(obj_pairs, {"key": str_lit("t"), "value": json_string(str_lit(tagv))})
        }

        i = 0
        while i < oren_list_len(field_info) {
            var fi = field_info[i]
            if fi != nil && fi["skip"] != true {
                var wire = fi["wire"]
                var k = fi["kind"]
                var val_expr = member(ident("x"), fi["fname"])
                if k == "int" {
                    oren_list_push(obj_pairs, {"key": str_lit(wire), "value": json_int(val_expr)})
                } else {
                    if k == "string" {
                        oren_list_push(obj_pairs, {"key": str_lit(wire), "value": json_string(val_expr)})
                    } else {
                        if k == "bool" {
                            ensure_bool_to_int_helper(stmts, pfx)
                            var helper = pfx + "__oren_serde_bool_to_int"
                            oren_list_push(obj_pairs, {"key": str_lit(wire), "value": json_bool_int(call0(helper, [val_expr]))})
                        }
                    }
                }
            }
            i = i + 1
        }

        var enc_body = ast.new_block(nil)
        enc_body["stmts"] = [
            ast.new_return(nil, json_object(ast.new_hash(nil, obj_pairs)))
        ]
        var enc_fn = {"type": "Function", "token": nil, "name": enc_name, "params": [ident("x")], "body": enc_body}

        // Decode: validate object + extract fields by kind.
        var dec_stmts = []

        // if jv == nil { return err }
        var if_jv_nil = ast.new_if(nil, ast.new_infix(nil, ident("jv"), "==", {"type": "Nil", "token": nil}), ast.new_block(nil), ast.new_block(nil))
        if_jv_nil["consq"]["stmts"] = [ast.new_return(nil, make_result_err("expected " + kind_label + " (got nil)"))]
        if_jv_nil["alt"]["stmts"] = []
        oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_jv_nil))

        // if jv["t"] != "object" { return err }
        var if_not_obj = ast.new_if(nil, ast.new_infix(nil, index(ident("jv"), "t"), "!=", str_lit("object")), ast.new_block(nil), ast.new_block(nil))
        if_not_obj["consq"]["stmts"] = [ast.new_return(nil, make_result_err("expected " + kind_label + " object"))]
        if_not_obj["alt"]["stmts"] = []
        oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_not_obj))

        // var o = jv["o"]
        oren_list_push(dec_stmts, ast.new_var(nil, ident("o"), index(ident("jv"), "o")))
        // if o == nil { return err }
        var if_o_nil = ast.new_if(nil, ast.new_infix(nil, ident("o"), "==", {"type": "Nil", "token": nil}), ast.new_block(nil), ast.new_block(nil))
        if_o_nil["consq"]["stmts"] = [ast.new_return(nil, make_result_err("expected " + kind_label + " object.o map"))]
        if_o_nil["alt"]["stmts"] = []
        oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_o_nil))

        // Tag check (if enabled).
        if tagv != nil {
            // var tv = o["t"]
            oren_list_push(dec_stmts, ast.new_var(nil, ident("tv"), index(ident("o"), "t")))
            // if tv == nil { err }
            var if_tv_nil = ast.new_if(nil, ast.new_infix(nil, ident("tv"), "==", {"type": "Nil", "token": nil}), ast.new_block(nil), ast.new_block(nil))
            if_tv_nil["consq"]["stmts"] = [ast.new_return(nil, make_result_err("missing tag field t"))]
            if_tv_nil["alt"]["stmts"] = []
            oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_tv_nil))
            // if tv["t"] != "string" { err }
            var if_tv_kind = ast.new_if(nil, ast.new_infix(nil, index(ident("tv"), "t"), "!=", str_lit("string")), ast.new_block(nil), ast.new_block(nil))
            if_tv_kind["consq"]["stmts"] = [ast.new_return(nil, make_result_err("tag field t must be a string"))]
            if_tv_kind["alt"]["stmts"] = []
            oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_tv_kind))
            // if tv["s"] != <tag> { err }
            var if_tv_mismatch = ast.new_if(nil, ast.new_infix(nil, index(ident("tv"), "s"), "!=", str_lit(tagv)), ast.new_block(nil), ast.new_block(nil))
            if_tv_mismatch["consq"]["stmts"] = [ast.new_return(nil, make_result_err("tag mismatch"))]
            if_tv_mismatch["alt"]["stmts"] = []
            oren_list_push(dec_stmts, ast.new_expr_stmt(nil, if_tv_mismatch))
        }

        // Extract fields in declaration order.
        var ctor_args = []
        i = 0
        while i < oren_list_len(field_info) {
            var fi2 = field_info[i]
            if fi2 != nil {
                var fname2 = fi2["fname"]
                var wire2 = fi2["wire"]
                var kind2 = fi2["kind"]
                var skip2 = fi2["skip"]
                var def2 = fi2["default"]

                // Declare the output local in the function scope so both branches can assign.
                oren_list_push(dec_stmts, ast.new_var(nil, ident(fname2), {"type": "Nil", "token": nil}))

                // var fv_<n> = o["wire"]
                var tmp = "__fv_" + oren_int_to_string(i)
                oren_list_push(dec_stmts, ast.new_var(nil, ident(tmp), index(ident("o"), wire2)))

                // if missing:
                //   if default -> use default
                //   else -> err
                var miss_if = ast.new_if(nil, ast.new_infix(nil, ident(tmp), "==", {"type": "Nil", "token": nil}), ast.new_block(nil), ast.new_block(nil))
                var miss_consq = []
                if def2 != nil {
                    // Use literal default directly.
                    // Note: for bool fields, default should be true/false or 0/1; value semantics are handled by type_ann casts at constructor.
                    miss_consq = [ast.new_assign(nil, ident(fname2), def2)]
                } else {
                    if skip2 == true {
                        // Skip requires default; already validated, but keep safe.
                        miss_consq = [ast.new_return(nil, make_result_err("missing skipped field default"))]
                    } else {
                        miss_consq = [ast.new_return(nil, make_result_err("missing field: " + wire2))]
                    }
                }
                miss_if["consq"]["stmts"] = miss_consq

                // present branch: validate tag and extract
                var pres = []
                if def2 == nil && skip2 == true {
                    // unreachable (validated), but stay safe
                    pres = [ast.new_return(nil, make_result_err("skipped field must not appear without default"))]
                } else {
                    if skip2 == true {
                        // Ignore serialized value and use default.
                        pres = [ast.new_assign(nil, ident(fname2), def2)]
                    } else {
                        // Validate + extract based on kind.
                        if kind2 == "int" {
                            // if fv["t"] != "int" { err }
                            var if_kind_int = ast.new_if(nil, ast.new_infix(nil, index(ident(tmp), "t"), "!=", str_lit("int")), ast.new_block(nil), ast.new_block(nil))
                            if_kind_int["consq"]["stmts"] = [ast.new_return(nil, make_result_err("field " + wire2 + ": expected int"))]
                            if_kind_int["alt"]["stmts"] = []
                            oren_list_push(pres, ast.new_expr_stmt(nil, if_kind_int))
                            // var fname = fv["i"]
                            oren_list_push(pres, ast.new_assign(nil, ident(fname2), index(ident(tmp), "i")))
                        } else {
                            if kind2 == "string" {
                                var if_kind_str = ast.new_if(nil, ast.new_infix(nil, index(ident(tmp), "t"), "!=", str_lit("string")), ast.new_block(nil), ast.new_block(nil))
                                if_kind_str["consq"]["stmts"] = [ast.new_return(nil, make_result_err("field " + wire2 + ": expected string"))]
                                if_kind_str["alt"]["stmts"] = []
                                oren_list_push(pres, ast.new_expr_stmt(nil, if_kind_str))
                                oren_list_push(pres, ast.new_assign(nil, ident(fname2), index(ident(tmp), "s")))
                            } else {
                                if kind2 == "bool" {
                                    var if_kind_bool = ast.new_if(nil, ast.new_infix(nil, index(ident(tmp), "t"), "!=", str_lit("bool")), ast.new_block(nil), ast.new_block(nil))
                                    if_kind_bool["consq"]["stmts"] = [ast.new_return(nil, make_result_err("field " + wire2 + ": expected bool"))]
                                    if_kind_bool["alt"]["stmts"] = []
                                    oren_list_push(pres, ast.new_expr_stmt(nil, if_kind_bool))
                                    oren_list_push(pres, ast.new_assign(nil, ident(fname2), index(ident(tmp), "b")))
                                } else {
                                    // Should have been validated.
                                    oren_list_push(pres, ast.new_return(nil, make_result_err("unsupported kind")))
                                }
                            }
                        }
                    }
                }
                miss_if["alt"]["stmts"] = pres
                oren_list_push(dec_stmts, ast.new_expr_stmt(nil, miss_if))

                // ctor arg: local variable `fname2`
                oren_list_push(ctor_args, ident(fname2))
            }
            i = i + 1
        }

        // Construct and return ok.
        var ctor_call = ast.new_call(nil, ident(tname), ctor_args)
        oren_list_push(dec_stmts, ast.new_return(nil, make_result_ok(ctor_call)))

        var dec_body = ast.new_block(nil)
        dec_body["stmts"] = dec_stmts
        var dec_fn = {"type": "Function", "token": nil, "name": dec_name, "params": [ident("jv")], "body": dec_body}

        // Append generated functions to the program (end).
        // Keep top-level named functions as ExprStmt(Function) for C backend compatibility.
        oren_list_push(stmts, ast.new_expr_stmt(nil, enc_fn))
        oren_list_push(stmts, ast.new_expr_stmt(nil, dec_fn))

        fmt_i = fmt_i + 1
    }

    return nil
}

fn lower_program_in_place(prog, prefix) {
    var errs = []
    if prog == nil { return nil }
    var stmts = prog["statements"]
    if stmts == nil { return nil }
    // GC safety (rolling):
    // During stage2 self-hosting with auto-GC + bounded conservative scanning, `errs` and
    // `stmts` can be missed if they live only in registers or beyond the scanned stack range.
    // Pin a composite root for the duration of this pass.
    var gcroot = {"prog": prog, "errs": errs, "stmts": stmts}
    var prev_pin = oren_gc_pin(gcroot)

    // Iterate over type declarations and generate serde helpers where requested.
    var i = 0
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        if s != nil && s["type"] == "Type" {
            lower_one_type(s, stmts, prefix, errs)
        }
        i = i + 1
    }

    if errs != nil && oren_list_len(errs) > 0 {
        prog["serde_json_errors"] = errs
    }
    oren_gc_pin(prev_pin)
    return nil
}
