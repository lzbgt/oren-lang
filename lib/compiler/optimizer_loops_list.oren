fn _opt_sink_list_lit_into_if(block) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var out = []
    var changed = false
    var i = 0
    while i < oren_list_len(ss) {
        if i + 1 < oren_list_len(ss) {
            var st = ss[i]
            var nxt = ss[i + 1]
            var if_stmt = nil
            if nxt != nil {
                if nxt["type"] == "If" {
                    if_stmt = nxt
                } else if nxt["type"] == "ExprStmt" {
                    var ne = nxt["expr"]
                    if ne != nil && ne["type"] == "If" { if_stmt = ne }
                }
            }
            if st != nil && if_stmt != nil && (st["type"] == "Var" || st["type"] == "Assign") {
                var nm = opthelp.is_ident(st["name"])
                if nm != nil && _opt_expr_is_list_lit(st["value"]) == true && _opt_expr_is_side_effect_free(st["value"]) == true {
                    if _opt_expr_has_ident(if_stmt["cond"], nm) != true &&
                       (if_stmt["alt"] == nil || _opt_stmt_has_ident(if_stmt["alt"], nm) != true) &&
                       _opt_block_has_ident_after(block, i + 2, nm) != true &&
                       _opt_stmt_has_ident(if_stmt["consq"], nm) == true {
                        var consq = if_stmt["consq"]
                        if consq == nil || consq["type"] != "Block" {
                            var nb = ast.new_block(if_stmt["token"])
                            if consq != nil { nb["stmts"] = [consq] }
                            consq = nb
                            if_stmt["consq"] = consq
                        }
                        var css = consq["stmts"]
                        if css == nil { css = []; consq["stmts"] = css }
                        var pre = []
                        var needed = []
                        _opt_expr_collect_idents(st["value"], needed)
                        var pi = i - 1
                        while pi >= 0 {
                            var pst = ss[pi]
                            if pst == nil { break }
                            if pst["type"] != "Var" && pst["type"] != "Assign" { break }
                            var pnm = opthelp.is_ident(pst["name"])
                            if pnm == nil { break }
                            if _opt_str_eq(pnm, nm) { break }
                            if _opt_ident_list_has(needed, pnm) != true { break }
                            if _opt_expr_is_side_effect_free(pst["value"]) != true { break }
                            if _opt_expr_has_ident(if_stmt["cond"], pnm) == true { break }
                            if if_stmt["alt"] != nil && _opt_stmt_has_ident(if_stmt["alt"], pnm) == true { break }
                            if _opt_block_has_ident_after(block, i + 2, pnm) == true { break }
                            oren_list_push(pre, pst)
                            _opt_expr_collect_idents(pst["value"], needed)
                            pi = pi - 1
                        }
                        var pre_rev = []
                        var pri = oren_list_len(pre) - 1
                        while pri >= 0 {
                            oren_list_push(pre_rev, pre[pri])
                            pri = pri - 1
                        }
                        if oren_list_len(pre_rev) > 0 {
                            var keep_len = oren_list_len(out) - oren_list_len(pre_rev)
                            if keep_len < 0 { keep_len = 0 }
                            var out2 = []
                            var oi = 0
                            while oi < keep_len {
                                oren_list_push(out2, out[oi])
                                oi = oi + 1
                            }
                            out = out2
                        }
                        var new_css = pre_rev
                        oren_list_push(new_css, st)
                        var ci = 0
                        while ci < oren_list_len(css) {
                            oren_list_push(new_css, css[ci])
                            ci = ci + 1
                        }
                        consq["stmts"] = new_css
                        oren_list_push(out, nxt)
                        changed = true
                        i = i + 2
                        continue
                    }
                }
            }
            if st != nil && if_stmt != nil && st["type"] == "Var" {
                var nm2 = opthelp.is_ident(st["name"])
                var v0 = st["value"]
                if nm2 != nil && (v0 == nil || v0["type"] == "Nil" || _opt_expr_is_empty_list_lit(v0) == true) {
                    if _opt_expr_has_ident(if_stmt["cond"], nm2) != true &&
                       (if_stmt["alt"] == nil || _opt_stmt_has_ident(if_stmt["alt"], nm2) != true) &&
                       _opt_block_has_ident_after(block, i + 2, nm2) != true {
                        var consq2 = if_stmt["consq"]
                        if consq2 == nil || consq2["type"] != "Block" {
                            var nb2 = ast.new_block(if_stmt["token"])
                            if consq2 != nil { nb2["stmts"] = [consq2] }
                            consq2 = nb2
                            if_stmt["consq"] = consq2
                        }
                        var css2 = consq2["stmts"]
                        if css2 != nil && oren_list_len(css2) > 0 {
                            var first = css2[0]
                            if first != nil && first["type"] == "Assign" {
                                var nm3 = opthelp.is_ident(first["name"])
                                if nm3 != nil && _opt_str_eq(nm3, nm2) == true && _opt_expr_is_list_lit(first["value"]) == true {
                                    first["type"] = "Var"
                                    oren_list_push(out, nxt)
                                    changed = true
                                    i = i + 2
                                    continue
                                }
                            }
                        }
                    }
                }
            }
        }
        oren_list_push(out, ss[i])
        i = i + 1
    }
    if changed { block["stmts"] = out }
    return changed
}

fn sink_list_lit_into_if(block) {
    if block == nil || block["type"] != "Block" { return false }
    var changed = _opt_sink_list_lit_into_if(block)
    var ss = block["stmts"]
    if ss == nil { return changed }
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        if st != nil {
            var t = st["type"]
            if t == "While" || t == "For" {
                if st["body"] != nil && st["body"]["type"] == "Block" {
