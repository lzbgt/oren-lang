            if nm2 == nil || _opt_str_eq(nm2, tmp_name) != true { return nil }
            expr2 = cst["value"]
        } else {
            var left = cst["left"]
            if left == nil || left["type"] != "Identifier" { return nil }
            if _opt_str_eq(left["value"], tmp_name) != true { return nil }
            expr2 = cst["value"]
        }
    }
    if expr2 == nil { return nil }
    if _opt_expr_is_side_effect_free(expr2) != true { return nil }

    var push_info = _opt_stmt_is_list_push_with_tmp(st2, tmp_name)
    if push_info == nil { return nil }
    var list_name = push_info["list"]

    if _opt_stmt_is_simple_inc(st3, idx_name) != true { return nil }

    var assigned = {}
    opthelp.collect_assigned_names_stmt(assigned, body)
    if assigned != nil {
        for nm3 in assigned {
            if _opt_str_eq(nm3, idx_name) || _opt_str_eq(nm3, tmp_name) || _opt_str_eq(nm3, list_name) {
                continue
            }
            if _opt_expr_has_ident(if_stmt["cond"], nm3) { return nil }
        }
    }
    if _opt_expr_is_side_effect_free(if_stmt["cond"]) != true { return nil }
    if _opt_expr_has_ident(if_stmt["cond"], idx_name) { return nil }
    if _opt_expr_has_ident(if_stmt["cond"], tmp_name) { return nil }
    if _opt_expr_has_ident(if_stmt["cond"], list_name) { return nil }
    if _opt_expr_has_ident(expr1, list_name) { return nil }
    if _opt_expr_has_ident(expr2, list_name) { return nil }

    var fn_expr = {"type": "Identifier", "token": nil, "value": push_info["name"]}
    var push1 = ast.new_call(stmt["token"], fn_expr, [push_info["list_expr"], expr1])
    var push2 = ast.new_call(stmt["token"], fn_expr, [push_info["list_expr"], expr2])
    var body1 = {"type": "Block", "token": body["token"], "stmts": [ast.new_expr_stmt(stmt["token"], push1), st3]}
    var body2 = {"type": "Block", "token": body["token"], "stmts": [ast.new_expr_stmt(stmt["token"], push2), st3]}
    var loop1 = {"type": "While", "token": stmt["token"], "cond": stmt["cond"], "body": body1, "attrs": stmt["attrs"]}
    var loop2 = {"type": "While", "token": stmt["token"], "cond": stmt["cond"], "body": body2, "attrs": stmt["attrs"]}
    return {"type": "If", "token": stmt["token"], "cond": if_stmt["cond"],
        "consq": {"type": "Block", "token": body["token"], "stmts": [loop2]},
        "alt": {"type": "Block", "token": body["token"], "stmts": [loop1]}}
}

fn split_invariant_list_push_in_block(block) {
    if _opt_arena_backend_allows() != true { return false }
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var out = []
    var changed = false
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        var replaced = nil
        if st != nil && st["type"] == "While" {
            replaced = _opt_split_invariant_list_push_while(st)
        }
        if replaced != nil {
            oren_list_push(out, replaced)
            changed = true
        } else {
            if st != nil && st["type"] == "If" {
                if st["consq"] != nil && split_invariant_list_push_in_block(st["consq"]) { changed = true }
                if st["alt"] != nil && split_invariant_list_push_in_block(st["alt"]) { changed = true }
            } else if st != nil && st["type"] == "ExprStmt" {
                var e2 = st["expr"]
                if e2 != nil && e2["type"] == "If" {
                    if e2["consq"] != nil && split_invariant_list_push_in_block(e2["consq"]) { changed = true }
                    if e2["alt"] != nil && split_invariant_list_push_in_block(e2["alt"]) { changed = true }
                }
            } else if st != nil && st["type"] == "While" {
                if st["body"] != nil && split_invariant_list_push_in_block(st["body"]) { changed = true }
            } else if st != nil && st["type"] == "For" {
                if st["body"] != nil && split_invariant_list_push_in_block(st["body"]) { changed = true }
            } else if st != nil && st["type"] == "Switch" {
                var cases = st["cases"]
                if cases != nil {
                    var ci = 0
                    while ci < oren_list_len(cases) {
                        var c = cases[ci]
                        if c != nil && c["body"] != nil && split_invariant_list_push_in_block(c["body"]) { changed = true }
                        ci = ci + 1
                    }
                }
                if st["default"] != nil && split_invariant_list_push_in_block(st["default"]) { changed = true }
            }
            oren_list_push(out, st)
        }
        i = i + 1
    }
    if changed { block["stmts"] = out }
    return changed
}

fn _opt_insert_list_reserve_in_block(block, safe_vars) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var out = []
    var changed = false
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        var injected = false
        if st != nil && (st["type"] == "Var" || st["type"] == "Assign") {
            var nm = opthelp.is_ident(st["name"])
            var kind = _opt_safe_var_kind(safe_vars, nm)
            if nm != nil && kind != nil && _opt_expr_is_empty_list_ctor(st["value"]) == true {
                var j = i + 1
                while j < oren_list_len(ss) {
                    var stj = ss[j]
                    if stj == nil { j = j + 1; continue }
                    if bounds._opt_stmt_assigns_ident(stj, nm) == true { break }
                    if _opt_stmt_has_ident(stj, nm) == true {
                        if stj["type"] == "While" || stj["type"] == "For" {
                            var bound = bounds._opt_loop_simple_bound_value(block, j, stj)
                            if bound != nil && bound > 0 && bounds._opt_stmt_has_list_len_mutation(stj["body"], nm) == true {
                                var reserve_fn = "oren_list_reserve"
                                if kind == "list_int" { reserve_fn = "oren_list_int_reserve" }
                                var call = ast.new_call(stj["token"],
                                    {"type": "Identifier", "token": nil, "value": reserve_fn},
                                    [{"type": "Identifier", "token": nil, "value": nm},
                                     {"type": "Integer", "token": nil, "value": oren_int_to_string(bound)}])
                                oren_list_push(out, st)
                                oren_list_push(out, {"type": "ExprStmt", "token": stj["token"], "expr": call})
                                injected = true
                                changed = true
                            }
                        }
                        break
                    }
                    j = j + 1
                }
            }
        }
        if injected != true { oren_list_push(out, st) }
        i = i + 1
    }
    if changed { block["stmts"] = out }
    return changed
}
