                                [{"type": "Integer", "token": nil, "value": oren_int_to_string(lit_len)}])
                        var init = {"type": st["type"], "token": st["token"], "name": st["name"], "value": call}
                        if st["attrs"] != nil { init["attrs"] = st["attrs"] }
                        oren_list_push(out, init)
                        var ei = 0
                        while ei < oren_list_len(els) {
