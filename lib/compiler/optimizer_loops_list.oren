                    if _opt_expr_has_ident(base, name) { return true }
                }
            } else if _opt_expr_has_ident(left, name) {
                return true
            }
        }
        return _opt_expr_has_unsafe_list_use(stmt["value"], name)
    }
    if t == "Return" { return _opt_expr_has_unsafe_list_use(stmt["value"], name) }
    if t == "ExprStmt" { return _opt_expr_has_unsafe_list_use(stmt["expr"], name) }
    if t == "While" || t == "For" {
        if t == "For" {
            if _opt_stmt_has_unsafe_list_use(stmt["init"], name) { return true }
            if _opt_expr_has_unsafe_list_use(stmt["cond"], name) { return true }
            if _opt_expr_has_unsafe_list_use(stmt["post"], name) { return true }
        }
        if _opt_expr_has_unsafe_list_use(stmt["cond"], name) { return true }
        return _opt_stmt_has_unsafe_list_use(stmt["body"], name)
    }
    if t == "If" {
        if _opt_expr_has_unsafe_list_use(stmt["cond"], name) { return true }
        if _opt_stmt_has_unsafe_list_use(stmt["consq"], name) { return true }
