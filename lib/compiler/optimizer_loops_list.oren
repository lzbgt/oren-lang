fn _opt_rewrite_loop_list_reuse(block, idx, loop_stmt, safe_vars) {
    if block == nil || block["type"] != "Block" { return false }
    if loop_stmt == nil { return false }
    var body = loop_stmt["body"]
    if body == nil || body["type"] != "Block" { return false }
    var ss = body["stmts"]
    if ss == nil { return false }
    if safe_vars != nil { _opt_arena_trace("[arena_loop] list_reuse enter safe_vars=" + oren_int_to_string(oren_list_len(safe_vars))) }
    var hoists = []
    var changed = false
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        if st != nil && st["type"] == "Var" {
            var nm = opthelp.is_ident(st["name"])
            var kind = _opt_safe_var_kind(safe_vars, nm)
            if nm != nil && kind != nil {
                if _opt_block_has_ident_before(block, idx, nm) == true {
                    _opt_arena_trace("[arena_loop] list_reuse skip=prior_use name=" + nm)
                    i = i + 1
                    continue
                }
                var v = st["value"]
                if _opt_expr_is_list_ctor_any(v) != true {
                    _opt_arena_trace("[arena_loop] list_reuse skip=ctor name=" + nm)
                    i = i + 1
                    continue
                }
                var j = i + 1
                var reassigned = false
                while j < oren_list_len(ss) {
                    if bounds._opt_stmt_assigns_ident(ss[j], nm) == true {
                        reassigned = true
                        break
                    }
                    j = j + 1
                }
                if reassigned == true {
                    _opt_arena_trace("[arena_loop] list_reuse skip=reassign name=" + nm)
                    i = i + 1
                    continue
                }
                var clear_fn = "oren_list_clear_unchecked"
                if kind == "list_int" { clear_fn = "oren_list_int_clear_unchecked" }
                var call = ast.new_call(st["token"],
                    {"type": "Identifier", "token": nil, "value": clear_fn},
                    [{"type": "Identifier", "token": nil, "value": nm}])
                ss[i] = {"type": "ExprStmt", "token": st["token"], "expr": call}
                var init = {"type": "Var", "token": st["token"], "name": st["name"], "value": v}
                if st["attrs"] != nil { init["attrs"] = st["attrs"] }
                oren_list_push(hoists, init)
                _opt_arena_trace("[arena_loop] list_reuse name=" + nm + " kind=" + kind)
                changed = true
            }
        }
        i = i + 1
    }
    if changed != true || hoists == nil || oren_list_len(hoists) == 0 { return changed }
    var bs = block["stmts"]
    if bs == nil { return changed }
    var out = []
    var inserted = false
    var bi = 0
    while bi < oren_list_len(bs) {
        var cur = bs[bi]
        if inserted != true && cur == loop_stmt {
            var hi = 0
            while hi < oren_list_len(hoists) {
                oren_list_push(out, hoists[hi])
                hi = hi + 1
            }
            inserted = true
        }
        oren_list_push(out, cur)
        bi = bi + 1
    }
    if inserted != true && idx >= 0 {
        // Fallback: insert at the original index if the loop statement was replaced.
        var out2 = []
        var bi2 = 0
        while bi2 < oren_list_len(out) {
            if bi2 == idx {
                var hi2 = 0
                while hi2 < oren_list_len(hoists) {
                    oren_list_push(out2, hoists[hi2])
                    hi2 = hi2 + 1
                }
            }
            oren_list_push(out2, out[bi2])
            bi2 = bi2 + 1
        }
        out = out2
    }
    block["stmts"] = out
    return true
}

