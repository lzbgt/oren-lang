// macOS arm64 ABI constants used by the syscall-first native backend.
//
// Policy:
// - Prefer repo-owned constants (this file + docs/refs) over depending on host SDK headers.
// - System headers may be used for audit/verification, but must not be a build dependency.
//
// References:
// - `docs/refs/darwin_xnu_syscalls.master` (XNU syscall table)
// - `docs/refs/darwin_arm64_abi.md` (curated subset + offset notes)

// --- Syscall numbers (arm64, macOS / Darwin) ---
// Verified against `docs/refs/darwin_xnu_syscalls.master`.
fn darwin_sys_exit() { return 1 }
fn darwin_sys_read() { return 3 }
fn darwin_sys_write() { return 4 }
fn darwin_sys_open() { return 5 }
fn darwin_sys_close() { return 6 }
fn darwin_sys_wait4() { return 7 }
fn darwin_sys_kill() { return 37 }
fn darwin_sys_execve() { return 59 }
fn darwin_sys_fcntl() { return 92 }
fn darwin_sys_gettimeofday() { return 116 }
fn darwin_sys_getentropy() { return 500 }
fn darwin_sys_getpeername() { return 31 }
fn darwin_sys_getsockname() { return 32 }
fn darwin_sys_setsockopt() { return 105 }
fn darwin_sys_getsockopt() { return 118 }
fn darwin_sys_shutdown() { return 134 }
fn darwin_sys_dup() { return 41 }
fn darwin_sys_dup2() { return 90 }
fn darwin_sys_ioctl() { return 54 }
fn darwin_sys_socket() { return 97 }
fn darwin_sys_connect() { return 98 }
fn darwin_sys_accept() { return 30 }
fn darwin_sys_bind() { return 104 }
fn darwin_sys_listen() { return 106 }
fn darwin_sys_sendto() { return 133 }
fn darwin_sys_recvfrom() { return 29 }
fn darwin_sys_fork() { return 2 }
    fn darwin_sys_kqueue() { return 362 }
    fn darwin_sys_kevent() { return 363 }
    // Darwin bsdthread syscalls (syscall-first OS threads; no libpthread dependency).
    // Verified against `docs/refs/darwin_xnu_syscalls.master`.
    fn darwin_sys_bsdthread_create() { return 360 }
    fn darwin_sys_bsdthread_terminate() { return 361 }
    fn darwin_sys_bsdthread_register() { return 366 }
fn darwin_sys_unlink() { return 10 }
fn darwin_sys_access() { return 33 }
fn darwin_sys_rename() { return 128 }
fn darwin_sys_mkdir() { return 136 }
fn darwin_sys_rmdir() { return 137 }
fn darwin_sys_mmap() { return 197 }
fn darwin_sys_munmap() { return 73 }
fn darwin_sys_pipe() { return 42 }
fn darwin_sys_chmod() { return 15 }

// Repo-owned open(2) flag constants (Darwin).
// These are used by the syscall-first native backend; do not pull SDK headers at build time.
fn darwin_open_flag_creat() { return 512 }  // O_CREAT  = 0x0200
fn darwin_open_flag_trunc() { return 1024 } // O_TRUNC  = 0x0400
fn darwin_open_flag_nonblock() { return 4 } // O_NONBLOCK = 0x0004

// Threading / sync (Darwin-specific)
fn darwin_sys_thread_selfid() { return 372 }
fn darwin_sys_ulock_wait() { return 515 }
fn darwin_sys_ulock_wake() { return 516 }

// FS stat family
fn darwin_sys_stat64() { return 338 }
fn darwin_sys_fstat64() { return 339 }
fn darwin_sys_lstat64() { return 340 }
fn darwin_sys_getdirentries64() { return 344 }

// --- Syscall instruction ABI (arm64, Darwin) ---
// Darwin AArch64 syscall convention:
// - syscall number in X16
// - `svc #0x80`
fn darwin_syscall_reg() { return 16 }
fn darwin_svc_imm() { return 128 }

// --- libc-independent fcntl constants (used by host-mode convenience helpers) ---
// NOTE: `F_GETPATH` is a Darwin fcntl command that writes the file path for an fd.
// It is used by `oren_getcwd()` in host-mode to avoid `getcwd(3)` (libc).
// Verified against `docs/refs/darwin_sys_fcntl.h` (vendored from Xcode macOS SDK; audit-only).
fn darwin_fcntl_f_getpath() { return 50 }

// --- socket(2) / getsockopt(2) / setsockopt(2) constants (Darwin) ---
// Repo-owned values (verified against `docs/refs/darwin_sys_socket.h`; audit-only; not a build dependency).
fn darwin_sol_socket() { return 65535 } // SOL_SOCKET = 0xffff
fn darwin_so_reuseaddr() { return 4 }
fn darwin_so_error() { return 4103 } // SO_ERROR = 0x1007
fn darwin_so_keepalive() { return 8 } // SO_KEEPALIVE = 0x0008

// fcntl(2) command values used by syscall-first helpers.
// These are POSIX-stable across Darwin/Linux (verified via headers; audit-only).
fn posix_fcntl_f_getfl() { return 3 }
fn posix_fcntl_f_setfl() { return 4 }

// --- `struct stat` layout (Darwin) ---
// Verified on macOS arm64 by compiling a tiny audit C program (no runtime dependency):
// - sizeof(struct stat) == 144
// - offsetof(st_mode) == 4
// - offsetof(st_size) == 96
// - time fields are `struct timespec`:
//   - offsetof(st_atimespec.tv_sec)  == 32
//   - offsetof(st_atimespec.tv_nsec) == 40
//   - offsetof(st_mtimespec.tv_sec)  == 48
//   - offsetof(st_mtimespec.tv_nsec) == 56
//   - offsetof(st_ctimespec.tv_sec)  == 64
//   - offsetof(st_ctimespec.tv_nsec) == 72
fn darwin_stat_size_bytes() { return 144 }
fn darwin_stat_off_st_mode() { return 4 }
fn darwin_stat_off_st_size() { return 96 }
fn darwin_stat_off_st_atime_sec() { return 32 }
fn darwin_stat_off_st_atime_nsec() { return 40 }
fn darwin_stat_off_st_mtime_sec() { return 48 }
fn darwin_stat_off_st_mtime_nsec() { return 56 }
fn darwin_stat_off_st_ctime_sec() { return 64 }
fn darwin_stat_off_st_ctime_nsec() { return 72 }

// --- mmap constants (Darwin) ---
//
// These are repo-owned ABI constants for the syscall-first allocator path:
// - No SDK headers at build time
// - Verified against macOS headers (audit-only) and `docs/refs/*`
//
// prot bits:
//   PROT_READ  = 0x1
//   PROT_WRITE = 0x2
// flags bits:
//   MAP_PRIVATE = 0x0002
//   MAP_ANON    = 0x1000
fn darwin_mmap_prot_read_write() { return 3 } // PROT_READ|PROT_WRITE
fn darwin_mmap_flags_private_anon() { return 4098 } // MAP_PRIVATE|MAP_ANON (0x1002)
