// Shared native-runtime include expansion helper (compiler-side).
//
// Motivation:
// - ARM64 native backend injects `lib/runtime_native.oren` (expanded from many small files via
//   `// @include "..."`) into the compiled binary.
// - x86_64 native backend is converging toward the same model.
//
// To avoid copy/pasting a tiny bespoke preprocessor into each backend, we keep the expansion
// logic here and reuse it from both arm64 and x64 pipelines.
//
// Contract:
// - only handles one directive form:
//     // @include "relative/or/absolute/path.oren"
// - preserves non-include lines verbatim
// - enforces include-cycle detection (by full path string)
// - reports errors by pushing strings into ctx["errors"] (same convention as backends)

fn _err(ctx, msg) {
    if ctx == nil { return nil }
    if ctx["errors"] == nil { ctx["errors"] = [] }
    oren_list_push(ctx["errors"], msg)
    return nil
}

fn str_starts_with(s, pref) {
    if s == nil || pref == nil { return false }
    var plen = oren_string_len(pref)
    if oren_string_len(s) < plen { return false }
    return oren_string_slice(s, 0, plen) == pref
}

fn str_ends_with_newline(s) {
    if s == nil { return false }
    var n = oren_string_len(s)
    if n == 0 { return false }
    // PERF: avoid allocating single-byte strings or repeated `strlen` scans in hot loops.
    return oren_string_byte_at_unchecked(s, n - 1) == 10
}

fn path_dirname(path) {
    if path == nil { return "." }
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_byte_at_unchecked(path, i) == 47 {
            if i == 0 { return "/" }
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

fn path_join(base, rel) {
    if rel == nil { return "" }
    if oren_string_len(rel) > 0 && oren_string_byte_at_unchecked(rel, 0) == 47 { return rel }
    if base == nil || base == "" || base == "." { return rel }
    var bl = oren_string_len(base)
    if bl > 0 && oren_string_byte_at_unchecked(base, bl - 1) == 47 { return base + rel }
    return base + "/" + rel
}

fn trim_left_ws(s) {
    if s == nil { return "" }
    var i = 0
    var n = oren_string_len(s)
    while i < n {
        var c = oren_string_char_at_unchecked(s, i)
        if c != " " && c != "\t" && c != "\r" { break }
        i = i + 1
    }
    if i == 0 { return s }
    return oren_string_slice(s, i, n)
}

fn runtime_include_path_from_line(line) {
    // Directive form (must be in a single line comment):
    //   // @include "relative/or/absolute/path.oren"
    //
    // NOTE: this is intentionally tiny and not a general module system.
    if line == nil { return "" }
    var t = trim_left_ws(line)
    if !str_starts_with(t, "// @include") { return "" }
    var n = oren_string_len(t)
    var i = 0
    while i < n {
        if oren_string_char_at_unchecked(t, i) == "\"" { break }
        i = i + 1
    }
    if i >= n { return "" }
    var j = i + 1
    while j < n {
        if oren_string_char_at_unchecked(t, j) == "\"" { break }
        j = j + 1
    }
    if j >= n { return "" }
    return oren_string_slice(t, i + 1, j)
}

fn runtime_include_path_from_src_line(src, line_start, line_end) {
    // Parse `// @include "path"` directly from the source string without slicing the whole line.
    //
    // Returns "" if the line is not an include directive.
    if src == nil { return "" }
    if line_start == nil || line_end == nil { return "" }
    if line_start < 0 || line_end < line_start { return "" }

    // Skip leading whitespace (space/tab/\r).
    var i = line_start
    while i < line_end {
        var c = oren_string_char_at_unchecked(src, i)
        if c != " " && c != "\t" && c != "\r" { break }
        i = i + 1
    }

    // Match prefix `// @include` (no trailing space required here; we scan for quotes next).
    var pref = "// @include"
    var plen = oren_string_len(pref)
    if i + plen > line_end { return "" }
    var j = 0
    while j < plen {
        if oren_string_char_at_unchecked(src, i + j) != oren_string_char_at_unchecked(pref, j) { return "" }
        j = j + 1
    }

    // Find opening quote.
    var q = i + plen
    while q < line_end {
        if oren_string_char_at_unchecked(src, q) == "\"" { break }
        q = q + 1
    }
    if q >= line_end { return "" }

    // Find closing quote.
    var q2 = q + 1
    while q2 < line_end {
        if oren_string_char_at_unchecked(src, q2) == "\"" { break }
        q2 = q2 + 1
    }
    if q2 >= line_end { return "" }
    if q2 <= q + 1 { return "" }
    return oren_string_slice_unchecked(src, q + 1, q2)
}

fn runtime_expand_includes_file_into_parts(ctx, full_path, stack, out_parts) {
    // Append expanded source to out_parts (list<string>), return true or nil on error.
    if full_path == nil || full_path == "" {
        _err(ctx, "native backend: runtime include: empty path")
        return nil
    }
    if out_parts == nil {
        _err(ctx, "native backend: runtime include: out_parts is nil")
        return nil
    }

    // Cycle check
    if stack != nil {
        var si = 0
        while si < oren_list_len(stack) {
            if stack[si] == full_path {
                _err(ctx, "native backend: runtime include cycle: " + full_path)
                return nil
            }
            si = si + 1
        }
    }

    var src = oren_read_file(full_path)
    if oren_is_err(src) {
        var msg = oren_err_msg(src)
        var e = "native backend: failed to read runtime include " + full_path
        if msg != nil { e = e + ": " + msg }
        _err(ctx, e)
        return nil
    }

    var next_stack = []
    if stack != nil {
        var ci = 0
        while ci < oren_list_len(stack) {
            oren_list_push(next_stack, stack[ci])
            ci = ci + 1
        }
    }
    oren_list_push(next_stack, full_path)

    var out_start = oren_list_len(out_parts)

    var seg_start = 0
    var line_start = 0
    var i = 0
    var n = oren_string_len(src)
    while i < n {
        if oren_string_byte_at_unchecked(src, i) == 10 {
            var inc = runtime_include_path_from_src_line(src, line_start, i)
            if inc != nil && oren_string_len(inc) > 0 {
                if seg_start < line_start {
                    var seg = oren_string_slice_unchecked(src, seg_start, line_start)
                    if seg != nil && oren_string_len(seg) > 0 { oren_list_push(out_parts, seg) }
                }

                var inc_full = path_join(path_dirname(full_path), inc)
                var before = oren_list_len(out_parts)
                var ok = runtime_expand_includes_file_into_parts(ctx, inc_full, next_stack, out_parts)
                if ok == nil { return nil }
                var after = oren_list_len(out_parts)

                // Preserve the old contract: ensure a newline after the include insertion.
                if after == before {
                    oren_list_push(out_parts, "\n")
                } else {
                    var last = out_parts[after - 1]
                    if !str_ends_with_newline(last) { oren_list_push(out_parts, "\n") }
                }

                seg_start = i + 1
            }
            line_start = i + 1
        }
        i = i + 1
    }

    // Handle a final unterminated line (no trailing '\n'): it can still contain an include directive.
    var inc_last = runtime_include_path_from_src_line(src, line_start, n)
    if inc_last != nil && oren_string_len(inc_last) > 0 {
        if seg_start < line_start {
            var seg_last = oren_string_slice_unchecked(src, seg_start, line_start)
            if seg_last != nil && oren_string_len(seg_last) > 0 { oren_list_push(out_parts, seg_last) }
        }

        var inc_full_last = path_join(path_dirname(full_path), inc_last)
        var before_last = oren_list_len(out_parts)
        var ok_last = runtime_expand_includes_file_into_parts(ctx, inc_full_last, next_stack, out_parts)
        if ok_last == nil { return nil }
        var after_last = oren_list_len(out_parts)
        if after_last == before_last {
            oren_list_push(out_parts, "\n")
        } else {
            var last2 = out_parts[after_last - 1]
            if !str_ends_with_newline(last2) { oren_list_push(out_parts, "\n") }
        }

        seg_start = n
    }

    if seg_start < n {
        var seg2 = oren_string_slice_unchecked(src, seg_start, n)
        if seg2 != nil && oren_string_len(seg2) > 0 { oren_list_push(out_parts, seg2) }
    }

    // Ensure this file contributes a trailing newline if it contributed any content.
    if oren_list_len(out_parts) > out_start {
        var last3 = out_parts[oren_list_len(out_parts) - 1]
        if !str_ends_with_newline(last3) { oren_list_push(out_parts, "\n") }
    }

    return true
}

fn runtime_expand_includes_file(ctx, full_path, stack) {
    // Returns expanded source string, or nil on error (errors pushed into ctx["errors"]).
    //
    // PERF:
    // - Flatten into a single parts list across the whole include tree.
    // - Join once at the end to avoid quadratic re-concatenation of large child expansions.
    var out_parts = []
    var ok = runtime_expand_includes_file_into_parts(ctx, full_path, stack, out_parts)
    if ok == nil { return nil }
    return oren_string_join(out_parts)
}

fn _runtime_expand_includes_file_into_parts_and_files_inner(ctx, full_path, stack, out_parts, out_files, seen_files) {
    // Expand runtime includes while also collecting the unique file list (full paths).
    //
    // Used by rtobj cache layers to persist a stat-validated runtime hash without re-reading
    // the entire runtime on every compiler invocation.
    if full_path == nil || full_path == "" {
        _err(ctx, "native backend: runtime include: empty path")
        return nil
    }
    if out_parts == nil || out_files == nil {
        _err(ctx, "native backend: runtime include: out_parts/out_files is nil")
        return nil
    }

    if seen_files != nil && seen_files[full_path] == nil {
        seen_files[full_path] = true
        oren_list_push(out_files, full_path)
    }

    // Cycle check
    if stack != nil {
        var si = 0
        while si < oren_list_len(stack) {
            if stack[si] == full_path {
                _err(ctx, "native backend: runtime include cycle: " + full_path)
                return nil
            }
            si = si + 1
        }
    }

    var src = oren_read_file(full_path)
    if oren_is_err(src) {
        var msg = oren_err_msg(src)
        var e = "native backend: failed to read runtime include " + full_path
        if msg != nil { e = e + ": " + msg }
        _err(ctx, e)
        return nil
    }

    var next_stack = []
    if stack != nil {
        var ci = 0
        while ci < oren_list_len(stack) {
            oren_list_push(next_stack, stack[ci])
            ci = ci + 1
        }
    }
    oren_list_push(next_stack, full_path)

    var out_start = oren_list_len(out_parts)

    var seg_start = 0
    var line_start = 0
    var i = 0
    var n = oren_string_len(src)
    while i < n {
        if oren_string_byte_at_unchecked(src, i) == 10 {
            var inc = runtime_include_path_from_src_line(src, line_start, i)
            if inc != nil && oren_string_len(inc) > 0 {
                if seg_start < line_start {
                    var seg = oren_string_slice_unchecked(src, seg_start, line_start)
                    if seg != nil && oren_string_len(seg) > 0 { oren_list_push(out_parts, seg) }
                }

                var inc_full = path_join(path_dirname(full_path), inc)
                var before = oren_list_len(out_parts)
                var ok = _runtime_expand_includes_file_into_parts_and_files_inner(ctx, inc_full, next_stack, out_parts, out_files, seen_files)
                if ok == nil { return nil }
                var after = oren_list_len(out_parts)

                // Preserve the old contract: ensure a newline after the include insertion.
                if after == before {
                    oren_list_push(out_parts, "\n")
                } else {
                    var last = out_parts[after - 1]
                    if !str_ends_with_newline(last) { oren_list_push(out_parts, "\n") }
                }

                seg_start = i + 1
            }
            line_start = i + 1
        }
        i = i + 1
    }

    // Handle a final unterminated line (no trailing '\n'): it can still contain an include directive.
    var inc_last = runtime_include_path_from_src_line(src, line_start, n)
    if inc_last != nil && oren_string_len(inc_last) > 0 {
        if seg_start < line_start {
            var seg_last = oren_string_slice_unchecked(src, seg_start, line_start)
            if seg_last != nil && oren_string_len(seg_last) > 0 { oren_list_push(out_parts, seg_last) }
        }

        var inc_full_last = path_join(path_dirname(full_path), inc_last)
        var before_last = oren_list_len(out_parts)
        var ok_last = _runtime_expand_includes_file_into_parts_and_files_inner(ctx, inc_full_last, next_stack, out_parts, out_files, seen_files)
        if ok_last == nil { return nil }
        var after_last = oren_list_len(out_parts)
        if after_last == before_last {
            oren_list_push(out_parts, "\n")
        } else {
            var last2 = out_parts[after_last - 1]
            if !str_ends_with_newline(last2) { oren_list_push(out_parts, "\n") }
        }

        seg_start = n
    }

    if seg_start < n {
        var seg2 = oren_string_slice_unchecked(src, seg_start, n)
        if seg2 != nil && oren_string_len(seg2) > 0 { oren_list_push(out_parts, seg2) }
    }

    // Ensure this file contributes a trailing newline if it contributed any content.
    if oren_list_len(out_parts) > out_start {
        var last3 = out_parts[oren_list_len(out_parts) - 1]
        if !str_ends_with_newline(last3) { oren_list_push(out_parts, "\n") }
    }

    return true
}

fn runtime_expand_includes_file_into_parts_and_files(ctx, full_path, stack, out_parts, out_files) {
    var seen = {}
    return _runtime_expand_includes_file_into_parts_and_files_inner(ctx, full_path, stack, out_parts, out_files, seen)
}
