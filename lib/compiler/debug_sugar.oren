import ast "ast.oren"
import token "token.oren"

fn _dbg_attr(tok) {
    return {"type": "Attr", "token": tok, "name": "oren.debug", "args": []}
}

fn _dbg_prefix_string(tok) {
    var file = "<input>"
    var line = 0
    if tok != nil {
        if tok["file"] != nil { file = tok["file"] }
        var ln = tok["line"]
        if oren_type_tag(ln) != 0 { line = ln }
    }
    if line > 0 {
        return "dbg " + file + ":" + oren_int_to_string(line) + ":"
    }
    return "dbg " + file + ":"
}

fn _dbg_is_ident(expr, name) {
    if expr == nil || name == nil { return false }
    return expr["type"] == "Identifier" && expr["value"] == name
}

fn _dbg_make_print_call(call_expr) {
    var tok = nil
    if call_expr != nil { tok = call_expr["token"] }
    var prefix = _dbg_prefix_string(tok)
    var prefix_tok = token.new_token(token.TOK_STRING, prefix)
    var prefix_expr = ast.new_string(prefix_tok)

    var print_tok = token.new_token(token.TOK_IDENT, "print")
    var print_ident = ast.new_identifier(print_tok)

    var args = [prefix_expr]
    var orig = nil
    if call_expr != nil { orig = call_expr["args"] }
    if orig != nil {
        var i = 0
        while i < oren_list_len(orig) {
            oren_list_push(args, orig[i])
            i = i + 1
        }
    }

    var out = ast.new_call(tok, print_ident, args)
    if call_expr != nil && call_expr["spread"] != nil {
        out["spread"] = call_expr["spread"]
    }
    return out
}

fn _dbg_attrs_has_name(attrs, name) {
    if attrs == nil || name == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["type"] == "Attr" && a["name"] == name { return true }
        i = i + 1
    }
    return false
}

fn _dbg_stmt_rewrite(stmt) {
    if stmt == nil { return nil }
    if stmt["type"] != "ExprStmt" { return nil }
    if stmt["expr"] == nil || stmt["expr"]["type"] != "Call" { return nil }
    var call = stmt["expr"]
    if call["fn"] == nil || call["fn"]["type"] != "Identifier" { return nil }
    var fn_name = call["fn"]["value"]
    if fn_name != "dbg" && fn_name != "trace" { return nil }

    stmt["expr"] = _dbg_make_print_call(call)
    if stmt["attrs"] == nil { stmt["attrs"] = [] }
    if _dbg_attrs_has_name(stmt["attrs"], "oren.debug") != true {
        oren_list_push(stmt["attrs"], _dbg_attr(call["token"]))
    }
    return nil
}

fn _dbg_lower_stmt_in_place(stmt) {
    if stmt == nil { return nil }
    _dbg_stmt_rewrite(stmt)
    var t = stmt["type"]
    if t == "Block" {
        _dbg_lower_stmt_list_in_place(stmt["stmts"])
        return nil
    }
    if t == "StmtList" {
        _dbg_lower_stmt_list_in_place(stmt["stmts"])
        return nil
    }
    if t == "Function" {
        _dbg_lower_stmt_in_place(stmt["body"])
        return nil
    }
    if t == "ExprStmt" {
        var exp = stmt["expr"]
        if exp != nil && exp["type"] == "Function" {
            _dbg_lower_stmt_in_place(exp["body"])
        }
        return nil
    }
    if t == "If" {
        _dbg_lower_stmt_in_place(stmt["consq"])
        if stmt["alt"] != nil { _dbg_lower_stmt_in_place(stmt["alt"]) }
        return nil
    }
    if t == "While" {
        _dbg_lower_stmt_in_place(stmt["body"])
        return nil
    }
    if t == "For" {
        if stmt["init"] != nil { _dbg_lower_stmt_in_place(stmt["init"]) }
        if stmt["post"] != nil { _dbg_lower_stmt_in_place(stmt["post"]) }
        _dbg_lower_stmt_in_place(stmt["body"])
        return nil
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && c["body"] != nil { _dbg_lower_stmt_in_place(c["body"]) }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil { _dbg_lower_stmt_in_place(stmt["default"]) }
        return nil
    }
    return nil
}

fn _dbg_lower_stmt_list_in_place(stmts) {
    if stmts == nil { return nil }
    var i = 0
    while i < oren_list_len(stmts) {
        _dbg_lower_stmt_in_place(stmts[i])
        i = i + 1
    }
    return nil
}

fn lower_program_in_place(prog) {
    if prog == nil { return nil }
    var stmts = prog["statements"]
    if stmts == nil { return nil }
    _dbg_lower_stmt_list_in_place(stmts)
    return nil
}
