import token "token.oren"

// --- Tracing controls (cached) ---
//
// IMPORTANT:
// - The lexer is extremely hot in the self-host compiler.
// - Calling `oren_env(...)` on every token/character is catastrophically slow on the native runtime.
//   (env lookup scans envp, and the compiler can create millions of tokens across modules).
//
// Cache env flags on first use so the default (no tracing) stays fast.
var g_trace_lex = -1       // -1 unknown, 0 disabled, 1 enabled
var g_trace_lex_step = -1  // -1 unknown, 0 disabled, 1 enabled

fn _trace_lex_enabled() {
    if g_trace_lex != -1 { return g_trace_lex == 1 }
    var v = oren_env("OREN_TRACE_LEX")
    if v != nil && v != "" { g_trace_lex = 1 } else { g_trace_lex = 0 }
    return g_trace_lex == 1
}

fn _trace_lex_step_enabled() {
    if g_trace_lex_step != -1 { return g_trace_lex_step == 1 }
    var v = oren_env("OREN_TRACE_LEX_STEP")
    if v != nil && v != "" { g_trace_lex_step = 1 } else { g_trace_lex_step = 0 }
    return g_trace_lex_step == 1
}

fn new_lexer(input) {
    // `file` is optional and should be set by the caller when lexing a real module,
    // so tokens can carry location info for diagnostics.
    // Track 1-based line/col for the current character at `position`.
    // This enables cheap deterministic diagnostics without rescanning the source.
    if input == nil { input = "" }
    var l = {"input": input, "input_len": oren_string_len(input), "position": 0, "read_position": 0, "ch": "", "file": nil, "line": 1, "col": 1}
    read_char(l)
    return l
}

fn read_char(l) {
    // Advance line/col based on the previous current character.
    var prev = l["ch"]
    if prev != "" {
        if prev == token.CH_LF {
            l["line"] = iadd(l["line"], 1)
            l["col"] = 1
        } else {
            l["col"] = iadd(l["col"], 1)
        }
    }

    var input_len = l["input_len"]
    if l["read_position"] >= input_len {
        l["ch"] = ""
    } else {
        // PERF: caller already bounds-checks against `input_len`, so avoid `char_at`'s
        // per-call length scan (O(n) `strlen` on C backend, O(n) byte scan on native).
        l["ch"] = oren_string_char_at_unchecked(l["input"], l["read_position"])
    }
    l["position"] = l["read_position"]
    l["read_position"] = iadd(l["read_position"], 1)
}

fn peek_char(l) {
    var input_len = l["input_len"]
    if l["read_position"] >= input_len {
        return ""
    }
    return oren_string_char_at_unchecked(l["input"], l["read_position"])
}

fn peek_char2(l) {
    var input_len = l["input_len"]
    var pos = iadd(l["read_position"], 1)
    if pos >= input_len { return "" }
    return oren_string_char_at_unchecked(l["input"], pos)
}

fn _byte0(ch) {
    if ch == nil { return -1 }
    if ch == "" { return -1 }
    return oren_string_char_code_at(ch, 0)
}

fn _is_letter_b(b) {
    if b < 0 { return false }
    if b == 95 { return true } // '_'
    if b >= 65 {
        if b <= 90 { return true } // A..Z
    }
    if b >= 97 {
        if b <= 122 { return true } // a..z
    }
    return false
}

fn _is_digit_b(b) {
    if b < 0 { return false }
    if b >= 48 {
        if b <= 57 { return true } // 0..9
    }
    return false
}

fn skip_whitespace(l) {
    // Stage2-native robustness:
    // Avoid calling `token.is_whitespace` (string equality on single-byte strings) here.
    // Some stage2-native builds have exhibited non-termination during lexing; byte-based
    // classification is both faster and avoids backend string-compare edge cases.
    var trace_step = _trace_lex_step_enabled()
    var guard = 0
    while 1 {
        var b = _byte0(l["ch"])
        if b < 0 { break } // EOF
        if b == 32 || b == 9 || b == 10 || b == 13 { // ' ' '\t' '\n' '\r'
            if trace_step == true {
                if guard < 8 {
                    print("TRACE_LEX_STEP ws b=" + oren_int_to_string(b) + " pos=" + oren_int_to_string(l["position"]) + " rp=" + oren_int_to_string(l["read_position"]))
                }
                guard = iadd(guard, 1)
                if guard > 1000000 {
                    print("skip_whitespace: exceeded 1,000,000 iterations (likely stuck)")
                    exit(296)
                }
            }
            read_char(l)
            continue
        }
        break
    }
}

fn skip_comment(l) {
    while l["ch"] != "" {
        if l["ch"] == token.CH_LF { return nil }
        read_char(l)
    }
    return nil
}

fn read_line_comment_text(l) {
    // Read until '\n' or EOF, leaving l["ch"] on '\n' or "".
    var start = l["position"]
    while l["ch"] != "" {
        if l["ch"] == token.CH_LF { return oren_string_slice_unchecked(l["input"], start, l["position"]) }
        read_char(l)
    }
    return oren_string_slice_unchecked(l["input"], start, l["position"])
}

fn _join_parts(parts) {
    if parts == nil { return "" }
    if oren_list_len(parts) == 0 { return "" }
    var cur = parts
    while oren_list_len(cur) > 1 {
        var next = []
        var i = 0
        var n = oren_list_len(cur)
        while i < n {
            if i + 1 < n {
                oren_list_push(next, cur[i] + cur[i + 1])
            } else {
                oren_list_push(next, cur[i])
            }
            i = i + 2
        }
        cur = next
    }
    return cur[0]
}

fn _strip_underscores(s) {
    if s == nil { return "" }
    var n = oren_string_len(s)
    if n == 0 { return s }

    // Fast path: no underscores.
    var has = false
    var i = 0
    while i < n {
        if oren_string_char_at(s, i) == "_" { has = true; break }
        i = iadd(i, 1)
    }
    if has == false { return s }

    var parts = []
    var seg_start = 0
    i = 0
    while i < n {
        if oren_string_char_at(s, i) == "_" {
            if seg_start < i {
                oren_list_push(parts, oren_string_slice(s, seg_start, i))
            }
            seg_start = iadd(i, 1)
        }
        i = iadd(i, 1)
    }
    if seg_start < n {
        oren_list_push(parts, oren_string_slice(s, seg_start, n))
    }
    return _join_parts(parts)
}

fn trim_one_leading_space(s) {
    if s == nil { return s }
    if oren_string_len(s) == 0 { return s }
    if oren_string_char_at(s, 0) == " " { return oren_string_slice(s, 1, oren_string_len(s)) }
    return s
}

fn skip_block_comment(l) {
    // We already consumed the opening '/' and '*'
    var depth = 1
    while l["ch"] != "" {
        if depth <= 0 { break }
        if l["ch"] == "/" {
            if peek_char(l) == "*" {
                read_char(l)
                read_char(l)
                depth = iadd(depth, 1)
                // Continue loop
            } else {
                read_char(l)
            }
        } else {
            if l["ch"] == "*" {
                if peek_char(l) == "/" {
                    read_char(l)
                    read_char(l)
                    depth = depth - 1
                } else {
                    read_char(l)
                }
            } else {
                read_char(l)
            }
        }
    }
    return nil
}

fn read_identifier(l) {
    var start = l["position"]
    var do_trace = _trace_lex_enabled()
    var trace_step = _trace_lex_step_enabled()
    var guard = 0
    while 1 {
        var b = _byte0(l["ch"])
        if _is_letter_b(b) {
            // ok
        } else {
            if _is_digit_b(b) {
                // ok
            } else {
                if trace_step == true {
                    print("TRACE_LEX_STEP ident_break pos=" + oren_int_to_string(l["position"]) + " rp=" + oren_int_to_string(l["read_position"]) + " b=" + oren_int_to_string(b))
                }
                break
            }
        }
        if trace_step == true {
            // Print only the first few iterations to localize non-termination.
            if guard < 5 {
                print("TRACE_LEX_STEP ident_loop i=" + oren_int_to_string(guard) + " pos=" + oren_int_to_string(l["position"]) + " rp=" + oren_int_to_string(l["read_position"]) + " b=" + oren_int_to_string(b))
            }
        }
        if do_trace {
            if guard == 0 {
                print("TRACE_LEX read_identifier start_pos=" + oren_int_to_string(start) + " ch=" + l["ch"])
            }
            guard = iadd(guard, 1)
            if guard > 1000000 {
                print("lexer read_identifier: exceeded 1,000,000 iterations (likely stuck at EOF)")
                exit(299)
            }
        }
        read_char(l)
        if trace_step == true {
            if guard < 5 {
                print("TRACE_LEX_STEP ident_after_read i=" + oren_int_to_string(guard) + " pos=" + oren_int_to_string(l["position"]) + " rp=" + oren_int_to_string(l["read_position"]) + " ch=" + l["ch"])
            }
        }
        if trace_step == true {
            // Independent hard guard for stage2-native bringup.
            guard = iadd(guard, 1)
            if guard > 1000000 {
                print("lexer read_identifier: exceeded 1,000,000 iterations (trace_step guard)")
                exit(297)
            }
        }
    }
    if trace_step == true {
        print("TRACE_LEX_STEP ident_before_slice start=" + oren_int_to_string(start) + " end=" + oren_int_to_string(l["position"]))
    }
    // PERF: input_len was computed once in new_lexer(); avoid per-token O(n) scans in oren_string_slice.
    var out = oren_string_slice_unchecked(l["input"], start, l["position"])
    if trace_step == true {
        print("TRACE_LEX_STEP ident_after_slice")
    }
    return out
}

fn read_number(l) {
    var start = l["position"]
    // PERF: do not call `oren_env` here (this function is hot across the full stdlib/runtime).
    var do_trace = _trace_lex_enabled()
    var guard = 0
    while 1 {
        var ch = l["ch"]
        if ch == "_" {
            // ok
        } else {
            if _is_digit_b(_byte0(ch)) {
                // ok
            } else {
                break
            }
        }
        if do_trace {
            if guard == 0 {
                print("TRACE_LEX read_number start_pos=" + oren_int_to_string(start) + " ch=" + l["ch"])
            }
            guard = iadd(guard, 1)
            if guard > 1000000 {
                print("lexer read_number: exceeded 1,000,000 iterations (likely stuck at EOF)")
                exit(298)
            }
        }
        read_char(l)
    }
    var raw = oren_string_slice_unchecked(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn read_exponent(l) {
    // Read scientific exponent digits (after optional +/-, allowing `_` separators).
    // Caller has already consumed the 'e'/'E' and optional sign, and expects at least one digit.
    var start = l["position"]
    while token.is_digit(l["ch"]) || l["ch"] == "_" {
        read_char(l)
    }
    var raw = oren_string_slice_unchecked(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn is_hex_digit(ch) {
    if ch == "" { return false }
    var b = _byte0(ch)
    if _is_digit_b(b) { return true }
    if b >= 97 {
        if b <= 102 { return true } // a..f
    }
    if b >= 65 {
        if b <= 70 { return true } // A..F
    }
    return false
}

fn read_hex_number(l) {
    var start = l["position"]
    while is_hex_digit(l["ch"]) || l["ch"] == "_" {
        read_char(l)
    }
    var raw = oren_string_slice_unchecked(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn read_bin_number(l) {
    var start = l["position"]
    while l["ch"] == "0" || l["ch"] == "1" || l["ch"] == "_" {
        read_char(l)
    }
    var raw = oren_string_slice_unchecked(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn read_oct_number(l) {
    var start = l["position"]
    while 1 {
        var ch = l["ch"]
        var is_oct = false
        if ch != "" {
            var b = oren_string_char_code_at(ch, 0)
            if b >= 48 && b <= 55 { is_oct = true }
        }
        if is_oct || ch == "_" {
            read_char(l)
        } else {
            break
        }
    }
    var raw = oren_string_slice_unchecked(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn read_string(l) {
    // opening quote already consumed
    //
    // PERF (native backend):
    // Building `out` via repeated string concatenation (`out = out + ch`) is O(n^2) per string literal,
    // and becomes a major self-host compiler bottleneck because the runtime/stdlib contains many
    // string literals (error messages, diagnostics, etc.).
    //
    // Instead, accumulate bytes and allocate exactly once at the end.
    var bs = []
    read_char(l)
    while l["ch"] != token.CH_QUOTE {
        var ch = l["ch"]
        if ch == "" {
            return oren_string_from_bytes(bs)
        }
        if ch == token.CH_BACKSLASH {
            read_char(l)
            ch = l["ch"]
            if ch == "" {
                return oren_string_from_bytes(bs)
            }
            var b = _byte0(ch)
            if ch == "n" { b = 10 }        // '\n'
            else if ch == "r" { b = 13 }   // '\r'
            else if ch == "t" { b = 9 }    // '\t'
            else if ch == token.CH_QUOTE { b = 34 }       // '"'
            else if ch == token.CH_BACKSLASH { b = 92 }   // '\\'
            // Unknown escape: keep the old behavior (treat as literal char).
            if b < 0 { b = 0 }
            oren_list_push(bs, b)
            read_char(l)
        } else {
            var b2 = _byte0(ch)
            if b2 < 0 { b2 = 0 }
            oren_list_push(bs, b2)
            read_char(l)
        }
    }
    return oren_string_from_bytes(bs)
}

fn tok_lc(l, t, lit, start_pos, end_pos, line, col) {
    var out = token.new_token_pos(t, lit, start_pos, end_pos, l["file"])
    out["line"] = line
    out["col"] = col
    return out
}

fn next_token(l) {
    // Stage2-native debugging: extremely low-overhead step tracing.
    // Avoids map bookkeeping, string comparisons, and repeated prints.
    var trace_step = _trace_lex_step_enabled()
    if trace_step == true { print("TRACE_LEX_STEP 0 enter") }
    skip_whitespace(l)
    if trace_step == true { print("TRACE_LEX_STEP 1 after_ws") }
    var ch = l["ch"]
    var start = l["position"]
    var start_line = l["line"]
    var start_col = l["col"]
    var b = _byte0(ch)
    if trace_step == true { print("TRACE_LEX_STEP 2 after_vars") }
    if trace_step == true { print("TRACE_LEX_STEP b=" + oren_int_to_string(b)) }

    if b == 38 { // '&'
        if _byte0(peek_char(l)) == 38 {
            var cur = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_AND, cur + "&", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_BITAND, ch, start, l["position"], start_line, start_col)
    }
    if b == 124 { // '|'
        if _byte0(peek_char(l)) == 124 {
            var cur2 = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_OR, cur2 + "|", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_BITOR, ch, start, l["position"], start_line, start_col)
    }
    if b == 94 { read_char(l); return tok_lc(l, token.TOK_BITXOR, ch, start, l["position"], start_line, start_col) } // '^'
    if b == 61 { // '='
        if _byte0(peek_char(l)) == 61 {
            var cur = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_EQ, cur + "=", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_ASSIGN, ch, start, l["position"], start_line, start_col)
    }
    if b == 58 { // ':'
        if _byte0(peek_char(l)) == 61 {
            var cur = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_DECLARE, cur + "=", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_COLON, ch, start, l["position"], start_line, start_col)
    }
    if b == 43 { read_char(l); return tok_lc(l, token.TOK_PLUS, ch, start, l["position"], start_line, start_col) } // '+'
    if b == 45 { read_char(l); return tok_lc(l, token.TOK_MINUS, ch, start, l["position"], start_line, start_col) } // '-'
    if b == 126 { read_char(l); return tok_lc(l, token.TOK_TILDE, ch, start, l["position"], start_line, start_col) } // '~'
    if b == 37 { read_char(l); return tok_lc(l, token.TOK_PERCENT, ch, start, l["position"], start_line, start_col) } // '%'
    if b == 33 { // '!'
        if _byte0(peek_char(l)) == 61 {
            var curb = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_NOT_EQ, curb + "=", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_BANG, ch, start, l["position"], start_line, start_col)
    }
    if b == 47 { // '/'
        // Doc comment: `/// ...`
        //
        // Emitted as a token so the parser can attach it to the next declaration
        // and export it in metadata deterministically.
        if _byte0(peek_char(l)) == 47 && _byte0(peek_char2(l)) == 47 {
            read_char(l) // consume first '/'
            read_char(l) // consume second '/'
            read_char(l) // consume third '/'
            var text = read_line_comment_text(l)
            text = trim_one_leading_space(text)
            // Do not consume the \\n here; `skip_whitespace` will handle it.
            return tok_lc(l, token.TOK_DOC, text, start, l["position"], start_line, start_col)
        }
        if _byte0(peek_char(l)) == 47 {
            skip_comment(l)
            return next_token(l)
        }
        if _byte0(peek_char(l)) == 42 {
            read_char(l) // consume /
            read_char(l) // consume *
            skip_block_comment(l)
            return next_token(l)
        }
        read_char(l)
        return tok_lc(l, token.TOK_SLASH, ch, start, l["position"], start_line, start_col)
    }
    if b == 42 { read_char(l); return tok_lc(l, token.TOK_ASTERISK, ch, start, l["position"], start_line, start_col) } // '*'
    if b == 60 { // '<'
        if _byte0(peek_char(l)) == 61 {
            var curc = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_LTE, curc + "=", start, l["position"], start_line, start_col)
        }
        if _byte0(peek_char(l)) == 60 {
            var curshl = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_SHL, curshl + "<", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_LT, ch, start, l["position"], start_line, start_col)
    }
    if b == 62 { // '>'
        if _byte0(peek_char(l)) == 61 {
            var curd = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_GTE, curd + "=", start, l["position"], start_line, start_col)
        }
        if _byte0(peek_char(l)) == 62 {
            var curshr = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_SHR, curshr + ">", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_GT, ch, start, l["position"], start_line, start_col)
    }
    if b == 59 { read_char(l); return tok_lc(l, token.TOK_SEMICOLON, ch, start, l["position"], start_line, start_col) } // ';'
    if b == 64 { read_char(l); return tok_lc(l, token.TOK_AT, ch, start, l["position"], start_line, start_col) } // '@'
    if b == 46 { // '.'
        // Ellipsis for call-site spread: f(xs...)
        if _byte0(peek_char(l)) == 46 && _byte0(peek_char2(l)) == 46 {
            read_char(l) // second '.'
            read_char(l) // third '.'
            read_char(l)
            return tok_lc(l, token.TOK_ELLIPSIS, "...", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_DOT, ch, start, l["position"], start_line, start_col)
    }
    if b == 44 { read_char(l); return tok_lc(l, token.TOK_COMMA, ch, start, l["position"], start_line, start_col) } // ','
    if b == 40 { // '('
        if trace_step == true { print("TRACE_LEX_STEP lp_before_read") }
        read_char(l)
        if trace_step == true { print("TRACE_LEX_STEP lp_after_read") }
        if trace_step == true { print("TRACE_LEX_STEP lp_before_tok") }
        var t_lp = tok_lc(l, token.TOK_LPAREN, ch, start, l["position"], start_line, start_col)
        if trace_step == true { print("TRACE_LEX_STEP lp_after_tok") }
        return t_lp
    }
    if b == 41 { read_char(l); return tok_lc(l, token.TOK_RPAREN, ch, start, l["position"], start_line, start_col) } // ')'
    if b == 123 { read_char(l); return tok_lc(l, token.TOK_LBRACE, ch, start, l["position"], start_line, start_col) } // '{'
    if b == 125 { read_char(l); return tok_lc(l, token.TOK_RBRACE, ch, start, l["position"], start_line, start_col) } // '}'
    if b == 91 { read_char(l); return tok_lc(l, token.TOK_LBRACKET, ch, start, l["position"], start_line, start_col) } // '['
    if b == 93 { read_char(l); return tok_lc(l, token.TOK_RBRACKET, ch, start, l["position"], start_line, start_col) } // ']'
    if b == 34 {
        var str = read_string(l)
        read_char(l)
        return tok_lc(l, token.TOK_STRING, str, start, l["position"], start_line, start_col)
    }
    if b < 0 {
        return tok_lc(l, token.TOK_EOF, "", start, start, start_line, start_col)
    }

    if trace_step == true { print("TRACE_LEX_STEP 3 before_ident_digit") }
    var is_letter = _is_letter_b(b)
    if is_letter {
        if trace_step == true { print("TRACE_LEX_STEP 4 ident") }
        var ident = read_identifier(l)
        if trace_step == true { print("TRACE_LEX_STEP 5 ident_done") }
        return tok_lc(l, token.lookup_ident(ident), ident, start, l["position"], start_line, start_col)
    }

    var is_digit = _is_digit_b(b)
    if is_digit {
        if trace_step == true { print("TRACE_LEX_STEP 6 number") }
        // Numeric literals (rolling):
        // - decimal int/float: allow `_` separators (ignored)
        // - ints: allow base prefixes 0x, 0b, 0o (also allow `_` separators)
        //
        // NOTE: negative numbers remain a prefix expression (`-` token + INT).
        if ch == "0" {
            var p = peek_char(l)
            if p == "x" || p == "X" {
                read_char(l) // consume '0'
                read_char(l) // consume 'x'
                var hex = read_hex_number(l)
                if hex == "" { return tok_lc(l, token.TOK_ILLEGAL, "0x", start, l["position"], start_line, start_col) }
                return tok_lc(l, token.TOK_INT, "0x" + hex, start, l["position"], start_line, start_col)
            }
            if p == "b" || p == "B" {
                read_char(l) // consume '0'
                read_char(l) // consume 'b'
                var bin = read_bin_number(l)
                if bin == "" { return tok_lc(l, token.TOK_ILLEGAL, "0b", start, l["position"], start_line, start_col) }
                return tok_lc(l, token.TOK_INT, "0b" + bin, start, l["position"], start_line, start_col)
            }
            if p == "o" || p == "O" {
                read_char(l) // consume '0'
                read_char(l) // consume 'o'
                var oct = read_oct_number(l)
                if oct == "" { return tok_lc(l, token.TOK_ILLEGAL, "0o", start, l["position"], start_line, start_col) }
                return tok_lc(l, token.TOK_INT, "0o" + oct, start, l["position"], start_line, start_col)
            }
        }

        var num = read_number(l)

        var lit = num
        var is_float = false

        // Decimal fraction: 123.456
        if l["ch"] == "." && _is_digit_b(_byte0(peek_char(l))) {
            is_float = true
            read_char(l)
            var frac = read_number(l)
            lit = lit + "." + frac
        }

        // Scientific notation: 1e3, 1e-12, 12.5E+2
        if l["ch"] == "e" || l["ch"] == "E" {
            is_float = true
            var e = l["ch"]
            read_char(l) // consume e/E
            var sign = ""
            if l["ch"] == "+" || l["ch"] == "-" {
                sign = l["ch"]
                read_char(l)
            }
            if !_is_digit_b(_byte0(l["ch"])) {
                // Reject invalid forms like `1e` / `1e+` deterministically.
                return tok_lc(l, token.TOK_ILLEGAL, lit + e + sign, start, l["position"], start_line, start_col)
            }
            var exp = read_exponent(l)
            lit = lit + e + sign + exp
        }

        if is_float { return tok_lc(l, token.TOK_FLOAT, lit, start, l["position"], start_line, start_col) }
        return tok_lc(l, token.TOK_INT, lit, start, l["position"], start_line, start_col)
    }
    read_char(l)
    return tok_lc(l, token.TOK_ILLEGAL, ch, start, l["position"], start_line, start_col)
}
