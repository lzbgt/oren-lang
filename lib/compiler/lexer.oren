import token "token.oren"

fn new_lexer(input) {
    // `file` is optional and should be set by the caller when lexing a real module,
    // so tokens can carry location info for diagnostics.
    // Track 1-based line/col for the current character at `position`.
    // This enables cheap deterministic diagnostics without rescanning the source.
    var l = {"input": input, "position": 0, "read_position": 0, "ch": "", "file": nil, "line": 1, "col": 1}
    read_char(l)
    return l
}

fn read_char(l) {
    // Advance line/col based on the previous current character.
    var prev = l["ch"]
    if prev != "" {
        if prev == token.CH_LF {
            l["line"] = l["line"] + 1
            l["col"] = 1
        } else {
            l["col"] = l["col"] + 1
        }
    }

    var input_len = oren_string_len(l["input"])
    if l["read_position"] >= input_len {
        l["ch"] = ""
    } else {
        l["ch"] = oren_string_char_at(l["input"], l["read_position"])
    }
    l["position"] = l["read_position"]
    l["read_position"] = l["read_position"] + 1
}

fn peek_char(l) {
    var input_len = oren_string_len(l["input"])
    if l["read_position"] >= input_len {
        return ""
    }
    return oren_string_char_at(l["input"], l["read_position"])
}

fn peek_char2(l) {
    var input_len = oren_string_len(l["input"])
    var pos = l["read_position"] + 1
    if pos >= input_len { return "" }
    return oren_string_char_at(l["input"], pos)
}

fn skip_whitespace(l) {
    while token.is_whitespace(l["ch"]) {
        read_char(l)
    }
}

fn skip_comment(l) {
    while l["ch"] != "" {
        if l["ch"] == token.CH_LF { return nil }
        read_char(l)
    }
    return nil
}

fn read_line_comment_text(l) {
    // Read until '\n' or EOF, leaving l["ch"] on '\n' or "".
    var out = ""
    while l["ch"] != "" {
        if l["ch"] == token.CH_LF { return out }
        out = out + l["ch"]
        read_char(l)
    }
    return out
}

fn trim_one_leading_space(s) {
    if s == nil { return s }
    if oren_string_len(s) == 0 { return s }
    if oren_string_char_at(s, 0) == " " { return oren_string_slice(s, 1, oren_string_len(s)) }
    return s
}

fn skip_block_comment(l) {
    // We already consumed the opening '/' and '*'
    var depth = 1
    while l["ch"] != "" && depth > 0 {
        if l["ch"] == "/" {
            if peek_char(l) == "*" {
                read_char(l)
                read_char(l)
                depth = depth + 1
                // Continue loop
            } else {
                read_char(l)
            }
        } else {
            if l["ch"] == "*" {
                if peek_char(l) == "/" {
                    read_char(l)
                    read_char(l)
                    depth = depth - 1
                } else {
                    read_char(l)
                }
            } else {
                read_char(l)
            }
        }
    }
    return nil
}

fn read_identifier(l) {
    var out = ""
    while token.is_letter(l["ch"]) || token.is_digit(l["ch"]) {
        out = out + l["ch"]
        read_char(l)
    }
    return out
}

fn read_number(l) {
    var out = ""
    while token.is_digit(l["ch"]) {
        out = out + l["ch"]
        read_char(l)
    }
    return out
}

fn read_string(l) {
    // opening quote already consumed
    var out = ""
    read_char(l)
    while l["ch"] != token.CH_QUOTE {
        if l["ch"] == "" { return out }
        if l["ch"] == token.CH_BACKSLASH {
            read_char(l)
            if l["ch"] == "" { return out }
            var escaped = ""
            if l["ch"] == "n" { escaped = token.CH_LF }
            if l["ch"] == "r" { escaped = token.CH_CR }
            if l["ch"] == "t" { escaped = token.CH_TAB }
            if l["ch"] == token.CH_QUOTE { escaped = token.CH_QUOTE }
            if l["ch"] == token.CH_BACKSLASH { escaped = token.CH_BACKSLASH }
            if escaped == "" { escaped = l["ch"] }
            out = out + escaped
            read_char(l)
        } else {
            out = out + l["ch"]
            read_char(l)
        }
    }
    return out
}

fn tok_lc(l, t, lit, start_pos, end_pos, line, col) {
    var out = token.new_token_pos(t, lit, start_pos, end_pos, l["file"])
    out["line"] = line
    out["col"] = col
    return out
}

fn next_token(l) {
    skip_whitespace(l)
    var ch = l["ch"]
    var start = l["position"]
    var start_line = l["line"]
    var start_col = l["col"]

    if ch == "&" {
        if peek_char(l) == "&" {
            var cur = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_AND, cur + "&", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_BITAND, "&", start, l["position"], start_line, start_col)
    }
    if ch == "|" {
        if peek_char(l) == "|" {
            var cur2 = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_OR, cur2 + "|", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_BITOR, "|", start, l["position"], start_line, start_col)
    }
    if ch == "^" { read_char(l); return tok_lc(l, token.TOK_BITXOR, "^", start, l["position"], start_line, start_col) }
    if ch == "=" {
        if peek_char(l) == "=" {
            var cur = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_EQ, cur + "=", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_ASSIGN, "=", start, l["position"], start_line, start_col)
    }
    if ch == ":" {
        if peek_char(l) == "=" {
            var cur = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_DECLARE, cur + "=", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_COLON, ":", start, l["position"], start_line, start_col)
    }
    if ch == "+" { read_char(l); return tok_lc(l, token.TOK_PLUS, "+", start, l["position"], start_line, start_col) }
    if ch == "-" { read_char(l); return tok_lc(l, token.TOK_MINUS, "-", start, l["position"], start_line, start_col) }
    if ch == "~" { read_char(l); return tok_lc(l, token.TOK_TILDE, "~", start, l["position"], start_line, start_col) }
    if ch == "!" {
        if peek_char(l) == "=" {
            var curb = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_NOT_EQ, curb + "=", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_BANG, "!", start, l["position"], start_line, start_col)
    }
    if ch == "/" {
        // Doc comment: `/// ...`
        //
        // Emitted as a token so the parser can attach it to the next declaration
        // and export it in metadata deterministically.
        if peek_char(l) == "/" && peek_char2(l) == "/" {
            read_char(l) // consume first '/'
            read_char(l) // consume second '/'
            read_char(l) // consume third '/'
            var text = read_line_comment_text(l)
            text = trim_one_leading_space(text)
            // Do not consume the \\n here; `skip_whitespace` will handle it.
            return tok_lc(l, token.TOK_DOC, text, start, l["position"], start_line, start_col)
        }
        if peek_char(l) == "/" {
            skip_comment(l)
            return next_token(l)
        }
        if peek_char(l) == "*" {
            read_char(l) // consume /
            read_char(l) // consume *
            skip_block_comment(l)
            return next_token(l)
        }
        read_char(l)
        return tok_lc(l, token.TOK_SLASH, "/", start, l["position"], start_line, start_col)
    }
    if ch == "*" { read_char(l); return tok_lc(l, token.TOK_ASTERISK, "*", start, l["position"], start_line, start_col) }
    if ch == "<" {
        if peek_char(l) == "=" {
            var curc = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_LTE, curc + "=", start, l["position"], start_line, start_col)
        }
        if peek_char(l) == "<" {
            var curshl = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_SHL, curshl + "<", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_LT, "<", start, l["position"], start_line, start_col)
    }
    if ch == ">" {
        if peek_char(l) == "=" {
            var curd = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_GTE, curd + "=", start, l["position"], start_line, start_col)
        }
        if peek_char(l) == ">" {
            var curshr = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_SHR, curshr + ">", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_GT, ">", start, l["position"], start_line, start_col)
    }
    if ch == ";" { read_char(l); return tok_lc(l, token.TOK_SEMICOLON, ";", start, l["position"], start_line, start_col) }
    if ch == "@" { read_char(l); return tok_lc(l, token.TOK_AT, "@", start, l["position"], start_line, start_col) }
    if ch == "." {
        // Ellipsis for call-site spread: f(xs...)
        if peek_char(l) == "." && peek_char2(l) == "." {
            read_char(l) // second '.'
            read_char(l) // third '.'
            read_char(l)
            return tok_lc(l, token.TOK_ELLIPSIS, "...", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_DOT, ".", start, l["position"], start_line, start_col)
    }
    if ch == "," { read_char(l); return tok_lc(l, token.TOK_COMMA, ",", start, l["position"], start_line, start_col) }
    if ch == "(" { read_char(l); return tok_lc(l, token.TOK_LPAREN, "(", start, l["position"], start_line, start_col) }
    if ch == ")" { read_char(l); return tok_lc(l, token.TOK_RPAREN, ")", start, l["position"], start_line, start_col) }
    if ch == "{" { read_char(l); return tok_lc(l, token.TOK_LBRACE, "{", start, l["position"], start_line, start_col) }
    if ch == "}" { read_char(l); return tok_lc(l, token.TOK_RBRACE, "}", start, l["position"], start_line, start_col) }
    if ch == "[" { read_char(l); return tok_lc(l, token.TOK_LBRACKET, "[", start, l["position"], start_line, start_col) }
    if ch == "]" { read_char(l); return tok_lc(l, token.TOK_RBRACKET, "]", start, l["position"], start_line, start_col) }
    if ch == token.CH_QUOTE {
        var str = read_string(l)
        read_char(l)
        return tok_lc(l, token.TOK_STRING, str, start, l["position"], start_line, start_col)
    }
    if ch == "" {
        return tok_lc(l, token.TOK_EOF, "", start, start, start_line, start_col)
    }
    if token.is_letter(ch) {
        var ident = read_identifier(l)
        return tok_lc(l, token.lookup_ident(ident), ident, start, l["position"], start_line, start_col)
    }
    if token.is_digit(ch) {
        var num = read_number(l)
        if l["ch"] == "." {
            read_char(l)
            var frac = read_number(l)
            return tok_lc(l, token.TOK_FLOAT, num + "." + frac, start, l["position"], start_line, start_col)
        }
        return tok_lc(l, token.TOK_INT, num, start, l["position"], start_line, start_col)
    }
    read_char(l)
    return tok_lc(l, token.TOK_ILLEGAL, ch, start, l["position"], start_line, start_col)
}
