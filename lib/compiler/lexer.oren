import token "token.oren"

fn new_lexer(input) {
    // `file` is optional and should be set by the caller when lexing a real module,
    // so tokens can carry location info for diagnostics.
    // Track 1-based line/col for the current character at `position`.
    // This enables cheap deterministic diagnostics without rescanning the source.
    if input == nil { input = "" }
    var l = {"input": input, "input_len": oren_string_len(input), "position": 0, "read_position": 0, "ch": "", "file": nil, "line": 1, "col": 1}
    read_char(l)
    return l
}

fn read_char(l) {
    // Advance line/col based on the previous current character.
    var prev = l["ch"]
    if prev != "" {
        if prev == token.CH_LF {
            l["line"] = l["line"] + 1
            l["col"] = 1
        } else {
            l["col"] = l["col"] + 1
        }
    }

    var input_len = l["input_len"]
    if l["read_position"] >= input_len {
        l["ch"] = ""
    } else {
        // PERF: caller already bounds-checks against `input_len`, so avoid `char_at`'s
        // per-call length scan (O(n) `strlen` on C backend, O(n) byte scan on native).
        l["ch"] = oren_string_char_at_unchecked(l["input"], l["read_position"])
    }
    l["position"] = l["read_position"]
    l["read_position"] = l["read_position"] + 1
}

fn peek_char(l) {
    var input_len = l["input_len"]
    if l["read_position"] >= input_len {
        return ""
    }
    return oren_string_char_at_unchecked(l["input"], l["read_position"])
}

fn peek_char2(l) {
    var input_len = l["input_len"]
    var pos = l["read_position"] + 1
    if pos >= input_len { return "" }
    return oren_string_char_at_unchecked(l["input"], pos)
}

fn _byte0(ch) {
    if ch == nil { return -1 }
    if ch == "" { return -1 }
    return oren_string_char_code_at(ch, 0)
}

fn _is_letter_b(b) {
    if b < 0 { return false }
    if b == 95 { return true } // '_'
    if b >= 65 && b <= 90 { return true }  // A..Z
    if b >= 97 && b <= 122 { return true } // a..z
    return false
}

fn _is_digit_b(b) {
    if b < 0 { return false }
    if b >= 48 && b <= 57 { return true } // 0..9
    return false
}

fn skip_whitespace(l) {
    // Never spin at EOF even if `token.is_whitespace("")` ever regresses.
    // Keep the logic branchy (no `&&`) so it is easy for the native backends to lower correctly.
    while l["ch"] != "" {
        if token.is_whitespace(l["ch"]) {
            read_char(l)
        } else {
            break
        }
    }
}

fn skip_comment(l) {
    while l["ch"] != "" {
        if l["ch"] == token.CH_LF { return nil }
        read_char(l)
    }
    return nil
}

fn read_line_comment_text(l) {
    // Read until '\n' or EOF, leaving l["ch"] on '\n' or "".
    var start = l["position"]
    while l["ch"] != "" {
        if l["ch"] == token.CH_LF { return oren_string_slice(l["input"], start, l["position"]) }
        read_char(l)
    }
    return oren_string_slice(l["input"], start, l["position"])
}

fn _join_parts(parts) {
    if parts == nil { return "" }
    if oren_list_len(parts) == 0 { return "" }
    var cur = parts
    while oren_list_len(cur) > 1 {
        var next = []
        var i = 0
        var n = oren_list_len(cur)
        while i < n {
            if i + 1 < n {
                oren_list_push(next, cur[i] + cur[i + 1])
            } else {
                oren_list_push(next, cur[i])
            }
            i = i + 2
        }
        cur = next
    }
    return cur[0]
}

fn _strip_underscores(s) {
    if s == nil { return "" }
    var n = oren_string_len(s)
    if n == 0 { return s }

    // Fast path: no underscores.
    var has = false
    var i = 0
    while i < n {
        if oren_string_char_at(s, i) == "_" { has = true; break }
        i = i + 1
    }
    if has == false { return s }

    var parts = []
    var seg_start = 0
    i = 0
    while i < n {
        if oren_string_char_at(s, i) == "_" {
            if seg_start < i {
                oren_list_push(parts, oren_string_slice(s, seg_start, i))
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    if seg_start < n {
        oren_list_push(parts, oren_string_slice(s, seg_start, n))
    }
    return _join_parts(parts)
}

fn trim_one_leading_space(s) {
    if s == nil { return s }
    if oren_string_len(s) == 0 { return s }
    if oren_string_char_at(s, 0) == " " { return oren_string_slice(s, 1, oren_string_len(s)) }
    return s
}

fn skip_block_comment(l) {
    // We already consumed the opening '/' and '*'
    var depth = 1
    while l["ch"] != "" && depth > 0 {
        if l["ch"] == "/" {
            if peek_char(l) == "*" {
                read_char(l)
                read_char(l)
                depth = depth + 1
                // Continue loop
            } else {
                read_char(l)
            }
        } else {
            if l["ch"] == "*" {
                if peek_char(l) == "/" {
                    read_char(l)
                    read_char(l)
                    depth = depth - 1
                } else {
                    read_char(l)
                }
            } else {
                read_char(l)
            }
        }
    }
    return nil
}

fn read_identifier(l) {
    var start = l["position"]
    var do_trace = false
    var trace = oren_env("OREN_TRACE_LEX")
    if trace != nil && trace != "" { do_trace = true }
    var guard = 0
    while _is_letter_b(_byte0(l["ch"])) || _is_digit_b(_byte0(l["ch"])) {
        if do_trace {
            if guard == 0 {
                print("TRACE_LEX read_identifier start_pos=" + oren_int_to_string(start) + " ch=" + l["ch"])
            }
            guard = guard + 1
            if guard > 1000000 {
                print("lexer read_identifier: exceeded 1,000,000 iterations (likely stuck at EOF)")
                exit(299)
            }
        }
        read_char(l)
    }
    return oren_string_slice(l["input"], start, l["position"])
}

fn read_number(l) {
    var start = l["position"]
    var do_trace = false
    var trace = oren_env("OREN_TRACE_LEX")
    if trace != nil && trace != "" { do_trace = true }
    var guard = 0
    while _is_digit_b(_byte0(l["ch"])) || l["ch"] == "_" {
        if do_trace {
            if guard == 0 {
                print("TRACE_LEX read_number start_pos=" + oren_int_to_string(start) + " ch=" + l["ch"])
            }
            guard = guard + 1
            if guard > 1000000 {
                print("lexer read_number: exceeded 1,000,000 iterations (likely stuck at EOF)")
                exit(298)
            }
        }
        read_char(l)
    }
    var raw = oren_string_slice(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn read_exponent(l) {
    // Read scientific exponent digits (after optional +/-, allowing `_` separators).
    // Caller has already consumed the 'e'/'E' and optional sign, and expects at least one digit.
    var start = l["position"]
    while token.is_digit(l["ch"]) || l["ch"] == "_" {
        read_char(l)
    }
    var raw = oren_string_slice(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn is_hex_digit(ch) {
    if ch == "" { return false }
    var b = _byte0(ch)
    if _is_digit_b(b) { return true }
    if b >= 97 && b <= 102 { return true } // a..f
    if b >= 65 && b <= 70 { return true }  // A..F
    return false
}

fn read_hex_number(l) {
    var start = l["position"]
    while is_hex_digit(l["ch"]) || l["ch"] == "_" {
        read_char(l)
    }
    var raw = oren_string_slice(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn read_bin_number(l) {
    var start = l["position"]
    while l["ch"] == "0" || l["ch"] == "1" || l["ch"] == "_" {
        read_char(l)
    }
    var raw = oren_string_slice(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn read_oct_number(l) {
    var start = l["position"]
    while 1 {
        var ch = l["ch"]
        var is_oct = false
        if ch != "" {
            var b = oren_string_char_code_at(ch, 0)
            if b >= 48 && b <= 55 { is_oct = true }
        }
        if is_oct || ch == "_" {
            read_char(l)
        } else {
            break
        }
    }
    var raw = oren_string_slice(l["input"], start, l["position"])
    return _strip_underscores(raw)
}

fn read_string(l) {
    // opening quote already consumed
    var out = ""
    read_char(l)
    while l["ch"] != token.CH_QUOTE {
        if l["ch"] == "" { return out }
        if l["ch"] == token.CH_BACKSLASH {
            read_char(l)
            if l["ch"] == "" { return out }
            var escaped = ""
            if l["ch"] == "n" { escaped = token.CH_LF }
            if l["ch"] == "r" { escaped = token.CH_CR }
            if l["ch"] == "t" { escaped = token.CH_TAB }
            if l["ch"] == token.CH_QUOTE { escaped = token.CH_QUOTE }
            if l["ch"] == token.CH_BACKSLASH { escaped = token.CH_BACKSLASH }
            if escaped == "" { escaped = l["ch"] }
            out = out + escaped
            read_char(l)
        } else {
            out = out + l["ch"]
            read_char(l)
        }
    }
    return out
}

fn tok_lc(l, t, lit, start_pos, end_pos, line, col) {
    var out = token.new_token_pos(t, lit, start_pos, end_pos, l["file"])
    out["line"] = line
    out["col"] = col
    return out
}

fn next_token(l) {
    var trace = oren_env("OREN_TRACE_LEX")
    if trace != nil && trace != "" {
        var n0 = l["_trace_lex_n"]
        if n0 == nil { n0 = 0 }
        if n0 < 1 {
            print("TRACE_LEX enter pos=" + oren_int_to_string(l["position"]) + " rp=" + oren_int_to_string(l["read_position"]) + " ch=" + l["ch"])
            l["_trace_lex_n"] = n0 + 1
        }
    }
    skip_whitespace(l)
    if trace != nil && trace != "" {
        var n1 = l["_trace_lex_n"]
        if n1 == nil { n1 = 0 }
        if n1 < 2 {
            print("TRACE_LEX after_ws pos=" + oren_int_to_string(l["position"]) + " rp=" + oren_int_to_string(l["read_position"]) + " ch=" + l["ch"])
            l["_trace_lex_n"] = n1 + 1
        }
    }
    var ch = l["ch"]
    var start = l["position"]
    var start_line = l["line"]
    var start_col = l["col"]
    var b = _byte0(ch)

    if trace != nil && trace != "" {
        var n4 = l["_trace_lex_n4"]
        if n4 == nil { n4 = 0 }
        if n4 < 1 {
            print("TRACE_LEX after_vars start=" + oren_int_to_string(start) + " line=" + oren_int_to_string(start_line) + " col=" + oren_int_to_string(start_col) + " ch=" + ch + " b=" + oren_int_to_string(b))
            l["_trace_lex_n4"] = n4 + 1
        }
    }

    if b == 38 { // '&'
        if _byte0(peek_char(l)) == 38 {
            var cur = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_AND, cur + "&", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_BITAND, "&", start, l["position"], start_line, start_col)
    }
    if b == 124 { // '|'
        if _byte0(peek_char(l)) == 124 {
            var cur2 = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_OR, cur2 + "|", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_BITOR, "|", start, l["position"], start_line, start_col)
    }
    if b == 94 { read_char(l); return tok_lc(l, token.TOK_BITXOR, "^", start, l["position"], start_line, start_col) } // '^'
    if b == 61 { // '='
        if _byte0(peek_char(l)) == 61 {
            var cur = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_EQ, cur + "=", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_ASSIGN, "=", start, l["position"], start_line, start_col)
    }
    if b == 58 { // ':'
        if _byte0(peek_char(l)) == 61 {
            var cur = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_DECLARE, cur + "=", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_COLON, ":", start, l["position"], start_line, start_col)
    }
    if b == 43 { read_char(l); return tok_lc(l, token.TOK_PLUS, "+", start, l["position"], start_line, start_col) } // '+'
    if b == 45 { read_char(l); return tok_lc(l, token.TOK_MINUS, "-", start, l["position"], start_line, start_col) } // '-'
    if b == 126 { read_char(l); return tok_lc(l, token.TOK_TILDE, "~", start, l["position"], start_line, start_col) } // '~'
    if b == 37 { read_char(l); return tok_lc(l, token.TOK_PERCENT, "%", start, l["position"], start_line, start_col) } // '%'
    if b == 33 { // '!'
        if _byte0(peek_char(l)) == 61 {
            var curb = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_NOT_EQ, curb + "=", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_BANG, "!", start, l["position"], start_line, start_col)
    }
    if b == 47 { // '/'
        // Doc comment: `/// ...`
        //
        // Emitted as a token so the parser can attach it to the next declaration
        // and export it in metadata deterministically.
        if _byte0(peek_char(l)) == 47 && _byte0(peek_char2(l)) == 47 {
            read_char(l) // consume first '/'
            read_char(l) // consume second '/'
            read_char(l) // consume third '/'
            var text = read_line_comment_text(l)
            text = trim_one_leading_space(text)
            // Do not consume the \\n here; `skip_whitespace` will handle it.
            return tok_lc(l, token.TOK_DOC, text, start, l["position"], start_line, start_col)
        }
        if _byte0(peek_char(l)) == 47 {
            skip_comment(l)
            return next_token(l)
        }
        if _byte0(peek_char(l)) == 42 {
            read_char(l) // consume /
            read_char(l) // consume *
            skip_block_comment(l)
            return next_token(l)
        }
        read_char(l)
        return tok_lc(l, token.TOK_SLASH, "/", start, l["position"], start_line, start_col)
    }
    if b == 42 { read_char(l); return tok_lc(l, token.TOK_ASTERISK, "*", start, l["position"], start_line, start_col) } // '*'
    if b == 60 { // '<'
        if _byte0(peek_char(l)) == 61 {
            var curc = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_LTE, curc + "=", start, l["position"], start_line, start_col)
        }
        if _byte0(peek_char(l)) == 60 {
            var curshl = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_SHL, curshl + "<", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_LT, "<", start, l["position"], start_line, start_col)
    }
    if b == 62 { // '>'
        if _byte0(peek_char(l)) == 61 {
            var curd = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_GTE, curd + "=", start, l["position"], start_line, start_col)
        }
        if _byte0(peek_char(l)) == 62 {
            var curshr = ch
            read_char(l)
            read_char(l)
            return tok_lc(l, token.TOK_SHR, curshr + ">", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_GT, ">", start, l["position"], start_line, start_col)
    }
    if b == 59 { read_char(l); return tok_lc(l, token.TOK_SEMICOLON, ";", start, l["position"], start_line, start_col) } // ';'
    if b == 64 { read_char(l); return tok_lc(l, token.TOK_AT, "@", start, l["position"], start_line, start_col) } // '@'
    if b == 46 { // '.'
        // Ellipsis for call-site spread: f(xs...)
        if _byte0(peek_char(l)) == 46 && _byte0(peek_char2(l)) == 46 {
            read_char(l) // second '.'
            read_char(l) // third '.'
            read_char(l)
            return tok_lc(l, token.TOK_ELLIPSIS, "...", start, l["position"], start_line, start_col)
        }
        read_char(l)
        return tok_lc(l, token.TOK_DOT, ".", start, l["position"], start_line, start_col)
    }
    if b == 44 { read_char(l); return tok_lc(l, token.TOK_COMMA, ",", start, l["position"], start_line, start_col) } // ','
    if b == 40 { read_char(l); return tok_lc(l, token.TOK_LPAREN, "(", start, l["position"], start_line, start_col) } // '('
    if b == 41 { read_char(l); return tok_lc(l, token.TOK_RPAREN, ")", start, l["position"], start_line, start_col) } // ')'
    if b == 123 { read_char(l); return tok_lc(l, token.TOK_LBRACE, "{", start, l["position"], start_line, start_col) } // '{'
    if b == 125 { read_char(l); return tok_lc(l, token.TOK_RBRACE, "}", start, l["position"], start_line, start_col) } // '}'
    if b == 91 { read_char(l); return tok_lc(l, token.TOK_LBRACKET, "[", start, l["position"], start_line, start_col) } // '['
    if b == 93 { read_char(l); return tok_lc(l, token.TOK_RBRACKET, "]", start, l["position"], start_line, start_col) } // ']'
    if b == 34 {
        var str = read_string(l)
        read_char(l)
        return tok_lc(l, token.TOK_STRING, str, start, l["position"], start_line, start_col)
    }
    if b < 0 {
        return tok_lc(l, token.TOK_EOF, "", start, start, start_line, start_col)
    }

    if trace != nil && trace != "" {
        var n5 = l["_trace_lex_n5"]
        if n5 == nil { n5 = 0 }
        if n5 < 1 {
            print("TRACE_LEX before_is_letter")
            l["_trace_lex_n5"] = n5 + 1
        }
    }
    var is_letter = _is_letter_b(b)
    if trace != nil && trace != "" {
        var n2 = l["_trace_lex_n2"]
        if n2 == nil { n2 = 0 }
        if n2 < 1 {
            var s2 = "nil"
            if is_letter == true { s2 = "true" }
            if is_letter == false { s2 = "false" }
            print("TRACE_LEX is_letter=" + s2)
            l["_trace_lex_n2"] = n2 + 1
        }
    }
    if is_letter {
        var ident = read_identifier(l)
        return tok_lc(l, token.lookup_ident(ident), ident, start, l["position"], start_line, start_col)
    }

    var is_digit = _is_digit_b(b)
    if trace != nil && trace != "" {
        var n3 = l["_trace_lex_n3"]
        if n3 == nil { n3 = 0 }
        if n3 < 1 {
            var s3 = "nil"
            if is_digit == true { s3 = "true" }
            if is_digit == false { s3 = "false" }
            print("TRACE_LEX is_digit=" + s3)
            l["_trace_lex_n3"] = n3 + 1
        }
    }
    if is_digit {
        // Numeric literals (rolling):
        // - decimal int/float: allow `_` separators (ignored)
        // - ints: allow base prefixes 0x, 0b, 0o (also allow `_` separators)
        //
        // NOTE: negative numbers remain a prefix expression (`-` token + INT).
        if ch == "0" {
            var p = peek_char(l)
            if p == "x" || p == "X" {
                read_char(l) // consume '0'
                read_char(l) // consume 'x'
                var hex = read_hex_number(l)
                if hex == "" { return tok_lc(l, token.TOK_ILLEGAL, "0x", start, l["position"], start_line, start_col) }
                return tok_lc(l, token.TOK_INT, "0x" + hex, start, l["position"], start_line, start_col)
            }
            if p == "b" || p == "B" {
                read_char(l) // consume '0'
                read_char(l) // consume 'b'
                var bin = read_bin_number(l)
                if bin == "" { return tok_lc(l, token.TOK_ILLEGAL, "0b", start, l["position"], start_line, start_col) }
                return tok_lc(l, token.TOK_INT, "0b" + bin, start, l["position"], start_line, start_col)
            }
            if p == "o" || p == "O" {
                read_char(l) // consume '0'
                read_char(l) // consume 'o'
                var oct = read_oct_number(l)
                if oct == "" { return tok_lc(l, token.TOK_ILLEGAL, "0o", start, l["position"], start_line, start_col) }
                return tok_lc(l, token.TOK_INT, "0o" + oct, start, l["position"], start_line, start_col)
            }
        }

        var num = read_number(l)

        var lit = num
        var is_float = false

        // Decimal fraction: 123.456
        if l["ch"] == "." && _is_digit_b(_byte0(peek_char(l))) {
            is_float = true
            read_char(l)
            var frac = read_number(l)
            lit = lit + "." + frac
        }

        // Scientific notation: 1e3, 1e-12, 12.5E+2
        if l["ch"] == "e" || l["ch"] == "E" {
            is_float = true
            var e = l["ch"]
            read_char(l) // consume e/E
            var sign = ""
            if l["ch"] == "+" || l["ch"] == "-" {
                sign = l["ch"]
                read_char(l)
            }
            if !_is_digit_b(_byte0(l["ch"])) {
                // Reject invalid forms like `1e` / `1e+` deterministically.
                return tok_lc(l, token.TOK_ILLEGAL, lit + e + sign, start, l["position"], start_line, start_col)
            }
            var exp = read_exponent(l)
            lit = lit + e + sign + exp
        }

        if is_float { return tok_lc(l, token.TOK_FLOAT, lit, start, l["position"], start_line, start_col) }
        return tok_lc(l, token.TOK_INT, lit, start, l["position"], start_line, start_col)
    }
    read_char(l)
    return tok_lc(l, token.TOK_ILLEGAL, ch, start, l["position"], start_line, start_col)
}
