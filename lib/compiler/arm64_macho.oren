import codegen "codegen_arm64.oren"
import core "arm64_core.oren"
import abi "arm64_abi_macos.oren"
import resolve "arm64_macho_resolve.oren"

fn arm64_ctx_fixup_got_load(ctx, pos, got_index) { return core.arm64_ctx_fixup_got_load(ctx, pos, got_index) }

fn macho_diag_escape(msg) {
    if msg == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(msg) {
        var c = oren_string_char_at(msg, i)
        if c == "\n" { out = out + "\\n"; i = i + 1; continue }
        if c == "\r" { out = out + "\\r"; i = i + 1; continue }
        if c == "\t" { out = out + "\\t"; i = i + 1; continue }
        out = out + c
        i = i + 1
    }
    return out
}

fn _macho_rtobj_fixups_count_compact(fx) {
    if fx == nil { return 0 }
    var n = 0
    if fx["bl_pos_enc"] != nil { n = n + oren_list_len(fx["bl_pos_enc"]) }
    if fx["adr_data_pos_enc"] != nil { n = n + oren_list_len(fx["adr_data_pos_enc"]) }
    if fx["adr_code_pos_enc"] != nil { n = n + oren_list_len(fx["adr_code_pos_enc"]) }
    return n
}

fn _macho_local_fixups_count_compact(fx) {
    if fx == nil { return 0 }
    var n = 0
    if fx["bl_pos"] != nil { n = n + oren_list_len(fx["bl_pos"]) }
    if fx["adr_data_pos"] != nil { n = n + oren_list_len(fx["adr_data_pos"]) }
    if fx["adr_code_pos"] != nil { n = n + oren_list_len(fx["adr_code_pos"]) }
    if fx["got_pos"] != nil { n = n + oren_list_len(fx["got_pos"]) }
    return n
}

fn _macho_local_fixup_value_eq(k, av, bv) {
    if av == bv { return true }
    if k == "bl_name" {
        if oren_type_tag(av) == 1 && resolve._macho_hot_bl_id_name(av) == bv { return true }
        if oren_type_tag(bv) == 1 && resolve._macho_hot_bl_id_name(bv) == av { return true }
    }
    return false
}

fn _macho_local_fixups_compact_diff(a, b) {
    if a == nil && b == nil { return nil }
    if a == nil || b == nil { return "nil" }
    var keys = [
        "bl_pos", "bl_name",
        "adr_data_pos", "adr_data_off", "adr_data_reg",
        "adr_code_pos", "adr_code_name", "adr_code_reg",
        "got_pos", "got_index"
    ]
    var ki = 0
    while ki < oren_list_len(keys) {
        var k = keys[ki]
        var av = a[k]
        var bv = b[k]
        var an = 0
        var bn = 0
        if av != nil { an = oren_list_len(av) }
        if bv != nil { bn = oren_list_len(bv) }
        if an != bn {
            return k + ".len a=" + oren_int_to_string(an) + " b=" + oren_int_to_string(bn)
        }
        var i = 0
        while i < an {
            if _macho_local_fixup_value_eq(k, av[i], bv[i]) != true {
                return k + ".i=" + oren_int_to_string(i)
            }
            i = i + 1
        }
        ki = ki + 1
    }
    return nil
}

fn _macho_local_fixups_compact(fixups) {
    if fixups == nil { return nil }
    var bl_n = 0
    var adr_data_n = 0
    var adr_code_n = 0
    var got_n = 0
    var ci = 0
    while ci < oren_list_len(fixups) {
        var cf = fixups[ci]
        if cf != nil {
            var cpos = cf["pos"]
            if oren_type_tag(cpos) == 1 {
                var cty = cf["type"]
                if cty == "bl" {
                    if cf["name"] != nil { bl_n = bl_n + 1 }
                } else if cty == "adr_data" {
                    if oren_type_tag(cf["data_off"]) == 1 { adr_data_n = adr_data_n + 1 }
                } else if cty == "adr_code" {
                    if cf["name"] != nil { adr_code_n = adr_code_n + 1 }
                } else if cty == "got_load" {
                    if oren_type_tag(cf["got_index"]) == 1 { got_n = got_n + 1 }
                }
            }
        }
        ci = ci + 1
    }
    var bl_pos = oren_list_new_cap(bl_n); if oren_is_err(bl_pos) { bl_pos = [] }
    var bl_name = oren_list_new_cap(bl_n); if oren_is_err(bl_name) { bl_name = [] }
    var adr_data_pos = oren_list_new_cap(adr_data_n); if oren_is_err(adr_data_pos) { adr_data_pos = [] }
    var adr_data_off = oren_list_new_cap(adr_data_n); if oren_is_err(adr_data_off) { adr_data_off = [] }
    var adr_data_reg = oren_list_new_cap(adr_data_n); if oren_is_err(adr_data_reg) { adr_data_reg = [] }
    var adr_code_pos = oren_list_new_cap(adr_code_n); if oren_is_err(adr_code_pos) { adr_code_pos = [] }
    var adr_code_name = oren_list_new_cap(adr_code_n); if oren_is_err(adr_code_name) { adr_code_name = [] }
    var adr_code_reg = oren_list_new_cap(adr_code_n); if oren_is_err(adr_code_reg) { adr_code_reg = [] }
    var got_pos = oren_list_new_cap(got_n); if oren_is_err(got_pos) { got_pos = [] }
    var got_index = oren_list_new_cap(got_n); if oren_is_err(got_index) { got_index = [] }
    var i = 0
    while i < oren_list_len(fixups) {
        var fx = fixups[i]
        if fx != nil {
            var pos = fx["pos"]
            if oren_type_tag(pos) == 1 {
                var ty = fx["type"]
                if ty == "bl" {
                    var nm = fx["name"]
                    if nm != nil {
                        oren_list_push_unchecked(bl_pos, pos)
                        oren_list_push_unchecked(bl_name, nm)
                    }
                } else if ty == "adr_data" {
                    var data_off = fx["data_off"]
                    if oren_type_tag(data_off) == 1 {
                        oren_list_push_unchecked(adr_data_pos, pos)
                        oren_list_push_unchecked(adr_data_off, data_off)
                        var reg = fx["reg"]
                        if oren_type_tag(reg) == 1 { oren_list_push_unchecked(adr_data_reg, reg) }
                        else { oren_list_push_unchecked(adr_data_reg, 0) }
                    }
                } else if ty == "adr_code" {
                    var nm2 = fx["name"]
                    if nm2 != nil {
                        oren_list_push_unchecked(adr_code_pos, pos)
                        oren_list_push_unchecked(adr_code_name, nm2)
                        var reg2 = fx["reg"]
                        if oren_type_tag(reg2) == 1 { oren_list_push_unchecked(adr_code_reg, reg2) }
                        else { oren_list_push_unchecked(adr_code_reg, 0) }
                    }
                } else if ty == "got_load" {
                    var got_idx = fx["got_index"]
                    if oren_type_tag(got_idx) == 1 {
                        oren_list_push_unchecked(got_pos, pos)
                        oren_list_push_unchecked(got_index, got_idx)
                    }
                }
            }
        }
        i = i + 1
    }
    return {
        "bl_pos": bl_pos, "bl_name": bl_name,
        "adr_data_pos": adr_data_pos, "adr_data_off": adr_data_off, "adr_data_reg": adr_data_reg,
        "adr_code_pos": adr_code_pos, "adr_code_name": adr_code_name, "adr_code_reg": adr_code_reg,
        "got_pos": got_pos, "got_index": got_index
    }
}

fn _macho_phase_log_path() {
    var p = oren_env("OREN_TRACE_BUILD_PHASES_PATH")
    if p == nil || p == "" || p == "0" { return nil }
    return p
}

fn _macho_phase_log_append(path, phase, detail) {
    if path == nil || phase == nil || phase == "" { return nil }
    var line = "phase=" + phase + " now_ns=" + oren_int_to_string(oren_time_now_ns())
    if detail != nil && detail != "" { line = line + " " + detail }
    oren_append_file(path, line + "\n")
    return nil
}

fn _macho_read_u64_le_u8(ub, off) {
    if ub == nil { return nil }
    if oren_is_u8_buf(ub) != true { return nil }
    if off < 0 { return nil }
    var n = oren_buf_len(ub)
    if off + 7 >= n { return nil }
    var p = oren_buf_data_ptr_unchecked(ub)
    if p == 0 { return nil }
    var b0 = ptr_get_byte(iadd(p, off + 0)) & 255
    var b1 = ptr_get_byte(iadd(p, off + 1)) & 255
    var b2 = ptr_get_byte(iadd(p, off + 2)) & 255
    var b3 = ptr_get_byte(iadd(p, off + 3)) & 255
    var b4 = ptr_get_byte(iadd(p, off + 4)) & 255
    var b5 = ptr_get_byte(iadd(p, off + 5)) & 255
    var b6 = ptr_get_byte(iadd(p, off + 6)) & 255
    var b7 = ptr_get_byte(iadd(p, off + 7)) & 255
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216 +
           (b4 + b5 * 256 + b6 * 65536 + b7 * 16777216) * 4294967296
}

fn _macho_store_u64_le_ptr(dstp, off, n) {
    if dstp == 0 { return nil }
    ptr_set_byte(iadd(dstp, off + 0), int_mod(n, 256))
    ptr_set_byte(iadd(dstp, off + 1), int_mod(n / 256, 256))
    ptr_set_byte(iadd(dstp, off + 2), int_mod(n / 65536, 256))
    ptr_set_byte(iadd(dstp, off + 3), int_mod(n / 16777216, 256))
    var hi = n / 4294967296
    ptr_set_byte(iadd(dstp, off + 4), int_mod(hi, 256))
    ptr_set_byte(iadd(dstp, off + 5), int_mod(hi / 256, 256))
    ptr_set_byte(iadd(dstp, off + 6), int_mod(hi / 65536, 256))
    ptr_set_byte(iadd(dstp, off + 7), int_mod(hi / 16777216, 256))
    return nil
}

// Mach-O emitter for arm64 (Darwin).
// Single responsibility: take a linked program, call the arm64 native codegen,
// apply fixups, and write a Mach-O executable/shared library.
//
// This is intentionally separated from the core arm64 codegen to keep modules SOLID.

// ---- Mach-O constants (repo-owned; no SDK headers) ----
//
// Keep numeric constants fact-based and centralized so we don't depend on:
// - Xcode SDK headers (build dependency)
// - system-provided Mach-O headers (may change / may not exist in sandboxed environments)
//
// See also: docs/refs/* and docs/DESIGN.md#backend-outputs
fn macho_magic_64() { return 4277009103 } // 0xFEEDFACF
fn macho_cpu_type_arm64() { return 16777228 } // 0x0100000C

fn macho_filetype_execute() { return 2 } // MH_EXECUTE
fn macho_filetype_dylib() { return 6 } // MH_DYLIB

fn macho_header_flags_pie() { return 2097285 } // MH_NOUNDEFS|MH_DYLDLINK|MH_TWOLEVEL|MH_PIE

fn lc_segment_64() { return 25 } // LC_SEGMENT_64
fn lc_symtab() { return 2 } // LC_SYMTAB
fn lc_dyld_info_only() { return 2147483682 } // 0x80000022
fn lc_load_dylinker() { return 14 } // LC_LOAD_DYLINKER
fn lc_load_dylib() { return 12 } // LC_LOAD_DYLIB
fn lc_build_version() { return 50 } // LC_BUILD_VERSION
fn lc_uuid() { return 27 } // LC_UUID
fn lc_id_dylib() { return 13 } // LC_ID_DYLIB
fn lc_main() { return 2147483688 } // 0x80000028

fn cmdsize_segment_64() { return 72 } // sizeof(segment_command_64)
fn cmdsize_segment_64_one_section() { return 152 } // segment_command_64 + 1 section_64 (72 + 80)
fn cmdsize_uuid() { return 24 } // sizeof(uuid_command)
fn cmdsize_symtab() { return 24 } // sizeof(symtab_command)
fn cmdsize_dyld_info_only() { return 48 } // sizeof(dyld_info_command)
fn cmdsize_build_version() { return 24 } // sizeof(build_version_command), no tools
fn cmdsize_main() { return 24 } // sizeof(entry_point_command)

fn vmaddr_text_base() { return 4294967296 } // 0x100000000 (Mach-O arm64 default)
fn pagezero_vmsize() { return 4294967296 } // 4GB
fn u64_2_32() { return 4294967296 } // 2^32, used for MOVK lane extraction
fn u64_2_48() { return 281474976710656 } // 2^48, used for MOVK lane extraction
fn macho_header_size_default() { return 2048 }
fn macho_header_size_exit_stub() { return 632 } // minimal header for `macho_emit_exit_arm64` layout
fn macho_segment_align() { return 16384 } // 0x4000 (standard Mach-O page/segment alignment)
fn sect_flags_text() { return 2147484672 } // 0x80000400
fn prot_r() { return 1 }
fn prot_rw() { return 3 }
fn prot_rx() { return 5 }
fn sect_align_text_log2() { return 4 } // 2^4 = 16-byte alignment
fn sect_align_data_log2() { return 3 } // 2^3 = 8-byte alignment
fn dylinker_name_offset() { return 12 } // in LC_LOAD_DYLINKER command
fn dylib_name_offset() { return 24 } // in LC_LOAD_DYLIB / LC_ID_DYLIB commands
fn symtab_nlist_64_size() { return 16 } // sizeof(nlist_64)
fn u32_size() { return 4 }

fn version_pack(major, minor, patch) {
    // Mach-O packed version: (major << 16) | (minor << 8) | patch
    return major * 65536 + minor * 256 + patch
}

fn build_version_platform_macos() { return 1 }
fn build_version_minos_default() { return version_pack(12, 0, 0) } // macOS 12.0.0
fn build_version_sdk_default() { return version_pack(12, 0, 0) } // macOS 12.0.0


fn bind_set_dylib_flat_lookup() { return 62 } // 0x30|14 (BIND_OPCODE_SET_DYLIB_SPECIAL_IMM + flat lookup)
fn bind_set_type_pointer() { return 81 } // 0x50|1 (BIND_OPCODE_SET_TYPE_IMM + BIND_TYPE_POINTER)
fn bind_set_segment_data() { return 114 } // 0x70|2 (BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB, seg=__DATA)
fn bind_set_symbol_flags_0() { return 64 } // 0x40|0 (BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM)
fn bind_do_bind() { return 144 } // 0x90 (BIND_OPCODE_DO_BIND)
fn bind_done() { return 0 } // BIND_OPCODE_DONE

// ---- Thin wrappers into core codegen module (minimize churn) ----
fn bytes_new() { return codegen.bytes_new() }
fn bytes_push(b, v) { return codegen.bytes_push(b, v) }
fn bytes_extend(b, other) { return codegen.bytes_extend(b, other) }
fn bytes_extend_zeros(b, n) { return codegen.bytes_extend_zeros(b, n) }
fn bytes_extend_string(b, s) { return codegen.bytes_extend_string(b, s) }
fn bytes_extend_string_z(b, s) { return codegen.bytes_extend_string_z(b, s) }
fn bytes_len(b) { return codegen.bytes_len(b) }
fn bytes_finalize(b) { return codegen.bytes_finalize(b) }

fn push_u32_le(buf, n) { return codegen.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return codegen.push_u64_le(buf, n) }
fn set_u32_le(buf, offset, n) { return codegen.set_u32_le(buf, offset, n) }

fn align_up(n, align) { return codegen.align_up(n, align) }
fn int_mod(a, b) { return codegen.int_mod(a, b) }

fn insn_movz(reg, imm16) { return codegen.insn_movz(reg, imm16) }
fn insn_movk(reg, imm16, shift_idx) { return codegen.insn_movk(reg, imm16, shift_idx) }
fn insn_bl(off) { return codegen.insn_bl(off) }
fn insn_adrp(reg, imm_pages) { return codegen.insn_adrp(reg, imm_pages) }
fn insn_svc(imm) { return core.insn_svc(imm) }
fn insn_ldr_ptr(rd, rn) { return core.insn_ldr_ptr(rd, rn) }
fn insn_br(rn) { return core.insn_br(rn) }
fn insn_add_imm(rd, rn, imm) { return core.insn_add_imm(rd, rn, imm) }

fn native_compile_program_arm64(linked, platform) { return codegen.native_compile_program_arm64(linked, platform) }
fn native_emit_errors_and_exit(ctx) { return codegen.native_emit_errors_and_exit(ctx) }

// Local helper (moved out of codegen_arm64.oren)
fn push_u16_le(buf, n) {
    bytes_push(buf, int_mod(n, 256))
    bytes_push(buf, int_mod(n / 256, 256))
}

fn push_str_fixed16(buf, s) {
    // Write a Mach-O fixed-size 16-byte ASCII field (segname/sectname), NUL-padded.
    if s == nil { s = "" }
    var n = oren_string_len(s)
    if n > 16 { n = 16 }
    var i = 0
    while i < n {
        bytes_push(buf, oren_string_byte_at_unchecked(s, i) & 255)
        i = i + 1
    }
    if n < 16 { bytes_extend_zeros(buf, 16 - n) }
    return nil
}

fn _macho_push_string_bytes(buf, s) {
    if buf == nil { return nil }
    if s == nil { s = "" }
    bytes_extend_string(buf, s)
    return nil
}

fn _macho_push_string_z(buf, s) {
    if buf == nil { return nil }
    bytes_extend_string_z(buf, s)
    return nil
}

fn _macho_align(buf, align) {
    if buf == nil { return nil }
    if align == nil || align <= 1 { return nil }
    var rem = int_mod(bytes_len(buf), align)
    if rem != 0 { bytes_extend_zeros(buf, align - rem) }
    return nil
}

fn _macho_pad_to_len(buf, target_len) {
    if buf == nil { return nil }
    if target_len == nil { return nil }
    var used = bytes_len(buf)
    if target_len > used { bytes_extend_zeros(buf, target_len - used) }
    return nil
}

fn push_uleb128(buf, val) {
    if val == 0 {
        bytes_push(buf, 0)
        return nil
    }
    while val > 0 {
        var byte = int_mod(val, 128)
        val = val / 128
        if val > 0 {
            byte = byte | 128
        }
        bytes_push(buf, byte)
    }
    return nil
}

fn macho_build_bind_opcodes(imports, got_offset) {
    // Generates Binding Info for dyld.
    // See Mach-O/dyld_info.h or loader.h
    var p = bytes_new()
    var count = oren_list_len(imports)
    if count == 0 { return p }
    
    // BIND_OPCODE_SET_DYLIB_SPECIAL_IMM (0x30) | 14 (-2 Flat Lookup)
    bytes_push(p, bind_set_dylib_flat_lookup())
    
    // BIND_OPCODE_SET_TYPE_IMM (0x50) | 1 (BIND_TYPE_POINTER)
    bytes_push(p, bind_set_type_pointer())

    // BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB (0x70) | 2 (__DATA is seg 2)
    bytes_push(p, bind_set_segment_data())
    push_uleb128(p, got_offset)
    
    var i = 0
    while i < count {
        var name = imports[i]
        
        // BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM (0x40) | 0
        bytes_push(p, bind_set_symbol_flags_0())
        
        // Symbol name (C-string) + '_' prefix if typical C
        bytes_push(p, 95) // '_'
        _macho_push_string_z(p, name)
        
        // BIND_OPCODE_DO_BIND (0x90)
        bytes_push(p, bind_do_bind())
        
        // Implicitly advances address by 8 (pointer size)
        
        i = i + 1
    }
    
    // BIND_OPCODE_DONE (0x00)
    bytes_push(p, bind_done())
    
    // Pad to 8 bytes? Not strictly required but good for alignment.
    _macho_align(p, 8)
    
    return p
}

fn macho_build_prefix_arm64(text_size, data_size, data_len, entry_idx, header_size, imports_len, symtab_size, strtab_size, bind_size, bind_off, libs, is_shared, lib_name) {
    var p = bytes_new()
    var dyld_path = "/usr/lib/dyld"
    var dyld_cmdsize = align_up(12 + oren_string_len(dyld_path) + 1, 8)
    var dyld_info_cmdsize = cmdsize_dyld_info_only()
    
    // Header (Mach-O 64)
    push_u32_le(p, macho_magic_64())
    push_u32_le(p, macho_cpu_type_arm64())
    push_u32_le(p, 0)          // Subtype
    if is_shared {
        push_u32_le(p, macho_filetype_dylib())
    } else {
        push_u32_le(p, macho_filetype_execute())
    }
    
    // Commands (baseline): PAGEZERO, TEXT, DATA, LINKEDIT, DYLD_INFO_ONLY, LOAD_DYLINKER, (optional) LOAD_DYLIB(libSystem),
    // BUILD_VERSION, MAIN/ID_DYLIB, UUID.
    //
    // Syscall-first binaries can run without linking libSystem when there are no imports.
    // This avoids libsystem_pthread initialization (and its bsdthread_register), letting
    // the program install its own bsdthread entrypoints for spawn().
    var need_libsystem = true
    if imports_len == 0 && oren_list_len(libs) == 0 && is_shared == false {
        need_libsystem = false
    }

    var libsys_path = "/usr/lib/libSystem.B.dylib"
    var libsys_cmdsize = 0
    if need_libsystem {
        libsys_cmdsize = align_up(24 + oren_string_len(libsys_path) + 1, 8)
    }

    var extra_libs_size = 0
    var k_lib = 0
    while k_lib < oren_list_len(libs) {
        var lib_path = libs[k_lib]
        var lib_cmdsize = align_up(24 + oren_string_len(lib_path) + 1, 8)
        extra_libs_size = extra_libs_size + lib_cmdsize
        k_lib = k_lib + 1
    }

    var id_dylib_name = lib_name
    var id_dylib_cmdsize = align_up(24 + oren_string_len(id_dylib_name) + 1, 8)
    
    // Base size: 72 (PAGEZERO) + 152 (TEXT) + 152 (DATA) + 72 (LINKEDIT) + 48 (DYLD_INFO) + dyld + (optional libsys) + 24 (BUILD_VER) + (MAIN or ID_DYLIB) + 24 (UUID)
    var entry_cmd_size = 24 // LC_MAIN
    if is_shared { entry_cmd_size = id_dylib_cmdsize } // LC_ID_DYLIB

    var uuid_cmd_size = cmdsize_uuid()
    var sizeof_cmds_base = cmdsize_segment_64() + cmdsize_segment_64_one_section() + cmdsize_segment_64_one_section() + cmdsize_segment_64() + dyld_info_cmdsize + dyld_cmdsize + libsys_cmdsize + cmdsize_build_version() + entry_cmd_size + extra_libs_size + uuid_cmd_size
    // Baseline commands count without symtab:
    // PAGEZERO, TEXT, DATA, LINKEDIT, DYLD_INFO, LOAD_DYLINKER, (optional LOAD_DYLIB libSystem), BUILD_VERSION, MAIN/ID_DYLIB, UUID
    var ncmds_base = 9 + oren_list_len(libs) + 1 // includes libSystem
    if need_libsystem == false {
        ncmds_base = ncmds_base - 1
    }
    
    if symtab_size > 0 {
        sizeof_cmds_base = sizeof_cmds_base + cmdsize_symtab() // LC_SYMTAB
        ncmds_base = ncmds_base + 1
    }

    var sizeof_cmds = sizeof_cmds_base
    var ncmds = ncmds_base
    push_u32_le(p, ncmds) // ncmds
    push_u32_le(p, sizeof_cmds) // sizeofcmds
    push_u32_le(p, macho_header_flags_pie())
    push_u32_le(p, 0) // reserved
    
    // 1. LC_SEGMENT_64 (__PAGEZERO)
    push_u32_le(p, lc_segment_64())
    push_u32_le(p, cmdsize_segment_64())
    bytes_extend_zeros(p, 16)
    push_u64_le(p, 0) // vmaddr
    push_u64_le(p, pagezero_vmsize())
    push_u64_le(p, 0) // fileoff
    push_u64_le(p, 0) // filesize
    push_u32_le(p, 0) // maxprot
    push_u32_le(p, 0) // initprot
    push_u32_le(p, 0) // nsects
    push_u32_le(p, 0) // flags
    
    // 2. LC_SEGMENT_64 (__TEXT)
    push_u32_le(p, lc_segment_64())
    push_u32_le(p, cmdsize_segment_64_one_section())
    // segname "__TEXT"
    push_str_fixed16(p, "__TEXT")
    push_u64_le(p, vmaddr_text_base())
    push_u64_le(p, text_size) // vmsize
    push_u64_le(p, 0) // fileoff
    push_u64_le(p, text_size) // filesize
    push_u32_le(p, prot_rx()) // maxprot (RX)
    push_u32_le(p, prot_rx()) // initprot (RX)
    push_u32_le(p, 1) // nsects
    push_u32_le(p, 0) // flags
    
        // Section (__text)
        push_str_fixed16(p, "__text")
        push_str_fixed16(p, "__TEXT")
        push_u64_le(p, vmaddr_text_base() + header_size) // addr (start of code)
        push_u64_le(p, text_size - header_size) // size (code + padding)
        push_u32_le(p, header_size) // offset
        push_u32_le(p, sect_align_text_log2())
        push_u32_le(p, 0) // reloff
        push_u32_le(p, 0) // nreloc
        push_u32_le(p, sect_flags_text())
        push_u32_le(p, 0) // reserved1
        push_u32_le(p, 0) // reserved2
        push_u32_le(p, 0) // reserved3

    // 3. LC_SEGMENT_64 (__DATA)
    push_u32_le(p, lc_segment_64())
    push_u32_le(p, cmdsize_segment_64_one_section())
    // segname "__DATA"
    push_str_fixed16(p, "__DATA")
    push_u64_le(p, vmaddr_text_base() + text_size) // vmaddr
    push_u64_le(p, data_size) // vmsize
    push_u64_le(p, text_size) // fileoff
    push_u64_le(p, data_size) // filesize
    push_u32_le(p, prot_rw()) // maxprot (RW)
    push_u32_le(p, prot_rw()) // initprot (RW)
    push_u32_le(p, 1) // nsects
    push_u32_le(p, 0) // flags
    
        // Section (__data)
        push_str_fixed16(p, "__data")
        push_str_fixed16(p, "__DATA")
        push_u64_le(p, vmaddr_text_base() + text_size) // addr
        push_u64_le(p, data_len) // size (actual data size)
        push_u32_le(p, text_size) // offset
        push_u32_le(p, sect_align_data_log2())
        push_u32_le(p, 0) // reloff
        push_u32_le(p, 0) // nreloc
        push_u32_le(p, 0) // flags
        push_u32_le(p, 0) // reserved1
        push_u32_le(p, 0) // reserved2
        push_u32_le(p, 0) // reserved3
        
    // 4. LC_SEGMENT_64 (__LINKEDIT)
    push_u32_le(p, lc_segment_64())
    push_u32_le(p, cmdsize_segment_64())
    push_str_fixed16(p, "__LINKEDIT")
    push_u64_le(p, vmaddr_text_base() + text_size + data_size) // vmaddr
    var linkedit_size = bind_size + symtab_size + (imports_len * u32_size()) + strtab_size
    push_u64_le(p, linkedit_size) // vmsize (aligned)
    push_u64_le(p, text_size + data_size) // fileoff
    push_u64_le(p, linkedit_size) // filesize
    push_u32_le(p, prot_r()) // maxprot (R)
    push_u32_le(p, prot_r()) // initprot (R)
    push_u32_le(p, 0) // nsects
    push_u32_le(p, 0) // flags
    
    // LC_SYMTAB (if needed)
    if symtab_size > 0 {
        push_u32_le(p, lc_symtab())
        push_u32_le(p, cmdsize_symtab())
        push_u32_le(p, text_size + data_size + bind_size) // symoff
        push_u32_le(p, symtab_size / symtab_nlist_64_size()) // nsyms
        push_u32_le(p, text_size + data_size + bind_size + symtab_size + (imports_len * u32_size())) // stroff
        push_u32_le(p, strtab_size) // strsize
    }
    
    // 5. LC_DYLD_INFO_ONLY
    push_u32_le(p, lc_dyld_info_only())
    push_u32_le(p, dyld_info_cmdsize)
    push_u32_le(p, 0) // rebase_off
    push_u32_le(p, 0) // rebase_size
    push_u32_le(p, bind_off) // bind_off
    push_u32_le(p, bind_size) // bind_size
    push_u32_le(p, 0) // weak_bind_off
    push_u32_le(p, 0) // weak_bind_size
    push_u32_le(p, 0) // lazy_bind_off
    push_u32_le(p, 0) // lazy_bind_size
    push_u32_le(p, 0) // export_off
    push_u32_le(p, 0) // export_size
    
    // 6. LC_LOAD_DYLINKER
    var cmd_start = bytes_len(p)
    push_u32_le(p, lc_load_dylinker())
    push_u32_le(p, dyld_cmdsize)
    push_u32_le(p, dylinker_name_offset())
    _macho_push_string_z(p, dyld_path)
    _macho_pad_to_len(p, cmd_start + dyld_cmdsize)
    
    // 7. LC_LOAD_DYLIB (libSystem) - optional for syscall-only binaries
    if need_libsystem {
        var cmd_start_lib = bytes_len(p)
        push_u32_le(p, lc_load_dylib())
        push_u32_le(p, libsys_cmdsize)
        push_u32_le(p, dylib_name_offset())
        push_u32_le(p, 0) // timestamp
        push_u32_le(p, 0) // current version
        push_u32_le(p, 0) // compatibility version
        _macho_push_string_z(p, libsys_path)
        _macho_pad_to_len(p, cmd_start_lib + libsys_cmdsize)
    }

    // Extra libs
    k_lib = 0
    while k_lib < oren_list_len(libs) {
        var lib_path2 = libs[k_lib]
        var cmd_start_lib2 = bytes_len(p)
        var lib_cmdsize2 = align_up(24 + oren_string_len(lib_path2) + 1, 8)
        push_u32_le(p, lc_load_dylib())
        push_u32_le(p, lib_cmdsize2)
        push_u32_le(p, dylib_name_offset())
        push_u32_le(p, 0) // timestamp
        push_u32_le(p, 0) // current version
        push_u32_le(p, 0) // compatibility version
        _macho_push_string_z(p, lib_path2)
        _macho_pad_to_len(p, cmd_start_lib2 + lib_cmdsize2)
        k_lib = k_lib + 1
    }

    // 8. LC_BUILD_VERSION
    push_u32_le(p, lc_build_version())
    push_u32_le(p, cmdsize_build_version())
    push_u32_le(p, build_version_platform_macos())
    push_u32_le(p, build_version_minos_default())
    push_u32_le(p, build_version_sdk_default())
    push_u32_le(p, 0)
    
    // LC_UUID
    push_u32_le(p, lc_uuid())
    push_u32_le(p, cmdsize_uuid())
    push_u32_le(p, 0)
    push_u32_le(p, 0)
    push_u32_le(p, 0)
    push_u32_le(p, 0)
    
    // 8. LC_MAIN or LC_ID_DYLIB
    if is_shared {
        var id_start = bytes_len(p)
        var id_name = lib_name
        var id_size = align_up(24 + oren_string_len(id_name) + 1, 8)
        push_u32_le(p, lc_id_dylib())
        push_u32_le(p, id_size)
        push_u32_le(p, dylib_name_offset())
        push_u32_le(p, 0) // timestamp
        push_u32_le(p, 0) // current ver
        push_u32_le(p, 0) // compat ver
        _macho_push_string_z(p, id_name)
        _macho_pad_to_len(p, id_start + id_size)
    } else {
        push_u32_le(p, lc_main())
        push_u32_le(p, cmdsize_main())
        push_u64_le(p, header_size + entry_idx) // entryoff
        push_u64_le(p, 0) // stacksize
    }
                

    _macho_pad_to_len(p, header_size)
    return p
}

fn macho_exit_code_bytes(code) {
    var b = bytes_new()
    // MOV X0, #code
    push_u32_le(b, insn_movz(0, code))

    // Darwin arm64 syscall ABI: X16 = syscall number, SVC #0x80.
    // Keep it raw (no 0x2000000|n encoding) per `docs/refs/darwin_arm64_abi.md`.
    push_u32_le(b, insn_movz(abi.darwin_syscall_reg(), abi.darwin_sys_exit()))
    push_u32_le(b, insn_svc(abi.darwin_svc_imm()))
    return b
}

fn _macho_push_utf8_aligned(p, s) {
    if s == nil { s = "" }
    var n = oren_string_len(s)
    push_u64_le(p, n)
    bytes_extend_string(p, s)
    _macho_align(p, 8)
    return nil
}

fn _macho_push_u64_zero4(p) {
    push_u64_le(p, 0)
    push_u64_le(p, 0)
    push_u64_le(p, 0)
    push_u64_le(p, 0)
    return nil
}

fn emit_debug_info(ctx, text_base, header_size) {
    var p = bytes_new()
    var funcs = ctx["debug_info"]["funcs"]
    var funcs_count = oren_list_len(funcs)
    var rt_funcs = ctx["rtobj_debug_funcs_enc"]
    var rt_names = ctx["rtobj_debug_func_names"]
    var rt_starts = ctx["rtobj_debug_func_start_enc"]
    var rt_ends = ctx["rtobj_debug_func_end_enc"]
    var rt_blob = ctx["rtobj_debug_blob_u8"]
    var rt_patch_pos = ctx["rtobj_debug_patch_pos_u8"]
    var rt_start_u8 = ctx["rtobj_debug_start_u8"]
    var rt_end_u8 = ctx["rtobj_debug_end_u8"]
    var rt_base_code = ctx["rtobj_debug_funcs_base_code"]
    var phase_log = _macho_phase_log_path()
    var rt_funcs_count = 0
    if rt_base_code == nil { rt_base_code = 0 }
    if rt_names != nil && rt_starts != nil && rt_ends != nil {
        rt_funcs_count = oren_list_len(rt_names)
        if oren_list_len(rt_starts) < rt_funcs_count { rt_funcs_count = oren_list_len(rt_starts) }
        if oren_list_len(rt_ends) < rt_funcs_count { rt_funcs_count = oren_list_len(rt_ends) }
        if rt_patch_pos != nil {
            var rt_patch_n = oren_buf_len(rt_patch_pos) / 8
            if rt_patch_n < rt_funcs_count { rt_funcs_count = rt_patch_n }
        }
    } else if rt_funcs != nil {
        // `debug_funcs_enc` is already filtered at rtobj-build time to only include valid
        // name/start/end entries. Re-scanning and decoding it again here became the dominant
        // self-hosted debug-build cost on stage2-native arm64.
        rt_funcs_count = oren_list_len(rt_funcs)
    }
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.debug.emit.start", "user_funcs=" + oren_int_to_string(funcs_count) + " rt_funcs_raw=" + oren_int_to_string(rt_funcs_count))
    }
    push_u64_le(p, funcs_count + rt_funcs_count)
    
    var i = 0
    var user_params_count = 0
    while i < funcs_count {
        var f = funcs[i]
        // Absolute __TEXT addresses (for debug tooling) are based on the final load address.
        // Keep this derived from the current layout (no magic constants).
        var base = text_base + header_size
        push_u64_le(p, base + f["start"])
        push_u64_le(p, base + f["end"])
        
        _macho_push_utf8_aligned(p, f["name"])

        // Optional source location for deterministic "panic" diagnostics.
        // File stored as UTF-8; line/col are 1-based (0 means unknown).
        var ffile = f["file"]
        if ffile == nil { ffile = "" }
        _macho_push_utf8_aligned(p, ffile)
        var line = f["line"]
        var col = f["col"]
        if line == nil { line = 0 }
        if col == nil { col = 0 }
        push_u64_le(p, line)
        push_u64_le(p, col)
        
        var params = f["params"]
        push_u64_le(p, oren_list_len(params))
        var j = 0
        while j < oren_list_len(params) {
            var param = params[j]
            user_params_count = user_params_count + 1
            _macho_push_utf8_aligned(p, param["name"])
            push_u64_le(p, param["offset"])
            j = j + 1
        }
        i = i + 1
    }
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.debug.emit.user.done", "funcs=" + oren_int_to_string(funcs_count) + " params=" + oren_int_to_string(user_params_count) + " bytes=" + oren_int_to_string(bytes_len(p)))
    }
    if rt_blob != nil && rt_patch_pos != nil && rt_names != nil && rt_starts != nil && rt_ends != nil {
        var base = text_base + header_size
        var rt_blob_off = bytes_len(p)
        core.bytes_extend_u8_buf(p, rt_blob)
        var rt_dstp = oren_buf_data_ptr_unchecked(p["buf"])
        var rt_funcs_kept = 0
        var ri1 = 0
        while ri1 < rt_funcs_count {
            if phase_log != nil {
                if ri1 == 0 || ri1 == 64 || ri1 == 128 || ri1 == 256 || ri1 == 512 || ri1 == 1024 {
                    _macho_phase_log_append(phase_log, "macho.debug.emit.rt.progress", "i=" + oren_int_to_string(ri1) + " bytes=" + oren_int_to_string(bytes_len(p)))
                }
            }
            var patch_pos = _macho_read_u64_le_u8(rt_patch_pos, ri1 * 8)
            var rt_start = nil
            var rt_end = nil
            if rt_start_u8 != nil && rt_end_u8 != nil {
                rt_start = _macho_read_u64_le_u8(rt_start_u8, ri1 * 8)
                rt_end = _macho_read_u64_le_u8(rt_end_u8, ri1 * 8)
            } else {
                rt_start = resolve._macho_decode_rtobj_fix_int(rt_starts[ri1])
                rt_end = resolve._macho_decode_rtobj_fix_int(rt_ends[ri1])
            }
            if patch_pos != nil && rt_start != nil && rt_end != nil {
                rt_funcs_kept = rt_funcs_kept + 1
                _macho_store_u64_le_ptr(rt_dstp, rt_blob_off + patch_pos, base + rt_base_code + rt_start)
                _macho_store_u64_le_ptr(rt_dstp, rt_blob_off + patch_pos + 8, base + rt_base_code + rt_end)
            }
            ri1 = ri1 + 1
        }
        if phase_log != nil {
            _macho_phase_log_append(phase_log, "macho.debug.emit.rt.done", "funcs=" + oren_int_to_string(rt_funcs_kept) + " bytes=" + oren_int_to_string(bytes_len(p)))
        }
    } else if rt_names != nil && rt_starts != nil && rt_ends != nil {
        var base = text_base + header_size
        var rt_funcs_kept = 0
        var ri1 = 0
        while ri1 < rt_funcs_count {
            if phase_log != nil {
                if ri1 == 0 || ri1 == 64 || ri1 == 128 || ri1 == 256 || ri1 == 512 || ri1 == 1024 {
                    _macho_phase_log_append(phase_log, "macho.debug.emit.rt.progress", "i=" + oren_int_to_string(ri1) + " bytes=" + oren_int_to_string(bytes_len(p)))
                }
            }
            var rt_name = rt_names[ri1]
            var rt_start = resolve._macho_decode_rtobj_fix_int(rt_starts[ri1])
            var rt_end = resolve._macho_decode_rtobj_fix_int(rt_ends[ri1])
            if rt_name != nil && rt_start != nil && rt_end != nil {
                rt_funcs_kept = rt_funcs_kept + 1
                push_u64_le(p, base + rt_base_code + rt_start)
                push_u64_le(p, base + rt_base_code + rt_end)
                _macho_push_utf8_aligned(p, rt_name)
                _macho_push_u64_zero4(p)
            }
            ri1 = ri1 + 1
        }
        if phase_log != nil {
            _macho_phase_log_append(phase_log, "macho.debug.emit.rt.done", "funcs=" + oren_int_to_string(rt_funcs_kept) + " bytes=" + oren_int_to_string(bytes_len(p)))
        }
    } else if rt_funcs != nil {
        var base = text_base + header_size
        var rt_funcs_kept = 0
        var ri1 = 0
        while ri1 < oren_list_len(rt_funcs) {
            if phase_log != nil {
                if ri1 == 0 || ri1 == 64 || ri1 == 128 || ri1 == 256 || ri1 == 512 || ri1 == 1024 {
                    _macho_phase_log_append(phase_log, "macho.debug.emit.rt.progress", "i=" + oren_int_to_string(ri1) + " bytes=" + oren_int_to_string(bytes_len(p)))
                }
            }
            var rf1 = rt_funcs[ri1]
            if rf1 != nil {
                var rt_name = rf1["name"]
                var rt_start = resolve._macho_decode_rtobj_fix_int(rf1["start_enc"])
                var rt_end = resolve._macho_decode_rtobj_fix_int(rf1["end_enc"])
                if rt_name != nil && rt_start != nil && rt_end != nil {
                    rt_funcs_kept = rt_funcs_kept + 1
                    push_u64_le(p, base + rt_base_code + rt_start)
                    push_u64_le(p, base + rt_base_code + rt_end)
                    _macho_push_utf8_aligned(p, rt_name)
                    _macho_push_u64_zero4(p)
                }
            }
            ri1 = ri1 + 1
        }
        if phase_log != nil {
            _macho_phase_log_append(phase_log, "macho.debug.emit.rt.done", "funcs=" + oren_int_to_string(rt_funcs_kept) + " bytes=" + oren_int_to_string(bytes_len(p)))
        }
    }
    return p
}

fn macho_emit_exit_arm64(out_path, exit_code) {
    var code = macho_exit_code_bytes(exit_code)
    var header_size = macho_header_size_exit_stub()
    var text_size = align_up(header_size + bytes_len(code), macho_segment_align())
    var prefix = macho_build_prefix_arm64(text_size, 0, 0, 0, header_size, 0, 0, 0, 0, 0, [], false, "")
    bytes_extend(prefix, code)
    _macho_pad_to_len(prefix, text_size)

    var w = oren_write_bytes(out_path, bytes_finalize(prefix))
    if oren_is_err(w) {
        var msg = oren_err_msg(w)
        var e = "Failed to write output: " + out_path
        if msg != nil { e = e + ": " + msg }
        print("OREN_DIAG kind=codegen code=2 msg=" + macho_diag_escape(e))
        print(e)
        oren_exit(1)
    }
    oren_chmod(out_path, 493) // 0755
    return nil
}

fn macho_emit_program_arm64(out_path, linked, libs, is_shared, exports, debug_mode, no_gc, capsule, cap_allow_domains) {
    var trace_emit = false
    var v_trace = oren_env("OREN_TRACE_NATIVE_EMIT")
    if v_trace != nil && v_trace != "" { trace_emit = true }
    var phase_log = _macho_phase_log_path()
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.emit.start", "out=" + out_path) }
    if trace_emit { print("[emit] macho arm64: compile start") }
    var ctx = native_compile_program_arm64(linked, {"os": "macos", "arch": "arm64", "debug": debug_mode, "no_gc": no_gc, "capsule": capsule, "cap_allow_domains": cap_allow_domains})
    if ctx == nil { return nil }
    native_emit_errors_and_exit(ctx)
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.codegen.done", "code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])) + " data_bytes=" + oren_int_to_string(bytes_len(ctx["data"])))
    }
    if trace_emit { print("[emit] macho arm64: compile done") }
    
    var code = ctx["code"]
    var data = ctx["data"]
    var fixups = ctx["fixups"]
    var functions = ctx["functions"]
    
    // IMPORTANT (Tier‑1 robustness):
    // Some compilation paths can temporarily classify forward‑referenced Oren functions as "imports".
    // If we emit an import stub for a symbol that is actually defined in this image, we'll overwrite
    // its entry in `ctx["functions"]` and silently call the stub (catastrophic miscompile).
    //
    // Resolve that ambiguity here by filtering imports: true imports are only those that are not
    // declared/defined as Oren functions in this program.
    var imports_raw = ctx["import_list"]
    if imports_raw == nil { imports_raw = [] }
    var imports = []
    var import_collide_count = 0
    var import_collide_sample = []
    var ii_imp = 0
    while ii_imp < oren_list_len(imports_raw) {
        var nm = imports_raw[ii_imp]
        var is_local = false
        if nm != nil {
            if ctx["func_arity"] != nil && ctx["func_arity"][nm] != nil {
                is_local = true
            } else if resolve._macho_lookup_function(ctx, functions, nm) != nil {
                is_local = true
            }
        }
        if is_local {
            import_collide_count = import_collide_count + 1
            if oren_list_len(import_collide_sample) < 8 { oren_list_push(import_collide_sample, nm) }
        } else {
            oren_list_push(imports, nm)
        }
        ii_imp = ii_imp + 1
    }
    ctx["import_list"] = imports
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.imports.filtered.done", "raw=" + oren_int_to_string(oren_list_len(imports_raw)) + " imports=" + oren_int_to_string(oren_list_len(imports)) + " collided=" + oren_int_to_string(import_collide_count))
    }
    var trace_imports = oren_env("OREN_TRACE_NATIVE_IMPORTS") != nil
    if (trace_emit || trace_imports) && import_collide_count > 0 {
        var sample_s = ""
        var si = 0
        while si < oren_list_len(import_collide_sample) {
            if si > 0 { sample_s = sample_s + "," }
            sample_s = sample_s + import_collide_sample[si]
            si = si + 1
        }
        print("[emit] macho arm64: filtered " + oren_int_to_string(import_collide_count) + " import(s) that collide with local function symbols (sample=" + sample_s + ")")
    }
    var rtobj_fixups_compact = ctx["runtime_fixups_compact"]
    var rtobj_fixups_compact_u8 = ctx["runtime_fixups_compact_u8"]
    var rtobj_fixups = ctx["runtime_fixups_enc"]
    var rtobj_fixups_n = 0
    if rtobj_fixups_compact != nil { rtobj_fixups_n = _macho_rtobj_fixups_count_compact(rtobj_fixups_compact) }
    else if rtobj_fixups != nil { rtobj_fixups_n = oren_list_len(rtobj_fixups) }
    if trace_emit { print("[emit] macho arm64: imports=" + oren_int_to_string(oren_list_len(imports)) + " fixups=" + oren_int_to_string(rtobj_fixups_n + oren_list_len(fixups))) }
    var fixup_target_cache = oren_map_new_cap(0)
    if oren_is_err(fixup_target_cache) { fixup_target_cache = {} }
    
    // FFI Tables
    var strtab = bytes_new()
    bytes_push(strtab, 32) // Space (index 0)
    bytes_extend_zeros(strtab, 1)
    
    var symtab = bytes_new()
    var indsymtab = bytes_new()
    
    // Append GOT placeholder to Data (Aligned)
    _macho_align(data, 8)
    var got_offset = bytes_len(data)
    // PERF: avoid per-byte `bytes_push` loops when the import list is large.
    codegen.bytes_extend_zeros(data, oren_list_len(imports) * 8)
    if trace_emit { print("[emit] macho arm64: GOT placeholder done") }

    // dyld binding must use the *external* symbol names, not the internal module-prefixed labels.
    var bind_names = []
    var bi = 0
    while bi < oren_list_len(imports) {
        var nm = imports[bi]
        var bn = nm
        if ctx["ffi_link_names"] != nil && ctx["ffi_link_names"][nm] != nil { bn = ctx["ffi_link_names"][nm] }
        oren_list_push(bind_names, bn)
        bi = bi + 1
    }

    var bind_opcodes = macho_build_bind_opcodes(bind_names, got_offset)
    var bind_size = bytes_len(bind_opcodes)
    if trace_emit { print("[emit] macho arm64: bind opcodes size=" + oren_int_to_string(bind_size)) }

    var i_imp = 0
    while i_imp < oren_list_len(imports) {
        var name = imports[i_imp]
        var bind_name = bind_names[i_imp]
        var stub_pos = bytes_len(code)
        // `imports` is filtered above, but keep a defensive check anyway.
        if functions[name] == nil { functions[name] = stub_pos }
        
        // Stub: ADRP X16, <got>@PAGE; ADD X16, X16, <got>@PAGEOFF; LDR X16, [X16]; BR X16
        push_u32_le(code, 0) // Placeholder for ADRP
        push_u32_le(code, 0) // Placeholder for ADD
        push_u32_le(code, insn_ldr_ptr(16, 16))
        push_u32_le(code, insn_br(16))
        
        arm64_ctx_fixup_got_load(ctx, stub_pos, i_imp)
        
        // Symbol Table
        var name_idx = bytes_len(strtab)
        
        bytes_push(strtab, 95) // '_'
        _macho_push_string_z(strtab, bind_name)
        
        push_u32_le(symtab, name_idx) // n_strx
        bytes_push(symtab, 1) // n_type (N_EXT | N_UNDF)
        bytes_extend_zeros(symtab, 1) // n_sect
        push_u16_le(symtab, 0) // n_desc
        push_u64_le(symtab, 0) // n_value
        
        push_u32_le(indsymtab, i_imp)
        
        i_imp = i_imp + 1
    }
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.import_stubs.done", "imports=" + oren_int_to_string(oren_list_len(imports)))
    }
    if trace_emit { print("[emit] macho arm64: stubs+symtab for imports done") }

    if is_shared || (exports != nil && oren_list_len(exports) != 0) {
        var i_exp = 0
        while i_exp < oren_list_len(exports) {
            var f_name = exports[i_exp]
            var f_addr = functions[f_name]
            
            var name_idx_exp = bytes_len(strtab)
            bytes_push(strtab, 95) // '_'
            _macho_push_string_z(strtab, f_name)
            
            push_u32_le(symtab, name_idx_exp)
            bytes_push(symtab, 15) // N_SECT | N_EXT
            bytes_push(symtab, 1)
            push_u16_le(symtab, 0)
            push_u64_le(symtab, vmaddr_text_base() + macho_header_size_default() + f_addr)
            
            i_exp = i_exp + 1
        }
    }
    if phase_log != nil {
        var exports_n = 0
        if exports != nil { exports_n = oren_list_len(exports) }
        _macho_phase_log_append(phase_log, "macho.exports.done", "exports=" + oren_int_to_string(exports_n))
    }
    
    _macho_align(code, 4)
    
    if functions["main"] == nil {
        if functions["__top_level__"] != nil { functions["main"] = functions["__top_level__"] }
        if functions["main"] == nil {
            if ctx["main_idx"] != nil { functions["main"] = ctx["main_idx"] }
            if functions["main"] == nil {
                if oren_list_len(ctx["function_names"]) > 0 {
                    var fname0 = ctx["function_names"][0]
                    functions["main"] = functions[fname0]
                } else {
                    functions["main"] = 0
                }
            }
        }
    }
    
    var header_size = macho_header_size_default()
    var text_base = vmaddr_text_base()
    var code_len = bytes_len(code)
    var text_size = align_up(header_size + code_len, macho_segment_align())
    
    // Append debug info
    if debug_mode {
        if phase_log != nil { _macho_phase_log_append(phase_log, "macho.debug.start", "") }
        var debug_blob = emit_debug_info(ctx, text_base, header_size)
        _macho_align(data, 8)
        var debug_off = bytes_len(data)
        bytes_extend(data, debug_blob)
        if ctx["debug_fixup_pos"] != nil {
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": ctx["debug_fixup_pos"], "data_off": debug_off, "reg": nil})
            oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], ctx["debug_fixup_pos"])
            oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], debug_off)
            oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 0)
            
            var sa = text_base + text_size + debug_off
            var p = ctx["debug_static_addr_pos"]
            set_u32_le(code, p, insn_movz(1, int_mod(sa, 65536)))
            set_u32_le(code, p+4, insn_movk(1, int_mod(sa / 65536, 65536), 1))
            set_u32_le(code, p+8, insn_movk(1, int_mod(sa / u64_2_32(), 65536), 2))
            set_u32_le(code, p+12, insn_movk(1, int_mod(sa / u64_2_48(), 65536), 3))
        }
        if phase_log != nil { _macho_phase_log_append(phase_log, "macho.debug.done", "bytes=" + oren_int_to_string(bytes_len(debug_blob))) }
    }

    var data_len = bytes_len(data)
    var data_size = align_up(data_len, macho_segment_align())
    var data_vmaddr = text_base + text_size
    
    // Apply fixups
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.fixups.start", "rtobj=" + oren_int_to_string(rtobj_fixups_n) + " local=" + oren_int_to_string(oren_list_len(fixups)))
    }
    if trace_emit { print("[emit] macho arm64: apply fixups start n=" + oren_int_to_string(rtobj_fixups_n + oren_list_len(fixups))) }
    var rtobj_fix_base = ctx["rtobj_fixups_base_code"]
    if rtobj_fix_base == nil { rtobj_fix_base = 0 }
    var code_vmaddr_base = text_base + header_size
    var i = 0
    if rtobj_fixups_compact != nil {
        var bl_poss = rtobj_fixups_compact["bl_pos_enc"]
        var bl_names = rtobj_fixups_compact["bl_name"]
        var bl_poss_u8 = nil
        var bl_target_u8 = nil
        if rtobj_fixups_compact_u8 != nil {
            bl_poss_u8 = rtobj_fixups_compact_u8["bl_pos_u8"]
            bl_target_u8 = rtobj_fixups_compact_u8["bl_target_u8"]
        }
        var bl_n = 0
        if bl_poss != nil { bl_n = oren_list_len(bl_poss) }
        i = 0
        while bl_poss != nil && i < bl_n {
            if phase_log != nil {
                if i == 0 || i == 8192 || i == 16384 || i == 24576 {
                    _macho_phase_log_append(phase_log, "macho.fixups.rtobj.bl.progress", "i=" + oren_int_to_string(i))
                }
            }
            if trace_emit {
                if i == 0 { print("[emit] macho arm64: fixup[0] start") }
                if i == 10000 { print("[emit] macho arm64: fixup[10000]") }
                if i == 20000 { print("[emit] macho arm64: fixup[20000]") }
            }
            var pos_bl = 0
            if bl_poss_u8 != nil { pos_bl = rtobj_fix_base + _macho_read_u64_le_u8(bl_poss_u8, i * 8) }
            else { pos_bl = rtobj_fix_base + resolve._macho_decode_rtobj_fix_int(bl_poss[i]) }
            var target_bl = nil
            var name_bl = nil
            if bl_target_u8 != nil {
                var target_bl_enc = _macho_read_u64_le_u8(bl_target_u8, i * 8)
                if target_bl_enc > 0 {
                    target_bl = ctx["rtobj_functions_base_code"] + (target_bl_enc - 1)
                }
            }
            if target_bl == nil {
                name_bl = bl_names[i]
                target_bl = resolve._macho_lookup_function_cached(fixup_target_cache, ctx, functions, name_bl)
            }
            if target_bl == nil {
                var e_bl = "native backend: undefined function " + name_bl
                print("OREN_DIAG kind=codegen code=1 msg=" + macho_diag_escape(e_bl))
                print(e_bl)
                oren_exit(1)
            }
            var offset_bl = (target_bl - pos_bl) / 4
            set_u32_le(code, pos_bl, insn_bl(offset_bl))
            i = i + 1
        }
        if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.rtobj.bl.done", "n=" + oren_int_to_string(bl_n)) }

        var adr_data_poss = rtobj_fixups_compact["adr_data_pos_enc"]
        var adr_data_offs = rtobj_fixups_compact["adr_data_data_off_enc"]
        var adr_data_regs = rtobj_fixups_compact["adr_data_reg_enc"]
        var adr_data_poss_u8 = nil
        var adr_data_offs_u8 = nil
        var adr_data_regs_u8 = nil
        if rtobj_fixups_compact_u8 != nil {
            adr_data_poss_u8 = rtobj_fixups_compact_u8["adr_data_pos_u8"]
            adr_data_offs_u8 = rtobj_fixups_compact_u8["adr_data_data_off_u8"]
            adr_data_regs_u8 = rtobj_fixups_compact_u8["adr_data_reg_u8"]
        }
        var adr_data_n = 0
        if adr_data_poss != nil { adr_data_n = oren_list_len(adr_data_poss) }
        while adr_data_poss != nil && i < (bl_n + adr_data_n) {
            var k_ad = i - bl_n
            if phase_log != nil {
                if k_ad == 0 || k_ad == 8192 || k_ad == 16384 {
                    _macho_phase_log_append(phase_log, "macho.fixups.rtobj.adr_data.progress", "i=" + oren_int_to_string(k_ad))
                }
            }
            if trace_emit {
                if i == 0 { print("[emit] macho arm64: fixup[0] start") }
                if i == 10000 { print("[emit] macho arm64: fixup[10000]") }
                if i == 20000 { print("[emit] macho arm64: fixup[20000]") }
            }
            var pos_ad = 0
            if adr_data_poss_u8 != nil { pos_ad = rtobj_fix_base + _macho_read_u64_le_u8(adr_data_poss_u8, k_ad * 8) }
            else { pos_ad = rtobj_fix_base + resolve._macho_decode_rtobj_fix_int(adr_data_poss[k_ad]) }
            var data_off_ad = 0
            if adr_data_offs_u8 != nil { data_off_ad = _macho_read_u64_le_u8(adr_data_offs_u8, k_ad * 8) }
            else { data_off_ad = resolve._macho_decode_rtobj_fix_int(adr_data_offs[k_ad]) }
            var target_addr_ad = data_vmaddr + data_off_ad
            var pc_ad = code_vmaddr_base + pos_ad
            var pc_page_ad = pc_ad - int_mod(pc_ad, 4096)
            var target_page_ad = target_addr_ad - int_mod(target_addr_ad, 4096)
            var delta_pages_ad = (target_page_ad - pc_page_ad) / 4096
            var page_off_ad = int_mod(target_addr_ad, 4096)
            var reg_ad = 0
            if adr_data_regs_u8 != nil { reg_ad = _macho_read_u64_le_u8(adr_data_regs_u8, k_ad * 8) }
            else {
                var reg_ad_dec = resolve._macho_decode_rtobj_fix_reg(adr_data_regs[k_ad])
                if reg_ad_dec != nil { reg_ad = reg_ad_dec }
            }
            set_u32_le(code, pos_ad, insn_adrp(reg_ad, delta_pages_ad))
            set_u32_le(code, pos_ad + 4, insn_add_imm(reg_ad, reg_ad, page_off_ad))
            i = i + 1
        }
        if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.rtobj.adr_data.done", "n=" + oren_int_to_string(adr_data_n)) }

        var adr_code_poss = rtobj_fixups_compact["adr_code_pos_enc"]
        var adr_code_names = rtobj_fixups_compact["adr_code_name"]
        var adr_code_regs = rtobj_fixups_compact["adr_code_reg_enc"]
        var adr_code_poss_u8 = nil
        var adr_code_target_u8 = nil
        var adr_code_regs_u8 = nil
        if rtobj_fixups_compact_u8 != nil {
            adr_code_poss_u8 = rtobj_fixups_compact_u8["adr_code_pos_u8"]
            adr_code_target_u8 = rtobj_fixups_compact_u8["adr_code_target_u8"]
            adr_code_regs_u8 = rtobj_fixups_compact_u8["adr_code_reg_u8"]
        }
        var adr_code_n = 0
        if adr_code_poss != nil { adr_code_n = oren_list_len(adr_code_poss) }
        while adr_code_poss != nil && i < (bl_n + adr_data_n + adr_code_n) {
            var k_ac = i - bl_n - adr_data_n
            if phase_log != nil {
                if k_ac == 0 || k_ac == 8192 || k_ac == 16384 {
                    _macho_phase_log_append(phase_log, "macho.fixups.rtobj.adr_code.progress", "i=" + oren_int_to_string(k_ac))
                }
            }
            if trace_emit {
                if i == 0 { print("[emit] macho arm64: fixup[0] start") }
                if i == 10000 { print("[emit] macho arm64: fixup[10000]") }
                if i == 20000 { print("[emit] macho arm64: fixup[20000]") }
            }
            var pos_ac = 0
            if adr_code_poss_u8 != nil { pos_ac = rtobj_fix_base + _macho_read_u64_le_u8(adr_code_poss_u8, k_ac * 8) }
            else { pos_ac = rtobj_fix_base + resolve._macho_decode_rtobj_fix_int(adr_code_poss[k_ac]) }
            var target_ac = nil
            var name_ac = nil
            if adr_code_target_u8 != nil {
                var target_ac_enc = _macho_read_u64_le_u8(adr_code_target_u8, k_ac * 8)
                if target_ac_enc > 0 {
                    target_ac = ctx["rtobj_functions_base_code"] + (target_ac_enc - 1)
                }
            }
            if target_ac == nil {
                name_ac = adr_code_names[k_ac]
                target_ac = resolve._macho_lookup_function_cached(fixup_target_cache, ctx, functions, name_ac)
            }
            if target_ac == nil {
                var e_ac = "native backend: undefined function " + name_ac
                print("OREN_DIAG kind=codegen code=1 msg=" + macho_diag_escape(e_ac))
                print(e_ac)
                oren_exit(1)
            }
            var reg_ac = 0
            if adr_code_regs_u8 != nil { reg_ac = _macho_read_u64_le_u8(adr_code_regs_u8, k_ac * 8) }
            else {
                var reg_ac_dec = resolve._macho_decode_rtobj_fix_reg(adr_code_regs[k_ac])
                if reg_ac_dec != nil { reg_ac = reg_ac_dec }
            }
            var target_addr_ac = code_vmaddr_base + target_ac
            var pc_ac = code_vmaddr_base + pos_ac
            var pc_page_ac = pc_ac - int_mod(pc_ac, 4096)
            var target_page_ac = target_addr_ac - int_mod(target_addr_ac, 4096)
            var delta_pages_ac = (target_page_ac - pc_page_ac) / 4096
            var page_off_ac = int_mod(target_addr_ac, 4096)
            set_u32_le(code, pos_ac, insn_adrp(reg_ac, delta_pages_ac))
            set_u32_le(code, pos_ac + 4, insn_add_imm(reg_ac, reg_ac, page_off_ac))
            i = i + 1
        }
        if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.rtobj.adr_code.done", "n=" + oren_int_to_string(adr_code_n)) }
    } else {
        while i < rtobj_fixups_n {
            if trace_emit {
                if i == 0 { print("[emit] macho arm64: fixup[0] start") }
                if i == 10000 { print("[emit] macho arm64: fixup[10000]") }
                if i == 20000 { print("[emit] macho arm64: fixup[20000]") }
            }
            var fix_rt = rtobj_fixups[i]
            var pos_rt = rtobj_fix_base + resolve._macho_decode_rtobj_fix_int(fix_rt["pos"])

            if fix_rt["type"] == "bl" {
                var name_rt = fix_rt["name"]
                var target_rt = resolve._macho_lookup_function_cached(fixup_target_cache, ctx, functions, name_rt)
                if target_rt == nil {
                    var e_rt = "native backend: undefined function " + name_rt
                    print("OREN_DIAG kind=codegen code=1 msg=" + macho_diag_escape(e_rt))
                    print(e_rt)
                    oren_exit(1)
                }
                var offset_rt = (target_rt - pos_rt) / 4
                set_u32_le(code, pos_rt, insn_bl(offset_rt))
            }

            if fix_rt["type"] == "adr_data" {
                var data_off_rt = resolve._macho_decode_rtobj_fix_int(fix_rt["data_off"])
                var target_addr_rt = data_vmaddr + data_off_rt
                var pc_rt = text_base + header_size + pos_rt
                var pc_page_rt = pc_rt - int_mod(pc_rt, 4096)
                var target_page_rt = target_addr_rt - int_mod(target_addr_rt, 4096)
                var delta_pages_rt = (target_page_rt - pc_page_rt) / 4096
                var page_off_rt = int_mod(target_addr_rt, 4096)
                var reg_rt = resolve._macho_decode_rtobj_fix_int(fix_rt["reg"])
                if reg_rt == nil { reg_rt = 0 }
                set_u32_le(code, pos_rt, insn_adrp(reg_rt, delta_pages_rt))
                set_u32_le(code, pos_rt + 4, insn_add_imm(reg_rt, reg_rt, page_off_rt))
            }

            if fix_rt["type"] == "adr_code" {
                var name_rt2 = fix_rt["name"]
                var target_rt2 = resolve._macho_lookup_function_cached(fixup_target_cache, ctx, functions, name_rt2)
                if target_rt2 == nil {
                    var e_rt2 = "native backend: undefined function " + name_rt2
                    print("OREN_DIAG kind=codegen code=1 msg=" + macho_diag_escape(e_rt2))
                    print(e_rt2)
                    oren_exit(1)
                }
                var reg_rt2 = resolve._macho_decode_rtobj_fix_int(fix_rt["reg"])
                var target_addr_rt2 = text_base + header_size + target_rt2
                var pc_rt2 = text_base + header_size + pos_rt
                var pc_page_rt2 = pc_rt2 - int_mod(pc_rt2, 4096)
                var target_page_rt2 = target_addr_rt2 - int_mod(target_addr_rt2, 4096)
                var delta_pages_rt2 = (target_page_rt2 - pc_page_rt2) / 4096
                var page_off_rt2 = int_mod(target_addr_rt2, 4096)
                set_u32_le(code, pos_rt, insn_adrp(reg_rt2, delta_pages_rt2))
                set_u32_le(code, pos_rt + 4, insn_add_imm(reg_rt2, reg_rt2, page_off_rt2))
            }
            i = i + 1
        }
    }
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.rtobj.done", "n=" + oren_int_to_string(rtobj_fixups_n)) }
    var fixups_local = ctx["fixups_local_compact"]
    var fixups_local_fallback = nil
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.local.compact.start", "n=" + oren_int_to_string(oren_list_len(fixups))) }
    if fixups_local == nil || _macho_local_fixups_count_compact(fixups_local) != oren_list_len(fixups) {
        fixups_local = _macho_local_fixups_compact(fixups)
    } else if oren_env("OREN_VERIFY_LOCAL_FIXUPS") != nil {
        fixups_local_fallback = _macho_local_fixups_compact(fixups)
        var diff_local = _macho_local_fixups_compact_diff(fixups_local, fixups_local_fallback)
        if diff_local != nil {
            if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.local.compact.mismatch", diff_local) }
            fixups_local = fixups_local_fallback
        }
    }
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.local.compact.done", "n=" + oren_int_to_string(_macho_local_fixups_count_compact(fixups_local))) }
    var local_bl_pos = fixups_local["bl_pos"]
    var local_bl_name = fixups_local["bl_name"]
    var local_bl_target = fixups_local["bl_target"]
    var local_adr_data_pos = fixups_local["adr_data_pos"]
    var local_adr_data_off = fixups_local["adr_data_off"]
    var local_adr_data_reg = fixups_local["adr_data_reg"]
    var local_adr_code_pos = fixups_local["adr_code_pos"]
    var local_adr_code_name = fixups_local["adr_code_name"]
    var local_adr_code_target = fixups_local["adr_code_target"]
    var local_adr_code_reg = fixups_local["adr_code_reg"]
    var local_got_pos = fixups_local["got_pos"]
    var local_got_index = fixups_local["got_index"]
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.fixups.local.counts",
            "bl=" + oren_int_to_string(oren_list_len(local_bl_pos)) +
            " adr_data=" + oren_int_to_string(oren_list_len(local_adr_data_pos)) +
            " adr_code=" + oren_int_to_string(oren_list_len(local_adr_code_pos)) +
            " got=" + oren_int_to_string(oren_list_len(local_got_pos)))
    }
    var local_target_names = []
    var local_target_offs = []
    var local_target_meta_keys = []
    var local_target_buckets = resolve._macho_target_buckets_new()
    var local_target_counts = nil
    var local_target_stats = nil
    if phase_log != nil && oren_env("OREN_TRACE_MACHO_LOCAL_RESOLVE_STATS") != nil {
        local_target_stats = [0, 0, 0, 0, 0, 0, 0]
        local_target_counts = []
    }
    var local_bl_n = oren_list_len(local_bl_name)
    var local_bl_target_valid = false
    if local_bl_target != nil && oren_list_len(local_bl_target) == local_bl_n { local_bl_target_valid = true }
    var rt_hot = ctx["runtime_functions_enc"]
    var rt_hot_base = ctx["rtobj_functions_base_code"]
    var hot_bl_panic = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_panic")
    var hot_bl_ensure_tracked = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_ensure_tracked")
    var hot_bl_call_depth_enter = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_call_depth_enter")
    var hot_bl_call_depth_exit = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_call_depth_exit")
    var hot_bl_list_len_panic = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "native_list_len_panic")
    var hot_bl_find_node = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_find_node")
    var hot_bl_is_err = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_is_err")
    var hot_bl_map_get_str = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_map_get_str")
    var hot_bl_new_list = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_new_list")
    var hot_bl_list_get = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_list_get")
    var hot_bl_list_push_unchecked = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_list_push_unchecked")
    var hot_bl_find_node_known_kind = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "_list_find_node_known_kind")
    var hot_bl_func = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_func")
    var hot_bl_list_push = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_list_push")
    var hot_bl_add = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_add")
    var hot_bl_map_get_int = resolve._macho_lookup_runtime_offset(rt_hot, rt_hot_base, "oren_map_get_int")
    var hot_bl_std_generator_next = resolve._macho_lookup_function(ctx, functions, "STD_generator_next")
    var hot_bl_std_generator_start = resolve._macho_lookup_function(ctx, functions, "STD_generator_start")
    var hot_bl_strcmp = resolve._macho_lookup_function(ctx, functions, "strcmp")
    var hot_bl_std_generator_send = resolve._macho_lookup_function(ctx, functions, "STD_generator_send")
    var hot_bl_std_generator_is_done = resolve._macho_lookup_function(ctx, functions, "STD_generator_is_done")
    var hot_bl_map_set_str = resolve._macho_lookup_function(ctx, functions, "oren_map_set_str")
    var hot_bl_type_name = resolve._macho_lookup_function(ctx, functions, "oren_type_name")
    var hot_bl_std_generator_cancel_reason = resolve._macho_lookup_function(ctx, functions, "STD_generator_cancel_reason")
    var hot_bl_generator_context_exchange = resolve._macho_lookup_function(ctx, functions, "_oren_generator_context_exchange")
    var hot_bl_std_generator_is_cancel_requested = resolve._macho_lookup_function(ctx, functions, "STD_generator_is_cancel_requested")
    var hot_bl_targets = [
        hot_bl_panic,
        hot_bl_ensure_tracked,
        hot_bl_call_depth_enter,
        hot_bl_call_depth_exit,
        hot_bl_list_len_panic,
        hot_bl_find_node,
        hot_bl_is_err,
        hot_bl_map_get_str,
        hot_bl_new_list,
        hot_bl_list_get,
        hot_bl_list_push_unchecked,
        hot_bl_find_node_known_kind,
        hot_bl_func,
        hot_bl_list_push,
        hot_bl_add,
        hot_bl_map_get_int,
        hot_bl_std_generator_next,
        hot_bl_std_generator_start,
        hot_bl_strcmp,
        hot_bl_std_generator_send,
        hot_bl_std_generator_is_done,
        hot_bl_map_set_str,
        hot_bl_type_name,
        hot_bl_std_generator_cancel_reason,
        hot_bl_generator_context_exchange,
        hot_bl_std_generator_is_cancel_requested
    ]
    i = 0
    var local_bl_prefilled = 0
    var local_bl_resolved = 0
    var local_bl_hot_id = 0
    var local_bl_pos_n = oren_list_len(local_bl_pos)
    while i < local_bl_n {
        if phase_log != nil {
            if i == 0 || i == 4096 || i == 8192 {
                _macho_phase_log_append(phase_log, "macho.fixups.local.bl.resolve.progress",
                    "i=" + oren_int_to_string(i) +
                    resolve._macho_lookup_stats_detail(local_target_stats, oren_list_len(local_target_names)))
            }
        }
        var target_local = nil
        if local_bl_target_valid == true { target_local = local_bl_target[i] }
        if target_local == nil {
            var name_bl_local = local_bl_name[i]
            if oren_type_tag(name_bl_local) == 1 {
                var hot_bl_idx = 0 - name_bl_local - 1
                if hot_bl_idx >= 0 && hot_bl_idx < oren_list_len(hot_bl_targets) {
                    target_local = hot_bl_targets[hot_bl_idx]
                }
                if target_local != nil { local_bl_hot_id = local_bl_hot_id + 1 }
                else {
                    var name_bl_known = resolve._macho_hot_bl_id_name(name_bl_local)
                    if name_bl_known == nil { name_bl_known = "unknown_hot_bl_id" }
                    name_bl_local = name_bl_known
                }
            }
            if target_local == nil {
                target_local = resolve._macho_lookup_function_linear(local_target_names, local_target_offs, local_target_meta_keys, local_target_buckets, local_target_counts, ctx, functions, name_bl_local, local_target_stats)
            }
            if target_local == nil {
                var e_local_bl = "native backend: undefined function " + name_bl_local
                print("OREN_DIAG kind=codegen code=1 msg=" + macho_diag_escape(e_local_bl))
                print(e_local_bl)
                oren_exit(1)
            }
            local_bl_resolved = local_bl_resolved + 1
            if local_bl_target_valid == true { local_bl_target[i] = target_local }
        } else {
            local_bl_prefilled = local_bl_prefilled + 1
        }
        if phase_log != nil {
            if i == 0 || i == 4096 || i == 8192 {
                _macho_phase_log_append(phase_log, "macho.fixups.local.bl.progress", "i=" + oren_int_to_string(i))
            }
        }
        var pos_bl_local = local_bl_pos[i]
        var offset_local = (target_local - pos_bl_local) / 4
        set_u32_le(code, pos_bl_local, insn_bl(offset_local))
        i = i + 1
    }
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.fixups.local.bl.resolve.done",
            "n=" + oren_int_to_string(local_bl_n) +
            " prefilled=" + oren_int_to_string(local_bl_prefilled) +
            " hot_id=" + oren_int_to_string(local_bl_hot_id) +
            " resolved=" + oren_int_to_string(local_bl_resolved) +
            resolve._macho_lookup_stats_detail(local_target_stats, oren_list_len(local_target_names)) +
            resolve._macho_lookup_top_counts_detail(local_target_names, local_target_counts, "bl_top"))
    }
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.local.bl.done", "n=" + oren_int_to_string(local_bl_pos_n)) }
    var local_adr_code_n = oren_list_len(local_adr_code_name)
    if local_adr_code_target == nil || oren_list_len(local_adr_code_target) != local_adr_code_n {
        local_adr_code_target = oren_list_new_cap(local_adr_code_n)
        if oren_is_err(local_adr_code_target) { local_adr_code_target = [] }
        i = 0
        while i < local_adr_code_n {
            oren_list_push(local_adr_code_target, nil)
            i = i + 1
        }
        fixups_local["adr_code_target"] = local_adr_code_target
    }
    i = 0
    while i < local_adr_code_n {
        if phase_log != nil {
            if i == 0 || i == 4096 || i == 8192 {
                _macho_phase_log_append(phase_log, "macho.fixups.local.adr_code.resolve.progress",
                    "i=" + oren_int_to_string(i) +
                    resolve._macho_lookup_stats_detail(local_target_stats, oren_list_len(local_target_names)))
            }
        }
        var target2_local = local_adr_code_target[i]
        if target2_local == nil {
            var name_ac_local = local_adr_code_name[i]
            target2_local = resolve._macho_lookup_function_linear(local_target_names, local_target_offs, local_target_meta_keys, local_target_buckets, local_target_counts, ctx, functions, name_ac_local, local_target_stats)
            if target2_local == nil {
                var e_local_ac = "native backend: undefined function " + name_ac_local
                print("OREN_DIAG kind=codegen code=1 msg=" + macho_diag_escape(e_local_ac))
                print(e_local_ac)
                oren_exit(1)
            }
            local_adr_code_target[i] = target2_local
        }
        i = i + 1
    }
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.local.resolve.unique.done", "n=" + oren_int_to_string(oren_list_len(local_target_names))) }
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.fixups.local.adr_code.resolve.done",
            "n=" + oren_int_to_string(local_adr_code_n) +
            resolve._macho_lookup_stats_detail(local_target_stats, oren_list_len(local_target_names)) +
            resolve._macho_lookup_top_counts_detail(local_target_names, local_target_counts, "all_top"))
    }
    i = 0
    var local_adr_data_n = oren_list_len(local_adr_data_pos)
    while i < local_adr_data_n {
        if phase_log != nil {
            if i == 0 || i == 4096 || i == 8192 {
                _macho_phase_log_append(phase_log, "macho.fixups.local.adr_data.progress", "i=" + oren_int_to_string(i))
            }
        }
        var pos_ad_local = local_adr_data_pos[i]
        var data_off_local = local_adr_data_off[i]
        var target_addr_local = data_vmaddr + data_off_local
        var pc_local = text_base + header_size + pos_ad_local
        var pc_page_local = pc_local - int_mod(pc_local, 4096)
        var target_page_local = target_addr_local - int_mod(target_addr_local, 4096)
        var delta_pages_local = (target_page_local - pc_page_local) / 4096
        var page_off_local = int_mod(target_addr_local, 4096)
        var reg_local = local_adr_data_reg[i]
        set_u32_le(code, pos_ad_local, insn_adrp(reg_local, delta_pages_local))
        set_u32_le(code, pos_ad_local + 4, insn_add_imm(reg_local, reg_local, page_off_local))
        i = i + 1
    }
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.local.adr_data.done", "n=" + oren_int_to_string(local_adr_data_n)) }
    i = 0
    var local_adr_code_pos_n = oren_list_len(local_adr_code_pos)
    while i < local_adr_code_pos_n {
        if phase_log != nil {
            if i == 0 || i == 4096 || i == 8192 {
                _macho_phase_log_append(phase_log, "macho.fixups.local.adr_code.progress", "i=" + oren_int_to_string(i))
            }
        }
        var pos_ac_local = local_adr_code_pos[i]
        var target2_local = local_adr_code_target[i]
        var reg_ac_local = local_adr_code_reg[i]
        var target_addr2_local = text_base + header_size + target2_local
        var pc2_local = text_base + header_size + pos_ac_local
        var pc_page2_local = pc2_local - int_mod(pc2_local, 4096)
        var target_page2_local = target_addr2_local - int_mod(target_addr2_local, 4096)
        var delta_pages2_local = (target_page2_local - pc_page2_local) / 4096
        var page_off2_local = int_mod(target_addr2_local, 4096)
        set_u32_le(code, pos_ac_local, insn_adrp(reg_ac_local, delta_pages2_local))
        set_u32_le(code, pos_ac_local + 4, insn_add_imm(reg_ac_local, reg_ac_local, page_off2_local))
        i = i + 1
    }
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.local.adr_code.done", "n=" + oren_int_to_string(local_adr_code_pos_n)) }
    i = 0
    var local_got_n = oren_list_len(local_got_pos)
    while i < local_got_n {
        if phase_log != nil {
            if i == 0 || i == 4096 || i == 8192 {
                _macho_phase_log_append(phase_log, "macho.fixups.local.got.progress", "i=" + oren_int_to_string(i))
            }
        }
        var pos_got_local = local_got_pos[i]
        var got_idx_local = local_got_index[i]
        var got_entry_addr_local = data_vmaddr + got_offset + (got_idx_local * 8)
        var pc_got_local = text_base + header_size + pos_got_local
        var pc_page3_local = pc_got_local - int_mod(pc_got_local, 4096)
        var target_page3_local = got_entry_addr_local - int_mod(got_entry_addr_local, 4096)
        var delta_pages3_local = (target_page3_local - pc_page3_local) / 4096
        var page_off3_local = int_mod(got_entry_addr_local, 4096)
        set_u32_le(code, pos_got_local, insn_adrp(16, delta_pages3_local))
        set_u32_le(code, pos_got_local + 4, insn_add_imm(16, 16, page_off3_local))
        i = i + 1
    }
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.fixups.local.got.done", "n=" + oren_int_to_string(local_got_n)) }
    if phase_log != nil {
        _macho_phase_log_append(phase_log, "macho.fixups.local.done", "n=" + oren_int_to_string(oren_list_len(fixups)))
        _macho_phase_log_append(phase_log, "macho.fixups.done", "total=" + oren_int_to_string(rtobj_fixups_n + oren_list_len(fixups)))
    }
    if trace_emit { print("[emit] macho arm64: apply fixups done") }
    
    // Pad strtab to 16 bytes for stable layout/alignment.
    _macho_align(strtab, 16)
    
    var symtab_size = bytes_len(symtab)
    var strtab_size = bytes_len(strtab)
    var imports_len = oren_list_len(imports)
    var indsymtab_size = imports_len * 4
    
    // Entry point is start of code (startup shim)
    var entry_idx = 0
    var bind_off = text_size + data_size
    
    var prefix = macho_build_prefix_arm64(text_size, data_size, data_len, entry_idx, header_size, imports_len, symtab_size, strtab_size, bind_size, bind_off, libs, is_shared, out_path)
    
    bytes_extend(prefix, code)
    _macho_pad_to_len(prefix, text_size)
    bytes_extend(prefix, data)
    _macho_pad_to_len(prefix, text_size + data_size)
    
    // LinkEdit content
    bytes_extend(prefix, bind_opcodes)
    bytes_extend(prefix, symtab)
    bytes_extend(prefix, indsymtab)
    bytes_extend(prefix, strtab)
    
    var w2 = oren_write_bytes(out_path, bytes_finalize(prefix))
    if oren_is_err(w2) {
        var msg = oren_err_msg(w2)
        var e = "Failed to write output: " + out_path
        if msg != nil { e = e + ": " + msg }
        print("OREN_DIAG kind=codegen code=2 msg=" + macho_diag_escape(e))
        print(e)
        oren_exit(1)
    }
    if phase_log != nil { _macho_phase_log_append(phase_log, "macho.write.done", "out=" + out_path) }
    oren_chmod(out_path, 493) // 0755
    return nil
}
