// CoreIR scaffolding (rolling, v0).
//
// This is the first step toward a shared, semantics-owning IR that unifies all backends.
//
// For now, "CoreIR v0" is intentionally minimal: it provides deterministic program metadata
// extraction that multiple backends need (function list, arity, varargs info, declaration order).
//
// Design constraints:
// - backend-neutral: this module must not depend on ISA/ABI emitters
// - deterministic: preserve source order and stable error strings (by caller-provided prefix)
// - rolling: fields may expand as we migrate more semantics into CoreIR (calls/closures/containers)

fn _err(ctx, prefix, msg) {
    if ctx == nil { return nil }
    if ctx["errors"] == nil { ctx["errors"] = [] }
    var p = prefix
    if p == nil || p == "" { p = "coreir" }
    oren_list_push(ctx["errors"], p + ": " + msg)
    return nil
}

fn _stmt_to_function_decl(stmt) {
    // Top-level named function declarations are represented as either:
    // - a raw Function node (rare)
    // - ExprStmt(Function) (the common parse form)
    //
    // IMPORTANT: anonymous Function literals (name="") are NOT treated as declarations.
    // They are first-class values (lambdas) and must be collected/compiled via the callable path.
    if stmt == nil { return nil }
    if stmt["type"] == "Function" {
        var nm0 = stmt["name"]
        if nm0 != nil && nm0 != "" { return stmt }
        return nil
    }
    if stmt["type"] == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "Function" {
            var nm1 = e["name"]
            if nm1 != nil && nm1 != "" { return e }
        }
    }
    return nil
}

// Extract top-level named function declarations and populate function metadata in `ctx`.
//
// Side effects on `ctx`:
// - ctx["declared_functions"]: map name->1 for declared functions
// - ctx["func_arity"]: map name->param_count
// - ctx["func_varargs_fixed"]: map name->fixed_param_count for varargs functions
// - ctx["func_ret_kinds"]: map name->ret_ann_type when annotated
// - ctx["func_decl_order"]: list of function names in deterministic (source) order
//
// Returns a list of Function AST nodes (in source order), or nil on error.
fn collect_top_level_functions(ctx, linked, err_prefix) {
    var stmts = nil
    if linked != nil { stmts = linked["statements"] }
    if stmts == nil {
        // Keep the caller's error prefix so existing backend messages stay stable.
        if err_prefix != nil && err_prefix != "" { _err(ctx, err_prefix, "missing program statements") }
        else { _err(ctx, "coreir", "missing program statements") }
        return nil
    }

    if ctx["func_arity"] == nil { ctx["func_arity"] = {} }
    if ctx["func_varargs_fixed"] == nil { ctx["func_varargs_fixed"] = {} }
    if ctx["func_ret_kinds"] == nil { ctx["func_ret_kinds"] = {} }
    if ctx["func_decl_order"] == nil { ctx["func_decl_order"] = [] }

    var out = []
    var declared = {}
    var i = 0
    while i < oren_list_len(stmts) {
        var fn0 = _stmt_to_function_decl(stmts[i])
        if fn0 != nil {
            var name = fn0["name"]
            if name == nil { _err(ctx, err_prefix, "function missing name"); return nil }
            if declared[name] != nil { _err(ctx, err_prefix, "duplicate function " + name); return nil }
            declared[name] = 1

            var params = fn0["params"]
            var pc = 0
            if params != nil { pc = oren_list_len(params) }
            var j = 0
            while j < pc {
                var p = params[j]
                if p == nil || p["type"] != "Identifier" {
                    _err(ctx, err_prefix, "param must be identifier: " + name)
                    return nil
                }
                j = j + 1
            }

            // Record arity and optional varargs fixed count (last param is `...rest`).
            //
            // IMPORTANT (compiler metadata encoding):
            // Several compiler maps store small integer payloads as `n+1` so:
            // - `nil` can remain the sentinel for "missing", and
            // - call sites can decode with `enc-1` without needing special cases for 0.
            ctx["func_arity"][name] = pc + 1
            if fn0["ret_ann_type"] != nil { ctx["func_ret_kinds"][name] = fn0["ret_ann_type"] }
            if pc > 0 {
                var last = params[pc - 1]
                if last != nil && last["is_varargs"] == true {
                    ctx["func_varargs_fixed"][name] = (pc - 1) + 1
                }
            }

            if name != "" { oren_list_push(ctx["func_decl_order"], name) }
            oren_list_push(out, fn0)
        }
        i = i + 1
    }

    ctx["declared_functions"] = declared
    return out
}

// Merge top-level named function declarations from `linked` into an existing `ctx`.
//
// This is used by build pipelines that pre-seed `ctx` with additional function metadata
// (e.g. from a cached compiled runtime object) and then need to add user program functions
// without clobbering the existing maps.
//
// Side effects (merged):
// - ctx["declared_functions"] (adds new names; errors on duplicates)
// - ctx["func_arity"], ctx["func_varargs_fixed"], ctx["func_ret_kinds"], ctx["func_decl_order"]
//
// Returns a list of Function AST nodes (from `linked`, in source order), or nil on error.
fn collect_top_level_functions_merge(ctx, linked, err_prefix) {
    var stmts = nil
    if linked != nil { stmts = linked["statements"] }
    if stmts == nil {
        if err_prefix != nil && err_prefix != "" { _err(ctx, err_prefix, "missing program statements") }
        else { _err(ctx, "coreir", "missing program statements") }
        return nil
    }

    if ctx["func_arity"] == nil { ctx["func_arity"] = {} }
    if ctx["func_varargs_fixed"] == nil { ctx["func_varargs_fixed"] = {} }
    if ctx["func_ret_kinds"] == nil { ctx["func_ret_kinds"] = {} }
    if ctx["func_decl_order"] == nil { ctx["func_decl_order"] = [] }

    var declared = ctx["declared_functions"]
    if declared == nil { declared = {} }

    var out = []
    var i = 0
    while i < oren_list_len(stmts) {
        var fn0 = _stmt_to_function_decl(stmts[i])
        if fn0 != nil {
            var name = fn0["name"]
            if name == nil { _err(ctx, err_prefix, "function missing name"); return nil }
            if declared[name] != nil { _err(ctx, err_prefix, "duplicate function " + name); return nil }
            declared[name] = 1

            var params = fn0["params"]
            var pc = 0
            if params != nil { pc = oren_list_len(params) }
            var j = 0
            while j < pc {
                var p = params[j]
                if p == nil || p["type"] != "Identifier" {
                    _err(ctx, err_prefix, "param must be identifier: " + name)
                    return nil
                }
                j = j + 1
            }

            ctx["func_arity"][name] = pc + 1
            if fn0["ret_ann_type"] != nil { ctx["func_ret_kinds"][name] = fn0["ret_ann_type"] }
            if pc > 0 {
                var last = params[pc - 1]
                if last != nil && last["is_varargs"] == true {
                    ctx["func_varargs_fixed"][name] = (pc - 1) + 1
                }
            }

            if name != "" { oren_list_push(ctx["func_decl_order"], name) }
            oren_list_push(out, fn0)
        }
        i = i + 1
    }

    ctx["declared_functions"] = declared
    return out
}

fn _numeric_ann_trait(ann) {
    if ann == nil { return nil }
    if oren_string_len(ann) > 5 {
        if oren_string_slice(ann, 0, 5) == "oren." { ann = oren_string_slice(ann, 5, oren_string_len(ann)) }
    }
    if ann == "f32" || ann == "f64" { return "float" }
    if ann == "i8" || ann == "u8" || ann == "i16" || ann == "u16" { return "int" }
    if ann == "i32" || ann == "u32" || ann == "i64" || ann == "u64" { return "int" }
    if ann == "int" || ann == "bool" { return "int" }
    return nil
}

fn _numeric_param_key(i) { return oren_int_to_string(i) }

fn _numeric_local_set(name, kind, locals_floaty, locals_inty) {
    if name == nil || name == "" { return nil }
    if locals_floaty != nil { locals_floaty[name] = nil }
    if locals_inty != nil { locals_inty[name] = nil }
    if kind == "float" {
        if locals_floaty != nil { locals_floaty[name] = true }
        return nil
    }
    if kind == "int" {
        if locals_inty != nil { locals_inty[name] = true }
        return nil
    }
    return nil
}

fn _numeric_evidence_add(evidence, fn_name, arg_i, kind) {
    if evidence == nil || fn_name == nil || fn_name == "" { return nil }
    var m = evidence[fn_name]
    if m == nil { m = {}; evidence[fn_name] = m }
    var k = _numeric_param_key(arg_i)
    var prev = m[k]
    var next = 0
    if kind == "int" { next = 1 }
    else if kind == "float" { next = 2 }
    else { next = 4 }
    if prev == nil { m[k] = next; return nil }
    if prev == next { return nil }
    m[k] = 3
    return nil
}

fn _numeric_expr_trait(ctx, expr, locals_floaty, locals_inty) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Float" { return "float" }
    if t == "Integer" || t == "Boolean" { return "int" }
    if t == "Identifier" {
        var nm = expr["value"]
        if locals_floaty != nil && locals_floaty[nm] == true { return "float" }
        if locals_inty != nil && locals_inty[nm] == true { return "int" }
        return nil
    }
    if t == "Prefix" { return _numeric_expr_trait(ctx, expr["right"], locals_floaty, locals_inty) }
    if t == "Infix" {
        var lt = _numeric_expr_trait(ctx, expr["left"], locals_floaty, locals_inty)
        var rt = _numeric_expr_trait(ctx, expr["right"], locals_floaty, locals_inty)
        if lt == "float" || rt == "float" { return "float" }
        if lt == "int" && rt == "int" { return "int" }
        return nil
    }
    if t == "Call" {
        var fn0 = expr["fn"]
        var fn_name = nil
        if fn0 != nil && fn0["type"] == "Identifier" { fn_name = fn0["value"] }
        if fn_name != nil {
            if fn_name == "oren_trunc_int" { return "int" }
            if fn_name == "oren_u32_bits_to_f32" || fn_name == "oren_u64_bits_to_f64" { return "float" }
            var ret = nil
            if ctx != nil && ctx["func_ret_kinds"] != nil { ret = ctx["func_ret_kinds"][fn_name] }
            return _numeric_ann_trait(ret)
        }
        return nil
    }
    return nil
}

fn _numeric_scan_expr(ctx, expr, locals_floaty, locals_inty, fn_by_name, evidence) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Call" {
        var fn0 = expr["fn"]
        var fn_name = nil
        if fn0 != nil && fn0["type"] == "Identifier" { fn_name = fn0["value"] }
        var args = expr["args"]
        if args == nil { args = [] }
        if fn_name != nil && fn_by_name != nil && fn_by_name[fn_name] != nil {
            var i = 0
            while i < oren_list_len(args) {
                _numeric_scan_expr(ctx, args[i], locals_floaty, locals_inty, fn_by_name, evidence)
                _numeric_evidence_add(evidence, fn_name, i, _numeric_expr_trait(ctx, args[i], locals_floaty, locals_inty))
                i = i + 1
            }
        } else {
            _numeric_scan_expr(ctx, fn0, locals_floaty, locals_inty, fn_by_name, evidence)
            var j = 0
            while j < oren_list_len(args) {
                _numeric_scan_expr(ctx, args[j], locals_floaty, locals_inty, fn_by_name, evidence)
                j = j + 1
            }
        }
        return nil
    }
    if t == "Infix" {
        _numeric_scan_expr(ctx, expr["left"], locals_floaty, locals_inty, fn_by_name, evidence)
        _numeric_scan_expr(ctx, expr["right"], locals_floaty, locals_inty, fn_by_name, evidence)
        return nil
    }
    if t == "Prefix" { return _numeric_scan_expr(ctx, expr["right"], locals_floaty, locals_inty, fn_by_name, evidence) }
    if t == "Index" {
        _numeric_scan_expr(ctx, expr["left"], locals_floaty, locals_inty, fn_by_name, evidence)
        _numeric_scan_expr(ctx, expr["index"], locals_floaty, locals_inty, fn_by_name, evidence)
        return nil
    }
    if t == "Member" { return _numeric_scan_expr(ctx, expr["left"], locals_floaty, locals_inty, fn_by_name, evidence) }
    if t == "List" {
        var es = expr["elements"]
        if es == nil { es = [] }
        var li = 0
        while li < oren_list_len(es) {
            _numeric_scan_expr(ctx, es[li], locals_floaty, locals_inty, fn_by_name, evidence)
            li = li + 1
        }
        return nil
    }
    if t == "Map" {
        var ps = expr["pairs"]
        if ps == nil { ps = [] }
        var mi = 0
        while mi < oren_list_len(ps) {
            var p = ps[mi]
            if p != nil {
                _numeric_scan_expr(ctx, p["key"], locals_floaty, locals_inty, fn_by_name, evidence)
                _numeric_scan_expr(ctx, p["value"], locals_floaty, locals_inty, fn_by_name, evidence)
            }
            mi = mi + 1
        }
    }
    return nil
}

fn _numeric_scan_stmt_list(ctx, stmts, locals_floaty, locals_inty, fn_by_name, evidence) {
    if stmts == nil { return nil }
    var i = 0
    while i < oren_list_len(stmts) {
        _numeric_scan_stmt(ctx, stmts[i], locals_floaty, locals_inty, fn_by_name, evidence)
        i = i + 1
    }
    return nil
}

fn _numeric_scan_stmt(ctx, stmt, locals_floaty, locals_inty, fn_by_name, evidence) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "ExprStmt" {
        _numeric_scan_expr(ctx, stmt["expr"], locals_floaty, locals_inty, fn_by_name, evidence)
        return nil
    }
    if t == "Return" {
        _numeric_scan_expr(ctx, stmt["value"], locals_floaty, locals_inty, fn_by_name, evidence)
        return nil
    }
    if t == "Var" || t == "Assign" {
        var v = stmt["value"]
        _numeric_scan_expr(ctx, v, locals_floaty, locals_inty, fn_by_name, evidence)
        var nm = nil
        if stmt["name"] != nil { nm = stmt["name"]["value"] }
        _numeric_local_set(nm, _numeric_expr_trait(ctx, v, locals_floaty, locals_inty), locals_floaty, locals_inty)
        return nil
    }
    if t == "Set" {
        _numeric_scan_expr(ctx, stmt["left"], locals_floaty, locals_inty, fn_by_name, evidence)
        _numeric_scan_expr(ctx, stmt["value"], locals_floaty, locals_inty, fn_by_name, evidence)
        return nil
    }
    if t == "Block" {
        var bs = stmt["statements"]
        if bs == nil { bs = stmt["stmts"] }
        return _numeric_scan_stmt_list(ctx, bs, locals_floaty, locals_inty, fn_by_name, evidence)
    }
    if t == "If" {
        _numeric_scan_expr(ctx, stmt["cond"], locals_floaty, locals_inty, fn_by_name, evidence)
        _numeric_scan_stmt(ctx, stmt["consq"], locals_floaty, locals_inty, fn_by_name, evidence)
        _numeric_scan_stmt(ctx, stmt["alt"], locals_floaty, locals_inty, fn_by_name, evidence)
        return nil
    }
    if t == "While" {
        _numeric_scan_expr(ctx, stmt["cond"], locals_floaty, locals_inty, fn_by_name, evidence)
        _numeric_scan_stmt(ctx, stmt["body"], locals_floaty, locals_inty, fn_by_name, evidence)
        return nil
    }
    if t == "For" {
        _numeric_scan_stmt(ctx, stmt["init"], locals_floaty, locals_inty, fn_by_name, evidence)
        _numeric_scan_expr(ctx, stmt["cond"], locals_floaty, locals_inty, fn_by_name, evidence)
        _numeric_scan_stmt(ctx, stmt["body"], locals_floaty, locals_inty, fn_by_name, evidence)
        _numeric_scan_stmt(ctx, stmt["post"], locals_floaty, locals_inty, fn_by_name, evidence)
        return nil
    }
    if t == "Function" { return nil }
    return nil
}

fn _numeric_seed_param_maps(ctx, fn0, prev_floaty, prev_inty, locals_floaty, locals_inty) {
    if fn0 == nil { return nil }
    var name = fn0["name"]
    var params = fn0["params"]
    if params == nil { params = [] }
    var fn_prev_floaty = nil
    var fn_prev_inty = nil
    if prev_floaty != nil { fn_prev_floaty = prev_floaty[name] }
    if prev_inty != nil { fn_prev_inty = prev_inty[name] }
    var i = 0
    while i < oren_list_len(params) {
        var p = params[i]
        var pn = nil
        if p != nil { pn = p["value"] }
        var tr = nil
        if p != nil { tr = _numeric_ann_trait(p["ann_type"]) }
        var k = _numeric_param_key(i)
        if tr == nil && fn_prev_floaty != nil && fn_prev_floaty[k] == true { tr = "float" }
        if tr == nil && fn_prev_inty != nil && fn_prev_inty[k] == true { tr = "int" }
        _numeric_local_set(pn, tr, locals_floaty, locals_inty)
        i = i + 1
    }
    return nil
}

fn infer_native_param_numeric_traits(ctx, fns, top_fn, err_prefix) {
    if ctx == nil { return nil }
    if fns == nil { fns = [] }
    var fn_by_name = {}
    var i = 0
    while i < oren_list_len(fns) {
        var fn0 = fns[i]
        if fn0 != nil && fn0["name"] != nil && fn0["name"] != "" { fn_by_name[fn0["name"]] = fn0 }
        i = i + 1
    }
    var prev_floaty = {}
    var prev_inty = {}
    var iter = 0
    while iter < 8 {
        var evidence = {}
        i = 0
        while i < oren_list_len(fns) {
            var fn1 = fns[i]
            if fn1 != nil {
                var lf = {}
                var li = {}
                _numeric_seed_param_maps(ctx, fn1, prev_floaty, prev_inty, lf, li)
                _numeric_scan_stmt(ctx, fn1["body"], lf, li, fn_by_name, evidence)
            }
            i = i + 1
        }
        if top_fn != nil {
            var tlf = {}
            var tli = {}
            _numeric_scan_stmt(ctx, top_fn["body"], tlf, tli, fn_by_name, evidence)
        }
        var next_floaty = {}
        var next_inty = {}
        i = 0
        while i < oren_list_len(fns) {
            var fn2 = fns[i]
            if fn2 != nil {
                var nm = fn2["name"]
                var params = fn2["params"]
                if params == nil { params = [] }
                var ev = evidence[nm]
                var nf = {}
                var ni = {}
                var pi = 0
                while pi < oren_list_len(params) {
                    var k = _numeric_param_key(pi)
                    var st = nil
                    if ev != nil { st = ev[k] }
                    if st == 2 { nf[k] = true }
                    if st == 1 { ni[k] = true }
                    pi = pi + 1
                }
                if oren_map_len(nf) > 0 { next_floaty[nm] = nf }
                if oren_map_len(ni) > 0 { next_inty[nm] = ni }
            }
            i = i + 1
        }
        prev_floaty = next_floaty
        prev_inty = next_inty
        iter = iter + 1
    }
    ctx["func_param_floaty"] = prev_floaty
    ctx["func_param_inty"] = prev_inty
    return nil
}
