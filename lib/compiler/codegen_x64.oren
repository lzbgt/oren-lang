// Thin facade module for x86_64 native backend (Tier-1; rolling).
//
// The x64 backend is brought up incrementally, but the intent is full-feature parity
// with arm64 native. This facade exists to keep emitter modules stable while the
// backend evolves (runtime injection, ABI tables, shared NativeIR, etc.).

import core "x64_core.oren"
import prog "x64_native_program.oren"

// Binary utils
fn bytes_new() { return core.bytes_new() }
fn bytes_push(b, v) { return core.bytes_push(b, v) }
fn bytes_extend(b, other) { return core.bytes_extend(b, other) }
fn bytes_extend_list(b, xs) { return core.bytes_extend_list(b, xs) }
fn bytes_len(b) { return core.bytes_len(b) }
fn bytes_finalize(b) { return core.bytes_finalize(b) }

fn push_u32_le(buf, n) { return core.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return core.push_u64_le(buf, n) }
fn set_u32_le(buf, offset, n) { return core.set_u32_le(buf, offset, n) }
fn int_mod(a, b) { return core.int_mod(a, b) }

// Instructions used by emitters
fn insn_ret() { return core.insn_ret() }

// Top-level compilation entry
fn native_compile_program_x64(linked, platform) { return prog.native_compile_program_x64(linked, platform) }
fn native_emit_errors_and_exit(ctx) { return prog.native_emit_errors_and_exit(ctx) }
