// Oren compiler: module renaming pass (prefix-based).
//
// Single responsibility:
// - Collect top-level rename pairs for a module prefix
// - Rewrite a parsed AST in-place so all top-level symbols become unique
//
// This is used by the compiler module loader/linker. It is intentionally backend-agnostic.

fn _rename_ann_type(pairs, ann) {
    // Rename a type annotation string using the same `pairs` map used for identifier renaming.
    //
    // This is intentionally conservative:
    // - builtins (u8/i32/f64/bool/...) are not in `pairs` and remain unchanged
    // - local declared types (struct/class names) are in `pairs` and get prefixed
    // - module import aliases are in `pairs` and the *first segment* of `alias.Type` gets namespaced
    //
    // NOTE: imported type names still need a later resolution step:
    //   <alias_ns>.Type  ->  <dep_prefix>Type
    // because the renamer doesn't know which module an alias refers to.
    if ann == nil || ann == "" { return ann }

    // Preserve leading pointer stars.
    var stars = ""
    while oren_string_len(ann) > 0 && oren_string_char_at(ann, 0) == "*" {
        stars = stars + "*"
        ann = oren_string_slice(ann, 1, oren_string_len(ann))
    }

    // Preserve leading typed-buffer / slice prefixes: `[]T`, `[][]T`, ...
    var slices = ""
    while oren_string_len(ann) >= 2 && oren_string_char_at(ann, 0) == "[" && oren_string_char_at(ann, 1) == "]" {
        slices = slices + "[]"
        ann = oren_string_slice(ann, 2, oren_string_len(ann))
    }

    // Split base name vs array suffixes like `T[16][4]`.
    var base = ann
    var suffix = ""
    var i = 0
    while i < oren_string_len(ann) {
        if oren_string_char_at(ann, i) == "[" {
            base = oren_string_slice(ann, 0, i)
            suffix = oren_string_slice(ann, i, oren_string_len(ann))
            break
        }
        i = i + 1
    }

    if _ann_base_is_builtin(base) == true {
        return stars + slices + base + suffix
    }

    // Fast path: plain name.
    var mapped = rename_lookup(pairs, base)
    if mapped != "" {
        return stars + slices + mapped + suffix
    }

    // Dotted: rename only the leftmost segment (alias).
    i = 0
    while i < oren_string_len(base) {
        if oren_string_char_at(base, i) == "." {
            var head = oren_string_slice(base, 0, i)
            var tail = oren_string_slice(base, i, oren_string_len(base))
            var head2 = rename_lookup(pairs, head)
            if head2 != "" {
                return stars + slices + head2 + tail + suffix
            }
            break
        }
        i = i + 1
    }

    return stars + slices + base + suffix
}

fn _ann_base_is_builtin(base) {
    if base == "any" { return true }
    if base == "bool" { return true }
    if base == "bytes" { return true }
    if base == "buf" { return true }
    if base == "float" { return true }
    if base == "int" { return true }
    if base == "list" { return true }
    if base == "map" { return true }
    if base == "nil" { return true }
    if base == "string" { return true }
    if base == "i8" || base == "i16" || base == "i32" || base == "i64" || base == "i128" { return true }
    if base == "u8" || base == "u16" || base == "u32" || base == "u64" || base == "u128" { return true }
    if base == "f32" || base == "f64" { return true }
    return false
}

fn collect_toplevel_rename_pairs(prog, prefix) {
    var pairs = {}
    var i = 0
    var stmts = prog["statements"]
    while i < oren_list_len(stmts) {
        var stmt = stmts[i]
        var ty = stmt["type"]
        if ty == "Var" {
            var name_node = stmt["name"]
            var name = name_node["value"]
            pairs[name] = prefix + name
        } else if ty == "Function" {
            var name2 = stmt["name"]
            pairs[name2] = prefix + name2
        } else if ty == "ExprStmt" {
            var expr = stmt["expr"]
            if expr["type"] == "Function" {
                var name3 = expr["name"]
                if name3 != "" { pairs[name3] = prefix + name3 }
            }
        } else if ty == "Type" {
            var name4_node = stmt["name"]
            var name4 = name4_node["value"]
            pairs[name4] = prefix + name4
        } else if ty == "FFI" {
            // Allow `ffi foo` decls to be exported as module members:
            // `import m "..." ; m.foo(...)`
            //
            // IMPORTANT: `stmt["link_name"]` (external symbol name) must NOT be renamed here.
            var name5_node = stmt["name"]
            var name5 = name5_node["value"]
            pairs[name5] = prefix + name5
        }
        i = i + 1
    }
    return pairs
}

fn rename_lookup(pairs, name) {
    if pairs[name] != nil { return pairs[name] }
    return ""
}

fn scope_has(stack, name) {
    var cur = stack
    while cur != nil {
        var decls = cur["decls"]
        if decls != nil && decls[name] == true { return true }
        cur = cur["parent"]
    }
    return false
}

fn scope_declare(stack, name) {
    if stack == nil { return nil }
    var decls = stack["decls"]
    if decls == nil {
        decls = {}
        stack["decls"] = decls
    }
    decls[name] = true
    return nil
}

fn scope_push(stack) {
    return {"parent": stack, "decls": {}}
}

fn rename_program_in_place(prog, pairs) {
    var stmts = prog["statements"]
    var stack = nil
    // GC safety (rolling):
    // The compiler stage2 build enables auto-GC and may use bounded conservative stack scanning.
    // During deep recursive renaming, key locals (`prog`, `pairs`, `stack`) can live beyond the
    // scanned region or in registers; if the collector misses them it can free live AST nodes,
    // causing non-deterministic panics under parallel builds.
    //
    // Pin a single composite root for the duration of this traversal.
    var gcroot = {"prog": prog, "pairs": pairs, "stack": stack}
    var prev_pin = oren_gc_pin(gcroot)
    var i = 0
    var n = oren_list_len(stmts)
    while i < n {
        rename_stmt(stmts[i], pairs, stack, true)
        i = i + 1
    }
    oren_gc_pin(prev_pin)
}

fn rename_stmt(stmt, pairs, stack, at_top_level) {
    if stmt == nil { return nil }
    var ty = stmt["type"]
    if ty == "Import" { return nil }
    if ty == "Var" {
        var name_node = stmt["name"]
        var name = name_node["value"]
        if at_top_level {
            var new_name = rename_lookup(pairs, name)
            if new_name != "" { name_node["value"] = new_name }
        } else {
            scope_declare(stack, name)
        }
        if name_node != nil && name_node["ann_type"] != nil {
            name_node["ann_type"] = _rename_ann_type(pairs, name_node["ann_type"])
        }
        rename_expr(stmt["value"], pairs, stack)
        return nil
    }
    if ty == "Assign" {
        var assign_name = stmt["name"]
        if assign_name != nil {
            var target = assign_name["value"]
            var new_name2 = rename_lookup(pairs, target)
            if new_name2 != "" && !scope_has(stack, target) {
                assign_name["value"] = new_name2
            }
        }
        rename_expr(stmt["value"], pairs, stack)
        return nil
    }
    if ty == "Set" {
        rename_expr(stmt["left"], pairs, stack)
        rename_expr(stmt["value"], pairs, stack)
        return nil
    }
    if ty == "Return" {
        rename_expr(stmt["value"], pairs, stack)
        return nil
    }
    if ty == "Spawn" {
        // `spawn foo(...)` is represented as a statement containing a call expression.
        // Renaming must recurse into it so intra-module references are prefixed correctly.
        rename_expr(stmt["call"], pairs, stack)
        return nil
    }
    if ty == "Function" {
        var fn_name = stmt["name"]
        if at_top_level {
            var new_name3 = rename_lookup(pairs, fn_name)
            if new_name3 != "" { stmt["name"] = new_name3 }
        } else {
            if fn_name != "" { scope_declare(stack, fn_name) }
        }
        var next = scope_push(stack)
        var i = 0
        var params = stmt["params"]
        var params_n = oren_list_len(params)
        while i < params_n {
            var param = params[i]
            if param["ann_type"] != nil {
                param["ann_type"] = _rename_ann_type(pairs, param["ann_type"])
            }
            scope_declare(next, param["value"])
            i = i + 1
        }
        if stmt["ret_ann_type"] != nil {
            stmt["ret_ann_type"] = _rename_ann_type(pairs, stmt["ret_ann_type"])
        }
        rename_stmt(stmt["body"], pairs, next, false)
        return nil
    }
    if ty == "Block" {
        var next2 = scope_push(stack)
        var stmts2 = stmt["stmts"]
        var i2 = 0
        var stmts2_n = oren_list_len(stmts2)
        while i2 < stmts2_n {
            rename_stmt(stmts2[i2], pairs, next2, false)
            i2 = i2 + 1
        }
        return nil
    }
    if ty == "ExprStmt" {
        var expr = stmt["expr"]
        if expr != nil {
            if at_top_level && expr["type"] == "Function" {
                if expr["name"] != "" {
                    var new_name4 = rename_lookup(pairs, expr["name"])
                    if new_name4 != "" { expr["name"] = new_name4 }
                }
                // Impl blocks are lowered to plain functions with metadata fields.
                // Ensure their recorded impl type name stays consistent with renaming.
                if expr["impl_type"] != nil {
                    expr["impl_type"] = _rename_ann_type(pairs, expr["impl_type"])
                }
            }
            rename_expr(expr, pairs, stack)
        }
        return nil
    }
    if ty == "If" {
        rename_expr(stmt["cond"], pairs, stack)
        rename_stmt(stmt["consq"], pairs, stack, false)
        rename_stmt(stmt["alt"], pairs, stack, false)
        return nil
    }
    if ty == "While" {
        rename_expr(stmt["cond"], pairs, stack)
        rename_stmt(stmt["body"], pairs, stack, false)
        return nil
    }
    if ty == "For" {
        var next3 = scope_push(stack)
        rename_stmt(stmt["init"], pairs, next3, false)
        rename_expr(stmt["cond"], pairs, next3)
        rename_stmt(stmt["post"], pairs, next3, false)
        rename_stmt(stmt["body"], pairs, next3, false)
        return nil
    }
    if ty == "Type" {
        var type_name = stmt["name"]
        if at_top_level {
            var new_name5 = rename_lookup(pairs, type_name["value"])
            if new_name5 != "" { type_name["value"] = new_name5 }
        }
        // Field annotations are stored on Identifier nodes in `fields`.
        var fs = stmt["fields"]
        if fs != nil {
            var fi = 0
            var fs_n = oren_list_len(fs)
            while fi < fs_n {
                var f = fs[fi]
                if f != nil && f["ann_type"] != nil {
                    f["ann_type"] = _rename_ann_type(pairs, f["ann_type"])
                }
                fi = fi + 1
            }
        }
        return nil
    }
    if ty == "FFI" {
        // Rename the internal stub/function label so module member access works.
        // Do not rewrite `stmt["link_name"]` (external symbol lookup name).
        var ffi_name = stmt["name"]
        if at_top_level && ffi_name != nil {
            var old = ffi_name["value"]
            var new_name = rename_lookup(pairs, old)
            if new_name != "" { ffi_name["value"] = new_name }
        }
        return nil
    }
    return nil
}

fn rename_expr(expr, pairs, stack) {
    if expr == nil { return nil }
    var ty = expr["type"]
    if ty == "Identifier" {
        var value = expr["value"]
        if scope_has(stack, value) { return nil }
        var new_name = rename_lookup(pairs, value)
        if new_name != "" { expr["value"] = new_name }
        return nil
    }
    if ty == "Function" {
        var fn_name = expr["name"]
        if fn_name != "" {
            var new_name_fn = rename_lookup(pairs, fn_name)
            if new_name_fn != "" { expr["name"] = new_name_fn }
        }
        var next = scope_push(stack)
        var i = 0
        var params = expr["params"]
        var params_n = oren_list_len(params)
        while i < params_n {
            var param = params[i]
            if param["ann_type"] != nil {
                param["ann_type"] = _rename_ann_type(pairs, param["ann_type"])
            }
            scope_declare(next, param["value"])
            i = i + 1
        }
        if expr["ret_ann_type"] != nil {
            expr["ret_ann_type"] = _rename_ann_type(pairs, expr["ret_ann_type"])
        }
        rename_stmt(expr["body"], pairs, next, false)
        return nil
    }
    if ty == "Call" {
        rename_expr(expr["fn"], pairs, stack)
        var args = expr["args"]
        var i2 = 0
        var args_n = oren_list_len(args)
        while i2 < args_n {
            rename_expr(args[i2], pairs, stack)
            i2 = i2 + 1
        }
        return nil
    }
    if ty == "SpawnExpr" {
        // Expression form: `spawn foo(...)` used in initializers/expressions.
        // Must be renamed so the callee identifier is prefixed correctly.
        rename_expr(expr["call"], pairs, stack)
        return nil
    }
    if ty == "Infix" {
        rename_expr(expr["left"], pairs, stack)
        rename_expr(expr["right"], pairs, stack)
        return nil
    }
    if ty == "Prefix" {
        rename_expr(expr["right"], pairs, stack)
        return nil
    }
    if ty == "Hash" {
        var pairs_list = expr["pairs"]
        var i3 = 0
        var pairs_n = oren_list_len(pairs_list)
        while i3 < pairs_n {
            var pair = pairs_list[i3]
            rename_expr(pair["value"], pairs, stack)
            i3 = i3 + 1
        }
        return nil
    }
    if ty == "Member" {
        rename_expr(expr["left"], pairs, stack)
        return nil
    }
    if ty == "Index" {
        rename_expr(expr["left"], pairs, stack)
        rename_expr(expr["index"], pairs, stack)
        return nil
    }
    if ty == "Array" {
        var elements = expr["elements"]
        var i2 = 0
        var elements_n = oren_list_len(elements)
        while i2 < elements_n {
            rename_expr(elements[i2], pairs, stack)
            i2 = i2 + 1
        }
        return nil
    }
    if ty == "If" {
        rename_expr(expr["cond"], pairs, stack)
        rename_stmt(expr["consq"], pairs, stack, false)
        rename_stmt(expr["alt"], pairs, stack, false)
        return nil
    }
    return nil
}
