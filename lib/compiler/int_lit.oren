// Integer literal parsing utilities (rolling).
//
// Goal:
// - Keep integer literal interpretation consistent across compiler subsystems:
//   optimizer folding, C transpiler, native backends, etc.
//
// Supported forms:
// - optional leading sign: + / -
// - base prefixes: 0x / 0b / 0o (after optional sign)
// - `_` separators (ignored)
//
// Returns:
// - signed i64 (Oren `int`) on success
// - `oren_err(code, msg)` on invalid digit or overflow

fn parse_int_lit(s) {
    // NOTE (native runtime):
    // `nil/false/0` collapse to 0 in some contexts today (until value tagging lands).
    // Returning `nil` as an error sentinel is therefore not safe for integer parsing
    // (the literal "0" becomes indistinguishable from failure).
    //
    // Use structured errors instead, which are tagged map pointers and remain
    // discriminable via `oren_is_err(...)`.
    if s == nil { return oren_err(8, "int literal parse: nil input") }
    // IMPORTANT (native backend correctness + perf):
    // Parse via raw bytes instead of 1-byte string objects.
    //
    // Rationale:
    // - Avoid relying on string equality semantics between cached 1-byte strings and
    //   embedded literals (this broke stage2-native x64 builds in practice).
    // - Avoid O(n²) behavior under the native runtime (`oren_string_char_at` is length-checked).
    var sl = oren_string_len(s)
    var i = 0
    var neg = false

    if sl > 0 {
        var b0 = oren_string_byte_at_unchecked(s, 0) & 255
        if b0 == 45 { neg = true; i = 1 }      // '-'
        else if b0 == 43 { i = 1 }             // '+'
    }

    var base = 10
    if i + 1 < sl && (oren_string_byte_at_unchecked(s, i) & 255) == 48 { // '0'
        var b1 = oren_string_byte_at_unchecked(s, i + 1) & 255
        if b1 == 120 || b1 == 88 { base = 16; i = i + 2 }               // x / X
        else if b1 == 98 || b1 == 66 { base = 2; i = i + 2 }            // b / B
        else if b1 == 111 || b1 == 79 { base = 8; i = i + 2 }           // o / O
    }

    // Parse magnitude into an unsigned 64-bit accumulator represented as two u32 lanes
    // (hi:lo). This lets us accept literals like 9223372036854775808 (2^63) which are
    // used as bit masks in stdlib code, even though they don't fit into signed i64.
    //
    // The final returned value is always a signed i64 (Oren `int`) that represents the
    // same low-64-bit two's-complement bit pattern.
    var U32_MOD = 4294967296
    var SIGN_HI = 2147483648 // 2^31, i.e. the sign bit within the hi u32 lane.

    var hi = 0
    var lo = 0
    var any = false

    while i < sl {
        var b = oren_string_byte_at_unchecked(s, i) & 255
        if b == 95 { i = i + 1; continue } // '_'

        var d = -1
        if b >= 48 && b <= 57 { d = b - 48 } // '0'..'9'
        else {
            if base == 16 {
                // 'a'..'f' / 'A'..'F'
                if b >= 97 && b <= 102 { d = b - 87 } // 'a'(97) => 10
                else if b >= 65 && b <= 70 { d = b - 55 } // 'A'(65) => 10
            }
        }
        if d < 0 || d >= base { return oren_err(8, "invalid digit in int literal: " + s) }
        any = true

        // Multiply (hi:lo) by base and add digit, detecting overflow beyond 64 bits.
        var x = lo * base + d
        var carry = x / U32_MOD
        lo = x - carry * U32_MOD

        var y = hi * base + carry
        if y >= U32_MOD { return oren_err(8, "int literal overflow (>64 bits): " + s) }
        hi = y

        i = i + 1
    }

    if !any { return oren_err(8, "empty int literal: " + s) }

    // Convert to signed i64.
    //
    // - For positive literals without an explicit '-' sign, interpret as u64 bits and
    //   then as signed two's complement i64. This matches the language's "64-bit bit
    //   pattern" semantics used heavily in bitcasts and float-bit plumbing.
    // - For negative literals (a leading '-'), require the magnitude be in signed range
    //   (<= 2^63) and return the signed arithmetic value.
    var I64_MAX = 9223372036854775807
    var I64_MIN = 0 - I64_MAX - 1

    if neg {
        // magnitude must be <= 2^63
        if hi > SIGN_HI { return oren_err(8, "int literal overflow (neg magnitude): " + s) }
        if hi == SIGN_HI && lo != 0 { return oren_err(8, "int literal overflow (neg magnitude): " + s) }
        if hi == SIGN_HI && lo == 0 { return I64_MIN }
        var mag = hi * U32_MOD + lo
        return 0 - mag
    }

    // Positive / unsigned literal.
    if hi < SIGN_HI {
        return hi * U32_MOD + lo
    }
    if hi == SIGN_HI && lo == 0 { return I64_MIN }

    // Two's complement negate: magnitude = (~u + 1)
    var nlo = (U32_MOD - 1) - lo
    var nhi = (U32_MOD - 1) - hi
    nlo = nlo + 1
    if nlo >= U32_MOD {
        nlo = nlo - U32_MOD
        nhi = nhi + 1
    }
    // magnitude must be <= 2^63 - 1 here.
    var mag2 = nhi * U32_MOD + nlo
    return 0 - mag2
}

fn parse_int_lit_strict(s) {
    var n = parse_int_lit(s)
    if oren_is_err(n) {
        if oren_env("OREN_TRACE_INT_LIT") != nil {
            var tt = oren_type_tag(s)
            var is_str = oren_is_string(s)
            var extra = "type_tag=" + oren_int_to_string(tt)
            if is_str == true { extra = extra + " str_len=" + oren_int_to_string(oren_string_len(s)) }
            print("[int_lit] parse_int_lit_strict failed " + extra)
        }
        var msg = "invalid or overflowed int literal: "
        if s == nil { msg = msg + "<nil>" }
        else { msg = msg + s }
        var em = oren_err_msg(n)
        if em != nil && em != 0 { msg = msg + " (" + em + ")" }
        oren_fail(1, msg)
    }
    return n
}
