
fn _bc_yield_v0_ident(name) {
    return {"type": "Identifier", "value": name}
}

fn _bc_yield_v0_int(value) {
    return {"type": "Integer", "value": oren_int_to_string(value)}
}

fn _bc_yield_v0_stmt_var(name, value) {
    return {"type": "Var", "name": _bc_yield_v0_ident(name), "value": value}
}

fn _bc_yield_v0_stmt_assign(name, value) {
    return {"type": "Assign", "name": _bc_yield_v0_ident(name), "value": value}
}

fn _bc_yield_v0_stmt_expr(expr) {
    return {"type": "ExprStmt", "expr": expr}
}

fn _bc_yield_v0_stmt_block(stmts) {
    return {"type": "Block", "stmts": stmts}
}

fn _bc_yield_v0_stmt_continue() {
    return {"type": "Continue"}
}

fn _bc_yield_v0_stmt_return_int(value) {
    return {"type": "Return", "value": _bc_yield_v0_int(value)}
}

fn _bc_yield_v0_expr_call0(name) {
    return {"type": "Call", "fn": _bc_yield_v0_ident(name), "args": []}
}

fn _bc_yield_v0_expr_state_eq(name, state_id) {
    return {
        "type": "Infix",
        "op": "==",
        "left": _bc_yield_v0_ident(name),
        "right": _bc_yield_v0_int(state_id),
    }
}

fn _bc_yield_v0_stmt_if(cond, consq, alt) {
    return {
        "type": "ExprStmt",
        "expr": {
            "type": "If",
            "cond": cond,
            "consq": consq,
            "alt": alt,
        }
    }
}

fn _bc_yield_v0_append_all(dst, src) {
    if dst == nil || src == nil { return dst }
    var i = 0
    while i < oren_list_len(src) {
        oren_list_push(dst, src[i])
        i = i + 1
    }
    return dst
}

fn _bc_yield_v0_should_trace() {
    return oren_env("OREN_TRACE_BYTECODE_YIELD_LOWERING") != nil
}

fn _bc_trace_yield_v0_lowered(name, prepared) {
    if _bc_yield_v0_should_trace() != true { return nil }
    var fn_name = name
    if fn_name == nil || fn_name == "" { fn_name = "<anonymous>" }
    var state_local = ""
    var resume_state = -1
    var seg_count = 0
    if prepared != nil {
        if prepared["state_local"] != nil { state_local = prepared["state_local"] }
        if prepared["resume_state"] != nil { resume_state = prepared["resume_state"] }
        if prepared["segments"] != nil { seg_count = oren_list_len(prepared["segments"]) }
    }
    print("[bc_yield_lowering_v0] lowered fn=" + fn_name +
          " kind=split_dispatch state_local=" + state_local +
          " resume_state=" + oren_int_to_string(resume_state) +
          " segments=" + oren_int_to_string(seg_count))
    return nil
}

fn _bc_yield_v0_branch_stmts(state_local, seg) {
    if seg == nil { return nil }
    var branch = []
    _bc_yield_v0_append_all(branch, seg["stmts"])
    if seg["terminator"] == "yield" {
        oren_list_push(branch, _bc_yield_v0_stmt_assign(state_local, _bc_yield_v0_int(seg["resume_state"])))
        oren_list_push(branch, _bc_yield_v0_stmt_expr(_bc_yield_v0_expr_call0("oren_yield_stmt")))
        oren_list_push(branch, _bc_yield_v0_stmt_continue())
        return branch
    }
    if seg["terminator"] == "fallthrough" {
        oren_list_push(branch, _bc_yield_v0_stmt_return_int(0))
    }
    return branch
}

fn _bc_yield_v0_lowered_body(stmt, prepared) {
    if stmt == nil || prepared == nil { return nil }
    var state_local = prepared["state_local"]
    if state_local == nil || state_local == "" { return nil }
    var entry_state = prepared["entry_state"]
    var exec_segments = prepared["exec_segments"]
    if exec_segments == nil || oren_list_len(exec_segments) == 0 { return nil }

    var loop_stmts = []
    var i = 0
    while i < oren_list_len(exec_segments) {
        var seg = exec_segments[i]
        oren_list_push(loop_stmts, _bc_yield_v0_stmt_if(
            _bc_yield_v0_expr_state_eq(state_local, seg["state"]),
            _bc_yield_v0_stmt_block(_bc_yield_v0_branch_stmts(state_local, seg)),
            nil
        ))
        i = i + 1
    }
    oren_list_push(loop_stmts, _bc_yield_v0_stmt_return_int(0))

    var top = []
    oren_list_push(top, _bc_yield_v0_stmt_var(state_local, _bc_yield_v0_int(entry_state)))
    oren_list_push(top, {
        "type": "While",
        "cond": _bc_yield_v0_int(1),
        "body": _bc_yield_v0_stmt_block(loop_stmts),
    })
    return _bc_yield_v0_stmt_block(top)
}

fn _bc_function_body_for_codegen(stmt) {
    if stmt == nil { return nil }
    var info = analysis.function_yield_info(stmt)
    if info == nil { return stmt["body"] }
    var lowering = info["yield_lowering"]
    if lowering == nil { return stmt["body"] }
    var prepared = lowering["prepared_v0"]
    if prepared == nil { return stmt["body"] }
    var lowered = _bc_yield_v0_lowered_body(stmt, prepared)
    if lowered == nil { return stmt["body"] }
    _bc_trace_yield_v0_lowered(stmt["name"], prepared)
    return lowered
}

fn bytecode_compile_function(ctx, stmt) {
    var name = stmt["name"]
    var codegen_body = _bc_function_body_for_codegen(stmt)
    if codegen_body == nil { codegen_body = stmt["body"] }
    
    emit_byte(ctx, AVM_JMP32)
    var jump_skip_idx = bytes.bytes_len(ctx["code"])
    emit_i32(ctx, 0)
    
    var start_pc = bytes.bytes_len(ctx["code"])
    // Map values that can be 0 are stored 1-based so 0 is representable while still using `nil`
    // as the sentinel for "missing" (decode at use sites via `enc-1`).
    ctx["functions"][name] = start_pc + 1
    
    var old_locals = ctx["locals"]
    var old_local_count = ctx["local_count"]
    var old_in_function = ctx["in_function"]
    var old_env_captures = ctx["env_captures"]
    ctx["locals"] = {}
    ctx["local_count"] = 0
    ctx["in_function"] = true

    // Closure env mapping (rolling): captured free vars are accessed via LOAD_ENV.
    ctx["env_captures"] = nil
    var caps = stmt["captures"]
    if caps != nil && oren_list_len(caps) > 0 {
        var cmap = {}
        var ci = 0
        while ci < oren_list_len(caps) {
            // Store 1-based so 0 is representable while still using `nil` as missing.
            cmap[caps[ci]] = ci + 1
            ci = ci + 1
        }
        ctx["env_captures"] = cmap
    }
    
    var params = stmt["params"]
    var i = 0
    while i < oren_list_len(params) {
        var pname = params[i]["value"]
        // Store 1-based so 0 is representable while still using `nil` as missing.
        ctx["locals"][pname] = ctx["local_count"] + 1
        ctx["local_count"] = ctx["local_count"] + 1
        i = i + 1
    }

    // Pre-allocate function locals so var-decls inside loops do not grow stack at runtime.
    // The AVM uses one stack for both locals and evaluation:
    // - fp points at the first argument (CALL sets fp = sp - nargs)
    // - LOAD/STORE_LOCAL index into stack[fp + idx]
    // Therefore we must ensure sp is advanced to include all locals slots up-front.
    bytecode_collect_locals_stmt(ctx, codegen_body)

    var need = ctx["local_count"] - oren_list_len(params)
    if need > 0 {
        var nil_idx = add_constant(ctx, {"type": "Nil"})
        var k = 0
        while k < need {
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, nil_idx)
            k = k + 1
        }
    }
    
    bytecode_compile_stmt(ctx, codegen_body)
    
    var idx = add_constant(ctx, {"type": "Integer", "value": 0})
    emit_byte(ctx, AVM_PUSH_CONST)
    emit_u16(ctx, idx)
    emit_byte(ctx, AVM_RET)
    
    var end_pc = bytes.bytes_len(ctx["code"])
    patch_u32(ctx, jump_skip_idx, end_pc - (jump_skip_idx + 4))
    
    ctx["locals"] = old_locals
    ctx["local_count"] = old_local_count
    ctx["in_function"] = old_in_function
    ctx["env_captures"] = old_env_captures
    return nil
}
