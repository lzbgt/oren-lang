fn bytecode_try_emit_int_lcg_sum_loop(ctx, stmt) {
    if stmt == nil || stmt["type"] != "While" { return false }
    var cond = stmt["cond"]
    if cond == nil || cond["type"] != "Infix" || cond["op"] != "<" { return false }
    var idx_ident = cond["left"]
    var n_ident = cond["right"]
    if _bc_is_ident(idx_ident, nil) != true { return false }
    if _bc_is_ident(n_ident, nil) != true { return false }
    var idx_name = idx_ident["value"]
    var n_name = n_ident["value"]
    if idx_name == nil || n_name == nil { return false }

    var body = stmt["body"]
    if body == nil || body["type"] != "Block" { return false }
    var stmts = body["stmts"]
    if stmts == nil || oren_list_len(stmts) != 3 { return false }

    var lcg_stmt = stmts[0]
    var sum_stmt = stmts[1]
    var inc_stmt = stmts[2]

    if lcg_stmt == nil || lcg_stmt["type"] != "Assign" { return false }
    var x_ident = lcg_stmt["name"]
    if _bc_is_ident(x_ident, nil) != true { return false }
    var x_name = x_ident["value"]
    if x_name == nil || x_name == idx_name || x_name == n_name { return false }

    var lcg = _bc_match_lcg_update(lcg_stmt, x_name)
    if lcg == nil { return false }
    var mod_name = lcg["mod"]
    var mod_const = lcg["mod_const"]
    if mod_name != nil {
        if mod_name == idx_name || mod_name == n_name || mod_name == x_name { return false }
    } else {
        if mod_const == nil || mod_const <= 0 { return false }
    }

    if sum_stmt == nil || sum_stmt["type"] != "Assign" { return false }
    var sum_ident = sum_stmt["name"]
    if _bc_is_ident(sum_ident, nil) != true { return false }
    var sum_name = sum_ident["value"]
    if sum_name == nil || sum_name == idx_name || sum_name == n_name || sum_name == x_name { return false }

    var sum_info = _bc_match_sum_mod_update(sum_stmt, sum_name, x_name, idx_name, mod_name, mod_const)
    if sum_info == nil { return false }

    if _bc_match_simple_inc(inc_stmt, idx_name) != true { return false }

    var caps = ctx["env_captures"]
    if caps != nil {
        if oren_type_tag(caps[x_name]) != 0 { return false }
        if oren_type_tag(caps[sum_name]) != 0 { return false }
        if oren_type_tag(caps[idx_name]) != 0 { return false }
        if oren_type_tag(caps[n_name]) != 0 { return false }
        if mod_name != nil && oren_type_tag(caps[mod_name]) != 0 { return false }
    }
    if oren_type_tag(ctx["locals"][x_name]) == 0 && oren_type_tag(ctx["globals"][x_name]) == 0 { return false }
    if oren_type_tag(ctx["locals"][sum_name]) == 0 && oren_type_tag(ctx["globals"][sum_name]) == 0 { return false }
    if oren_type_tag(ctx["locals"][idx_name]) == 0 && oren_type_tag(ctx["globals"][idx_name]) == 0 { return false }
    if oren_type_tag(ctx["locals"][n_name]) == 0 && oren_type_tag(ctx["globals"][n_name]) == 0 { return false }
    if mod_name != nil {
        if oren_type_tag(ctx["locals"][mod_name]) == 0 && oren_type_tag(ctx["globals"][mod_name]) == 0 { return false }
    }

    bytecode_compile_expr(ctx, x_ident)
    bytecode_compile_expr(ctx, sum_ident)
    bytecode_compile_expr(ctx, idx_ident)
    bytecode_compile_expr(ctx, n_ident)
    _bc_push_int_const(ctx, lcg["mul"])
    _bc_push_int_const(ctx, lcg["add"])
    if mod_name != nil {
        bytecode_compile_expr(ctx, {"type": "Identifier", "value": mod_name})
    } else {
        _bc_push_int_const(ctx, mod_const)
    }
    _bc_push_int_const(ctx, sum_info["mod_x"])
    _bc_push_int_const(ctx, sum_info["mod_i"])
    emit_byte(ctx, AVM_INT_LCG_SUM_LOOP)
    _bc_emit_store_ident(ctx, x_ident)
    _bc_emit_store_ident(ctx, sum_ident)
    _bc_emit_store_ident(ctx, idx_ident)
    return true
}

