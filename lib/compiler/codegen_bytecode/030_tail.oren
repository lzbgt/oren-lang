fn bytecode_collect_locals_stmt(ctx, stmt) {
    if stmt == nil { return nil }

    // Do not descend into nested functions (they have their own locals scope).
    if stmt["type"] == "Function" { return nil }
    if stmt["type"] == "ExprStmt" {
        if stmt["expr"] != nil && stmt["expr"]["type"] == "Function" { return nil }
        // If is an expression in the AST but can contain blocks with Var statements.
        // Collect locals declared inside those blocks (Oren has function-scope vars today).
        if stmt["expr"] != nil && stmt["expr"]["type"] == "If" {
            bytecode_collect_locals_stmt(ctx, stmt["expr"]["consq"])
            if stmt["expr"]["alt"] != nil {
                bytecode_collect_locals_stmt(ctx, stmt["expr"]["alt"])
            }
        }
    }

    if stmt["type"] == "Var" {
        var name = stmt["name"]["value"]
        if ctx["locals"][name] == nil {
            // Store 1-based so 0 is representable while still using `nil` as missing.
            ctx["locals"][name] = ctx["local_count"] + 1
            ctx["local_count"] = ctx["local_count"] + 1
        }
        return nil
    }
    if stmt["type"] == "Block" {
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            bytecode_collect_locals_stmt(ctx, stmts[i])
            i = i + 1
        }
        return nil
    }
    if stmt["type"] == "While" {
        bytecode_collect_locals_stmt(ctx, stmt["body"])
        return nil
    }
    if stmt["type"] == "For" {
        if stmt["init"] != nil { bytecode_collect_locals_stmt(ctx, stmt["init"]) }
        if stmt["post"] != nil { bytecode_collect_locals_stmt(ctx, stmt["post"]) }
        bytecode_collect_locals_stmt(ctx, stmt["body"])
        return nil
    }
    if stmt["type"] == "Return" { return nil }
    if stmt["type"] == "Assign" { return nil }
    if stmt["type"] == "Set" { return nil }
    if stmt["type"] == "Type" { return nil }
    if stmt["type"] == "FFI" { return nil }
    if stmt["type"] == "Break" { return nil }
    if stmt["type"] == "Continue" { return nil }
    return nil
}

fn _bc_is_ident(expr, name) {
    if expr == nil { return false }
    if expr["type"] != "Identifier" { return false }
    if name == nil { return true }
    return expr["value"] == name
}

fn _bc_is_int_lit_one(expr) {
    if expr == nil { return false }
    if expr["type"] != "Integer" { return false }
    var v = expr["value"]
    return v == "1" || v == "+1"
}

fn _bc_match_loop_bound(expr) {
    if expr == nil { return nil }
    if _bc_is_ident(expr, nil) == true {
        return {"expr": expr, "name": expr["value"]}
    }
    if expr["type"] == "Integer" {
        return {"expr": expr, "name": nil}
    }
    return nil
}

fn _bc_match_loop_header(cond) {
    if cond == nil || cond["type"] != "Infix" || cond["op"] != "<" { return nil }
    var idx_ident = cond["left"]
    if _bc_is_ident(idx_ident, nil) != true { return nil }
    var bound = _bc_match_loop_bound(cond["right"])
    if bound == nil { return nil }
    var idx_name = idx_ident["value"]
    if idx_name == nil { return nil }
    return {"idx_ident": idx_ident, "idx_name": idx_name, "n_expr": bound["expr"], "n_name": bound["name"]}
}

fn _bc_ident_uncaptured(ctx, name) {
    if name == nil { return true }
    var caps = ctx["env_captures"]
    if caps == nil { return true }
    if oren_type_tag(caps[name]) != 0 { return false }
    return true
}

fn _bc_ident_defined(ctx, name) {
    if name == nil { return false }
    if oren_type_tag(ctx["locals"][name]) != 0 { return true }
    if oren_type_tag(ctx["globals"][name]) != 0 { return true }
    return false
}

fn _bc_match_for_init(stmt, idx_name) {
    if stmt == nil { return true }
    if idx_name == nil { return false }
    if stmt["type"] != "Var" && stmt["type"] != "Assign" { return false }
    if _bc_is_ident(stmt["name"], idx_name) != true { return false }
    return true
}

fn _bc_match_list_index(expr, idx_name) {
    if expr == nil { return nil }
    if expr["type"] != "Index" { return nil }
    var rk = expr["recv_kind"]
    if rk == nil { return nil }
    if rk != "list" && rk != "list_int" { return nil }
    var idx = expr["index"]
    if idx == nil || idx["type"] != "Identifier" { return nil }
    if idx_name != nil && idx["value"] != idx_name { return nil }
    var left = expr["left"]
    if left == nil || left["type"] != "Identifier" { return nil }
    return left["value"]
}

fn _bc_parse_nonneg_int_lit(expr) {
    if expr == nil || expr["type"] != "Integer" { return nil }
    var v = intparse.parse_int_lit(expr["value"])
    if oren_is_err(v) == true { return nil }
    if v < 0 { return nil }
    return v
}

fn _bc_parse_nonneg_linear_core(expr, idx_name) {
    if expr == nil { return nil }
    var et = expr["type"]
    if et == "Integer" {
        var v = _bc_parse_nonneg_int_lit(expr)
        if v == nil { return nil }
        return {"mul": 0, "add": v}
    }
    if et == "Identifier" {
        var name = expr["value"]
        if name != nil && name == idx_name { return {"mul": 1, "add": 0} }
        return nil
    }
    if et == "Infix" {
        var op = expr["op"]
        if op == "+" {
            var left = _bc_parse_nonneg_linear_core(expr["left"], idx_name)
            if left == nil { return nil }
            var right = _bc_parse_nonneg_linear_core(expr["right"], idx_name)
            if right == nil { return nil }
            return {"mul": left["mul"] + right["mul"], "add": left["add"] + right["add"]}
        }
        if op == "*" {
            var left2 = _bc_parse_nonneg_linear_core(expr["left"], idx_name)
            if left2 == nil { return nil }
            var right2 = _bc_parse_nonneg_linear_core(expr["right"], idx_name)
            if right2 == nil { return nil }
            if left2["mul"] == 0 {
                return {"mul": right2["mul"] * left2["add"], "add": right2["add"] * left2["add"]}
            }
            if right2["mul"] == 0 {
                return {"mul": left2["mul"] * right2["add"], "add": left2["add"] * right2["add"]}
            }
            return nil
        }
    }
    return nil
}

fn _bc_parse_nonneg_linear(expr, idx_name) {
    if expr == nil { return nil }
    if expr["type"] == "Infix" && expr["op"] == "%" {
        var rv = _bc_parse_nonneg_int_lit(expr["right"])
        if rv == nil || rv <= 0 { return nil }
        var left = _bc_parse_nonneg_linear_core(expr["left"], idx_name)
        if left == nil { return nil }
        return {"mul": left["mul"], "add": left["add"], "mod": rv}
    }
    var base = _bc_parse_nonneg_linear_core(expr, idx_name)
    if base == nil { return nil }
    return {"mul": base["mul"], "add": base["add"], "mod": 0}
}

fn _bc_match_list_int_push_call(ctx, expr) {
    if expr == nil || expr["type"] != "Call" { return nil }
    var fn_node = expr["fn"]
    if fn_node == nil { return nil }
    var name = ""
    if fn_node["type"] == "Identifier" {
        name = fn_node["value"]
    }
    if fn_node["type"] == "Member" {
        if fn_node["left"]["type"] == "Identifier" {
            var left = fn_node["left"]["value"]
            var prop = fn_node["prop"]["value"]
            var alias = ctx["aliases"][left]
            if alias != nil {
                name = alias + prop
            }
        }
    }
    if name != "oren_list_int_push" && name != "STD_list_int_push" &&
        name != "oren_list_push" && name != "STD_list_push" { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 2 { return nil }
    var list_expr = args[0]
    if list_expr == nil || list_expr["type"] != "Identifier" { return nil }
    return {"list": list_expr["value"], "value": args[1]}
}

fn _bc_match_list_int_get_call(ctx, expr, idx_name) {
    if expr == nil || expr["type"] != "Call" { return nil }
    var fn_node = expr["fn"]
    if fn_node == nil { return nil }
    var name = ""
    if fn_node["type"] == "Identifier" {
        name = fn_node["value"]
    }
    if fn_node["type"] == "Member" {
        if fn_node["left"]["type"] == "Identifier" {
            var left = fn_node["left"]["value"]
            var prop = fn_node["prop"]["value"]
            var alias = ctx["aliases"][left]
            if alias != nil {
                name = alias + prop
            }
        }
    }
    if name != "oren_list_int_get" && name != "STD_list_int_get" { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 2 { return nil }
    var list_expr = args[0]
    var idx_expr = args[1]
    if list_expr == nil || list_expr["type"] != "Identifier" { return nil }
    if idx_expr == nil || idx_expr["type"] != "Identifier" { return nil }
    if idx_name != nil && idx_expr["value"] != idx_name { return nil }
    return list_expr["value"]
}

fn _bc_match_list_int_get_expr(ctx, expr, idx_name) {
    var list_name = _bc_match_list_index(expr, idx_name)
    if list_name != nil { return list_name }
    return _bc_match_list_int_get_call(ctx, expr, idx_name)
}

fn _bc_push_int_const(ctx, v) {
    // Integer constants are stored as numeric values, not string literals.
    var idx = add_constant(ctx, {"type": "Integer", "value": v})
    emit_byte(ctx, AVM_PUSH_CONST)
    emit_u16(ctx, idx)
}

fn _bc_match_sum_update(stmt, sum_name, idx_name) {
    if stmt == nil { return nil }
    if stmt["type"] != "Assign" { return nil }
    if _bc_is_ident(stmt["name"], sum_name) != true { return nil }
    var val = stmt["value"]
    if val == nil || val["type"] != "Infix" || val["op"] != "+" { return nil }
    if _bc_is_ident(val["left"], sum_name) != true { return nil }
    var mul = val["right"]
    if mul == nil || mul["type"] != "Infix" || mul["op"] != "*" { return nil }
    var list_a = _bc_match_list_index(mul["left"], idx_name)
    var list_b = _bc_match_list_index(mul["right"], idx_name)
    if list_a == nil || list_b == nil { return nil }
    return {"list_a": list_a, "list_b": list_b}
}

fn _bc_match_sum_list_update(ctx, stmt, sum_name, idx_name) {
    if stmt == nil { return nil }
    if stmt["type"] != "Assign" { return nil }
    if _bc_is_ident(stmt["name"], sum_name) != true { return nil }
    var val = stmt["value"]
    if val == nil || val["type"] != "Infix" || val["op"] != "+" { return nil }
    if _bc_is_ident(val["left"], sum_name) != true { return nil }
    var rhs = val["right"]
    if rhs == nil { return nil }
    var list_name = _bc_match_list_int_get_expr(ctx, rhs, idx_name)
    if list_name == nil { return nil }
    return {"list": list_name}
}

fn _bc_parse_int_lit(expr) {
    if expr == nil || expr["type"] != "Integer" { return nil }
    var v = intparse.parse_int_lit(expr["value"])
    if oren_is_err(v) == true { return nil }
    return v
}

fn _bc_match_mul_const(expr, name) {
    if expr == nil || expr["type"] != "Infix" || expr["op"] != "*" { return nil }
    var left = expr["left"]
    var right = expr["right"]
    if _bc_is_ident(left, name) {
        return _bc_parse_int_lit(right)
    }
    if _bc_is_ident(right, name) {
        return _bc_parse_int_lit(left)
    }
    return nil
}

fn _bc_match_lcg_update(stmt, x_name) {
    if stmt == nil || stmt["type"] != "Assign" { return nil }
    if _bc_is_ident(stmt["name"], x_name) != true { return nil }
    var val = stmt["value"]
    if val == nil || val["type"] != "Infix" || val["op"] != "%" { return nil }
    var mod_expr = val["right"]
    var mod_name = nil
    var mod_const = nil
    if _bc_is_ident(mod_expr, nil) == true {
        mod_name = mod_expr["value"]
        if mod_name == nil { return nil }
    } else {
        mod_const = _bc_parse_int_lit(mod_expr)
        if mod_const == nil { return nil }
    }
    var left = val["left"]
    if left == nil || left["type"] != "Infix" || left["op"] != "+" { return nil }
    var mul = _bc_match_mul_const(left["left"], x_name)
    var add = _bc_parse_int_lit(left["right"])
    if mul == nil || add == nil {
        mul = _bc_match_mul_const(left["right"], x_name)
        add = _bc_parse_int_lit(left["left"])
    }
    if mul == nil || add == nil { return nil }
    return {"mul": mul, "add": add, "mod": mod_name, "mod_const": mod_const}
}

fn _bc_collect_add_terms(expr, out) {
    if expr == nil { return out }
    if expr["type"] == "Infix" && expr["op"] == "+" {
        out = _bc_collect_add_terms(expr["left"], out)
        out = _bc_collect_add_terms(expr["right"], out)
        return out
    }
    oren_list_push(out, expr)
    return out
}

fn _bc_match_mod_term(expr, name) {
    if expr == nil || expr["type"] != "Infix" || expr["op"] != "%" { return nil }
    if _bc_is_ident(expr["left"], name) != true { return nil }
    var modv = _bc_parse_int_lit(expr["right"])
    if modv == nil || modv <= 0 { return nil }
    return modv
}

fn _bc_match_sum_mod_update(stmt, sum_name, x_name, idx_name, mod_name, mod_const) {
    if stmt == nil || stmt["type"] != "Assign" { return nil }
    if _bc_is_ident(stmt["name"], sum_name) != true { return nil }
    var val = stmt["value"]
    if val == nil || val["type"] != "Infix" || val["op"] != "%" { return nil }
    var mod_ok = false
    if mod_name != nil && _bc_is_ident(val["right"], mod_name) == true { mod_ok = true }
    if mod_ok != true && mod_const != nil {
        var mod_lit = _bc_parse_int_lit(val["right"])
        if mod_lit != nil && mod_lit == mod_const { mod_ok = true }
    }
    if mod_ok != true { return nil }
    var terms = []
    _bc_collect_add_terms(val["left"], terms)
    if oren_list_len(terms) != 3 { return nil }
    var saw_sum = false
    var mod_x = nil
    var mod_i = nil
    var ti = 0
    while ti < oren_list_len(terms) {
        var t = terms[ti]
        if _bc_is_ident(t, sum_name) {
            saw_sum = true
            ti = ti + 1
            continue
        }
        var mx = _bc_match_mod_term(t, x_name)
        if mx != nil {
            if mod_x != nil { return nil }
            mod_x = mx
            ti = ti + 1
            continue
        }
        var mi = _bc_match_mod_term(t, idx_name)
        if mi != nil {
            if mod_i != nil { return nil }
            mod_i = mi
            ti = ti + 1
            continue
        }
        return nil
    }
    if saw_sum != true || mod_x == nil || mod_i == nil { return nil }
    return {"mod_x": mod_x, "mod_i": mod_i}
}

fn _bc_match_simple_inc(stmt, idx_name) {
    if stmt == nil { return false }
    if stmt["type"] != "Assign" { return false }
    if _bc_is_ident(stmt["name"], idx_name) != true { return false }
    var val = stmt["value"]
    if val == nil || val["type"] != "Infix" || val["op"] != "+" { return false }
    if _bc_is_ident(val["left"], idx_name) != true { return false }
    if _bc_is_int_lit_one(val["right"]) != true { return false }
    return true
}

fn _bc_emit_store_ident(ctx, ident) {
    var name = ident["value"]
    var caps = ctx["env_captures"]
    if caps != nil {
        var cidx = caps[name]
        if oren_type_tag(cidx) != 0 {
            bytecode_error(ctx, "bytecode backend: cannot assign to captured var '" + name + "' (capture-by-value)")
            return nil
        }
    }
    var loc = ctx["locals"][name]
    if oren_type_tag(loc) != 0 {
        emit_store_local(ctx, loc - 1)
        return nil
    }
    var glob = ctx["globals"][name]
    if oren_type_tag(glob) != 0 {
        emit_byte(ctx, AVM_STORE_GLOBAL)
        emit_u16(ctx, glob - 1)
        return nil
    }
    bytecode_error(ctx, "bytecode backend: undefined variable in assignment: " + name)
    emit_byte(ctx, AVM_POP)
    return nil
}

fn bytecode_try_emit_list_int_push_loop(ctx, stmt) {
    if stmt == nil || stmt["type"] != "While" { return false }
    var header = _bc_match_loop_header(stmt["cond"])
    if header == nil { return false }
    var idx_ident = header["idx_ident"]
    var n_expr = header["n_expr"]
    var idx_name = header["idx_name"]
    var n_name = header["n_name"]
    if idx_name == nil || n_expr == nil { return false }

    var body = stmt["body"]
    if body == nil || body["type"] != "Block" { return false }
    var stmts = body["stmts"]
    if stmts == nil || oren_list_len(stmts) != 2 { return false }
    if _bc_match_simple_inc(stmts[1], idx_name) != true { return false }

    var push_stmt = stmts[0]
    if push_stmt == nil || push_stmt["type"] != "ExprStmt" { return false }
    var call_info = _bc_match_list_int_push_call(ctx, push_stmt["expr"])
    if call_info == nil { return false }
    var list_name = call_info["list"]
    if list_name == nil { return false }
    var rhs = _bc_parse_nonneg_linear(call_info["value"], idx_name)
    if rhs == nil { return false }
    // (debug trace removed)

    if _bc_ident_uncaptured(ctx, idx_name) != true { return false }
    if _bc_ident_uncaptured(ctx, n_name) != true { return false }
    if _bc_ident_uncaptured(ctx, list_name) != true { return false }
    if _bc_ident_defined(ctx, idx_name) != true { return false }
    if n_name != nil && _bc_ident_defined(ctx, n_name) != true { return false }
    if _bc_ident_defined(ctx, list_name) != true { return false }

    var list_ident = {"type": "Identifier", "value": list_name}
    bytecode_compile_expr(ctx, list_ident)
    bytecode_compile_expr(ctx, idx_ident)
    bytecode_compile_expr(ctx, n_expr)
    _bc_push_int_const(ctx, rhs["mul"])
    _bc_push_int_const(ctx, rhs["add"])
    _bc_push_int_const(ctx, rhs["mod"])
    emit_byte(ctx, AVM_LIST_PUSH_INT_LOOP)
    _bc_emit_store_ident(ctx, idx_ident)
    return true
}

fn bytecode_try_emit_list_int_push_loop_for(ctx, stmt) {
    if stmt == nil || stmt["type"] != "For" { return false }
    if stmt["cond"] == nil { return false }
    var header = _bc_match_loop_header(stmt["cond"])
    if header == nil { return false }
    var idx_ident = header["idx_ident"]
    var n_expr = header["n_expr"]
    var idx_name = header["idx_name"]
    var n_name = header["n_name"]
    if idx_name == nil || n_expr == nil { return false }
    if _bc_match_for_init(stmt["init"], idx_name) != true { return false }
    if stmt["post"] == nil { return false }
    if _bc_match_simple_inc(stmt["post"], idx_name) != true { return false }

    var body = stmt["body"]
    if body == nil || body["type"] != "Block" { return false }
    var stmts = body["stmts"]
    if stmts == nil || oren_list_len(stmts) != 1 { return false }

    var push_stmt = stmts[0]
    if push_stmt == nil || push_stmt["type"] != "ExprStmt" { return false }
    var call_info = _bc_match_list_int_push_call(ctx, push_stmt["expr"])
    if call_info == nil { return false }
    var list_name = call_info["list"]
    if list_name == nil { return false }
    var rhs = _bc_parse_nonneg_linear(call_info["value"], idx_name)
    if rhs == nil { return false }

    if _bc_ident_uncaptured(ctx, idx_name) != true { return false }
    if _bc_ident_uncaptured(ctx, n_name) != true { return false }
    if _bc_ident_uncaptured(ctx, list_name) != true { return false }
    if _bc_ident_defined(ctx, idx_name) != true { return false }
    if n_name != nil && _bc_ident_defined(ctx, n_name) != true { return false }
    if _bc_ident_defined(ctx, list_name) != true { return false }

    if stmt["init"] != nil { bytecode_compile_stmt(ctx, stmt["init"]) }
    var list_ident = {"type": "Identifier", "value": list_name}
    bytecode_compile_expr(ctx, list_ident)
    bytecode_compile_expr(ctx, idx_ident)
    bytecode_compile_expr(ctx, n_expr)
    _bc_push_int_const(ctx, rhs["mul"])
    _bc_push_int_const(ctx, rhs["add"])
    _bc_push_int_const(ctx, rhs["mod"])
    emit_byte(ctx, AVM_LIST_PUSH_INT_LOOP)
    _bc_emit_store_ident(ctx, idx_ident)
    return true
}

fn bytecode_try_emit_list_int_push2_loop(ctx, stmt) {
    if stmt == nil || stmt["type"] != "While" { return false }
    var header2 = _bc_match_loop_header(stmt["cond"])
    if header2 == nil { return false }
    var idx_ident = header2["idx_ident"]
    var n_expr = header2["n_expr"]
    var idx_name = header2["idx_name"]
    var n_name = header2["n_name"]
    if idx_name == nil || n_expr == nil { return false }

    var body = stmt["body"]
    if body == nil || body["type"] != "Block" { return false }
    var stmts = body["stmts"]
    if stmts == nil || oren_list_len(stmts) != 3 { return false }
    if _bc_match_simple_inc(stmts[2], idx_name) != true { return false }

    var push_a = stmts[0]
    var push_b = stmts[1]
    if push_a == nil || push_a["type"] != "ExprStmt" { return false }
    if push_b == nil || push_b["type"] != "ExprStmt" { return false }
    var info_a = _bc_match_list_int_push_call(ctx, push_a["expr"])
    var info_b = _bc_match_list_int_push_call(ctx, push_b["expr"])
    if info_a == nil || info_b == nil { return false }
    var list_a = info_a["list"]
    var list_b = info_b["list"]
    if list_a == nil || list_b == nil { return false }
    if list_a == list_b { return false }
    var rhs_a = _bc_parse_nonneg_linear(info_a["value"], idx_name)
    var rhs_b = _bc_parse_nonneg_linear(info_b["value"], idx_name)
    if rhs_a == nil || rhs_b == nil { return false }

    if _bc_ident_uncaptured(ctx, idx_name) != true { return false }
    if _bc_ident_uncaptured(ctx, n_name) != true { return false }
    if _bc_ident_uncaptured(ctx, list_a) != true { return false }
    if _bc_ident_uncaptured(ctx, list_b) != true { return false }
    if _bc_ident_defined(ctx, idx_name) != true { return false }
    if n_name != nil && _bc_ident_defined(ctx, n_name) != true { return false }
    if _bc_ident_defined(ctx, list_a) != true { return false }
    if _bc_ident_defined(ctx, list_b) != true { return false }

    var list_a_ident = {"type": "Identifier", "value": list_a}
    var list_b_ident = {"type": "Identifier", "value": list_b}
    bytecode_compile_expr(ctx, list_a_ident)
    bytecode_compile_expr(ctx, list_b_ident)
    bytecode_compile_expr(ctx, idx_ident)
    bytecode_compile_expr(ctx, n_expr)
    _bc_push_int_const(ctx, rhs_a["mul"])
