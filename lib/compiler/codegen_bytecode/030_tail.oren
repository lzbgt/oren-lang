    var sum_name = sum_ident["value"]
    if sum_name == nil || sum_name == idx_name { return false }

    var mul_info = _bc_match_sum_update(sum_stmt, sum_name, idx_name)
    if mul_info == nil { return false }

    if _bc_match_simple_inc(stmts[1], idx_name) != true { return false }

    var caps = ctx["env_captures"]
    if caps != nil {
        if oren_type_tag(caps[sum_name]) != 0 { return false }
        if oren_type_tag(caps[idx_name]) != 0 { return false }
    }
    if oren_type_tag(ctx["locals"][sum_name]) == 0 && oren_type_tag(ctx["globals"][sum_name]) == 0 { return false }
    if oren_type_tag(ctx["locals"][idx_name]) == 0 && oren_type_tag(ctx["globals"][idx_name]) == 0 { return false }

    var list_a_ident = {"type": "Identifier", "value": mul_info["list_a"]}
    var list_b_ident = {"type": "Identifier", "value": mul_info["list_b"]}

    bytecode_compile_expr(ctx, list_a_ident)
    bytecode_compile_expr(ctx, list_b_ident)
    bytecode_compile_expr(ctx, idx_ident)
    bytecode_compile_expr(ctx, n_ident)
    bytecode_compile_expr(ctx, sum_ident)
    emit_byte(ctx, AVM_LIST_DOT)
    _bc_emit_store_ident(ctx, sum_ident)
    _bc_emit_store_ident(ctx, idx_ident)
    return true
}

fn bytecode_compile_stmt(ctx, stmt) {
    if ctx != nil && ctx["fatal"] == true { return nil }
    if stmt["type"] == "Break" {
        var loop = ctx["loop_ctx"]
        if loop == nil {
            bytecode_error(ctx, "bytecode backend: break outside of loop")
            return nil
        }
        emit_byte(ctx, AVM_JMP32)
        var jidx = bytes.bytes_len(ctx["code"])
        emit_i32(ctx, 0)
        oren_list_push(loop["break_jumps"], jidx)
        return nil
    }

    if stmt["type"] == "Continue" {
        var loop2 = ctx["loop_ctx"]
        if loop2 == nil {
            bytecode_error(ctx, "bytecode backend: continue outside of loop")
            return nil
        }
        emit_byte(ctx, AVM_JMP32)
        var jidx2 = bytes.bytes_len(ctx["code"])
        emit_i32(ctx, 0)
        oren_list_push(loop2["continue_jumps"], jidx2)
        return nil
    }

    if stmt["type"] == "Type" {
        var tname = stmt["name"]["value"]
        var fields = stmt["fields"]
        var fns = []
        var i = 0
        while i < oren_list_len(fields) {
            oren_list_push(fns, fields[i]["value"])
            i = i + 1
        }
        ctx["types"][tname] = fns
        return nil
    }

    if stmt["type"] == "Spawn" {
        // spawn <call> as a statement: compile the spawn expr and discard the handle.
        var call = stmt["call"]
        if call == nil || call["type"] != "Call" {
            bytecode_error(ctx, "bytecode backend: spawn expects Call")
            return nil
        }
        bytecode_compile_expr(ctx, {"type": "SpawnExpr", "call": call})
        if ctx != nil && ctx["fatal"] == true { return nil }
        emit_byte(ctx, AVM_POP)
        return nil
    }

    if stmt["type"] == "ExprStmt" {
        var expr = stmt["expr"]
        if expr["type"] == "Function" && expr["name"] != nil && expr["name"] != "" {
            return bytecode_compile_function(ctx, expr)
        }
        bytecode_compile_expr(ctx, expr)
        emit_byte(ctx, AVM_POP)
        return nil
    }
    
    if stmt["type"] == "Function" {
        return bytecode_compile_function(ctx, stmt)
    }
    
    if stmt["type"] == "Return" {
        if stmt["value"] != nil {
            bytecode_compile_expr(ctx, stmt["value"])
        } else {
            var idx = add_constant(ctx, {"type": "Integer", "value": 0})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, idx)
        }
        emit_byte(ctx, AVM_RET)
        return nil
    }
    
    if stmt["type"] == "Var" {
        bytecode_compile_expr(ctx, stmt["value"])
        var name = stmt["name"]["value"]
        if ctx["in_function"] != true {
            var idx = ctx["global_count"]
            // Store 1-based so 0 is representable while still using `nil` as missing.
            ctx["globals"][name] = idx + 1
            ctx["global_count"] = idx + 1
            emit_byte(ctx, AVM_STORE_GLOBAL)
            emit_u16(ctx, idx)
        } else {
            var idx1 = ctx["locals"][name]
            if oren_type_tag(idx1) == 0 {
                // Should not happen: we pre-collect locals in bytecode_compile_function.
            bytecode_error(ctx, "bytecode backend: internal error, missing local slot for " + name)
            return nil
            }
            emit_store_local(ctx, idx1 - 1)
        }
        return nil
    }
    
    if stmt["type"] == "Assign" {
        // Assign is for variables (Identifier)
        var target = stmt["name"]
        if target["type"] == "Identifier" {
            var caps = ctx["env_captures"]
            if caps != nil {
                var cidx = caps[target["value"]]
                if oren_type_tag(cidx) != 0 {
            bytecode_error(ctx, "bytecode backend: cannot assign to captured var '" + target["value"] + "' (capture-by-value)")
            return nil
                }
            }
            bytecode_compile_expr(ctx, stmt["value"])
            var name = target["value"]
            var loc1 = ctx["locals"][name]
            if oren_type_tag(loc1) != 0 {
                emit_store_local(ctx, loc1 - 1)
                return nil
            }
            var glob1 = ctx["globals"][name]
            if oren_type_tag(glob1) != 0 {
                emit_byte(ctx, AVM_STORE_GLOBAL)
                emit_u16(ctx, glob1 - 1)
                return nil
            }
            // Rolling: assignments must target an existing var slot (local or global).
            // If we can't resolve the target, treat it as a compile error and discard the value
            // to keep stack depth consistent for verifier/CFG joins.
            bytecode_error(ctx, "bytecode backend: undefined variable in assignment: " + name)
            emit_byte(ctx, AVM_POP)
            return nil
        }
        return nil
    }
    
    if stmt["type"] == "Set" {
        var left = stmt["left"]
        if left["type"] == "Index" {
            bytecode_compile_expr(ctx, left["left"])
            bytecode_compile_expr(ctx, left["index"])
            bytecode_compile_expr(ctx, stmt["value"])
            emit_byte(ctx, AVM_SET_INDEX)
            return nil
        }
        if left["type"] == "Member" {
            // Member assignment lowers to string-key indexing:
            //   x.field = v  ->  x["field"] = v
            bytecode_compile_expr(ctx, left["left"])
            var prop = left["prop"]["value"]
            var idx = add_constant(ctx, {"type": "String", "value": prop})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, idx)
            bytecode_compile_expr(ctx, stmt["value"])
            emit_byte(ctx, AVM_SET_INDEX)
            return nil
        }
        return nil
    }
    
    if stmt["type"] == "Block" {
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            bytecode_compile_stmt(ctx, stmts[i])
            i = i + 1
        }
        return nil
    }
    
    if stmt["type"] == "While" {
        if bytecode_try_emit_list_int_push3_loop(ctx, stmt) == true { return nil }
        if bytecode_try_emit_list_int_push2_loop(ctx, stmt) == true { return nil }
        if bytecode_try_emit_list_int_push_loop(ctx, stmt) == true { return nil }
        if bytecode_try_emit_int_lcg_sum_loop(ctx, stmt) == true { return nil }
        if bytecode_try_emit_list_sum3_loop(ctx, stmt) == true { return nil }
        if bytecode_try_emit_list_sum_loop(ctx, stmt) == true { return nil }
        if bytecode_try_emit_list_dot(ctx, stmt) == true { return nil }
        var start_pc = bytes.bytes_len(ctx["code"])
        bytecode_compile_expr(ctx, stmt["cond"])
        
        emit_byte(ctx, AVM_JMP_IF32)
        var jump_body_idx = bytes.bytes_len(ctx["code"])
        emit_i32(ctx, 0)
        
        emit_byte(ctx, AVM_JMP32)
        var jump_end_idx = bytes.bytes_len(ctx["code"])
        emit_i32(ctx, 0)
        
        var body_start = bytes.bytes_len(ctx["code"])

        // Loop context: patchable break/continue.
        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "start_pc": start_pc, "continue_target": start_pc, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop
        bytecode_compile_stmt(ctx, stmt["body"])
        ctx["loop_ctx"] = prev_loop
        
        emit_byte(ctx, AVM_JMP32)
        var jump_back_idx = bytes.bytes_len(ctx["code"])
        var off_back = start_pc - (jump_back_idx + 4)
        emit_i32(ctx, off_back)
        
        var end_pc = bytes.bytes_len(ctx["code"])
        
        patch_u32(ctx, jump_body_idx, body_start - (jump_body_idx + 4))
        patch_u32(ctx, jump_end_idx, end_pc - (jump_end_idx + 4))

        // Patch breaks/continues.
        var bi = 0
        while bi < oren_list_len(loop["break_jumps"]) {
            var bpos = loop["break_jumps"][bi]
            patch_u32(ctx, bpos, end_pc - (bpos + 4))
            bi = bi + 1
        }
        var ci = 0
        while ci < oren_list_len(loop["continue_jumps"]) {
            var cpos = loop["continue_jumps"][ci]
            patch_u32(ctx, cpos, loop["continue_target"] - (cpos + 4))
            ci = ci + 1
        }
        
        return nil
    }

    if stmt["type"] == "For" {
        if bytecode_try_emit_list_int_push3_loop_for(ctx, stmt) == true { return nil }
        if bytecode_try_emit_list_int_push2_loop_for(ctx, stmt) == true { return nil }
        if bytecode_try_emit_list_int_push_loop_for(ctx, stmt) == true { return nil }
        // for { body }
        // for cond { body }
        // for init; cond; post { body }
        if stmt["init"] != nil { bytecode_compile_stmt(ctx, stmt["init"]) }

        var start_pc = bytes.bytes_len(ctx["code"])
        if stmt["cond"] != nil {
            bytecode_compile_expr(ctx, stmt["cond"])
        } else {
            var t_idx = add_constant(ctx, {"type": "Integer", "value": 1})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, t_idx)
        }

        emit_byte(ctx, AVM_JMP_IF32)
        var jump_body_idx = bytes.bytes_len(ctx["code"])
        emit_i32(ctx, 0)

        emit_byte(ctx, AVM_JMP32)
        var jump_end_idx = bytes.bytes_len(ctx["code"])
        emit_i32(ctx, 0)

        var body_start = bytes.bytes_len(ctx["code"])

        // Continue should jump to post, which we only know after compiling the body.
        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "start_pc": start_pc, "continue_target": nil, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop
        bytecode_compile_stmt(ctx, stmt["body"])

        // Post clause (continue target)
        var post_start = bytes.bytes_len(ctx["code"])
        loop["continue_target"] = post_start
        if stmt["post"] != nil { bytecode_compile_stmt(ctx, stmt["post"]) }

        ctx["loop_ctx"] = prev_loop

        emit_byte(ctx, AVM_JMP32)
        var jump_back_idx = bytes.bytes_len(ctx["code"])
        var off_back = start_pc - (jump_back_idx + 4)
        emit_i32(ctx, off_back)

        var end_pc = bytes.bytes_len(ctx["code"])

        patch_u32(ctx, jump_body_idx, body_start - (jump_body_idx + 4))
        patch_u32(ctx, jump_end_idx, end_pc - (jump_end_idx + 4))

        // Patch breaks/continues.
        var bi2 = 0
        while bi2 < oren_list_len(loop["break_jumps"]) {
            var bpos2 = loop["break_jumps"][bi2]
            patch_u32(ctx, bpos2, end_pc - (bpos2 + 4))
            bi2 = bi2 + 1
        }
        var ci2 = 0
        while ci2 < oren_list_len(loop["continue_jumps"]) {
            var cpos2 = loop["continue_jumps"][ci2]
            patch_u32(ctx, cpos2, loop["continue_target"] - (cpos2 + 4))
            ci2 = ci2 + 1
        }

        return nil
    }
    
    return nil
}
fn bytecode_compile_program(linked, config) {
    var ctx = new_bytecode_ctx()
    if config != nil {
        if config["allow_undef"] == true { ctx["allow_undef"] = true }
    }
    ctx["aliases"] = linked["aliases"]
    var stmts = linked["statements"]

    // Pre-pass: record declared top-level function names so identifiers can become function values
    // even before the function body is compiled (forward refs).
    //
    // Rolling: use CoreIR v0 metadata extraction to avoid per-backend drift in how varargs and
    // declared-functions are recognized.
    var pi = 0
    while pi < oren_list_len(stmts) {
        var st = stmts[pi]
        if st != nil && st["type"] == "Type" {
            var tname = st["name"]["value"]
            var fields = st["fields"]
            var fns = []
            var fi = 0
            while fi < oren_list_len(fields) {
                oren_list_push(fns, fields[fi]["value"])
                fi = fi + 1
            }
            ctx["types"][tname] = fns
        }
        pi = pi + 1
    }

    var meta = {"errors": []}
    coreir.collect_top_level_functions(meta, linked, "bytecode v0")
    if meta["errors"] != nil && oren_list_len(meta["errors"]) > 0 {
        var ei = 0
        while ei < oren_list_len(meta["errors"]) {
            bytecode_error(ctx, meta["errors"][ei])
            ei = ei + 1
        }
        return ctx
    }

    // declared_funcs: name -> true (use deterministic source order list when available)
    if meta["func_decl_order"] != nil {
        var di = 0
        while di < oren_list_len(meta["func_decl_order"]) {
            var nm0 = meta["func_decl_order"][di]
            ctx["declared_funcs"][nm0] = true
            di = di + 1
        }
    }
    // varargs mapping: name -> fixed count (presence means trailing `...rest`)
    if meta["func_varargs_fixed"] != nil {
        ctx["func_varargs_fixed"] = meta["func_varargs_fixed"]
    }

    var i = 0
    while i < oren_list_len(stmts) {
        bytecode_compile_stmt(ctx, stmts[i])
        i = i + 1
    }
    
    // Entry: call main() if present.
    var main_addr = ctx["functions"]["main"]
    if oren_type_tag(main_addr) == 1 {
        if main_addr > 0 {
            emit_byte(ctx, AVM_CALL32)
            emit_u32(ctx, main_addr - 1)
            emit_byte(ctx, 0) // nargs
            emit_byte(ctx, AVM_POP) // ignore return value
        }
    }
    
    emit_byte(ctx, AVM_HALT)
    
    var j = 0
    var fixups = ctx["fixups"]
    while j < oren_list_len(fixups) {
        var fix = fixups[j]
        var name = fix["name"]
        var pos = fix["pos"]
        var addr = ctx["functions"][name]
        var patched = false
        if oren_type_tag(addr) == 1 {
            if addr > 0 {
                patch_u32(ctx, pos, addr - 1)
                patched = true
            }
        }
        if patched != true {
            if ctx["allow_undef"] == true {
                // Leave placeholder 0 and record relocation for a later linker pass.
                oren_list_push(ctx["relocs"], {"name": name, "pos": pos, "kind": 0})
            } else {
                bytecode_error(ctx, "Undefined function: " + name)
            }
        }
        j = j + 1
    }

    var k = 0
    var ffix = ctx["fun_fixups"]
    while k < oren_list_len(ffix) {
        var fix2 = ffix[k]
        var name2 = fix2["name"]
        var pos2 = fix2["pos"]
        var addr2 = ctx["functions"][name2]
        var patched2 = false
        if oren_type_tag(addr2) == 1 {
            if addr2 > 0 {
                patch_u32(ctx, pos2, addr2 - 1)
                patched2 = true
            }
        }
        if patched2 != true {
            if ctx["allow_undef"] == true {
                // Leave placeholder 0 and record relocation for a later linker pass.
                oren_list_push(ctx["relocs"], {"name": name2, "pos": pos2, "kind": 1})
            } else {
                bytecode_error(ctx, "Undefined function value: " + name2)
            }
        }
        k = k + 1
    }

    // Finalize bytecode buffer for consumers that still expect list<int>.
    // Keep a u8_buf copy for faster bytecode emission.
    var code_buf = bytes.bytes_finalize(ctx["code"])
    ctx["code_buf"] = code_buf
    var code_list = oren_bytes_unpack(code_buf)
    if !oren_is_err(code_list) { ctx["code"] = code_list }

    return ctx
}

fn emit_u64_le(out, n) {
    // Bit-exact for signed ints too (needed for float64 bit patterns).
    var i = 0
    while i < 8 {
        bytes.bytes_push(out, (n >> (i * 8)) & 255)
        i = i + 1
    }
}

fn emit_u32_le(out, n) {
    bytes.bytes_push_u32_le(out, n)
}

fn bytecode_emit_program(out_path, ctx) {
    var out = bytes.bytes_new()
    // Magic: 0x0ECD (CD 0E)
    bytes.bytes_push(out, 205)
    bytes.bytes_push(out, 14)
    
    // Constants
    var consts = ctx["constants"]
    var meta = ctx["meta_bytes"]
    if meta != nil && oren_list_len(meta) > 0 {
        // Rolling: append as an unused BYTES constant.
        oren_list_push(consts, {"type": "Bytes", "value": meta})
    }
    var obx = ctx["obx_bytes"]
    if obx != nil && oren_list_len(obx) > 0 {
        // Rolling: append as an unused BYTES constant for module exports/relocs.
        oren_list_push(consts, {"type": "Bytes", "value": obx})
    }
    var n_consts = oren_list_len(consts)
    // Count (u16)
    bytes.bytes_push_u16_le(out, n_consts)
    
    var i = 0
    while i < n_consts {
        var c = consts[i]
        if c["type"] == "Nil" {
            bytes.bytes_push(out, 0) // Type NIL
        }
        if c["type"] == "Integer" {
            bytes.bytes_push(out, 1) // Type INT
            emit_u64_le(out, c["value"])
        }
        if c["type"] == "Bool" {
            bytes.bytes_push(out, 2) // Type BOOL (u8: 0|1)
            var b = c["value"]
            if b != 0 { b = 1 }
            bytes.bytes_push(out, b)
        }
        if c["type"] == "Float" {
            // Type FLOAT (rolling): IEEE-754 f64 bits as u64 little-endian.
            bytes.bytes_push(out, 3)
            emit_u64_le(out, c["value"])
        }
        if c["type"] == "String" {
            bytes.bytes_push(out, 4) // Type STRING
            var s = c["value"]
            var s_bytes = oren_bytes_from_string(s)
            var len = oren_list_len(s_bytes)
            bytes.bytes_push_u16_le(out, len)
            bytes.bytes_extend_list(out, s_bytes)
        }
        if c["type"] == "Bytes" {
            // Type BYTES (rolling): u32 length + raw bytes
            bytes.bytes_push(out, 8)
            var b = c["value"]
            var blen = oren_buf_len(b)
            if oren_is_err(blen) { blen = oren_list_len(b) }
            emit_u32_le(out, blen)
            if oren_is_u8_buf(b) == true {
                bytes.bytes_extend_u8_buf(out, b)
            } else {
                bytes.bytes_extend_list(out, b)
            }
        }
        i = i + 1
    }
    
    // Code
    var code_buf = ctx["code_buf"]
    if code_buf != nil && oren_is_u8_buf(code_buf) == true {
        bytes.bytes_extend_u8_buf(out, code_buf)
    } else {
        var code = ctx["code"]
        var i_code = 0
        while i_code < oren_list_len(code) {
            bytes.bytes_push(out, code[i_code])
            i_code = i_code + 1
        }
    }
    
    var out_buf = bytes.bytes_finalize(out)
    var w = oren_write_bytes(out_path, out_buf)
    if oren_is_err(w) {
        // Fallback to list<int> for AVM runtimes without u8_buf write support.
        var out_list = oren_bytes_unpack(out_buf)
        if !oren_is_err(out_list) { w = oren_write_bytes(out_path, out_list) }
    }
    if oren_is_err(w) {
        var msg = oren_err_msg(w)
        var e = "Failed to write bytecode: " + out_path
        if msg != nil { e = e + ": " + msg }
        print("OREN_DIAG kind=codegen code=2 msg=" + bc_diag_escape(e))
        print(e)
        oren_exit(1)
    }
    var out_list2 = oren_bytes_unpack(out_buf)
    if oren_is_err(out_list2) { return out_buf }
    return out_list2
}
