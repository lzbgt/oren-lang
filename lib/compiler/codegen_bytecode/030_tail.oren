fn bytecode_collect_locals_stmt(ctx, stmt) {
    if stmt == nil { return nil }

    // Do not descend into nested functions (they have their own locals scope).
    if stmt["type"] == "Function" { return nil }
    if stmt["type"] == "ExprStmt" {
        if stmt["expr"] != nil && stmt["expr"]["type"] == "Function" { return nil }
        // If is an expression in the AST but can contain blocks with Var statements.
        // Collect locals declared inside those blocks (Oren has function-scope vars today).
        if stmt["expr"] != nil && stmt["expr"]["type"] == "If" {
            bytecode_collect_locals_stmt(ctx, stmt["expr"]["consq"])
            if stmt["expr"]["alt"] != nil {
                bytecode_collect_locals_stmt(ctx, stmt["expr"]["alt"])
            }
        }
    }

    if stmt["type"] == "Var" {
        var name = stmt["name"]["value"]
        if ctx["locals"][name] == nil {
            ctx["locals"][name] = ctx["local_count"]
            ctx["local_count"] = ctx["local_count"] + 1
        }
        return nil
    }
    if stmt["type"] == "Block" {
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            bytecode_collect_locals_stmt(ctx, stmts[i])
            i = i + 1
        }
        return nil
    }
    if stmt["type"] == "While" {
        bytecode_collect_locals_stmt(ctx, stmt["body"])
        return nil
    }
    if stmt["type"] == "For" {
        if stmt["init"] != nil { bytecode_collect_locals_stmt(ctx, stmt["init"]) }
        if stmt["post"] != nil { bytecode_collect_locals_stmt(ctx, stmt["post"]) }
        bytecode_collect_locals_stmt(ctx, stmt["body"])
        return nil
    }
    if stmt["type"] == "Return" { return nil }
    if stmt["type"] == "Assign" { return nil }
    if stmt["type"] == "Set" { return nil }
    if stmt["type"] == "Type" { return nil }
    if stmt["type"] == "FFI" { return nil }
    if stmt["type"] == "Break" { return nil }
    if stmt["type"] == "Continue" { return nil }
    return nil
}

fn bytecode_compile_stmt(ctx, stmt) {
    if ctx != nil && ctx["fatal"] == true { return nil }
    if stmt["type"] == "Break" {
        var loop = ctx["loop_ctx"]
        if loop == nil {
            bytecode_error(ctx, "bytecode backend: break outside of loop")
            return nil
        }
        emit_byte(ctx, AVM_JMP32)
        var jidx = oren_list_len(ctx["code"])
        emit_i32(ctx, 0)
        oren_list_push(loop["break_jumps"], jidx)
        return nil
    }

    if stmt["type"] == "Continue" {
        var loop2 = ctx["loop_ctx"]
        if loop2 == nil {
            bytecode_error(ctx, "bytecode backend: continue outside of loop")
            return nil
        }
        emit_byte(ctx, AVM_JMP32)
        var jidx2 = oren_list_len(ctx["code"])
        emit_i32(ctx, 0)
        oren_list_push(loop2["continue_jumps"], jidx2)
        return nil
    }

    if stmt["type"] == "Type" {
        var tname = stmt["name"]["value"]
        var fields = stmt["fields"]
        var fns = []
        var i = 0
        while i < oren_list_len(fields) {
            oren_list_push(fns, fields[i]["value"])
            i = i + 1
        }
        ctx["types"][tname] = fns
        return nil
    }

    if stmt["type"] == "Spawn" {
        // spawn <call> as a statement: compile the spawn expr and discard the handle.
        var call = stmt["call"]
        if call == nil || call["type"] != "Call" {
            bytecode_error(ctx, "bytecode backend: spawn expects Call")
            return nil
        }
        if call["spread"] != nil {
            bytecode_error(ctx, "bytecode backend: spawn does not support spread args yet")
            return nil
        }
        bytecode_compile_expr(ctx, call["fn"])
        var args = call["args"]
        var i = 0
        while i < oren_list_len(args) {
            bytecode_compile_expr(ctx, args[i])
            i = i + 1
        }
        emit_byte(ctx, AVM_NEW_LIST)
        emit_u16(ctx, oren_list_len(args))
        emit_byte(ctx, AVM_SPAWN_CALL_LIST)
        emit_byte(ctx, AVM_POP)
        return nil
    }

    if stmt["type"] == "ExprStmt" {
        var expr = stmt["expr"]
        if expr["type"] == "Function" && expr["name"] != nil && expr["name"] != "" {
            return bytecode_compile_function(ctx, expr)
        }
        bytecode_compile_expr(ctx, expr)
        emit_byte(ctx, AVM_POP)
        return nil
    }
    
    if stmt["type"] == "Function" {
        return bytecode_compile_function(ctx, stmt)
    }
    
    if stmt["type"] == "Return" {
        if stmt["value"] != nil {
            bytecode_compile_expr(ctx, stmt["value"])
        } else {
            var idx = add_constant(ctx, {"type": "Integer", "value": 0})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, idx)
        }
        emit_byte(ctx, AVM_RET)
        return nil
    }
    
    if stmt["type"] == "Var" {
        bytecode_compile_expr(ctx, stmt["value"])
        var name = stmt["name"]["value"]
        if ctx["in_function"] != true {
            var idx = ctx["global_count"]
            ctx["globals"][name] = idx
            ctx["global_count"] = idx + 1
            emit_byte(ctx, AVM_STORE_GLOBAL)
            emit_u16(ctx, idx)
        } else {
            var idx = ctx["locals"][name]
            if idx == nil {
                // Should not happen: we pre-collect locals in bytecode_compile_function.
            bytecode_error(ctx, "bytecode backend: internal error, missing local slot for " + name)
            return nil
            }
            emit_store_local(ctx, idx)
        }
        return nil
    }
    
    if stmt["type"] == "Assign" {
        // Assign is for variables (Identifier)
        var target = stmt["name"]
        if target["type"] == "Identifier" {
            var caps = ctx["env_captures"]
            if caps != nil {
                var cidx = caps[target["value"]]
                if cidx != nil {
            bytecode_error(ctx, "bytecode backend: cannot assign to captured var '" + target["value"] + "' (capture-by-value)")
            return nil
                }
            }
            bytecode_compile_expr(ctx, stmt["value"])
            var name = target["value"]
            var loc = ctx["locals"][name]
            if loc != nil {
                emit_store_local(ctx, loc)
                return nil
            }
            var glob = ctx["globals"][name]
            if glob != nil {
                emit_byte(ctx, AVM_STORE_GLOBAL)
                emit_u16(ctx, glob)
                return nil
            }
        }
        return nil
    }
    
    if stmt["type"] == "Set" {
        var left = stmt["left"]
        if left["type"] == "Index" {
            bytecode_compile_expr(ctx, left["left"])
            bytecode_compile_expr(ctx, left["index"])
            bytecode_compile_expr(ctx, stmt["value"])
            emit_byte(ctx, AVM_SET_INDEX)
            return nil
        }
        if left["type"] == "Member" {
            // Member assignment lowers to string-key indexing:
            //   x.field = v  ->  x["field"] = v
            bytecode_compile_expr(ctx, left["left"])
            var prop = left["prop"]["value"]
            var idx = add_constant(ctx, {"type": "String", "value": prop})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, idx)
            bytecode_compile_expr(ctx, stmt["value"])
            emit_byte(ctx, AVM_SET_INDEX)
            return nil
        }
        return nil
    }
    
    if stmt["type"] == "Block" {
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            bytecode_compile_stmt(ctx, stmts[i])
            i = i + 1
        }
        return nil
    }
    
    if stmt["type"] == "While" {
        var start_pc = oren_list_len(ctx["code"])
        bytecode_compile_expr(ctx, stmt["cond"])
        
        emit_byte(ctx, AVM_JMP_IF32)
        var jump_body_idx = oren_list_len(ctx["code"])
        emit_i32(ctx, 0)
        
        emit_byte(ctx, AVM_JMP32)
        var jump_end_idx = oren_list_len(ctx["code"])
        emit_i32(ctx, 0)
        
        var body_start = oren_list_len(ctx["code"])

        // Loop context: patchable break/continue.
        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "start_pc": start_pc, "continue_target": start_pc, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop
        bytecode_compile_stmt(ctx, stmt["body"])
        ctx["loop_ctx"] = prev_loop
        
        emit_byte(ctx, AVM_JMP32)
        var jump_back_idx = oren_list_len(ctx["code"])
        var off_back = start_pc - (jump_back_idx + 4)
        emit_i32(ctx, off_back)
        
        var end_pc = oren_list_len(ctx["code"])
        
        patch_u32(ctx, jump_body_idx, body_start - (jump_body_idx + 4))
        patch_u32(ctx, jump_end_idx, end_pc - (jump_end_idx + 4))

        // Patch breaks/continues.
        var bi = 0
        while bi < oren_list_len(loop["break_jumps"]) {
            var bpos = loop["break_jumps"][bi]
            patch_u32(ctx, bpos, end_pc - (bpos + 4))
            bi = bi + 1
        }
        var ci = 0
        while ci < oren_list_len(loop["continue_jumps"]) {
            var cpos = loop["continue_jumps"][ci]
            patch_u32(ctx, cpos, loop["continue_target"] - (cpos + 4))
            ci = ci + 1
        }
        
        return nil
    }

    if stmt["type"] == "For" {
        // for { body }
        // for cond { body }
        // for init; cond; post { body }
        if stmt["init"] != nil { bytecode_compile_stmt(ctx, stmt["init"]) }

        var start_pc = oren_list_len(ctx["code"])
        if stmt["cond"] != nil {
            bytecode_compile_expr(ctx, stmt["cond"])
        } else {
            var t_idx = add_constant(ctx, {"type": "Integer", "value": 1})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, t_idx)
        }

        emit_byte(ctx, AVM_JMP_IF32)
        var jump_body_idx = oren_list_len(ctx["code"])
        emit_i32(ctx, 0)

        emit_byte(ctx, AVM_JMP32)
        var jump_end_idx = oren_list_len(ctx["code"])
        emit_i32(ctx, 0)

        var body_start = oren_list_len(ctx["code"])

        // Continue should jump to post, which we only know after compiling the body.
        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "start_pc": start_pc, "continue_target": nil, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop
        bytecode_compile_stmt(ctx, stmt["body"])

        // Post clause (continue target)
        var post_start = oren_list_len(ctx["code"])
        loop["continue_target"] = post_start
        if stmt["post"] != nil { bytecode_compile_stmt(ctx, stmt["post"]) }

        ctx["loop_ctx"] = prev_loop

        emit_byte(ctx, AVM_JMP32)
        var jump_back_idx = oren_list_len(ctx["code"])
        var off_back = start_pc - (jump_back_idx + 4)
        emit_i32(ctx, off_back)

        var end_pc = oren_list_len(ctx["code"])

        patch_u32(ctx, jump_body_idx, body_start - (jump_body_idx + 4))
        patch_u32(ctx, jump_end_idx, end_pc - (jump_end_idx + 4))

        // Patch breaks/continues.
        var bi2 = 0
        while bi2 < oren_list_len(loop["break_jumps"]) {
            var bpos2 = loop["break_jumps"][bi2]
            patch_u32(ctx, bpos2, end_pc - (bpos2 + 4))
            bi2 = bi2 + 1
        }
        var ci2 = 0
        while ci2 < oren_list_len(loop["continue_jumps"]) {
            var cpos2 = loop["continue_jumps"][ci2]
            patch_u32(ctx, cpos2, loop["continue_target"] - (cpos2 + 4))
            ci2 = ci2 + 1
        }

        return nil
    }
    
    return nil
}
fn bytecode_compile_program(linked, config) {
    var ctx = new_bytecode_ctx()
    if config != nil {
        if config["allow_undef"] == true { ctx["allow_undef"] = true }
    }
    ctx["aliases"] = linked["aliases"]
    var stmts = linked["statements"]

    // Pre-pass: record declared top-level function names so identifiers can become function values
    // even before the function body is compiled (forward refs).
    var pi = 0
    while pi < oren_list_len(stmts) {
        var st = stmts[pi]
        if st != nil && st["type"] == "Type" {
            var tname = st["name"]["value"]
            var fields = st["fields"]
            var fns = []
            var fi = 0
            while fi < oren_list_len(fields) {
                oren_list_push(fns, fields[fi]["value"])
                fi = fi + 1
            }
            ctx["types"][tname] = fns
        }
        if st != nil && st["type"] == "Function" {
            var nm = st["name"]
            if nm != nil && nm != "" {
                ctx["declared_funcs"][nm] = true
                var params = st["params"]
                if params != nil && oren_list_len(params) > 0 {
                    var last = params[oren_list_len(params) - 1]
                    if last != nil && last["is_varargs"] == true {
                        ctx["func_varargs_fixed"][nm] = oren_list_len(params) - 1
                    }
                }
            }
        }
        if st != nil && st["type"] == "ExprStmt" {
            var ex = st["expr"]
            if ex != nil && ex["type"] == "Function" {
                var nm2 = ex["name"]
                if nm2 != nil && nm2 != "" {
                    ctx["declared_funcs"][nm2] = true
                    var params2 = ex["params"]
                    if params2 != nil && oren_list_len(params2) > 0 {
                        var last2 = params2[oren_list_len(params2) - 1]
                        if last2 != nil && last2["is_varargs"] == true {
                            ctx["func_varargs_fixed"][nm2] = oren_list_len(params2) - 1
                        }
                    }
                }
            }
        }
        pi = pi + 1
    }

    var i = 0
    while i < oren_list_len(stmts) {
        bytecode_compile_stmt(ctx, stmts[i])
        i = i + 1
    }
    
    // Entry: call main() if present.
    var main_addr = ctx["functions"]["main"]
    if main_addr != nil {
        emit_byte(ctx, AVM_CALL32)
        emit_u32(ctx, main_addr)
        emit_byte(ctx, 0) // nargs
        emit_byte(ctx, AVM_POP) // ignore return value
    }
    
    emit_byte(ctx, AVM_HALT)
    
    var j = 0
    var fixups = ctx["fixups"]
    while j < oren_list_len(fixups) {
        var fix = fixups[j]
        var name = fix["name"]
        var pos = fix["pos"]
        var addr = ctx["functions"][name]
        if addr != nil {
            patch_u32(ctx, pos, addr)
        } else {
            if ctx["allow_undef"] == true {
                // Leave placeholder 0 and record relocation for a later linker pass.
                oren_list_push(ctx["relocs"], {"name": name, "pos": pos, "kind": 0})
            } else {
                bytecode_error(ctx, "Undefined function: " + name)
            }
        }
        j = j + 1
    }

    var k = 0
    var ffix = ctx["fun_fixups"]
    while k < oren_list_len(ffix) {
        var fix2 = ffix[k]
        var name2 = fix2["name"]
        var pos2 = fix2["pos"]
        var addr2 = ctx["functions"][name2]
        if addr2 != nil {
            patch_u32(ctx, pos2, addr2)
        } else {
            if ctx["allow_undef"] == true {
                // Leave placeholder 0 and record relocation for a later linker pass.
                oren_list_push(ctx["relocs"], {"name": name2, "pos": pos2, "kind": 1})
            } else {
                bytecode_error(ctx, "Undefined function value: " + name2)
            }
        }
        k = k + 1
    }
    
    return ctx
}

fn emit_u64_le(bytes, n) {
    // Bit-exact for signed ints too (needed for float64 bit patterns).
    var i = 0
    while i < 8 {
        oren_list_push(bytes, (n >> (i * 8)) & 255)
        i = i + 1
    }
}

fn emit_u32_le(bytes, n) {
    var i = 0
    while i < 4 {
        oren_list_push(bytes, n & 255)
        n = n / 256
        i = i + 1
    }
}

fn bytecode_emit_program(out_path, ctx) {
    var bytes = []
    // Magic: 0x0ECD (CD 0E)
    oren_list_push(bytes, 205)
    oren_list_push(bytes, 14)
    
    // Constants
    var consts = ctx["constants"]
    var meta = ctx["meta_bytes"]
    if meta != nil && oren_list_len(meta) > 0 {
        // Rolling: append as an unused BYTES constant.
        oren_list_push(consts, {"type": "Bytes", "value": meta})
    }
    var obx = ctx["obx_bytes"]
    if obx != nil && oren_list_len(obx) > 0 {
        // Rolling: append as an unused BYTES constant for module exports/relocs.
        oren_list_push(consts, {"type": "Bytes", "value": obx})
    }
    var n_consts = oren_list_len(consts)
    // Count (u16)
    oren_list_push(bytes, n_consts & 255)
    oren_list_push(bytes, (n_consts / 256) & 255)
    
    var i = 0
    while i < n_consts {
        var c = consts[i]
        if c["type"] == "Nil" {
            oren_list_push(bytes, 0) // Type NIL
        }
        if c["type"] == "Integer" {
            oren_list_push(bytes, 1) // Type INT
            emit_u64_le(bytes, c["value"])
        }
        if c["type"] == "Bool" {
            oren_list_push(bytes, 2) // Type BOOL (u8: 0|1)
            var b = c["value"]
            if b != 0 { b = 1 }
            oren_list_push(bytes, b)
        }
        if c["type"] == "Float" {
            // Type FLOAT (rolling): IEEE-754 f64 bits as u64 little-endian.
            oren_list_push(bytes, 3)
            emit_u64_le(bytes, c["value"])
        }
        if c["type"] == "String" {
            oren_list_push(bytes, 4) // Type STRING
            var s = c["value"]
            var s_bytes = oren_bytes_from_string(s)
            var len = oren_list_len(s_bytes)
            oren_list_push(bytes, len & 255)
            oren_list_push(bytes, (len / 256) & 255)
            var k = 0
            while k < len {
                oren_list_push(bytes, s_bytes[k])
                k = k + 1
            }
        }
        if c["type"] == "Bytes" {
            // Type BYTES (rolling): u32 length + raw bytes
            oren_list_push(bytes, 8)
            var b = c["value"]
            var blen = oren_list_len(b)
            emit_u32_le(bytes, blen)
            var k2 = 0
            while k2 < blen {
                oren_list_push(bytes, b[k2])
                k2 = k2 + 1
            }
        }
        i = i + 1
    }
    
    // Code
    var code = ctx["code"]
    var i_code = 0
    while i_code < oren_list_len(code) {
        oren_list_push(bytes, code[i_code])
        i_code = i_code + 1
    }
    
    var w = oren_write_bytes(out_path, bytes)
    if oren_is_err(w) {
        var msg = oren_err_msg(w)
        var e = "Failed to write bytecode: " + out_path
        if msg != nil { e = e + ": " + msg }
        print("OREN_DIAG kind=codegen code=2 msg=" + bc_diag_escape(e))
        print(e)
        oren_exit(1)
    }
    return bytes
}
