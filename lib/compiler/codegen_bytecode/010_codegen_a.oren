        if name == "oren_buf_dot_f32_into" { native_id = 86 }
        if name == "oren_buf_add_i32_into" { native_id = 75 }
        if name == "oren_buf_add_f32_into" { native_id = 76 }
        if name == "oren_buf_add_f64_into" { native_id = 139 }
        if name == "oren_buf_scale_f32" { native_id = 77 }
        if name == "oren_buf_reduce_sum_f32" { native_id = 78 }
        if name == "oren_buf_reduce_sum_f32_into" { native_id = 87 }
        if name == "oren_buf_mul_f32_into" { native_id = 79 }
        if name == "oren_buf_mul_f32" { native_id = 80 }
        if name == "oren_buf_mul_i32_into" { native_id = 81 }
        if name == "oren_buf_mul_i32" { native_id = 82 }
        if name == "oren_buf_mul_f64_into" { native_id = 140 }
        if name == "oren_buf_mul_f64" { native_id = 141 }
        if name == "oren_buf_reduce_sum_i32" { native_id = 83 }
        if name == "oren_buf_reduce_sum_f64" { native_id = 135 }
        if name == "oren_buf_scale_f32_into" { native_id = 84 }
        if name == "oren_buf_scale_i32_into" { native_id = 85 }
        if name == "oren_buf_dot_i32_into" { native_id = 88 }
        if name == "oren_buf_reduce_sum_i32_into" { native_id = 89 }
        if name == "oren_buf_dot_f64_into" { native_id = 136 }
        if name == "oren_buf_reduce_sum_f64_into" { native_id = 137 }
        if name == "oren_buf_axpy_i32_into" { native_id = 123 }
        if name == "oren_buf_axpy_i32_in_place" { native_id = 124 }
        if name == "oren_buf_axpy_f32_into" { native_id = 125 }
        if name == "oren_buf_axpy_f32_in_place" { native_id = 126 }

        // Pure path normalization (portable across backends; implemented natively in each backend).
        if name == "oren_realpath" { native_id = 53 }

        // Compiler/runtime support helpers required for self-hosting under the bytecode backend.
        // These are CORE domain natives (portable, deterministic).
        if name == "oren_char" { native_id = 118 }
        if name == "oren_string_to_float_bits" { native_id = 119 }
        if name == "oren_sha256_range" { native_id = 120 }
        if name == "oren_fail" { native_id = 121 }
        if name == "oren_buf_dot_i32_4_slice_into" { native_id = 122 }
        if name == "oren_buf_dot_f32_4_slice_into" { native_id = 127 }
        if name == "oren_buf_dot_f64_4_slice_into" { native_id = 130 }
        if name == "oren_buf_gemm_f32_4x4_slice_into" { native_id = 128 }
        if name == "oren_buf_gemm_i32_4x4_slice_into" { native_id = 129 }
        if name == "oren_buf_gemm_f64_4x4_slice_into" { native_id = 131 }

        if native_id != -1 {
            var args = expr["args"]
            var i = 0
            while i < oren_list_len(args) {
                bytecode_compile_expr(ctx, args[i])
                i = i + 1
            }
            emit_byte(ctx, AVM_CALL_NATIVE2)
            emit_byte(ctx, AVM_DOMAIN_CORE)
            emit_u16(ctx, native_id)
            emit_byte(ctx, oren_list_len(args))
            return nil
        }

        if indirect == true {
            // General call: fn can be a function value / closure.
            bytecode_compile_expr(ctx, fn_node)
            var args = expr["args"]
            var i = 0
            while i < oren_list_len(args) {
                bytecode_compile_expr(ctx, args[i])
                i = i + 1
            }
            if expr["spread"] != nil {
                // Call-site spread: [... fn fixed_args spread_list] CALL_INDIRECT_SPREAD fixed_count
                bytecode_compile_expr(ctx, expr["spread"])
                emit_byte(ctx, AVM_CALL_INDIRECT_SPREAD)
                emit_byte(ctx, oren_list_len(args))
                return nil
            }
            emit_byte(ctx, AVM_CALL_INDIRECT)
            emit_byte(ctx, oren_list_len(args))
            return nil
        }

        if name == "print" {
            // Rolling semantics:
            // - print() prints a newline
            // - print(x) prints x
            // - print(a,b,...) prints values (AVM prints each element as a line; stable for tests)
            //
            // For spread: print(a, xs...) prints fixed args then xs elements.
            var fixed = expr["args"]
            var fixed_n = oren_list_len(fixed)
            if fixed_n > 0 {
                var j = 0
                while j < fixed_n {
                    bytecode_compile_expr(ctx, fixed[j])
                    emit_byte(ctx, AVM_PRINT)
                    j = j + 1
                }
            } else {
                // print() => empty list => newline
                emit_byte(ctx, AVM_NEW_LIST)
                emit_u16(ctx, 0)
                emit_byte(ctx, AVM_PRINT_LIST)
            }
            if expr["spread"] != nil {
                bytecode_compile_expr(ctx, expr["spread"])
                emit_byte(ctx, AVM_PRINT_LIST)
            }
            var idx = add_constant(ctx, {"type": "Nil"})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, idx)
            return nil
        }
        
        var args = expr["args"]
        // Varargs packing (rolling): for direct named calls to a function declared with
        // a trailing `...rest`, pack extra args into a list as the last argument.
        var fixed = -1
        var vf = ctx["func_varargs_fixed"][name]
        if vf != nil { fixed = vf }
        if expr["spread"] != nil {
            if fixed >= 0 {
                // Varargs+spread: build the `rest` list dynamically, then call with
                // argc = fixed+1 (last arg is the `rest` list).
                var n_args = oren_list_len(args)
                if n_args < fixed {
                    bytecode_error(ctx, "bytecode backend: varargs arity mismatch for " + name)
                    return nil
                }
                if fixed > 255 {
                    bytecode_error(ctx, "bytecode backend: varargs fixed param count too large for call: " + name)
                    return nil
                }
                var extra_fixed = n_args - fixed
                if extra_fixed > 65535 {
                    bytecode_error(ctx, "bytecode backend: varargs extra args too large for call: " + name)
                    return nil
                }
                // compile as an indirect call:
                // [... fn fixed_args extras spread] -> rest_list -> CALL_INDIRECT (fixed+1)
                bytecode_compile_expr(ctx, fn_node)
                var i0 = 0
                while i0 < fixed {
                    bytecode_compile_expr(ctx, args[i0])
                    i0 = i0 + 1
                }
                var j0 = fixed
                while j0 < n_args {
                    bytecode_compile_expr(ctx, args[j0])
                    j0 = j0 + 1
                }
                bytecode_compile_expr(ctx, expr["spread"])
                emit_byte(ctx, AVM_NEW_LIST_SPREAD)
                emit_u16(ctx, extra_fixed)
                emit_byte(ctx, AVM_CALL_INDIRECT)
                emit_byte(ctx, fixed + 1)
                return nil
            }
            // Spread calls are compiled as indirect calls so we don't need a dynamic
            // CALL-by-name opcode: push a function value, fixed args, spread list.
            bytecode_compile_expr(ctx, fn_node)
            var i = 0
            while i < oren_list_len(args) {
                bytecode_compile_expr(ctx, args[i])
                i = i + 1
            }
            bytecode_compile_expr(ctx, expr["spread"])
            emit_byte(ctx, AVM_CALL_INDIRECT_SPREAD)
            emit_byte(ctx, oren_list_len(args))
            return nil
        }
        if fixed >= 0 && oren_list_len(args) < fixed {
            bytecode_error(ctx, "bytecode backend: varargs arity mismatch for " + name)
            return nil
        }
        var n_args = oren_list_len(args)
        var i = 0
        var fixed_count = n_args
        if fixed >= 0 { fixed_count = fixed }
        while i < fixed_count {
            bytecode_compile_expr(ctx, args[i])
            i = i + 1
        }
        if fixed >= 0 {
            var ri = fixed
            while ri < n_args {
                bytecode_compile_expr(ctx, args[ri])
                ri = ri + 1
            }
            emit_byte(ctx, AVM_NEW_LIST)
            emit_u16(ctx, n_args - fixed)
        }
        
        emit_byte(ctx, AVM_CALL32)
        var call_pos = bytes.bytes_len(ctx["code"])
        emit_u32(ctx, 0)
        if fixed >= 0 {
            emit_byte(ctx, fixed + 1)
        } else {
            emit_byte(ctx, n_args)
        }
        
        oren_list_push(ctx["fixups"], {"pos": call_pos, "name": name})
        return nil
    }
    
    return nil
}
