import opthelp "optimizer_helpers.oren"

// Const int propagation (rolling, conservative).
//
// Replace `% ident` with `% <int>` when `ident` is a known int literal in the
// current block. This enables native fastmod on hot loops without changing
// semantics (we only propagate literals, not arbitrary expressions).

fn _const_env_clone(env) {
    var out = {}
    if env == nil { return out }
    for k in env {
        var v = env[k]
        if v != nil { out[k] = v }
    }
    return out
}

fn _const_env_intersect(a, b) {
    var out = {}
    if a == nil || b == nil { return out }
    for k in a {
        var av = a[k]
        if av != nil && b[k] == av { out[k] = av }
    }
    return out
}

fn _const_env_set_from_expr(env, name, expr) {
    if env == nil || name == nil { return nil }
    var val = nil
    if expr != nil {
        if expr["type"] == "Integer" {
            val = expr["value"]
        } else if expr["type"] == "Identifier" {
            var src = expr["value"]
            if src != nil && env[src] != nil { val = env[src] }
        }
    }
    env[name] = val
    return nil
}

fn _rewrite_expr_const_mod(expr, env) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Call" {
        var args = expr["args"]
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                args[i] = _rewrite_expr_const_mod(args[i], env)
                i = i + 1
            }
            expr["args"] = args
        }
        if expr["spread"] != nil { expr["spread"] = _rewrite_expr_const_mod(expr["spread"], env) }
        return expr
    }
    if t == "Prefix" {
        expr["right"] = _rewrite_expr_const_mod(expr["right"], env)
        return expr
    }
    if t == "Infix" {
        expr["left"] = _rewrite_expr_const_mod(expr["left"], env)
        expr["right"] = _rewrite_expr_const_mod(expr["right"], env)
        if expr["op"] == "%" {
            var right = expr["right"]
            if right != nil && right["type"] == "Identifier" {
                var nm = right["value"]
                if nm != nil && env != nil && env[nm] != nil {
                    expr["right"] = {"type": "Integer", "token": right["token"], "value": env[nm]}
                }
            }
        }
        return expr
    }
    if t == "If" {
        expr["cond"] = _rewrite_expr_const_mod(expr["cond"], env)
        if expr["consq"] != nil { rewrite_const_mod_in_block(expr["consq"], _const_env_clone(env)) }
        if expr["alt"] != nil { rewrite_const_mod_in_block(expr["alt"], _const_env_clone(env)) }
        return expr
    }
    if t == "Array" {
        var els = expr["elements"]
        var i2 = 0
        while i2 < oren_list_len(els) {
            els[i2] = _rewrite_expr_const_mod(els[i2], env)
            i2 = i2 + 1
        }
        expr["elements"] = els
        return expr
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i3 = 0
        while i3 < oren_list_len(ps) {
            ps[i3]["key"] = _rewrite_expr_const_mod(ps[i3]["key"], env)
            ps[i3]["value"] = _rewrite_expr_const_mod(ps[i3]["value"], env)
            i3 = i3 + 1
        }
        expr["pairs"] = ps
        return expr
    }
    if t == "Index" {
        expr["left"] = _rewrite_expr_const_mod(expr["left"], env)
        expr["index"] = _rewrite_expr_const_mod(expr["index"], env)
        return expr
    }
    if t == "Member" {
        expr["left"] = _rewrite_expr_const_mod(expr["left"], env)
        return expr
    }
    if t == "SpawnExpr" {
        expr["call"] = _rewrite_expr_const_mod(expr["call"], env)
        return expr
    }
    return expr
}

fn _rewrite_const_mod_stmt(stmt, env) {
    if stmt == nil { return env }
    var t = stmt["type"]
    if t == "Block" || t == "StmtList" {
        var xs = stmt["stmts"]
        if xs == nil { xs = stmt["statements"] }
        if xs == nil { return env }
        var cur = env
        var i = 0
        while i < oren_list_len(xs) {
            cur = _rewrite_const_mod_stmt(xs[i], cur)
            i = i + 1
        }
        if stmt["stmts"] != nil { stmt["stmts"] = xs }
        if stmt["statements"] != nil { stmt["statements"] = xs }
        return cur
    }
    if t == "Var" || t == "Assign" {
        stmt["value"] = _rewrite_expr_const_mod(stmt["value"], env)
        var nm = opthelp.is_ident(stmt["name"])
        if nm != nil { _const_env_set_from_expr(env, nm, stmt["value"]) }
        return env
    }
    if t == "Set" {
        stmt["left"] = _rewrite_expr_const_mod(stmt["left"], env)
        stmt["value"] = _rewrite_expr_const_mod(stmt["value"], env)
        return env
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            e["cond"] = _rewrite_expr_const_mod(e["cond"], env)
            var base = env
            var then_env = _const_env_clone(base)
            rewrite_const_mod_in_block(e["consq"], then_env)
            var alt_env = _const_env_clone(base)
            if e["alt"] != nil { rewrite_const_mod_in_block(e["alt"], alt_env) }
            var merged = _const_env_intersect(then_env, alt_env)
            stmt["expr"] = e
            return merged
        }
        if e != nil && e["type"] == "Switch" {
            e["value"] = _rewrite_expr_const_mod(e["value"], env)
            var cases = e["cases"]
            var merged2 = nil
            var saw = false
            if cases != nil {
                var ci = 0
                while ci < oren_list_len(cases) {
                    var c = cases[ci]
                    var vals = c["values"]
                    var vi = 0
                    while vi < oren_list_len(vals) {
                        vals[vi] = _rewrite_expr_const_mod(vals[vi], env)
                        vi = vi + 1
                    }
                    c["values"] = vals
                    var case_env = _const_env_clone(env)
                    rewrite_const_mod_in_block(c["body"], case_env)
                    if saw != true { merged2 = case_env; saw = true }
                    else { merged2 = _const_env_intersect(merged2, case_env) }
                    ci = ci + 1
                }
            }
            if e["default"] != nil {
                var def_env = _const_env_clone(env)
                rewrite_const_mod_in_block(e["default"], def_env)
                if saw != true { merged2 = def_env; saw = true }
                else { merged2 = _const_env_intersect(merged2, def_env) }
            } else if saw == true {
                merged2 = _const_env_intersect(merged2, env)
            }
            if saw != true { merged2 = env }
            stmt["expr"] = e
            return merged2
        }
        stmt["expr"] = _rewrite_expr_const_mod(stmt["expr"], env)
        return env
    }
    if t == "Return" {
        stmt["value"] = _rewrite_expr_const_mod(stmt["value"], env)
        return env
    }
    if t == "If" {
        stmt["cond"] = _rewrite_expr_const_mod(stmt["cond"], env)
        var base2 = env
        var env_then = _const_env_clone(base2)
        rewrite_const_mod_in_block(stmt["consq"], env_then)
        var env_alt = _const_env_clone(base2)
        if stmt["alt"] != nil { rewrite_const_mod_in_block(stmt["alt"], env_alt) }
        return _const_env_intersect(env_then, env_alt)
    }
    if t == "While" {
        stmt["cond"] = _rewrite_expr_const_mod(stmt["cond"], env)
        var body_env = _const_env_clone(env)
        rewrite_const_mod_in_block(stmt["body"], body_env)
        var assigned = {}
        opthelp.collect_assigned_names_stmt(assigned, stmt["body"])
        for nm2 in assigned { env[nm2] = nil }
        return env
    }
    if t == "For" {
        if stmt["init"] != nil { env = _rewrite_const_mod_stmt(stmt["init"], env) }
        if stmt["cond"] != nil { stmt["cond"] = _rewrite_expr_const_mod(stmt["cond"], env) }
        if stmt["body"] != nil {
            var body_env2 = _const_env_clone(env)
            rewrite_const_mod_in_block(stmt["body"], body_env2)
        }
        if stmt["post"] != nil {
            var post_env = _const_env_clone(env)
            _rewrite_const_mod_stmt(stmt["post"], post_env)
        }
        var assigned2 = {}
        opthelp.collect_assigned_names_stmt(assigned2, stmt["body"])
        opthelp.collect_assigned_names_stmt(assigned2, stmt["post"])
        for nm3 in assigned2 { env[nm3] = nil }
        return env
    }
    if t == "Switch" {
        stmt["value"] = _rewrite_expr_const_mod(stmt["value"], env)
        var cases2 = stmt["cases"]
        var merged3 = nil
        var saw2 = false
        if cases2 != nil {
            var ci2 = 0
            while ci2 < oren_list_len(cases2) {
                var c2 = cases2[ci2]
                var vals2 = c2["values"]
                var vi2 = 0
                while vi2 < oren_list_len(vals2) {
                    vals2[vi2] = _rewrite_expr_const_mod(vals2[vi2], env)
                    vi2 = vi2 + 1
                }
                c2["values"] = vals2
                var case_env2 = _const_env_clone(env)
                rewrite_const_mod_in_block(c2["body"], case_env2)
                if saw2 != true { merged3 = case_env2; saw2 = true }
                else { merged3 = _const_env_intersect(merged3, case_env2) }
                ci2 = ci2 + 1
            }
        }
        if stmt["default"] != nil {
            var def_env2 = _const_env_clone(env)
            rewrite_const_mod_in_block(stmt["default"], def_env2)
            if saw2 != true { merged3 = def_env2; saw2 = true }
            else { merged3 = _const_env_intersect(merged3, def_env2) }
        } else if saw2 == true {
            merged3 = _const_env_intersect(merged3, env)
        }
        if saw2 != true { merged3 = env }
        return merged3
    }
    if t == "Spawn" {
        if stmt["call"] != nil { stmt["call"] = _rewrite_expr_const_mod(stmt["call"], env) }
        return env
    }
    return env
}

fn rewrite_const_mod_in_block(block, env) {
    if block == nil || block["type"] != "Block" { return env }
    if env == nil { env = {} }
    var ss = block["stmts"]
    if ss == nil { return env }
    var cur = env
    var i = 0
    while i < oren_list_len(ss) {
        cur = _rewrite_const_mod_stmt(ss[i], cur)
        i = i + 1
    }
    block["stmts"] = ss
    return cur
}
