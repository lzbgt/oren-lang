import opthelp "optimizer_helpers.oren"

// Const int propagation (rolling, conservative).
//
// Replace `% ident` with `% <int>` when `ident` is a known int literal in the
// current block. This enables native fastmod on hot loops without changing
// semantics (we only propagate literals, not arbitrary expressions).

var OPT_CONST_PROFILE_ENABLED = false
var OPT_CONST_EXPR_VISITS = 0
var OPT_CONST_EXPR_CALL = 0
var OPT_CONST_EXPR_INFIX = 0
var OPT_CONST_EXPR_IF = 0
var OPT_CONST_EXPR_ARRAY = 0
var OPT_CONST_EXPR_HASH = 0
var OPT_CONST_EXPR_INDEX = 0
var OPT_CONST_EXPR_MEMBER = 0
var OPT_CONST_EXPR_SPAWN = 0
var OPT_CONST_EXPR_LEAF = 0
var OPT_CONST_EXPR_OTHER = 0
var OPT_CONST_STMT_VISITS = 0
var OPT_CONST_STMT_BLOCK = 0
var OPT_CONST_STMT_VAR = 0
var OPT_CONST_STMT_ASSIGN = 0
var OPT_CONST_STMT_SET = 0
var OPT_CONST_STMT_EXPR = 0
var OPT_CONST_STMT_RETURN = 0
var OPT_CONST_STMT_IF = 0
var OPT_CONST_STMT_LOOP = 0
var OPT_CONST_STMT_SWITCH = 0
var OPT_CONST_STMT_OTHER = 0
var OPT_CONST_BLOCKS = 0
var OPT_CONST_ENV_CLONES = 0
var OPT_CONST_ENV_INTERSECTS = 0
var OPT_CONST_ENV_SETS = 0
var OPT_CONST_MOD_REWRITES = 0
var OPT_CONST_PREFILTER_EXPR = 0
var OPT_CONST_PREFILTER_STMT = 0
var OPT_CONST_PREFILTER_BLOCK = 0
var OPT_CONST_PREFILTER_HIT = 0

fn _opt_const_profile_reset(enabled) {
    OPT_CONST_PROFILE_ENABLED = enabled
    OPT_CONST_EXPR_VISITS = 0
    OPT_CONST_EXPR_CALL = 0
    OPT_CONST_EXPR_INFIX = 0
    OPT_CONST_EXPR_IF = 0
    OPT_CONST_EXPR_ARRAY = 0
    OPT_CONST_EXPR_HASH = 0
    OPT_CONST_EXPR_INDEX = 0
    OPT_CONST_EXPR_MEMBER = 0
    OPT_CONST_EXPR_SPAWN = 0
    OPT_CONST_EXPR_LEAF = 0
    OPT_CONST_EXPR_OTHER = 0
    OPT_CONST_STMT_VISITS = 0
    OPT_CONST_STMT_BLOCK = 0
    OPT_CONST_STMT_VAR = 0
    OPT_CONST_STMT_ASSIGN = 0
    OPT_CONST_STMT_SET = 0
    OPT_CONST_STMT_EXPR = 0
    OPT_CONST_STMT_RETURN = 0
    OPT_CONST_STMT_IF = 0
    OPT_CONST_STMT_LOOP = 0
    OPT_CONST_STMT_SWITCH = 0
    OPT_CONST_STMT_OTHER = 0
    OPT_CONST_BLOCKS = 0
    OPT_CONST_ENV_CLONES = 0
    OPT_CONST_ENV_INTERSECTS = 0
    OPT_CONST_ENV_SETS = 0
    OPT_CONST_MOD_REWRITES = 0
    OPT_CONST_PREFILTER_EXPR = 0
    OPT_CONST_PREFILTER_STMT = 0
    OPT_CONST_PREFILTER_BLOCK = 0
    OPT_CONST_PREFILTER_HIT = 0
    return nil
}

fn _opt_const_profile_detail() {
    if OPT_CONST_PROFILE_ENABLED != true { return "" }
    return " const_exprs=" + oren_int_to_string(OPT_CONST_EXPR_VISITS) +
        " const_expr_call=" + oren_int_to_string(OPT_CONST_EXPR_CALL) +
        " const_expr_infix=" + oren_int_to_string(OPT_CONST_EXPR_INFIX) +
        " const_expr_if=" + oren_int_to_string(OPT_CONST_EXPR_IF) +
        " const_expr_array=" + oren_int_to_string(OPT_CONST_EXPR_ARRAY) +
        " const_expr_hash=" + oren_int_to_string(OPT_CONST_EXPR_HASH) +
        " const_expr_index=" + oren_int_to_string(OPT_CONST_EXPR_INDEX) +
        " const_expr_member=" + oren_int_to_string(OPT_CONST_EXPR_MEMBER) +
        " const_expr_spawn=" + oren_int_to_string(OPT_CONST_EXPR_SPAWN) +
        " const_expr_leaf=" + oren_int_to_string(OPT_CONST_EXPR_LEAF) +
        " const_expr_other=" + oren_int_to_string(OPT_CONST_EXPR_OTHER) +
        " const_stmts=" + oren_int_to_string(OPT_CONST_STMT_VISITS) +
        " const_stmt_block=" + oren_int_to_string(OPT_CONST_STMT_BLOCK) +
        " const_stmt_var=" + oren_int_to_string(OPT_CONST_STMT_VAR) +
        " const_stmt_assign=" + oren_int_to_string(OPT_CONST_STMT_ASSIGN) +
        " const_stmt_set=" + oren_int_to_string(OPT_CONST_STMT_SET) +
        " const_stmt_expr=" + oren_int_to_string(OPT_CONST_STMT_EXPR) +
        " const_stmt_return=" + oren_int_to_string(OPT_CONST_STMT_RETURN) +
        " const_stmt_if=" + oren_int_to_string(OPT_CONST_STMT_IF) +
        " const_stmt_loop=" + oren_int_to_string(OPT_CONST_STMT_LOOP) +
        " const_stmt_switch=" + oren_int_to_string(OPT_CONST_STMT_SWITCH) +
        " const_stmt_other=" + oren_int_to_string(OPT_CONST_STMT_OTHER) +
        " const_blocks=" + oren_int_to_string(OPT_CONST_BLOCKS) +
        " const_env_clone=" + oren_int_to_string(OPT_CONST_ENV_CLONES) +
        " const_env_intersect=" + oren_int_to_string(OPT_CONST_ENV_INTERSECTS) +
        " const_env_set=" + oren_int_to_string(OPT_CONST_ENV_SETS) +
        " const_mod_rewrite=" + oren_int_to_string(OPT_CONST_MOD_REWRITES) +
        " const_prefilter_expr=" + oren_int_to_string(OPT_CONST_PREFILTER_EXPR) +
        " const_prefilter_stmt=" + oren_int_to_string(OPT_CONST_PREFILTER_STMT) +
        " const_prefilter_block=" + oren_int_to_string(OPT_CONST_PREFILTER_BLOCK) +
        " const_prefilter_hit=" + oren_int_to_string(OPT_CONST_PREFILTER_HIT)
}

fn _const_expr_may_need_mod_rewrite(expr) {
    if expr == nil { return false }
    if OPT_CONST_PROFILE_ENABLED == true { OPT_CONST_PREFILTER_EXPR = OPT_CONST_PREFILTER_EXPR + 1 }
    var t = expr["type"]
    if t == "Infix" {
        if expr["op"] == "%" {
            var right = expr["right"]
            if right != nil && right["type"] == "Identifier" { return true }
        }
        return _const_expr_may_need_mod_rewrite(expr["left"]) ||
            _const_expr_may_need_mod_rewrite(expr["right"])
    }
    if t == "Call" {
        var args = expr["args"]
        var i = 0
        var args_len = oren_list_len(args)
        while i < args_len {
            if _const_expr_may_need_mod_rewrite(args[i]) { return true }
            i = i + 1
        }
        if _const_expr_may_need_mod_rewrite(expr["spread"]) { return true }
        return false
    }
    if t == "Prefix" { return _const_expr_may_need_mod_rewrite(expr["right"]) }
    if t == "If" {
        if _const_expr_may_need_mod_rewrite(expr["cond"]) { return true }
        if _const_block_may_need_mod_rewrite_raw(expr["consq"]) { return true }
        return _const_block_may_need_mod_rewrite_raw(expr["alt"])
    }
    if t == "Switch" {
        if _const_expr_may_need_mod_rewrite(expr["value"]) { return true }
        var cases = expr["cases"]
        var ci = 0
        var cases_len = oren_list_len(cases)
        while ci < cases_len {
            var c = cases[ci]
            var vals = c["values"]
            var vi = 0
            var vals_len = oren_list_len(vals)
            while vi < vals_len {
                if _const_expr_may_need_mod_rewrite(vals[vi]) { return true }
                vi = vi + 1
            }
            if _const_block_may_need_mod_rewrite_raw(c["body"]) { return true }
            ci = ci + 1
        }
        return _const_block_may_need_mod_rewrite_raw(expr["default"])
    }
    if t == "Array" {
        var els = expr["elements"]
        var i2 = 0
        var els_len = oren_list_len(els)
        while i2 < els_len {
            if _const_expr_may_need_mod_rewrite(els[i2]) { return true }
            i2 = i2 + 1
        }
        return false
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i3 = 0
        var ps_len = oren_list_len(ps)
        while i3 < ps_len {
            if _const_expr_may_need_mod_rewrite(ps[i3]["key"]) { return true }
            if _const_expr_may_need_mod_rewrite(ps[i3]["value"]) { return true }
            i3 = i3 + 1
        }
        return false
    }
    if t == "Index" {
        return _const_expr_may_need_mod_rewrite(expr["left"]) ||
            _const_expr_may_need_mod_rewrite(expr["index"])
    }
    if t == "Member" { return _const_expr_may_need_mod_rewrite(expr["left"]) }
    if t == "SpawnExpr" { return _const_expr_may_need_mod_rewrite(expr["call"]) }
    return false
}

fn _const_stmt_may_need_mod_rewrite(stmt) {
    if stmt == nil { return false }
    if OPT_CONST_PROFILE_ENABLED == true { OPT_CONST_PREFILTER_STMT = OPT_CONST_PREFILTER_STMT + 1 }
    var t = stmt["type"]
    if t == "Block" || t == "StmtList" {
        var xs = stmt["stmts"]
        if xs == nil { xs = stmt["statements"] }
        var i = 0
        var xs_len = oren_list_len(xs)
        while i < xs_len {
            if _const_stmt_may_need_mod_rewrite(xs[i]) { return true }
            i = i + 1
        }
        return false
    }
    if t == "Var" || t == "Assign" { return _const_expr_may_need_mod_rewrite(stmt["value"]) }
    if t == "Set" {
        return _const_expr_may_need_mod_rewrite(stmt["left"]) ||
            _const_expr_may_need_mod_rewrite(stmt["value"])
    }
    if t == "ExprStmt" { return _const_expr_may_need_mod_rewrite(stmt["expr"]) }
    if t == "Return" { return _const_expr_may_need_mod_rewrite(stmt["value"]) }
    if t == "If" {
        if _const_expr_may_need_mod_rewrite(stmt["cond"]) { return true }
        if _const_block_may_need_mod_rewrite_raw(stmt["consq"]) { return true }
        return _const_block_may_need_mod_rewrite_raw(stmt["alt"])
    }
    if t == "While" {
        if _const_expr_may_need_mod_rewrite(stmt["cond"]) { return true }
        return _const_block_may_need_mod_rewrite_raw(stmt["body"])
    }
    if t == "For" {
        if _const_stmt_may_need_mod_rewrite(stmt["init"]) { return true }
        if _const_expr_may_need_mod_rewrite(stmt["cond"]) { return true }
        if _const_stmt_may_need_mod_rewrite(stmt["post"]) { return true }
        return _const_block_may_need_mod_rewrite_raw(stmt["body"])
    }
    if t == "Switch" {
        if _const_expr_may_need_mod_rewrite(stmt["value"]) { return true }
        var cases = stmt["cases"]
        var ci = 0
        var cases_len = oren_list_len(cases)
        while ci < cases_len {
            var c = cases[ci]
            var vals = c["values"]
            var vi = 0
            var vals_len = oren_list_len(vals)
            while vi < vals_len {
                if _const_expr_may_need_mod_rewrite(vals[vi]) { return true }
                vi = vi + 1
            }
            if _const_block_may_need_mod_rewrite_raw(c["body"]) { return true }
            ci = ci + 1
        }
        return _const_block_may_need_mod_rewrite_raw(stmt["default"])
    }
    if t == "Spawn" { return _const_expr_may_need_mod_rewrite(stmt["call"]) }
    return false
}

fn _const_block_may_need_mod_rewrite_raw(block) {
    if block == nil || block["type"] != "Block" { return false }
    if OPT_CONST_PROFILE_ENABLED == true { OPT_CONST_PREFILTER_BLOCK = OPT_CONST_PREFILTER_BLOCK + 1 }
    var ss = block["stmts"]
    var i = 0
    var ss_len = oren_list_len(ss)
    while i < ss_len {
        if _const_stmt_may_need_mod_rewrite(ss[i]) { return true }
        i = i + 1
    }
    return false
}

fn const_block_may_need_mod_rewrite(block) {
    var ok = _const_block_may_need_mod_rewrite_raw(block)
    if ok == true && OPT_CONST_PROFILE_ENABLED == true {
        OPT_CONST_PREFILTER_HIT = OPT_CONST_PREFILTER_HIT + 1
    }
    return ok
}

fn _const_env_clone(env) {
    if OPT_CONST_PROFILE_ENABLED == true { OPT_CONST_ENV_CLONES = OPT_CONST_ENV_CLONES + 1 }
    var out = {}
    if env == nil { return out }
    for k in env {
        var v = env[k]
        if v != nil { out[k] = v }
    }
    return out
}

fn _const_env_intersect(a, b) {
    if OPT_CONST_PROFILE_ENABLED == true { OPT_CONST_ENV_INTERSECTS = OPT_CONST_ENV_INTERSECTS + 1 }
    var out = {}
    if a == nil || b == nil { return out }
    for k in a {
        var av = a[k]
        if av != nil && b[k] == av { out[k] = av }
    }
    return out
}

fn _const_env_set_from_expr(env, name, expr) {
    if env == nil || name == nil { return nil }
    if OPT_CONST_PROFILE_ENABLED == true { OPT_CONST_ENV_SETS = OPT_CONST_ENV_SETS + 1 }
    var val = nil
    if expr != nil {
        if expr["type"] == "Integer" {
            val = expr["value"]
        } else if expr["type"] == "Identifier" {
            var src = expr["value"]
            if src != nil && env[src] != nil { val = env[src] }
        }
    }
    env[name] = val
    return nil
}

fn _rewrite_expr_const_mod(expr, env) {
    if expr == nil { return nil }
    var t = expr["type"]
    if OPT_CONST_PROFILE_ENABLED == true {
        OPT_CONST_EXPR_VISITS = OPT_CONST_EXPR_VISITS + 1
        if t == "Call" { OPT_CONST_EXPR_CALL = OPT_CONST_EXPR_CALL + 1 }
        else if t == "Infix" { OPT_CONST_EXPR_INFIX = OPT_CONST_EXPR_INFIX + 1 }
        else if t == "If" { OPT_CONST_EXPR_IF = OPT_CONST_EXPR_IF + 1 }
        else if t == "Array" { OPT_CONST_EXPR_ARRAY = OPT_CONST_EXPR_ARRAY + 1 }
        else if t == "Hash" { OPT_CONST_EXPR_HASH = OPT_CONST_EXPR_HASH + 1 }
        else if t == "Index" { OPT_CONST_EXPR_INDEX = OPT_CONST_EXPR_INDEX + 1 }
        else if t == "Member" { OPT_CONST_EXPR_MEMBER = OPT_CONST_EXPR_MEMBER + 1 }
        else if t == "SpawnExpr" { OPT_CONST_EXPR_SPAWN = OPT_CONST_EXPR_SPAWN + 1 }
        else if t == "Identifier" || t == "Integer" || t == "String" || t == "Boolean" || t == "Nil" {
            OPT_CONST_EXPR_LEAF = OPT_CONST_EXPR_LEAF + 1
        } else {
            OPT_CONST_EXPR_OTHER = OPT_CONST_EXPR_OTHER + 1
        }
    }
    if t == "Call" {
        var args = expr["args"]
        if args != nil {
            var i = 0
            var args_len = oren_list_len(args)
            while i < args_len {
                args[i] = _rewrite_expr_const_mod(args[i], env)
                i = i + 1
            }
            expr["args"] = args
        }
        if expr["spread"] != nil { expr["spread"] = _rewrite_expr_const_mod(expr["spread"], env) }
        return expr
    }
    if t == "Prefix" {
        expr["right"] = _rewrite_expr_const_mod(expr["right"], env)
        return expr
    }
    if t == "Infix" {
        expr["left"] = _rewrite_expr_const_mod(expr["left"], env)
        expr["right"] = _rewrite_expr_const_mod(expr["right"], env)
        if expr["op"] == "%" {
            var right = expr["right"]
            if right != nil && right["type"] == "Identifier" {
                var nm = right["value"]
                if nm != nil && env != nil && env[nm] != nil {
                    expr["right"] = {"type": "Integer", "token": right["token"], "value": env[nm]}
                    if OPT_CONST_PROFILE_ENABLED == true { OPT_CONST_MOD_REWRITES = OPT_CONST_MOD_REWRITES + 1 }
                }
            }
        }
        return expr
    }
    if t == "If" {
        expr["cond"] = _rewrite_expr_const_mod(expr["cond"], env)
        if expr["consq"] != nil { rewrite_const_mod_in_block(expr["consq"], _const_env_clone(env)) }
        if expr["alt"] != nil { rewrite_const_mod_in_block(expr["alt"], _const_env_clone(env)) }
        return expr
    }
    if t == "Array" {
        var els = expr["elements"]
        var i2 = 0
        var els_len = oren_list_len(els)
        while i2 < els_len {
            els[i2] = _rewrite_expr_const_mod(els[i2], env)
            i2 = i2 + 1
        }
        expr["elements"] = els
        return expr
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i3 = 0
        var ps_len = oren_list_len(ps)
        while i3 < ps_len {
            ps[i3]["key"] = _rewrite_expr_const_mod(ps[i3]["key"], env)
            ps[i3]["value"] = _rewrite_expr_const_mod(ps[i3]["value"], env)
            i3 = i3 + 1
        }
        expr["pairs"] = ps
        return expr
    }
    if t == "Index" {
        expr["left"] = _rewrite_expr_const_mod(expr["left"], env)
        expr["index"] = _rewrite_expr_const_mod(expr["index"], env)
        return expr
    }
    if t == "Member" {
        expr["left"] = _rewrite_expr_const_mod(expr["left"], env)
        return expr
    }
    if t == "SpawnExpr" {
        expr["call"] = _rewrite_expr_const_mod(expr["call"], env)
        return expr
    }
    return expr
}

fn _rewrite_const_mod_stmt(stmt, env) {
    if stmt == nil { return env }
    var t = stmt["type"]
    if OPT_CONST_PROFILE_ENABLED == true {
        OPT_CONST_STMT_VISITS = OPT_CONST_STMT_VISITS + 1
        if t == "Block" || t == "StmtList" { OPT_CONST_STMT_BLOCK = OPT_CONST_STMT_BLOCK + 1 }
        else if t == "Var" { OPT_CONST_STMT_VAR = OPT_CONST_STMT_VAR + 1 }
        else if t == "Assign" { OPT_CONST_STMT_ASSIGN = OPT_CONST_STMT_ASSIGN + 1 }
        else if t == "Set" { OPT_CONST_STMT_SET = OPT_CONST_STMT_SET + 1 }
        else if t == "ExprStmt" { OPT_CONST_STMT_EXPR = OPT_CONST_STMT_EXPR + 1 }
        else if t == "Return" { OPT_CONST_STMT_RETURN = OPT_CONST_STMT_RETURN + 1 }
        else if t == "If" { OPT_CONST_STMT_IF = OPT_CONST_STMT_IF + 1 }
        else if t == "While" || t == "For" { OPT_CONST_STMT_LOOP = OPT_CONST_STMT_LOOP + 1 }
        else if t == "Switch" { OPT_CONST_STMT_SWITCH = OPT_CONST_STMT_SWITCH + 1 }
        else { OPT_CONST_STMT_OTHER = OPT_CONST_STMT_OTHER + 1 }
    }
    if t == "Block" || t == "StmtList" {
        var xs = stmt["stmts"]
        if xs == nil { xs = stmt["statements"] }
        if xs == nil { return env }
        var cur = env
        var i = 0
        var xs_len = oren_list_len(xs)
        while i < xs_len {
            cur = _rewrite_const_mod_stmt(xs[i], cur)
            i = i + 1
        }
        if stmt["stmts"] != nil { stmt["stmts"] = xs }
        if stmt["statements"] != nil { stmt["statements"] = xs }
        return cur
    }
    if t == "Var" || t == "Assign" {
        stmt["value"] = _rewrite_expr_const_mod(stmt["value"], env)
        var nm = opthelp.is_ident(stmt["name"])
        if nm != nil { _const_env_set_from_expr(env, nm, stmt["value"]) }
        return env
    }
    if t == "Set" {
        stmt["left"] = _rewrite_expr_const_mod(stmt["left"], env)
        stmt["value"] = _rewrite_expr_const_mod(stmt["value"], env)
        return env
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            e["cond"] = _rewrite_expr_const_mod(e["cond"], env)
            var base = env
            var then_env = _const_env_clone(base)
            rewrite_const_mod_in_block(e["consq"], then_env)
            var alt_env = _const_env_clone(base)
            if e["alt"] != nil { rewrite_const_mod_in_block(e["alt"], alt_env) }
            var merged = _const_env_intersect(then_env, alt_env)
            stmt["expr"] = e
            return merged
        }
        if e != nil && e["type"] == "Switch" {
            e["value"] = _rewrite_expr_const_mod(e["value"], env)
            var cases = e["cases"]
            var merged2 = nil
            var saw = false
            if cases != nil {
                var ci = 0
                var cases_len = oren_list_len(cases)
                while ci < cases_len {
                    var c = cases[ci]
                    var vals = c["values"]
                    var vi = 0
                    var vals_len = oren_list_len(vals)
                    while vi < vals_len {
                        vals[vi] = _rewrite_expr_const_mod(vals[vi], env)
                        vi = vi + 1
                    }
                    c["values"] = vals
                    var case_env = _const_env_clone(env)
                    rewrite_const_mod_in_block(c["body"], case_env)
                    if saw != true { merged2 = case_env; saw = true }
                    else { merged2 = _const_env_intersect(merged2, case_env) }
                    ci = ci + 1
                }
            }
            if e["default"] != nil {
                var def_env = _const_env_clone(env)
                rewrite_const_mod_in_block(e["default"], def_env)
                if saw != true { merged2 = def_env; saw = true }
                else { merged2 = _const_env_intersect(merged2, def_env) }
            } else if saw == true {
                merged2 = _const_env_intersect(merged2, env)
            }
            if saw != true { merged2 = env }
            stmt["expr"] = e
            return merged2
        }
        stmt["expr"] = _rewrite_expr_const_mod(stmt["expr"], env)
        return env
    }
    if t == "Return" {
        stmt["value"] = _rewrite_expr_const_mod(stmt["value"], env)
        return env
    }
    if t == "If" {
        stmt["cond"] = _rewrite_expr_const_mod(stmt["cond"], env)
        var base2 = env
        var env_then = _const_env_clone(base2)
        rewrite_const_mod_in_block(stmt["consq"], env_then)
        var env_alt = _const_env_clone(base2)
        if stmt["alt"] != nil { rewrite_const_mod_in_block(stmt["alt"], env_alt) }
        return _const_env_intersect(env_then, env_alt)
    }
    if t == "While" {
        stmt["cond"] = _rewrite_expr_const_mod(stmt["cond"], env)
        var body_env = _const_env_clone(env)
        rewrite_const_mod_in_block(stmt["body"], body_env)
        var assigned = {}
        opthelp.collect_assigned_names_stmt(assigned, stmt["body"])
        for nm2 in assigned { env[nm2] = nil }
        return env
    }
    if t == "For" {
        if stmt["init"] != nil { env = _rewrite_const_mod_stmt(stmt["init"], env) }
        if stmt["cond"] != nil { stmt["cond"] = _rewrite_expr_const_mod(stmt["cond"], env) }
        if stmt["body"] != nil {
            var body_env2 = _const_env_clone(env)
            rewrite_const_mod_in_block(stmt["body"], body_env2)
        }
        if stmt["post"] != nil {
            var post_env = _const_env_clone(env)
            _rewrite_const_mod_stmt(stmt["post"], post_env)
        }
        var assigned2 = {}
        opthelp.collect_assigned_names_stmt(assigned2, stmt["body"])
        opthelp.collect_assigned_names_stmt(assigned2, stmt["post"])
        for nm3 in assigned2 { env[nm3] = nil }
        return env
    }
    if t == "Switch" {
        stmt["value"] = _rewrite_expr_const_mod(stmt["value"], env)
        var cases2 = stmt["cases"]
        var merged3 = nil
        var saw2 = false
        if cases2 != nil {
            var ci2 = 0
            var cases2_len = oren_list_len(cases2)
            while ci2 < cases2_len {
                var c2 = cases2[ci2]
                var vals2 = c2["values"]
                var vi2 = 0
                var vals2_len = oren_list_len(vals2)
                while vi2 < vals2_len {
                    vals2[vi2] = _rewrite_expr_const_mod(vals2[vi2], env)
                    vi2 = vi2 + 1
                }
                c2["values"] = vals2
                var case_env2 = _const_env_clone(env)
                rewrite_const_mod_in_block(c2["body"], case_env2)
                if saw2 != true { merged3 = case_env2; saw2 = true }
                else { merged3 = _const_env_intersect(merged3, case_env2) }
                ci2 = ci2 + 1
            }
        }
        if stmt["default"] != nil {
            var def_env2 = _const_env_clone(env)
            rewrite_const_mod_in_block(stmt["default"], def_env2)
            if saw2 != true { merged3 = def_env2; saw2 = true }
            else { merged3 = _const_env_intersect(merged3, def_env2) }
        } else if saw2 == true {
            merged3 = _const_env_intersect(merged3, env)
        }
        if saw2 != true { merged3 = env }
        return merged3
    }
    if t == "Spawn" {
        if stmt["call"] != nil { stmt["call"] = _rewrite_expr_const_mod(stmt["call"], env) }
        return env
    }
    return env
}

fn rewrite_const_mod_in_block(block, env) {
    if block == nil || block["type"] != "Block" { return env }
    if OPT_CONST_PROFILE_ENABLED == true { OPT_CONST_BLOCKS = OPT_CONST_BLOCKS + 1 }
    if env == nil { env = {} }
    var ss = block["stmts"]
    if ss == nil { return env }
    var cur = env
    var i = 0
    var ss_len = oren_list_len(ss)
    while i < ss_len {
        cur = _rewrite_const_mod_stmt(ss[i], cur)
        i = i + 1
    }
    block["stmts"] = ss
    return cur
}
