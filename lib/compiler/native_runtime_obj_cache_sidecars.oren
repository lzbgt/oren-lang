        var en = ends[i]
        if nm != nil {
            if oren_type_tag(st) != 1 || st <= 0 || oren_type_tag(en) != 1 || en <= 0 {
                i = i + 1
                continue
            }
            var pos = bytes.bytes_len(blob)
            bytes.bytes_push_u64_le(blob, 0)
            bytes.bytes_push_u64_le(blob, 0)
            bytes.bytes_push_u64_le(patch, pos)
            bytes.bytes_push_u64_le(start_u8, st - 1)
            bytes.bytes_push_u64_le(end_u8, en - 1)
            var name_len = oren_string_len(nm)
            bytes.bytes_push_u64_le(blob, name_len)
            bytes.bytes_extend_string(blob, nm)
            _rtobj_align_bytes_8(blob)
            bytes.bytes_push_u64_le(blob, 0)
            bytes.bytes_push_u64_le(blob, 0)
            bytes.bytes_push_u64_le(blob, 0)
            bytes.bytes_push_u64_le(blob, 0)
        }
        i = i + 1
    }
    return {
        "debug_blob_u8": bytes.bytes_finalize(blob),
        "debug_patch_pos_u8": bytes.bytes_finalize(patch),
        "debug_start_u8": bytes.bytes_finalize(start_u8),
        "debug_end_u8": bytes.bytes_finalize(end_u8),
        "debug_funcs_enc_norm": norm
    }
}

fn rtobj_load_debug_blob_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    var bs = oren_read_u8_buf(paths["debug_blob"])
    if oren_is_err(bs) { return nil }
    return bs
}

fn rtobj_load_debug_patch_pos_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    var bs = oren_read_u8_buf(paths["debug_patch_pos"])
    if oren_is_err(bs) { return nil }
    var n = oren_buf_len(bs)
    if n < 0 { return nil }
    if (n / 8) * 8 != n { return nil }
    return bs
}

fn rtobj_load_debug_start_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    return _rtobj_load_u64_u8_sidecar(paths["debug_start"])
}

fn rtobj_load_debug_end_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    return _rtobj_load_u64_u8_sidecar(paths["debug_end"])
}

fn rtobj_store_debug_sidecars(cache_dir, key, debug_blob_u8, debug_patch_pos_u8, debug_start_u8, debug_end_u8) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    if debug_blob_u8 == nil || debug_patch_pos_u8 == nil { return nil }
    if oren_is_u8_buf(debug_blob_u8) != true { return nil }
    if oren_is_u8_buf(debug_patch_pos_u8) != true { return nil }
    var paths = rtobj_paths(cache_dir, key)
    _ensure_dir(paths["dir"])
    _rtobj_write_atomic(paths["debug_blob"], debug_blob_u8)
    _rtobj_write_atomic(paths["debug_patch_pos"], debug_patch_pos_u8)
    if debug_start_u8 != nil { _rtobj_write_atomic(paths["debug_start"], debug_start_u8) }
    if debug_end_u8 != nil { _rtobj_write_atomic(paths["debug_end"], debug_end_u8) }
    return nil
}
