import lexer "lexer.oren"
import parser "parser.oren"
import analysis "analysis.oren"
import metadata "metadata.oren"

fn json_string(s) { return "\"" + metadata.escape_json_string(s) + "\"" }

fn json_kv_str(k, v) {
    if v == nil { return json_string(k) + ": null" }
    return json_string(k) + ": " + json_string(v)
}

fn json_kv_int(k, v) {
    if v == nil { return json_string(k) + ": null" }
    return json_string(k) + ": " + oren_int_to_string(v)
}

fn json_kv_bool(k, v) {
    if v == true { return json_string(k) + ": true" }
    if v == false { return json_string(k) + ": false" }
    return json_string(k) + ": null"
}

fn write_or_print(out_path, content) {
    if out_path == "" {
        print(content)
        return 0
    }
    var w = oren_write_file(out_path, content)
    if oren_is_err(w) {
        print("Failed to write: " + out_path)
        var msg = oren_err_msg(w)
        if msg != nil { print(msg) }
        return 1
    }
    print("Wrote: " + out_path)
    return 0
}

fn dump_tokens_json(src_path, strict_attrs, attr_allow_prefixes, strict_ident_prefixes, ident_allow_prefixes) {
    var trace = oren_env("OREN_TRACE_DUMP")
    if trace != nil && trace != "" { print("TRACE_DUMP dump_tokens_json: read_file start") }
    var src = oren_read_file(src_path)
    if oren_is_err(src) {
        print("Failed to read file: " + src_path)
        var msg = oren_err_msg(src)
        if msg != nil { print(msg) }
        return nil
    }
    if trace != nil && trace != "" { print("TRACE_DUMP dump_tokens_json: read_file ok") }
    var l = lexer.new_lexer(src)
    if trace != nil && trace != "" { print("TRACE_DUMP dump_tokens_json: new_lexer ok") }
    l["file"] = src_path
    if trace != nil && trace != "" { print("TRACE_DUMP dump_tokens_json: set file ok") }

    // Diagnostic: isolate lexer progress from JSON/string processing.
    // Set `OREN_DUMP_TOKENS_FAST=1` to iterate tokens without building JSON.
    var fast = oren_env("OREN_DUMP_TOKENS_FAST")
    if fast != nil && fast != "" {
        var n = 0
        while true {
            if trace != nil && trace != "" && n == 0 { print("TRACE_DUMP dump_tokens_json: next_token start") }
            var t2 = lexer.next_token(l)
            if trace != nil && trace != "" && n == 0 { print("TRACE_DUMP dump_tokens_json: next_token returned") }
            if t2 == nil { break }
            n = n + 1
            if t2["type"] == "EOF" { break }
            // Fail-fast if we ever spin forever (should never happen for finite inputs).
            if n > 1000000 {
                print("dump tokens fast: exceeded 1,000,000 tokens; aborting")
                break
            }
        }
        print("dump tokens fast: tokens=" + oren_int_to_string(n))
        return "[]\n"
    }

    var p = parser.new_parser(l)
    p["strict_attrs"] = strict_attrs
    p["attr_allow_prefixes"] = attr_allow_prefixes
    p["strict_ident_prefixes"] = strict_ident_prefixes
    p["ident_allow_prefixes"] = ident_allow_prefixes

    // Token stream dump (up to EOF).
    var out = "[\n"
    var first = true
    while true {
        var t = lexer.next_token(l)
        if t == nil { break }
        if !first { out = out + ",\n" }
        first = false

        out = out + "  { "
        out = out + json_kv_str("type", t["type"]) + ", "
        out = out + json_kv_str("literal", t["literal"]) + ", "
        out = out + json_kv_str("file", t["file"]) + ", "
        out = out + json_kv_int("line", t["line"]) + ", "
        out = out + json_kv_int("col", t["col"]) + ", "
        out = out + json_kv_int("pos", t["pos"]) + ", "
        out = out + json_kv_int("end", t["end"])
        out = out + " }"

        if t["type"] == "EOF" { break }
    }
    out = out + "\n]\n"
    return out
}

fn linked_summary_json(linked) {
    if linked == nil { return "{}\n" }

    // Collect top-level names (deterministic in statement order).
    var functions = []
    var function_details = []
    var structs = []
    var enums = []
    var traits = []

    if linked["traits"] != nil {
        var ti = 0
        while ti < oren_list_len(linked["traits"]) {
            oren_list_push(traits, linked["traits"][ti]["name"])
            ti = ti + 1
        }
    }

    var ss = linked["statements"]
    var i = 0
    while i < oren_list_len(ss) {
        var s = ss[i]
        if s == nil { i = i + 1; continue }
        var entry = analysis.top_level_function_surface_entry(s)
        if entry != nil {
            oren_list_push(functions, entry["name"])
            oren_list_push(function_details, entry["func"])
        }
        if s["type"] == "Type" {
            oren_list_push(structs, s["name"]["value"])
        }
        if s["type"] == "Enum" {
            oren_list_push(enums, s["name"]["value"])
        }
        i = i + 1
    }

    var out = "{\n"
    out = out + "  \"functions\": ["
    i = 0
    while i < oren_list_len(functions) {
        if i != 0 { out = out + ", " }
        out = out + json_string(functions[i])
        i = i + 1
    }
    out = out + "],\n"

    out = out + "  \"function_details\": [\n"
    i = 0
    while i < oren_list_len(function_details) {
        var func = function_details[i]
        var name = analysis.function_surface_name(func, functions[i])
        var yield_info = analysis.function_yield_info(func)
        if i != 0 { out = out + ",\n" }
        out = out + "    { "
        out = out + json_kv_str("name", name) + ", "
        out = out + json_kv_bool("contains_yield", yield_info["contains_yield"]) + ", "
        out = out + json_kv_int("yield_stmt_count", yield_info["yield_stmt_count"]) + ", "
        out = out + "\"yield_stmt_sites\": " + metadata.json_string_array(yield_info["yield_stmt_sites"]) + ", "
        out = out + json_kv_bool("contains_yield_value", yield_info["contains_yield_value"]) + ", "
        out = out + json_kv_int("yield_value_count", yield_info["yield_value_count"]) + ", "
        out = out + "\"yield_value_sites\": " + metadata.json_string_array(yield_info["yield_value_sites"]) + ", "
        out = out + "\"yield_value_surface\": " + metadata.json_yield_value_surface(yield_info["yield_value_surface"]) + ", "
        out = out + json_kv_bool("contains_yield_exchange", yield_info["contains_yield_exchange"]) + ", "
        out = out + json_kv_int("yield_exchange_count", yield_info["yield_exchange_count"]) + ", "
        out = out + "\"yield_exchange_sites\": " + metadata.json_string_array(yield_info["yield_exchange_sites"]) + ", "
        out = out + "\"yield_exchange_surface\": " + metadata.json_yield_exchange_surface(yield_info["yield_exchange_surface"]) + ", "
        out = out + json_kv_bool("contains_generator_finalize", yield_info["contains_generator_finalize"]) + ", "
        out = out + json_kv_int("generator_finalize_count", yield_info["generator_finalize_count"]) + ", "
        out = out + "\"generator_finalize_sites\": " + metadata.json_string_array(yield_info["generator_finalize_sites"]) + ", "
        out = out + "\"generator_finalize_surface\": " + metadata.json_generator_finalize_surface(yield_info["generator_finalize_surface"]) + ", "
        out = out + json_kv_bool("is_generator_decl", yield_info["is_generator_decl"]) + ", "
        out = out + "\"generator_decl_surface\": " + metadata.json_generator_decl_surface(yield_info["generator_decl_surface"]) + ", "
        out = out + "\"yield_lowering\": " + metadata.json_yield_lowering(yield_info["yield_lowering"])
        out = out + " }"
        i = i + 1
    }
    out = out + "\n  ],\n"

    out = out + "  \"structs\": ["
    i = 0
    while i < oren_list_len(structs) {
        if i != 0 { out = out + ", " }
        out = out + json_string(structs[i])
        i = i + 1
    }
    out = out + "],\n"

    out = out + "  \"enums\": ["
    i = 0
    while i < oren_list_len(enums) {
        if i != 0 { out = out + ", " }
        out = out + json_string(enums[i])
        i = i + 1
    }
    out = out + "],\n"

    out = out + "  \"traits\": ["
    i = 0
    while i < oren_list_len(traits) {
        if i != 0 { out = out + ", " }
        out = out + json_string(traits[i])
        i = i + 1
    }
    out = out + "]\n"

    out = out + "}\n"
    return out
}

fn _json_obj_str(k, v) {
    if v == nil { return json_string(k) + ": null" }
    return json_string(k) + ": " + v
}

fn module_graph_json(graph) {
    if graph == nil { return "{}\n" }
    var entry = graph["entry"]
    if entry == nil { entry = "<entry>" }

    var imports = graph["imports"]
    if imports == nil { imports = [] }
    var modules = graph["modules"]
    if modules == nil { modules = [] }

    var out = "{\n"
    out = out + "  " + json_kv_str("entry", entry) + ",\n"

    // Root imports (deterministic, in source order).
    out = out + "  \"imports\": [\n"
    var i = 0
    while i < oren_list_len(imports) {
        var imp = imports[i]
        if i != 0 { out = out + ",\n" }
        out = out + "    { "
        out = out + json_kv_str("alias", imp["alias"]) + ", "
        out = out + json_kv_str("path", imp["path"]) + ", "
        out = out + json_kv_str("prefix", imp["prefix"]) + ", "
        out = out + json_kv_str("full", imp["full"])
        out = out + " }"
        i = i + 1
    }
    out = out + "\n  ],\n"

    // Module list + their import edges (deterministic, module order then source order).
    out = out + "  \"modules\": [\n"
    i = 0
    while i < oren_list_len(modules) {
        var m = modules[i]
        if i != 0 { out = out + ",\n" }
        out = out + "    {\n"
        out = out + "      " + json_kv_str("prefix", m["prefix"]) + ",\n"
        out = out + "      " + json_kv_str("path", m["path"]) + ",\n"

        var imps = m["imports"]
        if imps == nil { imps = [] }
        out = out + "      \"imports\": [\n"
        var j = 0
        while j < oren_list_len(imps) {
            var ei = imps[j]
            if j != 0 { out = out + ",\n" }
            out = out + "        { "
            out = out + json_kv_str("alias", ei["alias"]) + ", "
            out = out + json_kv_str("path", ei["path"]) + ", "
            out = out + json_kv_str("prefix", ei["prefix"]) + ", "
            out = out + json_kv_str("full", ei["full"])
            out = out + " }"
            j = j + 1
        }
        out = out + "\n      ]\n"
        out = out + "    }"
        i = i + 1
    }
    out = out + "\n  ]\n"

    out = out + "}\n"
    return out
}
