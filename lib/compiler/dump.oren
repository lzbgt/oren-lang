import lexer "lexer.oren"
import parser "parser.oren"
import metadata "metadata.oren"

fn json_string(s) { return "\"" + metadata.escape_json_string(s) + "\"" }

fn json_kv_str(k, v) {
    if v == nil { return json_string(k) + ": null" }
    return json_string(k) + ": " + json_string(v)
}

fn json_kv_int(k, v) {
    if v == nil { return json_string(k) + ": null" }
    return json_string(k) + ": " + oren_int_to_string(v)
}

fn json_kv_bool(k, v) {
    if v == true { return json_string(k) + ": true" }
    if v == false { return json_string(k) + ": false" }
    return json_string(k) + ": null"
}

fn write_or_print(out_path, content) {
    if out_path == "" {
        print(content)
        return 0
    }
    var w = oren_write_file(out_path, content)
    if oren_is_err(w) {
        print("Failed to write: " + out_path)
        var msg = oren_err_msg(w)
        if msg != nil { print(msg) }
        return 1
    }
    print("Wrote: " + out_path)
    return 0
}

fn dump_tokens_json(src_path, strict_attrs, attr_allow_prefixes) {
    var src = oren_read_file(src_path)
    if oren_is_err(src) {
        print("Failed to read file: " + src_path)
        var msg = oren_err_msg(src)
        if msg != nil { print(msg) }
        return nil
    }
    var l = lexer.new_lexer(src)
    l["file"] = src_path
    var p = parser.new_parser(l)
    p["strict_attrs"] = strict_attrs
    p["attr_allow_prefixes"] = attr_allow_prefixes

    // Token stream dump (up to EOF).
    var out = "[\n"
    var first = true
    while true {
        var t = lexer.next_token(l)
        if t == nil { break }
        if !first { out = out + ",\n" }
        first = false

        out = out + "  { "
        out = out + json_kv_str("type", t["type"]) + ", "
        out = out + json_kv_str("literal", t["literal"]) + ", "
        out = out + json_kv_str("file", t["file"]) + ", "
        out = out + json_kv_int("pos", t["pos"]) + ", "
        out = out + json_kv_int("end", t["end"])
        out = out + " }"

        if t["type"] == "EOF" { break }
    }
    out = out + "\n]\n"
    return out
}

fn linked_summary_json(linked) {
    if linked == nil { return "{}\n" }

    // Collect top-level names (deterministic in statement order).
    var functions = []
    var structs = []
    var enums = []
    var traits = []

    if linked["traits"] != nil {
        var ti = 0
        while ti < oren_list_len(linked["traits"]) {
            oren_list_push(traits, linked["traits"][ti]["name"])
            ti = ti + 1
        }
    }

    var ss = linked["statements"]
    var i = 0
    while i < oren_list_len(ss) {
        var s = ss[i]
        if s == nil { i = i + 1; continue }
        if s["type"] == "ExprStmt" {
            var e = s["expr"]
            if e != nil {
                if e["type"] == "Function" {
                    oren_list_push(functions, e["name"])
                }
            }
        } else {
            if s["type"] == "Function" {
                oren_list_push(functions, s["name"])
            }
            if s["type"] == "Type" {
                oren_list_push(structs, s["name"]["value"])
            }
            if s["type"] == "Enum" {
                oren_list_push(enums, s["name"]["value"])
            }
        }
        i = i + 1
    }

    var out = "{\n"
    out = out + "  \"functions\": ["
    i = 0
    while i < oren_list_len(functions) {
        if i != 0 { out = out + ", " }
        out = out + json_string(functions[i])
        i = i + 1
    }
    out = out + "],\n"

    out = out + "  \"structs\": ["
    i = 0
    while i < oren_list_len(structs) {
        if i != 0 { out = out + ", " }
        out = out + json_string(structs[i])
        i = i + 1
    }
    out = out + "],\n"

    out = out + "  \"enums\": ["
    i = 0
    while i < oren_list_len(enums) {
        if i != 0 { out = out + ", " }
        out = out + json_string(enums[i])
        i = i + 1
    }
    out = out + "],\n"

    out = out + "  \"traits\": ["
    i = 0
    while i < oren_list_len(traits) {
        if i != 0 { out = out + ", " }
        out = out + json_string(traits[i])
        i = i + 1
    }
    out = out + "]\n"

    out = out + "}\n"
    return out
}

