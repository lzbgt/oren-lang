import lexer "lexer.oren"
import parser "parser.oren"
import analysis "analysis.oren"
import metadata "metadata.oren"
import native_ir "native_ir_v0.oren"

fn json_string(s) { return "\"" + metadata.escape_json_string(s) + "\"" }

fn json_kv_str(k, v) {
    if v == nil { return json_string(k) + ": null" }
    return json_string(k) + ": " + json_string(v)
}

fn json_kv_int(k, v) {
    if v == nil { return json_string(k) + ": null" }
    return json_string(k) + ": " + oren_int_to_string(v)
}

fn json_kv_bool(k, v) {
    if v == true { return json_string(k) + ": true" }
    if v == false { return json_string(k) + ": false" }
    return json_string(k) + ": null"
}

fn join_with(parts, sep) {
    if parts == nil { return "" }
    var n = oren_list_len(parts)
    if n <= 0 { return "" }
    if n == 1 { return parts[0] }
    var out = []
    var i = 0
    while i < n {
        if i != 0 { oren_list_push(out, sep) }
        oren_list_push(out, parts[i])
        i = i + 1
    }
    return oren_string_join(out)
}

fn _target_abi_for(arch, target_os) {
    if arch == "x64" {
        if target_os == "windows" { return "win64" }
        return "sysv"
    }
    if arch == "arm64" { return "aapcs" }
    return "unknown"
}

fn _native_ir_new_tmp(ctx) {
    var n = ctx["next_tmp"]
    ctx["next_tmp"] = n + 1
    return "%t" + oren_int_to_string(n)
}

fn _native_ir_new_label(ctx, prefix) {
    var n = ctx["next_label"]
    ctx["next_label"] = n + 1
    return prefix + "_" + oren_int_to_string(n)
}

fn _native_ir_emit_block(ctx, label, ops, term) {
    oren_list_push(ctx["blocks"], native_ir.block(label, ops, term))
}

fn _native_ir_is_runtime_helper_callee(callee) {
    if callee == nil { return false }
    if callee == "print" || callee == "exit" { return true }
    if metadata.str_starts_with(callee, "oren_") == true { return true }
    return false
}

fn _native_ir_helper_clobbers_for(abi) {
    if abi == "win64" { return ["rax", "rcx", "rdx", "r8", "r9", "r10", "r11"] }
    if abi == "sysv" { return ["rax", "rcx", "rdx", "rsi", "rdi", "r8", "r9", "r10", "r11"] }
    if abi == "aapcs" {
        return ["x0", "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17"]
    }
    return []
}

fn _native_ir_push_root(ctx, roots, local_id) {
    if local_id == nil { return nil }
    var seen = ctx["root_seen"]
    if seen[local_id] == true { return nil }
    seen[local_id] = true
    var root = native_ir.root(local_id, "tagged")
    oren_list_push(ctx["roots"], root)
    oren_list_push(roots, root)
}

fn _native_ir_roots_for_args(ctx, args) {
    var roots = []
    if args == nil { return roots }
    var n = oren_list_len(args)
    var i = 0
    while i < n {
        _native_ir_push_root(ctx, roots, args[i])
        i = i + 1
    }
    return roots
}

fn _native_ir_expr_name(expr) {
    if expr == nil { return nil }
    if expr["type"] == "Identifier" { return expr["value"] }
    if expr["type"] == "Member" {
        var left = _native_ir_expr_name(expr["left"])
        var prop = expr["prop"]
        if left != nil && prop != nil && prop["type"] == "Identifier" { return left + "." + prop["value"] }
    }
    return nil
}

fn _native_ir_lower_expr(ctx, ops, expr) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Integer" {
        var dst_i = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_const(dst_i, "int", expr["value"]))
        return dst_i
    }
    if t == "Float" {
        var dst_f = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_const(dst_f, "float", expr["value"]))
        return dst_f
    }
    if t == "String" {
        var dst_s = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_const(dst_s, "string", expr["value"]))
        return dst_s
    }
    if t == "Boolean" {
        var dst_b = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_const(dst_b, "bool", expr["value"]))
        return dst_b
    }
    if t == "Nil" {
        var dst_nil = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_const(dst_nil, "nil", nil))
        return dst_nil
    }
    if t == "Identifier" {
        var dst_id = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_local_get(dst_id, expr["value"]))
        return dst_id
    }
    if t == "Infix" {
        var left = _native_ir_lower_expr(ctx, ops, expr["left"])
        var right = _native_ir_lower_expr(ctx, ops, expr["right"])
        var dst_in = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_binary(dst_in, expr["op"], left, right))
        return dst_in
    }
    if t == "Prefix" {
        var val = _native_ir_lower_expr(ctx, ops, expr["right"])
        var dst_pre = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_unary(dst_pre, expr["op"], val))
        return dst_pre
    }
    if t == "Call" {
        var args = []
        var call_args = expr["args"]
        var argc = 0
        if call_args != nil { argc = oren_list_len(call_args) }
        var i = 0
        while i < argc {
            oren_list_push(args, _native_ir_lower_expr(ctx, ops, call_args[i]))
            i = i + 1
        }
        var callee = _native_ir_expr_name(expr["fn"])
        var callee_kind = "direct"
        if callee == nil {
            callee = _native_ir_lower_expr(ctx, ops, expr["fn"])
            callee_kind = "value"
        }
        var dst_call = _native_ir_new_tmp(ctx)
        if callee_kind == "direct" && _native_ir_is_runtime_helper_callee(callee) == true {
            var helper = native_ir.runtime_helper_call(
                callee,
                args,
                dst_call,
                _native_ir_helper_clobbers_for(ctx["abi"]),
                true,
                _native_ir_roots_for_args(ctx, args),
                "enter_exit"
            )
            oren_list_push(ops, helper)
            oren_list_push(ctx["helper_calls"], helper)
        } else {
            oren_list_push(ops, native_ir.op_call(dst_call, callee, args, callee_kind))
        }
        return dst_call
    }
    if t == "Index" {
        var container = _native_ir_lower_expr(ctx, ops, expr["left"])
        var idx = _native_ir_lower_expr(ctx, ops, expr["index"])
        var dst_idx = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_index_get(dst_idx, container, idx))
        return dst_idx
    }
    if t == "Array" {
        var elements = []
        var es = expr["elements"]
        var es_len = 0
        if es != nil { es_len = oren_list_len(es) }
        var ei = 0
        while ei < es_len {
            oren_list_push(elements, _native_ir_lower_expr(ctx, ops, es[ei]))
            ei = ei + 1
        }
        var dst_arr = _native_ir_new_tmp(ctx)
        oren_list_push(ops, native_ir.op_array(dst_arr, elements))
        return dst_arr
    }
    var opaque_inputs = []
    var dst_opq = _native_ir_new_tmp(ctx)
    oren_list_push(ops, native_ir.op_opaque_expr(dst_opq, t, opaque_inputs))
    return dst_opq
}

fn _native_ir_stmt_name(stmt) {
    var name = stmt["name"]
    if name == nil { return nil }
    if oren_is_string(name) == true { return name }
    if name["type"] == "Identifier" { return name["value"] }
    return nil
}

fn _native_ir_body_stmts(body) {
    if body == nil { return [] }
    if body["type"] == "Block" || body["type"] == "StmtList" {
        if body["stmts"] == nil { return [] }
        return body["stmts"]
    }
    return [body]
}

fn _native_ir_lower_if_expr_as_stmt(ctx, label, ops, expr) {
    var cond = _native_ir_lower_expr(ctx, ops, expr["cond"])
    var then_label = _native_ir_new_label(ctx, "if_then")
    var else_label = _native_ir_new_label(ctx, "if_else")
    var cont_label = _native_ir_new_label(ctx, "if_cont")
    _native_ir_emit_block(ctx, label, ops, native_ir.term_branch(cond, then_label, else_label))
    _native_ir_lower_sequence(ctx, then_label, _native_ir_body_stmts(expr["consq"]), cont_label)
    if expr["alt"] != nil {
        _native_ir_lower_sequence(ctx, else_label, _native_ir_body_stmts(expr["alt"]), cont_label)
    } else {
        _native_ir_emit_block(ctx, else_label, [], native_ir.term_jump(cont_label))
    }
    return cont_label
}

fn _native_ir_lower_while_stmt(ctx, label, ops, stmt) {
    var cond_label = _native_ir_new_label(ctx, "while_cond")
    var body_label = _native_ir_new_label(ctx, "while_body")
    var after_label = _native_ir_new_label(ctx, "while_after")
    _native_ir_emit_block(ctx, label, ops, native_ir.term_jump(cond_label))

    var cond_ops = []
    var cond = _native_ir_lower_expr(ctx, cond_ops, stmt["cond"])
    _native_ir_emit_block(ctx, cond_label, cond_ops, native_ir.term_branch(cond, body_label, after_label))

    _native_ir_lower_sequence(ctx, body_label, _native_ir_body_stmts(stmt["body"]), cond_label)
    return after_label
}

fn _native_ir_lower_sequence(ctx, label, stmts, fallthrough_label) {
    var ops = []
    var stmts_len = 0
    if stmts != nil { stmts_len = oren_list_len(stmts) }
    var i = 0
    while i < stmts_len {
        var stmt = stmts[i]
        var st = nil
        if stmt != nil { st = stmt["type"] }
        if st == "If" {
            label = _native_ir_lower_if_expr_as_stmt(ctx, label, ops, stmt)
            ops = []
            i = i + 1
            continue
        }
        if st == "ExprStmt" {
            var expr0 = stmt["expr"]
            if expr0 != nil && expr0["type"] == "If" {
                label = _native_ir_lower_if_expr_as_stmt(ctx, label, ops, expr0)
                ops = []
                i = i + 1
                continue
            }
        }
        if st == "While" {
            label = _native_ir_lower_while_stmt(ctx, label, ops, stmt)
            ops = []
            i = i + 1
            continue
        }
        if st == "Block" || st == "StmtList" {
            var block_label = _native_ir_new_label(ctx, "block")
            var cont_label = _native_ir_new_label(ctx, "block_cont")
            _native_ir_emit_block(ctx, label, ops, native_ir.term_jump(block_label))
            _native_ir_lower_sequence(ctx, block_label, _native_ir_body_stmts(stmt), cont_label)
            label = cont_label
            ops = []
            i = i + 1
            continue
        }
        var term = _native_ir_lower_stmt(ctx, ops, stmt)
        if term != nil {
            _native_ir_emit_block(ctx, label, ops, term)
            return nil
        }
        i = i + 1
    }
    if fallthrough_label != nil {
        _native_ir_emit_block(ctx, label, ops, native_ir.term_jump(fallthrough_label))
    } else {
        _native_ir_emit_block(ctx, label, ops, native_ir.term_return(nil))
    }
}

fn _native_ir_lower_stmt(ctx, ops, stmt) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Var" {
        var value = _native_ir_lower_expr(ctx, ops, stmt["value"])
        var name = _native_ir_stmt_name(stmt)
        if name != nil && value != nil { oren_list_push(ops, native_ir.op_local_set(name, value)) }
        return nil
    }
    if t == "Assign" {
        var value_a = _native_ir_lower_expr(ctx, ops, stmt["value"])
        var name_a = _native_ir_stmt_name(stmt)
        if name_a != nil && value_a != nil { oren_list_push(ops, native_ir.op_local_set(name_a, value_a)) }
        return nil
    }
    if t == "Set" {
        var left = stmt["left"]
        if left != nil && left["type"] == "Index" {
            var container = _native_ir_lower_expr(ctx, ops, left["left"])
            var idx = _native_ir_lower_expr(ctx, ops, left["index"])
            var value_s = _native_ir_lower_expr(ctx, ops, stmt["value"])
            oren_list_push(ops, native_ir.op_index_set(container, idx, value_s))
            return nil
        }
        oren_list_push(ops, native_ir.op_opaque_stmt(t, []))
        return nil
    }
    if t == "Return" {
        var value_r = _native_ir_lower_expr(ctx, ops, stmt["value"])
        return native_ir.term_return(value_r)
    }
    if t == "ExprStmt" {
        var value_e = _native_ir_lower_expr(ctx, ops, stmt["expr"])
        if value_e != nil { oren_list_push(ops, native_ir.op_expr_result(value_e)) }
        return nil
    }
    if t == "Block" || t == "StmtList" {
        var stmts = stmt["stmts"]
        var stmts_len = 0
        if stmts != nil { stmts_len = oren_list_len(stmts) }
        var bi = 0
        while bi < stmts_len {
            var term_b = _native_ir_lower_stmt(ctx, ops, stmts[bi])
            if term_b != nil { return term_b }
            bi = bi + 1
        }
        return nil
    }
    oren_list_push(ops, native_ir.op_opaque_stmt(t, []))
    return nil
}

fn _native_ir_function_from_entry(entry, abi) {
    var name = entry["name"]
    var func = entry["func"]
    var params = nil
    if func != nil { params = func["params"] }
    var arity = 0
    if params != nil { arity = oren_list_len(params) }
    var ctx = {"next_tmp": 0, "next_label": 0, "blocks": [], "roots": [], "root_seen": {}, "helper_calls": [], "abi": abi}
    if func != nil {
        var stmts = analysis.function_body_top_level_stmts(func)
        _native_ir_lower_sequence(ctx, "entry", stmts, nil)
    } else {
        _native_ir_emit_block(ctx, "entry", [], native_ir.term_return(nil))
    }
    var fn0 = native_ir.function(name, arity, arity, ctx["blocks"])
    fn0["roots"] = ctx["roots"]
    fn0["helper_calls"] = ctx["helper_calls"]
    return fn0
}

fn native_ir_from_linked(linked, entry_path, arch, target_os) {
    var abi = _target_abi_for(arch, target_os)
    var ir = native_ir.module(native_ir.target(arch, target_os, abi))
    if linked == nil { return ir }
    var ss = linked["statements"]
    if ss == nil { return ir }
    // Keep std/imported/generated functions too: native backends compile the linked
    // program, not just the entry file.
    var ss_len = oren_list_len(ss)
    var i = 0
    while i < ss_len {
        var s = ss[i]
        if s == nil { i = i + 1; continue }
        var entry = analysis.top_level_function_surface_entry(s)
        if entry != nil {
            oren_list_push(ir["functions"], _native_ir_function_from_entry(entry, abi))
        }
        i = i + 1
    }
    return ir
}

fn _json_string_array_plain(xs) {
    if xs == nil { return "[]" }
    var parts = []
    var n = oren_list_len(xs)
    var i = 0
    while i < n {
        oren_list_push(parts, json_string(xs[i]))
        i = i + 1
    }
    return "[" + join_with(parts, ", ") + "]"
}

fn _json_value(v) {
    if v == nil { return "null" }
    if v == true { return "true" }
    if v == false { return "false" }
    if oren_is_string(v) == true { return json_string(v) }
    if oren_type_tag(v) == 1 { return oren_int_to_string(v) }
    return json_string("<opaque>")
}

fn _native_ir_target_json(t) {
    if t == nil { return "null" }
    return "{ " + json_kv_str("arch", t["arch"]) + ", " + json_kv_str("os", t["os"]) + ", " + json_kv_str("abi", t["abi"]) + " }"
}

fn _native_ir_root_json(r) {
    if r == nil { return "null" }
    return "{ " + json_kv_str("local", r["local"]) + ", " + json_kv_str("kind", r["kind"]) + " }"
}

fn _native_ir_roots_json(roots) {
    if roots == nil { return "[]" }
    var parts = []
    var n = oren_list_len(roots)
    var i = 0
    while i < n {
        oren_list_push(parts, _native_ir_root_json(roots[i]))
        i = i + 1
    }
    return "[" + join_with(parts, ", ") + "]"
}

fn _native_ir_term_json(term) {
    if term == nil { return "null" }
    var kind = term["kind"]
    var out = "{ " + json_kv_str("kind", kind)
    if kind == "return" {
        out = out + ", " + json_kv_str("value", term["value"])
    } else if kind == "jump" {
        out = out + ", " + json_kv_str("target", term["target"])
    } else if kind == "branch" {
        out = out + ", " + json_kv_str("cond", term["cond"])
        out = out + ", " + json_kv_str("true", term["true"])
        out = out + ", " + json_kv_str("false", term["false"])
    } else if kind == "panic" {
        out = out + ", " + json_kv_str("reason", term["reason"])
    }
    out = out + " }"
    return out
}

fn _native_ir_helper_json(call) {
    if call == nil { return "null" }
    var out = "{ "
    out = out + json_kv_str("kind", call["kind"]) + ", "
    out = out + json_kv_str("name", call["name"]) + ", "
    out = out + "\"args\": " + _json_string_array_plain(call["args"]) + ", "
    out = out + json_kv_str("result", call["result"]) + ", "
    out = out + "\"clobbers\": " + _json_string_array_plain(call["clobbers"]) + ", "
    out = out + json_kv_bool("safepoint", call["safepoint"]) + ", "
    out = out + "\"roots\": " + _native_ir_roots_json(call["roots"]) + ", "
    out = out + json_kv_str("call_depth", call["call_depth"])
    out = out + " }"
    return out
}

fn _native_ir_ops_json(ops) {
    if ops == nil { return "[]" }
    var parts = []
    var n = oren_list_len(ops)
    var i = 0
    while i < n {
        oren_list_push(parts, _native_ir_op_json(ops[i]))
        i = i + 1
    }
    return "[" + join_with(parts, ", ") + "]"
}

fn _native_ir_op_json(op) {
    if op == nil { return "null" }
    if op["kind"] == "runtime_helper_call" { return _native_ir_helper_json(op) }
    var kind = op["kind"]
    var out = "{ " + json_kv_str("kind", kind)
    if kind == "const" {
        out = out + ", " + json_kv_str("result", op["result"])
        out = out + ", " + json_kv_str("value_kind", op["value_kind"])
        out = out + ", \"value\": " + _json_value(op["value"])
    } else if kind == "local_get" {
        out = out + ", " + json_kv_str("result", op["result"])
        out = out + ", " + json_kv_str("name", op["name"])
    } else if kind == "local_set" {
        out = out + ", " + json_kv_str("name", op["name"])
        out = out + ", " + json_kv_str("value", op["value"])
    } else if kind == "binary" {
        out = out + ", " + json_kv_str("result", op["result"])
        out = out + ", " + json_kv_str("op", op["op"])
        out = out + ", " + json_kv_str("left", op["left"])
        out = out + ", " + json_kv_str("right", op["right"])
    } else if kind == "unary" {
        out = out + ", " + json_kv_str("result", op["result"])
        out = out + ", " + json_kv_str("op", op["op"])
        out = out + ", " + json_kv_str("value", op["value"])
    } else if kind == "call" {
        out = out + ", " + json_kv_str("result", op["result"])
        out = out + ", " + json_kv_str("callee", op["callee"])
        out = out + ", " + json_kv_str("callee_kind", op["callee_kind"])
        out = out + ", \"args\": " + _json_string_array_plain(op["args"])
    } else if kind == "index_get" {
        out = out + ", " + json_kv_str("result", op["result"])
        out = out + ", " + json_kv_str("container", op["container"])
        out = out + ", " + json_kv_str("index", op["index"])
    } else if kind == "index_set" {
        out = out + ", " + json_kv_str("container", op["container"])
        out = out + ", " + json_kv_str("index", op["index"])
        out = out + ", " + json_kv_str("value", op["value"])
    } else if kind == "expr_result" {
        out = out + ", " + json_kv_str("value", op["value"])
    } else if kind == "array" {
        out = out + ", " + json_kv_str("result", op["result"])
        out = out + ", \"elements\": " + _json_string_array_plain(op["elements"])
    } else if kind == "opaque_stmt" {
        out = out + ", " + json_kv_str("stmt_type", op["stmt_type"])
        out = out + ", \"inputs\": " + _json_string_array_plain(op["inputs"])
    } else if kind == "opaque_expr" {
        out = out + ", " + json_kv_str("result", op["result"])
        out = out + ", " + json_kv_str("expr_type", op["expr_type"])
        out = out + ", \"inputs\": " + _json_string_array_plain(op["inputs"])
    }
    out = out + " }"
    return out
}

fn _native_ir_block_json(block) {
    if block == nil { return "null" }
    var out = "      {\n"
    out = out + "        " + json_kv_str("label", block["label"]) + ",\n"
    out = out + "        \"ops\": " + _native_ir_ops_json(block["ops"]) + ",\n"
    out = out + "        \"terminator\": " + _native_ir_term_json(block["terminator"]) + "\n"
    out = out + "      }"
    return out
}

fn _native_ir_blocks_json(blocks) {
    if blocks == nil { return "[]" }
    var parts = []
    var n = oren_list_len(blocks)
    var i = 0
    while i < n {
        oren_list_push(parts, _native_ir_block_json(blocks[i]))
        i = i + 1
    }
    return "[\n" + join_with(parts, ",\n") + "\n    ]"
}

fn _native_ir_helpers_json(calls) {
    if calls == nil { return "[]" }
    var parts = []
    var n = oren_list_len(calls)
    var i = 0
    while i < n {
        oren_list_push(parts, _native_ir_helper_json(calls[i]))
        i = i + 1
    }
    return "[" + join_with(parts, ", ") + "]"
}

fn _native_ir_function_json(fn0) {
    if fn0 == nil { return "null" }
    var out = "    {\n"
    out = out + "      " + json_kv_str("name", fn0["name"]) + ",\n"
    out = out + "      " + json_kv_int("arity", fn0["arity"]) + ",\n"
    out = out + "      " + json_kv_int("frame_slots", fn0["frame_slots"]) + ",\n"
    out = out + "      \"roots\": " + _native_ir_roots_json(fn0["roots"]) + ",\n"
    out = out + "      \"helper_calls\": " + _native_ir_helpers_json(fn0["helper_calls"]) + ",\n"
    out = out + "      \"blocks\": " + _native_ir_blocks_json(fn0["blocks"]) + "\n"
    out = out + "    }"
    return out
}

fn native_ir_json(ir) {
    if ir == nil { return "{}\n" }
    var validation = native_ir.validate_module(ir)
    var fparts = []
    var fns = ir["functions"]
    var fns_len = 0
    if fns != nil { fns_len = oren_list_len(fns) }
    var i = 0
    while i < fns_len {
        oren_list_push(fparts, _native_ir_function_json(fns[i]))
        i = i + 1
    }
    var out = "{\n"
    out = out + "  " + json_kv_str("schema", ir["schema"]) + ",\n"
    out = out + "  \"target\": " + _native_ir_target_json(ir["target"]) + ",\n"
    out = out + "  \"imports\": " + _json_string_array_plain(ir["imports"]) + ",\n"
    out = out + "  \"exports\": " + _json_string_array_plain(ir["exports"]) + ",\n"
    out = out + "  \"data\": [],\n"
    out = out + "  \"globals\": [],\n"
    out = out + "  \"functions\": [\n"
    out = out + join_with(fparts, ",\n")
    out = out + "\n  ],\n"
    out = out + "  \"validation\": { "
    out = out + json_kv_bool("ok", validation["ok"]) + ", "
    out = out + "\"errors\": " + _json_string_array_plain(validation["errors"])
    out = out + " }\n"
    out = out + "}\n"
    return out
}

fn write_or_print(out_path, content) {
    if out_path == "" {
        print(content)
        return 0
    }
    var w = oren_write_file(out_path, content)
    if oren_is_err(w) {
        print("Failed to write: " + out_path)
        var msg = oren_err_msg(w)
        if msg != nil { print(msg) }
        return 1
    }
    print("Wrote: " + out_path)
    return 0
}

fn dump_tokens_json(src_path, strict_attrs, attr_allow_prefixes, strict_ident_prefixes, ident_allow_prefixes) {
    var trace = oren_env("OREN_TRACE_DUMP")
    if trace != nil && trace != "" { print("TRACE_DUMP dump_tokens_json: read_file start") }
    var src = oren_read_file(src_path)
    if oren_is_err(src) {
        print("Failed to read file: " + src_path)
        var msg = oren_err_msg(src)
        if msg != nil { print(msg) }
        return nil
    }
    if trace != nil && trace != "" { print("TRACE_DUMP dump_tokens_json: read_file ok") }
    var l = lexer.new_lexer(src)
    if trace != nil && trace != "" { print("TRACE_DUMP dump_tokens_json: new_lexer ok") }
    l["file"] = src_path
    if trace != nil && trace != "" { print("TRACE_DUMP dump_tokens_json: set file ok") }

    // Diagnostic: isolate lexer progress from JSON/string processing.
    // Set `OREN_DUMP_TOKENS_FAST=1` to iterate tokens without building JSON.
    var fast = oren_env("OREN_DUMP_TOKENS_FAST")
    if fast != nil && fast != "" {
        var n = 0
        while true {
            if trace != nil && trace != "" && n == 0 { print("TRACE_DUMP dump_tokens_json: next_token start") }
            var t2 = lexer.next_token(l)
            if trace != nil && trace != "" && n == 0 { print("TRACE_DUMP dump_tokens_json: next_token returned") }
            if t2 == nil { break }
            n = n + 1
            if t2["type"] == "EOF" { break }
            // Fail-fast if we ever spin forever (should never happen for finite inputs).
            if n > 1000000 {
                print("dump tokens fast: exceeded 1,000,000 tokens; aborting")
                break
            }
        }
        print("dump tokens fast: tokens=" + oren_int_to_string(n))
        return "[]\n"
    }

    var p = parser.new_parser(l)
    p["strict_attrs"] = strict_attrs
    p["attr_allow_prefixes"] = attr_allow_prefixes
    p["strict_ident_prefixes"] = strict_ident_prefixes
    p["ident_allow_prefixes"] = ident_allow_prefixes

    // Token stream dump (up to EOF).
    var out = "[\n"
    var first = true
    while true {
        var t = lexer.next_token(l)
        if t == nil { break }
        if !first { out = out + ",\n" }
        first = false

        out = out + "  { "
        out = out + json_kv_str("type", t["type"]) + ", "
        out = out + json_kv_str("literal", t["literal"]) + ", "
        out = out + json_kv_str("file", t["file"]) + ", "
        out = out + json_kv_int("line", t["line"]) + ", "
        out = out + json_kv_int("col", t["col"]) + ", "
        out = out + json_kv_int("pos", t["pos"]) + ", "
        out = out + json_kv_int("end", t["end"])
        out = out + " }"

        if t["type"] == "EOF" { break }
    }
    out = out + "\n]\n"
    return out
}

fn linked_summary_json(linked, entry_path) {
    if linked == nil { return "{}\n" }

    // Collect top-level names from the requested entry source in deterministic statement order.
    var functions = []
    var function_details = []
    var structs = []
    var enums = []
    var traits = []

    if linked["traits"] != nil {
        var linked_traits_len = oren_list_len(linked["traits"])
        var ti = 0
        while ti < linked_traits_len {
            oren_list_push(traits, linked["traits"][ti]["name"])
            ti = ti + 1
        }
    }

    var ss = linked["statements"]
    var ss_len_summary = oren_list_len(ss)
    var i = 0
    while i < ss_len_summary {
        var s = ss[i]
        if s == nil { i = i + 1; continue }
        var entry = analysis.top_level_function_surface_entry(s)
        if entry != nil {
            var entry_name = entry["name"]
            var entry_func = entry["func"]
            var include_entry = true
            var entry_tok = entry_func["tok"]
            if entry_path != nil && entry_path != "" && entry_tok != nil && entry_tok["file"] != entry_path {
                include_entry = false
            }
            if metadata.str_starts_with(entry_name, "_oren_generator_") == true { include_entry = false }
            if metadata.str_starts_with(entry_name, "oren_generator_") == true { include_entry = false }
            if include_entry == true {
                oren_list_push(functions, entry_name)
                oren_list_push(function_details, entry_func)
            }
        }
        if s["type"] == "Type" {
            oren_list_push(structs, s["name"]["value"])
        }
        if s["type"] == "Enum" {
            oren_list_push(enums, s["name"]["value"])
        }
        i = i + 1
    }

    var function_parts = []
    var functions_len_summary = oren_list_len(functions)
    i = 0
    while i < functions_len_summary {
        oren_list_push(function_parts, json_string(functions[i]))
        i = i + 1
    }

    var function_detail_parts = []
    var function_details_len_summary = oren_list_len(function_details)
    i = 0
    while i < function_details_len_summary {
        var func = function_details[i]
        var name = analysis.function_surface_name(func, functions[i])
        var yield_info = analysis.function_yield_info(func)
        var entry_parts = []
        oren_list_push(entry_parts, "    { ")
        oren_list_push(entry_parts, json_kv_str("name", name))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, json_kv_bool("contains_yield", yield_info["contains_yield"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, json_kv_int("yield_stmt_count", yield_info["yield_stmt_count"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, "\"yield_stmt_sites\": " + metadata.json_string_array(yield_info["yield_stmt_sites"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, json_kv_bool("contains_yield_value", yield_info["contains_yield_value"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, json_kv_int("yield_value_count", yield_info["yield_value_count"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, "\"yield_value_sites\": " + metadata.json_string_array(yield_info["yield_value_sites"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, "\"yield_value_surface\": " + metadata.json_yield_value_surface(yield_info["yield_value_surface"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, json_kv_bool("contains_yield_exchange", yield_info["contains_yield_exchange"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, json_kv_int("yield_exchange_count", yield_info["yield_exchange_count"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, "\"yield_exchange_sites\": " + metadata.json_string_array(yield_info["yield_exchange_sites"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, "\"yield_exchange_surface\": " + metadata.json_yield_exchange_surface(yield_info["yield_exchange_surface"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, json_kv_bool("contains_generator_finalize", yield_info["contains_generator_finalize"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, json_kv_int("generator_finalize_count", yield_info["generator_finalize_count"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, "\"generator_finalize_sites\": " + metadata.json_string_array(yield_info["generator_finalize_sites"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, "\"generator_finalize_surface\": " + metadata.json_generator_finalize_surface(yield_info["generator_finalize_surface"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, json_kv_bool("is_generator_decl", yield_info["is_generator_decl"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, "\"generator_decl_surface\": " + metadata.json_generator_decl_surface(yield_info["generator_decl_surface"]))
        oren_list_push(entry_parts, ", ")
        oren_list_push(entry_parts, "\"yield_lowering\": " + metadata.json_yield_lowering(yield_info["yield_lowering"]))
        oren_list_push(entry_parts, " }")
        oren_list_push(function_detail_parts, oren_string_join(entry_parts))
        i = i + 1
    }

    var struct_parts = []
    var structs_len_summary = oren_list_len(structs)
    i = 0
    while i < structs_len_summary {
        oren_list_push(struct_parts, json_string(structs[i]))
        i = i + 1
    }

    var enum_parts = []
    var enums_len_summary = oren_list_len(enums)
    i = 0
    while i < enums_len_summary {
        oren_list_push(enum_parts, json_string(enums[i]))
        i = i + 1
    }

    var trait_parts = []
    var traits_len_summary = oren_list_len(traits)
    i = 0
    while i < traits_len_summary {
        oren_list_push(trait_parts, json_string(traits[i]))
        i = i + 1
    }

    var out_parts = []
    oren_list_push(out_parts, "{\n")
    oren_list_push(out_parts, "  \"functions\": [")
    oren_list_push(out_parts, join_with(function_parts, ", "))
    oren_list_push(out_parts, "],\n")
    oren_list_push(out_parts, "  \"function_details\": [\n")
    oren_list_push(out_parts, join_with(function_detail_parts, ",\n"))
    oren_list_push(out_parts, "\n  ],\n")
    oren_list_push(out_parts, "  \"structs\": [")
    oren_list_push(out_parts, join_with(struct_parts, ", "))
    oren_list_push(out_parts, "],\n")
    oren_list_push(out_parts, "  \"enums\": [")
    oren_list_push(out_parts, join_with(enum_parts, ", "))
    oren_list_push(out_parts, "],\n")
    oren_list_push(out_parts, "  \"traits\": [")
    oren_list_push(out_parts, join_with(trait_parts, ", "))
    oren_list_push(out_parts, "]\n")
    oren_list_push(out_parts, "}\n")
    return oren_string_join(out_parts)
}

fn module_graph_json(graph) {
    if graph == nil { return "{}\n" }
    var entry = graph["entry"]
    if entry == nil { entry = "<entry>" }

    var imports = graph["imports"]
    if imports == nil { imports = [] }
    var modules = graph["modules"]
    if modules == nil { modules = [] }

    var out = "{\n"
    out = out + "  " + json_kv_str("entry", entry) + ",\n"

    // Root imports (deterministic, in source order).
    out = out + "  \"imports\": [\n"
    var imports_len_graph = oren_list_len(imports)
    var i = 0
    while i < imports_len_graph {
        var imp = imports[i]
        if i != 0 { out = out + ",\n" }
        out = out + "    { "
        out = out + json_kv_str("alias", imp["alias"]) + ", "
        out = out + json_kv_str("path", imp["path"]) + ", "
        out = out + json_kv_str("prefix", imp["prefix"]) + ", "
        out = out + json_kv_str("full", imp["full"])
        out = out + " }"
        i = i + 1
    }
    out = out + "\n  ],\n"

    // Module list + their import edges (deterministic, module order then source order).
    out = out + "  \"modules\": [\n"
    var modules_len_graph = oren_list_len(modules)
    i = 0
    while i < modules_len_graph {
        var m = modules[i]
        if i != 0 { out = out + ",\n" }
        out = out + "    {\n"
        out = out + "      " + json_kv_str("prefix", m["prefix"]) + ",\n"
        out = out + "      " + json_kv_str("path", m["path"]) + ",\n"

        var imps = m["imports"]
        if imps == nil { imps = [] }
        out = out + "      \"imports\": [\n"
        var imps_len_graph = oren_list_len(imps)
        var j = 0
        while j < imps_len_graph {
            var ei = imps[j]
            if j != 0 { out = out + ",\n" }
            out = out + "        { "
            out = out + json_kv_str("alias", ei["alias"]) + ", "
            out = out + json_kv_str("path", ei["path"]) + ", "
            out = out + json_kv_str("prefix", ei["prefix"]) + ", "
            out = out + json_kv_str("full", ei["full"])
            out = out + " }"
            j = j + 1
        }
        out = out + "\n      ]\n"
        out = out + "    }"
        i = i + 1
    }
    out = out + "\n  ]\n"

    out = out + "}\n"
    return out
}
