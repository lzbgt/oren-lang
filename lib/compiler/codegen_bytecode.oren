// AVM Bytecode Backend

// Opcodes
var AVM_NOP = 0
var AVM_HALT = 1
var AVM_PUSH_CONST = 2
var AVM_POP = 3
var AVM_ADD = 16
var AVM_SUB = 17
var AVM_MUL = 29
var AVM_DIV = 30
var AVM_MOD = 31
var AVM_PRINT = 32
var AVM_PRINT_LIST = 33
var AVM_LOAD_LOCAL = 4
var AVM_STORE_LOCAL = 5
var AVM_LOAD_GLOBAL = 6
var AVM_STORE_GLOBAL = 7
var AVM_JMP = 48
var AVM_JMP_IF = 49
var AVM_CALL = 56
var AVM_RET = 57
var AVM_NEW_LIST = 64
var AVM_NEW_MAP = 65
var AVM_GET_INDEX = 66
var AVM_SET_INDEX = 67
var AVM_CALL_NATIVE2 = 59
var AVM_PUSH_FUNC = 60
var AVM_CALL_INDIRECT = 61
var AVM_CALL_INDIRECT_SPREAD = 68
var AVM_MAKE_CLOSURE = 62
var AVM_LOAD_ENV = 63

// Cooperative tasks + channels (rolling, AVM v1 direction)
var AVM_SPAWN_CALL_LIST = 69       // 0x45
var AVM_JOIN = 70                  // 0x46
var AVM_CHAN_NEW = 71              // 0x47
var AVM_CHAN_SEND = 72             // 0x48
var AVM_CHAN_RECV = 73             // 0x49
var AVM_SELECT_RECV = 74           // 0x4A
var AVM_YIELD = 75                 // 0x4B
var AVM_JOIN_TIMEOUT = 76          // 0x4C
var AVM_SELECT = 77                // 0x4D

var AVM_DOMAIN_CORE = 0
var AVM_DOMAIN_FS = 1
var AVM_DOMAIN_TIME = 2
var AVM_DOMAIN_RNG = 3
var AVM_DOMAIN_NET = 4
var AVM_DOMAIN_PROC = 5
var AVM_DOMAIN_EXIT = 6
var AVM_DOMAIN_ENV = 7
var AVM_DOMAIN_AVM = 8

fn bc_diag_escape(msg) {
    if msg == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(msg) {
        var c = oren_string_char_at(msg, i)
        if c == "\n" { out = out + "\\n"; i = i + 1; continue }
        if c == "\r" { out = out + "\\r"; i = i + 1; continue }
        if c == "\t" { out = out + "\\t"; i = i + 1; continue }
        out = out + c
        i = i + 1
    }
    return out
}

fn bytecode_error(ctx, msg) {
    if ctx == nil { return nil }
    if ctx["errors"] == nil { ctx["errors"] = [] }
    oren_list_push(ctx["errors"], msg)
    ctx["fatal"] = true
    return nil
}

fn new_bytecode_ctx() {
    return {
        "code": [],
        "constants": [],
        "constant_map": {},
        "locals": {},
        "local_count": 0,
        "globals": {},
        "global_count": 0,
        "in_function": false,
        "functions": {},
        "declared_funcs": {},
        // Named function varargs mapping (name -> fixed param count).
        // Presence means the function has a trailing `...rest` parameter.
        "func_varargs_fixed": {},
        "types": {},
        "fixups": [],
        "fun_fixups": [],
        "field_offsets": {},
        "aliases": {},
        "loop_ctx": nil,
        "lambda_counter": 0,
        "env_captures": nil,

        // Optional BYTES blob appended to the constant pool by the compiler driver
        // (tooling metadata, not referenced by program code).
        "meta_bytes": nil
        ,"errors": []
        ,"fatal": false
    }
}

fn is_builtin_ident_name(name) {
    if name == "print" { return true }
    if name == "py_import" { return true }
    if name == "system" { return true }
    if name == "exit" { return true }
    return false
}

fn is_non_capturable_ident_name(name) {
    if name == nil || name == "" { return true }
    if is_builtin_ident_name(name) { return true }
    if str_starts_with(name, "oren_") { return true }
    if str_starts_with(name, "sys_") { return true }
    return false
}

fn lambda_gensym(ctx) {
    var n = ctx["lambda_counter"]
    ctx["lambda_counter"] = n + 1
    return "__oren_lambda_bc_" + oren_int_to_string(n)
}

fn lambda_collect_declared_in_expression(exp, declared) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Function" {
        // Nested lambdas are their own scopes.
        return nil
    }
    if et == "Call" {
        lambda_collect_declared_in_expression(exp["fn"], declared)
        var i = 0
        while i < oren_list_len(exp["args"]) {
            lambda_collect_declared_in_expression(exp["args"][i], declared)
            i = i + 1
        }
        if exp["spread"] != nil { lambda_collect_declared_in_expression(exp["spread"], declared) }
        return nil
    }
    if et == "Prefix" { lambda_collect_declared_in_expression(exp["right"], declared); return nil }
    if et == "Infix" {
        lambda_collect_declared_in_expression(exp["left"], declared)
        lambda_collect_declared_in_expression(exp["right"], declared)
        return nil
    }
    if et == "If" {
        lambda_collect_declared_in_expression(exp["cond"], declared)
        lambda_collect_declared_in_statement(exp["consq"], declared)
        if exp["alt"] != nil { lambda_collect_declared_in_statement(exp["alt"], declared) }
        return nil
    }
    if et == "Member" { lambda_collect_declared_in_expression(exp["left"], declared); return nil }
    if et == "Index" {
        lambda_collect_declared_in_expression(exp["left"], declared)
        lambda_collect_declared_in_expression(exp["index"], declared)
        return nil
    }
    if et == "Array" {
        var j = 0
        while j < oren_list_len(exp["elements"]) {
            lambda_collect_declared_in_expression(exp["elements"][j], declared)
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        while k < oren_list_len(exp["pairs"]) {
            var pair = exp["pairs"][k]
            lambda_collect_declared_in_expression(pair["key"], declared)
            lambda_collect_declared_in_expression(pair["value"], declared)
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { lambda_collect_declared_in_expression(exp["call"], declared); return nil }
    return nil
}

fn lambda_collect_declared_in_statement(stmt, declared) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" {
        var nm = stmt["name"]["value"]
        if nm != nil && nm != "" { declared[nm] = true }
        lambda_collect_declared_in_expression(stmt["value"], declared)
        return nil
    }
    if st == "Assign" { lambda_collect_declared_in_expression(stmt["value"], declared); return nil }
    if st == "Set" {
        lambda_collect_declared_in_expression(stmt["left"], declared)
        lambda_collect_declared_in_expression(stmt["value"], declared)
        return nil
    }
    if st == "Return" { lambda_collect_declared_in_expression(stmt["value"], declared); return nil }
    if st == "ExprStmt" { lambda_collect_declared_in_expression(stmt["expr"], declared); return nil }
    if st == "Block" {
        var i = 0
        while i < oren_list_len(stmt["stmts"]) {
            lambda_collect_declared_in_statement(stmt["stmts"][i], declared)
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        lambda_collect_declared_in_expression(stmt["cond"], declared)
        lambda_collect_declared_in_statement(stmt["body"], declared)
        return nil
    }
    if st == "For" {
        lambda_collect_declared_in_statement(stmt["init"], declared)
        lambda_collect_declared_in_expression(stmt["cond"], declared)
        lambda_collect_declared_in_statement(stmt["post"], declared)
        lambda_collect_declared_in_statement(stmt["body"], declared)
        return nil
    }
    if st == "Spawn" { lambda_collect_declared_in_expression(stmt["call"], declared); return nil }
    return nil
}

fn maybe_add_capture(name, declared, seen, out) {
    if is_non_capturable_ident_name(name) { return nil }
    if declared[name] == true { return nil }
    if seen[name] == true { return nil }
    seen[name] = true
    oren_list_push(out, name)
    return nil
}

fn lambda_collect_used_in_expression(exp, declared, seen, out) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Identifier" {
        maybe_add_capture(exp["value"], declared, seen, out)
        return nil
    }
    if et == "Function" {
        // Nested lambdas are their own closures.
        return nil
    }
    if et == "Call" {
        lambda_collect_used_in_expression(exp["fn"], declared, seen, out)
        var i = 0
        while i < oren_list_len(exp["args"]) {
            lambda_collect_used_in_expression(exp["args"][i], declared, seen, out)
            i = i + 1
        }
        if exp["spread"] != nil { lambda_collect_used_in_expression(exp["spread"], declared, seen, out) }
        return nil
    }
    if et == "Prefix" { lambda_collect_used_in_expression(exp["right"], declared, seen, out); return nil }
    if et == "Infix" {
        lambda_collect_used_in_expression(exp["left"], declared, seen, out)
        lambda_collect_used_in_expression(exp["right"], declared, seen, out)
        return nil
    }
    if et == "If" {
        lambda_collect_used_in_expression(exp["cond"], declared, seen, out)
        lambda_collect_used_in_statement(exp["consq"], declared, seen, out)
        if exp["alt"] != nil { lambda_collect_used_in_statement(exp["alt"], declared, seen, out) }
        return nil
    }
    if et == "Member" { lambda_collect_used_in_expression(exp["left"], declared, seen, out); return nil }
    if et == "Index" {
        lambda_collect_used_in_expression(exp["left"], declared, seen, out)
        lambda_collect_used_in_expression(exp["index"], declared, seen, out)
        return nil
    }
    if et == "Array" {
        var j = 0
        while j < oren_list_len(exp["elements"]) {
            lambda_collect_used_in_expression(exp["elements"][j], declared, seen, out)
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        while k < oren_list_len(exp["pairs"]) {
            var pair = exp["pairs"][k]
            lambda_collect_used_in_expression(pair["key"], declared, seen, out)
            lambda_collect_used_in_expression(pair["value"], declared, seen, out)
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { lambda_collect_used_in_expression(exp["call"], declared, seen, out); return nil }
    return nil
}

fn lambda_collect_used_in_statement(stmt, declared, seen, out) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" { lambda_collect_used_in_expression(stmt["value"], declared, seen, out); return nil }
    if st == "Assign" {
        maybe_add_capture(stmt["name"]["value"], declared, seen, out)
        lambda_collect_used_in_expression(stmt["value"], declared, seen, out)
        return nil
    }
    if st == "Set" {
        if stmt["left"]["type"] == "Identifier" {
            maybe_add_capture(stmt["left"]["value"], declared, seen, out)
        } else {
            lambda_collect_used_in_expression(stmt["left"], declared, seen, out)
        }
        lambda_collect_used_in_expression(stmt["value"], declared, seen, out)
        return nil
    }
    if st == "Return" { lambda_collect_used_in_expression(stmt["value"], declared, seen, out); return nil }
    if st == "ExprStmt" { lambda_collect_used_in_expression(stmt["expr"], declared, seen, out); return nil }
    if st == "Block" {
        var i = 0
        while i < oren_list_len(stmt["stmts"]) {
            lambda_collect_used_in_statement(stmt["stmts"][i], declared, seen, out)
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        lambda_collect_used_in_expression(stmt["cond"], declared, seen, out)
        lambda_collect_used_in_statement(stmt["body"], declared, seen, out)
        return nil
    }
    if st == "For" {
        lambda_collect_used_in_statement(stmt["init"], declared, seen, out)
        lambda_collect_used_in_expression(stmt["cond"], declared, seen, out)
        lambda_collect_used_in_statement(stmt["post"], declared, seen, out)
        lambda_collect_used_in_statement(stmt["body"], declared, seen, out)
        return nil
    }
    if st == "Spawn" { lambda_collect_used_in_expression(stmt["call"], declared, seen, out); return nil }
    return nil
}

fn lambda_free_vars(fun) {
    var declared = {}
    // params
    var i = 0
    while i < oren_list_len(fun["params"]) {
        declared[fun["params"][i]["value"]] = true
        i = i + 1
    }
    // var decls (any depth)
    lambda_collect_declared_in_statement(fun["body"], declared)

    var out = []
    var seen = {}
    lambda_collect_used_in_statement(fun["body"], declared, seen, out)
    return out
}

fn emit_byte(ctx, b) {
    oren_list_push(ctx["code"], b)
}

fn emit_u16(ctx, n) {
    emit_byte(ctx, n & 255)
    emit_byte(ctx, (n / 256) & 255)
}

fn emit_i16(ctx, n) {
    // Two's complement?
    if n < 0 { n = n + 65536 }
    emit_u16(ctx, n)
}

fn patch_u16(ctx, idx, n) {
    if n < 0 { n = n + 65536 }
    var low = n & 255
    var high = (n / 256) & 255
    // ctx["code"] is list. Oren list update?
    // list[idx] = val.
    // Oren AST uses list[i].
    // Runtime oren_index_set.
    // Yes, list index set works.
    var code = ctx["code"]
    code[idx] = low
    code[idx+1] = high
}

fn add_constant(ctx, val) {
    var idx = oren_list_len(ctx["constants"])
    oren_list_push(ctx["constants"], val)
    return idx
}

fn str_starts_with(s, prefix) {
    if s == nil { return false }
    if prefix == nil { return false }
    var plen = oren_string_len(prefix)
    if plen == 0 { return true }
    if oren_string_len(s) < plen { return false }
    return oren_string_slice(s, 0, plen) == prefix
}

fn bytecode_compile_expr(ctx, expr) {
    if ctx != nil && ctx["fatal"] == true { return nil }
    if expr == nil {
        var idx = add_constant(ctx, {"type": "Nil"})
        emit_byte(ctx, AVM_PUSH_CONST)
        emit_u16(ctx, idx)
        return nil
    }
    
    // print("Expr: " + expr["type"])

    if expr["type"] == "SpawnExpr" {
        // spawn <call>  (rolling, bytecode backend):
        // Lower to VM opcode SPAWN_CALL_LIST with an explicit args list.
        //
        // stack: [... fn args_list] SPAWN_CALL_LIST -> [... handle]
        var call = expr["call"]
        if call == nil || call["type"] != "Call" {
            bytecode_error(ctx, "bytecode backend: spawn expects Call")
            return nil
        }
        if call["spread"] != nil {
            bytecode_error(ctx, "bytecode backend: spawn does not support spread args yet")
            return nil
        }

        // fn value
        bytecode_compile_expr(ctx, call["fn"])
        // args
        //
        // Varargs packing (rolling): if the callee is a known named function with
        // a trailing `...rest`, pack extra args into a list as the last element.
        var args = call["args"]
        var fixed = -1
        if call["fn"] != nil && call["fn"]["type"] == "Identifier" {
            var nm = call["fn"]["value"]
            // Only pack for direct named functions (not local/global vars).
            if ctx["locals"][nm] == nil && ctx["globals"][nm] == nil {
                var vf = ctx["func_varargs_fixed"][nm]
                if vf != nil { fixed = vf }
            }
        }
        if fixed >= 0 && oren_list_len(args) < fixed {
            bytecode_error(ctx, "bytecode backend: varargs arity mismatch for " + call["fn"]["value"])
            return nil
        }

        var n_args = oren_list_len(args)
        var fixed_count = n_args
        if fixed >= 0 { fixed_count = fixed }

        var i = 0
        while i < fixed_count {
            bytecode_compile_expr(ctx, args[i])
            i = i + 1
        }
        if fixed >= 0 {
            var ri = fixed
            while ri < n_args {
                bytecode_compile_expr(ctx, args[ri])
                ri = ri + 1
            }
            emit_byte(ctx, AVM_NEW_LIST)
            emit_u16(ctx, n_args - fixed)
        }
        emit_byte(ctx, AVM_NEW_LIST)
        if fixed >= 0 {
            emit_u16(ctx, fixed + 1)
        } else {
            emit_u16(ctx, n_args)
        }
        emit_byte(ctx, AVM_SPAWN_CALL_LIST)
        return nil
    }

    if expr["type"] == "If" {
        bytecode_compile_expr(ctx, expr["cond"])
        
        emit_byte(ctx, AVM_JMP_IF)
        var jump_then_idx = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)
        
        emit_byte(ctx, AVM_JMP)
        var jump_else_idx = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)
        
        var then_start = oren_list_len(ctx["code"])
        bytecode_compile_stmt(ctx, expr["consq"])
        
        emit_byte(ctx, AVM_JMP)
        var jump_end_idx = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)
        
        var else_start = oren_list_len(ctx["code"])
        if expr["alt"] != nil {
            bytecode_compile_stmt(ctx, expr["alt"])
        }
        
        var end_pc = oren_list_len(ctx["code"])
        
        patch_u16(ctx, jump_then_idx, then_start - (jump_then_idx + 2))
        patch_u16(ctx, jump_else_idx, else_start - (jump_else_idx + 2))
        patch_u16(ctx, jump_end_idx, end_pc - (jump_end_idx + 2))

        // Treat `if { ... } else { ... }` as an expression that evaluates to `nil`.
        // This keeps stack depth consistent when `if` appears in statement position
        // (ExprStmt emits AVM_POP after compiling the expression).
        var nil_idx = add_constant(ctx, {"type": "Nil"})
        emit_byte(ctx, AVM_PUSH_CONST)
        emit_u16(ctx, nil_idx)
        return nil
    }

    if expr["type"] == "Hash" {
        var entries = expr["pairs"]
        var i = 0
        while i < oren_list_len(entries) {
            var ent = entries[i]
            bytecode_compile_expr(ctx, ent["key"])
            bytecode_compile_expr(ctx, ent["value"])
            i = i + 1
        }
        emit_byte(ctx, AVM_NEW_MAP)
        emit_u16(ctx, oren_list_len(entries))
        return nil
    }

    if expr["type"] == "Array" {
        var elements = expr["elements"]
        var i = 0
        while i < oren_list_len(elements) {
            bytecode_compile_expr(ctx, elements[i])
            i = i + 1
        }
        emit_byte(ctx, AVM_NEW_LIST)
        emit_u16(ctx, oren_list_len(elements))
        return nil
    }

    if expr["type"] == "Function" {
        // Function literal (lambda): parser lowers `|...| { ... }` into an anonymous Function node (name="").
        // Rolling closure model (v0): capture-by-value, env is a LIST in deterministic first-use order.
        if expr["name"] == "" {
            if expr["lambda_name"] == nil {
                expr["lambda_name"] = lambda_gensym(ctx)
                expr["captures"] = lambda_free_vars(expr)
            }
            var lname = expr["lambda_name"]
            // Compile the lambda body exactly once (it is skipped at runtime via an entry JMP).
            if ctx["functions"][lname] == nil {
                var old_name = expr["name"]
                expr["name"] = lname
                bytecode_compile_function(ctx, expr)
                expr["name"] = old_name
            }

            var caps = expr["captures"]
            if caps == nil { caps = [] }
            var ci = 0
            while ci < oren_list_len(caps) {
                bytecode_compile_expr(ctx, {"type": "Identifier", "value": caps[ci]})
                ci = ci + 1
            }

            emit_byte(ctx, AVM_PUSH_FUNC)
            emit_u16(ctx, ctx["functions"][lname])
            if oren_list_len(caps) > 0 {
                emit_byte(ctx, AVM_MAKE_CLOSURE)
                emit_byte(ctx, oren_list_len(caps))
            }
            return nil
        }

        // Named function literal in expression position: treat as a function value.
        // Ensure the function body is compiled and then push it as a function value.
        var nm = expr["name"]
        if nm != nil && nm != "" {
            if ctx["functions"][nm] == nil {
                bytecode_compile_function(ctx, expr)
            }
            emit_byte(ctx, AVM_PUSH_FUNC)
            emit_u16(ctx, ctx["functions"][nm])
            return nil
        }
    }
    
    if expr["type"] == "Member" {
        var left_node = expr["left"]
        if left_node["type"] == "Identifier" {
            var left = left_node["value"]
            var alias = ctx["aliases"][left]
            if alias != nil {
                var prop = expr["prop"]["value"]
                var name = alias + prop
                var glob = ctx["globals"][name]
                if glob != nil {
                    emit_byte(ctx, AVM_LOAD_GLOBAL)
                    emit_u16(ctx, glob)
                    return nil
                }
                var faddr = ctx["functions"][name]
                if faddr != nil {
                    emit_byte(ctx, AVM_PUSH_FUNC)
                    emit_u16(ctx, faddr)
                    return nil
                }
                if ctx["declared_funcs"][name] == true {
                    emit_byte(ctx, AVM_PUSH_FUNC)
                    var fpos = oren_list_len(ctx["code"])
                    emit_u16(ctx, 0)
                    oren_list_push(ctx["fun_fixups"], {"pos": fpos, "name": name})
                    return nil
                }
                // Fallthrough if not global (maybe member of variable shadowing module?)
            }
        }
        
        bytecode_compile_expr(ctx, expr["left"])
        var prop = expr["prop"]["value"]
        var offset = ctx["field_offsets"][prop]
        if offset != nil {
            var idx = add_constant(ctx, {"type": "Integer", "value": offset})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, idx)
            emit_byte(ctx, AVM_GET_INDEX)
        }
        return nil
    }

    if expr["type"] == "Index" {
        bytecode_compile_expr(ctx, expr["left"])
        bytecode_compile_expr(ctx, expr["index"])
        emit_byte(ctx, AVM_GET_INDEX)
        return nil
    }

    if expr["type"] == "String" {
        var idx = add_constant(ctx, {"type": "String", "value": expr["value"]})
        emit_byte(ctx, AVM_PUSH_CONST)
        emit_u16(ctx, idx)
        return nil
    }

    if expr["type"] == "Nil" {
        var idx = add_constant(ctx, {"type": "Nil"})
        emit_byte(ctx, AVM_PUSH_CONST)
        emit_u16(ctx, idx)
        return nil
    }

    if expr["type"] == "Boolean" {
        var v = 0
        if expr["value"] == true { v = 1 }
        var idx = add_constant(ctx, {"type": "Bool", "value": v})
        emit_byte(ctx, AVM_PUSH_CONST)
        emit_u16(ctx, idx)
        return nil
    }

    if expr["type"] == "Integer" {
        var s = expr["value"]
        var val = 0
        var i = 0
        var neg = false
        if s != nil && oren_string_len(s) > 0 {
            var c0 = oren_string_char_at(s, 0)
            if c0 == "-" {
                neg = true
                i = 1
            } else {
                if c0 == "+" {
                    i = 1
                }
            }
        }
        while i < oren_string_len(s) {
            var digit = 0
            var c = oren_string_char_at(s, i)
            if c == "0" { digit = 0 }
            if c == "1" { digit = 1 }
            if c == "2" { digit = 2 }
            if c == "3" { digit = 3 }
            if c == "4" { digit = 4 }
            if c == "5" { digit = 5 }
            if c == "6" { digit = 6 }
            if c == "7" { digit = 7 }
            if c == "8" { digit = 8 }
            if c == "9" { digit = 9 }
            val = val * 10 + digit
            i = i + 1
        }
        if neg { val = 0 - val }
        
        var idx = add_constant(ctx, {"type": "Integer", "value": val})
        emit_byte(ctx, AVM_PUSH_CONST)
        emit_u16(ctx, idx)
        return nil
    }

    if expr["type"] == "Float" {
        // Encode float constants as IEEE-754 f64 raw bits, like the native backend.
        // This avoids locale-dependent parsing inside the VM and keeps results deterministic.
        var bits = oren_string_to_float_bits(expr["value"])
        var idx = add_constant(ctx, {"type": "Float", "value": bits})
        emit_byte(ctx, AVM_PUSH_CONST)
        emit_u16(ctx, idx)
        return nil
    }
    
    if expr["type"] == "Identifier" {
        var name = expr["value"]
        var loc = ctx["locals"][name]
        if loc != nil {
            emit_byte(ctx, AVM_LOAD_LOCAL)
            emit_byte(ctx, loc)
            return nil
        }
        var caps = ctx["env_captures"]
        if caps != nil {
            var cidx = caps[name]
            if cidx != nil {
                emit_byte(ctx, AVM_LOAD_ENV)
                emit_byte(ctx, cidx)
                return nil
            }
        }
        var glob = ctx["globals"][name]
        if glob != nil {
            emit_byte(ctx, AVM_LOAD_GLOBAL)
            emit_u16(ctx, glob)
            return nil
        }
        var faddr = ctx["functions"][name]
        if faddr != nil {
            emit_byte(ctx, AVM_PUSH_FUNC)
            emit_u16(ctx, faddr)
            return nil
        }
        if ctx["declared_funcs"][name] == true {
            emit_byte(ctx, AVM_PUSH_FUNC)
            var fpos = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)
            oren_list_push(ctx["fun_fixups"], {"pos": fpos, "name": name})
            return nil
        }
        // Unknown identifier: leave it as NIL (best-effort in rolling mode).
        var nidx = add_constant(ctx, {"type": "Nil"})
        emit_byte(ctx, AVM_PUSH_CONST)
        emit_u16(ctx, nidx)
        return nil
    }
    
    if expr["type"] == "Infix" {
        // Short-circuit boolean ops (rolling): `&&` and `||` always return BOOL (0/1).
        if expr["op"] == "&&" {
            // if left truthy -> eval right and return truthiness(right), else return false
            bytecode_compile_expr(ctx, expr["left"])

            emit_byte(ctx, AVM_JMP_IF)
            var jump_eval_right = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)

            // left is falsey
            var f_idx = add_constant(ctx, {"type": "Bool", "value": 0})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, f_idx)
            emit_byte(ctx, AVM_JMP)
            var jump_end = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)

            var eval_right_pc = oren_list_len(ctx["code"])
            bytecode_compile_expr(ctx, expr["right"])
            emit_byte(ctx, AVM_JMP_IF)
            var jump_push_true = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)

            // right falsey
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, f_idx)
            emit_byte(ctx, AVM_JMP)
            var jump_end2 = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)

            var push_true_pc = oren_list_len(ctx["code"])
            var t_idx = add_constant(ctx, {"type": "Bool", "value": 1})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, t_idx)

            var end_pc = oren_list_len(ctx["code"])
            patch_u16(ctx, jump_eval_right, eval_right_pc - (jump_eval_right + 2))
            patch_u16(ctx, jump_push_true, push_true_pc - (jump_push_true + 2))
            patch_u16(ctx, jump_end, end_pc - (jump_end + 2))
            patch_u16(ctx, jump_end2, end_pc - (jump_end2 + 2))
            return nil
        }

        if expr["op"] == "||" {
            // if left truthy -> return true, else eval right and return truthiness(right)
            bytecode_compile_expr(ctx, expr["left"])

            emit_byte(ctx, AVM_JMP_IF)
            var jump_push_true_left = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)

            // eval right
            var eval_right_pc = oren_list_len(ctx["code"])
            bytecode_compile_expr(ctx, expr["right"])
            emit_byte(ctx, AVM_JMP_IF)
            var jump_push_true_right = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)

            // right falsey
            var f_idx = add_constant(ctx, {"type": "Bool", "value": 0})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, f_idx)
            emit_byte(ctx, AVM_JMP)
            var jump_end = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)

            var push_true_pc = oren_list_len(ctx["code"])
            var t_idx = add_constant(ctx, {"type": "Bool", "value": 1})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, t_idx)

            var end_pc = oren_list_len(ctx["code"])
            patch_u16(ctx, jump_push_true_left, push_true_pc - (jump_push_true_left + 2))
            patch_u16(ctx, jump_push_true_right, push_true_pc - (jump_push_true_right + 2))
            patch_u16(ctx, jump_end, end_pc - (jump_end + 2))
            return nil
        }

        bytecode_compile_expr(ctx, expr["left"])
        bytecode_compile_expr(ctx, expr["right"])
        if expr["op"] == "+" {
            emit_byte(ctx, AVM_ADD)
        }
        if expr["op"] == "-" {
            emit_byte(ctx, AVM_SUB)
        }
        if expr["op"] == "*" {
            emit_byte(ctx, AVM_MUL)
        }
        if expr["op"] == "/" {
            emit_byte(ctx, AVM_DIV)
        }
        if expr["op"] == "%" {
            emit_byte(ctx, AVM_MOD)
        }
        if expr["op"] == "<" {
            emit_byte(ctx, 18)
        }
        if expr["op"] == "==" { emit_byte(ctx, 19) }
        if expr["op"] == "!=" { emit_byte(ctx, 20) }
        if expr["op"] == ">"  { emit_byte(ctx, 21) }
        if expr["op"] == "<=" { emit_byte(ctx, 22) }
        if expr["op"] == ">=" { emit_byte(ctx, 23) }
        if expr["op"] == "&"  { emit_byte(ctx, 24) }
        if expr["op"] == "|"  { emit_byte(ctx, 25) }
        if expr["op"] == "^"  { emit_byte(ctx, 26) }
        if expr["op"] == "<<" { emit_byte(ctx, 27) }
        if expr["op"] == ">>" { emit_byte(ctx, 28) }
        return nil
    }

    if expr["type"] == "Prefix" {
        var op = expr["op"]
        // Unary minus: (-1) * x
        //
        // Rationale:
        // - Preserves IEEE-754 sign bit for floats (notably -0.0) which `0 - x` does not.
        // - Integers use deterministic wrap semantics (two's complement), so this matches `-x`.
        if op == "-" {
            var z_idx = add_constant(ctx, {"type": "Integer", "value": -1})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, z_idx)
            bytecode_compile_expr(ctx, expr["right"])
            emit_byte(ctx, AVM_MUL)
            return nil
        }

        // Logical NOT: `!x` returns BOOL (0/1) based on truthiness(x)
        if op == "!" {
            bytecode_compile_expr(ctx, expr["right"])

            emit_byte(ctx, AVM_JMP_IF)
            var jump_truthy = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)

            // falsey -> true
            var t_idx = add_constant(ctx, {"type": "Bool", "value": 1})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, t_idx)
            emit_byte(ctx, AVM_JMP)
            var jump_end = oren_list_len(ctx["code"])
            emit_u16(ctx, 0)

            // truthy -> false
            var truthy_pc = oren_list_len(ctx["code"])
            var f_idx = add_constant(ctx, {"type": "Bool", "value": 0})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, f_idx)

            var end_pc = oren_list_len(ctx["code"])
            patch_u16(ctx, jump_truthy, truthy_pc - (jump_truthy + 2))
            patch_u16(ctx, jump_end, end_pc - (jump_end + 2))
            return nil
        }

        // Bitwise NOT: `~x` implemented as `x ^ -1` (two's complement)
        if op == "~" {
            bytecode_compile_expr(ctx, expr["right"])
            var m1_idx = add_constant(ctx, {"type": "Integer", "value": -1})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, m1_idx)
            emit_byte(ctx, 26) // BITXOR
            return nil
        }

        // Unknown prefix: compile operand and leave it (best-effort).
        bytecode_compile_expr(ctx, expr["right"])
        return nil
    }
    
    if expr["type"] == "Call" {
        var name = ""
        var fn_node = expr["fn"]
        var indirect = false
        if fn_node["type"] == "Identifier" {
            name = fn_node["value"]
            // If the identifier resolves to a variable slot, it is a function value call.
            if ctx["locals"][name] != nil { indirect = true }
            if ctx["globals"][name] != nil { indirect = true }
        }
        if fn_node["type"] == "Member" {
            if fn_node["left"]["type"] == "Identifier" {
                var left = fn_node["left"]["value"]
                var prop = fn_node["prop"]["value"]
                var alias = ctx["aliases"][left]
                if alias != nil {
                    name = alias + prop
                } else {
                    // method call / computed member: treat as indirect call of a function value
                    indirect = true
                }
            }
        }
        if name == "" { indirect = true }

        // Type constructor calls (rolling): represent a type value as a LIST of its
        // field values, in declared order. Member access uses field offsets (indexing).
        //
        // This keeps the VM portable (no implicit runtime functions for types).
        if indirect == false {
            var targc = ctx["types"][name]
            if targc != nil {
                if expr["spread"] != nil {
            bytecode_error(ctx, "bytecode backend: type constructor does not support spread args yet: " + name)
            return nil
                }
                var args0 = expr["args"]
                if oren_list_len(args0) != targc {
            bytecode_error(ctx, "bytecode backend: type constructor arity mismatch for " + name)
            return nil
                }
                var ai0 = 0
                while ai0 < oren_list_len(args0) {
                    bytecode_compile_expr(ctx, args0[ai0])
                    ai0 = ai0 + 1
                }
                emit_byte(ctx, AVM_NEW_LIST)
                emit_u16(ctx, targc)
                return nil
            }
        }

        // VM-internal cooperative concurrency primitives (bytecode backend only).
        // These are opcodes (not host natives), so they remain deterministic and portable.
        if name == "oren_new_channel" {
            if oren_list_len(expr["args"]) != 0 {
            bytecode_error(ctx, "bytecode backend: oren_new_channel expects ()")
            return nil
            }
            emit_byte(ctx, AVM_CHAN_NEW)
            return nil
        }
        if name == "oren_chan_send" {
            if oren_list_len(expr["args"]) != 2 {
            bytecode_error(ctx, "bytecode backend: oren_chan_send expects (ch, val)")
            return nil
            }
            bytecode_compile_expr(ctx, expr["args"][0])
            bytecode_compile_expr(ctx, expr["args"][1])
            emit_byte(ctx, AVM_CHAN_SEND)
            return nil
        }
        if name == "oren_chan_recv" {
            if oren_list_len(expr["args"]) != 1 {
            bytecode_error(ctx, "bytecode backend: oren_chan_recv expects (ch)")
            return nil
            }
            bytecode_compile_expr(ctx, expr["args"][0])
            emit_byte(ctx, AVM_CHAN_RECV)
            return nil
        }
        if name == "oren_select_recv" {
            if oren_list_len(expr["args"]) != 1 {
            bytecode_error(ctx, "bytecode backend: oren_select_recv expects (list<ch>)")
            return nil
            }
            bytecode_compile_expr(ctx, expr["args"][0])
            emit_byte(ctx, AVM_SELECT_RECV)
            return nil
        }
        if name == "oren_select" {
            if oren_list_len(expr["args"]) != 1 {
            bytecode_error(ctx, "bytecode backend: oren_select expects (list<case>)")
            return nil
            }
            bytecode_compile_expr(ctx, expr["args"][0])
            emit_byte(ctx, AVM_SELECT)
            return nil
        }
        if name == "oren_join" {
            if oren_list_len(expr["args"]) != 1 {
            bytecode_error(ctx, "bytecode backend: oren_join expects (handle)")
            return nil
            }
            bytecode_compile_expr(ctx, expr["args"][0])
            emit_byte(ctx, AVM_JOIN)
            return nil
        }
        if name == "oren_join_timeout" {
            if oren_list_len(expr["args"]) != 2 {
            bytecode_error(ctx, "bytecode backend: oren_join_timeout expects (handle, timeout_ms)")
            return nil
            }
            bytecode_compile_expr(ctx, expr["args"][0])
            bytecode_compile_expr(ctx, expr["args"][1])
            emit_byte(ctx, AVM_JOIN_TIMEOUT)
            return nil
        }
        if name == "oren_yield" {
            if oren_list_len(expr["args"]) != 0 {
            bytecode_error(ctx, "bytecode backend: oren_yield expects ()")
            return nil
            }
            emit_byte(ctx, AVM_YIELD)
            return nil
        }
        
        // Rolling ABI: prefer domain-based natives for effectful calls.
        // CORE calls currently map op == legacy native id.
        // FS calls use a separate domain/op mapping.
        var native_domain = -1
        var native_op = -1

        if name == "oren_system" { native_domain = AVM_DOMAIN_PROC; native_op = 0 }
        // Builtin aliases (surface names without the `oren_` prefix).
        if name == "system" { native_domain = AVM_DOMAIN_PROC; native_op = 0 }
        if name == "exit" { native_domain = AVM_DOMAIN_EXIT; native_op = 0 }
        if name == "oren_exit" { native_domain = AVM_DOMAIN_EXIT; native_op = 0 }
        if name == "oren_env" { native_domain = AVM_DOMAIN_ENV; native_op = 0 }
        if name == "oren_time_now_ns" { native_domain = AVM_DOMAIN_TIME; native_op = 0 }
        if name == "oren_sleep_ms" { native_domain = AVM_DOMAIN_TIME; native_op = 1 }
        if name == "oren_rand_u64" { native_domain = AVM_DOMAIN_RNG; native_op = 0 }
        if name == "oren_rand_seed" { native_domain = AVM_DOMAIN_RNG; native_op = 1 }
        if name == "oren_net_get" { native_domain = AVM_DOMAIN_NET; native_op = 0 }
        if name == "oren_read_file" { native_domain = AVM_DOMAIN_FS; native_op = 0 }
        if name == "oren_write_file" { native_domain = AVM_DOMAIN_FS; native_op = 1 }
        if name == "oren_write_bytes" { native_domain = AVM_DOMAIN_FS; native_op = 2 }
        if name == "oren_read_bytes" { native_domain = AVM_DOMAIN_FS; native_op = 3 }
        if name == "oren_exists" { native_domain = AVM_DOMAIN_FS; native_op = 4 }
        if name == "oren_readdir" { native_domain = AVM_DOMAIN_FS; native_op = 5 }
        if name == "oren_avm_run_obc_bytes" { native_domain = AVM_DOMAIN_AVM; native_op = 0 }

        if native_domain != -1 {
            var args = expr["args"]
            var i = 0
            while i < oren_list_len(args) {
                bytecode_compile_expr(ctx, args[i])
                i = i + 1
            }
            emit_byte(ctx, AVM_CALL_NATIVE2)
            emit_byte(ctx, native_domain)
            emit_u16(ctx, native_op)
            emit_byte(ctx, oren_list_len(args))
            return nil
        }

        var native_id = -1
        if name == "oren_args" { native_id = 3 }
        if name == "oren_string_len" { native_id = 6 }
        if name == "oren_string_char_at" { native_id = 7 }
        if name == "oren_string_slice" { native_id = 8 }
        if name == "oren_string_char_code_at" { native_id = 9 }
        if name == "oren_int_to_string" { native_id = 10 }
        if name == "oren_list_len" { native_id = 12 }
        if name == "oren_list_push" { native_id = 13 }
        if name == "oren_index_set" { native_id = 14 }
        if name == "int_mod" { native_id = 15 }
        if name == "oren_bytes_from_string" { native_id = 16 }
        if name == "oren_string_from_bytes" { native_id = 44 }
        if name == "oren_err" { native_id = 19 }
        if name == "oren_is_err" { native_id = 20 }
        if name == "oren_err_code" { native_id = 21 }
        if name == "oren_err_msg" { native_id = 22 }
        if name == "oren_set_result" { native_id = 23 }
        if name == "oren_get_result" { native_id = 24 }
        if name == "oren_bytes_pack" { native_id = 30 }
        if name == "oren_bytes_unpack" { native_id = 31 }
        if name == "oren_bytes_len" { native_id = 32 }
        if name == "oren_bytes_get_u8" { native_id = 33 }
        if name == "oren_bytes_set_u8" { native_id = 34 }
        if name == "oren_bytes_get_u16_be" { native_id = 90 }
        if name == "oren_bytes_get_u16_le" { native_id = 91 }
        if name == "oren_bytes_get_i16_be" { native_id = 92 }
        if name == "oren_bytes_get_i16_le" { native_id = 93 }
        if name == "oren_bytes_get_u32_be" { native_id = 94 }
        if name == "oren_bytes_get_u32_le" { native_id = 95 }
        if name == "oren_bytes_get_i32_be" { native_id = 96 }
        if name == "oren_bytes_get_i32_le" { native_id = 97 }
        if name == "oren_bytes_get_u64_be" { native_id = 98 }
        if name == "oren_bytes_get_u64_le" { native_id = 99 }
        if name == "oren_bytes_get_i64_be" { native_id = 100 }
        if name == "oren_bytes_get_i64_le" { native_id = 101 }
        if name == "oren_bytes_set_u16_be" { native_id = 45 }
        if name == "oren_bytes_set_u16_le" { native_id = 46 }
        if name == "oren_bytes_set_i16_be" { native_id = 47 }
        if name == "oren_bytes_set_i16_le" { native_id = 48 }
        if name == "oren_bytes_set_u32_be" { native_id = 49 }
        if name == "oren_bytes_set_u32_le" { native_id = 50 }
        if name == "oren_bytes_set_i32_be" { native_id = 51 }
        if name == "oren_bytes_set_i32_le" { native_id = 52 }
        if name == "oren_bytes_set_u64_be" { native_id = 102 }
        if name == "oren_bytes_set_u64_le" { native_id = 103 }
        if name == "oren_bytes_set_i64_be" { native_id = 104 }
        if name == "oren_bytes_set_i64_le" { native_id = 105 }
        if name == "oren_f32_round" { native_id = 106 }
        if name == "oren_bool_norm" { native_id = 107 }
        if name == "oren_trunc_int" { native_id = 108 }
        if name == "oren_f32_to_u32_bits" { native_id = 109 }
        if name == "oren_u32_bits_to_f32" { native_id = 110 }
        if name == "oren_f64_to_u64_bits" { native_id = 111 }
        if name == "oren_u64_bits_to_f64" { native_id = 112 }
        if name == "oren_map_len" { native_id = 113 }
        if name == "oren_bytes_from_hex" { native_id = 35 }
        if name == "oren_bytes_to_hex" { native_id = 36 }
        if name == "oren_avm_record_to_bytes" { native_id = 40 }
        if name == "oren_avm_get_record_bytes" { native_id = 41 }
        if name == "oren_avm_set_replay_bytes" { native_id = 42 }
        if name == "oren_iter_next" { native_id = 43 }
        if name == "oren_i32_buf_new" { native_id = 54 }
        if name == "oren_i64_buf_new" { native_id = 55 }
        if name == "oren_f32_buf_new" { native_id = 56 }
        if name == "oren_f64_buf_new" { native_id = 57 }
        if name == "oren_buf_len" { native_id = 58 }
        if name == "oren_buf_load_i32" { native_id = 59 }
        if name == "oren_buf_store_i32" { native_id = 60 }
        if name == "oren_buf_load_i64" { native_id = 61 }
        if name == "oren_buf_store_i64" { native_id = 62 }
        if name == "oren_buf_load_f32" { native_id = 63 }
        if name == "oren_buf_store_f32" { native_id = 64 }
        if name == "oren_buf_load_f64" { native_id = 65 }
        if name == "oren_buf_store_f64" { native_id = 66 }
        if name == "oren_buf_fill_i32" { native_id = 67 }
        if name == "oren_buf_fill_i64" { native_id = 68 }
        if name == "oren_buf_fill_f32" { native_id = 69 }
        if name == "oren_buf_fill_f64" { native_id = 70 }
        if name == "oren_buf_add_i32" { native_id = 71 }
        if name == "oren_buf_add_f32" { native_id = 72 }
        if name == "oren_buf_dot_i32" { native_id = 73 }
        if name == "oren_buf_dot_f32" { native_id = 74 }
        if name == "oren_buf_dot_f32_into" { native_id = 86 }
        if name == "oren_buf_add_i32_into" { native_id = 75 }
        if name == "oren_buf_add_f32_into" { native_id = 76 }
        if name == "oren_buf_scale_f32" { native_id = 77 }
        if name == "oren_buf_reduce_sum_f32" { native_id = 78 }
        if name == "oren_buf_reduce_sum_f32_into" { native_id = 87 }
        if name == "oren_buf_mul_f32_into" { native_id = 79 }
        if name == "oren_buf_mul_f32" { native_id = 80 }
        if name == "oren_buf_mul_i32_into" { native_id = 81 }
        if name == "oren_buf_mul_i32" { native_id = 82 }
        if name == "oren_buf_reduce_sum_i32" { native_id = 83 }
        if name == "oren_buf_scale_f32_into" { native_id = 84 }
        if name == "oren_buf_scale_i32_into" { native_id = 85 }
        if name == "oren_buf_dot_i32_into" { native_id = 88 }
        if name == "oren_buf_reduce_sum_i32_into" { native_id = 89 }

        // Pure path normalization (portable across backends; implemented natively in each backend).
        if name == "oren_realpath" { native_id = 53 }

        if native_id != -1 {
            var args = expr["args"]
            var i = 0
            while i < oren_list_len(args) {
                bytecode_compile_expr(ctx, args[i])
                i = i + 1
            }
            emit_byte(ctx, AVM_CALL_NATIVE2)
            emit_byte(ctx, AVM_DOMAIN_CORE)
            emit_u16(ctx, native_id)
            emit_byte(ctx, oren_list_len(args))
            return nil
        }

        if indirect == true {
            // General call: fn can be a function value / closure.
            bytecode_compile_expr(ctx, fn_node)
            var args = expr["args"]
            var i = 0
            while i < oren_list_len(args) {
                bytecode_compile_expr(ctx, args[i])
                i = i + 1
            }
            if expr["spread"] != nil {
                // Call-site spread: [... fn fixed_args spread_list] CALL_INDIRECT_SPREAD fixed_count
                bytecode_compile_expr(ctx, expr["spread"])
                emit_byte(ctx, AVM_CALL_INDIRECT_SPREAD)
                emit_byte(ctx, oren_list_len(args))
                return nil
            }
            emit_byte(ctx, AVM_CALL_INDIRECT)
            emit_byte(ctx, oren_list_len(args))
            return nil
        }

        if name == "print" {
            // Rolling semantics:
            // - print() prints a newline
            // - print(x) prints x
            // - print(a,b,...) prints values (AVM prints each element as a line; stable for tests)
            //
            // For spread: print(a, xs...) prints fixed args then xs elements.
            var fixed = expr["args"]
            var fixed_n = oren_list_len(fixed)
            if fixed_n > 0 {
                var j = 0
                while j < fixed_n {
                    bytecode_compile_expr(ctx, fixed[j])
                    emit_byte(ctx, AVM_PRINT)
                    j = j + 1
                }
            } else {
                // print() => empty list => newline
                emit_byte(ctx, AVM_NEW_LIST)
                emit_u16(ctx, 0)
                emit_byte(ctx, AVM_PRINT_LIST)
            }
            if expr["spread"] != nil {
                bytecode_compile_expr(ctx, expr["spread"])
                emit_byte(ctx, AVM_PRINT_LIST)
            }
            var idx = add_constant(ctx, {"type": "Nil"})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, idx)
            return nil
        }
        
        var args = expr["args"]
        // Varargs packing (rolling): for direct named calls to a function declared with
        // a trailing `...rest`, pack extra args into a list as the last argument.
        var fixed = -1
        var vf = ctx["func_varargs_fixed"][name]
        if vf != nil { fixed = vf }
        if expr["spread"] != nil {
            if fixed >= 0 {
            bytecode_error(ctx, "bytecode backend: varargs+spread not supported yet for direct calls: " + name)
            return nil
            }
            // Spread calls are compiled as indirect calls so we don't need a dynamic
            // CALL-by-name opcode: push a function value, fixed args, spread list.
            bytecode_compile_expr(ctx, fn_node)
            var i = 0
            while i < oren_list_len(args) {
                bytecode_compile_expr(ctx, args[i])
                i = i + 1
            }
            bytecode_compile_expr(ctx, expr["spread"])
            emit_byte(ctx, AVM_CALL_INDIRECT_SPREAD)
            emit_byte(ctx, oren_list_len(args))
            return nil
        }
        if fixed >= 0 && oren_list_len(args) < fixed {
            bytecode_error(ctx, "bytecode backend: varargs arity mismatch for " + name)
            return nil
        }
        var n_args = oren_list_len(args)
        var i = 0
        var fixed_count = n_args
        if fixed >= 0 { fixed_count = fixed }
        while i < fixed_count {
            bytecode_compile_expr(ctx, args[i])
            i = i + 1
        }
        if fixed >= 0 {
            var ri = fixed
            while ri < n_args {
                bytecode_compile_expr(ctx, args[ri])
                ri = ri + 1
            }
            emit_byte(ctx, AVM_NEW_LIST)
            emit_u16(ctx, n_args - fixed)
        }
        
        emit_byte(ctx, AVM_CALL)
        var call_pos = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)
        if fixed >= 0 {
            emit_byte(ctx, fixed + 1)
        } else {
            emit_byte(ctx, n_args)
        }
        
        oren_list_push(ctx["fixups"], {"pos": call_pos, "name": name})
        return nil
    }
    
    return nil
}

fn bytecode_compile_function(ctx, stmt) {
    var name = stmt["name"]
    
    emit_byte(ctx, AVM_JMP)
    var jump_skip_idx = oren_list_len(ctx["code"])
    emit_u16(ctx, 0)
    
    var start_pc = oren_list_len(ctx["code"])
    ctx["functions"][name] = start_pc
    
    var old_locals = ctx["locals"]
    var old_local_count = ctx["local_count"]
    var old_in_function = ctx["in_function"]
    var old_env_captures = ctx["env_captures"]
    ctx["locals"] = {}
    ctx["local_count"] = 0
    ctx["in_function"] = true

    // Closure env mapping (rolling): captured free vars are accessed via LOAD_ENV.
    ctx["env_captures"] = nil
    var caps = stmt["captures"]
    if caps != nil && oren_list_len(caps) > 0 {
        var cmap = {}
        var ci = 0
        while ci < oren_list_len(caps) {
            cmap[caps[ci]] = ci
            ci = ci + 1
        }
        ctx["env_captures"] = cmap
    }
    
    var params = stmt["params"]
    var i = 0
    while i < oren_list_len(params) {
        var pname = params[i]["value"]
        ctx["locals"][pname] = ctx["local_count"]
        ctx["local_count"] = ctx["local_count"] + 1
        i = i + 1
    }

    // Pre-allocate function locals so var-decls inside loops do not grow stack at runtime.
    // The AVM uses one stack for both locals and evaluation:
    // - fp points at the first argument (CALL sets fp = sp - nargs)
    // - LOAD/STORE_LOCAL index into stack[fp + idx]
    // Therefore we must ensure sp is advanced to include all locals slots up-front.
    bytecode_collect_locals_stmt(ctx, stmt["body"])

    var need = ctx["local_count"] - oren_list_len(params)
    if need > 0 {
        var nil_idx = add_constant(ctx, {"type": "Nil"})
        var k = 0
        while k < need {
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, nil_idx)
            k = k + 1
        }
    }
    
    bytecode_compile_stmt(ctx, stmt["body"])
    
    var idx = add_constant(ctx, {"type": "Integer", "value": 0})
    emit_byte(ctx, AVM_PUSH_CONST)
    emit_u16(ctx, idx)
    emit_byte(ctx, AVM_RET)
    
    var end_pc = oren_list_len(ctx["code"])
    patch_u16(ctx, jump_skip_idx, end_pc - (jump_skip_idx + 2))
    
    ctx["locals"] = old_locals
    ctx["local_count"] = old_local_count
    ctx["in_function"] = old_in_function
    ctx["env_captures"] = old_env_captures
    return nil
}

fn bytecode_collect_locals_stmt(ctx, stmt) {
    if stmt == nil { return nil }

    // Do not descend into nested functions (they have their own locals scope).
    if stmt["type"] == "Function" { return nil }
    if stmt["type"] == "ExprStmt" {
        if stmt["expr"] != nil && stmt["expr"]["type"] == "Function" { return nil }
        // If is an expression in the AST but can contain blocks with Var statements.
        // Collect locals declared inside those blocks (Oren has function-scope vars today).
        if stmt["expr"] != nil && stmt["expr"]["type"] == "If" {
            bytecode_collect_locals_stmt(ctx, stmt["expr"]["consq"])
            if stmt["expr"]["alt"] != nil {
                bytecode_collect_locals_stmt(ctx, stmt["expr"]["alt"])
            }
        }
    }

    if stmt["type"] == "Var" {
        var name = stmt["name"]["value"]
        if ctx["locals"][name] == nil {
            ctx["locals"][name] = ctx["local_count"]
            ctx["local_count"] = ctx["local_count"] + 1
        }
        return nil
    }
    if stmt["type"] == "Block" {
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            bytecode_collect_locals_stmt(ctx, stmts[i])
            i = i + 1
        }
        return nil
    }
    if stmt["type"] == "While" {
        bytecode_collect_locals_stmt(ctx, stmt["body"])
        return nil
    }
    if stmt["type"] == "For" {
        if stmt["init"] != nil { bytecode_collect_locals_stmt(ctx, stmt["init"]) }
        if stmt["post"] != nil { bytecode_collect_locals_stmt(ctx, stmt["post"]) }
        bytecode_collect_locals_stmt(ctx, stmt["body"])
        return nil
    }
    if stmt["type"] == "Return" { return nil }
    if stmt["type"] == "Assign" { return nil }
    if stmt["type"] == "Set" { return nil }
    if stmt["type"] == "Type" { return nil }
    if stmt["type"] == "FFI" { return nil }
    if stmt["type"] == "Break" { return nil }
    if stmt["type"] == "Continue" { return nil }
    return nil
}

fn bytecode_compile_stmt(ctx, stmt) {
    if ctx != nil && ctx["fatal"] == true { return nil }
    if stmt["type"] == "Break" {
        var loop = ctx["loop_ctx"]
        if loop == nil {
            bytecode_error(ctx, "bytecode backend: break outside of loop")
            return nil
        }
        emit_byte(ctx, AVM_JMP)
        var jidx = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)
        oren_list_push(loop["break_jumps"], jidx)
        return nil
    }

    if stmt["type"] == "Continue" {
        var loop2 = ctx["loop_ctx"]
        if loop2 == nil {
            bytecode_error(ctx, "bytecode backend: continue outside of loop")
            return nil
        }
        emit_byte(ctx, AVM_JMP)
        var jidx2 = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)
        oren_list_push(loop2["continue_jumps"], jidx2)
        return nil
    }

    if stmt["type"] == "Type" {
        var tname = stmt["name"]["value"]
        var fields = stmt["fields"]
        ctx["types"][tname] = oren_list_len(fields)
        var i = 0
        while i < oren_list_len(fields) {
            var f = fields[i]["value"]
            if ctx["field_offsets"][f] == nil {
                ctx["field_offsets"][f] = i
            }
            i = i + 1
        }
        return nil
    }

    if stmt["type"] == "Spawn" {
        // spawn <call> as a statement: compile the spawn expr and discard the handle.
        var call = stmt["call"]
        if call == nil || call["type"] != "Call" {
            bytecode_error(ctx, "bytecode backend: spawn expects Call")
            return nil
        }
        if call["spread"] != nil {
            bytecode_error(ctx, "bytecode backend: spawn does not support spread args yet")
            return nil
        }
        bytecode_compile_expr(ctx, call["fn"])
        var args = call["args"]
        var i = 0
        while i < oren_list_len(args) {
            bytecode_compile_expr(ctx, args[i])
            i = i + 1
        }
        emit_byte(ctx, AVM_NEW_LIST)
        emit_u16(ctx, oren_list_len(args))
        emit_byte(ctx, AVM_SPAWN_CALL_LIST)
        emit_byte(ctx, AVM_POP)
        return nil
    }

    if stmt["type"] == "ExprStmt" {
        var expr = stmt["expr"]
        if expr["type"] == "Function" && expr["name"] != nil && expr["name"] != "" {
            return bytecode_compile_function(ctx, expr)
        }
        bytecode_compile_expr(ctx, expr)
        emit_byte(ctx, AVM_POP)
        return nil
    }
    
    if stmt["type"] == "Function" {
        return bytecode_compile_function(ctx, stmt)
    }
    
    if stmt["type"] == "Return" {
        if stmt["value"] != nil {
            bytecode_compile_expr(ctx, stmt["value"])
        } else {
            var idx = add_constant(ctx, {"type": "Integer", "value": 0})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, idx)
        }
        emit_byte(ctx, AVM_RET)
        return nil
    }
    
    if stmt["type"] == "Var" {
        bytecode_compile_expr(ctx, stmt["value"])
        var name = stmt["name"]["value"]
        if ctx["in_function"] != true {
            var idx = ctx["global_count"]
            ctx["globals"][name] = idx
            ctx["global_count"] = idx + 1
            emit_byte(ctx, AVM_STORE_GLOBAL)
            emit_u16(ctx, idx)
        } else {
            var idx = ctx["locals"][name]
            if idx == nil {
                // Should not happen: we pre-collect locals in bytecode_compile_function.
            bytecode_error(ctx, "bytecode backend: internal error, missing local slot for " + name)
            return nil
            }
            emit_byte(ctx, AVM_STORE_LOCAL)
            emit_byte(ctx, idx)
        }
        return nil
    }
    
    if stmt["type"] == "Assign" {
        // Assign is for variables (Identifier)
        var target = stmt["name"]
        if target["type"] == "Identifier" {
            var caps = ctx["env_captures"]
            if caps != nil {
                var cidx = caps[target["value"]]
                if cidx != nil {
            bytecode_error(ctx, "bytecode backend: cannot assign to captured var '" + target["value"] + "' (capture-by-value)")
            return nil
                }
            }
            bytecode_compile_expr(ctx, stmt["value"])
            var name = target["value"]
            var loc = ctx["locals"][name]
            if loc != nil {
                emit_byte(ctx, AVM_STORE_LOCAL)
                emit_byte(ctx, loc)
                return nil
            }
            var glob = ctx["globals"][name]
            if glob != nil {
                emit_byte(ctx, AVM_STORE_GLOBAL)
                emit_u16(ctx, glob)
                return nil
            }
        }
        return nil
    }
    
    if stmt["type"] == "Set" {
        var left = stmt["left"]
        if left["type"] == "Index" {
            bytecode_compile_expr(ctx, left["left"])
            bytecode_compile_expr(ctx, left["index"])
            bytecode_compile_expr(ctx, stmt["value"])
            emit_byte(ctx, AVM_SET_INDEX)
            return nil
        }
        if left["type"] == "Member" {
            bytecode_compile_expr(ctx, left["left"])
            var prop = left["prop"]["value"]
            var offset = ctx["field_offsets"][prop]
            if offset != nil {
                var idx = add_constant(ctx, {"type": "Integer", "value": offset})
                emit_byte(ctx, AVM_PUSH_CONST)
                emit_u16(ctx, idx)
                bytecode_compile_expr(ctx, stmt["value"])
                emit_byte(ctx, AVM_SET_INDEX)
            }
            return nil
        }
        return nil
    }
    
    if stmt["type"] == "Block" {
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            bytecode_compile_stmt(ctx, stmts[i])
            i = i + 1
        }
        return nil
    }
    
    if stmt["type"] == "While" {
        var start_pc = oren_list_len(ctx["code"])
        bytecode_compile_expr(ctx, stmt["cond"])
        
        emit_byte(ctx, AVM_JMP_IF)
        var jump_body_idx = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)
        
        emit_byte(ctx, AVM_JMP)
        var jump_end_idx = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)
        
        var body_start = oren_list_len(ctx["code"])

        // Loop context: patchable break/continue.
        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "start_pc": start_pc, "continue_target": start_pc, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop
        bytecode_compile_stmt(ctx, stmt["body"])
        ctx["loop_ctx"] = prev_loop
        
        emit_byte(ctx, AVM_JMP)
        var jump_back_idx = oren_list_len(ctx["code"])
        var off_back = start_pc - (jump_back_idx + 2)
        emit_i16(ctx, off_back)
        
        var end_pc = oren_list_len(ctx["code"])
        
        patch_u16(ctx, jump_body_idx, body_start - (jump_body_idx + 2))
        patch_u16(ctx, jump_end_idx, end_pc - (jump_end_idx + 2))

        // Patch breaks/continues.
        var bi = 0
        while bi < oren_list_len(loop["break_jumps"]) {
            var bpos = loop["break_jumps"][bi]
            patch_u16(ctx, bpos, end_pc - (bpos + 2))
            bi = bi + 1
        }
        var ci = 0
        while ci < oren_list_len(loop["continue_jumps"]) {
            var cpos = loop["continue_jumps"][ci]
            patch_u16(ctx, cpos, loop["continue_target"] - (cpos + 2))
            ci = ci + 1
        }
        
        return nil
    }

    if stmt["type"] == "For" {
        // for { body }
        // for cond { body }
        // for init; cond; post { body }
        if stmt["init"] != nil { bytecode_compile_stmt(ctx, stmt["init"]) }

        var start_pc = oren_list_len(ctx["code"])
        if stmt["cond"] != nil {
            bytecode_compile_expr(ctx, stmt["cond"])
        } else {
            var t_idx = add_constant(ctx, {"type": "Integer", "value": 1})
            emit_byte(ctx, AVM_PUSH_CONST)
            emit_u16(ctx, t_idx)
        }

        emit_byte(ctx, AVM_JMP_IF)
        var jump_body_idx = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)

        emit_byte(ctx, AVM_JMP)
        var jump_end_idx = oren_list_len(ctx["code"])
        emit_u16(ctx, 0)

        var body_start = oren_list_len(ctx["code"])

        // Continue should jump to post, which we only know after compiling the body.
        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "start_pc": start_pc, "continue_target": nil, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop
        bytecode_compile_stmt(ctx, stmt["body"])

        // Post clause (continue target)
        var post_start = oren_list_len(ctx["code"])
        loop["continue_target"] = post_start
        if stmt["post"] != nil { bytecode_compile_stmt(ctx, stmt["post"]) }

        ctx["loop_ctx"] = prev_loop

        emit_byte(ctx, AVM_JMP)
        var jump_back_idx = oren_list_len(ctx["code"])
        var off_back = start_pc - (jump_back_idx + 2)
        emit_i16(ctx, off_back)

        var end_pc = oren_list_len(ctx["code"])

        patch_u16(ctx, jump_body_idx, body_start - (jump_body_idx + 2))
        patch_u16(ctx, jump_end_idx, end_pc - (jump_end_idx + 2))

        // Patch breaks/continues.
        var bi2 = 0
        while bi2 < oren_list_len(loop["break_jumps"]) {
            var bpos2 = loop["break_jumps"][bi2]
            patch_u16(ctx, bpos2, end_pc - (bpos2 + 2))
            bi2 = bi2 + 1
        }
        var ci2 = 0
        while ci2 < oren_list_len(loop["continue_jumps"]) {
            var cpos2 = loop["continue_jumps"][ci2]
            patch_u16(ctx, cpos2, loop["continue_target"] - (cpos2 + 2))
            ci2 = ci2 + 1
        }

        return nil
    }
    
    return nil
}
fn bytecode_compile_program(linked) {
    var ctx = new_bytecode_ctx()
    ctx["aliases"] = linked["aliases"]
    var stmts = linked["statements"]

    // Pre-pass: record declared top-level function names so identifiers can become function values
    // even before the function body is compiled (forward refs).
    var pi = 0
    while pi < oren_list_len(stmts) {
        var st = stmts[pi]
        if st != nil && st["type"] == "Type" {
            var tname = st["name"]["value"]
            var fields = st["fields"]
            ctx["types"][tname] = oren_list_len(fields)
            var fi = 0
            while fi < oren_list_len(fields) {
                var f = fields[fi]["value"]
                if ctx["field_offsets"][f] == nil { ctx["field_offsets"][f] = fi }
                fi = fi + 1
            }
        }
        if st != nil && st["type"] == "Function" {
            var nm = st["name"]
            if nm != nil && nm != "" {
                ctx["declared_funcs"][nm] = true
                var params = st["params"]
                if params != nil && oren_list_len(params) > 0 {
                    var last = params[oren_list_len(params) - 1]
                    if last != nil && last["is_varargs"] == true {
                        ctx["func_varargs_fixed"][nm] = oren_list_len(params) - 1
                    }
                }
            }
        }
        if st != nil && st["type"] == "ExprStmt" {
            var ex = st["expr"]
            if ex != nil && ex["type"] == "Function" {
                var nm2 = ex["name"]
                if nm2 != nil && nm2 != "" {
                    ctx["declared_funcs"][nm2] = true
                    var params2 = ex["params"]
                    if params2 != nil && oren_list_len(params2) > 0 {
                        var last2 = params2[oren_list_len(params2) - 1]
                        if last2 != nil && last2["is_varargs"] == true {
                            ctx["func_varargs_fixed"][nm2] = oren_list_len(params2) - 1
                        }
                    }
                }
            }
        }
        pi = pi + 1
    }

    var i = 0
    while i < oren_list_len(stmts) {
        bytecode_compile_stmt(ctx, stmts[i])
        i = i + 1
    }
    
    // Entry: call main() if present.
    var main_addr = ctx["functions"]["main"]
    if main_addr != nil {
        emit_byte(ctx, AVM_CALL)
        emit_u16(ctx, main_addr)
        emit_byte(ctx, 0) // nargs
        emit_byte(ctx, AVM_POP) // ignore return value
    }
    
    emit_byte(ctx, AVM_HALT)
    
    var j = 0
    var fixups = ctx["fixups"]
    while j < oren_list_len(fixups) {
        var fix = fixups[j]
        var name = fix["name"]
        var pos = fix["pos"]
        var addr = ctx["functions"][name]
        if addr != nil {
            patch_u16(ctx, pos, addr)
        } else {
            bytecode_error(ctx, "Undefined function: " + name)
        }
        j = j + 1
    }

    var k = 0
    var ffix = ctx["fun_fixups"]
    while k < oren_list_len(ffix) {
        var fix2 = ffix[k]
        var name2 = fix2["name"]
        var pos2 = fix2["pos"]
        var addr2 = ctx["functions"][name2]
        if addr2 != nil {
            patch_u16(ctx, pos2, addr2)
        } else {
            bytecode_error(ctx, "Undefined function value: " + name2)
        }
        k = k + 1
    }
    
    return ctx
}

fn emit_u64_le(bytes, n) {
    // Bit-exact for signed ints too (needed for float64 bit patterns).
    var i = 0
    while i < 8 {
        oren_list_push(bytes, (n >> (i * 8)) & 255)
        i = i + 1
    }
}

fn emit_u32_le(bytes, n) {
    var i = 0
    while i < 4 {
        oren_list_push(bytes, n & 255)
        n = n / 256
        i = i + 1
    }
}

fn bytecode_emit_program(out_path, ctx) {
    var bytes = []
    // Magic: 0x0ECD (CD 0E)
    oren_list_push(bytes, 205)
    oren_list_push(bytes, 14)
    
    // Constants
    var consts = ctx["constants"]
    var meta = ctx["meta_bytes"]
    if meta != nil && oren_list_len(meta) > 0 {
        // Rolling: append as an unused BYTES constant.
        oren_list_push(consts, {"type": "Bytes", "value": meta})
    }
    var n_consts = oren_list_len(consts)
    // Count (u16)
    oren_list_push(bytes, n_consts & 255)
    oren_list_push(bytes, (n_consts / 256) & 255)
    
    var i = 0
    while i < n_consts {
        var c = consts[i]
        if c["type"] == "Nil" {
            oren_list_push(bytes, 0) // Type NIL
        }
        if c["type"] == "Integer" {
            oren_list_push(bytes, 1) // Type INT
            emit_u64_le(bytes, c["value"])
        }
        if c["type"] == "Bool" {
            oren_list_push(bytes, 2) // Type BOOL (u8: 0|1)
            var b = c["value"]
            if b != 0 { b = 1 }
            oren_list_push(bytes, b)
        }
        if c["type"] == "Float" {
            // Type FLOAT (rolling): IEEE-754 f64 bits as u64 little-endian.
            oren_list_push(bytes, 3)
            emit_u64_le(bytes, c["value"])
        }
        if c["type"] == "String" {
            oren_list_push(bytes, 4) // Type STRING
            var s = c["value"]
            var s_bytes = oren_bytes_from_string(s)
            var len = oren_list_len(s_bytes)
            oren_list_push(bytes, len & 255)
            oren_list_push(bytes, (len / 256) & 255)
            var k = 0
            while k < len {
                oren_list_push(bytes, s_bytes[k])
                k = k + 1
            }
        }
        if c["type"] == "Bytes" {
            // Type BYTES (rolling): u32 length + raw bytes
            oren_list_push(bytes, 8)
            var b = c["value"]
            var blen = oren_list_len(b)
            emit_u32_le(bytes, blen)
            var k2 = 0
            while k2 < blen {
                oren_list_push(bytes, b[k2])
                k2 = k2 + 1
            }
        }
        i = i + 1
    }
    
    // Code
    var code = ctx["code"]
    var i_code = 0
    while i_code < oren_list_len(code) {
        oren_list_push(bytes, code[i_code])
        i_code = i_code + 1
    }
    
    var w = oren_write_bytes(out_path, bytes)
    if oren_is_err(w) {
        var msg = oren_err_msg(w)
        var e = "Failed to write bytecode: " + out_path
        if msg != nil { e = e + ": " + msg }
        print("OREN_DIAG kind=codegen code=2 msg=" + bc_diag_escape(e))
        print(e)
        oren_exit(1)
    }
    return bytes
}
