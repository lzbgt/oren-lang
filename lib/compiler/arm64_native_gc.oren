import core "arm64_core.oren"

// GC safepoint helpers factored out of arm64_native_stmt.oren to keep stmt emission lean.

fn push_u32_le(buf, n) { return core.push_u32_le(buf, n) }
fn bytes_len(b) { return core.bytes_len(b) }
fn set_u32_le(buf, offset, n) { return core.set_u32_le(buf, offset, n) }
fn arm64_ctx_fixup_bl(ctx, pos, name) { return core.arm64_ctx_fixup_bl(ctx, pos, name) }

fn insn_add_imm(rd, rn, imm) { return core.insn_add_imm(rd, rn, imm) }
fn insn_and_reg(rd, rn, rm) { return core.insn_and_reg(rd, rn, rm) }
fn insn_b_cond(off, cond) { return core.insn_b_cond(off, cond) }
fn insn_cmp_reg(rn, rm) { return core.insn_cmp_reg(rn, rm) }
fn insn_ldp_pair_post(rt, rt2, rn, offset) { return core.insn_ldp_pair_post(rt, rt2, rn, offset) }
fn insn_movz(reg, imm16) { return core.insn_movz(reg, imm16) }
fn insn_stp_pair_pre(rt, rt2, rn, offset) { return core.insn_stp_pair_pre(rt, rt2, rn, offset) }

fn emit_ldr_reg_sp_any(ctx, reg, offset) { return core.emit_ldr_reg_sp_any(ctx, reg, offset) }
fn emit_str_reg_sp_any(ctx, reg, offset) { return core.emit_str_reg_sp_any(ctx, reg, offset) }

var ARM64_TRACE_GC_TICK_OFF = -1
var ARM64_TRACE_GC_TICK_ALL = false

fn _arm64_trace_gc_tick_off_enabled() {
    if ARM64_TRACE_GC_TICK_OFF == 1 { return true }
    if ARM64_TRACE_GC_TICK_OFF == 0 { return false }
    var v = oren_env("OREN_TRACE_ARM64_GC_TICK_OFF")
    if v == nil || v == "" {
        ARM64_TRACE_GC_TICK_OFF = 0
        return false
    }
    if v == "all" { ARM64_TRACE_GC_TICK_ALL = true }
    ARM64_TRACE_GC_TICK_OFF = 1
    return true
}

fn _arm64_trace_gc_tick_off(ctx, loop_base_stack, tick_off, tick_mask) {
    if !_arm64_trace_gc_tick_off_enabled() { return nil }
    if ARM64_TRACE_GC_TICK_ALL != true && tick_off >= 0 { return nil }
    var stack_size = 0
    var kind = nil
    var last = nil
    var last_restore = nil
    if ctx != nil { stack_size = ctx["stack_size"] }
    if ctx != nil { kind = ctx["loop_kind"] }
    if ctx != nil { last = ctx["last_loop_stack"] }
    if ctx != nil { last_restore = ctx["last_stack_restore"] }
    var msg = "[arm64_gc_tick_off] tick_off=" + oren_int_to_string(tick_off) +
        " base=" + oren_int_to_string(loop_base_stack) +
        " stack=" + oren_int_to_string(stack_size) +
        " mask=" + oren_int_to_string(tick_mask)
    if kind != nil && kind != "" { msg = msg + " kind=" + kind }
    if tick_off < 0 && last != nil {
        var last_kind = last["kind"]
        var last_base = last["base"]
        var last_stack = last["stack"]
        var last_slots = last["slots"]
        var last_bytes = last["bytes"]
        var last_tick = last["tick_off"]
        var last_kind_str = "nil"
        if last_kind != nil { last_kind_str = last_kind }
        var last_base_str = "nil"
        if last_base != nil { last_base_str = oren_int_to_string(last_base) }
        var last_stack_str = "nil"
        if last_stack != nil { last_stack_str = oren_int_to_string(last_stack) }
        var last_slots_str = "nil"
        if last_slots != nil { last_slots_str = oren_int_to_string(last_slots) }
        var last_bytes_str = "nil"
        if last_bytes != nil { last_bytes_str = oren_int_to_string(last_bytes) }
        var last_tick_str = "nil"
        if last_tick != nil { last_tick_str = oren_int_to_string(last_tick) }
        msg = msg + " last_kind=" + last_kind_str +
            " last_base=" + last_base_str +
            " last_stack=" + last_stack_str +
            " last_slots=" + last_slots_str +
            " last_bytes=" + last_bytes_str +
            " last_tick_off=" + last_tick_str
    }
    if tick_off < 0 && last_restore != nil {
        var rs_delta = last_restore["delta"]
        var rs_base = last_restore["base"]
        var rs_stack = last_restore["stack"]
        var rs_kind = last_restore["kind"]
        var rs_delta_str = "nil"
        if rs_delta != nil { rs_delta_str = oren_int_to_string(rs_delta) }
        var rs_base_str = "nil"
        if rs_base != nil { rs_base_str = oren_int_to_string(rs_base) }
        var rs_stack_str = "nil"
        if rs_stack != nil { rs_stack_str = oren_int_to_string(rs_stack) }
        var rs_kind_str = "nil"
        if rs_kind != nil { rs_kind_str = rs_kind }
        msg = msg + " last_restore_delta=" + rs_delta_str +
            " last_restore_base=" + rs_base_str +
            " last_restore_stack=" + rs_stack_str +
            " last_restore_kind=" + rs_kind_str
    }
    print(msg)
    return nil
}

fn native_emit_gc_safepoint_call(ctx) {
    // Spill callee-saved regs so conservative GC sees register-held pointers.
    push_u32_le(ctx["code"], insn_stp_pair_pre(19, 20, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(21, 22, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(23, 24, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(25, 26, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(27, 28, 31, -16))

    var bl_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_gc_safepoint"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_gc_safepoint")

    push_u32_le(ctx["code"], insn_ldp_pair_post(27, 28, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(25, 26, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(23, 24, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(21, 22, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(19, 20, 31, 16))
    return nil
}

fn native_emit_gc_safepoint_throttled(ctx, loop_base_stack, tick_mask) {
    // PERF:
    // Calling `oren_gc_safepoint()` on every loop iteration dominates lexer/parser loops.
    // Emit a cheap counter+mask gate so we only call into the runtime periodically.
    //
    // Contract:
    // - Caller must ensure a u64 tick slot exists at loop_base_stack (offset 0 when SP==base).
    // - Uses X9/X10 as scratch (caller-saved).
    //
    // tick = tick + 1; if (tick & mask) != 0 => skip; else call safepoint.
    var tick_off = ctx["stack_size"] - loop_base_stack
    _arm64_trace_gc_tick_off(ctx, loop_base_stack, tick_off, tick_mask)
    // Load tick into X9.
    emit_ldr_reg_sp_any(ctx, 9, tick_off)
    // tick++
    push_u32_le(ctx["code"], insn_add_imm(9, 9, 1))
    emit_str_reg_sp_any(ctx, 9, tick_off)
    // if ((tick & mask) != 0) goto skip
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))
    push_u32_le(ctx["code"], insn_and_reg(9, 9, 10))
    push_u32_le(ctx["code"], insn_cmp_reg(9, 31))
    var jskip_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ne skip

    native_emit_gc_safepoint_call(ctx)

    var after_call = bytes_len(ctx["code"])
    var off = (after_call - jskip_pos) / 4
    // cond=1 is NE in the AArch64 condition-code encoding.
    set_u32_le(ctx["code"], jskip_pos, insn_b_cond(off, 1))
    return nil
}

fn native_emit_gc_safepoint_inline_tick(ctx, tick_mask) {
    // PERF:
    // Inline tick update for hot loops that do not allocate inside the body.
    //
    // Contract:
    // - Caller initializes X9=0 and X10=tick_mask before entering the loop.
    // - Uses X11 as scratch (caller-saved).
    //
    // tick = tick + 1; if (tick & mask) != 0 => skip; else call safepoint.
    push_u32_le(ctx["code"], insn_add_imm(9, 9, 1))
    push_u32_le(ctx["code"], insn_and_reg(11, 9, 10))
    push_u32_le(ctx["code"], insn_cmp_reg(11, 31))
    var jskip_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ne skip

    native_emit_gc_safepoint_call(ctx)
    // Reset tick/mask after runtime call (caller-saved regs).
    push_u32_le(ctx["code"], insn_movz(9, 0))
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    var after_call = bytes_len(ctx["code"])
    var off = (after_call - jskip_pos) / 4
    set_u32_le(ctx["code"], jskip_pos, insn_b_cond(off, 1)) // NE
    return nil
}
