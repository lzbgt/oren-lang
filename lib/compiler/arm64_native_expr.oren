            if is_macos {
                var br_ok_macos = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.CC ok
                push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0)) // X0 = -errno
                var ok_pos_macos = oren_list_len(ctx["code"])
