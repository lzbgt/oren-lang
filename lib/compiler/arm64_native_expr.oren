fn native_expr_is_floaty(ctx, expr) {
    // Heuristic, rolling "float propagation" for the native backend.
    //
    // Native float values are raw IEEE-754 f64 bits in a 64-bit register.
    // Without a tagged dynamic value, we cannot decide "float vs int" at runtime,
    // so we conservatively decide based on AST + local assignment tracking.
    if expr == nil { return false }
    var et = expr["type"]
    if et == "Float" { return true }
    if et == "Identifier" {
        var name = expr["value"]
        if ctx != nil {
            if ctx["locals_floaty"] != nil {
                if ctx["locals_floaty"][name] == true { return true }
            }
            if ctx["globals_floaty"] != nil {
                if ctx["globals_floaty"][name] == true { return true }
            }
        }
        return false
    }
    if et == "Call" {
        var fnn = expr["fn"]
        if fnn != nil && fnn["type"] == "Identifier" {
            var nm = fnn["value"]
            if nm == "fadd" || nm == "fsub" || nm == "fmul" || nm == "fdiv" { return true }
        }
        return false
    }
    if et == "Prefix" {
        if expr["op"] == "-" { return native_expr_is_floaty(ctx, expr["right"]) }
        return false
    }
    if et == "Infix" {
        var op = expr["op"]
        if op == "+" || op == "-" || op == "*" || op == "/" {
            if native_expr_is_floaty(ctx, expr["left"]) { return true }
            if native_expr_is_floaty(ctx, expr["right"]) { return true }
        }
        return false
    }
    return false
}

fn native_expr_is_stringy(ctx, expr) {
    // Heuristic "string propagation" for the native backend.
    //
    // Native values are raw pointers; without a tagged value type we cannot decide at runtime,
    // so comparisons are lowered based on compile-time evidence.
    if expr == nil { return false }
    var et = expr["type"]
    if et == "String" { return true }
    if et == "Identifier" {
        var name = expr["value"]
        if ctx != nil {
            if ctx["locals_stringy"] != nil {
                if ctx["locals_stringy"][name] == true { return true }
            }
            if ctx["globals_stringy"] != nil {
                if ctx["globals_stringy"][name] == true { return true }
            }
        }
        return false
    }
    if et == "Infix" {
        // String concat is `+` only, and runtime only concatenates when both are strings.
        if expr["op"] == "+" {
            if native_expr_is_stringy(ctx, expr["left"]) { return true }
            if native_expr_is_stringy(ctx, expr["right"]) { return true }
        }
        return false
    }
    if et == "Call" {
        var fnn = expr["fn"]
        if fnn != nil && fnn["type"] == "Identifier" {
            var nm = fnn["value"]
            // Known string-producing helpers in the injected runtime / stdlib.
            if nm == "oren_int_to_string" { return true }
            if nm == "oren_float_to_string" { return true }
            if nm == "oren_string_char_at" { return true }
            if nm == "oren_string_slice" { return true }
            if nm == "oren_string_from_bytes" { return true }
            if nm == "oren_realpath" { return true }
            if nm == "oren_realpath_checked" { return true }
            if nm == "oren_getcwd" { return true }
            if nm == "string_concat" { return true }
        }
        return false
    }
    return false
}
