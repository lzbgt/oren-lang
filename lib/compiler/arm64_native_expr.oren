fn insn_dup_2d(vd, rn) { return core.insn_dup_2d(vd, rn) }
fn insn_add_2d(vd, vn, vm) { return core.insn_add_2d(vd, vn, vm) }
fn insn_sub_2d(vd, vn, vm) { return core.insn_sub_2d(vd, vn, vm) }
