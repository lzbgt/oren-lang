fn insn_orr_16b(vd, vn, vm) { return core.insn_orr_16b(vd, vn, vm) }
fn insn_eor_16b(vd, vn, vm) { return core.insn_eor_16b(vd, vn, vm) }
fn insn_umov_d0(rd, vn) { return core.insn_umov_d0(rd, vn) }
