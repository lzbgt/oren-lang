import artifact "artifact_bytes.oren"
import debugart "native_debug_artifact.oren"

// Shared ELF64 artifact helpers.
//
// Scope: format-level byte emission that is identical for x64 and ARM64 ELF.
// Machine IDs, relocation types, instruction code, syscall ABI, and dynamic
// relocation semantics stay in the architecture-specific ELF emitters.

fn push_utf8_aligned(p, s) {
    return debugart.push_utf8_aligned(p, s)
}

fn push_u64_zero4(p) {
    return debugart.push_u64_zero4(p)
}

fn push_phdr(p, p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align) {
    artifact.push_u32_le(p, p_type)
    artifact.push_u32_le(p, p_flags)
    artifact.push_u64_le(p, p_offset)
    artifact.push_u64_le(p, p_vaddr)
    artifact.push_u64_le(p, p_paddr)
    artifact.push_u64_le(p, p_filesz)
    artifact.push_u64_le(p, p_memsz)
    artifact.push_u64_le(p, p_align)
    return nil
}

fn build_prefix(base, hdr_size, phdrs, entry_off, is_shared_lib, machine, shnum, shstrndx) {
    var p = artifact.bytes_new()

    artifact.bytes_push(p, 127); artifact.bytes_push(p, 69); artifact.bytes_push(p, 76); artifact.bytes_push(p, 70) // .ELF
    artifact.bytes_push(p, 2) // ELFCLASS64
    artifact.bytes_push(p, 1) // little endian
    artifact.bytes_push(p, 1) // EV_CURRENT
    artifact.bytes_extend_zeros(p, 1) // System V OS ABI
    artifact.push_u64_le(p, 0) // EI_PAD + rest

    if is_shared_lib == true {
        artifact.push_u16_le(p, 3) // ET_DYN
    } else {
        artifact.push_u16_le(p, 2) // ET_EXEC
    }
    artifact.push_u16_le(p, machine)
    artifact.push_u32_le(p, 1) // EV_CURRENT

    if is_shared_lib == true {
        artifact.push_u64_le(p, 0)
    } else {
        artifact.push_u64_le(p, base + hdr_size + entry_off)
    }
    artifact.push_u64_le(p, 64) // e_phoff
    artifact.push_u64_le(p, 0) // e_shoff
    artifact.push_u32_le(p, 0) // e_flags
    artifact.push_u16_le(p, 64) // e_ehsize
    artifact.push_u16_le(p, 56) // e_phentsize
    artifact.push_u16_le(p, oren_list_len(phdrs))
    artifact.push_u16_le(p, 64) // e_shentsize
    artifact.push_u16_le(p, shnum)
    artifact.push_u16_le(p, shstrndx)

    var i = 0
    while i < oren_list_len(phdrs) {
        var ph = phdrs[i]
        push_phdr(p,
                  ph["type"],
                  ph["flags"],
                  ph["offset"],
                  ph["vaddr"],
                  ph["paddr"],
                  ph["filesz"],
                  ph["memsz"],
                  ph["align"])
        i = i + 1
    }
    return p
}

fn build_program_headers(base, phnum, dyn, is_shared_lib, data_file_off, data_len, dyn_meta) {
    var phdrs = []
    var text_filesz = data_file_off
    if dyn {
        // PT_PHDR covers the ELF64 file header plus program-header table.
        oren_list_push(phdrs, {"type": 6, "flags": 4, "offset": 64, "vaddr": base + 64, "paddr": base + 64, "filesz": phnum * 56, "memsz": phnum * 56, "align": 8})
        if is_shared_lib != true {
            var interp_off = data_file_off + dyn_meta["interp_off"]
            oren_list_push(phdrs, {"type": 3, "flags": 4, "offset": interp_off, "vaddr": base + interp_off, "paddr": base + interp_off, "filesz": dyn_meta["interp_len"], "memsz": dyn_meta["interp_len"], "align": 1})
        }
    }
    oren_list_push(phdrs, {"type": 1, "flags": 5, "offset": 0, "vaddr": base, "paddr": base, "filesz": text_filesz, "memsz": text_filesz, "align": 4096})
    oren_list_push(phdrs, {"type": 1, "flags": 6, "offset": data_file_off, "vaddr": base + data_file_off, "paddr": base + data_file_off, "filesz": data_len, "memsz": data_len, "align": 4096})
    if dyn {
        var dynamic_off = data_file_off + dyn_meta["dynamic_off"]
        oren_list_push(phdrs, {"type": 2, "flags": 6, "offset": dynamic_off, "vaddr": base + dynamic_off, "paddr": base + dynamic_off, "filesz": dyn_meta["dynamic_len"], "memsz": dyn_meta["dynamic_len"], "align": 8})
        oren_list_push(phdrs, {"type": 1685382481, "flags": 6, "offset": 0, "vaddr": 0, "paddr": 0, "filesz": 0, "memsz": 0, "align": 16})
    }
    return phdrs
}

fn bytes_align(buf, align) {
    if buf == nil { return nil }
    if align == nil || align <= 1 { return nil }
    var rem = artifact.int_mod(artifact.bytes_len(buf), align)
    if rem != 0 { artifact.bytes_extend_zeros(buf, align - rem) }
    return nil
}

fn push_string_bytes(buf, s) {
    if buf == nil { return nil }
    if s == nil { s = "" }
    artifact.bytes_extend_string(buf, s)
    return nil
}

fn bytes_add_str0(buf, s) {
    if buf == nil { return nil }
    if s == nil { s = "" }
    var off = artifact.bytes_len(buf)
    artifact.bytes_extend_string_z(buf, s)
    return off
}

fn push_unique(out, seen, s) {
    if out == nil || seen == nil { return nil }
    if s == nil || s == "" { return nil }
    if seen[s] != nil { return nil }
    seen[s] = true
    oren_list_push(out, s)
    return nil
}

fn dyn_needed_libs(user_link_libs) {
    // Linux dynamic executables currently use glibc-compatible libc + libdl.
    var out = []
    var seen = {}
    push_unique(out, seen, "libdl.so.2")
    push_unique(out, seen, "libc.so.6")
    if user_link_libs != nil {
        var i = 0
        var n = oren_list_len(user_link_libs)
        while i < n {
            push_unique(out, seen, user_link_libs[i])
            i = i + 1
        }
    }
    return out
}

fn build_dynamic_name_tables(needed, imports, exports, missing_import_msg, missing_import_diag) {
    var dynstr = artifact.bytes_new()
    artifact.bytes_extend_zeros(dynstr, 1) // leading NUL

    var needed_dynstr_offs = {}
    var i_need = 0
    while needed != nil && i_need < oren_list_len(needed) {
        var lib = needed[i_need]
        needed_dynstr_offs[lib] = bytes_add_str0(dynstr, lib)
        i_need = i_need + 1
    }

    var sym_dynstr_offs = {}
    var i_imp = 0
    while imports != nil && i_imp < oren_list_len(imports) {
        var imp = imports[i_imp]
        var nm = imp["name"]
        if nm == nil || nm == "" {
            if missing_import_diag != nil {
                print("OREN_DIAG kind=codegen code=1 msg=" + missing_import_diag)
            }
            if missing_import_msg == nil { missing_import_msg = "native backend: internal: dyn import missing name" }
            print(missing_import_msg)
            oren_exit(1)
            return nil
        }
        if sym_dynstr_offs[nm] == nil {
            sym_dynstr_offs[nm] = bytes_add_str0(dynstr, nm)
        }
        i_imp = i_imp + 1
    }

    var i_exp = 0
    while exports != nil && i_exp < oren_list_len(exports) {
        var nm3 = exports[i_exp]
        if nm3 == nil || nm3 == "" { i_exp = i_exp + 1; continue }
        if sym_dynstr_offs[nm3] == nil {
            sym_dynstr_offs[nm3] = bytes_add_str0(dynstr, nm3)
        }
        i_exp = i_exp + 1
    }

    return {"dynstr": dynstr, "needed_dynstr_offs": needed_dynstr_offs, "sym_dynstr_offs": sym_dynstr_offs}
}

fn push_dynsym_undef_func(dynsym, name_off) {
    if name_off == nil { name_off = 0 }
    artifact.push_u32_le(dynsym, name_off)
    artifact.bytes_push(dynsym, 18) // STB_GLOBAL | STT_FUNC
    artifact.bytes_extend_zeros(dynsym, 1) // st_other
    artifact.push_u16_le(dynsym, 0) // SHN_UNDEF
    artifact.bytes_extend_zeros(dynsym, 16) // st_value + st_size
    return nil
}

fn push_dynsym_text_func(dynsym, name_off, text_addr) {
    if name_off == nil { name_off = 0 }
    if text_addr == nil { text_addr = 0 }
    artifact.push_u32_le(dynsym, name_off)
    artifact.bytes_push(dynsym, 18) // STB_GLOBAL | STT_FUNC
    artifact.bytes_extend_zeros(dynsym, 1) // st_other
    artifact.push_u16_le(dynsym, 1) // .text
    artifact.push_u64_le(dynsym, text_addr)
    artifact.bytes_extend_zeros(dynsym, 8) // unknown size
    return nil
}

fn push_rela(rela, r_offset, sym_idx, rela_type, addend) {
    if r_offset == nil { r_offset = 0 }
    if addend == nil { addend = 0 }
    artifact.push_u64_le(rela, r_offset)
    artifact.push_u64_le(rela, sym_idx * 4294967296 + rela_type)
    artifact.push_u64_le(rela, addend)
    return nil
}

fn build_sysv_hash(nchain) {
    var hash = artifact.bytes_new()
    var nbucket = 1
    artifact.push_u32_le(hash, nbucket)
    artifact.push_u32_le(hash, nchain)
    artifact.bytes_extend_zeros(hash, (nbucket + nchain) * 4)
    var last = 0
    var si = 1
    while si < nchain {
        if last == 0 {
            artifact.set_u32_le(hash, 8, si)
        } else {
            var chains_off = 8 + 4 * nbucket
            artifact.set_u32_le(hash, chains_off + 4 * last, si)
        }
        last = si
        si = si + 1
    }
    return hash
}

fn append_dyn_tables(data, hash, dynstr, dynsym, rela) {
    bytes_align(data, 8)
    var hash_off = artifact.bytes_len(data)
    artifact.bytes_extend(data, hash)

    bytes_align(data, 8)
    var dynstr_off = artifact.bytes_len(data)
    artifact.bytes_extend(data, dynstr)

    bytes_align(data, 8)
    var dynsym_off = artifact.bytes_len(data)
    artifact.bytes_extend(data, dynsym)

    bytes_align(data, 8)
    var rela_off = artifact.bytes_len(data)
    artifact.bytes_extend(data, rela)
    return {"hash_off": hash_off, "dynstr_off": dynstr_off, "dynsym_off": dynsym_off, "rela_off": rela_off}
}

fn push_dynamic_entry(dyn, tag, value) {
    artifact.push_u64_le(dyn, tag)
    artifact.push_u64_le(dyn, value)
    return nil
}

fn build_dynamic_table(needed, needed_dynstr_offs, data_addr, table_offsets, dynstr, rela, init_array_off) {
    var dyn = artifact.bytes_new()
    var i_need = 0
    while needed != nil && i_need < oren_list_len(needed) {
        var lib = needed[i_need]
        var off = nil
        if needed_dynstr_offs != nil { off = needed_dynstr_offs[lib] }
        if off == nil { off = 0 }
        push_dynamic_entry(dyn, 1, off) // DT_NEEDED
        i_need = i_need + 1
    }

    var hash_addr = data_addr + table_offsets["hash_off"]
    var dynstr_addr = data_addr + table_offsets["dynstr_off"]
    var dynsym_addr = data_addr + table_offsets["dynsym_off"]
    var rela_addr = data_addr + table_offsets["rela_off"]

    push_dynamic_entry(dyn, 4, hash_addr) // DT_HASH
    push_dynamic_entry(dyn, 5, dynstr_addr) // DT_STRTAB
    push_dynamic_entry(dyn, 6, dynsym_addr) // DT_SYMTAB
    push_dynamic_entry(dyn, 10, artifact.bytes_len(dynstr)) // DT_STRSZ
    push_dynamic_entry(dyn, 11, 24) // DT_SYMENT
    push_dynamic_entry(dyn, 7, rela_addr) // DT_RELA
    push_dynamic_entry(dyn, 8, artifact.bytes_len(rela)) // DT_RELASZ
    push_dynamic_entry(dyn, 9, 24) // DT_RELAENT

    if init_array_off != nil {
        push_dynamic_entry(dyn, 25, data_addr + init_array_off) // DT_INIT_ARRAY
        push_dynamic_entry(dyn, 27, 8) // DT_INIT_ARRAYSZ
    }
    push_dynamic_entry(dyn, 0, 0) // DT_NULL
    return dyn
}
