// Minimal x86_64 native codegen (rolling bring-up).
//
// This is intentionally tiny: it only supports compiling a `fn main() { return <int> }`
// form well enough to produce runnable Linux x86_64 ELF and Windows x64 PE binaries.
//
// Future work (tracked in docs/TODOS.md):
// - full expression + statement lowering parity with arm64 backend
// - native runtime injection on x64 (print, malloc, syscalls, capsule gating)

import core "x64_core.oren"

fn bytes_new() { return core.bytes_new() }
fn bytes_push(b, v) { return core.bytes_push(b, v) }
fn bytes_extend(b, other) { return core.bytes_extend(b, other) }
fn push_u32_le(b, n) { return core.push_u32_le(b, n) }
fn set_u32_le(b, off, n) { return core.set_u32_le(b, off, n) }

fn insn_ret() { return core.insn_ret() }
fn insn_syscall() { return core.insn_syscall() }
fn insn_push_rbp() { return core.insn_push_rbp() }
fn insn_pop_rbp() { return core.insn_pop_rbp() }
fn insn_mov_rbp_rsp() { return core.insn_mov_rbp_rsp() }
fn insn_mov_r64_imm64(reg, imm) { return core.insn_mov_r64_imm64(reg, imm) }
fn insn_mov_r32_imm32(reg, imm) { return core.insn_mov_r32_imm32(reg, imm) }
fn insn_mov_r64_r64(dst, src) { return core.insn_mov_r64_r64(dst, src) }
fn insn_mov_r32_r32(dst, src) { return core.insn_mov_r32_r32(dst, src) }
fn insn_call_rel32(disp32) { return core.insn_call_rel32(disp32) }
fn insn_jmp_rel32(disp32) { return core.insn_jmp_rel32(disp32) }
fn insn_mov_rax_mrip_disp32(disp32) { return core.insn_mov_rax_mrip_disp32(disp32) }
fn insn_lea_rsi_rip_disp32(disp32) { return core.insn_lea_rsi_rip_disp32(disp32) }
fn insn_lea_r64_rip_disp32(reg, disp32) { return core.insn_lea_r64_rip_disp32(reg, disp32) }
fn insn_lea_r64_rsp_disp8(reg, disp8) { return core.insn_lea_r64_rsp_disp8(reg, disp8) }
fn insn_call_rax() { return core.insn_call_rax() }
fn insn_sub_rsp_imm8(n) { return core.insn_sub_rsp_imm8(n) }
fn insn_add_rsp_imm8(n) { return core.insn_add_rsp_imm8(n) }
fn insn_sub_rsp_imm32(n) { return core.insn_sub_rsp_imm32(n) }
fn insn_add_rsp_imm32(n) { return core.insn_add_rsp_imm32(n) }
fn insn_mov_mrsp_disp8_imm32(disp8, imm32) { return core.insn_mov_mrsp_disp8_imm32(disp8, imm32) }
fn insn_and_rsp_imm8(mask_imm8) { return core.insn_and_rsp_imm8(mask_imm8) }
fn insn_mov_mrbp_disp8_imm32(disp8, imm32) { return core.insn_mov_mrbp_disp8_imm32(disp8, imm32) }
fn insn_mov_r32_mrbp_disp8(reg, disp8) { return core.insn_mov_r32_mrbp_disp8(reg, disp8) }
fn insn_mov_mrbp_disp8_r32(disp8, reg) { return core.insn_mov_mrbp_disp8_r32(disp8, reg) }
fn insn_add_r32_imm32(reg, imm32) { return core.insn_add_r32_imm32(reg, imm32) }
fn insn_sub_r32_imm32(reg, imm32) { return core.insn_sub_r32_imm32(reg, imm32) }
fn insn_add_r32_r32(dst, src) { return core.insn_add_r32_r32(dst, src) }
fn insn_sub_r32_r32(dst, src) { return core.insn_sub_r32_r32(dst, src) }
fn insn_cmp_r32_imm32(reg, imm32) { return core.insn_cmp_r32_imm32(reg, imm32) }
fn insn_cmp_r32_r32(lhs, rhs) { return core.insn_cmp_r32_r32(lhs, rhs) }
fn insn_jcc_rel32(cc, disp32) { return core.insn_jcc_rel32(cc, disp32) }
fn insn_imul_r32_imm32(reg, imm32) { return core.insn_imul_r32_imm32(reg, imm32) }

fn err(ctx, msg) {
    if ctx["errors"] == nil { ctx["errors"] = [] }
    oren_list_push(ctx["errors"], msg)
}

fn _int_from_string_dec(s) {
    // Minimal decimal parser (no hex/bin/octal) for v0.
    if s == nil { return nil }
    var i = 0
    var neg = false
    if oren_string_len(s) > 0 && oren_string_char_at(s, 0) == "-" { neg = true; i = 1 }
    var n = 0
    while i < oren_string_len(s) {
        var c = oren_string_char_at(s, i)
        var digit = -1
        if c == "0" { digit = 0 }
        else if c == "1" { digit = 1 }
        else if c == "2" { digit = 2 }
        else if c == "3" { digit = 3 }
        else if c == "4" { digit = 4 }
        else if c == "5" { digit = 5 }
        else if c == "6" { digit = 6 }
        else if c == "7" { digit = 7 }
        else if c == "8" { digit = 8 }
        else if c == "9" { digit = 9 }
        else { return nil }
        n = n * 10 + digit
        i = i + 1
    }
    if neg { return 0 - n }
    return n
}

fn _extract_main_return_i64(ctx, linked) {
    if linked == nil { return nil }
    var stmts = linked["statements"]
    if stmts == nil { err(ctx, "x64 native v0: missing program statements"); return nil }

    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        var s = nil
        if st != nil {
            if st["type"] == "Function" { s = st }
            if st["type"] == "ExprStmt" {
                var e = st["expr"]
                if e != nil && e["type"] == "Function" { s = e }
            }
        }
        if s != nil && s["type"] == "Function" && s["name"] == "main" {
            var body = s["body"]
            if body == nil { err(ctx, "x64 native v0: main has no body"); return nil }
            // Expect: body is a Block with a Return as the last statement.
            if body["type"] == "Block" {
                var bstmts = body["stmts"]
                if bstmts == nil || oren_list_len(bstmts) == 0 { err(ctx, "x64 native v0: main block empty"); return nil }
                var last = bstmts[oren_list_len(bstmts) - 1]
                if last == nil || last["type"] != "Return" { err(ctx, "x64 native v0: main must end with return"); return nil }
                var v = last["value"]
                if v == nil || v["type"] != "Integer" { err(ctx, "x64 native v0: main return must be integer literal"); return nil }
                var n = _int_from_string_dec(v["value"])
                if n == nil { err(ctx, "x64 native v0: invalid integer literal in return"); return nil }
                if n < 0 { err(ctx, "x64 native v0: negative return not supported yet"); return nil }
                return n
            }
            if body["type"] == "Return" {
                var v2 = body["value"]
                if v2 == nil || v2["type"] != "Integer" { err(ctx, "x64 native v0: main return must be integer literal"); return nil }
                var n2 = _int_from_string_dec(v2["value"])
                if n2 == nil { err(ctx, "x64 native v0: invalid integer literal in return"); return nil }
                if n2 < 0 { err(ctx, "x64 native v0: negative return not supported yet"); return nil }
                return n2
            }
            err(ctx, "x64 native v0: unsupported main body shape: " + body["type"])
            return nil
        }
        i = i + 1
    }

    err(ctx, "x64 native v0: missing fn main()")
    return nil
}

fn _data_add_cstr_newline(ctx, s) {
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    var b = oren_bytes_from_string(s)
    // Append newline and NUL for tooling visibility.
    bytes_push(b, 10)
    bytes_push(b, 0)
    // 8B align (helps future u64 reads; harmless for strings).
    while core.int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = oren_list_len(ctx["data"])
    bytes_extend(ctx["data"], b)
    // Return {"off": int, "len": int} where len excludes trailing NUL.
    return {"off": off, "len": oren_list_len(b) - 1}
}

fn _emit_linux_write_cstr(ctx, s) {
    // Emit SYS_write(1, s_ptr, len) where s_ptr is a RIP-relative pointer to appended data.
    var meta = _data_add_cstr_newline(ctx, s)
    if meta == nil { return nil }
    var data_off = meta["off"]
    var nbytes = meta["len"]

    // rax = 1 (SYS_write), rdi = 1 (stdout), rsi = &data, rdx = len
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1)) // eax=1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 1)) // edi=1

    var lea_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_rsi_rip_disp32(0)) // patch disp32
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea_rsi", "pos": lea_pos + 3, "data_off": data_off})

    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, nbytes)) // edx=len
    bytes_extend(ctx["code"], insn_syscall())
    return nil
}

fn _cond_check(ctx, cond) {
    // Supported cond forms (v0):
    // - <id|int> == <id|int>
    // - <id|int> != <id|int>
    // - <id|int> <  <id|int>
    // - <id|int> <= <id|int>
    // - <id|int> >  <id|int>
    // - <id|int> >= <id|int>
    if cond == nil { err(ctx, "x64 native v0: missing if condition"); return nil }
    if cond["type"] != "Infix" { err(ctx, "x64 native v0: if condition must be infix"); return nil }
    var op = cond["op"]
    if op != "==" && op != "!=" && op != "<" && op != "<=" && op != ">" && op != ">=" { err(ctx, "x64 native v0: if op not supported: " + op); return nil }
    var l = cond["left"]
    var r = cond["right"]
    if l == nil || (l["type"] != "Integer" && l["type"] != "Identifier") {
        err(ctx, "x64 native v0: if left must be Integer or Identifier")
        return nil
    }
    if r == nil || (r["type"] != "Integer" && r["type"] != "Identifier") {
        err(ctx, "x64 native v0: if right must be Integer or Identifier")
        return nil
    }
    if l["type"] == "Integer" { _expr_i32_check(ctx, l) }
    if r["type"] == "Integer" { _expr_i32_check(ctx, r) }
    return nil
}

fn _cond_false_cc(cond_op) {
    // Return the Jcc condition code for "cond is false", given `cond_op`.
    if cond_op == "==" { return "ne" }
    if cond_op == "!=" { return "e" }
    if cond_op == "<" { return "ge" }
    if cond_op == "<=" { return "g" }
    if cond_op == ">" { return "le" }
    if cond_op == ">=" { return "l" }
    return nil
}

fn _analyze_stmt_list_to_ops(ctx, stmts) {
    var ops = []
    if stmts == nil { return ops }
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st == nil { i = i + 1; continue }
        var t = st["type"]
        if t == "Var" {
            var name_node = st["name"]
            var v0 = st["value"]
            if name_node == nil || name_node["type"] != "Identifier" { err(ctx, "x64 native v0: var name must be identifier"); return nil }
            if v0 == nil { err(ctx, "x64 native v0: var init missing"); return nil }
            oren_list_push(ops, {"op": "var_i32", "name": name_node["value"], "expr": v0})
            i = i + 1
            continue
        }
        if t == "ExprStmt" {
            var e = st["expr"]
            if e == nil { i = i + 1; continue }
            if e["type"] == "Call" {
                var callee = e["fn"]
                var args = e["args"]
                if callee != nil && callee["type"] == "Identifier" && callee["value"] == "print" {
                    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: print expects 1 arg"); return nil }
                    var a0 = args[0]
                    if a0 == nil || a0["type"] != "String" { err(ctx, "x64 native v0: print only supports string literal"); return nil }
                    oren_list_push(ops, {"op": "print_cstr", "value": a0["value"]})
                    i = i + 1
                    continue
                }
            }
            err(ctx, "x64 native v0: unsupported expr statement")
            return nil
        }
        if t == "Assign" {
            var name_node2 = st["name"]
            var v2 = st["value"]
            if name_node2 == nil || name_node2["type"] != "Identifier" { err(ctx, "x64 native v0: assign name must be identifier"); return nil }
            if v2 == nil { err(ctx, "x64 native v0: assign missing value"); return nil }
            oren_list_push(ops, {"op": "assign_i32", "name": name_node2["value"], "expr": v2})
            i = i + 1
            continue
        }
        if t == "Return" {
            var v = st["value"]
            if v == nil { err(ctx, "x64 native v0: return missing value"); return nil }
            oren_list_push(ops, {"op": "return", "expr": v})
            i = i + 1
            continue
        }
        if t == "If" {
            _cond_check(ctx, st["cond"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            var then_block = st["consq"]
            var else_node = st["alt"]
            if then_block == nil || then_block["type"] != "Block" { err(ctx, "x64 native v0: if then must be Block"); return nil }
            var then_ops = _analyze_stmt_list_to_ops(ctx, then_block["stmts"])
            if then_ops == nil { return nil }
            var else_ops = []
            if else_node != nil {
                if else_node["type"] == "Block" {
                    else_ops = _analyze_stmt_list_to_ops(ctx, else_node["stmts"])
                    if else_ops == nil { return nil }
                } else if else_node["type"] == "If" {
                    // else-if chain: represent as else { if ... }
                    var tmp = _analyze_stmt_list_to_ops(ctx, [else_node])
                    if tmp == nil { return nil }
                    else_ops = tmp
                } else {
                    err(ctx, "x64 native v0: unsupported else node: " + else_node["type"])
                    return nil
                }
            }
            oren_list_push(ops, {"op": "if", "cond": st["cond"], "then": then_ops, "else": else_ops})
            i = i + 1
            continue
        }
        if t == "While" {
            _cond_check(ctx, st["cond"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            var body = st["body"]
            if body == nil || body["type"] != "Block" { err(ctx, "x64 native v0: while body must be Block"); return nil }
            var body_ops = _analyze_stmt_list_to_ops(ctx, body["stmts"])
            if body_ops == nil { return nil }
            oren_list_push(ops, {"op": "while", "cond": st["cond"], "body": body_ops})
            i = i + 1
            continue
        }
        if t == "For" {
            // Support a tiny subset:
            // - `for <cond> { ... }` (cond-only form)
            // - `for var i = 0; <cond>; i = i + 1 { ... }` (3-clause form)
            var init = st["init"]
            var cond = st["cond"]
            var post = st["post"]
            var body3 = st["body"]
            if body3 == nil || body3["type"] != "Block" { err(ctx, "x64 native v0: for body must be Block"); return nil }
            if cond == nil { err(ctx, "x64 native v0: for missing cond"); return nil }
            _cond_check(ctx, cond)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            // Cond-only form => lower to while.
            if init == nil && post == nil {
                var bops = _analyze_stmt_list_to_ops(ctx, body3["stmts"])
                if bops == nil { return nil }
                oren_list_push(ops, {"op": "while", "cond": cond, "body": bops})
                i = i + 1
                continue
            }

            // 3-clause form: init and post must be present.
            if init == nil || post == nil {
                err(ctx, "x64 native v0: for init/post required in 3-clause form")
                return nil
            }
            var init_ops = _analyze_stmt_list_to_ops(ctx, [init])
            if init_ops == nil { return nil }
            var post_ops = _analyze_stmt_list_to_ops(ctx, [post])
            if post_ops == nil { return nil }
            var body_ops2 = _analyze_stmt_list_to_ops(ctx, body3["stmts"])
            if body_ops2 == nil { return nil }

            // Restrict post to a single assignment for now (prevents weird continue behavior).
            if oren_list_len(post_ops) != 1 || post_ops[0]["op"] != "assign_i32" {
                err(ctx, "x64 native v0: for post must be assignment")
                return nil
            }
            oren_list_push(ops, {"op": "for", "init": init_ops, "cond": cond, "post": post_ops, "body": body_ops2})
            i = i + 1
            continue
        }
        if t == "Break" {
            oren_list_push(ops, {"op": "break"})
            i = i + 1
            continue
        }
        if t == "Continue" {
            oren_list_push(ops, {"op": "continue"})
            i = i + 1
            continue
        }
        err(ctx, "x64 native v0: unsupported stmt: " + t)
        return nil
    }
    return ops
}

fn _analyze_supported_fn_body(ctx, fn_node) {
    var body = fn_node["body"]
    if body == nil { err(ctx, "x64 native v0: function has no body"); return nil }
    if body["type"] != "Block" {
        err(ctx, "x64 native v0: function body must be Block")
        return nil
    }
    var ops = _analyze_stmt_list_to_ops(ctx, body["stmts"])
    if ops == nil { return nil }

    // If last statement is not a return, add an implicit `return 0` to keep the ABI sane.
    if oren_list_len(ops) == 0 || ops[oren_list_len(ops) - 1]["op"] != "return" {
        oren_list_push(ops, {"op": "return", "expr": {"type": "Integer", "value": "0"}})
    }
    return ops
}

fn _expr_i32_check(ctx, expr) {
    if expr == nil { err(ctx, "x64 native v0: missing expr"); return nil }
    var t = expr["type"]
    if t == "Integer" {
        var n = _int_from_string_dec(expr["value"])
        if n == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
        if n < 0 { err(ctx, "x64 native v0: negative ints not supported yet"); return nil }
        if n > 4294967295 { err(ctx, "x64 native v0: int too large for i32"); return nil }
        return nil
    }
    if t == "Identifier" { return nil }
    if t == "Call" {
        var fn_expr = expr["fn"]
        var args = expr["args"]
        if fn_expr == nil || fn_expr["type"] != "Identifier" { err(ctx, "x64 native v0: call target must be identifier"); return nil }
        if args != nil && oren_list_len(args) != 0 { err(ctx, "x64 native v0: calls do not support args yet"); return nil }
        var nm = fn_expr["value"]
        if nm == "print" { err(ctx, "x64 native v0: print is statement-only"); return nil }
        var declared = ctx["declared_functions"]
        if declared != nil && declared[nm] == nil { err(ctx, "x64 native v0: undefined function " + nm); return nil }
        return nil
    }
    if t == "Infix" {
        var op = expr["op"]
        if op != "+" && op != "-" && op != "*" { err(ctx, "x64 native v0: infix op not supported: " + op); return nil }
        var l = expr["left"]
        var r = expr["right"]
        if l == nil || (l["type"] != "Integer" && l["type"] != "Identifier" && l["type"] != "Call") {
            err(ctx, "x64 native v0: infix left must be Integer, Identifier, or Call")
            return nil
        }
        if r == nil || (r["type"] != "Integer" && r["type"] != "Identifier" && r["type"] != "Call") {
            err(ctx, "x64 native v0: infix right must be Integer, Identifier, or Call")
            return nil
        }
        if op == "*" && r["type"] != "Integer" { err(ctx, "x64 native v0: mul rhs must be integer literal"); return nil }
        _expr_i32_check(ctx, l)
        _expr_i32_check(ctx, r)
        return nil
    }
    err(ctx, "x64 native v0: expr not supported: " + t)
    return nil
}

fn _emit_eval_i32_to_eax(ctx, expr, locals) {
    // Evaluate a tiny int expression into EAX.
    // Supports:
    // - Integer
    // - Identifier
    // - Infix (+/-) with subexpressions from the above set
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Integer" {
        var n = _int_from_string_dec(expr["value"])
        if n == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, n))
        return nil
    }
    if t == "Identifier" {
        var off = locals[expr["value"]]
        if off == nil { err(ctx, "x64 native v0: unknown var " + expr["value"]); return nil }
        var disp8 = core.int_mod(0 - off, 256)
        bytes_extend(ctx["code"], insn_mov_r32_mrbp_disp8(0, disp8))
        return nil
    }
    if t == "Call" {
        var fn_expr = expr["fn"]
        var args = expr["args"]
        if fn_expr == nil || fn_expr["type"] != "Identifier" { err(ctx, "x64 native v0: call target must be identifier"); return nil }
        if args != nil && oren_list_len(args) != 0 { err(ctx, "x64 native v0: calls do not support args yet"); return nil }
        var nm = fn_expr["value"]
        if nm == "print" { err(ctx, "x64 native v0: print is statement-only"); return nil }
        var declared = ctx["declared_functions"]
        if declared != nil && declared[nm] == nil { err(ctx, "x64 native v0: undefined function " + nm); return nil }
        var call_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": nm})
        return nil
    }
    if t == "Infix" {
        var op = expr["op"]
        var l = expr["left"]
        var r = expr["right"]
        _emit_eval_i32_to_eax(ctx, l, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        if r != nil && r["type"] == "Integer" {
            var n2 = _int_from_string_dec(r["value"])
            if n2 == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
            if op == "+" { bytes_extend(ctx["code"], insn_add_r32_imm32(0, n2)) }
            else if op == "-" { bytes_extend(ctx["code"], insn_sub_r32_imm32(0, n2)) }
            else { bytes_extend(ctx["code"], insn_imul_r32_imm32(0, n2)) }
            return nil
        }
        if r != nil && r["type"] == "Identifier" {
            var off2 = locals[r["value"]]
            if off2 == nil { err(ctx, "x64 native v0: unknown var " + r["value"]); return nil }
            var disp82 = core.int_mod(0 - off2, 256)
            bytes_extend(ctx["code"], insn_mov_r32_mrbp_disp8(2, disp82)) // edx = rhs
            if op == "+" { bytes_extend(ctx["code"], insn_add_r32_r32(0, 2)) }
            else if op == "-" { bytes_extend(ctx["code"], insn_sub_r32_r32(0, 2)) }
            else { err(ctx, "x64 native v0: mul rhs must be integer literal"); return nil }
            return nil
        }
        if r != nil && r["type"] == "Call" {
            var tmp_off = locals["$tmp0"]
            if tmp_off == nil { err(ctx, "x64 native v0: missing temp slot for calls"); return nil }
            var tmp_disp8 = core.int_mod(0 - tmp_off, 256)
            // Spill left to stack temp, evaluate RHS call into EAX, then combine.
            bytes_extend(ctx["code"], insn_mov_mrbp_disp8_r32(tmp_disp8, 0)) // [tmp] = eax
            _emit_eval_i32_to_eax(ctx, r, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_mov_r32_r32(2, 0)) // edx = rhs (eax)
            bytes_extend(ctx["code"], insn_mov_r32_mrbp_disp8(0, tmp_disp8)) // eax = lhs
            if op == "+" { bytes_extend(ctx["code"], insn_add_r32_r32(0, 2)) }
            else if op == "-" { bytes_extend(ctx["code"], insn_sub_r32_r32(0, 2)) }
            else { err(ctx, "x64 native v0: mul rhs must be integer literal"); return nil }
            return nil
        }
    }
    err(ctx, "x64 native v0: expr not supported")
    return nil
}

fn _emit_cmp_from_cond(ctx, cond, locals) {
    // Emits a compare that sets flags according to `cond`.
    // Uses EAX for left; EDX as scratch for right when needed.
    var l = cond["left"]
    var r = cond["right"]
    _emit_eval_i32_to_eax(ctx, l, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if r["type"] == "Integer" {
        var n = _int_from_string_dec(r["value"])
        if n == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
        bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, n))
        return nil
    }
    if r["type"] == "Identifier" {
        var off = locals[r["value"]]
        if off == nil { err(ctx, "x64 native v0: unknown var " + r["value"]); return nil }
        var disp8 = core.int_mod(0 - off, 256)
        bytes_extend(ctx["code"], insn_mov_r32_mrbp_disp8(2, disp8)) // edx = rhs
        bytes_extend(ctx["code"], insn_cmp_r32_r32(0, 2)) // cmp eax, edx
        return nil
    }
    err(ctx, "x64 native v0: if rhs not supported")
    return nil
}

fn _new_label(ctx, prefix) {
    if ctx["label_seq"] == nil { ctx["label_seq"] = 0 }
    ctx["label_seq"] = ctx["label_seq"] + 1
    return prefix + "_" + oren_int_to_string(ctx["label_seq"])
}

fn _emit_label(ctx, labels, name) {
    labels[name] = oren_list_len(ctx["code"])
}

fn _emit_jmp_to_label(ctx, local_fixups, name) {
    var pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_jmp_rel32(0))
    oren_list_push(local_fixups, {"disp_pos": pos + 1, "insn_start": pos, "insn_len": 5, "label": name})
}

fn _emit_jcc_to_label(ctx, local_fixups, cc, name) {
    var pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_jcc_rel32(cc, 0))
    oren_list_push(local_fixups, {"disp_pos": pos + 2, "insn_start": pos, "insn_len": 6, "label": name})
}

fn _patch_local_fixups(ctx, labels, local_fixups) {
    var i = 0
    while i < oren_list_len(local_fixups) {
        var f = local_fixups[i]
        var label = f["label"]
        var target = labels[label]
        if target == nil {
            err(ctx, "x64 native v0: unknown label " + label)
            return nil
        }
        var insn_start = f["insn_start"]
        var insn_len = f["insn_len"]
        var next_rip = insn_start + insn_len
        var disp = target - next_rip
        if disp < 0 { disp = 4294967296 + disp }
        set_u32_le(ctx["code"], f["disp_pos"], disp)
        i = i + 1
    }
    return nil
}

fn _collect_locals_from_ops(ctx, ops, locals, local_next) {
    var i = 0
    while ops != nil && i < oren_list_len(ops) {
        var op = ops[i]
        if op != nil {
            if op["op"] == "var_i32" {
                var nm = op["name"]
                if locals[nm] != nil { err(ctx, "x64 native v0: duplicate var " + nm); return nil }
                locals[nm] = local_next
                local_next = local_next + 8
            } else if op["op"] == "if" {
                local_next = _collect_locals_from_ops(ctx, op["then"], locals, local_next)
                if local_next == nil { return nil }
                local_next = _collect_locals_from_ops(ctx, op["else"], locals, local_next)
                if local_next == nil { return nil }
            } else if op["op"] == "while" {
                local_next = _collect_locals_from_ops(ctx, op["body"], locals, local_next)
                if local_next == nil { return nil }
            } else if op["op"] == "for" {
                local_next = _collect_locals_from_ops(ctx, op["init"], locals, local_next)
                if local_next == nil { return nil }
                local_next = _collect_locals_from_ops(ctx, op["post"], locals, local_next)
                if local_next == nil { return nil }
                local_next = _collect_locals_from_ops(ctx, op["body"], locals, local_next)
                if local_next == nil { return nil }
            }
        }
        i = i + 1
    }
    return local_next
}

fn _emit_ops_in_fn(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label) {
    var j = 0
    while ops != nil && j < oren_list_len(ops) {
        var op = ops[j]
        if op == nil { j = j + 1; continue }
        if op["op"] == "var_i32" {
            var off = locals[op["name"]]
            if off == nil { err(ctx, "x64 native v0: missing local slot"); return nil }
            var disp8 = core.int_mod(0 - off, 256)
            _expr_i32_check(ctx, op["expr"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_eval_i32_to_eax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_mov_mrbp_disp8_r32(disp8, 0))
        } else if op["op"] == "assign_i32" {
            var off2 = locals[op["name"]]
            if off2 == nil { err(ctx, "x64 native v0: assign unknown var " + op["name"]); return nil }
            var disp82 = core.int_mod(0 - off2, 256)
            _expr_i32_check(ctx, op["expr"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_eval_i32_to_eax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_mov_mrbp_disp8_r32(disp82, 0))
        } else if op["op"] == "print_cstr" {
            if platform != nil && platform["os"] == "linux" {
                _emit_linux_write_cstr(ctx, op["value"])
            } else if platform != nil && platform["os"] == "windows" {
                _emit_windows_write_cstr(ctx, op["value"])
            } else {
                err(ctx, "x64 native v0: print unsupported on this target")
                return nil
            }
        } else if op["op"] == "return" {
            _expr_i32_check(ctx, op["expr"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_eval_i32_to_eax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_jmp_to_label(ctx, local_fixups, epilogue_label)
        } else if op["op"] == "if" {
            var cond = op["cond"]
            var else_label = _new_label(ctx, "if_else")
            var end_label = _new_label(ctx, "if_end")
            _emit_cmp_from_cond(ctx, cond, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            // Jump to else if condition is false.
            var false_cc = _cond_false_cc(cond["op"])
            if false_cc == nil { err(ctx, "x64 native v0: unsupported if op"); return nil }
            _emit_jcc_to_label(ctx, local_fixups, false_cc, else_label)

            _emit_ops_in_fn(ctx, op["then"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_jmp_to_label(ctx, local_fixups, end_label)
            _emit_label(ctx, labels, else_label)
            _emit_ops_in_fn(ctx, op["else"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_label(ctx, labels, end_label)
        } else if op["op"] == "while" {
            var cond_label = _new_label(ctx, "while_cond")
            var body_label = _new_label(ctx, "while_body")
            var end_label2 = _new_label(ctx, "while_end")

            _emit_label(ctx, labels, cond_label)
            _emit_cmp_from_cond(ctx, op["cond"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            var w_false = _cond_false_cc(op["cond"]["op"])
            if w_false == nil { err(ctx, "x64 native v0: unsupported while op"); return nil }
            _emit_jcc_to_label(ctx, local_fixups, w_false, end_label2)

            _emit_label(ctx, labels, body_label)
            _emit_ops_in_fn(ctx, op["body"], locals, labels, local_fixups, epilogue_label, platform, cond_label, end_label2)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_jmp_to_label(ctx, local_fixups, cond_label)
            _emit_label(ctx, labels, end_label2)
        } else if op["op"] == "for" {
            // for init; cond; post { body }
            //
            // Semantics:
            // - init runs once
            // - cond checked before each iteration
            // - continue jumps to post (then cond)
            // - break exits the loop
            var cond_label2 = _new_label(ctx, "for_cond")
            var body_label2 = _new_label(ctx, "for_body")
            var post_label2 = _new_label(ctx, "for_post")
            var end_label3 = _new_label(ctx, "for_end")

            _emit_ops_in_fn(ctx, op["init"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_label(ctx, labels, cond_label2)
            _emit_cmp_from_cond(ctx, op["cond"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            var f_false = _cond_false_cc(op["cond"]["op"])
            if f_false == nil { err(ctx, "x64 native v0: unsupported for op"); return nil }
            _emit_jcc_to_label(ctx, local_fixups, f_false, end_label3)

            _emit_label(ctx, labels, body_label2)
            _emit_ops_in_fn(ctx, op["body"], locals, labels, local_fixups, epilogue_label, platform, post_label2, end_label3)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_label(ctx, labels, post_label2)
            // Post must not use break/continue (enforced by analyzer); pass nil to be strict.
            _emit_ops_in_fn(ctx, op["post"], locals, labels, local_fixups, epilogue_label, platform, nil, nil)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_jmp_to_label(ctx, local_fixups, cond_label2)
            _emit_label(ctx, labels, end_label3)
        } else if op["op"] == "break" {
            if loop_end_label == nil { err(ctx, "x64 native v0: break outside loop"); return nil }
            _emit_jmp_to_label(ctx, local_fixups, loop_end_label)
        } else if op["op"] == "continue" {
            if loop_cond_label == nil { err(ctx, "x64 native v0: continue outside loop"); return nil }
            _emit_jmp_to_label(ctx, local_fixups, loop_cond_label)
        } else {
            err(ctx, "x64 native v0: unknown op in main")
            return nil
        }
        j = j + 1
    }
    return nil
}

fn _emit_windows_write_cstr(ctx, s) {
    // Emit:
    //   h = GetStdHandle(-11)
    //   WriteFile(h, s_ptr, len, &written, NULL)
    //
    // Uses Win64 ABI (RCX, RDX, R8, R9, shadow space).

    var meta = _data_add_cstr_newline(ctx, s)
    if meta == nil { return nil }
    var data_off = meta["off"]
    var nbytes = meta["len"]

    // --- GetStdHandle(STD_OUTPUT_HANDLE=-11) ---
    // ecx = 0xFFFFFFF5
    bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 4294967285))
    var mov_iat0 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat0 + 3, "data_label": "IAT_GetStdHandle"})
    bytes_extend(ctx["code"], insn_call_rax())

    // rcx = rax (hStdout)
    bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0))

    // rdx = &data (RIP-relative into .rdata appended blob)
    var lea_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(2, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_rdata_lea", "pos": lea_pos + 3, "data_off": data_off})

    // r8d = len
    bytes_extend(ctx["code"], insn_mov_r32_imm32(8, nbytes))

    // Stack arg5 (lpOverlapped) = NULL at [rsp+0x20], and bytesWritten at [rsp+0x28].
    //
    // Write 8 bytes of zeros for lpOverlapped (two dwords).
    bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(32, 0))
    bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(36, 0))
    // r9 = &written
    bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(9, 40))

    // --- WriteFile(...) ---
    var mov_iat1 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat1 + 3, "data_label": "IAT_WriteFile"})
    bytes_extend(ctx["code"], insn_call_rax())
    return nil
}

fn _extract_functions_v0(ctx, linked) {
    var stmts = nil
    if linked != nil { stmts = linked["statements"] }
    if stmts == nil { err(ctx, "x64 native v0: missing program statements"); return nil }

    var out = []
    var declared = {}
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        var fn0 = nil
        if st != nil {
            if st["type"] == "Function" { fn0 = st }
            if st["type"] == "ExprStmt" {
                var e0 = st["expr"]
                if e0 != nil && e0["type"] == "Function" { fn0 = e0 }
            }
        }
        if fn0 != nil {
            var name = fn0["name"]
            if name == nil { err(ctx, "x64 native v0: function missing name"); return nil }
            if declared[name] != nil { err(ctx, "x64 native v0: duplicate function " + name); return nil }
            declared[name] = 1
            var params = fn0["params"]
            if params != nil && oren_list_len(params) != 0 { err(ctx, "x64 native v0: functions do not support params yet: " + name); return nil }
            oren_list_push(out, fn0)
        }
        i = i + 1
    }
    ctx["declared_functions"] = declared
    return out
}

fn _compile_function_v0(ctx, fn_node, platform) {
    if fn_node == nil { return nil }
    var name = fn_node["name"]
    if name == nil { err(ctx, "x64 native v0: function missing name"); return nil }

    var ops = _analyze_supported_fn_body(ctx, fn_node)
    if ops == nil { return nil }

    var fn_off = oren_list_len(ctx["code"])
    ctx["functions"][name] = fn_off

    bytes_extend(ctx["code"], insn_push_rbp())
    bytes_extend(ctx["code"], insn_mov_rbp_rsp())

    // Allocate locals + (Windows) call shadow/args area.
    //
    // Locals are addressed via RBP-negative offsets in 8-byte steps.
    var locals = {}
    var local_next = _collect_locals_from_ops(ctx, ops, locals, 8)
    if local_next == nil { return nil }

    // Reserve a spill slot so expression lowering can safely handle calls on RHS without
    // perturbing RSP (keeps ABI alignment intact for nested calls).
    if locals["$tmp0"] != nil { err(ctx, "x64 native v0: reserved local name $tmp0 used"); return nil }
    locals["$tmp0"] = local_next
    local_next = local_next + 8

    var locals_size = local_next - 8
    // Align locals area to 16.
    while core.int_mod(locals_size, 16) != 0 { locals_size = locals_size + 1 }
    var win_call_area = 0
    if platform != nil && platform["os"] == "windows" { win_call_area = 64 }
    var frame_size = locals_size + win_call_area
    if frame_size > 0 { bytes_extend(ctx["code"], insn_sub_rsp_imm32(frame_size)) }

    var labels = {}
    var local_fixups = []
    var epilogue_label = _new_label(ctx, name + "_epilogue")
    _emit_ops_in_fn(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    _emit_label(ctx, labels, epilogue_label)
    if frame_size > 0 { bytes_extend(ctx["code"], insn_add_rsp_imm32(frame_size)) }
    bytes_extend(ctx["code"], insn_pop_rbp())
    bytes_extend(ctx["code"], insn_ret())

    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

// Compile minimal x64 program.
//
// Returns a ctx:
// - code: []byte
// - data: []byte (used by PE import table)
// - fixups: list of fixups for emitters (call_main, rip_data32)
// - functions: map name->offset
// - import_list: list of imports (for PE)
// - errors: list of strings
fn native_compile_program_x64_min(linked, platform) {
    var ctx = {
        "code": bytes_new(),
        "data": bytes_new(),
        "fixups": [],
        "functions": {},
        "import_list": [],
        "errors": [],
        "platform": platform
    }

    var fns = _extract_functions_v0(ctx, linked)
    if fns == nil { return ctx }
    if ctx["declared_functions"]["main"] == nil { err(ctx, "x64 native v0: missing fn main()"); return ctx }

    // --- Entry stub ---
    //
    // Align stack to 16B boundary early so both SysV and Win64 calls stay well-formed as we grow
    // the x64 backend surface. This is safe because we do not use argv/envp here and never return.
    bytes_extend(ctx["code"], insn_and_rsp_imm8(240)) // 0xF0 == -16

    // call main
    //
    // Windows x64 ABI note: calls require 32 bytes of shadow space allocated by the caller.
    // Since our entrypoint is not a C runtime, we explicitly reserve it here.
    if platform != nil && platform["os"] == "windows" {
        bytes_extend(ctx["code"], insn_sub_rsp_imm32(32))
    }
    var call_pos = oren_list_len(ctx["code"])
    // placeholder rel32=0
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "main"})

    if platform != nil && platform["os"] == "windows" {
        // Windows x64: ExitProcess(ret)
        //
        // - rcx = u32 exit code
        // - call [IAT ExitProcess]
        bytes_extend(ctx["code"], insn_mov_r32_r32(1, 0)) // mov ecx, eax

        var mov_iat_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0)) // patch disp32 to IAT slot
        oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat_pos + 3, "data_label": "IAT_ExitProcess"})
        bytes_extend(ctx["code"], insn_call_rax())
        // Should not return; if it does, just ret.
        bytes_extend(ctx["code"], insn_add_rsp_imm32(32))
        bytes_extend(ctx["code"], insn_ret())
        // Record entrypoint offset (start of code).
        ctx["entry_off"] = 0
    } else {
        // Linux x86_64: exit(main_ret) via syscall
        // rdi = rax
        bytes_extend(ctx["code"], insn_mov_r64_r64(7, 0)) // mov rdi, rax
        // rax = 60 (SYS_exit)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 60))
        bytes_extend(ctx["code"], insn_syscall())
        // Should not return; if it does, ret.
        bytes_extend(ctx["code"], insn_ret())
        ctx["entry_off"] = 0
    }

    // --- functions ---
    var i1 = 0
    while i1 < oren_list_len(fns) {
        _compile_function_v0(ctx, fns[i1], platform)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
        i1 = i1 + 1
    }

    return ctx
}

fn native_emit_errors_and_exit(ctx) {
    if ctx == nil { return nil }
    var errs = ctx["errors"]
    if errs == nil || oren_list_len(errs) == 0 { return nil }
    var i = 0
    while i < oren_list_len(errs) {
        var e = errs[i]
        if e != nil { print(e) }
        i = i + 1
    }
    oren_exit(1)
    return nil
}
