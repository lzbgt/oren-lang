import core "parser_core.oren"
import parse "parser_parse.oren"

// Public parser surface (stable during rolling):
// - new_parser(lexer)
// - parse_program(parser)
//
// `parser_core.oren` hosts shared parser state + helpers.
// `parser_parse.oren` hosts the actual parse logic (large; refactored to keep file sizes SOLID).

fn new_parser(l) { return core.new_parser(l) }
fn parse_program(p) { return parse.parse_program(p) }

