fn _macho_decode_rtobj_fix_int(enc) {
    if oren_type_tag(enc) == 0 { return nil }
    return enc - 1
}

fn _macho_decode_rtobj_fix_reg(enc) {
    if oren_type_tag(enc) != 1 { return nil }
    if enc <= 0 { return nil }
    return enc - 1
}

fn _macho_lookup_function(ctx, functions, name) {
    if name == nil { return nil }
    if functions != nil {
        var off = functions[name]
        if off != nil { return off }
    }
    var rt = ctx["runtime_functions_enc"]
    if rt == nil { return nil }
    var off_enc = rt[name]
    if off_enc == nil { return nil }
    var base = ctx["rtobj_functions_base_code"]
    if base == nil { base = 0 }
    return base + _macho_decode_rtobj_fix_int(off_enc)
}

fn _macho_lookup_function_cached(cache, ctx, functions, name) {
    if name == nil { return nil }
    if cache != nil {
        var off_enc = cache[name]
        if oren_type_tag(off_enc) != 0 { return off_enc - 1 }
    }
    var off = _macho_lookup_function(ctx, functions, name)
    if cache != nil && oren_type_tag(off) != 0 { cache[name] = off + 1 }
    return off
}

fn _macho_lookup_runtime_offset(rt, base, name) {
    if rt == nil || name == nil { return nil }
    var off_enc = rt[name]
    if off_enc == nil { return nil }
    if base == nil { base = 0 }
    return base + _macho_decode_rtobj_fix_int(off_enc)
}

// Selected hot local calls store these negative ids in the compact BL name lane.
// The legacy fixup map keeps string names; only the Mach-O compact path consumes ids.
fn _macho_hot_bl_id_name(id) {
    if id == -1 { return "oren_panic" }
    if id == -2 { return "oren_ensure_tracked" }
    if id == -3 { return "oren_call_depth_enter" }
    if id == -4 { return "oren_call_depth_exit" }
    if id == -5 { return "native_list_len_panic" }
    if id == -6 { return "oren_find_node" }
    if id == -7 { return "oren_is_err" }
    if id == -8 { return "oren_map_get_str" }
    if id == -9 { return "oren_new_list" }
    if id == -10 { return "oren_list_get" }
    if id == -11 { return "oren_list_push_unchecked" }
    if id == -12 { return "_list_find_node_known_kind" }
    if id == -13 { return "oren_func" }
    if id == -14 { return "oren_list_push" }
    if id == -15 { return "oren_add" }
    if id == -16 { return "oren_map_get_int" }
    if id == -17 { return "STD_generator_next" }
    if id == -18 { return "STD_generator_start" }
    if id == -19 { return "strcmp" }
    if id == -20 { return "STD_generator_send" }
    if id == -21 { return "STD_generator_is_done" }
    if id == -22 { return "oren_map_set_str" }
    if id == -23 { return "oren_type_name" }
    if id == -24 { return "STD_generator_cancel_reason" }
    if id == -25 { return "_oren_generator_context_exchange" }
    if id == -26 { return "STD_generator_is_cancel_requested" }
    return nil
}

fn _macho_str_eq_bytes_known_len(a, b, len) {
    var i = 0
    while i < len {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _macho_lookup_stats_add(stats, scan_steps, meta_candidates, byte_compares, appended, missed, insert_shifts) {
    if stats == nil { return nil }
    stats[0] = stats[0] + 1
    stats[1] = stats[1] + scan_steps
    stats[2] = stats[2] + meta_candidates
    stats[3] = stats[3] + byte_compares
    stats[4] = stats[4] + appended
    stats[5] = stats[5] + missed
    stats[6] = stats[6] + insert_shifts
    return nil
}

fn _macho_lookup_stats_detail(stats, unique_n) {
    if stats == nil { return "" }
    return " unique=" + oren_int_to_string(unique_n) +
        " lookups=" + oren_int_to_string(stats[0]) +
        " scan_steps=" + oren_int_to_string(stats[1]) +
        " candidates=" + oren_int_to_string(stats[2]) +
        " byte_cmps=" + oren_int_to_string(stats[3]) +
        " appended=" + oren_int_to_string(stats[4]) +
        " misses=" + oren_int_to_string(stats[5]) +
        " insert_shifts=" + oren_int_to_string(stats[6])
}

fn _macho_target_meta_key(name_len, name_first, name_last) {
    if name_len <= 0 { return -1 }
    return name_len * 65536 + name_first * 256 + name_last
}

fn _macho_target_buckets_new() {
    var buckets = oren_list_new_cap(256)
    if oren_is_err(buckets) { buckets = [] }
    var i = 0
    while i < 256 {
        oren_list_push(buckets, [])
        i = i + 1
    }
    return buckets
}

fn _macho_lookup_function_linear(names, offs, meta_keys, buckets, counts, ctx, functions, name, stats) {
    if name == nil {
        _macho_lookup_stats_add(stats, 0, 0, 0, 0, 1, 0)
        return nil
    }
    var name_len = oren_string_len(name)
    var name_first = 0
    if name_len > 0 { name_first = oren_string_byte_at_unchecked(name, 0) & 255 }
    var name_last = -1
    if name_len > 0 { name_last = oren_string_byte_at_unchecked(name, name_len - 1) & 255 }
    var name_key = _macho_target_meta_key(name_len, name_first, name_last)
    var names_n = oren_list_len(names)
    var scan_steps = 0
    var meta_candidates = 0
    var byte_compares = 0
    var bucket = nil
    if buckets != nil && name_first >= 0 && name_first < oren_list_len(buckets) { bucket = buckets[name_first] }
    if bucket != nil {
        var bucket_len = oren_list_len(bucket)
        var bi = 0
        while bi < bucket_len {
            var i = bucket[bi]
            scan_steps = scan_steps + 1
            if meta_keys[i] == name_key {
                meta_candidates = meta_candidates + 1
                byte_compares = byte_compares + 1
                if _macho_str_eq_bytes_known_len(names[i], name, name_len) == true {
                    if counts != nil { counts[i] = counts[i] + 1 }
                    _macho_lookup_stats_add(stats, scan_steps, meta_candidates, byte_compares, 0, 0, 0)
                    return offs[i]
                }
            }
            bi = bi + 1
        }
    } else {
        var i = 0
        while i < names_n {
            scan_steps = scan_steps + 1
            if meta_keys[i] == name_key {
                meta_candidates = meta_candidates + 1
                byte_compares = byte_compares + 1
                if _macho_str_eq_bytes_known_len(names[i], name, name_len) == true {
                    if counts != nil { counts[i] = counts[i] + 1 }
                    _macho_lookup_stats_add(stats, scan_steps, meta_candidates, byte_compares, 0, 0, 0)
                    return offs[i]
                }
            }
            i = i + 1
        }
    }
    var off = _macho_lookup_function(ctx, functions, name)
    var appended = 0
    var missed = 0
    var insert_shifts = 0
    if off != nil {
        oren_list_push(names, name)
        oren_list_push(offs, off)
        oren_list_push(meta_keys, name_key)
        if bucket != nil { oren_list_push(bucket, names_n) }
        if counts != nil { oren_list_push(counts, 1) }
        appended = 1
    } else {
        missed = 1
    }
    _macho_lookup_stats_add(stats, scan_steps, meta_candidates, byte_compares, appended, missed, insert_shifts)
    return off
}

fn _macho_lookup_top_counts_detail(names, counts, prefix) {
    if names == nil || counts == nil { return "" }
    var used = []
    var out = ""
    var rank = 1
    var names_n = oren_list_len(names)
    while rank <= 5 {
        var best_i = -1
        var best_count = 0
        var used_len_rank = oren_list_len(used)
        var i = 0
        while i < names_n {
            var already = false
            var u = 0
            while u < used_len_rank {
                if used[u] == i { already = true; break }
                u = u + 1
            }
            if already != true {
                var c = counts[i]
                if c > best_count {
                    best_count = c
                    best_i = i
                }
            }
            i = i + 1
        }
        if best_i < 0 || best_count <= 0 { break }
        oren_list_push(used, best_i)
        out = out + " " + prefix + oren_int_to_string(rank) + "=" + names[best_i] +
            " " + prefix + oren_int_to_string(rank) + "_count=" + oren_int_to_string(best_count)
        rank = rank + 1
    }
    return out
}
