// Rolling ABI hygiene:
// - The native backend reserves X28 (heap_ptr) and X27 (heap_limit) as "global heap registers".
// - Kernels may clobber registers across syscalls.
// - Preserve X27/X28 around each `svc` to keep bump allocation stable.
fn emit_svc_preserve_heap(ctx, svc_imm) {
    // Use a transient 16-byte scratch slot. Avoid touching ctx["stack_size"] because
    // the adjustment is fully balanced and no stack-relative locals are accessed
    // between save and restore.
    push_u32_le(ctx["code"], insn_sub_sp(16))
    push_u32_le(ctx["code"], insn_str_reg_sp(27, 0))
    push_u32_le(ctx["code"], insn_str_reg_sp(28, 8))
    push_u32_le(ctx["code"], insn_svc(svc_imm))
    push_u32_le(ctx["code"], insn_ldr_reg_sp(27, 0))
    push_u32_le(ctx["code"], insn_ldr_reg_sp(28, 8))
    push_u32_le(ctx["code"], insn_add_sp(16))
    return nil
}

// Oren-level open(2) flags (rolling ABI).
//
// Design:
// - The lower 2 bits match POSIX access mode: 0=RDONLY, 1=WRONLY, 2=RDWR.
// - Higher bits are Oren-stable feature flags that must be translated to OS-specific
//   O_* values in the syscall lowering (Darwin vs Linux differ).
//
// This avoids baking OS flag literals into `.oren` code and keeps Linux parity feasible.
var OREN_O_CREAT = 256
var OREN_O_TRUNC = 512
var OREN_O_NONBLOCK = 1024

fn emit_translate_open_flags(ctx) {
    // Input:
    // - X1 = oren_flags
    // Output:
    // - X1 = os_flags (Darwin/Linux)
    //
    // Scratch:
    // - X4..X7
    //
    // Keep the access mode bits stable (flags & 3), and translate OREN_O_CREAT/OREN_O_TRUNC.
    push_u32_le(ctx["code"], insn_mov_reg(4, 1))     // X4 = oren_flags
    push_u32_le(ctx["code"], insn_movz(5, 3))        // X5 = 3
    push_u32_le(ctx["code"], insn_and_reg(1, 1, 5))  // X1 = flags & 3 (access bits)

    // If (oren_flags & OREN_O_CREAT) != 0 => OR in OS O_CREAT.
    push_u32_le(ctx["code"], insn_movz(5, OREN_O_CREAT))
    push_u32_le(ctx["code"], insn_and_reg(6, 4, 5)) // X6 = oren_flags & OREN_O_CREAT
    push_u32_le(ctx["code"], insn_cmp_reg(6, 31))   // cmp X6, XZR
    var br_skip_creat = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // B.EQ skip
    var os_creat = abi.darwin_open_flag_creat()
    if ctx["platform"]["os"] == "linux" {
        os_creat = labi.linux_open_flag_creat()
    }
    push_u32_le(ctx["code"], insn_movz(7, os_creat))
    push_u32_le(ctx["code"], insn_orr_reg(1, 1, 7)) // flags |= O_CREAT
    var after_creat = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_skip_creat, insn_b_cond((after_creat - br_skip_creat) / 4, 0)) // EQ

    // If (oren_flags & OREN_O_TRUNC) != 0 => OR in OS O_TRUNC.
    push_u32_le(ctx["code"], insn_movz(5, OREN_O_TRUNC))
    push_u32_le(ctx["code"], insn_and_reg(6, 4, 5)) // X6 = oren_flags & OREN_O_TRUNC
    push_u32_le(ctx["code"], insn_cmp_reg(6, 31))   // cmp X6, XZR
    var br_skip_trunc = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // B.EQ skip
    var os_trunc = abi.darwin_open_flag_trunc()
    if ctx["platform"]["os"] == "linux" {
        os_trunc = labi.linux_open_flag_trunc()
    }
    push_u32_le(ctx["code"], insn_movz(7, os_trunc))
    push_u32_le(ctx["code"], insn_orr_reg(1, 1, 7)) // flags |= O_TRUNC
    var after_trunc = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_skip_trunc, insn_b_cond((after_trunc - br_skip_trunc) / 4, 0)) // EQ

    // If (oren_flags & OREN_O_NONBLOCK) != 0 => OR in OS O_NONBLOCK.
    push_u32_le(ctx["code"], insn_movz(5, OREN_O_NONBLOCK))
    push_u32_le(ctx["code"], insn_and_reg(6, 4, 5)) // X6 = oren_flags & OREN_O_NONBLOCK
    push_u32_le(ctx["code"], insn_cmp_reg(6, 31))   // cmp X6, XZR
    var br_skip_nb = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // B.EQ skip
    var os_nb = abi.darwin_open_flag_nonblock()
    if ctx["platform"]["os"] == "linux" {
        os_nb = labi.linux_open_flag_nonblock()
    }
    push_u32_le(ctx["code"], insn_movz(7, os_nb))
    push_u32_le(ctx["code"], insn_orr_reg(1, 1, 7)) // flags |= O_NONBLOCK
    var after_nb = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_skip_nb, insn_b_cond((after_nb - br_skip_nb) / 4, 0)) // EQ

    return nil
}

fn emit_translate_fcntl_setfl_flags(ctx) {
    // Input:  X2 = oren_flags (rolling ABI)
    // Output: X2 = os_flags (Darwin/Linux)
    //
    // Currently we translate only the bits we use in runtime/tests: O_NONBLOCK.
    // Unknown bits are intentionally dropped in rolling mode (deny-by-default semantics).
    push_u32_le(ctx["code"], insn_mov_reg(4, 2))  // X4 = oren_flags
    push_u32_le(ctx["code"], insn_movz(2, 0))     // X2 = 0 (os_flags)

    push_u32_le(ctx["code"], insn_movz(5, OREN_O_NONBLOCK))
    push_u32_le(ctx["code"], insn_and_reg(6, 4, 5)) // X6 = oren_flags & OREN_O_NONBLOCK
    push_u32_le(ctx["code"], insn_cmp_reg(6, 31))   // cmp X6, XZR
    var br_skip_nb = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // B.EQ skip
    var os_nb = abi.darwin_open_flag_nonblock()
    if ctx["platform"]["os"] == "linux" {
        os_nb = labi.linux_open_flag_nonblock()
    }
    push_u32_le(ctx["code"], insn_movz(7, os_nb))
    push_u32_le(ctx["code"], insn_orr_reg(2, 2, 7)) // os_flags |= O_NONBLOCK
    var after_nb = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_skip_nb, insn_b_cond((after_nb - br_skip_nb) / 4, 0)) // EQ
    return nil
}

fn emit_translate_fcntl_getfl_return(ctx) {
    // Input:  X0 = os_flags (or negative errno)
    // Output: X0 = oren_flags (or negative errno)
    //
    // Keep access bits (&3) and translate O_NONBLOCK.
    push_u32_le(ctx["code"], insn_mov_reg(4, 0))   // X4 = os_flags / rc

    // If rc < 0, skip translation.
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31)) // cmp X0, XZR
    var br_skip_all = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // B.LT skip

    // X0 = os_flags & 3
    push_u32_le(ctx["code"], insn_mov_reg(0, 4))
    push_u32_le(ctx["code"], insn_movz(5, 3))
    push_u32_le(ctx["code"], insn_and_reg(0, 0, 5))

    // if (os_flags & OS_O_NONBLOCK) != 0 => X0 |= OREN_O_NONBLOCK
    var os_nb = abi.darwin_open_flag_nonblock()
    if ctx["platform"]["os"] == "linux" {
        os_nb = labi.linux_open_flag_nonblock()
    }
    push_u32_le(ctx["code"], insn_movz(5, os_nb))
    push_u32_le(ctx["code"], insn_and_reg(6, 4, 5))
    push_u32_le(ctx["code"], insn_cmp_reg(6, 31))
    var br_skip_nb = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // B.EQ skip
    push_u32_le(ctx["code"], insn_movz(7, OREN_O_NONBLOCK))
    push_u32_le(ctx["code"], insn_orr_reg(0, 0, 7))
    var after_nb = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_skip_nb, insn_b_cond((after_nb - br_skip_nb) / 4, 0)) // EQ

    var after_all = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_skip_all, insn_b_cond((after_all - br_skip_all) / 4, 11)) // LT
    return nil
}


fn native_compile_syscall_call(ctx, fn_name, args, compile_expr) {
        if fn_name == "sys_read" {
            compile_expr(ctx, args[0]) // fd -> X0

            // pre: native_capsule_sys_read_pre(fd) -> fd
            var bl_read_pre = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_read_pre, "name": "native_capsule_sys_read_pre"})

            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            compile_expr(ctx, args[1]) // ptr -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            compile_expr(ctx, args[2]) // len -> X0

            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0)) // ptr -> X2 (was X1 in sys_write logic, wait)
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0)) // fd -> X1
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // X0=len (current), X1=fd, X2=ptr.
            // Syscall: X0=fd, X1=ptr, X2=len.
            push_u32_le(ctx["code"], insn_mov_reg(3, 0)) // temp save len in X3
            push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // fd -> X0
            push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // ptr -> X1
            push_u32_le(ctx["code"], insn_mov_reg(2, 3)) // len -> X2

            var sys_read = abi.darwin_sys_read()
            var svc_imm = abi.darwin_svc_imm()
            var sys_reg = abi.darwin_syscall_reg()
            if ctx["platform"]["os"] == "linux" {
                sys_read = labi.linux_sys_read()
                svc_imm = labi.linux_svc_imm()
                sys_reg = labi.linux_syscall_reg()
            }
            push_u32_le(ctx["code"], insn_movz(sys_reg, sys_read))
            emit_svc_preserve_heap(ctx, svc_imm)
            if ctx["platform"]["os"] != "linux" {
                // macOS syscall convention: on error, carry flag is set and X0 contains errno (positive).
                // Normalize to X0 = -errno for syscall-first code that checks for negative errno.
                var br_ok = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.CC ok
                push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0)) // X0 = 0 - errno = -errno
                var ok_pos = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_ok, insn_b_cond((ok_pos - br_ok) / 4, 3)) // CC
            }
            return true
        }
        
    if fn_name == "sys_write" {
            // sys_write(fd, ptr, len)
            compile_expr(ctx, args[0]) // fd -> X0

            // pre: native_capsule_sys_write_pre(fd) -> fd
            var bl_write_pre = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_write_pre, "name": "native_capsule_sys_write_pre"})

            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            compile_expr(ctx, args[1]) // ptr -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            compile_expr(ctx, args[2]) // len -> X0

            // Pop ptr -> X2
            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // Pop fd -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // Move fd to X0, ptr already in X2, len in X0 currently -> swap len to X2? We already moved ptr to X2; len is in X0, fd in X1.
            // Arrange registers: X0=fd, X1=ptr, X2=len
            push_u32_le(ctx["code"], insn_mov_reg(3, 0)) // temp save len in X3
            push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // fd -> X0
            push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // ptr -> X1
            push_u32_le(ctx["code"], insn_mov_reg(2, 3)) // len -> X2

            var sys_write = abi.darwin_sys_write()
            var svc_imm = abi.darwin_svc_imm()
            var sys_reg = abi.darwin_syscall_reg()
            if ctx["platform"]["os"] == "linux" {
                sys_write = labi.linux_sys_write()
                svc_imm = labi.linux_svc_imm()
                sys_reg = labi.linux_syscall_reg()
            }
            push_u32_le(ctx["code"], insn_movz(sys_reg, sys_write))
            emit_svc_preserve_heap(ctx, svc_imm)
            if ctx["platform"]["os"] != "linux" {
                // Normalize macOS syscall error (carry set, X0=errno) to X0 = -errno.
                var br_ok = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.CC ok
                push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0)) // X0 = -errno
                var ok_pos = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_ok, insn_b_cond((ok_pos - br_ok) / 4, 3)) // CC
            }
        return true
    }

    if fn_name == "sys_exit" {
        // sys_exit(code) -> does not return
        // NOTE: kept here so all syscall emission stays centralized in this module.
        //
        // We intentionally do not add capsule gating for exit yet:
        // - exit is used by the injected runtime for fatal failures (OOM, init invariants)
        // - requiring PROC enrollment for exit would make FS-only/TIME-only capsule programs brittle
        // - AVM exit semantics are VM-terminate, not host-terminate

        compile_expr(ctx, args[0]) // code -> X0

        var svc_imm = abi.darwin_svc_imm()
        var sys_reg = abi.darwin_syscall_reg()
        var sys_exit = abi.darwin_sys_exit()
        if ctx["platform"]["os"] == "linux" {
            svc_imm = labi.linux_svc_imm()
            sys_reg = labi.linux_syscall_reg()
            sys_exit = labi.linux_sys_exit()
        }

        push_u32_le(ctx["code"], insn_movz(sys_reg, sys_exit))
        emit_svc_preserve_heap(ctx, svc_imm)
        return true
    }

        if fn_name == "sys_open" {
            // sys_open(path_ptr, flags, mode)
            // macOS: open(path, flags, mode) -> fd
            // Linux:  openat(AT_FDCWD=-100, path, flags, mode) -> fd
            // Keep args on stack so we can call capsule enforcement helpers (no bypass),
            // and optionally rewrite path via FS mounts (virtual->host).
            compile_expr(ctx, args[0]) // path -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
