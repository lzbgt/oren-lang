            // Keep args on stack so we can call capsule enforcement helpers without losing values.
            compile_expr(ctx, args[0]) // tv_ptr -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            compile_expr(ctx, args[1]) // tz_ptr -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            compile_expr(ctx, args[2]) // abs_ptr -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            // pre: native_capsule_sys_gettimeofday_pre(tv, tz, abs)
            // NOTE: on Linux abs is ignored, but capsule TIME policy still applies.
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 32)) // tv
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 16)) // tz
            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))  // abs
            var bl_gtod_pre = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_gtod_pre, "name": "native_capsule_sys_gettimeofday_pre"})

            // Reload args for syscall (pre-hook may clobber regs).
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 32)) // tv
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 16)) // tz
            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))  // abs (macOS only; cleared for Linux below)

            var sys_reg = abi.darwin_syscall_reg()
            var svc_imm = abi.darwin_svc_imm()
            var sysno = abi.darwin_sys_gettimeofday() // Darwin SYS_gettimeofday
            if ctx["platform"]["os"] == "linux" {
                sys_reg = labi.linux_syscall_reg()
                svc_imm = labi.linux_svc_imm()
                sysno = labi.linux_sys_gettimeofday()
                // Linux ignores abs_ptr; clear X2 for safety.
                push_u32_le(ctx["code"], insn_movz(2, 0))
            }

            // Preserve heap globals across syscall (rolling ABI hygiene).
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_reg_sp(27, 0))
            push_u32_le(ctx["code"], insn_str_reg_sp(28, 8))
            ctx["stack_size"] = ctx["stack_size"] + 16
            push_u32_le(ctx["code"], insn_movz(sys_reg, sysno))
            emit_svc_preserve_heap(ctx, svc_imm)
            push_u32_le(ctx["code"], insn_ldr_reg_sp(27, 0))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(28, 8))
            push_u32_le(ctx["code"], insn_add_sp(16))
