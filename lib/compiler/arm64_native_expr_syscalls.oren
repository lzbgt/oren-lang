            var svc_imm = 128
            var sysno = 363 // Darwin SYS_kevent
            var is_macos = true
            if fn_name == "sys_sendto" { sysno = 133 } // Darwin SYS_sendto
            if fn_name == "sys_recvfrom" { sysno = 29 } // Darwin SYS_recvfrom
