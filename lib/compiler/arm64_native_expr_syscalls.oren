            ctx["stack_size"] = ctx["stack_size"] - 16

            var sys_reg = 16
            var svc_imm = 128
            var sysno = 134 // Darwin SYS_shutdown
            var is_macos = true
            if ctx["platform"]["os"] == "linux" {
                // Linux aarch64: __NR_shutdown = 210
                sys_reg = 8
                svc_imm = 0
                sysno = 210
                is_macos = false
            }
