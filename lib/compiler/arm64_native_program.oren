import core "arm64_core.oren"
import stmtm "arm64_native_stmt.oren"
import parser "parser.oren"
import lexer "lexer.oren"
import token "token.oren"
import capsule "capsule.oren"
import abi "arm64_abi_macos.oren"
import labi "arm64_abi_linux.oren"

// Re-export core helpers locally so the native program compiler stays readable.
fn bytes_new() { return core.bytes_new() }
fn bytes_push(b, v) { return core.bytes_push(b, v) }
fn bytes_extend(b, other) { return core.bytes_extend(b, other) }
fn set_u32_le(buf, offset, n) { return core.set_u32_le(buf, offset, n) }
fn align_up(n, align) { return core.align_up(n, align) }
fn ceil_div(a, b) { return core.ceil_div(a, b) }
fn int_mod(a, b) { return core.int_mod(a, b) }

fn push_u32_le(buf, n) { return core.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return core.push_u64_le(buf, n) }
fn push_u32_be(buf, n) { return core.push_u32_be(buf, n) }

fn insn_add_imm(rd, rn, imm) { return core.insn_add_imm(rd, rn, imm) }
fn insn_add_reg(rd, rn, rm) { return core.insn_add_reg(rd, rn, rm) }
fn insn_add_sp(imm) { return core.insn_add_sp(imm) }
fn insn_ldr_ptr(rt, rn) { return core.insn_ldr_ptr(rt, rn) }
fn insn_ldr_reg_sp(reg, offset) { return core.insn_ldr_reg_sp(reg, offset) }
fn insn_mov_fp_sp() { return core.insn_mov_fp_sp() }
fn insn_mov_reg(rd, rn) { return core.insn_mov_reg(rd, rn) }
fn insn_movk(reg, imm16, shift_idx) { return core.insn_movk(reg, imm16, shift_idx) }
fn insn_movz(reg, imm16) { return core.insn_movz(reg, imm16) }
fn insn_mul(rd, rn, rm) { return core.insn_mul(rd, rn, rm) }
fn insn_stp_pre() { return core.insn_stp_pre() }
fn insn_str_reg_sp(reg, offset) { return core.insn_str_reg_sp(reg, offset) }
fn insn_sub_sp(imm) { return core.insn_sub_sp(imm) }
fn insn_svc(imm) { return core.insn_svc(imm) }

// Delegate statement compilation to the stmt module.
fn native_compile_stmt(ctx, stmt) { return stmtm.native_compile_stmt(ctx, stmt) }

fn str_starts_with(s, pref) {
    if s == nil || pref == nil { return false }
    var plen = oren_string_len(pref)
    if oren_string_len(s) < plen { return false }
    return oren_string_slice(s, 0, plen) == pref
}

fn str_ends_with_newline(s) {
    if s == nil { return false }
    var n = oren_string_len(s)
    if n == 0 { return false }
    return oren_string_char_at(s, n - 1) == "\n"
}

fn path_dirname(path) {
    if path == nil { return "." }
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at(path, i) == "/" {
            if i == 0 { return "/" }
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

fn path_join(base, rel) {
    if rel == nil { return "" }
    if oren_string_len(rel) > 0 && oren_string_char_at(rel, 0) == "/" { return rel }
    if base == nil || base == "" || base == "." { return rel }
    var bl = oren_string_len(base)
    if bl > 0 && oren_string_char_at(base, bl - 1) == "/" { return base + rel }
    return base + "/" + rel
}

fn trim_left_ws(s) {
    if s == nil { return "" }
    var i = 0
    var n = oren_string_len(s)
    while i < n {
        var c = oren_string_char_at(s, i)
        if c != " " && c != "\t" && c != "\r" { break }
        i = i + 1
    }
    if i == 0 { return s }
    return oren_string_slice(s, i, n)
}

fn runtime_include_path_from_line(line) {
    // Directive form (must be in a single line comment):
    //   // @include "relative/or/absolute/path.oren"
    //
    // NOTE: This is a tiny purpose-built preprocessor used only for the native runtime
    // injector. It intentionally does *not* implement general modules/imports because
    // runtime symbols must remain in the global namespace.
    if line == nil { return "" }
    var t = trim_left_ws(line)
    if !str_starts_with(t, "// @include") { return "" }
    var n = oren_string_len(t)
    var i = 0
    while i < n {
        if oren_string_char_at(t, i) == "\"" { break }
        i = i + 1
    }
    if i >= n { return "" }
    var j = i + 1
    while j < n {
        if oren_string_char_at(t, j) == "\"" { break }
        j = j + 1
    }
    if j >= n { return "" }
    return oren_string_slice(t, i + 1, j)
}

fn runtime_expand_includes_file(ctx, full_path, stack) {
    // Returns expanded source string, or nil on error (errors pushed into ctx["errors"]).
    if full_path == nil || full_path == "" {
        oren_list_push(ctx["errors"], "native backend: runtime include: empty path")
        return nil
    }

    // Cycle check
    if stack != nil {
        var si = 0
        while si < oren_list_len(stack) {
            if stack[si] == full_path {
                oren_list_push(ctx["errors"], "native backend: runtime include cycle: " + full_path)
                return nil
            }
            si = si + 1
        }
    }

    var src = oren_read_file(full_path)
    if oren_is_err(src) {
        var msg = oren_err_msg(src)
        var e = "native backend: failed to read runtime include " + full_path
        if msg != nil { e = e + ": " + msg }
        oren_list_push(ctx["errors"], e)
        return nil
    }

    var next_stack = []
    if stack != nil {
        var ci = 0
        while ci < oren_list_len(stack) {
            oren_list_push(next_stack, stack[ci])
            ci = ci + 1
        }
    }
    oren_list_push(next_stack, full_path)

    var out_parts = []
    var line = ""
    var i = 0
    var n = oren_string_len(src)
    while i < n {
        var ch = oren_string_char_at(src, i)
        if ch == "\n" {
            var inc = runtime_include_path_from_line(line)
            if inc != "" {
                var inc_full = path_join(path_dirname(full_path), inc)
                var child = runtime_expand_includes_file(ctx, inc_full, next_stack)
                if child == nil { return nil }
                oren_list_push(out_parts, child)
                if !str_ends_with_newline(child) {
                    oren_list_push(out_parts, "\n")
                }
            } else {
                oren_list_push(out_parts, line)
                oren_list_push(out_parts, "\n")
            }
            line = ""
        } else {
            line = line + ch
        }
        i = i + 1
    }

    // Handle last line if file doesn't end in '\n'
    if line != "" {
        var inc2 = runtime_include_path_from_line(line)
        if inc2 != "" {
            var inc_full2 = path_join(path_dirname(full_path), inc2)
            var child2 = runtime_expand_includes_file(ctx, inc_full2, next_stack)
            if child2 == nil { return nil }
            oren_list_push(out_parts, child2)
            if !str_ends_with_newline(child2) {
                oren_list_push(out_parts, "\n")
            }
        } else {
            oren_list_push(out_parts, line)
            oren_list_push(out_parts, "\n")
        }
    }

    var out = ""
    var pi = 0
    while pi < oren_list_len(out_parts) {
        out = out + out_parts[pi]
        pi = pi + 1
    }
    return out
}

fn node_id(name) { return {"type": "Identifier", "value": name} }
fn node_int(n) { return {"type": "Integer", "value": oren_int_to_string(n)} }
fn node_string(s) { return {"type": "String", "value": s} }
fn node_call(fn_name, args) { return {"type": "Call", "fn": node_id(fn_name), "args": args} }
fn node_expr_stmt(expr) { return {"type": "ExprStmt", "expr": expr} }
fn node_return(expr) { return {"type": "Return", "value": expr} }
fn node_block(stmts) { return {"type": "Block", "stmts": stmts} }
fn node_infix(left, op, right) { return {"type": "Infix", "left": left, "op": op, "right": right} }
fn node_if(cond, consq_stmts) { return {"type": "If", "cond": cond, "consq": node_block(consq_stmts), "alt": nil} }

fn func_decl_add(ctx, fn_name, arity) {
    if fn_name == nil { return nil }
    if fn_name == "" { return nil }
    // Avoid re-wrapping internal helper names.
    if str_starts_with(fn_name, "__oren_fnwrap_") { return nil }
    if str_starts_with(fn_name, "__oren_lambda_") { return nil }

    var existing = ctx["func_arity"][fn_name]
    if existing == nil {
        ctx["func_arity"][fn_name] = arity
        oren_list_push(ctx["func_decl_order"], fn_name)
    } else {
        if existing != arity {
            // Do not hard-exit inside codegen: collect and let the outer compiler emit OREN_DIAG.
            oren_list_push(ctx["errors"], "native backend: inconsistent arity for '" + fn_name + "' (" + oren_int_to_string(existing) + " vs " + oren_int_to_string(arity) + ")")
            return nil
        }
    }
    return nil
}

fn func_varargs_fixed_from_params(params) {
    if params == nil { return -1 }
    var n = oren_list_len(params)
    if n == 0 { return -1 }
    var last = params[n - 1]
    if last != nil && last["is_varargs"] == true { return n - 1 }
    return -1
}

fn func_decl_scan_stmt_list(ctx, stmts) {
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        var fn_node = nil
        if st != nil {
            if st["type"] == "Function" { fn_node = st }
            if st["type"] == "ExprStmt" {
                var exp = st["expr"]
                if exp != nil {
                    if exp["type"] == "Function" { fn_node = exp }
                }
            }
        }
        if fn_node != nil {
            var name = fn_node["name"]
            if name != nil && name != "" {
                func_decl_add(ctx, name, oren_list_len(fn_node["params"]))
                var vf = func_varargs_fixed_from_params(fn_node["params"])
                if vf >= 0 {
                    ctx["func_varargs_fixed"][name] = vf
                }
            }
        }
        i = i + 1
    }
    return nil
}

fn lambda_gensym(ctx) {
    var n = ctx["lambda_counter"]
    ctx["lambda_counter"] = n + 1
    return "__oren_lambda_" + oren_int_to_string(n)
}

fn lambda_maybe_add_capture(ctx, name, declared, seen, out) {
    if name == nil { return nil }
    if declared[name] == true { return nil }
    if ctx["aliases"][name] != nil { return nil }
    // Treat named functions as global and do not capture them for call-only usage.
    if ctx["func_arity"][name] != nil { return nil }
    if seen[name] == true { return nil }
    seen[name] = true
    oren_list_push(out, name)
    return nil
}

fn lambda_collect_declared_in_expression(ctx, exp, declared) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Function" {
        // Nested lambdas are their own scopes.
        return nil
    }
    if et == "Call" {
        lambda_collect_declared_in_expression(ctx, exp["fn"], declared)
        var i = 0
        while i < oren_list_len(exp["args"]) {
            lambda_collect_declared_in_expression(ctx, exp["args"][i], declared)
            i = i + 1
        }
        if exp["spread"] != nil { lambda_collect_declared_in_expression(ctx, exp["spread"], declared) }
        return nil
    }
    if et == "Prefix" { lambda_collect_declared_in_expression(ctx, exp["right"], declared); return nil }
    if et == "Infix" {
        lambda_collect_declared_in_expression(ctx, exp["left"], declared)
        lambda_collect_declared_in_expression(ctx, exp["right"], declared)
        return nil
    }
    if et == "If" {
        lambda_collect_declared_in_expression(ctx, exp["cond"], declared)
        lambda_collect_declared_in_statement(ctx, exp["consq"], declared)
        if exp["alt"] != nil { lambda_collect_declared_in_statement(ctx, exp["alt"], declared) }
        return nil
    }
    if et == "Member" { lambda_collect_declared_in_expression(ctx, exp["left"], declared); return nil }
    if et == "Index" {
        lambda_collect_declared_in_expression(ctx, exp["left"], declared)
        lambda_collect_declared_in_expression(ctx, exp["index"], declared)
        return nil
    }
    if et == "Array" {
        var j = 0
        while j < oren_list_len(exp["elements"]) {
            lambda_collect_declared_in_expression(ctx, exp["elements"][j], declared)
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        while k < oren_list_len(exp["pairs"]) {
            var pair = exp["pairs"][k]
            lambda_collect_declared_in_expression(ctx, pair["key"], declared)
            lambda_collect_declared_in_expression(ctx, pair["value"], declared)
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { lambda_collect_declared_in_expression(ctx, exp["call"], declared); return nil }
    return nil
}

fn lambda_collect_declared_in_statement(ctx, stmt, declared) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" {
        if stmt["name"] != nil { declared[stmt["name"]["value"]] = true }
        lambda_collect_declared_in_expression(ctx, stmt["value"], declared)
        return nil
    }
    if st == "Assign" { lambda_collect_declared_in_expression(ctx, stmt["value"], declared); return nil }
    if st == "Set" {
        lambda_collect_declared_in_expression(ctx, stmt["left"], declared)
        lambda_collect_declared_in_expression(ctx, stmt["value"], declared)
        return nil
    }
    if st == "Return" { lambda_collect_declared_in_expression(ctx, stmt["value"], declared); return nil }
    if st == "ExprStmt" {
        var exp = stmt["expr"]
        // Nested named function declarations shadow names in this scope.
        if exp != nil {
            if exp["type"] == "Function" {
                if exp["name"] != nil && exp["name"] != "" {
                    declared[exp["name"]] = true
                }
            }
        }
        lambda_collect_declared_in_expression(ctx, exp, declared)
        return nil
    }
    if st == "Block" {
        var i = 0
        while i < oren_list_len(stmt["stmts"]) {
            lambda_collect_declared_in_statement(ctx, stmt["stmts"][i], declared)
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        lambda_collect_declared_in_expression(ctx, stmt["cond"], declared)
        lambda_collect_declared_in_statement(ctx, stmt["body"], declared)
        return nil
    }
    if st == "For" {
        lambda_collect_declared_in_statement(ctx, stmt["init"], declared)
        lambda_collect_declared_in_expression(ctx, stmt["cond"], declared)
        lambda_collect_declared_in_statement(ctx, stmt["post"], declared)
        lambda_collect_declared_in_statement(ctx, stmt["body"], declared)
        return nil
    }
    if st == "Spawn" { lambda_collect_declared_in_expression(ctx, stmt["call"], declared); return nil }
    return nil
}

fn lambda_collect_used_in_expression(ctx, exp, declared, seen, out) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Identifier" {
        lambda_maybe_add_capture(ctx, exp["value"], declared, seen, out)
        return nil
    }
    if et == "Function" {
        // Nested lambdas are their own closures.
        return nil
    }
    if et == "Call" {
        lambda_collect_used_in_expression(ctx, exp["fn"], declared, seen, out)
        var i = 0
        while i < oren_list_len(exp["args"]) {
            lambda_collect_used_in_expression(ctx, exp["args"][i], declared, seen, out)
            i = i + 1
        }
        if exp["spread"] != nil { lambda_collect_used_in_expression(ctx, exp["spread"], declared, seen, out) }
        return nil
    }
    if et == "Prefix" { lambda_collect_used_in_expression(ctx, exp["right"], declared, seen, out); return nil }
    if et == "Infix" {
        lambda_collect_used_in_expression(ctx, exp["left"], declared, seen, out)
        lambda_collect_used_in_expression(ctx, exp["right"], declared, seen, out)
        return nil
    }
    if et == "If" {
        lambda_collect_used_in_expression(ctx, exp["cond"], declared, seen, out)
        lambda_collect_used_in_statement(ctx, exp["consq"], declared, seen, out)
        if exp["alt"] != nil { lambda_collect_used_in_statement(ctx, exp["alt"], declared, seen, out) }
        return nil
    }
    if et == "Member" { lambda_collect_used_in_expression(ctx, exp["left"], declared, seen, out); return nil }
    if et == "Index" {
        lambda_collect_used_in_expression(ctx, exp["left"], declared, seen, out)
        lambda_collect_used_in_expression(ctx, exp["index"], declared, seen, out)
        return nil
    }
    if et == "Array" {
        var j = 0
        while j < oren_list_len(exp["elements"]) {
            lambda_collect_used_in_expression(ctx, exp["elements"][j], declared, seen, out)
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        while k < oren_list_len(exp["pairs"]) {
            var pair = exp["pairs"][k]
            lambda_collect_used_in_expression(ctx, pair["key"], declared, seen, out)
            lambda_collect_used_in_expression(ctx, pair["value"], declared, seen, out)
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { lambda_collect_used_in_expression(ctx, exp["call"], declared, seen, out); return nil }
    return nil
}

fn lambda_collect_used_in_statement(ctx, stmt, declared, seen, out) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" { lambda_collect_used_in_expression(ctx, stmt["value"], declared, seen, out); return nil }
    if st == "Assign" {
        if stmt["name"] != nil { lambda_maybe_add_capture(ctx, stmt["name"]["value"], declared, seen, out) }
        lambda_collect_used_in_expression(ctx, stmt["value"], declared, seen, out)
        return nil
    }
    if st == "Set" {
        if stmt["left"] != nil && stmt["left"]["type"] == "Identifier" {
            lambda_maybe_add_capture(ctx, stmt["left"]["value"], declared, seen, out)
        } else {
            lambda_collect_used_in_expression(ctx, stmt["left"], declared, seen, out)
        }
        lambda_collect_used_in_expression(ctx, stmt["value"], declared, seen, out)
        return nil
    }
    if st == "Return" { lambda_collect_used_in_expression(ctx, stmt["value"], declared, seen, out); return nil }
    if st == "ExprStmt" { lambda_collect_used_in_expression(ctx, stmt["expr"], declared, seen, out); return nil }
    if st == "Block" {
        var i = 0
        while i < oren_list_len(stmt["stmts"]) {
            lambda_collect_used_in_statement(ctx, stmt["stmts"][i], declared, seen, out)
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        lambda_collect_used_in_expression(ctx, stmt["cond"], declared, seen, out)
        lambda_collect_used_in_statement(ctx, stmt["body"], declared, seen, out)
        return nil
    }
    if st == "For" {
        lambda_collect_used_in_statement(ctx, stmt["init"], declared, seen, out)
        lambda_collect_used_in_expression(ctx, stmt["cond"], declared, seen, out)
        lambda_collect_used_in_statement(ctx, stmt["post"], declared, seen, out)
        lambda_collect_used_in_statement(ctx, stmt["body"], declared, seen, out)
        return nil
    }
    if st == "Spawn" { lambda_collect_used_in_expression(ctx, stmt["call"], declared, seen, out); return nil }
    return nil
}

fn lambda_free_vars(ctx, fun) {
    var declared = {}
    var params = fun["params"]
    var i = 0
    while i < oren_list_len(params) {
        declared[params[i]["value"]] = true
        i = i + 1
    }
    lambda_collect_declared_in_statement(ctx, fun["body"], declared)

    var seen = {}
    var out = []
    lambda_collect_used_in_statement(ctx, fun["body"], declared, seen, out)
    return out
}

fn collect_lambdas_in_expression(ctx, exp) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Function" {
        if exp["name"] == "" {
            if exp["lambda_name"] == nil {
                exp["lambda_name"] = lambda_gensym(ctx)
                exp["captures"] = lambda_free_vars(ctx, exp)
                oren_list_push(ctx["lambda_defs"], {"name": exp["lambda_name"], "fun": exp, "captures": exp["captures"]})
            }
            // Still recurse to find nested lambdas in the body.
            collect_lambdas_in_statement(ctx, exp["body"])
            return nil
        }
        // Named function: recurse to find lambdas inside its body.
        collect_lambdas_in_statement(ctx, exp["body"])
        return nil
    }
    if et == "Call" {
        collect_lambdas_in_expression(ctx, exp["fn"])
        var i = 0
        while i < oren_list_len(exp["args"]) {
            collect_lambdas_in_expression(ctx, exp["args"][i])
            i = i + 1
        }
        return nil
    }
    if et == "Prefix" { collect_lambdas_in_expression(ctx, exp["right"]); return nil }
    if et == "Infix" {
        collect_lambdas_in_expression(ctx, exp["left"])
        collect_lambdas_in_expression(ctx, exp["right"])
        return nil
    }
    if et == "If" {
        collect_lambdas_in_expression(ctx, exp["cond"])
        collect_lambdas_in_statement(ctx, exp["consq"])
        if exp["alt"] != nil { collect_lambdas_in_statement(ctx, exp["alt"]) }
        return nil
    }
    if et == "Member" { collect_lambdas_in_expression(ctx, exp["left"]); return nil }
    if et == "Index" {
        collect_lambdas_in_expression(ctx, exp["left"])
        collect_lambdas_in_expression(ctx, exp["index"])
        return nil
    }
    if et == "Array" {
        var j = 0
        while j < oren_list_len(exp["elements"]) {
            collect_lambdas_in_expression(ctx, exp["elements"][j])
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        while k < oren_list_len(exp["pairs"]) {
            var pair = exp["pairs"][k]
            collect_lambdas_in_expression(ctx, pair["key"])
            collect_lambdas_in_expression(ctx, pair["value"])
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { collect_lambdas_in_expression(ctx, exp["call"]); return nil }
    return nil
}

fn collect_lambdas_in_statement(ctx, stmt) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" { collect_lambdas_in_expression(ctx, stmt["value"]); return nil }
    if st == "Assign" { collect_lambdas_in_expression(ctx, stmt["value"]); return nil }
    if st == "Set" {
        collect_lambdas_in_expression(ctx, stmt["left"])
        collect_lambdas_in_expression(ctx, stmt["value"])
        return nil
    }
    if st == "Return" { collect_lambdas_in_expression(ctx, stmt["value"]); return nil }
    if st == "ExprStmt" { collect_lambdas_in_expression(ctx, stmt["expr"]); return nil }
    if st == "Block" {
        var i = 0
        while i < oren_list_len(stmt["stmts"]) {
            collect_lambdas_in_statement(ctx, stmt["stmts"][i])
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        collect_lambdas_in_expression(ctx, stmt["cond"])
        collect_lambdas_in_statement(ctx, stmt["body"])
        return nil
    }
    if st == "For" {
        collect_lambdas_in_statement(ctx, stmt["init"])
        collect_lambdas_in_expression(ctx, stmt["cond"])
        collect_lambdas_in_statement(ctx, stmt["post"])
        collect_lambdas_in_statement(ctx, stmt["body"])
        return nil
    }
    if st == "Spawn" { collect_lambdas_in_expression(ctx, stmt["call"]); return nil }
    return nil
}

fn synth_fnwrap(fn_name, arity, varargs_fixed) {
    var wname = "__oren_fnwrap_" + fn_name
    var params = [node_id("__env"), node_id("__args")]
    var stmts = []

    // if __env != 0 { oren_panic("env mismatch") }
    var cond_env = node_infix(node_id("__env"), "!=", node_int(0))
    oren_list_push(stmts, node_if(cond_env, [node_expr_stmt(node_call("oren_panic", [node_string("env mismatch")]))]))

    var len_call = node_call("oren_list_len", [node_id("__args")])
    if varargs_fixed == nil {
        // if oren_list_len(__args) != arity { oren_panic("arity mismatch") }
        var cond_arity = node_infix(len_call, "!=", node_int(arity))
        oren_list_push(stmts, node_if(cond_arity, [node_expr_stmt(node_call("oren_panic", [node_string("arity mismatch")]))]))

        // return fn_name(oren_list_get(__args,0), ...)
        var call_args = []
        var i = 0
        while i < arity {
            oren_list_push(call_args, node_call("oren_list_get", [node_id("__args"), node_int(i)]))
            i = i + 1
        }
        var call0 = node_call(fn_name, call_args)
        oren_list_push(stmts, node_return(call0))
    } else {
        // Varargs: accept len >= fixed, pack rest into a list, and call the real fn.
        var fixed = varargs_fixed
        var cond_lt = node_infix(len_call, "<", node_int(fixed))
        oren_list_push(stmts, node_if(cond_lt, [node_expr_stmt(node_call("oren_panic", [node_string("arity mismatch")]))]))

        // var __rest = []
        var rest_name = "__rest"
        oren_list_push(stmts, {"type": "Var", "name": node_id(rest_name), "value": {"type": "Array", "elements": []}})

        // for __i=fixed; __i<len(__args); __i=__i+1 { push(__rest, get(__args,__i)) }
        var i_name = "__i"
        var init = {"type": "Var", "name": node_id(i_name), "value": node_int(fixed)}
        var cond = node_infix(node_id(i_name), "<", len_call)
        var post = {"type": "Assign", "name": node_id(i_name), "value": node_infix(node_id(i_name), "+", node_int(1))}
        var body = {"type": "Block", "stmts": [
            node_expr_stmt(node_call("oren_list_push", [node_id(rest_name), node_call("oren_list_get", [node_id("__args"), node_id(i_name)])]))
        ]}
        oren_list_push(stmts, {"type": "For", "init": init, "cond": cond, "post": post, "body": body})

        // call args: fixed args + __rest
        var call_args2 = []
        var j = 0
        while j < fixed {
            oren_list_push(call_args2, node_call("oren_list_get", [node_id("__args"), node_int(j)]))
            j = j + 1
        }
        oren_list_push(call_args2, node_id(rest_name))
        oren_list_push(stmts, node_return(node_call(fn_name, call_args2)))
    }

    var fun = {"type": "Function", "name": wname, "params": params, "body": node_block(stmts)}
    return node_expr_stmt(fun)
}

fn synth_lambda_wrapper(def) {
    var lname = def["name"]
    var fun = def["fun"]
    var caps = def["captures"]
    if caps == nil { caps = [] }

    var params = [node_id("__env"), node_id("__args")]
    var stmts = []

    var cap_count = oren_list_len(caps)
    if cap_count == 0 {
        // if __env != 0 { oren_panic("closure env mismatch") }
        var cond_env0 = node_infix(node_id("__env"), "!=", node_int(0))
        oren_list_push(stmts, node_if(cond_env0, [node_expr_stmt(node_call("oren_panic", [node_string("closure env mismatch")]))]))
    } else {
        // if __env == 0 { oren_panic("closure env mismatch") }
        var cond_env_nil = node_infix(node_id("__env"), "==", node_int(0))
        oren_list_push(stmts, node_if(cond_env_nil, [node_expr_stmt(node_call("oren_panic", [node_string("closure env mismatch")]))]))

        // if oren_list_len(__env) != cap_count { oren_panic("closure env mismatch") }
        var env_len = node_call("oren_list_len", [node_id("__env")])
        var cond_env_len = node_infix(env_len, "!=", node_int(cap_count))
        oren_list_push(stmts, node_if(cond_env_len, [node_expr_stmt(node_call("oren_panic", [node_string("closure env mismatch")]))]))
    }

    // Arity: fixed, or varargs (last param "...rest" bound as list).
    var param_count = oren_list_len(fun["params"])
    var args_len = node_call("oren_list_len", [node_id("__args")])
    var fixed = func_varargs_fixed_from_params(fun["params"])
    if fixed < 0 {
        var cond_args_len = node_infix(args_len, "!=", node_int(param_count))
        oren_list_push(stmts, node_if(cond_args_len, [node_expr_stmt(node_call("oren_panic", [node_string("arity mismatch")]))]))
    } else {
        var cond_lt = node_infix(args_len, "<", node_int(fixed))
        oren_list_push(stmts, node_if(cond_lt, [node_expr_stmt(node_call("oren_panic", [node_string("arity mismatch")]))]))
    }

    // Bind captures: var <cap> = oren_list_get(__env, i)
    var i = 0
    while i < cap_count {
        var cname = caps[i]
        var vstmt = {"type": "Var", "name": node_id(cname), "value": node_call("oren_list_get", [node_id("__env"), node_int(i)])}
        oren_list_push(stmts, vstmt)
        i = i + 1
    }

    // Bind params: fixed positional args + optional varargs rest list.
    if fixed < 0 {
        i = 0
        while i < param_count {
            var pname = fun["params"][i]["value"]
            var vstmt2 = {"type": "Var", "name": node_id(pname), "value": node_call("oren_list_get", [node_id("__args"), node_int(i)])}
            oren_list_push(stmts, vstmt2)
            i = i + 1
        }
    } else {
        i = 0
        while i < fixed {
            var pname2 = fun["params"][i]["value"]
            var vstmt3 = {"type": "Var", "name": node_id(pname2), "value": node_call("oren_list_get", [node_id("__args"), node_int(i)])}
            oren_list_push(stmts, vstmt3)
            i = i + 1
        }

        var rest_name2 = fun["params"][param_count - 1]["value"]
        oren_list_push(stmts, {"type": "Var", "name": node_id(rest_name2), "value": {"type": "Array", "elements": []}})

        var i_name2 = "__i"
        var init2 = {"type": "Var", "name": node_id(i_name2), "value": node_int(fixed)}
        var cond2 = node_infix(node_id(i_name2), "<", args_len)
        var post2 = {"type": "Assign", "name": node_id(i_name2), "value": node_infix(node_id(i_name2), "+", node_int(1))}
        var body2 = {"type": "Block", "stmts": [
            node_expr_stmt(node_call("oren_list_push", [node_id(rest_name2), node_call("oren_list_get", [node_id("__args"), node_id(i_name2)])]))
        ]}
        oren_list_push(stmts, {"type": "For", "init": init2, "cond": cond2, "post": post2, "body": body2})
    }

    // Append original lambda body statements.
    var body_stmts = fun["body"]["stmts"]
    i = 0
    while i < oren_list_len(body_stmts) {
        oren_list_push(stmts, body_stmts[i])
        i = i + 1
    }

    var wrapper_fun = {"type": "Function", "name": lname, "params": params, "body": node_block(stmts)}
    return node_expr_stmt(wrapper_fun)
}

fn native_diag_escape(msg) {
    if msg == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(msg) {
        var c = oren_string_char_at(msg, i)
        if c == "\n" { out = out + "\\n"; i = i + 1; continue }
        if c == "\r" { out = out + "\\r"; i = i + 1; continue }
        if c == "\t" { out = out + "\\t"; i = i + 1; continue }
        out = out + c
        i = i + 1
    }
    return out
}

fn native_emit_errors_and_exit(ctx) {
    if ctx == nil { return nil }
    if ctx["errors"] == nil { return nil }
    if oren_list_len(ctx["errors"]) == 0 { return nil }
    var first = ctx["errors"][0]
    print("OREN_DIAG kind=codegen code=1 msg=" + native_diag_escape(first))
    print("native backend errors:")
    var ei = 0
    while ei < oren_list_len(ctx["errors"]) {
        print(ctx["errors"][ei])
        ei = ei + 1
    }
    oren_exit(1)
    return nil
}

fn native_compile_program_arm64(linked, platform) {
    var ctx = {
        "code": bytes_new(),
        "data": bytes_new(),
        "fixups": [],
        "errors": [],
        "locals": {},
        "globals": {},
        "globals_floaty": {},
        "globals_stringy": {},
        "globals_list_stringy": {},
        "functions": {},
        "function_names": [],
        // Named function declarations (name -> arity) collected before codegen.
        // Used for first-class function values in the native backend.
        "func_arity": {},
        // Named function varargs mapping (name -> fixed param count). Presence means varargs.
        "func_varargs_fixed": {},
        "func_decl_order": [],
        // Lambda collection state (lambdas are parsed as anonymous Function nodes with name="").
        "lambda_defs": [],
        "lambda_counter": 0,
        "main_idx": nil,
        "imports": {},
        "import_list": [],
        "stack_size": 0,
        "in_function": false,
        "loop_ctx": nil,
        "scope": nil,
        "locals_floaty": {},
        "locals_stringy": {},
        "locals_list_stringy": {},
        "platform": platform,
        "aliases": linked["aliases"],
        "type_ns": linked["type_ns"],
        // Rolling v0: structs are map-shaped across backends, so member access uses map_get/map_set.
        // Keep the field_offsets knob for future layout-stable structs, but default to empty for now.
        "field_offsets": {}
    }
    
    if platform["debug"] == true {
        ctx["debug_info"] = {"funcs": []}
    }
    
    // Entry stub: calls main and exits with its result
    var sys_exit = abi.darwin_sys_exit()
    var svc_imm = abi.darwin_svc_imm()
    var sys_reg = abi.darwin_syscall_reg()
    if ctx["platform"]["os"] == "linux" {
        sys_exit = labi.linux_sys_exit()
        svc_imm = labi.linux_svc_imm()
        sys_reg = labi.linux_syscall_reg()
    }

    // Capture argc/argv/envp before any calls clobber argument registers.
    //
    // Linux (ELF entry):
    //   stack layout: [argc][argv...NULL][envp...NULL][auxv...]
    //   we load argc/argv from SP.
    //
    // macOS (dyld LC_MAIN):
    //   X0=argc, X1=argv (empirically X2 is not reliable for envp here).
    //
    // For both OSes we derive:
    //   envp = argv + (argc + 1) * 8
    if ctx["platform"]["os"] == "linux" {
        // X0 = *(SP), X1 = SP + 8  (argv)
        push_u32_le(ctx["code"], insn_ldr_ptr(0, 31))
        push_u32_le(ctx["code"], insn_add_imm(1, 31, 8))
    }
    push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = argc
    push_u32_le(ctx["code"], insn_mov_reg(20, 1)) // X20 = argv

    // envp = argv + (argc + 1) * 8
    push_u32_le(ctx["code"], insn_add_imm(2, 19, 1)) // X2 = argc + 1
    push_u32_le(ctx["code"], insn_movz(3, 8))        // X3 = 8
    push_u32_le(ctx["code"], insn_mul(2, 2, 3))      // X2 = (argc+1)*8
    push_u32_le(ctx["code"], insn_add_reg(21, 20, 2)) // X21 = envp

    push_u32_le(ctx["code"], insn_stp_pre())
    push_u32_le(ctx["code"], insn_mov_fp_sp())
    ctx["stack_size"] = ctx["stack_size"] + 16

    // Our generated functions do not currently preserve callee-saved registers
    // (AAPCS would require preserving X19-X28). Because the entry stub must
    // keep argc/argv/envp stable across runtime init calls, save them explicitly.
    push_u32_le(ctx["code"], insn_sub_sp(32))
    push_u32_le(ctx["code"], insn_str_reg_sp(19, 0))
    push_u32_le(ctx["code"], insn_str_reg_sp(20, 8))
    push_u32_le(ctx["code"], insn_str_reg_sp(21, 16))
    ctx["stack_size"] = ctx["stack_size"] + 32
    
    // Init Heap Globals (X28=ptr, X27=limit) to 0 before any runtime calls.
    push_u32_le(ctx["code"], insn_movz(28, 0))
    push_u32_le(ctx["code"], insn_movz(27, 0))
    
    // Init Runtime
    // The runtime needs to know which OS ABI this binary targets. Do not probe host
    // syscalls at runtime; the native backend already knows the `--target`.
    //
    // Convention (rolling):
    // - 1: macos
    // - 2: linux
    var target_os_id = 1
    if ctx["platform"]["os"] == "linux" { target_os_id = 2 }
    push_u32_le(ctx["code"], insn_movz(0, target_os_id))
    var bl_init = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_init, "name": "native_runtime_init"})

    // Restore argc/argv/envp saved across native_runtime_init.
    push_u32_le(ctx["code"], insn_ldr_reg_sp(19, 0))
    push_u32_le(ctx["code"], insn_ldr_reg_sp(20, 8))
    push_u32_le(ctx["code"], insn_ldr_reg_sp(21, 16))
    push_u32_le(ctx["code"], insn_add_sp(32))
    ctx["stack_size"] = ctx["stack_size"] - 32

    // Store argv/argc for oren_args() and envp for oren_getenv()/execve env inheritance.
    //
    // Preserve envp across the set_args call (our generated code does not preserve
    // callee-saved registers yet), and set envp AFTER set_args so any runtime-side
    // behavior cannot accidentally clear it.
    push_u32_le(ctx["code"], insn_sub_sp(16))
    push_u32_le(ctx["code"], insn_str_reg_sp(21, 0))
    ctx["stack_size"] = ctx["stack_size"] + 16

    // native_runtime_set_args(argc, argv)
    push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // argc
    push_u32_le(ctx["code"], insn_mov_reg(1, 20)) // argv
    var bl_set_args = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_args, "name": "native_runtime_set_args"})

    // native_runtime_set_envp(envp)
    push_u32_le(ctx["code"], insn_ldr_reg_sp(21, 0))
    push_u32_le(ctx["code"], insn_add_sp(16))
    ctx["stack_size"] = ctx["stack_size"] - 16

    push_u32_le(ctx["code"], insn_mov_reg(0, 21)) // envp
    var bl_set_envp = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_envp, "name": "native_runtime_set_envp"})

    // Initialize runtime capsule mode (defense-in-depth; runtime-side deny-by-default).
    // This reads envp and sets global capsule flags/mask before user code runs.
    var bl_capsule = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_capsule, "name": "native_runtime_capsule_init"})

    // Initialize GC mode for the native runtime (two-mode GC):
    // - default enabled unless compiled with `--no-gc`
    // - runtime env override: OREN_NO_GC=1 disables scanning
    var gc_default = 1
    if ctx["platform"]["no_gc"] == true { gc_default = 0 }
    push_u32_le(ctx["code"], insn_movz(0, gc_default))
    var bl_init_gc = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_init_gc, "name": "native_runtime_init_gc_mode"})

    if platform["debug"] == true {
        var debug_adr_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        push_u32_le(ctx["code"], 0)
        ctx["debug_fixup_pos"] = debug_adr_pos
        
        var static_addr_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], insn_movz(1, 0))
        push_u32_le(ctx["code"], insn_movk(1, 0, 1))
        push_u32_le(ctx["code"], insn_movk(1, 0, 2))
        push_u32_le(ctx["code"], insn_movk(1, 0, 3))
        ctx["debug_static_addr_pos"] = static_addr_pos
        
        var bl_set_dbg = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_dbg, "name": "oren_set_debug_info"})
    }

    // Register Main Thread
    push_u32_le(ctx["code"], insn_add_imm(0, 31, 0)) // MOV X0, SP
    var bl_reg = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_reg, "name": "oren_register_thread"})
    
    var main_fix = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": main_fix, "name": "main"})
    // Preserve exit code across shutdown
    push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = ret
    var shutdown_fix = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": shutdown_fix, "name": "native_gc_shutdown"})
    push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // restore X0
    // exit(X0)
    push_u32_le(ctx["code"], insn_movz(sys_reg, sys_exit))
    push_u32_le(ctx["code"], insn_svc(svc_imm))
    // Should not return

    // Record the end of the entry stub so debug symbolization can label it
    // without overlapping the injected runtime function ranges.
    ctx["entry_stub_end"] = oren_list_len(ctx["code"])
    
    // Inject Runtime (supports `// @include "..."` expansion for modular runtime sources).
    var runtime_src = runtime_expand_includes_file(ctx, "lib/runtime_native.oren", [])
    if runtime_src == nil { return ctx }
    var l = lexer.new_lexer(runtime_src)
    l["file"] = "lib/runtime_native.oren"
    var p = parser.new_parser(l)
    var runtime_prog = parser.parse_program(p)
    if oren_list_len(p["errors"]) != 0 {
        oren_list_push(ctx["errors"], "Parse errors in lib/runtime_native.oren")
        var ei = 0
        while ei < oren_list_len(p["errors"]) {
            oren_list_push(ctx["errors"], p["errors"][ei])
            ei = ei + 1
        }
        return ctx
    }

    // Capsule mode: enforce capability gating on user code before codegen.
    // Note: enforced against runtime annotations, but scanned on user program only.
    if platform["capsule"] == true {
        capsule.enforce_capsule(runtime_prog, linked, platform["cap_allow_domains"])
    }

    // Collect named function declarations (runtime + user) so the native backend can:
    // - treat named functions as first-class values (Identifier -> callable object)
    // - compute lambda free-var captures without accidentally capturing global functions
    func_decl_scan_stmt_list(ctx, runtime_prog["statements"])
    func_decl_scan_stmt_list(ctx, linked["statements"])

    // Collect lambdas from user code (lambdas are anonymous Function nodes with name="").
    // This annotates lambda nodes with:
    //   - lambda_name: generated wrapper name
    //   - captures: free vars in deterministic first-use order
    var li = 0
    while li < oren_list_len(linked["statements"]) {
        collect_lambdas_in_statement(ctx, linked["statements"][li])
        li = li + 1
    }
    
    // Compile runtime functions
    var i = 0
    while i < oren_list_len(runtime_prog["statements"]) {
        native_compile_stmt(ctx, runtime_prog["statements"][i])
        i = i + 1
    }

    // Register start of user code
    ctx["functions"]["__top_level__"] = oren_list_len(ctx["code"])

    var stmts = linked["statements"]
    i = 0
    while i < oren_list_len(stmts) {
        native_compile_stmt(ctx, stmts[i])
        i = i + 1
    }

    // Record end of top-level statement lowering (before wrapper emission).
    // This lets debug stack traces show a stable "__top_level__" frame for
    // programs that run statements at top-level without an explicit fn main().
    var top_level_end = oren_list_len(ctx["code"])

    // Synthesize wrappers for first-class named functions and for lambda literals.
    // These wrappers implement the uniform callable ABI:
    //   fn wrapper(__env, __args_list) -> value
    //
    // They are emitted after user code so forward references resolve via fixups.
    var wi = 0
    while wi < oren_list_len(ctx["func_decl_order"]) {
        var fname = ctx["func_decl_order"][wi]
        var arity = ctx["func_arity"][fname]
        if arity != nil {
            var vf = ctx["func_varargs_fixed"][fname]
            native_compile_stmt(ctx, synth_fnwrap(fname, arity, vf))
        }
        wi = wi + 1
    }

    wi = 0
    while wi < oren_list_len(ctx["lambda_defs"]) {
        native_compile_stmt(ctx, synth_lambda_wrapper(ctx["lambda_defs"][wi]))
        wi = wi + 1
    }

    // Debug pseudo-symbols for code regions that are not Function nodes:
    // - the entry stub (prologue + runtime init + call main + exit)
    // - top-level statement lowering ("main" alias) for programs without fn main()
    if ctx["platform"]["debug"] == true {
        var entry_end = ctx["entry_stub_end"]
        if entry_end != nil && entry_end > 0 {
            oren_list_push(ctx["debug_info"]["funcs"], {
                "name": "__entry_stub__",
                "start": 0,
                "end": entry_end,
                "file": "<native>",
                "line": 0,
                "col": 0,
                "params": []
            })
        }

        var top_start = ctx["functions"]["__top_level__"]
        if top_start != nil && top_level_end > top_start {
            oren_list_push(ctx["debug_info"]["funcs"], {
                "name": "__top_level__",
                "start": top_start,
                "end": top_level_end,
                "file": "<native>",
                "line": 0,
                "col": 0,
                "params": []
            })
        }
    }
    
    // Record entry (main) offset if present
    ctx["entry_idx"] = 0
    
    // Implicit exit(0)
    push_u32_le(ctx["code"], insn_movz(0, 0))
    push_u32_le(ctx["code"], insn_movz(sys_reg, sys_exit))
    push_u32_le(ctx["code"], insn_svc(svc_imm))
    
    // Generate resolve_symbol function
    // NOTE: resolve_symbol is used by the native runtime's non-debug stack trace.
    // It must match the actual static __TEXT base + header size used by the Mach-O emitter.
    //
    // Mach-O emitter uses:
    //   text_base=0x100000000, header_size=2048
    // so the first instruction is at 0x100000000 + 2048.
    var base_addr = 4294969344
    if ctx["platform"]["os"] == "linux" {
        base_addr = 4194304 + 120 // 0x400000 + 120 (ELF header approx, need verify)
    }

    // Build list of {off:int, name:string} and sort descending by off.
    // This ensures resolve_symbol picks the closest preceding function.
    var sym_entries = []

    // Pseudo-symbols for unlabeled code regions:
    // - entry stub at offset 0
    // - top-level statement lowering (when present)
    oren_list_push(sym_entries, {"off": 0, "name": "__entry_stub__"})
    var top_off = ctx["functions"]["__top_level__"]
    if top_off != nil {
        oren_list_push(sym_entries, {"off": top_off, "name": "__top_level__"})
    }

    // Runtime functions
    var j = 0
    while j < oren_list_len(runtime_prog["statements"]) {
        var st = runtime_prog["statements"][j]
        if st["type"] == "Function" {
            var name = st["name"]
            var off = ctx["functions"][name]
            if off != nil {
                oren_list_push(sym_entries, {"off": off, "name": name})
            }
        }
        j = j + 1
    }

    // User functions
    j = 0
    while j < oren_list_len(stmts) {
        var st2 = stmts[j]
        if st2["type"] == "Function" {
            var name2 = st2["name"]
            var off2 = ctx["functions"][name2]
            if off2 == nil {
                print("codegen error: function offset not found for " + name2)
            } else {
                oren_list_push(sym_entries, {"off": off2, "name": name2})
            }
        }
        j = j + 1
    }

    // Wrapper symbols for first-class named functions (deterministic: driven by func_decl_order).
    j = 0
    while j < oren_list_len(ctx["func_decl_order"]) {
        var fname = ctx["func_decl_order"][j]
        var wname = "__oren_fnwrap_" + fname
        var woff = ctx["functions"][wname]
        if woff != nil {
            oren_list_push(sym_entries, {"off": woff, "name": wname})
        }
        j = j + 1
    }

    // Lambda wrapper symbols (deterministic: driven by lambda_defs collection order).
    j = 0
    while j < oren_list_len(ctx["lambda_defs"]) {
        var def = ctx["lambda_defs"][j]
        var lname = def["name"]
        var loff = ctx["functions"][lname]
        if loff != nil {
            oren_list_push(sym_entries, {"off": loff, "name": lname})
        }
        j = j + 1
    }

    // Insertion sort (descending by off). Small N; keep it simple and deterministic.
    var si = 1
    while si < oren_list_len(sym_entries) {
        var key = sym_entries[si]
        var k_off = key["off"]
        var k = si - 1
        while k >= 0 {
            if sym_entries[k]["off"] >= k_off { break }
            sym_entries[k + 1] = sym_entries[k]
            k = k - 1
        }
        sym_entries[k + 1] = key
        si = si + 1
    }

    var sym_src = "fn resolve_symbol(addr) { var off = addr - " + oren_int_to_string(base_addr) + " "
	    j = 0
	    while j < oren_list_len(sym_entries) {
	        var e = sym_entries[j]
	        sym_src = sym_src + "if off >= " + oren_int_to_string(e["off"]) + " { return " + token.CH_QUOTE + e["name"] + token.CH_QUOTE + " } "
	        j = j + 1
	    }

    sym_src = sym_src + "return \"???\" }"
    
    print("Generating symbol table...")
    var l_sym = lexer.new_lexer(sym_src)
    l_sym["file"] = "<native:symbol_table>"
    var p_sym = parser.new_parser(l_sym)
    var prog_sym = parser.parse_program(p_sym)
    if oren_list_len(prog_sym["statements"]) > 0 {
        native_compile_stmt(ctx, prog_sym["statements"][0])
    } else {
        print("native backend: failed to compile resolve_symbol")
        // print(sym_src) // Debug
    }

    return ctx
}

// NOTE: Mach-O/ELF emitters were refactored into:
// - lib/compiler/arm64_macho.oren
// - lib/compiler/arm64_elf.oren
