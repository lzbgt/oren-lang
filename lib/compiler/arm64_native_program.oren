// Re-export core helpers locally so the native program compiler stays readable.
fn bytes_new() { return core.bytes_new() }
fn bytes_push(b, v) { return core.bytes_push(b, v) }
fn bytes_extend(b, other) { return core.bytes_extend(b, other) }
fn bytes_extend_list(b, xs) { return core.bytes_extend_list(b, xs) }
fn bytes_len(b) { return core.bytes_len(b) }
fn bytes_finalize(b) { return core.bytes_finalize(b) }
fn set_u32_le(buf, offset, n) { return core.set_u32_le(buf, offset, n) }
fn align_up(n, align) { return core.align_up(n, align) }
fn ceil_div(a, b) { return core.ceil_div(a, b) }
fn int_mod(a, b) { return core.int_mod(a, b) }

fn push_u32_le(buf, n) { return core.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return core.push_u64_le(buf, n) }
fn push_u32_be(buf, n) { return core.push_u32_be(buf, n) }

fn insn_add_imm(rd, rn, imm) { return core.insn_add_imm(rd, rn, imm) }
fn insn_add_reg(rd, rn, rm) { return core.insn_add_reg(rd, rn, rm) }
fn insn_add_sp(imm) { return core.insn_add_sp(imm) }
fn insn_ldr_ptr(rt, rn) { return core.insn_ldr_ptr(rt, rn) }
fn insn_ldr_reg_sp(reg, offset) { return core.insn_ldr_reg_sp(reg, offset) }
fn insn_mov_fp_sp() { return core.insn_mov_fp_sp() }
fn insn_mov_reg(rd, rn) { return core.insn_mov_reg(rd, rn) }
fn insn_movk(reg, imm16, shift_idx) { return core.insn_movk(reg, imm16, shift_idx) }
fn insn_movz(reg, imm16) { return core.insn_movz(reg, imm16) }
fn insn_mul(rd, rn, rm) { return core.insn_mul(rd, rn, rm) }
fn insn_stp_pre() { return core.insn_stp_pre() }
fn insn_str_reg_sp(reg, offset) { return core.insn_str_reg_sp(reg, offset) }
fn insn_sub_sp(imm) { return core.insn_sub_sp(imm) }
fn insn_sub_reg(rd, rn, rm) { return core.insn_sub_reg(rd, rn, rm) }
fn insn_svc(imm) { return core.insn_svc(imm) }
fn emit_load_u64_imm(ctx, reg, val) { return core.emit_load_u64_imm(ctx, reg, val) }

// Delegate statement compilation to the stmt module.
fn native_compile_stmt(ctx, stmt) { return stmtm.native_compile_stmt(ctx, stmt) }

fn native_diag_escape(msg) {
    if msg == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(msg) {
        var c = oren_string_char_at(msg, i)
        if c == "\n" { out = out + "\\n"; i = i + 1; continue }
        if c == "\r" { out = out + "\\r"; i = i + 1; continue }
        if c == "\t" { out = out + "\\t"; i = i + 1; continue }
        out = out + c
        i = i + 1
    }
    return out
}

fn native_env_str_eq(a, b) {
    // Avoid depending on runtime string equality semantics in compiler hot paths.
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn native_emit_errors_and_exit(ctx) {
    if ctx == nil { return nil }
    if ctx["errors"] == nil { return nil }
    if oren_list_len(ctx["errors"]) == 0 { return nil }
    var first = ctx["errors"][0]
    print("OREN_DIAG kind=codegen code=1 msg=" + native_diag_escape(first))
    print("native backend errors:")
    var ei = 0
    while ei < oren_list_len(ctx["errors"]) {
        print(ctx["errors"][ei])
        ei = ei + 1
    }
    oren_exit(1)
    return nil
}

fn _arm64_linked_has_toplevel_fn_named(linked, name) {
    if linked == nil || name == nil { return false }
    var stmts = linked["statements"]
    if stmts == nil { return false }
    var i = 0
    while i < oren_list_len(stmts) {
        var fn0 = coreir._stmt_to_function_decl(stmts[i])
        if fn0 != nil && fn0["name"] == name { return true }
        i = i + 1
    }
    return false
}

fn _arm64_new_ctx(linked, platform) {
    // Initialize the shared arm64 native compiler context (code/data builders, maps, ABI).
    //
    // This is used both by the main program compiler and by native-runtime caching layers
    // that compile the injected runtime into a reusable "runtime object" blob.
    var ctx = {
        "code": bytes_new(),
        "data": bytes_new(),
        "fixups": [],
        "errors": [],
        "locals": {},
        "globals": {},
        "globals_floaty": {},
        "globals_stringy": {},
        "globals_list_stringy": {},
        "functions": {},
        "function_names": [],
        // Named function declarations (name -> arity) collected before codegen.
        // Used for first-class function values in the native backend.
        "func_arity": {},
        // Named function varargs mapping (name -> fixed param count). Presence means varargs.
        "func_varargs_fixed": {},
        "func_decl_order": [],
        // Named-function wrappers are only needed when a function is used as a *value*
        // (Identifier expression), not when it is only ever called directly.
        "fnwrap_needed": {},
        // Lambda collection state (lambdas are parsed as anonymous Function nodes with name="").
        "lambda_defs": [],
        "lambda_counter": 0,
        "main_idx": nil,
        "imports": {},
        "import_list": [],
        "stack_size": 0,
        "in_function": false,
        "loop_ctx": nil,
        "scope": nil,
        "locals_floaty": {},
        "locals_stringy": {},
        "locals_list_stringy": {},
        "platform": platform,
        "call_abi": nabi.arm64(platform),
        "aliases": nil,
        "type_ns": nil,
        // Rolling v0: structs are map-shaped across backends, so member access uses map_get/map_set.
        // Keep the field_offsets knob for future layout-stable structs, but default to empty for now.
        "field_offsets": {}
    }
    if linked != nil {
        ctx["aliases"] = linked["aliases"]
        ctx["type_ns"] = linked["type_ns"]
    }
    if ctx["aliases"] == nil { ctx["aliases"] = {} }
    if ctx["type_ns"] == nil { ctx["type_ns"] = {} }

    // Reserve a `.data` slot holding the cstr0-literal table offset (u64).
    // (See comments in `native_compile_program_arm64` for the entry stub details.)
    while int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var cstr_slot_off = bytes_len(ctx["data"])
    var z = 0
    while z < 8 { bytes_push(ctx["data"], 0); z = z + 1 }
    ctx["cstr0_table_slot_enc"] = cstr_slot_off + 1

    return ctx
}

fn _rtobj_decode_int_enc(x_enc) {
    if x_enc == nil { return nil }
    return x_enc - 1
}

fn _arm64_sym_entries_push_unique(sym_seen, sym_entries, off, name) {
    if sym_seen == nil || sym_entries == nil { return nil }
    if off == nil { return nil }
    if name == nil || name == "" { return nil }
    if sym_seen[name] != nil { return nil }
    sym_seen[name] = true
    oren_list_push(sym_entries, {"off": off, "name": name})
    return nil
}

fn _arm64_rtobj_apply_to_ctx(ctx, meta) {
    if ctx == nil || meta == nil { return false }
    if ctx["errors"] == nil { ctx["errors"] = [] }

    // We must apply the runtime object before any other `.data` allocations so offsets match.
    var want_prefix = rtobj.RUNTIME_OBJ_DATA_PREFIX_LEN
    var have_prefix = bytes_len(ctx["data"])
    if have_prefix != want_prefix {
        oren_list_push(ctx["errors"], "arm64 native: runtime obj expects data prefix len=" + oren_int_to_string(want_prefix) + ", got " + oren_int_to_string(have_prefix))
        return false
    }

    var base_code = bytes_len(ctx["code"])

    // Append runtime data tail (after the shared prefix slot).
    var data_tail = meta["data_tail_u8"]
    if data_tail != nil { core.bytes_extend_u8_buf(ctx["data"], data_tail) }

    // Append runtime code.
    var code_u8 = meta["code_u8"]
    if code_u8 != nil { core.bytes_extend_u8_buf(ctx["code"], code_u8) }

    // Merge runtime globals (name -> data_off+1).
    if meta["globals"] != nil {
        var idxg = 0
        var pairg = [nil, nil]
        while 1 {
            var okg = oren_iter_next_entry(meta["globals"], idxg, pairg)
            if okg == 0 { break }
            var name = pairg[0]
            var off_enc = pairg[1]
            if name != nil && off_enc != nil {
                if ctx["globals"][name] != nil && ctx["globals"][name] != off_enc {
                    oren_list_push(ctx["errors"], "arm64 native: runtime obj global conflict " + name)
                } else {
                    ctx["globals"][name] = off_enc
                }
            }
            idxg = idxg + 1
        }
    }

    // Merge runtime cstr0 offsets list (store decoded offs into ctx list).
    if ctx["cstr0_list"] == nil { ctx["cstr0_list"] = [] }
    var c0 = meta["cstr0_list_enc"]
    if c0 != nil {
        var i0 = 0
        while i0 < oren_list_len(c0) {
            var off_enc2 = c0[i0]
            var off2 = _rtobj_decode_int_enc(off_enc2)
            if off2 != nil {
                oren_list_push(ctx["cstr0_list"], off2)
            }
            i0 = i0 + 1
        }
    }

    // Seed function metadata (for lambda capture analysis + fnwrap synthesis).
    if meta["declared_functions"] != nil { ctx["declared_functions"] = meta["declared_functions"] }
    if meta["func_arity"] != nil { ctx["func_arity"] = meta["func_arity"] }
    if meta["func_varargs_fixed"] != nil { ctx["func_varargs_fixed"] = meta["func_varargs_fixed"] }
    if meta["func_decl_order"] != nil { ctx["func_decl_order"] = meta["func_decl_order"] }

    // Prevent lambda wrapper name collisions with the cached runtime.
    var lc_enc = meta["lambda_counter_enc"]
    if lc_enc != nil {
        var lc = _rtobj_decode_int_enc(lc_enc)
        if lc != nil && lc >= 0 { ctx["lambda_counter"] = lc }
    }

    // Merge runtime function code offsets (name -> off+1 encoding in meta).
    var fn_offs_enc = meta["fn_offs_enc"]
    if fn_offs_enc != nil {
        var idxf = 0
        var pairf = [nil, nil]
        while 1 {
            var okf = oren_iter_next_entry(fn_offs_enc, idxf, pairf)
            if okf == 0 { break }
            var nm = pairf[0]
            var off_enc3 = pairf[1]
            var off3 = _rtobj_decode_int_enc(off_enc3)
            if nm != nil && off3 != nil {
                ctx["functions"][nm] = base_code + off3
            }
            idxf = idxf + 1
        }
    }

    // Merge runtime fixups (pos encoded as +1; adjust by base_code).
    var fx = meta["fixups_enc"]
    if fx != nil {
        var fi = 0
        while fi < oren_list_len(fx) {
            var f0 = fx[fi]
            if f0 != nil {
                var pos = _rtobj_decode_int_enc(f0["pos"])
                var data_off = _rtobj_decode_int_enc(f0["data_off"])
                var f1 = {"type": f0["type"], "pos": base_code + pos, "name": f0["name"]}
                if data_off != nil { f1["data_off"] = data_off }
                if f0["data_label"] != nil { f1["data_label"] = f0["data_label"] }
                oren_list_push(ctx["fixups"], f1)
            }
            fi = fi + 1
        }
    }

    ctx["runtime_injected"] = true
    return true
}

fn _arm64_rtobj_encode_offsets_map_int(m) {
    // Encode map<string,int> as map<string,int+1> to avoid 0-as-nil in stage2-native.
    if m == nil { return {} }
    var out = {}
    var idx = 0
    var pair = [nil, nil]
    while 1 {
        var ok = oren_iter_next_entry(m, idx, pair)
        if ok == 0 { break }
        var k = pair[0]
        var v = pair[1]
        if k != nil && v != nil {
            out[k] = v + 1
        }
        idx = idx + 1
    }
    return out
}

fn _arm64_rtobj_encode_offsets_list_int(xs) {
    if xs == nil { return [] }
    var out = []
    var i = 0
    while i < oren_list_len(xs) {
        var v = xs[i]
        if v != nil { oren_list_push(out, v + 1) }
        i = i + 1
    }
    return out
}

fn _arm64_rtobj_encode_fixups(fixups) {
    if fixups == nil { return [] }
    var out = []
    var i = 0
    while i < oren_list_len(fixups) {
        var f0 = fixups[i]
        if f0 != nil {
            var f1 = {"type": f0["type"], "pos": (f0["pos"] + 1)}
            if f0["name"] != nil { f1["name"] = f0["name"] }
            if f0["data_label"] != nil { f1["data_label"] = f0["data_label"] }
            if f0["data_off"] != nil { f1["data_off"] = (f0["data_off"] + 1) }
            oren_list_push(out, f1)
        }
        i = i + 1
    }
    return out
}

fn _arm64_build_runtime_obj(platform, runtime_path, runtime_hash, backend_sig) {
    // Compile the injected native runtime into a reusable object blob.
    //
    // Output:
    // - meta (Oren map; ints encoded as +1 where needed)
    // - code_u8 (u8_buf)
    // - data_tail_u8 (u8_buf)  // after the shared prefix slot
    var trace_sum = oren_env("OREN_TRACE_ARM64_RT_OBJ_SUMMARY") != nil
    var t0 = 0
    var t_parse_done = 0
    var t_meta_done = 0
    var t_lambda_done = 0
    var t_split_done = 0
    var t_globals_done = 0
    var t_decls_done = 0
    var t_wrap_done = 0
    var t_finalize_done = 0
    if trace_sum { t0 = oren_time_now_ns() }

    var linked0 = {"statements": [], "aliases": {}, "type_ns": {}}
    var ctx = _arm64_new_ctx(linked0, platform)
    // Debug builds expect a `debug_info` table to exist so statement compilation can
    // append function ranges deterministically. The runtime object cache currently does
    // not persist runtime debug info, but we still must keep the compiler codegen path
    // safe (no nil indexing panics) when `--debug` is enabled.
    if platform != nil && platform["debug"] == true {
        ctx["debug_info"] = {"funcs": []}
    }

    // IMPORTANT (native backend self-hosting):
    // When the compiler runs under the native runtime, `nil` is represented as 0.
    // That makes it unsafe to store a real offset 0 in maps (it becomes indistinguishable
    // from "missing"). The main program compiler always emits a non-empty entry stub,
    // so function offsets are never 0, but a standalone runtime object would otherwise
    // start at offset 0.
    //
    // Emit a single NOP so the first runtime function has a non-zero offset.
    push_u32_le(ctx["code"], 3573751839) // 0xD503201F (AArch64 NOP)

    // Parse/astbin-load the runtime source (shared helper in runtime bundle module).
    var prog = bundle.load_and_parse_runtime_native_for_platform(ctx, runtime_path, platform)
    if prog == nil { return nil }
    if trace_sum { t_parse_done = oren_time_now_ns() }
    var stmts = prog["statements"]
    if stmts == nil { stmts = [] }

    // Function metadata is required for lambda capture analysis and for fnwrap synthesis.
    coreir.collect_top_level_functions(ctx, {"statements": stmts}, "arm64 native rtobj")
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_sum { t_meta_done = oren_time_now_ns() }

    // Normalize nested `fn name(...)` to lambdas+vars for Tier‑1 parity.
    callable.rewrite_local_fn_decls_in_stmt_list(ctx, stmts)

    // Collect lambdas from the runtime (needed to prevent wrapper name collisions later).
    var li = 0
    while li < oren_list_len(stmts) {
        callable.collect_lambdas_in_statement(ctx, stmts[li])
        li = li + 1
    }
    if trace_sum { t_lambda_done = oren_time_now_ns() }

    // Split runtime decls/vars using the shared Tier‑1 rules, but do not synthesize __top_level__.
    var declared = ctx["declared_functions"]
    var split = nt.split_tier1_runtime_user(ctx, "arm64 native rtobj", stmts, [], declared)
    if split == nil { return nil }
    var runtime_decls = split["runtime_decls"]
    var runtime_vars = split["runtime_vars"]
    if runtime_decls == nil { runtime_decls = [] }
    if runtime_vars == nil { runtime_vars = [] }
    if trace_sum { t_split_done = oren_time_now_ns() }

    // Allocate runtime globals (zero-initialized; runtime init owns their values).
    var vi = 0
    while vi < oren_list_len(runtime_vars) {
        var st = runtime_vars[vi]
        if st != nil {
            _arm64_alloc_global_slot(ctx, st["name"], st["value"], true)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        }
        vi = vi + 1
    }
    if trace_sum { t_globals_done = oren_time_now_ns() }

    // Compile runtime declarations (functions/types/ffi).
    var trace_decls = oren_env("OREN_TRACE_ARM64_RT_OBJ_TOP_DECLS") != nil
    var top_decls = nil
    var top_keep = 12
    var sum_decl_ns = 0
    if trace_decls { top_decls = [] }
    var i = 0
    while i < oren_list_len(runtime_decls) {
        var t_decl0 = 0
        if trace_decls { t_decl0 = oren_time_now_ns() }
        native_compile_stmt(ctx, runtime_decls[i])
        if trace_decls {
            var dt_decl = oren_time_now_ns() - t_decl0
            sum_decl_ns = sum_decl_ns + dt_decl
            // Keep only the slowest `top_keep` decls to avoid huge logs.
            var st = runtime_decls[i]
            var nm = ""
            var ty = ""
            if st != nil {
                ty = st["type"]
                if ty == "Function" && st["name"] != nil { nm = st["name"] }
                else if ty == "ExprStmt" && st["expr"] != nil && st["expr"]["type"] == "Function" {
                    ty = "Function"
                    if st["expr"]["name"] != nil { nm = st["expr"]["name"] }
                }
                else if ty == "Type" && st["name"] != nil && st["name"]["value"] != nil { nm = st["name"]["value"] }
                else if ty == "FFI" && st["name"] != nil && st["name"]["value"] != nil { nm = st["name"]["value"] }
                else if ty == "Var" && st["name"] != nil && st["name"]["value"] != nil { nm = st["name"]["value"] }
            }
            // Keep a bounded set of the slowest decls without relying on list_pop/insert.
            if top_decls == nil { top_decls = [] }
            var ent = {"ns": dt_decl, "type": ty, "name": nm}
            if oren_list_len(top_decls) < top_keep {
                oren_list_push(top_decls, ent)
            } else {
                // Replace the current minimum if this decl is slower.
                var min_idx = 0
                var min_ns = top_decls[0]["ns"]
                var j = 1
                while j < oren_list_len(top_decls) {
                    var e0 = top_decls[j]
                    if e0 != nil && e0["ns"] != nil && e0["ns"] < min_ns {
                        min_ns = e0["ns"]
                        min_idx = j
                    }
                    j = j + 1
                }
                if dt_decl > min_ns {
                    top_decls[min_idx] = ent
                }
            }
        }
        i = i + 1
    }
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_sum { t_decls_done = oren_time_now_ns() }

    if trace_decls && top_decls != nil {
        print("[arm64_rtobj] top decls (us), sum_compile_ms=" + oren_int_to_string(sum_decl_ns / 1000000) + ":")
        var ti = 0
        while ti < oren_list_len(top_decls) {
            var e1 = top_decls[ti]
            if e1 != nil {
                var nm1 = e1["name"]
                if nm1 == nil { nm1 = "" }
                var ty1 = e1["type"]
                if ty1 == nil { ty1 = "" }
                var us = e1["ns"] / 1000
                print("  " + oren_int_to_string(us) + "us " + ty1 + " " + nm1)
            }
            ti = ti + 1
        }
    }

    // Synthesize wrappers needed by runtime itself (named fns used as values, lambda wrappers).
    var need = ctx["fnwrap_needed"]
    var wi = 0
    while wi < oren_list_len(ctx["func_decl_order"]) {
        var fname = ctx["func_decl_order"][wi]
        if need == nil || need[fname] == nil { wi = wi + 1; continue }
        var arity_enc = ctx["func_arity"][fname]
        if arity_enc != nil {
            var arity = arity_enc - 1
            var vf = nil
            var vf_enc = ctx["func_varargs_fixed"][fname]
            if vf_enc != nil { vf = vf_enc - 1 }
            var wname = "__oren_fnwrap_" + fname
            if ctx["functions"][wname] == nil {
                native_compile_stmt(ctx, callable.synth_fnwrap(fname, arity, vf))
            }
        }
        wi = wi + 1
    }
    wi = 0
    while wi < oren_list_len(ctx["lambda_defs"]) {
        var def = ctx["lambda_defs"][wi]
        if def != nil && def["name"] != nil {
            var lname = def["name"]
            if ctx["functions"][lname] == nil {
                native_compile_stmt(ctx, callable.synth_lambda_wrapper(def))
            }
        }
        wi = wi + 1
    }
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_sum { t_wrap_done = oren_time_now_ns() }

    // Materialize blobs for cache storage.
    var code_u8 = bytes_finalize(ctx["code"])
    var data_u8 = bytes_finalize(ctx["data"])
    if trace_sum { t_finalize_done = oren_time_now_ns() }
    var dn = oren_buf_len(data_u8)
    var prefix = rtobj.RUNTIME_OBJ_DATA_PREFIX_LEN
    if dn < prefix { return nil }
    var tail = oren_u8_buf_from_bytes_slice(data_u8, prefix, dn - prefix)
    if oren_is_err(tail) { return nil }

    var meta = {
        "schema": rtobj.RUNTIME_OBJ_SCHEMA,
        "backend": "arm64",
        "backend_sig": backend_sig,
        "runtime_hash": runtime_hash,
        "data_prefix_len": prefix,
        "fn_offs_enc": _arm64_rtobj_encode_offsets_map_int(ctx["functions"]),
        "fixups_enc": _arm64_rtobj_encode_fixups(ctx["fixups"]),
        "globals": ctx["globals"],
        "cstr0_list_enc": _arm64_rtobj_encode_offsets_list_int(ctx["cstr0_list"]),
        "declared_functions": ctx["declared_functions"],
        "func_arity": ctx["func_arity"],
        "func_varargs_fixed": ctx["func_varargs_fixed"],
        "func_decl_order": ctx["func_decl_order"],
        "lambda_counter_enc": ctx["lambda_counter"] + 1
    }
    if trace_sum {
        var total_ms = (t_finalize_done - t0) / 1000000
        var parse_ms = (t_parse_done - t0) / 1000000
        var meta_ms = (t_meta_done - t_parse_done) / 1000000
        var lambdas_ms = (t_lambda_done - t_meta_done) / 1000000
        var split_ms = (t_split_done - t_lambda_done) / 1000000
        var globals_ms = (t_globals_done - t_split_done) / 1000000
        var decls_ms = (t_decls_done - t_globals_done) / 1000000
        var wrap_ms = (t_wrap_done - t_decls_done) / 1000000
        var fin_ms = (t_finalize_done - t_wrap_done) / 1000000
        var fx_n = 0
        if ctx["fixups"] != nil { fx_n = oren_list_len(ctx["fixups"]) }
        print("[arm64_rtobj] total_ms=" + oren_int_to_string(total_ms) +
              " parse_ms=" + oren_int_to_string(parse_ms) +
              " meta_ms=" + oren_int_to_string(meta_ms) +
              " lambdas_ms=" + oren_int_to_string(lambdas_ms) +
              " split_ms=" + oren_int_to_string(split_ms) +
              " globals_ms=" + oren_int_to_string(globals_ms) +
              " decls_ms=" + oren_int_to_string(decls_ms) +
              " wrappers_ms=" + oren_int_to_string(wrap_ms) +
              " finalize_ms=" + oren_int_to_string(fin_ms) +
              " decls_n=" + oren_int_to_string(oren_list_len(runtime_decls)) +
              " vars_n=" + oren_int_to_string(oren_list_len(runtime_vars)) +
              " code_bytes=" + oren_int_to_string(oren_buf_len(code_u8)) +
              " data_bytes=" + oren_int_to_string(oren_buf_len(data_u8)) +
              " fixups_n=" + oren_int_to_string(fx_n))
    }
    return {"meta": meta, "code_u8": code_u8, "data_tail_u8": tail}
}

fn _arm64_try_load_or_build_runtime_obj(ctx, platform, runtime_path) {
    if ctx == nil { return false }
    if rtobj.rtobj_cache_enabled(platform) != true { return false }

    var trace = rtobj.rtobj_trace_enabled()
    var t0 = 0
    if trace { t0 = oren_time_now_ns() }

    var rh = rtobj.rtobj_runtime_hash(ctx, runtime_path)
    if rh == nil || rh == "" { return false }
    var key = rtobj.rtobj_cache_key("arm64", platform, rh)
    var bsig = rtobj.rtobj_backend_sig("arm64")
    var dir = rtobj.rtobj_cache_dir()

    var hit = rtobj.rtobj_load(dir, key)
    if hit != nil {
        if trace { print("[rtobj] hit backend=arm64 key=" + key) }
        if trace {
            var gl = hit["globals"]
            var gln = 0
            if gl != nil { gln = oren_map_len(gl) }
            print("[rtobj] meta globals len=" + oren_int_to_string(gln))
        }
        var ok_hit = _arm64_rtobj_apply_to_ctx(ctx, hit)
        if trace {
            var cg = ctx["globals"]
            var cgn = 0
            if cg != nil { cgn = oren_map_len(cg) }
            var have = 0
            if cg != nil {
                var vv = cg["g_target_os"]
                if vv != nil { have = 1 }
            }
            print("[rtobj] ctx globals len=" + oren_int_to_string(cgn) + " g_target_os_present=" + oren_int_to_string(have))
        }
        return ok_hit
    }

    // Optional seed fallback: allows "first build" to be fast even when the selected cache dir
    // is empty (e.g. benchmarking scripts that isolate cache dirs).
    var seed_hit = rtobj.rtobj_try_load_seed_into_cache(dir, key)
    if seed_hit != nil {
        if trace { print("[rtobj] seed-hit backend=arm64 key=" + key) }
        var ok_seed = _arm64_rtobj_apply_to_ctx(ctx, seed_hit)
        if trace {
            var cg_seed = ctx["globals"]
            var cgn_seed = 0
            if cg_seed != nil { cgn_seed = oren_map_len(cg_seed) }
            var have_seed = 0
            if cg_seed != nil {
                var vv_seed = cg_seed["g_target_os"]
                if vv_seed != nil { have_seed = 1 }
            }
            print("[rtobj] ctx globals len=" + oren_int_to_string(cgn_seed) + " g_target_os_present=" + oren_int_to_string(have_seed))
        }
        return ok_seed
    }

    if trace { print("[rtobj] miss backend=arm64 key=" + key + " (building)") }
    var built = _arm64_build_runtime_obj(platform, runtime_path, rh, bsig)
    if built == nil { return false }

    // Persist to cache.
    var meta = built["meta"]
    rtobj.rtobj_store(dir, key, meta, built["code_u8"], built["data_tail_u8"])

    // Apply immediately (avoid re-reading).
    meta["code_u8"] = built["code_u8"]
    meta["data_tail_u8"] = built["data_tail_u8"]
    var ok = _arm64_rtobj_apply_to_ctx(ctx, meta)
    if trace {
        var dt = oren_time_now_ns() - t0
        print("[rtobj] build+apply done +" + oren_int_to_string(dt / 1000000) + "ms")
        var cg2 = ctx["globals"]
        var cgn2 = 0
        if cg2 != nil { cgn2 = oren_map_len(cg2) }
        var have2 = 0
        if cg2 != nil {
            var vv2 = cg2["g_target_os"]
            if vv2 != nil { have2 = 1 }
        }
        print("[rtobj] ctx globals len=" + oren_int_to_string(cgn2) + " g_target_os_present=" + oren_int_to_string(have2))
    }
    return ok
}

fn _arm64_alloc_global_slot(ctx, name_node, init_expr, from_runtime) {
    if ctx == nil { return nil }
    if name_node == nil || name_node["type"] != "Identifier" {
        oren_list_push(ctx["errors"], "arm64 native: global var name must be identifier")
        return nil
    }
    var nm = name_node["value"]
    if nm == nil || nm == "" {
        oren_list_push(ctx["errors"], "arm64 native: global var name is empty")
        return nil
    }
    if nm == "__top_level__" {
        oren_list_push(ctx["errors"], "arm64 native: reserved global name __top_level__")
        return nil
    }
    if ctx["globals"] != nil && ctx["globals"][nm] != nil {
        var msg = "arm64 native: duplicate global var " + nm
        if from_runtime == true { msg = "arm64 native: runtime global var conflicts with existing global " + nm }
        oren_list_push(ctx["errors"], msg)
        return nil
    }

    // Globals live in `.data` as 8-byte slots. Do not rely on runtime execution order to
    // initialize them; the entry stub calls `__top_level__` before `main` to handle user
    // initializers deterministically.
    while int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var data_off = bytes_len(ctx["data"])
    var k = 0
    while k < 8 { bytes_push(ctx["data"], 0); k = k + 1 }
    // Store as offset+1 so a real offset of 0 is not indistinguishable from `nil`
    // when the compiler runs under the native runtime (where `nil` is 0).
    ctx["globals"][nm] = data_off + 1

    var is_floaty = exprm.native_expr_is_floaty(ctx, init_expr)
    var is_stringy = exprm.native_expr_is_stringy(ctx, init_expr)
    var is_list_stringy = exprm.native_expr_is_list_stringy(ctx, init_expr)
    if ctx["globals_floaty"] != nil { ctx["globals_floaty"][nm] = is_floaty }
    if ctx["globals_stringy"] != nil { ctx["globals_stringy"][nm] = is_stringy }
    if ctx["globals_list_stringy"] != nil { ctx["globals_list_stringy"][nm] = is_list_stringy }
    return nm
}

fn _arm64_prepare_top_level_and_globals(ctx, runtime_stmts, user_stmts) {
    // Normalize entry semantics for Tier‑1 native (arm64 parity with x86_64 + docs):
    // - Collect top-level globals (`var`) into `.data` slots
    // - Synthesize `fn __top_level__(){...}` that runs:
    //   - user global initializers (as Assign to globals)
    //   - user top-level executable statements
    // - Entry stub calls `__top_level__` before `main` (if present).
    //
    // IMPORTANT (runtime):
    // The injected native runtime is treated as a library. Its side effects must be driven by
    // `native_runtime_init` (and explicit runtime calls), not by implicit top-level execution.
    // Therefore we allocate runtime global slots but do NOT run their initializers in __top_level__.
    if ctx == nil { return nil }

    var declared = ctx["declared_functions"]
    var split = nt.split_tier1_runtime_user(ctx, "arm64 native", runtime_stmts, user_stmts, declared)
    if split == nil { return nil }

    var runtime_decls = split["runtime_decls"]
    var runtime_vars = split["runtime_vars"]
    var user_decls = split["user_decls"]
    var user_vars = split["user_vars"]
    var user_exec = split["user_exec"]
    if runtime_decls == nil { runtime_decls = [] }
    if runtime_vars == nil { runtime_vars = [] }
    if user_decls == nil { user_decls = [] }
    if user_vars == nil { user_vars = [] }
    if user_exec == nil { user_exec = [] }

    // Allocate runtime globals (zero-initialized; runtime init owns their values).
    var i = 0
    while i < oren_list_len(runtime_vars) {
        var st = runtime_vars[i]
        if st != nil {
            _arm64_alloc_global_slot(ctx, st["name"], st["value"], true)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        }
        i = i + 1
    }

    // Allocate user globals; defer all initializers into __top_level__.
    i = 0
    while i < oren_list_len(user_vars) {
        var st2 = user_vars[i]
        if st2 != nil {
            _arm64_alloc_global_slot(ctx, st2["name"], st2["value"], false)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        }
        i = i + 1
    }

    var init_stmts = nt.user_global_init_assign_stmts(user_vars)

    // Synthesize: `fn __top_level__() { <init_stmts>; <other_stmts>; return 0 }`
    var top_stmts = []
    var j = 0
    while j < oren_list_len(init_stmts) { oren_list_push(top_stmts, init_stmts[j]); j = j + 1 }
    j = 0
    while j < oren_list_len(user_exec) { oren_list_push(top_stmts, user_exec[j]); j = j + 1 }
    oren_list_push(top_stmts, {"type": "Return", "token": nil, "value": {"type": "Integer", "value": "0"}})

    var top_fn = {"type": "Function", "token": nil, "name": "__top_level__", "params": [], "body": {"type": "Block", "stmts": top_stmts}}
    var top_stmt = {"type": "ExprStmt", "token": nil, "expr": top_fn}
    return {"runtime_decls": runtime_decls, "user_decls": user_decls, "top_stmt": top_stmt}
}

fn native_compile_program_arm64(linked, platform) {
    var trace = false
    var v_trace = oren_env("OREN_TRACE_ARM64_NATIVE_COMPILE")
    if v_trace != nil && v_trace != "" { trace = true }
    if trace { print("[arm64] native_compile_program_arm64: enter") }
    var t_enter = 0
    if trace { t_enter = oren_time_now_ns() }
    var ctx = _arm64_new_ctx(linked, platform)
    
    if platform["debug"] == true {
        ctx["debug_info"] = {"funcs": []}
    }

    // Entry semantics (Tier‑1 native parity):
    // - Always call `__top_level__` first
    // - Call `main` only if the user defines it
    var has_main = _arm64_linked_has_toplevel_fn_named(linked, "main")
    if trace {
        if has_main { print("[arm64] has_main=true") } else { print("[arm64] has_main=false") }
    }
    
    // Entry stub: calls main and exits with its result
    var sys_exit = abi.darwin_sys_exit()
    var svc_imm = abi.darwin_svc_imm()
    var sys_reg = abi.darwin_syscall_reg()
    if ctx["platform"]["os"] == "linux" {
        sys_exit = labi.linux_sys_exit()
        svc_imm = labi.linux_svc_imm()
        sys_reg = labi.linux_syscall_reg()
    }

    // Capture argc/argv/envp before any calls clobber argument registers.
    //
    // Linux (ELF entry):
    //   stack layout: [argc][argv...NULL][envp...NULL][auxv...]
    //   we load argc/argv from SP.
    //
    // macOS (dyld LC_MAIN):
    //   X0=argc, X1=argv (empirically X2 is not reliable for envp here).
    //
    // For both OSes we derive:
    //   envp = argv + (argc + 1) * 8
    if ctx["platform"]["os"] == "linux" {
        // X0 = *(SP), X1 = SP + 8  (argv)
        push_u32_le(ctx["code"], insn_ldr_ptr(0, 31))
        push_u32_le(ctx["code"], insn_add_imm(1, 31, 8))
    }
    push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = argc
    push_u32_le(ctx["code"], insn_mov_reg(20, 1)) // X20 = argv

    // envp = argv + (argc + 1) * 8
    push_u32_le(ctx["code"], insn_add_imm(2, 19, 1)) // X2 = argc + 1
    push_u32_le(ctx["code"], insn_movz(3, 8))        // X3 = 8
    push_u32_le(ctx["code"], insn_mul(2, 2, 3))      // X2 = (argc+1)*8
    push_u32_le(ctx["code"], insn_add_reg(21, 20, 2)) // X21 = envp

    push_u32_le(ctx["code"], insn_stp_pre())
    push_u32_le(ctx["code"], insn_mov_fp_sp())
    ctx["stack_size"] = ctx["stack_size"] + 16

    // Our generated functions do not currently preserve callee-saved registers
    // (AAPCS would require preserving X19-X28). Because the entry stub must
    // keep argc/argv/envp stable across runtime init calls, save them explicitly.
    push_u32_le(ctx["code"], insn_sub_sp(32))
    push_u32_le(ctx["code"], insn_str_reg_sp(19, 0))
    push_u32_le(ctx["code"], insn_str_reg_sp(20, 8))
    push_u32_le(ctx["code"], insn_str_reg_sp(21, 16))
    ctx["stack_size"] = ctx["stack_size"] + 32
    
    // Init Heap Globals (X28=ptr, X27=limit) to 0 before any runtime calls.
    push_u32_le(ctx["code"], insn_movz(28, 0))
    push_u32_le(ctx["code"], insn_movz(27, 0))
    
    // Init Runtime
    // The runtime needs to know which OS ABI this binary targets. Do not probe host
    // syscalls at runtime; the native backend already knows the `--target`.
    //
    // Convention (rolling):
    // - 1: macos
    // - 2: linux
    var target_os_id = 1
    if ctx["platform"]["os"] == "linux" { target_os_id = 2 }
    push_u32_le(ctx["code"], insn_movz(0, target_os_id))
    var bl_init = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_init, "name": "native_runtime_init"})

    // Register embedded string literals once at startup (Tier‑1 performance).
    //
    // Do this immediately after `native_runtime_init` so subsequent runtime helpers
    // (capsule init, env parsing, etc) can safely use string literals as map keys.
    //
    // Table pointer derivation (PIE-safe):
    //   slot_addr = &data[slot_off] (PC-relative ADRP+ADD via fixup)
    //   table_off = *(u64*)slot_addr
    //   data_base = slot_addr - slot_off
    //   table_ptr = data_base + table_off
    // Then call `oren_init_static_cstr0_table(table_ptr)` once.
    var slot_off_enc = ctx["cstr0_table_slot_enc"]
    if slot_off_enc != nil {
        var slot_off = slot_off_enc - 1
        var adr_slot_pos = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_slot_pos, "data_off": slot_off})
        // X1 = table_off
        push_u32_le(ctx["code"], insn_ldr_ptr(1, 0))
        // X2 = slot_addr
        push_u32_le(ctx["code"], insn_mov_reg(2, 0))
        // X3 = slot_off
        emit_load_u64_imm(ctx, 3, slot_off)
        // X2 = data_base
        push_u32_le(ctx["code"], insn_sub_reg(2, 2, 3))
        // X0 = table_ptr
        push_u32_le(ctx["code"], insn_add_reg(0, 2, 1))
        var bl_cstr = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_cstr, "name": "oren_init_static_cstr0_table"})
    }

    // Restore argc/argv/envp saved across native_runtime_init.
    push_u32_le(ctx["code"], insn_ldr_reg_sp(19, 0))
    push_u32_le(ctx["code"], insn_ldr_reg_sp(20, 8))
    push_u32_le(ctx["code"], insn_ldr_reg_sp(21, 16))
    push_u32_le(ctx["code"], insn_add_sp(32))
    ctx["stack_size"] = ctx["stack_size"] - 32

    // Store argv/argc for oren_args() and envp for oren_getenv()/execve env inheritance.
    //
    // Preserve envp across the set_args call (our generated code does not preserve
    // callee-saved registers yet), and set envp AFTER set_args so any runtime-side
    // behavior cannot accidentally clear it.
    push_u32_le(ctx["code"], insn_sub_sp(16))
    push_u32_le(ctx["code"], insn_str_reg_sp(21, 0))
    ctx["stack_size"] = ctx["stack_size"] + 16

    // native_runtime_set_args(argc, argv)
    push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // argc
    push_u32_le(ctx["code"], insn_mov_reg(1, 20)) // argv
    var bl_set_args = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_args, "name": "native_runtime_set_args"})

    // native_runtime_set_envp(envp)
    push_u32_le(ctx["code"], insn_ldr_reg_sp(21, 0))
    push_u32_le(ctx["code"], insn_add_sp(16))
    ctx["stack_size"] = ctx["stack_size"] - 16

    push_u32_le(ctx["code"], insn_mov_reg(0, 21)) // envp
    var bl_set_envp = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_envp, "name": "native_runtime_set_envp"})

    // Initialize runtime capsule mode when `--capsule` is enabled.
    //
    // NOTE: This is a compile-time capsule feature gate. Without `--capsule`, the native
    // backend does not emit the capsule syscall hook ABI surface, so enabling capsule by
    // env alone would not provide a capability-safe boundary.
    if platform != nil && platform["capsule"] == true {
        var bl_capsule = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_capsule, "name": "native_runtime_capsule_init"})
    }

    // Initialize GC mode for the native runtime (two-mode GC):
    // - default enabled unless compiled with `--no-gc`
    // - runtime env override: OREN_NO_GC=1 disables scanning
    var gc_default = 1
    if ctx["platform"]["no_gc"] == true { gc_default = 0 }
    push_u32_le(ctx["code"], insn_movz(0, gc_default))
    var bl_init_gc = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_init_gc, "name": "native_runtime_init_gc_mode"})

    if platform["debug"] == true {
        var debug_adr_pos = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        push_u32_le(ctx["code"], 0)
        ctx["debug_fixup_pos"] = debug_adr_pos
        
        var static_addr_pos = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], insn_movz(1, 0))
        push_u32_le(ctx["code"], insn_movk(1, 0, 1))
        push_u32_le(ctx["code"], insn_movk(1, 0, 2))
        push_u32_le(ctx["code"], insn_movk(1, 0, 3))
        ctx["debug_static_addr_pos"] = static_addr_pos
        
        var bl_set_dbg = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_dbg, "name": "oren_set_debug_info"})
    }

    // Register Main Thread
    push_u32_le(ctx["code"], insn_add_imm(0, 31, 0)) // MOV X0, SP
    var bl_reg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_reg, "name": "oren_register_thread"})
    
    // Run synthesized top-level initializers/statements before main.
    var bl_top = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_top, "name": "__top_level__"})

    // Run user main if present; otherwise exit with 0.
    if has_main {
        var main_fix = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": main_fix, "name": "main"})
        // Preserve exit code across shutdown
        push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = ret
    } else {
        push_u32_le(ctx["code"], insn_movz(19, 0)) // X19 = 0
    }
    var shutdown_fix = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": shutdown_fix, "name": "native_gc_shutdown"})
    push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // restore X0
    // exit(X0)
    push_u32_le(ctx["code"], insn_movz(sys_reg, sys_exit))
    push_u32_le(ctx["code"], insn_svc(svc_imm))
    // Should not return

    // Record the end of the entry stub so debug symbolization can label it
    // without overlapping the injected runtime function ranges.
    ctx["entry_stub_end"] = bytes_len(ctx["code"])
    
    // Inject Runtime (supports `// @include "..."` expansion for modular runtime sources),
    // and re-run whole-program DCE after injection to keep compilation time bounded.
    //
    // This is shared with the x86_64 native backend so Tier‑1 backends converge on one
    // injection + DCE policy (and the same entry-stub DCE roots).
    if trace { print("[arm64] runtime bundle prepare start") }
    var t_bun0 = 0
    if trace { t_bun0 = oren_time_now_ns() }
    var runtime_path = "lib/runtime_native.oren"
    if platform != nil && platform["capsule"] == true {
        runtime_path = "lib/runtime_native_capsule.oren"
    } else {
        // Optional: smaller injected runtime profile to keep cold rtobj builds bounded.
        //
        // Values (rolling):
        // - unset / "full": default full runtime (`lib/runtime_native.oren`)
        // - "core" / "minimal": reduced runtime (`lib/runtime_native_core.oren`)
        var prof = oren_env("OREN_NATIVE_RUNTIME_PROFILE")
        if native_env_str_eq(prof, "core") || native_env_str_eq(prof, "minimal") {
            runtime_path = "lib/runtime_native_core.oren"
        }
    }
    var used_rtobj = false
    var runtime_stmts = []
    var user_stmts = []

    // High-leverage throughput win (rolling):
    // Prefer a cached compiled runtime blob over compiling the full injected runtime on every build.
    used_rtobj = _arm64_try_load_or_build_runtime_obj(ctx, platform, runtime_path)

    var bun = nil
    if used_rtobj != true {
        bun = bundle.prepare_native_runtime_bundle(ctx, "arm64", linked, platform, {"runtime_path": runtime_path, "inject_runtime": true})
        if bun == nil { return ctx }
        runtime_stmts = bun["runtime_stmts"]
        user_stmts = bun["user_stmts"]
    } else {
        // Runtime already compiled into ctx; user statements come from the original program.
        user_stmts = nil
        if linked != nil { user_stmts = linked["statements"] }
    }
    if trace {
        var dt_bun = (oren_time_now_ns() - t_bun0) / 1000000
        var mode = "bundle"
        if used_rtobj == true { mode = "rtobj" }
        print("[arm64] runtime prepare (" + mode + ") +" + oren_int_to_string(dt_bun) + "ms")
    }
    if runtime_stmts == nil { runtime_stmts = [] }
    if user_stmts == nil { user_stmts = [] }
    if trace {
        print("[arm64] runtime bundle prepare done runtime_stmts=" + oren_int_to_string(oren_list_len(runtime_stmts)) + " user_stmts=" + oren_int_to_string(oren_list_len(user_stmts)))
    }

    // Collect top-level named function declarations (runtime + user) so the native backend can:
    // - treat named functions as first-class values (Identifier -> callable object)
    // - compute lambda free-var captures without accidentally capturing global functions
    //
    // CoreIR v0 keeps function metadata deterministic across backends.
    var t_fnmeta0 = 0
    if trace { t_fnmeta0 = oren_time_now_ns() }
    if used_rtobj == true {
        // Runtime function metadata already seeded from the cached runtime object; add user declarations.
        coreir.collect_top_level_functions_merge(ctx, linked, "arm64 native")
    } else {
        coreir.collect_top_level_functions(ctx, bun["linked"], "arm64 native")
    }
    if trace {
        var dt_fnmeta = (oren_time_now_ns() - t_fnmeta0) / 1000000
        print("[arm64] collect_top_level_functions +" + oren_int_to_string(dt_fnmeta) + "ms")
    }
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // Normalize local `fn name(...) { ... }` declarations inside blocks into lambdas+vars
    // so Tier‑1 native backends share the same nested-function semantics.
    var t_rewrite0 = 0
    if trace { t_rewrite0 = oren_time_now_ns() }
    callable.rewrite_local_fn_decls_in_stmt_list(ctx, user_stmts)
    if used_rtobj != true {
        callable.rewrite_local_fn_decls_in_stmt_list(ctx, runtime_stmts)
    }
    if trace {
        var dt_rewrite = (oren_time_now_ns() - t_rewrite0) / 1000000
        print("[arm64] rewrite_local_fn_decls +" + oren_int_to_string(dt_rewrite) + "ms")
    }

    // Collect lambdas from runtime + user code (lambdas are anonymous Function nodes with name="").
    //
    // This annotates lambda nodes with:
    //   - lambda_name: generated wrapper name
    //   - captures: free vars in deterministic first-use order
    //
    // Note: the runtime contains a small number of local `fn` declarations which are normalized
    // into lambdas+vars for Tier‑1 parity. Those lambdas must be collected too.
    var t_lamb0 = 0
    if trace { t_lamb0 = oren_time_now_ns() }
    var li = 0
    while li < oren_list_len(user_stmts) {
        callable.collect_lambdas_in_statement(ctx, user_stmts[li])
        li = li + 1
    }
    if used_rtobj != true {
        li = 0
        while li < oren_list_len(runtime_stmts) {
            callable.collect_lambdas_in_statement(ctx, runtime_stmts[li])
            li = li + 1
        }
    }
    if trace {
        var dt_lamb = (oren_time_now_ns() - t_lamb0) / 1000000
        print("[arm64] collect_lambdas +" + oren_int_to_string(dt_lamb) + "ms")
    }
    
    // Prepare globals + top-level wrapper for Tier‑1 parity.
    var t_prep0 = 0
    if trace { t_prep0 = oren_time_now_ns() }
    var prep = _arm64_prepare_top_level_and_globals(ctx, runtime_stmts, user_stmts)
    if prep == nil { return ctx }
    if trace {
        var dt_prep = (oren_time_now_ns() - t_prep0) / 1000000
        print("[arm64] prepare_globals +" + oren_int_to_string(dt_prep) + "ms")
    }
    var runtime_decls = prep["runtime_decls"]
    var user_decls = prep["user_decls"]
    var top_stmt = prep["top_stmt"]

    // Compile runtime declarations (functions/types/ffi), but not runtime global initializers.
    var i = 0
    if trace { print("[arm64] compile runtime decls start n=" + oren_int_to_string(oren_list_len(runtime_decls))) }
    var t_rt0 = 0
    if trace { t_rt0 = oren_time_now_ns() }
    while i < oren_list_len(runtime_decls) {
        native_compile_stmt(ctx, runtime_decls[i])
        i = i + 1
    }
    if trace {
        var dt_rt = (oren_time_now_ns() - t_rt0) / 1000000
        print("[arm64] compile runtime decls done +" + oren_int_to_string(dt_rt) + "ms")
    }

    // Compile user declarations (functions/types/ffi).
    i = 0
    if trace { print("[arm64] compile user decls start n=" + oren_int_to_string(oren_list_len(user_decls))) }
    var t_user0 = 0
    if trace { t_user0 = oren_time_now_ns() }
    while i < oren_list_len(user_decls) {
        native_compile_stmt(ctx, user_decls[i])
        i = i + 1
    }
    if trace {
        var dt_user = (oren_time_now_ns() - t_user0) / 1000000
        print("[arm64] compile user decls done +" + oren_int_to_string(dt_user) + "ms")
    }

    // Compile synthesized __top_level__ last (it can reference any user/runtime symbols).
    // The entry stub calls it before main.
    var t_top0 = 0
    if trace { t_top0 = oren_time_now_ns() }
    native_compile_stmt(ctx, top_stmt)
    if trace {
        var dt_top = (oren_time_now_ns() - t_top0) / 1000000
        print("[arm64] compile __top_level__ +" + oren_int_to_string(dt_top) + "ms")
    }

    // Synthesize wrappers for first-class named functions and for lambda literals.
    // These wrappers implement the uniform callable ABI:
    //   fn wrapper(__env, __args_list) -> value
    //
    // They are emitted after user code so forward references resolve via fixups.
    var t_wrap0 = 0
    if trace { t_wrap0 = oren_time_now_ns() }
    var need = ctx["fnwrap_needed"]
    var n_wrap = 0
    var wi = 0
    while wi < oren_list_len(ctx["func_decl_order"]) {
        var fname = ctx["func_decl_order"][wi]
        if need == nil || need[fname] == nil { wi = wi + 1; continue }
        n_wrap = n_wrap + 1
        var arity_enc = ctx["func_arity"][fname]
        if arity_enc != nil {
            var arity = arity_enc - 1
            var vf = nil
            var vf_enc = ctx["func_varargs_fixed"][fname]
            if vf_enc != nil { vf = vf_enc - 1 }
            var wname = "__oren_fnwrap_" + fname
            if ctx["functions"][wname] == nil {
                native_compile_stmt(ctx, callable.synth_fnwrap(fname, arity, vf))
            }
        }
        wi = wi + 1
    }

    wi = 0
    while wi < oren_list_len(ctx["lambda_defs"]) {
        var def = ctx["lambda_defs"][wi]
        if def != nil && def["name"] != nil {
            var lname = def["name"]
            if ctx["functions"][lname] == nil {
                native_compile_stmt(ctx, callable.synth_lambda_wrapper(def))
            }
        }
        wi = wi + 1
    }
    if trace {
        var dt_wrap = (oren_time_now_ns() - t_wrap0) / 1000000
        print("[arm64] synth wrappers +" + oren_int_to_string(dt_wrap) + "ms fnwrap=" + oren_int_to_string(n_wrap) + " lambdas=" + oren_int_to_string(oren_list_len(ctx["lambda_defs"])))
    }

    // Debug pseudo-symbol for code region that is not a Function node:
    // - the entry stub (prologue + runtime init + call __top_level__/main + exit)
    if ctx["platform"]["debug"] == true {
        var entry_end = ctx["entry_stub_end"]
        if entry_end != nil && entry_end > 0 {
            oren_list_push(ctx["debug_info"]["funcs"], {
                "name": "__entry_stub__",
                "start": 0,
                "end": entry_end,
                "file": "<native>",
                "line": 0,
                "col": 0,
                "params": []
            })
        }

        // __top_level__ is a real function symbol now; it will be included via normal function debug info.
    }
    
    // Record entry (main) offset if present
    ctx["entry_idx"] = 0
    
    // Generate `resolve_symbol` for stack traces.
    //
    // NOTE (native backend; rolling):
    // In debug builds, the native runtime prefers the embedded debug-info table (`g_debug_info`)
    // for accurate range-based symbolication. That table is authoritative and does not require
    // generating a huge `resolve_symbol` function.
    //
    // Generating `resolve_symbol` by emitting + parsing a giant Oren source string is expensive,
    // especially for self-hosted native compilers, and can dominate debug-build wall time.
    //
    // Policy:
    // - Default: keep `resolve_symbol` as a tiny stub ("???") and rely on `g_debug_info` in debug mode.
    // - Opt-in: set `OREN_NATIVE_RESOLVE_SYMBOL=1` to generate the full resolver (postmortem/debugging).
    var want_resolve_symbol = false
    var env_rs = oren_env("OREN_NATIVE_RESOLVE_SYMBOL")
    if env_rs != nil && env_rs == "1" { want_resolve_symbol = true }

    if want_resolve_symbol {
        // NOTE: resolve_symbol must match the actual static __TEXT base + header size used by the emitters.
        //
        // Mach-O emitter uses:
        //   text_base=0x100000000, header_size=2048
        // so the first instruction is at 0x100000000 + 2048.
        var base_addr = 4294969344
        if ctx["platform"]["os"] == "linux" {
            base_addr = 4194304 + 120 // 0x400000 + 120 (ELF header approx, need verify)
        }

        // Build list of {off:int, name:string} and sort descending by off.
        // This ensures resolve_symbol picks the closest preceding function.
        //
        // NOTE (rtobj + debug):
        // When we use a cached compiled runtime object, we do not have a runtime AST program to
        // scan here. Instead, use the final `ctx["functions"]` map as the source of truth.
        var sym_entries = []
        var sym_seen = {}

        // Pseudo-symbol for the unlabeled entry stub.
        _arm64_sym_entries_push_unique(sym_seen, sym_entries, 0, "__entry_stub__")

        // Prefer an explicit __top_level__ entry if present.
        var top_off = ctx["functions"]["__top_level__"]
        if top_off != nil { _arm64_sym_entries_push_unique(sym_seen, sym_entries, top_off, "__top_level__") }

        // All compiled symbols (runtime + user + wrappers).
        var j = 0
        var pair = [nil, nil]
        while 1 {
            var ok = oren_iter_next_entry(ctx["functions"], j, pair)
            if ok == 0 { break }
            var nm = pair[0]
            var off = pair[1]
            _arm64_sym_entries_push_unique(sym_seen, sym_entries, off, nm)
            j = j + 1
        }

        // Insertion sort (descending by off). Small N; keep it simple and deterministic.
        var si = 1
        while si < oren_list_len(sym_entries) {
            var key = sym_entries[si]
            var k_off = key["off"]
            var k = si - 1
            while k >= 0 {
                if sym_entries[k]["off"] >= k_off { break }
                sym_entries[k + 1] = sym_entries[k]
                k = k - 1
            }
            sym_entries[k + 1] = key
            si = si + 1
        }

        // PERF (critical for stage2-native):
        // Avoid quadratic `sym_src = sym_src + ...` concatenation when the runtime contributes
        // many symbols. Build a parts list and join once.
        var sym_parts = []
        oren_list_push(sym_parts, "fn resolve_symbol(addr) { var off = addr - ")
        oren_list_push(sym_parts, oren_int_to_string(base_addr))
        oren_list_push(sym_parts, " ")
        j = 0
        while j < oren_list_len(sym_entries) {
            var e = sym_entries[j]
            oren_list_push(sym_parts, "if off >= ")
            oren_list_push(sym_parts, oren_int_to_string(e["off"]))
            oren_list_push(sym_parts, " { return ")
            oren_list_push(sym_parts, token.CH_QUOTE)
            oren_list_push(sym_parts, e["name"])
            oren_list_push(sym_parts, token.CH_QUOTE)
            oren_list_push(sym_parts, " } ")
            j = j + 1
        }
        oren_list_push(sym_parts, "return \"???\" }")
        var sym_src = oren_string_join(sym_parts)

        if trace { print("[arm64] generating resolve_symbol...") }
        var l_sym = lexer.new_lexer(sym_src)
        l_sym["file"] = "<native:symbol_table>"
        var p_sym = parser.new_parser(l_sym)
        var prog_sym = parser.parse_program(p_sym)
        if oren_list_len(prog_sym["statements"]) > 0 {
            native_compile_stmt(ctx, prog_sym["statements"][0])
        } else {
            print("native backend: failed to compile resolve_symbol")
            // print(sym_src) // Debug
        }
    } else {
        // Minimal stub to satisfy native runtime stack traces without inflating binaries.
        // (Non-debug builds only need a valid symbol; names can be "???".)
        var sym_src2 = "fn resolve_symbol(addr) { return \"???\" }"
        var l_sym2 = lexer.new_lexer(sym_src2)
        l_sym2["file"] = "<native:symbol_table>"
        var p_sym2 = parser.new_parser(l_sym2)
        var prog_sym2 = parser.parse_program(p_sym2)
        if oren_list_len(prog_sym2["statements"]) > 0 {
            native_compile_stmt(ctx, prog_sym2["statements"][0])
        } else {
            print("native backend: failed to compile resolve_symbol stub")
        }
    }

    if trace {
        var dt_all = (oren_time_now_ns() - t_enter) / 1000000
        print("[arm64] native_compile_program_arm64: done +" + oren_int_to_string(dt_all) + "ms")
    }

    // Finalize the embedded-string literal table after all codegen so it includes:
    // - user literals
    // - injected runtime literals
    // - backend-emitted literal cstrs (diagnostics, etc)
    var slot_enc2 = ctx["cstr0_table_slot_enc"]
    if slot_enc2 != nil {
        var slot_off2 = slot_enc2 - 1
        var offs = ctx["cstr0_list"]
        if offs == nil { offs = [] }
        while int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
        var table_off2 = bytes_len(ctx["data"])
        // Layout: [table_off][count][offs...]
        push_u64_le(ctx["data"], table_off2)
        push_u64_le(ctx["data"], oren_list_len(offs))
        var ii = 0
        while ii < oren_list_len(offs) {
            push_u64_le(ctx["data"], offs[ii])
            ii = ii + 1
        }
        // Write table_off into reserved slot as u64 (lo32/hi32).
        set_u32_le(ctx["data"], slot_off2 + 0, int_mod(table_off2, 4294967296))
        set_u32_le(ctx["data"], slot_off2 + 4, 0)
    }

    return ctx
}

// NOTE: Mach-O/ELF emitters were refactored into:
// - lib/compiler/arm64_macho.oren
// - lib/compiler/arm64_elf.oren
