fn _arm64_inverse_cond(cond) {
    if cond == 0 { return 1 }   // EQ -> NE
    if cond == 1 { return 0 }   // NE -> EQ
    if cond == 4 { return 5 }   // MI -> PL
    if cond == 10 { return 11 } // GE -> LT
    if cond == 11 { return 10 } // LT -> GE
    if cond == 12 { return 13 } // GT -> LE
    if cond == 13 { return 12 } // LE -> GT
    return 1
}

fn _arm64_cmp_cond_code(op, floaty) {
    if op == "==" { return 0 }
    if op == "!=" { return 1 }
    if op == "<"  { if floaty == true { return 4 } else { return 11 } }
    if op == ">"  { return 12 }
    if op == "<=" { return 13 }
    if op == ">=" { return 10 }
    return nil
}

fn _arm64_swapped_cmp_op(op) {
    if op == "<" { return ">" }
    if op == ">" { return "<" }
    if op == "<=" { return ">=" }
    if op == ">=" { return "<=" }
    return op
}

fn _arm64_singleton_offset(expr) {
    if expr == nil { return nil }
    if expr["type"] == "Nil" { return 368 }
    if expr["type"] == "Boolean" {
        if expr["value"] == true { return 384 }
        return 376
    }
    return nil
}

fn _arm64_emit_load_singleton_ptr(ctx, tok, reg, off) {
    rt._arm64_emit_load_g_storage_ptr(ctx, tok, reg)
    push_u32_le(ctx["code"], insn_ldr_ptr_off(reg, reg, off))
    return nil
}

fn _arm64_direct_call_name(expr) {
    if expr == nil || expr["type"] != "Call" { return nil }
    var fnn = expr["fn"]
    if fnn != nil && fnn["type"] == "Identifier" { return fnn["value"] }
    return nil
}

fn _arm64_direct_call_returns_known_bool(nm) {
    if nm == nil { return false }
    if nm == "oren_is_err" { return true }
    if nm == "_oren_generator_is_handle" { return true }
    if nm == "_oren_generator_is_context" { return true }
    if nm == "_oren_generator_started" { return true }
    if nm == "_oren_generator_done" { return true }
    if nm == "_oren_generator_closed" { return true }
    if nm == "_oren_generator_cancel_requested" { return true }
    if nm == "oren_generator_is_started" { return true }
    if nm == "oren_generator_is_done" { return true }
    if nm == "oren_generator_is_closed" { return true }
    if nm == "oren_generator_is_cancel_requested" { return true }
    return false
}

fn _arm64_expr_known_nonfloat_for_literal_cmp(ctx, expr) {
    if expr == nil { return false }
    var et = expr["type"]
    if et == "Nil" || et == "Boolean" || et == "Integer" || et == "String" { return true }
    var nm = _arm64_direct_call_name(expr)
    if _arm64_direct_call_returns_known_bool(nm) == true { return true }
    if nm != nil && ctx != nil && ctx["func_ret_kinds"] != nil {
        var rk = ctx["func_ret_kinds"][nm]
        if rk != nil { return exprm.native_kind_name_is_float(rk) != true }
    }
    return false
}

fn _arm64_emit_singleton_if_branch_false(ctx, tok, op, l, r) {
    if op != "==" && op != "!=" { return nil }
    var l_singleton = _arm64_singleton_offset(l)
    var r_singleton = _arm64_singleton_offset(r)
    if l_singleton == nil && r_singleton == nil { return nil }

    var true_cond = _arm64_cmp_cond_code(op, false)
    if true_cond == nil { return nil }

    if r_singleton != nil {
        // Known float values intentionally stay on the generic numeric compare path.
        if _arm64_expr_known_nonfloat_for_literal_cmp(ctx, l) != true {
            if exprm.native_expr_is_floaty(ctx, l) == true { return nil }
        }
        native_compile_expr(ctx, l)
        _arm64_emit_load_singleton_ptr(ctx, tok, 1, r_singleton)
        push_u32_le(ctx["code"], insn_cmp_reg(0, 1))
        var jump_false_rsingleton = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        return _arm64_branch_false_result(jump_false_rsingleton, _arm64_inverse_cond(true_cond))
    }

    if l_singleton != nil {
        // Known float values intentionally stay on the generic numeric compare path.
        if _arm64_expr_known_nonfloat_for_literal_cmp(ctx, r) != true {
            if exprm.native_expr_is_floaty(ctx, r) == true { return nil }
        }
        native_compile_expr(ctx, r)
        _arm64_emit_load_singleton_ptr(ctx, tok, 1, l_singleton)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 0))
        var jump_false_lsingleton = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        return _arm64_branch_false_result(jump_false_lsingleton, _arm64_inverse_cond(true_cond))
    }

    return nil
}

fn _arm64_int_lit_value(expr) {
    if expr == nil || expr["type"] != "Integer" { return nil }
    return intparse.parse_int_lit(expr["value"])
}

fn _arm64_cmp_may_use_strcmp_known(ctx, left, right, ls, rs) {
    var l_is_nil = false
    var r_is_nil = false
    if left != nil && left["type"] == "Nil" { l_is_nil = true }
    if right != nil && right["type"] == "Nil" { r_is_nil = true }
    if l_is_nil == true || r_is_nil == true { return false }

    if ls == true && rs == true { return true }

    if ls == true && right != nil {
        var rt = right["type"]
        if rt != "Integer" && rt != "Float" && rt != "Boolean" { return true }
    }
    if rs == true && left != nil {
        var lt = left["type"]
        if lt != "Integer" && lt != "Float" && lt != "Boolean" { return true }
    }

    var l_lit = false
    var r_lit = false
    if left != nil && left["type"] == "String" { l_lit = true }
    if right != nil && right["type"] == "String" { r_lit = true }
    if l_lit != true && r_lit != true { return false }

    var other = left
    if l_lit == true { other = right }
    if other == nil { return false }
    var ot = other["type"]
    if ot == "Integer" || ot == "Float" || ot == "Boolean" { return false }
    return true
}

fn _arm64_cmp_may_use_strcmp(ctx, left, right) {
    var ls = exprm.native_expr_is_stringy(ctx, left)
    var rs = exprm.native_expr_is_stringy(ctx, right)
    return _arm64_cmp_may_use_strcmp_known(ctx, left, right, ls, rs)
}

fn _arm64_int_lit_fits_cmp_imm(v) {
    if v == nil { return false }
    if v < 0 || v > 4095 { return false }
    return true
}

fn _arm64_emit_int_lit_if_branch_false(ctx, op, l, r) {
    var r_imm = _arm64_int_lit_value(r)
    if r_imm != nil {
        // Known float values intentionally stay on the generic numeric compare path.
        if _arm64_expr_known_nonfloat_for_literal_cmp(ctx, l) != true {
            if exprm.native_expr_is_floaty(ctx, l) == true { return nil }
        }
        var true_cond_r = _arm64_cmp_cond_code(op, false)
        if true_cond_r == nil { return nil }
        native_compile_expr(ctx, l)
        if _arm64_int_lit_fits_cmp_imm(r_imm) == true {
            push_u32_le(ctx["code"], insn_subs_imm(31, 0, r_imm)) // CMP X0, #imm
        } else {
            emit_load_i64_imm(ctx, 1, r_imm)
            push_u32_le(ctx["code"], insn_cmp_reg(0, 1))
        }
        var jump_false_rimm = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        return _arm64_branch_false_result(jump_false_rimm, _arm64_inverse_cond(true_cond_r))
    }

    var l_imm = _arm64_int_lit_value(l)
    if l_imm != nil {
        // Known float values intentionally stay on the generic numeric compare path.
        if _arm64_expr_known_nonfloat_for_literal_cmp(ctx, r) != true {
            if exprm.native_expr_is_floaty(ctx, r) == true { return nil }
        }
        if _arm64_int_lit_fits_cmp_imm(l_imm) == true {
            var swapped_cond = _arm64_cmp_cond_code(_arm64_swapped_cmp_op(op), false)
            if swapped_cond == nil { return nil }
            native_compile_expr(ctx, r)
            push_u32_le(ctx["code"], insn_subs_imm(31, 0, l_imm)) // CMP X0, #imm
            var jump_false_limm = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            return _arm64_branch_false_result(jump_false_limm, _arm64_inverse_cond(swapped_cond))
        }
        var true_cond_l = _arm64_cmp_cond_code(op, false)
        if true_cond_l == nil { return nil }
        native_compile_expr(ctx, r)
        emit_load_i64_imm(ctx, 1, l_imm)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 0))
        var jump_false_limm2 = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        return _arm64_branch_false_result(jump_false_limm2, _arm64_inverse_cond(true_cond_l))
    }

    return nil
}

fn _arm64_branch_false_result(pos, cond) {
    return {"pos": pos, "cond": cond, "jumps": [{"pos": pos, "cond": cond}]}
}

fn _arm64_append_branch_false_jumps(out, br) {
    if br == nil { return out }
    var jumps = br["jumps"]
	    if jumps != nil {
	        var i = 0
	        var n = oren_list_len(jumps)
	        while i < n {
	            oren_list_push(out, jumps[i])
	            i = i + 1
	        }
        return out
    }
    oren_list_push(out, {"pos": br["pos"], "cond": br["cond"]})
    return out
}

fn _arm64_append_inverted_branch_jumps(out, br) {
    if br == nil { return out }
    var jumps = br["jumps"]
    if jumps != nil {
        var i = 0
        var n = oren_list_len(jumps)
        while i < n {
            var j = jumps[i]
            oren_list_push(out, {"pos": j["pos"], "cond": _arm64_inverse_cond(j["cond"])})
            i = i + 1
        }
        return out
    }
    oren_list_push(out, {"pos": br["pos"], "cond": _arm64_inverse_cond(br["cond"])})
    return out
}

fn _arm64_branch_false_jump_count(br) {
    if br == nil { return 0 }
    var jumps = br["jumps"]
    if jumps != nil { return oren_list_len(jumps) }
    if br["pos"] != nil { return 1 }
    return 0
}

fn _arm64_patch_branch_false_jumps(ctx, br, target) {
    if br == nil { return nil }
    var jumps = br["jumps"]
	    if jumps != nil {
	        var i = 0
	        var n = oren_list_len(jumps)
	        while i < n {
	            var j = jumps[i]
	            set_u32_le(ctx["code"], j["pos"], insn_b_cond((target - j["pos"]) / 4, j["cond"]))
	            i = i + 1
        }
        return nil
    }
    set_u32_le(ctx["code"], br["pos"], insn_b_cond((target - br["pos"]) / 4, br["cond"]))
    return nil
}

fn _arm64_collect_logical_terms(expr, op, out) {
    if expr != nil && expr["type"] == "Infix" && _arm64_str_eq_bytes(expr["op"], op) == true {
        _arm64_collect_logical_terms(expr["left"], op, out)
        _arm64_collect_logical_terms(expr["right"], op, out)
        return out
    }
    oren_list_push(out, expr)
    return out
}

fn _arm64_emit_any_cond_branch_false(ctx, cond, tok, base_stack) {
    var direct = _arm64_emit_if_cond_branch_false(ctx, cond, tok)
    var delta = ctx["stack_size"] - base_stack
    if delta != 0 { _arm64_restore_stack_to(ctx, base_stack) }
    if direct != nil { return direct }

    native_compile_expr(ctx, cond)
    _arm64_emit_truthy_norm_in_x0(ctx, tok)
    var delta2 = ctx["stack_size"] - base_stack
    if delta2 != 0 { _arm64_restore_stack_to(ctx, base_stack) }
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jump_false = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    return _arm64_branch_false_result(jump_false, 0)
}

fn _arm64_emit_if_cond_branch_false(ctx, cond, tok) {
    if cond == nil || cond["type"] != "Infix" { return nil }
    var op = cond["op"]
    var l = cond["left"]
    var r = cond["right"]

    if op == "&&" {
        var base_stack_and = ctx["stack_size"]
	        var and_terms = []
	        _arm64_collect_logical_terms(cond, "&&", and_terms)
	        var and_n = oren_list_len(and_terms)
	        var and_jumps = []
	        var ai = 0
	        while ai < and_n {
	            var term_false = _arm64_emit_any_cond_branch_false(ctx, and_terms[ai], tok, base_stack_and)
	            _arm64_append_branch_false_jumps(and_jumps, term_false)
	            ai = ai + 1
	        }
	        var and_jump_n = oren_list_len(and_jumps)
	        if and_jump_n <= 0 { return nil }
	        return {"pos": and_jumps[0]["pos"], "cond": and_jumps[0]["cond"], "jumps": and_jumps}
    }
    if op == "||" {
        var base_stack_or = ctx["stack_size"]
        var or_terms = []
        _arm64_collect_logical_terms(cond, "||", or_terms)
        var or_n = oren_list_len(or_terms)
        if or_n <= 0 { return nil }
        var true_cond_jumps = []
        var true_uncond_jumps = []
        var last_false = nil
        var oi = 0
        while oi < or_n {
            if oi + 1 < or_n {
                var term_false = _arm64_emit_any_cond_branch_false(ctx, or_terms[oi], tok, base_stack_or)
                // Inverting a single false placeholder is equivalent to branching on
                // term-true. Composite terms such as "a && b" carry several false exits;
                // inverting them independently would turn the conjunction into a
                // disjunction, so those terms use the older unconditional-true bridge.
                if _arm64_branch_false_jump_count(term_false) == 1 {
                    _arm64_append_inverted_branch_jumps(true_cond_jumps, term_false)
                } else {
                    var jump_true = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(true_uncond_jumps, jump_true)
                    var next_term_pos = bytes_len(ctx["code"])
                    _arm64_patch_branch_false_jumps(ctx, term_false, next_term_pos)
                }
            } else {
                last_false = _arm64_emit_any_cond_branch_false(ctx, or_terms[oi], tok, base_stack_or)
            }
            oi = oi + 1
        }
        var then_pos_or = bytes_len(ctx["code"])
        var ti = 0
        var true_cond_n = oren_list_len(true_cond_jumps)
        while ti < true_cond_n {
            var tj = true_cond_jumps[ti]
            set_u32_le(ctx["code"], tj["pos"], insn_b_cond((then_pos_or - tj["pos"]) / 4, tj["cond"]))
            ti = ti + 1
        }
        var ui = 0
        var true_uncond_n = oren_list_len(true_uncond_jumps)
        while ui < true_uncond_n {
            var up = true_uncond_jumps[ui]
            set_u32_le(ctx["code"], up, insn_b((then_pos_or - up) / 4))
            ui = ui + 1
        }
        return last_false
    }

    var singleton_branch = _arm64_emit_singleton_if_branch_false(ctx, tok, op, l, r)
    if singleton_branch != nil { return singleton_branch }
    var int_lit_branch = _arm64_emit_int_lit_if_branch_false(ctx, op, l, r)
    if int_lit_branch != nil { return int_lit_branch }

    var left_stringy = exprm.native_expr_is_stringy(ctx, l)
    var right_stringy = exprm.native_expr_is_stringy(ctx, r)
    var string_cmp = false
    if left_stringy == true || right_stringy == true { string_cmp = true }

    if string_cmp == true {
        var true_cond_string = _arm64_cmp_cond_code(op, false)
        if true_cond_string == nil { return nil }
        var allow_strcmp = _arm64_cmp_may_use_strcmp_known(ctx, l, r, left_stringy, right_stringy)
        native_compile_expr(ctx, l)
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16
        native_compile_expr(ctx, r)
        push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16

        if allow_strcmp == true {
            // Runtime safety guard mirrors expression lowering: native values are untagged, so
            // values below the first page are treated as non-strings and use integer comparison.
            push_u32_le(ctx["code"], insn_movz(3, 4096))
            push_u32_le(ctx["code"], insn_cmp_reg(1, 3))
            var br_lt_left = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], insn_cmp_reg(0, 3))
            var br_lt_right = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)

            push_u32_le(ctx["code"], insn_mov_reg(2, 0))
            push_u32_le(ctx["code"], insn_mov_reg(0, 1))
            push_u32_le(ctx["code"], insn_mov_reg(1, 2))
            var bl_strcmp = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_strcmp, "name": "strcmp"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_strcmp)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "strcmp")
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            var jump_false_string = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            var jump_end_string = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)

            var int_compare_pos = bytes_len(ctx["code"])
            set_u32_le(ctx["code"], br_lt_left, insn_b_cond((int_compare_pos - br_lt_left) / 4, 11))
            set_u32_le(ctx["code"], br_lt_right, insn_b_cond((int_compare_pos - br_lt_right) / 4, 11))
            push_u32_le(ctx["code"], insn_cmp_reg(1, 0))
            var jump_false_int = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)

            var done_compare_pos = bytes_len(ctx["code"])
            set_u32_le(ctx["code"], jump_end_string, insn_b((done_compare_pos - jump_end_string) / 4))
            var false_jumps = [
                {"pos": jump_false_string, "cond": _arm64_inverse_cond(true_cond_string)},
                {"pos": jump_false_int, "cond": _arm64_inverse_cond(true_cond_string)}
            ]
            return {"pos": jump_false_string, "cond": _arm64_inverse_cond(true_cond_string), "jumps": false_jumps}
        }

        push_u32_le(ctx["code"], insn_cmp_reg(1, 0))
        var jump_false_string_int = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        return _arm64_branch_false_result(jump_false_string_int, _arm64_inverse_cond(true_cond_string))
    }

    var left_floaty = exprm.native_expr_is_floaty(ctx, l)
    var right_floaty = exprm.native_expr_is_floaty(ctx, r)
    var floaty = false
    if left_floaty == true || right_floaty == true { floaty = true }
    var true_cond = _arm64_cmp_cond_code(op, floaty)
    if true_cond == nil { return nil }

    native_compile_expr(ctx, l)
    push_u32_le(ctx["code"], insn_sub_sp(16))
    push_u32_le(ctx["code"], insn_str_x0_sp(0))
    ctx["stack_size"] = ctx["stack_size"] + 16
    native_compile_expr(ctx, r)
    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
    push_u32_le(ctx["code"], insn_add_sp(16))
    ctx["stack_size"] = ctx["stack_size"] - 16

    if floaty != true && (op == "==" || op == "!=") && exprm.native_expr_needs_dynamic_string_eq(ctx, l, r) == true {
        push_u32_le(ctx["code"], insn_mov_reg(19, 1)) // save left
        push_u32_le(ctx["code"], insn_mov_reg(20, 0)) // save right
        push_u32_le(ctx["code"], insn_mov_reg(0, 19))
        push_u32_le(ctx["code"], insn_mov_reg(1, 20))
        exprm.native_emit_named_bl_expr(ctx, "oren_string_eq")

        rt._arm64_emit_load_g_storage_ptr(ctx, tok, 2)
        push_u32_le(ctx["code"], insn_ldr_ptr_off(2, 2, 384)) // X2 = true
        push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
        var br_dynamic_string_eq_singleton = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // B.EQ -> dynamic string equal
        push_u32_le(ctx["code"], insn_movz(3, 1))
        push_u32_le(ctx["code"], insn_cmp_reg(0, 3))
        var br_not_dynamic_string_eq = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // B.NE -> raw compare fallback

        var dynamic_string_eq_pos = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], br_dynamic_string_eq_singleton, insn_b_cond((dynamic_string_eq_pos - br_dynamic_string_eq_singleton) / 4, 0)) // EQ
        var false_jumps_dyn = []
        if op == "!=" {
            push_u32_le(ctx["code"], insn_cmp_reg(31, 31))
            var jump_false_dynamic = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(false_jumps_dyn, {"pos": jump_false_dynamic, "cond": 0})
        }
        var jump_end_dynamic = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)

        var dynamic_string_fallback = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], br_not_dynamic_string_eq, insn_b_cond((dynamic_string_fallback - br_not_dynamic_string_eq) / 4, 1)) // NE
        push_u32_le(ctx["code"], insn_mov_reg(1, 19))
        push_u32_le(ctx["code"], insn_mov_reg(0, 20))
        push_u32_le(ctx["code"], insn_cmp_reg(1, 0))
        var jump_false_int = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(false_jumps_dyn, {"pos": jump_false_int, "cond": _arm64_inverse_cond(true_cond)})

        var done_dynamic_string_compare = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], jump_end_dynamic, insn_b((done_dynamic_string_compare - jump_end_dynamic) / 4))
        return {"pos": false_jumps_dyn[0]["pos"], "cond": false_jumps_dyn[0]["cond"], "jumps": false_jumps_dyn}
    }

    if floaty == true {
        if left_floaty == true { push_u32_le(ctx["code"], exprm.insn_fmov_d_x(0, 1)) }
        else { push_u32_le(ctx["code"], exprm.insn_scvtf(0, 1)) }
        if right_floaty == true { push_u32_le(ctx["code"], exprm.insn_fmov_d_x(1, 0)) }
        else { push_u32_le(ctx["code"], exprm.insn_scvtf(1, 0)) }
        push_u32_le(ctx["code"], exprm.insn_fcmp(0, 1))
    } else {
        push_u32_le(ctx["code"], insn_cmp_reg(1, 0))
    }

    var jump_false = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    return _arm64_branch_false_result(jump_false, _arm64_inverse_cond(true_cond))
}



fn _arm64_str_eq_bytes(a, b) {
    // Stable string equality for compiler passes.
    // Avoid depending on runtime `==` semantics (stage1 C runtime vs stage2 native runtime).
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _arm64_is_ident(exp) {
    if exp == nil { return nil }
    if exp["type"] == "Identifier" { return exp["value"] }
    return nil
}

fn _arm64_local_fp_off(ctx, name) {
    if ctx == nil { return nil }
    if ctx["locals"] == nil { return nil }
    var enc = ctx["locals"][name]
    if oren_type_tag(enc) == 0 { return nil }
    return enc - 1
}

fn _arm64_is_simple_inc(stmt, idx_name) {
    if stmt == nil || stmt["type"] != "Assign" { return false }
    if stmt["name"] == nil || stmt["name"]["type"] != "Identifier" { return false }
    if _arm64_str_eq_bytes(stmt["name"]["value"], idx_name) != true { return false }
    var v = stmt["value"]
    if v == nil || v["type"] != "Infix" { return false }
    if v["op"] != "+" { return false }
    var left = _arm64_is_ident(v["left"])
    if left == nil || _arm64_str_eq_bytes(left, idx_name) != true { return false }
    if v["right"] == nil || v["right"]["type"] != "Integer" { return false }
    if v["right"]["value"] != "1" { return false }
    return true
}

fn _arm64_list_contains(xs, value) {
    if xs == nil { return false }
    var i = 0
    var n = oren_list_len(xs)
    while i < n {
        if _arm64_str_eq_bytes(xs[i], value) { return true }
        i = i + 1
    }
    return false
}

fn _arm64_expr_uses_ident(exp, name) {
    if exp == nil || name == nil { return false }
    var et = exp["type"]
    if et == "Identifier" { return _arm64_str_eq_bytes(exp["value"], name) }
    if et == "Integer" || et == "Float" || et == "String" || et == "Boolean" || et == "Nil" { return false }
    if et == "Prefix" { return _arm64_expr_uses_ident(exp["right"], name) }
    if et == "Infix" {
        if _arm64_expr_uses_ident(exp["left"], name) { return true }
        return _arm64_expr_uses_ident(exp["right"], name)
    }
    if et == "Call" {
        if _arm64_expr_uses_ident(exp["fn"], name) { return true }
        var args = exp["args"]
        var i = 0
        var n = oren_list_len(args)
        while i < n {
            if _arm64_expr_uses_ident(args[i], name) { return true }
            i = i + 1
        }
        return false
    }
    if et == "Member" {
        return _arm64_expr_uses_ident(exp["left"], name)
    }
    if et == "Index" {
        if _arm64_expr_uses_ident(exp["left"], name) { return true }
        return _arm64_expr_uses_ident(exp["index"], name)
    }
    if et == "Array" {
        var xs = exp["elements"]
        var j = 0
        var xn = oren_list_len(xs)
        while j < xn {
            if _arm64_expr_uses_ident(xs[j], name) { return true }
            j = j + 1
        }
        return false
    }
    if et == "Hash" {
        var ps = exp["pairs"]
        var k = 0
        var pn = oren_list_len(ps)
        while k < pn {
            if _arm64_expr_uses_ident(ps[k]["key"], name) { return true }
            if _arm64_expr_uses_ident(ps[k]["value"], name) { return true }
            k = k + 1
        }
        return false
    }
    if et == "If" || et == "Function" { return true }
    return true
}

fn _arm64_expr_uses_any_ident(exp, names) {
    if exp == nil || names == nil { return false }
    var i = 0
    var n = oren_list_len(names)
    while i < n {
        if _arm64_expr_uses_ident(exp, names[i]) { return true }
        i = i + 1
    }
    return false
}

fn _arm64_parse_int_lit_expr(expr) {
    if expr == nil || expr["type"] != "Integer" { return nil }
    var v = intparse.parse_int_lit(expr["value"])
    if oren_is_err(v) == true { return nil }
    return v
}

fn _arm64_match_mul_const(expr, name) {
    if expr == nil || expr["type"] != "Infix" || expr["op"] != "*" { return nil }
    var left = expr["left"]
    var right = expr["right"]
    var left_name = _arm64_is_ident(left)
    if left_name != nil && _arm64_str_eq_bytes(left_name, name) {
        return _arm64_parse_int_lit_expr(right)
    }
    var right_name = _arm64_is_ident(right)
    if right_name != nil && _arm64_str_eq_bytes(right_name, name) {
        return _arm64_parse_int_lit_expr(left)
    }
    return nil
}

fn _arm64_collect_add_terms(expr, out) {
    if expr == nil { return out }
    if expr["type"] == "Infix" && expr["op"] == "+" {
        out = _arm64_collect_add_terms(expr["left"], out)
        out = _arm64_collect_add_terms(expr["right"], out)
        return out
    }
    oren_list_push(out, expr)
    return out
}

fn _arm64_match_mod_term(expr, name) {
    if expr == nil || expr["type"] != "Infix" || expr["op"] != "%" { return nil }
    var left_name = _arm64_is_ident(expr["left"])
    if left_name == nil || _arm64_str_eq_bytes(left_name, name) != true { return nil }
    var modv = _arm64_parse_int_lit_expr(expr["right"])
    if modv == nil || modv <= 0 { return nil }
    return modv
}

fn _arm64_match_lcg_update(stmt, x_name) {
    if stmt == nil || stmt["type"] != "Assign" { return nil }
    var name = _arm64_is_ident(stmt["name"])
    if name == nil || _arm64_str_eq_bytes(name, x_name) != true { return nil }
    var val = stmt["value"]
    if val == nil || val["type"] != "Infix" || val["op"] != "%" { return nil }
    var mod_expr = val["right"]
    var mod_name = _arm64_is_ident(mod_expr)
    var mod_const = nil
    if mod_name == nil {
        mod_const = _arm64_parse_int_lit_expr(mod_expr)
        if mod_const == nil { return nil }
    }
    var left = val["left"]
    if left == nil || left["type"] != "Infix" || left["op"] != "+" { return nil }
    var mul = _arm64_match_mul_const(left["left"], x_name)
    var add = _arm64_parse_int_lit_expr(left["right"])
    if mul == nil || add == nil {
        mul = _arm64_match_mul_const(left["right"], x_name)
        add = _arm64_parse_int_lit_expr(left["left"])
    }
    if mul == nil || add == nil { return nil }
    return {"mul": mul, "add": add, "mod": mod_name, "mod_const": mod_const}
}

fn _arm64_match_sum_mod_update(stmt, sum_name, x_name, idx_name, mod_name, mod_const) {
    if stmt == nil || stmt["type"] != "Assign" { return nil }
    var name = _arm64_is_ident(stmt["name"])
    if name == nil || _arm64_str_eq_bytes(name, sum_name) != true { return nil }
    var val = stmt["value"]
    if val == nil || val["type"] != "Infix" || val["op"] != "%" { return nil }
    var mod_ok = false
    var mod_rhs = _arm64_is_ident(val["right"])
    if mod_rhs != nil && mod_name != nil && _arm64_str_eq_bytes(mod_rhs, mod_name) == true { mod_ok = true }
    if mod_ok != true && mod_const != nil {
        var mod_lit = _arm64_parse_int_lit_expr(val["right"])
        if mod_lit != nil && mod_lit == mod_const { mod_ok = true }
    }
    if mod_ok != true { return nil }
    var terms = []
    _arm64_collect_add_terms(val["left"], terms)
    if oren_list_len(terms) != 3 { return nil }
    var saw_sum = false
    var mod_x = nil
    var mod_i = nil
    var ti = 0
    while ti < oren_list_len(terms) {
        var t = terms[ti]
        var tname = _arm64_is_ident(t)
        if tname != nil && _arm64_str_eq_bytes(tname, sum_name) {
            saw_sum = true
            ti = ti + 1
            continue
        }
        var mx = _arm64_match_mod_term(t, x_name)
        if mx != nil {
            if mod_x != nil { return nil }
            mod_x = mx
            ti = ti + 1
            continue
        }
        var mi = _arm64_match_mod_term(t, idx_name)
        if mi != nil {
            if mod_i != nil { return nil }
            mod_i = mi
            ti = ti + 1
            continue
        }
        return nil
    }
    if saw_sum != true || mod_x == nil || mod_i == nil { return nil }
    return {"mod_x": mod_x, "mod_i": mod_i}
}

fn _arm64_match_fast_lcg_sum_while(ctx, stmt) {
    if stmt == nil || stmt["type"] != "While" { return nil }
    var cond = stmt["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _arm64_is_ident(cond["left"])
    var n_name = _arm64_is_ident(cond["right"])
    if idx_name == nil || n_name == nil { return nil }
    if _arm64_local_fp_off(ctx, idx_name) == nil { return nil }
    if _arm64_local_fp_off(ctx, n_name) == nil { return nil }
    if exprm.native_expr_is_inty(ctx, {"type": "Identifier", "value": idx_name}) != true { return nil }
    if exprm.native_expr_is_inty(ctx, {"type": "Identifier", "value": n_name}) != true { return nil }
    var body = stmt["body"]
    if body == nil || body["type"] != "Block" { return nil }
    var stmts = body["stmts"]
    if stmts == nil || oren_list_len(stmts) != 3 { return nil }

    var lcg_stmt = stmts[0]
    var sum_stmt = stmts[1]
    var inc_stmt = stmts[2]

    if _arm64_is_simple_inc(inc_stmt, idx_name) != true { return nil }

    if lcg_stmt == nil || lcg_stmt["type"] != "Assign" { return nil }
    var x_name = _arm64_is_ident(lcg_stmt["name"])
    if x_name == nil || _arm64_str_eq_bytes(x_name, idx_name) || _arm64_str_eq_bytes(x_name, n_name) { return nil }
    if _arm64_local_fp_off(ctx, x_name) == nil { return nil }
    if exprm.native_expr_is_inty(ctx, {"type": "Identifier", "value": x_name}) != true { return nil }

    var lcg = _arm64_match_lcg_update(lcg_stmt, x_name)
    if lcg == nil { return nil }
    var mod_name = lcg["mod"]
    var mod_const = lcg["mod_const"]
    if mod_name != nil {
        if _arm64_str_eq_bytes(mod_name, idx_name) || _arm64_str_eq_bytes(mod_name, n_name) || _arm64_str_eq_bytes(mod_name, x_name) { return nil }
        if _arm64_local_fp_off(ctx, mod_name) == nil { return nil }
        if exprm.native_expr_is_inty(ctx, {"type": "Identifier", "value": mod_name}) != true { return nil }
    } else {
        if mod_const == nil || mod_const <= 0 { return nil }
    }

    if sum_stmt == nil || sum_stmt["type"] != "Assign" { return nil }
    var sum_name = _arm64_is_ident(sum_stmt["name"])
    if sum_name == nil { return nil }
    if _arm64_str_eq_bytes(sum_name, idx_name) || _arm64_str_eq_bytes(sum_name, n_name) || _arm64_str_eq_bytes(sum_name, x_name) { return nil }
    if _arm64_local_fp_off(ctx, sum_name) == nil { return nil }
    if exprm.native_expr_is_inty(ctx, {"type": "Identifier", "value": sum_name}) != true { return nil }

    var sum_info = _arm64_match_sum_mod_update(sum_stmt, sum_name, x_name, idx_name, mod_name, mod_const)
    if sum_info == nil { return nil }
    if exprm.native_expr_is_inty(ctx, sum_stmt["value"]) != true { return nil }

    return {
        "idx": idx_name,
        "n": n_name,
        "x": x_name,
        "sum": sum_name,
        "mod": mod_name,
        "mod_const": mod_const,
        "mul": lcg["mul"],
        "add": lcg["add"],
        "mod_x": sum_info["mod_x"],
        "mod_i": sum_info["mod_i"]
    }
}

fn _arm64_fastmod_recip_u64(d) {
    if d == nil { return nil }
    if d < 3 { return nil }
    // Keep math in signed i64 range: require d <= 2^31-1.
    if d > 2147483647 { return nil }
    var base = 4294967296
    var q1 = base / d
    var r1 = base - (q1 * d)
    var q0 = (r1 * base) / d
    return (q1 * base) + q0
}

fn _arm64_emit_fastmod_u64_const(ctx, n_reg, d_reg, recip, dst_reg, tmp_recip_reg, tmp_q_reg, tmp_t_reg) {
    if ctx == nil || recip == nil { return nil }
    emit_load_u64_imm(ctx, tmp_recip_reg, recip)
    push_u32_le(ctx["code"], insn_umulh(tmp_q_reg, n_reg, tmp_recip_reg))
    push_u32_le(ctx["code"], insn_mul(tmp_t_reg, tmp_q_reg, d_reg))
    push_u32_le(ctx["code"], insn_sub_reg(dst_reg, n_reg, tmp_t_reg))
    push_u32_le(ctx["code"], insn_cmp_reg(dst_reg, d_reg))
    var jpos_ok = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    push_u32_le(ctx["code"], insn_sub_reg(dst_reg, dst_reg, d_reg))
    var ok_pos = bytes_len(ctx["code"])
    var ok_off = (ok_pos - jpos_ok) / 4
    set_u32_le(ctx["code"], jpos_ok, insn_b_cond(ok_off, 11)) // LT
    return nil
}


fn _arm64_emit_fast_lcg_sum_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var x_name = info["x"]
    var sum_name = info["sum"]
    var mod_name = info["mod"]
    var mod_const = info["mod_const"]
    var mul = info["mul"]
    var add = info["add"]
    var mod_x = info["mod_x"]
    var mod_i = info["mod_i"]
    var sum_cap = mod_x + mod_i
    var mod_recip = nil
    var modx_recip = nil
    var modi_recip = nil
    var use_fastmod = false
    if mod_const != nil {
        mod_recip = _arm64_fastmod_recip_u64(mod_const)
        modx_recip = _arm64_fastmod_recip_u64(mod_x)
        modi_recip = _arm64_fastmod_recip_u64(mod_i)
        if mod_recip != nil && modx_recip != nil && modi_recip != nil { use_fastmod = true }
    }

    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var x_fp_off = _arm64_local_fp_off(ctx, x_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    var mod_fp_off = nil
    if mod_name != nil { mod_fp_off = _arm64_local_fp_off(ctx, mod_name) }
    if idx_fp_off == nil || n_fp_off == nil || x_fp_off == nil || sum_fp_off == nil {
        return _arm64_emit_while_generic(ctx, stmt)
    }
    if mod_name != nil && mod_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }
    if mod_name == nil && mod_const == nil { return _arm64_emit_while_generic(ctx, stmt) }
    if mod_name == nil && mod_const <= 0 { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    // Fast LCG-sum loops keep the throttled safepoint tick in registers on the hot path.
    // Keep the old dedicated stack tick slot only as an opt-in comparison/debug escape hatch.
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LCG_SUM_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LCG_SUM_TICK_MASK", 4095)
    var tick_period = gc.native_arm64_inline_tick_period(tick_mask)
    var slots = 6 // tick + i + n + x + sum + mod
    if !keep_tick_slot { slots = 5 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_lcg_sum_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_lcg_sum_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var x_off = slot0 + 16
    var sum_off = slot0 + 24
    var mod_off = slot0 + 32
    _arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    gc.native_emit_gc_inline_tick_init(ctx, tick_mask)
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }

    // load i/n/x/sum/mod locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, x_fp_off)
    emit_str_reg_sp_any(ctx, 0, x_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)
    if mod_name != nil {
        emit_ldr_reg_fp_any(ctx, 0, mod_fp_off)
        emit_str_reg_sp_any(ctx, 0, mod_off)
    } else {
        emit_load_i64_imm(ctx, 0, mod_const)
        emit_str_reg_sp_any(ctx, 0, mod_off)
    }

    var slow_jumps = []
    var slow_sum_jumps = []

    // mod <= 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, mod_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_mod_le = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_mod_le, "cond": 13}) // LE

    // i/n/x/sum < 0 => slow-sum path (signed semantics)
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_sum_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_sum_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT
    emit_ldr_reg_sp_any(ctx, 0, x_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_x_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_sum_jumps, {"pos": jpos_x_neg, "cond": 11}) // LT
    emit_ldr_reg_sp_any(ctx, 0, sum_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_sum_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_sum_jumps, {"pos": jpos_sum_neg, "cond": 11}) // LT

    // preload constants (callee-saved regs)
    emit_load_i64_imm(ctx, 25, mul)
    emit_load_i64_imm(ctx, 26, add)
    emit_load_i64_imm(ctx, 19, sum_cap)

    // mod < (mod_x + mod_i) => slow-sum path (full modulo)
    emit_ldr_reg_sp_any(ctx, 0, mod_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 19))
    var jpos_mod_small = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_sum_jumps, {"pos": jpos_mod_small, "cond": 11}) // LT

    // X19 is free after the sum-cap guard and can hold mod_x across the loop safely.
    emit_load_i64_imm(ctx, 19, mod_x)

    // Load loop vars into callee-saved regs once.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 21, n_off)
    emit_ldr_reg_sp_any(ctx, 23, x_off)
    emit_ldr_reg_sp_any(ctx, 24, sum_off)
    emit_ldr_reg_sp_any(ctx, 22, mod_off)

    // i_mod = i % mod_i (fast path only)
    emit_load_i64_imm(ctx, 5, mod_i)
    if use_fastmod == true {
        _arm64_emit_fastmod_u64_const(ctx, 20, 5, modi_recip, 2, 3, 0, 1)
    } else {
        push_u32_le(ctx["code"], insn_udiv(1, 20, 5))
        push_u32_le(ctx["code"], insn_mul(1, 1, 5))
        push_u32_le(ctx["code"], insn_sub_reg(2, 20, 1))
    }

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    // Inline throttled safepoint without per-iter tick loads/stores.
    if tick_period > 0 {
        push_u32_le(ctx["code"], insn_subs_imm(9, 9, 1))
    } else {
        push_u32_le(ctx["code"], insn_add_imm(9, 9, 1))
        push_u32_le(ctx["code"], insn_and_reg(11, 9, 10))
        push_u32_le(ctx["code"], insn_cmp_reg(11, 31))
    }
    var jpos_tick_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ne skip
    // The runtime safepoint call may clobber caller-saved regs, so spill i_mod across it.
    emit_str_reg_sp_any(ctx, 2, i_off)
    gc.native_emit_gc_safepoint_call(ctx)
    emit_ldr_reg_sp_any(ctx, 2, i_off)
    gc.native_emit_gc_inline_tick_init(ctx, tick_mask)
    var tick_skip_pos_slow = bytes_len(ctx["code"])
    var tick_skip_off_slow = (tick_skip_pos_slow - jpos_tick_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_tick_skip_slow, insn_b_cond(tick_skip_off_slow, 1)) // NE

    // X5 is caller-saved, so refresh mod_i after any safepoint call path.
    emit_load_i64_imm(ctx, 5, mod_i)

    // If i+1 >= n, run single-iter path.
    push_u32_le(ctx["code"], insn_add_imm(11, 20, 1))
    push_u32_le(ctx["code"], insn_cmp_reg(11, 21))
    var jpos_fast_single = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge single

    var rep = 0
    while rep < 2 {
        // x = (x*mul + add)
        push_u32_le(ctx["code"], insn_mul(23, 23, 25))
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 26))

        // x = x % mod
        if use_fastmod == true {
            _arm64_emit_fastmod_u64_const(ctx, 23, 22, mod_recip, 23, 3, 0, 1)
        } else {
            push_u32_le(ctx["code"], insn_udiv(0, 23, 22))
            push_u32_le(ctx["code"], insn_mul(0, 0, 22))
            push_u32_le(ctx["code"], insn_sub_reg(23, 23, 0))
        }

        // term_x = x % mod_x
        if use_fastmod == true {
            _arm64_emit_fastmod_u64_const(ctx, 23, 19, modx_recip, 1, 3, 0, 4)
        } else {
            push_u32_le(ctx["code"], insn_udiv(0, 23, 19))
            push_u32_le(ctx["code"], insn_mul(0, 0, 19))
            push_u32_le(ctx["code"], insn_sub_reg(1, 23, 0))
        }

        // term_i = i_mod (incremental)

        // sum = sum + term_x + term_i; if (sum >= mod) sum -= mod;
        push_u32_le(ctx["code"], insn_add_reg(24, 24, 1))
        push_u32_le(ctx["code"], insn_add_reg(24, 24, 2))
        push_u32_le(ctx["code"], insn_cmp_reg(24, 22))
        var jpos_sum_skip = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.lt skip
        push_u32_le(ctx["code"], insn_sub_reg(24, 24, 22))
        var sum_skip_pos = bytes_len(ctx["code"])
        var sum_skip_off = (sum_skip_pos - jpos_sum_skip) / 4
        set_u32_le(ctx["code"], jpos_sum_skip, insn_b_cond(sum_skip_off, 11)) // LT

        // i_mod = (i_mod + 1); if (i_mod >= mod_i) i_mod = 0;
        push_u32_le(ctx["code"], insn_add_imm(2, 2, 1))
        push_u32_le(ctx["code"], insn_cmp_reg(2, 5))
        var jpos_i_mod_ok = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.lt ok
        push_u32_le(ctx["code"], insn_movz(2, 0))
        var i_mod_ok_pos = bytes_len(ctx["code"])
        var i_mod_ok_off = (i_mod_ok_pos - jpos_i_mod_ok) / 4
        set_u32_le(ctx["code"], jpos_i_mod_ok, insn_b_cond(i_mod_ok_off, 11)) // LT

        rep = rep + 1
    }

    // i += 2
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 2))

    var back_pos2 = bytes_len(ctx["code"])
    var back_off2 = (loop_cond_pos - back_pos2) / 4
    push_u32_le(ctx["code"], insn_b(back_off2))

    var fast_single_pos = bytes_len(ctx["code"])
    var single_off = (fast_single_pos - jpos_fast_single) / 4
    set_u32_le(ctx["code"], jpos_fast_single, insn_b_cond(single_off, 10)) // GE

    // Single-iter path.
    // x = (x*mul + add)
    push_u32_le(ctx["code"], insn_mul(23, 23, 25))
    push_u32_le(ctx["code"], insn_add_reg(23, 23, 26))

    // x = x % mod
    if use_fastmod == true {
        _arm64_emit_fastmod_u64_const(ctx, 23, 22, mod_recip, 23, 3, 0, 1)
    } else {
        push_u32_le(ctx["code"], insn_udiv(0, 23, 22))
        push_u32_le(ctx["code"], insn_mul(0, 0, 22))
        push_u32_le(ctx["code"], insn_sub_reg(23, 23, 0))
    }

    // term_x = x % mod_x
    if use_fastmod == true {
        _arm64_emit_fastmod_u64_const(ctx, 23, 19, modx_recip, 1, 3, 0, 4)
    } else {
        push_u32_le(ctx["code"], insn_udiv(0, 23, 19))
        push_u32_le(ctx["code"], insn_mul(0, 0, 19))
        push_u32_le(ctx["code"], insn_sub_reg(1, 23, 0))
    }

    // term_i = i_mod (incremental)

    // sum = sum + term_x + term_i; if (sum >= mod) sum -= mod;
    push_u32_le(ctx["code"], insn_add_reg(24, 24, 1))
    push_u32_le(ctx["code"], insn_add_reg(24, 24, 2))
    push_u32_le(ctx["code"], insn_cmp_reg(24, 22))
    var jpos_sum_skip_single = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.lt skip
    push_u32_le(ctx["code"], insn_sub_reg(24, 24, 22))
    var sum_skip_pos_single = bytes_len(ctx["code"])
    var sum_skip_off_single = (sum_skip_pos_single - jpos_sum_skip_single) / 4
    set_u32_le(ctx["code"], jpos_sum_skip_single, insn_b_cond(sum_skip_off_single, 11)) // LT

    // i_mod = (i_mod + 1); if (i_mod >= mod_i) i_mod = 0;
    push_u32_le(ctx["code"], insn_add_imm(2, 2, 1))
    push_u32_le(ctx["code"], insn_cmp_reg(2, 5))
    var jpos_i_mod_ok_single = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.lt ok
    push_u32_le(ctx["code"], insn_movz(2, 0))
    var i_mod_ok_pos_single = bytes_len(ctx["code"])
    var i_mod_ok_off_single = (i_mod_ok_pos_single - jpos_i_mod_ok_single) / 4
    set_u32_le(ctx["code"], jpos_i_mod_ok_single, insn_b_cond(i_mod_ok_off_single, 11)) // LT

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // spill final fast-loop state for locals update
    emit_str_reg_sp_any(ctx, 20, i_off)
    emit_str_reg_sp_any(ctx, 23, x_off)
    emit_str_reg_sp_any(ctx, 24, sum_off)

    var jpos_skip_slow_sum = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b loop_end

    // Slow-sum path: patch all sum-fast failures here and emit full-mod loop.
    var slow_sum_pos = bytes_len(ctx["code"])
    var ssi = 0
    while ssi < oren_list_len(slow_sum_jumps) {
        var sj = slow_sum_jumps[ssi]
        var soff = (slow_sum_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        ssi = ssi + 1
    }

    var slow_loop_cond_pos = bytes_len(ctx["code"])
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 21, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_slow_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    gc.native_emit_gc_safepoint_inline_tick(ctx, tick_mask)

    // reload i/x/sum/mod after safepoint
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, x_off)
    emit_ldr_reg_sp_any(ctx, 24, sum_off)
    emit_ldr_reg_sp_any(ctx, 22, mod_off)
    emit_load_i64_imm(ctx, 5, mod_i)

    // x = (x*mul + add)
    push_u32_le(ctx["code"], insn_mul(23, 23, 25))
    push_u32_le(ctx["code"], insn_add_reg(23, 23, 26))

    // x = x % mod
    push_u32_le(ctx["code"], insn_sdiv(0, 23, 22))
    push_u32_le(ctx["code"], insn_mul(0, 0, 22))
    push_u32_le(ctx["code"], insn_sub_reg(23, 23, 0))

    // term_x = x % mod_x
    push_u32_le(ctx["code"], insn_sdiv(0, 23, 19))
    push_u32_le(ctx["code"], insn_mul(0, 0, 19))
    push_u32_le(ctx["code"], insn_sub_reg(1, 23, 0))

    // term_i = i % mod_i
    push_u32_le(ctx["code"], insn_sdiv(2, 20, 5))
    push_u32_le(ctx["code"], insn_mul(2, 2, 5))
    push_u32_le(ctx["code"], insn_sub_reg(2, 20, 2))

    // sum = (sum + term_x + term_i) % mod
    push_u32_le(ctx["code"], insn_add_reg(24, 24, 1))
    push_u32_le(ctx["code"], insn_add_reg(24, 24, 2))
    push_u32_le(ctx["code"], insn_sdiv(0, 24, 22))
    push_u32_le(ctx["code"], insn_mul(0, 0, 22))
    push_u32_le(ctx["code"], insn_sub_reg(24, 24, 0))

    emit_str_reg_sp_any(ctx, 23, x_off)
    emit_str_reg_sp_any(ctx, 24, sum_off)

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))
    emit_str_reg_sp_any(ctx, 20, i_off)

    var slow_back_pos = bytes_len(ctx["code"])
    var slow_back_off = (slow_loop_cond_pos - slow_back_pos) / 4
    push_u32_le(ctx["code"], insn_b(slow_back_off))

    var slow_end_pos = bytes_len(ctx["code"])
    var slow_end_off = (slow_end_pos - jpos_slow_end) / 4
    set_u32_le(ctx["code"], jpos_slow_end, insn_b_cond(slow_end_off, 10)) // GE

    var loop_end_pos = bytes_len(ctx["code"])
    var skip_sum_off = (loop_end_pos - jpos_skip_slow_sum) / 4
    set_u32_le(ctx["code"], jpos_skip_slow_sum, insn_b(skip_sum_off))

    // Update locals after loop exit.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_ldr_reg_sp_any(ctx, 23, x_off)
    emit_str_reg_fp_any(ctx, 23, x_fp_off)
    emit_ldr_reg_sp_any(ctx, 24, sum_off)
    emit_str_reg_fp_any(ctx, 24, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}
