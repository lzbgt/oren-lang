import codegen "codegen_arm64.oren"
import core "arm64_core.oren"

fn elf_diag_escape(msg) {
    if msg == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(msg) {
        var c = oren_string_char_at(msg, i)
        if c == "\n" { out = out + "\\n"; i = i + 1; continue }
        if c == "\r" { out = out + "\\r"; i = i + 1; continue }
        if c == "\t" { out = out + "\\t"; i = i + 1; continue }
        out = out + c
        i = i + 1
    }
    return out
}


// ELF emitter for arm64 (Linux).
// Single responsibility: take a linked program, call the arm64 native codegen,
// apply fixups, and write an ELF executable.

// ---- Thin wrappers into core codegen module (minimize churn) ----
fn bytes_new() { return codegen.bytes_new() }
fn bytes_push(b, v) { return codegen.bytes_push(b, v) }
fn bytes_extend(b, other) { return codegen.bytes_extend(b, other) }
fn bytes_extend_list(b, xs) { return codegen.bytes_extend_list(b, xs) }
fn bytes_len(b) { return codegen.bytes_len(b) }
fn bytes_finalize(b) { return codegen.bytes_finalize(b) }

fn push_u32_le(buf, n) { return codegen.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return codegen.push_u64_le(buf, n) }
fn set_u32_le(buf, offset, n) { return codegen.set_u32_le(buf, offset, n) }

fn align_up(n, align) { return codegen.align_up(n, align) }
fn int_mod(a, b) { return codegen.int_mod(a, b) }

fn insn_movz(reg, imm16) { return codegen.insn_movz(reg, imm16) }
fn insn_movk(reg, imm16, shift_idx) { return codegen.insn_movk(reg, imm16, shift_idx) }
fn insn_ret() { return codegen.insn_ret() }
fn insn_bl(off) { return codegen.insn_bl(off) }
fn insn_adr(reg, imm) { return codegen.insn_adr(reg, imm) }
fn insn_adrp(reg, imm_pages) { return codegen.insn_adrp(reg, imm_pages) }
fn insn_add_imm(rd, rn, imm) { return codegen.insn_add_imm(rd, rn, imm) }

// Instruction encodings needed by Linux FFI stubs / dynamic linking (keep here so `codegen_arm64.oren`
// facade remains small and stable for other emitters).
fn insn_mov_reg(rd, rn) { return core.insn_mov_reg(rd, rn) }
fn insn_cmp_reg(rn, rm) { return core.insn_cmp_reg(rn, rm) }
fn insn_b_cond(off, cond) { return core.insn_b_cond(off, cond) }
fn insn_blr(rn) { return core.insn_blr(rn) }
fn insn_br(rn) { return core.insn_br(rn) }
fn insn_sub_sp(imm) { return core.insn_sub_sp(imm) }
fn insn_add_sp(imm) { return core.insn_add_sp(imm) }
fn insn_str_reg_sp(reg, offset) { return core.insn_str_reg_sp(reg, offset) }
fn insn_ldr_reg_sp(reg, offset) { return core.insn_ldr_reg_sp(reg, offset) }
fn insn_ldr_ptr(rd, rn) { return core.insn_ldr_ptr(rd, rn) }
fn insn_str_ptr(rd, rn) { return core.insn_str_ptr(rd, rn) }

fn native_compile_program_arm64(linked, platform) { return codegen.native_compile_program_arm64(linked, platform) }
fn native_emit_errors_and_exit(ctx) { return codegen.native_emit_errors_and_exit(ctx) }

fn u64_2_32() { return 4294967296 } // 2^32, used for MOVK lane extraction
fn u64_2_48() { return 281474976710656 } // 2^48, used for MOVK lane extraction

fn push_u16_le(buf, n) {
    bytes_push(buf, int_mod(n, 256))
    bytes_push(buf, int_mod(n / 256, 256))
}

fn emit_debug_info(ctx, text_base, header_size) {
    var p = bytes_new()
    var funcs = ctx["debug_info"]["funcs"]
    var count = oren_list_len(funcs)
    push_u64_le(p, count)
    
    var i = 0
    while i < count {
        var f = funcs[i]
        // Absolute __TEXT addresses (for debug tooling) are based on the final load address.
        // Keep this derived from the current layout (no magic constants).
        var base = text_base + header_size
        push_u64_le(p, base + f["start"])
        push_u64_le(p, base + f["end"])
        
        var name_bytes = oren_bytes_from_string(f["name"])
        push_u64_le(p, oren_list_len(name_bytes))
        var k = 0
        while k < oren_list_len(name_bytes) { bytes_push(p, name_bytes[k]); k = k + 1 }
        while int_mod(bytes_len(p), 8) != 0 { bytes_push(p, 0) }

        // Optional source location for deterministic "panic" diagnostics.
        // File stored as UTF-8; line/col are 1-based (0 means unknown).
        var ffile = f["file"]
        if ffile == nil { ffile = "" }
        var file_bytes = oren_bytes_from_string(ffile)
        push_u64_le(p, oren_list_len(file_bytes))
        k = 0
        while k < oren_list_len(file_bytes) { bytes_push(p, file_bytes[k]); k = k + 1 }
        while int_mod(bytes_len(p), 8) != 0 { bytes_push(p, 0) }
        var line = f["line"]
        var col = f["col"]
        if line == nil { line = 0 }
        if col == nil { col = 0 }
        push_u64_le(p, line)
        push_u64_le(p, col)
        
        var params = f["params"]
        push_u64_le(p, oren_list_len(params))
        var j = 0
        while j < oren_list_len(params) {
            var param = params[j]
            var pname_bytes = oren_bytes_from_string(param["name"])
            push_u64_le(p, oren_list_len(pname_bytes))
            var m = 0
            while m < oren_list_len(pname_bytes) { bytes_push(p, pname_bytes[m]); m = m + 1 }
            while int_mod(bytes_len(p), 8) != 0 { bytes_push(p, 0) }
            push_u64_le(p, param["offset"])
            j = j + 1
        }
        i = i + 1
    }
    return p
}

fn _elf_push_phdr(p, p_type, p_flags, p_offset, p_vaddr, p_paddr, p_filesz, p_memsz, p_align) {
    push_u32_le(p, p_type)
    push_u32_le(p, p_flags)
    push_u64_le(p, p_offset)
    push_u64_le(p, p_vaddr)
    push_u64_le(p, p_paddr)
    push_u64_le(p, p_filesz)
    push_u64_le(p, p_memsz)
    push_u64_le(p, p_align)
    return nil
}

fn _bytes_align(buf, align) {
    if buf == nil { return nil }
    if align == nil || align <= 1 { return nil }
    while int_mod(bytes_len(buf), align) != 0 { bytes_push(buf, 0) }
    return nil
}

fn _bytes_add_str0(buf, s) {
    if buf == nil { return nil }
    if s == nil { s = "" }
    var off = bytes_len(buf)
    var bs = oren_bytes_from_string(s)
    var i = 0
    while i < oren_list_len(bs) { bytes_push(buf, bs[i]); i = i + 1 }
    bytes_push(buf, 0)
    return off
}

fn _elf_push_unique(out, seen, s) {
    if out == nil || seen == nil { return nil }
    if s == nil || s == "" { return nil }
    if seen[s] != nil { return nil }
    seen[s] = true
    oren_list_push(out, s)
    return nil
}

fn _elf_arm64_dyn_needed_libs(user_link_libs) {
    // Linux dynamic executables require an interpreter and a DT_NEEDED list.
    //
    // We always include libc + libdl (glibc-compatible); user `--link` adds more.
    var out = []
    var seen = {}
    _elf_push_unique(out, seen, "libdl.so.2")
    _elf_push_unique(out, seen, "libc.so.6")
    if user_link_libs != nil {
        var i = 0
        while i < oren_list_len(user_link_libs) {
            _elf_push_unique(out, seen, user_link_libs[i])
            i = i + 1
        }
    }
    return out
}

fn _elf_arm64_append_dyn_metadata(ctx, base, text_base, data_file_off, user_link_libs, exports) {
    // Append the minimal ELF dynamic-link metadata to `ctx["data"]` and return offsets needed
    // to build PT_INTERP/PT_DYNAMIC program headers.
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    var data = ctx["data"]

    // --- PT_INTERP payload ---
    // Use the conventional aarch64 interpreter path on glibc-based distros.
    var interp = "/lib/ld-linux-aarch64.so.1"
    var interp_bytes = oren_bytes_from_string(interp)
    _bytes_align(data, 1)
    var interp_off = bytes_len(data)
    bytes_extend_list(data, interp_bytes)
    bytes_push(data, 0)
    var interp_len = oren_list_len(interp_bytes) + 1

    // --- Build dynstr (DT_STRTAB) ---
    var dynstr = bytes_new()
    bytes_push(dynstr, 0) // leading NUL

    var needed = _elf_arm64_dyn_needed_libs(user_link_libs)
    var needed_dynstr_offs = {}
    var i_need = 0
    while i_need < oren_list_len(needed) {
        var lib = needed[i_need]
        needed_dynstr_offs[lib] = _bytes_add_str0(dynstr, lib)
        i_need = i_need + 1
    }

    var imports = ctx["elf_dyn_imports"]
    if imports == nil { imports = [] }

    var functions = ctx["functions"]
    if functions == nil { functions = {} }
    if exports == nil { exports = [] }
    var sym_dynstr_offs = {}
    var i_imp = 0
    while i_imp < oren_list_len(imports) {
        var imp = imports[i_imp]
        var nm = imp["name"]
        if nm == nil || nm == "" {
            var e = "native backend (arm64-linux): internal: dyn import missing name"
            print("OREN_DIAG kind=codegen code=1 msg=" + elf_diag_escape(e))
            print(e)
            oren_exit(1)
        }
        if sym_dynstr_offs[nm] == nil {
            sym_dynstr_offs[nm] = _bytes_add_str0(dynstr, nm)
        }
        i_imp = i_imp + 1
    }
    var i_exp = 0
    while i_exp < oren_list_len(exports) {
        var nm3 = exports[i_exp]
        if nm3 == nil || nm3 == "" { i_exp = i_exp + 1; continue }
        if sym_dynstr_offs[nm3] == nil {
            sym_dynstr_offs[nm3] = _bytes_add_str0(dynstr, nm3)
        }
        i_exp = i_exp + 1
    }

    // --- Build dynsym (DT_SYMTAB) ---
    // Elf64_Sym is 24 bytes.
    var dynsym = bytes_new()
    // STN_UNDEF (all zeros)
    push_u64_le(dynsym, 0); push_u64_le(dynsym, 0); push_u64_le(dynsym, 0)

    // Each import becomes one undefined global function symbol entry.
    // st_info = (STB_GLOBAL<<4) | STT_FUNC = 0x12
    var i_sym = 0
    while i_sym < oren_list_len(imports) {
        var imp2 = imports[i_sym]
        var nm2 = imp2["name"]
        var name_off = sym_dynstr_offs[nm2]
        if name_off == nil { name_off = 0 }

        push_u32_le(dynsym, name_off)
        bytes_push(dynsym, 18) // st_info
        bytes_push(dynsym, 0)  // st_other
        push_u16_le(dynsym, 0) // st_shndx = SHN_UNDEF
        push_u64_le(dynsym, 0) // st_value
        push_u64_le(dynsym, 0) // st_size
        i_sym = i_sym + 1
    }

    // Exports: defined global function symbols. These enable dlsym(RTLD_DEFAULT, "...") to obtain
    // raw function pointers for callback-style interop (e.g. OpenSSL ALPN select callbacks).
    //
    // Section indices (our fixed section table): 1 = .text
    i_sym = 0
    while i_sym < oren_list_len(exports) {
        var enm = exports[i_sym]
        if enm == nil || enm == "" { i_sym = i_sym + 1; continue }
        var fn_off = functions[enm]
        if fn_off == nil {
            var e2 = "native backend (arm64-linux): internal: export name not found in functions: " + enm
            print("OREN_DIAG kind=codegen code=1 msg=" + elf_diag_escape(e2))
            print(e2)
            oren_exit(1)
        }
        var name_off2 = sym_dynstr_offs[enm]
        if name_off2 == nil { name_off2 = 0 }

        push_u32_le(dynsym, name_off2)
        bytes_push(dynsym, 18) // st_info
        bytes_push(dynsym, 0)  // st_other
        push_u16_le(dynsym, 1) // st_shndx = .text
        push_u64_le(dynsym, text_base + fn_off) // st_value (virtual address)
        push_u64_le(dynsym, 0) // st_size (unknown)
        i_sym = i_sym + 1
    }

    // --- Build .rela.dyn (DT_RELA) ---
    // Elf64_Rela is 24 bytes.
    var rela = bytes_new()
    var rela_type_glob_dat = 1025 // R_AARCH64_GLOB_DAT (from elf.h)
    var i_rel = 0
    while i_rel < oren_list_len(imports) {
        var imp3 = imports[i_rel]
        var got_off = imp3["got_off"]
        if got_off == nil {
            var e = "native backend (arm64-linux): internal: dyn import missing got_off for " + imp3["name"]
            print("OREN_DIAG kind=codegen code=1 msg=" + elf_diag_escape(e))
            print(e)
            oren_exit(1)
        }
        // dynsym index: 1 + i_rel (STN_UNDEF is 0)
        var sym_idx = 1 + i_rel
        var r_offset = base + data_file_off + got_off
        var r_info = sym_idx * 4294967296 + rela_type_glob_dat
        push_u64_le(rela, r_offset)
        push_u64_le(rela, r_info)
        push_u64_le(rela, 0) // r_addend
        i_rel = i_rel + 1
    }

    // --- Build SysV hash (DT_HASH) over dynsym ---
    // Keep this tiny (1 bucket). With nbucket=1, all symbols land in bucket 0.
    var hash = bytes_new()
    var nchain = 1 + oren_list_len(imports) + oren_list_len(exports)
    var nbucket = 1
    push_u32_le(hash, nbucket)
    push_u32_le(hash, nchain)
    // buckets[nbucket]
    push_u32_le(hash, 0)
    // chains[nchain]
    var ci = 0
    while ci < nchain { push_u32_le(hash, 0); ci = ci + 1 }

    // Link all symbols in order: bucket[0]=1, chain[1]=2, ..., chain[last]=0.
    var last = 0
    var si = 1
    while si < nchain {
        if last == 0 {
            // buckets[0] at offset 8 in the hash table
            set_u32_le(hash, 8, si)
        } else {
            // chains array starts at offset: 8 + 4*nbucket
            var chains_off = 8 + 4 * nbucket
            set_u32_le(hash, chains_off + 4 * last, si)
        }
        last = si
        si = si + 1
    }

    // --- Append all dynamic tables into the main `.data` blob ---
    _bytes_align(data, 8)
    var hash_off = bytes_len(data)
    bytes_extend(data, hash)

    _bytes_align(data, 8)
    var dynstr_off = bytes_len(data)
    bytes_extend(data, dynstr)

    _bytes_align(data, 8)
    var dynsym_off = bytes_len(data)
    bytes_extend(data, dynsym)

    _bytes_align(data, 8)
    var rela_off = bytes_len(data)
    bytes_extend(data, rela)

    // --- Build .dynamic (DT_DYNAMIC) ---
    var dyn = bytes_new()
    // DT_NEEDED entries (d_val offsets into dynstr)
    var i_need2 = 0
    while i_need2 < oren_list_len(needed) {
        var lib2 = needed[i_need2]
        var off2 = needed_dynstr_offs[lib2]
        if off2 == nil { off2 = 0 }
        push_u64_le(dyn, 1)      // DT_NEEDED
        push_u64_le(dyn, off2)   // d_val (string table offset)
        i_need2 = i_need2 + 1
    }

    var data_addr = base + data_file_off
    var hash_addr = data_addr + hash_off
    var dynstr_addr = data_addr + dynstr_off
    var dynsym_addr = data_addr + dynsym_off
    var rela_addr = data_addr + rela_off

    // DT_HASH, DT_STRTAB, DT_SYMTAB (pointers)
    push_u64_le(dyn, 4);  push_u64_le(dyn, hash_addr)   // DT_HASH
    push_u64_le(dyn, 5);  push_u64_le(dyn, dynstr_addr) // DT_STRTAB
    push_u64_le(dyn, 6);  push_u64_le(dyn, dynsym_addr) // DT_SYMTAB

    // DT_STRSZ, DT_SYMENT
    push_u64_le(dyn, 10); push_u64_le(dyn, bytes_len(dynstr)) // DT_STRSZ
    push_u64_le(dyn, 11); push_u64_le(dyn, 24)               // DT_SYMENT (Elf64_Sym)

    // DT_RELA, DT_RELASZ, DT_RELAENT
    push_u64_le(dyn, 7);  push_u64_le(dyn, rela_addr)        // DT_RELA
    push_u64_le(dyn, 8);  push_u64_le(dyn, bytes_len(rela))  // DT_RELASZ
    push_u64_le(dyn, 9);  push_u64_le(dyn, 24)               // DT_RELAENT (Elf64_Rela)

    // DT_NULL terminator
    push_u64_le(dyn, 0); push_u64_le(dyn, 0)

    _bytes_align(data, 8)
    var dynamic_off = bytes_len(data)
    bytes_extend(data, dyn)
    var dynamic_len = bytes_len(dyn)

    return {"interp_off": interp_off, "interp_len": interp_len, "dynamic_off": dynamic_off, "dynamic_len": dynamic_len}
}

fn elf_build_prefix_arm64(base, hdr_size, phdrs, entry_off) {
    var p = bytes_new()
    
    // ELF Header (64 bytes)
    bytes_push(p, 127); bytes_push(p, 69); bytes_push(p, 76); bytes_push(p, 70); // .ELF
    bytes_push(p, 2); // Class: 64-bit
    bytes_push(p, 1); // Data: Little endian
    bytes_push(p, 1); // Version
    bytes_push(p, 0); // OS ABI: System V
    push_u64_le(p, 0) // Padding
    
    push_u16_le(p, 2)   // Type: EXEC
    push_u16_le(p, 183) // Machine: AArch64
    push_u32_le(p, 1) // Version

    push_u64_le(p, base + hdr_size + entry_off) // Entry point
    push_u64_le(p, 64) // Phdr offset
    push_u64_le(p, 0) // Shdr offset
    push_u32_le(p, 0) // Flags
    push_u16_le(p, 64) // Ehdr size
    push_u16_le(p, 56) // Phdr size
    push_u16_le(p, oren_list_len(phdrs)) // Phdr count
    push_u16_le(p, 64) // Shdr size
    push_u16_le(p, 0) // Shdr count
    push_u16_le(p, 0) // String index

    // Program headers
    var i = 0
    while i < oren_list_len(phdrs) {
        var ph = phdrs[i]
        _elf_push_phdr(p,
                       ph["type"],
                       ph["flags"],
                       ph["offset"],
                       ph["vaddr"],
                       ph["paddr"],
                       ph["filesz"],
                       ph["memsz"],
                       ph["align"])
        i = i + 1
    }
    return p
}

fn _data_add_u64(data, val) {
    if data == nil { return nil }
    _bytes_align(data, 8)
    var off = bytes_len(data)
    push_u64_le(data, val)
    return off
}

fn _data_add_cstr0(data, s) {
    if data == nil { return nil }
    if s == nil { s = "" }
    // Keep pointers naturally aligned for best-effort tooling reads (not required by correctness).
    _bytes_align(data, 1)
    var off = bytes_len(data)
    var bs = oren_bytes_from_string(s)
    var i = 0
    while i < oren_list_len(bs) { bytes_push(data, bs[i]); i = i + 1 }
    bytes_push(data, 0)
    return off
}

fn _arm64_linux_dyn_import_got_off(ctx, sym_name) {
    // Reserve (or reuse) a GOT slot for an ELF dynamic import.
    if ctx == nil { return nil }
    if sym_name == nil || sym_name == "" { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }

    if ctx["elf_dyn_got_offs_enc"] == nil { ctx["elf_dyn_got_offs_enc"] = {} }
    var m = ctx["elf_dyn_got_offs_enc"]
    var existing_enc = m[sym_name]
    if existing_enc != nil { return existing_enc - 1 }

    var got_off = _data_add_u64(ctx["data"], 0)
    // Store as off+1 so offset 0 doesn't alias native-runtime `nil`.
    m[sym_name] = got_off + 1

    if ctx["elf_dyn_imports"] == nil { ctx["elf_dyn_imports"] = [] }
    oren_list_push(ctx["elf_dyn_imports"], {"name": sym_name, "got_off": got_off})
    return got_off
}

fn _arm64_emit_ffi_resolver_linux(ctx, debug_mode) {
    // fn __oren_ffi_resolve0(sym_ptr) -> fn_ptr (0 if unresolved)
    //
    // ABI: AArch64 SysV (Linux): args in x0-x7, return in x0.
    // - sym_ptr is a cstr0 pointer.
    //
    // Implementation:
    // - calls `dlsym(RTLD_DEFAULT, sym_ptr)` via a GOT slot relocated by the ELF dynamic loader.
    var name = "__oren_ffi_resolve0"
    if ctx == nil { return nil }
    if ctx["functions"] == nil { return nil }
    if ctx["functions"][name] != nil { return name }

    // Reserve GOT slot for dlsym.
    var got_dlsym = _arm64_linux_dyn_import_got_off(ctx, "dlsym")
    if got_dlsym == nil {
        var e = "native backend (arm64-linux): internal: failed to reserve GOT slot for dlsym"
        print("OREN_DIAG kind=codegen code=1 msg=" + elf_diag_escape(e))
        print(e)
        oren_exit(1)
    }

    var code = ctx["code"]
    var data = ctx["data"]
    var fixups = ctx["fixups"]
    var functions = ctx["functions"]

    var start = bytes_len(code)
    functions[name] = start

    // Save LR across BLR (call via register).
    push_u32_le(code, insn_sub_sp(16))
    push_u32_le(code, insn_str_reg_sp(30, 0))

    // x1 = sym_ptr (incoming x0)
    push_u32_le(code, insn_mov_reg(1, 0))
    // x0 = RTLD_DEFAULT (NULL)
    push_u32_le(code, insn_movz(0, 0))

    // x16 = [GOT(dlsym)] ; blr x16
    var adr_got = bytes_len(code)
    push_u32_le(code, 0) // patched to ADRP x16, ...
    push_u32_le(code, 0) // patched to ADD  x16, x16, #off
    oren_list_push(fixups, {"type": "adr_data", "pos": adr_got, "data_off": got_dlsym, "reg": 16})
    push_u32_le(code, insn_ldr_ptr(16, 16))
    push_u32_le(code, insn_blr(16))

    // Restore LR and return.
    push_u32_le(code, insn_ldr_reg_sp(30, 0))
    push_u32_le(code, insn_add_sp(16))
    push_u32_le(code, insn_ret())

    if debug_mode && ctx["debug_info"] != nil && ctx["debug_info"]["funcs"] != nil {
        oren_list_push(ctx["debug_info"]["funcs"], {
            "name": name,
            "start": start,
            "end": bytes_len(code),
            "file": "<ffi>",
            "line": 0,
            "col": 0,
            "params": []
        })
    }
    return name
}

fn _arm64_emit_ffi_stub_linux_dyn(ctx, nm, resolver_name, debug_mode) {
    // Linux arm64: lazy resolve `nm` on first call, cache fnptr in `.data`, then tailcall.
    if ctx == nil { return nil }
    if nm == nil || nm == "" { return nil }
    if resolver_name == nil || resolver_name == "" { return nil }
    if ctx["functions"] == nil { return nil }
    if ctx["functions"][nm] != nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }

    var code = ctx["code"]
    var data = ctx["data"]
    var fixups = ctx["fixups"]
    var functions = ctx["functions"]

    // data: fnptr cell (u64)
    var cell_off = _data_add_u64(data, 0)
    // data: symbol name string (cstr0)
    var sym_off = _data_add_cstr0(data, nm)
    // data: error message (cstr0)
    var msg_off = _data_add_cstr0(data, "ffi unresolved: " + nm)

    var stub_pos = bytes_len(code)
    functions[nm] = stub_pos

    // x9 = &cell
    var adr_cell = bytes_len(code)
    push_u32_le(code, 0) // patched to ADRP x9, ...
    push_u32_le(code, 0) // patched to ADD  x9, x9, #off
    oren_list_push(fixups, {"type": "adr_data", "pos": adr_cell, "data_off": cell_off, "reg": 9})

    // x16 = [x9] (cached fnptr)
    push_u32_le(code, insn_ldr_ptr(16, 9))
    // if x16 != 0 => have
    push_u32_le(code, insn_cmp_reg(16, 31)) // cmp x16, xzr
    var br_have_pos = bytes_len(code)
    push_u32_le(code, 0) // patched later: b.ne have

    // Slow path: spill args + LR, call resolver, cache, restore, tailcall.
    // Stack frame layout (80 bytes):
    //   0..56:  x0..x7 (8 regs)
    //   64:     x30 (LR)
    push_u32_le(code, insn_sub_sp(80))
    push_u32_le(code, insn_str_reg_sp(0, 0))
    push_u32_le(code, insn_str_reg_sp(1, 8))
    push_u32_le(code, insn_str_reg_sp(2, 16))
    push_u32_le(code, insn_str_reg_sp(3, 24))
    push_u32_le(code, insn_str_reg_sp(4, 32))
    push_u32_le(code, insn_str_reg_sp(5, 40))
    push_u32_le(code, insn_str_reg_sp(6, 48))
    push_u32_le(code, insn_str_reg_sp(7, 56))
    push_u32_le(code, insn_str_reg_sp(30, 64))

    // x0 = &sym_cstr0
    var adr_sym = bytes_len(code)
    push_u32_le(code, 0)
    push_u32_le(code, 0)
    oren_list_push(fixups, {"type": "adr_data", "pos": adr_sym, "data_off": sym_off})

    // bl __oren_ffi_resolve0
    var bl_res = bytes_len(code)
    push_u32_le(code, 0)
    oren_list_push(fixups, {"type": "bl", "pos": bl_res, "name": resolver_name})

    // if x0 == 0 => fail
    push_u32_le(code, insn_cmp_reg(0, 31)) // cmp x0, xzr
    var br_fail_pos = bytes_len(code)
    push_u32_le(code, 0) // patched later: b.eq fail

    // x16 = fnptr (x0), cache in [cell].
    //
    // IMPORTANT: x9 is caller-saved across the resolver's `dlsym` call, so it may be clobbered.
    // Recompute &cell before storing.
    push_u32_le(code, insn_mov_reg(16, 0))
    var adr_cell2 = bytes_len(code)
    push_u32_le(code, 0)
    push_u32_le(code, 0)
    oren_list_push(fixups, {"type": "adr_data", "pos": adr_cell2, "data_off": cell_off, "reg": 9})
    push_u32_le(code, insn_str_ptr(16, 9))

    // Restore args + LR, dealloc stack.
    push_u32_le(code, insn_ldr_reg_sp(0, 0))
    push_u32_le(code, insn_ldr_reg_sp(1, 8))
    push_u32_le(code, insn_ldr_reg_sp(2, 16))
    push_u32_le(code, insn_ldr_reg_sp(3, 24))
    push_u32_le(code, insn_ldr_reg_sp(4, 32))
    push_u32_le(code, insn_ldr_reg_sp(5, 40))
    push_u32_le(code, insn_ldr_reg_sp(6, 48))
    push_u32_le(code, insn_ldr_reg_sp(7, 56))
    push_u32_le(code, insn_ldr_reg_sp(30, 64))
    push_u32_le(code, insn_add_sp(80))

    // Tailcall to target: br x16
    push_u32_le(code, insn_br(16))

    // Fail: call oren_panic("ffi unresolved: <name>") (does not return)
    var fail_pos = bytes_len(code)
    var adr_msg = bytes_len(code)
    push_u32_le(code, 0)
    push_u32_le(code, 0)
    oren_list_push(fixups, {"type": "adr_data", "pos": adr_msg, "data_off": msg_off})

    var bl_panic = bytes_len(code)
    push_u32_le(code, 0)
    oren_list_push(fixups, {"type": "bl", "pos": bl_panic, "name": "oren_panic"})

    // Fallback: if panic returns (should not), restore LR+stack and return 0.
    push_u32_le(code, insn_ldr_reg_sp(30, 64))
    push_u32_le(code, insn_add_sp(80))
    push_u32_le(code, insn_movz(0, 0))
    push_u32_le(code, insn_ret())

    // Have: tailcall cached target.
    var have_pos = bytes_len(code)
    push_u32_le(code, insn_br(16))

    // Patch local branches.
    set_u32_le(code, br_have_pos, insn_b_cond((have_pos - br_have_pos) / 4, 1)) // NE
    set_u32_le(code, br_fail_pos, insn_b_cond((fail_pos - br_fail_pos) / 4, 0)) // EQ

    if debug_mode && ctx["debug_info"] != nil && ctx["debug_info"]["funcs"] != nil {
        oren_list_push(ctx["debug_info"]["funcs"], {
            "name": nm,
            "start": stub_pos,
            "end": bytes_len(code),
            "file": "<ffi>",
            "line": 0,
            "col": 0,
            "params": []
        })
    }
    return nil
}

fn elf_emit_program_arm64(out_path, linked, libs, is_shared, exports, debug_mode, no_gc, capsule, cap_allow_domains) {
    // Rolling status:
    // - Linux native dynamic linking (`--link`) is implemented for arm64 as a minimal ELF dynamic
    //   executable + `dlsym`-based FFI resolver (see docs/NATIVE_BACKEND.md).
    // - Linux shared library output (`--lib` / `--export`) is not implemented yet.
    //
    // Fail fast so users don't get a silently-wrong artifact.
    if is_shared == true {
        print("native backend (arm64-linux): shared libraries are not implemented yet")
        print("  requested: --lib/--shared (and possibly --export)")
        oren_exit(1)
    }

    var dyn = libs != nil && oren_list_len(libs) != 0
    if exports != nil && oren_list_len(exports) != 0 && dyn != true {
        print("native backend (arm64-linux): @ffi.export requires dynamic linking (use @ffi.link(\"libdl.so.2\") or --link)")
        oren_exit(1)
    }
    var phnum = 2
    if dyn { phnum = 6 }
    // Ehdr (64) + Phdrs (56 each)
    var base = 4194304 // 0x400000
    var hdr_size = 64 + 56 * phnum

    var ctx = native_compile_program_arm64(linked, {"os": "linux", "arch": "arm64", "debug": debug_mode, "no_gc": no_gc, "capsule": capsule, "cap_allow_domains": cap_allow_domains, "link_libs": libs})
    if ctx == nil { return nil }
    native_emit_errors_and_exit(ctx)
    
    var code = ctx["code"]
    var data = ctx["data"]
    var fixups = ctx["fixups"]
    var functions = ctx["functions"]
    
    // Generate stubs for unresolved imports.
    //
    // Rolling contract (Tier-1 safety):
    // - without `--link`: calling an `ffi` symbol panics with a stable message
    // - with `--link`: emit a dynamic-link-aware resolver + lazy stubs (dlsym-based)
    // IMPORTANT (Tier‑1 robustness):
    // If an Oren function is mistakenly classified as an import, emitting an import stub will
    // overwrite its real entry in `ctx["functions"]`, causing silent miscompiles.
    // Filter imports here so only true unresolved `ffi` symbols get stubs.
    var imports_raw = ctx["import_list"]
    if imports_raw == nil { imports_raw = [] }
    var imports = []
    var import_collide_count = 0
    var import_collide_sample = []
    var ii_imp = 0
    while ii_imp < oren_list_len(imports_raw) {
        var nm = imports_raw[ii_imp]
        var is_local = false
        if nm != nil {
            if ctx["func_arity"] != nil && ctx["func_arity"][nm] != nil {
                is_local = true
            } else if functions != nil && functions[nm] != nil {
                is_local = true
            }
        }
        if is_local {
            import_collide_count = import_collide_count + 1
            if oren_list_len(import_collide_sample) < 8 { oren_list_push(import_collide_sample, nm) }
        } else {
            oren_list_push(imports, nm)
        }
        ii_imp = ii_imp + 1
    }
    ctx["import_list"] = imports
    if oren_env("OREN_TRACE_NATIVE_IMPORTS") != nil && import_collide_count > 0 {
        var sample_s = ""
        var si = 0
        while si < oren_list_len(import_collide_sample) {
            if si > 0 { sample_s = sample_s + "," }
            sample_s = sample_s + import_collide_sample[si]
            si = si + 1
        }
        print("[emit] elf arm64: filtered " + oren_int_to_string(import_collide_count) + " import(s) that collide with local function symbols (sample=" + sample_s + ")")
    }

    if dyn && oren_list_len(imports) > 0 {
        var resolver_name = _arm64_emit_ffi_resolver_linux(ctx, debug_mode)
        var ii = 0
        while ii < oren_list_len(imports) {
            _arm64_emit_ffi_stub_linux_dyn(ctx, imports[ii], resolver_name, debug_mode)
            ii = ii + 1
        }
    } else {
        var i_imp = 0
        while i_imp < oren_list_len(imports) {
            var name = imports[i_imp]
            var stub_pos = bytes_len(code)
            functions[name] = stub_pos

            // data: "ffi unresolved: <name>\0"
            var msg_off = _data_add_cstr0(data, "ffi unresolved: " + name)

            // x0 = &msg (cstr0)
            var adr_pos = bytes_len(code)
            push_u32_le(code, 0) // patched to ADRP x0, ...
            push_u32_le(code, 0) // patched to ADD  x0, x0, #off
            oren_list_push(fixups, {"type": "adr_data", "pos": adr_pos, "data_off": msg_off})

            // bl oren_panic
            var bl_pos = bytes_len(code)
            push_u32_le(code, 0)
            oren_list_push(fixups, {"type": "bl", "pos": bl_pos, "name": "oren_panic"})

            // Fallback: return 0 if panic returns (should not happen).
            push_u32_le(code, insn_movz(0, 0))
            push_u32_le(code, insn_ret())

            // Include import stubs in the debug-info table so `--debug` stack traces can
            // symbolize the failing frame (instead of "???" / "<unknown host>").
            if debug_mode && ctx["debug_info"] != nil && ctx["debug_info"]["funcs"] != nil {
                oren_list_push(ctx["debug_info"]["funcs"], {
                    "name": name,
                    "start": stub_pos,
                    "end": bytes_len(code),
                    "file": "<ffi>",
                    "line": 0,
                    "col": 0,
                    "params": []
                })
            }

            i_imp = i_imp + 1
        }
    }

    // Output layout (v0):
    //   [ELF hdrs + PHDRs] [code] [pad-to-page] [data]
    var page = 4096
    var debug_off = nil

    // Append debug info (Linux ELF).
    //
    // Without this, linux `--debug` builds leave an unpatched 0-word placeholder
    // at ctx["debug_fixup_pos"], which becomes an illegal instruction (UDF #0)
    // at runtime.
    if debug_mode {
        var debug_blob = emit_debug_info(ctx, base, hdr_size)
        while int_mod(bytes_len(data), 8) != 0 { bytes_push(data, 0) }
        debug_off = bytes_len(data)
        bytes_extend(data, debug_blob)
        if ctx["debug_fixup_pos"] != nil {
            oren_list_push(fixups, {"type": "adr_data", "pos": ctx["debug_fixup_pos"], "data_off": debug_off})
        }
    }

    // Page-align the start of the data segment (required for PT_LOAD alignment).
    var code_len = bytes_len(code)
    var text_end_off = hdr_size + code_len
    var data_file_off = align_up(text_end_off, page)
    var pad_len = data_file_off - text_end_off
    var code_pad = bytes_new()
    var pi = 0
    while pi < pad_len { bytes_push(code_pad, 0); pi = pi + 1 }

    // Patch debug static addr constant now that we know the final data segment base address.
    if debug_mode && debug_off != nil && ctx["debug_static_addr_pos"] != nil {
        var sa = base + data_file_off + debug_off
        var p = ctx["debug_static_addr_pos"]
        set_u32_le(code, p, insn_movz(1, int_mod(sa, 65536)))
        set_u32_le(code, p+4, insn_movk(1, int_mod(sa / 65536, 65536), 1))
        set_u32_le(code, p+8, insn_movk(1, int_mod(sa / u64_2_32(), 65536), 2))
        set_u32_le(code, p+12, insn_movk(1, int_mod(sa / u64_2_48(), 65536), 3))
    }
    
    if functions["main"] == nil {
        if functions["__top_level__"] != nil { functions["main"] = functions["__top_level__"] }
        if functions["main"] == nil {
            if ctx["main_idx"] != nil { functions["main"] = ctx["main_idx"] }
            if functions["main"] == nil {
                if oren_list_len(ctx["function_names"]) > 0 {
                    var fname0 = ctx["function_names"][0]
                    functions["main"] = functions[fname0]
                } else {
                    functions["main"] = 0
                }
            }
        }
    }
    
    // If `--link` is used, append ELF dynamic-link metadata (PT_INTERP/PT_DYNAMIC, DT_NEEDED, relocations).
    // This must happen after `data_file_off` is known, because relocations store absolute target addresses.
    var dyn_meta = nil
    if dyn {
        var text_base = base + hdr_size
        dyn_meta = _elf_arm64_append_dyn_metadata(ctx, base, text_base, data_file_off, libs, exports)
        // data buffer may have been extended by `_elf_arm64_append_dyn_metadata`.
        data = ctx["data"]
    }

    var i = 0
    while i < oren_list_len(fixups) {
        var fix = fixups[i]
        var pos = fix["pos"]
        
        if fix["type"] == "bl" {
            var name2 = fix["name"]
            var target = functions[name2]
            if target == nil {
                var e = "native backend: undefined function " + name2
                print("OREN_DIAG kind=codegen code=1 msg=" + elf_diag_escape(e))
                print(e)
                oren_exit(1)
            }
            var offset = (target - pos) / 4
            set_u32_le(code, pos, insn_bl(offset))
        }
        
        if fix["type"] == "adr_data" {
            var data_off = fix["data_off"]
            var target_addr = base + data_file_off + data_off
            var pc = base + hdr_size + pos
            var pc_page = pc - int_mod(pc, 4096)
            var target_page = target_addr - int_mod(target_addr, 4096)
            var delta_pages = (target_page - pc_page) / 4096
            var page_off = int_mod(target_addr, 4096)
            var reg = fix["reg"]
            if reg == nil { reg = 0 }
            set_u32_le(code, pos, insn_adrp(reg, delta_pages))
            set_u32_le(code, pos + 4, insn_add_imm(reg, reg, page_off))
        }

        if fix["type"] == "adr_code" {
            var name3 = fix["name"]
            var target2 = functions[name3]
            if target2 == nil {
                var e = "native backend: undefined function " + name3
                print("OREN_DIAG kind=codegen code=1 msg=" + elf_diag_escape(e))
                print(e)
                oren_exit(1)
            }
            var reg = fix["reg"]
            if reg == nil { reg = 0 }
            var target_addr = base + hdr_size + target2
            var pc = base + hdr_size + pos
            var pc_page = pc - int_mod(pc, 4096)
            var target_page = target_addr - int_mod(target_addr, 4096)
            var delta_pages = (target_page - pc_page) / 4096
            var page_off = int_mod(target_addr, 4096)
            set_u32_le(code, pos, insn_adrp(reg, delta_pages))
            set_u32_le(code, pos + 4, insn_add_imm(reg, reg, page_off))
        }
        
        // Legacy
        if fix["type"] == nil {
            var data_off2 = fix["data_off"]
            var target_idx2 = (data_file_off - hdr_size) + data_off2
            var offset3 = target_idx2 - pos
            set_u32_le(code, pos, insn_adr(1, offset3))
        }
        i = i + 1
    }

    // Entry point is start of code (startup shim).
    var entry_off = 0

    // Build program headers based on the final layout.
    var text_filesz = data_file_off
    var phdrs = []
    if dyn {
        // PT_PHDR (header table itself)
        oren_list_push(phdrs, {"type": 6, "flags": 4, "offset": 64, "vaddr": base + 64, "paddr": base + 64, "filesz": phnum * 56, "memsz": phnum * 56, "align": 8})
        // PT_INTERP
        oren_list_push(phdrs, {"type": 3, "flags": 4, "offset": data_file_off + dyn_meta["interp_off"], "vaddr": base + data_file_off + dyn_meta["interp_off"], "paddr": base + data_file_off + dyn_meta["interp_off"], "filesz": dyn_meta["interp_len"], "memsz": dyn_meta["interp_len"], "align": 1})
    }
    // PT_LOAD RX: headers + code + padding
    oren_list_push(phdrs, {"type": 1, "flags": 5, "offset": 0, "vaddr": base, "paddr": base, "filesz": text_filesz, "memsz": text_filesz, "align": 4096})
    // PT_LOAD RW: data blob
    oren_list_push(phdrs, {"type": 1, "flags": 6, "offset": data_file_off, "vaddr": base + data_file_off, "paddr": base + data_file_off, "filesz": bytes_len(data), "memsz": bytes_len(data), "align": 4096})
    if dyn {
        // PT_DYNAMIC
        oren_list_push(phdrs, {"type": 2, "flags": 6, "offset": data_file_off + dyn_meta["dynamic_off"], "vaddr": base + data_file_off + dyn_meta["dynamic_off"], "paddr": base + data_file_off + dyn_meta["dynamic_off"], "filesz": dyn_meta["dynamic_len"], "memsz": dyn_meta["dynamic_len"], "align": 8})
        // PT_GNU_STACK (RW, no execute)
        oren_list_push(phdrs, {"type": 1685382481, "flags": 6, "offset": 0, "vaddr": 0, "paddr": 0, "filesz": 0, "memsz": 0, "align": 16})
    }

    var prefix = elf_build_prefix_arm64(base, hdr_size, phdrs, entry_off)
    bytes_extend(prefix, code)
    bytes_extend(prefix, code_pad)
    bytes_extend(prefix, data)
    
    var w3 = oren_write_bytes(out_path, bytes_finalize(prefix))
    if oren_is_err(w3) {
        var msg3 = oren_err_msg(w3)
        var e = "Failed to write output: " + out_path
        if msg3 != nil { e = e + ": " + msg3 }
        print("OREN_DIAG kind=codegen code=2 msg=" + elf_diag_escape(e))
        print(e)
        oren_exit(1)
    }
    oren_chmod(out_path, 493) // 0755
    return nil
}
