import cutils "transpiler_c_utils.oren"



// Lambda analysis helpers extracted from transpiler.oren.



fn is_non_capturable_ident_name(name) { return cutils.is_non_capturable_ident_name(name) }



fn lambda_gensym(t, unit_prefix) {
    var n = t["lambda_counter"]
    t["lambda_counter"] = n + 1
    return "__oren_lambda_" + unit_prefix + "_" + oren_int_to_string(n)
}

fn lambda_collect_declared_in_expression(exp, declared) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Function" {
        // Nested lambdas are their own scopes.
        return nil
    }
    if et == "Call" {
        lambda_collect_declared_in_expression(exp["fn"], declared)
        var i = 0
        var args = exp["args"]
        var args_len = oren_list_len(args)
        while i < args_len {
            lambda_collect_declared_in_expression(args[i], declared)
            i = i + 1
        }
        if exp["spread"] != nil { lambda_collect_declared_in_expression(exp["spread"], declared) }
        return nil
    }
    if et == "Prefix" { lambda_collect_declared_in_expression(exp["right"], declared); return nil }
    if et == "Infix" {
        lambda_collect_declared_in_expression(exp["left"], declared)
        lambda_collect_declared_in_expression(exp["right"], declared)
        return nil
    }
    if et == "If" {
        lambda_collect_declared_in_expression(exp["cond"], declared)
        lambda_collect_declared_in_statement(exp["consq"], declared)
        if exp["alt"] != nil { lambda_collect_declared_in_statement(exp["alt"], declared) }
        return nil
    }
    if et == "Member" { lambda_collect_declared_in_expression(exp["left"], declared); return nil }
    if et == "Index" {
        lambda_collect_declared_in_expression(exp["left"], declared)
        lambda_collect_declared_in_expression(exp["index"], declared)
        return nil
    }
    if et == "Array" {
        var j = 0
        var elements = exp["elements"]
        var elements_len = oren_list_len(elements)
        while j < elements_len {
            lambda_collect_declared_in_expression(elements[j], declared)
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        var pairs = exp["pairs"]
        var pairs_len = oren_list_len(pairs)
        while k < pairs_len {
            var pair = pairs[k]
            lambda_collect_declared_in_expression(pair["key"], declared)
            lambda_collect_declared_in_expression(pair["value"], declared)
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { lambda_collect_declared_in_expression(exp["call"], declared); return nil }
    return nil
}

fn lambda_collect_declared_in_statement(stmt, declared) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" {
        var nm = stmt["name"]["value"]
        if nm != nil && nm != "" { declared[nm] = true }
        lambda_collect_declared_in_expression(stmt["value"], declared)
        return nil
    }
    if st == "Assign" { lambda_collect_declared_in_expression(stmt["value"], declared); return nil }
    if st == "Set" {
        lambda_collect_declared_in_expression(stmt["left"], declared)
        lambda_collect_declared_in_expression(stmt["value"], declared)
        return nil
    }
    if st == "Return" { lambda_collect_declared_in_expression(stmt["value"], declared); return nil }
    if st == "ExprStmt" { lambda_collect_declared_in_expression(stmt["expr"], declared); return nil }
    if st == "Block" {
        var i = 0
        var stmts = stmt["stmts"]
        var stmts_len = oren_list_len(stmts)
        while i < stmts_len {
            lambda_collect_declared_in_statement(stmts[i], declared)
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        lambda_collect_declared_in_expression(stmt["cond"], declared)
        lambda_collect_declared_in_statement(stmt["body"], declared)
        return nil
    }
    if st == "For" {
        lambda_collect_declared_in_statement(stmt["init"], declared)
        lambda_collect_declared_in_expression(stmt["cond"], declared)
        lambda_collect_declared_in_statement(stmt["post"], declared)
        lambda_collect_declared_in_statement(stmt["body"], declared)
        return nil
    }
    if st == "Spawn" { lambda_collect_declared_in_expression(stmt["call"], declared); return nil }
    // Break/Continue/FFI/Import/Type: no locals.
    return nil
}

fn maybe_add_capture(name, aliases, declared, seen, out) {
    if is_non_capturable_ident_name(name) { return nil }
    if aliases != nil && aliases[name] != nil { return nil }
    if declared[name] == true { return nil }
    if seen[name] == true { return nil }
    seen[name] = true
    oren_list_push(out, name)
    return nil
}

fn lambda_collect_used_in_expression(exp, aliases, declared, seen, out) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Identifier" {
        maybe_add_capture(exp["value"], aliases, declared, seen, out)
        return nil
    }
    if et == "Function" {
        var nested = exp["captures"]
        if nested == nil { nested = lambda_free_vars(exp, aliases) }
        var i = 0
        var nested_len = oren_list_len(nested)
        while i < nested_len {
            maybe_add_capture(nested[i], aliases, declared, seen, out)
            i = i + 1
        }
        return nil
    }
    if et == "Call" {
        lambda_collect_used_in_expression(exp["fn"], aliases, declared, seen, out)
        var i = 0
        var args = exp["args"]
        var args_len = oren_list_len(args)
        while i < args_len {
            lambda_collect_used_in_expression(args[i], aliases, declared, seen, out)
            i = i + 1
        }
        if exp["spread"] != nil { lambda_collect_used_in_expression(exp["spread"], aliases, declared, seen, out) }
        return nil
    }
    if et == "Prefix" { lambda_collect_used_in_expression(exp["right"], aliases, declared, seen, out); return nil }
    if et == "Infix" {
        lambda_collect_used_in_expression(exp["left"], aliases, declared, seen, out)
        lambda_collect_used_in_expression(exp["right"], aliases, declared, seen, out)
        return nil
    }
    if et == "If" {
        lambda_collect_used_in_expression(exp["cond"], aliases, declared, seen, out)
        lambda_collect_used_in_statement(exp["consq"], aliases, declared, seen, out)
        if exp["alt"] != nil { lambda_collect_used_in_statement(exp["alt"], aliases, declared, seen, out) }
        return nil
    }
    if et == "Member" {
        lambda_collect_used_in_expression(exp["left"], aliases, declared, seen, out)
        return nil
    }
    if et == "Index" {
        lambda_collect_used_in_expression(exp["left"], aliases, declared, seen, out)
        lambda_collect_used_in_expression(exp["index"], aliases, declared, seen, out)
        return nil
    }
    if et == "Array" {
        var j = 0
        var elements = exp["elements"]
        var elements_len = oren_list_len(elements)
        while j < elements_len {
            lambda_collect_used_in_expression(elements[j], aliases, declared, seen, out)
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        var pairs = exp["pairs"]
        var pairs_len = oren_list_len(pairs)
        while k < pairs_len {
            var pair = pairs[k]
            lambda_collect_used_in_expression(pair["key"], aliases, declared, seen, out)
            lambda_collect_used_in_expression(pair["value"], aliases, declared, seen, out)
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { lambda_collect_used_in_expression(exp["call"], aliases, declared, seen, out); return nil }
    return nil
}

fn lambda_collect_used_in_statement(stmt, aliases, declared, seen, out) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" { lambda_collect_used_in_expression(stmt["value"], aliases, declared, seen, out); return nil }
    if st == "Assign" {
        maybe_add_capture(stmt["name"]["value"], aliases, declared, seen, out)
        lambda_collect_used_in_expression(stmt["value"], aliases, declared, seen, out)
        return nil
    }
    if st == "Set" {
        if stmt["left"]["type"] == "Identifier" {
            maybe_add_capture(stmt["left"]["value"], aliases, declared, seen, out)
        } else {
            lambda_collect_used_in_expression(stmt["left"], aliases, declared, seen, out)
        }
        lambda_collect_used_in_expression(stmt["value"], aliases, declared, seen, out)
        return nil
    }
    if st == "Return" { lambda_collect_used_in_expression(stmt["value"], aliases, declared, seen, out); return nil }
    if st == "ExprStmt" { lambda_collect_used_in_expression(stmt["expr"], aliases, declared, seen, out); return nil }
    if st == "Block" {
        var i = 0
        var stmts = stmt["stmts"]
        var stmts_len = oren_list_len(stmts)
        while i < stmts_len {
            lambda_collect_used_in_statement(stmts[i], aliases, declared, seen, out)
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        lambda_collect_used_in_expression(stmt["cond"], aliases, declared, seen, out)
        lambda_collect_used_in_statement(stmt["body"], aliases, declared, seen, out)
        return nil
    }
    if st == "For" {
        lambda_collect_used_in_statement(stmt["init"], aliases, declared, seen, out)
        lambda_collect_used_in_expression(stmt["cond"], aliases, declared, seen, out)
        lambda_collect_used_in_statement(stmt["post"], aliases, declared, seen, out)
        lambda_collect_used_in_statement(stmt["body"], aliases, declared, seen, out)
        return nil
    }
    if st == "Spawn" { lambda_collect_used_in_expression(stmt["call"], aliases, declared, seen, out); return nil }
    return nil
}

fn lambda_free_vars(fun, aliases) {
    var declared = {}
    // params
    var i = 0
    var params = fun["params"]
    var params_len = oren_list_len(params)
    while i < params_len {
        declared[params[i]["value"]] = true
        i = i + 1
    }
    // var decls (any depth)
    lambda_collect_declared_in_statement(fun["body"], declared)

    var out = []
    var seen = {}
    lambda_collect_used_in_statement(fun["body"], aliases, declared, seen, out)
    return out
}

fn collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Function" {
            if exp["name"] == "" {
                if exp["lambda_name"] == nil {
                    exp["lambda_name"] = lambda_gensym(t, unit_prefix)
                    exp["captures"] = lambda_free_vars(exp, unit_aliases)
                    oren_list_push(t["lambda_defs"], {"name": exp["lambda_name"], "fun": exp, "captures": exp["captures"], "aliases": unit_aliases})
                }
            // Still recurse to find nested lambdas inside this lambda body (as expressions).
            collect_lambdas_in_statement(t, unit_prefix, unit_aliases, exp["body"])
            return nil
        }
        // Named function literals are top-level decls in this compiler; ignore.
        return nil
    }
    if et == "Call" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["fn"])
        var i = 0
        var args = exp["args"]
        var args_len = oren_list_len(args)
        while i < args_len {
            collect_lambdas_in_expression(t, unit_prefix, unit_aliases, args[i])
            i = i + 1
        }
        return nil
    }
    if et == "Prefix" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["right"]); return nil }
    if et == "Infix" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["left"])
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["right"])
        return nil
    }
    if et == "If" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["cond"])
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, exp["consq"])
        if exp["alt"] != nil { collect_lambdas_in_statement(t, unit_prefix, unit_aliases, exp["alt"]) }
        return nil
    }
    if et == "Member" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["left"]); return nil }
    if et == "Index" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["left"])
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["index"])
        return nil
    }
    if et == "Array" {
        var j = 0
        var elements = exp["elements"]
        var elements_len = oren_list_len(elements)
        while j < elements_len {
            collect_lambdas_in_expression(t, unit_prefix, unit_aliases, elements[j])
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        var pairs = exp["pairs"]
        var pairs_len = oren_list_len(pairs)
        while k < pairs_len {
            var pair = pairs[k]
            collect_lambdas_in_expression(t, unit_prefix, unit_aliases, pair["key"])
            collect_lambdas_in_expression(t, unit_prefix, unit_aliases, pair["value"])
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["call"]); return nil }
    return nil
}

fn collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["value"]); return nil }
    if st == "Assign" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["value"]); return nil }
    if st == "Set" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["left"])
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["value"])
        return nil
    }
    if st == "Return" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["value"]); return nil }
    if st == "ExprStmt" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["expr"]); return nil }
    if st == "Block" {
        var i = 0
        var stmts = stmt["stmts"]
        var stmts_len = oren_list_len(stmts)
        while i < stmts_len {
            collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmts[i])
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["cond"])
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt["body"])
        return nil
    }
    if st == "For" {
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt["init"])
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["cond"])
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt["post"])
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt["body"])
        return nil
    }
    if st == "Spawn" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["call"]); return nil }
    return nil
}
