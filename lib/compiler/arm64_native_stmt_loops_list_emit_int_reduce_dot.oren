            var exact_double_after_jump = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b after fallback

            var exact_double_fallback_pos = bytes_len(ctx["code"])
            var exact_double_fallback_off = (exact_double_fallback_pos - exact_double_terminal_guard_pos) / 4
