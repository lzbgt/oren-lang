// Delegate expression compilation to the expr module.
fn native_compile_expr(ctx, expr) { return exprm.native_compile_expr(ctx, expr) }

// Helpers from list matchers module.
fn _arm64_local_fp_off(ctx, name) { return listm._arm64_local_fp_off(ctx, name) }
fn _arm64_str_eq_bytes(a, b) { return listm._arm64_str_eq_bytes(a, b) }
fn _arm64_fast_loop_int_lit_const(expr) { return listm._arm64_fast_loop_int_lit_const(expr) }
fn _arm64_emit_while_generic(ctx, stmt) { return listm._arm64_emit_while_generic(ctx, stmt) }
fn _arm64_restore_stack_to(ctx, base_stack) { return listm._arm64_restore_stack_to(ctx, base_stack) }

fn _arm64_local_int_const(ctx, name) {
    if ctx == nil || name == nil { return nil }
    return exprm.native_expr_int_const(ctx, {"type": "Identifier", "token": nil, "value": name})
}

fn _arm64_emit_list_int_dot_slot_load(ctx, dst, base, offset, low32_loads) {
    if low32_loads == true {
        push_u32_le(ctx["code"], insn_ldrsw(dst, base, offset))
    } else if offset == 0 {
        push_u32_le(ctx["code"], insn_ldr_ptr(dst, base))
    } else {
        push_u32_le(ctx["code"], insn_ldr_ptr_off(dst, base, offset))
    }
}

// Keep arm64 list fast-loop validation on the same resilient runtime contract as the
// native list helpers: recover/retrack valid list headers before rejecting the pointer.
// Call sites still do explicit kind/magic checks after this helper returns a tracked node or 0.
fn _arm64_emit_find_list_node_known_kind(ctx, ptr_reg, dst_reg, want_kind) {
    if ctx == nil { return nil }
    if ptr_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(0, ptr_reg)) }
    emit_load_i64_imm(ctx, 1, want_kind)
    var bl_find = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find, "name": "_list_find_node_known_kind"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], -12)
    if dst_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(dst_reg, 0)) }
    return nil
}

// Prefix-zero statement fast paths stay opt-in until the full acceptance bundle is clean.
fn _arm64_env_enabled_default_false(name) {
    var v = oren_env(name)
    if v == "1" || v == "true" { return true }
    return false
}

fn _arm64_env_enabled_default_true(name) {
    var v = oren_env(name)
    if v == "0" || v == "false" { return false }
    return true
}

fn _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, expr, idx_name, idx_reg) {
    if ctx == nil || expr == nil || idx_name == nil { return false }
    var int_const = _arm64_fast_loop_int_lit_const(expr)
    if int_const != nil {
        emit_load_i64_imm(ctx, 0, int_const)
        return true
    }
    var et = expr["type"]
    if et == "Identifier" {
        if _arm64_str_eq_bytes(expr["value"], idx_name) != true { return false }
        if idx_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(0, idx_reg)) }
        return true
    }
    if et == "Prefix" {
        if expr["op"] != "-" { return false }
        if _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, expr["right"], idx_name, idx_reg) != true { return false }
        push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0))
        return true
    }
    if et != "Infix" { return false }
    var op = expr["op"]
    if op != "+" && op != "-" && op != "*" && op != "%" { return false }

    if _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, expr["left"], idx_name, idx_reg) != true { return false }
    push_u32_le(ctx["code"], insn_sub_sp(16))
    push_u32_le(ctx["code"], insn_str_x0_sp(0))
    ctx["stack_size"] = ctx["stack_size"] + 16

    if _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, expr["right"], idx_name, idx_reg) != true {
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16
        return false
    }

    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
    push_u32_le(ctx["code"], insn_add_sp(16))
    ctx["stack_size"] = ctx["stack_size"] - 16

    if op == "+" {
        push_u32_le(ctx["code"], insn_add_reg(0, 1, 0))
        return true
    }
    if op == "-" {
        push_u32_le(ctx["code"], insn_sub_reg(0, 1, 0))
        return true
    }
    if op == "*" {
        push_u32_le(ctx["code"], insn_mul(0, 1, 0))
        return true
    }

    var rhs_const = _arm64_fast_loop_int_lit_const(expr["right"])
    if rhs_const == nil || rhs_const == 0 || rhs_const == -1 { return false }
    push_u32_le(ctx["code"], insn_sdiv(2, 1, 0))
    push_u32_le(ctx["code"], insn_mul(2, 2, 0))
    push_u32_le(ctx["code"], insn_sub_reg(0, 1, 2))
    return true
}

fn _arm64_emit_fast_loop_nonneg_linear_to_x0(ctx, linear, idx_reg) {
    if ctx == nil || linear == nil || idx_reg == nil { return false }
    var mul = linear["mul"]
    var add = linear["add"]
    var mod = linear["mod"]
    if mul == nil || add == nil || mod == nil { return false }
    if mul < 0 || add < 0 || mod < 0 { return false }

    if mul == 0 {
        emit_load_i64_imm(ctx, 0, add)
    } else {
        if idx_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(0, idx_reg)) }
        if mul != 1 {
            emit_load_i64_imm(ctx, 9, mul)
            push_u32_le(ctx["code"], insn_mul(0, 0, 9))
        }
        if add != 0 {
            emit_load_i64_imm(ctx, 9, add)
            push_u32_le(ctx["code"], insn_add_reg(0, 0, 9))
        }
    }
    if mod > 0 {
        // Keep this helper on caller-saved scratch regs. X19..X26 are the backend's
        // preserved/root-carrying temp set inside hot loops and must not be clobbered here.
        emit_load_i64_imm(ctx, 9, mod)
        push_u32_le(ctx["code"], insn_udiv(10, 0, 9))
        push_u32_le(ctx["code"], insn_mul(10, 10, 9))
        push_u32_le(ctx["code"], insn_sub_reg(0, 0, 10))
    }
    return true
}

fn _arm64_emit_trace_list_header_if_enabled(ctx, list_reg) {
    if ctx == nil || ctx["trace_native_list_hdr"] == nil { return nil }
    if list_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(0, list_reg)) }
    emit_load_i64_imm(ctx, 1, 7) // list_int_push
    emit_load_i64_imm(ctx, 2, 8) // LIST_INT
    var bl_trace = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_trace, "name": "oren_trace_list_header"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_trace)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_trace_list_header")
    return nil
}


fn _arm64_emit_fast_list_int_get_sum_prefix_zero_while(ctx, stmt, info) { return prefixm._arm64_emit_fast_list_int_get_sum_prefix_zero_while(ctx, stmt, info) }
fn _arm64_emit_fast_list_int_dot_prefix_zero_while(ctx, stmt, info) { return prefixm._arm64_emit_fast_list_int_dot_prefix_zero_while(ctx, stmt, info) }

fn _arm64_emit_fast_list_int_get_sum_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    if _arm64_emit_fast_list_int_get_sum_prefix_zero_while(ctx, stmt, info) == true { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var loads = info["loads"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var load_count = oren_list_len(loads)
    var unique_lists = false
    if list_count == load_count { unique_lists = true }
    var single_read_list = false
    if unique_lists == true && list_count == 1 && load_count == 1 { single_read_list = true }
    var whole_list_helper = false
    // Keep the exact whole-list helper opt-in until the shared read-split probe shows a win.
    if single_read_list == true &&
        _arm64_local_int_const(ctx, idx_name) == 0 &&
        _arm64_local_int_const(ctx, sum_name) == 0 &&
        _arm64_env_enabled_default_false("OREN_NATIVE_FAST_LIST_INT_GET_SUM_WHOLE_LIST_HELPER") == true {
        whole_list_helper = true
    }
    var single_list_cursor_regs = false
    if single_read_list == true &&
        _arm64_env_enabled_default_true("OREN_ARM64_FAST_LIST_INT_GET_SUM_SINGLE_LIST_CURSOR_REGS") == true {
        single_list_cursor_regs = true
    }
    // The explicit list<int> get-sum path already has a dedicated 2-wide lowering. After the
    // reserved X27/X28 clobber bug was removed from the unrolled bodies, the exact `array_sum_int`
    // surface and the broad native/runtime gates both came back clean. Ship the common
    // single-read-list shape on the 2-wide path by default, but keep the env knob for broader A/B
    // experiments and emergency disable.
    var unroll2 = single_read_list
    var v_unroll2 = oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_UNROLL2")
    if v_unroll2 == "1" || v_unroll2 == "true" {
        unroll2 = true
    } else if v_unroll2 != nil && (v_unroll2 == "0" || v_unroll2 == "false") {
        unroll2 = false
    }
    // Keep the secondary-accumulator get-sum path as an explicit experiment only. The current
    // same-tree exact C-ceiling decision surface still prefers the shipped default scalar+unroll2
    // body overall, even though the narrower local acceptance wrapper can make this path look good.
    var dual_accum = false
    var v_dual_accum = oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_DUAL_ACCUM")
    if v_dual_accum == "1" || v_dual_accum == "true" {
        dual_accum = true
    } else if v_dual_accum != nil && (v_dual_accum == "0" || v_dual_accum == "false") {
        dual_accum = false
    }
    if single_read_list != true {
        dual_accum = false
    }
    var pair_post = false
    var v_pair_post = oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_PAIR_POST")
    if v_pair_post == "1" || v_pair_post == "true" {
        pair_post = true
    } else if v_pair_post != nil && (v_pair_post == "0" || v_pair_post == "false") {
        pair_post = false
    }
    var vector_2d = false
    var v_vector_2d = oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_VECTOR_2D")
    if v_vector_2d == "1" || v_vector_2d == "true" {
        vector_2d = true
    } else if v_vector_2d != nil && (v_vector_2d == "0" || v_vector_2d == "false") {
        vector_2d = false
    }
    if single_read_list != true {
        vector_2d = false
    }
    if vector_2d {
        unroll2 = true
        dual_accum = false
        pair_post = false
    }
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_GET_SUM_TICK_MASK", 4095)
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_int_get_sum_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_int_get_sum_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    gc.native_emit_gc_inline_tick_init(ctx, tick_mask)
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = _list_find_node_known_kind(list, LIST_INT)
        _arm64_emit_find_list_node_known_kind(ctx, 0, 0, 8)

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST_INT == 8)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 8)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // count < n => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_small = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    var jpos_helper_done = nil
    if whole_list_helper == true {
        emit_ldr_reg_sp_any(ctx, 19, list_base_off)
        emit_load_ptr_from_base_plus(ctx, 1, 19, 0)
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_helper_skip = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ne fast-loop path

        var helper_expr = {
            "type": "Call",
            "fn": {"type": "Identifier", "value": "oren_list_int_reduce_sum_slots_unchecked"},
            "args": [{"type": "Identifier", "value": lists[0]}]
        }
        var helper_base_stack = ctx["stack_size"]
        native_compile_expr(ctx, helper_expr)
        _arm64_restore_stack_to(ctx, helper_base_stack)
        emit_str_reg_fp_any(ctx, 0, sum_fp_off)
        emit_ldr_reg_sp_any(ctx, 0, n_off)
        emit_str_reg_fp_any(ctx, 0, idx_fp_off)
        jpos_helper_done = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b end

        var helper_skip_pos = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], jpos_helper_skip, insn_b_cond((helper_skip_pos - jpos_helper_skip) / 4, 1)) // NE
    }

    var safepoint_spill_pairs = []
    if unique_lists {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        var li_init = 0
        while li_init < list_count {
            var buf_slot_init = list_base_off + li_init * 16 + 8
            emit_ldr_reg_sp_any(ctx, 23, buf_slot_init)
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
            emit_str_reg_sp_any(ctx, 23, buf_slot_init)
            li_init = li_init + 1
        }
        if single_read_list && single_list_cursor_regs {
            // Mirror the proven dot single-pair cursor-reg path: keep the unique list<int> cursor in a
            // preserved register so the scalar body stops reloading and re-storing the only active buf
            // slot on every iteration.
            emit_ldr_reg_sp_any(ctx, 19, list_base_off + 8)
            safepoint_spill_pairs = [[19, 20]]
        }
    }

    // Keep i/sum in registers across iterations.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, sum_off)
    if dual_accum {
        push_u32_le(ctx["code"], insn_movz(22, 0))
    } else {
        emit_load_i64_imm(ctx, 22, 8)
    }
    if unique_lists {
        // Unique-list get-sum does not need X21 as a loop-body scratch, so keep the upper bound hot
        // instead of reloading it from the stack every iteration.
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    if unique_lists != true {
        emit_ldr_reg_sp_any(ctx, 21, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    } else {
        push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    }
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    var jpos_fast_single = nil
    var jpos_fast_quad = nil
    if unroll2 == true {
        if single_read_list {
            push_u32_le(ctx["code"], insn_add_imm(24, 20, 3))
            push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
            jpos_fast_quad = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.ge double/single
        }
        push_u32_le(ctx["code"], insn_add_imm(24, 20, 1))
        push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
        jpos_fast_single = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ge single
    }

    gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, safepoint_spill_pairs)

    if unique_lists != true {
        // idx_offset = i * 8 (reuse for all list loads)
        push_u32_le(ctx["code"], insn_mul(24, 20, 22))
    }

    if unroll2 == true {
        if single_read_list {
            var buf_slot_quad = list_base_off + 8
            if vector_2d {
                if single_list_cursor_regs {
                    push_u32_le(ctx["code"], insn_mov_reg(24, 19))
                } else {
                    emit_ldr_reg_sp_any(ctx, 24, buf_slot_quad)
                }
                push_u32_le(ctx["code"], insn_ldr_q(0, 24))
                push_u32_le(ctx["code"], insn_ldr_q_off(1, 24, 16))
                push_u32_le(ctx["code"], insn_add_imm(24, 24, 32))
                if single_list_cursor_regs {
                    push_u32_le(ctx["code"], insn_mov_reg(19, 24))
                } else {
                    emit_str_reg_sp_any(ctx, 24, buf_slot_quad)
                }

                push_u32_le(ctx["code"], insn_add_2d(0, 0, 1))
                push_u32_le(ctx["code"], insn_addp_2d(0, 0, 0))
                push_u32_le(ctx["code"], insn_umov_x_d(25, 0))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            } else {
                if single_list_cursor_regs {
                    push_u32_le(ctx["code"], insn_mov_reg(24, 19))
                } else {
                    emit_ldr_reg_sp_any(ctx, 24, buf_slot_quad)
                }
                // Keep the extra loaded values in caller-saved scratch regs; X27/X28 are reserved
                // global heap registers and must never be reused as loop-body value temps.
                if pair_post {
                    // Experimental pair-load path: fold the cursor advance into adjacent loads.
                    push_u32_le(ctx["code"], insn_ldp_pair_post(25, 26, 24, 16))
                    push_u32_le(ctx["code"], insn_ldp_pair_post(12, 13, 24, 16))
                } else {
                    push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(26, 24, 8))
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 24, 16))
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(13, 24, 24))
                    push_u32_le(ctx["code"], insn_add_imm(24, 24, 32))
                }
                if single_list_cursor_regs {
                    push_u32_le(ctx["code"], insn_mov_reg(19, 24))
                } else {
                    emit_str_reg_sp_any(ctx, 24, buf_slot_quad)
                }

                if dual_accum {
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                    push_u32_le(ctx["code"], insn_add_reg(22, 22, 26))
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 12))
                    push_u32_le(ctx["code"], insn_add_reg(22, 22, 13))
                } else {
                    push_u32_le(ctx["code"], insn_add_reg(25, 25, 12))
                    push_u32_le(ctx["code"], insn_add_reg(26, 26, 13))
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 26))
                }
            }

            push_u32_le(ctx["code"], insn_add_imm(20, 20, 4))

            var back_pos4 = bytes_len(ctx["code"])
            var back_off4 = (loop_cond_pos - back_pos4) / 4
            push_u32_le(ctx["code"], insn_b(back_off4))
        }

        var fast_double_pos = bytes_len(ctx["code"])
        if jpos_fast_quad != nil {
            var quad_off = (fast_double_pos - jpos_fast_quad) / 4
            set_u32_le(ctx["code"], jpos_fast_quad, insn_b_cond(quad_off, 10)) // GE
        }

        if vector_2d && single_read_list {
            var buf_slot2u_vec = list_base_off + 8
            if single_list_cursor_regs {
                push_u32_le(ctx["code"], insn_mov_reg(24, 19))
            } else {
                emit_ldr_reg_sp_any(ctx, 24, buf_slot2u_vec)
            }
            push_u32_le(ctx["code"], insn_ldr_q(0, 24))
            push_u32_le(ctx["code"], insn_add_imm(24, 24, 16))
            if single_list_cursor_regs {
                push_u32_le(ctx["code"], insn_mov_reg(19, 24))
            } else {
                emit_str_reg_sp_any(ctx, 24, buf_slot2u_vec)
            }
            push_u32_le(ctx["code"], insn_addp_2d(0, 0, 0))
            push_u32_le(ctx["code"], insn_umov_x_d(25, 0))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        } else {
            var pi2 = 0
            while pi2 < oren_list_len(loads) {
                var list_name2 = loads[pi2]
                var list_index2 = 0
                while list_index2 < list_count {
                    if _arm64_str_eq_bytes(lists[list_index2], list_name2) { break }
                    list_index2 = list_index2 + 1
                }
                var buf_slot2u = list_base_off + list_index2 * 16 + 8

                if single_read_list && single_list_cursor_regs {
                    push_u32_le(ctx["code"], insn_mov_reg(24, 19))
                } else {
                    emit_ldr_reg_sp_any(ctx, 24, buf_slot2u)
                }
                if pair_post {
                    push_u32_le(ctx["code"], insn_ldp_pair_post(25, 26, 24, 16))
                } else {
                    push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(26, 24, 8))
                    push_u32_le(ctx["code"], insn_add_imm(24, 24, 16))
                }
                if single_read_list && single_list_cursor_regs {
                    push_u32_le(ctx["code"], insn_mov_reg(19, 24))
                } else {
                    emit_str_reg_sp_any(ctx, 24, buf_slot2u)
                }

                if single_read_list && dual_accum {
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                    push_u32_le(ctx["code"], insn_add_reg(22, 22, 26))
                } else if single_read_list {
                    push_u32_le(ctx["code"], insn_add_reg(25, 25, 26))
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                } else {
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 26))
                }

                pi2 = pi2 + 1
            }
        }

        // i += 2
        push_u32_le(ctx["code"], insn_add_imm(20, 20, 2))

        var back_pos2 = bytes_len(ctx["code"])
        var back_off2 = (loop_cond_pos - back_pos2) / 4
        push_u32_le(ctx["code"], insn_b(back_off2))

        var fast_single_pos = bytes_len(ctx["code"])
        var single_off = (fast_single_pos - jpos_fast_single) / 4
        set_u32_le(ctx["code"], jpos_fast_single, insn_b_cond(single_off, 10)) // GE

        gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, safepoint_spill_pairs)
    }

    var pi = 0
    while pi < oren_list_len(loads) {
        var list_name2 = loads[pi]
        var list_index = 0
        while list_index < list_count {
            if _arm64_str_eq_bytes(lists[list_index], list_name2) { break }
            list_index = list_index + 1
        }
        var buf_slot2 = list_base_off + list_index * 16 + 8

        if unique_lists {
            if single_read_list && single_list_cursor_regs {
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
                push_u32_le(ctx["code"], insn_add_imm(19, 19, 8))
            } else {
                emit_ldr_reg_sp_any(ctx, 24, buf_slot2)
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                push_u32_le(ctx["code"], insn_add_reg(24, 24, 22))
                emit_str_reg_sp_any(ctx, 24, buf_slot2)
            }
        } else {
            // addr = buf + i*8 ; load value
            emit_ldr_reg_sp_any(ctx, 21, buf_slot2)
            push_u32_le(ctx["code"], insn_add_reg(25, 21, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 25))
        }
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))

        pi = pi + 1
    }

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    listm._arm64_trace_loop_range(ctx, trace_kind, loop_cond_pos, fast_end_pos)
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    if dual_accum {
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
    }

    // Update idx/sum locals after loop exit.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))
    if jpos_helper_done != nil {
        set_u32_le(ctx["code"], jpos_helper_done, insn_b((end_pos - jpos_helper_done) / 4))
    }

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_int_dot_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    if _arm64_emit_fast_list_int_dot_prefix_zero_while(ctx, stmt, info) == true { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var muls = info["muls"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var mul_count = oren_list_len(muls)
    var unique_lists = false
    if list_count == mul_count * 2 { unique_lists = true }
    var single_mul_pair = false
    if unique_lists == true && list_count == 2 && mul_count == 1 { single_mul_pair = true }
    var whole_list_helper = false
    // Keep the exact whole-list helper opt-in until the shared read-split probe shows a win.
    if mul_count == 1 &&
        _arm64_local_int_const(ctx, idx_name) == 0 &&
        _arm64_local_int_const(ctx, sum_name) == 0 &&
        _arm64_env_enabled_default_false("OREN_NATIVE_FAST_LIST_INT_DOT_WHOLE_LIST_HELPER") == true {
        whole_list_helper = true
    }
    var single_pair_cursor_regs = true
    var v_single_pair_cursor_regs = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_SINGLE_PAIR_CURSOR_REGS")
    if v_single_pair_cursor_regs != nil && (v_single_pair_cursor_regs == "0" || v_single_pair_cursor_regs == "false") {
        single_pair_cursor_regs = false
    }
    var low32_loads = false
    if single_mul_pair &&
        single_pair_cursor_regs &&
        _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_DOT_LOW32_LOADS") == true {
        low32_loads = true
    }
    var dual_accum = false
    var v_dual_accum = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_DUAL_ACCUM")
    if v_dual_accum == "1" || v_dual_accum == "true" {
        dual_accum = true
    } else if v_dual_accum != nil && (v_dual_accum == "0" || v_dual_accum == "false") {
        dual_accum = false
    }
    var dual_madd = false
    var v_dual_madd = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_DUAL_MADD")
    if dual_accum && (v_dual_madd == "1" || v_dual_madd == "true") {
        dual_madd = true
    } else if v_dual_madd != nil && (v_dual_madd == "0" || v_dual_madd == "false") {
        dual_madd = false
    }
    var madd_exact = false
    var v_madd_exact = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT")
    if v_madd_exact == "1" || v_madd_exact == "true" {
        madd_exact = true
    } else if v_madd_exact != nil && (v_madd_exact == "0" || v_madd_exact == "false") {
        madd_exact = false
    }
    var madd_exact_quad = madd_exact
    var v_madd_exact_quad = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_QUAD")
    if v_madd_exact_quad == "1" || v_madd_exact_quad == "true" {
        madd_exact_quad = true
    } else if v_madd_exact_quad != nil && (v_madd_exact_quad == "0" || v_madd_exact_quad == "false") {
        madd_exact_quad = false
    }
    var madd_exact_double = madd_exact
    var v_madd_exact_double = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_DOUBLE")
    if v_madd_exact_double == "1" || v_madd_exact_double == "true" {
        madd_exact_double = true
    } else if v_madd_exact_double != nil && (v_madd_exact_double == "0" || v_madd_exact_double == "false") {
        madd_exact_double = false
    }
    // On the post-unroll2 baseline, the scalar exact-madd tail is no longer a clear default-on win.
    // Keep it as an explicit opt-in until the current scalar-core matrix turns into a durable across-
    // surface improvement instead of a steady-vs-gate trade-off.
    var madd_exact_scalar = false
    var v_madd_exact_scalar = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_SCALAR")
    if v_madd_exact_scalar == "1" || v_madd_exact_scalar == "true" {
        madd_exact_scalar = true
    } else if v_madd_exact_scalar != nil && (v_madd_exact_scalar == "0" || v_madd_exact_scalar == "false") {
        madd_exact_scalar = false
    }
    var scalar_post = false
    if _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_DOT_SCALAR_POST") == true {
        scalar_post = true
    }
    // The old unique-list default-on unroll2 path now loses on both generic and explicit raw
    // medians on the current host. Keep it as an explicit opt-in experiment instead of shipping it.
    var unroll2 = false
    var pair_post = false
    var v_pair_post = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_PAIR_POST")
    if v_pair_post == "1" || v_pair_post == "true" {
        pair_post = true
    } else if v_pair_post != nil && (v_pair_post == "0" || v_pair_post == "false") {
        pair_post = false
    }
    var v_unroll2 = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_UNROLL2")
    if v_unroll2 == "1" || v_unroll2 == "true" {
        unroll2 = true
    } else if v_unroll2 != nil && (v_unroll2 == "0" || v_unroll2 == "false") {
        unroll2 = false
    }
    // Fast int-dot loops keep the throttled safepoint tick in registers on the hot path.
    // The old dedicated stack tick slot was only kept as a debug escape hatch while we traced
    // potential arm64 offset regressions. Those traces are now clean, so make the slot-free
    // layout the default and allow opt-in restoration for comparison.
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_INT_DOT_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_DOT_TICK_MASK", 4095)
    var safepoint_spill_pairs = []
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_int_dot_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_int_dot_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    gc.native_emit_gc_inline_tick_init(ctx, tick_mask)
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = _list_find_node_known_kind(list, LIST_INT)
        _arm64_emit_find_list_node_known_kind(ctx, 0, 0, 8)

