// Public wrappers (avoid relying on underscore-prefixed names from imports).
fn native_analyze_stmt_list_to_ops(ctx, stmts) { return _analyze_stmt_list_to_ops(ctx, stmts) }
fn native_analyze_supported_fn_body(ctx, fn_node) { return _analyze_supported_fn_body(ctx, fn_node) }
fn native_expr_int_check(ctx, expr, locals) { return _expr_int_check(ctx, expr, locals) }
fn native_cond_is_cmp_infix(cond) { return _cond_is_cmp_infix(cond) }
fn native_cond_false_cc(cond_op) { return _cond_false_cc(cond_op) }
fn native_cond_true_cc(cond_op) { return _cond_true_cc(cond_op) }
fn native_cond_false_cc_for_cond(cond) { return _cond_false_cc_for_cond(cond) }
