import core "arm64_core.oren"
import exprm "arm64_native_expr.oren"
import sysm "arm64_native_expr_syscalls.oren"
import abi "arm64_abi_macos.oren"
import labi "arm64_abi_linux.oren"

// Re-export core helpers locally so the native stmt compiler stays readable.
fn bytes_new() { return core.bytes_new() }
fn bytes_push(b, v) { return core.bytes_push(b, v) }
fn bytes_extend(b, other) { return core.bytes_extend(b, other) }
fn bytes_extend_list(b, xs) { return core.bytes_extend_list(b, xs) }
fn bytes_len(b) { return core.bytes_len(b) }
fn bytes_finalize(b) { return core.bytes_finalize(b) }
fn set_u32_le(buf, offset, n) { return core.set_u32_le(buf, offset, n) }
fn align_up(n, align) { return core.align_up(n, align) }
fn ceil_div(a, b) { return core.ceil_div(a, b) }
fn int_mod(a, b) { return core.int_mod(a, b) }
fn contains_curly_braces(s) { return core.contains_curly_braces(s) }

fn scope_enter_codegen(ctx) { return core.scope_enter_codegen(ctx) }
fn scope_current_codegen(ctx) { return core.scope_current_codegen(ctx) }
fn scope_mark_declared_codegen(ctx, name, prev_off, prev_floaty, prev_stringy, prev_list_stringy) { return core.scope_mark_declared_codegen(ctx, name, prev_off, prev_floaty, prev_stringy, prev_list_stringy) }
fn scope_exit_codegen(ctx) { return core.scope_exit_codegen(ctx) }

fn push_u32_le(buf, n) { return core.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return core.push_u64_le(buf, n) }
fn push_u32_be(buf, n) { return core.push_u32_be(buf, n) }

fn insn_add_imm(rd, rn, imm) { return core.insn_add_imm(rd, rn, imm) }
fn insn_add_sp(imm) { return core.insn_add_sp(imm) }
fn insn_add_reg(rd, rn, rm) { return core.insn_add_reg(rd, rn, rm) }
fn insn_and_reg(rd, rn, rm) { return core.insn_and_reg(rd, rn, rm) }
fn insn_b(off) { return core.insn_b(off) }
fn insn_b_cond(off, cond) { return core.insn_b_cond(off, cond) }
fn insn_cmp_reg(rn, rm) { return core.insn_cmp_reg(rn, rm) }
fn insn_ldp_post() { return core.insn_ldp_post() }
fn insn_ldr_reg_sp(reg, offset) { return core.insn_ldr_reg_sp(reg, offset) }
fn insn_ldur_reg(rt, rn, offset) { return core.insn_ldur_reg(rt, rn, offset) }
fn insn_mov_fp_sp() { return core.insn_mov_fp_sp() }
fn insn_mov_reg(rd, rn) { return core.insn_mov_reg(rd, rn) }
fn insn_mov_sp_fp() { return core.insn_mov_sp_fp() }
fn insn_movz(reg, imm16) { return core.insn_movz(reg, imm16) }
fn insn_mul(rd, rn, rm) { return core.insn_mul(rd, rn, rm) }
fn insn_ret() { return core.insn_ret() }
fn insn_stp_pre() { return core.insn_stp_pre() }
fn insn_stur_reg(rt, rn, offset) { return core.insn_stur_reg(rt, rn, offset) }
fn insn_str_ptr(rt, rn) { return core.insn_str_ptr(rt, rn) }
fn insn_str_reg_sp(reg, offset) { return core.insn_str_reg_sp(reg, offset) }
fn insn_str_x0_sp(offset) { return core.insn_str_x0_sp(offset) }
fn insn_sub_sp(imm) { return core.insn_sub_sp(imm) }
fn insn_svc(imm) { return core.insn_svc(imm) }

fn emit_ldr_reg_sp_any(ctx, reg, offset) { return core.emit_ldr_reg_sp_any(ctx, reg, offset) }
fn emit_str_reg_sp_any(ctx, reg, offset) { return core.emit_str_reg_sp_any(ctx, reg, offset) }
fn emit_load_ptr_from_base_plus(ctx, dst, base, offset_bytes) { return core.emit_load_ptr_from_base_plus(ctx, dst, base, offset_bytes) }
fn emit_load_i64_imm(ctx, reg, val) { return core.emit_load_i64_imm(ctx, reg, val) }

// Delegate expression compilation to the expr module.
fn native_compile_expr(ctx, expr) { return exprm.native_compile_expr(ctx, expr) }
fn native_error(ctx, tok, msg) { return exprm.native_error(ctx, tok, msg) }

fn native_emit_gc_safepoint_throttled(ctx, loop_base_stack, tick_mask) {
    // PERF:
    // Calling `oren_gc_safepoint()` on every loop iteration dominates lexer/parser loops.
    // Emit a cheap counter+mask gate so we only call into the runtime periodically.
    //
    // Contract:
    // - Caller must ensure a u64 tick slot exists at loop_base_stack (offset 0 when SP==base).
    // - Uses X9/X10 as scratch (caller-saved).
    //
    // tick = tick + 1; if (tick & mask) != 0 => skip; else call safepoint.
    var tick_off = ctx["stack_size"] - loop_base_stack
    // Load tick into X9.
    emit_ldr_reg_sp_any(ctx, 9, tick_off)
    // tick++
    push_u32_le(ctx["code"], insn_add_imm(9, 9, 1))
    emit_str_reg_sp_any(ctx, 9, tick_off)
    // if ((tick & mask) != 0) goto skip
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))
    push_u32_le(ctx["code"], insn_and_reg(9, 9, 10))
    push_u32_le(ctx["code"], insn_cmp_reg(9, 31))
    var jskip_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ne skip

    var bl_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_gc_safepoint"})

    var after_call = bytes_len(ctx["code"])
    var off = (after_call - jskip_pos) / 4
    // cond=1 is NE in the AArch64 condition-code encoding.
    set_u32_le(ctx["code"], jskip_pos, insn_b_cond(off, 1))
    return nil
}

fn native_compile_stmt(ctx, stmt) {
    if stmt["type"] == "Spawn" {
        // Delegate to expression compilation, ignore result (X0)
        var expr = {"type": "SpawnExpr", "call": stmt["call"]}
        native_compile_expr(ctx, expr)
        return nil
    }
    if stmt["type"] == "Break" {
        var loop = ctx["loop_ctx"]
        if loop == nil {
            native_error(ctx, stmt["token"], "native backend: break outside of loop")
            return nil
        }

        // Restore stack to the loop base before leaving.
        var base_stack = loop["base_stack"]
        var delta = ctx["stack_size"] - base_stack
        if delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(delta))
        }

        // Jump to loop end (patched after body is compiled).
        var jpos = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(loop["break_jumps"], jpos)
        return nil
    }
    if stmt["type"] == "Continue" {
        var loop2 = ctx["loop_ctx"]
        if loop2 == nil {
            native_error(ctx, stmt["token"], "native backend: continue outside of loop")
            return nil
        }

        // Restore stack to the loop base before continuing.
        var base_stack2 = loop2["base_stack"]
        var delta2 = ctx["stack_size"] - base_stack2
        if delta2 > 0 {
            push_u32_le(ctx["code"], insn_add_sp(delta2))
        }

        // Jump to the loop-specific continue target.
        // - while: condition start
        // - for: post start (so post runs before re-checking condition)
        var cont = loop2["continue_pos"]
        if cont != nil {
            var back_pos = bytes_len(ctx["code"])
            var back_off = (cont - back_pos) / 4
            push_u32_le(ctx["code"], insn_b(back_off))
        } else {
            // Patch later (used for `for`, whose post-start is only known after body compilation).
            var jpos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(loop2["continue_jumps"], jpos)
        }
        return nil
    }
    if stmt["type"] == "Block" {
        if ctx["in_function"] {
            scope_enter_codegen(ctx)
        }
        var base_stack = ctx["stack_size"]
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            native_compile_stmt(ctx, stmts[i])
            i = i + 1
        }
        var delta = ctx["stack_size"] - base_stack
        if delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(delta))
            ctx["stack_size"] = base_stack
        }
        if ctx["in_function"] {
            scope_exit_codegen(ctx)
        }
        return nil
    }

    if stmt["type"] == "Set" {
        if stmt["left"]["type"] == "Index" {
            native_compile_expr(ctx, stmt["left"]["left"]) // container -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            native_compile_expr(ctx, stmt["left"]["index"]) // index -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            native_compile_expr(ctx, stmt["value"]) // value -> X0
            
            // Pop index -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // Pop container -> X2
            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // oren_index_set(container, index, value)
            // Need X0=container, X1=index, X2=value
            // Currently: X0=value, X1=index, X2=container
            
            push_u32_le(ctx["code"], insn_mov_reg(3, 0)) // val -> X3
            push_u32_le(ctx["code"], insn_mov_reg(0, 2)) // cont -> X0
            // X1 is index (ok)
            push_u32_le(ctx["code"], insn_mov_reg(2, 3)) // val -> X2

            // Native backend fast-path: list in-bounds store without calling stdlib.
            // Falls back to typed `oren_map_set_{int,str}` for map containers (deterministic; no runtime key-kind inference).

            // If container is nil, panic deterministically.
            push_u32_le(ctx["code"], insn_movz(4, 0))
            push_u32_le(ctx["code"], insn_cmp_reg(0, 4))
            var br_non_nil = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            exprm.native_emit_panic(ctx, "index_set on nil")
            var non_nil_pos = bytes_len(ctx["code"])
            set_u32_le(ctx["code"], br_non_nil, insn_b_cond((non_nil_pos - br_non_nil) / 4, 1)) // NE

            // Tier‑1 safety: never read object headers from untracked pointers.
            //
            // In the native v0 carrier model, immediates and pointers share the same i64 slot, so we
            // must only treat `container` as a list/map pointer if it is tracked.
            //
            // Use the same tracked-node kind contract as the runtime (and as x86_64):
            // - kind==2 => LIST
            // - kind==3 => MAP
            //
            // Preserve container/index/value across the probe call using callee-saved registers.
            push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = container
            push_u32_le(ctx["code"], insn_mov_reg(20, 1)) // X20 = index
            push_u32_le(ctx["code"], insn_mov_reg(21, 2)) // X21 = value

            // node = oren_find_node(container)
            push_u32_le(ctx["code"], insn_mov_reg(0, 19))
            var bl_find_node = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find_node, "name": "oren_find_node"})

            // If node == 0 => not a tracked container => panic deterministically.
            push_u32_le(ctx["code"], insn_movz(4, 0))
            push_u32_le(ctx["code"], insn_cmp_reg(0, 4))
            var br_node_nonzero = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            var recv_kind0 = stmt["left"]["recv_kind"]
            if recv_kind0 == "list" {
                exprm.native_emit_panic(ctx, "index_set recv_kind=list but value is not a list")
            } else if recv_kind0 == "map" {
                exprm.native_emit_panic(ctx, "index_set recv_kind=map but value is not a map")
            } else {
                exprm.native_emit_panic(ctx, "index_set on non-container (expected list or map)")
            }
            var node_ok_pos = bytes_len(ctx["code"])
            set_u32_le(ctx["code"], br_node_nonzero, insn_b_cond((node_ok_pos - br_node_nonzero) / 4, 1)) // NE

            // kind = *(node + 16)
            emit_load_ptr_from_base_plus(ctx, 4, 0, 16) // X4 = kind

            // Dispatch to list vs map.
            var br_to_map = nil
            if recv_kind0 == "list" {
                emit_load_i64_imm(ctx, 5, 2) // X5 = LIST
                push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
                var br_is_list = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                exprm.native_emit_panic(ctx, "index_set recv_kind=list but value is not a list")
                var list_ok_pos = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_is_list, insn_b_cond((list_ok_pos - br_is_list) / 4, 0)) // EQ
            } else if recv_kind0 == "map" {
                emit_load_i64_imm(ctx, 5, 3) // X5 = MAP
                push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
                br_to_map = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                exprm.native_emit_panic(ctx, "index_set recv_kind=map but value is not a map")
                // map label is patched later; list block will be skipped by the branch.
            } else {
                // Unknown at compile-time => dynamic kind dispatch (LIST or MAP).
                emit_load_i64_imm(ctx, 5, 2) // X5 = LIST
                push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
                var br_is_list2 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                emit_load_i64_imm(ctx, 5, 3) // X5 = MAP
                push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
                br_to_map = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                exprm.native_emit_panic(ctx, "index_set on non-container (expected list or map)")
                var list_pos = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_is_list2, insn_b_cond((list_pos - br_is_list2) / 4, 0)) // EQ
                // If kind==MAP, `br_to_map` is patched later to map_pos.
            }

            // --- List path ---
            // Restore container/index/value (X0=container, X1=index, X2=value).
            push_u32_le(ctx["code"], insn_mov_reg(0, 19))
            push_u32_le(ctx["code"], insn_mov_reg(1, 20))
            push_u32_le(ctx["code"], insn_mov_reg(2, 21))
            // count = *(container + 0)
            emit_load_ptr_from_base_plus(ctx, 6, 0, 0) // X6 = count

            // idx < 0 => panic
            push_u32_le(ctx["code"], insn_movz(4, 0))
            push_u32_le(ctx["code"], insn_cmp_reg(1, 4))
            var br_nonneg = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            exprm.native_emit_panic(ctx, "Index out of bounds (negative)")
            var nonneg_pos = bytes_len(ctx["code"])
            set_u32_le(ctx["code"], br_nonneg, insn_b_cond((nonneg_pos - br_nonneg) / 4, 10)) // GE

            // idx >= count => panic
            push_u32_le(ctx["code"], insn_cmp_reg(1, 6))
            var br_in_bounds = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            exprm.native_emit_panic(ctx, "Index out of bounds")
            var in_bounds_pos = bytes_len(ctx["code"])
            set_u32_le(ctx["code"], br_in_bounds, insn_b_cond((in_bounds_pos - br_in_bounds) / 4, 11)) // LT

            // buf = *(container + 16)
            emit_load_ptr_from_base_plus(ctx, 6, 0, 16) // X6 = buf

            // buf == 0 => panic (should only happen for empty lists, but keep it deterministic)
            push_u32_le(ctx["code"], insn_movz(4, 0))
            push_u32_le(ctx["code"], insn_cmp_reg(6, 4))
            var br_buf_ok = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            exprm.native_emit_panic(ctx, "list buffer is nil")
            var buf_ok_pos = bytes_len(ctx["code"])
            set_u32_le(ctx["code"], br_buf_ok, insn_b_cond((buf_ok_pos - br_buf_ok) / 4, 1)) // NE

            // addr = buf + idx*8
            emit_load_i64_imm(ctx, 4, 8)
            push_u32_le(ctx["code"], insn_mul(7, 1, 4))     // X7 = idx*8
            push_u32_le(ctx["code"], insn_add_reg(7, 6, 7)) // X7 = buf + off

            // *(addr) = value
            push_u32_le(ctx["code"], insn_str_ptr(2, 7))

            // Done.
            var br_done = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)

            // --- Map fallback ---
            var map_pos = bytes_len(ctx["code"])
            // Restore container/index/value (X0=container, X1=index, X2=value).
            push_u32_le(ctx["code"], insn_mov_reg(0, 19))
            push_u32_le(ctx["code"], insn_mov_reg(1, 20))
            push_u32_le(ctx["code"], insn_mov_reg(2, 21))
            var bl_pos = bytes_len(ctx["code"])
            var recv_kind = stmt["left"]["recv_kind"]
            if recv_kind == "list" {
                // Deterministic contract: list index_set never falls back to map ops.
                exprm.native_emit_panic(ctx, "index_set recv_kind=list but value is not a list")
            } else {
                // Typed map set (no key-kind heuristics).
                var kk = -1
                if stmt["left"]["known_key_kind"] != nil { kk = stmt["left"]["known_key_kind"] }
                if kk < 0 {
                    var ix = stmt["left"]["index"]
                    if ix != nil {
                        if ix["type"] == "Integer" { kk = 0 }
                        if ix["type"] == "String" { kk = 1 }
                    }
                }

                var map_set_sym = nil
                if kk == 0 { map_set_sym = "oren_map_set_int" }
                if kk == 1 { map_set_sym = "oren_map_set_str" }

                if map_set_sym == nil {

                    // Dynamic map set: delegate key-kind selection to the injected runtime helper.

                    var bl_pos2 = bytes_len(ctx["code"])

                    push_u32_le(ctx["code"], 0)

                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos2, "name": "oren_map_set"})

                } else {
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": map_set_sym})
                }
            }

            var done_pos = bytes_len(ctx["code"])
            if br_to_map != nil {
                set_u32_le(ctx["code"], br_to_map, insn_b_cond((map_pos - br_to_map) / 4, 0)) // EQ
            }
            set_u32_le(ctx["code"], br_done, insn_b((done_pos - br_done) / 4))

            return nil
        }
        if stmt["left"]["type"] == "Member" {
             // obj.prop = val -> oren_map_set_str(obj, "prop", val)
             // Similar logic, but index is string literal
             
             native_compile_expr(ctx, stmt["left"]["left"]) // obj -> X0
             push_u32_le(ctx["code"], insn_sub_sp(16))
             push_u32_le(ctx["code"], insn_str_x0_sp(0))
             ctx["stack_size"] = ctx["stack_size"] + 16
             
             // Prop name string
             var prop = stmt["left"]["prop"]["value"]
             var bytes = oren_bytes_from_string(prop)
             oren_list_push(bytes, 0)
             while int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
             var data_off = bytes_len(ctx["data"])
             bytes_extend_list(ctx["data"], bytes)
             var adr_pos = bytes_len(ctx["code"])
             push_u32_le(ctx["code"], 0)
             push_u32_le(ctx["code"], 0)
             oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off})
             // X0 has key ptr
             push_u32_le(ctx["code"], insn_movz(1, 1)) // X1 = kind STRING
             var bl_track = bytes_len(ctx["code"])
             push_u32_le(ctx["code"], 0)
             oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_track, "name": "oren_ensure_tracked"})
             
             push_u32_le(ctx["code"], insn_sub_sp(16))
             push_u32_le(ctx["code"], insn_str_x0_sp(0))
             ctx["stack_size"] = ctx["stack_size"] + 16
             
             native_compile_expr(ctx, stmt["value"]) // val -> X0
             
             // Pop key -> X1
             push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
             push_u32_le(ctx["code"], insn_add_sp(16))
             ctx["stack_size"] = ctx["stack_size"] - 16
             
             // Pop obj -> X2
             push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
             push_u32_le(ctx["code"], insn_add_sp(16))
             ctx["stack_size"] = ctx["stack_size"] - 16
             
             // Need X0=obj, X1=key, X2=val
             // Currently: X0=val, X1=key, X2=obj
             push_u32_le(ctx["code"], insn_mov_reg(3, 0)) // val -> X3
             push_u32_le(ctx["code"], insn_mov_reg(0, 2)) // obj -> X0
             // X1 is key (ok)
             push_u32_le(ctx["code"], insn_mov_reg(2, 3)) // val -> X2
             
             var bl_pos2 = bytes_len(ctx["code"])
             push_u32_le(ctx["code"], 0)
             oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos2, "name": "oren_map_set_str"})
             
             return nil
        }
        native_error(ctx, stmt["token"], "native backend: unsupported set target")
        return nil
    }

    if stmt["type"] == "Assign" {
        native_compile_expr(ctx, stmt["value"])
        var is_floaty = exprm.native_expr_is_floaty(ctx, stmt["value"])
        var is_stringy = exprm.native_expr_is_stringy(ctx, stmt["value"])
        var is_list_stringy = exprm.native_expr_is_list_stringy(ctx, stmt["value"])
        
        var name = stmt["name"]["value"]
        var off = ctx["locals"][name]
        if off != nil {
            var current_sp_off = ctx["stack_size"] - off - 16
            emit_str_reg_sp_any(ctx, 0, current_sp_off)
            if ctx["locals_floaty"] != nil { ctx["locals_floaty"][name] = is_floaty }
            if ctx["locals_stringy"] != nil { ctx["locals_stringy"][name] = is_stringy }
            if ctx["locals_list_stringy"] != nil { ctx["locals_list_stringy"][name] = is_list_stringy }
            return nil
        }
        
        var global_off = ctx["globals"][name]
        if global_off != nil {
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            var adr_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": global_off})
            push_u32_le(ctx["code"], insn_add_imm(1, 0, 0))
            
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            push_u32_le(ctx["code"], insn_str_ptr(0, 1))
            if ctx["globals_floaty"] != nil { ctx["globals_floaty"][name] = is_floaty }
            if ctx["globals_stringy"] != nil { ctx["globals_stringy"][name] = is_stringy }
            if ctx["globals_list_stringy"] != nil { ctx["globals_list_stringy"][name] = is_list_stringy }
            return nil
        }
        
        native_error(ctx, stmt["token"], "native backend: assignment to undefined variable " + name)
        return nil
    }

    if stmt["type"] == "Var" {
        native_compile_expr(ctx, stmt["value"])
        var is_floaty2 = exprm.native_expr_is_floaty(ctx, stmt["value"])
        var is_stringy2 = exprm.native_expr_is_stringy(ctx, stmt["value"])
        var is_list_stringy2 = exprm.native_expr_is_list_stringy(ctx, stmt["value"])

        var name = stmt["name"]["value"]
        
        if ctx["in_function"] {
            // `var` introduces a new binding in the current lexical scope.
            // If the name was already declared in this same scope, treat it as
            // re-initialization for backward compatibility.
            var scope = scope_current_codegen(ctx)
            if scope != nil {
                if scope["names"][name] != nil {
                    var existing_off = ctx["locals"][name]
                    if existing_off != nil {
                        var current_sp_off_existing = ctx["stack_size"] - existing_off - 16
                        emit_str_reg_sp_any(ctx, 0, current_sp_off_existing)
                        if ctx["locals_floaty"] != nil { ctx["locals_floaty"][name] = is_floaty2 }
                        if ctx["locals_stringy"] != nil { ctx["locals_stringy"][name] = is_stringy2 }
                        if ctx["locals_list_stringy"] != nil { ctx["locals_list_stringy"][name] = is_list_stringy2 }
                        return nil
                    }
                }
            }
            
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))

            // Record previous binding so it can be restored when leaving the scope.
            var prev_off = ctx["locals"][name]
            var prev_floaty = nil
            if ctx["locals_floaty"] != nil { prev_floaty = ctx["locals_floaty"][name] }
            var prev_stringy = nil
            if ctx["locals_stringy"] != nil { prev_stringy = ctx["locals_stringy"][name] }
            var prev_list_stringy = nil
            if ctx["locals_list_stringy"] != nil { prev_list_stringy = ctx["locals_list_stringy"][name] }
            scope_mark_declared_codegen(ctx, name, prev_off, prev_floaty, prev_stringy, prev_list_stringy)

            ctx["locals"][name] = ctx["stack_size"]
            if ctx["locals_floaty"] != nil { ctx["locals_floaty"][name] = is_floaty2 }
            if ctx["locals_stringy"] != nil { ctx["locals_stringy"][name] = is_stringy2 }
            if ctx["locals_list_stringy"] != nil { ctx["locals_list_stringy"][name] = is_list_stringy2 }
            ctx["stack_size"] = ctx["stack_size"] + 16
        } else {
            var data_off = bytes_len(ctx["data"])
            var k = 0
            while k < 8 { bytes_push(ctx["data"], 0); k = k + 1 }
            ctx["globals"][name] = data_off
            if ctx["globals_floaty"] != nil { ctx["globals_floaty"][name] = is_floaty2 }
            if ctx["globals_stringy"] != nil { ctx["globals_stringy"][name] = is_stringy2 }
            if ctx["globals_list_stringy"] != nil { ctx["globals_list_stringy"][name] = is_list_stringy2 }
            
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            var adr_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off})
            push_u32_le(ctx["code"], insn_add_imm(1, 0, 0))
            
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            push_u32_le(ctx["code"], insn_str_ptr(0, 1))
        }
        return nil
    }
    
    if stmt["type"] == "Return" {
        native_compile_expr(ctx, stmt["value"])

        // Stack safety (native backend; rolling):
        // Decrement call depth before returning, but preserve X0 (return value)
        // across the helper call (AAPCS: X0 is caller-saved).
        //
        // IMPORTANT:
        // Do NOT spill at SP==FP, because [FP-64..FP-8] is the fixed callee-saved area.
        // Spill while SP is still below locals so we don't overwrite saved registers.
        if ctx["call_depth_enabled"] == true {
            // spill X0 below locals
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            var bl_exit = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_exit, "name": "oren_call_depth_exit"})

            // restore X0
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
        }

        push_u32_le(ctx["code"], insn_mov_sp_fp())

        // Rolling ABI hygiene (native backend):
        // Our generated functions must preserve a stable set of callee-saved registers.
        //
        // IMPORTANT:
        // - The native backend reserves X27/X28 as *global heap registers* (heap_limit/heap_ptr).
        // - Those registers are part of the native backend's global machine state and MUST NOT be
        //   saved/restored by function prologues/epilogues, otherwise heap pointer updates done
        //   inside callees would be rolled back on return (causing overlapping allocations and
        //   allocator metadata corruption).
        //
        // Therefore we preserve X19-X26 here, and treat X27/X28 as reserved globals.
        //
        // Saved layout is at fixed offsets from FP (X29):
        //   [FP-64..FP-8] = X19..X26 (8 regs * 8 bytes)
        // Restore after MOV SP, FP so locals are discarded but saved area is still readable.
        var save_base = 0 - 64
        var rr = 19
        while rr <= 26 {
            var off = save_base + (rr - 19) * 8
            push_u32_le(ctx["code"], insn_ldur_reg(rr, 29, off))
            rr = rr + 1
        }
        push_u32_le(ctx["code"], insn_ldp_post())
        push_u32_le(ctx["code"], insn_ret())
        return nil
    }
    
    if stmt["type"] == "For" {
        // Native `for`:
        // - init runs once
        // - cond checked before each iteration (nil => true)
        // - continue jumps to post start (so post runs), then loops back to cond
        // - break exits the loop

        var outer_base_stack = ctx["stack_size"]
        if stmt["init"] != nil { native_compile_stmt(ctx, stmt["init"]) }

        // GC tick local for throttling safepoints (u64 at SP+0 when at loop base).
        // Allocate once for the whole loop scope.
        push_u32_le(ctx["code"], insn_sub_sp(16))
        ctx["stack_size"] = ctx["stack_size"] + 16
        push_u32_le(ctx["code"], insn_movz(9, 0))
        emit_str_reg_sp_any(ctx, 9, 0)

        var loop_base_stack = ctx["stack_size"]
        var start_pos = bytes_len(ctx["code"])

        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "base_stack": loop_base_stack, "start_pos": start_pos, "continue_pos": nil, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop

        // Condition (nil => true)
        if stmt["cond"] != nil {
            native_compile_expr(ctx, stmt["cond"])
        } else {
            push_u32_le(ctx["code"], insn_movz(0, 1))
        }
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jump_end_pos = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)

        // GC safepoint on loop entry (parity with C backend), throttled for performance.
        // Call once per 256 iterations by default.
        native_emit_gc_safepoint_throttled(ctx, loop_base_stack, 255)

        native_compile_stmt(ctx, stmt["body"])

        // Ensure stack is restored to the loop base before post/next iter.
        var loop_delta = ctx["stack_size"] - loop_base_stack
        if loop_delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(loop_delta))
            ctx["stack_size"] = loop_base_stack
        }

        // Post clause (continue target).
        var post_start = bytes_len(ctx["code"])
        loop["continue_pos"] = post_start
        if stmt["post"] != nil { native_compile_stmt(ctx, stmt["post"]) }

        var post_delta = ctx["stack_size"] - loop_base_stack
        if post_delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(post_delta))
            ctx["stack_size"] = loop_base_stack
        }

        // Jump back to the condition.
        var loop_back_pos = bytes_len(ctx["code"])
        var back_off = (start_pos - loop_back_pos) / 4
        push_u32_le(ctx["code"], insn_b(back_off))

        var end_target = bytes_len(ctx["code"])
        var end_off = (end_target - jump_end_pos) / 4
        set_u32_le(ctx["code"], jump_end_pos, insn_b_cond(end_off, 0))

        // Patch breaks/continues recorded inside the loop body.
        var bi = 0
        while bi < oren_list_len(loop["break_jumps"]) {
            var bpos = loop["break_jumps"][bi]
            var boff = (end_target - bpos) / 4
            set_u32_le(ctx["code"], bpos, insn_b(boff))
            bi = bi + 1
        }
        var ci = 0
        while ci < oren_list_len(loop["continue_jumps"]) {
            var cpos = loop["continue_jumps"][ci]
            var coff = (post_start - cpos) / 4
            set_u32_le(ctx["code"], cpos, insn_b(coff))
            ci = ci + 1
        }

        ctx["loop_ctx"] = prev_loop

        // `for` introduces an init-scope like a block: pop init locals after the loop.
        // loop_base_stack includes the GC tick local.
        var init_delta = loop_base_stack - outer_base_stack
        if init_delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(init_delta))
            ctx["stack_size"] = outer_base_stack
        }
        return nil
    }
    
    if stmt["type"] == "FFI" {
        var name = stmt["name"]["value"]
        ctx["imports"][name] = true
        oren_list_push(ctx["import_list"], name)
        return nil
    }
    
    if stmt["type"] == "Type" {
        var name = stmt["name"]["value"]
        var fields = stmt["fields"]
        var n_fields = oren_list_len(fields)

        // Emit the constructor as a real function symbol so type constructors remain
        // first-class callables in native codegen.
        //
        // Rolling v0 decision: structs are map-shaped across backends.
        // Constructor returns a map with string keys:
        //   struct User { id, name }  =>  fn User(id, name) { return {"id":id,"name":name} }
        var jump_skip_pos = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)

        var func_start = bytes_len(ctx["code"])
        ctx["functions"][name] = func_start
        oren_list_push(ctx["function_names"], name)

        var old_locals = ctx["locals"]
        var old_locals_floaty = ctx["locals_floaty"]
        var old_locals_stringy = ctx["locals_stringy"]
        var old_locals_list_stringy = ctx["locals_list_stringy"]
        var old_stack_size = ctx["stack_size"]
        ctx["locals"] = {}
        ctx["locals_floaty"] = {}
        ctx["locals_stringy"] = {}
        ctx["locals_list_stringy"] = {}
        ctx["stack_size"] = 0

        ctx["in_function"] = true

        push_u32_le(ctx["code"], insn_stp_pre())
        push_u32_le(ctx["code"], insn_mov_fp_sp())
        ctx["stack_size"] = ctx["stack_size"] + 16

        // Save args to stack locals for uniform access.
        var i = 0
        while i < n_fields {
            var f_name = fields[i]["value"]
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_reg_sp(i, 0))
            ctx["locals"][f_name] = ctx["stack_size"]
            ctx["stack_size"] = ctx["stack_size"] + 16
            i = i + 1
        }

        // m = oren_new_map(n_fields)
        push_u32_le(ctx["code"], insn_movz(0, n_fields))
        var bl_new_map = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_map, "name": "oren_new_map"})

        var map_ptr_off = ctx["stack_size"]
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16

        // For each field: oren_map_set_str(m, "field", value)
        i = 0
        while i < n_fields {
            var f_name2 = fields[i]["value"]

            // Push obj (m) on stack.
            var m_sp_off = ctx["stack_size"] - map_ptr_off - 16
            emit_ldr_reg_sp_any(ctx, 0, m_sp_off) // X0 = m
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            // Build key string in data and push it on stack (adr_data loads into X0).
            var bytes = oren_bytes_from_string(f_name2)
            oren_list_push(bytes, 0)
            while int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
            var data_off = bytes_len(ctx["data"])
            bytes_extend_list(ctx["data"], bytes)
            var adr_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off})
            push_u32_le(ctx["code"], insn_movz(1, 1)) // X1 = kind STRING
            var bl_track = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_track, "name": "oren_ensure_tracked"})

            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            // Load value -> X0 (from saved local slot).
            var off = ctx["locals"][f_name2]
            var current_sp_off = ctx["stack_size"] - off - 16
            emit_ldr_reg_sp_any(ctx, 0, current_sp_off)

            // Pop key -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // Pop obj -> X2
            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // Need X0=obj, X1=key, X2=val (currently X0=val, X1=key, X2=obj).
            push_u32_le(ctx["code"], insn_mov_reg(3, 0)) // val -> X3
            push_u32_le(ctx["code"], insn_mov_reg(0, 2)) // obj -> X0
            // X1 is key (ok)
            push_u32_le(ctx["code"], insn_mov_reg(2, 3)) // val -> X2

            var bl_set = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set, "name": "oren_map_set_str"})

            i = i + 1
        }

        // return m
        var m_sp_off2 = ctx["stack_size"] - map_ptr_off - 16
        emit_ldr_reg_sp_any(ctx, 0, m_sp_off2)
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16

        push_u32_le(ctx["code"], insn_mov_sp_fp())
        push_u32_le(ctx["code"], insn_ldp_post())
        push_u32_le(ctx["code"], insn_ret())

        var func_end = bytes_len(ctx["code"])
        var skip_off = (func_end - jump_skip_pos) / 4
        set_u32_le(ctx["code"], jump_skip_pos, insn_b(skip_off))

        ctx["in_function"] = false

        ctx["locals"] = old_locals
        ctx["locals_floaty"] = old_locals_floaty
        ctx["locals_stringy"] = old_locals_stringy
        ctx["locals_list_stringy"] = old_locals_list_stringy
        ctx["stack_size"] = old_stack_size
        return nil
    }
    
    if stmt["type"] == "While" {
        // GC tick local for throttling safepoints (u64 at SP+0 when at loop base).
        push_u32_le(ctx["code"], insn_sub_sp(16))
        ctx["stack_size"] = ctx["stack_size"] + 16
        push_u32_le(ctx["code"], insn_movz(9, 0))
        emit_str_reg_sp_any(ctx, 9, 0)

        var loop_base_stack = ctx["stack_size"]
        var start_pos = bytes_len(ctx["code"])

        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "base_stack": loop_base_stack, "start_pos": start_pos, "continue_pos": start_pos, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop
        
        native_compile_expr(ctx, stmt["cond"])
        
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        
        var jump_end_pos = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) 

        // GC safepoint on loop entry (parity with C backend), throttled for performance.
        native_emit_gc_safepoint_throttled(ctx, loop_base_stack, 255)
        
        native_compile_stmt(ctx, stmt["body"])

        // Ensure stack is restored to the loop base before iterating.
        var loop_delta = ctx["stack_size"] - loop_base_stack
        if loop_delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(loop_delta))
            ctx["stack_size"] = loop_base_stack
        }
        
        var loop_back_pos = bytes_len(ctx["code"])
        var back_off = (start_pos - loop_back_pos) / 4
        push_u32_le(ctx["code"], insn_b(back_off))
        
        var end_target = bytes_len(ctx["code"])
        var end_off = (end_target - jump_end_pos) / 4
        set_u32_le(ctx["code"], jump_end_pos, insn_b_cond(end_off, 0)) 

        // Patch any breaks emitted inside the loop body to jump here.
        var bi = 0
        while bi < oren_list_len(loop["break_jumps"]) {
            var bpos = loop["break_jumps"][bi]
            var boff = (end_target - bpos) / 4
            set_u32_le(ctx["code"], bpos, insn_b(boff))
            bi = bi + 1
        }

        // Patch any continues that were emitted before the continue target was known.
        var ci = 0
        while ci < oren_list_len(loop["continue_jumps"]) {
            var cpos = loop["continue_jumps"][ci]
            var coff = (loop["continue_pos"] - cpos) / 4
            set_u32_le(ctx["code"], cpos, insn_b(coff))
            ci = ci + 1
        }

        // Pop loop context
        ctx["loop_ctx"] = prev_loop

        // Pop GC tick local
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16
        
        return nil
    }

    if stmt["type"] == "ExprStmt" {
        var expr = stmt["expr"]
        
        if expr["type"] == "If" {
            var base_stack = ctx["stack_size"]
            
            native_compile_expr(ctx, expr["cond"])
            
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            
            var jump_else_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) 
            
            native_compile_stmt(ctx, expr["consq"])

            var cons_delta = ctx["stack_size"] - base_stack
            if cons_delta > 0 {
                push_u32_le(ctx["code"], insn_add_sp(cons_delta))
                ctx["stack_size"] = base_stack
            }
            
            var jump_end_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) 
            
            var else_target = bytes_len(ctx["code"])
            var else_off = (else_target - jump_else_pos) / 4
            set_u32_le(ctx["code"], jump_else_pos, insn_b_cond(else_off, 0)) 
            
            if expr["alt"] != nil {
                native_compile_stmt(ctx, expr["alt"])
            }

            var alt_delta = ctx["stack_size"] - base_stack
            if alt_delta > 0 {
                push_u32_le(ctx["code"], insn_add_sp(alt_delta))
                ctx["stack_size"] = base_stack
            }
            
            var end_target = bytes_len(ctx["code"])
            var end_off = (end_target - jump_end_pos) / 4
            set_u32_le(ctx["code"], jump_end_pos, insn_b(end_off))
            
            return nil
        }
        
        if expr["type"] == "Function" {
            var fn_name = expr["name"]

            // Function expressions are only valid as lambdas in Tier‑1 native: name=="".
            //
            // Named functions are declarations and must only appear at top-level. Local
            // `fn name(...) { ... }` declarations are lowered earlier into:
            //   var name = fn (...) { ... }
            // so they compile via the uniform callable ABI (lambda wrappers).
            if fn_name == nil || fn_name == "" {
                native_compile_expr(ctx, expr)
                return nil
            }
            if ctx["in_function"] == true {
                native_error(ctx, expr["token"], "native backend: local fn decl not lowered (expected var name = fn (...) { ... })")
                return nil
            }

            while int_mod(bytes_len(ctx["code"]), 4) != 0 {
                bytes_push(ctx["code"], 0)
            }
            
            var jump_skip_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) 
            
            var func_start = bytes_len(ctx["code"])
            ctx["functions"][fn_name] = func_start
            oren_list_push(ctx["function_names"], fn_name)
            if fn_name == "main" {
                ctx["main_idx"] = func_start
            }
            
            var old_locals = ctx["locals"]
            var old_locals_floaty = ctx["locals_floaty"]
            var old_locals_stringy = ctx["locals_stringy"]
            var old_locals_list_stringy = ctx["locals_list_stringy"]
            var old_stack_size = ctx["stack_size"]
            var old_scope = ctx["scope"]
            var old_call_depth_enabled = ctx["call_depth_enabled"]
            ctx["locals"] = {}
            ctx["locals_floaty"] = {}
            ctx["locals_stringy"] = {}
            ctx["locals_list_stringy"] = {}
            ctx["stack_size"] = 0
            ctx["scope"] = nil
            
            ctx["in_function"] = true
            // Stack safety instrumentation (native backend; rolling):
            //
            // Only instrument **user code** functions.
            // Do NOT instrument the injected native runtime itself, because the runtime init path
            // intentionally runs before global initializers are reliable and uses bootstrap
            // invariants that must not be perturbed by extra helper calls.
            //
            // Runtime functions are tagged with token.file == "lib/runtime_native.oren".
            ctx["call_depth_enabled"] = true
            var ftok0 = expr["token"]
            var ffile0 = nil
            if ftok0 != nil { ffile0 = ftok0["file"] }
            if ffile0 == "lib/runtime_native.oren" { ctx["call_depth_enabled"] = false }
            if ffile0 != nil {
                var nff = oren_string_len(ffile0)
                if nff >= 7 {
                    if oren_string_slice(ffile0, 0, 7) == "<native:" { ctx["call_depth_enabled"] = false }
                }
            }
            // Never instrument the helper functions themselves.
            if fn_name == "oren_call_depth_enter" { ctx["call_depth_enabled"] = false }
            if fn_name == "oren_call_depth_exit" { ctx["call_depth_enabled"] = false }
            scope_enter_codegen(ctx) // function scope
            
            push_u32_le(ctx["code"], insn_stp_pre())
            push_u32_le(ctx["code"], insn_mov_fp_sp())
            ctx["stack_size"] = ctx["stack_size"] + 16 

            // Save SP after the standard prologue (SP==FP here). If the caller passed stack arguments (arg8+),
            // they are located at [saved_sp + 16 + (i-8)*8] relative to this base.
            //
            // IMPORTANT:
            // Do this BEFORE allocating our own callee-saved spill area / locals, otherwise the offsets
            // to caller arguments would be wrong.
            push_u32_le(ctx["code"], insn_add_imm(9, 31, 0)) // X9 = SP

            // Save callee-saved registers (native ABI: X19-X26) at fixed offsets from FP.
            //
            // NOTE:
            // - We preserve X19-X26 as callee-saved to stabilize calls between generated functions.
            // - X27/X28 are reserved global heap registers and MUST NOT be saved/restored here.
            //
            // Frame layout (relative to FP):
            //   [FP]    = saved X29
            //   [FP+8]  = saved X30 (LR)
            //   [FP-64] = saved X19
            //   ...
            //   [FP-8]  = saved X26
            //
            // We allocate 64 bytes so subsequent locals pushes remain below the save area.
            push_u32_le(ctx["code"], insn_sub_sp(64))
            ctx["stack_size"] = ctx["stack_size"] + 64
            var save_base = 0 - 64
            var sr = 19
            while sr <= 26 {
                var off = save_base + (sr - 19) * 8
                push_u32_le(ctx["code"], insn_stur_reg(sr, 29, off))
                sr = sr + 1
            }
            
            var fn_scope = scope_current_codegen(ctx)
            var params_info = []
            var params = expr["params"]
            var n_params = oren_list_len(params)
            var i = 0
            while i < n_params {
                var p = params[i]
                var p_name = p["value"]
                push_u32_le(ctx["code"], insn_sub_sp(16))
                if i < 8 {
                    push_u32_le(ctx["code"], insn_str_reg_sp(i, 0))
                } else {
                    // Load stack arg i (>=8) from caller stack into our local slot.
                    // src = *(u64*)(saved_sp + 16 + (i-8)*8)
                    var off = 16 + (i - 8) * 8
                    emit_load_ptr_from_base_plus(ctx, 10, 9, off) // X10 = arg_i
                    push_u32_le(ctx["code"], insn_str_reg_sp(10, 0))
                }
                ctx["locals"][p_name] = ctx["stack_size"]
                ctx["stack_size"] = ctx["stack_size"] + 16
                if fn_scope != nil { fn_scope["names"][p_name] = 1 }

                // Type annotations (rolling): help the native backend decide whether a param is "floaty".
                // Native float values are raw IEEE-754 f64 bits carried in registers (no tagged dynamic type).
                // Without this, `x: f64` behaves like an int at runtime, breaking float arithmetic/comparisons.
                var ann = nil
                if p != nil { ann = p["ann_type"] }
                if ann != nil {
                    // Strip optional prefix `oren.` for uniformity.
                    if oren_string_len(ann) > 5 {
                        if oren_string_slice(ann, 0, 5) == "oren." {
                            ann = oren_string_slice(ann, 5, oren_string_len(ann))
                        }
                    }
                    if ann == "f64" || ann == "f32" {
                        if ctx["locals_floaty"] != nil { ctx["locals_floaty"][p_name] = true }
                    }
                }
                
                if ctx["platform"]["debug"] == true {
                    oren_list_push(params_info, {"name": p_name, "offset": ctx["locals"][p_name]})
                }
                
                i = i + 1
            }

            // Stack safety: increment call depth after params are spilled so arg registers
            // are free to be clobbered by the helper call.
            if ctx["call_depth_enabled"] == true {
                var bl_enter = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_enter, "name": "oren_call_depth_enter"})
            }
            
            native_compile_stmt(ctx, expr["body"])
            
            push_u32_le(ctx["code"], insn_movz(0, 0))
            if ctx["call_depth_enabled"] == true {
                var bl_exit2 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_exit2, "name": "oren_call_depth_exit"})
                // Ensure X0 remains 0 (helper may clobber caller-saved regs).
                push_u32_le(ctx["code"], insn_movz(0, 0))
            }
            push_u32_le(ctx["code"], insn_mov_sp_fp())

            // Restore callee-saved registers (X19-X26) from fixed FP-relative slots.
            var restore_base = 0 - 64
            var rr = 19
            while rr <= 26 {
                var off2 = restore_base + (rr - 19) * 8
                push_u32_le(ctx["code"], insn_ldur_reg(rr, 29, off2))
                rr = rr + 1
            }
            push_u32_le(ctx["code"], insn_ldp_post())
            push_u32_le(ctx["code"], insn_ret())
            
            var func_end = bytes_len(ctx["code"])
            
            if ctx["platform"]["debug"] == true {
                var ftok = expr["token"]
                var ffile = nil
                var fline = 0
                var fcol = 0
                if ftok != nil {
                    ffile = ftok["file"]
                    if ftok["line"] != nil { fline = ftok["line"] }
                    if ftok["col"] != nil { fcol = ftok["col"] }
                }
                oren_list_push(ctx["debug_info"]["funcs"], {
                    "name": fn_name,
                    "start": func_start,
                    "end": func_end,
                    "file": ffile,
                    "line": fline,
                    "col": fcol,
                    "params": params_info
                })
            }
            
            var skip_off = (func_end - jump_skip_pos) / 4
            set_u32_le(ctx["code"], jump_skip_pos, insn_b(skip_off))
            
            ctx["in_function"] = false
            
            ctx["locals"] = old_locals
            ctx["locals_floaty"] = old_locals_floaty
            ctx["locals_stringy"] = old_locals_stringy
            ctx["locals_list_stringy"] = old_locals_list_stringy
            ctx["stack_size"] = old_stack_size
            ctx["scope"] = old_scope
            ctx["call_depth_enabled"] = old_call_depth_enabled
            return nil
        }
        
        if expr["type"] == "Call" {
            var fn_name = expr["fn"]["value"]

            // NOTE: keep print/exit fast paths, but do NOT emit syscalls directly here.
            // Keep all syscall emission centralized in `arm64_native_expr_syscalls.oren`.

            if fn_name == "print" {
                var args = expr["args"]
                var argc = oren_list_len(args)
                var spread = expr["spread"]
                var arg0 = nil
                if argc > 0 { arg0 = args[0] }
                
                var is_fmt = false
                if arg0 != nil && arg0["type"] == "String" && contains_curly_braces(arg0["value"]) {
                    if argc > 1 || spread != nil { is_fmt = true }
                }
                
                if spread != nil {
                    // Spread printing: lower to runtime helpers so we don't need to unroll
                    // list elements in assembly.
                    if is_fmt {
                        // fixed list is args[1..]
                        push_u32_le(ctx["code"], insn_movz(0, 0))
                        var bl_new_list2 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list2, "name": "oren_new_list"})

                        // Save fixed args list on stack.
                        push_u32_le(ctx["code"], insn_sub_sp(16))
                        push_u32_le(ctx["code"], insn_str_x0_sp(0))
                        ctx["stack_size"] = ctx["stack_size"] + 16

                        var k2 = 1
                        while k2 < argc {
                            native_compile_expr(ctx, args[k2])
                            push_u32_le(ctx["code"], insn_sub_sp(16))
                            push_u32_le(ctx["code"], insn_str_x0_sp(0))
                            ctx["stack_size"] = ctx["stack_size"] + 16

                            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                            push_u32_le(ctx["code"], insn_add_sp(16))
                            ctx["stack_size"] = ctx["stack_size"] - 16

                            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))

                            var bl_push2 = bytes_len(ctx["code"])
                            push_u32_le(ctx["code"], 0)
                            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push2, "name": "oren_list_push"})
                            k2 = k2 + 1
                        }

                        // Compile spread list and save on stack.
                        native_compile_expr(ctx, spread)
                        push_u32_le(ctx["code"], insn_sub_sp(16))
                        push_u32_le(ctx["code"], insn_str_x0_sp(0))
                        ctx["stack_size"] = ctx["stack_size"] + 16

                        // Compile fmt (arg0) last, then load fixed+spread into X1/X2.
                        native_compile_expr(ctx, arg0)
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 16)) // fixed
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))  // spread
                        push_u32_le(ctx["code"], insn_add_sp(32))
                        ctx["stack_size"] = ctx["stack_size"] - 32

                        var bl_fmt_sp = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_fmt_sp, "name": "oren_print_fmt_spread"})
                        return nil
                    }

                    // Non-format: fixed list is args[0..] (may be empty)
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    var bl_new_list3 = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list3, "name": "oren_new_list"})

                    // Save fixed list on stack.
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    push_u32_le(ctx["code"], insn_str_x0_sp(0))
                    ctx["stack_size"] = ctx["stack_size"] + 16

                    var k3 = 0
                    while k3 < argc {
                        native_compile_expr(ctx, args[k3])
                        push_u32_le(ctx["code"], insn_sub_sp(16))
                        push_u32_le(ctx["code"], insn_str_x0_sp(0))
                        ctx["stack_size"] = ctx["stack_size"] + 16

                        push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                        push_u32_le(ctx["code"], insn_add_sp(16))
                        ctx["stack_size"] = ctx["stack_size"] - 16

                        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
                        var bl_push3 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push3, "name": "oren_list_push"})
                        k3 = k3 + 1
                    }

                    // Compile spread -> X0, move to X1, then restore fixed list into X0.
                    native_compile_expr(ctx, spread)
                    push_u32_le(ctx["code"], insn_mov_reg(1, 0)) // X1 = spread
                    push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0)) // X0 = fixed
                    push_u32_le(ctx["code"], insn_add_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] - 16

                    var bl_sp = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_sp, "name": "oren_print_spread"})
                    return nil
                }

                if is_fmt {
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    var bl_new_list = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list, "name": "oren_new_list"})
                    
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    push_u32_le(ctx["code"], insn_str_x0_sp(0))
                    ctx["stack_size"] = ctx["stack_size"] + 16
                    
                    var k = 1
                    while k < argc {
                        native_compile_expr(ctx, args[k]) 
                        push_u32_le(ctx["code"], insn_sub_sp(16))
                        push_u32_le(ctx["code"], insn_str_x0_sp(0))
                        ctx["stack_size"] = ctx["stack_size"] + 16
                        
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                        push_u32_le(ctx["code"], insn_add_sp(16))
                        ctx["stack_size"] = ctx["stack_size"] - 16
                        
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
                        
                        var bl_push = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push, "name": "oren_list_push"})
                        
                        k = k + 1
                    }
                    
                    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                    push_u32_le(ctx["code"], insn_add_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] - 16
                    
                    native_compile_expr(ctx, arg0)
                    
                    var bl_fmt = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_fmt, "name": "oren_print_fmt"})
                    return nil
                }

                // Non-format print: always go through runtime `oren_print` so sys_write gating applies
                // (no direct sys_write syscall bypass in statement lowering).
                if argc == 0 {
                    // print() => newline
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    var bl_nl = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_nl, "name": "oren_print_list"})
                    return nil
                }
                if argc == 1 {
                    native_compile_expr(ctx, arg0)
                    var bl_pos_print = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_print, "name": "oren_print"})
                    return nil
                }

                // print(a,b,...) => build args list and call oren_print_list(list)
                push_u32_le(ctx["code"], insn_movz(0, 0))
                var bl_new_list4 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list4, "name": "oren_new_list"})

                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                var k4 = 0
                while k4 < argc {
                    native_compile_expr(ctx, args[k4])
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    push_u32_le(ctx["code"], insn_str_x0_sp(0))
                    ctx["stack_size"] = ctx["stack_size"] + 16

                    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                    push_u32_le(ctx["code"], insn_add_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] - 16

                    push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
                    var bl_push4 = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push4, "name": "oren_list_push"})
                    k4 = k4 + 1
                }

                push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                var bl_pl = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pl, "name": "oren_print_list"})
                return nil
            }
            
            if fn_name == "exit" {
                // Route through centralized syscall lowering so OS ABIs stay in one place.
                // (exit is implemented via sys_exit, but user code does not call sys_exit directly.)
                sysm.native_compile_syscall_call(ctx, "sys_exit", expr["args"], native_compile_expr)
                return nil
            }

            // General call expression statement: evaluate for side effects and discard value.
            var base_stack = ctx["stack_size"]
            native_compile_expr(ctx, expr)
            var delta = ctx["stack_size"] - base_stack
            if delta > 0 {
                push_u32_le(ctx["code"], insn_add_sp(delta))
                ctx["stack_size"] = base_stack
            }
            return nil
        }

        // General expression statement:
        // Evaluate the expression for side effects and discard its value.
        var base_stack = ctx["stack_size"]
        native_compile_expr(ctx, expr)
        var delta = ctx["stack_size"] - base_stack
        if delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(delta))
            ctx["stack_size"] = base_stack
        }
        return nil
    }
