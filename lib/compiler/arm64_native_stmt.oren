fn _arm64_lit_string(v) {
    if v == nil { return nil }
    if v["type"] != "String" { return nil }
    return v["value"]
}

fn _arm64_collect_ffi_ret_attrs(ctx, st, nm) {
    if ctx == nil || st == nil || nm == nil || nm == "" { return nil }
    var attrs = st["attrs"]
    if attrs == nil { return nil }
    if ctx["ffi_ret_i32"] == nil { ctx["ffi_ret_i32"] = {} }
    if ctx["ffi_ret_u32"] == nil { ctx["ffi_ret_u32"] = {} }
    if ctx["ffi_ret_void"] == nil { ctx["ffi_ret_void"] = {} }
    // Pointer/usize return kinds are 64-bit on Tier‑1 (arm64/x64), so they do not require
    // register normalization today. Still, accept them as explicit ABI metadata so:
    // - bindings can be self-documenting (`strlen` returns size_t),
    // - future 32-bit targets can lower `usize`/`ptr` correctly,
    // - duplicate/contradicting `@ffi.ret(...)` annotations remain detectable.
    if ctx["ffi_ret_ptr"] == nil { ctx["ffi_ret_ptr"] = {} }
    if ctx["ffi_ret_usize"] == nil { ctx["ffi_ret_usize"] = {} }

    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a == nil || a["type"] != "Attr" { i = i + 1; continue }
        if !loopm._arm64_str_eq_bytes(a["name"], "ffi.ret") { i = i + 1; continue }

        var args = a["args"]
        if args == nil || oren_list_len(args) != 1 || args[0] == nil {
            native_error(ctx, st["token"], "arm64 native v0: @" + "ffi.ret" + " on ffi " + nm + " must have exactly 1 string arg")
            return nil
        }
        var val = _arm64_lit_string(args[0]["value"])
        if val == nil || val == "" {
            native_error(ctx, st["token"], "arm64 native v0: @" + "ffi.ret" + " on ffi " + nm + " must be a string literal")
            return nil
        }
        // Accept exactly one return-kind attribute per symbol.
        if ctx["ffi_ret_i32"][nm] != nil || ctx["ffi_ret_u32"][nm] != nil || ctx["ffi_ret_void"][nm] != nil ||
           ctx["ffi_ret_ptr"][nm] != nil || ctx["ffi_ret_usize"][nm] != nil {
            native_error(ctx, st["token"], "arm64 native v0: @" + "ffi.ret" + " on ffi " + nm + " is duplicated (only one kind allowed)")
            return nil
        }
        if loopm._arm64_str_eq_bytes(val, "i32") {
            ctx["ffi_ret_i32"][nm] = true
        } else if loopm._arm64_str_eq_bytes(val, "u32") {
            ctx["ffi_ret_u32"][nm] = true
        } else if loopm._arm64_str_eq_bytes(val, "void") {
            ctx["ffi_ret_void"][nm] = true
        } else if loopm._arm64_str_eq_bytes(val, "ptr") {
            ctx["ffi_ret_ptr"][nm] = true
        } else if loopm._arm64_str_eq_bytes(val, "usize") {
            ctx["ffi_ret_usize"][nm] = true
        } else {
            native_error(ctx, st["token"], "arm64 native v0: @" + "ffi.ret" + " on ffi " + nm + " supports \"i32\", \"u32\", \"void\", \"ptr\", or \"usize\" (got \"" + val + "\")")
            return nil
        }
        i = i + 1
    }
    return nil
}


fn native_compile_stmt(ctx, stmt) {
    // Guardrail: prevent native statement compilation from stack-overflowing the host compiler
    // process on pathological inputs (e.g. accidental AST cycles / runaway recursion bugs).
    //
    // We keep the limit high enough that normal nesting should never hit it, but low enough
    // to fail deterministically before macOS `___chkstk_darwin` crashes the process.
    if ctx == nil { return nil }
    if stmt == nil { return nil }
    loopm._arm64_set_compile_hooks(native_compile_expr, native_compile_stmt)
    var depth = ctx["stmt_depth"]
    if oren_type_tag(depth) != 1 { depth = 0 }
    depth = depth + 1
    ctx["stmt_depth"] = depth
    if depth > 2048 {
        if ctx["stmt_depth_overflow_reported"] != true {
            ctx["stmt_depth_overflow_reported"] = true
            native_error(ctx, stmt["token"], "native backend: statement recursion exceeded 2048 (likely AST cycle or compiler bug)")
        }
        ctx["stmt_depth"] = depth - 1
        return false
    }
    if _arm64_stmt_gas_should_charge(ctx, stmt) == true {
        gc.native_emit_runtime_gas_note_amount(ctx, 1)
    }
    var r = native_compile_stmt_inner(ctx, stmt)
    ctx["stmt_depth"] = depth - 1
    return r
}

fn native_compile_stmt_inner(ctx, stmt) {
    // Parser/normalization compatibility (rolling):
    // Some pipelines represent top-level `fn name(...) { ... }` as a raw Function statement,
    // and block-level `if cond { ... } else { ... }` as a statement node `type=="If"`.
    //
    // Tier‑1 native backends historically compiled only the expression-statement forms:
    //   ExprStmt(Function) and ExprStmt(If)
    //
    // Runtime injection can bypass the full frontend normalization passes, so handle these
    // statement forms here to avoid silently skipping critical guards (e.g. alloc-index init).
    if stmt["type"] == "If" || stmt["type"] == "Function" {
        return native_compile_stmt_inner(ctx, {"type": "ExprStmt", "token": stmt["token"], "expr": stmt})
    }

    if stmt["type"] == "Spawn" {
        // Delegate to expression compilation, ignore result (X0)
        var expr = {"type": "SpawnExpr", "call": stmt["call"]}
        native_compile_expr(ctx, expr)
        return nil
    }
    if stmt["type"] == "Break" {
        var loop = ctx["loop_ctx"]
        if loop == nil {
            native_error(ctx, stmt["token"], "native backend: break outside of loop")
            return nil
        }

	        // Restore stack to the loop base before leaving.
	        var base_stack = loop["base_stack"]
	        loopm._arm64_restore_stack_to(ctx, base_stack)

	        // Jump to loop end (patched after body is compiled).
	        var jpos = bytes_len(ctx["code"])
	        push_u32_le(ctx["code"], 0)
        oren_list_push(loop["break_jumps"], jpos)
        return false
    }
    if stmt["type"] == "Continue" {
        var loop2 = ctx["loop_ctx"]
        if loop2 == nil {
            native_error(ctx, stmt["token"], "native backend: continue outside of loop")
            return nil
        }

	        // Restore stack to the loop base before continuing.
	        var base_stack2 = loop2["base_stack"]
	        loopm._arm64_restore_stack_to(ctx, base_stack2)

	        // Jump to the loop-specific continue target.
	        // - while: condition start
	        // - for: post start (so post runs before re-checking condition)
        var cont = loop2["continue_pos"]
        if cont != nil {
            var back_pos = bytes_len(ctx["code"])
            var back_off = (cont - back_pos) / 4
            push_u32_le(ctx["code"], insn_b(back_off))
        } else {
            // Patch later (used for `for`, whose post-start is only known after body compilation).
            var jpos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(loop2["continue_jumps"], jpos)
        }
        return false
    }
    if stmt["type"] == "Block" {
        if ctx["in_function"] {
            scope_enter_codegen(ctx)
        }
        var old_fresh_caps = ctx["arm64_fresh_list_int_caps"]
        var fresh_caps = {}
        var base_stack = ctx["stack_size"]
        var stmts = stmt["stmts"]
        var i = 0
        var falls_through = true
        while i < oren_list_len(stmts) {
            var cur = stmts[i]
            var next = nil
            if i + 1 < oren_list_len(stmts) { next = stmts[i + 1] }
            if _arm64_should_skip_reserve_stmt(cur, next, ctx) == true {
                i = i + 1
                continue
            }
            ctx["arm64_fresh_list_int_caps"] = fresh_caps
            var r = native_compile_stmt(ctx, cur)
            if r == false {
                falls_through = false
                break
            }
            fresh_caps = _arm64_fresh_list_int_caps_after_stmt(fresh_caps, cur)
            i = i + 1
        }
	        var delta = ctx["stack_size"] - base_stack
	        // Restore stack only if we reach the end of this block via fallthrough.
	        // If a terminator ended the block, this cleanup would be unreachable and can be skipped.
	        if falls_through == true {
	            loopm._arm64_restore_stack_to(ctx, base_stack)
	        } else {
	            // Keep compile-time stack accounting consistent for subsequent compilation (even if
	            // fallthrough is impossible, later statements are either unreachable or in another CFG arm).
	            ctx["stack_size"] = base_stack
	        }
		        if ctx["in_function"] {
		            scope_exit_codegen(ctx)
		        }
        ctx["arm64_fresh_list_int_caps"] = old_fresh_caps
        if falls_through == true { return nil }
        return false
    }

    if stmt["type"] == "Set" {
        return native_compile_stmt_set(ctx, stmt)
    }

	        if stmt["type"] == "Assign" {
			            // Keep stack balanced after computing the RHS.
			            var rhs_base_stack = ctx["stack_size"]
			            native_compile_expr(ctx, stmt["value"])
			            loopm._arm64_restore_stack_to(ctx, rhs_base_stack)
        var is_floaty = exprm.native_expr_is_floaty(ctx, stmt["value"])
        var is_inty = exprm.native_expr_is_inty(ctx, stmt["value"])
        var int_const = exprm.native_expr_int_const(ctx, stmt["value"])
        var is_stringy = exprm.native_expr_is_stringy(ctx, stmt["value"])
        var is_list_stringy = exprm.native_expr_is_list_stringy(ctx, stmt["value"])
	        
		        var name = stmt["name"]["value"]
		        var off_enc = ctx["locals"][name]
		        if oren_type_tag(off_enc) != 0 {
		            // Locals store offsets as `fp_off+1` so:
		            // - `nil` remains the "missing" sentinel
		            // - a real offset of 0 is representable (though FP-relative locals are negative)
		            var fp_off = off_enc - 1
		            emit_str_reg_fp_any(ctx, 0, fp_off)
            if ctx["locals_floaty"] != nil { ctx["locals_floaty"][name] = is_floaty }
            if ctx["locals_inty"] != nil { ctx["locals_inty"][name] = is_inty }
