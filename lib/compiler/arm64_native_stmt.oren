fn _arm64_list_name_in_fast(list_name, lists) {
    if list_name == nil || lists == nil { return false }
    var i = 0
    while i < oren_list_len(lists) {
        if loopm._arm64_str_eq_bytes(lists[i], list_name) == true { return true }
        i = i + 1
    }
    return false
}

fn _arm64_reserve_call_info(stmt) {
    if stmt == nil || stmt["type"] != "ExprStmt" { return nil }
    var expr = stmt["expr"]
    if expr == nil || expr["type"] != "Call" { return nil }
    var fn0 = expr["fn"]
    if fn0 == nil || fn0["type"] != "Identifier" { return nil }
    var nm = fn0["value"]
    var kind = nil
    if nm == "oren_list_int_reserve" || nm == "STD_list_int_reserve" { kind = "list_int" }
    else if nm == "oren_list_reserve" || nm == "STD_list_reserve" { kind = "list" }
    else { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) < 2 { return nil }
    var recv = args[0]
    if recv == nil || recv["type"] != "Identifier" { return nil }
    return {"kind": kind, "list": recv["value"], "cap_expr": args[1]}
}

fn _arm64_reserve_cap_matches_fast(res_info, fast_info) {
    if res_info == nil || fast_info == nil { return false }
    var cap_expr = res_info["cap_expr"]
    if cap_expr == nil { return false }
    var n_name = fast_info["n"]
    var n_const = fast_info["n_const"]
    if n_name != nil {
        if cap_expr["type"] == "Identifier" && loopm._arm64_str_eq_bytes(cap_expr["value"], n_name) == true { return true }
    } else if n_const != nil {
        if cap_expr["type"] == "Integer" {
            var v = intparse.parse_int_lit(cap_expr["value"])
            if oren_is_err(v) != true && v == n_const { return true }
        }
    }
    return false
}

fn _arm64_map_clone(src) {
    var out = {}
    if src == nil { return out }
    for k in src { out[k] = src[k] }
    return out
}

fn _arm64_expr_uses_tracked_list_ident(exp, tracked) {
    if exp == nil || tracked == nil { return false }
    var et = exp["type"]
    if et == "Identifier" { return tracked[exp["value"]] != nil }
    if et == "Integer" || et == "Float" || et == "String" || et == "Boolean" || et == "Nil" { return false }
    if et == "Prefix" { return _arm64_expr_uses_tracked_list_ident(exp["right"], tracked) }
    if et == "Infix" {
        if _arm64_expr_uses_tracked_list_ident(exp["left"], tracked) { return true }
        return _arm64_expr_uses_tracked_list_ident(exp["right"], tracked)
    }
    if et == "Call" {
        if _arm64_expr_uses_tracked_list_ident(exp["fn"], tracked) { return true }
        var args = exp["args"]
        var i = 0
        while i < oren_list_len(args) {
            if _arm64_expr_uses_tracked_list_ident(args[i], tracked) { return true }
            i = i + 1
        }
        return false
    }
    if et == "Member" { return _arm64_expr_uses_tracked_list_ident(exp["left"], tracked) }
    if et == "Index" {
        if _arm64_expr_uses_tracked_list_ident(exp["left"], tracked) { return true }
        return _arm64_expr_uses_tracked_list_ident(exp["index"], tracked)
    }
    if et == "Array" {
        var xs = exp["elements"]
        var j = 0
        while j < oren_list_len(xs) {
            if _arm64_expr_uses_tracked_list_ident(xs[j], tracked) { return true }
            j = j + 1
        }
        return false
    }
    if et == "Hash" {
        var ps = exp["pairs"]
        var k = 0
        while k < oren_list_len(ps) {
            if _arm64_expr_uses_tracked_list_ident(ps[k]["key"], tracked) { return true }
            if _arm64_expr_uses_tracked_list_ident(ps[k]["value"], tracked) { return true }
            k = k + 1
        }
        return false
    }
    return true
}

fn _arm64_fresh_list_int_init_info(stmt) {
    if stmt == nil { return nil }
    if stmt["type"] != "Var" && stmt["type"] != "Assign" { return nil }
    var name = stmt["name"]
    if name == nil || name["type"] != "Identifier" { return nil }
    var value = stmt["value"]
    if value == nil || value["type"] != "Call" { return nil }
    var fn0 = value["fn"]
    if fn0 == nil || fn0["type"] != "Identifier" { return nil }
    var fn_name = fn0["value"]
    if fn_name != "oren_new_list_int" && fn_name != "STD_list_int_new" { return nil }
    var args = value["args"]
    if args == nil || oren_list_len(args) != 1 { return nil }
    return {"name": name["value"], "cap_expr": args[0]}
}

fn _arm64_fresh_list_int_caps_after_stmt(fresh_caps, stmt) {
    var empty = {}
    if stmt == nil { return empty }
    if stmt["type"] != "Var" && stmt["type"] != "Assign" { return empty }
    var out = _arm64_map_clone(fresh_caps)
    var name = stmt["name"]
    if name == nil || name["type"] != "Identifier" { return empty }
    var value = stmt["value"]
    if _arm64_expr_uses_tracked_list_ident(value, out) == true {
        out = {}
    }
    var init = _arm64_fresh_list_int_init_info(stmt)
    var nm = name["value"]
    if init != nil {
        out[nm] = init["cap_expr"]
    } else {
        out[nm] = nil
    }
    return out
}

fn _arm64_should_skip_reserve_stmt(cur, next, ctx) {
    var res_info = _arm64_reserve_call_info(cur)
    if res_info == nil || next == nil { return false }
    if next["type"] != "While" { return false }
    if res_info["kind"] == "list_int" {
        var fast_info = loopm._arm64_match_fast_list_int_push_while(ctx, next)
        if fast_info == nil { return false }
        if _arm64_list_name_in_fast(res_info["list"], fast_info["lists"]) != true { return false }
        return _arm64_reserve_cap_matches_fast(res_info, fast_info)
    }
    if res_info["kind"] == "list" {
        var fast_info2 = loopm._arm64_match_fast_list_push_while(ctx, next)
        if fast_info2 == nil { return false }
        if _arm64_list_name_in_fast(res_info["list"], fast_info2["lists"]) != true { return false }
        return _arm64_reserve_cap_matches_fast(res_info, fast_info2)
    }
    return false
}

fn _arm64_native_stmt_gas_enabled(ctx) {
    if ctx == nil { return false }
    if ctx["native_stmt_gas_enabled"] == true { return true }
    if ctx["native_stmt_gas_enabled"] == false { return false }
    var v = oren_env("OREN_NATIVE_GAS_ACCOUNTING")
    var enabled = false
    if v == "1" || v == "stmt" || v == "statement" { enabled = true }
    ctx["native_stmt_gas_enabled"] = enabled
    return enabled
}

fn _arm64_stmt_gas_should_charge(ctx, stmt) {
    if _arm64_native_stmt_gas_enabled(ctx) != true { return false }
    if ctx["in_function"] != true { return false }
    if stmt == nil { return false }
    var st = stmt["type"]
    if st == "Block" || st == "Function" { return false }
    if st == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "Function" { return false }
    }
    return true
}

