// --- SSE2 packed integer operations (for SIMD dot products) ---
// These enable x64 parity with arm64 NEON for typed-buffer kernels.

fn insn_pxor_xmm_xmm(dst, src) {
    // PXOR xmm1, xmm2/m128 => 66 0F EF /r
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = _insn_pool_get()
    bytes_push(out, 102) // 66
    var rex = _rex_base_xmm_rm(dst, src, false)
    if rex != 64 { bytes_push(out, rex) }
    bytes_push(out, 15)  // 0F
    bytes_push(out, 239) // EF
    bytes_push(out, 192 + int_mod(dst, 8) * 8 + int_mod(src, 8))
    return out
}

fn insn_paddq_xmm_xmm(dst, src) {
    // PADDQ xmm1, xmm2/m128 => 66 0F D4 /r
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = _insn_pool_get()
    bytes_push(out, 102) // 66
    var rex = _rex_base_xmm_rm(dst, src, false)
    if rex != 64 { bytes_push(out, rex) }
    bytes_push(out, 15)  // 0F
    bytes_push(out, 212) // D4
    bytes_push(out, 192 + int_mod(dst, 8) * 8 + int_mod(src, 8))
    return out
}

fn insn_pmuludq_xmm_xmm(dst, src) {
    // PMULUDQ xmm1, xmm2/m128 => 66 0F F4 /r
    // Multiplies low 32-bits of each 64-bit lane, producing 64-bit results
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = _insn_pool_get()
    bytes_push(out, 102) // 66
    var rex = _rex_base_xmm_rm(dst, src, false)
    if rex != 64 { bytes_push(out, rex) }
    bytes_push(out, 15)  // 0F
    bytes_push(out, 244) // F4
    bytes_push(out, 192 + int_mod(dst, 8) * 8 + int_mod(src, 8))
    return out
}

fn insn_pshufd_xmm_xmm_imm(dst, src, imm8) {
    // PSHUFD xmm1, xmm2/m128, imm8 => 66 0F 70 /r ib
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = _insn_pool_get()
    bytes_push(out, 102) // 66
    var rex = _rex_base_xmm_rm(dst, src, false)
    if rex != 64 { bytes_push(out, rex) }
    bytes_push(out, 15)  // 0F
    bytes_push(out, 112) // 70
    bytes_push(out, 192 + int_mod(dst, 8) * 8 + int_mod(src, 8))
    bytes_push(out, imm8 & 255)
    return out
}

fn insn_movdqa_xmm_m128_disp(xmm_dst, base_reg, disp) {
    // MOVDQA xmm, m128 => 66 0F 6F /r (aligned load)
    if xmm_dst < 0 || xmm_dst > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    bytes_push(out, 102) // 66
    var rex = _rex_base_xmm_rm(xmm_dst, base_reg, false)
    if rex != 64 { bytes_push(out, rex) }
    bytes_push(out, 15)  // 0F
    bytes_push(out, 111) // 6F
    var enc = _mem_base_modrm_and_sib_disp(base_reg, int_mod(xmm_dst, 8), disp)
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    if enc["disp32"] != nil { push_u32_le(out, enc["disp32"]) }
    return out
}

fn insn_movdqa_m128_xmm_disp(base_reg, disp, xmm_src) {
    // MOVDQA m128, xmm => 66 0F 7F /r (aligned store)
    if xmm_src < 0 || xmm_src > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    bytes_push(out, 102) // 66
    var rex = _rex_base_xmm_rm(xmm_src, base_reg, false)
    if rex != 64 { bytes_push(out, rex) }
    bytes_push(out, 15)  // 0F
    bytes_push(out, 127) // 7F
    var enc = _mem_base_modrm_and_sib_disp(base_reg, int_mod(xmm_src, 8), disp)
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    if enc["disp32"] != nil { push_u32_le(out, enc["disp32"]) }
    return out
}

// --- MOVSXD with RBP-relative addressing (for 32-bit memory loads with sign-extension) ---

fn insn_movsxd_r64_mrbp_disp8(dst_reg, disp8) {
    // movsxd r64, dword ptr [rbp+disp8] => REX.W 63 45 ib (with optional REX.R for r8-r15)
    // modrm: mod=01 rm=101 (rbp), reg=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 99) // 0x63 (MOVSXD)
    bytes_push(out, 69 + int_mod(dst_reg, 8) * 8) // 0x45 | ((dst&7)<<3)
    bytes_push(out, int_mod(disp8, 256))
    return out
}

fn insn_movsxd_r64_mrbp_disp32(dst_reg, disp32) {
    // movsxd r64, dword ptr [rbp+disp32] => REX.W 63 85 id (with optional REX.R for r8-r15)
    // modrm: mod=10 rm=101 (rbp), reg=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 99) // 0x63 (MOVSXD)
    bytes_push(out, 133 + int_mod(dst_reg, 8) * 8) // 0x85 | ((dst&7)<<3)
    push_u32_le(out, int_mod(disp32, 4294967296))
    return out
}

// --- 32-bit memory load (zero-extending to 64-bit implicitly, or used with MOVSXD) ---

fn insn_mov_r32_m64_disp(dst_reg, base_reg, disp) {
    // mov r32(dst), dword ptr [base_reg+disp] => (REX if needed) 8B /r
    // Note: This clears upper 32 bits of the destination (implicit zero-extension to 64-bit)
    // modrm: mod depends on disp, reg=dst, rm=base
    if dst_reg < 0 || dst_reg > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    // REX prefix (if needed for high registers)
    var need_rex = false
    var rex = 64 // 0x40 base
    if dst_reg >= 8 { rex = rex + 4; need_rex = true } // REX.R
    if base_reg >= 8 { rex = rex + 1; need_rex = true } // REX.B
    // Note: No REX.W (0x48) because this is 32-bit operation
    if need_rex { bytes_push(out, rex) }
    bytes_push(out, 139) // 0x8B (MOV r32, r/m32)
    var enc = _mem_base_modrm_and_sib_disp(base_reg, int_mod(dst_reg, 8), disp)
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    if enc["disp32"] != nil { push_u32_le(out, enc["disp32"]) }
    return out
}

// --- DEC instruction ---

fn insn_dec_r64(reg) {
    // dec r/m64 => REX.W FF /1
    // modrm: 11 reg=001 rm=(reg&7)
    if reg < 0 || reg > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 255) // 0xFF
    bytes_push(out, 200 + int_mod(reg, 8)) // 0xC8 | rm (0xC0 | (1<<3) | rm)
    return out
}
