        var cases = stmt["cases"]
        var ci = 0
        while cases != nil && ci < oren_list_len(cases) {
            var c = cases[ci]
            if c != nil && _opt_list_int_stmt_may_start_candidate(c["body"], allow_empty) { return true }
            ci = ci + 1
        }
        return _opt_list_int_stmt_may_start_candidate(stmt["default"], allow_empty)
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            if _opt_list_int_stmt_may_start_candidate(e["consq"], allow_empty) { return true }
            return _opt_list_int_stmt_may_start_candidate(e["alt"], allow_empty)
        }
    }
    return false
}

fn _opt_list_int_stmt_has_lowerable_body(stmt, allow_empty) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Block" || t == "If" || t == "While" || t == "For" || t == "Switch" {
        return _opt_list_int_stmt_may_start_candidate(stmt, allow_empty)
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        return e != nil && e["type"] == "If" && _opt_list_int_stmt_may_start_candidate(stmt, allow_empty)
    }
    return false
}

fn _opt_list_int_has_any_candidate(list_state) {
    if list_state == nil { return false }
    return oren_map_len(list_state) > 0
}

fn _opt_list_int_has_active_candidate(list_state) {
    if list_state == nil { return false }
    for k in list_state {
        if list_state[k] == true { return true }
    }
    return false
}

fn _opt_lower_int_only_lists_in_block_opts(block, allow_empty, safe_ints_seed) {
    if block == nil || block["type"] != "Block" { return nil }
    var ss = block["stmts"]
    if ss == nil { return nil }
    var block_locals = {}
    var prof_t0 = 0
    if OPT_LIST_INT_PROFILE_ENABLED == true { prof_t0 = oren_time_now_ns() }
    var li = 0
    while li < oren_list_len(ss) {
        var stl = ss[li]
        if stl != nil && stl["type"] == "Var" {
            var nml = opthelp.is_ident(stl["name"])
            if nml != nil { block_locals[nml] = true }
        }
        li = li + 1
    }
    _opt_list_int_profile_add("locals", prof_t0)
    var list_state = {}
    var list_inits = {}
    var list_touch = {}
    var list_empty_inits = {}
    var list_ctor_rewrite = {}
    var assigned_nested = {}
    var safe_ints = _opt_map_clone_safe(safe_ints_seed)

    var ai = 0
    if OPT_LIST_INT_PROFILE_ENABLED == true { prof_t0 = oren_time_now_ns() }
    while ai < oren_list_len(ss) {
        var stn = ss[ai]
        if stn != nil {
            var tn = stn["type"]
            if tn == "If" || tn == "While" || tn == "For" || tn == "Switch" || tn == "Block" {
                opthelp.collect_assigned_names_stmt(assigned_nested, stn)
            } else if tn == "ExprStmt" {
                var en = stn["expr"]
                if en != nil && (en["type"] == "If" || en["type"] == "Switch") {
                    opthelp.collect_assigned_names_stmt(assigned_nested, stn)
                }
            }
        }
        ai = ai + 1
    }
    _opt_list_int_profile_add("nested", prof_t0)

    var i = 0
    if OPT_LIST_INT_PROFILE_ENABLED == true { prof_t0 = oren_time_now_ns() }
    var prof_part_t0 = 0
    var list_empty_seen = false
    while i < oren_list_len(ss) {
        var st = ss[i]
        if OPT_LIST_INT_PROFILE_ENABLED == true { prof_part_t0 = oren_time_now_ns() }
        if _opt_list_int_stmt_has_lowerable_body(st, allow_empty) == true {
            _opt_lower_int_only_lists_in_stmt(st, allow_empty, safe_ints)
        }
        _opt_list_int_profile_add("lower", prof_part_t0)
        if OPT_LIST_INT_PROFILE_ENABLED == true { prof_part_t0 = oren_time_now_ns() }
        if _opt_list_int_has_any_candidate(list_state) == true {
            _opt_scan_list_int_uses_stmt(st, list_state, safe_ints)
        }
        _opt_list_int_profile_add("use_scan", prof_part_t0)
        if list_empty_seen == true && _opt_list_int_has_active_candidate(list_state) == true {
            if OPT_LIST_INT_PROFILE_ENABLED == true { prof_part_t0 = oren_time_now_ns() }
            if opthelp.stmt_may_touch_list(st) == true {
                _opt_mark_list_int_touch_in_stmt(st, list_state, _opt_map_clone_safe(safe_ints), list_touch)
            }
            _opt_list_int_profile_add("touch", prof_part_t0)
        }
        if OPT_LIST_INT_PROFILE_ENABLED == true { prof_part_t0 = oren_time_now_ns() }
        if st != nil && (st["type"] == "Var" || st["type"] == "Assign") {
            var nm = opthelp.is_ident(st["name"])
            if nm != nil {
                if st["type"] == "Assign" && block_locals[nm] != true {
                    i = i + 1
                    continue
                }
                var init_call = _opt_call_name(st["value"])
                var ctor_int = nil
                if init_call == "oren_new_list" || init_call == "oren_list_new_cap" { ctor_int = "oren_new_list_int" }
                if init_call == "oren_arena_new_list" { ctor_int = "oren_arena_new_list_int" }
                if init_call == "oren_arena_new_list_auto" { ctor_int = "oren_arena_new_list_int_auto" }
                if init_call == "oren_new_list_int" || init_call == "oren_arena_new_list_int" || init_call == "oren_arena_new_list_int_auto" {
                    if list_state[nm] == nil { list_state[nm] = true }
                    _opt_trace_list_int("[opt] list_int candidate name=" + nm + " src=" + init_call)
                } else if ctor_int != nil {
                    if list_state[nm] == nil { list_state[nm] = true }
                    list_ctor_rewrite[nm] = ctor_int
                    list_empty_inits[nm] = true
                    list_empty_seen = true
                    _opt_trace_list_int("[opt] list_int candidate name=" + nm + " src=" + init_call)
                } else {
                    var lit_elems = _opt_list_lit_safe_int_elements(st["value"], safe_ints)
                    if lit_elems != nil {
                        if list_state[nm] == nil { list_state[nm] = true }
                        _opt_list_init_add_elems(list_inits, nm, st, lit_elems)
                        _opt_trace_list_int("[opt] list_int candidate name=" + nm + " src=lit")
                    } else if allow_empty == true && _opt_is_empty_list_lit(st["value"]) {
                        if list_state[nm] == nil { list_state[nm] = true }
                        _opt_list_init_add(list_inits, nm, st)
                        list_empty_inits[nm] = true
                        list_empty_seen = true
                        _opt_trace_list_int("[opt] list_int candidate name=" + nm + " src=empty_lit")
                    } else if st["value"] != nil && st["value"]["type"] == "Array" {
                        _opt_list_state_mark_unsafe_reason(list_state, nm, "init_array")
                    } else {
                        _opt_list_state_mark_unsafe_reason(list_state, nm, "init_value")
                    }
                }
                if _opt_is_safe_int_expr(st["value"], safe_ints) { safe_ints[nm] = true }
                else { safe_ints[nm] = false }
            }
        }
        _opt_list_int_profile_add("candidate", prof_part_t0)
        i = i + 1
    }
    _opt_list_int_profile_add("scan", prof_t0)

    if list_empty_inits != nil {
        for k in list_empty_inits {
            if list_touch[k] != true {
                _opt_trace_list_int("[opt] list_int empty_untouched name=" + k)
                _opt_list_state_mark_unsafe_reason(list_state, k, "empty_untouched")
            }
        }
    }
    if assigned_nested != nil {
        for k2 in assigned_nested {
            if _opt_list_state_is_candidate(list_state, k2) == true {
                _opt_trace_list_int("[opt] list_int nested_assign name=" + k2)
                _opt_list_state_mark_unsafe_reason(list_state, k2, "nested_assign")
            }
        }
    }

    if _opt_list_int_has_active_candidate(list_state) != true {
        return nil
    }

    var out = []
    var j = 0
    if OPT_LIST_INT_PROFILE_ENABLED == true { prof_t0 = oren_time_now_ns() }
    while j < oren_list_len(ss) {
        var stj = ss[j]
        var rewritten = false
        if stj != nil && (stj["type"] == "Var" || stj["type"] == "Assign") {
            var nmj = opthelp.is_ident(stj["name"])
            if nmj != nil && _opt_list_state_is_safe(list_state, nmj) {
                var xsj = list_inits[nmj]
                if xsj != nil {
                    var k = 0
                    while k < oren_list_len(xsj) {
                        var info = xsj[k]
                        if info != nil && info["stmt"] == stj {
                            var elemsj = info["elements"]
                            var cap = 0
                            if elemsj != nil { cap = oren_list_len(elemsj) }
                            stj["value"] = ast.new_call(nil,
                                {"type": "Identifier", "token": nil, "value": "oren_new_list_int"},
                                [{"type": "Integer", "token": nil, "value": oren_int_to_string(cap)}])
                            oren_list_push(out, stj)
                            if elemsj != nil {
                                var push_name = "oren_list_int_push"
                                if _opt_backend_allows_list_int_unchecked() == true {
                                    push_name = "oren_list_int_push_unchecked"
                                }
                                var ei = 0
                                while ei < oren_list_len(elemsj) {
                                    var push_call = ast.new_call(nil,
                                        {"type": "Identifier", "token": nil, "value": push_name},
                                        [{"type": "Identifier", "token": nil, "value": nmj}, elemsj[ei]])
                                    oren_list_push(out, ast.new_expr_stmt(nil, push_call))
                                    ei = ei + 1
                                }
                            }
                            _opt_trace_list_int("[opt] list_int rewrite init name=" + nmj)
                            rewritten = true
                            break
                        }
                        k = k + 1
                    }
                }
                if rewritten != true {
                    var ctor_rewrite = list_ctor_rewrite[nmj]
                    if ctor_rewrite != nil {
                        var v = stj["value"]
                        if v != nil && v["type"] == "Call" {
                            var fnv = v["fn"]
                            if fnv != nil && fnv["type"] == "Identifier" {
                                fnv["value"] = ctor_rewrite
                                _opt_trace_list_int("[opt] list_int rewrite ctor name=" + nmj + " ctor=" + ctor_rewrite)
                            }
                        }
                    }
                }
            }
        }
        if rewritten != true { oren_list_push(out, stj) }
        j = j + 1
    }
    _opt_list_int_profile_add("rewrite_init", prof_t0)

    block["stmts"] = out

    var j2 = 0
    if OPT_LIST_INT_PROFILE_ENABLED == true { prof_t0 = oren_time_now_ns() }
    while j2 < oren_list_len(out) {
        _opt_rewrite_list_int_stmt(out[j2], list_state)
        j2 = j2 + 1
    }
    _opt_list_int_profile_add("rewrite_uses", prof_t0)
    return nil
}


fn _opt_lower_int_only_lists_in_stmt(stmt, allow_empty, safe_ints_seed) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Block" { return _opt_lower_int_only_lists_in_block_opts(stmt, allow_empty, safe_ints_seed) }
    if t == "If" {
        _opt_lower_int_only_lists_in_stmt(stmt["consq"], allow_empty, safe_ints_seed)
        if stmt["alt"] != nil { _opt_lower_int_only_lists_in_stmt(stmt["alt"], allow_empty, safe_ints_seed) }
        return nil
    }
    if t == "While" || t == "For" {
        if stmt["body"] != nil { _opt_lower_int_only_lists_in_stmt(stmt["body"], allow_empty, safe_ints_seed) }
        return nil
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && c["body"] != nil { _opt_lower_int_only_lists_in_stmt(c["body"], allow_empty, safe_ints_seed) }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil { _opt_lower_int_only_lists_in_stmt(stmt["default"], allow_empty, safe_ints_seed) }
        return nil
    }
    if t == "ExprStmt" && stmt["expr"] != nil && stmt["expr"]["type"] == "If" {
        var e = stmt["expr"]
        _opt_lower_int_only_lists_in_stmt(e["consq"], allow_empty, safe_ints_seed)
        if e["alt"] != nil { _opt_lower_int_only_lists_in_stmt(e["alt"], allow_empty, safe_ints_seed) }
        return nil
    }
    if t == "Function" { return nil }
    return nil
}
