// Token definitions
var TOK_ILLEGAL = "ILLEGAL"
var TOK_EOF = "EOF"
var TOK_IDENT = "IDENT"
var TOK_INT = "INT"
var TOK_FLOAT = "FLOAT"
var TOK_STRING = "STRING"
var TOK_ASSIGN = "="
var TOK_PLUS = "+"
var TOK_MINUS = "-"
var TOK_BANG = "!"
var TOK_TILDE = "~"
var TOK_ASTERISK = "*"
var TOK_SLASH = "/"
var TOK_LT = "<"
var TOK_GT = ">"
var TOK_LTE = "<="
var TOK_GTE = ">="
var TOK_SHL = "<<"
var TOK_SHR = ">>"
var TOK_EQ = "=="
var TOK_NOT_EQ = "!="
var TOK_BITAND = "&"
var TOK_BITOR = "|"
var TOK_BITXOR = "^"
var TOK_AND = "&&"
var TOK_OR = "||"
var TOK_DECLARE = ":="
var TOK_DOT = "."
var TOK_ELLIPSIS = "..."
var TOK_COLON = ":"
var TOK_COMMA = ","
var TOK_SEMICOLON = ";"
var TOK_AT = "@"
var TOK_LPAREN = "("
var TOK_RPAREN = ")"
var TOK_LBRACE = "{"
var TOK_RBRACE = "}"
var TOK_LBRACKET = "["
var TOK_RBRACKET = "]"
var TOK_FUNCTION = "FUNCTION"
var TOK_LET = "LET"
var TOK_TRUE = "TRUE"
var TOK_FALSE = "FALSE"
var TOK_IF = "IF"
var TOK_ELSE = "ELSE"
var TOK_RETURN = "RETURN"
var TOK_WHILE = "WHILE"
var TOK_FOR = "FOR"
var TOK_BREAK = "BREAK"
var TOK_CONTINUE = "CONTINUE"
var TOK_IN = "IN"
var TOK_IMPORT = "IMPORT"
var TOK_STRUCT = "STRUCT"
var TOK_CLASS = "CLASS"
var TOK_NIL = "NIL"
var TOK_FFI = "FFI"
var TOK_TEST = "TEST"
var TOK_SPAWN = "SPAWN"
var TOK_SWITCH = "SWITCH"
var TOK_CASE = "CASE"
var TOK_DEFAULT = "DEFAULT"
var TOK_ENUM = "ENUM"
var TOK_TRAIT = "TRAIT"
var TOK_IMPL = "IMPL"

// Built-in fixed-width type tokens (rolling, reserved identifiers).
// These must be treated as identifiers in expression contexts, but are not legal as user variable names.
var TOK_U8 = "U8"
var TOK_I8 = "I8"
var TOK_U16 = "U16"
var TOK_I16 = "I16"
var TOK_U32 = "U32"
var TOK_I32 = "I32"
var TOK_U64 = "U64"
var TOK_I64 = "I64"
var TOK_U128 = "U128"
var TOK_I128 = "I128"
var TOK_F32 = "F32"
var TOK_F64 = "F64"
var TOK_BOOL_TYPE = "BOOL_TYPE"

// Endian-explicit scalar types (rolling; used by packed byte views and future typed memory layout).
var TOK_U16BE = "U16BE"
var TOK_U16LE = "U16LE"
var TOK_I16BE = "I16BE"
var TOK_I16LE = "I16LE"
var TOK_U32BE = "U32BE"
var TOK_U32LE = "U32LE"
var TOK_I32BE = "I32BE"
var TOK_I32LE = "I32LE"
var TOK_U64BE = "U64BE"
var TOK_U64LE = "U64LE"
var TOK_I64BE = "I64BE"
var TOK_I64LE = "I64LE"

// Character constants
var CH_TAB = oren_char(9)
var CH_LF = oren_char(10)
var CH_CR = oren_char(13)
var CH_QUOTE = oren_char(34)
var CH_BACKSLASH = oren_char(92)

// Helpers
fn is_letter(ch) {
    if ch == "_" { return true }
    if ch >= "a" {
        if ch <= "z" { return true }
    }
    if ch >= "A" {
        if ch <= "Z" { return true }
    }
    return false
}

fn is_digit(ch) {
    if ch >= "0" {
        if ch <= "9" { return true }
    }
    return false
}

fn is_whitespace(ch) {
    if ch == " " { return true }
    if ch == CH_TAB { return true }
    if ch == CH_LF { return true }
    if ch == CH_CR { return true }
    return false
}

fn lookup_ident(ident) {
    if ident == "fn" { return TOK_FUNCTION }
    if ident == "var" { return TOK_LET }
    if ident == "true" { return TOK_TRUE }
    if ident == "false" { return TOK_FALSE }
    if ident == "if" { return TOK_IF }
    if ident == "else" { return TOK_ELSE }
    if ident == "return" { return TOK_RETURN }
    if ident == "while" { return TOK_WHILE }
    if ident == "for" { return TOK_FOR }
    if ident == "break" { return TOK_BREAK }
    if ident == "continue" { return TOK_CONTINUE }
    if ident == "in" { return TOK_IN }
    if ident == "import" { return TOK_IMPORT }
    if ident == "struct" { return TOK_STRUCT }
    if ident == "class" { return TOK_CLASS }
    if ident == "nil" { return TOK_NIL }
    if ident == "ffi" { return TOK_FFI }
    if ident == "test" { return TOK_TEST }
    if ident == "spawn" { return TOK_SPAWN }
    if ident == "switch" { return TOK_SWITCH }
    if ident == "case" { return TOK_CASE }
    if ident == "default" { return TOK_DEFAULT }
    if ident == "enum" { return TOK_ENUM }
    if ident == "trait" { return TOK_TRAIT }
    if ident == "impl" { return TOK_IMPL }

    // Built-in fixed-width types (reserved).
    if ident == "u8" { return TOK_U8 }
    if ident == "i8" { return TOK_I8 }
    if ident == "u16" { return TOK_U16 }
    if ident == "i16" { return TOK_I16 }
    if ident == "u32" { return TOK_U32 }
    if ident == "i32" { return TOK_I32 }
    if ident == "u64" { return TOK_U64 }
    if ident == "i64" { return TOK_I64 }
    if ident == "u128" { return TOK_U128 }
    if ident == "i128" { return TOK_I128 }
    if ident == "f32" { return TOK_F32 }
    if ident == "f64" { return TOK_F64 }
    if ident == "bool" { return TOK_BOOL_TYPE }

    // Endian-explicit scalars (reserved).
    if ident == "u16be" { return TOK_U16BE }
    if ident == "u16le" { return TOK_U16LE }
    if ident == "i16be" { return TOK_I16BE }
    if ident == "i16le" { return TOK_I16LE }
    if ident == "u32be" { return TOK_U32BE }
    if ident == "u32le" { return TOK_U32LE }
    if ident == "i32be" { return TOK_I32BE }
    if ident == "i32le" { return TOK_I32LE }
    if ident == "u64be" { return TOK_U64BE }
    if ident == "u64le" { return TOK_U64LE }
    if ident == "i64be" { return TOK_I64BE }
    if ident == "i64le" { return TOK_I64LE }

    return TOK_IDENT
}

fn is_builtin_type_token(tt) {
    if tt == TOK_U8 { return true }
    if tt == TOK_I8 { return true }
    if tt == TOK_U16 { return true }
    if tt == TOK_I16 { return true }
    if tt == TOK_U32 { return true }
    if tt == TOK_I32 { return true }
    if tt == TOK_U64 { return true }
    if tt == TOK_I64 { return true }
    if tt == TOK_U128 { return true }
    if tt == TOK_I128 { return true }
    if tt == TOK_F32 { return true }
    if tt == TOK_F64 { return true }
    if tt == TOK_BOOL_TYPE { return true }

    if tt == TOK_U16BE { return true }
    if tt == TOK_U16LE { return true }
    if tt == TOK_I16BE { return true }
    if tt == TOK_I16LE { return true }
    if tt == TOK_U32BE { return true }
    if tt == TOK_U32LE { return true }
    if tt == TOK_I32BE { return true }
    if tt == TOK_I32LE { return true }
    if tt == TOK_U64BE { return true }
    if tt == TOK_U64LE { return true }
    if tt == TOK_I64BE { return true }
    if tt == TOK_I64LE { return true }

    return false
}

// Ident-like tokens: legal in expression position (parse as Identifier nodes),
// and legal in dotted namespaces/type positions.
fn is_ident_like_token(tt) {
    if tt == TOK_IDENT { return true }
    return is_builtin_type_token(tt)
}

fn new_token(tt, lit) {
    return {"type": tt, "literal": lit}
}
