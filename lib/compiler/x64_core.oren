    else if cc == "np" { bytes_push(out, 139) }
    else if cc == "b" { bytes_push(out, 130) }
    else if cc == "ae" { bytes_push(out, 131) }
    else if cc == "be" { bytes_push(out, 134) }
    else if cc == "a" { bytes_push(out, 135) }
    else if cc == "l" { bytes_push(out, 140) }
    else if cc == "ge" { bytes_push(out, 141) }
    else if cc == "le" { bytes_push(out, 142) }
