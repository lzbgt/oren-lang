    if reg >= 8 { rex = rex + 1 } // REX.B
    return bytes_lit([rex, 247, 216 + int_mod(reg, 8)]) // 0xD8 | (reg&7)
}

fn insn_call_rax() { return bytes_lit([255, 208]) } // FF D0
