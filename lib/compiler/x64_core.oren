    bytes_push(out, rex)
    bytes_push(out, 129) // 81
    bytes_push(out, 240 + int_mod(dst_reg, 8)) // 0xF0 | rm (0xC0 | (6<<3) | rm)
    push_u32_le(out, imm_u32)
    return out
}

fn insn_and_r64_r64(dst, src) {
    // and r/m64(dst), r64(src) => REX.W 21 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = bytes_new()
    var rex = 72 // 0x48 (REX.W)
    if src >= 8 { rex = rex + 4 } // REX.R
    if dst >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 33) // 21
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_or_r64_r64(dst, src) {
