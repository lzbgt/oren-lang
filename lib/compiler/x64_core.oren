fn insn_cvtsi2sd_xmm_r64(xmm_dst, r_src) {
    // CVTSI2SD xmm, r/m64 => F2 0F 2A /r with REX.W=1
    if xmm_dst < 0 || xmm_dst > 15 { return nil }
    if r_src < 0 || r_src > 15 { return nil }
    var out = bytes_lit([242]) // F2
    var rex = _rex_base_xmm_rm(xmm_dst, r_src, true)
    bytes_push(out, rex)
    bytes_push(out, 15)
    bytes_push(out, 42) // 2A
    bytes_push(out, 192 + int_mod(xmm_dst, 8) * 8 + int_mod(r_src, 8))
    return out
}

fn insn_cvttsd2si_r64_xmm(r_dst, xmm_src) {
    // CVTTSD2SI r64, xmm/m64 => F2 0F 2C /r with REX.W=1
    // modrm: 11 reg=r rm=xmm
    if r_dst < 0 || r_dst > 15 { return nil }
    if xmm_src < 0 || xmm_src > 15 { return nil }
    var out = bytes_lit([242]) // F2
    // Here ModRM.reg is a GPR, ModRM.rm is XMM; treat reg as "xmm_reg" slot for REX.R.
    var rex = 64 + 8 // base + W
    if r_dst >= 8 { rex = rex + 4 } // REX.R (because reg field is r_dst)
    if xmm_src >= 8 { rex = rex + 1 } // REX.B (because rm field is xmm_src)
    bytes_push(out, rex)
    bytes_push(out, 15)
    bytes_push(out, 44) // 2C
    bytes_push(out, 192 + int_mod(r_dst, 8) * 8 + int_mod(xmm_src, 8))
    return out
}

