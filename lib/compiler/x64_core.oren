// x86_64 ("x64") core utilities for the native backend (rolling; Tier-1 target).
//
// Scope (rolling):
// - byte buffer utilities
// - instruction encoder building blocks used by the x64 native backend
//
// Note: while x64 is a Tier-1 target, the encoder surface is still being expanded
// incrementally with fixtures to keep correctness and ABI details tight.

// --- Binary Utils ---
fn bytes_new() { return [] }
fn bytes_push(b, v) { oren_list_push(b, v) }
fn bytes_extend(b, other) {
    var i = 0
    while i < oren_list_len(other) {
        oren_list_push(b, other[i])
        i = i + 1
    }
}

fn int_mod(a, b) {
    // Positive modulus (result in [0, b) for b>0).
    //
    // We use this for byte/bit packing (u8/u16/u32/u64) where callers may pass
    // negative signed immediates (e.g. disp8=-4, imm8=-16). The runtime
    // `oren_write_bytes` requires every element be in 0..255.
    var r = a - (a / b) * b
    if r < 0 { r = r + b }
    return r
}

fn push_u16_le(buf, n) {
    bytes_push(buf, int_mod(n, 256))
    bytes_push(buf, int_mod(n / 256, 256))
}

fn push_u32_le(buf, n) {
    bytes_push(buf, int_mod(n, 256))
    bytes_push(buf, int_mod(n / 256, 256))
    bytes_push(buf, int_mod(n / 65536, 256))
    bytes_push(buf, int_mod(n / 16777216, 256))
}

fn push_u64_le(buf, n) {
    // Encode the low 64 bits of a signed Oren `int` into little-endian bytes.
    //
    // Important: Oren compiler ints are signed (i64). We frequently need to write 64-bit
    // immediates/displacements that conceptually live in a u64 domain (two's complement).
    //
    // Use Euclidean mod to derive low/high 32-bit lanes deterministically without requiring
    // a 2^64 constant (which would not fit in signed i64).
    var lo = int_mod(n, 4294967296)
    var hi = int_mod((n - lo) / 4294967296, 4294967296)
    push_u32_le(buf, lo)
    push_u32_le(buf, hi)
}

fn set_u32_le(buf, offset, n) {
    var base = offset
    oren_index_set(buf, base, int_mod(n, 256))
    oren_index_set(buf, base + 1, int_mod(n / 256, 256))
    oren_index_set(buf, base + 2, int_mod(n / 65536, 256))
    oren_index_set(buf, base + 3, int_mod(n / 16777216, 256))
}

// --- x86_64 instruction encoders (minimal) ---
//
// Register encoding uses the low 3 bits for now (RAX..RDI).
// We intentionally keep the instruction set small to reduce bring-up risk.

fn insn_ret() { return [195] } // C3
fn insn_syscall() { return [15, 5] } // 0F 05

fn insn_push_rbp() { return [85] } // 55
fn insn_pop_rbp() { return [93] }  // 5D
fn insn_mov_rbp_rsp() { return [72, 137, 229] } // 48 89 E5

fn insn_mov_r64_imm64(reg, imm_u64) {
    // movabs r64, imm64  => REX.W + (B8+reg) + imm64
    // v0: reg in 0..15 (RAX..R15).
    if reg < 0 || reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 184 + int_mod(reg, 8)) // B8+(reg&7)
    push_u64_le(out, imm_u64)
    return out
}

fn insn_mov_r32_imm32(reg, imm_u32) {
    // mov r32, imm32 => (B8+reg) imm32
    var out = []
    if reg < 0 || reg > 15 { return nil }
    if reg >= 8 { bytes_push(out, 65) } // 41 (REX.B)
    bytes_push(out, 184 + int_mod(reg, 8))
    push_u32_le(out, imm_u32)
    return out
}

fn insn_cdqe() {
    // cdqe => sign-extend eax into rax (alias for `cltq`)
    // Encoding: 48 98
    return [72, 152]
}

fn insn_mov_r64_r64(dst, src) {
    // mov r/m64, r64 => 48 89 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var rex = 72 // 48 (REX.W)
    if src >= 8 { rex = rex + 4 } // REX.R
    if dst >= 8 { rex = rex + 1 } // REX.B
    return [rex, 137, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8)] // 0xC0 | ((src&7)<<3) | (dst&7)
}

fn insn_mov_r32_r32(dst, src) {
    // mov r/m32, r32 => 89 /r
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 64 // 40 base
    var need = false
    if src >= 8 { rex = rex + 4; need = true } // REX.R
    if dst >= 8 { rex = rex + 1; need = true } // REX.B
    if need { bytes_push(out, rex) }
    bytes_push(out, 137)
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_call_rel32(disp32) {
    // E8 rel32
    var out = [232]
    push_u32_le(out, disp32)
    return out
}

fn insn_jmp_rel32(disp32) {
    // E9 rel32
    var out = [233]
    push_u32_le(out, disp32)
    return out
}

fn insn_mov_rax_mrip_disp32(disp32) {
    // mov rax, [rip+disp32] => 48 8B 05 disp32
    var out = [72, 139, 5]
    push_u32_le(out, disp32)
    return out
}

fn insn_mov_rax_mrax() {
    // mov rax, qword ptr [rax] => 48 8B 00
    return [72, 139, 0]
}

fn insn_lea_rsi_rip_disp32(disp32) {
    // lea rsi, [rip+disp32] => 48 8D 35 disp32
    var out = [72, 141, 53]
    push_u32_le(out, disp32)
    return out
}

fn insn_lea_r64_rip_disp32(reg, disp32) {
    // lea r64, [rip+disp32] => REX.W + 8D + ModRM(00 reg rm=101) + disp32
    if reg < 0 || reg > 15 { return nil }
    var out = []
    var rex = 72 // 48 (REX.W)
    if reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 141) // 8D
    bytes_push(out, 5 + int_mod(reg, 8) * 8) // 0x05 | ((reg&7)<<3)
    push_u32_le(out, disp32)
    return out
}

fn insn_lea_r64_rsp_disp8(reg, disp8) {
    // lea r64, [rsp+disp8] => REX.W + 8D + ModRM + SIB + disp8
    // ModRM: mod=01 reg=(reg&7) rm=100 (SIB)
    // SIB: scale=0 index=100 (none) base=100 (rsp)
    if reg < 0 || reg > 15 { return nil }
    var out = []
    var rex = 72 // 48 (REX.W)
    if reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 141) // 8D
    bytes_push(out, 64 + int_mod(reg, 8) * 8 + 4) // 0x40 | ((reg&7)<<3) | 0x04
    bytes_push(out, 36) // 0x24
    bytes_push(out, int_mod(disp8, 256))
    return out
}

fn insn_sub_rsp_imm8(n) {
    // sub rsp, imm8 => 48 83 EC ib
    return [72, 131, 236, int_mod(n, 256)]
}

fn insn_add_rsp_imm8(n) {
    // add rsp, imm8 => 48 83 C4 ib
    return [72, 131, 196, int_mod(n, 256)]
}

fn insn_sub_rsp_imm32(n) {
    // sub rsp, imm32 => 48 81 EC id
    var out = [72, 129, 236]
    push_u32_le(out, int_mod(n, 4294967296))
    return out
}

fn insn_add_rsp_imm32(n) {
    // add rsp, imm32 => 48 81 C4 id
    var out = [72, 129, 196]
    push_u32_le(out, int_mod(n, 4294967296))
    return out
}

fn insn_mov_mrsp_disp8_imm32(disp8, imm32) {
    // mov dword ptr [rsp+disp8], imm32 => C7 44 24 ib imm32
    var out = [199, 68, 36, int_mod(disp8, 256)]
    push_u32_le(out, imm32)
    return out
}

fn insn_and_rsp_imm8(mask_imm8) {
    // and rsp, imm8 => 48 83 E4 ib  (imm8 is sign-extended)
    // Common usage: mask_imm8 = 0xF0 (-16) to align RSP to 16B boundary.
    return [72, 131, 228, int_mod(mask_imm8, 256)]
}

fn insn_mov_mrbp_disp8_imm32(disp8, imm32) {
    // mov dword ptr [rbp+disp8], imm32 => C7 45 ib imm32
    var out = [199, 69, int_mod(disp8, 256)]
    push_u32_le(out, imm32)
    return out
}

fn insn_mov_r32_mrbp_disp8(dst_reg, disp8) {
    // mov r32, dword ptr [rbp+disp8] => 8B 45 ib (with optional REX.R for r8d-r15d)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    if dst_reg >= 8 { bytes_push(out, 68) } // 0x44 (REX.R)
    bytes_push(out, 139) // 8B
    bytes_push(out, 69 + int_mod(dst_reg, 8) * 8) // 0x45 | ((dst&7)<<3)
    bytes_push(out, int_mod(disp8, 256))
    return out
}

fn insn_mov_mrbp_disp8_r32(disp8, src_reg) {
    // mov dword ptr [rbp+disp8], r32 => 89 45 ib (with optional REX.R for r8d-r15d)
    if src_reg < 0 || src_reg > 15 { return nil }
    var out = []
    if src_reg >= 8 { bytes_push(out, 68) } // 0x44 (REX.R)
    bytes_push(out, 137) // 89
    bytes_push(out, 69 + int_mod(src_reg, 8) * 8) // 0x45 | ((src&7)<<3)
    bytes_push(out, int_mod(disp8, 256))
    return out
}

fn insn_mov_r64_mrbp_disp8(dst_reg, disp8) {
    // mov r64, qword ptr [rbp+disp8] => REX.W 8B 45 ib (with optional REX.R for r8-r15)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 139) // 8B
    bytes_push(out, 69 + int_mod(dst_reg, 8) * 8) // 0x45 | ((dst&7)<<3)
    bytes_push(out, int_mod(disp8, 256))
    return out
}

fn insn_mov_mrbp_disp8_r64(disp8, src_reg) {
    // mov qword ptr [rbp+disp8], r64 => REX.W 89 45 ib (with optional REX.R for r8-r15)
    if src_reg < 0 || src_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if src_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 137) // 89
    bytes_push(out, 69 + int_mod(src_reg, 8) * 8) // 0x45 | ((src&7)<<3)
    bytes_push(out, int_mod(disp8, 256))
    return out
}

fn insn_mov_r64_mrbp_disp32(dst_reg, disp32) {
    // mov r64, qword ptr [rbp+disp32] => REX.W 8B 85 id (with optional REX.R for r8-r15)
    //
    // modrm: mod=10 rm=101 (rbp), reg=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 139) // 8B
    bytes_push(out, 133 + int_mod(dst_reg, 8) * 8) // 0x85 | ((dst&7)<<3)
    push_u32_le(out, int_mod(disp32, 4294967296))
    return out
}

fn insn_mov_mrbp_disp32_r64(disp32, src_reg) {
    // mov qword ptr [rbp+disp32], r64 => REX.W 89 85 id (with optional REX.R for r8-r15)
    //
    // modrm: mod=10 rm=101 (rbp), reg=(src&7)
    if src_reg < 0 || src_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if src_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 137) // 89
    bytes_push(out, 133 + int_mod(src_reg, 8) * 8) // 0x85 | ((src&7)<<3)
    push_u32_le(out, int_mod(disp32, 4294967296))
    return out
}

fn insn_mov_r64_mrsp_disp8(dst_reg, disp8) {
    // mov r64, qword ptr [rsp+disp8] => REX.W 8B 44 24 ib  (or REX.W+REX.R for r8-r15)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 139) // 8B
    bytes_push(out, 68 + int_mod(dst_reg, 8) * 8) // 0x44 | ((dst&7)<<3)
    bytes_push(out, 36) // SIB: 0x24 (scale=0, index=none, base=rsp)
    bytes_push(out, int_mod(disp8, 256))
    return out
}

fn insn_mov_mrsp_disp8_r64(disp8, src_reg) {
    // mov qword ptr [rsp+disp8], r64 => REX.W 89 44 24 ib  (or REX.W+REX.R for r8-r15)
    if src_reg < 0 || src_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if src_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 137) // 89
    bytes_push(out, 68 + int_mod(src_reg, 8) * 8) // 0x44 | ((src&7)<<3)
    bytes_push(out, 36) // 0x24
    bytes_push(out, int_mod(disp8, 256))
    return out
}

fn insn_mov_r64_mrsp_disp32(dst_reg, disp32) {
    // mov r64, qword ptr [rsp+disp32] => REX.W 8B 84 24 id  (or REX.W+REX.R for r8-r15)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 139) // 8B
    bytes_push(out, 132 + int_mod(dst_reg, 8) * 8) // 0x84 | ((dst&7)<<3)
    bytes_push(out, 36) // 0x24
    push_u32_le(out, int_mod(disp32, 4294967296))
    return out
}

fn insn_mov_mrsp_disp32_r64(disp32, src_reg) {
    // mov qword ptr [rsp+disp32], r64 => REX.W 89 84 24 id  (or REX.W+REX.R for r8-r15)
    if src_reg < 0 || src_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if src_reg >= 8 { rex = rex + 4 } // REX.R
    bytes_push(out, rex)
    bytes_push(out, 137) // 89
    bytes_push(out, 132 + int_mod(src_reg, 8) * 8) // 0x84 | ((src&7)<<3)
    bytes_push(out, 36) // 0x24
    push_u32_le(out, int_mod(disp32, 4294967296))
    return out
}

fn insn_add_r32_imm32(dst_reg, imm32) {
    // add r/m32, imm32 => 81 /0 id
    // modrm: 11 reg=000 rm=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    if dst_reg >= 8 { bytes_push(out, 65) } // 0x41 (REX.B) for rm extension
    bytes_push(out, 129) // 81
    bytes_push(out, 192 + int_mod(dst_reg, 8)) // 0xC0 | rm
    push_u32_le(out, imm32)
    return out
}

fn insn_sub_r32_imm32(dst_reg, imm32) {
    // sub r/m32, imm32 => 81 /5 id
    // modrm: 11 reg=101 rm=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    if dst_reg >= 8 { bytes_push(out, 65) } // 0x41 (REX.B)
    bytes_push(out, 129) // 81
    bytes_push(out, 232 + int_mod(dst_reg, 8)) // 0xE8 | rm (0xC0 | (5<<3) | rm)
    push_u32_le(out, imm32)
    return out
}

fn insn_add_r32_r32(dst, src) {
    // add r/m32, r32 => 01 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 64 // 40 base
    var need = false
    if src >= 8 { rex = rex + 4; need = true } // REX.R
    if dst >= 8 { rex = rex + 1; need = true } // REX.B
    if need { bytes_push(out, rex) }
    bytes_push(out, 1) // 01
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_sub_r32_r32(dst, src) {
    // sub r/m32, r32 => 29 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 64 // 40 base
    var need = false
    if src >= 8 { rex = rex + 4; need = true }
    if dst >= 8 { rex = rex + 1; need = true }
    if need { bytes_push(out, rex) }
    bytes_push(out, 41) // 29
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_add_r64_imm32(dst_reg, imm_u32) {
    // add r/m64, imm32 => REX.W 81 /0 id
    // modrm: 11 reg=000 rm=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 129) // 81
    bytes_push(out, 192 + int_mod(dst_reg, 8)) // 0xC0 | rm
    push_u32_le(out, imm_u32)
    return out
}

fn insn_sub_r64_imm32(dst_reg, imm_u32) {
    // sub r/m64, imm32 => REX.W 81 /5 id
    // modrm: 11 reg=101 rm=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 129) // 81
    bytes_push(out, 232 + int_mod(dst_reg, 8)) // 0xE8 | rm (0xC0 | (5<<3) | rm)
    push_u32_le(out, imm_u32)
    return out
}

fn insn_add_r64_r64(dst, src) {
    // add r/m64, r64 => REX.W 01 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if src >= 8 { rex = rex + 4 } // REX.R
    if dst >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 1) // 01
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_sub_r64_r64(dst, src) {
    // sub r/m64, r64 => REX.W 29 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if src >= 8 { rex = rex + 4 } // REX.R
    if dst >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 41) // 29
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_cmp_r32_imm32(lhs_reg, imm32) {
    // cmp r/m32, imm32 => 81 /7 id
    // modrm: 11 reg=111 rm=(lhs&7) => 0xF8 | (lhs&7)
    if lhs_reg < 0 || lhs_reg > 15 { return nil }
    var out = []
    if lhs_reg >= 8 { bytes_push(out, 65) } // 0x41 (REX.B)
    bytes_push(out, 129) // 81
    bytes_push(out, 248 + int_mod(lhs_reg, 8)) // 0xF8 | rm
    push_u32_le(out, imm32)
    return out
}

fn insn_cmp_r32_r32(lhs, rhs) {
    // cmp r/m32(lhs), r32(rhs) => 39 /r
    // modrm: 11 reg=rhs rm=lhs
    if lhs < 0 || lhs > 15 { return nil }
    if rhs < 0 || rhs > 15 { return nil }
    var out = []
    var rex = 64 // 40 base
    var need = false
    if rhs >= 8 { rex = rex + 4; need = true } // REX.R
    if lhs >= 8 { rex = rex + 1; need = true } // REX.B
    if need { bytes_push(out, rex) }
    bytes_push(out, 57) // 39
    bytes_push(out, 192 + int_mod(rhs, 8) * 8 + int_mod(lhs, 8))
    return out
}

fn insn_cmp_r64_imm32(lhs_reg, imm_u32) {
    // cmp r/m64, imm32 => REX.W 81 /7 id
    // modrm: 11 reg=111 rm=(lhs&7) => 0xF8 | (lhs&7)
    if lhs_reg < 0 || lhs_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if lhs_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 129) // 81
    bytes_push(out, 248 + int_mod(lhs_reg, 8)) // 0xF8 | rm
    push_u32_le(out, imm_u32)
    return out
}

fn insn_cmp_r64_r64(lhs, rhs) {
    // cmp r/m64(lhs), r64(rhs) => REX.W 39 /r
    // modrm: 11 reg=rhs rm=lhs
    if lhs < 0 || lhs > 15 { return nil }
    if rhs < 0 || rhs > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if rhs >= 8 { rex = rex + 4 } // REX.R
    if lhs >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 57) // 39
    bytes_push(out, 192 + int_mod(rhs, 8) * 8 + int_mod(lhs, 8))
    return out
}

fn insn_jcc_rel32(cc, disp32) {
    // jcc rel32 => 0F 8? disp32
    //
    // Supported:
    // - "e"  => JE  (0F 84)
    // - "ne" => JNE (0F 85)
    // - "l"  => JL  (0F 8C)  signed less than
    // - "ge" => JGE (0F 8D)  signed greater/equal
    // - "le" => JLE (0F 8E)  signed less/equal
    // - "g"  => JG  (0F 8F)  signed greater than
    if cc != "e" && cc != "ne" && cc != "l" && cc != "ge" && cc != "le" && cc != "g" { return nil }
    var out = [15]
    if cc == "e" { bytes_push(out, 132) }
    else if cc == "ne" { bytes_push(out, 133) }
    else if cc == "l" { bytes_push(out, 140) }
    else if cc == "ge" { bytes_push(out, 141) }
    else if cc == "le" { bytes_push(out, 142) }
    else { bytes_push(out, 143) } // g
    push_u32_le(out, disp32)
    return out
}

fn insn_setcc_al(cc) {
    // setcc al => 0F 9? C0
    //
    // Supported:
    // - "e"  => SETE  (0F 94 C0)
    // - "ne" => SETNE (0F 95 C0)
    // - "l"  => SETL  (0F 9C C0)  signed less than
    // - "ge" => SETGE (0F 9D C0)  signed greater/equal
    // - "le" => SETLE (0F 9E C0)  signed less/equal
    // - "g"  => SETG  (0F 9F C0)  signed greater than
    if cc != "e" && cc != "ne" && cc != "l" && cc != "ge" && cc != "le" && cc != "g" { return nil }
    if cc == "e" { return [15, 148, 192] }
    if cc == "ne" { return [15, 149, 192] }
    if cc == "l" { return [15, 156, 192] }
    if cc == "ge" { return [15, 157, 192] }
    if cc == "le" { return [15, 158, 192] }
    return [15, 159, 192]
}

fn insn_and_r64_imm32(dst_reg, imm_u32) {
    // and r/m64, imm32 => REX.W 81 /4 id
    // modrm: 11 reg=100 rm=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 129) // 81
    bytes_push(out, 224 + int_mod(dst_reg, 8)) // 0xE0 | rm (0xC0 | (4<<3) | rm)
    push_u32_le(out, imm_u32)
    return out
}

fn insn_or_r64_imm32(dst_reg, imm_u32) {
    // or r/m64, imm32 => REX.W 81 /1 id
    // modrm: 11 reg=001 rm=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 129) // 81
    bytes_push(out, 200 + int_mod(dst_reg, 8)) // 0xC8 | rm (0xC0 | (1<<3) | rm)
    push_u32_le(out, imm_u32)
    return out
}

fn insn_xor_r64_imm32(dst_reg, imm_u32) {
    // xor r/m64, imm32 => REX.W 81 /6 id
    // modrm: 11 reg=110 rm=(dst&7)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 129) // 81
    bytes_push(out, 240 + int_mod(dst_reg, 8)) // 0xF0 | rm (0xC0 | (6<<3) | rm)
    push_u32_le(out, imm_u32)
    return out
}

fn insn_and_r64_r64(dst, src) {
    // and r/m64(dst), r64(src) => REX.W 21 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if src >= 8 { rex = rex + 4 } // REX.R
    if dst >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 33) // 21
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_or_r64_r64(dst, src) {
    // or r/m64(dst), r64(src) => REX.W 09 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if src >= 8 { rex = rex + 4 } // REX.R
    if dst >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 9) // 09
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_xor_r64_r64(dst, src) {
    // xor r/m64(dst), r64(src) => REX.W 31 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if src >= 8 { rex = rex + 4 } // REX.R
    if dst >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 49) // 31
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_shl_r64_imm8(reg, imm8) {
    // shl r/m64, imm8 => REX.W C1 /4 ib
    // modrm: 11 reg=100 rm=(reg&7)
    if reg < 0 || reg > 15 { return nil }
    if imm8 < 0 || imm8 > 255 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 193) // C1
    bytes_push(out, 224 + int_mod(reg, 8)) // 0xE0 | rm
    bytes_push(out, imm8)
    return out
}

fn insn_shr_r64_imm8(reg, imm8) {
    // shr r/m64, imm8 => REX.W C1 /5 ib
    // modrm: 11 reg=101 rm=(reg&7)
    if reg < 0 || reg > 15 { return nil }
    if imm8 < 0 || imm8 > 255 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 193) // C1
    bytes_push(out, 232 + int_mod(reg, 8)) // 0xE8 | rm
    bytes_push(out, imm8)
    return out
}

fn insn_shl_r64_cl(reg) {
    // shl r/m64, cl => REX.W D3 /4
    // modrm: 11 reg=100 rm=(reg&7)
    if reg < 0 || reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 211) // D3
    bytes_push(out, 224 + int_mod(reg, 8)) // 0xE0 | rm
    return out
}

fn insn_shr_r64_cl(reg) {
    // shr r/m64, cl => REX.W D3 /5
    // modrm: 11 reg=101 rm=(reg&7)
    if reg < 0 || reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 211) // D3
    bytes_push(out, 232 + int_mod(reg, 8)) // 0xE8 | rm
    return out
}

fn insn_movsxd_r64_r32(dst, src) {
    // movsxd r64(dst), r/m32(src) => REX.W 63 /r
    // modrm: 11 reg=dst rm=src
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst >= 8 { rex = rex + 4 } // REX.R
    if src >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 99) // 0x63
    bytes_push(out, 192 + int_mod(dst, 8) * 8 + int_mod(src, 8))
    return out
}

fn insn_cqo() {
    // cqo => REX.W 99
    return [72, 153] // 0x48 0x99
}

fn insn_idiv_r64(reg) {
    // idiv r/m64 => REX.W F7 /7
    // modrm: 11 reg=111 rm=(reg&7) => 0xF8 | (reg&7)
    if reg < 0 || reg > 15 { return nil }
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    return [rex, 247, 248 + int_mod(reg, 8)]
}

fn insn_imul_r32_imm32(reg, imm32) {
    // imul r32, r/m32, imm32 => 69 /r id
    // modrm: 11 reg=(reg&7) rm=(reg&7) => 0xC0 | ((reg&7)<<3) | (reg&7)
    if reg < 0 || reg > 15 { return nil }
    var out = []
    if reg >= 8 { bytes_push(out, 69) } // 0x45 (REX.R + REX.B) for same reg in both fields
    bytes_push(out, 105) // 69
    bytes_push(out, 192 + int_mod(reg, 8) * 9) // 0xC0 | ((r<<3)|r) == 0xC0 + 9*r
    push_u32_le(out, imm32)
    return out
}

fn insn_imul_r64_imm32(reg, imm_u32) {
    // imul r64, r/m64, imm32 => REX.W 69 /r id
    // modrm: 11 reg=(reg&7) rm=(reg&7) => 0xC0 | ((reg&7)<<3) | (reg&7)
    if reg < 0 || reg > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 5 } // REX.R + REX.B (same reg in both fields)
    bytes_push(out, rex)
    bytes_push(out, 105) // 69
    bytes_push(out, 192 + int_mod(reg, 8) * 9) // 0xC0 + 9*r
    push_u32_le(out, imm_u32)
    return out
}

fn insn_imul_r64_r64(dst, src) {
    // imul r64(dst), r/m64(src) => REX.W 0F AF /r
    // modrm: 11 reg=dst rm=src
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = []
    var rex = 72 // 0x48 (REX.W)
    if dst >= 8 { rex = rex + 4 } // REX.R
    if src >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 15) // 0F
    bytes_push(out, 175) // AF
    bytes_push(out, 192 + int_mod(dst, 8) * 8 + int_mod(src, 8))
    return out
}

fn insn_not_r64(reg) {
    // not r/m64 => REX.W F7 /2
    // modrm: 11 reg=010 rm=(reg&7)
    if reg < 0 || reg > 15 { return nil }
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    return [rex, 247, 208 + int_mod(reg, 8)] // 0xD0 | (reg&7)
}

fn insn_neg_r64(reg) {
    // neg r/m64 => REX.W F7 /3
    // modrm: 11 reg=011 rm=(reg&7)
    if reg < 0 || reg > 15 { return nil }
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    return [rex, 247, 216 + int_mod(reg, 8)] // 0xD8 | (reg&7)
}

fn insn_call_rax() { return [255, 208] } // FF D0
