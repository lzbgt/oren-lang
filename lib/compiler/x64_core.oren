import bb "bytes_builder.oren"

// x86_64 ("x64") core utilities for the native backend (rolling; Tier-1 target).
//
// Scope (rolling):
// - byte buffer utilities
// - instruction encoder building blocks used by the x64 native backend
//
// Note: while x64 is a Tier-1 target, the encoder surface is still being expanded
// incrementally with fixtures to keep correctness and ABI details tight.

// --- Binary Utils ---
// Re-export shared byte-builder helpers so backend code stays readable.
fn bytes_new() { return bb.bytes_new() }
fn bytes_len(b) { return bb.bytes_len(b) }
fn bytes_push(b, v) { return bb.bytes_push(b, v) }
fn bytes_extend(b, other) { return bb.bytes_extend(b, other) }
fn bytes_extend_zeros(b, n) { return bb.bytes_extend_zeros(b, n) }
fn bytes_extend_list(b, xs) { return bb.bytes_extend_list(b, xs) }
fn bytes_extend_u8_buf(b, ubuf) { return bb.bytes_extend_u8_buf(b, ubuf) }
fn bytes_extend_string(b, s) { return bb.bytes_extend_string(b, s) }

// --- Instruction scratch pool (Tier‑1 perf) ---
//
// x64 codegen emits a lot of tiny instruction byte sequences. Historically, instruction encoder
// helpers allocated a fresh `u8_buf` builder per instruction and then `bytes_extend(...)` copied
// those bytes into the main code buffer.
//
// In the self-hosted compiler, that per-instruction allocation overhead is catastrophic
// (hundreds of thousands of allocations per build), and it dominated x64 runtime-object (rtobj)
// compilation time during cross-target builds.
//
// Rolling fix: keep a small ring of reusable builders for instruction encoders. Callers almost
// always immediately `bytes_extend(ctx["code"], insn_...())`, so reuse is safe in practice.
// The ring makes accidental "hold two insns at once" patterns less fragile.
//
// NOTE: not thread-safe; native compiler is single-threaded today.
var g_insn_pool = 0
var g_insn_pool_i = 0

fn _insn_pool_get() {
    if g_insn_pool == 0 {
        var pool = []
        var i = 0
        var n = 8
        while i < n {
            oren_list_push(pool, bytes_new())
            i = i + 1
        }
        g_insn_pool = pool
        g_insn_pool_i = 0
    }
    var idx = g_insn_pool_i
    g_insn_pool_i = g_insn_pool_i + 1
    if g_insn_pool_i >= oren_list_len(g_insn_pool) { g_insn_pool_i = 0 }
    var b = g_insn_pool[idx]
    // Reset to empty: len encoding is len+1, so 1 means len=0.
    if b != nil { b["len"] = 1 }
    return b
}

fn bytes_lit(xs) {
    // Use the instruction scratch pool to avoid per-literal allocations in hot encoder paths.
    var b = _insn_pool_get()
    bytes_extend_list(b, xs)
    return b
}

fn int_mod(a, b) {
    // Positive modulus (result in [0, b) for b>0).
    //
    // We use this for byte/bit packing (u8/u16/u32/u64) where callers may pass
    // negative signed immediates (e.g. disp8=-4, imm8=-16). The runtime
    // `oren_write_bytes` requires every element be in 0..255.
    var r = a - (a / b) * b
    if r < 0 { r = r + b }
    return r
}

// Parse a decimal integer from a string (best-effort).
// Returns `dflt` on invalid input.
//
// Note: implemented here (compiler core) so it is available in both stage1 (C runtime)
// and stage2 (native runtime) when decoding env knobs.
fn parse_int_decimal(s, dflt) {
    if s == nil { return dflt }
    var n = oren_string_len(s)
    if n <= 0 { return dflt }
    var i = 0
    var neg = false
    if (oren_string_byte_at_unchecked(s, 0) & 255) == 45 { // '-'
        neg = true
        i = 1
        if n == 1 { return dflt }
    }
    var v = 0
    while i < n {
        var c = oren_string_byte_at_unchecked(s, i) & 255
        if c < 48 || c > 57 { return dflt }
        v = v * 10 + (c - 48)
        i = i + 1
        if i > 32 { return dflt } // bound (avoid runaway on huge strings)
    }
    if neg { return -v }
    return v
}

// Stable string equality used in compiler hot paths.
// Avoid depending on runtime string equality semantics (stage1 vs stage2-native).
fn string_eq_bytes(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

// Prefix/suffix checks without allocating substrings.
// Keep these in x64_core because they are used in very hot compiler paths (call lowering).
fn string_has_prefix_bytes(s, prefix) {
    if s == nil || prefix == nil { return false }
    var ls = oren_string_len(s)
    var lp = oren_string_len(prefix)
    if lp > ls { return false }
    var i = 0
    while i < lp {
        if (oren_string_byte_at_unchecked(s, i) & 255) != (oren_string_byte_at_unchecked(prefix, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn string_has_suffix_bytes(s, suffix) {
    if s == nil || suffix == nil { return false }
    var ls = oren_string_len(s)
    var lp = oren_string_len(suffix)
    if lp > ls { return false }
    var start = ls - lp
    var i = 0
    while i < lp {
        if (oren_string_byte_at_unchecked(s, start + i) & 255) != (oren_string_byte_at_unchecked(suffix, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn push_u16_le(buf, n) {
    return bb.bytes_push_u16_le(buf, n)
}

fn push_u32_le(buf, n) {
    return bb.bytes_push_u32_le(buf, n)
}

fn push_u64_le(buf, n) {
    return bb.bytes_push_u64_le(buf, n)
}

fn set_u32_le(buf, offset, n) {
    // Delegate to the bytes builder fast path (1 bounds check + raw stores).
    return bb.bytes_set_u32_le(buf, offset, n)
}

fn bytes_set_u8(b, idx, v) { return bb.bytes_set_u8(b, idx, v) }
fn bytes_finalize(b) { return bb.bytes_finalize(b) }

// --- x86_64 instruction encoders (minimal) ---
//
// Register encoding uses the low 3 bits for now (RAX..RDI).
// We intentionally keep the instruction set small to reduce bring-up risk.

fn insn_ret() { var out = _insn_pool_get(); bytes_push(out, 195); return out } // C3
fn insn_syscall() { var out = _insn_pool_get(); bytes_push(out, 15); bytes_push(out, 5); return out } // 0F 05

fn insn_push_rbp() { var out = _insn_pool_get(); bytes_push(out, 85); return out } // 55
fn insn_pop_rbp() { var out = _insn_pool_get(); bytes_push(out, 93); return out }  // 5D
fn insn_mov_rbp_rsp() { var out = _insn_pool_get(); bytes_push(out, 72); bytes_push(out, 137); bytes_push(out, 229); return out } // 48 89 E5

fn insn_push_r64(reg) {
    // push r64 => (REX.B)? + (50 + (reg&7))
    if reg < 0 || reg > 15 { return nil }
    var out = _insn_pool_get()
    if reg >= 8 { bytes_push(out, 65) } // 41 (REX.B)
    bytes_push(out, 80 + int_mod(reg, 8))
    return out
}

fn insn_pop_r64(reg) {
    // pop r64 => (REX.B)? + (58 + (reg&7))
    if reg < 0 || reg > 15 { return nil }
    var out = _insn_pool_get()
    if reg >= 8 { bytes_push(out, 65) } // 41 (REX.B)
    bytes_push(out, 88 + int_mod(reg, 8))
    return out
}

fn insn_mov_r64_imm64(reg, imm_u64) {
    // movabs r64, imm64  => REX.W + (B8+reg) + imm64
    // v0: reg in 0..15 (RAX..R15).
    if reg < 0 || reg > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 72 // 0x48 (REX.W)
    if reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 184 + int_mod(reg, 8)) // B8+(reg&7)
    push_u64_le(out, imm_u64)
    return out
}

fn insn_mov_r32_imm32(reg, imm_u32) {
    // mov r32, imm32 => (B8+reg) imm32
    var out = _insn_pool_get()
    if reg < 0 || reg > 15 { return nil }
    if reg >= 8 { bytes_push(out, 65) } // 41 (REX.B)
    bytes_push(out, 184 + int_mod(reg, 8))
    push_u32_le(out, imm_u32)
    return out
}

fn insn_cdqe() {
    // cdqe => sign-extend eax into rax (alias for `cltq`)
    // Encoding: 48 98
    var out = _insn_pool_get()
    bytes_push(out, 72)
    bytes_push(out, 152)
    return out
}

fn insn_mov_r64_r64(dst, src) {
    // mov r/m64, r64 => 48 89 /r
    // modrm: 11 reg=src rm=dst
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 72 // 48 (REX.W)
    if src >= 8 { rex = rex + 4 } // REX.R
    if dst >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 137)
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8)) // 0xC0 | ((src&7)<<3) | (dst&7)
    return out
}

fn insn_mov_r32_r32(dst, src) {
    // mov r/m32, r32 => 89 /r
    if dst < 0 || dst > 15 { return nil }
    if src < 0 || src > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 64 // 40 base
    var need = false
    if src >= 8 { rex = rex + 4; need = true } // REX.R
    if dst >= 8 { rex = rex + 1; need = true } // REX.B
    if need { bytes_push(out, rex) }
    bytes_push(out, 137)
    bytes_push(out, 192 + int_mod(src, 8) * 8 + int_mod(dst, 8))
    return out
}

fn insn_call_rel32(disp32) {
    // E8 rel32
    var out = _insn_pool_get()
    bytes_push(out, 232)
    push_u32_le(out, disp32)
    return out
}

fn insn_jmp_rel32(disp32) {
    // E9 rel32
    var out = _insn_pool_get()
    bytes_push(out, 233)
    push_u32_le(out, disp32)
    return out
}

fn insn_mov_rax_mrip_disp32(disp32) {
    // mov rax, [rip+disp32] => 48 8B 05 disp32
    var out = _insn_pool_get()
    bytes_push(out, 72)
    bytes_push(out, 139)
    bytes_push(out, 5)
    push_u32_le(out, disp32)
    return out
}

fn insn_mov_rax_mrax() {
    // mov rax, qword ptr [rax] => 48 8B 00
    var out = _insn_pool_get()
    bytes_push(out, 72)
    bytes_push(out, 139)
    bytes_push(out, 0)
    return out
}

fn _mem_base_modrm_and_sib(base_reg, reg_field_low3) {
    // Encode ModRM (+ optional SIB + optional disp8=0) for the addressing mode [base_reg].
    //
    // This handles the x86_64 encoding quirks:
    // - rm=100 (rsp/r12) requires a SIB byte
    // - rm=101 (rbp/r13) cannot be encoded with mod=00; use mod=01 with disp8=0
    //
    // Returns {"modrm": byte, "sib": byte|nil, "disp8": byte|nil}.
    //
    // IMPORTANT (native backend semantics):
    // - `nil` is a distinct runtime singleton value (not the integer 0).
    // - Optional bytes can use the full 0..255 range, with `nil` meaning “absent”.
    if base_reg < 0 || base_reg > 15 { return nil }
    var rm = int_mod(base_reg, 8)
    var mod = 0
    var sib = nil
    var disp8 = nil

    // rbp/r13: force disp8=0 so it's [rbp+0] instead of RIP-relative.
    if rm == 5 {
        mod = 1
        disp8 = 0
    }

    // rsp/r12: require SIB byte with index=none, base=rsp.
    if rm == 4 {
        sib = 36 // 0x24 (scale=0, index=100 (none), base=100 (rsp))
        rm = 4
    }

    var modrm = 0
    if mod == 1 { modrm = 64 } // 0x40
    modrm = modrm + int_mod(reg_field_low3, 8) * 8 + rm
    return {"modrm": modrm, "sib": sib, "disp8": disp8}
}

fn _mem_base_modrm_and_sib_disp(base_reg, reg_field_low3, disp) {
    // Encode ModRM (+ optional SIB + optional disp8/disp32) for the addressing mode:
    //   [base_reg + disp]
    //
    // `disp` is a signed Oren int; encoding uses either:
    // - mod=00 with no disp (when disp==0 and base is not rbp/r13)
    // - mod=01 with disp8
    // - mod=10 with disp32
    //
    // Handles x86_64 quirks:
    // - rm=100 (rsp/r12) requires a SIB byte
    // - rm=101 (rbp/r13) cannot be encoded with mod=00; encode as mod=01 disp8=0
    //
    // Returns {"modrm": byte, "sib": byte|nil, "disp8": byte|nil, "disp32": int|nil}.
    // (disp32 is returned as a signed int; caller encodes with push_u32_le)
    //
    // IMPORTANT (native backend semantics):
    // `disp8` is returned as a 0..255 byte (where `nil` means absent).
    if base_reg < 0 || base_reg > 15 { return nil }
    var rm = int_mod(base_reg, 8)
    var sib = nil

    // rsp/r12: require SIB byte with index=none, base=rsp/r12.
    if rm == 4 {
        sib = 36 // 0x24 (scale=0, index=100 (none), base=100 (rsp/r12 via REX.B))
        rm = 4
    }

    // Decide mod/disp encoding.
    var mod = 0
    var disp8 = nil
    var disp32 = nil

    var want_no_disp = (disp == 0 && rm != 5)
    if want_no_disp != true {
        // Prefer disp8 when possible (including the rbp/r13 disp=0 special-case).
        if disp >= -128 && disp <= 127 {
            mod = 1
            disp8 = int_mod(disp, 256)
        } else {
            mod = 2
            disp32 = disp
        }
    }

    // rbp/r13 with disp==0: force disp8=0 so it's [rbp+0] instead of RIP-relative.
    if rm == 5 && disp == 0 {
        mod = 1
        disp8 = 0
        disp32 = nil
    }

    var modrm = 0
    if mod == 1 { modrm = 64 } // 0x40
    if mod == 2 { modrm = 128 } // 0x80
    modrm = modrm + int_mod(reg_field_low3, 8) * 8 + rm
    return {"modrm": modrm, "sib": sib, "disp8": disp8, "disp32": disp32}
}

fn insn_mov_r64_mr64(dst_reg, base_reg) {
    // mov r64, qword ptr [base_reg]
    // Encoding: REX.W + 8B /r with ModRM addressing [base]
    if dst_reg < 0 || dst_reg > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 72 // 0x48 (REX.W)
    if dst_reg >= 8 { rex = rex + 4 } // REX.R
    if base_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 139) // 8B
    var enc = _mem_base_modrm_and_sib(base_reg, int_mod(dst_reg, 8))
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    return out
}

fn insn_mov_mr64_r64(base_reg, src_reg) {
    // mov qword ptr [base_reg], src_reg
    // Encoding: REX.W + 89 /r with ModRM addressing [base]
    if src_reg < 0 || src_reg > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 72 // 0x48 (REX.W)
    if src_reg >= 8 { rex = rex + 4 } // REX.R
    if base_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 137) // 89
    var enc = _mem_base_modrm_and_sib(base_reg, int_mod(src_reg, 8))
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    return out
}

fn insn_lock_xadd_mr64_r64(base_reg, src_reg) {
    // lock xadd qword ptr [base_reg], src_reg
    //
    // Semantics:
    // - tmp := [mem]
    // - [mem] := tmp + src_reg
    // - src_reg := tmp
    //
    // Encoding: F0 REX.W 0F C1 /r
    if src_reg < 0 || src_reg > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    bytes_push(out, 240) // F0 (LOCK)
    var rex = 72 // 0x48 (REX.W)
    if src_reg >= 8 { rex = rex + 4 }  // REX.R
    if base_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 15)  // 0F
    bytes_push(out, 193) // C1
    var enc = _mem_base_modrm_and_sib(base_reg, int_mod(src_reg, 8))
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    return out
}

fn insn_lock_cmpxchg_mr64_r64(base_reg, src_reg) {
    // lock cmpxchg qword ptr [base_reg], src_reg
    //
    // Semantics (64-bit form):
    // - compare RAX (expected) with [mem]
    // - if equal: [mem] := src_reg (new), ZF=1
    // - else: RAX := [mem] (old), ZF=0
    //
    // Encoding: F0 REX.W 0F B1 /r
    if src_reg < 0 || src_reg > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    bytes_push(out, 240) // F0 (LOCK)
    var rex = 72 // 0x48 (REX.W)
    if src_reg >= 8 { rex = rex + 4 }  // REX.R
    if base_reg >= 8 { rex = rex + 1 } // REX.B
    bytes_push(out, rex)
    bytes_push(out, 15)  // 0F
    bytes_push(out, 177) // B1
    var enc = _mem_base_modrm_and_sib(base_reg, int_mod(src_reg, 8))
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    return out
}

fn insn_movzx_r32_mr8(dst_reg, base_reg) {
    // movzx r32, byte ptr [base_reg]
    // Encoding: 0F B6 /r (+ optional REX for r8d-r15d or base r8-r15)
    if dst_reg < 0 || dst_reg > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 64 // 0x40 base
    var need = false
    if dst_reg >= 8 { rex = rex + 4; need = true } // REX.R
    if base_reg >= 8 { rex = rex + 1; need = true } // REX.B
    if need { bytes_push(out, rex) }
    bytes_push(out, 15) // 0F
    bytes_push(out, 182) // B6
    var enc = _mem_base_modrm_and_sib(base_reg, int_mod(dst_reg, 8))
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    return out
}

fn insn_movzx_r32_mr8_disp(dst_reg, base_reg, disp) {
    // movzx r32, byte ptr [base_reg + disp]
    // Encoding: 0F B6 /r (+ optional REX for r8d-r15d or base r8-r15) + disp8/disp32
    if dst_reg < 0 || dst_reg > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 64 // 0x40 base
    var need = false
    if dst_reg >= 8 { rex = rex + 4; need = true } // REX.R
    if base_reg >= 8 { rex = rex + 1; need = true } // REX.B
    if need { bytes_push(out, rex) }
    bytes_push(out, 15) // 0F
    bytes_push(out, 182) // B6
    var enc = _mem_base_modrm_and_sib_disp(base_reg, int_mod(dst_reg, 8), disp)
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    if enc["disp32"] != nil { push_u32_le(out, enc["disp32"]) }
    return out
}

fn insn_mov_mr8_al(base_reg) {
    // mov byte ptr [base_reg], al
    // Encoding: 88 /r (reg=0) (+ optional REX.B for base r8-r15)
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    if base_reg >= 8 { bytes_push(out, 65) } // 0x41 (REX.B)
    bytes_push(out, 136) // 88
    var enc = _mem_base_modrm_and_sib(base_reg, 0)
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    return out
}

fn insn_mov_mr8_al_disp(base_reg, disp) {
    // mov byte ptr [base_reg + disp], al
    // Encoding: 88 /r (reg=0) (+ optional REX.B for base r8-r15) + disp8/disp32
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    if base_reg >= 8 { bytes_push(out, 65) } // 0x41 (REX.B)
    bytes_push(out, 136) // 88
    var enc = _mem_base_modrm_and_sib_disp(base_reg, 0, disp)
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
    if enc["disp8"] != nil { bytes_push(out, enc["disp8"]) }
    if enc["disp32"] != nil { push_u32_le(out, enc["disp32"]) }
    return out
}

fn insn_mov_r32_mr32_disp(dst_reg, base_reg, disp) {
    // mov r32, dword ptr [base_reg + disp]
    // Encoding: 8B /r (+ optional REX) + disp8/disp32
    if dst_reg < 0 || dst_reg > 15 { return nil }
    if base_reg < 0 || base_reg > 15 { return nil }
    var out = _insn_pool_get()
    var rex = 64 // 0x40 base
    var need = false
    if dst_reg >= 8 { rex = rex + 4; need = true } // REX.R
    if base_reg >= 8 { rex = rex + 1; need = true } // REX.B
    if need { bytes_push(out, rex) }
    bytes_push(out, 139) // 8B
    var enc = _mem_base_modrm_and_sib_disp(base_reg, int_mod(dst_reg, 8), disp)
    if enc == nil { return nil }
    bytes_push(out, enc["modrm"])
    if enc["sib"] != nil { bytes_push(out, enc["sib"]) }
