// Native ABI helpers (rolling).
//
// This module is the first step toward sharing native backend lowering across Tier-1
// architectures (arm64 + x86_64) while keeping ABI details explicit and testable.

import win64 "native_abi_x64_win64.oren"
import sysv "native_abi_x64_sysv.oren"
import aapcs "native_abi_arm64_aapcs.oren"

fn x64(platform) {
    if platform != nil && platform["os"] == "windows" { return win64.x64_win64() }
    return sysv.x64_sysv()
}

fn arm64(platform) {
    // AAPCS64 calling convention is shared across Linux/macOS for integer/pointer args.
    return aapcs.arm64_aapcs()
}

fn max_int_reg_args(abi) {
    if abi == nil || abi["int_arg_regs"] == nil { return 0 }
    return oren_list_len(abi["int_arg_regs"])
}

fn int_arg_reg(abi, arg_index) {
    var regs = nil
    if abi != nil { regs = abi["int_arg_regs"] }
    if regs == nil { return nil }
    if arg_index < 0 || arg_index >= oren_list_len(regs) { return nil }
    // IMPORTANT (native backend compatibility):
    // Native runtime uses `0` as the "nil" sentinel, so callers must never use `== nil`
    // checks on values where 0 is a valid payload (e.g. register number X0).
    //
    // To avoid nil/0 ambiguity, return register numbers encoded as `reg+1`:
    // - 0 means "missing"
    // - 1..N map to real regs 0..N-1
    //
    // Note: on arm64, the first int arg reg is X0 (reg 0). Under the native runtime's
    // stopgap value model, list element 0 is indistinguishable from `nil` when read back,
    // so `regs[0]` may appear as `nil` even though the ABI list contains `0`.
    // Treat that as reg 0 and continue with the encoding.
    var reg = regs[arg_index]
    if reg == nil { reg = 0 }
    return reg + 1
}

fn caller_shadow_bytes(abi) {
    if abi == nil { return 0 }
    var n = abi["caller_shadow_bytes"]
    if n == nil { return 0 }
    return n
}

fn callee_call_area_bytes(abi) {
    // Extra stack space reserved in function frames to support nested calls safely.
    // For Win64 we reserve >= 32B shadow plus scratch for stack args used by syscalls/FFI.
    if abi == nil { return 0 }
    var n = abi["callee_call_area_bytes"]
    if n == nil { return 0 }
    return n
}

fn stack_arg_slot_bytes(abi) {
    if abi == nil { return 8 }
    var n = abi["stack_arg_slot_bytes"]
    if n == nil { return 8 }
    return n
}

fn stack_align_bytes(abi) {
    if abi == nil { return 16 }
    var n = abi["stack_align_bytes"]
    if n == nil { return 16 }
    return n
}

fn callee_saved_regs(abi) {
    // Return the ABI's callee-saved integer regs (backend register-numbering).
    //
    // Backends may choose to save/restore these conservatively in their function prologues
    // so generated code obeys the platform ABI when calling injected runtime helpers and
    // external OS APIs / syscalls.
    if abi == nil { return [] }
    var regs = abi["callee_saved_regs"]
    if regs == nil { return [] }
    return regs
}

// ---- x86_64 Tier-1 fixed-base emitters (rolling v0) ----
//
// The x64 native backend currently emits fixed-base executables without relocations:
// - Linux: ET_EXEC at 0x400000 with headers prepended
// - Windows: PE32+ ImageBase 0x400000 with .text at RVA 0x1000
//
// This lets the panic/diagnostic path do best-effort addr→symbol mapping without
// a full debug-info pipeline, but it requires that these constants remain consistent
// with `lib/compiler/x64_elf.oren` and `lib/compiler/x64_pe.oren`.

fn x64_v0_linux_elf_base_addr() { return 4194304 } // 0x400000
// ELF header size for the x64 fixed-base ET_EXEC emitter (rolling v0).
//
// We emit 2 program headers:
// - PT_LOAD RX: headers + .text (+ pad)
// - PT_LOAD RW: data blob (string literals, fnobj records, mutable globals)
fn x64_v0_linux_elf_hdr_size_bytes() { return 64 + 56 * 2 } // ELF64_Ehdr + 2*Elf64_Phdr
fn x64_v0_linux_text_base_addr() { return x64_v0_linux_elf_base_addr() + x64_v0_linux_elf_hdr_size_bytes() }

fn x64_v0_windows_pe_image_base() { return 4194304 } // 0x400000
fn x64_v0_windows_text_rva() { return 4096 } // 0x1000
fn x64_v0_windows_text_base_addr() { return x64_v0_windows_pe_image_base() + x64_v0_windows_text_rva() }

fn x64_v0_text_base_addr(platform) {
    if platform != nil && platform["os"] == "windows" { return x64_v0_windows_text_base_addr() }
    return x64_v0_linux_text_base_addr()
}
