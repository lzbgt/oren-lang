import token "token.oren"
import ast "ast.oren"
import core "parser_core.oren"

// Re-export precedence constants into this module's scope so the rest of the
// parser code can remain unchanged after refactoring `parser.oren` into modules.
var LOWEST = core.LOWEST
var OR_P = core.OR_P
var AND_P = core.AND_P
var BITOR_P = core.BITOR_P
var BITXOR_P = core.BITXOR_P
var BITAND_P = core.BITAND_P
var EQUALS_P = core.EQUALS_P
var LESSGREATER_P = core.LESSGREATER_P
var SHIFT_P = core.SHIFT_P
var SUM_P = core.SUM_P
var PRODUCT_P = core.PRODUCT_P
var CAST_P = core.CAST_P
var PREFIX_P = core.PREFIX_P
var CALL_P = core.CALL_P
var INDEX_P = core.INDEX_P

fn precedence(tokType) { return core.precedence(tokType) }

// Core helper shims (keep existing parser logic unchanged).
fn type_env_push(p) { return core.type_env_push(p) }
fn type_env_pop(p) { return core.type_env_pop(p) }
fn type_env_set(p, name, tname) { return core.type_env_set(p, name, tname) }
fn type_env_get(p, name) { return core.type_env_get(p, name) }

fn expr_dotted_name(e) { return core.expr_dotted_name(e) }
fn impl_method_register(p, type_name, method, mangled) { return core.impl_method_register(p, type_name, method, mangled) }
fn impl_method_lookup(p, type_name, method) { return core.impl_method_lookup(p, type_name, method) }
fn impl_trait_method_register(p, trait_name, type_name, method, mangled) { return core.impl_trait_method_register(p, trait_name, type_name, method, mangled) }
fn impl_trait_method_lookup(p, trait_name, type_name, method) { return core.impl_trait_method_lookup(p, trait_name, type_name, method) }

fn str_starts_with(s, prefix) { return core.str_starts_with(s, prefix) }
fn attr_is_reserved(name) { return core.attr_is_reserved(name) }
fn attr_is_known(p, name) { return core.attr_is_known(p, name) }
fn attr_is_allowlisted(p, name) { return core.attr_is_allowlisted(p, name) }
fn attr_normalize_name(name) { return core.attr_normalize_name(name) }
fn attr_validate(p, name) { return core.attr_validate(p, name) }

fn parser_gensym(p, prefix) { return core.parser_gensym(p, prefix) }
fn parser_add_error(p, msg) { return core.parser_add_error(p, msg) }
fn docs_join(lines) { return core.docs_join(lines) }
fn parse_doc_list(p) { return core.parse_doc_list(p) }
fn parser_take_pending_doc(p) { return core.parser_take_pending_doc(p) }

fn parser_next_token(p) { return core.parser_next_token(p) }
fn cur_is(p, t) { return core.cur_is(p, t) }
fn peek_is(p, t) { return core.peek_is(p, t) }
fn cur_is_ident_like(p) { return core.cur_is_ident_like(p) }
fn peek_is_ident_like(p) { return core.peek_is_ident_like(p) }
fn expect_peek(p, t) { return core.expect_peek(p, t) }
fn expect_peek_ident_like(p, what) { return core.expect_peek_ident_like(p, what) }
fn parse_type_name_after_colon(p) { return core.parse_type_name_after_colon(p) }

fn parse_program(p) {
    var prog = ast.new_program()
    while p["cur"]["type"] != token.TOK_EOF {
        // Allow doc comments and attributes to appear in either order before a declaration:
        //   /// doc
        //   @attr(...)
        //   fn ...
        //
        // or:
        //   @attr(...)
        //   /// doc
        //   struct ...
        //
        // We collect both deterministically and attach to the next declaration only.
        var doc_lines = []
        var attrs = []
        while cur_is(p, token.TOK_DOC) || cur_is(p, token.TOK_AT) {
            if cur_is(p, token.TOK_DOC) {
                oren_list_push(doc_lines, p["cur"]["literal"])
                parser_next_token(p)
            } else {
                var a = parse_attr(p)
                if a != nil { oren_list_push(attrs, a) }
                parser_next_token(p)
            }
        }
        var doc = docs_join(doc_lines)
        p["_pending_doc"] = doc
        var stmt = parse_statement(p)
        if stmt != nil {
            if stmt["type"] == "StmtList" {
                if attrs != nil && oren_list_len(attrs) != 0 {
                    parser_add_error(p, "attributes may not precede enum sugar expansion")
                }
                if p["_pending_doc"] != nil {
                    parser_add_error(p, "doc comments may not precede enum/impl sugar expansion yet")
                    p["_pending_doc"] = nil
                }
                var si = 0
                while si < oren_list_len(stmt["stmts"]) {
                    oren_list_push(prog["statements"], stmt["stmts"][si])
                    si = si + 1
                }
            } else {
                attach_attrs_to_stmt(p, stmt, attrs)
                // Attach doc to declaration statements (fn/struct/class/import/ffi).
                var pending = parser_take_pending_doc(p)
                if pending != nil {
                    if stmt["type"] == "Type" || stmt["type"] == "Import" || stmt["type"] == "FFI" {
                        stmt["doc"] = pending
                    } else {
                        if stmt["type"] == "ExprStmt" {
                            var exp = stmt["expr"]
                            if exp != nil && exp["type"] == "Function" {
                                // Function consumes pending doc in parse_function.
                            } else {
                                parser_add_error(p, "doc comments may only precede declarations (fn/struct/class/import/ffi)")
                            }
                        } else {
                            parser_add_error(p, "doc comments may only precede declarations (fn/struct/class/import/ffi)")
                        }
                    }
                }
                oren_list_push(prog["statements"], stmt)
            }
        }
        // If no statement consumed the doc, clear it to avoid leakage.
        p["_pending_doc"] = nil
        parser_next_token(p)
    }
    // Carry trait declarations for tooling/metadata (no runtime meaning in v0).
    prog["traits"] = p["traits"]
    return prog
}

fn parse_attr_list(p) {
    var attrs = []
    while cur_is(p, token.TOK_AT) {
        var a = parse_attr(p)
        if a != nil { oren_list_push(attrs, a) }
        // Move to the next token after this attribute.
        parser_next_token(p)
    }
    return attrs
}

fn parse_attr(p) {
    // Current token is '@'
    var at_tok = p["cur"]
    if !core.expect_peek_attr_name(p, "attribute name") { return nil }
    var name = p["cur"]["literal"]
    // Support dotted namespaces: @myorg.tag(...)
    while peek_is(p, token.TOK_DOT) {
        parser_next_token(p) // '.'
        if !core.expect_peek_attr_name(p, "attribute name segment") { return nil }
        name = name + "." + p["cur"]["literal"]
    }

    // Normalize ergonomic aliases to canonical namespaces before strict validation
    // and before embedding into metadata.
    name = attr_normalize_name(name)

    attr_validate(p, name)

    var args = []
    // Optional ( ... )
    if peek_is(p, token.TOK_LPAREN) {
        parser_next_token(p) // '('
        parser_next_token(p) // first token inside args (or ')')

        if cur_is(p, token.TOK_RPAREN) {
            // no args
        } else {
            var cont = true
            while cont {
                var key = nil
                var val = nil

                // Keyword args in attrs: allow a small "attr-name token" set as keys.
                // This keeps ergonomic forms like `@json(default=0)` working even though
                // `default` is a keyword token in the lexer.
                if token.is_attr_name_token(p["cur"]["type"]) && peek_is(p, token.TOK_ASSIGN) {
                    key = p["cur"]["literal"]
                    parser_next_token(p) // '='
                    parser_next_token(p) // value
                }

                val = parse_attr_literal(p)
                if val == nil {
                    parser_add_error(p, "attribute args must be compile-time literals")
                    return nil
                }
                oren_list_push(args, {"key": key, "value": val})

                if peek_is(p, token.TOK_COMMA) {
                    parser_next_token(p) // ','
                    parser_next_token(p) // next
                } else {
                    cont = false
                }
            }

            if !peek_is(p, token.TOK_RPAREN) {
                parser_add_error(p, "expected ')' after attribute args")
                return nil
            }
            parser_next_token(p) // ')'
        }
    }

    return {"type": "Attr", "token": at_tok, "name": name, "args": args}
}

fn parse_attr_literal(p) {
    // Only allow literals in v0 attribute args to keep builds deterministic.
    var t = p["cur"]["type"]
    if t == token.TOK_STRING { return ast.new_string(p["cur"]) }
    if t == token.TOK_INT { return ast.new_integer(p["cur"]) }
    if t == token.TOK_FLOAT { return ast.new_float(p["cur"]) }
    if t == token.TOK_TRUE { return ast.new_boolean(p["cur"], true) }
    if t == token.TOK_FALSE { return ast.new_boolean(p["cur"], false) }
    if t == token.TOK_NIL { return ast.new_nil(p["cur"]) }
    return nil
}

fn attach_attrs_to_stmt(p, stmt, attrs) {
    if attrs == nil { return nil }
    if oren_list_len(attrs) == 0 { return nil }

    // Allowed targets (M1): declarations only.
    if stmt["type"] == "Type" || stmt["type"] == "Import" || stmt["type"] == "FFI" {
        stmt["attrs"] = attrs
        return nil
    }
    if stmt["type"] == "ExprStmt" {
        var exp = stmt["expr"]
        if exp != nil && exp["type"] == "Function" {
            exp["attrs"] = attrs
            return nil
        }
    }

    parser_add_error(p, "attributes may only precede declarations (fn/struct/class/import/ffi)")
    return nil
}

fn parse_statement(p) {
    if cur_is(p, token.TOK_LET) { return parse_var(p) }
    if cur_is(p, token.TOK_RETURN) { return parse_return(p) }
    if cur_is(p, token.TOK_WHILE) { return parse_while(p) }
    if cur_is(p, token.TOK_FOR) { return parse_for(p) }
    if cur_is(p, token.TOK_SWITCH) { return parse_switch(p) }
    if cur_is(p, token.TOK_BREAK) { return parse_break(p) }
    if cur_is(p, token.TOK_CONTINUE) { return parse_continue(p) }
    if cur_is(p, token.TOK_IMPORT) { return parse_import(p) }
    if cur_is(p, token.TOK_STRUCT) { return parse_type_decl(p) }
    if cur_is(p, token.TOK_CLASS) { return parse_type_decl(p) }
    if cur_is(p, token.TOK_ENUM) { return parse_enum_decl(p) }
    if cur_is(p, token.TOK_TRAIT) { return parse_trait_decl(p) }
    if cur_is(p, token.TOK_IMPL) { return parse_impl_decl(p) }
    if cur_is(p, token.TOK_FFI) { return parse_ffi(p) }
    if cur_is(p, token.TOK_TEST) { return parse_test(p) }
    if cur_is(p, token.TOK_SPAWN) { return parse_spawn(p) }
    if cur_is(p, token.TOK_LBRACE) { return parse_block(p) }
    if cur_is(p, token.TOK_IDENT) {
        // Contextual keyword: `match` is only treated as a statement when it is not
        // being used as an identifier (var name, call, member, indexing, etc.).
        if p["cur"]["literal"] == "match" {
            var pt = p["peek"]["type"]
            if pt != token.TOK_DECLARE && pt != token.TOK_ASSIGN && pt != token.TOK_COLON &&
               pt != token.TOK_DOT && pt != token.TOK_LPAREN && pt != token.TOK_LBRACKET &&
               pt != token.TOK_SEMICOLON && pt != token.TOK_RBRACE && pt != token.TOK_EOF {
                return parse_match(p)
            }
        }
        if peek_is(p, token.TOK_DECLARE) { return parse_short_var(p) }
        if peek_is(p, token.TOK_COLON) { return parse_typed_short_var(p) }
        return parse_assign_or_expr_stmt(p)
    }
    return parse_expr_stmt(p)
}

fn parse_dotted_name(p) {
    // Parse an identifier with optional dotted suffixes: A.B.C
    if !cur_is_ident_like(p) { return nil }
    var name = p["cur"]["literal"]
    while peek_is(p, token.TOK_DOT) {
        parser_next_token(p) // .
        if !expect_peek_ident_like(p, "dotted name segment") { return nil }
        name = name + "." + p["cur"]["literal"]
    }
    return name
}

fn skip_parens_signature(p) {
    // Best-effort skip of (...) in trait signatures.
    // Precondition: current token is '('.
    var depth = 0
    while true {
        if cur_is(p, token.TOK_LPAREN) { depth = depth + 1 }
        if cur_is(p, token.TOK_RPAREN) {
            depth = depth - 1
            if depth <= 0 { return nil }
        }
        if cur_is(p, token.TOK_EOF) { return nil }
        parser_next_token(p)
    }
}

fn parse_trait_decl(p) {
    // trait Foo { fn m(a, b); fn n(x): i32; }
    //
    // Rolling implementation:
    // - Trait declarations are compile-time contracts only (no runtime representation yet).
    // - We keep a metadata-only record under p["traits"] for tooling (docs/serde/OpenAPI/etc).
    // - No statements are emitted, so existing backends remain unchanged.
    var doc = parser_take_pending_doc(p)
    if !expect_peek_ident_like(p, "trait name") { return ast.new_stmt_list([]) }
    var trait_name = parse_dotted_name(p)
    if trait_name == nil { return ast.new_stmt_list([]) }
    if !expect_peek(p, token.TOK_LBRACE) { return ast.new_stmt_list([]) }

    var methods = []
    // Enter body.
    parser_next_token(p)
    while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
        if cur_is(p, token.TOK_SEMICOLON) { parser_next_token(p); continue }
        if cur_is(p, token.TOK_COMMA) { parser_next_token(p); continue }

        if cur_is(p, token.TOK_FUNCTION) {
            // Parse `fn name(...)` signature and record it.
            if !expect_peek_ident_like(p, "trait method name") { return ast.new_stmt_list([]) }
            var mname = p["cur"]["literal"]
            if !expect_peek(p, token.TOK_LPAREN) { return ast.new_stmt_list([]) }
            var params = parse_parameters(p) // leaves cur at ')'

            // Optional return type: `: T`
            var ret_ann = nil
            if peek_is(p, token.TOK_COLON) {
                parser_next_token(p) // ':'
                ret_ann = parse_type_name_after_colon(p)
                if ret_ann == nil { return ast.new_stmt_list([]) }
            }

            // Convert params (Identifier AST nodes) into stable metadata.
            var mparams = []
            var pi = 0
            while pi < oren_list_len(params) {
                var id = params[pi]
                var pname = nil
                var ann = nil
                var isv = false
                var pattrs = []
                if id != nil {
                    pname = id["value"]
                    ann = id["ann_type"]
                    if id["is_varargs"] == true { isv = true }
                    if id["attrs"] != nil { pattrs = id["attrs"] }
                }
                oren_list_push(mparams, {"value": pname, "attrs": pattrs, "ann_type": ann, "is_varargs": isv})
                pi = pi + 1
            }

            oren_list_push(methods, {"name": mname, "params": mparams, "ret_ann_type": ret_ann})

            // Consume optional separator and continue.
            if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
            if peek_is(p, token.TOK_COMMA) { parser_next_token(p) }
            parser_next_token(p)
            continue
        }

        // Unknown token inside trait body: skip (rolling mode).
        parser_next_token(p)
    }

    // p["cur"] is '}' (or EOF). Record trait metadata for tooling.
    p["trait_set"][trait_name] = true
    oren_list_push(p["traits"], {"name": trait_name, "doc": doc, "methods": methods})
    return ast.new_stmt_list([])
}

fn impl_mangled_name(trait_name, type_name, method) {
    // Deterministic lowering name for impl methods (rolling).
    //
    // Rationale:
    // - avoids introducing a runtime method table before the type system is stable
    // - keeps compilation bootstrap-friendly (plain fns)
    // - stable across backends (C/native/bytecode)
    //
    // Convention:
    //   __oren_impl__<Trait>__<Type>__<method>
    //
    // Dots are replaced by underscores for C identifier stability downstream.
    var tn = trait_name
    var ty = type_name
    // Replace '.' with '_'
    var i = 0
    var out_t = ""
    while i < oren_string_len(tn) {
        var c = oren_string_char_at(tn, i)
        if c == "." { out_t = out_t + "_" } else { out_t = out_t + c }
        i = i + 1
    }
    i = 0
    var out_ty = ""
    while i < oren_string_len(ty) {
        var c2 = oren_string_char_at(ty, i)
        if c2 == "." { out_ty = out_ty + "_" } else { out_ty = out_ty + c2 }
        i = i + 1
    }
    return "__oren_impl__" + out_t + "__" + out_ty + "__" + method
}

fn parse_impl_decl(p) {
    // impl Trait for Type { fn method(self, ...) { ... } ... }
    //
    // Rolling implementation:
    // - Parser accepts impl blocks.
    // - Each method is lowered to a plain top-level function with a deterministic name:
    //     __oren_impl__Trait__Type__method(...)
    //
    // This unblocks early stdlib layering and tooling without committing to a stable
    // method dispatch ABI yet.
    var doc = parser_take_pending_doc(p)
    if !expect_peek_ident_like(p, "impl trait name") { return ast.new_stmt_list([]) }
    // cur is IDENT after expect_peek
    var trait_name = parse_dotted_name(p)
    if trait_name == nil { return ast.new_stmt_list([]) }

    if !expect_peek(p, token.TOK_FOR) { return ast.new_stmt_list([]) }
    if !expect_peek_ident_like(p, "impl type name") { return ast.new_stmt_list([]) }
    // cur is IDENT after expect_peek
    var type_name = parse_dotted_name(p)
    if type_name == nil { return ast.new_stmt_list([]) }

    if !expect_peek(p, token.TOK_LBRACE) { return ast.new_stmt_list([]) }

    var out = []
    var impl_block_id = parser_gensym(p, "@impl_" + trait_name + "_" + type_name + "_")
    parser_next_token(p)
    while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
        if cur_is(p, token.TOK_DOC) {
            var md = parse_doc_list(p)
            if md != nil { p["_pending_doc"] = md }
            continue
        }
        if cur_is(p, token.TOK_SEMICOLON) { parser_next_token(p); continue }
        if cur_is(p, token.TOK_COMMA) { parser_next_token(p); continue }
        if cur_is(p, token.TOK_FUNCTION) {
            var st = parse_expr_stmt(p)
            if st == nil { return ast.new_stmt_list(out) }
            // st is ExprStmt(Function)
            var fnn = st["expr"]
            if fnn != nil && fnn["type"] == "Function" {
                if doc != nil && fnn["doc"] == nil { fnn["doc"] = doc }
                var mname = fnn["name"]
                var newn = impl_mangled_name(trait_name, type_name, mname)
                // Preserve impl identity for later whole-program passes:
                // - enables cross-module method call lowering after module linking
                // - enables coherence checks without parsing mangled identifiers
                fnn["impl_trait"] = trait_name
                fnn["impl_type"] = type_name
                fnn["impl_method"] = mname
                fnn["impl_mangled_base"] = newn
                fnn["impl_block_id"] = impl_block_id
                fnn["name"] = newn
                impl_method_register(p, type_name, mname, newn)
                impl_trait_method_register(p, trait_name, type_name, mname, newn)
            }
            oren_list_push(out, st)
            parser_next_token(p)
            continue
        }
        parser_add_error(p, "impl body expects 'fn' declarations")
        return ast.new_stmt_list(out)
    }
    // p["cur"] is '}'.
    return ast.new_stmt_list(out)
}

fn parse_match(p) {
    // match <expr> {
    //   case Enum.Variant(x,y) { ... }
    //   case Enum.Other { ... }
    //   default { ... }
    // }
    //
    // Rolling implementation:
    // - Works with the current `enum` sugar encoding:
    //     { "tag": "Enum.Variant", "_0": x, "_1": y, ... }
    // - Desugars into:
    //     { var tmp = <expr>; var tag = tmp.tag; if tag == "Enum.Variant" { var x = tmp._0; ... } else ... }
    var tok = p["cur"]
    parser_next_token(p)
    var m_expr = parse_expression(p, LOWEST)
    if m_expr == nil { return nil }
    if !expect_peek(p, token.TOK_LBRACE) { return nil }

    var tmp_name = parser_gensym(p, "@match_")
    var tmp_ident = {"type": "Identifier", "token": token.new_token(token.TOK_IDENT, tmp_name), "value": tmp_name}
    var init_tmp = ast.new_var(token.new_token(token.TOK_LET, "var"), tmp_ident, m_expr)

    var tag_name = parser_gensym(p, "@match_tag_")
    var tag_ident = {"type": "Identifier", "token": token.new_token(token.TOK_IDENT, tag_name), "value": tag_name}
    var mem_tag = ast.new_member(token.new_token(token.TOK_DOT, "."), tmp_ident, ast.new_identifier(token.new_token(token.TOK_IDENT, "tag")))
    var init_tag = ast.new_var(token.new_token(token.TOK_LET, "var"), tag_ident, mem_tag)

    var cases = []
    var default_block = nil

    // Enter match body.
    parser_next_token(p)
    while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
        if cur_is(p, token.TOK_CASE) {
            // case Pattern { ... }
            parser_next_token(p) // first token of pattern

            // Parse Enum.Variant (dotted identifiers) and optional payload binding list.
            if p["cur"]["type"] != token.TOK_IDENT {
                parser_add_error(p, "match case expects a pattern starting with an identifier")
                return nil
            }
            var pat = p["cur"]["literal"]
            while peek_is(p, token.TOK_DOT) {
                parser_next_token(p) // '.'
                if !expect_peek(p, token.TOK_IDENT) { return nil }
                pat = pat + "." + p["cur"]["literal"]
            }

            var binds = []
            if peek_is(p, token.TOK_LPAREN) {
                parser_next_token(p) // '('
                if peek_is(p, token.TOK_RPAREN) {
                    parser_next_token(p) // ')'
                } else {
                    parser_next_token(p) // first bind name
                    if p["cur"]["type"] != token.TOK_IDENT {
                        parser_add_error(p, "match payload binding expects identifiers")
                        return nil
                    }
                    oren_list_push(binds, p["cur"]["literal"])
                    while peek_is(p, token.TOK_COMMA) {
                        parser_next_token(p) // ','
                        parser_next_token(p)
                        if p["cur"]["type"] != token.TOK_IDENT {
                            parser_add_error(p, "match payload binding expects identifiers")
                            return nil
                        }
                        oren_list_push(binds, p["cur"]["literal"])
                    }
                    if !expect_peek(p, token.TOK_RPAREN) { return nil }
                }
            }

            if peek_is(p, token.TOK_COLON) { parser_next_token(p) }
            if !expect_peek(p, token.TOK_LBRACE) { return nil }
            var body = parse_block(p)

            // Prepend bindings as var declarations.
            if binds != nil && oren_list_len(binds) > 0 {
                var nb = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
                var bi = 0
                while bi < oren_list_len(binds) {
                    var bn = binds[bi]
                    var bident = ast.new_identifier(token.new_token(token.TOK_IDENT, bn))
                    var mem = ast.new_member(token.new_token(token.TOK_DOT, "."), tmp_ident, ast.new_identifier(token.new_token(token.TOK_IDENT, "_" + oren_int_to_string(bi))))
                    oren_list_push(nb["stmts"], ast.new_var(token.new_token(token.TOK_LET, "var"), bident, mem))
                    bi = bi + 1
                }
                // Append original body statements.
                bi = 0
                while bi < oren_list_len(body["stmts"]) {
                    oren_list_push(nb["stmts"], body["stmts"][bi])
                    bi = bi + 1
                }
                body = nb
            }

            oren_list_push(cases, {"tag": pat, "body": body})

            parser_next_token(p)
            continue
        }

        if cur_is(p, token.TOK_DEFAULT) {
            if default_block != nil {
                parser_add_error(p, "duplicate default in match")
                return nil
            }
            if peek_is(p, token.TOK_COLON) { parser_next_token(p) }
            if !expect_peek(p, token.TOK_LBRACE) { return nil }
            default_block = parse_block(p)
            parser_next_token(p)
            continue
        }

        parser_add_error(p, "expected 'case' or 'default' in match")
        return nil
    }

    // Build nested if/else chain on tag_ident == "<Enum.Variant>".
    var if_expr = nil
    var i = oren_list_len(cases) - 1
    while i >= 0 {
        var c = cases[i]
        var cond = ast.new_infix(token.new_token(token.TOK_EQ, "=="), tag_ident, "==", ast.new_string(token.new_token(token.TOK_STRING, c["tag"])))
        var consq = c["body"]

        var alt = default_block
        if if_expr != nil {
            alt = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
            oren_list_push(alt["stmts"], ast.new_expr_stmt(token.new_token(token.TOK_IF, "if"), if_expr))
        }
        if_expr = ast.new_if(token.new_token(token.TOK_IF, "if"), cond, consq, alt)
        i = i - 1
    }

    var out = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
    oren_list_push(out["stmts"], init_tmp)
    oren_list_push(out["stmts"], init_tag)
    if if_expr != nil {
        oren_list_push(out["stmts"], ast.new_expr_stmt(tok, if_expr))
    } else {
        if default_block != nil {
            var oi = 0
            while oi < oren_list_len(default_block["stmts"]) {
                oren_list_push(out["stmts"], default_block["stmts"][oi])
                oi = oi + 1
            }
        }
    }
    return out
}

fn parse_enum_decl(p) {
    // enum Name { Variant, Variant2(x,y), ... }
    //
    // Rolling implementation:
    // - Syntax sugar expanding to constructor functions that return tagged maps.
    //
    // Example:
    //   enum Option { None, Some(x) }
    // becomes:
    //   fn Option_None() { return { tag: "Option.None" } }
    //   fn Option_Some(x) { return { tag: "Option.Some", _0: x } }
    //
    // Notes:
    // - Enum values are plain maps (deterministic order is handled by map implementation).
    // - `match` / exhaustiveness checking is a later milestone.
    var doc = parser_take_pending_doc(p)
    var tok = p["cur"]
    if !expect_peek(p, token.TOK_IDENT) { return nil }
    var enum_name = p["cur"]["literal"]
    if !expect_peek(p, token.TOK_LBRACE) { return nil }

    var out = []

    // Record enum shape for later syntax sugar like `Option.Some(1)` and `Option.None`.
    p["enums"][enum_name] = true
    if p["enum_variants"][enum_name] == nil { p["enum_variants"][enum_name] = {} }

    // Enter body.
    parser_next_token(p)
    while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
        if cur_is(p, token.TOK_COMMA) {
            parser_next_token(p)
            continue
        }
        if p["cur"]["type"] != token.TOK_IDENT {
            parser_add_error(p, "enum expects variant name, got " + p["cur"]["type"])
            return ast.new_stmt_list(out)
        }
        var vname = p["cur"]["literal"]

        // Optional payload names: (a,b,c)
        var payload_names = []
        if peek_is(p, token.TOK_LPAREN) {
            parser_next_token(p) // '('
            if peek_is(p, token.TOK_RPAREN) {
                parser_next_token(p) // ')'
            } else {
                parser_next_token(p) // first payload name
                if p["cur"]["type"] != token.TOK_IDENT {
                    parser_add_error(p, "enum payload expects identifier field names")
                    return ast.new_stmt_list(out)
                }
                oren_list_push(payload_names, p["cur"]["literal"])
                while peek_is(p, token.TOK_COMMA) {
                    parser_next_token(p) // ','
                    parser_next_token(p) // name
                    if p["cur"]["type"] != token.TOK_IDENT {
                        parser_add_error(p, "enum payload expects identifier field names")
                        return ast.new_stmt_list(out)
                    }
                    oren_list_push(payload_names, p["cur"]["literal"])
                }
                if !expect_peek(p, token.TOK_RPAREN) { return ast.new_stmt_list(out) }
            }
        }

        // Record variant arity for dot-variant sugar.
        p["enum_variants"][enum_name][vname] = oren_list_len(payload_names)

        // Build constructor fn: Enum_Variant(...)
        var fn_tok = token.new_token(token.TOK_FUNCTION, "fn")
        var fn_name = enum_name + "_" + vname
        var params = []
        var pi = 0
        while pi < oren_list_len(payload_names) {
            var pn = payload_names[pi]
            oren_list_push(params, ast.new_identifier(token.new_token(token.TOK_IDENT, pn)))
            pi = pi + 1
        }

        // return { tag: "Enum.Variant", _0: a, _1: b, ... }
        var b = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
        var pairs = []
        oren_list_push(pairs, {
            "key": ast.new_string(token.new_token(token.TOK_STRING, "tag")),
            "value": ast.new_string(token.new_token(token.TOK_STRING, enum_name + "." + vname))
        })

        pi = 0
        while pi < oren_list_len(payload_names) {
            var k = ast.new_string(token.new_token(token.TOK_STRING, "_" + oren_int_to_string(pi)))
            var v = ast.new_identifier(token.new_token(token.TOK_IDENT, payload_names[pi]))
            oren_list_push(pairs, {"key": k, "value": v})
            pi = pi + 1
        }

        var h = ast.new_hash(token.new_token(token.TOK_LBRACE, "{"), pairs)
        oren_list_push(b["stmts"], ast.new_return(token.new_token(token.TOK_RETURN, "return"), h))
        // Keep function declarations in the normal surface form used by the rest
        // of the compiler pipeline: `ExprStmt(Function)`.
        var fnn = ast.new_function(fn_tok, fn_name, params, b)
        if doc != nil { fnn["doc"] = doc }
        oren_list_push(out, ast.new_expr_stmt(fn_tok, fnn))

        // Next token after variant (',' or '}')
        parser_next_token(p)
    }

    // We leave p["cur"] as '}' (handled by parse_program/parse_block stepping).
    return ast.new_stmt_list(out)
}

fn parse_spawn(p) {
    var tok = p["cur"]
    // spawn <call-expr>;
    parser_next_token(p)
    var exp = parse_expression(p, LOWEST)
    if exp == nil { return nil }
    if exp["type"] != "Call" {
        parser_add_error(p, "spawn expects a call expression")
        return nil
    }
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_spawn(tok, exp)
}

fn switch_case_condition(switch_ident, values) {
    if values == nil || oren_list_len(values) == 0 { return nil }
    var tok_eq = token.new_token(token.TOK_EQ, "==")
    var tok_or = token.new_token(token.TOK_OR, "||")
    var cond = ast.new_infix(tok_eq, switch_ident, "==", values[0])
    var i = 1
    while i < oren_list_len(values) {
        var c2 = ast.new_infix(tok_eq, switch_ident, "==", values[i])
        cond = ast.new_infix(tok_or, cond, "||", c2)
        i = i + 1
    }
    return cond
}

fn parse_switch(p) {
    var tok = p["cur"]

    // switch <expr> { case ... { ... } default { ... } }
    parser_next_token(p)
    var sw_expr = parse_expression(p, LOWEST)
    if sw_expr == nil { return nil }
    if !expect_peek(p, token.TOK_LBRACE) { return nil }

    // Evaluate switch expression once.
    var st_name = parser_gensym(p, "@switch_")
    var st_ident = {"type": "Identifier", "token": token.new_token(token.TOK_IDENT, st_name), "value": st_name}
    var init_stmt = ast.new_var(token.new_token(token.TOK_LET, "var"), st_ident, sw_expr)

    var cases = []
    var default_block = nil

    // Enter switch body.
    parser_next_token(p) // first token inside '{' or '}'
    while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
        if cur_is(p, token.TOK_CASE) {
            // case <expr> { ... }
            var values = []
            parser_next_token(p) // first token of case expression
            var v0 = parse_expression(p, LOWEST)
            if v0 == nil { return nil }
            oren_list_push(values, v0)

            while peek_is(p, token.TOK_COMMA) {
                parser_next_token(p) // ','
                parser_next_token(p) // next value
                var vn = parse_expression(p, LOWEST)
                if vn == nil { return nil }
                oren_list_push(values, vn)
            }

            // Optional ':' before block
            if peek_is(p, token.TOK_COLON) {
                parser_next_token(p) // ':'
            }
            if !expect_peek(p, token.TOK_LBRACE) { return nil }
            var body = parse_block(p)
            oren_list_push(cases, {"values": values, "body": body})

            // Advance after the '}' of the block.
            parser_next_token(p)
            continue
        }

        if cur_is(p, token.TOK_DEFAULT) {
            // default { ... }
            if default_block != nil {
                parser_add_error(p, "duplicate default in switch")
                return nil
            }
            if peek_is(p, token.TOK_COLON) {
                parser_next_token(p) // ':'
            }
            if !expect_peek(p, token.TOK_LBRACE) { return nil }
            default_block = parse_block(p)
            parser_next_token(p)
            continue
        }

        parser_add_error(p, "expected 'case' or 'default' in switch")
        return nil
    }

    // Build nested if/else chain.
    var if_expr = nil
    var i = oren_list_len(cases) - 1
    while i >= 0 {
        var c = cases[i]
        var cond = switch_case_condition(st_ident, c["values"])
        var consq = c["body"]

        var alt = default_block
        if if_expr != nil {
            alt = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
            oren_list_push(alt["stmts"], ast.new_expr_stmt(token.new_token(token.TOK_IF, "if"), if_expr))
        }

        if_expr = ast.new_if(token.new_token(token.TOK_IF, "if"), cond, consq, alt)
        i = i - 1
    }

    // If no cases, just evaluate expression and do nothing.
    var out = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
    oren_list_push(out["stmts"], init_stmt)
    if if_expr != nil {
        oren_list_push(out["stmts"], ast.new_expr_stmt(tok, if_expr))
    } else {
        if default_block != nil {
            // switch expr { default { ... } }
            var out_i = 0
            while out_i < oren_list_len(default_block["stmts"]) {
                oren_list_push(out["stmts"], default_block["stmts"][out_i])
                out_i = out_i + 1
            }
        }
    }
    return out
}

fn parse_test(p) {
    var tok = p["cur"]
    // test "name" { ... }
    // Convert to function: fn test_name() { ... }

    // Allow doc comments to precede `test` blocks; attach them to the lowered function.
    var doc = parser_take_pending_doc(p)
    
    if !expect_peek(p, token.TOK_STRING) { return nil }
    var test_name = p["cur"]["literal"]
    var func_name = "test_" + test_name
    
    // Check if block follows
    if !expect_peek(p, token.TOK_LBRACE) { return nil }
    var body = parse_block(p)
    
    // Create function AST
    // params = []
    var fn_node = ast.new_function(tok, func_name, [], body)
    if doc != nil { fn_node["doc"] = doc }
    return ast.new_expr_stmt(tok, fn_node)
}

fn parse_var(p) {
    var tok = p["cur"]
    if !expect_peek(p, token.TOK_IDENT) { return nil }
    var name = ast.new_identifier(p["cur"])

    // Optional type annotation sugar:
    //   var x: u64 = ...
    // Stored on the identifier node as `ann_type` (non-semantic; used by lowerings/tooling).
    if peek_is(p, token.TOK_COLON) {
        parser_next_token(p) // :
        var tname = parse_type_name_after_colon(p)
        if tname == nil { return nil }
        name["ann_type"] = tname
        type_env_set(p, name["value"], tname)
    }

    if !expect_peek(p, token.TOK_ASSIGN) { return nil }
    parser_next_token(p)
    var val = parse_expression(p, LOWEST)
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_var(tok, name, val)
}

fn parse_short_var(p) {
    var name = ast.new_identifier(p["cur"])
    var tok = token.new_token(token.TOK_LET, "var")
    parser_next_token(p) // :=
    parser_next_token(p) // value
    var val = parse_expression(p, LOWEST)
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_var(tok, name, val)
}

fn parse_typed_short_var(p) {
    // typed short var sugar:
    //   x: u64 := expr
    //
    // This is only valid as a declaration (not assignment).
    var name = ast.new_identifier(p["cur"])
    var tok = token.new_token(token.TOK_LET, "var")

    parser_next_token(p) // :
    var tname = parse_type_name_after_colon(p)
    if tname == nil { return nil }
    name["ann_type"] = tname
    type_env_set(p, name["value"], tname)

    if !expect_peek(p, token.TOK_DECLARE) {
        parser_add_error(p, "typed declaration requires ':=' after type annotation")
        return nil
    }

    parser_next_token(p) // :=
    parser_next_token(p) // value
    var val = parse_expression(p, LOWEST)
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_var(tok, name, val)
}

fn parse_assign(p) {
    var name = ast.new_identifier(p["cur"])
    var tok = p["peek"]
    parser_next_token(p) // =
    parser_next_token(p) // value
    var val = parse_expression(p, LOWEST)
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_assign(tok, name, val)
}

fn parse_assign_or_expr_stmt(p) {
    var start_tok = p["cur"]
    var left_exp = parse_expression(p, LOWEST)

    if peek_is(p, token.TOK_ASSIGN) {
        var tok = p["peek"]
        parser_next_token(p) // =
        parser_next_token(p) // value
        var val = parse_expression(p, LOWEST)
        if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
        if left_exp["type"] == "Identifier" { return ast.new_assign(tok, left_exp, val) }
        return ast.new_set(tok, left_exp, val)
    }

    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_expr_stmt(start_tok, left_exp)
}

fn parse_return(p) {
    var tok = p["cur"]
    parser_next_token(p)
    var val = parse_expression(p, LOWEST)
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_return(tok, val)
}

fn parse_expr_stmt(p) {
    var tok = p["cur"]
    var expr = parse_expression(p, LOWEST)
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_expr_stmt(tok, expr)
}

fn parse_expression(p, prec) {
    var left = parse_prefix(p)
    var cont = true
    while cont {
        if peek_is(p, token.TOK_SEMICOLON) {
            cont = false
        } else {
            if prec < precedence(p["peek"]["type"]) {
                parser_next_token(p)
                left = parse_infix(p, left)
            } else {
                cont = false
            }
        }
    }
    return left
}

fn parse_prefix(p) {
    var t = p["cur"]["type"]
    if token.is_ident_like_token(t) { return ast.new_identifier(p["cur"]) }
    if t == token.TOK_INT { return ast.new_integer(p["cur"]) }
    if t == token.TOK_FLOAT { return ast.new_float(p["cur"]) }
    if t == token.TOK_STRING { return ast.new_string(p["cur"]) }
    if t == token.TOK_TRUE { return ast.new_boolean(p["cur"], true) }
    if t == token.TOK_FALSE { return ast.new_boolean(p["cur"], false) }
    if t == token.TOK_NIL { return ast.new_nil(p["cur"]) }
    if t == token.TOK_BANG {
        var tok = p["cur"]
        parser_next_token(p)
        var right = parse_expression(p, PREFIX_P)
        return ast.new_prefix(tok, tok["literal"], right)
    }
    if t == token.TOK_MINUS {
        var tok = p["cur"]
        parser_next_token(p)
        var right = parse_expression(p, PREFIX_P)
        return ast.new_prefix(tok, tok["literal"], right)
    }
    if t == token.TOK_TILDE {
        var tok = p["cur"]
        parser_next_token(p)
        var right = parse_expression(p, PREFIX_P)
        return ast.new_prefix(tok, tok["literal"], right)
    }
    if t == token.TOK_LPAREN {
        parser_next_token(p)
        var exp = parse_expression(p, LOWEST)
        if !expect_peek(p, token.TOK_RPAREN) { return nil }
        return exp
    }
    if t == token.TOK_IF { return parse_if(p) }
    if t == token.TOK_FUNCTION { return parse_function(p) }
    if t == token.TOK_BITOR { return parse_lambda(p) }
    if t == token.TOK_OR { return parse_lambda(p) } // allow empty-params lambda: || expr
    if t == token.TOK_SPAWN { return parse_spawn_expr(p) }
    if t == token.TOK_LBRACKET { return parse_array(p) }
    if t == token.TOK_LBRACE { return parse_hash(p) }
    parser_add_error(p, "no prefix parse fn for " + t)
    return nil
}

fn parse_lambda(p) {
    // lambda literal:
    //   |params| expr
    //   |params| { block }
    //
    // Lowered to an anonymous Function node (name="").
    var tok = p["cur"] // '|'
    var params = []

    // Parse params between | ... |.
    // Special-case: lexer tokenizes `||` as TOK_OR, so `|| body` means empty params.
    if tok["type"] == token.TOK_OR {
        // empty params
    } else {
        if peek_is(p, token.TOK_BITOR) {
            parser_next_token(p) // consume closing '|'
        } else {
            parser_next_token(p) // first param
            if !cur_is(p, token.TOK_IDENT) {
                parser_add_error(p, "lambda expects identifier parameters")
                return nil
            }
            oren_list_push(params, ast.new_identifier(p["cur"]))
            while peek_is(p, token.TOK_COMMA) {
                parser_next_token(p) // comma
                parser_next_token(p) // ident
                if !cur_is(p, token.TOK_IDENT) {
                    parser_add_error(p, "lambda expects identifier parameters")
                    return nil
                }
                oren_list_push(params, ast.new_identifier(p["cur"]))
            }
            if !expect_peek(p, token.TOK_BITOR) { return nil }
        }
    }

    // Body: block or expression
    parser_next_token(p)
    var body = nil
    if cur_is(p, token.TOK_LBRACE) {
        body = parse_block(p)
    } else {
        var exp = parse_expression(p, LOWEST)
        if exp == nil { return nil }
        var b = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
        var rtok = token.new_token(token.TOK_RETURN, "return")
        oren_list_push(b["stmts"], ast.new_return(rtok, exp))
        body = b
    }

    return ast.new_function(tok, "", params, body)
}

fn parse_spawn_expr(p) {
    var tok = p["cur"]
    // spawn <call-expr>
    parser_next_token(p)
    var exp = parse_expression(p, LOWEST)
    if exp == nil { return nil }
    if exp["type"] != "Call" {
        parser_add_error(p, "spawn expects a call expression")
        return nil
    }
    return ast.new_spawn_expr(tok, exp)
}

fn parse_infix(p, left) {
    var t = p["cur"]["type"]
    if t == token.TOK_AS { return parse_as_cast(p, left) }
    var is_op = false
    if t == token.TOK_PLUS { is_op = true }
    if t == token.TOK_MINUS { is_op = true }
    if t == token.TOK_SLASH { is_op = true }
    if t == token.TOK_ASTERISK { is_op = true }
    if t == token.TOK_PERCENT { is_op = true }
    if t == token.TOK_EQ { is_op = true }
    if t == token.TOK_NOT_EQ { is_op = true }
    if t == token.TOK_AND { is_op = true }
    if t == token.TOK_OR { is_op = true }
    if t == token.TOK_LT { is_op = true }
    if t == token.TOK_GT { is_op = true }
    if t == token.TOK_LTE { is_op = true }
    if t == token.TOK_GTE { is_op = true }
    if t == token.TOK_SHL { is_op = true }
    if t == token.TOK_SHR { is_op = true }
    if t == token.TOK_BITAND { is_op = true }
    if t == token.TOK_BITOR { is_op = true }
    if t == token.TOK_BITXOR { is_op = true }
    if is_op {
        var tok = p["cur"]
        var op = tok["literal"]
        var prec = precedence(t)
        parser_next_token(p)
        var right = parse_expression(p, prec)
        return ast.new_infix(tok, left, op, right)
    }
    if t == token.TOK_LPAREN { return parse_call(p, left) }
    if t == token.TOK_DOT { return parse_member(p, left) }
    if t == token.TOK_LBRACKET { return parse_index(p, left) }
    return left
}

fn parse_as_cast(p, left) {
    // Cast operator:
    //   <expr> as <type>
    //
    // v0 restriction: <type> must be a builtin width token (u8/i32/f32/u16be/...).
    // Lowering strategy: desugar into call-form cast sugar:
    //   x as u8  ->  u8(x)
    //
    // Then `type_ann_lowering.oren` rewrites `u8(x)` into deterministic casts.
    var tok = p["cur"] // 'as'
    parser_next_token(p) // type token

    if !token.is_builtin_type_token(p["cur"]["type"]) {
        parser_add_error(p, "expected builtin type after 'as' (e.g. u8/i32/f32/bool/u16be)")
        return left
    }

    var fn_expr = ast.new_identifier(p["cur"])
    return ast.new_call(tok, fn_expr, [left])
}

fn parse_if(p) {
    var tok = p["cur"]
    parser_next_token(p)
    var cond = parse_expression(p, LOWEST)
    if !expect_peek(p, token.TOK_LBRACE) { return nil }
    var consq = parse_block(p)
    var alt = nil
    if peek_is(p, token.TOK_ELSE) {
        parser_next_token(p)
        if expect_peek(p, token.TOK_LBRACE) {
            alt = parse_block(p)
        }
    }
    return ast.new_if(tok, cond, consq, alt)
}

fn parse_block(p) {
    type_env_push(p)
    var block = ast.new_block(p["cur"])
    parser_next_token(p)
    var cont = true
    while cont {
        if cur_is(p, token.TOK_RBRACE) { cont = false }
        if cur_is(p, token.TOK_EOF) { cont = false }
        if cont {
            // Allow doc comments inside blocks (useful for local declarations in the future).
            // For now, docs are attached only to declarations (primarily `fn`).
            var doc = parse_doc_list(p)
            p["_pending_doc"] = doc
            var stmt = parse_statement(p)
            if stmt != nil {
                if stmt["type"] == "StmtList" {
                    var si = 0
                    while si < oren_list_len(stmt["stmts"]) {
                        oren_list_push(block["stmts"], stmt["stmts"][si])
                        si = si + 1
                    }
                } else {
                    oren_list_push(block["stmts"], stmt)
                }
            }
            if p["_pending_doc"] != nil {
                // Prevent leakage to later statements.
                parser_add_error(p, "doc comments may only precede declarations (fn/struct/class/import/ffi/trait/impl/enum)")
                p["_pending_doc"] = nil
            }
            parser_next_token(p)
        }
    }
    type_env_pop(p)
    return block
}

fn parse_function(p) {
    var tok = p["cur"]
    // Doc comments attach to the next declaration. Consume them at the start of
    // parsing the declaration so nested parsing (function body) can't clobber
    // the pending doc value.
    var doc = parser_take_pending_doc(p)
    var name = ""
    if peek_is_ident_like(p) {
        parser_next_token(p)
        name = p["cur"]["literal"]
    }
    if !expect_peek(p, token.TOK_LPAREN) { return nil }
    var params = parse_parameters(p)

    // Optional return type annotation (rolling, metadata-only for now):
    //   fn f(x: T): U { ... }
    // Stored on the Function node as `ret_ann_type`.
    var ret_ann = nil
    if peek_is(p, token.TOK_COLON) {
        parser_next_token(p) // ':'
        ret_ann = parse_type_name_after_colon(p)
        if ret_ann == nil { return nil }
    }

    if !expect_peek(p, token.TOK_LBRACE) { return nil }
    // Seed the function body scope with any parameter type annotations so method
    // sugar (`x.method(...)`) can resolve inside the body.
    var pend = []
    var pi = 0
    while pi < oren_list_len(params) {
        var id = params[pi]
        if id != nil && id["ann_type"] != nil {
            oren_list_push(pend, {"k": id["value"], "v": id["ann_type"]})
        }
        pi = pi + 1
    }
    if oren_list_len(pend) > 0 {
        p["_pending_scope_types"] = pend
    }
    var body = parse_block(p)
    var fnn = ast.new_function(tok, name, params, body)
    if ret_ann != nil { fnn["ret_ann_type"] = ret_ann }
    if doc != nil { fnn["doc"] = doc }
    return fnn
}

fn parse_param_name_and_ann(p, attrs) {
    // Parse one parameter name with optional varargs marker and optional type annotation.
    //
    // param := {attr} ["..."] ident [ ":" type ]
    //
    // Returns an Identifier node with optional fields:
    // - attrs
    // - ann_type
    // - is_varargs (bool)
    var is_varargs = false
    if p["cur"]["type"] == token.TOK_ELLIPSIS {
        is_varargs = true
        // Advance to the actual name.
        parser_next_token(p)
    }
    if p["cur"]["type"] != token.TOK_IDENT {
        parser_add_error(p, "expected parameter name, got " + p["cur"]["type"])
        return nil
    }
    var id = ast.new_identifier(p["cur"])
    if is_varargs { id["is_varargs"] = true }

    if peek_is(p, token.TOK_COLON) {
        parser_next_token(p) // :
        var tname = parse_type_name_after_colon(p)
        if tname == nil { return nil }
        id["ann_type"] = tname
    }
    if attrs != nil && oren_list_len(attrs) > 0 { id["attrs"] = attrs }
    return id
}

fn parse_parameters(p) {
    var params = []
    if peek_is(p, token.TOK_RPAREN) {
        parser_next_token(p)
        return params
    }
    parser_next_token(p) // first token in params (could be '@' or ident)

    // param := {attr} ["..."] ident [ ":" type ]
    var attrs0 = parse_attr_list(p)
    var id0 = parse_param_name_and_ann(p, attrs0)
    if id0 == nil { return params }
    oren_list_push(params, id0)

    while peek_is(p, token.TOK_COMMA) {
        parser_next_token(p)
        parser_next_token(p) // next token after comma (could be '@' or ident)

        var attrsN = parse_attr_list(p)
        var idN = parse_param_name_and_ann(p, attrsN)
        if idN == nil { return params }
        oren_list_push(params, idN)
    }
    if !expect_peek(p, token.TOK_RPAREN) { return params }

    // Enforce varargs placement: at most one, and it must be last.
    var saw_varargs = false
    var i = 0
    while i < oren_list_len(params) {
        var id = params[i]
        var isv = (id != nil && id["is_varargs"] == true)
        if isv {
            if saw_varargs {
                parser_add_error(p, "only one varargs parameter is allowed")
                break
            }
            saw_varargs = true
            if i != oren_list_len(params) - 1 {
                parser_add_error(p, "varargs parameter must be last")
                break
            }
        }
        i = i + 1
    }

    return params
}

fn parse_call(p, fn_expr) {
    var tok = p["cur"]
    var args = parse_call_args(p)
    var spread = p["_call_spread"]
    p["_call_spread"] = nil
    // Method-call sugar resolver (static-first, rolling):
    //
    //   x.method(a, b)      -> __oren_impl__...__method(x, a, b)
    //   Type.method(a, b)   -> __oren_impl__...__method(a, b)
    //
    // Conditions:
    // - Only triggers if we can resolve an impl method name deterministically.
    // - `x.method(...)` uses the rolling type environment (from `x: Type` annotations).
    // - Ambiguity (multiple impls for the same type+method) is a compile-time error.
    if fn_expr != nil && fn_expr["type"] == "Member" {
        var m = fn_expr
        var method = nil
        if m["prop"] != nil && m["prop"]["type"] == "Identifier" { method = m["prop"]["value"] }
        if method != nil {
            // Try receiver-style: x.method(...)
            if m["left"] != nil && m["left"]["type"] == "Identifier" {
                var recv = m["left"]
                var tname = type_env_get(p, recv["value"])
                if tname != nil {
                    var mangled = impl_method_lookup(p, tname, method)
                    if mangled == "__AMBIG__" {
                        parser_add_error(p, "ambiguous method '" + method + "' for type '" + tname + "' (multiple impls)")
                    } else {
                        if mangled != nil {
                            // Rewrite: insert receiver as arg0.
                            var new_args = [recv]
                            var ai = 0
                            while ai < oren_list_len(args) {
                                oren_list_push(new_args, args[ai])
                                ai = ai + 1
                            }
                            args = new_args
                            fn_expr = ast.new_identifier(token.new_token(token.TOK_IDENT, mangled))
                        }
                    }
                }
            }

            // Try type-style: Type.method(...)
            if fn_expr["type"] == "Member" {
                var tdot = expr_dotted_name(fn_expr["left"])
                if tdot != nil {
                    // IMPORTANT: do not consult blanket (`any`) fallbacks here.
                    // `Module.fn(...)` and `Trait.method(...)` share the same surface syntax and we must
                    // avoid rewriting unrelated calls due to a blanket impl on `any`.
                    var by_type = p["impl_methods"][tdot]
                    var mangled2 = nil
                    if by_type != nil { mangled2 = by_type[method] }
                    if mangled2 == "__AMBIG__" {
                        parser_add_error(p, "ambiguous method '" + method + "' for type '" + tdot + "' (multiple impls)")
                    } else {
                        if mangled2 != nil {
                            fn_expr = ast.new_identifier(token.new_token(token.TOK_IDENT, mangled2))
                        }
                    }
                }
            }

            // Try trait-qualified: Trait.method(x, ...)
            //
            // This is the disambiguation path when multiple traits define the same
            // method name for a type, and unqualified `x.method(...)` is ambiguous.
            if fn_expr["type"] == "Member" {
                var tname_left = expr_dotted_name(fn_expr["left"])
                if tname_left != nil && p["trait_set"][tname_left] == true {
                    if args != nil && oren_list_len(args) > 0 {
                        var recv0 = args[0]
                        if recv0 != nil && recv0["type"] == "Identifier" {
                            var recv_type = type_env_get(p, recv0["value"])
                            if recv_type != nil {
                                var qm = impl_trait_method_lookup(p, tname_left, recv_type, method)
                                // v0 parsing is module-local; other modules can provide impls.
                                // Only rewrite when a unique target is known.
                                // Whole-program coherence and missing-impl errors are enforced in the linker lowering pass.
                                if qm != nil && qm != "__AMBIG__" {
                                    fn_expr = ast.new_identifier(token.new_token(token.TOK_IDENT, qm))
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    var c = ast.new_call(tok, fn_expr, args)
    if spread != nil {
        c["spread"] = spread
    }
    return c
}

fn parse_call_args(p) {
    var args = []
    p["_call_spread"] = nil
    if peek_is(p, token.TOK_RPAREN) {
        parser_next_token(p)
        return args
    }
    parser_next_token(p)
    var a0 = parse_expression(p, LOWEST)
    if peek_is(p, token.TOK_ELLIPSIS) {
        // Call-site spread: f(xs...)
        // - only one spread allowed
        // - spread must be last (before ')')
        p["_call_spread"] = a0
        parser_next_token(p) // ...
        if !peek_is(p, token.TOK_RPAREN) {
            parser_add_error(p, "spread '...' must be the last argument")
        }
    } else {
        oren_list_push(args, a0)
    }
    while peek_is(p, token.TOK_COMMA) {
        parser_next_token(p)
        parser_next_token(p)
        if p["_call_spread"] != nil {
            parser_add_error(p, "spread '...' must be the last argument")
            // Still parse to make progress.
            parse_expression(p, LOWEST)
            continue
        }
        var ax = parse_expression(p, LOWEST)
        if peek_is(p, token.TOK_ELLIPSIS) {
            p["_call_spread"] = ax
            parser_next_token(p) // ...
            if !peek_is(p, token.TOK_RPAREN) {
                parser_add_error(p, "spread '...' must be the last argument")
            }
        } else {
            oren_list_push(args, ax)
        }
    }
    expect_peek(p, token.TOK_RPAREN)
    return args
}

fn parse_member(p, left) {
    var tok = p["cur"]
    if !expect_peek_ident_like(p, "member name") { return nil }
    var prop = ast.new_identifier(p["cur"])

    // Enum dot-variant sugar:
    //
    //   enum Option { None, Some(x) }
    //   Option.None      -> Option_None()          (value)
    //   Option.None()    -> Option_None()          (explicit call also ok)
    //   Option.Some      -> Option_Some            (function value)
    //   Option.Some(123) -> Option_Some(123)
    //
    // This is intentionally shallow and parser-local: it does not add new AST nodes
    // and keeps backends unchanged (it rewrites to existing constructor fns).
    if left != nil && left["type"] == "Identifier" {
        var enum_name = left["value"]
        var variants = p["enum_variants"][enum_name]
        if variants != nil {
            var vname = prop["value"]
            var arity = variants[vname]
            if arity != nil {
                var fn_name = enum_name + "_" + vname
                var fn_ident = ast.new_identifier(token.new_token(token.TOK_IDENT, fn_name))
                if arity == 0 {
                    if peek_is(p, token.TOK_LPAREN) {
                        // Allow explicit `Option.None()` to parse as a normal call.
                        return fn_ident
                    }
                    // Bare `Option.None` means "construct the value".
                    return ast.new_call(token.new_token(token.TOK_LPAREN, "("), fn_ident, [])
                }
                // For payload variants, `Option.Some` is a function value, and the
                // normal call parsing handles `Option.Some(...)`.
                return fn_ident
            }
        }
    }

    return ast.new_member(tok, left, prop)
}

fn parse_array(p) {
    var tok = p["cur"]
    var elements = parse_expression_list(p, token.TOK_RBRACKET)
    return ast.new_array(tok, elements)
}

fn parse_expression_list(p, endTok) {
    var items = []
    if peek_is(p, endTok) {
        parser_next_token(p)
        return items
    }
    parser_next_token(p)
    oren_list_push(items, parse_expression(p, LOWEST))
    while peek_is(p, token.TOK_COMMA) {
        parser_next_token(p)
        parser_next_token(p)
        oren_list_push(items, parse_expression(p, LOWEST))
    }
    expect_peek(p, endTok)
    return items
}

fn parse_index(p, left) {
    var tok = p["cur"]
    parser_next_token(p)
    var idx = parse_expression(p, LOWEST)
    expect_peek(p, token.TOK_RBRACKET)
    return ast.new_index(tok, left, idx)
}

fn parse_hash(p) {
    var tok = p["cur"]
    var pairs = [] // store as list of {"key":..., "value":...}
    var cont = true
    while cont {
        if peek_is(p, token.TOK_RBRACE) {
            cont = false
        } else {
            parser_next_token(p)
            var key = parse_expression(p, LOWEST)
            if !expect_peek(p, token.TOK_COLON) {
                cont = false
            } else {
                parser_next_token(p)
                var val = parse_expression(p, LOWEST)
                oren_list_push(pairs, {"key": key, "value": val})

                if peek_is(p, token.TOK_RBRACE) {
                    // done
                } else {
                    if peek_is(p, token.TOK_COMMA) {
                        parser_next_token(p)
                    } else {
                        cont = false
                    }
                }
            }
        }
    }
    expect_peek(p, token.TOK_RBRACE)
    return ast.new_hash(tok, pairs)
}

fn parse_while(p) {
    var tok = p["cur"]
    parser_next_token(p)
    var cond = parse_expression(p, LOWEST)
    if !expect_peek(p, token.TOK_LBRACE) { return nil }
    var body = parse_block(p)
    return ast.new_while(tok, cond, body)
}

fn parse_break(p) {
    var tok = p["cur"]
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_break(tok)
}

fn parse_continue(p) {
    var tok = p["cur"]
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_continue(tok)
}

fn parse_for_init(p) {
    if cur_is(p, token.TOK_LET) { return parse_var(p) }
    if cur_is(p, token.TOK_IDENT) {
        if peek_is(p, token.TOK_DECLARE) { return parse_short_var(p) }
        if peek_is(p, token.TOK_COLON) { return parse_typed_short_var(p) }
        return parse_assign_or_expr_stmt(p)
    }
    return parse_expr_stmt(p)
}

fn parse_for_post(p) {
    if cur_is(p, token.TOK_LET) {
        parser_add_error(p, "for post does not allow var declarations")
        return nil
    }
    if cur_is(p, token.TOK_IDENT) {
        if peek_is(p, token.TOK_DECLARE) {
            parser_add_error(p, "for post does not allow :=")
            return nil
        }
        if peek_is(p, token.TOK_COLON) {
            parser_add_error(p, "for post does not allow type annotations")
            return nil
        }
        return parse_assign_or_expr_stmt(p)
    }
    return parse_expr_stmt(p)
}

fn parse_for(p) {
    var tok = p["cur"]

    // for { ... }
    if peek_is(p, token.TOK_LBRACE) {
        parser_next_token(p)
        var body = parse_block(p)
        return ast.new_for(tok, nil, nil, nil, body)
    }

    // Move to first token after `for`.
    parser_next_token(p)

    // Iterator sugar:
    //   for <ident> in <expr> { <body> }
    //
    // Desugars to a 3-clause `for` using an internal state list and a runtime iterator hook:
    //   var @forin_N = [<expr>, 0, 1]
    //   for ; @forin_N[2] != 0; @forin_N[1] = @forin_N[1] + 1 {
    //       var @forinr_N = oren_iter_next(@forin_N[0], @forin_N[1]) // -> [ok, value]
    //       @forin_N[2] = @forinr_N[0]
    //       if @forin_N[2] != 0 {
    //           var <ident> = @forinr_N[1]
    //           <body>
    //       }
    //   }
    //
    // Notes:
    // - The internal name contains '@' which is not a legal identifier character in the lexer,
    //   so it cannot collide with source names.
    // - This keeps backends minimal: it relies only on existing `for`, indexing, and `oren_list_len`.
    if cur_is(p, token.TOK_IDENT) && (peek_is(p, token.TOK_IN) || peek_is(p, token.TOK_COLON)) {
        var user_name = ast.new_identifier(p["cur"])

        // Optional iterator variable annotation:
        //   for x: u8 in bytes { ... }
        if peek_is(p, token.TOK_COLON) {
            parser_next_token(p) // :
            var tname = parse_type_name_after_colon(p)
            if tname == nil { return nil }
            user_name["ann_type"] = tname
            if !peek_is(p, token.TOK_IN) {
                parser_add_error(p, "expected 'in' after for-in type annotation")
                return nil
            }
        }
        var st_name = parser_gensym(p, "@forin_")
        var res_name = parser_gensym(p, "@forinr_")
        var st_ident = {"type": "Identifier", "token": token.new_token(token.TOK_IDENT, st_name), "value": st_name}
        var res_ident = {"type": "Identifier", "token": token.new_token(token.TOK_IDENT, res_name), "value": res_name}

        // consume 'in'
        parser_next_token(p)
        // move to iterable expr
        parser_next_token(p)
        var iterable = parse_expression(p, LOWEST)
        if iterable == nil { return nil }
        if !expect_peek(p, token.TOK_LBRACE) { return nil }
        var user_body = parse_block(p)

        // init: var @forin = [iterable, 0]
        var zero = {"type": "Integer", "token": token.new_token(token.TOK_INT, "0"), "value": "0"}
        var one = {"type": "Integer", "token": token.new_token(token.TOK_INT, "1"), "value": "1"}
        var two = {"type": "Integer", "token": token.new_token(token.TOK_INT, "2"), "value": "2"}
        var state_init = {"type": "Array", "token": token.new_token(token.TOK_LBRACKET, "["), "elements": [iterable, zero, one]}
        var init_stmt = ast.new_var(token.new_token(token.TOK_LET, "var"), st_ident, state_init)

        // state accessors
        var st0 = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, zero)
        var st1 = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, one)
        var st2 = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, two)

        // cond: @forin[2] != 0
        var cond_expr = ast.new_infix(token.new_token(token.TOK_NOT_EQ, "!="), st2, "!=", zero)

        // post: @forin[1] = @forin[1] + 1
        var inc_expr = ast.new_infix(token.new_token(token.TOK_PLUS, "+"), st1, "+", one)
        var post_stmt = ast.new_set(token.new_token(token.TOK_ASSIGN, "="), ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, one), inc_expr)

        // body:
        //   var @forinr = oren_iter_next(@forin[0], @forin[1])
        //   @forin[2] = @forinr[0]
        //   if @forin[2] != 0 { var user = @forinr[1]; <user_body> }
        var fn_next = {"type": "Identifier", "token": token.new_token(token.TOK_IDENT, "oren_iter_next"), "value": "oren_iter_next"}
        var call_next = ast.new_call(token.new_token(token.TOK_LPAREN, "("), fn_next, [st0, st1])
        var bind_res = ast.new_var(token.new_token(token.TOK_LET, "var"), res_ident, call_next)

        var res0 = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), res_ident, zero)
        var res1 = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), res_ident, one)

        // @forin[2] = @forinr[0]
        var set_ok = ast.new_set(token.new_token(token.TOK_ASSIGN, "="), ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, two), res0)

        // if @forin[2] != 0 { var user = @forinr[1]; <user_body> }
        var guard_cond = ast.new_infix(token.new_token(token.TOK_NOT_EQ, "!="), st2, "!=", zero)
        var guard_block = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
        var bind_user = ast.new_var(token.new_token(token.TOK_LET, "var"), user_name, res1)
        oren_list_push(guard_block["stmts"], bind_user)
        var bi = 0
        while bi < oren_list_len(user_body["stmts"]) {
            oren_list_push(guard_block["stmts"], user_body["stmts"][bi])
            bi = bi + 1
        }
        var if_guard = ast.new_if(token.new_token(token.TOK_IF, "if"), guard_cond, guard_block, nil)
        var if_guard_stmt = ast.new_expr_stmt(token.new_token(token.TOK_IF, "if"), if_guard)

        var body_block = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
        oren_list_push(body_block["stmts"], bind_res)
        oren_list_push(body_block["stmts"], set_ok)
        oren_list_push(body_block["stmts"], if_guard_stmt)

        return ast.new_for(tok, init_stmt, cond_expr, post_stmt, body_block)
    }

    var init = nil
    var cond = nil
    var post = nil

    // for cond { ... } or for init; cond; post { ... }
    if !cur_is(p, token.TOK_SEMICOLON) {
        var first = parse_for_init(p)
        if first == nil { return nil }

        // Condition-only form: `for <expr> { ... }`
        if first["type"] == "ExprStmt" {
            if peek_is(p, token.TOK_LBRACE) {
                cond = first["expr"]
                parser_next_token(p)
                var body2 = parse_block(p)
                return ast.new_for(tok, nil, cond, nil, body2)
            }
        }

        init = first

        // Three-clause form: ensure we consumed `;` after init.
        if !cur_is(p, token.TOK_SEMICOLON) {
            if !expect_peek(p, token.TOK_SEMICOLON) { return nil }
        }
    }

    // Parse condition (may be empty) up to second `;`.
    parser_next_token(p)
    if cur_is(p, token.TOK_SEMICOLON) {
        cond = nil
    } else {
        cond = parse_expression(p, LOWEST)
        if !expect_peek(p, token.TOK_SEMICOLON) { return nil }
    }

    // Parse post (may be empty) up to `{`.
    parser_next_token(p)
    if cur_is(p, token.TOK_LBRACE) {
        post = nil
        var body3 = parse_block(p)
        return ast.new_for(tok, init, cond, post, body3)
    }

    post = parse_for_post(p)
    if post == nil { return nil }

    if !expect_peek(p, token.TOK_LBRACE) { return nil }
    var body4 = parse_block(p)
    return ast.new_for(tok, init, cond, post, body4)
}

fn parse_import(p) {
    var tok = p["cur"]
    if !expect_peek(p, token.TOK_IDENT) { return nil }
    var name = ast.new_identifier(p["cur"])
    if !expect_peek(p, token.TOK_STRING) { return nil }
    var path = p["cur"]["literal"]
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_import(tok, name, path)
}

fn parse_type_decl(p) {
    var tok = p["cur"]
    if !expect_peek(p, token.TOK_IDENT) { return nil }
    var name = ast.new_identifier(p["cur"])
    if !expect_peek(p, token.TOK_LBRACE) { return nil }

    var fields = []
    if peek_is(p, token.TOK_RBRACE) {
        parser_next_token(p)
        if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
        return ast.new_type(tok, name, fields)
    }

    parser_next_token(p)
    var cont = true
    while cont {
        if cur_is(p, token.TOK_RBRACE) { cont = false }
        if cur_is(p, token.TOK_EOF) { cont = false }
        if cont {
            // field := {attr} ident [ ":" type_ident ]
            var fattrs = parse_attr_list(p)
            if p["cur"]["type"] != token.TOK_IDENT {
                parser_add_error(p, "expected field name, got " + p["cur"]["type"])
                return nil
            }
            var fid = ast.new_identifier(p["cur"])
            if fattrs != nil && oren_list_len(fattrs) > 0 { fid["attrs"] = fattrs }

            // Optional explicit type annotation (rolling, used by packed-byte views).
            //
            // Examples:
            // - `len: u16be`
            // - `dst: u32be`
            //
            // Type names are parsed as identifiers with optional dotted namespaces:
            // - `myorg.Type`
            // - `std.net.IPv4`
            if peek_is(p, token.TOK_COLON) {
                parser_next_token(p) // ':'
                var tname = parse_type_name_after_colon(p)
                if tname == nil { return nil }
                fid["ann_type"] = tname
            }

            oren_list_push(fields, fid)
            if peek_is(p, token.TOK_COMMA) {
                parser_next_token(p) // ,
                parser_next_token(p) // next field or }
            } else {
                if peek_is(p, token.TOK_RBRACE) {
                    parser_next_token(p)
                } else {
                    parser_add_error(p, "expected ',' or '}', got " + p["peek"]["type"])
                    return nil
                }
            }
        }
    }

    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_type(tok, name, fields)
}

fn parse_ffi(p) {
    var tok = p["cur"]
    if !expect_peek(p, token.TOK_IDENT) { return nil }
    var name = ast.new_identifier(p["cur"])
    return ast.new_ffi(tok, name)
}
