import renamer "renamer.oren"
import arm64_macho "arm64_macho.oren"
import arm64_elf "arm64_elf.oren"
import codegen_bytecode "codegen_bytecode.oren"
import transpiler "transpiler.oren"
import analysis "analysis.oren"
import lexer "lexer.oren"
import parser "parser.oren"
import ast "ast.oren"
import metadata "metadata.oren"
import packview "packview.oren"
import argparse "../std/argparse.oren"

fn cli_spec() {
    var p = argparse.new_parser("oren", "Oren compiler / toolchain driver")

    var build = argparse.add_command(p, "build", "Build a .oren file (native/c/bytecode)")
    argparse.cmd_positional(build, "file.oren", true, "Input source file")
    argparse.cmd_option(build, "--backend", nil, "string", "c", "Backend: c|native|bytecode")
    argparse.cmd_option(build, "-o", nil, "string", "", "Output path (default: strip .oren)")
    argparse.cmd_flag(build, "--emit-c", nil, "(C backend) stop after generating <file.oren>.c")
    argparse.cmd_option(build, "--cc", nil, "string", "cc", "(C backend) C compiler")
    argparse.cmd_option(build, "--target", nil, "string", "macos", "(native backend) target OS: macos|linux")
    argparse.cmd_flag(build, "--disasm", nil, "(native backend) disassemble output via otool/objdump")
    argparse.cmd_flag(build, "--debug", nil, "(native backend) embed debug info for stack traces")
    argparse.cmd_flag(build, "--lib", nil, "(native backend) build a shared library")
    argparse.cmd_flag(build, "--shared", nil, "(native backend) build a shared library (alias)")
    argparse.cmd_option(build, "--link", "-l", "string", "", "(native backend, macOS) add LC_LOAD_DYLIB")
    argparse.cmd_flag(build, "--metadata", nil, "(native backend) write <out>.meta.json")
    argparse.cmd_flag(build, "--analyze", nil, "Print analysis info and exit")
    argparse.cmd_flag(build, "--python", nil, "(C backend) enable Python integration (requires python3-config)")
    argparse.cmd_flag(build, "--strict-attrs", nil, "Reject unknown attributes unless allowlisted (also via env OREN_STRICT_ATTRS=1)")
    argparse.cmd_option(build, "--attr-allow-prefixes", nil, "string", "", "CSV allow attribute prefixes in strict mode (also via env OREN_ATTR_ALLOW_PREFIXES)")
    argparse.cmd_flag(build, "--capsule", nil, "(native backend) capability-safe subset: deny host effects unless allowlisted (also via env OREN_CAPSULE=1)")
    argparse.cmd_option(build, "--cap-allow-domains", nil, "string", "", "CSV allow capability domains in capsule mode (also via env OREN_CAP_ALLOW_DOMAINS)")
    argparse.cmd_option(build, "--codesign", nil, "string", "", "(macOS) codesign identity")
    argparse.cmd_flag(build, "--notarize", nil, "(macOS) notarize output with notarytool")
    argparse.cmd_option(build, "--notary-profile", nil, "string", "", "(macOS) notarytool keychain profile")
    argparse.cmd_flag(build, "--no-gc", nil, "Disable GC scanning (also via env OREN_NO_GC=1)")

    var emitc = argparse.add_command(p, "emit-c", "Alias for: build --backend c --emit-c")
    argparse.cmd_positional(emitc, "file.oren", true, "Input source file")

    var test = argparse.add_command(p, "test", "Run tests (repo runner or in-file test_ runner)")
    argparse.cmd_positional(test, "file.oren", false, "Optional: run test_ functions in a single file (native-only)")
    argparse.cmd_option(test, "--target", nil, "string", "macos", "(native backend) target OS: macos|linux")
    argparse.cmd_flag(test, "--no-gc", nil, "Disable GC scanning (also via env OREN_NO_GC=1)")

    var scan = argparse.add_command(p, "scan", "Scan a dylib and print exported symbols")
    argparse.cmd_positional(scan, "lib.dylib", true, "Library path")

    return p
}

fn usage() {
    var p = cli_spec()
    var lines = argparse.render_help_lines(p, nil)
    var i = 0
    while i < oren_list_len(lines) {
        print(lines[i])
        i = i + 1
    }
}

fn shell_quote(s) {
    return "'" + s + "'" // Minimal quoting
}

fn cmd_ok(cmd) {
    // Return true if command exits with 0.
    return oren_system(cmd) == 0
}

fn normalize_rc(rc) {
    // Normalize the return value of oren_system() to a conventional exit code.
    // Many C runtimes encode exit status as (code << 8).
    if rc == nil { return 1 }
    if rc < 0 { return rc }
    if rc >= 256 { return rc / 256 }
    return rc
}

fn ensure_dir(path) {
    // Use shell to avoid adding FS syscalls to the compiler surface right now.
    // This is for dev tooling (tests/build logs).
    oren_system("mkdir -p " + shell_quote(path))
    return nil
}

fn detect_timeout_bin() {
    // Prefer GNU coreutils `timeout` (Linux) and `gtimeout` (macOS coreutils).
    // We treat timeout tooling as mandatory for safe rolling iteration.
    if cmd_ok("sh -c 'timeout 1 true >/dev/null 2>&1'") { return "timeout" }
    if cmd_ok("sh -c 'gtimeout 1 true >/dev/null 2>&1'") { return "gtimeout" }
    return nil
}

fn run_shell_capture(timeout_bin, timeout_secs, cmd, log_path) {
    // Run a shell command, capture stdout+stderr to log_path, and apply a wall timeout.
    // Returns exit code of the command (or timeout wrapper).
    var t = detect_timeout_bin()
    if timeout_bin != nil { t = timeout_bin }
    if t == nil {
        print("ERROR: timeout not found (need `timeout` or `gtimeout` in PATH).")
        print("macOS: brew install coreutils")
        return 2
    }
    // Always wrap in sh -c for redirection.
    // NOTE: shell_quote is minimal; do not put untrusted input here.
    var redir = cmd + " > " + shell_quote(log_path) + " 2>&1"
    var wrapped = "sh -c " + shell_quote(redir)
    var full = t + " " + oren_int_to_string(timeout_secs) + " " + wrapped
    return normalize_rc(oren_system(full))
}

fn basename(path) {
    if path == nil { return "" }
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at(path, i) == "/" {
            return oren_string_slice(path, i + 1, oren_string_len(path))
        }
        i = i - 1
    }
    return path
}

fn strip_suffix(s, suffix) {
    if s == nil { return s }
    if suffix == nil { return s }
    var sl = oren_string_len(s)
    var pl = oren_string_len(suffix)
    if sl < pl { return s }
    if oren_string_slice(s, sl - pl, sl) == suffix {
        return oren_string_slice(s, 0, sl - pl)
    }
    return s
}

fn file_exists(path) {
    // Avoid nested quoting: shell_quote() already uses single quotes.
    // `test -f 'path'` is fine whether oren_system uses /bin/sh -c or exec.
    return cmd_ok("test -f " + shell_quote(path))
}

fn string_contains(hay, needle) {
    if hay == nil || needle == nil { return false }
    var hl = oren_string_len(hay)
    var nl = oren_string_len(needle)
    if nl == 0 { return true }
    if hl < nl { return false }
    var i = 0
    while i <= hl - nl {
        var j = 0
        while j < nl {
            if oren_string_char_at(hay, i + j) != oren_string_char_at(needle, j) {
                j = -1
                break
            }
            j = j + 1
        }
        if j == nl { return true }
        i = i + 1
    }
    return false
}

fn run_repo_tests(target, no_gc) {
    // Repo-wide curated runner:
    // - native tests compiled+run with native backend
    // - avm tests compiled to .obc and run via ./avm
    // - module tests compiled+run with C backend (bootstrap module system coverage)

    var timeout_bin = detect_timeout_bin()
    if timeout_bin == nil {
        print("ERROR: timeout not found (need `timeout` or `gtimeout` in PATH).")
        print("macOS: brew install coreutils")
        oren_exit(2)
    }

    ensure_dir("build")
    ensure_dir("build/logs")

    // Timeouts: keep short by default for iteration velocity.
    var build_timeout = 60
    var run_timeout = 10

    // Curated lists (canonical; keep Makefile as a thin wrapper if still present).
    var native_tests = [
        "tests/native/test_smoke_suite.oren",
        "tests/native/test_time_suite.oren",
        "tests/native/test_net_suite.oren",
        "tests/native/test_env_execve_getenv.oren",
        "tests/native/test_syscall_errno.oren",
        "tests/native/test_read_bytes.oren",
        "tests/native/test_bytes_set_endian.oren",
        "tests/native/test_int_casts.oren",
        "tests/native/test_int_casts_checked.oren",
        "tests/native/test_float_ops.oren",
        "tests/native/test_pack_view.oren",
        "tests/native/test_system_timeout.oren",
        "tests/native/test_spawn_join_timeout.oren",
        "tests/native/test_native_mem_stats_gc.oren",
        // Expected-failure regression: panic must produce a readable stack trace.
        "tests/native/test_debug_panic.oren"
    ]

    var module_tests = [
        "tests/modules/test_shapes.oren",
        "tests/modules/test_spawn.oren",
        "tests/modules/test_spawn_join_timeout.oren",
        "tests/modules/test_read_bytes.oren",
        "tests/modules/test_bytes_set_endian.oren",
        "tests/modules/test_int_casts.oren",
        "tests/modules/test_int_casts_checked.oren",
        "tests/modules/test_float_ops.oren",
        "tests/modules/test_function_values.oren",
        "tests/modules/test_lambda_closure.oren",
        "tests/modules/test_lambda_multiline.oren",
        "tests/modules/test_endian_casts.oren",
        "tests/modules/test_pack_view.oren",
        "tests/modules/test_gc_threads.oren",
        "tests/modules/test_gc_stack_roots.oren",
        "tests/modules/test_result.oren",
        "tests/modules/test_argparse.oren",
        "tests/modules/test_metadata_attrs.oren",
        "tests/modules/test_strings.oren",
        "tests/modules/test_string_from_bytes.oren",
        "tests/modules/test_json.oren",
        "tests/modules/test_switch.oren"
    ]

    var avm_tests = [
        "tests/avm/test_smoke_suite.oren",
        "tests/avm/test_bytes_set_endian.oren",
        "tests/avm/test_int_casts.oren",
        "tests/avm/test_int_casts_checked.oren",
        "tests/avm/test_pack_view.oren",
        "tests/avm/test_closure_fn_values.oren",
        "tests/avm/test_policy_scan.oren",
        "tests/avm/test_job_scan.oren",
        "tests/avm/test_snapshot_resume.oren",
        "tests/avm/test_multiverse_invalid_obc.oren",
        "tests/avm/test_multiverse_vfs_inherit.oren",
        "tests/avm/test_fs_mounts_host_backend.oren",
        "tests/avm/test_float_ops.oren",
        "tests/avm/test_time_rng_deterministic.oren",
        "tests/avm/test_time_rng_record_replay_mem.oren",
        "tests/avm/test_budget_gas.oren",
        "tests/avm/test_budget_timeout.oren",
        "tests/avm/test_call_depth_limit.oren",
        "tests/avm/test_vfs_no_host_fs.oren",
        "tests/avm/test_vproc_no_host_proc.oren",
        "tests/avm/test_vnet_no_host_net.oren",
        "tests/avm/test_oren_env_bridge_capsule.oren",
        "tests/avm/test_switch.oren"
    ]

    // Ensure avm runner exists for AVM tests.
    if cmd_ok("sh -c 'test -x ./avm'") != true {
        print("ERROR: ./avm not found or not executable. Build it first.")
        print("Current workaround: make avm")
        oren_exit(2)
    }

    var gc_arg = ""
    if no_gc { gc_arg = " --no-gc" }

    // --- Compile-fail fixtures (portable semantics guards) ---
    // strict attrs OK must compile with strict mode enabled
    var strict_ok_log = "build/logs/strict_attrs_ok.log"
    var strict_ok_cmd = "./oren build " + shell_quote("tests/native/fixtures/strict_attrs_ok.oren") + " --backend native --target " + target + " -o " + shell_quote("build/strict_attrs_ok") + " --strict-attrs --attr-allow-prefixes myorg." + gc_arg
    var strict_ok_rc = run_shell_capture(timeout_bin, build_timeout, strict_ok_cmd, strict_ok_log)
    oren_system("rm -f " + shell_quote("build/strict_attrs_ok"))
    if strict_ok_rc != 0 {
        print("native failed: strict_attrs_ok")
        oren_system("cat " + shell_quote(strict_ok_log))
        oren_exit(1)
    }

    // strict attrs BAD must fail compile with strict mode enabled
    var strict_bad_log = "build/logs/strict_attrs_bad.log"
    var strict_bad_cmd = "./oren build " + shell_quote("tests/native/fixtures/strict_attrs_bad.oren") + " --backend native --target " + target + " -o " + shell_quote("build/strict_attrs_bad") + " --strict-attrs" + gc_arg
    var strict_bad_rc = run_shell_capture(timeout_bin, build_timeout, strict_bad_cmd, strict_bad_log)
    oren_system("rm -f " + shell_quote("build/strict_attrs_bad"))
    if strict_bad_rc == 0 {
        print("native failed: strict_attrs_bad (expected compile error in strict mode)")
        oren_system("cat " + shell_quote(strict_bad_log))
        oren_exit(1)
    }

    // Struct fields are immutable: `obj.field = v` must be rejected at parse-time.
    var imm_log = "build/logs/struct_field_assign_bad.log"
    var imm_cmd = "./oren build " + shell_quote("tests/native/fixtures/struct_field_assign_bad.oren") + " --backend native --target " + target + " -o " + shell_quote("build/struct_field_assign_bad") + gc_arg
    var imm_rc = run_shell_capture(timeout_bin, build_timeout, imm_cmd, imm_log)
    oren_system("rm -f " + shell_quote("build/struct_field_assign_bad"))
    if imm_rc == 0 {
        print("native failed: struct_field_assign_bad (expected compile error: struct fields immutable)")
        oren_system("cat " + shell_quote(imm_log))
        oren_exit(1)
    }

    // Capsule mode (native): capability gating fixtures.
    // - OK: pure program compiles in capsule mode
    // - BAD: direct syscalls are rejected
    // - BAD: FS-gated APIs are rejected unless FS is enrolled
    // - OK: FS-gated APIs compile when FS is enrolled
    var cap_ok_log = "build/logs/capsule_ok.log"
    var cap_ok_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_ok.oren") + " --backend native --target " + target + " -o " + shell_quote("build/capsule_ok") + " --capsule" + gc_arg
    var cap_ok_rc = run_shell_capture(timeout_bin, build_timeout, cap_ok_cmd, cap_ok_log)
    oren_system("rm -f " + shell_quote("build/capsule_ok"))
    if cap_ok_rc != 0 {
        print("native failed: capsule_ok (expected capsule compile success)")
        oren_system("cat " + shell_quote(cap_ok_log))
        oren_exit(1)
    }

    var cap_bad_sys_log = "build/logs/capsule_bad_syscall.log"
    var cap_bad_sys_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_bad_syscall.oren") + " --backend native --target " + target + " -o " + shell_quote("build/capsule_bad_syscall") + " --capsule" + gc_arg
    var cap_bad_sys_rc = run_shell_capture(timeout_bin, build_timeout, cap_bad_sys_cmd, cap_bad_sys_log)
    oren_system("rm -f " + shell_quote("build/capsule_bad_syscall"))
    if cap_bad_sys_rc == 0 {
        print("native failed: capsule_bad_syscall (expected capsule compile error)")
        oren_system("cat " + shell_quote(cap_bad_sys_log))
        oren_exit(1)
    }

    var cap_bad_fs_log = "build/logs/capsule_bad_fs.log"
    var cap_bad_fs_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_bad_fs.oren") + " --backend native --target " + target + " -o " + shell_quote("build/capsule_bad_fs") + " --capsule" + gc_arg
    var cap_bad_fs_rc = run_shell_capture(timeout_bin, build_timeout, cap_bad_fs_cmd, cap_bad_fs_log)
    oren_system("rm -f " + shell_quote("build/capsule_bad_fs"))
    if cap_bad_fs_rc == 0 {
        print("native failed: capsule_bad_fs (expected capsule compile error: FS not enrolled)")
        oren_system("cat " + shell_quote(cap_bad_fs_log))
        oren_exit(1)
    }

    var cap_ok_fs_log = "build/logs/capsule_ok_fs_allow.log"
    var cap_ok_fs_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_ok_fs_allow.oren") + " --backend native --target " + target + " -o " + shell_quote("build/capsule_ok_fs_allow") + " --capsule --cap-allow-domains FS" + gc_arg
    var cap_ok_fs_rc = run_shell_capture(timeout_bin, build_timeout, cap_ok_fs_cmd, cap_ok_fs_log)
    oren_system("rm -f " + shell_quote("build/capsule_ok_fs_allow"))
    if cap_ok_fs_rc != 0 {
        print("native failed: capsule_ok_fs_allow (expected capsule compile success with FS enrolled)")
        oren_system("cat " + shell_quote(cap_ok_fs_log))
        oren_exit(1)
    }

    // Capsule mode (native runtime): defense-in-depth enforcement should deny host effects
    // at runtime when OREN_CAPSULE=1, even if the program was compiled without --capsule.
    var cap_rt_out = "build/capsule_runtime_fs_prog"
    var cap_rt_log = "build/logs/capsule_runtime_fs_prog_build.log"
    var cap_rt_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_fs_prog.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_rt_out) + gc_arg
    var cap_rt_rc = run_shell_capture(timeout_bin, build_timeout, cap_rt_cmd, cap_rt_log)
    if cap_rt_rc != 0 || file_exists(cap_rt_out) != true {
        print("native failed: capsule_runtime_fs_prog (build)")
        oren_system("cat " + shell_quote(cap_rt_log))
        oren_exit(1)
    }

    // Run under capsule without FS: must fail and must not create the file.
    oren_system("rm -f build/capsule_runtime_fs_prog.bin")
    var cap_rt_run_log = "build/logs/capsule_runtime_fs_prog_run_deny.log"
    var cap_rt_run_cmd = "OREN_CAPSULE=1 ./" + cap_rt_out
    var cap_rt_run_rc = run_shell_capture(timeout_bin, run_timeout, cap_rt_run_cmd, cap_rt_run_log)
    if cap_rt_run_rc == 0 {
        print("native failed: capsule_runtime_fs_prog (expected runtime capsule deny)")
        oren_system("cat " + shell_quote(cap_rt_run_log))
        oren_exit(1)
    }
    if cmd_ok("test -f " + shell_quote("build/capsule_runtime_fs_prog.bin")) {
        print("native failed: capsule_runtime_fs_prog (deny mode wrote file unexpectedly)")
        oren_system("cat " + shell_quote(cap_rt_run_log))
        oren_exit(1)
    }

    // Run under capsule with FS enrolled: should succeed and create the file.
    var cap_rt_run_ok_log = "build/logs/capsule_runtime_fs_prog_run_allow.log"
    var cap_rt_run_ok_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=FS OREN_FS_ALLOW_WRITE_PREFIXES=build/ ./" + cap_rt_out
    var cap_rt_run_ok_rc = run_shell_capture(timeout_bin, run_timeout, cap_rt_run_ok_cmd, cap_rt_run_ok_log)
    if cap_rt_run_ok_rc != 0 {
        print("native failed: capsule_runtime_fs_prog (expected runtime capsule allow)")
        oren_system("cat " + shell_quote(cap_rt_run_ok_log))
        oren_exit(1)
    }
    if cmd_ok("test -f " + shell_quote("build/capsule_runtime_fs_prog.bin")) != true {
        print("native failed: capsule_runtime_fs_prog (allow mode did not write file)")
        oren_system("cat " + shell_quote(cap_rt_run_ok_log))
        oren_exit(1)
    }

    oren_system("rm -f " + shell_quote(cap_rt_out))

    // Capsule FS read allowlist: split read vs write prefixes (defense-in-depth).
    // Prepare a deterministic file to read (created by the repo runner, not by the program).
    oren_system("printf \"ok\" > build/capsule_runtime_fs_read.txt")

    var cap_rt_r_out = "build/capsule_runtime_fs_read_prog"
    var cap_rt_r_log = "build/logs/capsule_runtime_fs_read_prog_build.log"
    var cap_rt_r_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_fs_read_prog.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_rt_r_out) + gc_arg
    var cap_rt_r_rc = run_shell_capture(timeout_bin, build_timeout, cap_rt_r_cmd, cap_rt_r_log)
    if cap_rt_r_rc != 0 || file_exists(cap_rt_r_out) != true {
        print("native failed: capsule_runtime_fs_read_prog (build)")
        oren_system("cat " + shell_quote(cap_rt_r_log))
        oren_exit(1)
    }

    // 1) FS domain enrolled but READ prefix missing -> must fail.
    var cap_rt_r_deny_log = "build/logs/capsule_runtime_fs_read_prog_run_deny.log"
    var cap_rt_r_deny_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=FS OREN_FS_ALLOW_WRITE_PREFIXES=build/ ./" + cap_rt_r_out
    var cap_rt_r_deny_rc = run_shell_capture(timeout_bin, run_timeout, cap_rt_r_deny_cmd, cap_rt_r_deny_log)
    if cap_rt_r_deny_rc == 0 {
        print("native failed: capsule_runtime_fs_read_prog (expected runtime capsule deny: read prefix)")
        oren_system("cat " + shell_quote(cap_rt_r_deny_log))
        oren_exit(1)
    }

    // 2) Provide READ prefix -> should succeed.
    var cap_rt_r_ok_log = "build/logs/capsule_runtime_fs_read_prog_run_allow.log"
    var cap_rt_r_ok_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=FS OREN_FS_ALLOW_READ_PREFIXES=build/ ./" + cap_rt_r_out
    var cap_rt_r_ok_rc = run_shell_capture(timeout_bin, run_timeout, cap_rt_r_ok_cmd, cap_rt_r_ok_log)
    if cap_rt_r_ok_rc != 0 {
        print("native failed: capsule_runtime_fs_read_prog (expected runtime capsule allow: read prefix)")
        oren_system("cat " + shell_quote(cap_rt_r_ok_log))
        oren_exit(1)
    }

    oren_system("rm -f " + shell_quote(cap_rt_r_out) + " build/capsule_runtime_fs_read.txt")

    // Capsule FS mounts: map virtual path prefixes to host prefixes.
    // Mounts are intended as the explicit enrollment mechanism for nested universes:
    // the program uses virtual paths; the host mapping is configured externally.
    //
    // Prepare host mount root:
    oren_system("rm -rf build/mnt_host && mkdir -p build/mnt_host")
    oren_system("printf \"ok\" > build/mnt_host/in.txt")

    var cap_mr_out = "build/capsule_runtime_fs_mount_read_prog"
    var cap_mr_log = "build/logs/capsule_runtime_fs_mount_read_prog_build.log"
    var cap_mr_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_fs_mount_read_prog.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_mr_out) + gc_arg
    var cap_mr_rc = run_shell_capture(timeout_bin, build_timeout, cap_mr_cmd, cap_mr_log)
    if cap_mr_rc != 0 || file_exists(cap_mr_out) != true {
        print("native failed: capsule_runtime_fs_mount_read_prog (build)")
        oren_system("cat " + shell_quote(cap_mr_log))
        oren_exit(1)
    }

    // Read mount configured => should succeed even without OREN_FS_ALLOW_READ_PREFIXES.
    var cap_mr_ok_log = "build/logs/capsule_runtime_fs_mount_read_prog_run_allow.log"
    var cap_mr_ok_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=FS OREN_FS_MOUNTS_READ=v/=build/mnt_host/ ./" + cap_mr_out
    var cap_mr_ok_rc = run_shell_capture(timeout_bin, run_timeout, cap_mr_ok_cmd, cap_mr_ok_log)
    if cap_mr_ok_rc != 0 {
        print("native failed: capsule_runtime_fs_mount_read_prog (expected runtime capsule allow: mount read)")
        oren_system("cat " + shell_quote(cap_mr_ok_log))
        oren_exit(1)
    }

    // Missing WRITE mount => write should fail (read mount must not imply write).
    var cap_mw_out = "build/capsule_runtime_fs_mount_write_prog"
    var cap_mw_log = "build/logs/capsule_runtime_fs_mount_write_prog_build.log"
    var cap_mw_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_fs_mount_write_prog.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_mw_out) + gc_arg
    var cap_mw_rc = run_shell_capture(timeout_bin, build_timeout, cap_mw_cmd, cap_mw_log)
    if cap_mw_rc != 0 || file_exists(cap_mw_out) != true {
        print("native failed: capsule_runtime_fs_mount_write_prog (build)")
        oren_system("cat " + shell_quote(cap_mw_log))
        oren_exit(1)
    }

    oren_system("rm -f build/mnt_host/out.bin")
    var cap_mw_deny_log = "build/logs/capsule_runtime_fs_mount_write_prog_run_deny.log"
    var cap_mw_deny_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=FS OREN_FS_MOUNTS_READ=v/=build/mnt_host/ ./" + cap_mw_out
    var cap_mw_deny_rc = run_shell_capture(timeout_bin, run_timeout, cap_mw_deny_cmd, cap_mw_deny_log)
    if cap_mw_deny_rc == 0 {
        print("native failed: capsule_runtime_fs_mount_write_prog (expected runtime capsule deny: write mount missing)")
        oren_system("cat " + shell_quote(cap_mw_deny_log))
        oren_exit(1)
    }

    // Provide WRITE mount => write should succeed and create the host file.
    var cap_mw_ok_log = "build/logs/capsule_runtime_fs_mount_write_prog_run_allow.log"
    var cap_mw_ok_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=FS OREN_FS_MOUNTS_WRITE=v/=build/mnt_host/ ./" + cap_mw_out
    var cap_mw_ok_rc = run_shell_capture(timeout_bin, run_timeout, cap_mw_ok_cmd, cap_mw_ok_log)
    if cap_mw_ok_rc != 0 {
        print("native failed: capsule_runtime_fs_mount_write_prog (expected runtime capsule allow: mount write)")
        oren_system("cat " + shell_quote(cap_mw_ok_log))
        oren_exit(1)
    }
    if cmd_ok("test -f " + shell_quote("build/mnt_host/out.bin")) != true {
        print("native failed: capsule_runtime_fs_mount_write_prog (allow mode did not write host file)")
        oren_system("cat " + shell_quote(cap_mw_ok_log))
        oren_exit(1)
    }

    oren_system("rm -f " + shell_quote(cap_mr_out) + " " + shell_quote(cap_mw_out) + " build/mnt_host/in.txt build/mnt_host/out.bin")

    // Capsule NET allowlist (native runtime): deny-by-default endpoint enrollment.
    // Connect:
    // - no enrollment -> deny
    // - loopback enrollment -> allow attempt (program prints "ok")
    var cap_net_c_out = "build/capsule_runtime_net_connect_prog"
    var cap_net_c_log = "build/logs/capsule_runtime_net_connect_prog_build.log"
    var cap_net_c_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_net_connect_prog.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_net_c_out) + gc_arg
    var cap_net_c_rc = run_shell_capture(timeout_bin, build_timeout, cap_net_c_cmd, cap_net_c_log)
    if cap_net_c_rc != 0 || file_exists(cap_net_c_out) != true {
        print("native failed: capsule_runtime_net_connect_prog (build)")
        oren_system("cat " + shell_quote(cap_net_c_log))
        oren_exit(1)
    }

    var cap_net_c_deny_log = "build/logs/capsule_runtime_net_connect_prog_run_deny.log"
    var cap_net_c_deny_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=NET ./" + cap_net_c_out
    var cap_net_c_deny_rc = run_shell_capture(timeout_bin, run_timeout, cap_net_c_deny_cmd, cap_net_c_deny_log)
    if cap_net_c_deny_rc == 0 {
        print("native failed: capsule_runtime_net_connect_prog (expected runtime capsule deny: NET_CONNECT)")
        oren_system("cat " + shell_quote(cap_net_c_deny_log))
        oren_exit(1)
    }

    var cap_net_c_ok_log = "build/logs/capsule_runtime_net_connect_prog_run_allow.log"
    var cap_net_c_ok_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=NET OREN_NET_ALLOW_LOOPBACK=1 ./" + cap_net_c_out
    var cap_net_c_ok_rc = run_shell_capture(timeout_bin, run_timeout, cap_net_c_ok_cmd, cap_net_c_ok_log)
    if cap_net_c_ok_rc != 0 {
        print("native failed: capsule_runtime_net_connect_prog (expected runtime capsule allow: loopback)")
        oren_system("cat " + shell_quote(cap_net_c_ok_log))
        oren_exit(1)
    }

    oren_system("rm -f " + shell_quote(cap_net_c_out))

    // Listen:
    // - no enrollment -> deny
    // - loopback enrollment -> allow bind/listen to 127.0.0.1:0
    var cap_net_l_out = "build/capsule_runtime_net_listen_prog"
    var cap_net_l_log = "build/logs/capsule_runtime_net_listen_prog_build.log"
    var cap_net_l_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_net_listen_prog.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_net_l_out) + gc_arg
    var cap_net_l_rc = run_shell_capture(timeout_bin, build_timeout, cap_net_l_cmd, cap_net_l_log)
    if cap_net_l_rc != 0 || file_exists(cap_net_l_out) != true {
        print("native failed: capsule_runtime_net_listen_prog (build)")
        oren_system("cat " + shell_quote(cap_net_l_log))
        oren_exit(1)
    }

    var cap_net_l_deny_log = "build/logs/capsule_runtime_net_listen_prog_run_deny.log"
    var cap_net_l_deny_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=NET ./" + cap_net_l_out
    var cap_net_l_deny_rc = run_shell_capture(timeout_bin, run_timeout, cap_net_l_deny_cmd, cap_net_l_deny_log)
    if cap_net_l_deny_rc == 0 {
        print("native failed: capsule_runtime_net_listen_prog (expected runtime capsule deny: NET_LISTEN)")
        oren_system("cat " + shell_quote(cap_net_l_deny_log))
        oren_exit(1)
    }

    var cap_net_l_ok_log = "build/logs/capsule_runtime_net_listen_prog_run_allow.log"
    var cap_net_l_ok_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=NET OREN_NET_ALLOW_LOOPBACK=1 ./" + cap_net_l_out
    var cap_net_l_ok_rc = run_shell_capture(timeout_bin, run_timeout, cap_net_l_ok_cmd, cap_net_l_ok_log)
    if cap_net_l_ok_rc != 0 {
        print("native failed: capsule_runtime_net_listen_prog (expected runtime capsule allow: loopback)")
        oren_system("cat " + shell_quote(cap_net_l_ok_log))
        oren_exit(1)
    }

    oren_system("rm -f " + shell_quote(cap_net_l_out))

    // Capsule PROC allowlist (native runtime): deny-by-default exec enrollment, plus explicit shell enable.
    // Spawn:
    // - PROC domain enrolled but no exec allowlist -> deny
    // - exec allowlist includes /usr/bin/ -> allow
    var cap_proc_s_out = "build/capsule_runtime_proc_spawn_prog"
    var cap_proc_s_log = "build/logs/capsule_runtime_proc_spawn_prog_build.log"
    var cap_proc_s_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_proc_spawn_prog.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_proc_s_out) + gc_arg
    var cap_proc_s_rc = run_shell_capture(timeout_bin, build_timeout, cap_proc_s_cmd, cap_proc_s_log)
    if cap_proc_s_rc != 0 || file_exists(cap_proc_s_out) != true {
        print("native failed: capsule_runtime_proc_spawn_prog (build)")
        oren_system("cat " + shell_quote(cap_proc_s_log))
        oren_exit(1)
    }

    var cap_proc_s_deny_log = "build/logs/capsule_runtime_proc_spawn_prog_run_deny.log"
    var cap_proc_s_deny_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=PROC ./" + cap_proc_s_out
    var cap_proc_s_deny_rc = run_shell_capture(timeout_bin, run_timeout, cap_proc_s_deny_cmd, cap_proc_s_deny_log)
    if cap_proc_s_deny_rc == 0 {
        print("native failed: capsule_runtime_proc_spawn_prog (expected runtime capsule deny: PROC_EXEC)")
        oren_system("cat " + shell_quote(cap_proc_s_deny_log))
        oren_exit(1)
    }

    var cap_proc_s_ok_log = "build/logs/capsule_runtime_proc_spawn_prog_run_allow.log"
    // NOTE: run_shell_capture wraps the whole command in single quotes, so avoid single quotes inside.
    var cap_proc_s_ok_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=PROC OREN_PROC_ALLOW_EXEC_PREFIXES=/usr/bin/ OREN_PROC_ALLOW_ARGV=\"/usr/bin/true|/usr/bin/true\" ./" + cap_proc_s_out
    var cap_proc_s_ok_rc = run_shell_capture(timeout_bin, run_timeout, cap_proc_s_ok_cmd, cap_proc_s_ok_log)
    if cap_proc_s_ok_rc != 0 {
        print("native failed: capsule_runtime_proc_spawn_prog (expected runtime capsule allow: exec prefixes)")
        oren_system("cat " + shell_quote(cap_proc_s_ok_log))
        oren_exit(1)
    }

    oren_system("rm -f " + shell_quote(cap_proc_s_out))

    // System (shell):
    // - PROC enrolled but shell not enabled -> deny
    // - enable shell -> allow
    var cap_proc_sys_out = "build/capsule_runtime_proc_system_prog"
    var cap_proc_sys_log = "build/logs/capsule_runtime_proc_system_prog_build.log"
    var cap_proc_sys_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_proc_system_prog.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_proc_sys_out) + gc_arg
    var cap_proc_sys_rc = run_shell_capture(timeout_bin, build_timeout, cap_proc_sys_cmd, cap_proc_sys_log)
    if cap_proc_sys_rc != 0 || file_exists(cap_proc_sys_out) != true {
        print("native failed: capsule_runtime_proc_system_prog (build)")
        oren_system("cat " + shell_quote(cap_proc_sys_log))
        oren_exit(1)
    }

    var cap_proc_sys_deny_log = "build/logs/capsule_runtime_proc_system_prog_run_deny.log"
    var cap_proc_sys_deny_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=PROC ./" + cap_proc_sys_out
    var cap_proc_sys_deny_rc = run_shell_capture(timeout_bin, run_timeout, cap_proc_sys_deny_cmd, cap_proc_sys_deny_log)
    if cap_proc_sys_deny_rc == 0 {
        print("native failed: capsule_runtime_proc_system_prog (expected runtime capsule deny: PROC_SYSTEM)")
        oren_system("cat " + shell_quote(cap_proc_sys_deny_log))
        oren_exit(1)
    }

    var cap_proc_sys_ok_log = "build/logs/capsule_runtime_proc_system_prog_run_allow.log"
    var cap_proc_sys_ok_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=PROC OREN_PROC_ALLOW_SYSTEM=1 OREN_PROC_ALLOW_ARGV=\"/bin/sh|sh|-c|*\" ./" + cap_proc_sys_out
    var cap_proc_sys_ok_rc = run_shell_capture(timeout_bin, run_timeout, cap_proc_sys_ok_cmd, cap_proc_sys_ok_log)
    if cap_proc_sys_ok_rc != 0 {
        print("native failed: capsule_runtime_proc_system_prog (expected runtime capsule allow: system)")
        oren_system("cat " + shell_quote(cap_proc_sys_ok_log))
        oren_exit(1)
    }

    oren_system("rm -f " + shell_quote(cap_proc_sys_out))

    // Env filtering:
    // - Parent sets OREN_TEST_SECRET.
    // - Default in capsule mode: env is empty (unless explicitly inherited/allowlisted).
    // - Allowlist just that key => child sees it.
    var cap_proc_env_out = "build/capsule_runtime_proc_env_prog"
    var cap_proc_env_log = "build/logs/capsule_runtime_proc_env_prog_build.log"
    var cap_proc_env_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_proc_env_prog.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_proc_env_out) + gc_arg
    var cap_proc_env_rc = run_shell_capture(timeout_bin, build_timeout, cap_proc_env_cmd, cap_proc_env_log)
    if cap_proc_env_rc != 0 || file_exists(cap_proc_env_out) != true {
        print("native failed: capsule_runtime_proc_env_prog (build)")
        oren_system("cat " + shell_quote(cap_proc_env_log))
        oren_exit(1)
    }

    var cap_proc_env_deny_log = "build/logs/capsule_runtime_proc_env_prog_run_deny.log"
    // NOTE: OREN_PROC_ALLOW_ARGV is intentionally set even for the deny case to isolate "env is filtered by default".
    var cap_proc_env_deny_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=PROC OREN_PROC_ALLOW_EXEC_PREFIXES=/usr/bin/ OREN_PROC_ALLOW_ARGV=\"/usr/bin/printenv|printenv|OREN_*\" OREN_TEST_SECRET=shh ./" + cap_proc_env_out
    var cap_proc_env_deny_rc = run_shell_capture(timeout_bin, run_timeout, cap_proc_env_deny_cmd, cap_proc_env_deny_log)
    if cap_proc_env_deny_rc == 0 {
        print("native failed: capsule_runtime_proc_env_prog (expected env to be filtered by default)")
        oren_system("cat " + shell_quote(cap_proc_env_deny_log))
        oren_exit(1)
    }

    var cap_proc_env_ok_log = "build/logs/capsule_runtime_proc_env_prog_run_allow.log"
    var cap_proc_env_ok_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=PROC OREN_PROC_ALLOW_EXEC_PREFIXES=/usr/bin/ OREN_PROC_ALLOW_ENV_KEYS=OREN_TEST_SECRET OREN_PROC_ALLOW_ARGV=\"/usr/bin/printenv|printenv|OREN_*\" OREN_TEST_SECRET=shh ./" + cap_proc_env_out
    var cap_proc_env_ok_rc = run_shell_capture(timeout_bin, run_timeout, cap_proc_env_ok_cmd, cap_proc_env_ok_log)
    if cap_proc_env_ok_rc != 0 {
        print("native failed: capsule_runtime_proc_env_prog (expected env allowlist to pass)")
        oren_system("cat " + shell_quote(cap_proc_env_ok_log))
        oren_exit(1)
    }

    oren_system("rm -f " + shell_quote(cap_proc_env_out))

    // Capsule propagation to child Oren programs:
    // - Parent is capsule PROC-only; it spawns a child Oren binary that attempts FS write.
    // - The child must inherit capsule env settings and be denied FS (file must not be created).
    oren_system("rm -f build/capsule_spawn_child.bin")

    var cap_child_out = "build/capsule_spawn_child"
    var cap_child_log = "build/logs/capsule_spawn_child_build.log"
    var cap_child_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_proc_child_capsule_child.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_child_out) + gc_arg
    var cap_child_rc = run_shell_capture(timeout_bin, build_timeout, cap_child_cmd, cap_child_log)
    if cap_child_rc != 0 || file_exists(cap_child_out) != true {
        print("native failed: capsule_spawn_child (build)")
        oren_system("cat " + shell_quote(cap_child_log))
        oren_exit(1)
    }

    var cap_parent_out = "build/capsule_spawn_parent"
    var cap_parent_log = "build/logs/capsule_spawn_parent_build.log"
    var cap_parent_cmd = "./oren build " + shell_quote("tests/native/fixtures/capsule_runtime_proc_child_capsule_parent.oren") + " --backend native --target " + target + " -o " + shell_quote(cap_parent_out) + gc_arg
    var cap_parent_rc = run_shell_capture(timeout_bin, build_timeout, cap_parent_cmd, cap_parent_log)
    if cap_parent_rc != 0 || file_exists(cap_parent_out) != true {
        print("native failed: capsule_spawn_parent (build)")
        oren_system("cat " + shell_quote(cap_parent_log))
        oren_exit(1)
    }

    var cap_parent_run_log = "build/logs/capsule_spawn_parent_run.log"
    var cap_parent_run_cmd = "OREN_CAPSULE=1 OREN_CAP_ALLOW_DOMAINS=PROC OREN_PROC_ALLOW_EXEC_PREFIXES=build/ OREN_PROC_ALLOW_ARGV=\"build/capsule_spawn_child|capsule_spawn_child\" ./" + cap_parent_out
    var cap_parent_run_rc = run_shell_capture(timeout_bin, run_timeout, cap_parent_run_cmd, cap_parent_run_log)
    if cap_parent_run_rc != 0 {
        print("native failed: capsule_spawn_parent (run)")
        oren_system("cat " + shell_quote(cap_parent_run_log))
        oren_exit(1)
    }
    if cmd_ok("test -f " + shell_quote("build/capsule_spawn_child.bin")) {
        print("native failed: capsule_spawn_child (child escaped capsule; wrote file)")
        oren_system("cat " + shell_quote(cap_parent_run_log))
        oren_exit(1)
    }

    oren_system("rm -f " + shell_quote(cap_child_out) + " " + shell_quote(cap_parent_out) + " build/capsule_spawn_child.bin")

    // --- Native tests ---
    var n_pass = 0
    var n_total = oren_list_len(native_tests)
    var n_failed = []

    var i = 0
    while i < n_total {
        var file = native_tests[i]
        var name = strip_suffix(basename(file), ".oren")
        var out = "build/" + name
        var log = "build/logs/native_" + name + ".log"

        var build_cmd = "./oren build " + shell_quote(file) + " --backend native --target " + target + " -o " + shell_quote(out) + gc_arg
        var build_rc = run_shell_capture(timeout_bin, build_timeout, build_cmd, log)
        if build_rc != 0 || file_exists(out) != true {
            oren_list_push(n_failed, {"name": file, "log": log})
            i = i + 1
            continue
        }

        var run_cmd = "./" + out
        var run_rc = run_shell_capture(timeout_bin, run_timeout, run_cmd, log)
        if name == "test_debug_panic" {
            // Expected: non-zero exit (panic). Unexpected: success or external wall-time timeout.
            if run_rc == 0 || run_rc == 124 {
                oren_list_push(n_failed, {"name": file, "log": log})
                oren_system("rm -f " + shell_quote(out))
                i = i + 1
                continue
            }

            var out_s = oren_read_file(log)
            if oren_is_err(out_s) {
                oren_list_push(n_failed, {"name": file, "log": log})
                oren_system("rm -f " + shell_quote(out))
                i = i + 1
                continue
            }

            // Minimal readability signals (rolling): panic header + program frames.
            if string_contains(out_s, "Runtime Panic") != true {
                oren_list_push(n_failed, {"name": file, "log": log})
                oren_system("rm -f " + shell_quote(out))
                i = i + 1
                continue
            }
            if string_contains(out_s, "__top_level__") != true {
                oren_list_push(n_failed, {"name": file, "log": log})
                oren_system("rm -f " + shell_quote(out))
                i = i + 1
                continue
            }
            if string_contains(out_s, "crash_me") != true {
                oren_list_push(n_failed, {"name": file, "log": log})
                oren_system("rm -f " + shell_quote(out))
                i = i + 1
                continue
            }
            // Reject a common failure mode: host wrapper symbol mis-labeled as a program frame.
            if string_contains(out_s, "__oren_fnwrap_crash_me") == true {
                oren_list_push(n_failed, {"name": file, "log": log})
                oren_system("rm -f " + shell_quote(out))
                i = i + 1
                continue
            }

            // Treat expected panic as pass.
            n_pass = n_pass + 1
            oren_system("rm -f " + shell_quote(out))
            i = i + 1
            continue
        }
        oren_system("rm -f " + shell_quote(out))
        if run_rc != 0 {
            oren_list_push(n_failed, {"name": file, "log": log})
            i = i + 1
            continue
        }

        n_pass = n_pass + 1
        i = i + 1
    }

    // --- Module tests (C backend; module system coverage) ---
    var m_pass = 0
    var m_total = oren_list_len(module_tests)
    var m_failed = []

    var mi = 0
    while mi < m_total {
        var file2 = module_tests[mi]
        var name2 = strip_suffix(basename(file2), ".oren")
        var out2 = "build/" + name2
        var log2 = "build/logs/mod_" + name2 + ".log"

        var build_cmd2 = "./oren build " + shell_quote(file2) + " --backend c -o " + shell_quote(out2) + gc_arg
        var build_rc2 = run_shell_capture(timeout_bin, build_timeout, build_cmd2, log2)
        if build_rc2 != 0 || file_exists(out2) != true {
            oren_list_push(m_failed, {"name": file2, "log": log2})
            mi = mi + 1
            continue
        }

        var run_cmd2 = "./" + out2
        var run_rc2 = run_shell_capture(timeout_bin, run_timeout, run_cmd2, log2)
        oren_system("rm -f " + shell_quote(out2))
        if run_rc2 != 0 {
            oren_list_push(m_failed, {"name": file2, "log": log2})
            mi = mi + 1
            continue
        }

        m_pass = m_pass + 1
        mi = mi + 1
    }

    // --- AVM tests (bytecode backend + ./avm) ---
    var a_pass = 0
    var a_total = oren_list_len(avm_tests)
    var a_failed = []

    var ai = 0
    while ai < a_total {
        var file3 = avm_tests[ai]
        var name3 = strip_suffix(basename(file3), ".oren")
        var out3 = "build/" + name3 + ".obc"
        var log3 = "build/logs/avm_" + name3 + ".log"

        var build_cmd3 = "./oren build " + shell_quote(file3) + " --backend bytecode -o " + shell_quote(out3) + gc_arg
        var build_rc3 = run_shell_capture(timeout_bin, build_timeout, build_cmd3, log3)
        if build_rc3 != 0 || file_exists(out3) != true {
            oren_list_push(a_failed, {"name": file3, "log": log3})
            ai = ai + 1
            continue
        }

        // Test-specific run modes (ported from Makefile’s curated AVM runner).
        var run_rc3 = 0
        if name3 == "test_multiverse_vfs_inherit" {
            // Build nested-universe fixtures (bytecode programs consumed as data by the test).
            var fx1 = "build/multiverse_grandchild_read_x.obc"
            var fx1_cmd = "./oren build " + shell_quote("tests/avm/fixtures/multiverse_grandchild_read_x.oren") + " --backend bytecode -o " + shell_quote(fx1) + gc_arg
            var fx1_rc = run_shell_capture(timeout_bin, build_timeout, fx1_cmd, log3)
            if fx1_rc != 0 || file_exists(fx1) != true { run_rc3 = 1 }

            var fx2 = "build/multiverse_child_vfs_inherit.obc"
            var fx2_cmd = "./oren build " + shell_quote("tests/avm/fixtures/multiverse_child_vfs_inherit.oren") + " --backend bytecode -o " + shell_quote(fx2) + gc_arg
            var fx2_rc = 0
            if run_rc3 == 0 { fx2_rc = run_shell_capture(timeout_bin, build_timeout, fx2_cmd, log3) }
            if run_rc3 == 0 && (fx2_rc != 0 || file_exists(fx2) != true) { run_rc3 = 1 }

            var fx3 = "build/multiverse_child_host_fs_prefix_probe.obc"
            var fx3_cmd = "./oren build " + shell_quote("tests/avm/fixtures/multiverse_child_host_fs_prefix_probe.oren") + " --backend bytecode -o " + shell_quote(fx3) + gc_arg
            var fx3_rc = 0
            if run_rc3 == 0 { fx3_rc = run_shell_capture(timeout_bin, build_timeout, fx3_cmd, log3) }
            if run_rc3 == 0 && (fx3_rc != 0 || file_exists(fx3) != true) { run_rc3 = 1 }

            if run_rc3 == 0 {
                // This test requires the top-level VM to have a restrictive FS allowlist so we can validate
                // hierarchical propagation to nested universes.
                run_rc3 = run_shell_capture(timeout_bin, run_timeout, "./avm --fs-allow-prefixes \"build/\" " + shell_quote(out3), log3)
            }

            oren_system("rm -f build/multiverse_grandchild_read_x.obc build/multiverse_child_vfs_inherit.obc build/multiverse_child_host_fs_prefix_probe.obc")
        } else {
        if name3 == "test_policy_scan" {
            oren_system("rm -f build/avm_policy_scan_should_not_write.txt build/avm_policy_scan_should_not_write2.txt")
            run_rc3 = run_shell_capture(timeout_bin, run_timeout, "./avm --print-policy " + shell_quote(out3), log3)
            if file_exists("build/avm_policy_scan_should_not_write.txt") || file_exists("build/avm_policy_scan_should_not_write2.txt") {
                run_rc3 = 1
            }
        } else {
            if name3 == "test_job_scan" {
                oren_system("rm -f build/avm_job_scan_should_not_write.txt build/avm_job_scan_should_not_write2.txt")
                run_rc3 = run_shell_capture(timeout_bin, run_timeout, "./avm --print-job " + shell_quote(out3), log3)
                if file_exists("build/avm_job_scan_should_not_write.txt") || file_exists("build/avm_job_scan_should_not_write2.txt") {
                    run_rc3 = 1
                }
            } else {
                if name3 == "test_snapshot_resume" {
                    var snap = "build/" + name3 + ".avms"
                    oren_system("rm -f " + shell_quote(snap))
                    // Expect pause exit code 2 (paused).
                    run_rc3 = normalize_rc(oren_system("sh -c " + shell_quote(timeout_bin + " " + oren_int_to_string(run_timeout) + " ./avm --step-limit 2000 --print-pause-json --snapshot-out " + shell_quote(snap) + " " + shell_quote(out3) + " > " + shell_quote(log3) + " 2>&1")))
                    if run_rc3 == 2 {
                        run_rc3 = run_shell_capture(timeout_bin, run_timeout, "./avm --snapshot-in " + shell_quote(snap) + " " + shell_quote(out3), log3)
                    } else {
                        run_rc3 = 1
                    }
                    oren_system("rm -f " + shell_quote(snap))
                } else {
                    if name3 == "test_budget_gas" {
                        run_rc3 = normalize_rc(oren_system("sh -c " + shell_quote("AVM_GAS=20000 " + timeout_bin + " " + oren_int_to_string(run_timeout) + " ./avm " + shell_quote(out3) + " > " + shell_quote(log3) + " 2>&1")))
                        // Expected: AVM exits non-zero due to internal gas budget.
                        // Unexpected: success (0) or external wall-time timeout (124).
                        if run_rc3 == 0 || run_rc3 == 124 {
                            run_rc3 = 1
                        } else {
                            run_rc3 = 0
                        }
                    } else {
                        if name3 == "test_call_depth_limit" {
                            run_rc3 = normalize_rc(oren_system("sh -c " + shell_quote(timeout_bin + " " + oren_int_to_string(run_timeout) + " ./avm --call-depth-max 32 " + shell_quote(out3) + " > " + shell_quote(log3) + " 2>&1")))
                            // Expected: AVM exits non-zero due to call depth limit.
                            // Unexpected: success (0) or external wall-time timeout (124).
                            if run_rc3 == 0 || run_rc3 == 124 {
                                run_rc3 = 1
                            } else {
                                run_rc3 = 0
                            }
                        } else {
                        if name3 == "test_budget_timeout" {
                            run_rc3 = normalize_rc(oren_system("sh -c " + shell_quote(timeout_bin + " " + oren_int_to_string(run_timeout) + " ./avm --timeout-ms 10 " + shell_quote(out3) + " > " + shell_quote(log3) + " 2>&1")))
                            // Expected: AVM exits non-zero due to internal deadline.
                            // Unexpected: success (0) or external wall-time timeout (124).
                            if run_rc3 == 0 || run_rc3 == 124 {
                                run_rc3 = 1
                            } else {
                                run_rc3 = 0
                            }
                        } else {
                            if name3 == "test_fs_mounts_host_backend" {
                                // AVM host FS mounts: explicit virtual->host enrollment, aligned with native mounts.
                                oren_system("rm -rf build/mnt_avm && mkdir -p build/mnt_avm")
                                oren_system("rm -f build/avm_mount_deny.txt build/mnt_avm/out.txt")
                                run_rc3 = run_shell_capture(timeout_bin, run_timeout, "./avm --deny-by-default --allow-domains \"0,1,6\" --fs-backend host --fs-mounts-read \"v/=build/mnt_avm/\" --fs-mounts-write \"v/=build/mnt_avm/\" " + shell_quote(out3), log3)
                                oren_system("rm -rf build/mnt_avm")
                                oren_system("rm -f build/avm_mount_deny.txt")
                            } else {
                            if name3 == "test_vfs_no_host_fs" {
                                oren_system("rm -f build/avm_vfs_should_not_write.bin")
                                run_rc3 = run_shell_capture(timeout_bin, run_timeout, "./avm --deny-by-default --allow-domains \"0,1,6\" --fs-allow-prefixes \"build/\" --fs-backend vfs " + shell_quote(out3), log3)
                                if file_exists("build/avm_vfs_should_not_write.bin") { run_rc3 = 1 }
                            } else {
                                if name3 == "test_oren_env_bridge_capsule" {
                                    // AVM must accept Oren-native capsule env when running as a subprocess.
                                    oren_system("rm -f build/avm_oren_bridge_should_not_write.txt")
                                    run_rc3 = run_shell_capture(timeout_bin, run_timeout, "OREN_CAPSULE=1 ./avm " + shell_quote(out3), log3)
                                    if file_exists("build/avm_oren_bridge_should_not_write.txt") { run_rc3 = 1 }
                                } else {
                                if name3 == "test_vproc_no_host_proc" {
                                    oren_system("rm -f build/avm_vproc_should_not_touch.txt")
                                    run_rc3 = run_shell_capture(timeout_bin, run_timeout, "./avm --deny-by-default --allow-domains \"0,5,6\" --proc-backend vproc --proc-exit-code 0 " + shell_quote(out3), log3)
                                    if file_exists("build/avm_vproc_should_not_touch.txt") { run_rc3 = 1 }
                                } else {
                                    if name3 == "test_vnet_no_host_net" {
                                        var hex = "41564d4e45543031010000000100000075020000006f6b"
                                        run_rc3 = run_shell_capture(timeout_bin, run_timeout, "./avm --deny-by-default --allow-domains \"0,4,6\" --net-backend vnet --net-fixtures-hex " + shell_quote(hex) + " " + shell_quote(out3), log3)
                                    } else {
                                        run_rc3 = run_shell_capture(timeout_bin, run_timeout, "./avm " + shell_quote(out3), log3)
                                    }
                                    }
                                }
                                }
                            }
                            }
                        }
                    }
                }
            }
        }
        }

        oren_system("rm -f " + shell_quote(out3))
        if run_rc3 != 0 {
            oren_list_push(a_failed, {"name": file3, "log": log3})
            ai = ai + 1
            continue
        }

        a_pass = a_pass + 1
        ai = ai + 1
    }

    print(oren_int_to_string(n_pass) + "/" + oren_int_to_string(n_total) + " native tests passed")
    print(oren_int_to_string(m_pass) + "/" + oren_int_to_string(m_total) + " module tests passed")
    print(oren_int_to_string(a_pass) + "/" + oren_int_to_string(a_total) + " avm tests passed")

    var any_fail = false
    if oren_list_len(n_failed) > 0 { any_fail = true }
    if oren_list_len(m_failed) > 0 { any_fail = true }
    if oren_list_len(a_failed) > 0 { any_fail = true }

    if any_fail {
        if oren_list_len(n_failed) > 0 {
            print("native failed:")
            var fi = 0
            while fi < oren_list_len(n_failed) {
                var f = n_failed[fi]
                print("  " + f["name"] + " (log: " + f["log"] + ")")
                oren_system("cat " + shell_quote(f["log"]))
                fi = fi + 1
            }
        }
        if oren_list_len(m_failed) > 0 {
            print("module failed:")
            var fi2 = 0
            while fi2 < oren_list_len(m_failed) {
                var f2 = m_failed[fi2]
                print("  " + f2["name"] + " (log: " + f2["log"] + ")")
                oren_system("cat " + shell_quote(f2["log"]))
                fi2 = fi2 + 1
            }
        }
        if oren_list_len(a_failed) > 0 {
            print("avm failed:")
            var fi3 = 0
            while fi3 < oren_list_len(a_failed) {
                var f3 = a_failed[fi3]
                print("  " + f3["name"] + " (log: " + f3["log"] + ")")
                oren_system("cat " + shell_quote(f3["log"]))
                fi3 = fi3 + 1
            }
        }
        oren_exit(1)
    }

    print("All Tests Passed.")
    return nil
}

fn dirname(path) {
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at(path, i) == "/" {
            if i == 0 { return "/" }
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

fn starts_with(s, prefix) {
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if oren_string_char_at(s, i) != oren_string_char_at(prefix, i) { return false }
        i = i + 1
    }
    return true
}

fn default_output_path(path) {
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at(path, i) == "." {
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return path // No extension?
}

// Module system globals
var MODULES = {}
var MODULE_STACK = []
var MODULE_ORDER = []
var MODULE_ID_COUNTER = 0

// Attribute validation knobs (plumbed into the parser).
// Defaults keep rolling mode permissive.
var STRICT_ATTRS = false
var ATTR_ALLOW_PREFIXES = []
var CAPSULE = false
var CAP_ALLOW_DOMAINS = []

fn split_csv(s) {
    var out = []
    if s == nil { return out }
    if s == "" { return out }
    var cur = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        if ch == "," {
            if cur != "" { oren_list_push(out, cur) }
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    if cur != "" { oren_list_push(out, cur) }
    return out
}

fn new_module_prefix() {
    MODULE_ID_COUNTER = MODULE_ID_COUNTER + 1
    return "M" + oren_int_to_string(MODULE_ID_COUNTER) + "_"
}

fn resolve_path(base, path) {
    if oren_string_char_at(path, 0) == "/" { return path }
    return base + "/" + path
}

fn load_module(base, path) {
    var full = resolve_path(base, path)
    if MODULES[full] != nil {
        return MODULES[full]
    }
    
    // Cycle check
    var k = 0
    while k < oren_list_len(MODULE_STACK) {
        if MODULE_STACK[k] == full {
            print("Cyclic import detected: " + full)
            oren_exit(1)
        }
        k = k + 1
    }
    oren_list_push(MODULE_STACK, full)

    var src = oren_read_file(full)
    if oren_is_err(src) {
        print("Failed to read file: " + full)
        var msg = oren_err_msg(src)
        if msg != nil { print(msg) }
        oren_exit(1)
    }
    var l = lexer.new_lexer(src)
    var p = parser.new_parser(l)
    p["strict_attrs"] = STRICT_ATTRS
    p["attr_allow_prefixes"] = ATTR_ALLOW_PREFIXES
    var prog = parser.parse_program(p)
    
    if oren_list_len(p["errors"]) > 0 {
        print("Parse errors in " + full + ":")
        var i = 0
        while i < oren_list_len(p["errors"]) {
            print(p["errors"][i])
            i = i + 1
        }
        oren_exit(1)
    }

    var mod = {"prefix": new_module_prefix(), "path": full, "program": prog, "aliases": {}, "added": false}
    MODULES[full] = mod

    var dir = dirname(full)
    var i = 0
    while i < oren_list_len(prog["statements"]) {
        var s = prog["statements"][i]
        if s["type"] == "Import" {
            var alias = s["name"]["value"]
            if mod["aliases"][alias] != nil {
                print("Duplicate import alias: " + alias + " in " + full)
                oren_exit(1)
            }
            var dep = load_module(dir, s["path"])
            mod["aliases"][alias] = dep["prefix"]
        }
        i = i + 1
    }

    // Rename pass would be here, but we need to move rename logic to a module too?
    // For now let's assume we copy `collect_toplevel_rename_pairs` etc.
    // Or better, put them in `analysis.oren` or a new `modules.oren`.
    // Let's put module logic in `compiler.oren` for now as it orchestrates loading.
    
    var pairs = renamer.collect_toplevel_rename_pairs(prog, mod["prefix"])
    i = 0
    while i < oren_list_len(prog["statements"]) {
        var s2 = prog["statements"][i]
        if s2["type"] == "Import" {
            var alias2 = s2["name"]["value"]
            if renamer.rename_lookup(pairs, alias2) != "" {
                print("Import alias conflicts with top-level name: " + alias2 + " in " + full)
                oren_exit(1)
            }
        }
        i = i + 1
    }
    renamer.rename_program_in_place(prog, pairs)

    if mod["added"] != true {
        mod["added"] = true
        oren_list_push(MODULE_ORDER, mod)
    }

    // list_pop not in runtime?
    // We need to implement list_pop or use slice.
    // var new_stack = [] ...
    // Actually runtime has no list_pop.
    // Let's just remove last element manually?
    // Oren doesn't have `pop`.
    // We can slice.
    // MODULE_STACK = oren_list_slice(MODULE_STACK, 0, oren_list_len(MODULE_STACK) - 1)
    // Assuming we implement list_pop helper
    
    return mod
}

fn link_program(entry_path, root_prog) {
    MODULES = {}
    MODULE_STACK = []
    MODULE_ORDER = []
    MODULE_ID_COUNTER = 0
    
    var base = dirname(entry_path)
    var root_aliases = {}
    
    var i = 0
    while i < oren_list_len(root_prog["statements"]) {
        var s = root_prog["statements"][i]
        if s["type"] == "Import" {
            var alias = s["name"]["value"]
            var mod = load_module(base, s["path"])
            root_aliases[alias] = mod["prefix"]
        }
        i = i + 1
    }
    
    var merged_stmts = []
    var type_ns = {}
    var field_offsets = {}
    
    i = 0
    while i < oren_list_len(MODULE_ORDER) {
        var mod = MODULE_ORDER[i]
        var stmts = mod["program"]["statements"]
        var j = 0
        while j < oren_list_len(stmts) {
            var st = stmts[j]
            if st["type"] == "Type" {
                type_ns[st["name"]["value"]] = true
                var fi = 0
                while fi < oren_list_len(st["fields"]) {
                    var fname = st["fields"][fi]["value"]
                    if field_offsets[fname] == nil {
                        field_offsets[fname] = fi
                    } else {
                        if field_offsets[fname] != fi {
                            print("Inconsistent field offset for '" + fname + "'")
                            oren_exit(1)
                        }
                    }
                    fi = fi + 1
                }
            }
            if st["type"] != "Import" {
                oren_list_push(merged_stmts, st)
            }
            j = j + 1
        }
        i = i + 1
    }
    
    i = 0
    while i < oren_list_len(root_prog["statements"]) {
        var st = root_prog["statements"][i]
        if st["type"] == "Type" {
            type_ns[st["name"]["value"]] = true
            var fi2 = 0
            while fi2 < oren_list_len(st["fields"]) {
                var fname2 = st["fields"][fi2]["value"]
                if field_offsets[fname2] == nil {
                    field_offsets[fname2] = fi2
                } else {
                    if field_offsets[fname2] != fi2 {
                        print("Inconsistent field offset for '" + fname2 + "'")
                        oren_exit(1)
                    }
                }
                fi2 = fi2 + 1
            }
        }
        if st["type"] != "Import" {
            oren_list_push(merged_stmts, st)
        }
        i = i + 1
    }
    
    var linked = {"statements": merged_stmts, "aliases": root_aliases, "type_ns": type_ns, "field_offsets": field_offsets}

    // Compile-time lowering: packed struct views over bytes.
    packview.lower_linked_program_in_place(linked)

    return linked
}

fn compiler_main() {
    var args = oren_args()
    var argc = oren_list_len(args)
    if argc < 2 { usage(); return nil }

    // Global help (works for all subcommands).
    var hi = 1
    while hi < argc {
        if args[hi] == "--help" || args[hi] == "-h" {
            usage()
            return nil
        }
        hi = hi + 1
    }

    var mode = "build"
    var i = 1
    if args[i] == "build" { mode = "build"; i = i + 1 }
    else {
        if args[i] == "test" { mode = "test"; i = i + 1 }
        else {
            if args[i] == "emit-c" { mode = "emit-c"; i = i + 1 }
            else {
                if args[i] == "scan" { mode = "scan"; i = i + 1 }
                else {
                    if args[i] == "--emit-c" { mode = "emit-c"; i = i + 1 }
                }
            }
        }
    }

    var dbg_args = oren_env("OREN_DEBUG_ARGS")
    if dbg_args != nil {
        var di = 0
        while di < oren_list_len(args) {
            print("ARG[" + oren_int_to_string(di) + "] = " + args[di])
            di = di + 1
        }
    }

    if mode == "scan" {
        if i >= argc { print("Usage: oren scan <lib>"); return nil }
        var lib = args[i]
        var nm_out = "scan_tmp.txt"
        // macOS: nm -gU. Linux: nm -gD?
        var cmd = "nm -gU " + shell_quote(lib) + " > " + nm_out
        if oren_system(cmd) != 0 {
            print("Scan failed (nm not found or lib invalid?)")
            return nil
        }
        var content = oren_read_file(nm_out)
        if oren_is_err(content) {
            print("Scan failed (cannot read nm output): " + nm_out)
            var msg = oren_err_msg(content)
            if msg != nil { print(msg) }
            return nil
        }
        var len = oren_string_len(content)
        var idx = 0
        
        print("# API Documentation for " + lib)
        print("")
        print("| Symbol | Address | Type |")
        print("|---|---|---|")
        
        // Parse lines: address T symbol
        var line_start = 0
        while idx < len {
            if oren_string_char_at(content, idx) == "\n" {
                var line = oren_string_slice(content, line_start, idx)
                // Parse line
                // Format: "0000000000003f50 T _my_api_func"
                // Check if contains " T "
                // Simple search
                var t_idx = -1
                var k = 0
                var l_len = oren_string_len(line)
                while k < l_len - 3 {
                    if oren_string_char_at(line, k) == " " {
                        if oren_string_char_at(line, k+1) == "T" {
                            if oren_string_char_at(line, k+2) == " " {
                                t_idx = k
                                k = l_len // break
                            }
                        }
                    }
                    k = k + 1
                }
                
                if t_idx != -1 {
                    var addr = oren_string_slice(line, 0, t_idx)
                    var sym = oren_string_slice(line, t_idx + 3, l_len)
                    // Trim CR if any
                    // macOS symbols have _ prefix.
                    if oren_string_char_at(sym, 0) == "_" {
                        sym = oren_string_slice(sym, 1, oren_string_len(sym))
                    }
                    print("| " + sym + " | " + addr + " | Function |")
                }
                
                line_start = idx + 1
            }
            idx = idx + 1
        }
        
        oren_system("rm " + nm_out)
        return nil
    }

    // Repo-wide test runner: `oren test` (no file argument), or `oren test --flags`.
    // If the next token begins with '-', treat it as a repo-runner flag (not a file path).
    if mode == "test" && (i >= argc || starts_with(args[i], "-")) {
        // Parse just the minimal flags needed for repo tests.
        var target2 = "macos"
        var no_gc2 = false

        // Env toggle (kept consistent with build path).
        var env_no_gc = oren_env("OREN_NO_GC")
        if env_no_gc != nil { no_gc2 = true }

        while i < argc {
            if args[i] == "--target" {
                if i + 1 >= argc { print("Missing value for --target"); return nil }
                target2 = args[i + 1]
                i = i + 2
            } else {
                if args[i] == "--no-gc" {
                    no_gc2 = true
                    i = i + 1
                } else {
                    if args[i] == "--help" || args[i] == "-h" {
                        usage()
                        return nil
                    } else {
                    print("Unknown arg for repo test runner: " + args[i])
                    return nil
                    }
                }
            }
        }
        return run_repo_tests(target2, no_gc2)
    }

    if i >= argc { usage(); return nil }
    var path = args[i]
    i = i + 1
    var out_path = default_output_path(path)
    var emit_c = false
    var enable_python = false
    var cc = "cc"
    var backend = "c"
    var target = "macos"
    var disasm = false
    var analyze = false
    var codesign_id = ""
    var notarize = false
    var notary_profile = ""
    var no_gc = false
    var emit_meta = false
    var is_shared_lib = false
    // Rolling mode: default native builds to embed debug info so panics produce readable stack traces.
    // Users can still disable by explicitly setting OREN_NATIVE_NO_DEBUG=1 (kept as an env knob so we
    // don't need to introduce a new CLI flag yet).
    var debug_mode = false
    var link_libs = []
    if target == "macos" { codesign_id = "Developer ID Application: Zongbao Lu (US56HHF2Y4)" }
    if mode == "emit-c" { emit_c = true }
    var env_no_gc = oren_env("OREN_NO_GC")
    if env_no_gc != nil { no_gc = true }
    var env_native_no_debug = oren_env("OREN_NATIVE_NO_DEBUG")
    if env_native_no_debug != nil { debug_mode = false }
    var env_strict_attrs = oren_env("OREN_STRICT_ATTRS")
    if env_strict_attrs != nil { STRICT_ATTRS = true }
    var env_attr_allow = oren_env("OREN_ATTR_ALLOW_PREFIXES")
    if env_attr_allow != nil { ATTR_ALLOW_PREFIXES = split_csv(env_attr_allow) }
    var env_capsule = oren_env("OREN_CAPSULE")
    if env_capsule != nil { CAPSULE = true }
    var env_cap_domains = oren_env("OREN_CAP_ALLOW_DOMAINS")
    if env_cap_domains != nil { CAP_ALLOW_DOMAINS = split_csv(env_cap_domains) }

    while i < argc {
        if args[i] == "--emit-c" {
            emit_c = true
            i = i + 1
        } else {
            if args[i] == "--debug" {
                debug_mode = true
                i = i + 1
            } else {
                if args[i] == "--lib" || args[i] == "--shared" {
                    is_shared_lib = true
                    i = i + 1
                } else {
                    if args[i] == "--analyze" {
                        analyze = true
                        i = i + 1
                    } else {
                        if args[i] == "--metadata" {
                            emit_meta = true
                            i = i + 1
                        } else {
                            if args[i] == "--strict-attrs" {
                                STRICT_ATTRS = true
                                i = i + 1
                            } else {
                                if args[i] == "--attr-allow-prefixes" {
                                    if i + 1 >= argc { print("Missing value for --attr-allow-prefixes"); return nil }
                                    ATTR_ALLOW_PREFIXES = split_csv(args[i + 1])
                                    i = i + 2
                                } else {
                            if args[i] == "--capsule" {
                                CAPSULE = true
                                i = i + 1
                            } else {
                                if args[i] == "--cap-allow-domains" {
                                    if i + 1 >= argc { print("Missing value for --cap-allow-domains"); return nil }
                                    CAP_ALLOW_DOMAINS = split_csv(args[i + 1])
                                    i = i + 2
                                } else {
                            if args[i] == "--python" {
                                enable_python = true
                                i = i + 1
                            } else {
                                if args[i] == "--link" || args[i] == "-l" {
                                    if i + 1 >= argc { print("Missing value for --link"); return nil }
                                    oren_list_push(link_libs, args[i + 1])
                                    i = i + 2
                                } else {
                                    if args[i] == "--backend" {
                                        if i + 1 >= argc { print("Missing value for --backend"); return nil }
                                        backend = args[i + 1]
                                        i = i + 2
                                    } else {
                                        if args[i] == "--target" {
                                            if i + 1 >= argc { print("Missing value for --target"); return nil }
                                            target = args[i + 1]
                                            i = i + 2
                                        } else {
                                    if args[i] == "--disasm" {
                                        disasm = true
                                        i = i + 1
                                    } else {
                                                if args[i] == "--cc" {
                                                    if i + 1 >= argc { print("Missing value for --cc"); return nil }
                                                    cc = args[i + 1]
                                                    i = i + 2
                                                } else {
                                                    if args[i] == "-o" {
                                                        if i + 1 >= argc { print("Missing value for -o"); return nil }
                                                        out_path = args[i + 1]
                                                        i = i + 2
                                                    } else {
                                                        if args[i] == "--codesign" {
                                                            if i + 1 >= argc { print("Missing value for --codesign"); return nil }
                                                            codesign_id = args[i + 1]
                                                            i = i + 2
                                                        } else {
                                                            if args[i] == "--notarize" {
                                                                notarize = true
                                                                i = i + 1
                                                            } else {
                                                                if args[i] == "--notary-profile" {
                                                                    if i + 1 >= argc { print("Missing value for --notary-profile"); return nil }
                                                                    notary_profile = args[i + 1]
                                                                    i = i + 2
                                                                } else {
                                                                    if args[i] == "--no-gc" {
                                                                        no_gc = true
                                                                        i = i + 1
                                                                    } else {
                                                                        print("Unknown arg: " + args[i])
                                                                        return nil
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                                }
                            }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // If user did not explicitly request debug info, default it on for native backend builds.
    // This makes runtime panics actionable by default (stack traces map to function names).
    if backend == "native" {
        if debug_mode == false {
            if env_native_no_debug == nil {
                debug_mode = true
            }
        }
    }

    if backend != "c" && backend != "native" && backend != "bytecode" {
        print("Unknown backend: " + backend)
        return nil
    }

    var src = oren_read_file(path)
    if oren_is_err(src) {
        print("Failed to read file: " + path)
        var msg = oren_err_msg(src)
        if msg != nil { print(msg) }
        return nil
    }
    var l = lexer.new_lexer(src)
    var p = parser.new_parser(l)
    p["strict_attrs"] = STRICT_ATTRS
    p["attr_allow_prefixes"] = ATTR_ALLOW_PREFIXES
    var prog = parser.parse_program(p)
    if oren_list_len(p["errors"]) > 0 {
        print("Parse errors:")
        var i = 0
        while i < oren_list_len(p["errors"]) {
            print(p["errors"][i])
            i = i + 1
        }
        oren_exit(1)
    }
    
    if analyze {
        analysis.analyze_program(prog)
        return nil
    }

    if mode == "test" {
        if backend != "native" {
            print("Test runner currently supports --backend native only.")
            return nil
        }
        
        var tests = []
        var stmts = prog["statements"]
        var si = 0
        while si < oren_list_len(stmts) {
            var s = stmts[si]
            var fn_node = nil
            if s["type"] == "Function" { fn_node = s }
            if s["type"] == "ExprStmt" {
                var expr = s["expr"]
                if expr != nil {
                    if expr["type"] == "Function" { fn_node = expr }
                }
            }
            if fn_node != nil {
                var name_node = fn_node["name"]
                if name_node != nil {
                    var name = name_node
                    if starts_with(name, "test_") {
                        oren_list_push(tests, name)
                    }
                }
            }
            si = si + 1
        }
        
        var main_stmts = []
        var print_tok = {"literal": "print"}
        var print_id = ast.new_identifier(print_tok)
        
        var start_tok = {"literal": "Running tests..."}
        var start_call = ast.new_call(nil, print_id, [ast.new_string(start_tok)])
        oren_list_push(main_stmts, ast.new_expr_stmt(nil, start_call))
        
        var ti = 0
        while ti < oren_list_len(tests) {
            var tname = tests[ti]
            var t_tok = {"literal": tname}
            var t_call = ast.new_call(nil, ast.new_identifier(t_tok), [])
            oren_list_push(main_stmts, ast.new_expr_stmt(nil, t_call))
            
            var msg = "PASS: " + tname
            var msg_tok = {"literal": msg}
            var msg_call = ast.new_call(nil, print_id, [ast.new_string(msg_tok)])
            oren_list_push(main_stmts, ast.new_expr_stmt(nil, msg_call))
            
            ti = ti + 1
        }
        
        var end_tok = {"literal": "All tests passed."}
        var end_call = ast.new_call(nil, print_id, [ast.new_string(end_tok)])
        oren_list_push(main_stmts, ast.new_expr_stmt(nil, end_call))
        
        var main_fn = ast.new_function(nil, "main", [], ast.new_block(nil))
        main_fn["body"]["stmts"] = main_stmts
        oren_list_push(prog["statements"], ast.new_expr_stmt(nil, main_fn))
        
        var linked = link_program(path, prog)
        var out_test = path + ".test"

        if target == "linux" {
            // Always embed native debug info for `oren test` so panics produce readable stack traces.
            arm64_elf.elf_emit_program_arm64(out_test, linked, [], false, [], true, no_gc, false, [])
        } else {
            // Always embed native debug info for `oren test` so panics produce readable stack traces.
            arm64_macho.macho_emit_program_arm64(out_test, linked, [], false, [], true, no_gc, false, [])
        }
        
        if target == "macos" {
             var cs_cmd = "codesign -s - --force " + shell_quote(out_test)
             oren_system(cs_cmd)
        }
        
        print("Executing tests...")
        var res = oren_system("./" + out_test)
        oren_system("rm " + out_test)
        if res != 0 {
            print("Tests FAILED.")
            oren_exit(1)
        }
        return nil
    }

    if backend == "bytecode" {
        var linked_bc = link_program(path, prog)
        var ctx = codegen_bytecode.bytecode_compile_program(linked_bc)

        // Rolling: embed metadata into the `.obc` constant pool as a BYTES constant so:
        // - tooling can discover attrs/types/fields without a sidecar file
        // - execution semantics remain unchanged (metadata is not referenced by code)
        //
        // Format (rolling, v0):
        //   bytes = "OREN_META\n1\n" + <meta_json_utf8_bytes>
        var meta_json = metadata.generate_metadata(linked_bc)
        var hdr = oren_bytes_from_string("OREN_META\n1\n")
        var payload = oren_bytes_from_string(meta_json)
        var meta_bytes = []
        var hi = 0
        while hi < oren_list_len(hdr) {
            oren_list_push(meta_bytes, hdr[hi])
            hi = hi + 1
        }
        var pi = 0
        while pi < oren_list_len(payload) {
            oren_list_push(meta_bytes, payload[pi])
            pi = pi + 1
        }
        ctx["meta_bytes"] = meta_bytes

        codegen_bytecode.bytecode_emit_program(out_path, ctx)
        print("Bytecode emitted: " + out_path)
        return nil
    }

    if backend == "native" {
        if emit_c {
            print("--emit-c is only supported with --backend c")
            return nil
        }

        var linked = link_program(path, prog)
        var export_names = []
        
        if is_shared_lib {
            var header_path = default_output_path(out_path) + ".h"
            var h_content = "#ifndef OREN_LIB_H\n#define OREN_LIB_H\n\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
            var stmts = linked["statements"]
            var si = 0
            while si < oren_list_len(stmts) {
                var s = stmts[si]
                var fn_node = nil
                
                if s["type"] == "Function" {
                    fn_node = s
                }
                if s["type"] == "ExprStmt" {
                    var expr = s["expr"]
                    if expr != nil {
                        if expr["type"] == "Function" {
                            fn_node = expr
                        }
                    }
                }
                
                if fn_node != nil {
                    var fn_name = fn_node["name"]
                    // print("DEBUG: fn_name = " + fn_name)
                    if fn_name != nil {
                        if fn_name != "main" && fn_name != "__top_level__" {
                            oren_list_push(export_names, fn_name)
                            var params = fn_node["params"]
                            var p_count = oren_list_len(params)
                            h_content = h_content + "extern int64_t " + fn_name + "("
                            var pi = 0
                            while pi < p_count {
                                if pi > 0 { h_content = h_content + ", " }
                                h_content = h_content + "int64_t arg" + oren_int_to_string(pi)
                                pi = pi + 1
                            }
                            if p_count == 0 { h_content = h_content + "void" }
                            h_content = h_content + ");\n"
                        }
                    }
                }
                si = si + 1
            }
            h_content = h_content + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"
            var w = oren_write_file(header_path, h_content)
            if oren_is_err(w) {
                print("Failed to write header: " + header_path)
                var msg = oren_err_msg(w)
                if msg != nil { print(msg) }
                oren_exit(1)
            }
            print("Wrote header: " + header_path)
        }
        
        if emit_meta {
            var meta_json = metadata.generate_metadata(linked)
            var meta_path = out_path + ".meta.json"
            var w2 = oren_write_file(meta_path, meta_json)
            if oren_is_err(w2) {
                print("Failed to write metadata: " + meta_path)
                var msg2 = oren_err_msg(w2)
                if msg2 != nil { print(msg2) }
                oren_exit(1)
            }
            print("Wrote metadata: " + meta_path)
        }

        if target == "linux" {
            arm64_elf.elf_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, CAPSULE, CAP_ALLOW_DOMAINS)
        } else {
            arm64_macho.macho_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, CAPSULE, CAP_ALLOW_DOMAINS)
        }

        if target == "macos" {
            if codesign_id != "" {
                var cs_cmd = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
                var cs_res = oren_system(cs_cmd)
                if cs_res != 0 {
                    print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                    var ad_cmd = "codesign -s - --force " + shell_quote(out_path)
                    var ad_res = oren_system(ad_cmd)
                    if ad_res != 0 {
                        print("codesign fallback failed")
                        oren_exit(1)
                    }
                }
            }
        }
        
        print("Build successful: " + out_path)
        
        if disasm {
            if target == "macos" {
                oren_system("otool -tV " + shell_quote(out_path))
            } else {
                oren_system("objdump -d " + shell_quote(out_path))
            }
        }
        return nil
    }

    // For C backend, we also need to load modules to populate MODULE_ORDER
    var linked_c = link_program(path, prog)
    var c_code = transpiler.transpile_entry(path, prog, MODULE_ORDER, linked_c["aliases"])
    var c_path = path + ".c"
    var w3 = oren_write_file(c_path, c_code)
    if oren_is_err(w3) {
        print("Failed to write C output: " + c_path)
        var msg3 = oren_err_msg(w3)
        if msg3 != nil { print(msg3) }
        oren_exit(1)
    }
    if emit_c {
        print("Wrote " + c_path)
        return nil
    }

    var cmd = cc + " -o " + shell_quote(out_path) + " " + shell_quote(c_path) + " lib/runtime.c -Ilib -pthread"
    var k_lib = 0
    while k_lib < oren_list_len(link_libs) {
        cmd = cmd + " " + shell_quote(link_libs[k_lib])
        k_lib = k_lib + 1
    }
    if no_gc { cmd = cmd + " -DOREN_NO_GC" }
    if enable_python {
        cmd = cmd + " -DOREN_ENABLE_PYTHON $(python3-config --cflags) $(python3-config --embed --ldflags)"
    }
    var res = oren_system(cmd)
    if res != 0 {
        print("Build failed")
        oren_exit(1)
    }
        if target == "macos" {
            if codesign_id != "" {
                var cs_cmd2 = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
                var cs_res2 = oren_system(cs_cmd2)
                if cs_res2 != 0 {
                print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                var ad_cmd2 = "codesign -s - --force " + shell_quote(out_path)
                var ad_res2 = oren_system(ad_cmd2)
                if ad_res2 != 0 {
                    print("codesign fallback failed")
                    oren_exit(1)
                }
            }
        }
    }
    if target == "macos" && notarize {
        var nt_cmd = ""
        if notary_profile != "" {
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --keychain-profile " + shell_quote(notary_profile) + " --wait"
        } else {
            var apple_id = oren_env("APPLE_ID")
            var apple_pass = oren_env("APPLE_ID_PASS")
            var apple_team = oren_env("APPLE_TEAM_ID")
            if apple_id == nil || apple_pass == nil || apple_team == nil {
                print("Notarization requested but APPLE_ID/APPLE_ID_PASS/APPLE_TEAM_ID or --notary-profile not set")
                oren_exit(1)
            }
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --apple-id " + shell_quote(apple_id) + " --password " + shell_quote(apple_pass) + " --team-id " + shell_quote(apple_team) + " --wait"
        }
        var nt_res = oren_system(nt_cmd)
        if nt_res != 0 {
            print("notarization failed")
            oren_exit(1)
        }
        var staple_cmd = "xcrun stapler staple " + shell_quote(out_path)
        var staple_res = oren_system(staple_cmd)
        if staple_res != 0 {
            print("staple failed")
            oren_exit(1)
        }
    }
    print("Build successful: " + out_path)
    return nil
}
