import codegen "codegen_arm64.oren"
import codegen_bytecode "codegen_bytecode.oren"
import transpiler "transpiler.oren"
import analysis "analysis.oren"
import lexer "lexer.oren"
import parser "parser.oren"
import ast "ast.oren"
import metadata "metadata.oren"

fn usage() {
    print("Usage:")
    print("  oren <file.oren> [flags]               (alias for: oren build <file.oren>)")
    print("  oren build <file.oren> [flags]")
    print("  oren emit-c <file.oren>")
    print("  oren test <file.oren> [--target macos|linux]")
    print("  oren scan <lib.dylib>")
    print("")
    print("Flags:")
    print("  -o <path>                Output path (default: strip .oren)")
    print("  --backend c|native|bytecode")
    print("  --emit-c                 (C backend only) stop after generating <file.oren>.c")
    print("  --cc <cc>                (C backend) C compiler (default: cc)")
    print("  --target macos|linux      (native backend) target OS (default: macos)")
    print("  --disasm                  (native backend) disassemble output via otool/objdump")
    print("  --debug                   (native backend) embed debug info for stack traces")
    print("  --lib | --shared          (native backend) build a shared library")
    print("  --link <path> | -l <path> (native backend, macOS) add LC_LOAD_DYLIB")
    print("  --metadata                (native backend) write <out>.meta.json")
    print("  --analyze                 print analysis info and exit")
    print("  --python                  (C backend) enable Python integration (requires python3-config)")
    print("  --codesign <id>           (macOS) codesign output (default: configured Developer ID)")
    print("  --notarize                (macOS) notarize output with notarytool")
    print("  --notary-profile <name>   (macOS) notarytool keychain profile")
    print("  --no-gc                   disable GC scanning (also via env OREN_NO_GC=1)")
}

fn shell_quote(s) {
    return "'" + s + "'" // Minimal quoting
}

fn dirname(path) {
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at(path, i) == "/" {
            if i == 0 { return "/" }
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

fn starts_with(s, prefix) {
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if oren_string_char_at(s, i) != oren_string_char_at(prefix, i) { return false }
        i = i + 1
    }
    return true
}

fn default_output_path(path) {
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at(path, i) == "." {
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return path // No extension?
}

// Module system globals
var MODULES = {}
var MODULE_STACK = []
var MODULE_ORDER = []
var MODULE_ID_COUNTER = 0

fn new_module_prefix() {
    MODULE_ID_COUNTER = MODULE_ID_COUNTER + 1
    return "M" + oren_int_to_string(MODULE_ID_COUNTER) + "_"
}

fn resolve_path(base, path) {
    if oren_string_char_at(path, 0) == "/" { return path }
    return base + "/" + path
}

fn load_module(base, path) {
    var full = resolve_path(base, path)
    if MODULES[full] != nil {
        return MODULES[full]
    }
    
    // Cycle check
    var k = 0
    while k < oren_list_len(MODULE_STACK) {
        if MODULE_STACK[k] == full {
            print("Cyclic import detected: " + full)
            oren_exit(1)
        }
        k = k + 1
    }
    oren_list_push(MODULE_STACK, full)

    var src = oren_read_file(full)
    var l = lexer.new_lexer(src)
    var p = parser.new_parser(l)
    var prog = parser.parse_program(p)
    
    if oren_list_len(p["errors"]) > 0 {
        print("Parse errors in " + full + ":")
        var i = 0
        while i < oren_list_len(p["errors"]) {
            print(p["errors"][i])
            i = i + 1
        }
        oren_exit(1)
    }

    var mod = {"prefix": new_module_prefix(), "path": full, "program": prog, "aliases": {}, "added": false}
    MODULES[full] = mod

    var dir = dirname(full)
    var i = 0
    while i < oren_list_len(prog["statements"]) {
        var s = prog["statements"][i]
        if s["type"] == "Import" {
            var alias = s["name"]["value"]
            if mod["aliases"][alias] != nil {
                print("Duplicate import alias: " + alias + " in " + full)
                oren_exit(1)
            }
            var dep = load_module(dir, s["path"])
            mod["aliases"][alias] = dep["prefix"]
        }
        i = i + 1
    }

    // Rename pass would be here, but we need to move rename logic to a module too?
    // For now let's assume we copy `collect_toplevel_rename_pairs` etc.
    // Or better, put them in `analysis.oren` or a new `modules.oren`.
    // Let's put module logic in `compiler.oren` for now as it orchestrates loading.
    
    var pairs = codegen.collect_toplevel_rename_pairs(prog, mod["prefix"])
    i = 0
    while i < oren_list_len(prog["statements"]) {
        var s2 = prog["statements"][i]
        if s2["type"] == "Import" {
            var alias2 = s2["name"]["value"]
            if codegen.rename_lookup(pairs, alias2) != "" {
                print("Import alias conflicts with top-level name: " + alias2 + " in " + full)
                oren_exit(1)
            }
        }
        i = i + 1
    }
    codegen.rename_program_in_place(prog, pairs)

    if mod["added"] != true {
        mod["added"] = true
        oren_list_push(MODULE_ORDER, mod)
    }

    // list_pop not in runtime?
    // We need to implement list_pop or use slice.
    // var new_stack = [] ...
    // Actually runtime has no list_pop.
    // Let's just remove last element manually?
    // Oren doesn't have `pop`.
    // We can slice.
    // MODULE_STACK = oren_list_slice(MODULE_STACK, 0, oren_list_len(MODULE_STACK) - 1)
    // Assuming we implement list_pop helper
    
    return mod
}

fn link_program(entry_path, root_prog) {
    MODULES = {}
    MODULE_STACK = []
    MODULE_ORDER = []
    MODULE_ID_COUNTER = 0
    
    var base = dirname(entry_path)
    var root_aliases = {}
    
    var i = 0
    while i < oren_list_len(root_prog["statements"]) {
        var s = root_prog["statements"][i]
        if s["type"] == "Import" {
            var alias = s["name"]["value"]
            var mod = load_module(base, s["path"])
            root_aliases[alias] = mod["prefix"]
        }
        i = i + 1
    }
    
    var merged_stmts = []
    var type_ns = {}
    var field_offsets = {}
    
    i = 0
    while i < oren_list_len(MODULE_ORDER) {
        var mod = MODULE_ORDER[i]
        var stmts = mod["program"]["statements"]
        var j = 0
        while j < oren_list_len(stmts) {
            var st = stmts[j]
            if st["type"] == "Type" {
                type_ns[st["name"]["value"]] = true
                var fi = 0
                while fi < oren_list_len(st["fields"]) {
                    var fname = st["fields"][fi]["value"]
                    if field_offsets[fname] == nil {
                        field_offsets[fname] = fi
                    } else {
                        if field_offsets[fname] != fi {
                            print("Inconsistent field offset for '" + fname + "'")
                            oren_exit(1)
                        }
                    }
                    fi = fi + 1
                }
            }
            if st["type"] != "Import" {
                oren_list_push(merged_stmts, st)
            }
            j = j + 1
        }
        i = i + 1
    }
    
    i = 0
    while i < oren_list_len(root_prog["statements"]) {
        var st = root_prog["statements"][i]
        if st["type"] == "Type" {
            type_ns[st["name"]["value"]] = true
            var fi2 = 0
            while fi2 < oren_list_len(st["fields"]) {
                var fname2 = st["fields"][fi2]["value"]
                if field_offsets[fname2] == nil {
                    field_offsets[fname2] = fi2
                } else {
                    if field_offsets[fname2] != fi2 {
                        print("Inconsistent field offset for '" + fname2 + "'")
                        oren_exit(1)
                    }
                }
                fi2 = fi2 + 1
            }
        }
        if st["type"] != "Import" {
            oren_list_push(merged_stmts, st)
        }
        i = i + 1
    }
    
    return {"statements": merged_stmts, "aliases": root_aliases, "type_ns": type_ns, "field_offsets": field_offsets}
}

fn compiler_main() {
    var args = oren_args()
    var argc = oren_list_len(args)
    if argc < 2 { usage(); return nil }

    var mode = "build"
    var i = 1
    if args[i] == "build" { mode = "build"; i = i + 1 }
    else {
        if args[i] == "test" { mode = "test"; i = i + 1 }
        else {
            if args[i] == "emit-c" { mode = "emit-c"; i = i + 1 }
            else {
                if args[i] == "scan" { mode = "scan"; i = i + 1 }
                else {
                    if args[i] == "--emit-c" { mode = "emit-c"; i = i + 1 }
                }
            }
        }
    }

    var dbg_args = oren_env("OREN_DEBUG_ARGS")
    if dbg_args != nil {
        var di = 0
        while di < oren_list_len(args) {
            print("ARG[" + oren_int_to_string(di) + "] = " + args[di])
            di = di + 1
        }
    }

    if mode == "scan" {
        if i >= argc { print("Usage: oren scan <lib>"); return nil }
        var lib = args[i]
        var nm_out = "scan_tmp.txt"
        // macOS: nm -gU. Linux: nm -gD?
        var cmd = "nm -gU " + shell_quote(lib) + " > " + nm_out
        if oren_system(cmd) != 0 {
            print("Scan failed (nm not found or lib invalid?)")
            return nil
        }
        var content = oren_read_file(nm_out)
        var len = oren_string_len(content)
        var idx = 0
        
        print("# API Documentation for " + lib)
        print("")
        print("| Symbol | Address | Type |")
        print("|---|---|---|")
        
        // Parse lines: address T symbol
        var line_start = 0
        while idx < len {
            if oren_string_char_at(content, idx) == "\n" {
                var line = oren_string_slice(content, line_start, idx)
                // Parse line
                // Format: "0000000000003f50 T _my_api_func"
                // Check if contains " T "
                // Simple search
                var t_idx = -1
                var k = 0
                var l_len = oren_string_len(line)
                while k < l_len - 3 {
                    if oren_string_char_at(line, k) == " " {
                        if oren_string_char_at(line, k+1) == "T" {
                            if oren_string_char_at(line, k+2) == " " {
                                t_idx = k
                                k = l_len // break
                            }
                        }
                    }
                    k = k + 1
                }
                
                if t_idx != -1 {
                    var addr = oren_string_slice(line, 0, t_idx)
                    var sym = oren_string_slice(line, t_idx + 3, l_len)
                    // Trim CR if any
                    // macOS symbols have _ prefix.
                    if oren_string_char_at(sym, 0) == "_" {
                        sym = oren_string_slice(sym, 1, oren_string_len(sym))
                    }
                    print("| " + sym + " | " + addr + " | Function |")
                }
                
                line_start = idx + 1
            }
            idx = idx + 1
        }
        
        oren_system("rm " + nm_out)
        return nil
    }

    if i >= argc { usage(); return nil }
    var path = args[i]
    i = i + 1
    var out_path = default_output_path(path)
    var emit_c = false
    var enable_python = false
    var cc = "cc"
    var backend = "c"
    var target = "macos"
    var disasm = false
    var analyze = false
    var codesign_id = ""
    var notarize = false
    var notary_profile = ""
    var no_gc = false
    var emit_meta = false
    var is_shared_lib = false
    var debug_mode = false
    var link_libs = []
    if target == "macos" { codesign_id = "Developer ID Application: Zongbao Lu (US56HHF2Y4)" }
    if mode == "emit-c" { emit_c = true }
    var env_no_gc = oren_env("OREN_NO_GC")
    if env_no_gc != nil { no_gc = true }

    while i < argc {
        if args[i] == "--emit-c" {
            emit_c = true
            i = i + 1
        } else {
            if args[i] == "--debug" {
                debug_mode = true
                i = i + 1
            } else {
                if args[i] == "--lib" || args[i] == "--shared" {
                    is_shared_lib = true
                    i = i + 1
                } else {
                    if args[i] == "--analyze" {
                        analyze = true
                        i = i + 1
                    } else {
                        if args[i] == "--metadata" {
                            emit_meta = true
                            i = i + 1
                        } else {
                            if args[i] == "--python" {
                                enable_python = true
                                i = i + 1
                            } else {
                                if args[i] == "--link" || args[i] == "-l" {
                                    if i + 1 >= argc { print("Missing value for --link"); return nil }
                                    oren_list_push(link_libs, args[i + 1])
                                    i = i + 2
                                } else {
                                    if args[i] == "--backend" {
                                        if i + 1 >= argc { print("Missing value for --backend"); return nil }
                                        backend = args[i + 1]
                                        i = i + 2
                                    } else {
                                        if args[i] == "--target" {
                                            if i + 1 >= argc { print("Missing value for --target"); return nil }
                                            target = args[i + 1]
                                            i = i + 2
                                        } else {
                                            if args[i] == "--disasm" {
                                                disasm = true
                                                i = i + 1
                                            } else {
                                                if args[i] == "--cc" {
                                                    if i + 1 >= argc { print("Missing value for --cc"); return nil }
                                                    cc = args[i + 1]
                                                    i = i + 2
                                                } else {
                                                    if args[i] == "-o" {
                                                        if i + 1 >= argc { print("Missing value for -o"); return nil }
                                                        out_path = args[i + 1]
                                                        i = i + 2
                                                    } else {
                                                        if args[i] == "--codesign" {
                                                            if i + 1 >= argc { print("Missing value for --codesign"); return nil }
                                                            codesign_id = args[i + 1]
                                                            i = i + 2
                                                        } else {
                                                            if args[i] == "--notarize" {
                                                                notarize = true
                                                                i = i + 1
                                                            } else {
                                                                if args[i] == "--notary-profile" {
                                                                    if i + 1 >= argc { print("Missing value for --notary-profile"); return nil }
                                                                    notary_profile = args[i + 1]
                                                                    i = i + 2
                                                                } else {
                                                                    if args[i] == "--no-gc" {
                                                                        no_gc = true
                                                                        i = i + 1
                                                                    } else {
                                                                        print("Unknown arg: " + args[i])
                                                                        return nil
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if backend != "c" && backend != "native" && backend != "bytecode" {
        print("Unknown backend: " + backend)
        return nil
    }

    var src = oren_read_file(path)
    var l = lexer.new_lexer(src)
    var p = parser.new_parser(l)
    var prog = parser.parse_program(p)
    if oren_list_len(p["errors"]) > 0 {
        print("Parse errors:")
        var i = 0
        while i < oren_list_len(p["errors"]) {
            print(p["errors"][i])
            i = i + 1
        }
        return nil
    }
    
    if analyze {
        analysis.analyze_program(prog)
        return nil
    }

    if mode == "test" {
        if backend != "native" {
            print("Test runner currently supports --backend native only.")
            return nil
        }
        
        var tests = []
        var stmts = prog["statements"]
        var si = 0
        while si < oren_list_len(stmts) {
            var s = stmts[si]
            var fn_node = nil
            if s["type"] == "Function" { fn_node = s }
            if s["type"] == "ExprStmt" {
                var expr = s["expr"]
                if expr != nil {
                    if expr["type"] == "Function" { fn_node = expr }
                }
            }
            if fn_node != nil {
                var name_node = fn_node["name"]
                if name_node != nil {
                    var name = name_node
                    if starts_with(name, "test_") {
                        oren_list_push(tests, name)
                    }
                }
            }
            si = si + 1
        }
        
        var main_stmts = []
        var print_tok = {"literal": "print"}
        var print_id = ast.new_identifier(print_tok)
        
        var start_tok = {"literal": "Running tests..."}
        var start_call = ast.new_call(nil, print_id, [ast.new_string(start_tok)])
        oren_list_push(main_stmts, ast.new_expr_stmt(nil, start_call))
        
        var ti = 0
        while ti < oren_list_len(tests) {
            var tname = tests[ti]
            var t_tok = {"literal": tname}
            var t_call = ast.new_call(nil, ast.new_identifier(t_tok), [])
            oren_list_push(main_stmts, ast.new_expr_stmt(nil, t_call))
            
            var msg = "PASS: " + tname
            var msg_tok = {"literal": msg}
            var msg_call = ast.new_call(nil, print_id, [ast.new_string(msg_tok)])
            oren_list_push(main_stmts, ast.new_expr_stmt(nil, msg_call))
            
            ti = ti + 1
        }
        
        var end_tok = {"literal": "All tests passed."}
        var end_call = ast.new_call(nil, print_id, [ast.new_string(end_tok)])
        oren_list_push(main_stmts, ast.new_expr_stmt(nil, end_call))
        
        var main_fn = ast.new_function(nil, "main", [], ast.new_block(nil))
        main_fn["body"]["stmts"] = main_stmts
        oren_list_push(prog["statements"], ast.new_expr_stmt(nil, main_fn))
        
        var linked = link_program(path, prog)
        var out_test = path + ".test"
        
        if target == "linux" {
            codegen.elf_emit_program_arm64(out_test, linked, [], false, [], false)
        } else {
            codegen.macho_emit_program_arm64(out_test, linked, [], false, [], false)
        }
        
        if target == "macos" {
             var cs_cmd = "codesign -s - --force " + shell_quote(out_test)
             oren_system(cs_cmd)
        }
        
        print("Executing tests...")
        var res = oren_system("./" + out_test)
        oren_system("rm " + out_test)
        if res != 0 {
            print("Tests FAILED.")
            oren_exit(1)
        }
        return nil
    }

    if backend == "bytecode" {
        var linked_bc = link_program(path, prog)
        var ctx = codegen_bytecode.bytecode_compile_program(linked_bc)
        codegen_bytecode.bytecode_emit_program(out_path, ctx)
        print("Bytecode emitted: " + out_path)
        return nil
    }

    if backend == "native" {
        if emit_c {
            print("--emit-c is only supported with --backend c")
            return nil
        }

        var linked = link_program(path, prog)
        var export_names = []
        
        if is_shared_lib {
            var header_path = default_output_path(out_path) + ".h"
            var h_content = "#ifndef OREN_LIB_H\n#define OREN_LIB_H\n\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
            var stmts = linked["statements"]
            var si = 0
            while si < oren_list_len(stmts) {
                var s = stmts[si]
                var fn_node = nil
                
                if s["type"] == "Function" {
                    fn_node = s
                }
                if s["type"] == "ExprStmt" {
                    var expr = s["expr"]
                    if expr != nil {
                        if expr["type"] == "Function" {
                            fn_node = expr
                        }
                    }
                }
                
                if fn_node != nil {
                    var fn_name = fn_node["name"]
                    // print("DEBUG: fn_name = " + fn_name)
                    if fn_name != nil {
                        if fn_name != "main" && fn_name != "__top_level__" {
                            oren_list_push(export_names, fn_name)
                            var params = fn_node["params"]
                            var p_count = oren_list_len(params)
                            h_content = h_content + "extern int64_t " + fn_name + "("
                            var pi = 0
                            while pi < p_count {
                                if pi > 0 { h_content = h_content + ", " }
                                h_content = h_content + "int64_t arg" + oren_int_to_string(pi)
                                pi = pi + 1
                            }
                            if p_count == 0 { h_content = h_content + "void" }
                            h_content = h_content + ");\n"
                        }
                    }
                }
                si = si + 1
            }
            h_content = h_content + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"
            oren_write_file(header_path, h_content)
            print("Wrote header: " + header_path)
        }
        
        if emit_meta {
            var meta_json = metadata.generate_metadata(linked)
            var meta_path = out_path + ".meta.json"
            oren_write_file(meta_path, meta_json)
            print("Wrote metadata: " + meta_path)
        }

        if target == "linux" {
            codegen.elf_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode)
        } else {
            codegen.macho_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode)
        }

        if target == "macos" {
            if codesign_id != "" {
                var cs_cmd = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
                var cs_res = oren_system(cs_cmd)
                if cs_res != 0 {
                    print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                    var ad_cmd = "codesign -s - --force " + shell_quote(out_path)
                    var ad_res = oren_system(ad_cmd)
                    if ad_res != 0 {
                        print("codesign fallback failed")
                        oren_exit(1)
                    }
                }
            }
        }
        
        print("Build successful: " + out_path)
        
        if disasm {
            if target == "macos" {
                oren_system("otool -tV " + shell_quote(out_path))
            } else {
                oren_system("objdump -d " + shell_quote(out_path))
            }
        }
        return nil
    }

    // For C backend, we also need to load modules to populate MODULE_ORDER
    var linked_c = link_program(path, prog)
    var c_code = transpiler.transpile_entry(path, prog, MODULE_ORDER, linked_c["aliases"])
    var c_path = path + ".c"
    oren_write_file(c_path, c_code)
    if emit_c {
        print("Wrote " + c_path)
        return nil
    }

    var cmd = cc + " -o " + shell_quote(out_path) + " " + shell_quote(c_path) + " lib/runtime.c -Ilib -pthread"
    var k_lib = 0
    while k_lib < oren_list_len(link_libs) {
        cmd = cmd + " " + shell_quote(link_libs[k_lib])
        k_lib = k_lib + 1
    }
    if no_gc { cmd = cmd + " -DOREN_NO_GC" }
    if enable_python {
        cmd = cmd + " -DOREN_ENABLE_PYTHON $(python3-config --cflags) $(python3-config --embed --ldflags)"
    }
    var res = oren_system(cmd)
    if res != 0 {
        print("Build failed")
        oren_exit(1)
    }
        if target == "macos" {
            if codesign_id != "" {
                var cs_cmd2 = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
                var cs_res2 = oren_system(cs_cmd2)
                if cs_res2 != 0 {
                print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                var ad_cmd2 = "codesign -s - --force " + shell_quote(out_path)
                var ad_res2 = oren_system(ad_cmd2)
                if ad_res2 != 0 {
                    print("codesign fallback failed")
                    oren_exit(1)
                }
            }
        }
    }
    if target == "macos" && notarize {
        var nt_cmd = ""
        if notary_profile != "" {
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --keychain-profile " + shell_quote(notary_profile) + " --wait"
        } else {
            var apple_id = oren_env("APPLE_ID")
            var apple_pass = oren_env("APPLE_ID_PASS")
            var apple_team = oren_env("APPLE_TEAM_ID")
            if apple_id == nil || apple_pass == nil || apple_team == nil {
                print("Notarization requested but APPLE_ID/APPLE_ID_PASS/APPLE_TEAM_ID or --notary-profile not set")
                oren_exit(1)
            }
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --apple-id " + shell_quote(apple_id) + " --password " + shell_quote(apple_pass) + " --team-id " + shell_quote(apple_team) + " --wait"
        }
        var nt_res = oren_system(nt_cmd)
        if nt_res != 0 {
            print("notarization failed")
            oren_exit(1)
        }
        var staple_cmd = "xcrun stapler staple " + shell_quote(out_path)
        var staple_res = oren_system(staple_cmd)
        if staple_res != 0 {
            print("staple failed")
            oren_exit(1)
        }
    }
    print("Build successful: " + out_path)
    return nil
}

compiler_main()
