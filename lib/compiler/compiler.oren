import argparse "../std/argparse.oren"

fn cli_spec() {
    var p = argparse.new_parser("oren", "Oren compiler / toolchain driver")

    var build = argparse.add_command(p, "build", "Build a .oren file (native/c/bytecode)")
    argparse.cmd_positional(build, "file.oren", true, "Input source file")
    argparse.cmd_option(build, "--backend", nil, "string", "c", "Backend: c|native|bytecode")
    argparse.cmd_option(build, "-o", nil, "string", "", "Output path (default: strip .oren)")
    argparse.cmd_flag(build, "--emit-c", nil, "(C backend) stop after generating <file.oren>.c")
    argparse.cmd_option(build, "--cc", nil, "string", "cc", "(C backend) C compiler")
    argparse.cmd_option(build, "--target", nil, "string", "macos", "(native backend) target OS: macos|linux")
    argparse.cmd_option(build, "--arch", nil, "string", "arm64", "(native backend) target arch: arm64 (rolling; only arm64 supported now)")
    argparse.cmd_flag(build, "--disasm", nil, "(native backend) disassemble output via otool/objdump")
    argparse.cmd_flag(build, "--debug", nil, "(native backend) embed debug info for stack traces")
    argparse.cmd_flag(build, "--lib", nil, "(native backend) build a shared library")
    argparse.cmd_flag(build, "--shared", nil, "(native backend) build a shared library (alias)")
    argparse.cmd_option(build, "--link", "-l", "string", "", "(native backend, macOS) add LC_LOAD_DYLIB")
    argparse.cmd_flag(build, "--metadata", nil, "(native backend) write <out>.meta.json")
    argparse.cmd_flag(build, "--analyze", nil, "Print analysis info and exit")
    argparse.cmd_flag(build, "--python", nil, "(C backend) enable Python integration (requires python3-config)")
    argparse.cmd_flag(build, "--strict-attrs", nil, "Reject unknown attributes unless allowlisted (also via env OREN_STRICT_ATTRS=1)")
    argparse.cmd_option(build, "--attr-allow-prefixes", nil, "string", "", "CSV allow attribute prefixes in strict mode (also via env OREN_ATTR_ALLOW_PREFIXES)")
    argparse.cmd_flag(build, "--capsule", nil, "(native backend) capability-safe subset: deny host effects unless allowlisted (also via env OREN_CAPSULE=1)")
    argparse.cmd_option(build, "--cap-allow-domains", nil, "string", "", "CSV allow capability domains in capsule mode (also via env OREN_CAP_ALLOW_DOMAINS)")
    argparse.cmd_option(build, "--codesign", nil, "string", "", "(macOS) codesign identity")
    argparse.cmd_flag(build, "--notarize", nil, "(macOS) notarize output with notarytool")
    argparse.cmd_option(build, "--notary-profile", nil, "string", "", "(macOS) notarytool keychain profile")
    argparse.cmd_flag(build, "--no-gc", nil, "Disable GC scanning (also via env OREN_NO_GC=1)")
    argparse.cmd_flag(build, "--deterministic", nil, "Deterministic mode: emit stable artifact hashes (sha256) for reproducible builds")

    var emitc = argparse.add_command(p, "emit-c", "Alias for: build --backend c --emit-c")
    argparse.cmd_positional(emitc, "file.oren", true, "Input source file")

    var meta = argparse.add_command(p, "meta", "Emit metadata JSON for a .oren entry module (no codegen)")
    argparse.cmd_positional(meta, "file.oren", true, "Input source file")
    argparse.cmd_option(meta, "-o", nil, "string", "", "Output path (default: <file>.meta.json)")
    argparse.cmd_option(meta, "--target", nil, "string", "macos", "Target OS for ABI/layout lowering: macos|linux")
    argparse.cmd_option(meta, "--arch", nil, "string", "arm64", "Target arch for ABI/layout lowering: arm64 (rolling)")
    argparse.cmd_flag(meta, "--strict-attrs", nil, "Reject unknown attributes unless allowlisted (also via env OREN_STRICT_ATTRS=1)")
    argparse.cmd_option(meta, "--attr-allow-prefixes", nil, "string", "", "CSV allow attribute prefixes in strict mode (also via env OREN_ATTR_ALLOW_PREFIXES)")

    var scan = argparse.add_command(p, "scan", "Scan a dylib and print exported symbols")
    argparse.cmd_positional(scan, "lib.dylib", true, "Library path")

    var dumpcmd = argparse.add_command(p, "dump", "Dump compiler internals for troubleshooting (JSON)")
    argparse.cmd_positional(dumpcmd, "kind", true, "Dump kind: tokens|linked")
    argparse.cmd_positional(dumpcmd, "file.oren", true, "Input source file")
    argparse.cmd_option(dumpcmd, "-o", nil, "string", "", "Output path (default: stdout)")
    argparse.cmd_option(dumpcmd, "--target", nil, "string", "macos", "Target OS for lowering: macos|linux")
    argparse.cmd_option(dumpcmd, "--arch", nil, "string", "arm64", "Target arch for lowering: arm64 (rolling)")
    argparse.cmd_flag(dumpcmd, "--strict-attrs", nil, "Reject unknown attributes unless allowlisted (also via env OREN_STRICT_ATTRS=1)")
    argparse.cmd_option(dumpcmd, "--attr-allow-prefixes", nil, "string", "", "CSV allow attribute prefixes in strict mode (also via env OREN_ATTR_ALLOW_PREFIXES)")

    return p
}

fn usage() {
    var p = cli_spec()
    var lines = argparse.render_help_lines(p, nil)
    var i = 0
    while i < oren_list_len(lines) {
        print(lines[i])
        i = i + 1
    }
}

fn shell_quote(s) {
    return "'" + s + "'" // Minimal quoting
}

fn cmd_ok(cmd) {
    // Return true if command exits with 0.
    return oren_system(cmd) == 0
}

fn normalize_rc(rc) {
    // Normalize the return value of oren_system() to a conventional exit code.
    // Many C runtimes encode exit status as (code << 8).
    if rc == nil { return 1 }
    if rc < 0 { return rc }
    if rc >= 256 { return rc / 256 }
    return rc
}

fn _imod(a, b) {
    // Integer modulo without relying on a runtime helper.
    // Assumes b>0.
    return a - (a / b) * b
}

fn _hex_digit(n) {
    // n in [0,15]
    return oren_string_char_at("0123456789abcdef", n)
}

fn _bytes_to_hex(bs) {
    if bs == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_list_len(bs) {
        var b = bs[i]
        if b == nil { b = 0 }
        if b < 0 { b = 0 }
        if b > 255 { b = _imod(b, 256) }
        out = out + _hex_digit(b / 16) + _hex_digit(_imod(b, 16))
        i = i + 1
    }
    return out
}

fn _sha256_hex(bs) {
    if bs == nil { return "" }
    var n = oren_list_len(bs)
    var d = oren_sha256_range(bs, 0, n)
    return _bytes_to_hex(d)
}

fn _emit_artifact_hash(kind, path, bs) {
    var h = _sha256_hex(bs)
    print("OREN_ARTIFACT kind=" + kind + " sha256=" + h + " path=" + path)
    return nil
}

fn ensure_dir(path) {
    // Use shell to avoid adding FS syscalls to the compiler surface right now.
    // This is for dev tooling (tests/build logs).
    oren_system("mkdir -p " + shell_quote(path))
    return nil
}

fn detect_timeout_bin() {
    // Prefer GNU coreutils `timeout` (Linux) and `gtimeout` (macOS coreutils).
    // We treat timeout tooling as mandatory for safe rolling iteration.
    if cmd_ok("sh -c 'timeout 1 true >/dev/null 2>&1'") { return "timeout" }
    if cmd_ok("sh -c 'gtimeout 1 true >/dev/null 2>&1'") { return "gtimeout" }
    return nil
}

fn run_shell_capture(timeout_bin, timeout_secs, cmd, log_path) {
    // Run a shell command, capture stdout+stderr to log_path, and apply a wall timeout.
    // Returns exit code of the command (or timeout wrapper).
    var t = detect_timeout_bin()
    if timeout_bin != nil { t = timeout_bin }
    if t == nil {
        print("ERROR: timeout not found (need `timeout` or `gtimeout` in PATH).")
        print("macOS: brew install coreutils")
        return 2
    }
    // Always wrap in sh -c for redirection.
    // NOTE: shell_quote is minimal; do not put untrusted input here.
    var redir = cmd + " > " + shell_quote(log_path) + " 2>&1"
    var wrapped = "sh -c " + shell_quote(redir)
    var full = t + " " + oren_int_to_string(timeout_secs) + " " + wrapped
    return normalize_rc(oren_system(full))
}

fn basename(path) {
    if path == nil { return "" }
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at(path, i) == "/" {
            return oren_string_slice(path, i + 1, oren_string_len(path))
        }
        i = i - 1
    }
    return path
}

fn strip_suffix(s, suffix) {
    if s == nil { return s }
    if suffix == nil { return s }
    var sl = oren_string_len(s)
    var pl = oren_string_len(suffix)
    if sl < pl { return s }
    if oren_string_slice(s, sl - pl, sl) == suffix {
        return oren_string_slice(s, 0, sl - pl)
    }
    return s
}

fn file_exists(path) {
    // Avoid nested quoting: shell_quote() already uses single quotes.
    // `test -f 'path'` is fine whether oren_system uses /bin/sh -c or exec.
    return cmd_ok("test -f " + shell_quote(path))
}

fn string_contains(hay, needle) {
    if hay == nil || needle == nil { return false }
    var hl = oren_string_len(hay)
    var nl = oren_string_len(needle)
    if nl == 0 { return true }
    if hl < nl { return false }
    var i = 0
    while i <= hl - nl {
        var j = 0
        while j < nl {
            if oren_string_char_at(hay, i + j) != oren_string_char_at(needle, j) {
                j = -1
                break
            }
            j = j + 1
        }
        if j == nl { return true }
        i = i + 1
    }
    return false
}

// --- Syscall-first hardening (compile-time guard) ---
//
// Prevent accidental re-introduction of syscall bypasses in the native backend:
// - All OS syscalls (except allocator mmap/exit and the entry stub exit) must be emitted by
//   `arm64_native_expr_syscalls.oren` so capsule pre/post hooks remain authoritative.
//
// We enforce this by scanning compiler source files for direct `darwin_sys_*` / `linux_sys_*`
// references, and allowing only a minimal set in the few files that intentionally emit
// those syscalls.
fn streq(a, b) {
    if a == nil || b == nil { return false }
    var ab = oren_bytes_from_string(a)
    var bb = oren_bytes_from_string(b)
    var al = oren_list_len(ab)
    var bl = oren_list_len(bb)
    if al != bl { return false }
    var i = 0
    while i < al {
        if ab[i] != bb[i] { return false }
        i = i + 1
    }
    return true
}

fn has_attr_list(stmt, name) {
    if stmt == nil || name == nil { return false }
    var attrs = stmt["attrs"]
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["type"] == "Attr" && a["name"] == name { return true }
        i = i + 1
    }
    return false
}

fn scan_syscalls_in_src(src, prefix) {
    var out = []
    var sb = oren_bytes_from_string(src)
    var pb = oren_bytes_from_string(prefix)
    var n = oren_list_len(sb)
    var p_len = oren_list_len(pb)
    var i = 0
    while i + p_len <= n {
        // Skip line comments (`// ... \n`) so policy checks don't fail on docs/comments.
        if i + 1 < n {
            if sb[i] == 47 && sb[i + 1] == 47 {
                // Skip until newline or EOF.
                i = i + 2
                while i < n {
                    if sb[i] == 10 { i = i + 1; break } // '\n'
                    i = i + 1
                }
                continue
            }
        }

        var is_match = true
        var j = 0
        while j < p_len {
            if sb[i + j] != pb[j] { is_match = false; break }
            j = j + 1
        }
        if is_match {
            var start = i + p_len
            // Read identifier [a-zA-Z0-9_]+
            var k = start
            while k < n {
                var ch = sb[k]
                var ok = false
                if ch >= 48 && ch <= 57 { ok = true }
                if ch >= 65 && ch <= 90 { ok = true }
                if ch >= 97 && ch <= 122 { ok = true }
                if ch == 95 { ok = true }
                if ok != true { break }
                k = k + 1
            }
            var name = oren_string_slice(src, start, k)
            if name != nil {
                // De-dup
                var seen = false
                var si = 0
                while si < oren_list_len(out) {
                    if streq(out[si], name) { seen = true; break }
                    si = si + 1
                }
                if seen != true { oren_list_push(out, name) }
            }
            i = k
            continue
        }
        i = i + 1
    }
    return out
}

fn syscall_allow(list, name) {
    var i = 0
    while i < oren_list_len(list) {
        if streq(list[i], name) { return true }
        i = i + 1
    }
    return false
}

fn enforce_syscall_policy(file, allowed_darwin, allowed_linux) {
    var src = oren_read_file(file)
    if oren_is_err(src) {
        print("ERROR: failed to read for syscall-policy check: " + file)
        var msg = oren_err_msg(src)
        if msg != nil { print(msg) }
        oren_exit(2)
    }
    var dar = scan_syscalls_in_src(src, "darwin_sys_")
    var lin = scan_syscalls_in_src(src, "linux_sys_")

    var bad = []
    var i = 0
    while i < oren_list_len(dar) {
        if syscall_allow(allowed_darwin, dar[i]) != true {
            oren_list_push(bad, "darwin_sys_" + dar[i])
        }
        i = i + 1
    }
    i = 0
    while i < oren_list_len(lin) {
        if syscall_allow(allowed_linux, lin[i]) != true {
            oren_list_push(bad, "linux_sys_" + lin[i])
        }
        i = i + 1
    }

    if oren_list_len(bad) != 0 {
        print("FAIL: syscall-first policy violation in " + file)
        print("Disallowed direct syscall identifiers (should be centralized in arm64_native_expr_syscalls.oren):")
        var bi = 0
        while bi < oren_list_len(bad) {
            print("  - " + bad[bi])
            bi = bi + 1
        }
        oren_exit(1)
    }
    return 0
}

fn count_substring_in_src(src, needle) {
    if src == nil || needle == nil { return 0 }
    var sb = oren_bytes_from_string(src)
    var nb = oren_bytes_from_string(needle)
    var sl = oren_list_len(sb)
    var nl = oren_list_len(nb)
    if nl == 0 { return 0 }
    if sl < nl { return 0 }

    var count = 0
    var i = 0
    while i + nl <= sl {
        // Skip line comments (`// ... \n`) so policy checks don't fail on docs/comments.
        if i + 1 < sl {
            if sb[i] == 47 && sb[i + 1] == 47 {
                i = i + 2
                while i < sl {
                    if sb[i] == 10 { i = i + 1; break } // '\n'
                    i = i + 1
                }
                continue
            }
        }

        var ok = true
        var j = 0
        while j < nl {
            if sb[i + j] != nb[j] { ok = false; break }
            j = j + 1
        }
        if ok {
            count = count + 1
            i = i + nl
        } else {
            i = i + 1
        }
    }
    return count
}

fn enforce_svc_emit_policy(file, allowed_svc_emits) {
    var src = oren_read_file(file)
    if oren_is_err(src) {
        print("ERROR: failed to read for svc-policy check: " + file)
        var msg = oren_err_msg(src)
        if msg != nil { print(msg) }
        oren_exit(2)
    }

    // Only count actual instruction emission, not function definitions.
    var pattern = "push_u32_le(ctx[\"code\"], insn_svc("
    var n = count_substring_in_src(src, pattern)
    if n != allowed_svc_emits {
        print("FAIL: syscall-first policy violation in " + file)
        print("Unexpected number of direct `insn_svc` emissions.")
        print("  expected: " + oren_int_to_string(allowed_svc_emits))
        print("  found:    " + oren_int_to_string(n))
        print("Rule: only arm64_native_expr_syscalls.oren should emit syscalls for OS ops;")
        print("      other files may only emit svc for allocator/entry-stub special cases.")
        oren_exit(1)
    }
    return 0
}

fn dirname(path) {
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at(path, i) == "/" {
            if i == 0 { return "/" }
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

fn starts_with(s, prefix) {
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if oren_string_char_at(s, i) != oren_string_char_at(prefix, i) { return false }
        i = i + 1
    }
    return true
}

fn default_output_path(path) {
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at(path, i) == "." {
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return path // No extension?
}

// Module system globals
var MODULES = {}
var MODULE_STACK = []
var MODULE_ORDER = []
var MODULE_ID_COUNTER = 0

// Attribute validation knobs (plumbed into the parser).
// Defaults keep rolling mode permissive.
var STRICT_ATTRS = false
var ATTR_ALLOW_PREFIXES = []
var CAPSULE = false
var CAP_ALLOW_DOMAINS = []

fn split_csv(s) {
    var out = []
    if s == nil { return out }
    if s == "" { return out }
    var cur = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        if ch == "," {
            if cur != "" { oren_list_push(out, cur) }
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    if cur != "" { oren_list_push(out, cur) }
    return out
}

fn new_module_prefix() {
    MODULE_ID_COUNTER = MODULE_ID_COUNTER + 1
    return "M" + oren_int_to_string(MODULE_ID_COUNTER) + "_"
}


fn path_norm(path) {
    if path == nil { return "" }
    var n = oren_string_len(path)
    if n == 0 { return "" }

    var is_abs = oren_string_char_at(path, 0) == "/"
    var segs = []

    var i = 0
    var start = 0
    while i <= n {
        var at_end = i == n
        if at_end || oren_string_char_at(path, i) == "/" {
            var seg = oren_string_slice(path, start, i)
            if seg != "" && seg != "." {
                if seg == ".." {
                    var sl = oren_list_len(segs)
                    if sl > 0 && segs[sl - 1] != ".." {
                        // pop
                        var ns = []
                        var j = 0
                        while j + 1 < sl {
                            oren_list_push(ns, segs[j])
                            j = j + 1
                        }
                        segs = ns
                    } else {
                        if !is_abs { oren_list_push(segs, "..") }
                    }
                } else {
                    oren_list_push(segs, seg)
                }
            }
            start = i + 1
        }
        i = i + 1
    }

    var out = ""
    if is_abs { out = "/" }

    i = 0
    while i < oren_list_len(segs) {
        if out != "" && oren_string_char_at(out, oren_string_len(out) - 1) != "/" {
            out = out + "/"
        }
        out = out + segs[i]
        i = i + 1
    }

    if out == "" {
        if is_abs { return "/" }
        return "."
    }
    return out
}

fn resolve_path(base, path) {
    if path == nil { return "" }
    if oren_string_len(path) > 0 && oren_string_char_at(path, 0) == "/" { return path_norm(path) }
    return path_norm(base + "/" + path)
}

fn load_module(base, path) {
    var full = resolve_path(base, path)
    if MODULES[full] != nil {
        return MODULES[full]
    }

    if oren_env("OREN_TRACE_PASSES") != nil {
        print("[trace] load_module: " + full)
    }
    
    // Cycle check
    var k = 0
    while k < oren_list_len(MODULE_STACK) {
        if MODULE_STACK[k] == full {
            print("Cyclic import detected: " + full)
            oren_exit(1)
        }
        k = k + 1
    }
    oren_list_push(MODULE_STACK, full)

    var src = oren_read_file(full)
    if oren_is_err(src) {
        print("Failed to read file: " + full)
        var msg = oren_err_msg(src)
        if msg != nil { print(msg) }
        oren_exit(1)
    }
    var l = lexer.new_lexer(src)
    l["file"] = full
    var p = parser.new_parser(l)
    p["strict_attrs"] = STRICT_ATTRS
    p["attr_allow_prefixes"] = ATTR_ALLOW_PREFIXES
    var prog = parser.parse_program(p)
    
    if oren_list_len(p["errors"]) > 0 {
        print("Parse errors in " + full + ":")
        var i = 0
        while i < oren_list_len(p["errors"]) {
            print(p["errors"][i])
            i = i + 1
        }
        oren_exit(1)
    }

    var mod = {"prefix": new_module_prefix(), "path": full, "program": prog, "aliases": {}, "imports": [], "added": false}
    MODULES[full] = mod

    var dir = dirname(full)
    var i = 0
    while i < oren_list_len(prog["statements"]) {
        var s = prog["statements"][i]
        if s["type"] == "Import" {
            var alias = s["name"]["value"]
            if mod["aliases"][alias] != nil {
                print("Duplicate import alias: " + alias + " in " + full)
                oren_exit(1)
            }
            var dep = load_module(dir, s["path"])
            mod["aliases"][alias] = dep["prefix"]
            // Preserve import edges in deterministic source order for graph export.
            oren_list_push(mod["imports"], {"alias": alias, "path": s["path"], "prefix": dep["prefix"], "full": dep["path"]})
        }
        i = i + 1
    }

    // Rename pass would be here, but we need to move rename logic to a module too?
    // For now let's assume we copy `collect_toplevel_rename_pairs` etc.
    // Or better, put them in `analysis.oren` or a new `modules.oren`.
    // Let's put module logic in `compiler.oren` for now as it orchestrates loading.
    
    var pairs = renamer.collect_toplevel_rename_pairs(prog, mod["prefix"])
    i = 0
    while i < oren_list_len(prog["statements"]) {
        var s2 = prog["statements"][i]
        if s2["type"] == "Import" {
            var alias2 = s2["name"]["value"]
            if renamer.rename_lookup(pairs, alias2) != "" {
                print("Import alias conflicts with top-level name: " + alias2 + " in " + full)
                oren_exit(1)
            }
        }
        i = i + 1
    }
    renamer.rename_program_in_place(prog, pairs)

    if mod["added"] != true {
        mod["added"] = true
        oren_list_push(MODULE_ORDER, mod)
    }

    // Pop cycle-check stack (runtime has no list_pop; do it manually).
    var new_stack = []
    var si = 0
    var sl = oren_list_len(MODULE_STACK)
    while si + 1 < sl {
        oren_list_push(new_stack, MODULE_STACK[si])
        si = si + 1
    }
    MODULE_STACK = new_stack
    
    return mod
}

fn link_program(entry_path, root_prog, config) {
    var trace_passes = oren_env("OREN_TRACE_PASSES") != nil
    if trace_passes { print("[trace] link: start " + entry_path) }
    MODULES = {}
    MODULE_STACK = []
    MODULE_ORDER = []
    MODULE_ID_COUNTER = 0
    
    var base = dirname(entry_path)
    var root_aliases = {}
    var root_imports = []
    
    var i = 0
    while i < oren_list_len(root_prog["statements"]) {
        var s = root_prog["statements"][i]
        if s["type"] == "Import" {
            var alias = s["name"]["value"]
            var mod = load_module(base, s["path"])
            root_aliases[alias] = mod["prefix"]
            // Preserve root import edges in source order.
            oren_list_push(root_imports, {"alias": alias, "path": s["path"], "prefix": mod["prefix"], "full": mod["path"]})
        }
        i = i + 1
    }
    
    var merged_stmts = []
    var merged_traits = []
    var type_ns = {}
    var field_offsets = {}
    
    i = 0
    while i < oren_list_len(MODULE_ORDER) {
        var mod = MODULE_ORDER[i]
        var stmts = mod["program"]["statements"]
        if mod["program"]["traits"] != nil {
            var ti = 0
            while ti < oren_list_len(mod["program"]["traits"]) {
                oren_list_push(merged_traits, mod["program"]["traits"][ti])
                ti = ti + 1
            }
        }
        var j = 0
        while j < oren_list_len(stmts) {
            var st = stmts[j]
            if st["type"] == "Type" {
                type_ns[st["name"]["value"]] = true
                // Rolling: v0 structs are represented as NEW_LIST (positional) so we
                // require consistent field indices *across types* for member access.
                //
                // ABI structs (`@oren.abi`) are layout-only helpers for FFI and are not
                // meant to participate in v0 member-access semantics. Skip them so we can
                // define OS-specific structs (sockaddr, kevent, stat) with different field
                // orders without breaking non-ABI code.
                if has_attr_list(st, "oren.abi") != true {
                    var fi = 0
                    while fi < oren_list_len(st["fields"]) {
                        var fname = st["fields"][fi]["value"]
                        if field_offsets[fname] == nil {
                            field_offsets[fname] = fi
                        } else {
                            if field_offsets[fname] != fi {
                                print("Inconsistent field offset for '" + fname + "'")
                                oren_exit(1)
                            }
                        }
                        fi = fi + 1
                    }
                }
            }
            if st["type"] != "Import" {
                oren_list_push(merged_stmts, st)
            }
            j = j + 1
        }
        i = i + 1
    }
    
    i = 0
    while i < oren_list_len(root_prog["statements"]) {
        var st = root_prog["statements"][i]
        if st["type"] == "Type" {
            type_ns[st["name"]["value"]] = true
            if has_attr_list(st, "oren.abi") != true {
                var fi2 = 0
                while fi2 < oren_list_len(st["fields"]) {
                    var fname2 = st["fields"][fi2]["value"]
                    if field_offsets[fname2] == nil {
                        field_offsets[fname2] = fi2
                    } else {
                        if field_offsets[fname2] != fi2 {
                            print("Inconsistent field offset for '" + fname2 + "'")
                            oren_exit(1)
                        }
                    }
                    fi2 = fi2 + 1
                }
            }
        }
        if st["type"] != "Import" {
            oren_list_push(merged_stmts, st)
        }
        i = i + 1
    }

    if root_prog["traits"] != nil {
        var rti = 0
        while rti < oren_list_len(root_prog["traits"]) {
            oren_list_push(merged_traits, root_prog["traits"][rti])
            rti = rti + 1
        }
    }
    
    // Preserve metadata-only surfaces across module linking.
    // (Traits are not represented as executable statements yet in v0.)
    // Provide a deterministic module graph surface for tooling.
    var module_summaries = []
    i = 0
    while i < oren_list_len(MODULE_ORDER) {
        var m = MODULE_ORDER[i]
        oren_list_push(module_summaries, {"prefix": m["prefix"], "path": m["path"], "imports": m["imports"]})
        i = i + 1
    }

    var linked = {
        "statements": merged_stmts,
        "traits": merged_traits,
        "aliases": root_aliases,
        "type_ns": type_ns,
        "field_offsets": field_offsets,
        "config": config,
        "module_graph": {"entry": entry_path, "imports": root_imports, "modules": module_summaries}
    }

    // Whole-program impl/method-call lowering:
    // - enables cross-module method call sugar without runtime vtables
    // - enforces deterministic coherence (ambiguous overlap is a compile error)
    if trace_passes { print("[trace] pass: impl_lowering") }
    impl_lowering.lower_linked_program_in_place(linked)
    if linked["impl_lowering_errors"] != nil && oren_list_len(linked["impl_lowering_errors"]) > 0 {
        print("Impl lowering errors:")
        var ei = 0
        while ei < oren_list_len(linked["impl_lowering_errors"]) {
            print(linked["impl_lowering_errors"][ei])
            ei = ei + 1
        }
        oren_exit(1)
    }

    // Compile-time lowering: packed struct views over bytes.
    if trace_passes { print("[trace] pass: packview") }
    packview.lower_linked_program_in_place(linked)

    // Compile-time lowering: apply value-level normalization for annotated struct/class fields.
    // (Rolling step toward exact-size layout semantics.)
    if trace_passes { print("[trace] pass: type_ann") }
    type_ann.lower_linked_program_in_place(linked)

    // Compile-time lowering: ABI layout computation and sizeof/offsetof constants.
    // Opt-in via `@oren.abi` and does not depend on host headers.
    if trace_passes { print("[trace] pass: abi_layout") }
    abi_layout.lower_linked_program_in_place(linked)

    // Optimizer baseline (safe, conservative).
    if trace_passes { print("[trace] pass: optimizer") }
    optimizer.lower_linked_program_in_place(linked)

    if trace_passes { print("[trace] link: done (stmts=" + oren_int_to_string(oren_list_len(linked["statements"])) + ")") }
    return linked
}

fn compiler_main() {
    var args = oren_args()
    var argc = oren_list_len(args)
    if argc < 2 { usage(); return nil }

    // Global help (works for all subcommands).
    var hi = 1
    while hi < argc {
        if args[hi] == "--help" || args[hi] == "-h" {
            usage()
            return nil
        }
        hi = hi + 1
    }

    var mode = "build"
    var i = 1
    if args[i] == "build" { mode = "build"; i = i + 1 }
    else {
        if args[i] == "emit-c" { mode = "emit-c"; i = i + 1 }
        else {
            if args[i] == "meta" { mode = "meta"; i = i + 1 }
            else {
                if args[i] == "scan" { mode = "scan"; i = i + 1 }
                else {
                    if args[i] == "dump" { mode = "dump"; i = i + 1 }
                    else {
                        if args[i] == "--emit-c" { mode = "emit-c"; i = i + 1 }
                    }
                }
            }
        }
    }

    var dbg_args = oren_env("OREN_DEBUG_ARGS")
    if dbg_args != nil {
        var di = 0
        while di < oren_list_len(args) {
            print("ARG[" + oren_int_to_string(di) + "] = " + args[di])
            di = di + 1
        }
    }

    if mode == "scan" {
        if i >= argc { print("Usage: oren scan <lib>"); return nil }
        var lib = args[i]
        var nm_out = "scan_tmp.txt"
        // macOS: nm -gU. Linux: nm -gD?
        var cmd = "nm -gU " + shell_quote(lib) + " > " + nm_out
        if oren_system(cmd) != 0 {
            print("Scan failed (nm not found or lib invalid?)")
            return nil
        }
        var content = oren_read_file(nm_out)
        if oren_is_err(content) {
            print("Scan failed (cannot read nm output): " + nm_out)
            var msg = oren_err_msg(content)
            if msg != nil { print(msg) }
            return nil
        }
        var len = oren_string_len(content)
        var idx = 0
        
        print("# API Documentation for " + lib)
        print("")
        print("| Symbol | Address | Type |")
        print("|---|---|---|")
        
        // Parse lines: address T symbol
        var line_start = 0
        while idx < len {
            if oren_string_char_at(content, idx) == "\n" {
                var line = oren_string_slice(content, line_start, idx)
                // Parse line
                // Format: "0000000000003f50 T _my_api_func"
                // Check if contains " T "
                // Simple search
                var t_idx = -1
                var k = 0
                var l_len = oren_string_len(line)
                while k < l_len - 3 {
                    if oren_string_char_at(line, k) == " " {
                        if oren_string_char_at(line, k+1) == "T" {
                            if oren_string_char_at(line, k+2) == " " {
                                t_idx = k
                                k = l_len // break
                            }
                        }
                    }
                    k = k + 1
                }
                
                if t_idx != -1 {
                    var addr = oren_string_slice(line, 0, t_idx)
                    var sym = oren_string_slice(line, t_idx + 3, l_len)
                    // Trim CR if any
                    // macOS symbols have _ prefix.
                    if oren_string_char_at(sym, 0) == "_" {
                        sym = oren_string_slice(sym, 1, oren_string_len(sym))
                    }
                    print("| " + sym + " | " + addr + " | Function |")
                }
                
                line_start = idx + 1
            }
            idx = idx + 1
        }
        
        oren_system("rm " + nm_out)
        return nil
    }

    if mode == "dump" {
        // Usage: oren dump <tokens|linked|graph> <file.oren> [-o out.json] [--target macos|linux] [--arch arm64]
        if i + 1 >= argc { print("Usage: oren dump <tokens|linked|graph> <file.oren> [-o out.json] [--target macos|linux] [--arch arm64]"); return nil }
        var kind = args[i]
        var path = args[i + 1]
        i = i + 2

        var target = "macos"
        var arch = "arm64"
        var outp = ""

        var strict = false
        var allow = []
        var env_strict = oren_env("OREN_STRICT_ATTRS")
        if env_strict != nil { strict = true }
        var env_allow = oren_env("OREN_ATTR_ALLOW_PREFIXES")
        if env_allow != nil { allow = split_csv(env_allow) }

        while i < argc {
            if args[i] == "--target" {
                if i + 1 >= argc { print("Missing value for --target"); return nil }
                target = args[i + 1]
                i = i + 2
            } else {
                if args[i] == "--arch" {
                    if i + 1 >= argc { print("Missing value for --arch"); return nil }
                    arch = args[i + 1]
                    i = i + 2
                } else {
                    if args[i] == "-o" {
                        if i + 1 >= argc { print("Missing value for -o"); return nil }
                        outp = args[i + 1]
                        i = i + 2
                    } else {
                        if args[i] == "--strict-attrs" {
                            strict = true
                            i = i + 1
                        } else {
                            if args[i] == "--attr-allow-prefixes" {
                                if i + 1 >= argc { print("Missing value for --attr-allow-prefixes"); return nil }
                                allow = split_csv(args[i + 1])
                                i = i + 2
                            } else {
                                print("Unknown arg: " + args[i])
                                return nil
                            }
                        }
                    }
                }
            }
        }

        if kind == "tokens" {
            var js = dump.dump_tokens_json(path, strict, allow)
            if js == nil { oren_exit(1) }
            var rc = dump.write_or_print(outp, js)
            if rc != 0 { oren_exit(rc) }
            return nil
        }
        if kind == "linked" {
            var src = oren_read_file(path)
            if oren_is_err(src) {
                print("Failed to read file: " + path)
                var msg = oren_err_msg(src)
                if msg != nil { print(msg) }
                oren_exit(2)
            }
            var l = lexer.new_lexer(src)
            l["file"] = path
            var p = parser.new_parser(l)
            p["strict_attrs"] = strict
            p["attr_allow_prefixes"] = allow
            var prog = parser.parse_program(p)
            if oren_list_len(p["errors"]) > 0 {
                print("Parse errors:")
                var ei = 0
                while ei < oren_list_len(p["errors"]) {
                    print(p["errors"][ei])
                    ei = ei + 1
                }
                oren_exit(1)
            }
            var linked = link_program(path, prog, {"target": target, "arch": arch})
            var js2 = dump.linked_summary_json(linked)
            var rc2 = dump.write_or_print(outp, js2)
            if rc2 != 0 { oren_exit(rc2) }
            return nil
        }
        if kind == "graph" {
            var srcg = oren_read_file(path)
            if oren_is_err(srcg) {
                print("Failed to read file: " + path)
                var msgg = oren_err_msg(srcg)
                if msgg != nil { print(msgg) }
                oren_exit(2)
            }
            var lg = lexer.new_lexer(srcg)
            lg["file"] = path
            var pg = parser.new_parser(lg)
            pg["strict_attrs"] = strict
            pg["attr_allow_prefixes"] = allow
            var progg = parser.parse_program(pg)
            if oren_list_len(pg["errors"]) > 0 {
                print("Parse errors:")
                var eig = 0
                while eig < oren_list_len(pg["errors"]) {
                    print(pg["errors"][eig])
                    eig = eig + 1
                }
                oren_exit(1)
            }
            var linkedg = link_program(path, progg, {"target": target, "arch": arch})
            var graph = linkedg["module_graph"]
            var jsg = dump.module_graph_json(graph)
            var rcg = dump.write_or_print(outp, jsg)
            if rcg != 0 { oren_exit(rcg) }
            return nil
        }

        print("Unknown dump kind: " + kind + " (expected: tokens|linked|graph)")
        oren_exit(1)
    }

    if mode == "meta" {
        if i >= argc { print("Usage: oren meta <file.oren> [-o out.meta.json] [--target macos|linux] [--arch arm64]"); return nil }
        var path = args[i]
        i = i + 1

        var target = "macos"
        var arch = "arm64"
        var out_meta = strip_suffix(path, ".oren") + ".meta.json"

        var env_strict_attrs = oren_env("OREN_STRICT_ATTRS")
        if env_strict_attrs != nil { STRICT_ATTRS = true }
        var env_attr_allow = oren_env("OREN_ATTR_ALLOW_PREFIXES")
        if env_attr_allow != nil { ATTR_ALLOW_PREFIXES = split_csv(env_attr_allow) }

        while i < argc {
            if args[i] == "--target" {
                if i + 1 >= argc { print("Missing value for --target"); return nil }
                target = args[i + 1]
                i = i + 2
            } else {
                if args[i] == "--arch" {
                    if i + 1 >= argc { print("Missing value for --arch"); return nil }
                    arch = args[i + 1]
                    i = i + 2
                } else {
                    if args[i] == "-o" {
                        if i + 1 >= argc { print("Missing value for -o"); return nil }
                        out_meta = args[i + 1]
                        i = i + 2
                    } else {
                        if args[i] == "--strict-attrs" {
                            STRICT_ATTRS = true
                            i = i + 1
                        } else {
                            if args[i] == "--attr-allow-prefixes" {
                                if i + 1 >= argc { print("Missing value for --attr-allow-prefixes"); return nil }
                                ATTR_ALLOW_PREFIXES = split_csv(args[i + 1])
                                i = i + 2
                            } else {
                                print("Unknown arg: " + args[i])
                                return nil
                            }
                        }
                    }
                }
            }
        }

        var src = oren_read_file(path)
        if oren_is_err(src) {
            print("Failed to read file: " + path)
            var msg = oren_err_msg(src)
            if msg != nil { print(msg) }
            oren_exit(2)
        }
        var l = lexer.new_lexer(src)
        l["file"] = path
        var p = parser.new_parser(l)
        p["strict_attrs"] = STRICT_ATTRS
        p["attr_allow_prefixes"] = ATTR_ALLOW_PREFIXES
        var prog = parser.parse_program(p)
        if oren_list_len(p["errors"]) > 0 {
            print("Parse errors:")
            var ei = 0
            while ei < oren_list_len(p["errors"]) {
                print(p["errors"][ei])
                ei = ei + 1
            }
            oren_exit(1)
        }

        var linked = link_program(path, prog, {"target": target, "arch": arch})
        var meta_json = metadata.generate_metadata(linked)
        var w = oren_write_file(out_meta, meta_json)
        if oren_is_err(w) {
            print("Failed to write metadata: " + out_meta)
            var msgw = oren_err_msg(w)
            if msgw != nil { print(msgw) }
            oren_exit(1)
        }
        print("Wrote metadata: " + out_meta)
        return nil
    }

    if i >= argc { usage(); return nil }
    var path = args[i]
    i = i + 1
    var out_path = default_output_path(path)
    var emit_c = false
    var enable_python = false
    var cc = "cc"
    var backend = "c"
    var target = "macos"
    var arch = "arm64"
    var disasm = false
    var analyze = false
    var codesign_id = ""
    var notarize = false
    var notary_profile = ""
    var no_gc = false
    var emit_meta = false
    var is_shared_lib = false
    var deterministic = false
    // Rolling mode: default native builds to embed debug info so panics produce readable stack traces.
    // Users can still disable by explicitly setting OREN_NATIVE_NO_DEBUG=1 (kept as an env knob so we
    // don't need to introduce a new CLI flag yet).
    var debug_mode = false
    var link_libs = []
    if target == "macos" { codesign_id = "Developer ID Application: Zongbao Lu (US56HHF2Y4)" }
    if mode == "emit-c" { emit_c = true }
    var env_no_gc = oren_env("OREN_NO_GC")
    if env_no_gc != nil { no_gc = true }
    var env_native_no_debug = oren_env("OREN_NATIVE_NO_DEBUG")
    if env_native_no_debug != nil { debug_mode = false }
    var env_strict_attrs = oren_env("OREN_STRICT_ATTRS")
    if env_strict_attrs != nil { STRICT_ATTRS = true }
    var env_attr_allow = oren_env("OREN_ATTR_ALLOW_PREFIXES")
    if env_attr_allow != nil { ATTR_ALLOW_PREFIXES = split_csv(env_attr_allow) }
    var env_capsule = oren_env("OREN_CAPSULE")
    if env_capsule != nil { CAPSULE = true }
    var env_cap_domains = oren_env("OREN_CAP_ALLOW_DOMAINS")
    if env_cap_domains != nil { CAP_ALLOW_DOMAINS = split_csv(env_cap_domains) }
    var env_det = oren_env("OREN_DETERMINISTIC")
    if env_det != nil { deterministic = true }

    while i < argc {
        if args[i] == "--emit-c" {
            emit_c = true
            i = i + 1
        } else {
            if args[i] == "--debug" {
                debug_mode = true
                i = i + 1
            } else {
                if args[i] == "--lib" || args[i] == "--shared" {
                    is_shared_lib = true
                    i = i + 1
                } else {
                    if args[i] == "--analyze" {
                        analyze = true
                        i = i + 1
                    } else {
                        if args[i] == "--metadata" {
                            emit_meta = true
                            i = i + 1
                        } else {
                            if args[i] == "--strict-attrs" {
                                STRICT_ATTRS = true
                                i = i + 1
                            } else {
                                if args[i] == "--attr-allow-prefixes" {
                                    if i + 1 >= argc { print("Missing value for --attr-allow-prefixes"); return nil }
                                    ATTR_ALLOW_PREFIXES = split_csv(args[i + 1])
                                    i = i + 2
                                } else {
                            if args[i] == "--capsule" {
                                CAPSULE = true
                                i = i + 1
                            } else {
                                if args[i] == "--cap-allow-domains" {
                                    if i + 1 >= argc { print("Missing value for --cap-allow-domains"); return nil }
                                    CAP_ALLOW_DOMAINS = split_csv(args[i + 1])
                                    i = i + 2
                                } else {
                            if args[i] == "--python" {
                                enable_python = true
                                i = i + 1
                            } else {
                                if args[i] == "--link" || args[i] == "-l" {
                                    if i + 1 >= argc { print("Missing value for --link"); return nil }
                                    oren_list_push(link_libs, args[i + 1])
                                    i = i + 2
                                } else {
                                    if args[i] == "--backend" {
                                        if i + 1 >= argc { print("Missing value for --backend"); return nil }
                                        backend = args[i + 1]
                                        i = i + 2
                                    } else {
                                        if args[i] == "--target" {
                                            if i + 1 >= argc { print("Missing value for --target"); return nil }
                                            target = args[i + 1]
                                            i = i + 2
                                        } else {
                                            if args[i] == "--arch" {
                                                if i + 1 >= argc { print("Missing value for --arch"); return nil }
                                                arch = args[i + 1]
                                                i = i + 2
                                            } else {
                                    if args[i] == "--disasm" {
                                        disasm = true
                                        i = i + 1
                                    } else {
                                                if args[i] == "--cc" {
                                                    if i + 1 >= argc { print("Missing value for --cc"); return nil }
                                                    cc = args[i + 1]
                                                    i = i + 2
                                                } else {
                                                    if args[i] == "-o" {
                                                        if i + 1 >= argc { print("Missing value for -o"); return nil }
                                                        out_path = args[i + 1]
                                                        i = i + 2
                                                    } else {
                                                        if args[i] == "--codesign" {
                                                            if i + 1 >= argc { print("Missing value for --codesign"); return nil }
                                                            codesign_id = args[i + 1]
                                                            i = i + 2
                                                        } else {
                                                            if args[i] == "--notarize" {
                                                                notarize = true
                                                                i = i + 1
                                                            } else {
                                                                if args[i] == "--notary-profile" {
                                                                    if i + 1 >= argc { print("Missing value for --notary-profile"); return nil }
                                                                    notary_profile = args[i + 1]
                                                                    i = i + 2
                                                                } else {
                                                                    if args[i] == "--no-gc" {
                                                                        no_gc = true
                                                                        i = i + 1
                                                                    } else {
                                                                        if args[i] == "--deterministic" {
                                                                            deterministic = true
                                                                            i = i + 1
                                                                        } else {
                                                                            print("Unknown arg: " + args[i])
                                                                            return nil
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            }
                                        }
                                    }
                                }
                            }
                                }
                            }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if deterministic {
        // Deterministic mode: avoid post-processing that can inject non-reproducible data.
        codesign_id = ""
        notarize = false
    }

    // If user did not explicitly request debug info, default it on for native backend builds.
    // This makes runtime panics actionable by default (stack traces map to function names).
    if backend == "native" {
        if debug_mode == false {
            if env_native_no_debug == nil {
                debug_mode = true
            }
        }
    }

    if backend != "c" && backend != "native" && backend != "bytecode" {
        print("Unknown backend: " + backend)
        return nil
    }

    var src = oren_read_file(path)
    if oren_is_err(src) {
        print("Failed to read file: " + path)
        var msg = oren_err_msg(src)
        if msg != nil { print(msg) }
        oren_exit(2)
    }
    var l = lexer.new_lexer(src)
    l["file"] = path
    var p = parser.new_parser(l)
    p["strict_attrs"] = STRICT_ATTRS
    p["attr_allow_prefixes"] = ATTR_ALLOW_PREFIXES
    var prog = parser.parse_program(p)
    if oren_list_len(p["errors"]) > 0 {
        print("Parse errors:")
        var i = 0
        while i < oren_list_len(p["errors"]) {
            print(p["errors"][i])
            i = i + 1
        }
        oren_exit(1)
    }
    
    if analyze {
        analysis.analyze_program(prog)
        return nil
    }

    if backend == "bytecode" {
        var linked_bc = link_program(path, prog, {"target": target, "arch": arch})
        var ctx = codegen_bytecode.bytecode_compile_program(linked_bc)

        // Rolling: embed metadata into the `.obc` constant pool as a BYTES constant so:
        // - tooling can discover attrs/types/fields without a sidecar file
        // - execution semantics remain unchanged (metadata is not referenced by code)
        //
        // Format (rolling, v0):
        //   bytes = "OREN_META\n1\n" + <meta_json_utf8_bytes>
        var meta_json = metadata.generate_metadata(linked_bc)
        var hdr = oren_bytes_from_string("OREN_META\n1\n")
        var payload = oren_bytes_from_string(meta_json)
        var meta_bytes = []
        var hi = 0
        while hi < oren_list_len(hdr) {
            oren_list_push(meta_bytes, hdr[hi])
            hi = hi + 1
        }
        var pi = 0
        while pi < oren_list_len(payload) {
            oren_list_push(meta_bytes, payload[pi])
            pi = pi + 1
        }
        ctx["meta_bytes"] = meta_bytes

        var out_bytes = codegen_bytecode.bytecode_emit_program(out_path, ctx)
        print("Bytecode emitted: " + out_path)
        if deterministic { _emit_artifact_hash("bytecode", out_path, out_bytes) }
        return nil
    }

    if backend == "native" {
        if emit_c {
            print("--emit-c is only supported with --backend c")
            return nil
        }

        var linked = link_program(path, prog, {"target": target, "arch": arch})
        var export_names = []
        
        if is_shared_lib {
            var header_path = default_output_path(out_path) + ".h"
            var h_content = "#ifndef OREN_LIB_H\n#define OREN_LIB_H\n\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
            var stmts = linked["statements"]
            var si = 0
            while si < oren_list_len(stmts) {
                var s = stmts[si]
                var fn_node = nil
                
                if s["type"] == "Function" {
                    fn_node = s
                }
                if s["type"] == "ExprStmt" {
                    var expr = s["expr"]
                    if expr != nil {
                        if expr["type"] == "Function" {
                            fn_node = expr
                        }
                    }
                }
                
                if fn_node != nil {
                    var fn_name = fn_node["name"]
                    // print("DEBUG: fn_name = " + fn_name)
                    if fn_name != nil {
                        if fn_name != "main" && fn_name != "__top_level__" {
                            oren_list_push(export_names, fn_name)
                            var params = fn_node["params"]
                            var p_count = oren_list_len(params)
                            h_content = h_content + "extern int64_t " + fn_name + "("
                            var pi = 0
                            while pi < p_count {
                                if pi > 0 { h_content = h_content + ", " }
                                h_content = h_content + "int64_t arg" + oren_int_to_string(pi)
                                pi = pi + 1
                            }
                            if p_count == 0 { h_content = h_content + "void" }
                            h_content = h_content + ");\n"
                        }
                    }
                }
                si = si + 1
            }
            h_content = h_content + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"
            var w = oren_write_file(header_path, h_content)
            if oren_is_err(w) {
                print("Failed to write header: " + header_path)
                var msg = oren_err_msg(w)
                if msg != nil { print(msg) }
                oren_exit(1)
            }
            print("Wrote header: " + header_path)
        }
        
        if emit_meta {
            var meta_json = metadata.generate_metadata(linked)
            var meta_path = out_path + ".meta.json"
            var w2 = oren_write_file(meta_path, meta_json)
            if oren_is_err(w2) {
                print("Failed to write metadata: " + meta_path)
                var msg2 = oren_err_msg(w2)
                if msg2 != nil { print(msg2) }
                oren_exit(1)
            }
            print("Wrote metadata: " + meta_path)
        }

        if target == "linux" {
            arm64_elf.elf_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, CAPSULE, CAP_ALLOW_DOMAINS)
        } else {
            arm64_macho.macho_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, CAPSULE, CAP_ALLOW_DOMAINS)
        }

        if target == "macos" {
            if codesign_id != "" {
                var cs_cmd = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
                var cs_res = oren_system(cs_cmd)
                if cs_res != 0 {
                    print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                    var ad_cmd = "codesign -s - --force " + shell_quote(out_path)
                    var ad_res = oren_system(ad_cmd)
                    if ad_res != 0 {
                        print("codesign fallback failed")
                        oren_exit(1)
                    }
                }
            }
        }
        
        if deterministic {
            var bs = oren_read_bytes(out_path)
            if oren_is_err(bs) {
                print("Failed to read artifact for hashing: " + out_path)
                var msgH = oren_err_msg(bs)
                if msgH != nil { print(msgH) }
                oren_exit(1)
            }
            _emit_artifact_hash("native", out_path, bs)
        }

        print("Build successful: " + out_path)
        
        if disasm {
            if target == "macos" {
                oren_system("otool -tV " + shell_quote(out_path))
            } else {
                oren_system("objdump -d " + shell_quote(out_path))
            }
        }
        return nil
    }

    // For C backend, we also need to load modules to populate MODULE_ORDER
    var linked_c = link_program(path, prog, {"target": target, "arch": arch})
    var c_code = transpiler.transpile_entry(path, prog, MODULE_ORDER, linked_c["aliases"])
    var c_path = path + ".c"
    var w3 = oren_write_file(c_path, c_code)
    if oren_is_err(w3) {
        print("Failed to write C output: " + c_path)
        var msg3 = oren_err_msg(w3)
        if msg3 != nil { print(msg3) }
        oren_exit(1)
    }
    if emit_c {
        print("Wrote " + c_path)
        return nil
    }

    var cmd = cc + " -o " + shell_quote(out_path) + " " + shell_quote(c_path) + " lib/runtime.c -Ilib -pthread"
    var k_lib = 0
    while k_lib < oren_list_len(link_libs) {
        cmd = cmd + " " + shell_quote(link_libs[k_lib])
        k_lib = k_lib + 1
    }
    if no_gc { cmd = cmd + " -DOREN_NO_GC" }
    if enable_python {
        cmd = cmd + " -DOREN_ENABLE_PYTHON $(python3-config --cflags) $(python3-config --embed --ldflags)"
    }
    var res = oren_system(cmd)
    if res != 0 {
        print("Build failed")
        oren_exit(1)
    }
        if target == "macos" {
            if codesign_id != "" {
                var cs_cmd2 = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
                var cs_res2 = oren_system(cs_cmd2)
                if cs_res2 != 0 {
                print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                var ad_cmd2 = "codesign -s - --force " + shell_quote(out_path)
                var ad_res2 = oren_system(ad_cmd2)
                if ad_res2 != 0 {
                    print("codesign fallback failed")
                    oren_exit(1)
                }
            }
        }
    }
    if target == "macos" && notarize {
        var nt_cmd = ""
        if notary_profile != "" {
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --keychain-profile " + shell_quote(notary_profile) + " --wait"
        } else {
            var apple_id = oren_env("APPLE_ID")
            var apple_pass = oren_env("APPLE_ID_PASS")
            var apple_team = oren_env("APPLE_TEAM_ID")
            if apple_id == nil || apple_pass == nil || apple_team == nil {
                print("Notarization requested but APPLE_ID/APPLE_ID_PASS/APPLE_TEAM_ID or --notary-profile not set")
                oren_exit(1)
            }
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --apple-id " + shell_quote(apple_id) + " --password " + shell_quote(apple_pass) + " --team-id " + shell_quote(apple_team) + " --wait"
        }
        var nt_res = oren_system(nt_cmd)
        if nt_res != 0 {
            print("notarization failed")
            oren_exit(1)
        }
        var staple_cmd = "xcrun stapler staple " + shell_quote(out_path)
        var staple_res = oren_system(staple_cmd)
        if staple_res != 0 {
            print("staple failed")
            oren_exit(1)
        }
    }
    print("Build successful: " + out_path)
    if deterministic {
        var bsC = oren_read_bytes(out_path)
        if oren_is_err(bsC) {
            print("Failed to read artifact for hashing: " + out_path)
            var msgHC = oren_err_msg(bsC)
            if msgHC != nil { print(msgHC) }
            oren_exit(1)
        }
        _emit_artifact_hash("c", out_path, bsC)
    }
    return nil
}
