            } else if t == "If" {
                if st["consq"] != nil && st["consq"]["type"] == "Block" {
                    if sink_list_lit_into_if(st["consq"]) { changed = true }
                }
                if st["alt"] != nil && st["alt"]["type"] == "Block" {
                    if sink_list_lit_into_if(st["alt"]) { changed = true }
                }
            } else if t == "ExprStmt" {
                var e = st["expr"]
                if e != nil && e["type"] == "If" {
                    if e["consq"] != nil && e["consq"]["type"] == "Block" {
                        if sink_list_lit_into_if(e["consq"]) { changed = true }
                    }
                    if e["alt"] != nil && e["alt"]["type"] == "Block" {
                        if sink_list_lit_into_if(e["alt"]) { changed = true }
                    }
                }
            } else if t == "Switch" {
                var cases = st["cases"]
                if cases != nil {
                    var ci = 0
                    while ci < oren_list_len(cases) {
                        var c = cases[ci]
                        if c != nil && c["body"] != nil && c["body"]["type"] == "Block" {
                            if sink_list_lit_into_if(c["body"]) { changed = true }
                        }
                        ci = ci + 1
                    }
                }
                if st["default"] != nil && st["default"]["type"] == "Block" {
                    if sink_list_lit_into_if(st["default"]) { changed = true }
                }
            }
        }
        i = i + 1
    }
    return changed
}

