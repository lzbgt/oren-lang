                    {"type": "Identifier", "token": nil, "value": clear_fn},
                    [{"type": "Identifier", "token": nil, "value": nm}])
                ss[i] = {"type": "ExprStmt", "token": st["token"], "expr": call}
                var init = {"type": "Var", "token": st["token"], "name": st["name"], "value": v}
                if st["attrs"] != nil { init["attrs"] = st["attrs"] }
                oren_list_push(hoists, init)
                _opt_arena_trace("[arena_loop] list_reuse name=" + nm + " kind=" + kind)
                changed = true
            }
        }
        i = i + 1
    }
    if changed != true || hoists == nil || oren_list_len(hoists) == 0 { return changed }
    var bs = block["stmts"]
    if bs == nil { return changed }
    var out = []
    var inserted = false
    var bi = 0
    while bi < oren_list_len(bs) {
        var cur = bs[bi]
        if inserted != true && cur == loop_stmt {
            var hi = 0
            while hi < oren_list_len(hoists) {
                oren_list_push(out, hoists[hi])
                hi = hi + 1
            }
            inserted = true
        }
        oren_list_push(out, cur)
        bi = bi + 1
    }
    if inserted != true && idx >= 0 {
        // Fallback: insert at the original index if the loop statement was replaced.
        var out2 = []
        var bi2 = 0
        while bi2 < oren_list_len(out) {
            if bi2 == idx {
                var hi2 = 0
                while hi2 < oren_list_len(hoists) {
                    oren_list_push(out2, hoists[hi2])
                    hi2 = hi2 + 1
                }
            }
            oren_list_push(out2, out[bi2])
            bi2 = bi2 + 1
        }
        out = out2
    }
    block["stmts"] = out
    return true
}

fn _opt_rewrite_loop_list_reset_in_stmt(stmt, reset_vars, block, idx, loop_body) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Assign" {
        var nm = opthelp.is_ident(stmt["name"])
        if nm != nil && _opt_expr_is_empty_list_ctor(stmt["value"]) == true {
            var kind = _opt_safe_var_kind(reset_vars, nm)
            if kind == nil {
                if loop_body != nil && _opt_loop_first_assign_dominates(loop_body, nm) != true {
                    _opt_add_safe_var(reset_vars, nm, "skip")
                    _opt_arena_trace("[arena_loop] list_reset skip=assign_not_dominate name=" + nm)
                    return false
                }
                if _opt_block_has_unsafe_list_use_for_reset(block, nm) == true {
                    _opt_add_safe_var(reset_vars, nm, "skip")
                    _opt_arena_trace("[arena_loop] list_reset skip=unsafe name=" + nm)
                    return false
                }
                var k = _opt_find_list_ctor_before(block, idx, nm)
                if k == nil {
                    _opt_add_safe_var(reset_vars, nm, "skip")
                    _opt_arena_trace("[arena_loop] list_reset skip=kind name=" + nm)
                    return false
                }
                _opt_add_safe_var(reset_vars, nm, k)
                kind = k
            }
            if kind != nil && _opt_str_eq(kind, "skip") != true {
                var clear_fn = "oren_list_clear_unchecked"
                if _opt_str_eq(kind, "list_int") { clear_fn = "oren_list_int_clear_unchecked" }
                var call = ast.new_call(stmt["token"],
                    {"type": "Identifier", "token": nil, "value": clear_fn},
                    [{"type": "Identifier", "token": nil, "value": nm}])
                stmt["type"] = "ExprStmt"
                stmt["expr"] = call
                stmt["name"] = nil
                stmt["value"] = nil
                _opt_arena_trace("[arena_loop] list_reset name=" + nm + " kind=" + kind)
                return true
            }
        }
        return false
    }
    if t == "Set" {
        var left = stmt["left"]
        if left != nil && left["type"] == "Identifier" {
            var nm2 = left["value"]
            if nm2 != nil && _opt_expr_is_empty_list_ctor(stmt["value"]) == true {
                var kind2 = _opt_safe_var_kind(reset_vars, nm2)
                if kind2 == nil {
                    if loop_body != nil && _opt_loop_first_assign_dominates(loop_body, nm2) != true {
                        _opt_add_safe_var(reset_vars, nm2, "skip")
                        _opt_arena_trace("[arena_loop] list_reset skip=assign_not_dominate name=" + nm2)
                        return false
                    }
                    if _opt_block_has_unsafe_list_use_for_reset(block, nm2) == true {
                        _opt_add_safe_var(reset_vars, nm2, "skip")
                        _opt_arena_trace("[arena_loop] list_reset skip=unsafe name=" + nm2)
                        return false
                    }
                    var k2 = _opt_find_list_ctor_before(block, idx, nm2)
                    if k2 == nil {
                        _opt_add_safe_var(reset_vars, nm2, "skip")
                        _opt_arena_trace("[arena_loop] list_reset skip=kind name=" + nm2)
                        return false
                    }
                    _opt_add_safe_var(reset_vars, nm2, k2)
                    kind2 = k2
                }
                if kind2 != nil && _opt_str_eq(kind2, "skip") != true {
                    var clear_fn2 = "oren_list_clear_unchecked"
                    if _opt_str_eq(kind2, "list_int") { clear_fn2 = "oren_list_int_clear_unchecked" }
                    var call2 = ast.new_call(stmt["token"],
                        {"type": "Identifier", "token": nil, "value": clear_fn2},
                        [{"type": "Identifier", "token": nil, "value": nm2}])
                    stmt["type"] = "ExprStmt"
                    stmt["expr"] = call2
                    stmt["left"] = nil
                    stmt["value"] = nil
                    _opt_arena_trace("[arena_loop] list_reset name=" + nm2 + " kind=" + kind2)
                    return true
                }
            }
        }
        return false
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss == nil { return false }
        var changed = false
        var i = 0
        while i < oren_list_len(ss) {
            if _opt_rewrite_loop_list_reset_in_stmt(ss[i], reset_vars, block, idx, loop_body) == true { changed = true }
            i = i + 1
        }
        return changed
    }
    if t == "If" {
        var changed2 = false
        if _opt_rewrite_loop_list_reset_in_stmt(stmt["consq"], reset_vars, block, idx, loop_body) == true { changed2 = true }
        if stmt["alt"] != nil {
            if _opt_rewrite_loop_list_reset_in_stmt(stmt["alt"], reset_vars, block, idx, loop_body) == true { changed2 = true }
        }
        return changed2
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        var changed3 = false
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_rewrite_loop_list_reset_in_stmt(c["body"], reset_vars, block, idx, loop_body) == true {
                    changed3 = true
                }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil {
            if _opt_rewrite_loop_list_reset_in_stmt(stmt["default"], reset_vars, block, idx, loop_body) == true {
                changed3 = true
            }
        }
        return changed3
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            var changed4 = false
            if _opt_rewrite_loop_list_reset_in_stmt(e["consq"], reset_vars, block, idx, loop_body) == true { changed4 = true }
            if e["alt"] != nil {
                if _opt_rewrite_loop_list_reset_in_stmt(e["alt"], reset_vars, block, idx, loop_body) == true { changed4 = true }
            }
            return changed4
        }
        if e != nil && e["type"] == "Switch" {
            var cases2 = e["cases"]
            var changed5 = false
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c2 = cases2[ci2]
                    if c2 != nil && _opt_rewrite_loop_list_reset_in_stmt(c2["body"], reset_vars, block, idx, loop_body) == true {
                        changed5 = true
                    }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil {
                if _opt_rewrite_loop_list_reset_in_stmt(e["default"], reset_vars, block, idx, loop_body) == true {
                    changed5 = true
                }
            }
            return changed5
        }
        return false
    }
    if t == "While" || t == "For" || t == "Function" { return false }
    return false
}

fn _opt_rewrite_loop_list_reset(block, idx, loop_stmt) {
    if block == nil || block["type"] != "Block" { return false }
    if loop_stmt == nil { return false }
    var body = loop_stmt["body"]
    if body == nil || body["type"] != "Block" { return false }
    var reset_vars = []
    return _opt_rewrite_loop_list_reset_in_stmt(body, reset_vars, block, idx, body)
}

fn _opt_expr_is_empty_list_ctor(expr) {
    if expr == nil { return false }
    if _opt_expr_is_empty_list_lit(expr) == true { return true }
    if expr["type"] == "Call" {
        var fn_expr = expr["fn"]
        if fn_expr != nil && fn_expr["type"] == "Identifier" {
            var nm = fn_expr["value"]
            if _opt_str_eq(nm, "oren_new_list") || _opt_str_eq(nm, "oren_arena_new_list") ||
               _opt_str_eq(nm, "oren_arena_new_list_auto") || _opt_str_eq(nm, "STD_new_list") ||
               _opt_str_eq(nm, "STD_arena_new_list") || _opt_str_eq(nm, "oren_new_list_int") ||
               _opt_str_eq(nm, "oren_arena_new_list_int") || _opt_str_eq(nm, "oren_arena_new_list_int_auto") {
                var args = expr["args"]
                if args != nil && oren_list_len(args) == 1 {
                    var a0 = args[0]
                    if a0 != nil && a0["type"] == "Integer" && _opt_str_eq(a0["value"], "0") { return true }
                }
            }
        }
    }
    return false
}

fn _opt_expr_is_list_ctor_any(expr) {
    if expr == nil { return false }
    if _opt_expr_is_empty_list_lit(expr) == true { return true }
    if expr["type"] == "Call" {
        var fn_expr = expr["fn"]
        if fn_expr != nil && fn_expr["type"] == "Identifier" {
            var nm = fn_expr["value"]
            if _opt_str_eq(nm, "oren_new_list") || _opt_str_eq(nm, "oren_list_new_cap") ||
               _opt_str_eq(nm, "oren_arena_new_list") || _opt_str_eq(nm, "oren_arena_new_list_auto") ||
               _opt_str_eq(nm, "STD_new_list") || _opt_str_eq(nm, "STD_arena_new_list") ||
               _opt_str_eq(nm, "oren_new_list_int") || _opt_str_eq(nm, "oren_arena_new_list_int") ||
               _opt_str_eq(nm, "oren_arena_new_list_int_auto") {
                return true
            }
        }
    }
    return false
}

fn _opt_insert_list_reserve_in_block(block, safe_vars) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var out = []
    var changed = false
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        var injected = false
        if st != nil && (st["type"] == "Var" || st["type"] == "Assign") {
            var nm = opthelp.is_ident(st["name"])
            var kind = _opt_safe_var_kind(safe_vars, nm)
            if nm != nil && kind != nil && _opt_expr_is_empty_list_ctor(st["value"]) == true {
                var j = i + 1
                while j < oren_list_len(ss) {
                    var stj = ss[j]
                    if stj == nil { j = j + 1; continue }
                    if bounds._opt_stmt_assigns_ident(stj, nm) == true { break }
                    if _opt_stmt_has_ident(stj, nm) == true {
                        if stj["type"] == "While" || stj["type"] == "For" {
                            var bound = bounds._opt_loop_simple_bound_value(block, j, stj)
                            if bound != nil && bound > 0 && bounds._opt_stmt_has_list_len_mutation(stj["body"], nm) == true {
                                var reserve_fn = "oren_list_reserve"
                                if kind == "list_int" { reserve_fn = "oren_list_int_reserve" }
                                var call = ast.new_call(stj["token"],
                                    {"type": "Identifier", "token": nil, "value": reserve_fn},
                                    [{"type": "Identifier", "token": nil, "value": nm},
                                     {"type": "Integer", "token": nil, "value": oren_int_to_string(bound)}])
                                oren_list_push(out, st)
                                oren_list_push(out, {"type": "ExprStmt", "token": stj["token"], "expr": call})
                                injected = true
                                changed = true
                            }
                        }
                        break
                    }
                    j = j + 1
                }
            }
        }
        if injected != true { oren_list_push(out, st) }
        i = i + 1
    }
    if changed { block["stmts"] = out }
    return changed
}
