                        i = i + 1
                        continue
                    }
                }
                if _opt_rewrite_new_list_in_stmt(st, safe_vars, arena_ctor, arena_int_ctor) { changed = true }
            }
            oren_list_push(out, st)
            i = i + 1
        }
        if changed { stmt["stmts"] = out }
        return changed
    }
    if t == "While" || t == "For" { return false }
    return false
