    if t == "Assign" {
        var nm2 = opthelp.is_ident(stmt["name"])
        var kind2b = _opt_safe_var_kind(safe_vars, nm2)
        if nm2 != nil && kind2b != nil {
            var v2 = stmt["value"]
            var kindb = _opt_expr_is_new_list_call(v2)
            if kindb != nil {
