            if kind != nil {
                var fn_expr = v["fn"]
                if fn_expr != nil && fn_expr["type"] == "Identifier" {
                    if kind2 == "list" || kind2 == "list_lit" { fn_expr["value"] = arena_ctor }
                    else { fn_expr["value"] = arena_int_ctor }
