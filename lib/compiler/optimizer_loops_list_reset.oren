                if fn_exprb != nil && fn_exprb["type"] == "Identifier" {
                    if kind2b == "list" || kind2b == "list_lit" { fn_exprb["value"] = arena_ctor }
                    else { fn_exprb["value"] = arena_int_ctor }
                    changed = true
                }
            } else if kind2b == "list_lit" && _opt_expr_is_empty_list_lit(v2) {
                stmt["value"] = ast.new_call(stmt["token"],
                    {"type": "Identifier", "token": nil, "value": arena_ctor},
                    [{"type": "Integer", "token": nil, "value": "0"}])
                changed = true
            }
        }
        return changed
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss == nil { return false }
        var out = []
        var i = 0
        while i < oren_list_len(ss) {
            var st = ss[i]
            if st != nil {
                var nm3 = opthelp.is_ident(st["name"])
                var k3 = _opt_safe_var_kind(safe_vars, nm3)
                if (st["type"] == "Var" || st["type"] == "Assign") && nm3 != nil && k3 == "list_lit" {
