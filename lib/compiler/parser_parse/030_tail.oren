
fn parse_call_args(p) {
    var args = []
    p["_call_spread"] = nil
    if peek_is(p, token.TOK_RPAREN) {
        parser_next_token(p)
        return args
    }
    parser_next_token(p)
    var a0 = parse_expression(p, LOWEST)
    if peek_is(p, token.TOK_ELLIPSIS) {
        // Call-site spread: f(xs...)
        // - only one spread allowed
        // - spread must be last (before ')')
        p["_call_spread"] = a0
        parser_next_token(p) // ...
        if !peek_is(p, token.TOK_RPAREN) {
            parser_add_error(p, "spread '...' must be the last argument")
        }
    } else {
        oren_list_push(args, a0)
    }
    while peek_is(p, token.TOK_COMMA) {
        parser_next_token(p)
        parser_next_token(p)
        if p["_call_spread"] != nil {
            parser_add_error(p, "spread '...' must be the last argument")
            // Still parse to make progress.
            parse_expression(p, LOWEST)
            continue
        }
        var ax = parse_expression(p, LOWEST)
        if peek_is(p, token.TOK_ELLIPSIS) {
            p["_call_spread"] = ax
            parser_next_token(p) // ...
            if !peek_is(p, token.TOK_RPAREN) {
                parser_add_error(p, "spread '...' must be the last argument")
            }
        } else {
            oren_list_push(args, ax)
        }
    }
    expect_peek(p, token.TOK_RPAREN)
    return args
}

fn parse_member(p, left) {
    var tok = p["cur"]
    if !expect_peek_ident_like(p, "member name") { return nil }
    var prop = ast.new_identifier(p["cur"])

    // Enum dot-variant sugar:
    //
    //   enum Option { None, Some(x) }
    //   Option.None      -> Option_None()          (value)
    //   Option.None()    -> Option_None()          (explicit call also ok)
    //   Option.Some      -> Option_Some            (function value)
    //   Option.Some(123) -> Option_Some(123)
    //
    // This is intentionally shallow and parser-local: it does not add new AST nodes
    // and keeps backends unchanged (it rewrites to existing constructor fns).
    if left != nil && left["type"] == "Identifier" {
        var enum_name = left["value"]
        var variants = p["enum_variants"][enum_name]
        if variants != nil {
            var vname = prop["value"]
            var arity = variants[vname]
            if arity != nil {
                var fn_name = enum_name + "_" + vname
                var fn_ident = ast.new_identifier(token.new_token(token.TOK_IDENT, fn_name))
                if arity == 0 {
                    if peek_is(p, token.TOK_LPAREN) {
                        // Allow explicit `Option.None()` to parse as a normal call.
                        return fn_ident
                    }
                    // Bare `Option.None` means "construct the value".
                    return ast.new_call(token.new_token(token.TOK_LPAREN, "("), fn_ident, [])
                }
                // For payload variants, `Option.Some` is a function value, and the
                // normal call parsing handles `Option.Some(...)`.
                return fn_ident
            }
        }
    }

    return ast.new_member(tok, left, prop)
}

fn parse_array(p) {
    var tok = p["cur"]
    var elements = parse_expression_list(p, token.TOK_RBRACKET)
    return ast.new_array(tok, elements)
}

fn parse_expression_list(p, endTok) {
    var items = []
    if peek_is(p, endTok) {
        parser_next_token(p)
        return items
    }
    parser_next_token(p)
    oren_list_push(items, parse_expression(p, LOWEST))
    while peek_is(p, token.TOK_COMMA) {
        parser_next_token(p)
        parser_next_token(p)
        oren_list_push(items, parse_expression(p, LOWEST))
    }
    expect_peek(p, endTok)
    return items
}

fn parse_index(p, left) {
    var tok = p["cur"]
    parser_next_token(p)
    var idx = parse_expression(p, LOWEST)
    expect_peek(p, token.TOK_RBRACKET)
    return ast.new_index(tok, left, idx)
}

fn parse_hash(p) {
    var tok = p["cur"]
    var pairs = [] // store as list of {"key":..., "value":...}
    var cont = true
    while cont {
        if peek_is(p, token.TOK_RBRACE) {
            cont = false
        } else {
            parser_next_token(p)
            var key = parse_expression(p, LOWEST)
            if !expect_peek(p, token.TOK_COLON) {
                cont = false
            } else {
                parser_next_token(p)
                var val = parse_expression(p, LOWEST)
                oren_list_push(pairs, {"key": key, "value": val})

                if peek_is(p, token.TOK_RBRACE) {
                    // done
                } else {
                    if peek_is(p, token.TOK_COMMA) {
                        parser_next_token(p)
                    } else {
                        cont = false
                    }
                }
            }
        }
    }
    expect_peek(p, token.TOK_RBRACE)
    return ast.new_hash(tok, pairs)
}

fn parse_while(p) {
    var tok = p["cur"]
    parser_next_token(p)
    var cond = parse_expression(p, LOWEST)
    if !expect_peek(p, token.TOK_LBRACE) { return nil }
    var body = parse_block(p)
    return ast.new_while(tok, cond, body)
}

fn parse_break(p) {
    var tok = p["cur"]
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_break(tok)
}

fn parse_continue(p) {
    var tok = p["cur"]
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_continue(tok)
}

fn parse_yield(p) {
    var tok = p["cur"]
    if yield_has_inline_value(p, tok) {
        var expr = parse_yield_expr(p)
        if expr == nil { return nil }
        if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
        return ast.new_expr_stmt(tok, expr)
    }
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    var ident_tok = token.new_token(token.TOK_IDENT, "oren_yield_stmt")
    var ident = ast.new_identifier(ident_tok)
    var call = ast.new_call(ident_tok, ident, [])
    call["yield_stmt"] = true
    var stmt = ast.new_expr_stmt(tok, call)
    stmt["yield_stmt"] = true
    return stmt
}

fn yield_has_inline_value(p, tok) {
    if tok == nil { return false }
    var cur_line = -1
    if tok["line"] != nil { cur_line = tok["line"] }
    if cur_line < 0 { return false }
    var peek = p["peek"]
    if peek == nil { return false }
    var peek_line = -2
    if peek["line"] != nil { peek_line = peek["line"] }
    if peek_line != cur_line { return false }
    var peek_ty = peek["type"]
    if peek_ty == token.TOK_SEMICOLON { return false }
    if peek_ty == token.TOK_COMMA { return false }
    if peek_ty == token.TOK_RPAREN { return false }
    if peek_ty == token.TOK_RBRACKET { return false }
    if peek_ty == token.TOK_RBRACE { return false }
    if peek_ty == token.TOK_EOF { return false }
    return true
}

fn yield_value_expr_call(tok, value_expr, explicit_value) {
    var ident_tok = token.new_token(token.TOK_IDENT, "oren_yield_value")
    var ident = ast.new_identifier(ident_tok)
    var call = ast.new_call(ident_tok, ident, [value_expr])
    call["yield_value_expr"] = true
    call["yield_token"] = tok
    call["yield_value_explicit"] = explicit_value
    return call
}

fn yield_exchange_expr_call(tok, yield_ch_expr, resume_ch_expr, value_expr, explicit_value) {
    var ident_tok = token.new_token(token.TOK_IDENT, "oren_yield_exchange")
    var ident = ast.new_identifier(ident_tok)
    var call = ast.new_call(ident_tok, ident, [yield_ch_expr, resume_ch_expr, value_expr])
    call["yield_exchange_expr"] = true
    call["yield_token"] = tok
    call["yield_exchange_explicit_value"] = explicit_value
    call["yield_exchange_source_syntax"] = true
    return call
}

fn yield_exchange_context_expr_call(tok, ctx_expr, value_expr, explicit_value) {
    var ident_tok = token.new_token(token.TOK_IDENT, "_oren_generator_context_exchange")
    var ident = ast.new_identifier(ident_tok)
    var call = ast.new_call(ident_tok, ident, [ctx_expr, value_expr])
    call["yield_exchange_expr"] = true
    call["yield_token"] = tok
    call["yield_exchange_explicit_value"] = explicit_value
    call["yield_exchange_source_syntax"] = true
    return call
}

fn yield_delegate_expr_call(tok, ctx_expr, inner_expr, has_context) {
    var ident_tok = token.new_token(token.TOK_IDENT, "oren_generator_delegate")
    var ident = ast.new_identifier(ident_tok)
    var ctx_arg = ctx_expr
    if has_context != true {
        ctx_arg = ast.new_nil(token.new_token(token.TOK_NIL, "nil"))
    }
    var call = ast.new_call(ident_tok, ident, [ctx_arg, inner_expr])
    call["yield_delegate_expr"] = true
    call["yield_token"] = tok
    call["yield_delegate_source_syntax"] = true
    call["yield_delegate_missing_context"] = (has_context != true)
    if has_context == true {
        call["yield_delegate_syntax_kind"] = "yield_from_in_context"
    } else {
        call["yield_delegate_syntax_kind"] = "yield_from"
    }
    return call
}

fn generator_finalize_expr_call(tok, ctx_expr, hook_expr, has_context) {
    var ident_tok = token.new_token(token.TOK_IDENT, "oren_generator_on_finalize")
    var ident = ast.new_identifier(ident_tok)
    var args = [hook_expr]
    if has_context == true {
        args = [ctx_expr, hook_expr]
    }
    var call = ast.new_call(ident_tok, ident, args)
    call["generator_finalize_expr"] = true
    call["generator_finalize_token"] = tok
    call["generator_finalize_source_syntax"] = true
    call["generator_finalize_missing_context"] = (has_context != true)
    if has_context == true {
        call["generator_finalize_syntax_kind"] = "defer_in_context"
    } else {
        call["generator_finalize_syntax_kind"] = "defer"
    }
    return call
}

fn yield_has_exchange_clause(p, tok) {
    if tok == nil { return false }
    var cur_line = -1
    if tok["line"] != nil { cur_line = tok["line"] }
    if cur_line < 0 { return false }
    var peek = p["peek"]
    if peek == nil { return false }
    if peek["type"] != token.TOK_IN { return false }
    var peek_line = -2
    if peek["line"] != nil { peek_line = peek["line"] }
    if peek_line != cur_line { return false }
    return true
}

fn yield_has_delegate_clause(p, tok) {
    if tok == nil { return false }
    var cur_line = -1
    if tok["line"] != nil { cur_line = tok["line"] }
    if cur_line < 0 { return false }
    var peek = p["peek"]
    if peek == nil { return false }
    if peek["type"] != token.TOK_IDENT { return false }
    if peek["literal"] != "from" { return false }
    var peek_line = -2
    if peek["line"] != nil { peek_line = peek["line"] }
    if peek_line != cur_line { return false }
    return true
}

fn parse_yield_exchange_clause(p, tok, value_expr, explicit_value) {
    parser_next_token(p) // 'in'
    if peek_is(p, token.TOK_LPAREN) {
        parser_next_token(p) // '('
        parser_next_token(p)
        var yield_ch = parse_expression(p, LOWEST)
        if yield_ch == nil { return nil }
        if !expect_peek(p, token.TOK_COMMA) {
            parser_add_error(p, "yield exchange expects ',' between yield and resume channels")
            return nil
        }
        parser_next_token(p)
        var resume_ch = parse_expression(p, LOWEST)
        if resume_ch == nil { return nil }
        if !expect_peek(p, token.TOK_RPAREN) {
            parser_add_error(p, "yield exchange expects closing ')'")
            return nil
        }
        return yield_exchange_expr_call(tok, yield_ch, resume_ch, value_expr, explicit_value)
    }
    parser_next_token(p)
    var ctx_expr = parse_expression(p, LOWEST)
    if ctx_expr == nil { return nil }
    return yield_exchange_context_expr_call(tok, ctx_expr, value_expr, explicit_value)
}

fn parse_yield_delegate_clause(p, tok) {
    parser_next_token(p) // 'from'
    parser_next_token(p)
    var inner_expr = parse_expression(p, LOWEST)
    if inner_expr == nil { return nil }
    if yield_has_exchange_clause(p, tok) != true {
        return yield_delegate_expr_call(tok, nil, inner_expr, false)
    }
    parser_next_token(p) // 'in'
    parser_next_token(p)
    var ctx_expr = parse_expression(p, LOWEST)
    if ctx_expr == nil { return nil }
    return yield_delegate_expr_call(tok, ctx_expr, inner_expr, true)
}

fn parse_yield_expr(p) {
    var tok = p["cur"]
    var value_expr = ast.new_nil(token.new_token(token.TOK_NIL, "nil"))
    var explicit_value = false
    if yield_has_delegate_clause(p, tok) {
        return parse_yield_delegate_clause(p, tok)
    }
    if yield_has_exchange_clause(p, tok) {
        return parse_yield_exchange_clause(p, tok, value_expr, explicit_value)
    }
    if yield_has_inline_value(p, tok) {
        parser_next_token(p)
        value_expr = parse_expression(p, LOWEST)
        if value_expr == nil { return nil }
        explicit_value = true
    }
    if yield_has_exchange_clause(p, tok) {
        return parse_yield_exchange_clause(p, tok, value_expr, explicit_value)
    }
    return yield_value_expr_call(tok, value_expr, explicit_value)
}

fn defer_has_context_clause(p) {
    if !peek_is(p, token.TOK_IN) { return false }
    var cur = p["cur"]
    if cur == nil { return false }
    var cur_line = -1
    if cur["line"] != nil { cur_line = cur["line"] }
    if cur_line < 0 { return false }
    var peek_line = -2
    if p["peek"]["line"] != nil { peek_line = p["peek"]["line"] }
    return peek_line == cur_line
}

fn parse_defer_stmt(p) {
    var tok = p["cur"]
    if !expect_peek(p, token.TOK_LBRACE) { return nil }
    var hook_body = parse_block(p)
    if hook_body == nil { return nil }
    var hook_tok = token.new_token(token.TOK_OR, "||")
    if tok["file"] != nil { hook_tok["file"] = tok["file"] }
    if tok["line"] != nil { hook_tok["line"] = tok["line"] }
    if tok["col"] != nil { hook_tok["col"] = tok["col"] }
    if tok["pos"] != nil { hook_tok["pos"] = tok["pos"] }
    if tok["end"] != nil { hook_tok["end"] = tok["end"] }
    var hook_expr = ast.new_function(hook_tok, "", [], hook_body)
    var call = nil
    if defer_has_context_clause(p) == true {
        parser_next_token(p) // 'in'
        parser_next_token(p)
        var ctx_expr = parse_expression(p, LOWEST)
        if ctx_expr == nil { return nil }
        call = generator_finalize_expr_call(tok, ctx_expr, hook_expr, true)
    } else {
        call = generator_finalize_expr_call(tok, nil, hook_expr, false)
    }
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_expr_stmt(tok, call)
}

fn parse_for_init(p) {
    if cur_is(p, token.TOK_LET) { return parse_var(p) }
    if cur_is(p, token.TOK_IDENT) {
        if peek_is(p, token.TOK_DECLARE) { return parse_short_var(p) }
        if peek_is(p, token.TOK_COLON) { return parse_typed_short_var(p) }
        return parse_assign_or_expr_stmt(p)
    }
    return parse_expr_stmt(p)
}

fn parse_for_post(p) {
    if cur_is(p, token.TOK_LET) {
        parser_add_error(p, "for post does not allow var declarations")
        return nil
    }
    if cur_is(p, token.TOK_IDENT) {
        if peek_is(p, token.TOK_DECLARE) {
            parser_add_error(p, "for post does not allow :=")
            return nil
        }
        if peek_is(p, token.TOK_COLON) {
            parser_add_error(p, "for post does not allow type annotations")
            return nil
        }
        return parse_assign_or_expr_stmt(p)
    }
    return parse_expr_stmt(p)
}

fn parse_for(p) {
    var tok = p["cur"]

    // for { ... }
    if peek_is(p, token.TOK_LBRACE) {
        parser_next_token(p)
        var body = parse_block(p)
        return ast.new_for(tok, nil, nil, nil, body)
    }

    // Move to first token after `for`.
    parser_next_token(p)

    // Iterator sugar:
    //   for <ident> in <expr> { <body> }
    //
    // Desugars to a 3-clause `for` using an internal state list and a runtime iterator hook:
    //   var __oren_forin_N = [<expr>, 0, 1, [0, 0]]
    //   for ; __oren_forin_N[2] != 0; __oren_forin_N[1] = __oren_forin_N[1] + 1 {
    //       var __oren_forinr_N = oren_iter_next(__oren_forin_N[0], __oren_forin_N[1], __oren_forin_N[3]) // -> [ok, value]
    //       __oren_forin_N[3] = __oren_forinr_N
    //       __oren_forin_N[2] = __oren_forinr_N[0]
    //       if __oren_forin_N[2] != 0 {
    //           var <ident> = __oren_forinr_N[1]
    //           <body>
    //       }
    //   }
    //
    // Notes:
    // - The internal names use a reserved `__oren_` prefix. User code should not define
    //   symbols with this prefix.
    // - This keeps backends minimal: it relies only on existing `for`, indexing, and `oren_list_len`.
    if cur_is(p, token.TOK_IDENT) && (peek_is(p, token.TOK_IN) || peek_is(p, token.TOK_COLON)) {
        var user_name = ast.new_identifier(p["cur"])
        ident_prefix_validate(p, user_name["value"], "for-in variable")

        // Optional iterator variable annotation:
        //   for x: u8 in bytes { ... }
        if peek_is(p, token.TOK_COLON) {
            parser_next_token(p) // :
            var tname = parse_type_name_after_colon(p)
            if tname == nil { return nil }
            user_name["ann_type"] = tname
            if !peek_is(p, token.TOK_IN) {
                parser_add_error(p, "expected 'in' after for-in type annotation")
                return nil
            }
        }
        var st_name = parser_gensym(p, "__oren_forin_")
        var res_name = parser_gensym(p, "__oren_forinr_")
        var st_ident = {"type": "Identifier", "token": token.new_token(token.TOK_IDENT, st_name), "value": st_name}
        var res_ident = {"type": "Identifier", "token": token.new_token(token.TOK_IDENT, res_name), "value": res_name}

        // consume 'in'
        parser_next_token(p)
        // move to iterable expr
        parser_next_token(p)
        var iterable = parse_expression(p, LOWEST)
        if iterable == nil { return nil }
        if !expect_peek(p, token.TOK_LBRACE) { return nil }
        var user_body = parse_block(p)

        var zero = {"type": "Integer", "token": token.new_token(token.TOK_INT, "0"), "value": "0"}
        var one = {"type": "Integer", "token": token.new_token(token.TOK_INT, "1"), "value": "1"}
        var two = {"type": "Integer", "token": token.new_token(token.TOK_INT, "2"), "value": "2"}
        var three = {"type": "Integer", "token": token.new_token(token.TOK_INT, "3"), "value": "3"}
        var pair_init = {"type": "Array", "token": token.new_token(token.TOK_LBRACKET, "["), "elements": [zero, zero]}

        // Optimization (rolling v1 hook): if the iterable is a bare identifier, we don't need
        // to stash it in the internal state list (ident evaluation is side-effect-free), and
        // keeping it as an Identifier lets later lowering passes consult type annotations for
        // iterator extensions (e.g. an `Iterable` trait).
        var st_idx = nil
        var st_ok = nil
        var st_pair = nil
        var container_expr = nil
        var init_stmt = nil

        if iterable["type"] == "Identifier" {
            // state: [idx, ok, out_pair]
            var state_init3 = {"type": "Array", "token": token.new_token(token.TOK_LBRACKET, "["), "elements": [zero, one, pair_init]}
            init_stmt = ast.new_var(token.new_token(token.TOK_LET, "var"), st_ident, state_init3)
            st_idx = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, zero)
            st_ok = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, one)
            st_pair = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, two)
            container_expr = iterable
        } else {
            // state: [iterable, idx, ok, out_pair]
            var state_init4 = {"type": "Array", "token": token.new_token(token.TOK_LBRACKET, "["), "elements": [iterable, zero, one, pair_init]}
            init_stmt = ast.new_var(token.new_token(token.TOK_LET, "var"), st_ident, state_init4)
            container_expr = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, zero)
            st_idx = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, one)
            st_ok = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, two)
            st_pair = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, three)
        }

        // cond: ok != 0
        var cond_expr = ast.new_infix(token.new_token(token.TOK_NOT_EQ, "!="), st_ok, "!=", zero)

        // post: idx = idx + 1
        var inc_expr = ast.new_infix(token.new_token(token.TOK_PLUS, "+"), st_idx, "+", one)
        var post_stmt = nil
        if iterable["type"] == "Identifier" {
            post_stmt = ast.new_set(token.new_token(token.TOK_ASSIGN, "="), ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, zero), inc_expr)
        } else {
            post_stmt = ast.new_set(token.new_token(token.TOK_ASSIGN, "="), ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, one), inc_expr)
        }

        // body:
        //   var @forinr = <file-local generator-aware for-in bridge>(container, idx, out_pair)
        //   out_pair = @forinr
        //   ok = @forinr[0]
        //   if ok != 0 { var user = @forinr[1]; <user_body> }
        var fn_next_name = _generator_forin_bridge_name(p)
        var fn_next = {"type": "Identifier", "token": token.new_token(token.TOK_IDENT, fn_next_name), "value": fn_next_name}
        var call_next = ast.new_call(token.new_token(token.TOK_LPAREN, "("), fn_next, [container_expr, st_idx, st_pair])
        var bind_res = ast.new_var(token.new_token(token.TOK_LET, "var"), res_ident, call_next)

        var res0 = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), res_ident, zero)
        var res1 = ast.new_index(token.new_token(token.TOK_LBRACKET, "["), res_ident, one)

        // out_pair = @forinr
        var set_pair = nil
        if iterable["type"] == "Identifier" {
            set_pair = ast.new_set(token.new_token(token.TOK_ASSIGN, "="), ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, two), res_ident)
        } else {
            set_pair = ast.new_set(token.new_token(token.TOK_ASSIGN, "="), ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, three), res_ident)
        }

        // ok = @forinr[0]
        var set_ok = nil
        if iterable["type"] == "Identifier" {
            set_ok = ast.new_set(token.new_token(token.TOK_ASSIGN, "="), ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, one), res0)
        } else {
            set_ok = ast.new_set(token.new_token(token.TOK_ASSIGN, "="), ast.new_index(token.new_token(token.TOK_LBRACKET, "["), st_ident, two), res0)
        }

        // if @forin[2] != 0 { var user = @forinr[1]; <user_body> }
        var guard_cond = ast.new_infix(token.new_token(token.TOK_NOT_EQ, "!="), st_ok, "!=", zero)
        var guard_block = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
        var bind_user = ast.new_var(token.new_token(token.TOK_LET, "var"), user_name, res1)
        oren_list_push(guard_block["stmts"], bind_user)
        var bi = 0
        while bi < oren_list_len(user_body["stmts"]) {
            oren_list_push(guard_block["stmts"], user_body["stmts"][bi])
            bi = bi + 1
        }
        var if_guard = ast.new_if(token.new_token(token.TOK_IF, "if"), guard_cond, guard_block, nil)
        var if_guard_stmt = ast.new_expr_stmt(token.new_token(token.TOK_IF, "if"), if_guard)

        var body_block = ast.new_block(token.new_token(token.TOK_LBRACE, "{"))
        oren_list_push(body_block["stmts"], bind_res)
        oren_list_push(body_block["stmts"], set_pair)
        oren_list_push(body_block["stmts"], set_ok)
        oren_list_push(body_block["stmts"], if_guard_stmt)

        return ast.new_for(tok, init_stmt, cond_expr, post_stmt, body_block)
    }

    var init = nil
    var cond = nil
    var post = nil

    // for cond { ... } or for init; cond; post { ... }
    if !cur_is(p, token.TOK_SEMICOLON) {
        var first = parse_for_init(p)
        if first == nil { return nil }

        // Condition-only form: `for <expr> { ... }`
        if first["type"] == "ExprStmt" {
            if peek_is(p, token.TOK_LBRACE) {
                cond = first["expr"]
                parser_next_token(p)
                var body2 = parse_block(p)
                return ast.new_for(tok, nil, cond, nil, body2)
            }
        }

        init = first

        // Three-clause form: ensure we consumed `;` after init.
        if !cur_is(p, token.TOK_SEMICOLON) {
            if !expect_peek(p, token.TOK_SEMICOLON) { return nil }
        }
    }

    // Parse condition (may be empty) up to second `;`.
    parser_next_token(p)
    if cur_is(p, token.TOK_SEMICOLON) {
        cond = nil
    } else {
        cond = parse_expression(p, LOWEST)
        if !expect_peek(p, token.TOK_SEMICOLON) { return nil }
    }

    // Parse post (may be empty) up to `{`.
    parser_next_token(p)
    if cur_is(p, token.TOK_LBRACE) {
        post = nil
        var body3 = parse_block(p)
        return ast.new_for(tok, init, cond, post, body3)
    }

    post = parse_for_post(p)
    if post == nil { return nil }

    if !expect_peek(p, token.TOK_LBRACE) { return nil }
    var body4 = parse_block(p)
    return ast.new_for(tok, init, cond, post, body4)
}

fn parse_import(p) {
    var tok = p["cur"]
    if peek_is(p, token.TOK_DOT) {
        parser_next_token(p)
    } else if !expect_peek(p, token.TOK_IDENT) {
        return nil
    }
    var name = ast.new_identifier(p["cur"])
    if name["value"] != "." { ident_prefix_validate(p, name["value"], "import alias") }
    // GC safety (rolling): pin locals across expect_peek/parse to avoid stack-scan misses.
    p["_gc_import_name"] = name
    if !expect_peek(p, token.TOK_STRING) {
        p["_gc_import_name"] = nil
        return nil
    }
    var path = p["cur"]["literal"]
    p["_gc_import_path"] = path
    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    var stmt = ast.new_import(tok, name, path)
    p["_gc_import_name"] = nil
    p["_gc_import_path"] = nil
    return stmt
}

fn parse_type_decl(p) {
    var tok = p["cur"]
    if !expect_peek(p, token.TOK_IDENT) { return nil }
    var name = ast.new_identifier(p["cur"])
    ident_prefix_validate(p, name["value"], "type")
    if !expect_peek(p, token.TOK_LBRACE) { return nil }

    var fields = []
    if peek_is(p, token.TOK_RBRACE) {
        parser_next_token(p)
        if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
        return ast.new_type(tok, name, fields)
    }

    parser_next_token(p)
    var cont = true
    while cont {
        if cur_is(p, token.TOK_RBRACE) { cont = false }
        if cur_is(p, token.TOK_EOF) { cont = false }
        if cont {
            // field := {attr} ident [ ":" type_ident ]
            var fattrs = parse_attr_list(p)
            if p["cur"]["type"] != token.TOK_IDENT {
                parser_add_error(p, "expected field name, got " + p["cur"]["type"])
                return nil
            }
            var fid = ast.new_identifier(p["cur"])
            if fid["value"] == "__oren_type" {
                parser_add_error(p, "type field name '__oren_type' is reserved (used by reflection helpers)")
                // Error recovery (rolling):
                // This is a hard parse error, but returning nil here often causes a cascade
                // of secondary "no prefix parse fn" errors at the call site because the
                // parser is left mid-declaration. Skip to `}` so logs stay minimal.
                while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
                    parser_next_token(p)
                }
                if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
                return ast.new_type(tok, name, fields)
            }
            ident_prefix_validate(p, fid["value"], "field")
            if fattrs != nil && oren_list_len(fattrs) > 0 { fid["attrs"] = fattrs }

            // Optional explicit type annotation (rolling, used by packed-byte views).
            //
            // Examples:
            // - `len: u16be`
            // - `dst: u32be`
            //
            // Type names are parsed as identifiers with optional dotted namespaces:
            // - `myorg.Type`
            // - `std.net.IPv4`
            if peek_is(p, token.TOK_COLON) {
                parser_next_token(p) // ':'
                var tname = parse_type_name_after_colon(p)
                if tname == nil { return nil }
                fid["ann_type"] = tname
            }

            oren_list_push(fields, fid)
            if peek_is(p, token.TOK_COMMA) {
                parser_next_token(p) // ,
                parser_next_token(p) // next field or }
            } else {
                if peek_is(p, token.TOK_RBRACE) {
                    parser_next_token(p)
                } else {
                    parser_add_error(p, "expected ',' or '}', got " + p["peek"]["type"])
                    return nil
                }
            }
        }
    }

    if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
    return ast.new_type(tok, name, fields)
}

fn parse_ffi(p) {
    var tok = p["cur"]
    // Supported forms:
    // - `ffi puts`
    // - `ffi puts as c_puts` (alias: internal name differs from external symbol)
    // - `ffi("libc.so.6") puts` (rolling sugar; expands to `@ffi.link("...") ffi puts`)
    // - `ffi("libc.so.6") { puts, printf, ... }` (rolling sugar; expands to `@ffi.link("...") ffi { ... }`)
    // - `ffi { puts, printf, ... }` (rolling sugar: expands to multiple FFI decls)
    // - `ffi { @ffi.ret("i32") atoi, @ffi.ret("void") free, puts }` (per-item attrs)
    // - `ffi { puts as c_puts, atoi as c_atoi }` (alias inside group)
    //
    // The group form exists to avoid repeating `@ffi.dll/@ffi.link/@ffi.ret` for many
    // symbols from the same library.
    //
    // The `ffi("...")` sugar exists to avoid repeating the attribute prefix in simple
    // fixtures and quick bindings. It always lowers to `@ffi.link("...")` (portable form).
    var group_link_attr = nil
    if peek_is(p, token.TOK_LPAREN) {
        parser_next_token(p) // '('
        if !expect_peek(p, token.TOK_STRING) {
            parser_add_error(p, "ffi(...) expects a string literal library name")
            return ast.new_stmt_list([])
        }
        var lib_tok = p["cur"]
        var lib_str = ast.new_string(lib_tok)
        if !expect_peek(p, token.TOK_RPAREN) {
            parser_add_error(p, "expected ')' after ffi(\"...\")")
            return ast.new_stmt_list([])
        }
        group_link_attr = {"type": "Attr", "token": tok, "name": "ffi.link", "args": [{"key": nil, "value": lib_str}]}
    }

    if peek_is(p, token.TOK_LBRACE) {
        parser_next_token(p) // '{'
        parser_next_token(p) // first ident or '}'

        var stmts = []
        if cur_is(p, token.TOK_RBRACE) {
            parser_add_error(p, "ffi group must contain at least one symbol")
            return ast.new_stmt_list([])
        }

        while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
            // Allow per-item attrs: `{ @ffi.ret("i32") atoi, puts }`
            var item_attrs = parse_attr_list(p)
            if !cur_is(p, token.TOK_IDENT) {
                parser_add_error(p, "expected ffi symbol name")
                return ast.new_stmt_list([])
            }
            var ext_name = ast.new_identifier(p["cur"])
            var link_name = ext_name["value"]
            var name = ext_name
            if peek_is(p, token.TOK_AS) {
                parser_next_token(p) // 'as'
                if !expect_peek(p, token.TOK_IDENT) {
                    parser_add_error(p, "expected ffi alias name after `as`")
                    return ast.new_stmt_list([])
                }
                name = ast.new_identifier(p["cur"])
            }
            ident_prefix_validate(p, name["value"], "ffi symbol")
            var st = ast.new_ffi(tok, name)
            st["link_name"] = link_name
            if item_attrs != nil && oren_list_len(item_attrs) > 0 { st["attrs"] = item_attrs }
            if group_link_attr != nil { st["attrs"] = _merge_attrs(st["attrs"], [group_link_attr]) }
            oren_list_push(stmts, st)

            if peek_is(p, token.TOK_COMMA) || peek_is(p, token.TOK_SEMICOLON) {
                parser_next_token(p) // ',' / ';'
                parser_next_token(p) // next item or '}'
                continue
            }

            // Rolling ergonomics: allow multiline/grouped imports without commas.
            //
            // Example:
            //   ffi {
            //     atoi
            //     puts
            //   }
            //
            // This keeps fixtures and real-world bindings readable (diff-friendly) and avoids
            // forcing a trailing comma style choice. Outside `ffi { ... }`, the language remains
            // explicit about statement boundaries (no implicit semicolon insertion).
            if peek_is(p, token.TOK_IDENT) || peek_is(p, token.TOK_AT) {
                parser_next_token(p) // next item start
                continue
            }

            if peek_is(p, token.TOK_RBRACE) {
                parser_next_token(p) // '}'
                break
            }

            parser_add_error(p, "expected ',' or '}' after ffi symbol name")
            return ast.new_stmt_list([])
        }

        var out = ast.new_stmt_list(stmts)
        // Distinguish from enum/impl sugar expansion so attrs/doc can apply.
        out["origin"] = "ffi_group"
        return out
    }

    if !expect_peek(p, token.TOK_IDENT) { return nil }
    var ext_name2 = ast.new_identifier(p["cur"])
    var link_name2 = ext_name2["value"]
    var name2 = ext_name2
    if peek_is(p, token.TOK_AS) {
        parser_next_token(p) // 'as'
        if !expect_peek(p, token.TOK_IDENT) { return nil }
        name2 = ast.new_identifier(p["cur"])
    }
    ident_prefix_validate(p, name2["value"], "ffi symbol")
    var st2 = ast.new_ffi(tok, name2)
    st2["link_name"] = link_name2
    if group_link_attr != nil { st2["attrs"] = _merge_attrs(st2["attrs"], [group_link_attr]) }
    return st2
}
