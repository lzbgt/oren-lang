fn _program_needs_generator_core(prog) {
    if prog == nil || prog["statements"] == nil { return false }
    var stmts = prog["statements"]
    var stmts_len = oren_list_len(stmts)
    var i = 0
    while i < stmts_len {
        if _stmt_uses_generator_core(stmts[i]) == true { return true }
        i = i + 1
    }
    return false
}

var _PARSER_GENERATOR_CORE_SRC_CACHE = nil
var _PARSER_GENERATOR_CORE_STMT_CACHE = nil

fn _generator_core_src_cache_enabled() {
    // Native compiler globals are not yet guaranteed GC roots under forced compiler GC.
    var force_gc = oren_env("OREN_COMPILER_GC")
    if force_gc == "1" || force_gc == "true" { return false }
    return true
}

fn _generator_core_src() {
    var cache_enabled = _generator_core_src_cache_enabled()
    if cache_enabled == true && _PARSER_GENERATOR_CORE_SRC_CACHE != nil { return _PARSER_GENERATOR_CORE_SRC_CACHE }
    var src = ""
    src = src + "fn _oren_generator_err(ctx, msg) { return oren_err(4, ctx + \": \" + msg) }\n"
    src = src + "fn _oren_generator_trace(msg) {\n"
