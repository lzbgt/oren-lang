fn _generator_core_stmts(p) {
    var file = p["file"]
    if file == nil { file = "" }
    var helper_file = file + "#oren_generator_core_v0#" + parser_gensym(p, "__oren_generator_core_")
    var profile_parse = false
    var profile_path = oren_env("OREN_TRACE_BUILD_PHASES_PATH")
    if profile_path != nil && profile_path != "" && profile_path != "0" { profile_parse = true }
    var src_ms = 0
    var lexer_ms = 0
    var parser_ms = 0
    var t_part = 0
    if profile_parse { t_part = oren_time_now_ns() }
    var cache_enabled = _generator_core_src_cache_enabled()
    if cache_enabled == true && _PARSER_GENERATOR_CORE_STMT_CACHE != nil {
        p["_profile_gen_core_src_ms"] = 0
        p["_profile_gen_core_lexer_ms"] = 0
        p["_profile_gen_core_parser_ms"] = 0
        return _generator_core_clone_stmt_list(_PARSER_GENERATOR_CORE_STMT_CACHE)
    }
    var src = _generator_core_src()
    if profile_parse {
        src_ms = (oren_time_now_ns() - t_part) / 1000000
        t_part = oren_time_now_ns()
    }
    var l = lexer.new_lexer(src)
    l["file"] = helper_file
    if profile_parse {
        lexer_ms = (oren_time_now_ns() - t_part) / 1000000
        t_part = oren_time_now_ns()
    }
    var hp = core.new_parser(l)
    hp["file"] = helper_file
    hp["strict_attrs"] = p["strict_attrs"]
    hp["attr_allow_prefixes"] = p["attr_allow_prefixes"]
    hp["strict_ident_prefixes"] = p["strict_ident_prefixes"]
    hp["ident_allow_prefixes"] = p["ident_allow_prefixes"]
    hp["_skip_generator_core_inject"] = true
    var prog = parse_program(hp)
    if profile_parse {
        parser_ms = (oren_time_now_ns() - t_part) / 1000000
    }
    p["_profile_gen_core_src_ms"] = src_ms
    p["_profile_gen_core_lexer_ms"] = lexer_ms
    p["_profile_gen_core_parser_ms"] = parser_ms
    if oren_list_len(hp["errors"]) > 0 {
        parser_add_error(p, "internal generator core parse failure")
        return []
    }
    if cache_enabled == true { _PARSER_GENERATOR_CORE_STMT_CACHE = prog["statements"] }
    return _generator_core_clone_stmt_list(prog["statements"])
}
