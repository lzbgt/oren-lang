fn _program_needs_generator_core(prog) {
    if prog == nil || prog["statements"] == nil { return false }
    var stmts = prog["statements"]
    var i = 0
    while i < oren_list_len(stmts) {
        if _stmt_uses_generator_core(stmts[i]) == true { return true }
        i = i + 1
    }
    return false
}

fn _generator_core_src() {
    var src = ""
    src = src + "fn _oren_generator_err(ctx, msg) { return oren_err(4, ctx + \": \" + msg) }\n"
    src = src + "fn _oren_generator_trace(msg) {\n"
    src = src + "    if oren_env(\"OREN_TRACE_GENERATOR_CORE\") != nil { print(\"[trace] generator \" + msg) }\n"
    src = src + "    return nil\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_handle_tag() { return \"__oren_generator_handle_v2\" }\n"
    src = src + "fn _oren_generator_context_tag() { return \"__oren_generator_context_v2\" }\n"
    src = src + "fn _oren_generator_step_value(ok, done, value, retv) { return {\"ok\": ok, \"done\": done, \"value\": value, \"return\": retv} }\n"
    src = src + "fn _oren_generator_yield_step(value) { return _oren_generator_step_value(true, false, value, nil) }\n"
    src = src + "fn _oren_generator_done_step(retv) { return _oren_generator_step_value(false, true, nil, retv) }\n"
    src = src + "fn _oren_generator_is_handle(gen) {\n"
    src = src + "    return oren_type_name(gen) == \"generator\"\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_is_context(co) {\n"
    src = src + "    return oren_type_name(co) == \"generator_context\"\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_expect_handle(gen, ctx) {\n"
    src = src + "    if _oren_generator_is_handle(gen) == true { return nil }\n"
    src = src + "    return _oren_generator_err(ctx, \"expected generator handle\")\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_expect_context(co, ctx) {\n"
    src = src + "    if _oren_generator_is_context(co) == true { return nil }\n"
    src = src + "    return _oren_generator_err(ctx, \"expected generator context\")\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_expect_close_hook(hook, ctx) {\n"
    src = src + "    if oren_type_name(hook) == \"func\" { return nil }\n"
    src = src + "    return _oren_generator_err(ctx, \"expected zero-arg function finalizer hook\")\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_get(gen, slot) { return gen[slot] }\n"
    src = src + "fn _oren_generator_set(gen, slot, value) { gen[slot] = value; return value }\n"
    src = src + "fn _oren_generator_worker(gen) { return _oren_generator_get(gen, 1) }\n"
    src = src + "fn _oren_generator_args_list(gen) { return _oren_generator_get(gen, 2) }\n"
    src = src + "fn _oren_generator_yield_ch(gen) { return _oren_generator_get(gen, 3) }\n"
    src = src + "fn _oren_generator_resume_ch(gen) { return _oren_generator_get(gen, 4) }\n"
    src = src + "fn _oren_generator_done_ch(gen) { return _oren_generator_get(gen, 5) }\n"
    src = src + "fn _oren_generator_task(gen) { return _oren_generator_get(gen, 6) }\n"
    src = src + "fn _oren_generator_set_task(gen, task) { return _oren_generator_set(gen, 6, task) }\n"
    src = src + "fn _oren_generator_started(gen) { return _oren_generator_get(gen, 7) == true }\n"
    src = src + "fn _oren_generator_set_started(gen, started) { return _oren_generator_set(gen, 7, started == true) }\n"
    src = src + "fn _oren_generator_done(gen) { return _oren_generator_get(gen, 8) == true }\n"
    src = src + "fn _oren_generator_set_done_flag(gen, done) { return _oren_generator_set(gen, 8, done == true) }\n"
    src = src + "fn _oren_generator_result_value(gen) { return _oren_generator_get(gen, 9) }\n"
    src = src + "fn _oren_generator_set_result_value(gen, retv) { return _oren_generator_set(gen, 9, retv) }\n"
    src = src + "fn _oren_generator_cached_step(gen) { return _oren_generator_get(gen, 10) }\n"
    src = src + "fn _oren_generator_set_cached_step(gen, step) { return _oren_generator_set(gen, 10, step) }\n"
    src = src + "fn _oren_generator_active_child(gen) { return _oren_generator_get(gen, 11) }\n"
    src = src + "fn _oren_generator_set_active_child(gen, child) { return _oren_generator_set(gen, 11, child) }\n"
    src = src + "fn _oren_generator_close_hooks(gen) { return _oren_generator_get(gen, 12) }\n"
    src = src + "fn _oren_generator_set_close_hooks(gen, hooks) { return _oren_generator_set(gen, 12, hooks) }\n"
    src = src + "fn _oren_generator_terminal_err(gen) { return _oren_generator_get(gen, 13) }\n"
    src = src + "fn _oren_generator_set_terminal_err(gen, err) { return _oren_generator_set(gen, 13, err) }\n"
    src = src + "fn _oren_generator_context_yield_ch(co) { return _oren_generator_get(co, 1) }\n"
    src = src + "fn _oren_generator_context_resume_ch(co) { return _oren_generator_get(co, 2) }\n"
    src = src + "fn _oren_generator_context_owner_slot(co) { return _oren_generator_get(co, 3) }\n"
    src = src + "fn _oren_generator_new_context(yield_ch, resume_ch, owner) {\n"
    src = src + "    return [_oren_generator_context_tag(), yield_ch, resume_ch, owner]\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_new_handle(worker, args_list, yield_ch, resume_ch, done_ch) {\n"
    src = src + "    return [_oren_generator_handle_tag(), worker, args_list, yield_ch, resume_ch, done_ch, nil, false, false, nil, nil, nil, nil, nil]\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_terminal_result(gen) {\n"
    src = src + "    var terminal_err = _oren_generator_terminal_err(gen)\n"
    src = src + "    if terminal_err != nil { return terminal_err }\n"
    src = src + "    return _oren_generator_result_value(gen)\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_done_result(gen) {\n"
    src = src + "    var terminal_err = _oren_generator_terminal_err(gen)\n"
    src = src + "    if terminal_err != nil { return terminal_err }\n"
    src = src + "    return _oren_generator_done_step(_oren_generator_result_value(gen))\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_context_owner(co) {\n"
    src = src + "    if _oren_generator_is_context(co) != true { return nil }\n"
    src = src + "    return _oren_generator_context_owner_slot(co)\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_bind_active_child(owner, child) {\n"
    src = src + "    if _oren_generator_is_handle(owner) != true { return nil }\n"
    src = src + "    var prev = _oren_generator_active_child(owner)\n"
    src = src + "    _oren_generator_set_active_child(owner, child)\n"
    src = src + "    return prev\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_restore_active_child(owner, prev) {\n"
    src = src + "    if _oren_generator_is_handle(owner) != true { return nil }\n"
    src = src + "    _oren_generator_set_active_child(owner, prev)\n"
    src = src + "    return nil\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_close_active_child(gen) {\n"
    src = src + "    var child = _oren_generator_active_child(gen)\n"
    src = src + "    if child == nil { return nil }\n"
    src = src + "    _oren_generator_set_active_child(gen, nil)\n"
    src = src + "    if child == gen { return nil }\n"
    src = src + "    if _oren_generator_is_handle(child) != true { return nil }\n"
    src = src + "    return oren_generator_close(child)\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_push_close_hook(gen, hook) {\n"
    src = src + "    var hooks = _oren_generator_close_hooks(gen)\n"
    src = src + "    if hooks == nil {\n"
    src = src + "        hooks = []\n"
    src = src + "        _oren_generator_set_close_hooks(gen, hooks)\n"
    src = src + "    }\n"
    src = src + "    oren_list_push(hooks, hook)\n"
    src = src + "    return nil\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_run_close_hooks(gen) {\n"
    src = src + "    var hooks = _oren_generator_close_hooks(gen)\n"
    src = src + "    _oren_generator_set_close_hooks(gen, nil)\n"
    src = src + "    if hooks == nil { return nil }\n"
    src = src + "    var first_err = nil\n"
    src = src + "    var i = oren_list_len(hooks)\n"
    src = src + "    while i > 0 {\n"
    src = src + "        i = i - 1\n"
    src = src + "        var rv = hooks[i]()\n"
    src = src + "        if first_err == nil && oren_is_err(rv) == true { first_err = rv }\n"
    src = src + "    }\n"
    src = src + "    return first_err\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_ctx(yield_ch, resume_ch, owner) {\n"
    src = src + "    return _oren_generator_new_context(yield_ch, resume_ch, owner)\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_context_exchange(co, value) {\n"
    src = src + "    var bad = _oren_generator_expect_context(co, \"yield in\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    return oren_yield_exchange(_oren_generator_context_yield_ch(co), _oren_generator_context_resume_ch(co), value)\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_expect_step(step, op) {\n"
    src = src + "    if step == nil { return _oren_generator_err(op, \"expected generator step\") }\n"
    src = src + "    if step[\"done\"] == true { return nil }\n"
    src = src + "    if step[\"ok\"] == true { return nil }\n"
    src = src + "    return _oren_generator_err(op, \"expected generator step\")\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_mark_done(gen, retv, terminal_err) {\n"
    src = src + "    _oren_generator_set_done_flag(gen, true)\n"
    src = src + "    _oren_generator_set_result_value(gen, retv)\n"
    src = src + "    _oren_generator_set_cached_step(gen, nil)\n"
    src = src + "    _oren_generator_set_active_child(gen, nil)\n"
    src = src + "    _oren_generator_set_close_hooks(gen, nil)\n"
    src = src + "    _oren_generator_set_terminal_err(gen, terminal_err)\n"
    src = src + "    return retv\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_finalize(gen) {\n"
    src = src + "    var first_err = nil\n"
    src = src + "    var child_close = _oren_generator_close_active_child(gen)\n"
    src = src + "    if first_err == nil && oren_is_err(child_close) == true { first_err = child_close }\n"
    src = src + "    var hook_close = _oren_generator_run_close_hooks(gen)\n"
    src = src + "    if first_err == nil && oren_is_err(hook_close) == true { first_err = hook_close }\n"
    src = src + "    return first_err\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_finish(gen, retv) {\n"
    src = src + "    var first_err = _oren_generator_finalize(gen)\n"
    src = src + "    _oren_generator_mark_done(gen, retv, first_err)\n"
    src = src + "    var task = _oren_generator_task(gen)\n"
    src = src + "    if task != nil && task != 0 { oren_join(task) }\n"
    src = src + "    _oren_generator_set_task(gen, nil)\n"
    src = src + "    if first_err != nil { return first_err }\n"
    src = src + "    return retv\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_entry(worker, args_list, yield_ch, resume_ch, done_ch, gen) {\n"
    src = src + "    var retv = worker(_oren_generator_ctx(yield_ch, resume_ch, gen), args_list)\n"
    src = src + "    oren_chan_send(done_ch, retv)\n"
    src = src + "    return retv\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_ensure_task(gen) {\n"
    src = src + "    var task = _oren_generator_task(gen)\n"
    src = src + "    if task != nil && task != 0 { return task }\n"
    src = src + "    task = spawn _oren_generator_entry(\n"
    src = src + "        _oren_generator_worker(gen),\n"
    src = src + "        _oren_generator_args_list(gen),\n"
    src = src + "        _oren_generator_yield_ch(gen),\n"
    src = src + "        _oren_generator_resume_ch(gen),\n"
    src = src + "        _oren_generator_done_ch(gen),\n"
    src = src + "        gen\n"
    src = src + "    )\n"
    src = src + "    _oren_generator_set_task(gen, task)\n"
    src = src + "    return task\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_resume(gen, value) {\n"
    src = src + "    _oren_generator_trace(\"resume.start\")\n"
    src = src + "    _oren_generator_set_cached_step(gen, nil)\n"
    src = src + "    _oren_generator_ensure_task(gen)\n"
    src = src + "    _oren_generator_trace(\"resume.after_ensure\")\n"
    src = src + "    if _oren_generator_started(gen) == true {\n"
    src = src + "        oren_chan_send(_oren_generator_resume_ch(gen), value)\n"
    src = src + "        _oren_generator_trace(\"resume.after_send\")\n"
    src = src + "    } else {\n"
    src = src + "        _oren_generator_set_started(gen, true)\n"
    src = src + "        _oren_generator_trace(\"resume.mark_started\")\n"
    src = src + "    }\n"
    src = src + "    oren_yield()\n"
    src = src + "    _oren_generator_trace(\"resume.after_yield\")\n"
    src = src + "    var sel = oren_select([[0, _oren_generator_done_ch(gen)], [0, _oren_generator_yield_ch(gen)]])\n"
    src = src + "    _oren_generator_trace(\"resume.after_select\")\n"
    src = src + "    var idx = sel[0]\n"
    src = src + "    var payload = sel[1]\n"
    src = src + "    if idx == 0 {\n"
    src = src + "        _oren_generator_trace(\"resume.done_slot\")\n"
    src = src + "        var finished = _oren_generator_finish(gen, payload)\n"
    src = src + "        if oren_is_err(finished) == true { return finished }\n"
    src = src + "        return _oren_generator_done_step(payload)\n"
    src = src + "    }\n"
    src = src + "    _oren_generator_trace(\"resume.yield_slot\")\n"
    src = src + "    var step = _oren_generator_yield_step(payload)\n"
    src = src + "    _oren_generator_set_cached_step(gen, step)\n"
    src = src + "    return step\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_start(worker, args_list) {\n"
    src = src + "    if args_list == nil { args_list = [] }\n"
    src = src + "    var yield_ch = oren_new_channel()\n"
    src = src + "    var resume_ch = oren_new_channel()\n"
    src = src + "    var done_ch = oren_new_channel()\n"
    src = src + "    return _oren_generator_new_handle(worker, args_list, yield_ch, resume_ch, done_ch)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_next(gen) {\n"
    src = src + "    var bad = _oren_generator_expect_handle(gen, \"generator.next\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_done(gen) == true { return _oren_generator_done_result(gen) }\n"
    src = src + "    return _oren_generator_resume(gen, nil)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_send(gen, value) {\n"
    src = src + "    var bad = _oren_generator_expect_handle(gen, \"generator.send\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_done(gen) == true { return _oren_generator_done_result(gen) }\n"
    src = src + "    if _oren_generator_started(gen) != true && value != nil {\n"
    src = src + "        return _oren_generator_err(\"generator.send\", \"initial send expects nil; use generator.next(gen) first\")\n"
    src = src + "    }\n"
    src = src + "    return _oren_generator_resume(gen, value)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_on_finalize(co, hook) {\n"
    src = src + "    var bad = _oren_generator_expect_context(co, \"generator.on_finalize\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    bad = _oren_generator_expect_close_hook(hook, \"generator.on_finalize\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    var owner = _oren_generator_context_owner(co)\n"
    src = src + "    bad = _oren_generator_expect_handle(owner, \"generator.on_finalize\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    return _oren_generator_push_close_hook(owner, hook)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_on_close(co, hook) {\n"
    src = src + "    return oren_generator_on_finalize(co, hook)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_close(gen) {\n"
    src = src + "    var bad = _oren_generator_expect_handle(gen, \"generator.close\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_done(gen) == true {\n"
    src = src + "        _oren_generator_trace(\"close.already_done\")\n"
    src = src + "        return _oren_generator_terminal_result(gen)\n"
    src = src + "    }\n"
    src = src + "    var first_err = _oren_generator_finalize(gen)\n"
    src = src + "    var task = _oren_generator_task(gen)\n"
    src = src + "    if _oren_generator_started(gen) == true && task != nil && task != 0 {\n"
    src = src + "        _oren_generator_trace(\"close.detach_live_task\")\n"
    src = src + "        oren_detach(task)\n"
    src = src + "    }\n"
    src = src + "    _oren_generator_trace(\"close.mark_done\")\n"
    src = src + "    _oren_generator_set_task(gen, nil)\n"
    src = src + "    _oren_generator_mark_done(gen, nil, first_err)\n"
    src = src + "    if first_err != nil { return first_err }\n"
    src = src + "    return nil\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_delegate(co, inner) {\n"
    src = src + "    _oren_generator_trace(\"delegate.start\")\n"
    src = src + "    var bad = _oren_generator_expect_context(co, \"generator.delegate\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    bad = _oren_generator_expect_handle(inner, \"generator.delegate\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_done(inner) == true {\n"
    src = src + "        _oren_generator_trace(\"delegate.already_done\")\n"
    src = src + "        return _oren_generator_terminal_result(inner)\n"
    src = src + "    }\n"
    src = src + "    if _oren_generator_started(inner) == true {\n"
    src = src + "        var step = _oren_generator_cached_step(inner)\n"
    src = src + "        if step == nil {\n"
    src = src + "            return _oren_generator_err(\"generator.delegate\", \"expected cached yielded step for started generator handle\")\n"
    src = src + "        }\n"
    src = src + "        _oren_generator_trace(\"delegate.cached_step\")\n"
    src = src + "        return oren_generator_delegate_step(co, inner, step)\n"
    src = src + "    }\n"
    src = src + "    var owner = _oren_generator_context_owner(co)\n"
    src = src + "    var prev_child = _oren_generator_bind_active_child(owner, inner)\n"
    src = src + "    _oren_generator_set_started(inner, true)\n"
    src = src + "    _oren_generator_trace(\"delegate.inline\")\n"
    src = src + "    var inner_co = _oren_generator_new_context(_oren_generator_context_yield_ch(co), _oren_generator_context_resume_ch(co), inner)\n"
    src = src + "    var retv = _oren_generator_worker(inner)(inner_co, _oren_generator_args_list(inner))\n"
    src = src + "    var finished = _oren_generator_finish(inner, retv)\n"
    src = src + "    _oren_generator_restore_active_child(owner, prev_child)\n"
    src = src + "    if oren_is_err(finished) == true { return finished }\n"
    src = src + "    _oren_generator_trace(\"delegate.done\")\n"
    src = src + "    return retv\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_delegate_step(co, inner, step) {\n"
    src = src + "    _oren_generator_trace(\"delegate_step.start\")\n"
    src = src + "    var bad = _oren_generator_expect_context(co, \"generator.delegate_step\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    bad = _oren_generator_expect_handle(inner, \"generator.delegate_step\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    bad = _oren_generator_expect_step(step, \"generator.delegate_step\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_done(inner) == true {\n"
    src = src + "        _oren_generator_trace(\"delegate_step.done\")\n"
    src = src + "        return _oren_generator_terminal_result(inner)\n"
    src = src + "    }\n"
    src = src + "    if step[\"done\"] == true {\n"
    src = src + "        _oren_generator_trace(\"delegate_step.done\")\n"
    src = src + "        return step[\"return\"]\n"
    src = src + "    }\n"
    src = src + "    if _oren_generator_started(inner) != true {\n"
    src = src + "        return _oren_generator_err(\"generator.delegate_step\", \"expected started generator handle\")\n"
    src = src + "    }\n"
    src = src + "    var owner = _oren_generator_context_owner(co)\n"
    src = src + "    var prev_child = _oren_generator_bind_active_child(owner, inner)\n"
    src = src + "    while true {\n"
    src = src + "        _oren_generator_trace(\"delegate_step.yield\")\n"
    src = src + "        var resumed = _oren_generator_context_exchange(co, step[\"value\"])\n"
    src = src + "        step = oren_generator_send(inner, resumed)\n"
    src = src + "        if oren_is_err(step) == true {\n"
    src = src + "            _oren_generator_restore_active_child(owner, prev_child)\n"
    src = src + "            return step\n"
    src = src + "        }\n"
    src = src + "        if step[\"done\"] == true {\n"
    src = src + "            _oren_generator_trace(\"delegate_step.done\")\n"
    src = src + "            _oren_generator_restore_active_child(owner, prev_child)\n"
    src = src + "            return step[\"return\"]\n"
    src = src + "        }\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_is_done(gen) {\n"
    src = src + "    if _oren_generator_is_handle(gen) != true { return false }\n"
    src = src + "    return _oren_generator_done(gen) == true\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_return_value(gen) {\n"
    src = src + "    if _oren_generator_is_handle(gen) != true { return nil }\n"
    src = src + "    return _oren_generator_result_value(gen)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_collect(gen) {\n"
    src = src + "    var bad = _oren_generator_expect_handle(gen, \"generator.collect\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    var out = []\n"
    src = src + "    while true {\n"
    src = src + "        var step = oren_generator_next(gen)\n"
    src = src + "        if oren_is_err(step) == true { return step }\n"
    src = src + "        if step[\"done\"] == true { return out }\n"
    src = src + "        oren_list_push(out, step[\"value\"])\n"
    src = src + "    }\n"
    src = src + "}\n"
    return src
}

fn _generator_core_stmts(p) {
    var file = p["file"]
    if file == nil { file = "" }
    var helper_file = file + "#oren_generator_core_v0#" + parser_gensym(p, "__oren_generator_core_")
    var l = lexer.new_lexer(_generator_core_src())
    l["file"] = helper_file
    var hp = core.new_parser(l)
    hp["file"] = helper_file
    hp["strict_attrs"] = p["strict_attrs"]
    hp["attr_allow_prefixes"] = p["attr_allow_prefixes"]
    hp["strict_ident_prefixes"] = p["strict_ident_prefixes"]
    hp["ident_allow_prefixes"] = p["ident_allow_prefixes"]
    hp["_skip_generator_core_inject"] = true
    var prog = parse_program(hp)
    if oren_list_len(hp["errors"]) > 0 {
        parser_add_error(p, "internal generator core parse failure")
        return []
    }
    return prog["statements"]
}
