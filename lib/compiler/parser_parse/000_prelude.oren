fn _parse_int_env(v, default_val) {
    if v == nil || v == "" { return default_val }
    var n = oren_string_len(v)
    if n == 0 { return default_val }
    var i = 0
    var j = n
    // Trim ASCII whitespace (common on Windows envs via cmd.exe).
    while i < j {
        var c0 = oren_string_char_at(v, i)
        if c0 == " " || c0 == "\t" || c0 == "\r" || c0 == "\n" { i = i + 1; continue }
        break
    }
    while j > i {
        var c1 = oren_string_char_at(v, j - 1)
        if c1 == " " || c1 == "\t" || c1 == "\r" || c1 == "\n" { j = j - 1; continue }
        break
    }
    if i >= j { return default_val }
    var n2 = j
    var neg = false
    if oren_string_char_at(v, i) == "-" {
        neg = true
        i = i + 1
    }
    var acc = 0
    while i < n2 {
        var c = oren_string_byte_at_unchecked(v, i)
        if c < 48 || c > 57 { return default_val }
        acc = acc * 10 + (c - 48)
        i = i + 1
    }
    if neg { acc = 0 - acc }
    return acc
}

fn parser_next_token(p) { return core.parser_next_token(p) }
fn cur_is(p, t) { return core.cur_is(p, t) }
fn peek_is(p, t) { return core.peek_is(p, t) }
fn cur_is_ident_like(p) { return core.cur_is_ident_like(p) }
fn peek_is_ident_like(p) { return core.peek_is_ident_like(p) }
fn expect_peek(p, t) { return core.expect_peek(p, t) }
fn expect_peek_ident_like(p, what) { return core.expect_peek_ident_like(p, what) }
fn parse_type_name_after_colon(p) { return core.parse_type_name_after_colon(p) }
fn parse_type_name_after_for(p) { return core.parse_type_name_after_for(p) }

fn parse_program(p) {
    var gcroot = {"parser": p, "lexer": p["l"], "input": p["l"]["input"]}
    var __prev_gc_pin = oren_gc_pin(gcroot)
    // Expose GC root for nested parse helpers (e.g. parse_block) to pin locals.
    p["_gc_root"] = gcroot
    gcroot["block_frames"] = []
    var prog = ast.new_program()
    // GC safety (rolling):
    // Stage2 self-hosting uses auto-GC and may run with bounded conservative stack scanning.
    // Ensure the in-progress program (and per-iteration scratch lists) remain reachable from
    // the pinned parser state so they cannot be collected mid-parse.
    p["_gc_prog"] = prog
    gcroot["prog"] = prog
    var trace_prog = false
    var v_trace_prog = oren_env("OREN_TRACE_PARSE_PROGRESS")
    if v_trace_prog != nil && v_trace_prog != "" { trace_prog = true }
    var trace_prog_verbose = false
    var v_trace_prog_verbose = oren_env("OREN_TRACE_PARSE_PROGRESS_VERBOSE")
    if v_trace_prog_verbose != nil && v_trace_prog_verbose != "" { trace_prog_verbose = true }
    var trace_file = p["file"]
    if trace_file == nil { trace_file = "" }
    var trace_file_filter = oren_env("OREN_TRACE_PARSE_FILE")
    if trace_file_filter != nil && trace_file_filter != "" {
        if trace_file != trace_file_filter {
            trace_prog = false
            trace_prog_verbose = false
        }
    }
    var trace_prog_verbose_from = 230
    var v_trace_prog_verbose_from = oren_env("OREN_TRACE_PARSE_PROGRESS_VERBOSE_FROM")
    if v_trace_prog_verbose_from != nil && v_trace_prog_verbose_from != "" {
        trace_prog_verbose_from = _parse_int_env(v_trace_prog_verbose_from, trace_prog_verbose_from)
    }
    var stmt_i = 0
    var trace_prog_every = 5
    var v_trace_prog_every = oren_env("OREN_TRACE_PARSE_PROGRESS_EVERY")
    if trace_prog && v_trace_prog_every != nil && v_trace_prog_every != "" {
        print("[parse] trace_every_env=" + v_trace_prog_every)
        trace_prog_every = _parse_int_env(v_trace_prog_every, trace_prog_every)
        if trace_prog_every < 1 { trace_prog_every = 1 }
    }
    var trace_prog_countdown = 0
    while p["cur"]["type"] != token.TOK_EOF {
        if trace_prog {
            if trace_prog_countdown <= 0 {
                print("[parse] file=" + trace_file + " stmt_i=" + oren_int_to_string(stmt_i) + " cur=" + p["cur"]["type"])
                trace_prog_countdown = trace_prog_every
            }
            trace_prog_countdown = trace_prog_countdown - 1
        }
        if trace_prog_verbose && stmt_i >= trace_prog_verbose_from {
            var cur_lit = p["cur"]["literal"]
            var peek_lit = p["peek"]["literal"]
            if cur_lit == nil { cur_lit = "" }
            if peek_lit == nil { peek_lit = "" }
            var cur_line = p["cur"]["line"]
            var cur_col = p["cur"]["col"]
            if cur_line == nil { cur_line = 0 }
            if cur_col == nil { cur_col = 0 }
            print("[parse_verbose] file=" + trace_file + " stmt_i=" + oren_int_to_string(stmt_i) + " cur=" + p["cur"]["type"] + " line=" + oren_int_to_string(cur_line) + " col=" + oren_int_to_string(cur_col) + " lit=" + cur_lit + " peek=" + peek_lit)
        }
        // Allow doc comments and attributes to appear in either order before a declaration:
        //   /// doc
        //   @attr(...)
        //   fn ...
        //
        // or:
        //   @attr(...)
        //   /// doc
        //   struct ...
        //
        // We collect both deterministically and attach to the next declaration only.
        var doc_lines = []
        var attrs = []
        p["_gc_doc_lines"] = doc_lines
        p["_gc_attrs"] = attrs
        gcroot["doc_lines"] = doc_lines
        gcroot["attrs"] = attrs
        while cur_is(p, token.TOK_DOC) || cur_is(p, token.TOK_AT) {
            if cur_is(p, token.TOK_DOC) {
                oren_list_push(doc_lines, p["cur"]["literal"])
                parser_next_token(p)
            } else {
                var a = parse_attr(p)
                if a != nil { oren_list_push(attrs, a) }
                parser_next_token(p)
            }
        }
        var doc = docs_join(doc_lines)
        p["_pending_doc"] = doc
        p["_trace_stmt_i"] = stmt_i
        var stmt = parse_statement(p)
        p["_gc_stmt"] = stmt
        gcroot["stmt"] = stmt
        if stmt != nil {
            if stmt["type"] == "StmtList" {
                var origin = stmt["origin"]
                    if origin == "ffi_group" {
                        // Allow attrs/doc to apply to the expanded FFI declarations.
                        var pending = parser_take_pending_doc(p)
                        // Special-case: `@ffi.ret("...") ffi { ... }` is intended as a default return kind.
                        // If an item already has `@ffi.ret("...")`, do not also attach the group-level ret,
                        // otherwise the native backend will reject it as a duplicate.
                        var group_ret_n = _attrs_count_name(attrs, "ffi.ret")
                        if group_ret_n > 1 {
                            parser_add_error(p, "ffi group: at most one @ffi.ret(...) may precede `ffi { ... }`")
                        }
                        var si = 0
                        while si < oren_list_len(stmt["stmts"]) {
                            var s = stmt["stmts"][si]
                            var use_attrs = attrs
                            if group_ret_n == 1 && s != nil && s["type"] == "FFI" {
                                if _attrs_has_name(s["attrs"], "ffi.ret") {
                                    use_attrs = _attrs_filter_out_name(attrs, "ffi.ret")
                                }
                            }
                            attach_attrs_to_stmt(p, s, use_attrs)
	                            if pending != nil {
	                                // Mirror single-statement behavior: attach doc to declaration-like nodes.
	                                if s["type"] == "Type" || s["type"] == "Import" || s["type"] == "FFI" || s["type"] == "Var" {
	                                    s["doc"] = pending
	                            }
	                        }
                            s = maybe_lower_generator_decl_stmt(p, s)
                            s = validate_stmt_yield_delegate_syntax(p, s)
                            oren_list_push(prog["statements"], s)
	                        si = si + 1
	                    }
                } else {
                    if attrs != nil && oren_list_len(attrs) != 0 {
                        parser_add_error(p, "attributes may not precede enum sugar expansion")
                    }
                    if p["_pending_doc"] != nil {
                        parser_add_error(p, "doc comments may not precede enum/impl sugar expansion yet")
                        p["_pending_doc"] = nil
                    }
                    var si2 = 0
                    while si2 < oren_list_len(stmt["stmts"]) {
                        oren_list_push(prog["statements"], stmt["stmts"][si2])
                        si2 = si2 + 1
                    }
                }
            } else {
                attach_attrs_to_stmt(p, stmt, attrs)
                // Attach doc to declaration statements (fn/struct/class/import/ffi).
                var pending = parser_take_pending_doc(p)
                if pending != nil {
                    if stmt["type"] == "Type" || stmt["type"] == "Import" || stmt["type"] == "FFI" || stmt["type"] == "Var" {
                        stmt["doc"] = pending
                    } else {
                        if stmt["type"] == "ExprStmt" {
                            var exp = stmt["expr"]
                            if exp != nil && exp["type"] == "Function" {
                                // Function consumes pending doc in parse_function.
                            } else {
                                parser_add_error(p, "doc comments may only precede declarations (fn/struct/class/import/ffi/var)")
                            }
                        } else {
                            parser_add_error(p, "doc comments may only precede declarations (fn/struct/class/import/ffi/var)")
                        }
	                    }
	                }
                    stmt = maybe_lower_generator_decl_stmt(p, stmt)
                    stmt = validate_stmt_yield_delegate_syntax(p, stmt)
                    oren_list_push(prog["statements"], stmt)
	            }
	        }
        // If no statement consumed the doc, clear it to avoid leakage.
        p["_pending_doc"] = nil
        p["_gc_stmt"] = nil
        p["_gc_attrs"] = nil
        p["_gc_doc_lines"] = nil
        gcroot["stmt"] = nil
        gcroot["attrs"] = nil
        gcroot["doc_lines"] = nil
        stmt_i = stmt_i + 1
        parser_next_token(p)
    }
    if p["_skip_generator_core_inject"] != true && _program_needs_generator_core(prog) == true {
        prog["statements"] = _prepend_stmts(prog["statements"], _generator_core_stmts(p))
    }
    if p["_generator_forin_bridge_name"] != nil {
        prog["statements"] = _prepend_stmts(prog["statements"], _generator_forin_bridge_stmts(p))
    }
    // Carry trait declarations for tooling/metadata (no runtime meaning in v0).
    prog["traits"] = p["traits"]
    p["_gc_stmt"] = nil
    p["_gc_attrs"] = nil
    p["_gc_doc_lines"] = nil
    p["_gc_prog"] = nil
    gcroot["prog"] = nil
    gcroot["block_frames"] = nil
    p["_gc_root"] = nil
    oren_gc_pin(__prev_gc_pin)
    return prog
}

fn parse_attr_list(p) {
    var attrs = []
    while cur_is(p, token.TOK_AT) {
        var a = parse_attr(p)
        if a != nil { oren_list_push(attrs, a) }
        // Move to the next token after this attribute.
        parser_next_token(p)
    }
    return attrs
}

fn parse_attr(p) {
    // Current token is '@'
    var at_tok = p["cur"]
    if !core.expect_peek_attr_name(p, "attribute name") { return nil }
    var name = p["cur"]["literal"]
    // Support dotted namespaces: @myorg.tag(...)
    while peek_is(p, token.TOK_DOT) {
        parser_next_token(p) // '.'
        if !core.expect_peek_attr_name(p, "attribute name segment") { return nil }
        name = name + "." + p["cur"]["literal"]
    }

    // Normalize ergonomic aliases to canonical namespaces before strict validation
    // and before embedding into metadata.
    name = attr_normalize_name(name)

    attr_validate(p, name)

    var args = []
    // Optional ( ... )
    if peek_is(p, token.TOK_LPAREN) {
        parser_next_token(p) // '('
        parser_next_token(p) // first token inside args (or ')')

        if cur_is(p, token.TOK_RPAREN) {
            // no args
        } else {
            var cont = true
            while cont {
                var key = nil
                var val = nil

                // Keyword args in attrs: allow a small "attr-name token" set as keys.
                // This keeps ergonomic forms like `@json(default=0)` working even though
                // `default` is a keyword token in the lexer.
                if token.is_attr_name_token(p["cur"]["type"]) && peek_is(p, token.TOK_ASSIGN) {
                    key = p["cur"]["literal"]
                    parser_next_token(p) // '='
                    parser_next_token(p) // value
                }

                val = parse_attr_literal(p)
                if val == nil {
                    parser_add_error(p, "attribute args must be compile-time literals")
                    return nil
                }
                oren_list_push(args, {"key": key, "value": val})

                if peek_is(p, token.TOK_COMMA) {
                    parser_next_token(p) // ','
                    parser_next_token(p) // next
                } else {
                    cont = false
                }
            }

            if !peek_is(p, token.TOK_RPAREN) {
                parser_add_error(p, "expected ')' after attribute args")
                return nil
            }
            parser_next_token(p) // ')'
        }
    }

    return {"type": "Attr", "token": at_tok, "name": name, "args": args}
}

fn parse_attr_literal(p) {
    // Only allow literals in v0 attribute args to keep builds deterministic.
    var t = p["cur"]["type"]
    if t == token.TOK_STRING { return ast.new_string(p["cur"]) }
    if t == token.TOK_INT { return ast.new_integer(p["cur"]) }
    if t == token.TOK_FLOAT { return ast.new_float(p["cur"]) }
    if t == token.TOK_TRUE { return ast.new_boolean(p["cur"], true) }
    if t == token.TOK_FALSE { return ast.new_boolean(p["cur"], false) }
    if t == token.TOK_NIL { return ast.new_nil(p["cur"]) }
    return nil
}

fn _merge_attrs(existing, incoming) {
    // Merge two attribute lists without requiring callers to clone.
    // Ordering: keep any existing attrs first, then append incoming.
    if incoming == nil || oren_list_len(incoming) == 0 { return existing }
    if existing == nil || oren_list_len(existing) == 0 { return incoming }
    var i = 0
    while i < oren_list_len(incoming) {
        oren_list_push(existing, incoming[i])
        i = i + 1
    }
    return existing
}

fn _attrs_all_cfg(attrs) {
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil {
            if a["type"] != "Attr" { return false }
            var nm = a["name"]
            if nm != "oren.cfg" && nm != "oren.debug" && nm != "oren.release" { return false }
        }
        i = i + 1
    }
    return true
}

fn _attrs_all_arena_loop(attrs) {
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil {
            if a["type"] != "Attr" { return false }
            var nm = a["name"]
            if nm != "oren.arena" && nm != "oren.arena_iter" && nm != "oren.noarena" { return false }
        }
        i = i + 1
    }
    return true
}

fn _attrs_count_name(attrs, nm) {
    if attrs == nil || nm == nil { return 0 }
    var n = 0
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["type"] == "Attr" && a["name"] == nm {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn _attrs_has_name(attrs, nm) {
    return _attrs_count_name(attrs, nm) > 0
}

fn _attrs_filter_out_name(attrs, nm) {
    if attrs == nil { return attrs }
    var out = []
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["type"] == "Attr" && a["name"] == nm {
            // skip
        } else {
            oren_list_push(out, a)
        }
        i = i + 1
    }
    return out
}

fn _attrs_only_name(attrs, nm) {
    if attrs == nil { return attrs }
    var out = []
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["type"] == "Attr" && a["name"] == nm {
            oren_list_push(out, a)
        }
        i = i + 1
    }
    return out
}

fn _prepend_stmts(stmts, prefix_stmts) {
    if prefix_stmts == nil || oren_list_len(prefix_stmts) == 0 { return stmts }
    if stmts == nil { return prefix_stmts }
    var out = []
    var i = 0
    while i < oren_list_len(prefix_stmts) {
        oren_list_push(out, prefix_stmts[i])
        i = i + 1
    }
    i = 0
    while i < oren_list_len(stmts) {
        oren_list_push(out, stmts[i])
        i = i + 1
    }
    return out
}

fn _generator_helper_name_used(name) {
    if name == "oren_generator_start" { return true }
    if name == "oren_generator_next" { return true }
    if name == "oren_generator_send" { return true }
    if name == "oren_generator_delegate" { return true }
    if name == "oren_generator_on_finalize" { return true }
    if name == "oren_generator_on_close" { return true }
    if name == "oren_generator_close" { return true }
    if name == "oren_generator_is_done" { return true }
    if name == "oren_generator_return_value" { return true }
    if name == "oren_generator_collect" { return true }
    if name == "_oren_generator_context_exchange" { return true }
    return false
}

fn _expr_uses_generator_core(expr) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Identifier" {
        return _generator_helper_name_used(expr["value"]) == true
    }
    if t == "Function" || t == "Lambda" {
        return _stmt_uses_generator_core(expr["body"])
    }
    if t == "Prefix" {
        return _expr_uses_generator_core(expr["right"])
    }
    if t == "Infix" {
        if _expr_uses_generator_core(expr["left"]) == true { return true }
        return _expr_uses_generator_core(expr["right"])
    }
    if t == "If" {
        if _expr_uses_generator_core(expr["cond"]) == true { return true }
        if _stmt_uses_generator_core(expr["consq"]) == true { return true }
        return _stmt_uses_generator_core(expr["alt"])
    }
    if t == "Call" {
        if _expr_uses_generator_core(expr["fn"]) == true { return true }
        var args = expr["args"]
        var i = 0
        while args != nil && i < oren_list_len(args) {
            if _expr_uses_generator_core(args[i]) == true { return true }
            i = i + 1
        }
        if expr["spread"] != nil { return _expr_uses_generator_core(expr["spread"]) }
        return false
    }
    if t == "Member" {
        if _expr_uses_generator_core(expr["left"]) == true { return true }
        return _expr_uses_generator_core(expr["prop"])
    }
    if t == "Index" {
        if _expr_uses_generator_core(expr["left"]) == true { return true }
        return _expr_uses_generator_core(expr["index"])
    }
    if t == "Array" {
        var elems = expr["elements"]
        var ei = 0
        while elems != nil && ei < oren_list_len(elems) {
            if _expr_uses_generator_core(elems[ei]) == true { return true }
            ei = ei + 1
        }
        return false
    }
    if t == "Hash" {
        var pairs = expr["pairs"]
        var pi = 0
        while pairs != nil && pi < oren_list_len(pairs) {
            var pair = pairs[pi]
            if pair["key"] != nil && _expr_uses_generator_core(pair["key"]) == true { return true }
            if pair["value"] != nil && _expr_uses_generator_core(pair["value"]) == true { return true }
            if pair["k"] != nil && _expr_uses_generator_core(pair["k"]) == true { return true }
            if pair["v"] != nil && _expr_uses_generator_core(pair["v"]) == true { return true }
            pi = pi + 1
        }
        return false
    }
    if t == "SpawnExpr" {
        return _expr_uses_generator_core(expr["call"])
    }
    return false
}

fn _stmt_uses_generator_core(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Block" || t == "StmtList" {
        var xs = stmt["stmts"]
        var i = 0
        while xs != nil && i < oren_list_len(xs) {
            if _stmt_uses_generator_core(xs[i]) == true { return true }
            i = i + 1
        }
        return false
    }
    if t == "ExprStmt" { return _expr_uses_generator_core(stmt["expr"]) }
    if t == "Var" { return _expr_uses_generator_core(stmt["value"]) }
    if t == "Assign" { return _expr_uses_generator_core(stmt["value"]) }
    if t == "Set" {
        if _expr_uses_generator_core(stmt["left"]) == true { return true }
        return _expr_uses_generator_core(stmt["value"])
    }
    if t == "Return" { return _expr_uses_generator_core(stmt["value"]) }
    if t == "While" {
        if _expr_uses_generator_core(stmt["cond"]) == true { return true }
        return _stmt_uses_generator_core(stmt["body"])
    }
    if t == "For" {
        if _stmt_uses_generator_core(stmt["init"]) == true { return true }
        if _expr_uses_generator_core(stmt["cond"]) == true { return true }
        if _stmt_uses_generator_core(stmt["post"]) == true { return true }
        return _stmt_uses_generator_core(stmt["body"])
    }
    if t == "If" {
        if _expr_uses_generator_core(stmt["cond"]) == true { return true }
        if _stmt_uses_generator_core(stmt["consq"]) == true { return true }
        return _stmt_uses_generator_core(stmt["alt"])
    }
    if t == "Spawn" { return _expr_uses_generator_core(stmt["call"]) }
    if t == "Switch" {
        if _expr_uses_generator_core(stmt["value"]) == true { return true }
        var cases = stmt["cases"]
        var ci = 0
        while cases != nil && ci < oren_list_len(cases) {
            var c = cases[ci]
            var vals = c["values"]
            var vi = 0
            while vals != nil && vi < oren_list_len(vals) {
                if _expr_uses_generator_core(vals[vi]) == true { return true }
                vi = vi + 1
            }
            if _stmt_uses_generator_core(c["body"]) == true { return true }
            ci = ci + 1
        }
        return _stmt_uses_generator_core(stmt["default"])
    }
    return false
}

fn _program_needs_generator_core(prog) {
    if prog == nil || prog["statements"] == nil { return false }
    var stmts = prog["statements"]
    var i = 0
    while i < oren_list_len(stmts) {
        if _stmt_uses_generator_core(stmts[i]) == true { return true }
        i = i + 1
    }
    return false
}

fn _generator_core_src() {
    var src = ""
    src = src + "fn _oren_generator_err(ctx, msg) { return oren_err(4, ctx + \": \" + msg) }\n"
    src = src + "fn _oren_generator_trace(msg) {\n"
    src = src + "    if oren_env(\"OREN_TRACE_GENERATOR_CORE\") != nil { print(\"[trace] generator \" + msg) }\n"
    src = src + "    return nil\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_step_value(ok, done, value, retv) { return {\"ok\": ok, \"done\": done, \"value\": value, \"return\": retv} }\n"
    src = src + "fn _oren_generator_yield_step(value) { return _oren_generator_step_value(true, false, value, nil) }\n"
    src = src + "fn _oren_generator_done_step(retv) { return _oren_generator_step_value(false, true, nil, retv) }\n"
    src = src + "fn _oren_generator_is_handle(gen) {\n"
    src = src + "    return oren_type_name(gen) == \"generator\"\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_is_context(co) {\n"
    src = src + "    return oren_type_name(co) == \"generator_context\"\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_expect_handle(gen, ctx) {\n"
    src = src + "    if _oren_generator_is_handle(gen) == true { return nil }\n"
    src = src + "    return _oren_generator_err(ctx, \"expected generator handle\")\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_expect_context(co, ctx) {\n"
    src = src + "    if _oren_generator_is_context(co) == true { return nil }\n"
    src = src + "    return _oren_generator_err(ctx, \"expected generator context\")\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_expect_close_hook(hook, ctx) {\n"
    src = src + "    if oren_type_name(hook) == \"func\" { return nil }\n"
    src = src + "    return _oren_generator_err(ctx, \"expected zero-arg function finalizer hook\")\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_get(gen, slot) { return gen[slot] }\n"
    src = src + "fn _oren_generator_set(gen, slot, value) { gen[slot] = value; return value }\n"
    src = src + "fn _oren_generator_terminal_result(gen) {\n"
    src = src + "    var terminal_err = _oren_generator_get(gen, 13)\n"
    src = src + "    if terminal_err != nil { return terminal_err }\n"
    src = src + "    return _oren_generator_get(gen, 9)\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_done_result(gen) {\n"
    src = src + "    var terminal_err = _oren_generator_get(gen, 13)\n"
    src = src + "    if terminal_err != nil { return terminal_err }\n"
    src = src + "    return _oren_generator_done_step(_oren_generator_get(gen, 9))\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_context_owner(co) {\n"
    src = src + "    if _oren_generator_is_context(co) != true { return nil }\n"
    src = src + "    return _oren_generator_get(co, 3)\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_bind_active_child(owner, child) {\n"
    src = src + "    if _oren_generator_is_handle(owner) != true { return nil }\n"
    src = src + "    var prev = _oren_generator_get(owner, 11)\n"
    src = src + "    _oren_generator_set(owner, 11, child)\n"
    src = src + "    return prev\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_restore_active_child(owner, prev) {\n"
    src = src + "    if _oren_generator_is_handle(owner) != true { return nil }\n"
    src = src + "    _oren_generator_set(owner, 11, prev)\n"
    src = src + "    return nil\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_close_active_child(gen) {\n"
    src = src + "    var child = _oren_generator_get(gen, 11)\n"
    src = src + "    if child == nil { return nil }\n"
    src = src + "    _oren_generator_set(gen, 11, nil)\n"
    src = src + "    if child == gen { return nil }\n"
    src = src + "    if _oren_generator_is_handle(child) != true { return nil }\n"
    src = src + "    return oren_generator_close(child)\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_push_close_hook(gen, hook) {\n"
    src = src + "    var hooks = _oren_generator_get(gen, 12)\n"
    src = src + "    if hooks == nil {\n"
    src = src + "        hooks = []\n"
    src = src + "        _oren_generator_set(gen, 12, hooks)\n"
    src = src + "    }\n"
    src = src + "    oren_list_push(hooks, hook)\n"
    src = src + "    return nil\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_run_close_hooks(gen) {\n"
    src = src + "    var hooks = _oren_generator_get(gen, 12)\n"
    src = src + "    _oren_generator_set(gen, 12, nil)\n"
    src = src + "    if hooks == nil { return nil }\n"
    src = src + "    var first_err = nil\n"
    src = src + "    var i = oren_list_len(hooks)\n"
    src = src + "    while i > 0 {\n"
    src = src + "        i = i - 1\n"
    src = src + "        var rv = hooks[i]()\n"
    src = src + "        if first_err == nil && oren_is_err(rv) == true { first_err = rv }\n"
    src = src + "    }\n"
    src = src + "    return first_err\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_ctx(yield_ch, resume_ch, owner) {\n"
    src = src + "    return [\"__oren_generator_context_v2\", yield_ch, resume_ch, owner]\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_context_exchange(co, value) {\n"
    src = src + "    var bad = _oren_generator_expect_context(co, \"yield in\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    return oren_yield_exchange(_oren_generator_get(co, 1), _oren_generator_get(co, 2), value)\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_expect_step(step, op) {\n"
    src = src + "    if step == nil { return _oren_generator_err(op, \"expected generator step\") }\n"
    src = src + "    if step[\"done\"] == true { return nil }\n"
    src = src + "    if step[\"ok\"] == true { return nil }\n"
    src = src + "    return _oren_generator_err(op, \"expected generator step\")\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_mark_done(gen, retv, terminal_err) {\n"
    src = src + "    _oren_generator_set(gen, 8, true)\n"
    src = src + "    _oren_generator_set(gen, 9, retv)\n"
    src = src + "    _oren_generator_set(gen, 10, nil)\n"
    src = src + "    _oren_generator_set(gen, 11, nil)\n"
    src = src + "    _oren_generator_set(gen, 12, nil)\n"
    src = src + "    _oren_generator_set(gen, 13, terminal_err)\n"
    src = src + "    return retv\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_finalize(gen) {\n"
    src = src + "    var first_err = nil\n"
    src = src + "    var child_close = _oren_generator_close_active_child(gen)\n"
    src = src + "    if first_err == nil && oren_is_err(child_close) == true { first_err = child_close }\n"
    src = src + "    var hook_close = _oren_generator_run_close_hooks(gen)\n"
    src = src + "    if first_err == nil && oren_is_err(hook_close) == true { first_err = hook_close }\n"
    src = src + "    return first_err\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_finish(gen, retv) {\n"
    src = src + "    var first_err = _oren_generator_finalize(gen)\n"
    src = src + "    _oren_generator_mark_done(gen, retv, first_err)\n"
    src = src + "    var task = _oren_generator_get(gen, 6)\n"
    src = src + "    if task != nil && task != 0 { oren_join(task) }\n"
    src = src + "    _oren_generator_set(gen, 6, nil)\n"
    src = src + "    if first_err != nil { return first_err }\n"
    src = src + "    return retv\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_entry(worker, args_list, yield_ch, resume_ch, done_ch, gen) {\n"
    src = src + "    var retv = worker(_oren_generator_ctx(yield_ch, resume_ch, gen), args_list)\n"
    src = src + "    oren_chan_send(done_ch, retv)\n"
    src = src + "    return retv\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_ensure_task(gen) {\n"
    src = src + "    var task = _oren_generator_get(gen, 6)\n"
    src = src + "    if task != nil && task != 0 { return task }\n"
    src = src + "    task = spawn _oren_generator_entry(\n"
    src = src + "        _oren_generator_get(gen, 1),\n"
    src = src + "        _oren_generator_get(gen, 2),\n"
    src = src + "        _oren_generator_get(gen, 3),\n"
    src = src + "        _oren_generator_get(gen, 4),\n"
    src = src + "        _oren_generator_get(gen, 5),\n"
    src = src + "        gen\n"
    src = src + "    )\n"
    src = src + "    _oren_generator_set(gen, 6, task)\n"
    src = src + "    return task\n"
    src = src + "}\n"
    src = src + "fn _oren_generator_resume(gen, value) {\n"
    src = src + "    _oren_generator_trace(\"resume.start\")\n"
    src = src + "    _oren_generator_set(gen, 10, nil)\n"
    src = src + "    _oren_generator_ensure_task(gen)\n"
    src = src + "    _oren_generator_trace(\"resume.after_ensure\")\n"
    src = src + "    if _oren_generator_get(gen, 7) == true {\n"
    src = src + "        oren_chan_send(_oren_generator_get(gen, 4), value)\n"
    src = src + "        _oren_generator_trace(\"resume.after_send\")\n"
    src = src + "    } else {\n"
    src = src + "        _oren_generator_set(gen, 7, true)\n"
    src = src + "        _oren_generator_trace(\"resume.mark_started\")\n"
    src = src + "    }\n"
    src = src + "    oren_yield()\n"
    src = src + "    _oren_generator_trace(\"resume.after_yield\")\n"
    src = src + "    var sel = oren_select([[0, _oren_generator_get(gen, 5)], [0, _oren_generator_get(gen, 3)]])\n"
    src = src + "    _oren_generator_trace(\"resume.after_select\")\n"
    src = src + "    var idx = sel[0]\n"
    src = src + "    var payload = sel[1]\n"
    src = src + "    if idx == 0 {\n"
    src = src + "        _oren_generator_trace(\"resume.done_slot\")\n"
    src = src + "        var finished = _oren_generator_finish(gen, payload)\n"
    src = src + "        if oren_is_err(finished) == true { return finished }\n"
    src = src + "        return _oren_generator_done_step(payload)\n"
    src = src + "    }\n"
    src = src + "    _oren_generator_trace(\"resume.yield_slot\")\n"
    src = src + "    var step = _oren_generator_yield_step(payload)\n"
    src = src + "    _oren_generator_set(gen, 10, step)\n"
    src = src + "    return step\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_start(worker, args_list) {\n"
    src = src + "    if args_list == nil { args_list = [] }\n"
    src = src + "    var yield_ch = oren_new_channel()\n"
    src = src + "    var resume_ch = oren_new_channel()\n"
    src = src + "    var done_ch = oren_new_channel()\n"
    src = src + "    return [\"__oren_generator_handle_v2\", worker, args_list, yield_ch, resume_ch, done_ch, nil, false, false, nil, nil, nil, nil, nil]\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_next(gen) {\n"
    src = src + "    var bad = _oren_generator_expect_handle(gen, \"generator.next\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_get(gen, 8) == true { return _oren_generator_done_result(gen) }\n"
    src = src + "    return _oren_generator_resume(gen, nil)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_send(gen, value) {\n"
    src = src + "    var bad = _oren_generator_expect_handle(gen, \"generator.send\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_get(gen, 8) == true { return _oren_generator_done_result(gen) }\n"
    src = src + "    if _oren_generator_get(gen, 7) != true && value != nil {\n"
    src = src + "        return _oren_generator_err(\"generator.send\", \"initial send expects nil; use generator.next(gen) first\")\n"
    src = src + "    }\n"
    src = src + "    return _oren_generator_resume(gen, value)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_on_finalize(co, hook) {\n"
    src = src + "    var bad = _oren_generator_expect_context(co, \"generator.on_finalize\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    bad = _oren_generator_expect_close_hook(hook, \"generator.on_finalize\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    var owner = _oren_generator_context_owner(co)\n"
    src = src + "    bad = _oren_generator_expect_handle(owner, \"generator.on_finalize\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    return _oren_generator_push_close_hook(owner, hook)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_on_close(co, hook) {\n"
    src = src + "    return oren_generator_on_finalize(co, hook)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_close(gen) {\n"
    src = src + "    var bad = _oren_generator_expect_handle(gen, \"generator.close\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_get(gen, 8) == true {\n"
    src = src + "        _oren_generator_trace(\"close.already_done\")\n"
    src = src + "        return _oren_generator_terminal_result(gen)\n"
    src = src + "    }\n"
    src = src + "    var first_err = _oren_generator_finalize(gen)\n"
    src = src + "    var task = _oren_generator_get(gen, 6)\n"
    src = src + "    if _oren_generator_get(gen, 7) == true && task != nil && task != 0 {\n"
    src = src + "        _oren_generator_trace(\"close.detach_live_task\")\n"
    src = src + "        oren_detach(task)\n"
    src = src + "    }\n"
    src = src + "    _oren_generator_trace(\"close.mark_done\")\n"
    src = src + "    _oren_generator_set(gen, 6, nil)\n"
    src = src + "    _oren_generator_mark_done(gen, nil, first_err)\n"
    src = src + "    if first_err != nil { return first_err }\n"
    src = src + "    return nil\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_delegate(co, inner) {\n"
    src = src + "    _oren_generator_trace(\"delegate.start\")\n"
    src = src + "    var bad = _oren_generator_expect_context(co, \"generator.delegate\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    bad = _oren_generator_expect_handle(inner, \"generator.delegate\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_get(inner, 8) == true {\n"
    src = src + "        _oren_generator_trace(\"delegate.already_done\")\n"
    src = src + "        return _oren_generator_terminal_result(inner)\n"
    src = src + "    }\n"
    src = src + "    if _oren_generator_get(inner, 7) == true {\n"
    src = src + "        var step = _oren_generator_get(inner, 10)\n"
    src = src + "        if step == nil {\n"
    src = src + "            return _oren_generator_err(\"generator.delegate\", \"expected cached yielded step for started generator handle\")\n"
    src = src + "        }\n"
    src = src + "        _oren_generator_trace(\"delegate.cached_step\")\n"
    src = src + "        return oren_generator_delegate_step(co, inner, step)\n"
    src = src + "    }\n"
    src = src + "    var owner = _oren_generator_context_owner(co)\n"
    src = src + "    var prev_child = _oren_generator_bind_active_child(owner, inner)\n"
    src = src + "    _oren_generator_set(inner, 7, true)\n"
    src = src + "    _oren_generator_trace(\"delegate.inline\")\n"
    src = src + "    var inner_co = _oren_generator_ctx(_oren_generator_get(co, 1), _oren_generator_get(co, 2), inner)\n"
    src = src + "    var retv = _oren_generator_get(inner, 1)(inner_co, _oren_generator_get(inner, 2))\n"
    src = src + "    var finished = _oren_generator_finish(inner, retv)\n"
    src = src + "    _oren_generator_restore_active_child(owner, prev_child)\n"
    src = src + "    if oren_is_err(finished) == true { return finished }\n"
    src = src + "    _oren_generator_trace(\"delegate.done\")\n"
    src = src + "    return retv\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_delegate_step(co, inner, step) {\n"
    src = src + "    _oren_generator_trace(\"delegate_step.start\")\n"
    src = src + "    var bad = _oren_generator_expect_context(co, \"generator.delegate_step\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    bad = _oren_generator_expect_handle(inner, \"generator.delegate_step\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    bad = _oren_generator_expect_step(step, \"generator.delegate_step\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    if _oren_generator_get(inner, 8) == true {\n"
    src = src + "        _oren_generator_trace(\"delegate_step.done\")\n"
    src = src + "        return _oren_generator_terminal_result(inner)\n"
    src = src + "    }\n"
    src = src + "    if step[\"done\"] == true {\n"
    src = src + "        _oren_generator_trace(\"delegate_step.done\")\n"
    src = src + "        return step[\"return\"]\n"
    src = src + "    }\n"
    src = src + "    if _oren_generator_get(inner, 7) != true {\n"
    src = src + "        return _oren_generator_err(\"generator.delegate_step\", \"expected started generator handle\")\n"
    src = src + "    }\n"
    src = src + "    var owner = _oren_generator_context_owner(co)\n"
    src = src + "    var prev_child = _oren_generator_bind_active_child(owner, inner)\n"
    src = src + "    while true {\n"
    src = src + "        _oren_generator_trace(\"delegate_step.yield\")\n"
    src = src + "        var resumed = _oren_generator_context_exchange(co, step[\"value\"])\n"
    src = src + "        step = oren_generator_send(inner, resumed)\n"
    src = src + "        if oren_is_err(step) == true {\n"
    src = src + "            _oren_generator_restore_active_child(owner, prev_child)\n"
    src = src + "            return step\n"
    src = src + "        }\n"
    src = src + "        if step[\"done\"] == true {\n"
    src = src + "            _oren_generator_trace(\"delegate_step.done\")\n"
    src = src + "            _oren_generator_restore_active_child(owner, prev_child)\n"
    src = src + "            return step[\"return\"]\n"
    src = src + "        }\n"
    src = src + "    }\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_is_done(gen) {\n"
    src = src + "    if _oren_generator_is_handle(gen) != true { return false }\n"
    src = src + "    return _oren_generator_get(gen, 8) == true\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_return_value(gen) {\n"
    src = src + "    if _oren_generator_is_handle(gen) != true { return nil }\n"
    src = src + "    return _oren_generator_get(gen, 9)\n"
    src = src + "}\n"
    src = src + "@oren.keep\n"
    src = src + "fn oren_generator_collect(gen) {\n"
    src = src + "    var bad = _oren_generator_expect_handle(gen, \"generator.collect\")\n"
    src = src + "    if bad != nil { return bad }\n"
    src = src + "    var out = []\n"
    src = src + "    while true {\n"
    src = src + "        var step = oren_generator_next(gen)\n"
    src = src + "        if oren_is_err(step) == true { return step }\n"
    src = src + "        if step[\"done\"] == true { return out }\n"
    src = src + "        oren_list_push(out, step[\"value\"])\n"
    src = src + "    }\n"
    src = src + "}\n"
    return src
}

fn _generator_core_stmts(p) {
    var file = p["file"]
    if file == nil { file = "" }
    var helper_file = file + "#oren_generator_core_v0#" + parser_gensym(p, "__oren_generator_core_")
    var l = lexer.new_lexer(_generator_core_src())
    l["file"] = helper_file
    var hp = core.new_parser(l)
    hp["file"] = helper_file
    hp["strict_attrs"] = p["strict_attrs"]
    hp["attr_allow_prefixes"] = p["attr_allow_prefixes"]
    hp["strict_ident_prefixes"] = p["strict_ident_prefixes"]
    hp["ident_allow_prefixes"] = p["ident_allow_prefixes"]
    hp["_skip_generator_core_inject"] = true
    var prog = parse_program(hp)
    if oren_list_len(hp["errors"]) > 0 {
        parser_add_error(p, "internal generator core parse failure")
        return []
    }
    return prog["statements"]
}

fn _generator_helper_hex_digit(n) {
    return oren_string_char_at("0123456789abcdef", n)
}

fn _generator_helper_byte_hex(b) {
    if b < 0 { b = 0 }
    if b > 255 { b = 255 }
    var hi = b / 16
    var lo = b - (hi * 16)
    return _generator_helper_hex_digit(hi) + _generator_helper_hex_digit(lo)
}

fn _generator_helper_file_hash(file) {
    if file == nil || file == "" { return "0" }
    var out = ""
    var i = 0
    var n = oren_string_len(file)
    if n <= 24 {
        while i < n {
            out = out + _generator_helper_byte_hex(oren_string_byte_at_unchecked(file, i))
            i = i + 1
        }
        return out
    }
    while i < 12 {
        out = out + _generator_helper_byte_hex(oren_string_byte_at_unchecked(file, i))
        i = i + 1
    }
    out = out + "_" + oren_int_to_string(n) + "_"
    i = n - 12
    while i < n {
        out = out + _generator_helper_byte_hex(oren_string_byte_at_unchecked(file, i))
        i = i + 1
    }
    return out
}

fn _generator_forin_bridge_name(p) {
    var name = p["_generator_forin_bridge_name"]
    if name != nil { return name }
    var file = p["file"]
    if file == nil { file = "" }
    name = parser_gensym(p, "__oren_generator_forin_next_f" + _generator_helper_file_hash(file) + "_")
    p["_generator_forin_bridge_name"] = name
    return name
}

fn _generator_forin_bridge_src(name) {
    var pair_name = name + "_pair"
    var ctx_name = name + "_ctx"
    var entry_name = name + "_entry"
    var src = ""
    src = src + "fn " + pair_name + "(out_pair, okv, value) {\n"
    src = src + "    if oren_type_name(out_pair) == \"list\" && oren_list_len(out_pair) >= 2 {\n"
    src = src + "        out_pair[0] = okv\n"
    src = src + "        out_pair[1] = value\n"
    src = src + "        return out_pair\n"
    src = src + "    }\n"
    src = src + "    return [okv, value]\n"
    src = src + "}\n"
    src = src + "fn " + ctx_name + "(yield_ch, resume_ch, owner) {\n"
    src = src + "    return [\"__oren_generator_context_v2\", yield_ch, resume_ch, owner]\n"
    src = src + "}\n"
    src = src + "fn " + entry_name + "(worker, args_list, yield_ch, resume_ch, done_ch, owner) {\n"
    src = src + "    var retv = worker(" + ctx_name + "(yield_ch, resume_ch, owner), args_list)\n"
    src = src + "    oren_chan_send(done_ch, retv)\n"
    src = src + "    return retv\n"
    src = src + "}\n"
    src = src + "fn " + name + "(container, idx, out_pair) {\n"
    src = src + "    if oren_type_name(container) != \"generator\" { return oren_iter_next(container, idx, out_pair) }\n"
    src = src + "    if idx < 0 { return " + pair_name + "(out_pair, 0, nil) }\n"
    src = src + "    if container[8] == true { return " + pair_name + "(out_pair, 0, nil) }\n"
    src = src + "    var task = container[6]\n"
    src = src + "    if task == nil || task == 0 {\n"
    src = src + "        task = spawn " + entry_name + "(container[1], container[2], container[3], container[4], container[5], container)\n"
    src = src + "        container[6] = task\n"
    src = src + "    }\n"
    src = src + "    if container[7] == true {\n"
    src = src + "        oren_chan_send(container[4], nil)\n"
    src = src + "    } else {\n"
    src = src + "        container[7] = true\n"
    src = src + "    }\n"
    src = src + "    oren_yield()\n"
    src = src + "    var sel = oren_select([[0, container[5]], [0, container[3]]])\n"
    src = src + "    var slot = sel[0]\n"
    src = src + "    var payload = sel[1]\n"
    src = src + "    if slot == 0 {\n"
    src = src + "        container[8] = true\n"
    src = src + "        container[9] = payload\n"
    src = src + "        container[10] = nil\n"
    src = src + "        container[11] = nil\n"
    src = src + "        task = container[6]\n"
    src = src + "        if task != nil && task != 0 { oren_join(task) }\n"
    src = src + "        container[6] = nil\n"
    src = src + "        return " + pair_name + "(out_pair, 0, nil)\n"
    src = src + "    }\n"
    src = src + "    return " + pair_name + "(out_pair, 1, payload)\n"
    src = src + "}\n"
    return src
}

fn _generator_forin_bridge_stmts(p) {
    var name = p["_generator_forin_bridge_name"]
    if name == nil { return [] }
    var file = p["file"]
    if file == nil { file = "" }
    var helper_file = file + "#generator_forin_bridge#" + name
    var l = lexer.new_lexer(_generator_forin_bridge_src(name))
    l["file"] = helper_file
    var hp = core.new_parser(l)
    hp["file"] = helper_file
    hp["strict_attrs"] = p["strict_attrs"]
    hp["attr_allow_prefixes"] = p["attr_allow_prefixes"]
    hp["strict_ident_prefixes"] = p["strict_ident_prefixes"]
    hp["ident_allow_prefixes"] = p["ident_allow_prefixes"]
    hp["_skip_generator_core_inject"] = true
    var prog = parse_program(hp)
    if oren_list_len(hp["errors"]) > 0 {
        parser_add_error(p, "internal generator for-in bridge parse failure")
        return []
    }
    return prog["statements"]
}

fn _generator_nil_expr() {
    return ast.new_nil(token.new_token(token.TOK_NIL, "nil"))
}

fn _local_fn_decl_name_ident(fun) {
    if fun == nil { return nil }
    var nm = fun["name"]
    if nm == nil || nm == "" { return nil }
    var tok = token.new_token(token.TOK_IDENT, nm)
    var src = fun["token"]
    if src != nil {
        if src["file"] != nil { tok["file"] = src["file"] }
        if src["line"] != nil { tok["line"] = src["line"] }
        if src["col"] != nil { tok["col"] = src["col"] }
        if src["pos"] != nil { tok["pos"] = src["pos"] }
        if src["end"] != nil { tok["end"] = src["end"] }
    }
    return ast.new_identifier(tok)
}

fn _generator_var_decl_name_ident(stmt) {
    if stmt == nil || stmt["type"] != "Var" { return nil }
    var name = stmt["name"]
    if name == nil || name["type"] != "Identifier" { return nil }
    return name
}

fn _generator_var_decl_function(stmt) {
    if stmt == nil || stmt["type"] != "Var" { return nil }
    var value = stmt["value"]
    if value == nil || value["type"] != "Function" { return nil }
    return value
}

fn maybe_lower_local_fn_decl_stmt(p, stmt) {
    if stmt == nil || stmt["type"] != "ExprStmt" { return stmt }
    if p["block_depth"] <= 0 { return stmt }
    var fun = stmt["expr"]
    if fun == nil || fun["type"] != "Function" { return stmt }
    var name_ident = _local_fn_decl_name_ident(fun)
    if name_ident == nil { return stmt }
    fun["decl_name"] = fun["name"]
    fun["name"] = ""
    return ast.new_var(fun["token"], name_ident, fun)
}

fn _generator_call_is_finalize_hook(fn_expr) {
    if fn_expr == nil { return false }
    if fn_expr["type"] == "Identifier" {
        return fn_expr["value"] == "oren_generator_on_close" || fn_expr["value"] == "oren_generator_on_finalize"
    }
    if fn_expr["type"] != "Member" { return false }
    var prop = fn_expr["prop"]
    if prop == nil || prop["type"] != "Identifier" { return false }
    return prop["value"] == "on_close" || prop["value"] == "on_finalize"
}

fn _generator_rewrite_yield_expr(expr, co_name) {
    if expr == nil { return nil }
    var t = expr["type"]

    if t == "Function" || t == "Lambda" { return expr }

    if t == "Prefix" {
        expr["right"] = _generator_rewrite_yield_expr(expr["right"], co_name)
        return expr
    }
    if t == "Infix" {
        expr["left"] = _generator_rewrite_yield_expr(expr["left"], co_name)
        expr["right"] = _generator_rewrite_yield_expr(expr["right"], co_name)
        return expr
    }
    if t == "If" {
        expr["cond"] = _generator_rewrite_yield_expr(expr["cond"], co_name)
        expr["consq"] = _generator_rewrite_yield_stmt(expr["consq"], co_name)
        if expr["alt"] != nil { expr["alt"] = _generator_rewrite_yield_stmt(expr["alt"], co_name) }
        return expr
    }
    if t == "Call" {
        if expr["yield_delegate_expr"] == true {
            var argsd = expr["args"]
            if argsd != nil && oren_list_len(argsd) > 1 {
                argsd[1] = _generator_rewrite_yield_expr(argsd[1], co_name)
            }
            if expr["yield_delegate_missing_context"] == true {
                var ctx_tok2 = token.new_token(token.TOK_IDENT, co_name)
                argsd[0] = ast.new_identifier(ctx_tok2)
                expr["yield_delegate_missing_context"] = false
                expr["yield_delegate_syntax_kind"] = "generator_decl_yield_from"
            } else if argsd != nil && oren_list_len(argsd) > 0 {
                argsd[0] = _generator_rewrite_yield_expr(argsd[0], co_name)
            }
            return expr
        }
        if expr["yield_value_expr"] == true {
            var tok = expr["yield_token"]
            if tok == nil { tok = expr["token"] }
            var value_expr = _generator_nil_expr()
            var args0 = expr["args"]
            if args0 != nil && oren_list_len(args0) > 0 {
                value_expr = _generator_rewrite_yield_expr(args0[0], co_name)
            }
            var ctx_tok = token.new_token(token.TOK_IDENT, co_name)
            var out = yield_exchange_context_expr_call(
                tok,
                ast.new_identifier(ctx_tok),
                value_expr,
                expr["yield_value_explicit"] == true
            )
            out["yield_exchange_syntax_kind"] = "generator_decl"
            return out
        }
        if expr["generator_finalize_expr"] == true {
            expr["fn"] = _generator_rewrite_yield_expr(expr["fn"], co_name)
            var finalize_args = expr["args"]
            if expr["generator_finalize_missing_context"] == true {
                var ctx_tokf = token.new_token(token.TOK_IDENT, co_name)
                expr["args"] = [
                    ast.new_identifier(ctx_tokf),
                    _generator_rewrite_yield_expr(finalize_args[0], co_name)
                ]
                expr["generator_finalize_missing_context"] = false
                expr["generator_finalize_syntax_kind"] = "generator_decl_defer"
                return expr
            }
            var fi = 0
            while finalize_args != nil && fi < oren_list_len(finalize_args) {
                finalize_args[fi] = _generator_rewrite_yield_expr(finalize_args[fi], co_name)
                fi = fi + 1
            }
            return expr
        }
        if _generator_call_is_finalize_hook(expr["fn"]) == true {
            expr["fn"] = _generator_rewrite_yield_expr(expr["fn"], co_name)
            var hook_args = expr["args"]
            if hook_args != nil && oren_list_len(hook_args) == 1 {
                var ctx_tok3 = token.new_token(token.TOK_IDENT, co_name)
                expr["args"] = [
                    ast.new_identifier(ctx_tok3),
                    _generator_rewrite_yield_expr(hook_args[0], co_name)
                ]
                return expr
            }
        }
        expr["fn"] = _generator_rewrite_yield_expr(expr["fn"], co_name)
        var args = expr["args"]
        var i = 0
        while args != nil && i < oren_list_len(args) {
            args[i] = _generator_rewrite_yield_expr(args[i], co_name)
            i = i + 1
        }
        if expr["spread"] != nil { expr["spread"] = _generator_rewrite_yield_expr(expr["spread"], co_name) }
        return expr
    }
    if t == "Member" {
        expr["left"] = _generator_rewrite_yield_expr(expr["left"], co_name)
        expr["prop"] = _generator_rewrite_yield_expr(expr["prop"], co_name)
        return expr
    }
    if t == "Index" {
        expr["left"] = _generator_rewrite_yield_expr(expr["left"], co_name)
        expr["index"] = _generator_rewrite_yield_expr(expr["index"], co_name)
        return expr
    }
    if t == "Array" {
        var elems = expr["elements"]
        var ei = 0
        while elems != nil && ei < oren_list_len(elems) {
            elems[ei] = _generator_rewrite_yield_expr(elems[ei], co_name)
            ei = ei + 1
        }
        return expr
    }
    if t == "Hash" {
        var pairs = expr["pairs"]
        var pi = 0
        while pairs != nil && pi < oren_list_len(pairs) {
            var pair = pairs[pi]
            if pair["key"] != nil { pair["key"] = _generator_rewrite_yield_expr(pair["key"], co_name) }
            if pair["value"] != nil { pair["value"] = _generator_rewrite_yield_expr(pair["value"], co_name) }
            if pair["k"] != nil { pair["k"] = _generator_rewrite_yield_expr(pair["k"], co_name) }
            if pair["v"] != nil { pair["v"] = _generator_rewrite_yield_expr(pair["v"], co_name) }
            pi = pi + 1
        }
        return expr
    }
    if t == "SpawnExpr" {
        expr["call"] = _generator_rewrite_yield_expr(expr["call"], co_name)
        return expr
    }

    return expr
}

fn _yield_delegate_source_site(expr) {
    if expr == nil { return "yield from" }
    var tok = expr["yield_token"]
    if tok == nil { tok = expr["token"] }
    if tok == nil { return "yield from" }
    var file = tok["file"]
    var line = tok["line"]
    var col = tok["col"]
    var out = "yield from"
    if file != nil && file != "" { out = out + " at " + file }
    if line != nil && line > 0 {
        out = out + ":" + oren_int_to_string(line)
        if col != nil && col > 0 { out = out + ":" + oren_int_to_string(col) }
    }
    return out
}

fn _generator_finalize_source_site(expr) {
    if expr == nil { return "defer" }
    var tok = expr["generator_finalize_token"]
    if tok == nil { tok = expr["token"] }
    if tok == nil { return "defer" }
    var file = tok["file"]
    var line = tok["line"]
    var col = tok["col"]
    var out = "defer"
    if file != nil && file != "" { out = out + " at " + file }
    if line != nil && line > 0 {
        out = out + ":" + oren_int_to_string(line)
        if col != nil && col > 0 { out = out + ":" + oren_int_to_string(col) }
    }
    return out
}

fn _stmt_validate_yield_delegate_expr(p, expr) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Function" || t == "Lambda" { return nil }
    if t == "Prefix" {
        return _stmt_validate_yield_delegate_expr(p, expr["right"])
    }
    if t == "Infix" {
        _stmt_validate_yield_delegate_expr(p, expr["left"])
        _stmt_validate_yield_delegate_expr(p, expr["right"])
        return nil
    }
    if t == "If" {
        _stmt_validate_yield_delegate_expr(p, expr["cond"])
        _stmt_validate_yield_delegate_stmt(p, expr["consq"])
        if expr["alt"] != nil { _stmt_validate_yield_delegate_stmt(p, expr["alt"]) }
        return nil
    }
    if t == "Call" {
        if expr["yield_delegate_expr"] == true && expr["yield_delegate_missing_context"] == true {
            parser_add_error(p, _yield_delegate_source_site(expr) + " requires 'in co' outside @oren.generator declarations")
            return nil
        }
        if expr["generator_finalize_expr"] == true && expr["generator_finalize_missing_context"] == true {
            parser_add_error(p, _generator_finalize_source_site(expr) + " requires 'in co' outside @oren.generator declarations")
            return nil
        }
        _stmt_validate_yield_delegate_expr(p, expr["fn"])
        var args = expr["args"]
        var i = 0
        while args != nil && i < oren_list_len(args) {
            _stmt_validate_yield_delegate_expr(p, args[i])
            i = i + 1
        }
        if expr["spread"] != nil { _stmt_validate_yield_delegate_expr(p, expr["spread"]) }
        return nil
    }
    if t == "Member" {
        _stmt_validate_yield_delegate_expr(p, expr["left"])
        _stmt_validate_yield_delegate_expr(p, expr["prop"])
        return nil
    }
    if t == "Index" {
        _stmt_validate_yield_delegate_expr(p, expr["left"])
        _stmt_validate_yield_delegate_expr(p, expr["index"])
        return nil
    }
    if t == "Array" {
        var elems = expr["elements"]
        var ei = 0
        while elems != nil && ei < oren_list_len(elems) {
            _stmt_validate_yield_delegate_expr(p, elems[ei])
            ei = ei + 1
        }
        return nil
    }
    if t == "Hash" {
        var pairs = expr["pairs"]
        var pi = 0
        while pairs != nil && pi < oren_list_len(pairs) {
            var pair = pairs[pi]
            if pair["key"] != nil { _stmt_validate_yield_delegate_expr(p, pair["key"]) }
            if pair["value"] != nil { _stmt_validate_yield_delegate_expr(p, pair["value"]) }
            if pair["k"] != nil { _stmt_validate_yield_delegate_expr(p, pair["k"]) }
            if pair["v"] != nil { _stmt_validate_yield_delegate_expr(p, pair["v"]) }
            pi = pi + 1
        }
        return nil
    }
    if t == "SpawnExpr" {
        _stmt_validate_yield_delegate_expr(p, expr["call"])
        return nil
    }
    return nil
}

fn _stmt_validate_yield_delegate_stmt(p, stmt) {
    if stmt == nil { return nil }
    if stmt["yield_stmt"] == true { return nil }
    var t = stmt["type"]
    if t == "ExprStmt" {
        var expr = stmt["expr"]
        if expr != nil && expr["type"] == "Function" {
            return _stmt_validate_yield_delegate_stmt(p, expr["body"])
        }
        return _stmt_validate_yield_delegate_expr(p, expr)
    }
    if t == "Var" {
        var value = stmt["value"]
        if value != nil && value["type"] == "Function" {
            return _stmt_validate_yield_delegate_stmt(p, value["body"])
        }
        return _stmt_validate_yield_delegate_expr(p, value)
    }
    if t == "Assign" {
        return _stmt_validate_yield_delegate_expr(p, stmt["value"])
    }
    if t == "Set" {
        _stmt_validate_yield_delegate_expr(p, stmt["left"])
        _stmt_validate_yield_delegate_expr(p, stmt["value"])
        return nil
    }
    if t == "Return" { return _stmt_validate_yield_delegate_expr(p, stmt["value"]) }
    if t == "Block" || t == "StmtList" {
        var xs = stmt["stmts"]
        var i = 0
        while xs != nil && i < oren_list_len(xs) {
            _stmt_validate_yield_delegate_stmt(p, xs[i])
            i = i + 1
        }
        return nil
    }
    if t == "While" {
        _stmt_validate_yield_delegate_expr(p, stmt["cond"])
        return _stmt_validate_yield_delegate_stmt(p, stmt["body"])
    }
    if t == "For" {
        _stmt_validate_yield_delegate_stmt(p, stmt["init"])
        _stmt_validate_yield_delegate_expr(p, stmt["cond"])
        _stmt_validate_yield_delegate_stmt(p, stmt["post"])
        return _stmt_validate_yield_delegate_stmt(p, stmt["body"])
    }
    if t == "If" {
        _stmt_validate_yield_delegate_expr(p, stmt["cond"])
        _stmt_validate_yield_delegate_stmt(p, stmt["consq"])
        if stmt["alt"] != nil { _stmt_validate_yield_delegate_stmt(p, stmt["alt"]) }
        return nil
    }
    if t == "Spawn" { return _stmt_validate_yield_delegate_expr(p, stmt["call"]) }
    if t == "Switch" {
        _stmt_validate_yield_delegate_expr(p, stmt["value"])
        var cases = stmt["cases"]
        var ci = 0
        while cases != nil && ci < oren_list_len(cases) {
            var c = cases[ci]
            var vals = c["values"]
            var vi = 0
            while vals != nil && vi < oren_list_len(vals) {
                _stmt_validate_yield_delegate_expr(p, vals[vi])
                vi = vi + 1
            }
            _stmt_validate_yield_delegate_stmt(p, c["body"])
            ci = ci + 1
        }
        if stmt["default"] != nil { _stmt_validate_yield_delegate_stmt(p, stmt["default"]) }
        return nil
    }
    return nil
}

fn validate_stmt_yield_delegate_syntax(p, stmt) {
    if p["_defer_yield_delegate_validate"] == true { return stmt }
    _stmt_validate_yield_delegate_stmt(p, stmt)
    return stmt
}

fn _generator_rewrite_yield_stmt(stmt, co_name) {
    if stmt == nil { return nil }
    if stmt["yield_stmt"] == true {
        var ctx_tok = token.new_token(token.TOK_IDENT, co_name)
        var call = yield_exchange_context_expr_call(
            stmt["token"],
            ast.new_identifier(ctx_tok),
            _generator_nil_expr(),
            false
        )
        call["yield_exchange_syntax_kind"] = "generator_decl"
        return ast.new_expr_stmt(stmt["token"], call)
    }
    var t = stmt["type"]
    if t == "Block" || t == "StmtList" {
        var xs = stmt["stmts"]
        var i = 0
        while xs != nil && i < oren_list_len(xs) {
            xs[i] = _generator_rewrite_yield_stmt(xs[i], co_name)
            i = i + 1
        }
        return stmt
    }
    if t == "Var" {
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        return stmt
    }
    if t == "Assign" {
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        return stmt
    }
    if t == "Set" {
        stmt["left"] = _generator_rewrite_yield_expr(stmt["left"], co_name)
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        return stmt
    }
    if t == "Return" {
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        return stmt
    }
    if t == "ExprStmt" {
        var expr = stmt["expr"]
        if expr != nil && (expr["type"] == "Function" || expr["type"] == "Lambda") { return stmt }
        stmt["expr"] = _generator_rewrite_yield_expr(expr, co_name)
        return stmt
    }
    if t == "While" {
        stmt["cond"] = _generator_rewrite_yield_expr(stmt["cond"], co_name)
        stmt["body"] = _generator_rewrite_yield_stmt(stmt["body"], co_name)
        return stmt
    }
    if t == "For" {
        stmt["init"] = _generator_rewrite_yield_stmt(stmt["init"], co_name)
        stmt["cond"] = _generator_rewrite_yield_expr(stmt["cond"], co_name)
        stmt["post"] = _generator_rewrite_yield_stmt(stmt["post"], co_name)
        stmt["body"] = _generator_rewrite_yield_stmt(stmt["body"], co_name)
        return stmt
    }
    if t == "If" {
        stmt["cond"] = _generator_rewrite_yield_expr(stmt["cond"], co_name)
        stmt["consq"] = _generator_rewrite_yield_stmt(stmt["consq"], co_name)
        if stmt["alt"] != nil { stmt["alt"] = _generator_rewrite_yield_stmt(stmt["alt"], co_name) }
        return stmt
    }
    if t == "Spawn" {
        stmt["call"] = _generator_rewrite_yield_expr(stmt["call"], co_name)
        return stmt
    }
    if t == "Switch" {
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        var cases = stmt["cases"]
        var ci = 0
        while cases != nil && ci < oren_list_len(cases) {
            var c = cases[ci]
            var vals = c["values"]
            var vi = 0
            while vals != nil && vi < oren_list_len(vals) {
                vals[vi] = _generator_rewrite_yield_expr(vals[vi], co_name)
                vi = vi + 1
            }
            c["body"] = _generator_rewrite_yield_stmt(c["body"], co_name)
            ci = ci + 1
        }
        if stmt["default"] != nil { stmt["default"] = _generator_rewrite_yield_stmt(stmt["default"], co_name) }
        return stmt
    }
    return stmt
}

fn maybe_lower_generator_decl_stmt(p, stmt) {
    if stmt == nil { return stmt }
    var func = nil
    var decl_name = nil
    var is_decl_stmt = false
    if stmt["type"] == "ExprStmt" {
        func = stmt["expr"]
        if func == nil || func["type"] != "Function" { return stmt }
        if _attrs_has_name(func["attrs"], "oren.generator") != true { return stmt }
        decl_name = func["name"]
        is_decl_stmt = true
        if decl_name == nil || decl_name == "" {
            parser_add_error(p, "@oren.generator may only precede named function declarations or function-valued var bindings")
            return stmt
        }
    } else {
        if stmt["type"] != "Var" { return stmt }
        func = _generator_var_decl_function(stmt)
        if func == nil { return stmt }
        var name_ident = _generator_var_decl_name_ident(stmt)
        if name_ident == nil || _attrs_has_name(name_ident["attrs"], "oren.generator") != true { return stmt }
        decl_name = name_ident["value"]
        if decl_name == nil || decl_name == "" {
            parser_add_error(p, "@oren.generator on var requires named identifier")
            return stmt
        }
    }
    var co_name = parser_gensym(p, "@generator_co_")
    var args_name = parser_gensym(p, "@generator_args_")
    var worker_tok = token.new_token(token.TOK_BITOR, "|")
    worker_tok["file"] = p["file"]
    var worker_params = [
        ast.new_identifier(token.new_token(token.TOK_IDENT, co_name)),
        ast.new_identifier(token.new_token(token.TOK_IDENT, args_name))
    ]
    func["body"] = _generator_rewrite_yield_stmt(func["body"], co_name)
    func["generator_source_body"] = func["body"]
    var worker = ast.new_function(worker_tok, "", worker_params, func["body"])
    worker["generator_decl_worker"] = true
    var call_tok = token.new_token(token.TOK_LPAREN, "(")
    var start_ident_tok = token.new_token(token.TOK_IDENT, "oren_generator_start")
    var start_call = ast.new_call(call_tok, ast.new_identifier(start_ident_tok), [worker, ast.new_array(token.new_token(token.TOK_LBRACKET, "["), [])])
    var body_tok = token.new_token(token.TOK_LBRACE, "{")
    var wrapper_body = ast.new_block(body_tok)
    oren_list_push(wrapper_body["stmts"], ast.new_return(token.new_token(token.TOK_RETURN, "return"), start_call))
    if is_decl_stmt == true && p["block_depth"] > 0 {
        var name_ident = _local_fn_decl_name_ident(func)
        func["body"] = wrapper_body
        func["generator_decl"] = true
        func["decl_name"] = decl_name
        func["name"] = ""
        return ast.new_var(func["token"], name_ident, func)
    }
    func["body"] = wrapper_body
    func["generator_decl"] = true
    func["decl_name"] = decl_name
    if is_decl_stmt != true { func["name"] = "" }
    return stmt
}

fn attach_attrs_to_stmt(p, stmt, attrs) {
    if attrs == nil { return nil }
    if oren_list_len(attrs) == 0 { return nil }

    if _attrs_has_name(attrs, "oren.generator") == true {
        if stmt["type"] == "ExprStmt" {
            var generator_exp = stmt["expr"]
            if generator_exp != nil && generator_exp["type"] == "Function" {
                generator_exp["attrs"] = _merge_attrs(generator_exp["attrs"], attrs)
                return nil
            }
        }
        if stmt["type"] == "Var" {
            var generator_var_exp = _generator_var_decl_function(stmt)
            if generator_var_exp != nil {
                var generator_attrs = _attrs_only_name(attrs, "oren.generator")
                generator_var_exp["attrs"] = _merge_attrs(generator_var_exp["attrs"], generator_attrs)
            } else {
                parser_add_error(p, "@oren.generator on var requires function value")
                attrs = _attrs_filter_out_name(attrs, "oren.generator")
                if attrs == nil || oren_list_len(attrs) == 0 { return nil }
            }
        } else {
            parser_add_error(p, "@oren.generator may only precede named function declarations or function-valued var bindings")
            attrs = _attrs_filter_out_name(attrs, "oren.generator")
            if attrs == nil || oren_list_len(attrs) == 0 { return nil }
        }
    }

    // Allowed targets (M1): declarations + local/global vars.
    if stmt["type"] == "Type" || stmt["type"] == "Import" || stmt["type"] == "FFI" {
        stmt["attrs"] = _merge_attrs(stmt["attrs"], attrs)
        return nil
    }
    if stmt["type"] == "Var" {
        // Prefer storing attrs on the identifier node (consistent with fields/params).
        if stmt["name"] != nil && stmt["name"]["type"] == "Identifier" {
            stmt["name"]["attrs"] = _merge_attrs(stmt["name"]["attrs"], attrs)
        } else {
            stmt["attrs"] = _merge_attrs(stmt["attrs"], attrs)
        }
        return nil
    }
    if stmt["type"] == "ExprStmt" {
        var exp = stmt["expr"]
        if exp != nil && exp["type"] == "Function" {
            exp["attrs"] = _merge_attrs(exp["attrs"], attrs)
            return nil
        }
    }

    // Allow statement-level @cfg (rolling).
    if _attrs_all_cfg(attrs) == true {
        stmt["attrs"] = _merge_attrs(stmt["attrs"], attrs)
        return nil
    }
    if (stmt["type"] == "While" || stmt["type"] == "For") && _attrs_all_arena_loop(attrs) == true {
        stmt["attrs"] = _merge_attrs(stmt["attrs"], attrs)
        return nil
    }

    parser_add_error(p, "attributes may only precede declarations (fn/struct/class/import/ffi/var)")
    return nil
}

fn _stmt_supports_pub(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Var" || t == "Type" || t == "FFI" { return true }
    if t == "ExprStmt" {
        var exp = stmt["expr"]
        if exp != nil && exp["type"] == "Function" { return true }
        return false
    }
    if t == "StmtList" {
        var xs = stmt["stmts"]
        if xs == nil || oren_list_len(xs) == 0 { return false }
        var saw_decl = false
        var i = 0
        while i < oren_list_len(xs) {
            if _stmt_supports_pub(xs[i]) != true {
                return false
            }
            saw_decl = true
            i = i + 1
        }
        return saw_decl
    }
    return false
}

fn _mark_stmt_public(stmt) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Var" || t == "Type" || t == "FFI" {
        stmt["is_pub"] = true
        return nil
    }
    if t == "ExprStmt" {
        var exp = stmt["expr"]
        if exp != nil && exp["type"] == "Function" {
            stmt["is_pub"] = true
            exp["is_pub"] = true
        }
        return nil
    }
    if t == "StmtList" {
        var xs = stmt["stmts"]
        if xs == nil { return nil }
        var i = 0
        while i < oren_list_len(xs) {
            _mark_stmt_public(xs[i])
            i = i + 1
        }
    }
    return nil
}

fn parse_pub_stmt(p) {
    parser_next_token(p)
    if cur_is(p, token.TOK_EOF) {
        parser_add_error(p, "'pub' expects a declaration")
        return nil
    }
    var stmt = parse_statement(p)
    if stmt == nil { return nil }
    if p["block_depth"] > 0 {
        parser_add_error(p, "'pub' is only allowed on top-level declarations")
        return stmt
    }
    if _stmt_supports_pub(stmt) != true {
        parser_add_error(p, "'pub' may only precede top-level declarations (fn/var/struct/class/enum/ffi)")
        return stmt
    }
    _mark_stmt_public(stmt)
    return stmt
}

fn parse_statement(p) {
    if cur_is(p, token.TOK_PUB) { return parse_pub_stmt(p) }
    if cur_is(p, token.TOK_LET) { return parse_var(p) }
    if cur_is(p, token.TOK_RETURN) { return parse_return(p) }
    if cur_is(p, token.TOK_WHILE) { return parse_while(p) }
    if cur_is(p, token.TOK_FOR) { return parse_for(p) }
    if cur_is(p, token.TOK_SWITCH) { return parse_switch(p) }
    if cur_is(p, token.TOK_BREAK) { return parse_break(p) }
    if cur_is(p, token.TOK_CONTINUE) { return parse_continue(p) }
    if cur_is(p, token.TOK_YIELD) { return parse_yield(p) }
    if cur_is(p, token.TOK_IMPORT) { return parse_import(p) }
    if cur_is(p, token.TOK_STRUCT) { return parse_type_decl(p) }
    if cur_is(p, token.TOK_CLASS) { return parse_type_decl(p) }
    if cur_is(p, token.TOK_ENUM) { return parse_enum_decl(p) }
    if cur_is(p, token.TOK_TRAIT) { return parse_trait_decl(p) }
    if cur_is(p, token.TOK_IMPL) { return parse_impl_decl(p) }
    if cur_is(p, token.TOK_FFI) { return parse_ffi(p) }
    if cur_is(p, token.TOK_TEST) { return parse_test(p) }
    if cur_is(p, token.TOK_ASSERT) { return parse_assert(p) }
    if cur_is(p, token.TOK_SPAWN) { return parse_spawn(p) }
    if cur_is(p, token.TOK_LBRACE) { return parse_block(p) }
    if cur_is(p, token.TOK_IDENT) {
        var lit = p["cur"]["literal"]
        if (lit == "debug" || lit == "release") && peek_is(p, token.TOK_LBRACE) {
            var attr_name = "oren.debug"
            if lit == "release" { attr_name = "oren.release" }
            var attr = {"type": "Attr", "token": p["cur"], "name": attr_name, "args": []}
            parser_next_token(p) // '{'
            var block = parse_block(p)
            if block != nil { attach_attrs_to_stmt(p, block, [attr]) }
            return block
        }
        // Contextual keyword: `match` is only treated as a statement when it is not
        // being used as an identifier (var name, call, member, indexing, etc.).
        if p["cur"]["literal"] == "match" {
            var pt = p["peek"]["type"]
            if pt != token.TOK_DECLARE && pt != token.TOK_ASSIGN && pt != token.TOK_COLON &&
               pt != token.TOK_DOT && pt != token.TOK_LPAREN && pt != token.TOK_LBRACKET &&
               pt != token.TOK_SEMICOLON && pt != token.TOK_RBRACE && pt != token.TOK_EOF {
                return parse_match(p)
            }
        }
        if p["cur"]["literal"] == "defer" && peek_is(p, token.TOK_LBRACE) {
            return parse_defer_stmt(p)
        }
        if peek_is(p, token.TOK_DECLARE) { return parse_short_var(p) }
        if peek_is(p, token.TOK_COLON) { return parse_typed_short_var(p) }
        return parse_assign_or_expr_stmt(p)
    }
    return parse_expr_stmt(p)
}

fn parse_dotted_name(p) {
    // Parse an identifier with optional dotted suffixes: A.B.C
    if !cur_is_ident_like(p) { return nil }
    var name = p["cur"]["literal"]
    while peek_is(p, token.TOK_DOT) {
        parser_next_token(p) // .
        if !expect_peek_ident_like(p, "dotted name segment") { return nil }
        name = name + "." + p["cur"]["literal"]
    }
    return name
}

fn skip_parens_signature(p) {
    // Best-effort skip of (...) in trait signatures.
    // Precondition: current token is '('.
    var depth = 0
    while true {
        if cur_is(p, token.TOK_LPAREN) { depth = depth + 1 }
        if cur_is(p, token.TOK_RPAREN) {
            depth = depth - 1
            if depth <= 0 { return nil }
        }
        if cur_is(p, token.TOK_EOF) { return nil }
        parser_next_token(p)
    }
}

fn parse_trait_decl(p) {
    // trait Foo { fn m(a, b); fn n(x): i32; }
    //
    // Rolling implementation:
    // - Trait declarations are compile-time contracts only (no runtime representation yet).
    // - We keep a metadata-only record under p["traits"] for tooling (docs/serde/OpenAPI/etc).
    // - No statements are emitted, so existing backends remain unchanged.
    var doc = parser_take_pending_doc(p)
    if !expect_peek_ident_like(p, "trait name") { return ast.new_stmt_list([]) }
    var trait_name = parse_dotted_name(p)
    if trait_name == nil { return ast.new_stmt_list([]) }
    ident_prefix_validate(p, trait_name, "trait")
    if !expect_peek(p, token.TOK_LBRACE) { return ast.new_stmt_list([]) }

    var methods = []
    // Enter body.
    parser_next_token(p)
    while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
        if cur_is(p, token.TOK_SEMICOLON) { parser_next_token(p); continue }
        if cur_is(p, token.TOK_COMMA) { parser_next_token(p); continue }

        if cur_is(p, token.TOK_FUNCTION) {
            // Parse `fn name(...)` signature and record it.
            if !expect_peek_ident_like(p, "trait method name") { return ast.new_stmt_list([]) }
            var mname = p["cur"]["literal"]
            ident_prefix_validate(p, mname, "trait method")
            if !expect_peek(p, token.TOK_LPAREN) { return ast.new_stmt_list([]) }
            var params = parse_parameters(p) // leaves cur at ')'

            // Optional return type: `: T`
            var ret_ann = nil
            if peek_is(p, token.TOK_COLON) {
                parser_next_token(p) // ':'
                ret_ann = parse_type_name_after_colon(p)
                if ret_ann == nil { return ast.new_stmt_list([]) }
            }

            // Convert params (Identifier AST nodes) into stable metadata.
            var mparams = []
            var pi = 0
            while pi < oren_list_len(params) {
                var id = params[pi]
                var pname = nil
                var ann = nil
                var isv = false
                var pattrs = []
                if id != nil {
                    pname = id["value"]
                    ann = id["ann_type"]
                    if id["is_varargs"] == true { isv = true }
                    if id["attrs"] != nil { pattrs = id["attrs"] }
                }
                oren_list_push(mparams, {"value": pname, "attrs": pattrs, "ann_type": ann, "is_varargs": isv})
                pi = pi + 1
            }

            oren_list_push(methods, {"name": mname, "params": mparams, "ret_ann_type": ret_ann})

            // Consume optional separator and continue.
            if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
            if peek_is(p, token.TOK_COMMA) { parser_next_token(p) }
            parser_next_token(p)
            continue
        }

        // Unknown token inside trait body: skip (rolling mode).
        parser_next_token(p)
    }

    // p["cur"] is '}' (or EOF). Record trait metadata for tooling.
    p["trait_set"][trait_name] = true
    oren_list_push(p["traits"], {"name": trait_name, "doc": doc, "methods": methods})
    return ast.new_stmt_list([])
}

fn impl_mangled_name(trait_name, type_name, method) {
    // Deterministic lowering name for impl methods (rolling).
    //
    // Rationale:
    // - avoids introducing a runtime method table before the type system is stable
    // - keeps compilation bootstrap-friendly (plain fns)
    // - stable across backends (C/native/bytecode)
    //
    // Convention:
    //   __oren_impl__<Trait>__<Type>__<method>
    //
    // Dots are replaced by underscores for C identifier stability downstream.
    var out_t = _impl_mangle_type_part(trait_name)
    var out_ty = _impl_mangle_type_part(type_name)
    return "__oren_impl__" + out_t + "__" + out_ty + "__" + method
}

fn _impl_mangle_type_part(s) {
    // Mangle a type-ish name into a valid identifier segment.
    //
    // Inputs include:
    // - dotted names: `mod.Type`
    // - pointer prefix: `*T`, `**T`
    // - typed-buffer / slice prefix: `[]T`, `[][]T`
    // - fixed arrays: `T[16]`, `*T[16]`
    //
    // Output must contain only `[A-Za-z0-9_]` so it can be used in a synthesized
    // function name.
    if s == nil { return "" }

    var out = ""
    var i = 0
    while i < oren_string_len(s) {
        var c = oren_string_char_at(s, i)

        if c == "." {
            out = out + "_"
            i = i + 1
            continue
        }
        if c == "*" {
            out = out + "ptr_"
            i = i + 1
            continue
        }
        if c == "[" {
            // Typed-buffer prefix `[]`.
            if i+1 < oren_string_len(s) && oren_string_char_at(s, i+1) == "]" {
                out = out + "slice_"
                i = i + 2
                continue
            }

            // Fixed array suffix `[N]` (parser only emits numeric dims here).
            var j = i + 1
            var dims = ""
            while j < oren_string_len(s) && oren_string_char_at(s, j) != "]" {
                dims = dims + oren_string_char_at(s, j)
                j = j + 1
            }
            if j < oren_string_len(s) && oren_string_char_at(s, j) == "]" && dims != "" {
                out = out + "arr" + dims + "_"
                i = j + 1
                continue
            }

            // Fallback: keep deterministic but safe.
            out = out + "_"
            i = i + 1
            continue
        }

        // In practice, the parser only emits identifier-safe characters in type names
        // beyond the punctuators handled above; keep a conservative fallback anyway.
        if c == "_" { out = out + c }
        else { out = out + c }
        i = i + 1
    }

    return out
}

fn parse_impl_decl(p) {
    // impl Trait for Type { fn method(self, ...) { ... } ... }
    //
    // Rolling implementation:
    // - Parser accepts impl blocks.
    // - Each method is lowered to a plain top-level function with a deterministic name:
    //     __oren_impl__Trait__Type__method(...)
    //
    // This unblocks early stdlib layering and tooling without committing to a stable
    // method dispatch ABI yet.
    var doc = parser_take_pending_doc(p)
    if !expect_peek_ident_like(p, "impl trait name") { return ast.new_stmt_list([]) }
    // cur is IDENT after expect_peek
    var trait_name = parse_dotted_name(p)
    if trait_name == nil { return ast.new_stmt_list([]) }

    if !expect_peek(p, token.TOK_FOR) { return ast.new_stmt_list([]) }
    var type_name = parse_type_name_after_for(p)
    if type_name == nil { return ast.new_stmt_list([]) }

    if !expect_peek(p, token.TOK_LBRACE) { return ast.new_stmt_list([]) }

    var out = []
    var impl_block_id = parser_gensym(p, "@impl_" + trait_name + "_" + type_name + "_")
    parser_next_token(p)
    while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
        if cur_is(p, token.TOK_DOC) {
            var md = parse_doc_list(p)
            if md != nil { p["_pending_doc"] = md }
            continue
        }
        if cur_is(p, token.TOK_SEMICOLON) { parser_next_token(p); continue }
        if cur_is(p, token.TOK_COMMA) { parser_next_token(p); continue }
        if cur_is(p, token.TOK_FUNCTION) {
            var st = parse_expr_stmt(p)
            if st == nil { return ast.new_stmt_list(out) }
            // st is ExprStmt(Function)
            var fnn = st["expr"]
            if fnn != nil && fnn["type"] == "Function" {
                if doc != nil && fnn["doc"] == nil { fnn["doc"] = doc }
                var mname = fnn["name"]
                var newn = impl_mangled_name(trait_name, type_name, mname)
                // Preserve impl identity for later whole-program passes:
                // - enables cross-module method call lowering after module linking
                // - enables coherence checks without parsing mangled identifiers
                fnn["impl_trait"] = trait_name
                fnn["impl_type"] = type_name
                fnn["impl_method"] = mname
                fnn["impl_mangled_base"] = newn
                fnn["impl_block_id"] = impl_block_id
                fnn["name"] = newn
                impl_method_register(p, type_name, mname, newn)
                impl_trait_method_register(p, trait_name, type_name, mname, newn)
            }
            oren_list_push(out, st)
            parser_next_token(p)
            continue
        }
        parser_add_error(p, "impl body expects 'fn' declarations")
        return ast.new_stmt_list(out)
    }
    // p["cur"] is '}'.
    return ast.new_stmt_list(out)
}
