import token "token.oren"
import ast "ast.oren"
import core "parser_core.oren"

// Re-export precedence constants into this module's scope so the rest of the
// parser code can remain unchanged after refactoring `parser.oren` into modules.
var LOWEST = core.LOWEST
var OR_P = core.OR_P
var AND_P = core.AND_P
var BITOR_P = core.BITOR_P
var BITXOR_P = core.BITXOR_P
var BITAND_P = core.BITAND_P
var EQUALS_P = core.EQUALS_P
var LESSGREATER_P = core.LESSGREATER_P
var SHIFT_P = core.SHIFT_P
var SUM_P = core.SUM_P
var PRODUCT_P = core.PRODUCT_P
var CAST_P = core.CAST_P
var PREFIX_P = core.PREFIX_P
var CALL_P = core.CALL_P
var INDEX_P = core.INDEX_P

fn precedence(tokType) { return core.precedence(tokType) }

// Core helper shims (keep existing parser logic unchanged).
fn type_env_push(p) { return core.type_env_push(p) }
fn type_env_pop(p) { return core.type_env_pop(p) }
fn type_env_set(p, name, tname) { return core.type_env_set(p, name, tname) }
fn type_env_get(p, name) { return core.type_env_get(p, name) }

fn expr_dotted_name(e) { return core.expr_dotted_name(e) }
fn impl_method_register(p, type_name, method, mangled) { return core.impl_method_register(p, type_name, method, mangled) }
fn impl_method_lookup(p, type_name, method) { return core.impl_method_lookup(p, type_name, method) }
fn impl_trait_method_register(p, trait_name, type_name, method, mangled) { return core.impl_trait_method_register(p, trait_name, type_name, method, mangled) }
fn impl_trait_method_lookup(p, trait_name, type_name, method) { return core.impl_trait_method_lookup(p, trait_name, type_name, method) }

fn str_starts_with(s, prefix) { return core.str_starts_with(s, prefix) }
fn attr_is_reserved(name) { return core.attr_is_reserved(name) }
fn attr_is_known(p, name) { return core.attr_is_known(p, name) }
fn attr_is_allowlisted(p, name) { return core.attr_is_allowlisted(p, name) }
fn ident_prefix_validate(p, name, context) { return core.ident_prefix_validate(p, name, context) }
fn attr_normalize_name(name) { return core.attr_normalize_name(name) }
fn attr_validate(p, name) { return core.attr_validate(p, name) }

fn parser_gensym(p, prefix) { return core.parser_gensym(p, prefix) }
fn parser_add_error(p, msg) { return core.parser_add_error(p, msg) }
fn docs_join(lines) { return core.docs_join(lines) }
fn parse_doc_list(p) { return core.parse_doc_list(p) }
fn parser_take_pending_doc(p) { return core.parser_take_pending_doc(p) }

fn _parse_int_env(v, default_val) {
    if v == nil || v == "" { return default_val }
    var n = oren_string_len(v)
    if n == 0 { return default_val }
    var i = 0
    var j = n
    // Trim ASCII whitespace (common on Windows envs via cmd.exe).
    while i < j {
        var c0 = oren_string_char_at(v, i)
        if c0 == " " || c0 == "\t" || c0 == "\r" || c0 == "\n" { i = i + 1; continue }
        break
    }
    while j > i {
        var c1 = oren_string_char_at(v, j - 1)
        if c1 == " " || c1 == "\t" || c1 == "\r" || c1 == "\n" { j = j - 1; continue }
        break
    }
    if i >= j { return default_val }
    var n2 = j
    var neg = false
    if oren_string_char_at(v, i) == "-" {
        neg = true
        i = i + 1
    }
    var acc = 0
    while i < n2 {
        var c = oren_string_byte_at_unchecked(v, i)
        if c < 48 || c > 57 { return default_val }
        acc = acc * 10 + (c - 48)
        i = i + 1
    }
    if neg { acc = 0 - acc }
    return acc
}

fn parser_next_token(p) { return core.parser_next_token(p) }
fn cur_is(p, t) { return core.cur_is(p, t) }
fn peek_is(p, t) { return core.peek_is(p, t) }
fn cur_is_ident_like(p) { return core.cur_is_ident_like(p) }
fn peek_is_ident_like(p) { return core.peek_is_ident_like(p) }
fn expect_peek(p, t) { return core.expect_peek(p, t) }
fn expect_peek_ident_like(p, what) { return core.expect_peek_ident_like(p, what) }
fn parse_type_name_after_colon(p) { return core.parse_type_name_after_colon(p) }
fn parse_type_name_after_for(p) { return core.parse_type_name_after_for(p) }

fn parse_program(p) {
    var gcroot = {"parser": p, "lexer": p["l"], "input": p["l"]["input"]}
    var __prev_gc_pin = oren_gc_pin(gcroot)
    // Expose GC root for nested parse helpers (e.g. parse_block) to pin locals.
    p["_gc_root"] = gcroot
    gcroot["block_frames"] = []
    var prog = ast.new_program()
    // GC safety (rolling):
    // Stage2 self-hosting uses auto-GC and may run with bounded conservative stack scanning.
    // Ensure the in-progress program (and per-iteration scratch lists) remain reachable from
    // the pinned parser state so they cannot be collected mid-parse.
    p["_gc_prog"] = prog
    gcroot["prog"] = prog
    var trace_prog = false
    var v_trace_prog = oren_env("OREN_TRACE_PARSE_PROGRESS")
    if v_trace_prog != nil && v_trace_prog != "" { trace_prog = true }
    var trace_prog_verbose = false
    var v_trace_prog_verbose = oren_env("OREN_TRACE_PARSE_PROGRESS_VERBOSE")
    if v_trace_prog_verbose != nil && v_trace_prog_verbose != "" { trace_prog_verbose = true }
    var trace_file = p["file"]
    if trace_file == nil { trace_file = "" }
    var trace_file_filter = oren_env("OREN_TRACE_PARSE_FILE")
    if trace_file_filter != nil && trace_file_filter != "" {
        if trace_file != trace_file_filter {
            trace_prog = false
            trace_prog_verbose = false
        }
    }
    var trace_prog_verbose_from = 230
    var v_trace_prog_verbose_from = oren_env("OREN_TRACE_PARSE_PROGRESS_VERBOSE_FROM")
    if v_trace_prog_verbose_from != nil && v_trace_prog_verbose_from != "" {
        trace_prog_verbose_from = _parse_int_env(v_trace_prog_verbose_from, trace_prog_verbose_from)
    }
    var stmt_i = 0
    var trace_prog_every = 5
    var v_trace_prog_every = oren_env("OREN_TRACE_PARSE_PROGRESS_EVERY")
    if trace_prog && v_trace_prog_every != nil && v_trace_prog_every != "" {
        print("[parse] trace_every_env=" + v_trace_prog_every)
        trace_prog_every = _parse_int_env(v_trace_prog_every, trace_prog_every)
        if trace_prog_every < 1 { trace_prog_every = 1 }
    }
    var trace_prog_countdown = 0
    while p["cur"]["type"] != token.TOK_EOF {
        if trace_prog {
            if trace_prog_countdown <= 0 {
                print("[parse] file=" + trace_file + " stmt_i=" + oren_int_to_string(stmt_i) + " cur=" + p["cur"]["type"])
                trace_prog_countdown = trace_prog_every
            }
            trace_prog_countdown = trace_prog_countdown - 1
        }
        if trace_prog_verbose && stmt_i >= trace_prog_verbose_from {
            var cur_lit = p["cur"]["literal"]
            var peek_lit = p["peek"]["literal"]
            if cur_lit == nil { cur_lit = "" }
            if peek_lit == nil { peek_lit = "" }
            var cur_line = p["cur"]["line"]
            var cur_col = p["cur"]["col"]
            if cur_line == nil { cur_line = 0 }
            if cur_col == nil { cur_col = 0 }
            print("[parse_verbose] file=" + trace_file + " stmt_i=" + oren_int_to_string(stmt_i) + " cur=" + p["cur"]["type"] + " line=" + oren_int_to_string(cur_line) + " col=" + oren_int_to_string(cur_col) + " lit=" + cur_lit + " peek=" + peek_lit)
        }
        // Allow doc comments and attributes to appear in either order before a declaration:
        //   /// doc
        //   @attr(...)
        //   fn ...
        //
        // or:
        //   @attr(...)
        //   /// doc
        //   struct ...
        //
        // We collect both deterministically and attach to the next declaration only.
        var doc_lines = []
        var attrs = []
        p["_gc_doc_lines"] = doc_lines
        p["_gc_attrs"] = attrs
        gcroot["doc_lines"] = doc_lines
        gcroot["attrs"] = attrs
        while cur_is(p, token.TOK_DOC) || cur_is(p, token.TOK_AT) {
            if cur_is(p, token.TOK_DOC) {
                oren_list_push(doc_lines, p["cur"]["literal"])
                parser_next_token(p)
            } else {
                var a = parse_attr(p)
                if a != nil { oren_list_push(attrs, a) }
                parser_next_token(p)
            }
        }
        var doc = docs_join(doc_lines)
        p["_pending_doc"] = doc
        p["_trace_stmt_i"] = stmt_i
        var stmt = parse_statement(p)
        p["_gc_stmt"] = stmt
        gcroot["stmt"] = stmt
        if stmt != nil {
            if stmt["type"] == "StmtList" {
                var origin = stmt["origin"]
                    if origin == "ffi_group" {
                        // Allow attrs/doc to apply to the expanded FFI declarations.
                        var pending = parser_take_pending_doc(p)
                        // Special-case: `@ffi.ret("...") ffi { ... }` is intended as a default return kind.
                        // If an item already has `@ffi.ret("...")`, do not also attach the group-level ret,
                        // otherwise the native backend will reject it as a duplicate.
                        var group_ret_n = _attrs_count_name(attrs, "ffi.ret")
                        if group_ret_n > 1 {
                            parser_add_error(p, "ffi group: at most one @ffi.ret(...) may precede `ffi { ... }`")
                        }
                        var si = 0
                        while si < oren_list_len(stmt["stmts"]) {
                            var s = stmt["stmts"][si]
                            var use_attrs = attrs
                            if group_ret_n == 1 && s != nil && s["type"] == "FFI" {
                                if _attrs_has_name(s["attrs"], "ffi.ret") {
                                    use_attrs = _attrs_filter_out_name(attrs, "ffi.ret")
                                }
                            }
                            attach_attrs_to_stmt(p, s, use_attrs)
	                            if pending != nil {
	                                // Mirror single-statement behavior: attach doc to declaration-like nodes.
	                                if s["type"] == "Type" || s["type"] == "Import" || s["type"] == "FFI" || s["type"] == "Var" {
	                                    s["doc"] = pending
	                            }
	                        }
                            s = maybe_lower_generator_decl_stmt(p, s)
	                        oren_list_push(prog["statements"], s)
	                        si = si + 1
	                    }
                } else {
                    if attrs != nil && oren_list_len(attrs) != 0 {
                        parser_add_error(p, "attributes may not precede enum sugar expansion")
                    }
                    if p["_pending_doc"] != nil {
                        parser_add_error(p, "doc comments may not precede enum/impl sugar expansion yet")
                        p["_pending_doc"] = nil
                    }
                    var si2 = 0
                    while si2 < oren_list_len(stmt["stmts"]) {
                        oren_list_push(prog["statements"], stmt["stmts"][si2])
                        si2 = si2 + 1
                    }
                }
            } else {
                attach_attrs_to_stmt(p, stmt, attrs)
                // Attach doc to declaration statements (fn/struct/class/import/ffi).
                var pending = parser_take_pending_doc(p)
                if pending != nil {
                    if stmt["type"] == "Type" || stmt["type"] == "Import" || stmt["type"] == "FFI" || stmt["type"] == "Var" {
                        stmt["doc"] = pending
                    } else {
                        if stmt["type"] == "ExprStmt" {
                            var exp = stmt["expr"]
                            if exp != nil && exp["type"] == "Function" {
                                // Function consumes pending doc in parse_function.
                            } else {
                                parser_add_error(p, "doc comments may only precede declarations (fn/struct/class/import/ffi/var)")
                            }
                        } else {
                            parser_add_error(p, "doc comments may only precede declarations (fn/struct/class/import/ffi/var)")
                        }
	                    }
	                }
                    stmt = maybe_lower_generator_decl_stmt(p, stmt)
	                oren_list_push(prog["statements"], stmt)
	            }
	        }
        // If no statement consumed the doc, clear it to avoid leakage.
        p["_pending_doc"] = nil
        p["_gc_stmt"] = nil
        p["_gc_attrs"] = nil
        p["_gc_doc_lines"] = nil
        gcroot["stmt"] = nil
        gcroot["attrs"] = nil
        gcroot["doc_lines"] = nil
        stmt_i = stmt_i + 1
        parser_next_token(p)
    }
    if p["_needs_generator_import"] == true {
        prog["statements"] = _prepend_stmt(prog["statements"], _generator_import_stmt(p))
    }
    // Carry trait declarations for tooling/metadata (no runtime meaning in v0).
    prog["traits"] = p["traits"]
    p["_gc_stmt"] = nil
    p["_gc_attrs"] = nil
    p["_gc_doc_lines"] = nil
    p["_gc_prog"] = nil
    gcroot["prog"] = nil
    gcroot["block_frames"] = nil
    p["_gc_root"] = nil
    oren_gc_pin(__prev_gc_pin)
    return prog
}

fn parse_attr_list(p) {
    var attrs = []
    while cur_is(p, token.TOK_AT) {
        var a = parse_attr(p)
        if a != nil { oren_list_push(attrs, a) }
        // Move to the next token after this attribute.
        parser_next_token(p)
    }
    return attrs
}

fn parse_attr(p) {
    // Current token is '@'
    var at_tok = p["cur"]
    if !core.expect_peek_attr_name(p, "attribute name") { return nil }
    var name = p["cur"]["literal"]
    // Support dotted namespaces: @myorg.tag(...)
    while peek_is(p, token.TOK_DOT) {
        parser_next_token(p) // '.'
        if !core.expect_peek_attr_name(p, "attribute name segment") { return nil }
        name = name + "." + p["cur"]["literal"]
    }

    // Normalize ergonomic aliases to canonical namespaces before strict validation
    // and before embedding into metadata.
    name = attr_normalize_name(name)

    attr_validate(p, name)

    var args = []
    // Optional ( ... )
    if peek_is(p, token.TOK_LPAREN) {
        parser_next_token(p) // '('
        parser_next_token(p) // first token inside args (or ')')

        if cur_is(p, token.TOK_RPAREN) {
            // no args
        } else {
            var cont = true
            while cont {
                var key = nil
                var val = nil

                // Keyword args in attrs: allow a small "attr-name token" set as keys.
                // This keeps ergonomic forms like `@json(default=0)` working even though
                // `default` is a keyword token in the lexer.
                if token.is_attr_name_token(p["cur"]["type"]) && peek_is(p, token.TOK_ASSIGN) {
                    key = p["cur"]["literal"]
                    parser_next_token(p) // '='
                    parser_next_token(p) // value
                }

                val = parse_attr_literal(p)
                if val == nil {
                    parser_add_error(p, "attribute args must be compile-time literals")
                    return nil
                }
                oren_list_push(args, {"key": key, "value": val})

                if peek_is(p, token.TOK_COMMA) {
                    parser_next_token(p) // ','
                    parser_next_token(p) // next
                } else {
                    cont = false
                }
            }

            if !peek_is(p, token.TOK_RPAREN) {
                parser_add_error(p, "expected ')' after attribute args")
                return nil
            }
            parser_next_token(p) // ')'
        }
    }

    return {"type": "Attr", "token": at_tok, "name": name, "args": args}
}

fn parse_attr_literal(p) {
    // Only allow literals in v0 attribute args to keep builds deterministic.
    var t = p["cur"]["type"]
    if t == token.TOK_STRING { return ast.new_string(p["cur"]) }
    if t == token.TOK_INT { return ast.new_integer(p["cur"]) }
    if t == token.TOK_FLOAT { return ast.new_float(p["cur"]) }
    if t == token.TOK_TRUE { return ast.new_boolean(p["cur"], true) }
    if t == token.TOK_FALSE { return ast.new_boolean(p["cur"], false) }
    if t == token.TOK_NIL { return ast.new_nil(p["cur"]) }
    return nil
}

fn _merge_attrs(existing, incoming) {
    // Merge two attribute lists without requiring callers to clone.
    // Ordering: keep any existing attrs first, then append incoming.
    if incoming == nil || oren_list_len(incoming) == 0 { return existing }
    if existing == nil || oren_list_len(existing) == 0 { return incoming }
    var i = 0
    while i < oren_list_len(incoming) {
        oren_list_push(existing, incoming[i])
        i = i + 1
    }
    return existing
}

fn _attrs_all_cfg(attrs) {
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil {
            if a["type"] != "Attr" { return false }
            var nm = a["name"]
            if nm != "oren.cfg" && nm != "oren.debug" && nm != "oren.release" { return false }
        }
        i = i + 1
    }
    return true
}

fn _attrs_all_arena_loop(attrs) {
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil {
            if a["type"] != "Attr" { return false }
            var nm = a["name"]
            if nm != "oren.arena" && nm != "oren.arena_iter" && nm != "oren.noarena" { return false }
        }
        i = i + 1
    }
    return true
}

fn _attrs_count_name(attrs, nm) {
    if attrs == nil || nm == nil { return 0 }
    var n = 0
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["type"] == "Attr" && a["name"] == nm {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn _attrs_has_name(attrs, nm) {
    return _attrs_count_name(attrs, nm) > 0
}

fn _attrs_filter_out_name(attrs, nm) {
    if attrs == nil { return attrs }
    var out = []
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["type"] == "Attr" && a["name"] == nm {
            // skip
        } else {
            oren_list_push(out, a)
        }
        i = i + 1
    }
    return out
}

fn _generator_import_alias(p) {
    var alias = p["_generator_import_alias"]
    if alias != nil && alias != "" { return alias }
    alias = parser_gensym(p, "@generator_mod_")
    p["_generator_import_alias"] = alias
    p["_needs_generator_import"] = true
    return alias
}

fn _generator_import_stmt(p) {
    var alias = p["_generator_import_alias"]
    if alias == nil || alias == "" { return nil }
    var tok = token.new_token(token.TOK_IMPORT, "import")
    tok["file"] = p["file"]
    var alias_tok = token.new_token(token.TOK_IDENT, alias)
    alias_tok["file"] = p["file"]
    return ast.new_import(tok, ast.new_identifier(alias_tok), "std:generator")
}

fn _prepend_stmt(stmts, stmt) {
    if stmt == nil { return stmts }
    if stmts == nil { return [stmt] }
    var out = [stmt]
    var i = 0
    while i < oren_list_len(stmts) {
        oren_list_push(out, stmts[i])
        i = i + 1
    }
    return out
}

fn _generator_ctx_slot_expr(co_name, slot_name) {
    var idx_tok = token.new_token(token.TOK_LBRACKET, "[")
    var base_tok = token.new_token(token.TOK_IDENT, co_name)
    var slot_tok = token.new_token(token.TOK_STRING, slot_name)
    return ast.new_index(idx_tok, ast.new_identifier(base_tok), ast.new_string(slot_tok))
}

fn _generator_nil_expr() {
    return ast.new_nil(token.new_token(token.TOK_NIL, "nil"))
}

fn _generator_rewrite_yield_expr(expr, co_name) {
    if expr == nil { return nil }
    var t = expr["type"]

    if t == "Function" || t == "Lambda" { return expr }

    if t == "Prefix" {
        expr["right"] = _generator_rewrite_yield_expr(expr["right"], co_name)
        return expr
    }
    if t == "Infix" {
        expr["left"] = _generator_rewrite_yield_expr(expr["left"], co_name)
        expr["right"] = _generator_rewrite_yield_expr(expr["right"], co_name)
        return expr
    }
    if t == "If" {
        expr["cond"] = _generator_rewrite_yield_expr(expr["cond"], co_name)
        expr["consq"] = _generator_rewrite_yield_stmt(expr["consq"], co_name)
        if expr["alt"] != nil { expr["alt"] = _generator_rewrite_yield_stmt(expr["alt"], co_name) }
        return expr
    }
    if t == "Call" {
        if expr["yield_value_expr"] == true {
            var tok = expr["yield_token"]
            if tok == nil { tok = expr["token"] }
            var value_expr = _generator_nil_expr()
            var args0 = expr["args"]
            if args0 != nil && oren_list_len(args0) > 0 {
                value_expr = _generator_rewrite_yield_expr(args0[0], co_name)
            }
            var out = yield_exchange_expr_call(
                tok,
                _generator_ctx_slot_expr(co_name, "yield_ch"),
                _generator_ctx_slot_expr(co_name, "resume_ch"),
                value_expr,
                expr["yield_value_explicit"] == true
            )
            out["yield_exchange_syntax_kind"] = "generator_decl"
            return out
        }
        expr["fn"] = _generator_rewrite_yield_expr(expr["fn"], co_name)
        var args = expr["args"]
        var i = 0
        while args != nil && i < oren_list_len(args) {
            args[i] = _generator_rewrite_yield_expr(args[i], co_name)
            i = i + 1
        }
        if expr["spread"] != nil { expr["spread"] = _generator_rewrite_yield_expr(expr["spread"], co_name) }
        return expr
    }
    if t == "Member" {
        expr["left"] = _generator_rewrite_yield_expr(expr["left"], co_name)
        expr["prop"] = _generator_rewrite_yield_expr(expr["prop"], co_name)
        return expr
    }
    if t == "Index" {
        expr["left"] = _generator_rewrite_yield_expr(expr["left"], co_name)
        expr["index"] = _generator_rewrite_yield_expr(expr["index"], co_name)
        return expr
    }
    if t == "Array" {
        var elems = expr["elements"]
        var ei = 0
        while elems != nil && ei < oren_list_len(elems) {
            elems[ei] = _generator_rewrite_yield_expr(elems[ei], co_name)
            ei = ei + 1
        }
        return expr
    }
    if t == "Hash" {
        var pairs = expr["pairs"]
        var pi = 0
        while pairs != nil && pi < oren_list_len(pairs) {
            var pair = pairs[pi]
            if pair["key"] != nil { pair["key"] = _generator_rewrite_yield_expr(pair["key"], co_name) }
            if pair["value"] != nil { pair["value"] = _generator_rewrite_yield_expr(pair["value"], co_name) }
            if pair["k"] != nil { pair["k"] = _generator_rewrite_yield_expr(pair["k"], co_name) }
            if pair["v"] != nil { pair["v"] = _generator_rewrite_yield_expr(pair["v"], co_name) }
            pi = pi + 1
        }
        return expr
    }
    if t == "SpawnExpr" {
        expr["call"] = _generator_rewrite_yield_expr(expr["call"], co_name)
        return expr
    }

    return expr
}

fn _generator_rewrite_yield_stmt(stmt, co_name) {
    if stmt == nil { return nil }
    if stmt["yield_stmt"] == true {
        var call = yield_exchange_expr_call(
            stmt["token"],
            _generator_ctx_slot_expr(co_name, "yield_ch"),
            _generator_ctx_slot_expr(co_name, "resume_ch"),
            _generator_nil_expr(),
            false
        )
        call["yield_exchange_syntax_kind"] = "generator_decl"
        return ast.new_expr_stmt(stmt["token"], call)
    }
    var t = stmt["type"]
    if t == "Block" || t == "StmtList" {
        var xs = stmt["stmts"]
        var i = 0
        while xs != nil && i < oren_list_len(xs) {
            xs[i] = _generator_rewrite_yield_stmt(xs[i], co_name)
            i = i + 1
        }
        return stmt
    }
    if t == "Var" {
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        return stmt
    }
    if t == "Assign" {
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        return stmt
    }
    if t == "Set" {
        stmt["left"] = _generator_rewrite_yield_expr(stmt["left"], co_name)
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        return stmt
    }
    if t == "Return" {
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        return stmt
    }
    if t == "ExprStmt" {
        var expr = stmt["expr"]
        if expr != nil && (expr["type"] == "Function" || expr["type"] == "Lambda") { return stmt }
        stmt["expr"] = _generator_rewrite_yield_expr(expr, co_name)
        return stmt
    }
    if t == "While" {
        stmt["cond"] = _generator_rewrite_yield_expr(stmt["cond"], co_name)
        stmt["body"] = _generator_rewrite_yield_stmt(stmt["body"], co_name)
        return stmt
    }
    if t == "For" {
        stmt["init"] = _generator_rewrite_yield_stmt(stmt["init"], co_name)
        stmt["cond"] = _generator_rewrite_yield_expr(stmt["cond"], co_name)
        stmt["post"] = _generator_rewrite_yield_stmt(stmt["post"], co_name)
        stmt["body"] = _generator_rewrite_yield_stmt(stmt["body"], co_name)
        return stmt
    }
    if t == "If" {
        stmt["cond"] = _generator_rewrite_yield_expr(stmt["cond"], co_name)
        stmt["consq"] = _generator_rewrite_yield_stmt(stmt["consq"], co_name)
        if stmt["alt"] != nil { stmt["alt"] = _generator_rewrite_yield_stmt(stmt["alt"], co_name) }
        return stmt
    }
    if t == "Spawn" {
        stmt["call"] = _generator_rewrite_yield_expr(stmt["call"], co_name)
        return stmt
    }
    if t == "Switch" {
        stmt["value"] = _generator_rewrite_yield_expr(stmt["value"], co_name)
        var cases = stmt["cases"]
        var ci = 0
        while cases != nil && ci < oren_list_len(cases) {
            var c = cases[ci]
            var vals = c["values"]
            var vi = 0
            while vals != nil && vi < oren_list_len(vals) {
                vals[vi] = _generator_rewrite_yield_expr(vals[vi], co_name)
                vi = vi + 1
            }
            c["body"] = _generator_rewrite_yield_stmt(c["body"], co_name)
            ci = ci + 1
        }
        if stmt["default"] != nil { stmt["default"] = _generator_rewrite_yield_stmt(stmt["default"], co_name) }
        return stmt
    }
    return stmt
}

fn maybe_lower_generator_decl_stmt(p, stmt) {
    if stmt == nil || stmt["type"] != "ExprStmt" { return stmt }
    var func = stmt["expr"]
    if func == nil || func["type"] != "Function" { return stmt }
    if _attrs_has_name(func["attrs"], "oren.generator") != true { return stmt }
    if func["name"] == nil || func["name"] == "" {
        parser_add_error(p, "@oren.generator may only precede named function declarations")
        return stmt
    }
    var import_alias = _generator_import_alias(p)
    var co_name = parser_gensym(p, "@generator_co_")
    var args_name = parser_gensym(p, "@generator_args_")
    var worker_tok = token.new_token(token.TOK_BITOR, "|")
    worker_tok["file"] = p["file"]
    var worker_params = [
        ast.new_identifier(token.new_token(token.TOK_IDENT, co_name)),
        ast.new_identifier(token.new_token(token.TOK_IDENT, args_name))
    ]
    func["body"] = _generator_rewrite_yield_stmt(func["body"], co_name)
    func["generator_source_body"] = func["body"]
    var worker = ast.new_function(worker_tok, "", worker_params, func["body"])
    worker["generator_decl_worker"] = true
    var call_tok = token.new_token(token.TOK_LPAREN, "(")
    var member_tok = token.new_token(token.TOK_DOT, ".")
    var import_ident_tok = token.new_token(token.TOK_IDENT, import_alias)
    var start_ident_tok = token.new_token(token.TOK_IDENT, "start")
    var start_member = ast.new_member(member_tok, ast.new_identifier(import_ident_tok), ast.new_identifier(start_ident_tok))
    var start_call = ast.new_call(call_tok, start_member, [worker, ast.new_array(token.new_token(token.TOK_LBRACKET, "["), [])])
    var body_tok = token.new_token(token.TOK_LBRACE, "{")
    var wrapper_body = ast.new_block(body_tok)
    oren_list_push(wrapper_body["stmts"], ast.new_return(token.new_token(token.TOK_RETURN, "return"), start_call))
    if p["block_depth"] > 0 {
        parser_add_error(p, "@oren.generator is currently only supported on top-level function declarations")
        return stmt
    }
    func["body"] = wrapper_body
    func["generator_decl"] = true
    func["generator_import_alias"] = import_alias
    return stmt
}

fn attach_attrs_to_stmt(p, stmt, attrs) {
    if attrs == nil { return nil }
    if oren_list_len(attrs) == 0 { return nil }

    if _attrs_has_name(attrs, "oren.generator") == true {
        if stmt["type"] == "ExprStmt" {
            var generator_exp = stmt["expr"]
            if generator_exp != nil && generator_exp["type"] == "Function" {
                generator_exp["attrs"] = _merge_attrs(generator_exp["attrs"], attrs)
                return nil
            }
        }
        parser_add_error(p, "@oren.generator may only precede named function declarations")
        attrs = _attrs_filter_out_name(attrs, "oren.generator")
        if attrs == nil || oren_list_len(attrs) == 0 { return nil }
    }

    // Allowed targets (M1): declarations + local/global vars.
    if stmt["type"] == "Type" || stmt["type"] == "Import" || stmt["type"] == "FFI" {
        stmt["attrs"] = _merge_attrs(stmt["attrs"], attrs)
        return nil
    }
    if stmt["type"] == "Var" {
        // Prefer storing attrs on the identifier node (consistent with fields/params).
        if stmt["name"] != nil && stmt["name"]["type"] == "Identifier" {
            stmt["name"]["attrs"] = _merge_attrs(stmt["name"]["attrs"], attrs)
        } else {
            stmt["attrs"] = _merge_attrs(stmt["attrs"], attrs)
        }
        return nil
    }
    if stmt["type"] == "ExprStmt" {
        var exp = stmt["expr"]
        if exp != nil && exp["type"] == "Function" {
            exp["attrs"] = _merge_attrs(exp["attrs"], attrs)
            return nil
        }
    }

    // Allow statement-level @cfg (rolling).
    if _attrs_all_cfg(attrs) == true {
        stmt["attrs"] = _merge_attrs(stmt["attrs"], attrs)
        return nil
    }
    if (stmt["type"] == "While" || stmt["type"] == "For") && _attrs_all_arena_loop(attrs) == true {
        stmt["attrs"] = _merge_attrs(stmt["attrs"], attrs)
        return nil
    }

    parser_add_error(p, "attributes may only precede declarations (fn/struct/class/import/ffi/var)")
    return nil
}

fn _stmt_supports_pub(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Var" || t == "Type" || t == "FFI" { return true }
    if t == "ExprStmt" {
        var exp = stmt["expr"]
        if exp != nil && exp["type"] == "Function" { return true }
        return false
    }
    if t == "StmtList" {
        var xs = stmt["stmts"]
        if xs == nil || oren_list_len(xs) == 0 { return false }
        var saw_decl = false
        var i = 0
        while i < oren_list_len(xs) {
            if _stmt_supports_pub(xs[i]) != true {
                return false
            }
            saw_decl = true
            i = i + 1
        }
        return saw_decl
    }
    return false
}

fn _mark_stmt_public(stmt) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Var" || t == "Type" || t == "FFI" {
        stmt["is_pub"] = true
        return nil
    }
    if t == "ExprStmt" {
        var exp = stmt["expr"]
        if exp != nil && exp["type"] == "Function" {
            stmt["is_pub"] = true
            exp["is_pub"] = true
        }
        return nil
    }
    if t == "StmtList" {
        var xs = stmt["stmts"]
        if xs == nil { return nil }
        var i = 0
        while i < oren_list_len(xs) {
            _mark_stmt_public(xs[i])
            i = i + 1
        }
    }
    return nil
}

fn parse_pub_stmt(p) {
    parser_next_token(p)
    if cur_is(p, token.TOK_EOF) {
        parser_add_error(p, "'pub' expects a declaration")
        return nil
    }
    var stmt = parse_statement(p)
    if stmt == nil { return nil }
    if p["block_depth"] > 0 {
        parser_add_error(p, "'pub' is only allowed on top-level declarations")
        return stmt
    }
    if _stmt_supports_pub(stmt) != true {
        parser_add_error(p, "'pub' may only precede top-level declarations (fn/var/struct/class/enum/ffi)")
        return stmt
    }
    _mark_stmt_public(stmt)
    return stmt
}

fn parse_statement(p) {
    if cur_is(p, token.TOK_PUB) { return parse_pub_stmt(p) }
    if cur_is(p, token.TOK_LET) { return parse_var(p) }
    if cur_is(p, token.TOK_RETURN) { return parse_return(p) }
    if cur_is(p, token.TOK_WHILE) { return parse_while(p) }
    if cur_is(p, token.TOK_FOR) { return parse_for(p) }
    if cur_is(p, token.TOK_SWITCH) { return parse_switch(p) }
    if cur_is(p, token.TOK_BREAK) { return parse_break(p) }
    if cur_is(p, token.TOK_CONTINUE) { return parse_continue(p) }
    if cur_is(p, token.TOK_YIELD) { return parse_yield(p) }
    if cur_is(p, token.TOK_IMPORT) { return parse_import(p) }
    if cur_is(p, token.TOK_STRUCT) { return parse_type_decl(p) }
    if cur_is(p, token.TOK_CLASS) { return parse_type_decl(p) }
    if cur_is(p, token.TOK_ENUM) { return parse_enum_decl(p) }
    if cur_is(p, token.TOK_TRAIT) { return parse_trait_decl(p) }
    if cur_is(p, token.TOK_IMPL) { return parse_impl_decl(p) }
    if cur_is(p, token.TOK_FFI) { return parse_ffi(p) }
    if cur_is(p, token.TOK_TEST) { return parse_test(p) }
    if cur_is(p, token.TOK_ASSERT) { return parse_assert(p) }
    if cur_is(p, token.TOK_SPAWN) { return parse_spawn(p) }
    if cur_is(p, token.TOK_LBRACE) { return parse_block(p) }
    if cur_is(p, token.TOK_IDENT) {
        var lit = p["cur"]["literal"]
        if (lit == "debug" || lit == "release") && peek_is(p, token.TOK_LBRACE) {
            var attr_name = "oren.debug"
            if lit == "release" { attr_name = "oren.release" }
            var attr = {"type": "Attr", "token": p["cur"], "name": attr_name, "args": []}
            parser_next_token(p) // '{'
            var block = parse_block(p)
            if block != nil { attach_attrs_to_stmt(p, block, [attr]) }
            return block
        }
        // Contextual keyword: `match` is only treated as a statement when it is not
        // being used as an identifier (var name, call, member, indexing, etc.).
        if p["cur"]["literal"] == "match" {
            var pt = p["peek"]["type"]
            if pt != token.TOK_DECLARE && pt != token.TOK_ASSIGN && pt != token.TOK_COLON &&
               pt != token.TOK_DOT && pt != token.TOK_LPAREN && pt != token.TOK_LBRACKET &&
               pt != token.TOK_SEMICOLON && pt != token.TOK_RBRACE && pt != token.TOK_EOF {
                return parse_match(p)
            }
        }
        if peek_is(p, token.TOK_DECLARE) { return parse_short_var(p) }
        if peek_is(p, token.TOK_COLON) { return parse_typed_short_var(p) }
        return parse_assign_or_expr_stmt(p)
    }
    return parse_expr_stmt(p)
}

fn parse_dotted_name(p) {
    // Parse an identifier with optional dotted suffixes: A.B.C
    if !cur_is_ident_like(p) { return nil }
    var name = p["cur"]["literal"]
    while peek_is(p, token.TOK_DOT) {
        parser_next_token(p) // .
        if !expect_peek_ident_like(p, "dotted name segment") { return nil }
        name = name + "." + p["cur"]["literal"]
    }
    return name
}

fn skip_parens_signature(p) {
    // Best-effort skip of (...) in trait signatures.
    // Precondition: current token is '('.
    var depth = 0
    while true {
        if cur_is(p, token.TOK_LPAREN) { depth = depth + 1 }
        if cur_is(p, token.TOK_RPAREN) {
            depth = depth - 1
            if depth <= 0 { return nil }
        }
        if cur_is(p, token.TOK_EOF) { return nil }
        parser_next_token(p)
    }
}

fn parse_trait_decl(p) {
    // trait Foo { fn m(a, b); fn n(x): i32; }
    //
    // Rolling implementation:
    // - Trait declarations are compile-time contracts only (no runtime representation yet).
    // - We keep a metadata-only record under p["traits"] for tooling (docs/serde/OpenAPI/etc).
    // - No statements are emitted, so existing backends remain unchanged.
    var doc = parser_take_pending_doc(p)
    if !expect_peek_ident_like(p, "trait name") { return ast.new_stmt_list([]) }
    var trait_name = parse_dotted_name(p)
    if trait_name == nil { return ast.new_stmt_list([]) }
    ident_prefix_validate(p, trait_name, "trait")
    if !expect_peek(p, token.TOK_LBRACE) { return ast.new_stmt_list([]) }

    var methods = []
    // Enter body.
    parser_next_token(p)
    while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
        if cur_is(p, token.TOK_SEMICOLON) { parser_next_token(p); continue }
        if cur_is(p, token.TOK_COMMA) { parser_next_token(p); continue }

        if cur_is(p, token.TOK_FUNCTION) {
            // Parse `fn name(...)` signature and record it.
            if !expect_peek_ident_like(p, "trait method name") { return ast.new_stmt_list([]) }
            var mname = p["cur"]["literal"]
            ident_prefix_validate(p, mname, "trait method")
            if !expect_peek(p, token.TOK_LPAREN) { return ast.new_stmt_list([]) }
            var params = parse_parameters(p) // leaves cur at ')'

            // Optional return type: `: T`
            var ret_ann = nil
            if peek_is(p, token.TOK_COLON) {
                parser_next_token(p) // ':'
                ret_ann = parse_type_name_after_colon(p)
                if ret_ann == nil { return ast.new_stmt_list([]) }
            }

            // Convert params (Identifier AST nodes) into stable metadata.
            var mparams = []
            var pi = 0
            while pi < oren_list_len(params) {
                var id = params[pi]
                var pname = nil
                var ann = nil
                var isv = false
                var pattrs = []
                if id != nil {
                    pname = id["value"]
                    ann = id["ann_type"]
                    if id["is_varargs"] == true { isv = true }
                    if id["attrs"] != nil { pattrs = id["attrs"] }
                }
                oren_list_push(mparams, {"value": pname, "attrs": pattrs, "ann_type": ann, "is_varargs": isv})
                pi = pi + 1
            }

            oren_list_push(methods, {"name": mname, "params": mparams, "ret_ann_type": ret_ann})

            // Consume optional separator and continue.
            if peek_is(p, token.TOK_SEMICOLON) { parser_next_token(p) }
            if peek_is(p, token.TOK_COMMA) { parser_next_token(p) }
            parser_next_token(p)
            continue
        }

        // Unknown token inside trait body: skip (rolling mode).
        parser_next_token(p)
    }

    // p["cur"] is '}' (or EOF). Record trait metadata for tooling.
    p["trait_set"][trait_name] = true
    oren_list_push(p["traits"], {"name": trait_name, "doc": doc, "methods": methods})
    return ast.new_stmt_list([])
}

fn impl_mangled_name(trait_name, type_name, method) {
    // Deterministic lowering name for impl methods (rolling).
    //
    // Rationale:
    // - avoids introducing a runtime method table before the type system is stable
    // - keeps compilation bootstrap-friendly (plain fns)
    // - stable across backends (C/native/bytecode)
    //
    // Convention:
    //   __oren_impl__<Trait>__<Type>__<method>
    //
    // Dots are replaced by underscores for C identifier stability downstream.
    var out_t = _impl_mangle_type_part(trait_name)
    var out_ty = _impl_mangle_type_part(type_name)
    return "__oren_impl__" + out_t + "__" + out_ty + "__" + method
}

fn _impl_mangle_type_part(s) {
    // Mangle a type-ish name into a valid identifier segment.
    //
    // Inputs include:
    // - dotted names: `mod.Type`
    // - pointer prefix: `*T`, `**T`
    // - typed-buffer / slice prefix: `[]T`, `[][]T`
    // - fixed arrays: `T[16]`, `*T[16]`
    //
    // Output must contain only `[A-Za-z0-9_]` so it can be used in a synthesized
    // function name.
    if s == nil { return "" }

    var out = ""
    var i = 0
    while i < oren_string_len(s) {
        var c = oren_string_char_at(s, i)

        if c == "." {
            out = out + "_"
            i = i + 1
            continue
        }
        if c == "*" {
            out = out + "ptr_"
            i = i + 1
            continue
        }
        if c == "[" {
            // Typed-buffer prefix `[]`.
            if i+1 < oren_string_len(s) && oren_string_char_at(s, i+1) == "]" {
                out = out + "slice_"
                i = i + 2
                continue
            }

            // Fixed array suffix `[N]` (parser only emits numeric dims here).
            var j = i + 1
            var dims = ""
            while j < oren_string_len(s) && oren_string_char_at(s, j) != "]" {
                dims = dims + oren_string_char_at(s, j)
                j = j + 1
            }
            if j < oren_string_len(s) && oren_string_char_at(s, j) == "]" && dims != "" {
                out = out + "arr" + dims + "_"
                i = j + 1
                continue
            }

            // Fallback: keep deterministic but safe.
            out = out + "_"
            i = i + 1
            continue
        }

        // In practice, the parser only emits identifier-safe characters in type names
        // beyond the punctuators handled above; keep a conservative fallback anyway.
        if c == "_" { out = out + c }
        else { out = out + c }
        i = i + 1
    }

    return out
}

fn parse_impl_decl(p) {
    // impl Trait for Type { fn method(self, ...) { ... } ... }
    //
    // Rolling implementation:
    // - Parser accepts impl blocks.
    // - Each method is lowered to a plain top-level function with a deterministic name:
    //     __oren_impl__Trait__Type__method(...)
    //
    // This unblocks early stdlib layering and tooling without committing to a stable
    // method dispatch ABI yet.
    var doc = parser_take_pending_doc(p)
    if !expect_peek_ident_like(p, "impl trait name") { return ast.new_stmt_list([]) }
    // cur is IDENT after expect_peek
    var trait_name = parse_dotted_name(p)
    if trait_name == nil { return ast.new_stmt_list([]) }

    if !expect_peek(p, token.TOK_FOR) { return ast.new_stmt_list([]) }
    var type_name = parse_type_name_after_for(p)
    if type_name == nil { return ast.new_stmt_list([]) }

    if !expect_peek(p, token.TOK_LBRACE) { return ast.new_stmt_list([]) }

    var out = []
    var impl_block_id = parser_gensym(p, "@impl_" + trait_name + "_" + type_name + "_")
    parser_next_token(p)
    while !cur_is(p, token.TOK_RBRACE) && !cur_is(p, token.TOK_EOF) {
        if cur_is(p, token.TOK_DOC) {
            var md = parse_doc_list(p)
            if md != nil { p["_pending_doc"] = md }
            continue
        }
        if cur_is(p, token.TOK_SEMICOLON) { parser_next_token(p); continue }
        if cur_is(p, token.TOK_COMMA) { parser_next_token(p); continue }
        if cur_is(p, token.TOK_FUNCTION) {
            var st = parse_expr_stmt(p)
            if st == nil { return ast.new_stmt_list(out) }
            // st is ExprStmt(Function)
            var fnn = st["expr"]
            if fnn != nil && fnn["type"] == "Function" {
                if doc != nil && fnn["doc"] == nil { fnn["doc"] = doc }
                var mname = fnn["name"]
                var newn = impl_mangled_name(trait_name, type_name, mname)
                // Preserve impl identity for later whole-program passes:
                // - enables cross-module method call lowering after module linking
                // - enables coherence checks without parsing mangled identifiers
                fnn["impl_trait"] = trait_name
                fnn["impl_type"] = type_name
                fnn["impl_method"] = mname
                fnn["impl_mangled_base"] = newn
                fnn["impl_block_id"] = impl_block_id
                fnn["name"] = newn
                impl_method_register(p, type_name, mname, newn)
                impl_trait_method_register(p, trait_name, type_name, mname, newn)
            }
            oren_list_push(out, st)
            parser_next_token(p)
            continue
        }
        parser_add_error(p, "impl body expects 'fn' declarations")
        return ast.new_stmt_list(out)
    }
    // p["cur"] is '}'.
    return ast.new_stmt_list(out)
}
