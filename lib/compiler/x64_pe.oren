// PE32+ (Windows x64) emitter for x86_64 native backend bring-up.
//
// v0:
// - emits a PE executable with three sections: .text (RX), .rdata (R), .data (RW)
// - imports a small Win32 surface via an import table:
//   - KERNEL32.dll: ExitProcess, GetStdHandle, WriteFile, ReadFile, VirtualAlloc, GetEnvironmentVariableA,
//                   GetEnvironmentStringsA, FreeEnvironmentStringsA, GetCommandLineW, WideCharToMultiByte, LocalFree,
//                   Sleep, GetSystemTimeAsFileTime, QueryPerformanceCounter,
//                   CreateProcessA, WaitForSingleObject, GetExitCodeProcess, SetHandleInformation, CloseHandle
//   - SHELL32.dll: CommandLineToArgvW
// - entry stub calls main(), then ExitProcess(main_ret)
//
// This is intentionally small and self-contained (no external toolchain required).

import codegen "codegen_x64.oren"
import abi "native_abi.oren"

fn bytes_new() { return codegen.bytes_new() }
fn bytes_push(b, v) { return codegen.bytes_push(b, v) }
fn bytes_extend(b, other) { return codegen.bytes_extend(b, other) }
fn bytes_extend_list(b, xs) { return codegen.bytes_extend_list(b, xs) }
fn bytes_len(b) { return codegen.bytes_len(b) }
fn bytes_finalize(b) { return codegen.bytes_finalize(b) }
fn push_u32_le(b, n) { return codegen.push_u32_le(b, n) }
fn push_u64_le(b, n) { return codegen.push_u64_le(b, n) }
fn set_u32_le(b, off, n) { return codegen.set_u32_le(b, off, n) }
fn int_mod(a, b) { return codegen.int_mod(a, b) }

fn set_u64_le(buf, offset, n) {
    // Patch u64 into a byte buffer (little-endian) using two u32 writes.
    set_u32_le(buf, offset, int_mod(n, 4294967296))
    set_u32_le(buf, offset + 4, int_mod(n / 4294967296, 4294967296))
}

fn align_up(n, align) {
    return (n + align - 1) / align * align
}

fn push_u16_le(buf, n) {
    bytes_push(buf, int_mod(n, 256))
    bytes_push(buf, int_mod(n / 256, 256))
}

fn push_u8_n(buf, v, n) {
    var i = 0
    while i < n { bytes_push(buf, v); i = i + 1 }
}

fn push_ascii_z(buf, s) {
    var bs = oren_bytes_from_string(s)
    var i = 0
    while i < oren_list_len(bs) { bytes_push(buf, bs[i]); i = i + 1 }
    bytes_push(buf, 0)
}

fn pe_emit_program_x64(out_path, linked, debug_mode, no_gc, call_depth_max, capsule, cap_allow_domains) {
    var ctx = codegen.native_compile_program_x64(linked, {"os": "windows", "debug": debug_mode, "no_gc": no_gc, "call_depth_max": call_depth_max, "capsule": capsule, "cap_allow_domains": cap_allow_domains})
    if ctx == nil { return nil }
    codegen.native_emit_errors_and_exit(ctx)

    var code = ctx["code"]
    var user_data = ctx["data"]
    var fixups = ctx["fixups"]
    var functions = ctx["functions"]

    // ---- Build .rdata (import table) ----
    //
    // Layout in .rdata:
    //   import_desc[D+1] (D DLLs + null)
    //   ILT per DLL (N+1 entries)
    //   IAT per DLL (N+1 entries)
    //   hint/name for each imported func
    //   dll name strings
    //   (no user data; user data lives in `.data` so `.rdata` can stay read-only)
    //
    // We record offsets for RVAs and patch descriptors later.
    var rdata = bytes_new()

    var off_import_desc = bytes_len(rdata)
    // 4 descriptors * 20 bytes: kernel32 + ws2_32 + shell32 + null
    push_u8_n(rdata, 0, 80)

    var kernel32_funcs = [
        "ExitProcess",
        "GetStdHandle",
        "WriteFile",
        "ReadFile",
        // File I/O substrate (CreateFileA-based `sys_open` for native runtime injection).
        // Added at the end of the table so existing IAT offsets remain stable.
        "VirtualAlloc",
        "GetEnvironmentVariableA",
        "GetEnvironmentStringsA",
        "GetCommandLineW",
        "WideCharToMultiByte",
        "LocalFree",
        // TIME substrate
        "Sleep",
        "GetSystemTimeAsFileTime",
        "QueryPerformanceCounter",
        // PROC substrate (CreateProcessA spawn+wait)
        "CreateProcessA",
        "WaitForSingleObject",
        "GetExitCodeProcess",
        // Ensure inherited std handles are inheritable when launched under OpenSSH (pipe stdio).
        "SetHandleInformation",
        // Handle closing (used by sys_close fallback for non-socket handles).
        "CloseHandle",
        // THREAD substrate (CreateThread spawn+join/terminate)
        "CreateThread",
        "TerminateThread",
        "CreateFileA",
        // FS substrate (Win32 API shims, capsule-safe syscalls)
        "GetLastError",
        "GetFileAttributesA",
        "DeleteFileA",
        "RemoveDirectoryA",
        "CreateDirectoryA",
        "MoveFileExA",
        "SetFileAttributesA",
        // Stat helpers (Tier‑1): keep at end to preserve existing IAT offsets.
        "GetFileAttributesExA",
        "GetFileSizeEx",
        // ENV block freeing (used after copying env strings into runtime-owned memory).
        // Keep at end to preserve existing IAT offsets.
        "FreeEnvironmentStringsA",
        // Thread identity (Tier‑1 Windows): used by the native runtime lock implementation.
        // Keep at end to preserve existing IAT offsets.
        "GetCurrentThreadId"
    ]
    // WinSock NET substrate (WS2_32.dll).
    // Keep this list minimal and explicit so the IAT label mapping below stays auditable.
    var ws2_32_funcs = [
        "WSAStartup",
        "WSAGetLastError",
        "socket",
        "connect",
        "bind",
        "listen",
        "accept",
        "sendto",
        "recvfrom",
        "getsockname",
        "getpeername",
        "setsockopt",
        "getsockopt",
        "shutdown",
        "closesocket",
        "ioctlsocket",
        "select"
    ]
    var shell32_funcs = ["CommandLineToArgvW"]
    var n_k32 = oren_list_len(kernel32_funcs)
    var n_ws2 = oren_list_len(ws2_32_funcs)
    var n_s32 = oren_list_len(shell32_funcs)

    // Align to 8 for thunk arrays.
    while int_mod(bytes_len(rdata), 8) != 0 { bytes_push(rdata, 0) }
    var off_ilt_k32 = bytes_len(rdata)
    // ILT(KERNEL32): imports + null entry
    var i0 = 0
    while i0 < n_k32 + 1 { push_u64_le(rdata, 0); i0 = i0 + 1 }

    while int_mod(bytes_len(rdata), 8) != 0 { bytes_push(rdata, 0) }
    var off_ilt_ws2 = bytes_len(rdata)
    // ILT(WS2_32): imports + null entry
    i0 = 0
    while i0 < n_ws2 + 1 { push_u64_le(rdata, 0); i0 = i0 + 1 }

    while int_mod(bytes_len(rdata), 8) != 0 { bytes_push(rdata, 0) }
    var off_ilt_s32 = bytes_len(rdata)
    // ILT(SHELL32): imports + null entry
    i0 = 0
    while i0 < n_s32 + 1 { push_u64_le(rdata, 0); i0 = i0 + 1 }

    while int_mod(bytes_len(rdata), 8) != 0 { bytes_push(rdata, 0) }
    var off_iat_k32 = bytes_len(rdata)
    // IAT(KERNEL32): imports + null entry
    var i1 = 0
    while i1 < n_k32 + 1 { push_u64_le(rdata, 0); i1 = i1 + 1 }

    while int_mod(bytes_len(rdata), 8) != 0 { bytes_push(rdata, 0) }
    var off_iat_ws2 = bytes_len(rdata)
    // IAT(WS2_32): imports + null entry
    i1 = 0
    while i1 < n_ws2 + 1 { push_u64_le(rdata, 0); i1 = i1 + 1 }

    while int_mod(bytes_len(rdata), 8) != 0 { bytes_push(rdata, 0) }
    var off_iat_s32 = bytes_len(rdata)
    // IAT(SHELL32): imports + null entry
    i1 = 0
    while i1 < n_s32 + 1 { push_u64_le(rdata, 0); i1 = i1 + 1 }

    // Hint/Name entries (collect offsets by symbol name).
    var hn_offs = {}
    i0 = 0
    while i0 < n_k32 {
        var nm = kernel32_funcs[i0]
        hn_offs[nm] = bytes_len(rdata)
        push_u16_le(rdata, 0)
        push_ascii_z(rdata, nm)
        if int_mod(bytes_len(rdata), 2) != 0 { bytes_push(rdata, 0) }
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_ws2 {
        var nmw = ws2_32_funcs[i0]
        hn_offs[nmw] = bytes_len(rdata)
        push_u16_le(rdata, 0)
        push_ascii_z(rdata, nmw)
        if int_mod(bytes_len(rdata), 2) != 0 { bytes_push(rdata, 0) }
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_s32 {
        var nm2 = shell32_funcs[i0]
        hn_offs[nm2] = bytes_len(rdata)
        push_u16_le(rdata, 0)
        push_ascii_z(rdata, nm2)
        if int_mod(bytes_len(rdata), 2) != 0 { bytes_push(rdata, 0) }
        i0 = i0 + 1
    }

    var off_dll_k32 = bytes_len(rdata)
    push_ascii_z(rdata, "KERNEL32.dll")
    var off_dll_ws2 = bytes_len(rdata)
    push_ascii_z(rdata, "WS2_32.dll")
    var off_dll_s32 = bytes_len(rdata)
    push_ascii_z(rdata, "SHELL32.dll")

    // Section layout constants.
    var file_align = 512
    var sect_align = 4096
    var image_base = abi.x64_v0_windows_pe_image_base()

    // We'll use:
    //   .text RVA 0x1000
    //   .rdata RVA aligned after .text (SectAlign pages)
    //
    // NOTE: .rdata must not overlap .text in virtual address space. When .text grows beyond
    // 1 page, the next section RVA must advance accordingly (Windows loader rejects overlap).
    var text_rva = abi.x64_v0_windows_text_rva()
    var text_vsize = bytes_len(code)
    var rdata_rva = text_rva + align_up(text_vsize, sect_align)
    // `.data` follows `.rdata` (SectAlign pages). `.rdata` contains only the import table.
    var data_rva = rdata_rva + align_up(bytes_len(rdata), sect_align)

    // Patch thunk entries with RVA to hint/name.
    i0 = 0
    while i0 < n_k32 {
        var nm3 = kernel32_funcs[i0]
        var hn_rva = rdata_rva + hn_offs[nm3]
        set_u32_le(rdata, off_ilt_k32 + i0 * 8, hn_rva)
        set_u32_le(rdata, off_iat_k32 + i0 * 8, hn_rva)
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_ws2 {
        var nmw2 = ws2_32_funcs[i0]
        var hn_rva_w = rdata_rva + hn_offs[nmw2]
        set_u32_le(rdata, off_ilt_ws2 + i0 * 8, hn_rva_w)
        set_u32_le(rdata, off_iat_ws2 + i0 * 8, hn_rva_w)
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_s32 {
        var nm4 = shell32_funcs[i0]
        var hn_rva2 = rdata_rva + hn_offs[nm4]
        set_u32_le(rdata, off_ilt_s32 + i0 * 8, hn_rva2)
        set_u32_le(rdata, off_iat_s32 + i0 * 8, hn_rva2)
        i0 = i0 + 1
    }

    // Patch import descriptors.
    //
    // IMAGE_IMPORT_DESCRIPTOR (20 bytes):
    //   0: OriginalFirstThunk (RVA ILT)
    //   4: TimeDateStamp (0)
    //   8: ForwarderChain (0)
    //  12: Name (RVA dll name)
    //  16: FirstThunk (RVA IAT)
    var dll_k32_rva = rdata_rva + off_dll_k32
    set_u32_le(rdata, off_import_desc + 0, rdata_rva + off_ilt_k32)
    set_u32_le(rdata, off_import_desc + 12, dll_k32_rva)
    set_u32_le(rdata, off_import_desc + 16, rdata_rva + off_iat_k32)

    var dll_ws2_rva = rdata_rva + off_dll_ws2
    // second descriptor (+20): WS2_32.dll
    set_u32_le(rdata, off_import_desc + 20 + 0, rdata_rva + off_ilt_ws2)
    set_u32_le(rdata, off_import_desc + 20 + 12, dll_ws2_rva)
    set_u32_le(rdata, off_import_desc + 20 + 16, rdata_rva + off_iat_ws2)

    var dll_s32_rva = rdata_rva + off_dll_s32
    // third descriptor (+40): SHELL32.dll
    set_u32_le(rdata, off_import_desc + 40 + 0, rdata_rva + off_ilt_s32)
    set_u32_le(rdata, off_import_desc + 40 + 12, dll_s32_rva)
    set_u32_le(rdata, off_import_desc + 40 + 16, rdata_rva + off_iat_s32)

    var import_dir_rva = rdata_rva + off_import_desc
    var import_dir_size = 80

    // ---- Build `.data` (user data blob) ----
    //
    // This contains:
    // - string literals
    // - fnobj records (function values)
    // - symtab / debug tables
    // - mutable globals (e.g. call depth counters)
    //
    // Keep it 8-byte aligned for u64 tables.
    var data = bytes_new()
    if user_data != nil { bytes_extend(data, user_data) }
    while int_mod(bytes_len(data), 8) != 0 { bytes_push(data, 0) }

    // ---- Apply code fixups (rel32 call + rip-relative IAT load) ----
    //
    // For PE, all code addresses are RVAs within .text section.
    // We patch:
    // - call rel32 to main
    // - mov rax, [rip+disp32] to read IAT ExitProcess slot
    var i = 0
    while i < oren_list_len(fixups) {
        var f = fixups[i]
        if f["type"] == "call_rel32" {
            var name = f["name"]
            var target = functions[name]
            if target == nil {
                print("x64 pe: undefined function " + name)
                oren_exit(1)
            }
            var pos = f["pos"]
            var disp = target - (pos + 5)
            if disp < 0 { disp = 4294967296 + disp }
            set_u32_le(code, pos + 1, disp)
        }
        if f["type"] == "rip_data32" {
            // disp32 relative to next RIP (end of instruction).
            // f["pos"] points to disp32 field within the instruction.
            var label = f["data_label"]
            var target_off = nil
            // KERNEL32.dll IAT slots (order matches kernel32_funcs above)
            if label == "IAT_ExitProcess" { target_off = off_iat_k32 + 0 }
            else if label == "IAT_GetStdHandle" { target_off = off_iat_k32 + 8 }
            else if label == "IAT_WriteFile" { target_off = off_iat_k32 + 16 }
            else if label == "IAT_ReadFile" { target_off = off_iat_k32 + 24 }
            else if label == "IAT_VirtualAlloc" { target_off = off_iat_k32 + 32 }
            else if label == "IAT_GetEnvironmentVariableA" { target_off = off_iat_k32 + 40 }
            else if label == "IAT_GetEnvironmentStringsA" { target_off = off_iat_k32 + 48 }
            else if label == "IAT_GetCommandLineW" { target_off = off_iat_k32 + 56 }
            else if label == "IAT_WideCharToMultiByte" { target_off = off_iat_k32 + 64 }
            else if label == "IAT_LocalFree" { target_off = off_iat_k32 + 72 }
            else if label == "IAT_Sleep" { target_off = off_iat_k32 + 80 }
            else if label == "IAT_GetSystemTimeAsFileTime" { target_off = off_iat_k32 + 88 }
            else if label == "IAT_QueryPerformanceCounter" { target_off = off_iat_k32 + 96 }
            else if label == "IAT_CreateProcessA" { target_off = off_iat_k32 + 104 }
            else if label == "IAT_WaitForSingleObject" { target_off = off_iat_k32 + 112 }
            else if label == "IAT_GetExitCodeProcess" { target_off = off_iat_k32 + 120 }
            else if label == "IAT_SetHandleInformation" { target_off = off_iat_k32 + 128 }
            else if label == "IAT_CloseHandle" { target_off = off_iat_k32 + 136 }
            else if label == "IAT_CreateThread" { target_off = off_iat_k32 + 144 }
            else if label == "IAT_TerminateThread" { target_off = off_iat_k32 + 152 }
            else if label == "IAT_CreateFileA" { target_off = off_iat_k32 + 160 }
            else if label == "IAT_GetLastError" { target_off = off_iat_k32 + 168 }
            else if label == "IAT_GetFileAttributesA" { target_off = off_iat_k32 + 176 }
            else if label == "IAT_DeleteFileA" { target_off = off_iat_k32 + 184 }
            else if label == "IAT_RemoveDirectoryA" { target_off = off_iat_k32 + 192 }
            else if label == "IAT_CreateDirectoryA" { target_off = off_iat_k32 + 200 }
            else if label == "IAT_MoveFileExA" { target_off = off_iat_k32 + 208 }
            else if label == "IAT_SetFileAttributesA" { target_off = off_iat_k32 + 216 }
            else if label == "IAT_GetFileAttributesExA" { target_off = off_iat_k32 + 224 }
            else if label == "IAT_GetFileSizeEx" { target_off = off_iat_k32 + 232 }
            else if label == "IAT_FreeEnvironmentStringsA" { target_off = off_iat_k32 + 240 }
            else if label == "IAT_GetCurrentThreadId" { target_off = off_iat_k32 + 248 }
            // WS2_32.dll IAT slots (order matches ws2_32_funcs above)
            else if label == "IAT_WSAStartup" { target_off = off_iat_ws2 + 0 }
            else if label == "IAT_WSAGetLastError" { target_off = off_iat_ws2 + 8 }
            else if label == "IAT_socket" { target_off = off_iat_ws2 + 16 }
            else if label == "IAT_connect" { target_off = off_iat_ws2 + 24 }
            else if label == "IAT_bind" { target_off = off_iat_ws2 + 32 }
            else if label == "IAT_listen" { target_off = off_iat_ws2 + 40 }
            else if label == "IAT_accept" { target_off = off_iat_ws2 + 48 }
            else if label == "IAT_sendto" { target_off = off_iat_ws2 + 56 }
            else if label == "IAT_recvfrom" { target_off = off_iat_ws2 + 64 }
            else if label == "IAT_getsockname" { target_off = off_iat_ws2 + 72 }
            else if label == "IAT_getpeername" { target_off = off_iat_ws2 + 80 }
            else if label == "IAT_setsockopt" { target_off = off_iat_ws2 + 88 }
            else if label == "IAT_getsockopt" { target_off = off_iat_ws2 + 96 }
            else if label == "IAT_shutdown" { target_off = off_iat_ws2 + 104 }
            else if label == "IAT_closesocket" { target_off = off_iat_ws2 + 112 }
            else if label == "IAT_ioctlsocket" { target_off = off_iat_ws2 + 120 }
            else if label == "IAT_select" { target_off = off_iat_ws2 + 128 }
            // SHELL32.dll IAT slots
            else if label == "IAT_CommandLineToArgvW" { target_off = off_iat_s32 + 0 }
            else {
                print("x64 pe: unknown data label " + label)
                oren_exit(1)
            }
            var disp_pos = f["pos"]
            var insn_start = disp_pos - 3
            var next_rip = text_rva + (insn_start + 7)
            var target_rva = rdata_rva + target_off
            var disp2 = target_rva - next_rip
            if disp2 < 0 { disp2 = 4294967296 + disp2 }
            set_u32_le(code, disp_pos, disp2)
        }
        if f["type"] == "rip_rdata_lea" {
            // Backward-compatible alias: previously we used `rip_rdata_lea` for user-data.
            // User-data now lives in `.data`.
            var disp_pos2 = f["pos"]
            var data_off = f["data_off"]
            var insn_start2 = disp_pos2 - 3
            var next_rip2 = text_rva + (insn_start2 + 7)
            var target_rva2 = data_rva + data_off
            var disp3 = target_rva2 - next_rip2
            if disp3 < 0 { disp3 = 4294967296 + disp3 }
            set_u32_le(code, disp_pos2, disp3)
        }
        if f["type"] == "rip_data_lea" || f["type"] == "rip_data_lea_rsi" {
            // lea r64, [rip+disp32] where target points into `.data` (fnobj, cstr, etc).
            //
            // x64_native_program.oren uses this fixup for first-class function values:
            // it emits `lea rax,[rip+disp32]` and later the caller loads `[rax]` as code_ptr.
            var disp_pos2 = f["pos"]
            var data_off = f["data_off"]
            var insn_start2 = disp_pos2 - 3
            var next_rip2 = text_rva + (insn_start2 + 7)
            var target_rva2 = data_rva + data_off
            var disp3 = target_rva2 - next_rip2
            if disp3 < 0 { disp3 = 4294967296 + disp3 }
            set_u32_le(code, disp_pos2, disp3)
        }
        if f["type"] == "data_fnobj_code_ptr" {
            var name2 = f["name"]
            var target_off2 = functions[name2]
            if target_off2 == nil {
                print("x64 pe: undefined function " + name2)
                oren_exit(1)
            }
            var data_off2 = f["data_off"]
            // Store absolute VA (ImageBase + .text RVA + fn offset). This emitter does not
            // produce relocations, so the base is fixed (0x400000).
            var addr = image_base + text_rva + target_off2
            set_u64_le(data, data_off2, addr)
        }
        if f["type"] == "rip_code_lea" {
            // lea r64, [rip+disp32] where target is a function entry in .text.
            var disp_pos3 = f["pos"]
            var name2 = f["name"]
            var target_off2 = functions[name2]
            if target_off2 == nil {
                print("x64 pe: undefined function " + name2)
                oren_exit(1)
            }
            var insn_start3 = disp_pos3 - 3
            var next_rip3 = text_rva + (insn_start3 + 7)
            var target_rva3 = text_rva + target_off2
            var disp4 = target_rva3 - next_rip3
            if disp4 < 0 { disp4 = 4294967296 + disp4 }
            set_u32_le(code, disp_pos3, disp4)
        }
        i = i + 1
    }

    // ---- Build headers ----
    var n_sections = 3
    var text_raw_size = align_up(bytes_len(code), file_align)
    var rdata_raw_size = align_up(bytes_len(rdata), file_align)
    var data_raw_size = align_up(bytes_len(data), file_align)

    // PE headers size:
    // DOS(64) + stub/pad to e_lfanew (0x80) + PE sig(4) + COFF(20) + OPT(240) + SECHDR(40*n)
    var dos_stub_size = 128
    var pe_off = dos_stub_size
    var pe_headers_size = pe_off + 4 + 20 + 240 + 40 * n_sections
    var size_of_headers = align_up(pe_headers_size, file_align)

    var text_raw_ptr = size_of_headers
    var rdata_raw_ptr = align_up(text_raw_ptr + text_raw_size, file_align)
    var data_raw_ptr = align_up(rdata_raw_ptr + rdata_raw_size, file_align)

    var size_of_code = text_raw_size
    var size_of_init_data = rdata_raw_size + data_raw_size

    var size_of_image = align_up(data_rva + align_up(bytes_len(data), sect_align), sect_align)

    // ---- DOS header ----
    var out = bytes_new()
    // IMAGE_DOS_HEADER (64 bytes)
    push_u16_le(out, 23117) // 'MZ' 0x5A4D
    push_u8_n(out, 0, 58)
    // e_lfanew at offset 0x3C
    push_u32_le(out, pe_off)
    // pad to pe_off
    while bytes_len(out) < pe_off { bytes_push(out, 0) }

    // ---- PE signature ----
    bytes_push(out, 80); bytes_push(out, 69); bytes_push(out, 0); bytes_push(out, 0) // "PE\0\0"

    // ---- COFF header (20 bytes) ----
    push_u16_le(out, 34404) // 0x8664
    push_u16_le(out, n_sections)
    push_u32_le(out, 0) // TimeDateStamp
    push_u32_le(out, 0) // PtrToSymbolTable
    push_u32_le(out, 0) // NumberOfSymbols
    push_u16_le(out, 240) // SizeOfOptionalHeader
    push_u16_le(out, 34)  // Characteristics: EXECUTABLE | LARGE_ADDRESS_AWARE

    // ---- Optional header (PE32+, 240 bytes) ----
    var opt_start = bytes_len(out)
    push_u16_le(out, 523) // 0x20B
    bytes_push(out, 0) // MajorLinkerVersion
    bytes_push(out, 0) // MinorLinkerVersion
    push_u32_le(out, size_of_code)
    push_u32_le(out, size_of_init_data)
    push_u32_le(out, 0) // SizeOfUninitializedData
    push_u32_le(out, text_rva + ctx["entry_off"]) // AddressOfEntryPoint
    push_u32_le(out, text_rva) // BaseOfCode
    push_u64_le(out, image_base) // ImageBase
    push_u32_le(out, sect_align) // SectionAlignment
    push_u32_le(out, file_align) // FileAlignment
    push_u16_le(out, 6) // MajorOperatingSystemVersion
    push_u16_le(out, 0)
    push_u16_le(out, 0) // MajorImageVersion
    push_u16_le(out, 0)
    push_u16_le(out, 6) // MajorSubsystemVersion
    push_u16_le(out, 0)
    push_u32_le(out, 0) // Win32VersionValue
    push_u32_le(out, size_of_image)
    push_u32_le(out, size_of_headers)
    push_u32_le(out, 0) // CheckSum
    push_u16_le(out, 3) // Subsystem: Windows CUI
    push_u16_le(out, 0) // DllCharacteristics
    // Stack sizing (Tier‑1, rolling):
    // Windows default 1MB stack is too small for some of Oren's integration tests that
    // exercise recursion and deep call stacks. Since we do not yet have a full stackless
    // recursion implementation (heap frames) for native, increase the PE stack reserve.
    //
    // This is a pragmatic Tier‑1 gate to keep behavior aligned with arm64/macOS/Linux while
    // we land the proper design (TCO + heap frames for non‑TCO recursion).
    push_u64_le(out, 67108864) // SizeOfStackReserve (64MB)
    push_u64_le(out, 65536)    // SizeOfStackCommit (64KB)
    push_u64_le(out, 1048576) // SizeOfHeapReserve
    push_u64_le(out, 4096)    // SizeOfHeapCommit
    push_u32_le(out, 0) // LoaderFlags
    push_u32_le(out, 16) // NumberOfRvaAndSizes

    // DataDirectory[16] (each 8 bytes: RVA + Size)
    // 0 Export, 1 Import, others zero.
    // Export
    push_u32_le(out, 0); push_u32_le(out, 0)
    // Import
    push_u32_le(out, import_dir_rva); push_u32_le(out, import_dir_size)
    // Remaining 14 directories
    var ddi = 0
    while ddi < 14 {
        push_u32_le(out, 0); push_u32_le(out, 0)
        ddi = ddi + 1
    }

    // Pad optional header to 240 bytes
    while bytes_len(out) - opt_start < 240 { bytes_push(out, 0) }

    // ---- Section headers (3 * 40 bytes) ----
    // .text
    var name_text = ".text"
    var nb = oren_bytes_from_string(name_text)
    var j = 0
    while j < 8 {
        if j < oren_list_len(nb) { bytes_push(out, nb[j]) } else { bytes_push(out, 0) }
        j = j + 1
    }
    push_u32_le(out, bytes_len(code)) // VirtualSize
    push_u32_le(out, text_rva)
    push_u32_le(out, text_raw_size)
    push_u32_le(out, text_raw_ptr)
    push_u32_le(out, 0); push_u32_le(out, 0) // reloc/line ptr
    push_u16_le(out, 0); push_u16_le(out, 0)
    push_u32_le(out, 1610612768) // Characteristics: CNT_CODE | MEM_EXECUTE | MEM_READ (0x60000020)

    // .rdata
    var name_rd = ".rdata"
    nb = oren_bytes_from_string(name_rd)
    j = 0
    while j < 8 {
        if j < oren_list_len(nb) { bytes_push(out, nb[j]) } else { bytes_push(out, 0) }
        j = j + 1
    }
    push_u32_le(out, bytes_len(rdata))
    push_u32_le(out, rdata_rva)
    push_u32_le(out, rdata_raw_size)
    push_u32_le(out, rdata_raw_ptr)
    push_u32_le(out, 0); push_u32_le(out, 0)
    push_u16_le(out, 0); push_u16_le(out, 0)
    push_u32_le(out, 1073741888) // CNT_INITIALIZED_DATA | MEM_READ (0x40000040)

    // .data (user data blob)
    var name_data = ".data"
    nb = oren_bytes_from_string(name_data)
    j = 0
    while j < 8 {
        if j < oren_list_len(nb) { bytes_push(out, nb[j]) } else { bytes_push(out, 0) }
        j = j + 1
    }
    push_u32_le(out, bytes_len(data)) // VirtualSize
    push_u32_le(out, data_rva)
    push_u32_le(out, data_raw_size)
    push_u32_le(out, data_raw_ptr)
    push_u32_le(out, 0); push_u32_le(out, 0)
    push_u16_le(out, 0); push_u16_le(out, 0)
    push_u32_le(out, 3221225536) // CNT_INITIALIZED_DATA | MEM_READ | MEM_WRITE (0xC0000040)

    // Pad headers to SizeOfHeaders
    while bytes_len(out) < size_of_headers { bytes_push(out, 0) }

    // ---- Section raw data ----
    // .text raw
    bytes_extend(out, code)
    while int_mod(bytes_len(out), file_align) != 0 { bytes_push(out, 0) }
    // .rdata raw
    bytes_extend(out, rdata)
    while int_mod(bytes_len(out), file_align) != 0 { bytes_push(out, 0) }
    // .data raw
    bytes_extend(out, data)
    while int_mod(bytes_len(out), file_align) != 0 { bytes_push(out, 0) }

    var w = oren_write_bytes(out_path, bytes_finalize(out))
    if oren_is_err(w) {
        print("x64 pe: failed to write: " + out_path)
        var code = oren_err_code(w)
        var msg = oren_err_msg(w)
        print("x64 pe: write error code=" + oren_int_to_string(code))
        if msg != nil { print("x64 pe: write error msg=" + msg) }
        oren_exit(1)
    }
    return nil
}
