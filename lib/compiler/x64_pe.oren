// PE32+ (Windows x64) emitter for x86_64 native backend bring-up.
//
// v0:
// - emits a PE executable with three sections: .text (RX), .rdata (R), .data (RW)
// - imports a small Win32 surface via an import table:
//   - KERNEL32.dll: ExitProcess, GetStdHandle, WriteFile, ReadFile, VirtualAlloc, VirtualFree, GetEnvironmentVariableA,
//                   GetEnvironmentStringsA, FreeEnvironmentStringsA, GetCommandLineW, WideCharToMultiByte, LocalFree,
//                   Sleep, GetSystemTimeAsFileTime, QueryPerformanceCounter, QueryPerformanceFrequency,
//                   CreateProcessA, WaitForSingleObject, GetExitCodeProcess, SetHandleInformation, CloseHandle
//                   LoadLibraryA, GetProcAddress
//   - SHELL32.dll: CommandLineToArgvW
// - entry stub calls main(), then ExitProcess(main_ret)
//
// This is intentionally small and self-contained (no external toolchain required).

import codegen "codegen_x64.oren"
import artifact "artifact_bytes.oren"
import abi "native_abi.oren"
import x64 "x64_core.oren"

fn bytes_new() { return artifact.bytes_new() }
fn bytes_push(b, v) { return artifact.bytes_push(b, v) }
fn bytes_extend(b, other) { return artifact.bytes_extend(b, other) }
fn bytes_extend_zeros(b, n) { return artifact.bytes_extend_zeros(b, n) }
fn bytes_extend_list(b, xs) { return artifact.bytes_extend_list(b, xs) }
fn bytes_extend_string(b, s) { return artifact.bytes_extend_string(b, s) }
fn bytes_extend_string_z(b, s) { return artifact.bytes_extend_string_z(b, s) }
fn bytes_len(b) { return artifact.bytes_len(b) }
fn bytes_finalize(b) { return artifact.bytes_finalize(b) }
fn push_u32_le(b, n) { return artifact.push_u32_le(b, n) }
fn push_u64_le(b, n) { return artifact.push_u64_le(b, n) }
fn set_u32_le(b, off, n) { return artifact.set_u32_le(b, off, n) }
fn set_u64_le(buf, offset, n) { return artifact.set_u64_le(buf, offset, n) }
fn int_mod(a, b) { return artifact.int_mod(a, b) }

fn push_pe_section_name(b, b0, b1, b2, b3, b4, b5, b6, b7) {
    bytes_push(b, b0)
    bytes_push(b, b1)
    bytes_push(b, b2)
    bytes_push(b, b3)
    bytes_push(b, b4)
    bytes_push(b, b5)
    bytes_push(b, b6)
    bytes_push(b, b7)
}

fn align_up(n, align) {
    return (n + align - 1) / align * align
}

fn _pe_decode_data_off(enc) {
    if oren_type_tag(enc) == 0 { return nil }
    return enc - 1
}

fn _pe_rtobj_decode_enc0(enc) {
    if oren_type_tag(enc) == 1 && enc > 0 { return enc - 1 }
    return 0
}

fn _pe_read_u64_le_u8(ub, off) {
    if ub == nil { return 0 }
    if oren_is_u8_buf(ub) != true { return 0 }
    var n = oren_buf_len(ub)
    if off < 0 || off + 8 > n { return 0 }
    var p = oren_buf_data_ptr_unchecked(ub)
    if p == 0 { return 0 }
    var b0 = ptr_get_byte(iadd(p, off + 0)) & 255
    var b1 = ptr_get_byte(iadd(p, off + 1)) & 255
    var b2 = ptr_get_byte(iadd(p, off + 2)) & 255
    var b3 = ptr_get_byte(iadd(p, off + 3)) & 255
    var b4 = ptr_get_byte(iadd(p, off + 4)) & 255
    var b5 = ptr_get_byte(iadd(p, off + 5)) & 255
    var b6 = ptr_get_byte(iadd(p, off + 6)) & 255
    var b7 = ptr_get_byte(iadd(p, off + 7)) & 255
    return (b7 << 56) | (b6 << 48) | (b5 << 40) | (b4 << 32) | (b3 << 24) | (b2 << 16) | (b1 << 8) | b0
}

fn _pe_read_u64_le_ptr(p, off) {
    var b0 = ptr_get_byte(iadd(p, off + 0)) & 255
    var b1 = ptr_get_byte(iadd(p, off + 1)) & 255
    var b2 = ptr_get_byte(iadd(p, off + 2)) & 255
    var b3 = ptr_get_byte(iadd(p, off + 3)) & 255
    var b4 = ptr_get_byte(iadd(p, off + 4)) & 255
    var b5 = ptr_get_byte(iadd(p, off + 5)) & 255
    var b6 = ptr_get_byte(iadd(p, off + 6)) & 255
    var b7 = ptr_get_byte(iadd(p, off + 7)) & 255
    return (b7 << 56) | (b6 << 48) | (b5 << 40) | (b4 << 32) | (b3 << 24) | (b2 << 16) | (b1 << 8) | b0
}

fn _pe_u64_sidecar_count(ub) {
    if ub == nil { return 0 }
    if oren_is_u8_buf(ub) != true { return 0 }
    var n = oren_buf_len(ub)
    if n <= 0 { return 0 }
    return n / 8
}

fn _pe_x64_runtime_fn_lookup_cached(ctx, base, name) {
    if ctx == nil || name == nil { return nil }
    var cached = ctx["runtime_x64_fn_offsets_lookup"]
    if cached != nil {
        var off0 = cached[name]
        if oren_type_tag(off0) != 0 { return off0 }
    } else {
        cached = {}
        ctx["runtime_x64_fn_offsets_lookup"] = cached
    }
    var comp = ctx["runtime_x64_fn_offsets_compact"]
    if comp == nil { return nil }
    var names = comp["names"]
    if names == nil { return nil }
    var offs = comp["offs_enc"]
    var i = 0
    var n = oren_list_len(names)
    while i < n {
        var nm = names[i]
        if nm == name {
            var off_enc = nil
            if offs != nil { off_enc = offs[i] }
            var off1 = base + _pe_rtobj_decode_enc0(off_enc)
            cached[name] = off1
            return off1
        }
        i = i + 1
    }
    return nil
}

fn _pe_x64_lookup_fn(ctx, functions, name) {
    var target = nil
    if name != nil && functions != nil { target = functions[name] }
    if oren_type_tag(target) != 0 { return target }
    if ctx == nil || name == nil { return nil }
    var base = ctx["runtime_x64_fn_offsets_base_code"]
    if base == nil { base = 0 }
    var off0 = _pe_x64_runtime_fn_lookup_cached(ctx, base, name)
    if oren_type_tag(off0) != 0 { return off0 }
    var enc_map = ctx["runtime_x64_fn_offsets_enc"]
    if enc_map != nil {
        var enc = enc_map[name]
        if oren_type_tag(enc) == 1 && enc > 0 { return base + (enc - 1) }
    }
    return nil
}

fn _pe_x64_lookup_fn_target_u8(ctx, functions, target_u8, names, i) {
    var base = 0
    if ctx != nil && ctx["runtime_x64_fn_offsets_base_code"] != nil { base = ctx["runtime_x64_fn_offsets_base_code"] }
    if target_u8 != nil {
        var enc = _pe_read_u64_le_u8(target_u8, i * 8)
        if enc > 0 { return base + enc - 1 }
    }
    var name = nil
    if names != nil { name = names[i] }
    return _pe_x64_lookup_fn(ctx, functions, name)
}

fn _pe_apply_x64_rtobj_rip_data_fixups(code, poss, offs, rtbase, text_rva, data_rva) {
    if poss == nil { return nil }
    var n = oren_list_len(poss)
    var i = 0
    while i < n {
        var disp_pos = rtbase + _pe_rtobj_decode_enc0(poss[i])
        var data_off = 0
        if offs != nil { data_off = _pe_rtobj_decode_enc0(offs[i]) }
        var insn_start = disp_pos - 3
        var next_rip = text_rva + (insn_start + 7)
        var target_rva = data_rva + data_off
        var disp = target_rva - next_rip
        if disp < 0 { disp = 4294967296 + disp }
        set_u32_le(code, disp_pos, disp)
        i = i + 1
    }
    return nil
}

fn _pe_apply_x64_rtobj_rip_data_fixups_u8(code, poss_u8, offs_u8, rtbase, text_rva, data_rva) {
    if poss_u8 == nil { return false }
    var n = _pe_u64_sidecar_count(poss_u8)
    var i = 0
    while i < n {
        var disp_pos = rtbase + _pe_read_u64_le_u8(poss_u8, i * 8)
        var data_off = 0
        if offs_u8 != nil { data_off = _pe_read_u64_le_u8(offs_u8, i * 8) }
        var insn_start = disp_pos - 3
        var next_rip = text_rva + (insn_start + 7)
        var target_rva = data_rva + data_off
        var disp = target_rva - next_rip
        if disp < 0 { disp = 4294967296 + disp }
        set_u32_le(code, disp_pos, disp)
        i = i + 1
    }
    return true
}

fn _pe_apply_x64_rtobj_call_fixups(ctx, code, poss, names, rtbase, functions) {
    if poss == nil { return nil }
    var n = oren_list_len(poss)
    var i = 0
    while i < n {
        var name = nil
        if names != nil { name = names[i] }
        var target = _pe_x64_lookup_fn(ctx, functions, name)
        if target == nil {
            print("x64 pe: undefined function " + name)
            oren_exit(1)
        }
        var pos = rtbase + _pe_rtobj_decode_enc0(poss[i])
        var disp = target - (pos + 5)
        if disp < 0 { disp = 4294967296 + disp }
        set_u32_le(code, pos + 1, disp)
        i = i + 1
    }
    return nil
}

fn _pe_apply_x64_rtobj_call_fixups_u8(ctx, code, poss_u8, target_u8, names, rtbase, functions) {
    if poss_u8 == nil { return false }
    var n = _pe_u64_sidecar_count(poss_u8)
    var poss_p = oren_buf_data_ptr_unchecked(poss_u8)
    if poss_p == 0 { return false }
    var target_p = 0
    if target_u8 != nil && _pe_u64_sidecar_count(target_u8) >= n {
        target_p = oren_buf_data_ptr_unchecked(target_u8)
    }
    var base = 0
    if ctx != nil && ctx["runtime_x64_fn_offsets_base_code"] != nil { base = ctx["runtime_x64_fn_offsets_base_code"] }
    var i = 0
    while i < n {
        var target = nil
        var off = i * 8
        if target_p != 0 {
            var enc = _pe_read_u64_le_ptr(target_p, off)
            if enc > 0 { target = base + enc - 1 }
        }
        if target == nil {
            var name0 = nil
            if names != nil { name0 = names[i] }
            target = _pe_x64_lookup_fn(ctx, functions, name0)
        }
        if target == nil {
            var name = ""
            if names != nil { name = names[i] }
            print("x64 pe: undefined function " + name)
            oren_exit(1)
        }
        var pos = rtbase + _pe_read_u64_le_ptr(poss_p, off)
        var disp = target - (pos + 5)
        if disp < 0 { disp = 4294967296 + disp }
        set_u32_le(code, pos + 1, disp)
        i = i + 1
    }
    return true
}

fn _pe_apply_x64_rtobj_code_lea_fixups(ctx, code, poss, names, rtbase, functions, text_rva) {
    if poss == nil { return nil }
    var n = oren_list_len(poss)
    var i = 0
    while i < n {
        var name = nil
        if names != nil { name = names[i] }
        var target = _pe_x64_lookup_fn(ctx, functions, name)
        if target == nil {
            print("x64 pe: undefined function " + name)
            oren_exit(1)
        }
        var disp_pos = rtbase + _pe_rtobj_decode_enc0(poss[i])
        var insn_start = disp_pos - 3
        var next_rip = text_rva + (insn_start + 7)
        var target_rva = text_rva + target
        var disp = target_rva - next_rip
        if disp < 0 { disp = 4294967296 + disp }
        set_u32_le(code, disp_pos, disp)
        i = i + 1
    }
    return nil
}

fn _pe_apply_x64_rtobj_code_lea_fixups_u8(ctx, code, poss_u8, target_u8, names, rtbase, functions, text_rva) {
    if poss_u8 == nil { return false }
    var n = _pe_u64_sidecar_count(poss_u8)
    var i = 0
    while i < n {
        var target = _pe_x64_lookup_fn_target_u8(ctx, functions, target_u8, names, i)
        if target == nil {
            var name = ""
            if names != nil { name = names[i] }
            print("x64 pe: undefined function " + name)
            oren_exit(1)
        }
        var disp_pos = rtbase + _pe_read_u64_le_u8(poss_u8, i * 8)
        var insn_start = disp_pos - 3
        var next_rip = text_rva + (insn_start + 7)
        var target_rva = text_rva + target
        var disp = target_rva - next_rip
        if disp < 0 { disp = 4294967296 + disp }
        set_u32_le(code, disp_pos, disp)
        i = i + 1
    }
    return true
}

fn _pe_apply_x64_rtobj_fnobj_fixups(ctx, data, offs, names, functions, image_base, text_rva) {
    if offs == nil { return nil }
    var n = oren_list_len(offs)
    var i = 0
    while i < n {
        var name = nil
        if names != nil { name = names[i] }
        var target = _pe_x64_lookup_fn(ctx, functions, name)
        if target == nil {
            print("x64 pe: undefined function " + name)
            oren_exit(1)
        }
        var data_off = _pe_rtobj_decode_enc0(offs[i])
        set_u64_le(data, data_off, image_base + text_rva + target)
        i = i + 1
    }
    return nil
}

fn _pe_apply_x64_rtobj_fnobj_fixups_u8(ctx, data, offs_u8, target_u8, names, functions, image_base, text_rva) {
    if offs_u8 == nil { return false }
    var n = _pe_u64_sidecar_count(offs_u8)
    var i = 0
    while i < n {
        var target = _pe_x64_lookup_fn_target_u8(ctx, functions, target_u8, names, i)
        if target == nil {
            var name = ""
            if names != nil { name = names[i] }
            print("x64 pe: undefined function " + name)
            oren_exit(1)
        }
        var data_off = _pe_read_u64_le_u8(offs_u8, i * 8)
        set_u64_le(data, data_off, image_base + text_rva + target)
        i = i + 1
    }
    return true
}

fn _pe_apply_x64_rtobj_compact_fixups(ctx, code, data, functions, image_base, text_rva, data_rva) {
    if ctx == nil { return nil }
    var fx = ctx["runtime_x64_fixups_compact"]
    if fx == nil { return nil }
    var fx_u8 = ctx["runtime_x64_fixups_compact_u8"]
    var rtbase = ctx["runtime_x64_fixups_base_code"]
    if rtbase == nil { rtbase = 0 }
    var used_u8_call = false
    if fx_u8 != nil { used_u8_call = _pe_apply_x64_rtobj_call_fixups_u8(ctx, code, fx_u8["x64_call_pos_u8"], fx_u8["x64_call_target_u8"], fx["call_name"], rtbase, functions) }
    if used_u8_call != true { _pe_apply_x64_rtobj_call_fixups(ctx, code, fx["call_pos_enc"], fx["call_name"], rtbase, functions) }
    var used_u8_data = false
    if fx_u8 != nil { used_u8_data = _pe_apply_x64_rtobj_rip_data_fixups_u8(code, fx_u8["x64_rip_data_pos_u8"], fx_u8["x64_rip_data_off_u8"], rtbase, text_rva, data_rva) }
    if used_u8_data != true { _pe_apply_x64_rtobj_rip_data_fixups(code, fx["rip_data_lea_pos_enc"], fx["rip_data_lea_data_off_enc"], rtbase, text_rva, data_rva) }
    var used_u8_data_rsi = false
    if fx_u8 != nil { used_u8_data_rsi = _pe_apply_x64_rtobj_rip_data_fixups_u8(code, fx_u8["x64_rip_data_rsi_pos_u8"], fx_u8["x64_rip_data_rsi_off_u8"], rtbase, text_rva, data_rva) }
    if used_u8_data_rsi != true { _pe_apply_x64_rtobj_rip_data_fixups(code, fx["rip_data_lea_rsi_pos_enc"], fx["rip_data_lea_rsi_data_off_enc"], rtbase, text_rva, data_rva) }
    var used_u8_mov = false
    if fx_u8 != nil { used_u8_mov = _pe_apply_x64_rtobj_rip_data_fixups_u8(code, fx_u8["x64_rip_mov_rax_pos_u8"], fx_u8["x64_rip_mov_rax_off_u8"], rtbase, text_rva, data_rva) }
    if used_u8_mov != true { _pe_apply_x64_rtobj_rip_data_fixups(code, fx["rip_data_mov_rax_pos_enc"], fx["rip_data_mov_rax_data_off_enc"], rtbase, text_rva, data_rva) }
    var used_u8_rdata = false
    if fx_u8 != nil { used_u8_rdata = _pe_apply_x64_rtobj_rip_data_fixups_u8(code, fx_u8["x64_rip_rdata_pos_u8"], fx_u8["x64_rip_rdata_off_u8"], rtbase, text_rva, data_rva) }
    if used_u8_rdata != true { _pe_apply_x64_rtobj_rip_data_fixups(code, fx["rip_rdata_lea_pos_enc"], fx["rip_rdata_lea_data_off_enc"], rtbase, text_rva, data_rva) }
    var used_u8_fnobj = false
    if fx_u8 != nil { used_u8_fnobj = _pe_apply_x64_rtobj_fnobj_fixups_u8(ctx, data, fx_u8["x64_fnobj_data_off_u8"], fx_u8["x64_fnobj_target_u8"], fx["data_fnobj_code_ptr_name"], functions, image_base, text_rva) }
    if used_u8_fnobj != true { _pe_apply_x64_rtobj_fnobj_fixups(ctx, data, fx["data_fnobj_code_ptr_data_off_enc"], fx["data_fnobj_code_ptr_name"], functions, image_base, text_rva) }
    var used_u8_code = false
    if fx_u8 != nil { used_u8_code = _pe_apply_x64_rtobj_code_lea_fixups_u8(ctx, code, fx_u8["x64_code_lea_pos_u8"], fx_u8["x64_code_lea_target_u8"], fx["rip_code_lea_name"], rtbase, functions, text_rva) }
    if used_u8_code != true { _pe_apply_x64_rtobj_code_lea_fixups(ctx, code, fx["rip_code_lea_pos_enc"], fx["rip_code_lea_name"], rtbase, functions, text_rva) }
    return nil
}

fn _pe_apply_x64_call_rel32_positions(ctx, code, functions, name, poss) {
    if poss == nil { return nil }
    var target = nil
    if ctx != nil {
        if name == "oren_call_depth_enter" {
            var enter_target = ctx["runtime_x64_call_depth_enter_off"]
            if oren_type_tag(enter_target) != 0 { target = enter_target }
        } else if name == "oren_call_depth_exit" {
            var exit_target = ctx["runtime_x64_call_depth_exit_off"]
            if oren_type_tag(exit_target) != 0 { target = exit_target }
        }
    }
    if target == nil { target = _pe_x64_lookup_fn(ctx, functions, name) }
    if target == nil {
        print("x64 pe: undefined function " + name)
        oren_exit(1)
    }
    var i = 0
    var n = oren_list_len(poss)
    while i < n {
        var pos = poss[i]
        var disp = target - (pos + 5)
        if disp < 0 { disp = 4294967296 + disp }
        set_u32_le(code, pos + 1, disp)
        i = i + 1
    }
    return nil
}

fn _pe_emit_export_wrappers_x64(code, fixups, functions, export_names, heap_limit_off, heap_ptr_off) {
    // Export ABI bridge (Tier‑1):
    //
    // x64 native uses r14/r15 as global heap registers across intra-Oren calls. That violates
    // platform ABIs at external boundaries (C callers expect r14/r15 preserved). Emit a small
    // wrapper per exported symbol that:
    // - saves caller r14/r15,
    // - loads heap state from `.data` spill slots into r14/r15,
    // - calls the internal function by name,
    // - stores updated heap regs back to `.data`,
    // - restores caller r14/r15 and returns.
    //
    // The wrapper keeps the same call ABI for arguments/return (registers untouched).
    if export_names == nil || oren_list_len(export_names) == 0 { return {} }
    if heap_limit_off == nil || heap_ptr_off == nil {
        print("x64 pe: missing heap spill slots in ctx (heap_limit_slot_enc/heap_ptr_slot_enc)")
        oren_exit(1)
    }

    var exps = _pe_sort_export_names(export_names)
    var out = {}
    var n = oren_list_len(exps)
    var i = 0
    while i < n {
        var nm = exps[i]
        if nm == nil || nm == "" { i = i + 1; continue }
        // Validate internal symbol exists (avoid emitting dead wrappers).
        if functions[nm] == nil {
            print("x64 pe: @ffi.export requested for missing function: " + nm)
            print("  hint: add @oren.keep to prevent whole-program DCE from removing it")
            oren_exit(1)
        }

        var wrapper_off = bytes_len(code)
        out[nm] = wrapper_off

        // Prologue: save heap regs and align for nested calls.
        bytes_extend(code, x64.insn_push_r64(15))
        bytes_extend(code, x64.insn_push_r64(14))
        // 32B shadow + 8B align (Win64): keep RSP 16B-aligned before call.
        bytes_extend(code, x64.insn_sub_rsp_imm8(40))

        // r11 = &heap_limit_slot; r14 = *r11
        var lea_hl = bytes_len(code)
        bytes_extend(code, x64.insn_lea_r64_rip_disp32(11, 0))
        oren_list_push(fixups, {"type": "rip_data_lea", "pos": lea_hl + 3, "data_off": heap_limit_off})
        bytes_extend(code, x64.insn_mov_r64_mr64(14, 11))

        // r11 = &heap_ptr_slot; r15 = *r11
        var lea_hp = bytes_len(code)
        bytes_extend(code, x64.insn_lea_r64_rip_disp32(11, 0))
        oren_list_push(fixups, {"type": "rip_data_lea", "pos": lea_hp + 3, "data_off": heap_ptr_off})
        bytes_extend(code, x64.insn_mov_r64_mr64(15, 11))

        // call internal function (same argument registers/stack layout)
        var call_pos = bytes_len(code)
        bytes_extend(code, x64.insn_call_rel32(0))
        oren_list_push(fixups, {"type": "call_rel32", "pos": call_pos, "name": nm})

        // Store updated heap regs back to slots.
        lea_hl = bytes_len(code)
        bytes_extend(code, x64.insn_lea_r64_rip_disp32(11, 0))
        oren_list_push(fixups, {"type": "rip_data_lea", "pos": lea_hl + 3, "data_off": heap_limit_off})
        bytes_extend(code, x64.insn_mov_mr64_r64(11, 14))

        lea_hp = bytes_len(code)
        bytes_extend(code, x64.insn_lea_r64_rip_disp32(11, 0))
        oren_list_push(fixups, {"type": "rip_data_lea", "pos": lea_hp + 3, "data_off": heap_ptr_off})
        bytes_extend(code, x64.insn_mov_mr64_r64(11, 15))

        // Epilogue: restore stack + heap regs and return.
        bytes_extend(code, x64.insn_add_rsp_imm8(40))
        bytes_extend(code, x64.insn_pop_r64(14))
        bytes_extend(code, x64.insn_pop_r64(15))
        bytes_extend(code, x64.insn_ret())

        i = i + 1
    }
    return out
}

fn push_u16_le(buf, n) {
    return artifact.push_u16_le(buf, n)
}

fn push_u8_n(buf, v, n) {
    var i = 0
    while i < n { bytes_push(buf, v); i = i + 1 }
}

fn push_ascii_z(buf, s) {
    // Avoid an intermediate byte carrier in hot emitter paths.
    // Import table construction calls this many times and must stay fast.
    bytes_extend_string_z(buf, s)
    return nil
}

fn _pe_align(buf, align) {
    if buf == nil { return nil }
    if align <= 1 { return nil }
    var rem = int_mod(bytes_len(buf), align)
    if rem != 0 { bytes_extend_zeros(buf, align - rem) }
    return nil
}

fn _pe_pad_to_len(buf, target_len) {
    if buf == nil { return nil }
    if target_len == nil { return nil }
    var used = bytes_len(buf)
    if target_len > used { bytes_extend_zeros(buf, target_len - used) }
    return nil
}

fn _pe_reserve_u64_zeros(buf, count) {
    if buf == nil { return nil }
    if count <= 0 { return nil }
    bytes_extend_zeros(buf, count * 8)
    return nil
}

fn _pe_path_basename(p) {
    if p == nil { return "oren.exe" }
    var n = oren_string_len(p)
    var last = -1
    var i = 0
    while i < n {
        var c = oren_string_byte_at_unchecked(p, i) & 255
        // '/' or '\\'
        if c == 47 || c == 92 { last = i }
        i = i + 1
    }
    var start = last + 1
    if start < 0 { start = 0 }
    if start >= n { return p }
    return oren_string_slice(p, start, n)
}

fn _pe_str_lt_bytes(a, b) {
    if a == nil && b == nil { return false }
    if a == nil { return true }
    if b == nil { return false }
    var i = 0
    while 1 {
        var ca = oren_string_byte_at_unchecked(a, i) & 255
        var cb = oren_string_byte_at_unchecked(b, i) & 255
        if ca == 0 && cb == 0 { return false }
        if ca == 0 { return true }
        if cb == 0 { return false }
        if ca < cb { return true }
        if ca > cb { return false }
        i = i + 1
        if i > 512 { return false } // bound
    }
}

fn _pe_sort_export_names(names) {
    // Stable, bounded insertion sort by ASCII bytes (case-sensitive).
    // PE export name tables are expected to be sorted for GetProcAddress lookups.
    var out = []
    if names == nil { return out }
    var seen = {}
    var i = 0
    while i < oren_list_len(names) {
        var s = names[i]
        if s != nil && s != "" && seen[s] == nil {
            seen[s] = true
            oren_list_push(out, s)
            var k = oren_list_len(out) - 1
            while k > 0 && _pe_str_lt_bytes(out[k], out[k - 1]) {
                var tmp = out[k - 1]
                out[k - 1] = out[k]
                out[k] = tmp
                k = k - 1
            }
        }
        i = i + 1
    }
    return out
}

fn pe_emit_program_x64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, call_depth_max, capsule, cap_allow_domains) {
    // Bounded timing summary for diagnosing x64 Windows build throughput without huge logs.
    // Enable with: OREN_TRACE_X64_EMIT_SUMMARY=1
    var trace_sum = oren_env("OREN_TRACE_X64_EMIT_SUMMARY") != nil
    var t0 = 0
    var t_compile_done = 0
    var t_rdata_done = 0
    var t_fix_done = 0
    var t_write_done = 0
    if trace_sum { t0 = oren_time_now_ns() }

    var ctx = codegen.native_compile_program_x64(linked, {"os": "windows", "arch": "x64", "debug": debug_mode, "no_gc": no_gc, "call_depth_max": call_depth_max, "capsule": capsule, "cap_allow_domains": cap_allow_domains, "link_libs": link_libs, "shared_lib": is_shared_lib == true})
    if ctx == nil { return nil }
    codegen.native_emit_errors_and_exit(ctx)
    if trace_sum { t_compile_done = oren_time_now_ns() }

    var code = ctx["code"]
    var user_data = ctx["data"]
    var fixups = ctx["fixups"]
    var functions = ctx["functions"]

    // Export wrappers (Tier‑1 ABI bridge): use heap spill slots reserved by the code generator.
    var heap_limit_off = _pe_decode_data_off(ctx["heap_limit_slot_enc"])
    var heap_ptr_off = _pe_decode_data_off(ctx["heap_ptr_slot_enc"])
    var export_wrappers = _pe_emit_export_wrappers_x64(code, fixups, functions, export_names, heap_limit_off, heap_ptr_off)

    // ---- Build .rdata (import table) ----
    //
    // Layout in .rdata:
    //   import_desc[D+1] (D DLLs + null)
    //   ILT per DLL (N+1 entries)
    //   IAT per DLL (N+1 entries)
    //   hint/name for each imported func
    //   dll name strings
    //   (no user data; user data lives in `.data` so `.rdata` can stay read-only)
    //
    // We record offsets for RVAs and patch descriptors later.
    var rdata = bytes_new()

    var off_import_desc = bytes_len(rdata)
    // 5 descriptors * 20 bytes: kernel32 + kernelbase + ws2_32 + shell32 + null
    push_u8_n(rdata, 0, 100)

    var kernel32_funcs = [
        "ExitProcess",
        "GetStdHandle",
        "WriteFile",
        "ReadFile",
        // File I/O substrate (CreateFileA-based `sys_open` for native runtime injection).
        // Added at the end of the table so existing IAT offsets remain stable.
        "VirtualAlloc",
        "GetEnvironmentVariableA",
        "GetEnvironmentStringsA",
        "GetCommandLineW",
        "WideCharToMultiByte",
        "LocalFree",
        // TIME substrate
        "Sleep",
        "GetSystemTimeAsFileTime",
        "QueryPerformanceCounter",
        // PROC substrate (CreateProcessA spawn+wait)
        "CreateProcessA",
        "WaitForSingleObject",
        "GetExitCodeProcess",
        // Ensure inherited std handles are inheritable when launched under OpenSSH (pipe stdio).
        "SetHandleInformation",
        // Handle closing (used by sys_close fallback for non-socket handles).
        "CloseHandle",
        // THREAD substrate (CreateThread spawn+join/terminate)
        "CreateThread",
        "TerminateThread",
        "CreateFileA",
        // FS substrate (Win32 API shims, capsule-safe syscalls)
        "GetLastError",
        "GetFileAttributesA",
        "DeleteFileA",
        "RemoveDirectoryA",
        "CreateDirectoryA",
        "MoveFileExA",
        "SetFileAttributesA",
        // Stat helpers (Tier‑1): keep at end to preserve existing IAT offsets.
        "GetFileAttributesExA",
        "GetFileSizeEx",
        // ENV block freeing (used after copying env strings into runtime-owned memory).
        // Keep at end to preserve existing IAT offsets.
        "FreeEnvironmentStringsA",
        // Thread identity (Tier‑1 Windows): used by the native runtime lock implementation.
        // Keep at end to preserve existing IAT offsets.
        "GetCurrentThreadId",
        // mmap/munmap substrate (used by runtime alloc-index table and typed buffers).
        // Keep VirtualFree at its existing IAT offset; append new imports below.
        "VirtualFree",
        // FFI (Tier‑1): lazy DLL symbol resolution for `ffi name` stubs.
        "LoadLibraryA",
        "GetProcAddress",
        // TIME calibration (Tier‑1 Windows): QPC ticks/sec.
        // Keep at end to preserve existing IAT offsets.
        "QueryPerformanceFrequency",
        // IOCP substrate (future Windows netpoll backend). Keep appended to preserve existing offsets.
        "CreateIoCompletionPort",
        "GetQueuedCompletionStatusEx",
        "PostQueuedCompletionStatus",
        "CancelIoEx"
    ]
    // Wait-on-address primitive (Tier‑1 Windows): used by the native runtime lock implementation.
    //
    // NOTE: on modern Windows builds these entrypoints live in KERNELBASE.dll (not KERNEL32.dll).
    // Importing them from KERNEL32.dll can cause STATUS_ENTRYPOINT_NOT_FOUND at process start.
    var kernelbase_funcs = [
        "WaitOnAddress",
        "WakeByAddressAll"
    ]
    // WinSock NET substrate (WS2_32.dll).
    // Keep this list minimal and explicit so the IAT label mapping below stays auditable.
    var ws2_32_funcs = [
        "WSAStartup",
        "WSAGetLastError",
        "socket",
        "connect",
        "bind",
        "listen",
        "accept",
        "sendto",
        "recvfrom",
        "getsockname",
        "getpeername",
        "setsockopt",
        "getsockopt",
        "shutdown",
        "closesocket",
        "ioctlsocket",
        "select",
        // Overlapped I/O (IOCP bring-up; completion-based NET ops). Keep appended to preserve existing offsets.
        "WSARecv",
        "WSASend",
        "WSARecvFrom"
    ]
    var shell32_funcs = ["CommandLineToArgvW"]
    var n_k32 = oren_list_len(kernel32_funcs)
    var n_kb = oren_list_len(kernelbase_funcs)
    var n_ws2 = oren_list_len(ws2_32_funcs)
    var n_s32 = oren_list_len(shell32_funcs)

    // Align to 8 for thunk arrays.
    _pe_align(rdata, 8)
    var off_ilt_k32 = bytes_len(rdata)
    // ILT(KERNEL32): imports + null entry
    _pe_reserve_u64_zeros(rdata, n_k32 + 1)

    _pe_align(rdata, 8)
    var off_ilt_kb = bytes_len(rdata)
    // ILT(KERNELBASE): imports + null entry
    _pe_reserve_u64_zeros(rdata, n_kb + 1)

    _pe_align(rdata, 8)
    var off_ilt_ws2 = bytes_len(rdata)
    // ILT(WS2_32): imports + null entry
    _pe_reserve_u64_zeros(rdata, n_ws2 + 1)

    _pe_align(rdata, 8)
    var off_ilt_s32 = bytes_len(rdata)
    // ILT(SHELL32): imports + null entry
    _pe_reserve_u64_zeros(rdata, n_s32 + 1)

    _pe_align(rdata, 8)
    var off_iat_k32 = bytes_len(rdata)
    // IAT(KERNEL32): imports + null entry
    _pe_reserve_u64_zeros(rdata, n_k32 + 1)

    _pe_align(rdata, 8)
    var off_iat_kb = bytes_len(rdata)
    // IAT(KERNELBASE): imports + null entry
    _pe_reserve_u64_zeros(rdata, n_kb + 1)

    _pe_align(rdata, 8)
    var off_iat_ws2 = bytes_len(rdata)
    // IAT(WS2_32): imports + null entry
    _pe_reserve_u64_zeros(rdata, n_ws2 + 1)

    _pe_align(rdata, 8)
    var off_iat_s32 = bytes_len(rdata)
    // IAT(SHELL32): imports + null entry
    _pe_reserve_u64_zeros(rdata, n_s32 + 1)

    // Hint/Name entries (collect offsets by symbol name).
    var hn_offs = {}
    var i0 = 0
    while i0 < n_k32 {
        var nm = kernel32_funcs[i0]
        hn_offs[nm] = bytes_len(rdata)
        push_u16_le(rdata, 0)
        push_ascii_z(rdata, nm)
        _pe_align(rdata, 2)
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_kb {
        var nm_kb = kernelbase_funcs[i0]
        hn_offs[nm_kb] = bytes_len(rdata)
        push_u16_le(rdata, 0)
        push_ascii_z(rdata, nm_kb)
        _pe_align(rdata, 2)
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_ws2 {
        var nmw = ws2_32_funcs[i0]
        hn_offs[nmw] = bytes_len(rdata)
        push_u16_le(rdata, 0)
        push_ascii_z(rdata, nmw)
        _pe_align(rdata, 2)
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_s32 {
        var nm2 = shell32_funcs[i0]
        hn_offs[nm2] = bytes_len(rdata)
        push_u16_le(rdata, 0)
        push_ascii_z(rdata, nm2)
        _pe_align(rdata, 2)
        i0 = i0 + 1
    }

    var off_dll_k32 = bytes_len(rdata)
    push_ascii_z(rdata, "KERNEL32.dll")
    var off_dll_kb = bytes_len(rdata)
    push_ascii_z(rdata, "KERNELBASE.dll")
    var off_dll_ws2 = bytes_len(rdata)
    push_ascii_z(rdata, "WS2_32.dll")
    var off_dll_s32 = bytes_len(rdata)
    push_ascii_z(rdata, "SHELL32.dll")

    // Section layout constants.
    var file_align = 512
    var sect_align = 4096
    var image_base = abi.x64_v0_windows_pe_image_base()

    // We'll use:
    //   .text RVA 0x1000
    //   .rdata RVA aligned after .text (SectAlign pages)
    //
    // NOTE: .rdata must not overlap .text in virtual address space. When .text grows beyond
    // 1 page, the next section RVA must advance accordingly (Windows loader rejects overlap).
    var text_rva = abi.x64_v0_windows_text_rva()
    var text_vsize = bytes_len(code)
    var rdata_rva = text_rva + align_up(text_vsize, sect_align)
    // `.data` follows `.rdata` (SectAlign pages).
    // `.rdata` contains the import table (+ optional export table when `@ffi.export` is used).
    var data_rva = 0

    // Patch thunk entries with RVA to hint/name.
    i0 = 0
    while i0 < n_k32 {
        var nm3 = kernel32_funcs[i0]
        var hn_rva = rdata_rva + hn_offs[nm3]
        set_u32_le(rdata, off_ilt_k32 + i0 * 8, hn_rva)
        set_u32_le(rdata, off_iat_k32 + i0 * 8, hn_rva)
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_kb {
        var nm3_kb = kernelbase_funcs[i0]
        var hn_rva_kb = rdata_rva + hn_offs[nm3_kb]
        set_u32_le(rdata, off_ilt_kb + i0 * 8, hn_rva_kb)
        set_u32_le(rdata, off_iat_kb + i0 * 8, hn_rva_kb)
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_ws2 {
        var nmw2 = ws2_32_funcs[i0]
        var hn_rva_w = rdata_rva + hn_offs[nmw2]
        set_u32_le(rdata, off_ilt_ws2 + i0 * 8, hn_rva_w)
        set_u32_le(rdata, off_iat_ws2 + i0 * 8, hn_rva_w)
        i0 = i0 + 1
    }
    i0 = 0
    while i0 < n_s32 {
        var nm4 = shell32_funcs[i0]
        var hn_rva2 = rdata_rva + hn_offs[nm4]
        set_u32_le(rdata, off_ilt_s32 + i0 * 8, hn_rva2)
        set_u32_le(rdata, off_iat_s32 + i0 * 8, hn_rva2)
        i0 = i0 + 1
    }

    // Patch import descriptors.
    //
    // IMAGE_IMPORT_DESCRIPTOR (20 bytes):
    //   0: OriginalFirstThunk (RVA ILT)
    //   4: TimeDateStamp (0)
    //   8: ForwarderChain (0)
    //  12: Name (RVA dll name)
    //  16: FirstThunk (RVA IAT)
    var dll_k32_rva = rdata_rva + off_dll_k32
    set_u32_le(rdata, off_import_desc + 0, rdata_rva + off_ilt_k32)
    set_u32_le(rdata, off_import_desc + 12, dll_k32_rva)
    set_u32_le(rdata, off_import_desc + 16, rdata_rva + off_iat_k32)

    // second descriptor (+20): KERNELBASE.dll
    var dll_kb_rva = rdata_rva + off_dll_kb
    set_u32_le(rdata, off_import_desc + 20 + 0, rdata_rva + off_ilt_kb)
    set_u32_le(rdata, off_import_desc + 20 + 12, dll_kb_rva)
    set_u32_le(rdata, off_import_desc + 20 + 16, rdata_rva + off_iat_kb)

    var dll_ws2_rva = rdata_rva + off_dll_ws2
    // third descriptor (+40): WS2_32.dll
    set_u32_le(rdata, off_import_desc + 40 + 0, rdata_rva + off_ilt_ws2)
    set_u32_le(rdata, off_import_desc + 40 + 12, dll_ws2_rva)
    set_u32_le(rdata, off_import_desc + 40 + 16, rdata_rva + off_iat_ws2)

    var dll_s32_rva = rdata_rva + off_dll_s32
    // fourth descriptor (+60): SHELL32.dll
    set_u32_le(rdata, off_import_desc + 60 + 0, rdata_rva + off_ilt_s32)
    set_u32_le(rdata, off_import_desc + 60 + 12, dll_s32_rva)
    set_u32_le(rdata, off_import_desc + 60 + 16, rdata_rva + off_iat_s32)

    var import_dir_rva = rdata_rva + off_import_desc
    var import_dir_size = 100

    // ---- Optional PE export table (executables + DLLs) ----
    //
    // This allows `GetProcAddress(GetModuleHandle(NULL), "name")` to locate top-level
    // functions marked `@ffi.export` (used by callback-style interop).
    //
    var export_dir_rva = 0
    var export_dir_size = 0
    if export_names != nil && oren_list_len(export_names) != 0 {
        var exps = _pe_sort_export_names(export_names)
        var n_exp = oren_list_len(exps)
        if n_exp != 0 {
            // Align to 4 for export tables.
            _pe_align(rdata, 4)

            var off_exp_dir = bytes_len(rdata)
            // IMAGE_EXPORT_DIRECTORY (40 bytes)
            push_u8_n(rdata, 0, 40)
            _pe_align(rdata, 4)

            var off_eat = bytes_len(rdata)
            var ei = 0
            while ei < n_exp {
                var nm = exps[ei]
                var fn_off = export_wrappers[nm]
                if fn_off == nil { fn_off = functions[nm] }
                if fn_off == nil {
                    print("x64 pe: @ffi.export requested for missing function: " + nm)
                    print("  hint: add @oren.keep to prevent whole-program DCE from removing it")
                    oren_exit(1)
                }
                // Export Address Table uses RVAs.
                push_u32_le(rdata, text_rva + fn_off)
                ei = ei + 1
            }

            var off_name_ptrs = bytes_len(rdata)
            bytes_extend_zeros(rdata, n_exp * 4)

            var off_ordinals = bytes_len(rdata)
            ei = 0
            while ei < n_exp { push_u16_le(rdata, ei); ei = ei + 1 }
            _pe_align(rdata, 4)

            var off_mod_name = bytes_len(rdata)
            push_ascii_z(rdata, _pe_path_basename(out_path))

            // Export name strings (and patch name pointer table).
            ei = 0
            while ei < n_exp {
                var off_nm = bytes_len(rdata)
                push_ascii_z(rdata, exps[ei])
                set_u32_le(rdata, off_name_ptrs + ei * 4, rdata_rva + off_nm)
                ei = ei + 1
            }

            // Patch IMAGE_EXPORT_DIRECTORY fields.
            // Layout:
            //   0  Characteristics (u32)
            //   4  TimeDateStamp (u32)
            //   8  MajorVersion (u16)
            //   10 MinorVersion (u16)
            //   12 Name (u32 RVA)
            //   16 Base (u32)
            //   20 NumberOfFunctions (u32)
            //   24 NumberOfNames (u32)
            //   28 AddressOfFunctions (u32 RVA)
            //   32 AddressOfNames (u32 RVA)
            //   36 AddressOfNameOrdinals (u32 RVA)
            set_u32_le(rdata, off_exp_dir + 12, rdata_rva + off_mod_name)
            set_u32_le(rdata, off_exp_dir + 16, 1)
            set_u32_le(rdata, off_exp_dir + 20, n_exp)
            set_u32_le(rdata, off_exp_dir + 24, n_exp)
            set_u32_le(rdata, off_exp_dir + 28, rdata_rva + off_eat)
            set_u32_le(rdata, off_exp_dir + 32, rdata_rva + off_name_ptrs)
            set_u32_le(rdata, off_exp_dir + 36, rdata_rva + off_ordinals)

            export_dir_rva = rdata_rva + off_exp_dir
            export_dir_size = bytes_len(rdata) - off_exp_dir
        }
    }

    // Now that `.rdata` is final, compute `.data` RVA.
    data_rva = rdata_rva + align_up(bytes_len(rdata), sect_align)
    if trace_sum { t_rdata_done = oren_time_now_ns() }

    // ---- Build `.data` (user data blob) ----
    //
    // This contains:
    // - string literals
    // - fnobj records (function values)
    // - symtab / debug tables
    // - mutable globals (e.g. call depth counters)
    //
    // Keep it 8-byte aligned for u64 tables.
    var data = bytes_new()
    if user_data != nil { bytes_extend(data, user_data) }
    _pe_align(data, 8)

    // ---- Apply code fixups (rel32 call + rip-relative IAT load) ----
    //
    // For PE, all code addresses are RVAs within .text section.
    // We patch:
    // - call rel32 to main
    // - mov rax, [rip+disp32] to read IAT ExitProcess slot
    //
    // PERF:
    // Build a label->offset map once to avoid a large if/else chain for each fixup.
    // Encode offsets as (off+1) so offset 0 is representable while still using `nil` as the
    // sentinel for "missing key" (call sites decode with `enc-1`).
    var iat_offs = {}
    // KERNEL32.dll IAT slots (order matches kernel32_funcs above)
    iat_offs["IAT_ExitProcess"] = off_iat_k32 + 0 + 1
    iat_offs["IAT_GetStdHandle"] = off_iat_k32 + 8 + 1
    iat_offs["IAT_WriteFile"] = off_iat_k32 + 16 + 1
    iat_offs["IAT_ReadFile"] = off_iat_k32 + 24 + 1
    iat_offs["IAT_VirtualAlloc"] = off_iat_k32 + 32 + 1
    iat_offs["IAT_GetEnvironmentVariableA"] = off_iat_k32 + 40 + 1
    iat_offs["IAT_GetEnvironmentStringsA"] = off_iat_k32 + 48 + 1
    iat_offs["IAT_GetCommandLineW"] = off_iat_k32 + 56 + 1
    iat_offs["IAT_WideCharToMultiByte"] = off_iat_k32 + 64 + 1
    iat_offs["IAT_LocalFree"] = off_iat_k32 + 72 + 1
    iat_offs["IAT_Sleep"] = off_iat_k32 + 80 + 1
    iat_offs["IAT_GetSystemTimeAsFileTime"] = off_iat_k32 + 88 + 1
    iat_offs["IAT_QueryPerformanceCounter"] = off_iat_k32 + 96 + 1
    iat_offs["IAT_CreateProcessA"] = off_iat_k32 + 104 + 1
    iat_offs["IAT_WaitForSingleObject"] = off_iat_k32 + 112 + 1
    iat_offs["IAT_GetExitCodeProcess"] = off_iat_k32 + 120 + 1
    iat_offs["IAT_SetHandleInformation"] = off_iat_k32 + 128 + 1
    iat_offs["IAT_CloseHandle"] = off_iat_k32 + 136 + 1
    iat_offs["IAT_CreateThread"] = off_iat_k32 + 144 + 1
    iat_offs["IAT_TerminateThread"] = off_iat_k32 + 152 + 1
    iat_offs["IAT_CreateFileA"] = off_iat_k32 + 160 + 1
    iat_offs["IAT_GetLastError"] = off_iat_k32 + 168 + 1
    iat_offs["IAT_GetFileAttributesA"] = off_iat_k32 + 176 + 1
    iat_offs["IAT_DeleteFileA"] = off_iat_k32 + 184 + 1
    iat_offs["IAT_RemoveDirectoryA"] = off_iat_k32 + 192 + 1
    iat_offs["IAT_CreateDirectoryA"] = off_iat_k32 + 200 + 1
    iat_offs["IAT_MoveFileExA"] = off_iat_k32 + 208 + 1
    iat_offs["IAT_SetFileAttributesA"] = off_iat_k32 + 216 + 1
    iat_offs["IAT_GetFileAttributesExA"] = off_iat_k32 + 224 + 1
    iat_offs["IAT_GetFileSizeEx"] = off_iat_k32 + 232 + 1
    iat_offs["IAT_FreeEnvironmentStringsA"] = off_iat_k32 + 240 + 1
    iat_offs["IAT_GetCurrentThreadId"] = off_iat_k32 + 248 + 1
    iat_offs["IAT_VirtualFree"] = off_iat_k32 + 256 + 1
    iat_offs["IAT_LoadLibraryA"] = off_iat_k32 + 264 + 1
    iat_offs["IAT_GetProcAddress"] = off_iat_k32 + 272 + 1
    iat_offs["IAT_QueryPerformanceFrequency"] = off_iat_k32 + 280 + 1
    // IOCP substrate (future Windows netpoll backend). Keep appended to preserve existing offsets.
    iat_offs["IAT_CreateIoCompletionPort"] = off_iat_k32 + 288 + 1
    iat_offs["IAT_GetQueuedCompletionStatusEx"] = off_iat_k32 + 296 + 1
    iat_offs["IAT_PostQueuedCompletionStatus"] = off_iat_k32 + 304 + 1
    iat_offs["IAT_CancelIoEx"] = off_iat_k32 + 312 + 1
    // KERNELBASE.dll IAT slots (order matches kernelbase_funcs above)
    iat_offs["IAT_WaitOnAddress"] = off_iat_kb + 0 + 1
    iat_offs["IAT_WakeByAddressAll"] = off_iat_kb + 8 + 1
    // WS2_32.dll IAT slots (order matches ws2_32_funcs above)
    iat_offs["IAT_WSAStartup"] = off_iat_ws2 + 0 + 1
    iat_offs["IAT_WSAGetLastError"] = off_iat_ws2 + 8 + 1
    iat_offs["IAT_socket"] = off_iat_ws2 + 16 + 1
    iat_offs["IAT_connect"] = off_iat_ws2 + 24 + 1
    iat_offs["IAT_bind"] = off_iat_ws2 + 32 + 1
    iat_offs["IAT_listen"] = off_iat_ws2 + 40 + 1
    iat_offs["IAT_accept"] = off_iat_ws2 + 48 + 1
    iat_offs["IAT_sendto"] = off_iat_ws2 + 56 + 1
    iat_offs["IAT_recvfrom"] = off_iat_ws2 + 64 + 1
    iat_offs["IAT_getsockname"] = off_iat_ws2 + 72 + 1
    iat_offs["IAT_getpeername"] = off_iat_ws2 + 80 + 1
    iat_offs["IAT_setsockopt"] = off_iat_ws2 + 88 + 1
    iat_offs["IAT_getsockopt"] = off_iat_ws2 + 96 + 1
    iat_offs["IAT_shutdown"] = off_iat_ws2 + 104 + 1
    iat_offs["IAT_closesocket"] = off_iat_ws2 + 112 + 1
    iat_offs["IAT_ioctlsocket"] = off_iat_ws2 + 120 + 1
    iat_offs["IAT_select"] = off_iat_ws2 + 128 + 1
    // Overlapped I/O (IOCP bring-up; completion-based NET ops). Keep appended to preserve existing offsets.
    iat_offs["IAT_WSARecv"] = off_iat_ws2 + 136 + 1
    iat_offs["IAT_WSASend"] = off_iat_ws2 + 144 + 1
    iat_offs["IAT_WSARecvFrom"] = off_iat_ws2 + 152 + 1
    // SHELL32.dll IAT slots
    iat_offs["IAT_CommandLineToArgvW"] = off_iat_s32 + 0 + 1

    _pe_apply_x64_rtobj_compact_fixups(ctx, code, data, functions, image_base, text_rva, data_rva)
    _pe_apply_x64_call_rel32_positions(ctx, code, functions, "oren_call_depth_enter", ctx["call_depth_enter_fixups"])
    _pe_apply_x64_call_rel32_positions(ctx, code, functions, "oren_call_depth_exit", ctx["call_depth_exit_fixups"])

    var i = 0
    var nfixups = 0
    if fixups != nil { nfixups = oren_list_len(fixups) }
    while i < nfixups {
        var f = fixups[i]
        var ft = f["type"]
        if ft == "call_rel32" {
            var name = f["name"]
            var target = _pe_x64_lookup_fn(ctx, functions, name)
            if target == nil {
                print("x64 pe: undefined function " + name)
                oren_exit(1)
            }
            var pos = f["pos"]
            var disp = target - (pos + 5)
            if disp < 0 { disp = 4294967296 + disp }
            set_u32_le(code, pos + 1, disp)
        }
        else if ft == "rip_data32" {
            // disp32 relative to next RIP (end of instruction).
            // f["pos"] points to disp32 field within the instruction.
            var label = f["data_label"]
            var target_off_enc = iat_offs[label]
            if oren_type_tag(target_off_enc) == 0 {
                print("x64 pe: unknown data label " + label)
                oren_exit(1)
            }
            var target_off = target_off_enc - 1
            var disp_pos = f["pos"]
            var insn_start = disp_pos - 3
            var next_rip = text_rva + (insn_start + 7)
            var target_rva = rdata_rva + target_off
            var disp2 = target_rva - next_rip
            if disp2 < 0 { disp2 = 4294967296 + disp2 }
            set_u32_le(code, disp_pos, disp2)
        }
        else if ft == "rip_rdata_lea" {
            // Backward-compatible alias: previously we used `rip_rdata_lea` for user-data.
            // User-data now lives in `.data`.
            var disp_pos2 = f["pos"]
            var data_off = f["data_off"]
            var insn_start2 = disp_pos2 - 3
            var next_rip2 = text_rva + (insn_start2 + 7)
            var target_rva2 = data_rva + data_off
            var disp3 = target_rva2 - next_rip2
            if disp3 < 0 { disp3 = 4294967296 + disp3 }
            set_u32_le(code, disp_pos2, disp3)
        }
        else if ft == "rip_data_lea" || ft == "rip_data_lea_rsi" || ft == "rip_data_mov_rax" {
            // lea r64, [rip+disp32] where target points into `.data` (fnobj, cstr, etc).
            //
            // x64_native_program.oren uses this fixup for first-class function values:
            // it emits `lea rax,[rip+disp32]` and later the caller loads `[rax]` as code_ptr.
            var disp_pos2 = f["pos"]
            var data_off = f["data_off"]
            var insn_start2 = disp_pos2 - 3
            var next_rip2 = text_rva + (insn_start2 + 7)
            var target_rva2 = data_rva + data_off
            var disp3 = target_rva2 - next_rip2
            if disp3 < 0 { disp3 = 4294967296 + disp3 }
            set_u32_le(code, disp_pos2, disp3)
        }
        else if ft == "data_fnobj_code_ptr" {
            var name2 = f["name"]
            var target_off2 = _pe_x64_lookup_fn(ctx, functions, name2)
            if target_off2 == nil {
                print("x64 pe: undefined function " + name2)
                oren_exit(1)
            }
            var data_off2 = f["data_off"]
            // Store absolute VA (ImageBase + .text RVA + fn offset). This emitter does not
            // produce relocations, so the base is fixed (0x400000).
            var addr = image_base + text_rva + target_off2
            set_u64_le(data, data_off2, addr)
        }
        else if ft == "data_data_ptr" {
            var data_offp = f["data_off"]
            var target_data_offp = f["target_data_off"]
            if oren_type_tag(data_offp) == 0 { data_offp = 0 }
            if oren_type_tag(target_data_offp) == 0 { target_data_offp = 0 }
            set_u64_le(data, data_offp, image_base + data_rva + target_data_offp)
        }
        else if ft == "rip_code_lea" {
            // lea r64, [rip+disp32] where target is a function entry in .text.
            var disp_pos3 = f["pos"]
            var name2 = f["name"]
            var target_off2 = _pe_x64_lookup_fn(ctx, functions, name2)
            if target_off2 == nil {
                print("x64 pe: undefined function " + name2)
                oren_exit(1)
            }
            var insn_start3 = disp_pos3 - 3
            var next_rip3 = text_rva + (insn_start3 + 7)
            var target_rva3 = text_rva + target_off2
            var disp4 = target_rva3 - next_rip3
            if disp4 < 0 { disp4 = 4294967296 + disp4 }
            set_u32_le(code, disp_pos3, disp4)
        }
        else {
            print("x64 pe: unknown fixup type " + ft)
            oren_exit(1)
        }
        i = i + 1
    }
    if trace_sum { t_fix_done = oren_time_now_ns() }

    // Additional Windows IAT fixups collected during codegen without allocating per-fixup maps.
    var iat_fix = ctx["rip_data32_fixups"]
    if iat_fix != nil {
        var idx2 = 0
        var pair2 = [nil, nil]
        while 1 {
            var ok2 = oren_iter_next_entry(iat_fix, idx2, pair2)
            if ok2 == 0 { break }
            var label2 = pair2[0]
            var poss = pair2[1]
            if label2 != nil && poss != nil {
                var target_off_enc2 = iat_offs[label2]
                if oren_type_tag(target_off_enc2) == 0 {
                    print("x64 pe: unknown data label " + label2)
                    oren_exit(1)
                }
                var target_off2 = target_off_enc2 - 1
                var pi = 0
                while pi < oren_list_len(poss) {
                    var disp_pos = poss[pi]
                    // disp32 relative to next RIP (end of instruction).
                    var insn_start = disp_pos - 3
                    var next_rip = text_rva + (insn_start + 7)
                    var target_rva = rdata_rva + target_off2
                    var disp2 = target_rva - next_rip
                    if disp2 < 0 { disp2 = 4294967296 + disp2 }
                    set_u32_le(code, disp_pos, disp2)
                    pi = pi + 1
                }
            }
            idx2 = idx2 + 1
        }
    }

    // ---- Build headers ----
    var n_sections = 3
    var text_raw_size = align_up(bytes_len(code), file_align)
    var rdata_raw_size = align_up(bytes_len(rdata), file_align)
    var data_raw_size = align_up(bytes_len(data), file_align)

    // PE headers size:
    // DOS(64) + stub/pad to e_lfanew (0x80) + PE sig(4) + COFF(20) + OPT(240) + SECHDR(40*n)
    var dos_stub_size = 128
    var pe_off = dos_stub_size
    var pe_headers_size = pe_off + 4 + 20 + 240 + 40 * n_sections
    var size_of_headers = align_up(pe_headers_size, file_align)

    var text_raw_ptr = size_of_headers
    var rdata_raw_ptr = align_up(text_raw_ptr + text_raw_size, file_align)
    var data_raw_ptr = align_up(rdata_raw_ptr + rdata_raw_size, file_align)

    var size_of_code = text_raw_size
    var size_of_init_data = rdata_raw_size + data_raw_size

    var size_of_image = align_up(data_rva + align_up(bytes_len(data), sect_align), sect_align)

    // ---- DOS header ----
    var out = bytes_new()
    // IMAGE_DOS_HEADER (64 bytes)
    push_u16_le(out, 23117) // 'MZ' 0x5A4D
    push_u8_n(out, 0, 58)
    // e_lfanew at offset 0x3C
    push_u32_le(out, pe_off)
    // pad to pe_off
    _pe_pad_to_len(out, pe_off)

    // ---- PE signature ----
    bytes_push(out, 80); bytes_push(out, 69); bytes_extend_zeros(out, 2) // "PE\0\0"

    // ---- COFF header (20 bytes) ----
    push_u16_le(out, 34404) // 0x8664
    push_u16_le(out, n_sections)
    push_u32_le(out, 0) // TimeDateStamp
    push_u32_le(out, 0) // PtrToSymbolTable
    push_u32_le(out, 0) // NumberOfSymbols
    push_u16_le(out, 240) // SizeOfOptionalHeader
    var coff_chars = 34 // EXECUTABLE | LARGE_ADDRESS_AWARE
    // Mark output as a DLL when emitting a shared library.
    if is_shared_lib == true { coff_chars = coff_chars + 8192 } // IMAGE_FILE_DLL (0x2000)
    push_u16_le(out, coff_chars)

    // ---- Optional header (PE32+, 240 bytes) ----
    var opt_start = bytes_len(out)
    push_u16_le(out, 523) // 0x20B
    bytes_extend_zeros(out, 2) // MajorLinkerVersion, MinorLinkerVersion
    push_u32_le(out, size_of_code)
    push_u32_le(out, size_of_init_data)
    push_u32_le(out, 0) // SizeOfUninitializedData
    push_u32_le(out, text_rva + ctx["entry_off"]) // AddressOfEntryPoint
    push_u32_le(out, text_rva) // BaseOfCode
    push_u64_le(out, image_base) // ImageBase
    push_u32_le(out, sect_align) // SectionAlignment
    push_u32_le(out, file_align) // FileAlignment
    push_u16_le(out, 6) // MajorOperatingSystemVersion
    push_u16_le(out, 0)
    push_u16_le(out, 0) // MajorImageVersion
    push_u16_le(out, 0)
    push_u16_le(out, 6) // MajorSubsystemVersion
    push_u16_le(out, 0)
    push_u32_le(out, 0) // Win32VersionValue
    push_u32_le(out, size_of_image)
    push_u32_le(out, size_of_headers)
    push_u32_le(out, 0) // CheckSum
    push_u16_le(out, 3) // Subsystem: Windows CUI
    push_u16_le(out, 0) // DllCharacteristics
    // Stack sizing (Tier‑1, rolling):
    // Windows default 1MB stack is too small for some of Oren's integration tests that
    // exercise recursion and deep call stacks. Since we do not yet have a full stackless
    // recursion implementation (heap frames) for native, increase the PE stack reserve.
    //
    // This is a pragmatic Tier‑1 gate to keep behavior aligned with arm64/macOS/Linux while
    // we land the proper design (TCO + heap frames for non‑TCO recursion).
    push_u64_le(out, 268435456) // SizeOfStackReserve (256MB)
    push_u64_le(out, 65536)     // SizeOfStackCommit (64KB)
    push_u64_le(out, 1048576) // SizeOfHeapReserve
    push_u64_le(out, 4096)    // SizeOfHeapCommit
    push_u32_le(out, 0) // LoaderFlags
    push_u32_le(out, 16) // NumberOfRvaAndSizes

    // DataDirectory[16] (each 8 bytes: RVA + Size)
    // 0 Export, 1 Import, others zero.
    // Export
    push_u32_le(out, export_dir_rva); push_u32_le(out, export_dir_size)
    // Import
    push_u32_le(out, import_dir_rva); push_u32_le(out, import_dir_size)
    // Remaining 14 directories
    bytes_extend_zeros(out, 14 * 8)

    // Pad optional header to 240 bytes
    _pe_pad_to_len(out, opt_start + 240)

    // ---- Section headers (3 * 40 bytes) ----
    // .text
    push_pe_section_name(out, 46, 116, 101, 120, 116, 0, 0, 0)
    push_u32_le(out, bytes_len(code)) // VirtualSize
    push_u32_le(out, text_rva)
    push_u32_le(out, text_raw_size)
    push_u32_le(out, text_raw_ptr)
    push_u32_le(out, 0); push_u32_le(out, 0) // reloc/line ptr
    push_u16_le(out, 0); push_u16_le(out, 0)
    push_u32_le(out, 1610612768) // Characteristics: CNT_CODE | MEM_EXECUTE | MEM_READ (0x60000020)

    // .rdata
    push_pe_section_name(out, 46, 114, 100, 97, 116, 97, 0, 0)
    push_u32_le(out, bytes_len(rdata))
    push_u32_le(out, rdata_rva)
    push_u32_le(out, rdata_raw_size)
    push_u32_le(out, rdata_raw_ptr)
    push_u32_le(out, 0); push_u32_le(out, 0)
    push_u16_le(out, 0); push_u16_le(out, 0)
    push_u32_le(out, 1073741888) // CNT_INITIALIZED_DATA | MEM_READ (0x40000040)

    // .data (user data blob)
    push_pe_section_name(out, 46, 100, 97, 116, 97, 0, 0, 0)
    push_u32_le(out, bytes_len(data)) // VirtualSize
    push_u32_le(out, data_rva)
    push_u32_le(out, data_raw_size)
    push_u32_le(out, data_raw_ptr)
    push_u32_le(out, 0); push_u32_le(out, 0)
    push_u16_le(out, 0); push_u16_le(out, 0)
    push_u32_le(out, 3221225536) // CNT_INITIALIZED_DATA | MEM_READ | MEM_WRITE (0xC0000040)

    // Pad headers to SizeOfHeaders
    _pe_pad_to_len(out, size_of_headers)

    // ---- Section raw data ----
    // .text raw
    bytes_extend(out, code)
    _pe_align(out, file_align)
    // .rdata raw
    bytes_extend(out, rdata)
    _pe_align(out, file_align)
    // .data raw
    bytes_extend(out, data)
    _pe_align(out, file_align)

    var w = oren_write_bytes(out_path, bytes_finalize(out))
    if oren_is_err(w) {
        print("x64 pe: failed to write: " + out_path)
        var code = oren_err_code(w)
        var msg = oren_err_msg(w)
        print("x64 pe: write error code=" + oren_int_to_string(code))
        if msg != nil { print("x64 pe: write error msg=" + msg) }
        oren_exit(1)
    }
    if trace_sum { t_write_done = oren_time_now_ns() }
    if trace_sum {
        var compile_ms = (t_compile_done - t0) / 1000000
        var rdata_ms = (t_rdata_done - t_compile_done) / 1000000
        var fixups_ms = (t_fix_done - t_rdata_done) / 1000000
        var write_ms = (t_write_done - t_fix_done) / 1000000
        print("[x64_pe] summary compile_ms=" + oren_int_to_string(compile_ms) +
            " rdata_ms=" + oren_int_to_string(rdata_ms) +
            " fixups_ms=" + oren_int_to_string(fixups_ms) +
            " write_ms=" + oren_int_to_string(write_ms) +
            " fixups_n=" + oren_int_to_string(oren_list_len(fixups)) +
            " code_bytes=" + oren_int_to_string(bytes_len(code)) +
            " rdata_bytes=" + oren_int_to_string(bytes_len(rdata)) +
            " data_bytes=" + oren_int_to_string(bytes_len(data)))
    }
    return nil
}
