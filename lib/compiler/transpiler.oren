fn _transpiler_inty_intersect(a, b) { return tanalysis._transpiler_inty_intersect(a, b) }
fn _transpiler_const_get(t, name) { return tanalysis._transpiler_const_get(t, name) }
fn _transpiler_const_set(t, name, val) { return tanalysis._transpiler_const_set(t, name, val) }
fn _transpiler_const_clear(t, name) { return tanalysis._transpiler_const_clear(t, name) }
fn _transpiler_const_reset(t) { return tanalysis._transpiler_const_reset(t) }
fn _transpiler_expr_is_inty(t, exp) { return tanalysis._transpiler_expr_is_inty(t, exp) }
fn _transpiler_is_ident(exp) { return tanalysis._transpiler_is_ident(exp) }
fn _transpiler_is_list_int_push_call(t, exp) { return tanalysis._transpiler_is_list_int_push_call(t, exp) }
fn _transpiler_is_list_push_call(t, exp) { return tanalysis._transpiler_is_list_push_call(t, exp) }
fn _transpiler_is_sum_add_list_get(t, stmt, idx_name) { return tanalysis._transpiler_is_sum_add_list_get(t, stmt, idx_name) }
fn _transpiler_stmt_collect_list_gets(t, stmt, idx_name, lists) { return tanalysis._transpiler_stmt_collect_list_gets(t, stmt, idx_name, lists) }
fn _transpiler_stmt_collect_list_int_gets(t, stmt, idx_name, lists) { return tanalysis._transpiler_stmt_collect_list_int_gets(t, stmt, idx_name, lists) }
fn _transpiler_expr_uses_any_ident(exp, names) { return tanalysis._transpiler_expr_uses_any_ident(exp, names) }
fn _transpiler_fast_int_rhs(t, exp, idx_name, list_items, idx_c) { return tanalysis._transpiler_fast_int_rhs(t, exp, idx_name, list_items, idx_c) }
fn _transpiler_fast_nonneg_rhs(t, exp, idx_name, idx_c) { return tanalysis._transpiler_fast_nonneg_rhs(t, exp, idx_name, idx_c) }
fn _transpiler_is_simple_inc(stmt, idx_name) { return tanalysis._transpiler_is_simple_inc(stmt, idx_name) }
fn _transpiler_parse_int_lit_expr(expr) { return tanalysis._transpiler_parse_int_lit_expr(expr) }
fn _transpiler_match_lcg_update(stmt, x_name) { return tanalysis._transpiler_match_lcg_update(stmt, x_name) }
fn _transpiler_match_sum_mod_update(stmt, sum_name, x_name, idx_name, mod_name, mod_const) { return tanalysis._transpiler_match_sum_mod_update(stmt, sum_name, x_name, idx_name, mod_name, mod_const) }

fn fun_varargs_fixed(fun) { return cutils.fun_varargs_fixed(fun) }
fn c_ident(name) { return cutils.c_ident(name) }
fn c_fn_name(name) { return cutils.c_fn_name(name) }
fn ns_resolve(t, exp) { return cutils.ns_resolve(t, exp) }
fn type_ctor_name(type_decl) { return cutils.type_ctor_name(type_decl) }
fn type_ctor_sig(type_decl) { return cutils.type_ctor_sig(type_decl) }
fn contains_curly_braces(s) { return cutils.contains_curly_braces(s) }
