// ----- Transpiler helpers ----- 
import intparse "int_lit.oren"
import coreir "coreir.oren"

var _CH_LF = "\n"
fn new_transpiler() {
    return {
        "lines": [],
        "chunks": [],
        // Cache indentation pads by level to avoid repeated allocations.
        "pad_cache": {0: ""},
        // Flush accumulated lines into `chunks` when this many are buffered.
        // Keeps peak memory bounded during large transpiles (e.g. stage2 self-hosting).
        "flush_lines": 512,
        "indent": 0,
        "functions": [],
        "func_varargs_fixed": {},
        "aliases": {},
        "type_ns": {},
        "lambda_defs": [],
        "lambda_counter": 0,
    }
}

fn _transpiler_get_pad(t) {
    var ind = t["indent"]
    if ind == nil { ind = 0 }
    var cache = t["pad_cache"]
    if cache == nil { cache = {0: ""}; t["pad_cache"] = cache }
    var pad = cache[ind]
    if pad != nil { return pad }
    pad = ""
    var i = 0
    while i < ind {
        pad = pad + "    "
        i = i + 1
    }
    cache[ind] = pad
    return pad
}

fn _transpiler_flush_lines(t, add_trailing_sep) {
    if t == nil { return nil }
    var lines = t["lines"]
    if lines == nil || oren_list_len(lines) == 0 { return nil }
    var chunk = list_join(lines, _CH_LF)
    if chunk != nil && chunk != "" {
        if t["chunks"] == nil { t["chunks"] = [] }
        oren_list_push(t["chunks"], chunk)
        if add_trailing_sep == true {
            oren_list_push(t["chunks"], _CH_LF)
        }
    }
    t["lines"] = []
    return nil
}

fn emit(t, s) {
    var pad = _transpiler_get_pad(t)
    oren_list_push(t["lines"], pad + s)

    var limit = t["flush_lines"]
    if limit != nil && oren_list_len(t["lines"]) >= limit {
        _transpiler_flush_lines(t, true)
    }
}

fn indent_more(t) { t["indent"] = t["indent"] + 1 }
fn indent_less(t) { t["indent"] = t["indent"] - 1 }

fn _transpiler_join_parts(parts) {
    if parts == nil { return "" }
    if oren_list_len(parts) == 0 { return "" }
    // Prefer the runtime join helper so we do a single allocation (O(n) time/mem).
    // This matters for stage2 self-hosting where we join extremely large parts lists.
    return oren_string_join(parts)
}

fn list_join(lines, sep) {
    // NOTE: naive `out = out + ...` in a loop is O(n^2) and can blow up memory
    // when transpiling large programs (e.g. stage2 self-hosting).
    //
    // Build a parts list and join via pairwise concatenation to keep it near-linear.
    if lines == nil { return "" }
    var n = oren_list_len(lines)
    if n == 0 { return "" }
    var parts = []
    var i = 0
    while i < n {
        oren_list_push(parts, lines[i])
        if i < n - 1 { oren_list_push(parts, sep) }
        i = i + 1
    }
    return _transpiler_join_parts(parts)
}

fn list_contains(lst, val) {
    var i = 0
    var n = oren_list_len(lst)
    while i < n {
        if str_eq(lst[i], val) { return true }
        i = i + 1
    }
    return false
}

fn str_eq(a, b) {
    if oren_is_string(a) && oren_is_string(b) {
        return oren_string_eq(a, b)
    }
    return a == b
}

fn _transpiler_inty_list(t) {
    if t["inty"] == nil { t["inty"] = [] }
    return t["inty"]
}

fn _transpiler_inty_clone(xs) {
    var out = []
    if xs == nil { return out }
    var i = 0
    while i < oren_list_len(xs) {
        oren_list_push(out, xs[i])
        i = i + 1
    }
    return out
}

fn _transpiler_inty_remove(xs, name) {
    if xs == nil { return [] }
    var out = []
    var i = 0
    while i < oren_list_len(xs) {
        if str_eq(xs[i], name) != true { oren_list_push(out, xs[i]) }
        i = i + 1
    }
    return out
}

fn _transpiler_inty_set(t, name, ok) {
    var xs = _transpiler_inty_list(t)
    if ok {
        if list_contains(xs, name) == false {
            oren_list_push(xs, name)
        }
        return nil
    }
    t["inty"] = _transpiler_inty_remove(xs, name)
    return nil
}

fn _transpiler_inty_intersect(a, b) {
    var out = []
    if a == nil || b == nil { return out }
    var i = 0
    while i < oren_list_len(a) {
        if list_contains(b, a[i]) { oren_list_push(out, a[i]) }
        i = i + 1
    }
    return out
}

fn _transpiler_expr_is_inty(t, exp) {
    if exp == nil { return false }
    var et = exp["type"]
    if et == "Integer" { return true }
    if et == "Identifier" {
        var name_id = exp["value"]
        var ok = list_contains(_transpiler_inty_list(t), name_id)
        return ok
    }
    if et == "Call" {
        var nm = nil
        if exp["fn"] != nil {
            if exp["fn"]["type"] == "Identifier" {
                nm = exp["fn"]["value"]
            } else if exp["fn"]["type"] == "Member" {
                var ns = ns_resolve(t, exp["fn"])
                if ns != nil {
                    nm = ns["name"]
                } else {
                    var left = exp["fn"]["left"]
                    var prop = exp["fn"]["prop"]
                    if left != nil && prop != nil && left["type"] == "Identifier" && left["value"] == "list" {
                        if prop["value"] == "int_get" { nm = "STD_list_int_get" }
                        if prop["value"] == "int_len" { nm = "STD_list_int_len" }
                        if prop["value"] == "len" { nm = "STD_list_len" }
                    }
                }
            }
        }
        if nm == nil { return false }
        if str_eq(nm, "oren_int") { return true }
        if str_eq(nm, "oren_list_int_get") || str_eq(nm, "STD_list_int_get") { return true }
        if str_eq(nm, "oren_list_int_len") || str_eq(nm, "STD_list_int_len") { return true }
        if str_eq(nm, "oren_list_int_set") || str_eq(nm, "STD_list_int_set") { return true }
        if str_eq(nm, "oren_list_len") || str_eq(nm, "STD_list_len") { return true }
        return false
    }
    if et == "Prefix" {
        var op = exp["op"]
        if op == "-" || op == "~" {
            return _transpiler_expr_is_inty(t, exp["right"])
        }
        return false
    }
    if et == "Infix" {
        var op = exp["op"]
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" ||
           op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
            return _transpiler_expr_is_inty(t, exp["left"]) &&
                   _transpiler_expr_is_inty(t, exp["right"])
        }
        return false
    }
    return false
}

fn _transpiler_is_ident(exp) {
    if exp == nil { return nil }
    if exp["type"] == "Identifier" { return exp["value"] }
    return nil
}

fn _transpiler_is_int_lit(exp, val) {
    if exp == nil || exp["type"] != "Integer" { return false }
    if val == nil { return false }
    return parse_int_lit(exp["value"]) == val
}

fn _transpiler_is_list_int_get_call(t, exp, idx_name) {
    if exp == nil || exp["type"] != "Call" { return nil }
    if exp["fn"] == nil { return nil }
    var nm = nil
    if exp["fn"]["type"] == "Identifier" {
        nm = exp["fn"]["value"]
    } else if exp["fn"]["type"] == "Member" {
        var ns = ns_resolve(t, exp["fn"])
        if ns != nil {
            nm = ns["name"]
        } else {
            var left = exp["fn"]["left"]
            var prop = exp["fn"]["prop"]
            if left != nil && prop != nil && left["type"] == "Identifier" && left["value"] == "list" {
                if prop["value"] == "int_get" { nm = "STD_list_int_get" }
            }
        }
    }
    if nm == nil { return nil }
    if str_eq(nm, "oren_list_int_get") != true && str_eq(nm, "STD_list_int_get") != true { return nil }
    var args = exp["args"]
    if args == nil || oren_list_len(args) != 2 { return nil }
    var list_name = _transpiler_is_ident(args[0])
    var idx = _transpiler_is_ident(args[1])
    if list_name == nil || idx == nil { return nil }
    if str_eq(idx, idx_name) != true { return nil }
    return list_name
}

fn _transpiler_expr_collect_list_int_gets(t, exp, idx_name, lists) {
    if exp == nil { return {"ok": true, "lists": lists, "uses_idx": false} }
    var et = exp["type"]
    if et == "Identifier" {
        if str_eq(exp["value"], idx_name) { return {"ok": true, "lists": lists, "uses_idx": true} }
        return {"ok": true, "lists": lists, "uses_idx": false}
    }
    var list_name = _transpiler_is_list_int_get_call(t, exp, idx_name)
    if list_name != nil {
        if list_contains(lists, list_name) == false {
            oren_list_push(lists, list_name)
        }
        return {"ok": true, "lists": lists, "uses_idx": false}
    }
    if et == "Call" {
        var nm = nil
        if exp["fn"] != nil {
            if exp["fn"]["type"] == "Identifier" {
                nm = exp["fn"]["value"]
            } else if exp["fn"]["type"] == "Member" {
                var ns2 = ns_resolve(t, exp["fn"])
                if ns2 != nil { nm = ns2["name"] }
            }
        }
        if nm == nil {
            if exp["fn"] != nil && exp["fn"]["type"] == "Member" {
                var leftm = exp["fn"]["left"]
                var propm = exp["fn"]["prop"]
                if leftm != nil && propm != nil && leftm["type"] == "Identifier" && leftm["value"] == "list" {
                    if propm["value"] == "int_get" { nm = "STD_list_int_get" }
                }
            }
        }
        if nm == nil { return {"ok": false, "lists": lists, "uses_idx": false} }
        if str_eq(nm, "oren_list_int_get") || str_eq(nm, "STD_list_int_get") {
            if _transpiler_is_list_int_get_call(t, exp, idx_name) == nil {
                return {"ok": false, "lists": lists, "uses_idx": false}
            }
        } else if str_eq(nm, "oren_int") {
            // allow
        } else {
            return {"ok": false, "lists": lists, "uses_idx": false}
        }
        var args = exp["args"]
        var j = 0
        while j < oren_list_len(args) {
            var r = _transpiler_expr_collect_list_int_gets(t, args[j], idx_name, lists)
            if r["ok"] != true { return r }
            if r["uses_idx"] == true { return r }
            lists = r["lists"]
            j = j + 1
        }
        return {"ok": true, "lists": lists, "uses_idx": false}
    }
    if et == "Prefix" {
        return _transpiler_expr_collect_list_int_gets(t, exp["right"], idx_name, lists)
    }
    if et == "Infix" {
        var r1 = _transpiler_expr_collect_list_int_gets(t, exp["left"], idx_name, lists)
        if r1["ok"] != true || r1["uses_idx"] == true { return r1 }
        var r2 = _transpiler_expr_collect_list_int_gets(t, exp["right"], idx_name, r1["lists"])
        return r2
    }
    if et == "Array" {
        var xs = exp["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            var r = _transpiler_expr_collect_list_int_gets(t, xs[i], idx_name, lists)
            if r["ok"] != true || r["uses_idx"] == true { return r }
            lists = r["lists"]
            i = i + 1
        }
        return {"ok": true, "lists": lists, "uses_idx": false}
    }
    if et == "Hash" {
        var ps = exp["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            var r1h = _transpiler_expr_collect_list_int_gets(t, ps[i2]["key"], idx_name, lists)
            if r1h["ok"] != true || r1h["uses_idx"] == true { return r1h }
            var r2h = _transpiler_expr_collect_list_int_gets(t, ps[i2]["value"], idx_name, r1h["lists"])
            if r2h["ok"] != true || r2h["uses_idx"] == true { return r2h }
            lists = r2h["lists"]
            i2 = i2 + 1
        }
        return {"ok": true, "lists": lists, "uses_idx": false}
    }
    if et == "Index" {
        var rli = _transpiler_expr_collect_list_int_gets(t, exp["left"], idx_name, lists)
        if rli["ok"] != true || rli["uses_idx"] == true { return rli }
        var rri = _transpiler_expr_collect_list_int_gets(t, exp["index"], idx_name, rli["lists"])
        return rri
    }
    if et == "If" {
        return {"ok": false, "lists": lists, "uses_idx": false}
    }
    return {"ok": true, "lists": lists, "uses_idx": false}
}

fn _transpiler_stmt_collect_list_int_gets(t, stmt, idx_name, lists) {
    if stmt == nil { return {"ok": true, "lists": lists, "uses_idx": false} }
    var stype = stmt["type"]
    if stype == "Var" {
        return _transpiler_expr_collect_list_int_gets(t, stmt["value"], idx_name, lists)
    }
    if stype == "Assign" {
        if stmt["name"] != nil && str_eq(stmt["name"]["value"], idx_name) {
            return {"ok": false, "lists": lists, "uses_idx": false}
        }
        return _transpiler_expr_collect_list_int_gets(t, stmt["value"], idx_name, lists)
    }
    if stype == "ExprStmt" {
        if stmt["expr"] != nil && stmt["expr"]["type"] == "If" { return {"ok": false, "lists": lists, "uses_idx": false} }
        return _transpiler_expr_collect_list_int_gets(t, stmt["expr"], idx_name, lists)
    }
    if stype == "Return" {
        return _transpiler_expr_collect_list_int_gets(t, stmt["value"], idx_name, lists)
    }
    if stype == "Set" || stype == "While" || stype == "For" || stype == "Block" || stype == "Spawn" {
        return {"ok": false, "lists": lists, "uses_idx": false}
    }
    return {"ok": false, "lists": lists, "uses_idx": false}
}

fn _transpiler_fast_int_rhs(t, exp, idx_name, list_items, idx_c) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Integer" {
        return "(uint64_t)" + int_str(parse_int_lit(exp["value"]))
    }
    if et == "Call" {
        var list_name = _transpiler_is_list_int_get_call(t, exp, idx_name)
        if list_name == nil { return nil }
        if list_items == nil { return nil }
        var items = list_items[list_name]
        if items == nil { return nil }
        return "(uint64_t)" + items + "[" + idx_c + "].as.int_val"
    }
    if et == "Infix" {
        if exp["op"] != "*" { return nil }
        var left = _transpiler_fast_int_rhs(t, exp["left"], idx_name, list_items, idx_c)
        if left == nil { return nil }
        var right = _transpiler_fast_int_rhs(t, exp["right"], idx_name, list_items, idx_c)
        if right == nil { return nil }
        return "(" + left + " * " + right + ")"
    }
    return nil
}

fn _transpiler_is_simple_inc(stmt, idx_name) {
    if stmt == nil || stmt["type"] != "Assign" { return false }
    if stmt["name"] == nil || str_eq(stmt["name"]["value"], idx_name) != true { return false }
    var v = stmt["value"]
    if v == nil || v["type"] != "Infix" { return false }
    if v["op"] != "+" { return false }
    var left = _transpiler_is_ident(v["left"])
    if left == nil || str_eq(left, idx_name) != true { return false }
    if _transpiler_is_int_lit(v["right"], 1) { return true }
    return false
}

fn _transpiler_emit_while_basic(t, stmt) {
    var cond = transpile_expression(t, stmt["cond"])
    var tick = tmp_gensym(t, "gc_tick")
    var inner_parts = []
    // PERF: do not call into safepoint on every iteration; the function call itself dominates
    // tight loops (lexer/parser), even though `oren_gc_safepoint` has an internal fast path.
    //
    // Poll GC once per ~64 iterations to keep GC responsive without burning CPU in loop bodies.
    oren_list_push(inner_parts, "    if (((" + tick + "++) & 255u) == 0u) { oren_gc_safepoint(); }")
    oren_list_push(inner_parts, CH_LF)
    var i = 0
    while i < oren_list_len(stmt["body"]["stmts"]) {
        oren_list_push(inner_parts, "    " + transpile_statement(t, stmt["body"]["stmts"][i]))
        oren_list_push(inner_parts, CH_LF)
        i = i + 1
    }
    var inner = _transpiler_join_parts(inner_parts)
    return "{ uint64_t " + tick + " = 0; while (oren_is_truthy(" + cond + ")) {" + CH_LF + inner + "} }"
}

fn _transpiler_match_fast_list_int_while(t, stmt) {
    if stmt == nil || stmt["type"] != "While" { return nil }
    var cond = stmt["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _transpiler_is_ident(cond["left"])
    var n_name = _transpiler_is_ident(cond["right"])
    if idx_name == nil || n_name == nil { return nil }
    var body = stmt["body"]["stmts"]
    if body == nil { return nil }
    var n = oren_list_len(body)
    if n < 1 { return nil }
    var last = body[n - 1]
    if _transpiler_is_simple_inc(last, idx_name) != true { return nil }
    var lists = []
    var i = 0
    while i < n - 1 {
        var r = _transpiler_stmt_collect_list_int_gets(t, body[i], idx_name, lists)
        if r["ok"] != true || r["uses_idx"] == true { return nil }
        lists = r["lists"]
        i = i + 1
    }
    if oren_list_len(lists) == 0 { return nil }
    return {"idx": idx_name, "n": n_name, "lists": lists, "body": body, "body_len": n - 1}
}

fn _transpiler_emit_fast_list_int_while(t, stmt, info) {
    var idx_name = info["idx"]
    var n_name = info["n"]
    var lists = info["lists"]
    var body = info["body"]
    var body_len = info["body_len"]

    var inty_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    var slow = _transpiler_emit_while_basic(t, stmt)
    var inty_after = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["inty"] = _transpiler_inty_clone(inty_before)

    var fast_ok = tmp_gensym(t, "list_fast_ok")
    var n_int = tmp_gensym(t, "list_fast_n")
    var i_int = tmp_gensym(t, "list_fast_i")
    var acc_name = nil
    var acc_rhs = nil
    var acc_u = nil
    var acc_ll = nil

    var parts = []
    oren_list_push(parts, "{")
    oren_list_push(parts, CH_LF)
    oren_list_push(parts, "int " + fast_ok + " = 1;")
    oren_list_push(parts, "long long " + n_int + " = 0;")
    oren_list_push(parts, "long long " + i_int + " = 0;")
    oren_list_push(parts, "if (" + c_ident(n_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + n_int + " = " + c_ident(n_name) + ".as.int_val; if (" + n_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + c_ident(idx_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + i_int + " = " + c_ident(idx_name) + ".as.int_val; if (" + i_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + fast_ok + " && oren_list_locking_needed()) { " + fast_ok + " = 0; }")

    var list_items = {}
    var li = 0
    while li < oren_list_len(lists) {
        var ln = lists[li]
        var list_tmp = tmp_gensym(t, "list_fast_list")
        var ptr_tmp = tmp_gensym(t, "list_fast_ptr")
        var items_tmp = tmp_gensym(t, "list_fast_items")
        list_items[ln] = items_tmp
        oren_list_push(parts, "OrenValue " + list_tmp + " = " + c_ident(ln) + ";")
        oren_list_push(parts, "OrenList* " + ptr_tmp + " = NULL;")
        oren_list_push(parts, "OrenValue* " + items_tmp + " = NULL;")
        oren_list_push(parts, "if (" + fast_ok + ") {")
        oren_list_push(parts, "    if (" + list_tmp + ".type != OREN_TYPE_LIST || " + list_tmp + ".as.list_val == NULL) { " + fast_ok + " = 0; } else {")
        oren_list_push(parts, "        " + ptr_tmp + " = " + list_tmp + ".as.list_val;")
        oren_list_push(parts, "        if ((long long)" + ptr_tmp + "->count < " + n_int + ") { " + fast_ok + " = 0; } else { " + items_tmp + " = " + ptr_tmp + "->items; }")
        oren_list_push(parts, "    }")
        oren_list_push(parts, "}")
        li = li + 1
    }

    if body_len == 1 {
        var st = body[0]
        if st["type"] == "Assign" {
            var name = _transpiler_is_ident(st["name"])
            if name != nil && str_eq(name, idx_name) != true && str_eq(name, n_name) != true {
                var v = st["value"]
                if v != nil && v["type"] == "Infix" && v["op"] == "+" {
                    var left_name = _transpiler_is_ident(v["left"])
                    if left_name != nil && str_eq(left_name, name) {
                        var rhs = _transpiler_fast_int_rhs(t, v["right"], idx_name, list_items, i_int)
                        if rhs != nil {
                            acc_name = name
                            acc_rhs = rhs
                            acc_u = tmp_gensym(t, "list_fast_acc")
                            acc_ll = tmp_gensym(t, "list_fast_acc_ll")
                        }
                    }
                }
            }
        }
    }

    if acc_name != nil {
        oren_list_push(parts, "uint64_t " + acc_u + " = 0;")
        oren_list_push(parts, "long long " + acc_ll + " = 0;")
        oren_list_push(parts, "if (" + fast_ok + " && " + c_ident(acc_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else if (" + fast_ok + ") { memcpy(&" + acc_u + ", &" + c_ident(acc_name) + ".as.int_val, sizeof(" + acc_u + ")); }")
    }

    oren_list_push(parts, "if (" + fast_ok + ") {")

    var inty_fast_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["fast_list_items"] = list_items
    t["fast_idx_name"] = idx_name
    t["fast_idx_c"] = i_int
    oren_list_push(parts, "    while (" + i_int + " < " + n_int + ") {")
    if acc_name != nil {
        oren_list_push(parts, "        " + acc_u + " = " + acc_u + " + " + acc_rhs + ";")
    } else {
        var bi = 0
        while bi < body_len {
            oren_list_push(parts, "        " + transpile_statement(t, body[bi]))
            bi = bi + 1
        }
    }
    oren_list_push(parts, "        " + i_int + "++;")
    oren_list_push(parts, "    }")
    if acc_name != nil {
        oren_list_push(parts, "    memcpy(&" + acc_ll + ", &" + acc_u + ", sizeof(" + acc_ll + "));")
        oren_list_push(parts, "    " + c_ident(acc_name) + " = oren_int(" + acc_ll + ");")
    }
    oren_list_push(parts, "    " + c_ident(idx_name) + " = oren_int(" + i_int + ");")
    t["fast_list_items"] = nil
    t["fast_idx_name"] = nil
    t["fast_idx_c"] = nil
    t["inty"] = inty_fast_before

    oren_list_push(parts, "} else " + slow)
    oren_list_push(parts, "}")

    t["inty"] = inty_after
    return _transpiler_join_parts(parts)
}

fn fun_varargs_fixed(fun) {
    // Returns fixed-parameter count for a varargs function, or -1 if not varargs.
    //
    // Varargs syntax: fn f(a, b, ...rest) { }
    // Internally: `rest` is bound to a list of extra args.
    var params = fun["params"]
    if params == nil { return -1 }
    var n = oren_list_len(params)
    if n == 0 { return -1 }
    var last = params[n - 1]
    if last != nil && last["is_varargs"] == true {
        return n - 1
    }
    return -1
}

fn trim_trailing_underscores(s) {
    var end = oren_string_len(s)
    while end > 0 {
        if oren_string_char_at(s, end - 1) != "_" { break }
        end = end - 1
    }
    return oren_string_slice(s, 0, end)
}

fn is_c_keyword(s) {
    if s == nil { return false }
    // Minimal set: enough to avoid obvious collisions in generated C.
    if s == "auto" { return true }
    if s == "break" { return true }
    if s == "case" { return true }
    if s == "char" { return true }
    if s == "const" { return true }
    if s == "continue" { return true }
    if s == "default" { return true }
    if s == "do" { return true }
    if s == "double" { return true }
    if s == "else" { return true }
    if s == "enum" { return true }
    if s == "extern" { return true }
    if s == "float" { return true }
    if s == "for" { return true }
    if s == "goto" { return true }
    if s == "if" { return true }
    if s == "inline" { return true }
    if s == "int" { return true }
    if s == "long" { return true }
    if s == "register" { return true }
    if s == "restrict" { return true }
    if s == "return" { return true }
    if s == "short" { return true }
    if s == "signed" { return true }
    if s == "sizeof" { return true }
    if s == "static" { return true }
    if s == "struct" { return true }
    if s == "switch" { return true }
    if s == "typedef" { return true }
    if s == "union" { return true }
    if s == "unsigned" { return true }
    if s == "void" { return true }
    if s == "volatile" { return true }
    if s == "while" { return true }
    return false
}

fn c_ident(name) {
    // The parser may generate internal identifiers containing '@' (for `for x in ...` sugar).
    // Those are valid in the Oren AST but not valid C identifiers.
    if name == nil || name == "" { return "_" }

    var bs = oren_bytes_from_string(name)
    var out = []
    var i = 0
    while i < oren_list_len(bs) {
        var b = bs[i]
        var ok = 0
        // '_' or A-Z or a-z or 0-9
        if b == 95 { ok = 1 }
        if b >= 65 && b <= 90 { ok = 1 }
        if b >= 97 && b <= 122 { ok = 1 }
        if b >= 48 && b <= 57 { ok = 1 }
        if ok == 0 { b = 95 }

        // Leading digit is not allowed in C identifiers.
        if i == 0 && b >= 48 && b <= 57 {
            oren_list_push(out, 95)
        }
        oren_list_push(out, b)
        i = i + 1
    }

    var s = oren_string_from_bytes(out)
    if s == nil || s == "" { s = "_" }
    if is_c_keyword(s) { s = "oren_" + s }
    return s
}

// C backend symbol naming for Oren identifiers.
//
// The C backend emits a host `int main(int argc, char** argv)` entrypoint, so an Oren user
// function named `main` must not collide with the host entry symbol.
//
// Rolling policy:
// - Keep the Oren surface as `fn main() { ... }`.
// - Emit it as a different C symbol and call it from the host entrypoint.
fn c_fn_name(name) {
    if str_eq(name, "main") { return "__oren_user_main" }
    return c_ident(name)
}

fn ns_resolve(t, exp) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Identifier" {
        var name = exp["value"]
        if t["aliases"][name] != nil { return {"name": t["aliases"][name], "is_ns": true} }
        if t["type_ns"][name] == true { return {"name": name, "is_ns": true} }
        return nil
    }
    if et == "Member" {
        var left = ns_resolve(t, exp["left"])
        if left == nil { return nil }
        if left["is_ns"] != true { return nil }
        var base = trim_trailing_underscores(left["name"])
        var name2 = base + "_" + exp["prop"]["value"]
        var is_ns2 = false
        if t["type_ns"][name2] == true { is_ns2 = true }
        return {"name": name2, "is_ns": is_ns2}
    }
    return nil
}

fn type_ctor_name(type_decl) {
    return c_ident(type_decl["name"]["value"])
}

fn type_ctor_sig(type_decl) {
    var params = ""
    var i = 0
    while i < oren_list_len(type_decl["fields"]) {
        if i > 0 { params = params + ", " }
        params = params + "OrenValue " + c_ident(type_decl["fields"][i]["value"])
        i = i + 1
    }
    return "OrenValue " + type_ctor_name(type_decl) + "(" + params + ")"
}

// Use literals to avoid top-level `oren_char` init on native Win11 bring-up.
var CH_QUOTE = "\""
var CH_BACKSLASH = "\\"
var CH_LF = "\n"
var CH_CR = "\r"
var CH_TAB = "\t"

fn contains_curly_braces(s) {
    var i = 0
    var len = oren_string_len(s)
    while i < len - 1 {
        if oren_string_char_at(s, i) == "{" {
            if oren_string_char_at(s, i + 1) == "}" { return true }
        }
        i = i + 1
    }
    return false
}

fn c_escape_string(s) {
    var out = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        var piece = ""
        if ch == CH_BACKSLASH { piece = "\\\\" }
        if ch == CH_QUOTE { piece = "\\\"" }
        if ch == CH_LF { piece = "\\n" }
        if ch == CH_CR { piece = "\\r" }
        if ch == CH_TAB { piece = "\\t" }
        if piece == "" { piece = ch }
        out = out + piece
        i = i + 1
    }
    return out
}

fn int_str(n) { return oren_int_to_string(n) }

fn parse_int_lit(s) {
    // Transpiler int literal parser for the C backend.
    //
    // We cannot emit `oren_int(<raw literal>)` for prefixed literals like `0o17`
    // because C does not have `0o`/`0b` integer literal syntax.
    //
    // Parse the literal at compile time and emit a decimal constant.
    return intparse.parse_int_lit_strict(s)
}

fn transpile_type_ctor(t, type_decl) {
    emit(t, type_ctor_sig(type_decl) + " {")
    indent_more(t)
    var n = oren_list_len(type_decl["fields"])
    // Rolling reflection v0:
    // Tag type ctor maps with a stable type name for basic reflection helpers.
    //   User(id, name) => {"__oren_type":"User","id":id,"name":name}
    var args = ""
    args = args + "oren_string_const(\"__oren_type\"), oren_string_const(\"" + c_escape_string(type_decl["name"]["value"]) + "\")"
    var i = 0
    while i < n {
        args = args + ", "
        args = args + "oren_string_const(" + CH_QUOTE + c_escape_string(type_decl["fields"][i]["value"]) + CH_QUOTE + "), " + type_decl["fields"][i]["value"]
        i = i + 1
    }
    emit(t, "return oren_new_map_from_pairs(" + int_str(n + 1) + ", (OrenValue[]){" + args + "});")
    indent_less(t)
    emit(t, "}")

    // Uniform-call wrapper so constructors can be used as first-class function values.
    var ctor_name = type_ctor_name(type_decl)
    emit(t, fnwrap_sig_by_name(ctor_name) + " {")
    indent_more(t)
    emit(t, "(void)env;")
    emit(t, "if (argc != " + int_str(oren_list_len(type_decl["fields"])) + ") { oren_panic(\"arity mismatch\"); }")
    var args2 = ""
    var k = 0
    while k < oren_list_len(type_decl["fields"]) {
        if k > 0 { args2 = args2 + ", " }
        args2 = args2 + "argv[" + int_str(k) + "]"
        k = k + 1
    }
    emit(t, "return " + ctor_name + "(" + args2 + ");")
    indent_less(t)
    emit(t, "}")
}

fn transpile_args_list_expr(t, args) {
    // Build a list expression from a list of AST expressions (expression-level).
    // Used for call-site spread and list-based variadic helpers.
    var argc = oren_list_len(args)
    if argc == 0 { return "oren_new_list(0)" }
    var parts = ""
    var j = 0
    while j < argc {
        if j > 0 { parts = parts + ", " }
        parts = parts + transpile_expression(t, args[j])
        j = j + 1
    }
    return "oren_new_list_from_array(" + int_str(argc) + ", (OrenValue[]){" + parts + "})"
}

fn starts_with(s, prefix) {
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if oren_string_char_at(s, i) != oren_string_char_at(prefix, i) { return false }
        i = i + 1
    }
    return true
}

fn function_sig(func_decl) {
    var params = ""
    var i = 0
    while i < oren_list_len(func_decl["params"]) {
        if i > 0 { params = params + ", " }
        params = params + "OrenValue " + c_ident(func_decl["params"][i]["value"])
        i = i + 1
    }
    return "OrenValue " + c_fn_name(func_decl["name"]) + "(" + params + ")"
}

fn fnwrap_name(name) {
    return c_fn_name(name) + "__oren_fnwrap"
}

fn fnwrap_sig_by_name(name) {
    return "OrenValue " + fnwrap_name(name) + "(void* env, int argc, OrenValue* argv)"
}

fn lambda_sig_by_name(name) {
    return "OrenValue " + name + "(void* env, int argc, OrenValue* argv)"
}

fn is_builtin_ident_name(name) {
    if str_eq(name, "print") { return true }
    if str_eq(name, "py_import") { return true }
    if str_eq(name, "py_release") { return true }
    if str_eq(name, "system") { return true }
    if str_eq(name, "exit") { return true }
    return false
}

fn is_non_capturable_ident_name(name) {
    if name == nil || name == "" { return true }
    if is_builtin_ident_name(name) { return true }
    if starts_with(name, "oren_") { return true }
    if starts_with(name, "sys_") { return true }
    return false
}

fn lambda_gensym(t, unit_prefix) {
    var n = t["lambda_counter"]
    t["lambda_counter"] = n + 1
    return "__oren_lambda_" + unit_prefix + "_" + oren_int_to_string(n)
}

fn tmp_gensym(t, prefix) {
    // Deterministic gensym for internal temporaries in emitted C.
    if t["tmp_counter"] == nil { t["tmp_counter"] = 0 }
    var n = t["tmp_counter"]
    t["tmp_counter"] = n + 1
    return "__oren_" + prefix + "_" + oren_int_to_string(n)
}

fn lambda_collect_declared_in_expression(exp, declared) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Function" {
        // Nested lambdas are their own scopes.
        return nil
    }
    if et == "Call" {
        lambda_collect_declared_in_expression(exp["fn"], declared)
        var i = 0
        while i < oren_list_len(exp["args"]) {
            lambda_collect_declared_in_expression(exp["args"][i], declared)
            i = i + 1
        }
        if exp["spread"] != nil { lambda_collect_declared_in_expression(exp["spread"], declared) }
        return nil
    }
    if et == "Prefix" { lambda_collect_declared_in_expression(exp["right"], declared); return nil }
    if et == "Infix" {
        lambda_collect_declared_in_expression(exp["left"], declared)
        lambda_collect_declared_in_expression(exp["right"], declared)
        return nil
    }
    if et == "If" {
        lambda_collect_declared_in_expression(exp["cond"], declared)
        lambda_collect_declared_in_statement(exp["consq"], declared)
        if exp["alt"] != nil { lambda_collect_declared_in_statement(exp["alt"], declared) }
        return nil
    }
    if et == "Member" { lambda_collect_declared_in_expression(exp["left"], declared); return nil }
    if et == "Index" {
        lambda_collect_declared_in_expression(exp["left"], declared)
        lambda_collect_declared_in_expression(exp["index"], declared)
        return nil
    }
    if et == "Array" {
        var j = 0
        while j < oren_list_len(exp["elements"]) {
            lambda_collect_declared_in_expression(exp["elements"][j], declared)
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        while k < oren_list_len(exp["pairs"]) {
            var pair = exp["pairs"][k]
            lambda_collect_declared_in_expression(pair["key"], declared)
            lambda_collect_declared_in_expression(pair["value"], declared)
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { lambda_collect_declared_in_expression(exp["call"], declared); return nil }
    return nil
}

fn lambda_collect_declared_in_statement(stmt, declared) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" {
        var nm = stmt["name"]["value"]
        if nm != nil && nm != "" { declared[nm] = true }
        lambda_collect_declared_in_expression(stmt["value"], declared)
        return nil
    }
    if st == "Assign" { lambda_collect_declared_in_expression(stmt["value"], declared); return nil }
    if st == "Set" {
        lambda_collect_declared_in_expression(stmt["left"], declared)
        lambda_collect_declared_in_expression(stmt["value"], declared)
        return nil
    }
    if st == "Return" { lambda_collect_declared_in_expression(stmt["value"], declared); return nil }
    if st == "ExprStmt" { lambda_collect_declared_in_expression(stmt["expr"], declared); return nil }
    if st == "Block" {
        var i = 0
        while i < oren_list_len(stmt["stmts"]) {
            lambda_collect_declared_in_statement(stmt["stmts"][i], declared)
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        lambda_collect_declared_in_expression(stmt["cond"], declared)
        lambda_collect_declared_in_statement(stmt["body"], declared)
        return nil
    }
    if st == "For" {
        lambda_collect_declared_in_statement(stmt["init"], declared)
        lambda_collect_declared_in_expression(stmt["cond"], declared)
        lambda_collect_declared_in_statement(stmt["post"], declared)
        lambda_collect_declared_in_statement(stmt["body"], declared)
        return nil
    }
    if st == "Spawn" { lambda_collect_declared_in_expression(stmt["call"], declared); return nil }
    // Break/Continue/FFI/Import/Type: no locals.
    return nil
}

fn maybe_add_capture(name, declared, seen, out) {
    if is_non_capturable_ident_name(name) { return nil }
    if declared[name] == true { return nil }
    if seen[name] == true { return nil }
    seen[name] = true
    oren_list_push(out, name)
    return nil
}

fn lambda_collect_used_in_expression(exp, declared, seen, out) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Identifier" {
        maybe_add_capture(exp["value"], declared, seen, out)
        return nil
    }
    if et == "Function" {
        // Nested lambdas are their own closures.
        return nil
    }
    if et == "Call" {
        lambda_collect_used_in_expression(exp["fn"], declared, seen, out)
        var i = 0
        while i < oren_list_len(exp["args"]) {
            lambda_collect_used_in_expression(exp["args"][i], declared, seen, out)
            i = i + 1
        }
        if exp["spread"] != nil { lambda_collect_used_in_expression(exp["spread"], declared, seen, out) }
        return nil
    }
    if et == "Prefix" { lambda_collect_used_in_expression(exp["right"], declared, seen, out); return nil }
    if et == "Infix" {
        lambda_collect_used_in_expression(exp["left"], declared, seen, out)
        lambda_collect_used_in_expression(exp["right"], declared, seen, out)
        return nil
    }
    if et == "If" {
        lambda_collect_used_in_expression(exp["cond"], declared, seen, out)
        lambda_collect_used_in_statement(exp["consq"], declared, seen, out)
        if exp["alt"] != nil { lambda_collect_used_in_statement(exp["alt"], declared, seen, out) }
        return nil
    }
    if et == "Member" {
        lambda_collect_used_in_expression(exp["left"], declared, seen, out)
        return nil
    }
    if et == "Index" {
        lambda_collect_used_in_expression(exp["left"], declared, seen, out)
        lambda_collect_used_in_expression(exp["index"], declared, seen, out)
        return nil
    }
    if et == "Array" {
        var j = 0
        while j < oren_list_len(exp["elements"]) {
            lambda_collect_used_in_expression(exp["elements"][j], declared, seen, out)
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        while k < oren_list_len(exp["pairs"]) {
            var pair = exp["pairs"][k]
            lambda_collect_used_in_expression(pair["key"], declared, seen, out)
            lambda_collect_used_in_expression(pair["value"], declared, seen, out)
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { lambda_collect_used_in_expression(exp["call"], declared, seen, out); return nil }
    return nil
}

fn lambda_collect_used_in_statement(stmt, declared, seen, out) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" { lambda_collect_used_in_expression(stmt["value"], declared, seen, out); return nil }
    if st == "Assign" {
        maybe_add_capture(stmt["name"]["value"], declared, seen, out)
        lambda_collect_used_in_expression(stmt["value"], declared, seen, out)
        return nil
    }
    if st == "Set" {
        if stmt["left"]["type"] == "Identifier" {
            maybe_add_capture(stmt["left"]["value"], declared, seen, out)
        } else {
            lambda_collect_used_in_expression(stmt["left"], declared, seen, out)
        }
        lambda_collect_used_in_expression(stmt["value"], declared, seen, out)
        return nil
    }
    if st == "Return" { lambda_collect_used_in_expression(stmt["value"], declared, seen, out); return nil }
    if st == "ExprStmt" { lambda_collect_used_in_expression(stmt["expr"], declared, seen, out); return nil }
    if st == "Block" {
        var i = 0
        while i < oren_list_len(stmt["stmts"]) {
            lambda_collect_used_in_statement(stmt["stmts"][i], declared, seen, out)
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        lambda_collect_used_in_expression(stmt["cond"], declared, seen, out)
        lambda_collect_used_in_statement(stmt["body"], declared, seen, out)
        return nil
    }
    if st == "For" {
        lambda_collect_used_in_statement(stmt["init"], declared, seen, out)
        lambda_collect_used_in_expression(stmt["cond"], declared, seen, out)
        lambda_collect_used_in_statement(stmt["post"], declared, seen, out)
        lambda_collect_used_in_statement(stmt["body"], declared, seen, out)
        return nil
    }
    if st == "Spawn" { lambda_collect_used_in_expression(stmt["call"], declared, seen, out); return nil }
    return nil
}

fn lambda_free_vars(fun) {
    var declared = {}
    // params
    var i = 0
    while i < oren_list_len(fun["params"]) {
        declared[fun["params"][i]["value"]] = true
        i = i + 1
    }
    // var decls (any depth)
    lambda_collect_declared_in_statement(fun["body"], declared)

    var out = []
    var seen = {}
    lambda_collect_used_in_statement(fun["body"], declared, seen, out)
    return out
}

fn collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Function" {
        if exp["name"] == "" {
            if exp["lambda_name"] == nil {
                exp["lambda_name"] = lambda_gensym(t, unit_prefix)
                exp["captures"] = lambda_free_vars(exp)
                oren_list_push(t["lambda_defs"], {"name": exp["lambda_name"], "fun": exp, "captures": exp["captures"], "aliases": unit_aliases})
            }
            // Still recurse to find nested lambdas inside this lambda body (as expressions).
            collect_lambdas_in_statement(t, unit_prefix, unit_aliases, exp["body"])
            return nil
        }
        // Named function literals are top-level decls in this compiler; ignore.
        return nil
    }
    if et == "Call" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["fn"])
        var i = 0
        while i < oren_list_len(exp["args"]) {
            collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["args"][i])
            i = i + 1
        }
        return nil
    }
    if et == "Prefix" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["right"]); return nil }
    if et == "Infix" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["left"])
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["right"])
        return nil
    }
    if et == "If" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["cond"])
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, exp["consq"])
        if exp["alt"] != nil { collect_lambdas_in_statement(t, unit_prefix, unit_aliases, exp["alt"]) }
        return nil
    }
    if et == "Member" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["left"]); return nil }
    if et == "Index" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["left"])
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["index"])
        return nil
    }
    if et == "Array" {
        var j = 0
        while j < oren_list_len(exp["elements"]) {
            collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["elements"][j])
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var k = 0
        while k < oren_list_len(exp["pairs"]) {
            var pair = exp["pairs"][k]
            collect_lambdas_in_expression(t, unit_prefix, unit_aliases, pair["key"])
            collect_lambdas_in_expression(t, unit_prefix, unit_aliases, pair["value"])
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, exp["call"]); return nil }
    return nil
}

fn collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt) {
    if stmt == nil { return nil }
    var st = stmt["type"]
    if st == "Var" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["value"]); return nil }
    if st == "Assign" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["value"]); return nil }
    if st == "Set" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["left"])
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["value"])
        return nil
    }
    if st == "Return" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["value"]); return nil }
    if st == "ExprStmt" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["expr"]); return nil }
    if st == "Block" {
        var i = 0
        while i < oren_list_len(stmt["stmts"]) {
            collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt["stmts"][i])
            i = i + 1
        }
        return nil
    }
    if st == "While" {
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["cond"])
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt["body"])
        return nil
    }
    if st == "For" {
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt["init"])
        collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["cond"])
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt["post"])
        collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt["body"])
        return nil
    }
    if st == "Spawn" { collect_lambdas_in_expression(t, unit_prefix, unit_aliases, stmt["call"]); return nil }
    return nil
}

fn transpile_lambda_def(t, def) {
    var lname = def["name"]
    var fun = def["fun"]
    var caps = def["captures"]
    t["aliases"] = def["aliases"]

    emit(t, lambda_sig_by_name(lname) + " {")
    indent_more(t)

    if oren_list_len(caps) == 0 {
        emit(t, "(void)env;")
    } else {
        emit(t, "OrenList* __env = (OrenList*)env;")
        emit(t, "if (!__env || __env->count != " + oren_int_to_string(oren_list_len(caps)) + ") { oren_panic(\"closure env mismatch\"); }")
        var i = 0
        while i < oren_list_len(caps) {
            var nm = caps[i]
            emit(t, "OrenValue " + c_ident(nm) + " = __env->items[" + oren_int_to_string(i) + "];")
            i = i + 1
        }
    }

    var pc = oren_list_len(fun["params"])
    var fixed = fun_varargs_fixed(fun)
    if pc == 0 {
        emit(t, "(void)argc;")
        emit(t, "(void)argv;")
    } else {
        if fixed < 0 {
            emit(t, "if (argc != " + oren_int_to_string(pc) + ") { oren_panic(\"arity mismatch\"); }")
            var j = 0
            while j < pc {
                emit(t, "OrenValue " + c_ident(fun["params"][j]["value"]) + " = argv[" + oren_int_to_string(j) + "];")
                j = j + 1
            }
        } else {
            emit(t, "if (argc < " + oren_int_to_string(fixed) + ") { oren_panic(\"arity mismatch\"); }")
            var j2 = 0
            while j2 < fixed {
                emit(t, "OrenValue " + c_ident(fun["params"][j2]["value"]) + " = argv[" + oren_int_to_string(j2) + "];")
                j2 = j2 + 1
            }
            var rest_name = fun["params"][pc - 1]["value"]
            emit(t, "OrenValue " + c_ident(rest_name) + " = oren_new_list(0);")
            emit(t, "for (int __i = " + oren_int_to_string(fixed) + "; __i < argc; __i++) {")
            emit(t, "    oren_list_push(" + c_ident(rest_name) + ", argv[__i]);")
            emit(t, "}")
        }
    }

    // Stack safety: deterministic recursion guard for C backend binaries.
    emit(t, "oren_call_depth_enter();")

    var body = fun["body"]["stmts"]
    var k = 0
    while k < oren_list_len(body) {
        emit(t, transpile_statement(t, body[k]))
        k = k + 1
    }
    emit(t, "oren_call_depth_exit(); return OREN_NIL;")

    indent_less(t)
    emit(t, "}")
}

// ----- Transpiler core -----

fn transpile_statement(t, stmt) {
    if stmt["type"] == "Var" {
        var v = transpile_expression(t, stmt["value"])
        _transpiler_inty_set(t, stmt["name"]["value"], _transpiler_expr_is_inty(t, stmt["value"]))
        return "OrenValue " + c_ident(stmt["name"]["value"]) + " = " + v + ";"
    }
    if stmt["type"] == "Spawn" {
        var call = stmt["call"]
        if call == nil || call["type"] != "Call" { return "/* spawn expects Call */" }
        var fn_expr = transpile_expression(t, call["fn"])
        var n = oren_list_len(call["args"])
        if n == 0 { return "oren_spawn_call_list(" + fn_expr + ", oren_new_list(0));" }
        var args = ""
        var i = 0
        while i < n {
            if i > 0 { args = args + ", " }
            args = args + transpile_expression(t, call["args"][i])
            i = i + 1
        }
        return "oren_spawn_call_list(" + fn_expr + ", oren_new_list_from_array(" + oren_int_to_string(n) + ", (OrenValue[]){" + args + "}));"
    }
    if stmt["type"] == "Block" {
        var stmts = stmt["stmts"]
        var parts = []
        var inty_prev = _transpiler_inty_clone(_transpiler_inty_list(t))
        oren_list_push(parts, "{")
        oren_list_push(parts, CH_LF)
        var i = 0
        while i < oren_list_len(stmts) {
            oren_list_push(parts, "    " + transpile_statement(t, stmts[i]))
            oren_list_push(parts, CH_LF)
            i = i + 1
        }
        oren_list_push(parts, "}")
        t["inty"] = inty_prev
        return _transpiler_join_parts(parts)
    }
    if stmt["type"] == "Set" {
        if stmt["left"]["type"] == "Index" {
            var arr = transpile_expression(t, stmt["left"]["left"])
            var idx = transpile_expression(t, stmt["left"]["index"])
            var val = transpile_expression(t, stmt["value"])
            return "oren_index_set(" + arr + ", " + idx + ", " + val + ");"
        }
        if stmt["left"]["type"] == "Member" {
            var v_set = transpile_expression(t, stmt["value"])
            var ns = ns_resolve(t, stmt["left"])
            if ns != nil {
                if list_contains(t["functions"], ns["name"]) { return "/* cannot assign to function */" }
                return c_ident(ns["name"]) + " = " + v_set + ";"
            }
            var obj = transpile_expression(t, stmt["left"]["left"])
            return "oren_set_attr(" + obj + ", " + CH_QUOTE + stmt["left"]["prop"]["value"] + CH_QUOTE + ", " + v_set + ");"
        }
        return "// unsupported set"
    }
    if stmt["type"] == "Assign" {
        var v_assign = transpile_expression(t, stmt["value"])
        _transpiler_inty_set(t, stmt["name"]["value"], _transpiler_expr_is_inty(t, stmt["value"]))
        return c_ident(stmt["name"]["value"]) + " = " + v_assign + ";"
    }
    if stmt["type"] == "Return" {
        var v_ret = transpile_expression(t, stmt["value"])
        // Ensure the return expression is evaluated *before* we decrement call depth,
        // otherwise `return f(...)` (including recursion) would not count correctly.
        return "{ OrenValue __oren_ret = " + v_ret + "; oren_call_depth_exit(); return __oren_ret; }"
    }
    if stmt["type"] == "ExprStmt" {
        if stmt["expr"]["type"] == "If" {
            return transpile_if(t, stmt["expr"])
        }
        var v_expr = transpile_expression(t, stmt["expr"])
        return v_expr + ";"
    }
    if stmt["type"] == "While" {
        var fast = _transpiler_match_fast_list_int_while(t, stmt)
        if fast != nil { return _transpiler_emit_fast_list_int_while(t, stmt, fast) }
        return _transpiler_emit_while_basic(t, stmt)
    }
    if stmt["type"] == "For" {
        var init_s = transpile_for_header_stmt(t, stmt["init"])
        var post_s = transpile_for_header_stmt(t, stmt["post"])
        var cond_s = "1"
        if stmt["cond"] != nil {
            cond_s = "oren_is_truthy(" + transpile_expression(t, stmt["cond"]) + ")"
        }
        var tick2 = tmp_gensym(t, "gc_tick")
        var inner2_parts = []
        oren_list_push(inner2_parts, "    if (((" + tick2 + "++) & 255u) == 0u) { oren_gc_safepoint(); }")
        oren_list_push(inner2_parts, CH_LF)
        var j = 0
        while j < oren_list_len(stmt["body"]["stmts"]) {
            oren_list_push(inner2_parts, "    " + transpile_statement(t, stmt["body"]["stmts"][j]))
            oren_list_push(inner2_parts, CH_LF)
            j = j + 1
        }
        var inner2 = _transpiler_join_parts(inner2_parts)
        return "{ uint64_t " + tick2 + " = 0; for (" + init_s + "; " + cond_s + "; " + post_s + ") {" + CH_LF + inner2 + "} }"
    }
    if stmt["type"] == "Break" {
        return "break;"
    }
    if stmt["type"] == "Continue" {
        return "continue;"
    }
    if stmt["type"] == "FFI" {
        return "// ffi " + c_ident(stmt["name"]["value"])
    }
    return "// unknown stmt"
}

fn transpile_if(t, expr) {
    var cond = transpile_expression(t, expr["cond"])
    var inty_base = _transpiler_inty_clone(_transpiler_inty_list(t))
    var parts = []
    oren_list_push(parts, "if (oren_is_truthy(" + cond + ")) {")
    oren_list_push(parts, CH_LF)
    t["inty"] = _transpiler_inty_clone(inty_base)
    var i = 0
    while i < oren_list_len(expr["consq"]["stmts"]) {
        oren_list_push(parts, "    " + transpile_statement(t, expr["consq"]["stmts"][i]))
        oren_list_push(parts, CH_LF)
        i = i + 1
    }
    var inty_consq = _transpiler_inty_clone(_transpiler_inty_list(t))
    oren_list_push(parts, "}")
    if expr["alt"] != nil {
        t["inty"] = _transpiler_inty_clone(inty_base)
        oren_list_push(parts, " else {")
        oren_list_push(parts, CH_LF)
        i = 0
        while i < oren_list_len(expr["alt"]["stmts"]) {
            oren_list_push(parts, "    " + transpile_statement(t, expr["alt"]["stmts"][i]))
            oren_list_push(parts, CH_LF)
            i = i + 1
        }
        oren_list_push(parts, "}")
    }
    var inty_alt = inty_base
    if expr["alt"] != nil { inty_alt = _transpiler_inty_clone(_transpiler_inty_list(t)) }
    t["inty"] = _transpiler_inty_intersect(inty_consq, inty_alt)
    return _transpiler_join_parts(parts)
}

fn transpile_expression(t, exp) {
    var et = exp["type"]
    if et == "Call" {
        var fast_items = t["fast_list_items"]
        if fast_items != nil {
            if exp["fn"] != nil && exp["fn"]["type"] == "Identifier" {
                var nm = exp["fn"]["value"]
                if str_eq(nm, "oren_list_int_get") || str_eq(nm, "STD_list_int_get") {
                    var args = exp["args"]
                    if args != nil && oren_list_len(args) == 2 {
                        var list_name = _transpiler_is_ident(args[0])
                        var idx_name = _transpiler_is_ident(args[1])
                        if list_name != nil && idx_name != nil && str_eq(idx_name, t["fast_idx_name"]) {
                            var items = fast_items[list_name]
                            if items != nil { return items + "[" + t["fast_idx_c"] + "]" }
                        }
                    }
                }
            }
        }
    }
    if et == "Integer" { return "oren_int(" + int_str(parse_int_lit(exp["value"])) + ")" }
    if et == "Float" { return "oren_float(" + exp["value"] + ")" }
    if et == "String" { return "oren_string_const(" + CH_QUOTE + c_escape_string(exp["value"]) + CH_QUOTE + ")" }
    if et == "Boolean" {
        if exp["value"] { return "OREN_TRUE" }
        return "OREN_FALSE"
    }
    if et == "Nil" { return "OREN_NIL" }
    if et == "Identifier" {
        var name_id = exp["value"]
        // First-class function values in C backend: wrap known functions into OrenValue via oren_func.
        if list_contains(t["functions"], name_id) {
            return "oren_func(" + fnwrap_name(name_id) + ", NULL)"
        }
        return c_ident(name_id)
    }
    if et == "Function" {
        // Anonymous function literal (lambda) lowers to a closure (capture-by-value).
        if exp["name"] != "" { return "/* function decl is not an expression */ OREN_NIL" }
        var lname = exp["lambda_name"]
        if lname == nil { return "/* lambda not collected */ OREN_NIL" }
        var caps = exp["captures"]
        if caps == nil || oren_list_len(caps) == 0 { return "oren_closure(" + lname + ", 0)" }
        var args = ""
        var i = 0
        while i < oren_list_len(caps) {
            if i > 0 { args = args + ", " }
            args = args + transpile_expression(t, {"type": "Identifier", "value": caps[i]})
            i = i + 1
        }
        return "oren_closure_from_array(" + lname + ", " + oren_int_to_string(oren_list_len(caps)) + ", (OrenValue[]){" + args + "})"
    }
    if et == "Prefix" {
        var right = transpile_expression(t, exp["right"])
        // Unary minus:
        // - Use multiplication by -1 so float negation preserves IEEE-754 sign bit (notably -0.0).
        // - Integers have deterministic wrap semantics in the runtime, so -1*x is consistent.
        if exp["op"] == "-" {
            if _transpiler_expr_is_inty(t, exp["right"]) {
                return "oren_int_neg_fast(" + right + ")"
            }
            return "oren_mul(oren_int(-1), " + right + ")"
        }
        if exp["op"] == "!" { return "oren_bool(!oren_is_truthy(" + right + "))" }
        if exp["op"] == "~" {
            if _transpiler_expr_is_inty(t, exp["right"]) {
                return "oren_int_bnot_fast(" + right + ")"
            }
            return "oren_bnot(" + right + ")"
        }
    }
    if et == "Infix" {
        var left = transpile_expression(t, exp["left"])
        var right_expr = transpile_expression(t, exp["right"])
        var op = exp["op"]
        var left_inty = _transpiler_expr_is_inty(t, exp["left"])
        var right_inty = _transpiler_expr_is_inty(t, exp["right"])
        if left_inty && right_inty {
            if op == "+" { return "oren_int_add_fast(" + left + ", " + right_expr + ")" }
            if op == "-" { return "oren_int_sub_fast(" + left + ", " + right_expr + ")" }
            if op == "*" { return "oren_int_mul_fast(" + left + ", " + right_expr + ")" }
            if op == "/" { return "oren_int_div_fast(" + left + ", " + right_expr + ")" }
            if op == "%" { return "oren_int_mod_fast(" + left + ", " + right_expr + ")" }
            if op == "&" { return "oren_int_band_fast(" + left + ", " + right_expr + ")" }
            if op == "|" { return "oren_int_bor_fast(" + left + ", " + right_expr + ")" }
            if op == "^" { return "oren_int_bxor_fast(" + left + ", " + right_expr + ")" }
            if op == "<<" { return "oren_int_shl_fast(" + left + ", " + right_expr + ")" }
            if op == ">>" { return "oren_int_shr_fast(" + left + ", " + right_expr + ")" }
        }
        if op == "+" { return "oren_add(" + left + ", " + right_expr + ")" }
        if op == "-" { return "oren_sub(" + left + ", " + right_expr + ")" }
        if op == "*" { return "oren_mul(" + left + ", " + right_expr + ")" }
        if op == "/" { return "oren_div(" + left + ", " + right_expr + ")" }
        if op == "%" { return "oren_mod(" + left + ", " + right_expr + ")" }
        if op == "&" { return "oren_band(" + left + ", " + right_expr + ")" }
        if op == "|" { return "oren_bor(" + left + ", " + right_expr + ")" }
        if op == "^" { return "oren_bxor(" + left + ", " + right_expr + ")" }
        if op == "<<" { return "oren_shl(" + left + ", " + right_expr + ")" }
        if op == ">>" { return "oren_shr(" + left + ", " + right_expr + ")" }
        if op == "==" { return "oren_eq(" + left + ", " + right_expr + ")" }
        if op == "!=" { return "oren_neq(" + left + ", " + right_expr + ")" }
        if op == "&&" { return "oren_bool(oren_is_truthy(" + left + ") && oren_is_truthy(" + right_expr + "))" }
        if op == "||" { return "oren_bool(oren_is_truthy(" + left + ") || oren_is_truthy(" + right_expr + "))" }
        if op == "<" { return "oren_lt(" + left + ", " + right_expr + ")" }
        if op == ">" { return "oren_gt(" + left + ", " + right_expr + ")" }
        if op == "<=" { return "oren_lte(" + left + ", " + right_expr + ")" }
        if op == ">=" { return "oren_gte(" + left + ", " + right_expr + ")" }
    }
    if et == "Call" {
        var fn_sym = ""
        // Determine direct-call symbol before transpiling `exp["fn"]`, because a known function identifier
        // is lowered to `oren_func(...)` (a value) in expression position.
        if exp["fn"]["type"] == "Identifier" {
            var nm = exp["fn"]["value"]
            if list_contains(t["functions"], nm) { fn_sym = nm }
            if starts_with(nm, "oren_") { fn_sym = nm }
        } else {
            if exp["fn"]["type"] == "Member" {
                var ns2 = ns_resolve(t, exp["fn"])
                if ns2 != nil {
                    if list_contains(t["functions"], ns2["name"]) { fn_sym = ns2["name"] }
                }
            }
        }

        var fn_expr = transpile_expression(t, exp["fn"])
        var spread = exp["spread"]

        var args_s = ""
        var i = 0
        while i < oren_list_len(exp["args"]) {
            if i > 0 { args_s = args_s + ", " }
            args_s = args_s + transpile_expression(t, exp["args"][i])
            i = i + 1
        }

        if exp["fn"]["type"] == "Identifier" {
            var name = exp["fn"]["value"]
            var argc = oren_list_len(exp["args"])
            if spread == nil {
                if (str_eq(name, "oren_list_int_len") || str_eq(name, "STD_list_int_len")) && argc == 1 {
                    return "oren_list_int_len_fast(" + args_s + ")"
                }
                if (str_eq(name, "oren_list_int_push") || str_eq(name, "STD_list_int_push")) && argc == 2 {
                    return "oren_list_int_push_fast(" + args_s + ")"
                }
                if (str_eq(name, "oren_list_int_get") || str_eq(name, "STD_list_int_get")) && argc == 2 {
                    return "oren_list_int_get_fast(" + args_s + ")"
                }
                if (str_eq(name, "oren_list_int_set") || str_eq(name, "STD_list_int_set")) && argc == 3 {
                    return "oren_list_int_set_fast(" + args_s + ")"
                }
            }
            if str_eq(name, "print") {
                if spread != nil {
                    // print(..., xs...) lower to runtime list-based helpers.
                    var arg0 = nil
                    if argc > 0 { arg0 = exp["args"][0] }

                    var is_fmt = false
                    if arg0 != nil && arg0["type"] == "String" {
                        if contains_curly_braces(arg0["value"]) {
                            if argc > 1 || spread != nil { is_fmt = true }
                        }
                    }

                    if is_fmt {
                        var fmt_arg = transpile_expression(t, arg0)
                        var rest = []
                        var k = 1
                        while k < argc {
                            oren_list_push(rest, exp["args"][k])
                            k = k + 1
                        }
                        return "oren_print_fmt_spread(" + fmt_arg + ", " + transpile_args_list_expr(t, rest) + ", " + transpile_expression(t, spread) + ")"
                    }
                    return "oren_print_spread(" + transpile_args_list_expr(t, exp["args"]) + ", " + transpile_expression(t, spread) + ")"
                }

                if argc == 0 { return "oren_print_multi(0)" }
                
                var is_fmt = false
                if argc > 1 {
                    var arg0 = exp["args"][0]
                    if arg0["type"] == "String" {
                        if contains_curly_braces(arg0["value"]) {
                            is_fmt = true
                        }
                    }
                }
                
                if is_fmt {
                    var fmt_arg = transpile_expression(t, exp["args"][0])
                    var other_args = ""
                    var k = 1
                    while k < argc {
                        if k > 1 { other_args = other_args + ", " }
                        other_args = other_args + transpile_expression(t, exp["args"][k])
                        k = k + 1
                    }
                    var count_others = argc - 1
                    return "oren_print_fmt(" + fmt_arg + ", " + int_str(count_others) + ", " + other_args + ")"
                }

                if argc == 1 { return "oren_print(" + args_s + ")" }
                return "oren_print_multi(" + int_str(argc) + ", " + args_s + ")"
            }
            if str_eq(name, "py_import") {
                if argc == 1 { return "oren_py_import(" + args_s + ")" }
            }
            if str_eq(name, "py_release") {
                if argc == 1 { return "oren_py_release(" + args_s + ")" }
            }
            if str_eq(name, "system") {
                if argc == 1 { return "oren_system(" + args_s + ")" }
            }
            if str_eq(name, "exit") {
                if argc == 1 { return "oren_exit(" + args_s + ")" }
            }
            if str_eq(name, "iadd") {
                if argc == 2 { return "oren_add(" + args_s + ")" }
                return "/* iadd expects 2 args */ OREN_NIL"
            }
        }

        if exp["fn"]["type"] == "Member" {
            var ns = ns_resolve(t, exp["fn"])
            if ns != nil {
                if ns["is_ns"] == true { fn_expr = ns["name"] }
            }
        }

        var use_call_obj = true
        if fn_sym != "" { use_call_obj = false }
        if exp["fn"]["type"] == "Identifier" {
            if starts_with(exp["fn"]["value"], "oren_") { use_call_obj = false }
        }
        // Varargs functions require uniform-call lowering (argc/argv) in the C backend,
        // because C does not support calling a fixed-arity function with variable arity.
        // The fnwrap packs rest args into a list and calls the real function.
        if fn_sym != "" && t["func_varargs_fixed"][fn_sym] != nil {
            use_call_obj = true
        }
        if spread != nil {
            // Spread calls must go through a list-based apply helper.
            use_call_obj = true
        }
        if use_call_obj {
            var argc = oren_list_len(exp["args"])
            if spread != nil {
                return "oren_call_obj_spread(" + fn_expr + ", " + transpile_args_list_expr(t, exp["args"]) + ", " + transpile_expression(t, spread) + ")"
            }
            if argc == 0 { return "oren_call_obj_argv(" + fn_expr + ", 0, NULL)" }
            return "oren_call_obj_argv(" + fn_expr + ", " + int_str(argc) + ", (OrenValue[]){" + args_s + "})"
        }
        // Direct call
        if fn_sym != "" { return c_fn_name(fn_sym) + "(" + args_s + ")" }
        return fn_expr + "(" + args_s + ")"
    }
    if et == "SpawnExpr" {
        var call = exp["call"]
        if call == nil || call["type"] != "Call" { return "/* spawn expects Call */ OREN_NIL" }
        var fn_expr = transpile_expression(t, call["fn"])
        var n = oren_list_len(call["args"])
        if n == 0 { return "oren_spawn_call_list(" + fn_expr + ", oren_new_list(0))" }
        var args = ""
        var i = 0
        while i < n {
            if i > 0 { args = args + ", " }
            args = args + transpile_expression(t, call["args"][i])
            i = i + 1
        }
        return "oren_spawn_call_list(" + fn_expr + ", oren_new_list_from_array(" + oren_int_to_string(n) + ", (OrenValue[]){" + args + "}))"
    }
    if et == "Member" {
        var ns = ns_resolve(t, exp)
        if ns != nil {
            if list_contains(t["functions"], ns["name"]) {
                return "oren_func(" + fnwrap_name(ns["name"]) + ", NULL)"
            }
            return c_ident(ns["name"])
        }
        var left = transpile_expression(t, exp["left"])
        return "oren_get_attr(" + left + ", " + CH_QUOTE + exp["prop"]["value"] + CH_QUOTE + ")"
    }
    if et == "Array" {
        var els = ""
        var i = 0
        while i < oren_list_len(exp["elements"]) {
            if i > 0 { els = els + ", " }
            els = els + transpile_expression(t, exp["elements"][i])
            i = i + 1
        }
        var count = oren_list_len(exp["elements"])
        if count == 0 { return "oren_new_list(0)" }
        return "oren_new_list_from_array(" + int_str(count) + ", (OrenValue[]){" + els + "})"
    }
    if et == "Index" {
        var left_expr = transpile_expression(t, exp["left"])
        var idx = transpile_expression(t, exp["index"])
        return "oren_list_get(" + left_expr + ", " + idx + ")"
    }
    if et == "Hash" {
        var parts = ""
        var i_pairs = 0
        var count_pairs = oren_list_len(exp["pairs"])
        while i_pairs < count_pairs {
            if i_pairs > 0 { parts = parts + ", " }
            var pair = exp["pairs"][i_pairs]
            parts = parts + transpile_expression(t, pair["key"]) + ", " + transpile_expression(t, pair["value"])
            i_pairs = i_pairs + 1
        }
        if count_pairs == 0 { return "oren_new_map(0)" }
        return "oren_new_map_from_pairs(" + int_str(count_pairs) + ", (OrenValue[]){" + parts + "})"
    }
    return "/* unknown expr */ OREN_NIL"
}

fn transpile_function(t, func_decl) {
    emit(t, function_sig(func_decl) + " {")
    indent_more(t)
    t["inty"] = []
    // Stack safety: deterministic recursion guard for C backend binaries.
    emit(t, "oren_call_depth_enter();")
    var i = 0
    while i < oren_list_len(func_decl["body"]["stmts"]) {
        emit(t, transpile_statement(t, func_decl["body"]["stmts"][i]))
        i = i + 1
    }
    emit(t, "oren_call_depth_exit(); return OREN_NIL;")
    indent_less(t)
    emit(t, "}")

    // Uniform-call wrapper so functions can be used as first-class function values.
    var fname = func_decl["name"]
    var fixed = fun_varargs_fixed(func_decl)
    emit(t, fnwrap_sig_by_name(fname) + " {")
    indent_more(t)
    emit(t, "(void)env;")
    var pc = oren_list_len(func_decl["params"])
    if fixed < 0 {
        emit(t, "if (argc != " + int_str(pc) + ") { oren_panic(\"arity mismatch\"); }")
        var args2 = ""
        var k = 0
        while k < pc {
            if k > 0 { args2 = args2 + ", " }
            args2 = args2 + "argv[" + int_str(k) + "]"
            k = k + 1
        }
        emit(t, "return " + c_fn_name(fname) + "(" + args2 + ");")
    } else {
        emit(t, "if (argc < " + int_str(fixed) + ") { oren_panic(\"arity mismatch\"); }")
        emit(t, "OrenValue __rest = oren_new_list(0);")
        emit(t, "for (int __i = " + int_str(fixed) + "; __i < argc; __i++) {")
        emit(t, "    oren_list_push(__rest, argv[__i]);")
        emit(t, "}")
        var args3 = ""
        var k2 = 0
        while k2 < fixed {
            if k2 > 0 { args3 = args3 + ", " }
            args3 = args3 + "argv[" + int_str(k2) + "]"
            k2 = k2 + 1
        }
        if fixed > 0 { args3 = args3 + ", " }
        args3 = args3 + "__rest"
        emit(t, "return " + c_fn_name(fname) + "(" + args3 + ");")
    }
    indent_less(t)
    emit(t, "}")
}

fn transpile_for_header_stmt(t, stmt) {
    if stmt == nil { return "" }
    if stmt["type"] == "Var" {
        var v = transpile_expression(t, stmt["value"])
        _transpiler_inty_set(t, stmt["name"]["value"], _transpiler_expr_is_inty(t, stmt["value"]))
        return "OrenValue " + c_ident(stmt["name"]["value"]) + " = " + v
    }
    if stmt["type"] == "Assign" {
        var v_assign = transpile_expression(t, stmt["value"])
        _transpiler_inty_set(t, stmt["name"]["value"], _transpiler_expr_is_inty(t, stmt["value"]))
        return c_ident(stmt["name"]["value"]) + " = " + v_assign
    }
    if stmt["type"] == "Set" {
        // Support index assignments in `for` headers (needed by `for x in ...` desugaring).
        if stmt["left"] != nil && stmt["left"]["type"] == "Index" {
            var arr = transpile_expression(t, stmt["left"]["left"])
            var idx = transpile_expression(t, stmt["left"]["index"])
            var val = transpile_expression(t, stmt["value"])
            return "oren_index_set(" + arr + ", " + idx + ", " + val + ")"
        }
        // Member assignments are not allowed for structs; ignore here.
        return ""
    }
    if stmt["type"] == "ExprStmt" {
        return transpile_expression(t, stmt["expr"])
    }
    return ""
}

// Helpers needed for transpile_entry
fn dirname(path) {
    var i = oren_string_len(path) - 1
    while i >= 0 {
        var ch = oren_string_char_at(path, i)
        if ch == "/" || ch == "\\" {
            if i == 0 { return ch }
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

fn collect_parts(program) {
    var globals = []
    var functions = []
    var types = []
    var main_body = []
    var i = 0
    while i < oren_list_len(program["statements"]) {
        var s = program["statements"][i]
        if s["type"] == "Import" {
            // compile-time only
        } else {
            if s["type"] == "Type" {
                oren_list_push(types, s)
            } else {
                if s["type"] == "Var" {
                    // C backend: top-level `var` declares a global symbol, but the initializer
                    // must execute in source order (NOT hoisted ahead of other top-level statements).
                    //
                    // We model that as:
                    // - a global declaration (so other functions can reference it)
                    // - an `Assign` statement in `main_body` at the exact original position.
                    oren_list_push(globals, {"type": "VarDecl", "name": s["name"]})
                    oren_list_push(main_body, {"type": "Assign", "name": s["name"], "value": s["value"]})
                } else {
                    var is_fn_decl = false
                    if s["type"] == "ExprStmt" {
                        if s["expr"]["type"] == "Function" {
                            if s["expr"]["name"] != "" { is_fn_decl = true }
                        }
                    }
                    if is_fn_decl { oren_list_push(functions, s["expr"]) } else { oren_list_push(main_body, s) }
                }
            }
        }
        i = i + 1
    }
    return {"globals": globals, "functions": functions, "types": types, "main_body": main_body}
}

// Updated signature: pass MODULE_ORDER explicitly
fn transpile_entry(entry_path, program, module_order, root_aliases) {
    var units = []
    var i = 0
    
    // Process loaded modules
    while i < oren_list_len(module_order) {
        var mod2 = module_order[i]
        var parts = collect_parts(mod2["program"])
        oren_list_push(units, {"program": mod2["program"], "aliases": mod2["aliases"], "parts": parts, "prefix": mod2["prefix"]})
        i = i + 1
    }
    
    // Process root program
    var root_parts = collect_parts(program)
    oren_list_push(units, {"program": program, "aliases": root_aliases, "parts": root_parts, "prefix": "root"})

    var type_ns = {}
    i = 0
    while i < oren_list_len(units) {
        var types = units[i]["parts"]["types"]
        var j = 0
        while j < oren_list_len(types) {
            type_ns[types[j]["name"]["value"]] = true
            j = j + 1
        }
        i = i + 1
    }

    var t = new_transpiler()
    t["type_ns"] = type_ns

    var has_user_main = false

    // Preload all function names for direct-call lowering.
    i = 0
    while i < oren_list_len(units) {
        var funs = units[i]["parts"]["functions"]

        // Rolling: share function metadata extraction with other backends via CoreIR v0.
        // `funs` is already a list of Function nodes; treat it as a "statements" list for CoreIR.
        var meta = {"errors": []}
        coreir.collect_top_level_functions(meta, {"statements": funs}, "c backend v0")
        if meta["errors"] != nil && oren_list_len(meta["errors"]) > 0 {
            print("OREN_DIAG kind=transpiler code=1 msg=coreir metadata error")
            print("transpiler: coreir metadata error:")
            var ei = 0
            while ei < oren_list_len(meta["errors"]) {
                print(meta["errors"][ei])
                ei = ei + 1
            }
            oren_exit(1)
        }

        var order = meta["func_decl_order"]
        if order != nil {
            var j = 0
            while j < oren_list_len(order) {
                var nm = order[j]
                oren_list_push(t["functions"], nm)
                if nm == "main" { has_user_main = true }
                var vf = nil
                if meta["func_varargs_fixed"] != nil { vf = meta["func_varargs_fixed"][nm] }
                if vf != nil { t["func_varargs_fixed"][nm] = vf }
                j = j + 1
            }
        }

        var types = units[i]["parts"]["types"]
        var jt = 0
        while jt < oren_list_len(types) {
            oren_list_push(t["functions"], type_ctor_name(types[jt]))
            jt = jt + 1
        }
        i = i + 1
    }

    emit(t, "#include <stdio.h>")
    emit(t, "#include <stdlib.h>")
    emit(t, "#include <string.h>")
    emit(t, "#include " + CH_QUOTE + "runtime.h" + CH_QUOTE)
    emit(t, "")

    // Globals (all units).
    i = 0
    while i < oren_list_len(units) {
        var globals = units[i]["parts"]["globals"]
        var j = 0
        while j < oren_list_len(globals) {
            emit(t, "OrenValue " + c_ident(globals[j]["name"]["value"]) + ";")
            j = j + 1
        }
        i = i + 1
    }
    emit(t, "")

    // Collect all lambdas before emitting prototypes.
    i = 0
    while i < oren_list_len(units) {
        t["aliases"] = units[i]["aliases"]
        var pref = units[i]["prefix"]
        // function bodies
        var funs2 = units[i]["parts"]["functions"]
        var jf = 0
        while jf < oren_list_len(funs2) {
            collect_lambdas_in_statement(t, pref, units[i]["aliases"], funs2[jf]["body"])
            jf = jf + 1
        }
        // top-level statements
        var body2 = units[i]["parts"]["main_body"]
        var jb = 0
        while jb < oren_list_len(body2) {
            collect_lambdas_in_statement(t, pref, units[i]["aliases"], body2[jb])
            jb = jb + 1
        }
        i = i + 1
    }

    // Prototypes (functions + constructors).
    i = 0
    while i < oren_list_len(units) {
        var funs = units[i]["parts"]["functions"]
        var j = 0
        while j < oren_list_len(funs) {
            emit(t, function_sig(funs[j]) + ";")
            emit(t, fnwrap_sig_by_name(funs[j]["name"]) + ";")
            j = j + 1
        }
        var types = units[i]["parts"]["types"]
        j = 0
        while j < oren_list_len(types) {
            emit(t, type_ctor_sig(types[j]) + ";")
            emit(t, fnwrap_sig_by_name(type_ctor_name(types[j])) + ";")
            j = j + 1
        }
        i = i + 1
    }
    // Lambda prototypes.
    i = 0
    while i < oren_list_len(t["lambda_defs"]) {
        emit(t, lambda_sig_by_name(t["lambda_defs"][i]["name"]) + ";")
        i = i + 1
    }
    emit(t, "")

    // Function bodies (functions + constructors).
    i = 0
    while i < oren_list_len(t["lambda_defs"]) {
        transpile_lambda_def(t, t["lambda_defs"][i])
        i = i + 1
    }
    i = 0
    while i < oren_list_len(units) {
        t["aliases"] = units[i]["aliases"]
        var funs = units[i]["parts"]["functions"]
        var j = 0
        while j < oren_list_len(funs) {
            transpile_function(t, funs[j])
            j = j + 1
        }
        var types = units[i]["parts"]["types"]
        j = 0
        while j < oren_list_len(types) {
            transpile_type_ctor(t, types[j])
            j = j + 1
        }
        i = i + 1
    }

    emit(t, "int main(int argc, char **argv) {")
    indent_more(t)
    emit(t, "oren_init(argc, argv);")

    // Register globals as GC roots
    i = 0
    while i < oren_list_len(units) {
        var globals = units[i]["parts"]["globals"]
        var j = 0
        while j < oren_list_len(globals) {
            emit(t, "oren_register_root(&" + c_ident(globals[j]["name"]["value"]) + ");")
            j = j + 1
        }
        i = i + 1
    }

    // Execute module top-level statements first (excluding root unit).
    i = 0
    while i < oren_list_len(units) - 1 {
        t["aliases"] = units[i]["aliases"]
        t["inty"] = []
        var body = units[i]["parts"]["main_body"]
        var j = 0
        while j < oren_list_len(body) {
            emit(t, transpile_statement(t, body[j]))
            j = j + 1
        }
        i = i + 1
    }

    // Root top-level statements last.
    t["aliases"] = units[oren_list_len(units) - 1]["aliases"]
    t["inty"] = []
    var root_body = units[oren_list_len(units) - 1]["parts"]["main_body"]
    i = 0
    while i < oren_list_len(root_body) {
        emit(t, transpile_statement(t, root_body[i]))
        i = i + 1
    }

    // If the user defines `fn main()`, run it after all module top-level statements.
    // This matches native+AVM entry behavior (rolling parity).
    if has_user_main {
        emit(t, c_fn_name("main") + "();")
    }

    emit(t, "oren_shutdown();")
    emit(t, "return 0;")
    indent_less(t)
    emit(t, "}")

    _transpiler_flush_lines(t, false)
    return _transpiler_join_parts(t["chunks"])
}
