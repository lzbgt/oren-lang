var CH_QUOTE = cutils.CH_QUOTE
var CH_BACKSLASH = cutils.CH_BACKSLASH
var CH_LF = cutils.CH_LF
var CH_CR = cutils.CH_CR
var CH_TAB = cutils.CH_TAB

// ----- Transpiler helpers (delegates) -----
