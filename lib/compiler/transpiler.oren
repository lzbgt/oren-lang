fn indent_more(t) { return tcore.indent_more(t) }
fn indent_less(t) { return tcore.indent_less(t) }
fn _transpiler_join_parts(parts) { return tcore._transpiler_join_parts(parts) }
fn list_contains(lst, val) { return tcore.list_contains(lst, val) }
fn str_eq(a, b) { return tcore.str_eq(a, b) }
fn tmp_gensym(t, prefix) { return tcore.tmp_gensym(t, prefix) }

fn _transpiler_inty_list(t) { return tanalysis._transpiler_inty_list(t) }
fn _transpiler_inty_clone(xs) { return tanalysis._transpiler_inty_clone(xs) }
