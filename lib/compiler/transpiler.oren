fn c_escape_string(s) { return cutils.c_escape_string(s) }
fn int_str(n) { return cutils.int_str(n) }
fn parse_int_lit(s) { return cutils.parse_int_lit(s) }
fn function_sig(func_decl) { return cutils.function_sig(func_decl) }
fn fnwrap_name(name) { return cutils.fnwrap_name(name) }
fn fnwrap_sig_by_name(name) { return cutils.fnwrap_sig_by_name(name) }
fn lambda_sig_by_name(name) { return cutils.lambda_sig_by_name(name) }
fn starts_with(s, prefix) { return cutils.starts_with(s, prefix) }

fn collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt) { return tlambda.collect_lambdas_in_statement(t, unit_prefix, unit_aliases, stmt) }


fn _transpiler_emit_while_basic(t, stmt) {
    var cond = transpile_expression(t, stmt["cond"])
    var tick = tmp_gensym(t, "gc_tick")
    var inner_parts = []
    // PERF: do not call into safepoint on every iteration; the function call itself dominates
    // tight loops (lexer/parser), even though `oren_gc_safepoint` has an internal fast path.
    //
    // Poll GC once per ~64 iterations to keep GC responsive without burning CPU in loop bodies.
    oren_list_push(inner_parts, "    if (((" + tick + "++) & 255u) == 0u) { oren_gc_safepoint(); }")
    oren_list_push(inner_parts, CH_LF)
    var i = 0
    while i < oren_list_len(stmt["body"]["stmts"]) {
        oren_list_push(inner_parts, "    " + transpile_statement(t, stmt["body"]["stmts"][i]))
        oren_list_push(inner_parts, CH_LF)
        i = i + 1
    }
    var inner = _transpiler_join_parts(inner_parts)
    return "{ uint64_t " + tick + " = 0; while (oren_is_truthy(" + cond + ")) {" + CH_LF + inner + "} }"
}

fn _transpiler_match_fast_list_int_while(t, stmt) {
    if stmt == nil || stmt["type"] != "While" { return nil }
    var cond = stmt["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _transpiler_is_ident(cond["left"])
    var n_name = _transpiler_is_ident(cond["right"])
    if idx_name == nil || n_name == nil { return nil }
    var body = stmt["body"]["stmts"]
    if body == nil { return nil }
    var n = oren_list_len(body)
    if n < 1 { return nil }
    var last = body[n - 1]
    if _transpiler_is_simple_inc(last, idx_name) != true { return nil }
    var lists = []
    var i = 0
    while i < n - 1 {
        var r = _transpiler_stmt_collect_list_int_gets(t, body[i], idx_name, lists)
        if r["ok"] != true || r["uses_idx"] == true { return nil }
        lists = r["lists"]
        i = i + 1
    }
    if oren_list_len(lists) == 0 { return nil }
    return {"idx": idx_name, "n": n_name, "lists": lists, "body": body, "body_len": n - 1}
}

fn _transpiler_match_fast_list_while(t, stmt) {
    if stmt == nil || stmt["type"] != "While" { return nil }
    var cond = stmt["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _transpiler_is_ident(cond["left"])
    var n_name = _transpiler_is_ident(cond["right"])
    if idx_name == nil || n_name == nil { return nil }
    var body = stmt["body"]["stmts"]
    if body == nil { return nil }
    var n = oren_list_len(body)
    if n < 1 { return nil }
    var last = body[n - 1]
    if _transpiler_is_simple_inc(last, idx_name) != true { return nil }
    var lists = []
    var i = 0
    while i < n - 1 {
        var r = _transpiler_stmt_collect_list_gets(t, body[i], idx_name, lists)
        if r["ok"] != true || r["uses_idx"] == true { return nil }
        lists = r["lists"]
        i = i + 1
    }
    if oren_list_len(lists) == 0 { return nil }
    return {"idx": idx_name, "n": n_name, "lists": lists, "body": body, "body_len": n - 1}
}

fn _transpiler_match_fast_list_get_sum_while(t, stmt) {
    if stmt == nil || stmt["type"] != "While" { return nil }
    var cond = stmt["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _transpiler_is_ident(cond["left"])
    var n_name = _transpiler_is_ident(cond["right"])
    if idx_name == nil || n_name == nil { return nil }
    var body = stmt["body"]["stmts"]
    if body == nil { return nil }
    var n = oren_list_len(body)
    if n < 2 { return nil }
    var last = body[n - 1]
    if _transpiler_is_simple_inc(last, idx_name) != true { return nil }
    var sum_name = nil
    var lists = []
    var loads = []
    var i = 0
    while i < n - 1 {
        var st = body[i]
        var info = _transpiler_is_sum_add_list_get(t, st, idx_name)
        if info == nil { return nil }
        if sum_name == nil { sum_name = info["sum"] }
        else if str_eq(sum_name, info["sum"]) != true { return nil }
        var list_name = info["list"]
        if list_name == nil { return nil }
        if list_contains(lists, list_name) == false { oren_list_push(lists, list_name) }
        oren_list_push(loads, list_name)
        i = i + 1
    }
    if sum_name == nil { return nil }
    if str_eq(sum_name, idx_name) || str_eq(sum_name, n_name) { return nil }
    if oren_list_len(loads) == 0 { return nil }
    return {"idx": idx_name, "n": n_name, "sum": sum_name, "lists": lists, "loads": loads}
}

fn _transpiler_match_fast_list_int_push_while(t, stmt) {
    if stmt == nil || stmt["type"] != "While" { return nil }
    var cond = stmt["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _transpiler_is_ident(cond["left"])
    var right = cond["right"]
    var n_name = _transpiler_is_ident(right)
    var n_const = nil
    if n_name == nil {
        n_const = _transpiler_parse_int_lit_expr(right)
        if n_const == nil { return nil }
    }
    if idx_name == nil { return nil }
    if n_name == nil && n_const < 0 { return nil }
    var body = stmt["body"]["stmts"]
    if body == nil { return nil }
    var n = oren_list_len(body)
    if n < 1 { return nil }
    var last = body[n - 1]
    if _transpiler_is_simple_inc(last, idx_name) != true { return nil }
    var lists = []
    var pushes = []
    var i = 0
    while i < n - 1 {
        var st = body[i]
        if st == nil || st["type"] != "ExprStmt" { return nil }
        var exp = st["expr"]
        var list_name = _transpiler_is_list_int_push_call(t, exp)
        if list_name == nil { return nil }
        if list_contains(lists, list_name) { return nil }
        oren_list_push(lists, list_name)
        oren_list_push(pushes, {"list": list_name, "value": exp["args"][1]})
        i = i + 1
    }
    if oren_list_len(lists) == 0 { return nil }
    var pi = 0
    while pi < oren_list_len(pushes) {
        if _transpiler_expr_uses_any_ident(pushes[pi]["value"], lists) { return nil }
        pi = pi + 1
    }
    return {"idx": idx_name, "n": n_name, "n_const": n_const, "lists": lists, "pushes": pushes, "body_len": n - 1}
}

fn _transpiler_match_fast_list_push_while(t, stmt) {
    if stmt == nil || stmt["type"] != "While" { return nil }
    var cond = stmt["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _transpiler_is_ident(cond["left"])
    var right = cond["right"]
    var n_name = _transpiler_is_ident(right)
    var n_const = nil
    if n_name == nil {
        n_const = _transpiler_parse_int_lit_expr(right)
        if n_const == nil { return nil }
    }
    if idx_name == nil { return nil }
    if n_name == nil && n_const < 0 { return nil }
    var body = stmt["body"]["stmts"]
    if body == nil { return nil }
    var n = oren_list_len(body)
    if n < 1 { return nil }
    var last = body[n - 1]
    if _transpiler_is_simple_inc(last, idx_name) != true { return nil }
    var lists = []
    var pushes = []
    var i = 0
    while i < n - 1 {
        var st = body[i]
        if st == nil || st["type"] != "ExprStmt" { return nil }
        var exp = st["expr"]
        var list_name = _transpiler_is_list_push_call(t, exp)
        if list_name == nil { return nil }
        if list_contains(lists, list_name) { return nil }
        var args = exp["args"]
        var value_expr = args[1]
        if _transpiler_fast_nonneg_rhs(t, value_expr, idx_name, idx_name) == nil { return nil }
        oren_list_push(lists, list_name)
        oren_list_push(pushes, {"list": list_name, "value": value_expr})
        i = i + 1
    }
    if oren_list_len(lists) == 0 { return nil }
    var pi = 0
    while pi < oren_list_len(pushes) {
        if _transpiler_expr_uses_any_ident(pushes[pi]["value"], lists) { return nil }
        pi = pi + 1
    }
    return {"idx": idx_name, "n": n_name, "n_const": n_const, "lists": lists, "pushes": pushes, "body_len": n - 1}
}

fn _transpiler_match_fast_lcg_sum_while(t, stmt) {
    if stmt == nil || stmt["type"] != "While" { return nil }
    var cond = stmt["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _transpiler_is_ident(cond["left"])
    var n_name = _transpiler_is_ident(cond["right"])
    if idx_name == nil || n_name == nil { return nil }
    var body = stmt["body"]
    if body == nil || body["type"] != "Block" { return nil }
    var stmts = body["stmts"]
    if stmts == nil || oren_list_len(stmts) != 3 { return nil }

    var lcg_stmt = stmts[0]
    var sum_stmt = stmts[1]
    var inc_stmt = stmts[2]

    if _transpiler_is_simple_inc(inc_stmt, idx_name) != true { return nil }

    if lcg_stmt == nil || lcg_stmt["type"] != "Assign" { return nil }
    var x_name = _transpiler_is_ident(lcg_stmt["name"])
    if x_name == nil || str_eq(x_name, idx_name) || str_eq(x_name, n_name) { return nil }

    var lcg = _transpiler_match_lcg_update(lcg_stmt, x_name)
    if lcg == nil { return nil }
    var mod_name = lcg["mod"]
    var mod_const = lcg["mod_const"]
    if mod_name != nil {
        if str_eq(mod_name, idx_name) || str_eq(mod_name, n_name) || str_eq(mod_name, x_name) { return nil }
        var mod_const2 = _transpiler_const_get(t, mod_name)
        if oren_type_tag(mod_const2) == 1 && mod_const2 > 0 { mod_const = mod_const2 }
    } else {
        if mod_const == nil || mod_const <= 0 { return nil }
    }

    if sum_stmt == nil || sum_stmt["type"] != "Assign" { return nil }
    var sum_name = _transpiler_is_ident(sum_stmt["name"])
    if sum_name == nil { return nil }
    if str_eq(sum_name, idx_name) || str_eq(sum_name, n_name) || str_eq(sum_name, x_name) { return nil }

    var sum_info = _transpiler_match_sum_mod_update(sum_stmt, sum_name, x_name, idx_name, mod_name, mod_const)
    if sum_info == nil { return nil }

    return {
        "idx": idx_name,
        "n": n_name,
        "x": x_name,
        "sum": sum_name,
        "mod": mod_name,
        "mod_const": mod_const,
        "mul": lcg["mul"],
        "add": lcg["add"],
        "mod_x": sum_info["mod_x"],
        "mod_i": sum_info["mod_i"]
    }
}

fn _transpiler_emit_fast_list_int_push_while(t, stmt, info) {
    var idx_name = info["idx"]
    var n_name = info["n"]
    var n_const = info["n_const"]
    var lists = info["lists"]
    var pushes = info["pushes"]

    var inty_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    var slow = _transpiler_emit_while_basic(t, stmt)
    var inty_after = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["inty"] = _transpiler_inty_clone(inty_before)

    var fast_ok = tmp_gensym(t, "list_fast_ok")
    var n_int = tmp_gensym(t, "list_fast_n")
    var i_int = tmp_gensym(t, "list_fast_i")

    var parts = []
    oren_list_push(parts, "{")
    oren_list_push(parts, CH_LF)
    oren_list_push(parts, "int " + fast_ok + " = 1;")
    oren_list_push(parts, "long long " + n_int + " = 0;")
    oren_list_push(parts, "long long " + i_int + " = 0;")
    if n_name != nil {
        oren_list_push(parts, "if (" + c_ident(n_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + n_int + " = " + c_ident(n_name) + ".as.int_val; if (" + n_int + " < 0) " + fast_ok + " = 0; }")
    } else {
        oren_list_push(parts, n_int + " = " + int_str(n_const) + ";")
    }
    oren_list_push(parts, "if (" + c_ident(idx_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + i_int + " = " + c_ident(idx_name) + ".as.int_val; if (" + i_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + fast_ok + " && oren_list_locking_needed()) { " + fast_ok + " = 0; }")

    var list_items = {}
    var list_ptrs = {}
    var li = 0
    while li < oren_list_len(lists) {
        var ln = lists[li]
        var list_tmp = tmp_gensym(t, "list_fast_list")
        var ptr_tmp = tmp_gensym(t, "list_fast_ptr")
        var items_tmp = tmp_gensym(t, "list_fast_items")
        list_items[ln] = items_tmp
        list_ptrs[ln] = ptr_tmp
        oren_list_push(parts, "OrenValue " + list_tmp + " = " + c_ident(ln) + ";")
        oren_list_push(parts, "OrenList* " + ptr_tmp + " = NULL;")
        oren_list_push(parts, "OrenValue* " + items_tmp + " = NULL;")
        oren_list_push(parts, "if (" + fast_ok + ") {")
        oren_list_push(parts, "    if (" + list_tmp + ".type != OREN_TYPE_LIST || " + list_tmp + ".as.list_val == NULL) { " + fast_ok + " = 0; } else {")
        oren_list_push(parts, "        " + ptr_tmp + " = " + list_tmp + ".as.list_val;")
        oren_list_push(parts, "        if ((long long)" + ptr_tmp + "->count != " + i_int + ") { " + fast_ok + " = 0; }")
        oren_list_push(parts, "        else { if ((long long)" + ptr_tmp + "->capacity < " + n_int + ") { oren_list_reserve_raw(" + ptr_tmp + ", (int)" + n_int + "); }")
        oren_list_push(parts, "            if ((long long)" + ptr_tmp + "->capacity < " + n_int + ") { " + fast_ok + " = 0; } else { " + items_tmp + " = " + ptr_tmp + "->items; } }")
        oren_list_push(parts, "    }")
        oren_list_push(parts, "}")
        li = li + 1
    }

    oren_list_push(parts, "if (" + fast_ok + ") {")
    var inty_fast_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    var prev_fast_items = t["fast_list_items"]
    var prev_fast_idx_name = t["fast_idx_name"]
    var prev_fast_idx_c = t["fast_idx_c"]
    t["fast_list_items"] = nil
    t["fast_idx_name"] = idx_name
    t["fast_idx_c"] = i_int
    oren_list_push(parts, "    while (" + i_int + " < " + n_int + ") {")
    var pi = 0
    while pi < oren_list_len(pushes) {
        var push = pushes[pi]
        var list_name = push["list"]
        var value_expr = push["value"]
        var items_tmp2 = list_items[list_name]
        var ptr_tmp2 = list_ptrs[list_name]
        var fast_v = _transpiler_fast_nonneg_rhs(t, value_expr, idx_name, i_int)
        if fast_v != nil {
            var v_u = tmp_gensym(t, "list_fast_val_u")
            var v_ll = tmp_gensym(t, "list_fast_val_ll")
            oren_list_push(parts, "        uint64_t " + v_u + " = " + fast_v + ";")
            oren_list_push(parts, "        long long " + v_ll + " = 0;")
            oren_list_push(parts, "        memcpy(&" + v_ll + ", &" + v_u + ", sizeof(" + v_ll + "));")
            oren_list_push(parts, "        " + items_tmp2 + "[" + i_int + "].type = OREN_TYPE_INT;")
            oren_list_push(parts, "        " + items_tmp2 + "[" + i_int + "].as.int_val = " + v_ll + ";")
        } else {
            var v_out = transpile_expression(t, value_expr)
            oren_list_push(parts, "        " + items_tmp2 + "[" + i_int + "] = " + v_out + ";")
        }
        pi = pi + 1
    }
    oren_list_push(parts, "        " + i_int + "++;")
    oren_list_push(parts, "    }")
    var ci = 0
    while ci < oren_list_len(lists) {
        var list_name2 = lists[ci]
        var ptr_tmp3 = list_ptrs[list_name2]
        oren_list_push(parts, "    " + ptr_tmp3 + "->count = (int)" + i_int + ";")
        ci = ci + 1
    }
    oren_list_push(parts, "    " + c_ident(idx_name) + " = oren_int(" + i_int + ");")
    t["fast_list_items"] = prev_fast_items
    t["fast_idx_name"] = prev_fast_idx_name
    t["fast_idx_c"] = prev_fast_idx_c
    t["inty"] = inty_fast_before

    oren_list_push(parts, "} else " + slow)
    oren_list_push(parts, "}")

    t["inty"] = inty_after
    return _transpiler_join_parts(parts)
}

fn _transpiler_emit_fast_list_push_while(t, stmt, info) {
    var idx_name = info["idx"]
    var n_name = info["n"]
    var n_const = info["n_const"]
    var lists = info["lists"]
    var pushes = info["pushes"]

    var inty_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    var slow = _transpiler_emit_while_basic(t, stmt)
    var inty_after = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["inty"] = _transpiler_inty_clone(inty_before)

    var fast_ok = tmp_gensym(t, "list_fast_ok")
    var n_int = tmp_gensym(t, "list_fast_n")
    var i_int = tmp_gensym(t, "list_fast_i")

    var parts = []
    oren_list_push(parts, "{")
    oren_list_push(parts, CH_LF)
    oren_list_push(parts, "int " + fast_ok + " = 1;")
    oren_list_push(parts, "long long " + n_int + " = 0;")
    oren_list_push(parts, "long long " + i_int + " = 0;")
    if n_name != nil {
        oren_list_push(parts, "if (" + c_ident(n_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + n_int + " = " + c_ident(n_name) + ".as.int_val; if (" + n_int + " < 0) " + fast_ok + " = 0; }")
    } else {
        oren_list_push(parts, n_int + " = " + int_str(n_const) + ";")
    }
    oren_list_push(parts, "if (" + c_ident(idx_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + i_int + " = " + c_ident(idx_name) + ".as.int_val; if (" + i_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + fast_ok + " && oren_list_locking_needed()) { " + fast_ok + " = 0; }")

    var list_items = {}
    var list_ptrs = {}
    var li = 0
    while li < oren_list_len(lists) {
        var ln = lists[li]
        var list_tmp = tmp_gensym(t, "list_fast_list")
        var ptr_tmp = tmp_gensym(t, "list_fast_ptr")
        var items_tmp = tmp_gensym(t, "list_fast_items")
        list_items[ln] = items_tmp
        list_ptrs[ln] = ptr_tmp
        oren_list_push(parts, "OrenValue " + list_tmp + " = " + c_ident(ln) + ";")
        oren_list_push(parts, "OrenList* " + ptr_tmp + " = NULL;")
        oren_list_push(parts, "OrenValue* " + items_tmp + " = NULL;")
        oren_list_push(parts, "if (" + fast_ok + ") {")
        oren_list_push(parts, "    if (" + list_tmp + ".type != OREN_TYPE_LIST || " + list_tmp + ".as.list_val == NULL) { " + fast_ok + " = 0; } else {")
        oren_list_push(parts, "        " + ptr_tmp + " = " + list_tmp + ".as.list_val;")
        oren_list_push(parts, "        if ((long long)" + ptr_tmp + "->count != " + i_int + ") { " + fast_ok + " = 0; }")
        oren_list_push(parts, "        else { if ((long long)" + ptr_tmp + "->capacity < " + n_int + ") { oren_list_reserve_raw(" + ptr_tmp + ", (int)" + n_int + "); }")
        oren_list_push(parts, "            if ((long long)" + ptr_tmp + "->capacity < " + n_int + ") { " + fast_ok + " = 0; } else { " + items_tmp + " = " + ptr_tmp + "->items; } }")
        oren_list_push(parts, "    }")
        oren_list_push(parts, "}")
        li = li + 1
    }

    oren_list_push(parts, "if (" + fast_ok + ") {")
    var inty_fast_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    var prev_fast_items = t["fast_list_items"]
    var prev_fast_idx_name = t["fast_idx_name"]
    var prev_fast_idx_c = t["fast_idx_c"]
    t["fast_list_items"] = nil
    t["fast_idx_name"] = idx_name
    t["fast_idx_c"] = i_int
    oren_list_push(parts, "    while (" + i_int + " < " + n_int + ") {")
    var pi = 0
    while pi < oren_list_len(pushes) {
        var push = pushes[pi]
        var list_name = push["list"]
        var value_expr = push["value"]
        var items_tmp2 = list_items[list_name]
        var fast_v = _transpiler_fast_nonneg_rhs(t, value_expr, idx_name, i_int)
        var v_u = tmp_gensym(t, "list_fast_val_u")
        var v_ll = tmp_gensym(t, "list_fast_val_ll")
        oren_list_push(parts, "        uint64_t " + v_u + " = " + fast_v + ";")
        oren_list_push(parts, "        long long " + v_ll + " = 0;")
        oren_list_push(parts, "        memcpy(&" + v_ll + ", &" + v_u + ", sizeof(" + v_ll + "));")
        oren_list_push(parts, "        " + items_tmp2 + "[" + i_int + "].type = OREN_TYPE_INT;")
        oren_list_push(parts, "        " + items_tmp2 + "[" + i_int + "].as.int_val = " + v_ll + ";")
        pi = pi + 1
    }
    oren_list_push(parts, "        " + i_int + "++;")
    oren_list_push(parts, "    }")
    var ci = 0
    while ci < oren_list_len(lists) {
        var list_name2 = lists[ci]
        var ptr_tmp3 = list_ptrs[list_name2]
        oren_list_push(parts, "    " + ptr_tmp3 + "->count = (int)" + i_int + ";")
        ci = ci + 1
    }
    oren_list_push(parts, "    " + c_ident(idx_name) + " = oren_int(" + i_int + ");")
    t["fast_list_items"] = prev_fast_items
    t["fast_idx_name"] = prev_fast_idx_name
    t["fast_idx_c"] = prev_fast_idx_c
    t["inty"] = inty_fast_before

    oren_list_push(parts, "} else " + slow)
    oren_list_push(parts, "}")

    t["inty"] = inty_after
    return _transpiler_join_parts(parts)
}

fn _transpiler_emit_fast_lcg_sum_while(t, stmt, info) {
    var idx_name = info["idx"]
    var n_name = info["n"]
    var x_name = info["x"]
    var sum_name = info["sum"]
    var mod_name = info["mod"]
    var mul = info["mul"]
    var add = info["add"]
    var mod_x = info["mod_x"]
    var mod_i = info["mod_i"]
    var mod_const = info["mod_const"]
    var sum_fast_ok = false
    if mod_const != nil {
        if mod_x + mod_i <= mod_const { sum_fast_ok = true }
    }

    var inty_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    var slow = _transpiler_emit_while_basic(t, stmt)
    var inty_after = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["inty"] = _transpiler_inty_clone(inty_before)

    var fast_ok = tmp_gensym(t, "lcg_fast_ok")
    var i_ll = tmp_gensym(t, "lcg_i")
    var n_ll = tmp_gensym(t, "lcg_n")
    var x_ll = tmp_gensym(t, "lcg_x")
    var sum_ll = tmp_gensym(t, "lcg_sum")
    var mod_ll = tmp_gensym(t, "lcg_mod")
    var i_u = tmp_gensym(t, "lcg_i_u")
    var n_u = tmp_gensym(t, "lcg_n_u")
    var x_u = tmp_gensym(t, "lcg_x_u")
    var sum_u = tmp_gensym(t, "lcg_sum_u")
    var mod_u = tmp_gensym(t, "lcg_mod_u")
    var mod_expr = mod_u
    if mod_const != nil { mod_expr = "lcg_mod" }

    var parts = []
    oren_list_push(parts, "{")
    oren_list_push(parts, CH_LF)
    oren_list_push(parts, "int " + fast_ok + " = 1;")
    oren_list_push(parts, "long long " + i_ll + " = 0;")
    oren_list_push(parts, "long long " + n_ll + " = 0;")
    oren_list_push(parts, "long long " + x_ll + " = 0;")
    oren_list_push(parts, "long long " + sum_ll + " = 0;")
    oren_list_push(parts, "long long " + mod_ll + " = 0;")
    oren_list_push(parts, "uint64_t " + i_u + " = 0;")
    oren_list_push(parts, "uint64_t " + n_u + " = 0;")
    oren_list_push(parts, "uint64_t " + x_u + " = 0;")
    oren_list_push(parts, "uint64_t " + sum_u + " = 0;")
    oren_list_push(parts, "uint64_t " + mod_u + " = 0;")
    oren_list_push(parts, "const uint64_t lcg_mul = " + int_str(mul) + "ULL;")
    oren_list_push(parts, "const uint64_t lcg_add = " + int_str(add) + "ULL;")
    oren_list_push(parts, "const uint64_t lcg_mod_x = " + int_str(mod_x) + "ULL;")
    oren_list_push(parts, "const uint64_t lcg_mod_i = " + int_str(mod_i) + "ULL;")
    if mod_const != nil {
        oren_list_push(parts, "const uint64_t lcg_mod = " + int_str(mod_const) + "ULL;")
    }

    oren_list_push(parts, "if (" + c_ident(idx_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + i_ll + " = " + c_ident(idx_name) + ".as.int_val; if (" + i_ll + " < 0) " + fast_ok + " = 0; else " + i_u + " = (uint64_t)" + i_ll + "; }")
    oren_list_push(parts, "if (" + c_ident(n_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + n_ll + " = " + c_ident(n_name) + ".as.int_val; if (" + n_ll + " < 0) " + fast_ok + " = 0; else " + n_u + " = (uint64_t)" + n_ll + "; }")
    oren_list_push(parts, "if (" + c_ident(x_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + x_ll + " = " + c_ident(x_name) + ".as.int_val; if (" + x_ll + " < 0) " + fast_ok + " = 0; else " + x_u + " = (uint64_t)" + x_ll + "; }")
    oren_list_push(parts, "if (" + c_ident(sum_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + sum_ll + " = " + c_ident(sum_name) + ".as.int_val; if (" + sum_ll + " < 0) " + fast_ok + " = 0; else " + sum_u + " = (uint64_t)" + sum_ll + "; }")
    if mod_const != nil {
        if mod_name != nil {
            oren_list_push(parts, "if (" + c_ident(mod_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + mod_ll + " = " + c_ident(mod_name) + ".as.int_val; if (" + mod_ll + " != " + int_str(mod_const) + ") " + fast_ok + " = 0; }")
        }
    } else {
        oren_list_push(parts, "if (" + c_ident(mod_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + mod_ll + " = " + c_ident(mod_name) + ".as.int_val; if (" + mod_ll + " <= 0) " + fast_ok + " = 0; else " + mod_u + " = (uint64_t)" + mod_ll + "; }")
    }

    oren_list_push(parts, "if (" + fast_ok + ") {")
    if sum_fast_ok {
        oren_list_push(parts, "    while (" + i_u + " < " + n_u + ") {")
        oren_list_push(parts, "        " + x_u + " = (" + x_u + " * lcg_mul + lcg_add) % " + mod_expr + ";")
        oren_list_push(parts, "        uint64_t lcg_term_x = " + x_u + " % lcg_mod_x;")
        oren_list_push(parts, "        uint64_t lcg_term_i = " + i_u + " % lcg_mod_i;")
        oren_list_push(parts, "        " + sum_u + " = " + sum_u + " + lcg_term_x + lcg_term_i;")
        oren_list_push(parts, "        if (" + sum_u + " >= " + mod_expr + ") { " + sum_u + " -= " + mod_expr + "; }")
        oren_list_push(parts, "        " + i_u + " = " + i_u + " + 1;")
        oren_list_push(parts, "    }")
    } else if mod_const == nil {
        var sum_fast = tmp_gensym(t, "lcg_sum_fast")
        var sum_cap = int_str(mod_x + mod_i)
        oren_list_push(parts, "    int " + sum_fast + " = 0;")
        oren_list_push(parts, "    if ((uint64_t)" + sum_cap + " <= " + mod_expr + ") { " + sum_fast + " = 1; }")
        oren_list_push(parts, "    if (" + sum_fast + ") {")
        oren_list_push(parts, "        while (" + i_u + " < " + n_u + ") {")
        oren_list_push(parts, "            " + x_u + " = (" + x_u + " * lcg_mul + lcg_add) % " + mod_expr + ";")
        oren_list_push(parts, "            uint64_t lcg_term_x = " + x_u + " % lcg_mod_x;")
        oren_list_push(parts, "            uint64_t lcg_term_i = " + i_u + " % lcg_mod_i;")
        oren_list_push(parts, "            " + sum_u + " = " + sum_u + " + lcg_term_x + lcg_term_i;")
        oren_list_push(parts, "            if (" + sum_u + " >= " + mod_expr + ") { " + sum_u + " -= " + mod_expr + "; }")
        oren_list_push(parts, "            " + i_u + " = " + i_u + " + 1;")
        oren_list_push(parts, "        }")
        oren_list_push(parts, "    } else {")
        oren_list_push(parts, "        while (" + i_u + " < " + n_u + ") {")
        oren_list_push(parts, "            " + x_u + " = (" + x_u + " * lcg_mul + lcg_add) % " + mod_expr + ";")
        oren_list_push(parts, "            uint64_t lcg_term_x = " + x_u + " % lcg_mod_x;")
        oren_list_push(parts, "            uint64_t lcg_term_i = " + i_u + " % lcg_mod_i;")
        oren_list_push(parts, "            " + sum_u + " = (" + sum_u + " + lcg_term_x + lcg_term_i) % " + mod_expr + ";")
        oren_list_push(parts, "            " + i_u + " = " + i_u + " + 1;")
        oren_list_push(parts, "        }")
        oren_list_push(parts, "    }")
    } else {
        oren_list_push(parts, "    while (" + i_u + " < " + n_u + ") {")
        oren_list_push(parts, "        " + x_u + " = (" + x_u + " * lcg_mul + lcg_add) % " + mod_expr + ";")
        oren_list_push(parts, "        uint64_t lcg_term_x = " + x_u + " % lcg_mod_x;")
        oren_list_push(parts, "        uint64_t lcg_term_i = " + i_u + " % lcg_mod_i;")
        oren_list_push(parts, "        " + sum_u + " = (" + sum_u + " + lcg_term_x + lcg_term_i) % " + mod_expr + ";")
        oren_list_push(parts, "        " + i_u + " = " + i_u + " + 1;")
        oren_list_push(parts, "    }")
    }
    oren_list_push(parts, "    " + x_ll + " = (long long)" + x_u + ";")
    oren_list_push(parts, "    " + sum_ll + " = (long long)" + sum_u + ";")
    oren_list_push(parts, "    " + i_ll + " = (long long)" + i_u + ";")
    oren_list_push(parts, "    " + c_ident(x_name) + " = oren_int(" + x_ll + ");")
    oren_list_push(parts, "    " + c_ident(sum_name) + " = oren_int(" + sum_ll + ");")
    oren_list_push(parts, "    " + c_ident(idx_name) + " = oren_int(" + i_ll + ");")
    oren_list_push(parts, "} else " + slow)
    oren_list_push(parts, "}")

    t["inty"] = inty_after
    return _transpiler_join_parts(parts)
}

fn _transpiler_emit_fast_list_int_while(t, stmt, info) {
    var idx_name = info["idx"]
    var n_name = info["n"]
    var lists = info["lists"]
    var body = info["body"]
    var body_len = info["body_len"]

    var inty_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    var slow = _transpiler_emit_while_basic(t, stmt)
    var inty_after = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["inty"] = _transpiler_inty_clone(inty_before)

    var fast_ok = tmp_gensym(t, "list_fast_ok")
    var n_int = tmp_gensym(t, "list_fast_n")
    var i_int = tmp_gensym(t, "list_fast_i")
    var acc_name = nil
    var acc_rhs = nil
    var acc_u = nil
    var acc_ll = nil

    var parts = []
    oren_list_push(parts, "{")
    oren_list_push(parts, CH_LF)
    oren_list_push(parts, "int " + fast_ok + " = 1;")
    oren_list_push(parts, "long long " + n_int + " = 0;")
    oren_list_push(parts, "long long " + i_int + " = 0;")
    oren_list_push(parts, "if (" + c_ident(n_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + n_int + " = " + c_ident(n_name) + ".as.int_val; if (" + n_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + c_ident(idx_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + i_int + " = " + c_ident(idx_name) + ".as.int_val; if (" + i_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + fast_ok + " && oren_list_locking_needed()) { " + fast_ok + " = 0; }")

    var list_items = {}
    var li = 0
    while li < oren_list_len(lists) {
        var ln = lists[li]
        var list_tmp = tmp_gensym(t, "list_fast_list")
        var ptr_tmp = tmp_gensym(t, "list_fast_ptr")
        var items_tmp = tmp_gensym(t, "list_fast_items")
        list_items[ln] = items_tmp
        oren_list_push(parts, "OrenValue " + list_tmp + " = " + c_ident(ln) + ";")
        oren_list_push(parts, "OrenList* " + ptr_tmp + " = NULL;")
        oren_list_push(parts, "OrenValue* " + items_tmp + " = NULL;")
        oren_list_push(parts, "if (" + fast_ok + ") {")
        oren_list_push(parts, "    if (" + list_tmp + ".type != OREN_TYPE_LIST || " + list_tmp + ".as.list_val == NULL) { " + fast_ok + " = 0; } else {")
        oren_list_push(parts, "        " + ptr_tmp + " = " + list_tmp + ".as.list_val;")
        oren_list_push(parts, "        if ((long long)" + ptr_tmp + "->count < " + n_int + ") { " + fast_ok + " = 0; } else { " + items_tmp + " = " + ptr_tmp + "->items; }")
        oren_list_push(parts, "    }")
        oren_list_push(parts, "}")
        li = li + 1
    }

    if body_len == 1 {
        var st = body[0]
        if st["type"] == "Assign" {
            var name = _transpiler_is_ident(st["name"])
            if name != nil && str_eq(name, idx_name) != true && str_eq(name, n_name) != true {
                var v = st["value"]
                if v != nil && v["type"] == "Infix" && v["op"] == "+" {
                    var left_name = _transpiler_is_ident(v["left"])
                    if left_name != nil && str_eq(left_name, name) {
                        var rhs = _transpiler_fast_int_rhs(t, v["right"], idx_name, list_items, i_int)
                        if rhs != nil {
                            acc_name = name
                            acc_rhs = rhs
                            acc_u = tmp_gensym(t, "list_fast_acc")
                            acc_ll = tmp_gensym(t, "list_fast_acc_ll")
                        }
                    }
                }
            }
        }
    }

    if acc_name != nil {
        oren_list_push(parts, "uint64_t " + acc_u + " = 0;")
        oren_list_push(parts, "long long " + acc_ll + " = 0;")
        oren_list_push(parts, "if (" + fast_ok + " && " + c_ident(acc_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else if (" + fast_ok + ") { memcpy(&" + acc_u + ", &" + c_ident(acc_name) + ".as.int_val, sizeof(" + acc_u + ")); }")
    }

    oren_list_push(parts, "if (" + fast_ok + ") {")

    var inty_fast_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["fast_list_items"] = list_items
    t["fast_idx_name"] = idx_name
    t["fast_idx_c"] = i_int
    oren_list_push(parts, "    while (" + i_int + " < " + n_int + ") {")
    if acc_name != nil {
        oren_list_push(parts, "        " + acc_u + " = " + acc_u + " + " + acc_rhs + ";")
    } else {
        var bi = 0
        while bi < body_len {
            oren_list_push(parts, "        " + transpile_statement(t, body[bi]))
            bi = bi + 1
        }
    }
    oren_list_push(parts, "        " + i_int + "++;")
    oren_list_push(parts, "    }")
    if acc_name != nil {
        oren_list_push(parts, "    memcpy(&" + acc_ll + ", &" + acc_u + ", sizeof(" + acc_ll + "));")
        oren_list_push(parts, "    " + c_ident(acc_name) + " = oren_int(" + acc_ll + ");")
    }
    oren_list_push(parts, "    " + c_ident(idx_name) + " = oren_int(" + i_int + ");")
    t["fast_list_items"] = nil
    t["fast_idx_name"] = nil
    t["fast_idx_c"] = nil
    t["inty"] = inty_fast_before

    oren_list_push(parts, "} else " + slow)
    oren_list_push(parts, "}")

    t["inty"] = inty_after
    return _transpiler_join_parts(parts)
}

fn _transpiler_emit_fast_list_while(t, stmt, info) {
    var idx_name = info["idx"]
    var n_name = info["n"]
    var lists = info["lists"]
    var body = info["body"]
    var body_len = info["body_len"]

    var inty_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    var slow = _transpiler_emit_while_basic(t, stmt)
    var inty_after = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["inty"] = _transpiler_inty_clone(inty_before)

    var fast_ok = tmp_gensym(t, "list_fast_ok")
    var n_int = tmp_gensym(t, "list_fast_n")
    var i_int = tmp_gensym(t, "list_fast_i")
    var fast_all_int = tmp_gensym(t, "list_fast_all_int")
    var acc_name = nil
    var acc_rhs = nil
    var acc_u = nil
    var acc_ll = nil

    var parts = []
    oren_list_push(parts, "{")
    oren_list_push(parts, CH_LF)
    oren_list_push(parts, "int " + fast_ok + " = 1;")
    oren_list_push(parts, "long long " + n_int + " = 0;")
    oren_list_push(parts, "long long " + i_int + " = 0;")
    oren_list_push(parts, "int " + fast_all_int + " = 1;")
    oren_list_push(parts, "if (" + c_ident(n_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + n_int + " = " + c_ident(n_name) + ".as.int_val; if (" + n_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + c_ident(idx_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + i_int + " = " + c_ident(idx_name) + ".as.int_val; if (" + i_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + fast_ok + " && oren_list_locking_needed()) { " + fast_ok + " = 0; }")

    var list_items = {}
    var li = 0
    while li < oren_list_len(lists) {
        var ln = lists[li]
        var list_tmp = tmp_gensym(t, "list_fast_list")
        var ptr_tmp = tmp_gensym(t, "list_fast_ptr")
        var items_tmp = tmp_gensym(t, "list_fast_items")
        list_items[ln] = items_tmp
        oren_list_push(parts, "OrenValue " + list_tmp + " = " + c_ident(ln) + ";")
        oren_list_push(parts, "OrenList* " + ptr_tmp + " = NULL;")
        oren_list_push(parts, "OrenValue* " + items_tmp + " = NULL;")
        oren_list_push(parts, "if (" + fast_ok + ") {")
        oren_list_push(parts, "    if (" + list_tmp + ".type != OREN_TYPE_LIST || " + list_tmp + ".as.list_val == NULL) { " + fast_ok + " = 0; } else {")
        oren_list_push(parts, "        " + ptr_tmp + " = " + list_tmp + ".as.list_val;")
        oren_list_push(parts, "        if ((long long)" + ptr_tmp + "->count < " + n_int + ") { " + fast_ok + " = 0; } else { " + items_tmp + " = " + ptr_tmp + "->items; if (!" + ptr_tmp + "->all_int) { " + fast_all_int + " = 0; } }")
        oren_list_push(parts, "    }")
        oren_list_push(parts, "}")
        li = li + 1
    }

    oren_list_push(parts, "if (" + fast_ok + " && !" + fast_all_int + ") { " + fast_ok + " = 0; }")

    if body_len == 1 {
        var st = body[0]
        if st["type"] == "Assign" {
            var name = _transpiler_is_ident(st["name"])
            if name != nil && str_eq(name, idx_name) != true && str_eq(name, n_name) != true {
                var v = st["value"]
                if v != nil && v["type"] == "Infix" && v["op"] == "+" {
                    var left_name = _transpiler_is_ident(v["left"])
                    if left_name != nil && str_eq(left_name, name) {
                        var rhs = _transpiler_fast_int_rhs(t, v["right"], idx_name, list_items, i_int)
                        if rhs != nil {
                            acc_name = name
                            acc_rhs = rhs
                            acc_u = tmp_gensym(t, "list_fast_acc")
                            acc_ll = tmp_gensym(t, "list_fast_acc_ll")
                        }
                    }
                }
            }
        }
    }

    if acc_name == nil {
        oren_list_push(parts, "if (" + fast_ok + ") { " + fast_ok + " = 0; }")
    } else {
        oren_list_push(parts, "uint64_t " + acc_u + " = 0;")
        oren_list_push(parts, "long long " + acc_ll + " = 0;")
        oren_list_push(parts, "if (" + fast_ok + " && " + c_ident(acc_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else if (" + fast_ok + ") { memcpy(&" + acc_u + ", &" + c_ident(acc_name) + ".as.int_val, sizeof(" + acc_u + ")); }")
    }

    oren_list_push(parts, "if (" + fast_ok + ") {")

    var inty_fast_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["fast_list_items"] = list_items
    t["fast_idx_name"] = idx_name
    t["fast_idx_c"] = i_int
    oren_list_push(parts, "    while (" + i_int + " < " + n_int + ") {")
    oren_list_push(parts, "        " + acc_u + " = " + acc_u + " + " + acc_rhs + ";")
    oren_list_push(parts, "        " + i_int + "++;")
    oren_list_push(parts, "    }")
    oren_list_push(parts, "    memcpy(&" + acc_ll + ", &" + acc_u + ", sizeof(" + acc_ll + "));")
    oren_list_push(parts, "    " + c_ident(acc_name) + " = oren_int(" + acc_ll + ");")
    oren_list_push(parts, "    " + c_ident(idx_name) + " = oren_int(" + i_int + ");")
    t["fast_list_items"] = nil
    t["fast_idx_name"] = nil
    t["fast_idx_c"] = nil
    t["inty"] = inty_fast_before

    oren_list_push(parts, "} else " + slow)
    oren_list_push(parts, "}")

    t["inty"] = inty_after
    return _transpiler_join_parts(parts)
}

fn _transpiler_emit_fast_list_get_sum_while(t, stmt, info) {
    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var loads = info["loads"]

    var inty_before = _transpiler_inty_clone(_transpiler_inty_list(t))
    var slow = _transpiler_emit_while_basic(t, stmt)
    var inty_after = _transpiler_inty_clone(_transpiler_inty_list(t))
    t["inty"] = _transpiler_inty_clone(inty_before)

    var fast_ok = tmp_gensym(t, "list_fast_ok")
    var n_int = tmp_gensym(t, "list_fast_n")
    var i_int = tmp_gensym(t, "list_fast_i")
    var sum_u = tmp_gensym(t, "list_fast_sum_u")
    var sum_ll = tmp_gensym(t, "list_fast_sum_ll")
    var fast_sum_ok = tmp_gensym(t, "list_fast_sum_ok")
    var fast_all_int = tmp_gensym(t, "list_fast_all_int")
    var parts = []
    oren_list_push(parts, "{")
    oren_list_push(parts, CH_LF)
    oren_list_push(parts, "int " + fast_ok + " = 1;")
    oren_list_push(parts, "long long " + n_int + " = 0;")
    oren_list_push(parts, "long long " + i_int + " = 0;")
    oren_list_push(parts, "uint64_t " + sum_u + " = 0;")
    oren_list_push(parts, "long long " + sum_ll + " = 0;")
    oren_list_push(parts, "int " + fast_sum_ok + " = 0;")
    oren_list_push(parts, "int " + fast_all_int + " = 1;")
    oren_list_push(parts, "if (" + c_ident(n_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + n_int + " = " + c_ident(n_name) + ".as.int_val; if (" + n_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + c_ident(idx_name) + ".type != OREN_TYPE_INT) { " + fast_ok + " = 0; } else { " + i_int + " = " + c_ident(idx_name) + ".as.int_val; if (" + i_int + " < 0) " + fast_ok + " = 0; }")
    oren_list_push(parts, "if (" + fast_ok + " && oren_list_locking_needed()) { " + fast_ok + " = 0; }")

    var list_items = {}
    var list_ptrs = {}
    var li = 0
    while li < oren_list_len(lists) {
        var list_name = lists[li]
        var list_tmp = tmp_gensym(t, "list_fast_list")
        var ptr_tmp = tmp_gensym(t, "list_fast_ptr")
        var items_tmp = tmp_gensym(t, "list_fast_items")
        list_items[list_name] = items_tmp
        list_ptrs[list_name] = ptr_tmp
        oren_list_push(parts, "OrenValue " + list_tmp + " = " + c_ident(list_name) + ";")
        oren_list_push(parts, "OrenList* " + ptr_tmp + " = NULL;")
        oren_list_push(parts, "OrenValue* " + items_tmp + " = NULL;")
        oren_list_push(parts, "if (" + fast_ok + ") {")
        oren_list_push(parts, "    if (" + list_tmp + ".type != OREN_TYPE_LIST || " + list_tmp + ".as.list_val == NULL) { " + fast_ok + " = 0; } else {")
        oren_list_push(parts, "        " + ptr_tmp + " = " + list_tmp + ".as.list_val;")
        oren_list_push(parts, "        if ((long long)" + ptr_tmp + "->count < " + n_int + ") { " + fast_ok + " = 0; } else { " + items_tmp + " = " + ptr_tmp + "->items; if (!" + ptr_tmp + "->all_int) { " + fast_all_int + " = 0; } }")
        oren_list_push(parts, "    }")
        oren_list_push(parts, "}")
        li = li + 1
    }

    oren_list_push(parts, fast_sum_ok + " = " + fast_ok + ";")
    oren_list_push(parts, "if (" + fast_sum_ok + ") {")
    oren_list_push(parts, "    if (" + c_ident(sum_name) + ".type != OREN_TYPE_INT) { " + fast_sum_ok + " = 0; }")
    oren_list_push(parts, "    else { " + sum_u + " = (uint64_t)" + c_ident(sum_name) + ".as.int_val; }")
    oren_list_push(parts, "}")

    oren_list_push(parts, "if (" + fast_sum_ok + ") {")
    oren_list_push(parts, "    if (" + fast_all_int + ") {")
    oren_list_push(parts, "        while (" + i_int + " < " + n_int + ") {")
    var pi_fast = 0
    while pi_fast < oren_list_len(loads) {
        var list_name_fast = loads[pi_fast]
        var items_tmp_fast = list_items[list_name_fast]
        oren_list_push(parts, "            " + sum_u + " += (uint64_t)" + items_tmp_fast + "[" + i_int + "].as.int_val;")
        pi_fast = pi_fast + 1
    }
    oren_list_push(parts, "            " + i_int + "++;")
    oren_list_push(parts, "        }")
    oren_list_push(parts, "    } else {")
    oren_list_push(parts, "        while (" + i_int + " < " + n_int + ") {")
    var pi = 0
    while pi < oren_list_len(loads) {
        var list_name2 = loads[pi]
        var items_tmp2 = list_items[list_name2]
        var v_tmp2 = tmp_gensym(t, "list_fast_val")
        oren_list_push(parts, "            OrenValue " + v_tmp2 + " = " + items_tmp2 + "[" + i_int + "];")
        oren_list_push(parts, "            if (" + v_tmp2 + ".type != OREN_TYPE_INT) { " + fast_sum_ok + " = 0; break; }")
        oren_list_push(parts, "            " + sum_u + " += (uint64_t)" + v_tmp2 + ".as.int_val;")
        pi = pi + 1
    }
    oren_list_push(parts, "            if (!" + fast_sum_ok + ") { break; }")
    oren_list_push(parts, "            " + i_int + "++;")
    oren_list_push(parts, "        }")
    oren_list_push(parts, "    }")
    oren_list_push(parts, "}")

    oren_list_push(parts, "if (" + fast_sum_ok + ") {")
    oren_list_push(parts, "    memcpy(&" + sum_ll + ", &" + sum_u + ", sizeof(" + sum_ll + "));")
    oren_list_push(parts, "    " + c_ident(sum_name) + " = oren_int(" + sum_ll + ");")
    oren_list_push(parts, "    " + c_ident(idx_name) + " = oren_int(" + i_int + ");")
    oren_list_push(parts, "} else { " + slow + " }")
    oren_list_push(parts, "}")

    t["inty"] = inty_after
    return _transpiler_join_parts(parts)
}


// C backend symbol naming for Oren identifiers.
//
// The C backend emits a host `int main(int argc, char** argv)` entrypoint, so an Oren user
// function named `main` must not collide with the host entry symbol.
//
// Rolling policy:
// - Keep the Oren surface as `fn main() { ... }`.
// - Emit it as a different C symbol and call it from the host entrypoint.


// Use literals to avoid top-level `oren_char` init on native Win11 bring-up.


fn transpile_type_ctor(t, type_decl) {
    emit(t, type_ctor_sig(type_decl) + " {")
    indent_more(t)
    var n = oren_list_len(type_decl["fields"])
    // Rolling reflection v0:
    // Tag type ctor maps with a stable type name for basic reflection helpers.
    //   User(id, name) => {"__oren_type":"User","id":id,"name":name}
    var args = ""
    args = args + "oren_string_const(\"__oren_type\"), oren_string_const(\"" + c_escape_string(type_decl["name"]["value"]) + "\")"
    var i = 0
    while i < n {
        args = args + ", "
        args = args + "oren_string_const(" + CH_QUOTE + c_escape_string(type_decl["fields"][i]["value"]) + CH_QUOTE + "), " + type_decl["fields"][i]["value"]
        i = i + 1
    }
    emit(t, "return oren_new_map_from_pairs(" + int_str(n + 1) + ", (OrenValue[]){" + args + "});")
    indent_less(t)
    emit(t, "}")

    // Uniform-call wrapper so constructors can be used as first-class function values.
    var ctor_name = type_ctor_name(type_decl)
    emit(t, fnwrap_sig_by_name(ctor_name) + " {")
    indent_more(t)
    emit(t, "(void)env;")
    emit(t, "if (argc != " + int_str(oren_list_len(type_decl["fields"])) + ") { oren_panic(\"arity mismatch\"); }")
    var args2 = ""
    var k = 0
    while k < oren_list_len(type_decl["fields"]) {
        if k > 0 { args2 = args2 + ", " }
        args2 = args2 + "argv[" + int_str(k) + "]"
        k = k + 1
    }
    emit(t, "return " + ctor_name + "(" + args2 + ");")
    indent_less(t)
    emit(t, "}")
}

fn transpile_args_list_expr(t, args) {
    // Build a list expression from a list of AST expressions (expression-level).
    // Used for call-site spread and list-based variadic helpers.
    var argc = oren_list_len(args)
    if argc == 0 { return "oren_new_list(0)" }
    var parts = ""
    var j = 0
    while j < argc {
        if j > 0 { parts = parts + ", " }
        parts = parts + transpile_expression(t, args[j])
        j = j + 1
    }
    return "oren_new_list_from_array(" + int_str(argc) + ", (OrenValue[]){" + parts + "})"
}


fn transpile_lambda_def(t, def) {
    var lname = def["name"]
    var fun = def["fun"]
    var caps = def["captures"]
    t["aliases"] = def["aliases"]

    emit(t, lambda_sig_by_name(lname) + " {")
    indent_more(t)

    if oren_list_len(caps) == 0 {
        emit(t, "(void)env;")
    } else {
        emit(t, "OrenList* __env = (OrenList*)env;")
        emit(t, "if (!__env || __env->count != " + oren_int_to_string(oren_list_len(caps)) + ") { oren_panic(\"closure env mismatch\"); }")
        var i = 0
        while i < oren_list_len(caps) {
            var nm = caps[i]
            emit(t, "OrenValue " + c_ident(nm) + " = __env->items[" + oren_int_to_string(i) + "];")
            i = i + 1
        }
    }

    var pc = oren_list_len(fun["params"])
    var fixed = fun_varargs_fixed(fun)
    if pc == 0 {
        emit(t, "(void)argc;")
        emit(t, "(void)argv;")
    } else {
        if fixed < 0 {
            emit(t, "if (argc != " + oren_int_to_string(pc) + ") { oren_panic(\"arity mismatch\"); }")
            var j = 0
            while j < pc {
                emit(t, "OrenValue " + c_ident(fun["params"][j]["value"]) + " = argv[" + oren_int_to_string(j) + "];")
                j = j + 1
            }
        } else {
            emit(t, "if (argc < " + oren_int_to_string(fixed) + ") { oren_panic(\"arity mismatch\"); }")
            var j2 = 0
            while j2 < fixed {
                emit(t, "OrenValue " + c_ident(fun["params"][j2]["value"]) + " = argv[" + oren_int_to_string(j2) + "];")
                j2 = j2 + 1
            }
            var rest_name = fun["params"][pc - 1]["value"]
            emit(t, "OrenValue " + c_ident(rest_name) + " = oren_new_list(0);")
            emit(t, "for (int __i = " + oren_int_to_string(fixed) + "; __i < argc; __i++) {")
            emit(t, "    oren_list_push(" + c_ident(rest_name) + ", argv[__i]);")
            emit(t, "}")
        }
    }

    // Stack safety: deterministic recursion guard for C backend binaries.
    emit(t, "oren_call_depth_enter();")

    var body = fun["body"]["stmts"]
    var k = 0
    while k < oren_list_len(body) {
        emit(t, transpile_statement(t, body[k]))
        k = k + 1
    }
    emit(t, "oren_call_depth_exit(); return OREN_NIL;")

    indent_less(t)
    emit(t, "}")
}

// ----- Transpiler core -----

fn transpile_statement(t, stmt) {
    if stmt["type"] == "Var" {
        var v = transpile_expression(t, stmt["value"])
        _transpiler_inty_set(t, stmt["name"]["value"], _transpiler_expr_is_inty(t, stmt["value"]))
        var litv = _transpiler_parse_int_lit_expr(stmt["value"])
        if litv != nil { _transpiler_const_set(t, stmt["name"]["value"], litv) }
        else { _transpiler_const_clear(t, stmt["name"]["value"]) }
        return "OrenValue " + c_ident(stmt["name"]["value"]) + " = " + v + ";"
    }
    if stmt["type"] == "Spawn" {
        var call = stmt["call"]
        if call == nil || call["type"] != "Call" { return "/* spawn expects Call */" }
        var fn_expr = transpile_expression(t, call["fn"])
        var n = oren_list_len(call["args"])
        if n == 0 { return "oren_spawn_call_list(" + fn_expr + ", oren_new_list(0));" }
        var args = ""
        var i = 0
        while i < n {
            if i > 0 { args = args + ", " }
            args = args + transpile_expression(t, call["args"][i])
            i = i + 1
        }
        return "oren_spawn_call_list(" + fn_expr + ", oren_new_list_from_array(" + oren_int_to_string(n) + ", (OrenValue[]){" + args + "}));"
    }
    if stmt["type"] == "Block" {
        var stmts = stmt["stmts"]
        var parts = []
        var inty_prev = _transpiler_inty_clone(_transpiler_inty_list(t))
        oren_list_push(parts, "{")
        oren_list_push(parts, CH_LF)
        var i = 0
        while i < oren_list_len(stmts) {
            oren_list_push(parts, "    " + transpile_statement(t, stmts[i]))
            oren_list_push(parts, CH_LF)
            i = i + 1
        }
        oren_list_push(parts, "}")
        t["inty"] = inty_prev
        _transpiler_const_reset(t)
        return _transpiler_join_parts(parts)
    }
    if stmt["type"] == "Set" {
        if stmt["left"]["type"] == "Index" {
            var arr = transpile_expression(t, stmt["left"]["left"])
            var idx = transpile_expression(t, stmt["left"]["index"])
            var val = transpile_expression(t, stmt["value"])
            var rk = stmt["left"]["recv_kind"]
            if rk == "list_int" {
                return "oren_list_int_set_fast(" + arr + ", " + idx + ", " + val + ");"
            }
            return "oren_index_set(" + arr + ", " + idx + ", " + val + ");"
        }
        if stmt["left"]["type"] == "Member" {
            var v_set = transpile_expression(t, stmt["value"])
            var ns = ns_resolve(t, stmt["left"])
            if ns != nil {
                if list_contains(t["functions"], ns["name"]) { return "/* cannot assign to function */" }
                return c_ident(ns["name"]) + " = " + v_set + ";"
            }
            var obj = transpile_expression(t, stmt["left"]["left"])
            return "oren_set_attr(" + obj + ", " + CH_QUOTE + stmt["left"]["prop"]["value"] + CH_QUOTE + ", " + v_set + ");"
        }
        return "// unsupported set"
    }
    if stmt["type"] == "Assign" {
        var v_assign = transpile_expression(t, stmt["value"])
        _transpiler_inty_set(t, stmt["name"]["value"], _transpiler_expr_is_inty(t, stmt["value"]))
        var litv2 = _transpiler_parse_int_lit_expr(stmt["value"])
        if litv2 != nil { _transpiler_const_set(t, stmt["name"]["value"], litv2) }
        else { _transpiler_const_clear(t, stmt["name"]["value"]) }
        return c_ident(stmt["name"]["value"]) + " = " + v_assign + ";"
    }
    if stmt["type"] == "Return" {
        var v_ret = transpile_expression(t, stmt["value"])
        // Ensure the return expression is evaluated *before* we decrement call depth,
        // otherwise `return f(...)` (including recursion) would not count correctly.
        return "{ OrenValue __oren_ret = " + v_ret + "; oren_call_depth_exit(); return __oren_ret; }"
    }
    if stmt["type"] == "ExprStmt" {
        if stmt["expr"]["type"] == "If" {
            var if_s = transpile_if(t, stmt["expr"])
            _transpiler_const_reset(t)
            return if_s
        }
        var v_expr = transpile_expression(t, stmt["expr"])
        return v_expr + ";"
    }
    if stmt["type"] == "While" {
        var fast_lcg = _transpiler_match_fast_lcg_sum_while(t, stmt)
        if fast_lcg != nil {
            var out_lcg = _transpiler_emit_fast_lcg_sum_while(t, stmt, fast_lcg)
            _transpiler_const_reset(t)
            return out_lcg
        }
        var fast_push_box = _transpiler_match_fast_list_push_while(t, stmt)
        if fast_push_box != nil {
            var out_push_box = _transpiler_emit_fast_list_push_while(t, stmt, fast_push_box)
            _transpiler_const_reset(t)
            return out_push_box
        }
        var fast_push = _transpiler_match_fast_list_int_push_while(t, stmt)
        if fast_push != nil {
            var out_push = _transpiler_emit_fast_list_int_push_while(t, stmt, fast_push)
            _transpiler_const_reset(t)
            return out_push
        }
        var fast = _transpiler_match_fast_list_int_while(t, stmt)
        if fast != nil {
            var out_fast = _transpiler_emit_fast_list_int_while(t, stmt, fast)
            _transpiler_const_reset(t)
            return out_fast
        }
        var fast_box_sum = _transpiler_match_fast_list_get_sum_while(t, stmt)
        if fast_box_sum != nil {
            var out_box_sum = _transpiler_emit_fast_list_get_sum_while(t, stmt, fast_box_sum)
            _transpiler_const_reset(t)
            return out_box_sum
        }
        var fast_box = _transpiler_match_fast_list_while(t, stmt)
        if fast_box != nil {
            var out_box = _transpiler_emit_fast_list_while(t, stmt, fast_box)
            _transpiler_const_reset(t)
            return out_box
        }
        var out_while = _transpiler_emit_while_basic(t, stmt)
        _transpiler_const_reset(t)
        return out_while
    }
    if stmt["type"] == "For" {
        var init_s = transpile_for_header_stmt(t, stmt["init"])
        var post_s = transpile_for_header_stmt(t, stmt["post"])
        var cond_s = "1"
        if stmt["cond"] != nil {
            cond_s = "oren_is_truthy(" + transpile_expression(t, stmt["cond"]) + ")"
        }
        var tick2 = tmp_gensym(t, "gc_tick")
        var inner2_parts = []
        oren_list_push(inner2_parts, "    if (((" + tick2 + "++) & 255u) == 0u) { oren_gc_safepoint(); }")
        oren_list_push(inner2_parts, CH_LF)
        var j = 0
        while j < oren_list_len(stmt["body"]["stmts"]) {
            oren_list_push(inner2_parts, "    " + transpile_statement(t, stmt["body"]["stmts"][j]))
            oren_list_push(inner2_parts, CH_LF)
            j = j + 1
        }
        var inner2 = _transpiler_join_parts(inner2_parts)
            var out_for = "{ uint64_t " + tick2 + " = 0; for (" + init_s + "; " + cond_s + "; " + post_s + ") {" + CH_LF + inner2 + "} }"
            _transpiler_const_reset(t)
            return out_for
        }
    if stmt["type"] == "Break" {
        return "break;"
    }
    if stmt["type"] == "Continue" {
        return "continue;"
    }
    if stmt["type"] == "FFI" {
        return "// ffi " + c_ident(stmt["name"]["value"])
    }
    return "// unknown stmt"
}

fn transpile_if(t, expr) {
    var cond = transpile_expression(t, expr["cond"])
    var inty_base = _transpiler_inty_clone(_transpiler_inty_list(t))
    var parts = []
    oren_list_push(parts, "if (oren_is_truthy(" + cond + ")) {")
    oren_list_push(parts, CH_LF)
    t["inty"] = _transpiler_inty_clone(inty_base)
    var i = 0
    while i < oren_list_len(expr["consq"]["stmts"]) {
        oren_list_push(parts, "    " + transpile_statement(t, expr["consq"]["stmts"][i]))
        oren_list_push(parts, CH_LF)
        i = i + 1
    }
    var inty_consq = _transpiler_inty_clone(_transpiler_inty_list(t))
    oren_list_push(parts, "}")
    if expr["alt"] != nil {
        t["inty"] = _transpiler_inty_clone(inty_base)
        oren_list_push(parts, " else {")
        oren_list_push(parts, CH_LF)
        i = 0
        while i < oren_list_len(expr["alt"]["stmts"]) {
            oren_list_push(parts, "    " + transpile_statement(t, expr["alt"]["stmts"][i]))
            oren_list_push(parts, CH_LF)
            i = i + 1
        }
        oren_list_push(parts, "}")
    }
    var inty_alt = inty_base
    if expr["alt"] != nil { inty_alt = _transpiler_inty_clone(_transpiler_inty_list(t)) }
    t["inty"] = _transpiler_inty_intersect(inty_consq, inty_alt)
    return _transpiler_join_parts(parts)
}

fn transpile_expression(t, exp) {
    var et = exp["type"]
    if et == "Call" {
        var fast_items = t["fast_list_items"]
        if fast_items != nil {
            if exp["fn"] != nil && exp["fn"]["type"] == "Identifier" {
                var nm = exp["fn"]["value"]
                if str_eq(nm, "oren_list_int_get") || str_eq(nm, "STD_list_int_get") {
                    var args = exp["args"]
                    if args != nil && oren_list_len(args) == 2 {
                        var list_name = _transpiler_is_ident(args[0])
                        var idx_name = _transpiler_is_ident(args[1])
                        if list_name != nil && idx_name != nil && str_eq(idx_name, t["fast_idx_name"]) {
                            var items = fast_items[list_name]
                            if items != nil { return items + "[" + t["fast_idx_c"] + "]" }
                        }
                    }
                }
            }
        }
    }
    if et == "Integer" { return "oren_int(" + int_str(parse_int_lit(exp["value"])) + ")" }
    if et == "Float" { return "oren_float(" + exp["value"] + ")" }
    if et == "String" { return "oren_string_const(" + CH_QUOTE + c_escape_string(exp["value"]) + CH_QUOTE + ")" }
    if et == "Boolean" {
        if exp["value"] { return "OREN_TRUE" }
        return "OREN_FALSE"
    }
    if et == "Nil" { return "OREN_NIL" }
    if et == "Identifier" {
        var name_id = exp["value"]
        var fast_idx_name = t["fast_idx_name"]
        if fast_idx_name != nil && str_eq(name_id, fast_idx_name) {
            var fast_idx_c = t["fast_idx_c"]
            if fast_idx_c != nil { return "oren_int(" + fast_idx_c + ")" }
        }
        // First-class function values in C backend: wrap known functions into OrenValue via oren_func.
        if list_contains(t["functions"], name_id) {
            return "oren_func(" + fnwrap_name(name_id) + ", NULL)"
        }
        return c_ident(name_id)
    }
    if et == "Function" {
        // Anonymous function literal (lambda) lowers to a closure (capture-by-value).
        if exp["name"] != "" { return "/* function decl is not an expression */ OREN_NIL" }
        var lname = exp["lambda_name"]
        if lname == nil { return "/* lambda not collected */ OREN_NIL" }
        var caps = exp["captures"]
        if caps == nil || oren_list_len(caps) == 0 { return "oren_closure(" + lname + ", 0)" }
        var args = ""
        var i = 0
        while i < oren_list_len(caps) {
            if i > 0 { args = args + ", " }
            args = args + transpile_expression(t, {"type": "Identifier", "value": caps[i]})
            i = i + 1
        }
        return "oren_closure_from_array(" + lname + ", " + oren_int_to_string(oren_list_len(caps)) + ", (OrenValue[]){" + args + "})"
    }
    if et == "Prefix" {
        var right = transpile_expression(t, exp["right"])
        // Unary minus:
        // - Use multiplication by -1 so float negation preserves IEEE-754 sign bit (notably -0.0).
        // - Integers have deterministic wrap semantics in the runtime, so -1*x is consistent.
        if exp["op"] == "-" {
            if _transpiler_expr_is_inty(t, exp["right"]) {
                return "oren_int_neg_fast(" + right + ")"
            }
            return "oren_mul(oren_int(-1), " + right + ")"
        }
        if exp["op"] == "!" { return "oren_bool(!oren_is_truthy(" + right + "))" }
        if exp["op"] == "~" {
            if _transpiler_expr_is_inty(t, exp["right"]) {
                return "oren_int_bnot_fast(" + right + ")"
            }
            return "oren_bnot(" + right + ")"
        }
    }
    if et == "Infix" {
        var left = transpile_expression(t, exp["left"])
        var right_expr = transpile_expression(t, exp["right"])
        var op = exp["op"]
        var left_inty = _transpiler_expr_is_inty(t, exp["left"])
        var right_inty = _transpiler_expr_is_inty(t, exp["right"])
        if left_inty && right_inty {
            if op == "+" { return "oren_int_add_fast(" + left + ", " + right_expr + ")" }
            if op == "-" { return "oren_int_sub_fast(" + left + ", " + right_expr + ")" }
            if op == "*" { return "oren_int_mul_fast(" + left + ", " + right_expr + ")" }
            if op == "/" { return "oren_int_div_fast(" + left + ", " + right_expr + ")" }
            if op == "%" { return "oren_int_mod_fast(" + left + ", " + right_expr + ")" }
            if op == "&" { return "oren_int_band_fast(" + left + ", " + right_expr + ")" }
            if op == "|" { return "oren_int_bor_fast(" + left + ", " + right_expr + ")" }
            if op == "^" { return "oren_int_bxor_fast(" + left + ", " + right_expr + ")" }
            if op == "<<" { return "oren_int_shl_fast(" + left + ", " + right_expr + ")" }
            if op == ">>" { return "oren_int_shr_fast(" + left + ", " + right_expr + ")" }
        }
        if op == "+" { return "oren_add(" + left + ", " + right_expr + ")" }
        if op == "-" { return "oren_sub(" + left + ", " + right_expr + ")" }
        if op == "*" { return "oren_mul(" + left + ", " + right_expr + ")" }
        if op == "/" { return "oren_div(" + left + ", " + right_expr + ")" }
        if op == "%" { return "oren_mod(" + left + ", " + right_expr + ")" }
        if op == "&" { return "oren_band(" + left + ", " + right_expr + ")" }
        if op == "|" { return "oren_bor(" + left + ", " + right_expr + ")" }
        if op == "^" { return "oren_bxor(" + left + ", " + right_expr + ")" }
        if op == "<<" { return "oren_shl(" + left + ", " + right_expr + ")" }
        if op == ">>" { return "oren_shr(" + left + ", " + right_expr + ")" }
        if op == "==" { return "oren_eq(" + left + ", " + right_expr + ")" }
        if op == "!=" { return "oren_neq(" + left + ", " + right_expr + ")" }
        if op == "&&" { return "oren_bool(oren_is_truthy(" + left + ") && oren_is_truthy(" + right_expr + "))" }
        if op == "||" { return "oren_bool(oren_is_truthy(" + left + ") || oren_is_truthy(" + right_expr + "))" }
        if op == "<" { return "oren_lt(" + left + ", " + right_expr + ")" }
        if op == ">" { return "oren_gt(" + left + ", " + right_expr + ")" }
        if op == "<=" { return "oren_lte(" + left + ", " + right_expr + ")" }
        if op == ">=" { return "oren_gte(" + left + ", " + right_expr + ")" }
    }
    if et == "Call" {
        var fn_sym = ""
        // Determine direct-call symbol before transpiling `exp["fn"]`, because a known function identifier
        // is lowered to `oren_func(...)` (a value) in expression position.
        if exp["fn"]["type"] == "Identifier" {
            var nm = exp["fn"]["value"]
            if list_contains(t["functions"], nm) { fn_sym = nm }
            if starts_with(nm, "oren_") { fn_sym = nm }
        } else {
            if exp["fn"]["type"] == "Member" {
                var ns2 = ns_resolve(t, exp["fn"])
                if ns2 != nil {
                    if list_contains(t["functions"], ns2["name"]) { fn_sym = ns2["name"] }
                }
            }
        }

        var fn_expr = transpile_expression(t, exp["fn"])
        var spread = exp["spread"]

        var args_s = ""
        var i = 0
        while i < oren_list_len(exp["args"]) {
            if i > 0 { args_s = args_s + ", " }
            args_s = args_s + transpile_expression(t, exp["args"][i])
            i = i + 1
        }

        if exp["fn"]["type"] == "Identifier" {
            var name = exp["fn"]["value"]
            var argc = oren_list_len(exp["args"])
            if spread == nil {
                if (str_eq(name, "oren_list_int_len") || str_eq(name, "STD_list_int_len")) && argc == 1 {
                    return "oren_list_int_len_fast(" + args_s + ")"
                }
                if (str_eq(name, "oren_list_int_push") || str_eq(name, "STD_list_int_push")) && argc == 2 {
                    return "oren_list_int_push_fast(" + args_s + ")"
                }
                if (str_eq(name, "oren_list_int_get") || str_eq(name, "STD_list_int_get")) && argc == 2 {
                    return "oren_list_int_get_fast(" + args_s + ")"
                }
                if (str_eq(name, "oren_list_int_set") || str_eq(name, "STD_list_int_set")) && argc == 3 {
                    return "oren_list_int_set_fast(" + args_s + ")"
                }
            }
            if str_eq(name, "print") {
                if spread != nil {
                    // print(..., xs...) lower to runtime list-based helpers.
                    var arg0 = nil
                    if argc > 0 { arg0 = exp["args"][0] }

                    var is_fmt = false
                    if arg0 != nil && arg0["type"] == "String" {
                        if contains_curly_braces(arg0["value"]) {
                            if argc > 1 || spread != nil { is_fmt = true }
                        }
                    }

                    if is_fmt {
                        var fmt_arg = transpile_expression(t, arg0)
                        var rest = []
                        var k = 1
                        while k < argc {
                            oren_list_push(rest, exp["args"][k])
                            k = k + 1
                        }
                        return "oren_print_fmt_spread(" + fmt_arg + ", " + transpile_args_list_expr(t, rest) + ", " + transpile_expression(t, spread) + ")"
                    }
                    return "oren_print_spread(" + transpile_args_list_expr(t, exp["args"]) + ", " + transpile_expression(t, spread) + ")"
                }

                if argc == 0 { return "oren_print_multi(0)" }
                
                var is_fmt = false
                if argc > 1 {
                    var arg0 = exp["args"][0]
                    if arg0["type"] == "String" {
                        if contains_curly_braces(arg0["value"]) {
                            is_fmt = true
                        }
                    }
                }
                
                if is_fmt {
                    var fmt_arg = transpile_expression(t, exp["args"][0])
                    var other_args = ""
                    var k = 1
                    while k < argc {
                        if k > 1 { other_args = other_args + ", " }
                        other_args = other_args + transpile_expression(t, exp["args"][k])
                        k = k + 1
                    }
                    var count_others = argc - 1
                    return "oren_print_fmt(" + fmt_arg + ", " + int_str(count_others) + ", " + other_args + ")"
                }

                if argc == 1 { return "oren_print(" + args_s + ")" }
                return "oren_print_multi(" + int_str(argc) + ", " + args_s + ")"
            }
            if str_eq(name, "py_import") {
                if argc == 1 { return "oren_py_import(" + args_s + ")" }
            }
            if str_eq(name, "py_release") {
                if argc == 1 { return "oren_py_release(" + args_s + ")" }
            }
            if str_eq(name, "system") {
                if argc == 1 { return "oren_system(" + args_s + ")" }
            }
            if str_eq(name, "exit") {
                if argc == 1 { return "oren_exit(" + args_s + ")" }
            }
            if str_eq(name, "iadd") {
                if argc == 2 { return "oren_add(" + args_s + ")" }
                return "/* iadd expects 2 args */ OREN_NIL"
            }
        }

        if exp["fn"]["type"] == "Member" {
            var ns = ns_resolve(t, exp["fn"])
            if ns != nil {
                if ns["is_ns"] == true { fn_expr = ns["name"] }
            }
        }

        var use_call_obj = true
        if fn_sym != "" { use_call_obj = false }
        if exp["fn"]["type"] == "Identifier" {
            if starts_with(exp["fn"]["value"], "oren_") { use_call_obj = false }
        }
        // Varargs functions require uniform-call lowering (argc/argv) in the C backend,
        // because C does not support calling a fixed-arity function with variable arity.
        // The fnwrap packs rest args into a list and calls the real function.
        if fn_sym != "" && t["func_varargs_fixed"][fn_sym] != nil {
            use_call_obj = true
        }
        if spread != nil {
            // Spread calls must go through a list-based apply helper.
            use_call_obj = true
        }
        if use_call_obj {
            var argc = oren_list_len(exp["args"])
            if spread != nil {
                return "oren_call_obj_spread(" + fn_expr + ", " + transpile_args_list_expr(t, exp["args"]) + ", " + transpile_expression(t, spread) + ")"
            }
            if argc == 0 { return "oren_call_obj_argv(" + fn_expr + ", 0, NULL)" }
            return "oren_call_obj_argv(" + fn_expr + ", " + int_str(argc) + ", (OrenValue[]){" + args_s + "})"
        }
        // Direct call
        if fn_sym != "" { return c_fn_name(fn_sym) + "(" + args_s + ")" }
        return fn_expr + "(" + args_s + ")"
    }
    if et == "SpawnExpr" {
        var call = exp["call"]
        if call == nil || call["type"] != "Call" { return "/* spawn expects Call */ OREN_NIL" }
        var fn_expr = transpile_expression(t, call["fn"])
        var n = oren_list_len(call["args"])
        if n == 0 { return "oren_spawn_call_list(" + fn_expr + ", oren_new_list(0))" }
        var args = ""
        var i = 0
        while i < n {
            if i > 0 { args = args + ", " }
            args = args + transpile_expression(t, call["args"][i])
            i = i + 1
        }
        return "oren_spawn_call_list(" + fn_expr + ", oren_new_list_from_array(" + oren_int_to_string(n) + ", (OrenValue[]){" + args + "}))"
    }
    if et == "Member" {
        var ns = ns_resolve(t, exp)
        if ns != nil {
            if list_contains(t["functions"], ns["name"]) {
                return "oren_func(" + fnwrap_name(ns["name"]) + ", NULL)"
            }
            return c_ident(ns["name"])
        }
        var left = transpile_expression(t, exp["left"])
        return "oren_get_attr(" + left + ", " + CH_QUOTE + exp["prop"]["value"] + CH_QUOTE + ")"
    }
    if et == "Array" {
        var els = ""
        var i = 0
        while i < oren_list_len(exp["elements"]) {
            if i > 0 { els = els + ", " }
            els = els + transpile_expression(t, exp["elements"][i])
            i = i + 1
        }
        var count = oren_list_len(exp["elements"])
        if count == 0 { return "oren_new_list(0)" }
        return "oren_new_list_from_array(" + int_str(count) + ", (OrenValue[]){" + els + "})"
    }
    if et == "Index" {
        var left_expr = transpile_expression(t, exp["left"])
        var idx = transpile_expression(t, exp["index"])
        var rk = exp["recv_kind"]
        if rk == "list_int" {
            return "oren_list_int_get_fast(" + left_expr + ", " + idx + ")"
        }
        return "oren_list_get(" + left_expr + ", " + idx + ")"
    }
    if et == "Hash" {
        var parts = ""
        var i_pairs = 0
        var count_pairs = oren_list_len(exp["pairs"])
        while i_pairs < count_pairs {
            if i_pairs > 0 { parts = parts + ", " }
            var pair = exp["pairs"][i_pairs]
            parts = parts + transpile_expression(t, pair["key"]) + ", " + transpile_expression(t, pair["value"])
            i_pairs = i_pairs + 1
        }
        if count_pairs == 0 { return "oren_new_map(0)" }
        return "oren_new_map_from_pairs(" + int_str(count_pairs) + ", (OrenValue[]){" + parts + "})"
    }
    return "/* unknown expr */ OREN_NIL"
}

fn transpile_function(t, func_decl) {
    emit(t, function_sig(func_decl) + " {")
    indent_more(t)
    t["inty"] = []
    t["const_ints"] = {}
    // Stack safety: deterministic recursion guard for C backend binaries.
    emit(t, "oren_call_depth_enter();")
    var i = 0
    while i < oren_list_len(func_decl["body"]["stmts"]) {
        emit(t, transpile_statement(t, func_decl["body"]["stmts"][i]))
        i = i + 1
    }
    emit(t, "oren_call_depth_exit(); return OREN_NIL;")
    indent_less(t)
    emit(t, "}")

    // Uniform-call wrapper so functions can be used as first-class function values.
    var fname = func_decl["name"]
    var fixed = fun_varargs_fixed(func_decl)
    emit(t, fnwrap_sig_by_name(fname) + " {")
    indent_more(t)
    emit(t, "(void)env;")
    var pc = oren_list_len(func_decl["params"])
    if fixed < 0 {
        emit(t, "if (argc != " + int_str(pc) + ") { oren_panic(\"arity mismatch\"); }")
        var args2 = ""
        var k = 0
        while k < pc {
            if k > 0 { args2 = args2 + ", " }
            args2 = args2 + "argv[" + int_str(k) + "]"
            k = k + 1
        }
        emit(t, "return " + c_fn_name(fname) + "(" + args2 + ");")
    } else {
        emit(t, "if (argc < " + int_str(fixed) + ") { oren_panic(\"arity mismatch\"); }")
        emit(t, "OrenValue __rest = oren_new_list(0);")
        emit(t, "for (int __i = " + int_str(fixed) + "; __i < argc; __i++) {")
        emit(t, "    oren_list_push(__rest, argv[__i]);")
        emit(t, "}")
        var args3 = ""
        var k2 = 0
        while k2 < fixed {
            if k2 > 0 { args3 = args3 + ", " }
            args3 = args3 + "argv[" + int_str(k2) + "]"
            k2 = k2 + 1
        }
        if fixed > 0 { args3 = args3 + ", " }
        args3 = args3 + "__rest"
        emit(t, "return " + c_fn_name(fname) + "(" + args3 + ");")
    }
    indent_less(t)
    emit(t, "}")
}

fn transpile_for_header_stmt(t, stmt) {
    if stmt == nil { return "" }
    if stmt["type"] == "Var" {
        var v = transpile_expression(t, stmt["value"])
        _transpiler_inty_set(t, stmt["name"]["value"], _transpiler_expr_is_inty(t, stmt["value"]))
        var litv = _transpiler_parse_int_lit_expr(stmt["value"])
        if litv != nil { _transpiler_const_set(t, stmt["name"]["value"], litv) }
        else { _transpiler_const_clear(t, stmt["name"]["value"]) }
        return "OrenValue " + c_ident(stmt["name"]["value"]) + " = " + v
    }
    if stmt["type"] == "Assign" {
        var v_assign = transpile_expression(t, stmt["value"])
        _transpiler_inty_set(t, stmt["name"]["value"], _transpiler_expr_is_inty(t, stmt["value"]))
        var litv2 = _transpiler_parse_int_lit_expr(stmt["value"])
        if litv2 != nil { _transpiler_const_set(t, stmt["name"]["value"], litv2) }
        else { _transpiler_const_clear(t, stmt["name"]["value"]) }
        return c_ident(stmt["name"]["value"]) + " = " + v_assign
    }
    if stmt["type"] == "Set" {
        // Support index assignments in `for` headers (needed by `for x in ...` desugaring).
        if stmt["left"] != nil && stmt["left"]["type"] == "Index" {
            var arr = transpile_expression(t, stmt["left"]["left"])
            var idx = transpile_expression(t, stmt["left"]["index"])
            var val = transpile_expression(t, stmt["value"])
            return "oren_index_set(" + arr + ", " + idx + ", " + val + ")"
        }
        // Member assignments are not allowed for structs; ignore here.
        return ""
    }
    if stmt["type"] == "ExprStmt" {
        return transpile_expression(t, stmt["expr"])
    }
    return ""
}

// Helpers needed for transpile_entry
fn dirname(path) {
    var i = oren_string_len(path) - 1
    while i >= 0 {
        var ch = oren_string_char_at(path, i)
        if ch == "/" || ch == "\\" {
            if i == 0 { return ch }
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

fn collect_parts(program) {
    var globals = []
    var functions = []
    var types = []
    var main_body = []
    var i = 0
    while i < oren_list_len(program["statements"]) {
        var s = program["statements"][i]
        if s["type"] == "Import" {
            // compile-time only
        } else {
            if s["type"] == "Type" {
                oren_list_push(types, s)
            } else {
                if s["type"] == "Var" {
                    // C backend: top-level `var` declares a global symbol, but the initializer
                    // must execute in source order (NOT hoisted ahead of other top-level statements).
                    //
                    // We model that as:
                    // - a global declaration (so other functions can reference it)
                    // - an `Assign` statement in `main_body` at the exact original position.
                    oren_list_push(globals, {"type": "VarDecl", "name": s["name"]})
                    oren_list_push(main_body, {"type": "Assign", "name": s["name"], "value": s["value"]})
                } else {
                    var is_fn_decl = false
                    if s["type"] == "ExprStmt" {
                        if s["expr"]["type"] == "Function" {
                            if s["expr"]["name"] != "" { is_fn_decl = true }
                        }
                    }
                    if is_fn_decl { oren_list_push(functions, s["expr"]) } else { oren_list_push(main_body, s) }
                }
            }
        }
        i = i + 1
    }
    return {"globals": globals, "functions": functions, "types": types, "main_body": main_body}
}

// Updated signature: pass MODULE_ORDER explicitly
fn transpile_entry(entry_path, program, module_order, root_aliases) {
    var units = []
    var i = 0
    
    // Process loaded modules
    while i < oren_list_len(module_order) {
        var mod2 = module_order[i]
        var parts = collect_parts(mod2["program"])
        oren_list_push(units, {"program": mod2["program"], "aliases": mod2["aliases"], "parts": parts, "prefix": mod2["prefix"]})
        i = i + 1
    }
    
    // Process root program
    var root_parts = collect_parts(program)
    oren_list_push(units, {"program": program, "aliases": root_aliases, "parts": root_parts, "prefix": "root"})

    var type_ns = {}
    i = 0
    while i < oren_list_len(units) {
        var types = units[i]["parts"]["types"]
        var j = 0
        while j < oren_list_len(types) {
            type_ns[types[j]["name"]["value"]] = true
            j = j + 1
        }
        i = i + 1
    }

    var t = new_transpiler()
    t["type_ns"] = type_ns

    var has_user_main = false

    // Preload all function names for direct-call lowering.
    i = 0
    while i < oren_list_len(units) {
        var funs = units[i]["parts"]["functions"]

        // Rolling: share function metadata extraction with other backends via CoreIR v0.
        // `funs` is already a list of Function nodes; treat it as a "statements" list for CoreIR.
        var meta = {"errors": []}
        coreir.collect_top_level_functions(meta, {"statements": funs}, "c backend v0")
        if meta["errors"] != nil && oren_list_len(meta["errors"]) > 0 {
            print("OREN_DIAG kind=transpiler code=1 msg=coreir metadata error")
            print("transpiler: coreir metadata error:")
            var ei = 0
            while ei < oren_list_len(meta["errors"]) {
                print(meta["errors"][ei])
                ei = ei + 1
            }
            oren_exit(1)
        }

        var order = meta["func_decl_order"]
        if order != nil {
            var j = 0
            while j < oren_list_len(order) {
                var nm = order[j]
                oren_list_push(t["functions"], nm)
                if nm == "main" { has_user_main = true }
                var vf = nil
                if meta["func_varargs_fixed"] != nil { vf = meta["func_varargs_fixed"][nm] }
                if vf != nil { t["func_varargs_fixed"][nm] = vf }
                j = j + 1
            }
        }

        var types = units[i]["parts"]["types"]
        var jt = 0
        while jt < oren_list_len(types) {
            oren_list_push(t["functions"], type_ctor_name(types[jt]))
            jt = jt + 1
        }
        i = i + 1
    }

    emit(t, "#include <stdio.h>")
    emit(t, "#include <stdlib.h>")
    emit(t, "#include <string.h>")
    emit(t, "#include " + CH_QUOTE + "runtime.h" + CH_QUOTE)
    emit(t, "")

    // Globals (all units).
    i = 0
    while i < oren_list_len(units) {
        var globals = units[i]["parts"]["globals"]
        var j = 0
        while j < oren_list_len(globals) {
            emit(t, "OrenValue " + c_ident(globals[j]["name"]["value"]) + ";")
            j = j + 1
        }
        i = i + 1
    }
    emit(t, "")

    // Collect all lambdas before emitting prototypes.
    i = 0
    while i < oren_list_len(units) {
        t["aliases"] = units[i]["aliases"]
        var pref = units[i]["prefix"]
        // function bodies
        var funs2 = units[i]["parts"]["functions"]
        var jf = 0
        while jf < oren_list_len(funs2) {
            collect_lambdas_in_statement(t, pref, units[i]["aliases"], funs2[jf]["body"])
            jf = jf + 1
        }
        // top-level statements
        var body2 = units[i]["parts"]["main_body"]
        var jb = 0
        while jb < oren_list_len(body2) {
            collect_lambdas_in_statement(t, pref, units[i]["aliases"], body2[jb])
            jb = jb + 1
        }
        i = i + 1
    }

    // Prototypes (functions + constructors).
    i = 0
    while i < oren_list_len(units) {
        var funs = units[i]["parts"]["functions"]
        var j = 0
        while j < oren_list_len(funs) {
            emit(t, function_sig(funs[j]) + ";")
            emit(t, fnwrap_sig_by_name(funs[j]["name"]) + ";")
            j = j + 1
        }
        var types = units[i]["parts"]["types"]
        j = 0
        while j < oren_list_len(types) {
            emit(t, type_ctor_sig(types[j]) + ";")
            emit(t, fnwrap_sig_by_name(type_ctor_name(types[j])) + ";")
            j = j + 1
        }
        i = i + 1
    }
    // Lambda prototypes.
    i = 0
    while i < oren_list_len(t["lambda_defs"]) {
        emit(t, lambda_sig_by_name(t["lambda_defs"][i]["name"]) + ";")
        i = i + 1
    }
    emit(t, "")

    // Function bodies (functions + constructors).
    i = 0
    while i < oren_list_len(t["lambda_defs"]) {
        transpile_lambda_def(t, t["lambda_defs"][i])
        i = i + 1
    }
    i = 0
    while i < oren_list_len(units) {
        t["aliases"] = units[i]["aliases"]
        var funs = units[i]["parts"]["functions"]
        var j = 0
        while j < oren_list_len(funs) {
            transpile_function(t, funs[j])
            j = j + 1
        }
        var types = units[i]["parts"]["types"]
        j = 0
        while j < oren_list_len(types) {
            transpile_type_ctor(t, types[j])
            j = j + 1
        }
        i = i + 1
    }

    emit(t, "int main(int argc, char **argv) {")
    indent_more(t)
    emit(t, "oren_init(argc, argv);")

    // Register globals as GC roots
    i = 0
    while i < oren_list_len(units) {
        var globals = units[i]["parts"]["globals"]
        var j = 0
        while j < oren_list_len(globals) {
            emit(t, "oren_register_root(&" + c_ident(globals[j]["name"]["value"]) + ");")
            j = j + 1
        }
        i = i + 1
    }

    // Execute module top-level statements first (excluding root unit).
    i = 0
    while i < oren_list_len(units) - 1 {
        t["aliases"] = units[i]["aliases"]
        t["inty"] = []
        var body = units[i]["parts"]["main_body"]
        var j = 0
        while j < oren_list_len(body) {
            emit(t, transpile_statement(t, body[j]))
            j = j + 1
        }
        i = i + 1
    }

    // Root top-level statements last.
    t["aliases"] = units[oren_list_len(units) - 1]["aliases"]
    t["inty"] = []
    var root_body = units[oren_list_len(units) - 1]["parts"]["main_body"]
    i = 0
    while i < oren_list_len(root_body) {
        emit(t, transpile_statement(t, root_body[i]))
        i = i + 1
    }

    // If the user defines `fn main()`, run it after all module top-level statements.
    // This matches native+AVM entry behavior (rolling parity).
    if has_user_main {
        emit(t, c_fn_name("main") + "();")
    }

    emit(t, "oren_shutdown();")
    emit(t, "return 0;")
    indent_less(t)
    emit(t, "}")

    _transpiler_flush_lines(t, false)
    return _transpiler_join_parts(t["chunks"])
}
