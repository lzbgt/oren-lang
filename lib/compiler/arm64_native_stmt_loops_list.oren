        if _arm64_expr_uses_ident(exp, names[i]) { return true }
        i = i + 1
    }
    return false
}

fn _arm64_expr_is_fast_loop_call_free(exp) {
    if exp == nil { return true }
    var et = exp["type"]
    if et == "Integer" || et == "Float" || et == "String" || et == "Boolean" || et == "Nil" { return true }
    if et == "Identifier" { return true }
    if et == "Prefix" { return _arm64_expr_is_fast_loop_call_free(exp["right"]) }
    if et == "Infix" {
        if _arm64_expr_is_fast_loop_call_free(exp["left"]) != true { return false }
        return _arm64_expr_is_fast_loop_call_free(exp["right"])
    }
    return false
}

fn _arm64_expr_is_fast_loop_idx_int_arith(ctx, exp, idx_name) {
    if exp == nil || idx_name == nil { return false }
    if exprm.native_expr_int_const(ctx, exp) != nil { return true }
    var et = exp["type"]
    if et == "Identifier" {
        return _arm64_str_eq_bytes(exp["value"], idx_name)
    }
    if et == "Prefix" {
        if exp["op"] != "-" { return false }
        return _arm64_expr_is_fast_loop_idx_int_arith(ctx, exp["right"], idx_name)
    }
    if et == "Infix" {
        var op = exp["op"]
        if op != "+" && op != "-" && op != "*" && op != "%" { return false }
        if _arm64_expr_is_fast_loop_idx_int_arith(ctx, exp["left"], idx_name) != true { return false }
        if _arm64_expr_is_fast_loop_idx_int_arith(ctx, exp["right"], idx_name) != true { return false }
        if op == "%" {
            var rhs_const = exprm.native_expr_int_const(ctx, exp["right"])
            if rhs_const == nil || rhs_const == 0 || rhs_const == -1 { return false }
        }
        return true
    }
    return false
}

fn _arm64_parse_nonneg_int_lit_expr(expr) {
    if expr == nil || expr["type"] != "Integer" { return nil }
    var v = intparse.parse_int_lit(expr["value"])
    if oren_is_err(v) == true { return nil }
    if v < 0 { return nil }
    return v
}

fn _arm64_parse_nonneg_linear_core(expr, idx_name) {
    if expr == nil || idx_name == nil { return nil }
    var et = expr["type"]
    if et == "Integer" {
        var v = _arm64_parse_nonneg_int_lit_expr(expr)
        if v == nil { return nil }
        return {"mul": 0, "add": v}
    }
    if et == "Identifier" {
        if _arm64_str_eq_bytes(expr["value"], idx_name) != true { return nil }
        return {"mul": 1, "add": 0}
    }
    if et == "Infix" {
        var op = expr["op"]
        if op == "+" {
            var left = _arm64_parse_nonneg_linear_core(expr["left"], idx_name)
            if left == nil { return nil }
            var right = _arm64_parse_nonneg_linear_core(expr["right"], idx_name)
            if right == nil { return nil }
            return {"mul": left["mul"] + right["mul"], "add": left["add"] + right["add"]}
        }
        if op == "*" {
            var left2 = _arm64_parse_nonneg_linear_core(expr["left"], idx_name)
            if left2 == nil { return nil }
            var right2 = _arm64_parse_nonneg_linear_core(expr["right"], idx_name)
            if right2 == nil { return nil }
            if left2["mul"] == 0 {
                return {"mul": right2["mul"] * left2["add"], "add": right2["add"] * left2["add"]}
            }
            if right2["mul"] == 0 {
                return {"mul": left2["mul"] * right2["add"], "add": left2["add"] * right2["add"]}
            }
            return nil
        }
    }
    return nil
}

fn _arm64_parse_nonneg_linear(expr, idx_name) {
    if expr == nil || idx_name == nil { return nil }
    if expr["type"] == "Infix" && expr["op"] == "%" {
        var modv = _arm64_parse_nonneg_int_lit_expr(expr["right"])
        if modv == nil || modv <= 0 { return nil }
        var left = _arm64_parse_nonneg_linear_core(expr["left"], idx_name)
        if left == nil { return nil }
        return {"mul": left["mul"], "add": left["add"], "mod": modv}
    }
    var base = _arm64_parse_nonneg_linear_core(expr, idx_name)
    if base == nil { return nil }
    return {"mul": base["mul"], "add": base["add"], "mod": 0}
}

fn _arm64_nonneg_linear_safe_n_limit(linear) {
    if linear == nil { return nil }
    var mul = linear["mul"]
    var add = linear["add"]
    if mul == nil || add == nil { return nil }
    if mul < 0 || add < 0 { return nil }
    if mul == 0 { return 9223372036854775807 }
    var max_i64 = 9223372036854775807
    if add > max_i64 { return nil }
    var room = max_i64 - add
    return (room / mul) + 1
}

fn _arm64_cap_expr_matches_fast_n(cap_expr, n_name, n_const) {
    if cap_expr == nil { return false }
    if n_name != nil {
        if cap_expr["type"] == "Identifier" && _arm64_str_eq_bytes(cap_expr["value"], n_name) == true { return true }
    } else if n_const != nil {
        if cap_expr["type"] == "Integer" {
            var v = intparse.parse_int_lit(cap_expr["value"])
            if oren_is_err(v) != true && v == n_const { return true }
        }
    }
    return false
}

