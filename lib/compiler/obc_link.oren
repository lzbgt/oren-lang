import codegen_bytecode "codegen_bytecode.oren"
import bytes_builder "bytes_builder.oren"
import byte_view "byte_view.oren"

// OBC linker (rolling)
//
// Purpose:
// - Support precompiled bytecode libraries (e.g. stdlib as a `.obc` bundle) so
//   AVM can compile user source without needing stdlib sources at runtime.
//
// Design:
// - We keep `.obc` execution semantics unchanged: exports/relocs are carried in
//   an unused BYTES constant ("OBX" metadata) and are ignored by the VM.
// - A linker merges multiple `.obc` files into a single self-contained `.obc`,
//   patching const/global indices and absolute code addresses.

// OBX payload format (binary, little-endian), stored inside an unused BYTES constant:
//
//   prefix: ASCII "OREN_OBX\n1\n"
//   u16 module_name_len, module_name bytes (UTF-8)
//   u16 export_count
//     repeated export_count:
//       u16 name_len, name bytes (UTF-8)
//       u32 addr (code offset within this module's code section)
//   u16 reloc_count
//     repeated reloc_count:
//       u16 name_len, name bytes (UTF-8)
//       u32 pos (byte offset into code where a u32 address must be patched)
//       u8  kind (0=CALL32 target, 1=PUSH_FUNC32 target)
//   optional surface section:
//     "SURF"
//     u16 function_return_count
//       repeated: u16 name_len/name, u16 ret_len/ret
//     u16 impl_count
//       repeated: u16 trait_len/trait, u16 type_len/type, u16 method_len/method, u16 fn_len/fn
//
// Notes:
// - `addr` and `pos` are always module-local, and are rebased by the linker.
// - A library `.obc` intended for linking should include exports (via `--obc-lib`).
// - A partially linked `.obc` intended to be later linked should include relocs
//   (via `allow_undef` in the bytecode compiler).

fn _string_u8_at(s, pos) { return oren_string_byte_at_unchecked(s, pos) & 255 }

fn _push_u16_le(out, v) {
    bytes_builder.bytes_push_u16_le(out, v)
    return nil
}

fn _push_u32_le(out, v) {
    bytes_builder.bytes_push_u32_le(out, v)
    return nil
}

fn _push_ascii(out, s) {
    bytes_builder.bytes_extend_string(out, s)
    return nil
}

fn _push_zero_byte(out) {
    bytes_builder.bytes_extend_zeros(out, 1)
    return nil
}

fn _view_starts_with(v, prefix_str) {
    var pn = oren_string_len(prefix_str)
    if byte_view.view_len(v) < pn { return false }
    var i = 0
    while i < pn {
        if byte_view.u8_at_unchecked(v, i) != _string_u8_at(prefix_str, i) { return false }
        i = i + 1
    }
    return true
}

fn _metadata_json_from_view(v) {
    if !_view_starts_with(v, "OREN_META\n1\n") { return nil }
    var prefix_len = oren_string_len("OREN_META\n1\n")
    return oren_string_from_bytes_slice(byte_view.bytes(v), prefix_len, byte_view.view_len(v) - prefix_len)
}

fn _decode_string_u16_view(v, pos) {
    if !byte_view.span_ok(v, pos, 2) { return {"error": "truncated OBX string length", "next": pos} }
    var len = byte_view.u16_le_at_unchecked(v, pos)
    var start = pos + 2
    if !byte_view.span_ok(v, start, len) { return {"error": "truncated OBX string", "next": start + len} }
    return {"value": oren_string_from_bytes_slice(byte_view.bytes(v), start, len), "next": start + len}
}

fn _encode_string_u16(out, s) {
    if s == nil { s = "" }
    var n = oren_string_len(s)
    _push_u16_le(out, n)
    bytes_builder.bytes_extend_string(out, s)
    return nil
}

fn obx_encode(module_name, exports, relocs, surface) {
    if module_name == nil { module_name = "" }
    if exports == nil { exports = {} }
    if relocs == nil { relocs = [] }

    var out = bytes_builder.bytes_new()
    _push_ascii(out, "OREN_OBX\n1\n")

    _encode_string_u16(out, module_name)

    // Exports: deterministic order (map iteration is deterministic today, but sort keys anyway).
    var keys = []
    for k in exports {
        oren_list_push(keys, k)
    }
    keys = _sort_strings(keys)

    _push_u16_le(out, oren_list_len(keys))
    var ki = 0
    var keys_n = oren_list_len(keys)
    while ki < keys_n {
        var name = keys[ki]
        _encode_string_u16(out, name)
        var addr = exports[name]
        // Do not rely on `scalar == nil` semantics (native parity hazard).
        if oren_type_tag(addr) == 0 { addr = 0 }
        _push_u32_le(out, addr)
        ki = ki + 1
    }

    _push_u16_le(out, oren_list_len(relocs))
    var ri = 0
    var relocs_n = oren_list_len(relocs)
    while ri < relocs_n {
        var r = relocs[ri]
        var rname = r["name"]
        var rpos = r["pos"]
        var rkind = r["kind"]
        if rname == nil { rname = "" }
        // Do not rely on `scalar == nil` semantics (native parity hazard).
        if oren_type_tag(rpos) == 0 { rpos = 0 }
        if oren_type_tag(rkind) == 0 { rkind = 0 }
        _encode_string_u16(out, rname)
        _push_u32_le(out, rpos)
        bytes_builder.bytes_push(out, rkind & 255)
        ri = ri + 1
    }

    if surface != nil {
        _push_ascii(out, "SURF")
        var fr = surface["function_returns"]
        if fr == nil { fr = {} }
        var ret_keys = []
        for rk in fr {
            oren_list_push(ret_keys, rk)
        }
        ret_keys = _sort_strings(ret_keys)
        _push_u16_le(out, oren_list_len(ret_keys))
        var fki = 0
        var ret_keys_n = oren_list_len(ret_keys)
        while fki < ret_keys_n {
            var fname = ret_keys[fki]
            _encode_string_u16(out, fname)
            _encode_string_u16(out, fr[fname])
            fki = fki + 1
        }

        var impls = surface["impls"]
        if impls == nil { impls = [] }
        _push_u16_le(out, oren_list_len(impls))
        var ii = 0
        var impls_n = oren_list_len(impls)
        while ii < impls_n {
            var im = impls[ii]
            _encode_string_u16(out, im["trait"])
            _encode_string_u16(out, im["type"])
            _encode_string_u16(out, im["method"])
            _encode_string_u16(out, im["name"])
            ii = ii + 1
        }
    }

    return bytes_builder.bytes_finalize(out)
}

fn obx_decode(obx_bytes) {
    var obxv = byte_view.view(obx_bytes)
    if !_view_starts_with(obxv, "OREN_OBX\n1\n") { return nil }
    var pos = oren_string_len("OREN_OBX\n1\n")

    var m = _decode_string_u16_view(obxv, pos)
    if m["error"] != nil { return m }
    var module_name = m["value"]
    pos = m["next"]

    var exports = {}
    if !byte_view.span_ok(obxv, pos, 2) { return {"error": "truncated OBX export count"} }
    var n_exports = byte_view.u16_le_at_unchecked(obxv, pos)
    pos = pos + 2
    var i = 0
    while i < n_exports {
        var dn = _decode_string_u16_view(obxv, pos)
        if dn["error"] != nil { return dn }
        var name = dn["value"]
        pos = dn["next"]
        if !byte_view.span_ok(obxv, pos, 4) { return {"error": "truncated OBX export address"} }
        var addr = byte_view.u32_le_at_unchecked(obxv, pos)
        pos = pos + 4
        exports[name] = addr
        i = i + 1
    }

    var relocs = []
    if !byte_view.span_ok(obxv, pos, 2) { return {"error": "truncated OBX reloc count"} }
    var n_relocs = byte_view.u16_le_at_unchecked(obxv, pos)
    pos = pos + 2
    var j = 0
    while j < n_relocs {
        var dn2 = _decode_string_u16_view(obxv, pos)
        if dn2["error"] != nil { return dn2 }
        var rname = dn2["value"]
        pos = dn2["next"]
        if !byte_view.span_ok(obxv, pos, 5) { return {"error": "truncated OBX reloc entry"} }
        var rpos = byte_view.u32_le_at_unchecked(obxv, pos)
        pos = pos + 4
        var kind = byte_view.u8_at_unchecked(obxv, pos)
        pos = pos + 1
        oren_list_push(relocs, {"name": rname, "pos": rpos, "kind": kind})
        j = j + 1
    }

    var surface = {"function_returns": {}, "impl_methods": {}, "impl_trait_methods": {}, "traits": []}
    if byte_view.span_ok(obxv, pos, 4) {
        if byte_view.u8_at_unchecked(obxv, pos) == 83 && byte_view.u8_at_unchecked(obxv, pos + 1) == 85 && byte_view.u8_at_unchecked(obxv, pos + 2) == 82 && byte_view.u8_at_unchecked(obxv, pos + 3) == 70 {
            pos = pos + 4
            if !byte_view.span_ok(obxv, pos, 2) { return {"error": "truncated OBX surface return count"} }
            var n_returns = byte_view.u16_le_at_unchecked(obxv, pos)
            pos = pos + 2
            var ri2 = 0
            while ri2 < n_returns {
                var rn = _decode_string_u16_view(obxv, pos)
                if rn["error"] != nil { return rn }
                var fn_name = rn["value"]
                pos = rn["next"]
                var rr = _decode_string_u16_view(obxv, pos)
                if rr["error"] != nil { return rr }
                var ret_name = rr["value"]
                pos = rr["next"]
                surface["function_returns"][fn_name] = ret_name
                ri2 = ri2 + 1
            }

            if !byte_view.span_ok(obxv, pos, 2) { return {"error": "truncated OBX surface impl count"} }
            var n_impls = byte_view.u16_le_at_unchecked(obxv, pos)
            pos = pos + 2
            var ii2 = 0
            while ii2 < n_impls {
                var it = _decode_string_u16_view(obxv, pos)
                if it["error"] != nil { return it }
                var trait_name = it["value"]
                pos = it["next"]
                var ity = _decode_string_u16_view(obxv, pos)
                if ity["error"] != nil { return ity }
                var type_name = ity["value"]
                pos = ity["next"]
                var imn = _decode_string_u16_view(obxv, pos)
                if imn["error"] != nil { return imn }
                var method_name = imn["value"]
                pos = imn["next"]
                var ifn = _decode_string_u16_view(obxv, pos)
                if ifn["error"] != nil { return ifn }
                var impl_fn = ifn["value"]
                pos = ifn["next"]

                if surface["impl_methods"][type_name] == nil { surface["impl_methods"][type_name] = {} }
                surface["impl_methods"][type_name][method_name] = impl_fn
                if trait_name != nil && trait_name != "" {
                    if surface["impl_trait_methods"][trait_name] == nil { surface["impl_trait_methods"][trait_name] = {} }
                    if surface["impl_trait_methods"][trait_name][type_name] == nil { surface["impl_trait_methods"][trait_name][type_name] = {} }
                    surface["impl_trait_methods"][trait_name][type_name][method_name] = impl_fn
                }
                ii2 = ii2 + 1
            }
        }
    }

    return {"module": module_name, "exports": exports, "relocs": relocs, "surface": surface}
}

fn _sort_strings(xs) {
    // Insertion sort (small lists expected).
    if xs == nil { return [] }
    var i = 1
    var xs_n = oren_list_len(xs)
    while i < xs_n {
        var key = xs[i]
        var j = i - 1
        while j >= 0 && xs[j] > key {
            xs[j + 1] = xs[j]
            j = j - 1
        }
        xs[j + 1] = key
        i = i + 1
    }
    return xs
}

fn _emit_constant(out, c) {
    if c["type"] == "Nil" {
        _push_zero_byte(out)
        return nil
    }
    if c["type"] == "Integer" {
        bytes_builder.bytes_push(out, 1)
        bytes_builder.bytes_push_u64_le(out, c["value"])
        return nil
    }
    if c["type"] == "Bool" {
        bytes_builder.bytes_push(out, 2)
        var b = c["value"]
        if b != 0 { b = 1 }
        bytes_builder.bytes_push(out, b & 255)
        return nil
    }
    if c["type"] == "Float" {
        bytes_builder.bytes_push(out, 3)
        bytes_builder.bytes_push_u64_le(out, c["value"])
        return nil
    }
    if c["type"] == "String" {
        bytes_builder.bytes_push(out, 4)
        var s = c["value"]
        if s == nil { s = "" }
        var len = oren_string_len(s)
        bytes_builder.bytes_push_u16_le(out, len)
        bytes_builder.bytes_extend_string(out, s)
        return nil
    }
    if c["type"] == "Bytes" {
        bytes_builder.bytes_push(out, 8)
        var b = c["value"]
        var blen = bytes_builder.bytes_carrier_len(b)
        bytes_builder.bytes_push_u32_le(out, blen)
        bytes_builder.bytes_extend_carrier(out, b)
        return nil
    }
    // Unknown constant: encode as NIL (rolling best-effort).
    _push_zero_byte(out)
    return nil
}

fn obc_encode_bytes(obc) {
    var bytes = bytes_builder.bytes_new()
    // Magic: 0x0ECD (CD 0E)
    bytes_builder.bytes_push(bytes, 205)
    bytes_builder.bytes_push(bytes, 14)

    var consts = obc["constants"]
    if consts == nil { consts = [] }
    var n_consts = oren_list_len(consts)
    bytes_builder.bytes_push_u16_le(bytes, n_consts)

    var i = 0
    while i < n_consts {
        _emit_constant(bytes, consts[i])
        i = i + 1
    }

    var code = obc["code"]
    if code == nil { code = [] }
    bytes_builder.bytes_extend_carrier(bytes, code)
    return bytes_builder.bytes_finalize(bytes)
}

fn obc_write_file(out_path, obc) {
    var bs = obc_encode_bytes(obc)
    var w = oren_write_bytes(out_path, bs)
    return {"bytes": bs, "write": w}
}

fn obc_parse_bytes(bs) {
    var bsv = byte_view.view(bs)
    if bs == nil || byte_view.view_len(bsv) < 4 { return {"error": "obc too short"} }
    if byte_view.u8_at_unchecked(bsv, 0) != 205 || byte_view.u8_at_unchecked(bsv, 1) != 14 { return {"error": "bad obc magic"} }

    var pos = 2
    var n_consts = byte_view.u16_le_at_unchecked(bsv, pos)
    pos = pos + 2
    var consts = []
    var obx = nil
    var metadata_json = nil

    var i = 0
    while i < n_consts {
        if pos >= byte_view.view_len(bsv) { return {"error": "truncated constants"} }
        var tag = byte_view.u8_at_unchecked(bsv, pos)
        pos = pos + 1
        if tag == 0 {
            oren_list_push(consts, {"type": "Nil"})
        } else {
            if tag == 1 {
                if !byte_view.span_ok(bsv, pos, 8) { return {"error": "truncated integer constant"} }
                var v = byte_view.u64_le_at_unchecked(bsv, pos)
                pos = pos + 8
                oren_list_push(consts, {"type": "Integer", "value": v})
            } else {
                if tag == 2 {
                    if !byte_view.span_ok(bsv, pos, 1) { return {"error": "truncated bool constant"} }
                    var b = byte_view.u8_at_unchecked(bsv, pos)
                    pos = pos + 1
                    oren_list_push(consts, {"type": "Bool", "value": b})
                } else {
                    if tag == 3 {
                        if !byte_view.span_ok(bsv, pos, 8) { return {"error": "truncated float constant"} }
                        var bits = byte_view.u64_le_at_unchecked(bsv, pos)
                        pos = pos + 8
                        oren_list_push(consts, {"type": "Float", "value": bits})
                    } else {
                        if tag == 4 {
                            if !byte_view.span_ok(bsv, pos, 2) { return {"error": "truncated string length"} }
                            var sl = byte_view.u16_le_at_unchecked(bsv, pos)
                            pos = pos + 2
                            if !byte_view.span_ok(bsv, pos, sl) { return {"error": "truncated string constant"} }
                            var sval = oren_string_from_bytes_slice(bs, pos, sl)
                            pos = pos + sl
                            oren_list_push(consts, {"type": "String", "value": sval})
                        } else {
                            if tag == 8 {
                                if !byte_view.span_ok(bsv, pos, 4) { return {"error": "truncated bytes length"} }
                                var bl = byte_view.u32_le_at_unchecked(bsv, pos)
                                pos = pos + 4
                                if !byte_view.span_ok(bsv, pos, bl) { return {"error": "truncated bytes constant"} }
                                var bb = oren_u8_buf_from_bytes_slice(bs, pos, bl)
                                pos = pos + bl
                                // detect OBX payload
                                var d = obx_decode(bb)
                                if d != nil {
                                    if d["error"] != nil { return {"error": d["error"]} }
                                    obx = d
                                }
                                var mj = _metadata_json_from_view(byte_view.view(bb))
                                if mj != nil { metadata_json = mj }
                                oren_list_push(consts, {"type": "Bytes", "value": bb})
                            } else {
                                return {"error": "unknown const tag: " + oren_int_to_string(tag)}
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }

    var code = oren_u8_buf_from_bytes_slice(bs, pos, byte_view.view_len(bsv) - pos)
    pos = byte_view.view_len(bsv)

    var g = obc_global_count(code)
    return {"constants": consts, "code": code, "obx": obx, "metadata_json": metadata_json, "global_count": g}
}

fn obc_read_file(path) {
    var bs = oren_read_u8_buf(path)
    if oren_is_err(bs) { return {"error": "read failed: " + path, "err": bs} }
    return obc_parse_bytes(bs)
}

fn obc_global_count(code) {
    // MAX_GLOBALS is small; compute the max index used by LOAD/STORE_GLOBAL.
    if code == nil { return 0 }
    var cv = byte_view.view(code)
    var i = 0
    var max_idx = -1
    var n_code = byte_view.view_len(cv)
    while i < n_code {
        var op = byte_view.u8_at_unchecked(cv, i)
        if op == codegen_bytecode.AVM_LOAD_GLOBAL || op == codegen_bytecode.AVM_STORE_GLOBAL {
            if i + 2 >= n_code { break }
            var idx = byte_view.u16_le_at_unchecked(cv, i + 1)
            if idx > max_idx { max_idx = idx }
            i = i + 3
            continue
        }
        i = i + obc_opcode_len_view(cv, i)
    }
    if max_idx < 0 { return 0 }
    return max_idx + 1
}

fn obc_opcode_len_view(cv, i) {
    var op = byte_view.u8_at_unchecked(cv, i)
    if op == codegen_bytecode.AVM_PUSH_CONST { return 3 }
    if op == codegen_bytecode.AVM_LOAD_LOCAL { return 2 }
    if op == codegen_bytecode.AVM_STORE_LOCAL { return 2 }
    if op == codegen_bytecode.AVM_LOAD_LOCAL16 { return 3 }
    if op == codegen_bytecode.AVM_STORE_LOCAL16 { return 3 }
    if op == codegen_bytecode.AVM_LOAD_GLOBAL { return 3 }
    if op == codegen_bytecode.AVM_STORE_GLOBAL { return 3 }
    if op == codegen_bytecode.AVM_JMP { return 3 }
    if op == codegen_bytecode.AVM_JMP_IF { return 3 }
    if op == codegen_bytecode.AVM_JMP32 { return 5 }
    if op == codegen_bytecode.AVM_JMP_IF32 { return 5 }
    if op == codegen_bytecode.AVM_CALL { return 4 }
    if op == codegen_bytecode.AVM_CALL32 { return 6 }
    if op == codegen_bytecode.AVM_CALL_NATIVE2 { return 5 }
    if op == codegen_bytecode.AVM_PUSH_FUNC { return 3 }
    if op == codegen_bytecode.AVM_PUSH_FUNC32 { return 5 }
    if op == codegen_bytecode.AVM_CALL_INDIRECT { return 2 }
    if op == codegen_bytecode.AVM_CALL_INDIRECT_SPREAD { return 2 }
    if op == codegen_bytecode.AVM_MAKE_CLOSURE { return 2 }
    if op == codegen_bytecode.AVM_LOAD_ENV { return 2 }
    if op == codegen_bytecode.AVM_NEW_LIST { return 3 }
    if op == codegen_bytecode.AVM_NEW_MAP { return 3 }
    return 1
}

fn obc_opcode_len(code, i) {
    // Returns the total byte length of the instruction starting at `i`.
    return obc_opcode_len_view(byte_view.view(code), i)
}

fn _append_code_span_view(out, cv, start, n) {
    var srcp = byte_view.ptr(cv)
    if srcp != nil && srcp != 0 {
        bytes_builder.bytes_extend_ptr(out, srcp + start, n)
        return nil
    }
    var i = 0
    while i < n {
        bytes_builder.bytes_push(out, byte_view.u8_at_unchecked(cv, start + i))
        i = i + 1
    }
    return nil
}

fn _append_patched_code(out, code, code_len_eff, const_base, global_base, code_base) {
    if code == nil { return nil }
    var cv = byte_view.view(code)
    var i = 0
    while i < code_len_eff {
        var op = byte_view.u8_at_unchecked(cv, i)
        var ilen = obc_opcode_len_view(cv, i)
        if op == codegen_bytecode.AVM_PUSH_CONST {
            var idx = byte_view.u16_le_at(cv, i + 1)
            bytes_builder.bytes_push(out, op)
            bytes_builder.bytes_push_u16_le(out, idx + const_base)
            i = i + 3
            continue
        }
        if op == codegen_bytecode.AVM_LOAD_GLOBAL || op == codegen_bytecode.AVM_STORE_GLOBAL {
            var gidx = byte_view.u16_le_at(cv, i + 1)
            bytes_builder.bytes_push(out, op)
            bytes_builder.bytes_push_u16_le(out, gidx + global_base)
            i = i + 3
            continue
        }
        if op == codegen_bytecode.AVM_CALL32 || op == codegen_bytecode.AVM_PUSH_FUNC32 {
            var a = byte_view.u32_le_at(cv, i + 1)
            bytes_builder.bytes_push(out, op)
            bytes_builder.bytes_push_u32_le(out, a + code_base)
            if ilen > 5 { _append_code_span_view(out, cv, i + 5, ilen - 5) }
            i = i + ilen
            continue
        }
        if op == codegen_bytecode.AVM_CALL || op == codegen_bytecode.AVM_PUSH_FUNC {
            var a16 = byte_view.u16_le_at(cv, i + 1)
            bytes_builder.bytes_push(out, op)
            bytes_builder.bytes_push_u16_le(out, a16 + code_base)
            if ilen > 3 { _append_code_span_view(out, cv, i + 3, ilen - 3) }
            i = i + ilen
            continue
        }
        _append_code_span_view(out, cv, i, ilen)
        i = i + ilen
    }
    return nil
}

fn obc_patch_u32_at(code, pos, v) {
    if v < 0 { v = v + 4294967296 }
    bytes_builder.bytes_set_u32_le(code, pos, v)
    return nil
}

fn obc_link(obcs) {
    // Link multiple parsed OBC objects into one:
    // - merge constants
    // - rebase and patch code (const/global/code addresses)
    // - collect exports and patch relocs against the merged export map
    if obcs == nil { obcs = [] }
    var out_consts = []
    var out_code = bytes_builder.bytes_new()
    var export_map = {}
    var all_relocs = []
    var const_base = 0
    var global_base = 0
    var code_base = 0

    var mi = 0
    var obcs_n = oren_list_len(obcs)
    while mi < obcs_n {
        var m = obcs[mi]
        if m == nil { mi = mi + 1; continue }
        var consts = m["constants"]
        var code = m["code"]
        if consts == nil { consts = [] }
        if code == nil { code = [] }
        var consts_n = oren_list_len(consts)

        // Linking semantics (rolling, high leverage):
        //
        // Standalone `.obc` files typically end with an `AVM_HALT` opcode.
        // When linking libraries into a final program, preserving those intermediate HALTs
        // will terminate execution early during the entry "skip function bodies" chain
        // (pc=0 walks JMP32 headers until it reaches the module terminator).
        //
        // Therefore: strip exactly one trailing HALT from every non-final module's code
        // during concatenation. The last module (the main program) keeps its HALT.
        var code_len_eff = byte_view.len(code)
        if mi < (obcs_n - 1) {
            var code_view_for_tail = byte_view.view(code)
            if code_len_eff > 0 && byte_view.u8_at_unchecked(code_view_for_tail, code_len_eff - 1) == codegen_bytecode.AVM_HALT {
                code_len_eff = code_len_eff - 1
            }
        }

        // Merge constants first.
        var ci = 0
        while ci < consts_n {
            oren_list_push(out_consts, consts[ci])
            ci = ci + 1
        }

        // Patch code while appending so parsed u8 buffers do not need to be
        // materialized as boxed byte lists.
        _append_patched_code(out_code, code, code_len_eff, const_base, global_base, code_base)

        // Collect exports and relocs (if present).
        var obx = m["obx"]
        if obx != nil {
            var ex = obx["exports"]
            if ex != nil {
                for name in ex {
                    var addr = ex[name]
                    if addr == nil { addr = 0 }
                    var final = addr + code_base
                    if export_map[name] != nil {
                        return {"error": "duplicate export: " + name}
                    }
                    export_map[name] = final
                }
            }
            var rs = obx["relocs"]
            if rs != nil {
                var ri = 0
                var rs_n = oren_list_len(rs)
                while ri < rs_n {
                    var r = rs[ri]
                    var nm = r["name"]
                    var pos = r["pos"]
                    var kind = r["kind"]
                    if nm == nil { nm = "" }
                    if pos == nil { pos = 0 }
                    if kind == nil { kind = 0 }
                    oren_list_push(all_relocs, {"name": nm, "pos": pos + code_base, "kind": kind})
                    ri = ri + 1
                }
            }
        }

        const_base = const_base + consts_n
        var gc = m["global_count"]
        if gc == nil { gc = 0 }
        global_base = global_base + gc
        code_base = code_base + code_len_eff
        mi = mi + 1
    }

    // Patch relocs.
    var ri2 = 0
    var all_relocs_n = oren_list_len(all_relocs)
    while ri2 < all_relocs_n {
        var r2 = all_relocs[ri2]
        var name2 = r2["name"]
        var pos2 = r2["pos"]
        var addr2 = export_map[name2]
        if addr2 == nil {
            return {"error": "undefined symbol: " + name2}
        }
        obc_patch_u32_at(out_code, pos2, addr2)
        ri2 = ri2 + 1
    }

    return {"constants": out_consts, "code": bytes_builder.bytes_finalize(out_code), "exports": export_map}
}
