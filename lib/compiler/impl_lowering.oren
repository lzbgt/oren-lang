import ast "ast.oren"

// Impl/method-call lowering (whole-program, after module linking).
//
// Why this exists:
// - The parser's impl registry is per-module (per parse), so it cannot resolve
//   method sugar across modules.
// - We want deterministic lowering without runtime vtables in v0.
//
// What it does:
// - Collect all lowered impl functions (from `impl Trait for Type { ... }`) via
//   fields stamped on Function AST nodes during parsing:
//     fn["impl_trait"], fn["impl_type"], fn["impl_method"]
// - Build deterministic registries:
//     impl_methods[type][method] = fn_name OR "__AMBIG__"
//     impl_trait_methods[trait][type][method] = fn_name OR "__AMBIG__"
// - Rewrite call sites in-place:
//     x.method(...)           -> __oren_impl__...(x, ...)   when x has a known annotation in scope
//     Type.method(...)        -> __oren_impl__...( ... )
//     Trait.method(x, ...)    -> __oren_impl__...(x, ...)   when x has a known annotation in scope
//
// This pass is shared by all backends because it runs as part of module linking.

fn tok_loc(tok) {
    if tok == nil { return nil }
    var file = tok["file"]
    if file == nil { file = "<input>" }
    var line = tok["line"]
    var col = tok["col"]
    if line != nil && col != nil {
        return file + ":" + oren_int_to_string(line) + ":" + oren_int_to_string(col)
    }
    var pos = tok["pos"]
    if pos != nil { return file + ":" + oren_int_to_string(pos) }
    return file
}

fn err_push(errs, tok, msg) {
    if errs == nil { return nil }
    var loc = tok_loc(tok)
    if loc != nil { oren_list_push(errs, loc + ": " + msg) }
    else { oren_list_push(errs, msg) }
    return nil
}

fn expr_dotted_name(expr) {
    if expr == nil { return nil }
    if expr["type"] == "Identifier" { return expr["value"] }
    if expr["type"] == "Member" {
        var left = expr_dotted_name(expr["left"])
        if left == nil { return nil }
        if expr["prop"] == nil || expr["prop"]["type"] != "Identifier" { return nil }
        return left + "." + expr["prop"]["value"]
    }
    return nil
}

fn impl_method_register(impl_methods, type_name, method, fn_name, errs) {
    if impl_methods[type_name] == nil { impl_methods[type_name] = {} }
    var m = impl_methods[type_name]
    var prev = m[method]
    if prev == nil {
        m[method] = fn_name
        return nil
    }
    if prev == fn_name { return nil }
    m[method] = "__AMBIG__"
    return nil
}

fn impl_trait_method_register(impl_trait_methods, trait_name, type_name, method, fn_name, errs, tok) {
    if impl_trait_methods[trait_name] == nil { impl_trait_methods[trait_name] = {} }
    if impl_trait_methods[trait_name][type_name] == nil { impl_trait_methods[trait_name][type_name] = {} }
    var m = impl_trait_methods[trait_name][type_name]
    var prev = m[method]
    if prev == nil {
        m[method] = fn_name
        return nil
    }
    if prev == fn_name { return nil }
    m[method] = "__AMBIG__"
    // Coherence (non-negotiable): for any (Trait, Type, method) there must be at most
    // one impl definition in the visible program.
    //
    // Note: method name collisions across traits are allowed; this error is only for
    // the same trait+type+method tuple.
    err_push(errs, tok, "duplicate impl for '" + trait_name + "." + method + "' on type '" + type_name + "'")
    return nil
}

fn impl_method_lookup(impl_methods, type_name, method) {
    // Blanket impl fallback: `impl Trait for any { ... }`
    if impl_methods[type_name] != nil && impl_methods[type_name][method] != nil {
        return impl_methods[type_name][method]
    }
    if impl_methods["any"] != nil {
        return impl_methods["any"][method]
    }
    return nil
}

fn impl_trait_method_lookup(impl_trait_methods, trait_name, type_name, method) {
    // Blanket impl fallback: exact match wins, otherwise `any`.
    if impl_trait_methods[trait_name] == nil { return nil }
    if impl_trait_methods[trait_name][type_name] != nil && impl_trait_methods[trait_name][type_name][method] != nil {
        return impl_trait_methods[trait_name][type_name][method]
    }
    if impl_trait_methods[trait_name]["any"] != nil {
        return impl_trait_methods[trait_name]["any"][method]
    }
    return nil
}

fn collect_trait_set(linked) {
    var set = {}
    if linked == nil { return set }
    var ts = linked["traits"]
    if ts == nil { return set }
    var i = 0
    while i < oren_list_len(ts) {
        var t = ts[i]
        if t != nil && t["name"] != nil {
            set[t["name"]] = true
        }
        i = i + 1
    }
    return set
}

fn collect_impl_registries(linked, errs) {
    var impl_methods = {}
    var impl_trait_methods = {}
    var impl_blocks = {}
    var ss = linked["statements"]
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        // impl blocks are lowered to plain Function expressions inside ExprStmt.
        if st != nil && st["type"] == "ExprStmt" {
            var e = st["expr"]
            if e != nil && e["type"] == "Function" {
                var tr = e["impl_trait"]
                var ty = e["impl_type"]
                var m = e["impl_method"]
                if tr != nil && ty != nil && m != nil {
                    // Coherence: exactly one `impl Trait for Type { ... }` block per (Trait, Type).
                    // Splitting methods across multiple impl blocks makes resolution non-local and
                    // breaks determinism guarantees we want in rolling mode.
                    var bid = e["impl_block_id"]
                    if bid != nil {
                        if impl_blocks[tr] == nil { impl_blocks[tr] = {} }
                        var prev = impl_blocks[tr][ty]
                        if prev == nil {
                            impl_blocks[tr][ty] = bid
                        } else {
                            if prev != bid {
                                err_push(errs, e["token"], "multiple impl blocks for trait '" + tr + "' on type '" + ty + "'")
                            }
                        }
                    }
                    impl_trait_method_register(impl_trait_methods, tr, ty, m, e["name"], errs, e["token"])
                    impl_method_register(impl_methods, ty, m, e["name"], errs)
                }
            }
        }
        i = i + 1
    }
    return {"impl_methods": impl_methods, "impl_trait_methods": impl_trait_methods}
}

fn type_env_new() { return [{}] }

fn type_env_push(env) {
    oren_list_push(env, {})
    return env
}

fn type_env_pop(env) {
    if oren_list_len(env) > 1 {
        // Remove last scope by rebuilding slice (no pop primitive).
        var out = []
        var i = 0
        while i < oren_list_len(env) - 1 {
            oren_list_push(out, env[i])
            i = i + 1
        }
        return out
    }
    return env
}

fn type_env_set(env, name, tname) {
    if name == nil || tname == nil { return nil }
    env[oren_list_len(env) - 1][name] = tname
    return nil
}

fn type_env_get(env, name) {
    if name == nil { return nil }
    var i = oren_list_len(env) - 1
    while i >= 0 {
        var m = env[i]
        if m[name] != nil { return m[name] }
        i = i - 1
    }
    return nil
}

// Best-effort local inference for builtin container method sugar (rolling).
//
// Native backend values are untagged, so we cannot fully do dynamic dispatch at runtime.
// Instead we infer receiver kinds from syntax + local assignments, and only lower
// when we have enough information.
fn kind_env_new() { return [{}] }

fn kind_env_push(env) {
    oren_list_push(env, {})
    return env
}

fn kind_env_pop(env) {
    if oren_list_len(env) > 1 {
        var out = []
        var i = 0
        while i < oren_list_len(env) - 1 {
            oren_list_push(out, env[i])
            i = i + 1
        }
        return out
    }
    return env
}

fn kind_env_set(env, name, kind) {
    if name == nil || kind == nil { return nil }
    env[oren_list_len(env) - 1][name] = kind
    return nil
}

fn kind_env_get(env, name) {
    if name == nil { return nil }
    var i = oren_list_len(env) - 1
    while i >= 0 {
        var m = env[i]
        if m[name] != nil { return m[name] }
        i = i - 1
    }
    return nil
}

fn kind_from_ann_type(ann) {
    if ann == nil { return nil }
    // Rolling "kind annotations" to make builtin container method sugar deterministic
    // in backends where runtime values are not safely tagged.
    //
    // This is intentionally not a full type system; it is a small hint layer:
    //   - :list   enables xs.push(...) / xs.len() lowering to list intrinsics
    //   - :map    enables m.len() lowering to map intrinsics
    //   - :buf    enables b.len() lowering to buf intrinsics
    //   - :string enables s.len() lowering to string intrinsics
    if ann == "list" { return "list" }
    if ann == "map" { return "map" }
    if ann == "buf" { return "buf" }
    if ann == "string" { return "string" }
    return nil
}

fn _trim_trailing_underscores(s) {
    if s == nil { return "" }
    var n = oren_string_len(s)
    while n > 0 && oren_string_char_at(s, n - 1) == "_" {
        n = n - 1
    }
    return oren_string_slice(s, 0, n)
}

fn resolve_ns_name(aliases, expr) {
    // Resolve a dotted/namespace expression for imported-module aliases, using the
    // global alias map produced by module linking.
    //
    // Example:
    //   expr = STD_yaml_list.push
    //   aliases[STD_yaml_list] = "STD_list_"
    //   => "STD_list_push"
    //
    // Returns a string name or nil if resolution fails.
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Identifier" {
        var nm = expr["value"]
        if aliases != nil && aliases[nm] != nil {
            return aliases[nm]
        }
        return nil
    }
    if t == "Member" {
        var left = resolve_ns_name(aliases, expr["left"])
        if left == nil { return nil }
        var base = _trim_trailing_underscores(left)
        if expr["prop"] == nil || expr["prop"]["type"] != "Identifier" { return nil }
        return base + "_" + expr["prop"]["value"]
    }
    return nil
}

fn infer_container_kind(expr, kind_env) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Identifier" {
        return kind_env_get(kind_env, expr["value"])
    }
    if t == "Array" { return "list" }
    if t == "Hash" { return "map" }
    if t == "String" { return "string" }
    if t == "Integer" { return "int" }
    if t == "Prefix" {
        // Best-effort: arithmetic/bitwise prefix ops produce int.
        var op = expr["op"]
        if op == "-" || op == "+" || op == "~" { return "int" }
    }
    if t == "Infix" {
        // Best-effort: arithmetic/bitwise infix ops produce int.
        // Comparisons (==, <, etc) are intentionally not treated as int here.
        var op2 = expr["op"]
        if op2 == "+" || op2 == "-" || op2 == "*" || op2 == "/" || op2 == "%" ||
           op2 == "&" || op2 == "|" || op2 == "^" || op2 == "<<" || op2 == ">>" {
            return "int"
        }
    }
    if t == "Call" {
        var fnn = expr["fn"]
        if fnn != nil && fnn["type"] == "Identifier" {
            var nm = fnn["value"]
            if nm == "oren_i32_buf_new" { return "buf" }
            if nm == "oren_i64_buf_new" { return "buf" }
            if nm == "oren_f32_buf_new" { return "buf" }
            if nm == "oren_f64_buf_new" { return "buf" }
            // Bytes helpers in native mode are list-backed today. We treat these as
            // list constructors for the purpose of container method sugar lowering.
            if nm == "oren_bytes_from_string" { return "list" }
            if nm == "oren_bytes_from_string_ptr" { return "list" }
            if nm == "oren_bytes_unpack" { return "list" }
            // Common string-returning helpers (best-effort) so map key-kind inference can
            // avoid unsafe pointer/int heuristics in x64 native.
            if nm == "string_concat" { return "string" }
            if nm == "oren_int_to_string" { return "string" }
            if nm == "oren_string_slice" { return "string" }

            // Length helpers return int.
            if nm == "oren_list_len" { return "int" }
            if nm == "oren_map_len" { return "int" }
            if nm == "oren_buf_len" { return "int" }
            if nm == "oren_string_len" { return "int" }
        }
    }
    return nil
}

fn infer_map_key_kind(expr, kind_env) {
    // Best-effort key-kind inference for map indexing/set.
    //
    // x64 native stores `key_kind` per entry, but without tagged values the backend cannot
    // safely infer kind for dynamic keys at runtime. This pass tries to infer a stable kind
    // from syntax and local assignments, and annotates Index nodes so x64 codegen can emit
    // deterministic key-kind selection without relying on `key < 4096` heuristics.
    //
    // Returns:
    // - 0 for integer-like keys
    // - 1 for string-like keys
    // - nil when unknown
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Integer" { return 0 }
    if t == "String" { return 1 }
    if t == "Identifier" {
        var k = kind_env_get(kind_env, expr["value"])
        if k == "string" { return 1 }
        if k == "int" { return 0 }
        // Unknown identifier kind => cannot safely infer.
        return nil
    }
    // Numeric expressions are treated as integer keys.
    if t == "Prefix" {
        var op = expr["op"]
        if op == "-" || op == "+" || op == "~" { return 0 }
        return nil
    }
    if t == "Infix" {
        var op2 = expr["op"]
        if op2 == "+" || op2 == "-" || op2 == "*" || op2 == "/" || op2 == "%" ||
           op2 == "&" || op2 == "|" || op2 == "^" || op2 == "<<" || op2 == ">>" {
            return 0
        }
        return nil
    }
    // String-producing calls we recognize.
    if t == "Call" {
        var k2 = infer_container_kind(expr, kind_env)
        if k2 == "string" { return 1 }
        if k2 == "int" { return 0 }
        // Unknown call kind => cannot safely infer.
        return nil
    }
    return nil
}

fn rewrite_builtin_container_call(expr, kind_env) {
    if expr == nil || expr["type"] != "Call" { return expr }
    var fn_expr = expr["fn"]
    if fn_expr == nil || fn_expr["type"] != "Member" { return expr }

    var method = nil
    if fn_expr["prop"] != nil && fn_expr["prop"]["type"] == "Identifier" { method = fn_expr["prop"]["value"] }
    if method == nil { return expr }

    var recv = fn_expr["left"]
    var args = expr["args"]
    if args == nil { args = [] }

    // Builtin container method sugar (rolling):
    // - list.len()   -> oren_list_len(list)
    // - list.push(x) -> oren_list_push(list, x)
    // - map.len()    -> oren_map_len(map)
    // - map.get(k)   -> map[k]
    // - buf.len()    -> oren_buf_len(buf)
    // - string.len() -> oren_string_len(string)
    //
    // NOTE:
    // - map.set(k,v) is statement-only sugar (rewritten in stmt lowering to `m[k] = v`).
    // - If the receiver kind cannot be inferred, we leave it unchanged (user can call
    //   explicit primitives like `oren_list_push`).
    if method == "len" {
        if oren_list_len(args) != 0 { return expr }
        var k = infer_container_kind(recv, kind_env)
        if k == "list" { return ast.new_call(expr["token"], {"type": "Identifier", "token": nil, "value": "oren_list_len"}, [recv]) }
        if k == "map" { return ast.new_call(expr["token"], {"type": "Identifier", "token": nil, "value": "oren_map_len"}, [recv]) }
        if k == "buf" { return ast.new_call(expr["token"], {"type": "Identifier", "token": nil, "value": "oren_buf_len"}, [recv]) }
        if k == "string" { return ast.new_call(expr["token"], {"type": "Identifier", "token": nil, "value": "oren_string_len"}, [recv]) }
        return expr
    }

    if method == "push" {
        if oren_list_len(args) != 1 { return expr }
        var k2 = infer_container_kind(recv, kind_env)
        if k2 == "list" {
            return ast.new_call(expr["token"], {"type": "Identifier", "token": nil, "value": "oren_list_push"}, [recv, args[0]])
        }
        return expr
    }

    if method == "get" {
        if oren_list_len(args) != 1 { return expr }
        var k3 = infer_container_kind(recv, kind_env)
        if k3 == "map" || k3 == "list" {
            return ast.new_index(expr["token"], recv, args[0])
        }
        return expr
    }

    return expr
}

fn rewrite_call_expr(expr, regs, trait_set, env, kind_env, errs) {
    if expr == nil || expr["type"] != "Call" { return expr }

    // Inline stdlib "thin wrappers" for hot container ops (HPC/server).
    //
    // std:list provides ergonomic wrappers around `oren_list_*`, but treating them as
    // normal functions adds avoidable call overhead inside tight loops. The module
    // linker provides a global alias map that lets us safely recognize imported-module
    // member calls without guessing about local variables.
    var resolved = resolve_ns_name(regs["aliases"], expr["fn"])
    if resolved != nil {
        var argsR = expr["args"]
        if argsR == nil { argsR = [] }
        if resolved == "STD_list_len" {
            if oren_list_len(argsR) == 1 {
                return ast.new_call(expr["token"], {"type": "Identifier", "token": nil, "value": "oren_list_len"}, [argsR[0]])
            }
        }
        if resolved == "STD_list_push" {
            if oren_list_len(argsR) == 2 {
                return ast.new_call(expr["token"], {"type": "Identifier", "token": nil, "value": "oren_list_push"}, [argsR[0], argsR[1]])
            }
        }
    }

    // Iterator extension hook (rolling v1):
    //
    // `for x in y { ... }` desugars to `oren_iter_next(y, idx, out_pair)` for identifier iterables.
    //
    // If `y` has an explicit type annotation and that type implements the `Iterable` trait,
    // rewrite the call to the trait impl method:
    //
    //   impl Iterable for MyIter { fn iter_next(self, idx, out_pair) { ... } }
    //
    // This preserves v0 behavior for built-in containers and untyped code, while allowing
    // custom deterministic iterables without introducing runtime vtables.
    var fn0 = expr["fn"]
    if fn0 != nil && fn0["type"] == "Identifier" && fn0["value"] == "oren_iter_next" {
        var args0 = expr["args"]
        if args0 != nil && oren_list_len(args0) >= 3 {
            var recv0 = args0[0]
            if recv0 != nil && recv0["type"] == "Identifier" {
                var recv_type0 = type_env_get(env, recv0["value"])
                if recv_type0 != nil {
                    var qm0 = impl_trait_method_lookup(regs["impl_trait_methods"], "Iterable", recv_type0, "iter_next")
                    if qm0 == "__AMBIG__" {
                        err_push(errs, expr["token"], "ambiguous Iterable.iter_next for type '" + recv_type0 + "'")
                        return expr
                    }
                    if qm0 != nil {
                        expr["fn"] = {"type": "Identifier", "token": nil, "value": qm0}
                        return expr
                    }
                }
            }
        }
    }

    // Builtin container method sugar first (does not require impl/type annotations).
    expr = rewrite_builtin_container_call(expr, kind_env)

    var fn_expr = expr["fn"]
    if fn_expr == nil || fn_expr["type"] != "Member" { return expr }

    var method = nil
    if fn_expr["prop"] != nil && fn_expr["prop"]["type"] == "Identifier" { method = fn_expr["prop"]["value"] }
    if method == nil { return expr }

    var args = expr["args"]
    if args == nil { args = [] }

    // receiver-style: x.method(...)
    if fn_expr["left"] != nil && fn_expr["left"]["type"] == "Identifier" {
        var recv = fn_expr["left"]
        var tname = type_env_get(env, recv["value"])
        if tname != nil {
            var mangled = impl_method_lookup(regs["impl_methods"], tname, method)
            if mangled == "__AMBIG__" {
                err_push(errs, expr["token"], "ambiguous method '" + method + "' for type '" + tname + "' (multiple impls)")
                return expr
            }
            if mangled != nil {
                // Insert receiver as arg0.
                var new_args = [recv]
                var ai = 0
                while ai < oren_list_len(args) {
                    oren_list_push(new_args, args[ai])
                    ai = ai + 1
                }
                expr["args"] = new_args
                expr["fn"] = {"type": "Identifier", "token": nil, "value": mangled}
                return expr
            }
        }
    }

    // trait-qualified: Trait.method(x, ...)
    var tdot = expr_dotted_name(fn_expr["left"])
    if tdot != nil && trait_set[tdot] == true {
        if oren_list_len(args) > 0 {
            var recv0 = args[0]
            if recv0 != nil && recv0["type"] == "Identifier" {
                var recv_type = type_env_get(env, recv0["value"])
                if recv_type != nil {
                    var qm = impl_trait_method_lookup(regs["impl_trait_methods"], tdot, recv_type, method)
                    if qm == "__AMBIG__" {
                        err_push(errs, expr["token"], "ambiguous qualified method '" + tdot + "." + method + "' for type '" + recv_type + "'")
                        return expr
                    }
                    if qm != nil {
                        expr["fn"] = {"type": "Identifier", "token": nil, "value": qm}
                        return expr
                    }
                    // No impl found: do not error here; this might be a normal static call
                    // to a namespaced function `Trait.method` in non-trait code.
                }
            }
        }
    }

    // type-style: Type.method(...)
    //
    // IMPORTANT: do not consult blanket (`any`) fallbacks here.
    // `Module.fn(...)` and `Trait.method(...)` share the same surface syntax and we must
    // avoid rewriting unrelated calls due to a blanket impl on `any`.
    if tdot != nil {
        var by_type = regs["impl_methods"][tdot]
        if by_type != nil {
            var mangled2 = by_type[method]
            if mangled2 == "__AMBIG__" {
                err_push(errs, expr["token"], "ambiguous method '" + method + "' for type '" + tdot + "' (multiple impls)")
                return expr
            }
            if mangled2 != nil {
                expr["fn"] = {"type": "Identifier", "token": nil, "value": mangled2}
                return expr
            }
        }
    }

    return expr
}

fn lower_expr_in_place(expr, regs, trait_set, env, kind_env, errs) {
    if expr == nil { return nil }
    var t = expr["type"]

    if t == "Function" {
        // New scope seeded with annotated params.
        env = type_env_push(env)
        kind_env = kind_env_push(kind_env)
        var params = expr["params"]
        if params != nil {
            var pi = 0
            while pi < oren_list_len(params) {
                var id = params[pi]
                if id != nil && id["type"] == "Identifier" && id["ann_type"] != nil {
                    type_env_set(env, id["value"], id["ann_type"])
                    var k = kind_from_ann_type(id["ann_type"])
                    if k != nil { kind_env_set(kind_env, id["value"], k) }
                }
                pi = pi + 1
            }
        }
        lower_stmt_in_place(expr["body"], regs, trait_set, env, kind_env, errs)
        env = type_env_pop(env)
        kind_env = kind_env_pop(kind_env)
        return expr
    }
    if t == "Prefix" {
        expr["right"] = lower_expr_in_place(expr["right"], regs, trait_set, env, kind_env, errs)
        return expr
    }
    if t == "Infix" {
        expr["left"] = lower_expr_in_place(expr["left"], regs, trait_set, env, kind_env, errs)
        expr["right"] = lower_expr_in_place(expr["right"], regs, trait_set, env, kind_env, errs)
        return expr
    }
    if t == "If" {
        expr["cond"] = lower_expr_in_place(expr["cond"], regs, trait_set, env, kind_env, errs)
        lower_stmt_in_place(expr["consq"], regs, trait_set, env, kind_env, errs)
        if expr["alt"] != nil { lower_stmt_in_place(expr["alt"], regs, trait_set, env, kind_env, errs) }
        return expr
    }
    if t == "Array" {
        var xs = expr["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            xs[i] = lower_expr_in_place(xs[i], regs, trait_set, env, kind_env, errs)
            i = i + 1
        }
        return expr
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            ps[i2]["key"] = lower_expr_in_place(ps[i2]["key"], regs, trait_set, env, kind_env, errs)
            ps[i2]["value"] = lower_expr_in_place(ps[i2]["value"], regs, trait_set, env, kind_env, errs)
            i2 = i2 + 1
        }
        return expr
    }
    if t == "Index" {
        expr["left"] = lower_expr_in_place(expr["left"], regs, trait_set, env, kind_env, errs)
        expr["index"] = lower_expr_in_place(expr["index"], regs, trait_set, env, kind_env, errs)
        // If this is a map index expression and we can infer key kind, annotate it so
        // x64 native can avoid runtime heuristics.
        var recv_k = infer_container_kind(expr["left"], kind_env)
        if recv_k != nil { expr["recv_kind"] = recv_k }
        if recv_k == "map" {
            var kk = infer_map_key_kind(expr["index"], kind_env)
            if kk != nil { expr["known_key_kind"] = kk }
        }
        return expr
    }
    if t == "Member" {
        expr["left"] = lower_expr_in_place(expr["left"], regs, trait_set, env, kind_env, errs)
        return expr
    }
    if t == "SpawnExpr" {
        expr["call"] = lower_expr_in_place(expr["call"], regs, trait_set, env, kind_env, errs)
        return expr
    }
    if t == "Call" {
        expr["fn"] = lower_expr_in_place(expr["fn"], regs, trait_set, env, kind_env, errs)
        var args = expr["args"]
        var i3 = 0
        while i3 < oren_list_len(args) {
            args[i3] = lower_expr_in_place(args[i3], regs, trait_set, env, kind_env, errs)
            i3 = i3 + 1
        }
        if expr["spread"] != nil { expr["spread"] = lower_expr_in_place(expr["spread"], regs, trait_set, env, kind_env, errs) }
        return rewrite_call_expr(expr, regs, trait_set, env, kind_env, errs)
    }
    return expr
}

fn lower_stmt_in_place(stmt, regs, trait_set, env, kind_env, errs) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Block" {
        env = type_env_push(env)
        kind_env = kind_env_push(kind_env)
        var ss = stmt["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            lower_stmt_in_place(ss[i], regs, trait_set, env, kind_env, errs)
            i = i + 1
        }
        env = type_env_pop(env)
        kind_env = kind_env_pop(kind_env)
        return nil
    }
    if t == "Var" {
        stmt["value"] = lower_expr_in_place(stmt["value"], regs, trait_set, env, kind_env, errs)
        var nm = stmt["name"]
        if nm != nil && nm["type"] == "Identifier" && nm["ann_type"] != nil {
            type_env_set(env, nm["value"], nm["ann_type"])
            var kk = kind_from_ann_type(nm["ann_type"])
            if kk != nil { kind_env_set(kind_env, nm["value"], kk) }
        }
        if nm != nil && nm["type"] == "Identifier" {
            var k = infer_container_kind(stmt["value"], kind_env)
            if k != nil { kind_env_set(kind_env, nm["value"], k) }
        }
        return nil
    }
    if t == "Assign" {
        stmt["value"] = lower_expr_in_place(stmt["value"], regs, trait_set, env, kind_env, errs)
        var nm2 = stmt["name"]
        if nm2 != nil && nm2["type"] == "Identifier" {
            var k2 = infer_container_kind(stmt["value"], kind_env)
            if k2 != nil { kind_env_set(kind_env, nm2["value"], k2) }
        }
        return nil
    }
    if t == "Set" {
        stmt["left"] = lower_expr_in_place(stmt["left"], regs, trait_set, env, kind_env, errs)
        stmt["value"] = lower_expr_in_place(stmt["value"], regs, trait_set, env, kind_env, errs)
        return nil
    }
    if t == "ExprStmt" {
        stmt["expr"] = lower_expr_in_place(stmt["expr"], regs, trait_set, env, kind_env, errs)
        // Statement-only sugar: map.set(k,v) / list.set(i,v) -> (container[idx] = v)
        var e = stmt["expr"]
        if e != nil && e["type"] == "Call" && e["fn"] != nil && e["fn"]["type"] == "Member" {
            var prop = nil
            if e["fn"]["prop"] != nil && e["fn"]["prop"]["type"] == "Identifier" { prop = e["fn"]["prop"]["value"] }
            if prop == "set" {
                var recv = e["fn"]["left"]
                var args = e["args"]
                if args != nil && oren_list_len(args) == 2 {
                    var k3 = infer_container_kind(recv, kind_env)
                    if k3 == "map" || k3 == "list" {
                        stmt["type"] = "Set"
                        stmt["left"] = ast.new_index(e["token"], recv, args[0])
                        // Preserve receiver + key kind inference on the synthesized Index node.
                        stmt["left"]["recv_kind"] = k3
                        if k3 == "map" {
                            var kk = infer_map_key_kind(args[0], kind_env)
                            if kk != nil { stmt["left"]["known_key_kind"] = kk }
                        }
                        stmt["value"] = args[1]
                        stmt["expr"] = nil
                    }
                }
            }
        }
        return nil
    }
    if t == "Return" {
        stmt["value"] = lower_expr_in_place(stmt["value"], regs, trait_set, env, kind_env, errs)
        return nil
    }
    if t == "While" {
        stmt["cond"] = lower_expr_in_place(stmt["cond"], regs, trait_set, env, kind_env, errs)
        lower_stmt_in_place(stmt["body"], regs, trait_set, env, kind_env, errs)
        return nil
    }
    if t == "For" {
        env = type_env_push(env)
        kind_env = kind_env_push(kind_env)
        lower_stmt_in_place(stmt["init"], regs, trait_set, env, kind_env, errs)
        stmt["cond"] = lower_expr_in_place(stmt["cond"], regs, trait_set, env, kind_env, errs)
        stmt["post"] = lower_expr_in_place(stmt["post"], regs, trait_set, env, kind_env, errs)
        lower_stmt_in_place(stmt["body"], regs, trait_set, env, kind_env, errs)
        env = type_env_pop(env)
        kind_env = kind_env_pop(kind_env)
        return nil
    }
    if t == "Function" {
        lower_expr_in_place(stmt, regs, trait_set, env, kind_env, errs)
        return nil
    }
    return nil
}

fn lower_linked_program_in_place(linked) {
    var errs = []
    var regs = collect_impl_registries(linked, errs)
    var trait_set = collect_trait_set(linked)
    var env = type_env_new()
    var kind_env = kind_env_new()

    // Alias map for imported namespaces (module linking output).
    // Used by call rewrites like std:list fast-path inlining.
    regs["aliases"] = linked["aliases"]

    // Whole-program traversal (top-level statements + nested functions).
    var ss = linked["statements"]
    var i = 0
    while i < oren_list_len(ss) {
        lower_stmt_in_place(ss[i], regs, trait_set, env, kind_env, errs)
        i = i + 1
    }

    if oren_list_len(errs) > 0 {
        linked["impl_lowering_errors"] = errs
    }
    return nil
}
