import core "arm64_core.oren"
import exprm "arm64_native_expr.oren"
import gc "arm64_native_gc.oren"
import listm "arm64_native_stmt_loops_list.oren"

// List-loop emitters extracted from arm64_native_stmt_loops_list.oren.

fn bytes_new() { return core.bytes_new() }
fn bytes_push(b, v) { return core.bytes_push(b, v) }
fn bytes_extend(b, other) { return core.bytes_extend(b, other) }
fn bytes_extend_list(b, xs) { return core.bytes_extend_list(b, xs) }
fn bytes_len(b) { return core.bytes_len(b) }
fn bytes_finalize(b) { return core.bytes_finalize(b) }
fn set_u32_le(buf, offset, n) { return core.set_u32_le(buf, offset, n) }
fn align_up(n, align) { return core.align_up(n, align) }
fn ceil_div(a, b) { return core.ceil_div(a, b) }
fn int_mod(a, b) { return core.int_mod(a, b) }

fn push_u32_le(buf, n) { return core.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return core.push_u64_le(buf, n) }
fn push_u32_be(buf, n) { return core.push_u32_be(buf, n) }
fn arm64_ctx_fixup_bl(ctx, pos, name) { return core.arm64_ctx_fixup_bl(ctx, pos, name) }

fn insn_add_imm(rd, rn, imm) { return core.insn_add_imm(rd, rn, imm) }
fn insn_add_sp(imm) { return core.insn_add_sp(imm) }
fn insn_add_reg(rd, rn, rm) { return core.insn_add_reg(rd, rn, rm) }
fn insn_and_reg(rd, rn, rm) { return core.insn_and_reg(rd, rn, rm) }
fn insn_b(off) { return core.insn_b(off) }
fn insn_b_cond(off, cond) { return core.insn_b_cond(off, cond) }
fn emit_add_sp_any(ctx, bytes) { return core.emit_add_sp_any(ctx, bytes) }
fn emit_sub_sp_any(ctx, bytes) { return core.emit_sub_sp_any(ctx, bytes) }
fn insn_cmp_reg(rn, rm) { return core.insn_cmp_reg(rn, rm) }
fn insn_ldr_ptr(rd, rn) { return core.insn_ldr_ptr(rd, rn) }
fn insn_ldr_ptr_off(rd, rn, offset) { return core.insn_ldr_ptr_off(rd, rn, offset) }
fn insn_ldr_reg_sp(reg, offset) { return core.insn_ldr_reg_sp(reg, offset) }
fn insn_ldur_reg(rt, rn, offset) { return core.insn_ldur_reg(rt, rn, offset) }
fn insn_madd(rd, rn, rm, ra) { return core.insn_madd(rd, rn, rm, ra) }
fn insn_mov_fp_sp() { return core.insn_mov_fp_sp() }
fn insn_mov_reg(rd, rn) { return core.insn_mov_reg(rd, rn) }
fn insn_mov_sp_fp() { return core.insn_mov_sp_fp() }
fn insn_movz(reg, imm16) { return core.insn_movz(reg, imm16) }
fn insn_mul(rd, rn, rm) { return core.insn_mul(rd, rn, rm) }
fn insn_ret() { return core.insn_ret() }
fn insn_stp_pre() { return core.insn_stp_pre() }
fn insn_stp_pair_pre(rt, rt2, rn, offset) { return core.insn_stp_pair_pre(rt, rt2, rn, offset) }
fn insn_ldp_pair_post(rt, rt2, rn, offset) { return core.insn_ldp_pair_post(rt, rt2, rn, offset) }
fn insn_stur_reg(rt, rn, offset) { return core.insn_stur_reg(rt, rn, offset) }
fn insn_str_ptr(rt, rn) { return core.insn_str_ptr(rt, rn) }
fn insn_str_ptr_off(rt, rn, offset) { return core.insn_str_ptr_off(rt, rn, offset) }
fn insn_str_reg_sp(reg, offset) { return core.insn_str_reg_sp(reg, offset) }
fn insn_str_x0_sp(offset) { return core.insn_str_x0_sp(offset) }
fn insn_sub_reg(rd, rn, rm) { return core.insn_sub_reg(rd, rn, rm) }
fn insn_sub_sp(imm) { return core.insn_sub_sp(imm) }
fn insn_sdiv(rd, rn, rm) { return core.insn_sdiv(rd, rn, rm) }
fn insn_udiv(rd, rn, rm) { return core.insn_udiv(rd, rn, rm) }

fn emit_ldr_reg_sp_any(ctx, reg, offset) { return core.emit_ldr_reg_sp_any(ctx, reg, offset) }
fn emit_str_reg_sp_any(ctx, reg, offset) { return core.emit_str_reg_sp_any(ctx, reg, offset) }
fn emit_ldr_reg_fp_any(ctx, reg, offset) { return core.emit_ldr_reg_fp_any(ctx, reg, offset) }
fn emit_str_reg_fp_any(ctx, reg, offset) { return core.emit_str_reg_fp_any(ctx, reg, offset) }
fn emit_load_ptr_from_base_plus(ctx, dst, base, offset_bytes) { return core.emit_load_ptr_from_base_plus(ctx, dst, base, offset_bytes) }
fn emit_load_i64_imm(ctx, reg, val) { return core.emit_load_i64_imm(ctx, reg, val) }

// Delegate expression compilation to the expr module.
fn native_compile_expr(ctx, expr) { return exprm.native_compile_expr(ctx, expr) }

// Helpers from list matchers module.
fn _arm64_local_fp_off(ctx, name) { return listm._arm64_local_fp_off(ctx, name) }
fn _arm64_str_eq_bytes(a, b) { return listm._arm64_str_eq_bytes(a, b) }
fn _arm64_emit_while_generic(ctx, stmt) { return listm._arm64_emit_while_generic(ctx, stmt) }
fn _arm64_restore_stack_to(ctx, base_stack) { return listm._arm64_restore_stack_to(ctx, base_stack) }

fn _arm64_emit_fast_list_get_sum_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var loads = info["loads"]
    var sum_inty = info["sum_inty"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var load_count = oren_list_len(loads)
    var unique_lists = false
    if list_count == load_count { unique_lists = true }
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_GET_SUM_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_GET_SUM_TICK_MASK", 255)
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_get_sum_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_get_sum_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0 and safepoint mask (keep tick in X9; spill only on safepoint)
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = oren_find_node(list)
        var bl_find = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find, "name": "oren_find_node"})
        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find)
        oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_find_node")

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST == 2)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 2)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // count < n => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_small = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    // sum string flag (once): X26 = native_is_string_ptr(sum)
    emit_ldr_reg_sp_any(ctx, 0, sum_off)
    var bl_sum_flag = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_sum_flag, "name": "native_is_string_ptr"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_sum_flag)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], "native_is_string_ptr")
    push_u32_le(ctx["code"], insn_mov_reg(26, 0))

    if unique_lists {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        var li_init = 0
        while li_init < list_count {
            var buf_slot_init = list_base_off + li_init * 16 + 8
            emit_ldr_reg_sp_any(ctx, 23, buf_slot_init)
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
            emit_str_reg_sp_any(ctx, 23, buf_slot_init)
            li_init = li_init + 1
        }
    }

    // Keep i/sum in registers across iterations.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, sum_off)
    emit_load_i64_imm(ctx, 22, 8)
    if unique_lists {
        // Unique-list fast paths do not need X21 as a scratch register in the loop body,
        // so keep the loop-invariant upper bound hot instead of reloading it from the stack.
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    if unique_lists != true {
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    // Inline throttled safepoint without per-iter tick loads/stores.
    push_u32_le(ctx["code"], insn_add_imm(9, 9, 1))
    push_u32_le(ctx["code"], insn_and_reg(11, 9, 10))
    push_u32_le(ctx["code"], insn_cmp_reg(11, 31))
    var jpos_tick_skip = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ne skip
    gc.native_emit_gc_safepoint_call(ctx)
    push_u32_le(ctx["code"], insn_movz(9, 0)) // reset tick after safepoint
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))
    var tick_skip_pos = bytes_len(ctx["code"])
    var tick_skip_off = (tick_skip_pos - jpos_tick_skip) / 4
    set_u32_le(ctx["code"], jpos_tick_skip, insn_b_cond(tick_skip_off, 1)) // NE

    var pi = 0
    while pi < oren_list_len(loads) {
        var list_name2 = loads[pi]
        var list_index = 0
        while list_index < list_count {
            if _arm64_str_eq_bytes(lists[list_index], list_name2) { break }
            list_index = list_index + 1
        }
        var buf_slot2 = list_base_off + list_index * 16 + 8

        if unique_lists {
            emit_ldr_reg_sp_any(ctx, 24, buf_slot2)
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
            push_u32_le(ctx["code"], insn_add_imm(24, 24, 8))
            emit_str_reg_sp_any(ctx, 24, buf_slot2)
        } else {
            // addr = buf + i*8 ; load value
            emit_ldr_reg_sp_any(ctx, 21, buf_slot2)
            push_u32_le(ctx["code"], insn_mul(24, 20, 22))
            push_u32_le(ctx["code"], insn_add_reg(24, 21, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
        }

        if sum_inty == true {
            // sum is known int => oren_add reduces to iadd
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        } else {
            // If sum is not a string at loop entry, oren_add will always reduce to iadd.
            push_u32_le(ctx["code"], insn_cmp_reg(26, 31))
            var jpos_sum_flag_zero = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.eq iadd

            // sum = oren_add(sum, value), inlined (native strings fast check)
            push_u32_le(ctx["code"], insn_mov_reg(0, 23))
            var bl_sum_str = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_sum_str, "name": "native_is_string_ptr"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_sum_str)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "native_is_string_ptr")
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            var jpos_sum_not_str = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.eq iadd

            push_u32_le(ctx["code"], insn_mov_reg(0, 25))
            var bl_val_str = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_val_str, "name": "native_is_string_ptr"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_val_str)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "native_is_string_ptr")
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            var jpos_val_not_str = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.eq iadd

            push_u32_le(ctx["code"], insn_mov_reg(0, 23))
            push_u32_le(ctx["code"], insn_mov_reg(1, 25))
            var bl_concat = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_concat, "name": "string_concat"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_concat)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "string_concat")
            push_u32_le(ctx["code"], insn_mov_reg(23, 0))
            var jpos_skip_iadd = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b after iadd

            var iadd_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            var after_pos = bytes_len(ctx["code"])
            var off_flag = (iadd_pos - jpos_sum_flag_zero) / 4
            set_u32_le(ctx["code"], jpos_sum_flag_zero, insn_b_cond(off_flag, 0))
            var off_sum = (iadd_pos - jpos_sum_not_str) / 4
            set_u32_le(ctx["code"], jpos_sum_not_str, insn_b_cond(off_sum, 0))
            var off_val = (iadd_pos - jpos_val_not_str) / 4
            set_u32_le(ctx["code"], jpos_val_not_str, insn_b_cond(off_val, 0))
            var off_skip = (after_pos - jpos_skip_iadd) / 4
            set_u32_le(ctx["code"], jpos_skip_iadd, insn_b(off_skip))
        }

        pi = pi + 1
    }

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    listm._arm64_trace_loop_range(ctx, trace_kind, loop_cond_pos, fast_end_pos)
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update idx/sum locals after loop exit.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_int_get_sum_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var loads = info["loads"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var load_count = oren_list_len(loads)
    var unique_lists = false
    if list_count == load_count { unique_lists = true }
    var single_read_list = false
    if unique_lists == true && list_count == 1 && load_count == 1 { single_read_list = true }
    var unroll2 = false
    if unique_lists == true { unroll2 = true }
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_GET_SUM_TICK_MASK", 4095)
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_int_get_sum_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_int_get_sum_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    // inline safepoint mask (restored after runtime calls)
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = oren_find_node(list)
        var bl_find = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find, "name": "oren_find_node"})
        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find)
        oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_find_node")

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST_INT == 8)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 8)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // count < n => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_small = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    if unique_lists {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        var li_init = 0
        while li_init < list_count {
            var buf_slot_init = list_base_off + li_init * 16 + 8
            emit_ldr_reg_sp_any(ctx, 23, buf_slot_init)
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
            emit_str_reg_sp_any(ctx, 23, buf_slot_init)
            li_init = li_init + 1
        }
    }

    // Keep i/sum in registers across iterations.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, sum_off)
    emit_load_i64_imm(ctx, 22, 8)

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    emit_ldr_reg_sp_any(ctx, 21, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    var jpos_fast_single = nil
    var jpos_fast_quad = nil
    if unroll2 == true {
        if single_read_list {
            push_u32_le(ctx["code"], insn_add_imm(24, 20, 3))
            push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
            jpos_fast_quad = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.ge double/single
        }
        push_u32_le(ctx["code"], insn_add_imm(24, 20, 1))
        push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
        jpos_fast_single = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ge single
    }

    gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, [])

    if unique_lists != true {
        // idx_offset = i * 8 (reuse for all list loads)
        push_u32_le(ctx["code"], insn_mul(24, 20, 22))
    }

    if unroll2 == true {
        if single_read_list {
            var buf_slot_quad = list_base_off + 8
            emit_ldr_reg_sp_any(ctx, 24, buf_slot_quad)
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(26, 24, 8))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(27, 24, 16))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(28, 24, 24))
            push_u32_le(ctx["code"], insn_add_imm(24, 24, 32))
            emit_str_reg_sp_any(ctx, 24, buf_slot_quad)

            push_u32_le(ctx["code"], insn_add_reg(25, 25, 27))
            push_u32_le(ctx["code"], insn_add_reg(26, 26, 28))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 26))

            push_u32_le(ctx["code"], insn_add_imm(20, 20, 4))

            var back_pos4 = bytes_len(ctx["code"])
            var back_off4 = (loop_cond_pos - back_pos4) / 4
            push_u32_le(ctx["code"], insn_b(back_off4))
        }

        var fast_double_pos = bytes_len(ctx["code"])
        if jpos_fast_quad != nil {
            var quad_off = (fast_double_pos - jpos_fast_quad) / 4
            set_u32_le(ctx["code"], jpos_fast_quad, insn_b_cond(quad_off, 10)) // GE
        }

        var pi2 = 0
        while pi2 < oren_list_len(loads) {
            var list_name2 = loads[pi2]
            var list_index2 = 0
            while list_index2 < list_count {
                if _arm64_str_eq_bytes(lists[list_index2], list_name2) { break }
                list_index2 = list_index2 + 1
            }
            var buf_slot2u = list_base_off + list_index2 * 16 + 8

            emit_ldr_reg_sp_any(ctx, 24, buf_slot2u)
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(26, 24, 8))
            push_u32_le(ctx["code"], insn_add_imm(24, 24, 16))
            emit_str_reg_sp_any(ctx, 24, buf_slot2u)

            if single_read_list {
                push_u32_le(ctx["code"], insn_add_reg(25, 25, 26))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            } else {
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 26))
            }

            pi2 = pi2 + 1
        }

        // i += 2
        push_u32_le(ctx["code"], insn_add_imm(20, 20, 2))

        var back_pos2 = bytes_len(ctx["code"])
        var back_off2 = (loop_cond_pos - back_pos2) / 4
        push_u32_le(ctx["code"], insn_b(back_off2))

        var fast_single_pos = bytes_len(ctx["code"])
        var single_off = (fast_single_pos - jpos_fast_single) / 4
        set_u32_le(ctx["code"], jpos_fast_single, insn_b_cond(single_off, 10)) // GE

        gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, [])
    }

    var pi = 0
    while pi < oren_list_len(loads) {
        var list_name2 = loads[pi]
        var list_index = 0
        while list_index < list_count {
            if _arm64_str_eq_bytes(lists[list_index], list_name2) { break }
            list_index = list_index + 1
        }
        var buf_slot2 = list_base_off + list_index * 16 + 8

        if unique_lists {
            emit_ldr_reg_sp_any(ctx, 24, buf_slot2)
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
            push_u32_le(ctx["code"], insn_add_reg(24, 24, 22))
            emit_str_reg_sp_any(ctx, 24, buf_slot2)
        } else {
            // addr = buf + i*8 ; load value
            emit_ldr_reg_sp_any(ctx, 21, buf_slot2)
            push_u32_le(ctx["code"], insn_add_reg(25, 21, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 25))
        }
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))

        pi = pi + 1
    }

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    listm._arm64_trace_loop_range(ctx, trace_kind, loop_cond_pos, fast_end_pos)
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update idx/sum locals after loop exit.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_int_dot_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var muls = info["muls"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var mul_count = oren_list_len(muls)
    var unique_lists = false
    if list_count == mul_count * 2 { unique_lists = true }
    var single_mul_pair = false
    if unique_lists == true && list_count == 2 && mul_count == 1 { single_mul_pair = true }
    var single_pair_cursor_regs = true
    var v_single_pair_cursor_regs = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_SINGLE_PAIR_CURSOR_REGS")
    if v_single_pair_cursor_regs != nil && (v_single_pair_cursor_regs == "0" || v_single_pair_cursor_regs == "false") {
        single_pair_cursor_regs = false
    }
    var dual_accum = false
    var v_dual_accum = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_DUAL_ACCUM")
    if v_dual_accum == "1" || v_dual_accum == "true" {
        dual_accum = true
    } else if v_dual_accum != nil && (v_dual_accum == "0" || v_dual_accum == "false") {
        dual_accum = false
    }
    var madd_exact = false
    var v_madd_exact = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT")
    if v_madd_exact == "1" || v_madd_exact == "true" {
        madd_exact = true
    } else if v_madd_exact != nil && (v_madd_exact == "0" || v_madd_exact == "false") {
        madd_exact = false
    }
    var madd_exact_quad = madd_exact
    var v_madd_exact_quad = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_QUAD")
    if v_madd_exact_quad == "1" || v_madd_exact_quad == "true" {
        madd_exact_quad = true
    } else if v_madd_exact_quad != nil && (v_madd_exact_quad == "0" || v_madd_exact_quad == "false") {
        madd_exact_quad = false
    }
    var madd_exact_double = madd_exact
    var v_madd_exact_double = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_DOUBLE")
    if v_madd_exact_double == "1" || v_madd_exact_double == "true" {
        madd_exact_double = true
    } else if v_madd_exact_double != nil && (v_madd_exact_double == "0" || v_madd_exact_double == "false") {
        madd_exact_double = false
    }
    var madd_exact_scalar = madd_exact
    var v_madd_exact_scalar = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_SCALAR")
    if v_madd_exact_scalar == "1" || v_madd_exact_scalar == "true" {
        madd_exact_scalar = true
    } else if v_madd_exact_scalar != nil && (v_madd_exact_scalar == "0" || v_madd_exact_scalar == "false") {
        madd_exact_scalar = false
    }
    var unroll2 = false
    if unique_lists == true { unroll2 = true }
    var v_unroll2 = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_UNROLL2")
    if v_unroll2 == "1" || v_unroll2 == "true" {
        unroll2 = true
    } else if v_unroll2 != nil && (v_unroll2 == "0" || v_unroll2 == "false") {
        unroll2 = false
    }
    // Fast int-dot loops keep the throttled safepoint tick in registers on the hot path.
    // The old dedicated stack tick slot was only kept as a debug escape hatch while we traced
    // potential arm64 offset regressions. Those traces are now clean, so make the slot-free
    // layout the default and allow opt-in restoration for comparison.
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_INT_DOT_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_DOT_TICK_MASK", 4095)
    var safepoint_spill_pairs = []
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_int_dot_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_int_dot_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    // inline safepoint mask (restored after runtime calls)
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = oren_find_node(list)
        var bl_find = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find, "name": "oren_find_node"})
        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find)
        oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_find_node")

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST_INT == 8)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 8)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // count < n => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_small = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    if unique_lists {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        var li_init = 0
        while li_init < list_count {
            var buf_slot_init = list_base_off + li_init * 16 + 8
            emit_ldr_reg_sp_any(ctx, 23, buf_slot_init)
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
            emit_str_reg_sp_any(ctx, 23, buf_slot_init)
            li_init = li_init + 1
        }
        if single_mul_pair && single_pair_cursor_regs {
            // The common benchmark/tier-1 shape is a single read-only list<int> pair.
            // Keep both cursors in preserved regs on the active path, but keep the choice
            // probeable via OREN_ARM64_FAST_LIST_INT_DOT_SINGLE_PAIR_CURSOR_REGS=0 because
            // current host reruns are still too close to justify removing it outright.
            emit_ldr_reg_sp_any(ctx, 19, list_base_off + 8)
            emit_ldr_reg_sp_any(ctx, 26, list_base_off + 24)
            // At inline safepoints only the preserved cursor regs can hide heap pointers from
            // the conservative stack scan on this exact path. Current host reruns still prefer
            // keeping both cursor pairs visible here over the narrower one-pair spill variant.
            safepoint_spill_pairs = [[19, 20], [25, 26]]
            if dual_accum {
                // Split the reduction across two independent accumulators to shorten the
                // dependency chain in the single-pair hot path.
                push_u32_le(ctx["code"], insn_movz(17, 0))
            }
        }
    }

    // Keep i/sum in registers across iterations.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, sum_off)
    emit_load_i64_imm(ctx, 22, 8)
    if unique_lists {
        // Unique-list fast paths do not need X21 as a scratch register in the loop body,
        // so keep the loop-invariant upper bound hot instead of reloading it from the stack.
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    if unique_lists != true {
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    var jpos_fast_single = nil
    var jpos_fast_quad = nil
    if unroll2 == true {
        if single_mul_pair && single_pair_cursor_regs {
            push_u32_le(ctx["code"], insn_add_imm(24, 20, 3))
            push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
            jpos_fast_quad = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.ge double/single
        }
        push_u32_le(ctx["code"], insn_add_imm(24, 20, 1))
        push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
        jpos_fast_single = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ge single
    }

    gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, safepoint_spill_pairs)
    if unique_lists != true {
        // Shared addr offset for the non-unique slow-fast path.
        push_u32_le(ctx["code"], insn_mul(24, 20, 22))
    }

    if unroll2 == true {
        if single_mul_pair && single_pair_cursor_regs {
            push_u32_le(ctx["code"], insn_ldr_ptr(24, 19))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(25, 19, 8))
            push_u32_le(ctx["code"], insn_ldr_ptr(27, 26))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(28, 26, 8))
            if dual_accum {
                push_u32_le(ctx["code"], insn_mul(24, 24, 27))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 24))
                push_u32_le(ctx["code"], insn_mul(25, 25, 28))
                push_u32_le(ctx["code"], insn_add_reg(17, 17, 25))
            } else if madd_exact_quad {
                push_u32_le(ctx["code"], insn_madd(23, 24, 27, 23))
                push_u32_le(ctx["code"], insn_madd(23, 25, 28, 23))
            } else {
                push_u32_le(ctx["code"], insn_mul(24, 24, 27))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 24))
                push_u32_le(ctx["code"], insn_mul(25, 25, 28))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            }

            push_u32_le(ctx["code"], insn_ldr_ptr_off(24, 19, 16))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(25, 19, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(27, 26, 16))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(28, 26, 24))
            if dual_accum {
                push_u32_le(ctx["code"], insn_mul(24, 24, 27))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 24))
                push_u32_le(ctx["code"], insn_mul(25, 25, 28))
                push_u32_le(ctx["code"], insn_add_reg(17, 17, 25))
            } else if madd_exact_quad {
                push_u32_le(ctx["code"], insn_madd(23, 24, 27, 23))
                push_u32_le(ctx["code"], insn_madd(23, 25, 28, 23))
            } else {
                push_u32_le(ctx["code"], insn_mul(24, 24, 27))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 24))
                push_u32_le(ctx["code"], insn_mul(25, 25, 28))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            }

            push_u32_le(ctx["code"], insn_add_imm(19, 19, 32))
            push_u32_le(ctx["code"], insn_add_imm(26, 26, 32))
            push_u32_le(ctx["code"], insn_add_imm(20, 20, 4))

            var back_pos4 = bytes_len(ctx["code"])
            var back_off4 = (loop_cond_pos - back_pos4) / 4
            push_u32_le(ctx["code"], insn_b(back_off4))
        }

        var fast_double_pos = bytes_len(ctx["code"])
        if jpos_fast_quad != nil {
            var quad_off = (fast_double_pos - jpos_fast_quad) / 4
            set_u32_le(ctx["code"], jpos_fast_quad, insn_b_cond(quad_off, 10)) // GE
        }

        var mi2 = 0
        while mi2 < oren_list_len(muls) {
            var mul2 = muls[mi2]
            var left2 = mul2["left"]
            var right2 = mul2["right"]
            var li_left2 = 0
            while li_left2 < list_count {
                if _arm64_str_eq_bytes(lists[li_left2], left2) { break }
                li_left2 = li_left2 + 1
            }
            var li_right2 = 0
            while li_right2 < list_count {
                if _arm64_str_eq_bytes(lists[li_right2], right2) { break }
                li_right2 = li_right2 + 1
            }
            var buf_left2 = list_base_off + li_left2 * 16 + 8
            var buf_right2 = list_base_off + li_right2 * 16 + 8

            if single_mul_pair && single_pair_cursor_regs {
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(28, 19, 8))
                push_u32_le(ctx["code"], insn_add_imm(19, 19, 16))

                push_u32_le(ctx["code"], insn_ldr_ptr(27, 26))
                if madd_exact_double && !dual_accum {
                    push_u32_le(ctx["code"], insn_madd(23, 25, 27, 23))
                } else {
                    push_u32_le(ctx["code"], insn_mul(25, 25, 27))
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                }
                push_u32_le(ctx["code"], insn_ldr_ptr_off(27, 26, 8))
                push_u32_le(ctx["code"], insn_add_imm(26, 26, 16))
            } else {
                // left values (advance cursor by 16)
                emit_ldr_reg_sp_any(ctx, 24, buf_left2)
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(28, 24, 8))
                push_u32_le(ctx["code"], insn_add_imm(24, 24, 16))
                emit_str_reg_sp_any(ctx, 24, buf_left2)

                // right values (advance cursor by 16)
                emit_ldr_reg_sp_any(ctx, 26, buf_right2)
                push_u32_le(ctx["code"], insn_ldr_ptr(27, 26))
                push_u32_le(ctx["code"], insn_mul(25, 25, 27))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(27, 26, 8))
                push_u32_le(ctx["code"], insn_add_imm(26, 26, 16))
                emit_str_reg_sp_any(ctx, 26, buf_right2)
            }

            // sum += left1 * right1
            if single_mul_pair && single_pair_cursor_regs && madd_exact_double && !dual_accum {
                push_u32_le(ctx["code"], insn_madd(23, 28, 27, 23))
            } else {
                push_u32_le(ctx["code"], insn_mul(28, 28, 27))
            }
            if single_mul_pair && single_pair_cursor_regs && dual_accum {
                push_u32_le(ctx["code"], insn_add_reg(17, 17, 28))
            } else if !(single_mul_pair && single_pair_cursor_regs && madd_exact_double && !dual_accum) {
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 28))
            } else {
                // exact-path madd already accumulated into X23
            }

            mi2 = mi2 + 1
        }

        // i += 2
        push_u32_le(ctx["code"], insn_add_imm(20, 20, 2))

        var back_pos2 = bytes_len(ctx["code"])
        var back_off2 = (loop_cond_pos - back_pos2) / 4
        push_u32_le(ctx["code"], insn_b(back_off2))

        var fast_single_pos = bytes_len(ctx["code"])
        var single_off = (fast_single_pos - jpos_fast_single) / 4
        set_u32_le(ctx["code"], jpos_fast_single, insn_b_cond(single_off, 10)) // GE

        gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, safepoint_spill_pairs)
    }
    var mi = 0
    while mi < oren_list_len(muls) {
        var mul = muls[mi]
        var left_list = mul["left"]
        var right_list = mul["right"]
        var li_left = 0
        while li_left < list_count {
            if _arm64_str_eq_bytes(lists[li_left], left_list) { break }
            li_left = li_left + 1
        }
        var li_right = 0
        while li_right < list_count {
            if _arm64_str_eq_bytes(lists[li_right], right_list) { break }
            li_right = li_right + 1
        }
        var buf_left = list_base_off + li_left * 16 + 8
        var buf_right = list_base_off + li_right * 16 + 8

        if unique_lists {
            if single_mul_pair && single_pair_cursor_regs {
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
                push_u32_le(ctx["code"], insn_add_imm(19, 19, 8))

                push_u32_le(ctx["code"], insn_ldr_ptr(27, 26))
                push_u32_le(ctx["code"], insn_add_imm(26, 26, 8))
            } else {
                // left value (advance cursor)
                emit_ldr_reg_sp_any(ctx, 24, buf_left)
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                push_u32_le(ctx["code"], insn_add_imm(24, 24, 8))
                emit_str_reg_sp_any(ctx, 24, buf_left)

                // right value (advance cursor)
                emit_ldr_reg_sp_any(ctx, 26, buf_right)
                push_u32_le(ctx["code"], insn_ldr_ptr(27, 26))
                push_u32_le(ctx["code"], insn_add_imm(26, 26, 8))
                emit_str_reg_sp_any(ctx, 26, buf_right)
            }

            // sum += left * right
            if single_mul_pair && single_pair_cursor_regs && madd_exact_scalar && !dual_accum {
                push_u32_le(ctx["code"], insn_madd(23, 25, 27, 23))
            } else {
                push_u32_le(ctx["code"], insn_mul(25, 25, 27))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            }
        } else {
            // left value
            emit_ldr_reg_sp_any(ctx, 21, buf_left)
            push_u32_le(ctx["code"], insn_add_reg(25, 21, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 25))

            // right value
            emit_ldr_reg_sp_any(ctx, 26, buf_right)
            push_u32_le(ctx["code"], insn_add_reg(27, 26, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(27, 27))

            // sum += left * right
            push_u32_le(ctx["code"], insn_mul(25, 25, 27))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        }

        mi = mi + 1
    }

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    listm._arm64_trace_loop_range(ctx, trace_kind, loop_cond_pos, fast_end_pos)
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update idx/sum locals after loop exit.
    if single_mul_pair && single_pair_cursor_regs && dual_accum {
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 17))
    }
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_dot_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var muls = info["muls"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var mul_count = oren_list_len(muls)
    var unique_lists = false
    if list_count == mul_count * 2 { unique_lists = true }
    // Boxed dot loops follow the same contract as list<int> dot loops: register tick on the
    // hot path, no dedicated stack tick slot by default, optional env escape hatch to restore
    // the old layout while comparing traces.
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_DOT_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_DOT_TICK_MASK", 4095)
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_dot_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_dot_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    // inline safepoint mask (restored after runtime calls)
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = oren_find_node(list)
        var bl_find = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find, "name": "oren_find_node"})
        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find)
        oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_find_node")

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST == 2)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 2)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // count < n => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_small = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    if unique_lists {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        var li_init = 0
        while li_init < list_count {
            var buf_slot_init = list_base_off + li_init * 16 + 8
            emit_ldr_reg_sp_any(ctx, 23, buf_slot_init)
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
            emit_str_reg_sp_any(ctx, 23, buf_slot_init)
            li_init = li_init + 1
        }
    }

    // Keep i/sum in registers across iterations.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, sum_off)
    emit_load_i64_imm(ctx, 22, 8)

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    emit_ldr_reg_sp_any(ctx, 21, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    gc.native_emit_gc_safepoint_inline_tick(ctx, tick_mask)

    var mi = 0
    while mi < oren_list_len(muls) {
        var mul = muls[mi]
        var left_list = mul["left"]
        var right_list = mul["right"]
        var li_left = 0
        while li_left < list_count {
            if _arm64_str_eq_bytes(lists[li_left], left_list) { break }
            li_left = li_left + 1
        }
        var li_right = 0
        while li_right < list_count {
            if _arm64_str_eq_bytes(lists[li_right], right_list) { break }
            li_right = li_right + 1
        }
        var buf_left = list_base_off + li_left * 16 + 8
        var buf_right = list_base_off + li_right * 16 + 8

        if unique_lists {
            // left value (advance cursor)
            emit_ldr_reg_sp_any(ctx, 24, buf_left)
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
            push_u32_le(ctx["code"], insn_add_reg(24, 24, 22))
            emit_str_reg_sp_any(ctx, 24, buf_left)

            // right value (advance cursor)
            emit_ldr_reg_sp_any(ctx, 26, buf_right)
            push_u32_le(ctx["code"], insn_ldr_ptr(27, 26))
            push_u32_le(ctx["code"], insn_add_reg(26, 26, 22))
            emit_str_reg_sp_any(ctx, 26, buf_right)

            // sum += left * right
            push_u32_le(ctx["code"], insn_mul(25, 25, 27))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        } else {
            // left value
            emit_ldr_reg_sp_any(ctx, 21, buf_left)
            push_u32_le(ctx["code"], insn_mul(24, 20, 22))
            push_u32_le(ctx["code"], insn_add_reg(24, 21, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))

            // right value
            emit_ldr_reg_sp_any(ctx, 26, buf_right)
            push_u32_le(ctx["code"], insn_mul(24, 20, 22))
            push_u32_le(ctx["code"], insn_add_reg(24, 26, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(24, 24))

            // sum += left * right
            push_u32_le(ctx["code"], insn_mul(25, 25, 24))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        }

        mi = mi + 1
    }

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update idx/sum locals after loop exit.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_int_push_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var trace_reserve = oren_env("OREN_TRACE_NATIVE_LIST_RESERVE") != nil

    var idx_name = info["idx"]
    var n_name = info["n"]
    var n_const = info["n_const"]
    var lists = info["lists"]
    var pushes = info["pushes"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = nil
    if n_name != nil { n_fp_off = _arm64_local_fp_off(ctx, n_name) }
    if idx_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }
    if n_name != nil && n_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }
    if n_name == nil && n_const == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_INT_PUSH_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_PUSH_TICK_MASK", 4095)
    var slots = 3 + list_count * 2 // tick + i + n + (list, buf)*N
    if !keep_tick_slot { slots = 2 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_int_push_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_int_push_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var list_base_off = slot0 + 16
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    if n_fp_off != nil {
        emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
        emit_str_reg_sp_any(ctx, 0, n_off)
    } else {
        emit_load_i64_imm(ctx, 0, n_const)
        emit_str_reg_sp_any(ctx, 0, n_off)
    }

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = oren_find_node(list)
        var bl_find = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find, "name": "oren_find_node"})
        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find)
        oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_find_node")

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST_INT == 8)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 8)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // capacity check: cap < n => reserve (grow list buffer)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 8) // cap
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_cap_ok = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ge cap_ok
        // list_reserve(list, n)
        if trace_reserve {
            emit_ldr_reg_sp_any(ctx, 0, list_slot) // list
            emit_ldr_reg_sp_any(ctx, 1, n_off)     // new_cap
            emit_load_i64_imm(ctx, 2, 8)
            var bl_trace_reserve = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_trace_reserve, "name": "oren_trace_list_reserve_fast"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_trace_reserve)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_trace_list_reserve_fast")
        }
        emit_ldr_reg_sp_any(ctx, 0, list_slot) // list
        emit_ldr_reg_sp_any(ctx, 1, n_off)     // new_cap
        var bl_reserve = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_reserve, "name": "oren_list_int_reserve"})
        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_reserve)
        oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_list_int_reserve")
        emit_ldr_reg_sp_any(ctx, 0, list_slot) // restore list ptr after call

        var cap_ok_pos = bytes_len(ctx["code"])
        var cap_ok_off = (cap_ok_pos - jpos_cap_ok) / 4
        set_u32_le(ctx["code"], jpos_cap_ok, insn_b_cond(cap_ok_off, 10)) // GE

        // count check: count != i => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, i_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_bad, "cond": 1}) // NE

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 21, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    gc.native_emit_gc_safepoint_inline_tick(ctx, tick_mask)

    // Keep idx local updated for value expressions.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)

    var pi = 0
    while pi < oren_list_len(pushes) {
        var push = pushes[pi]
        var list_name2 = push["list"]
        var value_expr = push["value"]
        var list_index = 0
        while list_index < list_count {
            if _arm64_str_eq_bytes(lists[list_index], list_name2) { break }
            list_index = list_index + 1
        }
        var list_slot2 = list_base_off + list_index * 16
        var buf_slot2 = list_slot2 + 8

        // value -> X0
        native_compile_expr(ctx, value_expr)
        _arm64_restore_stack_to(ctx, loop_base_stack)

        // addr = buf + i*8 ; store value
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_ldr_reg_sp_any(ctx, 21, buf_slot2)
        emit_load_i64_imm(ctx, 22, 8)
        push_u32_le(ctx["code"], insn_mul(23, 20, 22))
        push_u32_le(ctx["code"], insn_add_reg(23, 21, 23))
        push_u32_le(ctx["code"], insn_str_ptr(0, 23))

        pi = pi + 1
    }

    // i++
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))
    emit_str_reg_sp_any(ctx, 20, i_off)

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update list counts after loop exit.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    var li2 = 0
    while li2 < list_count {
        var list_slot3 = list_base_off + li2 * 16
        emit_ldr_reg_sp_any(ctx, 21, list_slot3)
        push_u32_le(ctx["code"], insn_str_ptr(20, 21))
        // Emit list_hdr ring entries on loop exit so GC corruption can be correlated
        // even when compile-time trace flags are not set.
        push_u32_le(ctx["code"], insn_mov_reg(0, 21)) // list
        emit_load_i64_imm(ctx, 1, 7) // list_int_push
        emit_load_i64_imm(ctx, 2, 8) // LIST_INT
        var bl_trace = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_trace, "name": "oren_trace_list_header"})
        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_trace)
        oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_trace_list_header")
        li2 = li2 + 1
    }

    // Update idx local after loop exit.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

