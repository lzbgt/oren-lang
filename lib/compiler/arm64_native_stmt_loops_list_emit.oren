import core "arm64_core.oren"
import exprm "arm64_native_expr.oren"
import gc "arm64_native_gc.oren"
import listm "arm64_native_stmt_loops_list.oren"

// List-loop emitters extracted from arm64_native_stmt_loops_list.oren.

fn bytes_new() { return core.bytes_new() }
fn bytes_push(b, v) { return core.bytes_push(b, v) }
fn bytes_extend(b, other) { return core.bytes_extend(b, other) }
fn bytes_extend_list(b, xs) { return core.bytes_extend_list(b, xs) }
fn bytes_len(b) { return core.bytes_len(b) }
fn bytes_finalize(b) { return core.bytes_finalize(b) }
fn set_u32_le(buf, offset, n) { return core.set_u32_le(buf, offset, n) }
fn align_up(n, align) { return core.align_up(n, align) }
fn ceil_div(a, b) { return core.ceil_div(a, b) }
fn int_mod(a, b) { return core.int_mod(a, b) }

fn push_u32_le(buf, n) { return core.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return core.push_u64_le(buf, n) }
fn push_u32_be(buf, n) { return core.push_u32_be(buf, n) }
fn arm64_ctx_fixup_bl(ctx, pos, name) { return core.arm64_ctx_fixup_bl(ctx, pos, name) }

fn insn_add_imm(rd, rn, imm) { return core.insn_add_imm(rd, rn, imm) }
fn insn_add_sp(imm) { return core.insn_add_sp(imm) }
fn insn_add_reg(rd, rn, rm) { return core.insn_add_reg(rd, rn, rm) }
fn insn_and_reg(rd, rn, rm) { return core.insn_and_reg(rd, rn, rm) }
fn insn_b(off) { return core.insn_b(off) }
fn insn_b_cond(off, cond) { return core.insn_b_cond(off, cond) }
fn emit_add_sp_any(ctx, bytes) { return core.emit_add_sp_any(ctx, bytes) }
fn emit_sub_sp_any(ctx, bytes) { return core.emit_sub_sp_any(ctx, bytes) }
fn insn_cmp_reg(rn, rm) { return core.insn_cmp_reg(rn, rm) }
fn insn_ldr_ptr(rd, rn) { return core.insn_ldr_ptr(rd, rn) }
fn insn_ldr_ptr_off(rd, rn, offset) { return core.insn_ldr_ptr_off(rd, rn, offset) }
fn insn_ldr_ptr_post(rd, rn, offset) { return core.insn_ldr_ptr_post(rd, rn, offset) }
fn insn_ldrsw(rt, rn, offset) { return core.insn_ldrsw(rt, rn, offset) }
fn insn_ldr_reg_sp(reg, offset) { return core.insn_ldr_reg_sp(reg, offset) }
fn insn_ldur_reg(rt, rn, offset) { return core.insn_ldur_reg(rt, rn, offset) }
fn insn_madd(rd, rn, rm, ra) { return core.insn_madd(rd, rn, rm, ra) }
fn insn_mov_fp_sp() { return core.insn_mov_fp_sp() }
fn insn_mov_reg(rd, rn) { return core.insn_mov_reg(rd, rn) }
fn insn_mov_sp_fp() { return core.insn_mov_sp_fp() }
fn insn_movz(reg, imm16) { return core.insn_movz(reg, imm16) }
fn insn_mul(rd, rn, rm) { return core.insn_mul(rd, rn, rm) }
fn insn_ret() { return core.insn_ret() }
fn insn_stp_pre() { return core.insn_stp_pre() }
fn insn_stp_pair_pre(rt, rt2, rn, offset) { return core.insn_stp_pair_pre(rt, rt2, rn, offset) }
fn insn_ldp_pair_post(rt, rt2, rn, offset) { return core.insn_ldp_pair_post(rt, rt2, rn, offset) }
fn insn_stur_reg(rt, rn, offset) { return core.insn_stur_reg(rt, rn, offset) }
fn insn_str_ptr(rt, rn) { return core.insn_str_ptr(rt, rn) }
fn insn_str_ptr_off(rt, rn, offset) { return core.insn_str_ptr_off(rt, rn, offset) }
fn insn_str_reg_sp(reg, offset) { return core.insn_str_reg_sp(reg, offset) }
fn insn_str_x0_sp(offset) { return core.insn_str_x0_sp(offset) }
fn insn_sub_imm(rd, rn, imm) { return core.insn_sub_imm(rd, rn, imm) }
fn insn_sub_reg(rd, rn, rm) { return core.insn_sub_reg(rd, rn, rm) }
fn insn_sub_sp(imm) { return core.insn_sub_sp(imm) }
fn insn_sdiv(rd, rn, rm) { return core.insn_sdiv(rd, rn, rm) }
fn insn_udiv(rd, rn, rm) { return core.insn_udiv(rd, rn, rm) }
fn insn_lsrv(rd, rn, rm) { return core.insn_lsrv(rd, rn, rm) }

fn emit_ldr_reg_sp_any(ctx, reg, offset) { return core.emit_ldr_reg_sp_any(ctx, reg, offset) }
fn emit_str_reg_sp_any(ctx, reg, offset) { return core.emit_str_reg_sp_any(ctx, reg, offset) }
fn emit_ldr_reg_fp_any(ctx, reg, offset) { return core.emit_ldr_reg_fp_any(ctx, reg, offset) }
fn emit_str_reg_fp_any(ctx, reg, offset) { return core.emit_str_reg_fp_any(ctx, reg, offset) }
fn emit_load_ptr_from_base_plus(ctx, dst, base, offset_bytes) { return core.emit_load_ptr_from_base_plus(ctx, dst, base, offset_bytes) }
fn emit_load_i64_imm(ctx, reg, val) { return core.emit_load_i64_imm(ctx, reg, val) }

// Delegate expression compilation to the expr module.
fn native_compile_expr(ctx, expr) { return exprm.native_compile_expr(ctx, expr) }

// Helpers from list matchers module.
fn _arm64_local_fp_off(ctx, name) { return listm._arm64_local_fp_off(ctx, name) }
fn _arm64_str_eq_bytes(a, b) { return listm._arm64_str_eq_bytes(a, b) }
fn _arm64_emit_while_generic(ctx, stmt) { return listm._arm64_emit_while_generic(ctx, stmt) }
fn _arm64_restore_stack_to(ctx, base_stack) { return listm._arm64_restore_stack_to(ctx, base_stack) }

fn _arm64_local_int_const(ctx, name) {
    if ctx == nil || name == nil { return nil }
    return exprm.native_expr_int_const(ctx, {"type": "Identifier", "token": nil, "value": name})
}

fn _arm64_emit_list_int_dot_slot_load(ctx, dst, base, offset, low32_loads) {
    if low32_loads == true {
        push_u32_le(ctx["code"], insn_ldrsw(dst, base, offset))
    } else if offset == 0 {
        push_u32_le(ctx["code"], insn_ldr_ptr(dst, base))
    } else {
        push_u32_le(ctx["code"], insn_ldr_ptr_off(dst, base, offset))
    }
}

// Keep arm64 list fast-loop validation on the same alloc-index lookup x64 already uses.
// Call sites still do explicit kind/magic checks after this helper returns a tracked node or 0.
fn _arm64_emit_find_tracked_node(ctx, ptr_reg, dst_reg) {
    if ctx == nil { return nil }
    if ptr_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(0, ptr_reg)) }
    var bl_find = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find, "name": "native_alloc_index_get"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], "native_alloc_index_get")
    if dst_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(dst_reg, 0)) }
    return nil
}

// Prefix-zero statement fast paths stay opt-in until the full acceptance bundle is clean.
fn _arm64_env_enabled_default_false(name) {
    var v = oren_env(name)
    if v == "1" || v == "true" { return true }
    return false
}

fn _arm64_env_enabled_default_true(name) {
    var v = oren_env(name)
    if v == "0" || v == "false" { return false }
    return true
}

fn _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, expr, idx_name, idx_reg) {
    if ctx == nil || expr == nil || idx_name == nil { return false }
    var int_const = exprm.native_expr_int_const(ctx, expr)
    if int_const != nil {
        emit_load_i64_imm(ctx, 0, int_const)
        return true
    }
    var et = expr["type"]
    if et == "Identifier" {
        if _arm64_str_eq_bytes(expr["value"], idx_name) != true { return false }
        if idx_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(0, idx_reg)) }
        return true
    }
    if et == "Prefix" {
        if expr["op"] != "-" { return false }
        if _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, expr["right"], idx_name, idx_reg) != true { return false }
        push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0))
        return true
    }
    if et != "Infix" { return false }
    var op = expr["op"]
    if op != "+" && op != "-" && op != "*" && op != "%" { return false }

    if _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, expr["left"], idx_name, idx_reg) != true { return false }
    push_u32_le(ctx["code"], insn_sub_sp(16))
    push_u32_le(ctx["code"], insn_str_x0_sp(0))
    ctx["stack_size"] = ctx["stack_size"] + 16

    if _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, expr["right"], idx_name, idx_reg) != true {
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16
        return false
    }

    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
    push_u32_le(ctx["code"], insn_add_sp(16))
    ctx["stack_size"] = ctx["stack_size"] - 16

    if op == "+" {
        push_u32_le(ctx["code"], insn_add_reg(0, 1, 0))
        return true
    }
    if op == "-" {
        push_u32_le(ctx["code"], insn_sub_reg(0, 1, 0))
        return true
    }
    if op == "*" {
        push_u32_le(ctx["code"], insn_mul(0, 1, 0))
        return true
    }

    var rhs_const = exprm.native_expr_int_const(ctx, expr["right"])
    if rhs_const == nil || rhs_const == 0 || rhs_const == -1 { return false }
    push_u32_le(ctx["code"], insn_sdiv(2, 1, 0))
    push_u32_le(ctx["code"], insn_mul(2, 2, 0))
    push_u32_le(ctx["code"], insn_sub_reg(0, 1, 2))
    return true
}

fn _arm64_emit_fast_loop_nonneg_linear_to_x0(ctx, linear, idx_reg) {
    if ctx == nil || linear == nil || idx_reg == nil { return false }
    var mul = linear["mul"]
    var add = linear["add"]
    var mod = linear["mod"]
    if mul == nil || add == nil || mod == nil { return false }
    if mul < 0 || add < 0 || mod < 0 { return false }

    if mul == 0 {
        emit_load_i64_imm(ctx, 0, add)
    } else {
        if idx_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(0, idx_reg)) }
        if mul != 1 {
            emit_load_i64_imm(ctx, 24, mul)
            push_u32_le(ctx["code"], insn_mul(0, 0, 24))
        }
        if add != 0 {
            emit_load_i64_imm(ctx, 24, add)
            push_u32_le(ctx["code"], insn_add_reg(0, 0, 24))
        }
    }
    if mod > 0 {
        emit_load_i64_imm(ctx, 24, mod)
        push_u32_le(ctx["code"], insn_udiv(25, 0, 24))
        push_u32_le(ctx["code"], insn_mul(25, 25, 24))
        push_u32_le(ctx["code"], insn_sub_reg(0, 0, 25))
    }
    return true
}

fn _arm64_emit_trace_list_header_if_enabled(ctx, list_reg) {
    if ctx == nil || ctx["trace_native_list_hdr"] == nil { return nil }
    if list_reg != 0 { push_u32_le(ctx["code"], insn_mov_reg(0, list_reg)) }
    emit_load_i64_imm(ctx, 1, 7) // list_int_push
    emit_load_i64_imm(ctx, 2, 8) // LIST_INT
    var bl_trace = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_trace, "name": "oren_trace_list_header"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_trace)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_trace_list_header")
    return nil
}

fn _arm64_emit_fast_list_int_get_sum_prefix_zero_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return false }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var loads = info["loads"]
    if oren_list_len(lists) != 1 || oren_list_len(loads) != 1 { return false }
    if _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_GET_SUM_PREFIX_ZERO") != true { return false }
    if _arm64_local_int_const(ctx, idx_name) != 0 { return false }
    if _arm64_local_int_const(ctx, sum_name) != 0 { return false }

    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    var list_fp_off = _arm64_local_fp_off(ctx, lists[0])
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil || list_fp_off == nil {
        return false
    }

    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_GET_SUM_TICK_MASK", 4095)
    var trace_kind = "fast_list_int_get_sum_while_no_tick"
    listm._arm64_trace_loop_stack(ctx, trace_kind, ctx["stack_size"], 0, -1, 0)

    push_u32_le(ctx["code"], insn_movz(20, 0)) // X20 = i
    push_u32_le(ctx["code"], insn_movz(22, 0)) // X22 = sum
    emit_ldr_reg_fp_any(ctx, 21, n_fp_off)     // X21 = n
    emit_load_i64_imm(ctx, 26, 1)
    push_u32_le(ctx["code"], insn_cmp_reg(21, 26))
    var jpos_done_small_n = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.lt end

    var slow_jumps = []

    emit_ldr_reg_fp_any(ctx, 19, list_fp_off) // X19 = list
    push_u32_le(ctx["code"], insn_cmp_reg(19, 31))
    var jpos_list_nil = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

    _arm64_emit_find_tracked_node(ctx, 19, 0)

    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_node_nil = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

    emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
    emit_load_i64_imm(ctx, 2, 8)
    push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
    var jpos_kind_bad = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

    emit_load_ptr_from_base_plus(ctx, 1, 19, 24)
    emit_load_i64_imm(ctx, 2, 1279870019)
    push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
    var jpos_magic_bad = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

    emit_load_ptr_from_base_plus(ctx, 1, 19, 0)
    push_u32_le(ctx["code"], insn_cmp_reg(1, 21))
    var jpos_count_small = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

    emit_load_ptr_from_base_plus(ctx, 19, 19, 16) // X19 = ptr
    push_u32_le(ctx["code"], insn_movz(9, 0))
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    var loop_cond_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, [[19, 20], [21, 22]])
    push_u32_le(ctx["code"], insn_ldr_ptr(24, 19))
    push_u32_le(ctx["code"], insn_add_reg(22, 22, 24))
    push_u32_le(ctx["code"], insn_add_imm(19, 19, 8))
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))
    var back_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], insn_b((loop_cond_pos - back_pos) / 4))

    var fast_end_pos = bytes_len(ctx["code"])
    listm._arm64_trace_loop_range(ctx, trace_kind, loop_cond_pos, fast_end_pos)
    set_u32_le(ctx["code"], jpos_done_small_n, insn_b_cond((fast_end_pos - jpos_done_small_n) / 4, 11)) // LT
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond((fast_end_pos - jpos_fast_end) / 4, 10)) // GE

    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 22, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b((end_pos - jpos_skip_slow) / 4))
    return true
}

fn _arm64_emit_fast_list_int_dot_prefix_zero_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return false }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var muls = info["muls"]
    if oren_list_len(lists) != 2 || oren_list_len(muls) != 1 { return false }
    var prefix_zero_enabled = _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_DOT_PREFIX_ZERO")
    var pair_countdown_loop = _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_DOT_PREFIX_ZERO_PAIR_LOOP")
    if prefix_zero_enabled != true && pair_countdown_loop != true { return false }
    if _arm64_local_int_const(ctx, idx_name) != 0 { return false }
    if _arm64_local_int_const(ctx, sum_name) != 0 { return false }

    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return false }

    var pair = muls[0]
    var left_name = pair["left"]
    var right_name = pair["right"]
    var left_fp_off = _arm64_local_fp_off(ctx, left_name)
    var right_fp_off = _arm64_local_fp_off(ctx, right_name)
    if left_fp_off == nil || right_fp_off == nil { return false }

    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_DOT_TICK_MASK", 4095)
    var trace_kind = "fast_list_int_dot_while_no_tick"
    listm._arm64_trace_loop_stack(ctx, trace_kind, ctx["stack_size"], 0, -1, 0)

    push_u32_le(ctx["code"], insn_movz(23, 0)) // X23 = sum
    push_u32_le(ctx["code"], insn_movz(24, 0)) // X24 = i
    push_u32_le(ctx["code"], insn_movz(22, 0)) // X22 = preserved filler / pair-loop secondary sum
    emit_ldr_reg_fp_any(ctx, 21, n_fp_off)     // X21 = n
    emit_load_i64_imm(ctx, 26, 1)
    push_u32_le(ctx["code"], insn_cmp_reg(21, 26))
    var jpos_done_small_n = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.lt end

    var slow_jumps = []

    emit_ldr_reg_fp_any(ctx, 19, left_fp_off) // X19 = a
    push_u32_le(ctx["code"], insn_cmp_reg(19, 31))
    var jpos_left_nil = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_left_nil, "cond": 0}) // EQ

    _arm64_emit_find_tracked_node(ctx, 19, 0)

    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_left_node_nil = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_left_node_nil, "cond": 0}) // EQ

    emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
    emit_load_i64_imm(ctx, 2, 8)
    push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
    var jpos_left_kind_bad = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_left_kind_bad, "cond": 1}) // NE

    emit_load_ptr_from_base_plus(ctx, 1, 19, 24)
    emit_load_i64_imm(ctx, 2, 1279870019)
    push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
    var jpos_left_magic_bad = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_left_magic_bad, "cond": 1}) // NE

    emit_load_ptr_from_base_plus(ctx, 1, 19, 0)
    push_u32_le(ctx["code"], insn_cmp_reg(1, 21))
    var jpos_left_count_small = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_left_count_small, "cond": 11}) // LT

    emit_load_ptr_from_base_plus(ctx, 19, 19, 16) // X19 = pa

    emit_ldr_reg_fp_any(ctx, 20, right_fp_off) // X20 = b
    push_u32_le(ctx["code"], insn_cmp_reg(20, 31))
    var jpos_right_nil = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_right_nil, "cond": 0}) // EQ

    _arm64_emit_find_tracked_node(ctx, 20, 0)

    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_right_node_nil = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_right_node_nil, "cond": 0}) // EQ

    emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
    emit_load_i64_imm(ctx, 2, 8)
    push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
    var jpos_right_kind_bad = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_right_kind_bad, "cond": 1}) // NE

    emit_load_ptr_from_base_plus(ctx, 1, 20, 24)
    emit_load_i64_imm(ctx, 2, 1279870019)
    push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
    var jpos_right_magic_bad = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_right_magic_bad, "cond": 1}) // NE

    emit_load_ptr_from_base_plus(ctx, 1, 20, 0)
    push_u32_le(ctx["code"], insn_cmp_reg(1, 21))
    var jpos_right_count_small = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_right_count_small, "cond": 11}) // LT

    emit_load_ptr_from_base_plus(ctx, 20, 20, 16) // X20 = pb
    push_u32_le(ctx["code"], insn_movz(9, 0))
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    var loop_cond_pos = bytes_len(ctx["code"])
    var jpos_fast_end = nil
    if pair_countdown_loop == true {
        // Counted 2-wide loop: keep the remainder branch outside the hot pair body.
        emit_load_i64_imm(ctx, 26, 1)
        push_u32_le(ctx["code"], insn_lsrv(27, 21, 26)) // X27 = n / 2
        push_u32_le(ctx["code"], insn_add_reg(24, 27, 27)) // X24 = pair-count * 2
        push_u32_le(ctx["code"], insn_cmp_reg(27, 31))
        var jpos_skip_pair_loop = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.eq tail

        var pair_loop_pos = bytes_len(ctx["code"])
        gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, [[19, 20], [21, 22], [23, 24]])
        push_u32_le(ctx["code"], insn_ldp_pair_post(25, 12, 19, 16))
        push_u32_le(ctx["code"], insn_ldp_pair_post(26, 13, 20, 16))
        push_u32_le(ctx["code"], insn_madd(23, 25, 26, 23))
        push_u32_le(ctx["code"], insn_madd(22, 12, 13, 22))
        push_u32_le(ctx["code"], insn_sub_imm(27, 27, 1))
        push_u32_le(ctx["code"], insn_cmp_reg(27, 31))
        var pair_back_pos = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], insn_b_cond((pair_loop_pos - pair_back_pos) / 4, 1)) // NE

        var tail_pos = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], jpos_skip_pair_loop, insn_b_cond((tail_pos - jpos_skip_pair_loop) / 4, 0)) // EQ
        push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
        jpos_fast_end = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.eq end
        gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, [[19, 20], [21, 22], [23, 24]])
        push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
        push_u32_le(ctx["code"], insn_ldr_ptr(26, 20))
        push_u32_le(ctx["code"], insn_madd(23, 25, 26, 23))
        push_u32_le(ctx["code"], insn_mov_reg(24, 21))
    } else {
        push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
        jpos_fast_end = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ge end

        // Mirror the proven direct-slot intrinsic register plan after validation:
        // pa/pb in X19/X20, n in X21, sum/i in X23/X24.
        gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, [[19, 20], [21, 22], [23, 24]])
        push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
        push_u32_le(ctx["code"], insn_ldr_ptr(26, 20))
        push_u32_le(ctx["code"], insn_mul(25, 25, 26))
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        push_u32_le(ctx["code"], insn_add_imm(19, 19, 8))
        push_u32_le(ctx["code"], insn_add_imm(20, 20, 8))
        push_u32_le(ctx["code"], insn_add_imm(24, 24, 1))
        var back_pos = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], insn_b((loop_cond_pos - back_pos) / 4))
    }

    var fast_end_pos = bytes_len(ctx["code"])
    listm._arm64_trace_loop_range(ctx, trace_kind, loop_cond_pos, fast_end_pos)
    set_u32_le(ctx["code"], jpos_done_small_n, insn_b_cond((fast_end_pos - jpos_done_small_n) / 4, 11)) // LT
    if pair_countdown_loop == true {
        set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond((fast_end_pos - jpos_fast_end) / 4, 0)) // EQ
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
    } else {
        set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond((fast_end_pos - jpos_fast_end) / 4, 10)) // GE
    }

    emit_str_reg_fp_any(ctx, 24, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b((end_pos - jpos_skip_slow) / 4))
    return true
}

fn _arm64_emit_fast_list_get_sum_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var loads = info["loads"]
    var sum_inty = info["sum_inty"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var load_count = oren_list_len(loads)
    var unique_lists = false
    if list_count == load_count { unique_lists = true }
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_GET_SUM_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_GET_SUM_TICK_MASK", 255)
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_get_sum_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_get_sum_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0 and safepoint mask (keep tick in X9; spill only on safepoint)
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = native_alloc_index_get(list)
        _arm64_emit_find_tracked_node(ctx, 0, 0)

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST == 2)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 2)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // count < n => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_small = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    // sum string flag (once): X26 = native_is_string_ptr(sum)
    emit_ldr_reg_sp_any(ctx, 0, sum_off)
    var bl_sum_flag = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_sum_flag, "name": "native_is_string_ptr"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_sum_flag)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], "native_is_string_ptr")
    push_u32_le(ctx["code"], insn_mov_reg(26, 0))

    if unique_lists {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        var li_init = 0
        while li_init < list_count {
            var buf_slot_init = list_base_off + li_init * 16 + 8
            emit_ldr_reg_sp_any(ctx, 23, buf_slot_init)
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
            emit_str_reg_sp_any(ctx, 23, buf_slot_init)
            li_init = li_init + 1
        }
    }

    // Keep i/sum in registers across iterations.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, sum_off)
    emit_load_i64_imm(ctx, 22, 8)
    if unique_lists {
        // Unique-list fast paths do not need X21 as a scratch register in the loop body,
        // so keep the loop-invariant upper bound hot instead of reloading it from the stack.
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    if unique_lists != true {
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    // Inline throttled safepoint without per-iter tick loads/stores.
    push_u32_le(ctx["code"], insn_add_imm(9, 9, 1))
    push_u32_le(ctx["code"], insn_and_reg(11, 9, 10))
    push_u32_le(ctx["code"], insn_cmp_reg(11, 31))
    var jpos_tick_skip = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ne skip
    gc.native_emit_gc_safepoint_call(ctx)
    push_u32_le(ctx["code"], insn_movz(9, 0)) // reset tick after safepoint
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))
    var tick_skip_pos = bytes_len(ctx["code"])
    var tick_skip_off = (tick_skip_pos - jpos_tick_skip) / 4
    set_u32_le(ctx["code"], jpos_tick_skip, insn_b_cond(tick_skip_off, 1)) // NE

    var pi = 0
    while pi < oren_list_len(loads) {
        var list_name2 = loads[pi]
        var list_index = 0
        while list_index < list_count {
            if _arm64_str_eq_bytes(lists[list_index], list_name2) { break }
            list_index = list_index + 1
        }
        var buf_slot2 = list_base_off + list_index * 16 + 8

        if unique_lists {
            emit_ldr_reg_sp_any(ctx, 24, buf_slot2)
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
            push_u32_le(ctx["code"], insn_add_imm(24, 24, 8))
            emit_str_reg_sp_any(ctx, 24, buf_slot2)
        } else {
            // addr = buf + i*8 ; load value
            emit_ldr_reg_sp_any(ctx, 21, buf_slot2)
            push_u32_le(ctx["code"], insn_mul(24, 20, 22))
            push_u32_le(ctx["code"], insn_add_reg(24, 21, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
        }

        if sum_inty == true {
            // sum is known int => oren_add reduces to iadd
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        } else {
            // If sum is not a string at loop entry, oren_add will always reduce to iadd.
            push_u32_le(ctx["code"], insn_cmp_reg(26, 31))
            var jpos_sum_flag_zero = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.eq iadd

            // sum = oren_add(sum, value), inlined (native strings fast check)
            push_u32_le(ctx["code"], insn_mov_reg(0, 23))
            var bl_sum_str = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_sum_str, "name": "native_is_string_ptr"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_sum_str)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "native_is_string_ptr")
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            var jpos_sum_not_str = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.eq iadd

            push_u32_le(ctx["code"], insn_mov_reg(0, 25))
            var bl_val_str = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_val_str, "name": "native_is_string_ptr"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_val_str)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "native_is_string_ptr")
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            var jpos_val_not_str = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.eq iadd

            push_u32_le(ctx["code"], insn_mov_reg(0, 23))
            push_u32_le(ctx["code"], insn_mov_reg(1, 25))
            var bl_concat = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_concat, "name": "string_concat"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_concat)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "string_concat")
            push_u32_le(ctx["code"], insn_mov_reg(23, 0))
            var jpos_skip_iadd = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b after iadd

            var iadd_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            var after_pos = bytes_len(ctx["code"])
            var off_flag = (iadd_pos - jpos_sum_flag_zero) / 4
            set_u32_le(ctx["code"], jpos_sum_flag_zero, insn_b_cond(off_flag, 0))
            var off_sum = (iadd_pos - jpos_sum_not_str) / 4
            set_u32_le(ctx["code"], jpos_sum_not_str, insn_b_cond(off_sum, 0))
            var off_val = (iadd_pos - jpos_val_not_str) / 4
            set_u32_le(ctx["code"], jpos_val_not_str, insn_b_cond(off_val, 0))
            var off_skip = (after_pos - jpos_skip_iadd) / 4
            set_u32_le(ctx["code"], jpos_skip_iadd, insn_b(off_skip))
        }

        pi = pi + 1
    }

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    listm._arm64_trace_loop_range(ctx, trace_kind, loop_cond_pos, fast_end_pos)
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update idx/sum locals after loop exit.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_int_get_sum_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    if _arm64_emit_fast_list_int_get_sum_prefix_zero_while(ctx, stmt, info) == true { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var loads = info["loads"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var load_count = oren_list_len(loads)
    var unique_lists = false
    if list_count == load_count { unique_lists = true }
    var single_read_list = false
    if unique_lists == true && list_count == 1 && load_count == 1 { single_read_list = true }
    var whole_list_helper = false
    // Keep the exact whole-list helper opt-in until the shared read-split probe shows a win.
    if single_read_list == true &&
        _arm64_local_int_const(ctx, idx_name) == 0 &&
        _arm64_local_int_const(ctx, sum_name) == 0 &&
        _arm64_env_enabled_default_false("OREN_NATIVE_FAST_LIST_INT_GET_SUM_WHOLE_LIST_HELPER") == true {
        whole_list_helper = true
    }
    var single_list_cursor_regs = false
    if single_read_list == true &&
        _arm64_env_enabled_default_true("OREN_ARM64_FAST_LIST_INT_GET_SUM_SINGLE_LIST_CURSOR_REGS") == true {
        single_list_cursor_regs = true
    }
    // The explicit list<int> get-sum path already has a dedicated 2-wide lowering. After the
    // reserved X27/X28 clobber bug was removed from the unrolled bodies, the exact `array_sum_int`
    // surface and the broad native/runtime gates both came back clean. Ship the common
    // single-read-list shape on the 2-wide path by default, but keep the env knob for broader A/B
    // experiments and emergency disable.
    var unroll2 = single_read_list
    var v_unroll2 = oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_UNROLL2")
    if v_unroll2 == "1" || v_unroll2 == "true" {
        unroll2 = true
    } else if v_unroll2 != nil && (v_unroll2 == "0" || v_unroll2 == "false") {
        unroll2 = false
    }
    // Keep the secondary-accumulator get-sum path as an explicit experiment only. The current
    // same-tree exact C-ceiling decision surface still prefers the shipped default scalar+unroll2
    // body overall, even though the narrower local acceptance wrapper can make this path look good.
    var dual_accum = false
    var v_dual_accum = oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_DUAL_ACCUM")
    if v_dual_accum == "1" || v_dual_accum == "true" {
        dual_accum = true
    } else if v_dual_accum != nil && (v_dual_accum == "0" || v_dual_accum == "false") {
        dual_accum = false
    }
    if single_read_list != true {
        dual_accum = false
    }
    var pair_post = false
    var v_pair_post = oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_PAIR_POST")
    if v_pair_post == "1" || v_pair_post == "true" {
        pair_post = true
    } else if v_pair_post != nil && (v_pair_post == "0" || v_pair_post == "false") {
        pair_post = false
    }
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_INT_GET_SUM_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_GET_SUM_TICK_MASK", 4095)
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_int_get_sum_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_int_get_sum_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    // inline safepoint mask (restored after runtime calls)
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = native_alloc_index_get(list)
        _arm64_emit_find_tracked_node(ctx, 0, 0)

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST_INT == 8)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 8)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // count < n => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_small = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    var jpos_helper_done = nil
    if whole_list_helper == true {
        emit_ldr_reg_sp_any(ctx, 19, list_base_off)
        emit_load_ptr_from_base_plus(ctx, 1, 19, 0)
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_helper_skip = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ne fast-loop path

        var helper_expr = {
            "type": "Call",
            "fn": {"type": "Identifier", "value": "oren_list_int_reduce_sum_slots_unchecked"},
            "args": [{"type": "Identifier", "value": lists[0]}]
        }
        var helper_base_stack = ctx["stack_size"]
        native_compile_expr(ctx, helper_expr)
        _arm64_restore_stack_to(ctx, helper_base_stack)
        emit_str_reg_fp_any(ctx, 0, sum_fp_off)
        emit_ldr_reg_sp_any(ctx, 0, n_off)
        emit_str_reg_fp_any(ctx, 0, idx_fp_off)
        jpos_helper_done = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b end

        var helper_skip_pos = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], jpos_helper_skip, insn_b_cond((helper_skip_pos - jpos_helper_skip) / 4, 1)) // NE
    }

    var safepoint_spill_pairs = []
    if unique_lists {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        var li_init = 0
        while li_init < list_count {
            var buf_slot_init = list_base_off + li_init * 16 + 8
            emit_ldr_reg_sp_any(ctx, 23, buf_slot_init)
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
            emit_str_reg_sp_any(ctx, 23, buf_slot_init)
            li_init = li_init + 1
        }
        if single_read_list && single_list_cursor_regs {
            // Mirror the proven dot single-pair cursor-reg path: keep the unique list<int> cursor in a
            // preserved register so the scalar body stops reloading and re-storing the only active buf
            // slot on every iteration.
            emit_ldr_reg_sp_any(ctx, 19, list_base_off + 8)
            safepoint_spill_pairs = [[19, 20]]
        }
    }

    // Keep i/sum in registers across iterations.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, sum_off)
    if dual_accum {
        push_u32_le(ctx["code"], insn_movz(22, 0))
    } else {
        emit_load_i64_imm(ctx, 22, 8)
    }
    if unique_lists {
        // Unique-list get-sum does not need X21 as a loop-body scratch, so keep the upper bound hot
        // instead of reloading it from the stack every iteration.
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    if unique_lists != true {
        emit_ldr_reg_sp_any(ctx, 21, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    } else {
        push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    }
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    var jpos_fast_single = nil
    var jpos_fast_quad = nil
    if unroll2 == true {
        if single_read_list {
            push_u32_le(ctx["code"], insn_add_imm(24, 20, 3))
            push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
            jpos_fast_quad = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.ge double/single
        }
        push_u32_le(ctx["code"], insn_add_imm(24, 20, 1))
        push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
        jpos_fast_single = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ge single
    }

    gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, safepoint_spill_pairs)

    if unique_lists != true {
        // idx_offset = i * 8 (reuse for all list loads)
        push_u32_le(ctx["code"], insn_mul(24, 20, 22))
    }

    if unroll2 == true {
        if single_read_list {
            var buf_slot_quad = list_base_off + 8
            if single_list_cursor_regs {
                push_u32_le(ctx["code"], insn_mov_reg(24, 19))
            } else {
                emit_ldr_reg_sp_any(ctx, 24, buf_slot_quad)
            }
            // Keep the extra loaded values in caller-saved scratch regs; X27/X28 are reserved
            // global heap registers and must never be reused as loop-body value temps.
            if pair_post {
                // Experimental pair-load path: fold the cursor advance into adjacent loads.
                push_u32_le(ctx["code"], insn_ldp_pair_post(25, 26, 24, 16))
                push_u32_le(ctx["code"], insn_ldp_pair_post(12, 13, 24, 16))
            } else {
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(26, 24, 8))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 24, 16))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(13, 24, 24))
                push_u32_le(ctx["code"], insn_add_imm(24, 24, 32))
            }
            if single_list_cursor_regs {
                push_u32_le(ctx["code"], insn_mov_reg(19, 24))
            } else {
                emit_str_reg_sp_any(ctx, 24, buf_slot_quad)
            }

            if dual_accum {
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                push_u32_le(ctx["code"], insn_add_reg(22, 22, 26))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 12))
                push_u32_le(ctx["code"], insn_add_reg(22, 22, 13))
            } else {
                push_u32_le(ctx["code"], insn_add_reg(25, 25, 12))
                push_u32_le(ctx["code"], insn_add_reg(26, 26, 13))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 26))
            }

            push_u32_le(ctx["code"], insn_add_imm(20, 20, 4))

            var back_pos4 = bytes_len(ctx["code"])
            var back_off4 = (loop_cond_pos - back_pos4) / 4
            push_u32_le(ctx["code"], insn_b(back_off4))
        }

        var fast_double_pos = bytes_len(ctx["code"])
        if jpos_fast_quad != nil {
            var quad_off = (fast_double_pos - jpos_fast_quad) / 4
            set_u32_le(ctx["code"], jpos_fast_quad, insn_b_cond(quad_off, 10)) // GE
        }

        var pi2 = 0
        while pi2 < oren_list_len(loads) {
            var list_name2 = loads[pi2]
            var list_index2 = 0
            while list_index2 < list_count {
                if _arm64_str_eq_bytes(lists[list_index2], list_name2) { break }
                list_index2 = list_index2 + 1
            }
            var buf_slot2u = list_base_off + list_index2 * 16 + 8

            if single_read_list && single_list_cursor_regs {
                push_u32_le(ctx["code"], insn_mov_reg(24, 19))
            } else {
                emit_ldr_reg_sp_any(ctx, 24, buf_slot2u)
            }
            if pair_post {
                push_u32_le(ctx["code"], insn_ldp_pair_post(25, 26, 24, 16))
            } else {
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(26, 24, 8))
                push_u32_le(ctx["code"], insn_add_imm(24, 24, 16))
            }
            if single_read_list && single_list_cursor_regs {
                push_u32_le(ctx["code"], insn_mov_reg(19, 24))
            } else {
                emit_str_reg_sp_any(ctx, 24, buf_slot2u)
            }

            if single_read_list && dual_accum {
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                push_u32_le(ctx["code"], insn_add_reg(22, 22, 26))
            } else if single_read_list {
                push_u32_le(ctx["code"], insn_add_reg(25, 25, 26))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            } else {
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 26))
            }

            pi2 = pi2 + 1
        }

        // i += 2
        push_u32_le(ctx["code"], insn_add_imm(20, 20, 2))

        var back_pos2 = bytes_len(ctx["code"])
        var back_off2 = (loop_cond_pos - back_pos2) / 4
        push_u32_le(ctx["code"], insn_b(back_off2))

        var fast_single_pos = bytes_len(ctx["code"])
        var single_off = (fast_single_pos - jpos_fast_single) / 4
        set_u32_le(ctx["code"], jpos_fast_single, insn_b_cond(single_off, 10)) // GE

        gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, safepoint_spill_pairs)
    }

    var pi = 0
    while pi < oren_list_len(loads) {
        var list_name2 = loads[pi]
        var list_index = 0
        while list_index < list_count {
            if _arm64_str_eq_bytes(lists[list_index], list_name2) { break }
            list_index = list_index + 1
        }
        var buf_slot2 = list_base_off + list_index * 16 + 8

        if unique_lists {
            if single_read_list && single_list_cursor_regs {
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
                push_u32_le(ctx["code"], insn_add_imm(19, 19, 8))
            } else {
                emit_ldr_reg_sp_any(ctx, 24, buf_slot2)
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                push_u32_le(ctx["code"], insn_add_reg(24, 24, 22))
                emit_str_reg_sp_any(ctx, 24, buf_slot2)
            }
        } else {
            // addr = buf + i*8 ; load value
            emit_ldr_reg_sp_any(ctx, 21, buf_slot2)
            push_u32_le(ctx["code"], insn_add_reg(25, 21, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 25))
        }
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))

        pi = pi + 1
    }

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    listm._arm64_trace_loop_range(ctx, trace_kind, loop_cond_pos, fast_end_pos)
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    if dual_accum {
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
    }

    // Update idx/sum locals after loop exit.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))
    if jpos_helper_done != nil {
        set_u32_le(ctx["code"], jpos_helper_done, insn_b((end_pos - jpos_helper_done) / 4))
    }

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_int_dot_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    if _arm64_emit_fast_list_int_dot_prefix_zero_while(ctx, stmt, info) == true { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var muls = info["muls"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var mul_count = oren_list_len(muls)
    var unique_lists = false
    if list_count == mul_count * 2 { unique_lists = true }
    var single_mul_pair = false
    if unique_lists == true && list_count == 2 && mul_count == 1 { single_mul_pair = true }
    var whole_list_helper = false
    // Keep the exact whole-list helper opt-in until the shared read-split probe shows a win.
    if mul_count == 1 &&
        _arm64_local_int_const(ctx, idx_name) == 0 &&
        _arm64_local_int_const(ctx, sum_name) == 0 &&
        _arm64_env_enabled_default_false("OREN_NATIVE_FAST_LIST_INT_DOT_WHOLE_LIST_HELPER") == true {
        whole_list_helper = true
    }
    var single_pair_cursor_regs = true
    var v_single_pair_cursor_regs = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_SINGLE_PAIR_CURSOR_REGS")
    if v_single_pair_cursor_regs != nil && (v_single_pair_cursor_regs == "0" || v_single_pair_cursor_regs == "false") {
        single_pair_cursor_regs = false
    }
    var low32_loads = false
    if single_mul_pair &&
        single_pair_cursor_regs &&
        _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_DOT_LOW32_LOADS") == true {
        low32_loads = true
    }
    var dual_accum = false
    var v_dual_accum = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_DUAL_ACCUM")
    if v_dual_accum == "1" || v_dual_accum == "true" {
        dual_accum = true
    } else if v_dual_accum != nil && (v_dual_accum == "0" || v_dual_accum == "false") {
        dual_accum = false
    }
    var dual_madd = false
    var v_dual_madd = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_DUAL_MADD")
    if dual_accum && (v_dual_madd == "1" || v_dual_madd == "true") {
        dual_madd = true
    } else if v_dual_madd != nil && (v_dual_madd == "0" || v_dual_madd == "false") {
        dual_madd = false
    }
    var madd_exact = false
    var v_madd_exact = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT")
    if v_madd_exact == "1" || v_madd_exact == "true" {
        madd_exact = true
    } else if v_madd_exact != nil && (v_madd_exact == "0" || v_madd_exact == "false") {
        madd_exact = false
    }
    var madd_exact_quad = madd_exact
    var v_madd_exact_quad = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_QUAD")
    if v_madd_exact_quad == "1" || v_madd_exact_quad == "true" {
        madd_exact_quad = true
    } else if v_madd_exact_quad != nil && (v_madd_exact_quad == "0" || v_madd_exact_quad == "false") {
        madd_exact_quad = false
    }
    var madd_exact_double = madd_exact
    var v_madd_exact_double = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_DOUBLE")
    if v_madd_exact_double == "1" || v_madd_exact_double == "true" {
        madd_exact_double = true
    } else if v_madd_exact_double != nil && (v_madd_exact_double == "0" || v_madd_exact_double == "false") {
        madd_exact_double = false
    }
    // On the post-unroll2 baseline, the scalar exact-madd tail is no longer a clear default-on win.
    // Keep it as an explicit opt-in until the current scalar-core matrix turns into a durable across-
    // surface improvement instead of a steady-vs-gate trade-off.
    var madd_exact_scalar = false
    var v_madd_exact_scalar = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_SCALAR")
    if v_madd_exact_scalar == "1" || v_madd_exact_scalar == "true" {
        madd_exact_scalar = true
    } else if v_madd_exact_scalar != nil && (v_madd_exact_scalar == "0" || v_madd_exact_scalar == "false") {
        madd_exact_scalar = false
    }
    var scalar_post = false
    if _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_DOT_SCALAR_POST") == true {
        scalar_post = true
    }
    // The old unique-list default-on unroll2 path now loses on both generic and explicit raw
    // medians on the current host. Keep it as an explicit opt-in experiment instead of shipping it.
    var unroll2 = false
    var pair_post = false
    var v_pair_post = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_PAIR_POST")
    if v_pair_post == "1" || v_pair_post == "true" {
        pair_post = true
    } else if v_pair_post != nil && (v_pair_post == "0" || v_pair_post == "false") {
        pair_post = false
    }
    var v_unroll2 = oren_env("OREN_ARM64_FAST_LIST_INT_DOT_UNROLL2")
    if v_unroll2 == "1" || v_unroll2 == "true" {
        unroll2 = true
    } else if v_unroll2 != nil && (v_unroll2 == "0" || v_unroll2 == "false") {
        unroll2 = false
    }
    // Fast int-dot loops keep the throttled safepoint tick in registers on the hot path.
    // The old dedicated stack tick slot was only kept as a debug escape hatch while we traced
    // potential arm64 offset regressions. Those traces are now clean, so make the slot-free
    // layout the default and allow opt-in restoration for comparison.
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_INT_DOT_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_DOT_TICK_MASK", 4095)
    var safepoint_spill_pairs = []
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_int_dot_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_int_dot_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    // inline safepoint mask (restored after runtime calls)
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = native_alloc_index_get(list)
        _arm64_emit_find_tracked_node(ctx, 0, 0)

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST_INT == 8)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 8)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // count < n => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_small = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    var jpos_helper_done = nil
    if whole_list_helper == true {
        var helper_ok_jumps = []
        var hi = 0
        while hi < list_count {
            var helper_list_slot = list_base_off + hi * 16
            emit_ldr_reg_sp_any(ctx, 19, helper_list_slot)
            emit_load_ptr_from_base_plus(ctx, 1, 19, 0)
            emit_ldr_reg_sp_any(ctx, 2, n_off)
            push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
            var jpos_helper_count_bad = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(helper_ok_jumps, jpos_helper_count_bad)
            hi = hi + 1
        }

        var helper_mul = muls[0]
        var helper_expr = {
            "type": "Call",
            "fn": {"type": "Identifier", "value": "oren_list_int_dot_slots_unchecked"},
            "args": [
                {"type": "Identifier", "value": helper_mul["left"]},
                {"type": "Identifier", "value": helper_mul["right"]}
            ]
        }
        var helper_base_stack = ctx["stack_size"]
        native_compile_expr(ctx, helper_expr)
        _arm64_restore_stack_to(ctx, helper_base_stack)
        emit_str_reg_fp_any(ctx, 0, sum_fp_off)
        emit_ldr_reg_sp_any(ctx, 0, n_off)
        emit_str_reg_fp_any(ctx, 0, idx_fp_off)
        jpos_helper_done = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b end

        var helper_skip_pos = bytes_len(ctx["code"])
        var hji = 0
        while hji < oren_list_len(helper_ok_jumps) {
            var helper_skip_jump = helper_ok_jumps[hji]
            set_u32_le(ctx["code"], helper_skip_jump, insn_b_cond((helper_skip_pos - helper_skip_jump) / 4, 1)) // NE
            hji = hji + 1
        }
    }

    if unique_lists {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        var li_init = 0
        while li_init < list_count {
            var buf_slot_init = list_base_off + li_init * 16 + 8
            emit_ldr_reg_sp_any(ctx, 23, buf_slot_init)
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
            emit_str_reg_sp_any(ctx, 23, buf_slot_init)
            li_init = li_init + 1
        }
        if single_mul_pair && single_pair_cursor_regs {
            // The common benchmark/tier-1 shape is a single read-only list<int> pair.
            // Keep both cursors in preserved regs on the active path, but keep the choice
            // probeable via OREN_ARM64_FAST_LIST_INT_DOT_SINGLE_PAIR_CURSOR_REGS=0 because
            // current host reruns are still too close to justify removing it outright.
            emit_ldr_reg_sp_any(ctx, 19, list_base_off + 8)
            emit_ldr_reg_sp_any(ctx, 26, list_base_off + 24)
            // At inline safepoints only the preserved cursor regs can hide heap pointers from
            // the conservative stack scan on this exact path. Current host reruns still prefer
            // keeping both cursor pairs visible here over the narrower one-pair spill variant.
            safepoint_spill_pairs = [[19, 20], [25, 26]]
            if dual_accum {
                // Split the reduction across two independent accumulators to shorten the
                // dependency chain in the single-pair hot path. Keep the secondary accumulator in
                // X22, not X17: inline GC safepoints only reset caller-saved scratch regs (X9/X10/X11),
                // and the runtime call itself is only required to preserve callee-saved regs.
                push_u32_le(ctx["code"], insn_movz(22, 0))
            }
        }
    }

    // Keep i/sum in registers across iterations.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, sum_off)
    if unique_lists != true {
        emit_load_i64_imm(ctx, 22, 8)
    }
    if unique_lists {
        // Unique-list fast paths do not need X21 as a scratch register in the loop body,
        // so keep the loop-invariant upper bound hot instead of reloading it from the stack.
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }
    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    if unique_lists != true {
        emit_ldr_reg_sp_any(ctx, 21, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    } else {
        push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    }
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    var jpos_fast_single = nil
    var jpos_fast_quad = nil
    if unroll2 == true {
        if single_mul_pair && single_pair_cursor_regs {
            push_u32_le(ctx["code"], insn_add_imm(24, 20, 3))
            push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
            jpos_fast_quad = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.ge double/single
        }
        push_u32_le(ctx["code"], insn_add_imm(24, 20, 1))
        push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
        jpos_fast_single = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ge single
    }

    gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, safepoint_spill_pairs)
    if unique_lists != true {
        // Shared addr offset for the non-unique slow-fast path.
        push_u32_le(ctx["code"], insn_mul(24, 20, 22))
    }

    if unroll2 == true {
        if single_mul_pair && single_pair_cursor_regs {
            if low32_loads {
                _arm64_emit_list_int_dot_slot_load(ctx, 24, 19, 0, true)
                _arm64_emit_list_int_dot_slot_load(ctx, 25, 19, 8, true)
                _arm64_emit_list_int_dot_slot_load(ctx, 12, 26, 0, true)
                _arm64_emit_list_int_dot_slot_load(ctx, 13, 26, 8, true)
            } else if pair_post {
                // Experimental pair-load path: fold the cursor advance into adjacent loads.
                push_u32_le(ctx["code"], insn_ldp_pair_post(24, 25, 19, 16))
                push_u32_le(ctx["code"], insn_ldp_pair_post(12, 13, 26, 16))
            } else {
                push_u32_le(ctx["code"], insn_ldr_ptr(24, 19))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(25, 19, 8))
                push_u32_le(ctx["code"], insn_ldr_ptr(12, 26))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(13, 26, 8))
            }
            if dual_accum {
                if dual_madd {
                    push_u32_le(ctx["code"], insn_madd(23, 24, 12, 23))
                    push_u32_le(ctx["code"], insn_madd(22, 25, 13, 22))
                } else {
                    push_u32_le(ctx["code"], insn_mul(24, 24, 12))
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 24))
                    push_u32_le(ctx["code"], insn_mul(25, 25, 13))
                    push_u32_le(ctx["code"], insn_add_reg(22, 22, 25))
                }
            } else if madd_exact_quad {
                push_u32_le(ctx["code"], insn_madd(23, 24, 12, 23))
                push_u32_le(ctx["code"], insn_madd(23, 25, 13, 23))
            } else {
                push_u32_le(ctx["code"], insn_mul(24, 24, 12))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 24))
                push_u32_le(ctx["code"], insn_mul(25, 25, 13))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            }

            if low32_loads {
                _arm64_emit_list_int_dot_slot_load(ctx, 24, 19, 16, true)
                _arm64_emit_list_int_dot_slot_load(ctx, 25, 19, 24, true)
                _arm64_emit_list_int_dot_slot_load(ctx, 12, 26, 16, true)
                _arm64_emit_list_int_dot_slot_load(ctx, 13, 26, 24, true)
            } else if pair_post {
                push_u32_le(ctx["code"], insn_ldp_pair_post(24, 25, 19, 16))
                push_u32_le(ctx["code"], insn_ldp_pair_post(12, 13, 26, 16))
            } else {
                push_u32_le(ctx["code"], insn_ldr_ptr_off(24, 19, 16))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(25, 19, 24))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 26, 16))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(13, 26, 24))
            }
            if dual_accum {
                if dual_madd {
                    push_u32_le(ctx["code"], insn_madd(23, 24, 12, 23))
                    push_u32_le(ctx["code"], insn_madd(22, 25, 13, 22))
                } else {
                    push_u32_le(ctx["code"], insn_mul(24, 24, 12))
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 24))
                    push_u32_le(ctx["code"], insn_mul(25, 25, 13))
                    push_u32_le(ctx["code"], insn_add_reg(22, 22, 25))
                }
            } else if madd_exact_quad {
                push_u32_le(ctx["code"], insn_madd(23, 24, 12, 23))
                push_u32_le(ctx["code"], insn_madd(23, 25, 13, 23))
            } else {
                push_u32_le(ctx["code"], insn_mul(24, 24, 12))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 24))
                push_u32_le(ctx["code"], insn_mul(25, 25, 13))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            }

            if low32_loads || !pair_post {
                push_u32_le(ctx["code"], insn_add_imm(19, 19, 32))
                push_u32_le(ctx["code"], insn_add_imm(26, 26, 32))
            }
            push_u32_le(ctx["code"], insn_add_imm(20, 20, 4))

            var back_pos4 = bytes_len(ctx["code"])
            var back_off4 = (loop_cond_pos - back_pos4) / 4
            push_u32_le(ctx["code"], insn_b(back_off4))
        }

        var fast_double_pos = bytes_len(ctx["code"])
        if jpos_fast_quad != nil {
            var quad_off = (fast_double_pos - jpos_fast_quad) / 4
            set_u32_le(ctx["code"], jpos_fast_quad, insn_b_cond(quad_off, 10)) // GE
        }

        var exact_double_terminal_guard_pos = nil
        var exact_double_after_pos = nil

        var mi2 = 0
        while mi2 < oren_list_len(muls) {
            var mul2 = muls[mi2]
            var left2 = mul2["left"]
            var right2 = mul2["right"]
            var li_left2 = 0
            while li_left2 < list_count {
                if _arm64_str_eq_bytes(lists[li_left2], left2) { break }
                li_left2 = li_left2 + 1
            }
            var li_right2 = 0
            while li_right2 < list_count {
                if _arm64_str_eq_bytes(lists[li_right2], right2) { break }
                li_right2 = li_right2 + 1
            }
            var buf_left2 = list_base_off + li_left2 * 16 + 8
            var buf_right2 = list_base_off + li_right2 * 16 + 8

            if single_mul_pair && single_pair_cursor_regs {
                if madd_exact_double && !dual_accum && exact_double_terminal_guard_pos == nil {
                    // The exact-double madd variant is only correctness-clean on the current host
                    // when the 2-wide chunk is followed by the scalar tail (remainder==3). If this
                    // double chunk is terminal (remainder==2), fall back to the baseline mul/add
                    // body until the direct-exit hazard is fully understood.
                    push_u32_le(ctx["code"], insn_add_imm(24, 20, 2))
                    push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
                    exact_double_terminal_guard_pos = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // patched: b.ge fallback mul/add double path
                }
                if low32_loads {
                    _arm64_emit_list_int_dot_slot_load(ctx, 25, 19, 0, true)
                    _arm64_emit_list_int_dot_slot_load(ctx, 12, 19, 8, true)
                    push_u32_le(ctx["code"], insn_add_imm(19, 19, 16))
                    _arm64_emit_list_int_dot_slot_load(ctx, 13, 26, 0, true)
                    _arm64_emit_list_int_dot_slot_load(ctx, 24, 26, 8, true)
                    push_u32_le(ctx["code"], insn_add_imm(26, 26, 16))
                } else if pair_post {
                    push_u32_le(ctx["code"], insn_ldp_pair_post(25, 12, 19, 16))
                    push_u32_le(ctx["code"], insn_ldp_pair_post(13, 24, 26, 16))
                } else {
                    push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 19, 8))
                    push_u32_le(ctx["code"], insn_add_imm(19, 19, 16))
                    push_u32_le(ctx["code"], insn_ldr_ptr(13, 26))
                }
                if dual_accum && dual_madd {
                    push_u32_le(ctx["code"], insn_madd(23, 25, 13, 23))
                } else if madd_exact_double && !dual_accum {
                    push_u32_le(ctx["code"], insn_madd(23, 25, 13, 23))
                } else {
                    push_u32_le(ctx["code"], insn_mul(25, 25, 13))
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                }
                if !low32_loads && !pair_post {
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(13, 26, 8))
                    push_u32_le(ctx["code"], insn_add_imm(26, 26, 16))
                }
            } else {
                // left values (advance cursor by 16)
                emit_ldr_reg_sp_any(ctx, 24, buf_left2)
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 24, 8))
                push_u32_le(ctx["code"], insn_add_imm(24, 24, 16))
                emit_str_reg_sp_any(ctx, 24, buf_left2)

                // right values (advance cursor by 16)
                emit_ldr_reg_sp_any(ctx, 26, buf_right2)
                push_u32_le(ctx["code"], insn_ldr_ptr(13, 26))
                push_u32_le(ctx["code"], insn_mul(25, 25, 13))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(13, 26, 8))
                push_u32_le(ctx["code"], insn_add_imm(26, 26, 16))
                emit_str_reg_sp_any(ctx, 26, buf_right2)
            }

            // sum += left1 * right1
            if single_mul_pair && single_pair_cursor_regs && dual_accum && dual_madd {
                if pair_post || low32_loads {
                    push_u32_le(ctx["code"], insn_madd(22, 12, 24, 22))
                } else {
                    push_u32_le(ctx["code"], insn_madd(22, 12, 13, 22))
                }
            } else if single_mul_pair && single_pair_cursor_regs && madd_exact_double && !dual_accum {
                if pair_post || low32_loads {
                    push_u32_le(ctx["code"], insn_madd(23, 12, 24, 23))
                } else {
                    push_u32_le(ctx["code"], insn_madd(23, 12, 13, 23))
                }
            } else {
                if single_mul_pair && single_pair_cursor_regs && (pair_post || low32_loads) {
                    push_u32_le(ctx["code"], insn_mul(12, 12, 24))
                } else {
                    push_u32_le(ctx["code"], insn_mul(12, 12, 13))
                }
            }
            if single_mul_pair && single_pair_cursor_regs && dual_accum {
                if !dual_madd {
                    push_u32_le(ctx["code"], insn_add_reg(22, 22, 12))
                }
            } else if !(single_mul_pair && single_pair_cursor_regs && madd_exact_double && !dual_accum) {
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 12))
            } else {
                // exact-path madd already accumulated into X23
            }

            mi2 = mi2 + 1
        }

        if exact_double_terminal_guard_pos != nil {
            exact_double_after_pos = bytes_len(ctx["code"])
            var exact_double_after_jump = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b after fallback

            var exact_double_fallback_pos = bytes_len(ctx["code"])
            var exact_double_fallback_off = (exact_double_fallback_pos - exact_double_terminal_guard_pos) / 4
            set_u32_le(ctx["code"], exact_double_terminal_guard_pos, insn_b_cond(exact_double_fallback_off, 10)) // GE

            // Terminal exact-double chunk falls back to the original mul/add sequence.
            if low32_loads {
                _arm64_emit_list_int_dot_slot_load(ctx, 25, 19, 0, true)
                _arm64_emit_list_int_dot_slot_load(ctx, 12, 19, 8, true)
                push_u32_le(ctx["code"], insn_add_imm(19, 19, 16))
                _arm64_emit_list_int_dot_slot_load(ctx, 13, 26, 0, true)
                _arm64_emit_list_int_dot_slot_load(ctx, 24, 26, 8, true)
                push_u32_le(ctx["code"], insn_add_imm(26, 26, 16))
            } else if pair_post {
                push_u32_le(ctx["code"], insn_ldp_pair_post(25, 12, 19, 16))
                push_u32_le(ctx["code"], insn_ldp_pair_post(13, 24, 26, 16))
            } else {
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
                push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 19, 8))
                push_u32_le(ctx["code"], insn_add_imm(19, 19, 16))
                push_u32_le(ctx["code"], insn_ldr_ptr(13, 26))
            }
            push_u32_le(ctx["code"], insn_mul(25, 25, 13))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            if pair_post || low32_loads {
                push_u32_le(ctx["code"], insn_mul(12, 12, 24))
            } else {
                push_u32_le(ctx["code"], insn_ldr_ptr_off(13, 26, 8))
                push_u32_le(ctx["code"], insn_add_imm(26, 26, 16))
                push_u32_le(ctx["code"], insn_mul(12, 12, 13))
            }
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 12))

            exact_double_after_pos = bytes_len(ctx["code"])
            var exact_double_after_off = (exact_double_after_pos - exact_double_after_jump) / 4
            set_u32_le(ctx["code"], exact_double_after_jump, insn_b(exact_double_after_off))
        }

        // i += 2
        push_u32_le(ctx["code"], insn_add_imm(20, 20, 2))

        var back_pos2 = bytes_len(ctx["code"])
        var back_off2 = (loop_cond_pos - back_pos2) / 4
        push_u32_le(ctx["code"], insn_b(back_off2))

        var fast_single_pos = bytes_len(ctx["code"])
        var single_off = (fast_single_pos - jpos_fast_single) / 4
        set_u32_le(ctx["code"], jpos_fast_single, insn_b_cond(single_off, 10)) // GE

        gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, safepoint_spill_pairs)
    }
    var mi = 0
    while mi < oren_list_len(muls) {
        var mul = muls[mi]
        var left_list = mul["left"]
        var right_list = mul["right"]
        var li_left = 0
        while li_left < list_count {
            if _arm64_str_eq_bytes(lists[li_left], left_list) { break }
            li_left = li_left + 1
        }
        var li_right = 0
        while li_right < list_count {
            if _arm64_str_eq_bytes(lists[li_right], right_list) { break }
            li_right = li_right + 1
        }
        var buf_left = list_base_off + li_left * 16 + 8
        var buf_right = list_base_off + li_right * 16 + 8

        if unique_lists {
            if single_mul_pair && single_pair_cursor_regs {
                if low32_loads {
                    _arm64_emit_list_int_dot_slot_load(ctx, 25, 19, 0, true)
                    push_u32_le(ctx["code"], insn_add_imm(19, 19, 8))
                    _arm64_emit_list_int_dot_slot_load(ctx, 27, 26, 0, true)
                    push_u32_le(ctx["code"], insn_add_imm(26, 26, 8))
                } else if scalar_post {
                    push_u32_le(ctx["code"], insn_ldr_ptr_post(25, 19, 8))
                    push_u32_le(ctx["code"], insn_ldr_ptr_post(27, 26, 8))
                } else {
                    push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
                    push_u32_le(ctx["code"], insn_add_imm(19, 19, 8))

                    push_u32_le(ctx["code"], insn_ldr_ptr(27, 26))
                    push_u32_le(ctx["code"], insn_add_imm(26, 26, 8))
                }
            } else {
                // left value (advance cursor)
                emit_ldr_reg_sp_any(ctx, 24, buf_left)
                push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
                push_u32_le(ctx["code"], insn_add_imm(24, 24, 8))
                emit_str_reg_sp_any(ctx, 24, buf_left)

                // right value (advance cursor)
                emit_ldr_reg_sp_any(ctx, 26, buf_right)
                push_u32_le(ctx["code"], insn_ldr_ptr(27, 26))
                push_u32_le(ctx["code"], insn_add_imm(26, 26, 8))
                emit_str_reg_sp_any(ctx, 26, buf_right)
            }

            // sum += left * right
            if single_mul_pair && single_pair_cursor_regs && ((madd_exact_scalar && !dual_accum) || (dual_accum && dual_madd)) {
                push_u32_le(ctx["code"], insn_madd(23, 25, 27, 23))
            } else {
                push_u32_le(ctx["code"], insn_mul(25, 25, 27))
                push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
            }
        } else {
            // left value
            emit_ldr_reg_sp_any(ctx, 21, buf_left)
            push_u32_le(ctx["code"], insn_add_reg(25, 21, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 25))

            // right value
            emit_ldr_reg_sp_any(ctx, 26, buf_right)
            push_u32_le(ctx["code"], insn_add_reg(27, 26, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(27, 27))

            // sum += left * right
            push_u32_le(ctx["code"], insn_mul(25, 25, 27))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        }

        mi = mi + 1
    }

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    listm._arm64_trace_loop_range(ctx, trace_kind, loop_cond_pos, fast_end_pos)
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update idx/sum locals after loop exit.
    if single_mul_pair && single_pair_cursor_regs && dual_accum {
        push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
    }
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))
    if jpos_helper_done != nil {
        set_u32_le(ctx["code"], jpos_helper_done, insn_b((end_pos - jpos_helper_done) / 4))
    }

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_dot_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var muls = info["muls"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = _arm64_local_fp_off(ctx, n_name)
    var sum_fp_off = _arm64_local_fp_off(ctx, sum_name)
    if idx_fp_off == nil || n_fp_off == nil || sum_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var mul_count = oren_list_len(muls)
    var unique_lists = false
    if list_count == mul_count * 2 { unique_lists = true }
    // Boxed dot loops follow the same contract as list<int> dot loops: register tick on the
    // hot path, no dedicated stack tick slot by default, optional env escape hatch to restore
    // the old layout while comparing traces.
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_DOT_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_DOT_TICK_MASK", 4095)
    var slots = 4 + list_count * 2 // tick + i + n + sum + (list, buf)*N
    if !keep_tick_slot { slots = 3 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_dot_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_dot_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var sum_off = slot0 + 16
    var list_base_off = slot0 + 24
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    // inline safepoint mask (restored after runtime calls)
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n/sum locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
    emit_str_reg_sp_any(ctx, 0, n_off)
    emit_ldr_reg_fp_any(ctx, 0, sum_fp_off)
    emit_str_reg_sp_any(ctx, 0, sum_off)

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = native_alloc_index_get(list)
        _arm64_emit_find_tracked_node(ctx, 0, 0)

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST == 2)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 2)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // count < n => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_small = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_small, "cond": 11}) // LT

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    if unique_lists {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        var li_init = 0
        while li_init < list_count {
            var buf_slot_init = list_base_off + li_init * 16 + 8
            emit_ldr_reg_sp_any(ctx, 23, buf_slot_init)
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
            emit_str_reg_sp_any(ctx, 23, buf_slot_init)
            li_init = li_init + 1
        }
    }

    // Keep i/sum in registers across iterations.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 23, sum_off)
    emit_load_i64_imm(ctx, 22, 8)

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    emit_ldr_reg_sp_any(ctx, 21, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    gc.native_emit_gc_safepoint_inline_tick(ctx, tick_mask)

    var mi = 0
    while mi < oren_list_len(muls) {
        var mul = muls[mi]
        var left_list = mul["left"]
        var right_list = mul["right"]
        var li_left = 0
        while li_left < list_count {
            if _arm64_str_eq_bytes(lists[li_left], left_list) { break }
            li_left = li_left + 1
        }
        var li_right = 0
        while li_right < list_count {
            if _arm64_str_eq_bytes(lists[li_right], right_list) { break }
            li_right = li_right + 1
        }
        var buf_left = list_base_off + li_left * 16 + 8
        var buf_right = list_base_off + li_right * 16 + 8

        if unique_lists {
            // left value (advance cursor)
            emit_ldr_reg_sp_any(ctx, 24, buf_left)
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))
            push_u32_le(ctx["code"], insn_add_reg(24, 24, 22))
            emit_str_reg_sp_any(ctx, 24, buf_left)

            // right value (advance cursor)
            emit_ldr_reg_sp_any(ctx, 26, buf_right)
            push_u32_le(ctx["code"], insn_ldr_ptr(27, 26))
            push_u32_le(ctx["code"], insn_add_reg(26, 26, 22))
            emit_str_reg_sp_any(ctx, 26, buf_right)

            // sum += left * right
            push_u32_le(ctx["code"], insn_mul(25, 25, 27))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        } else {
            // left value
            emit_ldr_reg_sp_any(ctx, 21, buf_left)
            push_u32_le(ctx["code"], insn_mul(24, 20, 22))
            push_u32_le(ctx["code"], insn_add_reg(24, 21, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(25, 24))

            // right value
            emit_ldr_reg_sp_any(ctx, 26, buf_right)
            push_u32_le(ctx["code"], insn_mul(24, 20, 22))
            push_u32_le(ctx["code"], insn_add_reg(24, 26, 24))
            push_u32_le(ctx["code"], insn_ldr_ptr(24, 24))

            // sum += left * right
            push_u32_le(ctx["code"], insn_mul(25, 25, 24))
            push_u32_le(ctx["code"], insn_add_reg(23, 23, 25))
        }

        mi = mi + 1
    }

    // i++
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update idx/sum locals after loop exit.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    emit_str_reg_fp_any(ctx, 23, sum_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_int_push_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var trace_reserve = oren_env("OREN_TRACE_NATIVE_LIST_RESERVE") != nil

    var idx_name = info["idx"]
    var n_name = info["n"]
    var n_const = info["n_const"]
    var lists = info["lists"]
    var pushes = info["pushes"]
    var single_list_cursor_safe = info["single_list_cursor_safe"] == true
    var all_push_values_idx_int_expr_safe = info["all_push_values_idx_int_expr_safe"] == true
    var all_push_values_nonneg_linear_safe = info["all_push_values_nonneg_linear_safe"] == true
    var nonneg_linear_safe_n_limit = info["nonneg_linear_safe_n_limit"]
    var fresh_exact_lists = info["fresh_exact_lists"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = nil
    if n_name != nil { n_fp_off = _arm64_local_fp_off(ctx, n_name) }
    if idx_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }
    if n_name != nil && n_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }
    if n_name == nil && n_const == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_INT_PUSH_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_INT_PUSH_TICK_MASK", 4095)
    var slots = 3 + list_count * 2 // tick + i + n + (list, buf)*N
    if !keep_tick_slot { slots = 2 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_int_push_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_int_push_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var list_base_off = slot0 + 16
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    var single_list_cursor = false
    if list_count == 1 &&
        oren_list_len(pushes) == 1 &&
        single_list_cursor_safe == true &&
        _arm64_env_enabled_default_true("OREN_ARM64_FAST_LIST_INT_PUSH_SINGLE_LIST_CURSOR") == true {
        single_list_cursor = true
    }
    var idx_int_expr_fast = false
    if all_push_values_idx_int_expr_safe == true &&
        _arm64_env_enabled_default_true("OREN_ARM64_FAST_LIST_INT_PUSH_IDX_EXPR") == true {
        idx_int_expr_fast = true
    }
    var idx_nonneg_linear_fast = false
    if all_push_values_nonneg_linear_safe == true &&
        nonneg_linear_safe_n_limit != nil &&
        _arm64_env_enabled_default_true("OREN_ARM64_FAST_LIST_INT_PUSH_NONNEG_LINEAR") == true {
        // This path only handles nonnegative affine/mod shapes with a proven loop-bound ceiling, so
        // the direct mul/add/(u)div sequence stays semantically aligned with the generic int path.
        idx_nonneg_linear_fast = true
    }
    var fresh_exact_init_fast = false
    if fresh_exact_lists != nil &&
        _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_PUSH_FRESH_EXACT_INIT") == true {
        fresh_exact_init_fast = true
    }
    var fresh_exact_single_list_fast = false
    if fresh_exact_lists != nil &&
        list_count == 1 &&
        oren_list_len(pushes) == 1 &&
        single_list_cursor_safe == true &&
        fresh_exact_lists[lists[0]] == true &&
        _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_PUSH_FRESH_EXACT_SINGLE_LIST") == true {
        // Narrow experimental shortcut: isolate the single-list explicit fill shape from the broader
        // fresh-exact proof so it can be ranked independently on the exact whole-operation surface.
        fresh_exact_single_list_fast = true
    }
    var idx_int_expr_cursor_regs = false
    if single_list_cursor == true &&
        (idx_nonneg_linear_fast == true || idx_int_expr_fast == true) &&
        _arm64_env_enabled_default_false("OREN_ARM64_FAST_LIST_INT_PUSH_IDX_EXPR_CURSOR_REGS") == true {
        idx_int_expr_cursor_regs = true
    }

    // init tick=0
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    if n_fp_off != nil {
        emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
        emit_str_reg_sp_any(ctx, 0, n_off)
    } else {
        emit_load_i64_imm(ctx, 0, n_const)
        emit_str_reg_sp_any(ctx, 0, n_off)
    }

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT
    if idx_nonneg_linear_fast == true {
        emit_load_i64_imm(ctx, 1, nonneg_linear_safe_n_limit)
        push_u32_le(ctx["code"], insn_cmp_reg(0, 1))
        var jpos_n_too_big = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_n_too_big, "cond": 12}) // GT
    }

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8
        var list_fresh_exact = false
        if fresh_exact_single_list_fast == true {
            list_fresh_exact = true
        } else if fresh_exact_init_fast == true && fresh_exact_lists[list_name] == true {
            list_fresh_exact = true
        }

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)
        if list_fresh_exact == true {
            // Cross-statement proof: this list was freshly constructed as `list.int_new(n)` in the
            // same block, `i` is still known 0 at loop entry, and no intervening statement could
            // alias or mutate the list. Skip the reserve/count/header revalidation and use the
            // constructor-initialized buffer directly.
            emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
            emit_str_reg_sp_any(ctx, 1, buf_slot)
        } else {
            // list == 0 => slow
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            var jpos_list_nil = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

            // node = native_alloc_index_get(list)
            _arm64_emit_find_tracked_node(ctx, 0, 0)

            // node == 0 => slow
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            var jpos_node_nil = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

            // kind check (LIST_INT == 8)
            emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
            emit_load_i64_imm(ctx, 2, 8)
            push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
            var jpos_kind_bad = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

            // magic check
            emit_ldr_reg_sp_any(ctx, 0, list_slot)
            emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
            emit_load_i64_imm(ctx, 2, 1279870019)
            push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
            var jpos_magic_bad = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

            // capacity check: cap < n => reserve (grow list buffer)
            emit_load_ptr_from_base_plus(ctx, 1, 0, 8) // cap
            emit_ldr_reg_sp_any(ctx, 2, n_off)
            push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
            var jpos_cap_ok = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // patched: b.ge cap_ok
            // list_reserve(list, n)
            if trace_reserve {
                emit_ldr_reg_sp_any(ctx, 0, list_slot) // list
                emit_ldr_reg_sp_any(ctx, 1, n_off)     // new_cap
                emit_load_i64_imm(ctx, 2, 8)
                var bl_trace_reserve = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_trace_reserve, "name": "oren_trace_list_reserve_fast"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_trace_reserve)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_trace_list_reserve_fast")
            }
            emit_ldr_reg_sp_any(ctx, 0, list_slot) // list
            emit_ldr_reg_sp_any(ctx, 1, n_off)     // new_cap
            var bl_reserve = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_reserve, "name": "oren_list_int_reserve"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_reserve)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_list_int_reserve")
            emit_ldr_reg_sp_any(ctx, 0, list_slot) // restore list ptr after call

            var cap_ok_pos = bytes_len(ctx["code"])
            var cap_ok_off = (cap_ok_pos - jpos_cap_ok) / 4
            set_u32_le(ctx["code"], jpos_cap_ok, insn_b_cond(cap_ok_off, 10)) // GE

            // count check: count != i => slow
            emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
            emit_ldr_reg_sp_any(ctx, 2, i_off)
            push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
            var jpos_count_bad = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(slow_jumps, {"pos": jpos_count_bad, "cond": 1}) // NE

            // buf pointer
            emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
            emit_str_reg_sp_any(ctx, 1, buf_slot)
        }

        li = li + 1
    }

    if single_list_cursor {
        // Keep the active list<int> cursor in the existing buf stack slot. We deliberately do not
        // keep it live in X19 across `native_compile_expr`: arm64 expression lowering freely uses
        // X19/X20 internally, so the safe win here is to stop rebuilding `buf + i*8` every trip.
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_load_i64_imm(ctx, 21, 8)
        push_u32_le(ctx["code"], insn_mul(22, 20, 21))
        emit_ldr_reg_sp_any(ctx, 19, list_base_off + 8)
        push_u32_le(ctx["code"], insn_add_reg(19, 19, 22))
        emit_str_reg_sp_any(ctx, 19, list_base_off + 8)
    }

    if idx_int_expr_cursor_regs == true {
        // Narrow fill-side fast path: once the value expression is proven to be pure idx arithmetic,
        // keep the cursor and loop bounds live in preserved regs instead of round-tripping them
        // through stack slots every iteration.
        emit_ldr_reg_sp_any(ctx, 19, list_base_off + 8)
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    if idx_int_expr_cursor_regs != true {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_ldr_reg_sp_any(ctx, 21, n_off)
    }
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    if idx_int_expr_cursor_regs == true {
        gc.native_emit_gc_safepoint_inline_tick_pairs(ctx, tick_mask, [[19, 20], [21, 22]])
    } else {
        gc.native_emit_gc_safepoint_inline_tick(ctx, tick_mask)
    }

    // Keep idx local updated for generic value expressions. The idx-only int fast path uses X20
    // directly and avoids the extra frame spill/reload churn in fill-heavy loops.
    if idx_int_expr_fast != true {
        emit_str_reg_fp_any(ctx, 20, idx_fp_off)
    }

    if single_list_cursor {
        var push = pushes[0]
        var value_expr = push["value"]
        var buf_slot2 = list_base_off + 8

        // value -> X0
        if idx_nonneg_linear_fast == true {
            _arm64_emit_fast_loop_nonneg_linear_to_x0(ctx, push["linear"], 20)
        } else if idx_int_expr_fast == true {
            _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, value_expr, idx_name, 20)
        } else {
            native_compile_expr(ctx, value_expr)
            _arm64_restore_stack_to(ctx, loop_base_stack)
        }

        if idx_int_expr_cursor_regs == true {
            push_u32_le(ctx["code"], insn_str_ptr(0, 19))
            push_u32_le(ctx["code"], insn_add_imm(19, 19, 8))
        } else {
            emit_ldr_reg_sp_any(ctx, 19, buf_slot2)
            push_u32_le(ctx["code"], insn_str_ptr(0, 19))
            push_u32_le(ctx["code"], insn_add_imm(19, 19, 8))
            emit_str_reg_sp_any(ctx, 19, buf_slot2)
            emit_ldr_reg_sp_any(ctx, 20, i_off)
        }
        push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))
        if idx_int_expr_cursor_regs != true {
            emit_str_reg_sp_any(ctx, 20, i_off)
        }
    } else {
        var pi = 0
        while pi < oren_list_len(pushes) {
            var push = pushes[pi]
            var list_name2 = push["list"]
            var value_expr = push["value"]
            var list_index = 0
            while list_index < list_count {
                if _arm64_str_eq_bytes(lists[list_index], list_name2) { break }
                list_index = list_index + 1
            }
            var list_slot2 = list_base_off + list_index * 16
            var buf_slot2 = list_slot2 + 8

            // value -> X0
            if idx_nonneg_linear_fast == true {
                _arm64_emit_fast_loop_nonneg_linear_to_x0(ctx, push["linear"], 20)
            } else if idx_int_expr_fast == true {
                _arm64_emit_fast_loop_idx_int_expr_to_x0(ctx, value_expr, idx_name, 20)
            } else {
                native_compile_expr(ctx, value_expr)
                _arm64_restore_stack_to(ctx, loop_base_stack)
            }

            // addr = buf + i*8 ; store value
            emit_ldr_reg_sp_any(ctx, 20, i_off)
            emit_ldr_reg_sp_any(ctx, 21, buf_slot2)
            emit_load_i64_imm(ctx, 22, 8)
            push_u32_le(ctx["code"], insn_mul(23, 20, 22))
            push_u32_le(ctx["code"], insn_add_reg(23, 21, 23))
            push_u32_le(ctx["code"], insn_str_ptr(0, 23))

            pi = pi + 1
        }

        // i++
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))
        emit_str_reg_sp_any(ctx, 20, i_off)
    }

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update list counts after loop exit.
    if idx_int_expr_cursor_regs != true {
        emit_ldr_reg_sp_any(ctx, 20, i_off)
    }
    var li2 = 0
    while li2 < list_count {
        var list_slot3 = list_base_off + li2 * 16
        emit_ldr_reg_sp_any(ctx, 21, list_slot3)
        push_u32_le(ctx["code"], insn_str_ptr(20, 21))
        _arm64_emit_trace_list_header_if_enabled(ctx, 21)
        li2 = li2 + 1
    }

    // Update idx local after loop exit.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}

fn _arm64_emit_fast_list_push_while(ctx, stmt, info) {
    if ctx == nil || stmt == nil || info == nil { return nil }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var n_const = info["n_const"]
    var lists = info["lists"]
    var pushes = info["pushes"]
    var idx_fp_off = _arm64_local_fp_off(ctx, idx_name)
    var n_fp_off = nil
    if n_name != nil { n_fp_off = _arm64_local_fp_off(ctx, n_name) }
    if idx_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }
    if n_name != nil && n_fp_off == nil { return _arm64_emit_while_generic(ctx, stmt) }
    if n_name == nil && n_const == nil { return _arm64_emit_while_generic(ctx, stmt) }

    var base_stack = ctx["stack_size"]
    var list_count = oren_list_len(lists)
    var keep_tick_slot = false
    if oren_env("OREN_ARM64_FAST_LIST_PUSH_KEEP_TICK_SLOT") != nil { keep_tick_slot = true }
    var tick_mask = gc.native_arm64_fast_loop_tick_mask("OREN_ARM64_FAST_LIST_PUSH_TICK_MASK", 255)
    var slots = 3 + list_count * 2 // tick + i + n + (list, buf)*N
    if !keep_tick_slot { slots = 2 + list_count * 2 }
    var total_bytes = align_up(slots * 8, 16)
    emit_sub_sp_any(ctx, total_bytes)
    ctx["stack_size"] = ctx["stack_size"] + total_bytes

    var loop_base_stack = ctx["stack_size"]
    var tick_off = 0
    var slot0 = 8
    var trace_kind = "fast_list_push_while"
    if !keep_tick_slot {
        tick_off = -1
        slot0 = 0
        trace_kind = "fast_list_push_while_no_tick"
    }
    var i_off = slot0
    var n_off = slot0 + 8
    var list_base_off = slot0 + 16
    listm._arm64_trace_loop_stack(ctx, trace_kind, loop_base_stack, slots, tick_off, total_bytes)

    // init tick=0
    push_u32_le(ctx["code"], insn_movz(9, 0))
    if keep_tick_slot { emit_str_reg_sp_any(ctx, 9, tick_off) }
    // inline safepoint mask (restored after runtime calls)
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))

    // load i/n locals into slots
    emit_ldr_reg_fp_any(ctx, 0, idx_fp_off)
    emit_str_reg_sp_any(ctx, 0, i_off)
    if n_fp_off != nil {
        emit_ldr_reg_fp_any(ctx, 0, n_fp_off)
        emit_str_reg_sp_any(ctx, 0, n_off)
    } else {
        emit_load_i64_imm(ctx, 0, n_const)
        emit_str_reg_sp_any(ctx, 0, n_off)
    }

    var slow_jumps = []

    // i < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, i_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_i_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_i_neg, "cond": 11}) // LT

    // n < 0 => slow
    emit_ldr_reg_sp_any(ctx, 0, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    var jpos_n_neg = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(slow_jumps, {"pos": jpos_n_neg, "cond": 11}) // LT

    // validate lists + capture buf pointers
    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var list_fp_off = _arm64_local_fp_off(ctx, list_name)
        var list_slot = list_base_off + li * 16
        var buf_slot = list_slot + 8

        // list pointer -> slot
        emit_ldr_reg_fp_any(ctx, 0, list_fp_off)
        emit_str_reg_sp_any(ctx, 0, list_slot)

        // list == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_list_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_list_nil, "cond": 0}) // EQ

        // node = native_alloc_index_get(list)
        _arm64_emit_find_tracked_node(ctx, 0, 0)

        // node == 0 => slow
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jpos_node_nil = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_node_nil, "cond": 0}) // EQ

        // kind check (LIST == 2)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_load_i64_imm(ctx, 2, 2)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_kind_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_kind_bad, "cond": 1}) // NE

        // magic check
        emit_ldr_reg_sp_any(ctx, 0, list_slot)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 24)
        emit_load_i64_imm(ctx, 2, 1279870019)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_magic_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_magic_bad, "cond": 1}) // NE

        // capacity check: cap < n => reserve (grow list buffer)
        emit_load_ptr_from_base_plus(ctx, 1, 0, 8) // cap
        emit_ldr_reg_sp_any(ctx, 2, n_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_cap_ok = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // patched: b.ge cap_ok
        // list_reserve(list, n)
        emit_ldr_reg_sp_any(ctx, 0, list_slot) // list
        emit_ldr_reg_sp_any(ctx, 1, n_off)     // new_cap
        var bl_reserve = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_reserve, "name": "oren_list_reserve"})
        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_reserve)
        oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_list_reserve")
        emit_ldr_reg_sp_any(ctx, 0, list_slot) // restore list ptr after call

        var cap_ok_pos = bytes_len(ctx["code"])
        var cap_ok_off = (cap_ok_pos - jpos_cap_ok) / 4
        set_u32_le(ctx["code"], jpos_cap_ok, insn_b_cond(cap_ok_off, 10)) // GE

        // count check: count != i => slow
        emit_load_ptr_from_base_plus(ctx, 1, 0, 0) // count
        emit_ldr_reg_sp_any(ctx, 2, i_off)
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var jpos_count_bad = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(slow_jumps, {"pos": jpos_count_bad, "cond": 1}) // NE

        // buf pointer
        emit_load_ptr_from_base_plus(ctx, 1, 0, 16)
        emit_str_reg_sp_any(ctx, 1, buf_slot)

        li = li + 1
    }

    // Fast loop entry
    var loop_cond_pos = bytes_len(ctx["code"])
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_ldr_reg_sp_any(ctx, 21, n_off)
    push_u32_le(ctx["code"], insn_cmp_reg(20, 21))
    var jpos_fast_end = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b.ge end

    gc.native_emit_gc_safepoint_inline_tick(ctx, tick_mask)

    // Keep idx local updated for value expressions.
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)

    var pi = 0
    while pi < oren_list_len(pushes) {
        var push = pushes[pi]
        var list_name2 = push["list"]
        var value_expr = push["value"]
        var list_index = 0
        while list_index < list_count {
            if _arm64_str_eq_bytes(lists[list_index], list_name2) { break }
            list_index = list_index + 1
        }
        var list_slot2 = list_base_off + list_index * 16
        var buf_slot2 = list_slot2 + 8

        // value -> X0
        native_compile_expr(ctx, value_expr)
        _arm64_restore_stack_to(ctx, loop_base_stack)

        // addr = buf + i*8 ; store value
        emit_ldr_reg_sp_any(ctx, 20, i_off)
        emit_ldr_reg_sp_any(ctx, 21, buf_slot2)
        emit_load_i64_imm(ctx, 22, 8)
        push_u32_le(ctx["code"], insn_mul(23, 20, 22))
        push_u32_le(ctx["code"], insn_add_reg(23, 21, 23))
        push_u32_le(ctx["code"], insn_str_ptr(0, 23))

        pi = pi + 1
    }

    // i++
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    push_u32_le(ctx["code"], insn_add_imm(20, 20, 1))
    emit_str_reg_sp_any(ctx, 20, i_off)

    var back_pos = bytes_len(ctx["code"])
    var back_off = (loop_cond_pos - back_pos) / 4
    push_u32_le(ctx["code"], insn_b(back_off))

    var fast_end_pos = bytes_len(ctx["code"])
    var end_off = (fast_end_pos - jpos_fast_end) / 4
    set_u32_le(ctx["code"], jpos_fast_end, insn_b_cond(end_off, 10)) // GE

    // Update list counts after loop exit.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    var li2 = 0
    while li2 < list_count {
        var list_slot3 = list_base_off + li2 * 16
        emit_ldr_reg_sp_any(ctx, 21, list_slot3)
        push_u32_le(ctx["code"], insn_str_ptr(20, 21))
        if ctx["trace_native_list_hdr"] != nil {
            push_u32_le(ctx["code"], insn_mov_reg(0, 21)) // list
            emit_load_i64_imm(ctx, 1, 4) // list_push
            emit_load_i64_imm(ctx, 2, 2) // LIST
            var bl_trace = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_trace, "name": "oren_trace_list_header"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_trace)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_trace_list_header")
        }
        li2 = li2 + 1
    }

    // Update idx local after loop exit.
    emit_ldr_reg_sp_any(ctx, 20, i_off)
    emit_str_reg_fp_any(ctx, 20, idx_fp_off)

    var jpos_skip_slow = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0) // patched: b end

    // Slow path: patch all failure branches here and emit generic loop.
    var slow_pos = bytes_len(ctx["code"])
    var si = 0
    while si < oren_list_len(slow_jumps) {
        var sj = slow_jumps[si]
        var soff = (slow_pos - sj["pos"]) / 4
        set_u32_le(ctx["code"], sj["pos"], insn_b_cond(soff, sj["cond"]))
        si = si + 1
    }
    _arm64_emit_while_generic(ctx, stmt)

    var end_pos = bytes_len(ctx["code"])
    var skip_off = (end_pos - jpos_skip_slow) / 4
    set_u32_le(ctx["code"], jpos_skip_slow, insn_b(skip_off))

    _arm64_restore_stack_to(ctx, base_stack)
    return nil
}
