import prefixm "arm64_native_stmt_loops_list_emit_prefix_reduce.oren"
import intdotm "arm64_native_stmt_loops_list_emit_int_reduce_dot.oren"
import tailm "arm64_native_stmt_loops_list_emit_dot_push.oren"

// Thin facade over split list-loop emitter families.

fn _arm64_emit_fast_list_get_sum_while(ctx, stmt, info) { return prefixm._arm64_emit_fast_list_get_sum_while(ctx, stmt, info) }
fn _arm64_emit_fast_list_int_get_sum_while(ctx, stmt, info) { return intdotm._arm64_emit_fast_list_int_get_sum_while(ctx, stmt, info) }
fn _arm64_emit_fast_list_int_dot_while(ctx, stmt, info) { return intdotm._arm64_emit_fast_list_int_dot_while(ctx, stmt, info) }
fn _arm64_emit_fast_list_dot_while(ctx, stmt, info) { return tailm._arm64_emit_fast_list_dot_while(ctx, stmt, info) }
fn _arm64_emit_fast_list_int_push_while(ctx, stmt, info) { return tailm._arm64_emit_fast_list_int_push_while(ctx, stmt, info) }
fn _arm64_emit_fast_list_push_while(ctx, stmt, info) { return tailm._arm64_emit_fast_list_push_while(ctx, stmt, info) }
