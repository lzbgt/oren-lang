// ELF emitter for x86_64 (Linux).
//
// v0: minimal ET_EXEC with two PT_LOAD segments:
// - RX: headers + code (+ padding)
// - RW: data blob

import codegen "codegen_x64.oren"
import abi "native_abi.oren"

fn bytes_new() { return codegen.bytes_new() }
fn bytes_push(b, v) { return codegen.bytes_push(b, v) }
fn bytes_extend(b, other) { return codegen.bytes_extend(b, other) }

fn push_u16_le(buf, n) {
    bytes_push(buf, codegen.int_mod(n, 256))
    bytes_push(buf, codegen.int_mod(n / 256, 256))
}
fn push_u32_le(buf, n) { return codegen.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return codegen.push_u64_le(buf, n) }
fn set_u32_le(buf, offset, n) { return codegen.set_u32_le(buf, offset, n) }
fn int_mod(a, b) { return codegen.int_mod(a, b) }

fn set_u64_le(buf, offset, n) {
    // Patch u64 into a byte buffer (little-endian) using two u32 writes.
    set_u32_le(buf, offset, int_mod(n, 4294967296))
    set_u32_le(buf, offset + 4, int_mod(n / 4294967296, 4294967296))
}

fn align_up(n, align) {
    return (n + align - 1) / align * align
}

fn elf_build_prefix_x64(code, code_pad_len, data, entry_off) {
    var p = bytes_new()

    // ELF Header (64 bytes)
    bytes_push(p, 127); bytes_push(p, 69); bytes_push(p, 76); bytes_push(p, 70); // 0x7F 'E' 'L' 'F'
    bytes_push(p, 2) // 64-bit
    bytes_push(p, 1) // little endian
    bytes_push(p, 1) // version
    bytes_push(p, 0) // System V
    push_u64_le(p, 0) // padding (EI_PAD) + rest

    push_u16_le(p, 2)   // ET_EXEC
    push_u16_le(p, 62)  // EM_X86_64
    push_u32_le(p, 1)   // EV_CURRENT

    var base = abi.x64_v0_linux_elf_base_addr()
    var hdr_size = abi.x64_v0_linux_elf_hdr_size_bytes()
    push_u64_le(p, base + hdr_size + entry_off) // e_entry
    push_u64_le(p, 64)  // e_phoff
    push_u64_le(p, 0)   // e_shoff
    push_u32_le(p, 0)   // e_flags
    push_u16_le(p, 64)  // e_ehsize
    push_u16_le(p, 56)  // e_phentsize
    push_u16_le(p, 2)   // e_phnum
    push_u16_le(p, 64)  // e_shentsize
    push_u16_le(p, 0)   // e_shnum
    push_u16_le(p, 0)   // e_shstrndx

    var page = 4096
    var text_filesz = hdr_size + oren_list_len(code) + code_pad_len
    // Caller is expected to align the start of data to a page boundary by choosing code_pad_len.
    if int_mod(text_filesz, page) != 0 {
        // Fallback: round up so segment offsets stay valid even if caller forgot.
        text_filesz = align_up(text_filesz, page)
    }
    var data_off = text_filesz

    // Program Header #1: RX (headers + code + padding)
    push_u32_le(p, 1) // PT_LOAD
    push_u32_le(p, 5) // PF_R | PF_X
    push_u64_le(p, 0)       // p_offset
    push_u64_le(p, base)    // p_vaddr
    push_u64_le(p, base)    // p_paddr
    push_u64_le(p, text_filesz) // p_filesz
    push_u64_le(p, text_filesz) // p_memsz
    push_u64_le(p, 4096)    // p_align

    // Program Header #2: RW (data blob)
    push_u32_le(p, 1) // PT_LOAD
    push_u32_le(p, 6) // PF_R | PF_W
    push_u64_le(p, data_off)        // p_offset
    push_u64_le(p, base + data_off) // p_vaddr
    push_u64_le(p, base + data_off) // p_paddr
    push_u64_le(p, oren_list_len(data)) // p_filesz
    push_u64_le(p, oren_list_len(data)) // p_memsz
    push_u64_le(p, 4096)    // p_align

    return p
}

fn elf_emit_program_x64(out_path, linked, debug_mode, no_gc, call_depth_max, capsule, cap_allow_domains) {
    var ctx = codegen.native_compile_program_x64(linked, {"os": "linux", "debug": debug_mode, "no_gc": no_gc, "call_depth_max": call_depth_max, "capsule": capsule, "cap_allow_domains": cap_allow_domains})
    if ctx == nil { return nil }
    codegen.native_emit_errors_and_exit(ctx)

    var code = ctx["code"]
    var data = ctx["data"]
    var fixups = ctx["fixups"]
    var functions = ctx["functions"]

    // Apply fixups.
    //
    // Layout:
    //   [ELF hdrs] [code] [pad-to-page] [data]
    //
    // All fixup positions are relative to the start of code.
    var base = abi.x64_v0_linux_elf_base_addr()
    var hdr_size = abi.x64_v0_linux_elf_hdr_size_bytes()
    var text_base = base + hdr_size
    var code_len = oren_list_len(code)

    // Ensure the data segment begins on a page boundary (required for PT_LOAD alignment).
    var code_pad = bytes_new()
    var page = 4096
    var text_end_off = hdr_size + code_len
    var data_file_off = align_up(text_end_off, page)
    var pad_len = data_file_off - text_end_off
    var pi = 0
    while pi < pad_len { bytes_push(code_pad, 0); pi = pi + 1 }
    var data_base_off = code_len + oren_list_len(code_pad)

    var i = 0
    while i < oren_list_len(fixups) {
        var f = fixups[i]
        if f["type"] == "call_rel32" {
            var name = f["name"]
            var target = functions[name]
            if target == nil {
                print("x64 elf: undefined function " + name)
                oren_exit(1)
            }
            var pos = f["pos"]
            // rel32 is relative to next instruction (pos + 5)
            var disp = target - (pos + 5)
            if disp < 0 { disp = 4294967296 + disp } // v0: allow negative by wrapping (assumes within 32-bit)
            set_u32_le(code, pos + 1, disp)
        }
        else if f["type"] == "rip_data_lea_rsi" {
            // Patch lea rsi, [rip+disp32] where disp32 points into appended data.
            //
            // f["pos"] points to disp32 field within the instruction.
            var disp_pos = f["pos"]
            var data_off = f["data_off"]
            var insn_start = disp_pos - 3
            var next_rip = text_base + (insn_start + 7)
            var target_addr = text_base + data_base_off + data_off
            var disp2 = target_addr - next_rip
            if disp2 < 0 { disp2 = 4294967296 + disp2 }
            set_u32_le(code, disp_pos, disp2)
        }
        else if f["type"] == "rip_data_lea" {
            // Patch lea r64, [rip+disp32] where disp32 points into appended data.
            // (Same patch math as rip_data_lea_rsi; the disp field is the same.)
            var disp_pos2 = f["pos"]
            var data_off2 = f["data_off"]
            var insn_start2 = disp_pos2 - 3
            var next_rip2 = text_base + (insn_start2 + 7)
            var target_addr2 = text_base + data_base_off + data_off2
            var disp3 = target_addr2 - next_rip2
            if disp3 < 0 { disp3 = 4294967296 + disp3 }
            set_u32_le(code, disp_pos2, disp3)
        }
        else if f["type"] == "data_fnobj_code_ptr" {
            // Patch the code_ptr field inside a `{code_ptr, env_ptr}` fnobj record.
            //
            // NOTE: We store the absolute virtual address. This is safe for this v0 ELF emitter
            // because we emit a fixed-base ET_EXEC without relocations (base=0x400000).
            var name2 = f["name"]
            var target_off2 = functions[name2]
            if target_off2 == nil {
                print("x64 elf: undefined function " + name2)
                oren_exit(1)
            }
            var data_off3 = f["data_off"]
            var addr = text_base + target_off2
            // Patch within the data segment payload (not including the file padding).
            set_u64_le(data, data_off3, addr)
        }
        else if f["type"] == "rip_code_lea" {
            // Patch lea r64, [rip+disp32] where disp32 points to a function entry in .text.
            //
            // f["pos"] points to disp32 field within the instruction.
            var disp_pos3 = f["pos"]
            var name2 = f["name"]
            var target_off2 = functions[name2]
            if target_off2 == nil {
                print("x64 elf: undefined function " + name2)
                oren_exit(1)
            }
            var insn_start3 = disp_pos3 - 3
            var next_rip3 = text_base + (insn_start3 + 7)
            var target_addr3 = text_base + target_off2
            var disp3 = target_addr3 - next_rip3
            if disp3 < 0 { disp3 = 4294967296 + disp3 }
            set_u32_le(code, disp_pos3, disp3)
        }
        else {
            print("x64 elf: unknown fixup type " + f["type"])
            oren_exit(1)
        }
        i = i + 1
    }

    var prefix = elf_build_prefix_x64(code, oren_list_len(code_pad), data, ctx["entry_off"])
    bytes_extend(prefix, code)
    bytes_extend(prefix, code_pad)
    bytes_extend(prefix, data)
    var w = oren_write_bytes(out_path, prefix)
    if oren_is_err(w) {
        print("x64 elf: failed to write: " + out_path)
        var code = oren_err_code(w)
        var msg = oren_err_msg(w)
        print("x64 elf: write error code=" + oren_int_to_string(code))
        if msg != nil { print("x64 elf: write error msg=" + msg) }
        oren_exit(1)
    }
    oren_chmod(out_path, 493) // 0755
    return nil
}
