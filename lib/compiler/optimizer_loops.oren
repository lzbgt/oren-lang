import listm "optimizer_loops_list.oren"
import arena "optimizer_loops_arena.oren"

fn set_backend(name) { return listm.set_backend(name) }

fn sink_list_lit_into_if(block) {
    return listm.sink_list_lit_into_if(block)
}

fn wrap_arena_loops_in_block(block) {
    return arena.wrap_arena_loops_in_block(block)
}

fn lower_simple_for_in_block(block) {
    return arena.lower_simple_for_in_block(block)
}
