fn _opt_expr_has_ident(expr, name) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Identifier" { return expr["value"] == name }
    if t == "Call" {
        if _opt_expr_has_ident(expr["fn"], name) { return true }
        var args = expr["args"]
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                if _opt_expr_has_ident(args[i], name) { return true }
                i = i + 1
            }
        }
        if expr["spread"] != nil && _opt_expr_has_ident(expr["spread"], name) { return true }
        return false
    }
    if t == "Infix" || t == "Assign" {
        if _opt_expr_has_ident(expr["left"], name) { return true }
        return _opt_expr_has_ident(expr["right"], name)
    }
    if t == "Prefix" { return _opt_expr_has_ident(expr["right"], name) }
    if t == "Array" {
        var els = expr["elements"]
        if els != nil {
            var i2 = 0
            while i2 < oren_list_len(els) {
                if _opt_expr_has_ident(els[i2], name) { return true }
                i2 = i2 + 1
            }
        }
        return false
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        if ps != nil {
            var i3 = 0
            while i3 < oren_list_len(ps) {
                var p = ps[i3]
                if p != nil {
                    if _opt_expr_has_ident(p["key"], name) { return true }
                    if _opt_expr_has_ident(p["value"], name) { return true }
                }
                i3 = i3 + 1
            }
        }
        return false
    }
    if t == "Index" {
        if _opt_expr_has_ident(expr["left"], name) { return true }
        return _opt_expr_has_ident(expr["index"], name)
    }
    if t == "Member" { return _opt_expr_has_ident(expr["left"], name) }
    if t == "If" {
        if _opt_expr_has_ident(expr["cond"], name) { return true }
        if _opt_stmt_has_ident(expr["consq"], name) { return true }
        if expr["alt"] != nil && _opt_stmt_has_ident(expr["alt"], name) { return true }
        return false
    }
    if t == "Switch" {
        var cases = expr["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_has_ident(c["body"], name) { return true }
                ci = ci + 1
            }
        }
        if expr["default"] != nil && _opt_stmt_has_ident(expr["default"], name) { return true }
        return false
    }
    if t == "Function" { return _opt_stmt_has_ident(expr["body"], name) }
    return false
}

fn _opt_stmt_has_ident(stmt, name) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                if _opt_stmt_has_ident(ss[i], name) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "Var" { return _opt_expr_has_ident(stmt["value"], name) }
    if t == "Assign" { return _opt_expr_has_ident(stmt["value"], name) }
    if t == "Set" {
        if _opt_expr_has_ident(stmt["left"], name) { return true }
        return _opt_expr_has_ident(stmt["value"], name)
    }
    if t == "Return" { return _opt_expr_has_ident(stmt["value"], name) }
    if t == "ExprStmt" { return _opt_expr_has_ident(stmt["expr"], name) }
    if t == "While" {
        if _opt_expr_has_ident(stmt["cond"], name) { return true }
        return _opt_stmt_has_ident(stmt["body"], name)
    }
    if t == "For" {
        if _opt_stmt_has_ident(stmt["init"], name) { return true }
        if _opt_expr_has_ident(stmt["cond"], name) { return true }
        if _opt_expr_has_ident(stmt["post"], name) { return true }
        return _opt_stmt_has_ident(stmt["body"], name)
    }
    if t == "If" {
        if _opt_expr_has_ident(stmt["cond"], name) { return true }
        if _opt_stmt_has_ident(stmt["consq"], name) { return true }
        if stmt["alt"] != nil && _opt_stmt_has_ident(stmt["alt"], name) { return true }
        return false
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_has_ident(c["body"], name) { return true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_stmt_has_ident(stmt["default"], name) { return true }
        return false
    }
    if t == "Function" { return _opt_stmt_has_ident(stmt["body"], name) }
    return false
}

fn _opt_is_safe_list_call_name(name) {
    if name == nil { return false }
    if name == "oren_list_len" || name == "STD_list_len" { return true }
    if name == "oren_list_reserve" || name == "STD_list_reserve" { return true }
    if name == "oren_list_push" || name == "STD_list_push" { return true }
    if name == "oren_list_push_unchecked" || name == "STD_list_push_unchecked" { return true }
    if name == "oren_list_get" || name == "STD_list_get" { return true }
    if name == "oren_list_set" || name == "STD_list_set" { return true }
    if name == "oren_list_int_len" || name == "STD_list_int_len" { return true }
    if name == "oren_list_int_reserve" || name == "STD_list_int_reserve" { return true }
    if name == "oren_list_int_push" || name == "STD_list_int_push" { return true }
    if name == "oren_list_int_get" || name == "STD_list_int_get" { return true }
    if name == "oren_list_int_set" || name == "STD_list_int_set" { return true }
    return false
}

fn _opt_expr_has_unsafe_list_use(expr, name) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Identifier" { return expr["value"] == name }
    if t == "Call" {
        var fn_expr = expr["fn"]
        var fn_name = nil
        if fn_expr != nil && fn_expr["type"] == "Identifier" { fn_name = fn_expr["value"] }
        var args = expr["args"]
        if fn_name != nil && _opt_is_safe_list_call_name(fn_name) {
            if args != nil {
                var i = 0
                while i < oren_list_len(args) {
                    var arg = args[i]
                    if i == 0 {
                        if _opt_expr_has_ident(arg, name) {
                            if arg == nil || arg["type"] != "Identifier" || arg["value"] != name { return true }
                        }
                    } else {
                        if _opt_expr_has_ident(arg, name) { return true }
                    }
                    i = i + 1
                }
            }
            if expr["spread"] != nil && _opt_expr_has_ident(expr["spread"], name) { return true }
            return false
        }
        if _opt_expr_has_ident(fn_expr, name) { return true }
        if args != nil {
            var i2 = 0
            while i2 < oren_list_len(args) {
                if _opt_expr_has_ident(args[i2], name) { return true }
                i2 = i2 + 1
            }
        }
        if expr["spread"] != nil && _opt_expr_has_ident(expr["spread"], name) { return true }
        return false
    }
    if t == "Index" {
        var left = expr["left"]
        var idx = expr["index"]
        if _opt_expr_has_ident(idx, name) { return true }
        if left != nil && left["type"] == "Identifier" && left["value"] == name { return false }
        return _opt_expr_has_ident(left, name)
    }
    if t == "Member" {
        var left2 = expr["left"]
        if left2 != nil && left2["type"] == "Identifier" && left2["value"] == name { return true }
        return _opt_expr_has_ident(left2, name)
    }
    if t == "Infix" || t == "Assign" {
        if _opt_expr_has_unsafe_list_use(expr["left"], name) { return true }
        return _opt_expr_has_unsafe_list_use(expr["right"], name)
    }
    if t == "Prefix" { return _opt_expr_has_unsafe_list_use(expr["right"], name) }
    if t == "Array" {
        var els = expr["elements"]
        if els != nil {
            var i3 = 0
            while i3 < oren_list_len(els) {
                if _opt_expr_has_unsafe_list_use(els[i3], name) { return true }
                i3 = i3 + 1
            }
        }
        return false
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        if ps != nil {
            var i4 = 0
            while i4 < oren_list_len(ps) {
                var p = ps[i4]
                if p != nil {
                    if _opt_expr_has_unsafe_list_use(p["key"], name) { return true }
                    if _opt_expr_has_unsafe_list_use(p["value"], name) { return true }
                }
                i4 = i4 + 1
            }
        }
        return false
    }
    if t == "If" {
        if _opt_expr_has_unsafe_list_use(expr["cond"], name) { return true }
        if _opt_stmt_has_unsafe_list_use(expr["consq"], name) { return true }
        if expr["alt"] != nil && _opt_stmt_has_unsafe_list_use(expr["alt"], name) { return true }
        return false
    }
    if t == "Switch" {
        var cases = expr["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_has_unsafe_list_use(c["body"], name) { return true }
                ci = ci + 1
            }
        }
        if expr["default"] != nil && _opt_stmt_has_unsafe_list_use(expr["default"], name) { return true }
        return false
    }
    if t == "Function" { return _opt_stmt_has_ident(expr["body"], name) }
    return false
}

fn _opt_stmt_has_unsafe_list_use(stmt, name) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                if _opt_stmt_has_unsafe_list_use(ss[i], name) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "Var" || t == "Assign" {
        var nm = opthelp.is_ident(stmt["name"])
        var v = stmt["value"]
        if nm != nil && nm == name {
            if _opt_expr_is_new_list_call(v) != nil || _opt_expr_is_empty_list_lit(v) == true {
                if _opt_expr_has_ident(v, name) { return true }
                return false
            }
            return true
        }
        return _opt_expr_has_unsafe_list_use(v, name)
    }
    if t == "Set" {
        var left = stmt["left"]
        if left != nil {
            if left["type"] == "Index" {
                var base = left["left"]
                var idx = left["index"]
                if _opt_expr_has_ident(idx, name) { return true }
                if base == nil || base["type"] != "Identifier" || base["value"] != name {
                    if _opt_expr_has_ident(base, name) { return true }
                }
            } else if _opt_expr_has_ident(left, name) {
                return true
            }
        }
        return _opt_expr_has_unsafe_list_use(stmt["value"], name)
    }
    if t == "Return" { return _opt_expr_has_unsafe_list_use(stmt["value"], name) }
    if t == "ExprStmt" { return _opt_expr_has_unsafe_list_use(stmt["expr"], name) }
    if t == "While" || t == "For" {
        if t == "For" {
            if _opt_stmt_has_unsafe_list_use(stmt["init"], name) { return true }
            if _opt_expr_has_unsafe_list_use(stmt["cond"], name) { return true }
            if _opt_expr_has_unsafe_list_use(stmt["post"], name) { return true }
        }
        if _opt_expr_has_unsafe_list_use(stmt["cond"], name) { return true }
        return _opt_stmt_has_unsafe_list_use(stmt["body"], name)
    }
    if t == "If" {
        if _opt_expr_has_unsafe_list_use(stmt["cond"], name) { return true }
        if _opt_stmt_has_unsafe_list_use(stmt["consq"], name) { return true }
        if stmt["alt"] != nil && _opt_stmt_has_unsafe_list_use(stmt["alt"], name) { return true }
        return false
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_has_unsafe_list_use(c["body"], name) { return true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_stmt_has_unsafe_list_use(stmt["default"], name) { return true }
        return false
    }
    if t == "Function" { return _opt_stmt_has_ident(stmt["body"], name) }
    return false
}

fn _opt_safe_var_kind(safe_vars, name) {
    if safe_vars == nil || name == nil { return nil }
    var i = 0
    while i < oren_list_len(safe_vars) {
        var e = safe_vars[i]
        if e != nil && e["name"] == name { return e["kind"] }
        i = i + 1
    }
    return nil
}

fn _opt_add_safe_var(out, name, kind) {
    if out == nil || name == nil || kind == nil { return nil }
    if _opt_safe_var_kind(out, name) != nil { return nil }
    oren_list_push(out, {"name": name, "kind": kind})
    return nil
}

fn _opt_collect_loop_new_list_vars(stmt, out) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Var" {
        var nm = opthelp.is_ident(stmt["name"])
        if nm != nil {
            var kind = _opt_expr_is_new_list_call(stmt["value"])
            if kind != nil { _opt_add_safe_var(out, nm, kind) }
            else if _opt_expr_is_empty_list_lit(stmt["value"]) { _opt_add_safe_var(out, nm, "list_lit") }
        }
        return nil
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                _opt_collect_loop_new_list_vars(ss[i], out)
                i = i + 1
            }
        }
        return nil
    }
    if t == "If" {
        _opt_collect_loop_new_list_vars(stmt["consq"], out)
        if stmt["alt"] != nil { _opt_collect_loop_new_list_vars(stmt["alt"], out) }
        return nil
    }
    if t == "While" || t == "For" { return nil }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil { _opt_collect_loop_new_list_vars(c["body"], out) }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil { _opt_collect_loop_new_list_vars(stmt["default"], out) }
        return nil
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            _opt_collect_loop_new_list_vars(e["consq"], out)
            if e["alt"] != nil { _opt_collect_loop_new_list_vars(e["alt"], out) }
        }
        if e != nil && e["type"] == "Switch" {
            var cases2 = e["cases"]
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c2 = cases2[ci2]
                    if c2 != nil { _opt_collect_loop_new_list_vars(c2["body"], out) }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil { _opt_collect_loop_new_list_vars(e["default"], out) }
        }
        return nil
    }
    return nil
}

fn _opt_block_has_ident_after(block, idx, name) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var i = idx
    while i < oren_list_len(ss) {
        if _opt_stmt_has_ident(ss[i], name) { return true }
        i = i + 1
    }
    return false
}

fn _opt_rewrite_new_list_in_stmt(stmt, safe_vars) {
    if stmt == nil { return false }
    var changed = false
    var t = stmt["type"]
    if t == "Var" {
        var nm = opthelp.is_ident(stmt["name"])
        var kind2 = _opt_safe_var_kind(safe_vars, nm)
        if nm != nil && kind2 != nil {
            var v = stmt["value"]
            var kind = _opt_expr_is_new_list_call(v)
            if kind != nil {
                var fn_expr = v["fn"]
                if fn_expr != nil && fn_expr["type"] == "Identifier" {
                    if kind2 == "list" || kind2 == "list_lit" { fn_expr["value"] = "oren_arena_new_list" }
                    else { fn_expr["value"] = "oren_arena_new_list_int" }
                    changed = true
                }
            } else if kind2 == "list_lit" && _opt_expr_is_empty_list_lit(v) {
                stmt["value"] = ast.new_call(stmt["token"],
                    {"type": "Identifier", "token": nil, "value": "oren_arena_new_list"},
                    [{"type": "Integer", "token": nil, "value": "0"}])
                changed = true
            }
        }
        return changed
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                if _opt_rewrite_new_list_in_stmt(ss[i], safe_vars) { changed = true }
                i = i + 1
            }
        }
        return changed
    }
    if t == "If" {
        if _opt_rewrite_new_list_in_stmt(stmt["consq"], safe_vars) { changed = true }
        if stmt["alt"] != nil && _opt_rewrite_new_list_in_stmt(stmt["alt"], safe_vars) { changed = true }
        return changed
    }
    if t == "While" || t == "For" { return false }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_rewrite_new_list_in_stmt(c["body"], safe_vars) { changed = true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_rewrite_new_list_in_stmt(stmt["default"], safe_vars) { changed = true }
        return changed
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            if _opt_rewrite_new_list_in_stmt(e["consq"], safe_vars) { changed = true }
            if e["alt"] != nil && _opt_rewrite_new_list_in_stmt(e["alt"], safe_vars) { changed = true }
        }
        if e != nil && e["type"] == "Switch" {
            var cases2 = e["cases"]
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c2 = cases2[ci2]
                    if c2 != nil && _opt_rewrite_new_list_in_stmt(c2["body"], safe_vars) { changed = true }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil && _opt_rewrite_new_list_in_stmt(e["default"], safe_vars) { changed = true }
        }
        return changed
    }
    return false
}

fn _opt_stmt_contains_arena_alloc(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Var" { return _opt_expr_contains_arena_alloc(stmt["value"]) }
    if t == "Assign" { return _opt_expr_contains_arena_alloc(stmt["value"]) }
    if t == "Set" { return _opt_expr_contains_arena_alloc(stmt["value"]) || _opt_expr_contains_arena_alloc(stmt["left"]) }
    if t == "Return" { return _opt_expr_contains_arena_alloc(stmt["value"]) }
    if t == "ExprStmt" { return _opt_expr_contains_arena_alloc(stmt["expr"]) }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                if _opt_stmt_contains_arena_alloc(ss[i]) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "If" {
        if _opt_expr_contains_arena_alloc(stmt["cond"]) { return true }
        if _opt_stmt_contains_arena_alloc(stmt["consq"]) { return true }
        if stmt["alt"] != nil && _opt_stmt_contains_arena_alloc(stmt["alt"]) { return true }
        return false
    }
    if t == "While" || t == "For" {
        return false
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_contains_arena_alloc(c["body"]) { return true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_stmt_contains_arena_alloc(stmt["default"]) { return true }
        return false
    }
    if t == "Function" { return false }
    return false
}

fn _opt_stmt_contains_arena_push_pop(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "Call" {
            if _opt_is_call_named(e, "oren_arena_push") { return true }
            if _opt_is_call_named(e, "oren_arena_pop") { return true }
        }
        return false
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                if _opt_stmt_contains_arena_push_pop(ss[i]) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "If" {
        if _opt_stmt_contains_arena_push_pop(stmt["consq"]) { return true }
        if stmt["alt"] != nil && _opt_stmt_contains_arena_push_pop(stmt["alt"]) { return true }
        return false
    }
    if t == "While" || t == "For" { return false }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_contains_arena_push_pop(c["body"]) { return true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_stmt_contains_arena_push_pop(stmt["default"]) { return true }
        return false
    }
    if t == "Function" { return false }
    return false
}

fn _opt_arena_auto_enabled() {
    return oren_env("OREN_ARENA_AUTO_LOOP") != nil
}

fn _opt_make_arena_stmt(name) {
    var id = {"type": "Identifier", "token": nil, "value": name}
    var call = {"type": "Call", "token": nil, "fn": id, "args": []}
    return {"type": "ExprStmt", "token": nil, "expr": call}
}

fn _opt_insert_arena_pop_in_stmt(stmt, allow_continue) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Break" || t == "Return" || (allow_continue == true && t == "Continue") {
        var blk = ast.new_block(stmt["token"])
        blk["stmts"] = [_opt_make_arena_stmt("oren_arena_pop"), stmt]
        return blk
    }
    if t == "Block" {
        _opt_insert_arena_pop_in_block(stmt, allow_continue)
        return stmt
    }
    if t == "If" {
        if stmt["consq"] != nil {
            stmt["consq"] = _opt_insert_arena_pop_in_stmt(stmt["consq"], allow_continue)
        }
        if stmt["alt"] != nil {
            stmt["alt"] = _opt_insert_arena_pop_in_stmt(stmt["alt"], allow_continue)
        }
        return stmt
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && c["body"] != nil {
                    c["body"] = _opt_insert_arena_pop_in_stmt(c["body"], allow_continue)
                }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil {
            stmt["default"] = _opt_insert_arena_pop_in_stmt(stmt["default"], allow_continue)
        }
        return stmt
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            if e["consq"] != nil { e["consq"] = _opt_insert_arena_pop_in_stmt(e["consq"], allow_continue) }
            if e["alt"] != nil { e["alt"] = _opt_insert_arena_pop_in_stmt(e["alt"], allow_continue) }
        }
        if e != nil && e["type"] == "Switch" {
            var cases2 = e["cases"]
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c2 = cases2[ci2]
                    if c2 != nil && c2["body"] != nil {
                        c2["body"] = _opt_insert_arena_pop_in_stmt(c2["body"], allow_continue)
                    }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil { e["default"] = _opt_insert_arena_pop_in_stmt(e["default"], allow_continue) }
        }
        return stmt
    }
    if t == "While" || t == "For" { return stmt }
    if t == "Function" { return stmt }
    return stmt
}

fn _opt_insert_arena_pop_in_block(block, allow_continue) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var out = []
    var changed = false
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        var ns = _opt_insert_arena_pop_in_stmt(st, allow_continue)
        if ns != st { changed = true }
        oren_list_push(out, ns)
        i = i + 1
    }
    if changed { block["stmts"] = out }
    return changed
}

fn _opt_prepare_loop_arena(block, idx, stmt) {
    if _opt_arena_auto_enabled() != true { return false }
    if stmt == nil { return false }
    if stmt["type"] != "While" && stmt["type"] != "For" { return false }
    var body = stmt["body"]
    if body == nil || body["type"] != "Block" {
        body = ast.new_block(stmt["token"])
        if stmt["body"] != nil { body["stmts"] = [stmt["body"]] }
        stmt["body"] = body
    }
    if _opt_stmt_contains_arena_push_pop(body) == true { return false }
    var allow_continue = false
    if stmt["type"] == "While" { allow_continue = true }
    if stmt["type"] == "For" { allow_continue = true }
    if _opt_has_continue_stmt(body) == true && allow_continue != true { return false }
    var candidates = []
    _opt_collect_loop_new_list_vars(body, candidates)
    var safe_vars = []
    if candidates != nil {
        var ci = 0
        while ci < oren_list_len(candidates) {
            var e = candidates[ci]
            if e != nil {
                var nm = e["name"]
                if nm != nil {
                    if _opt_stmt_has_unsafe_list_use(body, nm) != true &&
                       _opt_block_has_ident_after(block, idx + 1, nm) != true {
                        _opt_add_safe_var(safe_vars, nm, e["kind"])
                    }
                }
            }
            ci = ci + 1
        }
    }
    var did_rewrite = false
    if safe_vars != nil && oren_list_len(safe_vars) > 0 {
        did_rewrite = _opt_rewrite_new_list_in_stmt(body, safe_vars)
    }
    if _opt_stmt_contains_arena_alloc(body) != true && did_rewrite != true { return false }
    _opt_insert_arena_pop_in_block(body, allow_continue)
    var ss = body["stmts"]
    if ss == nil { ss = []; body["stmts"] = ss }
    var out = []
    oren_list_push(out, _opt_make_arena_stmt("oren_arena_push"))
    var i = 0
    while i < oren_list_len(ss) {
        oren_list_push(out, ss[i])
        i = i + 1
    }
    oren_list_push(out, _opt_make_arena_stmt("oren_arena_pop"))
    body["stmts"] = out
    return true
}

fn wrap_arena_loops_in_block(block) {
    if _opt_arena_auto_enabled() != true { return false }
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var i = 0
    var changed = false
    while i < oren_list_len(ss) {
        var st = ss[i]
        if st != nil {
            if st["type"] == "While" || st["type"] == "For" {
                if _opt_prepare_loop_arena(block, i, st) { changed = true }
                if st["body"] != nil { if wrap_arena_loops_in_block(st["body"]) { changed = true } }
            } else if st["type"] == "If" {
                if st["consq"] != nil && wrap_arena_loops_in_block(st["consq"]) { changed = true }
                if st["alt"] != nil && wrap_arena_loops_in_block(st["alt"]) { changed = true }
            } else if st["type"] == "Block" {
                if wrap_arena_loops_in_block(st) { changed = true }
            } else if st["type"] == "Switch" {
                var cases = st["cases"]
                if cases != nil {
                    var ci = 0
                    while ci < oren_list_len(cases) {
                        var c = cases[ci]
                        if c != nil && wrap_arena_loops_in_block(c["body"]) { changed = true }
                        ci = ci + 1
                    }
                }
                if st["default"] != nil && wrap_arena_loops_in_block(st["default"]) { changed = true }
            } else if st["type"] == "ExprStmt" {
                var e = st["expr"]
                if e != nil && e["type"] == "If" {
                    if wrap_arena_loops_in_block(e["consq"]) { changed = true }
                    if e["alt"] != nil && wrap_arena_loops_in_block(e["alt"]) { changed = true }
                }
                if e != nil && e["type"] == "Switch" {
                    var cases2 = e["cases"]
                    if cases2 != nil {
                        var ci2 = 0
                        while ci2 < oren_list_len(cases2) {
                            var c2 = cases2[ci2]
                            if c2 != nil && wrap_arena_loops_in_block(c2["body"]) { changed = true }
                            ci2 = ci2 + 1
                        }
                    }
                    if e["default"] != nil && wrap_arena_loops_in_block(e["default"]) { changed = true }
                }
            }
        }
        i = i + 1
    }
    return changed
}

fn _opt_lower_simple_for_stmt(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Block" { return lower_simple_for_in_block(stmt) }
    if t == "If" {
        var changed = false
        if stmt["consq"] != nil {
            if lower_simple_for_in_block(stmt["consq"]) { changed = true }
        }
        if stmt["alt"] != nil {
            if lower_simple_for_in_block(stmt["alt"]) { changed = true }
        }
        return changed
    }
    if t == "While" {
        if stmt["body"] != nil { return lower_simple_for_in_block(stmt["body"]) }
        return false
    }
    if t == "For" {
        if stmt["body"] != nil { lower_simple_for_in_block(stmt["body"]) }
        return false
    }
    if t == "Switch" {
        var changed2 = false
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && lower_simple_for_in_block(c["body"]) { changed2 = true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil {
            if lower_simple_for_in_block(stmt["default"]) { changed2 = true }
        }
        return changed2
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            var c1 = false
            if lower_simple_for_in_block(e["consq"]) { c1 = true }
            if e["alt"] != nil && lower_simple_for_in_block(e["alt"]) { c1 = true }
            return c1
        }
        if e != nil && e["type"] == "Switch" {
            var c2 = false
            var cases2 = e["cases"]
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c = cases2[ci2]
                    if c != nil && lower_simple_for_in_block(c["body"]) { c2 = true }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil && lower_simple_for_in_block(e["default"]) { c2 = true }
            return c2
        }
        return false
    }
    return false
}

fn lower_simple_for_in_block(block) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }

    var out = []
    var changed = false
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        if st == nil {
            oren_list_push(out, st)
            i = i + 1
            continue
        }

        if st["type"] == "For" {
            if st["body"] != nil { _opt_lower_simple_for_stmt(st["body"]) }
            var post = st["post"]
            var has_continue = _opt_has_continue_stmt(st["body"])
            if has_continue == true && post != nil {
                oren_list_push(out, st)
                i = i + 1
                continue
            }
            var body = st["body"]
            if body == nil || body["type"] != "Block" {
                body = ast.new_block(st["token"])
                if st["body"] != nil { body["stmts"] = [st["body"]] }
            }
            if post != nil { oren_list_push(body["stmts"], post) }
            var cond = st["cond"]
            if cond == nil { cond = ast.new_boolean(st["token"], true) }
            var w = ast.new_while(st["token"], cond, body)
            if st["init"] != nil { oren_list_push(out, st["init"]) }
            oren_list_push(out, w)
            changed = true
            i = i + 1
            continue
        }

        if _opt_lower_simple_for_stmt(st) == true { changed = true }
        oren_list_push(out, st)
        i = i + 1
    }

    if changed { block["stmts"] = out }
    return changed
}
