            }
        }
        if _opt_expr_has_list_len_mutation(fn_expr, list_name) { return true }
        var args2 = expr["args"]
        if args2 != nil {
            var i2 = 0
            while i2 < oren_list_len(args2) {
                if _opt_expr_has_list_len_mutation(args2[i2], list_name) { return true }
                i2 = i2 + 1
            }
        }
        if expr["spread"] != nil && _opt_expr_has_list_len_mutation(expr["spread"], list_name) { return true }
        return false
    }
    if t == "Index" {
        if _opt_expr_has_list_len_mutation(expr["left"], list_name) { return true }
        return _opt_expr_has_list_len_mutation(expr["index"], list_name)
    }
    if t == "Member" {
        return _opt_expr_has_list_len_mutation(expr["left"], list_name)
    }
    if t == "Prefix" { return _opt_expr_has_list_len_mutation(expr["right"], list_name) }
    if t == "Infix" {
        if _opt_expr_has_list_len_mutation(expr["left"], list_name) { return true }
        return _opt_expr_has_list_len_mutation(expr["right"], list_name)
    }
    if t == "If" {
        if _opt_expr_has_list_len_mutation(expr["cond"], list_name) { return true }
        if _opt_stmt_has_list_len_mutation(expr["consq"], list_name) { return true }
        if expr["alt"] != nil && _opt_stmt_has_list_len_mutation(expr["alt"], list_name) { return true }
        return false
    }
    if t == "Switch" {
        var cases = expr["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_has_list_len_mutation(c["body"], list_name) { return true }
                ci = ci + 1
            }
        }
        if expr["default"] != nil && _opt_stmt_has_list_len_mutation(expr["default"], list_name) { return true }
        return false
    }
    if t == "Function" { return _opt_stmt_has_list_len_mutation(expr["body"], list_name) }
    return false
}

fn _opt_stmt_has_list_len_mutation(stmt, list_name) {
    if stmt == nil || list_name == nil { return false }
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                if _opt_stmt_has_list_len_mutation(ss[i], list_name) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "Var" || t == "Assign" { return _opt_expr_has_list_len_mutation(stmt["value"], list_name) }
    if t == "Set" {
        if _opt_expr_has_list_len_mutation(stmt["left"], list_name) { return true }
        return _opt_expr_has_list_len_mutation(stmt["value"], list_name)
    }
    if t == "Return" { return _opt_expr_has_list_len_mutation(stmt["value"], list_name) }
    if t == "ExprStmt" { return _opt_expr_has_list_len_mutation(stmt["expr"], list_name) }
    if t == "While" {
        if _opt_expr_has_list_len_mutation(stmt["cond"], list_name) { return true }
        return _opt_stmt_has_list_len_mutation(stmt["body"], list_name)
    }
    if t == "For" {
        if _opt_stmt_has_list_len_mutation(stmt["init"], list_name) { return true }
        if _opt_expr_has_list_len_mutation(stmt["cond"], list_name) { return true }
        if _opt_expr_has_list_len_mutation(stmt["post"], list_name) { return true }
        return _opt_stmt_has_list_len_mutation(stmt["body"], list_name)
    }
    if t == "If" {
        if _opt_expr_has_list_len_mutation(stmt["cond"], list_name) { return true }
        if _opt_stmt_has_list_len_mutation(stmt["consq"], list_name) { return true }
        if stmt["alt"] != nil && _opt_stmt_has_list_len_mutation(stmt["alt"], list_name) { return true }
        return false
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_has_list_len_mutation(c["body"], list_name) { return true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_stmt_has_list_len_mutation(stmt["default"], list_name) { return true }
        return false
    }
    if t == "Function" { return _opt_stmt_has_list_len_mutation(stmt["body"], list_name) }
    return false
}

fn _opt_loop_has_simple_bound(block, idx, stmt) {
    if stmt == nil { return false }
    var cond = stmt["cond"]
    if cond == nil { return false }
    if cond["type"] != "Infix" { return false }
    var op = cond["op"]
    if op != "<" && op != "<=" { return false }
    var left = cond["left"]
    var right = cond["right"]
    if left == nil || left["type"] != "Identifier" { return false }
    if right == nil { return false }
    if _opt_is_const_int_expr(right) { return true }
    if right["type"] == "Identifier" {
        var rn = right["value"]
        if rn == nil || _opt_str_eq(rn, left["value"]) { return false }
        if _opt_stmt_assigns_ident(stmt["body"], rn) { return false }
        if stmt["type"] == "For" {
            if _opt_stmt_assigns_ident(stmt["init"], rn) { return false }
            if _opt_stmt_assigns_ident(stmt["post"], rn) { return false }
        }
        var has_const = _opt_block_const_int_before(block, idx, rn)
        if has_const == true { return true }
        var list_name = _opt_block_list_len_before(block, idx, rn)
        if oren_env("OREN_TRACE_ARENA_LOOPS") != nil {
            var ln = "nil"
            if list_name != nil { ln = list_name }
            var ci3 = 0
            if has_const == true { ci3 = 1 }
            _opt_arena_trace("[arena_loop] bound_check name=" + rn +
                " const=" + oren_int_to_string(ci3) +
                " list_len=" + ln)
        }
        if list_name != nil {
            if _opt_stmt_assigns_ident(stmt["body"], list_name) { return false }
            if stmt["type"] == "For" {
                if _opt_stmt_assigns_ident(stmt["init"], list_name) { return false }
                if _opt_stmt_assigns_ident(stmt["post"], list_name) { return false }
            }
            if _opt_stmt_has_list_len_mutation(stmt["body"], list_name) { return false }
            if stmt["type"] == "For" {
                if _opt_stmt_has_list_len_mutation(stmt["init"], list_name) { return false }
                if _opt_stmt_has_list_len_mutation(stmt["post"], list_name) { return false }
            }
            return true
        }
    }
    return false
}

var OREN_ARENA_LONG_LIVED_BOUND_LIMIT = -1

fn _opt_arena_long_lived_bound_limit() {
    if OREN_ARENA_LONG_LIVED_BOUND_LIMIT >= 0 { return OREN_ARENA_LONG_LIVED_BOUND_LIMIT }
    var limit = 1000000
    var v = oren_env("OREN_ARENA_LONG_LIVED_BOUND")
    if v != nil && v != "" {
        var parsed = intparse.parse_int_lit(v)
        if !oren_is_err(parsed) && parsed > 0 { limit = parsed }
        else { limit = 0 }
    }
    OREN_ARENA_LONG_LIVED_BOUND_LIMIT = limit
    return limit
}

fn _opt_loop_simple_bound_value(block, idx, stmt) {
    if stmt == nil { return nil }
    var cond = stmt["cond"]
    if cond == nil { return nil }
    if cond["type"] != "Infix" { return nil }
    var op = cond["op"]
    if op != "<" && op != "<=" { return nil }
    var left = cond["left"]
    var right = cond["right"]
    if left == nil || left["type"] != "Identifier" { return nil }
    if right == nil { return nil }
    if _opt_is_const_int_expr(right) == true {
        var v = intparse.parse_int_lit(right["value"])
        if oren_is_err(v) { return nil }
        return v
    }
    if right["type"] == "Identifier" {
        var rn = right["value"]
        if rn == nil || _opt_str_eq(rn, left["value"]) { return nil }
        var v2 = _opt_block_const_int_value_before(block, idx, rn)
        if v2 != nil { return v2 }
        var list_name = _opt_block_list_len_before(block, idx, rn)
        if list_name != nil {
            var lit_len = _opt_block_list_lit_len_before(block, idx, list_name)
            if lit_len != nil { return lit_len }
        }
    }
    return nil
}

fn _opt_loop_is_long_lived(block, idx, stmt) {
    if stmt == nil { return false }
    if stmt["type"] != "While" && stmt["type"] != "For" { return false }
    if _opt_loop_has_simple_bound(block, idx, stmt) {
        var limit = _opt_arena_long_lived_bound_limit()
        if oren_env("OREN_TRACE_ARENA_LOOPS") != nil {
            var bound = _opt_loop_simple_bound_value(block, idx, stmt)
            var bval = -1
            if bound != nil { bval = bound }
            _opt_arena_trace("[arena_loop] bound limit=" + oren_int_to_string(limit) +
                " bound=" + oren_int_to_string(bval))
        }
        if limit > 0 {
            var bound = _opt_loop_simple_bound_value(block, idx, stmt)
            if bound != nil && bound >= limit { return true }
        }
        return false
    }
    if oren_env("OREN_TRACE_ARENA_LOOPS") != nil {
        _opt_arena_trace("[arena_loop] bound missing")
    }
    return true
}

fn _opt_stmt_has_attr(stmt, name) {
    if stmt == nil { return false }
    var attrs = stmt["attrs"]
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && _opt_str_eq(a["name"], name) { return true }
        i = i + 1
    }
    return false
}

fn _opt_make_arena_stmt(name) {
    var id = {"type": "Identifier", "token": nil, "value": name}
    var call = {"type": "Call", "token": nil, "fn": id, "args": []}
    return {"type": "ExprStmt", "token": nil, "expr": call}
}

fn _opt_insert_arena_pop_in_stmt(stmt, allow_break, allow_continue) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Break" {
        if allow_break != true { return stmt }
        var blk_break = ast.new_block(stmt["token"])
        blk_break["stmts"] = [_opt_make_arena_stmt("oren_arena_pop"), stmt]
        return blk_break
    }
    if t == "Return" {
        var blk = ast.new_block(stmt["token"])
        blk["stmts"] = [_opt_make_arena_stmt("oren_arena_pop"), stmt]
        return blk
    }
    if t == "Continue" {
        if allow_continue != true { return stmt }
        var blk_continue = ast.new_block(stmt["token"])
        blk_continue["stmts"] = [_opt_make_arena_stmt("oren_arena_pop"), stmt]
        return blk_continue
    }
    if t == "Block" {
        _opt_insert_arena_pop_in_block(stmt, allow_break, allow_continue)
        return stmt
    }
    if t == "If" {
        if stmt["consq"] != nil {
            stmt["consq"] = _opt_insert_arena_pop_in_stmt(stmt["consq"], allow_break, allow_continue)
        }
        if stmt["alt"] != nil {
            stmt["alt"] = _opt_insert_arena_pop_in_stmt(stmt["alt"], allow_break, allow_continue)
        }
        return stmt
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && c["body"] != nil {
                    c["body"] = _opt_insert_arena_pop_in_stmt(c["body"], allow_break, allow_continue)
                }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil {
            stmt["default"] = _opt_insert_arena_pop_in_stmt(stmt["default"], allow_break, allow_continue)
        }
        return stmt
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            if e["consq"] != nil { e["consq"] = _opt_insert_arena_pop_in_stmt(e["consq"], allow_break, allow_continue) }
            if e["alt"] != nil { e["alt"] = _opt_insert_arena_pop_in_stmt(e["alt"], allow_break, allow_continue) }
        }
        if e != nil && e["type"] == "Switch" {
            var cases2 = e["cases"]
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c2 = cases2[ci2]
                    if c2 != nil && c2["body"] != nil {
                        c2["body"] = _opt_insert_arena_pop_in_stmt(c2["body"], allow_break, allow_continue)
                    }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil { e["default"] = _opt_insert_arena_pop_in_stmt(e["default"], allow_break, allow_continue) }
        }
        return stmt
    }
    if t == "While" || t == "For" { return stmt }
    if t == "Function" { return stmt }
    return stmt
}

fn _opt_insert_arena_pop_in_block(block, allow_break, allow_continue) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var out = []
    var changed = false
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        var ns = _opt_insert_arena_pop_in_stmt(st, allow_break, allow_continue)
        if ns != st { changed = true }
        oren_list_push(out, ns)
        i = i + 1
    }
    if changed { block["stmts"] = out }
    return changed
}

fn _opt_prepare_loop_arena(block, idx, stmt, parent_forced, parent_noarena) {
    if stmt == nil { return false }
    if stmt["type"] != "While" && stmt["type"] != "For" { return false }
    if _opt_arena_backend_allows() != true {
        _opt_arena_trace("[arena_loop] skip=backend")
        return false
    }
    if _opt_stmt_has_attr(stmt, "oren.noarena") == true {
        _opt_arena_trace("[arena_loop] skip=noarena")
        return false
    }
    if oren_env("OREN_TRACE_ARENA_LOOPS") != nil {
        var shown = 0
        var bi = 0
        var ss0 = nil
        if block != nil { ss0 = block["stmts"] }
        while ss0 != nil && bi < idx && shown < 8 {
            var st0 = ss0[bi]
            if st0 != nil && (st0["type"] == "Var" || st0["type"] == "Assign") {
                var nm0 = opthelp.is_ident(st0["name"])
                if nm0 != nil {
                    _opt_arena_trace("[arena_loop] prior_name=" + nm0)
                    shown = shown + 1
                }
            } else if st0 != nil && st0["type"] == "Set" {
                var left0 = st0["left"]
                if left0 != nil && left0["type"] == "Identifier" {
                    _opt_arena_trace("[arena_loop] prior_name=" + left0["value"])
                    shown = shown + 1
                }
            }
            bi = bi + 1
        }
        if shown == 0 { _opt_arena_trace("[arena_loop] prior_name=none") }
    }
    var force_iter = _opt_stmt_has_attr(stmt, "oren.arena_iter")
    var force = _opt_stmt_has_attr(stmt, "oren.arena") || force_iter
    if parent_forced == true && force != true {
        _opt_arena_trace("[arena_loop] skip=parent_forced")
        return false
    }
    if parent_noarena == true && force != true {
        _opt_arena_trace("[arena_loop] skip=parent_noarena")
        return false
    }
    if _opt_arena_auto_enabled() != true && force != true {
        _opt_arena_trace("[arena_loop] skip=auto_disabled")
        return false
    }
    var body = stmt["body"]
    if body == nil || body["type"] != "Block" {
        body = ast.new_block(stmt["token"])
        if stmt["body"] != nil { body["stmts"] = [stmt["body"]] }
        stmt["body"] = body
    }
    if _opt_stmt_contains_arena_push_pop(body) == true {
        _opt_arena_trace("[arena_loop] skip=has_arena_calls")
        return false
    }
    var allow_continue = false
    if stmt["type"] == "While" { allow_continue = true }
    if stmt["type"] == "For" { allow_continue = true }
    if _opt_has_continue_stmt(body) == true && allow_continue != true { return false }
    var long_lived = _opt_loop_is_long_lived(block, idx, stmt)
    var per_iter = _opt_arena_per_iter_enabled() || force_iter || long_lived
    var candidates = []
    _opt_collect_loop_new_list_vars(body, candidates)
    var safe_vars = []
    if candidates != nil {
        var ci = 0
        while ci < oren_list_len(candidates) {
            var e = candidates[ci]
            if e != nil {
                var nm = e["name"]
                if nm != nil {
                    if _opt_stmt_has_unsafe_list_use(body, nm) != true &&
                       _opt_block_has_ident_after(block, idx + 1, nm) != true &&
                       _opt_loop_first_assign_dominates(body, nm) == true {
                        _opt_add_safe_var(safe_vars, nm, e["kind"])
                    }
                }
            }
            ci = ci + 1
        }
    }
    var did_rewrite = false
    if safe_vars != nil && oren_list_len(safe_vars) > 0 {
        did_rewrite = _opt_rewrite_new_list_in_stmt(body, safe_vars)
    }
    if _opt_stmt_contains_arena_alloc(body) != true && did_rewrite != true {
        _opt_arena_trace("[arena_loop] skip=no_arena_alloc")
        return false
    }

    var safe_len = 0
    if safe_vars != nil { safe_len = oren_list_len(safe_vars) }
    var per_iter_i = 0
    if per_iter == true { per_iter_i = 1 }
    var long_lived_i = 0
    if long_lived == true { long_lived_i = 1 }
    var rewrite_i = 0
    if did_rewrite == true { rewrite_i = 1 }
    _opt_arena_trace("[arena_loop] wrap per_iter=" + oren_int_to_string(per_iter_i) +
        " long_lived=" + oren_int_to_string(long_lived_i) +
        " safe_vars=" + oren_int_to_string(safe_len) +
        " rewrite=" + oren_int_to_string(rewrite_i))
    if per_iter == true {
        _opt_insert_arena_pop_in_block(body, true, allow_continue)
        var ss = body["stmts"]
        if ss == nil { ss = []; body["stmts"] = ss }
        var out = []
        oren_list_push(out, _opt_make_arena_stmt("oren_arena_push"))
        var i = 0
        while i < oren_list_len(ss) {
            oren_list_push(out, ss[i])
            i = i + 1
        }
        oren_list_push(out, _opt_make_arena_stmt("oren_arena_pop"))
        body["stmts"] = out
        return true
    }

    _opt_insert_arena_pop_in_block(body, false, false)
    if block != nil && block["type"] == "Block" && block["stmts"] != nil {
        var wrap = ast.new_block(stmt["token"])
        wrap["stmts"] = [_opt_make_arena_stmt("oren_arena_push"), stmt, _opt_make_arena_stmt("oren_arena_pop")]
        block["stmts"][idx] = wrap
    }
    return true
}

fn wrap_arena_loops_in_block(block) {
    return wrap_arena_loops_in_block_inner(block, false, false)
}

fn wrap_arena_loops_in_block_inner(block, parent_forced, parent_noarena) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var i = 0
    var changed = false
    while i < oren_list_len(ss) {
        var st = ss[i]
        if st != nil {
            if st["type"] == "While" || st["type"] == "For" {
                if _opt_prepare_loop_arena(block, i, st, parent_forced, parent_noarena) { changed = true }
                var loop_forced = _opt_stmt_has_attr(st, "oren.arena") || _opt_stmt_has_attr(st, "oren.arena_iter")
                var next_forced = parent_forced || loop_forced
                var loop_noarena = _opt_stmt_has_attr(st, "oren.noarena")
                var next_noarena = parent_noarena || loop_noarena
                if st["body"] != nil { if wrap_arena_loops_in_block_inner(st["body"], next_forced, next_noarena) { changed = true } }
            } else if st["type"] == "If" {
                if st["consq"] != nil && wrap_arena_loops_in_block_inner(st["consq"], parent_forced, parent_noarena) { changed = true }
                if st["alt"] != nil && wrap_arena_loops_in_block_inner(st["alt"], parent_forced, parent_noarena) { changed = true }
            } else if st["type"] == "Block" {
                if wrap_arena_loops_in_block_inner(st, parent_forced, parent_noarena) { changed = true }
            } else if st["type"] == "Switch" {
                var cases = st["cases"]
                if cases != nil {
                    var ci = 0
                    while ci < oren_list_len(cases) {
                        var c = cases[ci]
                        if c != nil && wrap_arena_loops_in_block_inner(c["body"], parent_forced, parent_noarena) { changed = true }
                        ci = ci + 1
                    }
                }
                if st["default"] != nil && wrap_arena_loops_in_block_inner(st["default"], parent_forced, parent_noarena) { changed = true }
            } else if st["type"] == "ExprStmt" {
                var e = st["expr"]
                if e != nil && e["type"] == "If" {
                    if wrap_arena_loops_in_block_inner(e["consq"], parent_forced, parent_noarena) { changed = true }
                    if e["alt"] != nil && wrap_arena_loops_in_block_inner(e["alt"], parent_forced, parent_noarena) { changed = true }
                }
                if e != nil && e["type"] == "Switch" {
                    var cases2 = e["cases"]
                    if cases2 != nil {
                        var ci2 = 0
                        while ci2 < oren_list_len(cases2) {
                            var c2 = cases2[ci2]
                            if c2 != nil && wrap_arena_loops_in_block_inner(c2["body"], parent_forced, parent_noarena) { changed = true }
                            ci2 = ci2 + 1
                        }
                    }
                    if e["default"] != nil && wrap_arena_loops_in_block_inner(e["default"], parent_forced, parent_noarena) { changed = true }
                }
            }
        }
        i = i + 1
    }
    return changed
}

fn _opt_lower_simple_for_stmt(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Block" { return lower_simple_for_in_block(stmt) }
    if t == "If" {
        var changed = false
        if stmt["consq"] != nil {
            if lower_simple_for_in_block(stmt["consq"]) { changed = true }
        }
        if stmt["alt"] != nil {
            if lower_simple_for_in_block(stmt["alt"]) { changed = true }
        }
        return changed
    }
    if t == "While" {
        if stmt["body"] != nil { return lower_simple_for_in_block(stmt["body"]) }
        return false
    }
    if t == "For" {
        if stmt["body"] != nil { lower_simple_for_in_block(stmt["body"]) }
        return false
    }
    if t == "Switch" {
        var changed2 = false
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && lower_simple_for_in_block(c["body"]) { changed2 = true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil {
            if lower_simple_for_in_block(stmt["default"]) { changed2 = true }
        }
        return changed2
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            var c1 = false
            if lower_simple_for_in_block(e["consq"]) { c1 = true }
            if e["alt"] != nil && lower_simple_for_in_block(e["alt"]) { c1 = true }
            return c1
        }
        if e != nil && e["type"] == "Switch" {
            var c2 = false
            var cases2 = e["cases"]
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c = cases2[ci2]
                    if c != nil && lower_simple_for_in_block(c["body"]) { c2 = true }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil && lower_simple_for_in_block(e["default"]) { c2 = true }
            return c2
        }
        return false
    }
    return false
}

fn lower_simple_for_in_block(block) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }

    var out = []
    var changed = false
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        if st == nil {
            oren_list_push(out, st)
            i = i + 1
            continue
        }

        if st["type"] == "For" {
            if st["body"] != nil { _opt_lower_simple_for_stmt(st["body"]) }
            var post = st["post"]
            var has_continue = _opt_has_continue_stmt(st["body"])
            if has_continue == true && post != nil {
                oren_list_push(out, st)
                i = i + 1
                continue
            }
            var body = st["body"]
            if body == nil || body["type"] != "Block" {
                body = ast.new_block(st["token"])
                if st["body"] != nil { body["stmts"] = [st["body"]] }
            }
            if post != nil { oren_list_push(body["stmts"], post) }
            var cond = st["cond"]
            if cond == nil { cond = ast.new_boolean(st["token"], true) }
            var w = ast.new_while(st["token"], cond, body)
            if st["init"] != nil { oren_list_push(out, st["init"]) }
            oren_list_push(out, w)
            changed = true
            i = i + 1
            continue
        }

        if _opt_lower_simple_for_stmt(st) == true { changed = true }
        oren_list_push(out, st)
        i = i + 1
    }

    if changed { block["stmts"] = out }
    return changed
}
