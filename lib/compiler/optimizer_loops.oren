        }
        return changed
    }
    if t == "Assign" {
        var nm2 = opthelp.is_ident(stmt["name"])
        var kind2b = _opt_safe_var_kind(safe_vars, nm2)
        if nm2 != nil && kind2b != nil {
            var v2 = stmt["value"]
            var kindb = _opt_expr_is_new_list_call(v2)
            if kindb != nil {
                var fn_exprb = v2["fn"]
                if fn_exprb != nil && fn_exprb["type"] == "Identifier" {
                    if kind2b == "list" || kind2b == "list_lit" { fn_exprb["value"] = "oren_arena_new_list" }
                    else { fn_exprb["value"] = "oren_arena_new_list_int" }
                    changed = true
                }
            } else if kind2b == "list_lit" && _opt_expr_is_empty_list_lit(v2) {
                stmt["value"] = ast.new_call(stmt["token"],
                    {"type": "Identifier", "token": nil, "value": "oren_arena_new_list"},
                    [{"type": "Integer", "token": nil, "value": "0"}])
                changed = true
            }
        }
        return changed
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss == nil { return false }
        var out = []
        var i = 0
        while i < oren_list_len(ss) {
            var st = ss[i]
            if st != nil {
                var nm3 = opthelp.is_ident(st["name"])
                var k3 = _opt_safe_var_kind(safe_vars, nm3)
                if (st["type"] == "Var" || st["type"] == "Assign") && nm3 != nil && k3 == "list_lit" {
                    var lit_len = _opt_expr_list_lit_len(st["value"])
                    if lit_len >= 0 {
                        var els = st["value"]["elements"]
                        if els == nil { els = [] }
                        var ctor = "oren_arena_new_list"
                        var call = ast.new_call(st["token"],
                            {"type": "Identifier", "token": nil, "value": ctor},
                            [{"type": "Integer", "token": nil, "value": oren_int_to_string(lit_len)}])
                        var init = {"type": st["type"], "token": st["token"], "name": st["name"], "value": call}
                        if st["attrs"] != nil { init["attrs"] = st["attrs"] }
                        oren_list_push(out, init)
                        var ei = 0
                        while ei < oren_list_len(els) {
                            var push_call = ast.new_call(st["token"],
                                {"type": "Identifier", "token": nil, "value": "oren_list_push_unchecked"},
                                [{"type": "Identifier", "token": nil, "value": nm3}, els[ei]])
                            oren_list_push(out, {"type": "ExprStmt", "token": st["token"], "expr": push_call})
                            ei = ei + 1
                        }
                        changed = true
                        i = i + 1
                        continue
                    }
                }
                if _opt_rewrite_new_list_in_stmt(st, safe_vars) { changed = true }
            }
            oren_list_push(out, st)
            i = i + 1
        }
        if changed { stmt["stmts"] = out }
        return changed
    }
    if t == "While" || t == "For" { return false }
    return false
}

