import ast "ast.oren"
import intparse "int_lit.oren"
import opthelp "optimizer_helpers.oren"

var ARENA_TRACE_BUDGET = 200
var OPTLOOPS_BACKEND = nil

fn _opt_str_eq(a, b) {
    if oren_is_string(a) && oren_is_string(b) { return oren_string_eq(a, b) }
    return a == b
}

fn set_backend(name) {
    OPTLOOPS_BACKEND = name
    return nil
}

fn _opt_arena_backend_allows() {
    if OPTLOOPS_BACKEND == nil { return true }
    return _opt_str_eq(OPTLOOPS_BACKEND, "native")
}

fn _opt_arena_trace(msg) {
    if oren_env("OREN_TRACE_ARENA_LOOPS") == nil { return nil }
    if ARENA_TRACE_BUDGET <= 0 { return nil }
    ARENA_TRACE_BUDGET = ARENA_TRACE_BUDGET - 1
    print(msg)
    return nil
}

fn _opt_has_continue_stmt(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Continue" { return true }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss == nil { return false }
        var i = 0
        while i < oren_list_len(ss) {
            if _opt_has_continue_stmt(ss[i]) { return true }
            i = i + 1
        }
        return false
    }
    if t == "If" {
        if _opt_has_continue_stmt(stmt["consq"]) { return true }
        if stmt["alt"] != nil && _opt_has_continue_stmt(stmt["alt"]) { return true }
        return false
    }
    if t == "While" || t == "For" {
        // Continue inside nested loops does not skip the outer-loop epilogue.
        return false
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_has_continue_stmt(c["body"]) { return true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_has_continue_stmt(stmt["default"]) { return true }
        return false
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            if _opt_has_continue_stmt(e["consq"]) { return true }
            if e["alt"] != nil && _opt_has_continue_stmt(e["alt"]) { return true }
        }
        if e != nil && e["type"] == "Switch" {
            var cases2 = e["cases"]
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c2 = cases2[ci2]
                    if c2 != nil && _opt_has_continue_stmt(c2["body"]) { return true }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil && _opt_has_continue_stmt(e["default"]) { return true }
        }
        return false
    }
    if t == "Function" { return false }
    return false
}

fn _opt_has_break_or_return_stmt(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Break" || t == "Return" { return true }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss == nil { return false }
        var i = 0
        while i < oren_list_len(ss) {
            if _opt_has_break_or_return_stmt(ss[i]) { return true }
            i = i + 1
        }
        return false
    }
    if t == "If" {
        if _opt_has_break_or_return_stmt(stmt["consq"]) { return true }
        if stmt["alt"] != nil && _opt_has_break_or_return_stmt(stmt["alt"]) { return true }
        return false
    }
    if t == "While" || t == "For" {
        // Do not treat nested loops as exits for the outer loop.
        return false
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_has_break_or_return_stmt(c["body"]) { return true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_has_break_or_return_stmt(stmt["default"]) { return true }
        return false
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            if _opt_has_break_or_return_stmt(e["consq"]) { return true }
            if e["alt"] != nil && _opt_has_break_or_return_stmt(e["alt"]) { return true }
        }
        if e != nil && e["type"] == "Switch" {
            var cases2 = e["cases"]
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c2 = cases2[ci2]
                    if c2 != nil && _opt_has_break_or_return_stmt(c2["body"]) { return true }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil && _opt_has_break_or_return_stmt(e["default"]) { return true }
        }
        return false
    }
    if t == "Function" { return false }
    return false
}

fn _opt_is_call_named(expr, name) {
    if expr == nil || expr["type"] != "Call" { return false }
    var fn_expr = expr["fn"]
    if fn_expr == nil || fn_expr["type"] != "Identifier" { return false }
    return _opt_str_eq(fn_expr["value"], name)
}

fn _opt_expr_is_new_list_call(expr) {
    if expr == nil || expr["type"] != "Call" { return nil }
    var fn_expr = expr["fn"]
    if fn_expr == nil || fn_expr["type"] != "Identifier" { return nil }
    var nm = fn_expr["value"]
    if _opt_str_eq(nm, "oren_new_list") { return "list" }
    if _opt_str_eq(nm, "oren_list_new_cap") { return "list" }
    if _opt_str_eq(nm, "oren_new_list_int") { return "list_int" }
    return nil
}

fn _opt_expr_list_lit_len(expr) {
    if expr == nil || expr["type"] != "Array" { return -1 }
    var els = expr["elements"]
    if els == nil { return 0 }
    return oren_list_len(els)
}

fn _opt_expr_is_list_lit(expr) {
    return _opt_expr_list_lit_len(expr) >= 0
}

fn _opt_expr_is_empty_list_lit(expr) {
    return _opt_expr_list_lit_len(expr) == 0
}

fn _opt_expr_contains_new_list(expr) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Call" {
        if _opt_expr_is_new_list_call(expr) != nil { return true }
        var args = expr["args"]
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                if _opt_expr_contains_new_list(args[i]) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "Infix" || t == "Assign" {
        if _opt_expr_contains_new_list(expr["left"]) { return true }
        return _opt_expr_contains_new_list(expr["right"])
    }
    if t == "Prefix" { return _opt_expr_contains_new_list(expr["right"]) }
    if t == "Array" {
        var els = expr["elements"]
        if els != nil {
            var i2 = 0
            while i2 < oren_list_len(els) {
                if _opt_expr_contains_new_list(els[i2]) { return true }
                i2 = i2 + 1
            }
        }
        return false
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        if ps != nil {
            var i3 = 0
            while i3 < oren_list_len(ps) {
                var p = ps[i3]
                if p != nil {
                    if _opt_expr_contains_new_list(p["key"]) { return true }
                    if _opt_expr_contains_new_list(p["value"]) { return true }
                }
                i3 = i3 + 1
            }
        }
        return false
    }
    if t == "Index" {
        if _opt_expr_contains_new_list(expr["left"]) { return true }
        return _opt_expr_contains_new_list(expr["index"])
    }
    if t == "Member" { return _opt_expr_contains_new_list(expr["left"]) }
    if t == "If" {
        if _opt_expr_contains_new_list(expr["cond"]) { return true }
        if _opt_stmt_contains_new_list(expr["consq"]) { return true }
        if expr["alt"] != nil && _opt_stmt_contains_new_list(expr["alt"]) { return true }
        return false
    }
    if t == "Switch" {
        var cases = expr["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_contains_new_list(c["body"]) { return true }
                ci = ci + 1
            }
        }
        if expr["default"] != nil && _opt_stmt_contains_new_list(expr["default"]) { return true }
        return false
    }
    return false
}

fn _opt_stmt_contains_new_list(stmt) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Var" { return _opt_expr_contains_new_list(stmt["value"]) }
    if t == "Assign" { return _opt_expr_contains_new_list(stmt["value"]) }
    if t == "Set" { return _opt_expr_contains_new_list(stmt["value"]) || _opt_expr_contains_new_list(stmt["left"]) }
    if t == "Return" { return _opt_expr_contains_new_list(stmt["value"]) }
    if t == "ExprStmt" { return _opt_expr_contains_new_list(stmt["expr"]) }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                if _opt_stmt_contains_new_list(ss[i]) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "If" {
        if _opt_expr_contains_new_list(stmt["cond"]) { return true }
        if _opt_stmt_contains_new_list(stmt["consq"]) { return true }
        if stmt["alt"] != nil && _opt_stmt_contains_new_list(stmt["alt"]) { return true }
        return false
    }
    if t == "While" || t == "For" { return false }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_contains_new_list(c["body"]) { return true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_stmt_contains_new_list(stmt["default"]) { return true }
        return false
    }
    if t == "Function" { return false }
    return false
}

fn _opt_expr_contains_arena_alloc(expr) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Call" {
        if _opt_is_call_named(expr, "oren_arena_new_list") { return true }
        if _opt_is_call_named(expr, "oren_arena_new_list_int") { return true }
        var args = expr["args"]
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                if _opt_expr_contains_arena_alloc(args[i]) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "Infix" || t == "Assign" {
        if _opt_expr_contains_arena_alloc(expr["left"]) { return true }
        return _opt_expr_contains_arena_alloc(expr["right"])
    }
    if t == "Prefix" { return _opt_expr_contains_arena_alloc(expr["right"]) }
    if t == "Array" {
        var els = expr["elements"]
        if els != nil {
            var i2 = 0
            while i2 < oren_list_len(els) {
                if _opt_expr_contains_arena_alloc(els[i2]) { return true }
                i2 = i2 + 1
            }
        }
        return false
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        if ps != nil {
            var i3 = 0
            while i3 < oren_list_len(ps) {
                var p = ps[i3]
                if p != nil {
                    if _opt_expr_contains_arena_alloc(p["key"]) { return true }
                    if _opt_expr_contains_arena_alloc(p["value"]) { return true }
                }
                i3 = i3 + 1
            }
        }
        return false
    }
    if t == "Index" {
        if _opt_expr_contains_arena_alloc(expr["left"]) { return true }
        return _opt_expr_contains_arena_alloc(expr["index"])
    }
    if t == "Member" { return _opt_expr_contains_arena_alloc(expr["left"]) }
    if t == "If" {
        if _opt_expr_contains_arena_alloc(expr["cond"]) { return true }
        if _opt_stmt_contains_arena_alloc(expr["consq"]) { return true }
        if expr["alt"] != nil && _opt_stmt_contains_arena_alloc(expr["alt"]) { return true }
        return false
    }
    if t == "Switch" {
        var cases = expr["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_contains_arena_alloc(c["body"]) { return true }
                ci = ci + 1
            }
        }
        if expr["default"] != nil && _opt_stmt_contains_arena_alloc(expr["default"]) { return true }
        return false
    }
    return false
}

fn _opt_expr_has_ident(expr, name) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Identifier" { return _opt_str_eq(expr["value"], name) }
    if t == "Call" {
        if _opt_expr_has_ident(expr["fn"], name) { return true }
        var args = expr["args"]
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                if _opt_expr_has_ident(args[i], name) { return true }
                i = i + 1
            }
        }
        if expr["spread"] != nil && _opt_expr_has_ident(expr["spread"], name) { return true }
        return false
    }
    if t == "Infix" || t == "Assign" {
        if _opt_expr_has_ident(expr["left"], name) { return true }
        return _opt_expr_has_ident(expr["right"], name)
    }
    if t == "Prefix" { return _opt_expr_has_ident(expr["right"], name) }
    if t == "Array" {
        var els = expr["elements"]
        if els != nil {
            var i2 = 0
            while i2 < oren_list_len(els) {
                if _opt_expr_has_ident(els[i2], name) { return true }
                i2 = i2 + 1
            }
        }
        return false
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        if ps != nil {
            var i3 = 0
            while i3 < oren_list_len(ps) {
                var p = ps[i3]
                if p != nil {
                    if _opt_expr_has_ident(p["key"], name) { return true }
                    if _opt_expr_has_ident(p["value"], name) { return true }
                }
                i3 = i3 + 1
            }
        }
        return false
    }
    if t == "Index" {
        if _opt_expr_has_ident(expr["left"], name) { return true }
        return _opt_expr_has_ident(expr["index"], name)
    }
    if t == "Member" { return _opt_expr_has_ident(expr["left"], name) }
    if t == "If" {
        if _opt_expr_has_ident(expr["cond"], name) { return true }
        if _opt_stmt_has_ident(expr["consq"], name) { return true }
        if expr["alt"] != nil && _opt_stmt_has_ident(expr["alt"], name) { return true }
        return false
    }
    if t == "Switch" {
        var cases = expr["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_has_ident(c["body"], name) { return true }
                ci = ci + 1
            }
        }
        if expr["default"] != nil && _opt_stmt_has_ident(expr["default"], name) { return true }
        return false
    }
    if t == "Function" { return _opt_stmt_has_ident(expr["body"], name) }
    return false
}

fn _opt_stmt_has_ident(stmt, name) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                if _opt_stmt_has_ident(ss[i], name) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "Var" { return _opt_expr_has_ident(stmt["value"], name) }
    if t == "Assign" { return _opt_expr_has_ident(stmt["value"], name) }
    if t == "Set" {
        if _opt_expr_has_ident(stmt["left"], name) { return true }
        return _opt_expr_has_ident(stmt["value"], name)
    }
    if t == "Return" { return _opt_expr_has_ident(stmt["value"], name) }
    if t == "ExprStmt" { return _opt_expr_has_ident(stmt["expr"], name) }
    if t == "While" {
        if _opt_expr_has_ident(stmt["cond"], name) { return true }
        return _opt_stmt_has_ident(stmt["body"], name)
    }
    if t == "For" {
        if _opt_stmt_has_ident(stmt["init"], name) { return true }
        if _opt_expr_has_ident(stmt["cond"], name) { return true }
        if _opt_expr_has_ident(stmt["post"], name) { return true }
        return _opt_stmt_has_ident(stmt["body"], name)
    }
    if t == "If" {
        if _opt_expr_has_ident(stmt["cond"], name) { return true }
        if _opt_stmt_has_ident(stmt["consq"], name) { return true }
        if stmt["alt"] != nil && _opt_stmt_has_ident(stmt["alt"], name) { return true }
        return false
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_has_ident(c["body"], name) { return true }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil && _opt_stmt_has_ident(stmt["default"], name) { return true }
        return false
    }
    if t == "Function" { return _opt_stmt_has_ident(stmt["body"], name) }
    return false
}

fn _opt_is_safe_list_call_name(name) {
    if name == nil { return false }
    if _opt_str_eq(name, "oren_list_len") || _opt_str_eq(name, "STD_list_len") { return true }
    if _opt_str_eq(name, "oren_list_reserve") || _opt_str_eq(name, "STD_list_reserve") { return true }
    if _opt_str_eq(name, "oren_list_push") || _opt_str_eq(name, "STD_list_push") { return true }
    if _opt_str_eq(name, "oren_list_push_unchecked") || _opt_str_eq(name, "STD_list_push_unchecked") { return true }
    if _opt_str_eq(name, "oren_list_get") || _opt_str_eq(name, "STD_list_get") { return true }
    if _opt_str_eq(name, "oren_list_set") || _opt_str_eq(name, "STD_list_set") { return true }
    if _opt_str_eq(name, "oren_list_int_len") || _opt_str_eq(name, "STD_list_int_len") { return true }
    if _opt_str_eq(name, "oren_list_int_reserve") || _opt_str_eq(name, "STD_list_int_reserve") { return true }
    if _opt_str_eq(name, "oren_list_int_push") || _opt_str_eq(name, "STD_list_int_push") { return true }
    if _opt_str_eq(name, "oren_list_int_get") || _opt_str_eq(name, "STD_list_int_get") { return true }
    if _opt_str_eq(name, "oren_list_int_set") || _opt_str_eq(name, "STD_list_int_set") { return true }
    return false
}

fn _opt_expr_has_unsafe_list_use(expr, name) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Identifier" { return _opt_str_eq(expr["value"], name) }
    if t == "Call" {
        var fn_expr = expr["fn"]
        var fn_name = nil
        if fn_expr != nil && fn_expr["type"] == "Identifier" { fn_name = fn_expr["value"] }
        var args = expr["args"]
        if fn_name != nil && _opt_is_safe_list_call_name(fn_name) {
            if args != nil {
                var i = 0
                while i < oren_list_len(args) {
                    var arg = args[i]
                    if i == 0 {
                        if _opt_expr_has_ident(arg, name) {
                            if arg == nil || arg["type"] != "Identifier" || _opt_str_eq(arg["value"], name) != true {
                                return true
                            }
                        }
                    } else {
                        if _opt_expr_has_ident(arg, name) { return true }
                    }
                    i = i + 1
                }
            }
            if expr["spread"] != nil && _opt_expr_has_ident(expr["spread"], name) { return true }
            return false
        }
        if _opt_expr_has_ident(fn_expr, name) { return true }
        if args != nil {
            var i2 = 0
            while i2 < oren_list_len(args) {
                if _opt_expr_has_ident(args[i2], name) { return true }
                i2 = i2 + 1
            }
        }
        if expr["spread"] != nil && _opt_expr_has_ident(expr["spread"], name) { return true }
        return false
    }
    if t == "Index" {
        var left = expr["left"]
        var idx = expr["index"]
        if _opt_expr_has_ident(idx, name) { return true }
        if left != nil && left["type"] == "Identifier" && _opt_str_eq(left["value"], name) { return false }
        return _opt_expr_has_ident(left, name)
    }
    if t == "Member" {
        var left2 = expr["left"]
        if left2 != nil && left2["type"] == "Identifier" && _opt_str_eq(left2["value"], name) { return true }
        return _opt_expr_has_ident(left2, name)
    }
    if t == "Infix" || t == "Assign" {
        if _opt_expr_has_unsafe_list_use(expr["left"], name) { return true }
        return _opt_expr_has_unsafe_list_use(expr["right"], name)
    }
    if t == "Prefix" { return _opt_expr_has_unsafe_list_use(expr["right"], name) }
    if t == "Array" {
        var els = expr["elements"]
        if els != nil {
            var i3 = 0
            while i3 < oren_list_len(els) {
                if _opt_expr_has_unsafe_list_use(els[i3], name) { return true }
                i3 = i3 + 1
            }
        }
        return false
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        if ps != nil {
            var i4 = 0
            while i4 < oren_list_len(ps) {
                var p = ps[i4]
                if p != nil {
                    if _opt_expr_has_unsafe_list_use(p["key"], name) { return true }
                    if _opt_expr_has_unsafe_list_use(p["value"], name) { return true }
                }
                i4 = i4 + 1
            }
        }
        return false
    }
    if t == "If" {
        if _opt_expr_has_unsafe_list_use(expr["cond"], name) { return true }
        if _opt_stmt_has_unsafe_list_use(expr["consq"], name) { return true }
        if expr["alt"] != nil && _opt_stmt_has_unsafe_list_use(expr["alt"], name) { return true }
        return false
    }
    if t == "Switch" {
        var cases = expr["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && _opt_stmt_has_unsafe_list_use(c["body"], name) { return true }
                ci = ci + 1
            }
        }
        if expr["default"] != nil && _opt_stmt_has_unsafe_list_use(expr["default"], name) { return true }
        return false
    }
    if t == "Function" { return _opt_stmt_has_ident(expr["body"], name) }
    return false
}

fn _opt_stmt_has_unsafe_list_use(stmt, name) {
    if stmt == nil { return false }
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                if _opt_stmt_has_unsafe_list_use(ss[i], name) { return true }
                i = i + 1
            }
        }
        return false
    }
    if t == "Var" || t == "Assign" {
        var nm = opthelp.is_ident(stmt["name"])
        var v = stmt["value"]
