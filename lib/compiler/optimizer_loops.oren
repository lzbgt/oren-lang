fn _opt_rewrite_new_list_in_stmt(stmt, safe_vars) {
    if stmt == nil { return false }
    var changed = false
    var t = stmt["type"]
    if t == "Var" {
        var nm = opthelp.is_ident(stmt["name"])
        var kind2 = _opt_safe_var_kind(safe_vars, nm)
        if nm != nil && kind2 != nil {
