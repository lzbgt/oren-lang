fn analyze_program(prog) {
    print("--- Scope Analysis ---")
    var depth = 0
    var i = 0
    while i < oren_list_len(prog["statements"]) {
        analyze_stmt(prog["statements"][i], depth)
        i = i + 1
    }
    print("--- End Analysis ---")
}

fn analyze_stmt(stmt, depth) {
    var prefix = ""
    var i = 0
    while i < depth { prefix = prefix + "  "; i = i + 1 }
    
    if stmt["type"] == "Var" {
        print(prefix + "Var declaration: " + stmt["name"]["value"] + " (Life start)")
    }
    if stmt["type"] == "Block" {
        print(prefix + "Block scope start")
        var stmts = stmt["stmts"]
        var j = 0
        while j < oren_list_len(stmts) {
            analyze_stmt(stmts[j], depth + 1)
            j = j + 1
        }
        print(prefix + "Block scope end (Auto-release candidates)")
    }
    if stmt["type"] == "ExprStmt" {
        if stmt["expr"]["type"] == "Function" {
            analyze_stmt(stmt["expr"], depth)
        }
    }
    if stmt["type"] == "Function" {
        print(prefix + "Function " + stmt["name"])
        analyze_stmt(stmt["body"], depth + 1)
    }
    if stmt["type"] == "While" {
        analyze_stmt(stmt["body"], depth + 1)
    }
    if stmt["type"] == "If" {
        analyze_stmt(stmt["consq"], depth + 1)
        if stmt["alt"] != nil {
            analyze_stmt(stmt["alt"], depth + 1)
        }
    }
}

fn yield_stmt_site(stmt) {
    if stmt == nil { return nil }
    var tok = stmt["token"]
    if tok == nil { return nil }
    var file = tok["file"]
    var line = tok["line"]
    var col = tok["col"]
    if file != nil && file != "" {
        if line != nil && line > 0 {
            if col != nil && col > 0 {
                return file + ":" + oren_int_to_string(line) + ":" + oren_int_to_string(col)
            }
            return file + ":" + oren_int_to_string(line)
        }
        return file
    }
    if line != nil && line > 0 {
        if col != nil && col > 0 {
            return oren_int_to_string(line) + ":" + oren_int_to_string(col)
        }
        return oren_int_to_string(line)
    }
    return nil
}

fn yield_value_expr_site(expr) {
    if expr == nil { return nil }
    var tok = expr["yield_token"]
    if tok == nil { tok = expr["token"] }
    if tok == nil { return nil }
    var file = tok["file"]
    var line = tok["line"]
    var col = tok["col"]
    if file != nil && file != "" {
        if line != nil && line > 0 {
            if col != nil && col > 0 {
                return file + ":" + oren_int_to_string(line) + ":" + oren_int_to_string(col)
            }
            return file + ":" + oren_int_to_string(line)
        }
        return file
    }
    if line != nil && line > 0 {
        if col != nil && col > 0 {
            return oren_int_to_string(line) + ":" + oren_int_to_string(col)
        }
        return oren_int_to_string(line)
    }
    return nil
}

fn function_attrs_has_name(attrs, name) {
    if attrs == nil || name == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["type"] == "Attr" && a["name"] == name { return true }
        i = i + 1
    }
    return false
}

fn function_surface_name(func, fallback_name) {
    if fallback_name != nil && fallback_name != "" { return fallback_name }
    if func == nil { return nil }
    var decl_name = func["decl_name"]
    if decl_name != nil && decl_name != "" { return decl_name }
    var name = func["name"]
    if name != nil && name != "" { return name }
    return nil
}

fn top_level_function_surface_entry(stmt) {
    if stmt == nil { return nil }
    var func = nil
    var fallback_name = nil
    if stmt["type"] == "Function" {
        func = stmt
    } else if stmt["type"] == "ExprStmt" {
        var expr = stmt["expr"]
        if expr != nil && expr["type"] == "Function" { func = expr }
    } else if stmt["type"] == "Var" {
        var value = stmt["value"]
        if value != nil && value["type"] == "Function" {
            func = value
            if stmt["name"] != nil && stmt["name"]["type"] == "Identifier" {
                fallback_name = stmt["name"]["value"]
            }
        }
    }
    if func == nil { return nil }
    var name = function_surface_name(func, fallback_name)
    if name == nil || name == "" { return nil }
    return {"name": name, "func": func}
}

fn new_function_yield_info() {
    return {
        "contains_yield": false,
        "yield_stmt_count": 0,
        "yield_stmt_sites": [],
        "contains_yield_value": false,
        "yield_value_count": 0,
        "yield_value_sites": [],
        "yield_value_points": [],
        "contains_yield_exchange": false,
        "yield_exchange_count": 0,
        "yield_exchange_sites": [],
        "yield_exchange_points": [],
        "non_top_level_yield_sites": [],
        "loop_nested_yield_sites": [],
        "has_nested_function_literal": false,
        "is_generator_decl": false,
        "generator_decl_surface": nil,
    }
}

fn function_yield_info_note_stmt(info, stmt, depth, in_loop) {
    if stmt == nil || stmt["yield_stmt"] != true { return nil }
    info["contains_yield"] = true
    info["yield_stmt_count"] = info["yield_stmt_count"] + 1
    var site = yield_stmt_site(stmt)
    if site != nil {
        oren_list_push(info["yield_stmt_sites"], site)
        if depth > 0 { oren_list_push(info["non_top_level_yield_sites"], site) }
        if in_loop == true { oren_list_push(info["loop_nested_yield_sites"], site) }
    }
    return nil
}

fn function_yield_info_note_value_expr_ctx(info, expr, context) {
    if info == nil || expr == nil || expr["yield_value_expr"] != true { return nil }
    info["contains_yield_value"] = true
    info["yield_value_count"] = info["yield_value_count"] + 1
    var site = yield_value_expr_site(expr)
    if site != nil { oren_list_push(info["yield_value_sites"], site) }
    var context_name = context
    if context_name == nil || context_name == "" { context_name = "expr" }
    oren_list_push(info["yield_value_points"], {
        "id": oren_list_len(info["yield_value_points"]),
        "site": site,
        "explicit_value": (expr["yield_value_explicit"] == true),
        "context": context_name,
    })
    return nil
}

fn function_yield_info_note_value_expr(info, expr) {
    return function_yield_info_note_value_expr_ctx(info, expr, "expr")
}

fn yield_exchange_expr_site(expr) {
    if expr == nil { return nil }
    var tok = expr["yield_token"]
    if tok == nil { tok = expr["token"] }
    if tok == nil { return nil }
    var file = tok["file"]
    var line = tok["line"]
    var col = tok["col"]
    if file != nil && file != "" {
        if line != nil && line > 0 {
            if col != nil && col > 0 {
                return file + ":" + oren_int_to_string(line) + ":" + oren_int_to_string(col)
            }
            return file + ":" + oren_int_to_string(line)
        }
        return file
    }
    if line != nil && line > 0 {
        if col != nil && col > 0 {
            return oren_int_to_string(line) + ":" + oren_int_to_string(col)
        }
        return oren_int_to_string(line)
    }
    return nil
}

fn function_yield_info_note_exchange_expr_ctx(info, expr, context) {
    if info == nil || expr == nil || expr["type"] != "Call" { return nil }
    var callee = expr["fn"]
    if callee == nil || callee["type"] != "Identifier" { return nil }
    var callee_name = callee["value"]
    var binding_name = nil
    if callee_name == "oren_yield_exchange" {
        binding_name = "explicit_channel_pair"
    } else if callee_name == "_oren_generator_context_exchange" {
        binding_name = "generator_context"
    } else {
        return nil
    }
    info["contains_yield_exchange"] = true
    info["yield_exchange_count"] = info["yield_exchange_count"] + 1
    var site = yield_exchange_expr_site(expr)
    if site != nil { oren_list_push(info["yield_exchange_sites"], site) }
    var context_name = context
    if context_name == nil || context_name == "" { context_name = "expr" }
    var syntax_name = "helper_call"
    if expr["yield_exchange_syntax_kind"] != nil && expr["yield_exchange_syntax_kind"] != "" {
        syntax_name = expr["yield_exchange_syntax_kind"]
    } else if expr["yield_exchange_source_syntax"] == true {
        if binding_name == "generator_context" {
            syntax_name = "yield_in_context"
        } else {
            syntax_name = "yield_in_channels"
        }
    }
    var explicit_value = true
    if expr["yield_exchange_source_syntax"] == true {
        explicit_value = (expr["yield_exchange_explicit_value"] == true)
    }
    oren_list_push(info["yield_exchange_points"], {
        "id": oren_list_len(info["yield_exchange_points"]),
        "site": site,
        "context": context_name,
        "syntax": syntax_name,
        "binding": binding_name,
        "explicit_value": explicit_value,
    })
    return nil
}

fn new_yield_local_scope() {
    return {"locals": {}, "local_names": [], "yielded": {}}
}

fn yield_locals_push_scope(ctx) {
    if ctx == nil { return nil }
    oren_list_push(ctx["frames"], new_yield_local_scope())
    return nil
}

fn yield_locals_pop_scope(ctx) {
    if ctx == nil { return nil }
    var frames = ctx["frames"]
    if frames == nil || oren_list_len(frames) == 0 { return nil }
    var kept = []
    var i = 0
    var n = oren_list_len(frames)
    while i + 1 < n {
        oren_list_push(kept, frames[i])
        i = i + 1
    }
    ctx["frames"] = kept
    return nil
}

fn yield_locals_current_scope(ctx) {
    if ctx == nil { return nil }
    var frames = ctx["frames"]
    if frames == nil || oren_list_len(frames) == 0 { return nil }
    return frames[oren_list_len(frames) - 1]
}

fn yield_locals_declare(ctx, name) {
    if ctx == nil || name == nil || name == "" { return nil }
    var scope = yield_locals_current_scope(ctx)
    if scope == nil { return nil }
    if scope["locals"][name] == true { return nil }
    scope["locals"][name] = true
    oren_list_push(scope["local_names"], name)
    return nil
}

fn yield_locals_mark_active_pending(ctx) {
    if ctx == nil { return nil }
    var frames = ctx["frames"]
    if frames == nil { return nil }
    var fi = 0
    while fi < oren_list_len(frames) {
        var frame = frames[fi]
        var names = frame["local_names"]
        var ni = 0
        while names != nil && ni < oren_list_len(names) {
            frame["yielded"][names[ni]] = true
            ni = ni + 1
        }
        fi = fi + 1
    }
    return nil
}

fn yield_locals_resolve_scope(ctx, name) {
    if ctx == nil || name == nil || name == "" { return nil }
    var frames = ctx["frames"]
    if frames == nil { return nil }
    var i = oren_list_len(frames) - 1
    while i >= 0 {
        var frame = frames[i]
        if frame["locals"][name] == true { return frame }
        i = i - 1
    }
    return nil
}

fn yield_locals_note_cross(ctx, name) {
    if ctx == nil || name == nil || name == "" { return nil }
    var frame = yield_locals_resolve_scope(ctx, name)
    if frame == nil || frame["yielded"][name] != true { return nil }
    if ctx["seen"][name] == true { return nil }
    ctx["seen"][name] = true
    oren_list_push(ctx["locals_across_yield"], name)
    return nil
}

fn yield_locals_walk_expr(ctx, expr) {
    if ctx == nil || expr == nil { return nil }
    var et = expr["type"]
    if et == "Identifier" {
        yield_locals_note_cross(ctx, expr["value"])
        return nil
    }
    if et == "Function" {
        // Nested functions are their own resumable-frame domains.
        return nil
    }
    if et == "Call" {
        yield_locals_walk_expr(ctx, expr["fn"])
        var args = expr["args"]
        var i = 0
        while args != nil && i < oren_list_len(args) {
            yield_locals_walk_expr(ctx, args[i])
            i = i + 1
        }
        if expr["spread"] != nil { yield_locals_walk_expr(ctx, expr["spread"]) }
        return nil
    }
    if et == "Prefix" {
        yield_locals_walk_expr(ctx, expr["right"])
        return nil
    }
    if et == "Infix" {
        yield_locals_walk_expr(ctx, expr["left"])
        yield_locals_walk_expr(ctx, expr["right"])
        return nil
    }
    if et == "If" {
        yield_locals_walk_expr(ctx, expr["cond"])
        yield_locals_walk_stmt(ctx, expr["consq"])
        if expr["alt"] != nil { yield_locals_walk_stmt(ctx, expr["alt"]) }
        return nil
    }
    if et == "Member" {
        yield_locals_walk_expr(ctx, expr["left"])
        return nil
    }
    if et == "Index" {
        yield_locals_walk_expr(ctx, expr["left"])
        yield_locals_walk_expr(ctx, expr["index"])
        return nil
    }
    if et == "Array" {
        var elems = expr["elements"]
        var j = 0
        while elems != nil && j < oren_list_len(elems) {
            yield_locals_walk_expr(ctx, elems[j])
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var pairs = expr["pairs"]
        var k = 0
        while pairs != nil && k < oren_list_len(pairs) {
            var pair = pairs[k]
            yield_locals_walk_expr(ctx, pair["key"])
            yield_locals_walk_expr(ctx, pair["value"])
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" {
        yield_locals_walk_expr(ctx, expr["call"])
        return nil
    }
    return nil
}

fn yield_locals_walk_stmt(ctx, stmt) {
    if ctx == nil || stmt == nil { return nil }

    if stmt["yield_stmt"] == true {
        yield_locals_mark_active_pending(ctx)
    }

    var st = stmt["type"]
    if st == "Var" {
        if stmt["name"] != nil { yield_locals_declare(ctx, stmt["name"]["value"]) }
        yield_locals_walk_expr(ctx, stmt["value"])
        return nil
    }
    if st == "Assign" {
        if stmt["name"] != nil { yield_locals_note_cross(ctx, stmt["name"]["value"]) }
        yield_locals_walk_expr(ctx, stmt["value"])
        return nil
    }
    if st == "Set" {
        if stmt["left"] != nil && stmt["left"]["type"] == "Identifier" {
            yield_locals_note_cross(ctx, stmt["left"]["value"])
        } else {
            yield_locals_walk_expr(ctx, stmt["left"])
        }
        yield_locals_walk_expr(ctx, stmt["value"])
        return nil
    }
    if st == "Return" {
        yield_locals_walk_expr(ctx, stmt["value"])
        return nil
    }
    if st == "ExprStmt" {
        var expr = stmt["expr"]
        if expr != nil && expr["type"] == "Function" {
            if expr["name"] != nil && expr["name"] != "" {
                yield_locals_declare(ctx, expr["name"])
            }
            return nil
        }
        yield_locals_walk_expr(ctx, expr)
        return nil
    }
    if st == "Block" || st == "StmtList" {
        yield_locals_push_scope(ctx)
        var stmts = stmt["stmts"]
        var i = 0
        while stmts != nil && i < oren_list_len(stmts) {
            yield_locals_walk_stmt(ctx, stmts[i])
            i = i + 1
        }
        yield_locals_pop_scope(ctx)
        return nil
    }
    if st == "If" {
        yield_locals_walk_expr(ctx, stmt["cond"])
        yield_locals_walk_stmt(ctx, stmt["consq"])
        if stmt["alt"] != nil { yield_locals_walk_stmt(ctx, stmt["alt"]) }
        return nil
    }
    if st == "While" {
        yield_locals_walk_expr(ctx, stmt["cond"])
        yield_locals_walk_stmt(ctx, stmt["body"])
        return nil
    }
    if st == "For" {
        yield_locals_push_scope(ctx)
        if stmt["init"] != nil { yield_locals_walk_stmt(ctx, stmt["init"]) }
        if stmt["cond"] != nil { yield_locals_walk_expr(ctx, stmt["cond"]) }
        yield_locals_walk_stmt(ctx, stmt["body"])
        if stmt["post"] != nil { yield_locals_walk_stmt(ctx, stmt["post"]) }
        yield_locals_pop_scope(ctx)
        return nil
    }
    if st == "Spawn" {
        yield_locals_walk_expr(ctx, stmt["call"])
        return nil
    }
    if st == "Function" {
        return nil
    }
    return nil
}

fn function_yield_locals_across(func) {
    var out = []
    if func == nil { return out }
    var ctx = {"frames": [], "locals_across_yield": out, "seen": {}}
    yield_locals_push_scope(ctx)
    var params = func["params"]
    var i = 0
    while params != nil && i < oren_list_len(params) {
        var p = params[i]
        if p != nil && p["value"] != nil && p["value"] != "" {
            yield_locals_declare(ctx, p["value"])
        }
        i = i + 1
    }
    yield_locals_walk_stmt(ctx, func["body"])
    yield_locals_pop_scope(ctx)
    return out
}

fn function_yield_info_walk_expr(info, expr, depth, in_loop, context) {
    if info == nil || expr == nil { return nil }
    var et = expr["type"]
    if et == "Function" {
        info["has_nested_function_literal"] = true
        return nil
    }
    if et == "Call" {
        function_yield_info_note_value_expr_ctx(info, expr, context)
        function_yield_info_note_exchange_expr_ctx(info, expr, context)
        function_yield_info_walk_expr(info, expr["fn"], depth, in_loop, "call_callee")
        var args = expr["args"]
        var i = 0
        while args != nil && i < oren_list_len(args) {
            function_yield_info_walk_expr(info, args[i], depth, in_loop, "call_arg")
            i = i + 1
        }
        if expr["spread"] != nil { function_yield_info_walk_expr(info, expr["spread"], depth, in_loop, "call_spread") }
        return nil
    }
    if et == "Prefix" {
        function_yield_info_walk_expr(info, expr["right"], depth, in_loop, "prefix_operand")
        return nil
    }
    if et == "Infix" {
        function_yield_info_walk_expr(info, expr["left"], depth, in_loop, "infix_left")
        function_yield_info_walk_expr(info, expr["right"], depth, in_loop, "infix_right")
        return nil
    }
    if et == "If" {
        function_yield_info_walk_expr(info, expr["cond"], depth, in_loop, "if_cond")
        function_yield_info_walk_stmt(info, expr["consq"], depth + 1, in_loop)
        if expr["alt"] != nil { function_yield_info_walk_stmt(info, expr["alt"], depth + 1, in_loop) }
        return nil
    }
    if et == "Member" {
        function_yield_info_walk_expr(info, expr["left"], depth, in_loop, "member_base")
        return nil
    }
    if et == "Index" {
        function_yield_info_walk_expr(info, expr["left"], depth, in_loop, "index_left")
        function_yield_info_walk_expr(info, expr["index"], depth, in_loop, "index_expr")
        return nil
    }
    if et == "Array" {
        var elems = expr["elements"]
        var j = 0
        while elems != nil && j < oren_list_len(elems) {
            function_yield_info_walk_expr(info, elems[j], depth, in_loop, "array_elem")
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var pairs = expr["pairs"]
        var k = 0
        while pairs != nil && k < oren_list_len(pairs) {
            var pair = pairs[k]
            function_yield_info_walk_expr(info, pair["key"], depth, in_loop, "hash_key")
            function_yield_info_walk_expr(info, pair["value"], depth, in_loop, "hash_value")
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" {
        function_yield_info_walk_expr(info, expr["call"], depth, in_loop, "spawn_call")
        return nil
    }
    return nil
}

fn function_yield_info_walk_stmt(info, stmt, depth, in_loop) {
    if info == nil || stmt == nil { return nil }
    function_yield_info_note_stmt(info, stmt, depth, in_loop)

    var ty = stmt["type"]
    if ty == "Var" {
        function_yield_info_walk_expr(info, stmt["value"], depth, in_loop, "var_init")
        return nil
    }
    if ty == "Assign" {
        function_yield_info_walk_expr(info, stmt["value"], depth, in_loop, "assign_value")
        return nil
    }
    if ty == "Set" {
        function_yield_info_walk_expr(info, stmt["left"], depth, in_loop, "set_left")
        function_yield_info_walk_expr(info, stmt["value"], depth, in_loop, "set_value")
        return nil
    }
    if ty == "Return" {
        function_yield_info_walk_expr(info, stmt["value"], depth, in_loop, "return_value")
        return nil
    }
    if ty == "ExprStmt" {
        function_yield_info_walk_expr(info, stmt["expr"], depth, in_loop, "expr_stmt")
        return nil
    }
    if ty == "Block" || ty == "StmtList" {
        var stmts = stmt["stmts"]
        var i = 0
        while stmts != nil && i < oren_list_len(stmts) {
            function_yield_info_walk_stmt(info, stmts[i], depth + 1, in_loop)
            i = i + 1
        }
        return nil
    }
    if ty == "If" {
        function_yield_info_walk_expr(info, stmt["cond"], depth, in_loop, "if_cond")
        function_yield_info_walk_stmt(info, stmt["consq"], depth + 1, in_loop)
        if stmt["alt"] != nil {
            function_yield_info_walk_stmt(info, stmt["alt"], depth + 1, in_loop)
        }
        return nil
    }
    if ty == "While" {
        function_yield_info_walk_expr(info, stmt["cond"], depth, in_loop, "while_cond")
        function_yield_info_walk_stmt(info, stmt["body"], depth + 1, true)
        return nil
    }
    if ty == "For" {
        if stmt["init"] != nil { function_yield_info_walk_stmt(info, stmt["init"], depth + 1, true) }
        if stmt["cond"] != nil { function_yield_info_walk_expr(info, stmt["cond"], depth + 1, true, "for_cond") }
        if stmt["post"] != nil { function_yield_info_walk_stmt(info, stmt["post"], depth + 1, true) }
        function_yield_info_walk_stmt(info, stmt["body"], depth + 1, true)
        return nil
    }
    if ty == "Spawn" {
        function_yield_info_walk_expr(info, stmt["call"], depth, in_loop, "spawn_call")
        return nil
    }
    if ty == "Function" {
        info["has_nested_function_literal"] = true
        return nil
    }
    return nil
}

fn function_yield_value_surface(info) {
    if info == nil || info["yield_value_count"] <= 0 { return nil }
    var consumer_kinds = []
    var seen = {}
    var i = 0
    var points = info["yield_value_points"]
    while points != nil && i < oren_list_len(points) {
        var point = points[i]
        var kind = nil
        if point != nil { kind = point["context"] }
        if kind != nil && kind != "" && seen[kind] != true {
            seen[kind] = true
            oren_list_push(consumer_kinds, kind)
        }
        i = i + 1
    }
    return {
        "version": 1,
        "surface": "local_value_resume_v0",
        "resume_value_source": "local_expression",
        "supports_implicit_nil": true,
        "supports_explicit_value": true,
        "caller_resume_values": false,
        "generator_channel": false,
        "consumer_kinds": consumer_kinds,
        "yield_points": info["yield_value_points"],
    }
}

fn function_yield_exchange_surface(info) {
    if info == nil || info["yield_exchange_count"] <= 0 { return nil }
    var consumer_kinds = []
    var seen = {}
    var syntax_kinds = []
    var syntax_seen = {}
    var binding_kinds = []
    var binding_seen = {}
    var has_pair = false
    var has_context = false
    var i = 0
    var points = info["yield_exchange_points"]
    while points != nil && i < oren_list_len(points) {
        var point = points[i]
        var kind = nil
        if point != nil { kind = point["context"] }
        if kind != nil && kind != "" && seen[kind] != true {
            seen[kind] = true
            oren_list_push(consumer_kinds, kind)
        }
        var syntax_name = nil
        if point != nil { syntax_name = point["syntax"] }
        if syntax_name != nil && syntax_name != "" && syntax_seen[syntax_name] != true {
            syntax_seen[syntax_name] = true
            oren_list_push(syntax_kinds, syntax_name)
        }
        var binding_name = nil
        if point != nil { binding_name = point["binding"] }
        if binding_name != nil && binding_name != "" && binding_seen[binding_name] != true {
            binding_seen[binding_name] = true
            oren_list_push(binding_kinds, binding_name)
        }
        if binding_name == "explicit_channel_pair" { has_pair = true }
        if binding_name == "generator_context" { has_context = true }
        i = i + 1
    }
    var observer = "mixed_binding"
    var resume_source = "mixed_binding"
    var yield_channel_arg_index = -1
    var resume_channel_arg_index = -1
    var context_arg_index = -1
    var value_arg_index = -1
    if has_pair == true && has_context != true {
        observer = "explicit_channel_arg"
        resume_source = "explicit_channel_arg"
        yield_channel_arg_index = 0
        resume_channel_arg_index = 1
        value_arg_index = 2
    } else if has_context == true && has_pair != true {
        observer = "generator_context"
        resume_source = "generator_context"
        context_arg_index = 0
        value_arg_index = 1
    } else if has_pair == true && has_context == true {
        observer = "mixed_binding"
        resume_source = "mixed_binding"
        yield_channel_arg_index = 0
        resume_channel_arg_index = 1
        context_arg_index = 0
        value_arg_index = -1
    }
    return {
        "version": 2,
        "surface": "channel_resume_v0",
        "yield_value_observer": observer,
        "resume_value_source": resume_source,
        "caller_resume_values": true,
        "generator_channel": true,
        "yield_channel_arg_index": yield_channel_arg_index,
        "resume_channel_arg_index": resume_channel_arg_index,
        "context_arg_index": context_arg_index,
        "value_arg_index": value_arg_index,
        "binding_kinds": binding_kinds,
        "syntax_kinds": syntax_kinds,
        "consumer_kinds": consumer_kinds,
        "exchange_points": info["yield_exchange_points"],
    }
}

fn function_generator_decl_surface(func) {
    if func == nil { return nil }
    if func["generator_decl"] != true && function_attrs_has_name(func["attrs"], "oren.generator") != true {
        return nil
    }
    return {
        "version": 10,
        "surface": "compiler_generator_object_v2",
        "syntax": "attr_oren.generator",
        "helper_api": "oren_generator_start_v2",
        "caller_api": "generator_handle_v2",
        "object_type": "generator",
        "yield_surface": "generator_context_v0",
        "iter_surface": "for_in_v0",
        "iter_api": "oren_iter_next_v0",
        "iter_resume": "implicit_nil_v0",
        "resume_surface": "next_send_delegate_step_v1",
        "next_api": "oren_generator_next_v2",
        "send_api": "oren_generator_send_v2",
        "delegate_api": "oren_generator_delegate_v0",
        "delegate_step_api": "oren_generator_delegate_step_v1",
        "delegate_mode": "inline_fresh_handle_or_started_step_v1",
        "state_layout": "hidden_list_capsule_v2",
        "worker_context_type": "generator_context",
        "decl_forms": ["named_function_decl", "function_valued_var"],
    }
}

fn function_yield_info(func) {
    var info = new_function_yield_info()
    if func == nil { return info }
    var body = func["body"]
    if func["generator_decl"] == true && func["generator_source_body"] != nil {
        body = func["generator_source_body"]
    }
    if body != nil && (body["type"] == "Block" || body["type"] == "StmtList") {
        var stmts = body["stmts"]
        var i = 0
        while stmts != nil && i < oren_list_len(stmts) {
            function_yield_info_walk_stmt(info, stmts[i], 0, false)
            i = i + 1
        }
    } else {
        function_yield_info_walk_stmt(info, body, 0, false)
    }
    info["yield_lowering"] = function_yield_lowering_plan(func, info, function_yield_locals_across(func))
    info["yield_value_surface"] = function_yield_value_surface(info)
    info["yield_exchange_surface"] = function_yield_exchange_surface(info)
    info["generator_decl_surface"] = function_generator_decl_surface(func)
    info["is_generator_decl"] = info["generator_decl_surface"] != nil
    return info
}

fn function_yield_lowering_v0_gate(info, locals_across_yield) {
    if info == nil || info["yield_stmt_count"] <= 0 { return nil }
    var blockers = []
    var ready = oren_list_len(blockers) == 0
    var status = "blocked"
    if ready { status = "ready" }
    return {
        "version": 1,
        "target": "bare_yield_dispatch_v0",
        "ready": ready,
        "status": status,
        "blockers": blockers,
    }
}

fn function_body_top_level_stmts(func) {
    if func == nil { return [] }
    var body = func["body"]
    if body == nil { return [] }
    if body["type"] == "Block" || body["type"] == "StmtList" {
        if body["stmts"] == nil { return [] }
        return body["stmts"]
    }
    return [body]
}

fn yield_v0_stmt_type_name(stmt) {
    if stmt == nil { return "<nil>" }
    return stmt["type"]
}

fn yield_v0_stmt_type_names(stmts) {
    var out = []
    var i = 0
    while stmts != nil && i < oren_list_len(stmts) {
        oren_list_push(out, yield_v0_stmt_type_name(stmts[i]))
        i = i + 1
    }
    return out
}

fn yield_v0_resume_terminator(stmts) {
    if stmts == nil || oren_list_len(stmts) == 0 { return "fallthrough" }
    var last = stmts[oren_list_len(stmts) - 1]
    if last == nil { return "fallthrough" }
    if last["type"] == "Return" { return "return" }
    return "fallthrough"
}

fn function_yield_lowering_v0_prepared(func, info, locals_across_yield, gate) {
    if func == nil || info == nil || gate == nil || gate["ready"] != true { return nil }
    var stmts = function_body_top_level_stmts(func)
    var exec_segments = []
    var segments = []
    var seg_stmts = []
    var seg_state = 0
    var seg_kind = "entry"
    var first_yield_site = nil
    var first_resume_state = -1
    var yield_count = 0
    var i = 0
    while i < oren_list_len(stmts) {
        var stmt = stmts[i]
        if stmt != nil && stmt["yield_stmt"] == true {
            var site = yield_stmt_site(stmt)
            var resume_state = seg_state + 1
            if first_yield_site == nil { first_yield_site = site }
            if first_resume_state < 0 { first_resume_state = resume_state }
            oren_list_push(exec_segments, {
                "state": seg_state,
                "kind": seg_kind,
                "stmts": seg_stmts,
                "terminator": "yield",
                "resume_state": resume_state,
                "yield_site": site,
            })
            oren_list_push(segments, {
                "state": seg_state,
                "kind": seg_kind,
                "stmt_types": yield_v0_stmt_type_names(seg_stmts),
                "terminator": "yield",
            })
            seg_stmts = []
            seg_state = resume_state
            seg_kind = "resume"
            yield_count = yield_count + 1
        } else {
            oren_list_push(seg_stmts, stmt)
        }
        i = i + 1
    }
    if yield_count <= 0 || first_yield_site == nil || first_resume_state < 0 {
        var first_site = nil
        if info["yield_stmt_sites"] != nil && oren_list_len(info["yield_stmt_sites"]) > 0 {
            first_site = info["yield_stmt_sites"][0]
        }
        return {
            "version": 1,
            "kind": "direct_passthrough",
            "state_local": "",
            "entry_state": 0,
            "resume_state": -1,
            "yield_site": first_site,
            "live_slots": locals_across_yield,
            "exec_segments": nil,
            "segments": [{
                "state": 0,
                "kind": "entry",
                "stmt_types": yield_v0_stmt_type_names(stmts),
                "terminator": yield_v0_resume_terminator(stmts),
            }],
        }
    }
    var final_term = yield_v0_resume_terminator(seg_stmts)
    oren_list_push(exec_segments, {
        "state": seg_state,
        "kind": seg_kind,
        "stmts": seg_stmts,
        "terminator": final_term,
        "resume_state": nil,
        "yield_site": nil,
    })
    oren_list_push(segments, {
        "state": seg_state,
        "kind": seg_kind,
        "stmt_types": yield_v0_stmt_type_names(seg_stmts),
        "terminator": final_term,
    })
    return {
        "version": 1,
        "kind": "split_dispatch",
        "state_local": "__oren_yield_state_v0",
        "entry_state": 0,
        "resume_state": first_resume_state,
        "yield_site": first_yield_site,
        "yield_count": yield_count,
        "live_slots": locals_across_yield,
        // Backend-only rolling fields: keep the concrete statement segments available
        // for codegen without serializing them into public metadata yet.
        "exec_segments": exec_segments,
        "segments": segments,
    }
}

fn function_yield_lowering_plan(func, info, locals_across_yield) {
    if info == nil { return nil }
    var sites = info["yield_stmt_sites"]
    if sites == nil || oren_list_len(sites) == 0 { return nil }

    var yield_points = []
    var states = []
    oren_list_push(states, {"id": 0, "kind": "entry"})

    var i = 0
    while i < oren_list_len(sites) {
        var site = sites[i]
        var resume_state = i + 1
        oren_list_push(yield_points, {"id": i, "site": site, "resume_state": resume_state})
        oren_list_push(states, {"id": resume_state, "kind": "resume", "after_yield_site": site})
        i = i + 1
    }

    var gate = function_yield_lowering_v0_gate(info, locals_across_yield)
    return {
        "version": 1,
        "surface": "bare_statement_only",
        "entry_state": 0,
        "state_count": oren_list_len(states),
        "locals_across_yield": locals_across_yield,
        "yield_points": yield_points,
        "states": states,
        "lowering_v0": gate,
        "prepared_v0": function_yield_lowering_v0_prepared(func, info, locals_across_yield, gate),
    }
}

fn program_functions(prog) {
    var out = []
    if prog == nil { return out }
    var stmts = prog["statements"]
    var i = 0
    while stmts != nil && i < oren_list_len(stmts) {
        var s = stmts[i]
        var func = nil
        if s["type"] == "Function" {
            func = s
        } else if s["type"] == "ExprStmt" && s["expr"] != nil && s["expr"]["type"] == "Function" {
            func = s["expr"]
        }
        if func != nil { oren_list_push(out, func) }
        i = i + 1
    }
    return out
}

fn program_yield_lowering_v0_violations(prog) {
    var out = []
    var funcs = program_functions(prog)
    var i = 0
    while i < oren_list_len(funcs) {
        var func = funcs[i]
        var info = function_yield_info(func)
        var plan = info["yield_lowering"]
        if plan != nil {
            var gate = plan["lowering_v0"]
            if gate != nil && gate["ready"] != true {
                var name = func["name"]
                if name == nil || name == "" { name = "<anonymous>" }
                var sites = info["yield_stmt_sites"]
                var first_site = nil
                if sites != nil && oren_list_len(sites) > 0 { first_site = sites[0] }
                oren_list_push(out, {
                    "name": name,
                    "site": first_site,
                    "blockers": gate["blockers"],
                    "status": gate["status"],
                    "target": gate["target"],
                })
            }
        }
        i = i + 1
    }
    return out
}
