fn analyze_program(prog) {
    print("--- Scope Analysis ---")
    var depth = 0
    var i = 0
    while i < oren_list_len(prog["statements"]) {
        analyze_stmt(prog["statements"][i], depth)
        i = i + 1
    }
    print("--- End Analysis ---")
}

fn analyze_stmt(stmt, depth) {
    var prefix = ""
    var i = 0
    while i < depth { prefix = prefix + "  "; i = i + 1 }
    
    if stmt["type"] == "Var" {
        print(prefix + "Var declaration: " + stmt["name"]["value"] + " (Life start)")
    }
    if stmt["type"] == "Block" {
        print(prefix + "Block scope start")
        var stmts = stmt["stmts"]
        var j = 0
        while j < oren_list_len(stmts) {
            analyze_stmt(stmts[j], depth + 1)
            j = j + 1
        }
        print(prefix + "Block scope end (Auto-release candidates)")
    }
    if stmt["type"] == "ExprStmt" {
        if stmt["expr"]["type"] == "Function" {
            analyze_stmt(stmt["expr"], depth)
        }
    }
    if stmt["type"] == "Function" {
        print(prefix + "Function " + stmt["name"])
        analyze_stmt(stmt["body"], depth + 1)
    }
    if stmt["type"] == "While" {
        analyze_stmt(stmt["body"], depth + 1)
    }
    if stmt["type"] == "If" {
        analyze_stmt(stmt["consq"], depth + 1)
        if stmt["alt"] != nil {
            analyze_stmt(stmt["alt"], depth + 1)
        }
    }
}

fn yield_stmt_site(stmt) {
    if stmt == nil { return nil }
    var tok = stmt["token"]
    if tok == nil { return nil }
    var file = tok["file"]
    var line = tok["line"]
    var col = tok["col"]
    if file != nil && file != "" {
        if line != nil && line > 0 {
            if col != nil && col > 0 {
                return file + ":" + oren_int_to_string(line) + ":" + oren_int_to_string(col)
            }
            return file + ":" + oren_int_to_string(line)
        }
        return file
    }
    if line != nil && line > 0 {
        if col != nil && col > 0 {
            return oren_int_to_string(line) + ":" + oren_int_to_string(col)
        }
        return oren_int_to_string(line)
    }
    return nil
}

fn new_function_yield_info() {
    return {"contains_yield": false, "yield_stmt_count": 0, "yield_stmt_sites": []}
}

fn function_yield_info_note_stmt(info, stmt) {
    if stmt == nil || stmt["yield_stmt"] != true { return nil }
    info["contains_yield"] = true
    info["yield_stmt_count"] = info["yield_stmt_count"] + 1
    var site = yield_stmt_site(stmt)
    if site != nil { oren_list_push(info["yield_stmt_sites"], site) }
    return nil
}

fn new_yield_local_scope() {
    return {"locals": {}, "local_names": [], "yielded": {}}
}

fn yield_locals_push_scope(ctx) {
    if ctx == nil { return nil }
    oren_list_push(ctx["frames"], new_yield_local_scope())
    return nil
}

fn yield_locals_pop_scope(ctx) {
    if ctx == nil { return nil }
    var frames = ctx["frames"]
    if frames == nil || oren_list_len(frames) == 0 { return nil }
    var kept = []
    var i = 0
    var n = oren_list_len(frames)
    while i + 1 < n {
        oren_list_push(kept, frames[i])
        i = i + 1
    }
    ctx["frames"] = kept
    return nil
}

fn yield_locals_current_scope(ctx) {
    if ctx == nil { return nil }
    var frames = ctx["frames"]
    if frames == nil || oren_list_len(frames) == 0 { return nil }
    return frames[oren_list_len(frames) - 1]
}

fn yield_locals_declare(ctx, name) {
    if ctx == nil || name == nil || name == "" { return nil }
    var scope = yield_locals_current_scope(ctx)
    if scope == nil { return nil }
    if scope["locals"][name] == true { return nil }
    scope["locals"][name] = true
    oren_list_push(scope["local_names"], name)
    return nil
}

fn yield_locals_mark_active_pending(ctx) {
    if ctx == nil { return nil }
    var frames = ctx["frames"]
    if frames == nil { return nil }
    var fi = 0
    while fi < oren_list_len(frames) {
        var frame = frames[fi]
        var names = frame["local_names"]
        var ni = 0
        while names != nil && ni < oren_list_len(names) {
            frame["yielded"][names[ni]] = true
            ni = ni + 1
        }
        fi = fi + 1
    }
    return nil
}

fn yield_locals_resolve_scope(ctx, name) {
    if ctx == nil || name == nil || name == "" { return nil }
    var frames = ctx["frames"]
    if frames == nil { return nil }
    var i = oren_list_len(frames) - 1
    while i >= 0 {
        var frame = frames[i]
        if frame["locals"][name] == true { return frame }
        i = i - 1
    }
    return nil
}

fn yield_locals_note_cross(ctx, name) {
    if ctx == nil || name == nil || name == "" { return nil }
    var frame = yield_locals_resolve_scope(ctx, name)
    if frame == nil || frame["yielded"][name] != true { return nil }
    if ctx["seen"][name] == true { return nil }
    ctx["seen"][name] = true
    oren_list_push(ctx["locals_across_yield"], name)
    return nil
}

fn yield_locals_walk_expr(ctx, expr) {
    if ctx == nil || expr == nil { return nil }
    var et = expr["type"]
    if et == "Identifier" {
        yield_locals_note_cross(ctx, expr["value"])
        return nil
    }
    if et == "Function" {
        // Nested functions are their own resumable-frame domains.
        return nil
    }
    if et == "Call" {
        yield_locals_walk_expr(ctx, expr["fn"])
        var args = expr["args"]
        var i = 0
        while args != nil && i < oren_list_len(args) {
            yield_locals_walk_expr(ctx, args[i])
            i = i + 1
        }
        if expr["spread"] != nil { yield_locals_walk_expr(ctx, expr["spread"]) }
        return nil
    }
    if et == "Prefix" {
        yield_locals_walk_expr(ctx, expr["right"])
        return nil
    }
    if et == "Infix" {
        yield_locals_walk_expr(ctx, expr["left"])
        yield_locals_walk_expr(ctx, expr["right"])
        return nil
    }
    if et == "If" {
        yield_locals_walk_expr(ctx, expr["cond"])
        yield_locals_walk_stmt(ctx, expr["consq"])
        if expr["alt"] != nil { yield_locals_walk_stmt(ctx, expr["alt"]) }
        return nil
    }
    if et == "Member" {
        yield_locals_walk_expr(ctx, expr["left"])
        return nil
    }
    if et == "Index" {
        yield_locals_walk_expr(ctx, expr["left"])
        yield_locals_walk_expr(ctx, expr["index"])
        return nil
    }
    if et == "Array" {
        var elems = expr["elements"]
        var j = 0
        while elems != nil && j < oren_list_len(elems) {
            yield_locals_walk_expr(ctx, elems[j])
            j = j + 1
        }
        return nil
    }
    if et == "Hash" {
        var pairs = expr["pairs"]
        var k = 0
        while pairs != nil && k < oren_list_len(pairs) {
            var pair = pairs[k]
            yield_locals_walk_expr(ctx, pair["key"])
            yield_locals_walk_expr(ctx, pair["value"])
            k = k + 1
        }
        return nil
    }
    if et == "SpawnExpr" {
        yield_locals_walk_expr(ctx, expr["call"])
        return nil
    }
    return nil
}

fn yield_locals_walk_stmt(ctx, stmt) {
    if ctx == nil || stmt == nil { return nil }

    if stmt["yield_stmt"] == true {
        yield_locals_mark_active_pending(ctx)
    }

    var st = stmt["type"]
    if st == "Var" {
        if stmt["name"] != nil { yield_locals_declare(ctx, stmt["name"]["value"]) }
        yield_locals_walk_expr(ctx, stmt["value"])
        return nil
    }
    if st == "Assign" {
        if stmt["name"] != nil { yield_locals_note_cross(ctx, stmt["name"]["value"]) }
        yield_locals_walk_expr(ctx, stmt["value"])
        return nil
    }
    if st == "Set" {
        if stmt["left"] != nil && stmt["left"]["type"] == "Identifier" {
            yield_locals_note_cross(ctx, stmt["left"]["value"])
        } else {
            yield_locals_walk_expr(ctx, stmt["left"])
        }
        yield_locals_walk_expr(ctx, stmt["value"])
        return nil
    }
    if st == "Return" {
        yield_locals_walk_expr(ctx, stmt["value"])
        return nil
    }
    if st == "ExprStmt" {
        var expr = stmt["expr"]
        if expr != nil && expr["type"] == "Function" {
            if expr["name"] != nil && expr["name"] != "" {
                yield_locals_declare(ctx, expr["name"])
            }
            return nil
        }
        yield_locals_walk_expr(ctx, expr)
        return nil
    }
    if st == "Block" || st == "StmtList" {
        yield_locals_push_scope(ctx)
        var stmts = stmt["stmts"]
        var i = 0
        while stmts != nil && i < oren_list_len(stmts) {
            yield_locals_walk_stmt(ctx, stmts[i])
            i = i + 1
        }
        yield_locals_pop_scope(ctx)
        return nil
    }
    if st == "If" {
        yield_locals_walk_expr(ctx, stmt["cond"])
        yield_locals_walk_stmt(ctx, stmt["consq"])
        if stmt["alt"] != nil { yield_locals_walk_stmt(ctx, stmt["alt"]) }
        return nil
    }
    if st == "While" {
        yield_locals_walk_expr(ctx, stmt["cond"])
        yield_locals_walk_stmt(ctx, stmt["body"])
        return nil
    }
    if st == "For" {
        yield_locals_push_scope(ctx)
        if stmt["init"] != nil { yield_locals_walk_stmt(ctx, stmt["init"]) }
        if stmt["cond"] != nil { yield_locals_walk_expr(ctx, stmt["cond"]) }
        yield_locals_walk_stmt(ctx, stmt["body"])
        if stmt["post"] != nil { yield_locals_walk_stmt(ctx, stmt["post"]) }
        yield_locals_pop_scope(ctx)
        return nil
    }
    if st == "Spawn" {
        yield_locals_walk_expr(ctx, stmt["call"])
        return nil
    }
    if st == "Function" {
        return nil
    }
    return nil
}

fn function_yield_locals_across(func) {
    var out = []
    if func == nil { return out }
    var ctx = {"frames": [], "locals_across_yield": out, "seen": {}}
    yield_locals_push_scope(ctx)
    var params = func["params"]
    var i = 0
    while params != nil && i < oren_list_len(params) {
        var p = params[i]
        if p != nil && p["value"] != nil && p["value"] != "" {
            yield_locals_declare(ctx, p["value"])
        }
        i = i + 1
    }
    yield_locals_walk_stmt(ctx, func["body"])
    yield_locals_pop_scope(ctx)
    return out
}

fn function_yield_info_walk_stmt(info, stmt) {
    if info == nil || stmt == nil { return nil }
    function_yield_info_note_stmt(info, stmt)

    var ty = stmt["type"]
    if ty == "Block" || ty == "StmtList" {
        var stmts = stmt["stmts"]
        var i = 0
        while stmts != nil && i < oren_list_len(stmts) {
            function_yield_info_walk_stmt(info, stmts[i])
            i = i + 1
        }
        return nil
    }
    if ty == "If" {
        function_yield_info_walk_stmt(info, stmt["consq"])
        if stmt["alt"] != nil {
            function_yield_info_walk_stmt(info, stmt["alt"])
        }
        return nil
    }
    if ty == "While" {
        function_yield_info_walk_stmt(info, stmt["body"])
        return nil
    }
    if ty == "For" {
        if stmt["init"] != nil { function_yield_info_walk_stmt(info, stmt["init"]) }
        if stmt["post"] != nil { function_yield_info_walk_stmt(info, stmt["post"]) }
        function_yield_info_walk_stmt(info, stmt["body"])
        return nil
    }
    if ty == "Function" { return nil }
    if ty == "ExprStmt" {
        var expr = stmt["expr"]
        if expr != nil && expr["type"] == "Function" { return nil }
        if expr != nil && expr["type"] == "If" {
            function_yield_info_walk_stmt(info, expr["consq"])
            if expr["alt"] != nil {
                function_yield_info_walk_stmt(info, expr["alt"])
            }
            return nil
        }
        if expr != nil && expr["type"] == "Block" {
            function_yield_info_walk_stmt(info, expr)
            return nil
        }
        return nil
    }
    return nil
}

fn function_yield_info(func) {
    var info = new_function_yield_info()
    if func == nil { return info }
    function_yield_info_walk_stmt(info, func["body"])
    info["yield_lowering"] = function_yield_lowering_plan(info, function_yield_locals_across(func))
    return info
}

fn function_yield_lowering_plan(info, locals_across_yield) {
    if info == nil { return nil }
    var sites = info["yield_stmt_sites"]
    if sites == nil || oren_list_len(sites) == 0 { return nil }

    var yield_points = []
    var states = []
    oren_list_push(states, {"id": 0, "kind": "entry"})

    var i = 0
    while i < oren_list_len(sites) {
        var site = sites[i]
        var resume_state = i + 1
        oren_list_push(yield_points, {"id": i, "site": site, "resume_state": resume_state})
        oren_list_push(states, {"id": resume_state, "kind": "resume", "after_yield_site": site})
        i = i + 1
    }

    return {
        "version": 1,
        "surface": "bare_statement_only",
        "entry_state": 0,
        "state_count": oren_list_len(states),
        "locals_across_yield": locals_across_yield,
        "yield_points": yield_points,
        "states": states,
    }
}
