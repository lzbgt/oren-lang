// native_platform_prune.oren
//
// Target-specific pruning for injected native runtime code.
//
// Motivation:
// - The injected native runtime is a single portable source that branches on `g_target_os`.
// - For a *targeted* native build (e.g. x64-linux), those branches are compile-time constants.
// - Pruning unreachable `if g_target_os == ...` / `!= ...` branches makes binaries smaller and
//   avoids compiling dead platform code paths.
//
// Scope:
// - Only prunes statements inside runtime-tagged top-level Function statements
//   (stmt["__oren_from_runtime"] == true).
// - Conservative: only folds simple comparisons against integer literals.

import intparse "int_lit.oren"

fn _os_id_from_platform(platform) {
    if platform == nil { return 0 }
    var os = platform["os"]
    if os == "macos" { return 1 }
    if os == "linux" { return 2 }
    if os == "windows" { return 3 }
    return 0
}

fn _count_prunable_target_os_ifs_in_stmt(stmt, os_id) {
    if stmt == nil { return 0 }
    var t = stmt["type"]
    var out = 0

    if t == "If" {
        var v = _eval_cond_is_target_os(stmt["cond"], os_id)
        if v == 1 || v == -1 { out = 1 }
        out = out + _count_prunable_target_os_ifs_in_stmt(stmt["consq"], os_id)
        if stmt["alt"] != nil { out = out + _count_prunable_target_os_ifs_in_stmt(stmt["alt"], os_id) }
        return out
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            var v2 = _eval_cond_is_target_os(e["cond"], os_id)
            if v2 == 1 || v2 == -1 { out = 1 }
            out = out + _count_prunable_target_os_ifs_in_stmt(e["consq"], os_id)
            if e["alt"] != nil { out = out + _count_prunable_target_os_ifs_in_stmt(e["alt"], os_id) }
            return out
        }
        return 0
    }
    if t == "Block" {
        var xs = stmt["stmts"]
        if xs == nil { return 0 }
        var i = 0
        while i < oren_list_len(xs) {
            out = out + _count_prunable_target_os_ifs_in_stmt(xs[i], os_id)
            i = i + 1
        }
        return out
    }
    if t == "While" {
        return _count_prunable_target_os_ifs_in_stmt(stmt["body"], os_id)
    }
    if t == "For" {
        if stmt["init"] != nil { out = out + _count_prunable_target_os_ifs_in_stmt(stmt["init"], os_id) }
        if stmt["post"] != nil { out = out + _count_prunable_target_os_ifs_in_stmt(stmt["post"], os_id) }
        out = out + _count_prunable_target_os_ifs_in_stmt(stmt["body"], os_id)
        return out
    }
    if t == "FnDecl" {
        return _count_prunable_target_os_ifs_in_stmt(stmt["body"], os_id)
    }

    return 0
}

fn _expr_is_ident_named(expr, name) {
    if expr == nil { return false }
    if expr["type"] != "Identifier" { return false }
    return expr["value"] == name
}

fn _expr_parse_int_lit(expr) {
    // IMPORTANT (native runtime): do not return `nil` as a sentinel for failure.
    // `nil/false/0` collapse to 0 today, so a literal value of 0 must still be representable.
    if expr == nil { return oren_err(8, "expected Integer expr") }
    if expr["type"] != "Integer" { return oren_err(8, "expected Integer expr") }
    return intparse.parse_int_lit(expr["value"])
}

fn _eval_cond_is_target_os(cond, os_id) {
    // Returns a tri-state integer:
    // -  1: condition is provably true
    // - -1: condition is provably false
    // -  0: unknown / cannot prove
    //
    // IMPORTANT (native runtime / stage2-native):
    // Do NOT use `nil` as the "unknown" sentinel here.
    // Today `nil/false/0` collapse to 0 under the native runtime model, so comparisons like
    // `v == false` will treat `nil` as false and can incorrectly prune non-target branches.
    if cond == nil { return 0 }
    var t = cond["type"]
    if t == "Boolean" {
        if cond["value"] == true { return 1 }
        return -1
    }
    if t == "Prefix" {
        if cond["op"] != "!" { return 0 }
        var v = _eval_cond_is_target_os(cond["right"], os_id)
        if v == 0 { return 0 }
        if v == 1 { return -1 }
        return 1
    }
    if t != "Infix" { return 0 }
    
    var op = cond["op"]
    if op != "==" && op != "!=" { return 0 }
    
    var left = cond["left"]
    var right = cond["right"]
    
    var lit = nil
    if _expr_is_ident_named(left, "g_target_os") {
        lit = _expr_parse_int_lit(right)
    } else if _expr_is_ident_named(right, "g_target_os") {
        lit = _expr_parse_int_lit(left)
    } else {
        return 0
    }
    if oren_is_err(lit) { return 0 }
    
    var eq = (os_id == lit)
    var ok = eq
    if op == "!=" { ok = !eq }
    if ok == true { return 1 }
    return -1
}

fn _prune_stmt_keep_one(stmt, os_id) {
    var xs = _prune_stmt(stmt, os_id)
    if xs == nil || oren_list_len(xs) == 0 {
        return {"type": "Block", "stmts": []}
    }
    if oren_list_len(xs) == 1 {
        return xs[0]
    }
    return {"type": "Block", "stmts": xs}
}

fn _prune_stmt_list(stmts, os_id) {
    if stmts == nil { return [] }
    var out = []
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        var xs = _prune_stmt(st, os_id)
        var j = 0
        while xs != nil && j < oren_list_len(xs) {
            oren_list_push(out, xs[j])
            j = j + 1
        }
        i = i + 1
    }
    return out
}

fn _prune_stmt(stmt, os_id) {
    // Returns a list of statements to splice at the current level.
    if stmt == nil { return [] }
    var t = stmt["type"]

    if t == "ExprStmt" {
        // Some front-end lowering forms represent control-flow as an expression that is
        // wrapped in an ExprStmt. Prune platform-constant `if g_target_os ...` forms here too.
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            var v0 = _eval_cond_is_target_os(e["cond"], os_id)
            if v0 == 1 {
                return _prune_stmt(e["consq"], os_id)
            }
            if v0 == -1 {
                if e["alt"] != nil { return _prune_stmt(e["alt"], os_id) }
                return []
            }
            // Unknown condition: prune inside both branches.
            e["consq"] = _prune_stmt_keep_one(e["consq"], os_id)
            if e["alt"] != nil {
                e["alt"] = _prune_stmt_keep_one(e["alt"], os_id)
            }
            return [stmt]
        }
        return [stmt]
    }

    if t == "Block" {
        var ss = stmt["stmts"]
        stmt["stmts"] = _prune_stmt_list(ss, os_id)
        return [stmt]
    }

    if t == "If" {
        var v = _eval_cond_is_target_os(stmt["cond"], os_id)
        if v == 1 {
            return _prune_stmt(stmt["consq"], os_id)
        }
        if v == -1 {
            if stmt["alt"] != nil { return _prune_stmt(stmt["alt"], os_id) }
            return []
        }
        // Unknown condition: prune inside both branches.
        stmt["consq"] = _prune_stmt_keep_one(stmt["consq"], os_id)
        if stmt["alt"] != nil {
            stmt["alt"] = _prune_stmt_keep_one(stmt["alt"], os_id)
        }
        return [stmt]
    }

    if t == "While" {
        stmt["body"] = _prune_stmt_keep_one(stmt["body"], os_id)
        return [stmt]
    }

    if t == "For" {
        if stmt["init"] != nil { stmt["init"] = _prune_stmt_keep_one(stmt["init"], os_id) }
        if stmt["post"] != nil { stmt["post"] = _prune_stmt_keep_one(stmt["post"], os_id) }
        stmt["body"] = _prune_stmt_keep_one(stmt["body"], os_id)
        return [stmt]
    }

    if t == "FnDecl" {
        // Local fn declarations (inside blocks) are rewritten to lambdas+vars later.
        // Still prune the body now so dead platform branches don't survive into codegen.
        stmt["body"] = _prune_stmt_keep_one(stmt["body"], os_id)
        return [stmt]
    }

    // Other stmt kinds: keep as-is.
    return [stmt]
}

fn prune_runtime_os_branches_in_linked_program_in_place(linked, platform) {
    if linked == nil { return nil }
    var os_id = _os_id_from_platform(platform)
    if os_id == 0 { return nil }

    var stmts = linked["statements"]
    if stmts == nil { stmts = [] }

    // Record a cheap "pruned for target OS" marker on the program so cache loaders can
    // skip redundant pruning and can detect stale/unpruned cache files.
    //
    // This relies on astbin encoding preserving unknown top-level keys (program is a map).
    linked["__oren_pruned_target_os_id"] = os_id
    linked["__oren_pruned_target_os_kind"] = "g_target_os"
    // Bump this when pruning behavior changes in a way that makes old pruned caches unsafe.
    // (Unlike runtime source text changes, pruning bugs can change emitted code without changing
    // the cache key input; stale pruned ASTs can mask correctness regressions.)
    linked["__oren_pruned_target_os_cache_gen"] = 3

    var trace = oren_env("OREN_TRACE_RUNTIME_OS_PRUNE") != nil
    var before = 0
    if trace {
        var bi = 0
        while bi < oren_list_len(stmts) {
            var st0 = stmts[bi]
            if st0 != nil && st0["__oren_from_runtime"] != nil {
                if st0["type"] == "Function" {
                    before = before + _count_prunable_target_os_ifs_in_stmt(st0["body"], os_id)
                } else if st0["type"] == "ExprStmt" {
                    var e0 = st0["expr"]
                    if e0 != nil && e0["type"] == "Function" {
                        before = before + _count_prunable_target_os_ifs_in_stmt(e0["body"], os_id)
                    }
                }
            }
            bi = bi + 1
        }
    }

    var out = []
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st != nil && st["__oren_from_runtime"] != nil {
            // Runtime top-level functions can appear as:
            // - {type:"Function", body:...}
            // - {type:"ExprStmt", expr:{type:"Function", body:...}}
            //
            // Keep this pruning pass robust to both shapes so it works across the
            // runtime bundle cache, injection, and rtobj build paths.
            if st["type"] == "Function" {
                st["body"] = _prune_stmt_keep_one(st["body"], os_id)
            } else if st["type"] == "ExprStmt" {
                var e = st["expr"]
                if e != nil && e["type"] == "Function" {
                    e["body"] = _prune_stmt_keep_one(e["body"], os_id)
                }
            }
        }
        oren_list_push(out, st)
        i = i + 1
    }
    linked["statements"] = out

    if trace {
        var after = 0
        var ai = 0
        while ai < oren_list_len(out) {
            var st1 = out[ai]
            if st1 != nil && st1["__oren_from_runtime"] != nil {
                if st1["type"] == "Function" {
                    after = after + _count_prunable_target_os_ifs_in_stmt(st1["body"], os_id)
                } else if st1["type"] == "ExprStmt" {
                    var e1 = st1["expr"]
                    if e1 != nil && e1["type"] == "Function" {
                        after = after + _count_prunable_target_os_ifs_in_stmt(e1["body"], os_id)
                    }
                }
            }
            ai = ai + 1
        }
        print("[pprune] g_target_os prune os_id=" + oren_int_to_string(os_id) +
              " before=" + oren_int_to_string(before) +
              " after=" + oren_int_to_string(after))
    }
    return nil
}
