// Delegate statement compilation to the stmt module.
fn native_compile_stmt(ctx, stmt) { return stmtm.native_compile_stmt(ctx, stmt) }

fn native_diag_escape(msg) {
    if msg == nil { return "" }
    var out = ""
    var n = oren_string_len(msg)
    var i = 0
    while i < n {
        var c = oren_string_char_at(msg, i)
        if c == "\n" { out = out + "\\n"; i = i + 1; continue }
        if c == "\r" { out = out + "\\r"; i = i + 1; continue }
        if c == "\t" { out = out + "\\t"; i = i + 1; continue }
        out = out + c
        i = i + 1
    }
    return out
}

fn native_env_str_eq(a, b) {
    // Avoid depending on runtime string equality semantics in compiler hot paths.
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _native_str_contains_bytes(hay, needle) {
    // Byte-based substring search for ASCII-ish strings (paths, env vars).
    // Returns true if `needle` occurs in `hay`.
    if hay == nil || needle == nil { return false }
    var n = oren_string_len(hay)
    var m = oren_string_len(needle)
    if m == 0 { return true }
    if m > n { return false }
    var i = 0
    while i <= (n - m) {
        var j = 0
        while j < m {
            if (oren_string_byte_at_unchecked(hay, i + j) & 255) != (oren_string_byte_at_unchecked(needle, j) & 255) { break }
            j = j + 1
        }
        if j == m { return true }
        i = i + 1
    }
    return false
}

fn _arm64_should_use_full_native_runtime_profile(linked) {
    // Default runtime injection profile heuristic (rolling, perf-oriented):
    // - Prefer the smaller core profile for typical programs to keep cold rtobj misses bounded.
    // - Escalate to the full profile when program dependencies imply runtime networking is needed.
    //
    // NOTE: This intentionally uses the module graph (import closure), not deep AST scanning,
    // to keep the decision fast and deterministic.
    if linked == nil { return true } // safe default
    var g = linked["module_graph"]
    if g == nil { return true } // safe default

    // std:linalg reaches the full typed-buffer runtime surface (`oren_buf_dot_f64`,
    // GEMM helpers, etc.). The core runtime profile intentionally keeps only the
    // small typed-buffer subset, so linalg imports must escalate deterministically.
    var entry = g["entry"]
    if _native_str_contains_bytes(entry, "/lib/std/linalg") ||
       _native_str_contains_bytes(entry, "lib/std/linalg") ||
       _native_str_contains_bytes(entry, "\\lib\\std\\linalg") ||
       _native_str_contains_bytes(entry, "lib\\std\\linalg") { return true }

    // Any module under `lib/std/net/` needs the full runtime profile today because std:net calls
    // runtime primitives (`oren_tcp_*`, `oren_udp_*`, `oren_select_*`, `oren_net_get`).
    //
    // NOTE: module graph paths can be absolute (common on macOS/Linux) or repo-relative
    // (common when running from extracted bundles / remote shells). Match both.
    if _native_str_contains_bytes(entry, "/lib/std/net/") ||
       _native_str_contains_bytes(entry, "lib/std/net/") ||
       _native_str_contains_bytes(entry, "\\lib\\std\\net\\") ||
       _native_str_contains_bytes(entry, "lib\\std\\net\\") { return true }

    var mods = g["modules"]
    if mods == nil { return false }
    var mods_len = oren_list_len(mods)
    var i = 0
    while i < mods_len {
        var m = mods[i]
        if m != nil {
            var p = m["path"]
            if _native_str_contains_bytes(p, "/lib/std/linalg") ||
               _native_str_contains_bytes(p, "lib/std/linalg") ||
               _native_str_contains_bytes(p, "\\lib\\std\\linalg") ||
               _native_str_contains_bytes(p, "lib\\std\\linalg") { return true }
            if _native_str_contains_bytes(p, "/lib/std/net/") ||
               _native_str_contains_bytes(p, "lib/std/net/") ||
               _native_str_contains_bytes(p, "\\lib\\std\\net\\") ||
               _native_str_contains_bytes(p, "lib\\std\\net\\") { return true }
        }
        i = i + 1
    }
    return false
}

fn native_emit_errors_and_exit(ctx) {
    if ctx == nil { return nil }
    if ctx["errors"] == nil { return nil }
    if oren_list_len(ctx["errors"]) == 0 { return nil }
    var first = ctx["errors"][0]
    print("OREN_DIAG kind=codegen code=1 msg=" + native_diag_escape(first))
    print("native backend errors:")
    var errors_len = oren_list_len(ctx["errors"])
    var ei = 0
    while ei < errors_len {
        print(ctx["errors"][ei])
        ei = ei + 1
    }
    oren_exit(1)
    return nil
}

fn _arm64_linked_has_toplevel_fn_named(linked, name) {
    if linked == nil || name == nil { return false }
    var stmts = linked["statements"]
    if stmts == nil { return false }
    var stmts_len = oren_list_len(stmts)
    var i = 0
    while i < stmts_len {
        var fn0 = coreir._stmt_to_function_decl(stmts[i])
        if fn0 != nil && fn0["name"] == name { return true }
        i = i + 1
    }
    return false
}
