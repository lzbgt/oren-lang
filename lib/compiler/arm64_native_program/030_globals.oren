// ARM64 native program compiler: globals + top-level preparation.
//
// Global slot allocation and __top_level__ synthesis.

fn _arm64_alloc_global_slot(ctx, name_node, init_expr, from_runtime) {
    if ctx == nil { return nil }
    if name_node == nil || name_node["type"] != "Identifier" {
        oren_list_push(ctx["errors"], "arm64 native: global var name must be identifier")
        return nil
    }
    var nm = name_node["value"]
    if nm == nil || nm == "" {
        oren_list_push(ctx["errors"], "arm64 native: global var name is empty")
        return nil
    }
    if nm == "__top_level__" {
        oren_list_push(ctx["errors"], "arm64 native: reserved global name __top_level__")
        return nil
    }
    if ctx["globals"] != nil && ctx["globals"][nm] != nil {
        var msg = "arm64 native: duplicate global var " + nm
        if from_runtime == true { msg = "arm64 native: runtime global var conflicts with existing global " + nm }
        oren_list_push(ctx["errors"], msg)
        return nil
    }

    // Globals live in `.data` as 8-byte slots. Do not rely on runtime execution order to
    // initialize them; the entry stub calls `__top_level__` before `main` to handle user
    // initializers deterministically.
    _arm64_data_align8(ctx)
    var data_off = bytes_len(ctx["data"])
    bytes_extend_zeros(ctx["data"], 8)
    // Store as offset+1 so a real offset of 0 is representable while still using `nil`
    // as the map sentinel for "missing/uninitialized" (call sites decode with `enc-1`).
    ctx["globals"][nm] = data_off + 1
    if ctx["global_root_names"] != nil { oren_list_push(ctx["global_root_names"], nm) }
    if ctx["global_root_offsets"] != nil { oren_list_push(ctx["global_root_offsets"], data_off) }
    if ctx["global_root_is_runtime"] != nil { oren_list_push(ctx["global_root_is_runtime"], from_runtime == true) }

    var is_floaty = exprm.native_expr_is_floaty(ctx, init_expr)
    var is_inty = exprm.native_expr_is_inty_with_floaty(ctx, init_expr, is_floaty)
    var is_stringy = exprm.native_expr_is_stringy(ctx, init_expr)
    var is_list_stringy = exprm.native_expr_is_list_stringy(ctx, init_expr)
    if ctx["globals_floaty"] != nil { ctx["globals_floaty"][nm] = is_floaty }
    if ctx["globals_inty"] != nil { ctx["globals_inty"][nm] = is_inty }
    if ctx["globals_stringy"] != nil { ctx["globals_stringy"][nm] = is_stringy }
    if ctx["globals_list_stringy"] != nil { ctx["globals_list_stringy"][nm] = is_list_stringy }
    return nm
}

fn _arm64_top_level_static_int_preinit_enabled() {
    var mode = oren_env("OREN_NATIVE_GAS_ACCOUNTING")
    if mode == nil || mode == "" || mode == "0" || mode == "loop" { return true }
    if mode == "stmt" || mode == "statement" { return false }
    if mode == "basic-block" || mode == "block-weighted" { return false }
    if mode == "dynamic-emitter" { return false }
    return true
}

fn _arm64_is_plain_integer_literal(expr) {
    return expr != nil && expr["type"] == "Integer"
}

fn _arm64_preinit_global_int_literal(ctx, name_node, init_expr) {
    if ctx == nil || name_node == nil || init_expr == nil { return false }
    if name_node["type"] != "Identifier" || init_expr["type"] != "Integer" { return false }
    var nm = name_node["value"]
    if nm == nil || nm == "" || ctx["globals"] == nil { return false }
    var data_off = ctx["globals"][nm] - 1
    var iv = core.int_from_string(init_expr["value"])
    bytes_set_u64_le(ctx["data"], data_off, iv)
    if ctx["globals_int_const"] != nil {
        ctx["globals_int_const"][nm] = iv
    }
    return true
}

fn _arm64_prepare_top_level_and_globals(ctx, runtime_stmts, user_stmts) {
    // Normalize entry semantics for Tier‑1 native (arm64 parity with x86_64 + docs):
    // - Collect top-level globals (`var`) into `.data` slots
    // - Synthesize `fn __top_level__(){...}` that runs:
    //   - user global initializers (as Assign to globals)
    //   - user top-level executable statements
    // - Entry stub calls `__top_level__` before `main` (if present).
    //
    // IMPORTANT (runtime):
    // The injected native runtime is treated as a library. Its side effects must be driven by
    // `native_runtime_init` (and explicit runtime calls), not by implicit top-level execution.
    // Therefore we allocate runtime global slots but do NOT run their initializers in __top_level__.
    if ctx == nil { return nil }

    var declared = ctx["declared_functions"]
    var split = nt.split_tier1_runtime_user(ctx, "arm64 native", runtime_stmts, user_stmts, declared)
    if split == nil { return nil }

    var runtime_decls = split["runtime_decls"]
    var runtime_vars = split["runtime_vars"]
    var user_decls = split["user_decls"]
    var user_vars = split["user_vars"]
    var user_exec = split["user_exec"]
    var user_ordered = split["user_ordered"]
    if runtime_decls == nil { runtime_decls = [] }
    if runtime_vars == nil { runtime_vars = [] }
    if user_decls == nil { user_decls = [] }
    if user_vars == nil { user_vars = [] }
    if user_exec == nil { user_exec = [] }
    if user_ordered == nil { user_ordered = [] }

    if ctx["runtime_globals"] == nil { ctx["runtime_globals"] = {} }
    var runtime_globals = ctx["runtime_globals"]
    var v_trace_names = oren_env("OREN_TRACE_GC_REGISTER_ROOT_NAMES")
    if v_trace_names != nil && v_trace_names != "" &&
       native_env_str_eq(v_trace_names, "0") != true &&
       native_env_str_eq(v_trace_names, "false") != true {
        ctx["trace_gc_root_names"] = 1
    }
    var v_skip = oren_env("OREN_GC_ROOTS_SKIP_RUNTIME_GLOBALS")
    if v_skip != nil && v_skip != "" &&
       native_env_str_eq(v_skip, "0") != true &&
       native_env_str_eq(v_skip, "false") != true {
        ctx["skip_runtime_global_roots"] = 1
    }
    var ri = 0
    while ri < oren_list_len(runtime_vars) {
        var rst = runtime_vars[ri]
        if rst != nil && rst["name"] != nil {
            var rnm = rst["name"]["value"]
            if rnm != nil { runtime_globals[rnm] = true }
        }
        ri = ri + 1
    }

    // Allocate runtime globals (zero-initialized; runtime init owns their values).
    var i = 0
    while i < oren_list_len(runtime_vars) {
        var st = runtime_vars[i]
        if st != nil {
            // `g_storage` is reserved in the native entry stub `.data` prefix (Tier‑1 bootstrap).
            var nm_pre = nil
            if st["name"] != nil { nm_pre = st["name"]["value"] }
            if nm_pre == "g_storage" && ctx["globals"] != nil && ctx["globals"][nm_pre] != nil {
                i = i + 1
                continue
            }
            _arm64_alloc_global_slot(ctx, st["name"], st["value"], true)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        }
        i = i + 1
    }

    var static_int_preinit = _arm64_top_level_static_int_preinit_enabled()

    // Allocate user globals; defer effectful initializers into __top_level__.
    i = 0
    while i < oren_list_len(user_vars) {
        var st2 = user_vars[i]
        if st2 != nil {
            _arm64_alloc_global_slot(ctx, st2["name"], st2["value"], false)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            if static_int_preinit && _arm64_is_plain_integer_literal(st2["value"]) {
                _arm64_preinit_global_int_literal(ctx, st2["name"], st2["value"])
            }
        }
        i = i + 1
    }

    // Synthesize: `fn __top_level__() { <stmts in source order>; return 0 }`
    //
    // IMPORTANT:
    // Preserve source order across `var` initializers and executable top-level statements.
    // We rewrite `var x = expr` into a global-slot assignment at the same position.
    var top_stmts = []
    var j = 0
    while j < oren_list_len(user_ordered) {
        var stx = user_ordered[j]
        if stx != nil && stx["type"] == "Var" {
            if static_int_preinit && _arm64_is_plain_integer_literal(stx["value"]) {
                // Plain integer literals are side-effect-free and were already written into `.data`.
            } else {
                // Execute global initializer in-order. Keep the precomputed global
                // carrier trait so startup lowering cannot downgrade float-return
                // initializers before later top-level comparisons read the slot.
                var init_assign = {"type": "Assign", "token": stx["token"], "name": stx["name"], "value": stx["value"]}
                init_assign["__oren_top_level_global_init"] = true
                oren_list_push(top_stmts, init_assign)
            }
        } else {
            oren_list_push(top_stmts, stx)
        }
        j = j + 1
    }
    oren_list_push(top_stmts, {"type": "Return", "token": nil, "value": {"type": "Integer", "value": "0"}})

    var top_fn = {"type": "Function", "token": nil, "name": "__top_level__", "params": [], "body": {"type": "Block", "stmts": top_stmts}}
    var top_stmt = {"type": "ExprStmt", "token": nil, "expr": top_fn}
    return {"runtime_decls": runtime_decls, "user_decls": user_decls, "top_stmt": top_stmt}
}
