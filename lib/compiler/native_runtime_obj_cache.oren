// native_runtime_obj_cache.oren
//
// Compiled native runtime cache ("runtime object") for native backends.
//
// Motivation (rolling, Tier‑1 throughput):
// - Injecting + compiling `lib/runtime_native.oren` dominates stage2-native build time.
// - Caching the parsed runtime AST (astbin) helps, but decoding + compiling hundreds of
//   runtime decls still costs many seconds per build.
// - Caching a backend-specific "runtime object" makes "compile one file" not pay the full
//   runtime cost on every invocation.
//
// Safety / policy (rolling):
// - The rtobj cache stores compiled machine code for the injected runtime.
// - This is a build-time throughput feature; the cache lives on the host filesystem.
// - Capsule builds still run *compiled binaries* under capsule restrictions; using an rtobj
//   cache at compile time does not weaken the runtime capsule boundary.
//
// Historically this was disabled for capsule builds by default. That made the Tier‑1 capsule
// smoke test pay a full "compile runtime decls" cold path and regularly exceed the default
// 10s build timeout. Enable rtobj for capsule builds by default and keep an explicit opt-out
// knob for experiments.

import rtinj "native_runtime_inject.oren"
import astbin "astbin.oren"
import bytes "bytes_builder.oren"

// Schema version for on-disk runtime object cache format.
//
// IMPORTANT (stage2-native throughput):
// Avoid using SHA-256 of the full expanded runtime source as the cache key input, because the
// native runtime's pure-Oren SHA-256 implementation is much slower than the C backend and can
// dominate “compile one file” even on cache hits (the hash is required just to find the cache dir).
//
// Schema v2 switches the cache key input to a fast 63-bit FNV-1a-style fingerprint (two lanes)
// so repeated builds can find cached runtime objects without spending seconds hashing the runtime.
var RUNTIME_OBJ_SCHEMA = 2
// Container version for rtobj meta checksum sidecar.
// Used to avoid fatal astbin decode on corrupted/partial meta files.
var RUNTIME_OBJ_META_CHECK_VERSION = 1
var RUNTIME_OBJ_META_CHECK_MAGIC0 = 82 // 'R'
var RUNTIME_OBJ_META_CHECK_MAGIC1 = 84 // 'T'
var RUNTIME_OBJ_META_CHECK_MAGIC2 = 77 // 'M'
var RUNTIME_OBJ_META_CHECK_MAGIC3 = 67 // 'C'
var RUNTIME_OBJ_META_CHECK_LEN = 20
// Native entry stub `.data` prefix (must be identical across:
// - main program compilation
// - runtime object compilation
// - runtime object cache load/apply)
//
// Layout (rolling, Tier‑1 bootstrap):
// - 0..7:   cstr0 table slot (u64 offset)
// - 8..15:  g_storage global slot (u64 pointer to globals storage)
// - 16..527: boot globals storage blob (512 bytes; holds nil/bool singleton slots)
// - 528..535: heap_limit spill slot (u64; ABI bridge for exported functions)
// - 536..543: heap_ptr spill slot (u64; ABI bridge for exported functions)
var RUNTIME_OBJ_DATA_PREFIX_LEN = 544

// Backend signature for the compiled runtime object cache key.
//
// IMPORTANT:
// The runtime object cache stores *compiled machine code* for the injected runtime.
// Therefore, changes to backend codegen (instruction selection/encoding, ABI layout,
// call-area sizing, syscall/Win32 intrinsic lowering, etc) MUST invalidate the cache,
// even when the runtime source text is unchanged.
//
// Rolling contract:
// - Bump the relevant backend sig whenever a change can affect emitted code/data bytes.
// - This is intentionally cheap (string constant) so cache hits stay fast.
// Backend signature for runtime-object cache keys.
//
// Bump this whenever native codegen changes in a way that affects the emitted
// runtime object code, otherwise stale rtobj cache entries can keep old
// semantics even after recompiling the compiler.
//
// 2026-01: v0_9
// - Fix Linux/arm64 syscall lowering bug that emitted an *undefined* MOVK instruction
//   (incorrect shift field usage in sys_ulock_wake → futex wake-all path).
// - Fix Linux/arm64 clone(2) syscall ABI arg order and make sys_thread_create safe
//   w.r.t. child stack switching (child must not restore parent SP-saved regs).
// 2026-04: v0_14
// - Add native run JSON exit-hook emission to the arm64 entry tail.
// 2026-04: v0_16
// - Add arm64 backend loop-safepoint gas note calls for native-run budget evidence.
// 2026-04: v0_17
// - Add opt-in arm64 statement/op gas notes for native package-policy budget evidence.
var RUNTIME_OBJ_BACKEND_SIG_ARM64 = "arm64_v0_17"
// 2026-01: v0_17
// - Fix Tier‑1 Windows correctness for runtime-owned OS threads (`oren_os_thread_spawn`):
//   `native_call1(addr, arg0)` must follow the active x64 ABI arg-register mapping (SysV vs Win64)
//   so indirect calls to code pointers pass arg0 correctly on x64-windows.
// - Invalidate stale x64 runtime objects that were built before `native_call1` was routed through the
//   intrinsic emitter (it was incorrectly short-circuited as a generic `native_*` call, executing the
//   prelude stub body and breaking Windows OS-thread bring-up).
// 2026-04: v0_23
// - Add x64 compact runtime-object function offsets, alongside compact fixup metadata, so
//   stage2 cache hits do not walk large runtime metadata maps before compiling user code.
// 2026-04: v0_24
// - Add native run JSON exit-hook emission to the x64 Linux/Windows entry tails.
// 2026-04: v0_26
// - Add x64 backend loop-safepoint gas note calls for native-run budget evidence.
// 2026-04: v0_27
// - Add opt-in x64 statement/op gas notes for native package-policy budget evidence.
var RUNTIME_OBJ_BACKEND_SIG_X64 = "x64_v0_27"

fn rtobj_backend_sig(backend) {
    if backend == "arm64" { return RUNTIME_OBJ_BACKEND_SIG_ARM64 }
    if backend == "x64" { return RUNTIME_OBJ_BACKEND_SIG_X64 }
    // Unknown backend: keep key deterministic but force isolation.
    return "unknown_v0"
}

fn _is_false(v) {
    if v == nil || v == "" { return false }
    if v == "0" || v == "false" { return true }
    return false
}

fn rtobj_cache_enabled(platform) {
    // Capsule builds:
    // - Default-on (Tier‑1 throughput): avoids slow cold runtime compilation paths.
    // - Opt-out via:
    //     OREN_NATIVE_RUNTIME_OBJ_CACHE_CAPSULE=0   (or "false")
    if platform != nil && platform["capsule"] == true {
        var vcap = oren_env("OREN_NATIVE_RUNTIME_OBJ_CACHE_CAPSULE")
        if _is_false(vcap) { return false }
        // otherwise: allow (including unset/empty)
    }
    var v = oren_env("OREN_NATIVE_RUNTIME_OBJ_CACHE")
    if _is_false(v) { return false }
    return true
}

fn _rtobj_key_find(s, needle, start) {
    if s == nil || needle == nil { return -1 }
    var n = oren_string_len(s)
    var m = oren_string_len(needle)
    if m == 0 { return start }
    if start < 0 { start = 0 }
    if start + m > n { return -1 }
    // Avoid allocating substrings and avoid depending on runtime string equality semantics.
    var i = start
    while i + m <= n {
        var j = 0
        var ok = 1
        while j < m {
            var a = oren_string_byte_at_unchecked(s, i + j) & 255
            var b = oren_string_byte_at_unchecked(needle, j) & 255
            if a != b { ok = 0; break }
            j = j + 1
        }
        if ok == 1 { return i }
        i = i + 1
    }
    return -1
}

fn _rtobj_string_eq(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    if oren_type_tag(a) != 4 { return false }
    if oren_type_tag(b) != 4 { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        var ba = oren_string_byte_at_unchecked(a, i) & 255
        var bb = oren_string_byte_at_unchecked(b, i) & 255
        if ba != bb { return false }
        i = i + 1
    }
    return true
}

fn _rtobj_env_enabled(name) {
    var v = oren_env(name)
    if v == nil || v == "" { return false }
    if _rtobj_string_eq(v, "0") { return false }
    if _rtobj_string_eq(v, "false") { return false }
    return true
}

fn _rtobj_runtime_hash_opts() {
    // Salt the runtime hash with compile-time knobs that change native codegen.
    // Keep tags short to preserve filesystem-friendly cache keys.
    var opts = ""
    if _rtobj_env_enabled("OREN_TRACE_NATIVE_ALLOC_REQ") {
        if opts != "" { opts = opts + "," }
        opts = opts + "alloc_req"
    }
    if _rtobj_env_enabled("OREN_TRACE_NATIVE_LIST_HDR") {
        if opts != "" { opts = opts + "," }
        opts = opts + "list_hdr"
    }
    if _rtobj_env_enabled("OREN_TRACE_NATIVE_LIST_RESERVE") {
        if opts != "" { opts = opts + "," }
        opts = opts + "list_reserve"
    }
    return opts
}

fn _rtobj_key_extract_between(key, a, b) {
    if key == nil { return "" }
    if a < 0 || b < 0 { return "" }
    if b < a { return "" }
    return oren_string_slice(key, a, b)
}

fn _rtobj_key_extract_rh(key) {
    // Return substring after "_rh_" (or "" if missing).
    var m = "_rh_"
    var i = _rtobj_key_find(key, m, 0)
    if i < 0 { return "" }
    return oren_string_slice(key, i + oren_string_len(m), oren_string_len(key))
}

fn _rtobj_key_extract_bv(key) {
    // Return backend sig substring between "_bv_" and "_os_" (or "" if missing).
    var a0 = _rtobj_key_find(key, "_bv_", 0)
    if a0 < 0 { return "" }
    var a = a0 + 4
    var b0 = _rtobj_key_find(key, "_os_", a)
    if b0 < 0 { return "" }
    return _rtobj_key_extract_between(key, a, b0)
}

fn _rtobj_meta_match_or_migrate_key_fields(key, meta) {
    // Return:
    // - 1: ok (matches key)
    // - 2: ok, but migrated meta in-place (was missing fields)
    // - 0: mismatch / invalid
    //
    // Rationale:
    // - Older caches may not include `runtime_hash`/`backend_sig` fields.
    // - Rebuilding a full runtime object can exceed the default 10s timeout gates (Tier‑1),
    //   so we migrate these fields from the key as a cheap best-effort compatibility layer.
    if meta == nil { return 0 }
    var want_rh = _rtobj_key_extract_rh(key)
    var want_bv = _rtobj_key_extract_bv(key)
    if want_rh == "" || want_bv == "" { return 0 }

    var mh = meta["runtime_hash"]
    var mbv = meta["backend_sig"]
    if mh == nil || mbv == nil {
        meta["runtime_hash"] = want_rh
        meta["backend_sig"] = want_bv
        return 2
    }
    // Do not rely on `==` for strings here: this check must be stable across stage1 (C runtime)
    // and stage2 (native runtime) when decoding an astbin-encoded meta file.
    if _rtobj_string_eq(mh, want_rh) != true { return 0 }
    if _rtobj_string_eq(mbv, want_bv) != true { return 0 }
    return 1
}

fn rtobj_cache_dir() {
    var v = oren_env("OREN_NATIVE_RUNTIME_OBJ_CACHE_DIR")
    if v == nil || v == "" { return "build/cache/native_runtime_obj" }
    return v
}

fn rtobj_seed_dir() {
    // Optional "seed" runtime-object bundle, used when the regular rtobj cache is empty.
    //
    // This is the native-backend equivalent of shipping a precompiled "sysroot"/stdlib:
    // it makes first-run `oren build ... --backend native` fast without forcing a full
    // runtime decl compilation on the first invocation.
    //
    // Disable by setting:
    //   OREN_NATIVE_RUNTIME_OBJ_SEED_DIR=0   (or "false")
    //
    // Default location is build-local so it can be generated by `make stage2` tooling.
    var v = oren_env("OREN_NATIVE_RUNTIME_OBJ_SEED_DIR")
    if v == nil || v == "" { return "build/cache/native_runtime_obj_seed" }
    if _is_false(v) { return "" }
    return v
}

fn rtobj_trace_enabled() {
    var v = oren_env("OREN_TRACE_RUNTIME_OBJ_CACHE")
    if v != nil && v != "" { return true }
    return false
}

fn _rtobj_dbg_val_to_string(v) {
    if v == nil { return "nil" }
    var tt = oren_type_tag(v)
    if tt == 4 { return v } // string
    if tt == 1 { return oren_int_to_string(v) } // int
    if tt == 3 { // bool
        if v == true { return "true" }
        return "false"
    }
    return "<tag=" + oren_int_to_string(tt) + ">"
}

fn _rtobj_u8_at(ub, idx) {
    if ub == nil { return -1 }
    if oren_is_u8_buf(ub) != true { return -1 }
    var n = oren_buf_len(ub)
    if idx < 0 || idx >= n { return -1 }
    var p = oren_buf_data_ptr_unchecked(ub)
    if p == 0 { return -1 }
    return ptr_get_byte(iadd(p, idx)) & 255
}

fn _rtobj_read_u32_le(ub, off) {
    var b0 = _rtobj_u8_at(ub, off + 0); if b0 < 0 { return -1 }
    var b1 = _rtobj_u8_at(ub, off + 1); if b1 < 0 { return -1 }
    var b2 = _rtobj_u8_at(ub, off + 2); if b2 < 0 { return -1 }
    var b3 = _rtobj_u8_at(ub, off + 3); if b3 < 0 { return -1 }
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

fn _rtobj_read_u64_le(ub, off) {
    var lo = _rtobj_read_u32_le(ub, off)
    if lo < 0 { return -1 }
    var hi = _rtobj_read_u32_le(ub, off + 4)
    if hi < 0 { return -1 }
    return lo + hi * 4294967296
}

fn _rtobj_meta_trace_sample(meta) {
    // Bounded diagnostic: sample a few meta entries to detect cross-runtime codec drift.
    if meta == nil { return nil }
    if oren_env("OREN_TRACE_RT_OBJ_META_SAMPLE") == nil { return nil }
    var fa = meta["func_arity"]
    if fa != nil {
        var i = 0
        var pair = [nil, nil]
        while i < 5 {
            var ok = oren_iter_next_entry(fa, i, pair)
            if ok == 0 { break }
            var k = pair[0]
            var v = pair[1]
            print("[rtobj] meta sample func_arity key=" + _rtobj_dbg_val_to_string(k) + " val_tag=" + oren_int_to_string(oren_type_tag(v)))
            i = i + 1
        }
    } else {
        print("[rtobj] meta sample func_arity=nil")
    }
    return nil
}

fn _rtobj_meta_validate_sentinels(meta) {
    // Cheap integrity check for cache compatibility/corruption.
    //
    // Full meta validation is expensive under the native runtime (large maps),
    // but we still want to catch the most common cases that would crash later.
    //
    // IMPORTANT (rolling):
    // Do not depend on runtime decl presence (e.g. `_map_hash_empty`) because pruning/DCE can
    // legitimately remove functions from the injected runtime depending on the build.
    //
    // Use invariants that must always hold for rtobj meta:
    // - data prefix length matches the ABI contract (slot reserved by native entry stubs)
    // - backend tag is present (string)
    if meta == nil { return false }

    // `data_prefix_len` was added as the cache format stabilized; migrate old entries.
    var dpl = meta["data_prefix_len"]
    if dpl == nil {
        meta["data_prefix_len"] = RUNTIME_OBJ_DATA_PREFIX_LEN
    } else {
        if oren_type_tag(dpl) != 1 { return false }
        if dpl != RUNTIME_OBJ_DATA_PREFIX_LEN { return false }
    }

    var be = meta["backend"]
    if be == nil { return false }
    if oren_type_tag(be) != 4 { return false }

    // Optional: if func_arity is present, ensure sentinel values are well-typed (don't require keys).
    var fa = meta["func_arity"]
    if fa != nil {
        var v = fa["_map_hash_empty"]
        if v != nil && oren_type_tag(v) != 1 { return false }
    }

    return true
}

fn _rtobj_meta_validate_int_map(meta, field) {
    // Validate map<string, int> shape. Returns true on ok.
    if meta == nil { return false }
    var m = meta[field]
    if m == nil { return true } // optional
    // Quick tag check: 7 is OREN_TYPE_MAP in stage1, but avoid hardcoding; just iterate.
    var idx = 0
    var pair = [nil, nil]
    while 1 {
        var ok = oren_iter_next_entry(m, idx, pair)
        if ok == 0 { break }
        var k = pair[0]
        var v = pair[1]
        // Keys are expected to be strings, but tolerate non-string keys (rolling) and only
        // enforce value shape.
        if v != nil && oren_type_tag(v) != 1 { return false }
        idx = idx + 1
    }
    return true
}

fn _rtobj_hash_cache_dir() {
    var v = oren_env("OREN_NATIVE_RUNTIME_HASH_CACHE_DIR")
    if v == nil || v == "" { return "build/cache/native_runtime_hash" }
    return v
}

fn _rtobj_hash_cache_sanitize_path(p) {
    if p == nil { return "nil" }
    var out = ""
    var i = 0
    while i < oren_string_len(p) {
        var c = oren_string_char_at_unchecked(p, i)
        if c == "/" || c == "\\" || c == ":" { out = out + "_" }
        else { out = out + c }
        i = i + 1
    }
    return out
}

fn _rtobj_hash_cache_path(runtime_path) {
    var dir = _rtobj_hash_cache_dir()
    var base = _rtobj_hash_cache_sanitize_path(runtime_path)
    return dir + "/" + base + ".hash.txt"
}

fn _rtobj_parse_nonneg_dec(s, start, end) {
    if s == nil { return nil }
    if start == nil || end == nil { return nil }
    if start < 0 || end < start { return nil }
    var i = start
    var v = 0
    while i < end {
        var b = oren_string_byte_at_unchecked(s, i) & 255
        if b < 48 || b > 57 { return nil }
        v = v * 10 + (b - 48)
        i = i + 1
    }
    return v
}

fn _rtobj_stat_size_and_mtime_ns(path) {
    // Portable file metadata query (works in stage1 C runtime + native runtime).
    var r = oren_file_stat_size_mtime_ns(path)
    if oren_is_err(r) { return nil }
    if r == nil || oren_list_len(r) < 2 { return nil }
    return {"size": r[0], "mtime_ns": r[1]}
}

fn _rtobj_runtime_hash_cache_try_load(runtime_path) {
    // Cache file format:
    //   hash=<hash>\n
    //   <path>\t<size>\t<mtime_ns>\n
    var p = _rtobj_hash_cache_path(runtime_path)
    var s = oren_read_file(p)
    if oren_is_err(s) { return nil }
    if s == nil { return nil }

    var n = oren_string_len(s)
    var i = 0
    // Read first line.
    var line_end = 0
    while line_end < n && oren_string_byte_at_unchecked(s, line_end) != 10 { line_end = line_end + 1 }
    if line_end <= 5 { return nil }
    if oren_string_slice_unchecked(s, 0, 5) != "hash=" { return nil }
    var hash = oren_string_slice_unchecked(s, 5, line_end)
    if hash == nil || hash == "" { return nil }
    i = line_end + 1

    while i < n {
        // Skip empty lines.
        if oren_string_byte_at_unchecked(s, i) == 10 { i = i + 1; continue }

        // path \t size \t mtime \n
        var p_end = i
        while p_end < n && oren_string_byte_at_unchecked(s, p_end) != 9 && oren_string_byte_at_unchecked(s, p_end) != 10 { p_end = p_end + 1 }
        if p_end >= n || oren_string_byte_at_unchecked(s, p_end) != 9 { return nil }
        var path = oren_string_slice_unchecked(s, i, p_end)
        i = p_end + 1

        var sz_end = i
        while sz_end < n && oren_string_byte_at_unchecked(s, sz_end) != 9 && oren_string_byte_at_unchecked(s, sz_end) != 10 { sz_end = sz_end + 1 }
        if sz_end >= n || oren_string_byte_at_unchecked(s, sz_end) != 9 { return nil }
        var want_size = _rtobj_parse_nonneg_dec(s, i, sz_end)
        i = sz_end + 1

        var mt_end = i
        while mt_end < n && oren_string_byte_at_unchecked(s, mt_end) != 10 { mt_end = mt_end + 1 }
        var want_mtime = _rtobj_parse_nonneg_dec(s, i, mt_end)
        // Consume newline.
        i = mt_end + 1

        if path == nil || path == "" { return nil }
        if want_size == nil || want_mtime == nil { return nil }
        var st = _rtobj_stat_size_and_mtime_ns(path)
        if st == nil { return nil }
        if st["size"] != want_size { return nil }
        if st["mtime_ns"] != want_mtime { return nil }
    }

    return hash
}

fn _rtobj_runtime_hash_cache_store(runtime_path, hash, files) {
    if runtime_path == nil || runtime_path == "" { return nil }
    if hash == nil || hash == "" { return nil }
    if files == nil { return nil }
    var dir = _rtobj_hash_cache_dir()
    _ensure_dir(dir)
    var p = _rtobj_hash_cache_path(runtime_path)
    var out = "hash=" + hash + "\n"
    var i = 0
    while i < oren_list_len(files) {
        var fp = files[i]
        if fp != nil && fp != "" {
            var st = _rtobj_stat_size_and_mtime_ns(fp)
            if st != nil {
                out = out + fp + "\t" + oren_int_to_string(st["size"]) + "\t" + oren_int_to_string(st["mtime_ns"]) + "\n"
            }
        }
        i = i + 1
    }
    oren_write_file(p, out)
    return nil
}

fn _hex_digit(n) { return oren_string_char_at("0123456789abcdef", n) }

fn _bytes_to_hex(bs) {
    if bs == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_list_len(bs) {
        var b = bs[i]
        // Do not rely on `scalar == nil` semantics (native parity hazard).
        if oren_type_tag(b) == 0 { b = 0 }
        if b < 0 { b = 0 }
        if b > 255 { b = b & 255 }
        out = out + _hex_digit(b / 16) + _hex_digit(b & 15)
        i = i + 1
    }
    return out
}

fn _sha256_hex_string(s) {
    // Still used for small deterministic fingerprints (e.g. manifest hashes).
    if s == nil { return "" }
    var d = oren_sha256_string(s)
    return _bytes_to_hex(d)
}

fn _mask63(x) {
    // Keep hashes non-negative so decimal formatting is stable across backends.
    return x & 9223372036854775807
}

fn _fnv1a63_string(s, basis) {
    // Fast fingerprint for cache keys (not a cryptographic hash).
    //
    // Implementation notes:
    // - Keep state in 63-bit domain to avoid signed-negative values (native v0 uses i64 carriers).
    // - Use a small prime; overflow wraps via masking.
    if s == nil { return 0 }
    var h = _mask63(basis)
    var prime = 1099511628211 // FNV-ish multiplier (fits in i64)
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        var b = oren_string_byte_at_unchecked(s, i) & 255
        h = _mask63(h ^ b)
        h = _mask63(h * prime)
        i = i + 1
    }
    return h
}

fn _fnv1a63_u8_buf(ub, basis) {
    if ub == nil { return 0 }
    if oren_is_u8_buf(ub) != true { return 0 }
    var h = _mask63(basis)
    var prime = 1099511628211
    var n = oren_buf_len(ub)
    if n <= 0 { return h }
    var p = oren_buf_data_ptr_unchecked(ub)
    if p == 0 { return h }
    var i = 0
    while i < n {
        var b = ptr_get_byte(iadd(p, i)) & 255
        h = _mask63(h ^ b)
        h = _mask63(h * prime)
        i = i + 1
    }
    return h
}

fn _fnv1a63_update_string(s, h0) {
    // Continue a 63-bit FNV-1a-style fingerprint from an existing state.
    if s == nil { return _mask63(h0) }
    var h = _mask63(h0)
    var prime = 1099511628211 // keep consistent with `_fnv1a63_string`
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        var b = oren_string_byte_at_unchecked(s, i) & 255
        h = _mask63(h ^ b)
        h = _mask63(h * prime)
        i = i + 1
    }
    return h
}

fn _rtobj_runtime_fingerprint_v2(src) {
    // Two-lane 63-bit fingerprint to reduce collision risk without expensive SHA-256.
    var h1 = _fnv1a63_string(src, 1469598103934665603)
    var h2 = _fnv1a63_string(src, 1099511628211)
    return "v2_" + oren_int_to_string(h1) + "_" + oren_int_to_string(h2)
}

fn _rtobj_runtime_fingerprint_v2_parts(parts) {
    // Fingerprint the expanded runtime as a list of source fragments.
    //
    // This avoids allocating one huge joined string just to hash it.
    var h1 = _mask63(1469598103934665603)
    var h2 = _mask63(1099511628211)
    if parts != nil {
        var i = 0
        while i < oren_list_len(parts) {
            var s = parts[i]
            h1 = _fnv1a63_update_string(s, h1)
            h2 = _fnv1a63_update_string(s, h2)
            i = i + 1
        }
    }
    return "v2_" + oren_int_to_string(h1) + "_" + oren_int_to_string(h2)
}

fn _path_to_windows_sep(s) {
    if s == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        if ch == "/" { out = out + "\\" }
        else { out = out + ch }
        i = i + 1
    }
    return out
}

fn _host_is_windows() {
    // Robust host detection for compiler/tooling helpers used across stage1 (C backend) and stage2 (native).
    // Do not rely solely on `OS=Windows_NT` since some environments (SSH/PowerShell) may omit it.
    if oren_env("OS") == "Windows_NT" { return true }
    if oren_env("SystemRoot") != nil { return true }
    if oren_env("WINDIR") != nil { return true }
    if oren_env("COMSPEC") != nil { return true }
    if oren_env("PATHEXT") != nil { return true }
    if oren_env("PROCESSOR_ARCHITECTURE") != nil { return true }
    return false
}

fn _ensure_dir(path) {
    if path == nil || path == "" { return nil }
    // Cross-platform: do not rely on `mkdir -p` on Windows (cmd.exe does not support it).
    var mk_path = path
    var cmd = ""
    if _host_is_windows() {
        mk_path = _path_to_windows_sep(mk_path)
        cmd = "mkdir \"" + mk_path + "\" >nul 2>nul"
    } else {
        cmd = "mkdir -p \"" + mk_path + "\""
    }
    oren_system(cmd)
    return nil
}

fn rtobj_runtime_hash(ctx, runtime_path) {
    var trace = rtobj_trace_enabled()
    var t0 = 0
    if trace {
        t0 = oren_time_now_ns()
        print("[rtobj] hash start path=" + runtime_path)
    }
    var hash_opts = _rtobj_runtime_hash_opts()

    var runtime_src = nil
    var runtime_parts = nil
    var runtime_files = nil
    var expanded_override = oren_env("OREN_NATIVE_RUNTIME_EXPANDED")
    if expanded_override != nil {
        var p = expanded_override
        if p == "" { p = "build/runtime_native.expanded.oren" }
        var rr = oren_read_file(p)
        if oren_is_err(rr) { return nil }
        runtime_src = rr
    } else {
        var cached = _rtobj_runtime_hash_cache_try_load(runtime_path)
        if cached != nil && cached != "" {
            if trace { print("[rtobj] hash cache hit") }
            if hash_opts == "" { return cached }
            return cached + "_opt_" + hash_opts
        }

        runtime_parts = []
        runtime_files = []
        var ok = rtinj.runtime_expand_includes_file_into_parts_and_files(ctx, runtime_path, [], runtime_parts, runtime_files)
        if ok == nil {
            // Failure here previously became a silent `nil` hash and an opaque build failure.
            // Keep output bounded: print only a small prefix of ctx["errors"].
            if ctx != nil && ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
                print("[rtobj] runtime expand failed (showing first errors):")
                var ei = 0
                while ei < oren_list_len(ctx["errors"]) && ei < 5 {
                    print("  " + ctx["errors"][ei])
                    ei = ei + 1
                }
            } else {
                print("[rtobj] runtime expand failed (no detailed errors)")
            }
            return nil
        }
    }
    if expanded_override != nil {
        if runtime_src == nil { return nil }
    } else {
        if runtime_parts == nil { return nil }
    }

    if trace {
        var dt = oren_time_now_ns() - t0
        print("[rtobj] hash expand done +" + oren_int_to_string(dt / 1000000) + "ms")
    }

    var t1 = 0
    if trace { t1 = oren_time_now_ns() }
    var h = ""
    if expanded_override != nil {
        h = _rtobj_runtime_fingerprint_v2(runtime_src)
    } else {
        h = _rtobj_runtime_fingerprint_v2_parts(runtime_parts)
    }
    if trace {
        var dt2 = oren_time_now_ns() - t1
        print("[rtobj] hash fp done +" + oren_int_to_string(dt2 / 1000000) + "ms")
    }
    if expanded_override == nil {
        // Best-effort persist so subsequent compiler invocations can avoid re-expanding + hashing.
        _rtobj_runtime_hash_cache_store(runtime_path, h, runtime_files)
    }
    if hash_opts == "" { return h }
    return h + "_opt_" + hash_opts
}

fn rtobj_cache_key(backend, platform, runtime_hash) {
    var os = "unknown"
    var arch = "unknown"
    var dbg = "0"
    var ngc = "0"
    if platform != nil {
        if platform["os"] != nil { os = platform["os"] }
        if platform["arch"] != nil { arch = platform["arch"] }
        if platform["debug"] == true { dbg = "1" }
        if platform["no_gc"] == true { ngc = "1" }
    }
    // Key must be filesystem-friendly and stable. Avoid hashing this string again: the runtime_hash
    // already includes a strong-enough fingerprint for cache selection in rolling mode.
    var bsig = rtobj_backend_sig(backend)
    return "s" + oren_int_to_string(RUNTIME_OBJ_SCHEMA) +
        "_b_" + backend +
        "_bv_" + bsig +
        "_os_" + os +
        "_a_" + arch +
        "_d" + dbg +
        "_g" + ngc +
        "_rh_" + runtime_hash
}

fn rtobj_paths(cache_dir, key) {
    var dir = cache_dir + "/" + key
    return {
        "dir": dir,
        "meta": dir + "/meta.astbin",
        "meta_check": dir + "/meta.check",
        "fixups_compact": dir + "/fixups_compact.astbin",
        "fix_bl_pos": dir + "/fix_bl_pos.u8",
        "fix_bl_target": dir + "/fix_bl_target.u8",
        "fix_adr_data_pos": dir + "/fix_adr_data_pos.u8",
        "fix_adr_data_off": dir + "/fix_adr_data_off.u8",
        "fix_adr_data_reg": dir + "/fix_adr_data_reg.u8",
        "fix_adr_code_pos": dir + "/fix_adr_code_pos.u8",
        "fix_adr_code_target": dir + "/fix_adr_code_target.u8",
        "fix_adr_code_reg": dir + "/fix_adr_code_reg.u8",
        "cstr0_offsets": dir + "/cstr0_offsets.u8",
        "debug_blob": dir + "/debug_blob.u8",
        "debug_patch_pos": dir + "/debug_patch_pos.u8",
        "debug_start": dir + "/debug_start.u8",
        "debug_end": dir + "/debug_end.u8",
        "code": dir + "/code.u8",
        "data_tail": dir + "/data_tail.u8"
    }
}

fn rtobj_load_fixups_compact_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    var bs = oren_read_u8_buf(paths["fixups_compact"])
    if oren_is_err(bs) { return nil }
    return astbin.astbin_decode(bs)
}

fn rtobj_store_fixups_compact_sidecar(cache_dir, key, fixups_compact) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    if fixups_compact == nil { return nil }
    var paths = rtobj_paths(cache_dir, key)
    _ensure_dir(paths["dir"])
    var bs = astbin.astbin_encode(fixups_compact)
    if bs == nil { return nil }
    _rtobj_write_atomic(paths["fixups_compact"], bs)
    return nil
}

fn _rtobj_load_u64_u8_sidecar(path) {
    if path == nil || path == "" { return nil }
    var bs = oren_read_u8_buf(path)
    if oren_is_err(bs) { return nil }
    var n = oren_buf_len(bs)
    if n < 0 { return nil }
    if (n / 8) * 8 != n { return nil }
    return bs
}

fn _rtobj_encode_u64_sidecar_from_enc_list(xs) {
    if xs == nil { return nil }
    var b = bytes.bytes_new()
    var i = 0
    while i < oren_list_len(xs) {
        var enc = xs[i]
        if oren_type_tag(enc) == 1 && enc > 0 {
            bytes.bytes_push_u64_le(b, enc - 1)
        }
        i = i + 1
    }
    return bytes.bytes_finalize(b)
}

fn _rtobj_encode_reg_u64_sidecar_from_enc_list(xs) {
    if xs == nil { return nil }
    var b = bytes.bytes_new()
    var i = 0
    while i < oren_list_len(xs) {
        var enc = xs[i]
        if oren_type_tag(enc) == 1 && enc > 0 { bytes.bytes_push_u64_le(b, enc - 1) }
        else { bytes.bytes_push_u64_le(b, 0) }
        i = i + 1
    }
    return bytes.bytes_finalize(b)
}

fn _rtobj_build_fixups_compact_target_u8_from_names(names, fn_offs_enc) {
    if names == nil { return nil }
    var b = bytes.bytes_new()
    var i = 0
    while i < oren_list_len(names) {
        var nm = names[i]
        var off_enc = nil
        if fn_offs_enc != nil && nm != nil { off_enc = fn_offs_enc[nm] }
        if oren_type_tag(off_enc) == 1 && off_enc > 0 { bytes.bytes_push_u64_le(b, off_enc) }
        else { bytes.bytes_push_u64_le(b, 0) }
        i = i + 1
    }
    return bytes.bytes_finalize(b)
}

fn _rtobj_build_fixups_compact_u8_sidecars(fx, fn_offs_enc) {
    if fx == nil { return nil }
    var out = {}
    var any = false
    if fx["bl_pos_enc"] != nil {
        out["bl_pos_u8"] = _rtobj_encode_u64_sidecar_from_enc_list(fx["bl_pos_enc"])
        if out["bl_pos_u8"] != nil { any = true }
    }
    if fx["bl_name"] != nil {
        out["bl_target_u8"] = _rtobj_build_fixups_compact_target_u8_from_names(fx["bl_name"], fn_offs_enc)
        if out["bl_target_u8"] != nil { any = true }
    }
    if fx["adr_data_pos_enc"] != nil {
        out["adr_data_pos_u8"] = _rtobj_encode_u64_sidecar_from_enc_list(fx["adr_data_pos_enc"])
        if out["adr_data_pos_u8"] != nil { any = true }
    }
    if fx["adr_data_data_off_enc"] != nil {
        out["adr_data_data_off_u8"] = _rtobj_encode_u64_sidecar_from_enc_list(fx["adr_data_data_off_enc"])
        if out["adr_data_data_off_u8"] != nil { any = true }
    }
    if fx["adr_data_reg_enc"] != nil {
        out["adr_data_reg_u8"] = _rtobj_encode_reg_u64_sidecar_from_enc_list(fx["adr_data_reg_enc"])
        if out["adr_data_reg_u8"] != nil { any = true }
    }
    if fx["adr_code_pos_enc"] != nil {
        out["adr_code_pos_u8"] = _rtobj_encode_u64_sidecar_from_enc_list(fx["adr_code_pos_enc"])
        if out["adr_code_pos_u8"] != nil { any = true }
    }
    if fx["adr_code_name"] != nil {
        out["adr_code_target_u8"] = _rtobj_build_fixups_compact_target_u8_from_names(fx["adr_code_name"], fn_offs_enc)
        if out["adr_code_target_u8"] != nil { any = true }
    }
    if fx["adr_code_reg_enc"] != nil {
        out["adr_code_reg_u8"] = _rtobj_encode_reg_u64_sidecar_from_enc_list(fx["adr_code_reg_enc"])
        if out["adr_code_reg_u8"] != nil { any = true }
    }
    if any != true { return nil }
    return out
}

fn rtobj_load_fixups_compact_u8_sidecars(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    var out = {}
    var any = false
    var bl = _rtobj_load_u64_u8_sidecar(paths["fix_bl_pos"])
    if bl != nil { out["bl_pos_u8"] = bl; any = true }
    var blt = _rtobj_load_u64_u8_sidecar(paths["fix_bl_target"])
    if blt != nil { out["bl_target_u8"] = blt; any = true }
    var adp = _rtobj_load_u64_u8_sidecar(paths["fix_adr_data_pos"])
    if adp != nil { out["adr_data_pos_u8"] = adp; any = true }
    var ado = _rtobj_load_u64_u8_sidecar(paths["fix_adr_data_off"])
    if ado != nil { out["adr_data_data_off_u8"] = ado; any = true }
    var adr = _rtobj_load_u64_u8_sidecar(paths["fix_adr_data_reg"])
    if adr != nil { out["adr_data_reg_u8"] = adr; any = true }
    var acp = _rtobj_load_u64_u8_sidecar(paths["fix_adr_code_pos"])
    if acp != nil { out["adr_code_pos_u8"] = acp; any = true }
    var act = _rtobj_load_u64_u8_sidecar(paths["fix_adr_code_target"])
    if act != nil { out["adr_code_target_u8"] = act; any = true }
    var acr = _rtobj_load_u64_u8_sidecar(paths["fix_adr_code_reg"])
    if acr != nil { out["adr_code_reg_u8"] = acr; any = true }
    if any != true { return nil }
    return out
}

fn rtobj_store_fixups_compact_u8_sidecars(cache_dir, key, fx_u8) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    if fx_u8 == nil { return nil }
    var paths = rtobj_paths(cache_dir, key)
    _ensure_dir(paths["dir"])
    if fx_u8["bl_pos_u8"] != nil { _rtobj_write_atomic(paths["fix_bl_pos"], fx_u8["bl_pos_u8"]) }
    if fx_u8["bl_target_u8"] != nil { _rtobj_write_atomic(paths["fix_bl_target"], fx_u8["bl_target_u8"]) }
    if fx_u8["adr_data_pos_u8"] != nil { _rtobj_write_atomic(paths["fix_adr_data_pos"], fx_u8["adr_data_pos_u8"]) }
    if fx_u8["adr_data_data_off_u8"] != nil { _rtobj_write_atomic(paths["fix_adr_data_off"], fx_u8["adr_data_data_off_u8"]) }
    if fx_u8["adr_data_reg_u8"] != nil { _rtobj_write_atomic(paths["fix_adr_data_reg"], fx_u8["adr_data_reg_u8"]) }
    if fx_u8["adr_code_pos_u8"] != nil { _rtobj_write_atomic(paths["fix_adr_code_pos"], fx_u8["adr_code_pos_u8"]) }
    if fx_u8["adr_code_target_u8"] != nil { _rtobj_write_atomic(paths["fix_adr_code_target"], fx_u8["adr_code_target_u8"]) }
    if fx_u8["adr_code_reg_u8"] != nil { _rtobj_write_atomic(paths["fix_adr_code_reg"], fx_u8["adr_code_reg_u8"]) }
    return nil
}

fn _rtobj_fixups_compact_u8_sidecars_complete(fx, fx_u8) {
    if fx == nil || fx_u8 == nil { return false }
    if fx["bl_pos_enc"] != nil {
        if fx_u8["bl_pos_u8"] == nil { return false }
        if fx["bl_name"] != nil && fx_u8["bl_target_u8"] == nil { return false }
    }
    if fx["adr_data_pos_enc"] != nil {
        if fx_u8["adr_data_pos_u8"] == nil { return false }
        if fx_u8["adr_data_data_off_u8"] == nil { return false }
        if fx_u8["adr_data_reg_u8"] == nil { return false }
    }
    if fx["adr_code_pos_enc"] != nil {
        if fx_u8["adr_code_pos_u8"] == nil { return false }
        if fx["adr_code_name"] != nil && fx_u8["adr_code_target_u8"] == nil { return false }
        if fx_u8["adr_code_reg_u8"] == nil { return false }
    }
    return true
}

fn _rtobj_build_cstr0_offsets_u8_from_enc(cstr0_list_enc) {
    if cstr0_list_enc == nil { return nil }
    var b = bytes.bytes_new()
    var i = 0
    while i < oren_list_len(cstr0_list_enc) {
        var off_enc = cstr0_list_enc[i]
        if oren_type_tag(off_enc) == 1 && off_enc > 0 {
            bytes.bytes_push_u64_le(b, off_enc - 1)
        }
        i = i + 1
    }
    return bytes.bytes_finalize(b)
}

fn rtobj_load_cstr0_offsets_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    var bs = oren_read_u8_buf(paths["cstr0_offsets"])
    if oren_is_err(bs) { return nil }
    var n = oren_buf_len(bs)
    if n < 0 { return nil }
    if (n / 8) * 8 != n { return nil }
    return bs
}

fn rtobj_store_cstr0_offsets_sidecar(cache_dir, key, cstr0_offsets_u8) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    if cstr0_offsets_u8 == nil { return nil }
    if oren_is_u8_buf(cstr0_offsets_u8) != true { return nil }
    var paths = rtobj_paths(cache_dir, key)
    _ensure_dir(paths["dir"])
    _rtobj_write_atomic(paths["cstr0_offsets"], cstr0_offsets_u8)
    return nil
}

fn _rtobj_align_bytes_8(b) {
    if b == nil { return nil }
    while (bytes.bytes_len(b) / 8) * 8 != bytes.bytes_len(b) {
        bytes.bytes_push(b, 0)
    }
    return nil
}

fn _rtobj_normalize_debug_funcs_enc(debug_funcs_enc) {
    if debug_funcs_enc == nil { return nil }
    if oren_is_map(debug_funcs_enc) == true &&
       debug_funcs_enc["name"] != nil &&
       debug_funcs_enc["start_enc"] != nil &&
       debug_funcs_enc["end_enc"] != nil {
        return {
            "name": debug_funcs_enc["name"],
            "start_enc": debug_funcs_enc["start_enc"],
            "end_enc": debug_funcs_enc["end_enc"]
        }
    }
    var names = []
    var starts = []
    var ends = []
    var i = 0
    while i < oren_list_len(debug_funcs_enc) {
        var df = debug_funcs_enc[i]
        if df != nil &&
           df["name"] != nil &&
           df["start_enc"] != nil &&
           df["end_enc"] != nil {
            oren_list_push(names, df["name"])
            oren_list_push(starts, df["start_enc"])
            oren_list_push(ends, df["end_enc"])
        }
        i = i + 1
    }
    return {"name": names, "start_enc": starts, "end_enc": ends}
}

fn _rtobj_build_debug_blob_sidecars_from_enc(debug_funcs_enc) {
    var norm = _rtobj_normalize_debug_funcs_enc(debug_funcs_enc)
    if norm == nil { return nil }
    var names = norm["name"]
    var starts = norm["start_enc"]
    var ends = norm["end_enc"]
    if names == nil || starts == nil || ends == nil { return nil }
    var n = oren_list_len(names)
    if oren_list_len(starts) < n { n = oren_list_len(starts) }
    if oren_list_len(ends) < n { n = oren_list_len(ends) }
    var blob = bytes.bytes_new()
    var patch = bytes.bytes_new()
    var start_u8 = bytes.bytes_new()
    var end_u8 = bytes.bytes_new()
    var i = 0
    while i < n {
        var nm = names[i]
        var st = starts[i]
        var en = ends[i]
        if nm != nil {
            if oren_type_tag(st) != 1 || st <= 0 || oren_type_tag(en) != 1 || en <= 0 {
                i = i + 1
                continue
            }
            var pos = bytes.bytes_len(blob)
            bytes.bytes_push_u64_le(blob, 0)
            bytes.bytes_push_u64_le(blob, 0)
            bytes.bytes_push_u64_le(patch, pos)
            bytes.bytes_push_u64_le(start_u8, st - 1)
            bytes.bytes_push_u64_le(end_u8, en - 1)
            var name_len = oren_string_len(nm)
            bytes.bytes_push_u64_le(blob, name_len)
            bytes.bytes_extend_list(blob, oren_bytes_from_string(nm))
            _rtobj_align_bytes_8(blob)
            bytes.bytes_push_u64_le(blob, 0)
            bytes.bytes_push_u64_le(blob, 0)
            bytes.bytes_push_u64_le(blob, 0)
        }
        i = i + 1
    }
    return {
        "debug_blob_u8": bytes.bytes_finalize(blob),
        "debug_patch_pos_u8": bytes.bytes_finalize(patch),
        "debug_start_u8": bytes.bytes_finalize(start_u8),
        "debug_end_u8": bytes.bytes_finalize(end_u8),
        "debug_funcs_enc_norm": norm
    }
}

fn rtobj_load_debug_blob_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    var bs = oren_read_u8_buf(paths["debug_blob"])
    if oren_is_err(bs) { return nil }
    return bs
}

fn rtobj_load_debug_patch_pos_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    var bs = oren_read_u8_buf(paths["debug_patch_pos"])
    if oren_is_err(bs) { return nil }
    var n = oren_buf_len(bs)
    if n < 0 { return nil }
    if (n / 8) * 8 != n { return nil }
    return bs
}

fn rtobj_load_debug_start_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    return _rtobj_load_u64_u8_sidecar(paths["debug_start"])
}

fn rtobj_load_debug_end_sidecar(cache_dir, key) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    var paths = rtobj_paths(cache_dir, key)
    return _rtobj_load_u64_u8_sidecar(paths["debug_end"])
}

fn rtobj_store_debug_sidecars(cache_dir, key, debug_blob_u8, debug_patch_pos_u8, debug_start_u8, debug_end_u8) {
    if cache_dir == nil || cache_dir == "" || key == nil || key == "" { return nil }
    if debug_blob_u8 == nil || debug_patch_pos_u8 == nil { return nil }
    if oren_is_u8_buf(debug_blob_u8) != true { return nil }
    if oren_is_u8_buf(debug_patch_pos_u8) != true { return nil }
    var paths = rtobj_paths(cache_dir, key)
    _ensure_dir(paths["dir"])
    _rtobj_write_atomic(paths["debug_blob"], debug_blob_u8)
    _rtobj_write_atomic(paths["debug_patch_pos"], debug_patch_pos_u8)
    if debug_start_u8 != nil { _rtobj_write_atomic(paths["debug_start"], debug_start_u8) }
    if debug_end_u8 != nil { _rtobj_write_atomic(paths["debug_end"], debug_end_u8) }
    return nil
}

fn _rtobj_meta_check_build(meta_bs) {
    if meta_bs == nil { return nil }
    if oren_is_u8_buf(meta_bs) != true { return nil }
    var n = oren_buf_len(meta_bs)
    if n <= 0 { return nil }
    var b = bytes.bytes_new()
    bytes.bytes_push(b, RUNTIME_OBJ_META_CHECK_MAGIC0)
    bytes.bytes_push(b, RUNTIME_OBJ_META_CHECK_MAGIC1)
    bytes.bytes_push(b, RUNTIME_OBJ_META_CHECK_MAGIC2)
    bytes.bytes_push(b, RUNTIME_OBJ_META_CHECK_MAGIC3)
    bytes.bytes_push_u32_le(b, RUNTIME_OBJ_META_CHECK_VERSION)
    bytes.bytes_push_u32_le(b, n)
    var h = _fnv1a63_u8_buf(meta_bs, 1469598103934665603)
    bytes.bytes_push_u64_le(b, h)
    return bytes.bytes_finalize(b)
}

fn _rtobj_meta_check_verify(meta_bs, check_bs, trace, tag) {
    if meta_bs == nil || check_bs == nil {
        if trace { print("[rtobj] " + tag + " miss: meta check missing") }
        return false
    }
    if oren_is_u8_buf(meta_bs) != true || oren_is_u8_buf(check_bs) != true {
        if trace { print("[rtobj] " + tag + " miss: meta check type mismatch") }
        return false
    }
    if oren_buf_len(check_bs) != RUNTIME_OBJ_META_CHECK_LEN {
        if trace {
            print("[rtobj] " + tag + " miss: meta check len=" + oren_int_to_string(oren_buf_len(check_bs)) +
                  " want=" + oren_int_to_string(RUNTIME_OBJ_META_CHECK_LEN))
        }
        return false
    }
    if _rtobj_u8_at(check_bs, 0) != RUNTIME_OBJ_META_CHECK_MAGIC0 ||
       _rtobj_u8_at(check_bs, 1) != RUNTIME_OBJ_META_CHECK_MAGIC1 ||
       _rtobj_u8_at(check_bs, 2) != RUNTIME_OBJ_META_CHECK_MAGIC2 ||
       _rtobj_u8_at(check_bs, 3) != RUNTIME_OBJ_META_CHECK_MAGIC3 {
        if trace { print("[rtobj] " + tag + " miss: meta check magic mismatch") }
        return false
    }
    var ver = _rtobj_read_u32_le(check_bs, 4)
    if ver != RUNTIME_OBJ_META_CHECK_VERSION {
        if trace {
            print("[rtobj] " + tag + " miss: meta check version=" + _rtobj_dbg_val_to_string(ver) +
                  " want=" + oren_int_to_string(RUNTIME_OBJ_META_CHECK_VERSION))
        }
        return false
    }
    var want_len = _rtobj_read_u32_le(check_bs, 8)
    if want_len <= 0 || want_len != oren_buf_len(meta_bs) {
        if trace {
            print("[rtobj] " + tag + " miss: meta check len mismatch want=" + _rtobj_dbg_val_to_string(want_len) +
                  " have=" + oren_int_to_string(oren_buf_len(meta_bs)))
        }
        return false
    }
    var want_hash = _rtobj_read_u64_le(check_bs, 12)
    if want_hash < 0 {
        if trace { print("[rtobj] " + tag + " miss: meta check hash invalid") }
        return false
    }
    var got_hash = _fnv1a63_u8_buf(meta_bs, 1469598103934665603)
    if want_hash != got_hash {
        if trace {
            print("[rtobj] " + tag + " miss: meta check hash mismatch want=" + _rtobj_dbg_val_to_string(want_hash) +
                  " have=" + _rtobj_dbg_val_to_string(got_hash))
        }
        return false
    }
    return true
}

fn _rtobj_write_atomic(path, bytes_u8) {
    if path == nil || path == "" { return nil }
    if bytes_u8 == nil { return nil }
    var tmp = path + ".tmp." + oren_int_to_string(oren_time_now_ns())
    var w = oren_write_bytes(tmp, bytes_u8)
    if oren_is_err(w) { return nil }
    var rr = oren_rename(tmp, path)
    if rr != 0 {
        // Fallback: direct write if rename fails on this platform.
        var w2 = oren_write_bytes(path, bytes_u8)
        if oren_is_err(w2) { return nil }
    }
    return nil
}

fn rtobj_try_load_seed_into_cache(cache_dir, key) {
    // Try a "seed" rtobj bundle when cache miss happens.
    //
    // Returns decoded meta with code/data attached, or nil if not present/invalid.
    // If found and cache_dir differs from seed_dir, copies the seed files into cache_dir
    // (without re-encoding meta) so subsequent runs hit the normal cache path.
    var seed_dir = rtobj_seed_dir()
    if seed_dir == nil || seed_dir == "" { return nil }

    var trace = rtobj_trace_enabled()
    var t0 = 0
    if trace { t0 = oren_time_now_ns() }

    var src = rtobj_paths(seed_dir, key)
    var meta_bs = oren_read_u8_buf(src["meta"])
    if oren_is_err(meta_bs) { return nil }
    var meta_check = oren_read_u8_buf(src["meta_check"])
    if oren_is_err(meta_check) { return nil }
    if _rtobj_meta_check_verify(meta_bs, meta_check, trace, "seed") != true { return nil }
    var code = oren_read_u8_buf(src["code"])
    if oren_is_err(code) { return nil }
    var data_tail = oren_read_u8_buf(src["data_tail"])
    if oren_is_err(data_tail) { return nil }

    var meta = astbin.astbin_decode(meta_bs)
    if meta == nil { return nil }
    if meta["schema"] == nil || meta["schema"] != RUNTIME_OBJ_SCHEMA { return nil }
    if _rtobj_meta_validate_sentinels(meta) != true { return nil }
    var key_ok = _rtobj_meta_match_or_migrate_key_fields(key, meta)
    if key_ok == 0 { return nil }

    meta["code_u8"] = code
    meta["data_tail_u8"] = data_tail
    var fixups_compact_u8 = rtobj_load_fixups_compact_u8_sidecars(seed_dir, key)
    if meta["fixups_compact"] != nil && _rtobj_fixups_compact_u8_sidecars_complete(meta["fixups_compact"], fixups_compact_u8) != true {
        fixups_compact_u8 = _rtobj_build_fixups_compact_u8_sidecars(meta["fixups_compact"], meta["fn_offs_enc"])
        if fixups_compact_u8 != nil {
            rtobj_store_fixups_compact_u8_sidecars(seed_dir, key, fixups_compact_u8)
        }
    }
    if fixups_compact_u8 != nil { meta["fixups_compact_u8"] = fixups_compact_u8 }
    var cstr0_offsets_u8 = rtobj_load_cstr0_offsets_sidecar(seed_dir, key)
    if cstr0_offsets_u8 == nil && meta["cstr0_list_enc"] != nil {
        cstr0_offsets_u8 = _rtobj_build_cstr0_offsets_u8_from_enc(meta["cstr0_list_enc"])
    }
    if cstr0_offsets_u8 != nil { meta["cstr0_offsets_u8"] = cstr0_offsets_u8 }
    var debug_blob_u8 = rtobj_load_debug_blob_sidecar(seed_dir, key)
    var debug_patch_pos_u8 = rtobj_load_debug_patch_pos_sidecar(seed_dir, key)
    var debug_start_u8 = rtobj_load_debug_start_sidecar(seed_dir, key)
    var debug_end_u8 = rtobj_load_debug_end_sidecar(seed_dir, key)
    if (debug_blob_u8 == nil || debug_patch_pos_u8 == nil || debug_start_u8 == nil || debug_end_u8 == nil) && meta["debug_funcs_enc"] != nil {
        var dbg_sidecars_seed = _rtobj_build_debug_blob_sidecars_from_enc(meta["debug_funcs_enc"])
        if dbg_sidecars_seed != nil {
            if debug_blob_u8 == nil { debug_blob_u8 = dbg_sidecars_seed["debug_blob_u8"] }
            if debug_patch_pos_u8 == nil { debug_patch_pos_u8 = dbg_sidecars_seed["debug_patch_pos_u8"] }
            if debug_start_u8 == nil { debug_start_u8 = dbg_sidecars_seed["debug_start_u8"] }
            if debug_end_u8 == nil { debug_end_u8 = dbg_sidecars_seed["debug_end_u8"] }
            if dbg_sidecars_seed["debug_funcs_enc_norm"] != nil { meta["debug_funcs_enc"] = dbg_sidecars_seed["debug_funcs_enc_norm"] }
        }
    }
    if debug_blob_u8 != nil { meta["debug_blob_u8"] = debug_blob_u8 }
    if debug_patch_pos_u8 != nil { meta["debug_patch_pos_u8"] = debug_patch_pos_u8 }
    if debug_start_u8 != nil { meta["debug_start_u8"] = debug_start_u8 }
    if debug_end_u8 != nil { meta["debug_end_u8"] = debug_end_u8 }
    meta["cache_dir"] = cache_dir
    meta["cache_key"] = key

    if trace {
        var dt0 = (oren_time_now_ns() - t0) / 1000000
        print("[rtobj] seed-hit key=" + key + " +" + oren_int_to_string(dt0) + "ms dir=" + seed_dir)
    }

    if cache_dir != nil && cache_dir != "" && cache_dir != seed_dir {
        var dst = rtobj_paths(cache_dir, key)
        _ensure_dir(dst["dir"])
        // Copy raw bytes (avoid any re-encode cost on first-run seeding).
        // If the meta is missing newer key fields, `rtobj_load` will migrate them in-memory.
        _rtobj_write_atomic(dst["meta"], meta_bs)
        _rtobj_write_atomic(dst["meta_check"], meta_check)
        _rtobj_write_atomic(dst["code"], code)
        _rtobj_write_atomic(dst["data_tail"], data_tail)
        if fixups_compact_u8 != nil { rtobj_store_fixups_compact_u8_sidecars(cache_dir, key, fixups_compact_u8) }
        if cstr0_offsets_u8 != nil { _rtobj_write_atomic(dst["cstr0_offsets"], cstr0_offsets_u8) }
        if debug_blob_u8 != nil && debug_patch_pos_u8 != nil {
            rtobj_store_debug_sidecars(cache_dir, key, debug_blob_u8, debug_patch_pos_u8, debug_start_u8, debug_end_u8)
        }
        if trace { print("[rtobj] seed-copied to cache dir=" + cache_dir) }
    }

    return meta
}

fn rtobj_load(cache_dir, key) {
    var trace = rtobj_trace_enabled()
    var t0 = 0
    if trace { t0 = oren_time_now_ns() }
    var paths = rtobj_paths(cache_dir, key)
    var meta_bs = oren_read_u8_buf(paths["meta"])
    if oren_is_err(meta_bs) { return nil }
    if trace {
        var dt0 = oren_time_now_ns() - t0
        print("[rtobj] load meta bytes done +" + oren_int_to_string(dt0 / 1000000) + "ms")
        t0 = oren_time_now_ns()
    }
    var meta_check = oren_read_u8_buf(paths["meta_check"])
    if oren_is_err(meta_check) {
        if trace { print("[rtobj] load miss: meta check missing") }
        return nil
    }
    if _rtobj_meta_check_verify(meta_bs, meta_check, trace, "load") != true { return nil }
    var meta = astbin.astbin_decode(meta_bs)
    if meta == nil { return nil }
    if meta["schema"] == nil {
        if trace { print("[rtobj] load miss: meta missing schema") }
        return nil
    }
    if meta["schema"] != RUNTIME_OBJ_SCHEMA {
        if trace {
            print("[rtobj] load miss: schema mismatch have=" + _rtobj_dbg_val_to_string(meta["schema"]) +
                  " want=" + oren_int_to_string(RUNTIME_OBJ_SCHEMA))
        }
        return nil
    }
    _rtobj_meta_trace_sample(meta)
    // Cheap validation so a corrupted/stale cache becomes a miss instead of crashing deep in codegen.
    if _rtobj_meta_validate_sentinels(meta) != true {
        if trace {
            var dpl = meta["data_prefix_len"]
            print("[rtobj] load miss: meta sentinel validation failed (backend=" + _rtobj_dbg_val_to_string(meta["backend"]) +
                  " data_prefix_len=" + _rtobj_dbg_val_to_string(dpl) + ")")
        }
        return nil
    }
    // Ensure the cache meta matches the key (avoid collisions/bitrot silently producing wrong code).
    // Older caches missing these fields are migrated in-place.
    var key_ok2 = _rtobj_meta_match_or_migrate_key_fields(key, meta)
    if key_ok2 == 0 {
        if trace {
            print("[rtobj] load miss: key/meta mismatch want_bv=" + _rtobj_key_extract_bv(key) +
                  " want_rh=" + _rtobj_key_extract_rh(key) +
                  " meta_bv=" + _rtobj_dbg_val_to_string(meta["backend_sig"]) +
                  " meta_rh=" + _rtobj_dbg_val_to_string(meta["runtime_hash"]))
        }
        return nil
    }
    // NOTE: if key_ok2 == 2, the cache entry is from an older schema missing key fields.
    // Do not re-encode meta here: encoding large meta maps can exceed the default 10s build gates.
    // Optional deeper validation (expensive under the native runtime; keep opt-in).
    if oren_env("OREN_RT_OBJ_VALIDATE_META_FULL") != nil {
        if _rtobj_meta_validate_int_map(meta, "func_arity") != true { return nil }
        if _rtobj_meta_validate_int_map(meta, "func_varargs_fixed") != true { return nil }
    }
    if trace {
        var dt1 = oren_time_now_ns() - t0
        print("[rtobj] load meta decode done +" + oren_int_to_string(dt1 / 1000000) + "ms")
        t0 = oren_time_now_ns()
    }

    var code = oren_read_u8_buf(paths["code"])
    if oren_is_err(code) { return nil }
    var data_tail = oren_read_u8_buf(paths["data_tail"])
    if oren_is_err(data_tail) { return nil }
    if trace {
        var dt2 = oren_time_now_ns() - t0
        print("[rtobj] load code+data bytes done +" + oren_int_to_string(dt2 / 1000000) + "ms")
    }
    if meta["fixups_compact"] == nil {
        var fx_compact_sidecar = rtobj_load_fixups_compact_sidecar(cache_dir, key)
        if fx_compact_sidecar != nil {
            meta["fixups_compact"] = fx_compact_sidecar
            if trace { print("[rtobj] load fixups_compact sidecar hit") }
        }
    }
    var fixups_compact_u8 = rtobj_load_fixups_compact_u8_sidecars(cache_dir, key)
    if meta["fixups_compact"] != nil && _rtobj_fixups_compact_u8_sidecars_complete(meta["fixups_compact"], fixups_compact_u8) != true {
        fixups_compact_u8 = _rtobj_build_fixups_compact_u8_sidecars(meta["fixups_compact"], meta["fn_offs_enc"])
        if fixups_compact_u8 != nil {
            rtobj_store_fixups_compact_u8_sidecars(cache_dir, key, fixups_compact_u8)
            if trace { print("[rtobj] load fixups_compact_u8 sidecars rebuilt") }
        }
    } else if fixups_compact_u8 != nil {
        if trace { print("[rtobj] load fixups_compact_u8 sidecars hit") }
    }
    if fixups_compact_u8 != nil { meta["fixups_compact_u8"] = fixups_compact_u8 }
    var cstr0_offsets_u8 = rtobj_load_cstr0_offsets_sidecar(cache_dir, key)
    if cstr0_offsets_u8 == nil && meta["cstr0_list_enc"] != nil {
        cstr0_offsets_u8 = _rtobj_build_cstr0_offsets_u8_from_enc(meta["cstr0_list_enc"])
        if cstr0_offsets_u8 != nil {
            rtobj_store_cstr0_offsets_sidecar(cache_dir, key, cstr0_offsets_u8)
            if trace { print("[rtobj] load cstr0_offsets sidecar rebuilt") }
        }
    } else if cstr0_offsets_u8 != nil {
        if trace { print("[rtobj] load cstr0_offsets sidecar hit") }
    }
    if cstr0_offsets_u8 != nil { meta["cstr0_offsets_u8"] = cstr0_offsets_u8 }
    var debug_blob_u8 = rtobj_load_debug_blob_sidecar(cache_dir, key)
    var debug_patch_pos_u8 = rtobj_load_debug_patch_pos_sidecar(cache_dir, key)
    var debug_start_u8 = rtobj_load_debug_start_sidecar(cache_dir, key)
    var debug_end_u8 = rtobj_load_debug_end_sidecar(cache_dir, key)
    if (debug_blob_u8 == nil || debug_patch_pos_u8 == nil || debug_start_u8 == nil || debug_end_u8 == nil) && meta["debug_funcs_enc"] != nil {
        var dbg_sidecars = _rtobj_build_debug_blob_sidecars_from_enc(meta["debug_funcs_enc"])
        if dbg_sidecars != nil {
            if debug_blob_u8 == nil { debug_blob_u8 = dbg_sidecars["debug_blob_u8"] }
            if debug_patch_pos_u8 == nil { debug_patch_pos_u8 = dbg_sidecars["debug_patch_pos_u8"] }
            if debug_start_u8 == nil { debug_start_u8 = dbg_sidecars["debug_start_u8"] }
            if debug_end_u8 == nil { debug_end_u8 = dbg_sidecars["debug_end_u8"] }
            if dbg_sidecars["debug_funcs_enc_norm"] != nil { meta["debug_funcs_enc"] = dbg_sidecars["debug_funcs_enc_norm"] }
            if debug_blob_u8 != nil && debug_patch_pos_u8 != nil {
                rtobj_store_debug_sidecars(cache_dir, key, debug_blob_u8, debug_patch_pos_u8, debug_start_u8, debug_end_u8)
                if trace { print("[rtobj] load debug sidecars rebuilt") }
            }
        }
    } else if debug_blob_u8 != nil && debug_patch_pos_u8 != nil {
        if trace { print("[rtobj] load debug sidecars hit") }
    }
    if debug_blob_u8 != nil { meta["debug_blob_u8"] = debug_blob_u8 }
    if debug_patch_pos_u8 != nil { meta["debug_patch_pos_u8"] = debug_patch_pos_u8 }
    if debug_start_u8 != nil { meta["debug_start_u8"] = debug_start_u8 }
    if debug_end_u8 != nil { meta["debug_end_u8"] = debug_end_u8 }
    meta["code_u8"] = code
    meta["data_tail_u8"] = data_tail
    meta["cache_dir"] = cache_dir
    meta["cache_key"] = key
    return meta
}

fn rtobj_store(cache_dir, key, meta, code_u8, data_tail_u8, cstr0_offsets_u8) {
    var trace = rtobj_trace_enabled()
    var t0 = 0
    if trace { t0 = oren_time_now_ns() }
    var paths = rtobj_paths(cache_dir, key)
    _ensure_dir(paths["dir"])
    if trace {
        var dt0 = oren_time_now_ns() - t0
        print("[rtobj] store ensure dir done +" + oren_int_to_string(dt0 / 1000000) + "ms")
        t0 = oren_time_now_ns()
    }
    var meta_bs = astbin.astbin_encode(meta)
    if meta_bs == nil { return nil }
    var meta_check = _rtobj_meta_check_build(meta_bs)
    if meta_check == nil { return nil }
    if trace {
        var dt1 = oren_time_now_ns() - t0
        print("[rtobj] store meta encode done +" + oren_int_to_string(dt1 / 1000000) + "ms bytes=" + oren_int_to_string(oren_buf_len(meta_bs)))
        t0 = oren_time_now_ns()
    }
    _rtobj_write_atomic(paths["meta"], meta_bs)
    if trace {
        var dt2 = oren_time_now_ns() - t0
        print("[rtobj] store meta write done +" + oren_int_to_string(dt2 / 1000000) + "ms")
        t0 = oren_time_now_ns()
    }
    _rtobj_write_atomic(paths["meta_check"], meta_check)
    if meta["fixups_compact"] != nil {
        rtobj_store_fixups_compact_sidecar(cache_dir, key, meta["fixups_compact"])
        var fixups_compact_u8_store = meta["fixups_compact_u8"]
        if fixups_compact_u8_store == nil {
            fixups_compact_u8_store = _rtobj_build_fixups_compact_u8_sidecars(meta["fixups_compact"], meta["fn_offs_enc"])
        }
        if fixups_compact_u8_store != nil {
            rtobj_store_fixups_compact_u8_sidecars(cache_dir, key, fixups_compact_u8_store)
        }
    }
    if cstr0_offsets_u8 != nil {
        rtobj_store_cstr0_offsets_sidecar(cache_dir, key, cstr0_offsets_u8)
    }
    if meta["debug_funcs_enc"] != nil {
        var dbg_sidecars_store = _rtobj_build_debug_blob_sidecars_from_enc(meta["debug_funcs_enc"])
        if dbg_sidecars_store != nil {
            if dbg_sidecars_store["debug_funcs_enc_norm"] != nil { meta["debug_funcs_enc"] = dbg_sidecars_store["debug_funcs_enc_norm"] }
            rtobj_store_debug_sidecars(cache_dir, key,
                dbg_sidecars_store["debug_blob_u8"],
                dbg_sidecars_store["debug_patch_pos_u8"],
                dbg_sidecars_store["debug_start_u8"],
                dbg_sidecars_store["debug_end_u8"])
        }
    }
    _rtobj_write_atomic(paths["code"], code_u8)
    if trace {
        var dt3 = oren_time_now_ns() - t0
        print("[rtobj] store code write done +" + oren_int_to_string(dt3 / 1000000) + "ms bytes=" + oren_int_to_string(oren_buf_len(code_u8)))
        t0 = oren_time_now_ns()
    }
    _rtobj_write_atomic(paths["data_tail"], data_tail_u8)
    if trace {
        var dt4 = oren_time_now_ns() - t0
        print("[rtobj] store data write done +" + oren_int_to_string(dt4 / 1000000) + "ms bytes=" + oren_int_to_string(oren_buf_len(data_tail_u8)))
    }
    return nil
}
