import optcore "optimizer_core.oren"
import optfold "optimizer_fold.oren"
import optdce "optimizer_dce.oren"
import optlistint "optimizer_list_int.oren"
import optlistreserve "optimizer_list_reserve.oren"
import opttco "optimizer_tco.oren"
import optconst "optimizer_constprop.oren"
import optloops "optimizer_loops.oren"
import opthelp "optimizer_helpers.oren"

// Optimizer baseline (rolling, conservative).
//
// Goal:
// - Provide a minimal, future-proof optimization layer without introducing a new IR.
// - Keep it deterministic and safe: never change observable behavior.
//
// Current scope:
// - Constant folding for small integer literals.
// - Algebraic peepholes (x+0, x*1, x*0, x-0) for integer expressions.
// - Conservative dead-code elimination for unused locals with trivial RHS.
//
// Non-goals (future):
// - Global DCE across control-flow.
// - Escape analysis / stack-vs-heap decisions.
// - Float folding/rounding.

fn nn_env_new() { return optfold.nn_env_new() }
fn set_trace_enabled(enabled) { return optfold.set_trace_enabled(enabled) }
fn parse_int(s) { return optcore.parse_int(s) }
fn fold_stmt(s, nn_env) { return optfold.fold_stmt(s, nn_env) }
fn dce_block_in_place(block) { return optdce.dce_block_in_place(block) }
fn _opt_lower_int_only_lists_in_block_opts(block, allow_empty, safe_ints_seed) {
    return optlistint._opt_lower_int_only_lists_in_block_opts(block, allow_empty, safe_ints_seed)
}
fn _opt_insert_list_reserve_in_block(block, last_list_lit, last_list_lit_len, last_list_lit_intsafe, last_list_int_new, last_int_safe) {
    return optlistreserve._opt_insert_list_reserve_in_block(block, last_list_lit, last_list_lit_len, last_list_lit_intsafe, last_list_int_new, last_int_safe)
}
fn _optimizer_list_pass_profile_reset(enabled) {
    optlistint._opt_list_int_profile_reset(enabled)
    optlistreserve._opt_list_reserve_profile_reset(enabled)
    optfold._opt_fold_profile_reset(enabled)
    optconst._opt_const_profile_reset(enabled)
    return nil
}
fn _optimizer_list_pass_profile_detail() {
    return optfold._opt_fold_profile_detail() +
        optlistint._opt_list_int_profile_detail() +
        optlistreserve._opt_list_reserve_profile_detail() +
        optconst._opt_const_profile_detail()
}
fn _tco_modconst_function_in_place(fun_expr) { return opttco._tco_modconst_function_in_place(fun_expr) }
fn _tco_function_in_place(fun_expr) { return opttco._tco_function_in_place(fun_expr) }
fn _tco_function_may_self_call(fun_expr) { return opttco._tco_function_may_self_call(fun_expr) }

fn _optimizer_phase_log_path() {
    var p = oren_env("OREN_TRACE_BUILD_PHASES_PATH")
    if p == nil || p == "" || p == "0" { return nil }
    return p
}

fn _optimizer_phase_log_append(path, phase, detail, t0) {
    if path == nil || phase == nil || phase == "" { return nil }
    var now = oren_time_now_ns()
    var line = "phase=" + phase + " now_ns=" + oren_int_to_string(now)
    if t0 != nil && t0 > 0 {
        line = line + " total_ms=" + oren_int_to_string((now - t0) / 1000000)
    }
    if detail != nil && detail != "" { line = line + " " + detail }
    var prev = oren_read_file(path)
    if oren_is_err(prev) { prev = "" }
    oren_write_file(path, prev + line + "\n")
    return nil
}

fn _optimizer_phase_elapsed(start_ns) {
    if start_ns == nil || start_ns <= 0 { return 0 }
    return oren_time_now_ns() - start_ns
}

fn _optimizer_function_name(fun_expr) {
    if fun_expr == nil { return "<unknown>" }
    var nm = fun_expr["name"]
    if nm == nil || nm == "" { return "<anon>" }
    return nm
}

fn _optimizer_progress_interval() {
    var v = oren_env("OREN_OPTIMIZER_PROGRESS_INTERVAL")
    if v == nil || v == "" { return 25 }
    if v == "0" || v == "false" { return 0 }
    var n = parse_int(v)
    if n < 0 { return 25 }
    return n
}

fn _optimizer_stmt_progress_name(stmt) {
    if stmt == nil { return "<nil>" }
    if stmt["type"] == "ExprStmt" && stmt["expr"] != nil && stmt["expr"]["type"] == "Function" {
        return _optimizer_function_name(stmt["expr"])
    }
    var t = stmt["type"]
    if t == nil || t == "" { return "<unknown>" }
    return t
}

fn _optimizer_hot_update(hot, pass, fn_name, ns) {
    if hot == nil || pass == nil || ns == nil || ns <= 0 { return nil }
    if ns < 1000000 { return nil }
    if fn_name == nil || fn_name == "" { fn_name = "<unknown>" }
    var ns1 = hot[pass + "_ns1"]
    var ns2 = hot[pass + "_ns2"]
    var ns3 = hot[pass + "_ns3"]
    if ns1 == nil { ns1 = 0 }
    if ns2 == nil { ns2 = 0 }
    if ns3 == nil { ns3 = 0 }
    if ns > ns1 {
        hot[pass + "_ns3"] = ns2
        hot[pass + "_fn3"] = hot[pass + "_fn2"]
        hot[pass + "_ns2"] = ns1
        hot[pass + "_fn2"] = hot[pass + "_fn1"]
        hot[pass + "_ns1"] = ns
        hot[pass + "_fn1"] = fn_name
        return nil
    }
    if ns > ns2 {
        hot[pass + "_ns3"] = ns2
        hot[pass + "_fn3"] = hot[pass + "_fn2"]
        hot[pass + "_ns2"] = ns
        hot[pass + "_fn2"] = fn_name
        return nil
    }
    if ns > ns3 {
        hot[pass + "_ns3"] = ns
        hot[pass + "_fn3"] = fn_name
    }
    return nil
}

fn _optimizer_hot_detail(hot, pass) {
    if hot == nil || pass == nil { return "" }
    var out = ""
    var rank = 1
    while rank <= 3 {
        var rank_s = oren_int_to_string(rank)
        var ns = hot[pass + "_ns" + rank_s]
        var fn_name = hot[pass + "_fn" + rank_s]
        if oren_type_tag(ns) != 0 && ns > 0 && oren_type_tag(fn_name) != 0 {
            out = out + " " + pass + rank_s + "_fn=" + fn_name +
                " " + pass + rank_s + "_ms=" + oren_int_to_string(ns / 1000000)
        }
        rank = rank + 1
    }
    return out
}

fn lower_linked_program_in_place(linked) {
    var trace_opt = oren_env("OREN_TRACE_OPTIMIZER") != nil
    if trace_opt { print("[opt] enter") }
    if linked == nil { return nil }
    set_trace_enabled(trace_opt)
    var phase_log_path = _optimizer_phase_log_path()
    var phase_t0 = 0
    var profile_phases = false
    if phase_log_path != nil {
        profile_phases = true
        phase_t0 = oren_time_now_ns()
    }
    var backend = nil
    if linked["config"] != nil { backend = linked["config"]["backend"] }
    optcore.set_backend(backend)
    optloops.set_backend(backend)

    // Fold expressions first (so DCE sees simplified RHS).
    var ss = linked["statements"]
    if trace_opt { print("[opt] got statements") }
    var i = 0
    var nn_env = nn_env_new()
    var ss_len = 0
    if ss != nil { ss_len = oren_list_len(ss) }
    var fn_count = 0
    var fold_ns = 0
    var tco_scan_ns = 0
    var tco_mod_ns = 0
    var tco_ns = 0
    var for_scan_ns = 0
    var for_ns = 0
    var sink_scan_ns = 0
    var sink_ns = 0
    var list_int_ns = 0
    var split_ns = 0
    var arena_ns = 0
    var reserve_ns = 0
    var const_ns = 0
    var dce_ns = 0
    var list_scan_ns = 0
    var list_candidate_count = 0
    var t_sub = 0
    var hot = {}
    var progress_interval = 0
    if profile_phases { progress_interval = _optimizer_progress_interval() }
    _optimizer_list_pass_profile_reset(profile_phases)
    if trace_opt { print("[opt] stmts_len=" + oren_int_to_string(ss_len)) }
    while i < ss_len {
        if profile_phases && progress_interval > 0 {
            var should_progress = false
            if i == 0 { should_progress = true }
            else if i + 1 == ss_len { should_progress = true }
            else if i - (i / progress_interval) * progress_interval == 0 { should_progress = true }
            if should_progress {
                var stp = ss[i]
                var st_type = "<nil>"
                if stp != nil && stp["type"] != nil { st_type = stp["type"] }
                _optimizer_phase_log_append(phase_log_path, "optimizer.progress",
                    "index=" + oren_int_to_string(i) +
                    " total=" + oren_int_to_string(ss_len) +
                    " funcs_seen=" + oren_int_to_string(fn_count) +
                    " type=" + st_type +
                    " name=" + _optimizer_stmt_progress_name(stp),
                    phase_t0)
            }
        }
        if trace_opt && i == 0 { print("[opt] fold first stmt type=" + ss[i]["type"]) }
        if profile_phases { t_sub = oren_time_now_ns() }
        fold_stmt(ss[i], nn_env)
        var fold_elapsed = 0
        if profile_phases {
            fold_elapsed = _optimizer_phase_elapsed(t_sub)
            fold_ns = fold_ns + fold_elapsed
        }
        // DCE for function bodies.
        if ss[i] != nil && ss[i]["type"] == "ExprStmt" && ss[i]["expr"] != nil && ss[i]["expr"]["type"] == "Function" {
            var fn_expr = ss[i]["expr"]
            var fn_name = _optimizer_function_name(fn_expr)
            if profile_phases { _optimizer_hot_update(hot, "fold", fn_name, fold_elapsed) }
            fn_count = fn_count + 1
            // Try to eliminate simple non-tail recursion first (modulo constant), then do plain tail recursion elimination.
            if profile_phases { t_sub = oren_time_now_ns() }
            var may_tco_self_call = _tco_function_may_self_call(fn_expr)
            if profile_phases { tco_scan_ns = tco_scan_ns + _optimizer_phase_elapsed(t_sub) }
            if trace_opt && i == 0 { print("[opt] tco_modconst start") }
            if profile_phases { t_sub = oren_time_now_ns() }
            if may_tco_self_call { _tco_modconst_function_in_place(fn_expr) }
            if profile_phases {
                var tco_mod_elapsed = _optimizer_phase_elapsed(t_sub)
                tco_mod_ns = tco_mod_ns + tco_mod_elapsed
                _optimizer_hot_update(hot, "tco_mod", fn_name, tco_mod_elapsed)
            }
            if trace_opt && i == 0 { print("[opt] tco_modconst done") }
            if trace_opt && i == 0 { print("[opt] tco start") }
            if profile_phases { t_sub = oren_time_now_ns() }
            if may_tco_self_call { _tco_function_in_place(fn_expr) }
            if profile_phases {
                var tco_elapsed = _optimizer_phase_elapsed(t_sub)
                tco_ns = tco_ns + tco_elapsed
                _optimizer_hot_update(hot, "tco", fn_name, tco_elapsed)
            }
            if trace_opt && i == 0 { print("[opt] tco done") }
            if profile_phases { t_sub = oren_time_now_ns() }
            var body_may_lower_for = opthelp.stmt_may_contain_for(fn_expr["body"])
            if profile_phases { for_scan_ns = for_scan_ns + _optimizer_phase_elapsed(t_sub) }
            if profile_phases { t_sub = oren_time_now_ns() }
            if body_may_lower_for { optloops.lower_simple_for_in_block(fn_expr["body"]) }
            if profile_phases {
                var for_elapsed = _optimizer_phase_elapsed(t_sub)
                for_ns = for_ns + for_elapsed
                _optimizer_hot_update(hot, "for", fn_name, for_elapsed)
            }
            var lower_allow_empty = true
            var body_may_touch_list = false
            if profile_phases { t_sub = oren_time_now_ns() }
            body_may_touch_list = opthelp.stmt_may_touch_list(fn_expr["body"])
            if profile_phases { list_scan_ns = list_scan_ns + _optimizer_phase_elapsed(t_sub) }
            if profile_phases { t_sub = oren_time_now_ns() }
            var body_may_sink_list_lit = body_may_touch_list && opthelp.stmt_may_contain_if(fn_expr["body"])
            if profile_phases { sink_scan_ns = sink_scan_ns + _optimizer_phase_elapsed(t_sub) }
            if profile_phases { t_sub = oren_time_now_ns() }
            if body_may_sink_list_lit { optloops.sink_list_lit_into_if(fn_expr["body"]) }
            if profile_phases {
                var sink_elapsed = _optimizer_phase_elapsed(t_sub)
                sink_ns = sink_ns + sink_elapsed
                _optimizer_hot_update(hot, "sink", fn_name, sink_elapsed)
            }
            if body_may_touch_list {
                list_candidate_count = list_candidate_count + 1
                if profile_phases { t_sub = oren_time_now_ns() }
                _opt_lower_int_only_lists_in_block_opts(fn_expr["body"], lower_allow_empty, nil)
                if profile_phases {
                    var list_int_elapsed = _optimizer_phase_elapsed(t_sub)
                    list_int_ns = list_int_ns + list_int_elapsed
                    _optimizer_hot_update(hot, "list_int", fn_name, list_int_elapsed)
                }
            }
            if profile_phases { t_sub = oren_time_now_ns() }
            optloops.split_invariant_list_push_in_block(fn_expr["body"])
            if profile_phases { split_ns = split_ns + _optimizer_phase_elapsed(t_sub) }
            if profile_phases { t_sub = oren_time_now_ns() }
            optloops.wrap_arena_loops_in_block(fn_expr["body"])
            if profile_phases { arena_ns = arena_ns + _optimizer_phase_elapsed(t_sub) }
            if body_may_touch_list {
                if profile_phases { t_sub = oren_time_now_ns() }
                _opt_insert_list_reserve_in_block(fn_expr["body"], nil, nil, nil, nil, nil)
                if profile_phases {
                    var reserve_elapsed = _optimizer_phase_elapsed(t_sub)
                    reserve_ns = reserve_ns + reserve_elapsed
                    _optimizer_hot_update(hot, "reserve", fn_name, reserve_elapsed)
                }
            }
            if profile_phases { t_sub = oren_time_now_ns() }
            if optconst.const_block_may_need_mod_rewrite(fn_expr["body"]) {
                optconst.rewrite_const_mod_in_block(fn_expr["body"], nil)
            }
            if profile_phases { const_ns = const_ns + _optimizer_phase_elapsed(t_sub) }
            if trace_opt && i == 0 { print("[opt] dce start") }
            if profile_phases { t_sub = oren_time_now_ns() }
            dce_block_in_place(fn_expr["body"])
            if profile_phases {
                var dce_elapsed = _optimizer_phase_elapsed(t_sub)
                dce_ns = dce_ns + dce_elapsed
                _optimizer_hot_update(hot, "dce", fn_name, dce_elapsed)
            }
            if trace_opt && i == 0 { print("[opt] dce done") }
        }
        i = i + 1
    }
    if profile_phases {
        var detail = "stmts=" + oren_int_to_string(ss_len) +
            " funcs=" + oren_int_to_string(fn_count) +
            " list_candidates=" + oren_int_to_string(list_candidate_count) +
            " fold_ms=" + oren_int_to_string(fold_ns / 1000000) +
            " list_scan_ms=" + oren_int_to_string(list_scan_ns / 1000000) +
            " tco_scan_ms=" + oren_int_to_string(tco_scan_ns / 1000000) +
            " tco_mod_ms=" + oren_int_to_string(tco_mod_ns / 1000000) +
            " tco_ms=" + oren_int_to_string(tco_ns / 1000000) +
            " for_scan_ms=" + oren_int_to_string(for_scan_ns / 1000000) +
            " for_ms=" + oren_int_to_string(for_ns / 1000000) +
            " sink_scan_ms=" + oren_int_to_string(sink_scan_ns / 1000000) +
            " sink_ms=" + oren_int_to_string(sink_ns / 1000000) +
            " list_int_ms=" + oren_int_to_string(list_int_ns / 1000000) +
            " split_ms=" + oren_int_to_string(split_ns / 1000000) +
            " arena_ms=" + oren_int_to_string(arena_ns / 1000000) +
            " reserve_ms=" + oren_int_to_string(reserve_ns / 1000000) +
            " const_ms=" + oren_int_to_string(const_ns / 1000000) +
            " dce_ms=" + oren_int_to_string(dce_ns / 1000000) +
            _optimizer_hot_detail(hot, "fold") +
            _optimizer_hot_detail(hot, "tco_mod") +
            _optimizer_hot_detail(hot, "tco") +
            _optimizer_hot_detail(hot, "for") +
            _optimizer_hot_detail(hot, "sink") +
            _optimizer_hot_detail(hot, "list_int") +
            _optimizer_hot_detail(hot, "reserve") +
            _optimizer_hot_detail(hot, "dce") +
            _optimizer_list_pass_profile_detail()
        _optimizer_phase_log_append(phase_log_path, "optimizer.summary", detail, phase_t0)
    }
    return nil
}
