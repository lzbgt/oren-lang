import ast "ast.oren"
import intparse "int_lit.oren"
import optconst "optimizer_constprop.oren"
import opthelp "optimizer_helpers.oren"
import optloops "optimizer_loops.oren"

// Optimizer baseline (rolling, conservative).
//
// Goal:
// - Provide a minimal, future-proof optimization layer without introducing a new IR.
// - Keep it deterministic and safe: never change observable behavior.
//
// Current scope:
// - Constant folding for small integer literals.
// - Algebraic peepholes (x+0, x*1, x*0, x-0) for integer expressions.
// - Conservative dead-code elimination for unused locals with trivial RHS.
//
// Non-goals (future):
// - Global DCE across control-flow.
// - Escape analysis / stack-vs-heap decisions.
// - Float folding/rounding.

var OPT_TRACE_BUDGET = 200
var OPT_BACKEND = nil

fn opt_trace(msg) {
    if oren_env("OREN_TRACE_OPTIMIZER") == nil { return nil }
    if OPT_TRACE_BUDGET <= 0 { return nil }
    OPT_TRACE_BUDGET = OPT_TRACE_BUDGET - 1
    print(msg)
    return nil
}

fn _opt_backend_allows_list_int_unchecked() {
    if OPT_BACKEND == nil { return true }
    return OPT_BACKEND != "c"
}

fn is_int_lit(e) {
    return e != nil && e["type"] == "Integer" && e["value"] != nil
}

fn parse_int(s) { return intparse.parse_int_lit(s) }

fn abs_int(n) {
    if n < 0 { return -n }
    return n
}

fn small_int(n) {
    // Keep folds safely within host integer range.
    // (We intentionally do not assume i64 wrap semantics for the compiler itself.)
    return abs_int(n) <= 1000000000
}

fn int_lit(n) {
    return {"type": "Integer", "token": nil, "value": oren_int_to_string(n)}
}

fn bool_lit(v) {
    return {"type": "Boolean", "token": nil, "value": v}
}

fn is_nil_lit(e) {
    return e != nil && e["type"] == "Nil"
}

fn is_bool_lit(e) {
    return e != nil && e["type"] == "Boolean" && e["value"] != nil
}

fn is_string_lit(e) {
    return e != nil && e["type"] == "String" && e["value"] != nil
}

fn streq_bytes(a, b) {
    if a == nil || b == nil { return false }
    var na = oren_string_len(a)
    var nb = oren_string_len(b)
    if na != nb { return false }
    var i = 0
    while i < na {
        if oren_string_byte_at_unchecked(a, i) != oren_string_byte_at_unchecked(b, i) { return false }
        i = i + 1
    }
    return true
}

fn expr_is_trivial_literal(e) {
    // Trivial, side-effect-free literal/value forms.
    if e == nil { return true }
    var t = e["type"]
    if t == "Integer" || t == "Float" || t == "String" || t == "Boolean" || t == "Nil" { return true }
    return false
}

// Non-nil analysis (flow-sensitive, very conservative).
//
// Primary use-case: make `x == nil` safe in the native backend when `x` is known to be non-nil
// (e.g. numeric locals like `var n = 0`).
//
// State encoding:
// - 0: unknown
// - 1: definitely non-nil at this point
//
// Note:
// - We intentionally do not track "definitely nil" here.
//   This optimizer runs before multiple compiler passes (including DCE), and the AST can contain
//   control-flow forms that this pass does not fully model; treating a local as "definitely nil"
//   can incorrectly fold away later reads and cause downstream passes to drop required locals.
fn nn_env_new() { return [{}] }

fn nn_env_push(env) {
    var out = []
    var i = 0
    while i < oren_list_len(env) {
        oren_list_push(out, env[i])
        i = i + 1
    }
    oren_list_push(out, {})
    return out
}

fn nn_env_clone(env) {
    if env == nil { return nn_env_new() }
    var out = []
    var i = 0
    while i < oren_list_len(env) {
        var frame = env[i]
        var f2 = {}
        if frame != nil {
            for k in frame {
                f2[k] = frame[k]
            }
        }
        oren_list_push(out, f2)
        i = i + 1
    }
    if oren_list_len(out) == 0 { return nn_env_new() }
    return out
}

fn nn_env_set(env, name, state) {
    if env == nil { return nil }
    if name == nil { return nil }
    env[oren_list_len(env) - 1][name] = state
    return nil
}

fn nn_env_get(env, name) {
    if env == nil { return 0 }
    if name == nil { return 0 }
    var i = oren_list_len(env) - 1
    while i >= 0 {
        var v = env[i][name]
        if v != nil { return v }
        i = i - 1
    }
    return 0
}

fn expr_is_definitely_non_nil_trivial(e, nn_env) {
    if e == nil { return false }
    var t = e["type"]
    if t == "Identifier" {
        return nn_env_get(nn_env, e["value"]) == 1
    }
    // Any literal form other than `nil` is non-nil.
    if t == "Integer" || t == "Float" || t == "String" || t == "Boolean" { return true }
    return false
}

fn fold_type_strict_eq(op, left, right, nn_env) {
    if op != "==" && op != "!=" { return nil }

    // Literal-vs-literal folds (type-strict equality).
    if expr_is_trivial_literal(left) && expr_is_trivial_literal(right) {
        var lt = "nil"
        var rt = "nil"
        if left != nil && left["type"] != nil { lt = left["type"] }
        if right != nil && right["type"] != nil { rt = right["type"] }

        if lt == "Nil" && rt == "Nil" { return bool_lit(op == "==") }

        if lt == "Boolean" && rt == "Boolean" {
            var eqb = left["value"] == right["value"]
            if op == "!=" { eqb = !eqb }
            return bool_lit(eqb)
        }

        if lt == "Integer" && rt == "Integer" {
            var av = parse_int(left["value"])
            var bv = parse_int(right["value"])
            if !oren_is_err(av) && !oren_is_err(bv) {
                var eqi = av == bv
                if op == "!=" { eqi = !eqi }
                return bool_lit(eqi)
            }
        }

        if lt == "String" && rt == "String" {
            var eqs = streq_bytes(left["value"], right["value"])
            if op == "!=" { eqs = !eqs }
            return bool_lit(eqs)
        }

        // Different literal types are never equal (type-strict).
        if lt != rt {
            return bool_lit(op == "!=")
        }
    }

    // Flow-sensitive folds for side-effect-free identifiers vs nil.
    if nn_env != nil {
        if (left != nil && left["type"] == "Identifier" && is_nil_lit(right)) ||
           (right != nil && right["type"] == "Identifier" && is_nil_lit(left)) {
            var id = left
            if id["type"] != "Identifier" { id = right }
            var st = nn_env_get(nn_env, id["value"])
            if st == 1 { return bool_lit(op == "!=") }
        }
    }

    return nil
}

fn fold_infix(op, a, b) {
    // Only fold when both sides are small int literals.
    if !is_int_lit(a) || !is_int_lit(b) { return nil }
    var av = parse_int(a["value"])
    var bv = parse_int(b["value"])
    if oren_is_err(av) || oren_is_err(bv) { return nil }
    if !small_int(av) || !small_int(bv) { return nil }

    if op == "+" { return int_lit(av + bv) }
    if op == "-" { return int_lit(av - bv) }
    if op == "*" { return int_lit(av * bv) }

    // Avoid folding ops that can trap or are semantics-sensitive without a full model.
    // - "/" can trap on div0
    // - shifts can trap on invalid counts (backend-dependent today)
    return nil
}

fn is_zero(e) {
    if !is_int_lit(e) { return false }
    var n = parse_int(e["value"])
    return !oren_is_err(n) && n == 0
}

fn is_one(e) {
    if !is_int_lit(e) { return false }
    var n = parse_int(e["value"])
    return !oren_is_err(n) && n == 1
}

fn fold_peephole_infix(op, left, right) {
    // Simple algebraic identities (safe).
    if op == "+" {
        if is_zero(right) { return left }
        if is_zero(left) { return right }
    }
    if op == "-" {
        if is_zero(right) { return left }
    }
    if op == "*" {
        if is_one(right) { return left }
        if is_one(left) { return right }
        // NOTE: Do NOT fold `x * 0` to `0` here: that would drop evaluation of `x`
        // (and any side effects) without a purity analysis. Keep it conservative.
    }
    return nil
}

fn expr_trivial(e) {
    // Trivial, side-effect-free RHS suitable for DCE removal when unused.
    if e == nil { return true }
    if e["type"] == "Integer" || e["type"] == "Float" || e["type"] == "String" || e["type"] == "Boolean" || e["type"] == "Nil" { return true }
    if e["type"] == "Identifier" { return true }
    return false
}

fn env_new() { return [{}] }

fn env_push(env) {
    // Create a new env stack (do not mutate the parent env list).
    var out = []
    var i = 0
    while i < oren_list_len(env) {
        oren_list_push(out, env[i])
        i = i + 1
    }
    oren_list_push(out, {})
    return out
}

fn env_pop(env) {
    if oren_list_len(env) <= 1 { return env }
    var out = []
    var i = 0
    while i < oren_list_len(env) - 1 {
        oren_list_push(out, env[i])
        i = i + 1
    }
    return out
}

fn env_set(env, name) {
    if name == nil { return nil }
    env[oren_list_len(env) - 1][name] = true
    return nil
}

fn env_has(env, name) {
    if name == nil { return false }
    var i = oren_list_len(env) - 1
    while i >= 0 {
        if env[i][name] == true { return true }
        i = i - 1
    }
    return false
}

fn collect_uses_expr(e, uses, env) {
    if e == nil { return nil }
    var t = e["type"]
    if t == "Identifier" {
        var nm = e["value"]
        if nm != nil && !env_has(env, nm) {
            if uses[nm] == nil { uses[nm] = 0 }
            uses[nm] = uses[nm] + 1
        }
        return nil
    }
    if t == "Prefix" {
        collect_uses_expr(e["right"], uses, env)
        return nil
    }
    if t == "Infix" {
        collect_uses_expr(e["left"], uses, env)
        collect_uses_expr(e["right"], uses, env)
        return nil
    }
    if t == "If" {
        collect_uses_expr(e["cond"], uses, env)
        collect_uses_stmt(e["consq"], uses, env)
        if e["alt"] != nil { collect_uses_stmt(e["alt"], uses, env) }
        return nil
    }
    if t == "Array" {
        var xs = e["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            collect_uses_expr(xs[i], uses, env)
            i = i + 1
        }
        return nil
    }
    if t == "Hash" {
        var ps = e["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            collect_uses_expr(ps[i2]["key"], uses, env)
            collect_uses_expr(ps[i2]["value"], uses, env)
            i2 = i2 + 1
        }
        return nil
    }
    if t == "Index" {
        collect_uses_expr(e["left"], uses, env)
        collect_uses_expr(e["index"], uses, env)
        return nil
    }
    if t == "Member" {
        collect_uses_expr(e["left"], uses, env)
        return nil
    }
    if t == "SpawnExpr" {
        collect_uses_expr(e["call"], uses, env)
        return nil
    }
    if t == "Call" {
        collect_uses_expr(e["fn"], uses, env)
        var args = e["args"]
        var i3 = 0
        while i3 < oren_list_len(args) {
            collect_uses_expr(args[i3], uses, env)
            i3 = i3 + 1
        }
        if e["spread"] != nil { collect_uses_expr(e["spread"], uses, env) }
        return nil
    }
    if t == "Function" {
        // New local scope for params + locals.
        var new_env = env_push(env)
        var params = e["params"]
        if params != nil {
            var pi = 0
            while pi < oren_list_len(params) {
                var id = params[pi]
                if id != nil && id["type"] == "Identifier" {
                    env_set(new_env, id["value"])
                }
                pi = pi + 1
            }
        }
        collect_uses_stmt(e["body"], uses, new_env)
        return nil
    }
    return nil
}

fn collect_uses_stmt(s, uses, env) {
    if s == nil { return nil }
    var t = s["type"]
    if t == "Block" {
        var new_env = env_push(env)
        var ss = s["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            collect_uses_stmt(ss[i], uses, new_env)
            i = i + 1
        }
        return nil
    }
    if t == "Var" {
        // Note: don't count the LHS as a use.
        collect_uses_expr(s["value"], uses, env)
        // Bind the name only for *locals* (not top-level).
        // Top-level vars are globals and must remain visible to functions/imported code.
        if oren_list_len(env) > 1 {
            var nm = s["name"]
            if nm != nil && nm["type"] == "Identifier" {
                env_set(env, nm["value"])
            }
        }
        return nil
    }
    if t == "Assign" {
        // Do not count LHS as a read.
        collect_uses_expr(s["value"], uses, env)
        return nil
    }
    if t == "Set" {
        // Member/index bases are reads.
        collect_uses_expr(s["left"], uses, env)
        collect_uses_expr(s["value"], uses, env)
        return nil
    }
    if t == "ExprStmt" {
        collect_uses_expr(s["expr"], uses, env)
        return nil
    }
    if t == "Return" {
        collect_uses_expr(s["value"], uses, env)
        return nil
    }
    if t == "While" {
        collect_uses_expr(s["cond"], uses, env)
        collect_uses_stmt(s["body"], uses, env)
        return nil
    }
    if t == "For" {
        var new_env = env_push(env)
        collect_uses_stmt(s["init"], uses, new_env)
        collect_uses_expr(s["cond"], uses, new_env)
        collect_uses_expr(s["post"], uses, new_env)
        collect_uses_stmt(s["body"], uses, new_env)
        return nil
    }
    return nil
}

fn fold_expr(e, nn_env) {
    if e == nil { return nil }
    var t = e["type"]
    opt_trace("[opt] fold_expr t=" + t)
    if t == "Prefix" {
        e["right"] = fold_expr(e["right"], nn_env)
        return e
    }
    if t == "Infix" {
        opt_trace("[opt] infix: left fold start")
        e["left"] = fold_expr(e["left"], nn_env)
        opt_trace("[opt] infix: left fold done")
        opt_trace("[opt] infix: right fold start")
        e["right"] = fold_expr(e["right"], nn_env)
        opt_trace("[opt] infix: right fold done")
        // constant fold
        var op = e["op"]
        opt_trace("[opt] infix: op=" + op)
        var folded = fold_infix(op, e["left"], e["right"])
        opt_trace("[opt] infix: fold_infix done")
        if folded != nil { return folded }
        var folded_eq = fold_type_strict_eq(op, e["left"], e["right"], nn_env)
        if folded_eq != nil { return folded_eq }
        // peepholes
        var peep = fold_peephole_infix(op, e["left"], e["right"])
        opt_trace("[opt] infix: fold_peephole done")
        if peep != nil { return peep }
        return e
    }
    if t == "If" {
        e["cond"] = fold_expr(e["cond"], nn_env)

        // Fold branches in isolation (do not let flow-sensitive facts leak across control-flow).
        var snap = nn_env_clone(nn_env)
        fold_stmt(e["consq"], nn_env_push(nn_env_clone(snap)))
        if e["alt"] != nil { fold_stmt(e["alt"], nn_env_push(nn_env_clone(snap))) }
        return e
    }
    if t == "Array" {
        var xs = e["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            xs[i] = fold_expr(xs[i], nn_env)
            i = i + 1
        }
        return e
    }
    if t == "Hash" {
        var ps = e["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            ps[i2]["key"] = fold_expr(ps[i2]["key"], nn_env)
            ps[i2]["value"] = fold_expr(ps[i2]["value"], nn_env)
            i2 = i2 + 1
        }
        return e
    }
    if t == "Index" {
        e["left"] = fold_expr(e["left"], nn_env)
        e["index"] = fold_expr(e["index"], nn_env)
        return e
    }
    if t == "Member" {
        e["left"] = fold_expr(e["left"], nn_env)
        return e
    }
    if t == "SpawnExpr" {
        e["call"] = fold_expr(e["call"], nn_env)
        return e
    }
    if t == "Call" {
        e["fn"] = fold_expr(e["fn"], nn_env)
        var args = e["args"]
        if args == nil {
            opt_trace("[opt] call: args is nil (treat as 0 args)")
        } else {
            var i3 = 0
            while i3 < oren_list_len(args) {
                args[i3] = fold_expr(args[i3], nn_env)
                i3 = i3 + 1
            }
        }
        if e["spread"] != nil { e["spread"] = fold_expr(e["spread"], nn_env) }
        return e
    }
    if t == "Function" {
        // New flow environment for function locals.
        fold_stmt(e["body"], nn_env_push(nn_env_new()))
        return e
    }
    return e
}

fn fold_stmt(s, nn_env) {
    if s == nil { return nil }
    var t = s["type"]
    opt_trace("[opt] fold_stmt t=" + t)
    if t == "Block" {
        var ss = s["stmts"]
        var env2 = nn_env_push(nn_env)
        var i = 0
        while i < oren_list_len(ss) {
            fold_stmt(ss[i], env2)
            i = i + 1
        }
        return nil
    }
    if t == "Var" {
        s["value"] = fold_expr(s["value"], nn_env)
        if nn_env != nil {
            var nm = s["name"]
            if nm != nil && nm["type"] == "Identifier" {
                var name = nm["value"]
                var rhs = s["value"]
                if expr_is_definitely_non_nil_trivial(rhs, nn_env) {
                    nn_env_set(nn_env, name, 1)
                } else {
                    nn_env_set(nn_env, name, 0)
                }
            }
        }
        return nil
    }
    if t == "Assign" {
        s["value"] = fold_expr(s["value"], nn_env)
        if nn_env != nil {
            var left = s["left"]
            if left != nil && left["type"] == "Identifier" {
                var name2 = left["value"]
                var rhs2 = s["value"]
                if expr_is_definitely_non_nil_trivial(rhs2, nn_env) {
                    nn_env_set(nn_env, name2, 1)
                } else {
                    nn_env_set(nn_env, name2, 0)
                }
            }
        }
        return nil
    }
    if t == "Set" {
        s["left"] = fold_expr(s["left"], nn_env)
        s["value"] = fold_expr(s["value"], nn_env)
        return nil
    }
    if t == "ExprStmt" {
        s["expr"] = fold_expr(s["expr"], nn_env)
        return nil
    }
    if t == "Return" {
        opt_trace("[opt] return: fold value start")
        s["value"] = fold_expr(s["value"], nn_env)
        opt_trace("[opt] return: fold value done")
        return nil
    }
    if t == "While" {
        s["cond"] = fold_expr(s["cond"], nn_env)
        // Fold loop body in isolation (loop-carried facts are not tracked here).
        fold_stmt(s["body"], nn_env_push(nn_env_clone(nn_env)))
        return nil
    }
    if t == "For" {
        var snap2 = nn_env_clone(nn_env)
        fold_stmt(s["init"], nn_env_push(nn_env_clone(snap2)))
        s["cond"] = fold_expr(s["cond"], nn_env)
        s["post"] = fold_expr(s["post"], nn_env)
        fold_stmt(s["body"], nn_env_push(nn_env_clone(snap2)))
        return nil
    }
    return nil
}

fn collect_reads_expr(e, reads) {
    // Count identifier reads (conservative; may over-count due to shadowing).
    if e == nil { return nil }
    var t = e["type"]
    if t == "Identifier" {
        var nm = e["value"]
        if nm != nil {
            if reads[nm] == nil { reads[nm] = 0 }
            reads[nm] = reads[nm] + 1
        }
        return nil
    }
    if t == "Prefix" {
        collect_reads_expr(e["right"], reads)
        return nil
    }
    if t == "Infix" {
        collect_reads_expr(e["left"], reads)
        collect_reads_expr(e["right"], reads)
        return nil
    }
    if t == "If" {
        collect_reads_expr(e["cond"], reads)
        collect_reads_stmt(e["consq"], reads)
        if e["alt"] != nil { collect_reads_stmt(e["alt"], reads) }
        return nil
    }
    if t == "Array" {
        var xs = e["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            collect_reads_expr(xs[i], reads)
            i = i + 1
        }
        return nil
    }
    if t == "Hash" {
        var ps = e["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            collect_reads_expr(ps[i2]["key"], reads)
            collect_reads_expr(ps[i2]["value"], reads)
            i2 = i2 + 1
        }
        return nil
    }
    if t == "Index" {
        collect_reads_expr(e["left"], reads)
        collect_reads_expr(e["index"], reads)
        return nil
    }
    if t == "Member" {
        collect_reads_expr(e["left"], reads)
        return nil
    }
    if t == "SpawnExpr" {
        collect_reads_expr(e["call"], reads)
        return nil
    }
    if t == "Call" {
        collect_reads_expr(e["fn"], reads)
        var args = e["args"]
        var i3 = 0
        while i3 < oren_list_len(args) {
            collect_reads_expr(args[i3], reads)
            i3 = i3 + 1
        }
        if e["spread"] != nil { collect_reads_expr(e["spread"], reads) }
        return nil
    }
    if t == "Function" {
        // Captures are real reads; include nested functions.
        collect_reads_stmt(e["body"], reads)
        return nil
    }
    return nil
}

fn collect_reads_stmt(s, reads) {
    if s == nil { return nil }
    var t = s["type"]
    if t == "Block" {
        var ss = s["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            collect_reads_stmt(ss[i], reads)
            i = i + 1
        }
        return nil
    }
    if t == "Var" {
        collect_reads_expr(s["value"], reads)
        return nil
    }
    if t == "Assign" {
        // LHS is a write; don't count it as a read.
        collect_reads_expr(s["value"], reads)
        return nil
    }
    if t == "Set" {
        // Member/index bases are reads.
        collect_reads_expr(s["left"], reads)
        collect_reads_expr(s["value"], reads)
        return nil
    }
    if t == "ExprStmt" {
        collect_reads_expr(s["expr"], reads)
        return nil
    }
    if t == "Return" {
        collect_reads_expr(s["value"], reads)
        return nil
    }
    if t == "While" {
        collect_reads_expr(s["cond"], reads)
        collect_reads_stmt(s["body"], reads)
        return nil
    }
    if t == "For" {
        collect_reads_stmt(s["init"], reads)
        collect_reads_expr(s["cond"], reads)
        collect_reads_expr(s["post"], reads)
        collect_reads_stmt(s["body"], reads)
        return nil
    }
    if t == "Function" {
        collect_reads_stmt(s["body"], reads)
        return nil
    }
    return nil
}

fn dce_block_in_place(block) {
    // DCE only for locals inside blocks (function bodies), never for top-level globals.
    if block == nil || block["type"] != "Block" { return nil }

    // Recurse first.
    var ss = block["stmts"]
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        if st != nil && st["type"] == "Block" { dce_block_in_place(st) }
        if st != nil && st["type"] == "While" { dce_block_in_place(st["body"]) }
        if st != nil && st["type"] == "For" { dce_block_in_place(st["body"]) }
        if st != nil && st["type"] == "ExprStmt" && st["expr"] != nil && st["expr"]["type"] == "Function" {
            dce_block_in_place(st["expr"]["body"])
        }
        i = i + 1
    }

    // Collect reads in this block (including nested blocks).
    var reads = {}
    i = 0
    while i < oren_list_len(ss) {
        collect_reads_stmt(ss[i], reads)
        i = i + 1
    }

    var out = []
    i = 0
    while i < oren_list_len(ss) {
        var st2 = ss[i]
        if st2 != nil && st2["type"] == "Var" {
            var nm = st2["name"]
            if nm != nil && nm["type"] == "Identifier" {
                var name = nm["value"]
                if name != nil && (reads[name] == nil || reads[name] == 0) {
                    if expr_trivial(st2["value"]) {
                        i = i + 1
                        continue
                    }
                }
            }
        }
        oren_list_push(out, st2)
        i = i + 1
    }
    block["stmts"] = out
    return nil
}

// --- List reserve insertion (rolling, conservative) ---
//
// Insert `oren_list_reserve(list, n)` (or `oren_list_int_reserve`) before
// `while i < n { list.push(...) }` loops
// when:
// - `n` is an int literal or a local that was most-recently assigned an int literal, and
// - the list was most-recently assigned a list literal (`[]`) in the same block.
// - or the list was most-recently assigned `oren_new_list_int(...)` in the same block,
// - or the list was most-recently assigned an int-only list literal in the same block (list_int only).
//
// This is intentionally conservative to avoid introducing new runtime panics when
// `n` or `list` are not the expected types.

fn _opt_is_len_call(expr) {
    if expr == nil || expr["type"] != "Call" { return false }
    var fnn = expr["fn"]
    if fnn == nil || fnn["type"] != "Identifier" { return false }
    var nm = fnn["value"]
    if nm != "oren_list_len" && nm != "oren_list_int_len" && nm != "oren_list_int_len_unchecked" &&
        nm != "oren_map_len" && nm != "oren_buf_len" && nm != "oren_string_len" {
        return false
    }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 { return false }
    var arg0 = args[0]
    if arg0 == nil || arg0["type"] != "Identifier" { return false }
    return true
}

fn _opt_is_safe_int_expr(expr, last_int_safe) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Integer" { return true }
    if t == "Identifier" {
        var nm = expr["value"]
        if nm != nil && last_int_safe != nil && last_int_safe[nm] == true { return true }
        return false
    }
    if _opt_is_len_call(expr) { return true }
    if t == "Prefix" {
        var op0 = expr["op"]
        if op0 == "-" || op0 == "+" { return _opt_is_safe_int_expr(expr["right"], last_int_safe) }
        return false
    }
    if t == "Infix" {
        var op = expr["op"]
        if op == "+" || op == "-" || op == "*" || op == "%" {
            if _opt_is_safe_int_expr(expr["left"], last_int_safe) && _opt_is_safe_int_expr(expr["right"], last_int_safe) { return true }
        }
        return false
    }
    return false
}

fn _opt_is_empty_list_lit(expr) {
    if expr == nil || expr["type"] != "Array" { return false }
    var els = expr["elements"]
    if els == nil { return true }
    return oren_list_len(els) == 0
}

fn _opt_call_name(expr) {
    if expr == nil || expr["type"] != "Call" { return nil }
    var fnn = expr["fn"]
    if fnn == nil { return nil }
    if fnn["type"] == "Identifier" { return fnn["value"] }
    if fnn["type"] == "Member" {
        var left = fnn["left"]
        var prop = fnn["prop"]
        if left != nil && prop != nil && left["type"] == "Identifier" && left["value"] == "list" {
            var p = prop["value"]
            if p == "push" { return "STD_list_push" }
            if p == "len" { return "STD_list_len" }
            if p == "get" { return "STD_list_get" }
            if p == "set" { return "STD_list_set" }
            if p == "reserve" { return "STD_list_reserve" }
            if p == "int_new" { return "STD_list_int_new" }
            if p == "int_push" { return "STD_list_int_push" }
            if p == "int_get" { return "STD_list_int_get" }
            if p == "int_set" { return "STD_list_int_set" }
            if p == "int_len" { return "STD_list_int_len" }
            if p == "int_reserve" { return "STD_list_int_reserve" }
        }
    }
    return nil
}

fn _opt_list_int_call_is_safe(nm, args, safe_ints) {
    if nm == nil { return false }
    if args == nil || oren_list_len(args) < 1 { return false }
    if nm == "oren_list_len" || nm == "STD_list_len" ||
        nm == "oren_list_int_len" || nm == "STD_list_int_len" ||
        nm == "oren_list_int_len_unchecked" || nm == "STD_list_int_len_unchecked" {
        return true
    }
    if nm == "oren_list_push" || nm == "STD_list_push" || nm == "oren_list_int_push" || nm == "STD_list_int_push" {
        if oren_list_len(args) < 2 { return false }
        return _opt_is_safe_int_expr(args[1], safe_ints)
    }
    if nm == "oren_list_get" || nm == "STD_list_get" ||
        nm == "oren_list_int_get" || nm == "STD_list_int_get" ||
        nm == "oren_list_int_get_unchecked" || nm == "STD_list_int_get_unchecked" {
        if oren_list_len(args) < 2 { return false }
        return _opt_is_safe_int_expr(args[1], safe_ints)
    }
    if nm == "oren_list_set" || nm == "STD_list_set" || nm == "oren_list_int_set" || nm == "STD_list_int_set" {
        if oren_list_len(args) < 3 { return false }
        if _opt_is_safe_int_expr(args[1], safe_ints) != true { return false }
        return _opt_is_safe_int_expr(args[2], safe_ints)
    }
    if nm == "oren_list_reserve" || nm == "STD_list_reserve" ||
        nm == "oren_list_int_reserve" || nm == "STD_list_int_reserve" {
        if oren_list_len(args) < 2 { return false }
        return _opt_is_safe_int_expr(args[1], safe_ints)
    }
    return false
}

fn _opt_list_int_rewrite_name(nm) {
    if nm == "oren_list_push" || nm == "STD_list_push" { return "oren_list_int_push" }
    if nm == "oren_list_len" || nm == "STD_list_len" { return "oren_list_int_len" }
    if nm == "oren_list_get" || nm == "STD_list_get" { return "oren_list_int_get" }
    if nm == "oren_list_set" || nm == "STD_list_set" { return "oren_list_int_set" }
    if nm == "oren_list_reserve" || nm == "STD_list_reserve" { return "oren_list_int_reserve" }
    return nil
}

fn _opt_list_state_is_candidate(list_state, name) {
    if list_state == nil || name == nil { return false }
    return list_state[name] != nil
}

fn _opt_list_state_is_safe(list_state, name) {
    if list_state == nil || name == nil { return false }
    return list_state[name] == true
}

fn _opt_list_state_mark_unsafe(list_state, name) {
    if list_state == nil || name == nil { return nil }
    if list_state[name] != nil { list_state[name] = false }
    return nil
}

fn _opt_list_touch_mark(list_touch, name) {
    if list_touch == nil || name == nil { return nil }
    list_touch[name] = true
    return nil
}

fn _opt_map_clone_safe(m) {
    var out = {}
    if m != nil {
        for k in m {
            out[k] = m[k]
        }
    }
    return out
}

fn _opt_safe_ints_invalidate_in_stmt(stmt, safe_ints) {
    if stmt == nil || safe_ints == nil { return nil }
    var t = stmt["type"]
    if t == "Var" || t == "Assign" {
        var nm = opthelp.is_ident(stmt["name"])
        if nm != nil { safe_ints[nm] = false }
        return nil
    }
    if t == "Set" {
        var left = stmt["left"]
        if left != nil && left["type"] == "Identifier" {
            var nm2 = left["value"]
            if nm2 != nil { safe_ints[nm2] = false }
        }
        return nil
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                _opt_safe_ints_invalidate_in_stmt(ss[i], safe_ints)
                i = i + 1
            }
        }
        return nil
    }
    if t == "If" {
        _opt_safe_ints_invalidate_in_stmt(stmt["consq"], safe_ints)
        if stmt["alt"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["alt"], safe_ints) }
        return nil
    }
    if t == "While" {
        _opt_safe_ints_invalidate_in_stmt(stmt["body"], safe_ints)
        return nil
    }
    if t == "For" {
        if stmt["init"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["init"], safe_ints) }
        if stmt["post"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["post"], safe_ints) }
        if stmt["body"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["body"], safe_ints) }
        return nil
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil { _opt_safe_ints_invalidate_in_stmt(c["body"], safe_ints) }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil { _opt_safe_ints_invalidate_in_stmt(stmt["default"], safe_ints) }
        return nil
    }
    if t == "Function" { return nil }
    return nil
}

fn _opt_scan_list_int_uses_expr(expr, list_state, safe_ints) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Identifier" {
        _opt_list_state_mark_unsafe(list_state, expr["value"])
        return nil
    }
    if t == "Index" {
        var list_name = opthelp.is_ident(expr["left"])
        if list_name != nil && _opt_list_state_is_candidate(list_state, list_name) {
            if _opt_is_safe_int_expr(expr["index"], safe_ints) != true {
                _opt_list_state_mark_unsafe(list_state, list_name)
            }
            _opt_scan_list_int_uses_expr(expr["index"], list_state, safe_ints)
            return nil
        }
        _opt_scan_list_int_uses_expr(expr["left"], list_state, safe_ints)
        _opt_scan_list_int_uses_expr(expr["index"], list_state, safe_ints)
        return nil
    }
    if t == "Call" {
        var nm = _opt_call_name(expr)
        var args = expr["args"]
        if nm != nil && args != nil && oren_list_len(args) > 0 {
            var recv_name = opthelp.is_ident(args[0])
            if recv_name != nil && _opt_list_state_is_candidate(list_state, recv_name) {
                if _opt_list_int_call_is_safe(nm, args, safe_ints) != true {
                    _opt_list_state_mark_unsafe(list_state, recv_name)
                }
                var ai = 1
                while ai < oren_list_len(args) {
                    _opt_scan_list_int_uses_expr(args[ai], list_state, safe_ints)
                    ai = ai + 1
                }
                if expr["spread"] != nil { _opt_scan_list_int_uses_expr(expr["spread"], list_state, safe_ints) }
                return nil
            }
        }
        if expr["fn"] != nil { _opt_scan_list_int_uses_expr(expr["fn"], list_state, safe_ints) }
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                _opt_scan_list_int_uses_expr(args[i], list_state, safe_ints)
                i = i + 1
            }
        }
        if expr["spread"] != nil { _opt_scan_list_int_uses_expr(expr["spread"], list_state, safe_ints) }
        return nil
    }
    if t == "Prefix" { return _opt_scan_list_int_uses_expr(expr["right"], list_state, safe_ints) }
    if t == "Infix" {
        _opt_scan_list_int_uses_expr(expr["left"], list_state, safe_ints)
        _opt_scan_list_int_uses_expr(expr["right"], list_state, safe_ints)
        return nil
    }
    if t == "If" {
        _opt_scan_list_int_uses_expr(expr["cond"], list_state, safe_ints)
        _opt_scan_list_int_uses_stmt(expr["consq"], list_state, _opt_map_clone_safe(safe_ints))
        if expr["alt"] != nil { _opt_scan_list_int_uses_stmt(expr["alt"], list_state, _opt_map_clone_safe(safe_ints)) }
        _opt_safe_ints_invalidate_in_stmt(expr["consq"], safe_ints)
        if expr["alt"] != nil { _opt_safe_ints_invalidate_in_stmt(expr["alt"], safe_ints) }
        return nil
    }
    if t == "Function" {
        // Captures cross block boundaries; treat any candidate list use as unsafe.
        if expr["body"] != nil { _opt_mark_list_state_unsafe_in_stmt(expr["body"], list_state) }
        return nil
    }
    if t == "Array" {
        var els = expr["elements"]
        if els != nil {
            var i2 = 0
            while i2 < oren_list_len(els) {
                _opt_scan_list_int_uses_expr(els[i2], list_state, safe_ints)
                i2 = i2 + 1
            }
        }
        return nil
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        if ps != nil {
            var i3 = 0
            while i3 < oren_list_len(ps) {
                _opt_scan_list_int_uses_expr(ps[i3]["key"], list_state, safe_ints)
                _opt_scan_list_int_uses_expr(ps[i3]["value"], list_state, safe_ints)
                i3 = i3 + 1
            }
        }
        return nil
    }
    if t == "Member" { return _opt_scan_list_int_uses_expr(expr["left"], list_state, safe_ints) }
    if t == "Switch" {
        _opt_scan_list_int_uses_expr(expr["cond"], list_state, safe_ints)
        var cases = expr["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && c["body"] != nil {
                    _opt_scan_list_int_uses_stmt(c["body"], list_state, _opt_map_clone_safe(safe_ints))
                }
                ci = ci + 1
            }
        }
        if expr["default"] != nil { _opt_scan_list_int_uses_stmt(expr["default"], list_state, _opt_map_clone_safe(safe_ints)) }
        if cases != nil {
            var ci2 = 0
            while ci2 < oren_list_len(cases) {
                var c2 = cases[ci2]
                if c2 != nil && c2["body"] != nil { _opt_safe_ints_invalidate_in_stmt(c2["body"], safe_ints) }
                ci2 = ci2 + 1
            }
        }
        if expr["default"] != nil { _opt_safe_ints_invalidate_in_stmt(expr["default"], safe_ints) }
        return nil
    }
    return nil
}

fn _opt_mark_list_state_unsafe_in_expr(expr, list_state) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Identifier" {
        _opt_list_state_mark_unsafe(list_state, expr["value"])
        return nil
    }
    if t == "Index" {
        _opt_mark_list_state_unsafe_in_expr(expr["left"], list_state)
        _opt_mark_list_state_unsafe_in_expr(expr["index"], list_state)
        return nil
    }
    if t == "Call" {
        if expr["fn"] != nil { _opt_mark_list_state_unsafe_in_expr(expr["fn"], list_state) }
        var args = expr["args"]
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                _opt_mark_list_state_unsafe_in_expr(args[i], list_state)
                i = i + 1
            }
        }
        if expr["spread"] != nil { _opt_mark_list_state_unsafe_in_expr(expr["spread"], list_state) }
        return nil
    }
    if t == "Prefix" { return _opt_mark_list_state_unsafe_in_expr(expr["right"], list_state) }
    if t == "Infix" {
        _opt_mark_list_state_unsafe_in_expr(expr["left"], list_state)
        _opt_mark_list_state_unsafe_in_expr(expr["right"], list_state)
        return nil
    }
    if t == "If" {
        _opt_mark_list_state_unsafe_in_expr(expr["cond"], list_state)
        if expr["consq"] != nil { _opt_mark_list_state_unsafe_in_stmt(expr["consq"], list_state) }
        if expr["alt"] != nil { _opt_mark_list_state_unsafe_in_stmt(expr["alt"], list_state) }
        return nil
    }
    if t == "Array" {
        var els = expr["elements"]
        if els != nil {
            var i2 = 0
            while i2 < oren_list_len(els) {
                _opt_mark_list_state_unsafe_in_expr(els[i2], list_state)
                i2 = i2 + 1
            }
        }
        return nil
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        if ps != nil {
            var i3 = 0
            while i3 < oren_list_len(ps) {
                _opt_mark_list_state_unsafe_in_expr(ps[i3]["key"], list_state)
                _opt_mark_list_state_unsafe_in_expr(ps[i3]["value"], list_state)
                i3 = i3 + 1
            }
        }
        return nil
    }
    if t == "Member" { return _opt_mark_list_state_unsafe_in_expr(expr["left"], list_state) }
    if t == "Switch" {
        _opt_mark_list_state_unsafe_in_expr(expr["cond"], list_state)
        var cases2 = expr["cases"]
        if cases2 != nil {
            var ci2 = 0
            while ci2 < oren_list_len(cases2) {
                var c2 = cases2[ci2]
                if c2 != nil && c2["body"] != nil { _opt_mark_list_state_unsafe_in_stmt(c2["body"], list_state) }
                ci2 = ci2 + 1
            }
        }
        if expr["default"] != nil { _opt_mark_list_state_unsafe_in_stmt(expr["default"], list_state) }
        return nil
    }
    if t == "Function" {
        if expr["body"] != nil { _opt_mark_list_state_unsafe_in_stmt(expr["body"], list_state) }
        return nil
    }
    return nil
}

fn _opt_mark_list_state_unsafe_in_stmt(stmt, list_state) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "ExprStmt" { return _opt_mark_list_state_unsafe_in_expr(stmt["expr"], list_state) }
    if t == "Return" { return _opt_mark_list_state_unsafe_in_expr(stmt["value"], list_state) }
    if t == "Var" || t == "Assign" {
        return _opt_mark_list_state_unsafe_in_expr(stmt["value"], list_state)
    }
    if t == "Set" {
        _opt_mark_list_state_unsafe_in_expr(stmt["left"], list_state)
        _opt_mark_list_state_unsafe_in_expr(stmt["value"], list_state)
        return nil
    }
    if t == "If" {
        _opt_mark_list_state_unsafe_in_expr(stmt["cond"], list_state)
        _opt_mark_list_state_unsafe_in_stmt(stmt["consq"], list_state)
        if stmt["alt"] != nil { _opt_mark_list_state_unsafe_in_stmt(stmt["alt"], list_state) }
        return nil
    }
    if t == "While" {
        _opt_mark_list_state_unsafe_in_expr(stmt["cond"], list_state)
        _opt_mark_list_state_unsafe_in_stmt(stmt["body"], list_state)
        return nil
    }
    if t == "For" {
        if stmt["init"] != nil { _opt_mark_list_state_unsafe_in_stmt(stmt["init"], list_state) }
        if stmt["cond"] != nil { _opt_mark_list_state_unsafe_in_expr(stmt["cond"], list_state) }
        if stmt["post"] != nil { _opt_mark_list_state_unsafe_in_stmt(stmt["post"], list_state) }
        if stmt["body"] != nil { _opt_mark_list_state_unsafe_in_stmt(stmt["body"], list_state) }
        return nil
    }
    if t == "Block" {
        var ss = stmt["stmts"]
        if ss != nil {
            var i = 0
            while i < oren_list_len(ss) {
                _opt_mark_list_state_unsafe_in_stmt(ss[i], list_state)
                i = i + 1
            }
        }
        return nil
    }
    if t == "Switch" {
        _opt_mark_list_state_unsafe_in_expr(stmt["cond"], list_state)
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && c["body"] != nil { _opt_mark_list_state_unsafe_in_stmt(c["body"], list_state) }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil { _opt_mark_list_state_unsafe_in_stmt(stmt["default"], list_state) }
        return nil
    }
    if t == "Function" {
        if stmt["body"] != nil { _opt_mark_list_state_unsafe_in_stmt(stmt["body"], list_state) }
        return nil
    }
    return nil
}

fn _opt_scan_list_int_uses_stmt(stmt, list_state, safe_ints) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "ExprStmt" { return _opt_scan_list_int_uses_expr(stmt["expr"], list_state, safe_ints) }
    if t == "Return" { return _opt_scan_list_int_uses_expr(stmt["value"], list_state, safe_ints) }
    if t == "Var" || t == "Assign" {
        return _opt_scan_list_int_uses_expr(stmt["value"], list_state, safe_ints)
    }
    if t == "Set" {
        var left = stmt["left"]
        if left != nil && left["type"] == "Index" {
            var list_name = opthelp.is_ident(left["left"])
            if list_name != nil && _opt_list_state_is_candidate(list_state, list_name) {
                if _opt_is_safe_int_expr(left["index"], safe_ints) != true {
                    _opt_list_state_mark_unsafe(list_state, list_name)
                }
                if _opt_is_safe_int_expr(stmt["value"], safe_ints) != true {
                    _opt_list_state_mark_unsafe(list_state, list_name)
                }
                _opt_scan_list_int_uses_expr(stmt["value"], list_state, safe_ints)
                return nil
            }
        }
        _opt_scan_list_int_uses_expr(stmt["left"], list_state, safe_ints)
        _opt_scan_list_int_uses_expr(stmt["value"], list_state, safe_ints)
        return nil
    }
    if t == "If" {
        _opt_scan_list_int_uses_expr(stmt["cond"], list_state, safe_ints)
        _opt_scan_list_int_uses_stmt(stmt["consq"], list_state, _opt_map_clone_safe(safe_ints))
