import ast "ast.oren"
import intparse "int_lit.oren"

// Optimizer baseline (rolling, conservative).
//
// Goal:
// - Provide a minimal, future-proof optimization layer without introducing a new IR.
// - Keep it deterministic and safe: never change observable behavior.
//
// Current scope:
// - Constant folding for small integer literals.
// - Algebraic peepholes (x+0, x*1, x*0, x-0) for integer expressions.
// - Conservative dead-code elimination for unused locals with trivial RHS.
//
// Non-goals (future):
// - Global DCE across control-flow.
// - Escape analysis / stack-vs-heap decisions.
// - Float folding/rounding.

var OPT_TRACE_BUDGET = 200

fn opt_trace(msg) {
    if oren_env("OREN_TRACE_OPTIMIZER") == nil { return nil }
    if OPT_TRACE_BUDGET <= 0 { return nil }
    OPT_TRACE_BUDGET = OPT_TRACE_BUDGET - 1
    print(msg)
    return nil
}

fn is_int_lit(e) {
    return e != nil && e["type"] == "Integer" && e["value"] != nil
}

fn parse_int(s) { return intparse.parse_int_lit(s) }

fn abs_int(n) {
    if n < 0 { return -n }
    return n
}

fn small_int(n) {
    // Keep folds safely within host integer range.
    // (We intentionally do not assume i64 wrap semantics for the compiler itself.)
    return abs_int(n) <= 1000000000
}

fn int_lit(n) {
    return {"type": "Integer", "token": nil, "value": oren_int_to_string(n)}
}

fn bool_lit(v) {
    return {"type": "Boolean", "token": nil, "value": v}
}

fn is_nil_lit(e) {
    return e != nil && e["type"] == "Nil"
}

fn is_bool_lit(e) {
    return e != nil && e["type"] == "Boolean" && e["value"] != nil
}

fn is_string_lit(e) {
    return e != nil && e["type"] == "String" && e["value"] != nil
}

fn streq_bytes(a, b) {
    if a == nil || b == nil { return false }
    var na = oren_string_len(a)
    var nb = oren_string_len(b)
    if na != nb { return false }
    var i = 0
    while i < na {
        if oren_string_byte_at_unchecked(a, i) != oren_string_byte_at_unchecked(b, i) { return false }
        i = i + 1
    }
    return true
}

fn expr_is_trivial_literal(e) {
    // Trivial, side-effect-free literal/value forms.
    if e == nil { return true }
    var t = e["type"]
    if t == "Integer" || t == "Float" || t == "String" || t == "Boolean" || t == "Nil" { return true }
    return false
}

// Non-nil analysis (flow-sensitive, very conservative).
//
// Primary use-case: make `x == nil` safe in the native backend when `x` is known to be non-nil
// (e.g. numeric locals like `var n = 0`).
//
// State encoding:
// - 0: unknown
// - 1: definitely non-nil at this point
//
// Note:
// - We intentionally do not track "definitely nil" here.
//   This optimizer runs before multiple compiler passes (including DCE), and the AST can contain
//   control-flow forms that this pass does not fully model; treating a local as "definitely nil"
//   can incorrectly fold away later reads and cause downstream passes to drop required locals.
fn nn_env_new() { return [{}] }

fn nn_env_push(env) {
    var out = []
    var i = 0
    while i < oren_list_len(env) {
        oren_list_push(out, env[i])
        i = i + 1
    }
    oren_list_push(out, {})
    return out
}

fn nn_env_clone(env) {
    if env == nil { return nn_env_new() }
    var out = []
    var i = 0
    while i < oren_list_len(env) {
        var frame = env[i]
        var f2 = {}
        if frame != nil {
            for k in frame {
                f2[k] = frame[k]
            }
        }
        oren_list_push(out, f2)
        i = i + 1
    }
    if oren_list_len(out) == 0 { return nn_env_new() }
    return out
}

fn nn_env_set(env, name, state) {
    if env == nil { return nil }
    if name == nil { return nil }
    env[oren_list_len(env) - 1][name] = state
    return nil
}

fn nn_env_get(env, name) {
    if env == nil { return 0 }
    if name == nil { return 0 }
    var i = oren_list_len(env) - 1
    while i >= 0 {
        var v = env[i][name]
        if v != nil { return v }
        i = i - 1
    }
    return 0
}

fn expr_is_definitely_non_nil_trivial(e, nn_env) {
    if e == nil { return false }
    var t = e["type"]
    if t == "Identifier" {
        return nn_env_get(nn_env, e["value"]) == 1
    }
    // Any literal form other than `nil` is non-nil.
    if t == "Integer" || t == "Float" || t == "String" || t == "Boolean" { return true }
    return false
}

fn fold_type_strict_eq(op, left, right, nn_env) {
    if op != "==" && op != "!=" { return nil }

    // Literal-vs-literal folds (type-strict equality).
    if expr_is_trivial_literal(left) && expr_is_trivial_literal(right) {
        var lt = "nil"
        var rt = "nil"
        if left != nil && left["type"] != nil { lt = left["type"] }
        if right != nil && right["type"] != nil { rt = right["type"] }

        if lt == "Nil" && rt == "Nil" { return bool_lit(op == "==") }

        if lt == "Boolean" && rt == "Boolean" {
            var eqb = left["value"] == right["value"]
            if op == "!=" { eqb = !eqb }
            return bool_lit(eqb)
        }

        if lt == "Integer" && rt == "Integer" {
            var av = parse_int(left["value"])
            var bv = parse_int(right["value"])
            if !oren_is_err(av) && !oren_is_err(bv) {
                var eqi = av == bv
                if op == "!=" { eqi = !eqi }
                return bool_lit(eqi)
            }
        }

        if lt == "String" && rt == "String" {
            var eqs = streq_bytes(left["value"], right["value"])
            if op == "!=" { eqs = !eqs }
            return bool_lit(eqs)
        }

        // Different literal types are never equal (type-strict).
        if lt != rt {
            return bool_lit(op == "!=")
        }
    }

    // Flow-sensitive folds for side-effect-free identifiers vs nil.
    if nn_env != nil {
        if (left != nil && left["type"] == "Identifier" && is_nil_lit(right)) ||
           (right != nil && right["type"] == "Identifier" && is_nil_lit(left)) {
            var id = left
            if id["type"] != "Identifier" { id = right }
            var st = nn_env_get(nn_env, id["value"])
            if st == 1 { return bool_lit(op == "!=") }
        }
    }

    return nil
}

fn fold_infix(op, a, b) {
    // Only fold when both sides are small int literals.
    if !is_int_lit(a) || !is_int_lit(b) { return nil }
    var av = parse_int(a["value"])
    var bv = parse_int(b["value"])
    if oren_is_err(av) || oren_is_err(bv) { return nil }
    if !small_int(av) || !small_int(bv) { return nil }

    if op == "+" { return int_lit(av + bv) }
    if op == "-" { return int_lit(av - bv) }
    if op == "*" { return int_lit(av * bv) }

    // Avoid folding ops that can trap or are semantics-sensitive without a full model.
    // - "/" can trap on div0
    // - shifts can trap on invalid counts (backend-dependent today)
    return nil
}

fn is_zero(e) {
    if !is_int_lit(e) { return false }
    var n = parse_int(e["value"])
    return !oren_is_err(n) && n == 0
}

fn is_one(e) {
    if !is_int_lit(e) { return false }
    var n = parse_int(e["value"])
    return !oren_is_err(n) && n == 1
}

fn fold_peephole_infix(op, left, right) {
    // Simple algebraic identities (safe).
    if op == "+" {
        if is_zero(right) { return left }
        if is_zero(left) { return right }
    }
    if op == "-" {
        if is_zero(right) { return left }
    }
    if op == "*" {
        if is_one(right) { return left }
        if is_one(left) { return right }
        // NOTE: Do NOT fold `x * 0` to `0` here: that would drop evaluation of `x`
        // (and any side effects) without a purity analysis. Keep it conservative.
    }
    return nil
}

fn expr_trivial(e) {
    // Trivial, side-effect-free RHS suitable for DCE removal when unused.
    if e == nil { return true }
    if e["type"] == "Integer" || e["type"] == "Float" || e["type"] == "String" || e["type"] == "Boolean" || e["type"] == "Nil" { return true }
    if e["type"] == "Identifier" { return true }
    return false
}

fn env_new() { return [{}] }

fn env_push(env) {
    // Create a new env stack (do not mutate the parent env list).
    var out = []
    var i = 0
    while i < oren_list_len(env) {
        oren_list_push(out, env[i])
        i = i + 1
    }
    oren_list_push(out, {})
    return out
}

fn env_pop(env) {
    if oren_list_len(env) <= 1 { return env }
    var out = []
    var i = 0
    while i < oren_list_len(env) - 1 {
        oren_list_push(out, env[i])
        i = i + 1
    }
    return out
}

fn env_set(env, name) {
    if name == nil { return nil }
    env[oren_list_len(env) - 1][name] = true
    return nil
}

fn env_has(env, name) {
    if name == nil { return false }
    var i = oren_list_len(env) - 1
    while i >= 0 {
        if env[i][name] == true { return true }
        i = i - 1
    }
    return false
}

fn collect_uses_expr(e, uses, env) {
    if e == nil { return nil }
    var t = e["type"]
    if t == "Identifier" {
        var nm = e["value"]
        if nm != nil && !env_has(env, nm) {
            if uses[nm] == nil { uses[nm] = 0 }
            uses[nm] = uses[nm] + 1
        }
        return nil
    }
    if t == "Prefix" {
        collect_uses_expr(e["right"], uses, env)
        return nil
    }
    if t == "Infix" {
        collect_uses_expr(e["left"], uses, env)
        collect_uses_expr(e["right"], uses, env)
        return nil
    }
    if t == "If" {
        collect_uses_expr(e["cond"], uses, env)
        collect_uses_stmt(e["consq"], uses, env)
        if e["alt"] != nil { collect_uses_stmt(e["alt"], uses, env) }
        return nil
    }
    if t == "Array" {
        var xs = e["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            collect_uses_expr(xs[i], uses, env)
            i = i + 1
        }
        return nil
    }
    if t == "Hash" {
        var ps = e["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            collect_uses_expr(ps[i2]["key"], uses, env)
            collect_uses_expr(ps[i2]["value"], uses, env)
            i2 = i2 + 1
        }
        return nil
    }
    if t == "Index" {
        collect_uses_expr(e["left"], uses, env)
        collect_uses_expr(e["index"], uses, env)
        return nil
    }
    if t == "Member" {
        collect_uses_expr(e["left"], uses, env)
        return nil
    }
    if t == "SpawnExpr" {
        collect_uses_expr(e["call"], uses, env)
        return nil
    }
    if t == "Call" {
        collect_uses_expr(e["fn"], uses, env)
        var args = e["args"]
        var i3 = 0
        while i3 < oren_list_len(args) {
            collect_uses_expr(args[i3], uses, env)
            i3 = i3 + 1
        }
        if e["spread"] != nil { collect_uses_expr(e["spread"], uses, env) }
        return nil
    }
    if t == "Function" {
        // New local scope for params + locals.
        var new_env = env_push(env)
        var params = e["params"]
        if params != nil {
            var pi = 0
            while pi < oren_list_len(params) {
                var id = params[pi]
                if id != nil && id["type"] == "Identifier" {
                    env_set(new_env, id["value"])
                }
                pi = pi + 1
            }
        }
        collect_uses_stmt(e["body"], uses, new_env)
        return nil
    }
    return nil
}

fn collect_uses_stmt(s, uses, env) {
    if s == nil { return nil }
    var t = s["type"]
    if t == "Block" {
        var new_env = env_push(env)
        var ss = s["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            collect_uses_stmt(ss[i], uses, new_env)
            i = i + 1
        }
        return nil
    }
    if t == "Var" {
        // Note: don't count the LHS as a use.
        collect_uses_expr(s["value"], uses, env)
        // Bind the name only for *locals* (not top-level).
        // Top-level vars are globals and must remain visible to functions/imported code.
        if oren_list_len(env) > 1 {
            var nm = s["name"]
            if nm != nil && nm["type"] == "Identifier" {
                env_set(env, nm["value"])
            }
        }
        return nil
    }
    if t == "Assign" {
        // Do not count LHS as a read.
        collect_uses_expr(s["value"], uses, env)
        return nil
    }
    if t == "Set" {
        // Member/index bases are reads.
        collect_uses_expr(s["left"], uses, env)
        collect_uses_expr(s["value"], uses, env)
        return nil
    }
    if t == "ExprStmt" {
        collect_uses_expr(s["expr"], uses, env)
        return nil
    }
    if t == "Return" {
        collect_uses_expr(s["value"], uses, env)
        return nil
    }
    if t == "While" {
        collect_uses_expr(s["cond"], uses, env)
        collect_uses_stmt(s["body"], uses, env)
        return nil
    }
    if t == "For" {
        var new_env = env_push(env)
        collect_uses_stmt(s["init"], uses, new_env)
        collect_uses_expr(s["cond"], uses, new_env)
        collect_uses_expr(s["post"], uses, new_env)
        collect_uses_stmt(s["body"], uses, new_env)
        return nil
    }
    return nil
}

fn fold_expr(e, nn_env) {
    if e == nil { return nil }
    var t = e["type"]
    opt_trace("[opt] fold_expr t=" + t)
    if t == "Prefix" {
        e["right"] = fold_expr(e["right"], nn_env)
        return e
    }
    if t == "Infix" {
        opt_trace("[opt] infix: left fold start")
        e["left"] = fold_expr(e["left"], nn_env)
        opt_trace("[opt] infix: left fold done")
        opt_trace("[opt] infix: right fold start")
        e["right"] = fold_expr(e["right"], nn_env)
        opt_trace("[opt] infix: right fold done")
        // constant fold
        var op = e["op"]
        opt_trace("[opt] infix: op=" + op)
        var folded = fold_infix(op, e["left"], e["right"])
        opt_trace("[opt] infix: fold_infix done")
        if folded != nil { return folded }
        var folded_eq = fold_type_strict_eq(op, e["left"], e["right"], nn_env)
        if folded_eq != nil { return folded_eq }
        // peepholes
        var peep = fold_peephole_infix(op, e["left"], e["right"])
        opt_trace("[opt] infix: fold_peephole done")
        if peep != nil { return peep }
        return e
    }
    if t == "If" {
        e["cond"] = fold_expr(e["cond"], nn_env)

        // Fold branches in isolation (do not let flow-sensitive facts leak across control-flow).
        var snap = nn_env_clone(nn_env)
        fold_stmt(e["consq"], nn_env_push(nn_env_clone(snap)))
        if e["alt"] != nil { fold_stmt(e["alt"], nn_env_push(nn_env_clone(snap))) }
        return e
    }
    if t == "Array" {
        var xs = e["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            xs[i] = fold_expr(xs[i], nn_env)
            i = i + 1
        }
        return e
    }
    if t == "Hash" {
        var ps = e["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            ps[i2]["key"] = fold_expr(ps[i2]["key"], nn_env)
            ps[i2]["value"] = fold_expr(ps[i2]["value"], nn_env)
            i2 = i2 + 1
        }
        return e
    }
    if t == "Index" {
        e["left"] = fold_expr(e["left"], nn_env)
        e["index"] = fold_expr(e["index"], nn_env)
        return e
    }
    if t == "Member" {
        e["left"] = fold_expr(e["left"], nn_env)
        return e
    }
    if t == "SpawnExpr" {
        e["call"] = fold_expr(e["call"], nn_env)
        return e
    }
    if t == "Call" {
        e["fn"] = fold_expr(e["fn"], nn_env)
        var args = e["args"]
        if args == nil {
            opt_trace("[opt] call: args is nil (treat as 0 args)")
        } else {
            var i3 = 0
            while i3 < oren_list_len(args) {
                args[i3] = fold_expr(args[i3], nn_env)
                i3 = i3 + 1
            }
        }
        if e["spread"] != nil { e["spread"] = fold_expr(e["spread"], nn_env) }
        return e
    }
    if t == "Function" {
        // New flow environment for function locals.
        fold_stmt(e["body"], nn_env_push(nn_env_new()))
        return e
    }
    return e
}

fn fold_stmt(s, nn_env) {
    if s == nil { return nil }
    var t = s["type"]
    opt_trace("[opt] fold_stmt t=" + t)
    if t == "Block" {
        var ss = s["stmts"]
        var env2 = nn_env_push(nn_env)
        var i = 0
        while i < oren_list_len(ss) {
            fold_stmt(ss[i], env2)
            i = i + 1
        }
        return nil
    }
    if t == "Var" {
        s["value"] = fold_expr(s["value"], nn_env)
        if nn_env != nil {
            var nm = s["name"]
            if nm != nil && nm["type"] == "Identifier" {
                var name = nm["value"]
                var rhs = s["value"]
                if expr_is_definitely_non_nil_trivial(rhs, nn_env) {
                    nn_env_set(nn_env, name, 1)
                } else {
                    nn_env_set(nn_env, name, 0)
                }
            }
        }
        return nil
    }
    if t == "Assign" {
        s["value"] = fold_expr(s["value"], nn_env)
        if nn_env != nil {
            var left = s["left"]
            if left != nil && left["type"] == "Identifier" {
                var name2 = left["value"]
                var rhs2 = s["value"]
                if expr_is_definitely_non_nil_trivial(rhs2, nn_env) {
                    nn_env_set(nn_env, name2, 1)
                } else {
                    nn_env_set(nn_env, name2, 0)
                }
            }
        }
        return nil
    }
    if t == "Set" {
        s["left"] = fold_expr(s["left"], nn_env)
        s["value"] = fold_expr(s["value"], nn_env)
        return nil
    }
    if t == "ExprStmt" {
        s["expr"] = fold_expr(s["expr"], nn_env)
        return nil
    }
    if t == "Return" {
        opt_trace("[opt] return: fold value start")
        s["value"] = fold_expr(s["value"], nn_env)
        opt_trace("[opt] return: fold value done")
        return nil
    }
    if t == "While" {
        s["cond"] = fold_expr(s["cond"], nn_env)
        // Fold loop body in isolation (loop-carried facts are not tracked here).
        fold_stmt(s["body"], nn_env_push(nn_env_clone(nn_env)))
        return nil
    }
    if t == "For" {
        var snap2 = nn_env_clone(nn_env)
        fold_stmt(s["init"], nn_env_push(nn_env_clone(snap2)))
        s["cond"] = fold_expr(s["cond"], nn_env)
        s["post"] = fold_expr(s["post"], nn_env)
        fold_stmt(s["body"], nn_env_push(nn_env_clone(snap2)))
        return nil
    }
    return nil
}

fn collect_reads_expr(e, reads) {
    // Count identifier reads (conservative; may over-count due to shadowing).
    if e == nil { return nil }
    var t = e["type"]
    if t == "Identifier" {
        var nm = e["value"]
        if nm != nil {
            if reads[nm] == nil { reads[nm] = 0 }
            reads[nm] = reads[nm] + 1
        }
        return nil
    }
    if t == "Prefix" {
        collect_reads_expr(e["right"], reads)
        return nil
    }
    if t == "Infix" {
        collect_reads_expr(e["left"], reads)
        collect_reads_expr(e["right"], reads)
        return nil
    }
    if t == "If" {
        collect_reads_expr(e["cond"], reads)
        collect_reads_stmt(e["consq"], reads)
        if e["alt"] != nil { collect_reads_stmt(e["alt"], reads) }
        return nil
    }
    if t == "Array" {
        var xs = e["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            collect_reads_expr(xs[i], reads)
            i = i + 1
        }
        return nil
    }
    if t == "Hash" {
        var ps = e["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            collect_reads_expr(ps[i2]["key"], reads)
            collect_reads_expr(ps[i2]["value"], reads)
            i2 = i2 + 1
        }
        return nil
    }
    if t == "Index" {
        collect_reads_expr(e["left"], reads)
        collect_reads_expr(e["index"], reads)
        return nil
    }
    if t == "Member" {
        collect_reads_expr(e["left"], reads)
        return nil
    }
    if t == "SpawnExpr" {
        collect_reads_expr(e["call"], reads)
        return nil
    }
    if t == "Call" {
        collect_reads_expr(e["fn"], reads)
        var args = e["args"]
        var i3 = 0
        while i3 < oren_list_len(args) {
            collect_reads_expr(args[i3], reads)
            i3 = i3 + 1
        }
        if e["spread"] != nil { collect_reads_expr(e["spread"], reads) }
        return nil
    }
    if t == "Function" {
        // Captures are real reads; include nested functions.
        collect_reads_stmt(e["body"], reads)
        return nil
    }
    return nil
}

fn collect_reads_stmt(s, reads) {
    if s == nil { return nil }
    var t = s["type"]
    if t == "Block" {
        var ss = s["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            collect_reads_stmt(ss[i], reads)
            i = i + 1
        }
        return nil
    }
    if t == "Var" {
        collect_reads_expr(s["value"], reads)
        return nil
    }
    if t == "Assign" {
        // LHS is a write; don't count it as a read.
        collect_reads_expr(s["value"], reads)
        return nil
    }
    if t == "Set" {
        // Member/index bases are reads.
        collect_reads_expr(s["left"], reads)
        collect_reads_expr(s["value"], reads)
        return nil
    }
    if t == "ExprStmt" {
        collect_reads_expr(s["expr"], reads)
        return nil
    }
    if t == "Return" {
        collect_reads_expr(s["value"], reads)
        return nil
    }
    if t == "While" {
        collect_reads_expr(s["cond"], reads)
        collect_reads_stmt(s["body"], reads)
        return nil
    }
    if t == "For" {
        collect_reads_stmt(s["init"], reads)
        collect_reads_expr(s["cond"], reads)
        collect_reads_expr(s["post"], reads)
        collect_reads_stmt(s["body"], reads)
        return nil
    }
    if t == "Function" {
        collect_reads_stmt(s["body"], reads)
        return nil
    }
    return nil
}

fn dce_block_in_place(block) {
    // DCE only for locals inside blocks (function bodies), never for top-level globals.
    if block == nil || block["type"] != "Block" { return nil }

    // Recurse first.
    var ss = block["stmts"]
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        if st != nil && st["type"] == "Block" { dce_block_in_place(st) }
        if st != nil && st["type"] == "While" { dce_block_in_place(st["body"]) }
        if st != nil && st["type"] == "For" { dce_block_in_place(st["body"]) }
        if st != nil && st["type"] == "ExprStmt" && st["expr"] != nil && st["expr"]["type"] == "Function" {
            dce_block_in_place(st["expr"]["body"])
        }
        i = i + 1
    }

    // Collect reads in this block (including nested blocks).
    var reads = {}
    i = 0
    while i < oren_list_len(ss) {
        collect_reads_stmt(ss[i], reads)
        i = i + 1
    }

    var out = []
    i = 0
    while i < oren_list_len(ss) {
        var st2 = ss[i]
        if st2 != nil && st2["type"] == "Var" {
            var nm = st2["name"]
            if nm != nil && nm["type"] == "Identifier" {
                var name = nm["value"]
                if name != nil && (reads[name] == nil || reads[name] == 0) {
                    if expr_trivial(st2["value"]) {
                        i = i + 1
                        continue
                    }
                }
            }
        }
        oren_list_push(out, st2)
        i = i + 1
    }
    block["stmts"] = out
    return nil
}

// --- List reserve insertion (rolling, conservative) ---
//
// Insert `oren_list_reserve(list, n)` (or `oren_list_int_reserve`) before
// `while i < n { list.push(...) }` loops
// when:
// - `n` is an int literal or a local that was most-recently assigned an int literal, and
// - the list was most-recently assigned a list literal (`[]`) in the same block.
// - or the list was most-recently assigned `oren_new_list_int(...)` in the same block.
//
// This is intentionally conservative to avoid introducing new runtime panics when
// `n` or `list` are not the expected types.

fn _opt_is_ident(expr) {
    if expr == nil || expr["type"] != "Identifier" { return nil }
    return expr["value"]
}

fn _opt_is_len_call(expr) {
    if expr == nil || expr["type"] != "Call" { return false }
    var fnn = expr["fn"]
    if fnn == nil || fnn["type"] != "Identifier" { return false }
    var nm = fnn["value"]
    if nm != "oren_list_len" && nm != "oren_list_int_len" && nm != "oren_map_len" && nm != "oren_buf_len" && nm != "oren_string_len" {
        return false
    }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 { return false }
    var arg0 = args[0]
    if arg0 == nil || arg0["type"] != "Identifier" { return false }
    return true
}

fn _opt_is_safe_int_expr(expr, last_int_safe) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Integer" { return true }
    if t == "Identifier" {
        var nm = expr["value"]
        if nm != nil && last_int_safe != nil && last_int_safe[nm] == true { return true }
        return false
    }
    if _opt_is_len_call(expr) { return true }
    if t == "Prefix" {
        var op0 = expr["op"]
        if op0 == "-" || op0 == "+" { return _opt_is_safe_int_expr(expr["right"], last_int_safe) }
        return false
    }
    if t == "Infix" {
        var op = expr["op"]
        if op == "+" || op == "-" || op == "*" {
            if _opt_is_safe_int_expr(expr["left"], last_int_safe) && _opt_is_safe_int_expr(expr["right"], last_int_safe) { return true }
        }
        return false
    }
    return false
}

fn _opt_collect_list_pushes_expr(expr, out) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Call" {
        var fnn = expr["fn"]
        if fnn != nil && fnn["type"] == "Identifier" {
            var nm = fnn["value"]
            if nm == "oren_list_push" || nm == "STD_list_push" {
                var args = expr["args"]
                if args != nil && oren_list_len(args) >= 2 {
                    var recv_name = _opt_is_ident(args[0])
                    if recv_name != nil { out[recv_name] = true }
                }
            }
        }
        var args2 = expr["args"]
        if args2 != nil {
            var i = 0
            while i < oren_list_len(args2) {
                _opt_collect_list_pushes_expr(args2[i], out)
                i = i + 1
            }
        }
        if expr["spread"] != nil { _opt_collect_list_pushes_expr(expr["spread"], out) }
        return nil
    }
    if t == "Prefix" { return _opt_collect_list_pushes_expr(expr["right"], out) }
    if t == "Infix" {
        _opt_collect_list_pushes_expr(expr["left"], out)
        _opt_collect_list_pushes_expr(expr["right"], out)
        return nil
    }
    if t == "If" {
        _opt_collect_list_pushes_expr(expr["cond"], out)
        _opt_collect_list_pushes_stmt(expr["consq"], out)
        if expr["alt"] != nil { _opt_collect_list_pushes_stmt(expr["alt"], out) }
        return nil
    }
    if t == "Array" {
        var els = expr["elements"]
        var i2 = 0
        while i2 < oren_list_len(els) {
            _opt_collect_list_pushes_expr(els[i2], out)
            i2 = i2 + 1
        }
        return nil
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i3 = 0
        while i3 < oren_list_len(ps) {
            _opt_collect_list_pushes_expr(ps[i3]["key"], out)
            _opt_collect_list_pushes_expr(ps[i3]["value"], out)
            i3 = i3 + 1
        }
        return nil
    }
    if t == "Index" {
        _opt_collect_list_pushes_expr(expr["left"], out)
        _opt_collect_list_pushes_expr(expr["index"], out)
        return nil
    }
    if t == "Member" { return _opt_collect_list_pushes_expr(expr["left"], out) }
    return nil
}

fn _opt_collect_list_int_pushes_expr(expr, out) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Call" {
        var fnn = expr["fn"]
        if fnn != nil && fnn["type"] == "Identifier" {
            var nm = fnn["value"]
            if nm == "oren_list_int_push" || nm == "STD_list_int_push" {
                var args = expr["args"]
                if args != nil && oren_list_len(args) >= 2 {
                    var recv_name = _opt_is_ident(args[0])
                    if recv_name != nil { out[recv_name] = true }
                }
            }
        }
        var args2 = expr["args"]
        if args2 != nil {
            var i = 0
            while i < oren_list_len(args2) {
                _opt_collect_list_int_pushes_expr(args2[i], out)
                i = i + 1
            }
        }
        if expr["spread"] != nil { _opt_collect_list_int_pushes_expr(expr["spread"], out) }
        return nil
    }
    if t == "Prefix" { return _opt_collect_list_int_pushes_expr(expr["right"], out) }
    if t == "Infix" {
        _opt_collect_list_int_pushes_expr(expr["left"], out)
        _opt_collect_list_int_pushes_expr(expr["right"], out)
        return nil
    }
    if t == "If" {
        _opt_collect_list_int_pushes_expr(expr["cond"], out)
        _opt_collect_list_int_pushes_stmt(expr["consq"], out)
        if expr["alt"] != nil { _opt_collect_list_int_pushes_stmt(expr["alt"], out) }
        return nil
    }
    if t == "Array" {
        var els = expr["elements"]
        var i2 = 0
        while i2 < oren_list_len(els) {
            _opt_collect_list_int_pushes_expr(els[i2], out)
            i2 = i2 + 1
        }
        return nil
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i3 = 0
        while i3 < oren_list_len(ps) {
            _opt_collect_list_int_pushes_expr(ps[i3]["key"], out)
            _opt_collect_list_int_pushes_expr(ps[i3]["value"], out)
            i3 = i3 + 1
        }
        return nil
    }
    if t == "Index" {
        _opt_collect_list_int_pushes_expr(expr["left"], out)
        _opt_collect_list_int_pushes_expr(expr["index"], out)
        return nil
    }
    if t == "Member" { return _opt_collect_list_int_pushes_expr(expr["left"], out) }
    return nil
}

fn _opt_collect_list_pushes_stmt(stmt, out) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            _opt_collect_list_pushes_stmt(ss[i], out)
            i = i + 1
        }
        return nil
    }
    if t == "While" {
        _opt_collect_list_pushes_expr(stmt["cond"], out)
        _opt_collect_list_pushes_stmt(stmt["body"], out)
        return nil
    }
    if t == "For" {
        _opt_collect_list_pushes_stmt(stmt["init"], out)
        _opt_collect_list_pushes_expr(stmt["cond"], out)
        _opt_collect_list_pushes_expr(stmt["post"], out)
        _opt_collect_list_pushes_stmt(stmt["body"], out)
        return nil
    }
    if t == "ExprStmt" { return _opt_collect_list_pushes_expr(stmt["expr"], out) }
    if t == "Assign" { return _opt_collect_list_pushes_expr(stmt["value"], out) }
    if t == "Var" { return _opt_collect_list_pushes_expr(stmt["value"], out) }
    if t == "Set" {
        _opt_collect_list_pushes_expr(stmt["left"], out)
        _opt_collect_list_pushes_expr(stmt["value"], out)
        return nil
    }
    if t == "Return" { return _opt_collect_list_pushes_expr(stmt["value"], out) }
    if t == "Function" { return nil } // avoid nested functions
    return nil
}

fn _opt_collect_list_int_pushes_stmt(stmt, out) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            _opt_collect_list_int_pushes_stmt(ss[i], out)
            i = i + 1
        }
        return nil
    }
    if t == "While" {
        _opt_collect_list_int_pushes_expr(stmt["cond"], out)
        _opt_collect_list_int_pushes_stmt(stmt["body"], out)
        return nil
    }
    if t == "For" {
        _opt_collect_list_int_pushes_stmt(stmt["init"], out)
        _opt_collect_list_int_pushes_expr(stmt["cond"], out)
        _opt_collect_list_int_pushes_expr(stmt["post"], out)
        _opt_collect_list_int_pushes_stmt(stmt["body"], out)
        return nil
    }
    if t == "ExprStmt" { return _opt_collect_list_int_pushes_expr(stmt["expr"], out) }
    if t == "Assign" { return _opt_collect_list_int_pushes_expr(stmt["value"], out) }
    if t == "Var" { return _opt_collect_list_int_pushes_expr(stmt["value"], out) }
    if t == "Set" {
        _opt_collect_list_int_pushes_expr(stmt["left"], out)
        _opt_collect_list_int_pushes_expr(stmt["value"], out)
        return nil
    }
    if t == "Return" { return _opt_collect_list_int_pushes_expr(stmt["value"], out) }
    if t == "Function" { return nil } // avoid nested functions
    return nil
}

fn _opt_collect_assigned_names_stmt(out, stmt) {
    if out == nil || stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Assign" || t == "Var" {
        var n = stmt["name"]
        if n != nil && n["type"] == "Identifier" { out[n["value"]] = true }
        return nil
    }
    if t == "Block" {
        var xs = stmt["stmts"]
        if xs == nil { return nil }
        var i = 0
        while i < oren_list_len(xs) {
            _opt_collect_assigned_names_stmt(out, xs[i])
            i = i + 1
        }
        return nil
    }
    if t == "If" {
        _opt_collect_assigned_names_stmt(out, stmt["consq"])
        if stmt["alt"] != nil { _opt_collect_assigned_names_stmt(out, stmt["alt"]) }
        return nil
    }
    if t == "While" { _opt_collect_assigned_names_stmt(out, stmt["body"]); return nil }
    if t == "For" {
        _opt_collect_assigned_names_stmt(out, stmt["init"])
        _opt_collect_assigned_names_stmt(out, stmt["post"])
        _opt_collect_assigned_names_stmt(out, stmt["body"])
        return nil
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        if cases != nil {
            var ci = 0
            while ci < oren_list_len(cases) {
                var c = cases[ci]
                if c != nil && c["body"] != nil { _opt_collect_assigned_names_stmt(out, c["body"]) }
                ci = ci + 1
            }
        }
        if stmt["default"] != nil { _opt_collect_assigned_names_stmt(out, stmt["default"]) }
        return nil
    }
    if t == "Function" { return nil }
    if t == "ExprStmt" {
        // Expression-level control flow can contain assignments in nested blocks.
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            _opt_collect_assigned_names_stmt(out, e["consq"])
            if e["alt"] != nil { _opt_collect_assigned_names_stmt(out, e["alt"]) }
        }
        if e != nil && e["type"] == "Switch" {
            var cases2 = e["cases"]
            if cases2 != nil {
                var ci2 = 0
                while ci2 < oren_list_len(cases2) {
                    var c2 = cases2[ci2]
                    if c2 != nil && c2["body"] != nil { _opt_collect_assigned_names_stmt(out, c2["body"]) }
                    ci2 = ci2 + 1
                }
            }
            if e["default"] != nil { _opt_collect_assigned_names_stmt(out, e["default"]) }
        }
        return nil
    }
    return nil
}

fn _opt_insert_list_reserve_in_block(block) {
    if block == nil || block["type"] != "Block" { return nil }
    var ss = block["stmts"]
    if ss == nil { return nil }

    var last_list_lit = {}
    var last_list_int_new = {}
    var last_int_safe = {}
    var out = []
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        var is_top_assign = st != nil && (st["type"] == "Var" || st["type"] == "Assign")
        if is_top_assign {
            var nm = _opt_is_ident(st["name"])
            if nm != nil {
                var v = st["value"]
                var is_list_int_new = false
                if v != nil && v["type"] == "Call" {
                    var fnv = v["fn"]
                    if fnv != nil && fnv["type"] == "Identifier" {
                        var fn_name = fnv["value"]
                        if fn_name == "oren_new_list_int" { is_list_int_new = true }
                    }
                }
                if v != nil && v["type"] == "Array" { last_list_lit[nm] = true }
                else { last_list_lit[nm] = false }
                if is_list_int_new { last_list_int_new[nm] = true }
                else { last_list_int_new[nm] = false }
                if _opt_is_safe_int_expr(v, last_int_safe) { last_int_safe[nm] = true }
                else { last_int_safe[nm] = false }
            }
        }

        if st != nil && st["type"] == "While" {
            var cond = st["cond"]
            var n_expr = nil
            var n_ok = false
            if cond != nil && cond["type"] == "Infix" && cond["op"] == "<" {
                var left_name = _opt_is_ident(cond["left"])
                var right = cond["right"]
                if left_name != nil && right != nil {
                    if _opt_is_safe_int_expr(right, last_int_safe) {
                        n_expr = right
                        n_ok = true
                    }
                }
            }

            if n_ok {
                var pushes = {}
                var pushes_int = {}
                _opt_collect_list_pushes_stmt(st["body"], pushes)
                _opt_collect_list_int_pushes_stmt(st["body"], pushes_int)
                if pushes != nil {
                    for list_name in pushes {
                        if last_list_lit[list_name] == true && pushes_int[list_name] != true {
                            var call = ast.new_call(nil,
                                {"type": "Identifier", "token": nil, "value": "oren_list_reserve"},
                                [{"type": "Identifier", "token": nil, "value": list_name}, n_expr])
                            oren_list_push(out, ast.new_expr_stmt(nil, call))
                        }
                    }
                }
                if pushes_int != nil {
                    for list_namei in pushes_int {
                        if last_list_int_new[list_namei] == true && pushes[list_namei] != true {
                            var calli = ast.new_call(nil,
                                {"type": "Identifier", "token": nil, "value": "oren_list_int_reserve"},
                                [{"type": "Identifier", "token": nil, "value": list_namei}, n_expr])
                            oren_list_push(out, ast.new_expr_stmt(nil, calli))
                        }
                    }
                }
            }
        }
        if st != nil && st["type"] == "For" {
            var cond2 = st["cond"]
            var n_expr2 = nil
            var n_ok2 = false
            if cond2 != nil && cond2["type"] == "Infix" && cond2["op"] == "<" {
                var left_name2 = _opt_is_ident(cond2["left"])
                var right2 = cond2["right"]
                if left_name2 != nil && right2 != nil {
                    if _opt_is_safe_int_expr(right2, last_int_safe) {
                        n_expr2 = right2
                        n_ok2 = true
                    }
                }
            }

            if n_ok2 {
                var pushes2 = {}
                var pushes2_int = {}
                _opt_collect_list_pushes_stmt(st["body"], pushes2)
                _opt_collect_list_int_pushes_stmt(st["body"], pushes2_int)
                if pushes2 != nil {
                    for list_name2 in pushes2 {
                        if last_list_lit[list_name2] == true && pushes2_int[list_name2] != true {
                            var call2 = ast.new_call(nil,
                                {"type": "Identifier", "token": nil, "value": "oren_list_reserve"},
                                [{"type": "Identifier", "token": nil, "value": list_name2}, n_expr2])
                            oren_list_push(out, ast.new_expr_stmt(nil, call2))
                        }
                    }
                }
                if pushes2_int != nil {
                    for list_name2i in pushes2_int {
                        if last_list_int_new[list_name2i] == true && pushes2[list_name2i] != true {
                            var call2i = ast.new_call(nil,
                                {"type": "Identifier", "token": nil, "value": "oren_list_int_reserve"},
                                [{"type": "Identifier", "token": nil, "value": list_name2i}, n_expr2])
                            oren_list_push(out, ast.new_expr_stmt(nil, call2i))
                        }
                    }
                }
            }
        }

        oren_list_push(out, st)
        if is_top_assign != true {
            var assigned = {}
            _opt_collect_assigned_names_stmt(assigned, st)
            for nm2 in assigned {
                last_list_lit[nm2] = false
                last_list_int_new[nm2] = false
                last_int_safe[nm2] = false
            }
        }
        i = i + 1
    }
    block["stmts"] = out
    return nil
}

// --- Const int propagation (rolling, conservative) ---
//
// Replace `% ident` with `% <int>` when `ident` is a known int literal in the
// current block. This enables native fastmod on hot loops without changing
// semantics (we only propagate literals, not arbitrary expressions).

fn _opt_const_env_clone(env) {
    var out = {}
    if env == nil { return out }
    for k in env {
        var v = env[k]
        if v != nil { out[k] = v }
    }
    return out
}

fn _opt_const_env_intersect(a, b) {
    var out = {}
    if a == nil || b == nil { return out }
    for k in a {
        var av = a[k]
        if av != nil && b[k] == av { out[k] = av }
    }
    return out
}

fn _opt_const_env_set_from_expr(env, name, expr) {
    if env == nil || name == nil { return nil }
    var val = nil
    if expr != nil {
        if expr["type"] == "Integer" {
            val = expr["value"]
        } else if expr["type"] == "Identifier" {
            var src = expr["value"]
            if src != nil && env[src] != nil { val = env[src] }
        }
    }
    env[name] = val
    return nil
}

fn _opt_rewrite_expr_const_mod(expr, env) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Call" {
        var args = expr["args"]
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                args[i] = _opt_rewrite_expr_const_mod(args[i], env)
                i = i + 1
            }
            expr["args"] = args
        }
        if expr["spread"] != nil { expr["spread"] = _opt_rewrite_expr_const_mod(expr["spread"], env) }
        return expr
    }
    if t == "Prefix" {
        expr["right"] = _opt_rewrite_expr_const_mod(expr["right"], env)
        return expr
    }
    if t == "Infix" {
        expr["left"] = _opt_rewrite_expr_const_mod(expr["left"], env)
        expr["right"] = _opt_rewrite_expr_const_mod(expr["right"], env)
        if expr["op"] == "%" {
            var right = expr["right"]
            if right != nil && right["type"] == "Identifier" {
                var nm = right["value"]
                if nm != nil && env != nil && env[nm] != nil {
                    expr["right"] = {"type": "Integer", "token": right["token"], "value": env[nm]}
                }
            }
        }
        return expr
    }
    if t == "If" {
        expr["cond"] = _opt_rewrite_expr_const_mod(expr["cond"], env)
        if expr["consq"] != nil { _opt_rewrite_const_mod_in_block(expr["consq"], _opt_const_env_clone(env)) }
        if expr["alt"] != nil { _opt_rewrite_const_mod_in_block(expr["alt"], _opt_const_env_clone(env)) }
        return expr
    }
    if t == "Array" {
        var els = expr["elements"]
        var i2 = 0
        while i2 < oren_list_len(els) {
            els[i2] = _opt_rewrite_expr_const_mod(els[i2], env)
            i2 = i2 + 1
        }
        expr["elements"] = els
        return expr
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i3 = 0
        while i3 < oren_list_len(ps) {
            ps[i3]["key"] = _opt_rewrite_expr_const_mod(ps[i3]["key"], env)
            ps[i3]["value"] = _opt_rewrite_expr_const_mod(ps[i3]["value"], env)
            i3 = i3 + 1
        }
        expr["pairs"] = ps
        return expr
    }
    if t == "Index" {
        expr["left"] = _opt_rewrite_expr_const_mod(expr["left"], env)
        expr["index"] = _opt_rewrite_expr_const_mod(expr["index"], env)
        return expr
    }
    if t == "Member" {
        expr["left"] = _opt_rewrite_expr_const_mod(expr["left"], env)
        return expr
    }
    if t == "SpawnExpr" {
        expr["call"] = _opt_rewrite_expr_const_mod(expr["call"], env)
        return expr
    }
    return expr
}

fn _opt_rewrite_const_mod_stmt(stmt, env) {
    if stmt == nil { return env }
    var t = stmt["type"]
    if t == "Block" || t == "StmtList" {
        var xs = stmt["stmts"]
        if xs == nil { xs = stmt["statements"] }
        if xs == nil { return env }
        var cur = env
        var i = 0
        while i < oren_list_len(xs) {
            cur = _opt_rewrite_const_mod_stmt(xs[i], cur)
            i = i + 1
        }
        if stmt["stmts"] != nil { stmt["stmts"] = xs }
        if stmt["statements"] != nil { stmt["statements"] = xs }
        return cur
    }
    if t == "Var" || t == "Assign" {
        stmt["value"] = _opt_rewrite_expr_const_mod(stmt["value"], env)
        var nm = _opt_is_ident(stmt["name"])
        if nm != nil { _opt_const_env_set_from_expr(env, nm, stmt["value"]) }
        return env
    }
    if t == "Set" {
        stmt["left"] = _opt_rewrite_expr_const_mod(stmt["left"], env)
        stmt["value"] = _opt_rewrite_expr_const_mod(stmt["value"], env)
        return env
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            e["cond"] = _opt_rewrite_expr_const_mod(e["cond"], env)
            var base = env
            var then_env = _opt_const_env_clone(base)
            _opt_rewrite_const_mod_in_block(e["consq"], then_env)
            var alt_env = _opt_const_env_clone(base)
            if e["alt"] != nil { _opt_rewrite_const_mod_in_block(e["alt"], alt_env) }
            var merged = _opt_const_env_intersect(then_env, alt_env)
            stmt["expr"] = e
            return merged
        }
        if e != nil && e["type"] == "Switch" {
            e["value"] = _opt_rewrite_expr_const_mod(e["value"], env)
            var cases = e["cases"]
            var merged2 = nil
            var saw = false
            if cases != nil {
                var ci = 0
                while ci < oren_list_len(cases) {
                    var c = cases[ci]
                    var vals = c["values"]
                    var vi = 0
                    while vi < oren_list_len(vals) {
                        vals[vi] = _opt_rewrite_expr_const_mod(vals[vi], env)
                        vi = vi + 1
                    }
                    c["values"] = vals
                    var case_env = _opt_const_env_clone(env)
                    _opt_rewrite_const_mod_in_block(c["body"], case_env)
                    if saw != true { merged2 = case_env; saw = true }
                    else { merged2 = _opt_const_env_intersect(merged2, case_env) }
                    ci = ci + 1
                }
            }
            if e["default"] != nil {
                var def_env = _opt_const_env_clone(env)
                _opt_rewrite_const_mod_in_block(e["default"], def_env)
                if saw != true { merged2 = def_env; saw = true }
                else { merged2 = _opt_const_env_intersect(merged2, def_env) }
            } else if saw == true {
                merged2 = _opt_const_env_intersect(merged2, env)
            }
            if saw != true { merged2 = env }
            stmt["expr"] = e
            return merged2
        }
        stmt["expr"] = _opt_rewrite_expr_const_mod(stmt["expr"], env)
        return env
    }
    if t == "Return" {
        stmt["value"] = _opt_rewrite_expr_const_mod(stmt["value"], env)
        return env
    }
    if t == "If" {
        stmt["cond"] = _opt_rewrite_expr_const_mod(stmt["cond"], env)
        var base2 = env
        var env_then = _opt_const_env_clone(base2)
        _opt_rewrite_const_mod_in_block(stmt["consq"], env_then)
        var env_alt = _opt_const_env_clone(base2)
        if stmt["alt"] != nil { _opt_rewrite_const_mod_in_block(stmt["alt"], env_alt) }
        return _opt_const_env_intersect(env_then, env_alt)
    }
    if t == "While" {
        stmt["cond"] = _opt_rewrite_expr_const_mod(stmt["cond"], env)
        var body_env = _opt_const_env_clone(env)
        _opt_rewrite_const_mod_in_block(stmt["body"], body_env)
        var assigned = {}
        _opt_collect_assigned_names_stmt(assigned, stmt["body"])
        for nm2 in assigned { env[nm2] = nil }
        return env
    }
    if t == "For" {
        if stmt["init"] != nil { env = _opt_rewrite_const_mod_stmt(stmt["init"], env) }
        if stmt["cond"] != nil { stmt["cond"] = _opt_rewrite_expr_const_mod(stmt["cond"], env) }
        if stmt["body"] != nil {
            var body_env2 = _opt_const_env_clone(env)
            _opt_rewrite_const_mod_in_block(stmt["body"], body_env2)
        }
        if stmt["post"] != nil {
            var post_env = _opt_const_env_clone(env)
            _opt_rewrite_const_mod_stmt(stmt["post"], post_env)
        }
        var assigned2 = {}
        _opt_collect_assigned_names_stmt(assigned2, stmt["body"])
        _opt_collect_assigned_names_stmt(assigned2, stmt["post"])
        for nm3 in assigned2 { env[nm3] = nil }
        return env
    }
    if t == "Switch" {
        stmt["value"] = _opt_rewrite_expr_const_mod(stmt["value"], env)
        var cases2 = stmt["cases"]
        var merged3 = nil
        var saw2 = false
        if cases2 != nil {
            var ci2 = 0
            while ci2 < oren_list_len(cases2) {
                var c2 = cases2[ci2]
                var vals2 = c2["values"]
                var vi2 = 0
                while vi2 < oren_list_len(vals2) {
                    vals2[vi2] = _opt_rewrite_expr_const_mod(vals2[vi2], env)
                    vi2 = vi2 + 1
                }
                c2["values"] = vals2
                var case_env2 = _opt_const_env_clone(env)
                _opt_rewrite_const_mod_in_block(c2["body"], case_env2)
                if saw2 != true { merged3 = case_env2; saw2 = true }
                else { merged3 = _opt_const_env_intersect(merged3, case_env2) }
                ci2 = ci2 + 1
            }
        }
        if stmt["default"] != nil {
            var def_env2 = _opt_const_env_clone(env)
            _opt_rewrite_const_mod_in_block(stmt["default"], def_env2)
            if saw2 != true { merged3 = def_env2; saw2 = true }
            else { merged3 = _opt_const_env_intersect(merged3, def_env2) }
        } else if saw2 == true {
            merged3 = _opt_const_env_intersect(merged3, env)
        }
        if saw2 != true { merged3 = env }
        return merged3
    }
    if t == "Spawn" {
        if stmt["call"] != nil { stmt["call"] = _opt_rewrite_expr_const_mod(stmt["call"], env) }
        return env
    }
    return env
}

fn _opt_rewrite_const_mod_in_block(block, env) {
    if block == nil || block["type"] != "Block" { return env }
    if env == nil { env = {} }
    var ss = block["stmts"]
    if ss == nil { return env }
    var cur = env
    var i = 0
    while i < oren_list_len(ss) {
        cur = _opt_rewrite_const_mod_stmt(ss[i], cur)
        i = i + 1
    }
    block["stmts"] = ss
    return cur
}

// --- Tail-call optimization (TCO): direct self tail recursion (rolling, conservative) ---

fn _tco_ident(name) { return {"type": "Identifier", "token": nil, "value": name} }

fn _tco_expr_has_call(e) {
    // Conservative effect marker for optimizer transforms that can change call order.
    //
    // Oren's evaluation order is not fully specified (see docs/LANGUAGE.md), so we only
    // apply non-trivial recursion rewrites when we can prove there are no calls in the
    // affected expressions. This is a pragmatic v0 rule to keep transforms safe.
    if e == nil { return false }
    var t = e["type"]
    if t == "Call" || t == "SpawnExpr" { return true }
    if t == "Function" { return true } // closure literals can capture; keep it conservative
    if t == "Prefix" { return _tco_expr_has_call(e["right"]) }
    if t == "Infix" { return _tco_expr_has_call(e["left"]) || _tco_expr_has_call(e["right"]) }
    if t == "If" {
        if _tco_expr_has_call(e["cond"]) { return true }
        if e["consq"] != nil && _tco_block_has_call(e["consq"]) { return true }
        if e["alt"] != nil && _tco_block_has_call(e["alt"]) { return true }
        return false
    }
    if t == "Array" {
        var xs = e["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            if _tco_expr_has_call(xs[i]) { return true }
            i = i + 1
        }
        return false
    }
    if t == "Hash" {
        var ps = e["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            if _tco_expr_has_call(ps[i2]["key"]) { return true }
            if _tco_expr_has_call(ps[i2]["value"]) { return true }
            i2 = i2 + 1
        }
        return false
    }
    if t == "Index" {
        return _tco_expr_has_call(e["left"]) || _tco_expr_has_call(e["index"])
    }
    if t == "Member" {
        return _tco_expr_has_call(e["left"])
    }
    return false
}

fn _tco_block_has_call(block) {
    if block == nil || block["type"] != "Block" { return false }
    var ss = block["stmts"]
    if ss == nil { return false }
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        if st == nil { i = i + 1; continue }
        var ty = st["type"]
        if ty == "Return" { if _tco_expr_has_call(st["value"]) { return true } }
        else if ty == "Var" { if _tco_expr_has_call(st["value"]) { return true } }
        else if ty == "Assign" { if _tco_expr_has_call(st["value"]) { return true } }
        else if ty == "Set" { if _tco_expr_has_call(st["value"]) { return true } }
        else if ty == "ExprStmt" { if _tco_expr_has_call(st["expr"]) { return true } }
        else if ty == "While" {
            if _tco_expr_has_call(st["cond"]) { return true }
            if _tco_block_has_call(st["body"]) { return true }
        }
        else if ty == "For" {
            if st["init"] != nil && st["init"]["type"] == "ExprStmt" && _tco_expr_has_call(st["init"]["expr"]) { return true }
            if _tco_expr_has_call(st["cond"]) { return true }
            if st["post"] != nil && st["post"]["type"] == "ExprStmt" && _tco_expr_has_call(st["post"]["expr"]) { return true }
            if _tco_block_has_call(st["body"]) { return true }
        }
        i = i + 1
    }
    return false
}

fn _tco_modconst_function_in_place(fun_expr) {
    // Tail recursion modulo a constant (rolling v0, conservative).
    //
    // Convert patterns like:
    //   fn f(...){
    //     if <cond> { return <base_int> }
    //     return f(args...) + <k_int>
    //   }
    // into a loop with an accumulator:
    //   var __acc = 0
    //   while true {
    //     if <cond> { return <base_int> + __acc }
    //     __acc = __acc + <k_int>
    //     <params> = <args>
    //     continue
    //   }
    //
    // This is *not* a general recursion-to-loop transform. It is a small, safe step toward
    // production stack safety and performance for common counting-style recursion.
    if fun_expr == nil || fun_expr["type"] != "Function" { return false }
    var fn_name = fun_expr["name"]
    if fn_name == nil || fn_name == "" { return false }

    // Params: identifiers only.
    var params0 = []
    var ps = fun_expr["params"]
    var pi = 0
    while pi < oren_list_len(ps) {
        var p = ps[pi]
        if p == nil || p["type"] != "Identifier" || p["value"] == nil { return false }
        oren_list_push(params0, p["value"])
        pi = pi + 1
    }

    var body = fun_expr["body"]
    if body == nil || body["type"] != "Block" { return false }
    var ss = body["stmts"]
    if ss == nil || oren_list_len(ss) != 2 { return false }

    // stmt0 must be `if cond { return base_int }` in ExprStmt form.
    var st0 = ss[0]
    if st0 == nil || st0["type"] != "ExprStmt" || st0["expr"] == nil || st0["expr"]["type"] != "If" { return false }
    var ife = st0["expr"]
    if ife["alt"] != nil { return false }
    if ife["consq"] == nil || ife["consq"]["type"] != "Block" { return false }
    var consq_ss = ife["consq"]["stmts"]
    if consq_ss == nil || oren_list_len(consq_ss) != 1 { return false }
    var st_base = consq_ss[0]
    if st_base == nil || st_base["type"] != "Return" { return false }
    var base_expr = st_base["value"]
    if base_expr == nil || base_expr["type"] != "Integer" { return false }
    // Avoid call-bearing conditions/returns; this transform can change timing.
    if _tco_expr_has_call(ife["cond"]) { return false }
    if _tco_expr_has_call(base_expr) { return false }

    // stmt1 must be return infix with self call and integer const.
    var st1 = ss[1]
    if st1 == nil || st1["type"] != "Return" { return false }
    var v1 = st1["value"]
    if v1 == nil || v1["type"] != "Infix" { return false }
    var op = v1["op"]
    if op != "+" && op != "-" { return false }

    // Match self call + integer const.
    var call_expr = nil
    var k_expr = nil
    var acc_op = nil // "+" or "-"
    // Case A: f(args...) + k  OR  f(args...) - k
    if v1["left"] != nil && v1["left"]["type"] == "Call" && v1["right"] != nil && v1["right"]["type"] == "Integer" {
        call_expr = v1["left"]
        k_expr = v1["right"]
        acc_op = op
    }
    // Case B: k + f(args...)  (commutative add only)
    if call_expr == nil && op == "+" && v1["left"] != nil && v1["left"]["type"] == "Integer" && v1["right"] != nil && v1["right"]["type"] == "Call" {
        call_expr = v1["right"]
        k_expr = v1["left"]
        acc_op = "+"
    }
    if call_expr == nil || k_expr == nil || acc_op == nil { return false }
    if call_expr["spread"] != nil { return false }
    if call_expr["fn"] == nil || call_expr["fn"]["type"] != "Identifier" || call_expr["fn"]["value"] != fn_name { return false }
    var args = call_expr["args"]
    if args == nil || oren_list_len(args) != oren_list_len(params0) { return false }

    // NOTE: We do not attempt to prove global purity of the function here. We only rely on:
    // - a very restrictive shape (if-return base, then one return recursion+const),
    // - no calls in the base/cond,
    // - recursion call is the only call in the recursive return expression (by construction).

    var acc_name = "__oren__tco_acc__" + fn_name

    // Build new loop body.
    var loop_body = ast.new_block(nil)
    loop_body["stmts"] = []

    // if cond { return base + acc }
    var new_consq = ast.new_block(nil)
    var base_plus_acc = ast.new_infix(nil, base_expr, "+", _tco_ident(acc_name))
    new_consq["stmts"] = [ast.new_return(nil, base_plus_acc)]
    var new_if = ast.new_if(nil, ife["cond"], new_consq, nil)
    oren_list_push(loop_body["stmts"], ast.new_expr_stmt(nil, new_if))

    // acc = acc (+|-) k
    var acc_update = ast.new_assign(nil, _tco_ident(acc_name), ast.new_infix(nil, _tco_ident(acc_name), acc_op, k_expr))
    oren_list_push(loop_body["stmts"], acc_update)

    // Evaluate args into temps, then rebind params, then continue.
    var counter_ref = [0]
    var ti = 0
    var temps = []
    while ti < oren_list_len(args) {
        var tmpn = "__oren_tco_mod_" + fn_name + "_" + oren_int_to_string(counter_ref[0])
        counter_ref[0] = counter_ref[0] + 1
        oren_list_push(temps, tmpn)
        oren_list_push(loop_body["stmts"], ast.new_var(nil, _tco_ident(tmpn), args[ti]))
        ti = ti + 1
    }
    ti = 0
    while ti < oren_list_len(params0) {
        oren_list_push(loop_body["stmts"], ast.new_assign(nil, _tco_ident(params0[ti]), _tco_ident(temps[ti])))
        ti = ti + 1
    }
    oren_list_push(loop_body["stmts"], ast.new_continue(nil))

    var w = ast.new_while(nil, ast.new_boolean(nil, true), loop_body)
    var new_body = ast.new_block(nil)
    new_body["stmts"] = [
        ast.new_var(nil, _tco_ident(acc_name), int_lit(0)),
        w
    ]

    fun_expr["body"] = new_body
    return true
}

fn _tco_rewrite_block(block, fn_name, params, loop_depth, counter_ref) {
    // Rewrite `return <fn_name>(args...)` in tail position (loop_depth == 0)
    // into:
    //   var tmp0 = arg0
    //   ...
    //   param0 = tmp0
    //   ...
    //   continue
    //
    // Returns {"block": block, "changed": bool}
    if block == nil || block["type"] != "Block" { return {"block": block, "changed": false} }
    var stmts = block["stmts"]
    if stmts == nil { return {"block": block, "changed": false} }

    var out = []
    var changed = false
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st == nil { oren_list_push(out, st); i = i + 1; continue }

        if st["type"] == "Return" && loop_depth == 0 {
            var v = st["value"]
            if v != nil && v["type"] == "Call" && v["spread"] == nil {
                var fn_expr = v["fn"]
                if fn_expr != nil && fn_expr["type"] == "Identifier" && fn_expr["value"] == fn_name {
                    var args = v["args"]
                    if args != nil && oren_list_len(args) == oren_list_len(params) {
                        // Evaluate args into temps first (preserve order, avoid param clobber).
                        var ti = 0
                        var temps = []
                        while ti < oren_list_len(args) {
                            var tmpn = "__oren_tco_" + fn_name + "_" + oren_int_to_string(counter_ref[0])
                            counter_ref[0] = counter_ref[0] + 1
                            oren_list_push(temps, tmpn)
                            oren_list_push(out, ast.new_var(nil, _tco_ident(tmpn), args[ti]))
                            ti = ti + 1
                        }
                        // Rebind params.
                        ti = 0
                        while ti < oren_list_len(params) {
                            var pn = params[ti]
                            oren_list_push(out, ast.new_assign(nil, _tco_ident(pn), _tco_ident(temps[ti])))
                            ti = ti + 1
                        }
                        // Loop back to function top (requires outer loop wrapper).
                        oren_list_push(out, ast.new_continue(nil))
                        changed = true
                        i = i + 1
                        continue
                    }
                }
            }
        }

        if st["type"] == "While" {
            var r1 = _tco_rewrite_block(st["body"], fn_name, params, loop_depth + 1, counter_ref)
            st["body"] = r1["block"]
            if r1["changed"] { changed = true }
            oren_list_push(out, st)
            i = i + 1
            continue
        }
        if st["type"] == "For" {
            var r2 = _tco_rewrite_block(st["body"], fn_name, params, loop_depth + 1, counter_ref)
            st["body"] = r2["block"]
            if r2["changed"] { changed = true }
            oren_list_push(out, st)
            i = i + 1
            continue
        }
        if st["type"] == "Block" {
            var r3 = _tco_rewrite_block(st, fn_name, params, loop_depth, counter_ref)
            st = r3["block"]
            if r3["changed"] { changed = true }
            oren_list_push(out, st)
            i = i + 1
            continue
        }
        if st["type"] == "ExprStmt" && st["expr"] != nil && st["expr"]["type"] == "If" {
            var ife = st["expr"]
            var r4 = _tco_rewrite_block(ife["consq"], fn_name, params, loop_depth, counter_ref)
            ife["consq"] = r4["block"]
            if r4["changed"] { changed = true }
            if ife["alt"] != nil {
                var r5 = _tco_rewrite_block(ife["alt"], fn_name, params, loop_depth, counter_ref)
                ife["alt"] = r5["block"]
                if r5["changed"] { changed = true }
            }
            st["expr"] = ife
            oren_list_push(out, st)
            i = i + 1
            continue
        }

        // Do not rewrite inside nested functions here; they are optimized separately.
        oren_list_push(out, st)
        i = i + 1
    }

    block["stmts"] = out
    return {"block": block, "changed": changed}
}

fn _tco_function_in_place(fun_expr) {
    if fun_expr == nil || fun_expr["type"] != "Function" { return nil }
    var fn_name = fun_expr["name"]
    if fn_name == nil || fn_name == "" { return nil }

    // Only handle plain identifier params.
    var params0 = []
    var ps = fun_expr["params"]
    var pi = 0
    while pi < oren_list_len(ps) {
        var p = ps[pi]
        if p == nil || p["type"] != "Identifier" || p["value"] == nil { return nil }
        oren_list_push(params0, p["value"])
        pi = pi + 1
    }

    var counter_ref = [0]
    var r = _tco_rewrite_block(fun_expr["body"], fn_name, params0, 0, counter_ref)
    if r["changed"] != true { return nil }

    // Wrap the function body in an outer `while true` so `continue` is legal.
    //
    // Add a `break` at the end of the loop body so implicit fallthrough returns (return nil)
    // keep working: if the function does not tail-recurse, we run one iteration and break.
    var inner = r["block"]
    oren_list_push(inner["stmts"], ast.new_break(nil))
    var w = ast.new_while(nil, ast.new_boolean(nil, true), inner)
    fun_expr["body"] = ast.new_block(nil)
    fun_expr["body"]["stmts"] = [w]
    return nil
}

fn lower_linked_program_in_place(linked) {
    var trace_opt = oren_env("OREN_TRACE_OPTIMIZER") != nil
    if trace_opt { print("[opt] enter") }
    if linked == nil { return nil }

    // Fold expressions first (so DCE sees simplified RHS).
    var ss = linked["statements"]
    if trace_opt { print("[opt] got statements") }
    var i = 0
    var nn_env = nn_env_new()
    if trace_opt { print("[opt] stmts_len=" + oren_int_to_string(oren_list_len(ss))) }
    while i < oren_list_len(ss) {
        if trace_opt && i == 0 { print("[opt] fold first stmt type=" + ss[i]["type"]) }
        fold_stmt(ss[i], nn_env)
        // DCE for function bodies.
        if ss[i] != nil && ss[i]["type"] == "ExprStmt" && ss[i]["expr"] != nil && ss[i]["expr"]["type"] == "Function" {
            // Try to eliminate simple non-tail recursion first (modulo constant), then do plain tail recursion elimination.
            if trace_opt && i == 0 { print("[opt] tco_modconst start") }
            _tco_modconst_function_in_place(ss[i]["expr"])
            if trace_opt && i == 0 { print("[opt] tco_modconst done") }
            if trace_opt && i == 0 { print("[opt] tco start") }
            _tco_function_in_place(ss[i]["expr"])
            if trace_opt && i == 0 { print("[opt] tco done") }
            _opt_insert_list_reserve_in_block(ss[i]["expr"]["body"])
            _opt_rewrite_const_mod_in_block(ss[i]["expr"]["body"], nil)
            if trace_opt && i == 0 { print("[opt] dce start") }
            dce_block_in_place(ss[i]["expr"]["body"])
            if trace_opt && i == 0 { print("[opt] dce done") }
        }
        i = i + 1
    }
    return nil
}
