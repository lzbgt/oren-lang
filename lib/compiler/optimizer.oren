fn _opt_insert_list_reserve_in_block(block, last_list_lit, last_list_lit_len, last_list_lit_intsafe, last_list_int_new, last_int_safe) {
    if block == nil || block["type"] != "Block" { return nil }
    var ss = block["stmts"]
    if ss == nil { return nil }

    if last_list_lit == nil { last_list_lit = {} }
    if last_list_lit_len == nil { last_list_lit_len = {} }
