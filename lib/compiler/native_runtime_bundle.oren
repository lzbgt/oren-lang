// native_runtime_bundle.oren
//
// Shared native-runtime injection pipeline for Tier‑1 native backends (arm64 + x86_64).
//
// Why this exists:
// - Both native backends inject `lib/runtime_native.oren` (expanded from `lib/runtime_native/**`).
// - Entry stubs call runtime init helpers, but those calls are not visible in the AST.
// - Whole-program DCE may run after injection (x86_64 already does), so entry-stub-only
//   functions must be pinned as extra roots.
//
// Goal:
// - Make the runtime-injection pipeline consistent across native backends so we can:
//   - converge semantics quickly (x64 ↔ arm64),
//   - share tooling and invariants (capsule enforcement, DCE roots),
//   - keep compile time bounded by removing unused runtime code.
//
// Notes:
// - This file is intentionally "compiler-internal"; it should not be used by user code.
// - This module does not perform codegen; it prepares a linked program + runtime AST.

import lexer "lexer.oren"
import parser "parser.oren"
import rtinj "native_runtime_inject.oren"
import global_dce "global_dce.oren"
import capsule "capsule.oren"

fn _bundle_err(ctx, msg) {
    if ctx == nil { return nil }
    if ctx["errors"] == nil { ctx["errors"] = [] }
    oren_list_push(ctx["errors"], msg)
    return nil
}

fn _bundle_clone_list(xs) {
    if xs == nil { return [] }
    var out = []
    var i = 0
    while i < oren_list_len(xs) {
        oren_list_push(out, xs[i])
        i = i + 1
    }
    return out
}

fn _bundle_list_contains(xs, v) {
    if xs == nil { return false }
    var i = 0
    while i < oren_list_len(xs) {
        if xs[i] == v { return true }
        i = i + 1
    }
    return false
}

fn _bundle_roots_base() {
    // Whole-program DCE can run after runtime injection (Tier‑1 native backends).
    //
    // Historically we pinned a giant list of runtime helper symbols here to keep
    // entry-stub / fixup-only call targets alive. That was brittle and back-end
    // specific, and forced compiler-side maintenance.
    //
    // Rolling approach (preferred):
    // - Runtime functions that must survive DCE are annotated with `@oren.keep`.
    // - Capsule syscall hooks are kept by name prefix (`native_capsule_sys_`) because
    //   syscall lowering may reference them directly in codegen without emitting AST calls.
    //
    // Keep this list empty unless we discover a truly non-annotatable root.
    return []
}

fn _bundle_roots_arm64_extra(platform) {
    // `@oren.keep` is used for arm64 entry-stub helpers; no extra roots required.
    return []
}

fn _bundle_roots_x64_extra(platform) {
    // `@oren.keep` is used for x86_64 entry-stub helpers; no extra roots required.
    return []
}

fn _bundle_roots_for_backend(backend, platform) {
    // backend: "arm64" | "x64"
    var roots = _bundle_clone_list(_bundle_roots_base())
    var extra = []
    if backend == "arm64" { extra = _bundle_roots_arm64_extra(platform) }
    else if backend == "x64" { extra = _bundle_roots_x64_extra(platform) }
    var i = 0
    while i < oren_list_len(extra) {
        if _bundle_list_contains(roots, extra[i]) == false {
            oren_list_push(roots, extra[i])
        }
        i = i + 1
    }
    return roots
}

fn _bundle_config_merge_roots(cfg0, roots_add) {
    // Preserve config knobs that affect the linker / DCE decisions.
    //
    // We intentionally do not mutate cfg0 in place (it may be shared).
    var cfg = {}
    if cfg0 != nil && cfg0["keep_all_top_level_functions"] == true {
        cfg["keep_all_top_level_functions"] = true
    }
    // Copy existing roots if present.
    var roots = []
    if cfg0 != nil && cfg0["roots"] != nil {
        roots = _bundle_clone_list(cfg0["roots"])
    }
    if roots_add != nil {
        var i = 0
        while i < oren_list_len(roots_add) {
            var nm = roots_add[i]
            if nm != nil && nm != "" && _bundle_list_contains(roots, nm) == false {
                oren_list_push(roots, nm)
            }
            i = i + 1
        }
    }
    cfg["roots"] = roots
    return cfg
}

fn _bundle_tag_stmt_list(stmts, is_runtime) {
    if stmts == nil { return nil }
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st != nil {
            st["__oren_from_runtime"] = is_runtime
        }
        i = i + 1
    }
    return nil
}

fn _bundle_split_stmt_list_by_runtime_tag(stmts) {
    // Split linked statements into:
    // - runtime statements (tagged __oren_from_runtime=true)
    // - user statements (everything else)
    var runtime = []
    var user = []
    if stmts == nil { return {"runtime": runtime, "user": user} }
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st != nil && st["__oren_from_runtime"] == true {
            oren_list_push(runtime, st)
        } else {
            oren_list_push(user, st)
        }
        i = i + 1
    }
    return {"runtime": runtime, "user": user}
}

fn load_and_parse_runtime_native(ctx, runtime_path) {
    // Expand and parse a native runtime source file.
    //
    // Returns a program AST {statements: ...} or nil (errors recorded in ctx).
    if ctx == nil { return nil }
    if runtime_path == nil || runtime_path == "" {
        _bundle_err(ctx, "native runtime bundle: missing runtime_path")
        return nil
    }

    var runtime_src = rtinj.runtime_expand_includes_file(ctx, runtime_path, [])
    if runtime_src == nil { return nil }

    // Debug aid: dump expanded runtime after include expansion, before parsing.
    // This is intentionally opt-in because the expanded runtime is large.
    var dump_runtime = oren_env("OREN_DUMP_NATIVE_RUNTIME")
    if dump_runtime != nil {
        var p = dump_runtime
        if p == "" { p = "build/runtime_native.expanded.oren" }
        oren_write_file(p, runtime_src)
    }

    var l = lexer.new_lexer(runtime_src)
    l["file"] = runtime_path
    var p2 = parser.new_parser(l)
    var runtime_prog = parser.parse_program(p2)
    if p2 != nil && p2["errors"] != nil && oren_list_len(p2["errors"]) != 0 {
        _bundle_err(ctx, "Parse errors in " + runtime_path)
        var ei = 0
        while ei < oren_list_len(p2["errors"]) {
            _bundle_err(ctx, p2["errors"][ei])
            ei = ei + 1
        }
        return nil
    }

    return runtime_prog
}

fn inject_runtime_into_linked_and_dce(ctx, backend, linked, runtime_prog, platform, aliases) {
    // Build a merged linked program:
    //   [runtime stmts...] + [user stmts...]
    //
    // Then run whole-program DCE (function-only) to keep compilation time bounded and
    // to reduce the surface area of backend-only unimplemented features.
    //
    // Returns:
    // - linked2: merged linked program after DCE
    // - runtime_stmts: tagged runtime statements still present after DCE
    // - user_stmts: remaining user statements after DCE
    if ctx == nil { return nil }
    if linked == nil { _bundle_err(ctx, "native runtime bundle: linked is nil"); return nil }
    if runtime_prog == nil { _bundle_err(ctx, "native runtime bundle: runtime_prog is nil"); return nil }

    var rs = runtime_prog["statements"]
    if rs == nil { rs = [] }
    var us = linked["statements"]
    if us == nil { us = [] }

    // Tag runtime statements so callers can split after DCE without relying on indices.
    _bundle_tag_stmt_list(rs, true)
    _bundle_tag_stmt_list(us, false)

    var merged = []
    var i = 0
    while i < oren_list_len(rs) { oren_list_push(merged, rs[i]); i = i + 1 }
    i = 0
    while i < oren_list_len(us) { oren_list_push(merged, us[i]); i = i + 1 }

    var cfg0 = linked["config"]
    var roots = _bundle_roots_for_backend(backend, platform)
    var cfg = _bundle_config_merge_roots(cfg0, roots)

    var linked2 = {"statements": merged, "aliases": aliases, "config": cfg}

    // Run DCE after injection unless explicitly disabled by config.
    global_dce.lower_linked_program_in_place(linked2)

    var stmts2 = linked2["statements"]
    var split = _bundle_split_stmt_list_by_runtime_tag(stmts2)
    return {"linked": linked2, "runtime_stmts": split["runtime"], "user_stmts": split["user"]}
}

fn prepare_native_runtime_bundle(ctx, backend, linked, platform, opts) {
    // High-level entrypoint used by native backends.
    //
    // backend:
    // - "arm64" for arm64 native backend
    // - "x64"   for x86_64 native backend
    //
    // opts:
    // - runtime_path: path to the runtime entry file (default: "lib/runtime_native.oren")
    // - inject_runtime: bool (default: true)
    //
    // Returns:
    // - inject_runtime: bool
    // - runtime_prog: runtime program AST (if injected)
    // - linked2: merged linked program after DCE (if injected)
    // - runtime_stmts, user_stmts: statement lists after DCE split by runtime tag
    if ctx == nil { return nil }
    if linked == nil { _bundle_err(ctx, "native runtime bundle: linked is nil"); return nil }
    if platform == nil { platform = {} }

    var runtime_path = "lib/runtime_native.oren"
    var inject_runtime = true
    if opts != nil {
        if opts["runtime_path"] != nil { runtime_path = opts["runtime_path"] }
        if opts["inject_runtime"] == false { inject_runtime = false }
    }

    if inject_runtime == false {
        return {"inject_runtime": false, "runtime_prog": nil, "linked2": linked, "runtime_stmts": [], "user_stmts": linked["statements"]}
    }

    var runtime_prog = load_and_parse_runtime_native(ctx, runtime_path)
    if runtime_prog == nil { return nil }

    // Capsule enforcement (compile-time):
    //
    // - enforced against runtime annotations, but scanned on user program only.
    // - consistent across native backends (Tier‑1 parity).
    if platform["capsule"] == true {
        capsule.enforce_capsule(runtime_prog, linked, platform["cap_allow_domains"])
    }

    var aliases = linked["aliases"]
    if aliases == nil { aliases = {} }

    var out = inject_runtime_into_linked_and_dce(ctx, backend, linked, runtime_prog, platform, aliases)
    if out == nil { return nil }

    out["inject_runtime"] = true
    out["runtime_prog"] = runtime_prog
    return out
}
