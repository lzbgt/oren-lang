// native_runtime_bundle.oren
//
// Shared native-runtime injection pipeline for Tier‑1 native backends (arm64 + x86_64).
//
// Why this exists:
// - Both native backends inject `lib/runtime_native.oren` (expanded from `lib/runtime_native/**`).
// - Entry stubs call runtime init helpers, but those calls are not visible in the AST.
// - Whole-program DCE may run after injection (x86_64 already does), so entry-stub-only
//   functions must be pinned as extra roots.
//
// Goal:
// - Make the runtime-injection pipeline consistent across native backends so we can:
//   - converge semantics quickly (x64 ↔ arm64),
//   - share tooling and invariants (capsule enforcement, DCE roots),
//   - keep compile time bounded by removing unused runtime code.
//
// Notes:
// - This file is intentionally "compiler-internal"; it should not be used by user code.
// - This module does not perform codegen; it prepares a linked program + runtime AST.

import lexer "lexer.oren"
import parser "parser.oren"
import rtinj "native_runtime_inject.oren"
import astbin "astbin.oren"
import global_dce "global_dce.oren"
import capsule "capsule.oren"
import intparse "int_lit.oren"
import pprune "native_platform_prune.oren"
import cfg_lowering "cfg_lowering.oren"

// Compiler process GC hook (rolling):
// - `oren_gc_collect()` is a runtime-provided hook (C backend + native runtime both provide it).
// - Keep this module free of `ffi` declarations so native self-hosted compilers do not
//   accidentally emit unresolved external symbols (dyld: _oren_gc_collect).

fn _bundle_err(ctx, msg) {
    if ctx == nil { return nil }
    if ctx["errors"] == nil { ctx["errors"] = [] }
    oren_list_push(ctx["errors"], msg)
    return nil
}

fn _rt_bundle_hex_digit(n) {
    // n in [0,15]
    return oren_string_char_at("0123456789abcdef", n)
}

fn _rt_bundle_bytes_to_hex(bs) {
    if bs == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_list_len(bs) {
        var b = bs[i]
        // Do not rely on `scalar == nil` semantics (native parity hazard).
        if oren_type_tag(b) == 0 { b = 0 }
        if b < 0 { b = 0 }
        if b > 255 { b = b & 255 }
        out = out + _rt_bundle_hex_digit(b / 16) + _rt_bundle_hex_digit(b & 15)
        i = i + 1
    }
    return out
}

fn _rt_bundle_sha256_hex_string(s) {
    if s == nil { return "" }
    var d = oren_sha256_string(s)
    return _rt_bundle_bytes_to_hex(d)
}

fn _rt_bundle_mask63(x) {
    // Keep hashes non-negative so decimal formatting is stable across backends.
    return x & 9223372036854775807
}

fn _rt_bundle_fnv1a63_string(s, basis) {
    // Fast fingerprint for cache keys (not a cryptographic hash).
    if s == nil { return 0 }
    var h = _rt_bundle_mask63(basis)
    var prime = 1099511628211
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        var b = oren_string_byte_at_unchecked(s, i) & 255
        h = _rt_bundle_mask63((h ^ b) * prime)
        i = i + 1
    }
    return h
}

fn _rt_bundle_runtime_fingerprint_v2(runtime_src) {
    // Stage2-native throughput:
    // Avoid SHA-256 here. The native runtime's `oren_sha256_string` is pure Oren and can
    // dominate "compile one file" cold-miss paths just to name the cached astbin file.
    //
    // Rolling v2 fingerprint:
    // - two-lane 63-bit FNV-1a-ish hash
    // - includes length mixing to reduce trivial collisions
    var s = runtime_src
    if s == nil { s = "" }
    var n = oren_string_len(s)
    var h1 = _rt_bundle_fnv1a63_string(s, 1469598103934665603)
    var h2 = _rt_bundle_fnv1a63_string(s, 1099511628211)
    // Mix length in a stable way.
    h1 = _rt_bundle_mask63(h1 ^ (n * 1315423911))
    h2 = _rt_bundle_mask63(h2 ^ (n * 2654435761))
    return "v2_" + oren_int_to_string(h1) + "_" + oren_int_to_string(h2)
}

fn _rt_bundle_shell_quote(s) {
    // Minimal single-quote shell escaping: ' -> '\''.
    // This is used only for dev tooling (mkdir -p cache dir).
    if s == nil { return "''" }
    var out = "'"
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        if ch == "'" { out = out + "'\\''" }
        else { out = out + ch }
        i = i + 1
    }
    out = out + "'"
    return out
}

fn _rt_bundle_path_to_windows_sep(s) {
    if s == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        if ch == "/" { out = out + "\\" }
        else { out = out + ch }
        i = i + 1
    }
    return out
}

fn _rt_bundle_host_is_windows() {
    // Robust host detection for compiler/tooling helpers used across stage1 (C backend) and stage2 (native).
    // Do not rely solely on `OS=Windows_NT` since some environments (SSH/PowerShell) may omit it.
    if oren_env("OS") == "Windows_NT" { return true }
    if oren_env("SystemRoot") != nil { return true }
    if oren_env("WINDIR") != nil { return true }
    if oren_env("COMSPEC") != nil { return true }
    if oren_env("PATHEXT") != nil { return true }
    if oren_env("PROCESSOR_ARCHITECTURE") != nil { return true }
    return false
}

fn _rt_bundle_ensure_dir(path) {
    if path == nil || path == "" { return nil }
    // Cross-platform: do not rely on `mkdir -p` on Windows (cmd.exe does not support it).
    var mk_path = path
    var cmd = ""
    if _rt_bundle_host_is_windows() {
        // cmd.exe prefers backslashes, and built-in `mkdir` creates intermediates.
        mk_path = _rt_bundle_path_to_windows_sep(mk_path)
        cmd = "mkdir \"" + mk_path + "\" >nul 2>nul"
    } else {
        cmd = "mkdir -p \"" + mk_path + "\""
    }
    oren_system(cmd)
    return nil
}

fn _bundle_clone_list(xs) {
    if xs == nil { return [] }
    var out = []
    var i = 0
    while i < oren_list_len(xs) {
        oren_list_push(out, xs[i])
        i = i + 1
    }
    return out
}

fn _bundle_list_contains(xs, v) {
    if xs == nil { return false }
    var i = 0
    while i < oren_list_len(xs) {
        if xs[i] == v { return true }
        i = i + 1
    }
    return false
}

fn _rt_bundle_validate_runtime_prog(ctx, runtime_prog, runtime_path) {
    if ctx == nil { return false }
    if runtime_prog == nil { _bundle_err(ctx, "native runtime bundle: runtime_prog is nil"); return false }

    // Validate that the injected native runtime does not contain top-level executable statements.
    //
    // Tier-1 invariant: the runtime is injected as a library; its side effects must be
    // driven by `native_runtime_init` (and explicit runtime calls), not by implicit top-level
    // execution order inside `__top_level__`.
    var sts = runtime_prog["statements"]
    if sts == nil { sts = [] }
    var si = 0
    while si < oren_list_len(sts) {
        var st = sts[si]
        if st == nil { si = si + 1; continue }
        if st["type"] == "Function" { si = si + 1; continue }
        if st["type"] == "ExprStmt" {
            var e = st["expr"]
            if e != nil && e["type"] == "Function" { si = si + 1; continue }
        }
        if st["type"] == "Type" || st["type"] == "FFI" || st["type"] == "Var" { si = si + 1; continue }
        _bundle_err(ctx, "native runtime bundle: runtime contains top-level executable stmt type=" + st["type"])
        return false
    }
    if _bundle_validate_runtime_global_consts(ctx, runtime_prog) == false { return false }
    return true
}

fn _rt_bundle_apply_cfg_in_place(ctx, runtime_prog, runtime_path, platform) {
    // Apply declaration-level conditional compilation (`@cfg(...)`) to the injected runtime bundle.
    //
    // This must run for:
    // - parsed runtime source, and
    // - decoded runtime astbin blobs (cache hits / seed hits / explicit OREN_NATIVE_RUNTIME_ASTBIN),
    // otherwise mutually-exclusive `@cfg` variants can coexist in the runtime AST and later appear as:
    // - duplicate top-level names (e.g. FFI alias vs stub), or
    // - wrong-platform stubs being selected for a target.
    if runtime_prog == nil { return false }
    if platform == nil { return true }

    // Clear any stale cfg_errors left by a previous pass (cfg_lowering only sets this on error).
    runtime_prog["cfg_errors"] = nil

    var cfg = {"target": platform["os"], "arch": platform["arch"]}
    cfg_lowering.lower_program_in_place(runtime_prog, cfg)
    if runtime_prog["cfg_errors"] != nil && oren_list_len(runtime_prog["cfg_errors"]) > 0 {
        _bundle_err(ctx, "Cfg filtering failed in injected runtime: " + runtime_path)
        var cei = 0
        while cei < oren_list_len(runtime_prog["cfg_errors"]) {
            _bundle_err(ctx, runtime_prog["cfg_errors"][cei])
            cei = cei + 1
        }
        return false
    }
    return true
}

fn _rt_bundle_cache_sanity_ok(v) {
    // Best-effort structural sanity check for decoded astbin runtime bundles.
    //
    // Goal:
    // - Treat corrupted/stale cache blobs as a cache miss so the compiler can fall back to
    //   seed caches or to parsing the runtime source.
    // - Avoid hard crashes later in backend codegen (e.g. `string_len expects string`).
    //
    // This intentionally does NOT record errors into ctx; it is only used to decide whether a
    // decoded cache entry is safe to accept.
    var budget = [4000000] // guard against cycles / pathological blobs
    return _rt_bundle_cache_sanity_ok_rec(v, budget)
}

fn _rt_bundle_cache_sanity_ok_rec(v, budget_ref) {
    // Returns true if `v` looks structurally safe, false otherwise.
    if budget_ref == nil { return false }
    var budget = budget_ref[0]
    if budget <= 0 { return false }
    budget_ref[0] = budget - 1

    if v == nil || v == true || v == false { return true }
    if oren_is_string(v) == true { return true }
    if oren_is_u8_buf(v) == true { return true }

    if oren_is_list(v) == true {
        var i = 0
        while i < oren_list_len(v) {
            if _rt_bundle_cache_sanity_ok_rec(v[i], budget_ref) != true { return false }
            i = i + 1
        }
        return true
    }
    if oren_is_map(v) == true {
        // AST invariant checks for the most crash-prone nodes.
        var t = v["type"]
        if t != nil && oren_is_string(t) != true { return false }
        if t == "String" {
            var sv = v["value"]
            if sv == nil { return false }
            if oren_is_string(sv) != true { return false }
        } else if t == "Identifier" {
            var iv = v["value"]
            if iv == nil { return false }
            if oren_is_string(iv) != true { return false }
        }

        // Recurse through entries (generic).
        var idx = 0
        var pair = [nil, nil]
        while 1 {
            var ok = oren_iter_next_entry(v, idx, pair)
            if ok == 0 { break }
            var val = pair[1]
            if _rt_bundle_cache_sanity_ok_rec(val, budget_ref) != true { return false }
            idx = idx + 1
        }
        return true
    }
    // int/float/other immediates are OK as leaves.
    return true
}

fn _rt_bundle_cache_enabled() {
    var v = oren_env("OREN_NATIVE_RUNTIME_ASTBIN_CACHE")
    if v == nil || v == "" { return true }
    if v == "0" || v == "false" { return false }
    return true
}

fn _rt_bundle_cache_dir() {
    var v = oren_env("OREN_NATIVE_RUNTIME_ASTBIN_CACHE_DIR")
    if v == nil || v == "" { return "build/cache/native_runtime_astbin" }
    return v
}

fn _rt_bundle_seed_dir() {
    // Optional seed cache for native runtime AST bundles (astbin).
    //
    // Purpose:
    // - Stage2-native runtime parsing can be very slow on cold cache (especially capsule runtime).
    // - A seed directory lets tooling (or `make stage2`) pre-warm the runtime astbin once using a
    //   faster compiler (stage1) and then copy it into the active cache dir on demand.
    //
    // Disable by setting:
    //   OREN_NATIVE_RUNTIME_ASTBIN_SEED_DIR=0   (or "false")
    var v = oren_env("OREN_NATIVE_RUNTIME_ASTBIN_SEED_DIR")
    if v == nil || v == "" { return "build/cache/native_runtime_astbin_seed" }
    if v == "0" || v == "false" { return "" }
    return v
}

fn _rt_bundle_pruned_cache_enabled() {
    // Default-on (rolling):
    // the runtime contains many `if g_target_os == ...` branches that are constant for a
    // targeted native build. Caching a pruned AST reduces both decode cost and rtobj-miss time.
    var v = oren_env("OREN_NATIVE_RUNTIME_ASTBIN_PRUNE_CACHE")
    if v == nil || v == "" { return true }
    if v == "0" || v == "false" { return false }
    return true
}

fn _rt_bundle_pruned_cache_write_enabled() {
    // Writing the pruned cache can be expensive in stage2-native compilers.
    // Keep it default-on for throughput, but allow opting out.
    var v = oren_env("OREN_NATIVE_RUNTIME_ASTBIN_PRUNE_WRITE")
    if v == nil || v == "" { return true }
    if v == "0" || v == "false" { return false }
    return true
}

fn _rt_bundle_try_seed_hit_into_cache(cache_dir, seed_dir, base, trace) {
    // Returns u8 buf bytes if seed is present, otherwise error/empty.
    //
    // Note: callers should only write the bytes into the active cache dir after
    // the astbin successfully decodes/validates, to avoid persisting corrupted seed blobs.
    if seed_dir == nil || seed_dir == "" { return oren_err(4, "no seed dir") }
    if base == nil || base == "" { return oren_err(4, "no base") }
    var seed_path = seed_dir + "/" + base
    return oren_read_u8_buf(seed_path)
}

fn _rt_bundle_platform_os_key(platform) {
    if platform == nil { return "" }
    var os = platform["os"]
    if os == "macos" { return "os_macos" }
    if os == "linux" { return "os_linux" }
    if os == "windows" { return "os_windows" }
    return ""
}

fn _rt_bundle_platform_os_id(platform) {
    if platform == nil { return 0 }
    var os = platform["os"]
    if os == "macos" { return 1 }
    if os == "linux" { return 2 }
    if os == "windows" { return 3 }
    return 0
}

fn _bundle_roots_base() {
    // Whole-program DCE can run after runtime injection (Tier‑1 native backends).
    //
    // Historically we pinned a giant list of runtime helper symbols here to keep
    // entry-stub / fixup-only call targets alive. That was brittle and back-end
    // specific, and forced compiler-side maintenance.
    //
    // Rolling approach (preferred):
    // - Runtime functions that must survive DCE are annotated with `@oren.keep`.
    // - Capsule syscall hooks are kept by name prefix (`native_capsule_sys_`) only when
    //   `--capsule` is enabled, because syscall lowering may reference them directly in
    //   codegen without emitting AST calls.
    //
    // Keep this list empty unless we discover a truly non-annotatable root.
    return []
}

fn _bundle_roots_arm64_extra(platform) {
    // Entry stubs can call runtime helpers via fixups (no AST call edge),
    // so post-injection whole-program DCE would otherwise drop them.
    var roots = []
    if platform != nil && platform["os"] == "macos" {
        // arm64 macOS entry stub calls this (non-shared builds).
        oren_list_push(roots, "native_runtime_threading_init")
    }
    return roots
}

fn _bundle_roots_x64_extra(platform) {
    // `@oren.keep` is used for x86_64 entry-stub helpers; no extra roots required.
    return []
}

fn _bundle_roots_for_backend(backend, platform) {
    // backend: "arm64" | "x64"
    var roots = _bundle_clone_list(_bundle_roots_base())
    // Capsule mode requires runtime-side initialization:
    // - parse capsule env knobs (domains, mounts, allowlists)
    // - initialize global capsule masks
    //
    // Entry stubs call this by fixup/call, so it must be pinned explicitly when enabled.
    if platform != nil && platform["capsule"] == true {
        oren_list_push(roots, "native_runtime_capsule_init")
    }
    var extra = []
    if backend == "arm64" { extra = _bundle_roots_arm64_extra(platform) }
    else if backend == "x64" { extra = _bundle_roots_x64_extra(platform) }
    var i = 0
    while i < oren_list_len(extra) {
        if _bundle_list_contains(roots, extra[i]) == false {
            oren_list_push(roots, extra[i])
        }
        i = i + 1
    }
    return roots
}

fn _bundle_config_merge_roots(cfg0, roots_add) {
    // Preserve config knobs that affect the linker / DCE decisions.
    //
    // We intentionally do not mutate cfg0 in place (it may be shared).
    var cfg = {}
    if cfg0 != nil && cfg0["keep_all_top_level_functions"] == true {
        cfg["keep_all_top_level_functions"] = true
    }
    // Preserve platform identity (some downstream passes consult these fields).
    if cfg0 != nil {
        if cfg0["target"] != nil { cfg["target"] = cfg0["target"] }
        if cfg0["arch"] != nil { cfg["arch"] = cfg0["arch"] }
        if cfg0["capsule"] == true { cfg["capsule"] = true }
        if cfg0["cap_allow_domains"] != nil {
            cfg["cap_allow_domains"] = _bundle_clone_list(cfg0["cap_allow_domains"])
        }
    }
    // Copy existing roots if present.
    var roots = []
    if cfg0 != nil && cfg0["roots"] != nil {
        roots = _bundle_clone_list(cfg0["roots"])
    }
    if roots_add != nil {
        var i = 0
        while i < oren_list_len(roots_add) {
            var nm = roots_add[i]
            if nm != nil && nm != "" && _bundle_list_contains(roots, nm) == false {
                oren_list_push(roots, nm)
            }
            i = i + 1
        }
    }
    cfg["roots"] = roots
    return cfg
}

fn _bundle_tag_stmt_list(stmts, is_runtime) {
    if stmts == nil { return nil }
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st != nil {
            st["__oren_from_runtime"] = is_runtime
            // Many runtime files wrap top-level declarations as `ExprStmt(expr=Function)`
            // (historical parser/normalization behavior). Propagate the tag to the
            // nested Function node too so downstream passes (codegen, call-depth gating,
            // platform pruning) can reliably detect "this is runtime code".
            if st["type"] == "ExprStmt" {
                var e = st["expr"]
                if e != nil && e["type"] == "Function" {
                    e["__oren_from_runtime"] = is_runtime
                }
            }
        }
        i = i + 1
    }
    return nil
}

fn _rt_bundle_trace_fn_shape(runtime_prog, stage) {
    // Bounded debug aid:
    //   OREN_TRACE_NATIVE_RUNTIME_FN=native_alloc_index_get ./oren_stage2 build ...
    //
    // Prints only the first few statement node kinds in the function body to avoid
    // flooding logs / token budgets.
    var want = oren_env("OREN_TRACE_NATIVE_RUNTIME_FN")
    if want == nil || want == "" { return nil }
    if runtime_prog == nil { return nil }
    var sts = runtime_prog["statements"]
    if sts == nil { return nil }

    var i = 0
    while i < oren_list_len(sts) {
        var st = sts[i]
        var fn0 = nil
        if st != nil && st["type"] == "Function" {
            fn0 = st
        } else if st != nil && st["type"] == "ExprStmt" {
            var e = st["expr"]
            if e != nil && e["type"] == "Function" { fn0 = e }
        }
        if fn0 != nil && fn0["name"] == want {
            var body = fn0["body"]
            var bs = []
            if body != nil && body["type"] == "Block" { bs = body["stmts"] }
            if bs == nil { bs = [] }

            var tok = fn0["token"]
            var f = "<unknown>"
            var ln = 0
            var col = 0
            if tok != nil {
                if tok["file"] != nil { f = tok["file"] }
                if tok["line"] != nil { ln = tok["line"] }
                if tok["col"] != nil { col = tok["col"] }
            }
            var out = ""
            var j = 0
            var n = oren_list_len(bs)
            if n > 12 { n = 12 }
            while j < n {
                var st2 = bs[j]
                var tag = "nil"
                if st2 != nil {
                    tag = st2["type"]
                    if tag == "ExprStmt" {
                        var e2 = st2["expr"]
                        if e2 != nil && e2["type"] != nil {
                            tag = "ExprStmt(" + e2["type"] + ")"
                            if e2["type"] == "If" && j < 3 {
                                var c0 = e2["cond"]
                                if c0 != nil {
                                    var ct = c0["type"]
                                    if ct == nil { ct = "?" }
                                    var extra = " cond=" + ct
                                    if ct == "Infix" {
                                        var op0 = c0["op"]
                                        if op0 == nil { op0 = "?" }
                                        extra = extra + " op=" + op0
                                        var l0 = c0["left"]
                                        if l0 != nil && l0["type"] == "Identifier" && l0["value"] != nil {
                                            extra = extra + " left=" + l0["value"]
                                        }
                                        var r0 = c0["right"]
                                        if r0 != nil && r0["type"] == "Identifier" && r0["value"] != nil {
                                            extra = extra + " right=" + r0["value"]
                                        }
                                    }
                                    tag = tag + extra
                                }
                            }
                        }
                    }
                }
                if j == 0 { out = tag } else { out = out + "," + tag }
                j = j + 1
            }
            var stg = stage
            if stg == nil { stg = "" }
            if stg != "" { stg = " stage=" + stg }
            print("[rt_bundle] trace fn=" + want + stg + " at " + f + ":" + oren_int_to_string(ln) + ":" + oren_int_to_string(col) + " body_stmts=" + oren_int_to_string(oren_list_len(bs)) + " body_first=" + out)
            return nil
        }
        i = i + 1
    }
    var stg2 = stage
    if stg2 == nil { stg2 = "" }
    if stg2 != "" { stg2 = " stage=" + stg2 }
    print("[rt_bundle] trace fn=" + want + stg2 + " not_found")
    return nil
}

fn _bundle_split_stmt_list_by_runtime_tag(stmts) {
    // Split linked statements into:
    // - runtime statements (tagged __oren_from_runtime=true)
    // - user statements (everything else)
    var runtime = []
    var user = []
    if stmts == nil { return {"runtime": runtime, "user": user} }
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st != nil && st["__oren_from_runtime"] == true {
            oren_list_push(runtime, st)
        } else {
            oren_list_push(user, st)
        }
        i = i + 1
    }
    return {"runtime": runtime, "user": user}
}


fn _bundle_is_upper_name(name) {
    if name == nil || name == "" { return false }

    // Avoid ordering comparisons on chars: `oren_string_char_at` returns a single-char value
    // and the native `>=`/`<=` operators are int-only.
    var ch = oren_string_char_at(name, 0)
    var ups = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var i = 0
    while i < 26 {
        if oren_string_char_at(ups, i) == ch { return true }
        i = i + 1
    }
    return false
}

fn _bundle_is_zero_const_expr(expr) {
    if expr == nil { return true }
    var t = expr["type"]
    if t == "Nil" { return true }
    if t == "Integer" {
        var v = intparse.parse_int_lit(expr["value"])
        if oren_is_err(v) { return false }
        return v == 0
    }
    if t == "Boolean" {
        var b = expr["value"]
        if b == false || b == "false" { return true }
        return false
    }
    return false
}

fn _bundle_maybe_get_toplevel_function_node(stmt) {
    if stmt == nil { return nil }
    if stmt["type"] == "Function" { return stmt }
    if stmt["type"] == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "Function" { return e }
    }
    return nil
}

fn _bundle_find_toplevel_function(stmts, name) {
    if stmts == nil { return nil }
    var i = 0
    while i < oren_list_len(stmts) {
        var fn0 = _bundle_maybe_get_toplevel_function_node(stmts[i])
        if fn0 != nil && fn0["name"] == name { return fn0 }
        i = i + 1
    }
    return nil
}

fn _bundle_collect_assigned_names_stmt(out, stmt) {
    if out == nil || stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Assign" {
        var n = stmt["name"]
        if n != nil && n["type"] == "Identifier" {
            out[n["value"]] = true
        }
        return nil
    }
    if t == "Block" {
        var xs = stmt["stmts"]
        if xs == nil { return nil }
        var i = 0
        while i < oren_list_len(xs) {
            _bundle_collect_assigned_names_stmt(out, xs[i])
            i = i + 1
        }
        return nil
    }
    if t == "If" {
        _bundle_collect_assigned_names_stmt(out, stmt["consq"])
        if stmt["alt"] != nil { _bundle_collect_assigned_names_stmt(out, stmt["alt"]) }
        return nil
    }
    if t == "While" { _bundle_collect_assigned_names_stmt(out, stmt["body"]); return nil }
    if t == "For" {
        _bundle_collect_assigned_names_stmt(out, stmt["init"])
        _bundle_collect_assigned_names_stmt(out, stmt["post"])
        _bundle_collect_assigned_names_stmt(out, stmt["body"])
        return nil
    }
    if t == "Function" { return nil }
    if t == "ExprStmt" {
        // Some front-end lowering forms represent control-flow as an expression that is
        // wrapped in an ExprStmt. Track assignments inside those expression blocks too.
        var e = stmt["expr"]
        if e != nil && e["type"] == "If" {
            _bundle_collect_assigned_names_stmt(out, e["consq"])
            if e["alt"] != nil { _bundle_collect_assigned_names_stmt(out, e["alt"]) }
        }
        return nil
    }
    if t == "Return" { return nil }
    if t == "Var" { return nil }
    if t == "Set" { return nil }
    if t == "Spawn" { return nil }
    return nil
}

fn _bundle_collect_assigned_names_in_fn(fn0) {
    var out = {}
    if fn0 == nil { return out }
    var body = fn0["body"]
    _bundle_collect_assigned_names_stmt(out, body)
    return out
}

fn _bundle_validate_runtime_global_consts(ctx, runtime_prog) {
    if ctx == nil { return false }
    if runtime_prog == nil { _bundle_err(ctx, "native runtime bundle: runtime_prog is nil"); return false }

    var sts = runtime_prog["statements"]
    if sts == nil { sts = [] }

    // Tier-1 invariant: injected runtime globals are allocated as zero; any constant-like
    // runtime globals must be explicitly initialized by native_runtime_init (or remain zero).
    var init_fn = _bundle_find_toplevel_function(sts, "native_runtime_init")
    if init_fn == nil { _bundle_err(ctx, "native runtime bundle: missing native_runtime_init"); return false }
    var assigned = _bundle_collect_assigned_names_in_fn(init_fn)

    var i = 0
    while i < oren_list_len(sts) {
        var st = sts[i]
        if st == nil { i = i + 1; continue }
        if st["type"] == "Var" {
            var n = st["name"]
            var v = st["value"]
            if n != nil && n["type"] == "Identifier" {
                var nm = n["value"]
                if _bundle_is_upper_name(nm) == true {
                    // Enforce trivial initializer shape for constant-like runtime globals:
                    // any non-trivial init must move into native_runtime_init.
                    if v != nil {
                        var vt = v["type"]
                        if vt != "Integer" && vt != "Boolean" && vt != "Nil" {
                            _bundle_err(ctx, "native runtime bundle: runtime global var initializer must be constant; move init into native_runtime_init: " + nm)
                            return false
                        }
                    }
                    // If the declared initializer is non-zero, require init to assign it.
                    if _bundle_is_zero_const_expr(v) == false {
                        if assigned[nm] != true {
                            _bundle_err(ctx, "native runtime bundle: runtime global var has non-zero initializer but is not assigned in native_runtime_init: " + nm)
                            return false
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return true
}

fn _load_and_parse_runtime_native_impl(ctx, runtime_path, platform) {
    // Expand and parse a native runtime source file.
    //
    // Returns a program AST {statements: ...} or nil (errors recorded in ctx).
    if ctx == nil { return nil }
    if runtime_path == nil || runtime_path == "" {
        _bundle_err(ctx, "native runtime bundle: missing runtime_path")
        return nil
    }

    var trace = false
    var v_trace = oren_env("OREN_TRACE_RUNTIME_BUNDLE")
    if v_trace != nil && v_trace != "" { trace = true }

    var os_key = _rt_bundle_platform_os_key(platform)
    if os_key == nil { os_key = "" }

    // Troubleshooting fast path:
    // - Parsing the full native runtime can be extremely slow in stage2 native compilers.
    // - Allow loading a pre-parsed AST from an astbin file.
    //
    // Generate it via a fast stage1 build:
    //   OREN_DUMP_NATIVE_RUNTIME_ASTBIN=build/runtime_native.astbin ./oren build ...
    // Then use it from stage2:
    //   OREN_NATIVE_RUNTIME_ASTBIN=build/runtime_native.astbin <stage2> build ...
    var runtime_astbin = oren_env("OREN_NATIVE_RUNTIME_ASTBIN")
    if runtime_astbin != nil {
        var p_ast = runtime_astbin
        if p_ast == "" { p_ast = "build/runtime_native.astbin" }
        if trace { print("[rt_bundle] astbin load start path=" + p_ast) }
        var t_ast0 = 0
        if trace { t_ast0 = oren_time_now_ns() }
        // Prefer u8_buf to avoid boxing huge byte arrays into list<int>.
        var bs = oren_read_u8_buf(p_ast)
        if oren_is_err(bs) {
            var msgB = oren_err_msg(bs)
            var emsgB = "native runtime bundle: failed to read OREN_NATIVE_RUNTIME_ASTBIN=" + p_ast
            if msgB != nil { emsgB = emsgB + ": " + msgB }
            _bundle_err(ctx, emsgB)
            return nil
        }
        if trace {
            print("[rt_bundle] astbin read done bytes=" + oren_int_to_string(oren_buf_len(bs)))
            print("[rt_bundle] astbin decode start")
        }
        var prog0 = astbin.astbin_decode(bs)
        if prog0 == nil {
            _bundle_err(ctx, "native runtime bundle: astbin_decode failed: " + p_ast)
            return nil
        }
        // Mark as runtime so platform pruning can apply.
        _bundle_tag_stmt_list(prog0["statements"], true)
        _rt_bundle_trace_fn_shape(prog0, "pre_pprune")
        if _rt_bundle_apply_cfg_in_place(ctx, prog0, runtime_path, platform) == false { return nil }
        // Prune dead `g_target_os` branches for targeted builds (best-effort; no-op when unknown).
        pprune.prune_runtime_os_branches_in_linked_program_in_place(prog0, platform)
        _rt_bundle_trace_fn_shape(prog0, "post_pprune")
        if _rt_bundle_validate_runtime_prog(ctx, prog0, runtime_path) == false { return nil }
        if trace {
            var dtA = oren_time_now_ns() - t_ast0
            print("[rt_bundle] astbin load done +" + oren_int_to_string(dtA / 1000000) + "ms")
        }
        return prog0
    }

    var t0 = 0
    if trace {
        t0 = oren_time_now_ns()
        print("[rt_bundle] expand start path=" + runtime_path)
    }
    // Troubleshooting override:
    // - Stage2 native compilers can be extremely slow in include expansion.
    // - Allow bypassing expansion by providing a pre-expanded runtime file.
    //   Generate it via: OREN_DUMP_NATIVE_RUNTIME=build/runtime_native.expanded.oren <compiler> build ...
    var runtime_src = nil
    var expanded_override = oren_env("OREN_NATIVE_RUNTIME_EXPANDED")
    if expanded_override != nil {
        var p_exp = expanded_override
        if p_exp == "" { p_exp = "build/runtime_native.expanded.oren" }
        var rr = oren_read_file(p_exp)
        if oren_is_err(rr) {
            var msg = oren_err_msg(rr)
            var emsg = "native runtime bundle: failed to read OREN_NATIVE_RUNTIME_EXPANDED=" + p_exp
            if msg != nil { emsg = emsg + ": " + msg }
            _bundle_err(ctx, emsg)
            return nil
        }
        runtime_src = rr
        if trace { print("[rt_bundle] using expanded runtime file: " + p_exp) }
    } else {
        runtime_src = rtinj.runtime_expand_includes_file(ctx, runtime_path, [])
        if runtime_src == nil { return nil }
    }
    if trace {
        var dt = oren_time_now_ns() - t0
        print("[rt_bundle] expand done +" + oren_int_to_string(dt / 1000000) + "ms bytes=" + oren_int_to_string(oren_string_len(runtime_src)))
        t0 = oren_time_now_ns()
    }

    // Include expansion can allocate many temporary strings/slices.
    // Collecting here is expensive (full heap scan) so we only do it in "aggressive"
    // compiler GC mode (used for native self-hosting / very large programs).
    if ctx["__compiler_gc_aggressive"] == true {
        oren_gc_collect()
    }

    // Debug aid: dump expanded runtime after include expansion, before parsing.
    // This is intentionally opt-in because the expanded runtime is large.
    var dump_runtime = oren_env("OREN_DUMP_NATIVE_RUNTIME")
    if dump_runtime != nil {
        var p = dump_runtime
        if p == "" { p = "build/runtime_native.expanded.oren" }
        oren_write_file(p, runtime_src)
    }

    // Default fast path (rolling): parse the runtime once and cache an astbin.
    //
    // IMPORTANT (stage2-native throughput):
    // - Stage2-native parsing of the expanded runtime can be extremely slow.
    // - The cache key must be cheap to compute; do not require SHA-256 in the hot path.
    //
    // Rolling cache key story:
    // - Preferred: v2 fast fingerprint (two-lane FNV-ish).
    // - Backward-compatible: fall back to legacy SHA-256 cache filenames if present, and
    //   opportunistically migrate them to the v2 path to avoid re-parsing.
    var cache_enabled = _rt_bundle_cache_enabled()
    var cache_dir = _rt_bundle_cache_dir()
    if cache_dir == nil { cache_dir = "" }
    if trace { print("[rt_bundle] fingerprint start") }
    var fp2 = _rt_bundle_runtime_fingerprint_v2(runtime_src)
    if trace { print("[rt_bundle] fingerprint done") }
    if fp2 == nil || fp2 == "" {
        _bundle_err(ctx, "native runtime bundle: runtime fingerprint failed")
        return nil
    }
    if trace {
        print("[rt_bundle] fingerprint key=" + fp2 + " cache_dir=" + cache_dir + " os_key=" + os_key)
    }
    var base_v2 = fp2 + ".astbin"
    var cache_astbin_v2 = cache_dir + "/" + base_v2
    var cache_astbin_v2_legacy = cache_astbin_v2
    var cache_astbin_v2_plain = cache_astbin_v2
    var cache_astbin_v2_pruned = nil
    var cache_astbin_v2_pruned_legacy = nil
    if os_key != "" {
        // Platform-aware cache reduces decode+compile work by caching the pruned runtime AST
        // (dead `g_target_os` branches removed) per target OS.
        var base_plain = fp2 + "_" + os_key + ".astbin"
        cache_astbin_v2_plain = cache_dir + "/" + base_plain
        cache_astbin_v2 = cache_astbin_v2_plain
        if _rt_bundle_pruned_cache_enabled() == true {
            // Bump suffix when pruning/encoding strategy changes so stale caches don't mask wins.
            var base_pruned = fp2 + "_" + os_key + "_pruned3.astbin"
            cache_astbin_v2_pruned = cache_dir + "/" + base_pruned
            cache_astbin_v2_pruned_legacy = cache_dir + "/" + fp2 + "_" + os_key + "_pruned.astbin"
            cache_astbin_v2 = cache_astbin_v2_pruned
        }
    }
    var seed_dir = _rt_bundle_seed_dir()

    if cache_enabled == true {
        var t_hit0 = 0
        if trace { t_hit0 = oren_time_now_ns() }

        // v2 path first.
        var seed_hit = false
        var seed_base = ""
        var bs_hit = oren_read_u8_buf(cache_astbin_v2)
        if oren_is_err(bs_hit) && seed_dir != "" {
            // Best-effort: seed can avoid extremely slow stage2-native parsing on cold cache.
            var base_seed = base_v2
            if cache_astbin_v2_pruned != nil && cache_astbin_v2 == cache_astbin_v2_pruned {
                base_seed = fp2 + "_" + os_key + "_pruned3.astbin"
            } else if cache_astbin_v2_plain != nil && cache_astbin_v2 == cache_astbin_v2_plain && os_key != "" {
                base_seed = fp2 + "_" + os_key + ".astbin"
            }
            var bs_seed = _rt_bundle_try_seed_hit_into_cache(cache_dir, seed_dir, base_seed, trace)
            if !oren_is_err(bs_seed) {
                bs_hit = bs_seed
                seed_hit = true
                seed_base = base_seed
            }
        }
        if !oren_is_err(bs_hit) {
            if trace { print("[rt_bundle] cache astbin hit path=" + cache_astbin_v2 + " bytes=" + oren_int_to_string(oren_buf_len(bs_hit))) }
            var prog_hit = astbin.astbin_decode(bs_hit)
            if prog_hit != nil {
                _bundle_tag_stmt_list(prog_hit["statements"], true)
                if _rt_bundle_apply_cfg_in_place(ctx, prog_hit, runtime_path, platform) == false { return nil }
                if _rt_bundle_cache_sanity_ok(prog_hit) != true {
                    if trace { print("[rt_bundle] cache astbin miss (sanity check failed), falling back") }
                    prog_hit = nil
                }
            }
            if prog_hit != nil {
                var os_id2 = _rt_bundle_platform_os_id(platform)
                var already_pruned = false
                if os_id2 != 0 && prog_hit["__oren_pruned_target_os_id"] == os_id2 && prog_hit["__oren_pruned_target_os_kind"] == "g_target_os" {
                    // For pruned cache entries, require a prune-generation marker too.
                    // If missing/mismatched, treat the cache as unsafe and fall back to the plain cache,
                    // because re-pruning an already-pruned AST cannot recover pruned-away statements.
                    if cache_astbin_v2_pruned != nil && cache_astbin_v2 == cache_astbin_v2_pruned {
                        if prog_hit["__oren_pruned_target_os_cache_gen"] == 3 {
                            already_pruned = true
                        } else {
                            if trace { print("[rt_bundle] cache astbin miss (stale pruned gen), falling back") }
                            already_pruned = false
                            prog_hit = nil
                        }
                    } else {
                        already_pruned = true
                    }
                }
                if prog_hit != nil && already_pruned == false {
                    pprune.prune_runtime_os_branches_in_linked_program_in_place(prog_hit, platform)
                    // If this cache file is expected to be the pruned variant, but we still had to
                    // prune after decoding, opportunistically rewrite it so future runs decode less.
                    if cache_astbin_v2_pruned != nil && cache_astbin_v2 == cache_astbin_v2_pruned && _rt_bundle_pruned_cache_write_enabled() == true {
                        if trace { print("[rt_bundle] cache astbin prune encode start (rewrite) -> " + cache_astbin_v2_pruned) }
                        var t_rew0 = 0
                        if trace { t_rew0 = oren_time_now_ns() }
                        var bs_rew = astbin.astbin_encode(prog_hit)
                        if bs_rew != nil {
                            _rt_bundle_ensure_dir(cache_dir)
                            oren_write_bytes(cache_astbin_v2_pruned, bs_rew)
                            if trace {
                                var dt_rew = oren_time_now_ns() - t_rew0
                                print("[rt_bundle] cache astbin prune encode done (rewrite) +" + oren_int_to_string(dt_rew / 1000000) + "ms bytes=" + oren_int_to_string(oren_buf_len(bs_rew)))
                            }
                        }
                    }
                }
                if prog_hit == nil {
                    // fall through to other cache paths
                } else {
                    if _rt_bundle_validate_runtime_prog(ctx, prog_hit, runtime_path) == false { return nil }
                    if trace {
                        var dt_hit = oren_time_now_ns() - t_hit0
                        print("[rt_bundle] cache astbin decode done +" + oren_int_to_string(dt_hit / 1000000) + "ms")
                    }
                    if seed_hit == true && seed_base != "" {
                        _rt_bundle_ensure_dir(cache_dir)
                        var dst = cache_dir + "/" + seed_base
                        oren_write_bytes(dst, bs_hit)
                        if trace { print("[rt_bundle] cache astbin seed-hit -> " + dst) }
                    }
                    return prog_hit
                }
            }
            if trace { print("[rt_bundle] cache astbin miss (decode failed), falling back") }
        }

        // Backward-compatible: support the previous pruned filename suffix.
        if cache_astbin_v2_pruned_legacy != nil && cache_astbin_v2_pruned != nil {
            var bs_pr_leg = oren_read_u8_buf(cache_astbin_v2_pruned_legacy)
            if !oren_is_err(bs_pr_leg) {
                if trace { print("[rt_bundle] cache astbin hit(legacy pruned) path=" + cache_astbin_v2_pruned_legacy + " bytes=" + oren_int_to_string(oren_buf_len(bs_pr_leg))) }
                var prog_pr_leg = astbin.astbin_decode(bs_pr_leg)
                if prog_pr_leg != nil {
                    _bundle_tag_stmt_list(prog_pr_leg["statements"], true)
                    if _rt_bundle_apply_cfg_in_place(ctx, prog_pr_leg, runtime_path, platform) == false { return nil }
                    // Legacy pruned caches are unsafe across pruning behavior changes: if a buggy
                    // prune removed statements, the AST cannot be recovered by "re-pruning".
                    // Only accept legacy pruned caches if they carry the current prune generation.
                    if prog_pr_leg["__oren_pruned_target_os_cache_gen"] != 3 {
                        if trace { print("[rt_bundle] cache astbin miss (legacy pruned stale gen), falling back") }
                        prog_pr_leg = nil
                    }
                }
                if prog_pr_leg != nil {
                    var os_id3 = _rt_bundle_platform_os_id(platform)
                    var already_pruned2 = false
                    if os_id3 != 0 && prog_pr_leg["__oren_pruned_target_os_id"] == os_id3 && prog_pr_leg["__oren_pruned_target_os_kind"] == "g_target_os" {
                        already_pruned2 = true
                    }
                    if already_pruned2 == false {
                        pprune.prune_runtime_os_branches_in_linked_program_in_place(prog_pr_leg, platform)
                    }
                    if _rt_bundle_validate_runtime_prog(ctx, prog_pr_leg, runtime_path) == false { return nil }
                    // Best-effort: migrate to the new suffix so future runs don't need legacy probing.
                    var bs_chk2 = oren_read_u8_buf(cache_astbin_v2_pruned)
                    if oren_is_err(bs_chk2) {
                        if _rt_bundle_pruned_cache_write_enabled() == true {
                            if trace { print("[rt_bundle] cache astbin prune encode start (migrate legacy pruned) -> " + cache_astbin_v2_pruned) }
                            var t_enc_leg0 = 0
                            if trace { t_enc_leg0 = oren_time_now_ns() }
                            var bs_pr_leg2 = astbin.astbin_encode(prog_pr_leg)
                            if bs_pr_leg2 != nil {
                                _rt_bundle_ensure_dir(cache_dir)
                                oren_write_bytes(cache_astbin_v2_pruned, bs_pr_leg2)
                                if trace {
                                    var dt_enc_leg = oren_time_now_ns() - t_enc_leg0
                                    print("[rt_bundle] cache astbin prune encode done (migrate legacy pruned) +" + oren_int_to_string(dt_enc_leg / 1000000) + "ms bytes=" + oren_int_to_string(oren_buf_len(bs_pr_leg2)))
                                }
                            } else {
                                // Fallback: copy raw bytes (may be stale/unpruned, but preserves speed).
                                _rt_bundle_ensure_dir(cache_dir)
                                oren_write_bytes(cache_astbin_v2_pruned, bs_pr_leg)
                                if trace { print("[rt_bundle] cache astbin migrated (copy legacy pruned) -> " + cache_astbin_v2_pruned) }
                            }
                        } else {
                            _rt_bundle_ensure_dir(cache_dir)
                            oren_write_bytes(cache_astbin_v2_pruned, bs_pr_leg)
                            if trace { print("[rt_bundle] cache astbin migrated (copy legacy pruned) -> " + cache_astbin_v2_pruned) }
                        }
                    }
                    if trace {
                        var dt_hit2a = oren_time_now_ns() - t_hit0
                        print("[rt_bundle] cache astbin decode(legacy pruned) done +" + oren_int_to_string(dt_hit2a / 1000000) + "ms")
                    }
                    return prog_pr_leg
                }
                if trace { print("[rt_bundle] cache astbin miss(legacy pruned) (decode failed), falling back") }
            }
        }

        // If the primary cache is the pruned variant, fall back to the non-pruned per-OS cache.
        if cache_astbin_v2_pruned != nil && cache_astbin_v2_plain != nil && cache_astbin_v2 != cache_astbin_v2_plain {
            var bs_plain = oren_read_u8_buf(cache_astbin_v2_plain)
            if !oren_is_err(bs_plain) {
                if trace { print("[rt_bundle] cache astbin hit(fallback) path=" + cache_astbin_v2_plain + " bytes=" + oren_int_to_string(oren_buf_len(bs_plain))) }
                var prog_plain = astbin.astbin_decode(bs_plain)
                if prog_plain != nil {
                    _bundle_tag_stmt_list(prog_plain["statements"], true)
                    if _rt_bundle_apply_cfg_in_place(ctx, prog_plain, runtime_path, platform) == false { return nil }
                    pprune.prune_runtime_os_branches_in_linked_program_in_place(prog_plain, platform)
                    if _rt_bundle_validate_runtime_prog(ctx, prog_plain, runtime_path) == false { return nil }
                    // Best-effort upgrade: write the pruned cache so future loads avoid decoding dead branches.
                    if _rt_bundle_pruned_cache_write_enabled() == true {
                        var bs_chk = oren_read_u8_buf(cache_astbin_v2_pruned)
                        if oren_is_err(bs_chk) {
                            if trace { print("[rt_bundle] cache astbin prune encode start -> " + cache_astbin_v2_pruned) }
                            var t_enc0 = 0
                            if trace { t_enc0 = oren_time_now_ns() }
                            var bs_pr = astbin.astbin_encode(prog_plain)
                            if bs_pr != nil {
                                _rt_bundle_ensure_dir(cache_dir)
                                oren_write_bytes(cache_astbin_v2_pruned, bs_pr)
                                if trace {
                                    var dt_enc = oren_time_now_ns() - t_enc0
                                    print("[rt_bundle] cache astbin prune encode done +" + oren_int_to_string(dt_enc / 1000000) + "ms bytes=" + oren_int_to_string(oren_buf_len(bs_pr)))
                                }
                            }
                        }
                    }
                    if trace {
                        var dt_hit2 = oren_time_now_ns() - t_hit0
                        print("[rt_bundle] cache astbin decode(fallback) done +" + oren_int_to_string(dt_hit2 / 1000000) + "ms")
                    }
                    return prog_plain
                }
                if trace { print("[rt_bundle] cache astbin miss(fallback) (decode failed), falling back") }
            }
        }

        // Best-effort migration from legacy non-platform cache to the platform-aware filename.
        if os_key != "" {
            var bs_leg = oren_read_u8_buf(cache_astbin_v2_legacy)
            if !oren_is_err(bs_leg) {
                if trace { print("[rt_bundle] cache astbin legacy hit path=" + cache_astbin_v2_legacy + " bytes=" + oren_int_to_string(oren_buf_len(bs_leg))) }
                var prog_leg = astbin.astbin_decode(bs_leg)
                if prog_leg != nil {
                    _bundle_tag_stmt_list(prog_leg["statements"], true)
                    if _rt_bundle_apply_cfg_in_place(ctx, prog_leg, runtime_path, platform) == false { return nil }
                    pprune.prune_runtime_os_branches_in_linked_program_in_place(prog_leg, platform)
                    if _rt_bundle_validate_runtime_prog(ctx, prog_leg, runtime_path) == false { return nil }
                    // Best-effort migrate to the platform-aware cache filename.
                    _rt_bundle_ensure_dir(cache_dir)
                    if cache_astbin_v2_pruned != nil && _rt_bundle_pruned_cache_write_enabled() == true {
                        if trace { print("[rt_bundle] cache astbin prune encode start (migrate) -> " + cache_astbin_v2_pruned) }
                        var t_enc1 = 0
                        if trace { t_enc1 = oren_time_now_ns() }
                        var bs_pr2 = astbin.astbin_encode(prog_leg)
                        if bs_pr2 != nil {
                            oren_write_bytes(cache_astbin_v2_pruned, bs_pr2)
                            if trace {
                                var dt_enc2 = oren_time_now_ns() - t_enc1
                                print("[rt_bundle] cache astbin prune encode done (migrate) +" + oren_int_to_string(dt_enc2 / 1000000) + "ms bytes=" + oren_int_to_string(oren_buf_len(bs_pr2)))
                            }
                        }
                    } else {
                        // Cheap migration: copy legacy bytes to the platform-aware filename.
                        // (Pruning still occurs in-memory.)
                        oren_write_bytes(cache_astbin_v2_plain, bs_leg)
                        if trace { print("[rt_bundle] cache astbin migrated (copy) -> " + cache_astbin_v2_plain) }
                    }
                    return prog_leg
                }
                if trace { print("[rt_bundle] cache astbin legacy miss (decode failed), falling back") }
            }
        }

        // Legacy SHA-256 path (migration).
        var legacy_hash = _rt_bundle_sha256_hex_string(runtime_src)
        var cache_astbin_legacy = cache_dir + "/" + legacy_hash + ".astbin"
        var bs_old = oren_read_u8_buf(cache_astbin_legacy)
        if !oren_is_err(bs_old) {
            if trace { print("[rt_bundle] cache astbin legacy hit path=" + cache_astbin_legacy + " bytes=" + oren_int_to_string(oren_buf_len(bs_old))) }
            var prog_old = astbin.astbin_decode(bs_old)
            if prog_old != nil {
                _bundle_tag_stmt_list(prog_old["statements"], true)
                if _rt_bundle_apply_cfg_in_place(ctx, prog_old, runtime_path, platform) == false { return nil }
                pprune.prune_runtime_os_branches_in_linked_program_in_place(prog_old, platform)
                if _rt_bundle_validate_runtime_prog(ctx, prog_old, runtime_path) == false { return nil }
                // Best-effort migrate to v2 so future runs avoid SHA-256 entirely.
                _rt_bundle_ensure_dir(cache_dir)
                if cache_astbin_v2_pruned != nil && _rt_bundle_pruned_cache_write_enabled() == true {
                    if trace { print("[rt_bundle] cache astbin prune encode start (sha legacy) -> " + cache_astbin_v2_pruned) }
                    var t_enc3 = 0
                    if trace { t_enc3 = oren_time_now_ns() }
                    var bs_pr3 = astbin.astbin_encode(prog_old)
                    if bs_pr3 != nil {
                        oren_write_bytes(cache_astbin_v2_pruned, bs_pr3)
                        if trace {
                            var dt_enc3 = oren_time_now_ns() - t_enc3
                            print("[rt_bundle] cache astbin prune encode done (sha legacy) +" + oren_int_to_string(dt_enc3 / 1000000) + "ms bytes=" + oren_int_to_string(oren_buf_len(bs_pr3)))
                        }
                    }
                } else {
                    // Cheap migration: copy bytes.
                    oren_write_bytes(cache_astbin_v2, bs_old)
                }
                if trace { print("[rt_bundle] cache astbin migrated -> " + cache_astbin_v2) }
                if trace {
                    var dt_old = oren_time_now_ns() - t_hit0
                    print("[rt_bundle] cache astbin legacy decode done +" + oren_int_to_string(dt_old / 1000000) + "ms")
                }
                return prog_old
            }
            if trace { print("[rt_bundle] cache astbin legacy miss (decode failed), falling back to parse") }
        }
    }

    if trace { print("[rt_bundle] parse start") }
    var l = lexer.new_lexer(runtime_src)
    l["file"] = runtime_path
    if trace { print("[rt_bundle] parser.new_parser start") }
    var p2 = parser.new_parser(l)
    if trace { print("[rt_bundle] parser.new_parser done") }
    if trace { print("[rt_bundle] parse_program start") }
    var runtime_prog = parser.parse_program(p2)
    if trace { print("[rt_bundle] parse_program done") }
    if trace {
        var dt2 = oren_time_now_ns() - t0
        var nerr = 0
        if p2 != nil && p2["errors"] != nil { nerr = oren_list_len(p2["errors"]) }
        print("[rt_bundle] parse done +" + oren_int_to_string(dt2 / 1000000) + "ms errors=" + oren_int_to_string(nerr))
    }
    if p2 != nil && p2["errors"] != nil && oren_list_len(p2["errors"]) != 0 {
        _bundle_err(ctx, "Parse errors in " + runtime_path)
        var ei = 0
        while ei < oren_list_len(p2["errors"]) {
            _bundle_err(ctx, p2["errors"][ei])
            ei = ei + 1
        }
        return nil
    }


    // Mark as runtime so platform pruning can apply.
    _bundle_tag_stmt_list(runtime_prog["statements"], true)
    _rt_bundle_trace_fn_shape(runtime_prog, "pre_pprune")

    if _rt_bundle_apply_cfg_in_place(ctx, runtime_prog, runtime_path, platform) == false { return nil }

    // Prune dead `g_target_os` branches before validation and caching.
    pprune.prune_runtime_os_branches_in_linked_program_in_place(runtime_prog, platform)
    _rt_bundle_trace_fn_shape(runtime_prog, "post_pprune")
    if _rt_bundle_validate_runtime_prog(ctx, runtime_prog, runtime_path) == false { return nil }

    // Optional: dump the parsed runtime AST to astbin for fast future loads.
    var dump_astbin = oren_env("OREN_DUMP_NATIVE_RUNTIME_ASTBIN")
    if dump_astbin != nil {
        var p_out = dump_astbin
        if p_out == "" { p_out = "build/runtime_native.astbin" }
        var bs2 = astbin.astbin_encode(runtime_prog)
        if bs2 != nil {
            oren_write_bytes(p_out, bs2)
        }
    }

    // Default: write an astbin cache keyed by the expanded runtime fingerprint.
    if cache_enabled == true {
        // Only write on miss.
        var bs_chk = oren_read_u8_buf(cache_astbin_v2)
        if oren_is_err(bs_chk) {
            _rt_bundle_ensure_dir(cache_dir)
            var bs3 = astbin.astbin_encode(runtime_prog)
            if bs3 != nil {
                oren_write_bytes(cache_astbin_v2, bs3)
                if trace { print("[rt_bundle] cache astbin wrote path=" + cache_astbin_v2) }
            }
        }
    }

    // Parser/lexer temporaries become unreachable after building the runtime AST.
    // Collect here so long native builds don't accumulate dead objects.
    if ctx["__compiler_gc_aggressive"] == true {
        oren_gc_collect()
    }
    return runtime_prog
}

fn load_and_parse_runtime_native(ctx, runtime_path) {
    return _load_and_parse_runtime_native_impl(ctx, runtime_path, nil)
}

fn load_and_parse_runtime_native_for_platform(ctx, runtime_path, platform) {
    return _load_and_parse_runtime_native_impl(ctx, runtime_path, platform)
}

fn inject_runtime_into_linked_and_dce(ctx, backend, linked, runtime_prog, platform, aliases) {
    // Build a merged linked program:
    //   [runtime stmts...] + [user stmts...]
    //
    // Then run whole-program DCE (function-only) to keep compilation time bounded and
    // to reduce the surface area of backend-only unimplemented features.
    //
    // Returns:
    // - linked2: merged linked program after DCE
    // - runtime_stmts: tagged runtime statements still present after DCE
    // - user_stmts: remaining user statements after DCE
    if ctx == nil { return nil }
    if linked == nil { _bundle_err(ctx, "native runtime bundle: linked is nil"); return nil }
    if runtime_prog == nil { _bundle_err(ctx, "native runtime bundle: runtime_prog is nil"); return nil }

    var rs = runtime_prog["statements"]
    if rs == nil { rs = [] }
    var us = linked["statements"]
    if us == nil { us = [] }

    // Tag runtime statements so callers can split after DCE without relying on indices.
    _bundle_tag_stmt_list(rs, true)
    _bundle_tag_stmt_list(us, false)

    var merged = []
    var i = 0
    while i < oren_list_len(rs) { oren_list_push(merged, rs[i]); i = i + 1 }
    i = 0
    while i < oren_list_len(us) { oren_list_push(merged, us[i]); i = i + 1 }

    var cfg0 = linked["config"]
    var roots = _bundle_roots_for_backend(backend, platform)
    var cfg = _bundle_config_merge_roots(cfg0, roots)
    // Thread capsule mode through config so whole-program DCE can make correct decisions.
    if platform != nil && platform["capsule"] == true {
        cfg["capsule"] = true
    }

    var linked2 = {"statements": merged, "aliases": aliases, "config": cfg}

    // Run DCE after injection unless explicitly disabled by config.
    global_dce.lower_linked_program_in_place(linked2)

    var stmts2 = linked2["statements"]
    var split = _bundle_split_stmt_list_by_runtime_tag(stmts2)
    return {"linked": linked2, "runtime_stmts": split["runtime"], "user_stmts": split["user"]}
}

fn prepare_native_runtime_bundle(ctx, backend, linked, platform, opts) {
    // High-level entrypoint used by native backends.
    //
    // backend:
    // - "arm64" for arm64 native backend
    // - "x64"   for x86_64 native backend
    //
    // opts:
    // - runtime_path: path to the runtime entry file (default: "lib/runtime_native.oren")
    // - inject_runtime: bool (default: true)
    //
    // Returns:
    // - inject_runtime: bool
    // - runtime_prog: runtime program AST (if injected)
    // - linked2: merged linked program after DCE (if injected)
    // - runtime_stmts, user_stmts: statement lists after DCE split by runtime tag
    if ctx == nil { return nil }
    if linked == nil { _bundle_err(ctx, "native runtime bundle: linked is nil"); return nil }
    if platform == nil { platform = {} }

    var runtime_path = "lib/runtime_native.oren"
    var inject_runtime = true
    if opts != nil {
        if opts["runtime_path"] != nil { runtime_path = opts["runtime_path"] }
        if opts["inject_runtime"] == false { inject_runtime = false }
    }

    if inject_runtime == false {
        return {"inject_runtime": false, "runtime_prog": nil, "linked2": linked, "runtime_stmts": [], "user_stmts": linked["statements"]}
    }

    // Heuristic for whether to spend time doing full-heap GC during compilation.
    // - For small programs this is wasted work and can push builds over test timeouts.
    // - For self-hosting / huge graphs, it prevents runaway memory growth from dead temporaries.
    var force_gc = oren_env("OREN_COMPILER_GC")
    var aggressive_gc = (force_gc == "1" || force_gc == "true")
    // IMPORTANT (native runtime correctness, rolling):
    // The current native GC does not yet scan compiler global variables, so forcing collections
    // automatically can trigger use-after-free crashes in the self-hosted compiler. Keep this
    // strictly opt-in until global-root scanning is implemented.
    ctx["__compiler_gc_aggressive"] = aggressive_gc

    var trace_bundle = false
    if oren_env("OREN_TRACE_NATIVE_RUNTIME_BUNDLE") != nil { trace_bundle = true }
    if oren_env("OREN_TRACE_X64_COMPILE_PROGRESS") != nil { trace_bundle = true }
    if trace_bundle { print("[bundle] load runtime path=" + runtime_path) }
    var runtime_prog = load_and_parse_runtime_native_for_platform(ctx, runtime_path, platform)
    if runtime_prog == nil { return nil }
    if trace_bundle { print("[bundle] runtime load done") }

    // Capsule enforcement (compile-time):
    //
    // - enforced against runtime annotations, but scanned on user program only.
    // - consistent across native backends (Tier‑1 parity).
    if platform["capsule"] == true {
        capsule.enforce_capsule(runtime_prog, linked, platform["cap_allow_domains"])
    }

    var aliases = linked["aliases"]
    if aliases == nil { aliases = {} }

    if trace_bundle { print("[bundle] inject+dce start") }
    var out = inject_runtime_into_linked_and_dce(ctx, backend, linked, runtime_prog, platform, aliases)
    if out == nil { return nil }
    if trace_bundle { print("[bundle] inject+dce done") }

    out["inject_runtime"] = true
    out["runtime_prog"] = runtime_prog
    return out
}
