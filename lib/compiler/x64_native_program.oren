fn err(ctx, msg) {
    if ctx["errors"] == nil { ctx["errors"] = [] }
    oren_list_push(ctx["errors"], msg)
}

fn _int_from_string_dec(s) {
    // Minimal decimal parser (no hex/bin/octal) for v0.
    if s == nil { return nil }
    var i = 0
    var neg = false
    if oren_string_len(s) > 0 && oren_string_char_at(s, 0) == "-" { neg = true; i = 1 }
    var n = 0
    while i < oren_string_len(s) {
        var c = oren_string_char_at(s, i)
        var digit = -1
        if c == "0" { digit = 0 }
        else if c == "1" { digit = 1 }
        else if c == "2" { digit = 2 }
        else if c == "3" { digit = 3 }
        else if c == "4" { digit = 4 }
        else if c == "5" { digit = 5 }
        else if c == "6" { digit = 6 }
        else if c == "7" { digit = 7 }
        else if c == "8" { digit = 8 }
        else if c == "9" { digit = 9 }
        else { return nil }
        n = n * 10 + digit
        i = i + 1
    }
    if neg { return 0 - n }
    return n
}

fn _extract_main_return_i64(ctx, linked) {
    if linked == nil { return nil }
    var stmts = linked["statements"]
    if stmts == nil { err(ctx, "x64 native v0: missing program statements"); return nil }

    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        var s = nil
        if st != nil {
            if st["type"] == "Function" { s = st }
            if st["type"] == "ExprStmt" {
                var e = st["expr"]
                if e != nil && e["type"] == "Function" { s = e }
            }
        }
        if s != nil && s["type"] == "Function" && s["name"] == "main" {
            var body = s["body"]
            if body == nil { err(ctx, "x64 native v0: main has no body"); return nil }
            // Expect: body is a Block with a Return as the last statement.
            if body["type"] == "Block" {
                var bstmts = body["stmts"]
                if bstmts == nil || oren_list_len(bstmts) == 0 { err(ctx, "x64 native v0: main block empty"); return nil }
                var last = bstmts[oren_list_len(bstmts) - 1]
                if last == nil || last["type"] != "Return" { err(ctx, "x64 native v0: main must end with return"); return nil }
                var v = last["value"]
                if v == nil || v["type"] != "Integer" { err(ctx, "x64 native v0: main return must be integer literal"); return nil }
                var n = _int_from_string_dec(v["value"])
                if n == nil { err(ctx, "x64 native v0: invalid integer literal in return"); return nil }
                if n < 0 { err(ctx, "x64 native v0: negative return not supported yet"); return nil }
                return n
            }
            if body["type"] == "Return" {
                var v2 = body["value"]
                if v2 == nil || v2["type"] != "Integer" { err(ctx, "x64 native v0: main return must be integer literal"); return nil }
                var n2 = _int_from_string_dec(v2["value"])
                if n2 == nil { err(ctx, "x64 native v0: invalid integer literal in return"); return nil }
                if n2 < 0 { err(ctx, "x64 native v0: negative return not supported yet"); return nil }
                return n2
            }
            err(ctx, "x64 native v0: unsupported main body shape: " + body["type"])
            return nil
        }
        i = i + 1
    }

    err(ctx, "x64 native v0: missing fn main()")
    return nil
}

fn _data_add_cstr_newline(ctx, s) {
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    var b = oren_bytes_from_string(s)
    // Append newline and NUL for tooling visibility.
    bytes_push(b, 10)
    bytes_push(b, 0)
    // 8B align (helps future u64 reads; harmless for strings).
    while core.int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = oren_list_len(ctx["data"])
    bytes_extend(ctx["data"], b)
    // Return {"off": int, "len": int} where len excludes trailing NUL.
    return {"off": off, "len": oren_list_len(b) - 1}
}

fn _data_add_fnobj(ctx, fn_name) {
    // Create (or reuse) a function-value object in the appended data blob.
    //
    // Layout (16 bytes):
    //   [0] code_ptr (u64)  -- patched by emitter
    //   [8] env_ptr  (u64)  -- 0 for now (no closures in x64 v0)
    //
    // NOTE: this does not yet implement the full canonical callable ABI
    // (env,args_list wrappers). It is a convergence step so function values are
    // not raw code pointers.
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if ctx["fnobj_offs"] == nil { ctx["fnobj_offs"] = {} }
    if ctx["fnobj_offs"][fn_name] != nil { return ctx["fnobj_offs"][fn_name] }

    while core.int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = oren_list_len(ctx["data"])
    // code_ptr placeholder (8 bytes)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)
    // env_ptr = 0 (8 bytes)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)

    ctx["fnobj_offs"][fn_name] = off
    oren_list_push(ctx["fixups"], {"type": "data_fnobj_code_ptr", "data_off": off, "name": fn_name})
    return off
}

fn _emit_linux_write_cstr(ctx, s) {
    // Emit SYS_write(1, s_ptr, len) where s_ptr is a RIP-relative pointer to appended data.
    var meta = _data_add_cstr_newline(ctx, s)
    if meta == nil { return nil }
    var data_off = meta["off"]
    var nbytes = meta["len"]

    // rax = 1 (SYS_write), rdi = 1 (stdout), rsi = &data, rdx = len
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1)) // eax=1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 1)) // edi=1

    var lea_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_rsi_rip_disp32(0)) // patch disp32
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea_rsi", "pos": lea_pos + 3, "data_off": data_off})

    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, nbytes)) // edx=len
    bytes_extend(ctx["code"], insn_syscall())
    return nil
}

fn _cond_check(ctx, cond) {
    // Supported cond forms (rolling v0):
    // - Any int-ish expression, using language truthiness semantics (0 is false).
    // - Comparison infix: == != < <= > >= (keeps "cmp+Jcc" lowering compact).
    if cond == nil { err(ctx, "x64 native v0: missing condition"); return nil }

    // Comparison form is a special-case: we currently only support comparing
    // an evaluated LHS expression against a restricted RHS subset (rolling forward).
    if _cond_is_cmp_infix(cond) != nil {
        var op = cond["op"]
        var l = cond["left"]
        var r = cond["right"]
        if l == nil || r == nil { err(ctx, "x64 native v0: condition infix missing operands"); return nil }
        _expr_int_check(ctx, l)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        _expr_int_check(ctx, r)
        return nil
    }

    // Truthy expression form.
    // Special-case `!x` so `if !x { ... }` works without needing full bool lowering in v0.
    if cond["type"] == "Prefix" && cond["op"] == "!" {
        var r2 = cond["right"]
        if r2 == nil { err(ctx, "x64 native v0: condition prefix ! missing operand"); return nil }
        if _cond_is_cmp_infix(r2) != nil { return nil }
        _expr_int_check(ctx, r2)
        return nil
    }
    _expr_int_check(ctx, cond)
    return nil
}

fn _cond_is_cmp_infix(cond) {
    if cond == nil { return nil }
    if cond["type"] != "Infix" { return nil }
    var op = cond["op"]
    if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return 1 }
    return nil
}

fn _cond_false_cc(cond_op) {
    // Return the Jcc condition code for "cond is false", given `cond_op`.
    if cond_op == "==" { return "ne" }
    if cond_op == "!=" { return "e" }
    if cond_op == "<" { return "ge" }
    if cond_op == "<=" { return "g" }
    if cond_op == ">" { return "le" }
    if cond_op == ">=" { return "l" }
    return nil
}

fn _cond_true_cc(cond_op) {
    // Return the Jcc condition code for "cond is true", given `cond_op`.
    if cond_op == "==" { return "e" }
    if cond_op == "!=" { return "ne" }
    if cond_op == "<" { return "l" }
    if cond_op == "<=" { return "le" }
    if cond_op == ">" { return "g" }
    if cond_op == ">=" { return "ge" }
    return nil
}

fn _cond_false_cc_for_cond(cond) {
    // After `_emit_cmp_from_cond`, flags are:
    // - comparison: based on `cmp lhs, rhs`
    // - truthy expr: based on `cmp expr, 0`
    if _cond_is_cmp_infix(cond) != nil { return _cond_false_cc(cond["op"]) }
    if cond != nil && cond["type"] == "Prefix" && cond["op"] == "!" {
        // !x is false when x is truthy (x != 0)
        var inner = cond["right"]
        if _cond_is_cmp_infix(inner) != nil {
            // !(lhs op rhs) is false when (lhs op rhs) is true.
            return _cond_true_cc(inner["op"])
        }
        return "ne"
    }
    // expr is false when expr == 0
    return "e"
}

fn _analyze_stmt_list_to_ops(ctx, stmts) {
    var ops = []
    if stmts == nil { return ops }
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st == nil { i = i + 1; continue }
        var t = st["type"]
        if t == "Var" {
            var name_node = st["name"]
            var v0 = st["value"]
            if name_node == nil || name_node["type"] != "Identifier" { err(ctx, "x64 native v0: var name must be identifier"); return nil }
            if v0 == nil { err(ctx, "x64 native v0: var init missing"); return nil }
            oren_list_push(ops, {"op": "var_i32", "name": name_node["value"], "expr": v0})
            i = i + 1
            continue
        }
        if t == "ExprStmt" {
            var e = st["expr"]
            if e == nil { i = i + 1; continue }
            // Some parts of the pipeline represent statement-forms as an ExprStmt wrapper.
            // Accept common control-flow nodes here to avoid backend fragility as the AST evolves.
            if e["type"] == "If" || e["type"] == "While" || e["type"] == "For" {
                var tmp = _analyze_stmt_list_to_ops(ctx, [e])
                if tmp == nil { return nil }
                // Splice in the ops produced by the wrapped statement.
                var k = 0
                while k < oren_list_len(tmp) { oren_list_push(ops, tmp[k]); k = k + 1 }
                i = i + 1
                continue
            }
            if e["type"] == "Call" {
                var callee = e["fn"]
                var args = e["args"]
                if callee != nil && callee["type"] == "Identifier" && callee["value"] == "print" {
                    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: print expects 1 arg"); return nil }
                    var a0 = args[0]
                    if a0 == nil || a0["type"] != "String" { err(ctx, "x64 native v0: print only supports string literal"); return nil }
                    oren_list_push(ops, {"op": "print_cstr", "value": a0["value"]})
                    i = i + 1
                    continue
                }
            }
            err(ctx, "x64 native v0: unsupported expr statement")
            return nil
        }
        if t == "Assign" {
            var name_node2 = st["name"]
            var v2 = st["value"]
            if name_node2 == nil || name_node2["type"] != "Identifier" { err(ctx, "x64 native v0: assign name must be identifier"); return nil }
            if v2 == nil { err(ctx, "x64 native v0: assign missing value"); return nil }
            oren_list_push(ops, {"op": "assign_i32", "name": name_node2["value"], "expr": v2})
            i = i + 1
            continue
        }
        if t == "Return" {
            var v = st["value"]
            if v == nil { err(ctx, "x64 native v0: return missing value"); return nil }
            oren_list_push(ops, {"op": "return", "expr": v})
            i = i + 1
            continue
        }
        if t == "If" {
            _cond_check(ctx, st["cond"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            var then_block = st["consq"]
            var else_node = st["alt"]
            if then_block == nil || then_block["type"] != "Block" { err(ctx, "x64 native v0: if then must be Block"); return nil }
            var then_ops = _analyze_stmt_list_to_ops(ctx, then_block["stmts"])
            if then_ops == nil { return nil }
            var else_ops = []
            if else_node != nil {
                if else_node["type"] == "Block" {
                    else_ops = _analyze_stmt_list_to_ops(ctx, else_node["stmts"])
                    if else_ops == nil { return nil }
                } else if else_node["type"] == "If" {
                    // else-if chain: represent as else { if ... }
                    var tmp = _analyze_stmt_list_to_ops(ctx, [else_node])
                    if tmp == nil { return nil }
                    else_ops = tmp
                } else {
                    err(ctx, "x64 native v0: unsupported else node: " + else_node["type"])
                    return nil
                }
            }
            oren_list_push(ops, {"op": "if", "cond": st["cond"], "then": then_ops, "else": else_ops})
            i = i + 1
            continue
        }
        if t == "While" {
            _cond_check(ctx, st["cond"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            var body = st["body"]
            if body == nil || body["type"] != "Block" { err(ctx, "x64 native v0: while body must be Block"); return nil }
            var body_ops = _analyze_stmt_list_to_ops(ctx, body["stmts"])
            if body_ops == nil { return nil }
            oren_list_push(ops, {"op": "while", "cond": st["cond"], "body": body_ops})
            i = i + 1
            continue
        }
        if t == "For" {
            // Support a tiny subset:
            // - `for <cond> { ... }` (cond-only form)
            // - `for var i = 0; <cond>; i = i + 1 { ... }` (3-clause form)
            var init = st["init"]
            var cond = st["cond"]
            var post = st["post"]
            var body3 = st["body"]
            if body3 == nil || body3["type"] != "Block" { err(ctx, "x64 native v0: for body must be Block"); return nil }
            if cond == nil { err(ctx, "x64 native v0: for missing cond"); return nil }
            _cond_check(ctx, cond)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            // Cond-only form => lower to while.
            if init == nil && post == nil {
                var bops = _analyze_stmt_list_to_ops(ctx, body3["stmts"])
                if bops == nil { return nil }
                oren_list_push(ops, {"op": "while", "cond": cond, "body": bops})
                i = i + 1
                continue
            }

            // 3-clause form: init and post must be present.
            if init == nil || post == nil {
                err(ctx, "x64 native v0: for init/post required in 3-clause form")
                return nil
            }
            var init_ops = _analyze_stmt_list_to_ops(ctx, [init])
            if init_ops == nil { return nil }
            var post_ops = _analyze_stmt_list_to_ops(ctx, [post])
            if post_ops == nil { return nil }
            var body_ops2 = _analyze_stmt_list_to_ops(ctx, body3["stmts"])
            if body_ops2 == nil { return nil }

            // Restrict post to a single assignment for now (prevents weird continue behavior).
            if oren_list_len(post_ops) != 1 || post_ops[0]["op"] != "assign_i32" {
                err(ctx, "x64 native v0: for post must be assignment")
                return nil
            }
            oren_list_push(ops, {"op": "for", "init": init_ops, "cond": cond, "post": post_ops, "body": body_ops2})
            i = i + 1
            continue
        }
        if t == "Break" {
            oren_list_push(ops, {"op": "break"})
            i = i + 1
            continue
        }
        if t == "Continue" {
            oren_list_push(ops, {"op": "continue"})
            i = i + 1
            continue
        }
        err(ctx, "x64 native v0: unsupported stmt: " + t)
        return nil
    }
    return ops
}

fn _analyze_supported_fn_body(ctx, fn_node) {
    var body = fn_node["body"]
    if body == nil { err(ctx, "x64 native v0: function has no body"); return nil }
    if body["type"] != "Block" {
        err(ctx, "x64 native v0: function body must be Block")
        return nil
    }
    var ops = _analyze_stmt_list_to_ops(ctx, body["stmts"])
    if ops == nil { return nil }

    // If last statement is not a return, add an implicit `return 0` to keep the ABI sane.
    if oren_list_len(ops) == 0 || ops[oren_list_len(ops) - 1]["op"] != "return" {
        oren_list_push(ops, {"op": "return", "expr": {"type": "Integer", "value": "0"}})
    }
    return ops
}

fn _expr_int_check(ctx, expr) {
    if expr == nil { err(ctx, "x64 native v0: missing expr"); return nil }
    var t = expr["type"]
    if t == "Integer" {
        var n = _int_from_string_dec(expr["value"])
        if n == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
        // v0: literals are restricted to signed i32 range so we can encode them via imm32
        // and keep arithmetic/cmp semantics unambiguous.
        if n < -2147483648 { err(ctx, "x64 native v0: int literal too small (min i32)"); return nil }
        if n > 2147483647 { err(ctx, "x64 native v0: int literal too large (max i32)"); return nil }
        return nil
    }
    if t == "Boolean" { return nil }
    if t == "Identifier" { return nil }
    if t == "Call" {
        var fn_expr = expr["fn"]
        var args = expr["args"]
        if fn_expr == nil || fn_expr["type"] != "Identifier" { err(ctx, "x64 native v0: call target must be identifier"); return nil }
        var nm = fn_expr["value"]
        if nm == "print" { err(ctx, "x64 native v0: print is statement-only"); return nil }
        var argc = 0
        if args != nil { argc = oren_list_len(args) }
        var max_args = abi.max_int_reg_args(ctx["abi"])
        if argc > max_args { err(ctx, "x64 native v0: call supports at most " + oren_int_to_string(max_args) + " args for now"); return nil }

        // Direct calls enforce arity; indirect calls (callable value in a local/param) are permitted
        // in v0 bring-up without static arity tracking.
        var arity = nil
        if ctx["func_arity"] != nil { arity = ctx["func_arity"][nm] }
        if arity != nil {
            var declared = ctx["declared_functions"]
            if declared != nil && declared[nm] == nil { err(ctx, "x64 native v0: undefined function " + nm); return nil }
            if argc != arity { err(ctx, "x64 native v0: call arity mismatch for " + nm); return nil }
        }

        var i = 0
        while i < argc {
            _expr_int_check(ctx, args[i])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            i = i + 1
        }
        return nil
    }
    if t == "Infix" {
        var op = expr["op"]
        if op != "+" && op != "-" && op != "*" && op != "/" && op != "%" &&
            op != "==" && op != "!=" && op != "<" && op != "<=" && op != ">" && op != ">=" &&
            op != "&&" && op != "||" &&
            op != "&" && op != "|" && op != "^" && op != "<<" && op != ">>" {
            err(ctx, "x64 native v0: infix op not supported: " + op)
            return nil
        }
        var l = expr["left"]
        var r = expr["right"]
        if l == nil || r == nil { err(ctx, "x64 native v0: infix missing operands"); return nil }

        // Rolling: allow nested infix expressions for + and - (and as the LHS of `*`)
        // so chains like `a + b + c + d` work.
        _expr_int_check(ctx, l)
        _expr_int_check(ctx, r)
        return nil
    }
    if t == "Prefix" {
        var op = expr["op"]
        if op != "-" && op != "~" && op != "!" {
            err(ctx, "x64 native v0: prefix op not supported: " + op)
            return nil
        }
        var r = expr["right"]
        if r == nil { err(ctx, "x64 native v0: prefix missing operand"); return nil }
        _expr_int_check(ctx, r)
        return nil
    }
    err(ctx, "x64 native v0: expr not supported: " + t)
    return nil
}

fn _emit_eval_int_to_rax(ctx, expr, locals) {
    // Evaluate a tiny integer expression into RAX (64-bit register).
    //
    // Rolling v0 constraint: integer literals are restricted to signed i32 range (imm32)
    // but values are stored/propagated through 64-bit registers and stack slots.
    // Supports:
    // - Integer
    // - Identifier (locals/params; or a named function as a first-class function pointer)
    // - Infix (+/-) with subexpressions from the above set
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Integer" {
        var n = _int_from_string_dec(expr["value"])
        if n == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
        if n < -2147483648 || n > 2147483647 { err(ctx, "x64 native v0: int literal out of i32 range"); return nil }
        // mov eax, imm32 then sign-extend to rax (cdqe)
        var imm_u32 = n
        if n < 0 { imm_u32 = 4294967296 + n }
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, imm_u32))
        bytes_extend(ctx["code"], insn_cdqe())
        return nil
    }
    if t == "Boolean" {
        // Map boolean literal to i32 0/1, then sign-extend to rax.
        var v = expr["value"]
        var imm = 0
        if v { imm = 1 }
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, imm))
        bytes_extend(ctx["code"], insn_cdqe())
        return nil
    }
    if t == "Identifier" {
        var name = expr["value"]
        var off = locals[name]
        if off != nil {
            var disp8 = core.int_mod(0 - off, 256)
            // Load full 64-bit slot so function pointers round-trip correctly.
            bytes_extend(ctx["code"], insn_mov_r64_mrbp_disp8(0, disp8))
            return nil
        }

        // Named function used in expression position => treat as a first-class function value.
        // v0 representation: pointer to a small `{code_ptr, env_ptr}` object in the data blob.
        if ctx["func_arity"] != nil && ctx["func_arity"][name] != nil {
            var fnobj_off = _data_add_fnobj(ctx, name)
            if fnobj_off == nil { err(ctx, "x64 native v0: failed to allocate fnobj"); return nil }

            var lea_pos = oren_list_len(ctx["code"])
            bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(0, 0))
            // Patch disp32 to point at the fnobj data record.
            oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": fnobj_off})
            return nil
        }

        err(ctx, "x64 native v0: unknown var " + name)
        return nil
    }
    if t == "Call" {
        var fn_expr = expr["fn"]
        var args = expr["args"]
        if fn_expr == nil || fn_expr["type"] != "Identifier" { err(ctx, "x64 native v0: call target must be identifier"); return nil }
        var nm = fn_expr["value"]
        if nm == "print" { err(ctx, "x64 native v0: print is statement-only"); return nil }
        var argc = 0
        if args != nil { argc = oren_list_len(args) }
        var max_args = abi.max_int_reg_args(ctx["abi"])
        if argc > max_args { err(ctx, "x64 native v0: call supports at most " + oren_int_to_string(max_args) + " args for now"); return nil }

        var is_direct = false
        var declared = ctx["declared_functions"]
        if declared != nil && declared[nm] != nil { is_direct = true }
        var callee_off = nil
        if is_direct != true {
