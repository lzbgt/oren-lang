            if r != nil && r["type"] == "Identifier" {
                var off2 = locals[r["value"]]
                if off2 == nil { err(ctx, "x64 native v0: unknown var " + r["value"]); return nil }
                var disp82 = core.int_mod(0 - off2, 256)
                bytes_extend(ctx["code"], insn_mov_r64_mrbp_disp8(2, disp82)) // rdx = rhs
                bytes_extend(ctx["code"], insn_mov_r64_r64(1, 2)) // rcx = rhs (CL)
                bytes_extend(ctx["code"], insn_and_r64_imm32(1, 63)) // rcx &= 63
                if op == "<<" { bytes_extend(ctx["code"], insn_shl_r64_cl(0)) }
                else { bytes_extend(ctx["code"], insn_shr_r64_cl(0)) }
                return nil
            }

            // General RHS expression: spill lhs, eval RHS into RAX, move to RCX, restore lhs, shift.
            var tmp_offs = locals["$tmp_shift"]
            if tmp_offs == nil { err(ctx, "x64 native v0: missing temp slot for shift"); return nil }
            var tmp_disp8s = core.int_mod(0 - tmp_offs, 256)
            bytes_extend(ctx["code"], insn_mov_mrbp_disp8_r64(tmp_disp8s, 0)) // [tmp] = lhs
            _emit_eval_int_to_rax(ctx, r, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0)) // rcx = rhs
            bytes_extend(ctx["code"], insn_and_r64_imm32(1, 63)) // rcx &= 63
            bytes_extend(ctx["code"], insn_mov_r64_mrbp_disp8(0, tmp_disp8s)) // rax = lhs
            if op == "<<" { bytes_extend(ctx["code"], insn_shl_r64_cl(0)) }
            else { bytes_extend(ctx["code"], insn_shr_r64_cl(0)) }
            return nil
        }

        if op == "&" || op == "|" || op == "^" {
            _emit_eval_int_to_rax(ctx, l, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            if r != nil && r["type"] == "Integer" {
                var n3 = _int_from_string_dec(r["value"])
                if n3 == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
                if n3 < -2147483648 || n3 > 2147483647 { err(ctx, "x64 native v0: int literal out of i32 range"); return nil }
                var imm_u32_3 = n3
                if n3 < 0 { imm_u32_3 = 4294967296 + n3 }
                if op == "&" { bytes_extend(ctx["code"], insn_and_r64_imm32(0, imm_u32_3)) }
                else if op == "|" { bytes_extend(ctx["code"], insn_or_r64_imm32(0, imm_u32_3)) }
                else { bytes_extend(ctx["code"], insn_xor_r64_imm32(0, imm_u32_3)) }
                return nil
            }
            if r != nil && r["type"] == "Identifier" {
                var off3 = locals[r["value"]]
                if off3 == nil { err(ctx, "x64 native v0: unknown var " + r["value"]); return nil }
                var disp83 = core.int_mod(0 - off3, 256)
                bytes_extend(ctx["code"], insn_mov_r64_mrbp_disp8(2, disp83)) // rdx = rhs
                if op == "&" { bytes_extend(ctx["code"], insn_and_r64_r64(0, 2)) }
                else if op == "|" { bytes_extend(ctx["code"], insn_or_r64_r64(0, 2)) }
                else { bytes_extend(ctx["code"], insn_xor_r64_r64(0, 2)) }
                return nil
            }

            // General RHS expression: spill lhs, eval RHS into RAX, move to RDX, restore lhs, op.
            var tmp_offb = locals["$tmp0"]
            if tmp_offb == nil { err(ctx, "x64 native v0: missing temp slot for bitop"); return nil }
            var tmp_disp8b = core.int_mod(0 - tmp_offb, 256)
            bytes_extend(ctx["code"], insn_mov_mrbp_disp8_r64(tmp_disp8b, 0)) // [tmp] = lhs
            _emit_eval_int_to_rax(ctx, r, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_mov_r64_r64(2, 0)) // rdx = rhs
            bytes_extend(ctx["code"], insn_mov_r64_mrbp_disp8(0, tmp_disp8b)) // rax = lhs
            if op == "&" { bytes_extend(ctx["code"], insn_and_r64_r64(0, 2)) }
            else if op == "|" { bytes_extend(ctx["code"], insn_or_r64_r64(0, 2)) }
            else { bytes_extend(ctx["code"], insn_xor_r64_r64(0, 2)) }
            return nil
        }

        _emit_eval_int_to_rax(ctx, l, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        if r != nil && r["type"] == "Integer" {
            var n2 = _int_from_string_dec(r["value"])
            if n2 == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
            if n2 < -2147483648 || n2 > 2147483647 { err(ctx, "x64 native v0: int literal out of i32 range"); return nil }
            var imm_u32_2 = n2
            if n2 < 0 { imm_u32_2 = 4294967296 + n2 }
            if op == "+" { bytes_extend(ctx["code"], insn_add_r64_imm32(0, imm_u32_2)) }
            else if op == "-" { bytes_extend(ctx["code"], insn_sub_r64_imm32(0, imm_u32_2)) }
            else { bytes_extend(ctx["code"], insn_imul_r64_imm32(0, imm_u32_2)) }
            return nil
        }
        if r != nil && r["type"] == "Identifier" {
            var off2 = locals[r["value"]]
            if off2 == nil { err(ctx, "x64 native v0: unknown var " + r["value"]); return nil }
            var disp82 = core.int_mod(0 - off2, 256)
            bytes_extend(ctx["code"], insn_mov_r64_mrbp_disp8(2, disp82)) // rdx = rhs
