            var tmp_name = "$tmp_arg" + oren_int_to_string(i)
            var tmp_off = locals[tmp_name]
            if tmp_off == nil { err(ctx, "x64 native v0: missing temp slot " + tmp_name); return nil }
            var tmp_disp8 = core.int_mod(0 - tmp_off, 256)
            // Spill the full 64-bit value (keeps function pointer args intact).
            bytes_extend(ctx["code"], insn_mov_mrbp_disp8_r64(tmp_disp8, 0)) // [tmp] = rax
            i = i + 1
