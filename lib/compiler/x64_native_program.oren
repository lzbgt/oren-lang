            var tmp_off2 = locals[tmp_name2]
            if tmp_off2 == nil { err(ctx, "x64 native v0: missing temp slot " + tmp_name2); return nil }
            var tmp_disp82 = core.int_mod(0 - tmp_off2, 256)
            bytes_extend(ctx["code"], insn_mov_r64_mrbp_disp8(reg, tmp_disp82))
