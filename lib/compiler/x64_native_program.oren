            // lowering, so callers don't need to plumb label/fixup state.
            var labels = {}
            var local_fixups = []
            var l_short = _new_label(ctx, "sc_l")
            var end = _new_label(ctx, "sc_end")

            _emit_eval_int_to_rax(ctx, l, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))

            if op == "&&" {
                // if lhs == 0 => result 0, skip rhs
                _emit_jcc_to_label(ctx, local_fixups, "e", l_short)

                _emit_eval_int_to_rax(ctx, r, locals)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
                bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
                bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
                bytes_extend(ctx["code"], insn_setcc_al("ne"))
                bytes_extend(ctx["code"], insn_cdqe())
                _emit_jmp_to_label(ctx, local_fixups, end)

                _emit_label(ctx, labels, l_short)
                bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
                bytes_extend(ctx["code"], insn_cdqe())
                _emit_label(ctx, labels, end)
                _patch_local_fixups(ctx, labels, local_fixups)
                return nil
            }

            // op == "||"
            // if lhs != 0 => result 1, skip rhs
            _emit_jcc_to_label(ctx, local_fixups, "ne", l_short)

            _emit_eval_int_to_rax(ctx, r, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
            bytes_extend(ctx["code"], insn_setcc_al("ne"))
            bytes_extend(ctx["code"], insn_cdqe())
            _emit_jmp_to_label(ctx, local_fixups, end)

            _emit_label(ctx, labels, l_short)
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
            bytes_extend(ctx["code"], insn_cdqe())
            _emit_label(ctx, labels, end)
            _patch_local_fixups(ctx, labels, local_fixups)
            return nil
        }
        if _cond_is_cmp_infix(expr) != nil {
            // Compare-expression lowering: result is 0/1 in RAX (bool-as-int).
            _emit_cmp_from_cond(ctx, expr, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
            var cc1 = _cond_true_cc(op)
            if cc1 == nil { err(ctx, "x64 native v0: unsupported compare op"); return nil }
            bytes_extend(ctx["code"], insn_setcc_al(cc1))
            bytes_extend(ctx["code"], insn_cdqe())
            return nil
