            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            // Shift counts are masked to 0..63 (x86-64 semantics; keeps deterministic behavior).
            if r != nil && r["type"] == "Integer" {
                var n2 = _int_from_string_dec(r["value"])
                if n2 == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
                if n2 < 0 { err(ctx, "x64 native v0: negative shift count not supported"); return nil }
                var sh = core.int_mod(n2, 64)
                if op == "<<" { bytes_extend(ctx["code"], insn_shl_r64_imm8(0, sh)) }
                else { bytes_extend(ctx["code"], insn_shr_r64_imm8(0, sh)) }
                return nil
