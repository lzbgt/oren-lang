fn insn_and_r64_r64(dst, src) { return core.insn_and_r64_r64(dst, src) }
fn insn_or_r64_r64(dst, src) { return core.insn_or_r64_r64(dst, src) }
fn insn_xor_r64_r64(dst, src) { return core.insn_xor_r64_r64(dst, src) }
fn insn_shl_r64_imm8(reg, imm8) { return core.insn_shl_r64_imm8(reg, imm8) }
fn insn_shr_r64_imm8(reg, imm8) { return core.insn_shr_r64_imm8(reg, imm8) }
