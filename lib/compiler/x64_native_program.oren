            // - for compare operand: reuse cmp lowering and setcc based on "false"
            // - otherwise: compare operand to 0 and set if equal
            if _cond_is_cmp_infix(r) != nil {
                _emit_cmp_from_cond(ctx, r, locals)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
                bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
                var cc0 = _cond_false_cc(r["op"])
                if cc0 == nil { err(ctx, "x64 native v0: unsupported compare op for !"); return nil }
                bytes_extend(ctx["code"], insn_setcc_al(cc0))
                bytes_extend(ctx["code"], insn_cdqe())
