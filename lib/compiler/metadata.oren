import token "token.oren"

fn escape_json_string(s) {
    // Minimal JSON escaping for strings we emit in metadata.
    // Keep it deterministic and avoid allocations beyond concatenation.
    var out = ""
    var i = 0
    var len = oren_string_len(s)
    while i < len {
        var ch = oren_string_char_at(s, i)
        if ch == token.CH_QUOTE {
            out = out + "\\" + token.CH_QUOTE
        } else {
            if ch == "\\" {
                out = out + "\\\\"
            } else {
                if ch == "\n" {
                    out = out + "\\n"
                } else {
                    if ch == "\r" {
                        out = out + "\\r"
                    } else {
                        if ch == "\t" {
                            out = out + "\\t"
                        } else {
                            out = out + ch
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

fn json_string(s) {
    if s == nil { return "null" }
    return "\"" + escape_json_string(s) + "\""
}

fn json_attr_value(val) {
    if val == nil { return "null" }
    var t = val["type"]
    if t == "String" { return json_string(val["value"]) }
    if t == "Integer" { return val["value"] }
    if t == "Float" { return val["value"] }
    if t == "Boolean" {
        if val["value"] == true { return "true" }
        return "false"
    }
    if t == "Nil" { return "null" }
    return "null"
}

fn json_attr_args(args) {
    if args == nil { return "[]" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(args) {
        var a = args[i]
        if !first { out = out + ", " }
        out = out + "{"
        out = out + "\"key\": " + json_string(a["key"]) + ", "
        out = out + "\"value\": " + json_attr_value(a["value"])
        out = out + "}"
        first = false
        i = i + 1
    }
    out = out + "]"
    return out
}

fn json_attrs(attrs) {
    if attrs == nil { return "[]" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if !first { out = out + ", " }
        out = out + "{"
        out = out + "\"name\": " + json_string(a["name"]) + ", "
        out = out + "\"args\": " + json_attr_args(a["args"])
        out = out + "}"
        first = false
        i = i + 1
    }
    out = out + "]"
    return out
}

fn json_named_node(node) {
    if node == nil { return "{ \"name\": null, \"attrs\": [] }" }
    var name = node["value"]
    var attrs = node["attrs"]
    return "{ \"name\": " + json_string(name) + ", \"attrs\": " + json_attrs(attrs) + " }"
}

fn json_named_list(nodes) {
    if nodes == nil { return "[]" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(nodes) {
        if !first { out = out + ", " }
        out = out + json_named_node(nodes[i])
        first = false
        i = i + 1
    }
    out = out + "]"
    return out
}

fn json_string_list(nodes) {
    if nodes == nil { return "[]" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(nodes) {
        if !first { out = out + ", " }
        out = out + json_string(nodes[i]["value"])
        first = false
        i = i + 1
    }
    out = out + "]"
    return out
}

fn to_json(val) {
    // Deprecated placeholder: keep for compatibility with older comments.
    return ""
}

fn generate_metadata(prog) {
    var json = "{\n"
    json = json + "  \"functions\": [\n"
    
    var stmts = prog["statements"]
    var i = 0
    var first = true
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        var func = nil
        if s["type"] == "Function" {
            func = s
        }
        if s["type"] == "ExprStmt" {
            if s["expr"]["type"] == "Function" {
                func = s["expr"]
            }
        }
        
        if func != nil {
            if !first { json = json + ",\n" }
            json = json + "    {\n"
            json = json + "      \"name\": " + json_string(func["name"]) + ",\n"

            // Backwards-compatible: keep the old `args` list (just names).
            var params = func["params"]
            json = json + "      \"args\": " + json_string_list(params) + ",\n"

            // New: rich params and function-level attrs.
            json = json + "      \"params\": " + json_named_list(params) + ",\n"
            json = json + "      \"attrs\": " + json_attrs(func["attrs"]) + ",\n"
            json = json + "      \"doc\": " + json_string(func["doc"]) + "\n"
            json = json + "    }"
            first = false
        }
        i = i + 1
    }
    json = json + "\n  ],\n"
    
    // Trait declarations (rolling, metadata-only for now).
    // Backends ignore these until a stabilized trait model is implemented.
    json = json + "  \"traits\": [\n"
    var traits = prog["traits"]
    i = 0
    first = true
    while traits != nil && i < oren_list_len(traits) {
        var t = traits[i]
        if t != nil {
            if !first { json = json + ",\n" }
            json = json + "    {\n"
            json = json + "      \"name\": " + json_string(t["name"]) + ",\n"
            json = json + "      \"doc\": " + json_string(t["doc"]) + ",\n"
            // Methods are recorded as a list of name + params (params reuse the Named/attr shape).
            json = json + "      \"methods\": [\n"
            var ms = t["methods"]
            var mi = 0
            var mfirst = true
            while ms != nil && mi < oren_list_len(ms) {
                var m = ms[mi]
                if m != nil {
                    if !mfirst { json = json + ",\n" }
                    json = json + "        { \"name\": " + json_string(m["name"]) + ", \"params\": " + json_named_list(m["params"])
                    if m["ret_ann_type"] != nil {
                        json = json + ", \"ret_ann_type\": " + json_string(m["ret_ann_type"])
                    }
                    json = json + " }"
                    mfirst = false
                }
                mi = mi + 1
            }
            json = json + "\n      ]\n"
            json = json + "    }"
            first = false
        }
        i = i + 1
    }
    json = json + "\n  ],\n"

    json = json + "  \"structs\": [\n"
    i = 0
    first = true
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        if s["type"] == "Type" {
            if !first { json = json + ",\n" }
            json = json + "    {\n"
            json = json + "      \"name\": " + json_string(s["name"]["value"]) + ",\n"
            json = json + "      \"attrs\": " + json_attrs(s["attrs"]) + ",\n"
            json = json + "      \"doc\": " + json_string(s["doc"]) + ",\n"

            // Backwards-compatible: keep a flat list of names.
            var fields = s["fields"]
            json = json + "      \"field_names\": " + json_string_list(fields) + ",\n"

            // New: rich field list including attrs.
            json = json + "      \"fields\": " + json_named_list(fields) + "\n"
            json = json + "    }"
            first = false
        }
        i = i + 1
    }
    json = json + "\n  ]\n"
    
    json = json + "}\n"
    return json
}
