            out = out + "\"kind\": " + json_string(x["kind"])
            if x["after_yield_site"] != nil {
                out = out + ", \"after_yield_site\": " + json_string(x["after_yield_site"])
            }
            out = out + " }"
            first = false
        }
        i = i + 1
    }
    out = out + "]"
    return out
}

