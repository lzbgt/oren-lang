fn ascii_upper(s) {
    if s == nil { return s }
    var out = ""
    var lower = "abcdefghijklmnopqrstuvwxyz"
    var upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        var j = 0
        var mapped = nil
        while j < oren_string_len(lower) {
            if oren_string_char_at(lower, j) == ch {
                mapped = oren_string_char_at(upper, j)
                j = oren_string_len(lower)
            } else {
                j = j + 1
            }
        }
        if mapped != nil { out = out + mapped } else { out = out + ch }
        i = i + 1
    }
    return out
}

fn string_list_has(xs, value) {
    if xs == nil { return false }
    var i = 0
    while i < oren_list_len(xs) {
        if xs[i] == value { return true }
        i = i + 1
    }
    return false
}

fn normalize_domain_list(xs) {
    var out = []
    if xs == nil { return out }
    var i = 0
    while i < oren_list_len(xs) {
        var d = ascii_upper(xs[i])
        if d != nil && d != "" && !string_list_has(out, d) {
            oren_list_push(out, d)
        }
        i = i + 1
    }
    return out
}

fn string_list_missing(required, actual) {
    var out = []
    if required == nil { return out }
    var i = 0
    while i < oren_list_len(required) {
        var d = required[i]
        if d != nil && d != "" && !string_list_has(actual, d) && !string_list_has(out, d) {
            oren_list_push(out, d)
        }
        i = i + 1
    }
    return out
}

fn metadata_stmt_function(s) {
    if s == nil { return nil }
    if s["type"] == "Function" { return s }
    if s["type"] == "ExprStmt" {
        var e = s["expr"]
        if e != nil && e["type"] == "Function" { return e }
    }
    return nil
}

fn metadata_stmt_attrs(s) {
    if s == nil { return nil }
    var func = metadata_stmt_function(s)
    if func != nil { return func["attrs"] }
    if s["type"] == "Type" || s["type"] == "Import" || s["type"] == "FFI" {
        return s["attrs"]
    }
    if s["type"] == "Var" {
        if s["name"] != nil && s["name"]["type"] == "Identifier" {
            return s["name"]["attrs"]
        }
        return s["attrs"]
    }
    return s["attrs"]
}

fn package_attr_for_stmts(stmts) {
    if stmts == nil { return nil }
    var i = 0
    while i < oren_list_len(stmts) {
        var a = attr_find(metadata_stmt_attrs(stmts[i]), "oren.package")
        if a != nil { return a }
        i = i + 1
    }
    return nil
}

fn package_attr_cap_allow_domains(a) {
    if a == nil { return [] }
    var domains = attr_kw_string(a, "cap_allow_domains")
    var raw = split_csv_ws(domains)
    return normalize_domain_list(raw)
}

fn package_cap_allow_domains(stmts) {
    return package_attr_cap_allow_domains(package_attr_for_stmts(stmts))
}

fn json_package_budgets(a) {
    var declared = false
    var out = "{ \"version\": 1, \"declared\": "
    var tail = ""
    var keys = ["cpu_ms", "wall_ms", "heap_bytes", "gas"]
    var i = 0
    while i < oren_list_len(keys) {
        var key = keys[i]
        var v = attr_kw_value(a, "budget_" + key)
        if v != nil {
            declared = true
            tail = tail + ", \"" + key + "\": " + json_attr_value(v)
        }
        i = i + 1
    }
    if declared { out = out + "true" } else { out = out + "false" }
    out = out + tail + " }"
    return out
}

fn json_package_manifest(stmts) {
    var a = package_attr_for_stmts(stmts)
    var out = "{\n"
    out = out + "    \"version\": 1,\n"
    if a == nil {
        out = out + "    \"declared\": false,\n"
        out = out + "    \"runtime_profile\": null,\n"
        out = out + "    \"cap_allow_domains\": [],\n"
        out = out + "    \"source_required_domains\": " + json_string_array(cap_required_domains(stmts)) + ",\n"
        out = out + "    \"dependency_domain_union\": " + json_string_array(cap_required_domains(stmts)) + ",\n"
        out = out + "    \"dependency_domain_union_status\": \"source_attrs_only\",\n"
        out = out + "    \"budgets\": { \"version\": 1, \"declared\": false }\n"
        out = out + "  }"
        return out
    }
    out = out + "    \"declared\": true,\n"
    out = out + "    \"runtime_profile\": " + json_string(attr_kw_string(a, "runtime_profile")) + ",\n"
    out = out + "    \"cap_allow_domains\": " + json_string_array(package_cap_allow_domains(stmts)) + ",\n"
    out = out + "    \"source_required_domains\": " + json_string_array(cap_required_domains(stmts)) + ",\n"
    out = out + "    \"dependency_domain_union\": " + json_string_array(cap_required_domains(stmts)) + ",\n"
    out = out + "    \"dependency_domain_union_status\": \"source_attrs_only\",\n"
    out = out + "    \"budgets\": " + json_package_budgets(a) + "\n"
    out = out + "  }"
    return out
}

fn package_budget_declared(a) {
    if a == nil { return false }
    var keys = ["cpu_ms", "wall_ms", "heap_bytes", "gas"]
    var i = 0
    while i < oren_list_len(keys) {
        if attr_kw_value(a, "budget_" + keys[i]) != nil { return true }
        i = i + 1
    }
    return false
}

fn package_policy_check_status_for_attr(a, actual_runtime_profile, actual_cap_allow_domains) {
    var actual_profile = actual_runtime_profile
    if actual_profile == nil || actual_profile == "" { actual_profile = "none" }
    var actual_domains = normalize_domain_list(actual_cap_allow_domains)

    if a == nil { return "not_declared" }

    var declared_profile = attr_kw_string(a, "runtime_profile")
    var runtime_status = "not_declared"
    if declared_profile != nil && declared_profile != "" {
        if actual_profile == "none" {
            runtime_status = "backend_not_runtime_profiled"
        } else {
            if declared_profile == actual_profile { runtime_status = "match" } else { runtime_status = "mismatch" }
        }
    }

    var declared_domains = package_attr_cap_allow_domains(a)
    var missing = string_list_missing(declared_domains, actual_domains)
    var cap_status = "not_declared"
    if oren_list_len(declared_domains) > 0 {
        if oren_list_len(missing) == 0 { cap_status = "covers" } else { cap_status = "missing" }
    }

    var status = "observe_only"
    if runtime_status == "mismatch" || runtime_status == "backend_not_runtime_profiled" || cap_status == "missing" { status = "mismatch_observed" }
    return status
}

fn package_policy_check_status(stmts, actual_runtime_profile, actual_cap_allow_domains) {
    return package_policy_check_status_for_attr(package_attr_for_stmts(stmts), actual_runtime_profile, actual_cap_allow_domains)
}

fn json_package_policy_check(stmts, actual_runtime_profile, actual_cap_allow_domains) {
    var a = package_attr_for_stmts(stmts)
    var actual_profile = actual_runtime_profile
    if actual_profile == nil || actual_profile == "" { actual_profile = "none" }
    var actual_domains = normalize_domain_list(actual_cap_allow_domains)
    var declared = a != nil

    if !declared {
        return "{ \"version\": 1, \"declared\": false, \"status\": \"not_declared\", " +
            "\"runtime_profile\": { \"declared\": null, \"actual\": " + json_string(actual_profile) + ", \"status\": \"not_declared\" }, " +
            "\"cap_allow_domains\": { \"declared\": [], \"actual\": " + json_string_array(actual_domains) + ", \"missing\": [], \"status\": \"not_declared\" }, " +
            "\"budget_status\": \"not_declared\" }"
    }

    var declared_profile = attr_kw_string(a, "runtime_profile")
    var runtime_status = "not_declared"
    if declared_profile != nil && declared_profile != "" {
        if actual_profile == "none" {
            runtime_status = "backend_not_runtime_profiled"
        } else {
            if declared_profile == actual_profile { runtime_status = "match" } else { runtime_status = "mismatch" }
        }
    }

    var declared_domains = package_attr_cap_allow_domains(a)
    var missing = string_list_missing(declared_domains, actual_domains)
    var cap_status = "not_declared"
    if oren_list_len(declared_domains) > 0 {
        if oren_list_len(missing) == 0 { cap_status = "covers" } else { cap_status = "missing" }
    }

    var budget_status = "not_declared"
    if package_budget_declared(a) { budget_status = "declared_not_enforced" }

    var status = package_policy_check_status_for_attr(a, actual_profile, actual_domains)

    return "{ \"version\": 1, \"declared\": " + json_bool(declared) + ", \"status\": " + json_string(status) + ", " +
        "\"runtime_profile\": { \"declared\": " + json_string(declared_profile) + ", \"actual\": " + json_string(actual_profile) + ", \"status\": " + json_string(runtime_status) + " }, " +
        "\"cap_allow_domains\": { \"declared\": " + json_string_array(declared_domains) + ", \"actual\": " + json_string_array(actual_domains) + ", \"missing\": " + json_string_array(missing) + ", \"status\": " + json_string(cap_status) + " }, " +
        "\"budget_status\": " + json_string(budget_status) + " }"
}

fn cap_attr_domain(a) {
    if a == nil { return nil }
    if a["name"] != "cap.requires" { return nil }
    var d = attr_kw_string(a, "domain")
    if d == nil || d == "" { return nil }
    return ascii_upper(d)
}

fn cap_domains_for_attrs(attrs) {
    var out = []
    if attrs == nil { return out }
    var i = 0
    while i < oren_list_len(attrs) {
        var d = cap_attr_domain(attrs[i])
        if d != nil && d != "" && !string_list_has(out, d) {
            oren_list_push(out, d)
        }
        i = i + 1
    }
    return out
}

fn cap_required_domains(stmts) {
    var out = []
    if stmts == nil { return out }
    var i = 0
    while i < oren_list_len(stmts) {
        var func = metadata_stmt_function(stmts[i])
        if func != nil {
            var domains = cap_domains_for_attrs(func["attrs"])
            var j = 0
            while j < oren_list_len(domains) {
                var d = domains[j]
                if d != nil && d != "" && !string_list_has(out, d) {
                    oren_list_push(out, d)
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return out
}

fn json_capability_functions(stmts) {
    var out = "["
    if stmts == nil {
        out = out + "]"
        return out
    }
    var first = true
    var i = 0
    while i < oren_list_len(stmts) {
        var func = metadata_stmt_function(stmts[i])
        if func != nil {
            var domains = cap_domains_for_attrs(func["attrs"])
            if oren_list_len(domains) > 0 {
                if !first { out = out + ", " }
                out = out + "{ \"name\": " + json_string(func["name"]) + ", \"domains\": " + json_string_array(domains) + " }"
                first = false
            }
        }
        i = i + 1
    }
    out = out + "]"
    return out
}

fn json_capability_manifest(stmts) {
    var out = "{\n"
    out = out + "    \"version\": 1,\n"
    out = out + "    \"required_domains\": " + json_string_array(cap_required_domains(stmts)) + ",\n"
    out = out + "    \"functions\": " + json_capability_functions(stmts) + "\n"
    out = out + "  }"
    return out
}

fn serde_struct_formats(attrs) {
    // Returns a list of format strings (e.g. ["json","yaml"]) or nil if absent.
    var b = attr_find(attrs, "serde")
    if b != nil {
        var fmts = attr_kw_string(b, "formats")
        if fmts != nil {
            var parts = split_csv_ws(fmts)
            if parts != nil && oren_list_len(parts) > 0 { return parts }
        }
    }
    // For single-format opt-ins, keep this nil (schema already has `format`).
    return nil
}

fn serde_struct_format(attrs) {
    // Returns "json" / other format string, or nil if no opt-in requested.
    //
    // Canonical opt-in (preferred):
    //   @serde(format="json")
    //   @serde("json")
    //
    // Rolling back-compat:
    //   @serde.derive("json") / @serde.derive() (defaults to json)
    //   @serde(derive="json") / @serde(derive=true)
    var fmts0 = serde_struct_formats(attrs)
    if fmts0 != nil && oren_list_len(fmts0) > 0 {
        return fmts0[0]
    }
    var a = attr_find(attrs, "serde.derive")
    if a != nil {
        var v = attr_arg0_value(a)
        if v != nil && v["type"] == "String" { return v["value"] }
        // Empty derive defaults to json in v0.
        return "json"
    }
    var b = attr_find(attrs, "serde")
    if b != nil {
        var fmt = attr_kw_string(b, "format")
        if fmt != nil { return fmt }
        var p0 = attr_arg0_value(b)
        if p0 != nil && p0["type"] == "String" { return p0["value"] }
        var s2 = attr_kw_string(b, "derive")
        if s2 != nil { return s2 }
        var bv = attr_kw_bool(b, "derive")
        if bv == true { return "json" }
    }
    return nil
}

fn serde_struct_tag(attrs) {
    var a = attr_find(attrs, "serde.tag")
    if a != nil {
        var v = attr_arg0_value(a)
        if v != nil && v["type"] == "String" { return v["value"] }
    }
    var b = attr_find(attrs, "serde")
    if b != nil {
        var t = attr_kw_string(b, "tag")
        if t != nil { return t }
    }
    return nil
}

fn serde_field_rename(field) {
    var attrs = field["attrs"]
    var a = attr_find(attrs, "serde.rename")
    if a != nil {
        var v = attr_arg0_value(a)
        if v != nil && v["type"] == "String" { return v["value"] }
    }
    var b = attr_find(attrs, "serde")
    if b != nil {
        var s = attr_kw_string(b, "rename")
        if s != nil { return s }
    }
    return nil
}

fn serde_field_skip(field) {
    var attrs = field["attrs"]
    if attr_find(attrs, "serde.skip") != nil { return true }
    var b = attr_find(attrs, "serde")
    if b != nil {
        var sv = attr_kw_bool(b, "skip")
        if sv == true { return true }
    }
    return false
}

fn serde_field_default(field) {
    var attrs = field["attrs"]
    var a = attr_find(attrs, "serde.default")
    if a != nil { return attr_arg0_value(a) }
    var b = attr_find(attrs, "serde")
    if b != nil {
        return attr_kw_value(b, "default")
    }
    return nil
}

fn json_serde_schema_for_struct(type_stmt) {
    var attrs = type_stmt["attrs"]
    var fields = type_stmt["fields"]
    if attrs == nil && fields == nil { return "null" }

    // Emit schema only if the struct mentions serde anywhere (struct-level or field-level).
    var has = false
    if attr_any_has_prefix(attrs, "serde") { has = true }
    var i = 0
    while !has && fields != nil && i < oren_list_len(fields) {
        var f = fields[i]
        if f != nil && attr_any_has_prefix(f["attrs"], "serde") { has = true }
        i = i + 1
    }
    if !has { return "null" }

    var out = "{"
    out = out + "\"version\": 1, "
    out = out + "\"format\": " + json_string(serde_struct_format(attrs)) + ", "
    out = out + "\"tag\": " + json_string(serde_struct_tag(attrs)) + ", "
    out = out + "\"formats\": " + json_string_array(serde_struct_formats(attrs)) + ", "
    out = out + "\"fields\": ["

    i = 0
    var first = true
    while fields != nil && i < oren_list_len(fields) {
        var f2 = fields[i]
        if f2 != nil {
            if !first { out = out + ", " }
            var name = f2["value"]
            var ann = f2["ann_type"]
            var rename = serde_field_rename(f2)
            var wire = name
            if rename != nil { wire = rename }
            var skip = serde_field_skip(f2)
            var dflt = serde_field_default(f2)
            var skip_js = "false"
            if skip { skip_js = "true" }

            out = out + "{"
            out = out + "\"name\": " + json_string(name) + ", "
            out = out + "\"ann_type\": " + json_string(ann) + ", "
            out = out + "\"wire\": " + json_string(wire) + ", "
            out = out + "\"skip\": " + skip_js + ", "
            out = out + "\"default\": " + json_attr_value(dflt)
            out = out + "}"
            first = false
        }
        i = i + 1
    }
    out = out + "]"
    out = out + "}"
    return out
}

fn generate_metadata(prog) {
    var trace_meta_funcs = oren_env("OREN_TRACE_METADATA_FUNCTIONS") != nil
    var stmts = prog["statements"]
    var parts = ["{\n", "  \"functions\": [\n"]
    var i = 0
    var first = true
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        var entry = analysis.top_level_function_surface_entry(s)
        if entry != nil {
            if is_hidden_generator_helper_name(entry["name"]) == true {
                i = i + 1
                continue
            }
            var func = entry["func"]
            if trace_meta_funcs {
                print("[trace] metadata function start " + entry["name"])
            }
            var yield_info = analysis.function_yield_info(func)
            if trace_meta_funcs {
                print("[trace] metadata function done " + entry["name"])
            }
            if !first { oren_list_push(parts, ",\n") }
            var func_parts = ["    {\n"]
            oren_list_push(func_parts, "      \"name\": " + json_string(entry["name"]) + ",\n")

            // Backwards-compatible: keep the old `args` list (just names).
            var params = func["params"]
            oren_list_push(func_parts, "      \"args\": " + json_string_list(params) + ",\n")

            // New: rich params and function-level attrs.
            oren_list_push(func_parts, "      \"params\": " + json_named_list(params) + ",\n")
            oren_list_push(func_parts, "      \"attrs\": " + json_attrs(func["attrs"]) + ",\n")
            oren_list_push(func_parts, "      \"doc\": " + json_string(func["doc"]) + ",\n")
            oren_list_push(func_parts, "      \"contains_yield\": " + json_bool(yield_info["contains_yield"]) + ",\n")
            oren_list_push(func_parts, "      \"yield_stmt_count\": " + oren_int_to_string(yield_info["yield_stmt_count"]) + ",\n")
            oren_list_push(func_parts, "      \"yield_stmt_sites\": " + json_string_array(yield_info["yield_stmt_sites"]) + ",\n")
            oren_list_push(func_parts, "      \"contains_yield_value\": " + json_bool(yield_info["contains_yield_value"]) + ",\n")
            oren_list_push(func_parts, "      \"yield_value_count\": " + oren_int_to_string(yield_info["yield_value_count"]) + ",\n")
            oren_list_push(func_parts, "      \"yield_value_sites\": " + json_string_array(yield_info["yield_value_sites"]) + ",\n")
            oren_list_push(func_parts, "      \"yield_value_surface\": " + json_yield_value_surface(yield_info["yield_value_surface"]) + ",\n")
            oren_list_push(func_parts, "      \"contains_yield_exchange\": " + json_bool(yield_info["contains_yield_exchange"]) + ",\n")
            oren_list_push(func_parts, "      \"yield_exchange_count\": " + oren_int_to_string(yield_info["yield_exchange_count"]) + ",\n")
            oren_list_push(func_parts, "      \"yield_exchange_sites\": " + json_string_array(yield_info["yield_exchange_sites"]) + ",\n")
            oren_list_push(func_parts, "      \"yield_exchange_surface\": " + json_yield_exchange_surface(yield_info["yield_exchange_surface"]) + ",\n")
            oren_list_push(func_parts, "      \"contains_generator_finalize\": " + json_bool(yield_info["contains_generator_finalize"]) + ",\n")
            oren_list_push(func_parts, "      \"generator_finalize_count\": " + oren_int_to_string(yield_info["generator_finalize_count"]) + ",\n")
            oren_list_push(func_parts, "      \"generator_finalize_sites\": " + json_string_array(yield_info["generator_finalize_sites"]) + ",\n")
            oren_list_push(func_parts, "      \"generator_finalize_surface\": " + json_generator_finalize_surface(yield_info["generator_finalize_surface"]) + ",\n")
            oren_list_push(func_parts, "      \"is_generator_decl\": " + json_bool(yield_info["is_generator_decl"]) + ",\n")
            oren_list_push(func_parts, "      \"generator_decl_surface\": " + json_generator_decl_surface(yield_info["generator_decl_surface"]) + ",\n")
            oren_list_push(func_parts, "      \"yield_lowering\": " + json_yield_lowering(yield_info["yield_lowering"]) + "\n")
            oren_list_push(func_parts, "    }")
            oren_list_push(parts, oren_string_join(func_parts))
            first = false
        }
        i = i + 1
    }
    oren_list_push(parts, "\n  ],\n")

    // Normalized package/capability manifests for source-level tooling.
    // Raw attrs remain on declarations; these views are the stable contract surface.
    oren_list_push(parts, "  \"package\": " + json_package_manifest(stmts) + ",\n")
    oren_list_push(parts, "  \"capabilities\": " + json_capability_manifest(stmts) + ",\n")

    // Trait declarations (rolling, metadata-only for now).
    // Backends ignore these until a stabilized trait model is implemented.
    oren_list_push(parts, "  \"traits\": [\n")
    var traits = prog["traits"]
    i = 0
    first = true
    while traits != nil && i < oren_list_len(traits) {
        var t = traits[i]
        if t != nil {
            if !first { oren_list_push(parts, ",\n") }
            var trait_parts = ["    {\n"]
            oren_list_push(trait_parts, "      \"name\": " + json_string(t["name"]) + ",\n")
            oren_list_push(trait_parts, "      \"doc\": " + json_string(t["doc"]) + ",\n")
            // Methods are recorded as a list of name + params (params reuse the Named/attr shape).
            oren_list_push(trait_parts, "      \"methods\": [\n")
            var ms = t["methods"]
            var mi = 0
            var mfirst = true
            var method_parts = []
            while ms != nil && mi < oren_list_len(ms) {
                var m = ms[mi]
                if m != nil {
                    if !mfirst { oren_list_push(method_parts, ",\n") }
                    var method_json = "        { \"name\": " + json_string(m["name"]) + ", \"params\": " + json_named_list(m["params"])
                    if m["ret_ann_type"] != nil {
                        method_json = method_json + ", \"ret_ann_type\": " + json_string(m["ret_ann_type"])
                    }
                    method_json = method_json + " }"
                    oren_list_push(method_parts, method_json)
                    mfirst = false
                }
                mi = mi + 1
            }
            oren_list_push(trait_parts, oren_string_join(method_parts))
            oren_list_push(trait_parts, "\n      ]\n")
            oren_list_push(trait_parts, "    }")
            oren_list_push(parts, oren_string_join(trait_parts))
            first = false
        }
        i = i + 1
    }
    oren_list_push(parts, "\n  ],\n")

    // Global vars (rolling, metadata-only).
    //
    // Notes:
    // - Locals are intentionally not included in v0 metadata (keeps meta stable and
    //   avoids coupling to statement-level lowering details).
    // - We include attrs on the identifier node (consistent with params/fields).
    oren_list_push(parts, "  \"globals\": [\n")
    i = 0
    first = true
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        if s != nil && s["type"] == "Var" {
            if !first { oren_list_push(parts, ",\n") }
            var nm = nil
            var ann = nil
            var attrs = nil
            if s["name"] != nil && s["name"]["type"] == "Identifier" {
                nm = s["name"]["value"]
                ann = s["name"]["ann_type"]
                attrs = s["name"]["attrs"]
            }
            var global_parts = ["    {"]
            oren_list_push(global_parts, "\"name\": " + json_string(nm) + ", ")
            oren_list_push(global_parts, "\"ann_type\": " + json_string(ann) + ", ")
            oren_list_push(global_parts, "\"attrs\": " + json_attrs(attrs))
            oren_list_push(global_parts, "}")
            oren_list_push(parts, oren_string_join(global_parts))
            first = false
        }
        i = i + 1
    }
    oren_list_push(parts, "\n  ],\n")

    oren_list_push(parts, "  \"structs\": [\n")
    i = 0
    first = true
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        if s["type"] == "Type" {
            if !first { oren_list_push(parts, ",\n") }
            var struct_parts = ["    {\n"]
            oren_list_push(struct_parts, "      \"name\": " + json_string(s["name"]["value"]) + ",\n")
            oren_list_push(struct_parts, "      \"attrs\": " + json_attrs(s["attrs"]) + ",\n")
            oren_list_push(struct_parts, "      \"doc\": " + json_string(s["doc"]) + ",\n")

            // Backwards-compatible: keep a flat list of names.
            var fields = s["fields"]
            oren_list_push(struct_parts, "      \"field_names\": " + json_string_list(fields) + ",\n")

            // New: rich field list including attrs.
            oren_list_push(struct_parts, "      \"fields\": " + json_named_list(fields) + ",\n")

            // New (rolling): normalized serde schema so libraries can implement multi-format serdes
            // without depending on compiler internals.
            oren_list_push(struct_parts, "      \"serde\": " + json_serde_schema_for_struct(s) + "\n")
            oren_list_push(struct_parts, "    }")
            oren_list_push(parts, oren_string_join(struct_parts))
            first = false
        }
        i = i + 1
    }
    oren_list_push(parts, "\n  ]\n")
    oren_list_push(parts, "}\n")
    return oren_string_join(parts)
}
