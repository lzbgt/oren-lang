import token "token.oren"

fn str_starts_with(s, prefix) {
    if s == nil || prefix == nil { return false }
    var ls = oren_string_len(s)
    var lp = oren_string_len(prefix)
    if lp > ls { return false }
    return oren_string_slice(s, 0, lp) == prefix
}

fn escape_json_string(s) {
    // Minimal JSON escaping for strings we emit in metadata.
    // Keep it deterministic and avoid allocations beyond concatenation.
    var out = ""
    var i = 0
    var len = oren_string_len(s)
    while i < len {
        var ch = oren_string_char_at(s, i)
        if ch == token.CH_QUOTE {
            out = out + "\\" + token.CH_QUOTE
        } else {
            if ch == "\\" {
                out = out + "\\\\"
            } else {
                if ch == "\n" {
                    out = out + "\\n"
                } else {
                    if ch == "\r" {
                        out = out + "\\r"
                    } else {
                        if ch == "\t" {
                            out = out + "\\t"
                        } else {
                            out = out + ch
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

fn json_string(s) {
    if s == nil { return "null" }
    return "\"" + escape_json_string(s) + "\""
}

fn json_attr_value(val) {
    if val == nil { return "null" }
    var t = val["type"]
    if t == "String" { return json_string(val["value"]) }
    if t == "Integer" { return val["value"] }
    if t == "Float" { return val["value"] }
    if t == "Boolean" {
        if val["value"] == true { return "true" }
        return "false"
    }
    if t == "Nil" { return "null" }
    return "null"
}

fn json_attr_args(args) {
    if args == nil { return "[]" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(args) {
        var a = args[i]
        if !first { out = out + ", " }
        out = out + "{"
        out = out + "\"key\": " + json_string(a["key"]) + ", "
        out = out + "\"value\": " + json_attr_value(a["value"])
        out = out + "}"
        first = false
        i = i + 1
    }
    out = out + "]"
    return out
}

fn json_attrs(attrs) {
    if attrs == nil { return "[]" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if !first { out = out + ", " }
        out = out + "{"
        out = out + "\"name\": " + json_string(a["name"]) + ", "
        out = out + "\"args\": " + json_attr_args(a["args"])
        out = out + "}"
        first = false
        i = i + 1
    }
    out = out + "]"
    return out
}

fn json_named_node(node) {
    if node == nil { return "{ \"name\": null, \"attrs\": [] }" }
    var name = node["value"]
    var attrs = node["attrs"]
    return "{ \"name\": " + json_string(name) + ", \"attrs\": " + json_attrs(attrs) + " }"
}

fn json_named_list(nodes) {
    if nodes == nil { return "[]" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(nodes) {
        if !first { out = out + ", " }
        out = out + json_named_node(nodes[i])
        first = false
        i = i + 1
    }
    out = out + "]"
    return out
}

fn json_string_list(nodes) {
    if nodes == nil { return "[]" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(nodes) {
        if !first { out = out + ", " }
        out = out + json_string(nodes[i]["value"])
        first = false
        i = i + 1
    }
    out = out + "]"
    return out
}

fn to_json(val) {
    // Deprecated placeholder: keep for compatibility with older comments.
    return ""
}

fn attr_find(attrs, name) {
    if attrs == nil { return nil }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["name"] == name { return a }
        i = i + 1
    }
    return nil
}

fn attr_any_has_prefix(attrs, prefix) {
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil {
            var n = a["name"]
            if n == prefix { return true }
            if prefix != nil && n != nil && str_starts_with(n, prefix + ".") { return true }
        }
        i = i + 1
    }
    return false
}

fn attr_arg0_value(a) {
    if a == nil { return nil }
    var args = a["args"]
    if args == nil { return nil }
    if oren_list_len(args) < 1 { return nil }
    var x = args[0]
    if x == nil { return nil }
    return x["value"]
}

fn attr_kw_value(a, key) {
    if a == nil { return nil }
    var args = a["args"]
    if args == nil { return nil }
    var i = 0
    while i < oren_list_len(args) {
        var x = args[i]
        if x != nil && x["key"] == key {
            return x["value"]
        }
        i = i + 1
    }
    return nil
}

fn attr_kw_string(a, key) {
    var v = attr_kw_value(a, key)
    if v == nil { return nil }
    if v["type"] == "String" { return v["value"] }
    return nil
}

fn attr_kw_bool(a, key) {
    var v = attr_kw_value(a, key)
    if v == nil { return nil }
    if v["type"] == "Boolean" { return v["value"] }
    return nil
}

fn split_csv_ws(s) {
    // Split a "formats" string like:
    //   "json,yaml,cbor"
    //   "json yaml"
    //   " json, yaml ,cbor "
    // into a list of non-empty tokens.
    //
    // Keep deterministic; avoid stdlib helpers from inside compiler libs.
    var out = []
    if s == nil { return out }
    var cur = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        var is_sep = (ch == ",") || (ch == " ") || (ch == "\t") || (ch == "\n") || (ch == "\r")
        if is_sep {
            if cur != "" { oren_list_push(out, cur) }
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    if cur != "" { oren_list_push(out, cur) }
    return out
}

fn json_string_array(xs) {
    if xs == nil { return "null" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(xs) {
        var s = xs[i]
        if s != nil && s != "" {
            if !first { out = out + ", " }
            out = out + json_string(s)
            first = false
        }
        i = i + 1
    }
    out = out + "]"
    return out
}

fn ascii_upper(s) {
    if s == nil { return s }
    var out = ""
    var lower = "abcdefghijklmnopqrstuvwxyz"
    var upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        var j = 0
        var mapped = nil
        while j < oren_string_len(lower) {
            if oren_string_char_at(lower, j) == ch {
                mapped = oren_string_char_at(upper, j)
                j = oren_string_len(lower)
            } else {
                j = j + 1
            }
        }
        if mapped != nil { out = out + mapped } else { out = out + ch }
        i = i + 1
    }
    return out
}

fn string_list_has(xs, value) {
    if xs == nil { return false }
    var i = 0
    while i < oren_list_len(xs) {
        if xs[i] == value { return true }
        i = i + 1
    }
    return false
}

fn metadata_stmt_function(s) {
    if s == nil { return nil }
    if s["type"] == "Function" { return s }
    if s["type"] == "ExprStmt" {
        var e = s["expr"]
        if e != nil && e["type"] == "Function" { return e }
    }
    return nil
}

fn cap_attr_domain(a) {
    if a == nil { return nil }
    if a["name"] != "cap.requires" { return nil }
    var d = attr_kw_string(a, "domain")
    if d == nil || d == "" { return nil }
    return ascii_upper(d)
}

fn cap_domains_for_attrs(attrs) {
    var out = []
    if attrs == nil { return out }
    var i = 0
    while i < oren_list_len(attrs) {
        var d = cap_attr_domain(attrs[i])
        if d != nil && d != "" && !string_list_has(out, d) {
            oren_list_push(out, d)
        }
        i = i + 1
    }
    return out
}

fn cap_required_domains(stmts) {
    var out = []
    if stmts == nil { return out }
    var i = 0
    while i < oren_list_len(stmts) {
        var func = metadata_stmt_function(stmts[i])
        if func != nil {
            var domains = cap_domains_for_attrs(func["attrs"])
            var j = 0
            while j < oren_list_len(domains) {
                var d = domains[j]
                if d != nil && d != "" && !string_list_has(out, d) {
                    oren_list_push(out, d)
                }
                j = j + 1
            }
        }
        i = i + 1
    }
    return out
}

fn json_capability_functions(stmts) {
    var out = "["
    if stmts == nil {
        out = out + "]"
        return out
    }
    var first = true
    var i = 0
    while i < oren_list_len(stmts) {
        var func = metadata_stmt_function(stmts[i])
        if func != nil {
            var domains = cap_domains_for_attrs(func["attrs"])
            if oren_list_len(domains) > 0 {
                if !first { out = out + ", " }
                out = out + "{ \"name\": " + json_string(func["name"]) + ", \"domains\": " + json_string_array(domains) + " }"
                first = false
            }
        }
        i = i + 1
    }
    out = out + "]"
    return out
}

fn json_capability_manifest(stmts) {
    var out = "{\n"
    out = out + "    \"version\": 1,\n"
    out = out + "    \"required_domains\": " + json_string_array(cap_required_domains(stmts)) + ",\n"
    out = out + "    \"functions\": " + json_capability_functions(stmts) + "\n"
    out = out + "  }"
    return out
}

fn serde_struct_formats(attrs) {
    // Returns a list of format strings (e.g. ["json","yaml"]) or nil if absent.
    var b = attr_find(attrs, "serde")
    if b != nil {
        var fmts = attr_kw_string(b, "formats")
        if fmts != nil {
            var parts = split_csv_ws(fmts)
            if parts != nil && oren_list_len(parts) > 0 { return parts }
        }
    }
    // For single-format opt-ins, keep this nil (schema already has `format`).
    return nil
}

fn serde_struct_format(attrs) {
    // Returns "json" / other format string, or nil if no opt-in requested.
    //
    // Canonical opt-in (preferred):
    //   @serde(format="json")
    //   @serde("json")
    //
    // Rolling back-compat:
    //   @serde.derive("json") / @serde.derive() (defaults to json)
    //   @serde(derive="json") / @serde(derive=true)
    var fmts0 = serde_struct_formats(attrs)
    if fmts0 != nil && oren_list_len(fmts0) > 0 {
        return fmts0[0]
    }
    var a = attr_find(attrs, "serde.derive")
    if a != nil {
        var v = attr_arg0_value(a)
        if v != nil && v["type"] == "String" { return v["value"] }
        // Empty derive defaults to json in v0.
        return "json"
    }
    var b = attr_find(attrs, "serde")
    if b != nil {
        var fmt = attr_kw_string(b, "format")
        if fmt != nil { return fmt }
        var p0 = attr_arg0_value(b)
        if p0 != nil && p0["type"] == "String" { return p0["value"] }
        var s2 = attr_kw_string(b, "derive")
        if s2 != nil { return s2 }
        var bv = attr_kw_bool(b, "derive")
        if bv == true { return "json" }
    }
    return nil
}

fn serde_struct_tag(attrs) {
    var a = attr_find(attrs, "serde.tag")
    if a != nil {
        var v = attr_arg0_value(a)
        if v != nil && v["type"] == "String" { return v["value"] }
    }
    var b = attr_find(attrs, "serde")
    if b != nil {
        var t = attr_kw_string(b, "tag")
        if t != nil { return t }
    }
    return nil
}

fn serde_field_rename(field) {
    var attrs = field["attrs"]
    var a = attr_find(attrs, "serde.rename")
    if a != nil {
        var v = attr_arg0_value(a)
        if v != nil && v["type"] == "String" { return v["value"] }
    }
    var b = attr_find(attrs, "serde")
    if b != nil {
        var s = attr_kw_string(b, "rename")
        if s != nil { return s }
    }
    return nil
}

fn serde_field_skip(field) {
    var attrs = field["attrs"]
    if attr_find(attrs, "serde.skip") != nil { return true }
    var b = attr_find(attrs, "serde")
    if b != nil {
        var sv = attr_kw_bool(b, "skip")
        if sv == true { return true }
    }
    return false
}

fn serde_field_default(field) {
    var attrs = field["attrs"]
    var a = attr_find(attrs, "serde.default")
    if a != nil { return attr_arg0_value(a) }
    var b = attr_find(attrs, "serde")
    if b != nil {
        return attr_kw_value(b, "default")
    }
    return nil
}

fn json_serde_schema_for_struct(type_stmt) {
    var attrs = type_stmt["attrs"]
    var fields = type_stmt["fields"]
    if attrs == nil && fields == nil { return "null" }

    // Emit schema only if the struct mentions serde anywhere (struct-level or field-level).
    var has = false
    if attr_any_has_prefix(attrs, "serde") { has = true }
    var i = 0
    while !has && fields != nil && i < oren_list_len(fields) {
        var f = fields[i]
        if f != nil && attr_any_has_prefix(f["attrs"], "serde") { has = true }
        i = i + 1
    }
    if !has { return "null" }

    var out = "{"
    out = out + "\"version\": 1, "
    out = out + "\"format\": " + json_string(serde_struct_format(attrs)) + ", "
    out = out + "\"tag\": " + json_string(serde_struct_tag(attrs)) + ", "
    out = out + "\"formats\": " + json_string_array(serde_struct_formats(attrs)) + ", "
    out = out + "\"fields\": ["

    i = 0
    var first = true
    while fields != nil && i < oren_list_len(fields) {
        var f2 = fields[i]
        if f2 != nil {
            if !first { out = out + ", " }
            var name = f2["value"]
            var ann = f2["ann_type"]
            var rename = serde_field_rename(f2)
            var wire = name
            if rename != nil { wire = rename }
            var skip = serde_field_skip(f2)
            var dflt = serde_field_default(f2)
            var skip_js = "false"
            if skip { skip_js = "true" }

            out = out + "{"
            out = out + "\"name\": " + json_string(name) + ", "
            out = out + "\"ann_type\": " + json_string(ann) + ", "
            out = out + "\"wire\": " + json_string(wire) + ", "
            out = out + "\"skip\": " + skip_js + ", "
            out = out + "\"default\": " + json_attr_value(dflt)
            out = out + "}"
            first = false
        }
        i = i + 1
    }
    out = out + "]"
    out = out + "}"
    return out
}

fn generate_metadata(prog) {
    var json = "{\n"
    json = json + "  \"functions\": [\n"
    
    var stmts = prog["statements"]
    var i = 0
    var first = true
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        var func = nil
        if s["type"] == "Function" {
            func = s
        }
        if s["type"] == "ExprStmt" {
            if s["expr"]["type"] == "Function" {
                func = s["expr"]
            }
        }
        
        if func != nil {
            if !first { json = json + ",\n" }
            json = json + "    {\n"
            json = json + "      \"name\": " + json_string(func["name"]) + ",\n"

            // Backwards-compatible: keep the old `args` list (just names).
            var params = func["params"]
            json = json + "      \"args\": " + json_string_list(params) + ",\n"

            // New: rich params and function-level attrs.
            json = json + "      \"params\": " + json_named_list(params) + ",\n"
            json = json + "      \"attrs\": " + json_attrs(func["attrs"]) + ",\n"
            json = json + "      \"doc\": " + json_string(func["doc"]) + "\n"
            json = json + "    }"
            first = false
        }
        i = i + 1
    }
    json = json + "\n  ],\n"

    // Normalized capability manifest for source-level tooling.
    // Raw attrs remain on functions; this view is the stable contract surface.
    json = json + "  \"capabilities\": " + json_capability_manifest(stmts) + ",\n"

    // Trait declarations (rolling, metadata-only for now).
    // Backends ignore these until a stabilized trait model is implemented.
    json = json + "  \"traits\": [\n"
    var traits = prog["traits"]
    i = 0
    first = true
    while traits != nil && i < oren_list_len(traits) {
        var t = traits[i]
        if t != nil {
            if !first { json = json + ",\n" }
            json = json + "    {\n"
            json = json + "      \"name\": " + json_string(t["name"]) + ",\n"
            json = json + "      \"doc\": " + json_string(t["doc"]) + ",\n"
            // Methods are recorded as a list of name + params (params reuse the Named/attr shape).
            json = json + "      \"methods\": [\n"
            var ms = t["methods"]
            var mi = 0
            var mfirst = true
            while ms != nil && mi < oren_list_len(ms) {
                var m = ms[mi]
                if m != nil {
                    if !mfirst { json = json + ",\n" }
                    json = json + "        { \"name\": " + json_string(m["name"]) + ", \"params\": " + json_named_list(m["params"])
                    if m["ret_ann_type"] != nil {
                        json = json + ", \"ret_ann_type\": " + json_string(m["ret_ann_type"])
                    }
                    json = json + " }"
                    mfirst = false
                }
                mi = mi + 1
            }
            json = json + "\n      ]\n"
            json = json + "    }"
            first = false
        }
        i = i + 1
    }
    json = json + "\n  ],\n"

    // Global vars (rolling, metadata-only).
    //
    // Notes:
    // - Locals are intentionally not included in v0 metadata (keeps meta stable and
    //   avoids coupling to statement-level lowering details).
    // - We include attrs on the identifier node (consistent with params/fields).
    json = json + "  \"globals\": [\n"
    i = 0
    first = true
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        if s != nil && s["type"] == "Var" {
            if !first { json = json + ",\n" }
            var nm = nil
            var ann = nil
            var attrs = nil
            if s["name"] != nil && s["name"]["type"] == "Identifier" {
                nm = s["name"]["value"]
                ann = s["name"]["ann_type"]
                attrs = s["name"]["attrs"]
            }
            json = json + "    {"
            json = json + "\"name\": " + json_string(nm) + ", "
            json = json + "\"ann_type\": " + json_string(ann) + ", "
            json = json + "\"attrs\": " + json_attrs(attrs)
            json = json + "}"
            first = false
        }
        i = i + 1
    }
    json = json + "\n  ],\n"

    json = json + "  \"structs\": [\n"
    i = 0
    first = true
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        if s["type"] == "Type" {
            if !first { json = json + ",\n" }
            json = json + "    {\n"
            json = json + "      \"name\": " + json_string(s["name"]["value"]) + ",\n"
            json = json + "      \"attrs\": " + json_attrs(s["attrs"]) + ",\n"
            json = json + "      \"doc\": " + json_string(s["doc"]) + ",\n"

            // Backwards-compatible: keep a flat list of names.
            var fields = s["fields"]
            json = json + "      \"field_names\": " + json_string_list(fields) + ",\n"

            // New: rich field list including attrs.
            json = json + "      \"fields\": " + json_named_list(fields) + ",\n"

            // New (rolling): normalized serde schema so libraries can implement multi-format serdes
            // without depending on compiler internals.
            json = json + "      \"serde\": " + json_serde_schema_for_struct(s) + "\n"
            json = json + "    }"
            first = false
        }
        i = i + 1
    }
    json = json + "\n  ]\n"
    
    json = json + "}\n"
    return json
}
