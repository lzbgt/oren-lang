        var ctx = codegen_bytecode.bytecode_compile_program(linked_bc)
        if ctx != nil && ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
            var first_err = ctx["errors"][0]
            emit_diag("codegen", 1, first_err)
            print("Bytecode codegen errors:")
            var ei = 0
            while ei < oren_list_len(ctx["errors"]) {
                print(ctx["errors"][ei])
                ei = ei + 1
            }
            oren_exit(1)
        }


        // Rolling: embed metadata into the `.obc` constant pool as a BYTES constant so:
        // - tooling can discover attrs/types/fields without a sidecar file
        // - execution semantics remain unchanged (metadata is not referenced by code)
        //
        // Format (rolling, v0):
        //   bytes = "OREN_META\n1\n" + <meta_json_utf8_bytes>
        var meta_json = metadata.generate_metadata(linked_bc)
        var hdr = oren_bytes_from_string("OREN_META\n1\n")
        var payload = oren_bytes_from_string(meta_json)
        var meta_bytes = []
        var hi = 0
        while hi < oren_list_len(hdr) {
            oren_list_push(meta_bytes, hdr[hi])
            hi = hi + 1
        }
        var pi = 0
        while pi < oren_list_len(payload) {
            oren_list_push(meta_bytes, payload[pi])
            pi = pi + 1
        }
        ctx["meta_bytes"] = meta_bytes

        var out_bytes = codegen_bytecode.bytecode_emit_program(out_path, ctx)
        print("Bytecode emitted: " + out_path)
        if deterministic { _emit_artifact_hash("bytecode", out_path, out_bytes) }
        if emit_manifest {
            var h = _sha256_hex(out_bytes)
            _write_artifact_manifest("bytecode", out_path, h, target, arch, deterministic, oren_list_len(out_bytes))
        }
        return nil
    }

    if backend == "native" {
        if emit_c {
            emit_diag("compile", 2, "--emit-c is only supported with --backend c")
            print("--emit-c is only supported with --backend c")
            oren_exit(2)
        }

        var linked = link_program(path, prog, {"target": target, "arch": arch, "typecheck": do_typecheck})
        var export_names = []
        
        if is_shared_lib {
            var header_path = default_output_path(out_path) + ".h"
            var h_content = "#ifndef OREN_LIB_H\n#define OREN_LIB_H\n\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
            var stmts = linked["statements"]
            var si = 0
            while si < oren_list_len(stmts) {
                var s = stmts[si]
                var fn_node = nil
                
                if s["type"] == "Function" {
                    fn_node = s
                }
                if s["type"] == "ExprStmt" {
                    var expr = s["expr"]
                    if expr != nil {
                        if expr["type"] == "Function" {
                            fn_node = expr
                        }
                    }
                }
                
                if fn_node != nil {
                    var fn_name = fn_node["name"]
                    // print("DEBUG: fn_name = " + fn_name)
                    if fn_name != nil {
                        if fn_name != "main" && fn_name != "__top_level__" {
                            oren_list_push(export_names, fn_name)
                            var params = fn_node["params"]
                            var p_count = oren_list_len(params)
                            h_content = h_content + "extern int64_t " + fn_name + "("
                            var pi = 0
                            while pi < p_count {
                                if pi > 0 { h_content = h_content + ", " }
                                h_content = h_content + "int64_t arg" + oren_int_to_string(pi)
                                pi = pi + 1
                            }
                            if p_count == 0 { h_content = h_content + "void" }
                            h_content = h_content + ");\n"
                        }
                    }
                }
                si = si + 1
            }
            h_content = h_content + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"
            var w = oren_write_file(header_path, h_content)
            if oren_is_err(w) {
                var emsgH = "Failed to write header: " + header_path
                var msg = oren_err_msg(w)
                if msg != nil { emsgH = emsgH + " (" + msg + ")" }
                emit_diag("compile", 2, emsgH)
                print("Failed to write header: " + header_path)
                if msg != nil { print(msg) }
                oren_exit(1)
            }
            print("Wrote header: " + header_path)
        }
        
        if emit_meta {
            var meta_json = metadata.generate_metadata(linked)
            var meta_path = out_path + ".meta.json"
            var w2 = oren_write_file(meta_path, meta_json)
            if oren_is_err(w2) {
                var emsgM = "Failed to write metadata: " + meta_path
                var msg2 = oren_err_msg(w2)
                if msg2 != nil { emsgM = emsgM + " (" + msg2 + ")" }
                emit_diag("compile", 2, emsgM)
                print("Failed to write metadata: " + meta_path)
                if msg2 != nil { print(msg2) }
                oren_exit(1)
            }
            print("Wrote metadata: " + meta_path)
            if deterministic || emit_manifest {
                var bsM = oren_read_bytes(meta_path)
                if oren_is_err(bsM) {
                    var emsgHM = "Failed to read artifact for hashing: " + meta_path
                    var msgHM = oren_err_msg(bsM)
                    if msgHM != nil { emsgHM = emsgHM + " (" + msgHM + ")" }
                    emit_diag("compile", 2, emsgHM)
                    print("Failed to read artifact for hashing: " + meta_path)
                    if msgHM != nil { print(msgHM) }
                    oren_exit(1)
                }
                if deterministic { _emit_artifact_hash("meta", meta_path, bsM) }
                if emit_manifest {
                    var h = _sha256_hex(bsM)
                    _write_artifact_manifest("meta", meta_path, h, target, arch, deterministic, oren_list_len(bsM))
                }
            }
        }

        if target == "linux" {
            arm64_elf.elf_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, CAPSULE, CAP_ALLOW_DOMAINS)
        } else {
            arm64_macho.macho_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, CAPSULE, CAP_ALLOW_DOMAINS)
        }

        if target == "macos" {
            if codesign_id != "" {
                var cs_cmd = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
                var cs_res = oren_system(cs_cmd)
                if cs_res != 0 {
                    print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                    var ad_cmd = "codesign -s - --force " + shell_quote(out_path)
                    var ad_res = oren_system(ad_cmd)
                    if ad_res != 0 {
                        print("codesign fallback failed")
                        oren_exit(1)
                    }
                }
            }
        }
        
        if deterministic || emit_manifest {
            var bs = oren_read_bytes(out_path)
            if oren_is_err(bs) {
                print("Failed to read artifact for hashing: " + out_path)
                var msgH = oren_err_msg(bs)
                if msgH != nil { print(msgH) }
                oren_exit(1)
            }
            if deterministic { _emit_artifact_hash("native", out_path, bs) }
            if emit_manifest {
                var h = _sha256_hex(bs)
                _write_artifact_manifest("native", out_path, h, target, arch, deterministic, oren_list_len(bs))
            }
        }

        print("Build successful: " + out_path)
        
        if disasm {
            if target == "macos" {
                oren_system("otool -tV " + shell_quote(out_path))
            } else {
                oren_system("objdump -d " + shell_quote(out_path))
            }
        }
        return nil
    }

    // For C backend, we also need to load modules to populate MODULE_ORDER.
    //
    // Note: some whole-program lowerings (like generic monomorphization) may generate
    // *new* function definitions during linking. The C transpiler consumes per-module
    // ASTs (MODULE_ORDER + prog), so we must sync generated functions back into those
    // unit programs before transpiling.
    var linked_c = link_program(path, prog, {"target": target, "arch": arch, "typecheck": do_typecheck})
    c_backend_sync_generated_functions(prog, MODULE_ORDER, linked_c)
    var c_code = transpiler.transpile_entry(path, prog, MODULE_ORDER, linked_c["aliases"])
    // IMPORTANT (rolling hygiene):
    // Do NOT write generated C next to sources. This breaks Makefile implicit rules
    // and pollutes the working tree (especially under parallel oretest runs).
    //
    // Emit the C file alongside the output binary instead.
    ensure_dir(dirname(out_path))
    var c_path = out_path + ".c"
    var w3 = oren_write_file(c_path, c_code)
    if oren_is_err(w3) {
        print("Failed to write C output: " + c_path)
        var msg3 = oren_err_msg(w3)
        if msg3 != nil { print(msg3) }
        oren_exit(1)
    }
    if emit_c {
        print("Wrote " + c_path)
        return nil
    }

    var cmd = cc + " -o " + shell_quote(out_path) + " " + shell_quote(c_path) + " lib/runtime.c lib/runtime_buf.c -Ilib -pthread"
    var k_lib = 0
    while k_lib < oren_list_len(link_libs) {
        cmd = cmd + " " + shell_quote(link_libs[k_lib])
        k_lib = k_lib + 1
    }
    if no_gc { cmd = cmd + " -DOREN_NO_GC" }
    if enable_python {
        cmd = cmd + " -DOREN_ENABLE_PYTHON $(python3-config --cflags) $(python3-config --embed --ldflags)"
    }
    var res = oren_system(cmd)
    if res != 0 {
        print("Build failed")
        oren_exit(1)
    }
    // On success, remove intermediate C output to keep builds clean.
    // (If you want the emitted C, use `--emit-c` / `oren emit-c`).
    oren_system("rm -f " + shell_quote(c_path))
    if target == "macos" {
        if codesign_id != "" {
            var cs_cmd2 = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
            var cs_res2 = oren_system(cs_cmd2)
            if cs_res2 != 0 {
                print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                var ad_cmd2 = "codesign -s - --force " + shell_quote(out_path)
                var ad_res2 = oren_system(ad_cmd2)
                if ad_res2 != 0 {
                    print("codesign fallback failed")
                    oren_exit(1)
                }
            }
        }
    }
    if target == "macos" && notarize {
        var nt_cmd = ""
        if notary_profile != "" {
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --keychain-profile " + shell_quote(notary_profile) + " --wait"
        } else {
            var apple_id = oren_env("APPLE_ID")
            var apple_pass = oren_env("APPLE_ID_PASS")
            var apple_team = oren_env("APPLE_TEAM_ID")
            if apple_id == nil || apple_pass == nil || apple_team == nil {
                print("Notarization requested but APPLE_ID/APPLE_ID_PASS/APPLE_TEAM_ID or --notary-profile not set")
                oren_exit(1)
            }
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --apple-id " + shell_quote(apple_id) + " --password " + shell_quote(apple_pass) + " --team-id " + shell_quote(apple_team) + " --wait"
        }
        var nt_res = oren_system(nt_cmd)
        if nt_res != 0 {
            print("notarization failed")
            oren_exit(1)
        }
        var staple_cmd = "xcrun stapler staple " + shell_quote(out_path)
        var staple_res = oren_system(staple_cmd)
        if staple_res != 0 {
            print("staple failed")
            oren_exit(1)
        }
    }
    print("Build successful: " + out_path)
    if deterministic || emit_manifest {
        var bsC = oren_read_bytes(out_path)
        if oren_is_err(bsC) {
            print("Failed to read artifact for hashing: " + out_path)
            var msgHC = oren_err_msg(bsC)
            if msgHC != nil { print(msgHC) }
            oren_exit(1)
        }
        if deterministic { _emit_artifact_hash("c", out_path, bsC) }
        if emit_manifest {
            var h = _sha256_hex(bsC)
            _write_artifact_manifest("c", out_path, h, target, arch, deterministic, oren_list_len(bsC))
        }
    }
    return nil
}
