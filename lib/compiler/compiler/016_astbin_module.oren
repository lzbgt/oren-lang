// Module-AST ASTBIN writer (rolling)
//
// This writes ordinary v2 ASTBIN map/list bytes, so the existing `astbin_decode`
// path can read the output. The specialization is the traversal: prepared module
// AST nodes are map-shaped but have a small known key vocabulary, so this writer
// avoids generic map iteration and its pathological cost on compiler-shaped ASTs.

var g_astbin_module_keys = nil
var g_astbin_module_unknown_key_reports = 0
var g_astbin_module_trace_unknown_keys = nil
var g_astbin_module_fallback_shape_reports = 0
var g_astbin_module_trace_fallback_shapes = nil

fn _astbin_module_keys() {
    if g_astbin_module_keys != nil { return g_astbin_module_keys }
    g_astbin_module_keys = [
        "type", "token", "literal", "line", "col", "pos", "end", "file",
        "statements", "traits", "stmts",
        "name", "value", "expr", "left", "right", "op", "cond", "consq", "alt",
        "params", "body", "fn", "args", "init", "post", "prop", "elements",
        "index", "pairs", "fields", "call", "path", "link_name",
        "attrs", "ann_type", "ret_ann_type", "type_params", "doc", "is_pub",
        "cfg", "cases", "default", "tag", "values",
        "impl_type", "impl_trait", "impl_method",
        "methods", "enum_variants", "generator_decl", "generator_source_body",
        "spread", "key", "k", "v", "constraint", "constraints", "is_varargs",
        "lambda_name", "captures", "fun", "aliases",
        "parse_ms", "parse_header_ms", "parse_body_ms"
    ]
    return g_astbin_module_keys
}

fn _astbin_module_keys_for_map(m) {
    var t = m["type"]
    if t == "Program" || m["statements"] != nil {
        return ["type", "statements", "traits"]
    }
    if m["literal"] != nil {
        return ["type", "literal", "line", "col", "pos", "end", "file"]
    }
    if t == "Identifier" {
        return ["type", "token", "value", "ann_type", "attrs", "doc", "is_varargs"]
    }
    if t == "Integer" || t == "Float" || t == "String" || t == "Boolean" {
        return ["type", "token", "value"]
    }
    if t == "Nil" || t == "Break" || t == "Continue" {
        return ["type", "token"]
    }
    if t == "Var" || t == "Assign" {
        return ["type", "token", "name", "value", "attrs", "doc"]
    }
    if t == "Set" { return ["type", "token", "left", "value"] }
    if t == "Return" { return ["type", "token", "value"] }
    if t == "ExprStmt" { return ["type", "token", "expr", "attrs", "doc"] }
    if t == "Prefix" { return ["type", "token", "op", "right"] }
    if t == "Infix" { return ["type", "token", "left", "op", "right"] }
    if t == "Block" || t == "StmtList" { return ["type", "token", "stmts"] }
    if t == "If" { return ["type", "token", "cond", "consq", "alt"] }
    if t == "Function" || t == "Lambda" {
        return [
            "type", "token", "name", "params", "body", "attrs", "ret_ann_type",
            "type_params", "doc", "is_pub", "impl_type", "impl_trait", "impl_method",
            "generator_decl", "generator_source_body", "lambda_name", "captures",
            "parse_ms", "parse_header_ms", "parse_body_ms"
        ]
    }
    if t == "Call" { return ["type", "token", "fn", "args", "spread"] }
    if t == "While" { return ["type", "token", "cond", "body", "attrs"] }
    if t == "For" { return ["type", "token", "init", "cond", "post", "body", "attrs"] }
    if t == "Member" { return ["type", "token", "left", "prop"] }
    if t == "Array" { return ["type", "token", "elements"] }
    if t == "Index" { return ["type", "token", "left", "index"] }
    if t == "Hash" { return ["type", "token", "pairs"] }
    if t == "FFI" { return ["type", "token", "name", "link_name", "attrs", "doc"] }
    if t == "Import" { return ["type", "token", "name", "path", "attrs", "doc", "is_pub"] }
    if t == "Type" { return ["type", "token", "name", "fields", "attrs", "doc", "is_pub"] }
    if t == "Spawn" || t == "SpawnExpr" { return ["type", "token", "call"] }
    if t == "Switch" { return ["type", "token", "expr", "cases", "default"] }
    if t == "Attr" { return ["type", "token", "name", "args"] }
    if m["value"] != nil && (m["attrs"] != nil || m["ann_type"] != nil || m["is_varargs"] != nil) {
        return ["value", "attrs", "ann_type", "is_varargs"]
    }
    if m["name"] != nil && m["params"] != nil { return ["name", "params", "ret_ann_type"] }
    if m["name"] != nil && m["methods"] != nil { return ["name", "doc", "methods"] }
    if m["key"] != nil || m["value"] != nil { return ["key", "value"] }
    if m["tag"] != nil || m["values"] != nil { return ["tag", "values", "body"] }
    if m["constraints"] != nil { return ["name", "constraints"] }
    if m["fun"] != nil { return ["name", "fun", "captures", "aliases"] }
    _astbin_module_trace_fallback_shape(m)
    return _astbin_module_keys()
}

fn _astbin_module_key_known(keys, want) {
    var key_count = oren_list_len(keys)
    var i = 0
    while i < key_count {
        if keys[i] == want { return true }
        i = i + 1
    }
    return false
}

fn _astbin_module_trace_unknown_keys_enabled() {
    if g_astbin_module_trace_unknown_keys != nil { return g_astbin_module_trace_unknown_keys }
    var v = oren_env("OREN_TRACE_ASTBIN_MODULE_KEYS")
    if v != nil && v != "" {
        g_astbin_module_trace_unknown_keys = true
    } else {
        g_astbin_module_trace_unknown_keys = false
    }
    return g_astbin_module_trace_unknown_keys
}

fn _astbin_module_trace_unknown_keys(m, keys) {
    if g_astbin_module_unknown_key_reports >= 32 { return nil }
    if _astbin_module_trace_unknown_keys_enabled() != true { return nil }
    var idx = 0
    var out_pair = [nil, nil]
    while 1 {
        var ok = oren_iter_next_entry(m, idx, out_pair)
        if ok == 0 { break }
        var k = out_pair[0]
        if _astbin_is_string(k) && _astbin_module_key_known(keys, k) != true {
            g_astbin_module_unknown_key_reports = g_astbin_module_unknown_key_reports + 1
            print("[astbin_module] unknown key " + k)
            if g_astbin_module_unknown_key_reports >= 32 { return nil }
        }
        idx = idx + 1
    }
    return nil
}

fn _astbin_module_trace_fallback_shapes_enabled() {
    if g_astbin_module_trace_fallback_shapes != nil { return g_astbin_module_trace_fallback_shapes }
    var v = oren_env("OREN_TRACE_ASTBIN_MODULE_SHAPES")
    if v != nil && v != "" && v != "0" && v != "false" {
        g_astbin_module_trace_fallback_shapes = true
    } else {
        g_astbin_module_trace_fallback_shapes = false
    }
    return g_astbin_module_trace_fallback_shapes
}

fn _astbin_module_trace_fallback_shape(m) {
    if g_astbin_module_fallback_shape_reports >= 32 { return nil }
    if _astbin_module_trace_fallback_shapes_enabled() != true { return nil }
    g_astbin_module_fallback_shape_reports = g_astbin_module_fallback_shape_reports + 1
    var t = m["type"]
    if _astbin_is_string(t) != true { t = "<none>" }
    var msg = "[astbin_module] fallback shape type=" + t
    if m["name"] != nil { msg = msg + " name" }
    if m["value"] != nil { msg = msg + " value" }
    if m["params"] != nil { msg = msg + " params" }
    if m["methods"] != nil { msg = msg + " methods" }
    if m["fields"] != nil { msg = msg + " fields" }
    if m["traits"] != nil { msg = msg + " traits" }
    if m["aliases"] != nil { msg = msg + " aliases" }
    if m["captures"] != nil { msg = msg + " captures" }
    if m["k"] != nil { msg = msg + " k" }
    if m["v"] != nil { msg = msg + " v" }
    print(msg)
    return nil
}

fn _astbin_module_count_known_keys(m, keys) {
    var n = 0
    var key_count = oren_list_len(keys)
    var i = 0
    while i < key_count {
        var k = keys[i]
        if m[k] != nil { n = n + 1 }
        i = i + 1
    }
    return n
}

fn _astbin_module_collect_strings(v, pool_idx_map, pool) {
    if v == nil || v == true || v == false { return nil }
    if _astbin_is_string(v) { _astbin_pool_add_str(pool_idx_map, pool, v); return nil }
    if _astbin_is_u8_buf(v) { return nil }
    if _astbin_is_list(v) {
        var n = oren_list_len(v)
        var i = 0
        while i < n {
            _astbin_module_collect_strings(v[i], pool_idx_map, pool)
            i = i + 1
        }
        return nil
    }
    if _astbin_is_map(v) {
        var keys = _astbin_module_keys_for_map(v)
        _astbin_module_trace_unknown_keys(v, keys)
        var map_key_count = oren_list_len(keys)
        var i2 = 0
        while i2 < map_key_count {
            var k = keys[i2]
            var val = v[k]
            if val != nil {
                _astbin_pool_add_str(pool_idx_map, pool, k)
                _astbin_module_collect_strings(val, pool_idx_map, pool)
            }
            i2 = i2 + 1
        }
        return nil
    }
    return nil
}

fn _astbin_module_string_ref_enc(pool_idx_map, s) {
    var enc = oren_map_get_str(pool_idx_map, s)
    if oren_type_tag(enc) == 0 || enc == 0 { _astbin_fail("module v2 missing pool idx", -1) }
    return enc - 1
}

fn _astbin_module_dyn_new(cap0) {
    var cap = cap0
    if cap < 4096 { cap = 4096 }
    var buf = oren_u8_buf_new(cap)
    if oren_is_err(buf) { oren_fail(1, "astbin module dyn: u8_buf alloc failed") }
    var data_ptr = oren_buf_data_ptr_unchecked(buf)
    if data_ptr == 0 { oren_fail(1, "astbin module dyn: data ptr is nil") }
    return {"buf": buf, "len": 0, "cap": cap, "data_ptr": data_ptr}
}

fn _astbin_module_dyn_ensure(b, want) {
    if want <= b["cap"] { return nil }
    var new_cap = b["cap"]
    while new_cap < want { new_cap = new_cap * 2 }
    var nb = oren_u8_buf_new(new_cap)
    if oren_is_err(nb) { oren_fail(1, "astbin module dyn: u8_buf grow failed") }
    var used = b["len"]
    var srcp = b["data_ptr"]
    var dstp = oren_buf_data_ptr_unchecked(nb)
    if dstp == 0 { oren_fail(1, "astbin module dyn: data ptr is nil") }
    if used > 0 { _astbin_dyn_copy_bytes(dstp, srcp, used) }
    b["buf"] = nb
    b["cap"] = new_cap
    b["data_ptr"] = dstp
    return nil
}

fn _astbin_module_dyn_push_u8(b, v) {
    var used = b["len"]
    _astbin_module_dyn_ensure(b, used + 1)
    ptr_set_byte(iadd(b["data_ptr"], used), v & 255)
    b["len"] = used + 1
    return nil
}

fn _astbin_module_dyn_push_uvarint(b, x) {
    var v = x
    if v < 0 { v = 0 }
    while v >= 128 {
        _astbin_module_dyn_push_u8(b, (v & 127) | 128)
        v = v >> 7
    }
    _astbin_module_dyn_push_u8(b, v & 127)
    return nil
}

fn _astbin_module_dyn_push_varint_signed(b, x) {
    var zz = _astbin_zigzag(x)
    if zz < 0 { zz = 0 }
    _astbin_module_dyn_push_uvarint(b, zz)
    return nil
}

fn _astbin_module_dyn_push_u64_le(b, x0) {
    _astbin_module_dyn_push_u8(b, x0 & 255)
    _astbin_module_dyn_push_u8(b, (x0 >> 8) & 255)
    _astbin_module_dyn_push_u8(b, (x0 >> 16) & 255)
    _astbin_module_dyn_push_u8(b, (x0 >> 24) & 255)
    _astbin_module_dyn_push_u8(b, (x0 >> 32) & 255)
    _astbin_module_dyn_push_u8(b, (x0 >> 40) & 255)
    _astbin_module_dyn_push_u8(b, (x0 >> 48) & 255)
    _astbin_module_dyn_push_u8(b, (x0 >> 56) & 255)
    return nil
}

fn _astbin_module_dyn_push_string_raw(b, s) {
    var n = oren_string_len(s)
    _astbin_module_dyn_push_uvarint(b, n)
    var used = b["len"]
    _astbin_module_dyn_ensure(b, used + n)
    var rc = oren_u8_buf_copy_from_string_slice_at(b["buf"], used, s, 0, n)
    if oren_is_err(rc) { oren_fail(1, "astbin module dyn: string copy failed") }
    b["len"] = used + n
    return nil
}

fn _astbin_module_dyn_extend_u8_buf(b, ub) {
    var n = oren_buf_len(ub)
    _astbin_module_dyn_push_uvarint(b, n)
    var used = b["len"]
    _astbin_module_dyn_ensure(b, used + n)
    if n > 0 {
        var srcp = oren_buf_data_ptr_unchecked(ub)
        if srcp == 0 { oren_fail(1, "astbin module dyn: source data ptr is nil") }
        _astbin_dyn_copy_bytes(iadd(b["data_ptr"], used), srcp, n)
    }
    b["len"] = used + n
    return nil
}

fn _astbin_module_dyn_push_string_ref(b, pool_idx_map, s) {
    _astbin_module_dyn_push_u8(b, 4)
    _astbin_module_dyn_push_uvarint(b, _astbin_module_string_ref_enc(pool_idx_map, s))
    return nil
}

fn _astbin_module_write_known_map_v2_dyn(b, m, pool_idx_map, budget_ref) {
    var keys = _astbin_module_keys_for_map(m)
    var n = _astbin_module_count_known_keys(m, keys)
    _astbin_module_dyn_push_u8(b, 6)
    _astbin_module_dyn_push_uvarint(b, n)
    var key_count = oren_list_len(keys)
    var i = 0
    while i < key_count {
        var k = keys[i]
        var v = m[k]
        if v != nil {
            _astbin_module_dyn_push_string_ref(b, pool_idx_map, k)
            _astbin_module_write_value_v2_dyn(b, v, pool_idx_map, budget_ref)
            if b["aborted"] == true { return nil }
        }
        i = i + 1
    }
    return nil
}

fn _astbin_module_write_value_v2_dyn(b, v, pool_idx_map, budget_ref) {
    if b["aborted"] == true { return nil }
    if budget_ref != nil {
        var budget = budget_ref[0]
        if budget <= 0 {
            b["aborted"] = true
            return nil
        }
        budget_ref[0] = budget - 1
    }
    if oren_type_tag(v) == 0 { _astbin_module_dyn_push_u8(b, 0); return nil }
    if v == false { _astbin_module_dyn_push_u8(b, 1); return nil }
    if v == true { _astbin_module_dyn_push_u8(b, 2); return nil }
    if _astbin_is_list(v) {
        _astbin_module_dyn_push_u8(b, 5)
        var n = oren_list_len(v)
        _astbin_module_dyn_push_uvarint(b, n)
        var i = 0
        while i < n {
            _astbin_module_write_value_v2_dyn(b, v[i], pool_idx_map, budget_ref)
            if b["aborted"] == true { return nil }
            i = i + 1
        }
        return nil
    }
    if _astbin_is_map(v) {
        _astbin_module_write_known_map_v2_dyn(b, v, pool_idx_map, budget_ref)
        return nil
    }
    if _astbin_is_string(v) {
        _astbin_module_dyn_push_string_ref(b, pool_idx_map, v)
        return nil
    }
    if _astbin_is_u8_buf(v) {
        _astbin_module_dyn_push_u8(b, 7)
        _astbin_module_dyn_extend_u8_buf(b, v)
        return nil
    }
    if _astbin_is_buf(v) {
        print("astbin module v2: unsupported typed buffer (only u8_buf is supported)")
        oren_exit(1)
    }
    if oren_type_tag(v) == 2 {
        _astbin_module_dyn_push_u8(b, 8)
        _astbin_module_dyn_push_u64_le(b, oren_f64_to_u64_bits(v + 0.0))
        return nil
    }
    _astbin_module_dyn_push_u8(b, 3)
    _astbin_module_dyn_push_varint_signed(b, v)
    return nil
}

fn astbin_encode_module_v2_stream_budget(prog, max_nodes) {
    var trace = false
    var trace_env = oren_env("OREN_TRACE_ASTBIN_MODULE")
    if trace_env != nil && trace_env != "" && trace_env != "0" && trace_env != "false" { trace = true }
    var t0 = 0
    if trace { t0 = oren_time_now_ns() }
    var pool_idx_map = oren_map_new_cap(4096)
    oren_map_build_finalize_unchecked(pool_idx_map, 4096)
    var pool = []
    _astbin_module_collect_strings(prog, pool_idx_map, pool)
    if trace {
        print("[astbin_module] collect done +" + oren_int_to_string((oren_time_now_ns() - t0) / 1000000) + "ms pool=" + oren_int_to_string(oren_list_len(pool)))
    }
    var pool_n = oren_list_len(pool)
    var header_n = 1 + _astbin_uvarint_size(pool_n)
    var i = 0
    while i < pool_n {
        var s = pool[i]
        var sl = oren_string_len(s)
        header_n = header_n + _astbin_uvarint_size(sl) + sl
        i = i + 1
    }

    var b = _astbin_module_dyn_new(header_n + 65536)
    _astbin_module_dyn_push_u8(b, 9)
    _astbin_module_dyn_push_uvarint(b, pool_n)
    var j = 0
    while j < pool_n {
        _astbin_module_dyn_push_string_raw(b, pool[j])
        j = j + 1
    }
    var budget_ref = nil
    if max_nodes != nil && max_nodes > 0 { budget_ref = [max_nodes] }
    _astbin_module_write_value_v2_dyn(b, prog, pool_idx_map, budget_ref)
    if b["aborted"] == true { return nil }
    if trace {
        print("[astbin_module] write done +" + oren_int_to_string((oren_time_now_ns() - t0) / 1000000) + "ms total=" + oren_int_to_string(b["len"]))
    }
    return _astbin_dyn_finalize(b)
}
