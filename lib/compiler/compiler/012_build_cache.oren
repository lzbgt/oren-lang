// Build cache (rolling).
//
// Goal: make `oren build` behave like a modern compiler:
// - caching enabled by default
// - reproducible cache keys (content-addressed)
// - safe invalidation when compiler binary changes
//
// Current scope (v0):
// - caches the *final artifact* only (native/c/bytecode) keyed by:
//   - compiler executable signature (argv[0] when available; strong hash in deterministic mode,
//     fast metadata signature in rolling mode)
//   - build options that affect output
//   - curated native codegen env surface (for build-affecting fast-path/runtime overrides)
//   - transitive source closure hash (imports + @include expansion)
//
// This intentionally does not attempt fine-grained incremental compilation yet.

import token "token.oren"

// Rolling cache schemas.
//
// v1 used sha256 for every input (source strings + compiler exe + injected runtime).
// Under the native runtime, pure-Oren sha256 can dominate `oren build` wall time because
// cache key computation happens before any compilation work.
//
// v3 keeps the fast non-cryptographic fingerprint for source closure hashing, but also
// folds build-affecting native env toggles into the final artifact key so cached native
// outputs cannot be reused across incompatible codegen modes.
var BUILD_CACHE_SCHEMA = 3
var SCAN_CACHE_SCHEMA = 3
var SCAN_CACHE_MAX_BYTES = 524288
var SCAN_CACHE_MAX_RECORDS = 4096

fn _cache_force_sha256(build_cfg) {
    // Force sha256 hashing even in non-deterministic builds.
    // Useful for debugging collisions or validating cache invariants.
    var v = oren_env("OREN_CACHE_SHA256")
    if v != nil && v != "" && v != "0" && v != "false" { return true }
    return false
}

fn _cache_deterministic(build_cfg) {
    if build_cfg != nil && build_cfg["deterministic"] == 1 { return true }
    return false
}

fn _mask63(x) { return x & 9223372036854775807 }

fn _cache_byte_at(s, i) {
    return oren_string_byte_at_unchecked(s, i) & 255
}

fn _fnv1a63_string(s, basis) {
    if s == nil { return 0 }
    var h = _mask63(basis)
    var prime = 1099511628211
    var n = oren_string_len(s)
    var i = 0
    while i < n {
        var b = _cache_byte_at(s, i)
        h = _mask63(h ^ b)
        h = _mask63(h * prime)
        i = i + 1
    }
    return h
}

fn _fnv1a63_u8_buf(ub, basis) {
    if ub == nil { return 0 }
    if oren_is_u8_buf(ub) != true { return 0 }
    var h = _mask63(basis)
    var prime = 1099511628211
    var n = oren_buf_len(ub)
    if n <= 0 { return h }
    var p = oren_buf_data_ptr_unchecked(ub)
    if p == 0 { return h }
    var i = 0
    while i < n {
        var b = ptr_get_byte(iadd(p, i)) & 255
        h = _mask63(h ^ b)
        h = _mask63(h * prime)
        i = i + 1
    }
    return h
}

fn _fingerprint2_string(s) {
    var h1 = _fnv1a63_string(s, 1469598103934665603)
    var h2 = _fnv1a63_string(s, 1099511628211)
    return "v2_" + oren_int_to_string(h1) + "_" + oren_int_to_string(h2)
}

fn _fingerprint2_u8_buf(ub) {
    var h1 = _fnv1a63_u8_buf(ub, 1469598103934665603)
    var h2 = _fnv1a63_u8_buf(ub, 1099511628211)
    return "v2_" + oren_int_to_string(h1) + "_" + oren_int_to_string(h2)
}

fn _cache_hash_string(s, build_cfg) {
    if _cache_deterministic(build_cfg) || _cache_force_sha256(build_cfg) {
        return _sha256_hex_string(s)
    }
    return _fingerprint2_string(s)
}

fn _cache_hash_u8_buf(ub, build_cfg) {
    if _cache_deterministic(build_cfg) || _cache_force_sha256(build_cfg) {
        return _sha256_hex(ub)
    }
    return _fingerprint2_u8_buf(ub)
}

fn _cache_sort_strings(xs) {
    // Insertion sort (small lists expected).
    if xs == nil { return [] }
    var i = 1
    while i < oren_list_len(xs) {
        var key = xs[i]
        var j = i - 1
        while j >= 0 && xs[j] > key {
            xs[j + 1] = xs[j]
            j = j - 1
        }
        xs[j + 1] = key
        i = i + 1
    }
    return xs
}

fn _cache_env_value_for_key(name) {
    var v = oren_env(name)
    if v == nil { return "<unset>" }
    return v
}

fn _cache_append_env_key_field(s, name) {
    return s + "env " + name + "=" + _cache_env_value_for_key(name) + "\n"
}

fn _cache_native_build_env_names(build_cfg) {
    var names = [
        "OREN_NATIVE_ASSUME_LIST_INDEX",
        "OREN_NATIVE_FAST_LIST_INT_GET_SUM_WHOLE_LIST_HELPER",
        "OREN_NATIVE_FAST_LIST_INT_DOT_WHOLE_LIST_HELPER",
        "OREN_NATIVE_RUNTIME_PROFILE",
        "OREN_NATIVE_RUNTIME_ASTBIN",
        "OREN_NATIVE_RUNTIME_EXPANDED",
        "OREN_NATIVE_RESOLVE_SYMBOL"
    ]
    if build_cfg == nil { return names }
    var arch = build_cfg["arch"]
    if arch == "arm64" {
        var arm64_names = [
            "OREN_ARM64_LIST_INT_SLOT_DIRECT_FAST_TICK",
            "OREN_ARM64_LIST_INT_SLOT_DIRECT_PAIR_LOOP",
            "OREN_ARM64_LIST_INT_SLOT_DIRECT_TICK_MASK",
            "OREN_ARM64_FAST_LCG_SUM_KEEP_TICK_SLOT",
            "OREN_ARM64_FAST_LCG_SUM_TICK_MASK",
            "OREN_ARM64_FAST_LIST_GET_SUM_KEEP_TICK_SLOT",
            "OREN_ARM64_FAST_LIST_GET_SUM_TICK_MASK",
            "OREN_ARM64_FAST_LIST_INT_GET_SUM_PREFIX_ZERO",
            "OREN_ARM64_FAST_LIST_INT_GET_SUM_TICK_MASK",
            "OREN_ARM64_FAST_LIST_INT_GET_SUM_SINGLE_LIST_CURSOR_REGS",
            "OREN_ARM64_FAST_LIST_INT_GET_SUM_UNROLL2",
            "OREN_ARM64_FAST_LIST_INT_GET_SUM_DUAL_ACCUM",
            "OREN_ARM64_FAST_LIST_INT_GET_SUM_PAIR_POST",
            "OREN_ARM64_FAST_LIST_INT_GET_SUM_VECTOR_2D",
            "OREN_ARM64_FAST_LIST_INT_GET_SUM_KEEP_TICK_SLOT",
            "OREN_ARM64_FAST_LIST_INT_DOT_PREFIX_ZERO",
            "OREN_ARM64_FAST_LIST_INT_DOT_PREFIX_ZERO_PAIR_LOOP",
            "OREN_ARM64_FAST_LIST_INT_DOT_TICK_MASK",
            "OREN_ARM64_FAST_LIST_INT_DOT_SINGLE_PAIR_CURSOR_REGS",
            "OREN_ARM64_FAST_LIST_INT_DOT_LOW32_LOADS",
            "OREN_ARM64_FAST_LIST_INT_DOT_DUAL_ACCUM",
            "OREN_ARM64_FAST_LIST_INT_DOT_DUAL_MADD",
            "OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT",
            "OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_QUAD",
            "OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_DOUBLE",
            "OREN_ARM64_FAST_LIST_INT_DOT_MADD_EXACT_SCALAR",
            "OREN_ARM64_FAST_LIST_INT_DOT_SCALAR_POST",
            "OREN_ARM64_FAST_LIST_INT_DOT_PAIR_POST",
            "OREN_ARM64_FAST_LIST_INT_DOT_UNROLL2",
            "OREN_ARM64_FAST_LIST_INT_DOT_KEEP_TICK_SLOT",
            "OREN_ARM64_FAST_LIST_DOT_KEEP_TICK_SLOT",
            "OREN_ARM64_FAST_LIST_DOT_TICK_MASK",
            "OREN_ARM64_FAST_LIST_INT_PUSH_KEEP_TICK_SLOT",
            "OREN_ARM64_FAST_LIST_INT_PUSH_TICK_MASK",
            "OREN_ARM64_FAST_LIST_INT_PUSH_SINGLE_LIST_CURSOR",
            "OREN_ARM64_FAST_LIST_INT_PUSH_IDX_EXPR",
            "OREN_ARM64_FAST_LIST_INT_PUSH_NONNEG_LINEAR",
            "OREN_ARM64_FAST_LIST_INT_PUSH_NONNEG_LINEAR_UNROLL4",
            "OREN_ARM64_FAST_LIST_INT_PUSH_FRESH_EXACT_INIT",
            "OREN_ARM64_FAST_LIST_INT_PUSH_FRESH_EXACT_SINGLE_LIST",
            "OREN_ARM64_FAST_LIST_INT_PUSH_IDX_EXPR_CURSOR_REGS",
            "OREN_ARM64_FAST_LIST_PUSH_KEEP_TICK_SLOT",
            "OREN_ARM64_FAST_LIST_PUSH_TICK_MASK"
        ]
        var i = 0
        while i < oren_list_len(arm64_names) {
            oren_list_push(names, arm64_names[i])
            i = i + 1
        }
    } else if arch == "x64" {
        var x64_names = [
            "OREN_X64_RT_OBJ_MERGE_CSTR0_OFFS",
            "OREN_X64_SKIP_RTOBJ"
        ]
        var j = 0
        while j < oren_list_len(x64_names) {
            oren_list_push(names, x64_names[j])
            j = j + 1
        }
    }
    return names
}

fn _cache_hash_native_override_env_inputs(inputs, build_cfg, scan_state) {
    if build_cfg == nil || build_cfg["backend"] != "native" { return {"ok": true} }
    var astbin_override = oren_env("OREN_NATIVE_RUNTIME_ASTBIN")
    if astbin_override != nil && astbin_override != "" {
        var ast_path = path_norm(astbin_override)
        var ast_bytes = oren_read_u8_buf(ast_path)
        if oren_is_err(ast_bytes) {
            return {"ok": false, "err": "failed to read OREN_NATIVE_RUNTIME_ASTBIN=" + ast_path}
        }
        inputs["ENV_FILE:OREN_NATIVE_RUNTIME_ASTBIN:" + ast_path] = _cache_hash_u8_buf(ast_bytes, build_cfg)
    }
    var expanded_override = oren_env("OREN_NATIVE_RUNTIME_EXPANDED")
    if expanded_override != nil && expanded_override != "" {
        var exp_path = path_norm(expanded_override)
        var exp_hash = _cache_hash_expanded_includes(exp_path, build_cfg, scan_state)
        if exp_hash["ok"] != true {
            return {"ok": false, "err": "failed to read OREN_NATIVE_RUNTIME_EXPANDED=" + exp_path + " (" + exp_hash["err"] + ")"}
        }
        inputs["ENV_FILE:OREN_NATIVE_RUNTIME_EXPANDED:" + exp_path] = exp_hash["hash"]
    }
    return {"ok": true}
}

fn _cache_default_dir() {
    // Default (rolling):
    // - keep build cache *repo-local* so it is predictable for humans + AI agents
    // - override explicitly via env OREN_CACHE_DIR or CLI --cache-dir
    //
    // Priority:
    // 1) env OREN_CACHE_DIR
    // 2) build/cache (repo-local default)
    var d = oren_env("OREN_CACHE_DIR")
    if d != nil && d != "" { return path_norm(d) }
    return path_norm("build/cache")
}

fn _cache_compiler_sig(build_cfg) {
    // Best-effort: hash argv[0] bytes so cache invalidates when the compiler binary changes.
    // When argv[0] is not a file path, fall back to OREN_VERSION (weaker).
    var args = oren_args()
    if args != nil && oren_list_len(args) > 0 {
        var exe = args[0]
        if exe != nil && exe != "" && file_exists(exe) {
            // Rolling performance note:
            // Hashing the full compiler binary (even with a fast fingerprint) can dominate build
            // wall time under the native runtime, because cache key computation happens before any
            // compilation work.
            //
            // Contract:
            // - deterministic/forced-sha256 builds keep strong invalidation (hash file bytes)
            // - rolling builds use a cheap stat-based signature (path + size + mtime_ns)
            if _cache_deterministic(build_cfg) || _cache_force_sha256(build_cfg) {
                // Prefer u8_buf to avoid boxing each byte as an int (can blow up memory for big binaries).
                var bs = oren_read_u8_buf(exe)
                if !oren_is_err(bs) {
                    return _cache_hash_u8_buf(bs, build_cfg)
                }
            } else {
                // Fast signature: file metadata + path fingerprint.
                var meta = oren_file_stat_size_mtime_ns(exe)
                if !oren_is_err(meta) && meta != nil && oren_is_list(meta) == true && oren_list_len(meta) >= 2 {
                    var sz = meta[0]
                    var mt = meta[1]
                    return "v2_exe_" + _fingerprint2_string(exe) + "_sz" + oren_int_to_string(sz) + "_mt" + oren_int_to_string(mt)
                }
                // Fallback: at least include a stable identifier for argv[0].
                return "v2_exe_" + _fingerprint2_string(exe)
            }
        }
    }
    return OREN_VERSION
}

fn _cache_enabled(seen, opts) {
    // Enabled by default; disable via:
    // - `--no-cache`
    // - env `OREN_NO_CACHE` (wired via std:argparse env defaults for the `oren` CLI)
    //
    // We intentionally rely on parsed opts here (so env "0" can re-enable caching).
    if opts != nil && opts["no-cache"] == true { return false }
    return true
}

fn _cache_dir_from_opts(seen, opts) {
    var d = _cache_default_dir()
    if seen != nil && seen["cache-dir"] == true {
        var v = opts["cache-dir"]
        if v != nil && v != "" { d = path_norm(v) }
    }
    return d
}

fn _cache_scan_imports_for_file(full_path, config) {
    // Returns {"ok":bool, "imports":[full,...], "src_hash":hex, "err":string}
    //
    // Performance note:
    // - this function is called for every module reachable from the entrypoint.
    // - avoid parsing the full program AST; we only need top-level `import` statements.
    // - use token scanning via the lexer for a much cheaper dependency walk.
    var rr = expand_includes_file_result(full_path, [])
    if rr["ok"] != true {
        var msg = rr["err"]
        if msg == nil { msg = "failed to read" }
        return {"ok": false, "err": msg}
    }
    var src = rr["src"]
    var sh = _cache_hash_string(src, config)

    var l = lexer.new_lexer(src)
    l["file"] = full_path
    var imports = []
    var base_dir = dirname(full_path)
    var tok = lexer.next_token(l)
    while tok != nil && tok["type"] != token.TOK_EOF {
        if tok["type"] == token.TOK_IMPORT {
            // Grammar: import <ident> <string> [;]
            var tname = lexer.next_token(l)
            if tname == nil || tname["type"] != token.TOK_IDENT {
                return {"ok": false, "err": "cache scan: invalid import (expected identifier after import) in " + full_path}
            }
            var tpath = lexer.next_token(l)
            if tpath == nil || tpath["type"] != token.TOK_STRING {
                return {"ok": false, "err": "cache scan: invalid import (expected string path) in " + full_path}
            }
            var imp_path = tpath["literal"]
            if imp_path != nil {
                // In stdlib `.obc` mode, treat std imports as external (do not walk sources).
                if config != nil && config["stdlib_mode"] == "obc" {
                    if starts_with(imp_path, "std:") || starts_with(imp_path, "std/") {
                        // Record the spec itself as a dependency marker.
                        oren_list_push(imports, imp_path)
                    } else {
                        var full = resolve_import_path(base_dir, imp_path)
                        oren_list_push(imports, full)
                    }
                } else {
                    var full2 = resolve_import_path(base_dir, imp_path)
                    oren_list_push(imports, full2)
                }
            }
        }
        tok = lexer.next_token(l)
    }
    return {"ok": true, "imports": imports, "src_hash": sh}
}

fn _cache_scan_includes_from_src(src, full_path) {
    // Return a list of resolved include file paths (in source order).
    //
    // Include directive form:
    //   // @include "relative/or/absolute/path.oren"
    //
    // We intentionally avoid materializing expanded source here; cache hashing needs
    // include closure awareness but not concatenation.
    if src == nil || full_path == nil { return [] }
    var out = []
    var n = oren_string_len(src)
    var line_start = 0
    var i = 0
    while i <= n {
        if i == n || oren_string_char_at_unchecked(src, i) == "\n" {
            // Process line [line_start, i)
            var j = line_start
            while j < i {
                var c = oren_string_char_at_unchecked(src, j)
                if c != " " && c != "\t" && c != "\r" { break }
                j = j + 1
            }
            // Fast prefix match: "// @include"
            if j + 10 < i {
                if oren_string_char_at_unchecked(src, j) == "/" &&
                   oren_string_char_at_unchecked(src, j + 1) == "/" &&
                   oren_string_char_at_unchecked(src, j + 2) == " " &&
                   oren_string_char_at_unchecked(src, j + 3) == "@" &&
                   oren_string_char_at_unchecked(src, j + 4) == "i" &&
                   oren_string_char_at_unchecked(src, j + 5) == "n" &&
                   oren_string_char_at_unchecked(src, j + 6) == "c" &&
                   oren_string_char_at_unchecked(src, j + 7) == "l" &&
                   oren_string_char_at_unchecked(src, j + 8) == "u" &&
                   oren_string_char_at_unchecked(src, j + 9) == "d" &&
                   oren_string_char_at_unchecked(src, j + 10) == "e" {
                    // Find quoted path.
                    var q1 = -1
                    var k = j + 11
                    while k < i {
                        if oren_string_char_at_unchecked(src, k) == "\"" { q1 = k; break }
                        k = k + 1
                    }
                    if q1 >= 0 {
                        var q2 = -1
                        var k2 = q1 + 1
                        while k2 < i {
                            if oren_string_char_at_unchecked(src, k2) == "\"" { q2 = k2; break }
                            k2 = k2 + 1
                        }
                        if q2 > q1 + 1 {
                            var inc = oren_string_slice(src, q1 + 1, q2)
                            var inc_full = inc
                            if inc != nil && oren_string_len(inc) > 0 && oren_string_char_at_unchecked(inc, 0) != "/" {
                                inc_full = resolve_path(dirname(full_path), inc)
                            }
                            if inc_full != nil && oren_string_len(inc_full) > 0 {
                                oren_list_push(out, inc_full)
                            }
                        }
                    }
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    return out
}

fn _cache_mix_fingerprint(h1, h2, s) {
    // Mix a string into the two-lane fingerprint state.
    if s == nil { return {"h1": h1, "h2": h2} }
    return {"h1": _fnv1a63_string(s, h1), "h2": _fnv1a63_string(s, h2)}
}

fn _cache_hash_includes_closure_fingerprint(full_path, src, includes, build_cfg, memo, include_stack) {
    // Compute a stable fingerprint for a file + its include closure without expanding source.
    //
    // This avoids building giant expanded strings during build-cache key computation.
    if memo != nil && memo[full_path] != nil { return memo[full_path] }

    // Include-cycle check (keep it deterministic and safe).
    if include_stack != nil {
        var si = 0
        while si < oren_list_len(include_stack) {
            if include_stack[si] == full_path {
                return "include_cycle:" + full_path
            }
            si = si + 1
        }
    }
    var next_stack = []
    if include_stack != nil {
        var ci = 0
        while ci < oren_list_len(include_stack) { oren_list_push(next_stack, include_stack[ci]); ci = ci + 1 }
    }
    oren_list_push(next_stack, full_path)

    var h1 = _fnv1a63_string(src, 1469598103934665603)
    var h2 = _fnv1a63_string(src, 1099511628211)

    var ii = 0
    while includes != nil && ii < oren_list_len(includes) {
        var incp = includes[ii]
        if incp != nil && incp != "" {
            var child_src = oren_read_file(incp)
            if !oren_is_err(child_src) && child_src != nil {
                var child_incs = _cache_scan_includes_from_src(child_src, incp)
                var child_hash = _cache_hash_includes_closure_fingerprint(incp, child_src, child_incs, build_cfg, memo, next_stack)
                var mm = _cache_mix_fingerprint(h1, h2, "\nI:")
                h1 = mm["h1"]; h2 = mm["h2"]
                mm = _cache_mix_fingerprint(h1, h2, incp)
                h1 = mm["h1"]; h2 = mm["h2"]
                mm = _cache_mix_fingerprint(h1, h2, "=")
                h1 = mm["h1"]; h2 = mm["h2"]
                mm = _cache_mix_fingerprint(h1, h2, child_hash)
                h1 = mm["h1"]; h2 = mm["h2"]
            }
        }
        ii = ii + 1
    }

    var out = "v2_" + oren_int_to_string(_mask63(h1)) + "_" + oren_int_to_string(_mask63(h2))
    if memo != nil { memo[full_path] = out }
    return out
}

fn _cache_hash_includes_closure(full_path, build_cfg, memo, include_stack) {
    // Deterministic builds keep sha256 of the fully expanded source as the cache contract.
    if _cache_deterministic(build_cfg) || _cache_force_sha256(build_cfg) {
        var rr = expand_includes_file_result(full_path, [])
        if rr["ok"] != true {
            var msg = rr["err"]
            if msg == nil { msg = "failed to read" }
            return "include_err:" + msg
        }
        return _sha256_hex_string(rr["src"])
    }

    var src = oren_read_file(full_path)
    if oren_is_err(src) { return "read_err" }
    var incs = _cache_scan_includes_from_src(src, full_path)
    return _cache_hash_includes_closure_fingerprint(full_path, src, incs, build_cfg, memo, include_stack)
}

fn _scan_cache_file(cache_dir) {
    if cache_dir == nil || cache_dir == "" { cache_dir = _cache_default_dir() }
    return path_norm(cache_dir + "/scan_cache_v3.txt")
}

fn _scan_cache_split_lines(s) {
    if s == nil { return [] }
    var out = []
    var start = 0
    var i = 0
    var n = oren_string_len(s)
    while i < n {
        var b = _cache_byte_at(s, i)
        if b == 10 { // \n
            oren_list_push(out, oren_string_slice(s, start, i))
            i = i + 1
            start = i
            continue
        }
        if b == 13 { // \r
            oren_list_push(out, oren_string_slice(s, start, i))
            // consume optional \n
            if i + 1 < n && _cache_byte_at(s, i + 1) == 10 { i = i + 2 } else { i = i + 1 }
            start = i
            continue
        }
        i = i + 1
    }
    // final line
    oren_list_push(out, oren_string_slice(s, start, n))
    return out
}

fn _scan_cache_parse_u32(s) {
    if s == nil { return 0 }
    var n = 0
    var i = 0
    var sl = oren_string_len(s)
    while i < sl {
        var b = _cache_byte_at(s, i)
        if b < 48 || b > 57 { return 0 }
        n = n * 10 + (b - 48)
        i = i + 1
    }
    if n < 0 { n = 0 }
    return n
}

fn _scan_cache_parse_i64(s) {
    // Parse a non-negative decimal int into i64. (Used for mtime_ns/size.)
    if s == nil { return 0 }
    var n = 0
    var i = 0
    var sl = oren_string_len(s)
    while i < sl {
        var b = _cache_byte_at(s, i)
        if b < 48 || b > 57 { return 0 }
        n = n * 10 + (b - 48)
        i = i + 1
    }
    if n < 0 { n = 0 }
    return n
}

fn _scan_cache_load(cache_dir) {
    // Returns a map: path -> record
    //
    // Record shape (v3):
    // - "mtime_ns": int
    // - "size": int
    // - "raw": string      (hash of the file contents only; build_cfg-dependent)
    // - "includes": list<string> (resolved include file paths)
    // - "imports_self": list<string> (direct imports from this file only)
    // - "hash": string     (hash of file + include closure; derived from "raw"+"includes"+children)
    // - "imports": list<string> (merged imports including include-imports)
    var p = _scan_cache_file(cache_dir)
    if !file_exists(p) { return {} }
    var meta = oren_file_stat_size_mtime_ns(p)
    if !oren_is_err(meta) && meta != nil && oren_is_list(meta) == true && oren_list_len(meta) >= 1 {
        if meta[0] > SCAN_CACHE_MAX_BYTES { return {} }
    }
    var s = oren_read_file(p)
    if s == nil { return {} }
    var lines = _scan_cache_split_lines(s)
    if lines == nil || oren_list_len(lines) == 0 { return {} }
    if lines[0] != "OREN_SCAN_CACHE_V3" { return {} }

    var out = {}
    var i = 1
    var records = 0
    while i < oren_list_len(lines) && records < SCAN_CACHE_MAX_RECORDS {
        // Fixed-order record:
        //   path
        //   mtime_ns
        //   size
        //   raw_hash
        //   n_includes
        //   includes...
        //   n_imports_self
        //   imports_self...
        //   closure_hash
        //   n_imports_merged
        //   imports_merged...
        if i + 5 >= oren_list_len(lines) { break }
        var path = lines[i]; i = i + 1
        var mline = lines[i]; i = i + 1
        var szline = lines[i]; i = i + 1
        var raw = lines[i]; i = i + 1
        var ninc_line = lines[i]; i = i + 1
        if path == nil || path == "" { continue }

        var mtime = _scan_cache_parse_i64(mline)
        var size = _scan_cache_parse_i64(szline)
        if raw == nil { raw = "" }
        var ninc = _scan_cache_parse_u32(ninc_line)
        var incs = []
        var j = 0
        while j < ninc && i < oren_list_len(lines) {
            oren_list_push(incs, lines[i])
            i = i + 1
            j = j + 1
        }
        if i >= oren_list_len(lines) { break }
        var nself = _scan_cache_parse_u32(lines[i]); i = i + 1
        var self_imps = []
        var j2 = 0
        while j2 < nself && i < oren_list_len(lines) {
            oren_list_push(self_imps, lines[i])
            i = i + 1
            j2 = j2 + 1
        }
        if i >= oren_list_len(lines) { break }
        var hh = lines[i]; i = i + 1
        if hh == nil { hh = "" }
        if i >= oren_list_len(lines) { break }
        var nmerged = _scan_cache_parse_u32(lines[i]); i = i + 1
        var merged = []
        var j3 = 0
        while j3 < nmerged && i < oren_list_len(lines) {
            oren_list_push(merged, lines[i])
            i = i + 1
            j3 = j3 + 1
        }

        out[path] = {
            "mtime_ns": mtime,
            "size": size,
            "raw": raw,
            "includes": incs,
            "imports_self": self_imps,
            "hash": hh,
            "imports": merged
        }
        records = records + 1
    }
    return out
}

fn _scan_cache_bytes_new() {
    // Small u8_buf builder for scan cache serialization (avoid O(n^2) string concat).
    var cap = 8192
    var buf = oren_u8_buf_new(cap)
    if oren_is_err(buf) { oren_fail(1, "scan_cache_save: u8_buf alloc failed") }
    return {"buf": buf, "len": 0, "cap": cap}
}

fn _scan_cache_bytes_memcpy8(dst, src, len) {
    var i = 0
    while i < len {
        if len - i >= 8 {
            ptr_set(iadd(dst, i), ptr_get(iadd(src, i)))
            i = i + 8
        } else {
            ptr_set_byte(iadd(dst, i), ptr_get_byte(iadd(src, i)))
            i = i + 1
        }
    }
    return nil
}

fn _scan_cache_bytes_ensure(b, want) {
    if want <= b["cap"] { return nil }
    var new_cap = b["cap"]
    if new_cap < 1024 { new_cap = 1024 }
    while new_cap < want { new_cap = new_cap * 2 }
    var nb = oren_u8_buf_new(new_cap)
    if oren_is_err(nb) { oren_fail(1, "scan_cache_save: u8_buf grow failed") }
    var used = b["len"]
    if used > 0 {
        var srcp = oren_buf_data_ptr_unchecked(b["buf"])
        var dstp = oren_buf_data_ptr_unchecked(nb)
        if srcp == 0 || dstp == 0 { oren_fail(1, "scan_cache_save: buf data ptr is nil") }
        _scan_cache_bytes_memcpy8(dstp, srcp, used)
    }
    b["buf"] = nb
    b["cap"] = new_cap
    return nil
}

fn _scan_cache_bytes_push_byte(b, v) {
    var used = b["len"]
    _scan_cache_bytes_ensure(b, used + 1)
    var dstp = oren_buf_data_ptr_unchecked(b["buf"])
    if dstp == 0 { oren_fail(1, "scan_cache_save: buf data ptr is nil") }
    ptr_set_byte(iadd(dstp, used), v & 255)
    b["len"] = used + 1
    return nil
}

fn _scan_cache_bytes_push_str(b, s) {
    if s == nil { return nil }
    // Strings are NUL-terminated; `oren_string_len` is O(n), so compute once.
    var n = oren_string_len(s)
    if n <= 0 { return nil }
    var used = b["len"]
    _scan_cache_bytes_ensure(b, used + n)
    var rc = oren_u8_buf_copy_from_string_slice_at(b["buf"], used, s, 0, n)
    if oren_is_err(rc) { oren_fail(1, "scan_cache_save: string copy failed") }
    b["len"] = used + n
    return nil
}

fn _scan_cache_bytes_finalize(b) {
    var n = b["len"]
    var out = b["buf"]
    if n == b["cap"] { return out }
    var tight = oren_u8_buf_new(n)
    if oren_is_err(tight) { oren_fail(1, "scan_cache_save: u8_buf finalize failed") }
    if n > 0 {
        var srcp = oren_buf_data_ptr_unchecked(out)
        var dstp = oren_buf_data_ptr_unchecked(tight)
        if srcp == 0 || dstp == 0 { oren_fail(1, "scan_cache_save: buf data ptr is nil") }
        _scan_cache_bytes_memcpy8(dstp, srcp, n)
    }
    return tight
}

fn _scan_cache_save(cache_dir, cache_map) {
    var p = _scan_cache_file(cache_dir)
    ensure_dir(dirname(p))
    var paths = []
    for k in cache_map { oren_list_push(paths, k) }
    paths = _cache_sort_strings(paths)
    var b = _scan_cache_bytes_new()
    _scan_cache_bytes_push_str(b, "OREN_SCAN_CACHE_V3\n")
    var i = 0
    var saved = 0
    while i < oren_list_len(paths) && saved < SCAN_CACHE_MAX_RECORDS {
        var path = paths[i]
        var rec = cache_map[path]
        if rec == nil { i = i + 1; continue }
        var mtime = rec["mtime_ns"]
        if mtime == nil { mtime = 0 }
        var size = rec["size"]
        if size == nil { size = 0 }
        var raw = rec["raw"]
        if raw == nil { raw = "" }
        var incs = rec["includes"]
        if incs == nil { incs = [] }
        var self_imps = rec["imports_self"]
        if self_imps == nil { self_imps = [] }
        var hh = rec["hash"]
        if hh == nil { hh = "" }
        var merged = rec["imports"]
        if merged == nil { merged = [] }
        _scan_cache_bytes_push_str(b, path)
        _scan_cache_bytes_push_byte(b, 10)
        _scan_cache_bytes_push_str(b, oren_int_to_string(mtime))
        _scan_cache_bytes_push_byte(b, 10)
        _scan_cache_bytes_push_str(b, oren_int_to_string(size))
        _scan_cache_bytes_push_byte(b, 10)
        _scan_cache_bytes_push_str(b, raw)
        _scan_cache_bytes_push_byte(b, 10)
        _scan_cache_bytes_push_str(b, oren_int_to_string(oren_list_len(incs)))
        _scan_cache_bytes_push_byte(b, 10)
        var j = 0
        while j < oren_list_len(incs) {
            var inc = incs[j]
            if inc == nil { inc = "" }
            _scan_cache_bytes_push_str(b, inc)
            _scan_cache_bytes_push_byte(b, 10)
            j = j + 1
        }
        _scan_cache_bytes_push_str(b, oren_int_to_string(oren_list_len(self_imps)))
        _scan_cache_bytes_push_byte(b, 10)
        var j2 = 0
        while j2 < oren_list_len(self_imps) {
            var imp = self_imps[j2]
            if imp == nil { imp = "" }
            _scan_cache_bytes_push_str(b, imp)
            _scan_cache_bytes_push_byte(b, 10)
            j2 = j2 + 1
        }
        _scan_cache_bytes_push_str(b, hh)
        _scan_cache_bytes_push_byte(b, 10)
        _scan_cache_bytes_push_str(b, oren_int_to_string(oren_list_len(merged)))
        _scan_cache_bytes_push_byte(b, 10)
        var j3 = 0
        while j3 < oren_list_len(merged) {
            var imp2 = merged[j3]
            if imp2 == nil { imp2 = "" }
            _scan_cache_bytes_push_str(b, imp2)
            _scan_cache_bytes_push_byte(b, 10)
            j3 = j3 + 1
        }
        saved = saved + 1
        i = i + 1
    }
    var ub = _scan_cache_bytes_finalize(b)
    oren_write_bytes(p, ub)
    return nil
}

fn _cache_file_meta(full_path) {
    // Return {"ok":bool, "size":int, "mtime_ns":int, "err":string}
    //
    // Backends implement this via their own runtime layers:
    // - native runtime: `sys_stat` → OrenStatV0 → [size,mtime_ns]
    // - C backend: libc `stat(2)`
    var r = oren_file_stat_size_mtime_ns(full_path)
    if oren_is_err(r) {
        var em = oren_err_msg(r)
        if em == nil { em = "stat failed" }
        return {"ok": false, "err": em}
    }
    if r == nil || oren_is_list(r) != true || oren_list_len(r) < 2 {
        return {"ok": false, "err": "stat returned invalid shape"}
    }
    return {"ok": true, "size": r[0], "mtime_ns": r[1]}
}

fn _cache_scan_direct_imports_from_src(src, full_path, config) {
    // Scan only *this file's* imports (not includes), returning resolved paths.
    if src == nil || full_path == nil { return {"ok": true, "imports": []} }
    var l = lexer.new_lexer(src)
    l["file"] = full_path
    var imports = []
    var base_dir = dirname(full_path)
    var tok = lexer.next_token(l)
    while tok != nil && tok["type"] != token.TOK_EOF {
        if tok["type"] == token.TOK_IMPORT {
            var tname = lexer.next_token(l)
            if tname == nil || tname["type"] != token.TOK_IDENT {
                return {"ok": false, "err": "cache scan: invalid import (expected identifier after import) in " + full_path}
            }
            var tpath = lexer.next_token(l)
            if tpath == nil || tpath["type"] != token.TOK_STRING {
                return {"ok": false, "err": "cache scan: invalid import (expected string path) in " + full_path}
            }
            var imp_path = tpath["literal"]
            if imp_path != nil {
                if config != nil && config["stdlib_mode"] == "obc" {
                    if starts_with(imp_path, "std:") || starts_with(imp_path, "std/") {
                        oren_list_push(imports, imp_path)
                    } else {
                        var full_imp = resolve_import_path(base_dir, imp_path)
                        oren_list_push(imports, full_imp)
                    }
                } else {
                    var full_imp2 = resolve_import_path(base_dir, imp_path)
                    oren_list_push(imports, full_imp2)
                }
            }
        }
        tok = lexer.next_token(l)
    }
    return {"ok": true, "imports": imports}
}

fn _scan_cache_refresh_file_record(full_path, config, scan_state) {
    // Ensure scan cache has an up-to-date record for full_path.
    // Returns {"ok":bool, "rec":map, "err":string}
    if scan_state == nil { return {"ok": false, "err": "scan_state is nil"} }
    var cache_map = scan_state["cache"]
    if cache_map == nil { cache_map = {} ; scan_state["cache"] = cache_map }

    var meta = _cache_file_meta(full_path)
    if meta["ok"] != true {
        return {"ok": false, "err": meta["err"]}
    }

    var mtime = meta["mtime_ns"]
    var size = meta["size"]
    var rec = cache_map[full_path]
    if rec != nil &&
       rec["mtime_ns"] == mtime &&
       rec["size"] == size &&
       rec["raw"] != nil &&
       rec["includes"] != nil &&
       rec["imports_self"] != nil {
        return {"ok": true, "rec": rec}
    }

    var src = oren_read_file(full_path)
    if oren_is_err(src) {
        var em = oren_err_msg(src)
        if em == nil { em = "failed to read" }
        return {"ok": false, "err": em}
    }
    if src == nil {
        return {"ok": false, "err": "failed to read (nil)"}
    }

    var raw = _cache_hash_string(src, config)
    var incs = _cache_scan_includes_from_src(src, full_path)
    var r2 = _cache_scan_direct_imports_from_src(src, full_path, config)
    if r2["ok"] != true {
        return {"ok": false, "err": r2["err"]}
    }
    var imps_self = r2["imports"]
    if imps_self == nil { imps_self = [] }

    var next = {
        "mtime_ns": mtime,
        "size": size,
        "raw": raw,
        "includes": incs,
        "imports_self": imps_self,
        // Derived fields (recomputed when include children change).
        "hash": "",
        "imports": []
    }
    cache_map[full_path] = next
    scan_state["dirty"] = true
    return {"ok": true, "rec": next}
}

fn _cache_hash_includes_closure_stat(full_path, build_cfg, scan_state, include_stack) {
    // Compute a stable hash for a file + its include closure using:
    // - file stat (mtime/size) for cache validation
    // - cached "raw" content hashes and cached include edge lists
    //
    // This avoids reading unchanged files during build-cache key computation.
    var memo = scan_state["memo_hash"]
    if memo == nil { memo = {} ; scan_state["memo_hash"] = memo }
    if memo[full_path] != nil { return memo[full_path] }

    // Include-cycle check (keep it deterministic and safe).
    if include_stack != nil {
        var si = 0
        while si < oren_list_len(include_stack) {
            if include_stack[si] == full_path {
                return "include_cycle:" + full_path
            }
            si = si + 1
        }
    }
    var next_stack = []
    if include_stack != nil {
        var ci = 0
        while ci < oren_list_len(include_stack) { oren_list_push(next_stack, include_stack[ci]); ci = ci + 1 }
    }
    oren_list_push(next_stack, full_path)

    var rr = _scan_cache_refresh_file_record(full_path, build_cfg, scan_state)
    if rr["ok"] != true {
        var em = rr["err"]
        if em == nil { em = "failed" }
        return "include_err:" + em
    }
    var rec = rr["rec"]
    var raw = rec["raw"]
    if raw == nil { raw = "" }
    var incs = rec["includes"]
    if incs == nil { incs = [] }

    var h1 = 1469598103934665603
    var h2 = 1099511628211
    var mm = _cache_mix_fingerprint(h1, h2, "F:")
    h1 = mm["h1"]; h2 = mm["h2"]
    mm = _cache_mix_fingerprint(h1, h2, raw)
    h1 = mm["h1"]; h2 = mm["h2"]

    var ii = 0
    while ii < oren_list_len(incs) {
        var incp = incs[ii]
        if incp != nil && incp != "" {
            var child_hash = _cache_hash_includes_closure_stat(incp, build_cfg, scan_state, next_stack)
            mm = _cache_mix_fingerprint(h1, h2, "\nI:")
            h1 = mm["h1"]; h2 = mm["h2"]
            mm = _cache_mix_fingerprint(h1, h2, incp)
            h1 = mm["h1"]; h2 = mm["h2"]
            mm = _cache_mix_fingerprint(h1, h2, "=")
            h1 = mm["h1"]; h2 = mm["h2"]
            mm = _cache_mix_fingerprint(h1, h2, child_hash)
            h1 = mm["h1"]; h2 = mm["h2"]
        }
        ii = ii + 1
    }

    var out = "v2_" + oren_int_to_string(_mask63(h1)) + "_" + oren_int_to_string(_mask63(h2))
    memo[full_path] = out
    return out
}

fn _cache_scan_imports_for_file_cached(full_path, config, scan_state) {
    // scan_state:
    // - "dir": cache dir
    // - "cache": map(path -> record)
    // - "dirty": bool
    //
    // Returns {"ok":bool, "imports":[...], "src_hash":hex, "err":string}
    if scan_state == nil { return _cache_scan_imports_for_file(full_path, config) }
    var cache_map = scan_state["cache"]
    if cache_map == nil { cache_map = {} ; scan_state["cache"] = cache_map }
    var inprog = scan_state["in_progress"]
    if inprog == nil { inprog = {} ; scan_state["in_progress"] = inprog }

    // Include recursion can create cycles (accidental or malicious). Guard against infinite recursion.
    if inprog[full_path] == true {
        return {"ok": false, "err": "include cycle detected: " + full_path}
    }
    inprog[full_path] = true

    // Ensure we have an up-to-date record for this file (reads only when mtime/size changed).
    var rr = _scan_cache_refresh_file_record(full_path, config, scan_state)
    if rr["ok"] != true {
        inprog[full_path] = nil
        return {"ok": false, "err": rr["err"]}
    }
    var rec = rr["rec"]

    // Compute include-closure hash:
    // - deterministic builds: sha256(expanded source) (slow but reproducible)
    // - rolling builds: stat-aware fingerprint based on cached raw hashes and include edges
    var sh = ""
    if _cache_deterministic(config) || _cache_force_sha256(config) {
        var memo = scan_state["memo"]
        if memo == nil { memo = {} ; scan_state["memo"] = memo }
        sh = _cache_hash_includes_closure(full_path, config, memo, [])
    } else {
        sh = _cache_hash_includes_closure_stat(full_path, config, scan_state, [])
    }

    // Cache hit: the merged imports were computed for the same closure hash.
    if rec != nil && rec["hash"] == sh && rec["imports"] != nil {
        inprog[full_path] = nil
        return {"ok": true, "imports": rec["imports"], "src_hash": sh}
    }

    // Recompute merged imports using cached direct imports + include-imports.
    var imports = []
    var seen_imp = {}
    var self_imps = rec["imports_self"]
    if self_imps == nil { self_imps = [] }
    var si = 0
    while si < oren_list_len(self_imps) {
        var dep0 = self_imps[si]
        if dep0 != nil && dep0 != "" && seen_imp[dep0] != true {
            seen_imp[dep0] = true
            oren_list_push(imports, dep0)
        }
        si = si + 1
    }

    var incs2 = rec["includes"]
    if incs2 == nil { incs2 = [] }
    var ii2 = 0
    while ii2 < oren_list_len(incs2) {
        var ip = incs2[ii2]
        if ip != nil && ip != "" {
            var r2 = _cache_scan_imports_for_file_cached(ip, config, scan_state)
            if r2["ok"] == true {
                var im2 = r2["imports"]
                if im2 != nil {
                    var jj = 0
                    while jj < oren_list_len(im2) {
                        var dep = im2[jj]
                        if dep != nil && dep != "" && seen_imp[dep] != true {
                            seen_imp[dep] = true
                            oren_list_push(imports, dep)
                        }
                        jj = jj + 1
                    }
                }
            } else {
                inprog[full_path] = nil
                return {"ok": false, "err": r2["err"]}
            }
        }
        ii2 = ii2 + 1
    }

    rec["hash"] = sh
    rec["imports"] = imports
    cache_map[full_path] = rec
    scan_state["dirty"] = true
    inprog[full_path] = nil
    return {"ok": true, "imports": imports, "src_hash": sh}
}

fn _cache_hash_expanded_includes(path, build_cfg, scan_state) {
    // Hash source including `// @include` closure.
    //
    // This is used for injected sources that are not necessarily visible through the
    // user's `import` graph (e.g. the native runtime bundle injected by native backends).
    //
    // Perf:
    // - deterministic builds keep sha256(expanded) as the cache contract
    // - rolling builds use stat-aware closure hashing to avoid re-reading unchanged files
    var h = ""
    if _cache_deterministic(build_cfg) || _cache_force_sha256(build_cfg) {
        var memo = {}
        h = _cache_hash_includes_closure(path, build_cfg, memo, [])
    } else {
        // Best-effort: if scan_state wasn't provided, use a temporary one.
        var ss = scan_state
        if ss == nil {
            var cache_dir = _cache_default_dir()
            if build_cfg != nil && build_cfg["cache_dir"] != nil { cache_dir = build_cfg["cache_dir"] }
            ss = {"dir": cache_dir, "cache": _scan_cache_load(cache_dir), "dirty": false}
        }
        h = _cache_hash_includes_closure_stat(path, build_cfg, ss, [])
    }
    if starts_with(h, "include_err:") || starts_with(h, "include_cycle:") || h == "read_err" {
        return {"ok": false, "err": h}
    }
    return {"ok": true, "hash": h}
}

fn _cache_scan_c_includes_from_src(src, full_path) {
    // Scan `#include "runtime/..."` and `#include "runtime_buf/..."` in C sources.
    var out = []
    if src == nil { return out }
    var n = oren_string_len(src)
    var i = 0
    while i + 10 < n {
        if _cache_byte_at(src, i) == 35 && _cache_byte_at(src, i + 1) == 105 &&
           _cache_byte_at(src, i + 2) == 110 && _cache_byte_at(src, i + 3) == 99 &&
           _cache_byte_at(src, i + 4) == 108 && _cache_byte_at(src, i + 5) == 117 &&
           _cache_byte_at(src, i + 6) == 100 && _cache_byte_at(src, i + 7) == 101 &&
           _cache_byte_at(src, i + 8) == 32 && _cache_byte_at(src, i + 9) == 34 {
            var j = i + 10
            var start = j
            while j < n && _cache_byte_at(src, j) != 34 && _cache_byte_at(src, j) != 10 && _cache_byte_at(src, j) != 13 {
                j = j + 1
            }
            if j < n && _cache_byte_at(src, j) == 34 {
                var inc = oren_string_slice(src, start, j)
                if starts_with(inc, "runtime/") || starts_with(inc, "runtime_buf/") {
                    var base = dirname(full_path)
                    var full = path_norm(base + "/" + inc)
                    oren_list_push(out, full)
                }
            }
            i = j + 1
            continue
        }
        i = i + 1
    }
    return out
}

fn _cache_hash_c_runtime_inputs(inputs, build_cfg, scan_state) {
    var seen = {}
    var stack = ["lib/runtime.c", "lib/runtime_buf.c", "lib/runtime.h"]
    var sp = 3
    while sp > 0 {
        sp = sp - 1
        var path = stack[sp]
        stack[sp] = nil
        if path == nil || path == "" { continue }
        if seen[path] == true { continue }
        seen[path] = true
        var src = oren_read_file(path)
        if oren_is_err(src) {
            return {"ok": false, "err": "failed to read runtime input: " + path}
        }
        inputs["RUNTIME_C:" + path] = _cache_hash_string(src, build_cfg)
        var incs = _cache_scan_c_includes_from_src(src, path)
        var i = 0
        while i < oren_list_len(incs) {
            var inc_path = incs[i]
            if inc_path != nil && inc_path != "" {
                stack[sp] = inc_path
                sp = sp + 1
            }
            i = i + 1
        }
    }
    return {"ok": true}
}

fn cache_compute_key_build(entry_path, build_cfg) {
    // build_cfg fields used (expected):
    // - backend, target, arch, cc, emit_c, no_gc, capsule, cap_domains, call_depth_max
    // - stdlib_mode, stdlib_obc, link_obc, link_libs, enable_python, debug_mode, shared_lib
    // - plus a curated native env surface captured below for build-affecting codegen toggles
    //
    // Returns {"ok":bool, "key":hex, "err":string, "inputs":map(path->hash)}
    var tv = oren_env("OREN_TRACE_BUILD")
    var trace_build = false
    if tv != nil && tv != "" && tv != "0" && tv != "false" { trace_build = true }

    var visited = {}
    var inputs = {} // path/spec -> sha256
    // Use an explicit stack pointer to avoid O(n^2) copying behavior.
    var stack = [entry_path]
    var sp = 1

    // Persistent scan cache (performance only): stored under the selected build cache dir.
    var cache_dir = nil
    if build_cfg != nil && build_cfg["cache_dir"] != nil { cache_dir = build_cfg["cache_dir"] }
    if cache_dir == nil || cache_dir == "" { cache_dir = _cache_default_dir() }
    var scan_state = {"dir": cache_dir, "cache": _scan_cache_load(cache_dir), "dirty": false}

    var t0 = 0
    if trace_build { t0 = oren_time_now_ns() }

    while sp > 0 {
        // pop
        sp = sp - 1
        var pth = stack[sp]
        stack[sp] = nil

        if pth == nil || pth == "" { continue }
        if visited[pth] == true { continue }
        visited[pth] = true

        // External std spec markers: hash the spec string itself.
        if starts_with(pth, "std:") || starts_with(pth, "std/") {
            inputs[pth] = _cache_hash_string(pth, build_cfg)
            continue
        }

        var r = _cache_scan_imports_for_file_cached(pth, build_cfg, scan_state)
        if r["ok"] != true {
            return {"ok": false, "err": r["err"]}
        }
        inputs[pth] = r["src_hash"]
        var imps = r["imports"]
        if imps == nil { imps = [] }
        var ii = 0
        while ii < oren_list_len(imps) {
            // push onto stack (reuse capacity where possible)
            if sp < oren_list_len(stack) { stack[sp] = imps[ii] }
            else { oren_list_push(stack, imps[ii]) }
            sp = sp + 1
            ii = ii + 1
        }
    }
    if trace_build {
        var t1 = oren_time_now_ns()
        var dt_scan = (t1 - t0) / 1000000
        var n_inputs = 0
        for k_scan in inputs { n_inputs = n_inputs + 1 }
        var n_recs = 0
        var cm = scan_state["cache"]
        if cm != nil {
            for k_rec in cm { n_recs = n_recs + 1 }
        }
        print("[cache] dep_scan +" + oren_int_to_string(dt_scan) + "ms inputs=" + oren_int_to_string(n_inputs) + " scan_cache_recs=" + oren_int_to_string(n_recs))
    }

    // Include stdlib `.obc` and linked `.obc` libraries (bytecode mode) into the key.
        if build_cfg != nil && build_cfg["stdlib_mode"] == "obc" {
        var std_obc = build_cfg["stdlib_obc"]
        if std_obc != nil && std_obc != "" {
            // OBC blobs can be large; use u8_buf to keep memory bounded.
            var bs = oren_read_u8_buf(std_obc)
            if oren_is_err(bs) {
                return {"ok": false, "err": "failed to read stdlib obc: " + std_obc}
            }
            inputs["OBC:" + std_obc] = _cache_hash_u8_buf(bs, build_cfg)
        }
    }
    if build_cfg != nil && build_cfg["link_obc"] != nil {
        var li = 0
        while li < oren_list_len(build_cfg["link_obc"]) {
            var lp = build_cfg["link_obc"][li]
            if lp != nil && lp != "" {
                // OBC blobs can be large; use u8_buf to keep memory bounded.
                var bs2 = oren_read_u8_buf(lp)
                if oren_is_err(bs2) {
                    return {"ok": false, "err": "failed to read link obc: " + lp}
                }
                inputs["OBC:" + lp] = _cache_hash_u8_buf(bs2, build_cfg)
            }
            li = li + 1
        }
    }

    // Native backend runtime injection:
    //
    // The native backends inject `lib/runtime_native.oren` into the compiled program (Tier‑1),
    // but this file is not necessarily reachable from the user's `import` graph.
    //
    // Without hashing the injected runtime bundle, changing runtime source files would not
    // invalidate the build cache (observed as stale Windows x64 artifacts).
    if build_cfg != nil && build_cfg["backend"] == "native" {
        var t_rt0 = 0
        if trace_build { t_rt0 = oren_time_now_ns() }
        var rt_path = "lib/runtime_native.oren"
        if build_cfg["capsule"] == true {
            rt_path = "lib/runtime_native_capsule.oren"
        } else {
            // Optional: reduced runtime profile for native self-hosting throughput.
            // Must be part of the build cache key; otherwise switching the profile could
            // incorrectly reuse cached artifacts built with a different injected runtime.
            var prof = oren_env("OREN_NATIVE_RUNTIME_PROFILE")
            if prof == "core" || prof == "minimal" {
                rt_path = "lib/runtime_native_core.oren"
            }
        }
        var rh = _cache_hash_expanded_includes(rt_path, build_cfg, scan_state)
        if rh["ok"] != true {
            return {"ok": false, "err": "failed to read injected runtime: " + rt_path + " (" + rh["err"] + ")"}
        }
        inputs["RUNTIME:" + rt_path] = rh["hash"]
        if trace_build {
            var dt_rt = (oren_time_now_ns() - t_rt0) / 1000000
            print("[cache] injected_runtime_hash +" + oren_int_to_string(dt_rt) + "ms hash=" + inputs["RUNTIME:" + rt_path])
        }
    }

    var rr_native_env_inputs = _cache_hash_native_override_env_inputs(inputs, build_cfg, scan_state)
    if rr_native_env_inputs["ok"] != true {
        return {"ok": false, "err": rr_native_env_inputs["err"]}
    }

    if build_cfg != nil && build_cfg["backend"] == "c" {
        var rr_c = _cache_hash_c_runtime_inputs(inputs, build_cfg, scan_state)
        if rr_c["ok"] != true {
            return {"ok": false, "err": rr_c["err"]}
        }
    }

    // Persist the scan cache after *all* scan-state consumers have run.
    // This includes native runtime injection hashing (`_cache_hash_expanded_includes`),
    // which can touch a large include-closure; saving too early forces every build to
    // rescan+rehash that closure from scratch.
    if scan_state["dirty"] == true {
        var t_save0 = 0
        if trace_build { t_save0 = oren_time_now_ns() }
        _scan_cache_save(cache_dir, scan_state["cache"])
        if trace_build {
            var dt = (oren_time_now_ns() - t_save0) / 1000000
            var n_recs2 = 0
            var cm2 = scan_state["cache"]
            if cm2 != nil {
                for k_rec2 in cm2 { n_recs2 = n_recs2 + 1 }
            }
            print("[cache] scan_cache save +" + oren_int_to_string(dt) + "ms recs=" + oren_int_to_string(n_recs2))
        }
    }


    var t_sig0 = 0
    if trace_build { t_sig0 = oren_time_now_ns() }
    var compiler_sig = _cache_compiler_sig(build_cfg)
    if trace_build {
        var dt_sig = (oren_time_now_ns() - t_sig0) / 1000000
        print("[cache] compiler_sig +" + oren_int_to_string(dt_sig) + "ms sig=" + compiler_sig)
    }

    // Build a stable key string.
    var s = "OREN_BUILD_CACHE_V" + oren_int_to_string(BUILD_CACHE_SCHEMA) + "\n"
    s = s + "compiler=" + compiler_sig + "\n"
    if build_cfg != nil {
        s = s + "backend=" + build_cfg["backend"] + "\n"
        s = s + "target=" + build_cfg["target"] + "\n"
        s = s + "arch=" + build_cfg["arch"] + "\n"
        s = s + "cc=" + build_cfg["cc"] + "\n"
        var cs = build_cfg["codesign_id"]
        if cs == nil { cs = "" }
        s = s + "codesign_id=" + cs + "\n"
        s = s + "emit_c=" + oren_int_to_string(build_cfg["emit_c"]) + "\n"
        s = s + "no_gc=" + oren_int_to_string(build_cfg["no_gc"]) + "\n"
        s = s + "enable_python=" + oren_int_to_string(build_cfg["enable_python"]) + "\n"
        s = s + "debug_mode=" + oren_int_to_string(build_cfg["debug_mode"]) + "\n"
        s = s + "shared_lib=" + oren_int_to_string(build_cfg["shared_lib"]) + "\n"
        s = s + "call_depth_max=" + oren_int_to_string(build_cfg["call_depth_max"]) + "\n"
        s = s + "capsule=" + oren_int_to_string(build_cfg["capsule"]) + "\n"
        s = s + "strict_yield_lowering_v0=" + oren_int_to_string(build_cfg["strict_yield_lowering_v0"]) + "\n"
        var native_gas = build_cfg["native_gas_accounting"]
        if native_gas == nil { native_gas = "loop" }
        s = s + "native_gas_accounting=" + native_gas + "\n"
        // Runtime injection toggle (native backend).
        //
        // The injected runtime's content is hashed via `inputs["RUNTIME:..."]` above; this flag
        // is included as a readable key field so cache debugging is straightforward.
        var inject_runtime_k = 0
        if build_cfg["backend"] == "native" { inject_runtime_k = 1 }
        s = s + "inject_runtime=" + oren_int_to_string(inject_runtime_k) + "\n"
        // cap domains: stable, sorted
        var cds = build_cfg["cap_domains"]
        if cds == nil { cds = [] }
        cds = _cache_sort_strings(cds)
        s = s + "cap_domains="
        var ci = 0
        while ci < oren_list_len(cds) {
            if ci != 0 { s = s + "," }
            s = s + cds[ci]
            ci = ci + 1
        }
        s = s + "\n"
        s = s + "stdlib_mode=" + build_cfg["stdlib_mode"] + "\n"
        if build_cfg["backend"] == "native" {
            var env_names = _cache_native_build_env_names(build_cfg)
            var ei = 0
            while ei < oren_list_len(env_names) {
                s = _cache_append_env_key_field(s, env_names[ei])
                ei = ei + 1
            }
        }
    }

    // Input file hashes, stable sorted by key.
    var keys = []
    for k in inputs {
        oren_list_push(keys, k)
    }
    keys = _cache_sort_strings(keys)
    var ki = 0
    while ki < oren_list_len(keys) {
        var k2 = keys[ki]
        s = s + "in " + k2 + " " + inputs[k2] + "\n"
        ki = ki + 1
    }
    var key = _cache_hash_string(s, build_cfg)
    return {"ok": true, "key": key, "inputs": inputs}
}

fn cache_artifact_path(cache_dir, key) {
    return path_norm(cache_dir + "/" + key + "/artifact.bin")
}

fn cache_try_restore_artifact(cache_dir, key, out_path, chmod_mode) {
    // Returns {"hit":bool, "bytes":list<int>|u8_buf, "err":string}
    var p = cache_artifact_path(cache_dir, key)
    if !file_exists(p) {
        return {"hit": false}
    }
    // Artifacts can be large; use u8_buf to keep memory bounded.
    var bs = oren_read_u8_buf(p)
    if oren_is_err(bs) {
        return {"hit": false, "err": "cache read failed: " + p}
    }
    ensure_dir(dirname(out_path))

    // IMPORTANT (macOS): writing a signed Mach-O binary "in place" can leave the kernel with
    // stale code-sign validation state for that vnode. This can manifest as "Killed: 9
    // (code signing error)" even when `codesign --verify` passes on disk.
    //
    // Avoid in-place overwrites by:
    // 1) writing to a temp file, then
    // 2) atomic rename into place.
    //
    // This also improves robustness for concurrent readers (they either see the old artifact
    // or the new one, never a partially-written file).
    var tmp = out_path + ".cachetmp." + key
    var w = oren_write_bytes(tmp, bs)
    if oren_is_err(w) {
        return {"hit": false, "err": "cache write failed: " + tmp}
    }
    if chmod_mode != nil && chmod_mode > 0 {
        // Best-effort: chmod may not exist on all targets; ignore failures.
        oren_chmod(tmp, chmod_mode)
    }
    var rr = oren_rename(tmp, out_path)
    if rr != 0 {
        // Fallback: best-effort direct write if rename isn't available on this platform.
        // Leave tmp behind for debugging; it will be overwritten on the next attempt.
        var w2 = oren_write_bytes(out_path, bs)
        if oren_is_err(w2) {
            return {"hit": false, "err": "cache write failed: " + out_path}
        }
        if chmod_mode != nil && chmod_mode > 0 {
            oren_chmod(out_path, chmod_mode)
        }
    }
    return {"hit": true, "bytes": bs}
}

fn cache_store_artifact(cache_dir, key, bytes) {
    // Best-effort: cache failures must not fail the build.
    if cache_dir == nil || cache_dir == "" { return nil }
    if key == nil || key == "" { return nil }
    if bytes == nil { return nil }
    var bundle = path_norm(cache_dir + "/" + key)
    ensure_dir(bundle)
    var p = cache_artifact_path(cache_dir, key)
    var w = oren_write_bytes(p, bytes)
    if oren_is_err(w) { return nil }
    return nil
}

fn cache_clean_dir(cache_dir) {
    if cache_dir == nil || cache_dir == "" { cache_dir = _cache_default_dir() }
    // Best-effort: cache failures must not fail the build.
    var rc = oren_rm_rf(cache_dir)
    if rc < 0 {
        print("WARN: cache clean failed (rc=" + oren_int_to_string(rc) + "): " + cache_dir)
        return nil
    }
    print("Cleaned cache dir: " + cache_dir)
    return nil
}
