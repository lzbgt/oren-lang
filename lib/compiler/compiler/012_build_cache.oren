// Build cache (rolling).
//
// Goal: make `oren build` behave like a modern compiler:
// - caching enabled by default
// - reproducible cache keys (content-addressed)
// - safe invalidation when compiler binary changes
//
// Current scope (v0):
// - caches the *final artifact* only (native/c/bytecode) keyed by:
//   - compiler executable sha256 (argv[0] when available)
//   - build options that affect output
//   - transitive source closure sha256 (imports + @include expansion)
//
// This intentionally does not attempt fine-grained incremental compilation yet.

import token "token.oren"

fn _cache_sort_strings(xs) {
    // Insertion sort (small lists expected).
    if xs == nil { return [] }
    var i = 1
    while i < oren_list_len(xs) {
        var key = xs[i]
        var j = i - 1
        while j >= 0 && xs[j] > key {
            xs[j + 1] = xs[j]
            j = j - 1
        }
        xs[j + 1] = key
        i = i + 1
    }
    return xs
}

fn _cache_default_dir() {
    // Default (rolling):
    // - keep build cache *repo-local* so it is predictable for humans + AI agents
    // - override explicitly via env OREN_CACHE_DIR or CLI --cache-dir
    //
    // Priority:
    // 1) env OREN_CACHE_DIR
    // 2) build/cache (repo-local default)
    var d = oren_env("OREN_CACHE_DIR")
    if d != nil && d != "" { return path_norm(d) }
    return path_norm("build/cache")
}

fn _cache_compiler_sig() {
    // Best-effort: hash argv[0] bytes so cache invalidates when the compiler binary changes.
    // When argv[0] is not a file path, fall back to OREN_VERSION (weaker).
    var args = oren_args()
    if args != nil && oren_list_len(args) > 0 {
        var exe = args[0]
        if exe != nil && exe != "" && file_exists(exe) {
            // Prefer u8_buf to avoid boxing each byte as an int (can blow up memory for big binaries).
            var bs = oren_read_u8_buf(exe)
            if !oren_is_err(bs) {
                return _sha256_hex(bs)
            }
        }
    }
    return OREN_VERSION
}

fn _cache_enabled(seen, opts) {
    // Enabled by default; disable via:
    // - `--no-cache`
    // - env `OREN_NO_CACHE` (wired via std:argparse env defaults for the `oren` CLI)
    //
    // We intentionally rely on parsed opts here (so env "0" can re-enable caching).
    if opts != nil && opts["no-cache"] == true { return false }
    return true
}

fn _cache_dir_from_opts(seen, opts) {
    var d = _cache_default_dir()
    if seen != nil && seen["cache-dir"] == true {
        var v = opts["cache-dir"]
        if v != nil && v != "" { d = path_norm(v) }
    }
    return d
}

fn _cache_scan_imports_for_file(full_path, config) {
    // Returns {"ok":bool, "imports":[full,...], "src_hash":hex, "err":string}
    //
    // Performance note:
    // - this function is called for every module reachable from the entrypoint.
    // - avoid parsing the full program AST; we only need top-level `import` statements.
    // - use token scanning via the lexer for a much cheaper dependency walk.
    var rr = expand_includes_file_result(full_path, [])
    if rr["ok"] != true {
        var msg = rr["err"]
        if msg == nil { msg = "failed to read" }
        return {"ok": false, "err": msg}
    }
    var src = rr["src"]
    var sh = _sha256_hex_string(src)

    var l = lexer.new_lexer(src)
    l["file"] = full_path
    var imports = []
    var base_dir = dirname(full_path)
    var tok = lexer.next_token(l)
    while tok != nil && tok["type"] != token.TOK_EOF {
        if tok["type"] == token.TOK_IMPORT {
            // Grammar: import <ident> <string> [;]
            var tname = lexer.next_token(l)
            if tname == nil || tname["type"] != token.TOK_IDENT {
                return {"ok": false, "err": "cache scan: invalid import (expected identifier after import) in " + full_path}
            }
            var tpath = lexer.next_token(l)
            if tpath == nil || tpath["type"] != token.TOK_STRING {
                return {"ok": false, "err": "cache scan: invalid import (expected string path) in " + full_path}
            }
            var imp_path = tpath["literal"]
            if imp_path != nil {
                // In stdlib `.obc` mode, treat std imports as external (do not walk sources).
                if config != nil && config["stdlib_mode"] == "obc" {
                    if starts_with(imp_path, "std:") || starts_with(imp_path, "std/") {
                        // Record the spec itself as a dependency marker.
                        oren_list_push(imports, imp_path)
                    } else {
                        var full = resolve_import_path(base_dir, imp_path)
                        oren_list_push(imports, full)
                    }
                } else {
                    var full2 = resolve_import_path(base_dir, imp_path)
                    oren_list_push(imports, full2)
                }
            }
        }
        tok = lexer.next_token(l)
    }
    return {"ok": true, "imports": imports, "src_hash": sh}
}

fn _scan_cache_file(cache_dir) {
    if cache_dir == nil || cache_dir == "" { cache_dir = _cache_default_dir() }
    return path_norm(cache_dir + "/scan_cache_v1.txt")
}

fn _scan_cache_split_lines(s) {
    if s == nil { return [] }
    var bs = oren_bytes_from_string(s)
    var out = []
    var cur = []
    var i = 0
    while i < oren_list_len(bs) {
        var b = bs[i]
        if b == 10 { // \n
            oren_list_push(out, oren_string_from_bytes(cur))
            cur = []
            i = i + 1
            continue
        }
        if b == 13 { // \r
            oren_list_push(out, oren_string_from_bytes(cur))
            cur = []
            // consume optional \n
            if i + 1 < oren_list_len(bs) && bs[i + 1] == 10 { i = i + 2 } else { i = i + 1 }
            continue
        }
        oren_list_push(cur, b)
        i = i + 1
    }
    // final line
    oren_list_push(out, oren_string_from_bytes(cur))
    return out
}

fn _scan_cache_parse_u32(s) {
    if s == nil { return 0 }
    var bs = oren_bytes_from_string(s)
    var n = 0
    var i = 0
    while i < oren_list_len(bs) {
        var b = bs[i]
        if b < 48 || b > 57 { return 0 }
        n = n * 10 + (b - 48)
        i = i + 1
    }
    if n < 0 { n = 0 }
    return n
}

fn _scan_cache_load(cache_dir) {
    // Returns a map: path -> {"hash":hex, "imports":[...]}
    var p = _scan_cache_file(cache_dir)
    if !file_exists(p) { return {} }
    var s = oren_read_file(p)
    if s == nil { return {} }
    var lines = _scan_cache_split_lines(s)
    if lines == nil || oren_list_len(lines) == 0 { return {} }
    if lines[0] != "OREN_SCAN_CACHE_V1" { return {} }

    var out = {}
    var i = 1
    while i + 2 < oren_list_len(lines) {
        var path = lines[i]
        var hash = lines[i + 1]
        var nline = lines[i + 2]
        i = i + 3
        if path == nil || path == "" { continue }
        if hash == nil { hash = "" }
        var n = _scan_cache_parse_u32(nline)
        var imps = []
        var j = 0
        while j < n && i < oren_list_len(lines) {
            oren_list_push(imps, lines[i])
            i = i + 1
            j = j + 1
        }
        out[path] = {"hash": hash, "imports": imps}
    }
    return out
}

fn _scan_cache_save(cache_dir, cache_map) {
    var p = _scan_cache_file(cache_dir)
    ensure_dir(dirname(p))
    var paths = []
    for k in cache_map { oren_list_push(paths, k) }
    paths = _cache_sort_strings(paths)
    var out = "OREN_SCAN_CACHE_V1\n"
    var i = 0
    while i < oren_list_len(paths) {
        var path = paths[i]
        var rec = cache_map[path]
        if rec == nil { i = i + 1; continue }
        var hh = rec["hash"]
        if hh == nil { hh = "" }
        var imps = rec["imports"]
        if imps == nil { imps = [] }
        out = out + path + "\n"
        out = out + hh + "\n"
        out = out + oren_int_to_string(oren_list_len(imps)) + "\n"
        var j = 0
        while j < oren_list_len(imps) {
            var imp = imps[j]
            if imp == nil { imp = "" }
            out = out + imp + "\n"
            j = j + 1
        }
        i = i + 1
    }
    oren_write_file(p, out)
    return nil
}

fn _cache_scan_imports_for_file_cached(full_path, config, scan_state) {
    // scan_state:
    // - "dir": cache dir
    // - "cache": map(path -> {"hash":hex, "imports":[...]})
    // - "dirty": bool
    //
    // Returns {"ok":bool, "imports":[...], "src_hash":hex, "err":string}
    if scan_state == nil { return _cache_scan_imports_for_file(full_path, config) }
    var cache_dir = scan_state["dir"]
    var cache_map = scan_state["cache"]
    if cache_map == nil { cache_map = {} ; scan_state["cache"] = cache_map }

    // Compute expanded-source hash (still required for correctness).
    var rr = expand_includes_file_result(full_path, [])
    if rr["ok"] != true {
        var msg = rr["err"]
        if msg == nil { msg = "failed to read" }
        return {"ok": false, "err": msg}
    }
    var src = rr["src"]
    var sh = _sha256_hex_string(src)

    // Cache hit: reuse imports without token scanning.
    var rec = cache_map[full_path]
    if rec != nil && rec["hash"] == sh {
        var imps = rec["imports"]
        if imps == nil { imps = [] }
        return {"ok": true, "imports": imps, "src_hash": sh}
    }

    // Miss: token scan and update cache.
    var l = lexer.new_lexer(src)
    l["file"] = full_path
    var imports = []
    var base_dir = dirname(full_path)
    var tok = lexer.next_token(l)
    while tok != nil && tok["type"] != token.TOK_EOF {
        if tok["type"] == token.TOK_IMPORT {
            var tname = lexer.next_token(l)
            if tname == nil || tname["type"] != token.TOK_IDENT {
                return {"ok": false, "err": "cache scan: invalid import (expected identifier after import) in " + full_path}
            }
            var tpath = lexer.next_token(l)
            if tpath == nil || tpath["type"] != token.TOK_STRING {
                return {"ok": false, "err": "cache scan: invalid import (expected string path) in " + full_path}
            }
            var imp_path = tpath["literal"]
            if imp_path != nil {
                if config != nil && config["stdlib_mode"] == "obc" {
                    if starts_with(imp_path, "std:") || starts_with(imp_path, "std/") {
                        oren_list_push(imports, imp_path)
                    } else {
                        oren_list_push(imports, resolve_import_path(base_dir, imp_path))
                    }
                } else {
                    oren_list_push(imports, resolve_import_path(base_dir, imp_path))
                }
            }
        }
        tok = lexer.next_token(l)
    }

    cache_map[full_path] = {"hash": sh, "imports": imports}
    scan_state["dirty"] = true
    return {"ok": true, "imports": imports, "src_hash": sh}
}

fn _cache_hash_expanded_includes(path) {
    // Hash the fully expanded source (including `// @include` expansion).
    //
    // This is used for injected sources that are not necessarily visible through the
    // user's `import` graph (e.g. the native runtime bundle injected by native backends).
    var rr = expand_includes_file_result(path, [])
    if rr["ok"] != true {
        var msg = rr["err"]
        if msg == nil { msg = "failed to read" }
        return {"ok": false, "err": msg}
    }
    var src = rr["src"]
    return {"ok": true, "hash": _sha256_hex_string(src)}
}

fn cache_compute_key_build(entry_path, build_cfg) {
    // build_cfg fields used (expected):
    // - backend, target, arch, cc, emit_c, no_gc, capsule, cap_domains, call_depth_max
    // - stdlib_mode, stdlib_obc, link_obc, link_libs, enable_python, debug_mode, shared_lib
    //
    // Returns {"ok":bool, "key":hex, "err":string, "inputs":map(path->hash)}
    var visited = {}
    var inputs = {} // path/spec -> sha256
    // Use an explicit stack pointer to avoid O(n^2) copying behavior.
    var stack = [entry_path]
    var sp = 1

    // Persistent scan cache (performance only): stored under the selected build cache dir.
    var cache_dir = nil
    if build_cfg != nil && build_cfg["cache_dir"] != nil { cache_dir = build_cfg["cache_dir"] }
    if cache_dir == nil || cache_dir == "" { cache_dir = _cache_default_dir() }
    var scan_state = {"dir": cache_dir, "cache": _scan_cache_load(cache_dir), "dirty": false}

    while sp > 0 {
        // pop
        sp = sp - 1
        var pth = stack[sp]
        stack[sp] = nil

        if pth == nil || pth == "" { continue }
        if visited[pth] == true { continue }
        visited[pth] = true

        // External std spec markers: hash the spec string itself.
        if starts_with(pth, "std:") || starts_with(pth, "std/") {
            inputs[pth] = _sha256_hex_string(pth)
            continue
        }

        var r = _cache_scan_imports_for_file_cached(pth, build_cfg, scan_state)
        if r["ok"] != true {
            return {"ok": false, "err": r["err"]}
        }
        inputs[pth] = r["src_hash"]
        var imps = r["imports"]
        if imps == nil { imps = [] }
        var ii = 0
        while ii < oren_list_len(imps) {
            // push onto stack (reuse capacity where possible)
            if sp < oren_list_len(stack) { stack[sp] = imps[ii] }
            else { oren_list_push(stack, imps[ii]) }
            sp = sp + 1
            ii = ii + 1
        }
    }
    if scan_state["dirty"] == true {
        _scan_cache_save(cache_dir, scan_state["cache"])
    }

    // Include stdlib `.obc` and linked `.obc` libraries (bytecode mode) into the key.
    if build_cfg != nil && build_cfg["stdlib_mode"] == "obc" {
        var std_obc = build_cfg["stdlib_obc"]
        if std_obc != nil && std_obc != "" {
            // OBC blobs can be large; use u8_buf to keep memory bounded.
            var bs = oren_read_u8_buf(std_obc)
            if oren_is_err(bs) {
                return {"ok": false, "err": "failed to read stdlib obc: " + std_obc}
            }
            inputs["OBC:" + std_obc] = _sha256_hex(bs)
        }
    }
    if build_cfg != nil && build_cfg["link_obc"] != nil {
        var li = 0
        while li < oren_list_len(build_cfg["link_obc"]) {
            var lp = build_cfg["link_obc"][li]
            if lp != nil && lp != "" {
                // OBC blobs can be large; use u8_buf to keep memory bounded.
                var bs2 = oren_read_u8_buf(lp)
                if oren_is_err(bs2) {
                    return {"ok": false, "err": "failed to read link obc: " + lp}
                }
                inputs["OBC:" + lp] = _sha256_hex(bs2)
            }
            li = li + 1
        }
    }

    // Native backend runtime injection:
    //
    // The native backends inject `lib/runtime_native.oren` into the compiled program (Tier‑1),
    // but this file is not necessarily reachable from the user's `import` graph.
    //
    // Without hashing the injected runtime bundle, changing runtime source files would not
    // invalidate the build cache (observed as stale Windows x64 artifacts).
    if build_cfg != nil && build_cfg["backend"] == "native" {
        var rt_path = "lib/runtime_native.oren"
        var rh = _cache_hash_expanded_includes(rt_path)
        if rh["ok"] != true {
            return {"ok": false, "err": "failed to read injected runtime: " + rt_path + " (" + rh["err"] + ")"}
        }
        inputs["RUNTIME:" + rt_path] = rh["hash"]
    }


    var compiler_sig = _cache_compiler_sig()

    // Build a stable key string.
    var s = "OREN_BUILD_CACHE_V1\n"
    s = s + "compiler=" + compiler_sig + "\n"
    if build_cfg != nil {
        s = s + "backend=" + build_cfg["backend"] + "\n"
        s = s + "target=" + build_cfg["target"] + "\n"
        s = s + "arch=" + build_cfg["arch"] + "\n"
        s = s + "cc=" + build_cfg["cc"] + "\n"
        var cs = build_cfg["codesign_id"]
        if cs == nil { cs = "" }
        s = s + "codesign_id=" + cs + "\n"
        s = s + "emit_c=" + oren_int_to_string(build_cfg["emit_c"]) + "\n"
        s = s + "no_gc=" + oren_int_to_string(build_cfg["no_gc"]) + "\n"
        s = s + "enable_python=" + oren_int_to_string(build_cfg["enable_python"]) + "\n"
        s = s + "debug_mode=" + oren_int_to_string(build_cfg["debug_mode"]) + "\n"
        s = s + "shared_lib=" + oren_int_to_string(build_cfg["shared_lib"]) + "\n"
        s = s + "call_depth_max=" + oren_int_to_string(build_cfg["call_depth_max"]) + "\n"
        s = s + "capsule=" + oren_int_to_string(build_cfg["capsule"]) + "\n"
        // Runtime injection toggle (native backend).
        //
        // The injected runtime's content is hashed via `inputs["RUNTIME:..."]` above; this flag
        // is included as a readable key field so cache debugging is straightforward.
        var inject_runtime_k = 0
        if build_cfg["backend"] == "native" { inject_runtime_k = 1 }
        s = s + "inject_runtime=" + oren_int_to_string(inject_runtime_k) + "\n"
        // cap domains: stable, sorted
        var cds = build_cfg["cap_domains"]
        if cds == nil { cds = [] }
        cds = _cache_sort_strings(cds)
        s = s + "cap_domains="
        var ci = 0
        while ci < oren_list_len(cds) {
            if ci != 0 { s = s + "," }
            s = s + cds[ci]
            ci = ci + 1
        }
        s = s + "\n"
        s = s + "stdlib_mode=" + build_cfg["stdlib_mode"] + "\n"
    }

    // Input file hashes, stable sorted by key.
    var keys = []
    for k in inputs {
        oren_list_push(keys, k)
    }
    keys = _cache_sort_strings(keys)
    var ki = 0
    while ki < oren_list_len(keys) {
        var k2 = keys[ki]
        s = s + "in " + k2 + " " + inputs[k2] + "\n"
        ki = ki + 1
    }
    var key = _sha256_hex_string(s)
    return {"ok": true, "key": key, "inputs": inputs}
}

fn cache_artifact_path(cache_dir, key) {
    return path_norm(cache_dir + "/" + key + "/artifact.bin")
}

fn cache_try_restore_artifact(cache_dir, key, out_path, chmod_mode) {
    // Returns {"hit":bool, "bytes":list<int>|u8_buf, "err":string}
    var p = cache_artifact_path(cache_dir, key)
    if !file_exists(p) {
        return {"hit": false}
    }
    // Artifacts can be large; use u8_buf to keep memory bounded.
    var bs = oren_read_u8_buf(p)
    if oren_is_err(bs) {
        return {"hit": false, "err": "cache read failed: " + p}
    }
    ensure_dir(dirname(out_path))

    // IMPORTANT (macOS): writing a signed Mach-O binary "in place" can leave the kernel with
    // stale code-sign validation state for that vnode. This can manifest as "Killed: 9
    // (code signing error)" even when `codesign --verify` passes on disk.
    //
    // Avoid in-place overwrites by:
    // 1) writing to a temp file, then
    // 2) atomic rename into place.
    //
    // This also improves robustness for concurrent readers (they either see the old artifact
    // or the new one, never a partially-written file).
    var tmp = out_path + ".cachetmp." + key
    var w = oren_write_bytes(tmp, bs)
    if oren_is_err(w) {
        return {"hit": false, "err": "cache write failed: " + tmp}
    }
    if chmod_mode != nil && chmod_mode > 0 {
        // Best-effort: chmod may not exist on all targets; ignore failures.
        oren_chmod(tmp, chmod_mode)
    }
    var rr = oren_rename(tmp, out_path)
    if rr != 0 {
        // Fallback: best-effort direct write if rename isn't available on this platform.
        // Leave tmp behind for debugging; it will be overwritten on the next attempt.
        var w2 = oren_write_bytes(out_path, bs)
        if oren_is_err(w2) {
            return {"hit": false, "err": "cache write failed: " + out_path}
        }
        if chmod_mode != nil && chmod_mode > 0 {
            oren_chmod(out_path, chmod_mode)
        }
    }
    return {"hit": true, "bytes": bs}
}

fn cache_store_artifact(cache_dir, key, bytes) {
    // Best-effort: cache failures must not fail the build.
    if cache_dir == nil || cache_dir == "" { return nil }
    if key == nil || key == "" { return nil }
    if bytes == nil { return nil }
    var bundle = path_norm(cache_dir + "/" + key)
    ensure_dir(bundle)
    var p = cache_artifact_path(cache_dir, key)
    var w = oren_write_bytes(p, bytes)
    if oren_is_err(w) { return nil }
    return nil
}

fn cache_clean_dir(cache_dir) {
    if cache_dir == nil || cache_dir == "" { cache_dir = _cache_default_dir() }
    // Use shell for now (dev tooling).
    oren_system("rm -rf " + shell_quote(cache_dir))
    print("Cleaned cache dir: " + cache_dir)
    return nil
}
