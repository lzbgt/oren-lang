// Rolling version string (deterministic; do not embed build timestamps).
var OREN_VERSION = "0.0.0-rolling"

fn cli_add_build_opts(cmd, allow_emit_c, default_backend) {
    argparse.cmd_option(cmd, "--backend", nil, "string", default_backend, "Backend: c|native|bytecode")
    argparse.cmd_option(cmd, "--out", "-o", "string", "", "Output path (default: build/targets/<arch>-<os>/<backend>/<file> or build/targets/avm/bytecode/<file>.obc)")
    argparse.cmd_flag_env(cmd, "--no-cache", nil, "Disable build cache", "OREN_NO_CACHE")
    argparse.cmd_option_env(cmd, "--cache-dir", nil, "string", "", "Build cache directory", "OREN_CACHE_DIR")
    if allow_emit_c { argparse.cmd_flag(cmd, "--emit-c", nil, "(C backend) stop after generating <file.oren>.c") }
    argparse.cmd_option(cmd, "--cc", nil, "string", "cc", "(C backend) C compiler (default: cc; on Windows hosts, omit --cc to auto-detect cl.exe)")
    argparse.cmd_option(cmd, "--target", nil, "string", "auto", "(native backend) target OS: macos|linux|windows|auto (legacy; prefer --platform)")
    argparse.cmd_option(cmd, "--arch", nil, "string", "auto", "(native backend) target arch: arm64|x64|auto (legacy; prefer --platform)")
    argparse.cmd_option(cmd, "--platform", nil, "string", "", "(native backend) platform: arm64-macos|arm64-linux|x64-windows|x64-linux (preferred; overrides --arch/--target)")
    argparse.cmd_flag(cmd, "--disasm", nil, "(native backend) disassemble output via otool/objdump")
    argparse.cmd_flag(cmd, "--debug", nil, "(native backend) force-enable debug info for stack traces (default: on)")
    argparse.cmd_flag_env(cmd, "--no-debug", nil, "(native backend) disable debug info for stack traces", "OREN_NATIVE_NO_DEBUG")
    argparse.cmd_option(cmd, "--call-depth-max", nil, "int", 8192, "(native backend) max call depth before abort (runtime override: OREN_CALL_DEPTH_MAX)")
    argparse.cmd_flag(cmd, "--lib", nil, "(native backend) build a shared library")
    argparse.cmd_flag(cmd, "--shared", nil, "(native backend) build a shared library (alias)")
    argparse.cmd_option_multi(cmd, "--link", "-l", "string", "(native backend) link dynamic lib (macOS: LC_LOAD_DYLIB; Windows: DLL search list for ffi; Linux: enable dynamic ELF + dlsym FFI)")
    argparse.cmd_flag(cmd, "--metadata", nil, "(native backend) write <out>.meta.json")
    argparse.cmd_flag(cmd, "--analyze", nil, "Print analysis info and exit")
    argparse.cmd_flag(cmd, "--typecheck", nil, "Typecheck annotated code (fail fast on type errors; still builds on success)")
    argparse.cmd_flag(cmd, "--python", nil, "(C backend) enable Python integration (requires python3-config)")
    argparse.cmd_flag_env(cmd, "--strict-attrs", nil, "Reject unknown attributes unless allowlisted", "OREN_STRICT_ATTRS")
    argparse.cmd_option_env(cmd, "--attr-allow-prefixes", nil, "string", "", "CSV allow attribute prefixes in strict mode", "OREN_ATTR_ALLOW_PREFIXES")
    argparse.cmd_flag_env(cmd, "--strict-ident-prefixes", nil, "Reject reserved identifier prefixes (oren_/sys_/__oren_)", "OREN_STRICT_IDENT_PREFIXES")
    argparse.cmd_option_env(cmd, "--ident-allow-prefixes", nil, "string", "", "CSV allow identifier prefixes in strict mode", "OREN_IDENT_ALLOW_PREFIXES")
    argparse.cmd_flag_env(cmd, "--capsule", nil, "(native backend) capability-safe subset: deny host effects unless allowlisted", "OREN_CAPSULE")
    argparse.cmd_option_env(cmd, "--cap-allow-domains", nil, "string", "", "CSV allow capability domains in capsule mode", "OREN_CAP_ALLOW_DOMAINS")
    argparse.cmd_option(cmd, "--codesign", nil, "string", "", "(macOS) codesign identity")
    argparse.cmd_flag(cmd, "--notarize", nil, "(macOS) notarize output with notarytool")
    argparse.cmd_option(cmd, "--notary-profile", nil, "string", "", "(macOS) notarytool keychain profile")
    argparse.cmd_flag_env(cmd, "--no-gc", nil, "Disable GC scanning", "OREN_NO_GC")
    argparse.cmd_flag_env(cmd, "--deterministic", nil, "Deterministic mode: emit stable artifact hashes (sha256) for reproducible builds", "OREN_DETERMINISTIC")
    argparse.cmd_flag(cmd, "--manifest", nil, "Write <out>.manifest.json with artifact sha256 (use with --deterministic for content-addressed builds)")
    // Bytecode/AVM packaging (rolling):
    argparse.cmd_flag(cmd, "--obc-lib", nil, "(bytecode backend) emit OBX exports for linking (library/bundle)")
    argparse.cmd_option(cmd, "--stdlib-mode", nil, "string", "source", "(bytecode backend) stdlib resolution: source|obc")
    argparse.cmd_option_env(cmd, "--stdlib-obc", nil, "string", "", "(bytecode backend) path to stdlib bundle `.obc` (requires --stdlib-mode obc)", "OREN_STDLIB_OBC")
    argparse.cmd_option_multi(cmd, "--link-obc", nil, "string", "(bytecode backend) link extra `.obc` libraries (OBX)")
    return nil
}

fn cli_spec() {
    var p = argparse.new_parser("oren", "Oren compiler / toolchain driver")
    // Global flags
    argparse.cmd_flag(argparse.root(p), "--version", "-V", "Show version and exit")

    var completion = argparse.add_command(p, "completion", "Emit shell completion script")
    argparse.cmd_positional(completion, "shell", false, "Shell: bash|zsh")

    var build = argparse.add_command(p, "build", "Build a .oren file (native/c/bytecode)")
    argparse.cmd_positional(build, "file.oren", true, "Input source file")
    cli_add_build_opts(build, true, "c")

    var testcmd = argparse.add_command(p, "test", "Build and run test blocks in a .oren file")
    argparse.cmd_positional(testcmd, "file.oren", true, "Input source file")
    cli_add_build_opts(testcmd, false, "native")
    var emitc = argparse.add_command(p, "emit-c", "Alias for: build --backend c --emit-c")
    argparse.cmd_positional(emitc, "file.oren", true, "Input source file")
    // Subset of build options that make sense for emit-c.
    argparse.cmd_option(emitc, "--out", "-o", "string", "", "Output path (default: strip .oren)")
    argparse.cmd_option(emitc, "--cc", nil, "string", "cc", "(C backend) C compiler (default: cc; on Windows hosts, omit --cc to auto-detect cl.exe)")
    argparse.cmd_flag(emitc, "--python", nil, "(C backend) enable Python integration (requires python3-config)")
    argparse.cmd_flag(emitc, "--analyze", nil, "Print analysis info and exit")
    argparse.cmd_flag(emitc, "--typecheck", nil, "Typecheck annotated code (fail fast on type errors; still builds on success)")
    argparse.cmd_flag_env(emitc, "--strict-attrs", nil, "Reject unknown attributes unless allowlisted", "OREN_STRICT_ATTRS")
    argparse.cmd_option_env(emitc, "--attr-allow-prefixes", nil, "string", "", "CSV allow attribute prefixes in strict mode", "OREN_ATTR_ALLOW_PREFIXES")
    argparse.cmd_flag_env(emitc, "--strict-ident-prefixes", nil, "Reject reserved identifier prefixes (oren_/sys_/__oren_)", "OREN_STRICT_IDENT_PREFIXES")
    argparse.cmd_option_env(emitc, "--ident-allow-prefixes", nil, "string", "", "CSV allow identifier prefixes in strict mode", "OREN_IDENT_ALLOW_PREFIXES")
    argparse.cmd_flag_env(emitc, "--deterministic", nil, "Deterministic mode: emit stable artifact hashes (sha256) for reproducible builds", "OREN_DETERMINISTIC")
    argparse.cmd_flag(emitc, "--manifest", nil, "Write <out>.manifest.json with artifact sha256 (use with --deterministic for content-addressed builds)")

    var meta = argparse.add_command(p, "meta", "Emit metadata JSON for a .oren entry module (no codegen)")
    argparse.cmd_positional(meta, "file.oren", true, "Input source file")
    argparse.cmd_option(meta, "--out", "-o", "string", "", "Output path (default: <file>.meta.json)")
    argparse.cmd_option(meta, "--target", nil, "string", "auto", "Target OS for ABI/layout lowering: macos|linux|windows|auto (legacy; prefer --platform)")
    argparse.cmd_option(meta, "--arch", nil, "string", "auto", "Target arch for ABI/layout lowering: arm64|x64|auto (legacy; prefer --platform)")
    argparse.cmd_option(meta, "--platform", nil, "string", "", "Platform for ABI/layout lowering: arm64-macos|arm64-linux|x64-windows|x64-linux (preferred; overrides --arch/--target)")
    argparse.cmd_flag_env(meta, "--strict-attrs", nil, "Reject unknown attributes unless allowlisted", "OREN_STRICT_ATTRS")
    argparse.cmd_option_env(meta, "--attr-allow-prefixes", nil, "string", "", "CSV allow attribute prefixes in strict mode", "OREN_ATTR_ALLOW_PREFIXES")
    argparse.cmd_flag_env(meta, "--strict-ident-prefixes", nil, "Reject reserved identifier prefixes (oren_/sys_/__oren_)", "OREN_STRICT_IDENT_PREFIXES")
    argparse.cmd_option_env(meta, "--ident-allow-prefixes", nil, "string", "", "CSV allow identifier prefixes in strict mode", "OREN_IDENT_ALLOW_PREFIXES")
    argparse.cmd_flag_env(meta, "--deterministic", nil, "Deterministic mode: emit stable artifact hash (sha256) for metadata output", "OREN_DETERMINISTIC")
    argparse.cmd_flag(meta, "--manifest", nil, "Write <out>.manifest.json with artifact sha256 (use with --deterministic for content-addressed metadata)")

    var scan = argparse.add_command(p, "scan", "Scan a dylib and print exported symbols")
    argparse.cmd_positional(scan, "lib.dylib", true, "Library path")

    var sym = argparse.add_command(p, "sym", "Resolve a native PC address to a function name (native debug builds)")
    argparse.cmd_positional(sym, "addr", true, "Address (int or hex like 0x1000)")

    var clean = argparse.add_command(p, "clean", "Remove Oren build caches")
    argparse.cmd_option_env(clean, "--cache-dir", nil, "string", "", "Build cache directory to remove", "OREN_CACHE_DIR")

    var dumpcmd = argparse.add_command(p, "dump", "Dump compiler internals for troubleshooting (JSON)")
    argparse.cmd_positional(dumpcmd, "kind", true, "Dump kind: tokens|linked|graph")
    argparse.cmd_positional(dumpcmd, "file.oren", true, "Input source file")
    argparse.cmd_option(dumpcmd, "--out", "-o", "string", "", "Output path (default: stdout)")
    argparse.cmd_option(dumpcmd, "--target", nil, "string", "auto", "Target OS for lowering: macos|linux|windows|auto (legacy; prefer --platform)")
    argparse.cmd_option(dumpcmd, "--arch", nil, "string", "auto", "Target arch for lowering: arm64|x64|auto (legacy; prefer --platform)")
    argparse.cmd_option(dumpcmd, "--platform", nil, "string", "", "Platform for lowering: arm64-macos|arm64-linux|x64-windows|x64-linux (preferred; overrides --arch/--target)")
    argparse.cmd_flag_env(dumpcmd, "--strict-attrs", nil, "Reject unknown attributes unless allowlisted", "OREN_STRICT_ATTRS")
    argparse.cmd_option_env(dumpcmd, "--attr-allow-prefixes", nil, "string", "", "CSV allow attribute prefixes in strict mode", "OREN_ATTR_ALLOW_PREFIXES")
    argparse.cmd_flag_env(dumpcmd, "--strict-ident-prefixes", nil, "Reject reserved identifier prefixes (oren_/sys_/__oren_)", "OREN_STRICT_IDENT_PREFIXES")
    argparse.cmd_option_env(dumpcmd, "--ident-allow-prefixes", nil, "string", "", "CSV allow identifier prefixes in strict mode", "OREN_IDENT_ALLOW_PREFIXES")

    var selftest_native = argparse.add_command(p, "selftest-native", "Fast native runtime self-test (no parsing/linking)")

    return p
}

fn usage_cmd(cmd_name) {
    var p = cli_spec()
    var lines = argparse.render_help_lines(p, cmd_name)
    var i = 0
    while i < oren_list_len(lines) {
        print(lines[i])
        i = i + 1
    }
}

fn usage() { return usage_cmd(nil) }

fn shell_quote(s) {
    return "'" + s + "'" // Minimal quoting
}

fn cmd_ok(cmd) {
    // Return true if command exits with 0.
    return oren_system(cmd) == 0
}

fn normalize_rc(rc) {
    // Normalize the return value of oren_system() to a conventional exit code.
    // Many C runtimes encode exit status as (code << 8).
    if rc < 0 { return rc }
    if rc >= 256 { return rc / 256 }
    return rc
}

fn diag_escape(msg) {
    // Escape newlines/tabs so one-line OREN_DIAG is machine-friendly.
    if msg == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(msg) {
        var c = oren_string_char_at(msg, i)
        if c == "\n" { out = out + "\\n"; i = i + 1; continue }
        if c == "\r" { out = out + "\\r"; i = i + 1; continue }
        if c == "\t" { out = out + "\\t"; i = i + 1; continue }
        out = out + c
        i = i + 1
    }
    return out
}

fn emit_diag(kind, code, msg) {
    // Compiler/toolchain diagnostic one-liner (AI-friendly).
    // Format matches runtime OREN_DIAG.
    print("OREN_DIAG kind=" + kind + " code=" + oren_int_to_string(code) + " msg=" + diag_escape(msg))
    return nil
}

fn _imod(a, b) {
    // Integer modulo without relying on a runtime helper.
    // Assumes b>0.
    return a - (a / b) * b
}

fn _path_is_sep_byte(b) {
    // Treat both '/' and '\\' as separators so Windows-style paths work too.
    if b == 47 { return true } // '/'
    if b == 92 { return true } // '\\'
    return false
}

fn _path_to_windows_sep(s) {
    if s == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        if ch == "/" { out = out + "\\" }
        else { out = out + ch }
        i = i + 1
    }
    return out
}

fn _path_to_posix_sep(s) {
    // Normalize path separators for cross-OS robustness:
    // - Treat '\' as a path separator even on non-Windows hosts.
    // - This makes CLI invocations like `examples\\myapp.oren` behave consistently across shells/OSes
    //   (and avoids accidental nested-path output creation like `build/.../examples\\myapp`).
    //
    // NOTE: Windows APIs accept forward slashes for most file paths, so this is safe on Windows too.
    if s == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        if ch == "\\" { out = out + "/" }
        else { out = out + ch }
        i = i + 1
    }
    return out
}

fn host_is_windows() {
    // Robust host detection for compiler/tooling.
    //
    // Rationale:
    // - On Windows hosts (especially via SSH, PowerShell, MSYS2, etc.), `OS=Windows_NT` is common
    //   but not guaranteed to be present in every execution environment.
    // - Some core toolchain behaviors must be host-correct even when `OS` is missing:
    //   - mkdir behavior (`mkdir -p` does not exist in cmd.exe)
    //   - default toolchain selection for C backend bring-up (MSVC `cl.exe` on Windows)
    //
    // Keep this conservative: rely on multiple Windows-specific env vars, not just `OS`.
    var os_env = oren_env("OS")
    if os_env == "Windows_NT" { return true }
    var sysroot = oren_env("SystemRoot")
    if sysroot != nil && sysroot != "" { return true }
    var windir = oren_env("WINDIR")
    if windir != nil && windir != "" { return true }
    var comspec = oren_env("COMSPEC")
    if comspec != nil && comspec != "" { return true }
    var pathext = oren_env("PATHEXT")
    if pathext != nil && pathext != "" { return true }
    var arch = oren_env("PROCESSOR_ARCHITECTURE")
    if arch != nil && arch != "" { return true }
    // MSYS2 / Git Bash / MinGW environments can run without the usual Windows env vars
    // in some invocations, but they still represent a Windows host.
    //
    // Treat these as hints only; they should not appear on real Linux/macOS hosts.
    var msys = oren_env("MSYSTEM")
    if msys != nil && msys != "" { return true }
    var mingw_prefix = oren_env("MINGW_PREFIX")
    if mingw_prefix != nil && mingw_prefix != "" { return true }
    var msystem_chost = oren_env("MINGW_CHOST")
    if msystem_chost != nil && msystem_chost != "" { return true }
    return false
}

fn _hex_digit(n) {
    // n in [0,15]
    return oren_string_char_at("0123456789abcdef", n)
}

fn _bytes_to_hex(bs) {
    if bs == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_list_len(bs) {
        var b = bs[i]
        if b < 0 { b = 0 }
        if b > 255 { b = _imod(b, 256) }
        out = out + _hex_digit(b / 16) + _hex_digit(_imod(b, 16))
        i = i + 1
    }
    return out
}

fn _bytes_len_any(bs) {
    if bs == nil { return 0 }
    // Prefer typed-buffer length when available, otherwise fall back to list length.
    var n = oren_buf_len(bs)
    if !oren_is_err(n) { return n }
    return oren_list_len(bs)
}

fn _sha256_hex(bs) {
    if bs == nil { return "" }
    var n = _bytes_len_any(bs)
    var d = oren_sha256_range(bs, 0, n)
    return _bytes_to_hex(d)
}

fn _sha256_hex_string(s) {
    if s == nil { return "" }
    var d = oren_sha256_string(s)
    return _bytes_to_hex(d)
}

fn _emit_artifact_hash(kind, path, bs) {
    var h = _sha256_hex(bs)
    print("OREN_ARTIFACT kind=" + kind + " sha256=" + h + " path=" + path)
    return nil
}

fn _json_escape(s) {
    // Minimal JSON string escaping for deterministic manifest emission.
    // Escapes: backslash and double-quote, plus \n/\r/\t.
    if s == nil { return "" }
    var bs = oren_bytes_from_string(s)
    var out = ""
    var i = 0
    while i < oren_list_len(bs) {
        var b = bs[i]
        if b == 92 { out = out + "\\\\" } // '\'
        else {
            if b == 34 { out = out + "\\\"" } // '"'
            else {
                if b == 10 { out = out + "\\n" }
                else {
                    if b == 13 { out = out + "\\r" }
                    else {
                        if b == 9 { out = out + "\\t" }
                        else { out = out + oren_string_char_at(s, i) }
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

fn _json_bool(b) {
    if b == true { return "true" }
    return "false"
}

fn _json_string_array(xs) {
    if xs == nil { return "[]" }
    var out = "["
    var i = 0
    var first = true
    while i < oren_list_len(xs) {
        var s = xs[i]
        if s != nil && s != "" {
            if !first { out = out + ", " }
            out = out + "\"" + _json_escape(s) + "\""
            first = false
        }
        i = i + 1
    }
    out = out + "]"
    return out
}

fn _runtime_profile_request_for_manifest(backend, capsule) {
    if backend != "native" { return "none" }
    if capsule == true { return "capsule" }
    var req = oren_env("OREN_NATIVE_RUNTIME_PROFILE")
    if req == "full" { return "full" }
    if req == "core" { return "core" }
    if req == "minimal" { return "minimal" }
    return "auto"
}

fn _runtime_path_for_manifest_profile(profile) {
    if profile == "capsule" { return "lib/runtime_native_capsule.oren" }
    if profile == "full" { return "lib/runtime_native.oren" }
    if profile == "core" { return "lib/runtime_native_core.oren" }
    if profile == "minimal" { return "lib/runtime_native_core.oren" }
    if profile == "auto" { return "backend-auto" }
    return ""
}

fn _artifact_manifest_policy(backend, capsule, cap_allow_domains, source_required_domains) {
    var profile = _runtime_profile_request_for_manifest(backend, capsule)
    return {
        "backend": backend,
        "runtime_profile": profile,
        "runtime_path": _runtime_path_for_manifest_profile(profile),
        "capsule": capsule,
        "cap_allow_domains": cap_allow_domains,
        "source_required_domains": source_required_domains,
    }
}

fn _artifact_manifest_policy_json(policy) {
    if policy == nil { policy = _artifact_manifest_policy("unknown", false, [], []) }
    var backend = policy["backend"]
    if backend == nil { backend = "unknown" }
    var runtime_profile = policy["runtime_profile"]
    if runtime_profile == nil { runtime_profile = "none" }
    var runtime_path = policy["runtime_path"]
    if runtime_path == nil { runtime_path = "" }
    var capsule = policy["capsule"] == true
    var cap_allow_domains = policy["cap_allow_domains"]
    var source_required_domains = policy["source_required_domains"]
    return "\"policy\":{\"version\":1," +
        "\"backend\":\"" + _json_escape(backend) + "\"," +
        "\"runtime_profile\":\"" + _json_escape(runtime_profile) + "\"," +
        "\"runtime_path\":\"" + _json_escape(runtime_path) + "\"," +
        "\"capsule\":" + _json_bool(capsule) + "," +
        "\"cap_allow_domains\":" + _json_string_array(cap_allow_domains) + "," +
        "\"source_required_domains\":" + _json_string_array(source_required_domains) + "," +
        "\"budgets\":{\"version\":1,\"declared\":false}" +
        "}"
}

fn _write_artifact_manifest_with_policy(kind, path, sha256_hex, target, arch, deterministic, size_bytes, policy) {
    // Machine-readable artifact record for Compiler-in-AVM v2.
    //
    // Manifest path: <artifact_path>.manifest.json
    // Determinism note: the manifest itself is emitted deterministically (stable key order).
    var mp = path + ".manifest.json"
    var det = "false"
    if deterministic { det = "true" }
    if size_bytes == nil { size_bytes = 0 }
    var s = "{\"version\":1," +
        "\"kind\":\"" + _json_escape(kind) + "\"," +
        "\"sha256\":\"" + _json_escape(sha256_hex) + "\"," +
        "\"size_bytes\":" + oren_int_to_string(size_bytes) + "," +
        "\"path\":\"" + _json_escape(path) + "\"," +
        "\"target\":\"" + _json_escape(target) + "\"," +
        "\"arch\":\"" + _json_escape(arch) + "\"," +
        "\"deterministic\":" + det + "," +
        _artifact_manifest_policy_json(policy) +
        "}\n"
    var w = oren_write_file(mp, s)
    if oren_is_err(w) {
        print("Failed to write manifest: " + mp)
        var msg = oren_err_msg(w)
        if msg != nil { print(msg) }
        oren_exit(1)
    }
    print("Wrote manifest: " + mp)
    return nil
}

fn _write_artifact_manifest(kind, path, sha256_hex, target, arch, deterministic, size_bytes) {
    return _write_artifact_manifest_with_policy(kind, path, sha256_hex, target, arch, deterministic, size_bytes, nil)
}

fn ensure_dir(path) {
    // Cross-platform `mkdir -p` helper for compiler tooling.
    //
    // Rolling constraint: Stage 1 is built via the C backend, so compiler tooling must
    // not rely on shelling out to `mkdir` (Windows cmd.exe parity) nor on native-only
    // intrinsics like `sys_mkdir`.
    //
    // `oren_mkdir_p` is a runtime call implemented for both:
    // - C backend runtime (`lib/runtime/*.inc`)
    // - native runtime (`lib/runtime_native/*`)
    if path == nil || path == "" { return nil }
    var rc = oren_mkdir_p(path)
    if rc < 0 {
        print("ERROR: ensure_dir failed: " + path + " (rc=" + oren_int_to_string(rc) + ")")
        oren_exit(1)
    }
    return nil
}

fn detect_timeout_bin() {
    // Prefer GNU coreutils `timeout` (Linux) and `gtimeout` (macOS coreutils).
    // We treat timeout tooling as mandatory for safe rolling iteration.
    if cmd_ok("sh -c 'timeout 1 true >/dev/null 2>&1'") { return "timeout" }
    if cmd_ok("sh -c 'gtimeout 1 true >/dev/null 2>&1'") { return "gtimeout" }
    return nil
}

fn run_shell_capture(timeout_bin, timeout_secs, cmd, log_path) {
    // Run a shell command, capture stdout+stderr to log_path, and apply a wall timeout.
    // Returns exit code of the command (or timeout wrapper).
    var t = detect_timeout_bin()
    if timeout_bin != nil { t = timeout_bin }
    if t == nil {
        print("ERROR: timeout not found (need `timeout` or `gtimeout` in PATH).")
        print("macOS: brew install coreutils")
        return 2
    }
    // Always wrap in sh -c for redirection.
    // NOTE: shell_quote is minimal; do not put untrusted input here.
    var redir = cmd + " > " + shell_quote(log_path) + " 2>&1"
    var wrapped = "sh -c " + shell_quote(redir)
    var full = t + " " + oren_int_to_string(timeout_secs) + " " + wrapped
    return normalize_rc(oren_system(full))
}

fn basename(path) {
    if path == nil { return "" }
    var i = oren_string_len(path) - 1
    while i >= 0 {
        var ch = oren_string_char_at(path, i)
        // Treat both separators as path separators unconditionally.
        // Rationale: on Windows hosts, the `OS=Windows_NT` env var is not guaranteed to be present
        // (e.g. PowerShell, SSH sessions, or minimal environments). Output naming must still be
        // robust when inputs use backslashes (e.g. `examples\myapp.oren`).
        if ch == "/" || ch == "\\" {
            return oren_string_slice(path, i + 1, oren_string_len(path))
        }
        i = i - 1
    }
    return path
}

fn cmd_quote(s) {
    // Minimal quoting for cmd.exe script emission (bootstrap/tooling).
    // - wrap when spaces/tabs exist
    // - escape embedded quotes by doubling
    if s == nil { return "\"\"" }
    if s == "" { return "\"\"" }
    var needs = false
    var i = 0
    while i < oren_string_len(s) {
        var c = oren_string_char_at_unchecked(s, i)
        if c == " " || c == "\t" { needs = true }
        if c == "\"" { needs = true }
        i = i + 1
    }
    if needs != true { return s }
    // Build with doubled quotes.
    var parts = ["\""]
    i = 0
    while i < oren_string_len(s) {
        var c2 = oren_string_char_at_unchecked(s, i)
        if c2 == "\"" { oren_list_push(parts, "\"\"") }
        else { oren_list_push(parts, c2) }
        i = i + 1
    }
    oren_list_push(parts, "\"")
    return oren_string_join(parts)
}

fn strip_suffix(s, suffix) {
    if s == nil { return s }
    if suffix == nil { return s }
    var sl = oren_string_len(s)
    var pl = oren_string_len(suffix)
    if sl < pl { return s }
    if oren_string_slice(s, sl - pl, sl) == suffix {
        return oren_string_slice(s, 0, sl - pl)
    }
    return s
}

fn file_exists(path) {
    if path == nil || path == "" { return false }
    // Stage0 bootstrap + native runtime parity:
    // - stage1 is built via the C backend, so we cannot use native-only `sys_stat`.
    // - avoid shell probes (`test -f`, `if exist`) to keep Windows parity and enable
    //   compiler-in-capsule/minimal environments.
    //
    // `oren_is_file` is implemented in both the C runtime and native runtime.
    return oren_is_file(path) == true
}

fn string_contains(hay, needle) {
    if hay == nil || needle == nil { return false }
    var hl = oren_string_len(hay)
    var nl = oren_string_len(needle)
    if nl == 0 { return true }
    if hl < nl { return false }
    var i = 0
    while i <= hl - nl {
        var j = 0
        while j < nl {
            if oren_string_char_at(hay, i + j) != oren_string_char_at(needle, j) {
                j = -1
                break
            }
            j = j + 1
        }
        if j == nl { return true }
        i = i + 1
    }
    return false
}

// --- Syscall-first hardening (compile-time guard) ---
//
// Prevent accidental re-introduction of syscall bypasses in the native backend:
// - All OS syscalls (except allocator mmap/exit and the entry stub exit) must be emitted by
//   `arm64_native_expr_syscalls.oren` so capsule pre/post hooks remain authoritative.
//
// We enforce this by scanning compiler source files for direct `darwin_sys_*` / `linux_sys_*`
// references, and allowing only a minimal set in the few files that intentionally emit
// those syscalls.
fn streq(a, b) {
    if a == nil || b == nil { return false }
    var ab = oren_bytes_from_string(a)
    var bb = oren_bytes_from_string(b)
    var al = oren_list_len(ab)
    var bl = oren_list_len(bb)
    if al != bl { return false }
    var i = 0
    while i < al {
        if ab[i] != bb[i] { return false }
        i = i + 1
    }
    return true
}

fn has_attr_list(stmt, name) {
    if stmt == nil || name == nil { return false }
    var attrs = stmt["attrs"]
    if attrs == nil { return false }
    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a != nil && a["type"] == "Attr" && a["name"] == name { return true }
        i = i + 1
    }
    return false
}

fn scan_syscalls_in_src(src, prefix) {
    var out = []
    var sb = oren_bytes_from_string(src)
    var pb = oren_bytes_from_string(prefix)
    var n = oren_list_len(sb)
    var p_len = oren_list_len(pb)
    var i = 0
    while i + p_len <= n {
        // Skip line comments (`// ... \n`) so policy checks don't fail on docs/comments.
        if i + 1 < n {
            if sb[i] == 47 && sb[i + 1] == 47 {
                // Skip until newline or EOF.
                i = i + 2
                while i < n {
                    if sb[i] == 10 { i = i + 1; break } // '\n'
                    i = i + 1
                }
                continue
            }
        }

        var is_match = true
        var j = 0
        while j < p_len {
            if sb[i + j] != pb[j] { is_match = false; break }
            j = j + 1
        }
        if is_match {
            var start = i + p_len
            // Read identifier [a-zA-Z0-9_]+
            var k = start
            while k < n {
                var ch = sb[k]
                var ok = false
                if ch >= 48 && ch <= 57 { ok = true }
                if ch >= 65 && ch <= 90 { ok = true }
                if ch >= 97 && ch <= 122 { ok = true }
                if ch == 95 { ok = true }
                if ok != true { break }
                k = k + 1
            }
            var name = oren_string_slice(src, start, k)
            if name != nil {
                // De-dup
                var seen = false
                var si = 0
                while si < oren_list_len(out) {
                    if streq(out[si], name) { seen = true; break }
                    si = si + 1
                }
                if seen != true { oren_list_push(out, name) }
            }
            i = k
            continue
        }
        i = i + 1
    }
    return out
}

fn syscall_allow(list, name) {
    var i = 0
    while i < oren_list_len(list) {
        if streq(list[i], name) { return true }
        i = i + 1
    }
    return false
}
