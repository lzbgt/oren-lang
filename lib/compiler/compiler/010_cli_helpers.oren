
import strings "std:strings"

fn _host_detect_cmd_out_trim(cmd, out_path) {
    if cmd == nil || cmd == "" { return nil }
    if out_path == nil || out_path == "" { return nil }
    // Best-effort: write stdout to a file so we can read it back (oren_system has no capture).
    // If the command fails, return nil so callers can fall back to conservative defaults.
    var rc = oren_system(cmd + " > " + shell_quote(out_path) + " 2>/dev/null")
    if rc != 0 { return nil }
    var s = oren_read_file(out_path)
    if oren_is_err(s) { return nil }
    return strings.trim(s)
}

fn detect_host_platform() {
    // Return {"target": <os>, "arch": <arch>} for the current host, or nil if unknown.
    // This is used only as a default when the user does not specify --platform/--target/--arch.
    //
    // Priority:
    // - POSIX-ish hosts: uname -s / uname -m
    // - Native Windows: env vars (OS=Windows_NT, PROCESSOR_ARCHITECTURE)
    //
    // NOTE: we intentionally avoid embedding build-time constants here; the compiler binary
    // can run on multiple hosts (macOS, Linux, Windows) and should default to its *runtime* host.

    // Windows hint (system() uses cmd.exe; uname may be absent).
    var os_env = oren_env("OS")
    if os_env == "Windows_NT" {
        var arch_env = oren_env("PROCESSOR_ARCHITECTURE")
        var arch = "x64"
        if arch_env == "ARM64" { arch = "arm64" }
        else if arch_env == "AMD64" { arch = "x64" }
        else if arch_env == "x86_64" { arch = "x64" }
        else if arch_env == "aarch64" { arch = "arm64" }
        return {"target": "windows", "arch": arch}
    }

    // POSIX-ish: uname.
    if oren_system("command -v uname >/dev/null 2>&1") != 0 { return nil }
    ensure_dir("build/tmp")
    var os_s = _host_detect_cmd_out_trim("uname -s", "build/tmp/_oren_host_os.txt")
    var arch_s = _host_detect_cmd_out_trim("uname -m", "build/tmp/_oren_host_arch.txt")
    if os_s == nil || os_s == "" { return nil }
    if arch_s == nil || arch_s == "" { return nil }

    var target = nil
    if os_s == "Darwin" { target = "macos" }
    else if os_s == "Linux" { target = "linux" }
    else { return nil }

    var arch = nil
    if arch_s == "arm64" || arch_s == "aarch64" { arch = "arm64" }
    else if arch_s == "x86_64" || arch_s == "amd64" { arch = "x64" }
    else { return nil }

    return {"target": target, "arch": arch}
}

fn enforce_syscall_policy(file, allowed_darwin, allowed_linux) {
    var rr = expand_includes_file_result(file, [])
    if rr["ok"] != true {
        print("ERROR: failed to read for syscall-policy check: " + file)
        if rr["err"] != nil { print(rr["err"]) }
        oren_exit(2)
    }
    var src = rr["src"]
    var dar = scan_syscalls_in_src(src, "darwin_sys_")
    var lin = scan_syscalls_in_src(src, "linux_sys_")

    var bad = []
    var i = 0
    while i < oren_list_len(dar) {
        if syscall_allow(allowed_darwin, dar[i]) != true {
            oren_list_push(bad, "darwin_sys_" + dar[i])
        }
        i = i + 1
    }
    i = 0
    while i < oren_list_len(lin) {
        if syscall_allow(allowed_linux, lin[i]) != true {
            oren_list_push(bad, "linux_sys_" + lin[i])
        }
        i = i + 1
    }

    if oren_list_len(bad) != 0 {
        print("FAIL: syscall-first policy violation in " + file)
        print("Disallowed direct syscall identifiers (should be centralized in arm64_native_expr_syscalls.oren):")
        var bi = 0
        while bi < oren_list_len(bad) {
            print("  - " + bad[bi])
            bi = bi + 1
        }
        oren_exit(1)
    }
    return 0
}

fn count_substring_in_src(src, needle) {
    if src == nil || needle == nil { return 0 }
    var sb = oren_bytes_from_string(src)
    var nb = oren_bytes_from_string(needle)
    var sl = oren_list_len(sb)
    var nl = oren_list_len(nb)
    if nl == 0 { return 0 }
    if sl < nl { return 0 }

    var count = 0
    var i = 0
    while i + nl <= sl {
        // Skip line comments (`// ... \n`) so policy checks don't fail on docs/comments.
        if i + 1 < sl {
            if sb[i] == 47 && sb[i + 1] == 47 {
                i = i + 2
                while i < sl {
                    if sb[i] == 10 { i = i + 1; break } // '\n'
                    i = i + 1
                }
                continue
            }
        }

        var ok = true
        var j = 0
        while j < nl {
            if sb[i + j] != nb[j] { ok = false; break }
            j = j + 1
        }
        if ok {
            count = count + 1
            i = i + nl
        } else {
            i = i + 1
        }
    }
    return count
}

fn enforce_svc_emit_policy(file, allowed_svc_emits) {
    var rr = expand_includes_file_result(file, [])
    if rr["ok"] != true {
        print("ERROR: failed to read for svc-policy check: " + file)
        if rr["err"] != nil { print(rr["err"]) }
        oren_exit(2)
    }
    var src = rr["src"]

    // Only count actual instruction emission, not function definitions.
    var pattern = "push_u32_le(ctx[\"code\"], insn_svc("
    var n = count_substring_in_src(src, pattern)
    if n != allowed_svc_emits {
        print("FAIL: syscall-first policy violation in " + file)
        print("Unexpected number of direct `insn_svc` emissions.")
        print("  expected: " + oren_int_to_string(allowed_svc_emits))
        print("  found:    " + oren_int_to_string(n))
        print("Rule: only arm64_native_expr_syscalls.oren should emit syscalls for OS ops;")
        print("      other files may only emit svc for allocator/entry-stub special cases.")
        oren_exit(1)
    }
    return 0
}

fn dirname(path) {
    if path == nil { return "." }
    var n = oren_string_len(path)
    var i = n - 1
    while i >= 0 {
        if oren_string_char_at_unchecked(path, i) == "/" {
            if i == 0 { return "/" }
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

fn starts_with(s, prefix) {
    var sl = oren_string_len(s)
    var pl = oren_string_len(prefix)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if oren_string_char_at_unchecked(s, i) != oren_string_char_at_unchecked(prefix, i) { return false }
        i = i + 1
    }
    return true
}

fn trim_left_ws(s) {
    if s == nil { return "" }
    var i = 0
    var n = oren_string_len(s)
    while i < n {
        var c = oren_string_char_at_unchecked(s, i)
        if c != " " && c != "\t" && c != "\r" { break }
        i = i + 1
    }
    if i == 0 { return s }
    return oren_string_slice(s, i, n)
}

fn ends_with_newline(s) {
    if s == nil { return false }
    var n = oren_string_len(s)
    if n == 0 { return false }
    return oren_string_char_at_unchecked(s, n - 1) == "\n"
}

fn include_path_from_line(line) {
    // Purpose-built textual include for repo-owned Oren sources.
    //
    // Directive form (must be in a single line comment):
    //   // @include "relative/or/absolute/path.oren"
    //
    // This is *not* the language `import` system. It is used to split large files
    // into smaller ones while keeping all symbols in the same module namespace.
    if line == nil { return "" }
    var t = trim_left_ws(line)
    if !starts_with(t, "// @include") { return "" }
    var n = oren_string_len(t)
    var i = 0
    while i < n {
        if oren_string_char_at_unchecked(t, i) == "\"" { break }
        i = i + 1
    }
    if i >= n { return "" }
    var j = i + 1
    while j < n {
        if oren_string_char_at_unchecked(t, j) == "\"" { break }
        j = j + 1
    }
    if j >= n { return "" }
    return oren_string_slice(t, i + 1, j)
}

fn _include_join_parts(parts) {
    if parts == nil { return "" }
    if oren_list_len(parts) == 0 { return "" }
    // Use a runtime helper that preallocates exactly once.
    // This avoids huge intermediate allocations when expanding many includes.
    return oren_string_join(parts)
}

fn expand_includes_file_result(full_path, include_stack) {
    // Expand `// @include "..."` directives recursively and return the concatenated source.
    //
    // On failure, returns {"ok":false, "err": string}.
    // Callers should format their own diagnostics so user-facing output stays stable.
    var dbg_inc = oren_env("OREN_DEBUG_INCLUDES")
    if dbg_inc != nil {
        print("DEBUG_INCLUDES open=" + full_path)
        // Also print the raw pointer/int value for diagnosing native backend issues.
        print("DEBUG_INCLUDES open_ptr=" + oren_int_to_string(full_path))
    }

    if full_path == nil {
        var msg0 = "include: empty path"
        if dbg_inc != nil { print("DEBUG_INCLUDES empty(nil)") }
        return {"ok": false, "err": msg0}
    }
    // Use length check to avoid relying on string equality semantics for "" in early runtimes.
    if oren_string_len(full_path) == 0 || full_path == "" {
        var msg1 = "include: empty path"
        if dbg_inc != nil { print("DEBUG_INCLUDES empty(len==0)") }
        return {"ok": false, "err": msg1}
    }

    // Include-cycle check.
    if include_stack != nil {
        var si = 0
        while si < oren_list_len(include_stack) {
            if include_stack[si] == full_path {
                return {"ok": false, "err": "include cycle detected: " + full_path}
            }
            si = si + 1
        }
    }

    var src = oren_read_file(full_path)
    if oren_is_err(src) {
        var em = oren_err_msg(src)
        if em == nil { em = "failed to read" }
        return {"ok": false, "err": em}
    }
    if dbg_inc != nil {
        print("DEBUG_INCLUDES read ok len=" + oren_int_to_string(oren_string_len(src)))
    }

    var next_stack = []
    if include_stack != nil {
        var ci = 0
        while ci < oren_list_len(include_stack) {
            oren_list_push(next_stack, include_stack[ci])
            ci = ci + 1
        }
    }
    oren_list_push(next_stack, full_path)

    var out_parts = []
    // Keep segments between include lines as big slices to avoid O(n^2) string churn.
    var seg_start = 0
    var line_start = 0
    var i = 0
    var n = oren_string_len(src)
    while i < n {
        // PERF: `oren_string_char_at` does a `strlen` per call on the C backend.
        // This loop is hot (runs over every source byte for include scanning),
        // so use the unchecked variant once we have `n`.
        var ch = oren_string_char_at_unchecked(src, i)
        if ch == "\n" {
            var line = oren_string_slice(src, line_start, i)
            var inc = include_path_from_line(line)
            // Avoid relying on `inc != ""` because some backends may lower it as pointer compare
            // if stringiness inference misses `inc`. Length check is robust across backends.
            if inc != nil && oren_string_len(inc) > 0 {
                if dbg_inc != nil { print("DEBUG_INCLUDES include raw=" + inc + " base=" + full_path) }
                if seg_start < line_start {
                    var seg = oren_string_slice(src, seg_start, line_start)
                    if seg != nil && oren_string_len(seg) > 0 { oren_list_push(out_parts, seg) }
                }
                var inc_full = inc
                if oren_string_len(inc) > 0 && oren_string_char_at_unchecked(inc, 0) != "/" {
                    inc_full = resolve_path(dirname(full_path), inc)
                }
                if dbg_inc != nil { print("DEBUG_INCLUDES include full=" + inc_full) }
                var cr = expand_includes_file_result(inc_full, next_stack)
                if cr["ok"] != true { return cr }
                var child = cr["src"]
                oren_list_push(out_parts, child)
                if !ends_with_newline(child) { oren_list_push(out_parts, "\n") }
                seg_start = i + 1
            }
            line_start = i + 1
        }
        i = i + 1
    }

    // Trailing segment after the last include (or whole file if no includes).
    if seg_start < n {
        var seg2 = oren_string_slice(src, seg_start, n)
        if seg2 != nil && oren_string_len(seg2) > 0 { oren_list_push(out_parts, seg2) }
    }

    // Ensure expanded file ends with '\n' when the original file didn't.
    // Do this as a part to avoid copying the entire output just to append one byte.
    if n > 0 && oren_string_char_at_unchecked(src, n - 1) != "\n" {
        oren_list_push(out_parts, "\n")
    }

    return {"ok": true, "src": _include_join_parts(out_parts)}
}

fn expand_includes_file(full_path, include_stack) {
    // Convenience wrapper (kept for legacy call sites).
    var r = expand_includes_file_result(full_path, include_stack)
    if r["ok"] != true { return nil }
    return r["src"]
}

fn default_output_path(path) {
    var i = oren_string_len(path) - 1
    while i >= 0 {
        if oren_string_char_at_unchecked(path, i) == "." {
            return oren_string_slice(path, 0, i)
        }
        i = i - 1
    }
    return path // No extension?
}

// Module system globals
var MODULES = {}
var MODULE_STACK = []
var MODULE_ORDER = []
var MODULE_ID_COUNTER = 0

// Attribute validation knobs (plumbed into the parser).
// Defaults keep rolling mode permissive.
var STRICT_ATTRS = false
var ATTR_ALLOW_PREFIXES = []
var CAPSULE = false
var CAP_ALLOW_DOMAINS = []

fn split_csv(s) {
    var out = []
    if s == nil { return out }
    if s == "" { return out }
    var cur = ""
    var i = 0
    while i < oren_string_len(s) {
        var ch = oren_string_char_at_unchecked(s, i)
        if ch == "," {
            if cur != "" { oren_list_push(out, cur) }
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    if cur != "" { oren_list_push(out, cur) }
    return out
}

fn parse_platform_spec(s) {
    // Parse <arch>-<os> into {"arch": ..., "os": ...}.
    // Used by the CLI to support a single platform flag for arch+OS.
    if s == nil { return nil }
    if s == "" { return nil }
    var n = oren_string_len(s)
    if n == 0 { return nil }
    var dash = -1
    var i = 0
    while i < n {
        if oren_string_char_at_unchecked(s, i) == "-" { dash = i; break }
        i = i + 1
    }
    if dash <= 0 { return nil }
    if dash + 1 >= n { return nil }
    var arch = oren_string_slice(s, 0, dash)
    var os = oren_string_slice(s, dash + 1, n)
    if arch != "arm64" && arch != "x64" { return nil }
    if os != "macos" && os != "linux" && os != "windows" { return nil }
    return {"arch": arch, "os": os}
}

fn new_module_prefix() {
    MODULE_ID_COUNTER = MODULE_ID_COUNTER + 1
    return "M" + oren_int_to_string(MODULE_ID_COUNTER) + "_"
}


fn path_norm(path) {
    if path == nil { return "" }
    var n = oren_string_len(path)
    if n == 0 { return "" }

    var is_abs = oren_string_char_at_unchecked(path, 0) == "/"
    var segs = []

    var i = 0
    var start = 0
    while i <= n {
        var at_end = i == n
        if at_end || oren_string_char_at_unchecked(path, i) == "/" {
            var seg = oren_string_slice(path, start, i)
            if seg != "" && seg != "." {
                if seg == ".." {
                    var sl = oren_list_len(segs)
                    if sl > 0 && segs[sl - 1] != ".." {
                        // pop
                        var ns = []
                        var j = 0
                        while j + 1 < sl {
                            oren_list_push(ns, segs[j])
                            j = j + 1
                        }
                        segs = ns
                    } else {
                        if !is_abs { oren_list_push(segs, "..") }
                    }
                } else {
                    oren_list_push(segs, seg)
                }
            }
            start = i + 1
        }
        i = i + 1
    }

    if oren_list_len(segs) == 0 {
        if is_abs { return "/" }
        return "."
    }

    // PERF: build the normalized path in one allocation.
    var parts = []
    if is_abs { oren_list_push(parts, "/") }
    i = 0
    while i < oren_list_len(segs) {
        if i > 0 { oren_list_push(parts, "/") }
        oren_list_push(parts, segs[i])
        i = i + 1
    }
    var out = oren_string_join(parts)

    return out
}

fn resolve_path(base, path) {
    if path == nil { return "" }
    if oren_string_len(path) > 0 && oren_string_char_at_unchecked(path, 0) == "/" { return path_norm(path) }
    return path_norm(base + "/" + path)
}

fn _path_last_segment(path) {
    // Return substring after the last '/' (or whole string if no '/').
    if path == nil { return "" }
    var n = oren_string_len(path)
    var i = n - 1
    while i >= 0 {
        if oren_string_char_at_unchecked(path, i) == "/" {
            return oren_string_slice(path, i + 1, n)
        }
        i = i - 1
    }
    return path
}

fn _segment_has_dot(seg) {
    if seg == nil { return false }
    var i = 0
    var n = oren_string_len(seg)
    while i < n {
        if oren_string_char_at_unchecked(seg, i) == "." { return true }
        i = i + 1
    }
    return false
}

fn _ensure_oren_ext(path) {
    // If the last segment has no '.', append ".oren".
    // This enables ergonomic imports like:
    //   import math "std/math"
    //   import linalg "std/linalg/common"
    // without forcing ".oren" in user code.
    if path == nil { return "" }
    var seg = _path_last_segment(path)
    if _segment_has_dot(seg) { return path }
    return path + ".oren"
}

fn _starts_with2(s, pref) {
    if s == nil || pref == nil { return false }
    var sl = oren_string_len(s)
    var pl = oren_string_len(pref)
    if sl < pl { return false }
    var i = 0
    while i < pl {
        if oren_string_char_at_unchecked(s, i) != oren_string_char_at_unchecked(pref, i) { return false }
        i = i + 1
    }
    return true
}

fn _stdlib_root_from_dir(start_dir) {
    // Resolve the stdlib source root directory.
    //
    // Priority:
    // 1) env OREN_STDLIB_ROOT (absolute or relative)
    // 2) walk up from start_dir looking for "lib/std/argparse.oren"
    // 3) fallback: "lib/std" in current working directory
    var env_root = oren_env("OREN_STDLIB_ROOT")
    if env_root != nil && env_root != "" {
        var r = path_norm(env_root)
        if file_exists(r + "/argparse.oren") { return r }
        // If user passed the repo root, accept "<root>/lib/std".
        if file_exists(r + "/lib/std/argparse.oren") { return path_norm(r + "/lib/std") }
        // Keep going: env_root might be set but wrong; fall through for dev convenience.
    }

    var d = start_dir
    var hops = 0
    while d != nil && d != "" && hops < 20 {
        var cand = path_norm(d + "/lib/std")
        if file_exists(cand + "/argparse.oren") { return cand }
        if d == "/" { break }
        d = dirname(d)
        hops = hops + 1
    }

    var cwd_cand = path_norm("lib/std")
    if file_exists(cwd_cand + "/argparse.oren") { return cwd_cand }
    return nil
}

fn resolve_import_path(base_dir, import_path) {
    // Import resolver (rolling):
    //
    // - Backward compatible: relative and absolute filesystem imports still work.
    // - New stdlib scheme:
    //     import math "std:math"
    //     import json "std/json"
    //     import common "std/linalg/common"
    //   These resolve to <STDLIB_ROOT>/<path>.oren where STDLIB_ROOT defaults to repo lib/std.
    //
    // This is a compile-time resolution mechanism (not runtime).
    if import_path == nil { return "" }

    // std:... (preferred explicit scheme)
    if _starts_with2(import_path, "std:") {
        var rest = oren_string_slice(import_path, 4, oren_string_len(import_path))
        var root = _stdlib_root_from_dir(base_dir)
        if root == nil {
            print("ERROR: cannot resolve stdlib root (set OREN_STDLIB_ROOT or run from an Oren repo/install).")
            oren_exit(1)
        }
        return path_norm(_ensure_oren_ext(root + "/" + rest))
    }

    // std/... (file-like scheme; friendly for users migrating from paths)
    if _starts_with2(import_path, "std/") {
        var rest2 = oren_string_slice(import_path, 4, oren_string_len(import_path))
        var root2 = _stdlib_root_from_dir(base_dir)
        if root2 == nil {
            print("ERROR: cannot resolve stdlib root (set OREN_STDLIB_ROOT or run from an Oren repo/install).")
            oren_exit(1)
        }
        return path_norm(_ensure_oren_ext(root2 + "/" + rest2))
    }

    // Default: filesystem path resolved relative to base_dir (existing semantics).
    var full = resolve_path(base_dir, import_path)
    return _ensure_oren_ext(full)
}

fn _completion_join_words(ws) {
    if ws == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_list_len(ws) {
        if i != 0 { out = out + " " }
        out = out + ws[i]
        i = i + 1
    }
    return out
}

fn _completion_dedupe(ws) {
    if ws == nil { return [] }
    var out = []
    var seen = {}
    var i = 0
    while i < oren_list_len(ws) {
        var w = ws[i]
        if w != nil && w != "" && seen[w] != true {
            seen[w] = true
            oren_list_push(out, w)
        }
        i = i + 1
    }
    return out
}

fn _completion_sanitize_var(name) {
    // Bash variables cannot contain '-' so map it to '_' (keep other chars as-is).
    if name == nil { return "" }
    var out = ""
    var i = 0
    var n = oren_string_len(name)
    while i < n {
        var c = oren_string_char_at(name, i)
        if c == "-" { out = out + "_" } else { out = out + c }
        i = i + 1
    }
    return out
}

fn _completion_collect_opt_tokens(cmd) {
    if cmd == nil { return [] }
    var out = []
    var opts = cmd["options"]
    if opts == nil { return out }
    var i = 0
    while i < oren_list_len(opts) {
        var o = opts[i]
        if o != nil {
            var ln = o[1]
            var sh = o[2]
            if ln != nil && ln != "" { oren_list_push(out, ln) }
            if sh != nil && sh != "" { oren_list_push(out, sh) }
        }
        i = i + 1
    }
    return _completion_dedupe(out)
}

fn _completion_collect_cmd_names(p) {
    if p == nil { return [] }
    var out = []
    var cmds = p["commands"]
    if cmds == nil { return out }
    var i = 0
    while i < oren_list_len(cmds) {
        var c = cmds[i]
        if c != nil && c["name"] != nil && c["name"] != "" {
            oren_list_push(out, c["name"])
        }
        i = i + 1
    }
    return out
}

fn completion_emit(shell) {
    // Emit minimal shell completion script for the `oren` CLI.
    // This intentionally stays simple and deterministic: it completes
    // - subcommands
    // - global options
    // - per-command option names (no value completion yet)
    if shell == nil || shell == "" { shell = "bash" }
    var p = cli_spec()
    var cmds = _completion_collect_cmd_names(p)
    var cmd_pat = _completion_join_words(cmds)
    // For bash case patterns we need "|" separators:
    var cmd_pat_bar = ""
    var i0 = 0
    while i0 < oren_list_len(cmds) {
        if i0 != 0 { cmd_pat_bar = cmd_pat_bar + "|" }
        cmd_pat_bar = cmd_pat_bar + cmds[i0]
        i0 = i0 + 1
    }

    var root_cmd = p["root"]
    var root_opts = _completion_collect_opt_tokens(root_cmd)
    var root_opts_s = _completion_join_words(root_opts)

    if shell == "bash" {
        print("# bash completion for oren (generated)")
        print("_oren_cmds=\"" + cmd_pat + "\"")
        print("_oren_root_opts=\"" + root_opts_s + "\"")

        var ci = 0
        while ci < oren_list_len(cmds) {
            var cname = cmds[ci]
            var cmd_obj = argparse._find_cmd(p, cname)
            // Fallback to linear scan if internal helper is not available.
            if cmd_obj == nil {
                var cmds2 = p["commands"]
                var j = 0
                while j < oren_list_len(cmds2) {
                    if cmds2[j]["name"] == cname { cmd_obj = cmds2[j]; break }
                    j = j + 1
                }
            }
            var opt_tokens = _completion_collect_opt_tokens(cmd_obj)
            var opt_s = _completion_join_words(opt_tokens)
            print("_oren_opts_" + _completion_sanitize_var(cname) + "=\"" + opt_s + "\"")
            ci = ci + 1
        }

        print("")
        print("_oren() {")
        print("  local cur prev cmd w opts")
        print("  cur=\"${COMP_WORDS[COMP_CWORD]}\"")
        print("  prev=\"\"")
        print("  if [[ $COMP_CWORD -gt 0 ]]; then prev=\"${COMP_WORDS[COMP_CWORD-1]}\"; fi")
        print("  cmd=\"\"")
        print("  for w in \"${COMP_WORDS[@]:1}\"; do")
        print("    if [[ \"$w\" == -* ]]; then")
        print("      continue")
        print("    fi")
        print("    case \"$w\" in")
        print("      " + cmd_pat_bar + ") cmd=\"$w\"; break ;;")
        print("    esac")
        print("  done")
        print("")
        print("  # Enum-like option values (minimal; keep deterministic).")
        print("  if [[ \"$cur\" == --help=* ]]; then")
        print("    local v=\"${cur#--help=}\"")
        print("    COMPREPLY=( $(compgen -W \"json\" -- \"$v\") )")
        print("    COMPREPLY=( \"${COMPREPLY[@]/#/--help=}\" )")
        print("    return 0")
        print("  fi")
        print("  if [[ \"$cur\" == -h=* ]]; then")
        print("    local v=\"${cur#-h=}\"")
        print("    COMPREPLY=( $(compgen -W \"json\" -- \"$v\") )")
        print("    COMPREPLY=( \"${COMPREPLY[@]/#/-h=}\" )")
        print("    return 0")
        print("  fi")
        print("  if [[ \"$cmd\" == \"build\" ]]; then")
        print("    if [[ \"$prev\" == \"--backend\" ]]; then COMPREPLY=( $(compgen -W \"c native bytecode\" -- \"$cur\") ); return 0; fi")
        print("    if [[ \"$cur\" == --backend=* ]]; then local v=\"${cur#--backend=}\"; COMPREPLY=( $(compgen -W \"c native bytecode\" -- \"$v\") ); COMPREPLY=( \"${COMPREPLY[@]/#/--backend=}\" ); return 0; fi")
        print("    if [[ \"$prev\" == \"--stdlib-mode\" ]]; then COMPREPLY=( $(compgen -W \"source obc\" -- \"$cur\") ); return 0; fi")
        print("    if [[ \"$cur\" == --stdlib-mode=* ]]; then local v=\"${cur#--stdlib-mode=}\"; COMPREPLY=( $(compgen -W \"source obc\" -- \"$v\") ); COMPREPLY=( \"${COMPREPLY[@]/#/--stdlib-mode=}\" ); return 0; fi")
        print("  fi")
        print("  if [[ \"$cmd\" == \"build\" || \"$cmd\" == \"meta\" || \"$cmd\" == \"dump\" ]]; then")
        print("    if [[ \"$prev\" == \"--target\" ]]; then COMPREPLY=( $(compgen -W \"macos linux windows\" -- \"$cur\") ); return 0; fi")
        print("    if [[ \"$cur\" == --target=* ]]; then local v=\"${cur#--target=}\"; COMPREPLY=( $(compgen -W \"macos linux windows\" -- \"$v\") ); COMPREPLY=( \"${COMPREPLY[@]/#/--target=}\" ); return 0; fi")
        print("    if [[ \"$prev\" == \"--arch\" ]]; then COMPREPLY=( $(compgen -W \"arm64 x64\" -- \"$cur\") ); return 0; fi")
        print("    if [[ \"$cur\" == --arch=* ]]; then local v=\"${cur#--arch=}\"; COMPREPLY=( $(compgen -W \"arm64 x64\" -- \"$v\") ); COMPREPLY=( \"${COMPREPLY[@]/#/--arch=}\" ); return 0; fi")
        print("    if [[ \"$prev\" == \"--platform\" ]]; then COMPREPLY=( $(compgen -W \"arm64-macos arm64-linux x64-windows x64-linux\" -- \"$cur\") ); return 0; fi")
        print("    if [[ \"$cur\" == --platform=* ]]; then local v=\"${cur#--platform=}\"; COMPREPLY=( $(compgen -W \"arm64-macos arm64-linux x64-windows x64-linux\" -- \"$v\") ); COMPREPLY=( \"${COMPREPLY[@]/#/--platform=}\" ); return 0; fi")
        print("  fi")
        print("")
        print("  # Positional completion (minimal):")
        print("  # - `oren dump <kind>` where kind is one of tokens|linked|graph")
        print("  # - basic file completion for primary `.oren` inputs")
        print("  if [[ \"$cmd\" == \"dump\" && \"$cur\" != -* ]]; then")
        print("    local kind_seen=0")
        print("    for w in \"${COMP_WORDS[@]:1}\"; do")
        print("      case \"$w\" in tokens|linked|graph) kind_seen=1 ;; esac")
        print("    done")
        print("    if [[ $kind_seen -eq 0 ]]; then")
        print("      COMPREPLY=( $(compgen -W \"tokens linked graph\" -- \"$cur\") )")
        print("      return 0")
        print("    fi")
        print("  fi")
        print("")
        print("  if [[ \"$cur\" != -* ]]; then")
        print("    case \"$cmd\" in")
        print("      build|emit-c|meta)")
        print("        COMPREPLY=( $(compgen -f -- \"$cur\") )")
        print("        return 0")
        print("        ;;")
        print("      dump)")
        print("        # after kind, second positional is the input file")
        print("        COMPREPLY=( $(compgen -f -- \"$cur\") )")
        print("        return 0")
        print("        ;;")
        print("      scan)")
        print("        COMPREPLY=( $(compgen -f -- \"$cur\") )")
        print("        return 0")
        print("        ;;")
        print("    esac")
        print("  fi")
        print("")
        print("  if [[ \"$cur\" == -* ]]; then")
        print("    opts=\"$_oren_root_opts\"")
        print("    case \"$cmd\" in")
        ci = 0
        while ci < oren_list_len(cmds) {
            var cname2 = cmds[ci]
            print("      " + cname2 + ") opts=\"$opts $_oren_opts_" + _completion_sanitize_var(cname2) + "\" ;;")
            ci = ci + 1
        }
        print("    esac")
        print("    COMPREPLY=( $(compgen -W \"$opts\" -- \"$cur\") )")
        print("    return 0")
        print("  fi")
        print("")
        print("  if [[ -z \"$cmd\" ]]; then")
        print("    COMPREPLY=( $(compgen -W \"$_oren_cmds\" -- \"$cur\") )")
        print("    return 0")
        print("  fi")
        print("")
        print("  case \"$cmd\" in")
        print("    completion)")
        print("      COMPREPLY=( $(compgen -W \"bash zsh\" -- \"$cur\") )")
        print("      return 0")
        print("      ;;")
        print("  esac")
        print("  return 0")
        print("}")
        print("complete -F _oren oren")
        return nil
    }

    if shell == "zsh" {
        print("#compdef oren")
        print("# zsh completion for oren (generated)")
        print("typeset -a _oren_cmds")
        print("_oren_cmds=(" + cmd_pat + ")")
        print("typeset -a _oren_root_opts")
        print("_oren_root_opts=(" + root_opts_s + ")")

        var ci2 = 0
        while ci2 < oren_list_len(cmds) {
            var cname3 = cmds[ci2]
            var cmd_obj2 = argparse._find_cmd(p, cname3)
            if cmd_obj2 == nil {
                var cmds3 = p["commands"]
                var j2 = 0
                while j2 < oren_list_len(cmds3) {
                    if cmds3[j2]["name"] == cname3 { cmd_obj2 = cmds3[j2]; break }
                    j2 = j2 + 1
                }
            }
            var opt_tokens2 = _completion_collect_opt_tokens(cmd_obj2)
            var opt_s2 = _completion_join_words(opt_tokens2)
            print("typeset -a _oren_opts_" + _completion_sanitize_var(cname3))
            print("_oren_opts_" + _completion_sanitize_var(cname3) + "=(" + opt_s2 + ")")
            ci2 = ci2 + 1
        }

        print("")
        print("function _oren() {")
        print("  local -a cmds root_opts opts")
        print("  cmds=(${_oren_cmds[@]})")
        print("  root_opts=(${_oren_root_opts[@]})")
        print("  local cur prev cmd w")
        print("  cur=${words[$CURRENT]}")
        print("  prev=\"\"")
        print("  if [[ $CURRENT -gt 1 ]]; then prev=${words[$CURRENT-1]}; fi")
        print("  cmd=\"\"")
        print("  for w in ${words[2,-1]}; do")
        print("    if [[ \"$w\" == -* ]]; then continue; fi")
        print("    case \"$w\" in")
        print("      " + cmd_pat_bar + ") cmd=\"$w\"; break ;;")
        print("    esac")
        print("  done")
        print("  # Enum-like option values (minimal; keep deterministic).")
        print("  if [[ \"$cur\" == --help=* ]]; then")
        print("    compadd -P \"--help=\" -- json")
        print("    return 0")
        print("  fi")
        print("  if [[ \"$cur\" == -h=* ]]; then")
        print("    compadd -P \"-h=\" -- json")
        print("    return 0")
        print("  fi")
        print("  if [[ \"$cmd\" == \"build\" ]]; then")
        print("    if [[ \"$prev\" == \"--backend\" ]]; then compadd -- c native bytecode; return 0; fi")
        print("    if [[ \"$cur\" == --backend=* ]]; then compadd -P \"--backend=\" -- c native bytecode; return 0; fi")
        print("    if [[ \"$prev\" == \"--stdlib-mode\" ]]; then compadd -- source obc; return 0; fi")
        print("    if [[ \"$cur\" == --stdlib-mode=* ]]; then compadd -P \"--stdlib-mode=\" -- source obc; return 0; fi")
        print("  fi")
        print("  if [[ \"$cmd\" == \"build\" || \"$cmd\" == \"meta\" || \"$cmd\" == \"dump\" ]]; then")
        print("    if [[ \"$prev\" == \"--target\" ]]; then compadd -- macos linux windows; return 0; fi")
        print("    if [[ \"$cur\" == --target=* ]]; then compadd -P \"--target=\" -- macos linux windows; return 0; fi")
        print("    if [[ \"$prev\" == \"--arch\" ]]; then compadd -- arm64 x64; return 0; fi")
        print("    if [[ \"$cur\" == --arch=* ]]; then compadd -P \"--arch=\" -- arm64 x64; return 0; fi")
        print("    if [[ \"$prev\" == \"--platform\" ]]; then compadd -- arm64-macos arm64-linux x64-windows x64-linux; return 0; fi")
        print("    if [[ \"$cur\" == --platform=* ]]; then compadd -P \"--platform=\" -- arm64-macos arm64-linux x64-windows x64-linux; return 0; fi")
        print("  fi")
        print("  # Positional completion (minimal):")
        print("  if [[ \"$cmd\" == \"dump\" && \"$cur\" != -* ]]; then")
        print("    local kind_seen=0")
        print("    for w in ${words[@]:2}; do")
        print("      case \"$w\" in tokens|linked|graph) kind_seen=1 ;; esac")
        print("    done")
        print("    if [[ $kind_seen -eq 0 ]]; then")
        print("      compadd -- tokens linked graph")
        print("      return 0")
        print("    fi")
        print("  fi")
        print("  if [[ \"$cur\" != -* ]]; then")
        print("    case \"$cmd\" in")
        print("      build|emit-c|meta|dump|scan)")
        print("        compadd -f --")
        print("        return 0")
        print("        ;;")
        print("    esac")
        print("  fi")
        print("  if [[ \"$cur\" == -* ]]; then")
        print("    opts=(${root_opts[@]})")
        print("    case \"$cmd\" in")
        ci2 = 0
        while ci2 < oren_list_len(cmds) {
            var cname4 = cmds[ci2]
            print("      " + cname4 + ") opts+=(${_oren_opts_" + _completion_sanitize_var(cname4) + "[@]}) ;;")
            ci2 = ci2 + 1
        }
        print("    esac")
        print("    compadd -- $opts")
        print("    return 0")
        print("  fi")
        print("  if [[ -z \"$cmd\" ]]; then")
        print("    compadd -- $cmds")
        print("    return 0")
        print("  fi")
        print("  case \"$cmd\" in")
        print("    completion)")
        print("      compadd -- bash zsh")
        print("      return 0")
        print("      ;;")
        print("  esac")
        print("  return 0")
        print("}")
        print("compdef _oren oren")
        return nil
    }

    print("ERROR: unsupported shell for completion: " + shell)
    print("Supported: bash, zsh")
    oren_exit(2)
    return nil
}
