	        }
	        var ctx = codegen_bytecode.bytecode_compile_program(linked_bc, {"allow_undef": allow_undef})
	        if trace_phase_path != nil {
	            var n_consts_bc = 0
	            var n_code_bc = 0
	            if ctx != nil && ctx["constants"] != nil { n_consts_bc = oren_list_len(ctx["constants"]) }
	            if ctx != nil && ctx["code_buf"] != nil { n_code_bc = _bytes_len_any(ctx["code_buf"]) }
	            else if ctx != nil && ctx["code"] != nil { n_code_bc = oren_list_len(ctx["code"]) }
	            _build_phase_log_append(trace_phase_path, "build.bytecode.codegen.done", "constants=" + oren_int_to_string(n_consts_bc) + " code=" + oren_int_to_string(n_code_bc), t_sum0)
