        }
        var native_policy_check = metadata.json_package_policy_check_for_attr(native_pkg_attr, native_profile, CAP_ALLOW_DOMAINS)
        if trace_phase_path != nil { _build_phase_log_append(trace_phase_path, "build.native.package_policy_json.done", "", t_sum0) }
        var native_policy_status = metadata.package_policy_check_status_for_attr(native_pkg_attr, native_profile, CAP_ALLOW_DOMAINS)
        _enforce_package_policy_if_requested(enforce_package_policy, "native", native_policy_status)
        var native_policy = _artifact_manifest_policy_with_package("native", CAPSULE, CAP_ALLOW_DOMAINS, native_domains, metadata.json_package_manifest_for_facts(native_pkg_attr, native_domains), native_policy_check)
        if trace_phase_path != nil { _build_phase_log_append(trace_phase_path, "build.native.package_manifest.done", "", t_sum0) }
