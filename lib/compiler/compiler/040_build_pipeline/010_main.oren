	            if trace_phase_path != nil {
	                _build_phase_log_append(trace_phase_path, "build.bytecode.emit.done", "mode=obc_link bytes=" + oren_int_to_string(_bytes_len_any(out_bytes)), t_sum0)
	            }
	            print("Bytecode emitted: " + out_path)
            if deterministic { _emit_artifact_hash("bytecode", out_path, out_bytes) }
            if emit_manifest {
