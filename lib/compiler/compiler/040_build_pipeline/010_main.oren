	        var bytecode_pkg_attr = metadata.package_attr_for_stmts(bytecode_stmts)
	        var bytecode_policy_check = metadata.json_package_policy_check_for_attr(bytecode_pkg_attr, bytecode_profile, CAP_ALLOW_DOMAINS)
	        var bytecode_policy_status = metadata.package_policy_check_status_for_attr(bytecode_pkg_attr, bytecode_profile, CAP_ALLOW_DOMAINS)
	        _enforce_package_policy_if_requested(enforce_package_policy, "bytecode", bytecode_policy_status)
	        var bytecode_policy = _artifact_manifest_policy_with_package("bytecode", CAPSULE, CAP_ALLOW_DOMAINS, bytecode_domains, metadata.json_package_manifest_for_facts(bytecode_pkg_attr, bytecode_domains), bytecode_policy_check)

	        if trace_phase_path != nil {
