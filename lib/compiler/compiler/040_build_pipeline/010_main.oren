            } else if gas_mode_env == "basic-block" {
                cfg["native_gas_accounting"] = "basic-block"
            } else if gas_mode_env == "block-weighted" {
                cfg["native_gas_accounting"] = "block-weighted"
            } else if gas_mode_env == "dynamic-emitter" {
