fn _string_index_of_char(s, ch) {
    if s == nil { return -1 }
    var i = 0
    var sl = oren_string_len(s)
    while i < sl {
        if oren_string_char_at_unchecked(s, i) == ch { return i }
        i = i + 1
    }
    return -1
}

fn _string_strip_trailing_cr(s) {
    if s == nil { return s }
    var sl = oren_string_len(s)
    if sl <= 0 { return s }
    if oren_string_char_at_unchecked(s, sl - 1) != "\r" { return s }
    return oren_string_slice(s, 0, sl - 1)
}

fn _string_trim_ws(s) {
    if s == nil { return s }
    var sl = oren_string_len(s)
    var i = 0
    var j = sl - 1
    while i < sl {
        var c = oren_string_char_at_unchecked(s, i)
        if c == " " || c == "\t" || c == "\n" || c == "\r" { i = i + 1 }
        else { break }
    }
    while j >= i {
        var c2 = oren_string_char_at_unchecked(s, j)
        if c2 == " " || c2 == "\t" || c2 == "\n" || c2 == "\r" { j = j - 1 }
        else { break }
    }
    if j < i { return "" }
    return oren_string_slice(s, i, j + 1)
}

fn _string_strip_wrapping_quotes(s) {
    if s == nil { return s }
    var sl = oren_string_len(s)
    if sl < 2 { return s }
    if oren_string_char_at_unchecked(s, 0) != "\"" { return s }
    if oren_string_char_at_unchecked(s, sl - 1) != "\"" { return s }
    return oren_string_slice(s, 1, sl - 1)
}

fn _parse_kv_lines(s) {
    var out = {}
    if s == nil { return out }
    var sl = oren_string_len(s)
    var start = 0
    var i = 0
    while i <= sl {
        var end_line = false
        if i >= sl { end_line = true }
        else if oren_string_char_at_unchecked(s, i) == "\n" { end_line = true }
        if end_line {
            var line = _string_strip_trailing_cr(oren_string_slice(s, start, i))
            if line != nil && line != "" {
                var eq = _string_index_of_char(line, "=")
                if eq >= 0 {
                    var key = oren_string_slice(line, 0, eq)
                    var val = oren_string_slice(line, eq + 1, oren_string_len(line))
                    if key != "" { out[key] = val }
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    return out
}

fn _cmd_quote_path_host(path) {
    if host_is_windows() { return cmd_quote(_path_to_windows_sep(path)) }
    return shell_quote(path)
}

fn _run_test_artifact(backend, out_path) {
    if backend == "bytecode" {
        var avm_path = "./avm"
        if host_is_windows() { avm_path = "./avm.exe" }
        if oren_exists(avm_path) != true {
            print("== ensure: avm ==")
            var mk = oren_system("make avm")
            if mk != 0 {
                print("avm build failed")
                oren_exit(1)
            }
        }
        var cmd_obc = ""
        if host_is_windows() {
            cmd_obc = "cmd.exe /d /c " + _cmd_quote_path_host(avm_path) + " " + _cmd_quote_path_host(out_path)
        } else {
            cmd_obc = _cmd_quote_path_host(avm_path) + " " + _cmd_quote_path_host(out_path)
        }
        var rc_obc = normalize_rc(oren_system(cmd_obc))
        if rc_obc != 0 {
            print("Test run failed (avm) rc=" + oren_int_to_string(rc_obc))
            oren_exit(rc_obc)
        }
        return nil
    }
    var cmd_bin = ""
    if host_is_windows() {
        cmd_bin = "cmd.exe /d /c " + _cmd_quote_path_host(out_path)
    } else {
        cmd_bin = _cmd_quote_path_host(out_path)
    }
    var rc = normalize_rc(oren_system(cmd_bin))
    if rc != 0 {
        print("Test run failed rc=" + oren_int_to_string(rc))
        oren_exit(rc)
    }
    return nil
}

fn _run_cmd_capture_stdout(cmd_line, out_path) {
    if cmd_line == nil || cmd_line == "" { return 1 }
    if out_path == nil || out_path == "" { return 1 }
    if host_is_windows() {
        ensure_dir("build/tmp")
        var t = oren_time_now_ns()
        var script = "build/tmp/oren_cmd_capture_" + oren_int_to_string(t) + ".cmd"
        var sp = _path_to_windows_sep(script)
        var out_win = _path_to_windows_sep(out_path)
        var parts = []
        oren_list_push(parts, "@echo off\r\n")
        oren_list_push(parts, "setlocal\r\n")
        oren_list_push(parts, cmd_line + " > " + cmd_quote(out_win) + "\r\n")
        oren_list_push(parts, "exit /b %errorlevel%\r\n")
        var ws = oren_write_file(sp, oren_string_join(parts))
        if oren_is_err(ws) { return 1 }
        var rc = oren_system("cmd.exe /d /c " + cmd_quote(sp))
        // Best-effort cleanup.
        oren_unlink(sp)
        return rc
    }
    return oren_system(cmd_line + " > " + shell_quote(out_path) + " 2>/dev/null")
}

fn _run_cmd_capture_trim(cmd_line, out_path) {
    if cmd_line == nil || cmd_line == "" { return nil }
    if out_path == nil || out_path == "" { return nil }
    var rc = _run_cmd_capture_stdout(cmd_line, out_path)
    if rc != 0 { return nil }
    var s = oren_read_file(out_path)
    if oren_is_err(s) { return nil }
    return _string_trim_ws(s)
}

fn _python_embed_probe_info() {
    ensure_dir("build/tmp")
    var script_path = "build/tmp/_oren_python_embed_probe.py"
    var out_path = "build/tmp/_oren_python_embed_probe.txt"
    var script = "import sys, sysconfig\n" +
        "def get(k):\n" +
        "    v = sysconfig.get_config_var(k)\n" +
        "    return v if v is not None else ''\n" +
        "print('include=' + (sysconfig.get_path('include') or ''))\n" +
        "print('plat_include=' + (sysconfig.get_path('platinclude') or ''))\n" +
        "print('libdir=' + get('LIBDIR'))\n" +
        "print('libpl=' + get('LIBPL'))\n" +
        "print('ldlibrary=' + get('LDLIBRARY'))\n" +
        "print('library=' + get('LIBRARY'))\n" +
        "print('base_prefix=' + getattr(sys, 'base_prefix', ''))\n" +
        "print('prefix=' + getattr(sys, 'prefix', ''))\n" +
        "print('version=' + (sysconfig.get_python_version() or ''))\n"
    var ws = oren_write_file(script_path, script)
    if oren_is_err(ws) { return nil }

    var candidates = []
    var env_py = oren_env("OREN_PYTHON")
    if env_py != nil && env_py != "" {
        oren_list_push(candidates, env_py)
    } else {
        oren_list_push(candidates, "python3")
        oren_list_push(candidates, "python")
        oren_list_push(candidates, "py -3")
    }
    var i = 0
    while i < oren_list_len(candidates) {
        var c0 = candidates[i]
        var c_strip = _string_strip_wrapping_quotes(c0)
        var cmd = nil
        if file_exists(c_strip) {
            var exe = c_strip
            if host_is_windows() { exe = _path_to_windows_sep(exe) }
            if host_is_windows() { cmd = cmd_quote(exe) + " " + _cmd_quote_path_host(script_path) }
            else { cmd = shell_quote(exe) + " " + _cmd_quote_path_host(script_path) }
        } else {
            cmd = c0 + " " + _cmd_quote_path_host(script_path)
        }
        var rc = _run_cmd_capture_stdout(cmd, out_path)
        if rc == 0 {
            var s = oren_read_file(out_path)
            if !oren_is_err(s) {
                var info = _parse_kv_lines(s)
                if info != nil && info["include"] != nil && info["include"] != "" {
                    oren_unlink(script_path)
                    oren_unlink(out_path)
                    return info
                }
            }
        }
        i = i + 1
    }
    oren_unlink(script_path)
    oren_unlink(out_path)
    return nil
}

fn _msvc_python_embed_flags() {
    var info = _python_embed_probe_info()
    if info == nil { return nil }
    var flags = ["/DOREN_ENABLE_PYTHON"]
    var inc = info["include"]
    if inc != nil && inc != "" { oren_list_push(flags, "/I" + inc) }
    var pinc = info["plat_include"]
    if pinc != nil && pinc != "" && pinc != inc { oren_list_push(flags, "/I" + pinc) }
    var libname = info["ldlibrary"]
    if libname == nil || libname == "" { libname = info["library"] }
    if libname == nil || libname == "" {
        var ver = info["version"]
        if ver != nil && ver != "" {
            var digits = ""
            var vi = 0
            while vi < oren_string_len(ver) {
                var ch = oren_string_char_at_unchecked(ver, vi)
                if ch >= "0" && ch <= "9" { digits = digits + ch }
                vi = vi + 1
            }
            if oren_string_len(digits) >= 2 {
                libname = "python" + digits + ".lib"
            }
        }
    }
    if libname == nil || libname == "" { return nil }
    var libdirs = []
    var libpl = info["libpl"]
    var libdir = info["libdir"]
    if libpl != nil && libpl != "" { oren_list_push(libdirs, libpl) }
    if libdir != nil && libdir != "" && libdir != libpl { oren_list_push(libdirs, libdir) }
    var prefix = info["prefix"]
    if prefix != nil && prefix != "" { oren_list_push(libdirs, prefix + "/libs") }
    var base_prefix = info["base_prefix"]
    if base_prefix != nil && base_prefix != "" && base_prefix != prefix {
        oren_list_push(libdirs, base_prefix + "/libs")
    }
    if oren_list_len(libdirs) == 0 { return nil }
    oren_list_push(flags, "/link")
    var j = 0
    while j < oren_list_len(libdirs) {
        var d = libdirs[j]
        if d != nil && d != "" {
            if host_is_windows() { d = _path_to_windows_sep(d) }
            oren_list_push(flags, "/LIBPATH:" + d)
        }
        j = j + 1
    }
    oren_list_push(flags, libname)
    return flags
}

fn compiler_main() {
    // Modern CLI parsing (click-style):
    // - supports `--opt=value` and interspersed options/args
    // - allows options before the positional file (`oren build --backend=native file.oren`)
    // - parse once via std/argparse and dispatch directly from the parsed result
    var raw_args = oren_args()
    if raw_args == nil { usage(); return nil }
    var raw_argc = oren_list_len(raw_args)
    if raw_argc < 2 { usage(); return nil }

    var dbg_args = oren_env("OREN_DEBUG_ARGS")
    if dbg_args != nil {
        var di0 = 0
        while di0 < raw_argc {
            print("RAW_ARG[" + oren_int_to_string(di0) + "] = " + raw_args[di0])
            var dbg_args_len = oren_env("OREN_DEBUG_ARGS_LEN")
            if dbg_args_len != nil {
                print("RAW_ARG_LEN[" + oren_int_to_string(di0) + "] = " + oren_int_to_string(oren_string_len(raw_args[di0])))
            }
            di0 = di0 + 1
        }
    }

    // argv excludes the program name.
    var argv = []
    var ai = 1
    while ai < raw_argc {
        oren_list_push(argv, raw_args[ai])
        ai = ai + 1
    }

    // Rolling legacy alias: `oren --emit-c <file>` is treated as `oren emit-c <file>`.
    if oren_list_len(argv) > 0 && argv[0] == "--emit-c" {
        var argv2 = ["emit-c"]
        var j = 1
        while j < oren_list_len(argv) {
            oren_list_push(argv2, argv[j])
            j = j + 1
        }
        argv = argv2
    }

    var dbg_boot = oren_env("OREN_DEBUG_BOOT")
    if dbg_boot != nil { print("DEBUG_BOOT before cli_spec") }
    var cli = cli_spec()
    if dbg_boot != nil { print("DEBUG_BOOT after cli_spec") }
    if dbg_boot != nil { print("DEBUG_BOOT before argparse.parse") }
    var parsed = argparse.parse(cli, argv)
    if dbg_boot != nil { print("DEBUG_BOOT after argparse.parse") }

    // Debug hook for native self-hosting bringup:
    // Stage2 native sometimes exits early without emitting diagnostics.
    // This print is gated behind an env var so it does not affect normal output.
    var dbg_parse = oren_env("OREN_DEBUG_PARSE")
    if dbg_parse != nil {
        var ok_s = "false"
        if parsed["ok"] == true { ok_s = "true" }
        var code_v = parsed["code"]
        if code_v == nil { code_v = -999 }
        var cmd_s = parsed["cmd"]
        if cmd_s == nil { cmd_s = "<nil>" }
        print("DEBUG_PARSE ok=" + ok_s + " code=" + oren_int_to_string(code_v) + " cmd=" + cmd_s)
        if parsed["err"] != nil { print("DEBUG_PARSE err=" + parsed["err"]) }
        if parsed["help"] != nil { print("DEBUG_PARSE help_len=" + oren_int_to_string(oren_string_len(parsed["help"]))) }
    }

    if parsed["help"] != nil && parsed["code"] == 0 {
        print(parsed["help"])
        return nil
    }
    // Global version flag: must work even with no subcommand.
    if parsed["all_opts"] != nil && parsed["all_opts"]["version"] == true {
        print("oren " + OREN_VERSION)
        return nil
    }
    if parsed["ok"] != true {
        var emsg = parsed["err"]
        if emsg != nil {
            emit_diag("compile", 2, emsg)
            print(emsg)
        }
        if parsed["help"] != nil { print(parsed["help"]) }
        if dbg_parse != nil {
            var code_v2 = parsed["code"]
            if code_v2 == nil { code_v2 = -999 }
            print("DEBUG_PARSE exiting code=" + oren_int_to_string(code_v2))
        }
        oren_exit(parsed["code"])
    }
    if parsed["cmd"] == nil || parsed["cmd"] == "" {
        usage()
        return nil
    }

    var cmd_name = parsed["cmd"]
    var pos = parsed["pos"]
    var opts = parsed["opts"]
    var seen = parsed["seen"]
    var dbg_flow = oren_env("OREN_DEBUG_FLOW")
    if dbg_flow != nil {
        print("DEBUG_FLOW cmd=" + cmd_name)
    }

    if cmd_name == "completion" {
        var sh = "bash"
        if pos != nil && oren_list_len(pos) > 0 {
            if pos[0] != nil && pos[0] != "" { sh = pos[0] }
        }
        completion_emit(sh)
        return nil
    }

    if cmd_name == "sym" {
        // Resolve a program counter address to a function name (native debug builds).
        //
        // Motivation: native stage2 bringup can crash in deep recursion; `nm` is not useful
        // for our custom native emitter outputs. `resolve_symbol` is generated in native
        // debug builds and can map addresses back to function names.
        if pos == nil || oren_list_len(pos) < 1 {
            usage_cmd("sym")
            oren_exit(2)
        }
        var addr_s = pos[0]
        var addr = optimizer.parse_int(addr_s)
        if addr == nil {
            emit_diag("compile", 2, "oren sym: invalid address: " + addr_s)
            print("oren sym: invalid address: " + addr_s)
            oren_exit(2)
        }
        print(oren_resolve_symbol(addr))
        return nil
    }

    if cmd_name == "scan" {
        var lib = pos[0]
        ensure_dir("build/tmp")
        var nm_out = "build/tmp/scan_tmp.txt"

        // Preferred (rolling): if this library was produced by Oren's `--lib` output,
        // there is a generated C header next to it. Prefer parsing the header so this
        // command works cross-platform (macOS `nm` cannot read PE/ELF, and stripped
        // shared objects may not expose text symbols).
        //
        // Example:
        //   ./oren build examples/libmath.oren --backend native --lib -o build/libmath.dylib --metadata
        // produces:
        //   build/libmath.dylib
        //   build/libmath.h
        // Find the last '.' in the path (extension separator). Keep this local: not all
        // runtimes expose a "last_index_of" helper.
        var dot_idx = nil
        var _lib_len = oren_string_len(lib)
        var _p = _lib_len - 1
        while _p >= 0 {
            if oren_string_char_at(lib, _p) == "." {
                dot_idx = _p
                _p = -1
            } else {
                _p = _p - 1
            }
        }
        var hdr_guess = nil
        if dot_idx != nil && dot_idx > 0 {
            hdr_guess = oren_string_slice(lib, 0, dot_idx) + ".h"
        } else {
            hdr_guess = lib + ".h"
        }
        var hdr = oren_read_file(hdr_guess)
        if !oren_is_err(hdr) {
            // Prefer a tiny line-based parser over `nm` for Oren-generated headers.
            // This keeps `oren scan` useful cross-platform (macOS cannot `nm` PE/ELF)
            // and stays deterministic even when the shared object is stripped.
            print("# API Documentation for " + lib)
            print("")
            print("| Symbol | Address | Type | Signature |")
            print("|---|---|---|---|")

            var s = hdr
            var n = oren_string_len(s)
            var idx = 0
            var line_start = 0
            var seen = {}
            while idx <= n {
                if idx == n || oren_string_char_at(s, idx) == "\n" {
                    var line = oren_string_slice(s, line_start, idx)
                    line_start = idx + 1

                    // Trim trailing CR (Windows headers).
                    var ll = oren_string_len(line)
                    if ll > 0 && oren_string_char_at(line, ll - 1) == "\r" {
                        line = oren_string_slice(line, 0, ll - 1)
                        ll = ll - 1
                    }

                    // Trim leading/trailing spaces/tabs.
                    var l = 0
                    while l < ll {
                        var ch = oren_string_char_at(line, l)
                        if ch == " " || ch == "\t" { l = l + 1 }
                        else { break }
                    }
                    var r = ll
                    while r > l {
                        var ch2 = oren_string_char_at(line, r - 1)
                        if ch2 == " " || ch2 == "\t" { r = r - 1 }
                        else { break }
                    }
                    if r <= l {
                        idx = idx + 1
                        continue
                    }
                    line = oren_string_slice(line, l, r)
                    ll = oren_string_len(line)

                    // Match: extern <ret> <name>(...);
                    if ll >= 7 && oren_string_slice(line, 0, 7) == "extern " {
                        // Ignore: extern "C" { ... }
                        if ll >= 10 && oren_string_slice(line, 0, 10) == "extern \"C\"" {
                            idx = idx + 1
                            continue
                        }

                        // Must end with ';'.
                        if oren_string_char_at(line, ll - 1) != ";" {
                            idx = idx + 1
                            continue
                        }

                        // Find '('.
                        var open = -1
                        var k = 0
                        while k < ll {
                            if oren_string_char_at(line, k) == "(" {
                                open = k
                                k = ll
                            } else {
                                k = k + 1
                            }
                        }
                        if open <= 0 {
                            idx = idx + 1
                            continue
                        }

                        // Signature for display: strip leading `extern ` and trailing `;`.
                        var sig = oren_string_slice(line, 7, ll - 1)
                        // Trim spaces after removing ';'.
                        var sig_len = oren_string_len(sig)
                        while sig_len > 0 {
                            var c0 = oren_string_char_at(sig, sig_len - 1)
                            if c0 == " " || c0 == "\t" {
                                sig = oren_string_slice(sig, 0, sig_len - 1)
                                sig_len = sig_len - 1
                            } else {
                                sig_len = 0
                            }
                        }

                        // Extract the function name token: last identifier before '('.
                        var p = open - 1
                        while p >= 0 {
                            var c = oren_string_char_at(line, p)
                            if c == " " || c == "\t" { p = p - 1 }
                            else { break }
                        }
                        var name_end = p + 1
                        var name_start = p
                        while name_start >= 0 {
                            var c2 = oren_string_char_at(line, name_start)
                            var ok = false
                            if c2 == "_" { ok = true }
                            else if c2 >= "a" && c2 <= "z" { ok = true }
                            else if c2 >= "A" && c2 <= "Z" { ok = true }
                            else if c2 >= "0" && c2 <= "9" { ok = true }
                            if !ok {
                                name_start = name_start + 1
                                break
                            }
                            name_start = name_start - 1
                        }
                        if name_start < 0 { name_start = 0 }
                        if name_end > name_start {
                            var name = oren_string_slice(line, name_start, name_end)
                            if name != nil && name != "" {
                                // Keep output stable and avoid duplicates.
                                if seen[name] != true {
                                    seen[name] = true
                                    print("| " + name + " | - | Function | " + sig + " |")
                                }
                            }
                        }
                    }
                }
                idx = idx + 1
            }
            return nil
        }

        // Host-aware nm flags:
        // - macOS: `nm -gU` (external, no undefineds; underscores in symbols)
        // - Linux: `nm -gD` (dynamic symbols from shared objects)
        // - Windows: best-effort (`nm -g` if present)
        var hostp = detect_host_platform()
        var nm_flags = "-gU"
        if hostp != nil && hostp["target"] == "linux" { nm_flags = "-gD" }
        else if hostp != nil && hostp["target"] == "windows" { nm_flags = "-g" }

        var cmd = "nm " + nm_flags + " " + shell_quote(lib) + " > " + shell_quote(nm_out)
        if oren_system(cmd) != 0 {
            print("Scan failed (nm not found or lib invalid?)")
            return nil
        }
        var content = oren_read_file(nm_out)
        if oren_is_err(content) {
            print("Scan failed (cannot read nm output): " + nm_out)
            var msg = oren_err_msg(content)
            if msg != nil { print(msg) }
            return nil
        }
        var len = oren_string_len(content)
        var idx = 0
        
        print("# API Documentation for " + lib)
        print("")
        print("| Symbol | Address | Type | Signature |")
        print("|---|---|---|---|")
        
        // Parse lines: address T symbol
        var line_start = 0
        while idx < len {
            if oren_string_char_at(content, idx) == "\n" {
                var line = oren_string_slice(content, line_start, idx)
                // Parse line
                // Format: "0000000000003f50 T _my_api_func"
                // Check if contains " T " (or " t " on some toolchains)
                // Simple search
                var t_idx = -1
                var k = 0
                var l_len = oren_string_len(line)
                while k < l_len - 3 {
                    if oren_string_char_at(line, k) == " " {
                        var kind = oren_string_char_at(line, k+1)
                        if kind == "T" || kind == "t" {
                            if oren_string_char_at(line, k+2) == " " { t_idx = k; k = l_len }
                        }
                    }
                    k = k + 1
                }
                
                if t_idx != -1 {
                    var addr = oren_string_slice(line, 0, t_idx)
                    var sym = oren_string_slice(line, t_idx + 3, l_len)
                    // Trim CR if any
                    // macOS symbols have _ prefix.
                    if oren_string_char_at(sym, 0) == "_" {
                        sym = oren_string_slice(sym, 1, oren_string_len(sym))
                    }
                    print("| " + sym + " | " + addr + " | Function | - |")
                }
                
                line_start = idx + 1
            }
            idx = idx + 1
        }
        
        // Best-effort cleanup: delete the temporary nm output.
        // Do not fail the command if cleanup fails.
        if host_is_windows() { nm_out = _path_to_windows_sep(nm_out) }
        oren_unlink(nm_out)
        return nil
    }

    if cmd_name == "clean" {
        // Env-aware default is already handled by std:argparse (OREN_CACHE_DIR).
        var cd = opts["cache-dir"]
        if cd == nil || cd == "" { cd = _cache_default_dir() }
        cache_clean_dir(cd)
        return nil
    }

    if cmd_name == "selftest-native" {
        // This command must be fast and must not rely on the compiler pipelines.
        // It exists so the native self-host gate can validate runtime correctness without
        // running the full compiler on large source graphs.
        selftest_native_run()
        return nil
    }

    if cmd_name == "dump" {
        if dbg_flow != nil { print("DEBUG_FLOW enter dump") }
        var kind = pos[0]
        var path = pos[1]
        if dbg_flow != nil { print("DEBUG_FLOW dump kind=" + kind + " path=" + path) }

        // Modern CLI: options parsed/validated by std:argparse.
        var target = opts["target"]
        var arch = opts["arch"]
        // `--target/--arch` are legacy and now support `auto` to mean "runtime host".
        // If the user explicitly passes `--target auto` / `--arch auto`, treat them as unset.
        if target == "auto" { target = ""; seen["target"] = false }
        if arch == "auto" { arch = ""; seen["arch"] = false }
        var platform0 = opts["platform"]
        if platform0 == nil || platform0 == "" { platform0 = oren_env("OREN_PLATFORM") }
        if platform0 != nil && platform0 != "" {
            var ps0 = parse_platform_spec(platform0)
            if ps0 == nil {
                var emsg0 = "oren dump: invalid --platform " + platform0 + " (expected: <arch>-<os>)"
                emit_diag("compile", 2, emsg0)
                print(emsg0)
                oren_exit(2)
            }
            arch = ps0["arch"]
            target = ps0["os"]
        } else {
            // Default to the runtime host platform when the user did not specify
            // --platform/--target/--arch (rolling correctness for Linux+Windows bring-up).
            var host0 = detect_host_platform()
            if host0 != nil {
                if seen["arch"] != true { arch = host0["arch"] }
                if seen["target"] != true { target = host0["target"] }
            }
        }
        if target == nil || target == "" || arch == nil || arch == "" {
            var emsg_det = "oren dump: could not determine target platform; pass --platform <arch>-<os> or set OREN_PLATFORM"
            emit_diag("compile", 2, emsg_det)
            print(emsg_det)
            oren_exit(2)
        }
        var outp = ""
        if seen["out"] == true { outp = opts["out"] }

        var strict = (opts["strict-attrs"] == true)
        var allow = split_csv(opts["attr-allow-prefixes"])

        if kind == "tokens" {
            if dbg_flow != nil { print("DEBUG_FLOW dump tokens start") }
            var js = dump.dump_tokens_json(path, strict, allow, (opts["strict-ident-prefixes"] == true), split_csv(opts["ident-allow-prefixes"]))
            if js == nil {
                emit_diag("compile", 2, "dump tokens failed: " + path)
                oren_exit(1)
            }
            if dbg_flow != nil { print("DEBUG_FLOW dump tokens got_json") }
            var rc = dump.write_or_print(outp, js)
            if rc != 0 {
                emit_diag("compile", 2, "Failed to write dump output: " + outp)
                oren_exit(rc)
            }
            return nil
        }
        if kind == "linked" {
            if dbg_flow != nil { print("DEBUG_FLOW dump linked start") }
            var rr = expand_includes_file_result(path, [])
            if rr["ok"] != true {
                var emsg = "Failed to read file: " + path
                var msg = rr["err"]
                if msg != nil { emsg = emsg + " (" + msg + ")" }
                emit_diag("compile", 2, emsg)
                print("Failed to read file: " + path)
                if msg != nil { print(msg) }
                oren_exit(2)
            }
            var src = rr["src"]
            if dbg_flow != nil { print("DEBUG_FLOW dump linked got_src") }
            var l = lexer.new_lexer(src)
            l["file"] = path
            var p = parser.new_parser(l)
            p["strict_attrs"] = strict
            p["attr_allow_prefixes"] = allow
            p["strict_ident_prefixes"] = (opts["strict-ident-prefixes"] == true)
            p["ident_allow_prefixes"] = split_csv(opts["ident-allow-prefixes"])
            var prog = parser.parse_program(p)
            if oren_list_len(p["errors"]) > 0 {
                var first_err = nil
                if oren_list_len(p["errors"]) > 0 { first_err = p["errors"][0] }
                emit_diag("parse", 1, first_err)
                print("Parse errors:")
                var ei = 0
                while ei < oren_list_len(p["errors"]) {
                    print(p["errors"][ei])
                    ei = ei + 1
                }
                oren_exit(1)
            }
            var cfg_debug = true
            var v_nd = oren_env("OREN_NATIVE_NO_DEBUG")
            if v_nd != nil && v_nd != "" && v_nd != "0" && v_nd != "false" { cfg_debug = false }
            var backend0 = opts["backend"]
            if backend0 == nil { backend0 = "c" }
            var linked = link_program(path, prog, {"target": target, "arch": arch, "backend": backend0, "debug": cfg_debug, "keep_all_top_level_functions": true})
            if dbg_flow != nil { print("DEBUG_FLOW dump linked linked_ok") }
            var js2 = dump.linked_summary_json(linked)
            var rc2 = dump.write_or_print(outp, js2)
            if rc2 != 0 {
                emit_diag("compile", 2, "Failed to write dump output: " + outp)
                oren_exit(rc2)
            }
            return nil
        }
        if kind == "graph" {
            if dbg_flow != nil { print("DEBUG_FLOW dump graph start") }
            var rrg = expand_includes_file_result(path, [])
            if rrg["ok"] != true {
                var emsgg = "Failed to read file: " + path
                var msgg = rrg["err"]
                if msgg != nil { emsgg = emsgg + " (" + msgg + ")" }
                emit_diag("compile", 2, emsgg)
                print("Failed to read file: " + path)
                if msgg != nil { print(msgg) }
                oren_exit(2)
            }
            var srcg = rrg["src"]
            if dbg_flow != nil { print("DEBUG_FLOW dump graph got_src") }
            var lg = lexer.new_lexer(srcg)
            lg["file"] = path
            var pg = parser.new_parser(lg)
            pg["strict_attrs"] = strict
            pg["attr_allow_prefixes"] = allow
            pg["strict_ident_prefixes"] = (opts["strict-ident-prefixes"] == true)
            pg["ident_allow_prefixes"] = split_csv(opts["ident-allow-prefixes"])
            var progg = parser.parse_program(pg)
            if oren_list_len(pg["errors"]) > 0 {
                var first_err = nil
                if oren_list_len(pg["errors"]) > 0 { first_err = pg["errors"][0] }
                emit_diag("parse", 1, first_err)
                print("Parse errors:")
                var eig = 0
                while eig < oren_list_len(pg["errors"]) {
                    print(pg["errors"][eig])
                    eig = eig + 1
                }
                oren_exit(1)
            }
            var cfg_debugg = true
            var v_ndg = oren_env("OREN_NATIVE_NO_DEBUG")
            if v_ndg != nil && v_ndg != "" && v_ndg != "0" && v_ndg != "false" { cfg_debugg = false }
            var backend0g = opts["backend"]
            if backend0g == nil { backend0g = "c" }
            var linkedg = link_program(path, progg, {"target": target, "arch": arch, "backend": backend0g, "debug": cfg_debugg, "keep_all_top_level_functions": true})
            if dbg_flow != nil { print("DEBUG_FLOW dump graph linked_ok") }
            var graph = linkedg["module_graph"]
            var jsg = dump.module_graph_json(graph)
            var rcg = dump.write_or_print(outp, jsg)
            if rcg != 0 {
                emit_diag("compile", 2, "Failed to write dump output: " + outp)
                oren_exit(rcg)
            }
            return nil
        }

        emit_diag("compile", 2, "Unknown dump kind: " + kind + " (expected: tokens|linked|graph)")
        print("Unknown dump kind: " + kind + " (expected: tokens|linked|graph)")
        oren_exit(2)
    }

    if cmd_name == "meta" {
        if dbg_flow != nil { print("DEBUG_FLOW enter meta") }
        var path = pos[0]

        // Modern CLI: options already parsed/validated by std/argparse.
        var target = opts["target"]
        var arch = opts["arch"]
        // `--target/--arch` are legacy and now support `auto` to mean "runtime host".
        // If the user explicitly passes `--target auto` / `--arch auto`, treat them as unset.
        if target == "auto" { target = ""; seen["target"] = false }
        if arch == "auto" { arch = ""; seen["arch"] = false }
        var platform0 = opts["platform"]
        if platform0 == nil || platform0 == "" { platform0 = oren_env("OREN_PLATFORM") }
        if platform0 != nil && platform0 != "" {
            var ps0 = parse_platform_spec(platform0)
            if ps0 == nil {
                var emsg0 = "oren meta: invalid --platform " + platform0 + " (expected: <arch>-<os>)"
                emit_diag("compile", 2, emsg0)
                print(emsg0)
                oren_exit(2)
            }
            arch = ps0["arch"]
            target = ps0["os"]
        } else {
            // Default to runtime host platform unless the user explicitly overrides.
            var host0 = detect_host_platform()
            if host0 != nil {
                if seen["arch"] != true { arch = host0["arch"] }
                if seen["target"] != true { target = host0["target"] }
            }
        }
        if target == nil || target == "" || arch == nil || arch == "" {
            var emsg_det2 = "oren meta: could not determine target platform; pass --platform <arch>-<os> or set OREN_PLATFORM"
            emit_diag("compile", 2, emsg_det2)
            print(emsg_det2)
            oren_exit(2)
        }
        // Default output: keep artifacts under build/targets/<arch>-<os>/<kind>/... for a clean repo layout.
        // (Repo-local outputs make rolling iteration predictable for humans + AI agents.)
        var out_meta = "build/targets/" + arch + "-" + target + "/meta/" + basename(strip_suffix(path, ".oren")) + ".meta.json"

        var deterministic = (opts["deterministic"] == true)
        var emit_manifest = false
        if seen["manifest"] == true { emit_manifest = true }

        STRICT_ATTRS = (opts["strict-attrs"] == true)
        ATTR_ALLOW_PREFIXES = split_csv(opts["attr-allow-prefixes"])
        STRICT_IDENT_PREFIXES = (opts["strict-ident-prefixes"] == true)
        IDENT_ALLOW_PREFIXES = split_csv(opts["ident-allow-prefixes"])
        if seen["out"] == true { out_meta = opts["out"] }

        var rr = expand_includes_file_result(path, [])
        if rr["ok"] != true {
            var emsg = "Failed to read file: " + path
            var msg = rr["err"]
            if msg != nil { emsg = emsg + " (" + msg + ")" }
            emit_diag("compile", 2, emsg)
            print("Failed to read file: " + path)
            if msg != nil { print(msg) }
            oren_exit(2)
        }
        var src = rr["src"]
        var l = lexer.new_lexer(src)
        l["file"] = path
        var p = parser.new_parser(l)
        p["strict_attrs"] = STRICT_ATTRS
        p["attr_allow_prefixes"] = ATTR_ALLOW_PREFIXES
        p["strict_ident_prefixes"] = STRICT_IDENT_PREFIXES
        p["ident_allow_prefixes"] = IDENT_ALLOW_PREFIXES
        var prog = parser.parse_program(p)
        if oren_list_len(p["errors"]) > 0 {
            var first_err = nil
            if oren_list_len(p["errors"]) > 0 { first_err = p["errors"][0] }
            emit_diag("parse", 1, first_err)
            print("Parse errors:")
            var ei = 0
            while ei < oren_list_len(p["errors"]) {
                print(p["errors"][ei])
                ei = ei + 1
            }
            oren_exit(1)
        }

        // `oren meta` is an introspection command; it should include metadata for all
        // declared symbols, not only those reachable from `main`.
        var cfg_debugm = true
        var v_ndm = oren_env("OREN_NATIVE_NO_DEBUG")
        if v_ndm != nil && v_ndm != "" && v_ndm != "0" && v_ndm != "false" { cfg_debugm = false }
        var backend0m = opts["backend"]
        if backend0m == nil { backend0m = "c" }
        var linked = link_program(path, prog, {"target": target, "arch": arch, "backend": backend0m, "debug": cfg_debugm, "keep_all_top_level_functions": true})
        var meta_json = metadata.generate_metadata(linked)
        ensure_dir(dirname(out_meta))
        var w = oren_write_file(out_meta, meta_json)
        if oren_is_err(w) {
            var emsgW = "Failed to write metadata: " + out_meta
            var msgw = oren_err_msg(w)
            if msgw != nil { emsgW = emsgW + " (" + msgw + ")" }
            emit_diag("compile", 2, emsgW)
            print("Failed to write metadata: " + out_meta)
            if msgw != nil { print(msgw) }
            oren_exit(1)
        }
        print("Wrote metadata: " + out_meta)
        if deterministic || emit_manifest {
            var bs = oren_read_bytes(out_meta)
            if oren_is_err(bs) {
                var emsgH = "Failed to read artifact for hashing: " + out_meta
                var msgH = oren_err_msg(bs)
                if msgH != nil { emsgH = emsgH + " (" + msgH + ")" }
                emit_diag("compile", 2, emsgH)
                print("Failed to read artifact for hashing: " + out_meta)
                if msgH != nil { print(msgH) }
                oren_exit(1)
            }
            if deterministic { _emit_artifact_hash("meta", out_meta, bs) }
            if emit_manifest {
                var h = _sha256_hex(bs)
                _write_artifact_manifest("meta", out_meta, h, target, arch, deterministic, _bytes_len_any(bs))
            }
        }
        return nil
    }

    var run_after_build = false
    var test_mode = false
    if cmd_name == "test" {
        run_after_build = true
        test_mode = true
    }
    if cmd_name != "build" && cmd_name != "emit-c" && cmd_name != "test" {
        // Should not happen: argparse parse() already validated commands.
        emit_diag("compile", 2, "unknown command: " + cmd_name)
        print("unknown command: " + cmd_name)
        oren_exit(2)
    }
    // Normalize path separators early so Windows-style CLI invocations work across hosts:
    // - remote Win11 scripts may call `examples\\myapp.oren`
    // - on non-Windows hosts, '\' would otherwise be treated as a literal filename character
    //   and also leak into default output naming.
    var path = _path_to_posix_sep(pos[0])
    var out_path = "" // computed after parsing target/arch/backend
    var emit_c = false
    var enable_python = false
    var cc = "cc"
    var backend = "c"
    var target = "macos"
    var arch = "arm64"
    var disasm = false
    var analyze = false
    var codesign_id = ""
    var notarize = false
    var notary_profile = ""
    var no_gc = false
    var emit_meta = false
    var is_shared_lib = false
    var deterministic = false
    var emit_manifest = false
    var do_typecheck = false
    var call_depth_max = 8192
    var obc_lib = false
    var stdlib_mode = "source"
    var stdlib_obc = ""
    var link_obc = []
    // Rolling mode: default native builds to embed debug info so panics produce readable stack traces.
    // Users can still disable by setting `--no-debug` (or `OREN_NATIVE_NO_DEBUG=1`).
    var debug_mode = false
    var link_libs = []
    if cmd_name == "emit-c" { emit_c = true }

    // Optional tracing for diagnosing build hangs in self-hosted compilers.
    // Enable with: OREN_TRACE_BUILD=1
    var trace_build = oren_env("OREN_TRACE_BUILD") != nil
    if trace_build { print("[build] enter cmd=" + cmd_name + " path=" + path) }

    // Bounded build-phase timing summary (avoid large logs).
    //
    // - `OREN_TRACE_BUILD_SUMMARY=1` prints a single summary line per build (native backend path).
    // - `OREN_TRACE_BUILD_SLOW_MS=<n>` prints the summary only if total_ms >= n.
    //   (Setting it implies summary enabled; invalid values treated as 0.)
    var trace_build_summary = oren_env("OREN_TRACE_BUILD_SUMMARY") != nil
    var slow_ms = -1
    var v_slow = oren_env("OREN_TRACE_BUILD_SLOW_MS")
    if v_slow != nil && v_slow != "" {
        slow_ms = _build_parse_nonneg_dec_or_neg1(v_slow)
        if slow_ms < 0 { slow_ms = 0 }
        trace_build_summary = true
    }
    var t_sum0 = 0
    var t_sum_read_done = 0
    var t_sum_parse_done = 0
    var t_sum_link_done = 0
    var t_sum_emit_done = 0
    var t_sum_codesign_done = 0
    var t_sum_hash_done = 0
    if trace_build_summary { t_sum0 = oren_time_now_ns() }
    // These options can also be configured via env (wired via std:argparse env defaults).
    // Use parsed opts as the canonical source to keep precedence consistent.

    // Modern CLI: options already parsed/validated by std/argparse; map parsed fields to vars.
    if cmd_name == "emit-c" {
        backend = "c"
        emit_c = true
    } else {
        backend = opts["backend"]
        if seen["emit-c"] == true { emit_c = true }
    }
    if trace_build { print("[build] parsed backend=" + backend) }
    cc = opts["cc"]
    if trace_build { print("[build] parsed cc=" + cc) }
    target = opts["target"]
    arch = opts["arch"]
    // `--target/--arch` are legacy and now support `auto` to mean "runtime host".
    // If the user explicitly passes `--target auto` / `--arch auto`, treat them as unset.
    if target == "auto" { target = ""; seen["target"] = false }
    if arch == "auto" { arch = ""; seen["arch"] = false }
    if trace_build { print("[build] parsed target=" + target + " arch=" + arch) }
    var platform0 = opts["platform"]
    if platform0 == nil || platform0 == "" { platform0 = oren_env("OREN_PLATFORM") }
    if platform0 != nil && platform0 != "" {
        if trace_build { print("[build] parsed platform=" + platform0) }
        var ps0 = parse_platform_spec(platform0)
        if ps0 == nil {
            var emsg0 = "oren build: invalid --platform " + platform0 + " (expected: <arch>-<os>)"
            emit_diag("compile", 2, emsg0)
            print(emsg0)
            oren_exit(2)
        }
        arch = ps0["arch"]
        target = ps0["os"]
    } else {
        // Default to the compiler's runtime host platform unless explicitly overridden.
        // This keeps `oren build ... --backend native` runnable on Linux/Windows hosts.
        var host0 = detect_host_platform()
        if host0 != nil {
            if seen["arch"] != true { arch = host0["arch"] }
            if seen["target"] != true { target = host0["target"] }
        }
    }
    if (target == nil || target == "" || arch == nil || arch == "") {
        var emsg_det3 = "oren build: could not determine target platform; pass --platform <arch>-<os> or set OREN_PLATFORM"
        emit_diag("compile", 2, emsg_det3)
        print(emsg_det3)
        oren_exit(2)
    }
    if trace_build { print("[build] effective target=" + target + " arch=" + arch) }

    // Windows host policy (rolling):
    // - default `--cc` should prefer MSVC `cl.exe` so `oren build --backend c` works
    //   from a plain shell (the compiler will attempt to auto-configure VS env).
    //
    // IMPORTANT:
    // - this policy is for *Windows hosts*. Do not set `--cc=cl.exe` by default when
    //   cross-compiling to Windows from a non-Windows host.
    var host_win = host_is_windows()
    if host_win && target == "windows" && seen["cc"] != true {
        if cc == nil || cc == "" || cc == "cc" {
            cc = "cl.exe"
            if trace_build { print("[build] windows default cc=cl.exe") }
        }
    }
    disasm = seen["disasm"] == true
    // Debug info policy (native backend):
    // - default: enabled for native builds (production ergonomics: readable stack traces)
    // - opt-out: `--no-debug` or `OREN_NATIVE_NO_DEBUG=1`
    // - opt-in override: `--debug` force-enables even if env/flag disabled (unless both flags passed)
    if backend == "native" { debug_mode = true }
    if seen["no-debug"] == true { debug_mode = false }
    if seen["debug"] == true { debug_mode = true }
    if seen["debug"] == true && seen["no-debug"] == true {
        var emsg = "oren build: cannot use both --debug and --no-debug"
        emit_diag("compile", 2, emsg)
        print(emsg)
        oren_exit(2)
    }
    // Call depth budget (shared contract across backends):
    // - default (unset): 8192
    // - 0: unlimited (disable deterministic call-depth abort)
    // - negative: treated as default (8192)
    //
    // IMPORTANT (native runtime semantics):
    // Avoid reading an unset option out of `opts` because missing keys can surface as `0`
    // (native `nil` sentinel), which would incorrectly mean "unlimited". Only override the
    // default if the flag was explicitly provided.
    if seen["call-depth-max"] == true {
        call_depth_max = opts["call-depth-max"]
        if call_depth_max < 0 { call_depth_max = 8192 }
    }
    analyze = seen["analyze"] == true
    emit_meta = seen["metadata"] == true
    is_shared_lib = seen["lib"] == true || seen["shared"] == true
    enable_python = seen["python"] == true
    do_typecheck = seen["typecheck"] == true
    obc_lib = seen["obc-lib"] == true
    stdlib_mode = opts["stdlib-mode"]
    stdlib_obc = opts["stdlib-obc"]
    link_obc = opts["link-obc"]
    link_libs = opts["link"]
    if test_mode {
        if emit_c {
            emit_diag("compile", 2, "oren test: --emit-c is not supported")
            print("oren test: --emit-c is not supported")
            oren_exit(2)
        }
        if is_shared_lib {
            emit_diag("compile", 2, "oren test: --lib/--shared are not supported")
            print("oren test: --lib/--shared are not supported")
            oren_exit(2)
        }
        if obc_lib {
            emit_diag("compile", 2, "oren test: --obc-lib is not supported")
            print("oren test: --obc-lib is not supported")
            oren_exit(2)
        }
    }

    // macOS codesign policy (rolling):
    // - For local execution, macOS can reject/kill unsigned binaries.
    // - Default to *ad-hoc signing* (`codesign -s -`) so outputs are runnable.
    // - Developer ID signing is opt-in via `--codesign <identity>` / `OREN_CODESIGN_ID`.
    // Tool availability probes must be host-OS compatible.
    // - On macOS we use `codesign`; on Windows this check would spam "The system cannot find the path specified."
    //   because `/dev/null` redirection is not meaningful in cmd.exe.
    var have_codesign = false
    if target == "macos" { have_codesign = (oren_system("command -v codesign >/dev/null 2>&1") == 0) }
    codesign_id = opts["codesign"]
    if codesign_id == nil { codesign_id = "" }
    var skip_codesign = oren_env("OREN_SKIP_CODESIGN")
    if target == "macos" && skip_codesign != nil && skip_codesign == "1" {
        emit_diag("compile", 2, "oren build: OREN_SKIP_CODESIGN=1 is not supported on macOS (unsigned native outputs may be killed by the OS)")
        print("oren build: OREN_SKIP_CODESIGN=1 is not supported on macOS (unsigned native outputs may be killed by the OS)")
        oren_exit(2)
    }
    if target == "macos" && codesign_id != "" && have_codesign != true {
        emit_diag("compile", 2, "oren build: codesign requested but `codesign` tool not found in PATH")
        print("oren build: codesign requested but `codesign` tool not found in PATH")
        oren_exit(2)
    }
    if target == "macos" && codesign_id == "" && deterministic != true && have_codesign == true {
        // Ad-hoc signing is fast and does not require a certificate.
        codesign_id = "-"
    }

    notarize = seen["notarize"] == true
    if seen["notary-profile"] == true { notary_profile = opts["notary-profile"] }
    if notarize == true && target == "macos" {
        if codesign_id == "" || codesign_id == "-" {
            emit_diag("compile", 2, "oren build: --notarize requires a Developer ID identity via --codesign / OREN_CODESIGN_ID")
            print("oren build: --notarize requires a Developer ID identity via --codesign / OREN_CODESIGN_ID")
            oren_exit(2)
        }
    }

    no_gc = (opts["no-gc"] == true)
    deterministic = (opts["deterministic"] == true)
    if seen["manifest"] == true { emit_manifest = true }

    STRICT_ATTRS = (opts["strict-attrs"] == true)
    ATTR_ALLOW_PREFIXES = split_csv(opts["attr-allow-prefixes"])
    STRICT_IDENT_PREFIXES = (opts["strict-ident-prefixes"] == true)
    IDENT_ALLOW_PREFIXES = split_csv(opts["ident-allow-prefixes"])
    CAPSULE = (opts["capsule"] == true)
    CAP_ALLOW_DOMAINS = split_csv(opts["cap-allow-domains"])

    // Bytecode is an AVM artifact; it is intended to be platform-neutral.
    // Enforce a single "bytecode ABI profile" so `.obc` semantics do not vary by host.
    //
    // NOTE: until the compiler is proven fully portable, we still thread `target/arch`
    // in the build cache key (now fixed to avm/avm64 for bytecode).
    if backend == "bytecode" {
        target = "avm"
        arch = "avm64"
    }
    if trace_build { print("[build] opts backend=" + backend + " target=" + target + " arch=" + arch) }

    // Cross-compile guard (C backend, rolling):
    // - Stage0->stage1 bootstrap uses the C backend; it is expected to run *on the host OS*.
    // - For Tier‑1 Windows, the intended default C toolchain is MSVC (cl.exe).
    // - Cross-compiling C backend outputs to Windows from non-Windows hosts is not a first-class path.
    //   Require an explicit `--cc` so callers opt into a cross toolchain (e.g. MinGW) intentionally.
    if backend == "c" && target == "windows" && host_win != true && seen["cc"] != true {
        var emsg_ccw = "oren build: C backend targeting windows from a non-Windows host requires explicit --cc (e.g. a MinGW cross compiler). On Windows hosts, omit --cc to use MSVC cl.exe auto-detection."
        emit_diag("compile", 2, emsg_ccw)
        print(emsg_ccw)
        oren_exit(2)
    }

    // Default output path:
    // - `build/targets/<arch>-<os>/<backend>/<basename>` for native/c
    // - `build/targets/avm/bytecode/<basename>.obc` for bytecode (platform-neutral intent)
    //
    // Notes (rolling):
    // - even though bytecode is *intended* to be platform-neutral, current compilation still
    //   threads `target/arch` through lowering; keep outputs separated until OBC is proven portable.
    if seen["out"] == true {
        out_path = opts["out"]
    } else {
        if trace_build { print("[build] out_path default compute") }
        var stem = basename(default_output_path(path))
        if backend == "bytecode" {
            out_path = "build/targets/avm/bytecode/" + stem + ".obc"
	        } else {
	            var dir = "build/targets/" + arch + "-" + target + "/" + backend
	            out_path = dir + "/" + stem
		            // Default output extensions (native backend; rolling UX).
		            //
		            // Notes:
		            // - Windows: cmd.exe does not treat extensionless PE files as runnable commands via relative paths.
		            // - Shared libs should use conventional extensions per target so users don't need to remember them.
		            if target == "windows" {
		                var want_ext = ".exe"
		                if backend == "native" && is_shared_lib { want_ext = ".dll" }
		                var n2 = oren_string_len(out_path)
		                if n2 < oren_string_len(want_ext) || oren_string_slice(out_path, n2 - oren_string_len(want_ext), n2) != want_ext {
		                    out_path = out_path + want_ext
		                }
		            } else if backend == "native" && is_shared_lib {
		                if target == "linux" {
		                    var want_ext2 = ".so"
		                    var n3 = oren_string_len(out_path)
		                    if n3 < oren_string_len(want_ext2) || oren_string_slice(out_path, n3 - oren_string_len(want_ext2), n3) != want_ext2 {
		                        out_path = out_path + want_ext2
		                    }
		                } else if target == "macos" {
		                    var want_ext3 = ".dylib"
		                    var n4 = oren_string_len(out_path)
		                    if n4 < oren_string_len(want_ext3) || oren_string_slice(out_path, n4 - oren_string_len(want_ext3), n4) != want_ext3 {
		                        out_path = out_path + want_ext3
		                    }
		                }
		            }
		        }
			    }
			    if trace_build { print("[build] out_path=" + out_path) }

    // Cross-OS robustness:
    // - Treat '\' as a path separator for outputs too, even when running on POSIX.
    // - Windows APIs accept forward slashes for most paths, so using '/' internally is safe.
    //
    // This prevents mixed-separator paths like `.../native/examples\myapp.exe` from
    // confusing directory creation and file opens (a common remote Win11 bring-up hazard).
    out_path = _path_to_posix_sep(out_path)

    if deterministic {
        // Deterministic mode: avoid post-processing that can inject non-reproducible data.
        codesign_id = ""
        notarize = false
    }

    // Build cache (enabled by default).
    // - use --no-cache / OREN_NO_CACHE=1 to disable
    // - cache key includes compiler binary sha256 and transitive source closure sha256
    if trace_build { print("[build] cache config start") }
    var cache_enabled = _cache_enabled(seen, opts)
    var cache_dir = _cache_dir_from_opts(seen, opts)
    if trace_build {
        var ce = "false"
        if cache_enabled { ce = "true" }
        print("[build] cache_enabled=" + ce + " cache_dir=" + cache_dir)
    }
    if cache_enabled && (seen["cache-dir"] != true) {
        // CLI help prints default cache dir; if user passed "", treat as default.
        if opts["cache-dir"] != nil && opts["cache-dir"] != "" {
            cache_dir = path_norm(opts["cache-dir"])
        }
    }
    // Keep caching conservative for now: skip in cases where build produces sidecar sources
    // that we don't cache yet.
    if emit_c { cache_enabled = false }
    if emit_meta { cache_enabled = false }
    if is_shared_lib { cache_enabled = false }
    if notarize { cache_enabled = false }
    // Rolling perf policy:
    // Debug builds are frequently used in tests/bring-up and can be expensive to hash for
    // content-addressed caching under the native runtime. Disable build cache for debug builds
    // by default; opt-in via `OREN_CACHE_DEBUG=1`.
    if debug_mode {
        var v_cd = oren_env("OREN_CACHE_DEBUG")
        if v_cd == nil || v_cd == "" || v_cd == "0" || v_cd == "false" {
            cache_enabled = false
        }
    }

    var cache_key = nil
    if cache_enabled {
        // Compute a content-addressed cache key before running expensive passes.
        var cfg = {
            "backend": backend,
            "target": target,
            "arch": arch,
            "cc": cc,
            "codesign_id": codesign_id,
            // Deterministic mode affects cache hashing strategy (sha256 vs fast fingerprint).
            "deterministic": 0,
            // Performance-only: pass the selected cache dir so the dependency scan cache
            // lives next to the artifact cache (does not affect cache key).
            "cache_dir": cache_dir,
            "emit_c": 0,
            "no_gc": 0,
            "enable_python": 0,
            "debug_mode": 0,
            "shared_lib": 0,
            "call_depth_max": call_depth_max,
            "capsule": 0,
            "cap_domains": CAP_ALLOW_DOMAINS,
            "test_mode": 0,
            "stdlib_mode": stdlib_mode,
            "stdlib_obc": stdlib_obc,
            "link_obc": link_obc,
        }
        if deterministic { cfg["deterministic"] = 1 }
        if no_gc { cfg["no_gc"] = 1 }
        if enable_python { cfg["enable_python"] = 1 }
        if debug_mode { cfg["debug_mode"] = 1 }
        if is_shared_lib { cfg["shared_lib"] = 1 }
        if CAPSULE { cfg["capsule"] = 1 }
        if test_mode { cfg["test_mode"] = 1 }

        var t_key0 = 0
        if trace_build { t_key0 = oren_time_now_ns() }
        var kk = cache_compute_key_build(path, cfg)
        if trace_build {
            var dt_key = (oren_time_now_ns() - t_key0) / 1000000
            var okk = 0
            if kk != nil && kk["ok"] == true { okk = 1 }
            print("[build] cache key compute +" + oren_int_to_string(dt_key) + "ms ok=" + oren_int_to_string(okk))
        }
        if kk["ok"] == true {
            cache_key = kk["key"]
            var chmod_mode = 0
            if backend == "native" || backend == "c" { chmod_mode = 493 } // 0755
            var hit = cache_try_restore_artifact(cache_dir, cache_key, out_path, chmod_mode)
            if hit["hit"] == true {
                // Keep user-facing output consistent with a normal build.
                if backend == "bytecode" { print("Bytecode emitted: " + out_path) }
                else { print("Build successful: " + out_path) }

                var out_bytes = hit["bytes"]
                if out_bytes != nil && deterministic { _emit_artifact_hash(backend, out_path, out_bytes) }
                if out_bytes != nil && emit_manifest {
                    var hh = _sha256_hex(out_bytes)
                    _write_artifact_manifest(backend, out_path, hh, target, arch, deterministic, _bytes_len_any(out_bytes))
                }
                if disasm {
                    if target == "macos" { oren_system("otool -tV " + shell_quote(out_path)) }
                    else { oren_system("objdump -d " + shell_quote(out_path)) }
                }
                if run_after_build { _run_test_artifact(backend, out_path) }
                return nil
            }
        } else {
            // Key computation failure shouldn't fail builds; just disable cache for this run.
            cache_enabled = false
        }
    }

    // `call_depth_max` already normalized above (see `--call-depth-max` parsing).

    if backend != "c" && backend != "native" && backend != "bytecode" {
        emit_diag("compile", 2, "Unknown backend: " + backend)
        print("Unknown backend: " + backend)
        oren_exit(2)
    }

    // Optional build-phase tracing for self-hosting bringup / hang diagnosis.
    // Enable with: OREN_TRACE_BUILD=1
    var t_build0 = 0
    if trace_build {
        t_build0 = oren_time_now_ns()
        print("[build] start backend=" + backend + " target=" + target + " arch=" + arch + " path=" + path + " out=" + out_path)
        print("[build] ensure_dir " + dirname(out_path))
    }

    // Build outputs should be able to target nested directories (tests commonly use build/tmp/...).
    // Ensure the output directory exists before any backend attempts to write.
    ensure_dir(dirname(out_path))
    if trace_build { print("[build] ensure_dir done") }

    var rr = expand_includes_file_result(path, [])
    if rr["ok"] != true {
        var emsg = "Failed to read file: " + path
        var msg = rr["err"]
        if msg != nil { emsg = emsg + " (" + msg + ")" }
        emit_diag("compile", 2, emsg)
        print("Failed to read file: " + path)
        if msg != nil { print(msg) }
        oren_exit(2)
    }
    var src = rr["src"]
    if trace_build {
        var dt_read = oren_time_now_ns() - t_build0
        print("[build] read done +" + oren_int_to_string(dt_read / 1000000) + "ms bytes=" + oren_int_to_string(oren_string_len(src)))
    }
    if trace_build_summary { t_sum_read_done = oren_time_now_ns() }
    if trace_build { print("[build] lexer.new_lexer start") }
    var l = lexer.new_lexer(src)
    if trace_build {
        var dt_lex0 = oren_time_now_ns() - t_build0
        print("[build] lexer.new_lexer done +" + oren_int_to_string(dt_lex0 / 1000000) + "ms")
        print("[build] lexer file tag set start")
    }
    l["file"] = path
    if trace_build { print("[build] lexer file tag set done") }
    if trace_build { print("[build] parser.new_parser start") }
    var p = parser.new_parser(l)
    if trace_build {
        var dt_p0 = oren_time_now_ns() - t_build0
        print("[build] parser.new_parser done +" + oren_int_to_string(dt_p0 / 1000000) + "ms")
    }
    p["strict_attrs"] = STRICT_ATTRS
    p["attr_allow_prefixes"] = ATTR_ALLOW_PREFIXES
    p["strict_ident_prefixes"] = STRICT_IDENT_PREFIXES
    p["ident_allow_prefixes"] = IDENT_ALLOW_PREFIXES
    if trace_build { print("[build] parse start") }
    var prog = parser.parse_program(p)
    if trace_build {
        var dt_parse = oren_time_now_ns() - t_build0
        print("[build] parse done +" + oren_int_to_string(dt_parse / 1000000) + "ms errors=" + oren_int_to_string(oren_list_len(p["errors"])))
    }
    if trace_build_summary { t_sum_parse_done = oren_time_now_ns() }
    if oren_list_len(p["errors"]) > 0 {
        var first_err = nil
        if oren_list_len(p["errors"]) > 0 { first_err = p["errors"][0] }
        emit_diag("parse", 1, first_err)
        print("Parse errors:")
        var i = 0
        while i < oren_list_len(p["errors"]) {
            print(p["errors"][i])
            i = i + 1
        }
        oren_exit(1)
    }
    
    if analyze {
        analysis.analyze_program(prog)
        return nil
    }

    if backend == "bytecode" {
        var allow_undef = false
        if stdlib_mode == "obc" { allow_undef = true }
        if oren_list_len(link_obc) > 0 { allow_undef = true }

        var linked_bc = link_program(path, prog, {"target": target, "arch": arch, "backend": backend, "debug": debug_mode, "typecheck": do_typecheck, "stdlib_mode": stdlib_mode, "keep_all_top_level_functions": obc_lib, "test_mode": test_mode})

        var ctx = codegen_bytecode.bytecode_compile_program(linked_bc, {"allow_undef": allow_undef})
        if ctx != nil && ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
            var first_err = ctx["errors"][0]
            emit_diag("codegen", 1, first_err)
            print("Bytecode codegen errors:")
            var ei = 0
            while ei < oren_list_len(ctx["errors"]) {
                print(ctx["errors"][ei])
                ei = ei + 1
            }
            oren_exit(1)
        }


        // Rolling: embed metadata into the `.obc` constant pool as a BYTES constant so:
        // - tooling can discover attrs/types/fields without a sidecar file
        // - execution semantics remain unchanged (metadata is not referenced by code)
        //
        // Format (rolling, v0):
        //   bytes = "OREN_META\n1\n" + <meta_json_utf8_bytes>
        var meta_json = metadata.generate_metadata(linked_bc)
        var hdr = oren_bytes_from_string("OREN_META\n1\n")
        var payload = oren_bytes_from_string(meta_json)
        var meta_bytes = []
        var hi = 0
        while hi < oren_list_len(hdr) {
            oren_list_push(meta_bytes, hdr[hi])
            hi = hi + 1
        }
        var pi = 0
        while pi < oren_list_len(payload) {
            oren_list_push(meta_bytes, payload[pi])
            pi = pi + 1
        }
        ctx["meta_bytes"] = meta_bytes

        // Optional OBX (exports/relocs) for `.obc` module linking.
            if allow_undef || obc_lib {
                var exports = {}
                if obc_lib {
                    for nm in ctx["functions"] {
                        if nm != nil && nm != "" && nm != "main" && nm != "__top_level__" {
                            // `ctx["functions"][name]` stores 1-based code addresses so 0 is representable while still
                            // using `nil` as "missing". OBX, however, must store *0-based* code offsets (rolling ABI).
                            // Export the decoded address (`enc - 1`) so the linker can patch CALL32/PUSH_FUNC32 targets.
                            var enc = ctx["functions"][nm]
                            if oren_type_tag(enc) == 1 && enc > 0 {
                                exports[nm] = enc - 1
                            } else {
                                exports[nm] = 0
                            }
                        }
                    }
                }
                ctx["obx_bytes"] = obc_link.obx_encode(path, exports, ctx["relocs"])
            }

        // Stdlib/extra library linking (rolling):
        // - compile the main program with unresolved fixups enabled
        // - link OBX-enabled libraries into a final, self-contained `.obc`
        var need_link = false
        if stdlib_mode == "obc" { need_link = true }
        if oren_list_len(link_obc) > 0 { need_link = true }
        if need_link {
            var libs = []
            if stdlib_mode == "obc" {
                if stdlib_obc == "" {
                    var env_std_obc = oren_env("OREN_STDLIB_OBC")
                    if env_std_obc != nil { stdlib_obc = env_std_obc }
                }
                if stdlib_obc == "" {
                    emit_diag("compile", 2, "Missing stdlib bundle: set --stdlib-obc or env OREN_STDLIB_OBC")
                    print("Missing stdlib bundle: set --stdlib-obc or env OREN_STDLIB_OBC")
                    oren_exit(2)
                }
                oren_list_push(libs, stdlib_obc)
            }
            var li = 0
            while li < oren_list_len(link_obc) {
                oren_list_push(libs, link_obc[li])
                li = li + 1
            }

            var parsed = []
            li = 0
            while li < oren_list_len(libs) {
                var p = obc_link.obc_read_file(libs[li])
                if p["error"] != nil {
                    emit_diag("compile", 2, "Failed to read/link obc: " + libs[li] + " (" + p["error"] + ")")
                    print("Failed to read/link obc: " + libs[li])
                    print(p["error"])
                    oren_exit(2)
                }
                if p["obx"] == nil || p["obx"]["exports"] == nil {
                    emit_diag("compile", 2, "OBC missing OBX exports: " + libs[li] + " (build it with --obc-lib)")
                    print("OBC missing OBX exports: " + libs[li] + " (build it with --obc-lib)")
                    oren_exit(2)
                }
                oren_list_push(parsed, p)
                li = li + 1
            }

            // Build an in-memory OBC object from the just-compiled ctx.
            var consts2 = []
            var ci = 0
            while ci < oren_list_len(ctx["constants"]) {
                oren_list_push(consts2, ctx["constants"][ci])
                ci = ci + 1
            }
            if ctx["meta_bytes"] != nil && oren_list_len(ctx["meta_bytes"]) > 0 {
                oren_list_push(consts2, {"type": "Bytes", "value": ctx["meta_bytes"]})
            }
            if ctx["obx_bytes"] != nil && oren_list_len(ctx["obx_bytes"]) > 0 {
                oren_list_push(consts2, {"type": "Bytes", "value": ctx["obx_bytes"]})
            }
            var main_obx = {"module": path, "exports": {}, "relocs": ctx["relocs"]}
            var main_obc = {"constants": consts2, "code": ctx["code"], "obx": main_obx, "global_count": ctx["global_count"]}
            oren_list_push(parsed, main_obc)

            var linked = obc_link.obc_link(parsed)
            if linked["error"] != nil {
                emit_diag("compile", 2, "OBC link failed: " + linked["error"])
                print("OBC link failed: " + linked["error"])
                oren_exit(2)
            }
            var wr = obc_link.obc_write_file(out_path, linked)
            if oren_is_err(wr["write"]) {
                var emsgW = "Failed to write bytecode: " + out_path
                var msgW = oren_err_msg(wr["write"])
                if msgW != nil { emsgW = emsgW + " (" + msgW + ")" }
                emit_diag("compile", 2, emsgW)
                print(emsgW)
                oren_exit(2)
            }
            var out_bytes = wr["bytes"]
            print("Bytecode emitted: " + out_path)
            if deterministic { _emit_artifact_hash("bytecode", out_path, out_bytes) }
            if emit_manifest {
                var h = _sha256_hex(out_bytes)
                _write_artifact_manifest("bytecode", out_path, h, target, arch, deterministic, _bytes_len_any(out_bytes))
            }
            if cache_enabled && cache_key != nil {
                cache_store_artifact(cache_dir, cache_key, out_bytes)
            }
            if run_after_build { _run_test_artifact(backend, out_path) }
            return nil
        }

        // Default: no linking required, emit directly.
        var out_bytes2 = codegen_bytecode.bytecode_emit_program(out_path, ctx)
        print("Bytecode emitted: " + out_path)
        if deterministic { _emit_artifact_hash("bytecode", out_path, out_bytes2) }
        if emit_manifest {
            var h2 = _sha256_hex(out_bytes2)
            _write_artifact_manifest("bytecode", out_path, h2, target, arch, deterministic, _bytes_len_any(out_bytes2))
        }
        if cache_enabled && cache_key != nil {
            cache_store_artifact(cache_dir, cache_key, out_bytes2)
        }
        if run_after_build { _run_test_artifact(backend, out_path) }
        return nil
    }

    if backend == "native" {
        if emit_c {
            emit_diag("compile", 2, "--emit-c is only supported with --backend c")
            print("--emit-c is only supported with --backend c")
            oren_exit(2)
        }

        var linked = link_program(path, prog, {"target": target, "arch": arch, "backend": backend, "debug": debug_mode, "typecheck": do_typecheck, "keep_all_top_level_functions": is_shared_lib, "test_mode": test_mode})
        if trace_build_summary { t_sum_link_done = oren_time_now_ns() }
        // Memory hygiene (rolling):
        // - After linking, the native backend no longer needs the parsed root AST `prog`.
        // - The module loader globals (MODULES/MODULE_ORDER/MODULE_STACK) retain per-module
        //   program wrappers and statement lists; those are redundant once we have the merged
        //   `linked["statements"]` list.
        // Clear them so GC can reclaim those scaffolding objects and keep RSS bounded.
        prog = nil
        MODULES = {}
        MODULE_STACK = []
        MODULE_ORDER = []
        MODULE_ID_COUNTER = 0
        // Rolling native-selfhost safety:
        // The native GC does not yet scan compiler global variables reliably, so unconditional
        // collections can trigger UAF crashes. Keep this opt-in for now.
        if oren_env("OREN_COMPILER_GC") != nil {
            oren_gc_collect()
        }
        var export_names = []

        // Allow `ffi` declarations to attach required dynamic libs (portable `@ffi.link`).
        // This keeps stdlib/platform bindings self-contained and avoids requiring users/scripts
        // to pass `--link` explicitly for common OS bindings.
        var implicit_link_libs = _build_collect_ffi_link_libs(linked, target)
        if implicit_link_libs != nil && oren_list_len(implicit_link_libs) != 0 {
            link_libs = _build_merge_link_libs(link_libs, implicit_link_libs)
        }

        // Native: allow opt-in export of user/runtime symbols even for executables.
        // This enables dlsym(RTLD_DEFAULT, "...") to obtain raw function pointers for
        // C callback APIs in stdlib (e.g. SecureTransport IO callbacks, OpenSSL ALPN selection).
        if is_shared_lib != true {
            if target == "macos" && (arch == nil || arch == "arm64") {
                var exp2 = _build_collect_ffi_export_names(linked)
                if exp2 != nil && oren_list_len(exp2) != 0 {
                    var ei2 = 0
                    while ei2 < oren_list_len(exp2) {
                        oren_list_push(export_names, exp2[ei2])
                        ei2 = ei2 + 1
                    }
                }
            } else if target == "linux" {
                var exp3 = _build_collect_ffi_export_names(linked)
                if exp3 != nil && oren_list_len(exp3) != 0 {
                    var ei3 = 0
                    while ei3 < oren_list_len(exp3) {
                        oren_list_push(export_names, exp3[ei3])
                        ei3 = ei3 + 1
                    }
                }
            } else if target == "windows" {
                // Windows x64 can export function symbols from executables via the PE export table.
                // This enables `GetProcAddress(GetModuleHandle(NULL), "...")` for callback-style interop.
                var exp4 = _build_collect_ffi_export_names(linked)
                if exp4 != nil && oren_list_len(exp4) != 0 {
                    var ei4 = 0
                    while ei4 < oren_list_len(exp4) {
                        oren_list_push(export_names, exp4[ei4])
                        ei4 = ei4 + 1
                    }
                }
            }
        }
        
        if is_shared_lib {
            var header_path = default_output_path(out_path) + ".h"
            var h_content = "#ifndef OREN_LIB_H\n#define OREN_LIB_H\n\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n"
            var stmts = linked["statements"]
            var si = 0
            while si < oren_list_len(stmts) {
                var s = stmts[si]
                var fn_node = nil
                
                if s["type"] == "Function" {
                    fn_node = s
                }
                if s["type"] == "ExprStmt" {
                    var expr = s["expr"]
                    if expr != nil {
                        if expr["type"] == "Function" {
                            fn_node = expr
                        }
                    }
                }
                
                if fn_node != nil {
                    var fn_name = fn_node["name"]
                    // print("DEBUG: fn_name = " + fn_name)
                    if fn_name != nil {
                        if fn_name != "main" && fn_name != "__top_level__" {
                            oren_list_push(export_names, fn_name)
                            var params = fn_node["params"]
                            var p_count = oren_list_len(params)
                            h_content = h_content + "extern int64_t " + fn_name + "("
                            var pi = 0
                            while pi < p_count {
                                if pi > 0 { h_content = h_content + ", " }
                                h_content = h_content + "int64_t arg" + oren_int_to_string(pi)
                                pi = pi + 1
                            }
                            if p_count == 0 { h_content = h_content + "void" }
                            h_content = h_content + ");\n"
                        }
                    }
                }
                si = si + 1
            }
            h_content = h_content + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n"
            var w = oren_write_file(header_path, h_content)
            if oren_is_err(w) {
                var emsgH = "Failed to write header: " + header_path
                var msg = oren_err_msg(w)
                if msg != nil { emsgH = emsgH + " (" + msg + ")" }
                emit_diag("compile", 2, emsgH)
                print("Failed to write header: " + header_path)
                if msg != nil { print(msg) }
                oren_exit(1)
            }
            print("Wrote header: " + header_path)
        }
        
        if emit_meta {
            var meta_json = metadata.generate_metadata(linked)
            var meta_path = out_path + ".meta.json"
            var w2 = oren_write_file(meta_path, meta_json)
            if oren_is_err(w2) {
                var emsgM = "Failed to write metadata: " + meta_path
                var msg2 = oren_err_msg(w2)
                if msg2 != nil { emsgM = emsgM + " (" + msg2 + ")" }
                emit_diag("compile", 2, emsgM)
                print("Failed to write metadata: " + meta_path)
                if msg2 != nil { print(msg2) }
                oren_exit(1)
            }
            print("Wrote metadata: " + meta_path)
            if deterministic || emit_manifest {
                var bsM = oren_read_bytes(meta_path)
                if oren_is_err(bsM) {
                    var emsgHM = "Failed to read artifact for hashing: " + meta_path
                    var msgHM = oren_err_msg(bsM)
                    if msgHM != nil { emsgHM = emsgHM + " (" + msgHM + ")" }
                    emit_diag("compile", 2, emsgHM)
                    print("Failed to read artifact for hashing: " + meta_path)
                    if msgHM != nil { print(msgHM) }
                    oren_exit(1)
                }
                if deterministic { _emit_artifact_hash("meta", meta_path, bsM) }
                if emit_manifest {
                    var h = _sha256_hex(bsM)
                    _write_artifact_manifest("meta", meta_path, h, target, arch, deterministic, oren_list_len(bsM))
                }
            }
        }

        if arch == nil { arch = "arm64" }
        if arch == "arm64" {
            var t_emit0 = 0
            if trace_build {
                t_emit0 = oren_time_now_ns()
                print("[build] native emit start (arm64) target=" + target)
            }
            if target == "linux" {
                arm64_elf.elf_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, CAPSULE, CAP_ALLOW_DOMAINS)
            } else {
                arm64_macho.macho_emit_program_arm64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, CAPSULE, CAP_ALLOW_DOMAINS)
            }
            if trace_build {
                var dt_emit = oren_time_now_ns() - t_emit0
                print("[build] native emit done +" + oren_int_to_string(dt_emit / 1000000) + "ms")
            }
            if trace_build_summary { t_sum_emit_done = oren_time_now_ns() }
		        } else {
		            if arch == "x64" || arch == "x86_64" || arch == "amd64" {
		                var t_emit1 = 0
			                if trace_build {
			                    t_emit1 = oren_time_now_ns()
			                    print("[build] native emit start (x64) target=" + target)
			                }
					                if target != "linux" && target != "windows" && oren_list_len(export_names) != 0 {
					                    print("native backend (x64): exports are not implemented for target: " + target)
					                    print("  requested: --export / @ffi.export")
					                    oren_exit(1)
					                }
					                if target == "linux" {
					                    x64_elf.elf_emit_program_x64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, call_depth_max, CAPSULE, CAP_ALLOW_DOMAINS)
					                } else {
					                    if target == "windows" {
					                        x64_pe.pe_emit_program_x64(out_path, linked, link_libs, is_shared_lib, export_names, debug_mode, no_gc, call_depth_max, CAPSULE, CAP_ALLOW_DOMAINS)
				                    } else {
			                        print("native backend (x64) unsupported target: " + target)
		                        oren_exit(1)
		                    }
	                }
                if trace_build {
                    var dt_emit1 = oren_time_now_ns() - t_emit1
                    print("[build] native emit done +" + oren_int_to_string(dt_emit1 / 1000000) + "ms")
                }
                if trace_build_summary { t_sum_emit_done = oren_time_now_ns() }
            } else {
                print("native backend unsupported arch: " + arch)
                oren_exit(1)
            }
        }

        if target == "macos" {
            if codesign_id != "" {
                var cs_cmd = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
                var cs_res = oren_system(cs_cmd)
                if cs_res != 0 {
                    print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                    var ad_cmd = "codesign -s - --force " + shell_quote(out_path)
                    var ad_res = oren_system(ad_cmd)
                    if ad_res != 0 {
                        print("codesign fallback failed")
                        oren_exit(1)
                    }
                }
            }
        }
        if trace_build_summary { t_sum_codesign_done = oren_time_now_ns() }
        
        if deterministic || emit_manifest {
            // Use u8_buf to avoid boxing the artifact into list<int> (huge memory blowups).
            var bs = oren_read_u8_buf(out_path)
            if oren_is_err(bs) {
                print("Failed to read artifact for hashing: " + out_path)
                var msgH = oren_err_msg(bs)
                if msgH != nil { print(msgH) }
                oren_exit(1)
            }
            if deterministic { _emit_artifact_hash("native", out_path, bs) }
            if emit_manifest {
                var h = _sha256_hex(bs)
                _write_artifact_manifest("native", out_path, h, target, arch, deterministic, _bytes_len_any(bs))
            }
        }
        if trace_build_summary { t_sum_hash_done = oren_time_now_ns() }

        print("Build successful: " + out_path)
        if trace_build_summary && t_sum0 != 0 {
            var tend = oren_time_now_ns()
            var total_ms = (tend - t_sum0) / 1000000
            if slow_ms < 0 || total_ms >= slow_ms {
                var read_ms = 0
                var parse_ms = 0
                var link_ms = 0
                var emit_ms = 0
                var codesign_ms = 0
                var hash_ms = 0
                if t_sum_read_done != 0 { read_ms = (t_sum_read_done - t_sum0) / 1000000 }
                if t_sum_parse_done != 0 && t_sum_read_done != 0 { parse_ms = (t_sum_parse_done - t_sum_read_done) / 1000000 }
                if t_sum_link_done != 0 && t_sum_parse_done != 0 { link_ms = (t_sum_link_done - t_sum_parse_done) / 1000000 }
                if t_sum_emit_done != 0 && t_sum_link_done != 0 { emit_ms = (t_sum_emit_done - t_sum_link_done) / 1000000 }
                if t_sum_codesign_done != 0 && t_sum_emit_done != 0 { codesign_ms = (t_sum_codesign_done - t_sum_emit_done) / 1000000 }
                if t_sum_hash_done != 0 && t_sum_codesign_done != 0 { hash_ms = (t_sum_hash_done - t_sum_codesign_done) / 1000000 }
                print("[build] summary total_ms=" + oren_int_to_string(total_ms) +
                    " read_ms=" + oren_int_to_string(read_ms) +
                    " parse_ms=" + oren_int_to_string(parse_ms) +
                    " link_ms=" + oren_int_to_string(link_ms) +
                    " emit_ms=" + oren_int_to_string(emit_ms) +
                    " codesign_ms=" + oren_int_to_string(codesign_ms) +
                    " hash_ms=" + oren_int_to_string(hash_ms))
            }
        }
        
        if cache_enabled && cache_key != nil {
            // Store native artifact bytes for future cache hits.
            var bsn = oren_read_u8_buf(out_path)
            if !oren_is_err(bsn) { cache_store_artifact(cache_dir, cache_key, bsn) }
        }

        if disasm {
            if target == "macos" {
                oren_system("otool -tV " + shell_quote(out_path))
            } else {
                oren_system("objdump -d " + shell_quote(out_path))
            }
        }
        if run_after_build { _run_test_artifact(backend, out_path) }
        return nil
    }

    // For C backend, we also need to load modules to populate MODULE_ORDER.
    //
    // Note: some whole-program lowerings (like generic monomorphization) may generate
    // *new* function definitions during linking. The C transpiler consumes per-module
    // ASTs (MODULE_ORDER + prog), so we must sync generated functions back into those
    // unit programs before transpiling.
    var linked_c = link_program(path, prog, {"target": target, "arch": arch, "backend": backend, "debug": debug_mode, "typecheck": do_typecheck, "test_mode": test_mode})
    c_backend_sync_generated_functions(prog, MODULE_ORDER, linked_c)
    var c_code = transpiler.transpile_entry(path, prog, MODULE_ORDER, linked_c["aliases"])
    // IMPORTANT (rolling hygiene):
    // Do NOT write generated C next to sources. This breaks Makefile implicit rules
    // and pollutes the working tree (especially under parallel test runs).
    //
    // Emit the C file alongside the output binary instead.
    ensure_dir(dirname(out_path))
    var c_path = out_path + ".c"
    var w3 = oren_write_file(c_path, c_code)
    if oren_is_err(w3) {
        print("Failed to write C output: " + c_path)
        var msg3 = oren_err_msg(w3)
        if msg3 != nil { print(msg3) }
        oren_exit(1)
    }
    // Keep compiler RSS bounded: the generated C string can be very large for whole-program builds.
    // Once it is written to disk, drop it so the GC can reclaim that memory before invoking `cc`.
    c_code = nil
    oren_gc_collect()
    if emit_c {
        print("Wrote " + c_path)
        return nil
    }

    var cmd = ""
    var msvc_script_path = ""
    if target == "windows" {
        // Prefer MSVC cl.exe for Tier‑1 Windows.
        // For non-MSVC compilers (clang/gcc under MSYS2), callers can pass `--cc` explicitly.
        var cc_base = basename(cc)
        var is_msvc = (cc_base == "cl" || cc_base == "cl.exe" || cc_base == "clang-cl" || cc_base == "clang-cl.exe")

        if is_msvc {
            if host_win != true {
                print("ERROR: C backend with MSVC (cl.exe) requires a Windows host. For cross-compiling, pass an explicit cross compiler via --cc.")
                oren_exit(2)
            }
            var msvc_python_flags = nil
            if enable_python {
                var py_flags = _msvc_python_embed_flags()
                if py_flags == nil {
                    print("ERROR: --python MSVC setup failed (ensure Python with dev headers is on PATH or set OREN_PYTHON)")
                    oren_exit(2)
                }
                msvc_python_flags = py_flags
            }

            // `cl.exe` is typically not in PATH unless you're in a VS Developer Prompt.
            // Like stage0 (Go bootstrap), emit a temporary `.cmd` wrapper that:
            // - finds VS via vswhere.exe (or OREN_MSVC_INSTALL_PATH)
            // - calls VsDevCmd.bat / vcvars64.bat
            // - invokes cl.exe with a minimal deterministic arg set
            //
            // Escape hatches:
            // - OREN_MSVC_INSTALL_PATH (pin VS install root)
            // - OREN_MSVC_VSWHERE (pin vswhere.exe path)
            var t = oren_time_now_ns()
            var script = "oren_msvc_build_" + oren_int_to_string(t) + ".cmd"
            var sp = _path_to_windows_sep(script)
            msvc_script_path = sp
            var out_win = _path_to_windows_sep(out_path)
            var c_win = _path_to_windows_sep(c_path)

            var parts = []
            oren_list_push(parts, "@echo off\r\n")
            oren_list_push(parts, "setlocal\r\n")
            oren_list_push(parts, "set VSCMD_SKIP_SENDTELEMETRY=1\r\n")

            // Allow direct override: bypass discovery completely.
            // NOTE: avoid cmd.exe "delayed expansion" pitfalls by keeping this logic mostly linear
            // (no variable set+use inside a single parenthesized block).
            oren_list_push(parts, "set \"OREN_DEVCMD=%OREN_MSVC_DEV_CMD%\"\r\n")
            oren_list_push(parts, "if not \"%OREN_DEVCMD%\"==\"\" goto OREN_HAVE_DEVCMD\r\n")

            // Locate a VS install root that contains the MSVC tools.
            // Priority: explicit install path -> common probes -> vswhere.exe.
            oren_list_push(parts, "set \"OREN_VSINSTALL=%OREN_MSVC_INSTALL_PATH%\"\r\n")
            oren_list_push(parts, "if not \"%OREN_VSINSTALL%\"==\"\" goto OREN_HAVE_VSINSTALL\r\n")

            // Probes for VS2022.
            oren_list_push(parts, "if exist \"%ProgramFiles%\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\Tools\\VsDevCmd.bat\" set \"OREN_VSINSTALL=%ProgramFiles%\\Microsoft Visual Studio\\2022\\BuildTools\"\r\n")
            oren_list_push(parts, "if not \"%OREN_VSINSTALL%\"==\"\" goto OREN_HAVE_VSINSTALL\r\n")
            oren_list_push(parts, "if exist \"%ProgramFiles%\\Microsoft Visual Studio\\2022\\Community\\Common7\\Tools\\VsDevCmd.bat\" set \"OREN_VSINSTALL=%ProgramFiles%\\Microsoft Visual Studio\\2022\\Community\"\r\n")
            oren_list_push(parts, "if not \"%OREN_VSINSTALL%\"==\"\" goto OREN_HAVE_VSINSTALL\r\n")
            oren_list_push(parts, "if exist \"%ProgramFiles%\\Microsoft Visual Studio\\2022\\Professional\\Common7\\Tools\\VsDevCmd.bat\" set \"OREN_VSINSTALL=%ProgramFiles%\\Microsoft Visual Studio\\2022\\Professional\"\r\n")
            oren_list_push(parts, "if not \"%OREN_VSINSTALL%\"==\"\" goto OREN_HAVE_VSINSTALL\r\n")
            oren_list_push(parts, "if exist \"%ProgramFiles%\\Microsoft Visual Studio\\2022\\Enterprise\\Common7\\Tools\\VsDevCmd.bat\" set \"OREN_VSINSTALL=%ProgramFiles%\\Microsoft Visual Studio\\2022\\Enterprise\"\r\n")
            oren_list_push(parts, "if not \"%OREN_VSINSTALL%\"==\"\" goto OREN_HAVE_VSINSTALL\r\n")

            // vswhere fallback (works for both VS2022 and older installations).
            oren_list_push(parts, "set \"OREN_VSWHERE=%OREN_MSVC_VSWHERE%\"\r\n")
            oren_list_push(parts, "if \"%OREN_VSWHERE%\"==\"\" set \"OREN_VSWHERE=%ProgramFiles(x86)%\\Microsoft Visual Studio\\Installer\\vswhere.exe\"\r\n")
            oren_list_push(parts, "if \"%OREN_VSWHERE%\"==\"\" set \"OREN_VSWHERE=%ProgramFiles%\\Microsoft Visual Studio\\Installer\\vswhere.exe\"\r\n")
            oren_list_push(parts, "if exist \"%OREN_VSWHERE%\" for /f \"usebackq delims=\" %%i in (`\"%OREN_VSWHERE%\" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set \"OREN_VSINSTALL=%%i\"\r\n")
            oren_list_push(parts, "if \"%OREN_VSINSTALL%\"==\"\" (\r\n")
            oren_list_push(parts, "  echo ERROR: could not locate VS installationPath. Install Visual Studio / Build Tools, or set OREN_MSVC_INSTALL_PATH/OREN_MSVC_DEV_CMD.\r\n")
            oren_list_push(parts, "  exit /b 2\r\n")
            oren_list_push(parts, ")\r\n")

            oren_list_push(parts, ":OREN_HAVE_VSINSTALL\r\n")
            // Select developer-env bootstrap script from VS installation.
            oren_list_push(parts, "if exist \"%OREN_VSINSTALL%\\Common7\\Tools\\VsDevCmd.bat\" set \"OREN_DEVCMD=%OREN_VSINSTALL%\\Common7\\Tools\\VsDevCmd.bat\"\r\n")
            oren_list_push(parts, "if \"%OREN_DEVCMD%\"==\"\" if exist \"%OREN_VSINSTALL%\\VC\\Auxiliary\\Build\\vcvars64.bat\" set \"OREN_DEVCMD=%OREN_VSINSTALL%\\VC\\Auxiliary\\Build\\vcvars64.bat\"\r\n")
            oren_list_push(parts, "if \"%OREN_DEVCMD%\"==\"\" (\r\n")
            oren_list_push(parts, "  echo ERROR: found VS at %OREN_VSINSTALL% but could not find VsDevCmd.bat or vcvars64.bat.\r\n")
            oren_list_push(parts, "  exit /b 2\r\n")
            oren_list_push(parts, ")\r\n")

            oren_list_push(parts, ":OREN_HAVE_DEVCMD\r\n")
            oren_list_push(parts, "for %%F in (\"%OREN_DEVCMD%\") do set \"OREN_DEVCMD_BASE=%%~nxF\"\r\n")
            oren_list_push(parts, "if /i \"%OREN_DEVCMD_BASE%\"==\"vcvars64.bat\" (\r\n")
            oren_list_push(parts, "  call \"%OREN_DEVCMD%\" >nul\r\n")
            oren_list_push(parts, ") else (\r\n")
            oren_list_push(parts, "  call \"%OREN_DEVCMD%\" -arch=amd64 -host_arch=amd64 -no_logo >nul\r\n")
            oren_list_push(parts, ")\r\n")
            oren_list_push(parts, "if errorlevel 1 exit /b %errorlevel%\r\n")

            // cl args.
            var cl_args = ["/nologo", "/std:c11", "/O2", "/Fe:" + out_win, c_win, "lib\\runtime.c", "lib\\runtime_buf.c", "/Ilib"]
            if no_gc { oren_list_push(cl_args, "/DOREN_NO_GC") }
            if msvc_python_flags != nil {
                var pf_i2 = 0
                while pf_i2 < oren_list_len(msvc_python_flags) {
                    oren_list_push(cl_args, msvc_python_flags[pf_i2])
                    pf_i2 = pf_i2 + 1
                }
            }
            var j_lib = 0
            while j_lib < oren_list_len(link_libs) {
                // Best-effort: pass as-is (can be .lib path or object file).
                oren_list_push(cl_args, _path_to_windows_sep(link_libs[j_lib]))
                j_lib = j_lib + 1
            }
            oren_list_push(parts, cmd_quote(cc))
            var j = 0
            while j < oren_list_len(cl_args) {
                oren_list_push(parts, " ")
                oren_list_push(parts, cmd_quote(cl_args[j]))
                j = j + 1
            }
            oren_list_push(parts, "\r\n")
            oren_list_push(parts, "exit /b %errorlevel%\r\n")

            var script_src = oren_string_join(parts)
            var ws = oren_write_file(sp, script_src)
            if oren_is_err(ws) {
                print("ERROR: failed to write MSVC wrapper script: " + script)
                var em = oren_err_msg(ws)
                if em != nil { print(em) }
                oren_exit(1)
            }
            cmd = "cmd.exe /d /c " + cmd_quote(sp)
        } else {
            // gcc/clang-style compiler on Windows (MSYS2). Keep the existing flag shape.
            cmd = cc + " -O2 -o " + shell_quote(out_path) + " " + shell_quote(c_path) + " lib/runtime.c lib/runtime_buf.c -Ilib"
            var k_lib = 0
            while k_lib < oren_list_len(link_libs) {
                cmd = cmd + " " + shell_quote(link_libs[k_lib])
                k_lib = k_lib + 1
            }
            if no_gc { cmd = cmd + " -DOREN_NO_GC" }
            if enable_python {
                if host_win {
                    var cflags = _run_cmd_capture_trim("python3-config --cflags", "build/tmp/_oren_py_cflags.txt")
                    var ldflags = _run_cmd_capture_trim("python3-config --embed --ldflags", "build/tmp/_oren_py_ldflags.txt")
                    if cflags == nil || cflags == "" || ldflags == nil || ldflags == "" {
                        print("ERROR: --python requires python3-config on PATH (or run under a POSIX shell)")
                        oren_exit(2)
                    }
                    cmd = cmd + " -DOREN_ENABLE_PYTHON " + cflags + " " + ldflags
                    oren_unlink("build/tmp/_oren_py_cflags.txt")
                    oren_unlink("build/tmp/_oren_py_ldflags.txt")
                } else {
                    cmd = cmd + " -DOREN_ENABLE_PYTHON $(python3-config --cflags) $(python3-config --embed --ldflags)"
                }
            }
        }
    } else {
        cmd = cc + " -O2 -o " + shell_quote(out_path) + " " + shell_quote(c_path) + " lib/runtime.c lib/runtime_buf.c -Ilib -pthread"
        var k_lib = 0
        while k_lib < oren_list_len(link_libs) {
            cmd = cmd + " " + shell_quote(link_libs[k_lib])
            k_lib = k_lib + 1
        }
        if no_gc { cmd = cmd + " -DOREN_NO_GC" }
        if enable_python {
            cmd = cmd + " -DOREN_ENABLE_PYTHON $(python3-config --cflags) $(python3-config --embed --ldflags)"
        }
    }

    var res = oren_system(cmd)
    if res != 0 {
        print("Build failed")
        oren_exit(1)
    }
    // On success, remove intermediate C output to keep builds clean.
    // (If you want the emitted C, use `--emit-c` / `oren emit-c`).
    // Best-effort cleanup: remove intermediate emitted C output (and helper scripts).
    // Do not fail the build if cleanup fails.
    if host_is_windows() {
        var p_del = _path_to_windows_sep(c_path)
        oren_unlink(p_del)
        if msvc_script_path != "" { oren_unlink(_path_to_windows_sep(msvc_script_path)) }
    } else {
        oren_unlink(c_path)
    }
    if target == "macos" {
        if codesign_id != "" {
            var cs_cmd2 = "codesign -s " + shell_quote(codesign_id) + " --force " + shell_quote(out_path)
            var cs_res2 = oren_system(cs_cmd2)
            if cs_res2 != 0 {
                print("codesign failed with " + codesign_id + ", retrying ad-hoc...")
                var ad_cmd2 = "codesign -s - --force " + shell_quote(out_path)
                var ad_res2 = oren_system(ad_cmd2)
                if ad_res2 != 0 {
                    print("codesign fallback failed")
                    oren_exit(1)
                }
            }
        }
    }
    if target == "macos" && notarize {
        var nt_cmd = ""
        if notary_profile != "" {
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --keychain-profile " + shell_quote(notary_profile) + " --wait"
        } else {
            var apple_id = oren_env("APPLE_ID")
            var apple_pass = oren_env("APPLE_ID_PASS")
            var apple_team = oren_env("APPLE_TEAM_ID")
            if apple_id == nil || apple_pass == nil || apple_team == nil {
                print("Notarization requested but APPLE_ID/APPLE_ID_PASS/APPLE_TEAM_ID or --notary-profile not set")
                oren_exit(1)
            }
            nt_cmd = "xcrun notarytool submit " + shell_quote(out_path) + " --apple-id " + shell_quote(apple_id) + " --password " + shell_quote(apple_pass) + " --team-id " + shell_quote(apple_team) + " --wait"
        }
        var nt_res = oren_system(nt_cmd)
        if nt_res != 0 {
            print("notarization failed")
            oren_exit(1)
        }
        var staple_cmd = "xcrun stapler staple " + shell_quote(out_path)
        var staple_res = oren_system(staple_cmd)
        if staple_res != 0 {
            print("staple failed")
            oren_exit(1)
        }
    }
    print("Build successful: " + out_path)
    if deterministic || emit_manifest {
        // Use u8_buf to avoid boxing the artifact into list<int> (huge memory blowups).
        var bsC = oren_read_u8_buf(out_path)
        if oren_is_err(bsC) {
            print("Failed to read artifact for hashing: " + out_path)
            var msgHC = oren_err_msg(bsC)
            if msgHC != nil { print(msgHC) }
            oren_exit(1)
        }
        if deterministic { _emit_artifact_hash("c", out_path, bsC) }
        if emit_manifest {
            var h = _sha256_hex(bsC)
            _write_artifact_manifest("c", out_path, h, target, arch, deterministic, _bytes_len_any(bsC))
        }
    }
    if cache_enabled && cache_key != nil {
        // Store C backend final artifact bytes for future cache hits.
        var bsCache = oren_read_u8_buf(out_path)
        if !oren_is_err(bsCache) {
            cache_store_artifact(cache_dir, cache_key, bsCache)
            // Ensure restored binaries are runnable (cp from cache uses write_bytes).
            oren_chmod(out_path, 493) // 0755
        }
    }
    if run_after_build { _run_test_artifact(backend, out_path) }
    return nil
}
