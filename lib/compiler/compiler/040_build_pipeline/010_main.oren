        //
	        // Format (rolling, v0):
	        //   bytes = "OREN_META\n1\n" + <meta_json_utf8_bytes>
	        if trace_phase_path != nil {
	            _build_phase_log_append(trace_phase_path, "build.bytecode.meta.start", "", t_sum0)
	        }
	        var meta_json = metadata.generate_metadata(linked_bc)
	        if trace_phase_path != nil {
	            _build_phase_log_append(trace_phase_path, "build.bytecode.meta.done", "bytes=" + oren_int_to_string(oren_string_len(meta_json)), t_sum0)
	        }
        var meta_bytes = []
        _build_push_string_bytes(meta_bytes, "OREN_META\n1\n")
        _build_push_string_bytes(meta_bytes, meta_json)
        ctx["meta_bytes"] = meta_bytes

        // Optional OBX (exports/relocs) for `.obc` module linking.
            if allow_undef || obc_lib {
