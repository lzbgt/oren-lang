            var item = handles[hi]
            var res = oren_join(item["h"])
            if res != 0 {
                failed = true
                print("Module parse worker failed; bucket modules:")
                var b = item["bucket"]
                var mi = 0
                while mi < oren_list_len(b) {
                    print("  - " + b[mi]["path"])
                    mi = mi + 1
                }
                if item["log"] != nil {
                    print("  log: " + item["log"])
                }
            }
            hi = hi + 1
        }
    } else {
        var total = oren_list_len(handles)
        var done = 0
        var last_print = 0
        if oren_env("OREN_TRACE_PHASES") != nil { last_print = oren_time_now_ns() }

        // If thread-mode `spawn` is cooperative (green tasks without background workers),
        // the polling loop below does not drive the scheduler and will deadlock.
        // In that mode, join sequentially (each join drives the scheduler).
        if _ml_spawn_is_cooperative() == true {
            var hi2 = 0
            while hi2 < oren_list_len(handles) {
                var item2 = handles[hi2]
                var h2 = item2["h"]
                var res2 = oren_join(h2)
                done = done + 1
                if res2 == nil || res2["ok"] != true {
                    failed = true
                    print("Module parse worker failed (cooperative thread mode)")
                    if res2 != nil && res2["path"] != nil {
                        print("  module: " + res2["path"])
                    }
                    if res2 != nil && res2["err"] != nil {
                        print("  err: " + res2["err"])
                    }
                    if res2 != nil && res2["errors"] != nil {
                        var ei2 = 0
                        while ei2 < oren_list_len(res2["errors"]) {
                            print("  " + res2["errors"][ei2])
                            ei2 = ei2 + 1
                        }
                    }
                }
                if oren_env("OREN_TRACE_PHASES") != nil {
                    print("[phase] link parse progress " + oren_int_to_string(done) + "/" + oren_int_to_string(total))
                }
                hi2 = hi2 + 1
            }
        } else {
        // Remaining queue (list of items with handles).
        var remaining = handles
        while oren_list_len(remaining) > 0 {
            var next_remaining = []
            var i0 = 0
            while i0 < oren_list_len(remaining) {
                var item0 = remaining[i0]
                var h0 = item0["h"]
                if oren_is_done(h0) == true {
                    var res0 = oren_join(h0)
                    done = done + 1
                    if res0 == nil || res0["ok"] != true {
                        failed = true
                        print("Module parse worker failed (thread mode)")
                        if res0 != nil && res0["path"] != nil {
                            print("  module: " + res0["path"])
                        }
                        if res0 != nil && res0["err"] != nil {
                            print("  err: " + res0["err"])
                        }
                        if res0 != nil && res0["errors"] != nil {
                            var ei = 0
                            while ei < oren_list_len(res0["errors"]) {
                                print("  " + res0["errors"][ei])
                                ei = ei + 1
                            }
                        }
                    } else {
                        // Success: worker attached module programs in-place.
                    }
                } else {
                    oren_list_push(next_remaining, item0)
                }
                i0 = i0 + 1
            }
            remaining = next_remaining

            // Progress output + short sleep to avoid busy spin.
            if oren_env("OREN_TRACE_PHASES") != nil {
                var now = oren_time_now_ns()
                if last_print == 0 || now - last_print > 250000000 {
                    print("[phase] link parse progress " + oren_int_to_string(done) + "/" + oren_int_to_string(total))
                    last_print = now
                }
            }
            if oren_list_len(remaining) > 0 {
                // GC-cooperative wait:
                // A worker thread may initiate stop-the-world GC at a safepoint. If the main
                // thread is sleeping here without entering safepoints, the GC protocol can
                // deadlock. Explicitly hit a safepoint between polls.
                oren_gc_safepoint()
                // Sleep ~5ms. This keeps polling deterministic and prevents burning CPU while waiting.
                oren_sleep_ns(5000000)
            }
        }
        }
    }
    if failed {
        print("Module parse worker failed")
        oren_exit(1)
    }

    if fork_mode {
        // Read results back and attach to MODULE_ORDER entries.
        i = 0
        while i < oren_list_len(MODULE_ORDER) {
            var m2 = MODULE_ORDER[i]
            if m2["program"] == nil {
                var p = path_norm(out_dir + "/" + _sha256_hex_string(m2["path"]) + ".astbin")
                var bs = oren_read_u8_buf(p)
                if oren_is_err(bs) {
                    print("Failed to read parsed module: " + p)
                    var em = oren_err_msg(bs)
                    if em != nil { print(em) }
                    oren_exit(1)
                }
                var prog = astbin_decode(bs)
                if prog == nil {
                    print("Failed to decode parsed module: " + p)
                    oren_exit(1)
                }
                m2["program"] = prog
            }
            i = i + 1
        }
    }
    if LINK_GC_ROOT != nil {
        LINK_GC_ROOT["parse_work"] = nil
        LINK_GC_ROOT["parse_buckets"] = nil
        LINK_GC_ROOT["parse_handles"] = nil
    }
    _ml_apply_anonymous_imports_to_modules_in_place()
    return 0
}

fn load_module(base, path, config) {
    var std_mode = nil
    if config != nil { std_mode = config["stdlib_mode"] }
    var is_std = _is_std_spec(path)

    // In stdlib `.obc` mode, avoid resolving stdlib source paths entirely.
    // This keeps compiler-in-AVM viable without shipping std sources.
    var full = nil
    if is_std && std_mode == "obc" {
        full = _canonical_std_spec(path)
    } else {
        full = resolve_import_path(base, path)
    }
    if MODULES[full] != nil {
        return MODULES[full]
    }

    if oren_env("OREN_TRACE_PASSES") != nil {
        print("[trace] load_module: " + full)
    }

    // Cycle check
    var k = 0
    while k < oren_list_len(MODULE_STACK) {
        if MODULE_STACK[k] == full {
            print("Cyclic import detected: " + full)
            oren_exit(1)
        }
        k = k + 1
    }
    oren_list_push(MODULE_STACK, full)

    // Extern stdlib module (bytecode stdlib linking mode):
    // - no parsing, no dependency walking
    // - contributes no statements, but does contribute OBC metadata for method lowering
    if is_std && std_mode == "obc" {
        var mod = {"prefix": _stable_std_prefix(path), "path": full, "program": {"statements": [], "traits": []}, "aliases": {}, "imports": [], "external_api": _ml_stdlib_obc_api(config), "added": false}
        MODULES[full] = mod
        if mod["added"] != true {
            mod["added"] = true
            oren_list_push(MODULE_ORDER, mod)
        }
        // Pop cycle-check stack.
        var new_stack = []
        var si = 0
        var sl = oren_list_len(MODULE_STACK)
        while si + 1 < sl {
            oren_list_push(new_stack, MODULE_STACK[si])
            si = si + 1
        }
        MODULE_STACK = new_stack
        return mod
    }

    var prog = _ml_parse_program_for_module(full, config)
    if prog == nil {
        print("Failed to read file: " + full)
        // Best-effort: surface include-expansion error deterministically without shared globals.
        if _ml_include_list_if_aggregator(full) == nil {
            var rr = expand_includes_file_result(full, [])
            if rr["ok"] != true && rr["err"] != nil { print(rr["err"]) }
        }
        oren_exit(1)
    }

    var prefix = _ml_stable_module_prefix_from_full(full)
    if is_std { prefix = _stable_std_prefix(path) }
    var mod = {"prefix": prefix, "path": full, "program": prog, "aliases": {}, "imports": [], "added": false}
    MODULES[full] = mod

    var dir = dirname(full)
    var seen_alias = {}
    var i = 0
    while i < oren_list_len(prog["statements"]) {
        var s = prog["statements"][i]
        if s["type"] == "Import" {
            var alias = _ml_import_alias_from_stmt(s)
            var dep = load_module(dir, s["path"], config)
            if _ml_import_stmt_is_anonymous(s) == true {
                oren_list_push(mod["imports"], {"alias": ".", "alias_ns": nil, "path": s["path"], "prefix": dep["prefix"], "full": dep["path"], "anonymous": true, "dep": dep})
            } else {
                if seen_alias[alias] != nil {
                    print("Duplicate import alias: " + alias + " in " + full)
                    oren_exit(1)
                }
                seen_alias[alias] = true
                var alias_ns = mod["prefix"] + alias
                mod["aliases"][alias_ns] = dep["prefix"]
                // Preserve import edges in deterministic source order for graph export.
                oren_list_push(mod["imports"], {"alias": alias, "alias_ns": alias_ns, "path": s["path"], "prefix": dep["prefix"], "full": dep["path"], "anonymous": false, "dep": dep})
            }
        }
        i = i + 1
    }

    // Rename pass would be here, but we need to move rename logic to a module too?
    // For now let's assume we copy `collect_toplevel_rename_pairs` etc.
    // Or better, put them in `analysis.oren` or a new `modules.oren`.
    // Let's put module logic in `compiler.oren` for now as it orchestrates loading.
    var pairs = renamer.collect_toplevel_rename_pairs(prog, mod["prefix"])
    i = 0
    while i < oren_list_len(prog["statements"]) {
        var s2 = prog["statements"][i]
        if s2["type"] == "Import" {
            var alias2 = _ml_import_alias_from_stmt(s2)
            if alias2 != "." {
                if renamer.rename_lookup(pairs, alias2) != "" {
                    print("Import alias conflicts with top-level name: " + alias2 + " in " + full)
                    oren_exit(1)
                }
            }
        }
        i = i + 1
    }

    // Namespace import aliases with the *owning* module prefix so after linking/merging
    // all statements into one program, alias resolution remains unambiguous and scoped.
    //
    // Example: within module prefix "M5_", `lexer.new_lexer(...)` becomes `M5_lexer.new_lexer(...)`.
    i = 0
    while i < oren_list_len(prog["statements"]) {
        var s3 = prog["statements"][i]
        if s3["type"] == "Import" {
            var a3 = _ml_import_alias_from_stmt(s3)
            if a3 != "." { pairs[a3] = mod["prefix"] + a3 }
        }
        i = i + 1
    }
    var ar_load = _ml_apply_anonymous_imports_to_program_in_place(full, prog, mod["imports"], pairs)
    if ar_load["ok"] != true {
        print("Anonymous import errors in " + full + ":")
        if ar_load["err"] != nil { print(ar_load["err"]) }
        oren_exit(1)
    }

    // Attribute-driven JSON serde codegen (opt-in via `@json.derive(...)`).
    // Must run *after* module renaming so generated functions are naturally prefixed
    // via the (already-prefixed) type names.
    serde_json.lower_program_in_place(prog, mod["prefix"])
    if prog["serde_json_errors"] != nil && oren_list_len(prog["serde_json_errors"]) > 0 {
        var first_err = prog["serde_json_errors"][0]
        emit_diag("compile", 1, first_err)
        print("Serde JSON lowering errors in " + full + ":")
        var ei = 0
        while ei < oren_list_len(prog["serde_json_errors"]) {
            print(prog["serde_json_errors"][ei])
            ei = ei + 1
        }
        oren_exit(1)
    }

    if mod["added"] != true {
        mod["added"] = true
        oren_list_push(MODULE_ORDER, mod)
    }

    // Pop cycle-check stack (runtime has no list_pop; do it manually).
    var new_stack = []
    var si = 0
    var sl = oren_list_len(MODULE_STACK)
    while si + 1 < sl {
        oren_list_push(new_stack, MODULE_STACK[si])
        si = si + 1
    }
    MODULE_STACK = new_stack

    return mod
}

fn _ml_collect_test_funcs_from_stmts(stmts) {
    var out = []
    if stmts == nil { return out }
    var seen = {}
    var i = 0
    while i < oren_list_len(stmts) {
        var s = stmts[i]
        if s != nil && s["type"] == "ExprStmt" {
            var e = s["expr"]
            if e != nil && e["type"] == "Function" && e["is_test"] == true {
                var nm = e["name"]
                if nm != nil && nm != "" {
                    var label = e["test_name"]
                    if seen[nm] == true {
                        var msg = "duplicate test name after sanitization: " + nm
                        if label != nil && label != "" { msg = msg + " (label: " + label + ")" }
                        emit_diag("compile", 2, msg)
                        print(msg)
                        oren_exit(2)
                    }
                    seen[nm] = true
                    oren_list_push(out, {"name": nm, "label": label})
                }
            }
        }
        i = i + 1
    }
    return out
}

fn _ml_append_test_runner_calls(stmts, tests) {
    if stmts == nil || tests == nil { return nil }
    var i = 0
    while i < oren_list_len(tests) {
        var t = tests[i]
        var name = t["name"]
        var tok = {"type": "IDENT", "literal": name}
        var ident = ast.new_identifier(tok)
        var call = ast.new_call(tok, ident, [])
        var stmt = ast.new_expr_stmt(tok, call)
        oren_list_push(stmts, stmt)
        i = i + 1
    }
    if oren_list_len(tests) > 0 {
        var msg_tok = {"type": "STRING", "literal": "ok: tests passed"}
        var msg = ast.new_string(msg_tok)
        var print_tok = {"type": "IDENT", "literal": "print"}
        var print_ident = ast.new_identifier(print_tok)
        var print_call = ast.new_call(print_tok, print_ident, [msg])
        var print_stmt = ast.new_expr_stmt(print_tok, print_call)
        oren_list_push(stmts, print_stmt)
        var exit_tok = {"type": "IDENT", "literal": "oren_exit"}
        var exit_ident = ast.new_identifier(exit_tok)
        var code_tok = {"type": "INT", "literal": "0"}
        var exit_call = ast.new_call(exit_tok, exit_ident, [ast.new_integer(code_tok)])
        var exit_stmt = ast.new_expr_stmt(exit_tok, exit_call)
        oren_list_push(stmts, exit_stmt)
    }
    return nil
}

fn _ml_phase_log_path() {
    var p = oren_env("OREN_TRACE_BUILD_PHASES_PATH")
    if p == nil || p == "" || p == "0" { return nil }
    return p
}

fn _ml_phase_log_append(path, phase, detail, t0) {
    if path == nil || phase == nil || phase == "" { return nil }
    var now = oren_time_now_ns()
    var line = "phase=" + phase + " now_ns=" + oren_int_to_string(now)
    if t0 != nil && t0 > 0 {
        line = line + " total_ms=" + oren_int_to_string((now - t0) / 1000000)
    }
    if detail != nil && detail != "" { line = line + " " + detail }
    oren_append_file(path, line + "\n")
    return nil
}

fn link_program(entry_path, root_prog, config) {
    var trace_passes = oren_env("OREN_TRACE_PASSES") != nil
    var trace_phases = oren_env("OREN_TRACE_PHASES") != nil
    var phase_log_path = _ml_phase_log_path()
    var t0 = 0
    if trace_phases || phase_log_path != nil { t0 = oren_time_now_ns() }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.enter", "path=" + entry_path, t0) }
    if trace_passes { print("[trace] link: start " + entry_path) }
    MODULES = {}
    MODULE_STACK = []
    MODULE_ORDER = []
    MODULE_ID_COUNTER = 0

    // GC safety (rolling, Windows bring-up):
    // The native GC stack scan can miss locals in deep or optimized frames. Pin a composite
    // root for the full link phase so module discovery/parse worklists stay reachable even if
    // a safepoint triggers collection.
    LINK_GC_ROOT = {"root_prog": root_prog, "config": config, "modules": MODULES, "module_stack": MODULE_STACK, "module_order": MODULE_ORDER}
    var prev_pin = oren_gc_pin(LINK_GC_ROOT)
    
    var base = dirname(entry_path)
    var root_prefix = "R_"
    var root_aliases = {}
    var root_imports = []
    if LINK_GC_ROOT != nil { LINK_GC_ROOT["root_aliases"] = root_aliases; LINK_GC_ROOT["root_imports"] = root_imports }

    // Conditional compilation (rolling):
    // Filter the root program early so:
    // - rename/serde passes don't see cfg-disabled duplicates
    // - codegen doesn't error on duplicate top-level names that are mutually exclusive by cfg
    debug_sugar.lower_program_in_place(root_prog, config)
    if config != nil {
        cfg_lowering.lower_program_in_place(root_prog, config)
        if root_prog["cfg_errors"] != nil && oren_is_list(root_prog["cfg_errors"]) == true && oren_list_len(root_prog["cfg_errors"]) > 0 {
            var first_err0 = root_prog["cfg_errors"][0]
            emit_diag("compile", 1, first_err0)
            print("Cfg filtering errors in " + entry_path + ":")
            var ei0 = 0
            while ei0 < oren_list_len(root_prog["cfg_errors"]) {
                print(root_prog["cfg_errors"][ei0])
                ei0 = ei0 + 1
            }
            oren_exit(1)
        }
    }
    
    var i = 0
    while i < oren_list_len(root_prog["statements"]) {
        var s = root_prog["statements"][i]
        if s["type"] == "Import" {
            var alias = _ml_import_alias_from_stmt(s)
            var mod = discover_module(base, s["path"], config)
            if _ml_import_stmt_is_anonymous(s) == true {
                oren_list_push(root_imports, {"alias": ".", "alias_ns": nil, "path": s["path"], "prefix": mod["prefix"], "full": mod["path"], "anonymous": true, "dep": mod})
            } else {
                var alias_ns = root_prefix + alias
                root_aliases[alias_ns] = mod["prefix"]
                // Preserve root import edges in source order.
                oren_list_push(root_imports, {"alias": alias, "alias_ns": alias_ns, "path": s["path"], "prefix": mod["prefix"], "full": mod["path"], "anonymous": false, "dep": mod})
            }
        }
        i = i + 1
    }
    if trace_phases {
        var dt0 = oren_time_now_ns() - t0
        print("[phase] link discover done +" + oren_int_to_string(dt0 / 1000000) + "ms modules=" + oren_int_to_string(oren_list_len(MODULE_ORDER)))
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.discover.done", "modules=" + oren_int_to_string(oren_list_len(MODULE_ORDER)), t0) }

    // Parse all discovered modules in fork-parallel workers.
    _ml_parse_discovered_modules_parallel(config)
    if trace_phases {
        var dt1 = oren_time_now_ns() - t0
        print("[phase] link parse done +" + oren_int_to_string(dt1 / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.parse_modules.done", "", t0) }

    // Apply the same alias namespacing rule to the root module so its imports are
    // scoped and do not collide with nested module imports after linking.
    var root_has_anonymous_imports = _ml_imports_have_anonymous(root_imports)
    var root_pairs = {}
    if root_has_anonymous_imports == true { root_pairs = _ml_collect_toplevel_identity_pairs(root_prog) }
    i = 0
    while i < oren_list_len(root_prog["statements"]) {
        var s0 = root_prog["statements"][i]
        if s0["type"] == "Import" {
            var a0 = _ml_import_alias_from_stmt(s0)
            if a0 != "." { root_pairs[a0] = root_prefix + a0 }
        }
        i = i + 1
    }
    if root_has_anonymous_imports == true {
        var ar_root = _ml_apply_anonymous_imports_to_program_in_place(entry_path, root_prog, root_imports, root_pairs)
        if ar_root["ok"] != true {
            emit_diag("compile", 1, ar_root["err"])
            print("Anonymous import errors in " + entry_path + ":")
            if ar_root["err"] != nil { print(ar_root["err"]) }
            oren_exit(1)
        }
    } else {
        renamer.rename_program_in_place(root_prog, root_pairs)
    }

    // Attribute-driven JSON serde codegen for the root module.
    // Root is not renamed, so prefix is empty.
    serde_json.lower_program_in_place(root_prog, "")
    if root_prog["serde_json_errors"] != nil && oren_list_len(root_prog["serde_json_errors"]) > 0 {
        var first_err = root_prog["serde_json_errors"][0]
        emit_diag("compile", 1, first_err)
        print("Serde JSON lowering errors in " + entry_path + ":")
        var ei = 0
        while ei < oren_list_len(root_prog["serde_json_errors"]) {
            print(root_prog["serde_json_errors"][ei])
            ei = ei + 1
        }
        oren_exit(1)
    }
    
    var merged_stmts = []
    var merged_traits = []
    var type_ns = {}
    if LINK_GC_ROOT != nil {
        LINK_GC_ROOT["merged_stmts"] = merged_stmts
        LINK_GC_ROOT["merged_traits"] = merged_traits
        LINK_GC_ROOT["type_ns"] = type_ns
    }
    
    i = 0
    while i < oren_list_len(MODULE_ORDER) {
        var mod = MODULE_ORDER[i]
        var stmts = mod["program"]["statements"]
        if mod["program"]["traits"] != nil {
            var ti = 0
            while ti < oren_list_len(mod["program"]["traits"]) {
                oren_list_push(merged_traits, mod["program"]["traits"][ti])
                ti = ti + 1
            }
        }
        var j = 0
        while j < oren_list_len(stmts) {
            var st = stmts[j]
            if st["type"] == "Type" {
                type_ns[st["name"]["value"]] = true
            }
            if st["type"] != "Import" {
                oren_list_push(merged_stmts, st)
            }
            j = j + 1
        }
        i = i + 1
    }
    
    i = 0
    while i < oren_list_len(root_prog["statements"]) {
        var st = root_prog["statements"][i]
        if st["type"] == "Type" {
            type_ns[st["name"]["value"]] = true
        }
        if st["type"] != "Import" {
            oren_list_push(merged_stmts, st)
        }
        i = i + 1
    }

    if root_prog["traits"] != nil {
        var rti = 0
        while rti < oren_list_len(root_prog["traits"]) {
            oren_list_push(merged_traits, root_prog["traits"][rti])
            rti = rti + 1
        }
    }
    var test_mode = false
    if config != nil && config["test_mode"] == true { test_mode = true }
    if test_mode == true {
        var tests = _ml_collect_test_funcs_from_stmts(merged_stmts)
        _ml_append_test_runner_calls(merged_stmts, tests)
    }
    if trace_phases {
        var dt2 = oren_time_now_ns() - t0
        print("[phase] link merge done +" + oren_int_to_string(dt2 / 1000000) + "ms stmts=" + oren_int_to_string(oren_list_len(merged_stmts)))
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.merge.done", "stmts=" + oren_int_to_string(oren_list_len(merged_stmts)), t0) }
    
    // Preserve metadata-only surfaces across module linking.
    // (Traits are not represented as executable statements yet in v0.)
    // Provide a deterministic module graph surface for tooling.
    var module_summaries = []
    i = 0
    while i < oren_list_len(MODULE_ORDER) {
        var m = MODULE_ORDER[i]
        oren_list_push(module_summaries, {"prefix": m["prefix"], "path": m["path"], "imports": m["imports"]})
        i = i + 1
    }

    // Global alias map for whole-program codegen.
    //
    // `load_module()` keeps `mod["aliases"]` per-module, but after we merge all
    // statements into one linked program, backends need a single alias lookup
    // table to resolve `alias.symbol` member calls (e.g. `lexer.new_lexer`).
    //
    // Rolling rule:
    // - import aliases are namespaced per-module (see `load_module` and root module renaming)
    // - after namespacing, aliases must be globally unique; any collision is a bug
    var all_aliases = {}
    // root aliases first
    var ri = 0
    while ri < oren_list_len(root_imports) {
        var e = root_imports[ri]
        if e != nil && e["anonymous"] != true && e["alias_ns"] != nil {
            all_aliases[e["alias_ns"]] = e["prefix"]
        }
        ri = ri + 1
    }
    // merge module aliases in deterministic order (MODULE_ORDER, then per-module import order)
    i = 0
    while i < oren_list_len(MODULE_ORDER) {
        var m2 = MODULE_ORDER[i]
        var imps = m2["imports"]
        if imps != nil {
            var ii = 0
            while ii < oren_list_len(imps) {
                var ie = imps[ii]
                var a2 = ie["alias_ns"]
                var p2 = ie["prefix"]
                if ie["anonymous"] == true || a2 == nil {
                    // Anonymous imports are already resolved into direct rename pairs.
                } else if all_aliases[a2] == nil {
                    all_aliases[a2] = p2
                } else {
                    if all_aliases[a2] != p2 {
                        var msgA = "Import alias conflict: '" + a2 + "' maps to both '" + all_aliases[a2] + "' and '" + p2 + "'"
                        emit_diag("compile", 1, msgA)
                        print(msgA)
                        oren_exit(1)
                    }
                }
                ii = ii + 1
            }
        }
        i = i + 1
    }
    if trace_phases {
        var dt3 = oren_time_now_ns() - t0
        print("[phase] link aliases done +" + oren_int_to_string(dt3 / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.aliases.done", "", t0) }

    var external_function_returns = {}
    var external_impl_methods = {}
    var external_impl_trait_methods = {}
    i = 0
    while i < oren_list_len(MODULE_ORDER) {
        var emod = MODULE_ORDER[i]
        var api = emod["external_api"]
        if api != nil {
            var fr = api["function_returns"]
            for fn_name in fr {
                external_function_returns[fn_name] = fr[fn_name]
            }
            var im = api["impl_methods"]
            for type_name in im {
                if external_impl_methods[type_name] == nil { external_impl_methods[type_name] = {} }
                var methods = im[type_name]
                for method_name in methods {
                    external_impl_methods[type_name][method_name] = methods[method_name]
                }
            }
            var itm = api["impl_trait_methods"]
            for trait_name in itm {
                if external_impl_trait_methods[trait_name] == nil { external_impl_trait_methods[trait_name] = {} }
                var types = itm[trait_name]
                for type_name2 in types {
                    if external_impl_trait_methods[trait_name][type_name2] == nil { external_impl_trait_methods[trait_name][type_name2] = {} }
                    var methods2 = types[type_name2]
                    for method_name2 in methods2 {
                        external_impl_trait_methods[trait_name][type_name2][method_name2] = methods2[method_name2]
                    }
                }
            }
            var traits_ext = api["traits"]
            var ti_ext = 0
            while traits_ext != nil && ti_ext < oren_list_len(traits_ext) {
                oren_list_push(merged_traits, traits_ext[ti_ext])
                ti_ext = ti_ext + 1
            }
        }
        i = i + 1
    }

    var linked = {
        "statements": merged_stmts,
        "traits": merged_traits,
        "aliases": all_aliases,
        "type_ns": type_ns,
        "external_function_returns": external_function_returns,
        "external_impl_methods": external_impl_methods,
        "external_impl_trait_methods": external_impl_trait_methods,
        "config": config,
        "module_graph": {"entry": entry_path, "imports": root_imports, "modules": module_summaries}
    }

    // Whole-program cfg pass (safety belt): ensure any remaining cfg-gated decls are filtered
    // before subsequent passes. (Per-module preparation already runs cfg, but this keeps the
    // contract stable if that pipeline evolves.)
    if trace_passes { print("[trace] pass: cfg") }
    cfg_lowering.lower_linked_program_in_place(linked)
    if linked["cfg_errors"] != nil && oren_list_len(linked["cfg_errors"]) > 0 {
        var first_cfg = linked["cfg_errors"][0]
        emit_diag("compile", 1, first_cfg)
        print("Cfg filtering errors:")
        var cei = 0
        while cei < oren_list_len(linked["cfg_errors"]) {
            print(linked["cfg_errors"][cei])
            cei = cei + 1
        }
        oren_exit(1)
    }

    // Rolling module visibility:
    // - modules with any `pub` declaration become closed-by-default to imports
    // - modules without `pub` remain legacy-open during migration
    if trace_passes { print("[trace] pass: module_visibility") }
    module_visibility.lower_linked_program_in_place(linked)
    if linked["visibility_errors"] != nil && oren_list_len(linked["visibility_errors"]) > 0 {
        var first_vis = linked["visibility_errors"][0]
        emit_diag("compile", 1, first_vis)
        print("Module visibility errors:")
        var vei = 0
        while vei < oren_list_len(linked["visibility_errors"]) {
            print(linked["visibility_errors"][vei])
            vei = vei + 1
        }
        oren_exit(1)
    }

    // Normalize cross-module type annotation spellings:
    //   <alias_ns>.Type -> <dep_prefix>Type
    //
    // Must run before lowerings that consult annotations for dispatch decisions.
    if trace_passes { print("[trace] pass: type_name_resolve") }
    type_resolve.lower_linked_program_in_place(linked)
    if linked["type_name_errors"] != nil && oren_list_len(linked["type_name_errors"]) > 0 {
        var first_err = linked["type_name_errors"][0]
        emit_diag("compile", 1, first_err)
        print("Type name resolution errors:")
        var ei = 0
        while ei < oren_list_len(linked["type_name_errors"]) {
            print(linked["type_name_errors"][ei])
            ei = ei + 1
        }
        oren_exit(1)
    }
    if trace_phases {
        var dt4 = oren_time_now_ns() - t0
        print("[phase] pass type_name_resolve +" + oren_int_to_string(dt4 / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.type_name_resolve.done", "", t0) }

    // Whole-program impl/method-call lowering:
    // - enables cross-module method call sugar without runtime vtables
    // - enforces deterministic coherence (ambiguous overlap is a compile error)
    if trace_passes { print("[trace] pass: impl_lowering") }
    impl_lowering.lower_linked_program_in_place(linked)
    if linked["impl_lowering_errors"] != nil && oren_list_len(linked["impl_lowering_errors"]) > 0 {
        var first_err = linked["impl_lowering_errors"][0]
        emit_diag("compile", 1, first_err)
        print("Impl lowering errors:")
        var ei = 0
        while ei < oren_list_len(linked["impl_lowering_errors"]) {
            print(linked["impl_lowering_errors"][ei])
            ei = ei + 1
        }
        oren_exit(1)
    }
    if trace_phases {
        var dt5 = oren_time_now_ns() - t0
        print("[phase] pass impl_lowering +" + oren_int_to_string(dt5 / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.impl_lowering.done", "", t0) }

    // Compile-time lowering: packed struct views over bytes.
    if trace_passes { print("[trace] pass: packview") }
    packview.lower_linked_program_in_place(linked)
    if linked["packview_errors"] != nil && oren_list_len(linked["packview_errors"]) > 0 {
        var first_err = linked["packview_errors"][0]
        emit_diag("compile", 1, first_err)
        print("Packview errors:")
        var ei = 0
        while ei < oren_list_len(linked["packview_errors"]) {
            print(linked["packview_errors"][ei])
            ei = ei + 1
        }
        oren_exit(1)
    }
    if trace_phases {
        var dt5b = oren_time_now_ns() - t0
        print("[phase] pass packview +" + oren_int_to_string(dt5b / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.packview.done", "", t0) }

    // Always-on parity guard (native backend hazard):
    // - Comparing provably-scalar values (bool/int/float) to `nil` is almost always a bug.
    // - The native runtime uses a sentinel representation for `nil`, so treating `== nil` as
    //   “missing” can silently misbehave (especially when `0`/`false` are valid values).
    //
