    // This guard is conservative (best-effort inference) and is intentionally always enabled,
    // even when the full gradual-typing pass is disabled.
    if trace_passes { print("[trace] pass: nil_compare_guard") }
    typecheck.nil_scalar_compare_guard_linked_program_in_place(linked)
    var nil_compare_errors = linked["nil_compare_errors"]
    if nil_compare_errors != nil {
        var nil_compare_errors_len = oren_list_len(nil_compare_errors)
        if nil_compare_errors_len > 0 {
            var first_err0 = nil_compare_errors[0]
            emit_diag("compile", 1, first_err0)
            print("Nil-compare guard errors:")
            var ei_ng = 0
            while ei_ng < nil_compare_errors_len {
                print(nil_compare_errors[ei_ng])
                ei_ng = ei_ng + 1
            }
            oren_exit(1)
        }
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.nil_compare_guard.done", "", t0) }

    // Optional: typecheck pass (gradual typing).
    //
    // Run this before normalization casts are inserted so diagnostics point at user code
    // rather than compiler-generated boundary rewrites.
    if config != nil && config["typecheck"] == true {
        if trace_passes { print("[trace] pass: typecheck") }
        typecheck.typecheck_linked_program_in_place(linked)
    }
    var typecheck_errors = linked["typecheck_errors"]
    if typecheck_errors != nil {
        var typecheck_errors_len = oren_list_len(typecheck_errors)
        if typecheck_errors_len > 0 {
            var first_err = typecheck_errors[0]
            emit_diag("typecheck", 1, first_err)
            print("Typecheck errors:")
            var ei2 = 0
            while ei2 < typecheck_errors_len {
                print(typecheck_errors[ei2])
                ei2 = ei2 + 1
            }
            oren_exit(1)
        }
    }


    // Compile-time lowering: apply value-level normalization for annotated boundaries.
    // (Rolling step toward exact-size layout semantics.)
    if trace_passes { print("[trace] pass: type_ann") }
    type_ann.lower_linked_program_in_place(linked)
    if trace_phases {
        var dt5c = oren_time_now_ns() - t0
        print("[phase] pass type_ann +" + oren_int_to_string(dt5c / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.type_ann.done", "", t0) }

    // Compile-time lowering: specialization call sugar.
    //   f[T](...) -> f__T(...)
    //
    // This is a v0 stepping stone toward full generics + monomorphization, with zero runtime cost.
    if trace_passes { print("[trace] pass: generic_calls") }
    gen_calls.lower_linked_program_in_place(linked)
    var generic_call_errors = linked["generic_call_errors"]
    if generic_call_errors != nil {
        var generic_call_errors_len = oren_list_len(generic_call_errors)
        if generic_call_errors_len > 0 {
            var first_err = generic_call_errors[0]
            emit_diag("compile", 1, first_err)
            print("Generic call errors:")
            var ei0 = 0
            while ei0 < generic_call_errors_len {
                print(generic_call_errors[ei0])
                ei0 = ei0 + 1
            }
            oren_exit(1)
        }
    }
    if trace_phases {
        var dt6 = oren_time_now_ns() - t0
        print("[phase] pass generic_calls +" + oren_int_to_string(dt6 / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.generic_calls.done", "", t0) }

    // Compile-time lowering: generic function monomorphization (rolling v0).
    //   fn f[T](...) + f[T](...) calls  ->  fn f__T(...)
    if trace_passes { print("[trace] pass: generic_mono") }
    gen_mono.lower_linked_program_in_place(linked)
    var generic_monomorph_errors = linked["generic_monomorph_errors"]
    if generic_monomorph_errors != nil {
        var generic_monomorph_errors_len = oren_list_len(generic_monomorph_errors)
        if generic_monomorph_errors_len > 0 {
            var first_err = generic_monomorph_errors[0]
            emit_diag("compile", 1, first_err)
            print("Generic monomorphization errors:")
            var ei = 0
            while ei < generic_monomorph_errors_len {
                print(generic_monomorph_errors[ei])
                ei = ei + 1
            }
            oren_exit(1)
        }
    }
    if trace_phases {
        var dt7 = oren_time_now_ns() - t0
        print("[phase] pass generic_mono +" + oren_int_to_string(dt7 / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.generic_mono.done", "", t0) }

    // Generic monomorphization creates new concrete functions after the first
    // impl-lowering pass. Re-run method lowering so trait receiver calls inside
    // generated specializations lower to zero-cost impl functions too.
    linked["impl_lowering_errors"] = nil
    if trace_passes { print("[trace] pass: impl_lowering.post_generic_mono") }
    impl_lowering.lower_linked_program_in_place(linked)
    var impl_lowering_errors = linked["impl_lowering_errors"]
    if impl_lowering_errors != nil {
        var impl_lowering_errors_len = oren_list_len(impl_lowering_errors)
        if impl_lowering_errors_len > 0 {
            var first_impl_err = impl_lowering_errors[0]
            emit_diag("compile", 1, first_impl_err)
            print("Impl lowering errors:")
            var ei_impl = 0
            while ei_impl < impl_lowering_errors_len {
                print(impl_lowering_errors[ei_impl])
                ei_impl = ei_impl + 1
            }
            oren_exit(1)
        }
    }
    if trace_phases {
        var dt7b = oren_time_now_ns() - t0
        print("[phase] pass impl_lowering.post_generic_mono +" + oren_int_to_string(dt7b / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.impl_lowering.post_generic_mono.done", "", t0) }

    // Compile-time lowering: ABI layout computation and sizeof/offsetof constants.
    // Opt-in via `@abi` (canonical: `@oren.abi`) and does not depend on host headers.
    if trace_passes { print("[trace] pass: abi_layout") }
    abi_layout.lower_linked_program_in_place(linked)
    var abi_layout_errors = linked["abi_layout_errors"]
    if abi_layout_errors != nil {
        var abi_layout_errors_len = oren_list_len(abi_layout_errors)
        if abi_layout_errors_len > 0 {
            var first_err = abi_layout_errors[0]
            emit_diag("compile", 1, first_err)
            print("ABI layout errors:")
            var ei = 0
            while ei < abi_layout_errors_len {
                print(abi_layout_errors[ei])
                ei = ei + 1
            }
            oren_exit(1)
        }
    }
    if trace_phases {
        var dt8 = oren_time_now_ns() - t0
        print("[phase] pass abi_layout +" + oren_int_to_string(dt8 / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.abi_layout.done", "", t0) }


    // Optimizer baseline (safe, conservative).
    if trace_passes { print("[trace] pass: optimizer") }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.optimizer.start", "", t0) }
    optimizer.lower_linked_program_in_place(linked)
    if trace_phases {
        var dt9 = oren_time_now_ns() - t0
        print("[phase] pass optimizer +" + oren_int_to_string(dt9 / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.optimizer.done", "", t0) }

    // Whole-program function DCE (rolling):
    // - keeps semantic/type/attr passes applied to the full program
    // - removes unreachable functions before backend compilation
    // - fixes "imported stdlib has unsupported exprs" for tier-1 native v0 backends
    if trace_passes { print("[trace] pass: global_dce") }
    global_dce.lower_linked_program_in_place(linked)
    if trace_phases {
        var dt10 = oren_time_now_ns() - t0
        print("[phase] pass global_dce +" + oren_int_to_string(dt10 / 1000000) + "ms")
    }
    if phase_log_path != nil { _ml_phase_log_append(phase_log_path, "link.global_dce.done", "stmts=" + oren_int_to_string(oren_list_len(linked["statements"])), t0) }

    if trace_passes { print("[trace] link: done (stmts=" + oren_int_to_string(oren_list_len(linked["statements"])) + ")") }
    oren_gc_pin(prev_pin)
    LINK_GC_ROOT = nil
    return linked
}
