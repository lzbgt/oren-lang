            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // Currently: X0=mode, X1=flags, X2=path.
            // macOS wants: X0=path, X1=flags, X2=mode.
            // Linux wants: X0=-100, X1=path, X2=flags, X3=mode.

            var svc_imm = 128
            var sys_reg = 16
            var is_macos = true
            if ctx["platform"]["os"] == "linux" {
                svc_imm = 0
                sys_reg = 8
                is_macos = false
            }

            if is_macos {
                push_u32_le(ctx["code"], insn_mov_reg(3, 0)) // X3 = mode
                push_u32_le(ctx["code"], insn_mov_reg(0, 2)) // X0 = path
                push_u32_le(ctx["code"], insn_mov_reg(2, 3)) // X2 = mode

                var sys_open = 5
                push_u32_le(ctx["code"], insn_movz(sys_reg, sys_open))
                push_u32_le(ctx["code"], insn_svc(svc_imm))
                // Normalize macOS syscall error (X0=errno) to X0=-errno.
                var br_ok = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.CS ok
