import parser "parser.oren"
import lexer "lexer.oren"
import token "token.oren"

// --- Binary Utils ---
fn bytes_new() { return [] }
fn bytes_push(b, v) { oren_list_push(b, v) }
fn bytes_extend(b, other) {
    var i = 0
    while i < oren_list_len(other) {
        oren_list_push(b, other[i])
        i = i + 1
    }
}

fn set_u32_le(buf, offset, n) {
    var base = offset
    oren_index_set(buf, base, int_mod(n, 256))
    oren_index_set(buf, base+1, int_mod(n / 256, 256))
    oren_index_set(buf, base+2, int_mod(n / 65536, 256))
    oren_index_set(buf, base+3, int_mod(n / 16777216, 256))
}

fn align_up(n, align) {
    return (n + align - 1) / align * align
}

fn ceil_div(a, b) {
    return (a + b - 1) / b
}

fn int_mod(a, b) { return a - (a / b) * b }

fn int_from_string(s) {
    var i = 0
    var n = 0
    var neg = false
    if oren_string_char_at(s, 0) == "-" {
        neg = true
        i = 1
    }
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        var digit = 0
        if ch == "0" { digit = 0 }
        if ch == "1" { digit = 1 }
        if ch == "2" { digit = 2 }
        if ch == "3" { digit = 3 }
        if ch == "4" { digit = 4 }
        if ch == "5" { digit = 5 }
        if ch == "6" { digit = 6 }
        if ch == "7" { digit = 7 }
        if ch == "8" { digit = 8 }
        if ch == "9" { digit = 9 }
        n = n * 10 + digit
        i = i + 1
    }
    if neg { return -n }
    return n
}

fn contains_curly_braces(s) {
    var i = 0
    var len = oren_string_len(s)
    while i < len - 1 {
        if oren_string_char_at(s, i) == "{" {
            if oren_string_char_at(s, i + 1) == "}" { return true }
        }
        i = i + 1
    }
    return false
}

fn push_u32_le(buf, n) {
    bytes_push(buf, int_mod(n, 256))
    bytes_push(buf, int_mod(n / 256, 256))
    bytes_push(buf, int_mod(n / 65536, 256))
    bytes_push(buf, int_mod(n / 16777216, 256))
}

fn push_u32_be(buf, n) {
    bytes_push(buf, int_mod(n / 16777216, 256))
    bytes_push(buf, int_mod(n / 65536, 256))
    bytes_push(buf, int_mod(n / 256, 256))
    bytes_push(buf, int_mod(n, 256))
}

fn push_u64_le(buf, n) {
    var i = 0
    while i < 8 {
        var byte = int_mod(n, 256)
        bytes_push(buf, byte)
        n = n / 256
        i = i + 1
    }
}

// --- ARM64 Instructions ---

fn insn_ret() { return 3596551104 } // RET (0xD65F03C0)

fn insn_movz(reg, imm16) {
    // MOVZ Xreg, #imm16
    return 3531603968 + (imm16 * 32) + reg
}

fn insn_mov_reg(rd, rn) {
    // MOV Xrd, Xrn (alias of ORR Xrd, XZR, Xrn)
    return 2852127712 + (rn * 65536) + rd // 0xAA0003E0 base
}

fn insn_movn(rd, imm) {
    return 2457862144 + (imm * 32) + rd
}

fn insn_svc(imm) {
    return 3556769793 + (imm * 32)
}

fn insn_add_sp(imm) {
    return 2432697343 + (imm * 1024)
}

fn insn_str_x0_sp(offset) {
    return 4177527776 + ((offset / 8) * 1024)
}

fn insn_ldr_reg_sp(reg, offset) {
    return 4181722080 + ((offset / 8) * 1024) + reg
}

fn insn_ldr_x0_sp(offset) {
    return insn_ldr_reg_sp(0, offset)
}

fn insn_add_reg(rd, rn, rm) {
    return 2332033024 + (rm * 65536) + (rn * 32) + rd
}

fn insn_and_reg(rd, rn, rm) {
    return 2315255808 + (rm * 65536) + (rn * 32) + rd
}

fn insn_orr_reg(rd, rn, rm) {
    return 2852126720 + (rm * 65536) + (rn * 32) + rd
}

fn insn_eor_reg(rd, rn, rm) {
    return 3388997632 + (rm * 65536) + (rn * 32) + rd
}

fn insn_lslv(rd, rn, rm) {
    return 2596282368 + (rm * 65536) + (rn * 32) + rd
}

fn insn_lsrv(rd, rn, rm) {
    return 2596283392 + (rm * 65536) + (rn * 32) + rd
}

fn insn_cmp_reg(rn, rm) {
    return 3942645791 + (rm * 65536) + (rn * 32)
}

fn insn_cset(rd, cond) {
    // Alias for CSINC Xd, XZR, XZR, invert(cond)
    return 2594113504 + ((cond ^ 1) * 4096) + rd
}

fn insn_b(off) {
    if off < 0 {
        off = off + 67108864 // 2^26
    }
    return 335544320 + off
}

fn insn_b_cond(off, cond) {
    if off < 0 {
        off = off + 524288 // 2^19
    }
    return 1409286144 + (off * 32) + cond
}

fn insn_bl(off) {
    if off < 0 {
        off = off + 67108864
    }
    return 2483027968 + off
}

fn insn_sub_sp(imm) {
    return 3506439167 + (imm * 1024)
}

fn insn_sub_reg(rd, rn, rm) {
    return 3405774848 + (rm * 65536) + (rn * 32) + rd
}

fn insn_stp_pre() {
    return 2847898621
}

fn insn_ldp_post() {
    return 2831252477
}

fn insn_mov_fp_sp() {
    return 2432697341
}

fn insn_mov_sp_fp() {
    return 2432697279
}

fn insn_str_reg_pre(i) {
    return 4162752480 + i
}

fn insn_str_reg_sp(reg, offset) {
    return 4177527776 + ((offset / 8) * 1024) + reg
}

fn insn_dup_2d(vd, rn) {
    return 1309147136 + (rn * 32) + vd
}

fn insn_add_2d(vd, vn, vm) {
    return 1310753792 + (vm * 65536) + (vn * 32) + vd
}

fn insn_sub_2d(vd, vn, vm) {
    return 1847624704 + (vm * 65536) + (vn * 32) + vd
}

fn insn_and_16b(vd, vn, vm) {
    return 1310727168 + (vm * 65536) + (vn * 32) + vd
}

fn insn_orr_16b(vd, vn, vm) {
    return 1319115776 + (vm * 65536) + (vn * 32) + vd
}

fn insn_eor_16b(vd, vn, vm) {
    return 1847598080 + (vm * 65536) + (vn * 32) + vd
}

fn insn_umov_d0(rd, vn) {
    return 1309162496 + (vn * 32) + rd
}

fn insn_fmov_d_x(rd, rn) {
    // FMOV Dd, Xn (Move general-purpose register to SIMD/FP register)
    // Opcode: 0x9E670000 = 2657550336
    return 2657550336 + (rn * 32) + rd
}

fn insn_umov_x_d(rd, rn) {
    // UMOV Xd, Vn.D[0] (Move SIMD/FP register to general-purpose register)
    // Opcode: 0x4E083C00 = 1309162496
    return 1309162496 + (rn * 32) + rd
}

fn insn_fadd(rd, rn, rm) {
    // FADD Dd, Dn, Dm: 0x1E602800 = 509618176
    return 509618176 + (rm * 65536) + (rn * 32) + rd
}

fn insn_fcmp(rn, rm) {
    // FCMP Dn, Dm: 0x1E602000 = 509616128
    return 509616128 + (rm * 65536) + (rn * 32)
}

fn insn_fsub(rd, rn, rm) {
    // FSUB Dd, Dn, Dm: 0x1E603800 = 509622272
    return 509622272 + (rm * 65536) + (rn * 32) + rd
}

fn insn_fmul(rd, rn, rm) {
    // FMUL Dd, Dn, Dm: 0x1E600800 = 509609984
    return 509609984 + (rm * 65536) + (rn * 32) + rd
}

fn insn_fdiv(rd, rn, rm) {
    // FDIV Dd, Dn, Dm: 0x1E601800 = 509614080
    return 509614080 + (rm * 65536) + (rn * 32) + rd
}

fn insn_scvtf(rd, rn) {
    // SCVTF Dd, Xn: 0x9E620000 = 2657189888
    return 2657189888 + (rn * 32) + rd
}

fn insn_fcvtzs(rd, rn) {
    // FCVTZS Xd, Dn: 0x9E780000 = 2658631680
    return 2658631680 + (rn * 32) + rd
}

fn insn_mul_4s(vd, vn, vm) {
    return 1319148544 + (vm * 65536) + (vn * 32) + vd
}

fn insn_ldr_ptr(rd, rn) {
    return 4181721088 + (rn * 32) + rd
}

fn insn_str_ptr(rd, rn) {
    return 4177526784 + (rn * 32) + rd
}

fn insn_strb(rt, rn) {
    // STRB Wt, [Xn] with imm = 0 (unsigned offset encoding)
    return 956301312 + (rn * 32) + rt
}

fn insn_add_imm(rd, rn, imm) {
    return 2432696320 + (imm * 1024) + (rn * 32) + rd
}

fn insn_ldadd(rs, rt, rn) {
    return 4162846720 + (rs * 65536) + (rn * 32) + rt
}

fn insn_cas(rs, rt, rn) {
    return 3365993472 + (rs * 65536) + (rn * 32) + rt
}

fn insn_ldrb(rt, rn) {
    return 960495616 + (rn * 32) + rt
}

fn insn_mul(rd, rn, rm) {
    return 2600467456 + (rm * 65536) + (32 * 1024) + (rn * 32) + rd
}

fn insn_udiv(rd, rn, rm) {
    // UDIV Xrd, Xrn, Xrm
    return 2596276224 + (rm * 65536) + (rn * 32) + rd // base 0x9AC00800
}

fn insn_movk(reg, imm16, shift_idx) {
    return 4068474880 + (shift_idx * 2097152) + (imm16 * 32) + reg
}

fn insn_adr(reg, imm) {
    if imm < 0 {
        imm = imm + 2097152 // 2^21
    }
    var lo = imm & 3
    var hi = imm / 4
    return 268435456 + (lo * 536870912) + (hi * 32) + reg
}

// --- Renaming & Linking Helpers ---

fn collect_toplevel_rename_pairs(prog, prefix) {
    var pairs = {}
    var i = 0
    var stmts = prog["statements"]
    while i < oren_list_len(stmts) {
        var stmt = stmts[i]
        if stmt["type"] == "Var" {
            var name = stmt["name"]["value"]
            pairs[name] = prefix + name
        }
        if stmt["type"] == "Function" {
            var name = stmt["name"]
            pairs[name] = prefix + name
        }
        if stmt["type"] == "ExprStmt" {
            if stmt["expr"]["type"] == "Function" {
                var name = stmt["expr"]["name"]
                if name != "" { pairs[name] = prefix + name }
            }
        }
        if stmt["type"] == "Type" {
            var name = stmt["name"]["value"]
            pairs[name] = prefix + name
        }
        i = i + 1
    }
    return pairs
}

fn rename_lookup(pairs, name) {
    if pairs[name] != nil { return pairs[name] }
    return ""
}

fn scope_has(stack, name) {
    var i = oren_list_len(stack) - 1
    while i >= 0 {
        if stack[i][name] == true { return true }
        i = i - 1
    }
    return false
}

fn scope_declare(stack, name) {
    var n = oren_list_len(stack)
    if n == 0 { return nil }
    stack[n - 1][name] = true
    return nil
}

fn scope_push(stack) {
    var next = []
    var i = 0
    while i < oren_list_len(stack) {
        oren_list_push(next, stack[i])
        i = i + 1
    }
    oren_list_push(next, {})
    return next
}

fn rename_program_in_place(prog, pairs) {
    var stmts = prog["statements"]
    var stack = []
    var i = 0
    while i < oren_list_len(stmts) {
        rename_stmt(stmts[i], pairs, stack, true)
        i = i + 1
    }
}

fn rename_stmt(stmt, pairs, stack, at_top_level) {
    if stmt == nil { return nil }
    if stmt["type"] == "Import" { return nil }
    if stmt["type"] == "Var" {
        var name = stmt["name"]["value"]
        if at_top_level {
            var new_name = rename_lookup(pairs, name)
            if new_name != "" { stmt["name"]["value"] = new_name }
        } else {
            scope_declare(stack, name)
        }
        rename_expr(stmt["value"], pairs, stack)
        return nil
    }
    if stmt["type"] == "Assign" {
        if stmt["name"] != nil {
            var target = stmt["name"]["value"]
            var new_name2 = rename_lookup(pairs, target)
            if new_name2 != "" && !scope_has(stack, target) {
                stmt["name"]["value"] = new_name2
            }
        }
        rename_expr(stmt["value"], pairs, stack)
        return nil
    }
    if stmt["type"] == "Set" {
        rename_expr(stmt["left"], pairs, stack)
        rename_expr(stmt["value"], pairs, stack)
        return nil
    }
    if stmt["type"] == "Return" {
        rename_expr(stmt["value"], pairs, stack)
        return nil
    }
    if stmt["type"] == "Function" {
        if at_top_level {
            var new_name3 = rename_lookup(pairs, stmt["name"])
            if new_name3 != "" { stmt["name"] = new_name3 }
        } else {
            if stmt["name"] != "" { scope_declare(stack, stmt["name"]) }
        }
        var next = scope_push(stack)
        var i = 0
        while i < oren_list_len(stmt["params"]) {
            scope_declare(next, stmt["params"][i]["value"])
            i = i + 1
        }
        rename_stmt(stmt["body"], pairs, next, false)
        return nil
    }
    if stmt["type"] == "Block" {
        var next2 = scope_push(stack)
        var stmts = stmt["stmts"]
        var i2 = 0
        while i2 < oren_list_len(stmts) {
            rename_stmt(stmts[i2], pairs, next2, false)
            i2 = i2 + 1
        }
        return nil
    }
    if stmt["type"] == "ExprStmt" {
        if stmt["expr"] != nil {
            if at_top_level && stmt["expr"]["type"] == "Function" {
                if stmt["expr"]["name"] != "" {
                    var new_name4 = rename_lookup(pairs, stmt["expr"]["name"])
                    if new_name4 != "" { stmt["expr"]["name"] = new_name4 }
                }
            }
            rename_expr(stmt["expr"], pairs, stack)
        }
        return nil
    }
    if stmt["type"] == "If" {
        rename_expr(stmt["cond"], pairs, stack)
        rename_stmt(stmt["consq"], pairs, stack, false)
        rename_stmt(stmt["alt"], pairs, stack, false)
        return nil
    }
    if stmt["type"] == "While" {
        rename_expr(stmt["cond"], pairs, stack)
        rename_stmt(stmt["body"], pairs, stack, false)
        return nil
    }
    if stmt["type"] == "For" {
        var next3 = scope_push(stack)
        rename_stmt(stmt["init"], pairs, next3, false)
        rename_expr(stmt["cond"], pairs, next3)
        rename_stmt(stmt["post"], pairs, next3, false)
        rename_stmt(stmt["body"], pairs, next3, false)
        return nil
    }
    if stmt["type"] == "Type" {
        if at_top_level {
            var new_name5 = rename_lookup(pairs, stmt["name"]["value"])
            if new_name5 != "" { stmt["name"]["value"] = new_name5 }
        }
        return nil
    }
    return nil
}

fn rename_expr(expr, pairs, stack) {
    if expr == nil { return nil }
    if expr["type"] == "Identifier" {
        if scope_has(stack, expr["value"]) { return nil }
        var new_name = rename_lookup(pairs, expr["value"])
        if new_name != "" { expr["value"] = new_name }
        return nil
    }
    if expr["type"] == "Function" {
        if expr["name"] != "" {
            var new_name_fn = rename_lookup(pairs, expr["name"])
            if new_name_fn != "" { expr["name"] = new_name_fn }
        }
        var next = scope_push(stack)
        var i = 0
        while i < oren_list_len(expr["params"]) {
            scope_declare(next, expr["params"][i]["value"])
            i = i + 1
        }
        rename_stmt(expr["body"], pairs, next, false)
        return nil
    }
    if expr["type"] == "Call" {
        rename_expr(expr["fn"], pairs, stack)
        var args = expr["args"]
        var i = 0
        while i < oren_list_len(args) {
            rename_expr(args[i], pairs, stack)
            i = i + 1
        }
        return nil
    }
    if expr["type"] == "Infix" {
        rename_expr(expr["left"], pairs, stack)
        rename_expr(expr["right"], pairs, stack)
        return nil
    }
    if expr["type"] == "Prefix" {
        rename_expr(expr["right"], pairs, stack)
        return nil
    }
    if expr["type"] == "Hash" {
        var pairs_list = expr["pairs"]
        var i = 0
        while i < oren_list_len(pairs_list) {
            rename_expr(pairs_list[i]["value"], pairs, stack)
            // Keys usually strings, skip
            i = i + 1
        }
        return nil
    }
    if expr["type"] == "Member" {
        rename_expr(expr["left"], pairs, stack)
        return nil
    }
    if expr["type"] == "Index" {
        rename_expr(expr["left"], pairs, stack)
        rename_expr(expr["index"], pairs, stack)
        return nil
    }
    if expr["type"] == "Array" {
        var elements = expr["elements"]
        var i = 0
        while i < oren_list_len(elements) {
            rename_expr(elements[i], pairs, stack)
            i = i + 1
        }
        return nil
    }
    if expr["type"] == "If" {
        rename_expr(expr["cond"], pairs, stack)
        rename_stmt(expr["consq"], pairs, stack, false)
        rename_stmt(expr["alt"], pairs, stack, false)
        return nil
    }
}

// --- Native Compiler ---

fn native_compile_expr(ctx, expr) {
    if expr == nil {
        print("native backend: expr is nil")
        oren_exit(1)
    }
    
    if expr["type"] == "String" {
        var s = expr["value"]
        var bytes = oren_bytes_from_string(s)
        bytes_push(bytes, 0) // Null terminator
        
        while int_mod(oren_list_len(ctx["data"]), 8) != 0 {
            bytes_push(ctx["data"], 0)
        }
        
        var data_off = oren_list_len(ctx["data"])
        bytes_extend(ctx["data"], bytes)
        
        var adr_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off})
        
        push_u32_le(ctx["code"], insn_movz(1, 1))
        var bl_ensure = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_ensure, "name": "oren_ensure_tracked"})
        return nil
    }
    if expr["type"] == "SpawnExpr" {
        // Syscall-first spawn (macOS-first, rolling):
        // - No libpthread dependency (no bsdthread_register/bsdthread_create).
        // - Uses fork+pipe (process-based) for v0 correctness on modern macOS.
        //
        // Spawn returns an opaque handle pointer for `oren_join(handle)`.
        // Handle layout (bytes, u64 slots):
        // 0: pid (u64)
        // 8: read_fd (u64)

        // 1) Compile arguments and build list
        var call = expr["call"]
        var args = call["args"]
        var nargs = oren_list_len(args)

        push_u32_le(ctx["code"], insn_movz(0, 0))
        var bl_new_list = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list, "name": "oren_new_list"})

        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16

        var i_arg = 0
        while i_arg < nargs {
            native_compile_expr(ctx, args[i_arg])
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 16))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            var bl_push = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push, "name": "oren_list_push"})

            i_arg = i_arg + 1
        }

        // 2) Emit wrapper(list): unpack args and call target, then jump over it.
        var jump_skip_code = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // B after_wrapper_code

        var wrapper_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], insn_stp_pre())
        push_u32_le(ctx["code"], insn_mov_fp_sp())
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))

        var frame_size = align_up(nargs * 8, 16)
        if frame_size > 0 { push_u32_le(ctx["code"], insn_sub_sp(frame_size)) }

        var j_arg = 0
        while j_arg < nargs {
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, frame_size))
            push_u32_le(ctx["code"], insn_movz(1, j_arg))
            var bl_get = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_get, "name": "oren_list_get"})
            push_u32_le(ctx["code"], insn_str_reg_sp(0, j_arg * 8))
            j_arg = j_arg + 1
        }

        j_arg = 0
        while j_arg < nargs {
            push_u32_le(ctx["code"], insn_ldr_reg_sp(j_arg, j_arg * 8))
            j_arg = j_arg + 1
        }

        var fn_name = call["fn"]["value"]
        var bl_target = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_target, "name": fn_name})

        if frame_size > 0 { push_u32_le(ctx["code"], insn_add_sp(frame_size)) }
        push_u32_le(ctx["code"], insn_add_sp(16))
        push_u32_le(ctx["code"], insn_mov_sp_fp())
        push_u32_le(ctx["code"], insn_ldp_post())
        push_u32_le(ctx["code"], insn_ret())

        var after_wrapper_code = oren_list_len(ctx["code"])
        set_u32_le(ctx["code"], jump_skip_code, insn_b((after_wrapper_code - jump_skip_code) / 4))

        // 3) pipe() -> rfd/wfd
        // macOS syscall stub ABI returns fds in X0/X1 on success.
        // We also store them into a small buffer so later code can reload safely.
        var pipebuf_call = {"type": "Call", "fn": {"type": "Identifier", "value": "malloc_raw"}, "args": [{"type": "Integer", "value": "16"}]}
        native_compile_expr(ctx, pipebuf_call) // X0 = pipe_buf
        push_u32_le(ctx["code"], insn_mov_reg(22, 0)) // X22 = pipe_buf

        // pipe(pipe_buf)
        push_u32_le(ctx["code"], insn_mov_reg(0, 22))
        push_u32_le(ctx["code"], insn_movz(16, 42))
        push_u32_le(ctx["code"], insn_svc(128))
        var pipe_ok_br = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // B.CC ok
        push_u32_le(ctx["code"], insn_movz(16, 1)) // exit(errno)
        push_u32_le(ctx["code"], insn_svc(128))
        var pipe_ok_pos = oren_list_len(ctx["code"])
        set_u32_le(ctx["code"], pipe_ok_br, insn_b_cond((pipe_ok_pos - pipe_ok_br) / 4, 3)) // CC

        // Save fds to pipe_buf as u64 slots: [0]=rfd, [8]=wfd
        push_u32_le(ctx["code"], insn_str_ptr(0, 22))
        push_u32_le(ctx["code"], insn_add_imm(3, 22, 8))
        push_u32_le(ctx["code"], insn_str_ptr(1, 3))

        // Reload into X19/X20
        push_u32_le(ctx["code"], insn_ldr_ptr(19, 22)) // X19 = rfd
        push_u32_le(ctx["code"], insn_ldr_ptr(20, 3))  // X20 = wfd

        // fork() (Darwin ABI: X0=child_pid in both parent/child; X1=0 parent, 1 child)
        push_u32_le(ctx["code"], insn_movz(16, 2))
        push_u32_le(ctx["code"], insn_svc(128))
        var fork_ok_br = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // B.CC ok
        push_u32_le(ctx["code"], insn_movz(16, 1))
        push_u32_le(ctx["code"], insn_svc(128))
        var fork_ok_pos = oren_list_len(ctx["code"])
        set_u32_le(ctx["code"], fork_ok_br, insn_b_cond((fork_ok_pos - fork_ok_br) / 4, 3)) // CC

        push_u32_le(ctx["code"], insn_mov_reg(21, 0)) // X21 = child_pid (both parent and child)
        // Parent if X1 == 0; child if X1 != 0
        push_u32_le(ctx["code"], insn_cmp_reg(1, 31))
        var br_parent = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0) // B.EQ parent

        // --- Child ---
        // close(rfd)
        push_u32_le(ctx["code"], insn_mov_reg(0, 19))
        push_u32_le(ctx["code"], insn_movz(16, 6))
        push_u32_le(ctx["code"], insn_svc(128))

        // Call wrapper(args_list) -> X0=result
        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
        var bl_wrap_child = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)

        // write(wfd, &result, 8)
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        push_u32_le(ctx["code"], insn_mov_reg(0, 20))
        push_u32_le(ctx["code"], insn_add_imm(1, 31, 0))
        push_u32_le(ctx["code"], insn_movz(2, 8))
        push_u32_le(ctx["code"], insn_movz(16, 4))
        push_u32_le(ctx["code"], insn_svc(128))
        push_u32_le(ctx["code"], insn_add_sp(16))

        // close(wfd)
        push_u32_le(ctx["code"], insn_mov_reg(0, 20))
        push_u32_le(ctx["code"], insn_movz(16, 6))
        push_u32_le(ctx["code"], insn_svc(128))

        // exit(0)
        push_u32_le(ctx["code"], insn_movz(0, 0))
        push_u32_le(ctx["code"], insn_movz(16, 1))
        push_u32_le(ctx["code"], insn_svc(128))

        // --- Parent ---
        var parent_pos = oren_list_len(ctx["code"])
        set_u32_le(ctx["code"], br_parent, insn_b_cond((parent_pos - br_parent) / 4, 0)) // EQ

        // close(wfd)
        push_u32_le(ctx["code"], insn_mov_reg(0, 20))
        push_u32_le(ctx["code"], insn_movz(16, 6))
        push_u32_le(ctx["code"], insn_svc(128))

        // Allocate handle = malloc_raw(24)
        var malloc_call = {"type": "Call", "fn": {"type": "Identifier", "value": "malloc_raw"}, "args": [{"type": "Integer", "value": "24"}]}
        native_compile_expr(ctx, malloc_call)
        push_u32_le(ctx["code"], insn_mov_reg(18, 0))

        // handle[0]=pid, handle[8]=rfd
        push_u32_le(ctx["code"], insn_mov_reg(2, 21))
        push_u32_le(ctx["code"], insn_str_ptr(2, 18))
        push_u32_le(ctx["code"], insn_add_imm(3, 18, 8))
        push_u32_le(ctx["code"], insn_mov_reg(2, 19))
        push_u32_le(ctx["code"], insn_str_ptr(2, 3))

        // Return handle
        push_u32_le(ctx["code"], insn_mov_reg(0, 18))

        // Patch wrapper call in child
        set_u32_le(ctx["code"], bl_wrap_child, insn_bl((wrapper_pos - bl_wrap_child) / 4))

        // Pop args list pointer
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16

        return nil
    }

    if expr["type"] == "Array" {
        var elements = expr["elements"]
        var count = oren_list_len(elements)
        
        // Build runtime list: call oren_new_list(0) then push elements (runtime grows as needed)
        push_u32_le(ctx["code"], insn_movz(0, 0))
        var bl_pos_list = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_list, "name": "oren_new_list"})
        
        // Stack: list in X0, push to preserve across pushes
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16
        
        var i_arr = 0
        while i_arr < count {
            native_compile_expr(ctx, elements[i_arr]) // -> X0 (value)
            // save value on stack
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            // load list -> X0
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 16)) // list is 16 bytes above current SP after push
            // load value -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            // pop value slot
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // Call oren_list_push(list, elem)
            var bl_pos_push = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_push, "name": "oren_list_push"})
            i_arr = i_arr + 1
        }
        
        // Pop list back to X0 as result
        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16
        return nil
    }

    if expr["type"] == "Index" {
        native_compile_expr(ctx, expr["left"]) // container -> X0
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16
        
        native_compile_expr(ctx, expr["index"]) // index -> X0
        
        // Pop container -> X1
        push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16
        
        // Swap: X0=index, X1=container -> X0=container, X1=index
        push_u32_le(ctx["code"], insn_mov_reg(2, 0)) // index -> X2
        push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // container -> X0
        push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // index -> X1
        
        var bl_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_list_get"})
        return nil
    }

    if expr["type"] == "Float" {
        var val = oren_string_to_float_bits(expr["value"])
        
        // Load 64-bit value using MOVZ/MOVK sequence
        // We use bitwise ops to handle potential sign bit correctly
        var chunk0 = val & 65535
        push_u32_le(ctx["code"], insn_movz(0, chunk0))
        
        var chunk1 = (val >> 16) & 65535
        if chunk1 != 0 || (val >> 32) != 0 {
            push_u32_le(ctx["code"], insn_movk(0, chunk1, 1))
        }
        
        var chunk2 = (val >> 32) & 65535
        if chunk2 != 0 || (val >> 48) != 0 {
            push_u32_le(ctx["code"], insn_movk(0, chunk2, 2))
        }
        
        var chunk3 = (val >> 48) & 65535
        if chunk3 != 0 {
            push_u32_le(ctx["code"], insn_movk(0, chunk3, 3))
        }
        return nil
    }

    if expr["type"] == "Boolean" {
        if expr["value"] == true {
            push_u32_le(ctx["code"], insn_movz(0, 1))
        } else {
            push_u32_le(ctx["code"], insn_movz(0, 0))
        }
        return nil
    }

    if expr["type"] == "Nil" {
        // Rolling native v0: represent nil as 0 (falsey).
        push_u32_le(ctx["code"], insn_movz(0, 0))
        return nil
    }

    if expr["type"] == "Integer" {
        var val = int_from_string(expr["value"])
        if val < 65536 {
            push_u32_le(ctx["code"], insn_movz(0, val))
        } else {
            // MOVZ low 16
            var low = int_mod(val, 65536)
            push_u32_le(ctx["code"], insn_movz(0, low))
            
            // MOVK high 16
            var high = val / 65536
            if high > 0 {
                var high16 = int_mod(high, 65536)
                push_u32_le(ctx["code"], insn_movk(0, high16, 1)) // 1 = LSL 16
                
                var higher = high / 65536
                if higher > 0 {
                    var higher16 = int_mod(higher, 65536)
                    push_u32_le(ctx["code"], insn_movk(0, higher16, 2)) // 2 = LSL 32
                    
                    // Even higher?
                    var highest = higher / 65536
                    if highest > 0 {
                        push_u32_le(ctx["code"], insn_movk(0, highest, 3)) // 3 = LSL 48
                    }
                }
            }
        }
        return nil
    }
    if expr["type"] == "Identifier" {
        var name = expr["value"]
        
        // Check locals
        var off = ctx["locals"][name]
        if off != nil {
            var current_sp_off = ctx["stack_size"] - off - 16
            push_u32_le(ctx["code"], insn_ldr_x0_sp(current_sp_off))
            return nil
        }

        // Check globals
        var global_off = ctx["globals"][name]
        if global_off != nil {
            var adr_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": global_off})
            // X0 has address. LDR X0, [X0]
            push_u32_le(ctx["code"], insn_ldr_ptr(0, 0))
            return nil
        }
        
        // Check aliases (imported modules)
        if ctx["aliases"][name] != nil {
            print("native backend: cannot use module '" + name + "' as value")
            return nil
        }
        
        print("native backend: undefined variable " + name)
        return nil
    }
    if expr["type"] == "Prefix" {
        if expr["op"] == "-" {
            native_compile_expr(ctx, expr["right"])
            push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0)) // SUB X0, XZR, X0
            return nil
        }
        if expr["op"] == "!" {
            // Logical not: treat 0 as false, non-zero as true.
            native_compile_expr(ctx, expr["right"])
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            push_u32_le(ctx["code"], insn_cset(0, 0)) // EQ
            return nil
        }
        if expr["op"] == "~" {
            // Bitwise not: x ^ -1
            native_compile_expr(ctx, expr["right"])
            push_u32_le(ctx["code"], insn_movn(1, 0)) // X1 = -1
            push_u32_le(ctx["code"], insn_eor_reg(0, 0, 1))
            return nil
        }
        print("native backend: unsupported prefix " + expr["op"])
        return nil
    }

    if expr["type"] == "Infix" {
        var op = expr["op"]
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
            // Compile Left
            native_compile_expr(ctx, expr["left"])
            
            // Push Left
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            // Compile Right
            native_compile_expr(ctx, expr["right"])
            
            // Pop Left -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            if op == "+" { 
                // Swap X0/X1 so X0=Left, X1=Right for oren_add call
                push_u32_le(ctx["code"], insn_mov_reg(2, 0)) // Right -> X2
                push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // Left -> X0
                push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // Right -> X1
                
                var bl_pos = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_add"})
            }
            if op == "-" { push_u32_le(ctx["code"], insn_sub_reg(0, 1, 0)) }
            if op == "*" { push_u32_le(ctx["code"], insn_mul(0, 1, 0)) }
            if op == "/" { push_u32_le(ctx["code"], insn_udiv(0, 1, 0)) }
            if op == "&" { push_u32_le(ctx["code"], insn_and_reg(0, 1, 0)) }
            if op == "|" { push_u32_le(ctx["code"], insn_orr_reg(0, 1, 0)) }
            if op == "^" { push_u32_le(ctx["code"], insn_eor_reg(0, 1, 0)) }
            if op == "<<" { push_u32_le(ctx["code"], insn_lslv(0, 1, 0)) }
            if op == ">>" { push_u32_le(ctx["code"], insn_lsrv(0, 1, 0)) }
            return nil
        }
        
        var is_cmp = false
        var cond_code = 0
        if op == "==" { is_cmp = true; cond_code = 0 } // EQ
        if op == "!=" { is_cmp = true; cond_code = 1 } // NE
        if op == "<"  { is_cmp = true; cond_code = 11 } // LT
        if op == ">"  { is_cmp = true; cond_code = 12 } // GT
        if op == "<=" { is_cmp = true; cond_code = 13 } // LE
        if op == ">=" { is_cmp = true; cond_code = 10 } // GE
        
        if is_cmp {
             // Compile Left
            native_compile_expr(ctx, expr["left"])
            
            // Push Left
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            // Compile Right
            native_compile_expr(ctx, expr["right"])
            
            // Pop Left -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // CMP X1, X0
            push_u32_le(ctx["code"], insn_cmp_reg(1, 0))
            
            // CSET X0, cond
            push_u32_le(ctx["code"], insn_cset(0, cond_code))
            return nil
        }
        
        if op == "&&" || op == "||" {
            // Short-circuit boolean ops (0 is false, non-zero is true), result is 0/1.
            //
            // &&:
            //   if left == 0 -> 0
            //   else -> (right != 0)
            //
            // ||:
            //   if left != 0 -> 1
            //   else -> (right != 0)

            native_compile_expr(ctx, expr["left"])
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))

            if op == "&&" {
                var jump_false_pos = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.EQ false

                native_compile_expr(ctx, expr["right"])
                push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
                push_u32_le(ctx["code"], insn_cset(0, 1)) // NE

                var jump_end_pos = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B end

                var false_target = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], insn_movz(0, 0))

                var end_target = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], jump_false_pos, insn_b_cond((false_target - jump_false_pos) / 4, 0)) // EQ
                set_u32_le(ctx["code"], jump_end_pos, insn_b((end_target - jump_end_pos) / 4))
                return nil
            } else {
                var jump_true_pos = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.NE true

                native_compile_expr(ctx, expr["right"])
                push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
                push_u32_le(ctx["code"], insn_cset(0, 1)) // NE

                var jump_end_pos2 = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B end

                var true_target = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], insn_movz(0, 1))

                var end_target2 = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], jump_true_pos, insn_b_cond((true_target - jump_true_pos) / 4, 1)) // NE
                set_u32_le(ctx["code"], jump_end_pos2, insn_b((end_target2 - jump_end_pos2) / 4))
                return nil
            }
        }
        
        print("native backend: unsupported operator " + op)
        return nil
    }
    
    if expr["type"] == "Hash" {
        // Hash literal { k: v, ... } -> oren_new_map(count) -> oren_map_set...
        var pairs = expr["pairs"]
        var count = oren_list_len(pairs)
        
        // oren_new_map(count) -> X0
        // We manually construct call logic for oren_new_map
        push_u32_le(ctx["code"], insn_movz(0, count)) // Arg 0 = count
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16
        
        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16
        
        var bl_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_new_map"})
        
        // X0 has map. Push it.
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16
        
        var i = 0
        while i < count {
            var k = pairs[i]["key"]
            var v = pairs[i]["value"]
            
            // Push k
            native_compile_expr(ctx, k)
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            // Push v
            native_compile_expr(ctx, v)
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            // Pop v -> X2
            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // Pop k -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // Peek m -> X0
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            
            // oren_map_set(X0, X1, X2)
            var bl_pos2 = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos2, "name": "oren_map_set"})
            
            i = i + 1
        }
        
        // Pop m -> X0
        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16
        
        return nil
    }
    
    if expr["type"] == "Member" {
        var prop_name = expr["prop"]["value"]
        var off_idx = ctx["field_offsets"][prop_name]
        if off_idx != nil {
            native_compile_expr(ctx, expr["left"]) // obj ptr in X0
            if off_idx > 0 {
                var byte_off = off_idx * 8
                push_u32_le(ctx["code"], insn_add_imm(1, 0, byte_off))
                push_u32_le(ctx["code"], insn_ldr_ptr(0, 1))
            } else {
                push_u32_le(ctx["code"], insn_ldr_ptr(0, 0))
            }
            return nil
        }
        
        // Fallback: a.x -> oren_map_get(a, "x")
        native_compile_expr(ctx, expr["left"]) // a -> X0
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16
        
        var bytes = oren_bytes_from_string(prop_name)
        bytes_push(bytes, 0)
        var data_off = oren_list_len(ctx["data"])
        bytes_extend(ctx["data"], bytes)
        var adr_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off})
        
        // Push key -> stack
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16
        
        // Pop key -> X1
