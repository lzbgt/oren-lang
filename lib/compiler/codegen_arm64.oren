                svc_imm = 0
                sys_reg = 8
                is_macos = false
            }
            push_u32_le(ctx["code"], insn_movz(sys_reg, sys_write))
            push_u32_le(ctx["code"], insn_svc(svc_imm))
            if is_macos {
