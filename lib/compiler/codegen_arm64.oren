            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // Pop wqthread -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // Pop threadstart -> X0
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            if ctx["platform"]["os"] == "linux" {
                push_u32_le(ctx["code"], insn_movn(0, 0))
                return nil
            }

            push_u32_le(ctx["code"], insn_movz(16, 366))
            push_u32_le(ctx["code"], insn_svc(128))

            // Normalize macOS syscall error (carry set, X0=errno) to X0=-errno (so callers can debug).
            var br_ok = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // B.CC ok
            push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0)) // X0 = 0 - X0 = -errno
            var ok_pos = oren_list_len(ctx["code"])
            set_u32_le(ctx["code"], br_ok, insn_b_cond((ok_pos - br_ok) / 4, 3)) // CC
            return nil
        }
        
        if fn_name == "sys_pipe" {
            native_compile_expr(ctx, args[0]) // ptr to int[2] -> X0
            
            var sys_pipe = 42
            var sys_pipe2 = 293
            var sys_reg = 16
            var svc_imm = 128
            var is_macos = true
            if ctx["platform"]["os"] == "linux" {
                sys_pipe = sys_pipe2
                sys_reg = 8
                svc_imm = 0
                is_macos = false
            }
            
            if is_macos {
                // Save ptr (X0) to stack
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                push_u32_le(ctx["code"], insn_movz(sys_reg, sys_pipe))
                push_u32_le(ctx["code"], insn_svc(svc_imm))
                
                // Restore ptr -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                // Store X0 -> [X2]
                push_u32_le(ctx["code"], insn_str_ptr(0, 2))
                // Store X1 -> [X2 + 8]
                push_u32_le(ctx["code"], insn_add_imm(2, 2, 8))
                push_u32_le(ctx["code"], insn_str_ptr(1, 2))
                
                push_u32_le(ctx["code"], insn_movz(0, 0)) // Return 0
            } else {
                // Linux pipe2(ptr, flags)
                // ptr in X0.
                push_u32_le(ctx["code"], insn_movz(1, 0)) // flags = 0
                push_u32_le(ctx["code"], insn_movz(sys_reg, sys_pipe))
                push_u32_le(ctx["code"], insn_svc(svc_imm))
            }
            return nil
        }
        
        if fn_name == "sys_clone" {
            native_compile_expr(ctx, args[0]) // flags -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            native_compile_expr(ctx, args[1]) // stack -> X0
            
            // Pop flags -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // Syscall expects: X0=flags, X1=stack.
            // We have X0=stack, X1=flags. Swap.
            push_u32_le(ctx["code"], insn_mov_reg(2, 0)) // X2 = stack
            push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // X0 = flags
            push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // X1 = stack
            
            // Clear other args
            push_u32_le(ctx["code"], insn_movz(2, 0))
            push_u32_le(ctx["code"], insn_movz(3, 0))
            push_u32_le(ctx["code"], insn_movz(4, 0))
            
            if ctx["platform"]["os"] == "linux" {
                push_u32_le(ctx["code"], insn_movz(8, 220)) // sys_clone
                push_u32_le(ctx["code"], insn_svc(0))
            } else {
                push_u32_le(ctx["code"], insn_movn(0, 0)) // -1
            }
            return nil
        }
        
        if fn_name == "ptr_set" {
            native_compile_expr(ctx, args[0]) // ptr -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            native_compile_expr(ctx, args[1]) // val -> X0
            
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0)) // ptr -> X1
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // STR X0, [X1] (val -> [ptr])
            push_u32_le(ctx["code"], insn_str_ptr(0, 1))
            return nil
        }
        
        if fn_name == "atomic_add" {
            native_compile_expr(ctx, args[0]) // ptr -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            native_compile_expr(ctx, args[1]) // val -> X0
            
            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0)) // ptr -> X2
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // LDADD X0 (val), X0 (result), [X2]
            // We want val in a register, result in X0.
            // Current X0 is val.
            // Move val to X1.
            push_u32_le(ctx["code"], insn_add_imm(1, 0, 0))
            
            // LDADD X1, X0, [X2]
            push_u32_le(ctx["code"], insn_ldadd(1, 0, 2))
            return nil
        }
        
        if fn_name == "sys_gettid" {
            var sys_reg = 16
            var svc_imm = 128
            var sys_num = 372
            var is_macos = true
            if ctx["platform"]["os"] == "linux" {
                sys_reg = 8
                svc_imm = 0
                sys_num = 178
                is_macos = false
            }
            push_u32_le(ctx["code"], insn_movz(sys_reg, sys_num))
            if is_macos {
                push_u32_le(ctx["code"], insn_movk(sys_reg, 512, 1))
            }
            push_u32_le(ctx["code"], insn_svc(svc_imm))
            return nil
        }
        
        if fn_name == "atomic_cas" {
            // atomic_cas(ptr, expected, new)
            native_compile_expr(ctx, args[0]) // ptr
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            native_compile_expr(ctx, args[1]) // expected
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            native_compile_expr(ctx, args[2]) // new -> X0
            
            // Pop expected -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // Pop ptr -> X2
            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // CAS X1 (expected), X0 (new), [X2]
            // CAS Xs, Xt, [Xn] : reads [Xn], compares with Xs. if eq, write Xt.
            // Old value loaded to Xs.
            // We need result in X0.
            // CAS X1, X0, [X2] updates X1 with old value.
            // We want boolean success? Or just old value?
            // Usually returns old value.
            
            push_u32_le(ctx["code"], insn_cas(1, 0, 2))
            
            // Result in X1. Move to X0.
            push_u32_le(ctx["code"], insn_add_imm(0, 1, 0))
            return nil
        }
        
        var nargs = oren_list_len(args)
        
        // Push args
        while i < nargs {
            native_compile_expr(ctx, args[i])
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            i = i + 1
        }
        
        // Pop into registers (reverse order)
        var j = nargs - 1
        while j >= 0 {
            push_u32_le(ctx["code"], insn_ldr_reg_sp(j, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            j = j - 1
        }
        
        // BL
        var bl_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": fn_name})
        
        return nil
    }

    print("native backend: unsupported expr " + expr["type"])
    return nil
}

fn native_compile_stmt(ctx, stmt) {
    if stmt["type"] == "Spawn" {
        // Delegate to expression compilation, ignore result (X0)
        var expr = {"type": "SpawnExpr", "call": stmt["call"]}
        native_compile_expr(ctx, expr)
        return nil
    }
    if stmt["type"] == "Break" {
        var loop = ctx["loop_ctx"]
        if loop == nil {
            print("native backend: break outside of loop")
            oren_exit(1)
        }

        // Restore stack to the loop base before leaving.
        var base_stack = loop["base_stack"]
        var delta = ctx["stack_size"] - base_stack
        if delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(delta))
        }

        // Jump to loop end (patched after body is compiled).
        var jpos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(loop["break_jumps"], jpos)
        return nil
    }
    if stmt["type"] == "Continue" {
        var loop2 = ctx["loop_ctx"]
        if loop2 == nil {
            print("native backend: continue outside of loop")
            oren_exit(1)
        }

        // Restore stack to the loop base before continuing.
        var base_stack2 = loop2["base_stack"]
        var delta2 = ctx["stack_size"] - base_stack2
        if delta2 > 0 {
            push_u32_le(ctx["code"], insn_add_sp(delta2))
        }

        // Jump to the loop-specific continue target.
        // - while: condition start
        // - for: post start (so post runs before re-checking condition)
        var cont = loop2["continue_pos"]
        if cont != nil {
            var back_pos = oren_list_len(ctx["code"])
            var back_off = (cont - back_pos) / 4
            push_u32_le(ctx["code"], insn_b(back_off))
        } else {
            // Patch later (used for `for`, whose post-start is only known after body compilation).
            var jpos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(loop2["continue_jumps"], jpos)
        }
        return nil
    }
    if stmt["type"] == "Block" {
        var base_stack = ctx["stack_size"]
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            native_compile_stmt(ctx, stmts[i])
            i = i + 1
        }
        var delta = ctx["stack_size"] - base_stack
        if delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(delta))
            ctx["stack_size"] = base_stack
        }
        return nil
    }

    if stmt["type"] == "Set" {
        if stmt["left"]["type"] == "Index" {
            native_compile_expr(ctx, stmt["left"]["left"]) // container -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            native_compile_expr(ctx, stmt["left"]["index"]) // index -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            native_compile_expr(ctx, stmt["value"]) // value -> X0
            
            // Pop index -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // Pop container -> X2
            push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // oren_index_set(container, index, value)
            // Need X0=container, X1=index, X2=value
            // Currently: X0=value, X1=index, X2=container
            
            push_u32_le(ctx["code"], insn_mov_reg(3, 0)) // val -> X3
            push_u32_le(ctx["code"], insn_mov_reg(0, 2)) // cont -> X0
            // X1 is index (ok)
            push_u32_le(ctx["code"], insn_mov_reg(2, 3)) // val -> X2
            
            var bl_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_index_set"})
            
            return nil
        }
        if stmt["left"]["type"] == "Member" {
             // obj.prop = val -> oren_map_set(obj, "prop", val)
             // Similar logic, but index is string literal
             
             native_compile_expr(ctx, stmt["left"]["left"]) // obj -> X0
             push_u32_le(ctx["code"], insn_sub_sp(16))
             push_u32_le(ctx["code"], insn_str_x0_sp(0))
             ctx["stack_size"] = ctx["stack_size"] + 16
             
             // Prop name string
             var prop = stmt["left"]["prop"]["value"]
             var bytes = oren_bytes_from_string(prop)
             bytes_push(bytes, 0)
             while int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
             var data_off = oren_list_len(ctx["data"])
             bytes_extend(ctx["data"], bytes)
             var adr_pos = oren_list_len(ctx["code"])
             push_u32_le(ctx["code"], 0)
             oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off})
             // X0 has key ptr
             
             push_u32_le(ctx["code"], insn_sub_sp(16))
             push_u32_le(ctx["code"], insn_str_x0_sp(0))
             ctx["stack_size"] = ctx["stack_size"] + 16
             
             native_compile_expr(ctx, stmt["value"]) // val -> X0
             
             // Pop key -> X1
             push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
             push_u32_le(ctx["code"], insn_add_sp(16))
             ctx["stack_size"] = ctx["stack_size"] - 16
             
             // Pop obj -> X2
             push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
             push_u32_le(ctx["code"], insn_add_sp(16))
             ctx["stack_size"] = ctx["stack_size"] - 16
             
             // Need X0=obj, X1=key, X2=val
             // Currently: X0=val, X1=key, X2=obj
             push_u32_le(ctx["code"], insn_mov_reg(3, 0)) // val -> X3
             push_u32_le(ctx["code"], insn_mov_reg(0, 2)) // obj -> X0
             // X1 is key (ok)
             push_u32_le(ctx["code"], insn_mov_reg(2, 3)) // val -> X2
             
             var bl_pos2 = oren_list_len(ctx["code"])
             push_u32_le(ctx["code"], 0)
             oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos2, "name": "oren_map_set"})
             
             return nil
        }
        print("native backend: unsupported set target")
        return nil
    }

    if stmt["type"] == "Assign" {
        native_compile_expr(ctx, stmt["value"])
        
        var name = stmt["name"]["value"]
        var off = ctx["locals"][name]
        if off != nil {
            var current_sp_off = ctx["stack_size"] - off - 16
            push_u32_le(ctx["code"], insn_str_x0_sp(current_sp_off))
            return nil
        }
        
        var global_off = ctx["globals"][name]
        if global_off != nil {
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            var adr_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": global_off})
            push_u32_le(ctx["code"], insn_add_imm(1, 0, 0))
            
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            push_u32_le(ctx["code"], insn_str_ptr(0, 1))
            return nil
        }
        
        print("native backend: assignment to undefined variable " + name)
        return nil
    }

    if stmt["type"] == "Var" {
        native_compile_expr(ctx, stmt["value"])

        var name = stmt["name"]["value"]
        
        if ctx["in_function"] {
            var existing_off = ctx["locals"][name]
            if existing_off != nil {
                var current_sp_off_existing = ctx["stack_size"] - existing_off - 16
                push_u32_le(ctx["code"], insn_str_x0_sp(current_sp_off_existing))
                return nil
            }
            
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["locals"][name] = ctx["stack_size"]
            ctx["stack_size"] = ctx["stack_size"] + 16
        } else {
            var data_off = oren_list_len(ctx["data"])
            var k = 0
            while k < 8 { bytes_push(ctx["data"], 0); k = k + 1 }
            ctx["globals"][name] = data_off
            
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            var adr_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off})
            push_u32_le(ctx["code"], insn_add_imm(1, 0, 0))
            
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            push_u32_le(ctx["code"], insn_str_ptr(0, 1))
        }
        return nil
    }
    
    if stmt["type"] == "Return" {
        native_compile_expr(ctx, stmt["value"])
        push_u32_le(ctx["code"], insn_mov_sp_fp())
        push_u32_le(ctx["code"], insn_ldp_post())
        push_u32_le(ctx["code"], insn_ret())
        return nil
    }
    
    if stmt["type"] == "For" {
        // Native `for`:
        // - init runs once
        // - cond checked before each iteration (nil => true)
        // - continue jumps to post start (so post runs), then loops back to cond
        // - break exits the loop

        var outer_base_stack = ctx["stack_size"]
        if stmt["init"] != nil { native_compile_stmt(ctx, stmt["init"]) }
        var loop_base_stack = ctx["stack_size"]

        var start_pos = oren_list_len(ctx["code"])

        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "base_stack": loop_base_stack, "start_pos": start_pos, "continue_pos": nil, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop

        // Condition (nil => true)
        if stmt["cond"] != nil {
            native_compile_expr(ctx, stmt["cond"])
        } else {
            push_u32_le(ctx["code"], insn_movz(0, 1))
        }
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        var jump_end_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)

        native_compile_stmt(ctx, stmt["body"])

        // Ensure stack is restored to the loop base before post/next iter.
        var loop_delta = ctx["stack_size"] - loop_base_stack
        if loop_delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(loop_delta))
            ctx["stack_size"] = loop_base_stack
        }

        // Post clause (continue target).
        var post_start = oren_list_len(ctx["code"])
        loop["continue_pos"] = post_start
        if stmt["post"] != nil { native_compile_stmt(ctx, stmt["post"]) }

        var post_delta = ctx["stack_size"] - loop_base_stack
        if post_delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(post_delta))
            ctx["stack_size"] = loop_base_stack
        }

        // Jump back to the condition.
        var loop_back_pos = oren_list_len(ctx["code"])
        var back_off = (start_pos - loop_back_pos) / 4
        push_u32_le(ctx["code"], insn_b(back_off))

        var end_target = oren_list_len(ctx["code"])
        var end_off = (end_target - jump_end_pos) / 4
        set_u32_le(ctx["code"], jump_end_pos, insn_b_cond(end_off, 0))

        // Patch breaks/continues recorded inside the loop body.
        var bi = 0
        while bi < oren_list_len(loop["break_jumps"]) {
            var bpos = loop["break_jumps"][bi]
            var boff = (end_target - bpos) / 4
            set_u32_le(ctx["code"], bpos, insn_b(boff))
            bi = bi + 1
        }
        var ci = 0
        while ci < oren_list_len(loop["continue_jumps"]) {
            var cpos = loop["continue_jumps"][ci]
            var coff = (post_start - cpos) / 4
            set_u32_le(ctx["code"], cpos, insn_b(coff))
            ci = ci + 1
        }

        ctx["loop_ctx"] = prev_loop

        // `for` introduces an init-scope like a block: pop init locals after the loop.
        var init_delta = loop_base_stack - outer_base_stack
        if init_delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(init_delta))
            ctx["stack_size"] = outer_base_stack
        }
        return nil
    }
    
    if stmt["type"] == "FFI" {
        var name = stmt["name"]["value"]
        ctx["imports"][name] = true
        oren_list_push(ctx["import_list"], name)
        return nil
    }
    
    if stmt["type"] == "Type" {
        var name = stmt["name"]["value"]
        var fields = stmt["fields"]
        var n_fields = oren_list_len(fields)
        
        var jump_skip_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        
        var func_start = oren_list_len(ctx["code"])
        ctx["functions"][name] = func_start
        oren_list_push(ctx["function_names"], name)
        
        var old_locals = ctx["locals"]
        var old_stack_size = ctx["stack_size"]
        ctx["locals"] = {}
        ctx["stack_size"] = 0
        
        ctx["in_function"] = true
        
        push_u32_le(ctx["code"], insn_stp_pre())
        push_u32_le(ctx["code"], insn_mov_fp_sp())
        ctx["stack_size"] = ctx["stack_size"] + 16 
        
        var i = 0
        while i < n_fields {
            var f_name = fields[i]["value"]
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_reg_sp(i, 0))
            ctx["locals"][f_name] = ctx["stack_size"]
            ctx["stack_size"] = ctx["stack_size"] + 16
            i = i + 1
        }
        
        var size_bytes = n_fields * 8
        push_u32_le(ctx["code"], insn_movz(0, size_bytes))
        var bl_pos_alloc = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_alloc, "name": "oren_alloc_struct"})
        
        var struct_ptr_off = ctx["stack_size"]
        push_u32_le(ctx["code"], insn_sub_sp(16))
        push_u32_le(ctx["code"], insn_str_x0_sp(0))
        ctx["stack_size"] = ctx["stack_size"] + 16
        
        i = 0
        while i < n_fields {
            var f_name2 = fields[i]["value"]
            var off = ctx["locals"][f_name2]
            var current_sp_off = ctx["stack_size"] - off - 16
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, current_sp_off))
            var ptr_sp_off = ctx["stack_size"] - struct_ptr_off - 16
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, ptr_sp_off))
            if i > 0 {
                var byte_off2 = i * 8
                push_u32_le(ctx["code"], insn_add_imm(1, 1, byte_off2))
            }
            push_u32_le(ctx["code"], insn_str_ptr(0, 1))
            i = i + 1
        }
        
        var ptr_sp_off2 = ctx["stack_size"] - struct_ptr_off - 16
        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, ptr_sp_off2))
        push_u32_le(ctx["code"], insn_add_sp(16))
        ctx["stack_size"] = ctx["stack_size"] - 16
        
        push_u32_le(ctx["code"], insn_mov_sp_fp())
        push_u32_le(ctx["code"], insn_ldp_post())
        push_u32_le(ctx["code"], insn_ret())
        
        var func_end = oren_list_len(ctx["code"])
        var skip_off = (func_end - jump_skip_pos) / 4
        set_u32_le(ctx["code"], jump_skip_pos, insn_b(skip_off))
        
        ctx["in_function"] = false
        
        ctx["locals"] = old_locals
        ctx["stack_size"] = old_stack_size
        return nil
    }
    
    if stmt["type"] == "While" {
        var loop_base_stack = ctx["stack_size"]
        var start_pos = oren_list_len(ctx["code"])

        var prev_loop = ctx["loop_ctx"]
        var loop = {"prev": prev_loop, "base_stack": loop_base_stack, "start_pos": start_pos, "continue_pos": start_pos, "break_jumps": [], "continue_jumps": []}
        ctx["loop_ctx"] = loop
        
        native_compile_expr(ctx, stmt["cond"])
        
        push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
        
        var jump_end_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0) 
        
        native_compile_stmt(ctx, stmt["body"])

        // Ensure stack is restored to the loop base before iterating.
        var loop_delta = ctx["stack_size"] - loop_base_stack
        if loop_delta > 0 {
            push_u32_le(ctx["code"], insn_add_sp(loop_delta))
            ctx["stack_size"] = loop_base_stack
        }
        
        var loop_back_pos = oren_list_len(ctx["code"])
        var back_off = (start_pos - loop_back_pos) / 4
        push_u32_le(ctx["code"], insn_b(back_off))
        
        var end_target = oren_list_len(ctx["code"])
        var end_off = (end_target - jump_end_pos) / 4
        set_u32_le(ctx["code"], jump_end_pos, insn_b_cond(end_off, 0)) 

        // Patch any breaks emitted inside the loop body to jump here.
        var bi = 0
        while bi < oren_list_len(loop["break_jumps"]) {
            var bpos = loop["break_jumps"][bi]
            var boff = (end_target - bpos) / 4
            set_u32_le(ctx["code"], bpos, insn_b(boff))
            bi = bi + 1
        }

        // Patch any continues that were emitted before the continue target was known.
        var ci = 0
        while ci < oren_list_len(loop["continue_jumps"]) {
            var cpos = loop["continue_jumps"][ci]
            var coff = (loop["continue_pos"] - cpos) / 4
            set_u32_le(ctx["code"], cpos, insn_b(coff))
            ci = ci + 1
        }

        // Pop loop context
        ctx["loop_ctx"] = prev_loop
        
        return nil
    }

    if stmt["type"] == "ExprStmt" {
        var exp = stmt["expr"]
        
        if exp["type"] == "If" {
            var base_stack = ctx["stack_size"]
            
            native_compile_expr(ctx, exp["cond"])
            
            push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
            
            var jump_else_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0) 
            
            native_compile_stmt(ctx, exp["consq"])

            var cons_delta = ctx["stack_size"] - base_stack
            if cons_delta > 0 {
                push_u32_le(ctx["code"], insn_add_sp(cons_delta))
                ctx["stack_size"] = base_stack
            }
            
            var jump_end_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0) 
            
            var else_target = oren_list_len(ctx["code"])
            var else_off = (else_target - jump_else_pos) / 4
            set_u32_le(ctx["code"], jump_else_pos, insn_b_cond(else_off, 0)) 
            
            if exp["alt"] != nil {
                native_compile_stmt(ctx, exp["alt"])
            }

            var alt_delta = ctx["stack_size"] - base_stack
            if alt_delta > 0 {
                push_u32_le(ctx["code"], insn_add_sp(alt_delta))
                ctx["stack_size"] = base_stack
            }
            
            var end_target = oren_list_len(ctx["code"])
            var end_off = (end_target - jump_end_pos) / 4
            set_u32_le(ctx["code"], jump_end_pos, insn_b(end_off))
            
            return nil
        }
        
        if exp["type"] == "Function" {
            var fn_name = exp["name"]
            
            while int_mod(oren_list_len(ctx["code"]), 4) != 0 {
                bytes_push(ctx["code"], 0)
            }
            
            var jump_skip_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0) 
            
            var func_start = oren_list_len(ctx["code"])
            ctx["functions"][fn_name] = func_start
            oren_list_push(ctx["function_names"], fn_name)
            if fn_name == "main" {
                ctx["main_idx"] = func_start
            }
            
            var old_locals = ctx["locals"]
            var old_stack_size = ctx["stack_size"]
            ctx["locals"] = {}
            ctx["stack_size"] = 0
            
            ctx["in_function"] = true
            
            push_u32_le(ctx["code"], insn_stp_pre())
            push_u32_le(ctx["code"], insn_mov_fp_sp())
            ctx["stack_size"] = ctx["stack_size"] + 16 
            
            var params_info = []
            var params = exp["params"]
            var n_params = oren_list_len(params)
            var i = 0
            while i < n_params {
                var p_name = params[i]["value"]
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_reg_sp(i, 0))
                ctx["locals"][p_name] = ctx["stack_size"]
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                if ctx["platform"]["debug"] == true {
                    oren_list_push(params_info, {"name": p_name, "offset": ctx["locals"][p_name]})
                }
                
                i = i + 1
            }
            
            native_compile_stmt(ctx, exp["body"])
            
            push_u32_le(ctx["code"], insn_movz(0, 0))
            push_u32_le(ctx["code"], insn_mov_sp_fp())
            push_u32_le(ctx["code"], insn_ldp_post())
            push_u32_le(ctx["code"], insn_ret())
            
            var func_end = oren_list_len(ctx["code"])
            
            if ctx["platform"]["debug"] == true {
                oren_list_push(ctx["debug_info"]["funcs"], {
                    "name": fn_name,
                    "start": func_start,
                    "end": func_end,
                    "params": params_info
                })
            }
            
            var skip_off = (func_end - jump_skip_pos) / 4
            set_u32_le(ctx["code"], jump_skip_pos, insn_b(skip_off))
            
            ctx["in_function"] = false
            
            ctx["locals"] = old_locals
            ctx["stack_size"] = old_stack_size
            return nil
        }
        
        if exp["type"] == "Call" {
            var fn_name = exp["fn"]["value"]
            
            var sys_write = 4
            var sys_exit = 1
            var svc_imm = 128
            var sys_reg = 16
            var is_macos = true
            
            if ctx["platform"]["os"] == "linux" {
                sys_write = 64
                sys_exit = 93
                svc_imm = 0
                sys_reg = 8
                is_macos = false
            }

            if fn_name == "sys_write" {
                native_compile_expr(ctx, exp["args"][0]) // fd
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                native_compile_expr(ctx, exp["args"][1]) // ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                native_compile_expr(ctx, exp["args"][2]) // len
                
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0)) // ptr
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                push_u32_le(ctx["code"], insn_mov_reg(2, 0)) // len -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0)) // fd -> X0
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                push_u32_le(ctx["code"], insn_movz(sys_reg, sys_write))
                push_u32_le(ctx["code"], insn_svc(svc_imm))
                return nil
            }

            if fn_name == "print" {
                var args = exp["args"]
                var argc = oren_list_len(args)
                var arg0 = args[0]
                
                var is_fmt = false
                if argc > 1 {
                    if arg0["type"] == "String" {
                        if contains_curly_braces(arg0["value"]) {
                            is_fmt = true
                        }
                    }
                }
                
                if is_fmt {
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    var bl_new_list = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list, "name": "oren_new_list"})
                    
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    push_u32_le(ctx["code"], insn_str_x0_sp(0))
                    ctx["stack_size"] = ctx["stack_size"] + 16
                    
                    var k = 1
                    while k < argc {
                        native_compile_expr(ctx, args[k]) 
                        push_u32_le(ctx["code"], insn_sub_sp(16))
                        push_u32_le(ctx["code"], insn_str_x0_sp(0))
                        ctx["stack_size"] = ctx["stack_size"] + 16
                        
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                        push_u32_le(ctx["code"], insn_add_sp(16))
                        ctx["stack_size"] = ctx["stack_size"] - 16
                        
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
                        
                        var bl_push = oren_list_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push, "name": "oren_list_push"})
                        
                        k = k + 1
                    }
                    
                    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                    push_u32_le(ctx["code"], insn_add_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] - 16
                    
                    native_compile_expr(ctx, arg0)
                    
                    var bl_fmt = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_fmt, "name": "oren_print_fmt"})
                    return nil
                }

                if arg0["type"] == "String" {
                    // Print string literal directly via sys_write(fd=1, ptr, len) + newline.
                    var s = arg0["value"]
                    var len = oren_string_len(s)
                    native_compile_expr(ctx, arg0) // X0 = ptr

                    // X0=fd, X1=ptr, X2=len
                    push_u32_le(ctx["code"], insn_mov_reg(1, 0))
                    push_u32_le(ctx["code"], insn_movz(2, len))
                    push_u32_le(ctx["code"], insn_movz(0, 1))
                    push_u32_le(ctx["code"], insn_movz(sys_reg, sys_write))
                    push_u32_le(ctx["code"], insn_svc(svc_imm))

                    // Write newline (1 byte) from stack.
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] + 16
                    push_u32_le(ctx["code"], insn_movz(3, 10))
                    push_u32_le(ctx["code"], insn_str_ptr(3, 31))
                    push_u32_le(ctx["code"], insn_add_imm(1, 31, 0)) // X1 = SP
                    push_u32_le(ctx["code"], insn_movz(2, 1))
                    push_u32_le(ctx["code"], insn_movz(0, 1))
                    push_u32_le(ctx["code"], insn_movz(sys_reg, sys_write))
                    push_u32_le(ctx["code"], insn_svc(svc_imm))
                    push_u32_le(ctx["code"], insn_add_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] - 16
                    return nil
                }

                native_compile_expr(ctx, arg0)
                var bl_pos_print = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_print, "name": "oren_print"})
                return nil
            }
            
            if fn_name == "exit" {
                native_compile_expr(ctx, exp["args"][0])
                push_u32_le(ctx["code"], insn_movz(sys_reg, sys_exit))
                push_u32_le(ctx["code"], insn_svc(svc_imm))
                return nil
            }
            
            native_compile_expr(ctx, exp)
            return nil
        }
        
        native_compile_expr(ctx, exp)
        return nil
    }
}

fn native_compile_program_arm64(linked, platform) {
    var ctx = {
        "code": bytes_new(),
        "data": bytes_new(),
        "fixups": [],
        "locals": {},
        "globals": {},
        "functions": {},
        "function_names": [],
        "main_idx": nil,
        "imports": {},
        "import_list": [],
        "stack_size": 0,
        "in_function": false,
        "loop_ctx": nil,
        "platform": platform,
        "aliases": linked["aliases"],
        "type_ns": linked["type_ns"],
        "field_offsets": linked["field_offsets"]
    }
    
    if platform["debug"] == true {
        ctx["debug_info"] = {"funcs": []}
    }
    
    // Entry stub: calls main and exits with its result
    var sys_exit = 1
    var svc_imm = 128
    var sys_reg = 16
    if ctx["platform"]["os"] == "linux" {
        sys_exit = 93
        svc_imm = 0
        sys_reg = 8
    }

    // Capture argc/argv/envp before any calls clobber argument registers.
    //
    // Linux (ELF entry):
    //   stack layout: [argc][argv...NULL][envp...NULL][auxv...]
    //   we load argc/argv from SP.
    //
    // macOS (dyld LC_MAIN):
    //   X0=argc, X1=argv (empirically X2 is not reliable for envp here).
    //
    // For both OSes we derive:
    //   envp = argv + (argc + 1) * 8
    if ctx["platform"]["os"] == "linux" {
        // X0 = *(SP), X1 = SP + 8  (argv)
        push_u32_le(ctx["code"], insn_ldr_ptr(0, 31))
        push_u32_le(ctx["code"], insn_add_imm(1, 31, 8))
    }
    push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = argc
    push_u32_le(ctx["code"], insn_mov_reg(20, 1)) // X20 = argv

    // envp = argv + (argc + 1) * 8
    push_u32_le(ctx["code"], insn_add_imm(2, 19, 1)) // X2 = argc + 1
    push_u32_le(ctx["code"], insn_movz(3, 8))        // X3 = 8
    push_u32_le(ctx["code"], insn_mul(2, 2, 3))      // X2 = (argc+1)*8
    push_u32_le(ctx["code"], insn_add_reg(21, 20, 2)) // X21 = envp

    push_u32_le(ctx["code"], insn_stp_pre())
    push_u32_le(ctx["code"], insn_mov_fp_sp())
    ctx["stack_size"] = ctx["stack_size"] + 16

    // Our generated functions do not currently preserve callee-saved registers
    // (AAPCS would require preserving X19-X28). Because the entry stub must
    // keep argc/argv/envp stable across runtime init calls, save them explicitly.
    push_u32_le(ctx["code"], insn_sub_sp(32))
    push_u32_le(ctx["code"], insn_str_reg_sp(19, 0))
    push_u32_le(ctx["code"], insn_str_reg_sp(20, 8))
    push_u32_le(ctx["code"], insn_str_reg_sp(21, 16))
    ctx["stack_size"] = ctx["stack_size"] + 32
    
    // Init Heap Globals (X28=ptr, X27=limit) to 0 before any runtime calls.
    push_u32_le(ctx["code"], insn_movz(28, 0))
    push_u32_le(ctx["code"], insn_movz(27, 0))
    
    // Init Runtime
    var bl_init = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_init, "name": "native_runtime_init"})

    // Restore argc/argv/envp saved across native_runtime_init.
    push_u32_le(ctx["code"], insn_ldr_reg_sp(19, 0))
    push_u32_le(ctx["code"], insn_ldr_reg_sp(20, 8))
    push_u32_le(ctx["code"], insn_ldr_reg_sp(21, 16))
    push_u32_le(ctx["code"], insn_add_sp(32))
    ctx["stack_size"] = ctx["stack_size"] - 32

    // Store argv/argc for oren_args() and envp for oren_getenv()/execve env inheritance.
    //
    // Preserve envp across the set_args call (our generated code does not preserve
    // callee-saved registers yet), and set envp AFTER set_args so any runtime-side
    // behavior cannot accidentally clear it.
    push_u32_le(ctx["code"], insn_sub_sp(16))
    push_u32_le(ctx["code"], insn_str_reg_sp(21, 0))
    ctx["stack_size"] = ctx["stack_size"] + 16

    // native_runtime_set_args(argc, argv)
    push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // argc
    push_u32_le(ctx["code"], insn_mov_reg(1, 20)) // argv
    var bl_set_args = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_args, "name": "native_runtime_set_args"})

    // native_runtime_set_envp(envp)
    push_u32_le(ctx["code"], insn_ldr_reg_sp(21, 0))
    push_u32_le(ctx["code"], insn_add_sp(16))
    ctx["stack_size"] = ctx["stack_size"] - 16

    push_u32_le(ctx["code"], insn_mov_reg(0, 21)) // envp
    var bl_set_envp = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_envp, "name": "native_runtime_set_envp"})

    if platform["debug"] == true {
        push_u32_le(ctx["code"], 0)
        var debug_adr_pos = oren_list_len(ctx["code"]) - 4
        ctx["debug_fixup_pos"] = debug_adr_pos
        
        var static_addr_pos = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], insn_movz(1, 0))
        push_u32_le(ctx["code"], insn_movk(1, 0, 1))
        push_u32_le(ctx["code"], insn_movk(1, 0, 2))
        push_u32_le(ctx["code"], insn_movk(1, 0, 3))
        ctx["debug_static_addr_pos"] = static_addr_pos
        
        var bl_set_dbg = oren_list_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_dbg, "name": "oren_set_debug_info"})
    }

    // Register Main Thread
    push_u32_le(ctx["code"], insn_add_imm(0, 31, 0)) // MOV X0, SP
    var bl_reg = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_reg, "name": "oren_register_thread"})
    
    var main_fix = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": main_fix, "name": "main"})
    // Preserve exit code across shutdown
    push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = ret
    var shutdown_fix = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": shutdown_fix, "name": "native_gc_shutdown"})
    push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // restore X0
    // exit(X0)
    push_u32_le(ctx["code"], insn_movz(sys_reg, sys_exit))
    push_u32_le(ctx["code"], insn_svc(svc_imm))
    // Should not return
    
    // Inject Runtime
    var runtime_src = oren_read_file("lib/runtime_native.oren")
    if oren_is_err(runtime_src) {
        print("Failed to read lib/runtime_native.oren")
        var msg = oren_err_msg(runtime_src)
        if msg != nil { print(msg) }
        oren_exit(1)
    }
    var l = lexer.new_lexer(runtime_src)
    var p = parser.new_parser(l)
    var runtime_prog = parser.parse_program(p)
    if oren_list_len(p["errors"]) != 0 {
        print("Parse errors in lib/runtime_native.oren:")
        var ei = 0
        while ei < oren_list_len(p["errors"]) {
            print(p["errors"][ei])
            ei = ei + 1
        }
        oren_exit(1)
    }
    
    // Compile runtime functions
    var i = 0
    while i < oren_list_len(runtime_prog["statements"]) {
        native_compile_stmt(ctx, runtime_prog["statements"][i])
        i = i + 1
    }

    // Register start of user code
    ctx["functions"]["__top_level__"] = oren_list_len(ctx["code"])

    var stmts = linked["statements"]
    i = 0
    while i < oren_list_len(stmts) {
        native_compile_stmt(ctx, stmts[i])
        i = i + 1
    }
    
    // Record entry (main) offset if present
    ctx["entry_idx"] = 0
    
    // Implicit exit(0)
    push_u32_le(ctx["code"], insn_movz(0, 0))
    if ctx["platform"]["os"] == "linux" {
        push_u32_le(ctx["code"], insn_movz(8, 93))
        push_u32_le(ctx["code"], 3556769793) // SVC #0
    } else {
        push_u32_le(ctx["code"], insn_movz(16, 1))
        push_u32_le(ctx["code"], 3556769921) // SVC #128
    }
    
    // Generate resolve_symbol function
    // Assuming macOS base 0x100000000 + 632
    var base_addr = 4294967928 
    if ctx["platform"]["os"] == "linux" {
        base_addr = 4194304 + 120 // 0x400000 + 120 (ELF header approx, need verify)
    }
    
    var sym_src = "fn resolve_symbol(addr) { var off = addr - " + oren_int_to_string(base_addr) + " "
    
    // Scan runtime functions
    var j = 0
    while j < oren_list_len(runtime_prog["statements"]) {
        var stmt = runtime_prog["statements"][j]
        if stmt["type"] == "Function" {
            var name = stmt["name"]
            var off = ctx["functions"][name]
            sym_src = sym_src + "if off >= " + oren_int_to_string(off) + " { return " + token.CH_QUOTE + name + token.CH_QUOTE + " } "
        }
        j = j + 1
    }
    
    // Scan user functions
    j = 0
    while j < oren_list_len(stmts) {
        var stmt = stmts[j]
        if stmt["type"] == "Function" {
            var name = stmt["name"]
            var off = ctx["functions"][name]
            if off == nil {
                print("codegen error: function offset not found for " + name)
            } else {
                sym_src = sym_src + "if off >= " + oren_int_to_string(off) + " { return " + token.CH_QUOTE + name + token.CH_QUOTE + " } "
            }
        }
        j = j + 1
    }
    
    sym_src = sym_src + "return \"???\" }"
    
    print("Generating symbol table...")
    var l_sym = lexer.new_lexer(sym_src)
    var p_sym = parser.new_parser(l_sym)
    var prog_sym = parser.parse_program(p_sym)
    if oren_list_len(prog_sym["statements"]) > 0 {
        native_compile_stmt(ctx, prog_sym["statements"][0])
    } else {
        print("native backend: failed to compile resolve_symbol")
        // print(sym_src) // Debug
    }

    return ctx
}

fn push_uleb128(buf, val) {
    if val == 0 {
        bytes_push(buf, 0)
        return nil
    }
    while val > 0 {
        var byte = int_mod(val, 128)
        val = val / 128
        if val > 0 {
            byte = byte | 128
        }
        bytes_push(buf, byte)
    }
    return nil
}

fn macho_build_bind_opcodes(imports, got_offset) {
    // Generates Binding Info for dyld.
    // See Mach-O/dyld_info.h or loader.h
    var p = bytes_new()
    var count = oren_list_len(imports)
    if count == 0 { return p }
    
    // BIND_OPCODE_SET_DYLIB_SPECIAL_IMM (0x30) | 14 (-2 Flat Lookup)
    bytes_push(p, 62) 
    
    // BIND_OPCODE_SET_TYPE_IMM (0x50) | 1 (BIND_TYPE_POINTER)
    bytes_push(p, 81)

    // BIND_OPCODE_SET_SEGMENT_AND_OFFSET_ULEB (0x70) | 2 (__DATA is seg 2)
    bytes_push(p, 114)
    push_uleb128(p, got_offset)
    
    var i = 0
    while i < count {
        var name = imports[i]
        
        // BIND_OPCODE_SET_SYMBOL_TRAILING_FLAGS_IMM (0x40) | 0
        bytes_push(p, 64)
        
        // Symbol name (C-string) + '_' prefix if typical C
        bytes_push(p, 95) // '_'
        var name_bytes = oren_bytes_from_string(name)
        var k = 0
        while k < oren_list_len(name_bytes) {
             bytes_push(p, name_bytes[k])
             k = k + 1
        }
        bytes_push(p, 0)
        
        // BIND_OPCODE_DO_BIND (0x90)
        bytes_push(p, 144)
        
        // Implicitly advances address by 8 (pointer size)
        
        i = i + 1
    }
    
    // BIND_OPCODE_DONE (0x00)
    bytes_push(p, 0)
    
    // Pad to 8 bytes? Not strictly required but good for alignment.
    while int_mod(oren_list_len(p), 8) != 0 {
        bytes_push(p, 0)
    }
    
    return p
}

fn macho_build_prefix_arm64(text_size, data_size, data_len, sig_size, entry_idx, header_size, imports_len, symtab_size, strtab_size, bind_size, bind_off, libs, is_shared, lib_name) {
    var p = bytes_new()
    var dyld_path = "/usr/lib/dyld"
    var dyld_cmdsize = align_up(12 + oren_string_len(dyld_path) + 1, 8)
    var dyld_info_cmdsize = 48
    
    // Header (Mach-O 64)
    push_u32_le(p, 4277009103) // Magic (FEEDFACF)
    push_u32_le(p, 16777228)   // CPU Type (ARM64)
    push_u32_le(p, 0)          // Subtype
    if is_shared {
        push_u32_le(p, 6)      // File Type (DYLIB)
    } else {
        push_u32_le(p, 2)      // File Type (Execute)
    }
    
    // Commands (baseline): PAGEZERO, TEXT, DATA, LINKEDIT, DYLD_INFO_ONLY, LOAD_DYLINKER, (optional) LOAD_DYLIB(libSystem),
    // BUILD_VERSION, MAIN/ID_DYLIB, UUID.
    //
    // Syscall-first binaries can run without linking libSystem when there are no imports.
    // This avoids libsystem_pthread initialization (and its bsdthread_register), letting
    // the program install its own bsdthread entrypoints for spawn().
    var need_libsystem = true
    if imports_len == 0 && oren_list_len(libs) == 0 && is_shared == false {
        need_libsystem = false
    }

    var libsys_path = "/usr/lib/libSystem.B.dylib"
    var libsys_cmdsize = 0
    if need_libsystem {
        libsys_cmdsize = align_up(24 + oren_string_len(libsys_path) + 1, 8)
    }

    var extra_libs_size = 0
    var k_lib = 0
    while k_lib < oren_list_len(libs) {
        var lib_path = libs[k_lib]
        var lib_cmdsize = align_up(24 + oren_string_len(lib_path) + 1, 8)
        extra_libs_size = extra_libs_size + lib_cmdsize
        k_lib = k_lib + 1
    }

    var id_dylib_name = lib_name
    var id_dylib_cmdsize = align_up(24 + oren_string_len(id_dylib_name) + 1, 8)
    
    // Base size: 72 (PAGEZERO) + 152 (TEXT) + 152 (DATA) + 72 (LINKEDIT) + 48 (DYLD_INFO) + dyld + (optional libsys) + 24 (BUILD_VER) + (MAIN or ID_DYLIB) + 24 (UUID)
    var entry_cmd_size = 24 // LC_MAIN
    if is_shared { entry_cmd_size = id_dylib_cmdsize } // LC_ID_DYLIB

    var uuid_cmd_size = 24
    var sizeof_cmds_base = 72 + 152 + 152 + 72 + dyld_info_cmdsize + dyld_cmdsize + libsys_cmdsize + 24 + entry_cmd_size + extra_libs_size + uuid_cmd_size
    // Baseline commands count without symtab/codesig:
    // PAGEZERO, TEXT, DATA, LINKEDIT, DYLD_INFO, LOAD_DYLINKER, (optional LOAD_DYLIB libSystem), BUILD_VERSION, MAIN/ID_DYLIB, UUID
    var ncmds_base = 9 + oren_list_len(libs) + 1 // includes libSystem
    if need_libsystem == false {
        ncmds_base = ncmds_base - 1
    }
    
    if symtab_size > 0 {
        sizeof_cmds_base = sizeof_cmds_base + 24 // LC_SYMTAB
        ncmds_base = ncmds_base + 1
    }

    var sizeof_cmds = sizeof_cmds_base
    var ncmds = ncmds_base
    if sig_size > 0 {
        sizeof_cmds = sizeof_cmds + 16 // LC_CODE_SIGNATURE
        ncmds = ncmds + 1
    }
    push_u32_le(p, ncmds) // ncmds
    push_u32_le(p, sizeof_cmds) // sizeofcmds
    push_u32_le(p, 2097285) // flags (MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE)
    push_u32_le(p, 0) // reserved
    
    // 1. LC_SEGMENT_64 (__PAGEZERO)
    push_u32_le(p, 25)
    push_u32_le(p, 72)
    var i = 0
    while i < 16 { bytes_push(p, 0); i = i + 1 }
    push_u64_le(p, 0) // vmaddr
    push_u64_le(p, 4294967296) // vmsize (4GB)
    push_u64_le(p, 0) // fileoff
    push_u64_le(p, 0) // filesize
    push_u32_le(p, 0) // maxprot
    push_u32_le(p, 0) // initprot
    push_u32_le(p, 0) // nsects
    push_u32_le(p, 0) // flags
    
    // 2. LC_SEGMENT_64 (__TEXT)
    push_u32_le(p, 25)
    push_u32_le(p, 152) // 72 + 80
    // segname "__TEXT"
    bytes_push(p, 95); bytes_push(p, 95); bytes_push(p, 84); bytes_push(p, 69); bytes_push(p, 88); bytes_push(p, 84);
    i = 0; while i < 10 { bytes_push(p, 0); i = i + 1 }
    push_u64_le(p, 4294967296) // vmaddr (0x100000000)
    push_u64_le(p, text_size) // vmsize
    push_u64_le(p, 0) // fileoff
    push_u64_le(p, text_size) // filesize
    push_u32_le(p, 5) // maxprot (RX)
    push_u32_le(p, 5) // initprot (RX)
    push_u32_le(p, 1) // nsects
    push_u32_le(p, 0) // flags
    
        // Section (__text)
        bytes_push(p, 95); bytes_push(p, 95); bytes_push(p, 116); bytes_push(p, 101); bytes_push(p, 120); bytes_push(p, 116);
        i = 0; while i < 10 { bytes_push(p, 0); i = i + 1 }
        bytes_push(p, 95); bytes_push(p, 95); bytes_push(p, 84); bytes_push(p, 69); bytes_push(p, 88); bytes_push(p, 84);
        i = 0; while i < 10 { bytes_push(p, 0); i = i + 1 }
        push_u64_le(p, 4294967296 + header_size) // addr (start of code)
        push_u64_le(p, text_size - header_size) // size (code + padding)
        push_u32_le(p, header_size) // offset
        push_u32_le(p, 4) // align
        push_u32_le(p, 0) // reloff
        push_u32_le(p, 0) // nreloc
        push_u32_le(p, 2147484672) // flags
        push_u32_le(p, 0) // reserved1
        push_u32_le(p, 0) // reserved2
        push_u32_le(p, 0) // reserved3

    // 3. LC_SEGMENT_64 (__DATA)
    push_u32_le(p, 25)
    push_u32_le(p, 152) // 72 + 80
    // segname "__DATA"
    bytes_push(p, 95); bytes_push(p, 95); bytes_push(p, 68); bytes_push(p, 65); bytes_push(p, 84); bytes_push(p, 65);
    i = 0; while i < 10 { bytes_push(p, 0); i = i + 1 }
    push_u64_le(p, 4294967296 + text_size) // vmaddr
    push_u64_le(p, data_size) // vmsize
    push_u64_le(p, text_size) // fileoff
    push_u64_le(p, data_size) // filesize
    push_u32_le(p, 3) // maxprot (RW)
    push_u32_le(p, 3) // initprot (RW)
    push_u32_le(p, 1) // nsects
    push_u32_le(p, 0) // flags
    
        // Section (__data)
        bytes_push(p, 95); bytes_push(p, 95); bytes_push(p, 100); bytes_push(p, 97); bytes_push(p, 116); bytes_push(p, 97);
        i = 0; while i < 10 { bytes_push(p, 0); i = i + 1 }
        bytes_push(p, 95); bytes_push(p, 95); bytes_push(p, 68); bytes_push(p, 65); bytes_push(p, 84); bytes_push(p, 65);
        i = 0; while i < 10 { bytes_push(p, 0); i = i + 1 }
        push_u64_le(p, 4294967296 + text_size) // addr
        push_u64_le(p, data_len) // size (actual data size)
        push_u32_le(p, text_size) // offset
        push_u32_le(p, 3) // align (2^3=8)
        push_u32_le(p, 0) // reloff
        push_u32_le(p, 0) // nreloc
        push_u32_le(p, 0) // flags
        push_u32_le(p, 0) // reserved1
        push_u32_le(p, 0) // reserved2
        push_u32_le(p, 0) // reserved3
        
    // 4. LC_SEGMENT_64 (__LINKEDIT)
    push_u32_le(p, 25)
    push_u32_le(p, 72)
    bytes_push(p, 95); bytes_push(p, 95); bytes_push(p, 76); bytes_push(p, 73); bytes_push(p, 78); bytes_push(p, 75); bytes_push(p, 69); bytes_push(p, 68); bytes_push(p, 73); bytes_push(p, 84);
    i = 0; while i < 6 { bytes_push(p, 0); i = i + 1 }
    push_u64_le(p, 4294967296 + text_size + data_size) // vmaddr
    var linkedit_size = bind_size + sig_size + symtab_size + (imports_len * 4) + strtab_size
    push_u64_le(p, linkedit_size) // vmsize (aligned)
    push_u64_le(p, text_size + data_size) // fileoff
    push_u64_le(p, linkedit_size) // filesize
    push_u32_le(p, 1) // maxprot (R)
    push_u32_le(p, 1) // initprot (R)
    push_u32_le(p, 0) // nsects
    push_u32_le(p, 0) // flags
    
    // LC_SYMTAB (if needed)
    if symtab_size > 0 {
        push_u32_le(p, 2) // LC_SYMTAB
        push_u32_le(p, 24) // cmdsize
        push_u32_le(p, text_size + data_size + bind_size) // symoff
        push_u32_le(p, symtab_size / 16) // nsyms
        push_u32_le(p, text_size + data_size + bind_size + symtab_size + (imports_len * 4)) // stroff
        push_u32_le(p, strtab_size) // strsize
    }
    
    // 5. LC_DYLD_INFO_ONLY
    push_u32_le(p, 2147483682)
    push_u32_le(p, dyld_info_cmdsize)
    push_u32_le(p, 0) // rebase_off
    push_u32_le(p, 0) // rebase_size
    push_u32_le(p, bind_off) // bind_off
    push_u32_le(p, bind_size) // bind_size
    push_u32_le(p, 0) // weak_bind_off
    push_u32_le(p, 0) // weak_bind_size
    push_u32_le(p, 0) // lazy_bind_off
    push_u32_le(p, 0) // lazy_bind_size
    push_u32_le(p, 0) // export_off
    push_u32_le(p, 0) // export_size
    
    // 6. LC_LOAD_DYLINKER
    var dyld_bytes = oren_bytes_from_string(dyld_path)
    var cmd_start = oren_list_len(p)
    push_u32_le(p, 14)
    push_u32_le(p, dyld_cmdsize)
    push_u32_le(p, 12)
    i = 0
    while i < oren_list_len(dyld_bytes) {
        bytes_push(p, dyld_bytes[i])
        i = i + 1
    }
    bytes_push(p, 0)
    while oren_list_len(p) < cmd_start + dyld_cmdsize {
        bytes_push(p, 0)
    }
    
    // 7. LC_LOAD_DYLIB (libSystem) - optional for syscall-only binaries
    if need_libsystem {
        var cmd_start_lib = oren_list_len(p)
        push_u32_le(p, 12) // LC_LOAD_DYLIB
        push_u32_le(p, libsys_cmdsize)
        push_u32_le(p, 24) // offset to name
        push_u32_le(p, 0) // timestamp
        push_u32_le(p, 0) // current version
        push_u32_le(p, 0) // compatibility version
        k_lib = 0
        var libsys_bytes = oren_bytes_from_string(libsys_path)
        while k_lib < oren_list_len(libsys_bytes) {
            bytes_push(p, libsys_bytes[k_lib])
            k_lib = k_lib + 1
        }
        bytes_push(p, 0) // null terminator
        while oren_list_len(p) < cmd_start_lib + libsys_cmdsize {
            bytes_push(p, 0) // padding
        }
    }

    // Extra libs
    k_lib = 0
    while k_lib < oren_list_len(libs) {
        var lib_path2 = libs[k_lib]
        var cmd_start_lib2 = oren_list_len(p)
        var lib_cmdsize2 = align_up(24 + oren_string_len(lib_path2) + 1, 8)
        push_u32_le(p, 12) // LC_LOAD_DYLIB
        push_u32_le(p, lib_cmdsize2)
        push_u32_le(p, 24) // offset to name
        push_u32_le(p, 0) // timestamp
        push_u32_le(p, 0) // current version
        push_u32_le(p, 0) // compatibility version
        var kl2 = 0
        var lib_bytes2 = oren_bytes_from_string(lib_path2)
        while kl2 < oren_list_len(lib_bytes2) {
            bytes_push(p, lib_bytes2[kl2])
            kl2 = kl2 + 1
        }
        bytes_push(p, 0)
        while oren_list_len(p) < cmd_start_lib2 + lib_cmdsize2 {
            bytes_push(p, 0)
        }
        k_lib = k_lib + 1
    }

    // 8. LC_BUILD_VERSION
    push_u32_le(p, 50)
    push_u32_le(p, 24)
    push_u32_le(p, 1)
    push_u32_le(p, 786432)
    push_u32_le(p, 786432)
    push_u32_le(p, 0)
    
    // LC_UUID
    push_u32_le(p, 27) // LC_UUID
    push_u32_le(p, 24)
    var k_uuid = 0
    while k_uuid < 4 { push_u32_le(p, 0); k_uuid = k_uuid + 1 }
    
    // 8. LC_MAIN or LC_ID_DYLIB
    if is_shared {
        var id_start = oren_list_len(p)
        var id_name = lib_name
        var id_size = align_up(24 + oren_string_len(id_name) + 1, 8)
        push_u32_le(p, 13) // LC_ID_DYLIB
        push_u32_le(p, id_size)
        push_u32_le(p, 24) // offset to name
        push_u32_le(p, 0) // timestamp
        push_u32_le(p, 0) // current ver
        push_u32_le(p, 0) // compat ver
        var ki = 0
        var id_bytes = oren_bytes_from_string(id_name)
        while ki < oren_list_len(id_bytes) {
            bytes_push(p, id_bytes[ki])
            ki = ki + 1
        }
        bytes_push(p, 0)
        while oren_list_len(p) < id_start + id_size { bytes_push(p, 0) }
    } else {
        push_u32_le(p, 2147483688)
        push_u32_le(p, 24)
        push_u64_le(p, header_size + entry_idx) // entryoff
        push_u64_le(p, 0) // stacksize
    }
                
    if sig_size > 0 {
        // 9. LC_CODE_SIGNATURE
        push_u32_le(p, 29)
        push_u32_le(p, 16)
        push_u32_le(p, text_size + data_size) // dataoff
        push_u32_le(p, sig_size) // datasize
    }

    while oren_list_len(p) < header_size {
        bytes_push(p, 0)
    }
    return p
}

fn macho_exit_code_bytes(code) {
    var b = bytes_new()
    // MOV X0, #code
    push_u32_le(b, insn_movz(0, code))
    // MOV X16, #1 (sys_exit)
    push_u32_le(b, insn_movz(16, 1))
    // SVC #0x80
    // MOVK X16, #0x200, LSL #16
    push_u32_le(b, 4068474896) // MOVK X16, #512, LSL #16
    push_u32_le(b, 3556769921) // SVC #128 -> 0xD4001001
    return b
}

fn emit_debug_info(ctx) {
    var p = bytes_new()
    var funcs = ctx["debug_info"]["funcs"]
    var count = oren_list_len(funcs)
    push_u64_le(p, count)
    
    var i = 0
    while i < count {
        var f = funcs[i]
        // Base 4294967296 + 2048 = 4294969344
        push_u64_le(p, 4294969344 + f["start"]) 
        push_u64_le(p, 4294969344 + f["end"])
        
        var name_bytes = oren_bytes_from_string(f["name"])
        push_u64_le(p, oren_list_len(name_bytes))
        var k = 0
        while k < oren_list_len(name_bytes) { bytes_push(p, name_bytes[k]); k = k + 1 }
        
        var params = f["params"]
        push_u64_le(p, oren_list_len(params))
        var j = 0
        while j < oren_list_len(params) {
            var param = params[j]
            var pname_bytes = oren_bytes_from_string(param["name"])
            push_u64_le(p, oren_list_len(pname_bytes))
            var m = 0
            while m < oren_list_len(pname_bytes) { bytes_push(p, pname_bytes[m]); m = m + 1 }
            push_u64_le(p, param["offset"])
            j = j + 1
        }
        i = i + 1
    }
    return p
}

fn macho_emit_exit_arm64(out_path, exit_code) {
    var code = macho_exit_code_bytes(exit_code)
    var text_size = align_up(632 + oren_list_len(code), 16384)

    // Signature size depends on codeLimit (= text_size + 176).
    var code_limit = text_size + 176
    var n_code_slots = ceil_div(code_limit, 4096)
    var code_dir_len = (44 + 5) + (32 * n_code_slots) // ident="oren" + NUL
    var super_len = 12 + 8 + code_dir_len
    var sig_size = align_up(super_len, 8)
    
    sig_size = 0

    var prefix = macho_build_prefix_arm64(text_size, 0, 0, sig_size, 0, 632, 0, 0, 0, 0, 0, [], false, "")
    bytes_extend(prefix, code)
    if sig_size > 0 {
        var sig = codesign_adhoc_superblob(prefix, "oren", oren_list_len(code))
        bytes_extend(prefix, sig)
    }

    var w = oren_write_bytes(out_path, prefix)
    if oren_is_err(w) {
        print("Failed to write output: " + out_path)
        var msg = oren_err_msg(w)
        if msg != nil { print(msg) }
        oren_exit(1)
    }
    oren_chmod(out_path, 493) // 0755
    return nil
}

fn macho_emit_program_arm64(out_path, linked, libs, is_shared, exports, debug_mode) {
    var ctx = native_compile_program_arm64(linked, {"os": "macos", "debug": debug_mode})
    if ctx == nil { return nil }
    
    var code = ctx["code"]
    var data = ctx["data"]
    var fixups = ctx["fixups"]
    var functions = ctx["functions"]
    
    var imports = ctx["import_list"]
    
    // FFI Tables
    var strtab = bytes_new()
    bytes_push(strtab, 32) // Space (index 0)
    bytes_push(strtab, 0)
    
    var symtab = bytes_new()
    var indsymtab = bytes_new()
    
    // Append GOT placeholder to Data (Aligned)
    while int_mod(oren_list_len(data), 8) != 0 {
        bytes_push(data, 0)
    }
    var got_offset = oren_list_len(data)
    var k_got = 0
    while k_got < oren_list_len(imports) {
        var k = 0
        while k < 8 { bytes_push(data, 0); k = k + 1 }
        k_got = k_got + 1
    }

    var bind_opcodes = macho_build_bind_opcodes(imports, got_offset)
    var bind_size = oren_list_len(bind_opcodes)

    var i_imp = 0
    while i_imp < oren_list_len(imports) {
        var name = imports[i_imp]
        var stub_pos = oren_list_len(code)
        functions[name] = stub_pos 
        
        // Stub: ADR X16, <got>; LDR X16, [X16]; BR X16
        push_u32_le(code, 0) // Placeholder for ADR
        push_u32_le(code, 4181721616) // LDR X16, [X16]
        push_u32_le(code, 3592356352) // BR X16
        
        oren_list_push(fixups, {"type": "got_load", "pos": stub_pos, "got_index": i_imp})
        
        // Symbol Table
        var name_idx = oren_list_len(strtab)
        
        bytes_push(strtab, 95) // '_'
        var name_bytes = oren_bytes_from_string(name)
        var k2 = 0
        while k2 < oren_list_len(name_bytes) {
             bytes_push(strtab, name_bytes[k2])
             k2 = k2 + 1
        }
        bytes_push(strtab, 0)
        
        push_u32_le(symtab, name_idx) // n_strx
        bytes_push(symtab, 1) // n_type (N_EXT | N_UNDF)
        bytes_push(symtab, 0) // n_sect
        push_u16_le(symtab, 0) // n_desc
        push_u64_le(symtab, 0) // n_value
        
        push_u32_le(indsymtab, i_imp)
        
        i_imp = i_imp + 1
    }

    if is_shared {
        var i_exp = 0
        while i_exp < oren_list_len(exports) {
            var f_name = exports[i_exp]
            var f_addr = functions[f_name]
            
            var name_idx_exp = oren_list_len(strtab)
            bytes_push(strtab, 95) // '_'
            var name_bytes_exp = oren_bytes_from_string(f_name)
            var k3 = 0
            while k3 < oren_list_len(name_bytes_exp) {
                 bytes_push(strtab, name_bytes_exp[k3])
                 k3 = k3 + 1
            }
            bytes_push(strtab, 0)
            
            push_u32_le(symtab, name_idx_exp)
            bytes_push(symtab, 15) // N_SECT | N_EXT
            bytes_push(symtab, 1)
            push_u16_le(symtab, 0)
            push_u64_le(symtab, 4294967296 + 2048 + f_addr)
            
            i_exp = i_exp + 1
        }
    }
    
    while int_mod(oren_list_len(code), 4) != 0 { bytes_push(code, 0) }
    
    if functions["main"] == nil {
        if functions["__top_level__"] != nil { functions["main"] = functions["__top_level__"] }
        if functions["main"] == nil {
            if ctx["main_idx"] != nil { functions["main"] = ctx["main_idx"] }
            if functions["main"] == nil {
                if oren_list_len(ctx["function_names"]) > 0 {
                    var fname0 = ctx["function_names"][0]
                    functions["main"] = functions[fname0]
                } else {
                    functions["main"] = 0
                }
            }
        }
    }
    
    var header_size = 2048
    var text_base = 4294967296
    var code_len = oren_list_len(code)
    var text_size = align_up(header_size + code_len, 16384)
    
    // Append debug info
    if debug_mode {
        var debug_blob = emit_debug_info(ctx)
        while int_mod(oren_list_len(data), 8) != 0 { bytes_push(data, 0) }
        var debug_off = oren_list_len(data)
        var bi = 0
        while bi < oren_list_len(debug_blob) {
            bytes_push(data, debug_blob[bi])
            bi = bi + 1
        }
        if ctx["debug_fixup_pos"] != nil {
            oren_list_push(fixups, {"type": "adr_data", "pos": ctx["debug_fixup_pos"], "data_off": debug_off})
            
            var sa = text_base + text_size + debug_off
            var p = ctx["debug_static_addr_pos"]
            set_u32_le(code, p, insn_movz(1, int_mod(sa, 65536)))
            set_u32_le(code, p+4, insn_movk(1, int_mod(sa / 65536, 65536), 1))
            set_u32_le(code, p+8, insn_movk(1, int_mod(sa / 4294967296, 65536), 2))
            set_u32_le(code, p+12, insn_movk(1, int_mod(sa / 281474976710656, 65536), 3))
        }
    }

    var data_len = oren_list_len(data)
    var data_size = align_up(data_len, 16384)
    var data_vmaddr = text_base + text_size
    
    // Apply fixups
    var i = 0
    while i < oren_list_len(fixups) {
        var fix = fixups[i]
        var pos = fix["pos"]
        
        if fix["type"] == "bl" {
            var name = fix["name"]
            var target = functions[name]
            if target == nil {
                print("native backend: undefined function " + name)
                return nil
            }
            var offset = (target - pos) / 4
            set_u32_le(code, pos, insn_bl(offset))
        }
        
        if fix["type"] == "adr_data" {
            var data_off = fix["data_off"]
            var target_addr = data_vmaddr + data_off
            var pc = text_base + header_size + pos
            var offset = target_addr - pc
            var insn = insn_adr(0, offset)
            set_u32_le(code, pos, insn)
        }

        if fix["type"] == "got_load" {
             var got_idx = fix["got_index"]
             var got_entry_addr = data_vmaddr + got_offset + (got_idx * 8)
             var pc = text_base + header_size + pos
             var offset = got_entry_addr - pc
             set_u32_le(code, pos, insn_adr(16, offset))
        }
        
        i = i + 1
    }
    
    // Pad strtab to 16 bytes to ensure CodeSignature alignment
    while int_mod(oren_list_len(strtab), 16) != 0 {
        bytes_push(strtab, 0)
    }
    
    var sig_size = 0
    var symtab_size = oren_list_len(symtab)
    var strtab_size = oren_list_len(strtab)
    var imports_len = oren_list_len(imports)
    
    // Entry point is start of code (startup shim)
    var entry_idx = 0
    var bind_off = text_size + data_size
    
    var prefix = macho_build_prefix_arm64(text_size, data_size, data_len, sig_size, entry_idx, header_size, imports_len, symtab_size, strtab_size, bind_size, bind_off, libs, is_shared, out_path)
    
    bytes_extend(prefix, code)
    while oren_list_len(prefix) < text_size {
        bytes_push(prefix, 0)
    }
    bytes_extend(prefix, data)
    while oren_list_len(prefix) < text_size + data_size {
        bytes_push(prefix, 0)
    }
    
    // LinkEdit content
    bytes_extend(prefix, bind_opcodes)
    bytes_extend(prefix, symtab)
    bytes_extend(prefix, indsymtab)
    bytes_extend(prefix, strtab)
    
    if sig_size > 0 {
        var sig = codesign_adhoc_superblob(prefix, "oren", text_size) 
        bytes_extend(prefix, sig)
    }
    
    var w2 = oren_write_bytes(out_path, prefix)
    if oren_is_err(w2) {
        print("Failed to write output: " + out_path)
        var msg2 = oren_err_msg(w2)
        if msg2 != nil { print(msg2) }
        oren_exit(1)
    }
    oren_chmod(out_path, 493) // 0755
    return nil
}

// --- ELF (Linux) ---

fn elf_build_prefix_arm64(text_size, code, entry_idx) {
    var p = bytes_new()
    
    // ELF Header (64 bytes)
    bytes_push(p, 127); bytes_push(p, 69); bytes_push(p, 76); bytes_push(p, 70); // .ELF
    bytes_push(p, 2); // Class: 64-bit
    bytes_push(p, 1); // Data: Little endian
    bytes_push(p, 1); // Version
    bytes_push(p, 0); // OS ABI: System V
    push_u64_le(p, 0) // Padding
    
    push_u16_le(p, 2) // Type: EXEC
    push_u16_le(p, 183) // Machine: AArch64
    push_u32_le(p, 1) // Version
    var text_file_off = 120 // Ehdr + Phdr size
    push_u64_le(p, 4194304 + text_file_off + entry_idx) // Entry point
    push_u64_le(p, 64) // Phdr offset
    push_u64_le(p, 0) // Shdr offset
    push_u32_le(p, 0) // Flags
    push_u16_le(p, 64) // Ehdr size
    push_u16_le(p, 56) // Phdr size
    push_u16_le(p, 1) // Phdr count
    push_u16_le(p, 64) // Shdr size
    push_u16_le(p, 0) // Shdr count
    push_u16_le(p, 0) // String index
    
    // Program Header (56 bytes)
    push_u32_le(p, 1) // Type: LOAD
    push_u32_le(p, 7) // Flags: RWE (0x1 | 0x2 | 0x4)
    push_u64_le(p, 0) // Offset
    push_u64_le(p, 4194304) // VAddr (0x400000)
    push_u64_le(p, 4194304) // PAddr
    push_u64_le(p, text_file_off + oren_list_len(code)) // FileSize
    push_u64_le(p, text_file_off + oren_list_len(code)) // MemSize
    push_u64_le(p, 65536) // Align
    
    return p
}

fn push_u16_le(buf, n) {
    bytes_push(buf, int_mod(n, 256))
    bytes_push(buf, int_mod(n / 256, 256))
}

fn elf_emit_program_arm64(out_path, linked, libs, is_shared, exports, debug_mode) {
    var ctx = native_compile_program_arm64(linked, {"os": "linux"})
    if ctx == nil { return nil }
    
    var code = ctx["code"]
    var data = ctx["data"]
    var fixups = ctx["fixups"]
    var functions = ctx["functions"]
    
    // Generate Stubs for Imports (Placeholder)
    var imports = ctx["import_list"]
    var i_imp = 0
    while i_imp < oren_list_len(imports) {
        var name = imports[i_imp]
        var stub_pos = oren_list_len(code)
        functions[name] = stub_pos
        
        // Stub: return 0 (avoid syscalls on missing FFI)
        push_u32_le(code, insn_movz(0, 0))
        push_u32_le(code, insn_ret())
        
        i_imp = i_imp + 1
    }
    
    var code_len_before_data = oren_list_len(code)
    bytes_extend(code, data)
    
    if functions["main"] == nil {
        if functions["__top_level__"] != nil { functions["main"] = functions["__top_level__"] }
        if functions["main"] == nil {
            if ctx["main_idx"] != nil { functions["main"] = ctx["main_idx"] }
            if functions["main"] == nil {
                if oren_list_len(ctx["function_names"]) > 0 {
                    var fname0 = ctx["function_names"][0]
                    functions["main"] = functions[fname0]
                } else {
                    functions["main"] = 0
                }
            }
        }
    }
    
    var i = 0
    while i < oren_list_len(fixups) {
        var fix = fixups[i]
        var pos = fix["pos"]
        
        if fix["type"] == "bl" {
            var name = fix["name"]
            var target = functions[name]
            if target == nil {
                print("native backend: undefined function " + name)
                return nil
            }
            var offset = (target - pos) / 4
            set_u32_le(code, pos, insn_bl(offset))
        }
        
        if fix["type"] == "adr_data" {
            var data_off = fix["data_off"]
            var target_idx = code_len_before_data + data_off
            var offset = target_idx - pos
            var insn = insn_adr(0, offset)
            set_u32_le(code, pos, insn)
        }
        
        // Legacy
        if fix["type"] == nil {
            var data_off2 = fix["data_off"]
            var target_idx2 = code_len_before_data + data_off2
            var offset2 = target_idx2 - pos
            set_u32_le(code, pos, insn_adr(1, offset2))
        }
        i = i + 1
    }
    
    var text_size = 120 + oren_list_len(code)
    // Entry point is start of code (startup shim)
    var entry_idx = 0
    var prefix = elf_build_prefix_arm64(text_size, code, entry_idx)
    bytes_extend(prefix, code)
    
    var w3 = oren_write_bytes(out_path, prefix)
    if oren_is_err(w3) {
        print("Failed to write output: " + out_path)
        var msg3 = oren_err_msg(w3)
        if msg3 != nil { print(msg3) }
        oren_exit(1)
    }
    oren_chmod(out_path, 493) // 0755
    return nil
}

// --- Codesigning (Ad-Hoc) ---

fn codesign_adhoc_superblob(code_bytes, ident, exec_seg_limit) {
    var code_limit = oren_list_len(code_bytes)
    var page_size = 4096
    var n_code_slots = ceil_div(code_limit, page_size)

    var ident_bytes = oren_bytes_from_string(ident)
    var ident_len = oren_list_len(ident_bytes) + 1
    // CodeDirectory header is 44 bytes. 
    // Data follows immediately if no special slots.
    var ident_offset = 44
    var hash_offset = ident_offset + ident_len
    var hash_size = 32
    var code_dir_len = hash_offset + hash_size * n_code_slots

    // SuperBlob length excludes padding; file region is padded to 8 bytes.
    var super_len = 12 + 8 + code_dir_len
    var sig_size = align_up(super_len, 8)

    // Hash pages of the "code" region [0..code_limit).
    var hashes = bytes_new()
    var i = 0
    while i < n_code_slots {
        var start = i * page_size
        var remaining = code_limit - start
        var n = page_size
        if remaining < page_size { n = remaining }
        // Use runtime intrinsic
        var digest = oren_sha256_range(code_bytes, start, n)
        bytes_extend(hashes, digest)
        i = i + 1
    }

    // CodeDirectory (big-endian fields)
    var cd = bytes_new()
    push_u32_be(cd, 4208856066) // magic
    push_u32_be(cd, code_dir_len) // length
    push_u32_be(cd, 131328) // version 0x20100
    push_u32_be(cd, 131074) // flags (0x20002 = kSecCodeSignatureAdhoc | kSecCodeSignatureLinkerSigned)
    push_u32_be(cd, hash_offset) // hashOffset
    push_u32_be(cd, ident_offset) // identOffset
    push_u32_be(cd, 0) // nSpecialSlots
    push_u32_be(cd, n_code_slots) // nCodeSlots
    push_u32_be(cd, code_limit) // codeLimit
    push_u8(cd, 32) // hashSize (SHA-256)
    push_u8(cd, 2) // hashType (SHA-256)
    push_u8(cd, 0) // platform
    push_u8(cd, 12) // pageSize (log2 4096 = 12)
    push_u32_be(cd, 0) // spare2
    
    // Ident
    bytes_extend(cd, ident_bytes)
    bytes_push(cd, 0) // null
    
    // Hashes
    bytes_extend(cd, hashes)
    
    // SuperBlob
    var sb = bytes_new()
    push_u32_be(sb, 4208855872) // magic (0xfade0cc0)
    push_u32_be(sb, sig_size) // length (aligned)
    push_u32_be(sb, 1) // count
    push_u32_be(sb, 0) // type (0 = CodeDirectory)
    push_u32_be(sb, 20) // offset (sizeof header 12 + 8 = 20)
    bytes_extend(sb, cd)
    
    // Pad to sig_size (8 byte alignment)
    while oren_list_len(sb) < sig_size {
        bytes_push(sb, 0)
    }
    
    return sb
}

fn push_u8(buf, n) {
    bytes_push(buf, int_mod(n, 256))
}
