// Thin facade module for legacy imports.
//
// The arm64 native backend was historically implemented in one large file.
// To keep SOLID boundaries while avoiding a broad rewrite, we split it into:
// - arm64_core.oren: generic byte utils, scope helpers, instruction encodings, emit helpers
// - arm64_native_expr.oren: expression lowering
// - arm64_native_stmt.oren: statement lowering
// - arm64_native_program.oren: top-level program lowering (entry stub + runtime init + symbol table)
//
// Keep this facade stable so other modules (Mach-O/ELF emitters) can import a small surface.

import core "arm64_core.oren"
import prog "arm64_native_program.oren"

// Binary utils
fn bytes_new() { return core.bytes_new() }
fn bytes_push(b, v) { return core.bytes_push(b, v) }
fn bytes_extend(b, other) { return core.bytes_extend(b, other) }
fn bytes_extend_zeros(b, n) { return core.bytes_extend_zeros(b, n) }
fn bytes_extend_list(b, xs) { return core.bytes_extend_list(b, xs) }
fn bytes_len(b) { return core.bytes_len(b) }
fn bytes_finalize(b) { return core.bytes_finalize(b) }

fn push_u32_le(buf, n) { return core.push_u32_le(buf, n) }
fn push_u64_le(buf, n) { return core.push_u64_le(buf, n) }
fn push_u32_be(buf, n) { return core.push_u32_be(buf, n) }
fn set_u32_le(buf, offset, n) { return core.set_u32_le(buf, offset, n) }

fn align_up(n, align) { return core.align_up(n, align) }
fn ceil_div(a, b) { return core.ceil_div(a, b) }
fn int_mod(a, b) { return core.int_mod(a, b) }

// Instruction encodings used by emitters
fn insn_movz(reg, imm16) { return core.insn_movz(reg, imm16) }
fn insn_movk(reg, imm16, shift_idx) { return core.insn_movk(reg, imm16, shift_idx) }
fn insn_bl(off) { return core.insn_bl(off) }
fn insn_adr(reg, imm) { return core.insn_adr(reg, imm) }
fn insn_adrp(reg, imm_pages) { return core.insn_adrp(reg, imm_pages) }
fn insn_add_imm(rd, rn, imm) { return core.insn_add_imm(rd, rn, imm) }
fn insn_ret() { return core.insn_ret() }

// Top-level compilation entry
fn native_compile_program_arm64(linked, platform) { return prog.native_compile_program_arm64(linked, platform) }
fn native_emit_errors_and_exit(ctx) { return prog.native_emit_errors_and_exit(ctx) }
