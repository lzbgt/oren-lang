            push_u32_le(ctx["code"], insn_mov_reg(0, 9))
            push_u32_le(ctx["code"], insn_movz(3, 0))
            push_u32_le(ctx["code"], insn_movk(3, 1, 1)) // X3 = 0x10000
            push_u32_le(ctx["code"], insn_cmp_reg(0, 3))
            var jump_use_chunk = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // B.LT use_chunk
            // use size
            push_u32_le(ctx["code"], insn_mov_reg(3, 0))
            var jump_choose_end = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0) // B choose_end
