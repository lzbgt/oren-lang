                push_u32_le(ctx["code"], insn_ldrsw(14, 8, 0))
                push_u32_le(ctx["code"], insn_add_imm(8, 8, 4))

                // Load b0..b3 (sign-extend i32) and advance pointers.
                push_u32_le(ctx["code"], insn_ldrsw(15, 4, 0))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 4))
                push_u32_le(ctx["code"], insn_ldrsw(17, 3, 0))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 4))
                // Darwin AArch64 reserves X18 as a platform register (thread/TLS).
                // Never clobber it in generated code or FFI into system frameworks (malloc/CF) can break.
                push_u32_le(ctx["code"], insn_ldrsw(22, 2, 0))
                push_u32_le(ctx["code"], insn_add_imm(2, 2, 4))
                push_u32_le(ctx["code"], insn_ldrsw(19, 1, 0))
                push_u32_le(ctx["code"], insn_add_imm(1, 1, 4))

                // Reset cursor to out_ptr for this k.
                push_u32_le(ctx["code"], insn_mov_reg(16, 9))

                // Update 16 outputs: out += a_r * b_c
                //
                // Use X20 as product temp, X21 as sum temp.
                var rr2 = 0
                while rr2 < 4 {
                    var a_reg = 11
                    if rr2 == 1 { a_reg = 12 }
                    if rr2 == 2 { a_reg = 13 }
                    if rr2 == 3 { a_reg = 14 }
                    var cc2 = 0
                    while cc2 < 4 {
                        var b_reg = 15
                        if cc2 == 1 { b_reg = 17 }
                        if cc2 == 2 { b_reg = 22 }
                        if cc2 == 3 { b_reg = 19 }
                        push_u32_le(ctx["code"], insn_ldr_ptr(21, 16))     // load current out
                        push_u32_le(ctx["code"], insn_mul(20, a_reg, b_reg))
                        push_u32_le(ctx["code"], insn_add_reg(21, 21, 20))
                        push_u32_le(ctx["code"], insn_str_ptr(21, 16))
                        if rr2 != 3 || cc2 != 3 {
                            push_u32_le(ctx["code"], insn_add_imm(16, 16, 8))
                        }
                        cc2 = cc2 + 1
                    }
                    rr2 = rr2 + 1
                }

                // rem--
                push_u32_le(ctx["code"], insn_sub_imm(10, 10, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(10, 31))
                var br_tail_gemm_i = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                var done_pos_gemm_i = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_done_gemm_i, insn_b_cond((done_pos_gemm_i - br_done_gemm_i) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_tail_gemm_i, insn_b_cond((tail_loop_gemm_i - br_tail_gemm_i) / 4, 1)) // NE

                return true
            }

    return false
}
