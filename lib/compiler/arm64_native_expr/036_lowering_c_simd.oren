                    push_u32_le(ctx["code"], insn_cmp_reg(25, 21))
                    var jpos_dot_pair_tail = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    _arm64_expr_emit_slot_direct_gc_tick(ctx, dot_tick_mask, dot_fast_tick, [[19, 20], [21, 22], [23, 24]])
                    push_u32_le(ctx["code"], insn_ldp_pair_post(25, 26, 19, 16))
                    push_u32_le(ctx["code"], insn_ldp_pair_post(11, 12, 20, 16))
                    push_u32_le(ctx["code"], insn_madd(23, 25, 11, 23))
                    push_u32_le(ctx["code"], insn_madd(22, 26, 12, 22))
                    push_u32_le(ctx["code"], insn_add_imm(24, 24, 2))
                    var dot_pair_back = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], insn_b((dot_pair_cond - dot_pair_back) / 4))

                    var dot_tail_cond = bytes_len(ctx["code"])
                    set_u32_le(ctx["code"], jpos_dot_pair_tail, insn_b_cond((dot_tail_cond - jpos_dot_pair_tail) / 4, 10)) // GE
                    push_u32_le(ctx["code"], insn_cmp_reg(24, 21))
                    var jpos_dot_pair_end = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    _arm64_expr_emit_slot_direct_gc_tick(ctx, dot_tick_mask, dot_fast_tick, [[19, 20], [21, 22], [23, 24]])
                    push_u32_le(ctx["code"], insn_ldr_ptr(25, 19))
                    push_u32_le(ctx["code"], insn_ldr_ptr(26, 20))
                    push_u32_le(ctx["code"], insn_madd(23, 25, 26, 23))

                    var dot_pair_end = bytes_len(ctx["code"])
                    set_u32_le(ctx["code"], jpos_dot_pair_end, insn_b_cond((dot_pair_end - jpos_dot_pair_end) / 4, 10)) // GE
                    push_u32_le(ctx["code"], insn_add_reg(23, 23, 22))
                    push_u32_le(ctx["code"], insn_mov_reg(0, 23))

                    var dot_pair_done = bytes_len(ctx["code"])
                    set_u32_le(ctx["code"], br_dot_done, insn_b((dot_pair_done - br_dot_done) / 4))
