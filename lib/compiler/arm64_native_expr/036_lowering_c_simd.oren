                var dot_a_non_nil_pos = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_dot_a_non_nil, insn_b_cond((dot_a_non_nil_pos - br_dot_a_non_nil) / 4, 1)) // NE
                push_u32_le(ctx["code"], insn_cmp_reg(20, 31))
                var br_dot_b_non_nil = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_int_dot_slots_unchecked: length mismatch")
                var dot_b_non_nil_pos = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_dot_b_non_nil, insn_b_cond((dot_b_non_nil_pos - br_dot_b_non_nil) / 4, 1)) // NE

