                _arm64_expr_emit_slot_direct_gc_tick_init(ctx, dot_tick_mask)

                if dot_pair_loop == true {
                    push_u32_le(ctx["code"], insn_movz(22, 0)) // X22 = secondary accumulator
                    var dot_pair_cond = bytes_len(ctx["code"])
