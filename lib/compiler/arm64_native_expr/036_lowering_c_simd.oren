                emit_load_ptr_from_base_plus(ctx, 19, 19, 16) // X19 = pa
                emit_load_ptr_from_base_plus(ctx, 20, 20, 16) // X20 = pb
                push_u32_le(ctx["code"], insn_movz(23, 0)) // X23 = sum
                push_u32_le(ctx["code"], insn_movz(24, 0)) // X24 = i
                var dot_fast_tick = _arm64_expr_env_enabled_default_false("OREN_ARM64_LIST_INT_SLOT_DIRECT_FAST_TICK")
                var dot_pair_loop = _arm64_expr_env_enabled_default_false("OREN_ARM64_LIST_INT_SLOT_DIRECT_PAIR_LOOP")
