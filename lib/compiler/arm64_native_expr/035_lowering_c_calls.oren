                emit_load_i64_imm(ctx, 1, 8)
                var bl_find_node_s = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find_node_s, "name": "_list_find_node_known_kind"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find_node_s)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -12)

                // node == 0 => panic
                push_u32_le(ctx["code"], insn_movz(2, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
                var br_node_nonzero_s = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_int_set on non-list")
                var node_ok_pos_s = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_node_nonzero_s, insn_b_cond((node_ok_pos_s - br_node_nonzero_s) / 4, 1)) // NE

                // kind = *(node + 16); require kind==LIST_INT
                emit_load_ptr_from_base_plus(ctx, 2, 0, 16) // X2 = kind
                emit_load_i64_imm(ctx, 3, 8)               // X3 = LIST_INT
                push_u32_le(ctx["code"], insn_cmp_reg(2, 3))
                var br_kind_ok_s = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_int_set on non-list")
                var kind_ok_pos_s = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_kind_ok_s, insn_b_cond((kind_ok_pos_s - br_kind_ok_s) / 4, 0)) // EQ

                // Restore list pointer and validate magic.
                push_u32_le(ctx["code"], insn_mov_reg(0, 19))
                emit_load_ptr_from_base_plus(ctx, 1, 0, 24)   // X1 = magic
                emit_load_i64_imm(ctx, 2, 1279870019)         // X2 = 'LIST'
                push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
                var br_is_list_s = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_int_set on non-list")
                var is_list_pos_s = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_is_list_s, insn_b_cond((is_list_pos_s - br_is_list_s) / 4, 0)) // EQ

                // Validate value is int (no tracked pointer / no nil/bool).
                push_u32_le(ctx["code"], insn_mov_reg(0, 21)) // X0 = value
                var bl_check_val_s = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_check_val_s, "name": "_list_int_check_value"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_check_val_s)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], "_list_int_check_value")

                // Restore list/value after check.
                push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // X0 = list

                // count = *(list + 0)
                emit_load_ptr_from_base_plus(ctx, 3, 0, 0)   // X3 = count

                // idx < 0 => panic
                push_u32_le(ctx["code"], insn_movz(4, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(20, 4))
                var br_idx_nonneg_s = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "Index out of bounds (negative)")
                var idx_nonneg_pos_s = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_idx_nonneg_s, insn_b_cond((idx_nonneg_pos_s - br_idx_nonneg_s) / 4, 10)) // GE

                // idx < count => fast path
                push_u32_le(ctx["code"], insn_cmp_reg(20, 3))
                var br_fast_s = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                // Slow path: call runtime oren_list_int_set(list, idx, value)
                push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // X0 = list
                push_u32_le(ctx["code"], insn_mov_reg(1, 20)) // X1 = idx
                push_u32_le(ctx["code"], insn_mov_reg(2, 21)) // X2 = value
                var bl_set_s = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_set_s, "name": "oren_list_int_set"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_set_s)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_list_int_set")
                var br_done_s = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                // Fast path: store into buf + idx*8 and return value.
                var fast_pos_s = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_fast_s, insn_b_cond((fast_pos_s - br_fast_s) / 4, 11)) // LT

                emit_load_ptr_from_base_plus(ctx, 4, 0, 16) // X4 = buf
                emit_load_i64_imm(ctx, 5, 8)
                push_u32_le(ctx["code"], insn_mul(6, 20, 5))     // X6 = idx*8
                push_u32_le(ctx["code"], insn_add_reg(6, 4, 6))  // X6 = buf + off
                push_u32_le(ctx["code"], insn_str_ptr(21, 6))    // *(addr) = value
                push_u32_le(ctx["code"], insn_mov_reg(0, 21))    // return value

                var done_pos_s = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_done_s, insn_b((done_pos_s - br_done_s) / 4))
                return true
            }

    return false
}
