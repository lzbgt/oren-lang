// Chunked out of native_compile_expr call handling for include coherence.
fn native_call_chunk_040_lowering_d(ctx, fn_name, expr, args) {

            if fn_name == "simd_dot_f32_ptr" {
                // Intrinsic: dot product over raw f32 pointers, returning f64 bits.
                // Signature: simd_dot_f32_ptr(a_ptr, b_ptr, n) -> f64bits
                //
                // Determinism rule (matches docs/AVM_NEON_MAPPING_PLAN.md intent):
                // - multiply in f64 (widen f32->f64) and accumulate in *scalar* f64 in the same element order
                //   as the scalar loop (no reassociation).
                var args6 = expr["args"]
                if args6 == nil || oren_list_len(args6) != 3 {
                    native_error(ctx, expr["token"], "native backend: simd_dot_f32_ptr expects 3 arguments")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
    
                // Compile args: a_ptr, b_ptr, n
                native_compile_expr(ctx, args6[0]) // a_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args6[1]) // b_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args6[2]) // n -> X0
    
                // Pop b_ptr -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop a_ptr -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // X3 = a_ptr, X4 = b_ptr, X2 = n
                push_u32_le(ctx["code"], insn_mov_reg(3, 2))
                push_u32_le(ctx["code"], insn_mov_reg(4, 1))
                push_u32_le(ctx["code"], insn_mov_reg(2, 0))
    
                // Accumulator D6 = 0.0 (do not use V0 because we load Q0/Q1 in the loop).
                push_u32_le(ctx["code"], insn_movz(0, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(6, 0))
    
                // Reserve 32 bytes stack scratch for 4 f64 products.
                push_u32_le(ctx["code"], insn_sub_sp(32))
                ctx["stack_size"] = ctx["stack_size"] + 32
    
                // X5 = n / 4 (vector groups of 4 f32s)
                push_u32_le(ctx["code"], insn_mov_reg(5, 2))
                push_u32_le(ctx["code"], insn_movz(6, 2))       // X6 = 2
                push_u32_le(ctx["code"], insn_lsrv(5, 5, 6))     // X5 = X5 >> 2
                push_u32_le(ctx["code"], insn_mov_reg(7, 5))     // X7 = groups saved
    
                // If groups == 0, skip vector loop.
                push_u32_le(ctx["code"], insn_cmp_reg(5, 31))
                var br_skip_vecf = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_loopf = bytes_len(ctx["code"])
                // Load 4 f32 lanes from each pointer.
                push_u32_le(ctx["code"], insn_ldr_q(0, 3))
                push_u32_le(ctx["code"], insn_ldr_q(1, 4))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 16))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 16))
    
                // Widen to f64:
                //   v2/v3 = a low/high lanes
                //   v4/v5 = b low/high lanes
                push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(2, 0))
                push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(3, 0))
                push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(4, 1))
                push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(5, 1))
    
                // Multiply in f64 vectors (products are exact for f32 inputs).
                push_u32_le(ctx["code"], insn_fmul_2d(2, 2, 4))
                push_u32_le(ctx["code"], insn_fmul_2d(3, 3, 5))
    
                // Store products to stack scratch (SP-relative) and accumulate in scalar order.
                push_u32_le(ctx["code"], insn_str_q_off(2, 31, 0))
                push_u32_le(ctx["code"], insn_str_q_off(3, 31, 16))
    
                // p0, p1, p2, p3 sequential:
                //   X9 <- *(u64*)(sp+off); D1 <- bits(X9); D0 += D1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 9))
                push_u32_le(ctx["code"], insn_fadd(6, 6, 1))
    
                push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 9))
                push_u32_le(ctx["code"], insn_fadd(6, 6, 1))
    
                push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 9))
                push_u32_le(ctx["code"], insn_fadd(6, 6, 1))
    
                push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 9))
                push_u32_le(ctx["code"], insn_fadd(6, 6, 1))
    
                // groups--
                push_u32_le(ctx["code"], insn_sub_imm(5, 5, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(5, 31))
                var br_vec_loopf = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_endf = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_skip_vecf, insn_b_cond((vec_endf - br_skip_vecf) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_vec_loopf, insn_b_cond((vec_loopf - br_vec_loopf) / 4, 1)) // NE
    
                // rem = n - (groups_saved * 4)
                //
                // NOTE: compute `groups_saved * 4` via adds rather than `LSLV`:
                // this keeps tail handling robust even if the variable-shift encoding
                // changes or is mis-encoded for our purposes (rolling native backend).
                push_u32_le(ctx["code"], insn_add_reg(7, 7, 7))   // X7 *= 2
                push_u32_le(ctx["code"], insn_add_reg(7, 7, 7))   // X7 *= 4
                push_u32_le(ctx["code"], insn_sub_reg(2, 2, 7))   // X2 = rem
    
                // Tail loop (scalar, exact):
                push_u32_le(ctx["code"], insn_cmp_reg(2, 31))
                var br_donef = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var tail_loopf = bytes_len(ctx["code"])
                // Load a bits -> S1 -> D1
                push_u32_le(ctx["code"], insn_ldr_w(9, 3, 0))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(1, 9))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(1, 1))
    
                // Load b bits -> S2 -> D2
                push_u32_le(ctx["code"], insn_ldr_w(10, 4, 0))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(2, 10))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(2, 2))
    
                // D1 *= D2; D6 += D1
                push_u32_le(ctx["code"], insn_fmul(1, 1, 2))
                push_u32_le(ctx["code"], insn_fadd(6, 6, 1))
    
                push_u32_le(ctx["code"], insn_sub_imm(2, 2, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(2, 31))
                var br_tailf = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var done_posf = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_donef, insn_b_cond((done_posf - br_donef) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_tailf, insn_b_cond((tail_loopf - br_tailf) / 4, 1)) // NE
    
                // Pop scratch and return f64 bits: D6 -> X0
                push_u32_le(ctx["code"], insn_add_sp(32))
                ctx["stack_size"] = ctx["stack_size"] - 32
                push_u32_le(ctx["code"], insn_umov_x_d(0, 6))
                return true
            }

            if fn_name == "simd_dot_f32_4_ptr" {
                // Intrinsic: 1x4 f32 dot microkernel over raw pointers, writing 4 f64 results to out_ptr.
                // Signature: simd_dot_f32_4_ptr(out_ptr, a_ptr, b0_ptr, b1_ptr, b2_ptr, b3_ptr, n) -> out_ptr
                //
                // Determinism rule:
                // - widen f32 -> f64, multiply in f64
                // - accumulate in scalar order matching the scalar loop (no reassociation)
                var args7 = expr["args"]
                if args7 == nil || oren_list_len(args7) != 7 {
                    native_error(ctx, expr["token"], "native backend: simd_dot_f32_4_ptr expects 7 arguments")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
    
                // Compile args: out_ptr, a_ptr, b0_ptr, b1_ptr, b2_ptr, b3_ptr, n
                //
                // We stack-save pointers so we can evaluate expressions left-to-right safely.
                native_compile_expr(ctx, args7[0]) // out_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[1]) // a_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[2]) // b0_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[3]) // b1_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[4]) // b2_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[5]) // b3_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[6]) // n -> X0
    
                // Pop b3_ptr -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop b2_ptr -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop b1_ptr -> X3
                push_u32_le(ctx["code"], insn_ldr_reg_sp(3, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop b0_ptr -> X4
                push_u32_le(ctx["code"], insn_ldr_reg_sp(4, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop a_ptr -> X5
                push_u32_le(ctx["code"], insn_ldr_reg_sp(5, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop out_ptr -> X6
                push_u32_le(ctx["code"], insn_ldr_reg_sp(6, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Preserve inputs:
                // - X7 = n (compiled into X0)
                // - X0 = out_ptr (return value)
                push_u32_le(ctx["code"], insn_mov_reg(7, 0)) // X7 = n
                push_u32_le(ctx["code"], insn_mov_reg(0, 6)) // X0 = out_ptr
    
                // Registers:
                // - X7 = n (working), X8 = groups (n>>2), X9 = shift(2), X10 = groups_saved
                // - X11.. used as temps for scalar loads/stores
                // - X5 = a_ptr, X4=b0, X3=b1, X2=b2, X1=b3, X6=out_ptr
                push_u32_le(ctx["code"], insn_mov_reg(8, 7))  // X8 = n
                push_u32_le(ctx["code"], insn_movz(9, 2))     // X9 = 2
                push_u32_le(ctx["code"], insn_lsrv(8, 8, 9))  // X8 = groups = n>>2
                push_u32_le(ctx["code"], insn_mov_reg(10, 8)) // X10 = groups_saved
    
                // Accumulators: D12..D15 = 0.0
                push_u32_le(ctx["code"], insn_movz(0, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(12, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(13, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(14, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(15, 0))
    
                // Reserve 32-byte stack scratch for 4 f64 products (2 q regs).
                push_u32_le(ctx["code"], insn_sub_sp(32))
                ctx["stack_size"] = ctx["stack_size"] + 32
    
                // If groups == 0, skip vector loop.
                push_u32_le(ctx["code"], insn_cmp_reg(8, 31))
                var br_skip_vec4 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_loop4 = bytes_len(ctx["code"])
                // Load A lanes (Q0) and widen A -> V2/V3 (f64 vectors).
                push_u32_le(ctx["code"], insn_ldr_q(0, 5))
                push_u32_le(ctx["code"], insn_add_imm(5, 5, 16)) // a_ptr += 16
                push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(2, 0))
                push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(3, 0))
    
                // Helper macro (inlined): accumulate one column pointed by Xn_ptr into Dacc (Vd).
                // Column 0: b0 (X4) into D12
                push_u32_le(ctx["code"], insn_ldr_q(1, 4))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 16))
                push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(4, 1))
                push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(5, 1))
                push_u32_le(ctx["code"], insn_fmul_2d(4, 2, 4))
                push_u32_le(ctx["code"], insn_fmul_2d(5, 3, 5))
                push_u32_le(ctx["code"], insn_str_q_off(4, 31, 0))
                push_u32_le(ctx["code"], insn_str_q_off(5, 31, 16))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(12, 12, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(12, 12, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(12, 12, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(12, 12, 1))
    
                // Column 1: b1 (X3) into D13
                push_u32_le(ctx["code"], insn_ldr_q(1, 3))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 16))
                push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(4, 1))
                push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(5, 1))
                push_u32_le(ctx["code"], insn_fmul_2d(4, 2, 4))
                push_u32_le(ctx["code"], insn_fmul_2d(5, 3, 5))
                push_u32_le(ctx["code"], insn_str_q_off(4, 31, 0))
                push_u32_le(ctx["code"], insn_str_q_off(5, 31, 16))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(13, 13, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(13, 13, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(13, 13, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(13, 13, 1))
    
                // Column 2: b2 (X2) into D14
                push_u32_le(ctx["code"], insn_ldr_q(1, 2))
                push_u32_le(ctx["code"], insn_add_imm(2, 2, 16))
                push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(4, 1))
                push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(5, 1))
                push_u32_le(ctx["code"], insn_fmul_2d(4, 2, 4))
                push_u32_le(ctx["code"], insn_fmul_2d(5, 3, 5))
                push_u32_le(ctx["code"], insn_str_q_off(4, 31, 0))
                push_u32_le(ctx["code"], insn_str_q_off(5, 31, 16))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(14, 14, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(14, 14, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(14, 14, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(14, 14, 1))
    
                // Column 3: b3 (X1) into D15
                push_u32_le(ctx["code"], insn_ldr_q(1, 1))
                push_u32_le(ctx["code"], insn_add_imm(1, 1, 16))
                push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(4, 1))
                push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(5, 1))
                push_u32_le(ctx["code"], insn_fmul_2d(4, 2, 4))
                push_u32_le(ctx["code"], insn_fmul_2d(5, 3, 5))
                push_u32_le(ctx["code"], insn_str_q_off(4, 31, 0))
                push_u32_le(ctx["code"], insn_str_q_off(5, 31, 16))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(15, 15, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(15, 15, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(15, 15, 1))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 11))
                push_u32_le(ctx["code"], insn_fadd(15, 15, 1))
    
                // groups--
                push_u32_le(ctx["code"], insn_sub_imm(8, 8, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(8, 31))
                var br_vec_loop4b = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_end4 = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_skip_vec4, insn_b_cond((vec_end4 - br_skip_vec4) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_vec_loop4b, insn_b_cond((vec_loop4 - br_vec_loop4b) / 4, 1)) // NE
    
                // rem = n - (groups_saved * 4)
                //
                // Rolling note: compute `groups_saved * 4` via add-doubling rather than `LSLV`
                // to keep tail handling robust if variable-shift encoding changes.
                push_u32_le(ctx["code"], insn_add_reg(10, 10, 10)) // X10 *= 2
                push_u32_le(ctx["code"], insn_add_reg(10, 10, 10)) // X10 *= 4
                push_u32_le(ctx["code"], insn_sub_reg(7, 7, 10))   // X7 = rem
    
                // Tail loop if rem != 0.
                push_u32_le(ctx["code"], insn_cmp_reg(7, 31))
                var br_done4 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var tail_loop4 = bytes_len(ctx["code"])
                // Load a f32 -> D1
                push_u32_le(ctx["code"], insn_ldr_w(11, 5, 0))
                push_u32_le(ctx["code"], insn_add_imm(5, 5, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(1, 11))
