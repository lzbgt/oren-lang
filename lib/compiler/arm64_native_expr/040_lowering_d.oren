            push_u32_le(ctx["code"], insn_fmov_d_x(6, 11))
            push_u32_le(ctx["code"], insn_fmov_d_x(7, 11))
            push_u32_le(ctx["code"], insn_fmov_d_x(8, 11))
            push_u32_le(ctx["code"], insn_fmov_d_x(9, 11))
            push_u32_le(ctx["code"], insn_fmov_d_x(10, 11))
            push_u32_le(ctx["code"], insn_fmov_d_x(11, 11))
            push_u32_le(ctx["code"], insn_fmov_d_x(12, 11))
            push_u32_le(ctx["code"], insn_fmov_d_x(13, 11))
            push_u32_le(ctx["code"], insn_fmov_d_x(14, 11))
            push_u32_le(ctx["code"], insn_fmov_d_x(15, 11))

            // Reserve 32-byte scratch for 4 f64 products (2 q regs).
            push_u32_le(ctx["code"], insn_sub_sp(32))
            ctx["stack_size"] = ctx["stack_size"] + 32

            // If groups == 0, skip vector loop.
            push_u32_le(ctx["code"], insn_cmp_reg(13, 31))
            var br_skip_vec_gemm = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)

            var vec_loop_gemm = oren_list_len(ctx["code"])

            // Load B vectors once and widen to f64:
            //   B0 -> V16/V17, B1 -> V18/V19, B2 -> V20/V21, B3 -> V22/V23
            //
            // IMPORTANT: do not clobber V0..V15 because we keep accumulators in D0..D15.
            // Use V28 as the temporary f32 load register.
            push_u32_le(ctx["code"], insn_ldr_q(28, 4))
            push_u32_le(ctx["code"], insn_add_imm(4, 4, 16))
            push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(16, 28))
            push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(17, 28))

            push_u32_le(ctx["code"], insn_ldr_q(28, 3))
            push_u32_le(ctx["code"], insn_add_imm(3, 3, 16))
            push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(18, 28))
            push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(19, 28))

            push_u32_le(ctx["code"], insn_ldr_q(28, 2))
            push_u32_le(ctx["code"], insn_add_imm(2, 2, 16))
            push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(20, 28))
            push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(21, 28))

            push_u32_le(ctx["code"], insn_ldr_q(28, 1))
            push_u32_le(ctx["code"], insn_add_imm(1, 1, 16))
            push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(22, 28))
            push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(23, 28))

            // Helper macro (inlined) for one row: load A, widen to V24/V25, then update 4 columns.
            //
            // Row 0 (a0_ptr in X5) -> accumulators D0..D3
            // Use V29 as the temporary f32 load register for A rows.
            push_u32_le(ctx["code"], insn_ldr_q(29, 5))
            push_u32_le(ctx["code"], insn_add_imm(5, 5, 16))
            push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(24, 29))
            push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(25, 29))

            // col0: (V24/V25) * (V16/V17) -> D0
            push_u32_le(ctx["code"], insn_fmul_2d(26, 24, 16))
            push_u32_le(ctx["code"], insn_fmul_2d(27, 25, 17))
            push_u32_le(ctx["code"], insn_str_q_off(26, 31, 0))
            push_u32_le(ctx["code"], insn_str_q_off(27, 31, 16))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 0))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(0, 0, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(0, 0, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(0, 0, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 24))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(0, 0, 28))

            // col1 -> D1
            push_u32_le(ctx["code"], insn_fmul_2d(26, 24, 18))
            push_u32_le(ctx["code"], insn_fmul_2d(27, 25, 19))
            push_u32_le(ctx["code"], insn_str_q_off(26, 31, 0))
            push_u32_le(ctx["code"], insn_str_q_off(27, 31, 16))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 0))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(1, 1, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(1, 1, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(1, 1, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 24))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(1, 1, 28))

            // col2 -> D2
            push_u32_le(ctx["code"], insn_fmul_2d(26, 24, 20))
            push_u32_le(ctx["code"], insn_fmul_2d(27, 25, 21))
            push_u32_le(ctx["code"], insn_str_q_off(26, 31, 0))
            push_u32_le(ctx["code"], insn_str_q_off(27, 31, 16))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 0))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(2, 2, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(2, 2, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(2, 2, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 24))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(2, 2, 28))

            // col3 -> D3
            push_u32_le(ctx["code"], insn_fmul_2d(26, 24, 22))
            push_u32_le(ctx["code"], insn_fmul_2d(27, 25, 23))
            push_u32_le(ctx["code"], insn_str_q_off(26, 31, 0))
            push_u32_le(ctx["code"], insn_str_q_off(27, 31, 16))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 0))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(3, 3, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(3, 3, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(3, 3, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 24))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(3, 3, 28))

            // Row 1 (a1_ptr in X6) -> D4..D7
            push_u32_le(ctx["code"], insn_ldr_q(29, 6))
            push_u32_le(ctx["code"], insn_add_imm(6, 6, 16))
            push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(24, 29))
            push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(25, 29))

            // col0 -> D4
            push_u32_le(ctx["code"], insn_fmul_2d(26, 24, 16))
            push_u32_le(ctx["code"], insn_fmul_2d(27, 25, 17))
            push_u32_le(ctx["code"], insn_str_q_off(26, 31, 0))
            push_u32_le(ctx["code"], insn_str_q_off(27, 31, 16))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 0))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(4, 4, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(4, 4, 28))
            push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
            push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
            push_u32_le(ctx["code"], insn_fadd(4, 4, 28))
