                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
                push_u32_le(ctx["code"], insn_fadd(11, 11, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
                push_u32_le(ctx["code"], insn_fadd(11, 11, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(11, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
                push_u32_le(ctx["code"], insn_fadd(11, 11, 28))
    
                // Row 3 (a3_ptr in X8) -> D12..D15
                push_u32_le(ctx["code"], insn_ldr_q(29, 8))
                push_u32_le(ctx["code"], insn_add_imm(8, 8, 16))
                push_u32_le(ctx["code"], insn_fcvtl_2d_from_2s(24, 29))
                push_u32_le(ctx["code"], insn_fcvtl2_2d_from_4s(25, 29))
    
                // col0 -> D12
                push_u32_le(ctx["code"], insn_fmul_2d(26, 24, 16))
                push_u32_le(ctx["code"], insn_fmul_2d(27, 25, 17))
                push_u32_le(ctx["code"], insn_str_q_off(26, 31, 0))
                push_u32_le(ctx["code"], insn_str_q_off(27, 31, 16))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(12, 12, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(12, 12, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(12, 12, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(12, 12, 28))
    
                // col1 -> D13
                push_u32_le(ctx["code"], insn_fmul_2d(26, 24, 18))
                push_u32_le(ctx["code"], insn_fmul_2d(27, 25, 19))
                push_u32_le(ctx["code"], insn_str_q_off(26, 31, 0))
                push_u32_le(ctx["code"], insn_str_q_off(27, 31, 16))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(13, 13, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(13, 13, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(13, 13, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(13, 13, 28))
    
                // col2 -> D14
                push_u32_le(ctx["code"], insn_fmul_2d(26, 24, 20))
                push_u32_le(ctx["code"], insn_fmul_2d(27, 25, 21))
                push_u32_le(ctx["code"], insn_str_q_off(26, 31, 0))
                push_u32_le(ctx["code"], insn_str_q_off(27, 31, 16))
