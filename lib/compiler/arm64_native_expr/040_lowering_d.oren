                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(14, 14, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(14, 14, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(14, 14, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(14, 14, 28))
    
                // col3 -> D15
                push_u32_le(ctx["code"], insn_fmul_2d(26, 24, 22))
                push_u32_le(ctx["code"], insn_fmul_2d(27, 25, 23))
                push_u32_le(ctx["code"], insn_str_q_off(26, 31, 0))
                push_u32_le(ctx["code"], insn_str_q_off(27, 31, 16))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 0))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(15, 15, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(15, 15, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 16))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(15, 15, 28))
                push_u32_le(ctx["code"], insn_ldr_reg_sp(15, 24))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 15))
                push_u32_le(ctx["code"], insn_fadd(15, 15, 28))
    
                // groups--
                push_u32_le(ctx["code"], insn_sub_imm(13, 13, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(13, 31))
                var br_vec_loop_gemm_b = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_end_gemm = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_skip_vec_gemm, insn_b_cond((vec_end_gemm - br_skip_vec_gemm) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_vec_loop_gemm_b, insn_b_cond((vec_loop_gemm - br_vec_loop_gemm_b) / 4, 1)) // NE
    
                // rem = n - (groups_saved * 4)
                //
                // Rolling note: compute `groups_saved * 4` via add-doubling rather than `LSLV`
                // to keep tail handling robust if variable-shift encoding changes.
                push_u32_le(ctx["code"], insn_add_reg(14, 14, 14))  // X14 *= 2
                push_u32_le(ctx["code"], insn_add_reg(14, 14, 14))  // X14 *= 4
                push_u32_le(ctx["code"], insn_sub_reg(10, 10, 14))  // X10 = rem
    
                // Tail loop if rem != 0.
                push_u32_le(ctx["code"], insn_cmp_reg(10, 31))
                var br_done_tail_gemm = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var tail_loop_gemm = bytes_len(ctx["code"])
                // Load a0..a3 f32 -> D24..D27 (as f64)
                push_u32_le(ctx["code"], insn_ldr_w(11, 5, 0))
                push_u32_le(ctx["code"], insn_add_imm(5, 5, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(24, 11))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(24, 24))
    
                push_u32_le(ctx["code"], insn_ldr_w(11, 6, 0))
                push_u32_le(ctx["code"], insn_add_imm(6, 6, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(25, 11))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(25, 25))
    
                push_u32_le(ctx["code"], insn_ldr_w(11, 7, 0))
                push_u32_le(ctx["code"], insn_add_imm(7, 7, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(26, 11))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(26, 26))
    
                push_u32_le(ctx["code"], insn_ldr_w(11, 8, 0))
                push_u32_le(ctx["code"], insn_add_imm(8, 8, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(27, 11))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(27, 27))
    
                // Load b0..b3 f32 -> D28..D31 (as f64)
                push_u32_le(ctx["code"], insn_ldr_w(11, 4, 0))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(28, 11))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(28, 28))
    
                push_u32_le(ctx["code"], insn_ldr_w(11, 3, 0))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(29, 11))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(29, 29))
    
                push_u32_le(ctx["code"], insn_ldr_w(11, 2, 0))
                push_u32_le(ctx["code"], insn_add_imm(2, 2, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(30, 11))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(30, 30))
    
                push_u32_le(ctx["code"], insn_ldr_w(11, 1, 0))
                push_u32_le(ctx["code"], insn_add_imm(1, 1, 4))
                push_u32_le(ctx["code"], insn_fmov_s_w(31, 11))
                push_u32_le(ctx["code"], insn_fcvt_d_from_s(31, 31))
    
                // Update 4x4 accumulators (D0..D15) using D20 as a temp product.
                // Row0
                push_u32_le(ctx["code"], insn_fmul(20, 24, 28)); push_u32_le(ctx["code"], insn_fadd(0, 0, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 24, 29)); push_u32_le(ctx["code"], insn_fadd(1, 1, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 24, 30)); push_u32_le(ctx["code"], insn_fadd(2, 2, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 24, 31)); push_u32_le(ctx["code"], insn_fadd(3, 3, 20))
                // Row1
                push_u32_le(ctx["code"], insn_fmul(20, 25, 28)); push_u32_le(ctx["code"], insn_fadd(4, 4, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 25, 29)); push_u32_le(ctx["code"], insn_fadd(5, 5, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 25, 30)); push_u32_le(ctx["code"], insn_fadd(6, 6, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 25, 31)); push_u32_le(ctx["code"], insn_fadd(7, 7, 20))
                // Row2
                push_u32_le(ctx["code"], insn_fmul(20, 26, 28)); push_u32_le(ctx["code"], insn_fadd(8, 8, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 26, 29)); push_u32_le(ctx["code"], insn_fadd(9, 9, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 26, 30)); push_u32_le(ctx["code"], insn_fadd(10, 10, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 26, 31)); push_u32_le(ctx["code"], insn_fadd(11, 11, 20))
                // Row3
                push_u32_le(ctx["code"], insn_fmul(20, 27, 28)); push_u32_le(ctx["code"], insn_fadd(12, 12, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 27, 29)); push_u32_le(ctx["code"], insn_fadd(13, 13, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 27, 30)); push_u32_le(ctx["code"], insn_fadd(14, 14, 20))
                push_u32_le(ctx["code"], insn_fmul(20, 27, 31)); push_u32_le(ctx["code"], insn_fadd(15, 15, 20))
    
                // rem--
                push_u32_le(ctx["code"], insn_sub_imm(10, 10, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(10, 31))
                var br_tail_gemm_b = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var done_tail_pos = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_done_tail_gemm, insn_b_cond((done_tail_pos - br_done_tail_gemm) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_tail_gemm_b, insn_b_cond((tail_loop_gemm - br_tail_gemm_b) / 4, 1)) // NE
    
                // Store results to out_ptr as f64 bits (row-major).
                push_u32_le(ctx["code"], insn_mov_reg(16, 9)) // X16 = out_ptr write cursor
                var rr = 0
                while rr < 16 {
                    push_u32_le(ctx["code"], insn_umov_x_d(11, rr))
                    push_u32_le(ctx["code"], insn_str_ptr(11, 16))
                    if rr != 15 {
                        push_u32_le(ctx["code"], insn_add_imm(16, 16, 8))
                    }
                    rr = rr + 1
                }
    
                // Pop scratch and return out_ptr (X0).
                push_u32_le(ctx["code"], insn_add_sp(32))
                ctx["stack_size"] = ctx["stack_size"] - 32
                return true
            }

    return false
}
