// Chunked out of native_compile_expr call handling for include coherence.
fn native_call_chunk_090_tail(ctx, fn_name, expr, args) {

            if fn_name == "oren_f64_to_u64_bits" {
                // Intrinsic: reinterpret float64 bits as u64 (in X0).
                var args = expr["args"]
                if args == nil || oren_list_len(args) != 1 {
                    native_error(ctx, expr["token"], "native backend: oren_f64_to_u64_bits expects 1 argument")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
                if !native_expr_is_floaty(ctx, args[0]) {
                    native_error(ctx, expr["token"], "native backend: oren_f64_to_u64_bits expects float argument")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
                native_compile_expr(ctx, args[0]) // X0 = f64 bits
                // Identity (float bits are already in X0).
                return true
            }

            if fn_name == "oren_u64_bits_to_f64" {
                // Intrinsic: reinterpret u64 bits (X0) as float64 bits (X0).
                var args = expr["args"]
                if args == nil || oren_list_len(args) != 1 {
                    native_error(ctx, expr["token"], "native backend: oren_u64_bits_to_f64 expects 1 argument")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
                native_compile_expr(ctx, args[0]) // X0 = bits
                // Identity: float bits and int bits share the same carrier register.
                return true
            }

            if fn_name == "fadd" || fn_name == "fsub" || fn_name == "fmul" || fn_name == "fdiv" {
                // Compile args
                native_compile_expr(ctx, expr["args"][0]) // arg0 -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                native_compile_expr(ctx, expr["args"][1]) // arg1 -> X0
                
                // Pop arg0 -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                // Move X1 -> D0, X0 -> D1
                push_u32_le(ctx["code"], insn_fmov_d_x(0, 1))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 0))
                
                // Execute Float Op
                if fn_name == "fadd" { push_u32_le(ctx["code"], insn_fadd(0, 0, 1)) }
                if fn_name == "fsub" { push_u32_le(ctx["code"], insn_fsub(0, 0, 1)) }
                if fn_name == "fmul" { push_u32_le(ctx["code"], insn_fmul(0, 0, 1)) }
                if fn_name == "fdiv" { push_u32_le(ctx["code"], insn_fdiv(0, 0, 1)) }
                
                // Move result D0 -> X0 (Using UMOV for bitwise copy)
                push_u32_le(ctx["code"], insn_umov_x_d(0, 0))
                
                return true
            }

            if fn_name == "flt" || fn_name == "fgt" || fn_name == "feq" {
                native_compile_expr(ctx, expr["args"][0])
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                native_compile_expr(ctx, expr["args"][1])
                
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                push_u32_le(ctx["code"], insn_fmov_d_x(0, 1))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 0))
                
                push_u32_le(ctx["code"], insn_fcmp(0, 1))
                
                var cond = 0
                if fn_name == "feq" { cond = 0 }
                if fn_name == "flt" { cond = 4 }
                if fn_name == "fgt" { cond = 12 }
                
                push_u32_le(ctx["code"], insn_cset(0, cond))
                return true
            }

            if fn_name == "iadd" {
                native_compile_expr(ctx, expr["args"][0]) // arg0 -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                native_compile_expr(ctx, expr["args"][1]) // arg1 -> X0
                
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                push_u32_le(ctx["code"], insn_add_reg(0, 1, 0))
                return true
            }

            if fn_name == "get_fp" {
                push_u32_le(ctx["code"], insn_add_imm(0, 29, 0))
                return true
            }

		            if fn_name == "get_sp" {
		                push_u32_le(ctx["code"], insn_add_imm(0, 31, 0)) // MOV X0, SP (X31) -> ADD X0, SP, #0
		                return true
		            }

		            // --- Raw code address intrinsic (native backend; rolling) ---
		            //
		            // `oren_code_addr(fn_ident)` returns the raw code address of a top-level function.
		            // This is intended for OS/library APIs that require a C-style function pointer
		            // (e.g. pthread_create start routine) without going through dlsym().
		            //
		            // Contract (v0):
		            // - exactly 1 argument
		            // - argument must be an Identifier expression naming a top-level function
		            if fn_name == "oren_code_addr" {
		                var args = expr["args"]
		                if args == nil || oren_list_len(args) != 1 {
		                    native_error(ctx, expr["token"], "native backend: oren_code_addr expects 1 argument")
		                    push_u32_le(ctx["code"], insn_movz(0, 0))
		                    return true
		                }
		                var a0 = args[0]
		                if a0 == nil || a0["type"] != "Identifier" {
		                    native_error(ctx, expr["token"], "native backend: oren_code_addr expects an Identifier argument")
		                    push_u32_le(ctx["code"], insn_movz(0, 0))
		                    return true
		                }
		                var nm = a0["value"]
		                if nm == nil || nm == "" {
		                    native_error(ctx, expr["token"], "native backend: oren_code_addr missing function name")
		                    push_u32_le(ctx["code"], insn_movz(0, 0))
		                    return true
		                }
		                var adr_pos = bytes_len(ctx["code"])
		                push_u32_le(ctx["code"], 0)
		                push_u32_le(ctx["code"], 0)
		                oren_list_push(ctx["fixups"], {"type": "adr_code", "pos": adr_pos, "name": nm, "reg": 0})
		                return true
		            }

		            // --- Coroutine / scheduler intrinsics (native backend; rolling) ---
		            //
		            // These are intentionally implemented as compiler intrinsics (inlined at call sites)
		            // so they do not depend on libc or a stable external assembly object.
		            //
		            // Context layout (rolling, AArch64):
		            //
		            // IMPORTANT (native runtime allocator model):
		            // - X27/X28 are reserved as the bump allocator state (heap_limit/heap_ptr).
		            // - They must be *shared* across all green tasks running on the same OS thread.
		            // - Therefore, coroutine context switching must NOT save/restore X27/X28, or it would
		            //   snapshot allocator state per green task and corrupt the heap.
		            //
		            // GPR region (u64 slots; 8-byte aligned):
		            // - slot 0..26:  x0..x26
		            // - slot 27:     x29 (FP)
		            // - slot 28:     x30 (LR)
		            // - slot 29:     SP
		            // - slot 30:     PC (resume address)
		            //
		            // SIMD region (16-byte aligned):
		            // - at offset 256: Q0..Q31 (each 16 bytes)
	            if fn_name == "oren_ctx_init" {
	                var args = expr["args"]
	                if args == nil || oren_list_len(args) != 3 {
	                    native_error(ctx, expr["token"], "native backend: oren_ctx_init expects 3 arguments")
	                    push_u32_le(ctx["code"], insn_movz(0, 0))
	                    return true
	                }

	                // ctx_ptr -> X9
	                native_compile_expr(ctx, args[0])
	                push_u32_le(ctx["code"], insn_mov_reg(9, 0))
	                // sp -> X10
	                native_compile_expr(ctx, args[1])
	                push_u32_le(ctx["code"], insn_mov_reg(10, 0))
	                // pc -> X11
	                native_compile_expr(ctx, args[2])
	                push_u32_le(ctx["code"], insn_mov_reg(11, 0))

	                // ctx[sp] = sp (slot 29)
	                push_u32_le(ctx["code"], insn_str_ptr_off(10, 9, 232))
	                // ctx[pc] = pc (slot 30)
	                push_u32_le(ctx["code"], insn_str_ptr_off(11, 9, 240))

	                // Return 0
	                push_u32_le(ctx["code"], insn_movz(0, 0))
	                return true
	            }

		            if fn_name == "oren_ctx_switch" {
		                var args = expr["args"]
		                if args == nil || oren_list_len(args) != 2 {
		                    native_error(ctx, expr["token"], "native backend: oren_ctx_switch expects 2 arguments")
		                    push_u32_le(ctx["code"], insn_movz(0, 0))
		                    return true
		                }

		                // Save GPRs + SP + resume PC into old_ctx.
		                //
		                // Note:
		                // - We do not save/restore X27/X28 (reserved heap regs).
		                // - Saving caller-saved registers improves robustness for scheduler code that can
		                //   resume after `oren_ctx_switch` with live locals.
		                //
		                // Implementation detail:
		                // - `native_compile_expr` produces its result in X0, so we spill the caller's
		                //   original X0 to the stack first so the saved context preserves it.
		                push_u32_le(ctx["code"], insn_sub_sp(16))
		                push_u32_le(ctx["code"], insn_str_reg_sp(0, 0)) // [sp+0] = orig x0

		                // old_ctx_ptr -> X0
		                native_compile_expr(ctx, args[0])

		                // Save GPRs x1..x26 into old_ctx (X0 base).
		                var r = 1
		                while r <= 26 {
		                    push_u32_le(ctx["code"], insn_str_ptr_off(r, 0, r * 8))
		                    r = r + 1
		                }
		                // Save original X0 (spilled on stack) into old_ctx[x0]. Balance SP before saving SP.
		                push_u32_le(ctx["code"], insn_ldr_reg_sp(12, 0)) // X12 = orig x0
		                push_u32_le(ctx["code"], insn_str_ptr_off(12, 0, 0))
		                push_u32_le(ctx["code"], insn_add_sp(16))

		                // x29, x30
		                push_u32_le(ctx["code"], insn_str_ptr_off(29, 0, 216))
		                push_u32_le(ctx["code"], insn_str_ptr_off(30, 0, 224))

		                // Save current SP into old_ctx[sp].
		                push_u32_le(ctx["code"], insn_add_imm(12, 31, 0)) // X12 = SP
		                push_u32_le(ctx["code"], insn_str_ptr_off(12, 0, 232))

		                // Save resume PC into old_ctx[pc]. We encode the address of the local resume label.
		                var adr_pos = bytes_len(ctx["code"])
		                push_u32_le(ctx["code"], 0) // patched to ADR X12, #imm
		                push_u32_le(ctx["code"], insn_str_ptr_off(12, 0, 240))

		                // Save SIMD state (Q0..Q31).
		                var vi = 0
		                while vi < 32 {
		                    push_u32_le(ctx["code"], insn_str_q_off(vi, 0, 256 + vi * 16))
		                    vi = vi + 1
		                }

		                // new_ctx_ptr -> X0
		                native_compile_expr(ctx, args[1])

		                // Restore from new_ctx.
		                //
		                // Use X16 as the base pointer so we can restore X10 without clobbering the base.
		                // X16 is call-scratch; we intentionally do not restore it.
		                push_u32_le(ctx["code"], insn_mov_reg(16, 0)) // X16 = new_ctx_ptr

		                // Restore SIMD state (Q0..Q31).
		                vi = 0
		                while vi < 32 {
		                    push_u32_le(ctx["code"], insn_ldr_q_off(vi, 16, 256 + vi * 16))
	                    vi = vi + 1
	                }

	                // Restore GPRs x0..x26 (skip X16 which is used as the base).
	                r = 0
	                while r <= 26 {
	                    if r != 16 {
	                        push_u32_le(ctx["code"], insn_ldr_ptr_off(r, 16, r * 8))
	                    }
	                    r = r + 1
	                }
	                // x29, x30
	                push_u32_le(ctx["code"], insn_ldr_ptr_off(29, 16, 216))
	                push_u32_le(ctx["code"], insn_ldr_ptr_off(30, 16, 224))

		                // Restore SP.
		                push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 16, 232))
		                push_u32_le(ctx["code"], insn_add_imm(31, 12, 0)) // SP = X12

	                // Jump to new PC.
	                push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 16, 240))
	                push_u32_le(ctx["code"], insn_br(12))

	                // Resume label: execution continues here when switched back into this context.
	                var resume_pos = bytes_len(ctx["code"])
	                set_u32_le(ctx["code"], adr_pos, insn_adr(12, resume_pos - adr_pos))
	                // Return value (best-effort): 0
	                push_u32_le(ctx["code"], insn_movz(0, 0))
	                return true
	            }

			            if fn_name == "malloc" || fn_name == "malloc_raw" || fn_name == "malloc_k" {
			                var want_args = 1
			                if fn_name == "malloc_k" { want_args = 2 }
			                if args == nil || oren_list_len(args) != want_args {
	                    native_error(ctx, expr["token"], "native backend: " + fn_name + " expects " + oren_int_to_string(want_args) + " argument(s)")
	                    push_u32_le(ctx["code"], insn_movz(0, 0))
	                    return true
	                }
	                // Bump-pointer heap in X28 (ptr) / X27 (limit); reuse free blocks if available.
	                native_compile_expr(ctx, args[0]) // size -> X0
	    
                // Align size up to 16: size = (size + 15) & ~15
                push_u32_le(ctx["code"], insn_add_imm(0, 0, 15))
                push_u32_le(ctx["code"], insn_movn(1, 15))      // X1 = ~0xF
                push_u32_le(ctx["code"], insn_and_reg(0, 0, 1)) // X0 = aligned size
                push_u32_le(ctx["code"], insn_mov_reg(9, 0))    // save size in X9
                
                if fn_name == "malloc_k" {
                    // kind -> X10 (must be preserved across reuse and syscalls)
                    // Preserve X9 across kind eval (native_compile_expr may clobber it).
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    push_u32_le(ctx["code"], insn_str_reg_sp(9, 0))
                    ctx["stack_size"] = ctx["stack_size"] + 16
                    native_compile_expr(ctx, args[1])
                    push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 0))
                    push_u32_le(ctx["code"], insn_add_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] - 16
                    push_u32_le(ctx["code"], insn_mov_reg(10, 0))
                }
	    
	                // SAVE X9 (and X10 for malloc_k) across helper call.
	                if fn_name == "malloc_k" {
	                    push_u32_le(ctx["code"], insn_sub_sp(32))
	                    push_u32_le(ctx["code"], insn_str_reg_sp(9, 0))
	                    push_u32_le(ctx["code"], insn_str_reg_sp(10, 8))
	                } else {
	                    push_u32_le(ctx["code"], insn_sub_sp(16))
	                    push_u32_le(ctx["code"], insn_str_reg_sp(9, 0))
	                }
	    
	                // Try reuse:
	                // - malloc(): reuse freed blocks (tracked alloc records pointing at object memory)
	                // - malloc_raw(): reuse free node storage (tracking/root nodes), never object blocks
	                var bl_reuse_pos = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
	                if fn_name == "malloc_raw" {
	                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_reuse_pos, "name": "native_try_reuse_node"})
	                } else {
	                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_reuse_pos, "name": "native_try_reuse"})
	                }
	                
	                // RESTORE X9 (and X10 for malloc_k)
	                if fn_name == "malloc_k" {
	                    push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 0))
	                    push_u32_le(ctx["code"], insn_ldr_reg_sp(10, 8))
	                    push_u32_le(ctx["code"], insn_add_sp(32))
	                } else {
	                    push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 0))
	                    push_u32_le(ctx["code"], insn_add_sp(16))
	                }
	                
	                push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
	                var jump_reuse_done = bytes_len(ctx["code"])
	                push_u32_le(ctx["code"], 0) // B.NE reuse_done
    
                // Bump path: candidate_end = heap_ptr (X28) + size
                push_u32_le(ctx["code"], insn_mov_reg(0, 9))    // restore size
                push_u32_le(ctx["code"], insn_mov_reg(1, 28))      // X1 = heap_ptr
                push_u32_le(ctx["code"], insn_add_reg(2, 28, 0))   // X2 = heap_ptr + size
                push_u32_le(ctx["code"], insn_cmp_reg(2, 27))      // cmp end, limit
                var jump_slow = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.GT slow
    
                // Fast path: return old heap_ptr, bump X28
                push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // X0 = old heap_ptr
                push_u32_le(ctx["code"], insn_mov_reg(28, 2)) // X28 = new heap_ptr
                var jump_end_malloc = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B end
    
                // Slow path: mmap a fresh chunk (max(size, 64KB))
                var slow_target = bytes_len(ctx["code"])
                var sys_mmap = abi.darwin_sys_mmap()
                var mmap_flags = abi.darwin_mmap_flags_private_anon()
                var mmap_prot = abi.darwin_mmap_prot_read_write()
                var sys_reg = abi.darwin_syscall_reg()
                var svc_imm = abi.darwin_svc_imm()
                var is_macos = true
                if ctx["platform"]["os"] == "linux" {
                    sys_mmap = labi.linux_sys_mmap()
                    mmap_flags = labi.linux_mmap_flags_private_anon()
                    mmap_prot = labi.linux_mmap_prot_read_write()
                    sys_reg = labi.linux_syscall_reg()
                    svc_imm = labi.linux_svc_imm()
                    is_macos = false
                }
    
                // chunk = max(size, 65536)
                push_u32_le(ctx["code"], insn_mov_reg(0, 9))
                push_u32_le(ctx["code"], insn_movz(3, 0))
                push_u32_le(ctx["code"], insn_movk(3, 1, 1)) // X3 = 0x10000
                push_u32_le(ctx["code"], insn_cmp_reg(0, 3))
                var jump_use_chunk = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.LT use_chunk
                // use size
                push_u32_le(ctx["code"], insn_mov_reg(3, 0))
                var jump_choose_end = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B choose_end
                // use_chunk:
                var chunk_target = bytes_len(ctx["code"])
                // choose_end:
                var choose_target = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], jump_choose_end, insn_b((choose_target - jump_choose_end) / 4))
    
                // mmap(0, chunk, PROT=3, flags, -1, 0)
                push_u32_le(ctx["code"], insn_add_imm(1, 3, 0)) // X1 = chunk
                
	                // SAVE X3 (chunk) and X9 (aligned size) before syscall.
	                // The kernel may clobber registers across syscalls.
	                if fn_name == "malloc_k" {
	                    push_u32_le(ctx["code"], insn_sub_sp(48))
	                    push_u32_le(ctx["code"], insn_str_reg_sp(3, 0))
	                    push_u32_le(ctx["code"], insn_str_reg_sp(9, 8))
	                    push_u32_le(ctx["code"], insn_str_reg_sp(10, 16))
	                } else {
	                    push_u32_le(ctx["code"], insn_sub_sp(32))
	                    push_u32_le(ctx["code"], insn_str_reg_sp(3, 0))
	                    push_u32_le(ctx["code"], insn_str_reg_sp(9, 8))
	                }
                
                push_u32_le(ctx["code"], insn_movz(0, 0))
                push_u32_le(ctx["code"], insn_movz(2, mmap_prot))
                push_u32_le(ctx["code"], insn_movz(3, mmap_flags))
                push_u32_le(ctx["code"], insn_movn(4, 0))
                push_u32_le(ctx["code"], insn_movz(5, 0))
                push_u32_le(ctx["code"], insn_movz(sys_reg, sys_mmap))
                push_u32_le(ctx["code"], insn_svc(svc_imm))
    
                // Normalize macOS syscall error (carry set, X0=errno) to X0 = -errno.
                if is_macos {
                    var br_ok_macos = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B.CC ok
                    push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0)) // X0 = -errno
                    var ok_pos_macos = bytes_len(ctx["code"])
                    set_u32_le(ctx["code"], br_ok_macos, insn_b_cond((ok_pos_macos - br_ok_macos) / 4, 3)) // CC
                }
    
                // If mmap failed, terminate deterministically (OOM / invalid args).
                // Convention after normalization:
                // - success: X0 >= 0 (pointer)
                // - failure: X0 < 0  (-errno)
                push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
                var br_mmap_ok = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.GE ok
    
                // Error path: exit(errno)
                // Restore stack frame enough to compute errno (we can skip restoring regs since we exit).
                push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0)) // X0 = errno (0 - (-errno))
                var sys_exit = abi.darwin_sys_exit()
                if ctx["platform"]["os"] == "linux" { sys_exit = labi.linux_sys_exit() }
                push_u32_le(ctx["code"], insn_movz(sys_reg, sys_exit))
                push_u32_le(ctx["code"], insn_svc(svc_imm))
    
                // ok:
                var mmap_ok_target = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_mmap_ok, insn_b_cond((mmap_ok_target - br_mmap_ok) / 4, 10)) // GE

                // Rolling robustness: reject suspicious "pointer" results that are too small to be a valid
                // mapping base. A wrong syscall number or clobbered syscall register can otherwise return
                // small positive integers (e.g. 15), which then get used as pointers and segfault later.
                //
                // Contract (native runtime): any heap/metadata pointer must be >= 4096.
                push_u32_le(ctx["code"], insn_movz(6, 4096)) // X6 = 0x1000
                push_u32_le(ctx["code"], insn_cmp_reg(0, 6))
                var br_ptr_ok = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.GE ptr_ok
                // Fail-fast: exit(315)
                push_u32_le(ctx["code"], insn_movz(0, 315))
                var sys_exit2 = abi.darwin_sys_exit()
                if ctx["platform"]["os"] == "linux" { sys_exit2 = labi.linux_sys_exit() }
                push_u32_le(ctx["code"], insn_movz(sys_reg, sys_exit2))
                push_u32_le(ctx["code"], insn_svc(svc_imm))
                var ptr_ok_target = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_ptr_ok, insn_b_cond((ptr_ok_target - br_ptr_ok) / 4, 10)) // GE
    
		                // RESTORE X3 (chunk) and X9 (aligned size)
		                if fn_name == "malloc_k" {
		                    push_u32_le(ctx["code"], insn_ldr_reg_sp(3, 0))
		                    push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 8))
	                    push_u32_le(ctx["code"], insn_ldr_reg_sp(10, 16))
	                    push_u32_le(ctx["code"], insn_add_sp(48))
	                } else {
	                    push_u32_le(ctx["code"], insn_ldr_reg_sp(3, 0))
	                    push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 8))
	                    push_u32_le(ctx["code"], insn_add_sp(32))
	                }
    
                // Update heap_ptr/limit: X0=base, X3=chunk, X9=aligned size.
                //
                // - heap_limit (X27) = base + chunk
                // - heap_ptr   (X28) = base + aligned size (so subsequent mallocs can bump-allocate)
                push_u32_le(ctx["code"], insn_add_reg(2, 0, 3)) // X2 = base + chunk
                push_u32_le(ctx["code"], insn_add_reg(1, 0, 9)) // X1 = base + size
                push_u32_le(ctx["code"], insn_mov_reg(28, 1))
                push_u32_le(ctx["code"], insn_mov_reg(27, 2))
                // X0 already holds return ptr (base)
    
                // Patch branches for bump/mmap paths
                var end_target = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], jump_slow, insn_b_cond((slow_target - jump_slow) / 4, 12)) // GT -> slow
                set_u32_le(ctx["code"], jump_end_malloc, insn_b((end_target - jump_end_malloc) / 4))
                set_u32_le(ctx["code"], jump_use_chunk, insn_b_cond((chunk_target - jump_use_chunk) / 4, 11)) // LT -> chunk
    
                var track_target = bytes_len(ctx["code"])
                if fn_name == "malloc" {
                    // Track allocation (kind = misc)
                    push_u32_le(ctx["code"], insn_mov_reg(1, 9))    // X1 = size
                    push_u32_le(ctx["code"], insn_movz(2, 5))       // kind = 5
                    if ctx["trace_native_alloc_req"] != nil {
                        // Trace alloc request before tracking to catch size corruption.
                        push_u32_le(ctx["code"], insn_sub_sp(32))
                        push_u32_le(ctx["code"], insn_str_reg_sp(0, 0))
                        push_u32_le(ctx["code"], insn_str_reg_sp(9, 8))
                        push_u32_le(ctx["code"], insn_str_reg_sp(10, 16))
                        ctx["stack_size"] = ctx["stack_size"] + 32
                        push_u32_le(ctx["code"], insn_mov_reg(1, 9)) // X1 = size
                        push_u32_le(ctx["code"], insn_movz(2, 5))    // kind = 5
                        var bl_trace_pos = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_trace_pos, "name": "oren_trace_alloc_request"})
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 8))
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(10, 16))
                        push_u32_le(ctx["code"], insn_add_sp(32))
                        ctx["stack_size"] = ctx["stack_size"] - 32
                    }
                    var bl_track_pos = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_track_pos, "name": "oren_track_alloc_new"})
                }
                if fn_name == "malloc_k" {
                    // Track allocation with caller-provided kind.
                    push_u32_le(ctx["code"], insn_mov_reg(1, 9))    // X1 = size
                    push_u32_le(ctx["code"], insn_mov_reg(2, 10))   // X2 = kind
                    if ctx["trace_native_alloc_req"] != nil {
                        // Trace alloc request before tracking to catch size corruption.
                        push_u32_le(ctx["code"], insn_sub_sp(32))
                        push_u32_le(ctx["code"], insn_str_reg_sp(0, 0))
                        push_u32_le(ctx["code"], insn_str_reg_sp(9, 8))
                        push_u32_le(ctx["code"], insn_str_reg_sp(10, 16))
                        ctx["stack_size"] = ctx["stack_size"] + 32
                        push_u32_le(ctx["code"], insn_mov_reg(1, 9))  // X1 = size
                        push_u32_le(ctx["code"], insn_mov_reg(2, 10)) // X2 = kind
                        var bl_trace_pos2 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_trace_pos2, "name": "oren_trace_alloc_request"})
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 8))
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(10, 16))
                        push_u32_le(ctx["code"], insn_add_sp(32))
                        ctx["stack_size"] = ctx["stack_size"] - 32
                    }
                    var bl_track_pos2 = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_track_pos2, "name": "oren_track_alloc_new"})
                }
	                
	                // Return path
	                var malloc_end = bytes_len(ctx["code"])
	                if fn_name == "malloc_k" {
	                    set_u32_le(ctx["code"], jump_reuse_done, insn_b_cond((track_target - jump_reuse_done) / 4, 1)) // B.NE -> track
	                } else {
	                    set_u32_le(ctx["code"], jump_reuse_done, insn_b_cond((malloc_end - jump_reuse_done) / 4, 1)) // B.NE -> reuse_done/end
	                }
	                return true
	            }



            if fn_name == "ptr_get" {
                native_compile_expr(ctx, args[0])
                push_u32_le(ctx["code"], insn_ldr_ptr(0, 0))
                return true
            }

            if fn_name == "ptr_get_byte" {
                native_compile_expr(ctx, args[0])
                // LDRB W0, [X0]
                push_u32_le(ctx["code"], insn_ldrb(0, 0))
                return true
            }

            if fn_name == "ptr_set_byte" {
                native_compile_expr(ctx, args[0]) // ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args[1]) // val -> X0 (lower 8 bits)
    
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0)) // ptr -> X1
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // STRB W0, [X1]
                push_u32_le(ctx["code"], insn_strb(0, 1))
                return true
            }

            if fn_name == "oren_buf_load_u8_unchecked" {
                // Intrinsic fast path (tooling critical):
                //
                // `oren_buf_load_u8_unchecked(buf, idx)` is a runtime helper in native mode, but
                // calling it for every byte is catastrophically slow in stage2-native compilers
                // (astbin decode reads multi-megabyte blobs).
                //
                // Inline the load using the native buffer layout:
                // - typed buffer header stores the aligned payload pointer at buf+40
                // - payload byte at data_ptr+idx is returned (zero-extended)
                //
                // NOTE: this assumes `buf` is a valid u8_buf and `idx` is in range, matching the
                // "unchecked" contract.
                native_compile_expr(ctx, args[0]) // buf -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                native_compile_expr(ctx, args[1]) // idx -> X0
                push_u32_le(ctx["code"], insn_str_x0_sp(8))

                // X1 = buf
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                // X1 = buf + 40
                push_u32_le(ctx["code"], insn_add_imm(1, 1, 40))
                // X1 = *(buf + 40)  (data_ptr)
                push_u32_le(ctx["code"], insn_ldr_ptr(1, 1))
                // X0 = idx
                push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 8))
                // pop stack
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16

                // X1 = data_ptr + idx
                push_u32_le(ctx["code"], insn_add_reg(1, 1, 0))
                // W0 = *(u8*)(X1)
                push_u32_le(ctx["code"], insn_ldrb(0, 1))
                return true
            }

            if sysm.native_compile_syscall_call(ctx, fn_name, args, native_compile_expr) {
                return true
            }

            if fn_name == "native_call1" {
                // native_call1(addr, arg0) -> u64
                if args == nil || oren_list_len(args) != 2 {
                    native_error(ctx, expr["token"], "native backend: native_call1 expects 2 arguments")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
                if expr["spread"] != nil {
                    native_error(ctx, expr["token"], "native backend: native_call1 does not support spread")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }

                // Evaluate addr -> spill
                native_compile_expr(ctx, args[0])
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                // Evaluate arg0 -> X0
                native_compile_expr(ctx, args[1])

                // Load addr -> X9 and call it (arg already in X0).
                push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16

                push_u32_le(ctx["code"], insn_blr(9))
                // Return value is in X0.
                return true
            }

            if fn_name == "atomic_cas" {
                // atomic_cas(ptr, expected, new)
                native_compile_expr(ctx, args[0]) // ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                native_compile_expr(ctx, args[1]) // expected
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                native_compile_expr(ctx, args[2]) // new -> X0
                
                // Pop expected -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                // Pop ptr -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                // atomic_cas returns the old value.
                //
                // Implement CAS via LL/SC so generated binaries run on baseline arm64
                // CPUs that do not expose LSE atomics (CAS/LDADD).
                //
                // Inputs:
                // - X2 = ptr
                // - X1 = expected
                // - X0 = new
                //
                // Output:
                // - X0 = old value
                var loop_pos = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], insn_ldaxr(3, 2))       // X3 = *ptr (acquire)
                push_u32_le(ctx["code"], insn_cmp_reg(3, 1))     // old ?= expected
                var br_fail = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)                      // B.NE fail
                push_u32_le(ctx["code"], insn_stlxr(4, 0, 2))    // W4 = status, *ptr = new (release)
                push_u32_le(ctx["code"], insn_cmp_reg(4, 31))    // status ?= 0
                var br_retry = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)                      // B.NE loop
                var br_done = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)                      // B done
    
                var fail_pos = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], insn_clrex())           // drop exclusivity when abandoning store
    
                var done_pos = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_fail, insn_b_cond((fail_pos - br_fail) / 4, 1))     // NE
                set_u32_le(ctx["code"], br_retry, insn_b_cond((loop_pos - br_retry) / 4, 1))   // NE
                set_u32_le(ctx["code"], br_done, insn_b((done_pos - br_done) / 4))
    
                push_u32_le(ctx["code"], insn_add_imm(0, 3, 0))  // return old value
                return true
            }

    return false
}
