            var vec_end = oren_list_len(ctx["code"])
            set_u32_le(ctx["code"], br_skip_vec, insn_b_cond((vec_end - br_skip_vec) / 4, 0)) // EQ
            set_u32_le(ctx["code"], br_vec_loop, insn_b_cond((vec_loop - br_vec_loop) / 4, 1)) // NE

            // rem = n - (groups_saved*2)
            push_u32_le(ctx["code"], insn_lslv(10, 10, 9))    // X10 = groups_saved*2
            push_u32_le(ctx["code"], insn_sub_reg(7, 7, 10))  // X7 = rem

