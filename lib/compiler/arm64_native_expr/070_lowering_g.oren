            push_u32_le(ctx["code"], insn_add_imm(4, 4, 16)) // b0 += 16
            push_u32_le(ctx["code"], insn_add_imm(3, 3, 16)) // b1 += 16
            push_u32_le(ctx["code"], insn_add_imm(2, 2, 16)) // b2 += 16
            push_u32_le(ctx["code"], insn_add_imm(1, 1, 16)) // b3 += 16

