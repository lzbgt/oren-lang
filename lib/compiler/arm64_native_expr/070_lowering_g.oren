            push_u32_le(ctx["code"], insn_fmov_d_x(5, 11)) // D5 = a

            push_u32_le(ctx["code"], insn_ldr_ptr(16, 4))  // X16 = *(u64*)b0
            push_u32_le(ctx["code"], insn_fmov_d_x(6, 16))
            push_u32_le(ctx["code"], insn_fmul(6, 5, 6))
            push_u32_le(ctx["code"], insn_fadd(12, 12, 6))

            push_u32_le(ctx["code"], insn_ldr_ptr(16, 3))  // b1
            push_u32_le(ctx["code"], insn_fmov_d_x(6, 16))
            push_u32_le(ctx["code"], insn_fmul(6, 5, 6))
            push_u32_le(ctx["code"], insn_fadd(13, 13, 6))

            push_u32_le(ctx["code"], insn_ldr_ptr(16, 2))  // b2
            push_u32_le(ctx["code"], insn_fmov_d_x(6, 16))
            push_u32_le(ctx["code"], insn_fmul(6, 5, 6))
            push_u32_le(ctx["code"], insn_fadd(14, 14, 6))

            push_u32_le(ctx["code"], insn_ldr_ptr(16, 1))  // b3
            push_u32_le(ctx["code"], insn_fmov_d_x(6, 16))
            push_u32_le(ctx["code"], insn_fmul(6, 5, 6))
            push_u32_le(ctx["code"], insn_fadd(15, 15, 6))

            var done_pos = oren_list_len(ctx["code"])
            set_u32_le(ctx["code"], br_done, insn_b_cond((done_pos - br_done) / 4, 0)) // EQ

            // Store 4 f64 results to out_ptr (X6). Preserve return X0 = out_ptr.
            push_u32_le(ctx["code"], insn_umov_x_d(11, 12))
            push_u32_le(ctx["code"], insn_str_ptr(11, 6))
            push_u32_le(ctx["code"], insn_add_imm(6, 6, 8))

            push_u32_le(ctx["code"], insn_umov_x_d(11, 13))
            push_u32_le(ctx["code"], insn_str_ptr(11, 6))
            push_u32_le(ctx["code"], insn_add_imm(6, 6, 8))

            push_u32_le(ctx["code"], insn_umov_x_d(11, 14))
            push_u32_le(ctx["code"], insn_str_ptr(11, 6))
            push_u32_le(ctx["code"], insn_add_imm(6, 6, 8))

            push_u32_le(ctx["code"], insn_umov_x_d(11, 15))
            push_u32_le(ctx["code"], insn_str_ptr(11, 6))

