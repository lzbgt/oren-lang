fn trim_trailing_underscores(s) {
    var end = oren_string_len(s)
    while end > 0 {
        if oren_string_char_at(s, end - 1) != "_" { break }
        end = end - 1
    }
    return oren_string_slice(s, 0, end)
}

fn native_data_add_cstr0(ctx, s) {
    // Add a NUL-terminated C string to the appended data blob and return its byte offset.
    //
    // Deduping:
    // - Not required for correctness (string semantics are strcmp-based), but it reduces binary size
    //   and makes pointer identity stable for repeated literals.
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if ctx["cstr0_offs"] == nil { ctx["cstr0_offs"] = {} }
    if ctx["cstr0_list"] == nil { ctx["cstr0_list"] = [] }

    if s == nil { s = "" }
    // Store offsets as `off+1` so a real offset of 0 is representable while still using `nil`
    // as the map sentinel for "missing/uninitialized" (call sites decode with `enc-1`).
    var existing_enc = ctx["cstr0_offs"][s]
    if oren_type_tag(existing_enc) == 1 {
        if existing_enc > 0 { return existing_enc - 1 }
    }

    while int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = bytes_len(ctx["data"])
    // Avoid allocating an intermediate `list<int>` for each literal via `oren_bytes_from_string`.
    // Tooling workloads (compiler self-host) can have thousands of distinct literals, and list
    // allocations here inflate GC pressure and runtime-object compile time.
    //
    // Use the stable `oren_string_*` helpers (works under both C and native runtimes).
    var n = oren_string_len(s)
    if n > 1048576 { n = 1048576 } // safety cap
    var i = 0
    while i < n {
        bytes_push(ctx["data"], oren_string_byte_at_unchecked(s, i) & 255)
        i = i + 1
    }
    bytes_push(ctx["data"], 0)
    ctx["cstr0_offs"][s] = off + 1
    // Track unique offsets so the program entry stub can register all literals once at startup.
    oren_list_push(ctx["cstr0_list"], off)
    return off
}

// Resolve module/type namespace paths (import aliases + type namespaces) into
// flattened symbol names, matching the C-backend's `ns_resolve` convention.
//
// Examples:
// - `http.get` => `http_get` (if `http` is an import alias mapping to `http_`)
// - `math.PI`  => `math_PI`
// - returns nil if the expression is not a namespace path.
fn native_ns_resolve(ctx, exp) {
    if exp == nil { return nil }
    var et = exp["type"]
    if et == "Identifier" {
        var name = exp["value"]
        if ctx["aliases"][name] != nil { return {"name": ctx["aliases"][name], "is_ns": true} }
        if ctx["type_ns"] != nil {
            if ctx["type_ns"][name] == true { return {"name": name, "is_ns": true} }
        }
        return nil
    }
    if et == "Member" {
        var left = native_ns_resolve(ctx, exp["left"])
        if left == nil { return nil }
        if left["is_ns"] != true { return nil }
        var base = trim_trailing_underscores(left["name"])
        var name2 = base + "_" + exp["prop"]["value"]
        var is_ns2 = false
        if ctx["type_ns"] != nil {
            if ctx["type_ns"][name2] == true { is_ns2 = true }
        }
        return {"name": name2, "is_ns": is_ns2}
    }
    return nil
}

