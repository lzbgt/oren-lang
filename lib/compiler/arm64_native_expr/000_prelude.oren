import core "arm64_core.oren"
import sysm "arm64_native_expr_syscalls.oren"
import abi "arm64_abi_macos.oren"
import labi "arm64_abi_linux.oren"
import token "token.oren"
import callabi "native_abi.oren"

fn native_src_line_col(src, pos) {
    // Map byte offset -> (line, col), 1-based.
    var line = 1
    var col = 1
    var i = 0
    while i < pos && i < oren_string_len(src) {
        var ch = oren_string_char_at(src, i)
        if ch == token.CH_LF {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return {"line": line, "col": col}
}

fn native_tok_loc(tok) {
    if tok == nil { return nil }
    var file = tok["file"]
    var pos = tok["pos"]
    if file == nil || pos == nil { return nil }

    var src = oren_read_file(file)
    if oren_is_err(src) {
        return file + ":" + oren_int_to_string(pos)
    }
    var lc = native_src_line_col(src, pos)
    return file + ":" + oren_int_to_string(lc["line"]) + ":" + oren_int_to_string(lc["col"])
}

fn native_error(ctx, tok, msg) {
    if ctx == nil { return nil }
    if ctx["errors"] == nil { ctx["errors"] = [] }
    var loc = native_tok_loc(tok)
    if loc != nil {
        oren_list_push(ctx["errors"], loc + ": " + msg)
    } else {
        oren_list_push(ctx["errors"], msg)
    }
    return nil
}

