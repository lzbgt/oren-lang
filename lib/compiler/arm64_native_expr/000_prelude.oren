fn native_name_has_suffix(name, suffix) {
    if name == nil || suffix == nil { return false }
    var n = oren_string_len(name)
    var m = oren_string_len(suffix)
    if n < m { return false }
    var i = 0
    while i < m {
        if oren_string_char_at(name, n - m + i) != oren_string_char_at(suffix, i) { return false }
        i = i + 1
    }
    return true
}

fn native_name_is_or_has_suffix(name, exact, suffix) {
    if name == exact { return true }
    return native_name_has_suffix(name, suffix)
}

fn native_name_is_std_math_rounding_float(name) {
    if name == "floor" || name == "ceil" || name == "round" || name == "trunc" { return true }
    if name == "STD_math_floor" || name == "STD_math_ceil" || name == "STD_math_round" || name == "STD_math_trunc" { return true }
    if name == "math_floor" || name == "math_ceil" || name == "math_round" || name == "math_trunc" { return true }
    return false
}

fn native_expr_static_member_field_kind(ctx, expr) {
    if ctx == nil || expr == nil { return nil }
    if expr["type"] != "Member" { return nil }
    var prop = expr["prop"]
    if prop == nil || prop["type"] != "Identifier" { return nil }
    var left = expr["left"]
    if left == nil || left["type"] != "Identifier" { return nil }
    var obj_name = left["value"]
    var type_name = nil
    if ctx["locals_struct_type"] != nil { type_name = ctx["locals_struct_type"][obj_name] }
    if type_name == nil {
        if ctx["globals_struct_type"] != nil { type_name = ctx["globals_struct_type"][obj_name] }
    }
    if type_name == nil { return nil }
    var all = ctx["type_field_kinds"]
    if all == nil { return nil }
    var fields = all[type_name]
    if fields == nil { return nil }
    return fields[prop["value"]]
}

fn native_kind_name_is_float(kind) {
    if kind == nil { return false }
    var k = kind
    if oren_string_len(k) > 5 {
        if oren_string_slice(k, 0, 5) == "oren." { k = oren_string_slice(k, 5, oren_string_len(k)) }
    }
    return k == "f32" || k == "f64"
}

fn native_expr_is_floaty(ctx, expr) {
    // Heuristic, rolling "float propagation" for the native backend.
    //
    // Native float values are raw IEEE-754 f64 bits in a 64-bit register.
    // Without a tagged dynamic value, we cannot decide "float vs int" at runtime,
    // so we conservatively decide based on AST + local assignment tracking.
    if expr == nil { return false }
    var et = expr["type"]
    if et == "Float" { return true }
    if et == "Identifier" {
        var name = expr["value"]
        if ctx != nil {
            if ctx["locals_floaty"] != nil {
                if ctx["locals_floaty"][name] == true { return true }
            }
            if ctx["globals_floaty"] != nil {
                if ctx["globals_floaty"][name] == true { return true }
            }
        }
        return false
    }
    if et == "Member" {
        var fk = native_expr_static_member_field_kind(ctx, expr)
        if fk == "f32" || fk == "f64" { return true }
        return false
    }
    if et == "Call" {
        var fnn = expr["fn"]
        var nm = nil
        if fnn != nil && fnn["type"] == "Identifier" {
            nm = fnn["value"]
        } else {
            if fnn != nil && fnn["type"] == "Member" {
                var prop = fnn["prop"]
                if prop != nil && prop["type"] == "Identifier" {
                    nm = prop["value"]
                }
            }
        }
        if nm != nil {
            if ctx != nil && ctx["func_ret_kinds"] != nil {
                if native_kind_name_is_float(ctx["func_ret_kinds"][nm]) { return true }
            }
            if nm == "fadd" || nm == "fsub" || nm == "fmul" || nm == "fdiv" { return true }
            if nm == "f32" || nm == "f64" { return true }
            // Native runtime/library functions that are known to return float bits.
            if nm == "oren_f32_round" { return true }
            if nm == "oren_u32_bits_to_f32" { return true }
            if nm == "oren_u64_bits_to_f64" { return true }
            if nm == "oren_buf_load_f32" { return true }
            if nm == "oren_buf_load_f64" { return true }
            if nm == "oren_buf_dot_f32" { return true }
            if nm == "oren_buf_dot_f32_slice" { return true }
            if nm == "oren_buf_dot_f32_strided" { return true }
            if nm == "oren_buf_dot_f64" { return true }
            if nm == "oren_buf_dot_f64_slice" { return true }
            if nm == "oren_buf_dot_f64_strided" { return true }
            if nm == "oren_buf_reduce_sum_f32" { return true }
            if nm == "oren_buf_reduce_sum_f64" { return true }
            if native_name_is_or_has_suffix(nm, "dot_f32", "_dot_f32") { return true }
            if native_name_is_or_has_suffix(nm, "dot_f64", "_dot_f64") { return true }
            if native_name_is_or_has_suffix(nm, "dot_f32_buf", "_dot_f32_buf") { return true }
            if native_name_is_or_has_suffix(nm, "dot_f64_buf", "_dot_f64_buf") { return true }
            if native_name_is_or_has_suffix(nm, "reduce_sum_f64_buf", "_reduce_sum_f64_buf") { return true }
            if native_name_is_or_has_suffix(nm, "dot_f32_view", "_dot_f32_view") { return true }
            if native_name_is_or_has_suffix(nm, "dot_f64_view", "_dot_f64_view") { return true }
            if native_name_is_or_has_suffix(nm, "abs_f", "_abs_f") { return true }
            if native_name_is_or_has_suffix(nm, "min_f", "_min_f") { return true }
            if native_name_is_or_has_suffix(nm, "max_f", "_max_f") { return true }
            if native_name_is_or_has_suffix(nm, "clamp_f", "_clamp_f") { return true }
            if native_name_is_or_has_suffix(nm, "_f64_from_bits", "_f64_from_bits") { return true }
            if native_name_is_or_has_suffix(nm, "copysign", "_copysign") { return true }
            if native_name_is_or_has_suffix(nm, "inf", "_inf") { return true }
            if native_name_is_or_has_suffix(nm, "neg_inf", "_neg_inf") { return true }
            if native_name_is_std_math_rounding_float(nm) { return true }
            if native_name_is_or_has_suffix(nm, "round_even", "_round_even") { return true }
            if native_name_is_or_has_suffix(nm, "nearbyint", "_nearbyint") { return true }
            if native_name_is_or_has_suffix(nm, "rint", "_rint") { return true }
            if native_name_is_or_has_suffix(nm, "fmod", "_fmod") { return true }
            if native_name_is_or_has_suffix(nm, "_round_ties_even", "_round_ties_even") { return true }
            if native_name_is_or_has_suffix(nm, "remainder", "_remainder") { return true }
            if native_name_is_or_has_suffix(nm, "fdim", "_fdim") { return true }
            if native_name_is_or_has_suffix(nm, "nextafter", "_nextafter") { return true }
            if native_name_is_or_has_suffix(nm, "nexttoward", "_nexttoward") { return true }
            if native_name_is_or_has_suffix(nm, "sqrt", "_sqrt") { return true }
            if native_name_is_or_has_suffix(nm, "cbrt", "_cbrt") { return true }
            if native_name_is_or_has_suffix(nm, "powi", "_powi") { return true }
            if native_name_is_or_has_suffix(nm, "pow", "_pow") { return true }
            if native_name_is_or_has_suffix(nm, "power", "_power") { return true }
            if native_name_is_or_has_suffix(nm, "pow2i", "_pow2i") { return true }
            if native_name_is_or_has_suffix(nm, "pow10_i", "_pow10_i") { return true }
            if native_name_is_or_has_suffix(nm, "ldexp", "_ldexp") { return true }
            if native_name_is_or_has_suffix(nm, "scalbn", "_scalbn") { return true }
            if native_name_is_or_has_suffix(nm, "scalbln", "_scalbln") { return true }
            if native_name_is_or_has_suffix(nm, "logb", "_logb") { return true }
            if native_name_is_or_has_suffix(nm, "_exp_taylor", "_exp_taylor") { return true }
            if native_name_is_or_has_suffix(nm, "exp2", "_exp2") { return true }
            if native_name_is_or_has_suffix(nm, "exp", "_exp") { return true }
            if native_name_is_or_has_suffix(nm, "expm1", "_expm1") { return true }
            if native_name_is_or_has_suffix(nm, "exp10", "_exp10") { return true }
            if native_name_is_or_has_suffix(nm, "log2", "_log2") { return true }
            if native_name_is_or_has_suffix(nm, "log1p", "_log1p") { return true }
            if native_name_is_or_has_suffix(nm, "log10", "_log10") { return true }
            if native_name_is_or_has_suffix(nm, "log", "_log") { return true }
            if native_name_is_or_has_suffix(nm, "lnf", "_lnf") { return true }
            if native_name_is_or_has_suffix(nm, "ln", "_ln") { return true }
            if native_name_is_or_has_suffix(nm, "sinh", "_sinh") { return true }
            if native_name_is_or_has_suffix(nm, "cosh", "_cosh") { return true }
            if native_name_is_or_has_suffix(nm, "tanh", "_tanh") { return true }
            if native_name_is_or_has_suffix(nm, "asinh", "_asinh") { return true }
            if native_name_is_or_has_suffix(nm, "acosh", "_acosh") { return true }
            if native_name_is_or_has_suffix(nm, "atanh", "_atanh") { return true }
            if native_name_is_or_has_suffix(nm, "_erfc_positive_approx", "_erfc_positive_approx") { return true }
            if native_name_is_or_has_suffix(nm, "erfc", "_erfc") { return true }
            if native_name_is_or_has_suffix(nm, "erf", "_erf") { return true }
            if native_name_is_or_has_suffix(nm, "pi", "_pi") { return true }
            if native_name_is_or_has_suffix(nm, "tau", "_tau") { return true }
            if native_name_is_or_has_suffix(nm, "_sin_poly", "_sin_poly") { return true }
            if native_name_is_or_has_suffix(nm, "_cos_poly", "_cos_poly") { return true }
            if native_name_is_or_has_suffix(nm, "sin", "_sin") { return true }
            if native_name_is_or_has_suffix(nm, "cos", "_cos") { return true }
            if native_name_is_or_has_suffix(nm, "tan", "_tan") { return true }
            if native_name_is_or_has_suffix(nm, "atan", "_atan") { return true }
            if native_name_is_or_has_suffix(nm, "atan2", "_atan2") { return true }
            if native_name_is_or_has_suffix(nm, "asin", "_asin") { return true }
            if native_name_is_or_has_suffix(nm, "acos", "_acos") { return true }
            if native_name_is_or_has_suffix(nm, "hypot", "_hypot") { return true }
        }
        return false
    }
    if et == "Prefix" {
        if expr["op"] == "-" { return native_expr_is_floaty(ctx, expr["right"]) }
        return false
    }
    if et == "Infix" {
        var op = expr["op"]
        if op == "+" || op == "-" || op == "*" || op == "/" {
            if native_expr_is_floaty(ctx, expr["left"]) { return true }
            if native_expr_is_floaty(ctx, expr["right"]) { return true }
        }
        return false
    }
    return false
}

fn native_expr_is_inty(ctx, expr) {
    // Heuristic "int propagation" for the native backend.
    // Used to avoid dynamic `oren_add` when both operands are known integer-like.
    return native_expr_is_inty_with_floaty(ctx, expr, native_expr_is_floaty(ctx, expr))
}

fn native_expr_is_inty_with_floaty(ctx, expr, is_floaty) {
    // Same contract as native_expr_is_inty, but lets hot callers reuse an
    // already-computed float trait instead of walking the expression twice.
    if expr == nil { return false }
    if is_floaty == true { return false }
    var et = expr["type"]
    if et == "Integer" { return true }
    if et == "Float" { return false }
    if et == "String" { return false }
    if et == "Identifier" {
        var name = expr["value"]
        if ctx != nil {
            if ctx["locals_inty"] != nil {
                if ctx["locals_inty"][name] == true { return true }
            }
            if ctx["globals_inty"] != nil {
                if ctx["globals_inty"][name] == true { return true }
            }
        }
        return false
    }
    if et == "Prefix" {
        if expr["op"] == "-" || expr["op"] == "~" { return native_expr_is_inty(ctx, expr["right"]) }
        return false
    }
    if et == "Infix" {
        var op = expr["op"]
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
            if native_expr_is_inty(ctx, expr["left"]) && native_expr_is_inty(ctx, expr["right"]) { return true }
        }
        return false
    }
    if et == "Index" {
        if expr["recv_kind"] == "list_int" { return true }
        return false
    }
    if et == "Call" {
        var fnn = expr["fn"]
        var nm = nil
        if fnn != nil && fnn["type"] == "Identifier" {
            nm = fnn["value"]
        } else {
            if fnn != nil && fnn["type"] == "Member" {
                var prop = fnn["prop"]
                if prop != nil && prop["type"] == "Identifier" {
                    nm = prop["value"]
                }
            }
        }
        if nm != nil {
            if nm == "oren_int" { return true }
            if nm == "iadd" || nm == "isub" || nm == "imul" || nm == "idiv" || nm == "imod" { return true }
            if nm == "oren_trunc_int" { return true }
            if native_name_is_or_has_suffix(nm, "trunc_i64_from_f", "_trunc_i64_from_f") { return true }
            if native_name_is_or_has_suffix(nm, "_f64_bits", "_f64_bits") { return true }
            if nm == "oren_f32_to_u32_bits" { return true }
            if nm == "oren_f64_to_u64_bits" { return true }
            if nm == "oren_string_len" { return true }
            if nm == "oren_list_len" { return true }
            if nm == "oren_list_int_len" || nm == "STD_list_int_len" { return true }
            if nm == "oren_list_int_len_unchecked" || nm == "STD_list_int_len_unchecked" { return true }
            if nm == "oren_map_len" { return true }
            if nm == "oren_list_int_get" || nm == "STD_list_int_get" { return true }
            if nm == "oren_list_int_get_unchecked" || nm == "STD_list_int_get_unchecked" { return true }
            if nm == "oren_buf_len" { return true }
            if nm == "oren_buf_load_u8" || nm == "oren_buf_load_u8_unchecked" { return true }
            if nm == "oren_buf_load_i32" || nm == "oren_buf_load_i64" { return true }
            if nm == "oren_buf_dot_i32" || nm == "oren_buf_dot_i32_slice" || nm == "oren_buf_dot_i32_strided" { return true }
            if nm == "oren_buf_reduce_sum_i32" { return true }
        }
        return false
    }
    return false
}

fn native_expr_int_const(ctx, expr) {
    if expr == nil { return nil }
    if expr["type"] == "Integer" { return int_from_string(expr["value"]) }
    if expr["type"] == "Identifier" {
        var name = expr["value"]
        if ctx != nil && ctx["locals_int_const"] != nil {
            var v2 = ctx["locals_int_const"][name]
            if oren_type_tag(v2) != 0 { return v2 }
        }
        if ctx != nil && ctx["globals_int_const"] != nil {
            var v3 = ctx["globals_int_const"][name]
            if oren_type_tag(v3) != 0 { return v3 }
        }
    }
    return nil
}

fn native_expr_is_list_stringy(ctx, expr) {
    // Heuristic for "list of strings" propagation in the native backend.
    // This is used to make `xs[i] == "lit"` work when `xs` comes from known APIs like `oren_readdir`.
    if expr == nil { return false }
    var et = expr["type"]
    if et == "Array" {
        // Array literal -> runtime list. If all elements are stringy, treat as list-of-strings.
        var els = expr["elements"]
        if els == nil { return false }
        if oren_list_len(els) == 0 { return false }
        var i = 0
        while i < oren_list_len(els) {
            if native_expr_is_stringy(ctx, els[i]) != true { return false }
            i = i + 1
        }
        return true
    }
    if et == "Identifier" {
        var name = expr["value"]
        if ctx != nil {
            if ctx["locals_list_stringy"] != nil {
                if ctx["locals_list_stringy"][name] == true { return true }
            }
            if ctx["globals_list_stringy"] != nil {
                if ctx["globals_list_stringy"][name] == true { return true }
            }
        }
        return false
    }
    if et == "Index" {
        // Rolling heuristic: argparse parse results contain `pos: list<string>`.
        // Without this, `pos[i]` loses stringiness and breaks path/string concatenation in the native compiler.
        var idx = expr["index"]
        if idx != nil && idx["type"] == "String" {
            var k = idx["value"]
            if k == "pos" { return true }
        }
        return false
    }
    if et == "Call" {
        var fnn = expr["fn"]
        if fnn != nil && fnn["type"] == "Identifier" {
            var nm = fnn["value"]
            if nm == "oren_readdir" { return true }
            if nm == "oren_args" { return true }
        }
        return false
    }
    return false
}

fn native_expr_is_stringy(ctx, expr) {
    // Heuristic "string propagation" for the native backend.
    //
    // Native values are raw pointers; without a tagged value type we cannot decide at runtime,
    // so comparisons are lowered based on compile-time evidence.
    if expr == nil { return false }
    var et = expr["type"]
    if et == "String" { return true }
    if et == "Identifier" {
        var name = expr["value"]
        if ctx != nil {
            if ctx["locals_stringy"] != nil {
                if ctx["locals_stringy"][name] == true { return true }
            }
            if ctx["globals_stringy"] != nil {
                if ctx["globals_stringy"][name] == true { return true }
            }
        }
        return false
    }
    if et == "Index" {
        // Rolling heuristic: map indexing for known string fields.
        //
        // The self-hosted compiler heavily represents data as maps (tokens/AST/namespaces/argparse results).
        // When running via the native backend there is no runtime tagging, so we keep a narrow allowlist
        // of common keys whose values are strings in the compiler data model.
        var idx = expr["index"]
        if idx != nil && idx["type"] == "String" {
            var k = idx["value"]
            if k == "cmd" || k == "err" || k == "help" { return true } // argparse parse results
            if k == "type" || k == "literal" || k == "file" { return true } // lexer tokens
            if k == "ch" || k == "input" { return true } // lexer internal state map (rolling; native backend needs string ops)
            if k == "value" { return true } // common "string payload" field in AST nodes (Identifier/String/etc)
            if k == "name" || k == "path" || k == "prefix" || k == "full" || k == "alias" { return true } // module/link structures
            if k == "msg" || k == "kind" { return true } // diagnostics / errors
            if k == "backend" || k == "target" || k == "arch" || k == "out" || k == "cc" { return true } // CLI opts
        }
        if native_expr_is_list_stringy(ctx, expr["left"]) { return true }
        return false
    }
    if et == "Infix" {
        // String concat uses `+` and only returns STRING when BOTH operands are strings.
        // This must not propagate stringiness from a single-side string, otherwise
        // later `==` lowering may call strcmp on non-strings.
        if expr["op"] == "+" {
            if native_expr_is_stringy(ctx, expr["left"]) && native_expr_is_stringy(ctx, expr["right"]) { return true }
        }
        return false
    }
    if et == "Call" {
        var fnn = expr["fn"]
        if fnn != nil && fnn["type"] == "Identifier" {
            var nm = fnn["value"]
            // Known string-producing helpers in the injected runtime / stdlib.
            if nm == "oren_int_to_string" { return true }
            if nm == "oren_float_to_string" { return true }
            if nm == "oren_char" { return true }
            if nm == "oren_string_char_at" { return true }
            if nm == "oren_string_slice" { return true }
            if nm == "oren_string_from_bytes" { return true }
            if nm == "oren_realpath" { return true }
            if nm == "oren_realpath_checked" { return true }
            if nm == "oren_getcwd" { return true }
            if nm == "oren_env" { return true }
            if nm == "oren_read_file" { return true }
            if nm == "string_concat" { return true }
            // Propagate string from list_get when the list is known to contain strings.
            if nm == "oren_list_get" {
                var args = expr["args"]
                if args != nil {
                    if oren_list_len(args) >= 1 {
                        if native_expr_is_list_stringy(ctx, args[0]) { return true }
                    }
                }
            }
        }
        return false
    }
    return false
}

fn native_expr_call_returns_known_bool(nm) {
    if nm == nil { return false }
    if nm == "oren_is_err" { return true }
    if nm == "oren_string_eq" { return true }
    if nm == "native_value_is_nil" || nm == "native_value_is_false" || nm == "native_value_is_true" { return true }
    if nm == "_oren_generator_is_handle" { return true }
    if nm == "_oren_generator_is_context" { return true }
    if nm == "_oren_generator_started" { return true }
    if nm == "_oren_generator_done" { return true }
    if nm == "_oren_generator_closed" { return true }
    if nm == "_oren_generator_cancel_requested" { return true }
    if nm == "oren_generator_is_started" { return true }
    if nm == "oren_generator_is_done" { return true }
    if nm == "oren_generator_is_closed" { return true }
    if nm == "oren_generator_is_cancel_requested" { return true }
    return false
}

fn native_expr_known_not_string_for_dynamic_eq(ctx, expr) {
    if expr == nil { return false }
    var et = expr["type"]
    if et == "String" { return false }
    if et == "Integer" || et == "Float" || et == "Boolean" || et == "Nil" { return true }
    if et == "Array" || et == "Hash" { return true }
    if native_expr_is_stringy(ctx, expr) == true { return false }
    if native_expr_is_floaty(ctx, expr) == true { return true }
    if native_expr_is_inty(ctx, expr) == true { return true }
    if et == "Infix" {
        var op = expr["op"]
        if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" { return true }
        if op == "&&" || op == "||" { return true }
    }
    if et == "Prefix" {
        if expr["op"] == "!" { return true }
    }
    if et == "Call" {
        var fnn = expr["fn"]
        var nm = nil
        if fnn != nil && fnn["type"] == "Identifier" { nm = fnn["value"] }
        else {
            if fnn != nil && fnn["type"] == "Member" {
                var prop = fnn["prop"]
                if prop != nil && prop["type"] == "Identifier" { nm = prop["value"] }
            }
        }
        if native_expr_call_returns_known_bool(nm) == true { return true }
        if nm != nil && ctx != nil && ctx["func_ret_kinds"] != nil {
            var rk = ctx["func_ret_kinds"][nm]
            if rk != nil && rk != "string" { return true }
        }
    }
    return false
}

fn native_expr_needs_dynamic_string_eq(ctx, left, right) {
    if native_expr_is_stringy(ctx, left) == true { return false }
    if native_expr_is_stringy(ctx, right) == true { return false }
    if native_expr_known_not_string_for_dynamic_eq(ctx, left) == true { return false }
    if native_expr_known_not_string_for_dynamic_eq(ctx, right) == true { return false }
    return true
}
fn insn_strb(rt, rn) { return core.insn_strb(rt, rn) }
fn insn_add_imm(rd, rn, imm) { return core.insn_add_imm(rd, rn, imm) }
fn insn_ldadd(rs, rt, rn) { return core.insn_ldadd(rs, rt, rn) }
fn insn_cas(rs, rt, rn) { return core.insn_cas(rs, rt, rn) }
fn insn_ldaxr(rt, rn) { return core.insn_ldaxr(rt, rn) }
fn insn_stlxr(rs, rt, rn) { return core.insn_stlxr(rs, rt, rn) }
fn insn_clrex() { return core.insn_clrex() }
fn insn_ldrb(rt, rn) { return core.insn_ldrb(rt, rn) }
fn insn_mul(rd, rn, rm) { return core.insn_mul(rd, rn, rm) }
fn insn_udiv(rd, rn, rm) { return core.insn_udiv(rd, rn, rm) }
fn insn_sdiv(rd, rn, rm) { return core.insn_sdiv(rd, rn, rm) }
fn insn_movk(reg, imm16, shift_idx) { return core.insn_movk(reg, imm16, shift_idx) }
fn insn_adr(reg, imm) { return core.insn_adr(reg, imm) }
fn insn_br(rn) { return core.insn_br(rn) }

fn native_emit_panic(ctx, msg) {
    // Emit a runtime panic with a stable message string literal.
    //
    // We ensure the message is tracked so it can be safely used in string concatenations
    // inside `oren_diag_emit` even if allocations are tight.
    while int_mod(bytes_len(ctx["data"]), 8) != 0 {
        bytes_push(ctx["data"], 0)
    }
    var data_off = bytes_len(ctx["data"])
    bytes_extend_string(ctx["data"], msg)
    bytes_push(ctx["data"], 0) // NUL

    // X0 = &msg
    var adr_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off, "reg": nil})
    oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos)
    oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], data_off)
    oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 0)

    // oren_ensure_tracked(msg, kind=STRING)
    push_u32_le(ctx["code"], insn_movz(1, 1))
    var bl_track = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_track, "name": "oren_ensure_tracked"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_track)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], -2)

    // oren_panic(msg)  (never returns)
    var bl_panic = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_panic, "name": "oren_panic"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_panic)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], -1)
    return 0
}

fn native_compile_expr(ctx, expr) {
    if expr == nil {
        native_error(ctx, nil, "native backend: expr is nil")
        push_u32_le(ctx["code"], insn_movz(0, 0))
        return nil
    }
    if native_expr_chunk_noncall(ctx, expr) { return nil }
    if native_expr_chunk_call(ctx, expr) { return nil }
    native_error(ctx, expr["token"], "native backend: unsupported expr " + expr["type"])
    push_u32_le(ctx["code"], insn_movz(0, 0))
    return nil
}
