fn _arm64_hot_bl_compact_name(callee_name) {
    if callee_name == "oren_is_err" { return -7 }
    if callee_name == "oren_map_get_str" { return -8 }
    if callee_name == "oren_new_list" { return -9 }
    if callee_name == "oren_list_get" { return -10 }
    if callee_name == "oren_list_push_unchecked" { return -11 }
    if callee_name == "_list_find_node_known_kind" { return -12 }
    if callee_name == "oren_func" { return -13 }
    if callee_name == "oren_list_push" { return -14 }
    if callee_name == "oren_add" { return -15 }
    if callee_name == "oren_map_get_int" { return -16 }
    if callee_name == "STD_generator_next" { return -17 }
    if callee_name == "STD_generator_start" { return -18 }
    if callee_name == "strcmp" { return -19 }
    if callee_name == "STD_generator_send" { return -20 }
    if callee_name == "STD_generator_is_done" { return -21 }
    if callee_name == "oren_map_set_str" { return -22 }
    if callee_name == "oren_type_name" { return -23 }
    if callee_name == "STD_generator_cancel_reason" { return -24 }
    if callee_name == "_oren_generator_context_exchange" { return -25 }
    if callee_name == "STD_generator_is_cancel_requested" { return -26 }
    return callee_name
}

fn native_emit_gc_visible_call_expr(ctx, callee_name) {
    // Spill callee-saved regs so conservative GC sees register-held pointers.
    push_u32_le(ctx["code"], insn_stp_pair_pre(19, 20, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(21, 22, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(23, 24, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(25, 26, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(27, 28, 31, -16))

    var bl_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": callee_name})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], _arm64_hot_bl_compact_name(callee_name))

    push_u32_le(ctx["code"], insn_ldp_pair_post(27, 28, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(25, 26, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(23, 24, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(21, 22, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(19, 20, 31, 16))
    return nil
}

fn native_emit_named_bl_expr(ctx, callee_name) {
    var bl_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": callee_name})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], _arm64_hot_bl_compact_name(callee_name))
    return nil
}

fn _arm64_expr_resolve_g_storage_name(ctx) {
    if ctx == nil { return nil }
    var gname = ctx["rt_g_storage_name"]
    if gname != nil { return gname }
    if ctx["globals"] == nil { return nil }
    var match = nil
    var match_count = 0
    for k in ctx["globals"] {
        var klen = oren_string_len(k)
        var slen = 9
        if klen >= slen {
            var ok = true
            var j = 0
            while j < slen {
                if oren_string_char_at(k, klen - slen + j) != oren_string_char_at("g_storage", j) { ok = false; break }
                j = j + 1
            }
            if ok {
                match = k
                match_count = match_count + 1
                if match_count > 1 { break }
            }
        }
    }
    if match_count == 1 {
        ctx["rt_g_storage_name"] = match
        return match
    }
    return nil
}

fn _arm64_expr_emit_load_g_storage_ptr(ctx, tok, dst_reg) {
    var gname = _arm64_expr_resolve_g_storage_name(ctx)
    if gname == nil || ctx == nil || ctx["globals"] == nil || ctx["globals"][gname] == nil {
        native_error(ctx, tok, "native backend: missing runtime global g_storage")
        push_u32_le(ctx["code"], insn_movz(dst_reg, 0))
        return nil
    }
    var goff = ctx["globals"][gname] - 1
    var adr_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": goff, "reg": dst_reg})
    oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos)
    oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], goff)
    oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], dst_reg)
    push_u32_le(ctx["code"], insn_ldr_ptr(dst_reg, dst_reg))
    return nil
}

fn _arm64_expr_emit_load_singleton_ptr(ctx, tok, dst_reg, off) {
    _arm64_expr_emit_load_g_storage_ptr(ctx, tok, dst_reg)
    push_u32_le(ctx["code"], insn_ldr_ptr_off(dst_reg, dst_reg, off))
    return nil
}

fn _native_fp_offsets_push_unique(offs, fp_off) {
    if offs == nil { return 0 }
    if fp_off == nil || fp_off >= 0 { return 0 }
    var i = 0
    while i < oren_list_len(offs) {
        if offs[i] == fp_off { return 0 }
        i = i + 1
    }
    oren_list_push(offs, fp_off)
    return 0
}

fn _native_trace_gc_collect_offsets(ctx, offs) {
    var v = oren_env("OREN_TRACE_ARM64_GC_COLLECT_OFFSETS")
    if v == nil || v == "" || v == "0" { return 0 }
    var fn_name = ""
    if ctx != nil && ctx["cur_fn_name"] != nil { fn_name = ctx["cur_fn_name"] }
    print("[arm64_gc_collect_offsets] fn=" + fn_name +
        " count=" + oren_int_to_string(oren_list_len(offs)))
    var i = 0
    while i < oren_list_len(offs) {
        print("[arm64_gc_collect_offsets] i=" + oren_int_to_string(i) +
            " fp_off=" + oren_int_to_string(offs[i]))
        i = i + 1
    }
    return 0
}

fn _native_collect_active_local_fp_offsets(ctx) {
    var offs = []
    if ctx == nil { return offs }

    // Prefer the compiler's explicit locals map first: these slots are the authoritative
    // FP-relative homes for parameters and local variables even when the transient stack-depth
    // bookkeeping drifts around nested expressions or loop tick locals.
    var locals = ctx["locals"]
    if locals != nil {
        var idx = 0
        var pair = [nil, nil]
        while 1 {
            var ok = oren_iter_next_entry(locals, idx, pair)
            if ok == 0 { break }
            var off_enc = pair[1]
            if oren_type_tag(off_enc) == 1 {
                _native_fp_offsets_push_unique(offs, off_enc - 1)
            }
            idx = idx + 1
        }
    }

    // Also root the whole current FP-relative frame surface during explicit collection.
    // This stays conservative for temporary spill slots and loop-local tick storage that do
    // not appear in the locals map but can still carry live pointers at the collect site.
    var frame_bytes = ctx["stack_size"]
    if frame_bytes != nil && frame_bytes > 0 {
        var fp_off = -16
        while 0 - fp_off <= frame_bytes {
            _native_fp_offsets_push_unique(offs, fp_off)
            fp_off = fp_off - 16
        }
    }
    _native_trace_gc_collect_offsets(ctx, offs)
    return offs
}

fn native_emit_gc_root_push_locals_expr(ctx, fp_offsets) {
    if fp_offsets == nil { return 0 }
    var i = 0
    var count = 0
    while i < oren_list_len(fp_offsets) {
        emit_ldr_reg_fp_any(ctx, 0, fp_offsets[i])
        native_emit_named_bl_expr(ctx, "native_gc_root_push")
        count = count + 1
        i = i + 1
    }
    return count
}

fn native_emit_gc_root_pop_count_expr(ctx, count) {
    if count == nil || count <= 0 { return nil }
    emit_load_u64_imm(ctx, 0, count)
    native_emit_named_bl_expr(ctx, "native_gc_root_pop")
    return nil
}

fn native_emit_gc_collect_visible_call_expr(ctx, callee_name) {
    // Explicit collection is not on a hot path. Spill the full general-purpose root surface
    // so conservative GC can see caller-saved locals that never made it to the frame.
    // Keep x18 untouched because Darwin reserves it as the platform register.
    push_u32_le(ctx["code"], insn_stp_pair_pre(29, 30, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(27, 28, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(25, 26, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(23, 24, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(21, 22, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(19, 20, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(16, 17, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(14, 15, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(12, 13, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(10, 11, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(8, 9, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(6, 7, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(4, 5, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(2, 3, 31, -16))
    push_u32_le(ctx["code"], insn_stp_pair_pre(0, 1, 31, -16))
    native_emit_named_bl_expr(ctx, callee_name)

    push_u32_le(ctx["code"], insn_ldp_pair_post(0, 1, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(2, 3, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(4, 5, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(6, 7, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(8, 9, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(10, 11, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(12, 13, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(14, 15, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(16, 17, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(19, 20, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(21, 22, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(23, 24, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(25, 26, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(27, 28, 31, 16))
    push_u32_le(ctx["code"], insn_ldp_pair_post(29, 30, 31, 16))
    return nil
}

fn native_emit_gc_safepoint_call_expr(ctx) {
    return native_emit_gc_visible_call_expr(ctx, "oren_gc_safepoint")
}

fn native_emit_gc_collect_call_expr(ctx) {
    var fp_offsets = _native_collect_active_local_fp_offsets(ctx)
    var root_count = native_emit_gc_root_push_locals_expr(ctx, fp_offsets)
    native_emit_gc_collect_visible_call_expr(ctx, "oren_gc_collect")
    native_emit_gc_root_pop_count_expr(ctx, root_count)
    return nil
}

fn native_emit_gc_safepoint_call_expr_pairs(ctx, reg_pairs) {
    var i = 0
    while i < oren_list_len(reg_pairs) {
        var pair = reg_pairs[i]
        if pair != nil && oren_list_len(pair) >= 2 {
            push_u32_le(ctx["code"], insn_stp_pair_pre(pair[0], pair[1], 31, -16))
        }
        i = i + 1
    }

    var bl_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_gc_safepoint"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_gc_safepoint")

    i = oren_list_len(reg_pairs) - 1
    while i >= 0 {
        var pair2 = reg_pairs[i]
        if pair2 != nil && oren_list_len(pair2) >= 2 {
            push_u32_le(ctx["code"], insn_ldp_pair_post(pair2[0], pair2[1], 31, 16))
        }
        i = i - 1
    }
    return nil
}
