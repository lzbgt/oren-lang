fn native_emit_index_get_inline(ctx, expr) {
    // Fast-path list indexing directly in the native backend (no stdlib call),
    // with a deterministic fallback to `oren_map_get` for non-lists.
    //
    // Runtime list layout (native runtime v0):
    //   [count][capacity][buffer_ptr][magic]
    // where `magic == 1279870019` (`'LIST'`).

    // Evaluate container.
    native_compile_expr(ctx, expr["left"]) // container -> X0
    push_u32_le(ctx["code"], insn_sub_sp(16))
    push_u32_le(ctx["code"], insn_str_x0_sp(0))
    ctx["stack_size"] = ctx["stack_size"] + 16

    // Evaluate index.
    native_compile_expr(ctx, expr["index"]) // index -> X0

    // Pop container -> X1
    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
    push_u32_le(ctx["code"], insn_add_sp(16))
    ctx["stack_size"] = ctx["stack_size"] - 16

    // Swap: X0=index, X1=container -> X0=container, X1=index
    push_u32_le(ctx["code"], insn_mov_reg(2, 0)) // index -> X2
    push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // container -> X0
    push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // index -> X1

    // If container is nil, panic deterministically.
    push_u32_le(ctx["code"], insn_movz(2, 0))
    push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
    var br_non_nil = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    native_emit_panic(ctx, "Indexing on nil")
    var non_nil_pos = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_non_nil, insn_b_cond((non_nil_pos - br_non_nil) / 4, 1)) // NE

    // Load magic and dispatch: list fast-path vs map fallback.
    push_u32_le(ctx["code"], insn_add_imm(2, 0, 24)) // X2 = container + 24
    push_u32_le(ctx["code"], insn_ldr_ptr(3, 2))     // X3 = magic
    emit_load_i64_imm(ctx, 4, 1279870019)            // X4 = list_magic
    push_u32_le(ctx["code"], insn_cmp_reg(3, 4))
    var br_to_map = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)

    // --- List fast-path ---
    // count = *(container + 0)
    push_u32_le(ctx["code"], insn_ldr_ptr(5, 0)) // X5 = count

    // idx < 0 => panic (signed compare)
    push_u32_le(ctx["code"], insn_movz(2, 0))
    push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
    var br_nonneg = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    native_emit_panic(ctx, "Index out of bounds (negative)")
    var nonneg_pos = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_nonneg, insn_b_cond((nonneg_pos - br_nonneg) / 4, 10)) // GE

    // idx >= count => panic
    push_u32_le(ctx["code"], insn_cmp_reg(1, 5))
    var br_in_bounds = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    native_emit_panic(ctx, "Index out of bounds")
    var in_bounds_pos = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_in_bounds, insn_b_cond((in_bounds_pos - br_in_bounds) / 4, 11)) // LT

    // buf = *(container + 16)
    push_u32_le(ctx["code"], insn_add_imm(2, 0, 16))
    push_u32_le(ctx["code"], insn_ldr_ptr(6, 2)) // X6 = buf

    // addr = buf + idx*8
    emit_load_i64_imm(ctx, 2, 8)
    push_u32_le(ctx["code"], insn_mul(7, 1, 2))        // X7 = idx * 8
    push_u32_le(ctx["code"], insn_add_reg(7, 6, 7))    // X7 = buf + off
    push_u32_le(ctx["code"], insn_ldr_ptr(0, 7))       // X0 = *(addr)

    // Jump to done.
    var br_done = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)

    // --- Map fallback ---
    var map_pos = oren_list_len(ctx["code"])
    // X0=container, X1=index
    var bl_pos = oren_list_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_map_get"})

    // Done.
    var done_pos = oren_list_len(ctx["code"])
    set_u32_le(ctx["code"], br_to_map, insn_b_cond((map_pos - br_to_map) / 4, 1)) // NE
    set_u32_le(ctx["code"], br_done, insn_b((done_pos - br_done) / 4))
    return true
}

// Chunked out of native_compile_expr for include coherence (non-call expr types).
fn native_expr_chunk_noncall(ctx, expr) {

        if expr["type"] == "Function" {
            if expr["name"] == "" {
                var lname = expr["lambda_name"]
                if lname == nil {
                    native_error(ctx, expr["token"], "native backend: lambda not collected (missing lambda_name)")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
    
                var caps = expr["captures"]
                if caps == nil { caps = [] }
                var cap_count = oren_list_len(caps)
    
                if cap_count == 0 {
                    push_u32_le(ctx["code"], insn_movz(1, 0)) // env_ptr = 0
                } else {
                    // env_list = oren_new_list(0)
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    var bl_new_list = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list, "name": "oren_new_list"})
    
                    // Save env_list on stack across capture evals/pushes.
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    push_u32_le(ctx["code"], insn_str_x0_sp(0))
                    ctx["stack_size"] = ctx["stack_size"] + 16
    
                    var i_cap = 0
                    while i_cap < cap_count {
                        native_compile_expr(ctx, {"type": "Identifier", "value": caps[i_cap]})
    
                        // Save value
                        push_u32_le(ctx["code"], insn_sub_sp(16))
                        push_u32_le(ctx["code"], insn_str_x0_sp(0))
                        ctx["stack_size"] = ctx["stack_size"] + 16
    
                        // X0 = env_list, X1 = value
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 16))
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                        push_u32_le(ctx["code"], insn_add_sp(16))
                        ctx["stack_size"] = ctx["stack_size"] - 16
    
                        var bl_push = oren_list_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push, "name": "oren_list_push"})
                        i_cap = i_cap + 1
                    }
    
                    // Load env_list into X1 and pop it from the stack.
                    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                    push_u32_le(ctx["code"], insn_add_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] - 16
                }
    
                // X0 = code_ptr (lambda wrapper), X1 = env_ptr
                var adr_pos = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "adr_code", "pos": adr_pos, "name": lname, "reg": 0})
    
                var bl_make = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_make, "name": "oren_func"})
                return true
            }
    
            native_error(ctx, expr["token"], "native backend: unexpected Function expression (name=" + expr["name"] + ")")
            push_u32_le(ctx["code"], insn_movz(0, 0))
            return true
        }
    

        if expr["type"] == "String" {
            var s = expr["value"]
            var bytes = oren_bytes_from_string(s)
            bytes_push(bytes, 0) // Null terminator
            
            while int_mod(oren_list_len(ctx["data"]), 8) != 0 {
                bytes_push(ctx["data"], 0)
            }
            
            var data_off = oren_list_len(ctx["data"])
            bytes_extend(ctx["data"], bytes)
            
            var adr_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off})
            
            push_u32_le(ctx["code"], insn_movz(1, 1))
            var bl_ensure = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_ensure, "name": "oren_ensure_tracked"})
            return true
        }

    	    if expr["type"] == "SpawnExpr" {
    	        // Spawn-callable v0: lower to a runtime helper so callee can be a first-class callable
    	        // (function value, closure, or variable holding a callable).
    	        //
    	        // This keeps the spawn semantics in `lib/runtime_native.oren` and avoids duplicating
    	        // per-OS fork/pipe details in the code generator.
    	        var call2 = expr["call"]
    	        var args2 = call2["args"]
    	        var nargs2 = oren_list_len(args2)
    
    	        // args_list = oren_new_list(0)
    	        push_u32_le(ctx["code"], insn_movz(0, 0))
    	        var bl_new_list2 = oren_list_len(ctx["code"])
    	        push_u32_le(ctx["code"], 0)
    	        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list2, "name": "oren_new_list"})
    
    	        // Save args_list on stack across arg evals.
    	        push_u32_le(ctx["code"], insn_sub_sp(16))
    	        push_u32_le(ctx["code"], insn_str_x0_sp(0))
    	        ctx["stack_size"] = ctx["stack_size"] + 16
    
    	        var i_arg2 = 0
    	        while i_arg2 < nargs2 {
    	            native_compile_expr(ctx, args2[i_arg2]) // value -> X0
    	            push_u32_le(ctx["code"], insn_sub_sp(16))
    	            push_u32_le(ctx["code"], insn_str_x0_sp(0))
    	            ctx["stack_size"] = ctx["stack_size"] + 16
    
    	            // X0=args_list, X1=value
    	            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 16))
    	            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
    	            push_u32_le(ctx["code"], insn_add_sp(16))
    	            ctx["stack_size"] = ctx["stack_size"] - 16
    
    	            var bl_push2 = oren_list_len(ctx["code"])
    	            push_u32_le(ctx["code"], 0)
    	            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push2, "name": "oren_list_push"})
    	            i_arg2 = i_arg2 + 1
    	        }
    
    	        // fn_obj -> X0
    	        native_compile_expr(ctx, call2["fn"])
    
    	        // X1=args_list, pop stack
    	        push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
    	        push_u32_le(ctx["code"], insn_add_sp(16))
    	        ctx["stack_size"] = ctx["stack_size"] - 16
    
    		        var bl_spawn2 = oren_list_len(ctx["code"])
    		        push_u32_le(ctx["code"], 0)
    		        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_spawn2, "name": "oren_spawn_call_list"})
    		        return true
    		    }
    

    	    if expr["type"] == "Array" {
    	        var elements = expr["elements"]
    	        var count = oren_list_len(elements)
            
            // Build runtime list: call oren_new_list(0) then push elements (runtime grows as needed)
            push_u32_le(ctx["code"], insn_movz(0, 0))
            var bl_pos_list = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_list, "name": "oren_new_list"})
            
            // Stack: list in X0, push to preserve across pushes
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            var i_arr = 0
            while i_arr < count {
                native_compile_expr(ctx, elements[i_arr]) // -> X0 (value)
                // save value on stack
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                // load list -> X0
                push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 16)) // list is 16 bytes above current SP after push
                // load value -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                // pop value slot
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Call oren_list_push(list, elem)
                var bl_pos_push = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_push, "name": "oren_list_push"})
                i_arr = i_arr + 1
            }
            
            // Pop list back to X0 as result
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            return true
        }
    

        if expr["type"] == "Index" {
            return native_emit_index_get_inline(ctx, expr)
        }
    

        if expr["type"] == "Float" {
            var val = oren_string_to_float_bits(expr["value"])
            
            // Load 64-bit value using MOVZ/MOVK sequence
            // We use bitwise ops to handle potential sign bit correctly
            var chunk0 = val & 65535
            push_u32_le(ctx["code"], insn_movz(0, chunk0))
            
            var chunk1 = (val >> 16) & 65535
            if chunk1 != 0 || (val >> 32) != 0 {
                push_u32_le(ctx["code"], insn_movk(0, chunk1, 1))
            }
            
            var chunk2 = (val >> 32) & 65535
            if chunk2 != 0 || (val >> 48) != 0 {
                push_u32_le(ctx["code"], insn_movk(0, chunk2, 2))
            }
            
            var chunk3 = (val >> 48) & 65535
            if chunk3 != 0 {
                push_u32_le(ctx["code"], insn_movk(0, chunk3, 3))
            }
            return true
        }
    

        if expr["type"] == "Boolean" {
            if expr["value"] == true {
                push_u32_le(ctx["code"], insn_movz(0, 1))
            } else {
                push_u32_le(ctx["code"], insn_movz(0, 0))
            }
            return true
        }
    

        if expr["type"] == "Nil" {
            // Rolling native v0: represent nil as 0 (falsey).
            push_u32_le(ctx["code"], insn_movz(0, 0))
            return true
        }
    

        if expr["type"] == "Integer" {
            var val = int_from_string(expr["value"])
            // IMPORTANT: integers are i64 semantics in v0 (including negatives).
            // Never emit MOVZ with a negative imm16 (it yields an invalid encoding like 0xD27FFEE0).
            // Delegate to the shared immediate loader which handles:
            // - small positives (MOVZ)
            // - small negatives (MOVN)
            // - larger values (MOVZ/MOVK or load+neg)
            emit_load_i64_imm(ctx, 0, val)
            return true
        }

        if expr["type"] == "Identifier" {
            var name = expr["value"]
            
            // Check locals
            var off = ctx["locals"][name]
            if off != nil {
                var current_sp_off = ctx["stack_size"] - off - 16
                emit_ldr_reg_sp_any(ctx, 0, current_sp_off)
                return true
            }
    
            // Check globals
            var global_off = ctx["globals"][name]
            if global_off != nil {
                var adr_pos = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": global_off})
                // X0 has address. LDR X0, [X0]
                push_u32_le(ctx["code"], insn_ldr_ptr(0, 0))
                return true
            }
            
            // Check aliases (imported modules)
            if ctx["aliases"][name] != nil {
                native_error(ctx, expr["token"], "native backend: cannot use module '" + name + "' as value")
                push_u32_le(ctx["code"], insn_movz(0, 0))
                return true
            }
    
            // First-class function value (named function -> callable object).
            // Wrapper name convention: __oren_fnwrap_<fn>.
            if ctx["func_arity"] != nil {
                if ctx["func_arity"][name] != nil {
                    push_u32_le(ctx["code"], insn_movz(1, 0)) // env_ptr = 0
                    var wname = "__oren_fnwrap_" + name
                    var adr_pos2 = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "adr_code", "pos": adr_pos2, "name": wname, "reg": 0})
    
                    var bl_make2 = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_make2, "name": "oren_func"})
                    return true
                }
            }
            
            native_error(ctx, expr["token"], "native backend: undefined variable " + name)
            push_u32_le(ctx["code"], insn_movz(0, 0))
            return true
        }

        if expr["type"] == "Prefix" {
            if expr["op"] == "-" {
                if native_expr_is_floaty(ctx, expr["right"]) {
                    // Float negation: flip IEEE-754 sign bit.
                    native_compile_expr(ctx, expr["right"])
                    push_u32_le(ctx["code"], insn_movz(1, 0))
                    push_u32_le(ctx["code"], insn_movk(1, 32768, 3)) // 0x8000 << 48
                    push_u32_le(ctx["code"], insn_eor_reg(0, 0, 1))
                    return true
                }
                native_compile_expr(ctx, expr["right"])
                push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0)) // SUB X0, XZR, X0
                return true
            }
            if expr["op"] == "!" {
                // Logical not: treat 0 as false, non-zero as true.
                native_compile_expr(ctx, expr["right"])
                push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
                push_u32_le(ctx["code"], insn_cset(0, 0)) // EQ
                return true
            }
            if expr["op"] == "~" {
                // Bitwise not: x ^ -1
                native_compile_expr(ctx, expr["right"])
                push_u32_le(ctx["code"], insn_movn(1, 0)) // X1 = -1
                push_u32_le(ctx["code"], insn_eor_reg(0, 0, 1))
                return true
            }
            native_error(ctx, expr["token"], "native backend: unsupported prefix " + expr["op"])
            push_u32_le(ctx["code"], insn_movz(0, 0))
            return true
        }
    

        if expr["type"] == "Infix" {
            var op = expr["op"]
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
                // Compile Left
                native_compile_expr(ctx, expr["left"])
                
                // Push Left
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                // Compile Right
                native_compile_expr(ctx, expr["right"])
                
                // Pop Left -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Float arithmetic (rolling): if either side is known-floaty, lower to FP ops.
                // This is required to avoid silently treating float bit-patterns as ints/pointers.
                if op == "+" || op == "-" || op == "*" || op == "/" {
                    if native_expr_is_floaty(ctx, expr["left"]) || native_expr_is_floaty(ctx, expr["right"]) {
                        // Left: X1, Right: X0
                        if native_expr_is_floaty(ctx, expr["left"]) {
                            push_u32_le(ctx["code"], insn_fmov_d_x(0, 1))
                        } else {
                            push_u32_le(ctx["code"], insn_scvtf(0, 1))
                        }
                        if native_expr_is_floaty(ctx, expr["right"]) {
                            push_u32_le(ctx["code"], insn_fmov_d_x(1, 0))
                        } else {
                            push_u32_le(ctx["code"], insn_scvtf(1, 0))
                        }
                        if op == "+" { push_u32_le(ctx["code"], insn_fadd(0, 0, 1)) }
                        if op == "-" { push_u32_le(ctx["code"], insn_fsub(0, 0, 1)) }
                        if op == "*" { push_u32_le(ctx["code"], insn_fmul(0, 0, 1)) }
                        if op == "/" { push_u32_le(ctx["code"], insn_fdiv(0, 0, 1)) }
                        push_u32_le(ctx["code"], insn_umov_x_d(0, 0))
                        return true
                    }
                }
                
                if op == "+" { 
                    // Swap X0/X1 so X0=Left, X1=Right for oren_add call
                    push_u32_le(ctx["code"], insn_mov_reg(2, 0)) // Right -> X2
                    push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // Left -> X0
                    push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // Right -> X1
                    
                    var bl_pos = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_add"})
                }
                if op == "%" {
                    // Deterministic modulo semantics are implemented in the native runtime helper.
                    // (We need div0/overflow checks; hardware division does not trap.)
                    //
                    // Swap X0/X1 so X0=Left, X1=Right for oren_mod call
                    push_u32_le(ctx["code"], insn_mov_reg(2, 0)) // Right -> X2
                    push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // Left -> X0
                    push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // Right -> X1
    
                    var bl_pos2 = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos2, "name": "oren_mod"})
                }
                if op == "-" { push_u32_le(ctx["code"], insn_sub_reg(0, 1, 0)) }
                if op == "*" { push_u32_le(ctx["code"], insn_mul(0, 1, 0)) }
                if op == "/" {
                    // Deterministic error instead of arch-specific behavior:
                    // - div by zero: x86 idiv traps, arm64 sdiv does not
                    // - i64_min / -1: overflows in two's complement (x86 traps)

                    // if divisor == 0 => panic
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 31)) // cmp x0, xzr
                    var br_div_nonzero = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // b.ne <ok>
                    native_emit_panic(ctx, "division by zero")
                    var div_nonzero_pos = oren_list_len(ctx["code"])
                    set_u32_le(ctx["code"], br_div_nonzero, insn_b_cond((div_nonzero_pos - br_div_nonzero) / 4, 1)) // NE

                    // if (a == i64_min && b == -1) => panic
                    emit_load_i64_imm(ctx, 2, -1)
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
                    var br_not_minus1 = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // b.ne <ok>

                    var i64_min = 0 - (1 << 63)
                    emit_load_i64_imm(ctx, 3, i64_min)
                    push_u32_le(ctx["code"], insn_cmp_reg(1, 3))
                    var br_not_min = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // b.ne <ok>

                    native_emit_panic(ctx, "division overflow (i64_min / -1)")
                    var div_ok_pos = oren_list_len(ctx["code"])
                    set_u32_le(ctx["code"], br_not_minus1, insn_b_cond((div_ok_pos - br_not_minus1) / 4, 1)) // NE
                    set_u32_le(ctx["code"], br_not_min, insn_b_cond((div_ok_pos - br_not_min) / 4, 1)) // NE

                    push_u32_le(ctx["code"], insn_sdiv(0, 1, 0))
                }
                if op == "&" { push_u32_le(ctx["code"], insn_and_reg(0, 1, 0)) }
                if op == "|" { push_u32_le(ctx["code"], insn_orr_reg(0, 1, 0)) }
                if op == "^" { push_u32_le(ctx["code"], insn_eor_reg(0, 1, 0)) }
                if op == "<<" || op == ">>" {
                    // Deterministic error instead of arch-defined masking:
                    // shift count must be 0..63.
                    //
                    // X1 = lhs, X0 = rhs (shift count)
                    var msg = "shl shift count out of range (need 0..63)"
                    if op == ">>" { msg = "shr shift count out of range (need 0..63)" }

                    // if rhs < 0 => panic
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 31)) // cmp x0, xzr
                    var br_nonneg = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // b.ge <ok>
                    native_emit_panic(ctx, msg)
                    var nonneg_pos = oren_list_len(ctx["code"])
                    set_u32_le(ctx["code"], br_nonneg, insn_b_cond((nonneg_pos - br_nonneg) / 4, 10)) // GE

                    // if rhs >= 64 => panic
                    emit_load_i64_imm(ctx, 2, 64)
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
                    var br_lt64 = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // b.lt <ok>
                    native_emit_panic(ctx, msg)
                    var lt64_pos = oren_list_len(ctx["code"])
                    set_u32_le(ctx["code"], br_lt64, insn_b_cond((lt64_pos - br_lt64) / 4, 11)) // LT

                    if op == "<<" { push_u32_le(ctx["code"], insn_lslv(0, 1, 0)) }
                    else { push_u32_le(ctx["code"], insn_lsrv(0, 1, 0)) }
                }
                return true
            }
            
            var is_cmp = false
            var cond_code = 0
            if op == "==" { is_cmp = true; cond_code = 0 } // EQ
            if op == "!=" { is_cmp = true; cond_code = 1 } // NE
            if op == "<"  { is_cmp = true; cond_code = 11 } // LT
            if op == ">"  { is_cmp = true; cond_code = 12 } // GT
            if op == "<=" { is_cmp = true; cond_code = 13 } // LE
            if op == ">=" { is_cmp = true; cond_code = 10 } // GE
            
            if is_cmp {
                 // Compile Left
                native_compile_expr(ctx, expr["left"])
                
                // Push Left
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                // Compile Right
                native_compile_expr(ctx, expr["right"])
                
                // Pop Left -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Float comparisons (rolling): if either side is known-floaty, use FCMP.
                if native_expr_is_floaty(ctx, expr["left"]) || native_expr_is_floaty(ctx, expr["right"]) {
                    if native_expr_is_floaty(ctx, expr["left"]) { push_u32_le(ctx["code"], insn_fmov_d_x(0, 1)) }
                    else { push_u32_le(ctx["code"], insn_scvtf(0, 1)) }
    
                    if native_expr_is_floaty(ctx, expr["right"]) { push_u32_le(ctx["code"], insn_fmov_d_x(1, 0)) }
                    else { push_u32_le(ctx["code"], insn_scvtf(1, 0)) }
    
                    push_u32_le(ctx["code"], insn_fcmp(0, 1))
                    // Reuse AArch64 cond codes:
                    // EQ=0, NE=1, MI(<)=4, GE=10, GT=12, LE=13
                    var fcond = cond_code
                    if op == "<"  { fcond = 4 }
                    if op == ">"  { fcond = 12 }
                    if op == "<=" { fcond = 13 }
                    if op == ">=" { fcond = 10 }
                    push_u32_le(ctx["code"], insn_cset(0, fcond))
                    return true
                }
    
    
                // String comparisons (rolling):
                //
                // Prefer `strcmp` when we have strong evidence that we are comparing strings,
                // otherwise fall back to integer compare.
                //
                // IMPORTANT:
                // - `strcmp` is nil-safe in the injected runtime.
                // - But native values are untagged, so calling `strcmp` on an integer would crash.
                // - Early in native self-hosting, stringiness inference can miss some identifiers
                //   (notably function parameters like `ch` in `token.is_letter(ch)`).
                //
                // Pragmatic rule (for self-hosting correctness):
                // - If either side is `nil`, never call strcmp (keep integer compare semantics).
                // - Otherwise, call strcmp when BOTH sides are known-stringy, OR when either side is
                //   a string literal and the other side is not an obvious numeric literal.
                var l_is_nil = false
                var r_is_nil = false
                if expr["left"] != nil && expr["left"]["type"] == "Nil" { l_is_nil = true }
                if expr["right"] != nil && expr["right"]["type"] == "Nil" { r_is_nil = true }

                var allow_strcmp = false
                if l_is_nil != true && r_is_nil != true {
                    var ls = native_expr_is_stringy(ctx, expr["left"])
                    var rs = native_expr_is_stringy(ctx, expr["right"])
                    if ls && rs {
                        allow_strcmp = true
                    } else {
                        // If either side is already known-stringy, prefer strcmp unless the other side
                        // is an obvious numeric literal. This is critical for compiler/stdlib helpers
                        // like `token.is_whitespace(ch)` where `ch` is a parameter (often not inferred),
                        // but it is compared against known string constants (e.g. CH_LF/CH_CR).
                        if ls && allow_strcmp != true {
                            if expr["right"] != nil {
                                var rt = expr["right"]["type"]
                                if rt != "Integer" && rt != "Float" && rt != "Boolean" { allow_strcmp = true }
                            }
                        }
                        if rs && allow_strcmp != true {
                            if expr["left"] != nil {
                                var lt = expr["left"]["type"]
                                if lt != "Integer" && lt != "Float" && lt != "Boolean" { allow_strcmp = true }
                            }
                        }
                        var l_lit = false
                        var r_lit = false
                        if expr["left"] != nil && expr["left"]["type"] == "String" { l_lit = true }
                        if expr["right"] != nil && expr["right"]["type"] == "String" { r_lit = true }

                        if allow_strcmp != true && (l_lit || r_lit) {
                            var other = expr["left"]
                            if l_lit { other = expr["right"] } else { other = expr["left"] }
                            if other != nil {
                                var ot = other["type"]
                                if ot != "Integer" && ot != "Float" && ot != "Boolean" {
                                    allow_strcmp = true
                                }
                            }
                        }
                    }
                }

                if allow_strcmp {
                    // Runtime safety guard:
                    // - Native values are untagged; if either operand is a small int (e.g. bool=1),
                    //   calling strcmp would crash by dereferencing near-null addresses.
                    // - Treat values < 4096 as non-strings and fall back to integer compare.
                    //
                    // At this point: X1=left, X0=right (from the earlier push/pop sequence).
                    push_u32_le(ctx["code"], insn_movz(3, 4096))
                    push_u32_le(ctx["code"], insn_cmp_reg(1, 3))
                    var br_lt_left = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B.LT -> int_compare

                    push_u32_le(ctx["code"], insn_cmp_reg(0, 3))
                    var br_lt_right = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B.LT -> int_compare

                    // Want strcmp(left, right): X0=left, X1=right. Currently X1=left, X0=right.
                    push_u32_le(ctx["code"], insn_mov_reg(2, 0)) // right -> X2
                    push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // left  -> X0
                    push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // right -> X1
                    var bl_pos_s = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_s, "name": "strcmp"})
                    // strcmp returns -1/0/1 in X0. Compare against 0.
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
                    var scond = cond_code
                    if op == "==" { scond = 0 }
                    if op == "!=" { scond = 1 }
                    if op == "<"  { scond = 11 }
                    if op == ">"  { scond = 12 }
                    if op == "<=" { scond = 13 }
                    if op == ">=" { scond = 10 }
                    push_u32_le(ctx["code"], insn_cset(0, scond))

                    var br_end = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B end

                    // int_compare:
                    var int_pos = oren_list_len(ctx["code"])
                    set_u32_le(ctx["code"], br_lt_left, insn_b_cond((int_pos - br_lt_left) / 4, 11)) // LT
                    set_u32_le(ctx["code"], br_lt_right, insn_b_cond((int_pos - br_lt_right) / 4, 11)) // LT
                    push_u32_le(ctx["code"], insn_cmp_reg(1, 0))
                    push_u32_le(ctx["code"], insn_cset(0, cond_code))

                    var end_pos = oren_list_len(ctx["code"])
                    set_u32_le(ctx["code"], br_end, insn_b((end_pos - br_end) / 4))
                    return true
                }
                
                // CMP X1, X0
                push_u32_le(ctx["code"], insn_cmp_reg(1, 0))
                
                // CSET X0, cond
                push_u32_le(ctx["code"], insn_cset(0, cond_code))
                return true
            }
            
            if op == "&&" || op == "||" {
                // Short-circuit boolean ops (0 is false, non-zero is true), result is 0/1.
                //
                // &&:
                //   if left == 0 -> 0
                //   else -> (right != 0)
                //
                // ||:
                //   if left != 0 -> 1
                //   else -> (right != 0)
    
                native_compile_expr(ctx, expr["left"])
                push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
    
                if op == "&&" {
                    var jump_false_pos = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B.EQ false
    
                    native_compile_expr(ctx, expr["right"])
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
                    push_u32_le(ctx["code"], insn_cset(0, 1)) // NE
    
                    var jump_end_pos = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B end
    
                    var false_target = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], insn_movz(0, 0))
    
                    var end_target = oren_list_len(ctx["code"])
                    set_u32_le(ctx["code"], jump_false_pos, insn_b_cond((false_target - jump_false_pos) / 4, 0)) // EQ
                    set_u32_le(ctx["code"], jump_end_pos, insn_b((end_target - jump_end_pos) / 4))
                    return true
                } else {
                    var jump_true_pos = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B.NE true
    
                    native_compile_expr(ctx, expr["right"])
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 31))
                    push_u32_le(ctx["code"], insn_cset(0, 1)) // NE
    
                    var jump_end_pos2 = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B end
    
                    var true_target = oren_list_len(ctx["code"])
                    push_u32_le(ctx["code"], insn_movz(0, 1))
    
                    var end_target2 = oren_list_len(ctx["code"])
                    set_u32_le(ctx["code"], jump_true_pos, insn_b_cond((true_target - jump_true_pos) / 4, 1)) // NE
                    set_u32_le(ctx["code"], jump_end_pos2, insn_b((end_target2 - jump_end_pos2) / 4))
                    return true
                }
            }
            
            native_error(ctx, expr["token"], "native backend: unsupported operator " + op)
            push_u32_le(ctx["code"], insn_movz(0, 0))
            return true
        }
        

        if expr["type"] == "Hash" {
            // Hash literal { k: v, ... } -> oren_new_map(count) -> oren_map_set...
            var pairs = expr["pairs"]
            var count = oren_list_len(pairs)
            
            // oren_new_map(count) -> X0
            // We manually construct call logic for oren_new_map
            push_u32_le(ctx["code"], insn_movz(0, count)) // Arg 0 = count
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            var bl_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_new_map"})
            
            // X0 has map. Push it.
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            var i = 0
            while i < count {
                var k = pairs[i]["key"]
                var v = pairs[i]["value"]
                
                // Push k
                native_compile_expr(ctx, k)
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                // Push v
                native_compile_expr(ctx, v)
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                // Pop v -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                // Pop k -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                // Peek m -> X0
                push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
                
                // oren_map_set(X0, X1, X2)
                var bl_pos2 = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos2, "name": "oren_map_set"})
                
                i = i + 1
            }
            
            // Pop m -> X0
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            return true
        }
        

        if expr["type"] == "Member" {
            var nsr = native_ns_resolve(ctx, expr)
            if nsr != nil {
                if nsr["is_ns"] == true {
                    native_error(ctx, expr["token"], "native backend: cannot use namespace '" + nsr["name"] + "' as value")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
                native_compile_expr(ctx, {"type": "Identifier", "value": nsr["name"]});
                return true
            }
    
            var prop_name = expr["prop"]["value"]
    
            // a.x -> oren_map_get(a, "x")
            native_compile_expr(ctx, expr["left"]) // a -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            var bytes = oren_bytes_from_string(prop_name)
            bytes_push(bytes, 0)
            var data_off = oren_list_len(ctx["data"])
            bytes_extend(ctx["data"], bytes)
            var adr_pos = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off})
            
            // Push key -> stack
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16
            
            // Pop key -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            // Pop obj -> X0
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            
            var bl_pos3 = oren_list_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos3, "name": "oren_map_get"})
            
            return true
        }
    

        if expr["type"] == "Index" {
            return native_emit_index_get_inline(ctx, expr)
        }
        

    return false
}
