var g_native_assume_list_index = -1

fn _native_assume_list_index_enabled() {
    if g_native_assume_list_index != -1 { return g_native_assume_list_index == 1 }
    var v = oren_env("OREN_NATIVE_ASSUME_LIST_INDEX")
    if v != nil && v != "" && v != "0" { g_native_assume_list_index = 1 } else { g_native_assume_list_index = 0 }
    return g_native_assume_list_index == 1
}

fn _native_expr_str_eq_bytes(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _native_data_add_map_key_cstr0_cached(ctx, s) {
    if ctx == nil { return nil }
    if s == nil { s = "" }
    var names = ctx["arm64_map_key_cstr0_mru_names"]
    var offs = ctx["arm64_map_key_cstr0_mru_offs"]
    if names == nil || offs == nil {
        names = []
        offs = []
        ctx["arm64_map_key_cstr0_mru_names"] = names
        ctx["arm64_map_key_cstr0_mru_offs"] = offs
    }
    var i = 0
    var n = oren_list_len(names)
    while i < n {
        if _native_expr_str_eq_bytes(names[i], s) == true { return offs[i] }
        i = i + 1
    }

    var off = native_data_add_cstr0(ctx, s)
    if off == nil { return nil }
    var cap = 16
    if n < cap {
        oren_list_push(names, s)
        oren_list_push(offs, off)
        return off
    }
    var next = ctx["arm64_map_key_cstr0_mru_next"]
    if oren_type_tag(next) == 0 { next = 0 }
    names[next] = s
    offs[next] = off
    next = next + 1
    if next >= cap { next = 0 }
    ctx["arm64_map_key_cstr0_mru_next"] = next
    return off
}

fn _native_data_add_string_lit_cstr0_cached(ctx, s) {
    if ctx == nil { return nil }
    if s == nil { s = "" }
    var names = ctx["arm64_string_lit_cstr0_mru_names"]
    var offs = ctx["arm64_string_lit_cstr0_mru_offs"]
    if names == nil || offs == nil {
        names = []
        offs = []
        ctx["arm64_string_lit_cstr0_mru_names"] = names
        ctx["arm64_string_lit_cstr0_mru_offs"] = offs
    }
    var i = 0
    var n = oren_list_len(names)
    while i < n {
        if _native_expr_str_eq_bytes(names[i], s) == true { return offs[i] }
        i = i + 1
    }

    var off = native_data_add_cstr0(ctx, s)
    if off == nil { return nil }
    var cap = 16
    if n < cap {
        oren_list_push(names, s)
        oren_list_push(offs, off)
        return off
    }
    var next = ctx["arm64_string_lit_cstr0_mru_next"]
    if oren_type_tag(next) == 0 { next = 0 }
    names[next] = s
    offs[next] = off
    next = next + 1
    if next >= cap { next = 0 }
    ctx["arm64_string_lit_cstr0_mru_next"] = next
    return off
}

fn _native_emit_load_cstr0_reg(ctx, s, reg) {
    var data_off = _native_data_add_map_key_cstr0_cached(ctx, s)
    if data_off == nil {
        native_error(ctx, nil, "native backend: failed to add string literal data")
        push_u32_le(ctx["code"], insn_movz(reg, 0))
        return false
    }
    var adr_pos = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off, "reg": reg})
    oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos)
    oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], data_off)
    oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], reg)
    return true
}

fn _native_expr_record_stmt_profile(ctx, label, t0, code0) {
    if ctx == nil { return nil }
    var rows = ctx["arm64_stmt_profile"]
    if rows == nil { return nil }
    var phase = ctx["arm64_codegen_phase"]
    if phase == nil { phase = "" }
    var fn_name = ctx["cur_fn_name"]
    if fn_name == nil { fn_name = "" }
    if label == nil { label = "" }
    var key = phase + "\t" + fn_name + "\t" + label
    var row = rows[key]
    if row == nil {
        row = {"phase": phase, "fn": fn_name, "stmt": label, "count": 0, "ms": 0, "bytes": 0}
        rows[key] = row
    }
    row["count"] = row["count"] + 1
    row["ms"] = row["ms"] + ((oren_time_now_ns() - t0) / 1000000)
    row["bytes"] = row["bytes"] + (bytes_len(ctx["code"]) - code0)
    return nil
}

fn _native_expr_subprof_start(ctx) {
    if ctx == nil || ctx["arm64_stmt_profile"] == nil { return nil }
    return {"t": oren_time_now_ns(), "code": bytes_len(ctx["code"])}
}

fn _native_expr_subprof_done(ctx, label, start) {
    if start == nil { return nil }
    return _native_expr_record_stmt_profile(ctx, label, start["t"], start["code"])
}

fn native_emit_index_get_map_str_lit_inline(ctx, expr) {
    if expr == nil || expr["type"] != "Index" { return false }
    if expr["recv_kind"] != "map" { return false }
    var ix = expr["index"]
    if ix == nil || ix["type"] != "String" { return false }

    var prof_start = _native_expr_subprof_start(ctx)
    native_compile_expr(ctx, expr["left"]) // container -> X0
    _native_expr_subprof_done(ctx, "MapStrIndex(eval_recv)", prof_start)

    // Preserve the existing deterministic index contract: nil and non-map values still panic.
    prof_start = _native_expr_subprof_start(ctx)
    push_u32_le(ctx["code"], insn_movz(2, 0))
    push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
    var br_non_nil = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    native_emit_panic(ctx, "Indexing on nil")
    var non_nil_pos = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], br_non_nil, insn_b_cond((non_nil_pos - br_non_nil) / 4, 1)) // NE

    push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = container
    var bl_find_node = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find_node, "name": "oren_find_node"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find_node)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], -6)

    push_u32_le(ctx["code"], insn_movz(4, 0))
    push_u32_le(ctx["code"], insn_cmp_reg(0, 4))
    var br_node_nonzero = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    native_emit_panic(ctx, "Index recv_kind=map but value is not a map")
    var node_ok_pos = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], br_node_nonzero, insn_b_cond((node_ok_pos - br_node_nonzero) / 4, 1)) // NE

    emit_load_ptr_from_base_plus(ctx, 4, 0, 16) // X4 = tracked node kind
    emit_load_i64_imm(ctx, 5, 3) // X5 = MAP
    push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
    var br_is_map = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    native_emit_panic(ctx, "Index recv_kind=map but value is not a map")
    var map_kind_ok_pos = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], br_is_map, insn_b_cond((map_kind_ok_pos - br_is_map) / 4, 0)) // EQ

    push_u32_le(ctx["code"], insn_mov_reg(0, 19))
    push_u32_le(ctx["code"], insn_add_imm(2, 0, 24))
    push_u32_le(ctx["code"], insn_ldr_ptr(3, 2))
    emit_load_i64_imm(ctx, 4, 1296121168)
    push_u32_le(ctx["code"], insn_cmp_reg(3, 4))
    var br_magic_ok = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    native_emit_panic(ctx, "Index recv_kind=map but value is not a map")
    var magic_ok_pos = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], br_magic_ok, insn_b_cond((magic_ok_pos - br_magic_ok) / 4, 0)) // EQ

    _native_expr_subprof_done(ctx, "MapStrIndex(validate)", prof_start)
    prof_start = _native_expr_subprof_start(ctx)
    if _native_emit_load_cstr0_reg(ctx, ix["value"], 1) != true { return true }
    _native_expr_subprof_done(ctx, "MapStrIndex(load_key)", prof_start)
    prof_start = _native_expr_subprof_start(ctx)
    native_emit_named_bl_expr(ctx, "oren_map_get_str")
    _native_expr_subprof_done(ctx, "MapStrIndex(call)", prof_start)
    return true
}

fn native_emit_index_get_inline(ctx, expr) {
    // Fast-path list indexing directly in the native backend (no stdlib call),
    // with a deterministic fallback to typed `oren_map_get_*` for non-lists.
    //
    // Runtime list layout (native runtime v0):
    //   [count][capacity][buffer_ptr][magic]
    // where `magic == 1279870019` (`'LIST'`).

    // Evaluate container.
    native_compile_expr(ctx, expr["left"]) // container -> X0
    push_u32_le(ctx["code"], insn_sub_sp(16))
    push_u32_le(ctx["code"], insn_str_x0_sp(0))
    ctx["stack_size"] = ctx["stack_size"] + 16

    // Evaluate index.
    native_compile_expr(ctx, expr["index"]) // index -> X0

    // Pop container -> X1
    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
    push_u32_le(ctx["code"], insn_add_sp(16))
    ctx["stack_size"] = ctx["stack_size"] - 16

    // Swap: X0=index, X1=container -> X0=container, X1=index
    push_u32_le(ctx["code"], insn_mov_reg(2, 0)) // index -> X2
    push_u32_le(ctx["code"], insn_mov_reg(0, 1)) // container -> X0
    push_u32_le(ctx["code"], insn_mov_reg(1, 2)) // index -> X1

    // If container is nil, panic deterministically.
    push_u32_le(ctx["code"], insn_movz(2, 0))
    push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
    var br_non_nil = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    native_emit_panic(ctx, "Indexing on nil")
    var non_nil_pos = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], br_non_nil, insn_b_cond((non_nil_pos - br_non_nil) / 4, 1)) // NE

    // Perf-only fast path: assume recv_kind=list/list_int and index is in bounds.
    var recv_kind0 = expr["recv_kind"]
    if (recv_kind0 == "list" || recv_kind0 == "list_int") && _native_assume_list_index_enabled() == true {
        // buf = *(container + 16)
        push_u32_le(ctx["code"], insn_add_imm(2, 0, 16))
        push_u32_le(ctx["code"], insn_ldr_ptr(6, 2)) // X6 = buf
        // addr = buf + idx*8
        emit_load_i64_imm(ctx, 2, 8)
        push_u32_le(ctx["code"], insn_mul(7, 1, 2))        // X7 = idx * 8
        push_u32_le(ctx["code"], insn_add_reg(7, 6, 7))    // X7 = buf + off
        push_u32_le(ctx["code"], insn_ldr_ptr(0, 7))       // X0 = *(addr)
        return true
    }

    // Tier‑1 safety: never read object headers from untracked pointers.
    //
    // In the native v0 carrier model, immediates and pointers share the same i64 slot, so we
    // must only treat `container` as a list/map pointer if it is tracked.
    //
    // Use the same tracked-node kind contract as the runtime (and as x86_64):
    // - kind==2 => LIST
    // - kind==3 => MAP
    //
    // Preserve container/index across the probe call using callee-saved registers.
    push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = container
    push_u32_le(ctx["code"], insn_mov_reg(20, 1)) // X20 = index

    // node = oren_find_node(container)
    push_u32_le(ctx["code"], insn_mov_reg(0, 19))
    var bl_find_node = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find_node, "name": "oren_find_node"})
    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find_node)
    oren_list_push(ctx["fixups_local_compact"]["bl_name"], -6)

    // If node == 0 => not a tracked container => panic deterministically.
    push_u32_le(ctx["code"], insn_movz(4, 0))
    push_u32_le(ctx["code"], insn_cmp_reg(0, 4))
    var br_node_nonzero = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    recv_kind0 = expr["recv_kind"]
    if recv_kind0 == "list" {
        native_emit_panic(ctx, "Index recv_kind=list but value is not a list")
    } else if recv_kind0 == "list_int" {
        native_emit_panic(ctx, "Index recv_kind=list_int but value is not a list_int")
    } else if recv_kind0 == "map" {
        native_emit_panic(ctx, "Index recv_kind=map but value is not a map")
    } else {
        native_emit_panic(ctx, "Indexing on non-container (expected list or map)")
    }
    var node_ok_pos = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], br_node_nonzero, insn_b_cond((node_ok_pos - br_node_nonzero) / 4, 1)) // NE

    // kind = *(node + 16)
    emit_load_ptr_from_base_plus(ctx, 4, 0, 16) // X4 = kind

    // Dispatch to list vs map.
    var br_to_map = nil
    if recv_kind0 == "list" {
        emit_load_i64_imm(ctx, 5, 2) // X5 = LIST
        push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
        var br_is_list = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        emit_load_i64_imm(ctx, 5, 8) // X5 = LIST_INT
        push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
        var br_is_list_int = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        native_emit_panic(ctx, "Index recv_kind=list but value is not a list")
        var list_ok_pos = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], br_is_list, insn_b_cond((list_ok_pos - br_is_list) / 4, 0)) // EQ
        set_u32_le(ctx["code"], br_is_list_int, insn_b_cond((list_ok_pos - br_is_list_int) / 4, 0)) // EQ
    } else if recv_kind0 == "list_int" {
        emit_load_i64_imm(ctx, 5, 8) // X5 = LIST_INT
        push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
        var br_is_list_int2 = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        native_emit_panic(ctx, "Index recv_kind=list_int but value is not a list_int")
        var list_int_ok_pos = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], br_is_list_int2, insn_b_cond((list_int_ok_pos - br_is_list_int2) / 4, 0)) // EQ
    } else if recv_kind0 == "map" {
        emit_load_i64_imm(ctx, 5, 3) // X5 = MAP
        push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
        br_to_map = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        native_emit_panic(ctx, "Index recv_kind=map but value is not a map")
        // map label is patched later; list block will be skipped by the branch.
    } else {
        // Unknown at compile-time => dynamic kind dispatch (LIST or MAP).
        emit_load_i64_imm(ctx, 5, 2) // X5 = LIST
        push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
        var br_is_list2 = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)

        emit_load_i64_imm(ctx, 5, 8) // X5 = LIST_INT
        push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
        var br_is_list2_int = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)

        emit_load_i64_imm(ctx, 5, 3) // X5 = MAP
        push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
        br_to_map = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)

        native_emit_panic(ctx, "Indexing on non-container (expected list or map)")
        var list_pos = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], br_is_list2, insn_b_cond((list_pos - br_is_list2) / 4, 0)) // EQ
        set_u32_le(ctx["code"], br_is_list2_int, insn_b_cond((list_pos - br_is_list2_int) / 4, 0)) // EQ
        // If kind==MAP, `br_to_map` is patched later to map_pos.
    }

    var br_done = nil
    if recv_kind0 != "map" {
        // --- List fast-path ---
        // Restore container/index (X0=container, X1=index).
        push_u32_le(ctx["code"], insn_mov_reg(0, 19))
        push_u32_le(ctx["code"], insn_mov_reg(1, 20))
        // count = *(container + 0)
        push_u32_le(ctx["code"], insn_ldr_ptr(5, 0)) // X5 = count

        // idx < 0 => panic (signed compare)
        push_u32_le(ctx["code"], insn_movz(2, 0))
        push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
        var br_nonneg = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        native_emit_panic(ctx, "Index out of bounds (negative)")
        var nonneg_pos = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], br_nonneg, insn_b_cond((nonneg_pos - br_nonneg) / 4, 10)) // GE

        // idx >= count => panic
        push_u32_le(ctx["code"], insn_cmp_reg(1, 5))
        var br_in_bounds = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
        native_emit_panic(ctx, "Index out of bounds")
        var in_bounds_pos = bytes_len(ctx["code"])
        set_u32_le(ctx["code"], br_in_bounds, insn_b_cond((in_bounds_pos - br_in_bounds) / 4, 11)) // LT

        // buf = *(container + 16)
        push_u32_le(ctx["code"], insn_add_imm(2, 0, 16))
        push_u32_le(ctx["code"], insn_ldr_ptr(6, 2)) // X6 = buf

        // addr = buf + idx*8
        emit_load_i64_imm(ctx, 2, 8)
        push_u32_le(ctx["code"], insn_mul(7, 1, 2))        // X7 = idx * 8
        push_u32_le(ctx["code"], insn_add_reg(7, 6, 7))    // X7 = buf + off
        push_u32_le(ctx["code"], insn_ldr_ptr(0, 7))       // X0 = *(addr)

        // Jump to done.
        br_done = bytes_len(ctx["code"])
        push_u32_le(ctx["code"], 0)
    }

    // --- Map fallback ---
    var map_pos = bytes_len(ctx["code"])
    // Restore container/index (X0=container, X1=index).
    push_u32_le(ctx["code"], insn_mov_reg(0, 19))
    push_u32_le(ctx["code"], insn_mov_reg(1, 20))
    // X0=container, X1=index
    var recv_kind = expr["recv_kind"]
    if recv_kind == "list" || recv_kind == "list_int" {
        // Deterministic contract: list indexing never falls back to map ops.
        if recv_kind == "list_int" {
            native_emit_panic(ctx, "Index recv_kind=list_int but value is not a list_int")
        } else {
            native_emit_panic(ctx, "Index recv_kind=list but value is not a list")
        }
    } else {
        // If shared lowering inferred this is a map, validate magic deterministically.
        if recv_kind == "map" {
            push_u32_le(ctx["code"], insn_add_imm(2, 0, 24)) // X2 = container + 24
            push_u32_le(ctx["code"], insn_ldr_ptr(3, 2))     // X3 = magic
            emit_load_i64_imm(ctx, 4, 1296121168)            // X4 = map_magic
            push_u32_le(ctx["code"], insn_cmp_reg(3, 4))
            var br_is_map = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            native_emit_panic(ctx, "Index recv_kind=map but value is not a map")
            var is_map_pos = bytes_len(ctx["code"])
            set_u32_le(ctx["code"], br_is_map, insn_b_cond((is_map_pos - br_is_map) / 4, 0)) // EQ
        }

        var kk = -1
        if expr["known_key_kind"] != nil { kk = expr["known_key_kind"] }
        if kk < 0 {
            var ix = expr["index"]
            if ix != nil {
                if ix["type"] == "Integer" { kk = 0 }
                if ix["type"] == "String" { kk = 1 }
            }
        }

        var map_get_sym = nil
        if kk == 0 { map_get_sym = "oren_map_get_int" }
        if kk == 1 { map_get_sym = "oren_map_get_str" }

        if map_get_sym == nil {

            // Dynamic map get: delegate key-kind selection to the injected runtime helper.

            // (Uses tracked allocation metadata; avoids duplicating inference logic in the backend.)

            var bl_pos2 = bytes_len(ctx["code"])

            push_u32_le(ctx["code"], 0)

            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos2, "name": "oren_map_get"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos2)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_map_get")

        } else {
            var bl_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": map_get_sym})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], _arm64_hot_bl_compact_name(map_get_sym))
        }
    }

    // Done.
    var done_pos = bytes_len(ctx["code"])
    if br_to_map != nil {
        set_u32_le(ctx["code"], br_to_map, insn_b_cond((map_pos - br_to_map) / 4, 0)) // EQ
    }
    if br_done != nil { set_u32_le(ctx["code"], br_done, insn_b((done_pos - br_done) / 4)) }
    return true
}

// Chunked out of native_compile_expr for include coherence (non-call expr types).
