                push_u32_le(ctx["code"], insn_ldr_ptr(11, 4))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(28, 11))
    
                push_u32_le(ctx["code"], insn_ldr_ptr(11, 3))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(29, 11))
    
