                push_u32_le(ctx["code"], insn_sub_imm(13, 13, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(13, 31))
                var br_vec_loop_gemm64_b = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_end_gemm64 = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_skip_vec_gemm64, insn_b_cond((vec_end_gemm64 - br_skip_vec_gemm64) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_vec_loop_gemm64_b, insn_b_cond((vec_loop_gemm64 - br_vec_loop_gemm64_b) / 4, 1)) // NE
    
                // rem = n - (groups_saved * 2)
                //
                // Rolling note: compute `groups_saved * 2` via add-doubling rather than `LSLV`
                // to keep tail handling robust if variable-shift encoding changes.
                push_u32_le(ctx["code"], insn_add_reg(14, 14, 14)) // X14 *= 2
                push_u32_le(ctx["code"], insn_sub_reg(10, 10, 14)) // X10 = rem
    
