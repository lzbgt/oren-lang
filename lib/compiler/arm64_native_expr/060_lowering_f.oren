                push_u32_le(ctx["code"], insn_add_imm(7, 7, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(26, 11))
    
                push_u32_le(ctx["code"], insn_ldr_ptr(11, 8))
                push_u32_le(ctx["code"], insn_add_imm(8, 8, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(27, 11))
    
