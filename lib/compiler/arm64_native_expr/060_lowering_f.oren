                var tail_loop_gemm64 = oren_list_len(ctx["code"])
                // Load a0..a3 f64 -> D24..D27
                push_u32_le(ctx["code"], insn_ldr_ptr(11, 5))
                push_u32_le(ctx["code"], insn_add_imm(5, 5, 8))
                push_u32_le(ctx["code"], insn_fmov_d_x(24, 11))
    
