                    push_u32_le(ctx["code"], 0) // B.EQ -> dynamic string equal
                    push_u32_le(ctx["code"], insn_movz(3, 1))
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 3))
                    var br_not_dynamic_string_eq = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B.NE -> raw compare fallback
                    var dynamic_string_eq_pos = bytes_len(ctx["code"])
                    set_u32_le(ctx["code"], br_dynamic_string_eq_singleton, insn_b_cond((dynamic_string_eq_pos - br_dynamic_string_eq_singleton) / 4, 0)) // EQ
                    if op == "==" {
                        _arm64_expr_emit_load_singleton_ptr(ctx, expr["token"], 0, 384)
                    } else {
                        _arm64_expr_emit_load_singleton_ptr(ctx, expr["token"], 0, 376)
                    }
                    dynamic_string_eq_done_branch = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0) // B end
                    var dynamic_string_fallback = bytes_len(ctx["code"])
                    set_u32_le(ctx["code"], br_not_dynamic_string_eq, insn_b_cond((dynamic_string_fallback - br_not_dynamic_string_eq) / 4, 1)) // NE
                    push_u32_le(ctx["code"], insn_mov_reg(1, 19))
                    push_u32_le(ctx["code"], insn_mov_reg(0, 20))
                }

                // CMP X1, X0
                push_u32_le(ctx["code"], insn_cmp_reg(1, 0))

                // Convert cond flags to runtime boolean singleton (not raw 0/1).
                var gname_cmp3 = _arm64_expr_resolve_g_storage_name(ctx)
                if gname_cmp3 == nil || ctx["globals"] == nil || ctx["globals"][gname_cmp3] == nil {
                    native_error(ctx, expr["token"], "native backend: missing runtime global g_storage (needed for bool results)")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
                var goff_cmp3 = ctx["globals"][gname_cmp3] - 1
                var adr_pos_cmp3 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos_cmp3, "data_off": goff_cmp3, "reg": nil})
                oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos_cmp3)
                oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], goff_cmp3)
                oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 0)
                push_u32_le(ctx["code"], insn_ldr_ptr(0, 0)) // X0 = g_storage
                push_u32_le(ctx["code"], insn_ldr_ptr_off(1, 0, 376)) // X1 = false
                push_u32_le(ctx["code"], insn_ldr_ptr_off(2, 0, 384)) // X2 = true
                var br_true3 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                push_u32_le(ctx["code"], insn_mov_reg(0, 1))
                var br_end3 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                var true_pos3 = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_true3, insn_b_cond((true_pos3 - br_true3) / 4, cond_code))
                push_u32_le(ctx["code"], insn_mov_reg(0, 2))
                var end_pos3 = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_end3, insn_b((end_pos3 - br_end3) / 4))
                if dynamic_string_eq_done_branch != nil {
                    set_u32_le(ctx["code"], dynamic_string_eq_done_branch, insn_b((end_pos3 - dynamic_string_eq_done_branch) / 4))
                }
                return true
            }

                if op == "&&" || op == "||" {
                    // Short-circuit boolean ops with language truthiness semantics, result is BOOL singleton.
                    // - falsey: `nil` and `false`
                    // - truthy: everything else (including int 0)

                    // Evaluate left.
                    native_compile_expr(ctx, expr["left"]) // X0 = left

                    // Load runtime singletons into scratch regs for falsey checks.
                    // Scratch: X9..X12.
                    var gname_sc = _arm64_expr_resolve_g_storage_name(ctx)
                    if gname_sc == nil || ctx["globals"] == nil || ctx["globals"][gname_sc] == nil {
                        native_error(ctx, expr["token"], "native backend: missing runtime global g_storage (needed for &&/|| truthiness)")
                        push_u32_le(ctx["code"], insn_movz(0, 0))
                        return true
                    }
                    var goff_sc = ctx["globals"][gname_sc] - 1
                    var adr_pos_sc = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos_sc, "data_off": goff_sc, "reg": 9})
                    oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos_sc)
                    oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], goff_sc)
                    oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 9)
                    push_u32_le(ctx["code"], insn_ldr_ptr(9, 9))           // X9 = g_storage
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(10, 9, 368)) // X10 = nil
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(11, 9, 376)) // X11 = false
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 9, 384)) // X12 = true

                    if op == "&&" {
                        // If left is falsey => false.
                        push_u32_le(ctx["code"], insn_cmp_reg(0, 10))
                        var br_false_sc0 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        push_u32_le(ctx["code"], insn_cmp_reg(0, 11))
                        var br_false_sc1 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)

                        // Evaluate right.
                        native_compile_expr(ctx, expr["right"]) // X0 = right

                        // Re-load falsey singletons (right evaluation may clobber scratch regs).
                        var adr_pos_sc2 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos_sc2, "data_off": goff_sc, "reg": 9})
                        oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos_sc2)
                        oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], goff_sc)
                        oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 9)
                        push_u32_le(ctx["code"], insn_ldr_ptr(9, 9))
                        push_u32_le(ctx["code"], insn_ldr_ptr_off(10, 9, 368))
                        push_u32_le(ctx["code"], insn_ldr_ptr_off(11, 9, 376))
                        push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 9, 384))

                        // If right is falsey => false, else true.
                        push_u32_le(ctx["code"], insn_cmp_reg(0, 10))
                        var br_false_sc2 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        push_u32_le(ctx["code"], insn_cmp_reg(0, 11))
                        var br_false_sc3 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)

                        // true
                        push_u32_le(ctx["code"], insn_mov_reg(0, 12))
                        var br_done_sc = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)

                        var false_pos_sc = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], insn_mov_reg(0, 11))
                        var done_pos_sc = bytes_len(ctx["code"])

                        set_u32_le(ctx["code"], br_false_sc0, insn_b_cond((false_pos_sc - br_false_sc0) / 4, 0)) // EQ
                        set_u32_le(ctx["code"], br_false_sc1, insn_b_cond((false_pos_sc - br_false_sc1) / 4, 0)) // EQ
                        set_u32_le(ctx["code"], br_false_sc2, insn_b_cond((false_pos_sc - br_false_sc2) / 4, 0)) // EQ
                        set_u32_le(ctx["code"], br_false_sc3, insn_b_cond((false_pos_sc - br_false_sc3) / 4, 0)) // EQ
                        set_u32_le(ctx["code"], br_done_sc, insn_b((done_pos_sc - br_done_sc) / 4))
                        return true
                    } else {
                        // op == "||"
                        // If left is truthy => true, else evaluate right and return truthiness(right).
                        push_u32_le(ctx["code"], insn_cmp_reg(0, 10))
                        var br_eval_rhs0 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        push_u32_le(ctx["code"], insn_cmp_reg(0, 11))
                        var br_eval_rhs1 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)

                        // left truthy => true
                        push_u32_le(ctx["code"], insn_mov_reg(0, 12))
                        var br_done_or = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)

                        // rhs path
                        var rhs_pos = bytes_len(ctx["code"])
                        // Patch both falsey branches to rhs_pos.
                        set_u32_le(ctx["code"], br_eval_rhs0, insn_b_cond((rhs_pos - br_eval_rhs0) / 4, 0)) // EQ
                        set_u32_le(ctx["code"], br_eval_rhs1, insn_b_cond((rhs_pos - br_eval_rhs1) / 4, 0)) // EQ

                        native_compile_expr(ctx, expr["right"]) // X0 = right

                        // Re-load singletons (rhs evaluation may clobber).
                        var adr_pos_or2 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos_or2, "data_off": goff_sc, "reg": 9})
                        oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos_or2)
                        oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], goff_sc)
                        oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 9)
                        push_u32_le(ctx["code"], insn_ldr_ptr(9, 9))
                        push_u32_le(ctx["code"], insn_ldr_ptr_off(10, 9, 368))
                        push_u32_le(ctx["code"], insn_ldr_ptr_off(11, 9, 376))
                        push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 9, 384))

                        push_u32_le(ctx["code"], insn_cmp_reg(0, 10))
                        var br_false_or0 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        push_u32_le(ctx["code"], insn_cmp_reg(0, 11))
                        var br_false_or1 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)

                        // rhs truthy => true
                        push_u32_le(ctx["code"], insn_mov_reg(0, 12))
                        var br_done_or2 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)

                        var false_pos_or = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], insn_mov_reg(0, 11))
                        var done_pos_or = bytes_len(ctx["code"])

                        set_u32_le(ctx["code"], br_false_or0, insn_b_cond((false_pos_or - br_false_or0) / 4, 0)) // EQ
                        set_u32_le(ctx["code"], br_false_or1, insn_b_cond((false_pos_or - br_false_or1) / 4, 0)) // EQ
                        set_u32_le(ctx["code"], br_done_or, insn_b((done_pos_or - br_done_or) / 4))
                        set_u32_le(ctx["code"], br_done_or2, insn_b((done_pos_or - br_done_or2) / 4))
                        return true
                    }
                }

            native_error(ctx, expr["token"], "native backend: unsupported operator " + op)
            push_u32_le(ctx["code"], insn_movz(0, 0))
            return true
        }


        if expr["type"] == "Hash" {
            // Hash literal { k: v, ... } -> oren_new_map(count) -> oren_map_set...
            var pairs = expr["pairs"]
            var count = oren_list_len(pairs)

            // oren_new_map(count) -> X0
            // We manually construct call logic for oren_new_map
            push_u32_le(ctx["code"], insn_movz(0, count)) // Arg 0 = count
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            var bl_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_new_map"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_new_map")

            // X0 has map. Push it.
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            var i = 0
            while i < count {
                var k = pairs[i]["key"]
                var v = pairs[i]["value"]

                // Push k
                native_compile_expr(ctx, k)
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                // Push v
                native_compile_expr(ctx, v)
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                // Pop v -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16

                // Pop k -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16

                // Peek m -> X0
                push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))

                // Typed map set (no key-kind heuristics).
                var kk = -1
                if pairs[i]["known_key_kind"] != nil { kk = pairs[i]["known_key_kind"] }
                if kk < 0 {
                    if k != nil {
                        if k["type"] == "Integer" { kk = 0 }
                        if k["type"] == "String" { kk = 1 }
                    }
                }

                var map_set_sym = nil
                if kk == 0 { map_set_sym = "oren_map_set_int" }
                if kk == 1 { map_set_sym = "oren_map_set_str" }

                if map_set_sym == nil {
                    native_error(ctx, expr["token"], "native backend: hash literal key kind must be inferable (int vs string)")
                    native_emit_panic(ctx, "hash literal key kind must be inferable (int vs string)")
                } else {
                    // oren_map_set_* (X0, X1, X2)
                    var bl_pos2 = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos2, "name": map_set_sym})
                    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos2)
                    oren_list_push(ctx["fixups_local_compact"]["bl_name"], _arm64_hot_bl_compact_name(map_set_sym))
                }

                i = i + 1
            }

            // Pop m -> X0
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            return true
        }


        if expr["type"] == "Member" {
            var nsr = native_ns_resolve(ctx, expr)
            if nsr != nil {
                if nsr["is_ns"] == true {
                    native_error(ctx, expr["token"], "native backend: cannot use namespace '" + nsr["name"] + "' as value")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
                native_compile_expr(ctx, {"type": "Identifier", "value": nsr["name"]});
                return true
            }

            var prop_name = expr["prop"]["value"]

            // a.x -> oren_map_get_str(a, "x")
            native_compile_expr(ctx, expr["left"]) // a -> X0
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            var data_off = native_data_add_cstr0(ctx, prop_name)
            var adr_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off, "reg": nil})
            oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos)
            oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], data_off)
            oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 0)

            // Push key -> stack
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            // Pop key -> X1
            push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            // Pop obj -> X0
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16

            var bl_pos3 = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos3, "name": "oren_map_get_str"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos3)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], -8)

            return true
        }


        if expr["type"] == "Index" {
            return native_emit_index_get_inline(ctx, expr)
        }


    return false
}
