fn native_expr_chunk_noncall(ctx, expr) {

        if expr["type"] == "Function" {
            if expr["name"] == "" {
                var lname = expr["lambda_name"]
                if lname == nil {
                    native_error(ctx, expr["token"], "native backend: lambda not collected (missing lambda_name)")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }

                var caps = expr["captures"]
                if caps == nil { caps = [] }
                var cap_count = oren_list_len(caps)

                if cap_count == 0 {
                    push_u32_le(ctx["code"], insn_movz(1, 0)) // env_ptr = 0
                } else {
                    // env_list = oren_new_list(0)
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    var bl_new_list = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list, "name": "oren_new_list"})
                    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_new_list)
                    oren_list_push(ctx["fixups_local_compact"]["bl_name"], -9)

                    // Save env_list on stack across capture evals/pushes.
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    push_u32_le(ctx["code"], insn_str_x0_sp(0))
                    ctx["stack_size"] = ctx["stack_size"] + 16

                    var i_cap = 0
                    while i_cap < cap_count {
                        native_compile_expr(ctx, {"type": "Identifier", "value": caps[i_cap]})

                        // Save value
                        push_u32_le(ctx["code"], insn_sub_sp(16))
                        push_u32_le(ctx["code"], insn_str_x0_sp(0))
                        ctx["stack_size"] = ctx["stack_size"] + 16

                        // X0 = env_list, X1 = value
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 16))
                        push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                        push_u32_le(ctx["code"], insn_add_sp(16))
                        ctx["stack_size"] = ctx["stack_size"] - 16

                        var bl_push = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push, "name": "oren_list_push"})
                        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_push)
                        oren_list_push(ctx["fixups_local_compact"]["bl_name"], -14)
                        i_cap = i_cap + 1
                    }

                    // Load env_list into X1 and pop it from the stack.
                    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                    push_u32_le(ctx["code"], insn_add_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] - 16
                }

                // X0 = code_ptr (lambda wrapper), X1 = env_ptr
                var adr_pos = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "adr_code", "pos": adr_pos, "name": lname, "reg": 0})
                oren_list_push(ctx["fixups_local_compact"]["adr_code_pos"], adr_pos)
                oren_list_push(ctx["fixups_local_compact"]["adr_code_name"], lname)
                oren_list_push(ctx["fixups_local_compact"]["adr_code_reg"], 0)

                var bl_make = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_make, "name": "oren_func"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_make)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -13)
                return true
            }

            native_error(ctx, expr["token"], "native backend: unexpected Function expression (name=" + expr["name"] + ")")
            push_u32_le(ctx["code"], insn_movz(0, 0))
            return true
        }


        if expr["type"] == "String" {
            var s = expr["value"]
            var data_off = _native_data_add_string_lit_cstr0_cached(ctx, s)
            if data_off == nil {
                native_error(ctx, expr["token"], "native backend: failed to add string literal data")
                push_u32_le(ctx["code"], insn_movz(0, 0))
                return true
            }

            var adr_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": data_off, "reg": nil})
            oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos)
            oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], data_off)
            oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 0)
            // Embedded string literals are registered once at program startup via
            // `oren_init_static_cstr0_table` (entry stub), so per-use tracking is unnecessary here.
            return true
        }

            if expr["type"] == "SpawnExpr" {
                // Spawn-callable v0: lower to a runtime helper so callee can be a first-class callable
                // (function value, closure, or variable holding a callable).
                //
                // This keeps the spawn semantics in `lib/runtime_native.oren` and avoids duplicating
                // per-OS fork/pipe details in the code generator.
                var call2 = expr["call"]
                var args2 = call2["args"]
                var nargs2 = oren_list_len(args2)

                // args_list = oren_new_list(0)
                push_u32_le(ctx["code"], insn_movz(0, 0))
                var bl_new_list2 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_new_list2, "name": "oren_new_list"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_new_list2)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -9)

                // Save args_list on stack across arg evals.
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                var i_arg2 = 0
                while i_arg2 < nargs2 {
                    native_compile_expr(ctx, args2[i_arg2]) // value -> X0
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    push_u32_le(ctx["code"], insn_str_x0_sp(0))
                    ctx["stack_size"] = ctx["stack_size"] + 16

                    // X0=args_list, X1=value
                    push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 16))
                    push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                    push_u32_le(ctx["code"], insn_add_sp(16))
                    ctx["stack_size"] = ctx["stack_size"] - 16

                    var bl_push2 = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_push2, "name": "oren_list_push"})
                    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_push2)
                    oren_list_push(ctx["fixups_local_compact"]["bl_name"], -14)
                    i_arg2 = i_arg2 + 1
                }

                // fn_obj -> X0
                native_compile_expr(ctx, call2["fn"])

                // X1=args_list, pop stack
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16

                    var bl_spawn2 = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_spawn2, "name": "oren_spawn_call_list"})
                    oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_spawn2)
                    oren_list_push(ctx["fixups_local_compact"]["bl_name"], "oren_spawn_call_list")
                    return true
                }


            if expr["type"] == "Array" {
                var elements = expr["elements"]
                var count = oren_list_len(elements)

            // Build runtime list: call oren_new_list(count) then push elements
            native_compile_expr(ctx, {"type": "Integer", "token": nil, "value": oren_int_to_string(count)})
            var bl_pos_list = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_list, "name": "oren_new_list"})
            oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos_list)
            oren_list_push(ctx["fixups_local_compact"]["bl_name"], -9)

            // Stack: list in X0, push to preserve across pushes
            push_u32_le(ctx["code"], insn_sub_sp(16))
            push_u32_le(ctx["code"], insn_str_x0_sp(0))
            ctx["stack_size"] = ctx["stack_size"] + 16

            var i_arr = 0
            while i_arr < count {
                native_compile_expr(ctx, elements[i_arr]) // -> X0 (value)
                // save value on stack
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                // load list -> X0
                push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 16)) // list is 16 bytes above current SP after push
                // load value -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                // pop value slot
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16

                // Call oren_list_push_unchecked(list, elem)
                var bl_pos_push = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos_push, "name": "oren_list_push_unchecked"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos_push)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -11)
                i_arr = i_arr + 1
            }

            // Pop list back to X0 as result
            push_u32_le(ctx["code"], insn_ldr_reg_sp(0, 0))
            push_u32_le(ctx["code"], insn_add_sp(16))
            ctx["stack_size"] = ctx["stack_size"] - 16
            return true
        }


        if expr["type"] == "Index" {
            if native_emit_index_get_map_str_lit_inline(ctx, expr) == true { return true }
            return native_emit_index_get_inline(ctx, expr)
        }


        if expr["type"] == "Float" {
            var val = oren_string_to_float_bits(expr["value"])

            // Load 64-bit value using MOVZ/MOVK sequence
            // We use bitwise ops to handle potential sign bit correctly
            var chunk0 = val & 65535
            push_u32_le(ctx["code"], insn_movz(0, chunk0))

            var chunk1 = (val >> 16) & 65535
            if chunk1 != 0 || (val >> 32) != 0 {
                push_u32_le(ctx["code"], insn_movk(0, chunk1, 1))
            }

            var chunk2 = (val >> 32) & 65535
            if chunk2 != 0 || (val >> 48) != 0 {
                push_u32_le(ctx["code"], insn_movk(0, chunk2, 2))
            }

            var chunk3 = (val >> 48) & 65535
            if chunk3 != 0 {
                push_u32_le(ctx["code"], insn_movk(0, chunk3, 3))
            }
            return true
        }


        if expr["type"] == "Boolean" {
            // Native backend: bool values are represented by runtime singletons stored in globals.
            // This preserves type-strict semantics (`0 != false`) and truthiness rules (`0` is truthy).
            var gname = _arm64_expr_resolve_g_storage_name(ctx)
            if gname == nil || ctx["globals"] == nil || ctx["globals"][gname] == nil {
                native_error(ctx, expr["token"], "native backend: missing runtime global g_storage (needed for bool singletons)")
                push_u32_le(ctx["code"], insn_movz(0, 0))
                return true
            }
            var goff = ctx["globals"][gname] - 1
            // X0 = g_storage (globals base pointer for runtime metadata)
            var adr_pos = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": goff, "reg": nil})
            oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos)
            oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], goff)
            oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 0)
            push_u32_le(ctx["code"], insn_ldr_ptr(0, 0))

            // X0 = *(g_storage + off)
            var off = 376
            if expr["value"] == true { off = 384 }
            push_u32_le(ctx["code"], insn_ldr_ptr_off(0, 0, off))
            return true
        }


        if expr["type"] == "Nil" {
            // Native backend: `nil` is a runtime singleton stored in globals (not raw 0).
            // This preserves type-strict equality and avoids `0 == nil` hazards.
            var gname2 = _arm64_expr_resolve_g_storage_name(ctx)
            if gname2 == nil || ctx["globals"] == nil || ctx["globals"][gname2] == nil {
                native_error(ctx, expr["token"], "native backend: missing runtime global g_storage (needed for nil singleton)")
                push_u32_le(ctx["code"], insn_movz(0, 0))
                return true
            }
            var goff2 = ctx["globals"][gname2] - 1
            var adr_pos2 = bytes_len(ctx["code"])
            push_u32_le(ctx["code"], 0)
            push_u32_le(ctx["code"], 0)
            oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos2, "data_off": goff2, "reg": nil})
            oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos2)
            oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], goff2)
            oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 0)
            push_u32_le(ctx["code"], insn_ldr_ptr(0, 0))
            push_u32_le(ctx["code"], insn_ldr_ptr_off(0, 0, 368))
            return true
        }


        if expr["type"] == "Integer" {
            var val = int_from_string(expr["value"])
            // IMPORTANT: integers are i64 semantics in v0 (including negatives).
            // Never emit MOVZ with a negative imm16 (it yields an invalid encoding like 0xD27FFEE0).
            // Delegate to the shared immediate loader which handles:
            // - small positives (MOVZ)
            // - small negatives (MOVN)
            // - larger values (MOVZ/MOVK or load+neg)
            emit_load_i64_imm(ctx, 0, val)
            return true
        }

            if expr["type"] == "Identifier" {
                var name = expr["value"]
                var fn_name = name

                // Robustness (rolling):
                // Module linking prefixes top-level function names (e.g. `M1_foo`), and all intra-module
                // references are supposed to be rewritten accordingly. If that rewrite misses an internal
                // `__name` reference, SpawnExpr lowering (which needs a first-class function value)
                // would otherwise fail with "undefined variable".
                //
                // To keep self-hosting stable (and deterministic), we allow a narrow suffix resolution:
                // - only for names starting with "__"
                // - only if it uniquely matches a declared top-level function name in ctx["func_arity"]
                if ctx != nil && ctx["func_arity"] != nil {
                    if ctx["func_arity"][fn_name] == nil {
                        if fn_name != nil && oren_string_len(fn_name) >= 2 &&
                           oren_string_char_at(fn_name, 0) == "_" && oren_string_char_at(fn_name, 1) == "_" {
                            var match = nil
                            var match_count = 0
                            for k in ctx["func_arity"] {
                                var klen = oren_string_len(k)
                                var nlen = oren_string_len(fn_name)
                                if klen >= nlen {
                                    // ends_with(k, fn_name)
                                    var ok = true
                                    var j = 0
                                    while j < nlen {
                                        if oren_string_char_at(k, klen - nlen + j) != oren_string_char_at(fn_name, j) { ok = false; break }
                                        j = j + 1
                                    }
                                    if ok {
                                        match = k
                                        match_count = match_count + 1
                                        if match_count > 1 { break }
                                    }
                                }
                            }
                            if match_count == 1 && match != nil {
                                fn_name = match
                            }
                        }
                    }
                }

                    // Check locals
                            var off_enc = ctx["locals"][name]
                            if oren_type_tag(off_enc) != 0 {
                                // Locals are addressed as FP-relative slots: slot is at [FP + fp_off], fp_off < 0.
                                var fp_off = off_enc - 1
                                emit_ldr_reg_fp_any(ctx, 0, fp_off)
                                return true
                            }

                // Check globals
                    var global_off_enc = ctx["globals"][name]
                    if oren_type_tag(global_off_enc) != 0 {
                        var global_off = global_off_enc - 1
                        var adr_pos = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos, "data_off": global_off, "reg": nil})
                    oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos)
                    oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], global_off)
                    oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 0)
                // X0 has address. LDR X0, [X0]
                push_u32_le(ctx["code"], insn_ldr_ptr(0, 0))
                return true
            }

            // Check aliases (imported modules)
            if ctx["aliases"][name] != nil {
                native_error(ctx, expr["token"], "native backend: cannot use module '" + name + "' as value")
                push_u32_le(ctx["code"], insn_movz(0, 0))
                return true
            }

                    // First-class function value (named function -> callable object).
                    // Wrapper name convention: __oren_fnwrap_<fn>.
                    if ctx["func_arity"] != nil {
                        if ctx["func_arity"][fn_name] != nil {
                            // Track which named-function wrappers are actually referenced as values.
                            // This keeps wrapper synthesis bounded for native builds that inject the runtime.
                            if ctx["fnwrap_needed"] != nil { ctx["fnwrap_needed"][fn_name] = 1 }
                            push_u32_le(ctx["code"], insn_movz(1, 0)) // env_ptr = 0
                            var wname = "__oren_fnwrap_" + fn_name
                            var adr_pos2 = bytes_len(ctx["code"])
                            push_u32_le(ctx["code"], 0)
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "adr_code", "pos": adr_pos2, "name": wname, "reg": 0})
                        oren_list_push(ctx["fixups_local_compact"]["adr_code_pos"], adr_pos2)
                        oren_list_push(ctx["fixups_local_compact"]["adr_code_name"], wname)
                        oren_list_push(ctx["fixups_local_compact"]["adr_code_reg"], 0)

                        var bl_make2 = bytes_len(ctx["code"])
                        push_u32_le(ctx["code"], 0)
                        oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_make2, "name": "oren_func"})
                        oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_make2)
                        oren_list_push(ctx["fixups_local_compact"]["bl_name"], -13)
                        return true
                    }
                }

            native_error(ctx, expr["token"], "native backend: undefined variable " + name)
            push_u32_le(ctx["code"], insn_movz(0, 0))
            return true
        }

            if expr["type"] == "Prefix" {
            if expr["op"] == "-" {
                if native_expr_is_floaty(ctx, expr["right"]) {
                    // Float negation: flip IEEE-754 sign bit.
                    native_compile_expr(ctx, expr["right"])
                    push_u32_le(ctx["code"], insn_movz(1, 0))
                    push_u32_le(ctx["code"], insn_movk(1, 32768, 3)) // 0x8000 << 48
                    push_u32_le(ctx["code"], insn_eor_reg(0, 0, 1))
                    return true
                }
                native_compile_expr(ctx, expr["right"])
                push_u32_le(ctx["code"], insn_sub_reg(0, 31, 0)) // SUB X0, XZR, X0
                return true
            }
                if expr["op"] == "!" {
                    // Logical not: `!x` returns BOOL (runtime singleton) based on language truthiness.
                    // Falsey: `nil` and `false`. Everything else is truthy (including int 0).
                    native_compile_expr(ctx, expr["right"]) // X0 = operand

                    // Load runtime singletons into scratch regs.
                    // Scratch: X9..X12.
                    var gname_not = _arm64_expr_resolve_g_storage_name(ctx)
                    if gname_not == nil || ctx["globals"] == nil || ctx["globals"][gname_not] == nil {
                        native_error(ctx, expr["token"], "native backend: missing runtime global g_storage (needed for ! truthiness)")
                        push_u32_le(ctx["code"], insn_movz(0, 0))
                        return true
                    }
                    var goff_not = ctx["globals"][gname_not] - 1
                    var adr_pos_not = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    push_u32_le(ctx["code"], 0)
                    oren_list_push(ctx["fixups"], {"type": "adr_data", "pos": adr_pos_not, "data_off": goff_not, "reg": 9})
                    oren_list_push(ctx["fixups_local_compact"]["adr_data_pos"], adr_pos_not)
                    oren_list_push(ctx["fixups_local_compact"]["adr_data_off"], goff_not)
                    oren_list_push(ctx["fixups_local_compact"]["adr_data_reg"], 9)
                    push_u32_le(ctx["code"], insn_ldr_ptr(9, 9))           // X9 = g_storage
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(10, 9, 368)) // X10 = nil
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(11, 9, 376)) // X11 = false
                    push_u32_le(ctx["code"], insn_ldr_ptr_off(12, 9, 384)) // X12 = true

                    // if x==nil || x==false => !x = true else false
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 10))
                    var br_true_not0 = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)
                    push_u32_le(ctx["code"], insn_cmp_reg(0, 11))
                    var br_true_not1 = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)

                    // truthy => false
                    push_u32_le(ctx["code"], insn_mov_reg(0, 11))
                    var br_done_not = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], 0)

                    var true_pos_not = bytes_len(ctx["code"])
                    push_u32_le(ctx["code"], insn_mov_reg(0, 12))
                    var done_pos_not = bytes_len(ctx["code"])

                    set_u32_le(ctx["code"], br_true_not0, insn_b_cond((true_pos_not - br_true_not0) / 4, 0)) // EQ
                    set_u32_le(ctx["code"], br_true_not1, insn_b_cond((true_pos_not - br_true_not1) / 4, 0)) // EQ
                    set_u32_le(ctx["code"], br_done_not, insn_b((done_pos_not - br_done_not) / 4))
                    return true
                }
            if expr["op"] == "~" {
                // Bitwise not: x ^ -1
                native_compile_expr(ctx, expr["right"])
                push_u32_le(ctx["code"], insn_movn(1, 0)) // X1 = -1
                push_u32_le(ctx["code"], insn_eor_reg(0, 0, 1))
                return true
            }
            native_error(ctx, expr["token"], "native backend: unsupported prefix " + expr["op"])
            push_u32_le(ctx["code"], insn_movz(0, 0))
            return true
        }


        if expr["type"] == "Infix" {
            var op = expr["op"]
            if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
                // Compile Left
                native_compile_expr(ctx, expr["left"])

                // Push Left
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                // Compile Right
