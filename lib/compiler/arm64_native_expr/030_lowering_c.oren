// Chunked out of native_compile_expr call handling for include coherence.
fn native_call_chunk_030_lowering_c(ctx, fn_name, expr, args) {

            if fn_name == "oren_list_len" || fn_name == "STD_list_len" {
                // Intrinsic: list length (fast-path, no runtime call).
                //
                // Runtime layout: [count][capacity][buffer_ptr][magic]
                // - nil list => 0
                // - non-list => deterministic panic (matches runtime)
                var args0 = expr["args"]
                if args0 == nil || oren_list_len(args0) != 1 {
                    native_error(ctx, expr["token"], "native backend: oren_list_len expects 1 argument")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }

                native_compile_expr(ctx, args0[0]) // list -> X0

                // nil => 0
                push_u32_le(ctx["code"], insn_movz(1, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(0, 1))
                var br_non_nil = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                push_u32_le(ctx["code"], insn_movz(0, 0))
                var br_done = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                var non_nil_pos = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_non_nil, insn_b_cond((non_nil_pos - br_non_nil) / 4, 1)) // NE

                // magic check
                emit_load_ptr_from_base_plus(ctx, 1, 0, 24)   // X1 = magic
                emit_load_i64_imm(ctx, 2, 1279870019)         // X2 = 'LIST'
                push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
                var br_is_list = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_len on non-list")
                var is_list_pos = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_is_list, insn_b_cond((is_list_pos - br_is_list) / 4, 0)) // EQ

                // count
                emit_load_ptr_from_base_plus(ctx, 0, 0, 0)

                var done_pos = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_done, insn_b((done_pos - br_done) / 4))
                return true
            }

            if fn_name == "oren_list_push" || fn_name == "STD_list_push" {
                // Intrinsic: list push fast-path (in-bounds capacity case), fallback to runtime for growth.
                //
                // Signature: oren_list_push(list, value) -> nil
                var args1 = expr["args"]
                if args1 == nil || oren_list_len(args1) != 2 {
                    native_error(ctx, expr["token"], "native backend: oren_list_push expects 2 arguments")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }

                // Eval list -> stack
                native_compile_expr(ctx, args1[0]) // list -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                // Eval value -> X0
                native_compile_expr(ctx, args1[1])

                // Pop list -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16

                // Swap: X0=value, X1=list => X0=list, X1=value
                push_u32_le(ctx["code"], insn_mov_reg(2, 0))
                push_u32_le(ctx["code"], insn_mov_reg(0, 1))
                push_u32_le(ctx["code"], insn_mov_reg(1, 2))

                // nil => panic
                push_u32_le(ctx["code"], insn_movz(2, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
                var br_non_nil2 = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_push on nil")
                var non_nil_pos2 = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_non_nil2, insn_b_cond((non_nil_pos2 - br_non_nil2) / 4, 1)) // NE

                // magic check (panic on non-list)
                emit_load_ptr_from_base_plus(ctx, 2, 0, 24) // X2 = magic
                emit_load_i64_imm(ctx, 3, 1279870019)       // X3 = 'LIST'
                push_u32_le(ctx["code"], insn_cmp_reg(2, 3))
                var br_is_list2 = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_push on non-list")
                var is_list_pos2 = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_is_list2, insn_b_cond((is_list_pos2 - br_is_list2) / 4, 0)) // EQ

                // Load count/cap/buf
                emit_load_ptr_from_base_plus(ctx, 4, 0, 0)   // X4 = count
                emit_load_ptr_from_base_plus(ctx, 5, 0, 8)   // X5 = cap
                emit_load_ptr_from_base_plus(ctx, 6, 0, 16)  // X6 = buf

                // if count < cap => fast store; else => slow path call
                push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
                var br_fast = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                // Slow path: call runtime oren_list_push(list, value)
                var bl_pos = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_list_push"})
                var br_done2 = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                // Fast path
                var fast_pos = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_fast, insn_b_cond((fast_pos - br_fast) / 4, 11)) // LT

                // addr = buf + count*8
                emit_load_i64_imm(ctx, 2, 8)
                push_u32_le(ctx["code"], insn_mul(7, 4, 2))      // X7 = count*8
                push_u32_le(ctx["code"], insn_add_reg(7, 6, 7))  // X7 = buf + off
                push_u32_le(ctx["code"], insn_str_ptr(1, 7))     // *(addr) = value

                // count++
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 1))
                push_u32_le(ctx["code"], insn_str_ptr(4, 0))     // *(list) = count+1

                var done_pos2 = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_done2, insn_b((done_pos2 - br_done2) / 4))

                // Language-level semantics: return `nil` regardless of the underlying runtime helper's return value.
                push_u32_le(ctx["code"], insn_movz(0, 0))
                return true
            }

            if fn_name == "oren_call_obj_list" {
                // Intrinsic: indirect call through a native function object.
                // Signature: oren_call_obj_list(fn_obj, args_list) -> value
                //
                // Layout (kind=6):
                //   [0] code_ptr
                //   [8] env_ptr
                native_compile_expr(ctx, expr["args"][0]) // fn_obj -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, expr["args"][1]) // args_list -> X0
    
                // Pop fn_obj -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // X1 = args_list
                push_u32_le(ctx["code"], insn_mov_reg(1, 0))
                // X0 = env_ptr
                emit_load_ptr_from_base_plus(ctx, 0, 2, 8)
                // X9 = code_ptr
                emit_load_ptr_from_base_plus(ctx, 9, 2, 0)
                // BLR X9
                push_u32_le(ctx["code"], insn_blr(9))
                return true
            }

            if fn_name == "simd_add_2d" || fn_name == "simd_sub_2d" || fn_name == "simd_and_2d" || fn_name == "simd_orr_2d" || fn_name == "simd_eor_2d" || fn_name == "simd_mul_4s" {
                // Compile args
                native_compile_expr(ctx, expr["args"][0]) // arg0 -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
                
                native_compile_expr(ctx, expr["args"][1]) // arg1 -> X0
                
                // Pop arg0 -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
                
                // Move X1 -> D0, X0 -> D1
                push_u32_le(ctx["code"], insn_fmov_d_x(0, 1))
                push_u32_le(ctx["code"], insn_fmov_d_x(1, 0))
                
                // Execute SIMD Op on V0, V1 -> V0
                if fn_name == "simd_add_2d" { push_u32_le(ctx["code"], insn_add_2d(0, 0, 1)) }
                if fn_name == "simd_sub_2d" { push_u32_le(ctx["code"], insn_sub_2d(0, 0, 1)) }
                if fn_name == "simd_and_2d" { push_u32_le(ctx["code"], insn_and_16b(0, 0, 1)) }
                if fn_name == "simd_orr_2d" { push_u32_le(ctx["code"], insn_orr_16b(0, 0, 1)) }
                if fn_name == "simd_eor_2d" { push_u32_le(ctx["code"], insn_eor_16b(0, 0, 1)) }
                if fn_name == "simd_mul_4s" { push_u32_le(ctx["code"], insn_mul_4s(0, 0, 1)) }
                
                // Move result D0 -> X0
                push_u32_le(ctx["code"], insn_umov_d0(0, 0))
                
                return true
            }

            if fn_name == "simd_dot_i32_ptr" {
                // Intrinsic: dot product over raw i32 pointers, returning i64 (wrap-around).
                // Signature: simd_dot_i32_ptr(a_ptr, b_ptr, n) -> i64
                //
                // This is a native-backend-only acceleration boundary (arm64 NEON).
                // It must not depend on libc and must preserve scalar semantics.
                var args3 = expr["args"]
                if args3 == nil || oren_list_len(args3) != 3 {
                    native_error(ctx, expr["token"], "native backend: simd_dot_i32_ptr expects 3 arguments")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
    
                // Compile args: a_ptr, b_ptr, n
                native_compile_expr(ctx, args3[0]) // a_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args3[1]) // b_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args3[2]) // n -> X0
    
                // Pop b_ptr -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop a_ptr -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Register assignment:
                //   X3 = a_ptr
                //   X4 = b_ptr
                //   X2 = n
                push_u32_le(ctx["code"], insn_mov_reg(3, 2))
                push_u32_le(ctx["code"], insn_mov_reg(4, 1))
                push_u32_le(ctx["code"], insn_mov_reg(2, 0))
    
                // X0 = 0 accumulator
                push_u32_le(ctx["code"], insn_movz(0, 0))
    
                // V4.2D = 0 (duplicate X0 into both lanes)
                push_u32_le(ctx["code"], insn_dup_2d(4, 0))
    
                // X5 = n / 4 (vector groups of 4 i32s)
                push_u32_le(ctx["code"], insn_mov_reg(5, 2))
                push_u32_le(ctx["code"], insn_movz(6, 2))         // X6 = 2
                push_u32_le(ctx["code"], insn_lsrv(5, 5, 6))       // X5 = X5 >> 2
                push_u32_le(ctx["code"], insn_mov_reg(7, 5))       // X7 = groups (save for remainder)
    
                // If groups == 0, skip vector loop.
                push_u32_le(ctx["code"], insn_cmp_reg(5, 31))      // CMP X5, XZR
                var br_skip_vec = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_loop = oren_list_len(ctx["code"])
                // Load 16 bytes (4x i32) from each pointer.
                push_u32_le(ctx["code"], insn_ldr_q(0, 3))         // Q0 = *(u128*)a_ptr
                push_u32_le(ctx["code"], insn_ldr_q(1, 4))         // Q1 = *(u128*)b_ptr
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 16))   // a_ptr += 16
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 16))   // b_ptr += 16
    
                // Multiply-accumulate:
                //   smull  v2.2d, v0.2s, v1.2s
                //   smull2 v3.2d, v0.4s, v1.4s
                //   v2 += v3
                //   v4 += v2
                push_u32_le(ctx["code"], insn_smull_2d(2, 0, 1))
                push_u32_le(ctx["code"], insn_smull2_2d(3, 0, 1))
                push_u32_le(ctx["code"], insn_add_2d(2, 2, 3))
                push_u32_le(ctx["code"], insn_add_2d(4, 4, 2))
    
                // groups--
                push_u32_le(ctx["code"], insn_sub_imm(5, 5, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(5, 31))
                var br_vec_loop = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_end = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_skip_vec, insn_b_cond((vec_end - br_skip_vec) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_vec_loop, insn_b_cond((vec_loop - br_vec_loop) / 4, 1)) // NE
    
                // Reduce V4.2D -> X0:
                //   addp v4.2d, v4.2d, v4.2d
                //   umov x0, v4.d[0]
                push_u32_le(ctx["code"], insn_addp_2d(4, 4, 4))
                push_u32_le(ctx["code"], insn_umov_x_d(0, 4))
    
                // Remainder count: n - (groups_saved * 4)
                //
                // Rolling note: compute `groups_saved * 4` via add-doubling rather than `LSLV`
                // to keep tail handling robust if variable-shift encoding changes.
                push_u32_le(ctx["code"], insn_add_reg(7, 7, 7))    // X7 *= 2
                push_u32_le(ctx["code"], insn_add_reg(7, 7, 7))    // X7 *= 4
                push_u32_le(ctx["code"], insn_sub_reg(2, 2, 7))    // X2 = rem
    
                // If rem == 0, done.
                push_u32_le(ctx["code"], insn_cmp_reg(2, 31))
                var br_done = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                // Scalar tail loop (sign-extended i32 loads).
                var tail_loop = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], insn_ldrsw(9, 3, 0))       // X9 = (i64)*(i32*)a_ptr
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 4))
                push_u32_le(ctx["code"], insn_ldrsw(10, 4, 0))      // X10 = (i64)*(i32*)b_ptr
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 4))
                push_u32_le(ctx["code"], insn_mul(9, 9, 10))
                push_u32_le(ctx["code"], insn_add_reg(0, 0, 9))
                push_u32_le(ctx["code"], insn_sub_imm(2, 2, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(2, 31))
                var br_tail = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var done_pos = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_done, insn_b_cond((done_pos - br_done) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_tail, insn_b_cond((tail_loop - br_tail) / 4, 1)) // NE
    
                return true
            }

            if fn_name == "simd_dot_i32_4_ptr" {
                // Intrinsic: 1x4 i32 dot microkernel over raw pointers, writing 4 i64 results to out_ptr.
                // Signature: simd_dot_i32_4_ptr(out_ptr, a_ptr, b0_ptr, b1_ptr, b2_ptr, b3_ptr, n) -> out_ptr
                //
                // Semantics:
                // - sign-extend i32 lanes to i64 for multiplication
                // - accumulate with i64 two's-complement wrap-around (native CPU semantics)
                //
                // Determinism:
                // - integer wrap arithmetic is associative in Z/2^64, so SIMD reassociation is safe
                // - still keep scalar tail correct for non-multiple-of-4 lengths
                var args7 = expr["args"]
                if args7 == nil || oren_list_len(args7) != 7 {
                    native_error(ctx, expr["token"], "native backend: simd_dot_i32_4_ptr expects 7 arguments")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
    
                // Compile args: out_ptr, a_ptr, b0_ptr, b1_ptr, b2_ptr, b3_ptr, n
                native_compile_expr(ctx, args7[0]) // out_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[1]) // a_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[2]) // b0_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[3]) // b1_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[4]) // b2_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[5]) // b3_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args7[6]) // n -> X0
    
                // Pop b3_ptr -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop b2_ptr -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop b1_ptr -> X3
                push_u32_le(ctx["code"], insn_ldr_reg_sp(3, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop b0_ptr -> X4
                push_u32_le(ctx["code"], insn_ldr_reg_sp(4, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop a_ptr -> X5
                push_u32_le(ctx["code"], insn_ldr_reg_sp(5, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Pop out_ptr -> X6
                push_u32_le(ctx["code"], insn_ldr_reg_sp(6, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Preserve inputs:
                // - X7 = n (from compiled X0)
                // - X0 = out_ptr (return value)
                push_u32_le(ctx["code"], insn_mov_reg(7, 0)) // X7 = n
                push_u32_le(ctx["code"], insn_mov_reg(0, 6)) // X0 = out_ptr
    
                // Zero register for vector init.
                push_u32_le(ctx["code"], insn_movz(19, 0))
    
                // Accumulators: V12..V15 (2D lanes) = 0
                push_u32_le(ctx["code"], insn_dup_2d(12, 19))
                push_u32_le(ctx["code"], insn_dup_2d(13, 19))
                push_u32_le(ctx["code"], insn_dup_2d(14, 19))
                push_u32_le(ctx["code"], insn_dup_2d(15, 19))
    
                // X8 = groups = n>>2, X9 = shift(2), X10 = groups_saved
                push_u32_le(ctx["code"], insn_mov_reg(8, 7))
                push_u32_le(ctx["code"], insn_movz(9, 2))
                push_u32_le(ctx["code"], insn_lsrv(8, 8, 9))
                push_u32_le(ctx["code"], insn_mov_reg(10, 8))
    
                // If groups == 0, skip vector loop.
                push_u32_le(ctx["code"], insn_cmp_reg(8, 31))
                var br_skip_vec4i = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_loop4i = oren_list_len(ctx["code"])
                // Load A (4x i32) once.
                push_u32_le(ctx["code"], insn_ldr_q(0, 5))
                push_u32_le(ctx["code"], insn_add_imm(5, 5, 16))
    
                // b0 -> V12
                push_u32_le(ctx["code"], insn_ldr_q(1, 4))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 16))
                push_u32_le(ctx["code"], insn_smull_2d(2, 0, 1))
                push_u32_le(ctx["code"], insn_smull2_2d(3, 0, 1))
                push_u32_le(ctx["code"], insn_add_2d(2, 2, 3))
                push_u32_le(ctx["code"], insn_add_2d(12, 12, 2))
    
                // b1 -> V13
                push_u32_le(ctx["code"], insn_ldr_q(1, 3))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 16))
                push_u32_le(ctx["code"], insn_smull_2d(2, 0, 1))
                push_u32_le(ctx["code"], insn_smull2_2d(3, 0, 1))
                push_u32_le(ctx["code"], insn_add_2d(2, 2, 3))
                push_u32_le(ctx["code"], insn_add_2d(13, 13, 2))
    
                // b2 -> V14
                push_u32_le(ctx["code"], insn_ldr_q(1, 2))
                push_u32_le(ctx["code"], insn_add_imm(2, 2, 16))
                push_u32_le(ctx["code"], insn_smull_2d(2, 0, 1))
                push_u32_le(ctx["code"], insn_smull2_2d(3, 0, 1))
                push_u32_le(ctx["code"], insn_add_2d(2, 2, 3))
                push_u32_le(ctx["code"], insn_add_2d(14, 14, 2))
    
                // b3 -> V15
                push_u32_le(ctx["code"], insn_ldr_q(1, 1))
                push_u32_le(ctx["code"], insn_add_imm(1, 1, 16))
                push_u32_le(ctx["code"], insn_smull_2d(2, 0, 1))
                push_u32_le(ctx["code"], insn_smull2_2d(3, 0, 1))
                push_u32_le(ctx["code"], insn_add_2d(2, 2, 3))
                push_u32_le(ctx["code"], insn_add_2d(15, 15, 2))
    
                // groups--
                push_u32_le(ctx["code"], insn_sub_imm(8, 8, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(8, 31))
                var br_vec_loop4i_b = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_end4i = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_skip_vec4i, insn_b_cond((vec_end4i - br_skip_vec4i) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_vec_loop4i_b, insn_b_cond((vec_loop4i - br_vec_loop4i_b) / 4, 1)) // NE
    
                // Reduce accumulators to scalar i64: addp + umov.
                push_u32_le(ctx["code"], insn_addp_2d(12, 12, 12))
                push_u32_le(ctx["code"], insn_addp_2d(13, 13, 13))
                push_u32_le(ctx["code"], insn_addp_2d(14, 14, 14))
                push_u32_le(ctx["code"], insn_addp_2d(15, 15, 15))
                push_u32_le(ctx["code"], insn_umov_x_d(12, 12))
                push_u32_le(ctx["code"], insn_umov_x_d(13, 13))
                push_u32_le(ctx["code"], insn_umov_x_d(14, 14))
                push_u32_le(ctx["code"], insn_umov_x_d(15, 15))
    
                // rem = n - (groups_saved * 4)
                //
                // Rolling note: compute `groups_saved * 4` via add-doubling rather than `LSLV`
                // to keep tail handling robust if variable-shift encoding changes.
                push_u32_le(ctx["code"], insn_add_reg(10, 10, 10)) // X10 *= 2
                push_u32_le(ctx["code"], insn_add_reg(10, 10, 10)) // X10 *= 4
                push_u32_le(ctx["code"], insn_sub_reg(7, 7, 10))   // X7 = rem
    
                // If rem == 0, skip tail.
                push_u32_le(ctx["code"], insn_cmp_reg(7, 31))
                var br_done4i = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                // Scalar tail: sign-extended i32 loads.
                var tail_loop4i = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], insn_ldrsw(11, 5, 0))      // X11 = av
                push_u32_le(ctx["code"], insn_add_imm(5, 5, 4))
    
                // b0
                push_u32_le(ctx["code"], insn_ldrsw(16, 4, 0))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 4))
                push_u32_le(ctx["code"], insn_mul(16, 11, 16))
                push_u32_le(ctx["code"], insn_add_reg(12, 12, 16))
    
                // b1
                push_u32_le(ctx["code"], insn_ldrsw(16, 3, 0))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 4))
                push_u32_le(ctx["code"], insn_mul(16, 11, 16))
                push_u32_le(ctx["code"], insn_add_reg(13, 13, 16))
    
                // b2
                push_u32_le(ctx["code"], insn_ldrsw(16, 2, 0))
                push_u32_le(ctx["code"], insn_add_imm(2, 2, 4))
                push_u32_le(ctx["code"], insn_mul(16, 11, 16))
                push_u32_le(ctx["code"], insn_add_reg(14, 14, 16))
    
                // b3
                push_u32_le(ctx["code"], insn_ldrsw(16, 1, 0))
                push_u32_le(ctx["code"], insn_add_imm(1, 1, 4))
                push_u32_le(ctx["code"], insn_mul(16, 11, 16))
                push_u32_le(ctx["code"], insn_add_reg(15, 15, 16))
    
                push_u32_le(ctx["code"], insn_sub_imm(7, 7, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(7, 31))
                var br_tail4i = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var done_pos4i = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_done4i, insn_b_cond((done_pos4i - br_done4i) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_tail4i, insn_b_cond((tail_loop4i - br_tail4i) / 4, 1)) // NE
    
                // Store results to out_ptr (X0) as i64 little-endian.
                push_u32_le(ctx["code"], insn_mov_reg(20, 0)) // X20 = out_ptr
                push_u32_le(ctx["code"], insn_str_ptr(12, 20))
                push_u32_le(ctx["code"], insn_add_imm(20, 20, 8))
                push_u32_le(ctx["code"], insn_str_ptr(13, 20))
                push_u32_le(ctx["code"], insn_add_imm(20, 20, 8))
                push_u32_le(ctx["code"], insn_str_ptr(14, 20))
                push_u32_le(ctx["code"], insn_add_imm(20, 20, 8))
                push_u32_le(ctx["code"], insn_str_ptr(15, 20))
    
                // Return out_ptr in X0.
                return true
            }

            if fn_name == "simd_gemm_i32_4x4_ptr" {
                // Intrinsic: true single-pass 4x4 i32 GEMM microkernel over raw pointers.
                // Signature:
                //   simd_gemm_i32_4x4_ptr(
                //     out_ptr,
                //     a0_ptr, a1_ptr, a2_ptr, a3_ptr,
                //     b0_ptr, b1_ptr, b2_ptr, b3_ptr,
                //     n
                //   ) -> out_ptr
                //
                // Semantics:
                // - sign-extend i32 lanes to i64 for multiplication
                // - accumulate with i64 two's-complement wrap-around
                //
                // Determinism:
                // - integer wrap arithmetic is associative in Z/2^64, so SIMD reassociation is safe
                // - scalar tail handles non-multiple-of-4 lengths
                //
                // Performance goal:
                // - load each B column vector once per k-block and reuse across 4 rows
                var args10 = expr["args"]
                if args10 == nil || oren_list_len(args10) != 10 {
                    native_error(ctx, expr["token"], "native backend: simd_gemm_i32_4x4_ptr expects 10 arguments")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }
    
                // Compile args: out_ptr, a0..a3, b0..b3, n
                native_compile_expr(ctx, args10[0]) // out_ptr -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args10[1]) // a0_ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args10[2]) // a1_ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args10[3]) // a2_ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args10[4]) // a3_ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args10[5]) // b0_ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args10[6]) // b1_ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args10[7]) // b2_ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args10[8]) // b3_ptr
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16
    
                native_compile_expr(ctx, args10[9]) // n -> X0
    
                // Pop in reverse into working regs:
                // b3 -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // b2 -> X2
                push_u32_le(ctx["code"], insn_ldr_reg_sp(2, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // b1 -> X3
                push_u32_le(ctx["code"], insn_ldr_reg_sp(3, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // b0 -> X4
                push_u32_le(ctx["code"], insn_ldr_reg_sp(4, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // a3 -> X8
                push_u32_le(ctx["code"], insn_ldr_reg_sp(8, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // a2 -> X7
                push_u32_le(ctx["code"], insn_ldr_reg_sp(7, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // a1 -> X6
                push_u32_le(ctx["code"], insn_ldr_reg_sp(6, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // a0 -> X5
                push_u32_le(ctx["code"], insn_ldr_reg_sp(5, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // out_ptr -> X9
                push_u32_le(ctx["code"], insn_ldr_reg_sp(9, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16
    
                // Preserve inputs:
                // - X10 = n (compiled into X0)
                // - X0 = out_ptr (return value)
                push_u32_le(ctx["code"], insn_mov_reg(10, 0)) // X10 = n
                push_u32_le(ctx["code"], insn_mov_reg(0, 9))  // X0 = out_ptr
    
                // Zero register for vector init.
                push_u32_le(ctx["code"], insn_movz(11, 0))
    
                // Accumulators: V0..V15 (2D lanes) = 0
                var acci = 0
                while acci < 16 {
                    push_u32_le(ctx["code"], insn_dup_2d(acci, 11))
                    acci = acci + 1
                }
    
                // X13 = groups = n>>2, X12 = shift(2), X14 = groups_saved
                push_u32_le(ctx["code"], insn_mov_reg(13, 10))
                push_u32_le(ctx["code"], insn_movz(12, 2))
                push_u32_le(ctx["code"], insn_lsrv(13, 13, 12))
                push_u32_le(ctx["code"], insn_mov_reg(14, 13))
    
                // If groups == 0, skip vector loop.
                push_u32_le(ctx["code"], insn_cmp_reg(13, 31))
                var br_skip_vec_gemm_i = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_loop_gemm_i = oren_list_len(ctx["code"])
    
                // Load B vectors once per group and keep them in V16..V19.
                push_u32_le(ctx["code"], insn_ldr_q(16, 4))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 16))
                push_u32_le(ctx["code"], insn_ldr_q(17, 3))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 16))
                push_u32_le(ctx["code"], insn_ldr_q(18, 2))
                push_u32_le(ctx["code"], insn_add_imm(2, 2, 16))
                push_u32_le(ctx["code"], insn_ldr_q(19, 1))
                push_u32_le(ctx["code"], insn_add_imm(1, 1, 16))
    
                // Row loop (4 rows): load A row (V20) and update 4 columns.
                var rowi = 0
                while rowi < 4 {
                    // Select pointer reg for this row.
                    var x_a = 5
                    if rowi == 1 { x_a = 6 }
                    if rowi == 2 { x_a = 7 }
                    if rowi == 3 { x_a = 8 }
    
                    // Load A row vector.
                    push_u32_le(ctx["code"], insn_ldr_q(20, x_a))
                    push_u32_le(ctx["code"], insn_add_imm(x_a, x_a, 16))
    
                    var coli = 0
                    while coli < 4 {
                        // smull v24.2d, v20.2s, vB.2s
                        // smull2 v25.2d, v20.4s, vB.4s
                        // v24 += v25
                        // acc += v24
                        var v_b = 16 + coli
                        var acc = rowi * 4 + coli
                        push_u32_le(ctx["code"], insn_smull_2d(24, 20, v_b))
                        push_u32_le(ctx["code"], insn_smull2_2d(25, 20, v_b))
                        push_u32_le(ctx["code"], insn_add_2d(24, 24, 25))
                        push_u32_le(ctx["code"], insn_add_2d(acc, acc, 24))
                        coli = coli + 1
                    }
                    rowi = rowi + 1
                }
    
                // groups--
                push_u32_le(ctx["code"], insn_sub_imm(13, 13, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(13, 31))
                var br_vec_loop_gemm_i_b = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var vec_end_gemm_i = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_skip_vec_gemm_i, insn_b_cond((vec_end_gemm_i - br_skip_vec_gemm_i) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_vec_loop_gemm_i_b, insn_b_cond((vec_loop_gemm_i - br_vec_loop_gemm_i_b) / 4, 1)) // NE
    
                // Reduce and store vector partial sums into out_ptr (row-major).
                // Keep the results in memory so the scalar tail can update them without needing 16 X regs.
                push_u32_le(ctx["code"], insn_mov_reg(16, 9)) // X16 = out_ptr cursor
                var storei = 0
                while storei < 16 {
                    push_u32_le(ctx["code"], insn_addp_2d(storei, storei, storei))
                    push_u32_le(ctx["code"], insn_umov_x_d(17, storei))
                    push_u32_le(ctx["code"], insn_str_ptr(17, 16))
                    if storei != 15 {
                        push_u32_le(ctx["code"], insn_add_imm(16, 16, 8))
                    }
                    storei = storei + 1
                }
    
                // rem = n - (groups_saved * 4)
                //
                // Rolling note: compute `groups_saved * 4` via add-doubling rather than `LSLV`
                // to keep tail handling robust if variable-shift encoding changes.
                push_u32_le(ctx["code"], insn_add_reg(14, 14, 14))  // X14 *= 2
                push_u32_le(ctx["code"], insn_add_reg(14, 14, 14))  // X14 *= 4
                push_u32_le(ctx["code"], insn_sub_reg(10, 10, 14))  // X10 = rem
    
                // If rem == 0, done.
                push_u32_le(ctx["code"], insn_cmp_reg(10, 31))
                var br_done_gemm_i = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                // Scalar tail loop:
                // Update the already-stored 16 i64 outputs in memory for each remaining k.
                var tail_loop_gemm_i = oren_list_len(ctx["code"])
    
                // Load a0..a3 (sign-extend i32) and advance pointers.
                push_u32_le(ctx["code"], insn_ldrsw(11, 5, 0))
                push_u32_le(ctx["code"], insn_add_imm(5, 5, 4))
                push_u32_le(ctx["code"], insn_ldrsw(12, 6, 0))
                push_u32_le(ctx["code"], insn_add_imm(6, 6, 4))
                push_u32_le(ctx["code"], insn_ldrsw(13, 7, 0))
                push_u32_le(ctx["code"], insn_add_imm(7, 7, 4))
                push_u32_le(ctx["code"], insn_ldrsw(14, 8, 0))
                push_u32_le(ctx["code"], insn_add_imm(8, 8, 4))
    
                // Load b0..b3 (sign-extend i32) and advance pointers.
                push_u32_le(ctx["code"], insn_ldrsw(15, 4, 0))
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 4))
                push_u32_le(ctx["code"], insn_ldrsw(17, 3, 0))
                push_u32_le(ctx["code"], insn_add_imm(3, 3, 4))
                push_u32_le(ctx["code"], insn_ldrsw(18, 2, 0))
                push_u32_le(ctx["code"], insn_add_imm(2, 2, 4))
                push_u32_le(ctx["code"], insn_ldrsw(19, 1, 0))
                push_u32_le(ctx["code"], insn_add_imm(1, 1, 4))
    
                // Reset cursor to out_ptr for this k.
                push_u32_le(ctx["code"], insn_mov_reg(16, 9))
    
                // Update 16 outputs: out += a_r * b_c
                //
                // Use X20 as product temp, X21 as sum temp.
                var rr2 = 0
                while rr2 < 4 {
                    var a_reg = 11
                    if rr2 == 1 { a_reg = 12 }
                    if rr2 == 2 { a_reg = 13 }
                    if rr2 == 3 { a_reg = 14 }
                    var cc2 = 0
                    while cc2 < 4 {
                        var b_reg = 15
                        if cc2 == 1 { b_reg = 17 }
                        if cc2 == 2 { b_reg = 18 }
                        if cc2 == 3 { b_reg = 19 }
                        push_u32_le(ctx["code"], insn_ldr_ptr(21, 16))     // load current out
                        push_u32_le(ctx["code"], insn_mul(20, a_reg, b_reg))
                        push_u32_le(ctx["code"], insn_add_reg(21, 21, 20))
                        push_u32_le(ctx["code"], insn_str_ptr(21, 16))
                        if rr2 != 3 || cc2 != 3 {
                            push_u32_le(ctx["code"], insn_add_imm(16, 16, 8))
                        }
                        cc2 = cc2 + 1
                    }
                    rr2 = rr2 + 1
                }
    
                // rem--
                push_u32_le(ctx["code"], insn_sub_imm(10, 10, 1))
                push_u32_le(ctx["code"], insn_cmp_reg(10, 31))
                var br_tail_gemm_i = oren_list_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
    
                var done_pos_gemm_i = oren_list_len(ctx["code"])
                set_u32_le(ctx["code"], br_done_gemm_i, insn_b_cond((done_pos_gemm_i - br_done_gemm_i) / 4, 0)) // EQ
                set_u32_le(ctx["code"], br_tail_gemm_i, insn_b_cond((tail_loop_gemm_i - br_tail_gemm_i) / 4, 1)) // NE
    
                return true
            }

    return false
}
