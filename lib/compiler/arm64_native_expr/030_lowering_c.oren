// Chunked out of native_compile_expr call handling for include coherence.
fn _arm64_expr_env_enabled_default_false(name) {
    var v = oren_env(name)
    if v == "1" || v == "true" { return true }
    return false
}

fn _arm64_expr_parse_tick_mask_decimal(v, default_mask) {
    if v == nil || v == "" { return default_mask }
    var n = oren_string_len(v)
    if n <= 0 { return default_mask }
    var i = 0
    var acc = 0
    while i < n {
        var c = oren_string_byte_at_unchecked(v, i) & 255
        if c < 48 || c > 57 { return default_mask }
        acc = acc * 10 + (c - 48)
        if acc > 65535 { return default_mask }
        i = i + 1
    }
    return acc
}

fn _arm64_expr_slot_direct_fast_tick_mask() {
    return _arm64_expr_parse_tick_mask_decimal(oren_env("OREN_ARM64_LIST_INT_SLOT_DIRECT_TICK_MASK"), 4095)
}

fn _arm64_expr_emit_slot_direct_gc_tick_init(ctx, tick_mask) {
    var period = arm64_tick_period_from_mask(tick_mask)
    if period > 0 {
        emit_load_u64_imm(ctx, 9, period)
        return nil
    }
    push_u32_le(ctx["code"], insn_movz(9, 0))
    push_u32_le(ctx["code"], insn_movz(10, tick_mask))
    return nil
}

fn _arm64_expr_emit_slot_direct_gc_tick(ctx, tick_mask, fast_tick, spill_pairs) {
    var period = arm64_tick_period_from_mask(tick_mask)
    if period > 0 {
        push_u32_le(ctx["code"], insn_subs_imm(9, 9, 1))
    } else {
        push_u32_le(ctx["code"], insn_add_imm(9, 9, 1))
        push_u32_le(ctx["code"], insn_and_reg(11, 9, 10))
        push_u32_le(ctx["code"], insn_cmp_reg(11, 31))
    }
    var jpos_skip_gc = bytes_len(ctx["code"])
    push_u32_le(ctx["code"], 0)
    if fast_tick == true {
        native_emit_gc_safepoint_call_expr_pairs(ctx, spill_pairs)
    } else {
        native_emit_gc_safepoint_call_expr(ctx)
    }
    _arm64_expr_emit_slot_direct_gc_tick_init(ctx, tick_mask)
    var after_gc = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], jpos_skip_gc, insn_b_cond((after_gc - jpos_skip_gc) / 4, 1)) // NE
    return nil
}

fn native_call_chunk_030_lowering_c(ctx, fn_name, expr, args) {

            if fn_name == "oren_list_len" || fn_name == "STD_list_len" {
                // Intrinsic: list length (fast-path, no runtime call).
	                //
	                // Runtime layout: [count][capacity][buffer_ptr][magic]
	                // - nil list => 0
	                // - non-list => deterministic panic (matches runtime)
                var args0 = expr["args"]
                if args0 == nil || oren_list_len(args0) != 1 {
                    native_error(ctx, expr["token"], "native backend: oren_list_len expects 1 argument")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }

                native_compile_expr(ctx, args0[0]) // list -> X0

                // nil => 0
                push_u32_le(ctx["code"], insn_movz(1, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(0, 1))
                var br_non_nil = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                push_u32_le(ctx["code"], insn_movz(0, 0))
                var br_done = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

	                var non_nil_pos = bytes_len(ctx["code"])
	                set_u32_le(ctx["code"], br_non_nil, insn_b_cond((non_nil_pos - br_non_nil) / 4, 1)) // NE
	
	                // Tier‑1 safety: never read object headers from untracked pointers.
	                //
	                // Use tracked-node kind to validate list-ness before any header loads.
	                // This matches the native runtime contract:
	                // - node.kind == 2 => LIST
	                // - node.kind == 8 => LIST_INT
	                // - node.kind == 3 => MAP (not accepted here)
	                push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = list
	
	                // node = _list_find_node_known_kind(list, LIST)
	                emit_load_i64_imm(ctx, 1, 2)
	                var bl_find_node = bytes_len(ctx["code"])
	                push_u32_le(ctx["code"], 0)
	                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find_node, "name": "_list_find_node_known_kind"})
	                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find_node)
	                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -12)
	
                // node == 0 => fallback on magic or panic
                push_u32_le(ctx["code"], insn_movz(1, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(0, 1))
                var br_node_nonzero = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                // Fallback: if magic matches, accept even if untracked.
                push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // X0 = list
                emit_load_ptr_from_base_plus(ctx, 1, 0, 24)   // X1 = magic
                emit_load_i64_imm(ctx, 2, 1279870019)         // X2 = 'LIST'
                push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
                var br_magic_ok0 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.EQ magic_ok
                // Panic helper with diagnostics.
                push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // X0 = list
                emit_load_i64_imm(ctx, 1, 1)                 // X1 = stage (node==0)
                var bl_list_panic0 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_list_panic0, "name": "native_list_len_panic"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_list_panic0)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -5)
                var magic_ok_pos0 = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_magic_ok0, insn_b_cond((magic_ok_pos0 - br_magic_ok0) / 4, 0)) // EQ
                // count (fallback)
                emit_load_ptr_from_base_plus(ctx, 0, 19, 0)
                var br_done_fallback0 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                var node_ok_pos = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_node_nonzero, insn_b_cond((node_ok_pos - br_node_nonzero) / 4, 1)) // NE
	
		                // kind = *(node + 16); require kind==LIST or LIST_INT
		                emit_load_ptr_from_base_plus(ctx, 1, 0, 16)   // X1 = kind
		                emit_load_i64_imm(ctx, 2, 2)                 // X2 = LIST
		                push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
		                var br_kind_ok = bytes_len(ctx["code"])
		                push_u32_le(ctx["code"], 0)
	                emit_load_i64_imm(ctx, 2, 8)                 // X2 = LIST_INT
	                push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
	                var br_kind_int_ok = bytes_len(ctx["code"])
	                push_u32_le(ctx["code"], 0)
	                // Panic helper with diagnostics.
	                push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // X0 = list
	                emit_load_i64_imm(ctx, 1, 2)                 // X1 = stage (kind mismatch)
	                var bl_list_panic1 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_list_panic1, "name": "native_list_len_panic"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_list_panic1)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -5)
		                var kind_ok_pos = bytes_len(ctx["code"])
		                set_u32_le(ctx["code"], br_kind_ok, insn_b_cond((kind_ok_pos - br_kind_ok) / 4, 0)) // EQ
		                set_u32_le(ctx["code"], br_kind_int_ok, insn_b_cond((kind_ok_pos - br_kind_int_ok) / 4, 0)) // EQ
	
	                // Restore list pointer and validate magic.
	                push_u32_le(ctx["code"], insn_mov_reg(0, 19))
	                emit_load_ptr_from_base_plus(ctx, 1, 0, 24)   // X1 = magic
	                emit_load_i64_imm(ctx, 2, 1279870019)         // X2 = 'LIST'
	                push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
	                var br_is_list = bytes_len(ctx["code"])
	                push_u32_le(ctx["code"], 0)
                // Panic helper with diagnostics.
                emit_load_i64_imm(ctx, 1, 3)                 // X1 = stage (magic mismatch)
                var bl_list_panic2 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_list_panic2, "name": "native_list_len_panic"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_list_panic2)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -5)
	                var is_list_pos = bytes_len(ctx["code"])
	                set_u32_le(ctx["code"], br_is_list, insn_b_cond((is_list_pos - br_is_list) / 4, 0)) // EQ

                // count
                emit_load_ptr_from_base_plus(ctx, 0, 0, 0)

                var done_pos = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_done, insn_b((done_pos - br_done) / 4))
                set_u32_le(ctx["code"], br_done_fallback0, insn_b((done_pos - br_done_fallback0) / 4))
                return true
            }

            if fn_name == "oren_list_int_len_unchecked" || fn_name == "STD_list_int_len_unchecked" {
                // Intrinsic: list<int> length (fast-path, unchecked).
                //
                // Runtime layout: [count][capacity][buffer_ptr][magic]
                // - nil list => 0
                var args0iu = expr["args"]
                if args0iu == nil || oren_list_len(args0iu) != 1 {
                    native_error(ctx, expr["token"], "native backend: oren_list_int_len_unchecked expects 1 argument")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }

                native_compile_expr(ctx, args0iu[0]) // list -> X0

                // nil => 0
                push_u32_le(ctx["code"], insn_movz(1, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(0, 1))
                var br_non_nil_iu = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                push_u32_le(ctx["code"], insn_movz(0, 0))
                var br_done_iu = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                var non_nil_pos_iu = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_non_nil_iu, insn_b_cond((non_nil_pos_iu - br_non_nil_iu) / 4, 1)) // NE

                // count
                emit_load_ptr_from_base_plus(ctx, 0, 0, 0)

                var done_pos_iu = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_done_iu, insn_b((done_pos_iu - br_done_iu) / 4))
                return true
            }

            if fn_name == "oren_list_int_len" || fn_name == "STD_list_int_len" {
                // Intrinsic: list<int> length (fast-path, no runtime call).
                //
                // Runtime layout: [count][capacity][buffer_ptr][magic]
                // - nil list => 0
                // - non-list => deterministic panic (matches runtime)
                var args0i = expr["args"]
                if args0i == nil || oren_list_len(args0i) != 1 {
                    native_error(ctx, expr["token"], "native backend: oren_list_int_len expects 1 argument")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }

                native_compile_expr(ctx, args0i[0]) // list -> X0

                // nil => 0
                push_u32_le(ctx["code"], insn_movz(1, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(0, 1))
                var br_non_nil_i = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                push_u32_le(ctx["code"], insn_movz(0, 0))
                var br_done_i = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                var non_nil_pos_i = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_non_nil_i, insn_b_cond((non_nil_pos_i - br_non_nil_i) / 4, 1)) // NE

                // Tier‑1 safety: never read object headers from untracked pointers.
                // Use tracked-node kind to validate list-ness before any header loads.
                // - node.kind == 8 => LIST_INT
                push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = list

                // node = _list_find_node_known_kind(list, LIST_INT)
                emit_load_i64_imm(ctx, 1, 8)
                var bl_find_node_i = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find_node_i, "name": "_list_find_node_known_kind"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find_node_i)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -12)

                // node == 0 => fallback on magic or panic
                push_u32_le(ctx["code"], insn_movz(1, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(0, 1))
                var br_node_nonzero_i = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                // Fallback: if magic matches, accept even if untracked.
                push_u32_le(ctx["code"], insn_mov_reg(0, 19)) // X0 = list
                emit_load_ptr_from_base_plus(ctx, 1, 0, 24)   // X1 = magic
                emit_load_i64_imm(ctx, 2, 1279870019)         // X2 = 'LIST'
                push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
                var br_magic_ok_i = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0) // B.EQ magic_ok
                native_emit_panic(ctx, "list_int_len on non-list")
                var magic_ok_pos_i = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_magic_ok_i, insn_b_cond((magic_ok_pos_i - br_magic_ok_i) / 4, 0)) // EQ
                // count (fallback)
                emit_load_ptr_from_base_plus(ctx, 0, 19, 0)
                var br_done_fallback_i = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                var node_ok_pos_i = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_node_nonzero_i, insn_b_cond((node_ok_pos_i - br_node_nonzero_i) / 4, 1)) // NE

                // kind = *(node + 16); require kind==LIST_INT
                emit_load_ptr_from_base_plus(ctx, 1, 0, 16)   // X1 = kind
                emit_load_i64_imm(ctx, 2, 8)                 // X2 = LIST_INT
                push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
                var br_kind_ok_i = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_int_len on non-list")
                var kind_ok_pos_i = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_kind_ok_i, insn_b_cond((kind_ok_pos_i - br_kind_ok_i) / 4, 0)) // EQ

                // Restore list pointer and validate magic.
                push_u32_le(ctx["code"], insn_mov_reg(0, 19))
                emit_load_ptr_from_base_plus(ctx, 1, 0, 24)   // X1 = magic
                emit_load_i64_imm(ctx, 2, 1279870019)         // X2 = 'LIST'
                push_u32_le(ctx["code"], insn_cmp_reg(1, 2))
                var br_is_list_i = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_int_len on non-list")
                var is_list_pos_i = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_is_list_i, insn_b_cond((is_list_pos_i - br_is_list_i) / 4, 0)) // EQ

                // count
                emit_load_ptr_from_base_plus(ctx, 0, 0, 0)

                var done_pos_i = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_done_i, insn_b((done_pos_i - br_done_i) / 4))
                set_u32_le(ctx["code"], br_done_fallback_i, insn_b((done_pos_i - br_done_fallback_i) / 4))
                return true
            }

            if fn_name == "oren_list_push" || fn_name == "STD_list_push" {
                // Intrinsic: list push fast-path (in-bounds capacity case), fallback to runtime for growth.
	                //
	                // Signature: oren_list_push(list, value) -> nil
                var args1 = expr["args"]
                if args1 == nil || oren_list_len(args1) != 2 {
                    native_error(ctx, expr["token"], "native backend: oren_list_push expects 2 arguments")
                    push_u32_le(ctx["code"], insn_movz(0, 0))
                    return true
                }

                // Eval list -> stack
                native_compile_expr(ctx, args1[0]) // list -> X0
                push_u32_le(ctx["code"], insn_sub_sp(16))
                push_u32_le(ctx["code"], insn_str_x0_sp(0))
                ctx["stack_size"] = ctx["stack_size"] + 16

                // Eval value -> X0
                native_compile_expr(ctx, args1[1])

                // Pop list -> X1
                push_u32_le(ctx["code"], insn_ldr_reg_sp(1, 0))
                push_u32_le(ctx["code"], insn_add_sp(16))
                ctx["stack_size"] = ctx["stack_size"] - 16

                // Swap: X0=value, X1=list => X0=list, X1=value
                push_u32_le(ctx["code"], insn_mov_reg(2, 0))
                push_u32_le(ctx["code"], insn_mov_reg(0, 1))
                push_u32_le(ctx["code"], insn_mov_reg(1, 2))

                // nil => panic
                push_u32_le(ctx["code"], insn_movz(2, 0))
                push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
                var br_non_nil2 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                native_emit_panic(ctx, "list_push on nil")
	                var non_nil_pos2 = bytes_len(ctx["code"])
	                set_u32_le(ctx["code"], br_non_nil2, insn_b_cond((non_nil_pos2 - br_non_nil2) / 4, 1)) // NE
	
	                // Tier‑1 safety: never read object headers from untracked pointers.
	                // Validate list via tracked-node kind first (matches runtime contract).
	                push_u32_le(ctx["code"], insn_mov_reg(19, 0)) // X19 = list
	                push_u32_le(ctx["code"], insn_mov_reg(20, 1)) // X20 = value
	
		                // node = _list_find_node_known_kind(list, LIST)
		                push_u32_le(ctx["code"], insn_mov_reg(0, 19))
		                emit_load_i64_imm(ctx, 1, 2)
		                var bl_find_node2 = bytes_len(ctx["code"])
		                push_u32_le(ctx["code"], 0)
		                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_find_node2, "name": "_list_find_node_known_kind"})
		                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_find_node2)
		                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -12)
	
	                // node == 0 => panic
	                push_u32_le(ctx["code"], insn_movz(2, 0))
	                push_u32_le(ctx["code"], insn_cmp_reg(0, 2))
	                var br_node_nonzero2 = bytes_len(ctx["code"])
	                push_u32_le(ctx["code"], 0)
	                native_emit_panic(ctx, "list_push on non-list")
	                var node_ok_pos2b = bytes_len(ctx["code"])
	                set_u32_le(ctx["code"], br_node_nonzero2, insn_b_cond((node_ok_pos2b - br_node_nonzero2) / 4, 1)) // NE
	
	                // kind = *(node + 16); require kind==LIST
	                emit_load_ptr_from_base_plus(ctx, 2, 0, 16) // X2 = kind
	                emit_load_i64_imm(ctx, 3, 2)               // X3 = LIST
	                push_u32_le(ctx["code"], insn_cmp_reg(2, 3))
	                var br_kind_ok2 = bytes_len(ctx["code"])
	                push_u32_le(ctx["code"], 0)
	                native_emit_panic(ctx, "list_push on non-list")
	                var kind_ok_pos2 = bytes_len(ctx["code"])
	                set_u32_le(ctx["code"], br_kind_ok2, insn_b_cond((kind_ok_pos2 - br_kind_ok2) / 4, 0)) // EQ
	
	                // Restore list/value and validate magic.
	                push_u32_le(ctx["code"], insn_mov_reg(0, 19))
	                push_u32_le(ctx["code"], insn_mov_reg(1, 20))
	                emit_load_ptr_from_base_plus(ctx, 2, 0, 24) // X2 = magic
	                emit_load_i64_imm(ctx, 3, 1279870019)       // X3 = 'LIST'
	                push_u32_le(ctx["code"], insn_cmp_reg(2, 3))
	                var br_is_list2 = bytes_len(ctx["code"])
	                push_u32_le(ctx["code"], 0)
	                native_emit_panic(ctx, "list_push on non-list")
	                var is_list_pos2 = bytes_len(ctx["code"])
	                set_u32_le(ctx["code"], br_is_list2, insn_b_cond((is_list_pos2 - br_is_list2) / 4, 0)) // EQ

                // Load count/cap/buf
                emit_load_ptr_from_base_plus(ctx, 4, 0, 0)   // X4 = count
                emit_load_ptr_from_base_plus(ctx, 5, 0, 8)   // X5 = cap
                emit_load_ptr_from_base_plus(ctx, 6, 0, 16)  // X6 = buf

                // if count < cap => fast store; else => slow path call
                push_u32_le(ctx["code"], insn_cmp_reg(4, 5))
                var br_fast = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                // Slow path: call runtime oren_list_push_unchecked(list, value)
                var bl_pos = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)
                oren_list_push(ctx["fixups"], {"type": "bl", "pos": bl_pos, "name": "oren_list_push_unchecked"})
                oren_list_push(ctx["fixups_local_compact"]["bl_pos"], bl_pos)
                oren_list_push(ctx["fixups_local_compact"]["bl_name"], -11)
                var br_done2 = bytes_len(ctx["code"])
                push_u32_le(ctx["code"], 0)

                // Fast path
                var fast_pos = bytes_len(ctx["code"])
                set_u32_le(ctx["code"], br_fast, insn_b_cond((fast_pos - br_fast) / 4, 11)) // LT

                // addr = buf + count*8
                emit_load_i64_imm(ctx, 2, 8)
                push_u32_le(ctx["code"], insn_mul(7, 4, 2))      // X7 = count*8
                push_u32_le(ctx["code"], insn_add_reg(7, 6, 7))  // X7 = buf + off
                push_u32_le(ctx["code"], insn_str_ptr(1, 7))     // *(addr) = value

                // count++
                push_u32_le(ctx["code"], insn_add_imm(4, 4, 1))
                push_u32_le(ctx["code"], insn_str_ptr(4, 0))     // *(list) = count+1

                if ctx["trace_native_list_hdr"] != nil {
                    // GC safety: keep the list pointer on stack so trace-time allocations
                    // don't lose the only live reference (GC scans the stack, not registers).
                    push_u32_le(ctx["code"], insn_sub_sp(16))
                    push_u32_le(ctx["code"], insn_str_x0_sp(0))
                    emit_load_i64_imm(ctx, 1, 4) // list_push
