            set_u32_le(ctx["code"], br_skip_vec_gemm_i, insn_b_cond((vec_end_gemm_i - br_skip_vec_gemm_i) / 4, 0)) // EQ
            set_u32_le(ctx["code"], br_vec_loop_gemm_i_b, insn_b_cond((vec_loop_gemm_i - br_vec_loop_gemm_i_b) / 4, 1)) // NE

            // Reduce and store vector partial sums into out_ptr (row-major).
            // Keep the results in memory so the scalar tail can update them without needing 16 X regs.
            push_u32_le(ctx["code"], insn_mov_reg(16, 9)) // X16 = out_ptr cursor
