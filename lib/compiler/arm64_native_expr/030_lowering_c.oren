                var x_a = 5
                if rowi == 1 { x_a = 6 }
                if rowi == 2 { x_a = 7 }
                if rowi == 3 { x_a = 8 }

                // Load A row vector.
                push_u32_le(ctx["code"], insn_ldr_q(20, x_a))
                push_u32_le(ctx["code"], insn_add_imm(x_a, x_a, 16))

                var coli = 0
                while coli < 4 {
                    // smull v24.2d, v20.2s, vB.2s
                    // smull2 v25.2d, v20.4s, vB.4s
                    // v24 += v25
                    // acc += v24
                    var v_b = 16 + coli
                    var acc = rowi * 4 + coli
                    push_u32_le(ctx["code"], insn_smull_2d(24, 20, v_b))
                    push_u32_le(ctx["code"], insn_smull2_2d(25, 20, v_b))
                    push_u32_le(ctx["code"], insn_add_2d(24, 24, 25))
                    push_u32_le(ctx["code"], insn_add_2d(acc, acc, 24))
                    coli = coli + 1
