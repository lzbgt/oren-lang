        if fn_name == "simd_gemm_i32_4x4_ptr" {
            // Intrinsic: true single-pass 4x4 i32 GEMM microkernel over raw pointers.
            // Signature:
            //   simd_gemm_i32_4x4_ptr(
            //     out_ptr,
            //     a0_ptr, a1_ptr, a2_ptr, a3_ptr,
            //     b0_ptr, b1_ptr, b2_ptr, b3_ptr,
            //     n
            //   ) -> out_ptr
            //
            // Semantics:
            // - sign-extend i32 lanes to i64 for multiplication
            // - accumulate with i64 two's-complement wrap-around
            //
            // Determinism:
            // - integer wrap arithmetic is associative in Z/2^64, so SIMD reassociation is safe
            // - scalar tail handles non-multiple-of-4 lengths
