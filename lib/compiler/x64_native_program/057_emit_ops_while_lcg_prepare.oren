fn _x64_fast_lcg_prepare_inputs(info) {
    if info == nil { return nil }
    return {
        "idx": info["idx"],
        "n": info["n"],
        "x": info["x"],
        "sum": info["sum"],
        "mod": info["mod"],
        "mod_const": info["mod_const"],
        "mul": info["mul"],
        "add": info["add"],
        "mod_x": info["mod_x"],
        "mod_i": info["mod_i"]
    }
}

fn _x64_fast_lcg_prepare_mod_recip(inputs) {
    var mod_const = inputs["mod_const"]
    var mod_x = inputs["mod_x"]
    var mod_i = inputs["mod_i"]
    var mod_recip = nil
    var modx_recip = nil
    var modi_recip = nil
    var use_fastmod = false
    if mod_const != nil {
        mod_recip = _x64_fastmod_recip_u64(mod_const)
        modx_recip = _x64_fastmod_recip_u64(mod_x)
        modi_recip = _x64_fastmod_recip_u64(mod_i)
        if mod_recip != nil && modx_recip != nil && modi_recip != nil { use_fastmod = true }
    }
    return {
        "mod_recip": mod_recip,
        "modx_recip": modx_recip,
        "modi_recip": modi_recip,
        "use_fastmod": use_fastmod
    }
}

fn _x64_fast_lcg_lookup_local_offsets(inputs, locals) {
    var mod_name = inputs["mod"]
    var off_mod = nil
    if mod_name != nil { off_mod = locals[mod_name] }
    return {
        "off_idx": locals[inputs["idx"]],
        "off_n": locals[inputs["n"]],
        "off_x": locals[inputs["x"]],
        "off_sum": locals[inputs["sum"]],
        "off_mod": off_mod
    }
}

fn _x64_fast_lcg_offsets_valid(inputs, offsets) {
    var mod_name = inputs["mod"]
    if oren_type_tag(offsets["off_idx"]) == 0 || oren_type_tag(offsets["off_n"]) == 0 ||
       oren_type_tag(offsets["off_x"]) == 0 || oren_type_tag(offsets["off_sum"]) == 0 ||
       (mod_name != nil && oren_type_tag(offsets["off_mod"]) == 0) {
        return false
    }
    if mod_name == nil {
        var mod_const = inputs["mod_const"]
        if mod_const == nil || mod_const <= 0 { return false }
    }
    return true
}

fn _x64_fast_lcg_has_gc_tick_local(locals) {
    var off_tick = locals["$tmp_gc_tick"]
    if oren_type_tag(off_tick) == 0 || off_tick == 0 { return false }
    return true
}

fn _x64_fast_lcg_prepare_offsets(inputs, locals) {
    var offsets = _x64_fast_lcg_lookup_local_offsets(inputs, locals)
    if _x64_fast_lcg_offsets_valid(inputs, offsets) != true { return nil }
    if _x64_fast_lcg_has_gc_tick_local(locals) != true { return nil }
    return offsets
}

fn _x64_fast_lcg_prepare_temp(ctx, locals) {
    var base = _intr_tmp_push(ctx, 1)
    if oren_type_tag(base) == 0 { return nil }
    var off_i_mod = _intr_tmp_off(ctx, locals, base)
    if oren_type_tag(off_i_mod) == 0 || off_i_mod == 0 {
        _intr_tmp_pop(ctx, base)
        return nil
    }
    return {"base": base, "off_i_mod": off_i_mod}
}

fn _x64_fast_lcg_prepare_pack(inputs, recips, offsets, temp) {
    var mod_x = inputs["mod_x"]
    var mod_i = inputs["mod_i"]
    return {
        "mod": inputs["mod"],
        "mod_const": inputs["mod_const"],
        "mul": inputs["mul"],
        "add": inputs["add"],
        "mod_x": mod_x,
        "mod_i": mod_i,
        "sum_cap": mod_x + mod_i,
        "mod_recip": recips["mod_recip"],
        "modx_recip": recips["modx_recip"],
        "modi_recip": recips["modi_recip"],
        "use_fastmod": recips["use_fastmod"],
        "off_idx": offsets["off_idx"],
        "off_n": offsets["off_n"],
        "off_x": offsets["off_x"],
        "off_sum": offsets["off_sum"],
        "off_mod": offsets["off_mod"],
        "base": temp["base"],
        "off_i_mod": temp["off_i_mod"]
    }
}

fn _x64_fast_lcg_prepare(ctx, info, locals) {
    var inputs = _x64_fast_lcg_prepare_inputs(info)
    if inputs == nil { return nil }
    var recips = _x64_fast_lcg_prepare_mod_recip(inputs)
    var offsets = _x64_fast_lcg_prepare_offsets(inputs, locals)
    if offsets == nil { return nil }
    var temp = _x64_fast_lcg_prepare_temp(ctx, locals)
    if temp == nil { return nil }
    return _x64_fast_lcg_prepare_pack(inputs, recips, offsets, temp)
}
