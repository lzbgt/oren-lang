// x64-native (Windows): File-system syscall intrinsics.
//
// Goal (Tier‑1 parity work, rolling):
// - Provide Windows implementations for the syscall-first FS surface used by the runtime:
//     sys_stat / sys_lstat / sys_fstat
//     sys_unlink / sys_rmdir / sys_rename / sys_mkdir / sys_chmod
// - Keep semantics capsule-safe by invoking native_capsule_sys_* pre/post hooks.
// - Return convention: success => >=0, failure => negative errno (POSIX-like).
//
// Notes:
// - Oren's low-level `sys_stat` API historically mirrors platform `struct stat` layouts.
//   That is *not* portable. For Windows we currently use it as an existence/permission probe,
//   and do not attempt to populate a POSIX struct layout yet.
// - In the rolling repository, callers should avoid struct layout assumptions and instead
//   use higher-level helpers (e.g. oren_exists) until an Oren-defined cross-platform Stat
//   layout is introduced.

// --- Windows path normalization (Tier‑1 parity) ---
//
// Oren source code and compiler internals are allowed to use portable '/' separators,
// even on Windows. Win32 APIs are more permissive than many assume, but in practice we
// have seen bring-up regressions where CreateFileA/DeleteFileA/etc reject '/'.
//
// Normalize at the syscall intrinsic boundary to keep:
// - the language / stdlib path semantics portable
// - the native backend robust on x64-windows
//
// Implementation: copy NUL-terminated C string to a stack scratch buffer and replace
// '/' (47) with '\\' (92). The scratch buffer lives only across the single WinAPI call.
var WIN64_PATH_BUF_BYTES = 2048
var WIN64_PATH_SCRATCH_ONE = 2112  // 64 + 2048 (shadow+slack + one buffer)
var WIN64_PATH_SCRATCH_TWO = 4160  // 64 + 4096 (shadow+slack + two buffers)

fn _emit_win64_path_norm_begin_x64(ctx, scratch_bytes) {
    // Reserve a private call-area + scratch space for a single WinAPI call.
    // Must be 16B-aligned so the called WinAPI sees a properly aligned RSP.
    bytes_extend(ctx["code"], core.insn_sub_rsp_imm32(scratch_bytes))
    return nil
}

fn _emit_win64_path_norm_end_x64(ctx, scratch_bytes) {
    bytes_extend(ctx["code"], core.insn_add_rsp_imm32(scratch_bytes))
    return nil
}

fn _emit_win64_path_norm_setup_x64(ctx, src_reg, buf_add) {
    // r10 = dst_start
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(10, 64))
    if buf_add != 0 { bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, buf_add)) }
    // r9 = dst_cursor
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 10))
    // r11 = src_cursor
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, src_reg))
    // r8 = remaining (leave room for NUL)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(8, WIN64_PATH_BUF_BYTES - 1))
    return nil
}

fn _emit_win64_path_norm_labels_x64(ctx) {
    return {
        "labels": {},
        "fixups": [],
        "loop": _new_label(ctx, "win_path_norm_loop"),
        "store": _new_label(ctx, "win_path_norm_store"),
        "done": _new_label(ctx, "win_path_norm_done"),
        "trunc": _new_label(ctx, "win_path_norm_trunc"),
    }
}

fn _emit_win64_path_norm_loop_x64(ctx, st) {
    var labels = st["labels"]
    var fixups = st["fixups"]
    var l_loop = st["loop"]
    var l_store = st["store"]
    var l_done = st["done"]
    var l_trunc = st["trunc"]

    _emit_label(ctx, labels, l_loop)
    // eax = *src_cursor
    bytes_extend(ctx["code"], core.insn_movzx_r32_mr8(0, 11))
    // if eax == 0 => done
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_done)
    // if remaining == 0 => trunc (write NUL and finish)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(8, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_trunc)

    // if eax == '/' => eax = '\\'
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 47))
    _emit_jcc_to_label(ctx, fixups, "ne", l_store)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 92))

    _emit_label(ctx, labels, l_store)
    // *dst_cursor = al
    bytes_extend(ctx["code"], core.insn_mov_mr8_al(9))
    // src_cursor++ ; dst_cursor++ ; remaining--
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 1))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(9, 1))
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(8, 1))
    _emit_jmp_to_label(ctx, fixups, l_loop)
    return nil
}

fn _emit_win64_path_norm_finish_x64(ctx, st, src_reg) {
    var labels = st["labels"]
    var fixups = st["fixups"]
    var l_trunc = st["trunc"]
    var l_done = st["done"]

    _emit_label(ctx, labels, l_trunc)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_mov_mr8_al(9))
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_done)
    // Always NUL-terminate (idempotent if already written by trunc branch).
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_mov_mr8_al(9))
    // src_reg = dst_start (r10)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(src_reg, 10))

    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_win64_path_norm_reg_to_buf_x64(ctx, src_reg, buf_add) {
    // Input:  src_reg holds a pointer to a NUL-terminated path cstr.
    // Output: src_reg updated to point at normalized buffer in scratch.
    //
    // Scratch contract:
    // - Caller must have reserved at least WIN64_PATH_SCRATCH_ONE bytes via
    //   `_emit_win64_path_norm_begin_x64`.
    // - Buffer #1 is at [rsp+64 .. rsp+64+WIN64_PATH_BUF_BYTES).
    // - Buffer #2 is at [rsp+64+WIN64_PATH_BUF_BYTES .. +2*WIN64_PATH_BUF_BYTES) (if allocated).
    //
    // Uses/clobbers: r8, r9, r10, r11, eax.
    _emit_win64_path_norm_setup_x64(ctx, src_reg, buf_add)
    var st = _emit_win64_path_norm_labels_x64(ctx)
    _emit_win64_path_norm_loop_x64(ctx, st)
    _emit_win64_path_norm_finish_x64(ctx, st, src_reg)
    return nil
}

fn _emit_win32_get_last_error_x64(ctx) {
    // eax = GetLastError()
    _emit_call_iat_x64(ctx, "IAT_GetLastError")
    return nil
}

fn _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, next_prefix, winerr, posix_errno) {
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, winerr))
    var l_next = _new_label(ctx, next_prefix)
    _emit_jcc_to_label(ctx, fixups, "ne", l_next)
    _emit_set_rax_neg_errno_x64(ctx, posix_errno)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next)
    return nil
}

fn _emit_win32_last_error_to_neg_errno_common_x64(ctx) {
    // rax = -errno (POSIX-like) mapped from Win32 GetLastError()
    //
    // Uses: eax
    _emit_win32_get_last_error_x64(ctx)

    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "win32_err_done")

    // ERROR_FILE_NOT_FOUND(2) / ERROR_PATH_NOT_FOUND(3) -> ENOENT(2)
    _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, "win32_err_next0", 2, 2)
    _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, "win32_err_next1", 3, 2)

    // ERROR_ACCESS_DENIED(5) -> EACCES(13)
    _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, "win32_err_next2", 5, 13)

    // ERROR_INVALID_HANDLE(6) -> EBADF(9)
    _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, "win32_err_next3", 6, 9)

    // ERROR_SHARING_VIOLATION(32) -> EBUSY(16)
    _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, "win32_err_next4", 32, 16)

    // ERROR_FILE_EXISTS(80) / ERROR_ALREADY_EXISTS(183) -> EEXIST(17)
    _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, "win32_err_next5", 80, 17)
    _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, "win32_err_next6", 183, 17)

    // ERROR_DIR_NOT_EMPTY(145) -> ENOTEMPTY(39)
    _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, "win32_err_next7", 145, 39)

    // ERROR_NOT_SAME_DEVICE(17) -> EXDEV(18)
    _emit_win32_neg_errno_case_x64(ctx, labels, fixups, l_done, "win32_err_next8", 17, 18)

    // Default: -EIO(5)
    _emit_set_rax_neg_errno_x64(ctx, 5)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_win64_zero_ore_stat_v0_x64(ctx, st_reg) {
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8))
    var zoff = 0
    while zoff < nstat.oren_stat_v0_size_bytes() {
        bytes_extend(ctx["code"], core.insn_mov_mr32_r32_disp(st_reg, zoff, 8))
        zoff = zoff + 4
    }
    return nil
}

fn _emit_win64_stat_dir_success_x64(ctx, fixups, tmp_st, l_done) {
    _emit_win64_path_norm_end_x64(ctx, WIN64_PATH_SCRATCH_ONE)

    // Translate into OrenStatV0 at st_ptr (directory).
    _intr_load_x64(ctx, 9, tmp_st)                    // r9 = st_ptr
    _emit_win64_zero_ore_stat_v0_x64(ctx, 9)
    // mode: directory (approx): 0o040755 = 16877
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 16877))
    bytes_extend(ctx["code"], core.insn_mov_mr32_r32_disp(9, nstat.oren_stat_v0_off_mode(), 10))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, l_done)
    return nil
}

fn _emit_win64_stat_open_file_x64(ctx, fixups, l_done, l_handle_ok) {
    // Restore rcx to the normalized path buffer (Win64 ABI treats rcx as volatile; the
    // prior GetFileAttributesA call may have clobbered it).
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(1, 64))

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 2147483648)) // edx = GENERIC_READ
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(8, 7))          // r8d = share
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(9, 0))          // r9d = NULL (sec attrs)

    // arg5 creation disposition = OPEN_EXISTING (3)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 3))
    _emit_mov_mrsp_r64(ctx, 32, 10)
    // arg6 flags/attrs = FILE_ATTRIBUTE_NORMAL (0x80)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 128))
    _emit_mov_mrsp_r64(ctx, 40, 10)
    // arg7 template = NULL
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 0))
    _emit_mov_mrsp_r64(ctx, 48, 10)

    _emit_call_iat_x64(ctx, "IAT_CreateFileA")
    _emit_win64_path_norm_end_x64(ctx, WIN64_PATH_SCRATCH_ONE)

    // if handle == INVALID_HANDLE_VALUE (-1) => fail
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "ne", l_handle_ok)
    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_jmp_to_label(ctx, fixups, l_done)
    return nil
}

fn _emit_win64_stat_file_success_x64(ctx, tmp_st, tmp_handle) {
    // spill handle so capsule post hooks can observe rc consistently (and so we can close it)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_handle, 0)

    // Translate into OrenStatV0 at st_ptr.
    _intr_load_x64(ctx, 9, tmp_st)                 // r9 = st_ptr
    _emit_win64_zero_ore_stat_v0_x64(ctx, 9)
    // mode: regular file (approx): 0o100644 = 33188
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 33188))
    bytes_extend(ctx["code"], core.insn_mov_mr32_r32_disp(9, nstat.oren_stat_v0_off_mode(), 10))

    // LARGE_INTEGER out at [rsp+0x28] (reuse call-area; avoid intrinsic temp pointers)
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(40, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(44, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(48, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(52, 0))

    // Reload handle from the spilled slot: intermediate helpers may clobber rax.
    _intr_load_x64(ctx, 1, tmp_handle)                    // rcx = handle
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(2, 40)) // rdx = &li
    _emit_call_iat_x64(ctx, "IAT_GetFileSizeEx")

    // If GetFileSizeEx fails, keep size=0 (rolling, still treat stat as success).
    // Load size from li.QuadPart (8 bytes at [rsp+0x28]) into r8.
    _intr_load_x64(ctx, 9, tmp_st) // reload st_ptr (volatile regs are clobbered by WinAPI calls)
    bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(8, 40))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(9, 8)) // [st_ptr+0] = size

    // CloseHandle(handle) (best-effort).
    _intr_load_x64(ctx, 1, tmp_handle) // rcx = handle
    _emit_call_iat_x64(ctx, "IAT_CloseHandle")

    // rc = 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    return nil
}

fn _emit_win64_stat_capsule_post_x64(ctx, nm, capsule, tmp_pair) {
    if capsule != true { return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0)) // rdx = rc
    _intr_load_x64(ctx, 1, tmp_pair)                       // rcx = pair
    if nm == "sys_stat" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_stat_post") }
    else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_lstat_post") }
    return nil
}

fn _x64_windows_stat_spill_args(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 4) // path, st_ptr, pair, handle
    if oren_type_tag(base) == 0 { return nil }
    var tmp_path = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_st = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_pair = _intr_tmp_off(ctx, locals, base + 2)
    var tmp_handle = _intr_tmp_off(ctx, locals, base + 3)
    if oren_type_tag(tmp_path) == 0 || oren_type_tag(tmp_st) == 0 || oren_type_tag(tmp_pair) == 0 || oren_type_tag(tmp_handle) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_path)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_st)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "path": tmp_path, "st": tmp_st, "pair": tmp_pair, "handle": tmp_handle}
}

fn _x64_windows_stat_emit_capsule_pre(ctx, nm, state, capsule) {
    var tmp_path = state["path"]
    var tmp_pair = state["pair"]
    if capsule {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path
        if nm == "sys_stat" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_stat_pre") }
        else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_lstat_pre") }
        _emit_mov_mrbp_r64(ctx, 0 - tmp_pair, 0) // spill pair

        // rcx = resolved path pointer from pair[0]
        _intr_load_x64(ctx, 11, tmp_pair)
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(1, 11))
    } else {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path (direct)
    }
    return nil
}

fn _x64_windows_stat_labels(ctx) {
    return {
        "labels": {},
        "fixups": [],
        "done": _new_label(ctx, "sys_stat_win_done"),
        "handle_ok": _new_label(ctx, "sys_stat_win_handle_ok"),
        "attr_ok": _new_label(ctx, "sys_stat_win_attr_ok"),
        "do_file": _new_label(ctx, "sys_stat_win_do_file")
    }
}

fn _x64_windows_stat_emit_attr_probe(ctx, lab) {
    var labels = lab["labels"]
    var fixups = lab["fixups"]
    var l_attr_ok = lab["attr_ok"]
    var l_done = lab["done"]
    // Open the path for read to determine existence and file size.
    //
    // NOTE (rolling):
    // - This treats directories as non-files (CreateFileA without BACKUP_SEMANTICS may fail).
    // - That's sufficient for `oren_read_file` and compiler cache probes.
    // - If/when directory stat is required, extend this with FILE_FLAG_BACKUP_SEMANTICS.
    //
    // CreateFileA(path, GENERIC_READ, share=7, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    // rcx already holds path pointer.
    _emit_win64_path_norm_begin_x64(ctx, WIN64_PATH_SCRATCH_ONE)
    _emit_win64_path_norm_reg_to_buf_x64(ctx, 1, 0) // rcx

    // attrs = GetFileAttributesA(path)
    // This is a cheap directory probe, and avoids relying on CreateFileA to open directories.
    // INVALID_FILE_ATTRIBUTES (0xFFFFFFFF) indicates failure.
    _emit_call_iat_x64(ctx, "IAT_GetFileAttributesA")
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "ne", l_attr_ok)
    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_win64_path_norm_end_x64(ctx, WIN64_PATH_SCRATCH_ONE)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_attr_ok)
    return nil
}

fn _x64_windows_stat_emit_dir_or_file(ctx, lab, tmp_st, tmp_handle) {
    var labels = lab["labels"]
    var fixups = lab["fixups"]
    var l_done = lab["done"]
    var l_handle_ok = lab["handle_ok"]
    var l_do_file = lab["do_file"]
    // If FILE_ATTRIBUTE_DIRECTORY (0x10) is set, emit a directory stat and return rc=0.
    // This is required for mkdir_p on Windows: creating an existing directory returns -EEXIST,
    // and without directory-capable stat, mkdir_p cannot distinguish "dir exists" vs "path is file".
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 0))    // r10 = attrs
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(10, 16)) // r10 &= 0x10
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_do_file)

    _emit_win64_stat_dir_success_x64(ctx, fixups, tmp_st, l_done)

    _emit_label(ctx, labels, l_do_file)
    _emit_win64_stat_open_file_x64(ctx, fixups, l_done, l_handle_ok)
    _emit_label(ctx, labels, l_handle_ok)

    _emit_win64_stat_file_success_x64(ctx, tmp_st, tmp_handle)
    return nil
}

fn _x64_windows_stat_finish(ctx, nm, state, lab, capsule) {
    _emit_label(ctx, lab["labels"], lab["done"])
    _patch_local_fixups(ctx, lab["labels"], lab["fixups"])
    _emit_win64_stat_capsule_post_x64(ctx, nm, capsule, state["pair"])
    _intr_tmp_pop(ctx, state["base"])
    return nil
}

fn _emit_intrinsic_sys_stat_windows_x64(ctx, nm, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0 (windows): " + nm + " expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): " + nm + " does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)
    var state = _x64_windows_stat_spill_args(ctx, locals, args)
    if state == nil { return nil }

    _x64_windows_stat_emit_capsule_pre(ctx, nm, state, capsule)
    var lab = _x64_windows_stat_labels(ctx)
    _x64_windows_stat_emit_attr_probe(ctx, lab)
    _x64_windows_stat_emit_dir_or_file(ctx, lab, state["st"], state["handle"])
    _x64_windows_stat_finish(ctx, nm, state, lab, capsule)
    return nil
}

fn _x64_windows_fstat_spill_args(ctx, locals, args, capsule) {
    var base = _intr_tmp_push(ctx, 4) // fd, st_ptr, li(2q)
    if oren_type_tag(base) == 0 { return nil }
    var tmp_fd = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_st = _intr_tmp_off(ctx, locals, base + 1)
    if oren_type_tag(tmp_fd) == 0 || oren_type_tag(tmp_st) == 0 { _intr_tmp_pop(ctx, base); return nil }

    // fd (with capsule gating)
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = fd
    if capsule { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_fstat_pre") }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_fd, 0)

    // Evaluate st_ptr for side effects/compatibility (ignored for now).
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_st)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "tmp_fd": tmp_fd, "tmp_st": tmp_st}
}

fn _x64_windows_fstat_emit_handle_resolution(ctx, labels, fixups, tmp_fd, l_have_handle, l_ok, l_fail) {
    // Determine handle:
    // - fd==0/1/2 => GetStdHandle(STD_*_HANDLE)
    // - else      => fd itself is a Win32 HANDLE
    _intr_load_x64(ctx, 0, tmp_fd)
    // if fd == 0
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_chk1 = _new_label(ctx, "sys_fstat_chk1")
    _emit_jcc_to_label(ctx, fixups, "ne", l_chk1)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 4294967286)) // ecx=-10 STD_INPUT_HANDLE
    _emit_call_iat_x64(ctx, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 0))
    _emit_jmp_to_label(ctx, fixups, l_have_handle)
    _emit_label(ctx, labels, l_chk1)

    // if fd == 1
    _intr_load_x64(ctx, 0, tmp_fd)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 1))
    var l_chk2 = _new_label(ctx, "sys_fstat_chk2")
    _emit_jcc_to_label(ctx, fixups, "ne", l_chk2)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 4294967285)) // ecx=-11 STD_OUTPUT_HANDLE
    _emit_call_iat_x64(ctx, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 0))
    _emit_jmp_to_label(ctx, fixups, l_have_handle)
    _emit_label(ctx, labels, l_chk2)

    // if fd == 2
    _intr_load_x64(ctx, 0, tmp_fd)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 2))
    var l_else = _new_label(ctx, "sys_fstat_else")
    _emit_jcc_to_label(ctx, fixups, "ne", l_else)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 4294967284)) // ecx=-12 STD_ERROR_HANDLE
    _emit_call_iat_x64(ctx, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 0))
    _emit_jmp_to_label(ctx, fixups, l_have_handle)
    _emit_label(ctx, labels, l_else)

    // else: handle = fd
    _intr_load_x64(ctx, 11, tmp_fd)

    _emit_label(ctx, labels, l_have_handle)

    // Validate handle != 0 and != INVALID_HANDLE_VALUE (-1)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_fail)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "e", l_fail)
    _emit_jmp_to_label(ctx, fixups, l_ok)
    return nil
}

fn _x64_windows_fstat_emit_success(ctx, labels, fixups, locals, base, tmp_st, l_ok, l_fail, l_done) {
    _emit_label(ctx, labels, l_fail)
    _emit_set_rax_neg_errno_x64(ctx, 9) // EBADF
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    // Best-effort: populate OrenStatV0 at st_ptr.
    //
    // For non-file handles (console/pipes), GetFileSizeEx may fail; we still treat
    // sys_fstat as success and report size=0 (POSIX-like "fstat exists" semantics).
    var l_size_ok = _new_label(ctx, "sys_fstat_size_ok")
    var l_size_done = _new_label(ctx, "sys_fstat_size_done")

    // LARGE_INTEGER tmp (16B, aligned) in intrinsic temp slots (avoid mutating RSP).
    var off_li0 = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(off_li0) == 0 { _intr_tmp_pop(ctx, base); return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 11)) // rcx = handle
    _emit_addr_rbp_minus_off_x64(ctx, 2, off_li0)         // rdx = &li
    _emit_call_iat_x64(ctx, "IAT_GetFileSizeEx")
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_size_ok)
    // size = 0
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(10, 10))
    _emit_jmp_to_label(ctx, fixups, l_size_done)
    _emit_label(ctx, labels, l_size_ok)
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_li0) // r10 = li.QuadPart
    _emit_label(ctx, labels, l_size_done)

    // st_ptr
    _intr_load_x64(ctx, 8, tmp_st) // r8 = st_ptr
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(9, 9)) // r9 = 0
    var zoff2 = 0
    while zoff2 < nstat.oren_stat_v0_size_bytes() {
        bytes_extend(ctx["code"], core.insn_mov_mr32_r32_disp(8, zoff2, 9))
        zoff2 = zoff2 + 4
    }
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(8, 10)) // size

    // rc = 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    return true
}

fn _x64_windows_fstat_capsule_post(ctx, capsule) {
    if capsule {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = rc
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_fstat_post")
    }
    return nil
}

fn _emit_intrinsic_sys_fstat_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0 (windows): sys_fstat expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): sys_fstat does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)
    var state = _x64_windows_fstat_spill_args(ctx, locals, args, capsule)
    if state == nil { return nil }
    var base = state["base"]
    var tmp_fd = state["tmp_fd"]
    var tmp_st = state["tmp_st"]

    var labels = {}
    var fixups = []
    var l_have_handle = _new_label(ctx, "sys_fstat_have_handle")
    var l_ok = _new_label(ctx, "sys_fstat_ok")
    var l_fail = _new_label(ctx, "sys_fstat_fail")
    var l_done = _new_label(ctx, "sys_fstat_done")

    _x64_windows_fstat_emit_handle_resolution(ctx, labels, fixups, tmp_fd, l_have_handle, l_ok, l_fail)
    if _x64_windows_fstat_emit_success(ctx, labels, fixups, locals, base, tmp_st, l_ok, l_fail, l_done) != true {
        _intr_tmp_pop(ctx, base)
        return nil
    }

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)

    // post: native_capsule_sys_fstat_post(rc) -> rc
    _x64_windows_fstat_capsule_post(ctx, capsule)

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_unlink_or_rmdir_windows_x64(ctx, nm, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0 (windows): " + nm + " expects 1 arg"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): " + nm + " does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)

    var base = _intr_tmp_push(ctx, 2) // path, pair
    if oren_type_tag(base) == 0 { return nil }
    var tmp_path = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_pair = _intr_tmp_off(ctx, locals, base + 1)
    if oren_type_tag(tmp_path) == 0 || oren_type_tag(tmp_pair) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_path)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    // pre: unlink_pre(path) / rmdir_pre(path) -> pair
    if capsule {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path
        if nm == "sys_unlink" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_unlink_pre") }
        else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_rmdir_pre") }
        _emit_mov_mrbp_r64(ctx, 0 - tmp_pair, 0) // spill pair

        // rcx = resolved path pointer from pair[0]
        _intr_load_x64(ctx, 11, tmp_pair)
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(1, 11))
    } else {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path (direct)
    }

    // DeleteFileA / RemoveDirectoryA -> BOOL
    _emit_win64_path_norm_begin_x64(ctx, WIN64_PATH_SCRATCH_ONE)
    _emit_win64_path_norm_reg_to_buf_x64(ctx, 1, 0) // rcx
    if nm == "sys_unlink" { _emit_call_iat_x64(ctx, "IAT_DeleteFileA") }
    else { _emit_call_iat_x64(ctx, "IAT_RemoveDirectoryA") }
    _emit_win64_path_norm_end_x64(ctx, WIN64_PATH_SCRATCH_ONE)

    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "sys_unlink_win_ok")
    var l_done = _new_label(ctx, "sys_unlink_win_done")

    // if eax != 0 => ok
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)

    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)

    // post: unlink_post(pair, rc) / rmdir_post(pair, rc) -> rc
    if capsule {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0)) // rdx = rc
        _intr_load_x64(ctx, 1, tmp_pair)                  // rcx = pair
        if nm == "sys_unlink" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_unlink_post") }
        else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_rmdir_post") }
    }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_rename_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0 (windows): sys_rename expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): sys_rename does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)

    var base = _intr_tmp_push(ctx, 3) // from, to, bundle
    if oren_type_tag(base) == 0 { return nil }
    var tmp_from = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_to = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_bundle = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(tmp_from) == 0 || oren_type_tag(tmp_to) == 0 || oren_type_tag(tmp_bundle) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_from)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_to)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    // pre: native_capsule_sys_rename_pre(from, to) -> bundle
    if capsule {
        _intr_load_x64(ctx, 1, tmp_from) // rcx = from
        _intr_load_x64(ctx, 2, tmp_to)   // rdx = to
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_rename_pre")
        _emit_mov_mrbp_r64(ctx, 0 - tmp_bundle, 0)

        // existing = *(u64*)bundle (rcx), new = *(u64*)(bundle+16) (rdx)
        _intr_load_x64(ctx, 11, tmp_bundle)
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(1, 11)) // rcx = from_ptr
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(2, 10)) // rdx = to_ptr
    } else {
        _intr_load_x64(ctx, 1, tmp_from) // rcx = from
        _intr_load_x64(ctx, 2, tmp_to)   // rdx = to
    }

    // MoveFileExA(existing, new, flags) -> BOOL
    _emit_win64_path_norm_begin_x64(ctx, WIN64_PATH_SCRATCH_TWO)
    _emit_win64_path_norm_reg_to_buf_x64(ctx, 1, 0)                    // rcx = from
    _emit_win64_path_norm_reg_to_buf_x64(ctx, 2, WIN64_PATH_BUF_BYTES)  // rdx = to
    // flags = MOVEFILE_REPLACE_EXISTING (1)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(8, 1)) // r8d
    _emit_call_iat_x64(ctx, "IAT_MoveFileExA")
    _emit_win64_path_norm_end_x64(ctx, WIN64_PATH_SCRATCH_TWO)

    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "sys_rename_win_ok")
    var l_done = _new_label(ctx, "sys_rename_win_done")

    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)

    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)

    // post: native_capsule_sys_rename_post(bundle, rc) -> rc
    if capsule {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0)) // rdx = rc
        _intr_load_x64(ctx, 1, tmp_bundle)                // rcx = bundle
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_rename_post")
    }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _x64_mkdir_chmod_windows_state(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 3) // path, mode, pair
    if oren_type_tag(base) == 0 { return nil }
    var state = {}
    state["base"] = base
    state["path"] = _intr_tmp_off(ctx, locals, base + 0)
    state["mode"] = _intr_tmp_off(ctx, locals, base + 1)
    state["pair"] = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(state["path"]) == 0 || oren_type_tag(state["mode"]) == 0 || oren_type_tag(state["pair"]) == 0 {
        _intr_tmp_pop(ctx, base)
        return nil
    }

    _intr_eval_spill_x64(ctx, locals, args[0], state["path"])
    _intr_eval_spill_x64(ctx, locals, args[1], state["mode"])
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
        _intr_tmp_pop(ctx, base)
        return nil
    }
    return state
}

fn _x64_emit_mkdir_chmod_windows_prehook(ctx, nm, state, capsule) {
    if !capsule {
        _intr_load_x64(ctx, 1, state["path"]) // rcx = path (direct)
        return nil
    }
    _intr_load_x64(ctx, 1, state["path"]) // rcx = path
    if nm == "sys_mkdir" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_mkdir_pre") }
    else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_chmod_pre") }
    _emit_mov_mrbp_r64(ctx, 0 - state["pair"], 0)

    _intr_load_x64(ctx, 11, state["pair"])
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(1, 11)) // rcx = resolved path pointer from pair[0]
    return nil
}

fn _x64_emit_mkdir_chmod_windows_operation(ctx, nm) {
    if nm == "sys_mkdir" {
        _emit_win64_path_norm_begin_x64(ctx, WIN64_PATH_SCRATCH_ONE)
        _emit_win64_path_norm_reg_to_buf_x64(ctx, 1, 0) // rcx
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 0)) // rdx = NULL
        _emit_call_iat_x64(ctx, "IAT_CreateDirectoryA")
        _emit_win64_path_norm_end_x64(ctx, WIN64_PATH_SCRATCH_ONE)
        return nil
    }
    // Windows has no POSIX mode bits here; chmod succeeds after capsule gating.
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1)) // BOOL ok sentinel
    return nil
}

fn _x64_emit_mkdir_chmod_windows_result(ctx, labels, fixups) {
    var l_ok = _new_label(ctx, "sys_mkdir_chmod_ok")
    var l_done = _new_label(ctx, "sys_mkdir_chmod_done")

    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)

    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())

    _emit_label(ctx, labels, l_done)
    return nil
}

fn _x64_emit_mkdir_chmod_windows_posthook(ctx, nm, state, capsule) {
    if !capsule { return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0)) // rdx = rc
    _intr_load_x64(ctx, 1, state["pair"])                  // rcx = pair
    if nm == "sys_mkdir" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_mkdir_post") }
    else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_chmod_post") }
    return nil
}

fn _emit_intrinsic_sys_mkdir_or_chmod_windows_x64(ctx, nm, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0 (windows): " + nm + " expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): " + nm + " does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)
    var state = _x64_mkdir_chmod_windows_state(ctx, locals, args)
    if state == nil { return nil }

    var labels = {}
    var fixups = []
    _x64_emit_mkdir_chmod_windows_prehook(ctx, nm, state, capsule)
    _x64_emit_mkdir_chmod_windows_operation(ctx, nm)
    _x64_emit_mkdir_chmod_windows_result(ctx, labels, fixups)
    _patch_local_fixups(ctx, labels, fixups)
    _x64_emit_mkdir_chmod_windows_posthook(ctx, nm, state, capsule)

    _intr_tmp_pop(ctx, state["base"])
    return nil
}
