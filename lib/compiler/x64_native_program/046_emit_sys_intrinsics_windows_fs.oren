// x64-native (Windows): File-system syscall intrinsics.
//
// Goal (Tier‑1 parity work, rolling):
// - Provide Windows implementations for the syscall-first FS surface used by the runtime:
//     sys_stat / sys_lstat / sys_fstat
//     sys_unlink / sys_rmdir / sys_rename / sys_mkdir / sys_chmod
// - Keep semantics capsule-safe by invoking native_capsule_sys_* pre/post hooks.
// - Return convention: success => >=0, failure => negative errno (POSIX-like).
//
// Notes:
// - Oren's low-level `sys_stat` API historically mirrors platform `struct stat` layouts.
//   That is *not* portable. For Windows we currently use it as an existence/permission probe,
//   and do not attempt to populate a POSIX struct layout yet.
// - In the rolling repository, callers should avoid struct layout assumptions and instead
//   use higher-level helpers (e.g. oren_exists) until an Oren-defined cross-platform Stat
//   layout is introduced.

fn _emit_win32_get_last_error_x64(ctx) {
    // eax = GetLastError()
    _emit_call_iat_x64(ctx, "IAT_GetLastError")
    return nil
}

fn _emit_win32_last_error_to_neg_errno_common_x64(ctx) {
    // rax = -errno (POSIX-like) mapped from Win32 GetLastError()
    //
    // Uses: eax
    _emit_win32_get_last_error_x64(ctx)

    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "win32_err_done")

    // ERROR_FILE_NOT_FOUND(2) / ERROR_PATH_NOT_FOUND(3) -> ENOENT(2)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 2))
    var l_next0 = _new_label(ctx, "win32_err_next0")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next0)
    _emit_set_rax_neg_errno_x64(ctx, 2)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next0)

    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 3))
    var l_next1 = _new_label(ctx, "win32_err_next1")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next1)
    _emit_set_rax_neg_errno_x64(ctx, 2)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next1)

    // ERROR_ACCESS_DENIED(5) -> EACCES(13)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 5))
    var l_next2 = _new_label(ctx, "win32_err_next2")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next2)
    _emit_set_rax_neg_errno_x64(ctx, 13)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next2)

    // ERROR_INVALID_HANDLE(6) -> EBADF(9)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 6))
    var l_next3 = _new_label(ctx, "win32_err_next3")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next3)
    _emit_set_rax_neg_errno_x64(ctx, 9)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next3)

    // ERROR_SHARING_VIOLATION(32) -> EBUSY(16)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 32))
    var l_next4 = _new_label(ctx, "win32_err_next4")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next4)
    _emit_set_rax_neg_errno_x64(ctx, 16)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next4)

    // ERROR_FILE_EXISTS(80) / ERROR_ALREADY_EXISTS(183) -> EEXIST(17)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 80))
    var l_next5 = _new_label(ctx, "win32_err_next5")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next5)
    _emit_set_rax_neg_errno_x64(ctx, 17)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next5)

    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 183))
    var l_next6 = _new_label(ctx, "win32_err_next6")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next6)
    _emit_set_rax_neg_errno_x64(ctx, 17)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next6)

    // ERROR_DIR_NOT_EMPTY(145) -> ENOTEMPTY(39)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 145))
    var l_next7 = _new_label(ctx, "win32_err_next7")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next7)
    _emit_set_rax_neg_errno_x64(ctx, 39)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next7)

    // ERROR_NOT_SAME_DEVICE(17) -> EXDEV(18)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 17))
    var l_next8 = _new_label(ctx, "win32_err_next8")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next8)
    _emit_set_rax_neg_errno_x64(ctx, 18)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next8)

    // Default: -EIO(5)
    _emit_set_rax_neg_errno_x64(ctx, 5)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_intrinsic_sys_stat_windows_x64(ctx, nm, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0 (windows): " + nm + " expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): " + nm + " does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)

    var base = _intr_tmp_push(ctx, 9) // path, st_ptr, pair, win32_attr_buf(6q)
    if base == nil { return nil }
    var tmp_path = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_st = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_pair = _intr_tmp_off(ctx, locals, base + 2)
    if tmp_path == nil || tmp_st == nil || tmp_pair == nil { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_path)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_st)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    // pre: native_capsule_sys_stat_pre(path) / lstat_pre(path) -> pair
    if capsule {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path
        if nm == "sys_stat" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_stat_pre") }
        else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_lstat_pre") }
        _emit_mov_mrbp_r64(ctx, 0 - tmp_pair, 0) // spill pair

        // rcx = resolved path pointer from pair[0]
        _intr_load_x64(ctx, 11, tmp_pair)
        bytes_extend(ctx["code"], insn_mov_r64_mr64(1, 11))
    } else {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path (direct)
    }

    // GetFileAttributesExA(path, GetFileExInfoStandard=0, &WIN32_FILE_ATTRIBUTE_DATA) -> BOOL
    //
    // Use an intrinsic-temp buffer (48 bytes, 8B aligned) to avoid mutating RSP and to
    // keep nested call-site ABI alignment deterministic.
    // WIN32_FILE_ATTRIBUTE_DATA layout (documented; 36 bytes) is:
    //   +0  DWORD dwFileAttributes
    //   +4  FILETIME ftCreationTime (8)
    //   +12 FILETIME ftLastAccessTime (8)
    //   +20 FILETIME ftLastWriteTime (8)
    //   +28 DWORD nFileSizeHigh
    //   +32 DWORD nFileSizeLow
    bytes_extend(ctx["code"], insn_xor_r64_r64(0, 0)) // rax = 0
    var bi = 0
    while bi < 6 {
        var offb = _intr_tmp_off(ctx, locals, base + 3 + bi)
        if offb == nil { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - offb, 0)
        bi = bi + 1
    }

    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, 0)) // edx = 0 (GetFileExInfoStandard)
    var off_buf0 = _intr_tmp_off(ctx, locals, base + 3)
    if off_buf0 == nil { _intr_tmp_pop(ctx, base); return nil }
    _emit_addr_rbp_minus_off_x64(ctx, 8, off_buf0) // r8 = &buf
    _emit_call_iat_x64(ctx, "IAT_GetFileAttributesExA")

    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "sys_stat_win_ok")
    var l_done = _new_label(ctx, "sys_stat_win_done")

    // if eax != 0 => ok
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)

    // fail: map GetLastError() -> -errno
    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    // Recompute &WIN32_FILE_ATTRIBUTE_DATA (intrinsic-temp buffer) into r11.
    var off_buf1 = _intr_tmp_off(ctx, locals, base + 3)
    if off_buf1 == nil { _intr_tmp_pop(ctx, base); return nil }
    _emit_addr_rbp_minus_off_x64(ctx, 11, off_buf1)

    // --- Translate into OrenStatV0 at st_ptr ---
    // Load st_ptr into r9 (from intrinsic temp spill).
    _intr_load_x64(ctx, 9, tmp_st)

    // Zero OrenStatV0 (64 bytes) for determinism.
    bytes_extend(ctx["code"], insn_xor_r64_r64(8, 8)) // r8 = 0
    var zoff = 0
    while zoff < nstat.oren_stat_v0_size_bytes() {
        bytes_extend(ctx["code"], insn_mov_mr32_r32_disp(9, zoff, 8))
        zoff = zoff + 4
    }

    // size = (nFileSizeHigh<<32) | nFileSizeLow
    bytes_extend(ctx["code"], insn_mov_r32_mr32_disp(10, 11, 32)) // r10d = low
    bytes_extend(ctx["code"], insn_mov_r32_mr32_disp(8, 11, 28))  // r8d  = high
    bytes_extend(ctx["code"], insn_shl_r64_imm8(8, 32))          // r8  <<= 32
    bytes_extend(ctx["code"], insn_or_r64_r64(8, 10))            // r8   |= low
    bytes_extend(ctx["code"], insn_mov_mr64_r64(9, 8))           // [st_ptr+0] = size

    // mode: at minimum distinguish directory vs file.
    bytes_extend(ctx["code"], insn_mov_r32_mr32_disp(10, 11, 0))  // r10d = attrs
    bytes_extend(ctx["code"], insn_and_r64_imm32(10, 16))        // FILE_ATTRIBUTE_DIRECTORY (0x10)
    var l_is_dir = _new_label(ctx, "sys_stat_win_is_dir")
    var l_mode_done = _new_label(ctx, "sys_stat_win_mode_done")
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_is_dir)
    // regular file (approx): 0o100644 = 33188
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 33188))
    _emit_jmp_to_label(ctx, fixups, l_mode_done)
    _emit_label(ctx, labels, l_is_dir)
    // directory (approx): 0o40755 = 16877
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 16877))
    _emit_label(ctx, labels, l_mode_done)
    bytes_extend(ctx["code"], insn_mov_mr32_r32_disp(9, nstat.oren_stat_v0_off_mode(), 10))

    // rc = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)

    // post: native_capsule_sys_stat_post(pair, rc) / lstat_post(pair, rc) -> rc
    if capsule {
        bytes_extend(ctx["code"], insn_mov_r64_r64(2, 0)) // rdx = rc
        _intr_load_x64(ctx, 1, tmp_pair)                  // rcx = pair
        if nm == "sys_stat" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_stat_post") }
        else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_lstat_post") }
    }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_fstat_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0 (windows): sys_fstat expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): sys_fstat does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)

    var base = _intr_tmp_push(ctx, 4) // fd, st_ptr, li(2q)
    if base == nil { return nil }
    var tmp_fd = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_st = _intr_tmp_off(ctx, locals, base + 1)
    if tmp_fd == nil || tmp_st == nil { _intr_tmp_pop(ctx, base); return nil }

    // fd (with capsule gating)
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0)) // rcx = fd
    if capsule { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_fstat_pre") }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_fd, 0)

    // Evaluate st_ptr for side effects/compatibility (ignored for now).
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_st)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    // Determine handle:
    // - fd==0/1/2 => GetStdHandle(STD_*_HANDLE)
    // - else      => fd itself is a Win32 HANDLE
    var labels = {}
    var fixups = []
    var l_have_handle = _new_label(ctx, "sys_fstat_have_handle")
    var l_ok = _new_label(ctx, "sys_fstat_ok")
    var l_fail = _new_label(ctx, "sys_fstat_fail")
    var l_done = _new_label(ctx, "sys_fstat_done")

    // rax = fd
    _intr_load_x64(ctx, 0, tmp_fd)
    // if fd == 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    var l_chk1 = _new_label(ctx, "sys_fstat_chk1")
    _emit_jcc_to_label(ctx, fixups, "ne", l_chk1)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 4294967286)) // ecx=-10 STD_INPUT_HANDLE
    _emit_call_iat_x64(ctx, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0))
    _emit_jmp_to_label(ctx, fixups, l_have_handle)
    _emit_label(ctx, labels, l_chk1)

    // if fd == 1
    _intr_load_x64(ctx, 0, tmp_fd)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1))
    var l_chk2 = _new_label(ctx, "sys_fstat_chk2")
    _emit_jcc_to_label(ctx, fixups, "ne", l_chk2)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 4294967285)) // ecx=-11 STD_OUTPUT_HANDLE
    _emit_call_iat_x64(ctx, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0))
    _emit_jmp_to_label(ctx, fixups, l_have_handle)
    _emit_label(ctx, labels, l_chk2)

    // if fd == 2
    _intr_load_x64(ctx, 0, tmp_fd)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 2))
    var l_else = _new_label(ctx, "sys_fstat_else")
    _emit_jcc_to_label(ctx, fixups, "ne", l_else)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 4294967284)) // ecx=-12 STD_ERROR_HANDLE
    _emit_call_iat_x64(ctx, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0))
    _emit_jmp_to_label(ctx, fixups, l_have_handle)
    _emit_label(ctx, labels, l_else)

    // else: handle = fd
    _intr_load_x64(ctx, 11, tmp_fd)

    _emit_label(ctx, labels, l_have_handle)

    // Validate handle != 0 and != INVALID_HANDLE_VALUE (-1)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_fail)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "e", l_fail)
    _emit_jmp_to_label(ctx, fixups, l_ok)

    _emit_label(ctx, labels, l_fail)
    _emit_set_rax_neg_errno_x64(ctx, 9) // EBADF
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    // Best-effort: populate OrenStatV0 at st_ptr.
    //
    // For non-file handles (console/pipes), GetFileSizeEx may fail; we still treat
    // sys_fstat as success and report size=0 (POSIX-like "fstat exists" semantics).
    var l_size_ok = _new_label(ctx, "sys_fstat_size_ok")
    var l_size_done = _new_label(ctx, "sys_fstat_size_done")

    // LARGE_INTEGER tmp (16B, aligned) in intrinsic temp slots (avoid mutating RSP).
    var off_li0 = _intr_tmp_off(ctx, locals, base + 2)
    if off_li0 == nil { _intr_tmp_pop(ctx, base); return nil }
    bytes_extend(ctx["code"], insn_mov_r64_r64(1, 11)) // rcx = handle
    _emit_addr_rbp_minus_off_x64(ctx, 2, off_li0)         // rdx = &li
    _emit_call_iat_x64(ctx, "IAT_GetFileSizeEx")
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_size_ok)
    // size = 0
    bytes_extend(ctx["code"], insn_xor_r64_r64(10, 10))
    _emit_jmp_to_label(ctx, fixups, l_size_done)
    _emit_label(ctx, labels, l_size_ok)
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_li0) // r10 = li.QuadPart
    _emit_label(ctx, labels, l_size_done)

    // st_ptr
    _intr_load_x64(ctx, 8, tmp_st) // r8 = st_ptr
    bytes_extend(ctx["code"], insn_xor_r64_r64(9, 9)) // r9 = 0
    var zoff2 = 0
    while zoff2 < nstat.oren_stat_v0_size_bytes() {
        bytes_extend(ctx["code"], insn_mov_mr32_r32_disp(8, zoff2, 9))
        zoff2 = zoff2 + 4
    }
    bytes_extend(ctx["code"], insn_mov_mr64_r64(8, 10)) // size

    // rc = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)

    // post: native_capsule_sys_fstat_post(rc) -> rc
    if capsule {
        bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0)) // rcx = rc
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_fstat_post")
    }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_unlink_or_rmdir_windows_x64(ctx, nm, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0 (windows): " + nm + " expects 1 arg"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): " + nm + " does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)

    var base = _intr_tmp_push(ctx, 2) // path, pair
    if base == nil { return nil }
    var tmp_path = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_pair = _intr_tmp_off(ctx, locals, base + 1)
    if tmp_path == nil || tmp_pair == nil { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_path)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    // pre: unlink_pre(path) / rmdir_pre(path) -> pair
    if capsule {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path
        if nm == "sys_unlink" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_unlink_pre") }
        else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_rmdir_pre") }
        _emit_mov_mrbp_r64(ctx, 0 - tmp_pair, 0) // spill pair

        // rcx = resolved path pointer from pair[0]
        _intr_load_x64(ctx, 11, tmp_pair)
        bytes_extend(ctx["code"], insn_mov_r64_mr64(1, 11))
    } else {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path (direct)
    }

    // DeleteFileA / RemoveDirectoryA -> BOOL
    if nm == "sys_unlink" { _emit_call_iat_x64(ctx, "IAT_DeleteFileA") }
    else { _emit_call_iat_x64(ctx, "IAT_RemoveDirectoryA") }

    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "sys_unlink_win_ok")
    var l_done = _new_label(ctx, "sys_unlink_win_done")

    // if eax != 0 => ok
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)

    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)

    // post: unlink_post(pair, rc) / rmdir_post(pair, rc) -> rc
    if capsule {
        bytes_extend(ctx["code"], insn_mov_r64_r64(2, 0)) // rdx = rc
        _intr_load_x64(ctx, 1, tmp_pair)                  // rcx = pair
        if nm == "sys_unlink" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_unlink_post") }
        else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_rmdir_post") }
    }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_rename_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0 (windows): sys_rename expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): sys_rename does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)

    var base = _intr_tmp_push(ctx, 3) // from, to, bundle
    if base == nil { return nil }
    var tmp_from = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_to = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_bundle = _intr_tmp_off(ctx, locals, base + 2)
    if tmp_from == nil || tmp_to == nil || tmp_bundle == nil { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_from)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_to)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    // pre: native_capsule_sys_rename_pre(from, to) -> bundle
    if capsule {
        _intr_load_x64(ctx, 1, tmp_from) // rcx = from
        _intr_load_x64(ctx, 2, tmp_to)   // rdx = to
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_rename_pre")
        _emit_mov_mrbp_r64(ctx, 0 - tmp_bundle, 0)

        // existing = *(u64*)bundle (rcx), new = *(u64*)(bundle+16) (rdx)
        _intr_load_x64(ctx, 11, tmp_bundle)
        bytes_extend(ctx["code"], insn_mov_r64_mr64(1, 11)) // rcx = from_ptr
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(2, 10)) // rdx = to_ptr
    } else {
        _intr_load_x64(ctx, 1, tmp_from) // rcx = from
        _intr_load_x64(ctx, 2, tmp_to)   // rdx = to
    }

    // flags = MOVEFILE_REPLACE_EXISTING (1)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(8, 1)) // r8d

    // MoveFileExA(existing, new, flags) -> BOOL
    _emit_call_iat_x64(ctx, "IAT_MoveFileExA")

    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "sys_rename_win_ok")
    var l_done = _new_label(ctx, "sys_rename_win_done")

    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)

    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)

    // post: native_capsule_sys_rename_post(bundle, rc) -> rc
    if capsule {
        bytes_extend(ctx["code"], insn_mov_r64_r64(2, 0)) // rdx = rc
        _intr_load_x64(ctx, 1, tmp_bundle)                // rcx = bundle
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_rename_post")
    }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_mkdir_or_chmod_windows_x64(ctx, nm, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0 (windows): " + nm + " expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0 (windows): " + nm + " does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)

    var base = _intr_tmp_push(ctx, 3) // path, mode, pair
    if base == nil { return nil }
    var tmp_path = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_mode = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_pair = _intr_tmp_off(ctx, locals, base + 2)
    if tmp_path == nil || tmp_mode == nil || tmp_pair == nil { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_path)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_mode)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    // pre: mkdir_pre(path) / chmod_pre(path) -> pair
    if capsule {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path
        if nm == "sys_mkdir" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_mkdir_pre") }
        else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_chmod_pre") }
        _emit_mov_mrbp_r64(ctx, 0 - tmp_pair, 0)

        // rcx = resolved path pointer from pair[0]
        _intr_load_x64(ctx, 11, tmp_pair)
        bytes_extend(ctx["code"], insn_mov_r64_mr64(1, 11))
    } else {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path (direct)
    }

    if nm == "sys_mkdir" {
        // CreateDirectoryA(path, NULL) -> BOOL
        bytes_extend(ctx["code"], insn_mov_r32_imm32(2, 0)) // rdx = NULL
        _emit_call_iat_x64(ctx, "IAT_CreateDirectoryA")
    } else {
        // sys_chmod on Windows (rolling):
        //
        // Windows does not have POSIX permission bits. Until we design a real mapping
        // (READONLY attribute, ACL translation, or a VFS-level policy), treat chmod as a
        // no-op that reports success once capsule gating has been enforced by the prehook.
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1)) // BOOL ok sentinel
    }

    // For both mkdir/chmod: BOOL result in eax (nonzero = ok)
    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "sys_mkdir_chmod_ok")
    var l_done = _new_label(ctx, "sys_mkdir_chmod_done")

    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)

    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)

    // post: mkdir_post(pair, rc) / chmod_post(pair, rc) -> rc
    if capsule {
        bytes_extend(ctx["code"], insn_mov_r64_r64(2, 0)) // rdx = rc
        _intr_load_x64(ctx, 1, tmp_pair)                  // rcx = pair
        if nm == "sys_mkdir" { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_mkdir_post") }
        else { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_chmod_post") }
    }

    _intr_tmp_pop(ctx, base)
    return nil
}
