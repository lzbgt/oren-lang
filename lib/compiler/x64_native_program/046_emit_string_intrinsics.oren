// x64 native v0: string intrinsics + minimal "stringiness" analysis.
//
// Motivation:
// - x64 native v0 does not inject `lib/runtime_native.oren` yet.
// - Stdlib and compiler surfaces rely on helpers like:
//     - `oren_string_len`, `oren_string_slice`
//     - `string_concat` (string `+` lowering in native mode)
//     - `oren_string_eq`
//     - `oren_int_from_string`
//
// This file implements a small, deterministic subset as compiler intrinsics so Tier‑1
// x86_64 can run modern stdlib code without depending on host libc.

fn _x64_expr_is_stringy(ctx, expr) {
    // Best-effort, conservative "stringy" evidence used ONLY to decide whether `+`
    // should lower to `string_concat`.
    //
    // IMPORTANT:
    // - x64 native v0 values are untagged u64 carriers; calling string routines on
    //   non-strings can crash.
    // - Keep this heuristic conservative: return true only when we have strong evidence.
    if expr == nil { return false }
    var t = expr["type"]
    if t == "String" { return true }
    if t == "Identifier" {
        var nm = expr["value"]
        if ctx != nil && ctx["locals_stringy"] != nil && ctx["locals_stringy"][nm] == true { return true }
        return false
    }
    if t == "Index" {
        // Narrow allowlist for common string fields in compiler/stdlib map-shaped data.
        var idx = expr["index"]
        if idx != nil && idx["type"] == "String" {
            var k = idx["value"]
            if k == "cmd" || k == "err" || k == "help" { return true }
            if k == "type" || k == "literal" || k == "file" { return true }
            if k == "ch" || k == "input" { return true }
            if k == "value" { return true }
            if k == "name" || k == "path" || k == "prefix" || k == "full" || k == "alias" { return true }
            if k == "msg" || k == "kind" { return true }
            if k == "backend" || k == "target" || k == "arch" || k == "out" || k == "cc" { return true }
        }
        return false
    }
    if t == "Infix" {
        // Only treat `+` as string concat when BOTH operands are stringy.
        if expr["op"] == "+" {
            return _x64_expr_is_stringy(ctx, expr["left"]) && _x64_expr_is_stringy(ctx, expr["right"])
        }
        return false
    }
    if t == "Call" {
        var fnn = expr["fn"]
        if fnn != nil && fnn["type"] == "Identifier" {
            var nm = fnn["value"]
            if nm == "oren_int_to_string" { return true }
            if nm == "oren_char" { return true }
            if nm == "oren_string_char_at" { return true }
            if nm == "oren_string_slice" { return true }
            if nm == "oren_string_from_bytes" { return true }
            if nm == "string_concat" { return true }
            if nm == "oren_env" { return true }
            if nm == "oren_read_file" { return true }
            if nm == "oren_getcwd" { return true }
            if nm == "oren_realpath" { return true }
            if nm == "oren_realpath_checked" { return true }
        }
        return false
    }
    return false
}

fn _emit_string_len_from_ptr_x64(ctx, ptr_reg, dst_reg) {
    // dst_reg = strlen((char*)ptr_reg) (NUL-terminated).
    //
    // Semantics:
    // - if ptr == 0 => 0
    //
    // Clobbers: R10, R11
    if ctx == nil { return nil }
    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "str_len_done")
    var l_loop = _new_label(ctx, "str_len_loop")

    // r11 = ptr
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, ptr_reg))
    // dst = 0  (must happen *after* capturing ptr, because ptr_reg may alias dst_reg)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(dst_reg, 0))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)

    _emit_label(ctx, labels, l_loop)
    // Use EAX/AL as the loaded-byte temp.
    // This keeps the helper from clobbering common argument registers like R8/R9
    // (important for Windows x64 ABI paths).
    //
    // NOTE: callers must not depend on RAX being preserved across this helper.
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 11))
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)
    bytes_extend(ctx["code"], insn_add_r64_imm32(dst_reg, 1))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_loop)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_intrinsic_oren_string_len_x64(ctx, expr, locals) {
    if ctx == nil { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_string_len expects 1 arg"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_string_len does not support spread"); return nil }
    _emit_eval_int_to_rax(ctx, args[0], locals) // s -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    // Compute length into a non-RAX register because `_emit_string_len_from_ptr_x64`
    // uses EAX/AL as a byte temp.
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0)) // r8 = s
    _emit_string_len_from_ptr_x64(ctx, 8, 8)          // r8 = len
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 8)) // rax = len
    return nil
}

fn _emit_string_store_byte_at_ptr_x64(ctx, ptr_reg, byte_reg32) {
    // *(u8*)ptr_reg = (byte_reg32 & 255)
    //
    // Uses AL for store.
    // Clobbers: RAX
    if ctx == nil { return nil }
    bytes_extend(ctx["code"], insn_mov_r32_r32(0, byte_reg32)) // eax = byte
    bytes_extend(ctx["code"], insn_mov_mr8_al(ptr_reg))
    return nil
}

fn _emit_string_concat_from_regs_x64(ctx, locals, a_reg, b_reg, dst_reg) {
    // dst_reg = string_concat(a_reg, b_reg)
    //
    // Semantics match `lib/runtime_native/160_iteration.oren`:
    // - nil is treated as empty string (len=0, copy loop skipped)
    // - result is a freshly allocated NUL-terminated string, tracked as kind=STRING (1)
    //
    // Clobbers: RAX, RCX, RDX, R8, R9, R10, R11, R12, R13
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: string_concat requires locals"); return nil }

    // Preserve inputs across `_emit_malloc_size_in_rax`:
    // - malloc slow paths clobber several volatile registers (including rsi/rdi on some paths),
    //   so always spill args to stack slots before calling it.
    var spill_a = locals["$tmp5"]
    var spill_b = locals["$tmp6"]
    var spill_size = locals["$tmp7"]
    if spill_a == nil || spill_b == nil || spill_size == nil {
        err(ctx, "x64 native v0: missing $tmp5/$tmp6/$tmp7 spill slots for string_concat")
        return nil
    }
    _emit_mov_mrbp_r64(ctx, 0 - spill_a, a_reg)
    _emit_mov_mrbp_r64(ctx, 0 - spill_b, b_reg)

    // r8 = la ; r9 = lb
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, a_reg))
    _emit_string_len_from_ptr_x64(ctx, 8, 8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, b_reg))
    _emit_string_len_from_ptr_x64(ctx, 9, 9)

    // size = la + lb + 1 => rax
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 8))
    bytes_extend(ctx["code"], insn_add_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 1))
    // r13 = size (for tracking later; preserve across loops)
    bytes_extend(ctx["code"], insn_mov_r64_r64(13, 0))
    _emit_mov_mrbp_r64(ctx, 0 - spill_size, 13)

    _emit_malloc_size_in_rax(ctx, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    // If malloc returned 0, abort with deterministic panic (Tier‑1 contract).
    var labels = {}
    var local_fixups = []
    var l_ok = _new_label(ctx, "strcat_ok")
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_ok)
    _emit_abort_panic_str(ctx, "string_concat: malloc failed")
    _emit_label(ctx, labels, l_ok)
    _patch_local_fixups(ctx, labels, local_fixups)

    // r12 = out (return)
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 0))
    // Restore size for tracking (malloc slow paths clobber volatile regs).
    _emit_mov_r64_mrbp(ctx, 13, 0 - spill_size)

    // Copy a: r10=src, r11=dst, rdx=remaining
    _emit_mov_r64_mrbp(ctx, 10, 0 - spill_a) // src = a
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 12))
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, 8)) // rdx = la

    labels = {}
    local_fixups = []
    var l_a_done = _new_label(ctx, "strcat_a_done")
    var l_a_loop = _new_label(ctx, "strcat_a_loop")
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_a_done)
    _emit_label(ctx, labels, l_a_loop)
    // eax = *(u8*)src ; *(u8*)dst = al
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 10))
    bytes_extend(ctx["code"], insn_mov_mr8_al(11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 1))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 1))
    bytes_extend(ctx["code"], insn_sub_r64_imm32(2, 1))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_a_loop)
    _emit_label(ctx, labels, l_a_done)
    _patch_local_fixups(ctx, labels, local_fixups)

    // Copy b: r10=src, rdx=lb, dst continues at r11
    _emit_mov_r64_mrbp(ctx, 10, 0 - spill_b) // src = b
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, 9)) // rdx = lb

    labels = {}
    local_fixups = []
    var l_b_done = _new_label(ctx, "strcat_b_done")
    var l_b_loop = _new_label(ctx, "strcat_b_loop")
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_b_done)
    _emit_label(ctx, labels, l_b_loop)
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 10))
    bytes_extend(ctx["code"], insn_mov_mr8_al(11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 1))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 1))
    bytes_extend(ctx["code"], insn_sub_r64_imm32(2, 1))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_b_loop)
    _emit_label(ctx, labels, l_b_done)
    _patch_local_fixups(ctx, labels, local_fixups)

    // NUL terminate at current dst (r11)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_mov_mr8_al(11))

    // Track out as STRING (kind=1) with size.
    // ptr in r12, size in r13
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 1)) // kind=1
    _emit_track_alloc_x64(ctx, locals, 12, 13, 10)
    // Return in dst_reg
    bytes_extend(ctx["code"], insn_mov_r64_r64(dst_reg, 12))
    return nil
}

fn _emit_intrinsic_string_concat_x64(ctx, expr, locals) {
    if ctx == nil { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: string_concat expects 2 args"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: string_concat does not support spread"); return nil }

    // Spill args to preserve LTR evaluation semantics.
    var base = _intr_tmp_push(ctx, 2)
    if base == nil { return nil }
    var tmp_a = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_b = _intr_tmp_off(ctx, locals, base + 1)
    if tmp_a == nil || tmp_b == nil { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_a, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_b, 0)

    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_a)
    _emit_mov_r64_mrbp(ctx, 13, 0 - tmp_b)
    _emit_string_concat_from_regs_x64(ctx, locals, 12, 13, 0)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_oren_string_slice_x64(ctx, expr, locals) {
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: oren_string_slice requires locals"); return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: oren_string_slice expects 3 args"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_string_slice does not support spread"); return nil }

    // Spill args (LTR evaluation) so register-heavy implementation is safe.
    var base = _intr_tmp_push(ctx, 3)
    if base == nil { return nil }
    var tmp_s = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_i = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_j = _intr_tmp_off(ctx, locals, base + 2)
    if tmp_s == nil || tmp_i == nil || tmp_j == nil { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_s, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_i, 0)

    _emit_eval_int_to_rax(ctx, args[2], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_j, 0)

    // r12 = s ; r8 = i ; r9 = j
    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_s)
    _emit_mov_r64_mrbp(ctx, 8, 0 - tmp_i)
    _emit_mov_r64_mrbp(ctx, 9, 0 - tmp_j)

    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "strslice_done")
    var l_empty = _new_label(ctx, "strslice_empty")
    var l_nonempty = _new_label(ctx, "strslice_nonempty")
    var l_copy = _new_label(ctx, "strslice_copy")
    var l_copy_done = _new_label(ctx, "strslice_copy_done")

    // Default return = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())

    // if s == 0 => return 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_done)

    // r10 = len(s)
    _emit_string_len_from_ptr_x64(ctx, 12, 10)

    // clamp i,j to [0,len]
    // if i < 0 => i=0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 0))
    var l_i_ok = _new_label(ctx, "strslice_i_ok")
    _emit_jcc_to_label(ctx, fixups, "ge", l_i_ok)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(8, 0))
    _emit_label(ctx, labels, l_i_ok)

    // if j < 0 => j=0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    var l_j_ok = _new_label(ctx, "strslice_j_ok")
    _emit_jcc_to_label(ctx, fixups, "ge", l_j_ok)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 0))
    _emit_label(ctx, labels, l_j_ok)

    // if i > len => i=len
    bytes_extend(ctx["code"], insn_cmp_r64_r64(8, 10))
    var l_i_le = _new_label(ctx, "strslice_i_le")
    _emit_jcc_to_label(ctx, fixups, "le", l_i_le)
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 10))
    _emit_label(ctx, labels, l_i_le)

    // if j > len => j=len
    bytes_extend(ctx["code"], insn_cmp_r64_r64(9, 10))
    var l_j_le = _new_label(ctx, "strslice_j_le")
    _emit_jcc_to_label(ctx, fixups, "le", l_j_le)
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 10))
    _emit_label(ctx, labels, l_j_le)

    // if i >= j => empty
    bytes_extend(ctx["code"], insn_cmp_r64_r64(8, 9))
    _emit_jcc_to_label(ctx, fixups, "ge", l_empty)

    _emit_jmp_to_label(ctx, fixups, l_nonempty)

    _emit_label(ctx, labels, l_empty)
    // out0 = malloc(1)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_malloc_size_in_rax(ctx, locals)
    // store 0 byte
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_mov_mr8_al(11))
    // track as STRING (size=1, kind=1)
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 11))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(13, 1))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 1))
    _emit_track_alloc_x64(ctx, locals, 12, 13, 10)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 12))
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_nonempty)
    // n = j - i => r13
    bytes_extend(ctx["code"], insn_mov_r64_r64(13, 9))
    bytes_extend(ctx["code"], insn_sub_r64_r64(13, 8))

    // Preserve clamped i/n and size across malloc (slow paths clobber volatile regs).
    var spill_i = locals["$tmp2"]
    var spill_n = locals["$tmp3"]
    var spill_sz = locals["$tmp4"]
    if spill_i == nil || spill_n == nil || spill_sz == nil {
        err(ctx, "x64 native v0: oren_string_slice missing $tmp2/$tmp3/$tmp4 spill slots")
        return nil
    }
    _emit_mov_mrbp_r64(ctx, 0 - spill_i, 8)  // i
    _emit_mov_mrbp_r64(ctx, 0 - spill_n, 13) // n

    // out = malloc(n+1); keep size in spill for tracking
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 13))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 1))
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0)) // size = n+1 (temporary)
    _emit_mov_mrbp_r64(ctx, 0 - spill_sz, 11)
    _emit_malloc_size_in_rax(ctx, locals)
    // r12 = out
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 0))

    // Restore i/n/size after malloc.
    _emit_mov_r64_mrbp(ctx, 8, 0 - spill_i)
    _emit_mov_r64_mrbp(ctx, 13, 0 - spill_n)
    _emit_mov_r64_mrbp(ctx, 11, 0 - spill_sz)

    // src = s + i => r10 ; dst = out => r9 ; remaining = n => r8
    _emit_mov_r64_mrbp(ctx, 10, 0 - tmp_s) // r10 = s
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 8)) // r10 = s + i
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 12)) // r9 = dst
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 13)) // r8 = remaining

    _emit_label(ctx, labels, l_copy)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_copy_done)
    // eax = *(u8*)src ; *(u8*)dst = al
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 10))
    bytes_extend(ctx["code"], insn_mov_mr8_al(9))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 1))
    bytes_extend(ctx["code"], insn_add_r64_imm32(9, 1))
    bytes_extend(ctx["code"], insn_sub_r64_imm32(8, 1))
    _emit_jmp_to_label(ctx, fixups, l_copy)

    _emit_label(ctx, labels, l_copy_done)
    // NUL terminate at dst cursor (r9)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_mov_mr8_al(9))

    // Track out as STRING (kind=1) with size (r11).
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 12))
    bytes_extend(ctx["code"], insn_mov_r64_r64(13, 11))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 1))
    _emit_track_alloc_x64(ctx, locals, 12, 13, 10)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 12))

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_oren_string_eq_x64(ctx, expr, locals) {
    if ctx == nil { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: oren_string_eq expects 2 args"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_string_eq does not support spread"); return nil }

    var base = _intr_tmp_push(ctx, 2)
    if base == nil { return nil }
    var tmp_a = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_b = _intr_tmp_off(ctx, locals, base + 1)
    if tmp_a == nil || tmp_b == nil { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_a, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_b, 0)

    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_a)
    _emit_mov_r64_mrbp(ctx, 13, 0 - tmp_b)

    var labels = {}
    var local_fixups = []
    var l_false = _new_label(ctx, "streq_false")
    var l_true = _new_label(ctx, "streq_true")
    var l_done = _new_label(ctx, "streq_done")

    // if a==0 or b==0 => false
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_false)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(13, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_false)

    // r8 = la ; r9 = lb
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 12))
    _emit_string_len_from_ptr_x64(ctx, 8, 8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 13))
    _emit_string_len_from_ptr_x64(ctx, 9, 9)
    bytes_extend(ctx["code"], insn_cmp_r64_r64(8, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_false)

    // r10 = a cursor ; r11 = b cursor ; rdx = remaining
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 12))
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 13))
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, 8))

    var l_loop = _new_label(ctx, "streq_loop")
    var l_loop_done = _new_label(ctx, "streq_loop_done")
    _emit_label(ctx, labels, l_loop)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_loop_done)

    bytes_extend(ctx["code"], insn_movzx_r32_mr8(8, 10))
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(9, 11))
    bytes_extend(ctx["code"], insn_cmp_r32_r32(8, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_false)
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 1))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 1))
    bytes_extend(ctx["code"], insn_sub_r64_imm32(2, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_loop)

    _emit_label(ctx, labels, l_loop_done)
    _emit_jmp_to_label(ctx, local_fixups, l_true)

    _emit_label(ctx, labels, l_false)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_true)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_oren_int_from_string_x64(ctx, expr, locals) {
    // Parse a non-negative decimal integer from a C-string.
    // Returns -1 on invalid input (matches `lib/runtime_native/150_strings.oren`).
    if ctx == nil { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_int_from_string expects 1 arg"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_int_from_string does not support spread"); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals) // s -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    var labels = {}
    var fixups = []
    var l_invalid = _new_label(ctx, "int_from_str_invalid")
    var l_loop = _new_label(ctx, "int_from_str_loop")
    var l_done = _new_label(ctx, "int_from_str_done")
    var l_ok = _new_label(ctx, "int_from_str_ok")

    // Default return = -1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 4294967295))
    bytes_extend(ctx["code"], insn_cdqe())

    // if s == 0 => keep -1
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_done)

    // r11 = cursor
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0))
    // rax = v
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    // r10 = any
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 0))
    // r8 = i
    bytes_extend(ctx["code"], insn_mov_r32_imm32(8, 0))

    _emit_label(ctx, labels, l_loop)
    // r9d = *(u8*)cursor
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(9, 11))
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(9, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_ok)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(9, 48))
    _emit_jcc_to_label(ctx, fixups, "l", l_invalid)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(9, 57))
    _emit_jcc_to_label(ctx, fixups, "g", l_invalid)

    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 1)) // any=1
    bytes_extend(ctx["code"], insn_imul_r64_imm32(0, 10)) // v *= 10
    bytes_extend(ctx["code"], insn_sub_r32_imm32(9, 48)) // digit
    bytes_extend(ctx["code"], insn_movsxd_r64_r32(2, 9)) // rdx = digit
    bytes_extend(ctx["code"], insn_add_r64_r64(0, 2)) // v += digit

    // cursor++, i++
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 1))
    bytes_extend(ctx["code"], insn_add_r64_imm32(8, 1))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 32))
    _emit_jcc_to_label(ctx, fixups, "g", l_invalid)
    _emit_jmp_to_label(ctx, fixups, l_loop)

    _emit_label(ctx, labels, l_invalid)
    // return -1 (already in rax)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 4294967295))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    // if any==0 => invalid
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_invalid)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_infix_add_or_string_concat_x64(ctx, expr, locals) {
    // Infix '+' lowering (x64 native bring-up).
    //
    // Tier‑1 semantic goal: match the rolling native runtime helper `oren_add`:
    // - if both operands are tracked heap strings (kind=1), perform string concatenation
    // - otherwise, perform integer addition
    //
    // Rationale:
    // - arm64 native lowers `+` via `oren_add`, which performs runtime detection based on
    //   tracked-allocation metadata (`oren_find_node` + node.kind).
    // - x64 native values are still untagged u64 carriers, so compile-time-only heuristics
    //   for string `+` are not sufficient (e.g. strings returned from helper functions).
    //
    // This remains a stopgap until the native tagged-value model lands.
    if expr == nil { return nil }
    if expr["op"] != "+" { return nil }

    // Evaluate LTR, then decide at runtime whether to concat or add.
    var base = _intr_tmp_push(ctx, 2)
    if base == nil { return nil }
    var tmp_a = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_b = _intr_tmp_off(ctx, locals, base + 1)
    if tmp_a == nil || tmp_b == nil { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, expr["left"], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_a, 0)

    _emit_eval_int_to_rax(ctx, expr["right"], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_b, 0)

    var labels = {}
    var fixups = []
    var l_do_add = _new_label(ctx, "add_do_add")
    var l_do_concat = _new_label(ctx, "add_do_concat")
    var l_done = _new_label(ctx, "add_done")

    // is_string(a) ?
    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_a) // r12 = a
    _emit_find_tracked_node_x64(ctx, 12, 10) // r10 = node(a) or 0
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    // find_node clobbers r12: reload a from spill for later paths.
    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_a)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_do_add)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 16))
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 11)) // r11 = kind
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 1))
    _emit_jcc_to_label(ctx, fixups, "ne", l_do_add)

    // is_string(b) ?
    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_b) // r12 = b
    _emit_find_tracked_node_x64(ctx, 12, 10) // r10 = node(b) or 0
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_b)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_do_add)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 16))
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 11)) // r11 = kind
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 1))
    _emit_jcc_to_label(ctx, fixups, "ne", l_do_add)

    _emit_jmp_to_label(ctx, fixups, l_do_concat)

    _emit_label(ctx, labels, l_do_concat)
    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_a)
    _emit_mov_r64_mrbp(ctx, 13, 0 - tmp_b)
    _emit_string_concat_from_regs_x64(ctx, locals, 12, 13, 0)
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_do_add)
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_a) // rax = a
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_b) // rdx = b
    bytes_extend(ctx["code"], insn_add_r64_r64(0, 2))

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, base)
    return 1
}
