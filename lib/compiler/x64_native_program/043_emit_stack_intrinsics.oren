// Stack/diagnostic intrinsics for x64 native.
//
// Kept in a dedicated include file to keep `040_emit_expr.oren` under the repo
// style limit (<= 2000 lines) while x64 Tier-1 semantics converge with arm64.

fn _x64_emit_code_addr_intrinsic(ctx, args) {
    if args == nil || oren_list_len(args) != 1 {
        err(ctx, "x64 native v0: oren_code_addr expects 1 arg")
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
        return 1
    }
    var a0 = args[0]
    if a0 == nil || a0["type"] != "Identifier" {
        err(ctx, "x64 native v0: oren_code_addr expects an Identifier arg")
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
        return 1
    }
    var name = a0["value"]
    if name == nil || name == "" {
        err(ctx, "x64 native v0: oren_code_addr missing function name")
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
        return 1
    }
    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(0, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_code_lea", "pos": lea_pos + 3, "name": name})
    return 1
}

fn _x64_emit_ctx_init_intrinsic(ctx, locals, args) {
    if args == nil || oren_list_len(args) != 3 {
        err(ctx, "x64 native v0: oren_ctx_init expects 3 args")
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
        return 1
    }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 0))

    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 0))

    _emit_eval_int_to_rax(ctx, args[2], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(8, 0))

    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(10, 104, 11))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(10, 112, 8))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    return 1
}

fn _x64_emit_ctx_switch_save_gprs(ctx) {
    _x64_emit_ctx_switch_save_low_gprs(ctx)
    _x64_emit_ctx_switch_save_high_gprs(ctx)
    return nil
}

fn _x64_emit_ctx_switch_save_low_gprs(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 8, 1))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 16, 2))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 24, 3))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 32, 5))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 40, 7))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 48, 6))
    return nil
}

fn _x64_emit_ctx_switch_save_high_gprs(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 56, 8))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 64, 9))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 72, 10))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 80, 11))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 88, 12))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 96, 13))
    return nil
}

fn _x64_emit_ctx_switch_save_resume(ctx) {
    bytes_extend(ctx["code"], core.insn_pop_r64(8))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 0, 8))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 104, 4))

    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(8, 0))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(0, 112, 8))
    return lea_pos
}

fn _x64_emit_ctx_switch_save_xmms(ctx) {
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 128, 0))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 144, 1))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 160, 2))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 176, 3))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 192, 4))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 208, 5))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 224, 6))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 240, 7))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 256, 8))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 272, 9))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 288, 10))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 304, 11))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 320, 12))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 336, 13))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 352, 14))
    bytes_extend(ctx["code"], core.insn_movdqu_m128_xmm_disp(0, 368, 15))
    return nil
}

fn _x64_emit_ctx_switch_restore_xmms(ctx) {
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(0, 9, 128))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(1, 9, 144))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(2, 9, 160))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(3, 9, 176))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(4, 9, 192))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(5, 9, 208))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(6, 9, 224))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(7, 9, 240))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(8, 9, 256))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(9, 9, 272))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(10, 9, 288))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(11, 9, 304))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(12, 9, 320))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(13, 9, 336))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(14, 9, 352))
    bytes_extend(ctx["code"], core.insn_movdqu_xmm_m128_disp(15, 9, 368))
    return nil
}

fn _x64_emit_ctx_switch_restore_gprs(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(1, 9, 8))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(2, 9, 16))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(3, 9, 24))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(5, 9, 32))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(7, 9, 40))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(6, 9, 48))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(10, 9, 72))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(11, 9, 80))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(12, 9, 88))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(13, 9, 96))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(8, 9, 104))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(4, 8))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(8, 9, 112))
    return nil
}

fn _x64_emit_ctx_switch_return_to_next(ctx) {
    bytes_extend(ctx["code"], core.insn_push_r64(8))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(8, 9, 56))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(0, 9, 0))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(9, 9, 64))
    bytes_extend(ctx["code"], core.insn_ret())
    return nil
}

fn _x64_emit_ctx_switch_intrinsic(ctx, locals, args) {
    if args == nil || oren_list_len(args) != 2 {
        err(ctx, "x64 native v0: oren_ctx_switch expects 2 args")
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
        return 1
    }

    bytes_extend(ctx["code"], core.insn_push_r64(0))
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }

    _x64_emit_ctx_switch_save_gprs(ctx)
    var lea_pos = _x64_emit_ctx_switch_save_resume(ctx)
    _x64_emit_ctx_switch_save_xmms(ctx)

    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 0))

    _x64_emit_ctx_switch_restore_xmms(ctx)
    _x64_emit_ctx_switch_restore_gprs(ctx)
    _x64_emit_ctx_switch_return_to_next(ctx)

    var resume_pos = bytes_len(ctx["code"])
    set_u32_le(ctx["code"], lea_pos + 3, resume_pos - (lea_pos + 7))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    return 1
}

fn _x64_resolve_symbol_emit_unknown_default(ctx) {
    var unk_off = _data_add_cstr0(ctx, "???")
    var lea_unk = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(0, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_unk + 3, "data_off": unk_off})
    return nil
}

fn _x64_resolve_symbol_symtab_off(ctx) {
    var symtab_off_enc = ctx["symtab_off"]
    if oren_type_tag(symtab_off_enc) == 0 { return nil }
    return symtab_off_enc - 1
}

fn _x64_resolve_symbol_range_labels(ctx) {
    return [{}, [], _new_label(ctx, "resolve_sym_done"),
        _new_label(ctx, "resolve_sym_loop"), _new_label(ctx, "resolve_sym_match")]
}

fn _x64_resolve_symbol_emit_text_range_guard(ctx, st) {
    var platform = ctx["platform"]
    var text_base = abi.x64_v0_text_base_addr(platform)
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(11, text_base))
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(10, 11))
    _emit_jcc_to_label(ctx, st[1], "b", st[2])
    return nil
}

fn _x64_resolve_symbol_emit_target_offset(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 10))
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(9, 11))
    return nil
}

fn _x64_resolve_symbol_emit_symtab_pointer(ctx, st, symtab_off) {
    var lea_sym = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(11, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_sym + 3, "data_off": symtab_off})
    return nil
}

fn _x64_resolve_symbol_emit_data_base(ctx, symtab_off) {
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(8, 11))
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(8, core.int_mod(symtab_off, 4294967296)))
    return nil
}

fn _x64_resolve_symbol_emit_scan_cursor(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(10, 11))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 8))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 0))
    return nil
}

fn _x64_resolve_symbol_emit_range_setup(ctx, symtab_off) {
    var st = _x64_resolve_symbol_range_labels(ctx)
    _x64_resolve_symbol_emit_text_range_guard(ctx, st)
    _x64_resolve_symbol_emit_target_offset(ctx)
    _x64_resolve_symbol_emit_symtab_pointer(ctx, st, symtab_off)
    _x64_resolve_symbol_emit_data_base(ctx, symtab_off)
    _x64_resolve_symbol_emit_scan_cursor(ctx)
    return st
}

fn _x64_resolve_symbol_emit_loop(ctx, st) {
    var labels = st[0]
    var fixups = st[1]
    var l_done = st[2]
    var l_loop = st[3]
    var l_match = st[4]

    _emit_label(ctx, labels, l_loop)
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(1, 10))
    _emit_jcc_to_label(ctx, fixups, "ge", l_done)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 1))
    bytes_extend(ctx["code"], core.insn_imul_r64_imm32(0, 8))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(0, 11))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(0, 0))
    bytes_extend(ctx["code"], core.insn_mov_r32_r32(2, 0))
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(9, 2))
    _emit_jcc_to_label(ctx, fixups, "ae", l_match)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(1, 1))
    _emit_jmp_to_label(ctx, fixups, l_loop)

    _emit_label(ctx, labels, l_match)
    bytes_extend(ctx["code"], core.insn_shr_r64_imm8(0, 32))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(0, 8))
    _emit_jmp_to_label(ctx, fixups, l_done)
    return nil
}

fn _x64_emit_resolve_symbol_intrinsic(ctx, locals, args) {
    if args == nil || oren_list_len(args) != 1 {
        err(ctx, "x64 native v0: resolve_symbol expects 1 arg")
        return 1
    }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }

    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 0))
    var symtab_off = _x64_resolve_symbol_symtab_off(ctx)
    _x64_resolve_symbol_emit_unknown_default(ctx)

    if symtab_off == nil {
        if locals != nil { _emit_ensure_tracked_ptr_kind_x64(ctx, locals, 0, 1) }
        return 1
    }

    var st = _x64_resolve_symbol_emit_range_setup(ctx, symtab_off)
    _x64_resolve_symbol_emit_loop(ctx, st)
    _emit_label(ctx, st[0], st[2])
    _patch_local_fixups(ctx, st[0], st[1])
    if locals != nil { _emit_ensure_tracked_ptr_kind_x64(ctx, locals, 0, 1) }
    return 1
}

fn _emit_intrinsic_stack_helpers_x64(ctx, nm, expr, locals, args) {
    if nm == "oren_code_addr" { return _x64_emit_code_addr_intrinsic(ctx, args) }
    if nm == "get_fp" {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 5))
        return 1
    }
    if nm == "get_sp" {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 4))
        return 1
    }
    if nm == "oren_ctx_init" { return _x64_emit_ctx_init_intrinsic(ctx, locals, args) }
    if nm == "oren_ctx_switch" { return _x64_emit_ctx_switch_intrinsic(ctx, locals, args) }
    if nm == "resolve_symbol" { return _x64_emit_resolve_symbol_intrinsic(ctx, locals, args) }
    return 0
}
