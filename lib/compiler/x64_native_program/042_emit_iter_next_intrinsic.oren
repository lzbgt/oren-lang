    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 0))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    _emit_jmp_to_label(ctx, local_fixups, l_out_done)

    // allocate new out pair: list(cap=2,count=2)
    _emit_label(ctx, labels, l_out_alloc)
    // hdr = malloc(32)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 32))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_malloc_size_in_rax(ctx, locals)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_out, 0) // spill hdr
    // buf = malloc(16)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 16))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_malloc_size_in_rax(ctx, locals)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_buf, 0)

    // init header
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_out) // rdx = hdr
    // [hdr+0] count = 2
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 2))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 0))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    // [hdr+8] cap = 2
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 2))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    // [hdr+16] buf = buf
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_buf)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    // [hdr+24] magic = 'LIST'
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1279870019))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // r9 = buf
    _emit_mov_r64_mrbp(ctx, 9, 0 - tmp_buf)
    _emit_jmp_to_label(ctx, local_fixups, l_out_done)

    _emit_label(ctx, labels, l_out_done)
    // (rdx is out for reusable path; for alloc path we spilled hdr and reloaded it)
    // Ensure rdx = out and r9 = out_buf.
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_out)
    // For reusable path, reload r9 = *(out+16)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))

    // out_buf[0] = ok
    //
    // Note: prefer R10/R11 as base regs here, because the instruction
    // encoders are heavily exercised with those in existing x64 intrinsics.
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 9)) // r10 = out_buf
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_ok)
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // out_buf[1] = val
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_val)
    bytes_extend(ctx["code"], insn_mov_mr64_r64(11, 0))

    // return out (RAX)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    _emit_label(ctx, labels, l_finish)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}
