// x64-native: `oren_iter_next(container, idx, out_pair)` intrinsic.
//
// Iterator contract (matches lib/runtime_native/160_iteration.oren):
// - returns a 2-element list: [ok, value]
// - ok is 1 when an element exists at idx; 0 when iteration is complete
// - when out_pair is a valid list with cap>=2 and buf!=0, it is filled in-place
//   to avoid per-iteration allocations
//
// Rolling x64 v0 supported containers (converging toward lib/runtime_native/160_iteration.oren):
// - LIST heap objects (magic='LIST'): yield list elements
//   - Special-case: list slice views for typed buffers:
//     - [buf, off, len] or [buf, off, len, stride]
// - MAP heap objects (magic='MAP\\0'): yield keys (in insertion order; v0 does not sort yet)
// - BUF heap objects (magic='BUF\\0'): yield numeric elements by tag
// - Raw pointers treated as C strings (container>=4096): yield bytes until NUL
//
// Note: This intrinsic intentionally does not depend on `oren_find_node` / GC tracking.
// It uses conservative guards to avoid dereferencing small integers.

fn _emit_intrinsic_iter_next(ctx, locals, args) {
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: oren_iter_next expects 3 args"); return nil }

    var tmp_container = locals["$tmp1"]
    var tmp_idx = locals["$tmp2"]
    var tmp_out = locals["$tmp3"]
    var tmp_ok = locals["$tmp4"]
    var tmp_val = locals["$tmp5"]
    var tmp_buf = locals["$tmp6"]
    if tmp_container == nil || tmp_idx == nil || tmp_out == nil || tmp_ok == nil || tmp_val == nil || tmp_buf == nil {
        err(ctx, "x64 native v0: missing temp slots for iter_next")
        return nil
    }

    // Eval args LTR.
    _emit_eval_int_to_rax(ctx, args[0], locals) // container
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_container, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals) // idx
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_idx, 0)

    _emit_eval_int_to_rax(ctx, args[2], locals) // out_pair
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_out, 0)

    // ok=0, val=0 (spilled)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ok, 0)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)

    var labels = {}
    var local_fixups = []
    var l_compute_done = _new_label(ctx, "iter_next_compute_done")
    var l_is_list = _new_label(ctx, "iter_next_is_list")
    var l_is_map = _new_label(ctx, "iter_next_is_map")
    var l_is_buf = _new_label(ctx, "iter_next_is_buf")
    var l_try_string = _new_label(ctx, "iter_next_try_string")
    var l_out_select = _new_label(ctx, "iter_next_out_select")
    var l_out_ok = _new_label(ctx, "iter_next_out_ok")
    var l_out_alloc = _new_label(ctx, "iter_next_out_alloc")
    var l_out_done = _new_label(ctx, "iter_next_out_done")
    var l_finish = _new_label(ctx, "iter_next_finish")

    // If container==0 or idx<0 => ok=0 (already), skip.
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_container) // rdx = container
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_compute_done)
    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_idx) // rcx = idx
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(1, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_compute_done)

    // Do not probe magic tags on small integers.
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 4096))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_compute_done)

    // magic = *(container+24)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax()) // rax = magic

    // LIST?
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1279870019))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_list)
    // MAP?
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1296121168))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_map)
    // BUF?
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 4609346))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_buf)
    _emit_jmp_to_label(ctx, local_fixups, l_try_string)

    // --- List path: yield element at idx ---
    _emit_label(ctx, labels, l_is_list)
    // count -> r8
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0))
    // buf -> r9 = *(list+16)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))
    // if buf==0 => abort (corrupt list)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    var l_list_buf_ok = _new_label(ctx, "iter_next_list_buf_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_list_buf_ok)
    _emit_abort_panic_str(ctx, "iter_next: corrupt list (buf=0)")
    _emit_label(ctx, labels, l_list_buf_ok)

    // Typed-buffer view list special-case:
    // - slice view:   [buf, off, len]
    // - strided view: [buf, off, len, stride]
    //
    // Matches the runtime behavior in lib/runtime_native/160_iteration.oren.
    var l_list_view_try3 = _new_label(ctx, "iter_next_list_view_try3")
    var l_list_view_try4 = _new_label(ctx, "iter_next_list_view_try4")
    var l_list_view_fail = _new_label(ctx, "iter_next_list_view_fail")
    var l_list_view_done = _new_label(ctx, "iter_next_list_view_done")
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 3))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_list_view_try3)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 4))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_list_view_try4)
    _emit_jmp_to_label(ctx, local_fixups, l_list_view_fail)

    // --- View list (count==3): [buf, off, len] ---
    _emit_label(ctx, labels, l_list_view_try3)
    // b -> r11, off -> r10, n -> r8, stride -> r9 (set to 1)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0)) // r11 = b

    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 0)) // r10 = off

    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 16))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0)) // r8 = n

    bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 1)) // r9 = stride=1
    var l_list_view_validate = _new_label(ctx, "iter_next_list_view_validate")
    _emit_jmp_to_label(ctx, local_fixups, l_list_view_validate)

    // --- View list (count==4): [buf, off, len, stride] ---
    _emit_label(ctx, labels, l_list_view_try4)
    // b -> r11, off -> r10, n -> r8, stride -> r9 (load)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0)) // r11 = b

    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 0)) // r10 = off

    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 16))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0)) // r8 = n

    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 24))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0)) // r9 = stride

    _emit_label(ctx, labels, l_list_view_validate)

    // Validate off>=0, n>=0, stride>0.
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_list_view_fail)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_list_view_fail)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_list_view_fail)

    // b must be a plausible pointer (>=4096) and have BUF magic at +24 (view discriminator).
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 4096))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_list_view_fail)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 24))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 4609346))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_list_view_fail)

    // Valid view: bounded by n. If idx >= n => done (do not leak metadata fields).
    bytes_extend(ctx["code"], insn_cmp_r64_r64(1, 8)) // idx vs n
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_compute_done)

    // Compute elem_idx = off + (idx * stride) into r10.
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10)) // rax = off
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1)) // r10 = idx
    bytes_extend(ctx["code"], insn_imul_r64_r64(10, 9)) // r10 *= stride
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 0)) // r10 += off

    // blen -> r8 (overwrite n)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0))

    // elem_idx >=0 and < blen
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_compute_done)
    bytes_extend(ctx["code"], insn_cmp_r64_r64(10, 8))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_compute_done)

    // data_ptr -> r9 = *(b+40) else *(b+16)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 40))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    var l_view_data_ok = _new_label(ctx, "iter_next_list_view_data_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_view_data_ok)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 16))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))
    _emit_label(ctx, labels, l_view_data_ok)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_compute_done)

    // tag -> rax = *(b+32)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 32))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())

    // Dispatch by tag (1=i32,2=i64,3=f32,4=f64,5=u8)
    var l_view_tag_i32 = _new_label(ctx, "iter_next_list_view_tag_i32")
    var l_view_tag_i64 = _new_label(ctx, "iter_next_list_view_tag_i64")
    var l_view_tag_f32 = _new_label(ctx, "iter_next_list_view_tag_f32")
    var l_view_tag_f64 = _new_label(ctx, "iter_next_list_view_tag_f64")
    var l_view_tag_u8 = _new_label(ctx, "iter_next_list_view_tag_u8")

    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 5))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_view_tag_u8)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_view_tag_i32)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 2))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_view_tag_i64)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 3))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_view_tag_f32)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 4))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_view_tag_f64)
    _emit_jmp_to_label(ctx, local_fixups, l_compute_done)

    _emit_label(ctx, labels, l_view_tag_u8)
    // val = *(u8*)(data + elem_idx)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 9))
    bytes_extend(ctx["code"], insn_add_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 11))
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_list_view_done)

    _emit_label(ctx, labels, l_view_tag_i32)
    // val = signext(*(i32*)(data + elem_idx*4))
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(11, 2))
    bytes_extend(ctx["code"], insn_add_r64_r64(11, 9))
    bytes_extend(ctx["code"], insn_mov_r32_mr32_disp(0, 11, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_list_view_done)

    _emit_label(ctx, labels, l_view_tag_i64)
    // val = *(i64*)(data + elem_idx*8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(11, 3))
    bytes_extend(ctx["code"], insn_add_r64_r64(11, 9))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_list_view_done)

    _emit_label(ctx, labels, l_view_tag_f64)
    // val = raw f64 bits *(u64*)(data + elem_idx*8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(11, 3))
    bytes_extend(ctx["code"], insn_add_r64_r64(11, 9))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_list_view_done)

    _emit_label(ctx, labels, l_view_tag_f32)
    // Load f32 bits then widen to f64 container bits:
    // xmm0 = f32(bits); xmm0 = (double)xmm0; rax = bits(xmm0)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(11, 2))
    bytes_extend(ctx["code"], insn_add_r64_r64(11, 9))
    bytes_extend(ctx["code"], insn_mov_r32_mr32_disp(0, 11, 0))
    bytes_extend(ctx["code"], insn_movd_xmm_r32(0, 0))
    bytes_extend(ctx["code"], insn_cvtss2sd_xmm_xmm(0, 0))
    bytes_extend(ctx["code"], insn_movq_r64_xmm(0, 0))
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)

    _emit_label(ctx, labels, l_list_view_done)
    // ok = 1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ok, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_compute_done)

    _emit_label(ctx, labels, l_list_view_fail)

    // Normal list path: if idx >= count => done
    bytes_extend(ctx["code"], insn_cmp_r64_r64(1, 8))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_compute_done)
    // val = *(buf + idx*8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(10, 3))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    // ok = 1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ok, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_compute_done)

    // --- Map path: yield key at idx (in insertion order) ---
    _emit_label(ctx, labels, l_is_map)
    // count -> r8
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0))
    bytes_extend(ctx["code"], insn_cmp_r64_r64(1, 8))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_compute_done)
    // buf -> r9 = *(map+16)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))
    // count>0 implies buf!=0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    var l_map_buf_ok = _new_label(ctx, "iter_next_map_buf_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_map_buf_ok)
    _emit_abort_panic_str(ctx, "iter_next: corrupt map (buf=0)")
    _emit_label(ctx, labels, l_map_buf_ok)
    // entry_ptr = buf + idx*24
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_imul_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 9))
    // key = *(entry_ptr)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    // ok = 1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ok, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_compute_done)

    // --- Buffer path: yield numeric element at idx (by tag) ---
    _emit_label(ctx, labels, l_is_buf)
    // len -> r8
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0))
    // if idx >= len => done
    bytes_extend(ctx["code"], insn_cmp_r64_r64(1, 8))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_compute_done)

    // data_ptr -> r9 = *(buf+40) else *(buf+16)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 40))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    var l_buf_data_ok = _new_label(ctx, "iter_next_buf_data_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_buf_data_ok)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))
    _emit_label(ctx, labels, l_buf_data_ok)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_compute_done)

    // tag -> rax = *(buf+32)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 32))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())

    var l_buf_tag_i32 = _new_label(ctx, "iter_next_buf_tag_i32")
    var l_buf_tag_i64 = _new_label(ctx, "iter_next_buf_tag_i64")
    var l_buf_tag_f32 = _new_label(ctx, "iter_next_buf_tag_f32")
    var l_buf_tag_f64 = _new_label(ctx, "iter_next_buf_tag_f64")
    var l_buf_tag_u8 = _new_label(ctx, "iter_next_buf_tag_u8")
    var l_buf_done = _new_label(ctx, "iter_next_buf_done")

    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 5))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_buf_tag_u8)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_buf_tag_i32)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 2))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_buf_tag_i64)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 3))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_buf_tag_f32)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 4))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_buf_tag_f64)
    _emit_jmp_to_label(ctx, local_fixups, l_compute_done)

    _emit_label(ctx, labels, l_buf_tag_u8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 10))
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_buf_done)

    _emit_label(ctx, labels, l_buf_tag_i32)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_mov_r32_mr32_disp(0, 10, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_buf_done)

    _emit_label(ctx, labels, l_buf_tag_i64)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(10, 3))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_buf_done)

    _emit_label(ctx, labels, l_buf_tag_f64)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(10, 3))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_buf_done)

    _emit_label(ctx, labels, l_buf_tag_f32)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_mov_r32_mr32_disp(0, 10, 0))
    bytes_extend(ctx["code"], insn_movd_xmm_r32(0, 0))
    bytes_extend(ctx["code"], insn_cvtss2sd_xmm_xmm(0, 0))
    bytes_extend(ctx["code"], insn_movq_r64_xmm(0, 0))
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)

    _emit_label(ctx, labels, l_buf_done)
    // ok = 1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ok, 0)
    _emit_jmp_to_label(ctx, local_fixups, l_compute_done)

    // --- String path: treat container as C string pointer (best-effort) ---
    _emit_label(ctx, labels, l_try_string)
    // Only attempt pointer iteration for "large" values to avoid dereferencing small ints.
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 4096))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_compute_done)
    // addr = container + idx
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 1))
    // ch = *(u8*)addr
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 10))
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_compute_done)
    // val = ch (0..255)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)
    // ok = 1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ok, 0)

    _emit_label(ctx, labels, l_compute_done)

    // --- Select output pair (reuse or allocate) ---
    _emit_label(ctx, labels, l_out_select)
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_out) // rdx = out
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_out_alloc)

    // magic check: [out+24] == LIST
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1279870019))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_out_alloc)

    // cap >= 2
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0)) // r8 = cap
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 2))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_out_alloc)

    // buf != 0
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0)) // r9 = buf
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_out_ok)
    _emit_jmp_to_label(ctx, local_fixups, l_out_alloc)

    // out is reusable
    _emit_label(ctx, labels, l_out_ok)
    // count = 2
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 2))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 0))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    _emit_jmp_to_label(ctx, local_fixups, l_out_done)

    // allocate new out pair: list(cap=2,count=2)
    _emit_label(ctx, labels, l_out_alloc)
    // hdr = malloc(32)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 32))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_malloc_size_in_rax(ctx, locals)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_out, 0) // spill hdr
    // buf = malloc(16)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 16))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_malloc_size_in_rax(ctx, locals)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_buf, 0)

    // init header
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_out) // rdx = hdr
    // [hdr+0] count = 2
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 2))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 0))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    // [hdr+8] cap = 2
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 2))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    // [hdr+16] buf = buf
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_buf)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    // [hdr+24] magic = 'LIST'
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1279870019))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // r9 = buf
    _emit_mov_r64_mrbp(ctx, 9, 0 - tmp_buf)
    _emit_jmp_to_label(ctx, local_fixups, l_out_done)

    _emit_label(ctx, labels, l_out_done)
    // (rdx is out for reusable path; for alloc path we spilled hdr and reloaded it)
    // Ensure rdx = out and r9 = out_buf.
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_out)
    // For reusable path, reload r9 = *(out+16)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))

    // out_buf[0] = ok
    //
    // Note: prefer R10/R11 as base regs here, because the instruction
    // encoders are heavily exercised with those in existing x64 intrinsics.
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 9)) // r10 = out_buf
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_ok)
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // out_buf[1] = val
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_val)
    bytes_extend(ctx["code"], insn_mov_mr64_r64(11, 0))

    // return out (RAX)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    _emit_label(ctx, labels, l_finish)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}
