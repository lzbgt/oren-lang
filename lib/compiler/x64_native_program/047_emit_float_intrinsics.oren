// x64 native v0: float support (Tier‑1 x86_64).
//
// Oren v0 represents `float` as raw IEEE-754 binary64 bits stored in the same 64-bit carrier
// register used for ints/pointers.
//
// Because x64 native v0 does not yet have tagged values, we use the same rolling heuristic
// as the arm64 native backend to decide when to emit float operations.

fn _x64_name_has_suffix(name, suffix) {
    if name == nil || suffix == nil { return false }
    var n = oren_string_len(name)
    var m = oren_string_len(suffix)
    if n < m { return false }
    var i = 0
    while i < m {
        if oren_string_char_at(name, n - m + i) != oren_string_char_at(suffix, i) { return false }
        i = i + 1
    }
    return true
}

fn _x64_name_is_or_has_suffix(name, exact, suffix) {
    if name == exact { return true }
    return _x64_name_has_suffix(name, suffix)
}

fn _x64_name_is_std_math_rounding_float(name) {
    if name == "floor" || name == "ceil" || name == "round" || name == "trunc" { return true }
    if name == "STD_math_floor" || name == "STD_math_ceil" || name == "STD_math_round" || name == "STD_math_trunc" { return true }
    if name == "math_floor" || name == "math_ceil" || name == "math_round" || name == "math_trunc" { return true }
    return false
}

fn _x64_expr_identifier_is_floaty(ctx, expr) {
    var name = expr["value"]
    if ctx != nil {
        if ctx["locals_floaty"] != nil && ctx["locals_floaty"][name] == true { return true }
        if ctx["globals_floaty"] != nil && ctx["globals_floaty"][name] == true { return true }
    }
    return false
}

fn _x64_expr_call_name(expr) {
    var fnn = expr["fn"]
    if fnn != nil && fnn["type"] == "Identifier" {
        return fnn["value"]
    }
    if fnn != nil && fnn["type"] == "Member" {
        var prop = fnn["prop"]
        if prop != nil && prop["type"] == "Identifier" { return prop["value"] }
    }
    return nil
}

fn _x64_call_name_is_float_buffer(nm) {
    if nm == "oren_f32_round" { return true }
    if nm == "oren_u32_bits_to_f32" { return true }
    if nm == "oren_u64_bits_to_f64" { return true }
    if nm == "oren_buf_load_f32" { return true }
    if nm == "oren_buf_load_f64" { return true }
    if nm == "oren_buf_dot_f32" || nm == "oren_buf_dot_f64" { return true }
    if nm == "oren_buf_dot_f32_slice" || nm == "oren_buf_dot_f64_slice" { return true }
    if nm == "oren_buf_dot_f32_strided" || nm == "oren_buf_dot_f64_strided" { return true }
    if nm == "oren_buf_reduce_sum_f32" || nm == "oren_buf_reduce_sum_f64" { return true }
    return false
}

fn _x64_call_name_is_float_scalar(nm) {
    if _x64_name_is_or_has_suffix(nm, "abs_f", "_abs_f") { return true }
    if _x64_name_is_or_has_suffix(nm, "min_f", "_min_f") { return true }
    if _x64_name_is_or_has_suffix(nm, "max_f", "_max_f") { return true }
    if _x64_name_is_or_has_suffix(nm, "clamp_f", "_clamp_f") { return true }
    if _x64_name_is_std_math_rounding_float(nm) { return true }
    if _x64_name_is_or_has_suffix(nm, "round_even", "_round_even") { return true }
    if _x64_name_is_or_has_suffix(nm, "nearbyint", "_nearbyint") { return true }
    if _x64_name_is_or_has_suffix(nm, "rint", "_rint") { return true }
    if _x64_name_is_or_has_suffix(nm, "fmod", "_fmod") { return true }
    if _x64_name_is_or_has_suffix(nm, "_round_ties_even", "_round_ties_even") { return true }
    if _x64_name_is_or_has_suffix(nm, "remainder", "_remainder") { return true }
    if _x64_name_is_or_has_suffix(nm, "fdim", "_fdim") { return true }
    if _x64_name_is_or_has_suffix(nm, "nextafter", "_nextafter") { return true }
    if _x64_name_is_or_has_suffix(nm, "nexttoward", "_nexttoward") { return true }
    return false
}

fn _x64_call_name_is_float_root_power(nm) {
    if _x64_name_is_or_has_suffix(nm, "sqrt", "_sqrt") { return true }
    if _x64_name_is_or_has_suffix(nm, "cbrt", "_cbrt") { return true }
    if _x64_name_is_or_has_suffix(nm, "powi", "_powi") { return true }
    if _x64_name_is_or_has_suffix(nm, "pow", "_pow") { return true }
    if _x64_name_is_or_has_suffix(nm, "power", "_power") { return true }
    if _x64_name_is_or_has_suffix(nm, "pow2i", "_pow2i") { return true }
    if _x64_name_is_or_has_suffix(nm, "pow10_i", "_pow10_i") { return true }
    return false
}

fn _x64_call_name_is_float_scale_logb(nm) {
    if _x64_name_is_or_has_suffix(nm, "ldexp", "_ldexp") { return true }
    if _x64_name_is_or_has_suffix(nm, "scalbn", "_scalbn") { return true }
    if _x64_name_is_or_has_suffix(nm, "scalbln", "_scalbln") { return true }
    if _x64_name_is_or_has_suffix(nm, "logb", "_logb") { return true }
    return false
}

fn _x64_call_name_is_float_exp_family(nm) {
    if _x64_name_is_or_has_suffix(nm, "_exp_taylor", "_exp_taylor") { return true }
    if _x64_name_is_or_has_suffix(nm, "exp2", "_exp2") { return true }
    if _x64_name_is_or_has_suffix(nm, "exp", "_exp") { return true }
    if _x64_name_is_or_has_suffix(nm, "expm1", "_expm1") { return true }
    if _x64_name_is_or_has_suffix(nm, "exp10", "_exp10") { return true }
    return false
}

fn _x64_call_name_is_float_log_family(nm) {
    if _x64_name_is_or_has_suffix(nm, "log2", "_log2") { return true }
    if _x64_name_is_or_has_suffix(nm, "log1p", "_log1p") { return true }
    if _x64_name_is_or_has_suffix(nm, "log10", "_log10") { return true }
    if _x64_name_is_or_has_suffix(nm, "log", "_log") { return true }
    if _x64_name_is_or_has_suffix(nm, "lnf", "_lnf") { return true }
    if _x64_name_is_or_has_suffix(nm, "ln", "_ln") { return true }
    return false
}

fn _x64_call_name_is_float_exp_log(nm) {
    if _x64_call_name_is_float_root_power(nm) { return true }
    if _x64_call_name_is_float_scale_logb(nm) { return true }
    if _x64_call_name_is_float_exp_family(nm) { return true }
    if _x64_call_name_is_float_log_family(nm) { return true }
    return false
}

fn _x64_call_name_is_float_trig(nm) {
    if _x64_name_is_or_has_suffix(nm, "sinh", "_sinh") { return true }
    if _x64_name_is_or_has_suffix(nm, "cosh", "_cosh") { return true }
    if _x64_name_is_or_has_suffix(nm, "tanh", "_tanh") { return true }
    if _x64_name_is_or_has_suffix(nm, "asinh", "_asinh") { return true }
    if _x64_name_is_or_has_suffix(nm, "acosh", "_acosh") { return true }
    if _x64_name_is_or_has_suffix(nm, "atanh", "_atanh") { return true }
    if _x64_name_is_or_has_suffix(nm, "_erfc_positive_approx", "_erfc_positive_approx") { return true }
    if _x64_name_is_or_has_suffix(nm, "erfc", "_erfc") { return true }
    if _x64_name_is_or_has_suffix(nm, "erf", "_erf") { return true }
    if _x64_name_is_or_has_suffix(nm, "pi", "_pi") { return true }
    if _x64_name_is_or_has_suffix(nm, "tau", "_tau") { return true }
    if _x64_name_is_or_has_suffix(nm, "nan", "_nan") { return true }
    if _x64_name_is_or_has_suffix(nm, "inf", "_inf") { return true }
    if _x64_name_is_or_has_suffix(nm, "sin", "_sin") { return true }
    if _x64_name_is_or_has_suffix(nm, "cos", "_cos") { return true }
    if _x64_name_is_or_has_suffix(nm, "tan", "_tan") { return true }
    if _x64_name_is_or_has_suffix(nm, "atan", "_atan") { return true }
    if _x64_name_is_or_has_suffix(nm, "atan2", "_atan2") { return true }
    if _x64_name_is_or_has_suffix(nm, "asin", "_asin") { return true }
    if _x64_name_is_or_has_suffix(nm, "acos", "_acos") { return true }
    if _x64_name_is_or_has_suffix(nm, "hypot", "_hypot") { return true }
    return false
}

fn _x64_call_name_is_float_linalg(nm) {
    if _x64_name_is_or_has_suffix(nm, "determinant", "_determinant") { return true }
    if _x64_name_is_or_has_suffix(nm, "dot_f32", "_dot_f32") { return true }
    if _x64_name_is_or_has_suffix(nm, "dot_f64", "_dot_f64") { return true }
    if _x64_name_is_or_has_suffix(nm, "dot_f32_buf", "_dot_f32_buf") { return true }
    if _x64_name_is_or_has_suffix(nm, "dot_f64_buf", "_dot_f64_buf") { return true }
    if _x64_name_is_or_has_suffix(nm, "reduce_sum_f64_buf", "_reduce_sum_f64_buf") { return true }
    if _x64_name_is_or_has_suffix(nm, "dot_f32_view", "_dot_f32_view") { return true }
    if _x64_name_is_or_has_suffix(nm, "dot_f64_view", "_dot_f64_view") { return true }
    return false
}

fn _x64_call_name_is_floaty(nm) {
    if nm == nil { return false }
    if _x64_call_name_is_float_buffer(nm) { return true }
    if _x64_call_name_is_float_scalar(nm) { return true }
    if _x64_call_name_is_float_exp_log(nm) { return true }
    if _x64_call_name_is_float_trig(nm) { return true }
    if _x64_call_name_is_float_linalg(nm) { return true }
    return false
}

fn _x64_prefix_expr_is_floaty(ctx, expr) {
    if expr["op"] == "-" { return _x64_expr_is_floaty(ctx, expr["right"]) }
    return false
}

fn _x64_infix_expr_is_floaty(ctx, expr) {
    var op = expr["op"]
    if op != "+" && op != "-" && op != "*" && op != "/" { return false }
    if _x64_expr_is_floaty(ctx, expr["left"]) { return true }
    if _x64_expr_is_floaty(ctx, expr["right"]) { return true }
    return false
}

fn _x64_expr_is_floaty(ctx, expr) {
    // Heuristic, rolling "float propagation" for x64 native.
    //
    // This must be conservative: float ops reinterpret bits, so applying them to integers
    // would miscompile.
    if expr == nil { return false }
    var et = expr["type"]
    if et == "Float" { return true }
    if et == "Identifier" { return _x64_expr_identifier_is_floaty(ctx, expr) }
    if et == "Call" {
        return _x64_call_name_is_floaty(_x64_expr_call_name(expr))
    }
    if et == "Prefix" { return _x64_prefix_expr_is_floaty(ctx, expr) }
    if et == "Infix" { return _x64_infix_expr_is_floaty(ctx, expr) }
    return false
}

fn _x64_expr_identifier_is_inty(ctx, expr) {
    var name = expr["value"]
    if ctx != nil {
        if ctx["locals_inty"] != nil && ctx["locals_inty"][name] == true { return true }
        if ctx["globals_inty"] != nil && ctx["globals_inty"][name] == true { return true }
    }
    return false
}

fn _x64_prefix_expr_is_inty(ctx, expr) {
    if expr["op"] == "-" || expr["op"] == "~" { return _x64_expr_is_inty(ctx, expr["right"]) }
    return false
}

fn _x64_infix_expr_is_inty(ctx, expr) {
    var op = expr["op"]
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
        if _x64_expr_is_inty(ctx, expr["left"]) && _x64_expr_is_inty(ctx, expr["right"]) { return true }
    }
    return false
}

fn _x64_index_expr_is_inty(expr) {
    if expr["recv_kind"] == "list_int" { return true }
    return false
}

fn _x64_call_name_is_int_arith(nm) {
    if nm == "iadd" || nm == "isub" || nm == "imul" || nm == "idiv" || nm == "imod" { return true }
    if nm == "oren_trunc_int" { return true }
    if nm == "oren_int" { return true }
    if nm == "oren_f32_to_u32_bits" { return true }
    if nm == "oren_f64_to_u64_bits" { return true }
    return false
}

fn _x64_call_name_is_int_len(nm) {
    if nm == "oren_string_len" { return true }
    if nm == "oren_list_len" { return true }
    if nm == "oren_list_int_len" || nm == "STD_list_int_len" { return true }
    if nm == "oren_list_int_len_unchecked" || nm == "STD_list_int_len_unchecked" { return true }
    if nm == "oren_map_len" { return true }
    if nm == "oren_buf_len" { return true }
    return false
}

fn _x64_call_name_is_int_list_or_buf(nm) {
    if nm == "oren_list_int_get" || nm == "STD_list_int_get" { return true }
    if nm == "oren_list_int_get_unchecked" || nm == "STD_list_int_get_unchecked" { return true }
    if nm == "oren_buf_load_u8" || nm == "oren_buf_load_u8_unchecked" { return true }
    if nm == "oren_buf_load_i32" || nm == "oren_buf_load_i64" { return true }
    if nm == "oren_buf_dot_i32" || nm == "oren_buf_dot_i32_slice" || nm == "oren_buf_dot_i32_strided" { return true }
    if nm == "oren_buf_reduce_sum_i32" { return true }
    return false
}

fn _x64_call_name_is_inty(nm) {
    if _x64_call_name_is_int_arith(nm) { return true }
    if _x64_call_name_is_int_len(nm) { return true }
    if _x64_call_name_is_int_list_or_buf(nm) { return true }
    return false
}

fn _x64_call_expr_is_inty(expr) {
    var fnn = expr["fn"]
    if fnn != nil && fnn["type"] == "Identifier" {
        return _x64_call_name_is_inty(fnn["value"])
    }
    return false
}

fn _x64_expr_is_inty(ctx, expr) {
    // Heuristic "int propagation" for x64 native (rolling).
    if expr == nil { return false }
    if _x64_expr_is_floaty(ctx, expr) { return false }
    var et = expr["type"]
    if et == "Integer" { return true }
    if et == "Float" { return false }
    if et == "String" { return false }
    if et == "Identifier" { return _x64_expr_identifier_is_inty(ctx, expr) }
    if et == "Prefix" { return _x64_prefix_expr_is_inty(ctx, expr) }
    if et == "Infix" { return _x64_infix_expr_is_inty(ctx, expr) }
    if et == "Index" { return _x64_index_expr_is_inty(expr) }
    if et == "Call" { return _x64_call_expr_is_inty(expr) }
    return false
}

fn _x64_parse_simple_nonneg_decimal_int(s) {
    if s == nil { return nil }
    var n = oren_string_len(s)
    if n <= 0 { return nil }
    // Keep this fast path bounded and defer large/qualified literals to intparse.
    if n > 18 { return nil }
    var out = 0
    var i = 0
    while i < n {
        var c = oren_string_byte_at_unchecked(s, i) & 255
        if c < 48 || c > 57 { return nil }
        out = out * 10 + (c - 48)
        i = i + 1
    }
    return out
}

fn _x64_expr_int_const(ctx, expr) {
    if expr == nil { return nil }
    if expr["type"] == "Integer" {
        var fast = _x64_parse_simple_nonneg_decimal_int(expr["value"])
        if fast != nil { return fast }
        var n = intparse.parse_int_lit(expr["value"])
        if oren_is_err(n) { _x64_err_invalid_int_lit(ctx, expr["value"]); return nil }
        return n
    }
    if expr["type"] == "Identifier" {
        var name = expr["value"]
        if ctx != nil && ctx["locals_int_const"] != nil {
            var v = ctx["locals_int_const"][name]
            if oren_type_tag(v) != 0 { return v }
        }
        if ctx != nil && ctx["globals_int_const"] != nil {
            var v2 = ctx["globals_int_const"][name]
            if oren_type_tag(v2) != 0 { return v2 }
        }
    }
    if expr["type"] == "Member" {
        var resolved = _x64_ns_resolve(ctx, expr)
        if resolved != nil {
            var name2 = resolved["name"]
            if ctx != nil && ctx["globals_int_const"] != nil {
                var v3 = ctx["globals_int_const"][name2]
                if oren_type_tag(v3) != 0 { return v3 }
            }
        }
    }
    if expr["type"] == "Prefix" {
        var rhs = _x64_expr_int_const(ctx, expr["right"])
        if oren_type_tag(rhs) == 0 { return nil }
        if expr["op"] == "-" { return 0 - rhs }
        if expr["op"] == "+" { return rhs }
    }
    return nil
}

fn _emit_float64_binop_x64(ctx, op, left_expr, right_expr, locals) {
    // Emit float64 arithmetic:
    // - operands are either float bits (if floaty) or ints (converted via cvtsi2sd)
    // - result is returned as float bits in RAX
    //
    // Uses XMM0/XMM1 as scratch.
    if ctx == nil { return nil }
    if left_expr == nil || right_expr == nil { err(ctx, "x64 native v0: float binop missing operands"); return nil }

    var state = _x64_float_binary_spill_operands(ctx, left_expr, right_expr, locals)
    if state == nil { return nil }
    _x64_float_binary_load_xmms(ctx, left_expr, right_expr, state)
    if _x64_float64_binop_emit_op(ctx, op) != true {
        _intr_tmp_pop(ctx, state["base"])
        err(ctx, "x64 native v0: unsupported float binop op: " + op)
        return nil
    }
    _x64_float64_binop_return_bits(ctx)
    _intr_tmp_pop(ctx, state["base"])
    return nil
}

fn _x64_float64_binop_emit_op(ctx, op) {
    if op == "+" { bytes_extend(ctx["code"], core.insn_addsd_xmm_xmm(0, 1)); return true }
    if op == "-" { bytes_extend(ctx["code"], core.insn_subsd_xmm_xmm(0, 1)); return true }
    if op == "*" { bytes_extend(ctx["code"], core.insn_mulsd_xmm_xmm(0, 1)); return true }
    if op == "/" { bytes_extend(ctx["code"], core.insn_divsd_xmm_xmm(0, 1)); return true }
    return false
}

fn _x64_float64_binop_return_bits(ctx) {
    bytes_extend(ctx["code"], core.insn_movq_r64_xmm(0, 0))
    return nil
}

fn _emit_intrinsic_oren_f32_round_x64(ctx, expr, locals) {
    if ctx == nil { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_f32_round expects 1 arg"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_f32_round does not support spread"); return nil }
    if !_x64_expr_is_floaty(ctx, args[0]) { err(ctx, "x64 native v0: oren_f32_round expects float arg"); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals) // f64 bits
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    // XMM0 = bits -> f64
    bytes_extend(ctx["code"], core.insn_movq_xmm_r64(0, 0))
    // XMM0 = f32(XMM0)
    bytes_extend(ctx["code"], core.insn_cvtsd2ss_xmm_xmm(0, 0))
    // XMM0 = f64(XMM0)
    bytes_extend(ctx["code"], core.insn_cvtss2sd_xmm_xmm(0, 0))
    // RAX = bits
    bytes_extend(ctx["code"], core.insn_movq_r64_xmm(0, 0))
    return nil
}

fn _emit_intrinsic_oren_trunc_int_x64(ctx, expr, locals) {
    // Intrinsic: truncate float bits to an int (toward zero), or identity for int-like values.
    if ctx == nil { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_trunc_int expects 1 arg"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_trunc_int does not support spread"); return nil }

    var a0 = args[0]
    _emit_eval_int_to_rax(ctx, a0, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    if _x64_expr_is_floaty(ctx, a0) {
        // xmm0 = bits(rax); rax = (int64)xmm0 (truncate)
        bytes_extend(ctx["code"], core.insn_movq_xmm_r64(0, 0))
        bytes_extend(ctx["code"], core.insn_cvttsd2si_r64_xmm(0, 0))
    }
    return nil
}

fn _x64_float_binary_spill_operands(ctx, left_expr, right_expr, locals) {
    var base = _intr_tmp_push(ctx, 2)
    if oren_type_tag(base) == 0 { return nil }
    var tmp_a = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_b = _intr_tmp_off(ctx, locals, base + 1)
    if oren_type_tag(tmp_a) == 0 || oren_type_tag(tmp_b) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, left_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_a, 0)

    _emit_eval_int_to_rax(ctx, right_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_b, 0)

    return {"base": base, "tmp_a": tmp_a, "tmp_b": tmp_b}
}

fn _x64_float_binary_load_xmms(ctx, left_expr, right_expr, state) {
    // Load/convert A into XMM0.
    _emit_mov_r64_mrbp(ctx, 0, 0 - state["tmp_a"]) // rax = a
    if _x64_expr_is_floaty(ctx, left_expr) {
        bytes_extend(ctx["code"], core.insn_movq_xmm_r64(0, 0)) // xmm0 = bits(rax)
    } else {
        bytes_extend(ctx["code"], core.insn_cvtsi2sd_xmm_r64(0, 0)) // xmm0 = (double)rax
    }

    // Load/convert B into XMM1.
    _emit_mov_r64_mrbp(ctx, 0, 0 - state["tmp_b"]) // rax = b
    if _x64_expr_is_floaty(ctx, right_expr) {
        bytes_extend(ctx["code"], core.insn_movq_xmm_r64(1, 0)) // xmm1 = bits(rax)
    } else {
        bytes_extend(ctx["code"], core.insn_cvtsi2sd_xmm_r64(1, 0)) // xmm1 = (double)rax
    }
    return nil
}

fn _x64_float_cmp_emit_branch(ctx, op, local_fixups, l_true, l_done) {
    if op == "==" {
        _emit_jcc_to_label(ctx, local_fixups, "p", l_done)
        _emit_jcc_to_label(ctx, local_fixups, "e", l_true)
        _emit_jmp_to_label(ctx, local_fixups, l_done)
        return true
    }
    if op == "!=" {
        _emit_jcc_to_label(ctx, local_fixups, "p", l_true)
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_true)
        _emit_jmp_to_label(ctx, local_fixups, l_done)
        return true
    }
    if op == "<" {
        _emit_jcc_to_label(ctx, local_fixups, "p", l_done)
        _emit_jcc_to_label(ctx, local_fixups, "b", l_true)
        _emit_jmp_to_label(ctx, local_fixups, l_done)
        return true
    }
    if op == "<=" {
        _emit_jcc_to_label(ctx, local_fixups, "p", l_done)
        _emit_jcc_to_label(ctx, local_fixups, "be", l_true)
        _emit_jmp_to_label(ctx, local_fixups, l_done)
        return true
    }
    if op == ">" {
        _emit_jcc_to_label(ctx, local_fixups, "p", l_done)
        _emit_jcc_to_label(ctx, local_fixups, "a", l_true)
        _emit_jmp_to_label(ctx, local_fixups, l_done)
        return true
    }
    if op == ">=" {
        _emit_jcc_to_label(ctx, local_fixups, "p", l_done)
        _emit_jcc_to_label(ctx, local_fixups, "ae", l_true)
        _emit_jmp_to_label(ctx, local_fixups, l_done)
        return true
    }
    return false
}

fn _x64_float_cmp_emit_bool_result(ctx, op) {
    var labels = {}
    var local_fixups = []
    var l_true = _new_label(ctx, "fcmp_true")
    var l_done = _new_label(ctx, "fcmp_done")

    if _x64_float_cmp_emit_branch(ctx, op, local_fixups, l_true, l_done) != true {
        err(ctx, "x64 native v0: unsupported float compare op: " + op)
        return nil
    }

    _emit_label(ctx, labels, l_true)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_float_cmp_to_bool_x64(ctx, op, left_expr, right_expr, locals) {
    // Emit float comparison (IEEE-754 ordered semantics; NaN is unordered):
    // - `==` true only when ordered and equal
    // - `!=` true when unordered OR not equal
    // - `< <= > >=` true only when ordered and relation holds
    //
    // Result: boolean 0/1 in RAX.
    //
    // Uses XMM0/XMM1 as scratch; uses intrinsic temp pool for safe nested evaluation.
    if ctx == nil { return nil }
    if left_expr == nil || right_expr == nil { err(ctx, "x64 native v0: float cmp missing operands"); return nil }

    var state = _x64_float_binary_spill_operands(ctx, left_expr, right_expr, locals)
    if state == nil { return nil }
    _x64_float_binary_load_xmms(ctx, left_expr, right_expr, state)

    // Compare XMM0 vs XMM1 (sets ZF/PF/CF).
    bytes_extend(ctx["code"], core.insn_ucomisd_xmm_xmm(0, 1))

    // Default result = 0 (false).
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())

    _x64_float_cmp_emit_bool_result(ctx, op)
    _intr_tmp_pop(ctx, state["base"])
    return nil
}
