            bytes_extend(ctx["code"], insn_pop_r64(14))
            bytes_extend(ctx["code"], insn_pop_r64(13))
            bytes_extend(ctx["code"], insn_pop_r64(12))
            bytes_extend(ctx["code"], insn_pop_r64(5))
