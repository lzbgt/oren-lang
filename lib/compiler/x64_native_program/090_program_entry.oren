// Compile minimal x64 program.
//
// Returns a ctx:
// - code: []byte
// - data: []byte (used by PE import table)
// - fixups: list of fixups for emitters (call_main, rip_data32)
// - functions: map name->offset
// - import_list: list of imports (for PE)
// - errors: list of strings

fn x64_env_str_eq(a, b) {
    // Avoid depending on runtime string equality semantics in compiler hot paths.
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _x64_str_contains_bytes(hay, needle) {
    // Byte-based substring search for ASCII-ish strings (paths, env vars).
    // Returns true if `needle` occurs in `hay`.
    if hay == nil || needle == nil { return false }
    var n = oren_string_len(hay)
    var m = oren_string_len(needle)
    if m == 0 { return true }
    if m > n { return false }
    var i = 0
    while i <= (n - m) {
        var j = 0
        while j < m {
            if (oren_string_byte_at_unchecked(hay, i + j) & 255) != (oren_string_byte_at_unchecked(needle, j) & 255) { break }
            j = j + 1
        }
        if j == m { return true }
        i = i + 1
    }
    return false
}

fn _x64_should_use_full_native_runtime_profile(linked) {
    // Default runtime injection profile heuristic (rolling, perf-oriented):
    // - Prefer the smaller core profile for typical programs to keep cold rtobj misses bounded.
    // - Escalate to the full profile when program dependencies imply runtime networking is needed.
    //
    // NOTE: This intentionally uses the module graph (import closure), not deep AST scanning,
    // to keep the decision fast and deterministic.
    if linked == nil { return true } // safe default
    var g = linked["module_graph"]
    if g == nil { return true } // safe default

    // Any module under `lib/std/net/` needs the full runtime profile today because std:net calls
    // runtime primitives (`oren_tcp_*`, `oren_udp_*`, `oren_select_*`, `oren_net_get`).
    var entry = g["entry"]
    if _x64_str_contains_bytes(entry, "/lib/std/net/") || _x64_str_contains_bytes(entry, "\\lib\\std\\net\\") { return true }

    var mods = g["modules"]
    if mods == nil { return false }
    var i = 0
    while i < oren_list_len(mods) {
        var m = mods[i]
        if m != nil {
            var p = m["path"]
            if _x64_str_contains_bytes(p, "/lib/std/net/") || _x64_str_contains_bytes(p, "\\lib\\std\\net\\") { return true }
        }
        i = i + 1
    }
    return false
}

fn _emit_parse_u64_decimal_from_cstr_ptr_x64(ctx, start_ptr_reg, dst_reg, labels, local_fixups) {
    // Parse decimal digits at *(char*)start_ptr_reg into dst_reg (u64).
    //
    // Stops at first non-digit. Returns 0 if there are no digits.
    //
    // Clobbers: RAX, R10, R11
    if ctx == nil { return nil }
    bytes_extend(ctx["code"], insn_mov_r64_imm64(dst_reg, 0))
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, start_ptr_reg)) // r11 = cursor

    var l_loop = _new_label(ctx, "parse_u64_digits_loop")
    var l_done = _new_label(ctx, "parse_u64_digits_done")
    _emit_label(ctx, labels, l_loop)

    // eax = *(u8*)r11
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 11))
    // if eax < '0' => done
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 48))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_done)
    // if eax > '9' => done
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 57))
    _emit_jcc_to_label(ctx, local_fixups, "g", l_done)

    // eax -= '0'
    bytes_extend(ctx["code"], insn_sub_r32_imm32(0, 48))
    // dst = dst*10 + eax
    bytes_extend(ctx["code"], insn_imul_r64_imm32(dst_reg, 10))
    bytes_extend(ctx["code"], insn_movsxd_r64_r32(10, 0)) // r10 = digit
    bytes_extend(ctx["code"], insn_add_r64_r64(dst_reg, 10))

    // cursor++
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_loop)

    _emit_label(ctx, labels, l_done)
    return nil
}

fn _emit_entry_capture_envblock_windows_x64(ctx, scratch_base) {
    // Windows x64: capture the Win32 environment block pointer for the injected runtime.
    //
    // Strategy (Tier‑1 production):
    // - Call kernel32!GetEnvironmentStringsA() to obtain the environment block:
    //     "K=V\\0K2=V2\\0...\\0\\0"
    // - Store the returned pointer in the entry scratch region.
    // - After `native_runtime_init` (so `malloc_raw` is available), build a POSIX-style `envp`
    //   array from this block by calling the runtime helper:
    //     `native_envp_build_from_win_envblock(env_block)`.
    //
    // Notes:
    // - The runtime helper copies env strings into runtime-owned memory, so the env block
    //   can be safely freed after `native_envp_build_from_win_envblock` returns.
    // - This removes the previous fixed-allowlist envp synthesis and makes ENV semantics match
    //   Linux/macOS (full environment visible to `env()` / `native_envp_get_value_ptr`).
    //
    // Requires:
    // - PE emitter imports kernel32!GetEnvironmentStringsA and exposes IAT label
    //   "IAT_GetEnvironmentStringsA".
    //
    // Clobbers: RAX
    if ctx == nil { return nil }

    var mov_iat_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat_pos + 3, "IAT_GetEnvironmentStringsA")
    bytes_extend(ctx["code"], insn_call_rax()) // rax = env_block (or 0)

    // scratch[16] = env_block (later overwritten with envp pointer)
    _emit_mov_mrsp_r64(ctx, scratch_base + 16, 0)
    return nil
}

fn _emit_entry_build_args_windows_x64(ctx, scratch_base) {
    // Windows x64: synthesize argc/argv for the injected native runtime (no CRT).
    //
    // Strategy (Tier‑1, production correctness):
    // - Use the system command-line parser: shell32!CommandLineToArgvW(GetCommandLineW()).
    // - Convert each wide argument to UTF‑8 via kernel32!WideCharToMultiByte(CP_UTF8,...).
    // - Store the resulting `char** argv` + strings into fixed `.data` buffers.
    // - Store argc/argv pointers into the entry scratch region for `native_runtime_set_args`.
    //
    // Determinism:
    // - If argc exceeds the fixed cap or the pool overflows, abort with a deterministic exit code.
    //
    // Requires PE imports + IAT labels:
    // - kernel32!GetCommandLineW            => "IAT_GetCommandLineW"
    // - shell32!CommandLineToArgvW          => "IAT_CommandLineToArgvW"
    // - kernel32!WideCharToMultiByte        => "IAT_WideCharToMultiByte"
    // - kernel32!LocalFree                  => "IAT_LocalFree"
    //
    // Stack args note:
    // - WideCharToMultiByte has 8 parameters, so the entry stub must reserve Win64 stack arg
    //   slots at [rsp+0x20..] (see entry stub allocation below).
    //
    // Clobbers: RAX, RBX, RCX, RDX, R8, R9, R10, R11, R12, R13, R14, R15, RSI, RDI
    if ctx == nil { return nil }

    var max_args = 128
    var off_argv = _data_add_zeros(ctx, (max_args + 1) * 8)
    var pool_cap = 65536
    var off_pool = _data_add_zeros(ctx, pool_cap)
    // Offsets can legitimately be 0 (the first bytes in the data blob). Under the native
    // runtime stopgap value model, 0 is indistinguishable from `nil`, so never treat 0 as
    // failure here. `_data_add_zeros` only returns nil when `ctx` is nil or nbytes<=0.

    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "win_argv_done")
    var l_overflow = _new_label(ctx, "win_argv_overflow")
    var l_loop = _new_label(ctx, "win_argv_loop")
    var l_free = _new_label(ctx, "win_argv_free")

    // r13 = argv_out_cur = &argv_out[0]
    var lea_argv = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(13, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_argv + 3, "data_off": off_argv})

    // Default argc=0, argv=&argv_out[0] (so runtime has a stable pointer even on failure).
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrsp_r64(ctx, scratch_base + 0, 0)  // argc
    _emit_mov_mrsp_r64(ctx, scratch_base + 8, 13) // argv

    // temp argc storage (u64 slot; CommandLineToArgvW writes int32 into low bits)
    _emit_mov_mrsp_r64(ctx, scratch_base + 24, 0)

    // r12 = pool_cur = &pool[0]
    var lea_pool = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(12, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pool + 3, "data_off": off_pool})
    // r15 = pool_end = pool_cur + pool_cap
    bytes_extend(ctx["code"], insn_mov_r64_r64(15, 12))
    bytes_extend(ctx["code"], insn_add_r64_imm32(15, pool_cap))

    // GetCommandLineW() -> rax
    var mov_iat_cmd = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat_cmd + 3, "IAT_GetCommandLineW")
    bytes_extend(ctx["code"], insn_call_rax())

    // CommandLineToArgvW(cmd, &argc) -> rax (argvw), argc written to scratch.
    // rcx = cmdline (rax)
    bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0))
    // rdx = &scratch_argc (in the entry scratch region)
    // NOTE: scratch_base is chosen so scratch_base+24 fits disp8 for lea.
    bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(2, scratch_base + 24))
    var mov_iat_argvw = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat_argvw + 3, "IAT_CommandLineToArgvW")
    bytes_extend(ctx["code"], insn_call_rax())

    // if rax == 0 => done (leave argc=0, argv=&argv_out)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)

    // rbx = argvw_ptr (for LocalFree later)
    bytes_extend(ctx["code"], insn_mov_r64_r64(3, 0))

    // r10 = argc (u64)
    _emit_mov_r64_mrsp(ctx, 10, scratch_base + 24)
    // if argc <= 0 => free+done
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_free)
    // if argc > max_args => overflow
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, max_args))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_loop)
    _emit_jmp_to_label(ctx, local_fixups, l_overflow)

    _emit_label(ctx, labels, l_loop)
    // Persist argc for runtime_set_args.
    _emit_mov_mrsp_r64(ctx, scratch_base + 0, 10)

    // rsi = argvw_cur = argvw_ptr
    bytes_extend(ctx["code"], insn_mov_r64_r64(6, 3))
    // rdi = remaining = argc
    bytes_extend(ctx["code"], insn_mov_r64_r64(7, 10))

    var l_body = _new_label(ctx, "win_argv_body")
    var l_after = _new_label(ctx, "win_argv_after")
    _emit_jmp_to_label(ctx, local_fixups, l_body)

    _emit_label(ctx, labels, l_body)
    // if remaining == 0 => after
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(7, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_after)

    // r8 = wptr = *(u64*)rsi
    bytes_extend(ctx["code"], insn_mov_r64_mr64(8, 6))
    // rsi += 8
    bytes_extend(ctx["code"], insn_add_r64_imm32(6, 8))
    // Preserve wptr across WinAPI calls (r8 is volatile in Win64 ABI).
    _emit_mov_mrsp_r64(ctx, scratch_base + 24, 8)

    // Query required UTF-8 bytes: WideCharToMultiByte(CP_UTF8,0,wptr,-1,NULL,0,NULL,NULL)
    // rcx = 65001 (CP_UTF8)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 65001))
    // rdx = 0 (flags)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, 0))
    // r8 = wptr
    _emit_mov_r64_mrsp(ctx, 8, scratch_base + 24)
    // r9d = -1 (cchWideChar)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 4294967295))

    // stack args (5..8) at [rsp+0x20..]: zero them for the query call.
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrsp_r64(ctx, 32, 0) // lpMultiByteStr = NULL
    _emit_mov_mrsp_r64(ctx, 40, 0) // cbMultiByte = 0
    _emit_mov_mrsp_r64(ctx, 48, 0) // lpDefaultChar = NULL
    _emit_mov_mrsp_r64(ctx, 56, 0) // lpUsedDefaultChar = NULL

    var mov_iat_wctmb0 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat_wctmb0 + 3, "IAT_WideCharToMultiByte")
    bytes_extend(ctx["code"], insn_call_rax())

    // if eax == 0 => abort (conversion failed)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    var l_have_req = _new_label(ctx, "win_argv_have_req")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_have_req)
    _emit_abort_exitcode(ctx, 203)
    _emit_label(ctx, labels, l_have_req)

    // r10 = required bytes (u64)
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 0))

    // r14 = next_pool = pool_cur + required
    bytes_extend(ctx["code"], insn_mov_r64_r64(14, 12))
    bytes_extend(ctx["code"], insn_add_r64_r64(14, 10))
    // if next_pool > pool_end => overflow
    bytes_extend(ctx["code"], insn_cmp_r64_r64(14, 15))
    var l_pool_ok = _new_label(ctx, "win_argv_pool_ok")
    _emit_jcc_to_label(ctx, local_fixups, "le", l_pool_ok)
    _emit_jmp_to_label(ctx, local_fixups, l_overflow)
    _emit_label(ctx, labels, l_pool_ok)

    // Store pool_cur pointer into argv_out array: *argv_out_cur = pool_cur; argv_out_cur += 8
    bytes_extend(ctx["code"], insn_mov_mr64_r64(13, 12))
    bytes_extend(ctx["code"], insn_add_r64_imm32(13, 8))

    // Convert into pool_cur: WideCharToMultiByte(CP_UTF8,0,wptr,-1,pool_cur,required,NULL,NULL)
    // rcx = 65001
    bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 65001))
    // rdx = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, 0))
    // r8 = wptr
    _emit_mov_r64_mrsp(ctx, 8, scratch_base + 24)
    // r9d = -1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 4294967295))

    // arg5 = pool_cur
    _emit_mov_mrsp_r64(ctx, 32, 12)
    // arg6 = required
    _emit_mov_mrsp_r64(ctx, 40, 10)
    // arg7/8 = NULL
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrsp_r64(ctx, 48, 0)
    _emit_mov_mrsp_r64(ctx, 56, 0)

    var mov_iat_wctmb1 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat_wctmb1 + 3, "IAT_WideCharToMultiByte")
    bytes_extend(ctx["code"], insn_call_rax())

    // if eax == 0 => abort
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    var l_conv_ok = _new_label(ctx, "win_argv_conv_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_conv_ok)
    _emit_abort_exitcode(ctx, 203)
    _emit_label(ctx, labels, l_conv_ok)

    // pool_cur = next_pool
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 14))

    // remaining--
    bytes_extend(ctx["code"], insn_sub_r64_imm32(7, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_body)

    _emit_label(ctx, labels, l_after)
    // argv terminator: *argv_out_cur = NULL
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_mr64_r64(13, 0))
    _emit_jmp_to_label(ctx, local_fixups, l_free)

    _emit_label(ctx, labels, l_overflow)
    _emit_abort_exitcode(ctx, 202)

    _emit_label(ctx, labels, l_free)
    // LocalFree(argvw_ptr)
    // rcx = argvw_ptr (rbx)
    bytes_extend(ctx["code"], insn_mov_r64_r64(1, 3))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(1, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)
    var mov_iat_free = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat_free + 3, "IAT_LocalFree")
    bytes_extend(ctx["code"], insn_call_rax())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _rtobj_decode_int_enc(x_enc) {
    if x_enc == nil { return nil }
    return x_enc - 1
}

fn _x64_new_ctx(linked, platform) {
    // Shared x64 native compiler context initializer.
    //
    // This is used both by the main program compiler and by the native-runtime object cache
    // that compiles the injected runtime once and reuses it across builds.
    var ctx = {
        "code": bytes_new(),
        "data": bytes_new(),
        "fixups": [],
        "functions": {},
        "imports": {},
        "import_list": [],
        "errors": [],
        "platform": platform,
        // Global variable storage (top-level `var`).
        "globals": {},
        // Named function declarations (name -> arity) collected before codegen.
        "func_arity": {},
        // Named function varargs mapping (name -> fixed param count). Presence means varargs.
        "func_varargs_fixed": {},
        // Deterministic declaration order (source order). Used by some backends for wrapper synthesis.
        "func_decl_order": [],
        "declared_functions": {},
        // Track which named functions are actually used as first-class values so we only
        // synthesize `__oren_fnwrap_*` wrappers when needed (Tier‑1 perf; parity with arm64).
        "fnwrap_needed": {}
    }

    // Expose whether runtime injection is enabled so lowering can progressively
    // switch from x64 bring-up intrinsics to shared runtime helpers (Tier‑1 parity).
    ctx["inject_runtime"] = true
    ctx["abi"] = abi.x64(platform)

    // Import aliases / type namespaces are used by shared callable lowering and ns-resolution.
    if linked != nil {
        ctx["aliases"] = linked["aliases"]
        ctx["type_ns"] = linked["type_ns"]
    }
    if ctx["aliases"] == nil { ctx["aliases"] = {} }
    if ctx["type_ns"] == nil { ctx["type_ns"] = {} }

    // Lambda collection state (lambdas are parsed as Function nodes with name="").
    ctx["lambda_defs"] = []
    ctx["lambda_counter"] = 0

    // Reserve a `.data` slot holding the cstr0-literal table offset (u64).
    //
    // Store as offset+1 so a real offset of 0 is not indistinguishable from `nil`
    // when the compiler runs under the native runtime (where `nil` is 0).
    var cstr_slot_off = _data_add_u64(ctx, 0)
    ctx["cstr0_table_slot_enc"] = cstr_slot_off + 1

    // Tier‑1 bootstrap: reserve a stable slot for the runtime's `g_storage` global and a small
    // boot globals storage blob used before `native_runtime_init` runs.
    //
    // Layout is defined by `rtobj.RUNTIME_OBJ_DATA_PREFIX_LEN` and must match across:
    // - main program compilation
    // - runtime object compilation/cache
    var g_storage_slot_off = _data_add_u64(ctx, 0)
    if ctx["globals"] != nil { ctx["globals"]["g_storage"] = g_storage_slot_off + 1 }
    var boot_off = _data_add_zeros(ctx, 512)
    ctx["boot_globals_storage_off_enc"] = boot_off + 1

    // Tier‑1 export/FFI ABI bridge: reserve persistent heap register spill slots.
    //
    // x64 native uses r14/r15 as global bump allocator registers for intra-Oren calls.
    // That is intentionally incompatible with the platform ABIs at external boundaries
    // (C callers expect r14/r15 preserved). Export wrappers and DLL entrypoints use these
    // slots to persist heap state across calls while still restoring caller registers.
    var heap_limit_slot_off = _data_add_u64(ctx, 0)
    var heap_ptr_slot_off = _data_add_u64(ctx, 0)
    ctx["heap_limit_slot_enc"] = heap_limit_slot_off + 1
    ctx["heap_ptr_slot_enc"] = heap_ptr_slot_off + 1

    // Bounded debug knob (bring-up):
    // Enable narrow tracing inside list/hash literal lowering without paying an env lookup per literal.
    //   OREN_TRACE_X64_ARRAY_LIT=1 ./oren_stage2 build ... --platform x64-linux --no-cache
    if oren_env("OREN_TRACE_X64_ARRAY_LIT") != nil {
        ctx["trace_x64_array_lit"] = 1
    }
    return ctx
}

fn _x64_rtobj_encode_offsets_map_int(m) {
    // Encode map<string,int> as map<string,int+1> to avoid 0-as-nil in stage2-native.
    if m == nil { return {} }
    var out = {}
    var idx = 0
    var pair = [nil, nil]
    while 1 {
        var ok = oren_iter_next_entry(m, idx, pair)
        if ok == 0 { break }
        var k = pair[0]
        var v = pair[1]
        if k != nil && v != nil {
            out[k] = v + 1
        }
        idx = idx + 1
    }
    return out
}

fn _x64_rtobj_encode_offsets_list_int(xs) {
    if xs == nil { return [] }
    var out = []
    var i = 0
    while i < oren_list_len(xs) {
        var v = xs[i]
        if v != nil { oren_list_push(out, v + 1) }
        i = i + 1
    }
    return out
}

fn _x64_rtobj_encode_fixups(fixups) {
    if fixups == nil { return [] }
    var out = []
    var i = 0
    while i < oren_list_len(fixups) {
        var f0 = fixups[i]
        if f0 != nil {
            // NOTE: rip_data32 fixups are persisted separately in `rip_data32_fixups_enc`
            // to avoid storing thousands of per-fixup maps in the rtobj meta.
            if f0["type"] == "rip_data32" { i = i + 1; continue }
            var f1 = {"type": f0["type"], "pos": (f0["pos"] + 1)}
            if f0["name"] != nil { f1["name"] = f0["name"] }
            if f0["data_label"] != nil { f1["data_label"] = f0["data_label"] }
            if f0["data_off"] != nil { f1["data_off"] = (f0["data_off"] + 1) }
            oren_list_push(out, f1)
        }
        i = i + 1
    }
    return out
}

fn _x64_rtobj_encode_rip_data32_fixups(m) {
    // Encode map<string, list<int>> as map<string, list<int+1>>.
    // The +1 encoding avoids 0-as-nil in stage2-native.
    if m == nil { return {} }
    var out = {}
    var idx = 0
    var pair = [nil, nil]
    while 1 {
        var ok = oren_iter_next_entry(m, idx, pair)
        if ok == 0 { break }
        var k = pair[0]
        var xs = pair[1]
        if k != nil && xs != nil {
            var enc = []
            var i = 0
            while i < oren_list_len(xs) {
                var p = xs[i]
                if p != nil { oren_list_push(enc, p + 1) }
                i = i + 1
            }
            out[k] = enc
        }
        idx = idx + 1
    }
    return out
}

fn _x64_rtobj_apply_data_and_meta_to_ctx(ctx, meta) {
    // Apply the runtime object's `.data` and metadata to a fresh program ctx.
    //
    // IMPORTANT:
    // We apply `.data` early (so offsets remain stable), but defer splicing `.code` until
    // after the entry stub is emitted so the entrypoint stays at offset 0.
    if ctx == nil || meta == nil { return false }
    if ctx["errors"] == nil { ctx["errors"] = [] }

    var want_prefix = rtobj.RUNTIME_OBJ_DATA_PREFIX_LEN
    var have_prefix = bytes_len(ctx["data"])
    if have_prefix != want_prefix {
        err(ctx, "x64 native v0: runtime obj expects data prefix len=" + oren_int_to_string(want_prefix) + ", got " + oren_int_to_string(have_prefix))
        return false
    }

    // Append runtime data tail (after the shared prefix slot).
    var data_tail = meta["data_tail_u8"]
    if data_tail != nil { bytes_extend_u8_buf(ctx["data"], data_tail) }

    // Merge runtime globals (name -> data_off+1).
    if meta["globals"] != nil {
        var idxg = 0
        var pairg = [nil, nil]
        while 1 {
            var okg = oren_iter_next_entry(meta["globals"], idxg, pairg)
            if okg == 0 { break }
            var name = pairg[0]
            var off_enc = pairg[1]
            if name != nil && off_enc != nil {
                if ctx["globals"][name] != nil && ctx["globals"][name] != off_enc {
                    err(ctx, "x64 native v0: runtime obj global conflict " + name)
                } else {
                    ctx["globals"][name] = off_enc
                }
            }
            idxg = idxg + 1
        }
    }

    // Merge runtime cstr0 dedup map (string -> off+1).
    //
    // PERF (stage2-native, x64 emit):
    // This map can be very large (all runtime string literals). Merging it on every build
    // adds measurable overhead even when the runtime object cache hits.
    //
    // Correctness:
    // - We MUST still merge `cstr0_list_enc` so the entry stub registers runtime literals.
    // - We do NOT need to merge the dedup map for correctness; skipping it only means user
    //   strings may duplicate bytes already present in the cached runtime data tail.
    //
    // Policy:
    // - Default: skip merging runtime `cstr0_offs` for throughput.
    // - Opt-in: set `OREN_X64_RT_OBJ_MERGE_CSTR0_OFFS=1` to merge and reduce binary size.
    var merge_cstr0_offs = oren_env("OREN_X64_RT_OBJ_MERGE_CSTR0_OFFS") != nil
    if merge_cstr0_offs && meta["cstr0_offs"] != nil {
        if ctx["cstr0_offs"] == nil { ctx["cstr0_offs"] = {} }
        var idxo = 0
        var pairo = [nil, nil]
        while 1 {
            var oko = oren_iter_next_entry(meta["cstr0_offs"], idxo, pairo)
            if oko == 0 { break }
            var k0 = pairo[0]
            var v0 = pairo[1]
            if k0 != nil && v0 != nil {
                if ctx["cstr0_offs"][k0] == nil {
                    ctx["cstr0_offs"][k0] = v0
                }
            }
            idxo = idxo + 1
        }
    }

    // Merge runtime cstr0 offsets list (decoded offs into ctx list).
    if ctx["cstr0_list"] == nil { ctx["cstr0_list"] = [] }
    var c0 = meta["cstr0_list_enc"]
    if c0 != nil {
        var i0 = 0
        while i0 < oren_list_len(c0) {
            var off_enc2 = c0[i0]
            var off2 = _rtobj_decode_int_enc(off_enc2)
            if off2 != nil {
                oren_list_push(ctx["cstr0_list"], off2)
            }
            i0 = i0 + 1
        }
    }

    // Seed function metadata (for lambda capture analysis + wrapper synthesis + var shadow checks).
    if meta["declared_functions"] != nil { ctx["declared_functions"] = meta["declared_functions"] }
    if meta["func_arity"] != nil { ctx["func_arity"] = meta["func_arity"] }
    if meta["func_varargs_fixed"] != nil { ctx["func_varargs_fixed"] = meta["func_varargs_fixed"] }
    if meta["func_decl_order"] != nil { ctx["func_decl_order"] = meta["func_decl_order"] }

    // Prevent lambda wrapper name collisions with the cached runtime.
    var lc_enc = meta["lambda_counter_enc"]
    if lc_enc != nil {
        var lc = _rtobj_decode_int_enc(lc_enc)
        if lc != nil && lc >= 0 { ctx["lambda_counter"] = lc }
    }

    ctx["runtime_injected"] = true
    // Stash the full meta (including code_u8) for a later splice after entry stub emission.
    ctx["rtobj_pending"] = meta
    return true
}

fn _x64_rtobj_apply_code_to_ctx(ctx) {
    // Splice runtime `.code` after the entry stub and merge fixups/function offsets.
    if ctx == nil { return false }
    var meta = ctx["rtobj_pending"]
    if meta == nil { return false }
    if ctx["errors"] == nil { ctx["errors"] = [] }

    var base_code = bytes_len(ctx["code"])

    // Append runtime code.
    var code_u8 = meta["code_u8"]
    if code_u8 != nil { bytes_extend_u8_buf(ctx["code"], code_u8) }

    // Merge runtime function code offsets (name -> off+1 encoding in meta).
    var fn_offs_enc = meta["fn_offs_enc"]
    if fn_offs_enc != nil {
        var idxf = 0
        var pairf = [nil, nil]
        while 1 {
            var okf = oren_iter_next_entry(fn_offs_enc, idxf, pairf)
            if okf == 0 { break }
            var nm = pairf[0]
            var off_enc3 = pairf[1]
            var off3 = _rtobj_decode_int_enc(off_enc3)
            if nm != nil && off3 != nil {
                ctx["functions"][nm] = base_code + off3
            }
            idxf = idxf + 1
        }
    }

    // Merge runtime fixups (pos encoded as +1; adjust by base_code).
    var fx = meta["fixups_enc"]
    if fx != nil {
        var fi = 0
        while fi < oren_list_len(fx) {
            var f0 = fx[fi]
            if f0 != nil {
                var pos = _rtobj_decode_int_enc(f0["pos"])
                var data_off = _rtobj_decode_int_enc(f0["data_off"])
                if pos != nil {
                    if f0["type"] == "rip_data32" {
                        // Legacy caches may still store rip_data32 fixups in `fixups_enc`.
                        // Prefer collecting them into the compact `ctx["rip_data32_fixups"]` map.
                        var lab = f0["data_label"]
                        if lab != nil {
                            _x64_add_rip_data32_fixup(ctx, base_code + pos, lab)
                        }
                    } else {
                        if f0["type"] == "call_rel32" && f0["name"] == _x64_panic_helper_name() {
                            // Runtime object code may contain compiler-generated abort sites that call the
                            // shared panic helper. Mark it needed so the final program emits the helper
                            // even when user code itself doesn't trigger a compiler panic path.
                            ctx["need_panic_helper"] = true
                        }
                        // Mutate in-place to avoid allocating a new map per fixup (can be 10k+ entries).
                        //
                        // Safety:
                        // - `base_code + pos` is never 0 (entry stub is emitted first), so `pos` remains
                        //   representable even under the native runtime's `nil==0` model.
                        f0["pos"] = base_code + pos
                        if data_off != nil { f0["data_off"] = data_off }
                        oren_list_push(ctx["fixups"], f0)
                    }
                }
            }
            fi = fi + 1
        }
    }

    // Preferred representation (rolling): rip_data32 positions aggregated by label.
    var r32 = meta["rip_data32_fixups_enc"]
    if r32 != nil {
        var idx2 = 0
        var pair2 = [nil, nil]
        while 1 {
            var ok2 = oren_iter_next_entry(r32, idx2, pair2)
            if ok2 == 0 { break }
            var lab2 = pair2[0]
            var xs2 = pair2[1]
            if lab2 != nil && xs2 != nil {
                var i2 = 0
                while i2 < oren_list_len(xs2) {
                    var p_enc = xs2[i2]
                    var p0 = _rtobj_decode_int_enc(p_enc)
                    if p0 != nil { _x64_add_rip_data32_fixup(ctx, base_code + p0, lab2) }
                    i2 = i2 + 1
                }
            }
            idx2 = idx2 + 1
        }
    }

    ctx["rtobj_pending"] = nil
    return true
}

fn _x64_build_runtime_obj(platform, runtime_path, runtime_hash, backend_sig) {
    // Compile the injected native runtime into a reusable object blob for x86_64 native.
    //
    // Bounded tracing (perf guardrails; avoid huge logs):
    // - OREN_TRACE_X64_RT_OBJ_SUMMARY=1: single-line phase breakdown
    // - OREN_TRACE_X64_RT_OBJ_TOP_DECLS=1: keep only slowest N decls by compile time
    var trace_sum = oren_env("OREN_TRACE_X64_RT_OBJ_SUMMARY") != nil
    var t0 = 0
    var t_parse_done = 0
    var t_meta_done = 0
    var t_lambda_done = 0
    var t_split_done = 0
    var t_globals_done = 0
    var t_decls_done = 0
    var t_wrap_done = 0
    var t_finalize_done = 0
    if trace_sum { t0 = oren_time_now_ns() }

    var linked0 = {"statements": [], "aliases": {}, "type_ns": {}}
    var ctx = _x64_new_ctx(linked0, platform)
    // Runtime object compilation must behave like "runtime injected" mode so runtime code
    // can use Tier‑1 lowering paths (Index semantics, etc) that depend on runtime helpers.
    ctx["runtime_injected"] = true

    var trace = rtobj.rtobj_trace_enabled()

    // Avoid storing any real 0 function offsets in maps during the build.
    // (0 is `nil` in the native runtime value model.)
    bytes_push(ctx["code"], 144) // 0x90 (NOP)

    var prog = bundle.load_and_parse_runtime_native_for_platform(ctx, runtime_path, platform)
    if prog == nil { return nil }
    if trace_sum { t_parse_done = oren_time_now_ns() }

    var stmts = prog["statements"]
    if stmts == nil { stmts = [] }

    // Function metadata is required for lambda capture analysis and wrapper synthesis.
    var fns = coreir.collect_top_level_functions(ctx, {"statements": stmts}, "x64 native rtobj")
    if fns == nil { return nil }
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_sum { t_meta_done = oren_time_now_ns() }

    // Normalize nested `fn name(...)` to lambdas+vars for Tier‑1 parity.
    callable.rewrite_local_fn_decls_in_stmt_list(ctx, stmts)

    // Collect lambdas from the runtime so wrapper naming does not collide later.
    var li = 0
    while li < oren_list_len(stmts) {
        callable.collect_lambdas_in_statement(ctx, stmts[li])
        li = li + 1
    }
    if trace_sum { t_lambda_done = oren_time_now_ns() }

    // Allocate runtime globals (zero-initialized; runtime init owns their values).
    var declared = ctx["declared_functions"]
    var split = nt.split_tier1_runtime_user(ctx, "x64 native rtobj", stmts, [], declared)
    if split == nil { return nil }
    var runtime_vars = split["runtime_vars"]
    if runtime_vars == nil { runtime_vars = [] }
    if trace_sum { t_split_done = oren_time_now_ns() }

    var vi = 0
    while vi < oren_list_len(runtime_vars) {
        var st = runtime_vars[vi]
        if st != nil {
            var nm = st["name"]["value"]
            if nm == nil || nm == "" { err(ctx, "x64 native rtobj: runtime global var missing name"); return nil }
            // `g_storage` is reserved in the native entry stub `.data` prefix (Tier‑1 bootstrap).
            if nm == "g_storage" && ctx["globals"] != nil && ctx["globals"][nm] != nil { vi = vi + 1; continue }
            if ctx["globals"] != nil && ctx["globals"][nm] != nil {
                err(ctx, "x64 native rtobj: duplicate global var " + nm)
                return nil
            }
            var off0 = _data_add_u64(ctx, 0)
            ctx["globals"][nm] = off0 + 1
        }
        vi = vi + 1
    }
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_sum { t_globals_done = oren_time_now_ns() }

    // Compile runtime named functions.
    var trace_decls = oren_env("OREN_TRACE_X64_RT_OBJ_TOP_DECLS") != nil
    var top_decls = nil
    var top_keep = 12
    var sum_decl_ns = 0
    if trace_decls { top_decls = [] }
    var i = 0
    while i < oren_list_len(fns) {
        var t_decl0 = 0
        if trace_decls { t_decl0 = oren_time_now_ns() }
        _compile_function_v0(ctx, fns[i], platform)
        if trace_decls {
            var dt_decl = oren_time_now_ns() - t_decl0
            sum_decl_ns = sum_decl_ns + dt_decl
            // Keep only the slowest `top_keep` decls to avoid huge logs.
            var fn0 = fns[i]
            var nm0 = ""
            if fn0 != nil {
                var n0 = fn0["name"]
                if n0 != nil {
                    if oren_is_string(n0) == true { nm0 = n0 }
                    else if n0["value"] != nil { nm0 = n0["value"] }
                }
            }
            var ent = {"ns": dt_decl, "type": "Function", "name": nm0}
            if oren_list_len(top_decls) < top_keep {
                oren_list_push(top_decls, ent)
            } else {
                var min_idx = 0
                var min_ns = top_decls[0]["ns"]
                var j0 = 1
                while j0 < oren_list_len(top_decls) {
                    var e0 = top_decls[j0]
                    if e0 != nil && e0["ns"] != nil && e0["ns"] < min_ns {
                        min_ns = e0["ns"]
                        min_idx = j0
                    }
                    j0 = j0 + 1
                }
                if dt_decl > min_ns { top_decls[min_idx] = ent }
            }
        }
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
            if trace { print("[rtobj] x64 build failed (compile runtime fn): " + ctx["errors"][0]) }
            return nil
        }
        i = i + 1
    }
    if trace_sum { t_decls_done = oren_time_now_ns() }

    // Synthesize only wrappers needed by the runtime itself:
    // - named functions used as first-class values (tracked in ctx["fnwrap_needed"])
    // - lambda wrappers (always needed when a lambda literal exists)
    var wrappers = []
    var need = ctx["fnwrap_needed"]
    var wi = 0
    while wi < oren_list_len(ctx["func_decl_order"]) {
        var nm0 = ctx["func_decl_order"][wi]
        if nm0 == nil || nm0 == "" { wi = wi + 1; continue }
        if need == nil || need[nm0] == nil { wi = wi + 1; continue }

        var ar0 = nil
        if ctx["func_arity"] != nil {
            var ar0_enc = ctx["func_arity"][nm0]
            if ar0_enc != nil { ar0 = ar0_enc - 1 }
        }
        var vf0 = nil
        if ctx["func_varargs_fixed"] != nil {
            var vf0_enc = ctx["func_varargs_fixed"][nm0]
            if vf0_enc != nil { vf0 = vf0_enc - 1 }
        }
        if ar0 != nil {
            var stw = callable.synth_fnwrap(nm0, ar0, vf0)
            if stw != nil && stw["type"] == "ExprStmt" && stw["expr"] != nil && stw["expr"]["type"] == "Function" {
                oren_list_push(wrappers, stw["expr"])
            } else {
                err(ctx, "x64 native rtobj: failed to synthesize fnwrap for " + nm0)
                return nil
            }
        }
        wi = wi + 1
    }
    var lj = 0
    while lj < oren_list_len(ctx["lambda_defs"]) {
        var def = ctx["lambda_defs"][lj]
        var stl = callable.synth_lambda_wrapper(def)
        if stl != nil && stl["type"] == "ExprStmt" && stl["expr"] != nil && stl["expr"]["type"] == "Function" {
            oren_list_push(wrappers, stl["expr"])
        } else {
            err(ctx, "x64 native rtobj: failed to synthesize lambda wrapper")
            return nil
        }
        lj = lj + 1
    }

    // Compile synthesized wrappers.
    var j = 0
    while j < oren_list_len(wrappers) {
        var t_decl1 = 0
        if trace_decls { t_decl1 = oren_time_now_ns() }
        _compile_function_v0(ctx, wrappers[j], platform)
        if trace_decls {
            var dt_decl1 = oren_time_now_ns() - t_decl1
            sum_decl_ns = sum_decl_ns + dt_decl1
            var fn1 = wrappers[j]
            var nm1 = ""
            if fn1 != nil {
                var n1 = fn1["name"]
                if n1 != nil {
                    if oren_is_string(n1) == true { nm1 = n1 }
                    else if n1["value"] != nil { nm1 = n1["value"] }
                }
            }
            var ent1 = {"ns": dt_decl1, "type": "Wrapper", "name": nm1}
            if top_decls == nil { top_decls = [] }
            if oren_list_len(top_decls) < top_keep {
                oren_list_push(top_decls, ent1)
            } else {
                var min_idx1 = 0
                var min_ns1 = top_decls[0]["ns"]
                var k1 = 1
                while k1 < oren_list_len(top_decls) {
                    var e1 = top_decls[k1]
                    if e1 != nil && e1["ns"] != nil && e1["ns"] < min_ns1 {
                        min_ns1 = e1["ns"]
                        min_idx1 = k1
                    }
                    k1 = k1 + 1
                }
                if dt_decl1 > min_ns1 { top_decls[min_idx1] = ent1 }
            }
        }
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
            if trace { print("[rtobj] x64 build failed (compile wrapper): " + ctx["errors"][0]) }
            return nil
        }
        j = j + 1
    }
    if trace_sum { t_wrap_done = oren_time_now_ns() }

    if trace_decls && top_decls != nil {
        print("[x64_rtobj] top decls (us), sum_compile_ms=" + oren_int_to_string(sum_decl_ns / 1000000) + ":")
        var ti = 0
        while ti < oren_list_len(top_decls) {
            var e2 = top_decls[ti]
            if e2 != nil {
                var nm2 = e2["name"]
                if nm2 == nil { nm2 = "" }
                var ty2 = e2["type"]
                if ty2 == nil { ty2 = "" }
                var us = e2["ns"] / 1000
                print("  " + oren_int_to_string(us) + "us " + ty2 + " " + nm2)
            }
            ti = ti + 1
        }
    }

    // Materialize blobs for cache storage.
    var code_u8 = bytes_finalize(ctx["code"])
    var data_u8 = bytes_finalize(ctx["data"])
    if trace_sum { t_finalize_done = oren_time_now_ns() }
    var dn = oren_buf_len(data_u8)
    var prefix = rtobj.RUNTIME_OBJ_DATA_PREFIX_LEN
    if dn < prefix { return nil }
    var tail = oren_u8_buf_from_bytes_slice(data_u8, prefix, dn - prefix)
    if oren_is_err(tail) { return nil }

    var meta = {
        "schema": rtobj.RUNTIME_OBJ_SCHEMA,
        "backend": "x64",
        "backend_sig": backend_sig,
        "runtime_hash": runtime_hash,
        "data_prefix_len": prefix,
        "fn_offs_enc": _x64_rtobj_encode_offsets_map_int(ctx["functions"]),
        "fixups_enc": _x64_rtobj_encode_fixups(ctx["fixups"]),
        "rip_data32_fixups_enc": _x64_rtobj_encode_rip_data32_fixups(ctx["rip_data32_fixups"]),
        "globals": ctx["globals"],
        // PERF (stage2-native hot path):
        // Do not persist the full runtime `cstr0_offs` dedup map in rtobj meta by default.
        // It is large (all runtime string literals) and decoding it can dominate “compile one file”
        // even though merging it is optional for correctness.
        "cstr0_list_enc": _x64_rtobj_encode_offsets_list_int(ctx["cstr0_list"]),
        "declared_functions": ctx["declared_functions"],
        "func_arity": ctx["func_arity"],
        "func_varargs_fixed": ctx["func_varargs_fixed"],
        "func_decl_order": ctx["func_decl_order"],
        "lambda_counter_enc": ctx["lambda_counter"] + 1
    }
    if trace_sum {
        var total_ms = (t_finalize_done - t0) / 1000000
        var parse_ms = (t_parse_done - t0) / 1000000
        var meta_ms = (t_meta_done - t_parse_done) / 1000000
        var lambdas_ms = (t_lambda_done - t_meta_done) / 1000000
        var split_ms = (t_split_done - t_lambda_done) / 1000000
        var globals_ms = (t_globals_done - t_split_done) / 1000000
        var decls_ms = (t_decls_done - t_globals_done) / 1000000
        var wrap_ms = (t_wrap_done - t_decls_done) / 1000000
        var fin_ms = (t_finalize_done - t_wrap_done) / 1000000
        var fx_n = 0
        if ctx["fixups"] != nil { fx_n = oren_list_len(ctx["fixups"]) }
        var fn_n = 0
        if fns != nil { fn_n = oren_list_len(fns) }
        var wrap_n = 0
        if wrappers != nil { wrap_n = oren_list_len(wrappers) }
        print("[x64_rtobj] total_ms=" + oren_int_to_string(total_ms) +
              " parse_ms=" + oren_int_to_string(parse_ms) +
              " meta_ms=" + oren_int_to_string(meta_ms) +
              " lambdas_ms=" + oren_int_to_string(lambdas_ms) +
              " split_ms=" + oren_int_to_string(split_ms) +
              " globals_ms=" + oren_int_to_string(globals_ms) +
              " decls_ms=" + oren_int_to_string(decls_ms) +
              " wrappers_ms=" + oren_int_to_string(wrap_ms) +
              " finalize_ms=" + oren_int_to_string(fin_ms) +
              " fns_n=" + oren_int_to_string(fn_n) +
              " wrappers_n=" + oren_int_to_string(wrap_n) +
              " vars_n=" + oren_int_to_string(oren_list_len(runtime_vars)) +
              " code_bytes=" + oren_int_to_string(oren_buf_len(code_u8)) +
              " data_bytes=" + oren_int_to_string(oren_buf_len(data_u8)) +
              " fixups_n=" + oren_int_to_string(fx_n))
    }
    return {"meta": meta, "code_u8": code_u8, "data_tail_u8": tail}
}

fn _x64_try_load_or_build_runtime_obj(ctx, platform, runtime_path) {
    if ctx == nil { return false }
    if rtobj.rtobj_cache_enabled(platform) != true { return false }

    var trace = rtobj.rtobj_trace_enabled()
    var t0 = 0
    if trace { t0 = oren_time_now_ns() }

    var rh = rtobj.rtobj_runtime_hash(ctx, runtime_path)
    if rh == nil || rh == "" { return false }
    var key = rtobj.rtobj_cache_key("x64", platform, rh)
    var bsig = rtobj.rtobj_backend_sig("x64")
    var dir = rtobj.rtobj_cache_dir()

    var hit = rtobj.rtobj_load(dir, key)
    if hit != nil {
        if trace { print("[rtobj] hit backend=x64 key=" + key) }
        return _x64_rtobj_apply_data_and_meta_to_ctx(ctx, hit)
    }

    // Optional seed fallback (see rtobj module docs): allows fast first-build even when the
    // selected cache dir is empty.
    var seed_hit = rtobj.rtobj_try_load_seed_into_cache(dir, key)
    if seed_hit != nil {
        if trace { print("[rtobj] seed-hit backend=x64 key=" + key) }
        return _x64_rtobj_apply_data_and_meta_to_ctx(ctx, seed_hit)
    }

    if trace { print("[rtobj] miss backend=x64 key=" + key + " (building)") }
    var built = _x64_build_runtime_obj(platform, runtime_path, rh, bsig)
    if built == nil { return false }

    // Persist to cache.
    var meta = built["meta"]
    rtobj.rtobj_store(dir, key, meta, built["code_u8"], built["data_tail_u8"])

    // Apply immediately (avoid re-reading).
    meta["code_u8"] = built["code_u8"]
    meta["data_tail_u8"] = built["data_tail_u8"]
    var ok = _x64_rtobj_apply_data_and_meta_to_ctx(ctx, meta)
    if trace {
        var dt = oren_time_now_ns() - t0
        print("[rtobj] build+apply(data) done +" + oren_int_to_string(dt / 1000000) + "ms")
    }
    return ok
}

fn _x64_symtab_push_unique(sym_seen, sym_names, nm) {
    if sym_seen == nil || sym_names == nil { return nil }
    if nm == nil || nm == "" { return nil }
    if sym_seen[nm] != nil { return nil }
    sym_seen[nm] = true
    oren_list_push(sym_names, nm)
    return nil
}

fn native_compile_program_x64(linked, platform) {
    // Tier‑1: x86_64 always injects the native runtime (same bundle as arm64).
    //
    // Goal: converge with the ARM64 native backend, which injects `lib/runtime_native.oren`
    // (expanded from `lib/runtime_native/**`) into the compiled program.
    //
    // Default:
    // - x86_64 now injects the native runtime by default, matching arm64.
    //
    // Note:
    //
    // Rationale:
    // - this is the primary architectural lever for removing x86_64 bring-up-only intrinsics
    //   and converging semantics across native backends.
    //
    // Implementation strategy (rolling):
    // - Parse the expanded runtime source into an AST program.
    // - Merge runtime statements ahead of user statements so function/var declarations are
    //   available to user code just like on arm64.
    // - Keep x64's existing intrinsics for now; as we converge, we will progressively replace
    //   intrinsic implementations with calls into injected runtime functions.
    var trace_sum = oren_env("OREN_TRACE_X64_COMPILE_SUMMARY") != nil
    // Bounded progress tracing for large cross-target builds (prints every N functions).
    var trace_prog = false
    var v_prog = oren_env("OREN_TRACE_X64_COMPILE_PROGRESS")
    if v_prog != nil && v_prog != "" {
        if x64_env_str_eq(v_prog, "0") != true && x64_env_str_eq(v_prog, "false") != true {
            trace_prog = true
        }
    }
    // Debug knobs: OREN_TRACE_X64_COMPILE_STRIDE, _FOCUS_FROM/_TO, OREN_TRACE_X64_SLOW_FN_MS.
    var prog_stride = 200
    var prog_focus_from = -1
    var prog_focus_to = -1
    var prog_slow_fn_ms = 2000
    if trace_prog {
        prog_stride = core.parse_int_decimal(oren_env("OREN_TRACE_X64_COMPILE_STRIDE"), prog_stride)
        prog_focus_from = core.parse_int_decimal(oren_env("OREN_TRACE_X64_COMPILE_FOCUS_FROM"), prog_focus_from)
        prog_focus_to = core.parse_int_decimal(oren_env("OREN_TRACE_X64_COMPILE_FOCUS_TO"), prog_focus_to)
        prog_slow_fn_ms = core.parse_int_decimal(oren_env("OREN_TRACE_X64_SLOW_FN_MS"), prog_slow_fn_ms)
    }
    var focus_enabled = trace_prog && prog_focus_from >= 0 && prog_focus_to > prog_focus_from
    // Entry-stub tracing is a runtime-side breadcrumb trail for remote debugging (Win11/WSL).
    // It is intentionally opt-in and bounded (a few short lines).
    var trace_entry = false
    var v_entry = oren_env("OREN_TRACE_X64_ENTRY")
    if v_entry != nil && v_entry != "" {
        if x64_env_str_eq(v_entry, "0") != true && x64_env_str_eq(v_entry, "false") != true {
            trace_entry = true
        }
    }
    var t0 = 0
    var t_rtobj_done = 0
    var t_entry_done = 0
    var t_apply_rtobj_done = 0
    var t_top_done = 0
    var t_fns_done = 0
    var t_wrappers_done = 0
    var t_fnwrap_done = 0
    var t_panic_done = 0
    var t_finalize_done = 0
    if trace_sum { t0 = oren_time_now_ns() }

    var runtime_path = "lib/runtime_native.oren"
    if platform != nil && platform["capsule"] == true {
        runtime_path = "lib/runtime_native_capsule.oren"
    } else {
        // Optional: smaller injected runtime profile to keep cold rtobj builds bounded.
        //
        // Values (rolling):
        // - unset / "auto": default heuristic (prefers core; escalates to full for std:net)
        // - "full": force full runtime (`lib/runtime_native.oren`)
        // - "core" / "minimal": reduced runtime (`lib/runtime_native_core.oren`)
        var prof = oren_env("OREN_NATIVE_RUNTIME_PROFILE")
        if x64_env_str_eq(prof, "full") {
            runtime_path = "lib/runtime_native.oren"
        } else if x64_env_str_eq(prof, "core") || x64_env_str_eq(prof, "minimal") {
            runtime_path = "lib/runtime_native_core.oren"
        } else {
            // Default-on heuristic:
            // - core unless the program imports `std:net/*` (which requires runtime networking primitives).
            runtime_path = "lib/runtime_native_core.oren"
            if x64_env_str_eq(prof, "auto") || prof == nil || prof == "" {
                if _x64_should_use_full_native_runtime_profile(linked) { runtime_path = "lib/runtime_native.oren" }
            }
        }
    }
    var linked2 = linked

    var ctx = _x64_new_ctx(linked, platform)

    // Runtime injection (default-on; see comment at top of function).
    //
    // Use the shared Tier‑1 native runtime bundle so arm64/x64 converge on:
    // - identical include expansion + parsing,
    // - capsule enforcement (compile-time) when `--capsule` is enabled,
    // - post-injection DCE + pinned entry-stub roots.
    var used_rtobj = _x64_try_load_or_build_runtime_obj(ctx, platform, runtime_path)
    if trace_sum { t_rtobj_done = oren_time_now_ns() }

    var bun = nil
    var runtime_stmts = []
    var user_stmts = []
    if used_rtobj != true {
        bun = bundle.prepare_native_runtime_bundle(ctx, "x64", linked, platform, {"runtime_path": runtime_path, "inject_runtime": true})
        if bun == nil { return ctx }
        linked2 = bun["linked"]
        ctx["runtime_injected"] = true
        runtime_stmts = bun["runtime_stmts"]
        user_stmts = bun["user_stmts"]
        if runtime_stmts == nil { runtime_stmts = [] }
        if user_stmts == nil { user_stmts = [] }
    } else {
        // Runtime already compiled into ctx; user statements come from the original program.
        user_stmts = nil
        if linked != nil { user_stmts = linked["statements"] }
        if user_stmts == nil { user_stmts = [] }
        runtime_stmts = []
    }

    // Runtime pruning (size + compile time):
    // The injected native runtime branches on `g_target_os`, but for a target-specific
    // build those branches are compile-time constants. Prune unreachable runtime branches
    // early so the x64 backend does not compile dead platform code.
    if used_rtobj != true {
        pprune.prune_runtime_os_branches_in_linked_program_in_place(linked2, platform)
    }

    // Normalize local `fn name(...) { ... }` declarations inside blocks into lambdas+vars
    // so Tier‑1 native backends share the same nested-function semantics.
    if used_rtobj != true {
        callable.rewrite_local_fn_decls_in_stmt_list(ctx, runtime_stmts)
    }
    callable.rewrite_local_fn_decls_in_stmt_list(ctx, user_stmts)

    var fns = nil
    if used_rtobj == true {
        // Runtime function metadata already seeded from rtobj; add user declarations.
        fns = coreir.collect_top_level_functions_merge(ctx, linked2, "x64 native v0")
    } else {
        fns = _extract_functions_v0(ctx, linked2)
    }
    if fns == nil { return ctx }

    // --- Type constructors (Tier‑1 parity with arm64 native) ---
    //
    // `struct`/`class` declarations are first-class constructors in Oren native codegen:
    //   struct User { id, name }  =>  fn User(id, name) { return {"id": id, "name": name} }
    //
    // arm64 implements this in its native stmt compiler; x64 must synthesize the same
    // constructor functions so programs using type constructors compile on x86_64 too.
    var type_ctors = _x64_extract_type_constructors_v0(ctx, linked2)
    if type_ctors == nil { return ctx }
    var tci = 0
    while tci < oren_list_len(type_ctors) { oren_list_push(fns, type_ctors[tci]); tci = tci + 1 }
    // Rolling parity with other backends:
    // - `fn main()` is optional; if absent, only `__top_level__` runs.
    var has_main = false
    if ctx["declared_functions"] != nil && ctx["declared_functions"]["main"] != nil { has_main = true }

    // --- FFI declarations (Tier‑1 parity) ---
    //
    // Collect `ffi name` declarations so:
    // - the name is reserved (globals can't shadow it)
    // - direct calls can resolve to backend-emitted stubs
    _x64_collect_ffi_decls(ctx, runtime_stmts, user_stmts)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // --- Global vars + top-level statements (Tier‑1 convergence) ---
    //
    // Collect top-level `var` declarations into `ctx["globals"]` and build the statement list
    // that will run before `main` as a synthesized `__top_level__` function.
    //
    // We scan after function collection so we can reject global names that shadow functions.
    var top_info = _x64_collect_top_level_globals_and_stmts(ctx, runtime_stmts, user_stmts)
    if top_info == nil { return ctx }

    // Collect lambdas (anonymous Function nodes with name="") from the full statement set
    // that will actually be compiled.
    //
    // This annotates lambda nodes with:
    //   - lambda_name: generated wrapper name
    //   - captures: free vars in deterministic first-use order
    //
    // NOTE: We must scan more than just `bun["user_stmts"]` because:
    // - runtime injection + DCE can keep runtime lambdas alive,
    // - x64 synthesizes `__top_level__` from user global initializers,
    // - x64 synthesizes type constructors.
    var stmts_all = linked2["statements"]
    if stmts_all == nil { stmts_all = [] }
    var li = 0
    while li < oren_list_len(stmts_all) {
        callable.collect_lambdas_in_statement(ctx, stmts_all[li])
        li = li + 1
    }
    // Also scan synthesized `__top_level__` (not present in `linked2["statements"]`).
    if top_info["top_level_fn"] != nil {
        callable.collect_lambdas_in_expression(ctx, top_info["top_level_fn"])
    }
    // Also scan synthesized type constructors (not present in `linked2["statements"]`).
    var ltc = 0
    while ltc < oren_list_len(type_ctors) {
        callable.collect_lambdas_in_expression(ctx, type_ctors[ltc])
        ltc = ltc + 1
    }


    var dbg_lam = oren_env("OREN_DEBUG_X64_LAMBDAS")
    if dbg_lam != nil {
        var raw_fn = 0
        var expr_fn = 0
        var si = 0
        while si < oren_list_len(stmts_all) {
            var st0 = stmts_all[si]
            if st0 != nil {
                if st0["type"] == "Function" { raw_fn = raw_fn + 1 }
                if st0["type"] == "ExprStmt" {
                    var e0 = st0["expr"]
                    if e0 != nil && e0["type"] == "Function" { expr_fn = expr_fn + 1 }
                }
            }
            si = si + 1
        }
        print("DEBUG_X64_LAMBDAS stmts_all=" + oren_int_to_string(oren_list_len(stmts_all)) + " raw_fn=" + oren_int_to_string(raw_fn) + " expr_fn=" + oren_int_to_string(expr_fn))
        print("DEBUG_X64_LAMBDAS lambda_defs=" + oren_int_to_string(oren_list_len(ctx["lambda_defs"])))
        var di = 0
        while di < oren_list_len(ctx["lambda_defs"]) {
            var d0 = ctx["lambda_defs"][di]
            if d0 != nil { print("DEBUG_X64_LAMBDA_DEF " + d0["name"]) }
            di = di + 1
        }
    }
    // --- Callable wrappers (Tier‑1 convergence) ---
    //
    // x64 no longer eagerly synthesizes `__oren_fnwrap_<name>` for every named function:
    // - it is unnecessary for direct calls (`foo(x)`),
    // - and it can dominate compile time for large programs (self-hosting `oren.oren`).
    //
    // Instead, we synthesize/compile fnwraps on-demand using `ctx["fnwrap_needed"]`
    // (populated when a named function is used as a first-class value).
    //
    // Lambda wrappers are still synthesized eagerly because each lambda literal needs a
    // concrete callable entrypoint.
    var wrappers = []

    // Lambda wrappers are named `__oren_lambda_N` and already implement the uniform call ABI:
    //   fn __oren_lambda_N(__env, __args_list) { ... }
    // They inline the original lambda body and bind captures/params from env/args.
    var lj = 0
    while lj < oren_list_len(ctx["lambda_defs"]) {
        var def = ctx["lambda_defs"][lj]
        var st = callable.synth_lambda_wrapper(def)
        if st != nil && st["type"] == "ExprStmt" && st["expr"] != nil && st["expr"]["type"] == "Function" {
            oren_list_push(wrappers, st["expr"])
        } else {
            err(ctx, "x64 native v0: failed to synthesize lambda wrapper")
            return ctx
        }
        lj = lj + 1
    }

    // --- Panic symbolication (best-effort) ---
    //
    // --- Debug-info table (stack traces; debug builds only) ---
    //
    // The injected runtime provides `oren_resolve_symbol(pc)` which prefers an embedded
    // debug-info table (range-based) when `oren_set_debug_info(ptr, static_addr)` is called.
    //
    // In practice, we need this even in rolling v0 because:
    // - the runtime is usually provided via the compiled runtime-object cache (rtobj),
    // - rtobj code cannot embed final-program symtab references (those are reserved/finalized
    //   in this file), so `resolve_symbol(pc)` inside rtobj would otherwise degrade to "???".
    //
    // Reserve a u64 slot holding the debug-info table offset so the entry stub can:
    // - read the final offset at runtime, and
    // - compute a PIE-safe pointer using the same `data_base` derivation as the cstr0 table.
    if platform != nil && platform["debug"] == true {
        var dbg_slot_off = _data_add_u64(ctx, 0)
        // Store as offset+1 so 0 is not indistinguishable from `nil` in stage2-native.
        ctx["dbginfo_table_slot_enc"] = dbg_slot_off + 1
    }

    // Symbol table for `resolve_symbol(pc)` (optional; rolling):
    // - Debug builds already embed a range-based debug-info table used by `oren_resolve_symbol(pc)`.
    // - A full symtab can still be useful for postmortem/debugging when debug-info is missing,
    //   but it can materially increase compile time (rtobj contributes many symbols).
    //
    // Policy:
    // - Default: skip symtab+linetab generation (even in debug builds).
    // - Opt-in: set `OREN_NATIVE_RESOLVE_SYMBOL=1` to generate the full tables.
    var want_resolve_symbol = false
    var env_rs = oren_env("OREN_NATIVE_RESOLVE_SYMBOL")
    if env_rs != nil && env_rs == "1" { want_resolve_symbol = true }

    if platform != nil && platform["debug"] == true {
        // Display label mapping used by the embedded debug-info table.
        // - key: real function name (used to look up code offsets)
        // - value: display label (may include source location)
        ctx["symtab_display"] = {"__entry_stub__": "__entry_stub__", "__top_level__": "__top_level__@<top-level>"}

        // User functions (deterministic: source order).
        var si0 = 0
        while si0 < oren_list_len(fns) {
            var fn0 = fns[si0]
            if fn0 != nil && fn0["name"] != nil && fn0["name"] != "" {
                var nm1 = fn0["name"]
                var disp = nm1
                var tok0 = fn0["token"]
                if tok0 != nil && tok0["file"] != nil && tok0["line"] != nil {
                    disp = nm1 + "@" + tok0["file"] + ":" + oren_int_to_string(tok0["line"])
                }
                ctx["symtab_display"][nm1] = disp
            }
            si0 = si0 + 1
        }
        // Wrappers (deterministic: synthesis order).
        si0 = 0
        while si0 < oren_list_len(wrappers) {
            var w0 = wrappers[si0]
            if w0 != nil && w0["name"] != nil && w0["name"] != "" {
                var wnm = w0["name"]
                // Wrappers are compiler-synthesized; keep them clearly marked in stack traces.
                ctx["symtab_display"][wnm] = wnm + "@<generated>"
            }
            si0 = si0 + 1
        }

        // FFI stubs (deterministic: declaration order).
        var imports0 = ctx["import_list"]
        if imports0 != nil {
            var ii0 = 0
            while ii0 < oren_list_len(imports0) {
                var inm = imports0[ii0]
                if inm != nil && inm != "" {
                    ctx["symtab_display"][inm] = inm + "@<ffi>"
                }
                ii0 = ii0 + 1
            }
        }

        if want_resolve_symbol == true {
            // Reserve a symbol table region early so stack trace codegen can refer to it
            // with stable RIP-relative fixups. We fill the table later, after compilation
            // (when function code offsets are known).
            var sym_names = []
            var sym_seen = {}
            _x64_symtab_push_unique(sym_seen, sym_names, "__entry_stub__")
            _x64_symtab_push_unique(sym_seen, sym_names, "__top_level__")

            // If we used a cached compiled runtime object, the `fns` list only contains user functions.
            // Add runtime symbols from the cached meta so best-effort traces can resolve runtime frames too.
            if used_rtobj == true {
                var pend = ctx["rtobj_pending"]
                if pend != nil && pend["fn_offs_enc"] != nil {
                    var idxr = 0
                    var pairr = [nil, nil]
                    while 1 {
                        var okr = oren_iter_next_entry(pend["fn_offs_enc"], idxr, pairr)
                        if okr == 0 { break }
                        var rnm = pairr[0]
                        if rnm != nil && rnm != "" {
                            _x64_symtab_push_unique(sym_seen, sym_names, rnm)
                            if ctx["symtab_display"][rnm] == nil {
                                ctx["symtab_display"][rnm] = rnm + "@<runtime>"
                            }
                        }
                        idxr = idxr + 1
                    }
                }
            }

            // User functions (deterministic: source order).
            si0 = 0
            while si0 < oren_list_len(fns) {
                var fn1 = fns[si0]
                if fn1 != nil && fn1["name"] != nil && fn1["name"] != "" {
                    _x64_symtab_push_unique(sym_seen, sym_names, fn1["name"])
                }
                si0 = si0 + 1
            }
            // Wrappers (deterministic: synthesis order).
            si0 = 0
            while si0 < oren_list_len(wrappers) {
                var w1 = wrappers[si0]
                if w1 != nil && w1["name"] != nil && w1["name"] != "" {
                    _x64_symtab_push_unique(sym_seen, sym_names, w1["name"])
                }
                si0 = si0 + 1
            }
            // FFI stubs (deterministic: declaration order).
            if imports0 != nil {
                var ii1 = 0
                while ii1 < oren_list_len(imports0) {
                    var inm1 = imports0[ii1]
                    if inm1 != nil && inm1 != "" {
                        _x64_symtab_push_unique(sym_seen, sym_names, inm1)
                    }
                    ii1 = ii1 + 1
                }
            }

            _data_reserve_symtab(ctx, sym_names)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
        }
    }

    // --- Best-effort call-site line mapping (debug-only; rolling) ---
    //
    // Reserve a compact linetab for best-effort call-site mapping (optional, debug-only).
    if platform != nil && platform["debug"] == true && want_resolve_symbol == true {
        _data_reserve_linetab(ctx, 16384)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
    }

    // --- Stack safety (call depth guard; Tier‑1 parity) ---
    //
    // With runtime injection enabled (default), x64 uses the injected runtime hooks:
    // - `oren_call_depth_enter()` / `oren_call_depth_exit()` inserted by the function compiler
    //   (see `080_functions_compile.oren`)
    // - `native_runtime_call_depth_apply_env()` applied during `native_runtime_capsule_init()`

    // --- Entry stub ---
    //
    // Stack safety: call depth max config.
    //
    // With runtime injection enabled, call depth max is configured by the injected runtime
    // using envp (`native_runtime_call_depth_apply_env()`), so we do not parse env in the
    // entry stub.
    //
    var is_win = platform != nil && platform["os"] == "windows"
    var is_shared = platform != nil && platform["shared_lib"] == true
    var is_dll = is_win && is_shared
    var is_so = (is_win != true) && is_shared

    // Windows DLL entrypoint (DllMain) must behave like a normal Win64 ABI function:
    // - preserve non-volatile regs
    // - return BOOL in EAX
    // - do not clobber the call return address (so do NOT `and rsp, -16`)
    //
    // We only initialize on DLL_PROCESS_ATTACH (fdwReason==1, passed in EDX).
    var dll_labels = nil
    var dll_fixups = nil
    if is_dll {
        dll_labels = {}
        dll_fixups = []
        var l_dll_attach = _new_label(ctx, "dll_attach")
        // if (edx != 1) return TRUE;
        bytes_extend(ctx["code"], insn_cmp_r32_imm32(2, 1)) // cmp edx, 1
        _emit_jcc_to_label(ctx, dll_fixups, "e", l_dll_attach)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1)) // eax = TRUE
        bytes_extend(ctx["code"], insn_ret())
        _emit_label(ctx, dll_labels, l_dll_attach)

        // Preserve Win64 non-volatile regs. Our internal ABI excludes r14/r15 because they
        // are heap registers; external callers must still see them preserved.
        bytes_extend(ctx["code"], insn_push_r64(3))  // rbx
        bytes_extend(ctx["code"], insn_push_r64(5))  // rbp
        bytes_extend(ctx["code"], insn_push_r64(7))  // rdi
        bytes_extend(ctx["code"], insn_push_r64(6))  // rsi
        bytes_extend(ctx["code"], insn_push_r64(12)) // r12
        bytes_extend(ctx["code"], insn_push_r64(13)) // r13
        bytes_extend(ctx["code"], insn_push_r64(14)) // r14
        bytes_extend(ctx["code"], insn_push_r64(15)) // r15
    } else if is_so {
        // Linux shared library constructor entry:
        // - called as a normal SysV function (return address pushed), so do NOT smash RSP with `and rsp,-16`
        // - must preserve SysV callee-saved regs because the dynamic loader expects ABI correctness
        //
        // We will store heap state to `.data` spill slots before returning so exported ABI wrappers
        // can load it later.
        bytes_extend(ctx["code"], insn_push_r64(3))  // rbx
        bytes_extend(ctx["code"], insn_push_r64(5))  // rbp
        bytes_extend(ctx["code"], insn_push_r64(12)) // r12
        bytes_extend(ctx["code"], insn_push_r64(13)) // r13
        bytes_extend(ctx["code"], insn_push_r64(14)) // r14
        bytes_extend(ctx["code"], insn_push_r64(15)) // r15
    } else {
        // Save original RSP before aligning; needed later for argc/argv/envp capture on Linux.
        if platform == nil || platform["os"] != "windows" {
            bytes_extend(ctx["code"], insn_mov_r64_r64(13, 4)) // r13 = rsp (orig)
        }

        // Align stack to 16B boundary early so both SysV and Win64 calls stay well-formed as we grow
        // the x64 backend surface. After this point we must treat the stack as ABI-owned.
        bytes_extend(ctx["code"], insn_and_rsp_imm8(240)) // 0xF0 == -16
    }

    // call main
    //
    // Windows x64 ABI note:
    // - every call requires 32 bytes of shadow space allocated by the caller.
    // - calls with >4 args pass stack args at [rsp+0x20..], above the shadow space.
    //
    // Since our entrypoint is not a C runtime, we explicitly reserve the maximum
    // stack arg area we need before calling into WinAPI / injected runtime init.
    var entry_shadow = abi.caller_shadow_bytes(ctx["abi"])
    // Reserve stack-arg slots for WinAPI calls in the entry stub (WideCharToMultiByte uses 8 args).
    var entry_stack_args = 0
    if platform != nil && platform["os"] == "windows" && is_dll != true { entry_stack_args = 32 }
    // Shared-lib entry has RSP 8 mod 16 (return address pushed); do not smash RSP with `and`.
    // Add an explicit 8-byte pad so nested calls are 16B-aligned.
    var entry_align_pad = 0
    if is_dll || is_so { entry_align_pad = 8 }
    // Also reserve a small scratch region for entry-level values (argc/argv/envp).
    // Place scratch above the stack-arg area so calls with >4 args don't clobber it.
    // Windows note: we also keep a saved copy of the Win32 env block pointer so we can
    // free it after converting to a POSIX-style envp array.
    var entry_scratch = 48
    var entry_total = entry_shadow + entry_stack_args + entry_scratch + entry_align_pad
    if entry_total > 0 { bytes_extend(ctx["code"], insn_sub_rsp_imm32(entry_total)) }
    var scratch_base = entry_shadow + entry_stack_args + entry_align_pad

    if platform != nil && platform["os"] == "windows"  {
        if trace_entry { _emit_windows_write_cstr(ctx, "ENTRY: win begin") }
        if is_dll != true {
            _emit_entry_build_args_windows_x64(ctx, scratch_base)
            if trace_entry { _emit_windows_write_cstr(ctx, "ENTRY: win args ok") }
        } else {
            // DllMain: no argc/argv ABI. Default to argc=0, argv=nil.
            bytes_extend(ctx["code"], insn_mov_r64_imm64(0, 0)) // rax=0
            _emit_mov_mrsp_r64(ctx, scratch_base + 0, 0)  // argc
            _emit_mov_mrsp_r64(ctx, scratch_base + 8, 0)  // argv
            if trace_entry { _emit_windows_write_cstr(ctx, "ENTRY: win args skip (dll)") }
        }
        _emit_entry_capture_envblock_windows_x64(ctx, scratch_base)
        if trace_entry { _emit_windows_write_cstr(ctx, "ENTRY: win envblock ok") }
    }

    // Native heap registers (rolling Tier-1 design):
    //
    // Reserve two callee-saved registers as the global bump allocator state:
    // - R15: heap_ptr
    // - R14: heap_limit
    //
    // These are initialized to 0 so the first `malloc`/`malloc_raw` triggers the slow path
    // and maps/allocates a new chunk. External calls (WinAPI) and syscalls preserve R14/R15
    // by ABI convention (Linux syscalls clobber RCX/R11 only).
    bytes_extend(ctx["code"], insn_mov_r64_imm64(14, 0))
    bytes_extend(ctx["code"], insn_mov_r64_imm64(15, 0))

    // Stack-trace safety (Tier‑1 bring-up):
    //
    // Our entry stub is not a C runtime and does not set up an RBP frame chain.
    // If we call into compiled functions with an uninitialized RBP, the first compiled
    // function will save that garbage into its frame, and best-effort stack walking in
    // `oren_panic` can segfault when it follows the chain past `main`.
    //
    // Set RBP=0 before calling `main` so the chain terminates cleanly.
    bytes_extend(ctx["code"], insn_mov_r64_imm64(5, 0))

