        var labels_dbg = {}
        var fixups_dbg = []
        var l_skip_dbg = _new_label(ctx, "dbginfo_skip")
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
        _emit_jcc_to_label(ctx, fixups_dbg, "e", l_skip_dbg)

        // data_base = slot_addr - dbg_slot_off
        bytes_extend(ctx["code"], insn_mov_r64_r64(12, 10))
        bytes_extend(ctx["code"], insn_sub_r64_imm32(12, core.int_mod(dbg_slot_off, 4294967296)))
        // table_ptr = data_base + table_off
        bytes_extend(ctx["code"], insn_add_r64_r64(12, 11))

        // oren_set_debug_info(table_ptr, static_addr)
        // For x64 v0 fixed-base emitters, use static_addr=table_ptr (slide=0).
        if platform != nil && platform["os"] == "windows" {
            bytes_extend(ctx["code"], insn_mov_r64_r64(1, 12)) // rcx = table_ptr
            bytes_extend(ctx["code"], insn_mov_r64_r64(2, 12)) // rdx = table_ptr
        } else {
            bytes_extend(ctx["code"], insn_mov_r64_r64(7, 12)) // rdi = table_ptr
            bytes_extend(ctx["code"], insn_mov_r64_r64(6, 12)) // rsi = table_ptr
        }
        var call_dbg_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_dbg_pos, "name": "oren_set_debug_info"})
