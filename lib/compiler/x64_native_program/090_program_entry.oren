            if entry_total > 0 { bytes_extend(ctx["code"], insn_add_rsp_imm32(entry_total)) }
            // Restore non-volatile regs in reverse order.
            bytes_extend(ctx["code"], insn_pop_r64(15))
            bytes_extend(ctx["code"], insn_pop_r64(14))
            bytes_extend(ctx["code"], insn_pop_r64(13))
            bytes_extend(ctx["code"], insn_pop_r64(12))
            bytes_extend(ctx["code"], insn_pop_r64(6))
            bytes_extend(ctx["code"], insn_pop_r64(7))
            bytes_extend(ctx["code"], insn_pop_r64(5))
            bytes_extend(ctx["code"], insn_pop_r64(3))
