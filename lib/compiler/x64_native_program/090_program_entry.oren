            // Linux x86_64: exit_group(main_ret) via syscall (process-wide)
            // rdi = rax
            bytes_extend(ctx["code"], insn_mov_r64_r64(7, 0)) // mov rdi, rax
            // rax = SYS_exit_group
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, labi.linux_sys_exit_group()))
            bytes_extend(ctx["code"], insn_syscall())
            // Should not return; if it does, ret.
            if entry_total > 0 { bytes_extend(ctx["code"], insn_add_rsp_imm32(entry_total)) }
            bytes_extend(ctx["code"], insn_ret())
            ctx["entry_off"] = 0
        }
    }
    if trace_sum { t_entry_done = oren_time_now_ns() }

    // --- functions ---
    // Compile the synthesized top-level initializer function first so:
    // - its symbol exists for the entry stub call fixup, and
    // - stack traces can include a stable `__top_level__` frame when it panics.
    var top_fn = top_info["top_level_fn"]
    if top_fn == nil { err(ctx, "x64 native v0: missing synthesized __top_level__ fn"); return ctx }

    // If a runtime object is pending, splice its code after the entry stub now so
    // runtime functions resolve by name before compiling user code.
    if used_rtobj == true {
        _x64_rtobj_apply_code_to_ctx(ctx)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
    }
    if trace_sum { t_apply_rtobj_done = oren_time_now_ns() }

    if trace_prog { print("[x64_compile] compile __top_level__") }
    _compile_function_v0(ctx, top_fn, platform)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
    if trace_sum { t_top_done = oren_time_now_ns() }

    var i1 = 0
    var fns_n = oren_list_len(fns)
    while i1 < fns_n {
        var fn1 = fns[i1]
        var nm1 = nil
        if fn1 != nil { nm1 = fn1["name"] }
        if nm1 == nil || nm1 == "" { nm1 = "?" }
        if trace_prog && ((focus_enabled && i1 >= prog_focus_from && i1 < prog_focus_to) ||
                          (prog_stride > 0 && core.int_mod(i1, prog_stride) == 0)) {
            print("[x64_compile] fns " + oren_int_to_string(i1) + "/" + oren_int_to_string(fns_n) + " next=" + nm1)
        }
        var t_fn = 0
        if trace_prog { t_fn = oren_time_now_ns() }
        _compile_function_v0(ctx, fns[i1], platform)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
        if trace_prog && prog_slow_fn_ms > 0 {
            var dt_ms = (oren_time_now_ns() - t_fn) / 1000000
            if dt_ms > prog_slow_fn_ms { print("[x64_compile] slow_fn ms=" + oren_int_to_string(dt_ms) + " name=" + nm1) }
        }
        i1 = i1 + 1
    }
    if trace_sum { t_fns_done = oren_time_now_ns() }

    // Compile synthesized wrappers after user functions (order does not affect fixups, but
    // keeping them grouped makes debugging easier).
    var j1 = 0
    var wrappers_n = oren_list_len(wrappers)
    while j1 < wrappers_n {
        if trace_prog && core.int_mod(j1, 200) == 0 {
            print("[x64_compile] wrappers " + oren_int_to_string(j1) + "/" + oren_int_to_string(wrappers_n))
        }
        var wfn = wrappers[j1]
        var wnm = nil
        if wfn != nil { wnm = wfn["name"] }
        if wnm != nil && wnm != "" && ctx["functions"][wnm] != nil {
            j1 = j1 + 1
            continue
        }
        _compile_function_v0(ctx, wfn, platform)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
        j1 = j1 + 1
    }
    if trace_sum { t_wrappers_done = oren_time_now_ns() }

    // Ensure any missing fnwraps are synthesized and compiled.
    //
    // This is needed when:
    // - a cached runtime object (rtobj) is used, and
    // - the runtime object does not include all `__oren_fnwrap_*` wrappers, but user code
    //   references some runtime function as a first-class value.
    //
    // `fnwrap_needed` is populated during expression compilation (Identifier-as-value).
    var need2 = ctx["fnwrap_needed"]
    if need2 != nil {
        var wi2 = 0
    while wi2 < oren_list_len(ctx["func_decl_order"]) {
            var fname2 = ctx["func_decl_order"][wi2]
            if fname2 == nil || fname2 == "" { wi2 = wi2 + 1; continue }
            if need2[fname2] == nil { wi2 = wi2 + 1; continue }
            var wname2 = "__oren_fnwrap_" + fname2
            if ctx["functions"][wname2] == nil {
                var ar_enc2 = nil
                if ctx["func_arity"] != nil { ar_enc2 = ctx["func_arity"][fname2] }
                if ar_enc2 != nil {
                    var ar2 = ar_enc2 - 1
                    var vf2 = nil
                    if ctx["func_varargs_fixed"] != nil {
                        var vf_enc2 = ctx["func_varargs_fixed"][fname2]
                        if vf_enc2 != nil { vf2 = vf_enc2 - 1 }
                    }
                    var st2 = callable.synth_fnwrap(fname2, ar2, vf2)
                    if st2 != nil && st2["type"] == "ExprStmt" && st2["expr"] != nil && st2["expr"]["type"] == "Function" {
                        var wfn2 = st2["expr"]
                        // Keep stack traces readable even for late-synthesized wrappers.
                        if ctx["symtab_display"] != nil && ctx["symtab_display"][wname2] == nil {
                            ctx["symtab_display"][wname2] = wname2 + "@<generated>"
                        }
                        _compile_function_v0(ctx, wfn2, platform)
                        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
                    } else {
                        err(ctx, "x64 native v0: failed to synthesize fnwrap for " + fname2)
                        return ctx
                    }
                }
            }
            wi2 = wi2 + 1
        }
    }
    if trace_sum { t_fnwrap_done = oren_time_now_ns() }

    // --- FFI stubs ---
    //
    // Emit any backend stubs required for `ffi` symbols (Windows: real; Linux: stubbed).
    _x64_emit_ffi_stubs(ctx, platform)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // Emit shared panic helper after compiling user/runtime functions so:
    // - call-site fixups can resolve it by name, and
    // - we avoid inlining large panic sequences at every compiler-generated site.
    _emit_panic_helper_fn_if_needed_x64(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
    if trace_sum { t_panic_done = oren_time_now_ns() }


    var dbg_lam2 = oren_env("OREN_DEBUG_X64_LAMBDAS")
    if dbg_lam2 != nil {
        var mi = 0
        while mi < oren_list_len(ctx["lambda_defs"]) {
            var d1 = ctx["lambda_defs"][mi]
            var nm = nil
            if d1 != nil { nm = d1["name"] }
            if nm != nil && ctx["functions"][nm] == nil {
                print("DEBUG_X64_LAMBDAS missing_wrapper " + nm)
            }
            mi = mi + 1
        }
    }
    // Fill the symtab now that `ctx["functions"]` contains final offsets.
    _data_finalize_symtab(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // Fill the linetab now that code offsets are stable.
    _data_finalize_linetab(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // Fill the debug-info table now that code offsets are stable (debug builds only).
    _data_finalize_dbginfo_table(ctx, platform)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // Finalize the embedded-string table after all codegen so it includes:
    // - user literals
    // - injected runtime literals
    // - backend-emitted literal cstrs (panic helpers, etc)
    _data_finalize_cstr0_table(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    if trace_sum {
        t_finalize_done = oren_time_now_ns()
        var os = "unknown"
        var dbg = 0
        if platform != nil {
            if platform["os"] != nil { os = platform["os"] }
            if platform["debug"] == true { dbg = 1 }
        }
        var total_ms = (t_finalize_done - t0) / 1000000
        var rtobj_ms = (t_rtobj_done - t0) / 1000000
        var entry_ms = (t_entry_done - t_rtobj_done) / 1000000
        var apply_ms = (t_apply_rtobj_done - t_entry_done) / 1000000
        var top_ms = (t_top_done - t_apply_rtobj_done) / 1000000
        var fns_ms = (t_fns_done - t_top_done) / 1000000
        var wrappers_ms = (t_wrappers_done - t_fns_done) / 1000000
        var fnwrap_ms = (t_fnwrap_done - t_wrappers_done) / 1000000
        var panic_ms = (t_panic_done - t_fnwrap_done) / 1000000
        var finalize_ms = (t_finalize_done - t_panic_done) / 1000000
        var code_bytes = bytes_len(ctx["code"])
        var fx_n = 0
        if ctx["fixups"] != nil { fx_n = oren_list_len(ctx["fixups"]) }
        print("[x64_compile] os=" + os +
            " dbg=" + oren_int_to_string(dbg) +
            " used_rtobj=" + oren_int_to_string(used_rtobj == true) +
            " total_ms=" + oren_int_to_string(total_ms) +
            " rtobj_ms=" + oren_int_to_string(rtobj_ms) +
            " entry_ms=" + oren_int_to_string(entry_ms) +
            " apply_rtobj_ms=" + oren_int_to_string(apply_ms) +
            " top_ms=" + oren_int_to_string(top_ms) +
            " fns_ms=" + oren_int_to_string(fns_ms) +
            " wrappers_ms=" + oren_int_to_string(wrappers_ms) +
            " fnwrap_ms=" + oren_int_to_string(fnwrap_ms) +
            " panic_ms=" + oren_int_to_string(panic_ms) +
            " finalize_ms=" + oren_int_to_string(finalize_ms) +
            " code_bytes=" + oren_int_to_string(code_bytes) +
            " fixups_n=" + oren_int_to_string(fx_n))
    }

    return ctx
}

	fn native_emit_errors_and_exit(ctx) {
	    if ctx == nil { return nil }
	    var errs = ctx["errors"]
	    if errs == nil || oren_list_len(errs) == 0 { return nil }
    var i = 0
    while i < oren_list_len(errs) {
        var e = errs[i]
        if e != nil { print(e) }
        i = i + 1
    }
    oren_exit(1)
    return nil
}
