        return nil
    }
    if ctx["boot_globals_storage_off_enc"] == nil {
        err(ctx, "x64 native v0: missing boot globals storage offset (Tier-1 bootstrap)")
        return nil
    }
    var g_storage_off = ctx["globals"]["g_storage"] - 1
    var boot_off = ctx["boot_globals_storage_off_enc"] - 1

    // r10 = &g_storage_slot
    var lea_gs_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_gs_pos + 3, "data_off": g_storage_off})
    // r11 = &boot_globals_storage
    var lea_boot_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(11, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_boot_pos + 3, "data_off": boot_off})
    // *(g_storage_slot) = boot_base
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11))
    // Initialize singleton slots inside the boot storage.
    // r12 = boot + 392
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(12, 392))
    bytes_extend(ctx["code"], insn_mov_mr64_r64_disp(11, 368, 12))
    bytes_extend(ctx["code"], insn_add_r64_imm32(12, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64_disp(11, 376, 12))
    bytes_extend(ctx["code"], insn_add_r64_imm32(12, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64_disp(11, 384, 12))

    // Capture argc/argv/envp from the original SysV entry stack (Linux executables only).
    // We store them in the entry scratch region so subsequent calls cannot clobber them.
    if platform == nil || platform["os"] != "windows" {
        if is_so {
            // Shared library ctor: no argc/argv/envp ABI. Default to argc=0, argv=nil, envp=nil.
            bytes_extend(ctx["code"], insn_mov_r64_imm64(0, 0)) // rax=0
            _emit_mov_mrsp_r64(ctx, scratch_base + 0, 0)  // argc
            _emit_mov_mrsp_r64(ctx, scratch_base + 8, 0)  // argv
            _emit_mov_mrsp_r64(ctx, scratch_base + 16, 0) // envp
        } else {
            // r10 = argc
            bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 13))
            _emit_mov_mrsp_r64(ctx, scratch_base + 0, 10)

            // r11 = argv = orig_rsp + 8
            bytes_extend(ctx["code"], insn_mov_r64_r64(11, 13))
            bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
            _emit_mov_mrsp_r64(ctx, scratch_base + 8, 11)

            // r12 = envp = orig_rsp + (argc + 2) * 8
            bytes_extend(ctx["code"], insn_mov_r64_r64(12, 10))
            bytes_extend(ctx["code"], insn_add_r64_imm32(12, 2))
            bytes_extend(ctx["code"], insn_shl_r64_imm8(12, 3))
            bytes_extend(ctx["code"], insn_add_r64_r64(12, 13))
            _emit_mov_mrsp_r64(ctx, scratch_base + 16, 12)
