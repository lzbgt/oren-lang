    // (capsule init, env parsing, etc) can safely use string literals as map keys.
    //
    // Table pointer derivation (PIE-safe):
    // - slot_addr = &data[slot_off] (RIP-relative LEA)
    // - table_off = *(u64*)slot_addr
    // - data_base = slot_addr - slot_off
    // - table_ptr = data_base + table_off
    var slot_off_enc = ctx["cstr0_table_slot_enc"]
    if slot_off_enc != nil {
        var slot_off = slot_off_enc - 1
        // r10 = slot_addr
        var lea_slot_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_slot_pos + 3, "data_off": slot_off})
        // r11 = table_off (u64)
        bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 10))
        // r12 = data_base
        bytes_extend(ctx["code"], insn_mov_r64_r64(12, 10))
        bytes_extend(ctx["code"], insn_sub_r64_imm32(12, core.int_mod(slot_off, 4294967296)))
        // r12 = table_ptr
        bytes_extend(ctx["code"], insn_add_r64_r64(12, 11))
        // arg0 = table_ptr
        if platform != nil && platform["os"] == "windows" {
            bytes_extend(ctx["code"], insn_mov_r64_r64(1, 12)) // rcx
        } else {
            bytes_extend(ctx["code"], insn_mov_r64_r64(7, 12)) // rdi
        }
        var call_cstr_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_cstr_pos, "name": "oren_init_static_cstr0_table"})
        if trace_entry && platform != nil && platform["os"] == "windows" {
