// Compile minimal x64 program.
//
// Returns a ctx:
// - code: []byte
// - data: []byte (used by PE import table)
// - fixups: list of fixups for emitters (call_main, rip_data32)
// - functions: map name->offset
// - import_list: list of imports (for PE)
// - errors: list of strings

fn _emit_parse_u64_decimal_from_cstr_ptr_x64(ctx, start_ptr_reg, dst_reg, labels, local_fixups) {
    // Parse decimal digits at *(char*)start_ptr_reg into dst_reg (u64).
    //
    // Stops at first non-digit. Returns 0 if there are no digits.
    //
    // Clobbers: RAX, R10, R11
    if ctx == nil { return nil }
    bytes_extend(ctx["code"], insn_mov_r64_imm64(dst_reg, 0))
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, start_ptr_reg)) // r11 = cursor

    var l_loop = _new_label(ctx, "parse_u64_digits_loop")
    var l_done = _new_label(ctx, "parse_u64_digits_done")
    _emit_label(ctx, labels, l_loop)

    // eax = *(u8*)r11
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 11))
    // if eax < '0' => done
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 48))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_done)
    // if eax > '9' => done
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 57))
    _emit_jcc_to_label(ctx, local_fixups, "g", l_done)

    // eax -= '0'
    bytes_extend(ctx["code"], insn_sub_r32_imm32(0, 48))
    // dst = dst*10 + eax
    bytes_extend(ctx["code"], insn_imul_r64_imm32(dst_reg, 10))
    bytes_extend(ctx["code"], insn_movsxd_r64_r32(10, 0)) // r10 = digit
    bytes_extend(ctx["code"], insn_add_r64_r64(dst_reg, 10))

    // cursor++
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_loop)

    _emit_label(ctx, labels, l_done)
    return nil
}

fn _emit_entry_call_depth_env_override_linux_x64(ctx, orig_rsp_reg) {
    // Linux x86_64: parse initial stack envp for OREN_CALL_DEPTH_MAX=<n> and, if found,
    // override the call depth max global in the appended data blob.
    //
    // Entry stack layout (SysV):
    //   [rsp+0] argc (u64)
    //   [rsp+8] argv[0] (char*)
    //   ...
    //   [rsp+8*(argc)] argv[argc-1]
    //   [rsp+8*(argc+1)] NULL
    //   [rsp+8*(argc+2)] envp[0]
    //   ...
    //   NULL
    //
    // Requires:
    // - ctx["call_depth_max_off"] reserved by `_data_reserve_call_depth_guard`.
    //
    // Clobbers: RAX, RBX, R10, R11, R12, R14
    if ctx == nil { return nil }
    var off_max = ctx["call_depth_max_off"]
    if off_max == nil { return nil }

    var labels = {}
    var local_fixups = []

    // r10 = argc
    bytes_extend(ctx["code"], insn_mov_r64_mr64(10, orig_rsp_reg))
    // r10 = (argc + 2) * 8
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 2))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(10, 3))
    // r14 = envp cursor = orig_rsp + (argc+2)*8
    bytes_extend(ctx["code"], insn_mov_r64_r64(14, orig_rsp_reg))
    bytes_extend(ctx["code"], insn_add_r64_r64(14, 10))

    var prefix = "OREN_CALL_DEPTH_MAX="
    var pref_bytes = oren_bytes_from_string(prefix)

    var l_loop = _new_label(ctx, "envp_loop")
    var l_next = _new_label(ctx, "envp_next")
    var l_done = _new_label(ctx, "envp_done")

    _emit_label(ctx, labels, l_loop)
    // rbx = *(u64*)r14 (env string ptr)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(3, 14))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(3, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)

    // r12 = cursor into the env string
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 3))
    var pi = 0
    while pi < oren_list_len(pref_bytes) {
        var c = pref_bytes[pi]
        // eax = *(u8*)r12 ; cmp eax, c
        bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 12))
        bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, c))
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_next)
        bytes_extend(ctx["code"], insn_add_r64_imm32(12, 1))
        pi = pi + 1
    }

    // Matched prefix: parse digits at r12 into r8.
    // If the value is empty or non-decimal, ignore.
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 12))
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 48))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_next)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 57))
    _emit_jcc_to_label(ctx, local_fixups, "g", l_next)

    _emit_parse_u64_decimal_from_cstr_ptr_x64(ctx, 12, 8, labels, local_fixups)
    // If parsed value is 0, treat as "unlimited" (u64max).
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 0))
    var l_store = _new_label(ctx, "env_store_max")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_store)
    bytes_extend(ctx["code"], insn_mov_r64_imm64(8, -1))

    // Store to call_depth_max global: *(u64*)(&data[off_max]) = r8
    _emit_label(ctx, labels, l_store)
    var lea0 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea0 + 3, "data_off": off_max})
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 8))
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_next)
    bytes_extend(ctx["code"], insn_add_r64_imm32(14, 8)) // envp++
    _emit_jmp_to_label(ctx, local_fixups, l_loop)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_entry_call_depth_env_override_windows_x64(ctx) {
    // Windows x64: call GetEnvironmentVariableA("OREN_CALL_DEPTH_MAX", buf, n) and,
    // if present, parse decimal and override call depth max.
    //
    // Requires:
    // - PE emitter to import kernel32!GetEnvironmentVariableA and expose IAT label
    //   "IAT_GetEnvironmentVariableA".
    //
    // Clobbers: RAX, RCX, RDX, R8, R10, R11, R12
    if ctx == nil { return nil }
    var off_max = ctx["call_depth_max_off"]
    if off_max == nil { return nil }

    // Keep buffer in `.data` so we don't disturb stack layout (Win64 shadow is required per call).
    var off_name = _data_add_cstr0(ctx, "OREN_CALL_DEPTH_MAX")
    var buf_size = 64
    var off_buf = _data_add_zeros(ctx, buf_size)
    if off_name == nil || off_buf == nil { return nil }

    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "win_env_done")

    // r12 = &buf (preserve across the call; volatile regs can be clobbered)
    var lea_buf = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(12, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_buf + 3, "data_off": off_buf})

    // rcx = &name
    var lea_name = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(1, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_name + 3, "data_off": off_name})
    // rdx = &buf
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, 12))
    // r8d = buf_size
    bytes_extend(ctx["code"], insn_mov_r32_imm32(8, buf_size))

    // call GetEnvironmentVariableA via IAT
    var mov_iat = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat + 3, "data_label": "IAT_GetEnvironmentVariableA"})
    bytes_extend(ctx["code"], insn_call_rax())

    // if eax == 0 => not present
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)

    // Parse digits from buffer into r8.
    // If the value is empty or non-decimal, treat as not present.
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 12))
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 48))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_done)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 57))
    _emit_jcc_to_label(ctx, local_fixups, "g", l_done)

    _emit_parse_u64_decimal_from_cstr_ptr_x64(ctx, 12, 8, labels, local_fixups)
    // If parsed value is 0, treat as "unlimited" (u64max).
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 0))
    var l_store = _new_label(ctx, "win_env_store_max")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_store)
    bytes_extend(ctx["code"], insn_mov_r64_imm64(8, -1))

    // Store to call_depth_max global
    _emit_label(ctx, labels, l_store)
    var lea0 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea0 + 3, "data_off": off_max})
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 8))

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_entry_build_envp_windows_x64(ctx, scratch_base) {
    // Windows x64: build a minimal envp array for the injected native runtime.
    //
    // Why this exists:
    // - The native runtime’s env parsing (`native_envp_get_value_ptr`) expects a POSIX-style
    //   `envp` array of pointers to "KEY=VALUE\\0" strings.
    // - Windows does not provide `envp` at process entry, and we do not use a CRT.
    //
    // Strategy (rolling, deterministic, avoids extra imports):
    // - Probe a fixed list of runtime-relevant keys via GetEnvironmentVariableA.
    // - For each present key, write "KEY=VALUE\\0" into a fixed pool in `.data` and append a
    //   pointer to the envp array in `.data`.
    // - Terminate envp with a NULL entry.
    //
    // This is sufficient to make capsule/SIMD/GC/call-depth env overrides work on Tier‑1 Win64.
    //
    // NOTE:
    // - This is not a full env enumeration; it intentionally captures only keys we care about
    //   for runtime init and capsule enforcement.
    // - If the pool overflows, we abort deterministically (exit code 201).
    //
    // Requires:
    // - PE emitter imports kernel32!GetEnvironmentVariableA and exposes IAT label
    //   "IAT_GetEnvironmentVariableA".
    //
    // Clobbers: RAX, RBX, RCX, RDX, R8, R10, R11, R12, R13, R14, R15
    if ctx == nil { return nil }

    var keys = [
        // Stack safety / debug:
        "OREN_CALL_DEPTH_MAX",
        // Capsule toggles:
        "OREN_CAPSULE",
        "OREN_CAP_ALLOW_DOMAINS",
        // GC mode:
        "OREN_NO_GC",
        // SIMD toggles:
        "OREN_NO_SIMD",
        "OREN_ENABLE_SIMD",
        // Allocator policy:
        "OREN_RAW_MMAP_THRESHOLD",
        "OREN_BUF_ALIGN",
        "OREN_BUF_FORCE_MMAP",
        "OREN_BUF_PAYLOAD_LIMIT_BYTES",
        // FS policy:
        "OREN_FS_ALLOW_PREFIXES",
        "OREN_FS_ALLOW_READ_PREFIXES",
        "OREN_FS_ALLOW_WRITE_PREFIXES",
        "OREN_FS_MOUNTS",
        "OREN_FS_MOUNTS_READ",
        "OREN_FS_MOUNTS_WRITE",
        // NET policy:
        "OREN_NET_ALLOW_LOOPBACK",
        "OREN_NET_ALLOW_TCP_CONNECT",
        "OREN_NET_ALLOW_TCP_LISTEN",
        "OREN_NET_TCP_CONNECT_MAP",
        "OREN_NET_TCP_LISTEN_MAP",
        // PROC policy:
        "OREN_PROC_ALLOW_EXEC_PREFIXES",
        "OREN_PROC_ALLOW_SYSTEM",
        "OREN_PROC_INHERIT_ENV",
        "OREN_PROC_ALLOW_ENV_KEYS",
        "OREN_PROC_ALLOW_ARGV"
    ]

    var n = oren_list_len(keys)
    // envp array: (n+1) pointers
    var off_envp = _data_add_zeros(ctx, (n + 1) * 8)
    // pool for synthesized "KEY=VALUE\\0" strings (rolling: 64KiB is enough for runtime knobs)
    var pool_cap = 65536
    var off_pool = _data_add_zeros(ctx, pool_cap)
    if off_envp == nil || off_pool == nil { return nil }

    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "win_envp_done")
    var l_overflow = _new_label(ctx, "win_envp_overflow")

    // r13 = envp_cur = &envp[0]
    var lea_envp = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(13, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_envp + 3, "data_off": off_envp})

    // Persist envp pointer for runtime_set_envp (in the entry scratch region).
    _emit_mov_mrsp_r64(ctx, scratch_base + 16, 13)

    // Also store default argc/argv=0 for now (Windows args capture is a separate Tier‑1 item).
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrsp_r64(ctx, scratch_base + 0, 0)  // argc
    _emit_mov_mrsp_r64(ctx, scratch_base + 8, 0)  // argv

    // r12 = pool_cur = &pool[0]
    var lea_pool = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(12, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pool + 3, "data_off": off_pool})
    // r15 = pool_end = pool_cur + pool_cap
    bytes_extend(ctx["code"], insn_mov_r64_r64(15, 12))
    bytes_extend(ctx["code"], insn_add_r64_imm32(15, pool_cap))

    var ki = 0
    while ki < n {
        var k = keys[ki]
        var k_bytes = oren_bytes_from_string(k)
        var k_len = oren_list_len(k_bytes)

        var off_k = _data_add_cstr0(ctx, k)
        if off_k == nil { return nil }

        var l_next = _new_label(ctx, "win_envp_next_" + oren_int_to_string(ki))
        var l_have = _new_label(ctx, "win_envp_have_" + oren_int_to_string(ki))
        var l_ok = _new_label(ctx, "win_envp_ok_" + oren_int_to_string(ki))

        // rcx = &key
        var lea_k = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(1, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_k + 3, "data_off": off_k})

        // First probe: GetEnvironmentVariableA(key, NULL, 0) => required size (incl NUL) in eax, or 0 if missing.
        bytes_extend(ctx["code"], insn_mov_r32_imm32(2, 0)) // rdx = 0
        bytes_extend(ctx["code"], insn_mov_r32_imm32(8, 0)) // r8d = 0
        var mov_iat0 = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
        oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat0 + 3, "data_label": "IAT_GetEnvironmentVariableA"})
        bytes_extend(ctx["code"], insn_call_rax())

        // if eax == 0 => missing/empty => skip
        bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_next)

        // required_size_u64 in r14
        bytes_extend(ctx["code"], insn_cdqe())
        bytes_extend(ctx["code"], insn_mov_r64_r64(14, 0))

        // needed = required + (k_len + 1)   (includes KEY + '=' plus VALUE+NUL)
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 14)) // r10 = required
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, k_len + 1))

        // new_cur = pool_cur + needed
        bytes_extend(ctx["code"], insn_mov_r64_r64(11, 12)) // r11 = pool_cur
        bytes_extend(ctx["code"], insn_add_r64_r64(11, 10)) // r11 = new_cur
        // if new_cur > pool_end => overflow
        bytes_extend(ctx["code"], insn_cmp_r64_r64(11, 15))
        _emit_jcc_to_label(ctx, local_fixups, "le", l_ok)
        _emit_jmp_to_label(ctx, local_fixups, l_overflow)
        _emit_label(ctx, labels, l_ok)

        // Write "KEY=" prefix into pool_cur (unrolled byte stores).
        var bi = 0
        while bi < k_len {
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, k_bytes[bi]))
            bytes_extend(ctx["code"], insn_mov_mr8_al_disp(12, bi))
            bi = bi + 1
        }
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 61)) // '='
        bytes_extend(ctx["code"], insn_mov_mr8_al_disp(12, k_len))

        _emit_label(ctx, labels, l_have)
        // Second call: GetEnvironmentVariableA(key, pool_cur + k_len + 1, required_size)
        // Restore rcx = &key (Win64 ABI treats rcx as volatile; the first call can clobber it).
        var lea_k2 = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(1, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_k2 + 3, "data_off": off_k})
        // rdx = dest
        bytes_extend(ctx["code"], insn_mov_r64_r64(2, 12)) // rdx = pool_cur
        bytes_extend(ctx["code"], insn_add_r64_imm32(2, k_len + 1))
        // r8d = required_size (low 32 is fine)
        bytes_extend(ctx["code"], insn_mov_r32_r32(8, 14))

        var mov_iat1 = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
        oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat1 + 3, "data_label": "IAT_GetEnvironmentVariableA"})
        bytes_extend(ctx["code"], insn_call_rax())

        // Append pool_cur pointer to envp array: *envp_cur = pool_cur; envp_cur += 8
        bytes_extend(ctx["code"], insn_mov_mr64_r64(13, 12))
        bytes_extend(ctx["code"], insn_add_r64_imm32(13, 8))

        // Advance pool_cur = new_cur (r11 computed above)
        bytes_extend(ctx["code"], insn_mov_r64_r64(12, 11))

        _emit_label(ctx, labels, l_next)
        ki = ki + 1
    }

    // envp terminator: *envp_cur = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_mr64_r64(13, 0))
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_overflow)
    _emit_abort_exitcode(ctx, 201)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn native_compile_program_x64(linked, platform) {
    // Rolling: native runtime injection on x86_64 (default-on).
    //
    // Goal: converge with the ARM64 native backend, which injects `lib/runtime_native.oren`
    // (expanded from `lib/runtime_native/**`) into the compiled program.
    //
    // Default:
    // - x86_64 now injects the native runtime by default, matching arm64.
    //
    // Escape hatch (debug / bring-up):
    // - set `OREN_X64_NO_INJECT_RUNTIME=1` to disable runtime injection.
    //
    // Rationale:
    // - this is the primary architectural lever for removing x86_64 bring-up-only intrinsics
    //   and converging semantics across native backends.
    //
    // Implementation strategy (rolling):
    // - Parse the expanded runtime source into an AST program.
    // - Merge runtime statements ahead of user statements so function/var declarations are
    //   available to user code just like on arm64.
    // - Keep x64's existing intrinsics for now; as we converge, we will progressively replace
    //   intrinsic implementations with calls into injected runtime functions.

    var no_inject_runtime = oren_env("OREN_X64_NO_INJECT_RUNTIME")
    var inject_runtime = true
    if no_inject_runtime != nil && no_inject_runtime != "" && no_inject_runtime != "0" {
        inject_runtime = false
    }
    var linked2 = linked

    var ctx = {
        "code": bytes_new(),
        "data": bytes_new(),
        "fixups": [],
        "functions": {},
        "import_list": [],
        "errors": [],
        "platform": platform,
        // Global variable storage (top-level `var`).
        //
        // x64 native v0 stores globals as 8-byte slots in the appended data blob.
        // This is the minimum needed to:
        // - converge toward native runtime injection (runtime uses many globals initialized to 0),
        // - support Tier‑1 parity with backends that permit top-level `var`.
        //
        // Values are u64 slots holding the Oren value representation (rolling: tagged/pointer).
        "globals": {},
        // Named function declarations (name -> arity) collected before codegen.
        // Used for call arity checks and for first-class function values.
        "func_arity": {},
        // Named function varargs mapping (name -> fixed param count). Presence means varargs.
        "func_varargs_fixed": {},
        // Deterministic declaration order (source order). Used by some backends for wrapper synthesis.
        "func_decl_order": [],
        "declared_functions": {}
    }
    // Expose whether runtime injection is enabled so lowering can progressively
    // switch from x64 bring-up intrinsics to shared runtime helpers (Tier‑1 parity).
    ctx["inject_runtime"] = inject_runtime
    ctx["abi"] = abi.x64(platform)
    // Reserve minimal tracking globals early so appended data offsets are deterministic
    // regardless of when the first string literal is encountered during codegen.
    _data_reserve_tracked_allocs_head_x64(ctx)
    // Import aliases are used by shared callable lowering to avoid capturing module aliases.
    if linked != nil { ctx["aliases"] = linked["aliases"] }
    if ctx["aliases"] == nil { ctx["aliases"] = {} }
    // Lambda collection state (lambdas are parsed as Function nodes with name="").
    ctx["lambda_defs"] = []
    ctx["lambda_counter"] = 0

    // Runtime injection (default-on; see comment at top of function).
    if inject_runtime {
        var runtime_src = rtinj.runtime_expand_includes_file(ctx, "lib/runtime_native.oren", [])
        if runtime_src == nil { return ctx }
        // Debug aid: dump expanded runtime after include expansion, before parsing.
        var dump_runtime = oren_env("OREN_DUMP_NATIVE_RUNTIME")
        if dump_runtime != nil {
            var p = dump_runtime
            if p == "" { p = "build/runtime_native.expanded.oren" }
            oren_write_file(p, runtime_src)
        }
        var lrt = lexer.new_lexer(runtime_src)
        lrt["file"] = "lib/runtime_native.oren"
        var prt = parser.new_parser(lrt)
        var runtime_prog = parser.parse_program(prt)
        if oren_list_len(prt["errors"]) != 0 {
            err(ctx, "Parse errors in lib/runtime_native.oren")
            var ei = 0
            while ei < oren_list_len(prt["errors"]) {
                err(ctx, prt["errors"][ei])
                ei = ei + 1
            }
            return ctx
        }

        // Merge runtime statements ahead of user statements.
        // This ensures runtime vars and helper functions are visible during x64 codegen.
        var merged = []
        var rs = runtime_prog["statements"]
        if rs != nil {
            var ri = 0
            while ri < oren_list_len(rs) { oren_list_push(merged, rs[ri]); ri = ri + 1 }
        }
        var us = nil
        if linked != nil { us = linked["statements"] }
        if us != nil {
            var ui = 0
            while ui < oren_list_len(us) { oren_list_push(merged, us[ui]); ui = ui + 1 }
        }
        // Preserve DCE config from the original linked program where possible, but
        // also add extra roots needed by the entry stub (which is emitted after DCE
        // and thus cannot itself create AST references).
        var cfg0 = nil
        if linked != nil { cfg0 = linked["config"] }
        var cfg = {}
        if cfg0 != nil && cfg0["keep_all_top_level_functions"] == true {
            cfg["keep_all_top_level_functions"] = true
        }
        // Copy existing roots list (if any) so we don't mutate shared config state.
        var roots = []
        if cfg0 != nil && cfg0["roots"] != nil {
            var r0 = cfg0["roots"]
            var ri0 = 0
            while ri0 < oren_list_len(r0) { oren_list_push(roots, r0[ri0]); ri0 = ri0 + 1 }
        }
        // Entry-stub runtime init pipeline (Tier‑1 parity with arm64).
        //
        // These are referenced by the emitted entry stub machine code, not by AST,
        // so they must be pinned to survive global DCE after runtime injection.
        oren_list_push(roots, "native_runtime_init")
        oren_list_push(roots, "native_runtime_set_args")
        oren_list_push(roots, "native_runtime_set_envp")
        oren_list_push(roots, "native_runtime_capsule_init")
        oren_list_push(roots, "native_runtime_init_gc_mode")
        oren_list_push(roots, "oren_register_thread")
        cfg["roots"] = roots

        linked2 = {"statements": merged, "aliases": ctx["aliases"], "config": cfg}
        // Re-run whole-program DCE after injecting the runtime.
        //
        // The build pipeline already runs global DCE on the user program + imported modules,
        // but the native runtime injection happens inside this backend entrypoint and would
        // otherwise force compilation of the entire runtime regardless of reachability.
        //
        // This keeps Tier‑1 cross-compilation time bounded (important for the x64 backend),
        // and matches modern toolchains where unused stdlib/runtime code is removed.
        global_dce.lower_linked_program_in_place(linked2)
        ctx["runtime_injected"] = true
    }

    var fns = _extract_functions_v0(ctx, linked2)
    if fns == nil { return ctx }
    // Rolling parity with other backends:
    // - `fn main()` is optional; if absent, only `__top_level__` runs.
    var has_main = false
    if ctx["declared_functions"] != nil && ctx["declared_functions"]["main"] != nil { has_main = true }

    // --- Global vars + top-level statements (Tier‑1 convergence) ---
    //
    // Collect top-level `var` declarations into `ctx["globals"]` and build the statement list
    // that will run before `main` as a synthesized `__top_level__` function.
    //
    // We scan after function collection so we can reject global names that shadow functions.
    var top_info = _x64_collect_top_level_globals_and_stmts(ctx, linked2)
    if top_info == nil { return ctx }

    // Collect lambdas in function bodies before wrapper synthesis.
    var li = 0
    while li < oren_list_len(fns) {
        var fn0 = fns[li]
        if fn0 != nil && fn0["body"] != nil {
            callable.collect_lambdas_in_statement(ctx, fn0["body"])
        }
        li = li + 1
    }

    // --- Callable wrappers (Tier‑1 convergence) ---
    //
    // Synthesize `__oren_fnwrap_<name>` wrappers for all named functions so:
    // - function values (`var f = foo`) always point at a uniform-call entrypoint, and
    // - indirect calls (`f(x,y)`) can be lowered as `wrapper(env,args_list)`.
    //
    // Wrapper bodies are generated by the shared helper `native_callable.oren`.
    var wrappers = []
    var wi = 0
    while wi < oren_list_len(fns) {
        var fn0 = fns[wi]
        var nm0 = nil
        if fn0 != nil { nm0 = fn0["name"] }
        if nm0 != nil && nm0 != "" {
            var ar0 = nil
            if ctx["func_arity"] != nil { ar0 = ctx["func_arity"][nm0] }
            var vf0 = nil
            if ctx["func_varargs_fixed"] != nil { vf0 = ctx["func_varargs_fixed"][nm0] }
            if ar0 != nil {
                var st = callable.synth_fnwrap(nm0, ar0, vf0)
                if st != nil && st["type"] == "ExprStmt" && st["expr"] != nil && st["expr"]["type"] == "Function" {
                    oren_list_push(wrappers, st["expr"])
                } else {
                    err(ctx, "x64 native v0: failed to synthesize fnwrap for " + nm0)
                    return ctx
                }
            }
        }
        wi = wi + 1
    }

    // Lambda wrappers are named `__oren_lambda_N` and already implement the uniform call ABI:
    //   fn __oren_lambda_N(__env, __args_list) { ... }
    // They inline the original lambda body and bind captures/params from env/args.
    var lj = 0
    while lj < oren_list_len(ctx["lambda_defs"]) {
        var def = ctx["lambda_defs"][lj]
        var st = callable.synth_lambda_wrapper(def)
        if st != nil && st["type"] == "ExprStmt" && st["expr"] != nil && st["expr"]["type"] == "Function" {
            oren_list_push(wrappers, st["expr"])
        } else {
            err(ctx, "x64 native v0: failed to synthesize lambda wrapper")
            return ctx
        }
        lj = lj + 1
    }

    // --- Panic symbolication (best-effort) ---
    //
    // Reserve a symbol table region early so stack trace codegen can refer to it
    // with stable RIP-relative fixups. We fill the table later, after compilation
    // (when function code offsets are known).
    var sym_names = []
    // Display name mapping for stack traces:
    // - key: real function name (used to look up code offsets)
    // - value: display label (may include source location)
    //
    // This is intentionally "function definition location" (not call-site line mapping).
    ctx["symtab_display"] = {}
    oren_list_push(sym_names, "__entry_stub__")
    ctx["symtab_display"]["__entry_stub__"] = "__entry_stub__"
    // Top-level synthetic init frame.
    oren_list_push(sym_names, "__top_level__")
    ctx["symtab_display"]["__top_level__"] = "__top_level__@<top-level>"
    // User functions (deterministic: source order).
    var si0 = 0
    while si0 < oren_list_len(fns) {
        var fn0 = fns[si0]
        if fn0 != nil && fn0["name"] != nil && fn0["name"] != "" {
            var nm1 = fn0["name"]
            oren_list_push(sym_names, nm1)
            var disp = nm1
            var tok0 = fn0["token"]
            if tok0 != nil && tok0["file"] != nil && tok0["line"] != nil {
                disp = nm1 + "@" + tok0["file"] + ":" + oren_int_to_string(tok0["line"])
            }
            ctx["symtab_display"][nm1] = disp
        }
        si0 = si0 + 1
    }
    // Wrappers (deterministic: synthesis order).
    si0 = 0
    while si0 < oren_list_len(wrappers) {
        var w0 = wrappers[si0]
        if w0 != nil && w0["name"] != nil && w0["name"] != "" {
            var wnm = w0["name"]
            oren_list_push(sym_names, wnm)
            // Wrappers are compiler-synthesized; keep them clearly marked in stack traces.
            ctx["symtab_display"][wnm] = wnm + "@<generated>"
        }
        si0 = si0 + 1
    }
    _data_reserve_symtab(ctx, sym_names)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // --- Best-effort call-site line mapping (debug-only; rolling) ---
    //
    // Reserve a compact linetab for stack traces. This enables printing a call-site
    // `@file:line` in addition to the function definition location in `symtab_display`.
    if platform != nil && platform["debug"] == true {
        _data_reserve_linetab(ctx, 16384)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
    }

    // --- Stack safety (call depth guard; rolling Tier‑1) ---
    //
    // x64 native does not yet inject the full native runtime, so we keep a minimal
    // call-depth counter and max in the data blob and instrument function entry/exit.
    _data_reserve_call_depth_guard(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // --- Minimal tracking globals (rolling Tier‑1) ---
    //
    // Track embedded string pointers so map key-kind inference can safely decide
    // between int vs string without heuristics.
    _data_reserve_tracked_allocs_head_x64(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // --- Entry stub ---
    //
    // Tier‑1 stack safety: allow runtime override of the call depth max via:
    //   OREN_CALL_DEPTH_MAX=<n>
    //
    // This mirrors C/native-arm64 behavior and closes a gap in x64 bring-up.
    //
    // Linux: parse envp from the initial stack before stack alignment.
    // Win64: call GetEnvironmentVariableA (requires PE imports + Win64 shadow space).
    if platform == nil || platform["os"] != "windows" {
        // Save original RSP before aligning; SysV initial stack contains argc/argv/envp.
        bytes_extend(ctx["code"], insn_mov_r64_r64(13, 4)) // r13 = rsp (orig)
        _emit_entry_call_depth_env_override_linux_x64(ctx, 13)
    }

    // Align stack to 16B boundary early so both SysV and Win64 calls stay well-formed as we grow
    // the x64 backend surface. After this point we must treat the stack as ABI-owned.
    bytes_extend(ctx["code"], insn_and_rsp_imm8(240)) // 0xF0 == -16

    // call main
    //
    // Windows x64 ABI note: calls require 32 bytes of shadow space allocated by the caller.
    // Since our entrypoint is not a C runtime, we explicitly reserve it here.
    var entry_shadow = abi.caller_shadow_bytes(ctx["abi"])
    // Also reserve a small scratch region for entry-level values (argc/argv/envp on Linux).
    // On Win64, keep shadow space at [rsp+0..31] by placing scratch above it.
    var entry_scratch = 32
    var entry_total = entry_shadow + entry_scratch
    if entry_total > 0 { bytes_extend(ctx["code"], insn_sub_rsp_imm32(entry_total)) }
    var scratch_base = entry_shadow

    if platform != nil && platform["os"] == "windows" {
        _emit_entry_call_depth_env_override_windows_x64(ctx)
    }
    if platform != nil && platform["os"] == "windows" && inject_runtime {
        _emit_entry_build_envp_windows_x64(ctx, scratch_base)
    }

    // Native heap registers (rolling Tier-1 design):
    //
    // Reserve two callee-saved registers as the global bump allocator state:
    // - R15: heap_ptr
    // - R14: heap_limit
    //
    // These are initialized to 0 so the first `malloc`/`malloc_raw` triggers the slow path
    // and maps/allocates a new chunk. External calls (WinAPI) and syscalls preserve R14/R15
    // by ABI convention (Linux syscalls clobber RCX/R11 only).
    bytes_extend(ctx["code"], insn_mov_r64_imm64(14, 0))
    bytes_extend(ctx["code"], insn_mov_r64_imm64(15, 0))

    // Stack-trace safety (Tier‑1 bring-up):
    //
    // Our entry stub is not a C runtime and does not set up an RBP frame chain.
    // If we call into compiled functions with an uninitialized RBP, the first compiled
    // function will save that garbage into its frame, and best-effort stack walking in
    // `oren_panic` can segfault when it follows the chain past `main`.
    //
    // Set RBP=0 before calling `main` so the chain terminates cleanly.
    bytes_extend(ctx["code"], insn_mov_r64_imm64(5, 0))

    // --- Native runtime init (Tier‑1 parity with arm64) ---
    //
    // NOTE:
    // - The runtime is injected by default (see top of file), but entry stub calls are not part
    //   of the AST, so we pin the init symbols in global DCE via config["roots"] above.
    // - In bring-up mode (OREN_X64_NO_INJECT_RUNTIME=1), these functions may be absent; skip.
    if inject_runtime {
        // Convention (rolling):
        // - 1: macos
        // - 2: linux
        // - 3: windows
        var target_os_id = 2
        if platform != nil && platform["os"] == "windows" { target_os_id = 3 }

        // Capture argc/argv/envp from the original SysV entry stack (Linux only).
        // We store them in the entry scratch region so subsequent calls cannot clobber them.
        if platform == nil || platform["os"] != "windows" {
            // r10 = argc
            bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 13))
            _emit_mov_mrsp_r64(ctx, scratch_base + 0, 10)

            // r11 = argv = orig_rsp + 8
            bytes_extend(ctx["code"], insn_mov_r64_r64(11, 13))
            bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
            _emit_mov_mrsp_r64(ctx, scratch_base + 8, 11)

            // r12 = envp = orig_rsp + (argc + 2) * 8
            bytes_extend(ctx["code"], insn_mov_r64_r64(12, 10))
            bytes_extend(ctx["code"], insn_add_r64_imm32(12, 2))
            bytes_extend(ctx["code"], insn_shl_r64_imm8(12, 3))
            bytes_extend(ctx["code"], insn_add_r64_r64(12, 13))
            _emit_mov_mrsp_r64(ctx, scratch_base + 16, 12)
        }

        // native_runtime_init(target_os_id)
        if platform != nil && platform["os"] == "windows" {
            bytes_extend(ctx["code"], insn_mov_r32_imm32(1, target_os_id)) // rcx
        } else {
            bytes_extend(ctx["code"], insn_mov_r32_imm32(7, target_os_id)) // rdi
        }
        var call_init_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_init_pos, "name": "native_runtime_init"})

        // native_runtime_set_args(argc, argv)
        if platform != nil && platform["os"] == "windows" {
            _emit_mov_r64_mrsp(ctx, 1, scratch_base + 0) // rcx=argc
            _emit_mov_r64_mrsp(ctx, 2, scratch_base + 8) // rdx=argv
        } else {
            _emit_mov_r64_mrsp(ctx, 7, scratch_base + 0) // rdi=argc
            _emit_mov_r64_mrsp(ctx, 6, scratch_base + 8) // rsi=argv
        }
        var call_set_args_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_set_args_pos, "name": "native_runtime_set_args"})

        // native_runtime_set_envp(envp)
        if platform != nil && platform["os"] == "windows" {
            _emit_mov_r64_mrsp(ctx, 1, scratch_base + 16) // rcx=envp
        } else {
            _emit_mov_r64_mrsp(ctx, 7, scratch_base + 16) // rdi=envp
        }
        var call_set_envp_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_set_envp_pos, "name": "native_runtime_set_envp"})

        // native_runtime_capsule_init()
        var call_capsule_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_capsule_pos, "name": "native_runtime_capsule_init"})

        // native_runtime_init_gc_mode(default_enabled)
        var gc_default = 1
        if platform != nil && platform["no_gc"] == true { gc_default = 0 }
        if platform != nil && platform["os"] == "windows" {
            bytes_extend(ctx["code"], insn_mov_r32_imm32(1, gc_default)) // rcx
        } else {
            bytes_extend(ctx["code"], insn_mov_r32_imm32(7, gc_default)) // rdi
        }
        var call_gc_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_gc_pos, "name": "native_runtime_init_gc_mode"})

        // Register main thread for GC/stack safety.
        if platform != nil && platform["os"] == "windows" {
            bytes_extend(ctx["code"], insn_mov_r64_r64(1, 4)) // rcx = rsp
        } else {
            bytes_extend(ctx["code"], insn_mov_r64_r64(7, 4)) // rdi = rsp
        }
        var call_reg_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_reg_pos, "name": "oren_register_thread"})
    }

    // Run top-level statements (including non-constant global initializers) before `main`.
    //
    // This converges x64 behavior with the other backends while keeping the x64 v0
    // "fn main() required" rule.
    var call_top_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_top_pos, "name": "__top_level__"})

    if has_main {
        var call_pos = oren_list_len(ctx["code"])
        // placeholder rel32=0
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "main"})
    }

    if platform != nil && platform["os"] == "windows" {
        // Windows x64: ExitProcess(ret)
        //
        // - rcx = u32 exit code
        // - call [IAT ExitProcess]
        bytes_extend(ctx["code"], insn_mov_r32_r32(1, 0)) // mov ecx, eax

        var mov_iat_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0)) // patch disp32 to IAT slot
        oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat_pos + 3, "data_label": "IAT_ExitProcess"})
        bytes_extend(ctx["code"], insn_call_rax())
        // Should not return; if it does, just ret.
        if entry_total > 0 { bytes_extend(ctx["code"], insn_add_rsp_imm32(entry_total)) }
        bytes_extend(ctx["code"], insn_ret())
        // Record entrypoint offset (start of code).
        ctx["entry_off"] = 0
    } else {
        // Linux x86_64: exit(main_ret) via syscall
        // rdi = rax
        bytes_extend(ctx["code"], insn_mov_r64_r64(7, 0)) // mov rdi, rax
        // rax = 60 (SYS_exit)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 60))
        bytes_extend(ctx["code"], insn_syscall())
        // Should not return; if it does, ret.
        if entry_total > 0 { bytes_extend(ctx["code"], insn_add_rsp_imm32(entry_total)) }
        bytes_extend(ctx["code"], insn_ret())
        ctx["entry_off"] = 0
    }

    // --- functions ---
    // Compile the synthesized top-level initializer function first so:
    // - its symbol exists for the entry stub call fixup, and
    // - stack traces can include a stable `__top_level__` frame when it panics.
    var top_fn = top_info["top_level_fn"]
    if top_fn == nil { err(ctx, "x64 native v0: missing synthesized __top_level__ fn"); return ctx }
    _compile_function_v0(ctx, top_fn, platform)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    var i1 = 0
    while i1 < oren_list_len(fns) {
        _compile_function_v0(ctx, fns[i1], platform)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
        i1 = i1 + 1
    }

    // Compile synthesized wrappers after user functions (order does not affect fixups, but
    // keeping them grouped makes debugging easier).
    var j1 = 0
    while j1 < oren_list_len(wrappers) {
        _compile_function_v0(ctx, wrappers[j1], platform)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }
        j1 = j1 + 1
    }

    // Fill the symtab now that `ctx["functions"]` contains final offsets.
    _data_finalize_symtab(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    // Fill the linetab now that code offsets are stable.
    _data_finalize_linetab(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return ctx }

    return ctx
}

fn _x64_collect_top_level_globals_and_stmts(ctx, linked) {
    // Collect top-level `var` declarations as globals and build the statement list to run
    // before `main` (implemented as a synthesized `fn __top_level__(){...}`).
    //
    // Rolling rules:
    // - Every global is an 8-byte slot in the appended data blob.
    // - Constant init (Integer/Boolean/Nil) is stored directly into the data blob.
    // - Non-constant init is lowered as an `Assign` executed in `__top_level__`.
    //
    // This keeps the x64 backend usable for injecting more of `lib/runtime_native/**`
    // (which relies heavily on globals initialized to 0) without forcing immediate
    // full runtime injection in this turn.
    if ctx == nil { return nil }
    var stmts = nil
    if linked != nil { stmts = linked["statements"] }
    if stmts == nil { return {"top_level_fn": _x64_synth_top_level_fn([])} }

    var init_stmts = []
    var other_stmts = []

    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st == nil { i = i + 1; continue }

        // Skip function declarations (they are compiled separately).
        var fn0 = coreir._stmt_to_function_decl(st)
        if fn0 != nil { i = i + 1; continue }

        if st["type"] == "Var" {
            var name_node = st["name"]
            var v = st["value"]
            if name_node == nil || name_node["type"] != "Identifier" { err(ctx, "x64 native v0: global var name must be identifier"); return nil }
            var nm = name_node["value"]
            if nm == nil || nm == "" { err(ctx, "x64 native v0: global var name is empty"); return nil }
            if nm == "__top_level__" { err(ctx, "x64 native v0: reserved global name __top_level__"); return nil }
            if ctx["globals"] != nil && ctx["globals"][nm] != nil { err(ctx, "x64 native v0: duplicate global var " + nm); return nil }
            if ctx["declared_functions"] != nil && ctx["declared_functions"][nm] != nil {
                err(ctx, "x64 native v0: global var shadows function " + nm)
                return nil
            }
            if v == nil { err(ctx, "x64 native v0: global var init missing for " + nm); return nil }

            // Allocate storage slot.
            var init_bits = _x64_try_const_global_init_bits(v)
            var off = nil
            if init_bits != nil {
                off = _data_add_u64(ctx, init_bits)
            } else {
                off = _data_add_u64(ctx, 0)
                // Defer init into __top_level__ as an assignment to the global.
                oren_list_push(init_stmts, {"type": "Assign", "token": st["token"], "name": name_node, "value": v})
            }
            if off == nil { err(ctx, "x64 native v0: failed to allocate global var slot"); return nil }
            ctx["globals"][nm] = off
            i = i + 1
            continue
        }

        // Any other non-function statement is part of top-level execution.
        oren_list_push(other_stmts, st)
        i = i + 1
    }

    // Top-level exec order:
    // - non-const global initializers
    // - other top-level statements (expr/assign/control flow)
    var top_stmts = []
    var j = 0
    while j < oren_list_len(init_stmts) { oren_list_push(top_stmts, init_stmts[j]); j = j + 1 }
    j = 0
    while j < oren_list_len(other_stmts) { oren_list_push(top_stmts, other_stmts[j]); j = j + 1 }

    return {"top_level_fn": _x64_synth_top_level_fn(top_stmts)}
}

fn _x64_try_const_global_init_bits(expr) {
    // Return an i64/u64 bit-pattern to store into the global slot if the initializer
    // is a safe compile-time constant for x64 v0 globals.
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Integer" {
        return intparse.parse_int_lit(expr["value"])
    }
    if t == "Boolean" {
        if expr["value"] == "true" { return 1 }
        return 0
    }
    if t == "Nil" { return 0 }
    return nil
}

fn _x64_synth_top_level_fn(stmts) {
    // Synthesize: `fn __top_level__() { <stmts>; return 0 }`
    //
    // `_analyze_supported_fn_body` will append an implicit return if needed, but we keep
    // this explicit so the AST is well-formed even if that rule changes.
    if stmts == nil { stmts = [] }
    var out_stmts = []
    var i = 0
    while i < oren_list_len(stmts) { oren_list_push(out_stmts, stmts[i]); i = i + 1 }
    // Ensure a deterministic trailing return in the synthesized block.
    oren_list_push(out_stmts, {"type": "Return", "token": nil, "value": {"type": "Integer", "value": "0"}})
    return {
        "type": "Function",
        "token": nil,
        "name": "__top_level__",
        "params": [],
        "body": {"type": "Block", "stmts": out_stmts},
    }
}

fn native_emit_errors_and_exit(ctx) {
    if ctx == nil { return nil }
    var errs = ctx["errors"]
    if errs == nil || oren_list_len(errs) == 0 { return nil }
    var i = 0
    while i < oren_list_len(errs) {
        var e = errs[i]
        if e != nil { print(e) }
        i = i + 1
    }
    oren_exit(1)
    return nil
}
