    }

    // Register embedded debug-info table in debug builds (Tier‑1 debuggability).
    //
    // This enables runtime `oren_resolve_symbol(pc)` to resolve program PCs precisely without
    // depending on the coarser symtab-based `resolve_symbol(pc)` intrinsic.
    var dbg_slot_off_enc = ctx["dbginfo_table_slot_enc"]
    if dbg_slot_off_enc != nil {
        var dbg_slot_off = dbg_slot_off_enc - 1
        // slot_addr = &data[dbg_slot_off]
        var lea_dbg_slot_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0)) // r10 = slot_addr
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_dbg_slot_pos + 3, "data_off": dbg_slot_off})
        // table_off = *(u64*)slot_addr
        bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 10)) // r11 = table_off

