fn _x64_rtobj_symtab_compact_names(ctx) {
    var pend = ctx["rtobj_pending"]
    var rt_fn_compact = nil
    if pend != nil { rt_fn_compact = pend["fn_offsets_compact"] }
    var rt_names = nil
    if rt_fn_compact != nil { rt_names = rt_fn_compact["names"] }
    return rt_names
}

fn _x64_push_rtobj_symtab_name(ctx, sym_seen, sym_names, rnm) {
    if rnm == nil || rnm == "" { return nil }
    _x64_symtab_push_unique(sym_seen, sym_names, rnm)
    if ctx["symtab_display"][rnm] == nil {
        ctx["symtab_display"][rnm] = rnm + "@<runtime>"
    }
    return nil
}

fn _x64_push_rtobj_symtab_names_list(ctx, sym_seen, sym_names, rt_names) {
    var rn_i = 0
    var rn_len = oren_list_len(rt_names)
    while rn_i < rn_len {
        _x64_push_rtobj_symtab_name(ctx, sym_seen, sym_names, rt_names[rn_i])
        rn_i = rn_i + 1
    }
    return nil
}

fn _x64_push_rtobj_symtab_names_map(ctx, sym_seen, sym_names, enc_map) {
    var idxr = 0
    var pairr = [nil, nil]
    while 1 {
        var okr = oren_iter_next_entry(enc_map, idxr, pairr)
        if okr == 0 { break }
        _x64_push_rtobj_symtab_name(ctx, sym_seen, sym_names, pairr[0])
        idxr = idxr + 1
    }
    return nil
}

fn _x64_push_rtobj_symtab_names(ctx, sym_seen, sym_names) {
    var pend = ctx["rtobj_pending"]
    var rt_names = _x64_rtobj_symtab_compact_names(ctx)
    if rt_names != nil {
        _x64_push_rtobj_symtab_names_list(ctx, sym_seen, sym_names, rt_names)
    } else if pend != nil && pend["fn_offs_enc"] != nil {
        _x64_push_rtobj_symtab_names_map(ctx, sym_seen, sym_names, pend["fn_offs_enc"])
    }
    return nil
}

fn _x64_reserve_debug_symtab(ctx, fns, wrappers, imports0, used_rtobj) {
    // Reserve a symbol table region early so stack trace codegen can refer to it
    // with stable RIP-relative fixups. We fill the table later, after compilation
    // (when function code offsets are known).
    var sym_names = []
    var sym_seen = {}
    _x64_symtab_push_unique(sym_seen, sym_names, "__entry_stub__")
    _x64_symtab_push_unique(sym_seen, sym_names, "__top_level__")

    // If we used a cached compiled runtime object, the `fns` list only contains user functions.
    // Add runtime symbols from the cached meta so best-effort traces can resolve runtime frames too.
    if used_rtobj == true { _x64_push_rtobj_symtab_names(ctx, sym_seen, sym_names) }

    _x64_push_debug_function_names(sym_seen, sym_names, fns)
    _x64_push_debug_function_names(sym_seen, sym_names, wrappers)
    _x64_push_debug_import_names(sym_seen, sym_names, imports0)

    _data_reserve_symtab(ctx, sym_names)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    return true
}

fn _x64_push_debug_function_names(sym_seen, sym_names, fns) {
    var si0 = 0
    while si0 < oren_list_len(fns) {
        var fn1 = fns[si0]
        if fn1 != nil && fn1["name"] != nil && fn1["name"] != "" {
            _x64_symtab_push_unique(sym_seen, sym_names, fn1["name"])
        }
        si0 = si0 + 1
    }
    return nil
}

fn _x64_push_debug_import_names(sym_seen, sym_names, imports0) {
    if imports0 != nil {
        var ii1 = 0
        while ii1 < oren_list_len(imports0) {
            var inm1 = imports0[ii1]
            if inm1 != nil && inm1 != "" {
                _x64_symtab_push_unique(sym_seen, sym_names, inm1)
            }
            ii1 = ii1 + 1
        }
    }
    return nil
}

fn _x64_setup_program_debug_metadata(ctx, platform, fns, wrappers, used_rtobj, want_resolve_symbol) {
    if platform != nil && platform["debug"] == true {
        var imports0 = ctx["import_list"]
        _x64_setup_symtab_display(ctx, fns, wrappers, imports0)
        if want_resolve_symbol == true {
            if _x64_reserve_debug_symtab(ctx, fns, wrappers, imports0, used_rtobj) == nil { return nil }
        }
    }

    // Reserve a compact linetab for best-effort call-site mapping (optional, debug-only).
    if platform != nil && platform["debug"] == true && want_resolve_symbol == true {
        _data_reserve_linetab(ctx, 16384)
    }
    return nil
}

fn _x64_global_root_name_is_skipped(gname) {
    if gname == "g_gc_reuse_bad_list_last_ptr" { return true }
    if gname == "g_find_cache_ptr0" { return true }
    if gname == "g_find_cache_ptr1" { return true }
    if gname == "g_find_cache_node0" { return true }
    if gname == "g_find_cache_node1" { return true }
    return false
}

fn _x64_emit_traced_global_root_name(ctx, trace_root_names, gname, off, arg_reg, name_reg) {
    if trace_root_names != nil && trace_root_names != 0 && gname != nil {
        var name_off = _data_add_cstr0(ctx, gname)
        var lea_ptr_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(arg_reg, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_ptr_pos + 3, "data_off": off})
        var lea_name_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(name_reg, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_name_pos + 3, "data_off": name_off})
        var call_name_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], core.insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_name_pos, "name": "native_gc_register_root_name"})
    }
    return nil
}

fn _x64_global_root_vectors(ctx) {
    var root_names_src = ctx["global_root_names"]
    var root_offsets_src = ctx["global_root_offsets"]
    if root_names_src == nil || root_offsets_src == nil { return nil }
    if oren_list_len(root_names_src) != oren_list_len(root_offsets_src) { return nil }
    return {"names": root_names_src, "offsets": root_offsets_src}
}

fn _x64_vector_global_root_is_runtime(gname, gi, root_runtime_src, runtime_globals) {
    if root_runtime_src != nil && gi < oren_list_len(root_runtime_src) {
        if root_runtime_src[gi] == true { return true }
        return false
    }
    if gname != nil && runtime_globals != nil && runtime_globals[gname] != nil { return true }
    return false
}

fn _x64_should_skip_runtime_global_root(skip_runtime_globals, is_runtime_root) {
    if skip_runtime_globals != nil && skip_runtime_globals != 0 && is_runtime_root == true { return true }
    return false
}

fn _x64_append_collected_global_root(ctx, root_offsets, trace_root_names, gname, off, arg_reg, name_reg) {
    _x64_emit_traced_global_root_name(ctx, trace_root_names, gname, off, arg_reg, name_reg)
    oren_list_push(root_offsets, off)
    return nil
}

fn _x64_collect_global_roots_from_vectors(ctx, root_offsets, arg_reg, name_reg) {
    var vectors = _x64_global_root_vectors(ctx)
    if vectors == nil { return nil }
    var root_names_src = vectors["names"]
    var root_offsets_src = vectors["offsets"]

    var runtime_globals = ctx["runtime_globals"]
    var skip_runtime_globals = ctx["skip_runtime_global_roots"]
    var trace_root_names = ctx["trace_gc_root_names"]
    var root_runtime_src = ctx["global_root_is_runtime"]
    var roots_scanned = 0
        var gi = 0
        while gi < oren_list_len(root_offsets_src) {
            roots_scanned = roots_scanned + 1
            var gname = root_names_src[gi]
            if _x64_global_root_name_is_skipped(gname) == true {
                gi = gi + 1
                continue
            }
            var is_runtime_root = _x64_vector_global_root_is_runtime(gname, gi, root_runtime_src, runtime_globals)
            if _x64_should_skip_runtime_global_root(skip_runtime_globals, is_runtime_root) == true {
                gi = gi + 1
                continue
            }
            var off = root_offsets_src[gi]
            _x64_append_collected_global_root(ctx, root_offsets, trace_root_names, gname, off, arg_reg, name_reg)
            gi = gi + 1
        }
    return roots_scanned
}

fn _x64_collect_global_roots_from_map(ctx, root_offsets, arg_reg, name_reg) {
    var gmap = ctx["globals"]
    if gmap == nil { return 0 }
    var runtime_globals = ctx["runtime_globals"]
    var skip_runtime_globals = ctx["skip_runtime_global_roots"]
    var trace_root_names = ctx["trace_gc_root_names"]
    var roots_scanned = 0
        var gi2 = 0
        var pair = [nil, nil]
        while 1 {
            var okg = oren_iter_next_entry(gmap, gi2, pair)
            if okg == 0 { break }
            roots_scanned = roots_scanned + 1
            var gname = pair[0]
            if _x64_global_root_name_is_skipped(gname) == true {
                gi2 = gi2 + 1
                continue
            }
            if _x64_should_skip_runtime_global_root(skip_runtime_globals,
                gname != nil && runtime_globals != nil && runtime_globals[gname] != nil) == true {
                gi2 = gi2 + 1
                continue
            }
            var off_enc = pair[1]
            if oren_type_tag(off_enc) == 1 {
                var off = off_enc - 1
                _x64_append_collected_global_root(ctx, root_offsets, trace_root_names, gname, off, arg_reg, name_reg)
            }
            gi2 = gi2 + 1
        }
    return roots_scanned
}

fn _x64_append_global_root_table_data(ctx, root_offsets, root_count) {
    _data_align8(ctx)
    var root_table_off = bytes_len(ctx["data"])
    var ri = 0
    while ri < root_count {
        push_u64_le(ctx["data"], root_offsets[ri])
        ri = ri + 1
    }
    return root_table_off
}

fn _x64_new_global_root_loop_state(ctx) {
    return {
        "labels": {},
        "fixups": [],
        "loop": _new_label(ctx, "global_roots_loop"),
        "done": _new_label(ctx, "global_roots_done"),
    }
}

fn _x64_emit_global_root_loop_init(ctx, scratch_base, root_table_off, root_count) {
    // scratch[0] = cursor, scratch[8] = remaining, scratch[16] = data_base.
    var lea_roots_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(10, 0)) // r10 = &root_table[0]
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_roots_pos + 3, "data_off": root_table_off})
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(11, root_count)) // r11 = remaining
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 10)) // r12 = data_base
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(12, core.int_mod(root_table_off, 4294967296)))
    _emit_mov_mrsp_r64(ctx, scratch_base + 0, 10)
    _emit_mov_mrsp_r64(ctx, scratch_base + 8, 11)
    _emit_mov_mrsp_r64(ctx, scratch_base + 16, 12)
    return nil
}

fn _x64_emit_global_root_loop_header(ctx, scratch_base, st) {
    _emit_label(ctx, st["labels"], st["loop"])
    _emit_mov_r64_mrsp(ctx, 11, scratch_base + 8)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, st["fixups"], "e", st["done"])
    return nil
}

fn _x64_emit_global_root_loop_step(ctx, scratch_base, arg_reg, st) {
    _emit_mov_r64_mrsp(ctx, 10, scratch_base + 0)
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(13, 10)) // r13 = root offset
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 8))
    _emit_mov_mrsp_r64(ctx, scratch_base + 0, 10)
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(11, 1))
    _emit_mov_mrsp_r64(ctx, scratch_base + 8, 11)

    _emit_mov_r64_mrsp(ctx, 12, scratch_base + 16)
    bytes_extend(ctx["code"], core.insn_add_r64_r64(12, 13)) // r12 = root pointer
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(arg_reg, 12))
    var call_root_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_root_pos, "name": "native_gc_register_root"})
    _emit_jmp_to_label(ctx, st["fixups"], st["loop"])
    return nil
}

fn _x64_emit_global_root_table_loop(ctx, scratch_base, root_offsets, arg_reg) {
    var root_count = oren_list_len(root_offsets)
    if root_count <= 0 { return root_count }

    var root_table_off = _x64_append_global_root_table_data(ctx, root_offsets, root_count)
    var st = _x64_new_global_root_loop_state(ctx)
    _x64_emit_global_root_loop_init(ctx, scratch_base, root_table_off, root_count)
    _x64_emit_global_root_loop_header(ctx, scratch_base, st)
    _x64_emit_global_root_loop_step(ctx, scratch_base, arg_reg, st)
    _emit_label(ctx, st["labels"], st["done"])
    _patch_local_fixups(ctx, st["labels"], st["fixups"])
    return root_count
}

fn _x64_log_entry_global_roots(ctx, trace_prog, phase_log, roots_scanned, root_count) {
    if trace_prog { print("[x64_compile] global root registration done count=" + oren_int_to_string(roots_scanned)) }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.global_roots.done",
            "scanned=" + oren_int_to_string(roots_scanned) +
            " roots=" + oren_int_to_string(root_count) +
            " fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }
    return nil
}

fn _x64_emit_entry_global_roots(ctx, platform, scratch_base, trace_prog, phase_log) {
    // Register global slots as GC roots (native parity with C backend).
    // Do this after GC mode init so native_gc_register_root is active.
    //
    // Do not emit one `lea + call + fixup` sequence per global. Large self-hosted
    // compilers have thousands of globals, and that old strategy made x64 entry
    // generation/fixups dominate compile time. Match arm64: write root offsets to
    // `.data` and emit one tiny runtime loop over that table.
    var root_offsets = []
    var arg_reg = 7 // rdi
    var name_reg = 6 // rsi
    if platform != nil && platform["os"] == "windows" { arg_reg = 1 } // rcx
    if platform != nil && platform["os"] == "windows" { name_reg = 2 } // rdx
    if trace_prog { print("[x64_compile] global root registration start") }

    var roots_scanned = _x64_collect_global_roots_from_vectors(ctx, root_offsets, arg_reg, name_reg)
    if roots_scanned == nil {
        roots_scanned = _x64_collect_global_roots_from_map(ctx, root_offsets, arg_reg, name_reg)
    }
    var root_count = _x64_emit_global_root_table_loop(ctx, scratch_base, root_offsets, arg_reg)
    _x64_log_entry_global_roots(ctx, trace_prog, phase_log, roots_scanned, root_count)
    return nil
}
