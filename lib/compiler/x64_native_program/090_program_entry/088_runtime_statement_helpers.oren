// Runtime statement-set preparation helpers for x64 program entry.

fn _x64_injected_runtime_bundle_opts(runtime_path) {
    return {"runtime_path": runtime_path, "inject_runtime": true}
}

fn _x64_prepare_injected_runtime_bundle(ctx, linked, platform, runtime_path, trace_prog) {
    if trace_prog { print("[x64_compile] runtime bundle prepare") }
    var bun = bundle.prepare_native_runtime_bundle(ctx, "x64", linked, platform, _x64_injected_runtime_bundle_opts(runtime_path))
    if bun == nil { return nil }
    if trace_prog { print("[x64_compile] runtime bundle prepared") }
    return bun
}

fn _x64_statement_list_or_empty(stmts) {
    if stmts == nil { return [] }
    return stmts
}

fn _x64_pack_injected_runtime_statement_sets(ctx, bun) {
    ctx["runtime_injected"] = true
    return {
        "linked": bun["linked"],
        "runtime_stmts": _x64_statement_list_or_empty(bun["runtime_stmts"]),
        "user_stmts": _x64_statement_list_or_empty(bun["user_stmts"])
    }
}

fn _x64_prepare_injected_runtime_statement_sets(ctx, linked, platform, runtime_path, trace_prog) {
    var bun = _x64_prepare_injected_runtime_bundle(ctx, linked, platform, runtime_path, trace_prog)
    if bun == nil { return nil }
    return _x64_pack_injected_runtime_statement_sets(ctx, bun)
}

fn _x64_prepare_rtobj_runtime_statement_sets(ctx, linked, trace_prog) {
    if trace_prog { print("[x64_compile] runtime bundle skipped (rtobj)") }
    // Runtime already compiled into ctx; user statements come from the original program.
    // Mark as injected so lowering selects Tier-1 shared runtime paths (parity with arm64 and
    // with the non-rtobj injection path).
    ctx["runtime_injected"] = true
    var user_stmts = nil
    if linked != nil { user_stmts = linked["statements"] }
    return {"linked": linked, "runtime_stmts": [], "user_stmts": _x64_statement_list_or_empty(user_stmts)}
}

fn _x64_prune_runtime_statement_sets(ctx, linked2, platform, used_rtobj, trace_prog) {
    // Runtime pruning (size + compile time):
    // The injected native runtime branches on `g_target_os`, but for a target-specific
    // build those branches are compile-time constants. Prune unreachable runtime branches
    // early so the x64 backend does not compile dead platform code.
    if used_rtobj != true {
        if trace_prog { print("[x64_compile] runtime prune start") }
        pprune.prune_runtime_os_branches_in_linked_program_in_place(linked2, platform)
        if trace_prog { print("[x64_compile] runtime prune done") }
    }
    return nil
}

fn _x64_log_runtime_statement_sets(phase_log, runtime_stmts, user_stmts) {
    if phase_log != nil {
        var rt_stmts_n0 = 0
        var user_stmts_n0 = 0
        if runtime_stmts != nil { rt_stmts_n0 = oren_list_len(runtime_stmts) }
        if user_stmts != nil { user_stmts_n0 = oren_list_len(user_stmts) }
        _x64_program_phase_log_append(phase_log, "x64.codegen.runtime_prepare.done",
            "runtime_stmts=" + oren_int_to_string(rt_stmts_n0) +
            " user_stmts=" + oren_int_to_string(user_stmts_n0))
    }
    return nil
}

fn _x64_prepare_runtime_statement_sets(ctx, linked, platform, runtime_path, used_rtobj, trace_prog, phase_log) {
    var info = nil
    if used_rtobj == true {
        info = _x64_prepare_rtobj_runtime_statement_sets(ctx, linked, trace_prog)
    } else {
        info = _x64_prepare_injected_runtime_statement_sets(ctx, linked, platform, runtime_path, trace_prog)
    }
    if info == nil { return nil }

    _x64_prune_runtime_statement_sets(ctx, info["linked"], platform, used_rtobj, trace_prog)
    _x64_log_runtime_statement_sets(phase_log, info["runtime_stmts"], info["user_stmts"])
    return info
}
