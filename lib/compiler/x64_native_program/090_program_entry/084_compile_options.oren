fn _x64_env_enabled(name, default_value) {
    var v = oren_env(name)
    if v == nil || v == "" { return default_value }
    if x64_env_str_eq(v, "0") == true || x64_env_str_eq(v, "false") == true {
        return false
    }
    return true
}

fn _x64_program_progress_options(trace_prog) {
    var prog_stride = 200
    var prog_focus_from = -1
    var prog_focus_to = -1
    var prog_slow_fn_ms = 2000
    if trace_prog {
        prog_stride = core.parse_int_decimal(oren_env("OREN_TRACE_X64_COMPILE_STRIDE"), prog_stride)
        prog_focus_from = core.parse_int_decimal(oren_env("OREN_TRACE_X64_COMPILE_FOCUS_FROM"), prog_focus_from)
        prog_focus_to = core.parse_int_decimal(oren_env("OREN_TRACE_X64_COMPILE_FOCUS_TO"), prog_focus_to)
        prog_slow_fn_ms = core.parse_int_decimal(oren_env("OREN_TRACE_X64_SLOW_FN_MS"), prog_slow_fn_ms)
    }
    var focus_enabled = trace_prog && prog_focus_from >= 0 && prog_focus_to > prog_focus_from
    return {
        "prog_stride": prog_stride,
        "prog_focus_from": prog_focus_from,
        "prog_focus_to": prog_focus_to,
        "prog_slow_fn_ms": prog_slow_fn_ms,
        "focus_enabled": focus_enabled
    }
}

fn _x64_program_entry_options() {
    var trace_entry = _x64_env_enabled("OREN_TRACE_X64_ENTRY", false)
    var skip_register_thread = _x64_env_enabled("OREN_SKIP_REGISTER_THREAD", false)
    var exit_after_register_thread = _x64_env_enabled("OREN_ENTRY_EXIT_AFTER_REGISTER_THREAD", false)
    var skip_top_level = _x64_env_enabled("OREN_ENTRY_SKIP_TOP_LEVEL", false)
    var skip_main = _x64_env_enabled("OREN_ENTRY_SKIP_MAIN", false)
    var trace_entry_after_reg = _x64_env_enabled("OREN_TRACE_X64_ENTRY_AFTER_REG", true)
    return {
        "trace_entry": trace_entry,
        "skip_register_thread": skip_register_thread,
        "exit_after_register_thread": exit_after_register_thread,
        "skip_top_level": skip_top_level,
        "skip_main": skip_main,
        "trace_entry_after_reg": trace_entry_after_reg
    }
}

fn _x64_program_slow_fn_options(phase_log) {
    var trace_top_slow = oren_env("OREN_TRACE_X64_TOP_SLOW_FNS") != nil || phase_log != nil
    var top_slow_n = 20
    var top_slow_min_ms = 50
    var top_slow_live = false
    var top_slow_live_n = 20
    if trace_top_slow {
        top_slow_n = core.parse_int_decimal(oren_env("OREN_TRACE_X64_TOP_SLOW_FNS_N"), top_slow_n)
        top_slow_min_ms = core.parse_int_decimal(oren_env("OREN_TRACE_X64_TOP_SLOW_FNS_MIN_MS"), top_slow_min_ms)
        if top_slow_n < 1 { top_slow_n = 1 }
        if top_slow_n > 100 { top_slow_n = 100 }
        if top_slow_min_ms < 0 { top_slow_min_ms = 0 }
        top_slow_live_n = core.parse_int_decimal(oren_env("OREN_TRACE_X64_TOP_SLOW_FNS_LIVE_N"), top_slow_n)
        if top_slow_live_n < 1 { top_slow_live_n = 1 }
        if top_slow_live_n > 1000 { top_slow_live_n = 1000 }
        top_slow_live = _x64_env_enabled("OREN_TRACE_X64_TOP_SLOW_FNS_LIVE", false)
    }
    return {
        "trace_top_slow": trace_top_slow,
        "top_slow_n": top_slow_n,
        "top_slow_min_ms": top_slow_min_ms,
        "top_slow_live": top_slow_live,
        "top_slow_live_n": top_slow_live_n
    }
}

fn _x64_program_phase_detail_options(phase_log) {
    var fns_progress_interval = 250
    var fns_detail_limit = 0
    if phase_log != nil {
        fns_progress_interval = core.parse_int_decimal(oren_env("OREN_TRACE_X64_FNS_PROGRESS_INTERVAL"), fns_progress_interval)
        if fns_progress_interval < 1 { fns_progress_interval = 1 }
        if fns_progress_interval > 1000 { fns_progress_interval = 1000 }
        fns_detail_limit = core.parse_int_decimal(oren_env("OREN_TRACE_X64_FNS_DETAIL_LIMIT"), fns_detail_limit)
        if fns_detail_limit < 0 { fns_detail_limit = 0 }
        if fns_detail_limit > 200 { fns_detail_limit = 200 }
    }
    return {
        "fns_progress_interval": fns_progress_interval,
        "fns_detail_limit": fns_detail_limit
    }
}

fn _x64_program_compile_base_options(trace_sum, phase_log, trace_prog) {
    return {
        "trace_sum": trace_sum,
        "phase_log": phase_log,
        "trace_prog": trace_prog
    }
}

fn _x64_program_compile_add_progress_options(opts, progress_opts) {
    opts["prog_stride"] = progress_opts["prog_stride"]
    opts["prog_focus_from"] = progress_opts["prog_focus_from"]
    opts["prog_focus_to"] = progress_opts["prog_focus_to"]
    opts["prog_slow_fn_ms"] = progress_opts["prog_slow_fn_ms"]
    opts["focus_enabled"] = progress_opts["focus_enabled"]
    return opts
}

fn _x64_program_compile_add_entry_options(opts, entry_opts) {
    opts["trace_entry"] = entry_opts["trace_entry"]
    opts["skip_register_thread"] = entry_opts["skip_register_thread"]
    opts["exit_after_register_thread"] = entry_opts["exit_after_register_thread"]
    opts["skip_top_level"] = entry_opts["skip_top_level"]
    opts["skip_main"] = entry_opts["skip_main"]
    opts["trace_entry_after_reg"] = entry_opts["trace_entry_after_reg"]
    return opts
}

fn _x64_program_compile_add_slow_options(opts, slow_opts) {
    opts["trace_top_slow"] = slow_opts["trace_top_slow"]
    opts["top_slow_n"] = slow_opts["top_slow_n"]
    opts["top_slow_min_ms"] = slow_opts["top_slow_min_ms"]
    opts["top_slow_live"] = slow_opts["top_slow_live"]
    opts["top_slow_live_n"] = slow_opts["top_slow_live_n"]
    return opts
}

fn _x64_program_compile_add_phase_options(opts, phase_opts) {
    opts["fns_progress_interval"] = phase_opts["fns_progress_interval"]
    opts["fns_detail_limit"] = phase_opts["fns_detail_limit"]
    return opts
}

fn _x64_program_compile_options() {
    var trace_sum = oren_env("OREN_TRACE_X64_COMPILE_SUMMARY") != nil
    var phase_log = _x64_program_phase_log_path()
    var trace_prog = _x64_env_enabled("OREN_TRACE_X64_COMPILE_PROGRESS", false)
    var progress_opts = _x64_program_progress_options(trace_prog)
    var entry_opts = _x64_program_entry_options()
    var slow_opts = _x64_program_slow_fn_options(phase_log)
    var phase_opts = _x64_program_phase_detail_options(phase_log)

    var opts = _x64_program_compile_base_options(trace_sum, phase_log, trace_prog)
    _x64_program_compile_add_progress_options(opts, progress_opts)
    _x64_program_compile_add_entry_options(opts, entry_opts)
    _x64_program_compile_add_slow_options(opts, slow_opts)
    _x64_program_compile_add_phase_options(opts, phase_opts)
    return opts
}
