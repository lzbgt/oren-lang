// Keep a bounded descending list of slow function compiles.
//
// Intended for diagnosing x64 codegen hot spots without huge logs.
// Enable via:
//   OREN_TRACE_X64_TOP_SLOW_FNS=1
// Optional:
//   OREN_TRACE_X64_TOP_SLOW_FNS_N=20
//
// `top` shape: list<map{ms:int, name:string}>
fn _x64_slow_fn_top_entry(ms, nm) {
    if nm == nil || nm == "" { nm = "?" }
    return {"ms": ms, "name": nm}
}

fn _x64_slow_fn_top_skip_full(top, top_n, ms, n) {
    if n >= top_n {
        var last = top[n - 1]
        var last_ms = -1
        if last != nil && last["ms"] != nil { last_ms = last["ms"] }
        if ms <= last_ms { return true }
    }
    return false
}

fn _x64_slow_fn_top_insert_index(top, ms, n) {
    var i = 0
    while i < n {
        var cur = top[i]
        var cur_ms = -1
        if cur != nil && cur["ms"] != nil { cur_ms = cur["ms"] }
        if ms > cur_ms { break }
        i = i + 1
    }
    return i
}

fn _x64_slow_fn_top_insert(top, top_n, entry, i, n) {
    if n < top_n {
        oren_list_push(top, nil)
        var j = oren_list_len(top) - 1
        while j > i {
            top[j] = top[j - 1]
            j = j - 1
        }
        top[i] = entry
        return nil
    }

    var j2 = n - 1
    while j2 > i {
        top[j2] = top[j2 - 1]
        j2 = j2 - 1
    }
    if i < n { top[i] = entry }
    return nil
}

fn _x64_slow_fn_top_push(top, top_n, ms, nm) {
    if top == nil || top_n <= 0 { return nil }
    var n = oren_list_len(top)
    if _x64_slow_fn_top_skip_full(top, top_n, ms, n) == true { return nil }
    var entry = _x64_slow_fn_top_entry(ms, nm)
    var i = _x64_slow_fn_top_insert_index(top, ms, n)
    return _x64_slow_fn_top_insert(top, top_n, entry, i, n)
}
