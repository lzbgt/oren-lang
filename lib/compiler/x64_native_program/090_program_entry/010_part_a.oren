fn _x64_rtobj_apply_data_and_meta_to_ctx(ctx, meta) {
    // Apply the runtime object's `.data` and metadata to a fresh program ctx.
    //
    // IMPORTANT:
    // We apply `.data` early (so offsets remain stable), but defer splicing `.code` until
    // after the entry stub is emitted so the entrypoint stays at offset 0.
    if ctx == nil || meta == nil { return false }
    if ctx["errors"] == nil { ctx["errors"] = [] }
    var trace = oren_env("OREN_TRACE_X64_RTOBJ_APPLY") != nil
    if trace != true && oren_env("OREN_TRACE_X64_COMPILE_PROGRESS") != nil { trace = true }
    if trace { print("[x64_rtobj_apply] data/meta start") }
    var phase_log = _x64_program_phase_log_path()
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_data.start", "") }

    var want_prefix = rtobj.RUNTIME_OBJ_DATA_PREFIX_LEN
    var have_prefix = bytes_len(ctx["data"])
    if have_prefix != want_prefix {
        err(ctx, "x64 native v0: runtime obj expects data prefix len=" + oren_int_to_string(want_prefix) + ", got " + oren_int_to_string(have_prefix))
        return false
    }

    // Append runtime data tail (after the shared prefix slot).
    var data_tail = meta["data_tail_u8"]
    if data_tail != nil { bytes_extend_u8_buf(ctx["data"], data_tail) }
    if trace { print("[x64_rtobj_apply] data tail merged") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_data.tail.done",
            "data_bytes=" + oren_int_to_string(bytes_len(ctx["data"])))
    }

    // Merge runtime globals (name -> data_off+1).
    var meta_globals = meta["globals"]
    var adopted_globals = false
    var globals_n = 0
    if meta_globals != nil {
        globals_n = oren_map_len(meta_globals)
        if trace { print("[x64_rtobj_apply] globals merge start") }
        var meta_root_names = meta["global_root_names"]
        var meta_root_offsets = meta["global_root_offsets"]
        var meta_root_is_runtime = meta["global_root_is_runtime"]
        if meta_root_names != nil && meta_root_offsets != nil &&
           oren_list_len(meta_root_names) == oren_list_len(meta_root_offsets) {
            var cur_g_storage = nil
            if ctx["globals"] != nil { cur_g_storage = ctx["globals"]["g_storage"] }
            var meta_g_storage = meta_globals["g_storage"]
            if oren_type_tag(cur_g_storage) == 1 &&
               cur_g_storage == meta_g_storage &&
               meta_root_is_runtime != nil &&
               oren_list_len(meta_root_is_runtime) == oren_list_len(meta_root_offsets) {
                ctx["globals"] = meta_globals
                ctx["global_root_names"] = meta_root_names
                ctx["global_root_offsets"] = meta_root_offsets
                ctx["global_root_is_runtime"] = meta_root_is_runtime
                adopted_globals = true
            }
        }
        if phase_log != nil {
            var roots_n0 = 0
            if ctx["global_root_offsets"] != nil { roots_n0 = oren_list_len(ctx["global_root_offsets"]) }
            _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_data.rootmeta.done",
                "roots=" + oren_int_to_string(roots_n0) +
                " globals=" + oren_int_to_string(globals_n))
        }
        if adopted_globals != true {
            var idxg = 0
            var pairg = [nil, nil]
            while 1 {
                if phase_log != nil && idxg > 0 && core.int_mod(idxg, 128) == 0 {
                    _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_data.globals.progress",
                        "idx=" + oren_int_to_string(idxg) +
                        " total=" + oren_int_to_string(globals_n))
                }
                var okg = oren_iter_next_entry(meta_globals, idxg, pairg)
                if okg == 0 { break }
                var name = pairg[0]
                var off_enc = pairg[1]
                if name != nil && oren_type_tag(off_enc) == 1 {
                    var prev_global = ctx["globals"][name]
                    if oren_type_tag(prev_global) == 1 && prev_global != off_enc {
                        err(ctx, "x64 native v0: runtime obj global conflict " + name)
                    } else {
                        ctx["globals"][name] = off_enc
                        if meta_root_names == nil && ctx["global_root_names"] != nil { oren_list_push(ctx["global_root_names"], name) }
                        if meta_root_names == nil && ctx["global_root_offsets"] != nil { oren_list_push(ctx["global_root_offsets"], off_enc - 1) }
                        if meta_root_names == nil && ctx["global_root_is_runtime"] != nil { oren_list_push(ctx["global_root_is_runtime"], true) }
                    }
                }
                idxg = idxg + 1
            }
        }
        if trace { print("[x64_rtobj_apply] globals merge done count=" + oren_int_to_string(globals_n)) }
        if phase_log != nil {
            var adopted_s = "0"
            if adopted_globals == true { adopted_s = "1" }
            _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_data.globals.done",
                "count=" + oren_int_to_string(globals_n) +
                " adopted=" + adopted_s)
        }
    }

    // Merge runtime imports/FFI link names so emitters can resolve runtime external calls.
    var imp_rt = meta["import_list"]
    if imp_rt != nil {
        if trace { print("[x64_rtobj_apply] imports merge start count=" + oren_int_to_string(oren_list_len(imp_rt))) }
        if ctx["imports"] == nil { ctx["imports"] = {} }
        if ctx["import_list"] == nil { ctx["import_list"] = [] }
        var ii = 0
        while ii < oren_list_len(imp_rt) {
            var nm = imp_rt[ii]
            if nm != nil && nm != "" && ctx["imports"][nm] == nil {
                ctx["imports"][nm] = true
                oren_list_push(ctx["import_list"], nm)
            }
            ii = ii + 1
        }
        if trace { print("[x64_rtobj_apply] imports merge done") }
        if phase_log != nil {
            _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_data.imports.done",
                "count=" + oren_int_to_string(oren_list_len(imp_rt)))
        }
    }
    var ln = meta["ffi_link_names"]
    if ln != nil {
        if trace { print("[x64_rtobj_apply] ffi link merge start") }
        if ctx["ffi_link_names"] == nil { ctx["ffi_link_names"] = {} }
        var idxl = 0
        var pairl = [nil, nil]
        while 1 {
            var okl = oren_iter_next_entry(ln, idxl, pairl)
            if okl == 0 { break }
            var k = pairl[0]
            var v = pairl[1]
            if k != nil && v != nil {
                if ctx["ffi_link_names"][k] != nil && ctx["ffi_link_names"][k] != v {
                    err(ctx, "x64 native v0: runtime obj ffi_link_names conflict " + k)
                } else {
                    ctx["ffi_link_names"][k] = v
                }
            }
            idxl = idxl + 1
        }
        if trace { print("[x64_rtobj_apply] ffi link merge done count=" + oren_int_to_string(idxl)) }
    }

    // Merge runtime cstr0 dedup map (string -> off+1).
    //
    // PERF (stage2-native, x64 emit):
    // This map can be very large (all runtime string literals). Merging it on every build
    // adds measurable overhead even when the runtime object cache hits.
    //
    // Correctness:
    // - We MUST still merge `cstr0_list_enc` so the entry stub registers runtime literals.
    // - We do NOT need to merge the dedup map for correctness; skipping it only means user
    //   strings may duplicate bytes already present in the cached runtime data tail.
    //
    // Policy:
    // - Default: skip merging runtime `cstr0_offs` for throughput.
    // - Opt-in: set `OREN_X64_RT_OBJ_MERGE_CSTR0_OFFS=1` to merge and reduce binary size.
    var merge_cstr0_offs = oren_env("OREN_X64_RT_OBJ_MERGE_CSTR0_OFFS") != nil
    if merge_cstr0_offs && meta["cstr0_offs"] != nil {
        if trace { print("[x64_rtobj_apply] cstr0 offs merge start") }
        if ctx["cstr0_offs"] == nil { ctx["cstr0_offs"] = {} }
        var idxo = 0
        var pairo = [nil, nil]
        while 1 {
            var oko = oren_iter_next_entry(meta["cstr0_offs"], idxo, pairo)
            if oko == 0 { break }
            var k0 = pairo[0]
            var v0 = pairo[1]
            if k0 != nil && v0 != nil {
                if ctx["cstr0_offs"][k0] == nil {
                    ctx["cstr0_offs"][k0] = v0
                }
            }
            idxo = idxo + 1
        }
        if trace { print("[x64_rtobj_apply] cstr0 offs merge done count=" + oren_int_to_string(idxo)) }
    }

    // Keep runtime cstr0 offsets encoded until final data-table emission.
    //
    // Stage2-native x64 can spend disproportionate time in the eager decode+push merge
    // even for modest runtime literal tables. Stashing the encoded/u8 rtobj list matches the
    // arm64 rtobj path and leaves `ctx["cstr0_list"]` for user/backend-emitted literals only.
    if trace { print("[x64_rtobj_apply] cstr0 list stash start") }
    var c0_u8 = meta["cstr0_offsets_u8"]
    if c0_u8 != nil {
        ctx["rtobj_cstr0_offsets_u8"] = c0_u8
    }
    var c0 = meta["cstr0_list_enc"]
    if c0 != nil {
        ctx["rtobj_cstr0_list_enc"] = c0
    }
    if trace { print("[x64_rtobj_apply] cstr0 list stash done") }

    // Seed function metadata (for lambda capture analysis + wrapper synthesis + var shadow checks).
    if trace { print("[x64_rtobj_apply] function metadata seed start") }
    if meta["declared_functions"] != nil { ctx["declared_functions"] = meta["declared_functions"] }
    if meta["func_arity"] != nil { ctx["func_arity"] = meta["func_arity"] }
    if meta["func_varargs_fixed"] != nil { ctx["func_varargs_fixed"] = meta["func_varargs_fixed"] }
    if meta["func_decl_order"] != nil { ctx["func_decl_order"] = meta["func_decl_order"] }
    if trace { print("[x64_rtobj_apply] function metadata seed done") }

    // Prevent lambda wrapper name collisions with the cached runtime.
    var lc_enc = meta["lambda_counter_enc"]
    if lc_enc != nil {
        var lc = _rtobj_decode_int_enc(lc_enc)
        if lc != nil && lc >= 0 { ctx["lambda_counter"] = lc }
    }

    ctx["runtime_injected"] = true
    // Stash the full meta (including code_u8) for a later splice after entry stub emission.
    ctx["rtobj_pending"] = meta
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_data.done", "") }
    if trace { print("[x64_rtobj_apply] data/meta done") }
    return true
}

fn _x64_rtobj_string_eq(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    if oren_type_tag(a) != 4 { return false }
    if oren_type_tag(b) != 4 { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        var ba = oren_string_byte_at_unchecked(a, i) & 255
        var bb = oren_string_byte_at_unchecked(b, i) & 255
        if ba != bb { return false }
        i = i + 1
    }
    return true
}

fn _x64_rtobj_compact_mark_panic_helper_if_needed(ctx, fx) {
    if ctx == nil || fx == nil { return nil }
    var names = fx["call_name"]
    if names == nil { return nil }
    var helper_name = _x64_panic_helper_name()
    var i = 0
    while i < oren_list_len(names) {
        if _x64_rtobj_string_eq(names[i], helper_name) {
            // Runtime object code may contain compiler-generated abort sites that call the
            // shared panic helper. Mark it needed so the final program emits the helper
            // even when user code itself doesn't trigger a compiler panic path.
            ctx["need_panic_helper"] = true
            return nil
        }
        i = i + 1
    }
    return nil
}

fn _x64_rtobj_apply_code_to_ctx(ctx) {
    // Splice runtime `.code` after the entry stub and merge fixups/function offsets.
    if ctx == nil { return false }
    var meta = ctx["rtobj_pending"]
    if meta == nil { return false }
    if ctx["errors"] == nil { ctx["errors"] = [] }
    var trace = oren_env("OREN_TRACE_X64_RTOBJ_APPLY") != nil
    if trace != true && oren_env("OREN_TRACE_X64_COMPILE_PROGRESS") != nil { trace = true }
    var phase_log = ctx["phase_log"]

    var base_code = bytes_len(ctx["code"])
    if trace { print("[x64_rtobj_apply] start base_code=" + oren_int_to_string(base_code)) }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.start",
            "base_code=" + oren_int_to_string(base_code))
    }

    // Append runtime code.
    var code_u8 = meta["code_u8"]
    var code_n = -1
    if code_u8 != nil && oren_is_u8_buf(code_u8) == true { code_n = oren_buf_len(code_u8) }
    if trace {
        print("[x64_rtobj_apply] append code start bytes=" + oren_int_to_string(code_n))
    }
    if code_u8 != nil { bytes_extend_u8_buf(ctx["code"], code_u8) }
    if trace { print("[x64_rtobj_apply] append code done total_code=" + oren_int_to_string(bytes_len(ctx["code"]))) }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.append.done",
            "code_bytes=" + oren_int_to_string(code_n) +
            " total_code=" + oren_int_to_string(bytes_len(ctx["code"])))
    }

    // Merge runtime function code offsets (name -> off+1 encoding in meta).
    //
    // Prefer the compact parallel-list form. The legacy map is kept for older cache entries, but
    // repeatedly walking that map during stage2 x64 cache hits is a measurable bottleneck.
    var fn_compact = meta["fn_offsets_compact"]
    var fn_compact_names = nil
    var fn_compact_n = 0
    if fn_compact != nil {
        fn_compact_names = fn_compact["names"]
        if fn_compact_names != nil { fn_compact_n = oren_list_len(fn_compact_names) }
    }
    var fn_offs_enc = meta["fn_offs_enc"]
    if fn_compact_n > 0 {
        ctx["runtime_x64_fn_offsets_compact"] = fn_compact
        ctx["runtime_x64_fn_offsets_base_code"] = base_code
        var fn_compact_offs = fn_compact["offs_enc"]
        var hook_i = 0
        var hook_found = 0
        while hook_i < fn_compact_n && hook_found < 2 {
            var hook_name = fn_compact_names[hook_i]
            if hook_name == "oren_call_depth_enter" || hook_name == "oren_call_depth_exit" {
                var hook_off = nil
                if fn_compact_offs != nil { hook_off = _rtobj_decode_int_enc(fn_compact_offs[hook_i]) }
                if hook_off != nil {
                    if hook_name == "oren_call_depth_enter" { ctx["runtime_x64_call_depth_enter_off"] = base_code + hook_off }
                    else { ctx["runtime_x64_call_depth_exit_off"] = base_code + hook_off }
                    hook_found = hook_found + 1
                }
            }
            hook_i = hook_i + 1
        }
        if trace { print("[x64_rtobj_apply] function offsets compact attached count=" + oren_int_to_string(fn_compact_n)) }
        if phase_log != nil {
            _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.fn_offsets.done",
                "path=compact count=" + oren_int_to_string(fn_compact_n) +
                " hooks=" + oren_int_to_string(hook_found))
        }
    } else if fn_offs_enc != nil {
        if ctx["functions"] == nil { ctx["functions"] = {} }
        var fn_map_n = oren_map_len(fn_offs_enc)
        if trace { print("[x64_rtobj_apply] function offsets start count=" + oren_int_to_string(fn_map_n)) }
        var idxf = 0
        var pairf = [nil, nil]
        while 1 {
            if trace && idxf >= 0 && (idxf / 1000) * 1000 == idxf {
                print("[x64_rtobj_apply] function offset " + oren_int_to_string(idxf) + "/" + oren_int_to_string(fn_map_n))
            }
            var okf = oren_iter_next_entry(fn_offs_enc, idxf, pairf)
            if okf == 0 { break }
            var nm = pairf[0]
            var off_enc3 = pairf[1]
            var off3 = _rtobj_decode_int_enc(off_enc3)
            if nm != nil && off3 != nil {
                ctx["functions"][nm] = base_code + off3
            }
            idxf = idxf + 1
        }
        if trace { print("[x64_rtobj_apply] function offsets done count=" + oren_int_to_string(idxf)) }
        if phase_log != nil {
            _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.fn_offsets.done",
                "path=legacy count=" + oren_int_to_string(idxf))
        }
    } else if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.fn_offsets.done", "path=none count=0")
    }

    var x64_fx_compact = meta["x64_fixups_compact"]
    if x64_fx_compact != nil {
        ctx["runtime_x64_fixups_compact"] = x64_fx_compact
        if meta["fixups_compact_u8"] != nil { ctx["runtime_x64_fixups_compact_u8"] = meta["fixups_compact_u8"] }
        ctx["runtime_x64_fixups_base_code"] = base_code
        _x64_rtobj_compact_mark_panic_helper_if_needed(ctx, x64_fx_compact)
        if trace { print("[x64_rtobj_apply] compact fixups attached") }
        if phase_log != nil {
            var call_n0 = 0
            var call_xs0 = x64_fx_compact["call_pos_enc"]
            if call_xs0 != nil { call_n0 = oren_list_len(call_xs0) }
            var rip_n0 = 0
            var rip_xs0 = x64_fx_compact["rip_data_lea_pos_enc"]
            if rip_xs0 != nil { rip_n0 = rip_n0 + oren_list_len(rip_xs0) }
            rip_xs0 = x64_fx_compact["rip_data_lea_rsi_pos_enc"]
            if rip_xs0 != nil { rip_n0 = rip_n0 + oren_list_len(rip_xs0) }
            rip_xs0 = x64_fx_compact["rip_data_mov_rax_pos_enc"]
            if rip_xs0 != nil { rip_n0 = rip_n0 + oren_list_len(rip_xs0) }
            rip_xs0 = x64_fx_compact["rip_code_lea_pos_enc"]
            if rip_xs0 != nil { rip_n0 = rip_n0 + oren_list_len(rip_xs0) }
            rip_xs0 = x64_fx_compact["rip_rdata_lea_pos_enc"]
            if rip_xs0 != nil { rip_n0 = rip_n0 + oren_list_len(rip_xs0) }
            var fnobj_n0 = 0
            var fnobj_xs0 = x64_fx_compact["data_fnobj_code_ptr_data_off_enc"]
            if fnobj_xs0 != nil { fnobj_n0 = oren_list_len(fnobj_xs0) }
            _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.compact_fixups.done",
                "call=" + oren_int_to_string(call_n0) +
                " rip=" + oren_int_to_string(rip_n0) +
                " fnobj=" + oren_int_to_string(fnobj_n0))
        }
    }

    // Merge runtime fixups (pos encoded as +1; adjust by base_code).
    //
    // New x64 rtobj entries store the hot runtime fixups in `x64_fixups_compact`.
    // This fallback remains for unknown/new fixup types and for legacy cache entries.
    var fx = meta["fixups_enc"]
    if fx != nil {
        if trace { print("[x64_rtobj_apply] fixups start count=" + oren_int_to_string(oren_list_len(fx))) }
        var fi = 0
        var fx_n = oren_list_len(fx)
        while fi < fx_n {
            if trace && fi >= 0 && (fi / 1000) * 1000 == fi {
                print("[x64_rtobj_apply] fixup " + oren_int_to_string(fi) + "/" + oren_int_to_string(fx_n))
            }
            var f0 = fx[fi]
            if f0 != nil {
                var pos = _rtobj_decode_int_enc(f0["pos"])
                var data_off = _rtobj_decode_int_enc(f0["data_off"])
                if pos != nil {
                    if f0["type"] == "rip_data32" {
                        // Legacy caches may still store rip_data32 fixups in `fixups_enc`.
                        // Prefer collecting them into the compact `ctx["rip_data32_fixups"]` map.
                        var lab = f0["data_label"]
                        if lab != nil {
                            _x64_add_rip_data32_fixup(ctx, base_code + pos, lab)
                        }
                    } else {
                        if f0["type"] == "call_rel32" && f0["name"] == _x64_panic_helper_name() {
                            // Runtime object code may contain compiler-generated abort sites that call the
                            // shared panic helper. Mark it needed so the final program emits the helper
                            // even when user code itself doesn't trigger a compiler panic path.
                            ctx["need_panic_helper"] = true
                        }
                        // Mutate in-place to avoid allocating a new map per fixup (can be 10k+ entries).
                        //
                        // Safety:
                        // - `base_code + pos` is never 0 (entry stub is emitted first), so `pos` remains
                        //   representable even if some metadata encodings treat 0 as a sentinel.
                        f0["pos"] = base_code + pos
                        if data_off != nil { f0["data_off"] = data_off }
                        oren_list_push(ctx["fixups"], f0)
                    }
                }
            }
            fi = fi + 1
        }
        if trace { print("[x64_rtobj_apply] fixups done count=" + oren_int_to_string(fi)) }
        if phase_log != nil {
            _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.legacy_fixups.done",
                "count=" + oren_int_to_string(fi))
        }
    } else if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.legacy_fixups.done", "count=0")
    }

    // Preferred representation (rolling): rip_data32 positions aggregated by label.
    var r32 = meta["rip_data32_fixups_enc"]
    if r32 != nil {
        if trace { print("[x64_rtobj_apply] rip_data32 start") }
        var idx2 = 0
        var pair2 = [nil, nil]
        while 1 {
            var ok2 = oren_iter_next_entry(r32, idx2, pair2)
            if ok2 == 0 { break }
            var lab2 = pair2[0]
            var xs2 = pair2[1]
            if lab2 != nil && xs2 != nil {
                var i2 = 0
                while i2 < oren_list_len(xs2) {
                    var p_enc = xs2[i2]
                    var p0 = _rtobj_decode_int_enc(p_enc)
                    if p0 != nil { _x64_add_rip_data32_fixup(ctx, base_code + p0, lab2) }
                    i2 = i2 + 1
                }
            }
            idx2 = idx2 + 1
        }
        if trace { print("[x64_rtobj_apply] rip_data32 done labels=" + oren_int_to_string(idx2)) }
        if phase_log != nil {
            _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.rip_data32.done",
                "labels=" + oren_int_to_string(idx2))
        }
    } else if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.rip_data32.done", "labels=0")
    }

    ctx["rtobj_pending"] = nil
    if trace { print("[x64_rtobj_apply] done") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.apply_code.done",
            "code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])))
    }
    return true
}

fn _x64_rtobj_collect_function_meta(ctx, stmts, phase_log) {
    // Function metadata is required for lambda capture analysis and wrapper synthesis.
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.build.fnmeta.start", "") }
    var fns = coreir.collect_top_level_functions(ctx, {"statements": stmts}, "x64 native rtobj")
    if fns == nil { return nil }
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.build.fnmeta.done",
            "fns=" + oren_int_to_string(oren_list_len(fns)))
    }
    return fns
}

fn _x64_rtobj_rewrite_and_collect_lambdas(ctx, stmts, phase_log) {
    // Normalize nested `fn name(...)` to lambdas+vars for Tier-1 parity.
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.build.lambdas.start", "") }
    callable.rewrite_local_fn_decls_in_stmt_list(ctx, stmts)

    // Collect lambdas from the runtime so wrapper naming does not collide later.
    var li = 0
    while li < oren_list_len(stmts) {
        callable.collect_lambdas_in_statement(ctx, stmts[li])
        li = li + 1
    }
    if phase_log != nil {
        var lambda_n = 0
        if ctx["lambda_defs"] != nil { lambda_n = oren_list_len(ctx["lambda_defs"]) }
        _x64_program_phase_log_append(phase_log, "x64.rtobj.build.lambdas.done",
            "lambdas=" + oren_int_to_string(lambda_n))
    }
    return true
}

fn _x64_rtobj_split_runtime_vars(ctx, stmts, phase_log) {
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.build.split.start", "") }
    var split = nt.split_tier1_runtime_user(ctx, "x64 native rtobj", stmts, [], ctx["declared_functions"])
    if split == nil { return nil }
    var runtime_vars = split["runtime_vars"]
    if runtime_vars == nil { runtime_vars = [] }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.build.split.done",
            "runtime_vars=" + oren_int_to_string(oren_list_len(runtime_vars)))
    }
    return runtime_vars
}

fn _x64_rtobj_allocate_runtime_globals(ctx, runtime_vars, phase_log) {
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.build.globals.start", "") }
    var vi = 0
    while vi < oren_list_len(runtime_vars) {
        var st = runtime_vars[vi]
        if st != nil {
            var nm = st["name"]["value"]
            if nm == nil || nm == "" { err(ctx, "x64 native rtobj: runtime global var missing name"); return false }
            // `g_storage` is reserved in the native entry stub `.data` prefix (Tier-1 bootstrap).
            if nm == "g_storage" && ctx["globals"] != nil && ctx["globals"][nm] != nil { vi = vi + 1; continue }
            if ctx["globals"] != nil && ctx["globals"][nm] != nil {
                err(ctx, "x64 native rtobj: duplicate global var " + nm)
                return false
            }
            var off0 = _data_add_u64(ctx, 0)
            ctx["globals"][nm] = off0 + 1
            if ctx["global_root_names"] != nil { oren_list_push(ctx["global_root_names"], nm) }
            if ctx["global_root_offsets"] != nil { oren_list_push(ctx["global_root_offsets"], off0) }
            if ctx["global_root_is_runtime"] != nil { oren_list_push(ctx["global_root_is_runtime"], true) }
        }
        vi = vi + 1
    }
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.build.globals.done",
            "runtime_vars=" + oren_int_to_string(oren_list_len(runtime_vars)))
    }
    return true
}

fn _x64_build_runtime_obj(platform, runtime_path, runtime_hash, backend_sig, phase_log) {
    // Compile the injected native runtime into a reusable object blob for x86_64 native.
    //
    // Bounded tracing (perf guardrails; avoid huge logs):
    // - OREN_TRACE_X64_RT_OBJ_SUMMARY=1: single-line phase breakdown
    // - OREN_TRACE_X64_RT_OBJ_TOP_DECLS=1: keep only slowest N decls by compile time
    // Env toggles must treat "" as unset too (stage1 C-backend env compatibility).
    var trace_sum = false
    var v_sum = oren_env("OREN_TRACE_X64_RT_OBJ_SUMMARY")
    if v_sum != nil && v_sum != "" { trace_sum = true }
    var t0 = 0
    var t_parse_done = 0
    var t_meta_done = 0
    var t_lambda_done = 0
    var t_split_done = 0
    var t_globals_done = 0
    var t_decls_done = 0
    var t_wrap_done = 0
    var t_finalize_done = 0
    if trace_sum { t0 = oren_time_now_ns() }

    var linked0 = {"statements": [], "aliases": {}, "type_ns": {}}
    var ctx = _x64_new_ctx(linked0, platform)
    // Runtime object compilation must behave like "runtime injected" mode so runtime code
    // can use Tier‑1 lowering paths (Index semantics, etc) that depend on runtime helpers.
    ctx["runtime_injected"] = true

    var trace = rtobj.rtobj_trace_enabled()

    // Avoid having any real function start at code offset 0.
    // Some metadata encodings are 1-based and decoded via `enc-1`.
    bytes_push(ctx["code"], 144) // 0x90 (NOP)

    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.build.parse.start", "") }
    var prog = bundle.load_and_parse_runtime_native_for_platform(ctx, runtime_path, platform)
    if prog == nil { return nil }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.build.parse.done", "") }
    if trace_sum { t_parse_done = oren_time_now_ns() }

    var stmts = prog["statements"]
    if stmts == nil { stmts = [] }

    var fns = _x64_rtobj_collect_function_meta(ctx, stmts, phase_log)
    if fns == nil { return nil }
    if trace_sum { t_meta_done = oren_time_now_ns() }

    if _x64_rtobj_rewrite_and_collect_lambdas(ctx, stmts, phase_log) != true { return nil }
    if trace_sum { t_lambda_done = oren_time_now_ns() }

    // Allocate runtime globals (zero-initialized; runtime init owns their values).
    var runtime_vars = _x64_rtobj_split_runtime_vars(ctx, stmts, phase_log)
    if runtime_vars == nil { return nil }
    if trace_sum { t_split_done = oren_time_now_ns() }

    if _x64_rtobj_allocate_runtime_globals(ctx, runtime_vars, phase_log) != true { return nil }
    if trace_sum { t_globals_done = oren_time_now_ns() }

    // Compile runtime named functions.
    var trace_decls = false
    var v_decls = oren_env("OREN_TRACE_X64_RT_OBJ_TOP_DECLS")
    if v_decls != nil && v_decls != "" { trace_decls = true }
    var top_decls = nil
    var top_keep = 12
    var sum_decl_ns = 0
    if trace_decls { top_decls = [] }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.build.decls.start",
            "fns=" + oren_int_to_string(oren_list_len(fns)))
    }
    var call_depth_default_enabled = _x64_call_depth_default_enabled(platform)
    var i = 0
    while i < oren_list_len(fns) {
        if phase_log != nil && i > 0 && core.int_mod(i, 250) == 0 {
            _x64_program_phase_log_append(phase_log, "x64.rtobj.build.decls.progress",
                "i=" + oren_int_to_string(i) +
                " total=" + oren_int_to_string(oren_list_len(fns)))
        }
        var t_decl0 = 0
        if trace_decls { t_decl0 = oren_time_now_ns() }
        _compile_function_v0(ctx, fns[i], platform, false, call_depth_default_enabled)
        if trace_decls {
            var dt_decl = oren_time_now_ns() - t_decl0
            sum_decl_ns = sum_decl_ns + dt_decl
            // Keep only the slowest `top_keep` decls to avoid huge logs.
            var fn0 = fns[i]
            var nm0 = ""
            if fn0 != nil {
                var n0 = fn0["name"]
                if n0 != nil {
                    if oren_is_string(n0) == true { nm0 = n0 }
                    else if n0["value"] != nil { nm0 = n0["value"] }
                }
            }
            var ent = {"ns": dt_decl, "type": "Function", "name": nm0}
            if oren_list_len(top_decls) < top_keep {
                oren_list_push(top_decls, ent)
            } else {
                var min_idx = 0
                var min_ns = 0
                if top_decls[0] != nil && top_decls[0]["ns"] != nil {
                    min_ns = top_decls[0]["ns"]
                } else {
                    // Defensive: should not happen, but avoid panicking in trace mode.
                    min_ns = dt_decl
                }
                var j0 = 1
                while j0 < oren_list_len(top_decls) {
                    var e0 = top_decls[j0]
                    if e0 != nil && e0["ns"] != nil && e0["ns"] < min_ns {
                        min_ns = e0["ns"]
                        min_idx = j0
                    }
                    j0 = j0 + 1
                }
                if dt_decl > min_ns { top_decls[min_idx] = ent }
            }
        }
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
            if trace { print("[rtobj] x64 build failed (compile runtime fn): " + ctx["errors"][0]) }
            return nil
        }
        i = i + 1
    }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.build.decls.done",
            "fns=" + oren_int_to_string(oren_list_len(fns)))
    }
    if trace_sum { t_decls_done = oren_time_now_ns() }

    // Synthesize only wrappers needed by the runtime itself:
    // - named functions used as first-class values (tracked in ctx["fnwrap_needed"])
    // - lambda wrappers (always needed when a lambda literal exists)
    callable.collect_named_fn_value_uses_in_stmt_list(ctx, stmts)
    var wrappers = []
    var need = ctx["fnwrap_needed"]
    var wi = 0
    while wi < oren_list_len(ctx["func_decl_order"]) {
        var nm0 = ctx["func_decl_order"][wi]
        if nm0 == nil || nm0 == "" { wi = wi + 1; continue }
        if need == nil || need[nm0] == nil { wi = wi + 1; continue }

        var ar0 = nil
        if ctx["func_arity"] != nil {
        var ar0_enc = ctx["func_arity"][nm0]
        if oren_type_tag(ar0_enc) != 0 { ar0 = ar0_enc - 1 }
    }
    var vf0 = nil
    if ctx["func_varargs_fixed"] != nil {
        var vf0_enc = ctx["func_varargs_fixed"][nm0]
        if oren_type_tag(vf0_enc) != 0 { vf0 = vf0_enc - 1 }
    }
        if ar0 != nil {
            var stw = callable.synth_fnwrap(nm0, ar0, vf0)
            if stw != nil && stw["type"] == "ExprStmt" && stw["expr"] != nil && stw["expr"]["type"] == "Function" {
                oren_list_push(wrappers, stw["expr"])
            } else {
                err(ctx, "x64 native rtobj: failed to synthesize fnwrap for " + nm0)
                return nil
            }
        }
        wi = wi + 1
    }
    var lj = 0
    while lj < oren_list_len(ctx["lambda_defs"]) {
        var def = ctx["lambda_defs"][lj]
        var stl = callable.synth_lambda_wrapper(def)
        if stl != nil && stl["type"] == "ExprStmt" && stl["expr"] != nil && stl["expr"]["type"] == "Function" {
            oren_list_push(wrappers, stl["expr"])
        } else {
            err(ctx, "x64 native rtobj: failed to synthesize lambda wrapper")
            return nil
        }
        lj = lj + 1
    }

    // Compile synthesized wrappers.
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.build.wrappers.start",
            "wrappers=" + oren_int_to_string(oren_list_len(wrappers)))
    }
    var j = 0
    while j < oren_list_len(wrappers) {
        if phase_log != nil && j > 0 && core.int_mod(j, 250) == 0 {
            _x64_program_phase_log_append(phase_log, "x64.rtobj.build.wrappers.progress",
                "i=" + oren_int_to_string(j) +
                " total=" + oren_int_to_string(oren_list_len(wrappers)))
        }
        var t_decl1 = 0
        if trace_decls { t_decl1 = oren_time_now_ns() }
        _compile_function_v0(ctx, wrappers[j], platform, false, call_depth_default_enabled)
        if trace_decls {
            var dt_decl1 = oren_time_now_ns() - t_decl1
            sum_decl_ns = sum_decl_ns + dt_decl1
            var fn1 = wrappers[j]
            var nm1 = ""
            if fn1 != nil {
                var n1 = fn1["name"]
                if n1 != nil {
                    if oren_is_string(n1) == true { nm1 = n1 }
                    else if n1["value"] != nil { nm1 = n1["value"] }
                }
            }
            var ent1 = {"ns": dt_decl1, "type": "Wrapper", "name": nm1}
            if top_decls == nil { top_decls = [] }
            if oren_list_len(top_decls) < top_keep {
                oren_list_push(top_decls, ent1)
            } else {
                var min_idx1 = 0
                var min_ns1 = top_decls[0]["ns"]
                var k1 = 1
                while k1 < oren_list_len(top_decls) {
                    var e1 = top_decls[k1]
                    if e1 != nil && e1["ns"] != nil && e1["ns"] < min_ns1 {
                        min_ns1 = e1["ns"]
                        min_idx1 = k1
                    }
                    k1 = k1 + 1
                }
                if dt_decl1 > min_ns1 { top_decls[min_idx1] = ent1 }
            }
        }
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
            if trace { print("[rtobj] x64 build failed (compile wrapper): " + ctx["errors"][0]) }
            return nil
        }
        j = j + 1
    }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.rtobj.build.wrappers.done",
            "wrappers=" + oren_int_to_string(oren_list_len(wrappers)))
    }
    if trace_sum { t_wrap_done = oren_time_now_ns() }

    if trace_decls && top_decls != nil {
        print("[x64_rtobj] top decls (us), sum_compile_ms=" + oren_int_to_string(sum_decl_ns / 1000000) + ":")
        var ti = 0
        while ti < oren_list_len(top_decls) {
            var e2 = top_decls[ti]
            if e2 != nil {
                var nm2 = e2["name"]
                if nm2 == nil { nm2 = "" }
                var ty2 = e2["type"]
                if ty2 == nil { ty2 = "" }
                var us = e2["ns"] / 1000
                print("  " + oren_int_to_string(us) + "us " + ty2 + " " + nm2)
            }
            ti = ti + 1
        }
    }

    // Materialize blobs for cache storage.
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.build.finalize.start", "") }
    var code_u8 = bytes_finalize(ctx["code"])
    var data_u8 = bytes_finalize(ctx["data"])
    if trace_sum { t_finalize_done = oren_time_now_ns() }
    var dn = oren_buf_len(data_u8)
    var prefix = rtobj.RUNTIME_OBJ_DATA_PREFIX_LEN
    if dn < prefix { return nil }
    var tail = oren_u8_buf_from_bytes_slice(data_u8, prefix, dn - prefix)
    if oren_is_err(tail) { return nil }

    var meta = {
        "schema": rtobj.RUNTIME_OBJ_SCHEMA,
        "backend": "x64",
        "backend_sig": backend_sig,
        "runtime_hash": runtime_hash,
        "data_prefix_len": prefix,
        "fn_offs_enc": _x64_rtobj_encode_offsets_map_int(ctx["functions"]),
        "fn_offsets_compact": _x64_rtobj_encode_fn_offsets_compact(ctx["functions"]),
        "x64_fixups_compact": _x64_rtobj_encode_fixups_compact(ctx["fixups"]),
        "fixups_enc": _x64_rtobj_encode_fixups(ctx["fixups"]),
        "rip_data32_fixups_enc": _x64_rtobj_encode_rip_data32_fixups(ctx["rip_data32_fixups"]),
        "globals": ctx["globals"],
        "global_root_names": ctx["global_root_names"],
        "global_root_offsets": ctx["global_root_offsets"],
        "global_root_is_runtime": ctx["global_root_is_runtime"],
        // Carry runtime imports/FFI name remaps so rtobj-mode emitters can resolve external symbols.
        "import_list": ctx["import_list"],
        "ffi_link_names": ctx["ffi_link_names"],
        // PERF (stage2-native hot path):
        // Do not persist the full runtime `cstr0_offs` dedup map in rtobj meta by default.
        // It is large (all runtime string literals) and decoding it can dominate “compile one file”
        // even though merging it is optional for correctness.
        "cstr0_list_enc": _x64_rtobj_encode_offsets_list_int(ctx["cstr0_list"]),
        "declared_functions": ctx["declared_functions"],
        "func_arity": ctx["func_arity"],
        "func_varargs_fixed": ctx["func_varargs_fixed"],
        "func_decl_order": ctx["func_decl_order"],
        "lambda_counter_enc": ctx["lambda_counter"] + 1
    }
    if phase_log != nil {
        var fx_n0 = 0
        if ctx["fixups"] != nil { fx_n0 = oren_list_len(ctx["fixups"]) }
        _x64_program_phase_log_append(phase_log, "x64.rtobj.build.finalize.done",
            "code_bytes=" + oren_int_to_string(oren_buf_len(code_u8)) +
            " data_bytes=" + oren_int_to_string(oren_buf_len(data_u8)) +
            " fixups=" + oren_int_to_string(fx_n0))
    }
    if trace_sum {
        var total_ms = (t_finalize_done - t0) / 1000000
        var parse_ms = (t_parse_done - t0) / 1000000
        var meta_ms = (t_meta_done - t_parse_done) / 1000000
        var lambdas_ms = (t_lambda_done - t_meta_done) / 1000000
        var split_ms = (t_split_done - t_lambda_done) / 1000000
        var globals_ms = (t_globals_done - t_split_done) / 1000000
        var decls_ms = (t_decls_done - t_globals_done) / 1000000
        var wrap_ms = (t_wrap_done - t_decls_done) / 1000000
        var fin_ms = (t_finalize_done - t_wrap_done) / 1000000
        var fx_n = 0
        if ctx["fixups"] != nil { fx_n = oren_list_len(ctx["fixups"]) }
        var fn_n = 0
        if fns != nil { fn_n = oren_list_len(fns) }
        var wrap_n = 0
        if wrappers != nil { wrap_n = oren_list_len(wrappers) }
        print("[x64_rtobj] total_ms=" + oren_int_to_string(total_ms) +
              " parse_ms=" + oren_int_to_string(parse_ms) +
              " meta_ms=" + oren_int_to_string(meta_ms) +
              " lambdas_ms=" + oren_int_to_string(lambdas_ms) +
              " split_ms=" + oren_int_to_string(split_ms) +
              " globals_ms=" + oren_int_to_string(globals_ms) +
              " decls_ms=" + oren_int_to_string(decls_ms) +
              " wrappers_ms=" + oren_int_to_string(wrap_ms) +
              " finalize_ms=" + oren_int_to_string(fin_ms) +
              " fns_n=" + oren_int_to_string(fn_n) +
              " wrappers_n=" + oren_int_to_string(wrap_n) +
              " vars_n=" + oren_int_to_string(oren_list_len(runtime_vars)) +
              " code_bytes=" + oren_int_to_string(oren_buf_len(code_u8)) +
              " data_bytes=" + oren_int_to_string(oren_buf_len(data_u8)) +
              " fixups_n=" + oren_int_to_string(fx_n))
    }
    var cstr0_offsets_u8 = _x64_rtobj_encode_offsets_u8_from_int_list(ctx["cstr0_list"])
    return {"meta": meta, "code_u8": code_u8, "data_tail_u8": tail, "cstr0_offsets_u8": cstr0_offsets_u8}
}

fn _x64_try_load_or_build_runtime_obj(ctx, platform, runtime_path) {
    if ctx == nil { return false }
    if rtobj.rtobj_cache_enabled(platform) != true { return false }

    var trace = rtobj.rtobj_trace_enabled()
    var phase_log = ctx["phase_log"]
    var t0 = 0
    if trace { t0 = oren_time_now_ns() }

    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.hash.start", "") }
    var rh = rtobj.rtobj_runtime_hash(ctx, runtime_path)
    if rh == nil || rh == "" { return false }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.hash.done", "") }
    var key = rtobj.rtobj_cache_key("x64", platform, rh)
    var bsig = rtobj.rtobj_backend_sig("x64")
    var dir = rtobj.rtobj_cache_dir()

    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.cache_load.start", "") }
    var hit = rtobj.rtobj_load(dir, key)
    if hit != nil {
        if trace { print("[rtobj] hit backend=x64 key=" + key) }
        if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.cache_load.hit", "") }
        return _x64_rtobj_apply_data_and_meta_to_ctx(ctx, hit)
    }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.cache_load.miss", "") }

    // Optional seed fallback (see rtobj module docs): allows fast first-build even when the
    // selected cache dir is empty.
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.seed_load.start", "") }
    var seed_hit = rtobj.rtobj_try_load_seed_into_cache(dir, key)
    if seed_hit != nil {
        if trace { print("[rtobj] seed-hit backend=x64 key=" + key) }
        if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.seed_load.hit", "") }
        return _x64_rtobj_apply_data_and_meta_to_ctx(ctx, seed_hit)
    }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.seed_load.miss", "") }

    if trace { print("[rtobj] miss backend=x64 key=" + key + " (building)") }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.build.start", "") }
    var built = _x64_build_runtime_obj(platform, runtime_path, rh, bsig, phase_log)
    if built == nil { return false }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.build.done", "") }

    // Persist to cache.
    var meta = built["meta"]
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.store.start", "") }
    rtobj.rtobj_store(dir, key, meta, built["code_u8"], built["data_tail_u8"], built["cstr0_offsets_u8"])
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.rtobj.store.done", "") }

    // Apply immediately (avoid re-reading).
    meta["code_u8"] = built["code_u8"]
    meta["data_tail_u8"] = built["data_tail_u8"]
    var ok = _x64_rtobj_apply_data_and_meta_to_ctx(ctx, meta)
    if trace {
        var dt = oren_time_now_ns() - t0
        print("[rtobj] build+apply(data) done +" + oren_int_to_string(dt / 1000000) + "ms")
    }
    return ok
}

fn _x64_symtab_push_unique(sym_seen, sym_names, nm) {
    if sym_seen == nil || sym_names == nil { return nil }
    if nm == nil || nm == "" { return nil }
    if sym_seen[nm] != nil { return nil }
    sym_seen[nm] = true
    oren_list_push(sym_names, nm)
    return nil
}
