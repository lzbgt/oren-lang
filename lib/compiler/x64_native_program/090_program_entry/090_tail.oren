        if opts["focus_enabled"] == true { focus_enabled = true }
        var v_focus_from = opts["prog_focus_from"]
        if oren_type_tag(v_focus_from) != 0 { prog_focus_from = v_focus_from }
        var v_focus_to = opts["prog_focus_to"]
