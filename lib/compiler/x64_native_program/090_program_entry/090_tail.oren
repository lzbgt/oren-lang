// @include "089_symtab_display.oren"

// @include "089_debug_roots.oren"

fn _x64_emit_entry_runtime_bootstrap(ctx, platform, scratch_base, is_so, trace_prog, trace_entry, phase_log) {
    _x64_emit_entry_heap_and_frame_init(ctx)

    var target_os_id = 2
    if platform != nil && platform["os"] == "windows" { target_os_id = 3 }
    if _x64_emit_entry_boot_globals(ctx) == nil { return nil }
    _x64_emit_entry_capture_args(ctx, platform, scratch_base, is_so)
    _x64_emit_entry_native_runtime_init(ctx, platform, target_os_id, trace_prog, trace_entry, phase_log)
    _x64_emit_entry_static_cstr_table(ctx, platform, trace_prog, trace_entry, phase_log)
    _x64_emit_entry_debug_info(ctx, platform, trace_prog, trace_entry, phase_log)
    _x64_emit_entry_set_args(ctx, platform, scratch_base, trace_prog, trace_entry, phase_log)
    _x64_emit_entry_windows_envp(ctx, platform, scratch_base, trace_entry)
    _x64_emit_entry_set_envp(ctx, platform, scratch_base, trace_prog, trace_entry, phase_log)
    _x64_emit_entry_capsule_and_gc(ctx, platform, trace_prog, trace_entry, phase_log)

    return nil
}

// @include "086_user_function_loop.oren"

// @include "084_compile_options.oren"

fn _x64_collect_lambda_uses(ctx, stmts_all, top_info, type_ctors, trace_prog, phase_log) {
    // Collect lambdas (anonymous Function nodes with name="") from the full statement set
    // that will actually be compiled.
    //
    // This annotates lambda nodes with:
    //   - lambda_name: generated wrapper name
    //   - captures: free vars in deterministic first-use order
    //
    // NOTE: We must scan more than just `bun["user_stmts"]` because:
    // - runtime injection + DCE can keep runtime lambdas alive,
    // - x64 synthesizes `__top_level__` from user global initializers,
    // - x64 synthesizes type constructors.
    var lambda_scan_skipped = false
    if ctx["_native_has_lambda_candidates"] == true {
        if trace_prog { print("[x64_compile] collect lambdas start stmts=" + oren_int_to_string(oren_list_len(stmts_all))) }
        var li = 0
        while li < oren_list_len(stmts_all) {
            callable.collect_lambdas_in_statement(ctx, stmts_all[li])
            li = li + 1
        }
        // Also scan synthesized `__top_level__` (not present in `linked2["statements"]`).
        if top_info["top_level_fn"] != nil {
            callable.collect_lambdas_in_expression(ctx, top_info["top_level_fn"])
        }
        // Also scan synthesized type constructors (not present in `linked2["statements"]`).
        var ltc = 0
        while ltc < oren_list_len(type_ctors) {
            callable.collect_lambdas_in_expression(ctx, type_ctors[ltc])
            ltc = ltc + 1
        }
    } else {
        lambda_scan_skipped = true
        if trace_prog { print("[x64_compile] collect lambdas skipped (no candidates)") }
    }
    if trace_prog { print("[x64_compile] collect lambdas done defs=" + oren_int_to_string(oren_list_len(ctx["lambda_defs"]))) }
    if phase_log != nil {
        var lambda_extra = ""
        if lambda_scan_skipped { lambda_extra = " skipped=1" }
        _x64_program_phase_log_append(phase_log, "x64.codegen.lambdas.done",
            "lambdas=" + oren_int_to_string(oren_list_len(ctx["lambda_defs"])) + lambda_extra)
    }
    return nil
}

fn _x64_debug_print_lambda_collection(ctx, stmts_all) {
    var dbg_lam = oren_env("OREN_DEBUG_X64_LAMBDAS")
    if dbg_lam == nil { return nil }
    var raw_fn = 0
    var expr_fn = 0
    var si = 0
    while si < oren_list_len(stmts_all) {
        var st0 = stmts_all[si]
        if st0 != nil {
            if st0["type"] == "Function" { raw_fn = raw_fn + 1 }
            if st0["type"] == "ExprStmt" {
                var e0 = st0["expr"]
                if e0 != nil && e0["type"] == "Function" { expr_fn = expr_fn + 1 }
            }
        }
        si = si + 1
    }
    print("DEBUG_X64_LAMBDAS stmts_all=" + oren_int_to_string(oren_list_len(stmts_all)) + " raw_fn=" + oren_int_to_string(raw_fn) + " expr_fn=" + oren_int_to_string(expr_fn))
    print("DEBUG_X64_LAMBDAS lambda_defs=" + oren_int_to_string(oren_list_len(ctx["lambda_defs"])))
    var di = 0
    while di < oren_list_len(ctx["lambda_defs"]) {
        var d0 = ctx["lambda_defs"][di]
        if d0 != nil { print("DEBUG_X64_LAMBDA_DEF " + d0["name"]) }
        di = di + 1
    }
    return nil
}

fn _x64_collect_named_fn_value_uses(ctx, stmts_all, top_info, type_ctors) {
    callable.collect_named_fn_value_uses_in_stmt_list(ctx, stmts_all)
    if top_info["top_level_fn"] != nil {
        callable.collect_named_fn_value_uses_in_expression(ctx, top_info["top_level_fn"], false)
    }
    var vtc = 0
    while vtc < oren_list_len(type_ctors) {
        callable.collect_named_fn_value_uses_in_expression(ctx, type_ctors[vtc], false)
        vtc = vtc + 1
    }
    return nil
}

fn _x64_collect_callable_uses(ctx, linked2, top_info, type_ctors, trace_prog, phase_log) {
    var stmts_all = linked2["statements"]
    if stmts_all == nil { stmts_all = [] }
    _x64_collect_lambda_uses(ctx, stmts_all, top_info, type_ctors, trace_prog, phase_log)
    _x64_debug_print_lambda_collection(ctx, stmts_all)
    _x64_collect_named_fn_value_uses(ctx, stmts_all, top_info, type_ctors)
    return stmts_all
}

fn _x64_prepare_lambda_wrappers(ctx, trace_prog, phase_log) {
    // --- Callable wrappers (Tier‑1 convergence) ---
    //
    // x64 no longer eagerly synthesizes `__oren_fnwrap_<name>` for every named function:
    // - it is unnecessary for direct calls (`foo(x)`),
    // - and it can dominate compile time for large programs (self-hosting `oren.oren`).
    //
    // Instead, we synthesize/compile fnwraps on-demand using `ctx["fnwrap_needed"]`
    // (populated when a named function is used as a first-class value).
    //
    // Lambda wrappers are still synthesized eagerly because each lambda literal needs a
    // concrete callable entrypoint.
    var wrappers = []

    // Lambda wrappers are named `__oren_lambda_N` and already implement the uniform call ABI:
    //   fn __oren_lambda_N(__env, __args_list) { ... }
    // They inline the original lambda body and bind captures/params from env/args.
    if trace_prog { print("[x64_compile] lambda wrappers start") }
    var lj = 0
    while lj < oren_list_len(ctx["lambda_defs"]) {
        var def = ctx["lambda_defs"][lj]
        var st = callable.synth_lambda_wrapper(def)
        if st != nil && st["type"] == "ExprStmt" && st["expr"] != nil && st["expr"]["type"] == "Function" {
            oren_list_push(wrappers, st["expr"])
        } else {
            err(ctx, "x64 native v0: failed to synthesize lambda wrapper")
            return nil
        }
        lj = lj + 1
    }
    if trace_prog { print("[x64_compile] lambda wrappers done count=" + oren_int_to_string(oren_list_len(wrappers))) }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.prepare.done",
            "wrappers=" + oren_int_to_string(oren_list_len(wrappers)))
    }

    return wrappers
}

fn _x64_compile_lambda_wrappers(ctx, wrappers, platform, call_depth_default_enabled, trace_prog, phase_log) {
    // Compile synthesized wrappers after user functions (order does not affect fixups, but
    // keeping them grouped makes debugging easier).
    var j1 = 0
    var wrappers_n = oren_list_len(wrappers)
    while j1 < wrappers_n {
        if trace_prog && core.int_mod(j1, 200) == 0 {
            print("[x64_compile] wrappers " + oren_int_to_string(j1) + "/" + oren_int_to_string(wrappers_n))
        }
        var wfn = wrappers[j1]
        var wnm = nil
        if wfn != nil { wnm = wfn["name"] }
        if wnm != nil && wnm != "" && ctx["functions"][wnm] != nil {
            j1 = j1 + 1
            continue
        }
        _compile_function_v0(ctx, wfn, platform, false, call_depth_default_enabled)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        j1 = j1 + 1
    }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.wrappers.done",
            "wrappers=" + oren_int_to_string(wrappers_n))
    }
    return nil
}

fn _x64_compile_one_missing_fnwrap(ctx, platform, call_depth_default_enabled, need, fname) {
    if fname == nil || fname == "" { return nil }
    if need == nil || need[fname] == nil { return nil }
    var wname = "__oren_fnwrap_" + fname
    if ctx["functions"][wname] != nil { return nil }

    var ar_enc = nil
    if ctx["func_arity"] != nil { ar_enc = ctx["func_arity"][fname] }
    if oren_type_tag(ar_enc) == 0 { return nil }

    var ar = ar_enc - 1
    var vf = nil
    if ctx["func_varargs_fixed"] != nil {
        var vf_enc = ctx["func_varargs_fixed"][fname]
        if oren_type_tag(vf_enc) != 0 { vf = vf_enc - 1 }
    }
    var st = callable.synth_fnwrap(fname, ar, vf)
    if st != nil && st["type"] == "ExprStmt" && st["expr"] != nil && st["expr"]["type"] == "Function" {
        var wfn = st["expr"]
        // Keep stack traces readable even for late-synthesized wrappers.
        if ctx["symtab_display"] != nil && ctx["symtab_display"][wname] == nil {
            ctx["symtab_display"][wname] = wname + "@<generated>"
        }
        _compile_function_v0(ctx, wfn, platform, false, call_depth_default_enabled)
        return nil
    }

    err(ctx, "x64 native v0: failed to synthesize fnwrap for " + fname)
    return nil
}

fn _x64_log_missing_fnwraps_done(ctx, phase_log, need) {
    if phase_log == nil { return nil }
    var fnwrap_needed_n = 0
    if need != nil { fnwrap_needed_n = oren_map_len(need) }
    _x64_program_phase_log_append(phase_log, "x64.codegen.fnwrap.done",
        "needed=" + oren_int_to_string(fnwrap_needed_n))
    return nil
}

fn _x64_compile_missing_fnwraps(ctx, platform, call_depth_default_enabled, phase_log) {
    // Ensure any missing fnwraps are synthesized and compiled.
    //
    // This is needed when:
    // - a cached runtime object (rtobj) is used, and
    // - the runtime object does not include all `__oren_fnwrap_*` wrappers, but user code
    //   references some runtime function as a first-class value.
    //
    // `fnwrap_needed` is populated during expression compilation (Identifier-as-value).
    var need2 = ctx["fnwrap_needed"]
    if need2 != nil {
        var wi2 = 0
        while wi2 < oren_list_len(ctx["func_decl_order"]) {
            var fname2 = ctx["func_decl_order"][wi2]
            _x64_compile_one_missing_fnwrap(ctx, platform, call_depth_default_enabled, need2, fname2)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            wi2 = wi2 + 1
        }
    }
    _x64_log_missing_fnwraps_done(ctx, phase_log, need2)
    return nil
}

fn _x64_finalize_program_debug_missing_lambdas(ctx) {
    var dbg_lam2 = oren_env("OREN_DEBUG_X64_LAMBDAS")
    if dbg_lam2 == nil { return nil }
    var mi = 0
    while mi < oren_list_len(ctx["lambda_defs"]) {
        var d1 = ctx["lambda_defs"][mi]
        var nm = nil
        if d1 != nil { nm = d1["name"] }
        if nm != nil && ctx["functions"][nm] == nil {
            print("DEBUG_X64_LAMBDAS missing_wrapper " + nm)
        }
        mi = mi + 1
    }
    return nil
}

fn _x64_finalize_program_step_done(ctx, phase_log, label) {
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, label, "") }
    return true
}

fn _x64_finalize_program_tables(ctx, platform, phase_log) {
    // Fill the symtab now that `ctx["functions"]` contains final offsets.
    _data_finalize_symtab(ctx)
    if _x64_finalize_program_step_done(ctx, phase_log, "x64.codegen.finalize.symtab.done") != true { return false }

    // Fill the linetab now that code offsets are stable.
    _data_finalize_linetab(ctx)
    if _x64_finalize_program_step_done(ctx, phase_log, "x64.codegen.finalize.linetab.done") != true { return false }

    // Fill the debug-info table now that code offsets are stable (debug builds only).
    _data_finalize_dbginfo_table(ctx, platform)
    if _x64_finalize_program_step_done(ctx, phase_log, "x64.codegen.finalize.dbginfo.done") != true { return false }

    // Finalize the embedded-string table after all codegen so it includes:
    // - user literals
    // - injected runtime literals
    // - backend-emitted literal cstrs (panic helpers, etc)
    _data_finalize_cstr0_table(ctx)
    if _x64_finalize_program_step_done(ctx, phase_log, "x64.codegen.finalize.cstr0.done") != true { return false }
    return true
}

fn _x64_finalize_program_log_done(ctx, phase_log) {
    if phase_log != nil {
        var fx_n0 = 0
        if ctx["fixups"] != nil { fx_n0 = oren_list_len(ctx["fixups"]) }
        _x64_program_phase_log_append(phase_log, "x64.codegen.done",
            "code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])) +
            " data_bytes=" + oren_int_to_string(bytes_len(ctx["data"])) +
            " fixups=" + oren_int_to_string(fx_n0))
    }
    return nil
}

fn _x64_finalize_program_data(ctx, platform, phase_log) {
    _x64_finalize_program_debug_missing_lambdas(ctx)
    if _x64_finalize_program_tables(ctx, platform, phase_log) != true { return nil }
    _x64_finalize_program_log_done(ctx, phase_log)
    return nil
}

fn _x64_emit_entry_register_thread_call(ctx, platform, entry_opts, phase_log) {
    var trace_prog = entry_opts["trace_prog"] == true
    var trace_entry = entry_opts["trace_entry"] == true
    var trace_entry_after_reg = entry_opts["trace_entry_after_reg"] == true
    var skip_register_thread = entry_opts["skip_register_thread"] == true
    var exit_after_register_thread = entry_opts["exit_after_register_thread"] == true
    var trace_windows = trace_entry && platform != nil && platform["os"] == "windows"
    if skip_register_thread != true {
        _x64_emit_entry_register_thread_active(ctx, platform, trace_prog, trace_windows, trace_entry_after_reg, exit_after_register_thread)
    } else {
        _x64_emit_entry_register_thread_skip(ctx, trace_windows)
    }
    _x64_log_entry_register_thread_done(ctx, phase_log)
    return nil
}

fn _x64_emit_entry_register_thread_active(ctx, platform, trace_prog, trace_windows, trace_entry_after_reg, exit_after_register_thread) {
    // Register main thread for GC/stack safety.
    if trace_prog { print("[x64_compile] register thread call start") }
    _x64_emit_entry_register_thread_arg(ctx, platform, trace_windows)
    _x64_emit_entry_register_thread_fixup_call(ctx)
    _x64_emit_entry_register_thread_after_call(ctx, trace_prog, trace_windows, trace_entry_after_reg, exit_after_register_thread)
    return nil
}

fn _x64_emit_entry_register_thread_arg(ctx, platform, trace_windows) {
    if trace_windows {
        // Save current RSP in a non-volatile register to detect stack drift.
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 4)) // r12 = rsp
    }
    if platform != nil && platform["os"] == "windows" {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 4)) // rcx = rsp
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 4)) // rdi = rsp
    }
    return nil
}

fn _x64_emit_entry_register_thread_fixup_call(ctx) {
    var call_reg_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_reg_pos, "name": "oren_register_thread"})
    return nil
}

fn _x64_emit_entry_register_thread_after_call(ctx, trace_prog, trace_windows, trace_entry_after_reg, exit_after_register_thread) {
    if trace_windows { _x64_emit_entry_register_thread_rsp_check(ctx) }
    if trace_windows && trace_entry_after_reg { _emit_windows_write_cstr(ctx, "ENTRY: register_thread ok") }
    if exit_after_register_thread == true { _emit_abort_exitcode(ctx, 241) }
    if trace_prog { print("[x64_compile] register thread call emitted") }
    return nil
}

fn _x64_emit_entry_register_thread_rsp_check(ctx) {
    var labels_rsp = {}
    var fixups_rsp = []
    var l_rsp_ok = _new_label(ctx, "entry_rsp_ok")
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(12, 4)) // r12 (saved) vs rsp
    _emit_jcc_to_label(ctx, fixups_rsp, "e", l_rsp_ok)
    _emit_windows_write_cstr(ctx, "ENTRY: rsp drift after register_thread")
    _emit_abort_exitcode(ctx, 244)
    _emit_label(ctx, labels_rsp, l_rsp_ok)
    _patch_local_fixups(ctx, labels_rsp, fixups_rsp)
    return nil
}

fn _x64_emit_entry_register_thread_skip(ctx, trace_windows) {
    if trace_windows { _emit_windows_write_cstr(ctx, "ENTRY: register_thread skip") }
    return nil
}

fn _x64_log_entry_register_thread_done(ctx, phase_log) {
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.register_thread.done",
            "fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }
    return nil
}

fn _x64_emit_entry_top_level_call(ctx, platform, entry_opts) {
    var trace_prog = entry_opts["trace_prog"] == true
    var trace_entry = entry_opts["trace_entry"] == true
    var trace_entry_after_reg = entry_opts["trace_entry_after_reg"] == true
    var skip_top_level = entry_opts["skip_top_level"] == true
    // Run top-level statements (including non-constant global initializers) before `main`.
    //
    // This converges x64 behavior with the other backends while keeping the x64 v0
    // "fn main() required" rule.
    if skip_top_level != true {
        if trace_prog { print("[x64_compile] top-level entry call start") }
        if trace_entry && trace_entry_after_reg && platform != nil && platform["os"] == "windows" {
            _emit_windows_write_cstr(ctx, "ENTRY: top_level call")
        }
        var call_top_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], core.insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_top_pos, "name": "__top_level__"})
        if trace_entry && trace_entry_after_reg && platform != nil && platform["os"] == "windows" {
            _emit_windows_write_cstr(ctx, "ENTRY: top_level ok")
        }
        if trace_prog { print("[x64_compile] top-level entry call emitted") }
    } else {
        if trace_entry && trace_entry_after_reg && platform != nil && platform["os"] == "windows" {
            _emit_windows_write_cstr(ctx, "ENTRY: top_level skip")
        }
    }
    return nil
}

fn _x64_emit_entry_main_or_zero(ctx, platform, has_main, entry_opts) {
    var trace_entry = entry_opts["trace_entry"] == true
    var trace_entry_after_reg = entry_opts["trace_entry_after_reg"] == true
    var skip_main = entry_opts["skip_main"] == true
    var is_dll = entry_opts["is_dll"] == true
    var is_so = entry_opts["is_so"] == true
    if is_dll != true && is_so != true && has_main && skip_main != true {
        var call_pos = bytes_len(ctx["code"])
        // placeholder rel32=0
        bytes_extend(ctx["code"], core.insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "main"})
    } else if is_dll != true && is_so != true {
        // Ensure a deterministic exit code when main is absent or intentionally skipped.
        if skip_main == true && trace_entry && trace_entry_after_reg && platform != nil && platform["os"] == "windows" {
            _emit_windows_write_cstr(ctx, "ENTRY: main skip")
        }
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    }
    return nil
}

fn _x64_emit_entry_top_and_main_calls(ctx, platform, has_main, entry_opts, phase_log) {
    _x64_emit_entry_top_level_call(ctx, platform, entry_opts)
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.top_level_call.done",
            "fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }

    _x64_emit_entry_main_or_zero(ctx, platform, has_main, entry_opts)
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.main_call.done",
            "fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }
    return nil
}

fn _x64_emit_shared_entry_heap_spills(ctx, missing_msg) {
    var heap_limit_off = _rtobj_decode_int_enc(ctx["heap_limit_slot_enc"])
    var heap_ptr_off = _rtobj_decode_int_enc(ctx["heap_ptr_slot_enc"])
    if heap_limit_off == nil || heap_ptr_off == nil {
        err(ctx, missing_msg)
        return nil
    }

    var lea_hl = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(11, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_hl + 3, "data_off": heap_limit_off})
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(11, 14))

    var lea_hp = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(11, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_hp + 3, "data_off": heap_ptr_off})
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(11, 15))
    return true
}

fn _x64_emit_windows_dll_return_path(ctx, entry_total, entry_opts) {
    // DllMain return path: persist heap registers, restore callee-saved regs, return TRUE.
    if _x64_emit_shared_entry_heap_spills(ctx,
        "x64 native: missing heap spill slots for DLL entry (heap_limit_slot_enc/heap_ptr_slot_enc)") != true {
        return nil
    }

    _x64_emit_windows_dll_true_epilogue(ctx, entry_total)
    _x64_patch_windows_dll_attach_fixups(ctx, entry_opts)
    _x64_finalize_entry_return_path(ctx)
    return true
}

fn _x64_emit_windows_dll_true_epilogue(ctx, entry_total) {
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1)) // eax=TRUE
    if entry_total > 0 { bytes_extend(ctx["code"], core.insn_add_rsp_imm32(entry_total)) }
    _x64_emit_win64_entry_restore(ctx)
    bytes_extend(ctx["code"], core.insn_ret())
    return nil
}

fn _x64_emit_win64_entry_restore(ctx) {
    // Restore non-volatile regs in reverse order.
    bytes_extend(ctx["code"], core.insn_pop_r64(15))
    bytes_extend(ctx["code"], core.insn_pop_r64(14))
    bytes_extend(ctx["code"], core.insn_pop_r64(13))
    bytes_extend(ctx["code"], core.insn_pop_r64(12))
    bytes_extend(ctx["code"], core.insn_pop_r64(6))
    bytes_extend(ctx["code"], core.insn_pop_r64(7))
    bytes_extend(ctx["code"], core.insn_pop_r64(5))
    bytes_extend(ctx["code"], core.insn_pop_r64(3))
    return nil
}

fn _x64_patch_windows_dll_attach_fixups(ctx, entry_opts) {
    var dll_labels = entry_opts["dll_labels"]
    var dll_fixups = entry_opts["dll_fixups"]
    if dll_labels != nil && dll_fixups != nil {
        _patch_local_fixups(ctx, dll_labels, dll_fixups)
    }
    return nil
}

fn _x64_finalize_entry_return_path(ctx) {
    ctx["entry_off"] = 0
    return nil
}

fn _x64_emit_windows_exe_return_path(ctx, entry_total) {
    // Windows x64 executable entry: ExitProcess(ret). rcx = u32 exit code.
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 0)) // r12 = main ret
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 12)) // rcx = main ret
    var call_run_json_win = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_run_json_win, "name": "native_runtime_run_json_maybe_print"})
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 12)) // restore rax
    bytes_extend(ctx["code"], core.insn_mov_r32_r32(1, 0)) // mov ecx, eax

    var mov_iat_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0)) // patch disp32 to IAT slot
    _x64_add_rip_data32_fixup(ctx, mov_iat_pos + 3, "IAT_ExitProcess")
    bytes_extend(ctx["code"], core.insn_call_rax())
    // Should not return; if it does, just ret.
    if entry_total > 0 { bytes_extend(ctx["code"], core.insn_add_rsp_imm32(entry_total)) }
    bytes_extend(ctx["code"], core.insn_ret())
    _x64_finalize_entry_return_path(ctx)
    return true
}

fn _x64_emit_linux_so_return_path(ctx, entry_total) {
    // Linux x86_64 shared-library ctor return path: persist heap registers, restore regs, return 0.
    if _x64_emit_shared_entry_heap_spills(ctx,
        "x64 native: missing heap spill slots for ELF .so entry (heap_limit_slot_enc/heap_ptr_slot_enc)") != true {
        return nil
    }

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    if entry_total > 0 { bytes_extend(ctx["code"], core.insn_add_rsp_imm32(entry_total)) }
    bytes_extend(ctx["code"], core.insn_pop_r64(15))
    bytes_extend(ctx["code"], core.insn_pop_r64(14))
    bytes_extend(ctx["code"], core.insn_pop_r64(13))
    bytes_extend(ctx["code"], core.insn_pop_r64(12))
    bytes_extend(ctx["code"], core.insn_pop_r64(5))
    bytes_extend(ctx["code"], core.insn_pop_r64(3))
    bytes_extend(ctx["code"], core.insn_ret())
    _x64_finalize_entry_return_path(ctx)
    return true
}

fn _x64_emit_linux_exe_return_path(ctx, entry_total) {
    // Linux x86_64: exit_group(main_ret) via syscall (process-wide).
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 0)) // r12 = main ret
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 12)) // rdi = main ret
    var call_run_json_linux = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_run_json_linux, "name": "native_runtime_run_json_maybe_print"})
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 12)) // restore rax
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 0)) // mov rdi, rax
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_exit_group()))
    bytes_extend(ctx["code"], core.insn_syscall())
    // Should not return; if it does, ret.
    if entry_total > 0 { bytes_extend(ctx["code"], core.insn_add_rsp_imm32(entry_total)) }
    bytes_extend(ctx["code"], core.insn_ret())
    _x64_finalize_entry_return_path(ctx)
    return true
}

fn _x64_emit_entry_return_path(ctx, platform, entry_opts) {
    var is_dll = entry_opts["is_dll"] == true
    var is_so = entry_opts["is_so"] == true
    var entry_total = entry_opts["entry_total"]
    if oren_type_tag(entry_total) == 0 { entry_total = 0 }
    if platform != nil && platform["os"] == "windows" {
        if is_dll { return _x64_emit_windows_dll_return_path(ctx, entry_total, entry_opts) }
        return _x64_emit_windows_exe_return_path(ctx, entry_total)
    }
    if is_so { return _x64_emit_linux_so_return_path(ctx, entry_total) }
    return _x64_emit_linux_exe_return_path(ctx, entry_total)
}

fn _x64_entry_kind(platform) {
    var is_win = platform != nil && platform["os"] == "windows"
    var is_shared = platform != nil && platform["shared_lib"] == true
    return {
        "is_win": is_win,
        "is_dll": is_win && is_shared,
        "is_so": (is_win != true) && is_shared
    }
}

fn _x64_emit_dll_entry_attach_gate(ctx) {
    // Windows DLL entrypoint (DllMain) must behave like a normal Win64 ABI function:
    // - preserve non-volatile regs
    // - return BOOL in EAX
    // - do not clobber the call return address (so do NOT `and rsp, -16`)
    //
    // We only initialize on DLL_PROCESS_ATTACH (fdwReason==1, passed in EDX).
    var dll_labels = {}
    var dll_fixups = []
    var l_dll_attach = _new_label(ctx, "dll_attach")
    // if (edx != 1) return TRUE;
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(2, 1)) // cmp edx, 1
    _emit_jcc_to_label(ctx, dll_fixups, "e", l_dll_attach)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1)) // eax = TRUE
    bytes_extend(ctx["code"], core.insn_ret())
    _emit_label(ctx, dll_labels, l_dll_attach)
    return {"dll_labels": dll_labels, "dll_fixups": dll_fixups}
}

fn _x64_emit_win64_entry_preserves(ctx) {
    // Preserve Win64 non-volatile regs. Our internal ABI excludes r14/r15 because they
    // are heap registers; external callers must still see them preserved.
    bytes_extend(ctx["code"], core.insn_push_r64(3))  // rbx
    bytes_extend(ctx["code"], core.insn_push_r64(5))  // rbp
    bytes_extend(ctx["code"], core.insn_push_r64(7))  // rdi
    bytes_extend(ctx["code"], core.insn_push_r64(6))  // rsi
    bytes_extend(ctx["code"], core.insn_push_r64(12)) // r12
    bytes_extend(ctx["code"], core.insn_push_r64(13)) // r13
    bytes_extend(ctx["code"], core.insn_push_r64(14)) // r14
    bytes_extend(ctx["code"], core.insn_push_r64(15)) // r15
    return nil
}

fn _x64_emit_sysv_so_entry_preserves(ctx) {
    // Linux shared library constructor entry:
    // - called as a normal SysV function (return address pushed), so do NOT smash RSP with `and rsp,-16`
    // - must preserve SysV callee-saved regs because the dynamic loader expects ABI correctness
    //
    // We will store heap state to `.data` spill slots before returning so exported ABI wrappers
    // can load it later.
    bytes_extend(ctx["code"], core.insn_push_r64(3))  // rbx
    bytes_extend(ctx["code"], core.insn_push_r64(5))  // rbp
    bytes_extend(ctx["code"], core.insn_push_r64(12)) // r12
    bytes_extend(ctx["code"], core.insn_push_r64(13)) // r13
    bytes_extend(ctx["code"], core.insn_push_r64(14)) // r14
    bytes_extend(ctx["code"], core.insn_push_r64(15)) // r15
    return nil
}

fn _x64_emit_exe_entry_stack_align(ctx, platform) {
    // Save original RSP before aligning; needed later for argc/argv/envp capture on Linux.
    if platform == nil || platform["os"] != "windows" {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(13, 4)) // r13 = rsp (orig)
    }

    // Align stack to 16B boundary early so both SysV and Win64 calls stay well-formed as we grow
    // the x64 backend surface. After this point we must treat the stack as ABI-owned.
    bytes_extend(ctx["code"], core.insn_and_rsp_imm8(240)) // 0xF0 == -16
    return nil
}

fn _x64_emit_entry_platform_prologue(ctx, platform, kind) {
    if kind["is_dll"] == true {
        var dll_state = _x64_emit_dll_entry_attach_gate(ctx)
        _x64_emit_win64_entry_preserves(ctx)
        return dll_state
    }
    if kind["is_so"] == true {
        _x64_emit_sysv_so_entry_preserves(ctx)
        return {"dll_labels": nil, "dll_fixups": nil}
    }
    _x64_emit_exe_entry_stack_align(ctx, platform)
    return {"dll_labels": nil, "dll_fixups": nil}
}

fn _x64_entry_stack_layout(ctx, platform, kind) {
    var is_dll = kind["is_dll"] == true
    var is_so = kind["is_so"] == true

    // Windows x64 ABI note:
    // - every call requires 32 bytes of shadow space allocated by the caller.
    // - calls with >4 args pass stack args at [rsp+0x20..], above the shadow space.
    //
    // Since our entrypoint is not a C runtime, we explicitly reserve the maximum
    // stack arg area we need before calling into WinAPI / injected runtime init.
    var entry_shadow = abi.caller_shadow_bytes(ctx["abi"])
    // Reserve stack-arg slots for WinAPI calls in the entry stub (WideCharToMultiByte uses 8 args).
    var entry_stack_args = 0
    if platform != nil && platform["os"] == "windows" && is_dll != true { entry_stack_args = 32 }
    // Shared-lib entry has RSP 8 mod 16 (return address pushed); do not smash RSP with `and`.
    // Add an explicit 8-byte pad so nested calls are 16B-aligned.
    var entry_align_pad = 0
    if is_dll || is_so { entry_align_pad = 8 }
    // Also reserve a small scratch region for entry-level values (argc/argv/envp).
    // Place scratch above the stack-arg area so calls with >4 args don't clobber it.
    // Windows note: we also keep a saved copy of the Win32 env block pointer so we can
    // free it after converting to a POSIX-style envp array.
    var entry_scratch = 48
    return {
        "entry_total": entry_shadow + entry_stack_args + entry_scratch + entry_align_pad,
        "scratch_base": entry_shadow + entry_stack_args + entry_align_pad
    }
}

fn _x64_emit_entry_stack_reserve(ctx, layout) {
    var entry_total = layout["entry_total"]
    if entry_total > 0 { bytes_extend(ctx["code"], core.insn_sub_rsp_imm32(entry_total)) }
    return nil
}

fn _x64_log_entry_prologue_done(ctx, trace_prog, phase_log) {
    if trace_prog { print("[x64_compile] entry prologue done") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.prologue.done",
            "code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])))
    }
    return nil
}

fn _x64_emit_windows_entry_args_and_env(ctx, platform, scratch_base, is_dll, trace_entry) {
    if platform != nil && platform["os"] == "windows"  {
        if trace_entry { _emit_windows_write_cstr(ctx, "ENTRY: win begin") }
        if is_dll != true {
            _emit_entry_build_args_windows_x64(ctx, scratch_base)
            if trace_entry { _emit_windows_write_cstr(ctx, "ENTRY: win args ok") }
        } else {
            // DllMain: no argc/argv ABI. Default to argc=0, argv=nil.
            bytes_extend(ctx["code"], core.insn_mov_r64_imm64(0, 0)) // rax=0
            _emit_mov_mrsp_r64(ctx, scratch_base + 0, 0)  // argc
            _emit_mov_mrsp_r64(ctx, scratch_base + 8, 0)  // argv
            if trace_entry { _emit_windows_write_cstr(ctx, "ENTRY: win args skip (dll)") }
        }
        _emit_entry_capture_envblock_windows_x64(ctx, scratch_base)
        if trace_entry { _emit_windows_write_cstr(ctx, "ENTRY: win envblock ok") }
    }
    return nil
}

fn _x64_emit_entry_prologue_and_args(ctx, platform, trace_prog, trace_entry, phase_log) {
    var kind = _x64_entry_kind(platform)
    var is_dll = kind["is_dll"] == true
    var is_so = kind["is_so"] == true
    if trace_prog { print("[x64_compile] entry stub start") }

    var preserve_state = _x64_emit_entry_platform_prologue(ctx, platform, kind)
    var layout = _x64_entry_stack_layout(ctx, platform, kind)
    _x64_emit_entry_stack_reserve(ctx, layout)
    _x64_log_entry_prologue_done(ctx, trace_prog, phase_log)
    _x64_emit_windows_entry_args_and_env(ctx, platform, layout["scratch_base"], is_dll, trace_entry)

    return {
        "is_dll": is_dll,
        "is_so": is_so,
        "entry_total": layout["entry_total"],
        "scratch_base": layout["scratch_base"],
        "dll_labels": preserve_state["dll_labels"],
        "dll_fixups": preserve_state["dll_fixups"]
    }
}

fn _x64_select_runtime_path(linked, platform) {
    var runtime_path = "lib/runtime_native.oren"
    if platform != nil && platform["capsule"] == true {
        return "lib/runtime_native_capsule.oren"
    }

    // Optional: smaller injected runtime profile to keep cold rtobj builds bounded.
    //
    // Values (rolling):
    // - unset / "auto": default heuristic (prefers core; escalates to full for std:net)
    // - "full": force full runtime (`lib/runtime_native.oren`)
    // - "core" / "minimal": reduced runtime (`lib/runtime_native_core.oren`)
    var prof = oren_env("OREN_NATIVE_RUNTIME_PROFILE")
    if x64_env_str_eq(prof, "full") {
        runtime_path = "lib/runtime_native.oren"
    } else if x64_env_str_eq(prof, "core") || x64_env_str_eq(prof, "minimal") {
        runtime_path = "lib/runtime_native_core.oren"
    } else {
        // Default-on heuristic:
        // - core unless the program imports `std:net/*` (which requires runtime networking primitives).
        runtime_path = "lib/runtime_native_core.oren"
        if x64_env_str_eq(prof, "auto") || prof == nil || prof == "" {
            if _x64_should_use_full_native_runtime_profile(linked) { runtime_path = "lib/runtime_native.oren" }
        }
    }
    return runtime_path
}

fn _x64_runtime_obj_cache_enabled(v_rtobj, v_skip_rtobj) {
    var rtobj_enabled = true
    if v_rtobj != nil && v_rtobj != "" {
        if x64_env_str_eq(v_rtobj, "0") == true || x64_env_str_eq(v_rtobj, "false") == true {
            rtobj_enabled = false
        }
    }
    if v_skip_rtobj != nil && v_skip_rtobj != "" {
        if x64_env_str_eq(v_skip_rtobj, "0") != true && x64_env_str_eq(v_skip_rtobj, "false") != true {
            rtobj_enabled = false
        }
    }
    return rtobj_enabled
}

fn _x64_trace_runtime_obj_choice(runtime_path, rtobj_enabled, v_rtobj) {
    var re = "1"
    if rtobj_enabled != true { re = "0" }
    var vlen = -1
    var vb0 = -1
    if v_rtobj != nil {
        vlen = oren_string_len(v_rtobj)
        if vlen > 0 { vb0 = oren_string_byte_at_unchecked(v_rtobj, 0) & 255 }
    }
    print("[x64_compile] rtobj enabled=" + re + " path=" + runtime_path + " env_len=" + oren_int_to_string(vlen) + " env_b0=" + oren_int_to_string(vb0))
    return nil
}

fn _x64_try_runtime_obj_choice(ctx, platform, runtime_path, rtobj_enabled, trace_prog) {
    var used_rtobj = false
    if rtobj_enabled == true {
        used_rtobj = _x64_try_load_or_build_runtime_obj(ctx, platform, runtime_path)
    }
    if trace_prog {
        var u0 = "0"
        if used_rtobj == true { u0 = "1" }
        print("[x64_compile] rtobj done used=" + u0)
    }
    return used_rtobj
}

fn _x64_log_runtime_obj_choice_done(phase_log, runtime_path, used_rtobj) {
    if phase_log == nil { return nil }
    var used_rtobj_s0 = "0"
    if used_rtobj == true { used_rtobj_s0 = "1" }
    _x64_program_phase_log_append(phase_log, "x64.codegen.rtobj.done", "used=" + used_rtobj_s0 + " path=" + runtime_path)
    return nil
}

fn _x64_setup_runtime_object_choice(ctx, linked, platform, trace_prog, phase_log) {
    var runtime_path = _x64_select_runtime_path(linked, platform)
    var v_rtobj = oren_env("OREN_NATIVE_RUNTIME_OBJ_CACHE")
    var v_skip_rtobj = oren_env("OREN_X64_SKIP_RTOBJ")
    var rtobj_enabled = _x64_runtime_obj_cache_enabled(v_rtobj, v_skip_rtobj)
    if trace_prog { _x64_trace_runtime_obj_choice(runtime_path, rtobj_enabled, v_rtobj) }
    var used_rtobj = _x64_try_runtime_obj_choice(ctx, platform, runtime_path, rtobj_enabled, trace_prog)
    _x64_log_runtime_obj_choice_done(phase_log, runtime_path, used_rtobj)
    return {"runtime_path": runtime_path, "used_rtobj": used_rtobj}
}

fn _x64_rewrite_program_local_function_sets(ctx, runtime_stmts, user_stmts, used_rtobj, trace_prog) {
    if used_rtobj != true {
        if trace_prog { print("[x64_compile] runtime local-fn rewrite") }
        callable.rewrite_local_fn_decls_in_stmt_list(ctx, runtime_stmts)
    }
    if trace_prog { print("[x64_compile] user local-fn rewrite") }
    callable.rewrite_local_fn_decls_in_stmt_list(ctx, user_stmts)
    return nil
}

fn _x64_collect_program_function_list(ctx, linked2, used_rtobj, trace_prog) {
    var fns = nil
    if used_rtobj == true {
        if trace_prog { print("[x64_compile] collect functions (rtobj merge)") }
        fns = coreir.collect_top_level_functions_merge(ctx, linked2, "x64 native v0")
    } else {
        if trace_prog { print("[x64_compile] extract functions") }
        fns = _extract_functions_v0(ctx, linked2)
    }
    if fns == nil { return nil }
    if trace_prog { print("[x64_compile] collect functions done fns=" + oren_int_to_string(oren_list_len(fns))) }
    return fns
}

fn _x64_collect_program_type_constructors(ctx, linked2, fns, trace_prog, phase_log) {
    if trace_prog { print("[x64_compile] type constructors start") }
    var type_ctors = _x64_extract_type_constructors_v0(ctx, linked2)
    if type_ctors == nil { return nil }
    var tci = 0
    while tci < oren_list_len(type_ctors) { oren_list_push(fns, type_ctors[tci]); tci = tci + 1 }
    if trace_prog { print("[x64_compile] type constructors done count=" + oren_int_to_string(oren_list_len(type_ctors))) }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.fnmeta.done",
            "fns=" + oren_int_to_string(oren_list_len(fns)) +
            " type_ctors=" + oren_int_to_string(oren_list_len(type_ctors)))
    }
    return type_ctors
}

fn _x64_collect_program_ffi_and_globals(ctx, runtime_stmts, user_stmts, trace_prog, phase_log) {
    if trace_prog { print("[x64_compile] ffi decls start") }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.codegen.ffi.start", "") }
    _x64_collect_ffi_decls(ctx, runtime_stmts, user_stmts)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_prog { print("[x64_compile] ffi decls done") }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.codegen.ffi.done", "") }

    if trace_prog { print("[x64_compile] top-level globals start") }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.codegen.top_globals.start", "") }
    var top_info = _x64_collect_top_level_globals_and_stmts(ctx, runtime_stmts, user_stmts)
    if top_info == nil { return nil }
    if trace_prog { print("[x64_compile] top-level globals done") }
    if phase_log != nil {
        var top_ops = 0
        if top_info["top_stmt_count"] != nil { top_ops = top_info["top_stmt_count"] }
        _x64_program_phase_log_append(phase_log, "x64.codegen.top_globals.done",
            "top_stmts=" + oren_int_to_string(top_ops))
    }
    return top_info
}

fn _x64_prepare_program_callable_wrappers(ctx, linked2, top_info, type_ctors, trace_prog, phase_log) {
    _x64_collect_callable_uses(ctx, linked2, top_info, type_ctors, trace_prog, phase_log)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    var wrappers = _x64_prepare_lambda_wrappers(ctx, trace_prog, phase_log)
    if wrappers == nil { return nil }
    return wrappers
}

fn _x64_prepare_program_has_main(ctx) {
    if ctx["declared_functions"] != nil && ctx["declared_functions"]["main"] != nil { return true }
    return false
}

fn _x64_prepare_program_function_sets(ctx, linked2, runtime_stmts, user_stmts, used_rtobj, trace_prog, phase_log) {
    _x64_rewrite_program_local_function_sets(ctx, runtime_stmts, user_stmts, used_rtobj, trace_prog)

    var fns = _x64_collect_program_function_list(ctx, linked2, used_rtobj, trace_prog)
    if fns == nil { return nil }
    var type_ctors = _x64_collect_program_type_constructors(ctx, linked2, fns, trace_prog, phase_log)
    if type_ctors == nil { return nil }
    var has_main = _x64_prepare_program_has_main(ctx)

    var top_info = _x64_collect_program_ffi_and_globals(ctx, runtime_stmts, user_stmts, trace_prog, phase_log)
    if top_info == nil { return nil }
    var wrappers = _x64_prepare_program_callable_wrappers(ctx, linked2, top_info, type_ctors, trace_prog, phase_log)
    if wrappers == nil { return nil }
    return {"fns": fns, "type_ctors": type_ctors, "has_main": has_main, "top_info": top_info, "wrappers": wrappers}
}

fn _x64_prepare_program_debug_metadata(ctx, platform, fns, wrappers, used_rtobj, trace_prog, phase_log) {
    // Reserve a u64 slot holding the debug-info table offset so the entry stub can
    // read the final offset at runtime and derive a PIE-safe pointer.
    if platform != nil && platform["debug"] == true {
        var dbg_slot_off = _data_add_u64(ctx, 0)
        // Store as offset+1 so offset 0 is representable while still using `nil` as missing.
        ctx["dbginfo_table_slot_enc"] = dbg_slot_off + 1
    }

    var want_resolve_symbol = false
    var env_rs = oren_env("OREN_NATIVE_RESOLVE_SYMBOL")
    if env_rs != nil && env_rs == "1" { want_resolve_symbol = true }

    _x64_setup_program_debug_metadata(ctx, platform, fns, wrappers, used_rtobj, want_resolve_symbol)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    if trace_prog { print("[x64_compile] debug metadata setup done") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.metadata.done", "")
    }
    return true
}

fn _x64_prepare_program_entry_sequence_state(ctx, platform, opts_compile) {
    var trace_prog = opts_compile["trace_prog"] == true
    var trace_entry = opts_compile["trace_entry"] == true
    var phase_log = opts_compile["phase_log"]
    var entry_setup = _x64_emit_entry_prologue_and_args(ctx, platform, trace_prog, trace_entry, phase_log)
    if entry_setup == nil { return nil }
    var scratch_base = entry_setup["scratch_base"]
    var is_so = entry_setup["is_so"] == true

    _x64_emit_entry_runtime_bootstrap(ctx, platform, scratch_base, is_so, trace_prog, trace_entry, phase_log)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    _x64_emit_entry_global_roots(ctx, platform, scratch_base, trace_prog, phase_log)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    return {"trace_prog": trace_prog, "trace_entry": trace_entry, "phase_log": phase_log, "entry_setup": entry_setup}
}

fn _x64_program_entry_sequence_options(seq, opts_compile) {
    var entry_setup = seq["entry_setup"]
    return {
        "trace_prog": seq["trace_prog"],
        "trace_entry": seq["trace_entry"],
        "trace_entry_after_reg": opts_compile["trace_entry_after_reg"] == true,
        "skip_register_thread": opts_compile["skip_register_thread"] == true,
        "exit_after_register_thread": opts_compile["exit_after_register_thread"] == true,
        "skip_top_level": opts_compile["skip_top_level"] == true,
        "skip_main": opts_compile["skip_main"] == true,
        "is_dll": entry_setup["is_dll"] == true,
        "is_so": entry_setup["is_so"] == true,
        "entry_total": entry_setup["entry_total"],
        "dll_labels": entry_setup["dll_labels"],
        "dll_fixups": entry_setup["dll_fixups"]
    }
}

fn _x64_emit_program_entry_sequence_calls(ctx, platform, has_main, entry_opts, phase_log) {
    _x64_emit_entry_register_thread_call(ctx, platform, entry_opts, phase_log)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    _x64_emit_entry_top_and_main_calls(ctx, platform, has_main, entry_opts, phase_log)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    _x64_emit_entry_return_path(ctx, platform, entry_opts)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    return true
}

fn _x64_log_program_entry_sequence_done(ctx, trace_prog, phase_log) {
    if trace_prog { print("[x64_compile] entry stub done") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.done",
            "code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])))
    }
    return nil
}

fn _x64_emit_program_entry_sequence(ctx, platform, has_main, opts_compile) {
    var seq = _x64_prepare_program_entry_sequence_state(ctx, platform, opts_compile)
    if seq == nil { return false }
    var entry_opts = _x64_program_entry_sequence_options(seq, opts_compile)
    if _x64_emit_program_entry_sequence_calls(ctx, platform, has_main, entry_opts, seq["phase_log"]) != true { return false }
    _x64_log_program_entry_sequence_done(ctx, seq["trace_prog"], seq["phase_log"])
    return true
}

fn _x64_prepare_top_function(ctx, top_info, fns) {
    var top_fn = top_info["top_level_fn"]
    if top_fn == nil { err(ctx, "x64 native v0: missing synthesized __top_level__ fn"); return nil }
    coreir.infer_native_param_numeric_traits(ctx, fns, top_fn, "x64 native v0")
    return top_fn
}

fn _x64_apply_rtobj_code_if_used(ctx, used_rtobj, trace_prog) {
    if used_rtobj == true {
        if trace_prog { print("[x64_compile] rtobj code splice start") }
        _x64_rtobj_apply_code_to_ctx(ctx)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        if trace_prog { print("[x64_compile] rtobj code splice done") }
    }
    return true
}

fn _x64_log_rtobj_code_done(ctx, phase_log) {
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.rtobj_code.done",
            "code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])))
    }
    return nil
}

fn _x64_compile_top_level_function(ctx, top_fn, platform, call_depth_default_enabled, trace_prog) {
    if trace_prog { print("[x64_compile] compile __top_level__") }
    _compile_function_v0(ctx, top_fn, platform, false, call_depth_default_enabled)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    return true
}

fn _x64_compile_program_prepare_top(ctx, platform, top_info, fns, used_rtobj, trace_prog, trace_sum, phase_log) {
    var t_apply_rtobj_done = 0
    var t_top_done = 0
    var top_fn = _x64_prepare_top_function(ctx, top_info, fns)
    if top_fn == nil { return nil }

    if _x64_apply_rtobj_code_if_used(ctx, used_rtobj, trace_prog) != true { return nil }
    if trace_sum { t_apply_rtobj_done = oren_time_now_ns() }
    _x64_log_rtobj_code_done(ctx, phase_log)

    var call_depth_default_enabled = _x64_call_depth_default_enabled(platform)
    if _x64_compile_top_level_function(ctx, top_fn, platform, call_depth_default_enabled, trace_prog) != true { return nil }
    if trace_sum { t_top_done = oren_time_now_ns() }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.codegen.top.done", "") }
    return {
        "call_depth": call_depth_default_enabled,
        "apply_rtobj_done": t_apply_rtobj_done,
        "top_done": t_top_done
    }
}

fn _x64_compile_program_fn_loop_opts(opts_compile, trace_prog) {
    return {
        "trace_prog": trace_prog,
        "focus_enabled": opts_compile["focus_enabled"] == true,
        "prog_focus_from": opts_compile["prog_focus_from"],
        "prog_focus_to": opts_compile["prog_focus_to"],
        "prog_stride": opts_compile["prog_stride"],
        "prog_slow_fn_ms": opts_compile["prog_slow_fn_ms"],
        "trace_top_slow": opts_compile["trace_top_slow"] == true,
        "top_slow_n": opts_compile["top_slow_n"],
        "top_slow_min_ms": opts_compile["top_slow_min_ms"],
        "top_slow_live": opts_compile["top_slow_live"] == true,
        "top_slow_live_n": opts_compile["top_slow_live_n"],
        "fns_progress_interval": opts_compile["fns_progress_interval"],
        "fns_detail_limit": opts_compile["fns_detail_limit"]
    }
}

fn _x64_compile_program_tail_emitters(ctx, platform, wrappers, call_depth_default_enabled, trace_prog, trace_sum, phase_log) {
    var t_wrappers_done = 0
    var t_fnwrap_done = 0
    var t_panic_done = 0

    _x64_compile_lambda_wrappers(ctx, wrappers, platform, call_depth_default_enabled, trace_prog, phase_log)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_sum { t_wrappers_done = oren_time_now_ns() }

    _x64_compile_missing_fnwraps(ctx, platform, call_depth_default_enabled, phase_log)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_sum { t_fnwrap_done = oren_time_now_ns() }

    _x64_emit_ffi_stubs(ctx, platform)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _emit_panic_helper_fn_if_needed_x64(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_sum { t_panic_done = oren_time_now_ns() }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.codegen.panic_helper.done", "") }

    return {
        "wrappers_done": t_wrappers_done,
        "fnwrap_done": t_fnwrap_done,
        "panic_done": t_panic_done
    }
}

fn _x64_compile_program_function_sequence(ctx, platform, top_info, fns, wrappers, used_rtobj, opts_compile) {
    var trace_prog = opts_compile["trace_prog"] == true
    var trace_sum = opts_compile["trace_sum"] == true
    var phase_log = opts_compile["phase_log"]
    var t_fns_done = 0

    var top_times = _x64_compile_program_prepare_top(ctx, platform, top_info, fns, used_rtobj, trace_prog, trace_sum, phase_log)
    if top_times == nil { return nil }
    var call_depth_default_enabled = top_times["call_depth"]

    var fn_loop_opts = _x64_compile_program_fn_loop_opts(opts_compile, trace_prog)
    _x64_compile_user_function_set(ctx, fns, platform, call_depth_default_enabled, phase_log, fn_loop_opts)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if trace_sum { t_fns_done = oren_time_now_ns() }

    var tail_times = _x64_compile_program_tail_emitters(ctx, platform, wrappers, call_depth_default_enabled, trace_prog, trace_sum, phase_log)
    if tail_times == nil { return nil }

    return {
        "apply_rtobj_done": top_times["apply_rtobj_done"],
        "top_done": top_times["top_done"],
        "fns_done": t_fns_done,
        "wrappers_done": tail_times["wrappers_done"],
        "fnwrap_done": tail_times["fnwrap_done"],
        "panic_done": tail_times["panic_done"]
    }
}

fn _x64_native_program_start(linked, platform, opts_compile) {
    var trace_sum = opts_compile["trace_sum"] == true
    var phase_log = opts_compile["phase_log"]
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.codegen.enter", "") }
    var trace_prog = opts_compile["trace_prog"] == true
    var t0 = 0
    if trace_sum { t0 = oren_time_now_ns() }

    if trace_prog { print("[x64_compile] ctx init") }
    var ctx = _x64_new_ctx(linked, platform)
    ctx["phase_log"] = phase_log
    if trace_prog { print("[x64_compile] ctx init done") }
    if phase_log != nil { _x64_program_phase_log_append(phase_log, "x64.codegen.ctx.done", "") }
    return {"ctx": ctx, "t0": t0}
}

// @include "089_prepare_inputs.oren"

fn _x64_native_program_emit_body(ctx, platform, prep, opts_compile) {
    var trace_sum = opts_compile["trace_sum"] == true
    var trace_prog = opts_compile["trace_prog"] == true
    var phase_log = opts_compile["phase_log"]
    var used_rtobj = prep["used_rtobj"] == true
    var fns = prep["fns"]
    var wrappers = prep["wrappers"]
    var top_info = prep["top_info"]
    var has_main = prep["has_main"] == true
    var t_entry_done = 0
    if _x64_prepare_program_debug_metadata(ctx, platform, fns, wrappers, used_rtobj, trace_prog, phase_log) != true { return nil }
    if _x64_emit_program_entry_sequence(ctx, platform, has_main, opts_compile) != true { return nil }
    if trace_sum { t_entry_done = oren_time_now_ns() }

    var fn_times = _x64_compile_program_function_sequence(ctx, platform, top_info, fns, wrappers, used_rtobj, opts_compile)
    if fn_times == nil { return nil }

    _x64_finalize_program_data(ctx, platform, phase_log)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    if trace_sum {
        fn_times["finalize_done"] = oren_time_now_ns()
        fn_times["rtobj_done"] = prep["t_rtobj_done"]
        fn_times["entry_done"] = t_entry_done
    }
    return fn_times
}

fn native_compile_program_x64(linked, platform) {
    // x64 uses the shared native runtime bundle/object cache so arm64 and x64
    // converge on include expansion, capsule enforcement, DCE, and pinned roots.
    var opts_compile = _x64_program_compile_options()
    var start = _x64_native_program_start(linked, platform, opts_compile)
    var ctx = start["ctx"]
    var prep = _x64_native_program_prepare_inputs(ctx, linked, platform, opts_compile)
    if prep == nil { return ctx }
    var fn_times = _x64_native_program_emit_body(ctx, platform, prep, opts_compile)
    if fn_times == nil { return ctx }
    if opts_compile["trace_sum"] == true {
        _x64_print_program_compile_summary(ctx, platform, prep["used_rtobj"] == true, start["t0"], fn_times)
    }

    return ctx
}

	fn native_emit_errors_and_exit(ctx) {
	    if ctx == nil { return nil }
	    var errs = ctx["errors"]
	    if errs == nil || oren_list_len(errs) == 0 { return nil }
    var i = 0
    while i < oren_list_len(errs) {
        var e = errs[i]
        if e != nil { print(e) }
        i = i + 1
    }
    oren_exit(1)
    return nil
}
