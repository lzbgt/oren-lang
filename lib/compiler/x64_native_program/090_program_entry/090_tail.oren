fn _x64_record_user_function_slow(ctx, state, phase_log, i1, nm1, t_fn) {
    var opts2 = state["opts"]
    if opts2["trace_prog"] == true && opts2["prog_slow_fn_ms"] > 0 {
        var dt_ms = (oren_time_now_ns() - t_fn) / 1000000
        if dt_ms > opts2["prog_slow_fn_ms"] { print("[x64_compile] slow_fn ms=" + oren_int_to_string(dt_ms) + " name=" + nm1) }
    } else if opts2["trace_top_slow"] == true {
        var dt_ms2 = (oren_time_now_ns() - t_fn) / 1000000
        if dt_ms2 >= opts2["top_slow_min_ms"] {
            _x64_slow_fn_top_push(state["top_slow"], opts2["top_slow_n"], dt_ms2, nm1)
            if opts2["top_slow_live"] == true && phase_log != nil && state["top_slow_live_count"] < opts2["top_slow_live_n"] {
                _x64_program_phase_log_append(phase_log, "x64.codegen.fns.slow_live",
                    "i=" + oren_int_to_string(i1) +
                    " total=" + oren_int_to_string(state["fns_n"]) +
                    " ms=" + oren_int_to_string(dt_ms2) +
                    " name=" + nm1)
                state["top_slow_live_count"] = state["top_slow_live_count"] + 1
            }
        }
