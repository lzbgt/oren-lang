            if okg == 0 { break }
            roots_scanned = roots_scanned + 1
            var gname = pair[0]
            if _x64_global_root_name_is_skipped(gname) == true {
                gi2 = gi2 + 1
                continue
            }
            if skip_runtime_globals != nil && skip_runtime_globals != 0 &&
               gname != nil && runtime_globals != nil && runtime_globals[gname] != nil {
                gi2 = gi2 + 1
                continue
