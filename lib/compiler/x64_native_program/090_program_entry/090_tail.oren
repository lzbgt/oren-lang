        var v_stride = opts["prog_stride"]
        if oren_type_tag(v_stride) != 0 { prog_stride = v_stride }
        var v_slow_ms = opts["prog_slow_fn_ms"]
        if oren_type_tag(v_slow_ms) != 0 { prog_slow_fn_ms = v_slow_ms }
        if opts["trace_top_slow"] == true { trace_top_slow = true }
        var v_top_slow_n = opts["top_slow_n"]
        if oren_type_tag(v_top_slow_n) != 0 { top_slow_n = v_top_slow_n }
        var v_top_slow_min_ms = opts["top_slow_min_ms"]
        if oren_type_tag(v_top_slow_min_ms) != 0 { top_slow_min_ms = v_top_slow_min_ms }
        if opts["top_slow_live"] == true { top_slow_live = true }
        var v_top_slow_live_n = opts["top_slow_live_n"]
        if oren_type_tag(v_top_slow_live_n) != 0 { top_slow_live_n = v_top_slow_live_n }
        var v_fns_progress_interval = opts["fns_progress_interval"]
        if oren_type_tag(v_fns_progress_interval) != 0 { fns_progress_interval = v_fns_progress_interval }
        var v_fns_detail_limit = opts["fns_detail_limit"]
        if oren_type_tag(v_fns_detail_limit) != 0 { fns_detail_limit = v_fns_detail_limit }
    }
    return {
        "trace_prog": trace_prog,
        "focus_enabled": focus_enabled,
        "prog_focus_from": prog_focus_from,
        "prog_focus_to": prog_focus_to,
        "prog_stride": prog_stride,
        "prog_slow_fn_ms": prog_slow_fn_ms,
        "trace_top_slow": trace_top_slow,
        "top_slow_n": top_slow_n,
        "top_slow_min_ms": top_slow_min_ms,
        "top_slow_live": top_slow_live,
        "top_slow_live_n": top_slow_live_n,
        "fns_progress_interval": fns_progress_interval,
