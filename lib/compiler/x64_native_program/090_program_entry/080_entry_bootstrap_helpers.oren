}

fn _x64_emit_entry_capsule_and_gc(ctx, platform, trace_prog, trace_entry, phase_log) {
    var call_capsule_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_capsule_pos, "name": "native_runtime_capsule_init"})
    if trace_prog { print("[x64_compile] capsule init call emitted") }

    var gc_default = 1
    if platform != nil && platform["no_gc"] == true { gc_default = 0 }
    if platform != nil && platform["os"] == "windows" {
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, gc_default))
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, gc_default))
    }
    var call_gc_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_gc_pos, "name": "native_runtime_init_gc_mode"})
    if trace_entry && platform != nil && platform["os"] == "windows" {
        _emit_windows_write_cstr(ctx, "ENTRY: gc_mode ok")
    }
    if trace_prog { print("[x64_compile] gc mode call emitted") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.gc_mode.done",
            "fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }
}
