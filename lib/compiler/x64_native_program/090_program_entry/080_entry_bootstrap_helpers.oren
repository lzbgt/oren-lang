fn _x64_emit_entry_heap_and_frame_init(ctx) {
    // Native heap registers (rolling Tier-1 design):
    // R15 = heap_ptr, R14 = heap_limit. Zeroing forces first allocation through slow path.
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(14, 0))
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(15, 0))

    // Entry is not a C runtime; terminate best-effort frame walking cleanly.
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(5, 0))
}

fn _x64_emit_entry_boot_globals(ctx) {
    var st = _x64_entry_boot_global_offsets(ctx)
    if st == nil { return nil }
    _x64_entry_boot_emit_storage_ptrs(ctx, st)
    _x64_entry_boot_link_storage(ctx)
    return true
}

fn _x64_entry_boot_global_offsets(ctx) {
    if ctx["globals"] == nil || ctx["globals"]["g_storage"] == nil {
        err(ctx, "x64 native v0: missing reserved global slot g_storage (Tier-1 bootstrap)")
        return nil
    }
    if ctx["boot_globals_storage_off_enc"] == nil {
        err(ctx, "x64 native v0: missing boot globals storage offset (Tier-1 bootstrap)")
        return nil
    }
    var g_storage_off = ctx["globals"]["g_storage"] - 1
    var boot_off = ctx["boot_globals_storage_off_enc"] - 1
    return {"g_storage_off": g_storage_off, "boot_off": boot_off}
}

fn _x64_entry_boot_emit_storage_ptrs(ctx, st) {
    var lea_gs_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_gs_pos + 3, "data_off": st["g_storage_off"]})

    var lea_boot_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(11, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_boot_pos + 3, "data_off": st["boot_off"]})
    return nil
}

fn _x64_entry_boot_link_storage(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(10, 11))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 11))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(12, 392))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(11, 368, 12))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(12, 8))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(11, 376, 12))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(12, 8))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64_disp(11, 384, 12))
    return nil
}

fn _x64_emit_entry_capture_args(ctx, platform, scratch_base, is_so) {
    if platform != nil && platform["os"] == "windows" { return nil }

    if is_so {
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(0, 0))
        _emit_mov_mrsp_r64(ctx, scratch_base + 0, 0)
        _emit_mov_mrsp_r64(ctx, scratch_base + 8, 0)
        _emit_mov_mrsp_r64(ctx, scratch_base + 16, 0)
        return nil
    }

    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(10, 13))
    _emit_mov_mrsp_r64(ctx, scratch_base + 0, 10)

    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 13))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 8))
    _emit_mov_mrsp_r64(ctx, scratch_base + 8, 11)

    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 10))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(12, 2))
    bytes_extend(ctx["code"], core.insn_shl_r64_imm8(12, 3))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(12, 13))
    _emit_mov_mrsp_r64(ctx, scratch_base + 16, 12)
    return nil
}

fn _x64_emit_entry_native_runtime_init(ctx, platform, target_os_id, trace_prog, trace_entry, phase_log) {
    if platform != nil && platform["os"] == "windows" {
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, target_os_id))
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, target_os_id))
    }
    var call_init_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_init_pos, "name": "native_runtime_init"})
    if trace_entry && platform != nil && platform["os"] == "windows" {
        _emit_windows_write_cstr(ctx, "ENTRY: runtime_init ok")
    }
    if trace_prog { print("[x64_compile] runtime init call emitted") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.runtime_init.done",
            "fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }
}

fn _x64_entry_cstr0_slot_off(ctx) {
    var slot_off_enc = ctx["cstr0_table_slot_enc"]
    if oren_type_tag(slot_off_enc) != 1 { return nil }
    if slot_off_enc <= 0 { return nil }
    return slot_off_enc - 1
}

fn _x64_emit_entry_cstr0_table_ptr(ctx, slot_off) {
    var lea_slot_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_slot_pos + 3, "data_off": slot_off})
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(11, 10))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 10))
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(12, core.int_mod(slot_off, 4294967296)))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(12, 11))
    return nil
}

fn _x64_emit_entry_cstr0_arg(ctx, platform) {
    if platform != nil && platform["os"] == "windows" {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 12))
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 12))
    }
    return nil
}

fn _x64_emit_entry_cstr0_call(ctx, platform, trace_entry) {
    _x64_emit_entry_cstr0_arg(ctx, platform)
    var call_cstr_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_cstr_pos, "name": "oren_init_static_cstr0_table"})
    if trace_entry && platform != nil && platform["os"] == "windows" {
        _emit_windows_write_cstr(ctx, "ENTRY: cstr0_table ok")
    }
    return nil
}

fn _x64_log_entry_static_cstr_table(ctx, trace_prog, phase_log) {
    if trace_prog { print("[x64_compile] cstr0 table call emitted") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.cstr0_call.done",
            "fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }
    return nil
}

fn _x64_emit_entry_static_cstr_table(ctx, platform, trace_prog, trace_entry, phase_log) {
    var slot_off = _x64_entry_cstr0_slot_off(ctx)
    if slot_off != nil {
        _x64_emit_entry_cstr0_table_ptr(ctx, slot_off)
        _x64_emit_entry_cstr0_call(ctx, platform, trace_entry)
    }
    _x64_log_entry_static_cstr_table(ctx, trace_prog, phase_log)
    return nil
}

fn _x64_entry_debug_info_slot_off(ctx) {
    var dbg_slot_off_enc = ctx["dbginfo_table_slot_enc"]
    if oren_type_tag(dbg_slot_off_enc) != 1 { return -1 }
    if dbg_slot_off_enc <= 0 { return -1 }
    return dbg_slot_off_enc - 1
}

fn _x64_emit_entry_debug_info_static_addr(ctx, dbg_slot_off, labels_dbg, fixups_dbg, l_skip_dbg) {
    var lea_dbg_slot_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_dbg_slot_pos + 3, "data_off": dbg_slot_off})
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(11, 10))

    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, fixups_dbg, "e", l_skip_dbg)

    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 10))
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(12, core.int_mod(dbg_slot_off, 4294967296)))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(12, 11))
    return nil
}

fn _x64_emit_entry_debug_info_args(ctx, platform) {
    if platform != nil && platform["os"] == "windows" {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 12))
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 12))
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 12))
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(6, 12))
    }
    return nil
}

fn _x64_emit_entry_debug_info_call(ctx, platform, trace_entry) {
    _x64_emit_entry_debug_info_args(ctx, platform)
    var call_dbg_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_dbg_pos, "name": "oren_set_debug_info"})
    if trace_entry && platform != nil && platform["os"] == "windows" {
        _emit_windows_write_cstr(ctx, "ENTRY: set_debug_info ok")
    }
    return nil
}

fn _x64_log_entry_debug_info_done(ctx, trace_prog, phase_log) {
    if trace_prog { print("[x64_compile] debug-info call emitted") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.dbginfo_call.done",
            "fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }
    return nil
}

fn _x64_emit_entry_debug_info(ctx, platform, trace_prog, trace_entry, phase_log) {
    var dbg_slot_off = _x64_entry_debug_info_slot_off(ctx)
    if dbg_slot_off >= 0 {
        var labels_dbg = {}
        var fixups_dbg = []
        var l_skip_dbg = _new_label(ctx, "dbginfo_skip")
        _x64_emit_entry_debug_info_static_addr(ctx, dbg_slot_off, labels_dbg, fixups_dbg, l_skip_dbg)
        _x64_emit_entry_debug_info_call(ctx, platform, trace_entry)
        _emit_label(ctx, labels_dbg, l_skip_dbg)
        _patch_local_fixups(ctx, labels_dbg, fixups_dbg)
    }
    _x64_log_entry_debug_info_done(ctx, trace_prog, phase_log)
}

fn _x64_emit_entry_set_args(ctx, platform, scratch_base, trace_prog, trace_entry, phase_log) {
    if platform != nil && platform["os"] == "windows" {
        _emit_mov_r64_mrsp(ctx, 1, scratch_base + 0)
        _emit_mov_r64_mrsp(ctx, 2, scratch_base + 8)
    } else {
        _emit_mov_r64_mrsp(ctx, 7, scratch_base + 0)
        _emit_mov_r64_mrsp(ctx, 6, scratch_base + 8)
    }
    var call_set_args_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_set_args_pos, "name": "native_runtime_set_args"})
    if trace_entry && platform != nil && platform["os"] == "windows" {
        _emit_windows_write_cstr(ctx, "ENTRY: set_args ok")
    }
    if trace_prog { print("[x64_compile] set args call emitted") }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.entry.args.done",
            "fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }
}

fn _x64_emit_entry_windows_envp(ctx, platform, scratch_base, trace_entry) {
    if platform == nil || platform["os"] != "windows" { return nil }

    _emit_mov_r64_mrsp(ctx, 10, scratch_base + 16)
    _emit_mov_mrsp_r64(ctx, scratch_base + 32, 10)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 10))
    var call_build_envp_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_build_envp_pos, "name": "native_envp_build_from_win_envblock"})
    _emit_mov_mrsp_r64(ctx, scratch_base + 16, 0)

    var labels_free_env = {}
    var local_fixups_free_env = []
    var l_skip_free_env = _new_label(ctx, "win_envblock_free_skip")
    _emit_mov_r64_mrsp(ctx, 1, scratch_base + 32)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(1, 0))
    _emit_jcc_to_label(ctx, local_fixups_free_env, "e", l_skip_free_env)
    var mov_iat_free_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat_free_pos + 3, "IAT_FreeEnvironmentStringsA")
    bytes_extend(ctx["code"], core.insn_call_rax())
    _emit_label(ctx, labels_free_env, l_skip_free_env)
    _patch_local_fixups(ctx, labels_free_env, local_fixups_free_env)
    if trace_entry { _emit_windows_write_cstr(ctx, "ENTRY: envp ok") }
    return nil
}

fn _x64_emit_entry_set_envp(ctx, platform, scratch_base, trace_prog, trace_entry, phase_log) {
    if platform != nil && platform["os"] == "windows" {
        _emit_mov_r64_mrsp(ctx, 1, scratch_base + 16)
    } else {
        _emit_mov_r64_mrsp(ctx, 7, scratch_base + 16)
