fn _x64_init_symtab_display(ctx) {
    // Display label mapping used by the embedded debug-info table.
    // - key: real function name (used to look up code offsets)
    // - value: display label (may include source location)
    ctx["symtab_display"] = {"__entry_stub__": "__entry_stub__", "__top_level__": "__top_level__@<top-level>"}
    return nil
}

fn _x64_symtab_display_for_user_fn(fn0) {
    if fn0 == nil || fn0["name"] == nil || fn0["name"] == "" { return nil }
    var nm1 = fn0["name"]
    var disp = nm1
    var tok0 = fn0["token"]
    if tok0 != nil && tok0["file"] != nil && tok0["line"] != nil {
        disp = nm1 + "@" + tok0["file"] + ":" + oren_int_to_string(tok0["line"])
    }
    return {"name": nm1, "display": disp}
}

fn _x64_setup_user_symtab_display(ctx, fns) {
    // User functions are deterministic in source order.
    var fns_len = oren_list_len(fns)
    var si0 = 0
    while si0 < fns_len {
        var ent = _x64_symtab_display_for_user_fn(fns[si0])
        if ent != nil { ctx["symtab_display"][ent["name"]] = ent["display"] }
        si0 = si0 + 1
    }
    return nil
}

fn _x64_setup_wrapper_symtab_display(ctx, wrappers) {
    // Wrappers are compiler-synthesized; keep them clearly marked in stack traces.
    var wrappers_len = oren_list_len(wrappers)
    var si0 = 0
    while si0 < wrappers_len {
        var w0 = wrappers[si0]
        if w0 != nil && w0["name"] != nil && w0["name"] != "" {
            var wnm = w0["name"]
            ctx["symtab_display"][wnm] = wnm + "@<generated>"
        }
        si0 = si0 + 1
    }
    return nil
}

fn _x64_setup_ffi_symtab_display(ctx, imports0) {
    if imports0 == nil { return nil }
    var imports0_len = oren_list_len(imports0)
    var ii0 = 0
    while ii0 < imports0_len {
        var inm = imports0[ii0]
        if inm != nil && inm != "" {
            ctx["symtab_display"][inm] = inm + "@<ffi>"
        }
        ii0 = ii0 + 1
    }
    return nil
}

fn _x64_setup_symtab_display(ctx, fns, wrappers, imports0) {
    _x64_init_symtab_display(ctx)
    _x64_setup_user_symtab_display(ctx, fns)
    _x64_setup_wrapper_symtab_display(ctx, wrappers)
    _x64_setup_ffi_symtab_display(ctx, imports0)
    return nil
}
