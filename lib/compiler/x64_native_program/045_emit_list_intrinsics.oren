    if oren_type_tag(base) == 0 { return nil }
    var off_list = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(off_list) == 0 { _intr_tmp_pop(ctx, base); return nil }

    // LTR eval: list -> spill
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - off_list, 0)

    // list -> rdx
    _emit_mov_r64_mrbp(ctx, 2, 0 - off_list)

    var labels = {}
    var local_fixups = []
    var l_non_nil = _new_label(ctx, "list_len_non_nil")
    var l_done = _new_label(ctx, "list_len_done")

    // nil => 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_non_nil)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_non_nil)

    // Tier‑1 safety: never read object headers from untracked pointers.
    _emit_find_tracked_node_x64(ctx, 2, 11) // r11 = node or 0
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    // NOTE: `_emit_find_tracked_node_x64` calls into the injected runtime (native_alloc_index_get),
    // so treat all caller-saved registers as clobbered. Reload the list pointer from the spill
    // slot before continuing to dereference headers.
    _emit_mov_r64_mrbp(ctx, 2, 0 - off_list)

    // tracked?
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    var l_node_ok = _new_label(ctx, "list_len_node_ok")
    var l_node_missing = _new_label(ctx, "list_len_node_missing")
    var l_fallback_magic_ok = _new_label(ctx, "list_len_fallback_magic_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_node_ok)
    _emit_jmp_to_label(ctx, local_fixups, l_node_missing)

    _emit_label(ctx, labels, l_node_missing)
    // Untracked but valid list header: fallback to magic + count.
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1279870019)) // list_magic()
    _emit_jcc_to_label(ctx, local_fixups, "e", l_fallback_magic_ok)
    _emit_abort_panic_str(ctx, "list_len on non-list")
    _emit_label(ctx, labels, l_fallback_magic_ok)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_node_ok)

    // kind = *(node + 16); accept LIST and LIST_INT.
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 10))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 2)) // LIST
    var l_kind_ok = _new_label(ctx, "list_len_kind_ok")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_kind_ok)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 8)) // LIST_INT
    _emit_jcc_to_label(ctx, local_fixups, "e", l_kind_ok)
    _emit_abort_panic_str(ctx, "list_len on non-list")
    _emit_label(ctx, labels, l_kind_ok)

    // magic = *(list + 24)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1279870019)) // list_magic()
    var l_magic_ok = _new_label(ctx, "list_len_magic_ok")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_magic_ok)
    _emit_abort_panic_str(ctx, "list_len on non-list")
    _emit_label(ctx, labels, l_magic_ok)

    // count = *(list + 0)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

