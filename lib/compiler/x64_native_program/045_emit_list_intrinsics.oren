// x64-native list intrinsics (`oren_list_len`, `oren_list_push`).
//
// Tier‑1 parity notes:
// - arm64 native inlines these ops with a tracked-kind gate first (never probes headers on
//   untracked integers), then validates the list magic constant.
// - x64 native shares the same semantic contract: container ops must be deterministic and
//   must not dereference untracked values.
//
// Runtime layout (lists):
//   [0]  count (u64)
//   [8]  capacity (u64)
//   [16] buffer_ptr (u64)
//   [24] magic (u64) == 1279870019 ("LIST")

fn _emit_call_rel32_1arg_x64(ctx, locals, sym, arg0_off) {
    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    if oren_type_tag(a0_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg reg for call1 " + sym)
        return nil
    }
    var a0 = a0_enc - 1
    _emit_mov_r64_mrbp(ctx, a0, 0 - arg0_off)
    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": sym})
    return nil
}

fn _emit_call_rel32_4args_x64(ctx, locals, sym, arg0_off, arg1_reg, arg2_imm, arg3_imm) {
    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    var a1_enc = abi.int_arg_reg(ctx["abi"], 1)
    var a2_enc = abi.int_arg_reg(ctx["abi"], 2)
    var a3_enc = abi.int_arg_reg(ctx["abi"], 3)
    if oren_type_tag(a0_enc) == 0 || oren_type_tag(a1_enc) == 0 || oren_type_tag(a2_enc) == 0 || oren_type_tag(a3_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg reg for call4 " + sym)
        return nil
    }
    var a0 = a0_enc - 1
    var a1 = a1_enc - 1
    var a2 = a2_enc - 1
    var a3 = a3_enc - 1
    _emit_mov_r64_mrbp(ctx, a0, 0 - arg0_off)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(a1, arg1_reg))
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(a2, arg2_imm))
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(a3, arg3_imm))
    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": sym})
    return nil
}

fn _x64_emit_list_magic_cmp(ctx) {
    // magic = *(list + 24), compared in RAX using r10 as the address scratch.
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 1279870019)) // list_magic()
    return nil
}

fn _x64_list_len_validate_single_arg_expr(ctx, expr, locals, intrinsic_name) {
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: " + intrinsic_name + " requires locals"); return nil }
    if ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: " + intrinsic_name + " requires injected native runtime")
        return nil
    }
    if expr == nil { err(ctx, "x64 native v0: missing " + intrinsic_name + " expr"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: " + intrinsic_name + " does not support spread"); return nil }

    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 {
        err(ctx, "x64 native v0: " + intrinsic_name + " expects 1 arg")
        return nil
    }
    return args
}

fn _x64_list_len_spill_validated_arg(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 1)
    if oren_type_tag(base) == 0 { return nil }
    var off_list = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(off_list) == 0 { _intr_tmp_pop(ctx, base); return nil }

    // LTR eval: list -> spill
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - off_list, 0)

    return [base, off_list]
}

