    _emit_mov_r64_mrbp(ctx, 2, 0 - off_list) // rdx = list
    _emit_mov_r64_mrbp(ctx, 8, 0 - off_val)  // r8  = value

    // tracked?
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    var l_node_ok = _new_label(ctx, "list_push_node_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_node_ok)
    _emit_abort_panic_str(ctx, "list_push on non-list")
    _emit_label(ctx, labels, l_node_ok)

