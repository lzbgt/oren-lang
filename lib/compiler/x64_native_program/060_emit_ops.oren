fn _x64_match_fast_list_int_push_while(ctx, op, locals) {
    if op == nil || op["op"] != "while" { return nil }
    if locals == nil { return nil }
    var cond = op["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _x64_is_ident(cond["left"])
    var n_name = _x64_is_ident(cond["right"])
    if idx_name == nil || n_name == nil { return nil }
    var off_idx = locals[idx_name]
    var off_n = locals[n_name]
    if oren_type_tag(off_idx) == 0 || oren_type_tag(off_n) == 0 { return nil }
    if ctx["locals_inty"] != nil {
        if ctx["locals_inty"][idx_name] != true { return nil }
        if ctx["locals_inty"][n_name] != true { return nil }
    }
    var body = op["body"]
    if body == nil { return nil }
    var n = oren_list_len(body)
    if n < 1 { return nil }
    var last = body[n - 1]
    if _x64_is_simple_inc_op(last, idx_name) != true { return nil }
    var lists = []
    var pushes = []
    var i = 0
    while i < n - 1 {
        var st = body[i]
        if st == nil || st["op"] != "expr" { return nil }
        var exp = st["expr"]
        var info = _x64_is_list_int_push_call(ctx, exp)
        if info == nil { return nil }
        var list_name = info["list"]
        if oren_type_tag(locals[list_name]) == 0 { return nil }
        if _x64_list_contains(lists, list_name) { return nil }
        if _x64_expr_is_inty(ctx, info["value"]) != true { return nil }
        oren_list_push(lists, list_name)
        oren_list_push(pushes, info)
        i = i + 1
    }
    if oren_list_len(lists) == 0 { return nil }
    return {"idx": idx_name, "n": n_name, "lists": lists, "pushes": pushes}
}

fn _x64_match_fast_list_int_get_sum_while(ctx, op, locals) {
