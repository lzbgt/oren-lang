    if et == "Identifier" { return _x64_str_eq_bytes(exp["value"], name) }
    if et == "Integer" || et == "Float" || et == "String" || et == "Boolean" || et == "Nil" { return false }
    if et == "Prefix" { return _x64_expr_uses_ident(exp["right"], name) }
    if et == "Infix" {
        if _x64_expr_uses_ident(exp["left"], name) { return true }
        return _x64_expr_uses_ident(exp["right"], name)
    }
    if et == "Call" {
