    } else if exp["fn"]["type"] == "Member" {
        var nsr = _x64_ns_resolve(ctx, exp["fn"])
        if nsr != nil {
            nm = nsr["name"]
        } else {
            var left = exp["fn"]["left"]
            var prop = exp["fn"]["prop"]
            if left != nil && prop != nil && left["type"] == "Identifier" && left["value"] == "list" {
                if prop["value"] == "int_get" { nm = "STD_list_int_get" }
            }
        }
    }
    if nm == nil { return nil }
    if nm != "oren_list_int_get" && nm != "STD_list_int_get" { return nil }
    var args = exp["args"]
    if args == nil || oren_list_len(args) != 2 { return nil }
    var list_name = _x64_is_ident(args[0])
    var idx = _x64_is_ident(args[1])
    if list_name == nil || idx == nil { return nil }
    if _x64_str_eq_bytes(idx, idx_name) != true { return nil }
    return list_name
}

fn _x64_is_sum_add_list_int_get(ctx, op, idx_name) {
    if op == nil || op["op"] != "assign_i32" { return nil }
