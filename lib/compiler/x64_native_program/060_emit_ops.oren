    }
    if et == "Index" {
        if _x64_expr_uses_ident(exp["left"], name) { return true }
        return _x64_expr_uses_ident(exp["index"], name)
    }
    if et == "Array" {
        var xs = exp["elements"]
        var j = 0
        while j < oren_list_len(xs) {
