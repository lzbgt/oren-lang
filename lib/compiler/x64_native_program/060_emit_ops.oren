fn _x64_emit_ops_trace_progress(ctx, trace, trace_stride, j, n, op, op_kind) {
    if trace != true { return nil }
    if core.int_mod(j, trace_stride) != 0 { return nil }
    var opk = op_kind
    if opk == nil { opk = "?" }
    var extra = ""
    if opk == "var_i32" || opk == "assign_i32" {
        var nm = op["name"]
        if nm != nil && nm != "" { extra = " name=" + nm }
    }
    var loc = ""
    var tok = op["tok"]
    if tok != nil && tok["file"] != nil && tok["line"] != nil {
        loc = " @" + tok["file"] + ":" + oren_int_to_string(tok["line"])
    }
    print("[x64_emit_ops] j=" + oren_int_to_string(j) + "/" + oren_int_to_string(n) + " op=" + opk + extra + loc)
    return nil
}

