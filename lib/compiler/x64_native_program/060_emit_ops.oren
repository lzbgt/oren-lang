    _x64_program_phase_log_append(phase_log, "x64.codegen.function.body.progress",
        "name=" + phase_name +
        " i=" + oren_int_to_string(j) +
        " total=" + oren_int_to_string(n) +
        " op=" + opk_phase +
        " code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])) +
        loc_phase)
    return nil
}

fn _x64_patch_dynamic_gas_if_needed(ctx, dynamic_note_pos, dynamic_span_start) {
    if dynamic_note_pos != nil && dynamic_span_start != nil {
        _patch_native_gas_note_x64_u32(ctx, dynamic_note_pos, bytes_len(ctx["code"]) - dynamic_span_start)
    }
    return nil
}

fn _x64_emit_ops_record_slow(ctx, trace_op_slow, phase_log, phase_name, op, op_kind, j, op_start_ns, op_slow_ms) {
    if trace_op_slow != true { return nil }
    var generic_op_ms = (oren_time_now_ns() - op_start_ns) / 1000000
    if generic_op_ms < op_slow_ms { return nil }
    var generic_op_name = op_kind
    if generic_op_name == nil { generic_op_name = "?" }
    var generic_loc = ""
    var generic_tok = op["tok"]
    if generic_tok != nil && generic_tok["file"] != nil && generic_tok["line"] != nil {
        generic_loc = " file=" + generic_tok["file"] + " line=" + oren_int_to_string(generic_tok["line"])
    }
    var generic_extra = ""
    if op["name"] != nil { generic_extra = " target=" + op["name"] }
    _x64_program_phase_log_append(phase_log, "x64.codegen.function.op.slow",
        "name=" + phase_name +
        " i=" + oren_int_to_string(j) +
        " op=" + generic_op_name +
        " path=generic" +
        " ms=" + oren_int_to_string(generic_op_ms) +
        generic_extra +
        generic_loc)
    return nil
}

fn _x64_emit_regular_op(ctx, op_kind, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, j, op_start_ns, op_slow_ms, top_string_fast_stats, gas_weighted, gas_dynamic) {
    if op_kind == "var_i32" {
        _emit_var_i32_op_x64(ctx, op, locals)
        return 0
    }
    if op_kind == "global_string_init" {
        _emit_global_string_init_op_x64(ctx, op, j, op_start_ns, op_slow_ms)
        return 0
    }
    if op_kind == "global_string_init_batch" {
        _emit_global_string_init_batch_op_x64(ctx, op, j, op_start_ns, op_slow_ms)
        return 0
    }
    if op_kind == "assign_i32" {
        var assign_status = _emit_assign_i32_op_x64(ctx, op, locals, platform, j, op_start_ns, op_slow_ms, top_string_fast_stats)
        if assign_status == 1 { return 1 }
        return 0
    }
    if op_kind == "expr" {
        _expr_int_check(ctx, op["expr"], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
        _emit_eval_int_to_rax(ctx, op["expr"], locals)
        return 0
    }
    if op_kind == "print_str_expr" {
        _emit_print_stmt_str_x64(ctx, locals, op["expr"])
        return 0
    }
    if op_kind == "print_cstr" {
        if platform != nil && platform["os"] == "linux" {
            _emit_linux_write_cstr(ctx, op["value"])
        } else if platform != nil && platform["os"] == "windows" {
            _emit_windows_write_cstr(ctx, op["value"])
        } else {
            err(ctx, "x64 native v0: print unsupported on this target")
        }
        return 0
    }
    if op_kind == "return" {
        _expr_int_check(ctx, op["expr"], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
        _emit_eval_int_to_rax(ctx, op["expr"], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
        _emit_jmp_to_label(ctx, local_fixups, epilogue_label)
        return 0
    }
    if op_kind == "if" {
        var cond = op["cond"]
        var else_label = _new_label(ctx, "if_else")
        var end_label = _new_label(ctx, "if_end")
        _emit_jcc_false_for_cond_x64(ctx, cond, locals, local_fixups, else_label)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
        _emit_ops_in_fn(ctx, op["then"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
        _emit_jmp_to_label(ctx, local_fixups, end_label)
        _emit_label(ctx, labels, else_label)
        _emit_ops_in_fn(ctx, op["else"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
        _emit_label(ctx, labels, end_label)
        return 0
    }
    if op_kind == "while" {
        _emit_while_op_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform)
        return 0
    }
    if op_kind == "for" {
        _emit_for_op_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, gas_weighted, gas_dynamic)
        return 0
    }
    if op_kind == "break" {
        if loop_end_label == nil { err(ctx, "x64 native v0: break outside loop"); return 0 }
        _emit_jmp_to_label(ctx, local_fixups, loop_end_label)
        return 0
    }
    if op_kind == "continue" {
        if loop_cond_label == nil { err(ctx, "x64 native v0: continue outside loop"); return 0 }
        _emit_jmp_to_label(ctx, local_fixups, loop_cond_label)
        return 0
    }
    err(ctx, "x64 native v0: unknown op in main")
    return 0
}

fn _emit_ops_in_fn(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label) {
    var n = 0
    if ops != nil { n = oren_list_len(ops) }
    var trace = false
    if ctx != nil && ctx["trace_emit_ops"] == true { trace = true }
    var trace_stride = 200
    if trace {
        trace_stride = core.parse_int_decimal(oren_env("OREN_TRACE_X64_EMIT_OPS_STRIDE"), trace_stride)
        if trace_stride < 1 { trace_stride = 1 }
    }
    var phase_log = nil
    var phase_name = nil
    var phase_stride = 0
    var phase_outer = false
    if ctx != nil {
        phase_log = ctx["emit_ops_phase_log"]
        phase_name = ctx["emit_ops_phase_name"]
        var stride_enc = ctx["emit_ops_phase_stride"]
        if oren_type_tag(stride_enc) != 0 { phase_stride = stride_enc }
    }
    if phase_log != nil && phase_name != nil && phase_stride > 0 && loop_cond_label == nil && loop_end_label == nil {
        phase_outer = true
    }
    var op_slow_ms = 0
    var v_op_slow = oren_env("OREN_TRACE_X64_EMIT_OP_SLOW_MS")
    if v_op_slow != nil && v_op_slow != "" {
        op_slow_ms = core.parse_int_decimal(v_op_slow, op_slow_ms)
    }
    var trace_op_slow = false
    if phase_log != nil && phase_name != nil && op_slow_ms > 0 { trace_op_slow = true }
    var top_string_fast_stats = {"candidates": 0, "hits": 0, "miss_type": 0}
    if trace { print("[x64_emit_ops] enter len=" + oren_int_to_string(n)) }
    var gas_mode = "none"
    if ctx != nil { gas_mode = _x64_native_gas_accounting_mode(ctx) }
    var gas_stmt = gas_mode == "stmt"
    var gas_basic = gas_mode == "basic-block" || gas_mode == "block-weighted"
    var gas_weighted = gas_mode == "block-weighted"
    var gas_dynamic = gas_mode == "dynamic-emitter"
    var j = 0
    var charge_basic_block_next = true
    while j < n {
        var op_start_ns = 0
        if trace_op_slow == true { op_start_ns = oren_time_now_ns() }
        var op = oren_list_get(ops, j)
        if op == nil { j = j + 1; continue }
        var next = nil
        if j + 1 < n { next = oren_list_get(ops, j + 1) }
        if _x64_should_skip_reserve_op(op, next, ctx, locals) == true {
            j = j + 1
            continue
        }
        var op_kind = op["op"]
        _x64_emit_ops_trace_progress(ctx, trace, trace_stride, j, n, op, op_kind)
        _x64_emit_ops_phase_progress(ctx, phase_outer, phase_log, phase_name, phase_stride, j, n, op, op_kind)
        _linetab_record_tok(ctx, op["tok"])
        var dynamic_note_pos = nil
        var dynamic_span_start = nil
        if gas_dynamic == true && op_kind != "if" && op_kind != "while" && op_kind != "for" {
            dynamic_note_pos = _emit_native_gas_note_x64_patchable_u32(ctx)
            dynamic_span_start = bytes_len(ctx["code"])
        } else if gas_stmt == true {
            _emit_native_gas_note_x64(ctx, 1)
        } else if gas_basic == true && charge_basic_block_next == true {
            var block_gas_amount = 1
            if gas_weighted == true {
                block_gas_amount = _x64_native_block_weighted_gas_amount(ops, j)
            }
            _emit_native_gas_note_x64(ctx, block_gas_amount)
            charge_basic_block_next = false
        }
        if op_kind == "global_string_init_batch" && oren_type_tag(op["table_off"]) == 1 {
            var prebuilt_batch_start_ns = 0
            if trace_op_slow == true { prebuilt_batch_start_ns = oren_time_now_ns() }
            _x64_emit_top_string_global_batch_loop(ctx, op["table_off"])
            if trace_op_slow == true {
                var prebuilt_batch_ms = (oren_time_now_ns() - prebuilt_batch_start_ns) / 1000000
                if prebuilt_batch_ms >= op_slow_ms {
                    _x64_program_phase_log_append(phase_log, "x64.codegen.function.op.slow",
                        "name=" + phase_name +
                        " i=" + oren_int_to_string(j) +
                        " op=global_string_init_batch" +
                        " path=prebuilt_table" +
                        " ms=" + oren_int_to_string(prebuilt_batch_ms) +
                        " count=" + oren_int_to_string(op["count"]))
                }
            }
            _x64_patch_dynamic_gas_if_needed(ctx, dynamic_note_pos, dynamic_span_start)
            j = j + 1
            continue
        }
        if op_kind == "global_empty_container_init_batch" && oren_type_tag(op["table_off"]) == 1 {
            var empty_batch_start_ns = 0
            if trace_op_slow == true { empty_batch_start_ns = oren_time_now_ns() }
            _x64_emit_top_empty_container_batch_loop(ctx, op["table_off"], op["kind"], platform)
            if trace_op_slow == true {
                var empty_batch_ms = (oren_time_now_ns() - empty_batch_start_ns) / 1000000
                if empty_batch_ms >= op_slow_ms {
                    _x64_program_phase_log_append(phase_log, "x64.codegen.function.op.slow",
                        "name=" + phase_name +
                        " i=" + oren_int_to_string(j) +
                        " op=global_empty_container_init_batch" +
                        " path=prebuilt_table" +
                        " kind=" + op["kind"] +
                        " ms=" + oren_int_to_string(empty_batch_ms) +
                        " count=" + oren_int_to_string(op["count"]))
                }
            }
            _x64_patch_dynamic_gas_if_needed(ctx, dynamic_note_pos, dynamic_span_start)
            j = j + 1
            continue
        }
        var op_status = _x64_emit_regular_op(ctx, op_kind, op, locals, labels, local_fixups,
            epilogue_label, platform, loop_cond_label, loop_end_label, j, op_start_ns,
            op_slow_ms, top_string_fast_stats, gas_weighted, gas_dynamic)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        if op_status == 1 {
            _x64_patch_dynamic_gas_if_needed(ctx, dynamic_note_pos, dynamic_span_start)
            j = j + 1
            continue
        }
        _x64_patch_dynamic_gas_if_needed(ctx, dynamic_note_pos, dynamic_span_start)
        if gas_basic == true {
            var opk_bb = op_kind
            if opk_bb == "if" || opk_bb == "while" || opk_bb == "for" {
                charge_basic_block_next = true
            }
        }
        _x64_emit_ops_record_slow(ctx, trace_op_slow, phase_log, phase_name, op, op_kind, j, op_start_ns, op_slow_ms)
        j = j + 1
    }
    if phase_outer {
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.body.summary",
            "name=" + phase_name +
            " top_string_candidates=" + oren_int_to_string(top_string_fast_stats["candidates"]) +
            " top_string_hits=" + oren_int_to_string(top_string_fast_stats["hits"]) +
            " top_string_miss_type=" + oren_int_to_string(top_string_fast_stats["miss_type"]))
    }
    return nil
}
