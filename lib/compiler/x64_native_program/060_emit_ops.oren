fn _collect_locals_from_ops(ctx, ops, locals, local_next) {
    var n = 0
    if ops != nil { n = oren_list_len(ops) }
    var i = 0
    while i < n {
        var op = ops[i]
        if op != nil {
            if op["op"] == "var_i32" {
                var nm = op["name"]
                // Rolling scoping rule (x64 v0):
                // - Allow `var` redeclaration in disjoint blocks by reusing the same slot.
                // - This matches the existing "locals are identified by name" lowering model
                //   while runtime injection is converging toward full parity.
                if locals[nm] == nil {
                    locals[nm] = local_next
                    local_next = local_next + 8
                }
            } else if op["op"] == "if" {
                local_next = _collect_locals_from_ops(ctx, op["then"], locals, local_next)
                if local_next < 0 { return -1 }
                local_next = _collect_locals_from_ops(ctx, op["else"], locals, local_next)
                if local_next < 0 { return -1 }
            } else if op["op"] == "while" {
                local_next = _collect_locals_from_ops(ctx, op["body"], locals, local_next)
                if local_next < 0 { return -1 }
            } else if op["op"] == "for" {
                local_next = _collect_locals_from_ops(ctx, op["init"], locals, local_next)
                if local_next < 0 { return -1 }
                local_next = _collect_locals_from_ops(ctx, op["post"], locals, local_next)
                if local_next < 0 { return -1 }
                local_next = _collect_locals_from_ops(ctx, op["body"], locals, local_next)
                if local_next < 0 { return -1 }
            }
        }
        i = i + 1
    }
    return local_next
}

fn _linetab_record_tok(ctx, tok) {
    // Record a best-effort source location entry for stack traces.
    //
    // Only active when `_data_reserve_linetab` was called (debug builds).
    if ctx == nil { return nil }
    if ctx["linetab_off"] == nil { return nil }
    if tok == nil { return nil }
    var file = tok["file"]
    var line = tok["line"]
    if file == nil || line == nil { return nil }
    // Defensive: in rolling mode, some generated/decoded tokens may not carry a string file path.
    // Debug line tables are best-effort; skip entries we can't stringify safely rather than
    // crashing during cross-target builds.
    if oren_is_string(file) != true { return nil }
    if oren_type_tag(line) != 1 { return nil }
    if ctx["linetab_entries"] == nil || ctx["linetab_cap"] == nil { return nil }
    if oren_list_len(ctx["linetab_entries"]) >= ctx["linetab_cap"] { return nil }

    // Avoid inserting many redundant entries when several ops map to the same line.
    var line_s = oren_int_to_string(line)
    var loc = " @" + file + ":" + line_s + " "

    if ctx["linetab_loc_offs"] == nil { ctx["linetab_loc_offs"] = {} }
    // Store offsets as `off+1` so a real offset of 0 never risks being interpreted as "missing"
    // in rolling runtimes/containers where an explicit 0 payload can be lossy.
    var loc_off_enc = ctx["linetab_loc_offs"][loc]
    if oren_type_tag(loc_off_enc) != 1 { loc_off_enc = 0 }
    var loc_off = nil
    if loc_off_enc > 0 { loc_off = loc_off_enc - 1 }
    if loc_off_enc <= 0 {
        loc_off = _data_add_cstr0(ctx, loc)
        // `loc_off` can legitimately be 0; `_data_add_cstr0` is ctx-local and cannot fail here.
        ctx["linetab_loc_offs"][loc] = loc_off + 1
    }

    // Note: `linetab_last_loc_off` stores the encoded offset for the same native-runtime reason.
    var last_loc_enc = ctx["linetab_last_loc_off"]
    if oren_type_tag(last_loc_enc) != 1 { last_loc_enc = 0 }
    if last_loc_enc > 0 && last_loc_enc == loc_off + 1 {
        return nil
    }

    var code_off = bytes_len(ctx["code"])
    ctx["linetab_last_code_off"] = code_off
    ctx["linetab_last_loc_off"] = loc_off + 1
    oren_list_push(ctx["linetab_entries"], {"off": code_off, "loc_off": loc_off})
    return nil
}

fn _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, tick_mask) {
    // PERF:
    // Calling `oren_gc_safepoint()` on every loop iteration dominates lexer/parser loops.
    // Emit a cheap counter+mask gate so we only call into the runtime periodically.
    //
    // Contract:
    // - `$tmp_gc_tick` exists as a per-function u64 stack slot (reserved in the function compiler).
    // - Uses RAX as scratch (caller-saved).
    //
    // tick = tick + 1; if (tick & mask) != 0 => skip; else call safepoint.
    var off_tick = locals["$tmp_gc_tick"]
    if oren_type_tag(off_tick) == 0 { err(ctx, "x64 native v0: missing $tmp_gc_tick slot"); return nil }
    // rax = tick
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_tick)
    // tick++
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 1))
    _emit_mov_mrbp_r64(ctx, 0 - off_tick, 0)
    // if ((tick & mask) != 0) goto skip
    bytes_extend(ctx["code"], insn_and_r64_imm32(0, tick_mask))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    var skip = _new_label(ctx, "gc_sp_skip")
    _emit_jcc_to_label(ctx, local_fixups, "ne", skip)
    _emit_call_rel32_named_x64(ctx, "oren_gc_safepoint")
    _emit_label(ctx, labels, skip)
    return nil
}

fn _x64_is_ident(exp) {
    if exp == nil { return nil }
    if exp["type"] == "Identifier" { return exp["value"] }
    return nil
}

fn _x64_list_contains(xs, value) {
    if xs == nil { return false }
    var i = 0
    while i < oren_list_len(xs) {
        if _x64_str_eq_bytes(xs[i], value) { return true }
        i = i + 1
    }
    return false
}

fn _x64_is_simple_inc_op(op, idx_name) {
    if op == nil || op["op"] != "assign_i32" { return false }
    var name = op["name"]
    if name == nil || _x64_str_eq_bytes(name, idx_name) != true { return false }
    var v = op["expr"]
    if v == nil || v["type"] != "Infix" { return false }
    if v["op"] != "+" { return false }
    var left = _x64_is_ident(v["left"])
    if left == nil || _x64_str_eq_bytes(left, idx_name) != true { return false }
    if v["right"] == nil || v["right"]["type"] != "Integer" { return false }
    if v["right"]["value"] != "1" { return false }
    return true
}

fn _x64_is_list_int_push_call(ctx, exp) {
    if exp == nil || exp["type"] != "Call" { return nil }
    if exp["fn"] == nil { return nil }
    var nm = nil
    if exp["fn"]["type"] == "Identifier" {
        nm = exp["fn"]["value"]
    } else if exp["fn"]["type"] == "Member" {
        var nsr = _x64_ns_resolve(ctx, exp["fn"])
        if nsr != nil {
            nm = nsr["name"]
        } else {
            var left = exp["fn"]["left"]
            var prop = exp["fn"]["prop"]
            if left != nil && prop != nil && left["type"] == "Identifier" && left["value"] == "list" {
                if prop["value"] == "int_push" { nm = "STD_list_int_push" }
            }
        }
    }
    if nm == nil { return nil }
    if nm != "oren_list_int_push" && nm != "STD_list_int_push" { return nil }
    var args = exp["args"]
    if args == nil || oren_list_len(args) != 2 { return nil }
    var list_name = _x64_is_ident(args[0])
    if list_name == nil { return nil }
    return {"list": list_name, "value": args[1]}
}

fn _x64_is_list_int_get_call(ctx, exp, idx_name) {
    if exp == nil || exp["type"] != "Call" { return nil }
