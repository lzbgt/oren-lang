        _emit_mov_mrbp_r64(ctx, 0 - slot_list, 0)
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_slow)

        // tracked node
        _emit_find_tracked_node_x64(ctx, 0, 11)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_slow)

        // kind == LIST_INT (8)
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 10))
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 8))
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_slow)

        // magic check
        _emit_mov_r64_mrbp(ctx, 0, 0 - slot_list)
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 0))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], insn_mov_rax_mrax())
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1279870019))
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_slow)

        // count >= n
        _emit_mov_r64_mrbp(ctx, 10, 0 - slot_list)
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], insn_mov_rax_mrax())
        _emit_mov_r64_mrbp(ctx, 9, 0 - off_n)
        bytes_extend(ctx["code"], insn_cmp_r64_r64(0, 9))
        _emit_jcc_to_label(ctx, local_fixups, "l", l_slow)

        // buf -> slot
        _emit_mov_r64_mrbp(ctx, 10, 0 - slot_list)
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], insn_mov_rax_mrax())
        _emit_mov_mrbp_r64(ctx, 0 - slot_buf, 0)

        li = li + 1
    }

    _emit_label(ctx, labels, l_fast_cond)
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_idx)
    _emit_mov_r64_mrbp(ctx, 9, 0 - off_n)
    bytes_extend(ctx["code"], insn_cmp_r64_r64(10, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_end)

    _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, 255)

    // sum -> r13
    _emit_mov_r64_mrbp(ctx, 13, 0 - off_sum)

    var mi = 0
    while mi < oren_list_len(muls) {
        var mul = muls[mi]
        var left_list = mul["left"]
        var right_list = mul["right"]
        var li_left = 0
        while li_left < list_count {
            if _x64_str_eq_bytes(lists[li_left], left_list) { break }
            li_left = li_left + 1
        }
        var li_right = 0
        while li_right < list_count {
            if _x64_str_eq_bytes(lists[li_right], right_list) { break }
            li_right = li_right + 1
        }
        var slot_buf_left = _intr_tmp_off(ctx, locals, base + li_left * 2 + 1)
        var slot_buf_right = _intr_tmp_off(ctx, locals, base + li_right * 2 + 1)
        if oren_type_tag(slot_buf_left) == 0 || oren_type_tag(slot_buf_right) == 0 { _intr_tmp_pop(ctx, base); return nil }

        // left value -> r14
        _emit_mov_r64_mrbp(ctx, 11, 0 - slot_buf_left)
        bytes_extend(ctx["code"], insn_mov_r64_r64(12, 10))
        bytes_extend(ctx["code"], insn_shl_r64_imm8(12, 3))
        bytes_extend(ctx["code"], insn_add_r64_r64(12, 11))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(14, 12))

        // right value -> r15
        _emit_mov_r64_mrbp(ctx, 11, 0 - slot_buf_right)
        bytes_extend(ctx["code"], insn_mov_r64_r64(12, 10))
        bytes_extend(ctx["code"], insn_shl_r64_imm8(12, 3))
        bytes_extend(ctx["code"], insn_add_r64_r64(12, 11))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(15, 12))

        bytes_extend(ctx["code"], insn_imul_r64_r64(14, 15))
        bytes_extend(ctx["code"], insn_add_r64_r64(13, 14))

        mi = mi + 1
    }

    _emit_mov_mrbp_r64(ctx, 0 - off_sum, 13)

    // i++
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 1))
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 10)

    _emit_jmp_to_label(ctx, local_fixups, l_fast_cond)

    _emit_label(ctx, labels, l_fast_end)
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _intr_tmp_pop(ctx, base)

    _emit_label(ctx, labels, l_slow)
    _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    _emit_label(ctx, labels, l_done)
    return nil
}

fn _emit_fast_list_dot_while_x64(ctx, op, info, locals, labels, local_fixups, epilogue_label, platform) {
    if ctx == nil || op == nil || info == nil { return nil }
    if locals == nil { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }
    if ctx["runtime_injected"] != true { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }

    var idx_name = info["idx"]
    var n_name = info["n"]
    var sum_name = info["sum"]
    var lists = info["lists"]
    var muls = info["muls"]

    var off_idx = locals[idx_name]
    var off_n = locals[n_name]
    var off_sum = locals[sum_name]
    if oren_type_tag(off_idx) == 0 || oren_type_tag(off_n) == 0 || oren_type_tag(off_sum) == 0 {
        return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    }

    var list_count = oren_list_len(lists)
    var base = _intr_tmp_push(ctx, iadd(list_count, list_count))
    if oren_type_tag(base) == 0 { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }

    var l_slow = _new_label(ctx, "list_dot_slow")
    var l_fast_cond = _new_label(ctx, "list_dot_cond")
    var l_fast_end = _new_label(ctx, "list_dot_end")
    var l_done = _new_label(ctx, "list_dot_done")

    // i < 0 => slow
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_slow)

    // n < 0 => slow
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_n)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_slow)

    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var off_list = locals[list_name]
        if oren_type_tag(off_list) == 0 { _intr_tmp_pop(ctx, base); return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }
        var slot_list = _intr_tmp_off(ctx, locals, base + li * 2)
        var slot_buf = _intr_tmp_off(ctx, locals, base + li * 2 + 1)
        if oren_type_tag(slot_list) == 0 || oren_type_tag(slot_buf) == 0 {
            _intr_tmp_pop(ctx, base)
            return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
        }

        // list -> slot
        _emit_mov_r64_mrbp(ctx, 0, 0 - off_list)
        _emit_mov_mrbp_r64(ctx, 0 - slot_list, 0)
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_slow)

        // tracked node
        _emit_find_tracked_node_x64(ctx, 0, 11)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_slow)

        // kind == LIST (2)
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 10))
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 2))
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_slow)

        // magic check
        _emit_mov_r64_mrbp(ctx, 0, 0 - slot_list)
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 0))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], insn_mov_rax_mrax())
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1279870019))
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_slow)

        // count >= n
        _emit_mov_r64_mrbp(ctx, 10, 0 - slot_list)
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], insn_mov_rax_mrax())
        _emit_mov_r64_mrbp(ctx, 9, 0 - off_n)
        bytes_extend(ctx["code"], insn_cmp_r64_r64(0, 9))
        _emit_jcc_to_label(ctx, local_fixups, "l", l_slow)

        // buf -> slot
        _emit_mov_r64_mrbp(ctx, 10, 0 - slot_list)
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], insn_mov_rax_mrax())
        _emit_mov_mrbp_r64(ctx, 0 - slot_buf, 0)

        li = li + 1
    }

    _emit_label(ctx, labels, l_fast_cond)
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_idx)
    _emit_mov_r64_mrbp(ctx, 9, 0 - off_n)
    bytes_extend(ctx["code"], insn_cmp_r64_r64(10, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_end)

    _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, 255)

    // sum -> r13
    _emit_mov_r64_mrbp(ctx, 13, 0 - off_sum)

    var mi = 0
    while mi < oren_list_len(muls) {
        var mul = muls[mi]
        var left_list = mul["left"]
        var right_list = mul["right"]
        var li_left = 0
        while li_left < list_count {
            if _x64_str_eq_bytes(lists[li_left], left_list) { break }
            li_left = li_left + 1
        }
        var li_right = 0
        while li_right < list_count {
            if _x64_str_eq_bytes(lists[li_right], right_list) { break }
            li_right = li_right + 1
        }
        var slot_buf_left = _intr_tmp_off(ctx, locals, base + li_left * 2 + 1)
        var slot_buf_right = _intr_tmp_off(ctx, locals, base + li_right * 2 + 1)
        if oren_type_tag(slot_buf_left) == 0 || oren_type_tag(slot_buf_right) == 0 { _intr_tmp_pop(ctx, base); return nil }

        // left value -> r14
        _emit_mov_r64_mrbp(ctx, 11, 0 - slot_buf_left)
        bytes_extend(ctx["code"], insn_mov_r64_r64(12, 10))
        bytes_extend(ctx["code"], insn_shl_r64_imm8(12, 3))
        bytes_extend(ctx["code"], insn_add_r64_r64(12, 11))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(14, 12))

        // right value -> r15
        _emit_mov_r64_mrbp(ctx, 11, 0 - slot_buf_right)
        bytes_extend(ctx["code"], insn_mov_r64_r64(12, 10))
        bytes_extend(ctx["code"], insn_shl_r64_imm8(12, 3))
        bytes_extend(ctx["code"], insn_add_r64_r64(12, 11))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(15, 12))

        bytes_extend(ctx["code"], insn_imul_r64_r64(14, 15))
        bytes_extend(ctx["code"], insn_add_r64_r64(13, 14))

        mi = mi + 1
    }

    _emit_mov_mrbp_r64(ctx, 0 - off_sum, 13)

    // i++
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 1))
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 10)

    _emit_jmp_to_label(ctx, local_fixups, l_fast_cond)

    _emit_label(ctx, labels, l_fast_end)
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _intr_tmp_pop(ctx, base)

    _emit_label(ctx, labels, l_slow)
    _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    _emit_label(ctx, labels, l_done)
    return nil
}

fn _emit_ops_in_fn(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label) {
    var n = 0
    if ops != nil { n = oren_list_len(ops) }
    var trace = false
    if ctx != nil && ctx["trace_emit_ops"] == true { trace = true }
    var trace_stride = 200
    if trace {
        trace_stride = core.parse_int_decimal(oren_env("OREN_TRACE_X64_EMIT_OPS_STRIDE"), trace_stride)
        if trace_stride < 1 { trace_stride = 1 }
    }
    if trace { print("[x64_emit_ops] enter len=" + oren_int_to_string(n)) }
    var j = 0
    while j < n {
        var op = ops[j]
        if op == nil { j = j + 1; continue }
        if trace && core.int_mod(j, trace_stride) == 0 {
            var opk = op["op"]
            if opk == nil { opk = "?" }
            var extra = ""
            if opk == "var_i32" || opk == "assign_i32" {
                var nm = op["name"]
                if nm != nil && nm != "" { extra = " name=" + nm }
            }
            var loc = ""
            var tok = op["tok"]
            if tok != nil && tok["file"] != nil && tok["line"] != nil {
                loc = " @" + tok["file"] + ":" + oren_int_to_string(tok["line"])
            }
            print("[x64_emit_ops] j=" + oren_int_to_string(j) + "/" + oren_int_to_string(n) + " op=" + opk + extra + loc)
        }
        _linetab_record_tok(ctx, op["tok"])
        if op["op"] == "var_i32" {
            var name = op["name"]
            var off = locals[name]
            if oren_type_tag(off) == 0 {
                var fnm = "?"
                if ctx != nil && ctx["cur_fn_name"] != nil { fnm = ctx["cur_fn_name"] }
                var nm_s = "?"
                if name != nil {
                    if oren_is_string(name) == true { nm_s = name }
                    else if oren_type_tag(name) == 1 { nm_s = "<int " + oren_int_to_string(name) + ">" }
                    else { nm_s = "<non-string>" }
                }
                err(ctx, "x64 native v0: missing local slot fn=" + fnm + " name=" + nm_s + " locals_len=" + oren_int_to_string(oren_map_len(locals)))
                return nil
            }
            _expr_int_check(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            if ctx["locals_floaty"] != nil {
                ctx["locals_floaty"][op["name"]] = _x64_expr_is_floaty(ctx, op["expr"])
            }
            if ctx["locals_inty"] != nil {
                ctx["locals_inty"][op["name"]] = _x64_expr_is_inty(ctx, op["expr"])
            }
            _emit_eval_int_to_rax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        } else if op["op"] == "assign_i32" {
            var off2 = locals[op["name"]]
            _expr_int_check(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            if ctx["locals_floaty"] != nil {
                ctx["locals_floaty"][op["name"]] = _x64_expr_is_floaty(ctx, op["expr"])
            }
            if ctx["locals_inty"] != nil {
                ctx["locals_inty"][op["name"]] = _x64_expr_is_inty(ctx, op["expr"])
            }
            _emit_eval_int_to_rax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            if oren_type_tag(off2) != 0 {
                _emit_mov_mrbp_r64(ctx, 0 - off2, 0)
            } else {
                // Global assignment (top-level `var` in data blob).
                var name = op["name"]
                var goff_enc = nil
                if ctx["globals"] != nil { goff_enc = ctx["globals"][name] }
                if oren_type_tag(goff_enc) == 0 { err(ctx, "x64 native v0: assign unknown var " + name); return nil }
                var goff = goff_enc - 1
                if ctx["globals_floaty"] != nil {
                    ctx["globals_floaty"][name] = _x64_expr_is_floaty(ctx, op["expr"])
                }
                if ctx["globals_inty"] != nil {
                    ctx["globals_inty"][name] = _x64_expr_is_inty(ctx, op["expr"])
                }

                // r10 = &global_slot ; *(u64*)r10 = rax
                var lea_pos = bytes_len(ctx["code"])
                bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
                oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": goff})
                bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
            }
        } else if op["op"] == "expr" {
            // Expression statement: evaluate and discard return value.
            _expr_int_check(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_eval_int_to_rax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        } else if op["op"] == "print_str_expr" {
            _emit_print_stmt_str_x64(ctx, locals, op["expr"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        } else if op["op"] == "print_cstr" {
            if platform != nil && platform["os"] == "linux" {
                _emit_linux_write_cstr(ctx, op["value"])
            } else if platform != nil && platform["os"] == "windows" {
                _emit_windows_write_cstr(ctx, op["value"])
            } else {
                err(ctx, "x64 native v0: print unsupported on this target")
                return nil
            }
        } else if op["op"] == "return" {
            _expr_int_check(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_eval_int_to_rax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_jmp_to_label(ctx, local_fixups, epilogue_label)
        } else if op["op"] == "if" {
            var cond = op["cond"]
            var else_label = _new_label(ctx, "if_else")
            var end_label = _new_label(ctx, "if_end")
            _emit_jcc_false_for_cond_x64(ctx, cond, locals, local_fixups, else_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_ops_in_fn(ctx, op["then"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_jmp_to_label(ctx, local_fixups, end_label)
            _emit_label(ctx, labels, else_label)
            _emit_ops_in_fn(ctx, op["else"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_label(ctx, labels, end_label)
        } else if op["op"] == "while" {
            var fast_lcg = _x64_match_fast_lcg_sum_while(ctx, op, locals)
            if fast_lcg != nil {
                _emit_fast_lcg_sum_while_x64(ctx, op, fast_lcg, locals, labels, local_fixups, epilogue_label, platform)
            } else {
                var fast_info = _x64_match_fast_list_int_push_while(ctx, op, locals)
                if fast_info != nil {
                    _emit_fast_list_int_push_while_x64(ctx, op, fast_info, locals, labels, local_fixups, epilogue_label, platform)
                } else {
                    var fast_box_push = _x64_match_fast_list_push_while(ctx, op, locals)
                    if fast_box_push != nil {
                        _emit_fast_list_push_while_x64(ctx, op, fast_box_push, locals, labels, local_fixups, epilogue_label, platform)
                    } else {
                        var fast_dot = _x64_match_fast_list_int_dot_while(ctx, op, locals)
                        if fast_dot != nil {
                            _emit_fast_list_int_dot_while_x64(ctx, op, fast_dot, locals, labels, local_fixups, epilogue_label, platform)
                        } else {
                            var fast_box_dot = _x64_match_fast_list_dot_while(ctx, op, locals)
                            if fast_box_dot != nil {
                                _emit_fast_list_dot_while_x64(ctx, op, fast_box_dot, locals, labels, local_fixups, epilogue_label, platform)
                            } else {
                                var fast_get = _x64_match_fast_list_int_get_sum_while(ctx, op, locals)
                                if fast_get != nil {
                                    _emit_fast_list_int_get_sum_while_x64(ctx, op, fast_get, locals, labels, local_fixups, epilogue_label, platform)
                                } else {
                                    var fast_box_get = _x64_match_fast_list_get_sum_while(ctx, op, locals)
                                    if fast_box_get != nil {
                                        _emit_fast_list_get_sum_while_x64(ctx, op, fast_box_get, locals, labels, local_fixups, epilogue_label, platform)
                                    } else {
                                        _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        } else if op["op"] == "for" {
            // for init; cond; post { body }
            //
            // Semantics:
            // - init runs once
            // - cond checked before each iteration
            // - continue jumps to post (then cond)
            // - break exits the loop
            var cond_label2 = _new_label(ctx, "for_cond")
            var body_label2 = _new_label(ctx, "for_body")
            var post_label2 = _new_label(ctx, "for_post")
            var end_label3 = _new_label(ctx, "for_end")

            _emit_ops_in_fn(ctx, op["init"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_label(ctx, labels, cond_label2)
            _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, 255)
            _emit_jcc_false_for_cond_x64(ctx, op["cond"], locals, local_fixups, end_label3)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_label(ctx, labels, body_label2)
            _emit_ops_in_fn(ctx, op["body"], locals, labels, local_fixups, epilogue_label, platform, post_label2, end_label3)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_label(ctx, labels, post_label2)
            // Post must not use break/continue (enforced by analyzer); pass nil to be strict.
            _emit_ops_in_fn(ctx, op["post"], locals, labels, local_fixups, epilogue_label, platform, nil, nil)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_jmp_to_label(ctx, local_fixups, cond_label2)
            _emit_label(ctx, labels, end_label3)
        } else if op["op"] == "break" {
            if loop_end_label == nil { err(ctx, "x64 native v0: break outside loop"); return nil }
            _emit_jmp_to_label(ctx, local_fixups, loop_end_label)
        } else if op["op"] == "continue" {
            if loop_cond_label == nil { err(ctx, "x64 native v0: continue outside loop"); return nil }
            _emit_jmp_to_label(ctx, local_fixups, loop_cond_label)
        } else {
            err(ctx, "x64 native v0: unknown op in main")
            return nil
        }
        j = j + 1
    }
    return nil
}
