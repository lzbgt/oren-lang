fn _x64_str_eq_bytes_local(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _x64_emit_top_string_global_store(ctx, cstr_off, goff) {
    // Hot path for synthesized top-level string globals:
    //   lea rax, [rip+cstr]
    //   lea r10, [rip+slot]
    //   mov [r10], rax
    //
    // Emit fixed bytes directly instead of routing each tiny instruction through the
    // generic encoder/pool path for every string in large compiler-shaped batches.
    var code = ctx["code"]
    var lea_lit = bytes_len(code)
    bytes_push(code, 72)  // REX.W
    bytes_push(code, 141) // LEA
    bytes_push(code, 5)   // ModRM: rax, [rip+disp32]
    push_u32_le(code, 0)
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_lit + 3, "data_off": cstr_off})

    var lea_slot = bytes_len(code)
    bytes_push(code, 76)  // REX.W | REX.R for r10
    bytes_push(code, 141) // LEA
    bytes_push(code, 21)  // ModRM: r10, [rip+disp32]
    push_u32_le(code, 0)
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_slot + 3, "data_off": goff})

    bytes_push(code, 73)  // REX.W | REX.B for [r10]
    bytes_push(code, 137) // MOV r/m64, r64
    bytes_push(code, 2)   // ModRM: [r10], rax
    return nil
}

fn _x64_empty_container_literal_kind(expr) {
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Array" {
        var els = expr["elements"]
        if els == nil || oren_list_len(els) == 0 { return "list" }
    }
    if t == "Hash" {
        var pairs = expr["pairs"]
        if pairs == nil || oren_list_len(pairs) == 0 { return "map" }
    }
    return nil
}

fn _x64_emit_runtime_alloc0_to_rax(ctx, sym, platform) {
    if ctx == nil || ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: call requires injected native runtime: " + sym)
        return nil
    }
    var a0 = 7 // SysV: rdi
    if platform != nil && platform["os"] == "windows" { a0 = 1 } // Win64: rcx
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(a0, 0))
    _emit_call_rel32_named_x64(ctx, sym)
    return nil
}

fn _x64_emit_global_store_rax(ctx, goff) {
    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": goff})
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(10, 0))
    return nil
}

fn _x64_emit_top_string_batch_base_setup(ctx, table_off) {
    var code = ctx["code"]
    var lea_base = bytes_len(code)
    bytes_push(code, 76)  // REX.W | REX.R
    bytes_push(code, 141) // LEA
    bytes_push(code, 21)  // r10, [rip+disp32]
    push_u32_le(code, 0)
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_base + 3, "data_off": table_off})

    // r10 = data_base = table_ptr - table_off
    bytes_push(code, 73); bytes_push(code, 129); bytes_push(code, 234)
    push_u32_le(code, table_off)

    // r11 = table_ptr
    bytes_push(code, 77); bytes_push(code, 137); bytes_push(code, 211)
    bytes_push(code, 73); bytes_push(code, 129); bytes_push(code, 195)
    push_u32_le(code, table_off)
    return nil
}

fn _x64_emit_top_string_batch_count_setup(ctx) {
    var code = ctx["code"]
    // rcx = count; r11 = first pair
    bytes_push(code, 73); bytes_push(code, 139); bytes_push(code, 11)
    bytes_push(code, 73); bytes_push(code, 131); bytes_push(code, 195); bytes_push(code, 8)
    return nil
}

fn _x64_emit_top_string_batch_loop_header(ctx) {
    var code = ctx["code"]
    var loop_pos = bytes_len(code)
    bytes_push(code, 72); bytes_push(code, 133); bytes_push(code, 201) // test rcx, rcx
    var jz_pos = bytes_len(code)
    bytes_push(code, 15); bytes_push(code, 132); push_u32_le(code, 0)   // jz done
    return {"loop": loop_pos, "jz": jz_pos}
}

fn _x64_emit_top_string_batch_slot_ptr(ctx, code) {
    bytes_push(code, 73); bytes_push(code, 139); bytes_push(code, 3)     // mov rax, [r11]
    bytes_push(code, 76); bytes_push(code, 137); bytes_push(code, 210)   // mov rdx, r10
    bytes_push(code, 72); bytes_push(code, 1); bytes_push(code, 194)     // add rdx, rax
    return nil
}

fn _x64_emit_top_string_batch_store_cstr(ctx, code) {
    bytes_push(code, 73); bytes_push(code, 139); bytes_push(code, 67); bytes_push(code, 8)
    bytes_push(code, 76); bytes_push(code, 1); bytes_push(code, 208)     // add rax, r10
    bytes_push(code, 72); bytes_push(code, 137); bytes_push(code, 2)     // mov [rdx], rax
    return nil
}

fn _x64_emit_top_string_batch_advance(ctx, code) {
    bytes_push(code, 73); bytes_push(code, 131); bytes_push(code, 195); bytes_push(code, 16)
    bytes_push(code, 72); bytes_push(code, 255); bytes_push(code, 201)   // dec rcx
    var jmp_pos = bytes_len(code)
    bytes_push(code, 233); push_u32_le(code, 0)                          // jmp loop
    return jmp_pos
}

fn _x64_emit_top_string_batch_loop_body(ctx) {
    var code = ctx["code"]
    _x64_emit_top_string_batch_slot_ptr(ctx, code)
    _x64_emit_top_string_batch_store_cstr(ctx, code)
    return _x64_emit_top_string_batch_advance(ctx, code)
}

fn _x64_patch_top_string_batch_loop(ctx, loop_state, jmp_pos) {
    var code = ctx["code"]
    var done_pos = bytes_len(code)
    var loop_pos = loop_state["loop"]
    var jz_pos = loop_state["jz"]
    set_u32_le(code, jz_pos + 2, done_pos - (jz_pos + 6))
    set_u32_le(code, jmp_pos + 1, core.int_mod(loop_pos - (jmp_pos + 5), 4294967296))
    return nil
}

fn _x64_emit_top_string_global_batch_loop(ctx, table_off) {
    // Runtime loop over a `.data` table:
    //   u64 count; repeated { u64 global_slot_off; u64 cstr_off }
    //
    // This keeps compiler-time emission constant-size for large top-level string
    // batches while preserving source-order initialization after runtime startup.
    _x64_emit_top_string_batch_base_setup(ctx, table_off)
    _x64_emit_top_string_batch_count_setup(ctx)
    var loop_state = _x64_emit_top_string_batch_loop_header(ctx)
    var jmp_pos = _x64_emit_top_string_batch_loop_body(ctx)
    _x64_patch_top_string_batch_loop(ctx, loop_state, jmp_pos)
    return nil
}

fn _x64_top_empty_container_batch_runtime_sym(kind) {
    var sym = "oren_new_map"
    if kind == "list" { sym = "oren_new_list" }
    return sym
}

fn _x64_top_empty_container_batch_arg0(platform) {
    var arg0 = 7 // SysV: rdi
    if platform != nil && platform["os"] == "windows" { arg0 = 1 } // Win64: rcx
    return arg0
}

fn _x64_emit_top_empty_container_batch_base_setup(ctx, table_off) {
    var code = ctx["code"]
    var lea_base = bytes_len(code)
    bytes_extend(code, core.insn_lea_r64_rip_disp32(13, 0)) // r13 = table_ptr
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_base + 3, "data_off": table_off})

    bytes_extend(code, core.insn_mov_r64_r64(12, 13))       // r12 = table_ptr
    bytes_extend(code, core.insn_sub_r64_imm32(12, table_off)) // r12 = data_base
    bytes_extend(code, core.insn_mov_r64_mr64(3, 13))       // rbx = count
    bytes_extend(code, core.insn_add_r64_imm32(13, 8))      // r13 = first slot offset
    return nil
}

fn _x64_emit_top_empty_container_batch_loop_header(ctx) {
    var code = ctx["code"]
    var loop_pos = bytes_len(code)
    bytes_extend(code, core.insn_cmp_r64_imm32(3, 0))
    var jz_pos = bytes_len(code)
    bytes_push(code, 15); bytes_push(code, 132); push_u32_le(code, 0) // jz done
    return {"loop": loop_pos, "jz": jz_pos}
}

fn _x64_emit_top_empty_container_batch_loop_body(ctx, sym, arg0) {
    var code = ctx["code"]
    bytes_extend(code, core.insn_mov_r32_imm32(arg0, 0))
    _emit_call_rel32_named_x64(ctx, sym)

    bytes_extend(code, core.insn_mov_r64_r64(10, 12))       // r10 = data_base
    bytes_extend(code, core.insn_mov_r64_mr64(11, 13))      // r11 = slot_off
    bytes_extend(code, core.insn_add_r64_r64(10, 11))       // r10 = &slot
    bytes_extend(code, core.insn_mov_mr64_r64(10, 0))       // *slot = rax
    bytes_extend(code, core.insn_add_r64_imm32(13, 8))
    bytes_extend(code, core.insn_add_r64_imm32(3, 4294967295))
    var jmp_pos = bytes_len(code)
    bytes_push(code, 233); push_u32_le(code, 0)
    return jmp_pos
}

fn _x64_patch_top_empty_container_batch_loop(ctx, loop_state, jmp_pos) {
    var code = ctx["code"]
    var done_pos = bytes_len(code)
    var loop_pos = loop_state["loop"]
    var jz_pos = loop_state["jz"]
    set_u32_le(code, jz_pos + 2, done_pos - (jz_pos + 6))
    set_u32_le(code, jmp_pos + 1, core.int_mod(loop_pos - (jmp_pos + 5), 4294967296))
    return nil
}

fn _x64_emit_top_empty_container_batch_loop(ctx, table_off, kind, platform) {
    // Runtime loop over a `.data` table:
    //   u64 count; repeated { u64 global_slot_off }
    //
    // Containers stay mutable runtime heap objects; this only batches compiler-time
    // emission so large compiler-shaped top levels do not pay per-global emitter cost.
    var sym = _x64_top_empty_container_batch_runtime_sym(kind)
    var arg0 = _x64_top_empty_container_batch_arg0(platform)
    _x64_emit_top_empty_container_batch_base_setup(ctx, table_off)
    var loop_state = _x64_emit_top_empty_container_batch_loop_header(ctx)
    var jmp_pos = _x64_emit_top_empty_container_batch_loop_body(ctx, sym, arg0)
    _x64_patch_top_empty_container_batch_loop(ctx, loop_state, jmp_pos)
    return nil
}

fn _x64_list_name_in_fast(list_name, lists) {
    if list_name == nil || lists == nil { return false }
    var i = 0
    while i < oren_list_len(lists) {
        if _x64_str_eq_bytes_local(lists[i], list_name) == true { return true }
        i = i + 1
    }
    return false
}

fn _x64_reserve_call_info(op) {
    if op == nil || op["op"] != "expr" { return nil }
    var expr = op["expr"]
    if expr == nil || expr["type"] != "Call" { return nil }
    var fn0 = expr["fn"]
    if fn0 == nil || fn0["type"] != "Identifier" { return nil }
    var nm = fn0["value"]
    var kind = nil
    if nm == "oren_list_int_reserve" || nm == "STD_list_int_reserve" { kind = "list_int" }
    else if nm == "oren_list_reserve" || nm == "STD_list_reserve" { kind = "list" }
    else { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) < 2 { return nil }
    var recv = args[0]
    if recv == nil || recv["type"] != "Identifier" { return nil }
    return {"kind": kind, "list": recv["value"], "cap_expr": args[1]}
}

fn _x64_reserve_cap_matches_fast(res_info, fast_info) {
    if res_info == nil || fast_info == nil { return false }
    var cap_expr = res_info["cap_expr"]
    if cap_expr == nil { return false }
    var n_name = fast_info["n"]
    var n_const = fast_info["n_const"]
    if n_name != nil {
        if cap_expr["type"] == "Identifier" && _x64_str_eq_bytes_local(cap_expr["value"], n_name) == true { return true }
    } else if n_const != nil {
        if cap_expr["type"] == "Integer" && cap_expr["value"] == oren_int_to_string(n_const) { return true }
    }
    return false
}

fn _x64_should_skip_reserve_op(op, next, ctx, locals) {
    var res_info = _x64_reserve_call_info(op)
    if res_info == nil || next == nil { return false }
    if next["op"] != "while" { return false }
    if res_info["kind"] == "list_int" {
        var fast_info = _x64_match_fast_list_int_push_while(ctx, next, locals)
        if fast_info == nil { return false }
        if _x64_list_name_in_fast(res_info["list"], fast_info["lists"]) != true { return false }
        return _x64_reserve_cap_matches_fast(res_info, fast_info)
    }
    if res_info["kind"] == "list" {
        var fast_info2 = _x64_match_fast_list_push_while(ctx, next, locals)
        if fast_info2 == nil { return false }
        if _x64_list_name_in_fast(res_info["list"], fast_info2["lists"]) != true { return false }
        return _x64_reserve_cap_matches_fast(res_info, fast_info2)
    }
    return false
}

fn _x64_native_op_gas_weight(op) {
    if op == nil { return 0 }
    var k = op["op"]
    if k == nil { return 0 }
    if k == "if" || k == "while" || k == "for" { return 2 }
    return 1
}

fn _x64_native_op_ends_block(op) {
    if op == nil { return false }
    var k = op["op"]
    if k == "if" || k == "while" || k == "for" { return true }
    if k == "return" || k == "break" || k == "continue" { return true }
    return false
}

fn _x64_native_block_weighted_gas_amount(ops, start) {
    if ops == nil { return 1 }
    var n = oren_list_len(ops)
    var i = start
    var total = 0
    while i < n {
        var op = oren_list_get(ops, i)
        total = total + _x64_native_op_gas_weight(op)
        if _x64_native_op_ends_block(op) == true { break }
        i = i + 1
    }
    if total <= 0 { return 1 }
    return total
}

fn _emit_while_op_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform) {
    var fast_lcg = _x64_match_fast_lcg_sum_while(ctx, op, locals)
    if fast_lcg != nil {
        _emit_fast_lcg_sum_while_x64(ctx, op, fast_lcg, locals, labels, local_fixups, epilogue_label, platform)
        return nil
    }
    var fast_info = _x64_match_fast_list_int_push_while(ctx, op, locals)
    if fast_info != nil {
        _emit_fast_list_int_push_while_x64(ctx, op, fast_info, locals, labels, local_fixups, epilogue_label, platform)
        return nil
    }
    var fast_box_push = _x64_match_fast_list_push_while(ctx, op, locals)
    if fast_box_push != nil {
        _emit_fast_list_push_while_x64(ctx, op, fast_box_push, locals, labels, local_fixups, epilogue_label, platform)
        return nil
    }
    var fast_dot = _x64_match_fast_list_int_dot_while(ctx, op, locals)
    if fast_dot != nil {
        _emit_fast_list_int_dot_while_x64(ctx, op, fast_dot, locals, labels, local_fixups, epilogue_label, platform)
        return nil
    }
    var fast_box_dot = _x64_match_fast_list_dot_while(ctx, op, locals)
    if fast_box_dot != nil {
        _emit_fast_list_dot_while_x64(ctx, op, fast_box_dot, locals, labels, local_fixups, epilogue_label, platform)
        return nil
    }
    var fast_get = _x64_match_fast_list_int_get_sum_while(ctx, op, locals)
    if fast_get != nil {
        _emit_fast_list_int_get_sum_while_x64(ctx, op, fast_get, locals, labels, local_fixups, epilogue_label, platform)
        return nil
    }
    var fast_box_get = _x64_match_fast_list_get_sum_while(ctx, op, locals)
    if fast_box_get != nil {
        _emit_fast_list_get_sum_while_x64(ctx, op, fast_box_get, locals, labels, local_fixups, epilogue_label, platform)
        return nil
    }
    _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    return nil
}

fn _x64_for_labels(ctx) {
    return {
        "cond": _new_label(ctx, "for_cond"),
        "body": _new_label(ctx, "for_body"),
        "post": _new_label(ctx, "for_post"),
        "end": _new_label(ctx, "for_end")
    }
}

fn _x64_emit_for_init_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label) {
    _emit_ops_in_fn(ctx, op["init"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    return true
}

fn _x64_emit_for_condition_x64(ctx, op, locals, labels, local_fixups, for_labels, gas_weighted, gas_dynamic) {
    _emit_label(ctx, labels, for_labels["cond"])
    if gas_weighted == true {
        _emit_native_gas_note_x64(ctx, 2)
    }
    _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, 255)
    var dynamic_cond_note = nil
    var dynamic_cond_start = nil
    if gas_dynamic == true {
        dynamic_cond_note = _emit_native_gas_note_x64_patchable_u32(ctx)
        dynamic_cond_start = bytes_len(ctx["code"])
    }
    _emit_jcc_false_for_cond_x64(ctx, op["cond"], locals, local_fixups, for_labels["end"])
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if dynamic_cond_note != nil && dynamic_cond_start != nil {
        _patch_native_gas_note_x64_u32(ctx, dynamic_cond_note, bytes_len(ctx["code"]) - dynamic_cond_start)
    }
    return true
}

fn _x64_emit_for_body_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, for_labels) {
    _emit_label(ctx, labels, for_labels["body"])
    _emit_ops_in_fn(ctx, op["body"], locals, labels, local_fixups, epilogue_label, platform, for_labels["post"], for_labels["end"])
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    return true
}

fn _x64_emit_for_post_and_finish_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, for_labels) {
    _emit_label(ctx, labels, for_labels["post"])
    // Post must not use break/continue (enforced by analyzer); pass nil to be strict.
    _emit_ops_in_fn(ctx, op["post"], locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    _emit_jmp_to_label(ctx, local_fixups, for_labels["cond"])
    _emit_label(ctx, labels, for_labels["end"])
    return true
}

fn _emit_for_op_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, gas_weighted, gas_dynamic) {
    // for init; cond; post { body }
    //
    // Semantics:
    // - init runs once
    // - cond checked before each iteration
    // - continue jumps to post (then cond)
    // - break exits the loop
    var for_labels = _x64_for_labels(ctx)
    if _x64_emit_for_init_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label) != true { return nil }
    if _x64_emit_for_condition_x64(ctx, op, locals, labels, local_fixups, for_labels, gas_weighted, gas_dynamic) != true { return nil }
    if _x64_emit_for_body_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, for_labels) != true { return nil }
    if _x64_emit_for_post_and_finish_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, for_labels) != true { return nil }
    return nil
}

fn _x64_string_batch_trace_state(ctx, j, op_slow_ms, batch_n, batch_names_n, batch_items_n, batch_off_encs_n, batch_slot_offs_src_n) {
    var phase_log = nil
    var phase_name = nil
    if ctx != nil {
        phase_log = ctx["emit_ops_phase_log"]
        phase_name = ctx["emit_ops_phase_name"]
    }
    var trace_op_slow = false
    if phase_log != nil && phase_name != nil && op_slow_ms > 0 { trace_op_slow = true }
    var trace_batch_progress = false
    var v_trace_batch = oren_env("OREN_TRACE_X64_STRING_BATCH_PROGRESS")
    if phase_log != nil && phase_name != nil &&
       v_trace_batch != nil && v_trace_batch != "" &&
       x64_env_str_eq(v_trace_batch, "0") != true &&
       x64_env_str_eq(v_trace_batch, "false") != true {
        trace_batch_progress = true
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.string_batch.start",
            "name=" + phase_name +
                " i=" + oren_int_to_string(j) +
                " count=" + oren_int_to_string(batch_n) +
                " names=" + oren_int_to_string(batch_names_n) +
                " items=" + oren_int_to_string(batch_items_n) +
                " off_encs=" + oren_int_to_string(batch_off_encs_n) +
                " slot_offs=" + oren_int_to_string(batch_slot_offs_src_n))
    }
    return {
        "phase_log": phase_log,
        "phase_name": phase_name,
        "trace_op_slow": trace_op_slow,
        "trace_batch_progress": trace_batch_progress
    }
}

fn _x64_string_batch_collect_items(batch_n, batch_items, batch_items_n, batch_names, batch_values, batch_off_encs, batch_slot_offs_src) {
    if batch_items_n > 0 { return batch_items }
    var batch_names_n = 0
    if batch_names != nil { batch_names_n = oren_list_len(batch_names) }
    var batch_off_encs_n = 0
    if batch_off_encs != nil { batch_off_encs_n = oren_list_len(batch_off_encs) }
    var batch_slot_offs_src_n = 0
    if batch_slot_offs_src != nil { batch_slot_offs_src_n = oren_list_len(batch_slot_offs_src) }
    var out = []
    var batch_collect_i = 0
    while batch_collect_i < batch_n {
        var collect_name = nil
        if batch_collect_i < batch_names_n { collect_name = batch_names[batch_collect_i] }
        var collect_value = nil
        if batch_values != nil && batch_collect_i < oren_list_len(batch_values) {
            collect_value = batch_values[batch_collect_i]
