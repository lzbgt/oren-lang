    if s_gs == nil { s_gs = "" }
    if _x64_emit_top_string_literal_store(ctx, op, j, op_start_ns, op_slow_ms,
        s_gs, "global_string_init", "top_string_direct") == nil {
        return nil
    }
    return nil
}

fn _x64_emit_assign_top_string_fast(ctx, op, j, op_start_ns, op_slow_ms, top_string_fast_stats) {
    if op["expr"] == nil || op["expr"]["type"] != "String" { return 0 }
    top_string_fast_stats["hits"] = top_string_fast_stats["hits"] + 1
    var s_fast = _x64_assign_top_string_literal_value(op)
    if _x64_emit_top_string_literal_store(ctx, op, j, op_start_ns, op_slow_ms,
        s_fast, "assign_i32", "top_string_fast") == nil {
        return nil
    }
    return 1
}

fn _x64_top_empty_container_runtime_sym(kind) {
    if kind == "list" { return "oren_new_list" }
    return "oren_new_map"
}

fn _x64_emit_top_empty_container_alloc_store(ctx, kind, platform, goff_enc) {
    _x64_emit_runtime_alloc0_to_rax(ctx, _x64_top_empty_container_runtime_sym(kind), platform)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _x64_emit_global_store_rax(ctx, goff_enc - 1)
    return true
}

fn _x64_top_empty_container_record_slow(ctx, trace, op, kind, j, op_start_ns, op_slow_ms) {
    if trace["enabled"] != true { return nil }
    var empty_elapsed_ms = (oren_time_now_ns() - op_start_ns) / 1000000
    if empty_elapsed_ms < op_slow_ms { return nil }
    _x64_program_phase_log_append(trace["log"], "x64.codegen.function.op.slow",
        "name=" + trace["name"] +
        " i=" + oren_int_to_string(j) +
        " op=assign_i32" +
        " path=top_empty_container" +
        " kind=" + kind +
        " ms=" + oren_int_to_string(empty_elapsed_ms) +
        " global=" + op["name"] +
        _x64_top_string_slow_loc(op))
    return nil
}

fn _x64_emit_assign_top_empty_container(ctx, op, platform, j, op_start_ns, op_slow_ms) {
    var empty_kind = _x64_empty_container_literal_kind(op["expr"])
    if empty_kind == nil { return 0 }
    var name_empty = op["name"]
    var goff_enc_empty = _x64_top_string_global_offset_enc(ctx, name_empty, op["__oren_global_off_enc"])
    if goff_enc_empty == nil { return nil }
    var trace = _x64_top_string_trace_state(ctx, op_slow_ms)
    if _x64_emit_top_empty_container_alloc_store(ctx, empty_kind, platform, goff_enc_empty) == nil { return nil }
    _x64_top_empty_container_record_slow(ctx, trace, op, empty_kind, j, op_start_ns, op_slow_ms)
    return 1
}

fn _x64_assign_i32_update_local_facts(ctx, op, top_string_fast_candidate) {
    if ctx["locals_floaty"] != nil && top_string_fast_candidate != true {
        ctx["locals_floaty"][op["name"]] = _x64_expr_is_floaty(ctx, op["expr"])
    }
    if ctx["locals_inty"] != nil && top_string_fast_candidate != true {
        ctx["locals_inty"][op["name"]] = _x64_expr_is_inty(ctx, op["expr"])
    }
    if ctx["locals_int_const"] != nil && top_string_fast_candidate != true {
        ctx["locals_int_const"][op["name"]] = _x64_expr_int_const(ctx, op["expr"])
    }
    return nil
}

fn _x64_assign_i32_update_global_facts(ctx, name, meta_expr) {
    var global_floaty = false
    var global_inty = false
    var global_const = nil
    if meta_expr != nil && meta_expr["type"] == "Integer" {
        global_inty = true
        global_const = _x64_expr_int_const(ctx, meta_expr)
    } else {
        global_floaty = _x64_expr_is_floaty(ctx, meta_expr)
        if global_floaty != true { global_inty = _x64_expr_is_inty(ctx, meta_expr) }
        global_const = _x64_expr_int_const(ctx, meta_expr)
    }
    if ctx["globals_floaty"] != nil { ctx["globals_floaty"][name] = global_floaty }
    if ctx["globals_inty"] != nil { ctx["globals_inty"][name] = global_inty }
    if ctx["globals_int_const"] != nil { ctx["globals_int_const"][name] = global_const }
    return nil
}

fn _x64_assign_i32_store_global_rax(ctx, op) {
    // Global assignment (top-level `var` in data blob).
    var name = op["name"]
    var goff_enc = op["__oren_global_off_enc"]
    if oren_type_tag(goff_enc) != 1 && ctx["globals"] != nil { goff_enc = ctx["globals"][name] }
    if oren_type_tag(goff_enc) != 1 { err(ctx, "x64 native v0: assign unknown var " + name); return nil }
    var goff = goff_enc - 1
    if op["__oren_top_level_global_init"] != true {
        _x64_assign_i32_update_global_facts(ctx, name, op["expr"])
    }
    _x64_emit_global_store_rax(ctx, goff)
    return nil
}

fn _emit_assign_i32_op_x64(ctx, op, locals, platform, j, op_start_ns, op_slow_ms, top_string_fast_stats) {
    var off2 = locals[op["name"]]
    var top_string_fast_candidate = false
    if op["__oren_top_level_global_init"] == true && oren_type_tag(off2) == 0 {
        top_string_fast_candidate = true
        top_string_fast_stats["candidates"] = top_string_fast_stats["candidates"] + 1
    }
    if top_string_fast_candidate == true {
        var fast_status = _x64_emit_assign_top_string_fast(ctx, op, j, op_start_ns, op_slow_ms, top_string_fast_stats)
        if fast_status == nil { return nil }
        if fast_status == 1 { return 1 }

        var empty_status = _x64_emit_assign_top_empty_container(ctx, op, platform, j, op_start_ns, op_slow_ms)
        if empty_status == nil { return nil }
        if empty_status == 1 { return 1 }
    }
    if top_string_fast_candidate == true {
        top_string_fast_stats["miss_type"] = top_string_fast_stats["miss_type"] + 1
    }
    _expr_int_check(ctx, op["expr"], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _x64_assign_i32_update_local_facts(ctx, op, top_string_fast_candidate)
    _emit_eval_int_to_rax(ctx, op["expr"], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    if oren_type_tag(off2) != 0 {
        _emit_mov_mrbp_r64(ctx, 0 - off2, 0)
    } else {
        _x64_assign_i32_store_global_rax(ctx, op)
    }
    return 0
}

fn _x64_emit_ops_trace_progress(ctx, trace, trace_stride, j, n, op, op_kind) {
    if trace != true { return nil }
    if core.int_mod(j, trace_stride) != 0 { return nil }
    var opk = op_kind
    if opk == nil { opk = "?" }
    var extra = ""
    if opk == "var_i32" || opk == "assign_i32" {
        var nm = op["name"]
        if nm != nil && nm != "" { extra = " name=" + nm }
    }
    var loc = ""
    var tok = op["tok"]
    if tok != nil && tok["file"] != nil && tok["line"] != nil {
        loc = " @" + tok["file"] + ":" + oren_int_to_string(tok["line"])
    }
    print("[x64_emit_ops] j=" + oren_int_to_string(j) + "/" + oren_int_to_string(n) + " op=" + opk + extra + loc)
    return nil
}

fn _x64_emit_ops_phase_progress(ctx, phase_outer, phase_log, phase_name, phase_stride, j, n, op, op_kind) {
    if phase_outer != true { return nil }
    if core.int_mod(j, phase_stride) != 0 { return nil }
    var opk_phase = op_kind
    if opk_phase == nil { opk_phase = "?" }
    var loc_phase = ""
    var tok_phase = op["tok"]
    if tok_phase != nil && tok_phase["file"] != nil && tok_phase["line"] != nil {
        loc_phase = " file=" + tok_phase["file"] + " line=" + oren_int_to_string(tok_phase["line"])
    }
    _x64_program_phase_log_append(phase_log, "x64.codegen.function.body.progress",
        "name=" + phase_name +
        " i=" + oren_int_to_string(j) +
        " total=" + oren_int_to_string(n) +
        " op=" + opk_phase +
        " code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])) +
        loc_phase)
    return nil
}

fn _x64_patch_dynamic_gas_if_needed(ctx, dynamic_note_pos, dynamic_span_start) {
    if dynamic_note_pos != nil && dynamic_span_start != nil {
        _patch_native_gas_note_x64_u32(ctx, dynamic_note_pos, bytes_len(ctx["code"]) - dynamic_span_start)
    }
    return nil
}

fn _x64_emit_ops_record_slow(ctx, trace_op_slow, phase_log, phase_name, op, op_kind, j, op_start_ns, op_slow_ms) {
    if trace_op_slow != true { return nil }
    var generic_op_ms = (oren_time_now_ns() - op_start_ns) / 1000000
    if generic_op_ms < op_slow_ms { return nil }
    var generic_op_name = op_kind
    if generic_op_name == nil { generic_op_name = "?" }
    var generic_loc = ""
    var generic_tok = op["tok"]
    if generic_tok != nil && generic_tok["file"] != nil && generic_tok["line"] != nil {
        generic_loc = " file=" + generic_tok["file"] + " line=" + oren_int_to_string(generic_tok["line"])
    }
    var generic_extra = ""
    if op["name"] != nil { generic_extra = " target=" + op["name"] }
    _x64_program_phase_log_append(phase_log, "x64.codegen.function.op.slow",
        "name=" + phase_name +
        " i=" + oren_int_to_string(j) +
        " op=" + generic_op_name +
        " path=generic" +
        " ms=" + oren_int_to_string(generic_op_ms) +
        generic_extra +
        generic_loc)
    return nil
}

fn _x64_emit_ops_count(ops) {
    var n = 0
    if ops != nil { n = oren_list_len(ops) }
    return n
}

fn _x64_emit_ops_trace_state(ctx) {
    var trace = false
    if ctx != nil && ctx["trace_emit_ops"] == true { trace = true }
    var trace_stride = 200
    if trace {
        trace_stride = core.parse_int_decimal(oren_env("OREN_TRACE_X64_EMIT_OPS_STRIDE"), trace_stride)
        if trace_stride < 1 { trace_stride = 1 }
    }
    return {"trace": trace, "trace_stride": trace_stride}
}

fn _x64_emit_ops_phase_state(ctx, loop_cond_label, loop_end_label) {
    var phase_log = nil
    var phase_name = nil
    var phase_stride = 0
    var phase_outer = false
    if ctx != nil {
        phase_log = ctx["emit_ops_phase_log"]
        phase_name = ctx["emit_ops_phase_name"]
        var stride_enc = ctx["emit_ops_phase_stride"]
        if oren_type_tag(stride_enc) != 0 { phase_stride = stride_enc }
    }
    if phase_log != nil && phase_name != nil && phase_stride > 0 && loop_cond_label == nil && loop_end_label == nil {
        phase_outer = true
    }
    return {
        "phase_log": phase_log,
        "phase_name": phase_name,
        "phase_stride": phase_stride,
        "phase_outer": phase_outer
    }
}

fn _x64_emit_ops_slow_state(phase_state) {
    var op_slow_ms = 0
    var v_op_slow = oren_env("OREN_TRACE_X64_EMIT_OP_SLOW_MS")
    if v_op_slow != nil && v_op_slow != "" {
        op_slow_ms = core.parse_int_decimal(v_op_slow, op_slow_ms)
    }
    var trace_op_slow = false
    if phase_state["phase_log"] != nil && phase_state["phase_name"] != nil && op_slow_ms > 0 { trace_op_slow = true }
    return {"op_slow_ms": op_slow_ms, "trace_op_slow": trace_op_slow}
}

fn _x64_emit_ops_gas_state(ctx) {
    var gas_mode = "none"
    if ctx != nil { gas_mode = _x64_native_gas_accounting_mode(ctx) }
    return {
        "gas_stmt": gas_mode == "stmt",
        "gas_basic": gas_mode == "basic-block" || gas_mode == "block-weighted",
        "gas_weighted": gas_mode == "block-weighted",
        "gas_dynamic": gas_mode == "dynamic-emitter"
    }
}

fn _x64_emit_ops_loop_state(ctx, ops, loop_cond_label, loop_end_label) {
    var n = _x64_emit_ops_count(ops)
    var trace_state = _x64_emit_ops_trace_state(ctx)
    var phase_state = _x64_emit_ops_phase_state(ctx, loop_cond_label, loop_end_label)
    var slow_state = _x64_emit_ops_slow_state(phase_state)
    var gas_state = _x64_emit_ops_gas_state(ctx)
    return {
        "n": n,
        "trace": trace_state["trace"],
        "trace_stride": trace_state["trace_stride"],
        "phase_log": phase_state["phase_log"],
        "phase_name": phase_state["phase_name"],
        "phase_stride": phase_state["phase_stride"],
        "phase_outer": phase_state["phase_outer"],
        "op_slow_ms": slow_state["op_slow_ms"],
        "trace_op_slow": slow_state["trace_op_slow"],
        "top_string_fast_stats": {"candidates": 0, "hits": 0, "miss_type": 0},
        "gas_stmt": gas_state["gas_stmt"],
        "gas_basic": gas_state["gas_basic"],
        "gas_weighted": gas_state["gas_weighted"],
        "gas_dynamic": gas_state["gas_dynamic"],
        "charge_basic_block_next": true
    }
}

fn _x64_emit_ops_charge_gas(ctx, ops, state, op_kind, j) {
    var dynamic_note_pos = nil
    var dynamic_span_start = nil
    if state["gas_dynamic"] == true && op_kind != "if" && op_kind != "while" && op_kind != "for" {
        dynamic_note_pos = _emit_native_gas_note_x64_patchable_u32(ctx)
        dynamic_span_start = bytes_len(ctx["code"])
    } else if state["gas_stmt"] == true {
        _emit_native_gas_note_x64(ctx, 1)
    } else if state["gas_basic"] == true && state["charge_basic_block_next"] == true {
        var block_gas_amount = 1
        if state["gas_weighted"] == true {
            block_gas_amount = _x64_native_block_weighted_gas_amount(ops, j)
        }
        _emit_native_gas_note_x64(ctx, block_gas_amount)
        state["charge_basic_block_next"] = false
    }
    return {"note_pos": dynamic_note_pos, "span_start": dynamic_span_start}
}

fn _x64_prebuilt_batch_start_ns(state) {
    if state["trace_op_slow"] == true { return oren_time_now_ns() }
    return 0
}

fn _x64_prebuilt_batch_elapsed_ms(state, start_ns) {
    if state["trace_op_slow"] != true { return nil }
    var elapsed_ms = (oren_time_now_ns() - start_ns) / 1000000
    if elapsed_ms < state["op_slow_ms"] { return nil }
    return elapsed_ms
}

fn _x64_prebuilt_batch_record_string_slow(op, state, j, start_ns) {
    var elapsed_ms = _x64_prebuilt_batch_elapsed_ms(state, start_ns)
    if elapsed_ms == nil { return nil }
    _x64_program_phase_log_append(state["phase_log"], "x64.codegen.function.op.slow",
        "name=" + state["phase_name"] +
        " i=" + oren_int_to_string(j) +
        " op=global_string_init_batch" +
        " path=prebuilt_table" +
        " ms=" + oren_int_to_string(elapsed_ms) +
        " count=" + oren_int_to_string(op["count"]))
    return nil
}

fn _x64_prebuilt_batch_record_empty_slow(op, state, j, start_ns) {
    var elapsed_ms = _x64_prebuilt_batch_elapsed_ms(state, start_ns)
    if elapsed_ms == nil { return nil }
    _x64_program_phase_log_append(state["phase_log"], "x64.codegen.function.op.slow",
        "name=" + state["phase_name"] +
        " i=" + oren_int_to_string(j) +
        " op=global_empty_container_init_batch" +
        " path=prebuilt_table" +
        " kind=" + op["kind"] +
        " ms=" + oren_int_to_string(elapsed_ms) +
        " count=" + oren_int_to_string(op["count"]))
    return nil
}

fn _x64_emit_prebuilt_string_batch_op(ctx, op, state, j) {
    if oren_type_tag(op["table_off"]) != 1 { return false }
    var start_ns = _x64_prebuilt_batch_start_ns(state)
    _x64_emit_top_string_global_batch_loop(ctx, op["table_off"])
    _x64_prebuilt_batch_record_string_slow(op, state, j, start_ns)
    return true
}

fn _x64_emit_prebuilt_empty_batch_op(ctx, op, platform, state, j) {
    if oren_type_tag(op["table_off"]) != 1 { return false }
    var start_ns = _x64_prebuilt_batch_start_ns(state)
    _x64_emit_top_empty_container_batch_loop(ctx, op["table_off"], op["kind"], platform)
    _x64_prebuilt_batch_record_empty_slow(op, state, j, start_ns)
    return true
}

fn _x64_emit_prebuilt_batch_op(ctx, op, platform, state, j) {
    var op_kind = op["op"]
    if op_kind == "global_string_init_batch" {
        return _x64_emit_prebuilt_string_batch_op(ctx, op, state, j)
    }
    if op_kind == "global_empty_container_init_batch" {
        return _x64_emit_prebuilt_empty_batch_op(ctx, op, platform, state, j)
    }
    return false
}

fn _x64_emit_ops_finish_regular(ctx, state, dynamic_gas, op, op_kind, j) {
    _x64_patch_dynamic_gas_if_needed(ctx, dynamic_gas["note_pos"], dynamic_gas["span_start"])
    if state["gas_basic"] == true {
        var opk_bb = op_kind
        if opk_bb == "if" || opk_bb == "while" || opk_bb == "for" {
            state["charge_basic_block_next"] = true
        }
    }
    _x64_emit_ops_record_slow(ctx, state["trace_op_slow"], state["phase_log"], state["phase_name"],
        op, op_kind, j, state["op_start_ns"], state["op_slow_ms"])
    return nil
}

fn _x64_emit_ops_summary(ctx, state) {
    if state["phase_outer"] != true { return nil }
    var stats = state["top_string_fast_stats"]
    _x64_program_phase_log_append(state["phase_log"], "x64.codegen.function.body.summary",
        "name=" + state["phase_name"] +
        " top_string_candidates=" + oren_int_to_string(stats["candidates"]) +
        " top_string_hits=" + oren_int_to_string(stats["hits"]) +
        " top_string_miss_type=" + oren_int_to_string(stats["miss_type"]))
    return nil
}

fn _x64_emit_regular_init_op(ctx, op_kind, op, locals, j, op_start_ns, op_slow_ms) {
    if op_kind == "var_i32" {
        _emit_var_i32_op_x64(ctx, op, locals)
        return 0
    }
    if op_kind == "global_string_init" {
        _emit_global_string_init_op_x64(ctx, op, j, op_start_ns, op_slow_ms)
        return 0
    }
    if op_kind == "global_string_init_batch" {
        _emit_global_string_init_batch_op_x64(ctx, op, j, op_start_ns, op_slow_ms)
        return 0
    }
    return nil
}

fn _x64_emit_regular_value_op(ctx, op_kind, op, locals, platform, j, op_start_ns, op_slow_ms, top_string_fast_stats) {
    if op_kind == "assign_i32" {
        var assign_status = _emit_assign_i32_op_x64(ctx, op, locals, platform, j, op_start_ns, op_slow_ms, top_string_fast_stats)
        if assign_status == 1 { return 1 }
        return 0
    }
    if op_kind == "expr" {
        _expr_int_check(ctx, op["expr"], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
        _emit_eval_int_to_rax(ctx, op["expr"], locals)
        return 0
    }
    return nil
}

fn _x64_emit_regular_print_op(ctx, op_kind, op, locals, platform) {
    if op_kind == "print_str_expr" {
        _emit_print_stmt_str_x64(ctx, locals, op["expr"])
        return 0
    }
    if op_kind == "print_cstr" {
        if platform != nil && platform["os"] == "linux" {
            _emit_linux_write_cstr(ctx, op["value"])
        } else if platform != nil && platform["os"] == "windows" {
            _emit_windows_write_cstr(ctx, op["value"])
        } else {
            err(ctx, "x64 native v0: print unsupported on this target")
        }
        return 0
    }
    return nil
}

fn _x64_emit_regular_return_op(ctx, op_kind, op, locals, local_fixups, epilogue_label) {
    if op_kind == "return" {
        _expr_int_check(ctx, op["expr"], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
        _emit_eval_int_to_rax(ctx, op["expr"], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
        _emit_jmp_to_label(ctx, local_fixups, epilogue_label)
        return 0
    }
    return nil
}

fn _x64_emit_regular_straightline_op(ctx, op_kind, op, locals, local_fixups, epilogue_label, platform, j, op_start_ns, op_slow_ms, top_string_fast_stats) {
    var init_status = _x64_emit_regular_init_op(ctx, op_kind, op, locals, j, op_start_ns, op_slow_ms)
    if init_status != nil { return init_status }

    var value_status = _x64_emit_regular_value_op(ctx, op_kind, op, locals, platform, j, op_start_ns, op_slow_ms, top_string_fast_stats)
    if value_status != nil { return value_status }

    var print_status = _x64_emit_regular_print_op(ctx, op_kind, op, locals, platform)
    if print_status != nil { return print_status }

    return _x64_emit_regular_return_op(ctx, op_kind, op, locals, local_fixups, epilogue_label)
}

fn _x64_emit_regular_if_op(ctx, op_kind, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label) {
    if op_kind != "if" { return nil }
    var cond = op["cond"]
    var else_label = _new_label(ctx, "if_else")
    var end_label = _new_label(ctx, "if_end")
    _emit_jcc_false_for_cond_x64(ctx, cond, locals, local_fixups, else_label)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
    _emit_ops_in_fn(ctx, op["then"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
    _emit_jmp_to_label(ctx, local_fixups, end_label)
    _emit_label(ctx, labels, else_label)
    _emit_ops_in_fn(ctx, op["else"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 0 }
    _emit_label(ctx, labels, end_label)
    return 0
}

fn _x64_emit_regular_loop_op(ctx, op_kind, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, gas_weighted, gas_dynamic) {
    if op_kind == "while" {
        _emit_while_op_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform)
        return 0
    }
    if op_kind == "for" {
        _emit_for_op_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, gas_weighted, gas_dynamic)
        return 0
    }
    return nil
}

fn _x64_emit_regular_loop_jump_op(ctx, op_kind, local_fixups, loop_cond_label, loop_end_label) {
    if op_kind == "break" {
        if loop_end_label == nil { err(ctx, "x64 native v0: break outside loop"); return 0 }
        _emit_jmp_to_label(ctx, local_fixups, loop_end_label)
        return 0
    }
    if op_kind == "continue" {
        if loop_cond_label == nil { err(ctx, "x64 native v0: continue outside loop"); return 0 }
        _emit_jmp_to_label(ctx, local_fixups, loop_cond_label)
        return 0
    }
    return nil
}

fn _x64_emit_regular_control_op(ctx, op_kind, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, gas_weighted, gas_dynamic) {
    var if_status = _x64_emit_regular_if_op(ctx, op_kind, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
    if if_status != nil { return if_status }

    var loop_status = _x64_emit_regular_loop_op(ctx, op_kind, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, gas_weighted, gas_dynamic)
    if loop_status != nil { return loop_status }

    var jump_status = _x64_emit_regular_loop_jump_op(ctx, op_kind, local_fixups, loop_cond_label, loop_end_label)
    if jump_status != nil {
        return jump_status
    }
    return nil
}

fn _x64_emit_regular_op(ctx, op_kind, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, j, op_start_ns, op_slow_ms, top_string_fast_stats, gas_weighted, gas_dynamic) {
    var straight_status = _x64_emit_regular_straightline_op(ctx, op_kind, op, locals, local_fixups, epilogue_label, platform, j, op_start_ns, op_slow_ms, top_string_fast_stats)
    if straight_status != nil { return straight_status }

    var control_status = _x64_emit_regular_control_op(ctx, op_kind, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, gas_weighted, gas_dynamic)
    if control_status != nil { return control_status }

    err(ctx, "x64 native v0: unknown op in main")
    return 0
}

fn _x64_emit_ops_prepare_one(ctx, ops, state, locals, j, n) {
    var op_start_ns = 0
    if state["trace_op_slow"] == true { op_start_ns = oren_time_now_ns() }
    state["op_start_ns"] = op_start_ns
    var op = oren_list_get(ops, j)
    if op == nil { return nil }
    var next = nil
    if j + 1 < n { next = oren_list_get(ops, j + 1) }
    if _x64_should_skip_reserve_op(op, next, ctx, locals) == true { return nil }

    var op_kind = op["op"]
    _x64_emit_ops_trace_progress(ctx, state["trace"], state["trace_stride"], j, n, op, op_kind)
    _x64_emit_ops_phase_progress(ctx, state["phase_outer"], state["phase_log"], state["phase_name"],
        state["phase_stride"], j, n, op, op_kind)
    _linetab_record_tok(ctx, op["tok"])
    return {"op": op, "op_kind": op_kind, "op_start_ns": op_start_ns}
}

fn _x64_emit_ops_try_prebuilt(ctx, op, platform, state, j, dynamic_gas) {
    if _x64_emit_prebuilt_batch_op(ctx, op, platform, state, j) != true { return false }
    _x64_patch_dynamic_gas_if_needed(ctx, dynamic_gas["note_pos"], dynamic_gas["span_start"])
    return true
}

fn _x64_emit_ops_regular_prepared(ctx, op, op_kind, state, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, j, dynamic_gas) {
    var op_status = _x64_emit_regular_op(ctx, op_kind, op, locals, labels, local_fixups,
        epilogue_label, platform, loop_cond_label, loop_end_label, j, state["op_start_ns"],
        state["op_slow_ms"], state["top_string_fast_stats"], state["gas_weighted"], state["gas_dynamic"])
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if op_status == 1 {
        _x64_patch_dynamic_gas_if_needed(ctx, dynamic_gas["note_pos"], dynamic_gas["span_start"])
        return 0
    }
    _x64_emit_ops_finish_regular(ctx, state, dynamic_gas, op, op_kind, j)
    return 0
}

fn _x64_emit_ops_one_in_fn(ctx, ops, state, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label, j, n) {
    var prepared = _x64_emit_ops_prepare_one(ctx, ops, state, locals, j, n)
    if prepared == nil { return 0 }
    var op = prepared["op"]
    var op_kind = prepared["op_kind"]
    var dynamic_gas = _x64_emit_ops_charge_gas(ctx, ops, state, op_kind, j)
    if _x64_emit_ops_try_prebuilt(ctx, op, platform, state, j, dynamic_gas) == true { return 0 }
    return _x64_emit_ops_regular_prepared(ctx, op, op_kind, state, locals, labels, local_fixups,
        epilogue_label, platform, loop_cond_label, loop_end_label, j, dynamic_gas)
}

fn _emit_ops_in_fn(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label) {
    var state = _x64_emit_ops_loop_state(ctx, ops, loop_cond_label, loop_end_label)
    var n = state["n"]
    if state["trace"] == true { print("[x64_emit_ops] enter len=" + oren_int_to_string(n)) }
    var j = 0
    while j < n {
        if _x64_emit_ops_one_in_fn(ctx, ops, state, locals, labels, local_fixups, epilogue_label,
            platform, loop_cond_label, loop_end_label, j, n) == nil { return nil }
        j = j + 1
    }
    _x64_emit_ops_summary(ctx, state)
    return nil
}
