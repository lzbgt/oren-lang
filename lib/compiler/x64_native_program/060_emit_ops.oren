fn _x64_str_eq_bytes_local(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _x64_list_name_in_fast(list_name, lists) {
    if list_name == nil || lists == nil { return false }
    var i = 0
    while i < oren_list_len(lists) {
        if _x64_str_eq_bytes_local(lists[i], list_name) == true { return true }
        i = i + 1
    }
    return false
}

fn _x64_reserve_call_info(op) {
    if op == nil || op["op"] != "expr" { return nil }
    var expr = op["expr"]
    if expr == nil || expr["type"] != "Call" { return nil }
    var fn0 = expr["fn"]
    if fn0 == nil || fn0["type"] != "Identifier" { return nil }
    var nm = fn0["value"]
    var kind = nil
    if nm == "oren_list_int_reserve" || nm == "STD_list_int_reserve" { kind = "list_int" }
    else if nm == "oren_list_reserve" || nm == "STD_list_reserve" { kind = "list" }
    else { return nil }
    var args = expr["args"]
    if args == nil || oren_list_len(args) < 2 { return nil }
    var recv = args[0]
    if recv == nil || recv["type"] != "Identifier" { return nil }
    return {"kind": kind, "list": recv["value"], "cap_expr": args[1]}
}

fn _x64_reserve_cap_matches_fast(res_info, fast_info) {
    if res_info == nil || fast_info == nil { return false }
    var cap_expr = res_info["cap_expr"]
    if cap_expr == nil { return false }
    var n_name = fast_info["n"]
    var n_const = fast_info["n_const"]
    if n_name != nil {
        if cap_expr["type"] == "Identifier" && _x64_str_eq_bytes_local(cap_expr["value"], n_name) == true { return true }
    } else if n_const != nil {
        if cap_expr["type"] == "Integer" && cap_expr["value"] == oren_int_to_string(n_const) { return true }
    }
    return false
}

fn _x64_should_skip_reserve_op(op, next, ctx, locals) {
    var res_info = _x64_reserve_call_info(op)
    if res_info == nil || next == nil { return false }
    if next["op"] != "while" { return false }
    if res_info["kind"] == "list_int" {
        var fast_info = _x64_match_fast_list_int_push_while(ctx, next, locals)
        if fast_info == nil { return false }
        if _x64_list_name_in_fast(res_info["list"], fast_info["lists"]) != true { return false }
        return _x64_reserve_cap_matches_fast(res_info, fast_info)
    }
    if res_info["kind"] == "list" {
        var fast_info2 = _x64_match_fast_list_push_while(ctx, next, locals)
        if fast_info2 == nil { return false }
        if _x64_list_name_in_fast(res_info["list"], fast_info2["lists"]) != true { return false }
        return _x64_reserve_cap_matches_fast(res_info, fast_info2)
    }
    return false
}

fn _x64_native_op_gas_weight(op) {
    if op == nil { return 0 }
    var k = op["op"]
    if k == nil { return 0 }
    if k == "if" || k == "while" || k == "for" { return 2 }
    return 1
}

fn _x64_native_op_ends_block(op) {
    if op == nil { return false }
    var k = op["op"]
    if k == "if" || k == "while" || k == "for" { return true }
    if k == "return" || k == "break" || k == "continue" { return true }
    return false
}

fn _x64_native_block_weighted_gas_amount(ops, start) {
    if ops == nil { return 1 }
    var n = oren_list_len(ops)
    var i = start
    var total = 0
    while i < n {
        var op = ops[i]
        total = total + _x64_native_op_gas_weight(op)
        if _x64_native_op_ends_block(op) == true { break }
        i = i + 1
    }
    if total <= 0 { return 1 }
    return total
}

fn _x64_dynamic_emitter_op_should_charge(ctx, op) {
    if _x64_native_dynamic_emitter_gas_enabled(ctx) != true { return false }
    if op == nil { return false }
    var k = op["op"]
    if k == "if" || k == "while" || k == "for" { return false }
    return true
}

fn _emit_ops_in_fn(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label) {
    var n = 0
    if ops != nil { n = oren_list_len(ops) }
    var trace = false
    if ctx != nil && ctx["trace_emit_ops"] == true { trace = true }
    var trace_stride = 200
    if trace {
        trace_stride = core.parse_int_decimal(oren_env("OREN_TRACE_X64_EMIT_OPS_STRIDE"), trace_stride)
        if trace_stride < 1 { trace_stride = 1 }
    }
    var phase_log = nil
    var phase_name = nil
    var phase_stride = 0
    var phase_outer = false
    if ctx != nil {
        phase_log = ctx["emit_ops_phase_log"]
        phase_name = ctx["emit_ops_phase_name"]
        var stride_enc = ctx["emit_ops_phase_stride"]
        if oren_type_tag(stride_enc) != 0 { phase_stride = stride_enc }
    }
    if phase_log != nil && phase_name != nil && phase_stride > 0 && loop_cond_label == nil && loop_end_label == nil {
        phase_outer = true
    }
    var top_string_fast_candidates = 0
    var top_string_fast_hits = 0
    var top_string_fast_miss_type = 0
    if trace { print("[x64_emit_ops] enter len=" + oren_int_to_string(n)) }
    var j = 0
    var charge_basic_block_next = true
    while j < n {
        var op = ops[j]
        if op == nil { j = j + 1; continue }
        var next = nil
        if j + 1 < n { next = ops[j + 1] }
        if _x64_should_skip_reserve_op(op, next, ctx, locals) == true {
            j = j + 1
            continue
        }
        if trace && core.int_mod(j, trace_stride) == 0 {
            var opk = op["op"]
            if opk == nil { opk = "?" }
            var extra = ""
            if opk == "var_i32" || opk == "assign_i32" {
                var nm = op["name"]
                if nm != nil && nm != "" { extra = " name=" + nm }
            }
            var loc = ""
            var tok = op["tok"]
            if tok != nil && tok["file"] != nil && tok["line"] != nil {
                loc = " @" + tok["file"] + ":" + oren_int_to_string(tok["line"])
            }
            print("[x64_emit_ops] j=" + oren_int_to_string(j) + "/" + oren_int_to_string(n) + " op=" + opk + extra + loc)
        }
        if phase_outer && core.int_mod(j, phase_stride) == 0 {
            var opk_phase = op["op"]
            if opk_phase == nil { opk_phase = "?" }
            var loc_phase = ""
            var tok_phase = op["tok"]
            if tok_phase != nil && tok_phase["file"] != nil && tok_phase["line"] != nil {
                loc_phase = " file=" + tok_phase["file"] + " line=" + oren_int_to_string(tok_phase["line"])
            }
            _x64_program_phase_log_append(phase_log, "x64.codegen.function.body.progress",
                "name=" + phase_name +
                " i=" + oren_int_to_string(j) +
                " total=" + oren_int_to_string(n) +
                " op=" + opk_phase +
                " code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])) +
                loc_phase)
        }
        _linetab_record_tok(ctx, op["tok"])
        var dynamic_note_pos = nil
        var dynamic_span_start = nil
        if _x64_dynamic_emitter_op_should_charge(ctx, op) == true {
            dynamic_note_pos = _emit_native_gas_note_x64_patchable_u32(ctx)
            dynamic_span_start = bytes_len(ctx["code"])
        } else if _x64_native_stmt_gas_enabled(ctx) == true {
            _emit_native_gas_note_x64(ctx, 1)
        } else if _x64_native_basic_block_gas_enabled(ctx) == true && charge_basic_block_next == true {
            var block_gas_amount = 1
            if _x64_native_block_weighted_gas_enabled(ctx) == true {
                block_gas_amount = _x64_native_block_weighted_gas_amount(ops, j)
            }
            _emit_native_gas_note_x64(ctx, block_gas_amount)
            charge_basic_block_next = false
        }
        if op["op"] == "var_i32" {
            var name = op["name"]
            var off = locals[name]
            if oren_type_tag(off) == 0 {
                var fnm = "?"
                if ctx != nil && ctx["cur_fn_name"] != nil { fnm = ctx["cur_fn_name"] }
                var nm_s = "?"
                if name != nil {
                    if oren_is_string(name) == true { nm_s = name }
                    else if oren_type_tag(name) == 1 { nm_s = "<int " + oren_int_to_string(name) + ">" }
                    else { nm_s = "<non-string>" }
                }
                err(ctx, "x64 native v0: missing local slot fn=" + fnm + " name=" + nm_s + " locals_len=" + oren_int_to_string(oren_map_len(locals)))
                return nil
            }
            _expr_int_check(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            if ctx["locals_floaty"] != nil {
                ctx["locals_floaty"][op["name"]] = _x64_expr_is_floaty(ctx, op["expr"])
            }
            if ctx["locals_inty"] != nil {
                ctx["locals_inty"][op["name"]] = _x64_expr_is_inty(ctx, op["expr"])
            }
            if ctx["locals_int_const"] != nil {
                ctx["locals_int_const"][op["name"]] = _x64_expr_int_const(ctx, op["expr"])
            }
            _emit_eval_int_to_rax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        } else if op["op"] == "assign_i32" {
            var off2 = locals[op["name"]]
            var top_string_fast_candidate = false
            if op["__oren_top_level_global_init"] == true && oren_type_tag(off2) == 0 {
                top_string_fast_candidate = true
                top_string_fast_candidates = top_string_fast_candidates + 1
            }
            if top_string_fast_candidate == true &&
               op["expr"] != nil &&
               op["expr"]["type"] == "String" {
                top_string_fast_hits = top_string_fast_hits + 1
                var name_fast = op["name"]
                var goff_enc_fast = nil
                if ctx["globals"] != nil { goff_enc_fast = ctx["globals"][name_fast] }
                if oren_type_tag(goff_enc_fast) == 0 { err(ctx, "x64 native v0: assign unknown var " + name_fast); return nil }
                var s_fast = op["expr"]["value"]
                if s_fast == nil || oren_is_string(s_fast) != true {
                    var tok_fast = op["expr"]["token"]
                    if tok_fast != nil && tok_fast["literal"] != nil && oren_is_string(tok_fast["literal"]) == true {
                        s_fast = tok_fast["literal"]
                    }
                }
                if s_fast == nil { s_fast = "" }
                var cstr_off_fast = _data_add_cstr0_nodedup(ctx, s_fast)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
                var lea_lit_fast = bytes_len(ctx["code"])
                bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(0, 0))
                oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_lit_fast + 3, "data_off": cstr_off_fast})
                var goff_fast = goff_enc_fast - 1
                var lea_slot_fast = bytes_len(ctx["code"])
                bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
                oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_slot_fast + 3, "data_off": goff_fast})
                bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
                j = j + 1
                continue
            }
            if top_string_fast_candidate == true {
                top_string_fast_miss_type = top_string_fast_miss_type + 1
            }
            _expr_int_check(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            if ctx["locals_floaty"] != nil && top_string_fast_candidate != true {
                ctx["locals_floaty"][op["name"]] = _x64_expr_is_floaty(ctx, op["expr"])
            }
            if ctx["locals_inty"] != nil && top_string_fast_candidate != true {
                ctx["locals_inty"][op["name"]] = _x64_expr_is_inty(ctx, op["expr"])
            }
            if ctx["locals_int_const"] != nil && top_string_fast_candidate != true {
                ctx["locals_int_const"][op["name"]] = _x64_expr_int_const(ctx, op["expr"])
            }
            _emit_eval_int_to_rax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            if oren_type_tag(off2) != 0 {
                _emit_mov_mrbp_r64(ctx, 0 - off2, 0)
            } else {
                // Global assignment (top-level `var` in data blob).
                var name = op["name"]
                var goff_enc = nil
                if ctx["globals"] != nil { goff_enc = ctx["globals"][name] }
                if oren_type_tag(goff_enc) == 0 { err(ctx, "x64 native v0: assign unknown var " + name); return nil }
                var goff = goff_enc - 1
                if op["__oren_top_level_global_init"] != true {
                    var meta_expr = op["expr"]
                    var global_floaty = false
                    var global_inty = false
                    var global_const = nil
                    if meta_expr != nil && meta_expr["type"] == "Integer" {
                        global_inty = true
                        global_const = _x64_expr_int_const(ctx, meta_expr)
                    } else {
                        global_floaty = _x64_expr_is_floaty(ctx, meta_expr)
                        if global_floaty != true { global_inty = _x64_expr_is_inty(ctx, meta_expr) }
                        global_const = _x64_expr_int_const(ctx, meta_expr)
                    }
                    if ctx["globals_floaty"] != nil {
                        ctx["globals_floaty"][name] = global_floaty
                    }
                    if ctx["globals_inty"] != nil {
                        ctx["globals_inty"][name] = global_inty
                    }
                    if ctx["globals_int_const"] != nil {
                        ctx["globals_int_const"][name] = global_const
                    }
                }

                // r10 = &global_slot ; *(u64*)r10 = rax
                var lea_pos = bytes_len(ctx["code"])
                bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
                oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": goff})
                bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
            }
        } else if op["op"] == "expr" {
            // Expression statement: evaluate and discard return value.
            _expr_int_check(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_eval_int_to_rax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        } else if op["op"] == "print_str_expr" {
            _emit_print_stmt_str_x64(ctx, locals, op["expr"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        } else if op["op"] == "print_cstr" {
            if platform != nil && platform["os"] == "linux" {
                _emit_linux_write_cstr(ctx, op["value"])
            } else if platform != nil && platform["os"] == "windows" {
                _emit_windows_write_cstr(ctx, op["value"])
            } else {
                err(ctx, "x64 native v0: print unsupported on this target")
                return nil
            }
        } else if op["op"] == "return" {
            _expr_int_check(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_eval_int_to_rax(ctx, op["expr"], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_jmp_to_label(ctx, local_fixups, epilogue_label)
        } else if op["op"] == "if" {
            var cond = op["cond"]
            var else_label = _new_label(ctx, "if_else")
            var end_label = _new_label(ctx, "if_end")
            _emit_jcc_false_for_cond_x64(ctx, cond, locals, local_fixups, else_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_ops_in_fn(ctx, op["then"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_jmp_to_label(ctx, local_fixups, end_label)
            _emit_label(ctx, labels, else_label)
            _emit_ops_in_fn(ctx, op["else"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _emit_label(ctx, labels, end_label)
        } else if op["op"] == "while" {
            var fast_lcg = _x64_match_fast_lcg_sum_while(ctx, op, locals)
            if fast_lcg != nil {
                _emit_fast_lcg_sum_while_x64(ctx, op, fast_lcg, locals, labels, local_fixups, epilogue_label, platform)
            } else {
                var fast_info = _x64_match_fast_list_int_push_while(ctx, op, locals)
                if fast_info != nil {
                    _emit_fast_list_int_push_while_x64(ctx, op, fast_info, locals, labels, local_fixups, epilogue_label, platform)
                } else {
                    var fast_box_push = _x64_match_fast_list_push_while(ctx, op, locals)
                    if fast_box_push != nil {
                        _emit_fast_list_push_while_x64(ctx, op, fast_box_push, locals, labels, local_fixups, epilogue_label, platform)
                    } else {
                        var fast_dot = _x64_match_fast_list_int_dot_while(ctx, op, locals)
                        if fast_dot != nil {
                            _emit_fast_list_int_dot_while_x64(ctx, op, fast_dot, locals, labels, local_fixups, epilogue_label, platform)
                        } else {
                            var fast_box_dot = _x64_match_fast_list_dot_while(ctx, op, locals)
                            if fast_box_dot != nil {
                                _emit_fast_list_dot_while_x64(ctx, op, fast_box_dot, locals, labels, local_fixups, epilogue_label, platform)
                            } else {
                                var fast_get = _x64_match_fast_list_int_get_sum_while(ctx, op, locals)
                                if fast_get != nil {
                                    _emit_fast_list_int_get_sum_while_x64(ctx, op, fast_get, locals, labels, local_fixups, epilogue_label, platform)
                                } else {
                                    var fast_box_get = _x64_match_fast_list_get_sum_while(ctx, op, locals)
                                    if fast_box_get != nil {
                                        _emit_fast_list_get_sum_while_x64(ctx, op, fast_box_get, locals, labels, local_fixups, epilogue_label, platform)
                                    } else {
                                        _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        } else if op["op"] == "for" {
            // for init; cond; post { body }
            //
            // Semantics:
            // - init runs once
            // - cond checked before each iteration
            // - continue jumps to post (then cond)
            // - break exits the loop
            var cond_label2 = _new_label(ctx, "for_cond")
            var body_label2 = _new_label(ctx, "for_body")
            var post_label2 = _new_label(ctx, "for_post")
            var end_label3 = _new_label(ctx, "for_end")

            _emit_ops_in_fn(ctx, op["init"], locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_label(ctx, labels, cond_label2)
            if _x64_native_block_weighted_gas_enabled(ctx) == true {
                _emit_native_gas_note_x64(ctx, 2)
            }
            _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, 255)
            var dynamic_cond_note = nil
            var dynamic_cond_start = nil
            if _x64_native_dynamic_emitter_gas_enabled(ctx) == true {
                dynamic_cond_note = _emit_native_gas_note_x64_patchable_u32(ctx)
                dynamic_cond_start = bytes_len(ctx["code"])
            }
            _emit_jcc_false_for_cond_x64(ctx, op["cond"], locals, local_fixups, end_label3)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            if dynamic_cond_note != nil && dynamic_cond_start != nil {
                _patch_native_gas_note_x64_u32(ctx, dynamic_cond_note, bytes_len(ctx["code"]) - dynamic_cond_start)
            }

            _emit_label(ctx, labels, body_label2)
            _emit_ops_in_fn(ctx, op["body"], locals, labels, local_fixups, epilogue_label, platform, post_label2, end_label3)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_label(ctx, labels, post_label2)
            // Post must not use break/continue (enforced by analyzer); pass nil to be strict.
            _emit_ops_in_fn(ctx, op["post"], locals, labels, local_fixups, epilogue_label, platform, nil, nil)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            _emit_jmp_to_label(ctx, local_fixups, cond_label2)
            _emit_label(ctx, labels, end_label3)
        } else if op["op"] == "break" {
            if loop_end_label == nil { err(ctx, "x64 native v0: break outside loop"); return nil }
            _emit_jmp_to_label(ctx, local_fixups, loop_end_label)
        } else if op["op"] == "continue" {
            if loop_cond_label == nil { err(ctx, "x64 native v0: continue outside loop"); return nil }
            _emit_jmp_to_label(ctx, local_fixups, loop_cond_label)
        } else {
            err(ctx, "x64 native v0: unknown op in main")
            return nil
        }
        if dynamic_note_pos != nil && dynamic_span_start != nil {
            _patch_native_gas_note_x64_u32(ctx, dynamic_note_pos, bytes_len(ctx["code"]) - dynamic_span_start)
        }
        if _x64_native_basic_block_gas_enabled(ctx) == true {
            var opk_bb = op["op"]
            if opk_bb == "if" || opk_bb == "while" || opk_bb == "for" {
                charge_basic_block_next = true
            }
        }
        j = j + 1
    }
    if phase_outer {
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.body.summary",
            "name=" + phase_name +
            " top_string_candidates=" + oren_int_to_string(top_string_fast_candidates) +
            " top_string_hits=" + oren_int_to_string(top_string_fast_hits) +
            " top_string_miss_type=" + oren_int_to_string(top_string_fast_miss_type))
    }
    return nil
}
