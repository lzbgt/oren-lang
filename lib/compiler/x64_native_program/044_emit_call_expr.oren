    }

    // Spill fn_obj (callee evaluated as a first-class callable value).
    var fn_slot = iadd(args_slot, 1)
    if has_spread { fn_slot = iadd(args_slot, 5) }
    var fn_off = _intr_tmp_off(ctx, locals, fn_slot)
    if oren_type_tag(fn_off) == 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_eval_int_to_rax(ctx, fn_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fn_off, 0)
    var fn_tmp = {"type": "IntrTmp", "idx": fn_slot}

    // Call runtime helper: oren_spawn_call_list(fn_obj, args_list)
    // (Tier‑1 Windows is also routed through this helper; runtime chooses green-task vs thread fallback.)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_spawn_call_list"}, "args": [fn_tmp, args_tmp]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_varargs_named_call_via_fnobj_x64(ctx, locals, nm, args) {
    // Tier-1 convergence: if the injected native runtime is enabled, lower varargs named calls
    // through the uniform callable ABI, matching arm64:
    //   fn_obj(args...)  =>  args_list = [args...] ; oren_call_obj_list(fn_obj, args_list)
    //
    // This avoids x64-only call-site varargs packing and centralizes varargs semantics
