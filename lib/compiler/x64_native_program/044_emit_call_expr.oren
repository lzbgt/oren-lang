// Generic call expression lowering for x64 native.
//
// Kept in a dedicated chunk to prevent `040_emit_expr.oren` from growing beyond
// reviewable limits as x64 Tier‑1 call semantics converge with AVM/C.

fn _emit_generic_call_expr_v0(ctx, expr, locals, nm, args) {
    if nm == "print" { err(ctx, "x64 native v0: print is statement-only"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }

    var spread = expr["spread"]

    var is_direct = false
    var declared = ctx["declared_functions"]
    if declared != nil && declared[nm] != nil { is_direct = true }

    // Varargs packing (rolling): if the callee is a known named function with a trailing
    // `...rest`, pack extra args into a list and call the real function with:
    //   fn(fixed0, fixed1, ..., rest_list)
    var varargs_fixed = nil
    if ctx["func_varargs_fixed"] != nil { varargs_fixed = ctx["func_varargs_fixed"][nm] }
    var is_varargs_named = (is_direct == true && varargs_fixed != nil)
    // Wrapper functions (`__oren_fnwrap_<name>`) already receive a pre-packed `rest_list` and
    // must call the real varargs function at fixed arity (fixed args + rest_list).
    //
    // Avoid applying call-site packing inside wrappers, otherwise we would produce nested rest
    // lists (`rest = [[...]]`).
    if is_varargs_named {
        var cur_fn = ctx["cur_fn_name"]
        if cur_fn != nil && cur_fn == "__oren_fnwrap_" + nm {
            is_varargs_named = false
            varargs_fixed = nil
        }
    }

    // Spread support (rolling): only for known fixed-arity named functions.
    //
    // `f(a, xs...)` lowers as:
    // - runtime check: len(xs) == (arity(f) - fixed_argc) else abort(1)
    // - materialize needed elements via `xs[i]` and pass as normal args
    //
    // This keeps semantics consistent with AVM while avoiding dynamic call ABI work in v0.
    var has_spread = (spread != nil)
    if has_spread && is_direct == true {
        var arity = nil
        if ctx["func_arity"] != nil { arity = ctx["func_arity"][nm] }
        if arity == nil { err(ctx, "x64 native v0: missing arity for function " + nm); return nil }

        // --- varargs + spread ---
        //
        // For a known varargs function `fn f(a,b,...rest)` (fixed=2, arity=3),
        // lower `f(args..., xs...)` as:
        // - evaluate explicit args (args...)
        // - evaluate `xs` list and get `len(xs)`
        // - runtime check: argc + len(xs) >= fixed else abort(1)
        // - fill missing fixed args (if any) from xs[0..missing-1]
        // - build rest_list:
        //     - push explicit args beyond fixed
        //     - push xs[missing..] (dynamic loop)
        // - call f(fixed0..fixedN-1, rest_list)
        if is_varargs_named {
            var fixed = varargs_fixed
            if arity != fixed + 1 {
                err(ctx, "x64 native v0: inconsistent varargs signature for " + nm)
                return nil
            }

            var missing = 0
            if argc < fixed { missing = fixed - argc }

            // Spill layout:
            // - explicit args: [base + 0 .. base + argc-1]
            // - spread list:  base + argc
            // - rest_list:    base + argc + 1
            // - idx:          base + argc + 2
            // - len:          base + argc + 3
            // - elem:         base + argc + 4
            // - missing fixed spill: base + argc + 5 .. + missing-1
            var spill_n = argc + 5 + missing
            var base = _intr_tmp_push(ctx, spill_n)
            if base == nil { return nil }

            // Spill explicit args
            var i = 0
            while i < argc {
                _emit_eval_int_to_rax(ctx, args[i], locals)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
                var off = _intr_tmp_off(ctx, locals, base + i)
                if off == nil { _intr_tmp_pop(ctx, base); return nil }
                _emit_mov_mrbp_r64(ctx, 0 - off, 0)
                i = i + 1
            }

            // Spill spread list
            var spread_slot = base + argc
            var spread_off = _intr_tmp_off(ctx, locals, spread_slot)
            if spread_off == nil { _intr_tmp_pop(ctx, base); return nil }
            _emit_eval_int_to_rax(ctx, spread, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - spread_off, 0)

            // len = oren_list_len(spread)
            var len_slot = base + argc + 3
            var len_off = _intr_tmp_off(ctx, locals, len_slot)
            if len_off == nil { _intr_tmp_pop(ctx, base); return nil }
            var spread_name = "$tmp_intr" + oren_int_to_string(spread_slot)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_len"}, "args": [{"type": "Identifier", "value": spread_name}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - len_off, 0)

            // If we are missing fixed args, require len >= missing.
            if missing > 0 {
                _emit_mov_r64_mrbp(ctx, 0, 0 - len_off) // rax = len
                bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, missing))
                var labels0 = {}
                var fixups0 = []
                var l_ok0 = _new_label(ctx, "varargs_spread_fixed_ok")
                _emit_jcc_to_label(ctx, fixups0, "ge", l_ok0)
                _emit_abort_exitcode(ctx, 1)
                _emit_label(ctx, labels0, l_ok0)
                _patch_local_fixups(ctx, labels0, fixups0)

                // Materialize missing fixed args from spread[0..missing-1].
                var j = 0
                while j < missing {
                    var slot = base + argc + 5 + j
                    var off2 = _intr_tmp_off(ctx, locals, slot)
                    if off2 == nil { _intr_tmp_pop(ctx, base); return nil }

                    _emit_eval_int_to_rax(ctx, {"type": "Index", "left": {"type": "Identifier", "value": spread_name}, "index": {"type": "Integer", "value": oren_int_to_string(j)}}, locals)
                    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
                    _emit_mov_mrbp_r64(ctx, 0 - off2, 0)
                    j = j + 1
                }
            }

            // rest_list = oren_new_list(0)
            var rest_slot = base + argc + 1
            var rest_off = _intr_tmp_off(ctx, locals, rest_slot)
            if rest_off == nil { _intr_tmp_pop(ctx, base); return nil }
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - rest_off, 0)
            var rest_name = "$tmp_intr" + oren_int_to_string(rest_slot)

            // Push explicit args beyond fixed into rest_list.
            var j2 = fixed
            while j2 < argc {
                var arg_name = "$tmp_intr" + oren_int_to_string(base + j2)
                _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": rest_name}, {"type": "Identifier", "value": arg_name}]}, locals)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
                j2 = j2 + 1
            }

            // Push spread args beyond the missing-fixed prefix into rest_list (dynamic loop).
            //
            // idx = missing; while idx < len { rest.push(spread[idx]); idx++ }
            var idx_slot = base + argc + 2
            var idx_off = _intr_tmp_off(ctx, locals, idx_slot)
            if idx_off == nil { _intr_tmp_pop(ctx, base); return nil }
            bytes_extend(ctx["code"], insn_mov_r64_imm64(0, missing))
            _emit_mov_mrbp_r64(ctx, 0 - idx_off, 0)

            var elem_slot = base + argc + 4
            var elem_off = _intr_tmp_off(ctx, locals, elem_slot)
            if elem_off == nil { _intr_tmp_pop(ctx, base); return nil }
            var idx_name = "$tmp_intr" + oren_int_to_string(idx_slot)
            var elem_name = "$tmp_intr" + oren_int_to_string(elem_slot)

            var labels1 = {}
            var fixups1 = []
            var l_loop = _new_label(ctx, "varargs_spread_loop")
            var l_done = _new_label(ctx, "varargs_spread_done")

            _emit_label(ctx, labels1, l_loop)
            _emit_mov_r64_mrbp(ctx, 0, 0 - idx_off) // rax = idx
            _emit_mov_r64_mrbp(ctx, 2, 0 - len_off) // rdx = len
            bytes_extend(ctx["code"], insn_cmp_r64_r64(0, 2))
            _emit_jcc_to_label(ctx, fixups1, "ge", l_done)

            // elem = spread[idx]
            _emit_eval_int_to_rax(ctx, {"type": "Index", "left": {"type": "Identifier", "value": spread_name}, "index": {"type": "Identifier", "value": idx_name}}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - elem_off, 0)

            // rest.push(elem)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": rest_name}, {"type": "Identifier", "value": elem_name}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

            // idx++
            _emit_mov_r64_mrbp(ctx, 0, 0 - idx_off)
            bytes_extend(ctx["code"], insn_add_r64_imm32(0, 1))
            _emit_mov_mrbp_r64(ctx, 0 - idx_off, 0)
            _emit_jmp_to_label(ctx, fixups1, l_loop)

            _emit_label(ctx, labels1, l_done)
            _patch_local_fixups(ctx, labels1, fixups1)

            // Load ABI args for the real call: fixed args + rest_list.
            var regc = abi.max_int_reg_args(ctx["abi"])
            var shadow = abi.caller_shadow_bytes(ctx["abi"])
            var k = 0
            while k < fixed + 1 {
                var tmp_off = nil
                if k < fixed {
                    if k < argc {
                        tmp_off = _intr_tmp_off(ctx, locals, base + k)
                    } else {
                        tmp_off = _intr_tmp_off(ctx, locals, base + argc + 5 + (k - argc))
                    }
                } else {
                    tmp_off = rest_off
                }
                if tmp_off == nil { _intr_tmp_pop(ctx, base); return nil }

                if k < regc {
                    var reg = abi.int_arg_reg(ctx["abi"], k)
                    if reg == nil { _intr_tmp_pop(ctx, base); err(ctx, "x64 native v0: unsupported call arg index"); return nil }
                    _emit_mov_r64_mrbp(ctx, reg, 0 - tmp_off)
                } else {
                    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_off)
                    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
                    var stack_disp = shadow + 8 * (k - regc)
                    var call_area = ctx["cur_call_area_bytes"]
                    if call_area == nil { call_area = 0 }
                    if stack_disp + 8 > call_area {
                        _intr_tmp_pop(ctx, base)
                        err(ctx, "x64 native v0: outgoing stack args exceed reserved call area (need " + oren_int_to_string(stack_disp+8) + ", have " + oren_int_to_string(call_area) + ")")
                        return nil
                    }
                    _emit_mov_mrsp_r64(ctx, stack_disp, 0)
                }
                k = k + 1
            }

            var call_pos = oren_list_len(ctx["code"])
            bytes_extend(ctx["code"], insn_call_rel32(0))
            oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": nm})
            _intr_tmp_pop(ctx, base)
            return nil
        }

        // --- fixed-arity + spread ---
        if argc > arity { err(ctx, "x64 native v0: call arity mismatch for " + nm); return nil }
        var need = arity - argc

        // Spill fixed args + spread list + spread elements, then load into ABI arg registers.
        var spill_n = arity + 1 // +1 for the spread list itself
        var base = _intr_tmp_push(ctx, spill_n)
        if base == nil { return nil }

        // Spill fixed args
        var i = 0
        while i < argc {
            _emit_eval_int_to_rax(ctx, args[i], locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            var off = _intr_tmp_off(ctx, locals, base + i)
            if off == nil { _intr_tmp_pop(ctx, base); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - off, 0)
            i = i + 1
        }

        // Spill spread list
        var spread_slot = base + argc
        var spread_off = _intr_tmp_off(ctx, locals, spread_slot)
        if spread_off == nil { _intr_tmp_pop(ctx, base); return nil }
        _emit_eval_int_to_rax(ctx, spread, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - spread_off, 0)

        // Runtime check: len(spread) == need
        var spread_name = "$tmp_intr" + oren_int_to_string(spread_slot)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_len"}, "args": [{"type": "Identifier", "value": spread_name}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, need))
        var labels = {}
        var local_fixups = []
        var l_spread_ok = _new_label(ctx, "spread_len_ok")
        _emit_jcc_to_label(ctx, local_fixups, "e", l_spread_ok)
        _emit_abort_exitcode(ctx, 1)
        _emit_label(ctx, labels, l_spread_ok)
        _patch_local_fixups(ctx, labels, local_fixups)

        // Materialize spread elements (if any)
        var j = 0
        while j < need {
            var elem_slot = base + argc + 1 + j
            var elem_off = _intr_tmp_off(ctx, locals, elem_slot)
            if elem_off == nil { _intr_tmp_pop(ctx, base); return nil }

            _emit_eval_int_to_rax(ctx, {"type": "Index", "left": {"type": "Identifier", "value": spread_name}, "index": {"type": "Integer", "value": oren_int_to_string(j)}}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - elem_off, 0)
            j = j + 1
        }

        // Load args into ABI locations.
        var regc = abi.max_int_reg_args(ctx["abi"])
        var shadow = abi.caller_shadow_bytes(ctx["abi"])
        var k = 0
        while k < arity {
            var src_idx = base + k
            if k >= argc {
                // spread elems start after fixed args + spread slot
                src_idx = base + argc + 1 + (k - argc)
            }
            var tmp_off = _intr_tmp_off(ctx, locals, src_idx)
            if tmp_off == nil { _intr_tmp_pop(ctx, base); return nil }

            if k < regc {
                var reg = abi.int_arg_reg(ctx["abi"], k)
                if reg == nil { _intr_tmp_pop(ctx, base); err(ctx, "x64 native v0: unsupported call arg index"); return nil }
                _emit_mov_r64_mrbp(ctx, reg, 0 - tmp_off)
            } else {
                _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_off)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
                var stack_disp = shadow + 8 * (k - regc)
                var call_area = ctx["cur_call_area_bytes"]
                if call_area == nil { call_area = 0 }
                if stack_disp + 8 > call_area {
                    _intr_tmp_pop(ctx, base)
                    err(ctx, "x64 native v0: outgoing stack args exceed reserved call area (need " + oren_int_to_string(stack_disp+8) + ", have " + oren_int_to_string(call_area) + ")")
                    return nil
                }
                _emit_mov_mrsp_r64(ctx, stack_disp, 0)
            }
            k = k + 1
        }

        var call_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": nm})
        _intr_tmp_pop(ctx, base)
        return nil
    }

    // Generic call path:
    // - direct calls remain ABI-direct (fast path) where possible
    // - indirect calls lower to the uniform callable ABI:
    //     fnobj = { code_ptr, env_ptr }
    //     args_list = [arg0, arg1, ...] (+ spread elements)
    //     call code_ptr(env_ptr, args_list)
    //
    // Rolling: stack args are supported; arg count is bounded only by call-area capacity.

    var callee_off = nil
    if is_direct != true {
        callee_off = locals[nm]
        if callee_off == nil {
            err(ctx, "x64 native v0: undefined function or fn var " + nm)
            return nil
        }
    } else {
        var arity2 = ctx["func_arity"][nm]
        if arity2 == nil { err(ctx, "x64 native v0: missing arity for function " + nm); return nil }
        if is_varargs_named {
            var fixed = varargs_fixed
            if argc < fixed { err(ctx, "x64 native v0: varargs arity mismatch for " + nm); return nil }
            if arity2 != fixed + 1 {
                err(ctx, "x64 native v0: inconsistent varargs signature for " + nm)
                return nil
            }
        } else {
            if argc != arity2 { err(ctx, "x64 native v0: call arity mismatch for " + nm); return nil }
        }
    }

    // Evaluate explicit args left-to-right, spill to stack temps, then load into ABI arg registers.
    // This avoids clobbering Win64 arg registers (EDX, R8D, R9D) by our expression scratch.
    var spill_n2 = argc
    if is_varargs_named { spill_n2 = argc + 1 } // +1 for the packed rest_list
    if is_direct != true {
        // Indirect call needs an args_list spill slot (+ spread loop temps if present).
        spill_n2 = argc + 1
        if has_spread {
            spill_n2 = argc + 5 // args_list + spread + idx + len + elem
        }
    }
    var base2 = _intr_tmp_push(ctx, spill_n2)
    if base2 == nil { return nil }
    var i2 = 0
    while i2 < argc {
        _emit_eval_int_to_rax(ctx, args[i2], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
        var tmp_off = _intr_tmp_off(ctx, locals, base2 + i2)
        if tmp_off == nil { _intr_tmp_pop(ctx, base2); return nil }
        // Spill the full 64-bit value (keeps function pointer args intact).
        _emit_mov_mrbp_r64(ctx, 0 - tmp_off, 0)
        i2 = i2 + 1
    }

    if is_direct != true {
        // --- Indirect call: call wrapper(env_ptr, args_list) ---
        //
        // Build args_list from spilled explicit args (and optional spread list elements), then:
        // - load env_ptr + code_ptr from fnobj
        // - call code_ptr(env_ptr, args_list)
        var args_slot = base2 + argc
        var args_off = _intr_tmp_off(ctx, locals, args_slot)
        if args_off == nil { _intr_tmp_pop(ctx, base2); return nil }

        var args_name = "$tmp_intr" + oren_int_to_string(args_slot)

        if has_spread {
            // args_list = oren_new_list(0)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)

            // Push explicit args in order.
            var k0 = 0
            while k0 < argc {
                var arg_name0 = "$tmp_intr" + oren_int_to_string(base2 + k0)
                _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": args_name}, {"type": "Identifier", "value": arg_name0}]}, locals)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
                k0 = k0 + 1
            }
        } else {
            if argc <= 32 {
                // Indirect call (no spread, small argc): stack-backed args_list fast path.
                //
                // IMPORTANT: do NOT use `$tmp_intrN` spill slots as the element buffer, because
                // those stack slots are not guaranteed to be contiguous in memory (locals layout
                // is map-driven). The list runtime expects `buf[idx]` at `buf + idx*8`.
                //
                // Instead, we reserve a small contiguous block on the stack at the call site:
                //   [shadow space]            (Win64: 32 bytes; SysV: 0)
                //   [list header: 4*qword]    (count, cap, buf_ptr, magic)
                //   [buf: argc*qword]         (args)
                //
                // The callee may clobber only the shadow space; our header+buf live above it.
                var shadow0 = abi.caller_shadow_bytes(ctx["abi"])
                var payload = 32 + argc * 8
                var alloc = shadow0 + payload
                var rem = core.int_mod(alloc, 16)
                if rem != 0 { alloc = alloc + (16 - rem) }

                // rsp -= alloc
                bytes_extend(ctx["code"], insn_sub_rsp_imm32(alloc))

                // r11 = header_ptr = rsp + shadow
                bytes_extend(ctx["code"], insn_mov_r64_r64(11, 4)) // r11 = rsp
                if shadow0 != 0 { bytes_extend(ctx["code"], insn_add_r64_imm32(11, shadow0)) }

                // r12 = buf_ptr = header_ptr + 32
                bytes_extend(ctx["code"], insn_mov_r64_r64(12, 11))
                bytes_extend(ctx["code"], insn_add_r64_imm32(12, 32))

                // header.count = argc  at [r11 + 0]
                bytes_extend(ctx["code"], insn_mov_r32_imm32(0, argc))
                bytes_extend(ctx["code"], insn_cdqe())
                bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
                bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

                // header.cap = argc    at [r11 + 8]
                bytes_extend(ctx["code"], insn_mov_r32_imm32(0, argc))
                bytes_extend(ctx["code"], insn_cdqe())
                bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
                bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
                bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

                // header.buf = (argc==0 ? 0 : buf_ptr)  at [r11 + 16]
                if argc == 0 {
                    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
                    bytes_extend(ctx["code"], insn_cdqe())
                } else {
                    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 12))
                }
                bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
                bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
                bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

                // header.magic = LIST_MAGIC (1279870019)  at [r11 + 24]
                bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1279870019))
                bytes_extend(ctx["code"], insn_cdqe())
                bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
                bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
                bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

                // Write buf[i] = spilled_arg[i]
                var wi = 0
                while wi < argc {
                    var src_off = _intr_tmp_off(ctx, locals, base2 + wi)
                    if src_off == nil { _intr_tmp_pop(ctx, base2); return nil }
                    _emit_mov_r64_mrbp(ctx, 0, 0 - src_off) // rax = arg

                    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 12)) // r10 = buf_ptr
                    if wi != 0 { bytes_extend(ctx["code"], insn_add_r64_imm32(10, wi * 8)) }
                    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
                    wi = wi + 1
                }

                // Spill args_list pointer for uniform downstream code.
                bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
                _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)
            } else {
                // Indirect call (no spread, large argc): heap list path (simple + avoids big stack frames).
                _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": oren_int_to_string(argc)}]}, locals)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
                _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)

                var k00 = 0
                while k00 < argc {
                    var arg_name00 = "$tmp_intr" + oren_int_to_string(base2 + k00)
                    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": args_name}, {"type": "Identifier", "value": arg_name00}]}, locals)
                    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
                    k00 = k00 + 1
                }
            }
        }

        if has_spread {
            var spread_slot = base2 + argc + 1
            var idx_slot = base2 + argc + 2
            var len_slot = base2 + argc + 3
            var elem_slot = base2 + argc + 4
            var spread_off = _intr_tmp_off(ctx, locals, spread_slot)
            var idx_off = _intr_tmp_off(ctx, locals, idx_slot)
            var len_off = _intr_tmp_off(ctx, locals, len_slot)
            var elem_off = _intr_tmp_off(ctx, locals, elem_slot)
            if spread_off == nil || idx_off == nil || len_off == nil || elem_off == nil {
                _intr_tmp_pop(ctx, base2)
                err(ctx, "x64 native v0: missing spill slots for indirect spread call")
                return nil
            }

            // Spill spread list value.
            _emit_eval_int_to_rax(ctx, spread, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - spread_off, 0)
            var spread_name = "$tmp_intr" + oren_int_to_string(spread_slot)

            // len = oren_list_len(spread)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_len"}, "args": [{"type": "Identifier", "value": spread_name}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - len_off, 0)

            // idx = 0
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
            bytes_extend(ctx["code"], insn_cdqe())
            _emit_mov_mrbp_r64(ctx, 0 - idx_off, 0)
            var idx_name = "$tmp_intr" + oren_int_to_string(idx_slot)
            var elem_name = "$tmp_intr" + oren_int_to_string(elem_slot)

            // while idx < len { elem = spread[idx]; args.push(elem); idx++ }
            var labels = {}
            var fixups = []
            var l_loop = _new_label(ctx, "indirect_spread_loop")
            var l_done = _new_label(ctx, "indirect_spread_done")
            _emit_label(ctx, labels, l_loop)
            _emit_mov_r64_mrbp(ctx, 0, 0 - idx_off) // rax = idx
            _emit_mov_r64_mrbp(ctx, 2, 0 - len_off) // rdx = len
            bytes_extend(ctx["code"], insn_cmp_r64_r64(0, 2))
            _emit_jcc_to_label(ctx, fixups, "ge", l_done)

            // elem = spread[idx]
            _emit_eval_int_to_rax(ctx, {"type": "Index", "left": {"type": "Identifier", "value": spread_name}, "index": {"type": "Identifier", "value": idx_name}}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - elem_off, 0)

            // args.push(elem)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": args_name}, {"type": "Identifier", "value": elem_name}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }

            // idx++
            _emit_mov_r64_mrbp(ctx, 0, 0 - idx_off)
            bytes_extend(ctx["code"], insn_add_r64_imm32(0, 1))
            _emit_mov_mrbp_r64(ctx, 0 - idx_off, 0)
            _emit_jmp_to_label(ctx, fixups, l_loop)

            _emit_label(ctx, labels, l_done)
            _patch_local_fixups(ctx, labels, fixups)
        }

        // Load wrapper args.
        var env_reg = abi.int_arg_reg(ctx["abi"], 0)
        var args_reg = abi.int_arg_reg(ctx["abi"], 1)
        if env_reg == nil || args_reg == nil {
            _intr_tmp_pop(ctx, base2)
            err(ctx, "x64 native v0: missing ABI arg regs for indirect call")
            return nil
        }

        // r10 = fnobj ptr
        _emit_mov_r64_mrbp(ctx, 10, 0 - callee_off)
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
        var labelsFn = {}
        var fixupsFn = []
        var l_fn_ok = _new_label(ctx, "indirect_fnobj_ok")
        _emit_jcc_to_label(ctx, fixupsFn, "ne", l_fn_ok)
        _emit_abort_exitcode(ctx, 1)
        _emit_label(ctx, labelsFn, l_fn_ok)
        _patch_local_fixups(ctx, labelsFn, fixupsFn)
        // env_reg = *(fnobj + 8)
        bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
        bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
        bytes_extend(ctx["code"], insn_mov_rax_mrax())
        bytes_extend(ctx["code"], insn_mov_r64_r64(env_reg, 0))
        // args_reg = args_list
        _emit_mov_r64_mrbp(ctx, args_reg, 0 - args_off)
        // rax = *(fnobj + 0) (code_ptr)
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], insn_mov_rax_mrax())
        bytes_extend(ctx["code"], insn_call_rax())

        // If we used the stack-backed args_list fast path, restore RSP now.
        // (For other paths, this is a no-op; `alloc` is local to the branch above.)
        if has_spread != true && argc <= 32 {
            var shadow1 = abi.caller_shadow_bytes(ctx["abi"])
            var payload1 = 32 + argc * 8
            var alloc1 = shadow1 + payload1
            var rem1 = core.int_mod(alloc1, 16)
            if rem1 != 0 { alloc1 = alloc1 + (16 - rem1) }
            bytes_extend(ctx["code"], insn_add_rsp_imm32(alloc1))
        }

        _intr_tmp_pop(ctx, base2)
        return nil
    }

    // Varargs packing: build rest_list and spill it in the extra slot.
    var call_argc = argc
    if is_varargs_named {
        var fixed2 = varargs_fixed
        // rest_list lives in the extra spill slot at base2+argc
        var rest_idx = base2 + argc
        var rest_off = _intr_tmp_off(ctx, locals, rest_idx)
        if rest_off == nil { _intr_tmp_pop(ctx, base2); return nil }

        // rest_list = oren_new_list(0)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - rest_off, 0)

        // push extra args into rest_list
        var j2 = fixed2
        while j2 < argc {
            var rest_name = "$tmp_intr" + oren_int_to_string(rest_idx)
            var arg_name = "$tmp_intr" + oren_int_to_string(base2 + j2)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": rest_name}, {"type": "Identifier", "value": arg_name}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            j2 = j2 + 1
        }

        // Call the real function with fixed args + rest_list as the last arg.
        call_argc = fixed2 + 1
    }

    var regc2 = abi.max_int_reg_args(ctx["abi"])
    var shadow2 = abi.caller_shadow_bytes(ctx["abi"])
    var i3 = 0
    while i3 < call_argc {
        var src_idx2 = base2 + i3
        if is_varargs_named && i3 == varargs_fixed {
            // last arg is rest_list (spilled at base2+argc)
            src_idx2 = base2 + argc
        }
        var tmp_off2 = _intr_tmp_off(ctx, locals, src_idx2)
        if tmp_off2 == nil { _intr_tmp_pop(ctx, base2); return nil }

        if i3 < regc2 {
            var reg2 = abi.int_arg_reg(ctx["abi"], i3)
            if reg2 == nil { _intr_tmp_pop(ctx, base2); err(ctx, "x64 native v0: unsupported call arg index"); return nil }
            _emit_mov_r64_mrbp(ctx, reg2, 0 - tmp_off2)
        } else {
            _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_off2)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            var stack_disp2 = shadow2 + 8 * (i3 - regc2)
            var call_area2 = ctx["cur_call_area_bytes"]
            if call_area2 == nil { call_area2 = 0 }
            if stack_disp2 + 8 > call_area2 {
                _intr_tmp_pop(ctx, base2)
                err(ctx, "x64 native v0: outgoing stack args exceed reserved call area (need " + oren_int_to_string(stack_disp2+8) + ", have " + oren_int_to_string(call_area2) + ")")
                return nil
            }
            _emit_mov_mrsp_r64(ctx, stack_disp2, 0)
        }
        i3 = i3 + 1
    }

    if is_direct {
        var call_pos2 = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos2, "name": nm})
    } else {
        _emit_mov_r64_mrbp(ctx, 0, 0 - callee_off) // rax = fnobj ptr
        bytes_extend(ctx["code"], insn_mov_rax_mrax()) // rax = [fnobj].code_ptr
        bytes_extend(ctx["code"], insn_call_rax())
    }
    _intr_tmp_pop(ctx, base2)
    return nil
}
