// Generic call expression lowering for x64 native.
//
// Kept in a dedicated chunk to prevent `040_emit_expr.oren` from growing beyond
// reviewable limits as x64 Tier-1 call semantics converge with AVM/C.

fn _emit_intrinsic_oren_call_obj_list_x64(ctx, locals, fn_obj_expr, args_list_expr) {
    // Intrinsic: indirect call through a native function object.
    // Signature: oren_call_obj_list(fn_obj, args_list) -> value
    //
    // Layout (kind=6):
    //   [0] code_ptr
    //   [8] env_ptr
    //
    // This is inlined (like arm64) so injected runtime code can call it even
    // when the symbol is not present in the source module.
    if fn_obj_expr == nil || args_list_expr == nil {
        err(ctx, "x64 native v0: oren_call_obj_list expects 2 args")
        return nil
    }

    var spill = _intr_tmp_push(ctx, 1)
    if oren_type_tag(spill) == 0 { return nil }
    var fn_off = _intr_tmp_off(ctx, locals, spill)
    if oren_type_tag(fn_off) == 0 { _intr_tmp_pop(ctx, spill); return nil }

    // Spill fn_obj.
    _emit_eval_int_to_rax(ctx, fn_obj_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, spill); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fn_off, 0)

    // Eval args_list -> rax.
    _emit_eval_int_to_rax(ctx, args_list_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, spill); return nil }

    var env_reg_enc = abi.int_arg_reg(ctx["abi"], 0)
    var args_reg_enc = abi.int_arg_reg(ctx["abi"], 1)
    if oren_type_tag(env_reg_enc) == 0 || oren_type_tag(args_reg_enc) == 0 {
        _intr_tmp_pop(ctx, spill)
        err(ctx, "x64 native v0: missing ABI arg regs for oren_call_obj_list")
        return nil
    }
    var env_reg = env_reg_enc - 1
    var args_reg = args_reg_enc - 1

    // args_reg = args_list (value already in rax)
    if args_reg != 0 { bytes_extend(ctx["code"], insn_mov_r64_r64(args_reg, 0)) }

    // r10 = fnobj ptr
    _emit_mov_r64_mrbp(ctx, 10, 0 - fn_off)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    var labelsFn2 = {}
    var fixupsFn2 = []
    var l_fn_ok2 = _new_label(ctx, "oren_call_obj_list_fnobj_ok")
    _emit_jcc_to_label(ctx, fixupsFn2, "ne", l_fn_ok2)
    _emit_abort_panic_str(ctx, "call on nil function value")
    _emit_label(ctx, labelsFn2, l_fn_ok2)
    _patch_local_fixups(ctx, labelsFn2, fixupsFn2)

    // env_reg = *(fnobj + 8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(env_reg, 0))

    // rax = *(fnobj + 0) (code_ptr), then call.
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_call_rax())

    _intr_tmp_pop(ctx, spill)
    return nil
}

fn _emit_call_spread_via_runtime_helper_fnexpr_x64(ctx, locals, fn_obj_expr, args, spread) {
    // Tier-1 convergence: if the injected native runtime is enabled, lower call-site spread
    // via the shared helper:
    //   oren_call_obj_spread(fn_obj, fixed_args_list, spread_list)
    //
    // This matches the arm64 native backend lowering and avoids x64-only spread semantics.
    if ctx == nil { return nil }
    if ctx["runtime_injected"] != true { err(ctx, "x64 native v0: spread calls require injected native runtime"); return nil }
    if spread == nil { return nil }
    if fn_obj_expr == nil { err(ctx, "x64 native v0: spread call missing callee"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }

    // Spill layout:
    // - explicit args: [base + 0 .. base + argc-1]
    // - fixed_list:    base + argc
    // - spread_list:   base + argc + 1
    // - fn_obj:        base + argc + 2
    var spill_n = argc + 3
    var base = _intr_tmp_push(ctx, spill_n)
    if oren_type_tag(base) == 0 { return nil }

    // Spill explicit args (evaluate once; preserve LTR semantics).
    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        var off = _intr_tmp_off(ctx, locals, iadd(base, i))
        if oren_type_tag(off) == 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = iadd(i, 1)
    }

    var fixed_slot = iadd(base, argc)
    var spread_slot = iadd(fixed_slot, 1)
    var fn_slot = iadd(fixed_slot, 2)
    var fixed_off = _intr_tmp_off(ctx, locals, fixed_slot)
    var spread_off = _intr_tmp_off(ctx, locals, spread_slot)
    var fn_off = _intr_tmp_off(ctx, locals, fn_slot)
    if oren_type_tag(fixed_off) == 0 || oren_type_tag(spread_off) == 0 || oren_type_tag(fn_off) == 0 {
        _intr_tmp_pop(ctx, base)
        err(ctx, "x64 native v0: missing spill slots for spread call")
        return nil
    }

    // fixed_list = oren_new_list(0)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fixed_off, 0)
    var fixed_tmp = {"type": "IntrTmp", "idx": fixed_slot}

    // Push explicit args into fixed_list.
    var j = 0
    while j < argc {
        var arg_tmp = {"type": "IntrTmp", "idx": iadd(base, j)}
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [fixed_tmp, arg_tmp]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        j = iadd(j, 1)
    }

    // Spill spread_list.
    _emit_eval_int_to_rax(ctx, spread, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - spread_off, 0)
    var spread_tmp = {"type": "IntrTmp", "idx": spread_slot}

    // Spill fn_obj.
    _emit_eval_int_to_rax(ctx, fn_obj_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fn_off, 0)
    var fn_tmp = {"type": "IntrTmp", "idx": fn_slot}

    // Call runtime helper: oren_call_obj_spread(fn_obj, fixed_args, spread_list)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_call_obj_spread"}, "args": [fn_tmp, fixed_tmp, spread_tmp]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_indirect_call_via_fnobj_x64(ctx, locals, fn_obj_expr, args, spread) {
    // Indirect call path (Tier-1 convergence): callee is a first-class function value, not a direct symbol call.
    //
    // Lowering:
    // - without spread: build args_list and call the uniform callable ABI wrapper
    // - with spread: call the shared runtime helper `oren_call_obj_spread(fn_obj, fixed_list, spread_list)`
    //
    // This mirrors the arm64 native semantics in `lib/compiler/arm64_native_expr/020_lowering_b.oren`.
    if ctx == nil { return nil }
    if fn_obj_expr == nil { err(ctx, "x64 native v0: indirect call missing callee"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }
    var has_spread = (spread != nil)

    // Indirect calls use runtime container helpers for argument packing.
    if ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: indirect calls require injected native runtime")
        return nil
    }

    // Spread always uses the shared runtime helper (matches arm64).
    if has_spread {
        _emit_call_spread_via_runtime_helper_fnexpr_x64(ctx, locals, fn_obj_expr, args, spread)
        return nil
    }

    // Spill layout:
    // - explicit args: [base + 0 .. base + argc-1]
    // - args_list:     base + argc
    // - callee fnobj:  base + argc + 1
    var spill_n = argc + 2
    var base = _intr_tmp_push(ctx, spill_n)
    if oren_type_tag(base) == 0 { return nil }

    // Spill explicit args (evaluate once; preserve LTR semantics).
    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        var off = _intr_tmp_off(ctx, locals, iadd(base, i))
        if oren_type_tag(off) == 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = iadd(i, 1)
    }

    var args_slot = iadd(base, argc)
    var args_off = _intr_tmp_off(ctx, locals, args_slot)
    if oren_type_tag(args_off) == 0 { _intr_tmp_pop(ctx, base); return nil }
    var args_tmp = {"type": "IntrTmp", "idx": args_slot}

    // Spill callee fnobj value (can be an arbitrary expression).
    var callee_slot = iadd(args_slot, 1)
    var callee_off = _intr_tmp_off(ctx, locals, callee_slot)
    if oren_type_tag(callee_off) == 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_eval_int_to_rax(ctx, fn_obj_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - callee_off, 0)

    // Build args_list.
    // args_list = oren_new_list(0)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)

    // Push explicit args in order.
    var k0 = 0
    while k0 < argc {
        var arg_tmp0 = {"type": "IntrTmp", "idx": iadd(base, k0)}
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [args_tmp, arg_tmp0]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        k0 = iadd(k0, 1)
    }

    // Load wrapper args and call wrapper(env_ptr, args_list).
    var env_reg_enc = abi.int_arg_reg(ctx["abi"], 0)
    var args_reg_enc = abi.int_arg_reg(ctx["abi"], 1)
    if oren_type_tag(env_reg_enc) == 0 || oren_type_tag(args_reg_enc) == 0 {
        _intr_tmp_pop(ctx, base)
        err(ctx, "x64 native v0: missing ABI arg regs for indirect call")
        return nil
    }
    var env_reg = env_reg_enc - 1
    var args_reg = args_reg_enc - 1

    // r10 = fnobj ptr
    _emit_mov_r64_mrbp(ctx, 10, 0 - callee_off)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    var labelsFn = {}
    var fixupsFn = []
    var l_fn_ok = _new_label(ctx, "indirect_fnobj_ok")
    _emit_jcc_to_label(ctx, fixupsFn, "ne", l_fn_ok)
    _emit_abort_panic_str(ctx, "call on nil function value")
    _emit_label(ctx, labelsFn, l_fn_ok)
    _patch_local_fixups(ctx, labelsFn, fixupsFn)
    // env_reg = *(fnobj + 8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(env_reg, 0))
    // args_reg = args_list
    _emit_mov_r64_mrbp(ctx, args_reg, 0 - args_off)
    // rax = *(fnobj + 0) (code_ptr)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_call_rax())

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_spawn_expr_v0(ctx, expr, locals) {
    // Spawn expression lowering (Tier-1): `spawn f(args...)`
