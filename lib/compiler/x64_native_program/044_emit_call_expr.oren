        } else {
            _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_off2)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
            var stack_disp2 = shadow2 + slot2 * (i3 - regc2)
            var call_area2 = ctx["cur_call_area_bytes"]
            if oren_type_tag(call_area2) == 0 { call_area2 = 0 }
            if stack_disp2 + slot2 > call_area2 {
                err(ctx, "x64 native v0: outgoing stack args exceed reserved call area (need " + oren_int_to_string(stack_disp2+slot2) + ", have " + oren_int_to_string(call_area2) + ")")
                return false
            }
            _emit_mov_mrsp_r64(ctx, stack_disp2, 0)
        }
        i3 = iadd(i3, 1)
    }
    return true
}

fn _x64_emit_direct_call_fixup_and_return_v0(ctx, nm, is_import) {
    var call_pos2 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos2, "name": nm})
    // ABI correctness: some `ffi` symbols return 32-bit or void values.
    //
    // Oren treats values as i64, so normalize the return register to the declared ABI kind:
    // - i32: sign-extend EAX -> RAX
    // - u32: zero-extend EAX -> RAX
    // - void: force RAX=0
    if is_import == true && ctx != nil {
        if ctx["ffi_ret_i32"] != nil && ctx["ffi_ret_i32"][nm] != nil {
            bytes_extend(ctx["code"], core.insn_cdqe()) // RAX = sign_extend_i32(EAX)
        } else if ctx["ffi_ret_u32"] != nil && ctx["ffi_ret_u32"][nm] != nil {
            bytes_extend(ctx["code"], core.insn_mov_r32_r32(0, 0)) // EAX = EAX (zero-extend to RAX)
        } else if ctx["ffi_ret_void"] != nil && ctx["ffi_ret_void"][nm] != nil {
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0)) // RAX = 0
            bytes_extend(ctx["code"], core.insn_cdqe())
        }
    }
    return nil
}

fn _emit_generic_call_expr_v0(ctx, expr, locals, nm, args) {
    var argc = 0
    if args != nil { argc = oren_list_len(args) }

    var spread = expr["spread"]
    if _x64_emit_named_call_intrinsic_or_spread_v0(ctx, expr, locals, nm, args, argc, spread) == true { return nil }

    var info = _x64_classify_named_call_v0(ctx, expr, locals, nm, argc)
    if info == nil { return nil }
    if info["is_direct"] != true {
        _emit_indirect_call_via_fnobj_x64(ctx, locals, {"type": "Identifier", "value": nm}, args, spread)
        return nil
    }

    info["argc"] = argc
    _x64_emit_direct_named_call_v0(ctx, locals, nm, args, info)
    return nil
}
