        bytes_extend(ctx["code"], insn_cdqe())
        _emit_mov_mrbp_r64(ctx, 0 - idx_off, 0)
        var idx_tmp = {"type": "IntrTmp", "idx": idx_slot}
        var elem_tmp = {"type": "IntrTmp", "idx": elem_slot}

