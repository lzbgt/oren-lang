    if oren_type_tag(base) == 0 { return nil }

    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        var off = _intr_tmp_off(ctx, locals, iadd(base, i))
        if oren_type_tag(off) == 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = iadd(i, 1)
    }

    var args_slot = iadd(base, argc)
    var fn_slot = iadd(args_slot, 1)
    var args_off = _intr_tmp_off(ctx, locals, args_slot)
    var fn_off = _intr_tmp_off(ctx, locals, fn_slot)
    if oren_type_tag(args_off) == 0 || oren_type_tag(fn_off) == 0 {
        _intr_tmp_pop(ctx, base)
        err(ctx, "x64 native v0: missing spill slots for varargs call")
        return nil
    }

    // args_list = oren_new_list(argc)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": oren_int_to_string(argc)}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)
    var args_tmp = {"type": "IntrTmp", "idx": args_slot}

    // Push args into args_list in order.
    var j = 0
    while j < argc {
        var arg_tmp = {"type": "IntrTmp", "idx": iadd(base, j)}
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [args_tmp, arg_tmp]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        j = iadd(j, 1)
    }

    // Spill fn_obj (named function used as value => fnobj record pointing at `__oren_fnwrap_*`).
    _emit_eval_int_to_rax(ctx, {"type": "Identifier", "value": nm}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fn_off, 0)
    var fn_tmp = {"type": "IntrTmp", "idx": fn_slot}

    // Inline-call: oren_call_obj_list(fn_obj, args_list)
    _emit_intrinsic_oren_call_obj_list_x64(ctx, locals, fn_tmp, args_tmp)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_generic_call_expr_v0(ctx, expr, locals, nm, args) {
    if nm == "print" { err(ctx, "x64 native v0: print is statement-only"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }

    var spread = expr["spread"]

    // Tier-1 parity + performance: inline `oren_index_set(container, index, value)` so
    // list in-bounds stores do not pay an extra runtime call.
    if nm == "oren_index_set" {
        _emit_index_set_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }

    // Tier‑1 parity: match arm64 by inlining core list operations with tracked-kind safety gates.
    if nm == "oren_list_len" || nm == "STD_list_len" {
        _emit_list_len_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }
    if nm == "oren_list_push" || nm == "STD_list_push" {
        _emit_list_push_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }
    if nm == "oren_list_int_len" || nm == "STD_list_int_len" {
        _emit_list_int_len_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }
    if nm == "oren_list_int_push" || nm == "STD_list_int_push" {
        _emit_list_int_push_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }
    if nm == "oren_list_int_get" || nm == "STD_list_int_get" {
        _emit_list_int_get_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }
    if nm == "oren_list_int_set" || nm == "STD_list_int_set" {
        _emit_list_int_set_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }

    if nm == "oren_call_obj_list" {
        if spread != nil { err(ctx, "x64 native v0: oren_call_obj_list does not support spread"); return nil }
        if argc != 2 { err(ctx, "x64 native v0: oren_call_obj_list expects 2 args"); return nil }
        _emit_intrinsic_oren_call_obj_list_x64(ctx, locals, args[0], args[1])
        return nil
    }

    // Tier-1 parity: when runtime injection is enabled, lower call-site spread through the
    // shared runtime helper (matches arm64). This also works for indirect calls (callee in a var).
    if spread != nil {
        _emit_call_spread_via_runtime_helper_fnexpr_x64(ctx, locals, {"type": "Identifier", "value": nm}, args, spread)
        return nil
    }

    var is_direct = false
    var declared = ctx["declared_functions"]
    var is_import = false
    if ctx != nil && ctx["imports"] != nil && ctx["imports"][nm] != nil { is_import = true }
    // Rolling shadowing rule: locals/global vars override named functions.
    // If `nm` is a local/global, treat this as an indirect call (callable value).
    var is_shadowed = false
    if locals != nil && locals[nm] != nil { is_shadowed = true }
    else if ctx != nil && ctx["globals"] != nil && ctx["globals"][nm] != nil { is_shadowed = true }
    if is_shadowed != true && declared != nil && declared[nm] != nil { is_direct = true }

    // Varargs packing (rolling): if the callee is a known named function with a trailing
    // `...rest`, pack extra args into a list and call the real function with:
    //   fn(fixed0, fixed1, ..., rest_list)
    var varargs_fixed = nil
    if ctx["func_varargs_fixed"] != nil {
        var vf_enc = ctx["func_varargs_fixed"][nm]
        if oren_type_tag(vf_enc) != 0 { varargs_fixed = vf_enc - 1 }
    }
    var is_varargs_named = (is_direct == true && varargs_fixed != nil)
    // Wrapper functions (`__oren_fnwrap_<name>`) already receive a pre-packed `rest_list` and
    // must call the real varargs function at fixed arity (fixed args + rest_list).
    //
    // Avoid applying call-site packing inside wrappers, otherwise we would produce nested rest
    // lists (`rest = [[...]]`).
    if is_varargs_named {
        var cur_fn = ctx["cur_fn_name"]
        // Wrapper functions (`__oren_fnwrap_*`) already receive a pre-packed `rest_list` and
        // must call the real varargs function at fixed arity (fixed args + rest_list).
        //
        // Avoid applying call-site packing inside wrappers, otherwise we can produce:
        // - nested rest lists (`rest = [[...]]`)
        // - or accidental self-recursion via the uniform callable ABI.
        //
        // Prefer an explicit marker from wrapper synthesis when present; fall back to a
        // name-based check for backwards compatibility.
        if expr["__oren_varargs_packed"] != nil {
            is_varargs_named = false
            varargs_fixed = nil
        } else if cur_fn != nil && cur_fn == "__oren_fnwrap_" + nm {
            is_varargs_named = false
            varargs_fixed = nil
        }
    }

    // Tier-1 parity: when runtime injection is enabled, lower varargs named calls through the
    // uniform callable ABI (args_list + fnobj wrapper), matching arm64.
    if is_varargs_named {
        _emit_varargs_named_call_via_fnobj_x64(ctx, locals, nm, args)
        return nil
    }

    // Generic call path:
    // - direct calls remain ABI-direct (fast path) where possible
    // - indirect calls lower to the uniform callable ABI:
    //     fnobj = { code_ptr, env_ptr }
    //     args_list = [arg0, arg1, ...] (+ spread elements)
    //     call code_ptr(env_ptr, args_list)
    //
    // Rolling: stack args are supported; arg count is bounded only by call-area capacity.
    if is_direct == true && is_import != true {
        var arity2_enc = ctx["func_arity"][nm]
        if oren_type_tag(arity2_enc) == 0 { err(ctx, "x64 native v0: missing arity for function " + nm); return nil }
        var arity2 = arity2_enc - 1
        if is_varargs_named {
            var fixed = varargs_fixed
            if argc < fixed { err(ctx, "x64 native v0: varargs arity mismatch for " + nm); return nil }
            if arity2 != fixed + 1 {
                err(ctx, "x64 native v0: inconsistent varargs signature for " + nm)
                return nil
            }
        } else {
            if argc != arity2 { err(ctx, "x64 native v0: call arity mismatch for " + nm); return nil }
        }
    }

    if is_direct != true {
        _emit_indirect_call_via_fnobj_x64(ctx, locals, {"type": "Identifier", "value": nm}, args, spread)
        return nil
    }

    // Evaluate explicit args left-to-right, spill to stack temps, then load into ABI arg registers.
    // This avoids clobbering Win64 arg registers (EDX, R8D, R9D) by our expression scratch.
    var spill_n2 = argc
    if is_varargs_named { spill_n2 = argc + 1 } // +1 for the packed rest_list
    var base2 = _intr_tmp_push(ctx, spill_n2)
    if oren_type_tag(base2) == 0 { return nil }
    var i2 = 0
    while i2 < argc {
        _emit_eval_int_to_rax(ctx, args[i2], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
        var tmp_off = _intr_tmp_off(ctx, locals, iadd(base2, i2))
        if oren_type_tag(tmp_off) == 0 { _intr_tmp_pop(ctx, base2); return nil }
        // Spill the full 64-bit value (keeps function pointer args intact).
        _emit_mov_mrbp_r64(ctx, 0 - tmp_off, 0)
        i2 = iadd(i2, 1)
    }

    // Varargs packing: build rest_list and spill it in the extra slot.
    var call_argc = argc
    if is_varargs_named {
        var fixed2 = varargs_fixed
        // rest_list lives in the extra spill slot at base2+argc
        var rest_idx = iadd(base2, argc)
        var rest_off = _intr_tmp_off(ctx, locals, rest_idx)
        if oren_type_tag(rest_off) == 0 { _intr_tmp_pop(ctx, base2); return nil }

        // rest_list = oren_new_list(0)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - rest_off, 0)

        // push extra args into rest_list
        var rest_tmp = {"type": "IntrTmp", "idx": rest_idx}
        var j2 = fixed2
        while j2 < argc {
            var arg_tmp = {"type": "IntrTmp", "idx": iadd(base2, j2)}
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [rest_tmp, arg_tmp]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            j2 = iadd(j2, 1)
        }

        // Call the real function with fixed args + rest_list as the last arg.
        call_argc = fixed2 + 1
    }

    var regc2 = abi.max_int_reg_args(ctx["abi"])
    var shadow2 = abi.caller_shadow_bytes(ctx["abi"])
    var slot2 = abi.stack_arg_slot_bytes(ctx["abi"])
    var i3 = 0
    while i3 < call_argc {
        var src_idx2 = iadd(base2, i3)
        if is_varargs_named && i3 == varargs_fixed {
            // last arg is rest_list (spilled at base2+argc)
            src_idx2 = iadd(base2, argc)
        }
        var tmp_off2 = _intr_tmp_off(ctx, locals, src_idx2)
        if oren_type_tag(tmp_off2) == 0 { _intr_tmp_pop(ctx, base2); return nil }

        if i3 < regc2 {
            var reg2_enc = abi.int_arg_reg(ctx["abi"], i3)
            if oren_type_tag(reg2_enc) == 0 { _intr_tmp_pop(ctx, base2); err(ctx, "x64 native v0: unsupported call arg index"); return nil }
            var reg2 = reg2_enc - 1
            _emit_mov_r64_mrbp(ctx, reg2, 0 - tmp_off2)
        } else {
            _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_off2)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            var stack_disp2 = shadow2 + slot2 * (i3 - regc2)
            var call_area2 = ctx["cur_call_area_bytes"]
            if oren_type_tag(call_area2) == 0 { call_area2 = 0 }
            if stack_disp2 + slot2 > call_area2 {
                _intr_tmp_pop(ctx, base2)
                err(ctx, "x64 native v0: outgoing stack args exceed reserved call area (need " + oren_int_to_string(stack_disp2+slot2) + ", have " + oren_int_to_string(call_area2) + ")")
                return nil
            }
            _emit_mov_mrsp_r64(ctx, stack_disp2, 0)
        }
        i3 = iadd(i3, 1)
    }

    if is_direct {
        var call_pos2 = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos2, "name": nm})
        // ABI correctness: some `ffi` symbols return 32-bit or void values.
        //
        // Oren treats values as i64, so normalize the return register to the declared ABI kind:
        // - i32: sign-extend EAX -> RAX
        // - u32: zero-extend EAX -> RAX
        // - void: force RAX=0
        if is_import == true && ctx != nil {
            if ctx["ffi_ret_i32"] != nil && ctx["ffi_ret_i32"][nm] != nil {
                bytes_extend(ctx["code"], insn_cdqe()) // RAX = sign_extend_i32(EAX)
            } else if ctx["ffi_ret_u32"] != nil && ctx["ffi_ret_u32"][nm] != nil {
                bytes_extend(ctx["code"], insn_mov_r32_r32(0, 0)) // EAX = EAX (zero-extend to RAX)
            } else if ctx["ffi_ret_void"] != nil && ctx["ffi_ret_void"][nm] != nil {
                bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0)) // RAX = 0
                bytes_extend(ctx["code"], insn_cdqe())
            }
        }
    } else {
        // Should be unreachable: indirect calls return in the branch above.
        err(ctx, "x64 native v0: internal: fell through to non-direct call tail")
    }
    _intr_tmp_pop(ctx, base2)
    return nil
}
