// Generic call expression lowering for x64 native.
//
// Kept in a dedicated chunk to prevent `040_emit_expr.oren` from growing beyond
// reviewable limits as x64 Tier-1 call semantics converge with AVM/C.

fn _emit_intrinsic_oren_call_obj_list_x64(ctx, locals, fn_obj_expr, args_list_expr) {
    // Intrinsic: indirect call through a native function object.
    // Signature: oren_call_obj_list(fn_obj, args_list) -> value
    //
    // Layout (kind=6):
    //   [0] code_ptr
    //   [8] env_ptr
    //
    // This is inlined (like arm64) so injected runtime code can call it even
    // when the symbol is not present in the source module.
    if fn_obj_expr == nil || args_list_expr == nil {
        err(ctx, "x64 native v0: oren_call_obj_list expects 2 args")
        return nil
    }

    var spill = _intr_tmp_push(ctx, 1)
    if spill == nil { return nil }
    var fn_off = _intr_tmp_off(ctx, locals, spill)
    if fn_off == nil { _intr_tmp_pop(ctx, spill); return nil }

    // Spill fn_obj.
    _emit_eval_int_to_rax(ctx, fn_obj_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, spill); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fn_off, 0)

    // Eval args_list -> rax.
    _emit_eval_int_to_rax(ctx, args_list_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, spill); return nil }

    var env_reg = abi.int_arg_reg(ctx["abi"], 0)
    var args_reg = abi.int_arg_reg(ctx["abi"], 1)
    if env_reg == nil || args_reg == nil {
        _intr_tmp_pop(ctx, spill)
        err(ctx, "x64 native v0: missing ABI arg regs for oren_call_obj_list")
        return nil
    }

    // args_reg = args_list (value already in rax)
    if args_reg != 0 { bytes_extend(ctx["code"], insn_mov_r64_r64(args_reg, 0)) }

    // r10 = fnobj ptr
    _emit_mov_r64_mrbp(ctx, 10, 0 - fn_off)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    var labelsFn2 = {}
    var fixupsFn2 = []
    var l_fn_ok2 = _new_label(ctx, "oren_call_obj_list_fnobj_ok")
    _emit_jcc_to_label(ctx, fixupsFn2, "ne", l_fn_ok2)
    _emit_abort_panic_str(ctx, "call on nil function value")
    _emit_label(ctx, labelsFn2, l_fn_ok2)
    _patch_local_fixups(ctx, labelsFn2, fixupsFn2)

    // env_reg = *(fnobj + 8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(env_reg, 0))

    // rax = *(fnobj + 0) (code_ptr), then call.
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_call_rax())

    _intr_tmp_pop(ctx, spill)
    return nil
}

fn _emit_call_spread_via_runtime_helper_fnexpr_x64(ctx, locals, fn_obj_expr, args, spread) {
    // Tier-1 convergence: if the injected native runtime is enabled, lower call-site spread
    // via the shared helper:
    //   oren_call_obj_spread(fn_obj, fixed_args_list, spread_list)
    //
    // This matches the arm64 native backend lowering and avoids x64-only spread semantics.
    if ctx == nil { return nil }
    if ctx["runtime_injected"] != true { err(ctx, "x64 native v0: spread calls require injected native runtime"); return nil }
    if spread == nil { return nil }
    if fn_obj_expr == nil { err(ctx, "x64 native v0: spread call missing callee"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }

    // Spill layout:
    // - explicit args: [base + 0 .. base + argc-1]
    // - fixed_list:    base + argc
    // - spread_list:   base + argc + 1
    // - fn_obj:        base + argc + 2
    var spill_n = argc + 3
    var base = _intr_tmp_push(ctx, spill_n)
    if base == nil { return nil }

    // Spill explicit args (evaluate once; preserve LTR semantics).
    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        var off = _intr_tmp_off(ctx, locals, base + i)
        if off == nil { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = i + 1
    }

    var fixed_slot = base + argc
    var spread_slot = base + argc + 1
    var fn_slot = base + argc + 2
    var fixed_off = _intr_tmp_off(ctx, locals, fixed_slot)
    var spread_off = _intr_tmp_off(ctx, locals, spread_slot)
    var fn_off = _intr_tmp_off(ctx, locals, fn_slot)
    if fixed_off == nil || spread_off == nil || fn_off == nil {
        _intr_tmp_pop(ctx, base)
        err(ctx, "x64 native v0: missing spill slots for spread call")
        return nil
    }

    // fixed_list = oren_new_list(0)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fixed_off, 0)
    var fixed_name = "$tmp_intr" + oren_int_to_string(fixed_slot)

    // Push explicit args into fixed_list.
    var j = 0
    while j < argc {
        var arg_name = "$tmp_intr" + oren_int_to_string(base + j)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": fixed_name}, {"type": "Identifier", "value": arg_name}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        j = j + 1
    }

    // Spill spread_list.
    _emit_eval_int_to_rax(ctx, spread, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - spread_off, 0)
    var spread_name = "$tmp_intr" + oren_int_to_string(spread_slot)

    // Spill fn_obj.
    _emit_eval_int_to_rax(ctx, fn_obj_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fn_off, 0)
    var fn_name = "$tmp_intr" + oren_int_to_string(fn_slot)

    // Call runtime helper: oren_call_obj_spread(fn_obj, fixed_args, spread_list)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_call_obj_spread"}, "args": [{"type": "Identifier", "value": fn_name}, {"type": "Identifier", "value": fixed_name}, {"type": "Identifier", "value": spread_name}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_indirect_call_via_fnobj_x64(ctx, locals, fn_obj_expr, args, spread) {
    // Indirect call path (Tier-1 convergence): callee is a first-class function value, not a direct symbol call.
    //
    // Lowering:
    // - without spread: build args_list and call the uniform callable ABI wrapper
    // - with spread: call the shared runtime helper `oren_call_obj_spread(fn_obj, fixed_list, spread_list)`
    //
    // This mirrors the arm64 native semantics in `lib/compiler/arm64_native_expr/020_lowering_b.oren`.
    if ctx == nil { return nil }
    if fn_obj_expr == nil { err(ctx, "x64 native v0: indirect call missing callee"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }
    var has_spread = (spread != nil)

    // Indirect calls use runtime container helpers for argument packing.
    if ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: indirect calls require injected native runtime")
        return nil
    }

    // Spread always uses the shared runtime helper (matches arm64).
    if has_spread {
        _emit_call_spread_via_runtime_helper_fnexpr_x64(ctx, locals, fn_obj_expr, args, spread)
        return nil
    }

    // Spill layout:
    // - explicit args: [base + 0 .. base + argc-1]
    // - args_list:     base + argc
    // - callee fnobj:  base + argc + 1
    var spill_n = argc + 2
    var base = _intr_tmp_push(ctx, spill_n)
    if base == nil { return nil }

    // Spill explicit args (evaluate once; preserve LTR semantics).
    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        var off = _intr_tmp_off(ctx, locals, base + i)
        if off == nil { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = i + 1
    }

    var args_slot = base + argc
    var args_off = _intr_tmp_off(ctx, locals, args_slot)
    if args_off == nil { _intr_tmp_pop(ctx, base); return nil }
    var args_name = "$tmp_intr" + oren_int_to_string(args_slot)

    // Spill callee fnobj value (can be an arbitrary expression).
    var callee_slot = base + argc + 1
    var callee_off = _intr_tmp_off(ctx, locals, callee_slot)
    if callee_off == nil { _intr_tmp_pop(ctx, base); return nil }
    _emit_eval_int_to_rax(ctx, fn_obj_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - callee_off, 0)

    // Build args_list.
    // args_list = oren_new_list(0)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)

    // Push explicit args in order.
    var k0 = 0
    while k0 < argc {
        var arg_name0 = "$tmp_intr" + oren_int_to_string(base + k0)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": args_name}, {"type": "Identifier", "value": arg_name0}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        k0 = k0 + 1
    }

    // Load wrapper args and call wrapper(env_ptr, args_list).
    var env_reg = abi.int_arg_reg(ctx["abi"], 0)
    var args_reg = abi.int_arg_reg(ctx["abi"], 1)
    if env_reg == nil || args_reg == nil {
        _intr_tmp_pop(ctx, base)
        err(ctx, "x64 native v0: missing ABI arg regs for indirect call")
        return nil
    }

    // r10 = fnobj ptr
    _emit_mov_r64_mrbp(ctx, 10, 0 - callee_off)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    var labelsFn = {}
    var fixupsFn = []
    var l_fn_ok = _new_label(ctx, "indirect_fnobj_ok")
    _emit_jcc_to_label(ctx, fixupsFn, "ne", l_fn_ok)
    _emit_abort_panic_str(ctx, "call on nil function value")
    _emit_label(ctx, labelsFn, l_fn_ok)
    _patch_local_fixups(ctx, labelsFn, fixupsFn)
    // env_reg = *(fnobj + 8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(env_reg, 0))
    // args_reg = args_list
    _emit_mov_r64_mrbp(ctx, args_reg, 0 - args_off)
    // rax = *(fnobj + 0) (code_ptr)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_call_rax())

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_spawn_expr_v0(ctx, expr, locals) {
    // Spawn expression lowering (Tier-1): `spawn f(args...)`
    //
    // This is intentionally lowered through the injected native runtime helper:
    //   oren_spawn_call_list(fn_obj, args_list)
    //
    // so OS-specific details (threads, pipes, budgets, capsule) remain centralized in runtime.
    if ctx == nil { return nil }
    if ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: SpawnExpr requires injected runtime")
        return nil
    }
    if expr == nil { err(ctx, "x64 native v0: missing SpawnExpr"); return nil }
    var call2 = expr["call"]
    if call2 == nil || call2["type"] != "Call" { err(ctx, "x64 native v0: SpawnExpr missing call"); return nil }
    var fn_expr = call2["fn"]
    var args = call2["args"]
    var spread = call2["spread"]
    if fn_expr == nil { err(ctx, "x64 native v0: SpawnExpr missing callee"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }
    var has_spread = (spread != nil)

    var platform = ctx["platform"]
    var is_windows = false
    if platform != nil && platform["os"] == "windows" { is_windows = true }

    // Spill layout:
    // - explicit args: [base + 0 .. base + argc-1]
    // - args_list:     base + argc
    //
    // No spread:
    // - fn_obj:        base + argc + 1
    //
    // With spread:
    // - spread list:   base + argc + 1
    // - idx:           base + argc + 2
    // - len:           base + argc + 3
    // - elem:          base + argc + 4
    // - fn_obj:        base + argc + 5
    var spill_n = argc + 2
    if has_spread { spill_n = argc + 6 }
    // Windows spawn lowering needs extra spill slots for the thread handle/result/arg structs.
    // Keep these in the intrinsic tmp pool so the lowering stays leaf-like (no extra locals plumbing).
    var win_extra = 0
    if is_windows { win_extra = 4 } // result_ptr, arg_ptr, handle_ptr, start_ptr
    spill_n = spill_n + win_extra
    var base = _intr_tmp_push(ctx, spill_n)
    if base == nil { return nil }

    // Spill explicit args.
    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        var off = _intr_tmp_off(ctx, locals, base + i)
        if off == nil { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = i + 1
    }

    var args_slot = base + argc
    var args_off = _intr_tmp_off(ctx, locals, args_slot)
    if args_off == nil { _intr_tmp_pop(ctx, base); return nil }
    var args_name = "$tmp_intr" + oren_int_to_string(args_slot)

    // Build args_list.
    if has_spread {
        // args_list = oren_new_list(0)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)

        // Push explicit args.
        var j = 0
        while j < argc {
            var arg_name = "$tmp_intr" + oren_int_to_string(base + j)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": args_name}, {"type": "Identifier", "value": arg_name}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            j = j + 1
        }

        // Spill + expand spread list into args_list.
        var spread_slot = base + argc + 1
        var idx_slot = base + argc + 2
        var len_slot = base + argc + 3
        var elem_slot = base + argc + 4
        var spread_off = _intr_tmp_off(ctx, locals, spread_slot)
        var idx_off = _intr_tmp_off(ctx, locals, idx_slot)
        var len_off = _intr_tmp_off(ctx, locals, len_slot)
        var elem_off = _intr_tmp_off(ctx, locals, elem_slot)
        if spread_off == nil || idx_off == nil || len_off == nil || elem_off == nil {
            _intr_tmp_pop(ctx, base)
            err(ctx, "x64 native v0: missing spill slots for SpawnExpr spread")
            return nil
        }

        _emit_eval_int_to_rax(ctx, spread, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - spread_off, 0)
        var spread_name = "$tmp_intr" + oren_int_to_string(spread_slot)

        // len = oren_list_len(spread)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_len"}, "args": [{"type": "Identifier", "value": spread_name}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - len_off, 0)

        // idx = 0
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
        bytes_extend(ctx["code"], insn_cdqe())
        _emit_mov_mrbp_r64(ctx, 0 - idx_off, 0)
        var idx_name = "$tmp_intr" + oren_int_to_string(idx_slot)
        var elem_name = "$tmp_intr" + oren_int_to_string(elem_slot)

        var labels = {}
        var fixups = []
        var l_loop = _new_label(ctx, "spawn_spread_loop")
        var l_done = _new_label(ctx, "spawn_spread_done")
        _emit_label(ctx, labels, l_loop)

        _emit_mov_r64_mrbp(ctx, 0, 0 - idx_off) // rax = idx
        _emit_mov_r64_mrbp(ctx, 2, 0 - len_off) // rdx = len
        bytes_extend(ctx["code"], insn_cmp_r64_r64(0, 2))
        _emit_jcc_to_label(ctx, fixups, "ge", l_done)

        // elem = spread[idx]
        _emit_eval_int_to_rax(ctx, {"type": "Index", "left": {"type": "Identifier", "value": spread_name}, "index": {"type": "Identifier", "value": idx_name}}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - elem_off, 0)

        // args_list.push(elem)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": args_name}, {"type": "Identifier", "value": elem_name}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

        // idx++
        _emit_mov_r64_mrbp(ctx, 0, 0 - idx_off)
        bytes_extend(ctx["code"], insn_add_r64_imm32(0, 1))
        _emit_mov_mrbp_r64(ctx, 0 - idx_off, 0)
        _emit_jmp_to_label(ctx, fixups, l_loop)

        _emit_label(ctx, labels, l_done)
        _patch_local_fixups(ctx, labels, fixups)
    } else {
        // args_list = oren_new_list(argc)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": oren_int_to_string(argc)}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)

        // Push args into args_list in order.
        var j2 = 0
        while j2 < argc {
            var arg_name2 = "$tmp_intr" + oren_int_to_string(base + j2)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": args_name}, {"type": "Identifier", "value": arg_name2}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            j2 = j2 + 1
        }
    }

    // Spill fn_obj (callee evaluated as a first-class callable value).
    var fn_slot = base + argc + 1
    if has_spread { fn_slot = base + argc + 5 }
    var fn_off = _intr_tmp_off(ctx, locals, fn_slot)
    if fn_off == nil { _intr_tmp_pop(ctx, base); return nil }
    _emit_eval_int_to_rax(ctx, fn_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fn_off, 0)
    var fn_name = "$tmp_intr" + oren_int_to_string(fn_slot)

    if is_windows {
        // Windows Tier-1: lower `spawn` to CreateThread(...) using syscall intrinsics.
        //
        // We cannot use the POSIX fork+pipe runtime helper on Windows, and we also cannot take
        // the address of a function from Oren code. Instead, the code generator materializes
        // the raw thread entry pointer via a `rip_code_lea` fixup.
        //
        // Handle layout on Windows (heap, opaque to user code):
        //   [0]  thread_handle (HANDLE, u64)
        //   [8]  result_ptr    (u64*)
        //   [16] arg_ptr       (spawn arg struct ptr; freed by join)
        //
        // Thread arg struct layout:
        //   [0]  fn_obj
        //   [8]  args_list
        //   [16] result_ptr
        //   [24] auto_free (u64; 0=normal, 1=detach cleanup by thread)

        var win_base = base + spill_n - win_extra
        var slot_res = win_base + 0
        var slot_arg = win_base + 1
        var slot_handle = win_base + 2
        var slot_start = win_base + 3
        var off_res = _intr_tmp_off(ctx, locals, slot_res)
        var off_arg = _intr_tmp_off(ctx, locals, slot_arg)
        var off_handle = _intr_tmp_off(ctx, locals, slot_handle)
        var off_start = _intr_tmp_off(ctx, locals, slot_start)
        if off_res == nil || off_arg == nil || off_handle == nil || off_start == nil {
            _intr_tmp_pop(ctx, base)
            err(ctx, "x64 native v0: missing spill slots for SpawnExpr windows")
            return nil
        }

        // result_ptr = malloc_raw(8)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "malloc_raw"}, "args": [{"type": "Integer", "value": "8"}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off_res, 0)

        // Initialize result to 0.
        _emit_mov_r64_mrbp(ctx, 10, 0 - off_res) // r10 = result_ptr
        bytes_extend(ctx["code"], insn_xor_r64_r64(11, 11))
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11))

        // arg_ptr = malloc_raw(32)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "malloc_raw"}, "args": [{"type": "Integer", "value": "32"}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off_arg, 0)

        // Store [fn_obj, args_list, result_ptr, auto_free=0] into arg struct.
        _emit_mov_r64_mrbp(ctx, 10, 0 - off_arg) // r10 = arg_ptr
        _emit_mov_r64_mrbp(ctx, 11, 0 - fn_off)  // r11 = fn_obj
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11)) // [arg+0]=fn_obj
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
        _emit_mov_r64_mrbp(ctx, 11, 0 - args_off) // r11 = args_list
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11)) // [arg+8]=args_list
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
        _emit_mov_r64_mrbp(ctx, 11, 0 - off_res) // r11 = result_ptr
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11)) // [arg+16]=result_ptr
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
        bytes_extend(ctx["code"], insn_xor_r64_r64(11, 11))
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11)) // [arg+24]=auto_free=0

        // start_ptr = &__oren_win_spawn_thread_entry
        //
        // lea r11, [rip+disp32]  (patched to function entry)
        var lea_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(11, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_code_lea", "pos": lea_pos + 3, "name": "__oren_win_spawn_thread_entry"})
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
        _emit_mov_mrbp_r64(ctx, 0 - off_start, 0)

        // thread_handle = sys_win_createthread(start_ptr, arg_ptr)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "sys_win_createthread"}, "args": [{"type": "Identifier", "value": "$tmp_intr" + oren_int_to_string(slot_start)}, {"type": "Identifier", "value": "$tmp_intr" + oren_int_to_string(slot_arg)}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off_handle, 0)

        // handle_ptr = malloc_raw(24)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "malloc_raw"}, "args": [{"type": "Integer", "value": "24"}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

        // Store [thread_handle, result_ptr, arg_ptr] into handle struct.
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 0)) // r10 = handle_ptr
        _emit_mov_r64_mrbp(ctx, 11, 0 - off_handle)        // r11 = thread_handle
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
        _emit_mov_r64_mrbp(ctx, 11, 0 - off_res) // r11 = result_ptr
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
        _emit_mov_r64_mrbp(ctx, 11, 0 - off_arg) // r11 = arg_ptr
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11))

        // Return handle_ptr in RAX (already).
    } else {
        // POSIX: Call runtime helper: oren_spawn_call_list(fn_obj, args_list)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_spawn_call_list"}, "args": [{"type": "Identifier", "value": fn_name}, {"type": "Identifier", "value": args_name}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_varargs_named_call_via_fnobj_x64(ctx, locals, nm, args) {
    // Tier-1 convergence: if the injected native runtime is enabled, lower varargs named calls
    // through the uniform callable ABI, matching arm64:
    //   fn_obj(args...)  =>  args_list = [args...] ; oren_call_obj_list(fn_obj, args_list)
    //
    // This avoids x64-only call-site varargs packing and centralizes varargs semantics
    // into the synthesized `__oren_fnwrap_*` wrapper.
    if ctx == nil { return nil }
    if ctx["runtime_injected"] != true { err(ctx, "x64 native v0: varargs calls require injected native runtime"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }

    // Spill layout:
    // - explicit args: [base + 0 .. base + argc-1]
    // - args_list:     base + argc
    // - fn_obj:        base + argc + 1
    var spill_n = argc + 2
    var base = _intr_tmp_push(ctx, spill_n)
    if base == nil { return nil }

    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        var off = _intr_tmp_off(ctx, locals, base + i)
        if off == nil { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = i + 1
    }

    var args_slot = base + argc
    var fn_slot = base + argc + 1
    var args_off = _intr_tmp_off(ctx, locals, args_slot)
    var fn_off = _intr_tmp_off(ctx, locals, fn_slot)
    if args_off == nil || fn_off == nil {
        _intr_tmp_pop(ctx, base)
        err(ctx, "x64 native v0: missing spill slots for varargs call")
        return nil
    }

    // args_list = oren_new_list(argc)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": oren_int_to_string(argc)}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)
    var args_name = "$tmp_intr" + oren_int_to_string(args_slot)

    // Push args into args_list in order.
    var j = 0
    while j < argc {
        var arg_name = "$tmp_intr" + oren_int_to_string(base + j)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": args_name}, {"type": "Identifier", "value": arg_name}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        j = j + 1
    }

    // Spill fn_obj (named function used as value => fnobj record pointing at `__oren_fnwrap_*`).
    _emit_eval_int_to_rax(ctx, {"type": "Identifier", "value": nm}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fn_off, 0)
    var fn_name = "$tmp_intr" + oren_int_to_string(fn_slot)

    // Inline-call: oren_call_obj_list(fn_obj, args_list)
    _emit_intrinsic_oren_call_obj_list_x64(ctx, locals, {"type": "Identifier", "value": fn_name}, {"type": "Identifier", "value": args_name})
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_generic_call_expr_v0(ctx, expr, locals, nm, args) {
    if nm == "print" { err(ctx, "x64 native v0: print is statement-only"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }

    var spread = expr["spread"]

    // Tier-1 parity + performance: inline `oren_index_set(container, index, value)` so
    // list in-bounds stores do not pay an extra runtime call.
    if nm == "oren_index_set" {
        _emit_index_set_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }

    // Tier‑1 parity: match arm64 by inlining core list operations with tracked-kind safety gates.
    if nm == "oren_list_len" || nm == "STD_list_len" {
        _emit_list_len_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }
    if nm == "oren_list_push" || nm == "STD_list_push" {
        _emit_list_push_intrinsic_v0_x64(ctx, expr, locals)
        return nil
    }

    if nm == "oren_call_obj_list" {
        if spread != nil { err(ctx, "x64 native v0: oren_call_obj_list does not support spread"); return nil }
        if argc != 2 { err(ctx, "x64 native v0: oren_call_obj_list expects 2 args"); return nil }
        _emit_intrinsic_oren_call_obj_list_x64(ctx, locals, args[0], args[1])
        return nil
    }

    // Tier-1 parity: when runtime injection is enabled, lower call-site spread through the
    // shared runtime helper (matches arm64). This also works for indirect calls (callee in a var).
    if spread != nil {
        _emit_call_spread_via_runtime_helper_fnexpr_x64(ctx, locals, {"type": "Identifier", "value": nm}, args, spread)
        return nil
    }

    var is_direct = false
    var declared = ctx["declared_functions"]
    // Rolling shadowing rule: locals/global vars override named functions.
    // If `nm` is a local/global, treat this as an indirect call (callable value).
    var is_shadowed = false
    if locals != nil && locals[nm] != nil { is_shadowed = true }
    else if ctx != nil && ctx["globals"] != nil && ctx["globals"][nm] != nil { is_shadowed = true }
    if is_shadowed != true && declared != nil && declared[nm] != nil { is_direct = true }

    // Varargs packing (rolling): if the callee is a known named function with a trailing
    // `...rest`, pack extra args into a list and call the real function with:
    //   fn(fixed0, fixed1, ..., rest_list)
    var varargs_fixed = nil
    if ctx["func_varargs_fixed"] != nil { varargs_fixed = ctx["func_varargs_fixed"][nm] }
    var is_varargs_named = (is_direct == true && varargs_fixed != nil)
    // Wrapper functions (`__oren_fnwrap_<name>`) already receive a pre-packed `rest_list` and
    // must call the real varargs function at fixed arity (fixed args + rest_list).
    //
    // Avoid applying call-site packing inside wrappers, otherwise we would produce nested rest
    // lists (`rest = [[...]]`).
    if is_varargs_named {
        var cur_fn = ctx["cur_fn_name"]
        if cur_fn != nil && cur_fn == "__oren_fnwrap_" + nm {
            is_varargs_named = false
            varargs_fixed = nil
        }
    }

    // Tier-1 parity: when runtime injection is enabled, lower varargs named calls through the
    // uniform callable ABI (args_list + fnobj wrapper), matching arm64.
    if is_varargs_named {
        _emit_varargs_named_call_via_fnobj_x64(ctx, locals, nm, args)
        return nil
    }

    // Generic call path:
    // - direct calls remain ABI-direct (fast path) where possible
    // - indirect calls lower to the uniform callable ABI:
    //     fnobj = { code_ptr, env_ptr }
    //     args_list = [arg0, arg1, ...] (+ spread elements)
    //     call code_ptr(env_ptr, args_list)
    //
    // Rolling: stack args are supported; arg count is bounded only by call-area capacity.
    if is_direct == true {
        var arity2 = ctx["func_arity"][nm]
        if arity2 == nil { err(ctx, "x64 native v0: missing arity for function " + nm); return nil }
        if is_varargs_named {
            var fixed = varargs_fixed
            if argc < fixed { err(ctx, "x64 native v0: varargs arity mismatch for " + nm); return nil }
            if arity2 != fixed + 1 {
                err(ctx, "x64 native v0: inconsistent varargs signature for " + nm)
                return nil
            }
        } else {
            if argc != arity2 { err(ctx, "x64 native v0: call arity mismatch for " + nm); return nil }
        }
    }

    if is_direct != true {
        _emit_indirect_call_via_fnobj_x64(ctx, locals, {"type": "Identifier", "value": nm}, args, spread)
        return nil
    }

    // Evaluate explicit args left-to-right, spill to stack temps, then load into ABI arg registers.
    // This avoids clobbering Win64 arg registers (EDX, R8D, R9D) by our expression scratch.
    var spill_n2 = argc
    if is_varargs_named { spill_n2 = argc + 1 } // +1 for the packed rest_list
    var base2 = _intr_tmp_push(ctx, spill_n2)
    if base2 == nil { return nil }
    var i2 = 0
    while i2 < argc {
        _emit_eval_int_to_rax(ctx, args[i2], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
        var tmp_off = _intr_tmp_off(ctx, locals, base2 + i2)
        if tmp_off == nil { _intr_tmp_pop(ctx, base2); return nil }
        // Spill the full 64-bit value (keeps function pointer args intact).
        _emit_mov_mrbp_r64(ctx, 0 - tmp_off, 0)
        i2 = i2 + 1
    }

    // Varargs packing: build rest_list and spill it in the extra slot.
    var call_argc = argc
    if is_varargs_named {
        var fixed2 = varargs_fixed
        // rest_list lives in the extra spill slot at base2+argc
        var rest_idx = base2 + argc
        var rest_off = _intr_tmp_off(ctx, locals, rest_idx)
        if rest_off == nil { _intr_tmp_pop(ctx, base2); return nil }

        // rest_list = oren_new_list(0)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - rest_off, 0)

        // push extra args into rest_list
        var j2 = fixed2
        while j2 < argc {
            var rest_name = "$tmp_intr" + oren_int_to_string(rest_idx)
            var arg_name = "$tmp_intr" + oren_int_to_string(base2 + j2)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": rest_name}, {"type": "Identifier", "value": arg_name}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            j2 = j2 + 1
        }

        // Call the real function with fixed args + rest_list as the last arg.
        call_argc = fixed2 + 1
    }

    var regc2 = abi.max_int_reg_args(ctx["abi"])
    var shadow2 = abi.caller_shadow_bytes(ctx["abi"])
    var slot2 = abi.stack_arg_slot_bytes(ctx["abi"])
    var i3 = 0
    while i3 < call_argc {
        var src_idx2 = base2 + i3
        if is_varargs_named && i3 == varargs_fixed {
            // last arg is rest_list (spilled at base2+argc)
            src_idx2 = base2 + argc
        }
        var tmp_off2 = _intr_tmp_off(ctx, locals, src_idx2)
        if tmp_off2 == nil { _intr_tmp_pop(ctx, base2); return nil }

        if i3 < regc2 {
            var reg2 = abi.int_arg_reg(ctx["abi"], i3)
            if reg2 == nil { _intr_tmp_pop(ctx, base2); err(ctx, "x64 native v0: unsupported call arg index"); return nil }
            _emit_mov_r64_mrbp(ctx, reg2, 0 - tmp_off2)
        } else {
            _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_off2)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
            var stack_disp2 = shadow2 + slot2 * (i3 - regc2)
            var call_area2 = ctx["cur_call_area_bytes"]
            if call_area2 == nil { call_area2 = 0 }
            if stack_disp2 + slot2 > call_area2 {
                _intr_tmp_pop(ctx, base2)
                err(ctx, "x64 native v0: outgoing stack args exceed reserved call area (need " + oren_int_to_string(stack_disp2+slot2) + ", have " + oren_int_to_string(call_area2) + ")")
                return nil
            }
            _emit_mov_mrsp_r64(ctx, stack_disp2, 0)
        }
        i3 = i3 + 1
    }

    if is_direct {
        var call_pos2 = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos2, "name": nm})
    } else {
        // Should be unreachable: indirect calls return in the branch above.
        err(ctx, "x64 native v0: internal: fell through to non-direct call tail")
    }
    _intr_tmp_pop(ctx, base2)
    return nil
}
