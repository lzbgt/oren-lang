        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - elem_off, 0)

        // args_list.push(elem)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [args_tmp, elem_tmp]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

        // idx++
        _emit_mov_r64_mrbp(ctx, 0, 0 - idx_off)
        bytes_extend(ctx["code"], insn_add_r64_imm32(0, 1))
        _emit_mov_mrbp_r64(ctx, 0 - idx_off, 0)
        _emit_jmp_to_label(ctx, fixups, l_loop)

        _emit_label(ctx, labels, l_done)
        _patch_local_fixups(ctx, labels, fixups)
    } else {
        // args_list = oren_new_list(argc)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": oren_int_to_string(argc)}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)

        // Push args into args_list in order.
        var j2 = 0
        while j2 < argc {
            var arg_tmp2 = {"type": "IntrTmp", "idx": iadd(base, j2)}
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [args_tmp, arg_tmp2]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            j2 = iadd(j2, 1)
