// Generic call expression lowering for x64 native.
//
// Kept in a dedicated chunk to prevent `040_emit_expr.oren` from growing beyond
// reviewable limits as x64 Tier-1 call semantics converge with AVM/C.

fn _emit_intrinsic_oren_call_obj_list_x64(ctx, locals, fn_obj_expr, args_list_expr) {
    // Intrinsic: indirect call through a native function object.
    // Signature: oren_call_obj_list(fn_obj, args_list) -> value
    //
    // Layout (kind=6):
    //   [0] code_ptr
    //   [8] env_ptr
    //
    // This is inlined (like arm64) so injected runtime code can call it even
    // when the symbol is not present in the source module.
    if fn_obj_expr == nil || args_list_expr == nil {
        err(ctx, "x64 native v0: oren_call_obj_list expects 2 args")
        return nil
    }

    var spill = _intr_tmp_push(ctx, 1)
    if oren_type_tag(spill) == 0 { return nil }
    var fn_off = _intr_tmp_off(ctx, locals, spill)
    if oren_type_tag(fn_off) == 0 { _intr_tmp_pop(ctx, spill); return nil }

    // Spill fn_obj.
    _emit_eval_int_to_rax(ctx, fn_obj_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, spill); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - fn_off, 0)

    // Eval args_list -> rax.
    _emit_eval_int_to_rax(ctx, args_list_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, spill); return nil }

    if _x64_emit_call_obj_list_from_spills(ctx, spill, fn_off, nil, true, "oren_call_obj_list_fnobj_ok", "oren_call_obj_list") != true {
        return nil
    }

    _intr_tmp_pop(ctx, spill)
    return nil
}

fn _x64_call_obj_list_abi_regs(ctx, cleanup_base, context_name) {
    var env_reg_enc = abi.int_arg_reg(ctx["abi"], 0)
    var args_reg_enc = abi.int_arg_reg(ctx["abi"], 1)
    if oren_type_tag(env_reg_enc) == 0 || oren_type_tag(args_reg_enc) == 0 {
        if cleanup_base != nil { _intr_tmp_pop(ctx, cleanup_base) }
        err(ctx, "x64 native v0: missing ABI arg regs for " + context_name)
        return nil
    }
    return {"env": env_reg_enc - 1, "args": args_reg_enc - 1}
}

fn _x64_emit_call_obj_list_args_reg(ctx, args_reg, args_off, args_in_rax) {
    if args_in_rax == true {
        // args_list is already in rax from the caller-owned evaluation.
        if args_reg != 0 { bytes_extend(ctx["code"], core.insn_mov_r64_r64(args_reg, 0)) }
        return nil
    }
    _emit_mov_r64_mrbp(ctx, args_reg, 0 - args_off)
    return nil
}

fn _x64_emit_call_obj_list_fn_guard(ctx, fn_off, label_name) {
    _emit_mov_r64_mrbp(ctx, 10, 0 - fn_off)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 0))
    var labels = {}
    var fixups = []
    var l_fn_ok = _new_label(ctx, label_name)
    _emit_jcc_to_label(ctx, fixups, "ne", l_fn_ok)
    _emit_abort_panic_str(ctx, "call on nil function value")
    _emit_label(ctx, labels, l_fn_ok)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _x64_emit_call_obj_list_env_and_code_call(ctx, env_reg) {
    // env_reg = *(fnobj + 8), with r10 holding the function-object pointer.
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 8))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(env_reg, 0))

    // rax = *(fnobj + 0) (code_ptr), then call wrapper(env_ptr, args_list).
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    bytes_extend(ctx["code"], core.insn_call_rax())
    return nil
}

fn _x64_emit_call_obj_list_from_spills(ctx, cleanup_base, fn_off, args_off, args_in_rax, label_name, context_name) {
    var regs = _x64_call_obj_list_abi_regs(ctx, cleanup_base, context_name)
    if regs == nil { return false }
    _x64_emit_call_obj_list_args_reg(ctx, regs["args"], args_off, args_in_rax)
    _x64_emit_call_obj_list_fn_guard(ctx, fn_off, label_name)
    _x64_emit_call_obj_list_env_and_code_call(ctx, regs["env"])
    return true
}

fn _x64_call_spread_prepare(ctx, fn_obj_expr, args, spread) {
    var argc = 0
    if args != nil { argc = oren_list_len(args) }
    // Spill layout:
    // - explicit args: [base + 0 .. base + argc-1]
    // - fixed_list:    base + argc
    // - spread_list:   base + argc + 1
    // - fn_obj:        base + argc + 2
    var spill_n = argc + 3
    var base = _intr_tmp_push(ctx, spill_n)
    if oren_type_tag(base) == 0 { return nil }

    var st = {}
    st["fn_obj_expr"] = fn_obj_expr
    st["args"] = args
    st["spread"] = spread
    st["argc"] = argc
    st["base"] = base
    st["fixed_slot"] = iadd(base, argc)
    st["spread_slot"] = iadd(base, argc + 1)
    st["fn_slot"] = iadd(base, argc + 2)
    return st
}

fn _x64_call_spread_spill_explicit_args(ctx, st, locals) {
    // Spill explicit args (evaluate once; preserve LTR semantics).
    var args = st["args"]
    var argc = st["argc"]
    var base = st["base"]
    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
        var off = _intr_tmp_off(ctx, locals, iadd(base, i))
        if oren_type_tag(off) == 0 { _intr_tmp_pop(ctx, base); return false }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = iadd(i, 1)
    }
    return true
}

fn _x64_call_spread_prepare_slots(ctx, st, locals) {
    var base = st["base"]
    var fixed_off = _intr_tmp_off(ctx, locals, st["fixed_slot"])
    var spread_off = _intr_tmp_off(ctx, locals, st["spread_slot"])
    var fn_off = _intr_tmp_off(ctx, locals, st["fn_slot"])
    if oren_type_tag(fixed_off) == 0 || oren_type_tag(spread_off) == 0 || oren_type_tag(fn_off) == 0 {
        _intr_tmp_pop(ctx, base)
        err(ctx, "x64 native v0: missing spill slots for spread call")
        return false
    }
    st["fixed_off"] = fixed_off
    st["spread_off"] = spread_off
    st["fn_off"] = fn_off
    return true
}

fn _x64_call_spread_build_fixed_list(ctx, st, locals) {
    var base = st["base"]
    var argc = st["argc"]
    var fixed_slot = st["fixed_slot"]
    var fixed_tmp = {"type": "IntrTmp", "idx": fixed_slot}
    // fixed_list = oren_new_list(0)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
    _emit_mov_mrbp_r64(ctx, 0 - st["fixed_off"], 0)

    // Push explicit args into fixed_list.
    var j = 0
    while j < argc {
        var arg_tmp = {"type": "IntrTmp", "idx": iadd(base, j)}
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [fixed_tmp, arg_tmp]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
        j = iadd(j, 1)
    }
    st["fixed_tmp"] = fixed_tmp
    return true
}

fn _x64_call_spread_spill_spread_and_callee(ctx, st, locals) {
    var base = st["base"]
    // Spill spread_list.
    _emit_eval_int_to_rax(ctx, st["spread"], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
    _emit_mov_mrbp_r64(ctx, 0 - st["spread_off"], 0)
    var spread_tmp = {"type": "IntrTmp", "idx": st["spread_slot"]}

    // Spill fn_obj.
    _emit_eval_int_to_rax(ctx, st["fn_obj_expr"], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
    _emit_mov_mrbp_r64(ctx, 0 - st["fn_off"], 0)
    var fn_tmp = {"type": "IntrTmp", "idx": st["fn_slot"]}
    st["spread_tmp"] = spread_tmp
    st["fn_tmp"] = fn_tmp
    return true
}

fn _x64_call_spread_emit_runtime_helper(ctx, st, locals) {
    var base = st["base"]
    // Call runtime helper: oren_call_obj_spread(fn_obj, fixed_args, spread_list)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_call_obj_spread"}, "args": [st["fn_tmp"], st["fixed_tmp"], st["spread_tmp"]]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
    return true
}

fn _emit_call_spread_via_runtime_helper_fnexpr_x64(ctx, locals, fn_obj_expr, args, spread) {
    // Tier-1 convergence: if the injected native runtime is enabled, lower call-site spread
    // via the shared helper:
    //   oren_call_obj_spread(fn_obj, fixed_args_list, spread_list)
    //
    // This matches the arm64 native backend lowering and avoids x64-only spread semantics.
    if ctx == nil { return nil }
    if ctx["runtime_injected"] != true { err(ctx, "x64 native v0: spread calls require injected native runtime"); return nil }
    if spread == nil { return nil }
    if fn_obj_expr == nil { err(ctx, "x64 native v0: spread call missing callee"); return nil }

    var st = _x64_call_spread_prepare(ctx, fn_obj_expr, args, spread)
    if st == nil { return nil }
    if _x64_call_spread_spill_explicit_args(ctx, st, locals) != true { return nil }
    if _x64_call_spread_prepare_slots(ctx, st, locals) != true { return nil }
    if _x64_call_spread_build_fixed_list(ctx, st, locals) != true { return nil }
    if _x64_call_spread_spill_spread_and_callee(ctx, st, locals) != true { return nil }
    if _x64_call_spread_emit_runtime_helper(ctx, st, locals) != true { return nil }

    _intr_tmp_pop(ctx, st["base"])
    return nil
}

fn _x64_indirect_call_prepare(ctx, fn_obj_expr, args, argc) {
    // Spill layout:
    // - explicit args: [base + 0 .. base + argc-1]
    // - args_list:     base + argc
    // - callee fnobj:  base + argc + 1
    var spill_n = argc + 2
    var base = _intr_tmp_push(ctx, spill_n)
    if oren_type_tag(base) == 0 { return nil }
    var st = {}
    st["fn_obj_expr"] = fn_obj_expr
    st["args"] = args
    st["argc"] = argc
    st["base"] = base
    st["args_slot"] = iadd(base, argc)
    st["callee_slot"] = iadd(base, argc + 1)
    return st
}

fn _x64_indirect_call_spill_explicit_args(ctx, st, locals) {
    // Spill explicit args (evaluate once; preserve LTR semantics).
    var args = st["args"]
    var argc = st["argc"]
    var base = st["base"]
    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
        var off = _intr_tmp_off(ctx, locals, iadd(base, i))
        if oren_type_tag(off) == 0 { _intr_tmp_pop(ctx, base); return false }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = iadd(i, 1)
    }
    return true
}

fn _x64_indirect_call_prepare_slots(ctx, st, locals) {
    var base = st["base"]
    var args_slot = st["args_slot"]
    var args_off = _intr_tmp_off(ctx, locals, args_slot)
    if oren_type_tag(args_off) == 0 { _intr_tmp_pop(ctx, base); return false }
    st["args_off"] = args_off
    st["args_tmp"] = {"type": "IntrTmp", "idx": args_slot}

    // Spill callee fnobj value (can be an arbitrary expression).
    var callee_slot = st["callee_slot"]
    var callee_off = _intr_tmp_off(ctx, locals, callee_slot)
    if oren_type_tag(callee_off) == 0 { _intr_tmp_pop(ctx, base); return false }
    st["callee_off"] = callee_off
    return true
}

fn _x64_indirect_call_spill_callee(ctx, st, locals) {
    var base = st["base"]
    var fn_obj_expr = st["fn_obj_expr"]
    var callee_off = st["callee_off"]
    _emit_eval_int_to_rax(ctx, fn_obj_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
    _emit_mov_mrbp_r64(ctx, 0 - callee_off, 0)
    return true
}

fn _x64_indirect_call_build_args_list(ctx, st, locals) {
    var base = st["base"]
    var args_off = st["args_off"]
    // Build args_list.
    // args_list = oren_new_list(0)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
    _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)
    return true
}

fn _x64_indirect_call_push_explicit_args(ctx, st, locals) {
    // Push explicit args in order.
    var args_tmp = st["args_tmp"]
    var argc = st["argc"]
    var base = st["base"]
    var k0 = 0
    while k0 < argc {
        var arg_tmp0 = {"type": "IntrTmp", "idx": iadd(base, k0)}
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [args_tmp, arg_tmp0]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
        k0 = iadd(k0, 1)
    }
    return true
}

fn _x64_indirect_call_emit_wrapper_call(ctx, st) {
    var base = st["base"]
    var args_off = st["args_off"]
    var callee_off = st["callee_off"]
    if _x64_emit_call_obj_list_from_spills(ctx, base, callee_off, args_off, false, "indirect_fnobj_ok", "indirect call") != true {
        return false
    }
    _intr_tmp_pop(ctx, base)
    return true
}

fn _emit_indirect_call_via_fnobj_x64(ctx, locals, fn_obj_expr, args, spread) {
    // Indirect call path (Tier-1 convergence): callee is a first-class function value, not a direct symbol call.
    //
    // Lowering:
    // - without spread: build args_list and call the uniform callable ABI wrapper
    // - with spread: call the shared runtime helper `oren_call_obj_spread(fn_obj, fixed_list, spread_list)`
    //
    // This mirrors the arm64 native semantics in `lib/compiler/arm64_native_expr/020_lowering_b.oren`.
    if ctx == nil { return nil }
    if fn_obj_expr == nil { err(ctx, "x64 native v0: indirect call missing callee"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }
    var has_spread = (spread != nil)

    // Indirect calls use runtime container helpers for argument packing.
    if ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: indirect calls require injected native runtime")
        return nil
    }

    // Spread always uses the shared runtime helper (matches arm64).
    if has_spread {
        _emit_call_spread_via_runtime_helper_fnexpr_x64(ctx, locals, fn_obj_expr, args, spread)
        return nil
    }

    var st = _x64_indirect_call_prepare(ctx, fn_obj_expr, args, argc)
    if st == nil { return nil }
    if _x64_indirect_call_spill_explicit_args(ctx, st, locals) != true { return nil }
    if _x64_indirect_call_prepare_slots(ctx, st, locals) != true { return nil }
    if _x64_indirect_call_spill_callee(ctx, st, locals) != true { return nil }
    if _x64_indirect_call_build_args_list(ctx, st, locals) != true { return nil }
    if _x64_indirect_call_push_explicit_args(ctx, st, locals) != true { return nil }
    if _x64_indirect_call_emit_wrapper_call(ctx, st) != true { return nil }
    return nil
}

fn _x64_spawn_expr_prepare(ctx, expr) {
    var call2 = expr["call"]
    if call2 == nil || call2["type"] != "Call" { err(ctx, "x64 native v0: SpawnExpr missing call"); return nil }
    var fn_expr = call2["fn"]
    var args = call2["args"]
    var spread = call2["spread"]
    if fn_expr == nil { err(ctx, "x64 native v0: SpawnExpr missing callee"); return nil }

    var argc = 0
    if args != nil { argc = oren_list_len(args) }
    var has_spread = (spread != nil)

    // Spill layout:
    // - explicit args: [base + 0 .. base + argc-1]
    // - args_list:     base + argc
    //
    // No spread:
    // - fn_obj:        base + argc + 1
    //
    // With spread:
    // - spread list:   base + argc + 1
    // - idx:           base + argc + 2
    // - len:           base + argc + 3
    // - elem:          base + argc + 4
    // - fn_obj:        base + argc + 5
    var spill_n = argc + 2
    if has_spread { spill_n = argc + 6 }
    var base = _intr_tmp_push(ctx, spill_n)
    if oren_type_tag(base) == 0 { return nil }
    var st = {}
    st["call"] = call2
    st["fn_expr"] = fn_expr
    st["args"] = args
    st["spread"] = spread
    st["argc"] = argc
    st["has_spread"] = has_spread
    st["base"] = base
    st["args_slot"] = iadd(base, argc)
    return st
}

fn _x64_spawn_spill_explicit_args(ctx, st, locals) {
    var args = st["args"]
    var argc = st["argc"]
    var base = st["base"]
    // Spill explicit args.
    var i = 0
    while i < argc {
        _emit_eval_int_to_rax(ctx, args[i], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        var off = _intr_tmp_off(ctx, locals, iadd(base, i))
        if oren_type_tag(off) == 0 { st["failed"] = true; _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        i = iadd(i, 1)
    }
    return nil
}

fn _x64_spawn_prepare_args_slot(ctx, st, locals) {
    var base = st["base"]
    var args_slot = st["args_slot"]
    var args_off = _intr_tmp_off(ctx, locals, args_slot)
    if oren_type_tag(args_off) == 0 { st["failed"] = true; _intr_tmp_pop(ctx, base); return nil }
    st["args_off"] = args_off
    st["args_tmp"] = {"type": "IntrTmp", "idx": args_slot}
    return nil
}

fn _x64_spawn_build_empty_args_list(ctx, st, locals) {
    var base = st["base"]
    var args_off = st["args_off"]
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - args_off, 0)
    return nil
}

fn _x64_spawn_push_explicit_args(ctx, st, locals) {
    var args = st["args"]
    var argc = st["argc"]
    var base = st["base"]
    var args_tmp = st["args_tmp"]
    var j = 0
    while j < argc {
        var arg_tmp = {"type": "IntrTmp", "idx": iadd(base, j)}
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [args_tmp, arg_tmp]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        j = iadd(j, 1)
    }
    return nil
}

fn _x64_spawn_prepare_spread_slots(ctx, st, locals) {
    var base = st["base"]
    var args_slot = st["args_slot"]
    var spread_slot = iadd(args_slot, 1)
    var idx_slot = iadd(args_slot, 2)
    var len_slot = iadd(args_slot, 3)
    var elem_slot = iadd(args_slot, 4)
    var spread_off = _intr_tmp_off(ctx, locals, spread_slot)
    var idx_off = _intr_tmp_off(ctx, locals, idx_slot)
    var len_off = _intr_tmp_off(ctx, locals, len_slot)
    var elem_off = _intr_tmp_off(ctx, locals, elem_slot)
    if oren_type_tag(spread_off) == 0 || oren_type_tag(idx_off) == 0 || oren_type_tag(len_off) == 0 || oren_type_tag(elem_off) == 0 {
        _intr_tmp_pop(ctx, base)
        err(ctx, "x64 native v0: missing spill slots for SpawnExpr spread")
        return nil
    }
    st["spread_slot"] = spread_slot
    st["idx_slot"] = idx_slot
    st["len_slot"] = len_slot
    st["elem_slot"] = elem_slot
    st["spread_off"] = spread_off
    st["idx_off"] = idx_off
    st["len_off"] = len_off
    st["elem_off"] = elem_off
    st["spread_tmp"] = {"type": "IntrTmp", "idx": spread_slot}
    st["idx_tmp"] = {"type": "IntrTmp", "idx": idx_slot}
    st["elem_tmp"] = {"type": "IntrTmp", "idx": elem_slot}
    return nil
}

fn _x64_spawn_spill_spread_and_len(ctx, st, locals) {
    var base = st["base"]
    var spread = st["spread"]
    var spread_tmp = st["spread_tmp"]
    _emit_eval_int_to_rax(ctx, spread, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - st["spread_off"], 0)

    // len = oren_list_len(spread)
    _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_len"}, "args": [spread_tmp]}, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - st["len_off"], 0)

    // idx = 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - st["idx_off"], 0)
    return nil
}

fn _x64_spawn_spread_loop_labels(ctx) {
    return {
        "labels": {},
        "fixups": [],
        "loop": _new_label(ctx, "spawn_spread_loop"),
        "done": _new_label(ctx, "spawn_spread_done")
    }
}

