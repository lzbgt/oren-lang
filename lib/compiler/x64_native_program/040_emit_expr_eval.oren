fn _emit_eval_prefix_to_rax(ctx, expr, locals) {
	        var op = expr["op"]
	        var r = expr["right"]
	        if r == nil { err(ctx, "x64 native v0: prefix missing operand"); return nil }
	        if op == "!" {
	            // Boolean-not in expression context: result is a BOOL runtime singleton in RAX.
	            //
	            // Semantics: language truthiness (only `nil` and `false` are falsey).
	            // This is intentionally different from `oren_bool_norm` which uses numeric semantics.
	            var labels = {}
	            var local_fixups = []
	            var l_true = _new_label(ctx, "not_true")
	            var l_done = _new_label(ctx, "not_done")
	            if _cond_is_cmp_infix(r) != nil {
	                // Float compares require IEEE-aware lowering (ucomisd + unordered handling).
	                if _x64_expr_is_floaty(ctx, r["left"]) || _x64_expr_is_floaty(ctx, r["right"]) {
	                    _emit_float_cmp_to_bool_x64(ctx, r["op"], r["left"], r["right"], locals)
	                    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
	                    // Invert the boolean (0/1).
	                    bytes_extend(ctx["code"], core.insn_xor_r64_imm32(0, 1))
	                    // Map 0/1 => false/true singleton.
	                    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
	                    _emit_jcc_to_label(ctx, local_fixups, "ne", l_true)
	                    _x64_emit_load_value_singleton(ctx, 0, 376) // false
	                    _emit_jmp_to_label(ctx, local_fixups, l_done)
	                    _emit_label(ctx, labels, l_true)
	                    _x64_emit_load_value_singleton(ctx, 0, 384) // true
	                    _emit_label(ctx, labels, l_done)
	                    _patch_local_fixups(ctx, labels, local_fixups)
	                    return nil
	                }
	                _emit_cmp_from_cond(ctx, r, locals)
	                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
	                bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
	                var cc0 = _cond_false_cc(r["op"])
	                if cc0 == nil { err(ctx, "x64 native v0: unsupported compare op for !"); return nil }
	                bytes_extend(ctx["code"], core.insn_setcc_al_op2(core.setcc_op2(cc0)))
	                bytes_extend(ctx["code"], core.insn_cdqe())
	                // Map 0/1 => false/true singleton.
	                bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
	                _emit_jcc_to_label(ctx, local_fixups, "ne", l_true)
	                _x64_emit_load_value_singleton(ctx, 0, 376) // false
	                _emit_jmp_to_label(ctx, local_fixups, l_done)
	                _emit_label(ctx, labels, l_true)
	                _x64_emit_load_value_singleton(ctx, 0, 384) // true
	                _emit_label(ctx, labels, l_done)
	                _patch_local_fixups(ctx, labels, local_fixups)
	                return nil
	            }
	            _emit_eval_int_to_rax(ctx, r, locals)
	            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
	            // If operand is falsey => result true else false.
	            _x64_emit_jcc_if_rax_falsey(ctx, local_fixups, l_true)
	            _x64_emit_load_value_singleton(ctx, 0, 376) // false
	            _emit_jmp_to_label(ctx, local_fixups, l_done)
	            _emit_label(ctx, labels, l_true)
	            _x64_emit_load_value_singleton(ctx, 0, 384) // true
	            _emit_label(ctx, labels, l_done)
	            _patch_local_fixups(ctx, labels, local_fixups)
	            return nil
	        }
        _emit_eval_int_to_rax(ctx, r, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        if op == "-" {
            if _x64_expr_is_floaty(ctx, r) {
                // Float negation: flip the sign bit to preserve IEEE-754 semantics (incl -0.0).
                var sign_mask = 0 - (1 << 63) // 0x8000_0000_0000_0000 (i64_min)
                bytes_extend(ctx["code"], core.insn_mov_r64_imm64(2, sign_mask)) // rdx = mask
                bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 2))           // rax ^= mask
                return nil
            }
            bytes_extend(ctx["code"], core.insn_neg_r64(0)) // neg rax (int)
            return nil
        }
        if op == "~" {
            bytes_extend(ctx["code"], core.insn_not_r64(0)) // not rax
            return nil
        }
        err(ctx, "x64 native v0: prefix op not supported: " + op)
        return nil
}

fn _emit_eval_infix_to_rax(ctx, expr, locals) {
    var op = expr["op"]
    var l = expr["left"]
    var r = expr["right"]
    var is_float_op = op == "+" || op == "-" || op == "*" || op == "/"
    if is_float_op && (_x64_expr_is_floaty(ctx, l) || _x64_expr_is_floaty(ctx, r)) {
        // Float arithmetic (binary64): operands are carried as raw f64 bits in integer registers.
        _emit_float64_binop_x64(ctx, op, l, r, locals)
        return nil
    }
    if op == "+" {
        var handled = _emit_infix_add_or_string_concat_x64(ctx, expr, locals)
        if handled == 1 { return nil }
    }
    if op == "&&" || op == "||" { _emit_eval_logical_infix_to_rax(ctx, op, l, r, locals); return nil }
    if _cond_is_cmp_infix(expr) != nil { _emit_eval_compare_infix_to_rax(ctx, expr, op, l, r, locals); return nil }
    if op == "%" { _emit_eval_mod_infix_to_rax(ctx, l, r, locals); return nil }
    if op == "/" { _emit_eval_div_infix_to_rax(ctx, l, r, locals); return nil }
    if op == "<<" || op == ">>" { _emit_eval_shift_infix_to_rax(ctx, op, l, r, locals); return nil }
    if op == "&" || op == "|" || op == "^" { _emit_eval_bitwise_infix_to_rax(ctx, op, l, r, locals); return nil }
    if op == "+" || op == "-" || op == "*" { _emit_eval_integer_arith_infix_to_rax(ctx, op, l, r, locals); return nil }
    err(ctx, "x64 native v0: infix op not supported: " + op)
    return nil
}

fn _emit_eval_scalar_call_intrinsic_x64(ctx, nm, expr, locals, args) {
    if nm == "oren_trunc_int" {
        _emit_intrinsic_oren_trunc_int_x64(ctx, expr, locals)
        return 1
    }
    if nm == "oren_f32_round" {
        _emit_intrinsic_oren_f32_round_x64(ctx, expr, locals)
        return 1
    }
    if nm == "oren_f32_to_u32_bits" {
        // Intrinsic: convert float64 bits (RAX) to IEEE-754 float32 bits (u32 in EAX, zero-extended).
        if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_f32_to_u32_bits expects 1 argument"); return 1 }
        if expr["spread"] != nil { err(ctx, "x64 native v0: oren_f32_to_u32_bits does not support spread"); return 1 }
        _emit_eval_int_to_rax(ctx, args[0], locals) // f64 bits in rax
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
        bytes_extend(ctx["code"], core.insn_movq_xmm_r64(0, 0))      // xmm0 = f64 bits
        bytes_extend(ctx["code"], core.insn_cvtsd2ss_xmm_xmm(0, 0))  // xmm0 = f32(xmm0)
        bytes_extend(ctx["code"], core.insn_movd_r32_xmm(0, 0))      // eax = f32 bits (zero-extends to rax)
        return 1
    }
    if nm == "oren_u32_bits_to_f32" {
        // Intrinsic: convert IEEE-754 float32 bits (low 32 of RAX) to float64 bits (RAX).
        if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_u32_bits_to_f32 expects 1 argument"); return 1 }
        if expr["spread"] != nil { err(ctx, "x64 native v0: oren_u32_bits_to_f32 does not support spread"); return 1 }
        _emit_eval_int_to_rax(ctx, args[0], locals) // bits in rax (use low 32)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
        bytes_extend(ctx["code"], core.insn_movd_xmm_r32(0, 0))      // xmm0 = f32 bits from eax
        bytes_extend(ctx["code"], core.insn_cvtss2sd_xmm_xmm(0, 0))  // xmm0 = (double)xmm0
        bytes_extend(ctx["code"], core.insn_movq_r64_xmm(0, 0))      // rax = f64 bits
        return 1
    }
    if nm == "oren_f64_to_u64_bits" {
        // Intrinsic: reinterpret float64 bits as u64 bits (identity in carrier register).
        if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_f64_to_u64_bits expects 1 argument"); return 1 }
        if expr["spread"] != nil { err(ctx, "x64 native v0: oren_f64_to_u64_bits does not support spread"); return 1 }
        _emit_eval_int_to_rax(ctx, args[0], locals)
        return 1
    }
    if nm == "oren_u64_bits_to_f64" {
        // Intrinsic: reinterpret u64 bits as float64 bits (identity in carrier register).
        if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_u64_bits_to_f64 expects 1 argument"); return 1 }
        if expr["spread"] != nil { err(ctx, "x64 native v0: oren_u64_bits_to_f64 does not support spread"); return 1 }
        _emit_eval_int_to_rax(ctx, args[0], locals)
        return 1
    }
    if nm == "oren_bool_norm" {
        // `oren_bool_norm(x)` is used by type annotation lowering (`: bool`) to give bool
        // annotations deterministic semantics across backends.
        //
        // Semantics:
        // - int: x != 0
        // - float: x != 0.0 (where NaN counts as true; +0.0 and -0.0 count as false)
        if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_bool_norm expects 1 argument"); return 1 }
        if expr["spread"] != nil { err(ctx, "x64 native v0: oren_bool_norm does not support spread"); return 1 }
        var a0 = args[0]
        var is_float = _x64_expr_is_floaty(ctx, a0)
        _emit_eval_int_to_rax(ctx, a0, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }

        var labels = {}
        var local_fixups = []
        var l_true = _new_label(ctx, "bool_norm_true")
        var l_done = _new_label(ctx, "bool_norm_done")

        if is_float {
            // Compare float value to 0.0:
            // - unordered (NaN): PF=1 => treat as true (NaN != 0.0)
            // - ordered not-equal: ZF=0 => true
            // - equal (incl -0.0): ZF=1, PF=0 => false
            bytes_extend(ctx["code"], core.insn_movq_xmm_r64(0, 0))     // xmm0 = bits(rax)
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 0))    // edx = 0
            bytes_extend(ctx["code"], core.insn_movq_xmm_r64(1, 2))     // xmm1 = 0.0
            bytes_extend(ctx["code"], core.insn_ucomisd_xmm_xmm(0, 1))  // compare xmm0 vs xmm1
            _emit_jcc_to_label(ctx, local_fixups, "p", l_true)     // unordered => true
            _emit_jcc_to_label(ctx, local_fixups, "ne", l_true)    // != => true
        } else {
            // if rax != 0 => rax = 1 else rax = 0
            bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
            _emit_jcc_to_label(ctx, local_fixups, "ne", l_true)
        }

        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
        bytes_extend(ctx["code"], core.insn_cdqe())
        _emit_jmp_to_label(ctx, local_fixups, l_done)

        _emit_label(ctx, labels, l_true)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1))
        bytes_extend(ctx["code"], core.insn_cdqe())

        _emit_label(ctx, labels, l_done)
        _patch_local_fixups(ctx, labels, local_fixups)
        return 1
    }
    return 0
}

fn _emit_eval_call_expr_to_rax(ctx, expr, locals) {
    var fn_expr = expr["fn"]
    var args = expr["args"]
    if fn_expr == nil { err(ctx, "x64 native v0: call missing target"); return nil }
    // Tier‑1 parity: allow calling a function-valued expression directly.
    // (arm64 supports this; x64 converges via the uniform callable ABI in `044_emit_call_expr.oren`).
    if fn_expr["type"] != "Identifier" {
        // Namespace member call fast-path: `mod.fn(args...)` should lower as a direct call to the
        // resolved flattened symbol name, not as an indirect call through the callable ABI.
        //
        // This is required for `ffi` declarations that are module-exported (after renaming),
        // because x64 native v0 does not have an arity signature for `ffi` and therefore cannot
        // treat them as first-class function *values*.
        if fn_expr["type"] == "Member" {
            var nsr = _x64_ns_resolve(ctx, fn_expr)
            if nsr != nil && nsr["is_ns"] != true && nsr["name"] != nil && nsr["name"] != "" {
                fn_expr = {"type": "Identifier", "value": nsr["name"]}
            }
        }
        if fn_expr["type"] != "Identifier" {
            _emit_indirect_call_via_fnobj_x64(ctx, locals, fn_expr, args, expr["spread"])
            return nil
        }
    }

    var nm = fn_expr["value"]
    var nm_len = 0
    if nm != nil { nm_len = oren_string_len(nm) }
    if nm == "oren_gc_safepoint" {
        if args == nil || oren_list_len(args) == 0 {
            if expr["spread"] == nil {
                _emit_gc_safepoint_call_x64(ctx)
                return nil
            }
        }
    }
    if nm == "oren_gc_collect" {
        if args == nil || oren_list_len(args) == 0 {
            if expr["spread"] == nil {
                _emit_gc_collect_call_x64(ctx, locals)
                return nil
            }
        }
    }

    // PERF (x64 self-host builds):
    // Most compiler-internal calls (encoder helpers, backend emitters, etc) are *not* `oren_*`.
    // Avoid paying the large runtime-call classification chain for those names.
    var nm_is_oren = false
    if nm != nil && nm_len >= 5 {
        // Avoid `oren_string_slice` allocations in hot call paths (x64 self-host builds).
        if (oren_string_byte_at_unchecked(nm, 0) & 255) == 111 && // o
           (oren_string_byte_at_unchecked(nm, 1) & 255) == 114 && // r
           (oren_string_byte_at_unchecked(nm, 2) & 255) == 101 && // e
           (oren_string_byte_at_unchecked(nm, 3) & 255) == 110 && // n
           (oren_string_byte_at_unchecked(nm, 4) & 255) == 95 {   // _
            nm_is_oren = true
        }
    }

    if _emit_eval_call_runtime_or_fast_generic_x64(ctx, expr, locals, nm, nm_len, nm_is_oren, args) == 1 {
        return nil
    }

    // --- Intrinsics (Tier-1 convergence step) ---
    //
    // Treat core runtime/ABI helpers as compiler intrinsics so x64 can grow toward
    // parity with arm64 native without depending on host libc.
    //
    // Note: these intrinsics operate in the "int as i64 carrier" model where pointers
    // are plain 64-bit values.
    if _emit_eval_scalar_call_intrinsic_x64(ctx, nm, expr, locals, args) == 1 {
        return nil
    }
    if _emit_eval_pointer_call_intrinsic_x64(ctx, nm, expr, locals, args) == 1 {
        return nil
    }
    if _emit_eval_native_call_intrinsic_x64(ctx, nm, expr, locals, args) == 1 {
        return nil
    }

    if nm == "print" { err(ctx, "x64 native v0: print is statement-only"); return nil }

    var stack_intr = _emit_intrinsic_stack_helpers_x64(ctx, nm, expr, locals, args)
    if stack_intr == 1 { return nil }

    // System-call boundary: keep all host effects gated behind syscall intrinsics
    // so the capsule sandbox can enforce policy consistently.
    //
    // NOTE: not every `sys_*` function is a syscall intrinsic (some are normal runtime
    // wrappers like `sys_send`, `sys_recv`, `sys_read_u8_buf`).
    var is_shadowed = false
    if locals != nil && locals[nm] != nil { is_shadowed = true }
    else if ctx != nil && ctx["globals"] != nil && ctx["globals"][nm] != nil { is_shadowed = true }
    if is_shadowed != true && _x64_is_syscall_intrinsic_name(nm) {
        return _emit_intrinsic_sys_dispatch_x64(ctx, nm, expr, locals, args)
    }
    if nm == "exit" { return _emit_intrinsic_exit_x64(ctx, expr, locals, args) }

    // All non-intrinsic calls (direct/indirect, varargs, spread) are handled by the
    // dedicated call-lowering chunk for reviewability.
    return _emit_generic_call_expr_v0(ctx, expr, locals, nm, args)
}
fn _emit_eval_int_to_rax(ctx, expr, locals) {
    // Evaluate a tiny integer expression into RAX (64-bit register).
    // Values are stored/propagated through 64-bit registers and stack slots.
    // Supports:
    // - Integer
    // - Identifier (locals/params; or a named function as a first-class function pointer)
    // - Infix (+/-) with subexpressions from the above set
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Integer" {
        var n = intparse.parse_int_lit(expr["value"])
        if oren_is_err(n) { _x64_err_invalid_int_lit(ctx, expr["value"]); return nil }
        if _is_i32(n) {
            // mov eax, imm32 then sign-extend to rax (cdqe)
            var imm_u32 = n
            if n < 0 { imm_u32 = 4294967296 + n }
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, imm_u32))
            bytes_extend(ctx["code"], core.insn_cdqe())
        } else {
            // movabs rax, imm64 (encoded as u64 bits)
            bytes_extend(ctx["code"], core.insn_mov_r64_imm64(0, n))
        }
        return nil
    }
    if t == "Float" {
        // Float literal lowering:
        // - parse literal string to raw IEEE-754 binary64 bits at compile time
        // - load bits into RAX
        var bits = oren_string_to_float_bits(expr["value"])
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(0, bits))
        return nil
    }
    if t == "Boolean" {
        // Native backend: bool values are represented by runtime singletons stored in globals storage.
        //
        // This preserves:
        // - type-strict equality (`0 != false`)
        // - truthiness rules (only `nil` and `false` are falsey; `0` is truthy)
        //
        // Load:
        //   rax = g_storage
        //   rax = *(u64*)(rax + OFF_VALUE_TRUE/FALSE)
        var gname = nil
        if ctx != nil && ctx["rt_g_storage_name"] != nil { gname = ctx["rt_g_storage_name"] }
        if gname == nil {
            var match = nil
            var match_count = 0
            if ctx != nil && ctx["globals"] != nil {
                for k in ctx["globals"] {
                    // ends_with(k, "g_storage")
                    var klen = oren_string_len(k)
                    var suf = "g_storage"
                    var slen = oren_string_len(suf)
                    if klen >= slen {
                        var ok = true
                        var j = 0
                        while j < slen {
                            if oren_string_char_at(k, klen - slen + j) != oren_string_char_at(suf, j) { ok = false; break }
                            j = j + 1
                        }
                        if ok {
                            match = k
                            match_count = match_count + 1
                            if match_count > 1 { break }
                        }
                    }
                }
            }
            if match_count == 1 {
                gname = match
                if ctx != nil { ctx["rt_g_storage_name"] = match }
            }
        }
        if gname == nil || ctx == nil || ctx["globals"] == nil || ctx["globals"][gname] == nil {
            err(ctx, "x64 native v0: missing runtime global g_storage (needed for bool singletons)")
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
            bytes_extend(ctx["code"], core.insn_cdqe())
            return nil
        }
        var goff = ctx["globals"][gname] - 1
        // r10 = &global_slot ; rax = *(u64*)r10
        var lea_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(10, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": goff})
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(0, 10))

        var off = 376
        if expr["value"] { off = 384 }
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(0, 0, off))
        return nil
    }
    if t == "Nil" {
        // Native backend: `nil` is a runtime singleton stored in globals storage (not raw 0).
        //
        // Load:
        //   rax = g_storage
        //   rax = *(u64*)(rax + OFF_VALUE_NIL)
        var gname2 = nil
        if ctx != nil && ctx["rt_g_storage_name"] != nil { gname2 = ctx["rt_g_storage_name"] }
        if gname2 == nil {
            var match2 = nil
            var match_count2 = 0
            if ctx != nil && ctx["globals"] != nil {
                for k2 in ctx["globals"] {
                    var klen2 = oren_string_len(k2)
                    var suf2 = "g_storage"
                    var slen2 = oren_string_len(suf2)
                    if klen2 >= slen2 {
                        var ok2 = true
                        var j2 = 0
                        while j2 < slen2 {
                            if oren_string_char_at(k2, klen2 - slen2 + j2) != oren_string_char_at(suf2, j2) { ok2 = false; break }
                            j2 = j2 + 1
                        }
                        if ok2 {
                            match2 = k2
                            match_count2 = match_count2 + 1
                            if match_count2 > 1 { break }
                        }
                    }
                }
            }
            if match_count2 == 1 {
                gname2 = match2
                if ctx != nil { ctx["rt_g_storage_name"] = match2 }
            }
        }
        if gname2 == nil || ctx == nil || ctx["globals"] == nil || ctx["globals"][gname2] == nil {
            err(ctx, "x64 native v0: missing runtime global g_storage (needed for nil singleton)")
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
            bytes_extend(ctx["code"], core.insn_cdqe())
            return nil
        }
        var goff2 = ctx["globals"][gname2] - 1
        var lea_pos2 = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(10, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos2 + 3, "data_off": goff2})
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(0, 10))
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(0, 0, 368))
        return nil
    }
    if t == "String" {
        // Native strings are raw pointers to NUL-terminated bytes.
        // Store literal bytes in the appended data blob and load its address via RIP-relative LEA.
        var s = expr["value"]
        // Rolling robustness (stage2-native):
        // Some runtime/map implementations return `0` for a missing key rather than `nil`.
        // For a String AST node, prefer the token literal when `value` isn't a real string.
        if s == nil || oren_is_string(s) != true {
            var tok = expr["token"]
            if tok != nil {
                var lit = tok["literal"]
                if lit != nil && oren_is_string(lit) == true {
                    s = lit
                }
            }
        }
        if s == nil { s = "" }
        var off = _data_add_cstr0_cached(ctx, s)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        var lea_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(0, 0)) // lea rax, [rip+disp32]
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": off})
        // Tier‑1 convergence (rolling):
        // Embedded string literals are registered once at program startup via
        // `oren_init_static_cstr0_table` (entry stub), so per-use tracking is unnecessary here.
        return nil
    }
		    if t == "Function" {
	        // Lambda literal (anonymous function) in expression position.
	        //
	        // Representation:
	        // - returns a pointer to a runtime function object (kind=6) created by `oren_func(code_ptr, env_ptr)`
	        // - `code_ptr` points to the synthesized wrapper `__oren_lambda_N`
	        // - `env_ptr` is either 0 (no captures) or a list of captured values (capture-by-value)
	        var name = expr["name"]
	        if name != "" { err(ctx, "x64 native v0: function decl not allowed in expression position"); return nil }
	        if ctx == nil || ctx["runtime_injected"] != true {
	            // Lambda literals rely on runtime helpers (list/alloc + callable ABI).
	            err(ctx, "x64 native v0: lambda literals require injected native runtime")
	            return nil
	        }

	        // Ensure lambda has a stable name + capture list.
	        if expr["lambda_name"] == nil {
	            // Fallback: if collection was skipped, synthesize metadata here.
	            expr["lambda_name"] = callable.lambda_gensym(ctx)
	            expr["captures"] = callable.lambda_free_vars(ctx, expr)
	            oren_list_push(ctx["lambda_defs"], {"name": expr["lambda_name"], "fun": expr, "captures": expr["captures"]})
	        }
	        var lname = expr["lambda_name"]
	        var caps = expr["captures"]
	        if caps == nil { caps = [] }

		        // Spill slots: env ptr.
		        var base = _intr_tmp_push(ctx, 1)
		        if oren_type_tag(base) == 0 { return nil }
		        var slot_env = base
		        var tmp_env = _intr_tmp_off(ctx, locals, slot_env)
		        if oren_type_tag(tmp_env) == 0 {
		            _intr_tmp_pop(ctx, base)
		            err(ctx, "x64 native v0: missing spill slot for lambda literal env")
		            return nil
		        }

	        // env_ptr = 0 or a list of captures (capture-by-value, deterministic order)
	        if oren_list_len(caps) == 0 {
	            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
	            bytes_extend(ctx["code"], core.insn_cdqe())
	            _emit_mov_mrbp_r64(ctx, 0 - tmp_env, 0)
	        } else {
            // env = oren_new_list(0)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - tmp_env, 0)
            var env_tmp = {"type": "IntrTmp", "idx": slot_env}

            // Push captured values in deterministic order.
            var i = 0
            while i < oren_list_len(caps) {
                var cname = caps[i]
                _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [env_tmp, {"type": "Identifier", "value": cname}]}, locals)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
	                i = iadd(i, 1)
	            }
	        }

		        // Call `oren_func(code_ptr, env_ptr)` to create a tracked function object (kind=6).
		        var code_reg_enc = abi.int_arg_reg(ctx["abi"], 0)
		        var env_reg_enc = abi.int_arg_reg(ctx["abi"], 1)
		        if oren_type_tag(code_reg_enc) == 0 || oren_type_tag(env_reg_enc) == 0 {
		            _intr_tmp_pop(ctx, base)
		            err(ctx, "x64 native v0: missing ABI arg regs for oren_func")
		            return nil
		        }
	        var code_reg = code_reg_enc - 1
	        var env_reg = env_reg_enc - 1

	        // env_reg = env_ptr
	        _emit_mov_r64_mrbp(ctx, env_reg, 0 - tmp_env)

	        // code_reg = &__oren_lambda_N
	        var lea_pos = bytes_len(ctx["code"])
	        bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(code_reg, 0))
	        oren_list_push(ctx["fixups"], {"type": "rip_code_lea", "pos": lea_pos + 3, "name": lname})

	        // rax = oren_func(code_ptr, env_ptr)
	        _emit_call_rel32_named_x64(ctx, "oren_func")
	        _intr_tmp_pop(ctx, base)
		        return nil
		    }
		    if t == "IntrTmp" {
		        // Compiler-internal expr node: intrinsic temp slot reference.
		        // Stored as an integer idx into the per-function intrinsic temp pool.
		        if ctx == nil { err(ctx, "x64 native v0: IntrTmp requires ctx"); return nil }
		        var idx = expr["idx"]
		        // IntrTmp indices are 1-based (0 is reserved); avoid `== nil` checks on scalars.
		        if idx <= 0 { err(ctx, "x64 native v0: IntrTmp missing/invalid idx"); return nil }
		        var off = _intr_tmp_off(ctx, locals, idx)
		        if off == 0 { return nil }
		        _emit_mov_r64_mrbp(ctx, 0, 0 - off)
		        return nil
		    }
				    if t == "Identifier" {
				        var name = expr["value"]
				        var fn_name = name
				        // Locals map stores stack offsets (>= 8). Missing keys return `nil`, which is
				        // a distinct singleton under the native runtime. However, the native backend
				        // still has known `scalar == nil` hazards, so avoid direct nil comparisons and
				        // instead use the portable `oren_type_tag` probe (0=nil, 1=int).
				        var off = nil
				        if locals != nil { off = locals[name] }
				        if oren_type_tag(off) == 1 && off != 0 {
				            // Load full 64-bit slot so function pointers round-trip correctly.
				            _emit_mov_r64_mrbp(ctx, 0, 0 - off)
				            return nil
				        }

		        // Global var (top-level `var`) => load from the appended data blob.
		        //
		        // Precedence rule (rolling): locals > globals > named functions-as-values.
		        var goff_enc = nil
		        if ctx["globals"] != nil { goff_enc = ctx["globals"][name] }
		        if oren_type_tag(goff_enc) == 1 && goff_enc != 0 {
		            var goff = goff_enc - 1
		            // r10 = &global_slot ; rax = *(u64*)r10
		            var lea_pos0 = bytes_len(ctx["code"])
	            bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(10, 0))
	            oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos0 + 3, "data_off": goff})
	            bytes_extend(ctx["code"], core.insn_mov_r64_mr64(0, 10))
	            return nil
	        }

        // Named function used in expression position => treat as a first-class function value.
        // Representation: pointer to a small `{code_ptr, env_ptr}` object in the data blob.
        //
        // Tier‑1 convergence (rolling):
        // - `code_ptr` points to a uniform callable wrapper `__oren_fnwrap_<name>` with signature:
        //     fn __oren_fnwrap_name(__env, __args_list)
        // - `env_ptr` is 0 for now (no closures on x64 native yet).
        //
	        // This makes indirect calls backend/arch neutral and matches the shared lowering helpers
	        // in `lib/compiler/native_callable.oren`.
	        // Robustness (rolling): allow resolving internal `__name` by unique suffix match against
	        // declared function names (e.g. `M1___name`) when module prefixing missed a reference rewrite.
	        if ctx["func_arity"] != nil {
	            if ctx["func_arity"][fn_name] == nil {
	                if fn_name != nil && oren_string_len(fn_name) >= 2 &&
	                   oren_string_char_at(fn_name, 0) == "_" && oren_string_char_at(fn_name, 1) == "_" {
	                    var match = nil
	                    var match_count = 0
	                    for k in ctx["func_arity"] {
	                        var klen = oren_string_len(k)
	                        var nlen = oren_string_len(fn_name)
	                        if klen >= nlen {
	                            var ok = true
	                            var j = 0
	                            while j < nlen {
	                                if oren_string_char_at(k, klen - nlen + j) != oren_string_char_at(fn_name, j) { ok = false; break }
	                                j = j + 1
	                            }
	                            if ok {
	                                match = k
	                                match_count = match_count + 1
	                                if match_count > 1 { break }
	                            }
	                        }
	                    }
	                    if match_count == 1 && match != nil { fn_name = match }
	                }
	            }
	        }
	        if ctx["func_arity"] != nil && ctx["func_arity"][fn_name] != nil {
	            // Track which named-function wrappers are actually referenced as values.
	            // This keeps wrapper synthesis bounded for rtobj builds and reduces x64 cold-build time.
	            if ctx["fnwrap_needed"] != nil { ctx["fnwrap_needed"][fn_name] = 1 }
	            var wname = "__oren_fnwrap_" + fn_name

	            // Tier‑1 convergence: function values are runtime function objects (kind=6) so:
	            // - `std:reflect.tag/name` can discriminate funcs safely
	            // - spawned/indirect calls share a single callable ABI across arm64/x64
		            if ctx != nil && ctx["runtime_injected"] == true {
		                var code_reg_enc = abi.int_arg_reg(ctx["abi"], 0)
		                var env_reg_enc = abi.int_arg_reg(ctx["abi"], 1)
		                if oren_type_tag(code_reg_enc) == 0 || oren_type_tag(env_reg_enc) == 0 {
		                    err(ctx, "x64 native v0: missing ABI arg regs for oren_func")
		                    return nil
		                }
	                var code_reg = code_reg_enc - 1
	                var env_reg = env_reg_enc - 1

	                // env_ptr = 0 (no closures for named functions in rolling v0)
	                bytes_extend(ctx["code"], core.insn_mov_r32_imm32(env_reg, 0))

	                // code_ptr = &__oren_fnwrap_<name>
	                var lea_pos = bytes_len(ctx["code"])
	                bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(code_reg, 0))
	                oren_list_push(ctx["fixups"], {"type": "rip_code_lea", "pos": lea_pos + 3, "name": wname})

	                _emit_call_rel32_named_x64(ctx, "oren_func")
	                return nil
	            }

		            // Fallback (bring-up): if native runtime is not injected, use an untracked static fnobj record.
		            var fnobj_off = _data_add_fnobj(ctx, wname)
		            if oren_type_tag(fnobj_off) == 0 { err(ctx, "x64 native v0: failed to allocate fnobj"); return nil }
		            var lea_pos2 = bytes_len(ctx["code"])
		            bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(0, 0))
		            oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos2 + 3, "data_off": fnobj_off})
		            return nil
		        }

        err(ctx, "x64 native v0: unknown var " + name)
        return nil
    }
    if t == "Member" { return _emit_member_expr_v0(ctx, expr, locals) }
    if t == "Index" { return _emit_index_expr_v0(ctx, expr, locals) }
    if t == "Array" { return _emit_array_literal_expr(ctx, expr, locals) }
    if t == "Hash" { return _emit_hash_literal_expr(ctx, expr, locals) }
    if t == "SpawnExpr" { _emit_spawn_expr_v0(ctx, expr, locals); return nil }
    if t == "Call" { return _emit_eval_call_expr_to_rax(ctx, expr, locals) }
	    if t == "Prefix" { return _emit_eval_prefix_to_rax(ctx, expr, locals) }
    if t == "Infix" { return _emit_eval_infix_to_rax(ctx, expr, locals) }
    err(ctx, "x64 native v0: expr not supported: " + t)
    return nil
}
