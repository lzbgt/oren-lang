// x64-native: Windows syscall surface (Win32 API shims) + dispatch.
//
// This file exists to keep `046_emit_sys_intrinsics.oren` below the repo style limit.
// It contains Windows-only implementations of the syscall-first TIME substrate and
// the top-level syscall dispatch used by the native runtime injection boundary.

fn _x64_nanosleep_prepare_windows(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 1) // ns
    if oren_type_tag(base) == 0 { return nil }
    var tmp_ns = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(tmp_ns) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_ns)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "tmp_ns": tmp_ns}
}

fn _x64_nanosleep_emit_capsule_pre_windows(ctx, tmp_ns) {
    // pre: native_capsule_sys_nanosleep_pre(ns) -> ns
    var capsule = _x64_capsule_enabled(ctx)
    if capsule {
        _intr_load_x64(ctx, 1, tmp_ns) // rcx = ns (Win64 ABI)
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_nanosleep_pre")
        _emit_mov_mrbp_r64(ctx, 0 - tmp_ns, 0) // spill adjusted ns
    }
}

fn _x64_nanosleep_emit_nonpositive_path_windows(ctx, tmp_ns, fixups, l_sleep, l_done) {
    // if ns <= 0 => return 0
    _intr_load_x64(ctx, 0, tmp_ns)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "g", l_sleep)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, l_done)
}

fn _x64_nanosleep_emit_ms_in_rax_windows(ctx, tmp_ns, labels, fixups) {
    // rax = ceil(ns / 1_000_000)
    _intr_load_x64(ctx, 0, tmp_ns)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(0, 999999))
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(10, 1000000))
    bytes_extend(ctx["code"], core.insn_idiv_r64(10))

    // Clamp to 0x00000000FFFFFFFF to avoid overflow in Sleep(DWORD).
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(10, 4294967295))
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 10))
    var l_no_clamp = _new_label(ctx, "sys_nanosleep_win_no_clamp")
    _emit_jcc_to_label(ctx, fixups, "be", l_no_clamp) // unsigned <=
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    _emit_label(ctx, labels, l_no_clamp)
}

fn _x64_nanosleep_emit_sleep_call_windows(ctx) {
    // Sleep((DWORD)ms)
    bytes_extend(ctx["code"], core.insn_mov_r32_r32(1, 0)) // mov ecx, eax
    var mov_iat = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat + 3, "IAT_Sleep")
    bytes_extend(ctx["code"], core.insn_call_rax())

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
}

fn _emit_intrinsic_sys_nanosleep_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_nanosleep expects 1 arg"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_nanosleep does not support spread"); return nil }

    // Windows: best-effort sleep implemented via KERNEL32!Sleep(DWORD ms).
    // Contract: sys_nanosleep(ns) returns 0 on success; EINTR is not modeled.
    var st = _x64_nanosleep_prepare_windows(ctx, locals, args)
    if st == nil { return nil }
    _x64_nanosleep_emit_capsule_pre_windows(ctx, st["tmp_ns"])

    var labels = {}
    var fixups = []
    var l_sleep = _new_label(ctx, "sys_nanosleep_win_sleep")
    var l_done = _new_label(ctx, "sys_nanosleep_win_done")
    _x64_nanosleep_emit_nonpositive_path_windows(ctx, st["tmp_ns"], fixups, l_sleep, l_done)

    _emit_label(ctx, labels, l_sleep)
    _x64_nanosleep_emit_ms_in_rax_windows(ctx, st["tmp_ns"], labels, fixups)
    _x64_nanosleep_emit_sleep_call_windows(ctx)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, st["base"])
    return nil
}

fn _x64_ulock_wait_prepare_windows(ctx, locals) {
    var base = _intr_tmp_push(ctx, 3) // addr, value, timeout_us
    if oren_type_tag(base) == 0 { return nil }
    var tmp_addr = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_val = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_to = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(tmp_addr) == 0 || oren_type_tag(tmp_val) == 0 || oren_type_tag(tmp_to) == 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "tmp_addr": tmp_addr, "tmp_val": tmp_val, "tmp_to": tmp_to}
}

fn _x64_ulock_wait_spill_args_windows(ctx, locals, args, st) {
    _intr_eval_spill_x64(ctx, locals, args[1], st["tmp_addr"])
    _intr_eval_spill_x64(ctx, locals, args[2], st["tmp_val"])
    _intr_eval_spill_x64(ctx, locals, args[3], st["tmp_to"])
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, st["base"]); return false }
    return true
}

fn _x64_ulock_wait_emit_timeout_ms_windows(ctx, tmp_to) {
    // r9 = timeout_ms
    // - timeout_us <= 0: INFINITE (0xFFFFFFFF)
    // - timeout_us > 0: ceil(timeout_us / 1000)
    _intr_load_x64(ctx, 0, tmp_to) // rax = timeout_us (i64)
    var labels = {}
    var fixups = []
    var l_infinite = _new_label(ctx, "ulock_infinite")
    var l_after_to = _new_label(ctx, "ulock_after_to")
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "le", l_infinite)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(0, 999))
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 1000)) // r10 = 1000
    bytes_extend(ctx["code"], core.insn_idiv_r64(10)) // rax = ceil(timeout_us/1000)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 0)) // r9 = timeout_ms
    _emit_jmp_to_label(ctx, fixups, l_after_to)
    _emit_label(ctx, labels, l_infinite)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(9, 4294967295)) // INFINITE
    _emit_label(ctx, labels, l_after_to)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _x64_ulock_wait_emit_call_windows(ctx, tmp_addr, tmp_val) {
    // rcx = addr
    _intr_load_x64(ctx, 1, tmp_addr)

    // rdx = &compare (store compare value into the reserved outgoing call area at [rsp+32..39])
    _intr_load_x64(ctx, 0, tmp_val) // rax = compare (u64)
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_r64(32, 0)) // [rsp+32] = rax
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(2, 32))  // rdx = &compare

    // r8 = AddressSize = 8
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(8, 8))

    _emit_call_iat_x64(ctx, "IAT_WaitOnAddress")
    // BOOL in eax (0 => failure)
    return nil
}

fn _x64_ulock_wait_result_labels(ctx) {
    return {
        "labels": {},
        "fixups": [],
        "ok": _new_label(ctx, "ulock_ok"),
        "fail": _new_label(ctx, "ulock_fail"),
        "timeout": _new_label(ctx, "ulock_timeout"),
        "done": _new_label(ctx, "ulock_done")
    }
}

fn _x64_ulock_wait_emit_bool_dispatch_windows(ctx, st) {
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, st["fixups"], "ne", st["ok"])
    return nil
}

fn _x64_ulock_wait_emit_failure_dispatch_windows(ctx, st) {
    // Failure: GetLastError() and map ERROR_TIMEOUT => -ETIMEDOUT, else -EIO.
    _emit_call_iat_x64(ctx, "IAT_GetLastError")
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 1460)) // ERROR_TIMEOUT
    _emit_jcc_to_label(ctx, st["fixups"], "e", st["timeout"])
    _emit_jmp_to_label(ctx, st["fixups"], st["fail"])
    return nil
}

fn _x64_ulock_wait_emit_success_result_windows(ctx, st) {
    _emit_label(ctx, st["labels"], st["ok"])
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 0))
    _emit_jmp_to_label(ctx, st["fixups"], st["done"])
    return nil
}

fn _x64_ulock_wait_emit_timeout_result_windows(ctx, st) {
    _emit_label(ctx, st["labels"], st["timeout"])
    _emit_set_rax_neg_errno_x64(ctx, 60) // -ETIMEDOUT
    _emit_jmp_to_label(ctx, st["fixups"], st["done"])
    return nil
}

fn _x64_ulock_wait_emit_fail_result_windows(ctx, st) {
    _emit_label(ctx, st["labels"], st["fail"])
    _emit_set_rax_neg_errno_x64(ctx, 5) // -EIO
    _emit_label(ctx, st["labels"], st["done"])
    return nil
}

fn _x64_ulock_wait_emit_result_windows(ctx) {
    var st = _x64_ulock_wait_result_labels(ctx)
    _x64_ulock_wait_emit_bool_dispatch_windows(ctx, st)
    _x64_ulock_wait_emit_failure_dispatch_windows(ctx, st)
    _x64_ulock_wait_emit_success_result_windows(ctx, st)
    _x64_ulock_wait_emit_timeout_result_windows(ctx, st)
    _x64_ulock_wait_emit_fail_result_windows(ctx, st)
    _patch_local_fixups(ctx, st["labels"], st["fixups"])
    return nil
}

fn _emit_intrinsic_sys_ulock_wait_windows_x64(ctx, expr, locals, args) {
    // Portable "wait-on-address" primitive used by the injected runtime lock.
    //
    // Name is historical (Darwin ulock), but on Windows we map it to:
    //   KERNEL32!WaitOnAddress(addr, &compare, 8, timeout_ms)
    //
    // Contract:
    // - returns 0 on success (including "woke up"),
    // - returns -ETIMEDOUT on timeout,
    // - returns -EIO on unexpected failure.
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 4 { err(ctx, "x64 native v0: sys_ulock_wait expects 4 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_ulock_wait does not support spread"); return nil }

    // args: (operation, addr, value, timeout_us)
    // We ignore `operation` today (runtime lock uses UL_COMPARE_AND_WAIT=1).
    var st = _x64_ulock_wait_prepare_windows(ctx, locals)
    if st == nil { return nil }
    if _x64_ulock_wait_spill_args_windows(ctx, locals, args, st) != true { return nil }
    _x64_ulock_wait_emit_timeout_ms_windows(ctx, st["tmp_to"])
    _x64_ulock_wait_emit_call_windows(ctx, st["tmp_addr"], st["tmp_val"])
    _x64_ulock_wait_emit_result_windows(ctx)

    _intr_tmp_pop(ctx, st["base"])
    return nil
}

fn _emit_intrinsic_sys_ulock_wake_windows_x64(ctx, expr, locals, args) {
    // Portable "wake-by-address" primitive (paired with sys_ulock_wait).
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_ulock_wake expects 3 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_ulock_wake does not support spread"); return nil }

    // args: (operation, addr, wake_value) ; runtime lock uses wake-all (operation=257).
    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = addr
    _emit_call_iat_x64(ctx, "IAT_WakeByAddressAll")
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 0))
    return nil
}

fn _emit_intrinsic_sys_sched_yield_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args != nil && oren_list_len(args) != 0 { err(ctx, "x64 native v0: sys_sched_yield expects 0 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_sched_yield does not support spread"); return nil }

    // Windows: yield current thread timeslice via KERNEL32!Sleep(0).
    // Contract: returns 0 on success, or -errno.
    var capsule = _x64_capsule_enabled(ctx)
    if capsule {
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_sched_yield_pre")
    }

    // Sleep(0)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 0)) // mov ecx, 0 (Win64 ABI arg0)
    var mov_iat = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat + 3, "IAT_Sleep")
    bytes_extend(ctx["code"], core.insn_call_rax())

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    return nil
}

fn _x64_prepare_gettimeofday_windows_args(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 3) // tv, tz, abs
    if oren_type_tag(base) == 0 { return nil }
    var tmp_tv = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_tz = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_abs = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(tmp_tv) == 0 || oren_type_tag(tmp_tz) == 0 || oren_type_tag(tmp_abs) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_tv)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_tz)
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_abs)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    return {"base": base, "tmp_tv": tmp_tv, "tmp_tz": tmp_tz, "tmp_abs": tmp_abs}
}

fn _x64_gettimeofday_windows_capsule_pre(ctx, state) {
    // pre: native_capsule_sys_gettimeofday_pre(tv, tz, abs)
    var capsule = _x64_capsule_enabled(ctx)
    if capsule {
        _intr_load_x64(ctx, 1, state["tmp_tv"])  // rcx = tv
        _intr_load_x64(ctx, 2, state["tmp_tz"])  // rdx = tz
        _intr_load_x64(ctx, 8, state["tmp_abs"]) // r8  = abs
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_gettimeofday_pre")
    }
    return nil
}

fn _x64_gettimeofday_windows_validate_tv(ctx, labels, fixups, tmp_tv, l_done) {
    // Validate tv_ptr != 0 (otherwise -EFAULT).
    _intr_load_x64(ctx, 0, tmp_tv)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_tv_ok = _new_label(ctx, "sys_gettimeofday_win_tv_ok")
    _emit_jcc_to_label(ctx, fixups, "ne", l_tv_ok)
    // -14 (EFAULT)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967282))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_tv_ok)
    return nil
}

fn _x64_gettimeofday_windows_emit_wall_time(ctx, tmp_tv) {
    // filetime (u64) output at [rsp+0x20]
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(1, 32)) // rcx = &filetime
    var mov_iat0 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat0 + 3, "IAT_GetSystemTimeAsFileTime")
    bytes_extend(ctx["code"], core.insn_call_rax())

    // rax = filetime (100ns ticks since 1601-01-01 UTC)
    bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(0, 32))

    // unix_100ns = filetime - 116444736000000000 (100ns ticks between 1601-01-01 and 1970-01-01)
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(10, 116444736000000000))
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(0, 10))

    // sec = unix_100ns / 10_000_000; rem100ns = unix_100ns % 10_000_000
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(10, 10000000))
    bytes_extend(ctx["code"], core.insn_idiv_r64(10)) // rax=sec, rdx=rem100ns

    // Store tv_sec at [tv_ptr+0]
    _intr_load_x64(ctx, 11, tmp_tv) // r11 = tv_ptr
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(11, 0))

    // usec = rem100ns / 10
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 2)) // rax = rdx
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(10, 10))
    bytes_extend(ctx["code"], core.insn_idiv_r64(10)) // rax=usec

    // Store tv_usec at [tv_ptr+8]
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 8))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(11, 0))
    return nil
}

fn _x64_gettimeofday_windows_emit_abs_qpc(ctx, labels, fixups, tmp_abs, l_skip_abs) {
    // abs_ptr optional: write monotonic raw ticks via QueryPerformanceCounter.
    _intr_load_x64(ctx, 0, tmp_abs)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_skip_abs)

    // qpc (u64) output at [rsp+0x28]
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(1, 40)) // rcx = &qpc
    var mov_iat1 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat1 + 3, "IAT_QueryPerformanceCounter")
    bytes_extend(ctx["code"], core.insn_call_rax())

    bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(0, 40)) // rax = qpc
    _intr_load_x64(ctx, 11, tmp_abs)
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(11, 0))

    _emit_label(ctx, labels, l_skip_abs)
    return nil
}

fn _emit_intrinsic_sys_gettimeofday_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_gettimeofday expects 3 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_gettimeofday does not support spread"); return nil }

    // Windows: implement a syscall-first TIME substrate without libc.
    //
    // Signature matches Oren runtime:
    //   sys_gettimeofday(tv_ptr, tz_ptr, abs_ptr) -> rc
    //
    // - tv_ptr: points to 16 bytes (2x u64): tv_sec, tv_usec
    // - abs_ptr: optional out-arg (u64) for monotonic/raw compare-only time
    //
    // We use:
    // - KERNEL32!GetSystemTimeAsFileTime for wall time (FILETIME 100ns since 1601-01-01 UTC)
    // - KERNEL32!QueryPerformanceCounter for monotonic raw ticks (compare-only)
    //
    // Returns 0 on success; negative errno on obvious invalid pointers.
    var state = _x64_prepare_gettimeofday_windows_args(ctx, locals, args)
    if state == nil { return nil }
    var base = state["base"]
    var tmp_tv = state["tmp_tv"]
    var tmp_abs = state["tmp_abs"]

    _x64_gettimeofday_windows_capsule_pre(ctx, state)

    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "sys_gettimeofday_win_done")
    var l_skip_abs = _new_label(ctx, "sys_gettimeofday_win_skip_abs")

    _x64_gettimeofday_windows_validate_tv(ctx, labels, fixups, tmp_tv, l_done)
    _x64_gettimeofday_windows_emit_wall_time(ctx, tmp_tv)
    _x64_gettimeofday_windows_emit_abs_qpc(ctx, labels, fixups, tmp_abs, l_skip_abs)

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _x64_qpc_frequency_prepare_windows(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 1) // freq_ptr
    if oren_type_tag(base) == 0 { return nil }
    var tmp_p = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(tmp_p) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_p)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "tmp_p": tmp_p}
}

fn _x64_qpc_frequency_emit_ptr_guard_windows(ctx, tmp_p, fixups, l_ok, l_done) {
    // Validate ptr != 0.
    _intr_load_x64(ctx, 0, tmp_p)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)
    // -14 (EFAULT)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967282))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, l_done)
    return nil
}

fn _x64_qpc_frequency_emit_call_windows(ctx, tmp_p) {
    // QueryPerformanceFrequency(freq_ptr) writes ticks/sec to *freq_ptr.
    //
    // Avoid using fixed stack scratch offsets here: the intrinsic temp stack space can be smaller
    // than 0x20 bytes, and relying on [rsp+0x20] can alias caller frames or other runtime data.
    _intr_load_x64(ctx, 1, tmp_p) // rcx = freq_ptr
    var mov_iat = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat + 3, "IAT_QueryPerformanceFrequency")
    bytes_extend(ctx["code"], core.insn_call_rax())
    return nil
}

fn _x64_qpc_frequency_emit_result_windows(ctx, labels, fixups, l_ret0, l_done) {
    // If the call fails, return a generic -EIO-ish error so callers don't treat a zero frequency as valid.
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0)) // eax == 0?
    _emit_jcc_to_label(ctx, fixups, "ne", l_ret0)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967291)) // -5
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ret0)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    return nil
}

fn _emit_intrinsic_sys_qpc_frequency_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_qpc_frequency expects 1 arg"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_qpc_frequency does not support spread"); return nil }

    // Signature:
    //   sys_qpc_frequency(freq_ptr) -> 0_or_neg_errno
    //
    // Writes the QueryPerformanceCounter frequency (ticks/sec) as a u64 to *freq_ptr.
    var state = _x64_qpc_frequency_prepare_windows(ctx, locals, args)
    if state == nil { return nil }

    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "sys_qpc_freq_done")
    var l_ok = _new_label(ctx, "sys_qpc_freq_ok")
    var l_ret0 = _new_label(ctx, "sys_qpc_freq_ret0")

    _x64_qpc_frequency_emit_ptr_guard_windows(ctx, state["tmp_p"], fixups, l_ok, l_done)
    _emit_label(ctx, labels, l_ok)
    _x64_qpc_frequency_emit_call_windows(ctx, state["tmp_p"])
    _x64_qpc_frequency_emit_result_windows(ctx, labels, fixups, l_ret0, l_done)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, state["base"])
    return nil
}

fn _emit_sys_open_windows_capsule_pre_x64(ctx, tmp_path, tmp_flags, tmp_pair, capsule) {
    if capsule != true { return nil }
    _intr_load_x64(ctx, 1, tmp_path)  // rcx = path
    _intr_load_x64(ctx, 2, tmp_flags) // rdx = flags
    _emit_call_rel32_named_x64(ctx, "native_capsule_sys_open_pre")
    _emit_mov_mrbp_r64(ctx, 0 - tmp_pair, 0) // spill pair
    return nil
}

fn _emit_sys_open_windows_path_arg_x64(ctx, tmp_path, tmp_pair, capsule) {
    // rcx = resolved_path_ptr (pair[0]) if capsule; else rcx = original path.
    if capsule == true {
        _intr_load_x64(ctx, 11, tmp_pair)                   // r11 = pair
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(1, 11))  // rcx = *(u64*)pair
    } else {
        _intr_load_x64(ctx, 1, tmp_path) // rcx = path
    }

    // Normalize portable '/' separators to Win32 '\\' for the CreateFileA boundary.
    // Keep the normalization scratch strictly around the single WinAPI call.
    _emit_win64_path_norm_begin_x64(ctx, WIN64_PATH_SCRATCH_ONE)
    _emit_win64_path_norm_reg_to_buf_x64(ctx, 1, 0) // rcx
    return nil
}

fn _emit_sys_open_windows_access_args_x64(ctx, tmp_flags, labels, fixups) {
    // rdx = desired_access (GENERIC_*). access bits: flags & 3 => 0=RDONLY,1=WRONLY,2=RDWR
    _intr_load_x64(ctx, 10, tmp_flags) // r10 = flags
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(10, 3))
    var l_acc_wr = _new_label(ctx, "sys_open_acc_wr")
    var l_acc_rw = _new_label(ctx, "sys_open_acc_rw")
    var l_acc_done = _new_label(ctx, "sys_open_acc_done")
    // default: READ (0x80000000)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 2147483648))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 1))
    _emit_jcc_to_label(ctx, fixups, "e", l_acc_wr)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 2))
    _emit_jcc_to_label(ctx, fixups, "e", l_acc_rw)
    _emit_jmp_to_label(ctx, fixups, l_acc_done)
    _emit_label(ctx, labels, l_acc_wr)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 1073741824)) // WRITE (0x40000000)
    _emit_jmp_to_label(ctx, fixups, l_acc_done)
    _emit_label(ctx, labels, l_acc_rw)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 3221225472)) // READ|WRITE (0xC0000000)
    _emit_label(ctx, labels, l_acc_done)

    // O_APPEND maps to append-only writes on Windows. Creation disposition still follows CREAT/TRUNC.
    _intr_load_x64(ctx, 10, tmp_flags)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(11, OREN_O_APPEND))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    var l_no_append_access = _new_label(ctx, "sys_open_no_append_access")
    _emit_jcc_to_label(ctx, fixups, "e", l_no_append_access)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 4)) // FILE_APPEND_DATA
    _emit_label(ctx, labels, l_no_append_access)

    // r8 = share mode: READ|WRITE|DELETE; r9 = lpSecurityAttributes = NULL.
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(8, 7))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(9, 0))
    return nil
}

fn _emit_sys_open_windows_creation_stack_args_x64(ctx, tmp_flags, labels, fixups) {
    // Derive creation disposition from Oren flags:
    // - CREAT + TRUNC => CREATE_ALWAYS (2)
    // - CREAT        => OPEN_ALWAYS (4)
    // - TRUNC        => TRUNCATE_EXISTING (5)
    // - default      => OPEN_EXISTING (3)
    _intr_load_x64(ctx, 10, tmp_flags) // r10 = flags
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(11, OREN_O_CREAT))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    var l_no_creat = _new_label(ctx, "sys_open_no_creat")
    _emit_jcc_to_label(ctx, fixups, "e", l_no_creat)

    // has CREAT
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(11, OREN_O_TRUNC))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    var l_creat_no_trunc = _new_label(ctx, "sys_open_creat_no_trunc")
    _emit_jcc_to_label(ctx, fixups, "e", l_creat_no_trunc)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 2)) // CREATE_ALWAYS
    var l_disp_done = _new_label(ctx, "sys_open_disp_done")
    _emit_jmp_to_label(ctx, fixups, l_disp_done)
    _emit_label(ctx, labels, l_creat_no_trunc)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 4)) // OPEN_ALWAYS
    _emit_jmp_to_label(ctx, fixups, l_disp_done)

    _emit_label(ctx, labels, l_no_creat)
    // no CREAT
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(11, OREN_O_TRUNC))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    var l_no_creat_no_trunc = _new_label(ctx, "sys_open_no_creat_no_trunc")
    _emit_jcc_to_label(ctx, fixups, "e", l_no_creat_no_trunc)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 5)) // TRUNCATE_EXISTING
    _emit_jmp_to_label(ctx, fixups, l_disp_done)
    _emit_label(ctx, labels, l_no_creat_no_trunc)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 3)) // OPEN_EXISTING

    _emit_label(ctx, labels, l_disp_done)
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_mov_mrsp_r64(ctx, 32, 10) // arg5 dwCreationDisposition

    // arg6 dwFlagsAndAttributes = FILE_ATTRIBUTE_NORMAL (0x80)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 128))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_mov_mrsp_r64(ctx, 40, 10)

    // arg7 hTemplateFile = NULL
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_mov_mrsp_r64(ctx, 48, 10)
    return nil
}

fn _emit_sys_open_windows_create_file_x64(ctx, labels, fixups) {
    // CreateFileA(path, access, share, NULL, creation, attrs, NULL) -> HANDLE (rax) or INVALID_HANDLE_VALUE(-1).
    _emit_call_iat_x64(ctx, "IAT_CreateFileA")

    // On failure, translate Win32 GetLastError() to a POSIX-like -errno so higher-level
    // helpers (e.g. `oren_write_bytes`) can surface actionable error codes.
    var l_open_ok = _new_label(ctx, "sys_open_win_ok")
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 4294967295)) // rax == -1 ?
    _emit_jcc_to_label(ctx, fixups, "ne", l_open_ok)
    _emit_win32_last_error_to_neg_errno_common_x64(ctx)
    _emit_label(ctx, labels, l_open_ok)
    return nil
}

fn _emit_sys_open_windows_capsule_post_x64(ctx, tmp_pair, capsule) {
    if capsule != true { return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0)) // rdx = rc (HANDLE or -1)
    _intr_load_x64(ctx, 1, tmp_pair)                  // rcx = pair
    _emit_call_rel32_named_x64(ctx, "native_capsule_sys_open_post")
    return nil
}

fn _emit_intrinsic_sys_open_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_open expects 3 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_open does not support spread"); return nil }

    // Windows: implement `sys_open(path, flags, mode)` via KERNEL32!CreateFileA.
    //
    // Contract (syscall-first, capsule-safe):
    // - `native_capsule_sys_open_pre(path, flags) -> pair` must be invoked first
    // - resolved path pointer is at pair[0]
    // - return value is a "fd-like" i64:
    //     - on success: a HANDLE value (opaque; consumed by sys_read/sys_write/sys_close)
    //     - on failure: negative (INVALID_HANDLE_VALUE = -1), treated as error by callers
    // - `native_capsule_sys_open_post(pair, rc) -> rc` runs after the OS call
    //
    // NOTE (rolling):
    // - We currently model file descriptors as Win32 HANDLEs directly.
    // - sys_close on Windows tries closesocket() first, then falls back to CloseHandle(),
    //   so returning a HANDLE here keeps semantics unified for IO and NET.
    var base = _intr_tmp_push(ctx, 4) // path, flags, mode, pair
    if oren_type_tag(base) == 0 { return nil }
    var tmp_path = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_flags = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_mode = _intr_tmp_off(ctx, locals, base + 2)
    var tmp_pair = _intr_tmp_off(ctx, locals, base + 3)
    if oren_type_tag(tmp_path) == 0 || oren_type_tag(tmp_flags) == 0 || oren_type_tag(tmp_mode) == 0 || oren_type_tag(tmp_pair) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_path)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_flags)
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_mode)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    var capsule = _x64_capsule_enabled(ctx)
    var labels = {}
    var fixups = []

    _emit_sys_open_windows_capsule_pre_x64(ctx, tmp_path, tmp_flags, tmp_pair, capsule)
    _emit_sys_open_windows_path_arg_x64(ctx, tmp_path, tmp_pair, capsule)
    _emit_sys_open_windows_access_args_x64(ctx, tmp_flags, labels, fixups)
    _emit_sys_open_windows_creation_stack_args_x64(ctx, tmp_flags, labels, fixups)
    _emit_sys_open_windows_create_file_x64(ctx, labels, fixups)
    _emit_win64_path_norm_end_x64(ctx, WIN64_PATH_SCRATCH_ONE)
    _emit_sys_open_windows_capsule_post_x64(ctx, tmp_pair, capsule)

    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_gettid_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 0 { err(ctx, "x64 native v0: sys_gettid expects 0 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_gettid does not support spread"); return nil }

    // Windows: GetCurrentThreadId() -> DWORD.
    //
    // The native runtime lock implementation uses `sys_gettid()` as a stable per-thread identity.
    // Returning a non-zero ID is mandatory for correctness under multi-threaded spawn/join.
    _emit_call_iat_x64(ctx, "IAT_GetCurrentThreadId")
    // DWORD in eax is already zero-extended into rax.
    return nil
}

fn _x64_getentropy_windows_assets(ctx) {
    if ctx["win_bcryptgenrandom_slot_enc"] == nil {
        var off_slot = _data_add_u64(ctx, 0)
        ctx["win_bcryptgenrandom_slot_enc"] = off_slot + 1
    }
    var slot_off = ctx["win_bcryptgenrandom_slot_enc"] - 1
    var off_dll = _data_add_cstr0(ctx, "bcrypt.dll")
    var off_sym = _data_add_cstr0(ctx, "BCryptGenRandom")
    return {"slot_off": slot_off, "off_dll": off_dll, "off_sym": off_sym}
}

fn _x64_getentropy_windows_spill_args(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 2) // buf, len
    if oren_type_tag(base) == 0 { return nil }
    var tmp_buf = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_len = _intr_tmp_off(ctx, locals, base + 1)
    if oren_type_tag(tmp_buf) == 0 || oren_type_tag(tmp_len) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_buf)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_len)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "tmp_buf": tmp_buf, "tmp_len": tmp_len}
}

fn _x64_getentropy_windows_init_state(ctx, locals, args) {
    var assets = _x64_getentropy_windows_assets(ctx)
    var spills = _x64_getentropy_windows_spill_args(ctx, locals, args)
    if spills == nil { return nil }
    var labels = {}
    var fixups = []
    return {
        "base": spills["base"],
        "tmp_buf": spills["tmp_buf"],
        "tmp_len": spills["tmp_len"],
        "slot_off": assets["slot_off"],
        "off_dll": assets["off_dll"],
        "off_sym": assets["off_sym"],
        "labels": labels,
        "fixups": fixups,
        "l_have_fp": _new_label(ctx, "sys_getentropy_have_fp"),
        "l_fail": _new_label(ctx, "sys_getentropy_fail"),
        "l_done": _new_label(ctx, "sys_getentropy_done"),
        "l_ret0": _new_label(ctx, "sys_getentropy_ret0")
    }
}

fn _x64_emit_getentropy_windows_guards(ctx, state) {
    var labels = state["labels"]
    var fixups = state["fixups"]
    var tmp_buf = state["tmp_buf"]
    var tmp_len = state["tmp_len"]
    // if len <= 0 => return 0
    _intr_load_x64(ctx, 0, tmp_len)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "g", state["l_have_fp"])
    // return 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, state["l_done"])

    _emit_label(ctx, labels, state["l_have_fp"])

    // Validate buf != 0
    _intr_load_x64(ctx, 0, tmp_buf)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_buf_ok = _new_label(ctx, "sys_getentropy_buf_ok")
    _emit_jcc_to_label(ctx, fixups, "ne", l_buf_ok)
    // -14 (EFAULT)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967282))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, state["l_done"])
    _emit_label(ctx, labels, l_buf_ok)
    return nil
}

fn _x64_emit_getentropy_windows_slot_lea(ctx, state, dst_reg) {
    // Load &slot into r10
    var slot_off = state["slot_off"]
    var lea_slot = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(dst_reg, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_slot + 3, "data_off": slot_off})
    return nil
}

fn _x64_emit_getentropy_windows_resolve_fp(ctx, state) {
    var labels = state["labels"]
    var fixups = state["fixups"]
    var off_dll = state["off_dll"]
    var off_sym = state["off_sym"]
    _x64_emit_getentropy_windows_slot_lea(ctx, state, 10)
    // r11 = *(u64*)slot
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(11, 10))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", state["l_ret0"]) // fp already cached in r11

    // Resolve: LoadLibraryA("bcrypt.dll")
    // rcx = &"bcrypt.dll"
    var lea_dll = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(1, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_dll + 3, "data_off": off_dll})
    // call LoadLibraryA
    var mov_iat0 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat0 + 3, "IAT_LoadLibraryA")
    bytes_extend(ctx["code"], core.insn_call_rax())
    // if rax == 0 => fail
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", state["l_fail"])

    // Resolve: GetProcAddress(h, "BCryptGenRandom")
    // rcx = h
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0))
    // rdx = &"BCryptGenRandom"
    var lea_sym = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(2, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_sym + 3, "data_off": off_sym})
    var mov_iat1 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat1 + 3, "IAT_GetProcAddress")
    bytes_extend(ctx["code"], core.insn_call_rax())
    // if rax == 0 => fail
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", state["l_fail"])

    // Cache fp in slot and r11
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 0))
    _x64_emit_getentropy_windows_slot_lea(ctx, state, 10)
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(10, 11))

    _emit_label(ctx, labels, state["l_ret0"])
    return nil
}

fn _x64_emit_getentropy_windows_call_rng(ctx, state) {
    var labels = state["labels"]
    var fixups = state["fixups"]
    var tmp_buf = state["tmp_buf"]
    var tmp_len = state["tmp_len"]
    // Call BCryptGenRandom(NULL, buf, (u32)len, 0x2)
    // rcx = 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 0))
    // rdx = buf
    _intr_load_x64(ctx, 2, tmp_buf)
    // r8d = len (u32)
    _intr_load_x64(ctx, 8, tmp_len)
    // Fail if len > 0xFFFFFFFF (conservative)
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(9, 4294967295))
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(8, 9))
    var l_len_ok = _new_label(ctx, "sys_getentropy_len_ok")
    _emit_jcc_to_label(ctx, fixups, "be", l_len_ok) // unsigned <=
    // -22 (EINVAL)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967274))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, state["l_done"])
    _emit_label(ctx, labels, l_len_ok)
    // r9d = flags (BCRYPT_USE_SYSTEM_PREFERRED_RNG = 2)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(9, 2))
    // call fp in r11
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], core.insn_call_rax())
    // NTSTATUS in eax: 0 => success
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", state["l_fail"])

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, state["l_done"])
    return nil
}

fn _x64_emit_getentropy_windows_finish(ctx, state) {
    _emit_label(ctx, state["labels"], state["l_fail"])
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967291)) // -EIO
    bytes_extend(ctx["code"], core.insn_cdqe())

    _emit_label(ctx, state["labels"], state["l_done"])
    _patch_local_fixups(ctx, state["labels"], state["fixups"])
    return nil
}

fn _emit_intrinsic_sys_getentropy_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: sys_getentropy expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_getentropy does not support spread"); return nil }

    // Windows: fill entropy using bcrypt!BCryptGenRandom via LoadLibraryA + GetProcAddress.
    //
    // Contract: sys_getentropy(buf, len) returns 0 on success, or -errno.
    // We resolve bcrypt dynamically and cache the function pointer in `.data`.
    var state = _x64_getentropy_windows_init_state(ctx, locals, args)
    if state == nil { return nil }

    _x64_emit_getentropy_windows_guards(ctx, state)
    _x64_emit_getentropy_windows_resolve_fp(ctx, state)
    _x64_emit_getentropy_windows_call_rng(ctx, state)
    _x64_emit_getentropy_windows_finish(ctx, state)

    _intr_tmp_pop(ctx, state["base"])
    return nil
}

fn _x64_dispatch_target_is_windows(ctx) {
    // Prefer ABI-derived detection instead of `ctx["platform"]` so Windows builds remain correct
    // even if the higher-level driver does not thread a platform map into the x64 backend ctx.
    var sh = abi.caller_shadow_bytes(ctx["abi"])
    if sh != nil && sh > 0 { return true }
    return false
}

fn _emit_intrinsic_sys_windows_core_x64(ctx, nm, expr, locals, args) {
    // Some cross-platform syscalls are implemented in the shared syscall module but have a
    // Windows mapping (VirtualAlloc/VirtualFree). Delegate those to the shared dispatcher.
    if nm == "sys_mmap_private_anon" || nm == "sys_munmap" {
        _emit_intrinsic_sys_linux_x64(ctx, nm, expr, locals, args)
        return true
    }
    if nm == "sys_write" { _emit_intrinsic_sys_write_x64(ctx, expr, locals, args); return true }
    if nm == "sys_read" { _emit_intrinsic_sys_read_x64(ctx, expr, locals, args); return true }
    if nm == "sys_open" { _emit_intrinsic_sys_open_windows_x64(ctx, expr, locals, args); return true }
    // FS substrate (rolling, Tier-1): Win32 API shims + capsule gating.
    if nm == "sys_stat" || nm == "sys_lstat" { _emit_intrinsic_sys_stat_windows_x64(ctx, nm, expr, locals, args); return true }
    if nm == "sys_fstat" { _emit_intrinsic_sys_fstat_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_unlink" || nm == "sys_rmdir" { _emit_intrinsic_sys_unlink_or_rmdir_windows_x64(ctx, nm, expr, locals, args); return true }
    if nm == "sys_rename" { _emit_intrinsic_sys_rename_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_mkdir" || nm == "sys_chmod" { _emit_intrinsic_sys_mkdir_or_chmod_windows_x64(ctx, nm, expr, locals, args); return true }
    if nm == "sys_gettid" { _emit_intrinsic_sys_gettid_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_exit" { _emit_intrinsic_sys_exit_x64(ctx, expr, locals, args); return true }
    if nm == "sys_nanosleep" { _emit_intrinsic_sys_nanosleep_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_ulock_wait" { _emit_intrinsic_sys_ulock_wait_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_ulock_wake" { _emit_intrinsic_sys_ulock_wake_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_sched_yield" { _emit_intrinsic_sys_sched_yield_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_gettimeofday" { _emit_intrinsic_sys_gettimeofday_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_qpc_frequency" { _emit_intrinsic_sys_qpc_frequency_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_getentropy" { _emit_intrinsic_sys_getentropy_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_getrandom" { _emit_return_enosys_x64(ctx); return true }
    return false
}

fn _emit_intrinsic_sys_windows_net_bootstrap_x64(ctx, nm, expr, locals, args) {
    if nm == "sys_wsa_startup" { _emit_intrinsic_sys_wsa_startup_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_select" { _emit_intrinsic_sys_select_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_wsa_get_last_error" { _emit_intrinsic_sys_wsa_get_last_error_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_close" { _emit_intrinsic_sys_close_windows_x64(ctx, expr, locals, args); return true }
    return false
}

fn _emit_intrinsic_sys_windows_net_iocp_x64(ctx, nm, expr, locals, args) {
    // IOCP (kernel32) (future Windows netpoll backend; still runtime-gated)
    if nm == "sys_create_io_completion_port" { _emit_intrinsic_sys_create_io_completion_port_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_get_queued_completion_status_ex" { _emit_intrinsic_sys_get_queued_completion_status_ex_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_post_queued_completion_status" { _emit_intrinsic_sys_post_queued_completion_status_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_cancel_io_ex" { _emit_intrinsic_sys_cancel_io_ex_windows_x64(ctx, expr, locals, args); return true }
    return false
}

fn _emit_intrinsic_sys_windows_net_socket_lifecycle_x64(ctx, nm, expr, locals, args) {
    if nm == "sys_socket" { _emit_intrinsic_sys_socket_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_connect" { _emit_intrinsic_sys_connect_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_bind" { _emit_intrinsic_sys_bind_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_listen" { _emit_intrinsic_sys_listen_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_accept" { _emit_intrinsic_sys_accept_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_getsockname" { _emit_intrinsic_sys_getsockname_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_getpeername" { _emit_intrinsic_sys_getpeername_windows_x64(ctx, expr, locals, args); return true }
    return false
}

fn _emit_intrinsic_sys_windows_net_sockopt_x64(ctx, nm, expr, locals, args) {
    if nm == "sys_setsockopt" { _emit_intrinsic_sys_setsockopt_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_getsockopt" { _emit_intrinsic_sys_getsockopt_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_shutdown" { _emit_intrinsic_sys_shutdown_windows_x64(ctx, expr, locals, args); return true }
    return false
}

fn _emit_intrinsic_sys_windows_net_message_x64(ctx, nm, expr, locals, args) {
    if nm == "sys_sendto" { _emit_intrinsic_sys_sendto_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_recvfrom" { _emit_intrinsic_sys_recvfrom_windows_x64(ctx, expr, locals, args); return true }
    return false
}

fn _emit_intrinsic_sys_windows_net_overlapped_x64(ctx, nm, expr, locals, args) {
    // WinSock overlapped I/O (IOCP bring-up)
    if nm == "sys_wsarecv" { _emit_intrinsic_sys_wsarecv_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_wsarecvfrom" { _emit_intrinsic_sys_wsarecvfrom_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_wsasend" { _emit_intrinsic_sys_wsasend_windows_x64(ctx, expr, locals, args); return true }
    return false
}

fn _emit_intrinsic_sys_windows_net_x64(ctx, nm, expr, locals, args) {
    if _emit_intrinsic_sys_windows_net_bootstrap_x64(ctx, nm, expr, locals, args) { return true }
    if _emit_intrinsic_sys_windows_net_iocp_x64(ctx, nm, expr, locals, args) { return true }
    if _emit_intrinsic_sys_windows_net_socket_lifecycle_x64(ctx, nm, expr, locals, args) { return true }
    if _emit_intrinsic_sys_windows_net_sockopt_x64(ctx, nm, expr, locals, args) { return true }
    if _emit_intrinsic_sys_windows_net_message_x64(ctx, nm, expr, locals, args) { return true }
    if _emit_intrinsic_sys_windows_net_overlapped_x64(ctx, nm, expr, locals, args) { return true }
    return false
}

fn _emit_intrinsic_sys_windows_proc_thread_x64(ctx, nm, expr, locals, args) {
    if nm == "sys_win_createprocess" { _emit_intrinsic_sys_win_createprocess_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_win_createthread" { _emit_intrinsic_sys_win_createthread_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_win_wait_single_object" { _emit_intrinsic_sys_win_wait_single_object_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_win_terminate_thread" { _emit_intrinsic_sys_win_terminate_thread_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_win_close_handle" { _emit_intrinsic_sys_win_close_handle_windows_x64(ctx, expr, locals, args); return true }
    // Socket nonblocking (mapped to ioctlsocket(FIONBIO)).
    if nm == "sys_fcntl_getfl" { _emit_intrinsic_sys_fcntl_getfl_windows_x64(ctx, expr, locals, args); return true }
    if nm == "sys_fcntl_setfl" { _emit_intrinsic_sys_fcntl_setfl_windows_x64(ctx, expr, locals, args); return true }
    return false
}

fn _emit_intrinsic_sys_dispatch_x64(ctx, nm, expr, locals, args) {
    if _x64_dispatch_target_is_windows(ctx) {
        if _emit_intrinsic_sys_windows_core_x64(ctx, nm, expr, locals, args) { return nil }
        if _emit_intrinsic_sys_windows_net_x64(ctx, nm, expr, locals, args) { return nil }
        if _emit_intrinsic_sys_windows_proc_thread_x64(ctx, nm, expr, locals, args) { return nil }
        _emit_return_enosys_x64(ctx)
        return nil
    }
    return _emit_intrinsic_sys_linux_x64(ctx, nm, expr, locals, args)
}
