// x64-native Index assignment intrinsic (`oren_index_set`).
//
// Tier‑1 parity notes:
// - arm64 native inlines `xs[i]=v` with a list fast-path + typed map fallback.
// - x64 native historically lowered `xs[i]=v` through the runtime helper `oren_index_set`,
//   which adds overhead and (in older runtime code) could be unsafe if it probed headers
//   on untracked integers.
//
// This module adds an x64 inline lowering for `oren_index_set(container, index, value)`:
// - checks tracked allocation metadata first (never probes untracked pointers)
// - list: bounds-check and store in-bounds
// - map: dispatch to `oren_map_set_{int,str}` (key kind inferred via tracking metadata when needed)
//
// Result:
// - leaves the written value in RAX (matches runtime helper behavior).

fn _emit_call_rel32_3args_x64(ctx, locals, sym, arg0_off, arg1_off, arg2_off) {
    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    var a1_enc = abi.int_arg_reg(ctx["abi"], 1)
    var a2_enc = abi.int_arg_reg(ctx["abi"], 2)
    if oren_type_tag(a0_enc) == 0 || oren_type_tag(a1_enc) == 0 || oren_type_tag(a2_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg regs for call3 " + sym)
        return nil
    }
    var a0 = a0_enc - 1
    var a1 = a1_enc - 1
    var a2 = a2_enc - 1
    _emit_mov_r64_mrbp(ctx, a0, 0 - arg0_off)
    _emit_mov_r64_mrbp(ctx, a1, 0 - arg1_off)
    _emit_mov_r64_mrbp(ctx, a2, 0 - arg2_off)
    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": sym})
    return nil
}

fn _x64_index_set_spill_args(ctx, expr, locals, args) {
    // Spill layout (LTR eval): container, index, value.
    var base0 = _intr_tmp_push(ctx, 3)
    if oren_type_tag(base0) == 0 { return nil }
    var off_cont = _intr_tmp_off(ctx, locals, base0 + 0)
    var off_idx = _intr_tmp_off(ctx, locals, base0 + 1)
    var off_val = _intr_tmp_off(ctx, locals, base0 + 2)
    if oren_type_tag(off_cont) == 0 || oren_type_tag(off_idx) == 0 || oren_type_tag(off_val) == 0 {
        _intr_tmp_pop(ctx, base0)
        return nil
    }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base0); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - off_cont, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base0); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 0)

    _emit_eval_int_to_rax(ctx, args[2], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base0); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - off_val, 0)

    return {"base": base0, "off_cont": off_cont, "off_idx": off_idx, "off_val": off_val}
}

fn _x64_index_set_emit_map_call(ctx, locals, known_kk, off_cont, off_idx, off_val) {
    if known_kk == 0 {
        _emit_call_rel32_3args_x64(ctx, locals, "oren_map_set_int", off_cont, off_idx, off_val)
    } else if known_kk == 1 {
        _emit_call_rel32_3args_x64(ctx, locals, "oren_map_set_str", off_cont, off_idx, off_val)
    } else {
        _emit_call_rel32_3args_x64(ctx, locals, "oren_map_set", off_cont, off_idx, off_val)
    }
    return nil
}

fn _x64_index_set_emit_tracked_guard(ctx, state, label_name, panic_msg) {
    var local_fixups = state["fixups"]
    var labels = state["labels"]
    var l_trk_ok = _new_label(ctx, label_name)
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_trk_ok)
    _emit_abort_panic_str(ctx, panic_msg)
    _emit_label(ctx, labels, l_trk_ok)
    return nil
}

fn _x64_index_set_emit_node_kind_load(ctx) {
    // kind = *(node + 16), where r11 is the tracked-node pointer.
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(10, 10))
    return nil
}

fn _x64_index_set_emit_kind_jump(ctx, state, kind, label_name) {
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, kind))
    _emit_jcc_to_label(ctx, state["fixups"], "e", state[label_name])
    return nil
}

fn _x64_index_set_emit_known_list_dispatch(ctx, state) {
    _x64_index_set_emit_tracked_guard(ctx, state, "idx_set_list_tracked_ok", "index_set recv_kind=list but value is not a list")
    _x64_index_set_emit_node_kind_load(ctx)
    _x64_index_set_emit_kind_jump(ctx, state, 2, "l_is_list") // LIST
    _x64_index_set_emit_kind_jump(ctx, state, 8, "l_is_list") // LIST_INT
    _emit_abort_panic_str(ctx, "index_set recv_kind=list but value is not a list")
    return nil
}

fn _x64_index_set_emit_known_list_int_dispatch(ctx, state) {
    _x64_index_set_emit_tracked_guard(ctx, state, "idx_set_list_int_tracked_ok", "index_set recv_kind=list_int but value is not a list_int")
    _x64_index_set_emit_node_kind_load(ctx)
    _x64_index_set_emit_kind_jump(ctx, state, 8, "l_is_list") // LIST_INT
    _emit_abort_panic_str(ctx, "index_set recv_kind=list_int but value is not a list_int")
    return nil
}

fn _x64_index_set_emit_dynamic_kind_dispatch(ctx, state) {
    _x64_index_set_emit_tracked_guard(ctx, state, "idx_set_tracked_ok", "index_set on non-container (expected list or map)")
    _x64_index_set_emit_node_kind_load(ctx)
    _x64_index_set_emit_kind_jump(ctx, state, 2, "l_is_list")
    _x64_index_set_emit_kind_jump(ctx, state, 8, "l_is_list")
    _x64_index_set_emit_kind_jump(ctx, state, 3, "l_is_map")
    _emit_abort_panic_str(ctx, "index_set on non-container (expected list or map)")
    return nil
}

fn _x64_index_set_emit_recv_kind_dispatch(ctx, state) {
    var recv_kind = state["recv_kind"]
    if recv_kind == "list" { return _x64_index_set_emit_known_list_dispatch(ctx, state) }
    if recv_kind == "list_int" { return _x64_index_set_emit_known_list_int_dispatch(ctx, state) }
    _x64_index_set_emit_dynamic_kind_dispatch(ctx, state)
    return nil
}

fn _x64_index_set_emit_list_path(ctx, locals, state) {
    var recv_kind = state["recv_kind"]
    var local_fixups = state["fixups"]
    var labels = state["labels"]
    var l_is_list = state["l_is_list"]
    var l_done = state["l_done"]

    _emit_label(ctx, labels, l_is_list)
    // Semantics: `xs[i] = v` grows lists as needed (matches C backend + tests).
    // Delegate to the native runtime helper rather than inlining strict in-bounds stores.
    var list_set_sym = "oren_list_set"
    if recv_kind == "list_int" { list_set_sym = "oren_list_int_set" }
    _emit_call_rel32_3args_x64(ctx, locals, list_set_sym, state["off_cont"], state["off_idx"], state["off_val"])
    _emit_jmp_to_label(ctx, local_fixups, l_done)
    return nil
}

fn _x64_index_set_emit_map_path(ctx, locals, state) {
    var local_fixups = state["fixups"]
    var labels = state["labels"]
    var l_is_map = state["l_is_map"]
    var l_done = state["l_done"]

    _emit_label(ctx, labels, l_is_map)
    _x64_index_set_emit_map_call(ctx, locals, state["known_kk"], state["off_cont"], state["off_idx"], state["off_val"])
    _emit_jmp_to_label(ctx, local_fixups, l_done)
    return nil
}

fn _x64_index_set_emit_list_or_map_dispatch(ctx, locals, state) {
    var off_cont = state["off_cont"]
    var labels = state["labels"]
    var local_fixups = state["fixups"]

    // container -> rdx (2)
    _emit_mov_r64_mrbp(ctx, 2, 0 - off_cont)

    // If container is nil, panic deterministically.
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(2, 0))
    var l_non_nil = _new_label(ctx, "idx_set_non_nil")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_non_nil)
    _emit_abort_panic_str(ctx, "index_set on nil")
    _emit_label(ctx, labels, l_non_nil)

    // Tier-1 safety: never read object headers from untracked pointers.
    _emit_find_tracked_node_x64(ctx, 2, 11) // r11 = node or 0
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    _x64_index_set_emit_recv_kind_dispatch(ctx, state)
    _x64_index_set_emit_list_path(ctx, locals, state)
    _x64_index_set_emit_map_path(ctx, locals, state)

    _emit_label(ctx, labels, state["l_done"])
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _x64_index_set_validated_args(ctx, expr, locals) {
    if ctx == nil { return nil }
    if expr == nil { err(ctx, "x64 native v0: missing oren_index_set expr"); return nil }
    if locals == nil { err(ctx, "x64 native v0: oren_index_set requires locals"); return nil }
    if ctx["runtime_injected"] != true {
        // Map fallback requires injected runtime (`oren_map_set_*`), so keep this strict.
        err(ctx, "x64 native v0: oren_index_set requires injected native runtime")
        return nil
    }

    var args = expr["args"]
    if args == nil || oren_list_len(args) != 3 {
        err(ctx, "x64 native v0: oren_index_set expects 3 args")
        return nil
    }
    if expr["spread"] != nil {
        err(ctx, "x64 native v0: oren_index_set does not support spread")
        return nil
    }
    return args
}

fn _x64_index_set_emit_map_only_if_needed(ctx, locals, recv_kind, known_kk, spills) {
    // String-key sets and lowered map sets cannot reach list semantics. The native
    // map set helpers already perform checked map validation, so do not inline that
    // same tracking/kind/magic/panic sequence into every user function body.
    if recv_kind != "map" && known_kk != 1 { return false }
    _x64_index_set_emit_map_call(ctx, locals, known_kk, spills["off_cont"], spills["off_idx"], spills["off_val"])
    return true
}

fn _x64_index_set_emit_generic_if_needed(ctx, locals, recv_kind, spills) {
    // Unknown receiver kinds are lowered to the checked generic runtime helper.
    // Known list/list_int receivers keep the inline list path below; proven maps
    // already use the map-only helpers above.
    if recv_kind == "list" || recv_kind == "list_int" { return false }
    _emit_call_rel32_3args_x64(ctx, locals, "oren_index_set", spills["off_cont"], spills["off_idx"], spills["off_val"])
    return true
}

fn _x64_index_set_inline_state(ctx, recv_kind, known_kk, spills) {
    return {
        "recv_kind": recv_kind,
        "known_kk": known_kk,
        "off_cont": spills["off_cont"],
        "off_idx": spills["off_idx"],
        "off_val": spills["off_val"],
        "labels": {},
        "fixups": [],
        "l_is_list": _new_label(ctx, "idx_set_is_list"),
        "l_is_map": _new_label(ctx, "idx_set_is_map"),
        "l_done": _new_label(ctx, "idx_set_done")
    }
}

fn _emit_index_set_intrinsic_v0_x64(ctx, expr, locals) {
    var args = _x64_index_set_validated_args(ctx, expr, locals)
    if args == nil { return nil }

    var recv_kind = expr["recv_kind"]
    var known_kk = _x64_index_known_key_kind(expr, args[1])

    var spills = _x64_index_set_spill_args(ctx, expr, locals, args)
    if spills == nil { return nil }
    var base0 = spills["base"]

    if _x64_index_set_emit_map_only_if_needed(ctx, locals, recv_kind, known_kk, spills) == true {
        _intr_tmp_pop(ctx, base0)
        return nil
    }

    if _x64_index_set_emit_generic_if_needed(ctx, locals, recv_kind, spills) == true {
        _intr_tmp_pop(ctx, base0)
        return nil
    }

    _x64_index_set_emit_list_or_map_dispatch(ctx, locals, _x64_index_set_inline_state(ctx, recv_kind, known_kk, spills))
    _intr_tmp_pop(ctx, base0)
    return nil
}
