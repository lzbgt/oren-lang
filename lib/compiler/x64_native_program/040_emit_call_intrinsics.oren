fn _emit_eval_iadd_intrinsic_x64(ctx, locals, args) {
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: iadd expects 2 args"); return 1 }
    // iadd(a, b) => (a + b) in RAX. Nested `iadd` calls must not clobber the outer LHS spill.
    var base = _intr_tmp_push(ctx, 1)
    if oren_type_tag(base) == 0 { return 1 }
    var tmp_off_iadd = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(tmp_off_iadd) == 0 {
        _intr_tmp_pop(ctx, base)
        return 1
    }
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return 1 }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_off_iadd, 0)
    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return 1 }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0)) // rdx = rhs
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_off_iadd)      // rax = lhs
    bytes_extend(ctx["code"], core.insn_add_r64_r64(0, 2)) // rax += rdx
    _intr_tmp_pop(ctx, base)
    return 1
}

fn _emit_eval_ptr_load_intrinsic_x64(ctx, nm, locals, args) {
    if nm == "ptr_get" {
        if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: ptr_get expects 1 arg"); return 1 }
        _emit_eval_int_to_rax(ctx, args[0], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
        bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
        return 1
    }
    if nm == "ptr_get_byte" {
        if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: ptr_get_byte expects 1 arg"); return 1 }
        _emit_eval_int_to_rax(ctx, args[0], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
        bytes_extend(ctx["code"], core.insn_movzx_r32_mr8(0, 0))
        return 1
    }
    if nm == "oren_ptr_get_i32_le" {
        if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_ptr_get_i32_le expects 1 arg"); return 1 }
        _emit_eval_int_to_rax(ctx, args[0], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
        bytes_extend(ctx["code"], core.insn_mov_r32_m64_disp(0, 0, 0))
        bytes_extend(ctx["code"], core.insn_movsxd_r64_r32(0, 0))
        return 1
    }
    return 0
}

fn _emit_eval_ptr_store_intrinsic_x64(ctx, nm, locals, args) {
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: " + nm + " expects 2 args"); return 1 }
    // Must not keep `ptr` only in a register across nested expression evaluation.
    var base = _intr_tmp_push(ctx, 1)
    if oren_type_tag(base) == 0 { return 1 }
    var tmp_ptr = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(tmp_ptr) == 0 { _intr_tmp_pop(ctx, base); return 1 }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return 1 }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ptr, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return 1 }

    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_ptr)
    if nm == "ptr_set" {
        bytes_extend(ctx["code"], core.insn_mov_mr64_r64(2, 0)) // [rdx] = rax
    }
    if nm == "ptr_set_byte" {
        bytes_extend(ctx["code"], core.insn_mov_mr8_al(2))
        bytes_extend(ctx["code"], core.insn_and_r64_imm32(0, 255))
    }
    if nm == "oren_ptr_set_i32_le" {
        bytes_extend(ctx["code"], core.insn_mov_mr32_r32_disp(2, 0, 0))
        bytes_extend(ctx["code"], core.insn_movsxd_r64_r32(0, 0))
    }
    _intr_tmp_pop(ctx, base)
    return 1
}

fn _emit_eval_buf_load_u8_unchecked_x64(ctx, locals, args) {
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: oren_buf_load_u8_unchecked expects 2 args"); return 1 }

    var base = _intr_tmp_push(ctx, 1)
    if oren_type_tag(base) == 0 { return 1 }
    var tmp_buf = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(tmp_buf) == 0 { _intr_tmp_pop(ctx, base); return 1 }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return 1 }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_buf, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return 1 }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0))

    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_buf)
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(0, 0, 40))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(0, 2))
    bytes_extend(ctx["code"], core.insn_movzx_r32_mr8(0, 0))

    _intr_tmp_pop(ctx, base)
    return 1
}

fn _emit_eval_pointer_call_intrinsic_x64(ctx, nm, expr, locals, args) {
    if nm == "iadd" { return _emit_eval_iadd_intrinsic_x64(ctx, locals, args) }
    if nm == "ptr_get" || nm == "ptr_get_byte" || nm == "oren_ptr_get_i32_le" {
        return _emit_eval_ptr_load_intrinsic_x64(ctx, nm, locals, args)
    }
    if nm == "ptr_set" || nm == "ptr_set_byte" || nm == "oren_ptr_set_i32_le" {
        return _emit_eval_ptr_store_intrinsic_x64(ctx, nm, locals, args)
    }
    if nm == "oren_buf_load_u8_unchecked" { return _emit_eval_buf_load_u8_unchecked_x64(ctx, locals, args) }
    return 0
}

fn _emit_eval_native_direct_call1_intrinsic_x64(ctx, expr, locals, args) {
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: native_call1 expects 2 args"); return 1 }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: native_call1 does not support spread"); return 1 }

    var base = _intr_tmp_push(ctx, 2) // addr, arg0
    if oren_type_tag(base) == 0 { return 1 }
    var tmp_addr = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_arg0 = _intr_tmp_off(ctx, locals, base + 1)
    if oren_type_tag(tmp_addr) == 0 || oren_type_tag(tmp_arg0) == 0 { _intr_tmp_pop(ctx, base); return 1 }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_addr)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_arg0)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return 1 }

    var arg_regs = nil
    if ctx["abi"] != nil { arg_regs = ctx["abi"]["int_arg_regs"] }
    var reg0 = 7 // fallback: SysV rdi
    if arg_regs != nil && oren_list_len(arg_regs) > 0 { reg0 = arg_regs[0] }
    _intr_load_x64(ctx, reg0, tmp_arg0)

    _intr_load_x64(ctx, 0, tmp_addr)
    bytes_extend(ctx["code"], core.insn_call_rax())
    _intr_tmp_pop(ctx, base)
    return 1
}

fn _x64_native_alloc_expected_args(nm) {
    var want_args = 1
    if nm == "malloc_k" { want_args = 2 }
    return want_args
}

fn _x64_native_alloc_pop_state(ctx, st) {
    if st != nil && oren_type_tag(st["base"]) != 0 { _intr_tmp_pop(ctx, st["base"]) }
    return nil
}

fn _x64_native_alloc_kind_state(ctx, nm, locals, args) {
    if nm != "malloc_k" { return {"base": nil, "tmp_kind": nil} }

    // Preserve kind across the allocator slow path (clobbers R10/R11/RCX).
    var base = _intr_tmp_push(ctx, 1)
    if oren_type_tag(base) == 0 { return nil }
    var tmp_kind = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(tmp_kind) == 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_kind, 0)
    return {"base": base, "tmp_kind": tmp_kind}
}

fn _x64_native_alloc_reuse_mode(nm) {
    if nm == "malloc_raw" { return 0 }
    return 1
}

fn _x64_native_alloc_emit_tracking(ctx, nm, locals, st) {
    if nm == "malloc_raw" { return true }

    var tmp0 = locals["$tmp0"]
    if oren_type_tag(tmp0) == 0 {
        err(ctx, "x64 native v0: missing $tmp0 slot for " + nm + " tracking")
        return false
    }

    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 0))
    _emit_mov_r64_mrbp(ctx, 13, 0 - tmp0)
    if nm == "malloc_k" {
        _emit_mov_r64_mrbp(ctx, 10, 0 - st["tmp_kind"])
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 0))
    }
    if ctx["trace_native_alloc_req"] != nil {
        _emit_trace_alloc_request_x64(ctx, locals, 12, 13, 10)
    }
    _emit_track_alloc_x64(ctx, locals, 12, 13, 10)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 12))
    return true
}

fn _emit_eval_native_alloc_intrinsic_x64(ctx, nm, locals, args) {
    var want_args = _x64_native_alloc_expected_args(nm)
    if args == nil || oren_list_len(args) != want_args { err(ctx, "x64 native v0: " + nm + " expects " + oren_int_to_string(want_args) + " arg(s)"); return 1 }

    var st = _x64_native_alloc_kind_state(ctx, nm, locals, args)
    if st == nil { return 1 }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
        _x64_native_alloc_pop_state(ctx, st)
        return 1
    }

    _emit_malloc_size_in_rax(ctx, locals, _x64_native_alloc_reuse_mode(nm))
    if _x64_native_alloc_emit_tracking(ctx, nm, locals, st) != true { _x64_native_alloc_pop_state(ctx, st); return 1 }
    _x64_native_alloc_pop_state(ctx, st)
    return 1
}

fn _emit_eval_native_panic_intrinsic_x64(ctx, locals, args) {
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_panic expects 1 arg"); return 1 }
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return 1 }
    _emit_panic_with_msg_ptr(ctx, 0)
    return 1
}

fn _emit_eval_native_call_intrinsic_x64(ctx, nm, expr, locals, args) {
    if nm == "atomic_add" { _emit_intrinsic_atomic_add_x64(ctx, expr, locals); return 1 }
    if nm == "atomic_cas" { _emit_intrinsic_atomic_cas_x64(ctx, expr, locals); return 1 }
    if nm == "simd_dot_i32_ptr" { _emit_intrinsic_simd_dot_i32_ptr_x64(ctx, expr, locals); return 1 }
    if nm == "native_call1" { return _emit_eval_native_direct_call1_intrinsic_x64(ctx, expr, locals, args) }
    if nm == "malloc" || nm == "malloc_raw" || nm == "malloc_k" {
        return _emit_eval_native_alloc_intrinsic_x64(ctx, nm, locals, args)
    }
    if nm == "oren_panic" { return _emit_eval_native_panic_intrinsic_x64(ctx, locals, args) }
    return 0
}
