// Map intrinsic helper(s) for x64 native bring-up.
//
// Kept in a dedicated include file to keep `040_emit_expr.oren` under the repo
// style size limit while x64 Tier-1 continues to grow.
//
// Key kinds (rolling x64 v0 limitation):
// - kind=0: integer key
// - kind=1: C-string key pointer
//
// Note: without tagging, x64 v0 cannot safely infer key kinds for *dynamic* keys
// (integers >= 4096 are indistinguishable from pointers). As an incremental step,
// callers may pass a compile-time known key_kind (for literal keys) so integer keys
// >= 4096 work when the compiler knows they're integers. Full fix: tagged values.

// Map intrinsic helper:
// Assumes map/key/value have already been evaluated and spilled at the provided stack slots.
// Returns the map pointer in RAX.
fn _emit_intrinsic_map_set_spilled(ctx, locals, tmp_map, tmp_key, tmp_val, tmp_count, tmp_cap, tmp_buf, tmp_newbuf, known_key_kind) {
    // Initialize optional scratch slot deterministically.
    // `$tmp_newbuf` is used to hold `new_buf` only on the grow path.
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - tmp_newbuf, 0)

    var labels = {}
    var local_fixups = []
    var l_loop = _new_label(ctx, "map_set_loop")
    var l_next = _new_label(ctx, "map_set_next")
    var l_str_loop = _new_label(ctx, "map_set_str_loop")
    var l_str_neq = _new_label(ctx, "map_set_str_neq")
    var l_update = _new_label(ctx, "map_set_update")
    var l_insert = _new_label(ctx, "map_set_insert")
    var l_grow = _new_label(ctx, "map_set_grow")
    var l_copy_loop = _new_label(ctx, "map_set_copy_loop")
    var l_copy_done = _new_label(ctx, "map_set_copy_done")
    var l_done = _new_label(ctx, "map_set_done")

    // rdx = map (must be non-nil)
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_map)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    var l_map_ok = _new_label(ctx, "map_set_map_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_map_ok)
    _emit_abort_exitcode(ctx, 1)
    _emit_label(ctx, labels, l_map_ok)

    // magic check
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1296121168))
    var l_magic_ok = _new_label(ctx, "map_set_magic_ok")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_magic_ok)
    _emit_abort_exitcode(ctx, 1)
    _emit_label(ctx, labels, l_magic_ok)

    // rsi = key
    _emit_mov_r64_mrbp(ctx, 6, 0 - tmp_key)
    // r13 = key_kind (0=int, 1=string)
    var kk = known_key_kind
    if kk == nil { kk = -1 }
    if kk == 0 {
        bytes_extend(ctx["code"], insn_mov_r32_imm32(13, 0))
    } else if kk == 1 {
        bytes_extend(ctx["code"], insn_mov_r32_imm32(13, 1))
    } else {
        // Fallback heuristic for dynamic keys (v0 limitation).
        bytes_extend(ctx["code"], insn_mov_r32_imm32(13, 0))
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(6, 4096))
        var l_kind_done = _new_label(ctx, "map_set_kind_done")
        _emit_jcc_to_label(ctx, local_fixups, "l", l_kind_done)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(13, 1))
        _emit_label(ctx, labels, l_kind_done)
    }

    // r8 = count
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0))
    _emit_mov_mrbp_r64(ctx, 0 - tmp_count, 8)

    // r9 = cap
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))
    _emit_mov_mrbp_r64(ctx, 0 - tmp_cap, 9)

    // r11 = buf
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0))
    _emit_mov_mrbp_r64(ctx, 0 - tmp_buf, 11)

    // Scan existing entries: use r8 as remaining count and r11 as entry_ptr.
    _emit_label(ctx, labels, l_loop)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_insert)

    // rdi = ek = *(entry_ptr)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(7, 0))

    // r12 = ek_kind = *(entry_ptr + 8)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 0))

    // kind mismatch => next
    bytes_extend(ctx["code"], insn_cmp_r64_r64(12, 13))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_next)

    // kind==0 => integer compare, kind==1 => string compare
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(13, 0))
    var l_kind_int = _new_label(ctx, "map_set_kind_int")
    var l_kind_str = _new_label(ctx, "map_set_kind_str")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_kind_int)
    _emit_jmp_to_label(ctx, local_fixups, l_kind_str)

    _emit_label(ctx, labels, l_kind_int)
    bytes_extend(ctx["code"], insn_cmp_r64_r64(7, 6))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_update)
    _emit_jmp_to_label(ctx, local_fixups, l_next)

    _emit_label(ctx, labels, l_kind_str)
    // pointer equality fast-path
    bytes_extend(ctx["code"], insn_cmp_r64_r64(7, 6))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_update)

    // string equality slow path (best-effort)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 0)) // rcx=0
    _emit_label(ctx, labels, l_str_loop)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 7))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 10)) // eax=byte
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 6))
    bytes_extend(ctx["code"], insn_add_r64_r64(12, 1))
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(9, 12)) // r9d=byte
    bytes_extend(ctx["code"], insn_cmp_r32_r32(0, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_str_neq)
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_update)
    bytes_extend(ctx["code"], insn_add_r64_imm32(1, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_str_loop)

    _emit_label(ctx, labels, l_str_neq)
    _emit_label(ctx, labels, l_next)
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 24))
    bytes_extend(ctx["code"], insn_sub_r64_imm32(8, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_loop)

    _emit_label(ctx, labels, l_update)
    // store value @ [entry_ptr+16]
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_val) // rax=value
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    // return map
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_map)
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_insert)
    // If count >= cap => grow.
    _emit_mov_r64_mrbp(ctx, 8, 0 - tmp_count)
    _emit_mov_r64_mrbp(ctx, 9, 0 - tmp_cap)
    bytes_extend(ctx["code"], insn_cmp_r64_r64(8, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_grow)
    _emit_jmp_to_label(ctx, local_fixups, l_copy_done)

    _emit_label(ctx, labels, l_grow)
    // new_cap = cap*2; if new_cap < 4 => 4
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_add_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 4))
    var l_newcap_ge4 = _new_label(ctx, "map_set_newcap_ge4")
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_newcap_ge4)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 4))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_label(ctx, labels, l_newcap_ge4)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_cap, 0)

    // new_buf = malloc(new_cap * 24)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 0))
    bytes_extend(ctx["code"], insn_imul_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    _emit_malloc_size_in_rax(ctx, locals)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_newbuf, 0) // tmp_newbuf = new_buf

    // Copy entries: old buf in tmp_buf, new buf in tmp_newbuf, count in tmp_count.
    _emit_mov_r64_mrbp(ctx, 11, 0 - tmp_buf)    // r11 = old
    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_newbuf) // r12 = new
    _emit_mov_r64_mrbp(ctx, 8, 0 - tmp_count)   // r8 = count
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_copy_done)

    _emit_label(ctx, labels, l_copy_loop)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_copy_done)
    // copy 3 qwords: key, kind, value
    // key
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_mr64_r64(12, 0))
    // kind @ +8
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(13, 12))
    bytes_extend(ctx["code"], insn_add_r64_imm32(13, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(13, 0))
    // value @ +16
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(13, 12))
    bytes_extend(ctx["code"], insn_add_r64_imm32(13, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(13, 0))

    // advance pointers
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 24))
    bytes_extend(ctx["code"], insn_add_r64_imm32(12, 24))
    bytes_extend(ctx["code"], insn_sub_r64_imm32(8, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_copy_loop)

    _emit_label(ctx, labels, l_copy_done)
    // If we grew, update header cap + buf fields and spill tmp_buf.
    // tmp_newbuf may be 0 when no grow; so only update when tmp_newbuf != 0.
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_newbuf)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    var l_no_update = _new_label(ctx, "map_set_no_update")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_no_update)

    // header cap @ +8
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_map) // rdx=map
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_cap) // rax=new_cap
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // header buf @ +16
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_newbuf) // rax=new_buf
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    _emit_mov_mrbp_r64(ctx, 0 - tmp_buf, 0)

    _emit_label(ctx, labels, l_no_update)

    // Insert new entry at buf + count*24
    _emit_mov_r64_mrbp(ctx, 11, 0 - tmp_buf)   // r11 = buf
    _emit_mov_r64_mrbp(ctx, 8, 0 - tmp_count)  // r8 = count
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 8))
    bytes_extend(ctx["code"], insn_imul_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_add_r64_r64(11, 10)) // entry_ptr

    // store key
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_key)
    bytes_extend(ctx["code"], insn_mov_mr64_r64(11, 0))
    // store kind at +8
    _emit_mov_r64_mrbp(ctx, 6, 0 - tmp_key) // rsi = key
    // rax = kind (0=int, 1=string)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(6, 4096))
    var l_store_kind_done = _new_label(ctx, "map_set_store_kind_done")
    _emit_jcc_to_label(ctx, local_fixups, "l", l_store_kind_done)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_label(ctx, labels, l_store_kind_done)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))
    // store value at +16
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_val)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // count++ and store back at [map+0]
    _emit_mov_r64_mrbp(ctx, 8, 0 - tmp_count)
    bytes_extend(ctx["code"], insn_add_r64_imm32(8, 1))
    _emit_mov_mrbp_r64(ctx, 0 - tmp_count, 8)
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_map)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(2, 0))

    // return map
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_map)
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}
