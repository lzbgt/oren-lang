        return nil
    }
    return {"base": base34, "epfd": b0, "events": b1, "maxevents": b2, "timeout": b3, "sigmask": b4, "sigsetsize": b5}
}

fn _x64_linux_epoll_pwait_eval_args(ctx, locals, args, st) {
    _intr_eval_spill_x64(ctx, locals, args[0], st["epfd"])
