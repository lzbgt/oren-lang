    if _x64_linux_epoll_pwait_eval_args(ctx, locals, args, st) != true { _intr_tmp_pop(ctx, st["base"]); return true }

    _x64_linux_epoll_pwait_emit_pre(ctx, st, capsule)
    _x64_linux_epoll_pwait_emit_syscall(ctx, st)

    _intr_tmp_pop(ctx, st["base"])
    return true
}

fn _emit_intrinsic_sys_linux_epoll_x64(ctx, nm, expr, locals, args, capsule) {
    if nm == "sys_epoll_create1" { return _emit_intrinsic_sys_linux_epoll_create1_x64(ctx, expr, locals, args, capsule) }
    if nm == "sys_epoll_ctl" { return _emit_intrinsic_sys_linux_epoll_ctl_x64(ctx, expr, locals, args, capsule) }
    if nm == "sys_epoll_pwait" { return _emit_intrinsic_sys_linux_epoll_pwait_x64(ctx, expr, locals, args, capsule) }
    return false
}

