    if capsule { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_epoll_ctl_pre") }

    _intr_load_x64(ctx, 7, a0)
    _intr_load_x64(ctx, 6, a1)
    _intr_load_x64(ctx, 2, a2)
    _intr_load_x64(ctx, 10, a3) // arg4
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_epoll_ctl()))
    bytes_extend(ctx["code"], core.insn_syscall())

    _intr_tmp_pop(ctx, base33)
    return true
