    _intr_eval_spill_x64(ctx, locals, args[0], a0)
    _intr_eval_spill_x64(ctx, locals, args[1], a1)
    _intr_eval_spill_x64(ctx, locals, args[2], a2)
    _intr_eval_spill_x64(ctx, locals, args[3], a3)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base33); return true }

    // pre: native_capsule_sys_epoll_ctl_pre(epfd, op, fd, event_ptr)
    _intr_load_x64(ctx, 7, a0)
    _intr_load_x64(ctx, 6, a1)
