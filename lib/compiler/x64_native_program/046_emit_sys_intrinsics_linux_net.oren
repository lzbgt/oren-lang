    }
    return nil
}

fn _x64_linux_net_fd2_syscall_num(nm) {
    if nm == "sys_listen" { return labi.linux_sys_listen() }
    return labi.linux_sys_shutdown()
}

fn _x64_linux_net_fd2_emit_syscall(ctx, nm, st) {
