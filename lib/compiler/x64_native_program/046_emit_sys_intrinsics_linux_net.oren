    _intr_load_x64(ctx, 6, st["arg"])
    return nil
}

fn _x64_linux_net_fd2_emit_pre(ctx, nm, st, capsule) {
    if !capsule { return nil }
    _x64_linux_net_fd2_load(ctx, st)
