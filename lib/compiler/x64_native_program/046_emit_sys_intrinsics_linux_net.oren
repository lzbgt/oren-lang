fn _emit_intrinsic_sys_linux_epoll_x64(ctx, nm, expr, locals, args, capsule) {
    if nm == "sys_epoll_create1" { return _emit_intrinsic_sys_linux_epoll_create1_x64(ctx, expr, locals, args, capsule) }
    if nm == "sys_epoll_ctl" { return _emit_intrinsic_sys_linux_epoll_ctl_x64(ctx, expr, locals, args, capsule) }
    if nm == "sys_epoll_pwait" { return _emit_intrinsic_sys_linux_epoll_pwait_x64(ctx, expr, locals, args, capsule) }
    return false
}

fn _emit_intrinsic_sys_linux_net_fd2_x64(ctx, nm, expr, locals, args, capsule) {
    if nm != "sys_listen" && nm != "sys_shutdown" { return false }
    if oren_list_len(args) != 2 { err(ctx, "x64 native v0: " + nm + " expects 2 args"); return true }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: " + nm + " does not support spread"); return true }

    var base28 = _intr_tmp_push(ctx, 2) // fd, arg
    if oren_type_tag(base28) == 0 { return true }
    var tmp_fd = _intr_tmp_off(ctx, locals, base28 + 0)
    var tmp_arg = _intr_tmp_off(ctx, locals, base28 + 1)
    if oren_type_tag(tmp_fd) == 0 || oren_type_tag(tmp_arg) == 0 { _intr_tmp_pop(ctx, base28); return true }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_fd)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_arg)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base28); return true }

    if nm == "sys_listen" {
        if capsule {
            _intr_load_x64(ctx, 7, tmp_fd)
            _intr_load_x64(ctx, 6, tmp_arg)
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_listen_pre")
        }

        _intr_load_x64(ctx, 7, tmp_fd)
        _intr_load_x64(ctx, 6, tmp_arg)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_listen()))
        bytes_extend(ctx["code"], core.insn_syscall())

        if capsule {
            bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 0)) // rc
            _intr_load_x64(ctx, 6, tmp_fd)
            _intr_load_x64(ctx, 2, tmp_arg)
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_listen_post")
        }
    } else {
        if capsule {
            _intr_load_x64(ctx, 7, tmp_fd)
            _intr_load_x64(ctx, 6, tmp_arg)
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_shutdown_pre")
        }

        _intr_load_x64(ctx, 7, tmp_fd)
        _intr_load_x64(ctx, 6, tmp_arg)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_shutdown()))
        bytes_extend(ctx["code"], core.insn_syscall())
    }

    _intr_tmp_pop(ctx, base28)
    return true
}

