fn _x64_linux_epoll_pwait_emit_syscall(ctx, st) {
    _intr_load_x64(ctx, 7, st["epfd"])
    _intr_load_x64(ctx, 6, st["events"])
    _intr_load_x64(ctx, 2, st["maxevents"])
