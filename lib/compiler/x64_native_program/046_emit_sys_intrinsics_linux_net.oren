    _intr_load_x64(ctx, 8, st["sigmask"])  // sigmask_ptr
    _intr_load_x64(ctx, 9, st["sigsetsize"])  // sigsetsize
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_epoll_pwait()))
    bytes_extend(ctx["code"], core.insn_syscall())
    return nil
}

fn _emit_intrinsic_sys_linux_epoll_pwait_x64(ctx, expr, locals, args, capsule) {
    if oren_list_len(args) != 6 { err(ctx, "x64 native v0: sys_epoll_pwait expects 6 args"); return true }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_epoll_pwait does not support spread"); return true }

    var st = _x64_linux_epoll_pwait_state(ctx, locals)
