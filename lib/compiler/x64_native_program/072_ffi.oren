// Tier‑1 FFI support (x86_64 native backend).
//
// Rolling contract (see docs/LANGUAGE.md "ffi"):
// - `ffi name` declares an external symbol.
// - Calls pass raw 64-bit values in the platform ABI.
// - Strings are NUL-terminated cstr0 pointers.
//
// Current status:
// - Windows x64 (PE): supports FFI via lazy LoadLibraryA/GetProcAddress stubs.
// - Linux x86_64 (ELF): supported when `--link` is used (dynamic ELF + dlsym resolver); without `--link`,
//   unresolved `ffi` symbols still panic (stable failure mode).

fn _x64_str_eq_bytes(a, b) {
    // Stable string equality for compiler passes.
    // Avoid depending on runtime `==` semantics (stage1 C runtime vs stage2 native runtime).
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _x64_lit_string(v) {
    if v == nil { return nil }
    if v["type"] != "String" { return nil }
    return v["value"]
}

fn _x64_ffi_link_name(ctx, nm) {
    // External symbol name used for resolution (dlsym/GetProcAddress).
    if ctx != nil && ctx["ffi_link_names"] != nil {
        var v = ctx["ffi_link_names"][nm]
        if v != nil && v != "" { return v }
    }
    return nm
}

fn _x64_ffi_panic_msg(ctx, nm) {
    // Prefer the external symbol name in diagnostics; include the internal label when it differs.
    var sym = _x64_ffi_link_name(ctx, nm)
    if sym != nil && sym != "" && sym != nm {
        return "ffi unresolved: " + sym + " (as " + nm + ")"
    }
    return "ffi unresolved: " + nm
}

fn _x64_collect_ffi_dll_attrs(ctx, st, nm) {
    if ctx == nil || st == nil { return nil }
    var attrs = st["attrs"]
    if attrs == nil { return nil }

    if ctx["ffi_dlls_seen"] == nil { ctx["ffi_dlls_seen"] = {} }
    if ctx["ffi_dlls"] == nil { ctx["ffi_dlls"] = [] }
    var seen = ctx["ffi_dlls_seen"]
    var out = ctx["ffi_dlls"]

    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a == nil || a["type"] != "Attr" { i = i + 1; continue }
        if !_x64_str_eq_bytes(a["name"], "ffi.dll") { i = i + 1; continue }

        var args = a["args"]
        if args == nil || oren_list_len(args) != 1 || args[0] == nil {
            err(ctx, "x64 native v0: @" + "ffi.dll" + " on ffi " + nm + " must have exactly 1 string arg")
            return nil
        }
        var val = _x64_lit_string(args[0]["value"])
        if val == nil || val == "" {
            err(ctx, "x64 native v0: @" + "ffi.dll" + " on ffi " + nm + " must be a string literal")
            return nil
        }
        if seen[val] == nil {
            seen[val] = true
            oren_list_push(out, val)
        }
        i = i + 1
    }
    return nil
}

fn _x64_collect_ffi_ret_attrs(ctx, st, nm) {
    if ctx == nil || st == nil { return nil }
    var attrs = st["attrs"]
    if attrs == nil { return nil }

    if ctx["ffi_ret_i32"] == nil { ctx["ffi_ret_i32"] = {} }
    if ctx["ffi_ret_u32"] == nil { ctx["ffi_ret_u32"] = {} }
    if ctx["ffi_ret_void"] == nil { ctx["ffi_ret_void"] = {} }
    // Pointer/usize return kinds are 64-bit on Tier‑1 (arm64/x64), so they do not require
    // register normalization today. Still, accept them as explicit ABI metadata so:
    // - bindings can be self-documenting (`strlen` returns size_t),
    // - future 32-bit targets can lower `usize`/`ptr` correctly (zero/sign extension decisions),
    // - duplicate/contradicting `@ffi.ret(...)` annotations remain detectable.
    if ctx["ffi_ret_ptr"] == nil { ctx["ffi_ret_ptr"] = {} }
    if ctx["ffi_ret_usize"] == nil { ctx["ffi_ret_usize"] = {} }

    var i = 0
    while i < oren_list_len(attrs) {
        var a = attrs[i]
        if a == nil || a["type"] != "Attr" { i = i + 1; continue }
        if !_x64_str_eq_bytes(a["name"], "ffi.ret") { i = i + 1; continue }

        var args = a["args"]
        if args == nil || oren_list_len(args) != 1 || args[0] == nil {
            err(ctx, "x64 native v0: @" + "ffi.ret" + " on ffi " + nm + " must have exactly 1 string arg")
            return nil
        }
        var val = _x64_lit_string(args[0]["value"])
        if val == nil || val == "" {
            err(ctx, "x64 native v0: @" + "ffi.ret" + " on ffi " + nm + " must be a string literal")
            return nil
        }
        // Accept exactly one return-kind attribute per symbol.
        if ctx["ffi_ret_i32"][nm] != nil || ctx["ffi_ret_u32"][nm] != nil || ctx["ffi_ret_void"][nm] != nil ||
           ctx["ffi_ret_ptr"][nm] != nil || ctx["ffi_ret_usize"][nm] != nil {
            err(ctx, "x64 native v0: @" + "ffi.ret" + " on ffi " + nm + " is duplicated (only one kind allowed)")
            return nil
        }
        if _x64_str_eq_bytes(val, "i32") {
            ctx["ffi_ret_i32"][nm] = true
        } else if _x64_str_eq_bytes(val, "u32") {
            ctx["ffi_ret_u32"][nm] = true
        } else if _x64_str_eq_bytes(val, "void") {
            ctx["ffi_ret_void"][nm] = true
        } else if _x64_str_eq_bytes(val, "ptr") {
            ctx["ffi_ret_ptr"][nm] = true
        } else if _x64_str_eq_bytes(val, "usize") {
            ctx["ffi_ret_usize"][nm] = true
        } else {
            err(ctx, "x64 native v0: @" + "ffi.ret" + " on ffi " + nm + " supports \"i32\", \"u32\", \"void\", \"ptr\", or \"usize\" (got \"" + val + "\")")
            return nil
        }
        i = i + 1
    }
    return nil
}

fn _x64_collect_ffi_decls_from_stmt_list(ctx, stmts, role) {
    if ctx == nil { return nil }
    if stmts == nil { return nil }

    if ctx["imports"] == nil { ctx["imports"] = {} }
    if ctx["import_list"] == nil { ctx["import_list"] = [] }
    var imports = ctx["imports"]
    var import_list = ctx["import_list"]
    if ctx["ffi_link_names"] == nil { ctx["ffi_link_names"] = {} }
    var ffi_link_names = ctx["ffi_link_names"]

    var declared = ctx["declared_functions"]
    if declared == nil { declared = {}; ctx["declared_functions"] = declared }

    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st == nil || st["type"] != "FFI" { i = i + 1; continue }

        var name_node = st["name"]
        if name_node == nil || name_node["type"] != "Identifier" {
            err(ctx, "x64 native v0: " + role + " ffi name must be identifier")
            return nil
        }
        var nm = name_node["value"]
        if nm == nil || nm == "" {
            err(ctx, "x64 native v0: " + role + " ffi name is empty")
            return nil
        }
        if nm == "__top_level__" {
            err(ctx, "x64 native v0: reserved ffi name __top_level__")
            return nil
        }
        if imports[nm] != nil {
            err(ctx, "x64 native v0: duplicate ffi declaration " + nm)
            return nil
        }
        if declared[nm] != nil {
            err(ctx, "x64 native v0: duplicate top-level name " + nm)
            return nil
        }

        // External symbol lookup name (stable across module renaming).
        var sym = st["link_name"]
        if sym == nil || sym == "" { sym = nm }
        ffi_link_names[nm] = sym

        imports[nm] = true
        declared[nm] = true // reserve the name so globals can't shadow it
        oren_list_push(import_list, nm)
        _x64_collect_ffi_dll_attrs(ctx, st, nm)
        _x64_collect_ffi_ret_attrs(ctx, st, nm)
        i = i + 1
    }
    return true
}

fn _x64_collect_ffi_decls(ctx, runtime_stmts, user_stmts) {
    if ctx == nil { return nil }
    if runtime_stmts == nil { runtime_stmts = [] }
    if user_stmts == nil { user_stmts = [] }
    _x64_collect_ffi_decls_from_stmt_list(ctx, runtime_stmts, "runtime")
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _x64_collect_ffi_decls_from_stmt_list(ctx, user_stmts, "user")
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    return true
}

fn _x64_ffi_push_unique(out, seen, s) {
    if s == nil || s == "" { return nil }
    if seen[s] != nil { return nil }
    seen[s] = true
    oren_list_push(out, s)
    return nil
}

fn _x64_ffi_windows_dlls(ctx, platform) {
    // Order (rolling):
    // - user `--link` DLLs first
    // - then any per-FFI `@ffi.dll("...")` declarations
    // - then a built-in kernel32 fallback so `ffi GetCurrentThreadId` works without `--link`
    var out = []
    var seen = {}

    if platform != nil && platform["link_libs"] != nil {
        var xs = platform["link_libs"]
        var i = 0
        while i < oren_list_len(xs) {
            _x64_ffi_push_unique(out, seen, xs[i])
            i = i + 1
        }
    }

    if ctx != nil && ctx["ffi_dlls"] != nil {
        var ys = ctx["ffi_dlls"]
        var j = 0
        while j < oren_list_len(ys) {
            _x64_ffi_push_unique(out, seen, ys[j])
            j = j + 1
        }
    }

    _x64_ffi_push_unique(out, seen, "kernel32.dll")
    return out
}

fn _x64_emit_call_iat_rax(ctx, iat_label) {
    // mov rax, [rip+disp32] (IAT slot) ; call rax
    var mov_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_pos + 3, iat_label)
    bytes_extend(ctx["code"], insn_call_rax())
    return nil
}

fn _x64_emit_ffi_resolver_win64(ctx, platform, dlls) {
    // fn __oren_ffi_resolve0(sym_ptr) -> fn_ptr (0 if unresolved)
    //
    // ABI: Win64 int args in rcx,rdx,r8,r9; return in rax.
    // - sym_ptr is a cstr0 pointer.
    //
    // Implementation:
    // - preserves r12 (callee-saved) while using it to hold sym_ptr
    // - allocates 32B shadow for each WinAPI call
    var name = "__oren_ffi_resolve0"
    if ctx == nil { return nil }
    if ctx["functions"] == nil { ctx["functions"] = {} }
    if ctx["functions"][name] != nil { return name }

    var start = bytes_len(ctx["code"])
    ctx["functions"][name] = start

    // push r12
    bytes_push(ctx["code"], 65) // REX.B
    bytes_push(ctx["code"], 84) // PUSH r12
    // r12 = rcx (sym_ptr)
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 1))
    // sub rsp, 0x20 (shadow space for LoadLibraryA/GetProcAddress)
    bytes_extend(ctx["code"], insn_sub_rsp_imm32(32))

    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "ffi_resolve_done")

    var i = 0
    while i < oren_list_len(dlls) {
        var dll = dlls[i]
        if dll == nil || dll == "" { i = i + 1; continue }

        // rcx = &dll_cstr0
        var dll_off = _data_add_cstr0(ctx, dll)
        var lea_dll = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(1, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_dll + 3, "data_off": dll_off})

        _x64_emit_call_iat_rax(ctx, "IAT_LoadLibraryA")

        // if rax == 0: continue
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
        var l_skip = _new_label(ctx, "ffi_resolve_skip")
        _emit_jcc_to_label(ctx, local_fixups, "e", l_skip)

        // rcx = hmodule (rax)
        bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0))
        // rdx = sym_ptr (r12)
        bytes_extend(ctx["code"], insn_mov_r64_r64(2, 12))
        _x64_emit_call_iat_rax(ctx, "IAT_GetProcAddress")

        // if rax != 0: done
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_done)

        _emit_label(ctx, labels, l_skip)
        i = i + 1
    }

    // unresolved => rax=0
    bytes_extend(ctx["code"], insn_mov_r64_imm64(0, 0))

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)

    // add rsp, 0x20
    bytes_extend(ctx["code"], insn_add_rsp_imm32(32))
    // pop r12
    bytes_push(ctx["code"], 65) // REX.B
    bytes_push(ctx["code"], 92) // POP r12
    bytes_extend(ctx["code"], insn_ret())
    return name
}

fn _x64_emit_ffi_stub_linux(ctx, nm) {
    // Linux x64: unresolved imports are stubbed today (docs/COMPILER_BACKENDS.md).
    // Emit: call oren_panic("ffi unresolved: <name>") (does not return)
    if ctx == nil { return nil }
    if nm == nil || nm == "" { return nil }
    if ctx["functions"] == nil { ctx["functions"] = {} }
    if ctx["functions"][nm] != nil { return nil }

    // data: error message (cstr0)
    var msg_off = _data_add_cstr0(ctx, _x64_ffi_panic_msg(ctx, nm))

    ctx["functions"][nm] = bytes_len(ctx["code"])
    // Ensure 16-byte alignment before calling a SysV function (rsp is 8 mod 16 at entry).
    bytes_extend(ctx["code"], insn_sub_rsp_imm32(8))
    // rdi = &msg_cstr0
    var lea_msg = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(7, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_msg + 3, "data_off": msg_off})
    var call_panic = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_panic, "name": "oren_panic"})
    bytes_extend(ctx["code"], insn_add_rsp_imm32(8))
    // Fallback: return 0 if panic returns (should not happen).
    bytes_extend(ctx["code"], insn_mov_r64_imm64(0, 0))
    bytes_extend(ctx["code"], insn_ret())
    return nil
}

fn _x64_linux_dyn_import_got_off(ctx, sym_name) {
    // Reserve (or reuse) a GOT slot for an ELF dynamic import.
    //
    // The ELF emitter uses `ctx["elf_dyn_imports"]` to build:
    // - DT_NEEDED (from `--link`)
    // - DT_STRTAB/DT_SYMTAB
    // - .rela.dyn with R_X86_64_GLOB_DAT relocations that populate these slots at load time
    //
    // Return the byte offset in the appended data blob.
    if ctx == nil { return nil }
    if sym_name == nil || sym_name == "" { return nil }

    if ctx["elf_dyn_got_offs_enc"] == nil { ctx["elf_dyn_got_offs_enc"] = {} }
    var m = ctx["elf_dyn_got_offs_enc"]
    var existing_enc = m[sym_name]
    if oren_type_tag(existing_enc) == 1 {
        if existing_enc > 0 { return existing_enc - 1 }
    }

    var got_off = _data_add_u64(ctx, 0)
    // Store as off+1 so a real offset 0 doesn't alias native-runtime `nil`.
    m[sym_name] = got_off + 1

    if ctx["elf_dyn_imports"] == nil { ctx["elf_dyn_imports"] = [] }
    oren_list_push(ctx["elf_dyn_imports"], {"name": sym_name, "got_off": got_off})
    return got_off
}

fn _x64_emit_call_got_rax_linux(ctx, got_off) {
    // mov rax, [rip+disp32] ; call rax
    if ctx == nil { return nil }
    if got_off == nil { return nil }
    var mov_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_mov_rax", "pos": mov_pos + 3, "data_off": got_off})
    bytes_extend(ctx["code"], insn_call_rax())
    return nil
}

fn _x64_emit_ffi_resolver_linux64(ctx, platform) {
    // fn __oren_ffi_resolve0(sym_ptr) -> fn_ptr (0 if unresolved)
    //
    // ABI: SysV int args in rdi,rsi,rdx,rcx,r8,r9; return in rax.
    // - sym_ptr is a cstr0 pointer.
    //
    // Implementation:
    // - calls `dlsym(RTLD_DEFAULT, sym_ptr)` via a GOT slot relocated by the ELF dynamic loader.
    //
    // Note: This resolver is only emitted when `--link` is used (so the ELF emitter will include
    // PT_INTERP/PT_DYNAMIC and DT_NEEDED for libdl+libc).
    var name = "__oren_ffi_resolve0"
    if ctx == nil { return nil }
    if ctx["functions"] == nil { ctx["functions"] = {} }
    if ctx["functions"][name] != nil { return name }

    // Reserve GOT slot for dlsym.
    var got_dlsym = _x64_linux_dyn_import_got_off(ctx, "dlsym")
    if got_dlsym == nil {
        err(ctx, "x64 native v0: internal: failed to reserve GOT slot for dlsym")
        return nil
    }

    var start = bytes_len(ctx["code"])
    ctx["functions"][name] = start

    // SysV: stack is 8 mod 16 at entry; align to 16 before calling dlsym.
    bytes_extend(ctx["code"], insn_sub_rsp_imm32(8))

    // rsi = sym_ptr (incoming rdi)
    bytes_extend(ctx["code"], insn_mov_r64_r64(6, 7))
    // rdi = RTLD_DEFAULT (NULL)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 0)) // edi=0

    _x64_emit_call_got_rax_linux(ctx, got_dlsym)

    bytes_extend(ctx["code"], insn_add_rsp_imm32(8))
    bytes_extend(ctx["code"], insn_ret())
    return name
}

fn _x64_emit_ffi_stub_linux_dyn(ctx, nm, resolver_name) {
    // Linux x64: lazy resolve `nm` on first call, cache fnptr in `.data`, then tailcall.
    if ctx == nil { return nil }
    if nm == nil || nm == "" { return nil }
    if resolver_name == nil || resolver_name == "" {
        err(ctx, "x64 native v0: internal: missing ffi resolver name")
        return nil
    }

    if ctx["functions"] == nil { ctx["functions"] = {} }
    if ctx["functions"][nm] != nil { return nil }

    var sym = _x64_ffi_link_name(ctx, nm)
    // data: fnptr cell (u64)
    var cell_off = _data_add_u64(ctx, 0)
    // data: symbol name string (cstr0)
    var sym_off = _data_add_cstr0(ctx, sym)
    // data: error message (cstr0)
    var msg_off = _data_add_cstr0(ctx, _x64_ffi_panic_msg(ctx, nm))

    ctx["functions"][nm] = bytes_len(ctx["code"])

    // lea r10, [&cell]
    var lea_cell0 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_cell0 + 3, "data_off": cell_off})
    // rax = [r10]
    bytes_extend(ctx["code"], insn_mov_r64_mr64(0, 10))

    var labels = {}
    var local_fixups = []
    var l_have = _new_label(ctx, "ffi_have")
    var l_fail = _new_label(ctx, "ffi_fail")

    // if rax != 0 => tailcall immediately (args still in regs/stack).
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_have)

    // Spill incoming SysV arg regs (rdi,rsi,rdx,rcx,r8,r9) to the stack.
    // entry rsp is 8 mod 16; sub 56 makes it 0 mod 16.
    bytes_extend(ctx["code"], insn_sub_rsp_imm32(56))
    _emit_mov_mrsp_r64(ctx, 0, 7)   // rdi
    _emit_mov_mrsp_r64(ctx, 8, 6)   // rsi
    _emit_mov_mrsp_r64(ctx, 16, 2)  // rdx
    _emit_mov_mrsp_r64(ctx, 24, 1)  // rcx
    _emit_mov_mrsp_r64(ctx, 32, 8)  // r8
    _emit_mov_mrsp_r64(ctx, 40, 9)  // r9

    // rdi = &sym_cstr0
    var lea_sym = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(7, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_sym + 3, "data_off": sym_off})

    var call_res = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_res, "name": resolver_name})

    // if rax == 0 => panic (unresolved)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_fail)

    // Cache fnptr in cell.
    var lea_cell1 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_cell1 + 3, "data_off": cell_off})
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // Restore arg regs.
    _emit_mov_r64_mrsp(ctx, 7, 0)
    _emit_mov_r64_mrsp(ctx, 6, 8)
    _emit_mov_r64_mrsp(ctx, 2, 16)
    _emit_mov_r64_mrsp(ctx, 1, 24)
    _emit_mov_r64_mrsp(ctx, 8, 32)
    _emit_mov_r64_mrsp(ctx, 9, 40)
    bytes_extend(ctx["code"], insn_add_rsp_imm32(56))

    _emit_label(ctx, labels, l_have)
    // Tailcall to target: jmp rax
    bytes_extend(ctx["code"], insn_jmp_rax())

    _emit_label(ctx, labels, l_fail)
    // call oren_panic("ffi unresolved: <name>") (does not return)
    // Stack is still aligned (rsp 0 mod 16).
    var lea_msg = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(7, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_msg + 3, "data_off": msg_off})
    var call_panic = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_panic, "name": "oren_panic"})
    // If panic returns (should not), restore stack and return 0.
    bytes_extend(ctx["code"], insn_mov_r64_imm64(0, 0))
    bytes_extend(ctx["code"], insn_add_rsp_imm32(56))
    bytes_extend(ctx["code"], insn_ret())

    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _x64_emit_ffi_stub_win64(ctx, nm, resolver_name) {
    // Windows x64: lazy resolve `nm` on first call, cache fnptr in `.data`, then tailcall.
    if ctx == nil { return nil }
    if nm == nil || nm == "" { return nil }
    if resolver_name == nil || resolver_name == "" {
        err(ctx, "x64 native v0: internal: missing ffi resolver name")
        return nil
    }

    if ctx["functions"] == nil { ctx["functions"] = {} }
    if ctx["functions"][nm] != nil { return nil }

    var sym = _x64_ffi_link_name(ctx, nm)
    // data: fnptr cell (u64)
    var cell_off = _data_add_u64(ctx, 0)
    // data: symbol name string (cstr0)
    var sym_off = _data_add_cstr0(ctx, sym)
    // data: error message (cstr0)
    var msg_off = _data_add_cstr0(ctx, _x64_ffi_panic_msg(ctx, nm))

    ctx["functions"][nm] = bytes_len(ctx["code"])

    // lea r10, [&cell]
    var lea_cell0 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_cell0 + 3, "data_off": cell_off})
    // rax = [r10]
    bytes_extend(ctx["code"], insn_mov_r64_mr64(0, 10))

    var labels = {}
    var local_fixups = []
    var l_have = _new_label(ctx, "ffi_have")
    var l_fail = _new_label(ctx, "ffi_fail")

    // if rax != 0 => tailcall immediately (args still in regs/stack).
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_have)

    // Spill incoming arg regs into the caller-provided shadow space (Windows ABI):
    //   [rsp+0x08..0x27] is reserved for this call.
    _emit_mov_mrsp_r64(ctx, 8, 1)   // rcx
    _emit_mov_mrsp_r64(ctx, 16, 2)  // rdx
    _emit_mov_mrsp_r64(ctx, 24, 8)  // r8
    _emit_mov_mrsp_r64(ctx, 32, 9)  // r9

    // Call resolver with proper alignment + shadow:
    // entry rsp is 8 mod 16, so sub 0x28 makes it 0 mod 16.
    bytes_extend(ctx["code"], insn_sub_rsp_imm32(40))
    // rcx = &sym_cstr0
    var lea_sym = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(1, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_sym + 3, "data_off": sym_off})
    var call_res = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_res, "name": resolver_name})
    bytes_extend(ctx["code"], insn_add_rsp_imm32(40))

    // if rax == 0 => panic (unresolved)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_fail)

    // Cache fnptr in cell.
    var lea_cell1 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_cell1 + 3, "data_off": cell_off})
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // Restore arg regs.
    _emit_mov_r64_mrsp(ctx, 1, 8)
    _emit_mov_r64_mrsp(ctx, 2, 16)
    _emit_mov_r64_mrsp(ctx, 8, 24)
    _emit_mov_r64_mrsp(ctx, 9, 32)

    _emit_label(ctx, labels, l_have)
    // Tailcall to target: jmp rax
    bytes_extend(ctx["code"], insn_jmp_rax())

    _emit_label(ctx, labels, l_fail)
    // call oren_panic("ffi unresolved: <name>") (does not return)
    bytes_extend(ctx["code"], insn_sub_rsp_imm32(40))
    var lea_msg = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(1, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_msg + 3, "data_off": msg_off})
    var call_panic = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_panic, "name": "oren_panic"})
    bytes_extend(ctx["code"], insn_add_rsp_imm32(40))
    // Fallback: return 0 if panic returns (should not happen).
    bytes_extend(ctx["code"], insn_mov_r64_imm64(0, 0))
    bytes_extend(ctx["code"], insn_ret())

    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _x64_emit_ffi_stubs(ctx, platform) {
    if ctx == nil { return nil }
    var imports = ctx["import_list"]
    if imports == nil || oren_list_len(imports) == 0 { return nil }

    var os = nil
    if platform != nil { os = platform["os"] }

    if os == "windows" {
        var dlls = _x64_ffi_windows_dlls(ctx, platform)
        var resolver_name = _x64_emit_ffi_resolver_win64(ctx, platform, dlls)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        var i = 0
        while i < oren_list_len(imports) {
            _x64_emit_ffi_stub_win64(ctx, imports[i], resolver_name)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            i = i + 1
        }
        return nil
    }

    // Linux x64:
    // - without `--link`: stub unresolved imports (stable panic-on-call behavior)
    // - with `--link`: emit a dynamic-link-aware resolver + lazy stubs
    if os == "linux" {
        var dyn = platform != nil && platform["link_libs"] != nil && oren_list_len(platform["link_libs"]) != 0
        if dyn {
            var resolver_name = _x64_emit_ffi_resolver_linux64(ctx, platform)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            var i = 0
            while i < oren_list_len(imports) {
                _x64_emit_ffi_stub_linux_dyn(ctx, imports[i], resolver_name)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
                i = i + 1
            }
            return nil
        }
    }

    // Other platforms (and linux without `--link`): stub unresolved imports for now.
    var j = 0
    while j < oren_list_len(imports) {
        _x64_emit_ffi_stub_linux(ctx, imports[j])
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        j = j + 1
    }
    return nil
}
