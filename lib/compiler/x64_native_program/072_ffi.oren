fn _x64_emit_ffi_stub_win64(ctx, nm, resolver_name) {
    // Windows x64: lazy resolve `nm` on first call, cache fnptr in `.data`, then tailcall.
    if ctx == nil { return nil }
    if nm == nil || nm == "" { return nil }
    if resolver_name == nil || resolver_name == "" {
        err(ctx, "x64 native v0: internal: missing ffi resolver name")
        return nil
    }

    if ctx["functions"] == nil { ctx["functions"] = {} }
    if ctx["functions"][nm] != nil { return nil }

    var data = _x64_ffi_stub_win64_data(ctx, nm)
    ctx["functions"][nm] = bytes_len(ctx["code"])

    var labels = {"have": _new_label(ctx, "ffi_have"), "fail": _new_label(ctx, "ffi_fail")}
    var local_fixups = []

    _x64_emit_ffi_stub_win64_cached_load(ctx, data, labels, local_fixups)
    _x64_emit_ffi_stub_win64_spill_args(ctx)
    _x64_emit_ffi_stub_win64_call_resolver(ctx, data, resolver_name, labels, local_fixups)
    _x64_emit_ffi_stub_win64_cache_result(ctx, data)
    _x64_emit_ffi_stub_win64_restore_args(ctx)
    _x64_emit_ffi_stub_win64_tailcall(ctx, labels)
    _x64_emit_ffi_stub_win64_panic(ctx, data, labels)

    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _x64_emit_ffi_stubs(ctx, platform) {
    if ctx == nil { return nil }
    var imports = ctx["import_list"]
    if imports == nil || oren_list_len(imports) == 0 { return nil }

    var os = _x64_ffi_platform_os(platform)
    if os == "windows" { return _x64_emit_ffi_stubs_windows(ctx, platform, imports) }
    if _x64_ffi_platform_uses_linux_dynamic_stubs(platform, os) {
        return _x64_emit_ffi_stubs_linux_dynamic(ctx, platform, imports)
    }
    return _x64_emit_ffi_stubs_unresolved(ctx, imports)
}

fn _x64_ffi_platform_os(platform) {
    if platform != nil { return platform["os"] }
    return nil
}

fn _x64_ffi_has_errors(ctx) {
    return ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0
}

fn _x64_emit_ffi_one_import_stub(ctx, mode, nm, resolver_name) {
    if mode == "win64" {
        _x64_emit_ffi_stub_win64(ctx, nm, resolver_name)
    } else if mode == "linux_dyn" {
        _x64_emit_ffi_stub_linux_dyn(ctx, nm, resolver_name)
    } else {
        _x64_emit_ffi_stub_linux(ctx, nm)
    }
    return nil
}

fn _x64_emit_ffi_import_stub_loop(ctx, imports, mode, resolver_name) {
    var i = 0
    while i < oren_list_len(imports) {
        _x64_emit_ffi_one_import_stub(ctx, mode, imports[i], resolver_name)
        if _x64_ffi_has_errors(ctx) { return nil }
        i = i + 1
    }
    return true
}

fn _x64_emit_ffi_stubs_windows(ctx, platform, imports) {
    var dlls = _x64_ffi_windows_dlls(ctx, platform)
    var resolver_name = _x64_emit_ffi_resolver_win64(ctx, platform, dlls)
    if _x64_ffi_has_errors(ctx) { return nil }
    _x64_emit_ffi_import_stub_loop(ctx, imports, "win64", resolver_name)
    return nil
}

fn _x64_ffi_platform_uses_linux_dynamic_stubs(platform, os) {
    if os != "linux" { return false }
    return platform != nil && platform["link_libs"] != nil && oren_list_len(platform["link_libs"]) != 0
}

fn _x64_emit_ffi_stubs_linux_dynamic(ctx, platform, imports) {
    var resolver_name = _x64_emit_ffi_resolver_linux64(ctx, platform)
    if _x64_ffi_has_errors(ctx) { return nil }
    _x64_emit_ffi_import_stub_loop(ctx, imports, "linux_dyn", resolver_name)
    return nil
}

fn _x64_emit_ffi_stubs_unresolved(ctx, imports) {
    _x64_emit_ffi_import_stub_loop(ctx, imports, "unresolved", nil)
    return nil
}
