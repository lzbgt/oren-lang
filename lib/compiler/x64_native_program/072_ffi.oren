fn _x64_emit_ffi_stub_win64_panic(ctx, data, labels) {
    _emit_label(ctx, labels, labels["fail"])
    // call oren_panic("ffi unresolved: <name>") (does not return)
    bytes_extend(ctx["code"], core.insn_sub_rsp_imm32(40))
