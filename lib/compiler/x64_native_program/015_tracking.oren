// x64 native: allocation tracking hooks (Tier‑1 convergence).
//
// Native v0 uses an i64 carrier for *all* values (pointers and immediates).
// To keep container/string operations safe, backends must never dereference
// untrusted values as pointers unless they are known-tracked allocations.
//
// arm64 native already routes this through the injected syscall-first runtime:
// - `oren_find_node(ptr)`    -> returns tracking node or 0
// - `oren_track_alloc_new(ptr, size, kind)`
// - `oren_ensure_tracked(ptr, kind)`
//
// x86_64 originally had a backend-local tracking list (bring-up hack). That created
// drift and forced the compiler to carry x64-only globals. In rolling Tier‑1,
// x86_64 now always injects the same runtime bundle as arm64, so we can converge
// by routing all tracking through the runtime helpers too.
//
// NOTE: This file intentionally keeps the former helper names so call sites stay
// simple while we delete the last x64 bring-up paths.

fn _emit_find_tracked_node_x64(ctx, ptr_reg, dst_node_reg) {
    // dst_node_reg = tracking node pointer if `ptr_reg` is tracked; otherwise 0.
    //
    // IMPORTANT:
    // - Do *not* implement this by calling runtime `oren_find_node`.
    // - `oren_find_node` itself uses comparisons that consult tracking metadata (string-aware compares).
    // - Calling `oren_find_node` from the tracking lookup introduces recursion and can stack overflow.
    //
    // Implementation: call the runtime `native_alloc_index_get(ptr)` helper.
    //
    // Why:
    // - The alloc-index includes heap alloc nodes AND explicit static-kind nodes tracked via
    //   `oren_track_static` / `oren_ensure_tracked`.
    // - Embedded cstr0 literals are intentionally *not* tracked as alloc nodes (they are recognized
    //   via a separate literal membership set), so string-aware operations must not rely on
    //   `native_alloc_index_get` alone for "is this a string?".
    //
    // Safety:
    // - `native_alloc_index_get` is implemented using only primitive ops (`iadd`, `ptr_get`) and is
    //   written specifically to avoid recursion through `oren_add` / `oren_find_node`.
    if ctx == nil { return nil }
    if ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: internal error: tracking requires injected runtime")
        return nil
    }

    // Default dst = 0.
    bytes_extend(ctx["code"], insn_mov_r32_imm32(dst_node_reg, 0))

    // ptr == 0 => done
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(ptr_reg, 0))
    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "trk_find_done")
    var l_call = _new_label(ctx, "trk_find_call")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)

    // Match runtime safety/perf guard: small integers are not pointers.
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(ptr_reg, 4096))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_call)
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_call)
    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    if oren_type_tag(a0_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg reg for native_alloc_index_get")
        return nil
    }
    var a0 = a0_enc - 1
    if a0 != ptr_reg { bytes_extend(ctx["code"], insn_mov_r64_r64(a0, ptr_reg)) }
    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "native_alloc_index_get"})
    // Return value is node pointer in RAX.
    if dst_node_reg != 0 { bytes_extend(ctx["code"], insn_mov_r64_r64(dst_node_reg, 0)) }

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_track_alloc_x64(ctx, locals, ptr_reg, size_reg, kind_reg) {
    // x64 native: call the runtime `oren_track_alloc_new(ptr,size,kind)`.
    //
    // IMPORTANT: do not rely on SysV/Win64 callee-saved regs here.
    // The x64 backend uses registers like R12 as scratch in many helpers, so the
    // safest rule is: treat *all* registers as volatile across runtime calls.
    //
    // Therefore, preserve the original pointer in a stack spill slot.
    //
    // Return contract (legacy helper): `ptr_reg` stays the original pointer.
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: track_alloc requires locals"); return nil }
    if ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: internal error: track_alloc requires injected runtime")
        return nil
    }

    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    var a1_enc = abi.int_arg_reg(ctx["abi"], 1)
    var a2_enc = abi.int_arg_reg(ctx["abi"], 2)
    if oren_type_tag(a0_enc) == 0 || oren_type_tag(a1_enc) == 0 || oren_type_tag(a2_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg regs for oren_track_alloc_new")
        return nil
    }
    var a0 = a0_enc - 1
    var a1 = a1_enc - 1
    var a2 = a2_enc - 1

    // Spill the args we need to keep stable across the call.
    var base = _intr_tmp_push(ctx, 3)
    if oren_type_tag(base) == 0 { return nil }
    var off_ptr = _intr_tmp_off(ctx, locals, base + 0)
    var off_size = _intr_tmp_off(ctx, locals, base + 1)
    var off_kind = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(off_ptr) == 0 || oren_type_tag(off_size) == 0 || oren_type_tag(off_kind) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _emit_mov_mrbp_r64(ctx, 0 - off_ptr, ptr_reg)
    _emit_mov_mrbp_r64(ctx, 0 - off_size, size_reg)
    _emit_mov_mrbp_r64(ctx, 0 - off_kind, kind_reg)

    _emit_mov_r64_mrbp(ctx, a0, 0 - off_ptr)
    _emit_mov_r64_mrbp(ctx, a1, 0 - off_size)
    _emit_mov_r64_mrbp(ctx, a2, 0 - off_kind)

    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "oren_track_alloc_new"})

    // Restore pointer to satisfy legacy helper contract.
    _emit_mov_r64_mrbp(ctx, ptr_reg, 0 - off_ptr)

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_trace_alloc_request_x64(ctx, locals, ptr_reg, size_reg, kind_reg) {
    // x64 native: call runtime `oren_trace_alloc_request(ptr,size,kind)`.
    // Preserve registers across the call and keep ptr_reg intact.
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: trace_alloc_request requires locals"); return nil }
    if ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: internal error: trace_alloc_request requires injected runtime")
        return nil
    }

    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    var a1_enc = abi.int_arg_reg(ctx["abi"], 1)
    var a2_enc = abi.int_arg_reg(ctx["abi"], 2)
    if oren_type_tag(a0_enc) == 0 || oren_type_tag(a1_enc) == 0 || oren_type_tag(a2_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg regs for oren_trace_alloc_request")
        return nil
    }
    var a0 = a0_enc - 1
    var a1 = a1_enc - 1
    var a2 = a2_enc - 1

    var base = _intr_tmp_push(ctx, 3)
    if oren_type_tag(base) == 0 { return nil }
    var off_ptr = _intr_tmp_off(ctx, locals, base + 0)
    var off_size = _intr_tmp_off(ctx, locals, base + 1)
    var off_kind = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(off_ptr) == 0 || oren_type_tag(off_size) == 0 || oren_type_tag(off_kind) == 0 {
        _intr_tmp_pop(ctx, base)
        return nil
    }

    _emit_mov_mrbp_r64(ctx, 0 - off_ptr, ptr_reg)
    _emit_mov_mrbp_r64(ctx, 0 - off_size, size_reg)
    _emit_mov_mrbp_r64(ctx, 0 - off_kind, kind_reg)

    _emit_mov_r64_mrbp(ctx, a0, 0 - off_ptr)
    _emit_mov_r64_mrbp(ctx, a1, 0 - off_size)
    _emit_mov_r64_mrbp(ctx, a2, 0 - off_kind)

    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "oren_trace_alloc_request"})

    _emit_mov_r64_mrbp(ctx, ptr_reg, 0 - off_ptr)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_ensure_tracked_ptr_kind_x64(ctx, locals, ptr_reg, kind_imm) {
    // Ensure the pointer is tracked as `kind_imm` via runtime `oren_ensure_tracked(ptr, kind)`.
    //
    // IMPORTANT: do not rely on callee-saved regs across runtime calls.
    // Preserve the original pointer in a stack spill slot and restore it after the call.
    //
    // Return contract (matches runtime): returns the pointer. Legacy helper also
    // preserved the original pointer in `ptr_reg`.
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: ensure_tracked requires locals"); return nil }
    if ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: internal error: ensure_tracked requires injected runtime")
        return nil
    }

    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    var a1_enc = abi.int_arg_reg(ctx["abi"], 1)
    if oren_type_tag(a0_enc) == 0 || oren_type_tag(a1_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg regs for oren_ensure_tracked")
        return nil
    }
    var a0 = a0_enc - 1
    var a1 = a1_enc - 1

    var base = _intr_tmp_push(ctx, 1)
    if oren_type_tag(base) == 0 { return nil }
    var off_ptr = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(off_ptr) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _emit_mov_mrbp_r64(ctx, 0 - off_ptr, ptr_reg)

    _emit_mov_r64_mrbp(ctx, a0, 0 - off_ptr)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(a1, kind_imm))

    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "oren_ensure_tracked"})

    // Return value:
    // - `oren_ensure_tracked(ptr, kind)` returns the pointer to use.
    // - For STRING (kind=1), the runtime will avoid tracking embedded cstr0 literals and will
    //   instead rely on the startup-built literal membership set.
    // - Still, keep using the return value as the authoritative pointer.
    // - Return register is RAX; copy it into `ptr_reg` when needed.
    if ptr_reg != 0 {
        bytes_extend(ctx["code"], insn_mov_r64_r64(ptr_reg, 0))
    }

    _intr_tmp_pop(ctx, base)
    return nil
}
