// x64 native: minimal allocation tracking (rolling Tier‑1 convergence).
//
// Motivation:
// - Native v0 represents non-pointer values as raw integers, so `k >= 4096` is ambiguous:
//   it can be an integer key or a pointer.
// - To keep map semantics safe (no `strcmp` on integers) without heuristics, we use a
//   minimal "tracked allocations" list to classify string pointers.
//
// Design (rolling, x64 v0):
// - Track only what we need for correctness of key-kind inference:
//   - kind=1: string (C-string pointer)
// - Node layout intentionally matches the native runtime tracking node layout so we can
//   converge toward shared runtime injection later:
//   node (40 bytes):
//     +0  ptr
//     +8  size (unused by x64 v0; 0)
//     +16 kind
//     +24 flags (unused; 0)
//     +32 next

fn _data_reserve_tracked_allocs_head_x64(ctx) {
    if ctx == nil { return nil }
    if ctx["tracked_allocs_head_off"] != nil { return nil }
    // A single u64 slot in the appended data blob holds the head pointer.
    var off = _data_add_u64(ctx, 0)
    if off == nil { err(ctx, "x64 native v0: failed to reserve tracked allocs head") }
    ctx["tracked_allocs_head_off"] = off
    return nil
}

fn _emit_load_tracked_allocs_head_addr_x64(ctx, dst_reg) {
    // dst_reg = &tracked_allocs_head (address of u64 slot in appended data blob)
    if ctx == nil { return nil }
    var off = ctx["tracked_allocs_head_off"]
    if off == nil { err(ctx, "x64 native v0: tracked allocs head not reserved"); return nil }
    var lea_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(dst_reg, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": off})
    return nil
}

fn _emit_find_tracked_node_x64(ctx, ptr_reg, dst_node_reg) {
    // dst_node_reg = node pointer if tracked; otherwise 0.
    //
    // Clobbers: R10, R11, R12
    if ctx == nil { return nil }
    _data_reserve_tracked_allocs_head_x64(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    // Save ptr into r12 (callee-saved in our generated code paths; we use it as scratch).
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, ptr_reg))

    // Default dst = 0.
    bytes_extend(ctx["code"], insn_mov_r32_imm32(dst_node_reg, 0))

    // If ptr < 4096 => not a pointer in native v0 model => not tracked.
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 4096))
    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "trk_find_done")
    var l_scan = _new_label(ctx, "trk_find_scan")
    _emit_jcc_to_label(ctx, local_fixups, "l", l_done)

    // r10 = &head_slot ; r11 = head
    _emit_load_tracked_allocs_head_addr_x64(ctx, 10)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 10))

    _emit_label(ctx, labels, l_scan)
    // while r11 != 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)

    // r10 = *(u64*)r11 (node.ptr)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 11))
    bytes_extend(ctx["code"], insn_cmp_r64_r64(10, 12))
    var l_next = _new_label(ctx, "trk_find_next")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_next)

    // Found: dst_node_reg = r11
    bytes_extend(ctx["code"], insn_mov_r64_r64(dst_node_reg, 11))
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_next)
    // r11 = *(u64*)(r11 + 32)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 32))
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 10))
    _emit_jmp_to_label(ctx, local_fixups, l_scan)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_infer_map_key_kind_x64(ctx, locals, key_reg, dst_kind_reg) {
    // Infer map key kind using the rolling native runtime contract:
    // - if key < 4096 => integer kind=0
    // - else if tracked node exists and node.kind == 1 => string kind=1
    // - else if tracked node exists and node.kind != 1 => abort (unsupported key type)
    // - else => integer kind=0
    //
    // Output:
    // - dst_kind_reg: 0 or 1
    //
    // Clobbers: R10, R11, R12, RAX
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: key kind inference requires locals"); return nil }

    // Default kind=0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(dst_kind_reg, 0))

    // Save key into r12.
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, key_reg))

    // If key < 4096 => kind=0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 4096))
    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "trk_kind_done")
    _emit_jcc_to_label(ctx, local_fixups, "l", l_done)

    // r11 = find_node(key)
    _emit_find_tracked_node_x64(ctx, 12, 11)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    // if r11 == 0 => kind stays 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)

    // r10 = *(u64*)(node + 16) => kind
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 10))

    // if kind == 1 => dst_kind_reg = 1 else abort
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 1))
    var l_is_str = _new_label(ctx, "trk_kind_is_str")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_str)
    _emit_abort_panic_str(ctx, "map key kind inference: unsupported tracked key type (need int or string)")
    _emit_label(ctx, labels, l_is_str)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(dst_kind_reg, 1))

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_track_alloc_x64(ctx, locals, ptr_reg, size_reg, kind_reg) {
    // x64 native: lightweight `oren_track_alloc(ptr,size,kind)` implementation.
    //
    // Motivation:
    // - Many runtime helpers (e.g. string constructors) call `oren_track_alloc` to mark
    //   allocations as STRING/LIST/MAP/etc.
    // - x64 native key-kind inference relies on the x64-side tracked list (not the full
    //   native runtime globals model), so we must ensure runtime calls update the same list.
    //
    // Semantics (match the rolling runtime contract closely enough for Tier‑1):
    // - If ptr == 0 or ptr < 4096: no-op (return ptr).
    // - If ptr is already tracked: update `size` when size!=0; update `kind` when kind!=0.
    // - Otherwise: allocate a node and insert at head; store ptr/size/kind; flags=0.
    //
    // Return:
    // - ptr_reg remains the pointer (caller can move it to RAX as the expression result)
    //
    // Clobbers: R10, R11, R12, R13, RAX
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: track_alloc requires locals"); return nil }

    _data_reserve_tracked_allocs_head_x64(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "trk_alloc_done")
    var l_scan = _new_label(ctx, "trk_alloc_scan")
    var l_found = _new_label(ctx, "trk_alloc_found")
    var l_alloc = _new_label(ctx, "trk_alloc_new")

    // Save ptr into r12.
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, ptr_reg))
    // Save size into r13.
    bytes_extend(ctx["code"], insn_mov_r64_r64(13, size_reg))
    // Save kind into r10.
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, kind_reg))

    // if ptr == 0 => done
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)
    // If ptr < 4096 => not a pointer => done
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 4096))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_done)

    // r11 = head
    _emit_load_tracked_allocs_head_addr_x64(ctx, 11)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 11))

    _emit_label(ctx, labels, l_scan)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_alloc)

    // Compare node.ptr with ptr (r12)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(0, 11)) // rax = *(u64*)node (node.ptr)
    bytes_extend(ctx["code"], insn_cmp_r64_r64(0, 12))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_found)

    // r11 = node.next
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 32))
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 0))
    _emit_jmp_to_label(ctx, local_fixups, l_scan)

    _emit_label(ctx, labels, l_found)
    // Update size when size != 0.
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(13, 0))
    var l_skip_size = _new_label(ctx, "trk_alloc_skip_size")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_skip_size)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(0, 13))
    _emit_label(ctx, labels, l_skip_size)

    // Update kind when kind != 0.
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 0))
    var l_skip_kind = _new_label(ctx, "trk_alloc_skip_kind")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_skip_kind)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(0, 10))
    _emit_label(ctx, labels, l_skip_kind)

    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_alloc)
    // Allocate a new node: malloc_raw(40) via the bump allocator intrinsic.
    //
    // NOTE: `_emit_malloc_size_in_rax` clobbers volatile regs including r10, so preserve
    // the requested `kind` across the call.
    var spill_kind = locals["$tmp1"]
    if spill_kind == nil { err(ctx, "x64 native v0: track_alloc missing $tmp1 spill slot"); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - spill_kind, 10)

    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 40))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_malloc_size_in_rax(ctx, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    // Restore kind into r10.
    _emit_mov_r64_mrbp(ctx, 10, 0 - spill_kind)

    // r11 = node (returned in rax)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0))

    // node.ptr = ptr (r12)
    bytes_extend(ctx["code"], insn_mov_mr64_r64(11, 12))

    // node.size = size (r13)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(0, 13))

    // node.kind = kind (r10)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(0, 10))

    // node.flags = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(13, 0))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 24))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(0, 13))

    // node.next = old_head
    _emit_load_tracked_allocs_head_addr_x64(ctx, 0)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(13, 0)) // r13 = old head
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 32))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(0, 13))

    // head = node
    _emit_load_tracked_allocs_head_addr_x64(ctx, 0)
    bytes_extend(ctx["code"], insn_mov_mr64_r64(0, 11))

    _emit_label(ctx, labels, l_done)
    // Return original ptr (restore into ptr_reg).
    bytes_extend(ctx["code"], insn_mov_r64_r64(ptr_reg, 12))
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_ensure_tracked_ptr_kind_x64(ctx, locals, ptr_reg, kind_imm) {
    // Ensure the pointer is present in the tracked list; if not, append a node.
    //
    // Used primarily to mark embedded string literals as tracked (kind=1) so map
    // key-kind inference can safely treat them as strings.
    //
    // Clobbers: R10, R11, R12, R13, RAX
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: ensure_tracked requires locals"); return nil }

    _data_reserve_tracked_allocs_head_x64(ctx)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "trk_ensure_done")
    var l_scan = _new_label(ctx, "trk_ensure_scan")
    var l_found = _new_label(ctx, "trk_ensure_found")
    var l_alloc = _new_label(ctx, "trk_ensure_alloc")

    // Save ptr into r12.
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, ptr_reg))

    // if ptr == 0 => done
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_done)

    // If ptr < 4096 => not a pointer => done (prevents accidental tracking of integers).
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 4096))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_done)

    // r10 = &head_slot ; r11 = head
    _emit_load_tracked_allocs_head_addr_x64(ctx, 10)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 10))

    _emit_label(ctx, labels, l_scan)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_alloc)

    // Compare node.ptr with ptr
    bytes_extend(ctx["code"], insn_mov_r64_mr64(13, 11)) // r13 = *(u64*)node
    bytes_extend(ctx["code"], insn_cmp_r64_r64(13, 12))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_found)

    // r11 = node.next
    bytes_extend(ctx["code"], insn_mov_r64_r64(13, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(13, 32))
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 13))
    _emit_jmp_to_label(ctx, local_fixups, l_scan)

    _emit_label(ctx, labels, l_found)
    // Update kind in-place (best-effort; kind_imm is tiny).
    bytes_extend(ctx["code"], insn_mov_r32_imm32(13, kind_imm))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 13))
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_alloc)
    // Allocate a new node: malloc_raw(40) via the bump allocator intrinsic.
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 40))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_malloc_size_in_rax(ctx, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    // r11 = node (returned in rax)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0))

    // node.ptr = ptr
    bytes_extend(ctx["code"], insn_mov_mr64_r64(11, 12))

    // node.size = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(13, 0))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 13))

    // node.kind = kind_imm
    bytes_extend(ctx["code"], insn_mov_r32_imm32(13, kind_imm))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 13))

    // node.flags = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(13, 0))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 13))

    // node.next = old_head
    _emit_load_tracked_allocs_head_addr_x64(ctx, 10)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(13, 10)) // r13 = *(u64*)head_slot
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 32))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 13))

    // head = node
    _emit_load_tracked_allocs_head_addr_x64(ctx, 10)
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11))

    _emit_label(ctx, labels, l_done)
    // Return the original pointer in the requested register (matches `oren_ensure_tracked`).
    bytes_extend(ctx["code"], insn_mov_r64_r64(ptr_reg, 12))
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}
