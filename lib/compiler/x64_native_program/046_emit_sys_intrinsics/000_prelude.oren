// x64-native: sys_* intrinsics (Tier‑1 runtime injection enabler).
//
// Native runtime sources (`lib/runtime_native/**`) define `sys_*` stubs so the source parses/links,
// but correct native binaries must *lower* these call sites to the platform ABI:
// - Linux x86_64: direct syscalls (`syscall` instruction)
// - Windows x64: Win32 API via PE IAT (subset)
//
// NOTE: This module intentionally mirrors the arm64 "syscall-first" model:
// - all host-effect operations remain centralized at the `sys_*` boundary
// - capsule enforcement hooks (`native_capsule_sys_*_{pre,post}`) are invoked here
// - user code and the injected runtime never call OS APIs directly

// Oren-level open(2) flags (rolling ABI).
//
// Design:
// - The lower 2 bits match POSIX access mode: 0=RDONLY, 1=WRONLY, 2=RDWR.
// - Higher bits are Oren-stable feature flags that must be translated to OS-specific O_*.
var OREN_O_CREAT = 256
var OREN_O_TRUNC = 512
var OREN_O_NONBLOCK = 1024
var OREN_O_APPEND = 2048

fn _x64_capsule_enabled(ctx) {
    if ctx == nil { return false }
    var platform = ctx["platform"]
    if platform != nil && platform["capsule"] == true { return true }
    return false
}

fn _emit_call_rel32_named_x64(ctx, name) {
    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": name})
    return nil
}

fn _emit_return_enosys_x64(ctx) {
    // rax = -38 (ENOSYS)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967258))
    bytes_extend(ctx["code"], core.insn_cdqe())
    return nil
}

fn _intr_eval_spill_x64(ctx, locals, expr, off) {
    _emit_eval_int_to_rax(ctx, expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _emit_mov_mrbp_r64(ctx, 0 - off, 0)
    return nil
}

fn _intr_load_x64(ctx, dst_reg, off) {
    _emit_mov_r64_mrbp(ctx, dst_reg, 0 - off)
    return nil
}

fn _emit_translate_open_flags_linux_x64(ctx, locals, off_oren_flags) {
    // Input:  stack slot off_oren_flags contains Oren-level flags (i64)
    // Output: rdx = os_flags (i64)
    //
    // Scratch: r8, r9
    _intr_load_x64(ctx, 8, off_oren_flags)              // r8 = oren_flags
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 8))    // rdx = oren_flags
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(2, 3))  // rdx = access bits

    var labels = {}
    var fixups = []

    // if (flags & OREN_O_CREAT) != 0 => rdx |= O_CREAT
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 8))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(9, OREN_O_CREAT))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(9, 0))
    var l_skip_creat = _new_label(ctx, "open_flags_skip_creat")
    _emit_jcc_to_label(ctx, fixups, "e", l_skip_creat)
    bytes_extend(ctx["code"], core.insn_or_r64_imm32(2, labi.linux_open_flag_creat()))
    _emit_label(ctx, labels, l_skip_creat)

    // if (flags & OREN_O_TRUNC) != 0 => rdx |= O_TRUNC
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 8))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(9, OREN_O_TRUNC))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(9, 0))
    var l_skip_trunc = _new_label(ctx, "open_flags_skip_trunc")
    _emit_jcc_to_label(ctx, fixups, "e", l_skip_trunc)
    bytes_extend(ctx["code"], core.insn_or_r64_imm32(2, labi.linux_open_flag_trunc()))
    _emit_label(ctx, labels, l_skip_trunc)

    // if (flags & OREN_O_NONBLOCK) != 0 => rdx |= O_NONBLOCK
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 8))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(9, OREN_O_NONBLOCK))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(9, 0))
    var l_skip_nb = _new_label(ctx, "open_flags_skip_nb")
    _emit_jcc_to_label(ctx, fixups, "e", l_skip_nb)
    bytes_extend(ctx["code"], core.insn_or_r64_imm32(2, labi.linux_open_flag_nonblock()))
    _emit_label(ctx, labels, l_skip_nb)

    // if (flags & OREN_O_APPEND) != 0 => rdx |= O_APPEND
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 8))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(9, OREN_O_APPEND))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(9, 0))
    var l_skip_append = _new_label(ctx, "open_flags_skip_append")
    _emit_jcc_to_label(ctx, fixups, "e", l_skip_append)
    bytes_extend(ctx["code"], core.insn_or_r64_imm32(2, labi.linux_open_flag_append()))
    _emit_label(ctx, labels, l_skip_append)

    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_translate_fcntl_setfl_flags_linux_x64(ctx) {
    // Input:  rdx = oren_flags
    // Output: rdx = os_flags (Linux) (currently only O_NONBLOCK)
    //
    // Scratch: r8
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(8, 2))  // r8 = oren_flags
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 0)) // rdx = 0

    var labels = {}
    var fixups = []

    bytes_extend(ctx["code"], core.insn_and_r64_imm32(8, OREN_O_NONBLOCK))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(8, 0))
    var l_skip = _new_label(ctx, "fcntl_setfl_skip_nb")
    _emit_jcc_to_label(ctx, fixups, "e", l_skip)
    bytes_extend(ctx["code"], core.insn_or_r64_imm32(2, labi.linux_open_flag_nonblock()))
    _emit_label(ctx, labels, l_skip)

    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_translate_fcntl_getfl_return_linux_x64(ctx) {
    // Input:  rax = os_flags (or negative errno)
    // Output: rax = oren_flags (or negative errno)
    //
    // Keep access bits (&3) and translate O_NONBLOCK.
    //
    // Scratch: r8, r9
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var labels = {}
    var fixups = []
    var l_skip_all = _new_label(ctx, "fcntl_getfl_skip_all")
    _emit_jcc_to_label(ctx, fixups, "l", l_skip_all) // rc < 0

    bytes_extend(ctx["code"], core.insn_mov_r64_r64(8, 0))     // r8 = os_flags
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(0, 3))   // rax = os_flags & 3 (access bits)

    // if (os_flags & O_NONBLOCK) != 0 => rax |= OREN_O_NONBLOCK
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 8))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(9, labi.linux_open_flag_nonblock()))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(9, 0))
    var l_skip_nb = _new_label(ctx, "fcntl_getfl_skip_nb")
    _emit_jcc_to_label(ctx, fixups, "e", l_skip_nb)
    bytes_extend(ctx["code"], core.insn_or_r64_imm32(0, OREN_O_NONBLOCK))
    _emit_label(ctx, labels, l_skip_nb)

    _emit_label(ctx, labels, l_skip_all)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_intrinsic_sys_read_windows_x64(ctx, locals, args, capsule) {
    // Windows: ReadFile-based reader.
    // - fd 0 => STD_INPUT_HANDLE (GetStdHandle(-10))
    // - other fds => treat as Win32 HANDLE (returned by sys_open)
    //
    // ReadFile(handle, ptr, (u32)len, &read, NULL) => return bytes read
    // - EOF: ReadFile succeeds and bytesRead==0 => return 0
    // - error: return -EIO (rolling)
    var base = _intr_tmp_push(ctx, 3)
    if oren_type_tag(base) == 0 { return nil }
    var tmp_fd = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_ptr = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_len = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(tmp_fd) == 0 || oren_type_tag(tmp_ptr) == 0 || oren_type_tag(tmp_len) == 0 { _intr_tmp_pop(ctx, base); return nil }

    // fd (with capsule gating)
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    // Capsule prehook is an internal Oren call and must use the platform ABI.
    // Win64: arg0 in RCX; SysV: arg0 in RDI.
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = fd
    if capsule {
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_read_pre")
    } else {
        // rax = fd
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 1))
    }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_fd, 0)

    _intr_eval_spill_x64(ctx, locals, args[1], tmp_ptr)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_len)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    var labels = {}
    var local_fixups = []
    var l_ret0 = _new_label(ctx, "sys_read_ret0")
    var l_fail = _new_label(ctx, "sys_read_fail")
    var l_have_handle = _new_label(ctx, "sys_read_have_handle")
    var l_done = _new_label(ctx, "sys_read_done")

    // if len <= 0 => return 0
    _intr_load_x64(ctx, 0, tmp_len)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_ret0)

    // Determine handle:
    // - fd==0 => GetStdHandle(STD_INPUT_HANDLE)
    // - else  => fd itself is a Win32 HANDLE
    _intr_load_x64(ctx, 0, tmp_fd)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_have_handle)

    // STD_INPUT_HANDLE = -10
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 4294967286)) // ecx = -10
    var mov_iat0 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat0 + 3, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], core.insn_call_rax())

    // rcx = handle
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0))
    _emit_jmp_to_label(ctx, local_fixups, l_have_handle)

    _emit_label(ctx, labels, l_have_handle)
    // If fd != 0, override rcx with the handle value.
    _intr_load_x64(ctx, 0, tmp_fd)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_skip_fd = _new_label(ctx, "sys_read_skip_fd")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_skip_fd)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = fd(handle)
    _emit_label(ctx, labels, l_skip_fd)

    // rdx = ptr
    _intr_load_x64(ctx, 2, tmp_ptr)
    // r8 = len (low 32 used)
    _intr_load_x64(ctx, 8, tmp_len)

    // lpOverlapped (arg5) = NULL at [rsp+0x20]; bytesRead at [rsp+0x28]
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(32, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(36, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(40, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(44, 0))
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(9, 40)) // r9 = &read

    var mov_iat1 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat1 + 3, "IAT_ReadFile")
    bytes_extend(ctx["code"], core.insn_call_rax())

    // if eax == 0 => failure => return -EIO (rolling)
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_fail)

    // rax = *(u64*)(&read)
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(10, 40))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_fail)
    // -5 (EIO)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967291))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_ret0)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_read_linux_x64(ctx, locals, args, capsule) {
    // Linux x86_64
    var base2 = _intr_tmp_push(ctx, 3)
    if oren_type_tag(base2) == 0 { return nil }
    var tmp_fd2 = _intr_tmp_off(ctx, locals, base2 + 0)
    var tmp_ptr2 = _intr_tmp_off(ctx, locals, base2 + 1)
    var tmp_len2 = _intr_tmp_off(ctx, locals, base2 + 2)
    if oren_type_tag(tmp_fd2) == 0 || oren_type_tag(tmp_ptr2) == 0 || oren_type_tag(tmp_len2) == 0 { _intr_tmp_pop(ctx, base2); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 0)) // rdi=fd
    if capsule {
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_read_pre")
    } else {
        // rax = fd
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 7))
    }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_fd2, 0)

    _intr_eval_spill_x64(ctx, locals, args[1], tmp_ptr2)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_len2)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return nil }

    _intr_load_x64(ctx, 7, tmp_fd2)
    _intr_load_x64(ctx, 6, tmp_ptr2)
    _intr_load_x64(ctx, 2, tmp_len2)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_read()))
    bytes_extend(ctx["code"], core.insn_syscall())
    _intr_tmp_pop(ctx, base2)
    return nil
}

fn _emit_intrinsic_sys_read_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_read expects 3 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_read does not support spread"); return nil }

    var platform = ctx["platform"]
    var capsule = _x64_capsule_enabled(ctx)
    if platform != nil && platform["os"] == "windows" {
        return _emit_intrinsic_sys_read_windows_x64(ctx, locals, args, capsule)
    }
    return _emit_intrinsic_sys_read_linux_x64(ctx, locals, args, capsule)
}

fn _emit_intrinsic_sys_write_windows_x64(ctx, locals, args, capsule) {
    // Windows: WriteFile-based writer.
    // - fd 1/2 => STDOUT/STDERR (GetStdHandle)
    // - other  => treat fd as Win32 HANDLE (returned by sys_open)
    //
    // WriteFile(handle, ptr, (u32)len, &written, NULL)
    // Returns bytes written, or -EIO on failure (rolling).
    var base = _intr_tmp_push(ctx, 3)
    if oren_type_tag(base) == 0 { return nil }
    var tmp_fd = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_ptr = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_len = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(tmp_fd) == 0 || oren_type_tag(tmp_ptr) == 0 || oren_type_tag(tmp_len) == 0 { _intr_tmp_pop(ctx, base); return nil }

    // fd (with capsule gating)
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx=fd
    if capsule {
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_write_pre")
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 1)) // rax = rcx
    }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_fd, 0)

    _intr_eval_spill_x64(ctx, locals, args[1], tmp_ptr)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_len)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    var labels = {}
    var local_fixups = []
    var l_ret0 = _new_label(ctx, "sys_write_ret0")
    var l_done = _new_label(ctx, "sys_write_done")

    // if len <= 0 => return 0
    _intr_load_x64(ctx, 0, tmp_len)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_ret0)

    // Determine handle:
    // - fd==1 => STD_OUTPUT_HANDLE (-11)
    // - fd==2 => STD_ERROR_HANDLE  (-12)
    // - else  => fd itself is the handle
    var l_use_stdout = _new_label(ctx, "sys_write_use_stdout")
    var l_use_stderr = _new_label(ctx, "sys_write_use_stderr")
    var l_have_handle = _new_label(ctx, "sys_write_have_handle")
    _intr_load_x64(ctx, 0, tmp_fd) // rax = fd
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 1))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_use_stdout)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 2))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_use_stderr)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = fd (HANDLE)
    _emit_jmp_to_label(ctx, local_fixups, l_have_handle)

    _emit_label(ctx, labels, l_use_stdout)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 4294967285)) // ecx = -11
    var mov_iat0 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat0 + 3, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], core.insn_call_rax())
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = handle
    _emit_jmp_to_label(ctx, local_fixups, l_have_handle)

    _emit_label(ctx, labels, l_use_stderr)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 4294967284)) // ecx = -12
    var mov_iat1 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat1 + 3, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], core.insn_call_rax())
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = handle

    _emit_label(ctx, labels, l_have_handle)
    _intr_load_x64(ctx, 2, tmp_ptr) // rdx = ptr
    _intr_load_x64(ctx, 8, tmp_len) // r8  = len (low 32 used by WinAPI)

    // lpOverlapped (arg5) = NULL at [rsp+0x20]; bytesWritten storage at [rsp+0x28].
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(32, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(36, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(40, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(44, 0))
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(9, 40)) // r9 = &written

    var mov_iat2 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat2 + 3, "IAT_WriteFile")
    bytes_extend(ctx["code"], core.insn_call_rax())

    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    var l_fail = _new_label(ctx, "sys_write_fail")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_fail)

    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(10, 40))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_fail)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967291)) // -5 (EIO)
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_ret0)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_write_linux_x64(ctx, locals, args, capsule) {
    var base = _intr_tmp_push(ctx, 3)
