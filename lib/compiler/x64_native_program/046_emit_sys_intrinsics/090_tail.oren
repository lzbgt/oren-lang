            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, 0)) // edi = 0 (addr)
            _intr_load_x64(ctx, 6, tmp_len) // rsi = len
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, labi.linux_mmap_prot_read_write()))
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, labi.linux_mmap_flags_private_anon()))
            bytes_extend(ctx["code"], core.insn_mov_r64_imm64(8, -1))
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(9, 0))
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_mmap()))
            bytes_extend(ctx["code"], core.insn_syscall())
        }

        _intr_tmp_pop(ctx, base13)
        return true
    }

    if nm == "sys_munmap" {
        if oren_list_len(args) != 2 { err(ctx, "x64 native v0: sys_munmap expects 2 args"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_munmap does not support spread"); return true }

        var base14 = _intr_tmp_push(ctx, 2) // addr, len
        if oren_type_tag(base14) == 0 { return true }
        var tmp_addr = _intr_tmp_off(ctx, locals, base14 + 0)
        var tmp_len2 = _intr_tmp_off(ctx, locals, base14 + 1)
        if oren_type_tag(tmp_addr) == 0 || oren_type_tag(tmp_len2) == 0 { _intr_tmp_pop(ctx, base14); return true }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_addr)
        _intr_eval_spill_x64(ctx, locals, args[1], tmp_len2)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base14); return true }

        // pre: native_capsule_sys_munmap_pre(addr, len)
        var is_win = false
        var sh = abi.caller_shadow_bytes(ctx["abi"])
        if sh != nil && sh > 0 { is_win = true }
        if is_win {
            _intr_load_x64(ctx, 1, tmp_addr) // rcx = addr
            _intr_load_x64(ctx, 2, tmp_len2) // rdx = len
        } else {
            _intr_load_x64(ctx, 7, tmp_addr) // rdi = addr
            _intr_load_x64(ctx, 6, tmp_len2) // rsi = len
        }
        if capsule {
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_munmap_pre")
        }

        if is_win {
            _emit_sys_munmap_windows_x64(ctx, locals, tmp_addr)
        } else {
            _intr_load_x64(ctx, 7, tmp_addr)
            _intr_load_x64(ctx, 6, tmp_len2)
            bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_munmap()))
            bytes_extend(ctx["code"], core.insn_syscall())
        }

        _intr_tmp_pop(ctx, base14)
        return true
