fn _x64_linux_gettimeofday_state(ctx, locals) {
    // Also reserve a 16-byte timespec scratch so the optional monotonic clock path
    // can pass a contiguous `struct timespec { sec(u64), nsec(u64) }` to Linux.
    // Intrinsic slots grow toward lower addresses, so the deeper slot is the base.
    var base23 = _intr_tmp_push(ctx, 5) // tv, tz, abs, ts_hi, ts_lo
    if oren_type_tag(base23) == 0 { return nil }
    var state = {}
    state["base"] = base23
    state["tv"] = _intr_tmp_off(ctx, locals, base23 + 0)
    state["tz"] = _intr_tmp_off(ctx, locals, base23 + 1)
    state["abs"] = _intr_tmp_off(ctx, locals, base23 + 2)
    state["ts_hi"] = _intr_tmp_off(ctx, locals, base23 + 3) // higher address (base+8)
    state["ts_lo"] = _intr_tmp_off(ctx, locals, base23 + 4) // lower address  (base+0)
    if oren_type_tag(state["tv"]) == 0 || oren_type_tag(state["tz"]) == 0 || oren_type_tag(state["abs"]) == 0 ||
       oren_type_tag(state["ts_hi"]) == 0 || oren_type_tag(state["ts_lo"]) == 0 {
        _intr_tmp_pop(ctx, base23)
        return nil
    }
    return state
}

fn _x64_spill_linux_gettimeofday_args(ctx, locals, args, state) {
    _intr_eval_spill_x64(ctx, locals, args[0], state["tv"])
    _intr_eval_spill_x64(ctx, locals, args[1], state["tz"])
    _intr_eval_spill_x64(ctx, locals, args[2], state["abs"])
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    return true
}

fn _x64_emit_linux_gettimeofday_prehook(ctx, state, capsule) {
    if !capsule { return nil }
    _intr_load_x64(ctx, 7, state["tv"])
    _intr_load_x64(ctx, 6, state["tz"])
    _intr_load_x64(ctx, 2, state["abs"])
    _emit_call_rel32_named_x64(ctx, "native_capsule_sys_gettimeofday_pre")
    return nil
}

fn _x64_emit_linux_gettimeofday_syscall(ctx, state) {
    // Linux syscall gettimeofday(tv, tz) ignores abs_ptr; keep signature stable.
    _intr_load_x64(ctx, 7, state["tv"])
    _intr_load_x64(ctx, 6, state["tz"])
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_gettimeofday()))
    bytes_extend(ctx["code"], core.insn_syscall())
    return nil
}

fn _x64_emit_linux_gettimeofday_abs_clock(ctx, state) {
    // If abs_ptr is non-null and plausible, fill *abs_ptr with CLOCK_MONOTONIC ns.
    var labels = {}
    var fixups = []
    var l_abs_done = _new_label(ctx, "sys_gettimeofday_abs_done")
    _intr_load_x64(ctx, 11, state["abs"]) // r11 = abs_ptr
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_abs_done)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 4096))
    _emit_jcc_to_label(ctx, fixups, "l", l_abs_done)

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, 1)) // rdi = CLOCK_MONOTONIC
    _emit_addr_rbp_minus_off_x64(ctx, 6, state["ts_lo"]) // rsi = &timespec
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_clock_gettime()))
    bytes_extend(ctx["code"], core.insn_syscall())

    _emit_mov_r64_mrbp(ctx, 10, 0 - state["ts_lo"]) // r10 = sec
    bytes_extend(ctx["code"], core.insn_imul_r64_imm32(10, 1000000000))
    _emit_mov_r64_mrbp(ctx, 9, 0 - state["ts_hi"]) // r9 = nsec
    bytes_extend(ctx["code"], core.insn_add_r64_r64(10, 9))
    _intr_load_x64(ctx, 11, state["abs"]) // Linux syscall clobbers r11.
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(11, 10))

    _emit_label(ctx, labels, l_abs_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_intrinsic_sys_linux_gettimeofday_x64(ctx, expr, locals, args, capsule) {
    if oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_gettimeofday expects 3 args"); return true }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_gettimeofday does not support spread"); return true }

