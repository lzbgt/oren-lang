fn _x64_linux_pipe_emit_widen_success(ctx, st) {
    var labels = {}
    var fixups = []
    _intr_load_x64(ctx, 11, st["tmp_rc"]) // r11 = rc
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    var l_skip_widen = _new_label(ctx, "pipe_skip_widen")
    _emit_jcc_to_label(ctx, fixups, "ne", l_skip_widen)

    // Widen int[2] (32-bit fds) into two u64 slots in-place.
    _intr_load_x64(ctx, 10, st["tmp_ptr"]) // r10 = ptr
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(11, 10)) // r11 = packed (wfd<<32 | rfd)

    // rfd = (u32)r11
    bytes_extend(ctx["code"], core.insn_mov_r32_r32(8, 11)) // r8d = r11d => r8 = rfd (zero-extend)
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(10, 8)) // [ptr] = rfd (u64)

    // wfd = (u32)(r11 >> 32)
    bytes_extend(ctx["code"], core.insn_shr_r64_imm8(11, 32))
    bytes_extend(ctx["code"], core.insn_mov_r32_r32(8, 11)) // r8d = wfd (zero-extend)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 8)) // ptr += 8
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(10, 8))  // [ptr+8] = wfd (u64)

    _emit_label(ctx, labels, l_skip_widen)
    _patch_local_fixups(ctx, labels, fixups)

    // IMPORTANT: preserve the syscall return value in RAX for callers.
    _intr_load_x64(ctx, 0, st["tmp_rc"]) // rax = rc
}

