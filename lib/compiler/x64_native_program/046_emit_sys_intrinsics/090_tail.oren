fn _emit_nanosleep_timespec_syscall_x64(ctx, tmp_ns) {
    // Linux x86_64: nanosleep(const struct timespec* req, struct timespec* rem)
    // Build `struct timespec { tv_sec(u64), tv_nsec(u64) }` on the stack.
    //
    // IMPORTANT (Tier-1 x64 correctness):
    // Do not rely on rbp-indexed intrinsic-temp slots for syscall argument structs here.
    // Use an explicit 16B scratch area on RSP so the pointer we pass to the kernel is
    // contiguous and independent of local-slot layout.
    //
    // - tv_sec  = ns / 1_000_000_000
    // - tv_nsec = ns % 1_000_000_000
    //
    // Syscall ABI:
    // - rax = __NR_nanosleep (35)
    // - rdi = &timespec
    // - rsi = NULL
    // rax = ns
    _intr_load_x64(ctx, 0, tmp_ns)
    // rdx:rax = sign-extend rax (ns is positive here)
    bytes_extend(ctx["code"], core.insn_cqo())
    // rcx = 1_000_000_000
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(1, 1000000000))
    // rax = sec, rdx = nsec
    bytes_extend(ctx["code"], core.insn_idiv_r64(1))

    // Allocate a 16B scratch timespec on RSP (keeps alignment).
    bytes_extend(ctx["code"], core.insn_sub_rsp_imm32(16))
    // [rsp+0] = tv_sec (rax)
    _emit_mov_mrsp_r64(ctx, 0, 0)
    // [rsp+8] = tv_nsec (rdx)
    _emit_mov_mrsp_r64(ctx, 8, 2)

    // rdi = req = rsp
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 4)) // rdi = rsp
    // rsi = rem = 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(6, 0))

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_nanosleep()))
    bytes_extend(ctx["code"], core.insn_syscall())
    bytes_extend(ctx["code"], core.insn_add_rsp_imm32(16))
    return nil
}

fn _emit_intrinsic_sys_linux_nanosleep_x64(ctx, expr, locals, args, capsule) {
    if oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_nanosleep expects 1 arg"); return true }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_nanosleep does not support spread"); return true }

    var base25 = _intr_tmp_push(ctx, 1) // ns
    if oren_type_tag(base25) == 0 { return true }
    var tmp_ns = _intr_tmp_off(ctx, locals, base25 + 0)
    if oren_type_tag(tmp_ns) == 0 { _intr_tmp_pop(ctx, base25); return true }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_ns)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base25); return true }

    // pre: native_capsule_sys_nanosleep_pre(ns) -> ns (may return <=0 to skip sleep)
    if capsule {
        _intr_load_x64(ctx, 7, tmp_ns) // rdi = ns
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_nanosleep_pre")
        _emit_mov_mrbp_r64(ctx, 0 - tmp_ns, 0) // spill adjusted ns
    }

    // Fast path: ns <= 0 => return 0 (skip syscall).
    var labels25 = {}
    var fixups25 = []
    var l_do = _new_label(ctx, "sys_nanosleep_do")
    var l_done = _new_label(ctx, "sys_nanosleep_done")
    _intr_load_x64(ctx, 0, tmp_ns) // rax = ns
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups25, "g", l_do)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups25, l_done)

    _emit_label(ctx, labels25, l_do)
    _emit_nanosleep_timespec_syscall_x64(ctx, tmp_ns)

    _emit_label(ctx, labels25, l_done)
    _patch_local_fixups(ctx, labels25, fixups25)

    _intr_tmp_pop(ctx, base25)
    return true
}

