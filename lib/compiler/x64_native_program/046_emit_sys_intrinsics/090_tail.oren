    return false
}

fn _emit_intrinsic_sys_linux_proc_clone_x64(ctx, nm, expr, locals, args, capsule) {
    if nm == "sys_clone" {
        if oren_list_len(args) != 5 { err(ctx, "x64 native v0: sys_clone expects 5 args"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_clone does not support spread"); return true }

        var base15 = _intr_tmp_push(ctx, 5) // flags, stack, ptid, ctid, tls
        if oren_type_tag(base15) == 0 { return true }
        var tmp_flags = _intr_tmp_off(ctx, locals, base15 + 0)
        var tmp_stack = _intr_tmp_off(ctx, locals, base15 + 1)
        var tmp_ptid = _intr_tmp_off(ctx, locals, base15 + 2)
        var tmp_ctid = _intr_tmp_off(ctx, locals, base15 + 3)
        var tmp_tls = _intr_tmp_off(ctx, locals, base15 + 4)
        if oren_type_tag(tmp_flags) == 0 || oren_type_tag(tmp_stack) == 0 || oren_type_tag(tmp_ptid) == 0 || oren_type_tag(tmp_ctid) == 0 || oren_type_tag(tmp_tls) == 0 {
            _intr_tmp_pop(ctx, base15)
            return true
        }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_flags)
        _intr_eval_spill_x64(ctx, locals, args[1], tmp_stack)
        _intr_eval_spill_x64(ctx, locals, args[2], tmp_ptid)
        _intr_eval_spill_x64(ctx, locals, args[3], tmp_ctid)
        _intr_eval_spill_x64(ctx, locals, args[4], tmp_tls)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base15); return true }

        // pre: native_capsule_sys_clone_pre()
        if capsule {
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_clone_pre")
        }

        _intr_load_x64(ctx, 7, tmp_flags) // rdi = flags
        _intr_load_x64(ctx, 6, tmp_stack) // rsi = stack
        _intr_load_x64(ctx, 2, tmp_ptid)  // rdx = ptid
        _intr_load_x64(ctx, 10, tmp_ctid) // r10 = ctid
        _intr_load_x64(ctx, 8, tmp_tls)   // r8 = tls
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_clone()))
        bytes_extend(ctx["code"], core.insn_syscall())

        _intr_tmp_pop(ctx, base15)
        return true
    }
    
    if nm == "sys_thread_create" {
        // Linux-only syscall-first OS thread create (clone wrapper).
        // Signature: sys_thread_create(start_addr, arg_ptr, stack_top, ctid_ptr) -> tid or -errno.
        if oren_list_len(args) != 4 { err(ctx, "x64 native v0: sys_thread_create expects 4 args"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_thread_create does not support spread"); return true }

        var base_tc = _intr_tmp_push(ctx, 4) // start_addr, arg_ptr, stack_top, ctid_ptr
        if oren_type_tag(base_tc) == 0 { return true }
        var tmp_start = _intr_tmp_off(ctx, locals, base_tc + 0)
        var tmp_arg = _intr_tmp_off(ctx, locals, base_tc + 1)
        var tmp_stack_top = _intr_tmp_off(ctx, locals, base_tc + 2)
        var tmp_ctid = _intr_tmp_off(ctx, locals, base_tc + 3)
        if oren_type_tag(tmp_start) == 0 || oren_type_tag(tmp_arg) == 0 || oren_type_tag(tmp_stack_top) == 0 || oren_type_tag(tmp_ctid) == 0 {
            _intr_tmp_pop(ctx, base_tc)
            return true
        }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_start)
        _intr_eval_spill_x64(ctx, locals, args[1], tmp_arg)
        _intr_eval_spill_x64(ctx, locals, args[2], tmp_stack_top)
        _intr_eval_spill_x64(ctx, locals, args[3], tmp_ctid)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base_tc); return true }

        // Only lower this intrinsic for non-Windows targets.
        //
        // IMPORTANT: do not infer the target OS from ABI details (shadow space, arg regs, ...):
        // we generate Linux syscalls here, and some rolling build paths may temporarily select
        // a Windows-ish ABI shape while still targeting ELF/Linux.
        var platform_tc = ctx["platform"]
        if platform_tc != nil && platform_tc["os"] == "windows" {
            _emit_return_enosys_x64(ctx)
            _intr_tmp_pop(ctx, base_tc)
            return true
        }

        // pre: native_capsule_sys_clone_pre()
        // (sys_thread_create is a clone wrapper; reuse the same capsule hook.)
        if capsule {
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_clone_pre")
        }

        // Linux clone(2) flags for a real OS thread in the same address space:
        //   CLONE_VM | CLONE_FS | CLONE_FILES | CLONE_SIGHAND | CLONE_THREAD | CLONE_SYSVSEM |
        //   CLONE_PARENT_SETTID | CLONE_CHILD_CLEARTID | CLONE_CHILD_SETTID
        //
        // Constants verified against:
        //   project-doc/web/linux/include_uapi_linux_sched.h
        var flags = 0x01350F00

        // Preserve the start routine and argument across the clone syscall in callee-saved regs.
        //
        // Rationale:
        // - `syscall` clobbers RCX/R11 (per the x86_64 ABI), but preserves other GPRs.
        // - Using registers avoids relying on "write start/arg onto child stack" encodings, which
        //   are easy to get subtly wrong with REX prefixes and can crash immediately in the child.
        _intr_load_x64(ctx, 12, tmp_start) // r12 = start_addr
        _intr_load_x64(ctx, 13, tmp_arg)   // r13 = arg_ptr

        // Set child's SP to stack_top aligned down to 16 so that *before* `call`,
        // RSP is 16-byte aligned (SysV ABI). After `call` pushes a return address,
        // the callee sees the standard RSP%16==8 at function entry.
        _intr_load_x64(ctx, 6, tmp_stack_top) // rsi = stack_top
        // NOTE: `core.insn_and_r64_imm32` takes an *unsigned* u32 immediate. Use 0xFFFFFFF0 for -16.
        // See similar usage in `x64_native_program/040_emit_expr.oren`.
        bytes_extend(ctx["code"], core.insn_and_r64_imm32(6, 4294967280)) // align down to 16

        // clone(flags, child_stack, ptid, ctid, tls)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, flags)) // edi = flags
        _intr_load_x64(ctx, 2, tmp_ctid)  // rdx = ptid (reuse ctid_ptr for parent_tid)
        _intr_load_x64(ctx, 10, tmp_ctid) // r10 = ctid_ptr
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8)) // r8 = tls = 0
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_clone()))
        bytes_extend(ctx["code"], core.insn_syscall())

        // If child: run start(arg) and then sys_exit(0). Never return to caller frame.
        var labels_tc = {}
        var fixups_tc = []
        var l_tc_done = _new_label(ctx, "tc_done")
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
        _emit_jcc_to_label(ctx, fixups_tc, "ne", l_tc_done)

        // Child init (allocator hygiene):
        // The x64 native bump allocator state lives in callee-saved registers:
        //   - R15 = heap_ptr
        //   - R14 = heap_limit
        //
        // `clone(2)` threads inherit parent register contents, so without resetting R14/R15
        // the parent and child can allocate from the same bump region concurrently.
        // Reset so the first allocation in the child takes the slow path (mmap) and seeds
        // per-thread bump state.
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(14, 14)) // r14 = 0
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(15, 15)) // r15 = 0

        // Child path: call start_addr(arg_ptr)
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 13)) // rdi = r13 (arg_ptr)
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 12)) // rax = r12 (start_addr)
        bytes_extend(ctx["code"], core.insn_call_rax())

        // sys_exit(0)
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(7, 7)) // rdi = 0
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_exit()))
        bytes_extend(ctx["code"], core.insn_syscall())

        _emit_label(ctx, labels_tc, l_tc_done)
        _patch_local_fixups(ctx, labels_tc, fixups_tc)

        _intr_tmp_pop(ctx, base_tc)
        return true
    }

    if nm == "sys_gettid" {
        if oren_list_len(args) != 0 { err(ctx, "x64 native v0: sys_gettid expects 0 args"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_gettid does not support spread"); return true }
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_gettid()))
        bytes_extend(ctx["code"], core.insn_syscall())
        return true
    }

    return false
}

fn _emit_intrinsic_sys_linux_proc_x64(ctx, nm, expr, locals, args, capsule) {
    if _emit_intrinsic_sys_linux_proc_exec_x64(ctx, nm, expr, locals, args, capsule) == true { return nil }
    if _emit_intrinsic_sys_linux_proc_memory_x64(ctx, nm, expr, locals, args, capsule) == true { return nil }
    if _emit_intrinsic_sys_linux_proc_clone_x64(ctx, nm, expr, locals, args, capsule) == true { return nil }
    return _emit_intrinsic_sys_linux_misc_x64(ctx, nm, expr, locals, args, capsule)
}

fn _emit_intrinsic_sys_linux_fd_misc_x64(ctx, nm, expr, locals, args, capsule) {
    if _emit_intrinsic_sys_linux_fcntl_x64(ctx, nm, expr, locals, args, capsule) == true { return true }
    if _emit_intrinsic_sys_linux_dup_ioctl_x64(ctx, nm, expr, locals, args, capsule) == true { return true }
    return false
}

fn _emit_intrinsic_sys_linux_signal_x64(ctx, nm, expr, locals, args, capsule) {
    if nm == "sys_kill" {
        if oren_list_len(args) != 2 { err(ctx, "x64 native v0: sys_kill expects 2 args"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_kill does not support spread"); return true }

        var base22 = _intr_tmp_push(ctx, 2) // pid, signum
        if oren_type_tag(base22) == 0 { return true }
        var tmp_pid = _intr_tmp_off(ctx, locals, base22 + 0)
        var tmp_sig = _intr_tmp_off(ctx, locals, base22 + 1)
        if oren_type_tag(tmp_pid) == 0 || oren_type_tag(tmp_sig) == 0 { _intr_tmp_pop(ctx, base22); return true }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_pid)
        _intr_eval_spill_x64(ctx, locals, args[1], tmp_sig)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base22); return true }

        // pre: native_capsule_sys_kill_pre(pid, signum)
        if capsule {
            _intr_load_x64(ctx, 7, tmp_pid)
            _intr_load_x64(ctx, 6, tmp_sig)
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_kill_pre")
        }

        _intr_load_x64(ctx, 7, tmp_pid)
        _intr_load_x64(ctx, 6, tmp_sig)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_kill()))
        bytes_extend(ctx["code"], core.insn_syscall())

        _intr_tmp_pop(ctx, base22)
        return true
    }

    return false
}

fn _emit_intrinsic_sys_linux_time_x64(ctx, nm, expr, locals, args, capsule) {
    if nm == "sys_gettimeofday" {
        if oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_gettimeofday expects 3 args"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_gettimeofday does not support spread"); return true }

        // Also reserve a 16-byte timespec scratch so we can optionally provide a
        // monotonic raw timestamp via clock_gettime(CLOCK_MONOTONIC) on Linux.
        //
        // IMPORTANT (x64-linux stack direction):
        // Intrinsic temp stack slots are addressed as `[rbp - off]`, and `off` grows down the stack.
        // For `struct timespec { sec(u64) at +0, nsec(u64) at +8 }`, we must pass a base pointer
        // where the +8 write lands in the adjacent slot *without* clobbering other spills.
        //
        // Concretely, if we allocate two adjacent 8-byte slots:
        // - the deeper slot (larger `off`) is a lower address
        // - the shallower slot (smaller `off`) is a higher address
        //
        // We pass the deeper slot as the timespec base so the kernel's "+8" write lands in
        // the shallower slot.
        var base23 = _intr_tmp_push(ctx, 5) // tv, tz, abs, ts_hi, ts_lo
        if oren_type_tag(base23) == 0 { return true }
        var tmp_tv = _intr_tmp_off(ctx, locals, base23 + 0)
        var tmp_tz = _intr_tmp_off(ctx, locals, base23 + 1)
        var tmp_abs = _intr_tmp_off(ctx, locals, base23 + 2)
        var tmp_ts_hi = _intr_tmp_off(ctx, locals, base23 + 3) // higher address (base+8)
        var tmp_ts_lo = _intr_tmp_off(ctx, locals, base23 + 4) // lower address  (base+0)
        if oren_type_tag(tmp_tv) == 0 || oren_type_tag(tmp_tz) == 0 || oren_type_tag(tmp_abs) == 0 ||
           oren_type_tag(tmp_ts_hi) == 0 || oren_type_tag(tmp_ts_lo) == 0 {
            _intr_tmp_pop(ctx, base23)
            return true
        }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_tv)
        _intr_eval_spill_x64(ctx, locals, args[1], tmp_tz)
        _intr_eval_spill_x64(ctx, locals, args[2], tmp_abs)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base23); return true }

        // pre: native_capsule_sys_gettimeofday_pre(tv, tz, abs)
        if capsule {
            _intr_load_x64(ctx, 7, tmp_tv)
            _intr_load_x64(ctx, 6, tmp_tz)
            _intr_load_x64(ctx, 2, tmp_abs)
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_gettimeofday_pre")
        }

        // Linux syscall gettimeofday(tv, tz) ignores abs_ptr; keep signature stable.
        _intr_load_x64(ctx, 7, tmp_tv)
        _intr_load_x64(ctx, 6, tmp_tz)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_gettimeofday()))
        bytes_extend(ctx["code"], core.insn_syscall())

        // Best-effort monotonic raw time:
        // If abs_ptr is non-null, fill *abs_ptr with CLOCK_MONOTONIC time in nanoseconds.
        //
        // This keeps the runtime signature stable across OSes:
        // - Darwin: gettimeofday syscall provides a 3rd out-arg for mach_absolute_time ticks.
        // - Windows: sys_gettimeofday lowering provides QueryPerformanceCounter ticks.
        // - Linux: we synthesize it via clock_gettime(CLOCK_MONOTONIC) and normalize to ns.
        //
        // NOTE: We intentionally do not fail the sys_gettimeofday call if clock_gettime fails;
        // abs_ptr is an optional out-arg for higher-level runtime services.
        var labels = {}
        var fixups = []
        var l_abs_done = _new_label(ctx, "sys_gettimeofday_abs_done")
        _intr_load_x64(ctx, 11, tmp_abs) // r11 = abs_ptr
        // abs_ptr == 0 => skip
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
        _emit_jcc_to_label(ctx, fixups, "e", l_abs_done)
        // abs_ptr < 4096 => skip (avoid dereferencing obvious non-pointers)
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 4096))
        _emit_jcc_to_label(ctx, fixups, "l", l_abs_done)

        // clock_gettime(CLOCK_MONOTONIC=1, &timespec)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, 1)) // rdi = CLOCK_MONOTONIC
        _emit_addr_rbp_minus_off_x64(ctx, 6, tmp_ts_lo)     // rsi = &timespec (sec at +0, nsec at +8)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_clock_gettime()))
        bytes_extend(ctx["code"], core.insn_syscall())

        // ns = sec*1e9 + nsec
        _emit_mov_r64_mrbp(ctx, 10, 0 - tmp_ts_lo) // r10 = sec
        bytes_extend(ctx["code"], core.insn_imul_r64_imm32(10, 1000000000))
        _emit_mov_r64_mrbp(ctx, 9, 0 - tmp_ts_hi) // r9 = nsec
        bytes_extend(ctx["code"], core.insn_add_r64_r64(10, 9))
        // *abs_ptr = ns
        // NOTE: Linux `syscall` clobbers r11, so reload abs_ptr after clock_gettime.
        _intr_load_x64(ctx, 11, tmp_abs)
        bytes_extend(ctx["code"], core.insn_mov_mr64_r64(11, 10))

        _emit_label(ctx, labels, l_abs_done)
        _patch_local_fixups(ctx, labels, fixups)

        _intr_tmp_pop(ctx, base23)
        return true
    }

    return false
}

fn _emit_intrinsic_sys_linux_cwd_sched_sleep_x64(ctx, nm, expr, locals, args, capsule) {
    if nm == "sys_getcwd" {
        if oren_list_len(args) != 2 { err(ctx, "x64 native v0: sys_getcwd expects 2 args"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_getcwd does not support spread"); return true }

        var base24 = _intr_tmp_push(ctx, 2) // buf, size
        if oren_type_tag(base24) == 0 { return true }
        var tmp_buf = _intr_tmp_off(ctx, locals, base24 + 0)
        var tmp_sz = _intr_tmp_off(ctx, locals, base24 + 1)
        if oren_type_tag(tmp_buf) == 0 || oren_type_tag(tmp_sz) == 0 { _intr_tmp_pop(ctx, base24); return true }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_buf)
        _intr_eval_spill_x64(ctx, locals, args[1], tmp_sz)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base24); return true }

        // pre: native_capsule_sys_getcwd_pre()
        if capsule { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_getcwd_pre") }

        _intr_load_x64(ctx, 7, tmp_buf)
        _intr_load_x64(ctx, 6, tmp_sz)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_getcwd()))
        bytes_extend(ctx["code"], core.insn_syscall())

        _intr_tmp_pop(ctx, base24)
        return true
    }

    if nm == "sys_sched_yield" {
        if args != nil && oren_list_len(args) != 0 { err(ctx, "x64 native v0: sys_sched_yield expects 0 args"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_sched_yield does not support spread"); return true }

        // pre: native_capsule_sys_sched_yield_pre()
        if capsule { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_sched_yield_pre") }

        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_sched_yield()))
        bytes_extend(ctx["code"], core.insn_syscall())
        return true
    }

    if nm == "sys_nanosleep" {
        if oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_nanosleep expects 1 arg"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_nanosleep does not support spread"); return true }

        var base25 = _intr_tmp_push(ctx, 1) // ns
        if oren_type_tag(base25) == 0 { return true }
        var tmp_ns = _intr_tmp_off(ctx, locals, base25 + 0)
        if oren_type_tag(tmp_ns) == 0 { _intr_tmp_pop(ctx, base25); return true }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_ns)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base25); return true }

        // pre: native_capsule_sys_nanosleep_pre(ns) -> ns (may return <=0 to skip sleep)
        if capsule {
            _intr_load_x64(ctx, 7, tmp_ns) // rdi = ns
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_nanosleep_pre")
            _emit_mov_mrbp_r64(ctx, 0 - tmp_ns, 0) // spill adjusted ns
        }

        // Fast path: ns <= 0 => return 0 (skip syscall).
        var labels25 = {}
        var fixups25 = []
        var l_do = _new_label(ctx, "sys_nanosleep_do")
        var l_done = _new_label(ctx, "sys_nanosleep_done")
        _intr_load_x64(ctx, 0, tmp_ns) // rax = ns
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
        _emit_jcc_to_label(ctx, fixups25, "g", l_do)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
        bytes_extend(ctx["code"], core.insn_cdqe())
        _emit_jmp_to_label(ctx, fixups25, l_done)

        _emit_label(ctx, labels25, l_do)

        // Linux x86_64: nanosleep(const struct timespec* req, struct timespec* rem)
        // Build `struct timespec { tv_sec(u64), tv_nsec(u64) }` on the stack.
        //
        // IMPORTANT (Tier‑1 x64 correctness):
        // Do not rely on rbp-indexed intrinsic-temp slots for syscall argument structs here.
        // Use an explicit 16B scratch area on RSP so the pointer we pass to the kernel is
        // contiguous and independent of local-slot layout.
        //
        // - tv_sec  = ns / 1_000_000_000
        // - tv_nsec = ns % 1_000_000_000
        //
        // Syscall ABI:
        // - rax = __NR_nanosleep (35)
        // - rdi = &timespec
        // - rsi = NULL
        // rax = ns
        _intr_load_x64(ctx, 0, tmp_ns)
        // rdx:rax = sign-extend rax (ns is positive here)
        bytes_extend(ctx["code"], core.insn_cqo())
        // rcx = 1_000_000_000
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(1, 1000000000))
        // rax = sec, rdx = nsec
        bytes_extend(ctx["code"], core.insn_idiv_r64(1))

        // Allocate a 16B scratch timespec on RSP (keeps alignment).
        bytes_extend(ctx["code"], core.insn_sub_rsp_imm32(16))
        // [rsp+0] = tv_sec (rax)
        _emit_mov_mrsp_r64(ctx, 0, 0)
        // [rsp+8] = tv_nsec (rdx)
        _emit_mov_mrsp_r64(ctx, 8, 2)

        // rdi = req = rsp
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 4)) // rdi = rsp
        // rsi = rem = 0
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(6, 0))

        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_nanosleep()))
        bytes_extend(ctx["code"], core.insn_syscall())
        bytes_extend(ctx["code"], core.insn_add_rsp_imm32(16))

        _emit_label(ctx, labels25, l_done)
        _patch_local_fixups(ctx, labels25, fixups25)

        _intr_tmp_pop(ctx, base25)
        return true
    }

    return false
}

fn _emit_intrinsic_sys_linux_misc_x64(ctx, nm, expr, locals, args, capsule) {
    if _emit_intrinsic_sys_linux_fd_misc_x64(ctx, nm, expr, locals, args, capsule) == true { return nil }
    if _emit_intrinsic_sys_linux_signal_x64(ctx, nm, expr, locals, args, capsule) != false { return nil }
    if _emit_intrinsic_sys_linux_time_x64(ctx, nm, expr, locals, args, capsule) != false { return nil }
    if _emit_intrinsic_sys_linux_cwd_sched_sleep_x64(ctx, nm, expr, locals, args, capsule) != false { return nil }

    if _emit_intrinsic_sys_linux_net_x64(ctx, nm, expr, locals, args, capsule) { return nil }

    err(ctx, "x64 native v0: unhandled syscall intrinsic: " + nm)
    return nil
}
