fn _emit_intrinsic_sys_linux_windows_compat_x64(ctx, nm, expr, args) {
    if nm == "sys_qpc_frequency" {
        // Windows-only intrinsic (QueryPerformanceFrequency).
        // On non-Windows targets we still want builds to succeed, because sources commonly gate
        // the call at runtime via `if g_target_os == 3 { ... }`, but the compiler still must lower
        // the call site while parsing/compiling the full function body.
        //
        // Return -ENOSYS so accidental non-Windows calls fail cleanly.
        if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_qpc_frequency expects 1 arg"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_qpc_frequency does not support spread"); return nil }
        _emit_return_enosys_x64(ctx)
        return true
    }

    if nm == "sys_create_io_completion_port" {
        // Windows-only intrinsic (CreateIoCompletionPort).
        if args == nil || oren_list_len(args) != 4 { err(ctx, "x64 native v0: sys_create_io_completion_port expects 4 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_create_io_completion_port does not support spread"); return nil }
        _emit_return_enosys_x64(ctx)
        return true
    }
    if nm == "sys_get_queued_completion_status_ex" {
        // Windows-only intrinsic (GetQueuedCompletionStatusEx).
        if args == nil || oren_list_len(args) != 6 { err(ctx, "x64 native v0: sys_get_queued_completion_status_ex expects 6 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_get_queued_completion_status_ex does not support spread"); return nil }
        _emit_return_enosys_x64(ctx)
        return true
    }
    if nm == "sys_post_queued_completion_status" {
        // Windows-only intrinsic (PostQueuedCompletionStatus).
        if args == nil || oren_list_len(args) != 4 { err(ctx, "x64 native v0: sys_post_queued_completion_status expects 4 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_post_queued_completion_status does not support spread"); return nil }
        _emit_return_enosys_x64(ctx)
        return true
    }
    if nm == "sys_cancel_io_ex" {
        // Windows-only intrinsic (CancelIoEx).
        if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: sys_cancel_io_ex expects 2 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_cancel_io_ex does not support spread"); return nil }
        _emit_return_enosys_x64(ctx)
        return true
    }

    if nm == "sys_wsarecv" {
        // Windows-only intrinsic (WSARecv overlapped).
        if args == nil || oren_list_len(args) != 6 { err(ctx, "x64 native v0: sys_wsarecv expects 6 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_wsarecv does not support spread"); return nil }
        _emit_return_enosys_x64(ctx)
        return true
    }
    if nm == "sys_wsarecvfrom" {
        // Windows-only intrinsic (WSARecvFrom overlapped).
        if args == nil || oren_list_len(args) != 8 { err(ctx, "x64 native v0: sys_wsarecvfrom expects 8 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_wsarecvfrom does not support spread"); return nil }
        _emit_return_enosys_x64(ctx)
        return true
    }
    if nm == "sys_wsasend" {
        // Windows-only intrinsic (WSASend overlapped).
        if args == nil || oren_list_len(args) != 6 { err(ctx, "x64 native v0: sys_wsasend expects 6 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_wsasend does not support spread"); return nil }
        _emit_return_enosys_x64(ctx)
        return true
    }

    return false
}

fn _emit_intrinsic_sys_linux_random_x64(ctx, nm, expr, locals, args) {
    if nm == "sys_getentropy" {
        // Linux x86_64: no getentropy syscall; return -ENOSYS and let runtime fall back to getrandom.
        _emit_return_enosys_x64(ctx)
        return true
    }

    if nm == "sys_getrandom" {
        // sys_getrandom(buf, len, flags) -> nbytes or -errno (Linux x86_64 getrandom syscall)
        if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_getrandom expects 3 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_getrandom does not support spread"); return nil }

        var base = _intr_tmp_push(ctx, 3) // buf, len, flags
        if oren_type_tag(base) == 0 { return nil }
        var tmp_buf = _intr_tmp_off(ctx, locals, base + 0)
        var tmp_len = _intr_tmp_off(ctx, locals, base + 1)
        var tmp_flags = _intr_tmp_off(ctx, locals, base + 2)
        if oren_type_tag(tmp_buf) == 0 || oren_type_tag(tmp_len) == 0 || oren_type_tag(tmp_flags) == 0 { _intr_tmp_pop(ctx, base); return nil }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_buf)
        _intr_eval_spill_x64(ctx, locals, args[1], tmp_len)
        _intr_eval_spill_x64(ctx, locals, args[2], tmp_flags)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

        // rdi=buf, rsi=len, rdx=flags
        _intr_load_x64(ctx, 7, tmp_buf)
        _intr_load_x64(ctx, 6, tmp_len)
        _intr_load_x64(ctx, 2, tmp_flags)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_getrandom()))
        bytes_extend(ctx["code"], core.insn_syscall())

        _intr_tmp_pop(ctx, base)
        return true
    }

    return false
}

fn _emit_intrinsic_sys_linux_ulock_x64(ctx, nm, expr, locals, args) {
    if nm == "sys_ulock_wait" {
        // NOTE (portability): despite the Darwin-y name, the native runtime uses sys_ulock_wait/wake
        // as a portable "wait-on-address" primitive for internal locks.
        //
        // Linux mapping: futex(FUTEX_WAIT_PRIVATE).
        if args == nil || oren_list_len(args) != 4 { err(ctx, "x64 native v0: sys_ulock_wait expects 4 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_ulock_wait does not support spread"); return nil }

        // args: (operation, addr, value, timeout_us)
        // We currently implement only the lock use-case:
        // - operation=UL_COMPARE_AND_WAIT (1)
        // - timeout_us=0 (forever)
        var base_ulw = _intr_tmp_push(ctx, 3) // addr, value, timeout_us
        if oren_type_tag(base_ulw) == 0 { return nil }
        var tmp_addr = _intr_tmp_off(ctx, locals, base_ulw + 0)
        var tmp_val = _intr_tmp_off(ctx, locals, base_ulw + 1)
        var tmp_to = _intr_tmp_off(ctx, locals, base_ulw + 2)
        if oren_type_tag(tmp_addr) == 0 || oren_type_tag(tmp_val) == 0 || oren_type_tag(tmp_to) == 0 { _intr_tmp_pop(ctx, base_ulw); return nil }

        _intr_eval_spill_x64(ctx, locals, args[1], tmp_addr)
        _intr_eval_spill_x64(ctx, locals, args[2], tmp_val)
        _intr_eval_spill_x64(ctx, locals, args[3], tmp_to)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base_ulw); return nil }

        // futex(uaddr, FUTEX_WAIT|PRIVATE, val, timeout, uaddr2=NULL, val3=0)
        _intr_load_x64(ctx, 7, tmp_addr) // rdi = uaddr
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(6, 128)) // esi = FUTEX_WAIT_PRIVATE

        // timeout:
        // - timeout_us==0 => timeout=NULL (wait forever)
        // - else => build a stack timespec and pass pointer (relative timeout)
        //
        // NOTE: Linux futex(2) expects `struct timespec { long tv_sec; long tv_nsec; }`.
        // We allocate 16 bytes on the stack unconditionally and pass NULL when timeout_us==0.
        _intr_load_x64(ctx, 1, tmp_to) // rcx = timeout_us
        bytes_extend(ctx["code"], core.insn_sub_rsp_imm8(16))
        var labels_to = {}
        var fixups_to = []
        var l_no_to = _new_label(ctx, "ulw_no_timeout")
        var l_to_done = _new_label(ctx, "ulw_timeout_done")
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(1, 0))
        _emit_jcc_to_label(ctx, fixups_to, "e", l_no_to)

        // rax = timeout_us; rdx = 0; rcx = 1_000_000; idiv rcx => rax=sec, rdx=rem_us
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 1))
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(2, 2))
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 1000000))
        bytes_extend(ctx["code"], core.insn_idiv_r64(1))
        // [rsp+0] = tv_sec
        bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_r64(0, 0))
        // tv_nsec = rem_us * 1000
        bytes_extend(ctx["code"], core.insn_imul_r64_imm32(2, 1000))
        bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_r64(8, 2))
        // r10 = &timespec
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 4))
        _emit_jmp_to_label(ctx, fixups_to, l_to_done)
        _emit_label(ctx, labels_to, l_no_to)
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(10, 10)) // r10 = NULL
        _emit_label(ctx, labels_to, l_to_done)
        _patch_local_fixups(ctx, labels_to, fixups_to)

        _intr_load_x64(ctx, 2, tmp_val)  // rdx = val
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8))   // r8 = uaddr2 = NULL
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(9, 9))   // r9 = val3 = 0
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_futex()))
        bytes_extend(ctx["code"], core.insn_syscall())
        bytes_extend(ctx["code"], core.insn_add_rsp_imm8(16))

        // Portability: normalize Linux futex timeout to Oren's portable -60 (Darwin ETIMEDOUT).
        //
        // Linux futex returns -ETIMEDOUT (-110) when the relative timespec expires.
        // Many runtime paths (and tests) use -60 as the cross-platform "timeout" code.
        var labels_tmo = {}
        var fixups_tmo = []
        var l_tmo_done = _new_label(ctx, "ulw_tmo_done")
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 4294967186)) // -110
        _emit_jcc_to_label(ctx, fixups_tmo, "ne", l_tmo_done)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 4294967236)) // -60
        bytes_extend(ctx["code"], core.insn_cdqe())
        _emit_label(ctx, labels_tmo, l_tmo_done)
        _patch_local_fixups(ctx, labels_tmo, fixups_tmo)

        // Normalize: non-negative => 0, negative => -errno.
        var labels_ulw = {}
        var fixups_ulw = []
        var l_ulw_ok = _new_label(ctx, "ulw_ok")
        var l_ulw_done = _new_label(ctx, "ulw_done")
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
        _emit_jcc_to_label(ctx, fixups_ulw, "ge", l_ulw_ok)
        _emit_jmp_to_label(ctx, fixups_ulw, l_ulw_done)
        _emit_label(ctx, labels_ulw, l_ulw_ok)
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 0))
        _emit_label(ctx, labels_ulw, l_ulw_done)
        _patch_local_fixups(ctx, labels_ulw, fixups_ulw)

        _intr_tmp_pop(ctx, base_ulw)
        return true
    }

    if nm == "sys_ulock_wake" {
        // Linux mapping: futex(FUTEX_WAKE_PRIVATE).
        if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_ulock_wake expects 3 args"); return nil }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_ulock_wake does not support spread"); return nil }

        // args: (operation, addr, wake_value)
        // Runtime lock uses wake-all; normalize to wake-all (INT_MAX).
        var base_ulk = _intr_tmp_push(ctx, 1) // addr
        if oren_type_tag(base_ulk) == 0 { return nil }
        var tmp_addr2 = _intr_tmp_off(ctx, locals, base_ulk + 0)
        if oren_type_tag(tmp_addr2) == 0 { _intr_tmp_pop(ctx, base_ulk); return nil }
        _intr_eval_spill_x64(ctx, locals, args[1], tmp_addr2)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base_ulk); return nil }

        _intr_load_x64(ctx, 7, tmp_addr2) // rdi=uaddr
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(6, 129)) // esi = FUTEX_WAKE_PRIVATE
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 2147483647)) // edx = INT_MAX (wake all)
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(10, 10)) // r10 = timeout = NULL
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8))   // r8 = uaddr2 = NULL
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(9, 9))   // r9 = val3 = 0
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_futex()))
        bytes_extend(ctx["code"], core.insn_syscall())

        // Normalize: non-negative => 0, negative => -errno.
        var labels_ulk = {}
        var fixups_ulk = []
        var l_ulk_ok = _new_label(ctx, "ulk_ok")
        var l_ulk_done = _new_label(ctx, "ulk_done")
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
        _emit_jcc_to_label(ctx, fixups_ulk, "ge", l_ulk_ok)
        _emit_jmp_to_label(ctx, fixups_ulk, l_ulk_done)
        _emit_label(ctx, labels_ulk, l_ulk_ok)
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 0))
        _emit_label(ctx, labels_ulk, l_ulk_done)
        _patch_local_fixups(ctx, labels_ulk, fixups_ulk)

        _intr_tmp_pop(ctx, base_ulk)
        return true
    }

    return false
}

fn _emit_intrinsic_sys_linux_x64(ctx, nm, expr, locals, args) {
    if nm == "sys_read" { return _emit_intrinsic_sys_read_x64(ctx, expr, locals, args) }
    if nm == "sys_write" { return _emit_intrinsic_sys_write_x64(ctx, expr, locals, args) }
    if nm == "sys_exit" { return _emit_intrinsic_sys_exit_x64(ctx, expr, locals, args) }
    if _emit_intrinsic_sys_linux_windows_compat_x64(ctx, nm, expr, args) != false { return nil }
    if _emit_intrinsic_sys_linux_random_x64(ctx, nm, expr, locals, args) != false { return nil }
    if _emit_intrinsic_sys_linux_ulock_x64(ctx, nm, expr, locals, args) != false { return nil }

    if args == nil { args = [] }
    var capsule = _x64_capsule_enabled(ctx)

    return _emit_intrinsic_sys_linux_fs_x64(ctx, nm, expr, locals, args, capsule)
}

fn _emit_intrinsic_sys_linux_runtime_stub_x64(ctx, nm) {
    // Windows-only helpers that may appear in the injected runtime but must never lower on Linux.
    // Keep them as explicit -ENOSYS so cross-target builds remain deterministic.
    //
    // NOTE: the injected runtime is a single portable source that contains Windows-only branches
    // guarded by `g_target_os`. The compiler still must be able to compile those branches when
    // cross-targeting Linux, so we treat these names as "return -ENOSYS" rather than hard errors.
    if nm == "sys_wsa_startup" || nm == "sys_wsa_get_last_error" || nm == "sys_select" ||
        nm == "sys_win_createprocess" ||
        nm == "sys_win_createthread" || nm == "sys_win_wait_single_object" || nm == "sys_win_terminate_thread" || nm == "sys_win_close_handle" {
        _emit_return_enosys_x64(ctx)
        return true
    }

    return false
}

fn _emit_intrinsic_sys_linux_pipe_x64(ctx, nm, expr, locals, args, capsule) {
    if nm == "sys_pipe" {
        if oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_pipe expects 1 arg"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_pipe does not support spread"); return true }

        var base = _intr_tmp_push(ctx, 2) // ptr, rc
        if oren_type_tag(base) == 0 { return true }
        var tmp_ptr = _intr_tmp_off(ctx, locals, base + 0)
        var tmp_rc = _intr_tmp_off(ctx, locals, base + 1)
        if oren_type_tag(tmp_ptr) == 0 || oren_type_tag(tmp_rc) == 0 { _intr_tmp_pop(ctx, base); return true }

        _emit_eval_int_to_rax(ctx, args[0], locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 0)) // rdi=ptr
        if capsule {
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_pipe_pre")
        } else {
            // rax = ptr
            bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 7))
        }
        _emit_mov_mrbp_r64(ctx, 0 - tmp_ptr, 0) // save ptr

        _intr_load_x64(ctx, 7, tmp_ptr) // rdi = ptr
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(6, 0)) // esi = flags=0
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_pipe2()))
        bytes_extend(ctx["code"], core.insn_syscall())
        _emit_mov_mrbp_r64(ctx, 0 - tmp_rc, 0) // save rc

        var labels = {}
        var fixups = []
        _intr_load_x64(ctx, 11, tmp_rc) // r11 = rc
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
        var l_skip_widen = _new_label(ctx, "pipe_skip_widen")
        _emit_jcc_to_label(ctx, fixups, "ne", l_skip_widen)

        // Widen int[2] (32-bit fds) into two u64 slots in-place.
        _intr_load_x64(ctx, 10, tmp_ptr) // r10 = ptr
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(11, 10)) // r11 = packed (wfd<<32 | rfd)

        // rfd = (u32)r11
        //
        // IMPORTANT: do not clobber RAX here: it carries the syscall return code (rc),
        // and callers commonly store/branch on it immediately after the intrinsic.
        bytes_extend(ctx["code"], core.insn_mov_r32_r32(8, 11)) // r8d = r11d => r8 = rfd (zero-extend)
        bytes_extend(ctx["code"], core.insn_mov_mr64_r64(10, 8)) // [ptr] = rfd (u64)

        // wfd = (u32)(r11 >> 32)
        bytes_extend(ctx["code"], core.insn_shr_r64_imm8(11, 32))
        bytes_extend(ctx["code"], core.insn_mov_r32_r32(8, 11)) // r8d = wfd (zero-extend)
        bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 8)) // ptr += 8
        bytes_extend(ctx["code"], core.insn_mov_mr64_r64(10, 8))  // [ptr+8] = wfd (u64)

        _emit_label(ctx, labels, l_skip_widen)
        _patch_local_fixups(ctx, labels, fixups)

        // IMPORTANT: preserve the syscall return value in RAX.
        //
        // The widening block above uses RAX as a scratch register when rewriting the two
        // 32-bit fds in-place, which would otherwise clobber the rc (0 on success).
        _intr_load_x64(ctx, 0, tmp_rc) // rax = rc

        // post: native_capsule_sys_pipe_post(ptr, rc) -> rc
        if capsule {
            _intr_load_x64(ctx, 7, tmp_ptr) // rdi = ptr
            _intr_load_x64(ctx, 6, tmp_rc)  // rsi = rc
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_pipe_post")
        }
        _intr_tmp_pop(ctx, base)
        return true
    }

    return false
}

fn _emit_intrinsic_sys_linux_open_close_access_x64(ctx, nm, expr, locals, args, capsule) {
    if nm == "sys_open" {
        if oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_open expects 3 args"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_open does not support spread"); return true }

        var base2 = _intr_tmp_push(ctx, 4) // path, flags, mode, pair
        if oren_type_tag(base2) == 0 { return true }
        var tmp_path = _intr_tmp_off(ctx, locals, base2 + 0)
        var tmp_flags = _intr_tmp_off(ctx, locals, base2 + 1)
        var tmp_mode = _intr_tmp_off(ctx, locals, base2 + 2)
        var tmp_pair = _intr_tmp_off(ctx, locals, base2 + 3)
        if oren_type_tag(tmp_path) == 0 || oren_type_tag(tmp_flags) == 0 || oren_type_tag(tmp_mode) == 0 || oren_type_tag(tmp_pair) == 0 { _intr_tmp_pop(ctx, base2); return true }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_path)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return true }
        _intr_eval_spill_x64(ctx, locals, args[1], tmp_flags)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return true }
        _intr_eval_spill_x64(ctx, locals, args[2], tmp_mode)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base2); return true }

        if capsule {
            // pre: native_capsule_sys_open_pre(path, flags) -> pair
            _intr_load_x64(ctx, 7, tmp_path)  // rdi = path
            _intr_load_x64(ctx, 6, tmp_flags) // rsi = flags
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_open_pre")
            _emit_mov_mrbp_r64(ctx, 0 - tmp_pair, 0) // save pair

            // Load resolved path_ptr from pair[0] into RSI.
            _intr_load_x64(ctx, 11, tmp_pair)              // r11 = pair
            bytes_extend(ctx["code"], core.insn_mov_r64_mr64(6, 11)) // rsi = *(u64*)pair
        } else {
            // No capsule path resolution: path is already a host cstr.
            _intr_load_x64(ctx, 6, tmp_path) // rsi = path
        }

        // rdx = os_flags (translated)
        _emit_translate_open_flags_linux_x64(ctx, locals, tmp_flags)
        // r10 = mode
        _intr_load_x64(ctx, 10, tmp_mode)

        // rdi = AT_FDCWD
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(7, labi.linux_at_fdcwd()))
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_openat()))
        bytes_extend(ctx["code"], core.insn_syscall())

        if capsule {
            // post: native_capsule_sys_open_post(pair, rc) -> rc
            bytes_extend(ctx["code"], core.insn_mov_r64_r64(6, 0)) // rsi = rc
            _intr_load_x64(ctx, 7, tmp_pair)                  // rdi = pair
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_open_post")
        }
        _intr_tmp_pop(ctx, base2)
        return true
    }

    if nm == "sys_close" {
        if oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_close expects 1 arg"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_close does not support spread"); return true }

        var base3 = _intr_tmp_push(ctx, 1) // fd
        if oren_type_tag(base3) == 0 { return true }
