fn _emit_intrinsic_sys_linux_proc_memory_x64(ctx, nm, expr, locals, args, capsule) {
    if nm == "sys_mmap_private_anon" {
        if oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_mmap_private_anon expects 1 arg"); return true }
        if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_mmap_private_anon does not support spread"); return true }

        var base13 = _intr_tmp_push(ctx, 1) // len
        if oren_type_tag(base13) == 0 { return true }
        var tmp_len = _intr_tmp_off(ctx, locals, base13 + 0)
        if oren_type_tag(tmp_len) == 0 { _intr_tmp_pop(ctx, base13); return true }

        _intr_eval_spill_x64(ctx, locals, args[0], tmp_len)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base13); return true }

        // pre: native_capsule_sys_mmap_private_anon_pre(len) -> len
        var is_win = false
        var sh = abi.caller_shadow_bytes(ctx["abi"])
        if sh != nil && sh > 0 { is_win = true }
        if is_win {
            _intr_load_x64(ctx, 1, tmp_len) // rcx = len
        } else {
            _intr_load_x64(ctx, 7, tmp_len) // rdi = len
        }
        if capsule {
            _emit_call_rel32_named_x64(ctx, "native_capsule_sys_mmap_private_anon_pre")
            _emit_mov_mrbp_r64(ctx, 0 - tmp_len, 0)
        }

        if is_win {
            _emit_sys_mmap_private_anon_windows_x64(ctx, locals, tmp_len)
        } else {
