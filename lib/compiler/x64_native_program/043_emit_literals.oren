// x64-native literal lowering helpers.
//
// These helpers keep literal building re-entrant so nested literals do not clobber
// fixed temp spill slots used by x64 intrinsics.

fn _lit_enter(ctx) {
    // IMPORTANT (native runtime / stage2-native compiler):
    // Do not use 0 as a valid "depth" value here because `nil/false/0` collapse to 0 today.
    // If we returned `0` for the common first literal, callers that check `== nil` would
    // treat it as failure and silently skip literal lowering (miscompile).
    //
    // Store and return the depth as `depth_enc = depth + 1`:
    // - depth 0..7   => depth_enc 1..8
    // - failure      => 0 (nil) sentinel
    var depth_enc = 1
    if ctx["lit_depth_enc"] != nil { depth_enc = ctx["lit_depth_enc"] }
    var depth = depth_enc - 1
    if depth >= 8 { err(ctx, "x64 native v0: literal nesting too deep"); return nil }
    ctx["lit_depth_enc"] = depth_enc + 1
    return depth_enc
}

fn _lit_exit(ctx, depth_enc) {
    ctx["lit_depth_enc"] = depth_enc
    return nil
}

fn _lit_cached_hdr_name(ctx, d0, names_key, fallback_prefix) {
    var hn = fallback_prefix + oren_int_to_string(d0)
    if ctx != nil && ctx[names_key] != nil {
        hn = oren_list_get(ctx[names_key], d0)
    }
    return hn
}

fn _lit_local_hdr_slot(locals, hn) {
    var tmp_hdr = locals[hn]
    if oren_type_tag(tmp_hdr) != 1 { return 0 }
    return tmp_hdr
}

fn _lit_fail(ctx, depth_enc0, msg) {
    _lit_exit(ctx, depth_enc0)
    err(ctx, msg)
    return nil
}

fn _lit_has_errors(ctx) {
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return true }
    return false
}

fn _lit_alloc_container_to_tmp(ctx, locals, ctor_name, n, tmp_hdr, depth_enc0) {
    var new_call = {
        "type": "Call",
        "fn": {"type": "Identifier", "token": nil, "value": ctor_name},
        "args": [{"type": "Integer", "value": oren_int_to_string(n)}],
    }
    _emit_eval_int_to_rax(ctx, new_call, locals)
    if _lit_has_errors(ctx) {
        _lit_exit(ctx, depth_enc0)
        return nil
    }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_hdr, 0)
    return true
}

fn _lit_hash_pair_key_kind(ctx, depth_enc0, pair) {
    if pair == nil {
        _lit_fail(ctx, depth_enc0, "x64 native v0: hash literal has nil pair")
        return nil
    }
    var k = pair["key"]
    var v = pair["value"]
    if k == nil || v == nil {
        _lit_fail(ctx, depth_enc0, "x64 native v0: hash literal missing key/value")
        return nil
    }
    if k["type"] == "Integer" { return 1 }
    if k["type"] == "String" { return 2 }
    _lit_fail(ctx, depth_enc0, "x64 native v0: hash literal key must be string literal or integer")
    return nil
}

fn _lit_hash_emit_set_pair(ctx, locals, hn, pair, key_kind, depth_enc0) {
    var set_nm = "oren_map_set_int"
    var kk = 0
    if key_kind == 2 {
        set_nm = "oren_map_set_str"
        kk = 1
    }
    var set_call = {
        "type": "Call",
        "fn": {"type": "Identifier", "token": nil, "value": set_nm},
        "args": [{"type": "Identifier", "token": nil, "value": hn}, pair["key"], pair["value"]],
        // Hash literals have deterministic key types, so annotate them explicitly.
        // Tier-1 determinism: x64 native does not infer map key kind at runtime.
        // Keep `known_key_kind` as an annotation for backends that consult it.
        "known_key_kind": kk,
    }
    _emit_eval_int_to_rax(ctx, set_call, locals)
    if _lit_has_errors(ctx) {
        _lit_exit(ctx, depth_enc0)
        return nil
    }
    return true
}

fn _lit_array_elements(expr) {
    var els = nil
    if expr != nil { els = expr["elements"] }
    if els == nil { els = [] }
    return els
}

fn _lit_array_trace_enabled(ctx) {
    if ctx != nil && ctx["trace_x64_array_lit"] != nil { return true }
    return false
}

fn _lit_array_trace_reserve(ctx) {
    var cnt = 0
    if ctx["__trace_x64_array_lit_cnt"] != nil { cnt = ctx["__trace_x64_array_lit_cnt"] }
    if cnt >= 16 { return false }
    ctx["__trace_x64_array_lit_cnt"] = cnt + 1
    return true
}

fn _lit_array_trace_fn_name(ctx) {
    var fnn = ctx["cur_fn_name"]
    if fnn == nil { fnn = "<nil>" }
    return fnn
}

fn _lit_array_trace_message(ctx, d0, hn, tmp_hdr, els) {
    return "[x64_array_lit] fn=" + _lit_array_trace_fn_name(ctx) +
        " depth=" + oren_int_to_string(d0) +
        " hn=" + hn +
        " off=" + oren_int_to_string(tmp_hdr) +
        " n=" + oren_int_to_string(oren_list_len(els))
}

fn _lit_array_trace(ctx, d0, hn, tmp_hdr, els) {
    if _lit_array_trace_enabled(ctx) != true { return nil }
    if _lit_array_trace_reserve(ctx) != true { return nil }
    print(_lit_array_trace_message(ctx, d0, hn, tmp_hdr, els))
    return nil
}

fn _lit_array_emit_push(ctx, locals, hn, elem, depth_enc0) {
    var push_call = {
        "type": "Call",
        "fn": {"type": "Identifier", "token": nil, "value": "oren_list_push_unchecked"},
        "args": [{"type": "Identifier", "token": nil, "value": hn}, elem],
    }
    _emit_eval_int_to_rax(ctx, push_call, locals)
    if _lit_has_errors(ctx) {
        _lit_exit(ctx, depth_enc0)
        return nil
    }
    return true
}

fn _lit_array_emit_elements(ctx, locals, hn, els, depth_enc0) {
    var i = 0
    var n = oren_list_len(els)
    while i < n {
        if _lit_array_emit_push(ctx, locals, hn, els[i], depth_enc0) == nil { return nil }
        i = i + 1
    }
    return true
}

fn _emit_array_literal_expr(ctx, expr, locals) {
    // Bounded trace for bring-up/debugging:
    //   OREN_TRACE_X64_ARRAY_LIT=1 ./oren_stage2 build ... --platform x64-linux --no-cache
    // List literal `[a, b, c]` lowered as a sequence of native runtime calls:
    // - list = oren_new_list(0)
    // - for each element: oren_list_push(list, elem)
    //
    // This matches the arm64 backend behavior and avoids baking list-layout offsets
    // into the x64 emitter (Tier‑1 arch unification).
    var els = _lit_array_elements(expr)

    var depth_enc0 = _lit_enter(ctx)
    if oren_type_tag(depth_enc0) == 0 { return nil }
    var d0 = depth_enc0 - 1

    // PERF (stage2-native compiler):
    // Avoid allocating `"$tmp_lit_list_hdr" + int_to_string(d0)` in hot literal lowering.
    // `080_functions_compile.oren` pre-populates the name list on `ctx`.
    var hn = _lit_cached_hdr_name(ctx, d0, "__x64_tmp_lit_list_hdr_names", "$tmp_lit_list_hdr")
    var tmp_hdr = _lit_local_hdr_slot(locals, hn)
    if tmp_hdr <= 0 {
        return _lit_fail(ctx, depth_enc0, "x64 native v0: missing literal spill slots for array literal")
    }
    _lit_array_trace(ctx, d0, hn, tmp_hdr, els)

    var n = oren_list_len(els)

    if _lit_alloc_container_to_tmp(ctx, locals, "oren_new_list", n, tmp_hdr, depth_enc0) == nil { return nil }

    // Push elements in order (LTR).
    if _lit_array_emit_elements(ctx, locals, hn, els, depth_enc0) == nil { return nil }

    // return list
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_hdr)
    _lit_exit(ctx, depth_enc0)
    return nil
}

fn _emit_hash_literal_expr(ctx, expr, locals) {
    // Map literal `{k: v, ...}` lowered as:
    // - allocate map with cap>=len
    // - insert pairs in source order via `oren_map_set_{int,str}`
    //
    // Key kinds (rolling x64 v0):
    // - Integer keys => kind=0
    // - String keys  => kind=1 (C-string pointer)
    var pairs = nil
    if expr != nil { pairs = expr["pairs"] }
    if pairs == nil { pairs = [] }

    var depth_enc0 = _lit_enter(ctx)
    if oren_type_tag(depth_enc0) == 0 { return nil }
    var d0 = depth_enc0 - 1

    // PERF (stage2-native compiler):
    // Same as list literals: use cached header temp names when available.
    var hn = _lit_cached_hdr_name(ctx, d0, "__x64_tmp_lit_map_hdr_names", "$tmp_lit_map_hdr")
    var tmp_hdr = _lit_local_hdr_slot(locals, hn)
    if tmp_hdr <= 0 {
        return _lit_fail(ctx, depth_enc0, "x64 native v0: missing literal spill slots for hash literal")
    }

    var n = oren_list_len(pairs)

    if _lit_alloc_container_to_tmp(ctx, locals, "oren_new_map", n, tmp_hdr, depth_enc0) == nil { return nil }

    // Insert pairs in source order (LTR).
    var i = 0
    while i < n {
        var pair = pairs[i]
        var key_kind = _lit_hash_pair_key_kind(ctx, depth_enc0, pair)
        if key_kind == nil { return nil }
        if _lit_hash_emit_set_pair(ctx, locals, hn, pair, key_kind, depth_enc0) == nil { return nil }

        i = i + 1
    }

    // return map
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_hdr)
    _lit_exit(ctx, depth_enc0)
    return nil
}
