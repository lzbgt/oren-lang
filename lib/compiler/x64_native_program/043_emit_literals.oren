// x64-native literal lowering helpers.
//
// These helpers keep literal building re-entrant so nested literals do not clobber
// fixed temp spill slots used by x64 intrinsics.

fn _lit_enter(ctx) {
    var d0 = 0
    if ctx["lit_depth"] != nil { d0 = ctx["lit_depth"] }
    if d0 >= 8 { err(ctx, "x64 native v0: literal nesting too deep"); return nil }
    ctx["lit_depth"] = d0 + 1
    return d0
}

fn _lit_exit(ctx, d0) {
    ctx["lit_depth"] = d0
    return nil
}

fn _emit_array_literal_expr(ctx, expr, locals) {
    // List literal `[a, b, c]` lowered as a sequence of native runtime calls:
    // - list = oren_new_list(0)
    // - for each element: oren_list_push(list, elem)
    //
    // This matches the arm64 backend behavior and avoids baking list-layout offsets
    // into the x64 emitter (Tier‑1 arch unification).
    var els = nil
    if expr != nil { els = expr["elements"] }
    if els == nil { els = [] }

    var d0 = _lit_enter(ctx)
    if d0 == nil { return nil }

    var hn = "$tmp_lit_list_hdr" + oren_int_to_string(d0)
    var bn = "$tmp_lit_list_buf" + oren_int_to_string(d0)
    var tmp_hdr = locals[hn]
    var tmp_buf = locals[bn]
    if tmp_hdr == nil || tmp_buf == nil {
        _lit_exit(ctx, d0)
        err(ctx, "x64 native v0: missing literal spill slots for array literal")
        return nil
    }

    var n = oren_list_len(els)

    // list = oren_new_list(0)
    var new_call = {
        "type": "Call",
        "fn": {"type": "Identifier", "token": nil, "value": "oren_new_list"},
        "args": [{"type": "Integer", "value": "0"}],
    }
    _emit_eval_int_to_rax(ctx, new_call, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
        _lit_exit(ctx, d0)
        return nil
    }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_hdr, 0)

    // Push elements in order (LTR).
    var i = 0
    while i < n {
        var push_call = {
            "type": "Call",
            "fn": {"type": "Identifier", "token": nil, "value": "oren_list_push"},
            "args": [{"type": "Identifier", "token": nil, "value": hn}, els[i]],
        }
        _emit_eval_int_to_rax(ctx, push_call, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
            _lit_exit(ctx, d0)
            return nil
        }
        i = i + 1
    }

    // return list
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_hdr)
    _lit_exit(ctx, d0)
    return nil
}

fn _emit_hash_literal_expr(ctx, expr, locals) {
    // Map literal `{k: v, ...}` lowered as:
    // - allocate map with cap>=len
    // - insert pairs in source order via `oren_map_set`
    //
    // Key kinds (rolling x64 v0):
    // - Integer keys => kind=0
    // - String keys  => kind=1 (C-string pointer)
    var pairs = nil
    if expr != nil { pairs = expr["pairs"] }
    if pairs == nil { pairs = [] }

    var d0 = _lit_enter(ctx)
    if d0 == nil { return nil }

    var hn = "$tmp_lit_map_hdr" + oren_int_to_string(d0)
    var tmp_hdr = locals[hn]
    if tmp_hdr == nil {
        _lit_exit(ctx, d0)
        err(ctx, "x64 native v0: missing literal spill slots for hash literal")
        return nil
    }

    var n = oren_list_len(pairs)

    // map = oren_new_map(n)
    var new_call = {
        "type": "Call",
        "fn": {"type": "Identifier", "token": nil, "value": "oren_new_map"},
        "args": [{"type": "Integer", "value": oren_int_to_string(n)}],
    }
    _emit_eval_int_to_rax(ctx, new_call, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
        _lit_exit(ctx, d0)
        return nil
    }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_hdr, 0)

    // Insert pairs in source order (LTR).
    var i = 0
    while i < n {
        var pair = pairs[i]
        if pair == nil {
            _lit_exit(ctx, d0)
            err(ctx, "x64 native v0: hash literal has nil pair")
            return nil
        }
        var k = pair["key"]
        var v = pair["value"]
        if k == nil || v == nil {
            _lit_exit(ctx, d0)
            err(ctx, "x64 native v0: hash literal missing key/value")
            return nil
        }
        if k["type"] != "String" && k["type"] != "Integer" {
            _lit_exit(ctx, d0)
            err(ctx, "x64 native v0: hash literal key must be string literal or integer")
            return nil
        }

        var kk = 0
        if k["type"] == "String" { kk = 1 }
        var set_nm = "oren_map_set_int"
        if kk == 1 { set_nm = "oren_map_set_str" }
        var set_call = {
            "type": "Call",
            "fn": {"type": "Identifier", "token": nil, "value": set_nm},
            "args": [{"type": "Identifier", "token": nil, "value": hn}, k, v],
            // Hash literals have deterministic key types, so annotate them explicitly.
            // Note: x64 native currently infers key kind at runtime for safety; this hint
            // is kept for other backends and future x64 optimizations.
            "known_key_kind": kk,
        }
        _emit_eval_int_to_rax(ctx, set_call, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 {
            _lit_exit(ctx, d0)
            return nil
        }

        i = i + 1
    }

    // return map
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_hdr)
    _lit_exit(ctx, d0)
    return nil
}
