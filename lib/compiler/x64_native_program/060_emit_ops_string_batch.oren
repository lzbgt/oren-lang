fn _x64_string_batch_trace_state(ctx, j, op_slow_ms, batch_n, batch_names_n, batch_items_n, batch_off_encs_n, batch_slot_offs_src_n) {
    var phase_log = nil
    var phase_name = nil
    if ctx != nil {
        phase_log = ctx["emit_ops_phase_log"]
        phase_name = ctx["emit_ops_phase_name"]
    }
    var trace_op_slow = false
    if phase_log != nil && phase_name != nil && op_slow_ms > 0 { trace_op_slow = true }
    var trace_batch_progress = false
    var v_trace_batch = oren_env("OREN_TRACE_X64_STRING_BATCH_PROGRESS")
    if phase_log != nil && phase_name != nil &&
       v_trace_batch != nil && v_trace_batch != "" &&
       x64_env_str_eq(v_trace_batch, "0") != true &&
       x64_env_str_eq(v_trace_batch, "false") != true {
        trace_batch_progress = true
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.string_batch.start",
            "name=" + phase_name +
                " i=" + oren_int_to_string(j) +
                " count=" + oren_int_to_string(batch_n) +
                " names=" + oren_int_to_string(batch_names_n) +
                " items=" + oren_int_to_string(batch_items_n) +
                " off_encs=" + oren_int_to_string(batch_off_encs_n) +
                " slot_offs=" + oren_int_to_string(batch_slot_offs_src_n))
    }
    return {
        "phase_log": phase_log,
        "phase_name": phase_name,
        "trace_op_slow": trace_op_slow,
        "trace_batch_progress": trace_batch_progress
    }
}

fn _x64_string_batch_collect_items(batch_n, batch_items, batch_items_n, batch_names, batch_values, batch_off_encs, batch_slot_offs_src) {
    if batch_items_n > 0 { return batch_items }
    var batch_names_n = 0
    if batch_names != nil { batch_names_n = oren_list_len(batch_names) }
    var batch_off_encs_n = 0
    if batch_off_encs != nil { batch_off_encs_n = oren_list_len(batch_off_encs) }
    var batch_slot_offs_src_n = 0
    if batch_slot_offs_src != nil { batch_slot_offs_src_n = oren_list_len(batch_slot_offs_src) }
    var out = []
    var batch_collect_i = 0
    while batch_collect_i < batch_n {
        var collect_name = nil
        if batch_collect_i < batch_names_n { collect_name = batch_names[batch_collect_i] }
        var collect_value = nil
        if batch_values != nil && batch_collect_i < oren_list_len(batch_values) {
            collect_value = batch_values[batch_collect_i]
        }
        var collect_off_enc = nil
        if batch_collect_i < batch_off_encs_n { collect_off_enc = batch_off_encs[batch_collect_i] }
        var collect_slot_off = nil
        if batch_collect_i < batch_slot_offs_src_n { collect_slot_off = batch_slot_offs_src[batch_collect_i] }
        oren_list_push(out, {
            "name": collect_name,
            "value": collect_value,
            "off_enc": collect_off_enc,
            "slot_off": collect_slot_off,
        })
        batch_collect_i = batch_collect_i + 1
    }
    return out
}

fn _x64_string_batch_input_state(op) {
    var batch_names = op["names"]
    var batch_values = op["values"]
    var batch_off_encs = op["off_encs"]
    var batch_slot_offs_src = op["slot_offs"]
    var batch_items = op["items"]
    var batch_items_n = 0
    if batch_items != nil { batch_items_n = oren_list_len(batch_items) }
    var batch_n = 0
    if batch_items_n > 0 {
        batch_n = batch_items_n
    } else if batch_values != nil {
        batch_n = oren_list_len(batch_values)
    }
    var batch_names_n = 0
    if batch_names != nil { batch_names_n = oren_list_len(batch_names) }
    var batch_off_encs_n = 0
    if batch_off_encs != nil { batch_off_encs_n = oren_list_len(batch_off_encs) }
    var batch_slot_offs_src_n = 0
    if batch_slot_offs_src != nil { batch_slot_offs_src_n = oren_list_len(batch_slot_offs_src) }
    return {
        "names": batch_names,
        "values": batch_values,
        "off_encs": batch_off_encs,
        "slot_offs_src": batch_slot_offs_src,
        "items": batch_items,
        "items_n": batch_items_n,
        "n": batch_n,
        "names_n": batch_names_n,
        "off_encs_n": batch_off_encs_n,
        "slot_offs_src_n": batch_slot_offs_src_n
    }
}

fn _x64_string_batch_prepare_op(ctx, op, j, op_slow_ms) {
    var input = _x64_string_batch_input_state(op)
    var trace = _x64_string_batch_trace_state(ctx, j, op_slow_ms, input["n"], input["names_n"], input["items_n"], input["off_encs_n"], input["slot_offs_src_n"])
    var batch_items = _x64_string_batch_collect_items(input["n"], input["items"], input["items_n"], input["names"], input["values"], input["off_encs"], input["slot_offs_src"])
    return {"trace": trace, "items": batch_items, "n": input["n"]}
}

fn _x64_string_batch_item_offset(ctx, batch_item) {
    var goff_b = nil
    var offset_path = "slot_off"
    goff_b = batch_item["slot_off"]
    if goff_b == nil {
        offset_path = "off_enc"
        var goff_enc_b = batch_item["off_enc"]
        var name_b = batch_item["name"]
        if oren_type_tag(goff_enc_b) != 1 && ctx["globals"] != nil {
            offset_path = "globals"
            goff_enc_b = ctx["globals"][name_b]
        }
        if oren_type_tag(goff_enc_b) != 1 { err(ctx, "x64 native v0: assign unknown var " + name_b); return nil }
        goff_b = goff_enc_b - 1
    }
    return {"off": goff_b, "path": offset_path}
}

fn _x64_string_batch_trace_progress(trace, batch_i, batch_n, j, op_start_ns, batch_data_ms, batch_code_ms) {
    var phase_log = trace["phase_log"]
    var phase_name = trace["phase_name"]
    var trace_op_slow = trace["trace_op_slow"]
    if trace_op_slow != true || core.int_mod(batch_i, 25) != 0 { return nil }
    var batch_progress_ms = (oren_time_now_ns() - op_start_ns) / 1000000
    _x64_program_phase_log_append(phase_log, "x64.codegen.function.op.batch_progress",
        "name=" + phase_name +
            " i=" + oren_int_to_string(j) +
            " item=" + oren_int_to_string(batch_i) +
            " count=" + oren_int_to_string(batch_n) +
            " ms=" + oren_int_to_string(batch_progress_ms) +
            " data_ms=" + oren_int_to_string(batch_data_ms) +
            " code_ms=" + oren_int_to_string(batch_code_ms))
    return nil
}

fn _x64_string_batch_trace_item_enter(trace, batch_i, batch_n, j) {
    var phase_log = trace["phase_log"]
    var phase_name = trace["phase_name"]
    if trace["trace_batch_progress"] != true || core.int_mod(batch_i, 10) != 0 { return false }
    _x64_program_phase_log_append(phase_log, "x64.codegen.function.string_batch.item.enter",
        "name=" + phase_name +
            " i=" + oren_int_to_string(j) +
            " item=" + oren_int_to_string(batch_i) +
            " count=" + oren_int_to_string(batch_n))
    return true
}

fn _x64_string_batch_trace_item_step(trace, tag, batch_i, j, extra) {
    var phase_log = trace["phase_log"]
    var phase_name = trace["phase_name"]
    var msg = "name=" + phase_name +
        " i=" + oren_int_to_string(j) +
        " item=" + oren_int_to_string(batch_i)
    if extra != nil && extra != "" { msg = msg + extra }
    _x64_program_phase_log_append(phase_log, tag, msg)
    return nil
}

fn _x64_string_batch_trace_item_offset_done(trace, trace_batch_sample, batch_i, j, offset_path) {
    if trace_batch_sample == true {
        _x64_string_batch_trace_item_step(trace, "x64.codegen.function.string_batch.item.offset.done",
            batch_i, j, " path=" + offset_path)
    }
    return nil
}

fn _x64_string_batch_item_value(ctx, batch_item) {
    var s_b = batch_item["value"]
    if s_b == nil { s_b = "" }
    if s_b == 0 { s_b = "" }
    if oren_is_string(s_b) != true {
        var tn_b = oren_type_name(s_b)
        err(ctx, "x64 native v0: _data_add_cstr0_nodedup expects string, got " + tn_b)
        return nil
    }
    return s_b
}

fn _x64_string_batch_trace_item_value_done(trace, trace_batch_sample, batch_i, j) {
    if trace_batch_sample == true {
        _x64_string_batch_trace_item_step(trace, "x64.codegen.function.string_batch.item.value.done",
            batch_i, j, nil)
    }
    return nil
}

fn _x64_string_batch_trace_item_size(trace, trace_batch_sample, batch_i, batch_n, j, n0_b, batch_data_buf) {
    if trace_batch_sample == true {
        _x64_string_batch_trace_item_step(trace, "x64.codegen.function.string_batch.item",
            batch_i, j,
            " count=" + oren_int_to_string(batch_n) +
                " strlen=" + oren_int_to_string(n0_b) +
                " data_bytes=" + oren_int_to_string(bytes_len(batch_data_buf)))
    }
    return nil
}

fn _x64_string_batch_align_data_buf(batch_data_buf) {
    while core.int_mod(bytes_len(batch_data_buf), 8) != 0 { bytes_push(batch_data_buf, 0) }
    return bytes_len(batch_data_buf)
}

fn _x64_string_batch_append_cstr_bytes(batch_data_buf, s_b) {
    var cstr_off_b = _x64_string_batch_align_data_buf(batch_data_buf)
    var n0_b = oren_string_len(s_b)
    if n0_b > 1048576 {
        s_b = oren_string_slice(s_b, 0, 1048576)
        n0_b = 1048576
    }
    bytes_extend_string(batch_data_buf, s_b)
    bytes_push(batch_data_buf, 0)
    return cstr_off_b
}

fn _x64_string_batch_trace_item_data_done(trace, trace_batch_sample, batch_i, j, batch_data_buf) {
    if trace_batch_sample == true {
        _x64_string_batch_trace_item_step(trace, "x64.codegen.function.string_batch.item.data.done",
            batch_i, j, " data_bytes=" + oren_int_to_string(bytes_len(batch_data_buf)))
    }
    return nil
}

fn _x64_string_batch_append_one_data(ctx, trace, batch_item, batch_i, batch_n, j, batch_data_buf) {
    if batch_item == nil { batch_item = {} }
    var trace_batch_sample = _x64_string_batch_trace_item_enter(trace, batch_i, batch_n, j)
    var off_info = _x64_string_batch_item_offset(ctx, batch_item)
    if off_info == nil { return nil }
    var goff_b = off_info["off"]
    _x64_string_batch_trace_item_offset_done(trace, trace_batch_sample, batch_i, j, off_info["path"])

    var s_b = _x64_string_batch_item_value(ctx, batch_item)
    if s_b == nil { return nil }
    _x64_string_batch_trace_item_value_done(trace, trace_batch_sample, batch_i, j)

    var n0_b = oren_string_len(s_b)
    _x64_string_batch_trace_item_size(trace, trace_batch_sample, batch_i, batch_n, j, n0_b, batch_data_buf)
    var cstr_off_b = _x64_string_batch_append_cstr_bytes(batch_data_buf, s_b)
    _x64_string_batch_trace_item_data_done(trace, trace_batch_sample, batch_i, j, batch_data_buf)
    return {"slot": goff_b, "cstr": cstr_off_b}
}

fn _x64_string_batch_data_state(ctx) {
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if ctx["cstr0_list"] == nil { ctx["cstr0_list"] = [] }
    return {
        "data_buf": ctx["data"],
        "cstr0_list": ctx["cstr0_list"],
        "slot_offs": [],
        "cstr_offs": []
    }
}

fn _x64_string_batch_append_data_item(ctx, trace, batch_item, batch_i, batch_n, j, op_start_ns, batch_data_ms, batch_code_ms, state, trace_op_slow) {
    _x64_string_batch_trace_progress(trace, batch_i, batch_n, j, op_start_ns, batch_data_ms, batch_code_ms)
    var batch_step_ns = 0
    if trace_op_slow == true { batch_step_ns = oren_time_now_ns() }

    var item_info = _x64_string_batch_append_one_data(ctx, trace, batch_item, batch_i, batch_n, j, state["data_buf"])
    if item_info == nil { return -1 }
    oren_list_push(state["cstr0_list"], item_info["cstr"])
    if trace_op_slow == true { batch_data_ms = batch_data_ms + ((oren_time_now_ns() - batch_step_ns) / 1000000) }
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return -1 }

    oren_list_push(state["slot_offs"], item_info["slot"])
    oren_list_push(state["cstr_offs"], item_info["cstr"])
    return batch_data_ms
}

fn _x64_string_batch_append_data_result(state, batch_data_ms) {
    return {
        "slot_offs": state["slot_offs"],
        "cstr_offs": state["cstr_offs"],
        "data_ms": batch_data_ms
    }
}

fn _x64_string_batch_append_data(ctx, trace, batch_items, batch_n, j, op_start_ns, op_slow_ms) {
    var state = _x64_string_batch_data_state(ctx)
    var trace_op_slow = trace["trace_op_slow"]
    var batch_data_ms = 0
    var batch_code_ms = 0
    var batch_i = 0
    for batch_item in batch_items {
        batch_data_ms = _x64_string_batch_append_data_item(ctx, trace, batch_item, batch_i, batch_n, j, op_start_ns, batch_data_ms, batch_code_ms, state, trace_op_slow)
        if batch_data_ms < 0 { return nil }
        batch_i = batch_i + 1
    }
    return _x64_string_batch_append_data_result(state, batch_data_ms)
}

fn _x64_string_batch_trace_data_done(ctx, trace, j, batch_n, batch_data_buf) {
    var phase_log = trace["phase_log"]
    var phase_name = trace["phase_name"]
    var trace_batch_progress = trace["trace_batch_progress"]
    if trace_batch_progress == true {
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.string_batch.data.done",
            "name=" + phase_name +
            " i=" + oren_int_to_string(j) +
            " count=" + oren_int_to_string(batch_n) +
            " data_bytes=" + oren_int_to_string(bytes_len(batch_data_buf)))
    }
    return nil
}

fn _x64_string_batch_append_table_data(ctx, batch_n, batch_slot_offs, batch_cstr_offs) {
    var batch_data_buf = ctx["data"]
    while core.int_mod(bytes_len(batch_data_buf), 8) != 0 { bytes_push(batch_data_buf, 0) }
    var batch_table_off = bytes_len(batch_data_buf)
    push_u64_le(batch_data_buf, batch_n)
    var batch_table_i = 0
    while batch_table_i < batch_n {
        push_u64_le(batch_data_buf, batch_slot_offs[batch_table_i])
        push_u64_le(batch_data_buf, batch_cstr_offs[batch_table_i])
        batch_table_i = batch_table_i + 1
    }
    return batch_table_off
}

fn _x64_string_batch_trace_table_done(ctx, trace, j, batch_table_off, batch_data_buf) {
    var phase_log = trace["phase_log"]
    var phase_name = trace["phase_name"]
    var trace_batch_progress = trace["trace_batch_progress"]
    if trace_batch_progress == true {
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.string_batch.table.done",
            "name=" + phase_name +
            " i=" + oren_int_to_string(j) +
            " table_off=" + oren_int_to_string(batch_table_off) +
            " data_bytes=" + oren_int_to_string(bytes_len(batch_data_buf)))
    }
    return nil
}

fn _x64_string_batch_code_timer_start(trace) {
    if trace["trace_op_slow"] != true { return 0 }
    return oren_time_now_ns()
}

fn _x64_string_batch_code_timer_finish(trace, batch_code_step_ns) {
    if trace["trace_op_slow"] != true { return 0 }
    return (oren_time_now_ns() - batch_code_step_ns) / 1000000
}

fn _x64_string_batch_trace_emit_done(ctx, trace, j) {
    var phase_log = trace["phase_log"]
    var phase_name = trace["phase_name"]
    var trace_batch_progress = trace["trace_batch_progress"]
    if trace_batch_progress == true {
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.string_batch.emit.done",
            "name=" + phase_name +
            " i=" + oren_int_to_string(j) +
            " code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])) +
            " fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])))
    }
    return nil
}

fn _x64_string_batch_emit_top_loop(ctx, trace, j, batch_table_off) {
    var batch_code_step_ns = _x64_string_batch_code_timer_start(trace)
    _x64_emit_top_string_global_batch_loop(ctx, batch_table_off)
    var batch_code_ms = _x64_string_batch_code_timer_finish(trace, batch_code_step_ns)
    _x64_string_batch_trace_emit_done(ctx, trace, j)
    return batch_code_ms
}

fn _x64_string_batch_append_table_and_emit(ctx, trace, j, batch_n, batch_slot_offs, batch_cstr_offs, batch_data_ms) {
    var trace_op_slow = trace["trace_op_slow"]
    var batch_data_buf = ctx["data"]
    _x64_string_batch_trace_data_done(ctx, trace, j, batch_n, batch_data_buf)

    var batch_table_step_ns = 0
    if trace_op_slow == true { batch_table_step_ns = oren_time_now_ns() }
    var batch_table_off = _x64_string_batch_append_table_data(ctx, batch_n, batch_slot_offs, batch_cstr_offs)
    if trace_op_slow == true { batch_data_ms = batch_data_ms + ((oren_time_now_ns() - batch_table_step_ns) / 1000000) }
    _x64_string_batch_trace_table_done(ctx, trace, j, batch_table_off, batch_data_buf)

    var batch_code_ms = _x64_string_batch_emit_top_loop(ctx, trace, j, batch_table_off)
    return {
        "table_off": batch_table_off,
        "data_ms": batch_data_ms,
        "code_ms": batch_code_ms
    }
}

fn _x64_string_batch_record_slow(ctx, op, trace, j, op_start_ns, op_slow_ms, batch_n, batch_data_ms, batch_code_ms) {
    var phase_log = trace["phase_log"]
    var phase_name = trace["phase_name"]
    var trace_op_slow = trace["trace_op_slow"]
    if trace_op_slow == true {
        var batch_elapsed_ms = (oren_time_now_ns() - op_start_ns) / 1000000
        if batch_elapsed_ms >= op_slow_ms {
            var loc_b = ""
            var tok_b = op["tok"]
            if tok_b != nil && tok_b["file"] != nil && tok_b["line"] != nil {
                loc_b = " file=" + tok_b["file"] + " line=" + oren_int_to_string(tok_b["line"])
            }
            _x64_program_phase_log_append(phase_log, "x64.codegen.function.op.slow",
                "name=" + phase_name +
                " i=" + oren_int_to_string(j) +
                " op=global_string_init_batch" +
                " path=top_string_batch" +
                " ms=" + oren_int_to_string(batch_elapsed_ms) +
                " data_ms=" + oren_int_to_string(batch_data_ms) +
                " code_ms=" + oren_int_to_string(batch_code_ms) +
                " count=" + oren_int_to_string(batch_n) +
                loc_b)
        }
    }
    return nil
}

fn _x64_string_batch_emit_prepared_op(ctx, op, prepared, j, op_start_ns, op_slow_ms) {
    var batch_n = prepared["n"]
    var trace = prepared["trace"]
    var data_info = _x64_string_batch_append_data(ctx, trace, prepared["items"], batch_n, j, op_start_ns, op_slow_ms)
    if data_info == nil { return nil }
    var table_info = _x64_string_batch_append_table_and_emit(ctx, trace, j, batch_n, data_info["slot_offs"], data_info["cstr_offs"], data_info["data_ms"])
    if table_info == nil { return nil }
    _x64_string_batch_record_slow(ctx, op, trace, j, op_start_ns, op_slow_ms, batch_n, table_info["data_ms"], table_info["code_ms"])
    return true
}

fn _emit_global_string_init_batch_op_x64(ctx, op, j, op_start_ns, op_slow_ms) {
    var prepared = _x64_string_batch_prepare_op(ctx, op, j, op_slow_ms)
    if _x64_string_batch_emit_prepared_op(ctx, op, prepared, j, op_start_ns, op_slow_ms) != true { return nil }
    return nil
}
