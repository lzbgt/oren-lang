fn _extract_functions_v0(ctx, linked) {
    // CoreIR v0: keep function scanning/metadata deterministic and shared.
    // This preserves existing x64 error message prefixes for compatibility with fixtures.
    return coreir.collect_top_level_functions(ctx, linked, "x64 native v0")
}

fn _x64_tmp_names_init(ctx) {
    if ctx == nil { return nil }
    if ctx["__x64_tmp_names"] != nil { return nil }

    // Keep these as string literals to avoid per-function string allocation churn.
    ctx["__x64_tmp_names"] = [
        "$tmp1", "$tmp2", "$tmp3", "$tmp4", "$tmp5", "$tmp6", "$tmp7", "$tmp8"
    ]

    // Literal spill names are fixed small sets; keep them as literals too.
    ctx["__x64_tmp_lit_list_hdr_names"] = [
        "$tmp_lit_list_hdr0", "$tmp_lit_list_hdr1", "$tmp_lit_list_hdr2", "$tmp_lit_list_hdr3",
        "$tmp_lit_list_hdr4", "$tmp_lit_list_hdr5", "$tmp_lit_list_hdr6", "$tmp_lit_list_hdr7"
    ]
    ctx["__x64_tmp_lit_map_hdr_names"] = [
        "$tmp_lit_map_hdr0", "$tmp_lit_map_hdr1", "$tmp_lit_map_hdr2", "$tmp_lit_map_hdr3",
        "$tmp_lit_map_hdr4", "$tmp_lit_map_hdr5", "$tmp_lit_map_hdr6", "$tmp_lit_map_hdr7"
    ]
    return nil
}

fn _x64_expr_args_need_literal_slots(args) {
    var i = 0
    while args != nil && i < oren_list_len(args) {
        if _x64_expr_needs_literal_slots(args[i]) == true { return true }
        i = i + 1
    }
    return false
}

fn _x64_call_like_needs_literal_slots(call_expr) {
    if call_expr == nil { return false }
    if _x64_expr_needs_literal_slots(call_expr["fn"]) == true { return true }
    if _x64_expr_args_need_literal_slots(call_expr["args"]) == true { return true }
    return _x64_expr_needs_literal_slots(call_expr["spread"])
}

fn _x64_binary_expr_needs_literal_slots(expr, right_key) {
    if _x64_expr_needs_literal_slots(expr["left"]) == true { return true }
    return _x64_expr_needs_literal_slots(expr[right_key])
}

fn _x64_if_expr_needs_literal_slots(expr) {
    if _x64_expr_needs_literal_slots(expr["cond"]) == true { return true }
    var consq = expr["consq"]
    if consq != nil && _x64_expr_needs_literal_slots(consq["expr"]) == true { return true }
    var alt = expr["alt"]
    if alt != nil && _x64_expr_needs_literal_slots(alt["expr"]) == true { return true }
    return false
}

fn _x64_expr_needs_literal_slots(expr) {
    if expr == nil { return false }
    var t = expr["type"]
    if t == "Array" || t == "Hash" { return true }
    if t == "Nil" || t == "Boolean" || t == "Integer" || t == "Float" ||
       t == "String" || t == "Identifier" || t == "IntrTmp" || t == "Function" {
        return false
    }
    if t == "Call" { return _x64_call_like_needs_literal_slots(expr) }
    if t == "SpawnExpr" { return _x64_call_like_needs_literal_slots(expr["call"]) }
    if t == "Infix" { return _x64_binary_expr_needs_literal_slots(expr, "right") }
    if t == "Prefix" { return _x64_expr_needs_literal_slots(expr["right"]) }
    if t == "Member" { return _x64_expr_needs_literal_slots(expr["left"]) }
    if t == "Index" { return _x64_binary_expr_needs_literal_slots(expr, "index") }
    if t == "If" { return _x64_if_expr_needs_literal_slots(expr) }
    // Unknown expression shapes keep the historical frame layout rather than risking
    // missing literal spill slots if a newer lowering path starts using them.
    return true
}

fn _x64_ops_need_literal_slots(ops) {
    if ops == nil { return false }
    var i = 0
    while i < oren_list_len(ops) {
        var op = ops[i]
        if op == nil { i = i + 1; continue }
        var k = op["op"]
        if k == "var_i32" || k == "assign_i32" || k == "return" || k == "expr" || k == "print_str_expr" {
            if _x64_expr_needs_literal_slots(op["expr"]) == true { return true }
        } else if k == "if" {
            if _x64_expr_needs_literal_slots(op["cond"]) == true { return true }
            if _x64_ops_need_literal_slots(op["then"]) == true { return true }
            if _x64_ops_need_literal_slots(op["else"]) == true { return true }
        } else if k == "while" {
            if _x64_expr_needs_literal_slots(op["cond"]) == true { return true }
            if _x64_ops_need_literal_slots(op["body"]) == true { return true }
        } else if k == "for" {
            if _x64_ops_need_literal_slots(op["init"]) == true { return true }
            if _x64_expr_needs_literal_slots(op["cond"]) == true { return true }
            if _x64_ops_need_literal_slots(op["post"]) == true { return true }
            if _x64_ops_need_literal_slots(op["body"]) == true { return true }
        } else if k == "global_string_init" || k == "global_string_init_batch" ||
                  k == "global_empty_container_init_batch" || k == "print_cstr" ||
                  k == "break" || k == "continue" {
            // These synthetic/simple ops do not evaluate list/hash literal expressions.
        } else {
            return true
        }
        i = i + 1
    }
    return false
}

fn _x64_call_depth_default_enabled(platform) {
    if platform != nil {
        var cd_max = platform["call_depth_max"]
        if oren_type_tag(cd_max) != 0 && cd_max == 0 { return false }
    }
    return true
}

fn _x64_prepare_function_params(ctx, fn_node, name, locals) {
    var local_next = 8
    var params = fn_node["params"]
    var pc = 0
    if params != nil { pc = oren_list_len(params) }
    var i = 0
    while i < pc {
        var p = params[i]
        var pnm = p["value"]
        if locals[pnm] != nil { err(ctx, "x64 native v0: duplicate param " + pnm); return nil }
        locals[pnm] = local_next
        local_next = local_next + 8

        var ann = p["ann_type"]
        if ann != nil {
            if ctx["locals_floaty"] != nil {
                if ann == "f32" || ann == "f64" { ctx["locals_floaty"][pnm] = true }
            }
            if ctx["locals_inty"] != nil {
                if ann == "i32" || ann == "i64" { ctx["locals_inty"][pnm] = true }
            }
        }
        var pk = oren_int_to_string(i)
        var inferred_floaty = nil
        var inferred_inty = nil
        if ctx["func_param_floaty"] != nil && ctx["func_param_floaty"][name] != nil {
            inferred_floaty = ctx["func_param_floaty"][name][pk]
        }
        if ctx["func_param_inty"] != nil && ctx["func_param_inty"][name] != nil {
            inferred_inty = ctx["func_param_inty"][name][pk]
        }
        if inferred_floaty == true {
            if ctx["locals_floaty"] != nil { ctx["locals_floaty"][pnm] = true }
        } else if inferred_inty == true {
            if ctx["locals_inty"] != nil { ctx["locals_inty"][pnm] = true }
        }
        i = i + 1
    }
    return {"params": params, "pc": pc, "local_next": local_next}
}

fn _x64_reserve_named_local_slot(ctx, locals, local_next, slot_name) {
    if locals[slot_name] != nil { err(ctx, "x64 native v0: reserved local name " + slot_name + " used"); return -1 }
    locals[slot_name] = local_next
    return local_next + 8
}

fn _x64_reserve_frame_scratch_slots(ctx, locals, local_next) {
    local_next = _x64_reserve_named_local_slot(ctx, locals, local_next, "$tmp0")
    if local_next < 0 { return -1 }
    local_next = _x64_reserve_named_local_slot(ctx, locals, local_next, "$tmp_cmp")
    if local_next < 0 { return -1 }
    local_next = _x64_reserve_named_local_slot(ctx, locals, local_next, "$tmp_shift")
    if local_next < 0 { return -1 }
    local_next = _x64_reserve_named_local_slot(ctx, locals, local_next, "$tmp_div")
    if local_next < 0 { return -1 }
    local_next = _x64_reserve_named_local_slot(ctx, locals, local_next, "$tmp_gc_tick")
    if local_next < 0 { return -1 }

    _x64_tmp_names_init(ctx)
    var tmp_names = ctx["__x64_tmp_names"]
    var ti = 1
    while ti <= 8 {
        local_next = _x64_reserve_named_local_slot(ctx, locals, local_next, oren_list_get(tmp_names, ti - 1))
        if local_next < 0 { return -1 }
        ti = ti + 1
    }
    return local_next
}

fn _x64_reserve_intrinsic_temp_slots(ctx, ops, locals, local_next) {
    var max_intr = _max_intr_tmp_in_ops(ctx, ops, locals)
    if oren_type_tag(max_intr) == 0 { max_intr = 0 }
    var intr_lim = max_intr + 8
    if intr_lim < 16 { intr_lim = 16 }
    if intr_lim > 4096 {
        err(ctx, "x64 native v0: intrinsic temp demand too high (need " + oren_int_to_string(intr_lim) + ")")
        return nil
    }
    ctx["intr_tmp_cursor"] = 1
    ctx["intr_tmp_limit"] = intr_lim
    ctx["intr_tmp_base_off"] = local_next
    var intr_bytes = intr_lim
    intr_bytes = iadd(intr_bytes, intr_bytes) // *2
    intr_bytes = iadd(intr_bytes, intr_bytes) // *4
    intr_bytes = iadd(intr_bytes, intr_bytes) // *8
    return {"max_intr": max_intr, "intr_lim": intr_lim, "local_next": iadd(local_next, intr_bytes)}
}

fn _x64_reserve_literal_frame_slots(ctx, locals, local_next, needs_literal_slots) {
    var literal_slot_count = 0
    if needs_literal_slots == true {
        _x64_tmp_names_init(ctx)
        var ld = 0
        while ld < 8 {
            local_next = _x64_reserve_named_local_slot(ctx, locals, local_next,
                oren_list_get(ctx["__x64_tmp_lit_list_hdr_names"], ld))
            if local_next < 0 { return nil }
            literal_slot_count = literal_slot_count + 1

            local_next = _x64_reserve_named_local_slot(ctx, locals, local_next,
                oren_list_get(ctx["__x64_tmp_lit_map_hdr_names"], ld))
            if local_next < 0 { return nil }
            literal_slot_count = literal_slot_count + 1
            ld = ld + 1
        }
    }
    return {"literal_slot_count": literal_slot_count, "local_next": local_next}
}

fn _x64_compute_function_frame_layout(ctx, local_next, max_call_argc) {
    var locals_pre_align_bytes = local_next - 8
    var locals_size = locals_pre_align_bytes
    var align = abi.stack_align_bytes(ctx["abi"])
    if align < 1 { align = 16 }
    while core.int_mod(locals_size, align) != 0 { locals_size = locals_size + 1 }

    var regc = abi.max_int_reg_args(ctx["abi"])
    var shadow = abi.caller_shadow_bytes(ctx["abi"])
    var slot = abi.stack_arg_slot_bytes(ctx["abi"])
    var stack_slots = 0
    if max_call_argc > regc { stack_slots = max_call_argc - regc }
    var need_call_area = shadow + stack_slots * slot
    var call_area = abi.callee_call_area_bytes(ctx["abi"])
    if need_call_area > call_area { call_area = need_call_area }
    while core.int_mod(call_area, align) != 0 { call_area = call_area + 1 }
    ctx["cur_call_area_bytes"] = call_area

    var save_regs = abi.callee_saved_regs(ctx["abi"])
    var save_n = 0
    if save_regs != nil { save_n = oren_list_len(save_regs) }
    var save_bytes = save_n * 8
    while core.int_mod(save_bytes, align) != 0 { save_bytes = save_bytes + 8 }
    var frame_size = locals_size + save_bytes + call_area
    return {
        "locals_pre_align_bytes": locals_pre_align_bytes,
        "locals_size": locals_size,
        "regc": regc,
        "shadow": shadow,
        "call_area": call_area,
        "save_regs": save_regs,
        "save_n": save_n,
        "frame_size": frame_size
    }
}

fn _x64_prepare_function_frame_v0(ctx, fn_node, name, ops, max_call_argc, needs_literal_slots) {
    // Compute locals, reserved spill regions, intrinsic-temp pool, literal slots,
    // outgoing call area, and callee-save region. This helper intentionally emits no
    // machine code so `_compile_function_v0` keeps the original prologue/body order.
    var locals = {}
    var param_state = _x64_prepare_function_params(ctx, fn_node, name, locals)
    if param_state == nil { return nil }
    var params = param_state["params"]
    var pc = param_state["pc"]
    var local_next = param_state["local_next"]

    local_next = _collect_locals_from_ops(ctx, ops, locals, local_next)
    if local_next < 0 { return nil }

    local_next = _x64_reserve_frame_scratch_slots(ctx, locals, local_next)
    if local_next < 0 { return nil }

    var intr_state = _x64_reserve_intrinsic_temp_slots(ctx, ops, locals, local_next)
    if intr_state == nil { return nil }
    var max_intr = intr_state["max_intr"]
    var intr_lim = intr_state["intr_lim"]
    local_next = intr_state["local_next"]

    var literal_state = _x64_reserve_literal_frame_slots(ctx, locals, local_next, needs_literal_slots)
    if literal_state == nil { return nil }
    var literal_slot_count = literal_state["literal_slot_count"]
    local_next = literal_state["local_next"]

    var layout = _x64_compute_function_frame_layout(ctx, local_next, max_call_argc)

    return {
        "locals": locals,
        "params": params,
        "pc": pc,
        "regc": layout["regc"],
        "shadow": layout["shadow"],
        "max_intr": max_intr,
        "intr_lim": intr_lim,
        "literal_slot_count": literal_slot_count,
        "locals_pre_align_bytes": layout["locals_pre_align_bytes"],
        "locals_size": layout["locals_size"],
        "call_area": layout["call_area"],
        "save_regs": layout["save_regs"],
        "save_n": layout["save_n"],
        "frame_size": layout["frame_size"]
    }
}

fn _x64_emit_function_spills(ctx, locals, params, pc, regc, shadow, save_regs, save_n, locals_size) {
    var si = 0
    while si < save_n {
        var reg_save = save_regs[si]
        var off_save = locals_size + 8 * (si + 1)
        _emit_mov_mrbp_r64(ctx, 0 - off_save, reg_save)
        si = si + 1
    }

    var i = 0
    while i < pc {
        var p2 = params[i]
        var pnm2 = p2["value"]
        var off = locals[pnm2]
        if off <= 0 { err(ctx, "x64 native v0: missing param slot"); return nil }

        if i < regc {
            var reg_enc = abi.int_arg_reg(ctx["abi"], i)
            if oren_type_tag(reg_enc) == 0 { err(ctx, "x64 native v0: unsupported param index"); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - off, reg_enc - 1)
        } else {
            var stack_base = 16 + shadow
            var disp = stack_base + 8 * (i - regc)
            _emit_mov_r64_mrbp(ctx, 0, disp)
            _emit_mov_mrbp_r64(ctx, 0 - off, 0)
        }
        i = i + 1
    }
    return true
}

fn _x64_function_call_depth_enabled(fn_node, name, user_fn_fast_call_depth, call_depth_default_enabled) {
    var call_depth_enabled = call_depth_default_enabled
    if call_depth_enabled == true && user_fn_fast_call_depth != true {
        var name_len_cd = oren_string_len(name)
        if fn_node["__oren_from_runtime"] == true { call_depth_enabled = false }
        if fn_node["__oren_no_call_depth"] == true { call_depth_enabled = false }
        if name_len_cd == 21 {
            if name == "oren_call_depth_enter" { call_depth_enabled = false }
        } else if name_len_cd == 20 {
            if name == "oren_call_depth_exit" { call_depth_enabled = false }
        } else if name_len_cd == 28 {
            if name == "native_call_depth_enter_slow" { call_depth_enabled = false }
        } else if name_len_cd == 27 {
            if name == "native_call_depth_exit_slow" { call_depth_enabled = false }
        }
    }
    return call_depth_enabled
}

fn _x64_emit_function_gc_tick_init(ctx, locals) {
    var off_tick = locals["$tmp_gc_tick"]
    if oren_type_tag(off_tick) == 0 { err(ctx, "x64 native v0: missing $tmp_gc_tick slot"); return nil }
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 0))
    _emit_mov_mrbp_r64(ctx, 0 - off_tick, 0)
    return true
}

fn _x64_function_body_trace_emit_ops_enabled(trace_this) {
    if trace_this != true { return false }
    var v_ops = oren_env("OREN_TRACE_X64_FN_EMIT_OPS")
    if v_ops == nil || v_ops == "" { return false }
    if core.string_eq_bytes(v_ops, "0") == true || core.string_eq_bytes(v_ops, "false") == true { return false }
    return true
}

fn _x64_begin_function_body_phase(ctx, name, local_fixups, phase_state) {
    if phase_state["enabled"] != true || phase_state["summary_only"] == true { return nil }
    ctx["emit_ops_phase_log"] = phase_state["log"]
    ctx["emit_ops_phase_name"] = name
    ctx["emit_ops_phase_stride"] = 50
    _x64_program_phase_log_append(phase_state["log"], "x64.codegen.function.body.start",
        "name=" + name +
        " code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])) +
        " fixups=" + oren_int_to_string(oren_list_len(local_fixups)) +
        " elapsed_ms=" + oren_int_to_string((phase_state["body_start_ns"] - phase_state["start_ns"]) / 1000000))
    return nil
}

fn _x64_end_function_body_phase(ctx, name, local_fixups, phase_state) {
    if phase_state["enabled"] != true || phase_state["summary_only"] == true { return nil }
    ctx["emit_ops_phase_log"] = nil
    ctx["emit_ops_phase_name"] = nil
    ctx["emit_ops_phase_stride"] = nil
    _x64_program_phase_log_append(phase_state["log"], "x64.codegen.function.body.done",
        "name=" + name +
        " code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])) +
        " fixups=" + oren_int_to_string(oren_list_len(local_fixups)) +
        " elapsed_ms=" + oren_int_to_string((oren_time_now_ns() - phase_state["start_ns"]) / 1000000))
    return nil
}

fn _x64_emit_function_body_ops_payload(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, trace_emit_ops) {
    if trace_emit_ops { ctx["trace_emit_ops"] = true }
    _emit_ops_in_fn(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    if trace_emit_ops { ctx["trace_emit_ops"] = nil }
    return nil
}

fn _x64_emit_function_body_ops(ctx, name, ops, locals, labels, local_fixups, epilogue_label,
                               platform, trace_this, phase_this, phase_summary_only, phase_log, phase_start) {
    var phase_body_start = 0
    if phase_this { phase_body_start = oren_time_now_ns() }
    var t_stage = 0
    if trace_this { print("[x64_fn] emit_ops start"); t_stage = oren_time_now_ns() }
    var trace_emit_ops = _x64_function_body_trace_emit_ops_enabled(trace_this)
    var phase_state = {
        "enabled": phase_this,
        "summary_only": phase_summary_only,
        "log": phase_log,
        "start_ns": phase_start,
        "body_start_ns": phase_body_start
    }
    _x64_begin_function_body_phase(ctx, name, local_fixups, phase_state)
    _x64_emit_function_body_ops_payload(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, trace_emit_ops)
    var phase_body_ms = 0
    if phase_body_start > 0 { phase_body_ms = (oren_time_now_ns() - phase_body_start) / 1000000 }
    _x64_end_function_body_phase(ctx, name, local_fixups, phase_state)
    if trace_this {
        var dt1 = (oren_time_now_ns() - t_stage) / 1000000
        print("[x64_fn] emit_ops done ms=" + oren_int_to_string(dt1))
    }
    return phase_body_ms
}

fn _x64_emit_function_epilogue(ctx, locals, labels, local_fixups, epilogue_label,
                               call_depth_enabled, save_regs, save_n, locals_size, frame_size) {
    _emit_label(ctx, labels, epilogue_label)
    if call_depth_enabled == true {
        var off_ret = locals["$tmp0"]
        if oren_type_tag(off_ret) == 0 { err(ctx, "x64 native v0: missing $tmp0 spill slot"); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off_ret, 0)
        var pos_exit = bytes_len(ctx["code"])
        bytes_push(ctx["code"], 232)
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["call_depth_exit_fixups"], pos_exit)
        _emit_mov_r64_mrbp(ctx, 0, 0 - off_ret)
    }

    var sj = save_n - 1
    while sj >= 0 {
        var reg_restore = save_regs[sj]
        var off_restore = locals_size + 8 * (sj + 1)
        _emit_mov_r64_mrbp(ctx, reg_restore, 0 - off_restore)
        sj = sj - 1
    }
    if frame_size > 0 { bytes_extend(ctx["code"], core.insn_add_rsp_imm32(frame_size)) }
    bytes_extend(ctx["code"], core.insn_pop_rbp())
    bytes_extend(ctx["code"], core.insn_ret())

    _patch_local_fixups(ctx, labels, local_fixups)
    return true
}

fn _x64_function_trace_enabled(name) {
    var trace_fn = oren_env("OREN_TRACE_X64_FN")
    if trace_fn != nil && trace_fn != "" {
        if core.string_eq_bytes(trace_fn, name) { return true }
    }
    return false
}

fn _x64_function_phase_summary_only(ctx, name, trace_this) {
    if ctx == nil { return false }
    var phase_log = ctx["phase_log"]
    if phase_log == nil { return false }
    if name == "__top_level__" || trace_this == true { return false }
    if ctx["phase_fn_detail"] == true { return true }
    return false
}

fn _x64_function_phase_enabled(ctx, name, trace_this, phase_summary_only) {
    if ctx == nil { return false }
    var phase_log = ctx["phase_log"]
    if phase_log == nil { return false }
    if name == "__top_level__" || trace_this == true { return true }
    if phase_summary_only == true { return true }
    return false
}

fn _x64_function_reset_context(ctx, name) {
    // Expose the current function name to lowering passes (used for small, explicit
    // rolling exceptions like "do not varargs-pack inside __oren_fnwrap_* bodies").
    ctx["cur_fn_name"] = name
    // Per-function float propagation map (rolling heuristic).
    //
    // v0 carries float values as raw f64 bits in integer registers, and x64 uses a
    // conservative local-tracking scheme to decide when to emit SSE2 scalar ops.
    ctx["locals_floaty"] = {}
    ctx["locals_inty"] = {}
    ctx["locals_int_const"] = {}
    return nil
}

fn _x64_function_analyze_ops(ctx, fn_node, name, phase_state) {
    var ops = _analyze_supported_fn_body(ctx, fn_node)
    if ops == nil { return nil }
    var needs_literal_slots = _x64_ops_need_literal_slots(ops)
    var phase_this = false
    var phase_summary_only = false
    var phase_log = nil
    var phase_start = 0
    if phase_state != nil {
        phase_this = phase_state["enabled"]
        phase_summary_only = phase_state["summary_only"]
        phase_log = phase_state["log"]
        phase_start = phase_state["start_ns"]
    }
    if phase_this && phase_summary_only != true {
        var ops_n_phase = 0
        if ops != nil { ops_n_phase = oren_list_len(ops) }
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.analyze.done",
            "name=" + name +
            " ops=" + oren_int_to_string(ops_n_phase) +
            " elapsed_ms=" + oren_int_to_string((oren_time_now_ns() - phase_start) / 1000000))
    }
    return {"ops": ops, "needs_literal_slots": needs_literal_slots}
}

fn _x64_function_trace_analyze_done(name, ops, t_stage) {
    var dt = (oren_time_now_ns() - t_stage) / 1000000
    var ops_n = 0
    if ops != nil { ops_n = oren_list_len(ops) }
    print("[x64_fn] analyze_ops done ms=" + oren_int_to_string(dt) + " ops=" + oren_int_to_string(ops_n))
    return oren_time_now_ns()
}

fn _x64_function_frame_phase_state(phase_state) {
    var st = {
        "enabled": false,
        "summary_only": false,
        "log": nil,
        "start_ns": 0,
        "trace": false,
        "trace_stage_ns": 0,
        "max_call_argc": 0
    }
    if phase_state != nil {
        st["enabled"] = phase_state["enabled"]
        st["summary_only"] = phase_state["summary_only"]
        st["log"] = phase_state["log"]
        st["start_ns"] = phase_state["start_ns"]
        st["trace"] = phase_state["trace"]
        st["trace_stage_ns"] = phase_state["trace_stage_ns"]
        st["max_call_argc"] = phase_state["max_call_argc"]
    }
    return st
}

fn _x64_emit_function_locals_phase_done(name, frame, phase) {
    if phase["enabled"] && phase["summary_only"] != true {
        _x64_program_phase_log_append(phase["log"], "x64.codegen.function.locals.done",
            "name=" + name +
            " locals=" + oren_int_to_string(oren_map_len(frame["locals"])) +
            " elapsed_ms=" + oren_int_to_string((oren_time_now_ns() - phase["start_ns"]) / 1000000))
    }
    return nil
}

fn _x64_trace_function_collect_locals_done(phase) {
    if phase["trace"] {
        var dt0 = (oren_time_now_ns() - phase["trace_stage_ns"]) / 1000000
        print("[x64_fn] collect_locals done ms=" + oren_int_to_string(dt0))
    }
    return nil
}

fn _x64_emit_function_frame_debug(name, frame, max_call_argc) {
    // Bounded debug aid: print frame sizing for one function name.
    // Example:
    //   OREN_TRACE_X64_FN_FRAME=oren_string_from_bytes OREN_TRACE_X64_RT_OBJ_TOP_DECLS=1 ...
    var want_frame = oren_env("OREN_TRACE_X64_FN_FRAME")
    if want_frame != nil && want_frame != "" && want_frame == name {
        print("[x64_fn] name=" + name +
              " max_call_argc=" + oren_int_to_string(max_call_argc) +
              " max_intr=" + oren_int_to_string(frame["max_intr"]) +
              " intr_lim=" + oren_int_to_string(frame["intr_lim"]) +
		      " literal_slots=" + oren_int_to_string(frame["literal_slot_count"]) +
              " locals_pre_align_bytes=" + oren_int_to_string(frame["locals_pre_align_bytes"]))
    }
    return nil
}

fn _x64_emit_function_frame_alloc(ctx, frame) {
    var frame_size = frame["frame_size"]
    if frame_size > 0 { bytes_extend(ctx["code"], core.insn_sub_rsp_imm32(frame_size)) }
    return frame_size
}

fn _x64_emit_function_frame_phase_done(ctx, name, frame, frame_size, phase) {
    if phase["enabled"] && phase["summary_only"] != true {
        _x64_program_phase_log_append(phase["log"], "x64.codegen.function.frame.done",
            "name=" + name +
            " frame_bytes=" + oren_int_to_string(frame_size) +
            " literal_slots=" + oren_int_to_string(frame["literal_slot_count"]) +
            " code_bytes=" + oren_int_to_string(bytes_len(ctx["code"])) +
            " elapsed_ms=" + oren_int_to_string((oren_time_now_ns() - phase["start_ns"]) / 1000000))
    }
    return nil
}

fn _x64_emit_function_frame_header(ctx, name, frame, phase_state) {
    var phase = _x64_function_frame_phase_state(phase_state)
    _x64_emit_function_locals_phase_done(name, frame, phase)
    _x64_trace_function_collect_locals_done(phase)
    _x64_emit_function_frame_debug(name, frame, phase["max_call_argc"])
    var frame_size = _x64_emit_function_frame_alloc(ctx, frame)
    _x64_emit_function_frame_phase_done(ctx, name, frame, frame_size, phase)
    if phase["trace"] { return oren_time_now_ns() }
    return phase["trace_stage_ns"]
}

fn _x64_emit_function_call_depth_enter(ctx, call_depth_enabled) {
    if call_depth_enabled == true {
        // Call runtime hook (no args).
        var pos_enter = bytes_len(ctx["code"])
        bytes_push(ctx["code"], 232) // call rel32
        push_u32_le(ctx["code"], 0)
        oren_list_push(ctx["call_depth_enter_fixups"], pos_enter)
    }
    return nil
}

fn _x64_function_done_phase_detail(name, ops, locals, phase_detail) {
    var frame_size = phase_detail["frame_size"]
    var literal_slot_count = phase_detail["literal_slot_count"]
    var phase_body_ms = phase_detail["body_ms"]
    var phase_start = phase_detail["start_ns"]
    var phase_after_frame = phase_detail["after_frame_ns"]
    var phase_after_spill = phase_detail["after_spill_ns"]
    var phase_after_label = phase_detail["after_label_ns"]
    var phase_after_call_depth_gate = phase_detail["after_call_depth_gate_ns"]
    var phase_after_call_depth_emit = phase_detail["after_call_depth_emit_ns"]
    var phase_after_tick = phase_detail["after_tick_ns"]
    var ops_n_detail = 0
    if ops != nil { ops_n_detail = oren_list_len(ops) }
    return " ops=" + oren_int_to_string(ops_n_detail) +
        " locals=" + oren_int_to_string(oren_map_len(locals)) +
        " frame_bytes=" + oren_int_to_string(frame_size) +
        " literal_slots=" + oren_int_to_string(literal_slot_count) +
        " body_ms=" + oren_int_to_string(phase_body_ms) +
        " after_frame_ms=" + oren_int_to_string((phase_after_frame - phase_start) / 1000000) +
        " after_spill_ms=" + oren_int_to_string((phase_after_spill - phase_start) / 1000000) +
        " after_label_ms=" + oren_int_to_string((phase_after_label - phase_start) / 1000000) +
        " after_depth_gate_ms=" + oren_int_to_string((phase_after_call_depth_gate - phase_start) / 1000000) +
        " after_depth_emit_ms=" + oren_int_to_string((phase_after_call_depth_emit - phase_start) / 1000000) +
        " after_tick_ms=" + oren_int_to_string((phase_after_tick - phase_start) / 1000000)
}

fn _x64_emit_function_done_phase(phase_log, name, ops, locals, local_fixups, phase_detail) {
    var phase_start = phase_detail["start_ns"]
    var phase_summary_only = phase_detail["summary_only"]
    var code_bytes = phase_detail["code_bytes"]
    var phase_done_detail = "name=" + name +
        " code_bytes=" + oren_int_to_string(code_bytes) +
        " fixups=" + oren_int_to_string(oren_list_len(local_fixups)) +
        " elapsed_ms=" + oren_int_to_string((oren_time_now_ns() - phase_start) / 1000000)
    if phase_summary_only == true {
        phase_done_detail = phase_done_detail +
            _x64_function_done_phase_detail(name, ops, locals, phase_detail)
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.detail", phase_done_detail)
    } else {
        _x64_program_phase_log_append(phase_log, "x64.codegen.function.done", phase_done_detail)
    }
    return nil
}

fn _x64_begin_function_compile_phase(ctx, name) {
    var trace_this = _x64_function_trace_enabled(name)
    var phase_log = nil
    if ctx != nil { phase_log = ctx["phase_log"] }
    var phase_summary_only = _x64_function_phase_summary_only(ctx, name, trace_this)
    var phase_this = _x64_function_phase_enabled(ctx, name, trace_this, phase_summary_only)
    var phase_start = 0
    if phase_this {
        phase_start = oren_time_now_ns()
        if phase_summary_only != true {
            _x64_program_phase_log_append(phase_log, "x64.codegen.function.start", "name=" + name)
        }
    }
    var trace_stage = 0
    if trace_this { trace_stage = oren_time_now_ns(); print("[x64_fn] start name=" + name) }
    return {
        "log": phase_log,
        "enabled": phase_this,
        "summary_only": phase_summary_only,
        "start_ns": phase_start,
        "trace": trace_this,
        "trace_stage_ns": trace_stage,
        "max_call_argc": 0,
        "after_frame_ns": 0,
        "after_spill_ns": 0,
        "after_label_ns": 0,
        "after_call_depth_gate_ns": 0,
        "after_call_depth_emit_ns": 0,
        "after_tick_ns": 0
    }
}

fn _x64_mark_function_phase_after(phase_state, key) {
    if phase_state != nil && phase_state["summary_only"] == true {
        phase_state[key] = oren_time_now_ns()
    }
    return nil
}

fn _x64_register_function_entry(ctx, name) {
    var fn_off = bytes_len(ctx["code"])
    ctx["functions"][name] = fn_off
    bytes_extend(ctx["code"], core.insn_push_rbp())
    bytes_extend(ctx["code"], core.insn_mov_rbp_rsp())
    return fn_off
}

fn _x64_emit_compiled_function_entry_runtime(ctx, name, fn_state, compile_opts, phase_state) {
    var fn_node = fn_state["fn_node"]
    var frame = fn_state["frame"]
    var locals = frame["locals"]
    var params = frame["params"]
    var pc = frame["pc"]
    var regc = frame["regc"]
    var shadow = frame["shadow"]
    var save_regs = frame["save_regs"]
    var save_n = frame["save_n"]
    var locals_size = frame["locals_size"]
    var frame_size = frame["frame_size"]

    if _x64_emit_function_spills(ctx, locals, params, pc, regc, shadow, save_regs, save_n, locals_size) == nil {
        return nil
    }
    _x64_mark_function_phase_after(phase_state, "after_spill_ns")

    var call_depth_enabled = _x64_function_call_depth_enabled(fn_node, name,
        compile_opts["user_fn_fast_call_depth"], compile_opts["call_depth_default_enabled"])
    _x64_mark_function_phase_after(phase_state, "after_call_depth_gate_ns")
    // Never instrument the slow-path helpers either, otherwise:
    //   enter() -> native_call_depth_enter_slow() -> enter() -> ...
    // once multithreading disables the single-thread fast-path.
    _x64_emit_function_call_depth_enter(ctx, call_depth_enabled)
    _x64_mark_function_phase_after(phase_state, "after_call_depth_emit_ns")
    if _x64_emit_function_gc_tick_init(ctx, locals) == nil { return nil }
    _x64_mark_function_phase_after(phase_state, "after_tick_ns")

    return { "call_depth_enabled": call_depth_enabled }
}

fn _x64_emit_compiled_function_ops_block(ctx, name, fn_state, compile_opts, phase_state) {
    var ops = fn_state["ops"]
    var frame = fn_state["frame"]
    var locals = frame["locals"]
    var labels = fn_state["labels"]
    var local_fixups = fn_state["local_fixups"]
    var epilogue_label = fn_state["epilogue_label"]
    var phase_body_ms = _x64_emit_function_body_ops(ctx, name, ops, locals, labels, local_fixups,
        epilogue_label, compile_opts["platform"], phase_state["trace"], phase_state["enabled"],
        phase_state["summary_only"], phase_state["log"], phase_state["start_ns"])
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if phase_state["trace"] { phase_state["trace_stage_ns"] = oren_time_now_ns() }
    return { "body_ms": phase_body_ms }
}

fn _x64_compiled_function_done_detail(ctx, frame, phase_state, phase_body_ms) {
    return {
        "frame_size": frame["frame_size"],
        "literal_slot_count": frame["literal_slot_count"],
        "body_ms": phase_body_ms,
        "start_ns": phase_state["start_ns"],
        "summary_only": phase_state["summary_only"],
        "after_frame_ns": phase_state["after_frame_ns"],
        "after_spill_ns": phase_state["after_spill_ns"],
        "after_label_ns": phase_state["after_label_ns"],
        "after_call_depth_gate_ns": phase_state["after_call_depth_gate_ns"],
        "after_call_depth_emit_ns": phase_state["after_call_depth_emit_ns"],
        "after_tick_ns": phase_state["after_tick_ns"],
        "code_bytes": bytes_len(ctx["code"])
    }
}

fn _x64_emit_compiled_function_finish(ctx, name, fn_state, phase_state, call_depth_state, body_state) {
    var ops = fn_state["ops"]
    var frame = fn_state["frame"]
    var locals = frame["locals"]
    var labels = fn_state["labels"]
    var local_fixups = fn_state["local_fixups"]
    var epilogue_label = fn_state["epilogue_label"]
    var save_regs = frame["save_regs"]
    var save_n = frame["save_n"]
    var locals_size = frame["locals_size"]
    var frame_size = frame["frame_size"]
    var call_depth_enabled = call_depth_state["call_depth_enabled"]
    if _x64_emit_function_epilogue(ctx, locals, labels, local_fixups, epilogue_label,
                                   call_depth_enabled, save_regs, save_n, locals_size, frame_size) == nil {
        return nil
    }
    if phase_state["enabled"] {
        _x64_emit_function_done_phase(phase_state["log"], name, ops, locals, local_fixups,
            _x64_compiled_function_done_detail(ctx, frame, phase_state, body_state["body_ms"]))
    }
    if phase_state["trace"] {
        var dt2 = (oren_time_now_ns() - phase_state["trace_stage_ns"]) / 1000000
        print("[x64_fn] patch_fixups done ms=" + oren_int_to_string(dt2))
    }
    return true
}

fn _x64_emit_compiled_function_body(ctx, name, fn_state, compile_opts, phase_state) {
    var call_depth_state = _x64_emit_compiled_function_entry_runtime(ctx, name, fn_state, compile_opts, phase_state)
    if call_depth_state == nil { return nil }
    var body_state = _x64_emit_compiled_function_ops_block(ctx, name, fn_state, compile_opts, phase_state)
    if body_state == nil { return nil }
    return _x64_emit_compiled_function_finish(ctx, name, fn_state, phase_state, call_depth_state, body_state)
}

fn _x64_compile_function_start(ctx, fn_node) {
    if fn_node == nil { return nil }
    var name = fn_node["name"]
    if name == nil {
        err(ctx, "x64 native v0: function missing name")
        return nil
    }
    var phase_state = _x64_begin_function_compile_phase(ctx, name)
    _x64_function_reset_context(ctx, name)
    return {"name": name, "phase_state": phase_state}
}

fn _x64_compile_function_analyze(ctx, fn_node, name, phase_state) {
    var analyzed = _x64_function_analyze_ops(ctx, fn_node, name, phase_state)
    if analyzed == nil { return nil }
    var ops = analyzed["ops"]
    if phase_state["trace"] {
        phase_state["trace_stage_ns"] = _x64_function_trace_analyze_done(name, ops, phase_state["trace_stage_ns"])
    }

    // Compute the maximum argument count among calls in this function so we can:
    // - reserve enough outgoing call-area space for stack args (ABI dependent)
    var max_call_argc = _max_call_argc_in_ops(ctx, ops)
    phase_state["max_call_argc"] = max_call_argc
    return {
        "ops": ops,
        "needs_literal_slots": analyzed["needs_literal_slots"],
        "max_call_argc": max_call_argc
    }
}

fn _x64_compile_function_frame(ctx, fn_node, name, analysis, phase_state) {
    _x64_register_function_entry(ctx, name)

    var frame = _x64_prepare_function_frame_v0(ctx, fn_node, name,
        analysis["ops"], analysis["max_call_argc"], analysis["needs_literal_slots"])
    if frame == nil { return nil }
    phase_state["trace_stage_ns"] = _x64_emit_function_frame_header(ctx, name, frame, phase_state)
    _x64_mark_function_phase_after(phase_state, "after_frame_ns")
    return frame
}

fn _x64_compile_function_make_state(ctx, fn_node, ops, frame, phase_state) {
    var labels = {}
    var local_fixups = []
    // `_new_label` returns compact counter keys; keep the cosmetic prefix constant so
    // every function prologue does not rebuild a long mangled function-name string.
    var epilogue_label = _new_label(ctx, "fn_epilogue")
    _x64_mark_function_phase_after(phase_state, "after_label_ns")
    return {
        "fn_node": fn_node,
        "ops": ops,
        "frame": frame,
        "labels": labels,
        "local_fixups": local_fixups,
        "epilogue_label": epilogue_label
    }
}

fn _x64_compile_function_opts(platform, user_fn_fast_call_depth, call_depth_default_enabled) {
    return {
        "platform": platform,
        "user_fn_fast_call_depth": user_fn_fast_call_depth,
        "call_depth_default_enabled": call_depth_default_enabled
    }
}

fn _compile_function_v0(ctx, fn_node, platform, user_fn_fast_call_depth, call_depth_default_enabled) {
    // Targeted tracing for pathological compile-time hot spots (self-host / cross-target).
    // Example:
    //   OREN_TRACE_X64_FN=M9_native_call_chunk_070_lowering_g
    var start = _x64_compile_function_start(ctx, fn_node)
    if start == nil { return nil }
    var name = start["name"]
    var phase_state = start["phase_state"]

    var analysis = _x64_compile_function_analyze(ctx, fn_node, name, phase_state)
    if analysis == nil { return nil }
    var frame = _x64_compile_function_frame(ctx, fn_node, name, analysis, phase_state)
    if frame == nil { return nil }

    _x64_emit_compiled_function_body(ctx, name,
        _x64_compile_function_make_state(ctx, fn_node, analysis["ops"], frame, phase_state),
        _x64_compile_function_opts(platform, user_fn_fast_call_depth, call_depth_default_enabled),
        phase_state)
    return nil
}
