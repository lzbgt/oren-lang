fn _extract_functions_v0(ctx, linked) {
    // CoreIR v0: keep function scanning/metadata deterministic and shared.
    // This preserves existing x64 error message prefixes for compatibility with fixtures.
    return coreir.collect_top_level_functions(ctx, linked, "x64 native v0")
}

fn _x64_tmp_names_init(ctx) {
    if ctx == nil { return nil }
    if ctx["__x64_tmp_names"] != nil { return nil }

    // Keep these as string literals to avoid per-function string allocation churn.
    ctx["__x64_tmp_names"] = [
        "$tmp1", "$tmp2", "$tmp3", "$tmp4", "$tmp5", "$tmp6", "$tmp7", "$tmp8"
    ]

    // Literal spill names are fixed small sets; keep them as literals too.
    ctx["__x64_tmp_lit_list_hdr_names"] = [
        "$tmp_lit_list_hdr0", "$tmp_lit_list_hdr1", "$tmp_lit_list_hdr2", "$tmp_lit_list_hdr3",
        "$tmp_lit_list_hdr4", "$tmp_lit_list_hdr5", "$tmp_lit_list_hdr6", "$tmp_lit_list_hdr7"
    ]
    ctx["__x64_tmp_lit_map_hdr_names"] = [
        "$tmp_lit_map_hdr0", "$tmp_lit_map_hdr1", "$tmp_lit_map_hdr2", "$tmp_lit_map_hdr3",
        "$tmp_lit_map_hdr4", "$tmp_lit_map_hdr5", "$tmp_lit_map_hdr6", "$tmp_lit_map_hdr7"
    ]
    return nil
}

fn _compile_function_v0(ctx, fn_node, platform) {
    if fn_node == nil { return nil }
    var name = fn_node["name"]
    if name == nil { err(ctx, "x64 native v0: function missing name"); return nil }
    // Expose the current function name to lowering passes (used for small, explicit
    // rolling exceptions like "do not varargs-pack inside __oren_fnwrap_* bodies").
    ctx["cur_fn_name"] = name
    // Per-function float propagation map (rolling heuristic).
    //
    // v0 carries float values as raw f64 bits in integer registers, and x64 uses a
    // conservative local-tracking scheme to decide when to emit SSE2 scalar ops.
    ctx["locals_floaty"] = {}

    var ops = _analyze_supported_fn_body(ctx, fn_node)
    if ops == nil { return nil }

    // Compute the maximum argument count among calls in this function so we can:
    // - reserve enough outgoing call-area space for stack args (ABI dependent)
    var max_call_argc = _max_call_argc_in_ops(ctx, ops)

    var fn_off = bytes_len(ctx["code"])
    ctx["functions"][name] = fn_off

    bytes_extend(ctx["code"], insn_push_rbp())
    bytes_extend(ctx["code"], insn_mov_rbp_rsp())

    // Allocate locals + (Windows) call shadow/args area.
    //
    // Locals are addressed via RBP-negative offsets in 8-byte steps.
    var locals = {}
    var local_next = 8
    var params = fn_node["params"]
    var pc = 0
    if params != nil { pc = oren_list_len(params) }
    var i = 0
    while i < pc {
        var p = params[i]
        var pnm = p["value"]
        if locals[pnm] != nil { err(ctx, "x64 native v0: duplicate param " + pnm); return nil }
        locals[pnm] = local_next
        local_next = local_next + 8
        // Type annotation hinting (rolling):
        //
        // Parameters annotated as `f32`/`f64` must participate in the float-propagation
        // heuristic so float intrinsics (e.g. `oren_f32_to_u32_bits`) accept identifiers.
        var ann = p["ann_type"]
        if ann != nil && ctx["locals_floaty"] != nil {
            if ann == "f32" || ann == "f64" { ctx["locals_floaty"][pnm] = true }
        }
        i = i + 1
    }

    local_next = _collect_locals_from_ops(ctx, ops, locals, local_next)
    if local_next == nil { return nil }

    // Reserve a spill slot so expression lowering can safely handle calls on RHS without
    // perturbing RSP (keeps ABI alignment intact for nested calls).
    if locals["$tmp0"] != nil { err(ctx, "x64 native v0: reserved local name $tmp0 used"); return nil }
    locals["$tmp0"] = local_next
    local_next = local_next + 8

    // Reserve a spill slot for condition comparison lowering. This must be distinct from $tmp0
    // because RHS expression evaluation may itself use $tmp0 (calls/infix spill), and we must
    // preserve the LHS value until the final cmp.
    if locals["$tmp_cmp"] != nil { err(ctx, "x64 native v0: reserved local name $tmp_cmp used"); return nil }
    locals["$tmp_cmp"] = local_next
    local_next = local_next + 8

    // Reserve a spill slot for shift lowering, for the same reason as $tmp_cmp: RHS expression
    // evaluation can use $tmp0, so we need an independent slot to preserve the LHS value.
    if locals["$tmp_shift"] != nil { err(ctx, "x64 native v0: reserved local name $tmp_shift used"); return nil }
    locals["$tmp_shift"] = local_next
    local_next = local_next + 8

    // Reserve a spill slot for division lowering, because idiv uses RAX/RDX and we need
    // to preserve the dividend while evaluating the divisor.
    if locals["$tmp_div"] != nil { err(ctx, "x64 native v0: reserved local name $tmp_div used"); return nil }
    locals["$tmp_div"] = local_next
    local_next = local_next + 8

    // Reserve additional general-purpose spill slots used by x64 intrinsics.
    // These are intentionally generic so future intrinsic lowering doesn't need to keep
    // growing the reserved namespace (keeps ABI stable while the backend evolves).
    _x64_tmp_names_init(ctx)
    var tmp_names = ctx["__x64_tmp_names"]
    var ti = 1
    while ti <= 8 {
        var tnm = oren_list_get(tmp_names, ti - 1)
        if locals[tnm] != nil { err(ctx, "x64 native v0: reserved local name " + tnm + " used"); return nil }
        locals[tnm] = local_next
        local_next = local_next + 8
        ti = ti + 1
    }

    // Now that we have a complete locals map (params + locals + reserved `$tmp*`), compute the
    // maximum intrinsic-temp pool usage needed for this function.
    //
    // This MUST be done after local collection so we can correctly size indirect call lowering:
    // - calling a local/global variable that shadows a function name (`locals > globals > functions`)
    // - calling a non-identifier callee expression (first-class callables)
    var max_intr = _max_intr_tmp_in_ops(ctx, ops, locals)
    if max_intr == nil { max_intr = 0 }
    var intr_lim = max_intr + 8
    if intr_lim < 16 { intr_lim = 16 }
    // Rolling safety ceiling: if a function needs an extreme amount of temp spilling,
    // fail fast rather than silently capping and producing miscompiles.
    if intr_lim > 4096 {
        err(ctx, "x64 native v0: intrinsic temp demand too high (need " + oren_int_to_string(intr_lim) + ")")
        return nil
    }
    // Reset the intrinsic temp allocator for this function.
    ctx["intr_tmp_cursor"] = 0
    ctx["intr_tmp_limit"] = intr_lim
    // Per-function intrinsic-temp spill region base offset (RBP-relative).
    // Cleared/overwritten for each function; used by `_intr_tmp_off`.
    ctx["intr_tmp_base_off"] = nil

    // Bounded debug aid: print frame sizing for one function name.
    // Example:
    //   OREN_TRACE_X64_FN_FRAME=oren_string_from_bytes OREN_TRACE_X64_RT_OBJ_TOP_DECLS=1 ...
    var want_frame = oren_env("OREN_TRACE_X64_FN_FRAME")
    if want_frame != nil && want_frame != "" && want_frame == name {
        print("[x64_fn] name=" + name +
                  " max_call_argc=" + oren_int_to_string(max_call_argc) +
                  " max_intr=" + oren_int_to_string(max_intr) +
                  " intr_lim=" + oren_int_to_string(intr_lim) +
                  " locals_pre_align_bytes=" + oren_int_to_string(local_next - 8))
    }

    // Reserve a pool of spill slots used by intrinsic lowering to support nesting safely.
    // These slots are addressed via `IntrTmp{idx}` (not string-named locals) to avoid:
    // - per-use `$tmp_intrN` string allocations
    // - per-function locals-map inserts for each intrinsic temp
    //
    // Slots are a contiguous region of 8-byte stack words.
    ctx["intr_tmp_base_off"] = local_next
    var intr_bytes = intr_lim
    intr_bytes = iadd(intr_bytes, intr_bytes) // *2
    intr_bytes = iadd(intr_bytes, intr_bytes) // *4
    intr_bytes = iadd(intr_bytes, intr_bytes) // *8
    local_next = iadd(local_next, intr_bytes)

    // Reserve literal-building spill slots. These must be re-entrant because list/map literals
    // can be nested (e.g. `[0, 1, [0, 0]]` in for-in lowering).
    //
    // Note: `oren_list_push` intrinsic lowering uses `$tmp1..$tmp6`, so we must not depend on
    // those across nested expression evaluation. Dedicated `$tmp_lit_*` slots avoid clobbering.
    var ld = 0
    while ld < 8 {
        var hn1 = oren_list_get(ctx["__x64_tmp_lit_list_hdr_names"], ld)
        if locals[hn1] != nil { err(ctx, "x64 native v0: reserved local name " + hn1 + " used"); return nil }
        locals[hn1] = local_next
        local_next = local_next + 8

        var hn2 = oren_list_get(ctx["__x64_tmp_lit_map_hdr_names"], ld)
        if locals[hn2] != nil { err(ctx, "x64 native v0: reserved local name " + hn2 + " used"); return nil }
        locals[hn2] = local_next
        local_next = local_next + 8
        ld = ld + 1
    }

    var locals_size = local_next - 8
    var align = abi.stack_align_bytes(ctx["abi"])
    if align < 1 { align = 16 }
    // Align locals area to ABI stack alignment so nested calls keep the required boundary.
    while core.int_mod(locals_size, align) != 0 { locals_size = locals_size + 1 }

    // Reserve an outgoing call area at the bottom of the frame so call lowering can:
    // - satisfy Win64 32B shadow requirement (if applicable)
    // - place stack args without mutating RSP inside expression lowering
    //
    // For SysV, shadow is 0 and stack args begin at [rsp+0] at the call site.
    // For Win64, stack args begin at [rsp+0x20] at the call site.
    var regc = abi.max_int_reg_args(ctx["abi"])
    var shadow = abi.caller_shadow_bytes(ctx["abi"])
    var slot = abi.stack_arg_slot_bytes(ctx["abi"])
    var stack_slots = 0
    if max_call_argc > regc { stack_slots = max_call_argc - regc }
    var need_call_area = shadow + stack_slots * slot
    var call_area = abi.callee_call_area_bytes(ctx["abi"])
    if need_call_area > call_area { call_area = need_call_area }
    // Keep RSP aligned after `push rbp; sub rsp, frame_size` so all nested calls satisfy the ABI.
    while core.int_mod(call_area, align) != 0 { call_area = call_area + 1 }

    // Win64 ABI: keep RSP 16B-aligned in non-prolog code regions.
    //
    // MSVC x64 conventions require the stack pointer to remain 16-byte aligned outside
    // prolog/epilog sequences (non-leaf functions included).
    //
    // Our prologue uses `push rbp` (8B) and then subtracts `frame_size`. Because the
    // incoming RSP at function entry is 8 mod 16 (return address pushed by the call),
    // `push rbp` brings it back to 0 mod 16. Therefore `frame_size` must be a multiple
    // of 16 to keep RSP aligned for all nested calls (including WinAPI IAT calls).

    // Provide call lowering with the reserved call-area capacity for this function.
    ctx["cur_call_area_bytes"] = call_area

    // ABI hygiene (Tier-1): preserve a stable callee-saved set.
    //
    // The injected runtime is compiled by the same backend, and we freely call across
    // user/runtime boundaries. Preserving a stable set of non-volatile regs prevents subtle
    // miscompiles when callers keep values in registers across calls.
    //
    // IMPORTANT (arch unification): r14/r15 are reserved global heap registers on x64
    // (heap_limit/heap_ptr, mirrors arm64 X27/X28). They MUST NOT be saved/restored by
    // prologues/epilogues, otherwise allocator updates performed inside callees would be
    // rolled back on return. The platform ABI tables reflect this by excluding r14/r15
    // from `callee_saved_regs` for x64.
    var save_regs = abi.callee_saved_regs(ctx["abi"])
    var save_n = 0
    if save_regs != nil { save_n = oren_list_len(save_regs) }
    var save_bytes = save_n * 8
    // Keep the full frame aligned so nested calls satisfy the ABI.
    while core.int_mod(save_bytes, align) != 0 { save_bytes = save_bytes + 8 }

    var frame_size = locals_size + save_bytes + call_area
    if frame_size > 0 { bytes_extend(ctx["code"], insn_sub_rsp_imm32(frame_size)) }

    // Spill callee-saved regs into a dedicated region below locals (above call-area).
    var si = 0
    while si < save_n {
        var reg_save = save_regs[si]
        var off_save = locals_size + 8 * (si + 1)
        _emit_mov_mrbp_r64(ctx, 0 - off_save, reg_save)
        si = si + 1
    }

    // Spill incoming params to their stack slots.
    i = 0
    while i < pc {
        var p2 = params[i]
        var pnm2 = p2["value"]
        var off = locals[pnm2]
        if off == nil { err(ctx, "x64 native v0: missing param slot"); return nil }

        // Params 0..regc-1 come from ABI registers. Additional params come from the caller stack.
        if i < regc {
            var reg_enc = abi.int_arg_reg(ctx["abi"], i)
            if reg_enc == nil { err(ctx, "x64 native v0: unsupported param index"); return nil }
            var reg = reg_enc - 1
            // Spill the full register width so function pointers can be passed/called.
            _emit_mov_mrbp_r64(ctx, 0 - off, reg)
        } else {
            // Callee stack layout after `push rbp; mov rbp,rsp`:
            // - [rbp+8]  return address
            // - [rbp+16] first stack arg on SysV (arg#7)
            // - [rbp+48] first stack arg on Win64 (arg#5), because of 32B shadow
            var stack_base = 16 + shadow
            var disp = stack_base + 8 * (i - regc)
            _emit_mov_r64_mrbp(ctx, 0, disp)     // rax = arg
            _emit_mov_mrbp_r64(ctx, 0 - off, 0) // [local] = rax
        }
        i = i + 1
    }

    var labels = {}
    var local_fixups = []
    var epilogue_label = _new_label(ctx, name + "_epilogue")

    // Stack safety (Tier‑1 parity with arm64):
    //
    // Use the shared runtime call-depth hooks
    // (`oren_call_depth_enter/exit`) so arm64/x64 converge on one semantics set.
    var call_depth_enabled = true
    // Do not instrument the injected runtime itself; it contains the call-depth hooks.
    // If we instrument those functions, we recurse indefinitely.
    var tok0 = fn_node["token"]
    var ffile0 = nil
    if tok0 != nil { ffile0 = tok0["file"] }
    if ffile0 == "lib/runtime_native.oren" { call_depth_enabled = false }
    if ffile0 == "lib/runtime_native_capsule.oren" { call_depth_enabled = false }
    if ffile0 != nil && oren_string_len(ffile0) >= 7 {
        if oren_string_slice(ffile0, 0, 7) == "<native:" { call_depth_enabled = false }
    }
    if name == "oren_call_depth_enter" { call_depth_enabled = false }
    if name == "oren_call_depth_exit" { call_depth_enabled = false }
    if call_depth_enabled == true {
        // Call runtime hook (no args).
        var pos_enter = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": pos_enter, "name": "oren_call_depth_enter"})
    }
    _emit_ops_in_fn(ctx, ops, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    _emit_label(ctx, labels, epilogue_label)
    if call_depth_enabled == true {
        // Preserve RAX (function return value) across the exit hook call.
        //
        // The runtime hook returns 0 in RAX; without preserving, every function would
        // accidentally return 0.
        var off_ret = locals["$tmp0"]
        if off_ret == nil { err(ctx, "x64 native v0: missing $tmp0 spill slot"); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - off_ret, 0) // [tmp] = rax
        var pos_exit = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_call_rel32(0))
        oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": pos_exit, "name": "oren_call_depth_exit"})
        _emit_mov_r64_mrbp(ctx, 0, 0 - off_ret) // rax = [tmp]
    }
    // Restore ABI callee-saved regs (inverse of prologue spill).
    var sj = save_n - 1
    while sj >= 0 {
        var reg_restore = save_regs[sj]
        var off_restore = locals_size + 8 * (sj + 1)
        _emit_mov_r64_mrbp(ctx, reg_restore, 0 - off_restore)
        sj = sj - 1
    }
    if frame_size > 0 { bytes_extend(ctx["code"], insn_add_rsp_imm32(frame_size)) }
    bytes_extend(ctx["code"], insn_pop_rbp())
    bytes_extend(ctx["code"], insn_ret())

    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}
