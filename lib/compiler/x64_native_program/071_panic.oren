// Panic/diagnostic helpers for x64 native (rolling).
//
// This chunk exists to keep `040_emit_expr.oren` from growing beyond reviewable limits.
// It implements a minimal `oren_panic(msg)` contract compatible with Tier‑1 bring-up:
// - emit a stable `OREN_DIAG` line on stdout (best-effort)
// - exit(1) deterministically

fn _emit_strlen_cstr0_to_rdx(ctx, ptr_reg) {
    // Compute strlen(ptr) for a NUL-terminated byte string.
    //
    // Input:
    // - ptr_reg: register holding pointer
    //
    // Output:
    // - RDX: length in bytes (u64)
    //
    // Clobbers: RAX, R10, R11
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, ptr_reg)) // r10 = ptr
    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, 0))      // edx = 0

    var labels = {}
    var fixups = []
    var l_loop = _new_label(ctx, "strlen_loop")
    var l_done = _new_label(ctx, "strlen_done")

    _emit_label(ctx, labels, l_loop)
    // r11 = ptr + len
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_r64(11, 2))
    // eax = *(u8*)r11
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 11))
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_done)
    bytes_extend(ctx["code"], insn_add_r64_imm32(2, 1)) // rdx++
    _emit_jmp_to_label(ctx, fixups, l_loop)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_linux_write_ptr_len(ctx, ptr_reg, len_reg) {
    // SYS_write(1, ptr, len) where ptr/len are registers.
    // Clobbers: RAX, RDI, RSI, RDX, RCX, R11 (syscall clobbers RCX/R11)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1)) // eax=SYS_write
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 1)) // edi=1 (stdout)
    bytes_extend(ctx["code"], insn_mov_r64_r64(6, ptr_reg)) // rsi = ptr
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, len_reg)) // rdx = len
    bytes_extend(ctx["code"], insn_syscall())
    return nil
}

fn _emit_linux_write_str(ctx, s) {
    if s == nil { s = "" }
    var off = _data_add_cstr0(ctx, s)
    if off == nil { return nil }
    var nbytes = oren_string_len(s)
    // rax=1 write, rdi=1 stdout, rsi=&data, rdx=len
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 1))
    var lea_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_rsi_rip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea_rsi", "pos": lea_pos + 3, "data_off": off})
    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, nbytes))
    bytes_extend(ctx["code"], insn_syscall())
    return nil
}

fn _emit_windows_write_ptr_len(ctx, ptr_reg, len_reg) {
    // Emit:
    //   h = GetStdHandle(-11)
    //   WriteFile(h, ptr, len, &written, NULL)
    //
    // Uses Win64 ABI (RCX, RDX, R8, R9, shadow space).
    //
    // Input:
    // - ptr_reg: pointer to buffer
    // - len_reg: length in bytes
    //
    // Clobbers: RAX, RCX, RDX, R8, R9, R10, R11
    //
    // Stack usage: writes at [rsp+0x20] and [rsp+0x28] within the pre-reserved shadow area.

    // --- GetStdHandle(STD_OUTPUT_HANDLE=-11) ---
    bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 4294967285)) // ecx = -11
    var mov_iat0 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat0 + 3, "data_label": "IAT_GetStdHandle"})
    bytes_extend(ctx["code"], insn_call_rax())

    // rcx = hStdout
    bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0))
    // r8 = len  (do this before clobbering any potential len_reg == rdx)
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, len_reg))
    // rdx = buf
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, ptr_reg))

    // lpOverlapped = NULL (arg5) at [rsp+0x20]
    bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(32, 0))
    bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(36, 0))
    // r9 = &written (arg4)
    bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(9, 40))

    // --- WriteFile ---
    var mov_iat1 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat1 + 3, "data_label": "IAT_WriteFile"})
    bytes_extend(ctx["code"], insn_call_rax())
    return nil
}

fn _emit_panic_with_msg_ptr(ctx, msg_ptr_reg) {
    // Best-effort panic printing compatible with Tier‑1 bring-up.
    //
    // Output (stdout):
    //   OREN_DIAG kind=panic code=1 msg=<msg>
    //
    // Then abort(1) deterministically.
    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" {
        // NOTE: on Win64 we do not have a cheap way to write mixed literal+dynamic without
        // allocating; emit as 3 writes: prefix, msg, newline.
        //
        // prefix literal
        var pref = "OREN_DIAG kind=panic code=1 msg="
        var pref_off = _data_add_cstr0(ctx, pref)
        if pref_off == nil { _emit_abort_exitcode(ctx, 1); return nil }
        // lea rdx, [rip+pref] ; r8d=len
        // GetStdHandle/WriteFile for (ptr,len)
        var lea_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(2, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_rdata_lea", "pos": lea_pos + 3, "data_off": pref_off})
        bytes_extend(ctx["code"], insn_mov_r32_imm32(11, oren_string_len(pref))) // r11d=len
        _emit_windows_write_ptr_len(ctx, 2, 11)

        // msg dynamic: compute len in rdx
        _emit_strlen_cstr0_to_rdx(ctx, msg_ptr_reg)
        // Move len to a stable temp reg (rdx will be overwritten when setting up args).
        bytes_extend(ctx["code"], insn_mov_r64_r64(11, 2)) // r11 = len
        // write msg
        _emit_windows_write_ptr_len(ctx, msg_ptr_reg, 11)
        // newline literal
        var nl_off = _data_add_cstr0(ctx, "\n")
        if nl_off == nil { _emit_abort_exitcode(ctx, 1); return nil }
        var lea_pos2 = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(2, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_rdata_lea", "pos": lea_pos2 + 3, "data_off": nl_off})
        bytes_extend(ctx["code"], insn_mov_r32_imm32(11, 1)) // r11d=1
        _emit_windows_write_ptr_len(ctx, 2, 11)

        _emit_abort_exitcode(ctx, 1)
        return nil
    }

    // Linux: emit prefix + msg + newline (three writes).
    _emit_linux_write_str(ctx, "OREN_DIAG kind=panic code=1 msg=")
    _emit_strlen_cstr0_to_rdx(ctx, msg_ptr_reg)
    _emit_linux_write_ptr_len(ctx, msg_ptr_reg, 2)
    _emit_linux_write_str(ctx, "\n")
    _emit_abort_exitcode(ctx, 1)
    return nil
}
