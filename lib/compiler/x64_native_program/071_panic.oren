// Panic/diagnostic helpers for x64 native (rolling).
//
// This chunk exists to keep `040_emit_expr.oren` from growing beyond reviewable limits.
// It implements a minimal `oren_panic(msg)` contract compatible with Tier‑1 bring-up:
// - emit a stable `OREN_DIAG` line on stdout (best-effort)
// - exit(1) deterministically

fn _emit_strlen_cstr0_to_rdx(ctx, ptr_reg) {
    // Compute strlen(ptr) for a NUL-terminated byte string.
    //
    // Input:
    // - ptr_reg: register holding pointer
    //
    // Output:
    // - RDX: length in bytes (u64)
    //
    // Clobbers: RAX, RCX, R10
    //
    // NOTE: keep this helper safe for callers that pass ptr_reg in R11:
    // earlier versions used R11 as a scratch address register, which clobbered
    // the input pointer and caused writes to use the wrong base address.
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, ptr_reg)) // r10 = ptr
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 0))      // edx = 0
    var state = _x64_strlen_cstr0_labels(ctx)
    _x64_strlen_cstr0_emit_loop(ctx, state)
    _x64_strlen_cstr0_finish(ctx, state)
    return nil
}

fn _x64_strlen_cstr0_labels(ctx) {
    var labels = {}
    var fixups = []
    return {
        "labels": labels,
        "fixups": fixups,
        "loop": _new_label(ctx, "strlen_loop"),
        "done": _new_label(ctx, "strlen_done")
    }
}

fn _x64_strlen_cstr0_emit_loop(ctx, state) {
    var labels = state["labels"]
    var fixups = state["fixups"]
    var l_loop = state["loop"]
    var l_done = state["done"]

    _emit_label(ctx, labels, l_loop)
    // rcx = ptr + len
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 10))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(1, 2))
    // eax = *(u8*)rcx
    bytes_extend(ctx["code"], core.insn_movzx_r32_mr8(0, 1))
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_done)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(2, 1)) // rdx++
    _emit_jmp_to_label(ctx, fixups, l_loop)
    return nil
}

fn _x64_strlen_cstr0_finish(ctx, state) {
    _emit_label(ctx, state["labels"], state["done"])
    _patch_local_fixups(ctx, state["labels"], state["fixups"])
    return nil
}

fn _emit_linux_write_ptr_len(ctx, ptr_reg, len_reg) {
    // SYS_write(1, ptr, len) where ptr/len are registers.
    // Clobbers: RAX, RDI, RSI, RDX, RCX, R11 (syscall clobbers RCX/R11)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1)) // eax=SYS_write
    // Move ptr/len first so callers may pass ptr_reg==RDI without losing the pointer.
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(6, ptr_reg)) // rsi = ptr
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, len_reg)) // rdx = len
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, 1)) // edi=1 (stdout)
    bytes_extend(ctx["code"], core.insn_syscall())
    return nil
}

fn _emit_linux_write_str(ctx, s) {
    if s == nil { s = "" }
    var off = _data_add_cstr0(ctx, s)
    // `off` can legitimately be 0; `_data_add_cstr0` is ctx-local and cannot fail here.
    var nbytes = oren_string_len(s)
    // rax=1 write, rdi=1 stdout, rsi=&data, rdx=len
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, 1))
    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_rsi_rip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea_rsi", "pos": lea_pos + 3, "data_off": off})
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, nbytes))
    bytes_extend(ctx["code"], core.insn_syscall())
    return nil
}

fn _emit_windows_write_ptr_len(ctx, ptr_reg, len_reg) {
    // Emit:
    //   h = GetStdHandle(-11)
    //   WriteFile(h, ptr, len, &written, NULL)
    //
    // Uses Win64 ABI (RCX, RDX, R8, R9, shadow space).
    //
    // Input:
    // - ptr_reg: pointer to buffer
    // - len_reg: length in bytes
    //
    // Clobbers: RAX, RCX, RDX, R8, R9, R10, R11
    //
    // Stack usage: writes at [rsp+0x20] and [rsp+0x28] within the pre-reserved shadow area.

    // --- GetStdHandle(STD_OUTPUT_HANDLE=-11) ---
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 4294967285)) // ecx = -11
    var mov_iat0 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat0 + 3, "IAT_GetStdHandle")
    bytes_extend(ctx["code"], core.insn_call_rax())

    // rcx = hStdout
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0))
    // r8 = len  (do this before clobbering any potential len_reg == rdx)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(8, len_reg))
    // rdx = buf
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, ptr_reg))

    // lpOverlapped = NULL (arg5) at [rsp+0x20]
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(32, 0))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_imm32(36, 0))
    // r9 = &written (arg4)
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(9, 40))

    // --- WriteFile ---
    var mov_iat1 = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat1 + 3, "IAT_WriteFile")
    bytes_extend(ctx["code"], core.insn_call_rax())
    return nil
}

fn _emit_panic_preserve_msg_reg(ctx, msg_ptr_reg) {
    var msg_reg = msg_ptr_reg
    if msg_reg == nil { msg_reg = 12 }
    if msg_reg != 12 {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, msg_reg))
        msg_reg = 12
    }
    return msg_reg
}

fn _emit_windows_write_cstr_ptr(ctx, data_off, nbytes) {
    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(2, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": data_off})
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(11, nbytes))
    _emit_windows_write_ptr_len(ctx, 2, 11)
    return nil
}

fn _emit_windows_panic_diag(ctx, msg_reg) {
    // NOTE: on Win64 we do not have a cheap way to write mixed literal+dynamic without
    // allocating; emit as 3 writes: prefix, msg, newline.
    var pref = "OREN_DIAG kind=panic code=1 msg="
    var pref_off = _data_add_cstr0(ctx, pref)
    // `pref_off` can legitimately be 0; `_data_add_cstr0` is ctx-local and cannot fail here.
    _emit_windows_write_cstr_ptr(ctx, pref_off, oren_string_len(pref))

    _emit_strlen_cstr0_to_rdx(ctx, msg_reg)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 2)) // r11 = len
    _emit_windows_write_ptr_len(ctx, msg_reg, 11)

    var nl_off = _data_add_cstr0(ctx, "\n")
    // `nl_off` can legitimately be 0; `_data_add_cstr0` is ctx-local and cannot fail here.
    _emit_windows_write_cstr_ptr(ctx, nl_off, 1)
    return nil
}

fn _emit_linux_panic_diag(ctx, msg_reg) {
    _emit_linux_write_str(ctx, "OREN_DIAG kind=panic code=1 msg=")
    _emit_strlen_cstr0_to_rdx(ctx, msg_reg)
    _emit_linux_write_ptr_len(ctx, msg_reg, 2)
    _emit_linux_write_str(ctx, "\n")
    return nil
}

fn _emit_panic_debug_stack_if_enabled(ctx, platform) {
    if platform != nil && platform["debug"] == true {
        _emit_stack_trace_best_effort(ctx)
    }
    return nil
}

fn _emit_windows_panic_with_msg_reg(ctx, msg_reg, platform) {
    _emit_windows_panic_diag(ctx, msg_reg)
    // Keep best-effort stack traces enabled in debug builds (Tier‑1 parity with Linux).
    // This is intentionally bounded (<=16 frames) and allocation-free.
    _emit_panic_debug_stack_if_enabled(ctx, platform)
    _emit_abort_exitcode(ctx, 1)
    return nil
}

fn _emit_linux_panic_with_msg_reg(ctx, msg_reg, platform) {
    _emit_linux_panic_diag(ctx, msg_reg)
    // Keep stack traces in debug builds by default (size/perf tradeoff for release builds).
    _emit_panic_debug_stack_if_enabled(ctx, platform)
    _emit_abort_exitcode(ctx, 1)
    return nil
}

fn _emit_panic_with_msg_ptr(ctx, msg_ptr_reg) {
    // Best-effort panic printing compatible with Tier‑1 bring-up.
    //
    // Output (stdout):
    //   OREN_DIAG kind=panic code=1 msg=<msg>
    //
    // Then abort(1) deterministically.
    //
    // IMPORTANT:
    // - On both Linux and Win64, our write syscalls / WinAPI calls clobber caller-saved regs.
    // - `oren_panic(msg)` evaluation typically leaves `msg` in RAX (reg 0).
    // Preserve the message pointer in a callee-saved register before emitting any I/O.
    var msg_reg = _emit_panic_preserve_msg_reg(ctx, msg_ptr_reg)
    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" {
        return _emit_windows_panic_with_msg_reg(ctx, msg_reg, platform)
    }

    // Linux: emit prefix + msg + newline (three writes).
    return _emit_linux_panic_with_msg_reg(ctx, msg_reg, platform)
}

fn _x64_panic_helper_name() { return "__oren_panic_helper" }

fn _emit_panic_helper_mark_needed_x64(ctx) {
    if ctx == nil { return nil }
    ctx["need_panic_helper"] = true
    return nil
}

fn _x64_panic_helper_should_emit(ctx, name) {
    if ctx == nil { return false }
    if ctx["need_panic_helper"] != true { return false }
    if ctx["functions"] != nil && ctx["functions"][name] != nil { return false }
    return true
}

fn _x64_panic_helper_register(ctx, name) {
    var off = bytes_len(ctx["code"])
    if ctx["functions"] == nil { ctx["functions"] = {} }
    ctx["functions"][name] = off
    return off
}

fn _x64_panic_helper_msg_arg_reg(ctx) {
    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" { return 1 }
    return 7
}

fn _emit_panic_helper_fn_if_needed_x64(ctx) {
    // Emit a single shared panic helper function and let all compiler-generated panics
    // call it instead of inlining large panic+stacktrace sequences at every site.
    var name = _x64_panic_helper_name()
    if _x64_panic_helper_should_emit(ctx, name) != true { return nil }
    _x64_panic_helper_register(ctx, name)
    // Emit body: expect msg pointer in the platform arg register (SysV: RDI, Win64: RCX).
    _emit_panic_with_msg_ptr(ctx, _x64_panic_helper_msg_arg_reg(ctx))
    return nil
}

fn _emit_hex_table_ptr_to_r13(ctx) {
    // r13 = &"0123456789abcdef"
    var off = _data_add_cstr0(ctx, "0123456789abcdef")
    // `off` can legitimately be 0; `_data_add_cstr0` is ctx-local and cannot fail here.
    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(13, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": off})
    return nil
}

fn _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, shift, pos) {
    // Store one hex nibble from val_reg into *(buf_reg + pos), where nibble comes from (val >> shift) & 0xF.
    //
    // Requires:
    // - r13: hex table ptr
    //
    // Clobbers: rax, r10
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, val_reg))
    if shift > 0 { bytes_extend(ctx["code"], core.insn_shr_r64_imm8(0, shift)) }
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(0, 15)) // rax &= 0xF
    // r10 = table + rax
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 13))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(10, 0))
    // al = table[nibble]
    bytes_extend(ctx["code"], core.insn_movzx_r32_mr8(0, 10))
    // *(buf+pos) = al  (supports any base reg, including r8-r15)
    bytes_extend(ctx["code"], core.insn_mov_mr8_al_disp(buf_reg, pos))
    return nil
}

fn _emit_ascii_byte_to_buf_at(ctx, buf_reg, pos, byte_val) {
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, byte_val))
    bytes_extend(ctx["code"], core.insn_mov_mr8_al_disp(buf_reg, pos))
    return nil
}

fn _emit_format_u64_hex_digits(ctx, val_reg, buf_reg, first_pos) {
    // Emit 16 fixed-width hex digits, most-significant first.
    var shift = 60
    var pos = first_pos
    while shift >= 0 {
        _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, shift, pos)
        shift = shift - 4
        pos = pos + 1
    }
    return nil
}

fn _emit_format_u64_hex_prefix(ctx, val_reg, buf_reg) {
    // Format into memory at buf_reg:
    //   0x<16 hex digits><space>
    // Total bytes: 19 (no newline; caller prints suffix)
    //
    // Uses:
    // - r13: hex table ptr (must be initialized)
    // Clobbers: rax, rcx, rdx

    _emit_ascii_byte_to_buf_at(ctx, buf_reg, 0, 48) // '0'
    _emit_ascii_byte_to_buf_at(ctx, buf_reg, 1, 120) // 'x'
    _emit_format_u64_hex_digits(ctx, val_reg, buf_reg, 2)
    _emit_ascii_byte_to_buf_at(ctx, buf_reg, 18, 32) // trailing space
    return nil
}

fn _x64_resolve_symbol_best_effort_symtab_off(ctx) {
    // `ctx["symtab_off"]` is stored as `off+1` so offset 0 is representable while still
    // using `nil` as the sentinel for "missing" (call sites decode with `enc-1`).
    var symtab_off_enc = ctx["symtab_off"]
    if oren_type_tag(symtab_off_enc) != 1 { return nil }
    if symtab_off_enc <= 0 { return nil }
    return symtab_off_enc - 1
}

fn _x64_emit_resolve_symbol_default(ctx, out_ptr_reg, out_off_reg) {
    var unk_off = _data_add_cstr0(ctx, "???")
    // `unk_off` can legitimately be 0; `_data_add_cstr0` is ctx-local and cannot fail here.

    // Default out_ptr_reg = "???"; out_off_reg = 0.
    var lea_unk = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(out_ptr_reg, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_unk + 3, "data_off": unk_off})
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(out_off_reg, 0))
    return nil
}

fn _x64_emit_resolve_symbol_symtab_setup(ctx, addr_reg, symtab_off) {
    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "sym_done")
    var l_loop = _new_label(ctx, "sym_loop")
    var l_match = _new_label(ctx, "sym_match")

    // Compute code base address used by the fixed-base emitters.
    // Source of truth: `lib/compiler/native_abi.oren` (x64_v0_* helpers).
    var platform = ctx["platform"]
    var text_base = abi.x64_v0_text_base_addr(platform)

    // if addr < text_base => keep "???"
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(10, text_base)) // r10 = text_base
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(addr_reg, 10))
    // Treat return addresses as unsigned 64-bit domain values.
    _emit_jcc_to_label(ctx, fixups, "b", l_done)

    // off_target (r9) = addr - text_base
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, addr_reg))
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(9, 10))

    // r11 = &symtab (RIP-relative into appended data)
    var lea_sym = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(11, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_sym + 3, "data_off": symtab_off})

    // data_base (r8) = symtab_ptr - symtab_off
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(8, 11))
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(8, core.int_mod(symtab_off, 4294967296)))

    // count (r10) = *(u64*)symtab_ptr
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(10, 11))
    // entries_base (r11) = symtab_ptr + 8
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 8))
    // idx (rbx) = 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(3, 0))
    return {"labels": labels, "fixups": fixups, "l_done": l_done, "l_loop": l_loop, "l_match": l_match}
}

fn _x64_emit_resolve_table_scan_entry(ctx, st) {
    var labels = st["labels"]
    var fixups = st["fixups"]
    var l_done = st["l_done"]
    var l_loop = st["l_loop"]
    var l_match = st["l_match"]

    _emit_label(ctx, labels, l_loop)
    // if idx >= count => done
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(3, 10))
    _emit_jcc_to_label(ctx, fixups, "ge", l_done)

    // entry_ptr (rax) = entries_base + idx*8
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 3))
    bytes_extend(ctx["code"], core.insn_imul_r64_imm32(0, 8))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(0, 11))
    // entry (rax) = *(u64*)entry_ptr
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(0, 0))

    // entry_off (rsi) = low32(entry)  (keep r10 as count)
    bytes_extend(ctx["code"], core.insn_mov_r32_r32(6, 0))
    // if off_target >= entry_off => match
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(9, 6))
    _emit_jcc_to_label(ctx, fixups, "ae", l_match)
    return nil
}

fn _x64_emit_resolve_table_scan_miss(ctx, st) {
    var fixups = st["fixups"]
    var l_loop = st["l_loop"]
    // idx++
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(3, 1))
    _emit_jmp_to_label(ctx, fixups, l_loop)
    return nil
}

fn _x64_emit_resolve_table_match_label(ctx, st) {
    var labels = st["labels"]
    var l_match = st["l_match"]
    _emit_label(ctx, labels, l_match)
    return nil
}

fn _x64_emit_resolve_table_match_ptr_from_high32(ctx, out_ptr_reg) {
    // high32(entry) stores the data-relative C string offset.
    bytes_extend(ctx["code"], core.insn_shr_r64_imm8(0, 32))
    // out_ptr_reg = data_base + string_off
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(out_ptr_reg, 8))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(out_ptr_reg, 0))
    return nil
}

fn _x64_emit_resolve_table_match_done(ctx, st) {
    var fixups = st["fixups"]
    var l_done = st["l_done"]
    _emit_jmp_to_label(ctx, fixups, l_done)
    return nil
}

fn _x64_emit_resolve_symbol_scan_loop(ctx, st, out_ptr_reg, out_off_reg) {
    _x64_emit_resolve_table_scan_entry(ctx, st)
    _x64_emit_resolve_table_scan_miss(ctx, st)
    _x64_emit_resolve_table_match_label(ctx, st)
    // Compute:
    // - name_off = high32(entry)
    // - fn_off   = low32(entry)
    // - delta    = off_target - fn_off
    //
    // rsi currently holds fn_off (low32).
    // out_off_reg = r9 - rsi
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(out_off_reg, 9))
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(out_off_reg, 6))

    _x64_emit_resolve_table_match_ptr_from_high32(ctx, out_ptr_reg)
    _x64_emit_resolve_table_match_done(ctx, st)
    return nil
}

fn _emit_resolve_symbol_ptr_and_off_best_effort(ctx, addr_reg, out_ptr_reg, out_off_reg) {
    // Resolve an absolute return address to a best-effort function name pointer.
    //
    // Requires:
    // - ctx["symtab_off"] reserved by `_data_reserve_symtab` in program entry.
    // - fixed-base emitters (x64_elf/x64_pe) so absolute return addresses are stable.
    //
    // Returns:
    // - out_ptr_reg = pointer to NUL-terminated C string name (or "???")
    // - out_off_reg = u64 offset within function (0 if unknown)
    //
    // Clobbers: rax, rbx, r8, r9, r10, r11
    var symtab_off = _x64_resolve_symbol_best_effort_symtab_off(ctx)
    _x64_emit_resolve_symbol_default(ctx, out_ptr_reg, out_off_reg)
    if symtab_off == nil { return nil }

    var st = _x64_emit_resolve_symbol_symtab_setup(ctx, addr_reg, symtab_off)
    _x64_emit_resolve_symbol_scan_loop(ctx, st, out_ptr_reg, out_off_reg)
    _emit_label(ctx, st["labels"], st["l_done"])
    _patch_local_fixups(ctx, st["labels"], st["fixups"])
    return nil
}

fn _x64_emit_resolve_loc_default(ctx, out_ptr_reg) {
    var empty_off = _data_add_cstr0(ctx, "")
    // `empty_off` can legitimately be 0; `_data_add_cstr0` is ctx-local and cannot fail here.

    var lea_empty = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(out_ptr_reg, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_empty + 3, "data_off": empty_off})
    return nil
}

fn _x64_emit_resolve_loc_table_setup(ctx, addr_reg, linetab_off) {
    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "loc_done")
    var l_loop = _new_label(ctx, "loc_loop")
    var l_match = _new_label(ctx, "loc_match")

    var platform = ctx["platform"]
    var text_base = abi.x64_v0_text_base_addr(platform)

    // if addr < text_base => keep ""
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(10, text_base)) // r10 = text_base
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(addr_reg, 10))
    _emit_jcc_to_label(ctx, fixups, "b", l_done)

    // off_target (r9) = addr - text_base
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, addr_reg))
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(9, 10))

    // r11 = &linetab (RIP-relative into appended data)
    var lea_tab = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(11, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_tab + 3, "data_off": linetab_off})

    // data_base (r8) = linetab_ptr - linetab_off
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(8, 11))
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(8, core.int_mod(linetab_off, 4294967296)))

    // count (r10) = *(u64*)linetab_ptr
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(10, 11))
    // entries_base (r11) = linetab_ptr + 8
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 8))
    // idx (rbx) = 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(3, 0))
    return {"labels": labels, "fixups": fixups, "l_done": l_done, "l_loop": l_loop, "l_match": l_match}
}

fn _x64_emit_resolve_loc_scan_loop(ctx, st, out_ptr_reg) {
    _x64_emit_resolve_table_scan_entry(ctx, st)
    _x64_emit_resolve_table_scan_miss(ctx, st)
    _x64_emit_resolve_table_match_label(ctx, st)
    _x64_emit_resolve_table_match_ptr_from_high32(ctx, out_ptr_reg)
    _x64_emit_resolve_table_match_done(ctx, st)
    return nil
}

fn _emit_resolve_loc_ptr_best_effort(ctx, addr_reg, out_ptr_reg) {
    // Resolve an absolute return address to a best-effort call-site location pointer.
    //
    // Requires:
    // - ctx["linetab_off"] reserved by `_data_reserve_linetab` (debug-only).
    //
    // Returns:
    // - out_ptr_reg = pointer to NUL-terminated location string (or "" when unknown)
    //
    // Clobbers: rax, rbx, r8, r9, r10, r11, rsi
    var linetab_off = ctx["linetab_off"]
    _x64_emit_resolve_loc_default(ctx, out_ptr_reg)
    if linetab_off == nil { return nil }

    var st = _x64_emit_resolve_loc_table_setup(ctx, addr_reg, linetab_off)
    _x64_emit_resolve_loc_scan_loop(ctx, st, out_ptr_reg)
    _emit_label(ctx, st["labels"], st["l_done"])
    _patch_local_fixups(ctx, st["labels"], st["fixups"])
    return nil
}

fn _emit_format_plus0x_u64_hex_line(ctx, val_reg, buf_reg) {
    // Format into memory at buf_reg:
    //   +0x<16 hex digits>\n
    // Total bytes: 20
    //
    // Requires:
    // - r13: hex table ptr
    //
    // Clobbers: rax, rcx, rdx
    _emit_ascii_byte_to_buf_at(ctx, buf_reg, 0, 43) // '+'
    _emit_ascii_byte_to_buf_at(ctx, buf_reg, 1, 48) // '0'
    _emit_ascii_byte_to_buf_at(ctx, buf_reg, 2, 120) // 'x'
    _emit_format_u64_hex_digits(ctx, val_reg, buf_reg, 3)
    _emit_ascii_byte_to_buf_at(ctx, buf_reg, 19, 10) // newline
    return nil
}

fn _emit_stack_trace_loop_guards(ctx, fixups, l_done) {
    // if rbx >= 16 => done
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(3, 16))
    _emit_jcc_to_label(ctx, fixups, "ge", l_done)
    // if r12 == 0 => done
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(12, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_done)

    // Best-effort safety guards (avoid crashing while unwinding a corrupted chain):
    // - fp must be 8-byte aligned
    // - fp must be within [rsp, rsp+1MiB]
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 12))      // r11 = fp
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(11, 7))     // r11 &= 7
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))     // if (fp&7)!=0 => done
    _emit_jcc_to_label(ctx, fixups, "ne", l_done)
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(12, 4))       // fp < rsp => done
    _emit_jcc_to_label(ctx, fixups, "b", l_done)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 4))       // r11 = rsp
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 1048576)) // r11 = rsp + 1MiB
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(12, 11))      // fp > rsp+1MiB => done
    _emit_jcc_to_label(ctx, fixups, "a", l_done)
    return nil
}

fn _emit_stack_trace_load_ret_addr(ctx, scratch_ret_addr) {
    // ret = *(r12 + 8) into r10
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 12))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 8))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(10, 11))
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_r64(scratch_ret_addr, 10))
    return nil
}

fn _emit_stack_trace_windows_write_pc_line(ctx, scratch_ret_addr) {
    // Save ret across Win64 calls (do NOT use shadow space slots [rsp+0..0x1F]).
    _emit_stack_trace_load_ret_addr(ctx, scratch_ret_addr)

    // buf = rsp + 0x60
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(11, 96))
    // Reload ret into r10 for formatting (r10 is volatile).
    bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(10, scratch_ret_addr))
    _emit_format_u64_hex_prefix(ctx, 10, 11)
    // Windows Tier-1 (rolling): print raw PCs only.
    // - avoids PE/Mach-O debug format assumptions during bring-up
    // - avoids crashing inside best-effort symbolication when tables are missing/partial
    // Replace trailing space with newline and write 19 bytes.
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 10)) // al = '\n'
    bytes_extend(ctx["code"], core.insn_mov_mr8_al_disp(11, 18))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 19))
    _emit_windows_write_ptr_len(ctx, 11, 10)
    return nil
}

fn _emit_stack_trace_advance(ctx, scratch_save_off, fixups, l_done, l_loop) {
    // next_fp = *(fp); require monotonic growth to avoid loops.
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_r64(scratch_save_off, 12))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(12, 12))
    bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(11, scratch_save_off))
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(12, 11))
    _emit_jcc_to_label(ctx, fixups, "be", l_done)
    // rbx++
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(3, 1))
    _emit_jmp_to_label(ctx, fixups, l_loop)
    return nil
}

fn _emit_stack_trace_windows_best_effort(ctx, scratch_save_off, scratch_ret_addr) {
    // Header
    _emit_windows_write_cstr(ctx, "STACK_TRACE:")
    // Cursor (r12) = rbp
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 5))
    // frame counter (rbx) = 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(3, 0))

    var labels = {}
    var fixups = []
    var l_loop = _new_label(ctx, "stack_trace_loop")
    var l_done = _new_label(ctx, "stack_trace_done")
    _emit_label(ctx, labels, l_loop)

    _emit_stack_trace_loop_guards(ctx, fixups, l_done)
    _emit_stack_trace_windows_write_pc_line(ctx, scratch_ret_addr)
    _emit_stack_trace_advance(ctx, scratch_save_off, fixups, l_done, l_loop)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_stack_trace_linux_write_pc_prefix(ctx, scratch_ret_addr) {
    _emit_stack_trace_load_ret_addr(ctx, scratch_ret_addr)

    // buf = rsp + 0x60
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(11, 96))
    bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(10, scratch_ret_addr))
    _emit_format_u64_hex_prefix(ctx, 10, 11)
    // len=19 in r10
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 19))
    _emit_linux_write_ptr_len(ctx, 11, 10)
    return nil
}

fn _emit_stack_trace_linux_write_symbol(ctx, scratch_save_off, scratch_ret_addr) {
    bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(10, scratch_ret_addr))
    _emit_resolve_symbol_ptr_and_off_best_effort(ctx, 10, 11, 9)
    // Preserve offset across helper calls (strlen clobbers r10).
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_r64(scratch_save_off, 9))
    _emit_strlen_cstr0_to_rdx(ctx, 11)
    _emit_linux_write_ptr_len(ctx, 11, 2)
    return nil
}

fn _emit_stack_trace_linux_write_loc_if_available(ctx, scratch_ret_addr) {
    if ctx["linetab_off"] != nil {
        // Keep loc ptr out of R11 so the default isn't clobbered by strlen/write helpers.
        bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(10, scratch_ret_addr))
        _emit_resolve_loc_ptr_best_effort(ctx, 10, 7) // rdi = loc ptr (or "")
        _emit_strlen_cstr0_to_rdx(ctx, 7)
        _emit_linux_write_ptr_len(ctx, 7, 2)
    }
    return nil
}

fn _emit_stack_trace_linux_write_offset_line(ctx, scratch_save_off) {
    // Restore offset into r10 for "+0x...".
    bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(10, scratch_save_off))
    // "+0x<off>\n" into buf2 then write it
    bytes_extend(ctx["code"], core.insn_lea_r64_rsp_disp8(11, 64)) // buf2 = rsp + 0x40
    _emit_format_plus0x_u64_hex_line(ctx, 10, 11)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 20))
    _emit_linux_write_ptr_len(ctx, 11, 10)
    return nil
}

fn _emit_stack_trace_linux_best_effort(ctx, scratch_save_off, scratch_ret_addr) {
    // Linux header
    _emit_linux_write_str(ctx, "STACK_TRACE:\n")
    // Cursor (r12) = rbp
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 5))
    // frame counter (rbx) = 0
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(3, 0))

    var labels2 = {}
    var fixups2 = []
    var l_loop2 = _new_label(ctx, "stack_trace_loop")
    var l_done2 = _new_label(ctx, "stack_trace_done")
    _emit_label(ctx, labels2, l_loop2)

    _emit_stack_trace_loop_guards(ctx, fixups2, l_done2)
    _emit_stack_trace_linux_write_pc_prefix(ctx, scratch_ret_addr)
    _emit_stack_trace_linux_write_symbol(ctx, scratch_save_off, scratch_ret_addr)
    _emit_stack_trace_linux_write_loc_if_available(ctx, scratch_ret_addr)
    _emit_stack_trace_linux_write_offset_line(ctx, scratch_save_off)
    _emit_stack_trace_advance(ctx, scratch_save_off, fixups2, l_done2, l_loop2)

    _emit_label(ctx, labels2, l_done2)
    _patch_local_fixups(ctx, labels2, fixups2)
    return nil
}

fn _emit_stack_trace_best_effort(ctx) {
    // Best-effort stack trace based on RBP chain.
    //
    // Rolling contract (Tier-1):
    // - prints a stable header and up to 16 return addresses
    // - avoids allocations and does not depend on injected runtime
    //
    // Caveats:
    // - best-effort only: symbolication uses an embedded symtab (fixed-base emitters)
    // - call-site mapping is best-effort and only available when a linetab is embedded (debug builds)
    // - relies on frame pointers being enabled (true for current x64 prologues)
    //
    // Clobbers: volatile regs; exits soon after anyway.
    var platform = ctx["platform"]

    // Reserve scratch on stack for formatting buffers.
    // Use >= 128 so Win64 shadow space and our local buffer don't overlap.
    bytes_extend(ctx["code"], core.insn_sub_rsp_imm32(128))

    _emit_hex_table_ptr_to_r13(ctx)

    // Scratch layout (rsp-relative, within the 128B reservation):
    // - [rsp+0x00..0x1F] is Win64 shadow space (not safe across calls).
    // - [rsp+0x20..0x3F] is safe across Win64 calls.
    // Keep persistent values we need across WriteFile calls in this safe region.
    var scratch_save_off = 48 // 0x30: saved symbol offset
    var scratch_ret_addr = 56 // 0x38: saved return address

    if platform != nil && platform["os"] == "windows" {
        _emit_stack_trace_windows_best_effort(ctx, scratch_save_off, scratch_ret_addr)
    } else {
        _emit_stack_trace_linux_best_effort(ctx, scratch_save_off, scratch_ret_addr)
    }
    bytes_extend(ctx["code"], core.insn_add_rsp_imm32(128))
    return nil
}
