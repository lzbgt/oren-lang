// Panic/diagnostic helpers for x64 native (rolling).
//
// This chunk exists to keep `040_emit_expr.oren` from growing beyond reviewable limits.
// It implements a minimal `oren_panic(msg)` contract compatible with Tier‑1 bring-up:
// - emit a stable `OREN_DIAG` line on stdout (best-effort)
// - exit(1) deterministically

fn _emit_strlen_cstr0_to_rdx(ctx, ptr_reg) {
    // Compute strlen(ptr) for a NUL-terminated byte string.
    //
    // Input:
    // - ptr_reg: register holding pointer
    //
    // Output:
    // - RDX: length in bytes (u64)
    //
    // Clobbers: RAX, R10, R11
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, ptr_reg)) // r10 = ptr
    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, 0))      // edx = 0

    var labels = {}
    var fixups = []
    var l_loop = _new_label(ctx, "strlen_loop")
    var l_done = _new_label(ctx, "strlen_done")

    _emit_label(ctx, labels, l_loop)
    // r11 = ptr + len
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 10))
    bytes_extend(ctx["code"], insn_add_r64_r64(11, 2))
    // eax = *(u8*)r11
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 11))
    bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_done)
    bytes_extend(ctx["code"], insn_add_r64_imm32(2, 1)) // rdx++
    _emit_jmp_to_label(ctx, fixups, l_loop)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_linux_write_ptr_len(ctx, ptr_reg, len_reg) {
    // SYS_write(1, ptr, len) where ptr/len are registers.
    // Clobbers: RAX, RDI, RSI, RDX, RCX, R11 (syscall clobbers RCX/R11)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1)) // eax=SYS_write
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 1)) // edi=1 (stdout)
    bytes_extend(ctx["code"], insn_mov_r64_r64(6, ptr_reg)) // rsi = ptr
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, len_reg)) // rdx = len
    bytes_extend(ctx["code"], insn_syscall())
    return nil
}

fn _emit_linux_write_str(ctx, s) {
    if s == nil { s = "" }
    var off = _data_add_cstr0(ctx, s)
    if off == nil { return nil }
    var nbytes = oren_string_len(s)
    // rax=1 write, rdi=1 stdout, rsi=&data, rdx=len
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 1))
    var lea_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_rsi_rip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea_rsi", "pos": lea_pos + 3, "data_off": off})
    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, nbytes))
    bytes_extend(ctx["code"], insn_syscall())
    return nil
}

fn _emit_windows_write_ptr_len(ctx, ptr_reg, len_reg) {
    // Emit:
    //   h = GetStdHandle(-11)
    //   WriteFile(h, ptr, len, &written, NULL)
    //
    // Uses Win64 ABI (RCX, RDX, R8, R9, shadow space).
    //
    // Input:
    // - ptr_reg: pointer to buffer
    // - len_reg: length in bytes
    //
    // Clobbers: RAX, RCX, RDX, R8, R9, R10, R11
    //
    // Stack usage: writes at [rsp+0x20] and [rsp+0x28] within the pre-reserved shadow area.

    // --- GetStdHandle(STD_OUTPUT_HANDLE=-11) ---
    bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 4294967285)) // ecx = -11
    var mov_iat0 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat0 + 3, "data_label": "IAT_GetStdHandle"})
    bytes_extend(ctx["code"], insn_call_rax())

    // rcx = hStdout
    bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0))
    // r8 = len  (do this before clobbering any potential len_reg == rdx)
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, len_reg))
    // rdx = buf
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, ptr_reg))

    // lpOverlapped = NULL (arg5) at [rsp+0x20]
    bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(32, 0))
    bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(36, 0))
    // r9 = &written (arg4)
    bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(9, 40))

    // --- WriteFile ---
    var mov_iat1 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
    oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat1 + 3, "data_label": "IAT_WriteFile"})
    bytes_extend(ctx["code"], insn_call_rax())
    return nil
}

fn _emit_call_depth_enter_guard_x64(ctx, labels, fixups) {
    // Deterministic call depth guard (rolling Tier‑1):
    //
    // - increments a global call depth counter
    // - aborts via `oren_panic("call depth exceeded")` when depth > max
    //
    // This is intentionally runtime-free: x64 native does not yet inject
    // `lib/runtime_native.oren`, so we keep the state in the appended data blob.
    //
    // Requires:
    // - ctx["call_depth_off"] and ctx["call_depth_max_off"] reserved in program entry.
    // - the final ELF/PE emitter maps the data blob writable (rolling v0; see TODOs).
    var off_depth = ctx["call_depth_off"]
    var off_max = ctx["call_depth_max_off"]
    if off_depth == nil || off_max == nil { err(ctx, "x64 native v0: call depth globals missing"); return nil }

    // r10 = &call_depth
    var lea0 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea0 + 3, "data_off": off_depth})
    // r11 = *r10
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 10))
    // r11++
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 1))
    // *r10 = r11
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11))

    // r10 = &call_depth_max
    var lea1 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea1 + 3, "data_off": off_max})
    // r12 = *r10 (max)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(12, 10))

    // if depth <= max => ok
    bytes_extend(ctx["code"], insn_cmp_r64_r64(11, 12))
    var l_ok = _new_label(ctx, "call_depth_ok")
    _emit_jcc_to_label(ctx, fixups, "le", l_ok)

    // Exceeded: panic with a stable message.
    var msg_off = _data_add_cstr0(ctx, "call depth exceeded")
    if msg_off == nil { _emit_abort_exitcode(ctx, 1); return nil }
    var lea2 = oren_list_len(ctx["code"])
    // Use a non-syscall-clobbered register: Linux syscalls clobber RCX/R11.
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(12, 0)) // r12 = msg ptr
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea2 + 3, "data_off": msg_off})
    _emit_panic_with_msg_ptr(ctx, 12)

    _emit_label(ctx, labels, l_ok)
    return nil
}

fn _emit_call_depth_exit_guard_x64(ctx) {
    // Decrement the global call depth counter (best-effort).
    //
    // Important: preserve RAX (return value). Only clobber scratch regs.
    var off_depth = ctx["call_depth_off"]
    if off_depth == nil { return nil }

    // r10 = &call_depth
    var lea0 = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea0 + 3, "data_off": off_depth})
    // r11 = *r10
    bytes_extend(ctx["code"], insn_mov_r64_mr64(11, 10))
    // if r11 <= 0 => done
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "call_depth_exit_done")
    _emit_jcc_to_label(ctx, fixups, "le", l_done)
    // r11--
    bytes_extend(ctx["code"], insn_sub_r64_imm32(11, 1))
    // *r10 = r11
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11))
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_panic_with_msg_ptr(ctx, msg_ptr_reg) {
    // Best-effort panic printing compatible with Tier‑1 bring-up.
    //
    // Output (stdout):
    //   OREN_DIAG kind=panic code=1 msg=<msg>
    //
    // Then abort(1) deterministically.
    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" {
        // NOTE: on Win64 we do not have a cheap way to write mixed literal+dynamic without
        // allocating; emit as 3 writes: prefix, msg, newline.
        //
        // prefix literal
        var pref = "OREN_DIAG kind=panic code=1 msg="
        var pref_off = _data_add_cstr0(ctx, pref)
        if pref_off == nil { _emit_abort_exitcode(ctx, 1); return nil }
        // lea rdx, [rip+pref] ; r8d=len
        // GetStdHandle/WriteFile for (ptr,len)
        var lea_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(2, 0))
        // Windows PE: dynamic strings live in the user data blob (mapped as `.data` in v0).
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": pref_off})
        bytes_extend(ctx["code"], insn_mov_r32_imm32(11, oren_string_len(pref))) // r11d=len
        _emit_windows_write_ptr_len(ctx, 2, 11)

        // msg dynamic: compute len in rdx
        _emit_strlen_cstr0_to_rdx(ctx, msg_ptr_reg)
        // Move len to a stable temp reg (rdx will be overwritten when setting up args).
        bytes_extend(ctx["code"], insn_mov_r64_r64(11, 2)) // r11 = len
        // write msg
        _emit_windows_write_ptr_len(ctx, msg_ptr_reg, 11)
        // newline literal
        var nl_off = _data_add_cstr0(ctx, "\n")
        if nl_off == nil { _emit_abort_exitcode(ctx, 1); return nil }
        var lea_pos2 = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(2, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos2 + 3, "data_off": nl_off})
        bytes_extend(ctx["code"], insn_mov_r32_imm32(11, 1)) // r11d=1
        _emit_windows_write_ptr_len(ctx, 2, 11)

        _emit_stack_trace_best_effort(ctx)
        _emit_abort_exitcode(ctx, 1)
        return nil
    }

    // Linux: emit prefix + msg + newline (three writes).
    _emit_linux_write_str(ctx, "OREN_DIAG kind=panic code=1 msg=")
    _emit_strlen_cstr0_to_rdx(ctx, msg_ptr_reg)
    _emit_linux_write_ptr_len(ctx, msg_ptr_reg, 2)
    _emit_linux_write_str(ctx, "\n")
    _emit_stack_trace_best_effort(ctx)
    _emit_abort_exitcode(ctx, 1)
    return nil
}

fn _emit_hex_table_ptr_to_r13(ctx) {
    // r13 = &"0123456789abcdef"
    var off = _data_add_cstr0(ctx, "0123456789abcdef")
    if off == nil { return nil }
    var lea_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(13, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": off})
    return nil
}

fn _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, shift, pos) {
    // Store one hex nibble from val_reg into *(buf_reg + pos), where nibble comes from (val >> shift) & 0xF.
    //
    // Requires:
    // - r13: hex table ptr
    //
    // Clobbers: rax, r10, r11
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, val_reg))
    if shift > 0 { bytes_extend(ctx["code"], insn_shr_r64_imm8(0, shift)) }
    bytes_extend(ctx["code"], insn_and_r64_imm32(0, 15)) // rax &= 0xF
    // r11 = table + rax
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 13))
    bytes_extend(ctx["code"], insn_add_r64_r64(11, 0))
    // al = table[nibble]
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 11))
    // *(buf+pos) = al
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, pos))
    bytes_extend(ctx["code"], insn_mov_mr8_al(10))
    return nil
}

fn _emit_format_u64_hex_prefix(ctx, val_reg, buf_reg) {
    // Format into memory at buf_reg:
    //   0x<16 hex digits><space>
    // Total bytes: 19 (no newline; caller prints suffix)
    //
    // Uses:
    // - r13: hex table ptr (must be initialized)
    // Clobbers: rax, r10, r11, r12

    // buf[0]='0'
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 48))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_mov_mr8_al(10))
    // buf[1]='x'
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 120))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 1))
    bytes_extend(ctx["code"], insn_mov_mr8_al(10))

    // 16 hex digits, most-significant first.
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 60, 2)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 56, 3)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 52, 4)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 48, 5)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 44, 6)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 40, 7)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 36, 8)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 32, 9)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 28, 10)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 24, 11)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 20, 12)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 16, 13)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 12, 14)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 8, 15)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 4, 16)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 0, 17)

    // trailing space at buf[18]
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 32))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 18))
    bytes_extend(ctx["code"], insn_mov_mr8_al(10))
    return nil
}

fn _emit_resolve_symbol_ptr_and_off_best_effort(ctx, addr_reg, out_ptr_reg, out_off_reg) {
    // Resolve an absolute return address to a best-effort function name pointer.
    //
    // Requires:
    // - ctx["symtab_off"] reserved by `_data_reserve_symtab` in program entry.
    // - fixed-base emitters (x64_elf/x64_pe) so absolute return addresses are stable.
    //
    // Returns:
    // - out_ptr_reg = pointer to NUL-terminated C string name (or "???")
    // - out_off_reg = u64 offset within function (0 if unknown)
    //
    // Clobbers: rax, rbx, r8, r9, r10, r11
    var symtab_off = ctx["symtab_off"]
    var unk_off = _data_add_cstr0(ctx, "???")
    if unk_off == nil {
        // If we can't even store the unknown marker, leave out_ptr_reg unchanged.
        return nil
    }

    // Default out_ptr_reg = "???"; out_off_reg = 0
    var lea_unk = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(out_ptr_reg, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_unk + 3, "data_off": unk_off})
    bytes_extend(ctx["code"], insn_mov_r64_imm64(out_off_reg, 0))

    if symtab_off == nil { return nil }

    // Compute code base address used by the fixed-base emitters.
    // Source of truth: `lib/compiler/native_abi.oren` (x64_v0_* helpers).
    var platform = ctx["platform"]
    var text_base = abi.x64_v0_text_base_addr(platform)

    // if addr < text_base => keep "???"
    bytes_extend(ctx["code"], insn_mov_r64_imm64(10, text_base)) // r10 = text_base
    bytes_extend(ctx["code"], insn_cmp_r64_r64(addr_reg, 10))
    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "sym_done")
    var l_loop = _new_label(ctx, "sym_loop")
    var l_match = _new_label(ctx, "sym_match")
    _emit_jcc_to_label(ctx, fixups, "l", l_done)

    // off_target (r9) = addr - text_base
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, addr_reg))
    bytes_extend(ctx["code"], insn_sub_r64_r64(9, 10))

    // r11 = &symtab (RIP-relative into appended data)
    var lea_sym = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(11, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_sym + 3, "data_off": symtab_off})

    // data_base (r8) = symtab_ptr - symtab_off
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 11))
    bytes_extend(ctx["code"], insn_sub_r64_imm32(8, core.int_mod(symtab_off, 4294967296)))

    // count (r10) = *(u64*)symtab_ptr
    bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 11))
    // entries_base (r11) = symtab_ptr + 8
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
    // idx (rbx) = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(3, 0))

    _emit_label(ctx, labels, l_loop)
    // if idx >= count => done
    bytes_extend(ctx["code"], insn_cmp_r64_r64(3, 10))
    _emit_jcc_to_label(ctx, fixups, "ge", l_done)

    // entry_ptr (rax) = entries_base + idx*8
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 3))
    bytes_extend(ctx["code"], insn_imul_r64_imm32(0, 8))
    bytes_extend(ctx["code"], insn_add_r64_r64(0, 11))
    // entry (rax) = *(u64*)entry_ptr
    bytes_extend(ctx["code"], insn_mov_r64_mr64(0, 0))

    // entry_off (rsi) = low32(entry)  (keep r10 as count)
    bytes_extend(ctx["code"], insn_mov_r32_r32(6, 0))
    // if off_target >= entry_off => match
    bytes_extend(ctx["code"], insn_cmp_r64_r64(9, 6))
    _emit_jcc_to_label(ctx, fixups, "ge", l_match)

    // idx++
    bytes_extend(ctx["code"], insn_add_r64_imm32(3, 1))
    _emit_jmp_to_label(ctx, fixups, l_loop)

    _emit_label(ctx, labels, l_match)
    // Compute:
    // - name_off = high32(entry)
    // - fn_off   = low32(entry)
    // - delta    = off_target - fn_off
    //
    // rsi currently holds fn_off (low32).
    // out_off_reg = r9 - rsi
    bytes_extend(ctx["code"], insn_mov_r64_r64(out_off_reg, 9))
    bytes_extend(ctx["code"], insn_sub_r64_r64(out_off_reg, 6))

    // name_off = high32(entry)
    bytes_extend(ctx["code"], insn_shr_r64_imm8(0, 32))
    // out_ptr_reg = data_base + name_off
    bytes_extend(ctx["code"], insn_mov_r64_r64(out_ptr_reg, 8))
    bytes_extend(ctx["code"], insn_add_r64_r64(out_ptr_reg, 0))
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_format_plus0x_u64_hex_line(ctx, val_reg, buf_reg) {
    // Format into memory at buf_reg:
    //   +0x<16 hex digits>\n
    // Total bytes: 20
    //
    // Requires:
    // - r13: hex table ptr
    //
    // Clobbers: rax, r10, r11
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 43)) // '+'
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_mov_mr8_al(10))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 48)) // '0'
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 1))
    bytes_extend(ctx["code"], insn_mov_mr8_al(10))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 120)) // 'x'
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 2))
    bytes_extend(ctx["code"], insn_mov_mr8_al(10))

    // 16 hex digits at buf[3..18]
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 60, 3)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 56, 4)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 52, 5)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 48, 6)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 44, 7)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 40, 8)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 36, 9)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 32, 10)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 28, 11)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 24, 12)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 20, 13)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 16, 14)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 12, 15)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 8, 16)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 4, 17)
    _emit_hex_nibble_to_buf_at(ctx, val_reg, buf_reg, 0, 18)

    // newline at buf[19]
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 10))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 19))
    bytes_extend(ctx["code"], insn_mov_mr8_al(10))
    return nil
}

fn _emit_write_newline(ctx) {
    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" {
        var nl_off = _data_add_cstr0(ctx, "\n")
        if nl_off == nil { return nil }
        var lea_pos = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(2, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": nl_off})
        bytes_extend(ctx["code"], insn_mov_r32_imm32(11, 1))
        _emit_windows_write_ptr_len(ctx, 2, 11)
        return nil
    }
    _emit_linux_write_str(ctx, "\n")
    return nil
}

fn _emit_stack_trace_best_effort(ctx) {
    // Best-effort stack trace based on RBP chain.
    //
    // Rolling contract (Tier‑1):
    // - prints a stable header and up to 16 return addresses
    // - avoids allocations and does not depend on injected runtime
    //
    // Caveats:
    // - this is not a symbolic trace (no debug info / line mapping on x64 yet)
    // - relies on frame pointers being enabled (true for current x64 prologues)
    //
    // Clobbers: volatile regs; exits soon after anyway.
    var platform = ctx["platform"]

    // Reserve scratch on stack for formatting buffers.
    // Use >= 128 so Win64 shadow space and our local buffer don't overlap.
    bytes_extend(ctx["code"], insn_sub_rsp_imm32(128))

    _emit_hex_table_ptr_to_r13(ctx)

    if platform != nil && platform["os"] == "windows" {
        // Header
        _emit_windows_write_cstr(ctx, "STACK_TRACE:")
        // Cursor (r12) = rbp
        bytes_extend(ctx["code"], insn_mov_r64_r64(12, 5))
        // frame counter (r14) = 0
        bytes_extend(ctx["code"], insn_mov_r32_imm32(14, 0))

        var labels = {}
        var fixups = []
        var l_loop = _new_label(ctx, "stack_trace_loop")
        var l_done = _new_label(ctx, "stack_trace_done")
        _emit_label(ctx, labels, l_loop)

        // if r14 >= 16 => done
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(14, 16))
        _emit_jcc_to_label(ctx, fixups, "ge", l_done)
        // if r12 == 0 => done
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 0))
        _emit_jcc_to_label(ctx, fixups, "e", l_done)

        // ret = *(r12 + 8) into r15
        bytes_extend(ctx["code"], insn_mov_r64_r64(11, 12))
        bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(15, 11))

        // buf = rsp + 0x60
        bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(11, 96))
        _emit_format_u64_hex_prefix(ctx, 15, 11)
        // write buf prefix (ptr=r11, len=19 in r10)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 19))
        _emit_windows_write_ptr_len(ctx, 11, 10)

        // Symbolicate: print best-effort name + offset and newline.
        // - r11 = name ptr
        // - r10 = offset (clobberable after)
        _emit_resolve_symbol_ptr_and_off_best_effort(ctx, 15, 11, 10)
        _emit_strlen_cstr0_to_rdx(ctx, 11) // rdx = len
        bytes_extend(ctx["code"], insn_mov_r64_r64(9, 2)) // r9 = len
        _emit_windows_write_ptr_len(ctx, 11, 9)
        // print "+0x<off>\n"
        bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(11, 64)) // buf2 = rsp + 0x40
        _emit_format_plus0x_u64_hex_line(ctx, 10, 11)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 20))
        _emit_windows_write_ptr_len(ctx, 11, 9)

        // r12 = *(r12) (next frame)
        bytes_extend(ctx["code"], insn_mov_r64_mr64(12, 12))
        // r14++
        bytes_extend(ctx["code"], insn_add_r64_imm32(14, 1))
        _emit_jmp_to_label(ctx, fixups, l_loop)

        _emit_label(ctx, labels, l_done)
        _patch_local_fixups(ctx, labels, fixups)
        bytes_extend(ctx["code"], insn_add_rsp_imm32(128))
        return nil
    }

    // Linux header
    _emit_linux_write_str(ctx, "STACK_TRACE:\n")
    // Cursor (r12) = rbp
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 5))
    // frame counter (r14) = 0
    bytes_extend(ctx["code"], insn_mov_r32_imm32(14, 0))

    var labels2 = {}
    var fixups2 = []
    var l_loop2 = _new_label(ctx, "stack_trace_loop")
    var l_done2 = _new_label(ctx, "stack_trace_done")
    _emit_label(ctx, labels2, l_loop2)

    bytes_extend(ctx["code"], insn_cmp_r64_imm32(14, 16))
    _emit_jcc_to_label(ctx, fixups2, "ge", l_done2)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(12, 0))
    _emit_jcc_to_label(ctx, fixups2, "e", l_done2)

    // ret = *(r12 + 8) into r15
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 12))
    bytes_extend(ctx["code"], insn_add_r64_imm32(11, 8))
    bytes_extend(ctx["code"], insn_mov_r64_mr64(15, 11))

    // buf = rsp + 0x60
    bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(11, 96))
    _emit_format_u64_hex_prefix(ctx, 15, 11)
    // len=19 in r10
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 19))
    _emit_linux_write_ptr_len(ctx, 11, 10)

    _emit_resolve_symbol_ptr_and_off_best_effort(ctx, 15, 11, 10)
    _emit_strlen_cstr0_to_rdx(ctx, 11)
    _emit_linux_write_ptr_len(ctx, 11, 2)
    // "+0x<off>\n" into buf2 then write it
    bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(11, 64)) // buf2 = rsp + 0x40
    _emit_format_plus0x_u64_hex_line(ctx, 10, 11)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 20))
    _emit_linux_write_ptr_len(ctx, 11, 10)

    // r12 = *(r12)
    bytes_extend(ctx["code"], insn_mov_r64_mr64(12, 12))
    bytes_extend(ctx["code"], insn_add_r64_imm32(14, 1))
    _emit_jmp_to_label(ctx, fixups2, l_loop2)

    _emit_label(ctx, labels2, l_done2)
    _patch_local_fixups(ctx, labels2, fixups2)
    bytes_extend(ctx["code"], insn_add_rsp_imm32(128))
    return nil
}
