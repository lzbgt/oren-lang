    var tmp_file = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_port = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_key = _intr_tmp_off(ctx, locals, base + 2)
    var tmp_thr = _intr_tmp_off(ctx, locals, base + 3)
    if oren_type_tag(tmp_file) == 0 || oren_type_tag(tmp_port) == 0 || oren_type_tag(tmp_key) == 0 || oren_type_tag(tmp_thr) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_file)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_port)
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_key)
