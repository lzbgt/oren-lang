}

fn _x64_wsa_overlapped_labels(ctx, label_prefix) {
    return [
        {},
        [],
        _new_label(ctx, label_prefix + "_ok"),
        _new_label(ctx, label_prefix + "_pending_ok"),
        _new_label(ctx, label_prefix + "_done")
    ]
}

fn _x64_wsa_overlapped_emit_initial_result(ctx, lab) {
    var fixups = lab[1]
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", lab[2])
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "ne", lab[2]) // nonstandard but treat any non -1 as success
    return nil
}

