// --- IOCP (kernel32) syscall intrinsics (future Windows netpoll backend) ---
//
// These are currently used only by the IOCP bring-up path (runtime-gated by env),
// but we still lower them as real intrinsics so:
// - x64-windows binaries can use IOCP without libc/SDK headers
// - the runtime can keep the Windows backend selection logic in one place
//
// Conventions:
// - handle-returning APIs return HANDLE (u64) on success, or -errno on failure
// - bool-returning APIs return 0 on success, or -errno on failure

fn _x64_iocp_emit_invalid_param_handle_eio(ctx, labels, fixups, l_done, label_prefix) {
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 87)) // ERROR_INVALID_PARAMETER
    var l_next0 = _new_label(ctx, label_prefix + "_next0")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next0)
    _emit_set_rax_neg_errno_x64(ctx, 22)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next0)

    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 6)) // ERROR_INVALID_HANDLE
    var l_next1 = _new_label(ctx, label_prefix + "_next1")
    _emit_jcc_to_label(ctx, fixups, "ne", l_next1)
    _emit_set_rax_neg_errno_x64(ctx, 9)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next1)

    _emit_set_rax_neg_errno_x64(ctx, 5) // -EIO
    _emit_jmp_to_label(ctx, fixups, l_done)
    return nil
}

fn _x64_iocp_create_state(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 4)
    if oren_type_tag(base) == 0 { return nil }
    var tmp_file = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_port = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_key = _intr_tmp_off(ctx, locals, base + 2)
    var tmp_thr = _intr_tmp_off(ctx, locals, base + 3)
    if oren_type_tag(tmp_file) == 0 || oren_type_tag(tmp_port) == 0 || oren_type_tag(tmp_key) == 0 || oren_type_tag(tmp_thr) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_file)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_port)
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_key)
    _intr_eval_spill_x64(ctx, locals, args[3], tmp_thr)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    return [base, tmp_file, tmp_port, tmp_key, tmp_thr]
}

fn _x64_iocp_create_emit_call(ctx, state) {
    _intr_load_x64(ctx, 1, state[1]) // rcx = file_handle
    _intr_load_x64(ctx, 2, state[2]) // rdx = existing_port
    _intr_load_x64(ctx, 8, state[3]) // r8  = completion_key
    _intr_load_x64(ctx, 9, state[4]) // r9  = concurrent_threads
    _emit_call_iat_x64(ctx, "IAT_CreateIoCompletionPort")
    return nil
}

fn _x64_iocp_create_emit_result(ctx) {
    // rax = HANDLE (0 => failure)
    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "iocp_create_ok")
    var l_done = _new_label(ctx, "iocp_create_done")

    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)

    // Failure: GetLastError() -> -errno (best-effort mapping).
    _emit_call_iat_x64(ctx, "IAT_GetLastError") // eax = error

    _x64_iocp_emit_invalid_param_handle_eio(ctx, labels, fixups, l_done, "iocp_create_err")

    _emit_label(ctx, labels, l_ok)
    // Success: leave rax = HANDLE

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

