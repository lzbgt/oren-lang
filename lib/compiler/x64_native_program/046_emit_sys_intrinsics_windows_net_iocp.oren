fn _x64_wsarecv_emit_call(ctx, state) {
    // Build WSABUF as two 8-byte locals so we can take a stable address without
    // requiring extra Win64 outgoing stack space beyond the ABI argument area.
    //
    // Layout:
    // - [rbp - tmp_wsabuf_len] stores len (u64; low 32 bits are used)
    // - [rbp - tmp_wsabuf_buf] stores buf ptr (u64)
    _intr_load_x64(ctx, 0, state["tmp_len"])
    _emit_mov_mrbp_r64(ctx, 0 - state["tmp_wsabuf_len"], 0)
    _intr_load_x64(ctx, 0, state["tmp_buf"])
    _emit_mov_mrbp_r64(ctx, 0 - state["tmp_wsabuf_buf"], 0)

    // Call WSARecv:
    // rcx=s, rdx=&wsabuf, r8=1, r9=bytes_ptr,
    // [rsp+32]=flags_ptr, [rsp+40]=ov_ptr, [rsp+48]=NULL(completionRoutine)
    _intr_load_x64(ctx, 1, state["tmp_s"])
    // rdx = &WSABUF (rbp - tmp_wsabuf_len)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 5)) // rdx = rbp
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(2, state["tmp_wsabuf_len"]))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(8, 1))      // r8d = 1
    _intr_load_x64(ctx, 9, state["tmp_bytes"])               // r9  = bytes_ptr
    _intr_load_x64(ctx, 10, state["tmp_flags"])
    _emit_mov_mrsp_r64(ctx, 32, 10) // flags_ptr
    _intr_load_x64(ctx, 10, state["tmp_ov"])
    _emit_mov_mrsp_r64(ctx, 40, 10) // overlapped_ptr
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(10, 10))
    _emit_mov_mrsp_r64(ctx, 48, 10) // completionRoutine=NULL

    _emit_call_iat_x64(ctx, "IAT_WSARecv")
    return nil
}

fn _x64_wsa_overlapped_labels(ctx, label_prefix) {
    return {
        "labels": {},
        "fixups": [],
        "ok": _new_label(ctx, label_prefix + "_ok"),
        "pending_ok": _new_label(ctx, label_prefix + "_pending_ok"),
        "done": _new_label(ctx, label_prefix + "_done")
    }
}

fn _x64_wsa_overlapped_emit_initial_result(ctx, lab) {
    var fixups = lab["fixups"]
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", lab["ok"])
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "ne", lab["ok"]) // nonstandard but treat any non -1 as success
    return nil
}

fn _x64_wsa_overlapped_emit_error_path(ctx, lab) {
    var fixups = lab["fixups"]
    _emit_wsa_get_last_error_x64(ctx) // eax = last error
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 997)) // WSA_IO_PENDING
    _emit_jcc_to_label(ctx, fixups, "e", lab["pending_ok"])
    _emit_wsa_last_error_to_neg_errno_common_x64(ctx)
    _emit_jmp_to_label(ctx, fixups, lab["done"])
    return nil
}

fn _x64_wsa_overlapped_emit_success_paths(ctx, lab) {
    var labels = lab["labels"]
    var fixups = lab["fixups"]
    _emit_label(ctx, labels, lab["pending_ok"])
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 0))
    _emit_jmp_to_label(ctx, fixups, lab["done"])

    _emit_label(ctx, labels, lab["ok"])
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 0))
    return nil
}

fn _x64_wsa_overlapped_normalize_result(ctx, label_prefix) {
    // rc == 0 => ok
    // rc == SOCKET_ERROR(-1) => if WSAGetLastError == WSA_IO_PENDING => ok, else map to -errno
    var lab = _x64_wsa_overlapped_labels(ctx, label_prefix)
    _x64_wsa_overlapped_emit_initial_result(ctx, lab)
    _x64_wsa_overlapped_emit_error_path(ctx, lab)
    _x64_wsa_overlapped_emit_success_paths(ctx, lab)
    _emit_label(ctx, lab["labels"], lab["done"])
    _patch_local_fixups(ctx, lab["labels"], lab["fixups"])
    return nil
}

