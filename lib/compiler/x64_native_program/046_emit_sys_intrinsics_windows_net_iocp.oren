        base,
        _intr_tmp_off(ctx, locals, base + 0),
        _intr_tmp_off(ctx, locals, base + 1),
        _intr_tmp_off(ctx, locals, base + 2),
        _intr_tmp_off(ctx, locals, base + 3),
        _intr_tmp_off(ctx, locals, base + 4),
        _intr_tmp_off(ctx, locals, base + 5),
