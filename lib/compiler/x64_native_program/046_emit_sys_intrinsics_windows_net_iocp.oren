    _intr_load_x64(ctx, 1, state["tmp_file"]) // rcx = file_handle
    _intr_load_x64(ctx, 2, state["tmp_ov"])   // rdx = overlapped_ptr (NULL cancels all)
    _emit_call_iat_x64(ctx, "IAT_CancelIoEx")
    return nil
}

fn _x64_cancel_io_ex_emit_result(ctx) {
    // BOOL in eax (0 => failure)
    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "iocp_cancel_ok")
    var l_done = _new_label(ctx, "iocp_cancel_done")

    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)

    _emit_call_iat_x64(ctx, "IAT_GetLastError") // eax = error
    // ERROR_NOT_FOUND(1168): nothing to cancel (treat as success for idempotent cancellation).
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 1168))
    var l_not_found = _new_label(ctx, "iocp_cancel_not_found")
    _emit_jcc_to_label(ctx, fixups, "e", l_not_found)

    _x64_iocp_emit_invalid_param_handle_eio(ctx, labels, fixups, l_done, "iocp_cancel_err")

    _emit_label(ctx, labels, l_not_found)
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 0)) // rax = 0
    _emit_jmp_to_label(ctx, fixups, l_done)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(0, 0)) // rax = 0

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_intrinsic_sys_cancel_io_ex_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: sys_cancel_io_ex expects 2 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_cancel_io_ex does not support spread"); return nil }

    // CancelIoEx(file_handle, overlapped_ptr) -> 0 or -errno
    var state = _x64_cancel_io_ex_state(ctx, locals, args)
    if state == nil { return nil }
    _x64_cancel_io_ex_emit_call(ctx, state)
    _x64_cancel_io_ex_emit_result(ctx)
    _intr_tmp_pop(ctx, state["base"])
    return nil
}
