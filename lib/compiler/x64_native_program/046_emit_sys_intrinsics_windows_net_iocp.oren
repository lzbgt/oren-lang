    _x64_wsa_overlapped_emit_initial_result(ctx, lab)
    _x64_wsa_overlapped_emit_error_path(ctx, lab)
    _x64_wsa_overlapped_emit_success_paths(ctx, lab)
    _emit_label(ctx, lab[0], lab[4])
    _patch_local_fixups(ctx, lab[0], lab[1])
    return nil
}

