    _intr_load_x64(ctx, 1, state["tmp_file"]) // rcx = file_handle
    _intr_load_x64(ctx, 2, state["tmp_port"]) // rdx = existing_port
    _intr_load_x64(ctx, 8, state["tmp_key"])  // r8  = completion_key
    _intr_load_x64(ctx, 9, state["tmp_thr"])  // r9  = concurrent_threads
    _emit_call_iat_x64(ctx, "IAT_CreateIoCompletionPort")
    return nil
}

fn _x64_iocp_create_emit_result(ctx) {
    // rax = HANDLE (0 => failure)
    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "iocp_create_ok")
    var l_done = _new_label(ctx, "iocp_create_done")

    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
