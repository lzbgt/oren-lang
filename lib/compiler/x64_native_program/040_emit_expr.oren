            _patch_local_fixups(ctx, labels, local_fixups)

            bytes_extend(ctx["code"], insn_cqo()) // sign-extend rax into rdx
            bytes_extend(ctx["code"], insn_idiv_r64(1)) // idiv rcx
            return nil
        }

        if op == "<<" || op == ">>" {
            _emit_eval_int_to_rax(ctx, l, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            // Shift counts must be in 0..63. This keeps semantics consistent with AVM and the C backend runtime.
            if r != nil && r["type"] == "Integer" {
                var n2 = intparse.parse_int_lit(r["value"])
                if n2 == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
                if n2 < 0 || n2 >= 64 {
                    _emit_abort_panic_str(ctx, "shift count out of range")
                    return nil
                }
                if op == "<<" { bytes_extend(ctx["code"], insn_shl_r64_imm8(0, n2)) }
                else { bytes_extend(ctx["code"], insn_shr_r64_imm8(0, n2)) }
                return nil
            }
            if r != nil && r["type"] == "Identifier" {
                if _emit_load_var_to_reg_x64(ctx, locals, r["value"], 2) == 0 { return nil }
                bytes_extend(ctx["code"], insn_mov_r64_r64(1, 2)) // rcx = rhs (CL)

                var labels2 = {}
                var local_fixups2 = []
                // if rcx < 0 => abort
                bytes_extend(ctx["code"], insn_cmp_r64_imm32(1, 0))
                var l_nonneg = _new_label(ctx, "sh_nonneg")
                _emit_jcc_to_label(ctx, local_fixups2, "ge", l_nonneg)
                _emit_abort_panic_str(ctx, "shift count out of range")
                _emit_label(ctx, labels2, l_nonneg)
                // if rcx >= 64 => abort
                bytes_extend(ctx["code"], insn_cmp_r64_imm32(1, 64))
                var l_lt64 = _new_label(ctx, "sh_lt64")
                _emit_jcc_to_label(ctx, local_fixups2, "l", l_lt64)
                _emit_abort_panic_str(ctx, "shift count out of range")
                _emit_label(ctx, labels2, l_lt64)
                _patch_local_fixups(ctx, labels2, local_fixups2)

                if op == "<<" { bytes_extend(ctx["code"], insn_shl_r64_cl(0)) }
                else { bytes_extend(ctx["code"], insn_shr_r64_cl(0)) }
                return nil
            }

            // General RHS expression: spill lhs, eval RHS into RAX, move to RCX, restore lhs, shift.
            var tmp_offs = locals["$tmp_shift"]
            if tmp_offs == nil { err(ctx, "x64 native v0: missing temp slot for shift"); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - tmp_offs, 0) // [tmp] = lhs
            _emit_eval_int_to_rax(ctx, r, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0)) // rcx = rhs

            var labels3 = {}
            var local_fixups3 = []
            // if rcx < 0 => abort
            bytes_extend(ctx["code"], insn_cmp_r64_imm32(1, 0))
            var l_nonneg2 = _new_label(ctx, "sh_nonneg")
            _emit_jcc_to_label(ctx, local_fixups3, "ge", l_nonneg2)
            _emit_abort_panic_str(ctx, "shift count out of range")
            _emit_label(ctx, labels3, l_nonneg2)
            // if rcx >= 64 => abort
            bytes_extend(ctx["code"], insn_cmp_r64_imm32(1, 64))
            var l_lt642 = _new_label(ctx, "sh_lt64")
            _emit_jcc_to_label(ctx, local_fixups3, "l", l_lt642)
            _emit_abort_panic_str(ctx, "shift count out of range")
            _emit_label(ctx, labels3, l_lt642)
            _patch_local_fixups(ctx, labels3, local_fixups3)

            _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_offs) // rax = lhs
            if op == "<<" { bytes_extend(ctx["code"], insn_shl_r64_cl(0)) }
            else { bytes_extend(ctx["code"], insn_shr_r64_cl(0)) }
            return nil
        }

        if op == "&" || op == "|" || op == "^" {
            _emit_eval_int_to_rax(ctx, l, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            if r != nil && r["type"] == "Integer" {
                var n3 = intparse.parse_int_lit(r["value"])
                if n3 == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
                if _is_i32(n3) {
                    var imm_u32_3 = n3
                    if n3 < 0 { imm_u32_3 = 4294967296 + n3 }
                    if op == "&" { bytes_extend(ctx["code"], insn_and_r64_imm32(0, imm_u32_3)) }
                    else if op == "|" { bytes_extend(ctx["code"], insn_or_r64_imm32(0, imm_u32_3)) }
                    else { bytes_extend(ctx["code"], insn_xor_r64_imm32(0, imm_u32_3)) }
                } else {
                    bytes_extend(ctx["code"], insn_mov_r64_imm64(2, n3)) // rdx = imm64
                    if op == "&" { bytes_extend(ctx["code"], insn_and_r64_r64(0, 2)) }
                    else if op == "|" { bytes_extend(ctx["code"], insn_or_r64_r64(0, 2)) }
                    else { bytes_extend(ctx["code"], insn_xor_r64_r64(0, 2)) }
                }
                return nil
            }
            if r != nil && r["type"] == "Identifier" {
                if _emit_load_var_to_reg_x64(ctx, locals, r["value"], 2) == 0 { return nil }
                if op == "&" { bytes_extend(ctx["code"], insn_and_r64_r64(0, 2)) }
                else if op == "|" { bytes_extend(ctx["code"], insn_or_r64_r64(0, 2)) }
                else { bytes_extend(ctx["code"], insn_xor_r64_r64(0, 2)) }
