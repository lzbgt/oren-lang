            _emit_eval_int_to_rax(ctx, l, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            if r != nil && r["type"] == "Integer" {
                var n3 = intparse.parse_int_lit(r["value"])
                if n3 == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
                if _is_i32(n3) {
                    var imm_u32_3 = n3
                    if n3 < 0 { imm_u32_3 = 4294967296 + n3 }
                    if op == "&" { bytes_extend(ctx["code"], insn_and_r64_imm32(0, imm_u32_3)) }
                    else if op == "|" { bytes_extend(ctx["code"], insn_or_r64_imm32(0, imm_u32_3)) }
                    else { bytes_extend(ctx["code"], insn_xor_r64_imm32(0, imm_u32_3)) }
