fn _emit_abort_exitcode(ctx, exit_code) {
    // Emit a hard abort with a deterministic process exit code.
    // Used for invalid arithmetic cases (div0, shift out of range) to avoid host SIGFPE/UB.
    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" {
        // ExitProcess(exit_code)
        bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, exit_code)) // mov ecx, imm32
        var mov_iat_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0)) // patch disp32 to IAT slot
        _x64_add_rip_data32_fixup(ctx, mov_iat_pos + 3, "IAT_ExitProcess")
        bytes_extend(ctx["code"], core.insn_call_rax())
        bytes_extend(ctx["code"], core.insn_ret())
        return nil
    }

    // Linux x86_64: exit_group(exit_code) via syscall (process-wide)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, exit_code)) // mov edi, imm32
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, labi.linux_sys_exit_group()))
    bytes_extend(ctx["code"], core.insn_syscall())
    bytes_extend(ctx["code"], core.insn_ret())
    return nil
}

fn _emit_abort_panic_str(ctx, msg) {
    // Emit a deterministic abort via `oren_panic(msg)` so failures produce the Tier‑1
    // diagnostic contract (OREN_DIAG + best-effort stack trace) instead of a silent exit.
    // - msg must be a compile-time string literal (this helper stores it in the appended data blob)
    // - aborts with exit code 1 (the `oren_panic` contract)
    if msg == nil { msg = "" }
    var off = _data_add_cstr0(ctx, msg)
    // Offsets can legitimately be 0; do not treat 0 as failure under the native runtime.
    var lea_pos = bytes_len(ctx["code"])
    // Call the shared panic helper instead of inlining a full panic+trace sequence
    // at every compiler-generated panic site (keeps x64 binaries smaller).
    var platform = ctx["platform"]
    var arg_reg = 7 // SysV: RDI
    if platform != nil && platform["os"] == "windows" { arg_reg = 1 } // Win64: RCX
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(arg_reg, 0)) // arg = &msg
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": off})
    _emit_panic_helper_mark_needed_x64(ctx)
    _emit_call_rel32_named_x64(ctx, _x64_panic_helper_name())
    bytes_extend(ctx["code"], core.insn_ret())
    return nil
}

fn _x64_err_invalid_int_lit(ctx, lit) {
    // Error-only helper: keep output bounded (avoid dumping long strings/logs).
    var extra = ""
    if lit != nil && oren_is_string(lit) == true {
        var bs = ""
        var i = 0
        while i < 16 {
            var b = ptr_get_byte(lit + i) & 255
            if i != 0 { bs = bs + "," }
            bs = bs + oren_int_to_string(b)
            if b == 0 { break }
            i = i + 1
        }
        extra = " lit_ptr=" + oren_int_to_string(lit) + " lit_bytes=" + bs
    } else {
        extra = " lit_tag=" + oren_int_to_string(oren_type_tag(lit))
    }
    err(ctx, "x64 native v0: invalid integer literal" + extra)
    return nil
}

fn _emit_malloc_chunk_max_64k_x64(ctx, labels, local_fixups, label_name) {
    // Input: r11 = aligned size. Output: r10 = max(r11, 65536).
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 65536))
    var l_chunk_ok = _new_label(ctx, label_name)
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_chunk_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 65536))
    _emit_label(ctx, labels, l_chunk_ok)
    return nil
}

fn _emit_malloc_heap_commit_from_rax_x64(ctx, tmp0, labels, local_fixups, l_done, chunk_label) {
    // Reload aligned size after slow allocation clobbers, recompute chunk, then seed bump regs.
    _emit_mov_r64_mrbp(ctx, 11, 0 - tmp0)
    _emit_malloc_chunk_max_64k_x64(ctx, labels, local_fixups, chunk_label)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(15, 0))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(15, 11))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(14, 0))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(14, 10))
    _emit_jmp_to_label(ctx, local_fixups, l_done)
    return nil
}

fn _emit_malloc_windows_virtualalloc_args_x64(ctx) {
    // VirtualAlloc(0, chunk, MEM_COMMIT|MEM_RESERVE=0x3000, PAGE_READWRITE=0x04)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 0)) // ecx = 0
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 10))  // rdx = chunk
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(8, 12288)) // r8d = 0x3000
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(9, 4))     // r9d = 4
    return nil
}

fn _emit_malloc_windows_virtualalloc_call_x64(ctx) {
    var mov_iat_va = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat_va + 3, "IAT_VirtualAlloc")
    bytes_extend(ctx["code"], core.insn_call_rax())
    return nil
}

fn _emit_malloc_windows_alloc_guard_x64(ctx, labels, local_fixups) {
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_alloc_ok = _new_label(ctx, "malloc_alloc_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_alloc_ok)
    _emit_abort_exitcode(ctx, 200)
    _emit_label(ctx, labels, l_alloc_ok)
    return nil
}

fn _emit_malloc_slow_windows_x64(ctx, tmp0, labels, local_fixups, l_done) {
    _emit_malloc_windows_virtualalloc_args_x64(ctx)
    _emit_malloc_windows_virtualalloc_call_x64(ctx)
    _emit_malloc_windows_alloc_guard_x64(ctx, labels, local_fixups)
    _emit_malloc_heap_commit_from_rax_x64(ctx, tmp0, labels, local_fixups, l_done, "malloc_chunk_ok3")
    return nil
}

fn _emit_malloc_slow_linux_x64(ctx, tmp0, labels, local_fixups, l_done) {
    // Linux mmap syscall: mmap(0, chunk, PROT=3, MAP_PRIVATE|MAP_ANON=0x22, -1, 0)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 9)) // eax = SYS_mmap
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, 0)) // edi = 0 (addr)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(6, 10))  // rsi = chunk
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, 3)) // edx = PROT_READ|PROT_WRITE
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(10, 34)) // r10d = MAP_PRIVATE|MAP_ANON
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(8, -1)) // r8 = -1 (fd)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(9, 0))  // r9d = 0 (offset)
    bytes_extend(ctx["code"], core.insn_syscall())

    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_mmap_ok = _new_label(ctx, "malloc_mmap_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_mmap_ok)
    _emit_abort_exitcode(ctx, 200)
    _emit_label(ctx, labels, l_mmap_ok)
    _emit_malloc_heap_commit_from_rax_x64(ctx, tmp0, labels, local_fixups, l_done, "malloc_chunk_ok2")
    return nil
}

fn _emit_malloc_fast_path_x64(ctx, labels, local_fixups, l_fast, l_done) {
    _emit_label(ctx, labels, l_fast)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 15)) // return old heap_ptr
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(15, 10)) // heap_ptr = candidate_end
    _emit_jmp_to_label(ctx, local_fixups, l_done)
    return nil
}

fn _emit_malloc_ret0_path_x64(ctx, labels, local_fixups, l_ret0, l_done) {
    _emit_label(ctx, labels, l_ret0)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, local_fixups, l_done)
    return nil
}

fn _x64_malloc_tmp0_slot(ctx, locals) {
    if locals == nil { err(ctx, "x64 native v0: malloc intrinsic requires locals context"); return nil }
    var tmp0 = locals["$tmp0"]
    if oren_type_tag(tmp0) != 1 { tmp0 = 0 }
    if tmp0 <= 0 { err(ctx, "x64 native v0: missing $tmp0 slot for malloc"); return nil }
    return tmp0
}

fn _x64_malloc_labels(ctx) {
    return {
        "fixups": [],
        "ret0": _new_label(ctx, "malloc_ret0"),
        "fast": _new_label(ctx, "malloc_fast"),
        "done": _new_label(ctx, "malloc_done")
    }
}

fn _x64_malloc_emit_size_prepare(ctx, tmp0, state) {
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, state["fixups"], "le", state["ret0"])

    // Align up to 16: (size + 15) & ~15.
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(0, 15))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(0, 4294967280)) // 0xFFFFFFF0 (-16)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 0)) // r11 = aligned size
    _emit_mov_mrbp_r64(ctx, 0 - tmp0, 0)
    return nil
}

fn _x64_malloc_emit_reuse_probe(ctx, locals, tmp0, reuse_mode, state) {
    if reuse_mode != 1 { return nil }
    var a0m_enc = abi.int_arg_reg(ctx["abi"], 0)
    if oren_type_tag(a0m_enc) == 0 { err(ctx, "x64 native v0: missing ABI arg reg for native_try_reuse"); return nil }
    var a0m = a0m_enc - 1
    _emit_mov_r64_mrbp(ctx, a0m, 0 - tmp0)
    _emit_call_rel32_named_x64(ctx, "native_try_reuse")
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, state["fixups"], "ne", state["done"])
    return nil
}

fn _x64_malloc_emit_heap_probe(ctx, state) {
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 15)) // r10 = heap_ptr
    bytes_extend(ctx["code"], core.insn_add_r64_r64(10, 11)) // r10 = candidate_end
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(10, 14))
    _emit_jcc_to_label(ctx, state["fixups"], "le", state["fast"])
    return nil
}

fn _x64_malloc_emit_slow_path(ctx, platform, tmp0, labels, state) {
    _emit_malloc_chunk_max_64k_x64(ctx, labels, state["fixups"], "malloc_chunk_ok")
    if platform != nil && platform["os"] == "windows" {
        _emit_malloc_slow_windows_x64(ctx, tmp0, labels, state["fixups"], state["done"])
    } else {
        _emit_malloc_slow_linux_x64(ctx, tmp0, labels, state["fixups"], state["done"])
    }
    return nil
}

fn _emit_malloc_size_in_rax(ctx, locals, reuse_mode) {
    // malloc(size) / malloc_raw(size) intrinsic core.
    // Input: RAX=requested size. Output: RAX=allocated pointer or 0 on size<=0.
    var platform = ctx["platform"]
    var tmp0 = _x64_malloc_tmp0_slot(ctx, locals)
    if tmp0 == nil { return nil }
    var labels = {}
    var state = _x64_malloc_labels(ctx)
    _x64_malloc_emit_size_prepare(ctx, tmp0, state)
    _x64_malloc_emit_reuse_probe(ctx, locals, tmp0, reuse_mode, state)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _x64_malloc_emit_heap_probe(ctx, state)
    _x64_malloc_emit_slow_path(ctx, platform, tmp0, labels, state)
    _emit_malloc_fast_path_x64(ctx, labels, state["fixups"], state["fast"], state["done"])
    _emit_malloc_ret0_path_x64(ctx, labels, state["fixups"], state["ret0"], state["done"])
    _emit_label(ctx, labels, state["done"])
    _patch_local_fixups(ctx, labels, state["fixups"])
    return nil
}

// Tier‑1 convergence note:
// x64 no longer carries bespoke list/map intrinsics in the compiler; container ops are
// implemented by the injected native runtime (shared with arm64) to keep one semantics set.

fn _x64_rt_name_ends_with_g_storage(k) {
    if k == nil { return false }
    var klen = oren_string_len(k)
    if klen < 9 { return false }
    var off = klen - 9
    return (oren_string_byte_at_unchecked(k, off) & 255) == 103 &&
        (oren_string_byte_at_unchecked(k, off + 1) & 255) == 95 &&
        (oren_string_byte_at_unchecked(k, off + 2) & 255) == 115 &&
        (oren_string_byte_at_unchecked(k, off + 3) & 255) == 116 &&
        (oren_string_byte_at_unchecked(k, off + 4) & 255) == 111 &&
        (oren_string_byte_at_unchecked(k, off + 5) & 255) == 114 &&
        (oren_string_byte_at_unchecked(k, off + 6) & 255) == 97 &&
        (oren_string_byte_at_unchecked(k, off + 7) & 255) == 103 &&
        (oren_string_byte_at_unchecked(k, off + 8) & 255) == 101
}

fn _x64_rt_resolve_g_storage_name(ctx) {
    // Resolve the runtime's `g_storage` global symbol name once and cache it in ctx.
    // We use a suffix match because module linking prefixes global names.
    if ctx == nil { return nil }
    if ctx["rt_g_storage_name"] != nil { return ctx["rt_g_storage_name"] }
    if ctx["globals"] == nil { return nil }
    var match = nil
    var match_count = 0
    for k in ctx["globals"] {
        if _x64_rt_name_ends_with_g_storage(k) {
            match = k
            match_count = match_count + 1
            if match_count > 1 { break }
        }
    }
    if match_count == 1 {
        ctx["rt_g_storage_name"] = match
        return match
    }
    return nil
}

fn _x64_emit_load_g_storage_ptr_to_reg(ctx, dst_reg) {
    // dst_reg = g_storage (pointer to runtime globals storage).
    var gname = _x64_rt_resolve_g_storage_name(ctx)
    if gname == nil || ctx == nil || ctx["globals"] == nil || ctx["globals"][gname] == nil {
        err(ctx, "x64 native v0: missing runtime global g_storage")
        return nil
    }
    var goff = ctx["globals"][gname] - 1
    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(dst_reg, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": goff})
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(dst_reg, dst_reg))
    return nil
}

fn _x64_emit_load_value_singleton(ctx, dst_reg, off) {
    // Load a runtime value singleton (nil/false/true) into dst_reg.
    // Uses R10 as a scratch base register.
    _x64_emit_load_g_storage_ptr_to_reg(ctx, 10)
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(dst_reg, 10, off))
    return nil
}

fn _x64_emit_jcc_if_rax_falsey(ctx, local_fixups, falsey_label) {
    // Branch to `falsey_label` if RAX is falsey by language truthiness rules:
    // - `nil` is falsey
    // - `false` is falsey
    // - everything else is truthy (including int 0)
    //
    // Uses R10/R11 as scratch.
    _x64_emit_load_g_storage_ptr_to_reg(ctx, 10)
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(11, 10, 368)) // r11 = nil
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 11))
    _emit_jcc_to_label(ctx, local_fixups, "e", falsey_label)
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(11, 10, 376)) // r11 = false
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 11))
    _emit_jcc_to_label(ctx, local_fixups, "e", falsey_label)
    return nil
}

