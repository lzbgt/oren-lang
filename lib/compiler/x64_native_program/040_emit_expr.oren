                else { bytes_extend(ctx["code"], insn_imul_r64_imm32(0, imm_u32_2)) }
            } else {
                bytes_extend(ctx["code"], insn_mov_r64_imm64(2, n2)) // rdx = imm64
                if op == "+" { bytes_extend(ctx["code"], insn_add_r64_r64(0, 2)) }
                else if op == "-" { bytes_extend(ctx["code"], insn_sub_r64_r64(0, 2)) }
                else { bytes_extend(ctx["code"], insn_imul_r64_r64(0, 2)) }
            }
            return nil
        }
        if r != nil && r["type"] == "Identifier" {
            var off2 = locals[r["value"]]
            if off2 == nil { err(ctx, "x64 native v0: unknown var " + r["value"]); return nil }
            _emit_mov_r64_mrbp(ctx, 2, 0 - off2) // rdx = rhs
            if op == "+" { bytes_extend(ctx["code"], insn_add_r64_r64(0, 2)) }
            else if op == "-" { bytes_extend(ctx["code"], insn_sub_r64_r64(0, 2)) }
            else { bytes_extend(ctx["code"], insn_imul_r64_r64(0, 2)) }
            return nil
        }
        // General RHS expression (including index, nested calls, etc): spill lhs, eval RHS, combine.
        var tmp_off4 = locals["$tmp0"]
        if tmp_off4 == nil { err(ctx, "x64 native v0: missing temp slot for rhs"); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - tmp_off4, 0) // [tmp] = lhs
        _emit_eval_int_to_rax(ctx, r, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        bytes_extend(ctx["code"], insn_mov_r64_r64(2, 0)) // rdx = rhs
        _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_off4) // rax = lhs
        if op == "+" { bytes_extend(ctx["code"], insn_add_r64_r64(0, 2)) }
        else if op == "-" { bytes_extend(ctx["code"], insn_sub_r64_r64(0, 2)) }
        else { bytes_extend(ctx["code"], insn_imul_r64_r64(0, 2)) }
