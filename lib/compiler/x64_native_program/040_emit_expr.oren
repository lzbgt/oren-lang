fn _emit_abort_exitcode(ctx, exit_code) {
    // Emit a hard abort with a deterministic process exit code.
    // Used for invalid arithmetic cases (div0, shift out of range) to avoid host SIGFPE/UB.
    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" {
        // ExitProcess(exit_code)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(1, exit_code)) // mov ecx, imm32
        var mov_iat_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0)) // patch disp32 to IAT slot
        _x64_add_rip_data32_fixup(ctx, mov_iat_pos + 3, "IAT_ExitProcess")
        bytes_extend(ctx["code"], insn_call_rax())
        bytes_extend(ctx["code"], insn_ret())
        return nil
    }

    // Linux x86_64: exit_group(exit_code) via syscall (process-wide)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, exit_code)) // mov edi, imm32
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, labi.linux_sys_exit_group()))
    bytes_extend(ctx["code"], insn_syscall())
    bytes_extend(ctx["code"], insn_ret())
    return nil
}

fn _emit_abort_panic_str(ctx, msg) {
    // Emit a deterministic abort via `oren_panic(msg)` so failures produce the Tier‑1
    // diagnostic contract (OREN_DIAG + best-effort stack trace) instead of a silent exit.
    // - msg must be a compile-time string literal (this helper stores it in the appended data blob)
    // - aborts with exit code 1 (the `oren_panic` contract)
    if msg == nil { msg = "" }
    var off = _data_add_cstr0(ctx, msg)
    // Offsets can legitimately be 0; do not treat 0 as failure under the native runtime.
    var lea_pos = bytes_len(ctx["code"])
    // Call the shared panic helper instead of inlining a full panic+trace sequence
    // at every compiler-generated panic site (keeps x64 binaries smaller).
    var platform = ctx["platform"]
    var arg_reg = 7 // SysV: RDI
    if platform != nil && platform["os"] == "windows" { arg_reg = 1 } // Win64: RCX
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(arg_reg, 0)) // arg = &msg
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": off})
    _emit_panic_helper_mark_needed_x64(ctx)
    _emit_call_rel32_named_x64(ctx, _x64_panic_helper_name())
    bytes_extend(ctx["code"], insn_ret())
    return nil
}

fn _x64_err_invalid_int_lit(ctx, lit) {
    // Error-only helper: keep output bounded (avoid dumping long strings/logs).
    var extra = ""
    if lit != nil && oren_is_string(lit) == true {
        var bs = ""
        var i = 0
        while i < 16 {
            var b = ptr_get_byte(lit + i) & 255
            if i != 0 { bs = bs + "," }
            bs = bs + oren_int_to_string(b)
            if b == 0 { break }
            i = i + 1
        }
        extra = " lit_ptr=" + oren_int_to_string(lit) + " lit_bytes=" + bs
    } else {
        extra = " lit_tag=" + oren_int_to_string(oren_type_tag(lit))
    }
    err(ctx, "x64 native v0: invalid integer literal" + extra)
    return nil
}

fn _emit_malloc_size_in_rax(ctx, locals, reuse_mode) {
    // malloc(size) / malloc_raw(size) intrinsic core.
    // Input:
    // - RAX: requested size (signed int)
    // Output:
    // - RAX: allocated pointer (0 on size<=0; otherwise non-zero on success)
    // Global state (callee-saved registers, initialized in entry stub):
    // - R15: heap_ptr
    // - R14: heap_limit
    // Clobbers:
    // - R10, R11, RCX (kernel syscall clobbers RCX/R11)
    var platform = ctx["platform"]
    if locals == nil { err(ctx, "x64 native v0: malloc intrinsic requires locals context"); return nil }
    var tmp0 = locals["$tmp0"]
    if oren_type_tag(tmp0) != 1 { tmp0 = 0 }
    if tmp0 <= 0 { err(ctx, "x64 native v0: missing $tmp0 slot for malloc"); return nil }
    var labels = {}
    var local_fixups = []
    var l_ret0 = _new_label(ctx, "malloc_ret0")
    var l_fast = _new_label(ctx, "malloc_fast")
    var l_done = _new_label(ctx, "malloc_done")

    // if size <= 0 => return 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_ret0)

    // Align up to 16: (size + 15) & ~15
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 15))
    bytes_extend(ctx["code"], insn_and_r64_imm32(0, 4294967280)) // 0xFFFFFFF0 (-16)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0)) // r11 = aligned size
    // Spill aligned size so slow paths can recompute after syscall/call clobbers volatile regs.
    _emit_mov_mrbp_r64(ctx, 0 - tmp0, 0)

    // Try reuse (malloc / malloc_k only).
    if reuse_mode == 1 {
        var a0m_enc = abi.int_arg_reg(ctx["abi"], 0)
        if oren_type_tag(a0m_enc) == 0 { err(ctx, "x64 native v0: missing ABI arg reg for native_try_reuse"); return nil }
        var a0m = a0m_enc - 1
        _emit_mov_r64_mrbp(ctx, a0m, 0 - tmp0) // arg0 = aligned size
        _emit_call_rel32_named_x64(ctx, "native_try_reuse")
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_done)
    }

    // candidate_end = heap_ptr + size
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 15)) // r10 = heap_ptr
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 11)) // r10 = end
    // if end <= limit => fast
    bytes_extend(ctx["code"], insn_cmp_r64_r64(10, 14))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_fast)

    // --- Slow path ---
    // chunk = max(size, 65536)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11)) // r10 = chunk candidate (size)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 65536))
    var l_chunk_ok = _new_label(ctx, "malloc_chunk_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_chunk_ok)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 65536)) // r10d = 65536
    _emit_label(ctx, labels, l_chunk_ok)

    if platform != nil && platform["os"] == "windows" {
        // VirtualAlloc(0, chunk, MEM_COMMIT|MEM_RESERVE=0x3000, PAGE_READWRITE=0x04)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 0)) // ecx = 0
        bytes_extend(ctx["code"], insn_mov_r64_r64(2, 10))  // rdx = chunk
        bytes_extend(ctx["code"], insn_mov_r32_imm32(8, 12288)) // r8d = 0x3000
        bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 4))     // r9d = 4

        var mov_iat_va = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
        _x64_add_rip_data32_fixup(ctx, mov_iat_va + 3, "IAT_VirtualAlloc")
        bytes_extend(ctx["code"], insn_call_rax())

        // if rax == 0 => abort
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
        var l_alloc_ok = _new_label(ctx, "malloc_alloc_ok")
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_alloc_ok)
        _emit_abort_exitcode(ctx, 200)
        _emit_label(ctx, labels, l_alloc_ok)

        // heap_ptr = base + size; heap_limit = base + chunk
        // Reload aligned size (volatile regs may have been clobbered by the call).
        _emit_mov_r64_mrbp(ctx, 11, 0 - tmp0) // r11 = size

        // Recompute chunk = max(size, 65536) into r10.
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 65536))
        var l_chunk_ok3 = _new_label(ctx, "malloc_chunk_ok3")
        _emit_jcc_to_label(ctx, local_fixups, "ge", l_chunk_ok3)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 65536))
        _emit_label(ctx, labels, l_chunk_ok3)

        bytes_extend(ctx["code"], insn_mov_r64_r64(15, 0))
        bytes_extend(ctx["code"], insn_add_r64_r64(15, 11))
        bytes_extend(ctx["code"], insn_mov_r64_r64(14, 0))
        bytes_extend(ctx["code"], insn_add_r64_r64(14, 10))
        _emit_jmp_to_label(ctx, local_fixups, l_done)
    } else {
        // Linux mmap syscall: mmap(0, chunk, PROT=3, MAP_PRIVATE|MAP_ANON=0x22, -1, 0)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 9)) // eax = SYS_mmap
        bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 0)) // edi = 0 (addr)
        bytes_extend(ctx["code"], insn_mov_r64_r64(6, 10))  // rsi = chunk
        bytes_extend(ctx["code"], insn_mov_r32_imm32(2, 3)) // edx = PROT_READ|PROT_WRITE
        bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 34)) // r10d = MAP_PRIVATE|MAP_ANON (0x22)
        bytes_extend(ctx["code"], insn_mov_r64_imm64(8, -1)) // r8 = -1 (fd)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 0))  // r9d = 0 (offset)
        bytes_extend(ctx["code"], insn_syscall())

        // if rax < 0 => abort
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
        var l_mmap_ok = _new_label(ctx, "malloc_mmap_ok")
        _emit_jcc_to_label(ctx, local_fixups, "ge", l_mmap_ok)
        _emit_abort_exitcode(ctx, 200)
        _emit_label(ctx, labels, l_mmap_ok)

        // Reload aligned size and recompute chunk into r10 (syscall clobbers rcx/r11).
        _emit_mov_r64_mrbp(ctx, 11, 0 - tmp0) // r11 = size
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 65536))
        var l_chunk_ok2 = _new_label(ctx, "malloc_chunk_ok2")
        _emit_jcc_to_label(ctx, local_fixups, "ge", l_chunk_ok2)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 65536))
        _emit_label(ctx, labels, l_chunk_ok2)

        // heap_ptr = base + size; heap_limit = base + chunk
        bytes_extend(ctx["code"], insn_mov_r64_r64(15, 0))
        bytes_extend(ctx["code"], insn_add_r64_r64(15, 11))
        bytes_extend(ctx["code"], insn_mov_r64_r64(14, 0))
        bytes_extend(ctx["code"], insn_add_r64_r64(14, 10))
        _emit_jmp_to_label(ctx, local_fixups, l_done)
    }

    // --- Fast path ---
    _emit_label(ctx, labels, l_fast)
    // return old heap_ptr; heap_ptr = candidate_end
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 15))
    bytes_extend(ctx["code"], insn_mov_r64_r64(15, 10))
    _emit_jmp_to_label(ctx, local_fixups, l_done)

        _emit_label(ctx, labels, l_ret0)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

// Tier‑1 convergence note:
// x64 no longer carries bespoke list/map intrinsics in the compiler; container ops are
// implemented by the injected native runtime (shared with arm64) to keep one semantics set.

fn _x64_rt_resolve_g_storage_name(ctx) {
    // Resolve the runtime's `g_storage` global symbol name once and cache it in ctx.
    // We use a suffix match because module linking prefixes global names.
    if ctx == nil { return nil }
    if ctx["rt_g_storage_name"] != nil { return ctx["rt_g_storage_name"] }
    if ctx["globals"] == nil { return nil }
    var match = nil
    var match_count = 0
    for k in ctx["globals"] {
        // ends_with(k, "g_storage")
        var klen = oren_string_len(k)
        var suf = "g_storage"
        var slen = oren_string_len(suf)
        if klen >= slen {
            var ok = true
            var j = 0
            while j < slen {
                if oren_string_char_at(k, klen - slen + j) != oren_string_char_at(suf, j) { ok = false; break }
                j = j + 1
            }
            if ok {
                match = k
                match_count = match_count + 1
                if match_count > 1 { break }
            }
        }
    }
    if match_count == 1 {
        ctx["rt_g_storage_name"] = match
        return match
    }
    return nil
}

fn _x64_emit_load_g_storage_ptr_to_reg(ctx, dst_reg) {
    // dst_reg = g_storage (pointer to runtime globals storage).
    var gname = _x64_rt_resolve_g_storage_name(ctx)
    if gname == nil || ctx == nil || ctx["globals"] == nil || ctx["globals"][gname] == nil {
        err(ctx, "x64 native v0: missing runtime global g_storage")
        return nil
    }
    var goff = ctx["globals"][gname] - 1
    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(dst_reg, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": goff})
    bytes_extend(ctx["code"], insn_mov_r64_mr64(dst_reg, dst_reg))
    return nil
}

fn _x64_emit_load_value_singleton(ctx, dst_reg, off) {
    // Load a runtime value singleton (nil/false/true) into dst_reg.
    // Uses R10 as a scratch base register.
    _x64_emit_load_g_storage_ptr_to_reg(ctx, 10)
    bytes_extend(ctx["code"], insn_mov_r64_mr64_disp(dst_reg, 10, off))
    return nil
}

fn _x64_emit_jcc_if_rax_falsey(ctx, local_fixups, falsey_label) {
    // Branch to `falsey_label` if RAX is falsey by language truthiness rules:
    // - `nil` is falsey
    // - `false` is falsey
    // - everything else is truthy (including int 0)
    //
    // Uses R10/R11 as scratch.
    _x64_emit_load_g_storage_ptr_to_reg(ctx, 10)
    bytes_extend(ctx["code"], insn_mov_r64_mr64_disp(11, 10, 368)) // r11 = nil
    bytes_extend(ctx["code"], insn_cmp_r64_r64(0, 11))
    _emit_jcc_to_label(ctx, local_fixups, "e", falsey_label)
    bytes_extend(ctx["code"], insn_mov_r64_mr64_disp(11, 10, 376)) // r11 = false
    bytes_extend(ctx["code"], insn_cmp_r64_r64(0, 11))
    _emit_jcc_to_label(ctx, local_fixups, "e", falsey_label)
    return nil
}

fn _emit_eval_int_to_rax(ctx, expr, locals) {
    // Evaluate a tiny integer expression into RAX (64-bit register).
    // Values are stored/propagated through 64-bit registers and stack slots.
    // Supports:
    // - Integer
    // - Identifier (locals/params; or a named function as a first-class function pointer)
    // - Infix (+/-) with subexpressions from the above set
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Integer" {
        var n = intparse.parse_int_lit(expr["value"])
        if oren_is_err(n) { _x64_err_invalid_int_lit(ctx, expr["value"]); return nil }
        if _is_i32(n) {
            // mov eax, imm32 then sign-extend to rax (cdqe)
            var imm_u32 = n
            if n < 0 { imm_u32 = 4294967296 + n }
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, imm_u32))
            bytes_extend(ctx["code"], insn_cdqe())
        } else {
            // movabs rax, imm64 (encoded as u64 bits)
            bytes_extend(ctx["code"], insn_mov_r64_imm64(0, n))
        }
        return nil
    }
    if t == "Float" {
        // Float literal lowering:
        // - parse literal string to raw IEEE-754 binary64 bits at compile time
        // - load bits into RAX
        var bits = oren_string_to_float_bits(expr["value"])
        bytes_extend(ctx["code"], insn_mov_r64_imm64(0, bits))
        return nil
    }
    if t == "Boolean" {
        // Native backend: bool values are represented by runtime singletons stored in globals storage.
        //
        // This preserves:
        // - type-strict equality (`0 != false`)
        // - truthiness rules (only `nil` and `false` are falsey; `0` is truthy)
        //
        // Load:
        //   rax = g_storage
        //   rax = *(u64*)(rax + OFF_VALUE_TRUE/FALSE)
        var gname = nil
        if ctx != nil && ctx["rt_g_storage_name"] != nil { gname = ctx["rt_g_storage_name"] }
        if gname == nil {
            var match = nil
            var match_count = 0
            if ctx != nil && ctx["globals"] != nil {
                for k in ctx["globals"] {
                    // ends_with(k, "g_storage")
                    var klen = oren_string_len(k)
                    var suf = "g_storage"
                    var slen = oren_string_len(suf)
                    if klen >= slen {
                        var ok = true
                        var j = 0
                        while j < slen {
                            if oren_string_char_at(k, klen - slen + j) != oren_string_char_at(suf, j) { ok = false; break }
                            j = j + 1
                        }
                        if ok {
                            match = k
                            match_count = match_count + 1
                            if match_count > 1 { break }
                        }
                    }
                }
            }
            if match_count == 1 {
                gname = match
                if ctx != nil { ctx["rt_g_storage_name"] = match }
            }
        }
        if gname == nil || ctx == nil || ctx["globals"] == nil || ctx["globals"][gname] == nil {
            err(ctx, "x64 native v0: missing runtime global g_storage (needed for bool singletons)")
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
            bytes_extend(ctx["code"], insn_cdqe())
            return nil
        }
        var goff = ctx["globals"][gname] - 1
        // r10 = &global_slot ; rax = *(u64*)r10
        var lea_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": goff})
        bytes_extend(ctx["code"], insn_mov_r64_mr64(0, 10))

        var off = 376
        if expr["value"] { off = 384 }
        bytes_extend(ctx["code"], insn_mov_r64_mr64_disp(0, 0, off))
        return nil
    }
    if t == "Nil" {
        // Native backend: `nil` is a runtime singleton stored in globals storage (not raw 0).
        //
        // Load:
        //   rax = g_storage
        //   rax = *(u64*)(rax + OFF_VALUE_NIL)
        var gname2 = nil
        if ctx != nil && ctx["rt_g_storage_name"] != nil { gname2 = ctx["rt_g_storage_name"] }
        if gname2 == nil {
            var match2 = nil
            var match_count2 = 0
            if ctx != nil && ctx["globals"] != nil {
                for k2 in ctx["globals"] {
                    var klen2 = oren_string_len(k2)
                    var suf2 = "g_storage"
                    var slen2 = oren_string_len(suf2)
                    if klen2 >= slen2 {
                        var ok2 = true
                        var j2 = 0
                        while j2 < slen2 {
                            if oren_string_char_at(k2, klen2 - slen2 + j2) != oren_string_char_at(suf2, j2) { ok2 = false; break }
                            j2 = j2 + 1
                        }
                        if ok2 {
                            match2 = k2
                            match_count2 = match_count2 + 1
                            if match_count2 > 1 { break }
                        }
                    }
                }
            }
            if match_count2 == 1 {
                gname2 = match2
                if ctx != nil { ctx["rt_g_storage_name"] = match2 }
            }
        }
        if gname2 == nil || ctx == nil || ctx["globals"] == nil || ctx["globals"][gname2] == nil {
            err(ctx, "x64 native v0: missing runtime global g_storage (needed for nil singleton)")
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
            bytes_extend(ctx["code"], insn_cdqe())
            return nil
        }
        var goff2 = ctx["globals"][gname2] - 1
        var lea_pos2 = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos2 + 3, "data_off": goff2})
        bytes_extend(ctx["code"], insn_mov_r64_mr64(0, 10))
        bytes_extend(ctx["code"], insn_mov_r64_mr64_disp(0, 0, 368))
        return nil
    }
    if t == "String" {
        // Native strings are raw pointers to NUL-terminated bytes.
        // Store literal bytes in the appended data blob and load its address via RIP-relative LEA.
        var s = expr["value"]
        // Rolling robustness (stage2-native):
        // Some runtime/map implementations return `0` for a missing key rather than `nil`.
        // For a String AST node, prefer the token literal when `value` isn't a real string.
        if s == nil || oren_is_string(s) != true {
            var tok = expr["token"]
            if tok != nil {
                var lit = tok["literal"]
                if lit != nil && oren_is_string(lit) == true {
                    s = lit
                }
            }
        }
        if s == nil { s = "" }
        var off = _data_add_cstr0(ctx, s)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        var lea_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(0, 0)) // lea rax, [rip+disp32]
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": off})
        // Tier‑1 convergence (rolling):
        // Embedded string literals are registered once at program startup via
        // `oren_init_static_cstr0_table` (entry stub), so per-use tracking is unnecessary here.
        return nil
    }
		    if t == "Function" {
	        // Lambda literal (anonymous function) in expression position.
	        //
	        // Representation:
	        // - returns a pointer to a runtime function object (kind=6) created by `oren_func(code_ptr, env_ptr)`
	        // - `code_ptr` points to the synthesized wrapper `__oren_lambda_N`
	        // - `env_ptr` is either 0 (no captures) or a list of captured values (capture-by-value)
	        var name = expr["name"]
	        if name != "" { err(ctx, "x64 native v0: function decl not allowed in expression position"); return nil }
	        if ctx == nil || ctx["runtime_injected"] != true {
	            // Lambda literals rely on runtime helpers (list/alloc + callable ABI).
	            err(ctx, "x64 native v0: lambda literals require injected native runtime")
	            return nil
	        }

	        // Ensure lambda has a stable name + capture list.
	        if expr["lambda_name"] == nil {
	            // Fallback: if collection was skipped, synthesize metadata here.
	            expr["lambda_name"] = callable.lambda_gensym(ctx)
	            expr["captures"] = callable.lambda_free_vars(ctx, expr)
	            oren_list_push(ctx["lambda_defs"], {"name": expr["lambda_name"], "fun": expr, "captures": expr["captures"]})
	        }
	        var lname = expr["lambda_name"]
	        var caps = expr["captures"]
	        if caps == nil { caps = [] }

		        // Spill slots: env ptr.
		        var base = _intr_tmp_push(ctx, 1)
		        if oren_type_tag(base) == 0 { return nil }
		        var slot_env = base
		        var tmp_env = _intr_tmp_off(ctx, locals, slot_env)
		        if oren_type_tag(tmp_env) == 0 {
		            _intr_tmp_pop(ctx, base)
