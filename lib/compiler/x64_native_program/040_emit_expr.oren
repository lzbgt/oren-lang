fn _emit_abort_exitcode(ctx, exit_code) {
    // Emit a hard abort with a deterministic process exit code.
    // Used for invalid arithmetic cases (div0, shift out of range) to avoid host SIGFPE/UB.
    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" {
        // ExitProcess(exit_code)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(1, exit_code)) // mov ecx, imm32
        var mov_iat_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0)) // patch disp32 to IAT slot
        oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat_pos + 3, "data_label": "IAT_ExitProcess"})
        bytes_extend(ctx["code"], insn_call_rax())
        bytes_extend(ctx["code"], insn_ret())
        return nil
    }

    // Linux x86_64: exit(exit_code) via syscall
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, exit_code)) // mov edi, imm32
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 60))        // mov eax, SYS_exit
    bytes_extend(ctx["code"], insn_syscall())
    bytes_extend(ctx["code"], insn_ret())
    return nil
}

fn _emit_abort_panic_str(ctx, msg) {
    // Emit a deterministic abort via `oren_panic(msg)` so failures produce the Tier‑1
    // diagnostic contract (OREN_DIAG + best-effort stack trace) instead of a silent exit.
    // - msg must be a compile-time string literal (this helper stores it in the appended data blob)
    // - aborts with exit code 1 (the `oren_panic` contract)
    if msg == nil { msg = "" }
    var off = _data_add_cstr0(ctx, msg)
    if off == nil {
        // If we can't even store the message, fall back to silent deterministic abort.
        _emit_abort_exitcode(ctx, 1)
        return nil
    }
    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(0, 0)) // rax = &msg
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": off})
    _emit_panic_with_msg_ptr(ctx, 0)
    return nil
}

fn _emit_malloc_size_in_rax(ctx, locals) {
    // malloc(size) / malloc_raw(size) intrinsic core.
    // Input:
    // - RAX: requested size (signed int)
    // Output:
    // - RAX: allocated pointer (0 on size<=0; otherwise non-zero on success)
    // Global state (callee-saved registers, initialized in entry stub):
    // - R15: heap_ptr
    // - R14: heap_limit
    // Clobbers:
    // - R10, R11, RCX (kernel syscall clobbers RCX/R11)
    var platform = ctx["platform"]
    if locals == nil { err(ctx, "x64 native v0: malloc intrinsic requires locals context"); return nil }
    var tmp0 = locals["$tmp0"]
    if tmp0 == nil { err(ctx, "x64 native v0: missing $tmp0 slot for malloc"); return nil }
    var labels = {}
    var local_fixups = []
    var l_ret0 = _new_label(ctx, "malloc_ret0")
    var l_fast = _new_label(ctx, "malloc_fast")
    var l_done = _new_label(ctx, "malloc_done")

    // if size <= 0 => return 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_ret0)

    // Align up to 16: (size + 15) & ~15
    bytes_extend(ctx["code"], insn_add_r64_imm32(0, 15))
    bytes_extend(ctx["code"], insn_and_r64_imm32(0, 4294967280)) // 0xFFFFFFF0 (-16)
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0)) // r11 = aligned size
    // Spill aligned size so slow paths can recompute after syscall/call clobbers volatile regs.
    _emit_mov_mrbp_r64(ctx, 0 - tmp0, 0)

    // candidate_end = heap_ptr + size
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 15)) // r10 = heap_ptr
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 11)) // r10 = end
    // if end <= limit => fast
    bytes_extend(ctx["code"], insn_cmp_r64_r64(10, 14))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_fast)

    // --- Slow path ---
    // chunk = max(size, 65536)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11)) // r10 = chunk candidate (size)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 65536))
    var l_chunk_ok = _new_label(ctx, "malloc_chunk_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_chunk_ok)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 65536)) // r10d = 65536
    _emit_label(ctx, labels, l_chunk_ok)

    if platform != nil && platform["os"] == "windows" {
        // VirtualAlloc(0, chunk, MEM_COMMIT|MEM_RESERVE=0x3000, PAGE_READWRITE=0x04)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 0)) // ecx = 0
        bytes_extend(ctx["code"], insn_mov_r64_r64(2, 10))  // rdx = chunk
        bytes_extend(ctx["code"], insn_mov_r32_imm32(8, 12288)) // r8d = 0x3000
        bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 4))     // r9d = 4

        var mov_iat_va = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
        oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat_va + 3, "data_label": "IAT_VirtualAlloc"})
        bytes_extend(ctx["code"], insn_call_rax())

        // if rax == 0 => abort
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
        var l_alloc_ok = _new_label(ctx, "malloc_alloc_ok")
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_alloc_ok)
        _emit_abort_exitcode(ctx, 200)
        _emit_label(ctx, labels, l_alloc_ok)

        // heap_ptr = base + size; heap_limit = base + chunk
        // Reload aligned size (volatile regs may have been clobbered by the call).
        _emit_mov_r64_mrbp(ctx, 11, 0 - tmp0) // r11 = size

        // Recompute chunk = max(size, 65536) into r10.
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 65536))
        var l_chunk_ok3 = _new_label(ctx, "malloc_chunk_ok3")
        _emit_jcc_to_label(ctx, local_fixups, "ge", l_chunk_ok3)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 65536))
        _emit_label(ctx, labels, l_chunk_ok3)

        bytes_extend(ctx["code"], insn_mov_r64_r64(15, 0))
        bytes_extend(ctx["code"], insn_add_r64_r64(15, 11))
        bytes_extend(ctx["code"], insn_mov_r64_r64(14, 0))
        bytes_extend(ctx["code"], insn_add_r64_r64(14, 10))
        _emit_jmp_to_label(ctx, local_fixups, l_done)
    } else {
        // Linux mmap syscall: mmap(0, chunk, PROT=3, MAP_PRIVATE|MAP_ANON=0x22, -1, 0)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 9)) // eax = SYS_mmap
        bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 0)) // edi = 0 (addr)
        bytes_extend(ctx["code"], insn_mov_r64_r64(6, 10))  // rsi = chunk
        bytes_extend(ctx["code"], insn_mov_r32_imm32(2, 3)) // edx = PROT_READ|PROT_WRITE
        bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 34)) // r10d = MAP_PRIVATE|MAP_ANON (0x22)
        bytes_extend(ctx["code"], insn_mov_r64_imm64(8, -1)) // r8 = -1 (fd)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 0))  // r9d = 0 (offset)
        bytes_extend(ctx["code"], insn_syscall())

        // if rax < 0 => abort
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
        var l_mmap_ok = _new_label(ctx, "malloc_mmap_ok")
        _emit_jcc_to_label(ctx, local_fixups, "ge", l_mmap_ok)
        _emit_abort_exitcode(ctx, 200)
        _emit_label(ctx, labels, l_mmap_ok)

        // Reload aligned size and recompute chunk into r10 (syscall clobbers rcx/r11).
        _emit_mov_r64_mrbp(ctx, 11, 0 - tmp0) // r11 = size
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 65536))
        var l_chunk_ok2 = _new_label(ctx, "malloc_chunk_ok2")
        _emit_jcc_to_label(ctx, local_fixups, "ge", l_chunk_ok2)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 65536))
        _emit_label(ctx, labels, l_chunk_ok2)

        // heap_ptr = base + size; heap_limit = base + chunk
        bytes_extend(ctx["code"], insn_mov_r64_r64(15, 0))
        bytes_extend(ctx["code"], insn_add_r64_r64(15, 11))
        bytes_extend(ctx["code"], insn_mov_r64_r64(14, 0))
        bytes_extend(ctx["code"], insn_add_r64_r64(14, 10))
        _emit_jmp_to_label(ctx, local_fixups, l_done)
    }

    // --- Fast path ---
    _emit_label(ctx, labels, l_fast)
    // return old heap_ptr; heap_ptr = candidate_end
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 15))
    bytes_extend(ctx["code"], insn_mov_r64_r64(15, 10))
    _emit_jmp_to_label(ctx, local_fixups, l_done)

        _emit_label(ctx, labels, l_ret0)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

// Tier‑1 convergence note:
// x64 no longer carries bespoke list/map intrinsics in the compiler; container ops are
// implemented by the injected native runtime (shared with arm64) to keep one semantics set.

fn _emit_eval_int_to_rax(ctx, expr, locals) {
    // Evaluate a tiny integer expression into RAX (64-bit register).
    // Values are stored/propagated through 64-bit registers and stack slots.
    // Supports:
    // - Integer
    // - Identifier (locals/params; or a named function as a first-class function pointer)
    // - Infix (+/-) with subexpressions from the above set
    if expr == nil { return nil }
    var t = expr["type"]
    if t == "Integer" {
        var n = intparse.parse_int_lit(expr["value"])
        if n == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
        if _is_i32(n) {
            // mov eax, imm32 then sign-extend to rax (cdqe)
            var imm_u32 = n
            if n < 0 { imm_u32 = 4294967296 + n }
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, imm_u32))
            bytes_extend(ctx["code"], insn_cdqe())
        } else {
            // movabs rax, imm64 (encoded as u64 bits)
            bytes_extend(ctx["code"], insn_mov_r64_imm64(0, n))
        }
        return nil
    }
    if t == "Float" {
        // Float literal lowering:
        // - parse literal string to raw IEEE-754 binary64 bits at compile time
        // - load bits into RAX
        var bits = oren_string_to_float_bits(expr["value"])
        bytes_extend(ctx["code"], insn_mov_r64_imm64(0, bits))
        return nil
    }
    if t == "Boolean" {
        // Map boolean literal to i32 0/1, then sign-extend to rax.
        var v = expr["value"]
        var imm = 0
        if v { imm = 1 }
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, imm))
        bytes_extend(ctx["code"], insn_cdqe())
        return nil
    }
    if t == "Nil" {
        // Nil is represented as 0 in the "int as i64 carrier" model.
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
        bytes_extend(ctx["code"], insn_cdqe())
        return nil
    }
    if t == "String" {
        // Native strings are raw pointers to NUL-terminated bytes.
        // Store literal bytes in the appended data blob and load its address via RIP-relative LEA.
        var s = expr["value"]
        var off = _data_add_cstr0(ctx, s)
        if off == nil { err(ctx, "x64 native v0: failed to add string literal data"); return nil }
        var lea_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(0, 0)) // lea rax, [rip+disp32]
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": off})
        // Tier‑1 convergence (rolling): mark embedded string literals as tracked (kind=1)
        // so container ops can safely infer key kinds without heuristics.
        _emit_ensure_tracked_ptr_kind_x64(ctx, locals, 0, 1)
        return nil
    }
    if t == "Function" {
        // Lambda literal (anonymous function) in expression position.
        //
        // Representation:
        // - returns a pointer to a heap-allocated `{code_ptr, env_ptr}` fnobj record
        // - `code_ptr` points to the synthesized wrapper `__oren_lambda_N`
        // - `env_ptr` is either 0 (no captures) or a list of captured values (capture-by-value)
        var name = expr["name"]
        if name != "" { err(ctx, "x64 native v0: function decl not allowed in expression position"); return nil }

        // Ensure lambda has a stable name + capture list.
        if expr["lambda_name"] == nil {
            // Fallback: if collection was skipped, synthesize metadata here.
            expr["lambda_name"] = callable.lambda_gensym(ctx)
            expr["captures"] = callable.lambda_free_vars(ctx, expr)
            oren_list_push(ctx["lambda_defs"], {"name": expr["lambda_name"], "fun": expr, "captures": expr["captures"]})
        }
        var lname = expr["lambda_name"]
        var caps = expr["captures"]
        if caps == nil { caps = [] }

        // Spill slots: fnobj ptr, env ptr, tmp code ptr.
        var base = _intr_tmp_push(ctx, 2)
        if base == nil { return nil }
        var tmp_fnobj = _intr_tmp_off(ctx, locals, base + 0)
        var tmp_env = _intr_tmp_off(ctx, locals, base + 1)
        if tmp_fnobj == nil || tmp_env == nil {
            _intr_tmp_pop(ctx, base)
            err(ctx, "x64 native v0: missing spill slots for lambda literal")
            return nil
        }

        // env_ptr = 0 or a list of captures (capture-by-value, deterministic order)
        if oren_list_len(caps) == 0 {
            bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
            bytes_extend(ctx["code"], insn_cdqe())
            _emit_mov_mrbp_r64(ctx, 0 - tmp_env, 0)
        } else {
            // env = oren_new_list(0)
            _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_new_list"}, "args": [{"type": "Integer", "value": "0"}]}, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
            _emit_mov_mrbp_r64(ctx, 0 - tmp_env, 0)
            var env_name = "$tmp_intr" + oren_int_to_string(base + 1)

            // Push captured values in deterministic order.
            var i = 0
            while i < oren_list_len(caps) {
                var cname = caps[i]
                _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "oren_list_push"}, "args": [{"type": "Identifier", "value": env_name}, {"type": "Identifier", "value": cname}]}, locals)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
                i = i + 1
            }
        }

        // fnobj = malloc_raw(16)
        _emit_eval_int_to_rax(ctx, {"type": "Call", "fn": {"type": "Identifier", "value": "malloc_raw"}, "args": [{"type": "Integer", "value": "16"}]}, locals)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
        _emit_mov_mrbp_r64(ctx, 0 - tmp_fnobj, 0)

        // code_ptr = &__oren_lambda_N
        //
        // lea r11, [rip+disp32]  (patched to function entry)
        var lea_pos = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(11, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_code_lea", "pos": lea_pos + 3, "name": lname})

        // Store code_ptr at [fnobj+0]
        _emit_mov_r64_mrbp(ctx, 10, 0 - tmp_fnobj) // r10 = fnobj
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 11))

        // Store env_ptr at [fnobj+8]
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
        _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_env) // r12 = env ptr
        bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 12))

        // Return fnobj pointer in RAX.
        _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_fnobj)
        _intr_tmp_pop(ctx, base)
        return nil
    }
    if t == "Identifier" {
        var name = expr["value"]
        var off = locals[name]
        if off != nil {
            // Load full 64-bit slot so function pointers round-trip correctly.
            _emit_mov_r64_mrbp(ctx, 0, 0 - off)
            return nil
        }

        // Global var (top-level `var`) => load from the appended data blob.
        //
        // Precedence rule (rolling): locals > globals > named functions-as-values.
        var goff = nil
        if ctx["globals"] != nil { goff = ctx["globals"][name] }
        if goff != nil {
            // r10 = &global_slot ; rax = *(u64*)r10
            var lea_pos0 = bytes_len(ctx["code"])
            bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(10, 0))
            oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos0 + 3, "data_off": goff})
            bytes_extend(ctx["code"], insn_mov_r64_mr64(0, 10))
            return nil
        }

        // Named function used in expression position => treat as a first-class function value.
        // Representation: pointer to a small `{code_ptr, env_ptr}` object in the data blob.
        //
        // Tier‑1 convergence (rolling):
        // - `code_ptr` points to a uniform callable wrapper `__oren_fnwrap_<name>` with signature:
        //     fn __oren_fnwrap_name(__env, __args_list)
        // - `env_ptr` is 0 for now (no closures on x64 native yet).
        //
        // This makes indirect calls backend/arch neutral and matches the shared lowering helpers
        // in `lib/compiler/native_callable.oren`.
        if ctx["func_arity"] != nil && ctx["func_arity"][name] != nil {
            var wname = "__oren_fnwrap_" + name
            var fnobj_off = _data_add_fnobj(ctx, wname)
            if fnobj_off == nil { err(ctx, "x64 native v0: failed to allocate fnobj"); return nil }

            var lea_pos = bytes_len(ctx["code"])
            bytes_extend(ctx["code"], insn_lea_r64_rip_disp32(0, 0))
            // Patch disp32 to point at the fnobj data record.
            oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": fnobj_off})
            return nil
        }

        err(ctx, "x64 native v0: unknown var " + name)
        return nil
    }
    if t == "Member" { return _emit_member_expr_v0(ctx, expr, locals) }
    if t == "Index" { return _emit_index_expr_v0(ctx, expr, locals) }
    if t == "Array" { return _emit_array_literal_expr(ctx, expr, locals) }
    if t == "Hash" { return _emit_hash_literal_expr(ctx, expr, locals) }
    if t == "SpawnExpr" { _emit_spawn_expr_v0(ctx, expr, locals); return nil }
    if t == "Call" {
        var fn_expr = expr["fn"]
        var args = expr["args"]
        if fn_expr == nil { err(ctx, "x64 native v0: call missing target"); return nil }
        // Tier‑1 parity: allow calling a function-valued expression directly.
        // (arm64 supports this; x64 converges via the uniform callable ABI in `044_emit_call_expr.oren`).
        if fn_expr["type"] != "Identifier" {
            _emit_indirect_call_via_fnobj_x64(ctx, locals, fn_expr, args, expr["spread"])
            return nil
        }

        var nm = fn_expr["value"]

        // Tier‑1 convergence: container ops and core stdlib helpers live in the injected native runtime.
        // x64 now requires runtime injection for these ops, matching arm64 and removing x64-only bring-up
        // intrinsics (single semantics set).
        // Typed buffers are also runtime-defined (Tier‑1): any `oren_buf_*` or `*_buf_new` op
        // must route through the injected runtime so arm64/x64 share one semantics+layout.
        var is_buf_runtime = false
        if nm != nil {
            if oren_string_len(nm) >= 8 {
                if oren_string_slice(nm, 0, 8) == "oren_buf_" { is_buf_runtime = true }
            }
            if is_buf_runtime == false && oren_string_len(nm) >= 7 {
                // Suffix match: "_buf_new"
                var nml = oren_string_len(nm)
                if oren_string_slice(nm, nml - 7, nml) == "_buf_new" { is_buf_runtime = true }
            }
            if nm == "oren_u8_buf_wrap_ptr" { is_buf_runtime = true }
        }

        if is_buf_runtime ||
           nm == "oren_new_list" || nm == "oren_list_len" || nm == "oren_list_get" || nm == "oren_list_set" || nm == "oren_list_push" ||
           nm == "oren_new_map" || nm == "oren_map_len" || nm == "oren_map_get" || nm == "oren_map_get_int" || nm == "oren_map_get_str" ||
           nm == "oren_map_set" || nm == "oren_map_set_int" || nm == "oren_map_set_str" ||
           nm == "oren_index_set" || nm == "oren_iter_next" ||
           nm == "oren_string_len" || nm == "oren_string_slice" || nm == "string_concat" || nm == "oren_string_eq" || nm == "oren_int_from_string" {
            if ctx == nil || ctx["runtime_injected"] != true {
                err(ctx, "x64 native v0: call requires injected native runtime: " + nm)
                return nil
            }
            return _emit_generic_call_expr_v0(ctx, expr, locals, nm, args)
        }

        // --- Intrinsics (Tier-1 convergence step) ---
        //
        // Treat core runtime/ABI helpers as compiler intrinsics so x64 can grow toward
        // parity with arm64 native without depending on host libc.
        //
        // Note: these intrinsics operate in the "int as i64 carrier" model where pointers
        // are plain 64-bit values.
        if nm == "oren_trunc_int" {
            _emit_intrinsic_oren_trunc_int_x64(ctx, expr, locals)
            return nil
        }
        if nm == "oren_f32_round" {
            _emit_intrinsic_oren_f32_round_x64(ctx, expr, locals)
            return nil
        }
        if nm == "oren_f32_to_u32_bits" {
            // Intrinsic: convert float64 bits (RAX) to IEEE-754 float32 bits (u32 in EAX, zero-extended).
            if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_f32_to_u32_bits expects 1 argument"); return nil }
            if expr["spread"] != nil { err(ctx, "x64 native v0: oren_f32_to_u32_bits does not support spread"); return nil }
            _emit_eval_int_to_rax(ctx, args[0], locals) // f64 bits in rax
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], insn_movq_xmm_r64(0, 0))      // xmm0 = f64 bits
            bytes_extend(ctx["code"], insn_cvtsd2ss_xmm_xmm(0, 0))  // xmm0 = f32(xmm0)
            bytes_extend(ctx["code"], insn_movd_r32_xmm(0, 0))      // eax = f32 bits (zero-extends to rax)
            return nil
        }
        if nm == "oren_u32_bits_to_f32" {
