fn _emit_eval_call_runtime_or_fast_generic_x64(ctx, expr, locals, nm, nm_len, nm_is_oren, args) {
    // Tier-1 convergence: container ops and core stdlib helpers live in the injected native runtime.
    // x64 now requires runtime injection for these ops, matching arm64 and removing x64-only bring-up
    // intrinsics (single semantics set).
    // Typed buffers are also runtime-defined (Tier-1): any `oren_buf_*` or `*_buf_new` op
    // must route through the injected runtime so arm64/x64 share one semantics+layout.
    if nm_is_oren || nm == "string_concat" {
        var is_buf_runtime = false
        if nm != nil {
            // Detect `oren_buf_*` and `*_buf_new` helpers.
            // Avoid `oren_string_slice` in this hot path (it allocates).
            if nm_len >= 9 {
                if (oren_string_byte_at_unchecked(nm, 0) & 255) == 111 && // o
                   (oren_string_byte_at_unchecked(nm, 1) & 255) == 114 && // r
                   (oren_string_byte_at_unchecked(nm, 2) & 255) == 101 && // e
                   (oren_string_byte_at_unchecked(nm, 3) & 255) == 110 && // n
                   (oren_string_byte_at_unchecked(nm, 4) & 255) == 95 &&  // _
                   (oren_string_byte_at_unchecked(nm, 5) & 255) == 98 &&  // b
                   (oren_string_byte_at_unchecked(nm, 6) & 255) == 117 && // u
                   (oren_string_byte_at_unchecked(nm, 7) & 255) == 102 && // f
                   (oren_string_byte_at_unchecked(nm, 8) & 255) == 95 {   // _
                    is_buf_runtime = true
                }
            }
            if is_buf_runtime == false && nm_len >= 8 {
                // Suffix match: "_buf_new"
                var off = nm_len - 8
                if (oren_string_byte_at_unchecked(nm, off + 0) & 255) == 95 &&  // _
                   (oren_string_byte_at_unchecked(nm, off + 1) & 255) == 98 &&  // b
                   (oren_string_byte_at_unchecked(nm, off + 2) & 255) == 117 && // u
                   (oren_string_byte_at_unchecked(nm, off + 3) & 255) == 102 && // f
                   (oren_string_byte_at_unchecked(nm, off + 4) & 255) == 95 &&  // _
                   (oren_string_byte_at_unchecked(nm, off + 5) & 255) == 110 && // n
                   (oren_string_byte_at_unchecked(nm, off + 6) & 255) == 101 && // e
                   (oren_string_byte_at_unchecked(nm, off + 7) & 255) == 119 {  // w
                    is_buf_runtime = true
                }
            }
            if nm == "oren_u8_buf_wrap_ptr" { is_buf_runtime = true }
        }

        if is_buf_runtime ||
           nm == "oren_new_list" || nm == "oren_list_len" || nm == "oren_list_get" || nm == "oren_list_set" || nm == "oren_list_push" ||
           nm == "oren_new_map" || nm == "oren_map_len" || nm == "oren_map_get" || nm == "oren_map_get_int" || nm == "oren_map_get_str" ||
           nm == "oren_map_set" || nm == "oren_map_set_int" || nm == "oren_map_set_str" ||
           nm == "oren_index_set" || nm == "oren_iter_next" ||
           nm == "oren_string_len" || nm == "oren_string_slice" || nm == "string_concat" || nm == "oren_string_eq" || nm == "oren_int_from_string" {
            if ctx == nil || ctx["runtime_injected"] != true {
                err(ctx, "x64 native v0: call requires injected native runtime: " + nm)
                return 1
            }
            _emit_generic_call_expr_v0(ctx, expr, locals, nm, args)
            return 1
        }
    }

    // Fast-path: most compiler/backend helper calls are plain functions and do not need
    // any intrinsic-special handling. Avoid the long intrinsic chain for these names.
    //
    // Keep this conservative: only short-circuit on well-known internal prefixes.
    if nm_is_oren != true && nm != nil {
        if nm_len >= 5 {
            // "core.insn_" / "push_"
            var b0 = oren_string_byte_at_unchecked(nm, 0) & 255
            var b1 = oren_string_byte_at_unchecked(nm, 1) & 255
            var b2 = oren_string_byte_at_unchecked(nm, 2) & 255
            var b3 = oren_string_byte_at_unchecked(nm, 3) & 255
            var b4 = oren_string_byte_at_unchecked(nm, 4) & 255
            if b0 == 105 && b1 == 110 && b2 == 115 && b3 == 110 && b4 == 95 { // core.insn_
                _emit_generic_call_expr_v0(ctx, expr, locals, nm, args)
                return 1
            }
            if b0 == 112 && b1 == 117 && b2 == 115 && b3 == 104 && b4 == 95 { // push_
                _emit_generic_call_expr_v0(ctx, expr, locals, nm, args)
                return 1
            }
        }
        if nm_len >= 4 {
            // "set_"
            if (oren_string_byte_at_unchecked(nm, 0) & 255) == 115 && // s
               (oren_string_byte_at_unchecked(nm, 1) & 255) == 101 && // e
               (oren_string_byte_at_unchecked(nm, 2) & 255) == 116 && // t
               (oren_string_byte_at_unchecked(nm, 3) & 255) == 95 {   // _
                _emit_generic_call_expr_v0(ctx, expr, locals, nm, args)
                return 1
            }
        }
        if nm_len >= 6 {
            // "bytes_"
            if (oren_string_byte_at_unchecked(nm, 0) & 255) == 98 &&  // b
               (oren_string_byte_at_unchecked(nm, 1) & 255) == 121 && // y
               (oren_string_byte_at_unchecked(nm, 2) & 255) == 116 && // t
               (oren_string_byte_at_unchecked(nm, 3) & 255) == 101 && // e
               (oren_string_byte_at_unchecked(nm, 4) & 255) == 115 && // s
               (oren_string_byte_at_unchecked(nm, 5) & 255) == 95 {   // _
                _emit_generic_call_expr_v0(ctx, expr, locals, nm, args)
                return 1
            }
        }
        if nm_len >= 7 {
            // "native_"
            if (oren_string_byte_at_unchecked(nm, 0) & 255) == 110 && // n
               (oren_string_byte_at_unchecked(nm, 1) & 255) == 97 &&  // a
               (oren_string_byte_at_unchecked(nm, 2) & 255) == 116 && // t
               (oren_string_byte_at_unchecked(nm, 3) & 255) == 105 && // i
               (oren_string_byte_at_unchecked(nm, 4) & 255) == 118 && // v
               (oren_string_byte_at_unchecked(nm, 5) & 255) == 101 && // e
               (oren_string_byte_at_unchecked(nm, 6) & 255) == 95 {   // _
                // NOTE: `native_call1(addr, arg0)` is a compiler intrinsic (runtime ABI helper).
                // Do not short-circuit it into a generic direct call, or the stub body from
                // `lib/runtime_native/000_prelude_sys.oren` will execute and silently return 0.
                //
                // Keep the fast-path for all other `native_*` helpers (they're normal functions).
                var is_native_call1 = false
                if nm_len == 12 {
                    if (oren_string_byte_at_unchecked(nm, 7) & 255) == 99 &&  // c
                       (oren_string_byte_at_unchecked(nm, 8) & 255) == 97 &&  // a
                       (oren_string_byte_at_unchecked(nm, 9) & 255) == 108 && // l
                       (oren_string_byte_at_unchecked(nm, 10) & 255) == 108 && // l
                       (oren_string_byte_at_unchecked(nm, 11) & 255) == 49 {  // 1
                        is_native_call1 = true
                    }
                }
                if is_native_call1 != true {
                    _emit_generic_call_expr_v0(ctx, expr, locals, nm, args)
                    return 1
                }
            }
        }
    }

    return 0
}
