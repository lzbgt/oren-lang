fn _emit_intrinsic_typed_buffers_x64(ctx, nm, expr, locals) {
    if nm == "oren_u8_buf_new" { return _emit_intrinsic_buf_new_x64(ctx, expr, locals, 1, 5, "oren_u8_buf_new") }
    if nm == "oren_i32_buf_new" { return _emit_intrinsic_buf_new_x64(ctx, expr, locals, 4, 1, "oren_i32_buf_new") }
    if nm == "oren_i64_buf_new" { return _emit_intrinsic_buf_new_x64(ctx, expr, locals, 8, 2, "oren_i64_buf_new") }
    if nm == "oren_f32_buf_new" { return _emit_intrinsic_buf_new_x64(ctx, expr, locals, 4, 3, "oren_f32_buf_new") }
    if nm == "oren_f64_buf_new" { return _emit_intrinsic_buf_new_x64(ctx, expr, locals, 8, 4, "oren_f64_buf_new") }

    if nm == "oren_buf_len" { return _emit_intrinsic_buf_len_x64(ctx, expr, locals) }

    if nm == "oren_buf_load_i32" { return _emit_intrinsic_buf_load_i32_x64(ctx, expr, locals) }
    if nm == "oren_buf_store_i32" { return _emit_intrinsic_buf_store_i32_x64(ctx, expr, locals) }
    if nm == "oren_buf_load_u8" { return _emit_intrinsic_buf_load_u8_x64(ctx, expr, locals) }
    if nm == "oren_buf_store_u8" { return _emit_intrinsic_buf_store_u8_x64(ctx, expr, locals) }
    if nm == "oren_buf_load_i64" { return _emit_intrinsic_buf_load_i64_x64(ctx, expr, locals) }
    if nm == "oren_buf_store_i64" { return _emit_intrinsic_buf_store_i64_x64(ctx, expr, locals) }
    if nm == "oren_buf_load_f64" { return _emit_intrinsic_buf_load_f64_x64(ctx, expr, locals) }
    if nm == "oren_buf_store_f64" { return _emit_intrinsic_buf_store_f64_x64(ctx, expr, locals) }
    if nm == "oren_buf_load_f32" { return _emit_intrinsic_buf_load_f32_x64(ctx, expr, locals) }
    if nm == "oren_buf_store_f32" { return _emit_intrinsic_buf_store_f32_x64(ctx, expr, locals) }
    return false
}
