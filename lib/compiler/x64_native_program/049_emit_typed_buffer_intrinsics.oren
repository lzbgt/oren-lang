// x64-native: typed buffer intrinsics (Tier‑1 bring-up).
//
// This provides the minimal typed-buffer surface required by `std/buffer` and HPC layers:
// - constructors: `oren_{u8,i32,i64,f32,f64}_buf_new(len)`
// - accessors: `oren_buf_len`, `oren_buf_load_*`, `oren_buf_store_*`
//
// Semantics are aligned with `lib/runtime_native/typed_buffers/010_alloc_load_store.oren`
// for the core in-bounds path; error reporting is via deterministic `oren_panic` for now
// (x64 native runtime injection is still rolling).

fn _emit_buf_magic_check_x64(ctx, buf_reg, expected_magic, what) {
    // Tier‑1 safety: never read object headers from untracked pointers.
    //
    // Typed buffers are tracked heap objects (kind=7). Validate tracked kind first,
    // then validate the magic word to catch corruption/misuse deterministically.
    _emit_find_tracked_node_x64(ctx, buf_reg, 11) // r11 = node or 0
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    var labels = {}
    var local_fixups = []
    var l_trk_ok = _new_label(ctx, what + "_tracked_ok")
    var l_kind_ok = _new_label(ctx, what + "_kind_ok")

    // node != 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_trk_ok)
    _emit_abort_panic_str(ctx, what + " on non-buf")
    _emit_label(ctx, labels, l_trk_ok)

    // kind = *(node + 16) ; require kind == 7 (BUF)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 10))
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 7))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_kind_ok)
    _emit_abort_panic_str(ctx, what + " on non-buf")
    _emit_label(ctx, labels, l_kind_ok)

    // if *(buf+24) != expected_magic => panic
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, expected_magic))
    var l_ok = _new_label(ctx, what + "_magic_ok")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_ok)
    _emit_abort_panic_str(ctx, what + " on non-buf")
    _emit_label(ctx, labels, l_ok)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_buf_load_data_ptr_x64(ctx, buf_reg, dst_reg) {
    // dst_reg = (buf+40 != 0 ? *(buf+40) : *(buf+16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 40))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(dst_reg, 0))

    var labels = {}
    var local_fixups = []
    var l_done = _new_label(ctx, "buf_data_ptr_done")
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(dst_reg, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_done)

    bytes_extend(ctx["code"], insn_mov_r64_r64(10, buf_reg))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(dst_reg, 0))

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_buf_bounds_check_len_x64(ctx, buf_reg, idx_reg, what) {
    // idx must be in [0, len)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(idx_reg, 0))
    var labels = {}
    var local_fixups = []
    var l_ok0 = _new_label(ctx, what + "_idx_nonneg")
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_ok0)
    _emit_abort_panic_str(ctx, what + ": index out of bounds")
    _emit_label(ctx, labels, l_ok0)

    // r11 = len
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, buf_reg))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(11, 0))
    bytes_extend(ctx["code"], insn_cmp_r64_r64(idx_reg, 11))
    var l_ok1 = _new_label(ctx, what + "_idx_inrange")
    _emit_jcc_to_label(ctx, local_fixups, "l", l_ok1)
    _emit_abort_panic_str(ctx, what + ": index out of bounds")
    _emit_label(ctx, labels, l_ok1)

    _patch_local_fixups(ctx, labels, local_fixups)
    return nil
}

fn _emit_intrinsic_buf_new_x64(ctx, expr, locals, elem_size, tag, what) {
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: " + what + " expects 1 arg"); return true }
    if expr["spread"] != nil { err(ctx, "x64 native v0: " + what + " does not support spread"); return true }

    // Spill len across allocations and tracking.
    var base = _intr_tmp_push(ctx, 2)
    if base == nil { return true }
    var tmp_len = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_hdr = _intr_tmp_off(ctx, locals, base + 1)
    if tmp_len == nil || tmp_hdr == nil { _intr_tmp_pop(ctx, base); return true }

    _emit_eval_int_to_rax(ctx, args[0], locals) // len -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_len, 0)

    // len < 0 => panic
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    var labels = {}
    var local_fixups = []
    var l_len_ok = _new_label(ctx, what + "_len_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_len_ok)
    _emit_abort_panic_str(ctx, what + ": negative length")
    _emit_label(ctx, labels, l_len_ok)
    _patch_local_fixups(ctx, labels, local_fixups)

    // hdr = malloc(56)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 56))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_malloc_size_in_rax(ctx, locals)
    _emit_mov_mrbp_r64(ctx, 0 - tmp_hdr, 0)

    // track header as kind=7 (BUF)
    // regs: ptr in r12, size in r13, kind in r10
    _emit_mov_r64_mrbp(ctx, 12, 0 - tmp_hdr)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(13, 56))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 7))
    _emit_track_alloc_x64(ctx, locals, 12, 13, 10)

    // bytes_len = len * elem_size (in r11)
    _emit_mov_r64_mrbp(ctx, 11, 0 - tmp_len)
    bytes_extend(ctx["code"], insn_imul_r64_imm32(11, elem_size))

    // if bytes_len == 0 => data=0
    var l_has_payload = _new_label(ctx, what + "_has_payload")
    var l_after_payload = _new_label(ctx, what + "_after_payload")
    labels = {}
    local_fixups = []
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_has_payload)

    // data_ptr=0 in r9
    bytes_extend(ctx["code"], insn_mov_r32_imm32(9, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_jmp_to_label(ctx, local_fixups, l_after_payload)

    _emit_label(ctx, labels, l_has_payload)
    // data = malloc(bytes_len)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 11))
    _emit_malloc_size_in_rax(ctx, locals)
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0)) // r9 = data
    // track payload as kind=8 (RAW)
    bytes_extend(ctx["code"], insn_mov_r64_r64(12, 9)) // ptr
    bytes_extend(ctx["code"], insn_mov_r64_r64(13, 11)) // size
    bytes_extend(ctx["code"], insn_mov_r32_imm32(10, 8)) // kind
    _emit_track_alloc_x64(ctx, locals, 12, 13, 10)

    // Recompute bytes_len after track_alloc (clobbers R11).
    _emit_mov_r64_mrbp(ctx, 11, 0 - tmp_len)
    bytes_extend(ctx["code"], insn_imul_r64_imm32(11, elem_size))

    // zero fill: use r10=ptr, r8=remaining, al=0
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 11))
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    var l_z_loop = _new_label(ctx, what + "_zloop")
    var l_z_done = _new_label(ctx, what + "_zdone")
    _emit_label(ctx, labels, l_z_loop)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(8, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_z_done)
    bytes_extend(ctx["code"], insn_mov_mr8_al(10))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 1))
    bytes_extend(ctx["code"], insn_sub_r64_imm32(8, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_z_loop)
    _emit_label(ctx, labels, l_z_done)

    _emit_label(ctx, labels, l_after_payload)
    _patch_local_fixups(ctx, labels, local_fixups)

    // hdr fields:
    // - [0] len
    // - [8] elem_size
    // - [16] data
    // - [24] magic (BUF\0)
    // - [32] tag
    // - [40] data_ptr
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_hdr) // rdx = hdr

    // [hdr+0] = len
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_len)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // [hdr+8] = elem_size
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, elem_size))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // [hdr+16] = data (r9)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // [hdr+24] = buf_magic (4609346)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 4609346))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // [hdr+32] = tag
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, tag))
    bytes_extend(ctx["code"], insn_cdqe())
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 32))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // [hdr+40] = data_ptr (r9)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 40))
    bytes_extend(ctx["code"], insn_mov_mr64_r64(10, 0))

    // result: rax = hdr
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_hdr)
    _intr_tmp_pop(ctx, base)
    return true
}

fn _emit_intrinsic_buf_len_x64(ctx, expr, locals) {
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: oren_buf_len expects 1 arg"); return true }
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return true }
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    var labels = {}
    var local_fixups = []
    var l_nil = _new_label(ctx, "buf_len_nil")
    var l_done = _new_label(ctx, "buf_len_done")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_nil)
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, 0)) // rdx = buf
    _emit_buf_magic_check_x64(ctx, 2, 4609346, "buf_len")
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    _emit_jmp_to_label(ctx, local_fixups, l_done)
    _emit_label(ctx, labels, l_nil)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    return true
}

fn _emit_intrinsic_buf_load_i32_x64(ctx, expr, locals) {
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: oren_buf_load_i32 expects 2 args"); return true }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_buf_load_i32 does not support spread"); return true }
    var base = _intr_tmp_push(ctx, 1)
    if base == nil { return true }
    var tmp_buf = _intr_tmp_off(ctx, locals, base + 0)
    if tmp_buf == nil { _intr_tmp_pop(ctx, base); return true }
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_buf, 0)
    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0)) // rcx = idx
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_buf)          // rdx = buf
    _emit_buf_magic_check_x64(ctx, 2, 4609346, "buf_load_i32")
    _emit_buf_bounds_check_len_x64(ctx, 2, 1, "buf_load_i32")
    _emit_buf_load_data_ptr_x64(ctx, 2, 9)           // r9 = data
    // addr = data + idx*4
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_imul_r64_imm32(10, 4))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 9))
    // eax = *(u32*)addr ; sign-extend
    bytes_extend(ctx["code"], insn_mov_r32_mr32_disp(0, 10, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _intr_tmp_pop(ctx, base)
    return true
}

fn _emit_intrinsic_buf_store_i32_x64(ctx, expr, locals) {
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: oren_buf_store_i32 expects 3 args"); return true }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_buf_store_i32 does not support spread"); return true }
    var base = _intr_tmp_push(ctx, 3)
    if base == nil { return true }
    var tmp_buf = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_idx = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_val = _intr_tmp_off(ctx, locals, base + 2)
    if tmp_buf == nil || tmp_idx == nil || tmp_val == nil { _intr_tmp_pop(ctx, base); return true }

    _emit_eval_int_to_rax(ctx, args[0], locals) // buf
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_buf, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals) // idx
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_idx, 0)

    _emit_eval_int_to_rax(ctx, args[2], locals) // val -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)

    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_buf) // rdx = buf
    _emit_buf_magic_check_x64(ctx, 2, 4609346, "buf_store_i32")
    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_idx) // rcx = idx
    _emit_buf_bounds_check_len_x64(ctx, 2, 1, "buf_store_i32")
    _emit_buf_load_data_ptr_x64(ctx, 2, 9)   // r9 = data

    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_imul_r64_imm32(10, 4))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 9))
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_val) // rax = val
    // store low 32 bits of rax (eax)
    bytes_extend(ctx["code"], insn_mov_mr32_r32_disp(10, 0, 0))
    // return buf
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_buf)
    _intr_tmp_pop(ctx, base)
    return true
}

fn _emit_intrinsic_buf_load_u8_x64(ctx, expr, locals) {
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: oren_buf_load_u8 expects 2 args"); return true }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_buf_load_u8 does not support spread"); return true }
    var base = _intr_tmp_push(ctx, 1)
    if base == nil { return true }
    var tmp_buf = _intr_tmp_off(ctx, locals, base + 0)
    if tmp_buf == nil { _intr_tmp_pop(ctx, base); return true }
    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_buf, 0)
    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0)) // rcx = idx
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_buf)          // rdx = buf
    _emit_buf_magic_check_x64(ctx, 2, 4609346, "buf_load_u8")
    _emit_buf_bounds_check_len_x64(ctx, 2, 1, "buf_load_u8")
    _emit_buf_load_data_ptr_x64(ctx, 2, 9)           // r9 = data
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_movzx_r32_mr8(0, 10))
    _intr_tmp_pop(ctx, base)
    return true
}

fn _emit_intrinsic_buf_store_u8_x64(ctx, expr, locals) {
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: oren_buf_store_u8 expects 3 args"); return true }
    if expr["spread"] != nil { err(ctx, "x64 native v0: oren_buf_store_u8 does not support spread"); return true }
    var base = _intr_tmp_push(ctx, 3)
    if base == nil { return true }
    var tmp_buf = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_idx = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_val = _intr_tmp_off(ctx, locals, base + 2)
    if tmp_buf == nil || tmp_idx == nil || tmp_val == nil { _intr_tmp_pop(ctx, base); return true }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_buf, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_idx, 0)

    _emit_eval_int_to_rax(ctx, args[2], locals) // val
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return true }

    // check 0 <= val <= 255
    var labels = {}
    var local_fixups = []
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    var l_ok0 = _new_label(ctx, "buf_store_u8_ok0")
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_ok0)
    _emit_abort_panic_str(ctx, "buf_store_u8: byte out of range")
    _emit_label(ctx, labels, l_ok0)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 255))
    var l_ok1 = _new_label(ctx, "buf_store_u8_ok1")
    _emit_jcc_to_label(ctx, local_fixups, "le", l_ok1)
    _emit_abort_panic_str(ctx, "buf_store_u8: byte out of range")
    _emit_label(ctx, labels, l_ok1)
    _patch_local_fixups(ctx, labels, local_fixups)

    _emit_mov_mrbp_r64(ctx, 0 - tmp_val, 0)

    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_buf) // rdx = buf
    _emit_buf_magic_check_x64(ctx, 2, 4609346, "buf_store_u8")
    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_idx) // rcx = idx
    _emit_buf_bounds_check_len_x64(ctx, 2, 1, "buf_store_u8")
    _emit_buf_load_data_ptr_x64(ctx, 2, 9)

    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 9))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 1))
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_val) // rax = val (al)
    bytes_extend(ctx["code"], insn_mov_mr8_al(10)) // al already low byte of rax

    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_buf)
    _intr_tmp_pop(ctx, base)
    return true
}

fn _emit_intrinsic_buf_load_i64_x64(ctx, expr, locals) {
    var args = expr["args"]
