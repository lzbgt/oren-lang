// x64 native: `print(<string_expr>)` statement lowering (Tier‑1 parity).
//
// Contract (rolling, current manual/spec):
// - `print(...)` is statement-only and prints a string plus newline.
// - Call sites are expected to pass a string pointer (NUL-terminated bytes).
//
// Prior x64 v0 limitation:
// - only accepted `print("literal")`.
//
// This module adds support for printing an arbitrary string expression (e.g. `"a"+b`),
// without requiring full native runtime injection yet.

fn _x64_eval_print_string_to_r12(ctx, locals, str_expr) {
    _emit_eval_int_to_rax(ctx, str_expr, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 0)) // r12 = s
    return true
}

fn _x64_emit_print_strlen_to_r8(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(8, 12))
    _emit_string_len_from_ptr_x64(ctx, 8, 8)
    return nil
}

fn _x64_print_write_state(ctx, locals) {
    var base = _intr_tmp_push(ctx, 3)
    if oren_type_tag(base) == 0 { return nil }
    var state = {}
    state["base"] = base
    state["slot_fd"] = base
    state["slot_ptr"] = iadd(base, 1)
    state["slot_len"] = iadd(base, 2)
    state["tmp_fd"] = _intr_tmp_off(ctx, locals, state["slot_fd"])
    state["tmp_ptr"] = _intr_tmp_off(ctx, locals, state["slot_ptr"])
    state["tmp_len"] = _intr_tmp_off(ctx, locals, state["slot_len"])
    if oren_type_tag(state["tmp_fd"]) == 0 || oren_type_tag(state["tmp_ptr"]) == 0 || oren_type_tag(state["tmp_len"]) == 0 {
        _intr_tmp_pop(ctx, base)
        return nil
    }
    return state
}

fn _x64_print_sys_write_call_expr(state) {
    return {
        "type": "Call",
        "fn": {"type": "Identifier", "token": nil, "value": "sys_write"},
        "args": [{"type": "IntrTmp", "idx": state["slot_fd"]},
                 {"type": "IntrTmp", "idx": state["slot_ptr"]},
                 {"type": "IntrTmp", "idx": state["slot_len"]}],
    }
}

fn _x64_store_print_write_args(ctx, state, ptr_reg, len_reg) {
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - state["tmp_fd"], 0)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, ptr_reg))
    _emit_mov_mrbp_r64(ctx, 0 - state["tmp_ptr"], 0)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, len_reg))
    _emit_mov_mrbp_r64(ctx, 0 - state["tmp_len"], 0)
    return nil
}

fn _x64_emit_print_sys_write(ctx, locals, call_write) {
    _emit_eval_int_to_rax(ctx, call_write, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    return true
}

fn _x64_emit_print_newline_args(ctx, state) {
    var nl_off = _data_add_cstr0(ctx, "\n")
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - state["tmp_fd"], 0)

    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(0, 0))
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos + 3, "data_off": nl_off})
    _emit_mov_mrbp_r64(ctx, 0 - state["tmp_ptr"], 0)

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_mov_mrbp_r64(ctx, 0 - state["tmp_len"], 0)
    return nil
}

fn _emit_print_stmt_str_x64(ctx, locals, str_expr) {
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: print requires locals"); return nil }

    if _x64_eval_print_string_to_r12(ctx, locals, str_expr) == false { return nil }
    _x64_emit_print_strlen_to_r8(ctx)

    // Reuse the `sys_write` intrinsic to keep Linux/Windows behavior unified.
    var state = _x64_print_write_state(ctx, locals)
    if state == nil { return nil }
    var call_write = _x64_print_sys_write_call_expr(state)
    _x64_store_print_write_args(ctx, state, 12, 8)
    if _x64_emit_print_sys_write(ctx, locals, call_write) == false { _intr_tmp_pop(ctx, state["base"]); return nil }

    _x64_emit_print_newline_args(ctx, state)
    if _x64_emit_print_sys_write(ctx, locals, call_write) == false { _intr_tmp_pop(ctx, state["base"]); return nil }

    _intr_tmp_pop(ctx, state["base"])
    return nil
}
