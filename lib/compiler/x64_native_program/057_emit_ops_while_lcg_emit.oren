fn _x64_fast_lcg_unsigned_step_update_x(ctx) {
    bytes_extend(ctx["code"], core.insn_imul_r64_r64(10, 13))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(10, 14))
    return nil
}

fn _x64_fast_lcg_unsigned_step_mod_x(ctx, use_fastmod, mod_recip, labels, local_fixups) {
    if use_fastmod == true {
        _emit_fastmod_u64_const_x64(ctx, 10, 12, mod_recip, 10, 6, labels, local_fixups, "lcg_mod")
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(2, 2))
        bytes_extend(ctx["code"], core.insn_div_r64(12))
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 2))
    }
    return nil
}

fn _x64_fast_lcg_unsigned_step_mod_modx(ctx, use_fastmod, modx_recip, labels, local_fixups) {
    if use_fastmod == true {
        _emit_fastmod_u64_const_x64(ctx, 10, 15, modx_recip, 6, 6, labels, local_fixups, "lcg_mod_x")
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(2, 2))
        bytes_extend(ctx["code"], core.insn_div_r64(15))
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(6, 2))
    }
    return nil
}

fn _x64_fast_lcg_unsigned_step_accumulate(ctx, labels, local_fixups) {
    bytes_extend(ctx["code"], core.insn_add_r64_r64(11, 6))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(11, 7))
    var l_sum_skip = _new_label(ctx, "lcg_sum_skip")
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(11, 12))
    _emit_jcc_to_label(ctx, local_fixups, "lt", l_sum_skip)
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(11, 12))
    _emit_label(ctx, labels, l_sum_skip)
    return nil
}

fn _x64_fast_lcg_unsigned_step_inc_i_mod(ctx, labels, local_fixups) {
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(7, 1))
    var l_i_mod_ok = _new_label(ctx, "lcg_sum_i_mod_ok")
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(7, 3))
    _emit_jcc_to_label(ctx, local_fixups, "lt", l_i_mod_ok)
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(7, 7))
    _emit_label(ctx, labels, l_i_mod_ok)
    return nil
}

fn _x64_fast_lcg_emit_unsigned_step(ctx, use_fastmod, mod_recip, modx_recip, labels, local_fixups) {
    // Register contract: r10=x, r13=mul, r14=add, r12=mod, r15=mod_x, r3=mod_i, r7=i_mod, r11=sum.
    _x64_fast_lcg_unsigned_step_update_x(ctx)
    _x64_fast_lcg_unsigned_step_mod_x(ctx, use_fastmod, mod_recip, labels, local_fixups)
    _x64_fast_lcg_unsigned_step_mod_modx(ctx, use_fastmod, modx_recip, labels, local_fixups)
    _x64_fast_lcg_unsigned_step_accumulate(ctx, labels, local_fixups)
    _x64_fast_lcg_unsigned_step_inc_i_mod(ctx, labels, local_fixups)
    return nil
}

fn _x64_fast_lcg_labels(ctx) {
    return {
        "slow": _new_label(ctx, "lcg_sum_slow"),
        "cond": _new_label(ctx, "lcg_sum_cond"),
        "cond_mod": _new_label(ctx, "lcg_sum_cond_mod"),
        "end": _new_label(ctx, "lcg_sum_end"),
        "single": _new_label(ctx, "lcg_sum_single"),
        "end_mod": _new_label(ctx, "lcg_sum_end_mod"),
        "done": _new_label(ctx, "lcg_sum_done")
    }
}

fn _x64_fast_lcg_entry_load_mod(ctx, prep) {
    var mod_name = prep[0]
    var mod_const = prep[1]
    var off_mod = prep[15]
    if mod_name != nil {
        _emit_mov_r64_mrbp(ctx, 12, 0 - off_mod)
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(12, mod_const))
    }
    return nil
}

fn _x64_fast_lcg_entry_jump_if_negative(ctx, local_fixups, reg, off, target) {
    _emit_mov_r64_mrbp(ctx, reg, 0 - off)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(reg, 0))
    _emit_jcc_to_label(ctx, local_fixups, "lt", target)
    return nil
}

fn _x64_fast_lcg_entry_emit_state_gates(ctx, prep, target, local_fixups) {
    _x64_fast_lcg_entry_jump_if_negative(ctx, local_fixups, 0, prep[11], target)
    _x64_fast_lcg_entry_jump_if_negative(ctx, local_fixups, 1, prep[12], target)
    _x64_fast_lcg_entry_jump_if_negative(ctx, local_fixups, 2, prep[13], target)
    _x64_fast_lcg_entry_jump_if_negative(ctx, local_fixups, 4, prep[14], target)
    return nil
}

fn _x64_fast_lcg_entry_emit_sum_cap_gate(ctx, prep, target, local_fixups) {
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(9, prep[6]))
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(12, 9))
    _emit_jcc_to_label(ctx, local_fixups, "lt", target)
    return nil
}

fn _x64_fast_lcg_emit_entry_gates(ctx, prep, labels, local_fixups) {
    var l_fast_cond_mod = labels["cond_mod"]

    _x64_fast_lcg_entry_load_mod(ctx, prep)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(12, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", labels["slow"])

    // i/n/x/sum < 0 => full-mod fast loop
    _x64_fast_lcg_entry_emit_state_gates(ctx, prep, l_fast_cond_mod, local_fixups)

    // mod < (mod_x + mod_i) => full-mod fast loop
    _x64_fast_lcg_entry_emit_sum_cap_gate(ctx, prep, l_fast_cond_mod, local_fixups)
    return nil
}

fn _x64_fast_lcg_unsigned_setup_constants(ctx, prep) {
    var mul = prep[2]
    var add = prep[3]
    var mod_x = prep[4]
    var mod_i = prep[5]

    // constants in callee-saved regs (survive runtime calls)
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(13, mul))  // r13 = mul
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(14, add))  // r14 = add
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(15, mod_x)) // r15 = mod_x
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(3, mod_i)) // rbx = mod_i

    // tick (r8) for throttled safepoint
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8))
    return nil
}

fn _x64_fast_lcg_unsigned_setup_loop_vars(ctx, prep) {
    var mod_name = prep[0]
    var mod_const = prep[1]
    var off_idx = prep[11]
    var off_n = prep[12]
    var off_x = prep[13]
    var off_sum = prep[14]
    var off_mod = prep[15]
    // load loop vars into regs once
    _emit_mov_r64_mrbp(ctx, 9, 0 - off_idx) // r9 = i
    _emit_mov_r64_mrbp(ctx, 1, 0 - off_n)   // rcx = n
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_x)  // r10 = x
    _emit_mov_r64_mrbp(ctx, 11, 0 - off_sum) // r11 = sum
    if mod_name != nil {
        _emit_mov_r64_mrbp(ctx, 12, 0 - off_mod) // r12 = mod
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(12, mod_const))
    }
    return nil
}

fn _x64_fast_lcg_unsigned_setup_i_mod(ctx, prep, labels, local_fixups) {
    var modi_recip = prep[9]
    var use_fastmod = prep[10]
    // i_mod = i % mod_i (fast path only)
    if use_fastmod == true {
        _emit_fastmod_u64_const_x64(ctx, 9, 3, modi_recip, 7, 6, labels, local_fixups, "lcg_i_mod")
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 9))
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(2, 2)) // rdx = 0
        bytes_extend(ctx["code"], core.insn_div_r64(3)) // rbx
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 2)) // rdi = rdx
    }
    return nil
}

fn _x64_fast_lcg_emit_unsigned_setup(ctx, prep, labels, local_fixups) {
    _x64_fast_lcg_unsigned_setup_constants(ctx, prep)
    _x64_fast_lcg_unsigned_setup_loop_vars(ctx, prep)
    _x64_fast_lcg_unsigned_setup_i_mod(ctx, prep, labels, local_fixups)
    return nil
}

fn _x64_fast_lcg_unsigned_emit_cond(ctx, labels, local_fixups) {
    var l_fast_cond = labels["cond"]
    var l_fast_end = labels["end"]

    _emit_label(ctx, labels, l_fast_cond)
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(9, 1))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_end)
    return nil
}

fn _x64_fast_lcg_unsigned_emit_safepoint(ctx, prep, labels, local_fixups) {
    var l_sp_skip = _x64_fast_lcg_unsigned_emit_safepoint_guard(ctx, local_fixups)
    _x64_fast_lcg_unsigned_spill_safepoint_regs(ctx, prep)
    _x64_fast_lcg_unsigned_emit_safepoint_call(ctx)
    _x64_fast_lcg_unsigned_reload_safepoint_regs(ctx, prep)
    _emit_label(ctx, labels, l_sp_skip)
    return nil
}

fn _x64_fast_lcg_unsigned_emit_safepoint_guard(ctx, local_fixups) {
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(8, 1))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 8))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(0, 4095))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_sp_skip = _new_label(ctx, "lcg_sum_sp_skip")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_sp_skip)
    return l_sp_skip
}

fn _x64_fast_lcg_unsigned_spill_safepoint_regs(ctx, prep) {
    var off_idx = prep[11]
    var off_x = prep[13]
    var off_sum = prep[14]
    var off_i_mod = prep[17]
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 9)
    _emit_mov_mrbp_r64(ctx, 0 - off_x, 10)
    _emit_mov_mrbp_r64(ctx, 0 - off_sum, 11)
    _emit_mov_mrbp_r64(ctx, 0 - off_i_mod, 7)
    return nil
}

fn _x64_fast_lcg_unsigned_emit_safepoint_call(ctx) {
    _emit_gc_safepoint_call_x64(ctx)
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8)) // reset tick after safepoint
    return nil
}

fn _x64_fast_lcg_unsigned_reload_safepoint_regs(ctx, prep) {
    var off_idx = prep[11]
    var off_n = prep[12]
    var off_x = prep[13]
    var off_sum = prep[14]
    var off_i_mod = prep[17]
    _emit_mov_r64_mrbp(ctx, 9, 0 - off_idx)
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_x)
    _emit_mov_r64_mrbp(ctx, 11, 0 - off_sum)
    _emit_mov_r64_mrbp(ctx, 7, 0 - off_i_mod)
    _emit_mov_r64_mrbp(ctx, 1, 0 - off_n)
    return nil
}

fn _x64_fast_lcg_unsigned_emit_unroll2(ctx, prep, labels, local_fixups) {
    var use_fastmod = prep[10]
    var mod_recip = prep[7]
    var modx_recip = prep[8]
    var l_fast_single = labels["single"]
    var l_fast_cond = labels["cond"]
    // If i + 1 >= n, run single-iter path.
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(0, 1))
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 1))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_single)

    var rep = 0
    while rep < 2 {
        _x64_fast_lcg_emit_unsigned_step(ctx, use_fastmod, mod_recip, modx_recip, labels, local_fixups)
        rep = rep + 1
    }

    // i += 2
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(9, 2))
    _emit_jmp_to_label(ctx, local_fixups, l_fast_cond)
    return nil
}

fn _x64_fast_lcg_unsigned_emit_single(ctx, prep, labels, local_fixups) {
    var use_fastmod = prep[10]
    var mod_recip = prep[7]
    var modx_recip = prep[8]
    var l_fast_single = labels["single"]
    var l_fast_cond = labels["cond"]
    _emit_label(ctx, labels, l_fast_single)
    _x64_fast_lcg_emit_unsigned_step(ctx, use_fastmod, mod_recip, modx_recip, labels, local_fixups)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(9, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_fast_cond)
    return nil
}

fn _x64_fast_lcg_unsigned_emit_finish(ctx, prep, labels, local_fixups) {
    var off_idx = prep[11]
    var off_x = prep[13]
    var off_sum = prep[14]
    var l_fast_end = labels["end"]
    _emit_label(ctx, labels, l_fast_end)
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 9)
    _emit_mov_mrbp_r64(ctx, 0 - off_x, 10)
    _emit_mov_mrbp_r64(ctx, 0 - off_sum, 11)
    _emit_jmp_to_label(ctx, local_fixups, labels["done"])
    return nil
}

fn _x64_fast_lcg_emit_unsigned_loop(ctx, prep, labels, local_fixups) {
    _x64_fast_lcg_unsigned_emit_cond(ctx, labels, local_fixups)
    _x64_fast_lcg_unsigned_emit_safepoint(ctx, prep, labels, local_fixups)
    _x64_fast_lcg_unsigned_emit_unroll2(ctx, prep, labels, local_fixups)
    _x64_fast_lcg_unsigned_emit_single(ctx, prep, labels, local_fixups)
    _x64_fast_lcg_unsigned_emit_finish(ctx, prep, labels, local_fixups)
    return nil
}

fn _x64_fast_lcg_fullmod_emit_cond(ctx, prep, labels, local_fixups) {
    var off_idx = prep[11]
    var off_n = prep[12]
    var l_fast_cond_mod = labels["cond_mod"]
    var l_fast_end_mod = labels["end_mod"]

    _emit_label(ctx, labels, l_fast_cond_mod)
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx) // rax = i
    _emit_mov_r64_mrbp(ctx, 1, 0 - off_n)   // rcx = n
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 1))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_end_mod)
    return nil
}

fn _x64_fast_lcg_fullmod_emit_safepoint(ctx, labels, local_fixups) {
    // Inline throttled safepoint without per-iter tick loads/stores.
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(8, 1))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 8))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(0, 4095))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_sp_skip_mod = _new_label(ctx, "lcg_sum_sp_skip_mod")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_sp_skip_mod)
    _emit_gc_safepoint_call_x64(ctx)
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8)) // reset tick after safepoint
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(9, 4095))
    _emit_label(ctx, labels, l_sp_skip_mod)
    return nil
}

fn _x64_fast_lcg_fullmod_reload_state(ctx, prep) {
    var mod_name = prep[0]
    var mod_const = prep[1]
    var off_idx = prep[11]
    var off_x = prep[13]
    var off_sum = prep[14]
    var off_mod = prep[15]

    // reload i/x/sum/mod
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx) // rax = i
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_x)  // r10 = x
    _emit_mov_r64_mrbp(ctx, 11, 0 - off_sum) // r11 = sum
    if mod_name != nil {
        _emit_mov_r64_mrbp(ctx, 12, 0 - off_mod) // r12 = mod
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(12, mod_const))
    }
    return nil
}

fn _x64_fast_lcg_fullmod_emit_step(ctx, prep) {
    // x = x*mul + add
    _x64_fast_lcg_fullmod_update_x(ctx)

    // x = x % mod
    _x64_fast_lcg_fullmod_reduce_x(ctx)

    // term_x = x % mod_x
    _x64_fast_lcg_fullmod_term_x(ctx)

    // term_i = i % mod_i
    _x64_fast_lcg_fullmod_term_i(ctx, prep)

    // sum = (sum + term_x + term_i) % mod
    _x64_fast_lcg_fullmod_reduce_sum(ctx)
    return nil
}

fn _x64_fast_lcg_fullmod_update_x(ctx) {
    bytes_extend(ctx["code"], core.insn_imul_r64_r64(10, 13))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(10, 14))
    return nil
}

fn _x64_fast_lcg_fullmod_reduce_x(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_idiv_r64(12))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 2)) // r10 = rdx
    return nil
}

fn _x64_fast_lcg_fullmod_term_x(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_idiv_r64(15))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(6, 2)) // rsi = rdx
    return nil
}

fn _x64_fast_lcg_fullmod_term_i(ctx, prep) {
    var off_idx = prep[11]
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_idiv_r64(3)) // rbx
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 2)) // rdi = rdx
    return nil
}

fn _x64_fast_lcg_fullmod_reduce_sum(ctx) {
    bytes_extend(ctx["code"], core.insn_add_r64_r64(11, 6))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(11, 7))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_idiv_r64(12))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 2)) // r11 = rdx
    return nil
}

fn _x64_fast_lcg_fullmod_writeback_inc(ctx, prep) {
    var off_idx = prep[11]
    var off_x = prep[13]
    var off_sum = prep[14]

    _emit_mov_mrbp_r64(ctx, 0 - off_x, 10)
    _emit_mov_mrbp_r64(ctx, 0 - off_sum, 11)

    // i++
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(0, 1))
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 0)
    return nil
}

fn _x64_fast_lcg_emit_fullmod_loop(ctx, prep, labels, local_fixups) {
    _x64_fast_lcg_fullmod_emit_cond(ctx, prep, labels, local_fixups)
    _x64_fast_lcg_fullmod_emit_safepoint(ctx, labels, local_fixups)
    _x64_fast_lcg_fullmod_reload_state(ctx, prep)
    _x64_fast_lcg_fullmod_emit_step(ctx, prep)
    _x64_fast_lcg_fullmod_writeback_inc(ctx, prep)
    _emit_jmp_to_label(ctx, local_fixups, labels["cond_mod"])
    _emit_label(ctx, labels, labels["end_mod"])
    _emit_jmp_to_label(ctx, local_fixups, labels["done"])
    return nil
}

fn _emit_fast_lcg_sum_while_x64(ctx, op, info, locals, labels, local_fixups, epilogue_label, platform) {
    if ctx == nil || op == nil || info == nil { return nil }
    if locals == nil { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }
    if ctx["runtime_injected"] != true { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }

    var prep = _x64_fast_lcg_prepare(ctx, info, locals)
    if prep == nil { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }
    var base = prep[16]
    var lcg_labels = _x64_fast_lcg_labels(ctx)
    _x64_fast_lcg_emit_entry_gates(ctx, prep, lcg_labels, local_fixups)
    _x64_fast_lcg_emit_unsigned_setup(ctx, prep, lcg_labels, local_fixups)
    _x64_fast_lcg_emit_unsigned_loop(ctx, prep, lcg_labels, local_fixups)
    _x64_fast_lcg_emit_fullmod_loop(ctx, prep, lcg_labels, local_fixups)

    _emit_label(ctx, labels, lcg_labels["slow"])
    _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    _emit_label(ctx, labels, lcg_labels["done"])
    _intr_tmp_pop(ctx, base)
    return nil
}
