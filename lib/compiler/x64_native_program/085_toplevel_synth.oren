// Tier‑1 x64 native: top-level synthesis helpers.
//
// Extracted from `090_program_entry.oren` to keep that entry module bounded.

fn _x64_trace_global_slots(ctx, label) {
    var v = oren_env("OREN_TRACE_GLOBAL_SLOTS")
    if v == nil || v == "" { return nil }
    if x64_env_str_eq(v, "0") || x64_env_str_eq(v, "false") { return nil }
    if ctx == nil { return nil }
    var gmap = ctx["globals"]
    if gmap == nil { return nil }

    var filter_name = oren_env("OREN_TRACE_GLOBAL_SLOT_NAME")
    var filter_off = oren_env("OREN_TRACE_GLOBAL_SLOT_OFF")
    var filter_idx = oren_env("OREN_TRACE_GLOBAL_SLOT_INDEX")
    var want_off = -1
    var want_idx = -1
    if filter_off != nil && filter_off != "" { want_off = core.parse_int_decimal(filter_off, want_off) }
    if filter_idx != nil && filter_idx != "" { want_idx = core.parse_int_decimal(filter_idx, want_idx) }

    var hdr = "[x64_globals]"
    if label != nil && label != "" { hdr = hdr + " " + label }
    print(hdr)
    var gi = 0
    var pair = [nil, nil]
    while 1 {
        var okg = oren_iter_next_entry(gmap, gi, pair)
        if okg == 0 { break }
        var name = pair[0]
        var off_enc = pair[1]
        if name == nil || oren_type_tag(off_enc) != 1 { gi = gi + 1; continue }
        var off = off_enc - 1
        var idx = off / 8
        var match = true
        if filter_name != nil && filter_name != "" && x64_env_str_eq(filter_name, name) != true { match = false }
        if want_off >= 0 && off != want_off { match = false }
        if want_idx >= 0 && idx != want_idx { match = false }
        if match {
            print("[x64_globals] name=" + name + " off=" + oren_int_to_string(off) + " idx=" + oren_int_to_string(idx))
        }
        gi = gi + 1
    }
    return nil
}

fn _x64_direct_data_int_init(ctx, expr) {
    // Only side-effect-free integer constants are safe to remove from __top_level__.
    // This includes signed literals and namespace aliases to globals whose constant fact
    // has already been established in source order.
    if expr == nil { return nil }
    if expr["type"] != "Integer" && expr["type"] != "Identifier" && expr["type"] != "Member" && expr["type"] != "Prefix" { return nil }
    return _x64_expr_int_const(ctx, expr)
}

fn _x64_direct_data_string_init(ctx, expr) {
    if expr == nil || expr["type"] != "String" { return nil }
    var s = expr["value"]
    if s == nil || oren_is_string(s) != true {
        var tok = expr["token"]
        if tok != nil {
            var lit = tok["literal"]
            if lit != nil && oren_is_string(lit) == true { s = lit }
        }
    }
    if s == nil { s = "" }
    if oren_is_string(s) != true { return nil }
    var off = _data_add_cstr0_nodedup(ctx, s)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    return off
}

fn _x64_direct_data_string_globals_enabled() {
    var v = oren_env("OREN_X64_GLOBAL_STRINGS_IN_DATA")
    if v == nil || v == "" { return false }
    if x64_env_str_eq(v, "0") || x64_env_str_eq(v, "false") { return false }
    return true
}

fn _x64_append_global_string_batch_cstr0(ctx, s) {
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if ctx["cstr0_list"] == nil { ctx["cstr0_list"] = [] }
    if s == nil || s == 0 { s = "" }
    if oren_is_string(s) != true { return nil }
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = bytes_len(ctx["data"])
    var n = oren_string_len(s)
    if n > 1048576 {
        s = oren_string_slice(s, 0, 1048576)
    }
    bytes_extend_string(ctx["data"], s)
    bytes_push(ctx["data"], 0)
    oren_list_push(ctx["cstr0_list"], off)
    return off
}

fn _x64_flush_global_string_init_batch(out_stmts, names, values, off_encs, slot_offs, toks, items, ctx, table_count, table_buf) {
    if out_stmts == nil || names == nil || values == nil || off_encs == nil { return nil }
    var n = oren_list_len(names)
    if n <= 0 { return nil }
    var tok0 = nil
    if toks != nil && oren_list_len(toks) > 0 { tok0 = toks[0] }
    var table_off = nil
    if ctx != nil && table_count > 0 && table_buf != nil {
        if ctx["data"] == nil { ctx["data"] = bytes_new() }
        while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
        table_off = bytes_len(ctx["data"])
        push_u64_le(ctx["data"], table_count)
        bytes_extend(ctx["data"], table_buf)
    }
    if oren_type_tag(table_off) == 1 {
        oren_list_push(out_stmts, {
            "type": "X64GlobalStringInitBatch",
            "token": tok0,
            "table_off": table_off,
            "count": table_count,
        })
        return nil
    }
    oren_list_push(out_stmts, {
        "type": "X64GlobalStringInitBatch",
        "token": tok0,
        "names": names,
        "values": values,
        "off_encs": off_encs,
        "slot_offs": slot_offs,
        "toks": toks,
        "items": items,
        "table_off": table_off,
        "count": table_count,
    })
    return nil
}

fn _x64_flush_global_empty_container_init_batch(out_stmts, kind, tok0, ctx, table_count, table_buf) {
    if out_stmts == nil || kind == nil || table_count <= 0 || ctx == nil || table_buf == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var table_off = bytes_len(ctx["data"])
    push_u64_le(ctx["data"], table_count)
    bytes_extend(ctx["data"], table_buf)
    oren_list_push(out_stmts, {
        "type": "X64GlobalEmptyContainerInitBatch",
        "token": tok0,
        "kind": kind,
        "table_off": table_off,
        "count": table_count,
    })
    return nil
}

fn _x64_direct_data_singleton_init(ctx, expr) {
    if ctx == nil || expr == nil { return nil }
    var t = expr["type"]
    if t == "Nil" {
        var nil_enc = ctx["boot_nil_obj_off_enc"]
        if oren_type_tag(nil_enc) == 0 { return nil }
        return nil_enc - 1
    }
    if t == "Boolean" {
        var bool_enc = nil
        if expr["value"] { bool_enc = ctx["boot_true_obj_off_enc"] }
        else { bool_enc = ctx["boot_false_obj_off_enc"] }
        if oren_type_tag(bool_enc) == 0 { return nil }
        return bool_enc - 1
    }
    return nil
}

fn _x64_direct_data_ptr_const_name(ctx, expr) {
    if ctx == nil || expr == nil { return nil }
    var name = nil
    if expr["type"] == "Identifier" {
        name = expr["value"]
    } else if expr["type"] == "Member" {
        var resolved = _x64_ns_resolve(ctx, expr)
        if resolved != nil { name = resolved["name"] }
    }
    return name
}

fn _x64_direct_data_ptr_const_init(ctx, expr) {
    var name = _x64_direct_data_ptr_const_name(ctx, expr)
    if name == nil { return nil }
    var enc = nil
    if ctx["globals_data_const"] != nil { enc = ctx["globals_data_const"][name] }
    if oren_type_tag(enc) == 0 { return nil }
    return enc - 1
}

fn _x64_configure_runtime_global_root_flags(ctx) {
    var v_trace_names = oren_env("OREN_TRACE_GC_REGISTER_ROOT_NAMES")
    if v_trace_names != nil && v_trace_names != "" &&
       x64_env_str_eq(v_trace_names, "0") != true &&
       x64_env_str_eq(v_trace_names, "false") != true {
        ctx["trace_gc_root_names"] = 1
    }
    var v_skip = oren_env("OREN_GC_ROOTS_SKIP_RUNTIME_GLOBALS")
    if v_skip != nil && v_skip != "" &&
       x64_env_str_eq(v_skip, "0") != true &&
       x64_env_str_eq(v_skip, "false") != true {
        ctx["skip_runtime_global_roots"] = 1
    }
    return nil
}

fn _x64_runtime_global_name(st) {
    if st == nil || st["name"] == nil { return nil }
    return st["name"]["value"]
}

fn _x64_collect_runtime_global_names(runtime_vars, runtime_globals) {
    var ri = 0
    while ri < oren_list_len(runtime_vars) {
        var rnm = _x64_runtime_global_name(runtime_vars[ri])
        if rnm != nil { runtime_globals[rnm] = true }
        ri = ri + 1
    }
    return nil
}

fn _x64_prepare_one_runtime_global_slot(ctx, nm) {
    if nm == nil { return true }
    // `g_storage` is reserved in the native entry stub `.data` prefix (Tier-1 bootstrap).
    if nm == "g_storage" && ctx["globals"] != nil && ctx["globals"][nm] != nil { return true }
    if ctx["globals"] != nil && ctx["globals"][nm] != nil {
        err(ctx, "x64 native v0: duplicate global var " + nm)
        return false
    }
    var off0 = _data_add_u64(ctx, 0)
    // Store as offset+1 so a real offset of 0 is representable while still using `nil`
    // as the map sentinel for "missing/uninitialized" (call sites decode with `enc-1`).
    ctx["globals"][nm] = off0 + 1
    if ctx["global_root_names"] != nil { oren_list_push(ctx["global_root_names"], nm) }
    if ctx["global_root_offsets"] != nil { oren_list_push(ctx["global_root_offsets"], off0) }
    if ctx["global_root_is_runtime"] != nil { oren_list_push(ctx["global_root_is_runtime"], true) }
    return true
}

fn _x64_allocate_runtime_global_slots(ctx, runtime_vars) {
    var i = 0
    while i < oren_list_len(runtime_vars) {
        if _x64_prepare_one_runtime_global_slot(ctx, _x64_runtime_global_name(runtime_vars[i])) != true { return false }
        i = i + 1
    }
    return true
}

fn _x64_log_runtime_global_slots(ctx, runtime_vars) {
    var phase_log = ctx["phase_log"]
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.top_globals.runtime_slots.done",
            "runtime_vars=" + oren_int_to_string(oren_list_len(runtime_vars)) +
            " data_bytes=" + oren_int_to_string(bytes_len(ctx["data"])))
    }
    return nil
}

fn _x64_prepare_runtime_global_slots(ctx, runtime_vars) {
    if ctx == nil { return nil }
    if runtime_vars == nil { runtime_vars = [] }
    if ctx["runtime_globals"] == nil { ctx["runtime_globals"] = {} }
    var runtime_globals = ctx["runtime_globals"]
    _x64_configure_runtime_global_root_flags(ctx)
    _x64_collect_runtime_global_names(runtime_vars, runtime_globals)

    // Allocate runtime global slots (always zero-initialized; runtime init owns their values).
    if _x64_allocate_runtime_global_slots(ctx, runtime_vars) != true { return nil }
    _x64_log_runtime_global_slots(ctx, runtime_vars)
    return runtime_globals
}

fn _x64_collect_data_const_alias_targets(ctx, user_vars) {
    var data_const_alias_targets = {}
    var ai = 0
    while user_vars != nil && ai < oren_list_len(user_vars) {
        var ast = user_vars[ai]
        if ast != nil {
            var alias_target = _x64_direct_data_ptr_const_name(ctx, ast["value"])
            if alias_target != nil { data_const_alias_targets[alias_target] = true }
        }
        ai = ai + 1
    }
    return data_const_alias_targets
}

fn _x64_user_global_slot_slow_threshold_ms() {
    var slot_slow_ms = 0
    var v_slot_slow = oren_env("OREN_TRACE_X64_TOP_GLOBAL_SLOT_SLOW_MS")
    if v_slot_slow != nil && v_slot_slow != "" {
        slot_slow_ms = core.parse_int_decimal(v_slot_slow, slot_slow_ms)
    }
    return slot_slow_ms
}

fn _x64_log_user_global_slot_progress(ctx, phase_log, i, total, st2) {
    if phase_log == nil || core.int_mod(i, 50) != 0 { return nil }
    var value_ty2 = "nil"
    if st2 != nil && st2["value"] != nil && st2["value"]["type"] != nil { value_ty2 = st2["value"]["type"] }
    var loc2 = ""
    var tok2 = nil
    if st2 != nil { tok2 = st2["token"] }
    if tok2 != nil && tok2["file"] != nil && tok2["line"] != nil {
        loc2 = " file=" + tok2["file"] + " line=" + oren_int_to_string(tok2["line"])
    }
    _x64_program_phase_log_append(phase_log, "x64.codegen.top_globals.user_slots.progress",
        "i=" + oren_int_to_string(i) +
        " total=" + oren_int_to_string(total) +
        " value=" + value_ty2 +
        loc2)
    return nil
}

fn _x64_log_user_global_slot_slow(ctx, phase_log, slot_slow_ms, slot_start_ns, i, st2,
                                  nm2, slot_path, slot_init_ms, slot_alloc_ms,
                                  slot_fixup_ms, slot_meta_ms) {
    if phase_log == nil || slot_slow_ms <= 0 || slot_start_ns == 0 { return nil }
    var slot_elapsed_ms = (oren_time_now_ns() - slot_start_ns) / 1000000
    if slot_elapsed_ms < slot_slow_ms { return nil }
    var slow_ty = "nil"
    if st2 != nil && st2["value"] != nil && st2["value"]["type"] != nil { slow_ty = st2["value"]["type"] }
    var slow_loc = ""
    var slow_tok = st2["token"]
    if slow_tok != nil && slow_tok["file"] != nil && slow_tok["line"] != nil {
        slow_loc = " file=" + slow_tok["file"] + " line=" + oren_int_to_string(slow_tok["line"])
    }
    _x64_program_phase_log_append(phase_log, "x64.codegen.top_globals.user_slot.slow",
        "i=" + oren_int_to_string(i) +
        " ms=" + oren_int_to_string(slot_elapsed_ms) +
        " name=" + nm2 +
        " value=" + slow_ty +
        " path=" + slot_path +
        " init_ms=" + oren_int_to_string(slot_init_ms) +
        " alloc_ms=" + oren_int_to_string(slot_alloc_ms) +
        " fixup_ms=" + oren_int_to_string(slot_fixup_ms) +
        " meta_ms=" + oren_int_to_string(slot_meta_ms) +
        slow_loc)
    return nil
}

fn _x64_user_global_slot_state(nm2, slot_start_ns) {
    return {
        "name": nm2,
        "off": 0,
        "have_off": false,
        "fact_floaty": false,
        "fact_inty": false,
        "fact_const": nil,
        "fact_data_const": nil,
        "direct_init_in_data": false,
        "path": "runtime_zero",
        "start_ns": slot_start_ns,
        "step_ns": 0,
        "init_ms": 0,
        "alloc_ms": 0,
        "fixup_ms": 0,
        "meta_ms": 0
    }
}

fn _x64_slot_step_start(slot) {
    if slot != nil && slot["start_ns"] != 0 { slot["step_ns"] = oren_time_now_ns() }
    return nil
}

fn _x64_slot_step_add_ms(slot, key) {
    if slot != nil && slot["start_ns"] != 0 {
        slot[key] = slot[key] + ((oren_time_now_ns() - slot["step_ns"]) / 1000000)
    }
    return nil
}

fn _x64_prepare_user_global_check_name(ctx, nm2, runtime_vars, runtime_globals) {
    if ctx["globals"] != nil && ctx["globals"][nm2] != nil {
        if oren_list_len(runtime_vars) > 0 && runtime_globals != nil && runtime_globals[nm2] != nil {
            err(ctx, "x64 native v0: global var shadows runtime global " + nm2)
            return false
        }
        err(ctx, "x64 native v0: duplicate global var " + nm2)
        return false
    }
    return true
}

fn _x64_slot_try_direct_int(ctx, slot, value) {
    _x64_slot_step_start(slot)
    var init_int2 = _x64_direct_data_int_init(ctx, value)
    _x64_slot_step_add_ms(slot, "init_ms")
    if oren_type_tag(init_int2) == 0 { return false }
    _x64_slot_step_start(slot)
    slot["off"] = _data_add_u64(ctx, init_int2)
    _x64_slot_step_add_ms(slot, "alloc_ms")
    slot["have_off"] = true
    slot["fact_inty"] = true
    slot["fact_const"] = init_int2
    slot["direct_init_in_data"] = true
    slot["path"] = "direct_int"
    return true
}

fn _x64_slot_store_data_ptr(ctx, slot, target_off, path) {
    _x64_slot_step_start(slot)
    slot["off"] = _data_add_u64(ctx, 0)
    _x64_slot_step_add_ms(slot, "alloc_ms")
    slot["have_off"] = true
    _x64_slot_step_start(slot)
    oren_list_push(ctx["fixups"], {"type": "data_data_ptr", "data_off": slot["off"], "target_data_off": target_off})
    _x64_slot_step_add_ms(slot, "fixup_ms")
    slot["fact_data_const"] = target_off
    slot["direct_init_in_data"] = true
    slot["path"] = path
    return true
}

fn _x64_slot_try_direct_string(ctx, slot, value, direct_string_globals) {
    if direct_string_globals != true { return false }
    _x64_slot_step_start(slot)
    var init_str2 = _x64_direct_data_string_init(ctx, value)
    _x64_slot_step_add_ms(slot, "init_ms")
    if oren_type_tag(init_str2) == 0 { return false }
    return _x64_slot_store_data_ptr(ctx, slot, init_str2, "direct_string")
}

fn _x64_slot_try_alias_string_fact(ctx, slot, value, data_const_alias_targets) {
    if data_const_alias_targets[slot["name"]] != true { return false }
    if oren_type_tag(slot["fact_data_const"]) != 0 { return false }
    _x64_slot_step_start(slot)
    var alias_str_const2 = _x64_direct_data_string_init(ctx, value)
    _x64_slot_step_add_ms(slot, "init_ms")
    if oren_type_tag(alias_str_const2) != 0 { slot["fact_data_const"] = alias_str_const2; return true }
    return false
}

fn _x64_slot_try_direct_singleton(ctx, slot, value) {
    _x64_slot_step_start(slot)
    var init_singleton2 = _x64_direct_data_singleton_init(ctx, value)
    _x64_slot_step_add_ms(slot, "init_ms")
    if oren_type_tag(init_singleton2) == 0 { return false }
    return _x64_slot_store_data_ptr(ctx, slot, init_singleton2, "direct_singleton")
}

fn _x64_slot_try_direct_alias(ctx, slot, value) {
    _x64_slot_step_start(slot)
    var init_ptr2 = _x64_direct_data_ptr_const_init(ctx, value)
    _x64_slot_step_add_ms(slot, "init_ms")
    if oren_type_tag(init_ptr2) == 0 { return false }
    return _x64_slot_store_data_ptr(ctx, slot, init_ptr2, "direct_alias")
}

fn _x64_prepare_user_global_slot_storage(ctx, st2, slot, direct_string_globals, data_const_alias_targets) {
    var value = st2["value"]
    if _x64_slot_try_direct_int(ctx, slot, value) == true { return nil }
    if _x64_slot_try_direct_string(ctx, slot, value, direct_string_globals) == true { return nil }
    _x64_slot_try_alias_string_fact(ctx, slot, value, data_const_alias_targets)
    if _x64_slot_try_direct_singleton(ctx, slot, value) == true { return nil }
    if _x64_slot_try_direct_alias(ctx, slot, value) == true { return nil }
    _x64_slot_step_start(slot)
    slot["off"] = _data_add_u64(ctx, 0)
    _x64_slot_step_add_ms(slot, "alloc_ms")
    return nil
}

fn _x64_prepare_user_global_slot_facts(ctx, st2, slot) {
    if slot["have_off"] == true { return nil }
    _x64_slot_step_start(slot)
    slot["fact_floaty"] = _x64_expr_is_floaty(ctx, st2["value"])
    slot["fact_inty"] = _x64_expr_is_inty(ctx, st2["value"])
    slot["fact_const"] = _x64_expr_int_const(ctx, st2["value"])
    _x64_slot_step_add_ms(slot, "init_ms")
    return nil
}

fn _x64_register_user_global_slot(ctx, slot, data_const_alias_targets) {
    var nm2 = slot["name"]
    var off2 = slot["off"]
    _x64_slot_step_start(slot)
    ctx["globals"][nm2] = off2 + 1
    if ctx["global_root_names"] != nil { oren_list_push(ctx["global_root_names"], nm2) }
    if ctx["global_root_offsets"] != nil { oren_list_push(ctx["global_root_offsets"], off2) }
    if ctx["global_root_is_runtime"] != nil { oren_list_push(ctx["global_root_is_runtime"], false) }
    if ctx["globals_floaty"] != nil && slot["fact_floaty"] == true { ctx["globals_floaty"][nm2] = true }
    if ctx["globals_inty"] != nil && slot["fact_inty"] == true { ctx["globals_inty"][nm2] = true }
    if ctx["globals_int_const"] != nil && oren_type_tag(slot["fact_const"]) != 0 { ctx["globals_int_const"][nm2] = slot["fact_const"] }
    if ctx["globals_data_const"] != nil && oren_type_tag(slot["fact_data_const"]) != 0 &&
       data_const_alias_targets[nm2] == true {
        ctx["globals_data_const"][nm2] = slot["fact_data_const"] + 1
    }
    if slot["start_ns"] != 0 { slot["meta_ms"] = (oren_time_now_ns() - slot["step_ns"]) / 1000000 }
    return nil
}

fn _x64_prepare_one_user_global_slot(ctx, st2, runtime_vars, runtime_globals,
                                     direct_string_globals, data_const_alias_targets,
                                     slot_slow_ms, i, total) {
    var phase_log = ctx["phase_log"]
    _x64_log_user_global_slot_progress(ctx, phase_log, i, total, st2)
    var slot_start_ns = 0
    if phase_log != nil && slot_slow_ms > 0 { slot_start_ns = oren_time_now_ns() }

    var nm2 = st2["name"]["value"]
    if _x64_prepare_user_global_check_name(ctx, nm2, runtime_vars, runtime_globals) != true { return nil }
    var slot = _x64_user_global_slot_state(nm2, slot_start_ns)
    _x64_prepare_user_global_slot_storage(ctx, st2, slot, direct_string_globals, data_const_alias_targets)
    _x64_prepare_user_global_slot_facts(ctx, st2, slot)
    _x64_register_user_global_slot(ctx, slot, data_const_alias_targets)
    _x64_log_user_global_slot_slow(ctx, phase_log, slot_slow_ms, slot_start_ns, i, st2,
        nm2, slot["path"], slot["init_ms"], slot["alloc_ms"], slot["fixup_ms"], slot["meta_ms"])
    return {
        "direct_init_in_data": slot["direct_init_in_data"],
        "off_enc": slot["off"] + 1,
        "path": slot["path"],
    }
}

fn _x64_user_global_slots_state(ctx, user_vars) {
    return {
        "phase_log": ctx["phase_log"],
        "direct_string_globals": _x64_direct_data_string_globals_enabled(),
        "user_global_init_in_data_flags": [],
        "user_global_off_encs": [],
        "data_const_alias_targets": _x64_collect_data_const_alias_targets(ctx, user_vars),
        "slot_direct_int": 0,
        "slot_direct_string": 0,
        "slot_direct_singleton": 0,
        "slot_direct_alias": 0,
        "slot_zero_runtime": 0,
        "slot_slow_ms": _x64_user_global_slot_slow_threshold_ms(),
        "total": oren_list_len(user_vars)
    }
}

fn _x64_user_global_slots_record(state, slot_info) {
    var slot_path = slot_info["path"]
    if slot_path == "direct_int" { state["slot_direct_int"] = state["slot_direct_int"] + 1 }
    else if slot_path == "direct_string" { state["slot_direct_string"] = state["slot_direct_string"] + 1 }
    else if slot_path == "direct_singleton" { state["slot_direct_singleton"] = state["slot_direct_singleton"] + 1 }
    else if slot_path == "direct_alias" { state["slot_direct_alias"] = state["slot_direct_alias"] + 1 }
    else { state["slot_zero_runtime"] = state["slot_zero_runtime"] + 1 }
    oren_list_push(state["user_global_init_in_data_flags"], slot_info["direct_init_in_data"])
    oren_list_push(state["user_global_off_encs"], slot_info["off_enc"])
    return nil
}

fn _x64_prepare_user_global_slots_loop(ctx, state, runtime_vars, user_vars, runtime_globals) {
    var i = 0
    while i < oren_list_len(user_vars) {
        var st2 = user_vars[i]
        if st2 != nil {
            var slot_info = _x64_prepare_one_user_global_slot(ctx, st2, runtime_vars, runtime_globals,
                state["direct_string_globals"], state["data_const_alias_targets"], state["slot_slow_ms"], i, state["total"])
            if slot_info == nil { return false }
            _x64_user_global_slots_record(state, slot_info)
        }
        i = i + 1
    }
    return true
}

fn _x64_log_user_global_slots_done(ctx, state) {
    var phase_log = state["phase_log"]
    if phase_log == nil { return nil }
    var direct_string_globals_label = "false"
    if state["direct_string_globals"] == true { direct_string_globals_label = "true" }
    _x64_program_phase_log_append(phase_log, "x64.codegen.top_globals.user_slots.done",
        "user_vars=" + oren_int_to_string(state["total"]) +
        " data_bytes=" + oren_int_to_string(bytes_len(ctx["data"])) +
        " fixups=" + oren_int_to_string(oren_list_len(ctx["fixups"])) +
        " direct_string_globals=" + direct_string_globals_label +
        " direct_int=" + oren_int_to_string(state["slot_direct_int"]) +
        " direct_string=" + oren_int_to_string(state["slot_direct_string"]) +
        " direct_singleton=" + oren_int_to_string(state["slot_direct_singleton"]) +
        " direct_alias=" + oren_int_to_string(state["slot_direct_alias"]) +
        " runtime_zero=" + oren_int_to_string(state["slot_zero_runtime"]))
    return nil
}

fn _x64_prepare_user_global_slots(ctx, runtime_vars, user_vars, runtime_globals) {
    if ctx == nil { return nil }
    if runtime_vars == nil { runtime_vars = [] }
    if user_vars == nil { user_vars = [] }

    // Allocate user global slots. Literal integer/singleton/alias globals can be
    // materialized directly in `.data`. Direct string globals stay opt-in because measured
    // self-host probes show slot-time string data relocation is slower than emitting the
    // synthesized `__top_level__` assignments through the dedicated string fast path.
    var state = _x64_user_global_slots_state(ctx, user_vars)
    if _x64_prepare_user_global_slots_loop(ctx, state, runtime_vars, user_vars, runtime_globals) != true { return nil }
    _x64_log_user_global_slots_done(ctx, state)

    _x64_trace_global_slots(ctx, "after_prepare_globals")
    return {
        "user_global_init_in_data_flags": state["user_global_init_in_data_flags"],
        "user_global_off_encs": state["user_global_off_encs"],
    }
}

fn _x64_top_init_rewrite_state() {
    return {
        "top_stmts": [],
        "pending_string_names": [],
        "pending_string_values": [],
        "pending_string_off_encs": [],
        "pending_string_slot_offs": [],
        "pending_string_toks": [],
        "pending_string_items": [],
        "pending_string_table_buf": bytes_new(),
        "pending_string_count": 0,
        "pending_empty_kind": nil,
        "pending_empty_tok": nil,
        "pending_empty_table_buf": bytes_new(),
        "pending_empty_count": 0,
        "user_var_idx": 0,
        "rewrite_direct_string": 0,
        "rewrite_direct_alias": 0,
        "rewrite_runtime_assign": 0
    }
}

fn _x64_top_init_flush_strings(ctx, state) {
    if state == nil { return nil }
    _x64_flush_global_string_init_batch(state["top_stmts"], state["pending_string_names"],
        state["pending_string_values"], state["pending_string_off_encs"],
        state["pending_string_slot_offs"], state["pending_string_toks"],
        state["pending_string_items"], ctx, state["pending_string_count"],
        state["pending_string_table_buf"])
    state["pending_string_names"] = []
    state["pending_string_values"] = []
    state["pending_string_off_encs"] = []
    state["pending_string_slot_offs"] = []
    state["pending_string_toks"] = []
    state["pending_string_items"] = []
    state["pending_string_table_buf"] = bytes_new()
    state["pending_string_count"] = 0
    return nil
}

fn _x64_top_init_flush_empty(ctx, state) {
    if state == nil { return nil }
    _x64_flush_global_empty_container_init_batch(state["top_stmts"],
        state["pending_empty_kind"], state["pending_empty_tok"], ctx,
        state["pending_empty_count"], state["pending_empty_table_buf"])
    state["pending_empty_kind"] = nil
    state["pending_empty_tok"] = nil
    state["pending_empty_table_buf"] = bytes_new()
    state["pending_empty_count"] = 0
    return nil
}

fn _x64_top_init_flush_all(ctx, state) {
    _x64_top_init_flush_strings(ctx, state)
    _x64_top_init_flush_empty(ctx, state)
    return nil
}

fn _x64_top_init_string_value(expr) {
    if expr == nil { return "" }
    var sx = expr["value"]
    if sx == nil || oren_is_string(sx) != true {
        var vtok = expr["token"]
        if vtok != nil && vtok["literal"] != nil && oren_is_string(vtok["literal"]) == true {
            sx = vtok["literal"]
        }
    }
    if sx == nil { sx = "" }
    return sx
}

fn _x64_top_init_append_string_var(ctx, state, stx, vx, off_encx, slot_offx) {
    _x64_top_init_flush_empty(ctx, state)
    var sx = _x64_top_init_string_value(vx)
    oren_list_push(state["pending_string_names"], stx["name"]["value"])
    oren_list_push(state["pending_string_values"], sx)
    oren_list_push(state["pending_string_off_encs"], off_encx)
    oren_list_push(state["pending_string_slot_offs"], slot_offx)
    oren_list_push(state["pending_string_toks"], stx["token"])
    oren_list_push(state["pending_string_items"], {
        "name": stx["name"]["value"],
        "value": sx,
        "off_enc": off_encx,
        "slot_off": slot_offx,
        "tok": stx["token"],
    })
    var cstr_offx = _x64_append_global_string_batch_cstr0(ctx, sx)
    if cstr_offx != nil {
        push_u64_le(state["pending_string_table_buf"], slot_offx)
        push_u64_le(state["pending_string_table_buf"], cstr_offx)
        state["pending_string_count"] = state["pending_string_count"] + 1
    }
    return nil
}

fn _x64_top_init_append_empty_or_assign(ctx, state, stx, vx, off_encx, slot_offx) {
    _x64_top_init_flush_strings(ctx, state)
    var empty_kind = _x64_empty_container_literal_kind(vx)
    if empty_kind != nil {
        if state["pending_empty_kind"] != nil && state["pending_empty_kind"] != empty_kind {
            _x64_top_init_flush_empty(ctx, state)
        }
        if state["pending_empty_kind"] == nil {
            state["pending_empty_kind"] = empty_kind
            state["pending_empty_tok"] = stx["token"]
        }
        push_u64_le(state["pending_empty_table_buf"], slot_offx)
        state["pending_empty_count"] = state["pending_empty_count"] + 1
    } else {
        _x64_top_init_flush_empty(ctx, state)
        var init_assign = {"type": "Assign", "token": stx["token"], "name": stx["name"], "value": stx["value"]}
        init_assign["__oren_top_level_global_init"] = true
        init_assign["__oren_global_off_enc"] = off_encx
        oren_list_push(state["top_stmts"], init_assign)
    }
    state["rewrite_runtime_assign"] = state["rewrite_runtime_assign"] + 1
    return nil
}

fn _x64_top_init_rewrite_var(ctx, state, stx, user_global_init_in_data_flags, user_global_off_encs) {
    var idx = state["user_var_idx"]
    var skip_init = false
    if idx < oren_list_len(user_global_init_in_data_flags) &&
       user_global_init_in_data_flags[idx] == true {
        skip_init = true
    }
    state["user_var_idx"] = idx + 1
    if skip_init == true { return true }

    var off_encx = 0
    if idx < oren_list_len(user_global_off_encs) { off_encx = user_global_off_encs[idx] }
    if off_encx <= 0 { err(ctx, "x64 native v0: missing top-level global offset"); return false }

    var slot_offx = off_encx - 1
    var vx = stx["value"]
    if vx != nil && vx["type"] == "String" {
        _x64_top_init_append_string_var(ctx, state, stx, vx, off_encx, slot_offx)
        return true
    }
    _x64_top_init_append_empty_or_assign(ctx, state, stx, vx, off_encx, slot_offx)
    return true
}

fn _x64_top_init_append_exec_stmt(ctx, state, stx) {
    _x64_top_init_flush_all(ctx, state)
    oren_list_push(state["top_stmts"], stx)
    return nil
}

fn _x64_top_init_log_progress(phase_log, state, i, total, rewrite_start_ns) {
    if phase_log == nil || core.int_mod(i, 50) != 0 { return nil }
    var rewrite_elapsed_ms = 0
    if rewrite_start_ns != 0 { rewrite_elapsed_ms = (oren_time_now_ns() - rewrite_start_ns) / 1000000 }
    _x64_program_phase_log_append(phase_log, "x64.codegen.top_globals.rewrite.progress",
        "i=" + oren_int_to_string(i) +
        " total=" + oren_int_to_string(total) +
        " elapsed_ms=" + oren_int_to_string(rewrite_elapsed_ms) +
        " direct_string=" + oren_int_to_string(state["rewrite_direct_string"]) +
        " direct_alias=" + oren_int_to_string(state["rewrite_direct_alias"]) +
        " runtime_assign=" + oren_int_to_string(state["rewrite_runtime_assign"]))
    return nil
}

fn _x64_top_init_log_done(phase_log, state, rewrite_start_ns) {
    if phase_log == nil { return nil }
    var rewrite_elapsed_done_ms = 0
    if rewrite_start_ns != 0 { rewrite_elapsed_done_ms = (oren_time_now_ns() - rewrite_start_ns) / 1000000 }
    _x64_program_phase_log_append(phase_log, "x64.codegen.top_globals.top_stmts.done",
        "top_stmts=" + oren_int_to_string(oren_list_len(state["top_stmts"])) +
        " rewrite_ms=" + oren_int_to_string(rewrite_elapsed_done_ms) +
        " direct_string=" + oren_int_to_string(state["rewrite_direct_string"]) +
        " direct_alias=" + oren_int_to_string(state["rewrite_direct_alias"]) +
        " runtime_assign=" + oren_int_to_string(state["rewrite_runtime_assign"]))
    return nil
}

fn _x64_build_top_level_init_stmts(ctx, user_ordered, user_global_init_in_data_flags, user_global_off_encs) {
    if ctx == nil { return nil }
    if user_ordered == nil { user_ordered = [] }
    var phase_log = ctx["phase_log"]

    // Top-level exec order:
    // Preserve source order across `var` initializers and other executable top-level statements.
    // Rewrite `var x = expr` into global-slot assignments at the same position.
    var state = _x64_top_init_rewrite_state()
    var j = 0
    var rewrite_start_ns = 0
    if phase_log != nil { rewrite_start_ns = oren_time_now_ns() }
    while j < oren_list_len(user_ordered) {
        var stx = user_ordered[j]
        _x64_top_init_log_progress(phase_log, state, j, oren_list_len(user_ordered), rewrite_start_ns)
        if stx != nil && stx["type"] == "Var" {
            if _x64_top_init_rewrite_var(ctx, state, stx, user_global_init_in_data_flags, user_global_off_encs) != true { return nil }
        } else {
            _x64_top_init_append_exec_stmt(ctx, state, stx)
        }
        j = j + 1
    }
    _x64_top_init_flush_all(ctx, state)
    _x64_top_init_log_done(phase_log, state, rewrite_start_ns)
    return state["top_stmts"]
}

fn _x64_trace_top_level_stmt_list_enabled() {
    var v_list = oren_env("OREN_TRACE_TOP_LEVEL_LIST")
    if v_list == nil || v_list == "" { return false }
    if x64_env_str_eq(v_list, "0") == true || x64_env_str_eq(v_list, "false") == true { return false }
    return true
}

fn _x64_trace_top_level_stmt_extra(stl) {
    if stl == nil { return {"kind": "nil", "extra": "", "tok": nil} }
    var kind = stl["type"]
    var extra = ""
    if kind == "Assign" && stl["name"] != nil { extra = " name=" + stl["name"]["value"] }
    if kind == "ExprStmt" && stl["expr"] != nil { extra = " expr=" + stl["expr"]["type"] }
    return {"kind": kind, "extra": extra, "tok": stl["token"]}
}

fn _x64_trace_top_level_stmt_loc(tok) {
    if tok == nil { return "" }
    var tf = tok["file"]
    var tl = tok["line"]
    if tf == nil || tl == nil { return "" }
    return " @" + tf + ":" + oren_int_to_string(tl)
}

fn _x64_trace_top_level_stmt_list(top_stmts, top_len) {
    if _x64_trace_top_level_stmt_list_enabled() != true { return nil }
    var li = 0
    while li < top_len {
        var info = _x64_trace_top_level_stmt_extra(top_stmts[li])
        print("[x64_top_level] idx=" + oren_int_to_string(li) +
            " type=" + info["kind"] + info["extra"] + _x64_trace_top_level_stmt_loc(info["tok"]))
        li = li + 1
    }
    return nil
}

fn _x64_top_level_slice_bounds(top_len) {
    var slice_from = 0
    var slice_to = top_len
    var v_from = oren_env("OREN_TOP_LEVEL_FROM")
    if v_from != nil && v_from != "" { slice_from = core.parse_int_decimal(v_from, slice_from) }
    var v_to = oren_env("OREN_TOP_LEVEL_TO")
    if v_to != nil && v_to != "" { slice_to = core.parse_int_decimal(v_to, slice_to) }
    if slice_from < 0 { slice_from = 0 }
    if slice_to < 0 { slice_to = 0 }
    if slice_from > top_len { slice_from = top_len }
    if slice_to > top_len { slice_to = top_len }
    if slice_to < slice_from { slice_to = slice_from }
    return {"from": slice_from, "to": slice_to}
}

fn _x64_trace_top_level_slice(top_len, bounds) {
    var v_trace = oren_env("OREN_TRACE_TOP_LEVEL_SLICE")
    if v_trace == nil || v_trace == "" { return nil }
    if x64_env_str_eq(v_trace, "0") == true || x64_env_str_eq(v_trace, "false") == true { return nil }
    print("[x64_top_level] stmts=" + oren_int_to_string(top_len) + " slice=" +
        oren_int_to_string(bounds["from"]) + ":" + oren_int_to_string(bounds["to"]))
    return nil
}

fn _x64_apply_top_level_slice(top_stmts, top_len) {
    // Debug-only bisecting: slice the synthesized top-level statements by index.
    // - OREN_TOP_LEVEL_FROM / OREN_TOP_LEVEL_TO are inclusive-exclusive indexes.
    // - OREN_TRACE_TOP_LEVEL_SLICE=1 prints the slice + total count at compile time.
    var bounds = _x64_top_level_slice_bounds(top_len)
    _x64_trace_top_level_slice(top_len, bounds)
    if bounds["from"] <= 0 && bounds["to"] >= top_len { return top_stmts }

    var sliced = []
    var k = bounds["from"]
    while k < bounds["to"] { oren_list_push(sliced, top_stmts[k]); k = k + 1 }
    return sliced
}

fn _x64_collect_top_level_globals_and_stmts(ctx, runtime_stmts, user_stmts) {
    // Collect top-level `var` declarations as globals and build the statement list to run
    // before `main` (implemented as a synthesized `fn __top_level__(){...}`).
    //
    // Tier‑1 convergence (arm64 parity):
    // - Allocate runtime globals, but do NOT execute runtime global initializers in __top_level__.
    //   The injected runtime must initialize its own globals in `native_runtime_init`.
    // - Defer ALL user global initializers into __top_level__ as assignments, so
    //   startup order is deterministic and matches arm64.
    // - Disallow top-level executable statements in the injected runtime.
    if ctx == nil { return nil }
    var phase_log = ctx["phase_log"]

    var declared = ctx["declared_functions"]
    var split = nt.split_tier1_runtime_user(ctx, "x64 native v0", runtime_stmts, user_stmts, declared)
    if split == nil { return nil }

    var runtime_vars = split["runtime_vars"]
    var user_vars = split["user_vars"]
    var user_exec = split["user_exec"]
    var user_ordered = split["user_ordered"]
    if runtime_vars == nil { runtime_vars = [] }
    if user_vars == nil { user_vars = [] }
    if user_exec == nil { user_exec = [] }
    if user_ordered == nil { user_ordered = [] }
    if phase_log != nil {
        _x64_program_phase_log_append(phase_log, "x64.codegen.top_globals.split.done",
            "runtime_vars=" + oren_int_to_string(oren_list_len(runtime_vars)) +
            " user_vars=" + oren_int_to_string(oren_list_len(user_vars)) +
            " user_ordered=" + oren_int_to_string(oren_list_len(user_ordered)))
    }

    var runtime_globals = _x64_prepare_runtime_global_slots(ctx, runtime_vars)
    if runtime_globals == nil { return nil }
    var user_slot_info = _x64_prepare_user_global_slots(ctx, runtime_vars, user_vars, runtime_globals)
    if user_slot_info == nil { return nil }
    var top_stmts = _x64_build_top_level_init_stmts(ctx, user_ordered,
        user_slot_info["user_global_init_in_data_flags"],
        user_slot_info["user_global_off_encs"])
    if top_stmts == nil { return nil }

    var top_len = oren_list_len(top_stmts)
    // Debug-only tracing: list synthesized top-level statements with indices.
    _x64_trace_top_level_stmt_list(top_stmts, top_len)
    top_stmts = _x64_apply_top_level_slice(top_stmts, top_len)
    return {"top_level_fn": _x64_synth_top_level_fn(top_stmts), "top_stmt_count": oren_list_len(top_stmts)}
}

fn _x64_type_constructor_stmts(linked) {
    var stmts = nil
    if linked != nil { stmts = linked["statements"] }
    return stmts
}

fn _x64_type_constructor_name(ctx, st) {
    var name_node = st["name"]
    if name_node == nil || name_node["type"] != "Identifier" {
        err(ctx, "x64 native v0: Type name must be identifier")
        return nil
    }
    var nm = name_node["value"]
    if nm == nil || nm == "" {
        err(ctx, "x64 native v0: Type name is empty")
        return nil
    }
    if ctx["declared_functions"] != nil && ctx["declared_functions"][nm] != nil {
        err(ctx, "x64 native v0: Type constructor name conflicts with existing function " + nm)
        return nil
    }
    return nm
}

fn _x64_type_constructor_params_and_pairs(ctx, nm, fields) {
    var params = []
    var pairs = []
    var n_fields = 0
    if fields != nil { n_fields = oren_list_len(fields) }

    // Rolling reflection v0: tag type ctor maps with a stable type name.
    //   User(id, name) => {"__oren_type":"User","id":id,"name":name}
    oren_list_push(pairs, {"key": callable.node_string("__oren_type"), "value": callable.node_string(nm)})
    var j = 0
    while j < n_fields {
        var f = fields[j]
        if f == nil || f["type"] != "Identifier" {
            err(ctx, "x64 native v0: Type field must be identifier")
            return nil
        }
        var fnm = f["value"]
        if fnm == nil || fnm == "" {
            err(ctx, "x64 native v0: Type field name is empty")
            return nil
        }
        oren_list_push(params, callable.node_id(fnm))
        oren_list_push(pairs, {"key": callable.node_string(fnm), "value": callable.node_id(fnm)})
        j = j + 1
    }
    return {"params": params, "pairs": pairs, "n_fields": n_fields}
}

fn _x64_type_constructor_function(st, nm, shaped) {
    var ret = callable.node_return({"type": "Hash", "pairs": shaped["pairs"]})
    return {"type": "Function", "token": st["token"], "name": nm, "params": shaped["params"], "body": callable.node_block([ret])}
}

fn _x64_register_type_constructor(ctx, nm, n_fields) {
    if ctx["declared_functions"] == nil { ctx["declared_functions"] = {} }
    ctx["declared_functions"][nm] = true
    if ctx["func_arity"] == nil { ctx["func_arity"] = {} }
    ctx["func_arity"][nm] = n_fields + 1
    if ctx["func_decl_order"] != nil { oren_list_push(ctx["func_decl_order"], nm) }
    return nil
}

fn _x64_extract_type_constructor_one(ctx, st) {
    var nm = _x64_type_constructor_name(ctx, st)
    if nm == nil { return nil }
    var shaped = _x64_type_constructor_params_and_pairs(ctx, nm, st["fields"])
    if shaped == nil { return nil }
    var fun = _x64_type_constructor_function(st, nm, shaped)
    _x64_register_type_constructor(ctx, nm, shaped["n_fields"])
    return fun
}

fn _x64_extract_type_constructors_v0(ctx, linked) {
    if ctx == nil { return nil }
    var stmts = _x64_type_constructor_stmts(linked)
    if stmts == nil { return [] }

    var out = []
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st == nil { i = i + 1; continue }
        if st["type"] != "Type" { i = i + 1; continue }

        var fun = _x64_extract_type_constructor_one(ctx, st)
        if fun == nil { return nil }
        oren_list_push(out, fun)

        i = i + 1
    }
    return out
}

fn _x64_synth_top_level_fn(stmts) {
    // Synthesize: `fn __top_level__() { <stmts>; return 0 }`
    //
    // `_analyze_supported_fn_body` will append an implicit return if needed, but we keep
    // this explicit so the AST is well-formed even if that rule changes.
    if stmts == nil { stmts = [] }
    var out_stmts = []
    var i = 0
    while i < oren_list_len(stmts) { oren_list_push(out_stmts, stmts[i]); i = i + 1 }
    // Ensure a deterministic trailing return in the synthesized block.
    oren_list_push(out_stmts, {"type": "Return", "token": nil, "value": {"type": "Integer", "value": "0"}})
    return {
        "type": "Function",
        "token": nil,
        "name": "__top_level__",
        "params": [],
        "body": {"type": "Block", "stmts": out_stmts},
    }
}
