fn _analyze_supported_fn_body(ctx, fn_node) {
    var body = fn_node["body"]
    if body == nil { err(ctx, "x64 native v0: function has no body"); return nil }
    if body["type"] != "Block" {
        err(ctx, "x64 native v0: function body must be Block")
        return nil
    }
    var ops = _analyze_stmt_list_to_ops(ctx, body["stmts"])
    if ops == nil { return nil }

    // If last statement is not a return, add an implicit `return 0` to keep the ABI sane.
    if oren_list_len(ops) == 0 || ops[oren_list_len(ops) - 1]["op"] != "return" {
        oren_list_push(ops, {"op": "return", "expr": {"type": "Integer", "value": "0"}})
    }
    return ops
}

fn _expr_int_check(ctx, expr) {
    if expr == nil { err(ctx, "x64 native v0: missing expr"); return nil }
    var t = expr["type"]
    if t == "Integer" {
        var n = intparse.parse_int_lit(expr["value"])
        if n == nil { err(ctx, "x64 native v0: invalid integer literal"); return nil }
        return nil
    }
    if t == "Boolean" { return nil }
    if t == "Nil" { return nil }
    if t == "String" { return nil }
    if t == "Identifier" { return nil }
    if t == "Call" {
        var fn_expr = expr["fn"]
        var args = expr["args"]
        if fn_expr == nil || fn_expr["type"] != "Identifier" { err(ctx, "x64 native v0: call target must be identifier"); return nil }
        var nm = fn_expr["value"]
        if nm == "print" { err(ctx, "x64 native v0: print is statement-only"); return nil }
        if expr["spread"] != nil {
            err(ctx, "x64 native v0: call-site spread not supported yet")
            return nil
        }
        var argc = 0
        if args != nil { argc = oren_list_len(args) }
        // Rolling: stack args are supported; arg count is bounded only by frame/call-area capacity.

        // Direct calls enforce arity; indirect calls (callable value in a local/param) are permitted
        // in v0 bring-up without static arity tracking.
        var arity = nil
        if ctx["func_arity"] != nil { arity = ctx["func_arity"][nm] }
        if arity != nil {
            var declared = ctx["declared_functions"]
            if declared != nil && declared[nm] == nil { err(ctx, "x64 native v0: undefined function " + nm); return nil }

            var vf = nil
            if ctx["func_varargs_fixed"] != nil { vf = ctx["func_varargs_fixed"][nm] }
            if vf != nil {
                if argc < vf { err(ctx, "x64 native v0: varargs arity mismatch for " + nm); return nil }
            } else {
                if argc != arity { err(ctx, "x64 native v0: call arity mismatch for " + nm); return nil }
            }
        }

        var i = 0
        while i < argc {
            _expr_int_check(ctx, args[i])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            i = i + 1
        }
        return nil
    }
    if t == "Infix" {
        var op = expr["op"]
        if op != "+" && op != "-" && op != "*" && op != "/" && op != "%" &&
            op != "==" && op != "!=" && op != "<" && op != "<=" && op != ">" && op != ">=" &&
            op != "&&" && op != "||" &&
            op != "&" && op != "|" && op != "^" && op != "<<" && op != ">>" {
            err(ctx, "x64 native v0: infix op not supported: " + op)
            return nil
        }
        var l = expr["left"]
        var r = expr["right"]
        if l == nil || r == nil { err(ctx, "x64 native v0: infix missing operands"); return nil }

        // Rolling: allow nested infix expressions for + and - (and as the LHS of `*`)
        // so chains like `a + b + c + d` work.
        _expr_int_check(ctx, l)
        _expr_int_check(ctx, r)
        return nil
    }
    if t == "Prefix" {
        var op = expr["op"]
        if op != "-" && op != "~" && op != "!" {
            err(ctx, "x64 native v0: prefix op not supported: " + op)
            return nil
        }
        var r = expr["right"]
        if r == nil { err(ctx, "x64 native v0: prefix missing operand"); return nil }
        _expr_int_check(ctx, r)
        return nil
    }
    if t == "Index" {
        var l2 = expr["left"]
        var idx2 = expr["index"]
        if l2 == nil || idx2 == nil { err(ctx, "x64 native v0: index missing operands"); return nil }
        _expr_int_check(ctx, l2)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        _expr_int_check(ctx, idx2)
        return nil
    }
    if t == "Array" {
        var els = expr["elements"]
        if els == nil { return nil }
        var i = 0
        while i < oren_list_len(els) {
            _expr_int_check(ctx, els[i])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            i = i + 1
        }
        return nil
    }
    if t == "Hash" {
        var pairs = expr["pairs"]
        if pairs == nil { return nil }
        var i2 = 0
        while i2 < oren_list_len(pairs) {
            var pair = pairs[i2]
            if pair == nil { err(ctx, "x64 native v0: hash literal has nil pair"); return nil }
            _expr_int_check(ctx, pair["key"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            _expr_int_check(ctx, pair["value"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            i2 = i2 + 1
        }
        return nil
    }
    err(ctx, "x64 native v0: expr not supported: " + t)
    return nil
}

fn _max_call_argc_in_expr(expr) {
    if expr == nil { return 0 }
    var t = expr["type"]
    if t == "Nil" { return 0 }
    if t == "String" { return 0 }
    if t == "Call" {
        var args = expr["args"]
        var argc = 0
        if args != nil { argc = oren_list_len(args) }
        var m = argc
        // Count calls in call target and in each arg expression too.
        var fn_expr = expr["fn"]
        var mf = _max_call_argc_in_expr(fn_expr)
        if mf > m { m = mf }
        var i = 0
        while args != nil && i < oren_list_len(args) {
            var mi = _max_call_argc_in_expr(args[i])
            if mi > m { m = mi }
            i = i + 1
        }
        return m
    }
    if t == "Infix" {
        var l = expr["left"]
        var r = expr["right"]
        var ml = _max_call_argc_in_expr(l)
        var mr = _max_call_argc_in_expr(r)
        if mr > ml { return mr }
        return ml
    }
    if t == "Prefix" {
        return _max_call_argc_in_expr(expr["right"])
    }
    if t == "Index" {
        var ml = _max_call_argc_in_expr(expr["left"])
        var mi = _max_call_argc_in_expr(expr["index"])
        if mi > ml { return mi }
        return ml
    }
    if t == "Array" {
        var m = 0
        var els = expr["elements"]
        var i = 0
        while els != nil && i < oren_list_len(els) {
            var mi = _max_call_argc_in_expr(els[i])
            if mi > m { m = mi }
            i = i + 1
        }
        return m
    }
    if t == "Hash" {
        var m2 = 0
        var pairs = expr["pairs"]
        var i2 = 0
        while pairs != nil && i2 < oren_list_len(pairs) {
            var pair = pairs[i2]
            var mk = _max_call_argc_in_expr(pair["key"])
            if mk > m2 { m2 = mk }
            var mv = _max_call_argc_in_expr(pair["value"])
            if mv > m2 { m2 = mv }
            i2 = i2 + 1
        }
        return m2
    }
    if t == "If" {
        // Conservative: if-expr isn't part of the x64 v0 expression surface yet, but keep it safe.
        var m0 = _max_call_argc_in_expr(expr["cond"])
        var consq = expr["consq"]
        if consq != nil { var m1 = _max_call_argc_in_expr(consq["expr"]); if m1 > m0 { m0 = m1 } }
        var alt = expr["alt"]
        if alt != nil { var m2 = _max_call_argc_in_expr(alt["expr"]); if m2 > m0 { m0 = m2 } }
        return m0
    }
    return 0
}

fn _max_call_argc_in_ops(ops) {
    if ops == nil { return 0 }
    var m = 0
    var i = 0
    while i < oren_list_len(ops) {
        var op = ops[i]
        if op == nil { i = i + 1; continue }
        var k = op["op"]
        if k == "var_i32" || k == "assign_i32" || k == "return" || k == "expr" {
            var e = op["expr"]
            var me = _max_call_argc_in_expr(e)
            if me > m { m = me }
        } else if k == "if" {
            var mc = _max_call_argc_in_expr(op["cond"])
            if mc > m { m = mc }
            var mt = _max_call_argc_in_ops(op["then"])
            if mt > m { m = mt }
            var mf = _max_call_argc_in_ops(op["else"])
            if mf > m { m = mf }
        } else if k == "while" {
            var mc2 = _max_call_argc_in_expr(op["cond"])
            if mc2 > m { m = mc2 }
            var mb = _max_call_argc_in_ops(op["body"])
            if mb > m { m = mb }
        } else if k == "for" {
            var mi = _max_call_argc_in_ops(op["init"])
            if mi > m { m = mi }
            var mc3 = _max_call_argc_in_expr(op["cond"])
            if mc3 > m { m = mc3 }
            var mp = _max_call_argc_in_ops(op["post"])
            if mp > m { m = mp }
            var mb2 = _max_call_argc_in_ops(op["body"])
            if mb2 > m { m = mb2 }
        }
        i = i + 1
    }
    return m
}

// Compute the maximum intrinsic temp pool usage needed to compile expressions in this function.
//
// x64 native v0 uses a per-function `$tmp_intr<i>` pool as a re-entrant spill allocator for:
// - nested calls used as arguments
// - intrinsic implementations that must spill args (map/list ops, ptr_set, etc.)
//
// We must reserve enough `$tmp_intr<i>` stack slots to cover the maximum *nested* usage,
// but we should not over-reserve (large fixed pools bloat every stack frame and hurt recursion).
fn _intr_tmp_base_slots_for_call(nm, argc) {
    if nm == nil { return argc }
    // Intrinsics with custom spill needs.
    if nm == "iadd" { return 1 }
    if nm == "ptr_set" { return 1 }
    if nm == "ptr_set_byte" { return 1 }
    if nm == "oren_map_get" { return 2 }
    if nm == "oren_map_set" { return 7 }
    if nm == "oren_index_set" { return 7 }
    if nm == "oren_list_get" || nm == "oren_list_set" || nm == "oren_list_push" { return 2 }
    // Normal calls: spill all args.
    return argc
}

fn _max_intr_tmp_in_expr(expr) {
    if expr == nil { return 0 }
    var t = expr["type"]
    if t == "Nil" || t == "Boolean" || t == "Integer" || t == "String" || t == "Identifier" { return 0 }

    if t == "Call" {
        var fn_expr = expr["fn"]
        var args = expr["args"]
        var argc = 0
        if args != nil { argc = oren_list_len(args) }

        var nm = nil
        if fn_expr != nil && fn_expr["type"] == "Identifier" { nm = fn_expr["value"] }

        var base = _intr_tmp_base_slots_for_call(nm, argc)

        // While compiling this call, we keep `base` spill slots live across evaluation of each arg.
        // Args are evaluated LTR, so peak additional usage is the max over arg subexpressions.
        var max_child = 0
        var i = 0
        while args != nil && i < argc {
            var mi = _max_intr_tmp_in_expr(args[i])
            if mi > max_child { max_child = mi }
            i = i + 1
        }
        return base + max_child
    }

    if t == "Infix" {
        var ml = _max_intr_tmp_in_expr(expr["left"])
        var mr = _max_intr_tmp_in_expr(expr["right"])
        if mr > ml { return mr }
        return ml
    }

    if t == "Prefix" {
        return _max_intr_tmp_in_expr(expr["right"])
    }

    if t == "Index" {
        var ml2 = _max_intr_tmp_in_expr(expr["left"])
        var mi2 = _max_intr_tmp_in_expr(expr["index"])
        if mi2 > ml2 { return mi2 }
        return ml2
    }

    if t == "Array" {
        var m = 0
        var els = expr["elements"]
        var j = 0
        while els != nil && j < oren_list_len(els) {
            var mj = _max_intr_tmp_in_expr(els[j])
            if mj > m { m = mj }
            j = j + 1
        }
        return m
    }

    if t == "Hash" {
        var m2 = 0
        var pairs = expr["pairs"]
        var k = 0
        while pairs != nil && k < oren_list_len(pairs) {
            var pair = pairs[k]
            var mk = _max_intr_tmp_in_expr(pair["key"])
            if mk > m2 { m2 = mk }
            var mv = _max_intr_tmp_in_expr(pair["value"])
            if mv > m2 { m2 = mv }
            k = k + 1
        }
        return m2
    }

    if t == "If" {
        // Conservative: keep structure in sync with `_max_call_argc_in_expr`.
        var m0 = _max_intr_tmp_in_expr(expr["cond"])
        var consq = expr["consq"]
        if consq != nil { var m1 = _max_intr_tmp_in_expr(consq["expr"]); if m1 > m0 { m0 = m1 } }
        var alt = expr["alt"]
        if alt != nil { var m2 = _max_intr_tmp_in_expr(alt["expr"]); if m2 > m0 { m0 = m2 } }
        return m0
    }

    return 0
}

fn _max_intr_tmp_in_ops(ops) {
    if ops == nil { return 0 }
    var m = 0
    var i = 0
    while i < oren_list_len(ops) {
        var op = ops[i]
        if op == nil { i = i + 1; continue }
        var k = op["op"]
        if k == "var_i32" || k == "assign_i32" || k == "return" || k == "expr" {
            var e = op["expr"]
            var me = _max_intr_tmp_in_expr(e)
            if me > m { m = me }
        } else if k == "if" {
            var mc = _max_intr_tmp_in_expr(op["cond"])
            if mc > m { m = mc }
            var mt = _max_intr_tmp_in_ops(op["then"])
            if mt > m { m = mt }
            var mf = _max_intr_tmp_in_ops(op["else"])
            if mf > m { m = mf }
        } else if k == "while" {
            var mc2 = _max_intr_tmp_in_expr(op["cond"])
            if mc2 > m { m = mc2 }
            var mb = _max_intr_tmp_in_ops(op["body"])
            if mb > m { m = mb }
        } else if k == "for" {
            var mi = _max_intr_tmp_in_ops(op["init"])
            if mi > m { m = mi }
            var mc3 = _max_intr_tmp_in_expr(op["cond"])
            if mc3 > m { m = mc3 }
            var mp = _max_intr_tmp_in_ops(op["post"])
            if mp > m { m = mp }
            var mb2 = _max_intr_tmp_in_ops(op["body"])
            if mb2 > m { m = mb2 }
        }
        i = i + 1
    }
    return m
}
