// x64 native: expression validation and function-body normalization.
//
// Extracted into `lib/compiler/native_ops_v0.oren` as part of backend architecture
// unification work (Tier‑1: arm64 + x86_64). Keep thin wrappers here so the rest of
// the x64 backend can keep calling the legacy helper names.

fn _analyze_supported_fn_body(ctx, fn_node) { return nops.native_analyze_supported_fn_body(ctx, fn_node) }
fn _expr_int_check(ctx, expr, locals) { return nops.native_expr_int_check(ctx, expr, locals) }

// Additional helpers consumed by other x64 native modules.
fn _max_call_argc_in_ops(ctx, ops) { return nops._max_call_argc_in_ops(ctx, ops) }
fn _max_intr_tmp_in_ops(ctx, ops, locals) { return nops._max_intr_tmp_in_ops(ctx, ops, locals) }
fn _x64_is_syscall_intrinsic_name(nm) { return nops._x64_is_syscall_intrinsic_name(nm) }
