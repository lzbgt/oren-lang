// x86_64 native codegen (rolling; Tier-1 target).
//
// The x64 backend is brought up incrementally with focused fixtures to keep ABI
// details correct across:
// - Linux x86_64 SysV (ELF)
// - Windows x64 (PE32+, Win64 ABI)
//
// Future work (tracked in docs/STATUS.md):
// - full expression + statement lowering parity with arm64 backend
// - native runtime injection on x64 (print, malloc, syscalls, capsule gating)

import core "x64_core.oren"
import abi "native_abi.oren"
	import intparse "int_lit.oren"
			import callable "native_callable.oren"
			import coreir "coreir.oren"
			import bundle "native_runtime_bundle.oren"
			import rtobj "native_runtime_obj_cache.oren"
				import nt "native_toplevel.oren"
			import pprune "native_platform_prune.oren"
			import labi "x64_abi_linux.oren"
			import nstat "native_stat_abi.oren"
	import nops "native_ops_v0.oren"

fn _x64_program_phase_log_path() {
    var p = oren_env("OREN_TRACE_BUILD_PHASES_PATH")
    if p == nil || p == "" || p == "0" { return nil }
    return p
}

fn _x64_program_phase_log_append(path, phase, detail) {
    if path == nil || phase == nil || phase == "" { return nil }
    var line = "phase=" + phase + " now_ns=" + oren_int_to_string(oren_time_now_ns())
    if detail != nil && detail != "" { line = line + " " + detail }
    oren_append_file(path, line + "\n")
    return nil
}

fn bytes_new() { return core.bytes_new() }
fn bytes_push(b, v) { return core.bytes_push(b, v) }
fn bytes_extend(b, other) { return core.bytes_extend(b, other) }
fn bytes_extend_list(b, xs) { return core.bytes_extend_list(b, xs) }
fn bytes_extend_zeros(b, n) { return core.bytes_extend_zeros(b, n) }
fn bytes_extend_u8_buf(b, ubuf) { return core.bytes_extend_u8_buf(b, ubuf) }
fn bytes_extend_string(b, s) { return core.bytes_extend_string(b, s) }
fn bytes_extend_string_z(b, s) { return core.bytes_extend_string_z(b, s) }
fn bytes_len(b) { return core.bytes_len(b) }
fn bytes_finalize(b) { return core.bytes_finalize(b) }
fn push_u32_le(b, n) { return core.push_u32_le(b, n) }
fn push_u64_le(b, n) { return core.push_u64_le(b, n) }
fn set_u32_le(b, off, n) { return core.set_u32_le(b, off, n) }

fn _x64_add_rip_data32_fixup(ctx, disp_pos, data_label) {
    // Windows-only: `mov rax, [rip+disp32]` needs patching to point at an IAT slot in `.rdata`.
    //
    // PERF:
    // Avoid allocating a full fixup map per call site during program compilation (can be 1000s).
    // Instead, collect positions into a label->list<int> map.
    //
    if ctx == nil { return nil }
    if ctx["rip_data32_fixups"] == nil { ctx["rip_data32_fixups"] = {} }
    var m = ctx["rip_data32_fixups"]
    if m == nil { m = {}; ctx["rip_data32_fixups"] = m }
    var xs = m[data_label]
    if xs == nil { xs = []; m[data_label] = xs }
    oren_list_push(xs, disp_pos)
    return nil
}

fn err(ctx, msg) {
    // Keep diagnostics bounded: some codegen errors can trigger repeatedly in a single build,
    // and printing every occurrence can produce huge logs (and slow down CI/dev loops).
    //
    // We still preserve signal by:
    // - storing each distinct message once in ctx["errors"]
    // - counting repeats in ctx["_err_counts"] (for optional future reporting)
    if ctx["errors"] == nil { ctx["errors"] = [] }
    if ctx["_err_counts"] == nil { ctx["_err_counts"] = {} }
    if msg == nil { msg = "" }
    if ctx["_err_counts"][msg] == nil {
        ctx["_err_counts"][msg] = 1
        oren_list_push(ctx["errors"], msg)
        return nil
    }
    ctx["_err_counts"][msg] = ctx["_err_counts"][msg] + 1
    return nil
}

fn _x64_trim_trailing_underscores(s) {
    if s == nil { return "" }
    var end = oren_string_len(s)
    while end > 0 {
        if oren_string_char_at(s, end - 1) != "_" { break }
        end = end - 1
    }
    return oren_string_slice(s, 0, end)
}

// Resolve module/type namespace paths (import aliases + type namespaces) into
// flattened symbol names, matching the C-backend's `ns_resolve` convention.
//
// Examples:
// - `http.get` => `http_get` (if `http` is an import alias mapping to `http_`)
// - `math.PI`  => `math_PI`
// - returns nil if the expression is not a namespace path.
fn _x64_ns_resolve(ctx, exp) {
    if ctx == nil || exp == nil { return nil }
    var et = exp["type"]
    if et == "Identifier" {
        var name = exp["value"]
        if ctx["aliases"] != nil && ctx["aliases"][name] != nil { return {"name": ctx["aliases"][name], "is_ns": true} }
        if ctx["type_ns"] != nil {
            if ctx["type_ns"][name] == true { return {"name": name, "is_ns": true} }
        }
        return nil
    }
    if et == "Member" {
        var left = _x64_ns_resolve(ctx, exp["left"])
        if left == nil { return nil }
        if left["is_ns"] != true { return nil }
        var base = _x64_trim_trailing_underscores(left["name"])
        var prop = exp["prop"]
        if prop == nil || prop["type"] != "Identifier" { return nil }
        var name2 = base + "_" + prop["value"]
        var is_ns2 = false
        if ctx["type_ns"] != nil {
            if ctx["type_ns"][name2] == true { is_ns2 = true }
        }
        return {"name": name2, "is_ns": is_ns2}
    }
    return nil
}

fn _is_i8(n) {
    return n >= -128 && n <= 127
}

fn _as_u32_signed(disp) {
    // Encode a signed 32-bit displacement as the unsigned u32 value expected by push_u32_le.
    if disp < -2147483648 || disp > 2147483647 { return nil }
    if disp < 0 { return 4294967296 + disp }
    return disp
}

fn _emit_mov_r64_mrbp(ctx, dst_reg, disp) {
    // mov dst_reg, qword ptr [rbp+disp]
    if _is_i8(disp) {
        bytes_extend(ctx["code"], core.insn_mov_r64_mrbp_disp8(dst_reg, disp))
        return nil
    }
    var u = _as_u32_signed(disp)
    if u == nil {
        var fnm = "?"
        if ctx != nil && ctx["cur_fn_name"] != nil { fnm = ctx["cur_fn_name"] }
        err(ctx, "x64 native v0: rbp disp32 out of range fn=" + fnm + " disp=" + oren_int_to_string(disp))
        return nil
    }
    bytes_extend(ctx["code"], core.insn_mov_r64_mrbp_disp32(dst_reg, u))
    return nil
}

fn _emit_mov_mrbp_r64(ctx, disp, src_reg) {
    // mov qword ptr [rbp+disp], src_reg
    if _is_i8(disp) {
        bytes_extend(ctx["code"], core.insn_mov_mrbp_disp8_r64(disp, src_reg))
        return nil
    }
    var u = _as_u32_signed(disp)
    if u == nil {
        var fnm = "?"
        if ctx != nil && ctx["cur_fn_name"] != nil { fnm = ctx["cur_fn_name"] }
        err(ctx, "x64 native v0: rbp disp32 out of range fn=" + fnm + " disp=" + oren_int_to_string(disp))
        return nil
    }
    bytes_extend(ctx["code"], core.insn_mov_mrbp_disp32_r64(u, src_reg))
    return nil
}

fn _emit_mov_r64_mrsp(ctx, dst_reg, disp) {
    // mov dst_reg, qword ptr [rsp+disp]
    if _is_i8(disp) {
        bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp8(dst_reg, disp))
        return nil
    }
    var u = _as_u32_signed(disp)
    if u == nil { err(ctx, "x64 native v0: rsp disp32 out of range"); return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_mrsp_disp32(dst_reg, u))
    return nil
}

fn _emit_mov_mrsp_r64(ctx, disp, src_reg) {
    // mov qword ptr [rsp+disp], src_reg
    if _is_i8(disp) {
        bytes_extend(ctx["code"], core.insn_mov_mrsp_disp8_r64(disp, src_reg))
        return nil
    }
    var u = _as_u32_signed(disp)
    if u == nil { err(ctx, "x64 native v0: rsp disp32 out of range"); return nil }
    bytes_extend(ctx["code"], core.insn_mov_mrsp_disp32_r64(u, src_reg))
    return nil
}

fn _emit_addr_rbp_minus_off_x64(ctx, dst_reg, off) {
    // dst_reg = rbp - off
    // (Used for passing pointers to intrinsic-temp spill slots without mutating RSP.)
    if off == nil { err(ctx, "x64 native v0: addr calc missing off"); return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(dst_reg, 5))
    bytes_extend(ctx["code"], core.insn_sub_r64_imm32(dst_reg, off))
    return nil
}

fn _is_i32(n) { return n >= -2147483648 && n <= 2147483647 }
