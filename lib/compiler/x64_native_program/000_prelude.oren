fn err(ctx, msg) {
    if ctx["errors"] == nil { ctx["errors"] = [] }
    oren_list_push(ctx["errors"], msg)
}

fn _x64_trim_trailing_underscores(s) {
    if s == nil { return "" }
    var end = oren_string_len(s)
    while end > 0 {
        if oren_string_char_at(s, end - 1) != "_" { break }
        end = end - 1
    }
    return oren_string_slice(s, 0, end)
}

// Resolve module/type namespace paths (import aliases + type namespaces) into
// flattened symbol names, matching the C-backend's `ns_resolve` convention.
//
// Examples:
// - `http.get` => `http_get` (if `http` is an import alias mapping to `http_`)
// - `math.PI`  => `math_PI`
// - returns nil if the expression is not a namespace path.
fn _x64_ns_resolve(ctx, exp) {
    if ctx == nil || exp == nil { return nil }
    var et = exp["type"]
    if et == "Identifier" {
        var name = exp["value"]
        if ctx["aliases"] != nil && ctx["aliases"][name] != nil { return {"name": ctx["aliases"][name], "is_ns": true} }
        if ctx["type_ns"] != nil {
            if ctx["type_ns"][name] == true { return {"name": name, "is_ns": true} }
        }
        return nil
    }
    if et == "Member" {
        var left = _x64_ns_resolve(ctx, exp["left"])
        if left == nil { return nil }
        if left["is_ns"] != true { return nil }
        var base = _x64_trim_trailing_underscores(left["name"])
        var prop = exp["prop"]
        if prop == nil || prop["type"] != "Identifier" { return nil }
        var name2 = base + "_" + prop["value"]
        var is_ns2 = false
        if ctx["type_ns"] != nil {
            if ctx["type_ns"][name2] == true { is_ns2 = true }
        }
        return {"name": name2, "is_ns": is_ns2}
    }
    return nil
}

fn _is_i8(n) {
    return n >= -128 && n <= 127
}

fn _as_u32_signed(disp) {
    // Encode a signed 32-bit displacement as the unsigned u32 value expected by push_u32_le.
    if disp < -2147483648 || disp > 2147483647 { return nil }
    if disp < 0 { return 4294967296 + disp }
    return disp
}

fn _emit_mov_r64_mrbp(ctx, dst_reg, disp) {
    // mov dst_reg, qword ptr [rbp+disp]
    if _is_i8(disp) {
        bytes_extend(ctx["code"], insn_mov_r64_mrbp_disp8(dst_reg, disp))
        return nil
    }
    var u = _as_u32_signed(disp)
    if u == nil { err(ctx, "x64 native v0: rbp disp32 out of range"); return nil }
    bytes_extend(ctx["code"], insn_mov_r64_mrbp_disp32(dst_reg, u))
    return nil
}

fn _emit_mov_mrbp_r64(ctx, disp, src_reg) {
    // mov qword ptr [rbp+disp], src_reg
    if _is_i8(disp) {
        bytes_extend(ctx["code"], insn_mov_mrbp_disp8_r64(disp, src_reg))
        return nil
    }
    var u = _as_u32_signed(disp)
    if u == nil { err(ctx, "x64 native v0: rbp disp32 out of range"); return nil }
    bytes_extend(ctx["code"], insn_mov_mrbp_disp32_r64(u, src_reg))
    return nil
}

fn _emit_mov_r64_mrsp(ctx, dst_reg, disp) {
    // mov dst_reg, qword ptr [rsp+disp]
    if _is_i8(disp) {
        bytes_extend(ctx["code"], insn_mov_r64_mrsp_disp8(dst_reg, disp))
        return nil
    }
    var u = _as_u32_signed(disp)
    if u == nil { err(ctx, "x64 native v0: rsp disp32 out of range"); return nil }
    bytes_extend(ctx["code"], insn_mov_r64_mrsp_disp32(dst_reg, u))
    return nil
}

fn _emit_mov_mrsp_r64(ctx, disp, src_reg) {
    // mov qword ptr [rsp+disp], src_reg
    if _is_i8(disp) {
        bytes_extend(ctx["code"], insn_mov_mrsp_disp8_r64(disp, src_reg))
        return nil
    }
    var u = _as_u32_signed(disp)
    if u == nil { err(ctx, "x64 native v0: rsp disp32 out of range"); return nil }
    bytes_extend(ctx["code"], insn_mov_mrsp_disp32_r64(u, src_reg))
    return nil
}

fn _is_i32(n) { return n >= -2147483648 && n <= 2147483647 }
