// x64-native Index expression lowering.
//
// Extracted from `040_emit_expr.oren` to keep the main emitter file reviewable and under
// the repo style ceiling, and to make the nested-spill invariants explicit.

fn _emit_call_rel32_2args_x64(ctx, locals, sym, arg0_off, arg1_off) {
    var a0 = abi.int_arg_reg(ctx["abi"], 0)
    var a1 = abi.int_arg_reg(ctx["abi"], 1)
    if a0 == nil || a1 == nil {
        err(ctx, "x64 native v0: missing ABI arg regs for call2 " + sym)
        return nil
    }
    _emit_mov_r64_mrbp(ctx, a0, 0 - arg0_off)
    _emit_mov_r64_mrbp(ctx, a1, 0 - arg1_off)
    var call_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": sym})
    return nil
}

fn _emit_index_expr_v0(ctx, expr, locals) {
    // Index expression `xs[i]`.
    //
    // In rolling Tier‑1, `Index` is polymorphic over list + map.
    if expr == nil { err(ctx, "x64 native v0: missing index expr"); return nil }
    var left = expr["left"]
    var idx = expr["index"]
    if left == nil || idx == nil { err(ctx, "x64 native v0: index missing operands"); return nil }

    // Best-effort kind hint from the shared lowering pass.
    // When present, we still validate the runtime magic and abort(1) on mismatch
    // to avoid silent miscompilations if inference is wrong.
    var recv_kind = expr["recv_kind"]

    // Tier‑1 convergence: map indexing is implemented via the injected native runtime.
    //
    // This aligns x86_64 with arm64 (single semantics set) and avoids duplicating container
    // logic inside x64-only intrinsics.
    if ctx == nil || ctx["runtime_injected"] != true {
        err(ctx, "x64 native v0: internal error: native runtime bundle missing (required for Index semantics)")
        return nil
    }

    // Use the intrinsic temp pool for re-entrancy:
    // - container and idx subexpressions may themselves contain Index/Call nodes that need spills
    // - using a fixed `$tmp0` slot here breaks expressions like `xs[ys[0]]`
    var base0 = _intr_tmp_push(ctx, 2)
    if base0 == nil { return nil }
    var tmp0 = _intr_tmp_off(ctx, locals, base0 + 0)      // container
    var tmp_idx = _intr_tmp_off(ctx, locals, base0 + 1)   // index/key
    if tmp0 == nil || tmp_idx == nil { _intr_tmp_pop(ctx, base0); return nil }

    // Eval container -> rax; spill
    _emit_eval_int_to_rax(ctx, left, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base0); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp0, 0)

    // Eval index -> rax; spill
    _emit_eval_int_to_rax(ctx, idx, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base0); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_idx, 0)

    // list -> rdx
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp0)

    // If container is nil, panic deterministically.
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(2, 0))
    var labels = {}
    var local_fixups = []
    var l_list_ok = _new_label(ctx, "idx_list_non_nil")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_list_ok)
    _emit_abort_panic_str(ctx, "Indexing on nil")
    _emit_label(ctx, labels, l_list_ok)

    // Tier‑1 safety: never read object headers from untracked pointers.
    //
    // In the native v0 carrier model, "ints" and pointers share the same i64 representation.
    // Therefore, we must only treat `container` as a list/map pointer if it is tracked.
    _emit_find_tracked_node_x64(ctx, 2, 11) // r11 = node or 0
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base0); return nil }

    // r11 != 0 (tracked) ?
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(11, 0))
    var l_is_list = _new_label(ctx, "idx_is_list")
    var l_is_map = _new_label(ctx, "idx_is_map")
    var l_idx_done = _new_label(ctx, "idx_done")

    if recv_kind == "list" {
        var l_trk_ok = _new_label(ctx, "idx_list_tracked_ok")
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_trk_ok)
        _emit_abort_panic_str(ctx, "Index recv_kind=list but value is not a list")
        _emit_label(ctx, labels, l_trk_ok)

        // kind = *(node + 16)
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 10))
        // kind == 2 (LIST)
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 2))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_is_list)
        _emit_abort_panic_str(ctx, "Index recv_kind=list but value is not a list")
    } else if recv_kind == "map" {
        var l_trk_ok2 = _new_label(ctx, "idx_map_tracked_ok")
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_trk_ok2)
        _emit_abort_panic_str(ctx, "Index recv_kind=map but value is not a map")
        _emit_label(ctx, labels, l_trk_ok2)

        // kind = *(node + 16)
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 10))
        // kind == 3 (MAP)
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 3))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_is_map)
        _emit_abort_panic_str(ctx, "Index recv_kind=map but value is not a map")
    } else {
        // Unknown at compile-time => dynamic kind check (LIST or MAP).
        var l_trk_ok3 = _new_label(ctx, "idx_tracked_ok")
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_trk_ok3)
        _emit_abort_panic_str(ctx, "Indexing on non-container (expected list or map)")
        _emit_label(ctx, labels, l_trk_ok3)

        // kind = *(node + 16)
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], insn_mov_r64_mr64(10, 10))

        // kind == 2 => list, kind == 3 => map
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 2))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_is_list)
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(10, 3))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_is_map)
        _emit_abort_panic_str(ctx, "Indexing on non-container (expected list or map)")
    }

    // --- list indexing path ---
    _emit_label(ctx, labels, l_is_list)
    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_idx) // rcx = idx

    // Tier-1 parity: validate list magic (matches native runtime + arm64).
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1279870019)) // list_magic()
    var l_magic_ok = _new_label(ctx, "idx_list_magic_ok")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_magic_ok)
    _emit_abort_panic_str(ctx, "Indexing on non-list")
    _emit_label(ctx, labels, l_magic_ok)

    // load count -> r8
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(8, 0))

    // idx >= 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(1, 0))
    var l_idx_nonneg = _new_label(ctx, "idx_nonneg")
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_idx_nonneg)
    _emit_abort_panic_str(ctx, "Index out of bounds (negative)")
    _emit_label(ctx, labels, l_idx_nonneg)

    // idx < count
    bytes_extend(ctx["code"], insn_cmp_r64_r64(1, 8))
    var l_inbounds = _new_label(ctx, "idx_inbounds")
    _emit_jcc_to_label(ctx, local_fixups, "l", l_inbounds)
    _emit_abort_panic_str(ctx, "Index out of bounds")
    _emit_label(ctx, labels, l_inbounds)

    // buf -> r9 = *(list+16)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())
    bytes_extend(ctx["code"], insn_mov_r64_r64(9, 0))

    // buf != 0
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(9, 0))
    var l_buf_ok = _new_label(ctx, "idx_buf_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_buf_ok)
    _emit_abort_panic_str(ctx, "list buffer is nil")
    _emit_label(ctx, labels, l_buf_ok)

    // addr = buf + idx*8  (r10)
    bytes_extend(ctx["code"], insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], insn_shl_r64_imm8(10, 3))
    bytes_extend(ctx["code"], insn_add_r64_r64(10, 9))

    // load *(addr) into rax
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], insn_mov_rax_mrax())

    _emit_jmp_to_label(ctx, local_fixups, l_idx_done)

    // --- map indexing path ---
    _emit_label(ctx, labels, l_is_map)
    // If shared lowering inferred this is a map, validate magic deterministically.
    // (Tier‑1 parity with arm64; avoids silent miscompilations if inference is wrong.)
    if recv_kind == "map" {
        bytes_extend(ctx["code"], insn_mov_r64_r64(10, 2))
        bytes_extend(ctx["code"], insn_add_r64_imm32(10, 24))
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], insn_mov_rax_mrax()) // rax = magic
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 1296121168)) // map_magic()
        var l_magic_ok = _new_label(ctx, "idx_map_magic_ok")
        _emit_jcc_to_label(ctx, local_fixups, "e", l_magic_ok)
        _emit_abort_panic_str(ctx, "Index recv_kind=map but value is not a map")
        _emit_label(ctx, labels, l_magic_ok)
    }
    // Runtime-injected path: call typed helpers `oren_map_get_{int,str}`.
    //
    // Note: for dynamic keys, we infer key kind using the same tracking contract as the
    // native runtime (strings are tracked kind=1), then dispatch to the typed helper.
    var known_kk = -1
    if expr["known_key_kind"] != nil { known_kk = expr["known_key_kind"] }
    if known_kk < 0 {
        if idx["type"] == "Integer" { known_kk = 0 }
        else if idx["type"] == "String" { known_kk = 1 }
    }

    if known_kk == 0 {
        _emit_call_rel32_2args_x64(ctx, locals, "oren_map_get_int", tmp0, tmp_idx)
        _emit_jmp_to_label(ctx, local_fixups, l_idx_done)
    } else if known_kk == 1 {
        _emit_call_rel32_2args_x64(ctx, locals, "oren_map_get_str", tmp0, tmp_idx)
        _emit_jmp_to_label(ctx, local_fixups, l_idx_done)
    } else {
        // Dynamic map get: delegate key-kind selection to the injected runtime helper.
        _emit_call_rel32_2args_x64(ctx, locals, "oren_map_get", tmp0, tmp_idx)
        _emit_jmp_to_label(ctx, local_fixups, l_idx_done)
    }

    _emit_label(ctx, labels, l_idx_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    _intr_tmp_pop(ctx, base0)
    return nil
}
