// x64-native Index expression lowering.
//
// Extracted from `040_emit_expr.oren` to keep the main emitter file reviewable and under
// the repo style ceiling, and to make the nested-spill invariants explicit.

fn _emit_call_rel32_2args_x64(ctx, locals, sym, arg0_off, arg1_off) {
    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    var a1_enc = abi.int_arg_reg(ctx["abi"], 1)
    if oren_type_tag(a0_enc) == 0 || oren_type_tag(a1_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg regs for call2 " + sym)
        return nil
    }
    var a0 = a0_enc - 1
    var a1 = a1_enc - 1
    _emit_mov_r64_mrbp(ctx, a0, 0 - arg0_off)
    _emit_mov_r64_mrbp(ctx, a1, 0 - arg1_off)
    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": sym})
    return nil
}

var g_native_assume_list_index = -1

fn _native_assume_list_index_enabled() {
    if g_native_assume_list_index != -1 { return g_native_assume_list_index == 1 }
    var v = oren_env("OREN_NATIVE_ASSUME_LIST_INDEX")
    if v != nil && v != "" && v != "0" { g_native_assume_list_index = 1 } else { g_native_assume_list_index = 0 }
    return g_native_assume_list_index == 1
}

fn _x64_index_known_key_kind(expr, idx) {
    var known_kk = -1
    if expr != nil && expr["known_key_kind"] != nil { known_kk = expr["known_key_kind"] }
    if known_kk < 0 && idx != nil {
        if idx["type"] == "Integer" { known_kk = 0 }
        else if idx["type"] == "String" { known_kk = 1 }
    }
    return known_kk
}

fn _x64_index_prepare_operands(ctx, expr) {
    if expr == nil { err(ctx, "x64 native v0: missing index expr"); return nil }
    var left = expr["left"]
    var idx = expr["index"]
    if left == nil || idx == nil { err(ctx, "x64 native v0: index missing operands"); return nil }
    return {"left": left, "idx": idx}
}

fn _x64_index_require_runtime(ctx) {
    // Tier-1 convergence: map indexing is implemented via the injected native runtime.
    //
    // This aligns x86_64 with arm64 (single semantics set) and avoids duplicating container
    // logic inside x64-only intrinsics.
    if ctx != nil && ctx["runtime_injected"] == true { return true }
    err(ctx, "x64 native v0: internal error: native runtime bundle missing (required for Index semantics)")
    return false
}

fn _x64_index_temp_state(ctx, locals) {
    // Use the intrinsic temp pool for re-entrancy:
    // - container and idx subexpressions may themselves contain Index/Call nodes that need spills
    // - using a fixed `$tmp0` slot here breaks expressions like `xs[ys[0]]`
    var base0 = _intr_tmp_push(ctx, 2)
    if oren_type_tag(base0) == 0 { return nil }
    var tmp0 = _intr_tmp_off(ctx, locals, base0 + 0)      // container
    var tmp_idx = _intr_tmp_off(ctx, locals, base0 + 1)   // index/key
    if oren_type_tag(tmp0) == 0 || oren_type_tag(tmp_idx) == 0 { _intr_tmp_pop(ctx, base0); return nil }
    return {"base": base0, "tmp0": tmp0, "tmp_idx": tmp_idx}
}

fn _x64_index_spill_operands(ctx, locals, operands, st) {
    // Eval container -> rax; spill
    _emit_eval_int_to_rax(ctx, operands["left"], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    _emit_mov_mrbp_r64(ctx, 0 - st["tmp0"], 0)

    // Eval index -> rax; spill
    _emit_eval_int_to_rax(ctx, operands["idx"], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    _emit_mov_mrbp_r64(ctx, 0 - st["tmp_idx"], 0)
    return true
}

fn _x64_index_pack_prepare(expr, operands, st) {
    var known_kk = _x64_index_known_key_kind(expr, operands["idx"])
    return {
        "recv_kind": expr["recv_kind"],
        "known_kk": known_kk,
        "tmp0": st["tmp0"],
        "tmp_idx": st["tmp_idx"],
        "base": st["base"]
    }
}

fn _x64_index_prepare(ctx, expr, locals) {
    // Best-effort kind hint from the shared lowering pass.
    // When present, we still validate the runtime magic and abort(1) on mismatch
    // to avoid silent miscompilations if inference is wrong.
    var operands = _x64_index_prepare_operands(ctx, expr)
    if operands == nil { return nil }
    if _x64_index_require_runtime(ctx) != true { return nil }

    var st = _x64_index_temp_state(ctx, locals)
    if st == nil { return nil }
    if _x64_index_spill_operands(ctx, locals, operands, st) != true {
        _intr_tmp_pop(ctx, st["base"])
        return nil
    }

    return _x64_index_pack_prepare(expr, operands, st)
}

fn _x64_index_emit_runtime_fast(ctx, locals, recv_kind, known_kk, tmp0, tmp_idx, base0) {
    // String-key indexing and lowered map gets cannot reach list semantics. Delegate
    // checked map validation to the runtime instead of emitting the same tracking,
    // kind, magic, and panic sequence at every compiler AST access site.
    if recv_kind == "map" || known_kk == 1 {
        if known_kk == 0 {
            _emit_call_rel32_2args_x64(ctx, locals, "oren_map_get_int_checked", tmp0, tmp_idx)
        } else if known_kk == 1 {
            _emit_call_rel32_2args_x64(ctx, locals, "oren_map_get_str_checked", tmp0, tmp_idx)
        } else {
            _emit_call_rel32_2args_x64(ctx, locals, "oren_map_get_checked", tmp0, tmp_idx)
        }
        _intr_tmp_pop(ctx, base0)
        return true
    }

    // Unknown receiver kinds are common in self-hosted compiler helpers where
    // map/list evidence is parameter-local. Call the checked generic runtime
    // helper instead of compiling the full dynamic list+map dispatch at every
    // access site.
    if recv_kind != "list" && recv_kind != "list_int" {
        _emit_call_rel32_2args_x64(ctx, locals, "oren_index_get", tmp0, tmp_idx)
        _intr_tmp_pop(ctx, base0)
        return true
    }

    return false
}

fn _x64_index_emit_assume_list_fast(ctx, labels, local_fixups, tmp_idx, l_idx_done) {
    // rcx = idx
    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_idx)
    _x64_index_emit_list_buffer_load(ctx)
    _x64_index_emit_list_value_load(ctx)
    _emit_jmp_to_label(ctx, local_fixups, l_idx_done)
    return nil
}

fn _x64_index_emit_list_magic_check(ctx, labels, local_fixups) {
    // Tier-1 parity: validate list magic (matches native runtime + arm64).
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 24))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 1279870019)) // list_magic()
    var l_magic_ok = _new_label(ctx, "idx_list_magic_ok")
    _emit_jcc_to_label(ctx, local_fixups, "e", l_magic_ok)
    _emit_abort_panic_str(ctx, "Indexing on non-list")
    _emit_label(ctx, labels, l_magic_ok)
    return nil
}

fn _x64_index_emit_list_count_to_r8(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 2))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(8, 0))
    return nil
}

fn _x64_index_emit_list_bounds_check(ctx, labels, local_fixups) {
    _x64_index_emit_list_count_to_r8(ctx)

    // idx >= 0
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(1, 0))
    var l_idx_nonneg = _new_label(ctx, "idx_nonneg")
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_idx_nonneg)
    _emit_abort_panic_str(ctx, "Index out of bounds (negative)")
    _emit_label(ctx, labels, l_idx_nonneg)

    // idx < count
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(1, 8))
    var l_inbounds = _new_label(ctx, "idx_inbounds")
    _emit_jcc_to_label(ctx, local_fixups, "l", l_inbounds)
    _emit_abort_panic_str(ctx, "Index out of bounds")
    _emit_label(ctx, labels, l_inbounds)
    return nil
}

fn _x64_index_emit_list_buffer_load(ctx) {
    // r9 = *(list + 16)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 2))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(9, 0))
    return nil
}

fn _x64_index_emit_list_buffer_check(ctx, labels, local_fixups) {
    _x64_index_emit_list_buffer_load(ctx)

    // buf != 0
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(9, 0))
    var l_buf_ok = _new_label(ctx, "idx_buf_ok")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_buf_ok)
    _emit_abort_panic_str(ctx, "list buffer is nil")
    _emit_label(ctx, labels, l_buf_ok)
    return nil
}

fn _x64_index_emit_list_value_load(ctx) {
    // addr = buf + idx*8 (r10)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 1))
    bytes_extend(ctx["code"], core.insn_shl_r64_imm8(10, 3))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(10, 9))

    // load *(addr) into rax
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    return nil
}

fn _x64_index_emit_tracked_lookup(ctx, tmp0, base0) {
    // Tier‑1 safety: never read object headers from untracked pointers.
    //
    // In the native v0 carrier model, "ints" and pointers share the same i64 representation.
    // Therefore, we must only treat `container` as a list/map pointer if it is tracked.
    _emit_find_tracked_node_x64(ctx, 2, 11) // r11 = node or 0
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base0); return nil }
    // NOTE: `_emit_find_tracked_node_x64` calls into the injected runtime (native_alloc_index_get),
    // so treat all caller-saved registers as clobbered. Reload the container pointer from the
    // spill slot before reading headers.
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp0)
    return true
}

fn _x64_index_emit_tracked_guard(ctx, labels, local_fixups, label_name, panic_msg) {
    // r11 != 0 (tracked) ?
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
    var l_trk_ok = _new_label(ctx, label_name)
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_trk_ok)
    _emit_abort_panic_str(ctx, panic_msg)
    _emit_label(ctx, labels, l_trk_ok)
    return nil
}

fn _x64_index_emit_node_kind_load(ctx) {
    // kind = *(node + 16)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 11))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(10, 10))
    return nil
}

fn _x64_index_emit_known_list_dispatch(ctx, labels, local_fixups, l_is_list) {
    _x64_index_emit_tracked_guard(ctx, labels, local_fixups, "idx_list_tracked_ok", "Index recv_kind=list but value is not a list")
    _x64_index_emit_node_kind_load(ctx)
    // kind == 2 (LIST) || kind == 8 (LIST_INT)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 2))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_list)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 8))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_list)
    _emit_abort_panic_str(ctx, "Index recv_kind=list but value is not a list")
    return nil
}

fn _x64_index_emit_known_list_int_dispatch(ctx, labels, local_fixups, l_is_list) {
    _x64_index_emit_tracked_guard(ctx, labels, local_fixups, "idx_list_int_tracked_ok", "Index recv_kind=list_int but value is not a list_int")
    _x64_index_emit_node_kind_load(ctx)
    // kind == 8 (LIST_INT)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 8))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_list)
    _emit_abort_panic_str(ctx, "Index recv_kind=list_int but value is not a list_int")
    return nil
}

fn _x64_index_emit_known_map_dispatch(ctx, labels, local_fixups, l_is_map) {
    _x64_index_emit_tracked_guard(ctx, labels, local_fixups, "idx_map_tracked_ok", "Index recv_kind=map but value is not a map")
    _x64_index_emit_node_kind_load(ctx)
    // kind == 3 (MAP)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 3))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_map)
    _emit_abort_panic_str(ctx, "Index recv_kind=map but value is not a map")
    return nil
}

fn _x64_index_emit_dynamic_kind_dispatch(ctx, labels, local_fixups, l_is_list, l_is_map) {
    _x64_index_emit_tracked_guard(ctx, labels, local_fixups, "idx_tracked_ok", "Indexing on non-container (expected list or map)")
    _x64_index_emit_node_kind_load(ctx)
    // kind == 2/8 => list, kind == 3 => map
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 2))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_list)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 8))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_list)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 3))
    _emit_jcc_to_label(ctx, local_fixups, "e", l_is_map)
    _emit_abort_panic_str(ctx, "Indexing on non-container (expected list or map)")
    return nil
}

fn _x64_index_emit_kind_dispatch(ctx, recv_kind, tmp0, base0, labels, local_fixups, l_is_list, l_is_map) {
    if _x64_index_emit_tracked_lookup(ctx, tmp0, base0) != true { return nil }
    if recv_kind == "list" { return _x64_index_emit_known_list_dispatch(ctx, labels, local_fixups, l_is_list) }
    if recv_kind == "list_int" { return _x64_index_emit_known_list_int_dispatch(ctx, labels, local_fixups, l_is_list) }
    if recv_kind == "map" { return _x64_index_emit_known_map_dispatch(ctx, labels, local_fixups, l_is_map) }
    _x64_index_emit_dynamic_kind_dispatch(ctx, labels, local_fixups, l_is_list, l_is_map)
    return nil
}

fn _x64_index_emit_list_path(ctx, tmp_idx, labels, local_fixups, l_is_list, l_idx_done) {
    // --- list indexing path ---
    _emit_label(ctx, labels, l_is_list)
    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_idx) // rcx = idx

    _x64_index_emit_list_magic_check(ctx, labels, local_fixups)
    _x64_index_emit_list_bounds_check(ctx, labels, local_fixups)
    _x64_index_emit_list_buffer_check(ctx, labels, local_fixups)
    _x64_index_emit_list_value_load(ctx)
    _emit_jmp_to_label(ctx, local_fixups, l_idx_done)
    return nil
}

fn _x64_index_emit_map_path(ctx, locals, recv_kind, known_kk, tmp0, tmp_idx, labels, local_fixups, l_is_map, l_idx_done) {
    // --- map indexing path ---
    _emit_label(ctx, labels, l_is_map)
    // If shared lowering inferred this is a map, validate magic deterministically.
    // (Tier‑1 parity with arm64; avoids silent miscompilations if inference is wrong.)
    if recv_kind == "map" {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 2))
        bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 24))
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], core.insn_mov_rax_mrax()) // rax = magic
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 1296121168)) // map_magic()
        var l_magic_ok = _new_label(ctx, "idx_map_magic_ok")
        _emit_jcc_to_label(ctx, local_fixups, "e", l_magic_ok)
        _emit_abort_panic_str(ctx, "Index recv_kind=map but value is not a map")
        _emit_label(ctx, labels, l_magic_ok)
    }
    // Runtime-injected path: call typed helpers `oren_map_get_{int,str}`.
    //
    // Note: for dynamic keys, we infer key kind using the same tracking contract as the
    // native runtime (strings are tracked kind=1), then dispatch to the typed helper.
    if known_kk == 0 {
        _emit_call_rel32_2args_x64(ctx, locals, "oren_map_get_int", tmp0, tmp_idx)
        _emit_jmp_to_label(ctx, local_fixups, l_idx_done)
    } else if known_kk == 1 {
        _emit_call_rel32_2args_x64(ctx, locals, "oren_map_get_str", tmp0, tmp_idx)
        _emit_jmp_to_label(ctx, local_fixups, l_idx_done)
    } else {
        // Dynamic map get: delegate key-kind selection to the injected runtime helper.
        _emit_call_rel32_2args_x64(ctx, locals, "oren_map_get", tmp0, tmp_idx)
        _emit_jmp_to_label(ctx, local_fixups, l_idx_done)
    }
    return nil
}

fn _x64_index_dynamic_labels(ctx) {
    return {
        "labels": {},
        "local_fixups": [],
        "l_is_list": _new_label(ctx, "idx_is_list"),
        "l_is_map": _new_label(ctx, "idx_is_map"),
        "l_idx_done": _new_label(ctx, "idx_done")
    }
}

fn _x64_index_emit_nil_guard(ctx, tmp0, labels, local_fixups) {
    // list -> rdx
    _emit_mov_r64_mrbp(ctx, 2, 0 - tmp0)

    // If container is nil, panic deterministically.
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(2, 0))
    var l_list_ok = _new_label(ctx, "idx_list_non_nil")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_list_ok)
    _emit_abort_panic_str(ctx, "Indexing on nil")
    _emit_label(ctx, labels, l_list_ok)
    return nil
}

fn _x64_index_emit_assume_list_if_enabled(ctx, recv_kind, tmp_idx, labels, local_fixups, l_idx_done) {
    if (recv_kind == "list" || recv_kind == "list_int") && _native_assume_list_index_enabled() == true {
        _x64_index_emit_assume_list_fast(ctx, labels, local_fixups, tmp_idx, l_idx_done)
    }
    return nil
}

fn _x64_index_emit_dynamic_paths(ctx, locals, recv_kind, known_kk, tmp0, tmp_idx, base0, state) {
    var labels = state["labels"]
    var local_fixups = state["local_fixups"]
    var l_is_list = state["l_is_list"]
    var l_is_map = state["l_is_map"]
    var l_idx_done = state["l_idx_done"]

    _x64_index_emit_kind_dispatch(ctx, recv_kind, tmp0, base0, labels, local_fixups, l_is_list, l_is_map)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return false }
    _x64_index_emit_list_path(ctx, tmp_idx, labels, local_fixups, l_is_list, l_idx_done)
    _x64_index_emit_map_path(ctx, locals, recv_kind, known_kk, tmp0, tmp_idx, labels, local_fixups, l_is_map, l_idx_done)
    return true
}

fn _emit_index_expr_v0(ctx, expr, locals) {
    // Index expression `xs[i]`.
    //
    // In rolling Tier‑1, `Index` is polymorphic over list + map.
    var prep = _x64_index_prepare(ctx, expr, locals)
    if prep == nil { return nil }
    var recv_kind = prep["recv_kind"]
    var known_kk = prep["known_kk"]
    var tmp0 = prep["tmp0"]
    var tmp_idx = prep["tmp_idx"]
    var base0 = prep["base"]

    if _x64_index_emit_runtime_fast(ctx, locals, recv_kind, known_kk, tmp0, tmp_idx, base0) != false { return nil }

    var dyn = _x64_index_dynamic_labels(ctx)
    _x64_index_emit_nil_guard(ctx, tmp0, dyn["labels"], dyn["local_fixups"])
    _x64_index_emit_assume_list_if_enabled(ctx, recv_kind, tmp_idx, dyn["labels"], dyn["local_fixups"], dyn["l_idx_done"])
    if _x64_index_emit_dynamic_paths(ctx, locals, recv_kind, known_kk, tmp0, tmp_idx, base0, dyn) != true { return nil }

    _emit_label(ctx, dyn["labels"], dyn["l_idx_done"])
    _patch_local_fixups(ctx, dyn["labels"], dyn["local_fixups"])
    _intr_tmp_pop(ctx, base0)
    return nil
}
