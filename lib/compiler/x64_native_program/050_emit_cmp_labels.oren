fn _x64_cmp_spill_offsets(ctx, locals) {
    if ctx == nil { return nil }
    if locals == nil { err(ctx, "x64 native v0: missing locals"); return nil }
    var off_l = locals["$tmp_cmp"]
    var off_r = locals["$tmp0"]
    if oren_type_tag(off_l) != 1 { off_l = 0 }
    if oren_type_tag(off_r) != 1 { off_r = 0 }
    if off_l <= 0 || off_r <= 0 {
        err(ctx, "x64 native v0: missing spill slots for string-aware compare")
        return nil
    }
    return {"left": off_l, "right": off_r}
}

fn _x64_emit_cmp_small_int_fast_path(ctx, fixups, off_l, off_r, l_int) {
    // Fast path: if either operand is a small integer (<4096 in the native v0 model),
    // it cannot be a tracked heap string. Skip the tracking scan in that case.
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_l) // rax = lhs
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 4096))
    _emit_jcc_to_label(ctx, fixups, "l", l_int)
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_r) // rax = rhs
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 4096))
    _emit_jcc_to_label(ctx, fixups, "l", l_int)
    return nil
}

fn _x64_emit_cmp_string_ptr_check_one(ctx, fixups, off, a0, l_int) {
    _emit_mov_r64_mrbp(ctx, 8, 0 - off)
    if a0 != 8 { bytes_extend(ctx["code"], core.insn_mov_r64_r64(a0, 8)) }
    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "native_is_string_ptr"})
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_int)
    return nil
}

fn _x64_emit_cmp_string_ptr_checks(ctx, fixups, off_l, off_r, l_int, l_str) {
    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    if oren_type_tag(a0_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg reg for native_is_string_ptr")
        return nil
    }
    var a0 = a0_enc - 1

    // Check lhs/rhs are string pointers (tracked heap strings OR embedded cstr0 literals).
    _x64_emit_cmp_string_ptr_check_one(ctx, fixups, off_l, a0, l_int)
    // Check rhs is a string pointer (tracked heap string OR embedded cstr0 literal).
    _x64_emit_cmp_string_ptr_check_one(ctx, fixups, off_r, a0, l_int)

    // Both are strings.
    _emit_jmp_to_label(ctx, fixups, l_str)
    return nil
}

fn _x64_cmp_string_labels(ctx, l_done) {
    return {
        "loop": _new_label(ctx, "cmp_str_loop"),
        "b1_nz": _new_label(ctx, "cmp_str_b1_nz"),
        "ret_m1": _new_label(ctx, "cmp_str_ret_m1"),
        "ret_0": _new_label(ctx, "cmp_str_ret_0"),
        "ret_p1": _new_label(ctx, "cmp_str_ret_p1"),
        "done": l_done
    }
}

fn _x64_emit_cmp_string_cursor_setup(ctx, off_l, off_r) {
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_l) // r10 = s1 cursor
    _emit_mov_r64_mrbp(ctx, 11, 0 - off_r) // r11 = s2 cursor
    return nil
}

fn _x64_emit_cmp_string_load_bytes(ctx) {
    // r8d = *s1 ; r9d = *s2
    bytes_extend(ctx["code"], core.insn_movzx_r32_mr8(8, 10))
    bytes_extend(ctx["code"], core.insn_movzx_r32_mr8(9, 11))
    return nil
}

fn _x64_emit_cmp_string_zero_cases(ctx, labels, names, fixups) {
    // b1 == 0: b2 == 0 => 0, otherwise -1.
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(8, 0))
    _emit_jcc_to_label(ctx, fixups, "ne", names["b1_nz"])
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(9, 0))
    _emit_jcc_to_label(ctx, fixups, "e", names["ret_0"])
    _emit_jmp_to_label(ctx, fixups, names["ret_m1"])

    _emit_label(ctx, labels, names["b1_nz"])
    // b2 == 0 => +1.
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(9, 0))
    _emit_jcc_to_label(ctx, fixups, "e", names["ret_p1"])
    return nil
}

fn _x64_emit_cmp_string_byte_order(ctx, names, fixups) {
    // Unsigned byte ordering: b1 < b2 => -1 ; b1 > b2 => +1.
    bytes_extend(ctx["code"], core.insn_cmp_r32_r32(8, 9))
    _emit_jcc_to_label(ctx, fixups, "b", names["ret_m1"])
    _emit_jcc_to_label(ctx, fixups, "a", names["ret_p1"])
    return nil
}

fn _x64_emit_cmp_string_advance(ctx, names, fixups) {
    // Equal: advance and continue.
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 1))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 1))
    _emit_jmp_to_label(ctx, fixups, names["loop"])
    return nil
}

fn _x64_emit_cmp_string_loop_body(ctx, labels, names, fixups) {
    _emit_label(ctx, labels, names["loop"])
    _x64_emit_cmp_string_load_bytes(ctx)
    _x64_emit_cmp_string_zero_cases(ctx, labels, names, fixups)
    _x64_emit_cmp_string_byte_order(ctx, names, fixups)
    _x64_emit_cmp_string_advance(ctx, names, fixups)
    return nil
}

fn _x64_emit_cmp_string_return(ctx, labels, names, fixups, label_name, value_u32) {
    _emit_label(ctx, labels, names[label_name])
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, value_u32))
    bytes_extend(ctx["code"], core.insn_cdqe())
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jmp_to_label(ctx, fixups, names["done"])
    return nil
}

fn _x64_emit_cmp_string_returns(ctx, labels, names, fixups) {
    _x64_emit_cmp_string_return(ctx, labels, names, fixups, "ret_m1", 4294967295)
    _x64_emit_cmp_string_return(ctx, labels, names, fixups, "ret_0", 0)
    _x64_emit_cmp_string_return(ctx, labels, names, fixups, "ret_p1", 1)
    return nil
}

fn _x64_emit_cmp_string_path(ctx, labels, fixups, off_l, off_r, l_str, l_done) {
    _emit_label(ctx, labels, l_str)
    // Inline `strcmp` semantics returning -1/0/1 in RAX, then `cmp rax,0` for Jcc mapping.
    var str_labels = _x64_cmp_string_labels(ctx, l_done)
    _x64_emit_cmp_string_cursor_setup(ctx, off_l, off_r)
    _x64_emit_cmp_string_loop_body(ctx, labels, str_labels, fixups)
    _x64_emit_cmp_string_returns(ctx, labels, str_labels, fixups)
    return nil
}

fn _x64_emit_cmp_int_path(ctx, labels, off_l, off_r, l_int) {
    _emit_label(ctx, labels, l_int)
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_l)
    _emit_mov_r64_mrbp(ctx, 2, 0 - off_r)
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 2))
    return nil
}

fn _x64_cmp_maybe_string_prepare_state(ctx, locals) {
    var offs = _x64_cmp_spill_offsets(ctx, locals)
    if offs == nil { return nil }
    return {
        "off_l": offs["left"],
        "off_r": offs["right"],
        "labels": {},
        "fixups": [],
        "l_int": _new_label(ctx, "cmp_int"),
        "l_str": _new_label(ctx, "cmp_str"),
        "l_done": _new_label(ctx, "cmp_done")
    }
}

fn _x64_cmp_maybe_string_spill_operands(ctx, state, lhs_reg, rhs_reg) {
    _emit_mov_mrbp_r64(ctx, 0 - state["off_l"], lhs_reg)
    _emit_mov_mrbp_r64(ctx, 0 - state["off_r"], rhs_reg)
    return nil
}

fn _x64_emit_cmp_maybe_string_paths(ctx, state) {
    var off_l = state["off_l"]
    var off_r = state["off_r"]
    var labels = state["labels"]
    var fixups = state["fixups"]
    var l_int = state["l_int"]
    var l_str = state["l_str"]
    var l_done = state["l_done"]

    _x64_emit_cmp_small_int_fast_path(ctx, fixups, off_l, off_r, l_int)
    _x64_emit_cmp_string_ptr_checks(ctx, fixups, off_l, off_r, l_int, l_str)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _x64_emit_cmp_string_path(ctx, labels, fixups, off_l, off_r, l_str, l_done)
    _x64_emit_cmp_int_path(ctx, labels, off_l, off_r, l_int)
    return true
}

fn _x64_finish_cmp_maybe_string(ctx, state) {
    _emit_label(ctx, state["labels"], state["l_done"])
    _patch_local_fixups(ctx, state["labels"], state["fixups"])
    return nil
}

fn _emit_cmp_r64_r64_maybe_string_x64(ctx, locals, lhs_reg, rhs_reg) {
    var state = _x64_cmp_maybe_string_prepare_state(ctx, locals)
    if state == nil { return nil }
    _x64_cmp_maybe_string_spill_operands(ctx, state, lhs_reg, rhs_reg)
    if _x64_emit_cmp_maybe_string_paths(ctx, state) != true { return nil }
    _x64_finish_cmp_maybe_string(ctx, state)
    return nil
}

fn _x64_emit_cmp_rhs_integer(ctx, r) {
    var n = intparse.parse_int_lit(r["value"])
    if oren_is_err(n) { err(ctx, "x64 native v0: invalid integer literal"); return nil }
    if _is_i32(n) {
        var imm_u32 = n
        if n < 0 { imm_u32 = 4294967296 + n }
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, imm_u32))
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(2, n)) // rdx = imm64
        bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 2))
    }
    return nil
}

fn _x64_emit_cmp_rhs_identifier(ctx, locals, rhs_name) {
    var off = locals[rhs_name]
    if oren_type_tag(off) != 0 {
        _emit_mov_r64_mrbp(ctx, 2, 0 - off) // rdx = rhs (local)
    } else {
        // Global var RHS (top-level `var`).
        var goff_enc = nil
        if ctx["globals"] != nil { goff_enc = ctx["globals"][rhs_name] }
        if oren_type_tag(goff_enc) == 0 {
            err(ctx, "x64 native v0: unknown var " + rhs_name)
            return nil
        }
        var goff = goff_enc - 1
        // r10 = &global_slot ; rdx = *(u64*)r10
        var lea_pos0 = bytes_len(ctx["code"])
        bytes_extend(ctx["code"], core.insn_lea_r64_rip_disp32(10, 0))
        oren_list_push(ctx["fixups"], {"type": "rip_data_lea", "pos": lea_pos0 + 3, "data_off": goff})
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(2, 10))
    }
    _emit_cmp_r64_r64_maybe_string_x64(ctx, locals, 0, 2)
    return nil
}

fn _x64_emit_cmp_rhs_general(ctx, locals, r) {
    // General RHS expression: spill LHS, evaluate RHS, then cmp lhs,rhs.
    var tmp_off = locals["$tmp_cmp"]
    if oren_type_tag(tmp_off) == 0 { err(ctx, "x64 native v0: missing temp slot for cmp"); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_off, 0) // [tmp] = lhs (rax)
    _emit_eval_int_to_rax(ctx, r, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0)) // rdx = rhs
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_off) // rax = lhs
    _emit_cmp_r64_r64_maybe_string_x64(ctx, locals, 0, 2)
    return nil
}

fn _x64_emit_cmp_infix_from_cond(ctx, cond, locals) {
    var l = cond["left"]
    var r = cond["right"]
    _emit_eval_int_to_rax(ctx, l, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if r["type"] == "Integer" { return _x64_emit_cmp_rhs_integer(ctx, r) }
    if r["type"] == "Identifier" { return _x64_emit_cmp_rhs_identifier(ctx, locals, r["value"]) }
    return _x64_emit_cmp_rhs_general(ctx, locals, r)
}

fn _x64_emit_cmp_truthy_from_cond(ctx, cond, locals) {
    // Truthy expression condition: compare expr to 0.
    if cond["type"] == "Prefix" && cond["op"] == "!" {
        var inner = cond["right"]
        if inner == nil { err(ctx, "x64 native v0: condition prefix ! missing operand"); return nil }
        if _cond_is_cmp_infix(inner) != nil {
            // Negated compare: emit compare for inner; caller picks the correct Jcc.
            _emit_cmp_from_cond(ctx, inner, locals)
            return nil
        } else {
            _emit_eval_int_to_rax(ctx, inner, locals)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
            return nil
        }
    }
    _emit_eval_int_to_rax(ctx, cond, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    return nil
}

fn _emit_cmp_from_cond(ctx, cond, locals) {
    // Emits a compare that sets flags according to `cond`.
    // Uses RAX for evaluated LHS/expr; RDX as scratch for RHS when needed.
    if cond == nil { err(ctx, "x64 native v0: missing condition"); return nil }

    // Comparison condition: compare lhs and rhs.
    if _cond_is_cmp_infix(cond) != nil {
        _x64_emit_cmp_infix_from_cond(ctx, cond, locals)
        return nil
    }

    _x64_emit_cmp_truthy_from_cond(ctx, cond, locals)
    return nil
}

fn _x64_emit_float_cmp_false_for_cond(ctx, cond, locals, local_fixups, false_label) {
    if _cond_is_cmp_infix(cond) == nil { return false }
    var l = cond["left"]
    var r = cond["right"]
    if !(_x64_expr_is_floaty(ctx, l) || _x64_expr_is_floaty(ctx, r)) { return false }
    _emit_float_cmp_to_bool_x64(ctx, cond["op"], l, r, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return true }
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", false_label)
    return true
}

fn _x64_emit_prefix_not_float_cmp_false(ctx, inner, locals, local_fixups, false_label) {
    if _cond_is_cmp_infix(inner) == nil { return false }
    var l2 = inner["left"]
    var r2 = inner["right"]
    if !(_x64_expr_is_floaty(ctx, l2) || _x64_expr_is_floaty(ctx, r2)) { return false }
    _emit_float_cmp_to_bool_x64(ctx, inner["op"], l2, r2, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return true }
    // !x : invert boolean then branch on RAX==0.
    bytes_extend(ctx["code"], core.insn_xor_r64_imm32(0, 1))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "e", false_label)
    return true
}

fn _x64_emit_prefix_not_truthy_false(ctx, inner, locals, local_fixups, false_label) {
    if inner == nil || _cond_is_cmp_infix(inner) != nil { return false }
    // General `!x` condition: branch false when x is truthy.
    //
    // Truthiness:
    // - falsey: `nil` and `false`
    // - truthy: everything else (including int 0)
    _emit_eval_int_to_rax(ctx, inner, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return true }

    // If inner is falsey => `!inner` is true => do not branch false.
    // If inner is truthy => `!inner` is false => branch to false_label.
    var labels2 = {}
    var fixups2 = []
    var l_skip = _new_label(ctx, "not_skip")
    _x64_emit_load_g_storage_ptr_to_reg(ctx, 10)
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(11, 10, 368)) // r11 = nil
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 11))
    _emit_jcc_to_label(ctx, fixups2, "e", l_skip)
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64_disp(11, 10, 376)) // r11 = false
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 11))
    _emit_jcc_to_label(ctx, fixups2, "e", l_skip)
    _emit_jmp_to_label(ctx, local_fixups, false_label)
    _emit_label(ctx, labels2, l_skip)
    _patch_local_fixups(ctx, labels2, fixups2)
    return true
}

fn _x64_emit_truthy_expr_false(ctx, cond, locals, local_fixups, false_label) {
    if _cond_is_cmp_infix(cond) != nil { return false }
    if cond["type"] == "Prefix" && cond["op"] == "!" { return false }
    // Truthy expression condition fallback: evaluate cond and branch false when cond is falsey.
    // This matches the language truthiness rules (only `nil` and `false` are falsey).
    _emit_eval_int_to_rax(ctx, cond, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return true }
    _x64_emit_jcc_if_rax_falsey(ctx, local_fixups, false_label)
    return true
}

fn _x64_check_jcc_false_cond_args(ctx, cond, local_fixups, false_label) {
    if cond == nil { err(ctx, "x64 native v0: missing condition"); return nil }
    if local_fixups == nil { err(ctx, "x64 native v0: missing local_fixups"); return nil }
    if false_label == nil { err(ctx, "x64 native v0: missing false label"); return nil }
    return true
}

fn _x64_emit_cmp_cond_false_branch(ctx, cond, locals, local_fixups, false_label) {
    // Integer/truthy condition fallback.
    _emit_cmp_from_cond(ctx, cond, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    var false_cc = _cond_false_cc_for_cond(cond)
    if false_cc == nil { err(ctx, "x64 native v0: unsupported condition"); return nil }
    _emit_jcc_to_label(ctx, local_fixups, false_cc, false_label)
    return nil
}

fn _emit_jcc_false_for_cond_x64(ctx, cond, locals, local_fixups, false_label) {
    // Emit branch to `false_label` when `cond` is false.
    //
    // Rolling note:
    // - integer comparisons use `cmp` flags + Jcc mapping
    // - float comparisons must be lowered via IEEE-aware ucomisd sequences
    if _x64_check_jcc_false_cond_args(ctx, cond, local_fixups, false_label) == nil { return nil }

    // Float compare condition: compute boolean into RAX, then branch on RAX==0.
    if _x64_emit_float_cmp_false_for_cond(ctx, cond, locals, local_fixups, false_label) == true { return nil }
    if cond["type"] == "Prefix" && cond["op"] == "!" {
        var inner = cond["right"]
        if _x64_emit_prefix_not_float_cmp_false(ctx, inner, locals, local_fixups, false_label) == true { return nil }
        if _x64_emit_prefix_not_truthy_false(ctx, inner, locals, local_fixups, false_label) == true { return nil }
    }

    if _x64_emit_truthy_expr_false(ctx, cond, locals, local_fixups, false_label) == true { return nil }

    _x64_emit_cmp_cond_false_branch(ctx, cond, locals, local_fixups, false_label)
    return nil
}

fn _new_label(ctx, prefix) {
    if ctx["label_seq"] == nil { ctx["label_seq"] = 0 }
    ctx["label_seq"] = ctx["label_seq"] + 1
    // Labels are internal fixup-map keys. Keep them compact so hot x64 emit paths do
    // not repeatedly concatenate long function-derived prefixes.
    return "L" + oren_int_to_string(ctx["label_seq"])
}

fn _emit_label(ctx, labels, name) {
    labels[name] = bytes_len(ctx["code"])
}

fn _emit_jmp_to_label(ctx, local_fixups, name) {
    var pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_jmp_rel32(0))
    oren_list_push(local_fixups, {"disp_pos": pos + 1, "insn_start": pos, "insn_len": 5, "label": name})
}

fn _emit_jcc_to_label(ctx, local_fixups, cc, name) {
    var pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_jcc_rel32_op2(core.jcc_op2(cc), 0))
    oren_list_push(local_fixups, {"disp_pos": pos + 2, "insn_start": pos, "insn_len": 6, "label": name})
}

fn _patch_local_fixups(ctx, labels, local_fixups) {
    var local_fixups_len = oren_list_len(local_fixups)
    var i = 0
    while i < local_fixups_len {
        var f = local_fixups[i]
        var label = f["label"]
        var target = labels[label]
        if target == nil {
            err(ctx, "x64 native v0: unknown label " + label)
            return nil
        }
        var insn_start = f["insn_start"]
        var insn_len = f["insn_len"]
        var next_rip = insn_start + insn_len
        var disp = target - next_rip
        if disp < 0 { disp = 4294967296 + disp }
        set_u32_le(ctx["code"], f["disp_pos"], disp)
        i = i + 1
    }
    return nil
}
