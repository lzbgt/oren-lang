    // Some non-socket HANDLE values can cause closesocket to fail with WSA errors
    // other than WSAENOTSOCK. To make sys_close robust for files created by
    // `sys_open`, always attempt CloseHandle on closesocket failure and only
    // return an error if BOTH close paths fail.
    var l_ok = _new_label(ctx, "sys_close_ok")
    var l_post = _new_label(ctx, "sys_close_post")
    _x64_windows_close_emit_socket_attempt(ctx, tmp_fd, fixups, l_ok)
    _x64_windows_close_emit_handle_fallback(ctx, tmp_fd, labels, fixups, l_post)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_label(ctx, labels, l_post)
    return nil
}

fn _x64_windows_close_posthook(ctx, tmp_fd, capsule) {
    // post: native_capsule_sys_close_post(rc, fd) -> rc
    if capsule {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = rc
        _intr_load_x64(ctx, 2, tmp_fd) // rdx = fd
