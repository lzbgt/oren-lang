fn _x64_windows_close_emit_handle_fallback(ctx, tmp_fd, labels, fixups, l_post) {
    // closesocket failed => attempt CloseHandle(fd).
    _intr_load_x64(ctx, 1, tmp_fd) // rcx = HANDLE
    _emit_call_iat_x64(ctx, "IAT_CloseHandle")
    // CloseHandle returns BOOL; if 0 => failure => -EIO
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    var l_ch_ok = _new_label(ctx, "sys_close_ch_ok")
    _emit_jcc_to_label(ctx, fixups, "ne", l_ch_ok)
    _emit_set_rax_neg_errno_x64(ctx, 5)
    _emit_jmp_to_label(ctx, fixups, l_post)
    _emit_label(ctx, labels, l_ch_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, l_post)
