fn _x64_windows_accept_posthook(ctx, st, capsule) {
    // post: native_capsule_sys_accept_post(newfd, listen_fd, addr, addrlen_ptr) -> newfd
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = newfd
    _intr_load_x64(ctx, 2, st["tmp_fd"])
