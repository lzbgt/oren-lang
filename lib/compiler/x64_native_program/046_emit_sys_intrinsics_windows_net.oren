    var l_ok = _new_label(ctx, "sys_connect_ok")
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)
    _emit_wsa_last_error_to_neg_errno_connect_x64(ctx)
    var l_post = _new_label(ctx, "sys_connect_post")
    _emit_jmp_to_label(ctx, fixups, l_post)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())

    _emit_label(ctx, labels, l_post)
    // post: native_capsule_sys_connect_post(rc, fd, addr, addrlen) -> rc
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = rc
    _intr_load_x64(ctx, 2, tmp_fd)
    _intr_load_x64(ctx, 8, tmp_addr)
    _intr_load_x64(ctx, 9, tmp_len)
    if capsule { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_connect_post") }

    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_bind_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_bind expects 3 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_bind does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)

    var base = _intr_tmp_push(ctx, 3) // fd, addr, len
    if oren_type_tag(base) == 0 { return nil }
    var tmp_fd = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_addr = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_len = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(tmp_fd) == 0 || oren_type_tag(tmp_addr) == 0 || oren_type_tag(tmp_len) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_fd)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_addr)
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_len)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    // pre
    _intr_load_x64(ctx, 1, tmp_fd)
    _intr_load_x64(ctx, 2, tmp_addr)
    _intr_load_x64(ctx, 8, tmp_len)
