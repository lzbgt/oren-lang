fn _x64_windows_sockaddr3_result(ctx, labels, fixups, label_prefix, errno_kind) {
    var l_ok = _new_label(ctx, label_prefix + "_ok")
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)
    if errno_kind == "connect" {
        _emit_wsa_last_error_to_neg_errno_connect_x64(ctx)
    } else {
        _emit_wsa_last_error_to_neg_errno_common_x64(ctx)
    }
    var l_post = _new_label(ctx, label_prefix + "_post")
    _emit_jmp_to_label(ctx, fixups, l_post)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_label(ctx, labels, l_post)
    return nil
}

fn _x64_windows_sockaddr3_posthook(ctx, st, capsule, hook_name) {
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = rc
    _intr_load_x64(ctx, 2, st["tmp_fd"])
    _intr_load_x64(ctx, 8, st["tmp_addr"])
    _intr_load_x64(ctx, 9, st["tmp_len"])
    if capsule { _emit_call_rel32_named_x64(ctx, hook_name) }
    return nil
}

fn _x64_windows_accept_result(ctx, labels, fixups) {
    var l_ok = _new_label(ctx, "sys_accept_ok")
