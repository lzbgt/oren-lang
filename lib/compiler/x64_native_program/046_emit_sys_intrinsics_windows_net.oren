fn _emit_intrinsic_sys_close_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_close expects 1 arg"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_close does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)

    var base = _intr_tmp_push(ctx, 1) // fd
    if oren_type_tag(base) == 0 { return nil }
    var tmp_fd = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(tmp_fd) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_fd, 0)

    // pre: native_capsule_sys_close_pre(fd) -> fd
    if capsule {
        _intr_load_x64(ctx, 1, tmp_fd)
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_close_pre")
        _emit_mov_mrbp_r64(ctx, 0 - tmp_fd, 0)
    }

    // Close semantics (rolling):
    // - Prefer closesocket(fd) (socket handles)
    // - If it fails, fall back to CloseHandle(fd) (file/thread/process handles)
    //
    // Note:
    // - Some non-socket HANDLE values can cause closesocket to fail with WSA errors
    //   other than WSAENOTSOCK. To make sys_close robust for files created by `sys_open`,
    //   we always attempt CloseHandle on closesocket failure and only return an error
    //   if BOTH close paths fail.
    _intr_load_x64(ctx, 1, tmp_fd)
    _emit_call_iat_x64(ctx, "IAT_closesocket")

    var labels = {}
    var fixups = []
    var l_ok = _new_label(ctx, "sys_close_ok")
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_ok)
    var l_post = _new_label(ctx, "sys_close_post")

    // closesocket failed => attempt CloseHandle(fd).
    _intr_load_x64(ctx, 1, tmp_fd) // rcx = HANDLE
    _emit_call_iat_x64(ctx, "IAT_CloseHandle")
    // CloseHandle returns BOOL; if 0 => failure => -EIO
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    var l_ch_ok = _new_label(ctx, "sys_close_ch_ok")
    _emit_jcc_to_label(ctx, fixups, "ne", l_ch_ok)
    _emit_set_rax_neg_errno_x64(ctx, 5)
    _emit_jmp_to_label(ctx, fixups, l_post)
    _emit_label(ctx, labels, l_ch_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_jmp_to_label(ctx, fixups, l_post)

    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())

    _emit_label(ctx, labels, l_post)
    // post: native_capsule_sys_close_post(rc, fd) -> rc
    if capsule {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = rc
        _intr_load_x64(ctx, 2, tmp_fd) // rdx = fd
        _emit_call_rel32_named_x64(ctx, "native_capsule_sys_close_post")
    }

    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

