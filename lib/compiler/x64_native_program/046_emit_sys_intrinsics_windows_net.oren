fn _x64_windows_close_emit_socket_attempt(ctx, tmp_fd, fixups, l_ok) {
    _intr_load_x64(ctx, 1, tmp_fd)
    _emit_call_iat_x64(ctx, "IAT_closesocket")
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_ok)
    return nil
