fn _x64_windows_close_emit_result(ctx, tmp_fd, labels, fixups) {
    // Close semantics (rolling):
    // - Prefer closesocket(fd) (socket handles)
    // - If it fails, fall back to CloseHandle(fd) (file/thread/process handles)
