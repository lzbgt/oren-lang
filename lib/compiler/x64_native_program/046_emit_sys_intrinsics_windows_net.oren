// x64-native (Windows): WinSock-based NET syscall intrinsics.
//
// Goal: bring Windows x64 NET substrate to Tier‑1 parity with macOS/Linux syscall-first runtime:
// - implement socket/connect/bind/listen/accept/sendto/recvfrom/getsockname/getpeername
// - implement setsockopt/getsockopt (SO_REUSEADDR, SO_ERROR)
// - implement shutdown/close
// - provide a wait backend via WinSock select()
// - provide WinSock init via WSAStartup (called from runtime `native_net_init_once`)
//
// Design principles (rolling):
// - keep host effects behind `sys_*` intrinsics so capsule gating stays centralized
// - return convention: success => >=0, failure => negative errno (POSIX-like)
// - map common WSA error codes to the POSIX errno numbers used by the runtime

fn _emit_call_iat_x64(ctx, data_label) {
    var mov_iat = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_mov_rax_mrip_disp32(0))
    _x64_add_rip_data32_fixup(ctx, mov_iat + 3, data_label)
    bytes_extend(ctx["code"], core.insn_call_rax())
    return nil
}

fn _emit_set_rax_neg_errno_x64(ctx, errnum) {
    // rax = -errno
    var imm = 4294967296 - (errnum & 4294967295)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, imm))
    bytes_extend(ctx["code"], core.insn_cdqe())
    return nil
}

fn _emit_wsa_get_last_error_x64(ctx) {
    // eax = WSAGetLastError()
    _emit_call_iat_x64(ctx, "IAT_WSAGetLastError")
    return nil
}

fn _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, next_label, wsa_errno, posix_errno) {
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, wsa_errno))
    var l_next = _new_label(ctx, next_label)
    _emit_jcc_to_label(ctx, fixups, "ne", l_next)
    _emit_set_rax_neg_errno_x64(ctx, posix_errno)
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next)
    return nil
}

fn _emit_wsa_last_error_progress_cases_x64(ctx, labels, fixups, l_done) {
    // WSAEWOULDBLOCK(10035) -> EAGAIN(11)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_next0", 10035, 11)

    // WSAEINPROGRESS(10036) -> EINPROGRESS(115)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_next1", 10036, 115)

    // WSAEALREADY(10037) -> EALREADY(114)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_next2", 10037, 114)
    return nil
}

fn _emit_wsa_last_error_socket_cases_x64(ctx, labels, fixups, l_done) {
    // WSAETIMEDOUT(10060) -> ETIMEDOUT(60)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_next3", 10060, 60)

    // WSAECONNREFUSED(10061) -> ECONNREFUSED(111)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_next4", 10061, 111)

    // WSAEADDRINUSE(10048) -> EADDRINUSE(98)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_next5", 10048, 98)

    // WSAEINVAL(10022) -> EINVAL(22)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_next6", 10022, 22)

    // WSAENOTSOCK(10038) -> ENOTSOCK(88) (Linux number; used only for diagnostics)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_next7", 10038, 88)

    // WSAECONNRESET(10054) -> ECONNRESET(104)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_next8", 10054, 104)
    return nil
}

fn _emit_intrinsic_sys_wsa_get_last_error_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args != nil && oren_list_len(args) != 0 { err(ctx, "x64 native v0: sys_wsa_get_last_error expects 0 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_wsa_get_last_error does not support spread"); return nil }

    _emit_call_iat_x64(ctx, "IAT_WSAGetLastError")
    bytes_extend(ctx["code"], core.insn_cdqe())
    return nil
}

fn _emit_wsa_last_error_to_neg_errno_common_x64(ctx) {
    // rax = -errno (POSIX-like) mapped from WSAGetLastError()
    //
    // Uses: eax
    _emit_wsa_get_last_error_x64(ctx)
    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "wsa_err_done")

    _emit_wsa_last_error_progress_cases_x64(ctx, labels, fixups, l_done)
    _emit_wsa_last_error_socket_cases_x64(ctx, labels, fixups, l_done)

    // Default: -EIO(5)
    _emit_set_rax_neg_errno_x64(ctx, 5)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_wsa_last_error_to_neg_errno_connect_x64(ctx) {
    // connect() on nonblocking sockets typically reports WSAEWOULDBLOCK (10035) on Windows.
    // For parity with Linux, map it to -EINPROGRESS(-115) so the runtime waits and then checks SO_ERROR.
    _emit_wsa_get_last_error_x64(ctx)
    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "wsa_err_connect_done")

    // WSAEWOULDBLOCK(10035) -> EINPROGRESS(115)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_connect_next0", 10035, 115)

    // WSAEINPROGRESS(10036) -> EINPROGRESS(115)
    _emit_wsa_neg_errno_case_x64(ctx, labels, fixups, l_done, "wsa_err_connect_next1", 10036, 115)

    // Otherwise, fall back to common mapping.
    _emit_wsa_last_error_to_neg_errno_common_x64(ctx)
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _emit_wsa_posix_errno_case_x64(ctx, labels, fixups, l_done, next_label, wsa_errno, posix_errno) {
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, wsa_errno))
    var l_next = _new_label(ctx, next_label)
    _emit_jcc_to_label(ctx, fixups, "ne", l_next)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, posix_errno))
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_next)
    return nil
}

fn _emit_map_wsa_eax_zero_to_posix_errno_x64(ctx, fixups, l_done) {
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_done)
    return nil
}

fn _emit_map_wsa_eax_known_to_posix_errno_x64(ctx, labels, fixups, l_done) {
    // WSAETIMEDOUT(10060) -> ETIMEDOUT(60)
    _emit_wsa_posix_errno_case_x64(ctx, labels, fixups, l_done, "wsa_to_posix_next0", 10060, 60)

    // WSAECONNREFUSED(10061) -> ECONNREFUSED(111)
    _emit_wsa_posix_errno_case_x64(ctx, labels, fixups, l_done, "wsa_to_posix_next1", 10061, 111)

    // WSAEADDRINUSE(10048) -> EADDRINUSE(98)
    _emit_wsa_posix_errno_case_x64(ctx, labels, fixups, l_done, "wsa_to_posix_next2", 10048, 98)

    // WSAEINVAL(10022) -> EINVAL(22)
    _emit_wsa_posix_errno_case_x64(ctx, labels, fixups, l_done, "wsa_to_posix_next3", 10022, 22)
    return nil
}

fn _emit_map_wsa_eax_default_to_posix_errno_x64(ctx) {
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 5))
    return nil
}

fn _emit_map_wsa_eax_to_posix_errno_eax_x64(ctx) {
    // Input:  eax = WSA error code (0 => ok)
    // Output: eax = POSIX errno number (0 => ok)
    //
    // Used for SO_ERROR normalization so runtime logic can stay platform-neutral.
    var labels = {}
    var fixups = []
    var l_done = _new_label(ctx, "wsa_to_posix_done")

    _emit_map_wsa_eax_zero_to_posix_errno_x64(ctx, fixups, l_done)
    _emit_map_wsa_eax_known_to_posix_errno_x64(ctx, labels, fixups, l_done)
    _emit_map_wsa_eax_default_to_posix_errno_x64(ctx)

    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    return nil
}

fn _x64_windows_wsa_startup_state(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 1) // wsadata_ptr
    if oren_type_tag(base) == 0 { return nil }
    var tmp_ws = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(tmp_ws) == 0 { _intr_tmp_pop(ctx, base); return nil }
    _intr_eval_spill_x64(ctx, locals, args[0], tmp_ws)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "tmp_ws": tmp_ws}
}

fn _x64_windows_wsa_startup_emit_call(ctx, st) {
    // WSAStartup(MAKEWORD(2,2), wsadata_ptr)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(1, 514)) // ecx = 0x0202
    _intr_load_x64(ctx, 2, st["tmp_ws"]) // rdx = wsadata_ptr
    _emit_call_iat_x64(ctx, "IAT_WSAStartup")
    return nil
}

fn _x64_windows_wsa_startup_normalize_result(ctx, labels, fixups) {
    // If rc != 0 => return -EIO (best-effort; keeps runtime stable).
    var l_ok = _new_label(ctx, "wsa_startup_ok")
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 0))
    _emit_jcc_to_label(ctx, fixups, "e", l_ok)
    _emit_set_rax_neg_errno_x64(ctx, 5)
    var l_done = _new_label(ctx, "wsa_startup_done")
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], core.insn_cdqe())
    _emit_label(ctx, labels, l_done)
    return nil
}

fn _emit_intrinsic_sys_wsa_startup_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_wsa_startup expects 1 arg"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_wsa_startup does not support spread"); return nil }

    var st = _x64_windows_wsa_startup_state(ctx, locals, args)
    if st == nil { return nil }
    var labels = {}
    var fixups = []

    _x64_windows_wsa_startup_emit_call(ctx, st)
    _x64_windows_wsa_startup_normalize_result(ctx, labels, fixups)
    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, st["base"])
    return nil
}

fn _x64_windows_select_tmp_state(ctx, locals) {
    var base = _intr_tmp_push(ctx, 5) // nfds, readfds, writefds, exceptfds, tv
    if oren_type_tag(base) == 0 { return nil }
    var tmp_nfds = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_r = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_w = _intr_tmp_off(ctx, locals, base + 2)
    var tmp_e = _intr_tmp_off(ctx, locals, base + 3)
    var tmp_tv = _intr_tmp_off(ctx, locals, base + 4)
    if oren_type_tag(tmp_nfds) == 0 || oren_type_tag(tmp_r) == 0 || oren_type_tag(tmp_w) == 0 || oren_type_tag(tmp_e) == 0 || oren_type_tag(tmp_tv) == 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "tmp_nfds": tmp_nfds, "tmp_r": tmp_r, "tmp_w": tmp_w, "tmp_e": tmp_e, "tmp_tv": tmp_tv}
}

fn _x64_windows_select_spill_args(ctx, locals, args, st) {
    _intr_eval_spill_x64(ctx, locals, args[0], st["tmp_nfds"])
    _intr_eval_spill_x64(ctx, locals, args[1], st["tmp_r"])
    _intr_eval_spill_x64(ctx, locals, args[2], st["tmp_w"])
    _intr_eval_spill_x64(ctx, locals, args[3], st["tmp_e"])
    _intr_eval_spill_x64(ctx, locals, args[4], st["tmp_tv"])
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, st["base"]); return false }
    return true
}

fn _x64_windows_select_state(ctx, locals, args) {
    var st = _x64_windows_select_tmp_state(ctx, locals)
    if st == nil { return nil }
    if !_x64_windows_select_spill_args(ctx, locals, args, st) { return nil }
    return st
}

fn _x64_windows_select_load_args(ctx, st) {
    _intr_load_x64(ctx, 1, st["tmp_nfds"]) // rcx
    _intr_load_x64(ctx, 2, st["tmp_r"])    // rdx
    _intr_load_x64(ctx, 8, st["tmp_w"])    // r8
    _intr_load_x64(ctx, 9, st["tmp_e"])    // r9
    _intr_load_x64(ctx, 10, st["tmp_tv"])  // r10 = tv
    return nil
}

fn _x64_windows_select_emit_call(ctx, st) {
    // select(nfds, readfds, writefds, exceptfds, tv)
    _x64_windows_select_load_args(ctx, st)
    _emit_mov_mrsp_r64(ctx, 32, 10)  // arg5 at [rsp+0x20]
    _emit_call_iat_x64(ctx, "IAT_select")
    return nil
}

fn _x64_windows_select_normalize_result(ctx, labels, fixups) {
    // If rc == SOCKET_ERROR (-1), translate WSAGetLastError to -errno.
    var l_ok = _new_label(ctx, "sys_select_ok")
    bytes_extend(ctx["code"], core.insn_cmp_r32_imm32(0, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)
    _emit_wsa_last_error_to_neg_errno_common_x64(ctx)
    var l_done = _new_label(ctx, "sys_select_done")
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_ok)
    bytes_extend(ctx["code"], core.insn_cdqe()) // widen rc to i64
    _emit_label(ctx, labels, l_done)
    return nil
}

fn _emit_intrinsic_sys_select_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 5 { err(ctx, "x64 native v0: sys_select expects 5 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_select does not support spread"); return nil }

    var st = _x64_windows_select_state(ctx, locals, args)
    if st == nil { return nil }
    var labels = {}
    var fixups = []

    _x64_windows_select_emit_call(ctx, st)
    _x64_windows_select_normalize_result(ctx, labels, fixups)
    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, st["base"])
    return nil
}

fn _emit_intrinsic_sys_socket_windows_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_socket expects 3 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_socket does not support spread"); return nil }

    var capsule = _x64_capsule_enabled(ctx)
    var st = _x64_windows_socket_state(ctx, locals, args)
    if st == nil { return nil }
    var labels = {}
    var fixups = []

    _x64_windows_socket_prehook(ctx, st, capsule)
    _x64_windows_socket_iat_call(ctx, st)
    var l_done = _x64_windows_socket_result(ctx, labels, fixups)
    _x64_windows_socket_posthook(ctx, st, capsule)
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, fixups)
    _intr_tmp_pop(ctx, st["base"])
    return nil
}

fn _x64_windows_socket_state(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 3) // domain,type,proto
    if oren_type_tag(base) == 0 { return nil }
    var tmp_dom = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_type = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_proto = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(tmp_dom) == 0 || oren_type_tag(tmp_type) == 0 || oren_type_tag(tmp_proto) == 0 { _intr_tmp_pop(ctx, base); return nil }

    _intr_eval_spill_x64(ctx, locals, args[0], tmp_dom)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_type)
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_proto)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "tmp_dom": tmp_dom, "tmp_type": tmp_type, "tmp_proto": tmp_proto}
}

fn _x64_windows_socket_load_args(ctx, st) {
    _intr_load_x64(ctx, 1, st["tmp_dom"])
    _intr_load_x64(ctx, 2, st["tmp_type"])
    _intr_load_x64(ctx, 8, st["tmp_proto"])
    return nil
}

fn _x64_windows_socket_prehook(ctx, st, capsule) {
    _x64_windows_socket_load_args(ctx, st)
    if capsule { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_socket_pre") }
    return nil
}

fn _x64_windows_socket_iat_call(ctx, st) {
    _x64_windows_socket_load_args(ctx, st)
    _emit_call_iat_x64(ctx, "IAT_socket")
    return nil
}

fn _x64_windows_socket_result(ctx, labels, fixups) {
    var l_ok = _new_label(ctx, "sys_socket_ok")
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 4294967295))
    _emit_jcc_to_label(ctx, fixups, "ne", l_ok)
    _emit_wsa_last_error_to_neg_errno_common_x64(ctx)
    var l_done = _new_label(ctx, "sys_socket_done")
    _emit_jmp_to_label(ctx, fixups, l_done)
    _emit_label(ctx, labels, l_ok)
    return l_done
}

fn _x64_windows_socket_posthook(ctx, st, capsule) {
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(1, 0)) // rcx = fd
    _intr_load_x64(ctx, 2, st["tmp_dom"])
    _intr_load_x64(ctx, 8, st["tmp_type"])
    _intr_load_x64(ctx, 9, st["tmp_proto"])
    if capsule { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_socket_post") }
    return nil
}

fn _x64_windows_sockaddr3_state(ctx, locals, args) {
    var base = _intr_tmp_push(ctx, 3) // fd, addr, len
    if oren_type_tag(base) == 0 { return nil }
    var tmp_fd = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_addr = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_len = _intr_tmp_off(ctx, locals, base + 2)
    if oren_type_tag(tmp_fd) == 0 || oren_type_tag(tmp_addr) == 0 || oren_type_tag(tmp_len) == 0 {
        _intr_tmp_pop(ctx, base)
        return nil
    }
    _intr_eval_spill_x64(ctx, locals, args[0], tmp_fd)
    _intr_eval_spill_x64(ctx, locals, args[1], tmp_addr)
    _intr_eval_spill_x64(ctx, locals, args[2], tmp_len)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    return {"base": base, "tmp_fd": tmp_fd, "tmp_addr": tmp_addr, "tmp_len": tmp_len}
}

fn _x64_windows_sockaddr3_load_args(ctx, st) {
    _intr_load_x64(ctx, 1, st["tmp_fd"])
    _intr_load_x64(ctx, 2, st["tmp_addr"])
    _intr_load_x64(ctx, 8, st["tmp_len"])
