    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }

    // pre: native_capsule_sys_connect_pre(fd, addr, addrlen)
    _intr_load_x64(ctx, 1, tmp_fd)
    _intr_load_x64(ctx, 2, tmp_addr)
    _intr_load_x64(ctx, 8, tmp_len)
    if capsule { _emit_call_rel32_named_x64(ctx, "native_capsule_sys_connect_pre") }

    // connect(fd, addr, len) -> 0 or SOCKET_ERROR(-1)
    _intr_load_x64(ctx, 1, tmp_fd)
    _intr_load_x64(ctx, 2, tmp_addr)
    _intr_load_x64(ctx, 8, tmp_len)
    _emit_call_iat_x64(ctx, "IAT_connect")

    var labels = {}
