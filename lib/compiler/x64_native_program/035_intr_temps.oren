// Intrinsic temp allocator for x64 native v0.
//
// Problem:
// Many intrinsic lowerings need to spill evaluated args into stack slots so they can
// freely use registers for the actual implementation. If those spill slots are fixed
// names (e.g. `$tmp1..$tmp7`), nested expression evaluation can clobber the outer
// intrinsic's spilled args (e.g. `{ "a": {"b": 7} }` where the outer `oren_map_set_{int,str}`
// evaluates a nested map literal as its value).
//
// Solution:
// Reserve a pool of stack slots `$tmp_intr0..$tmp_intr<N-1>` per function, and treat
// the pool as a simple bump allocator with explicit push/pop to support nesting.

fn _x64_tmp_intr_name(ctx, idx) {
    // Return a stable string name for intrinsic temp slot `idx`.
    //
    // PERF (stage2-native compiler):
    // Many x64 lowering helpers construct `{"type":"Identifier","value":"$tmp_intrN"}` AST nodes.
    // If each call does `"$tmp_intr" + int_to_string(idx)`, we allocate lots of tiny strings.
    //
    // Cache the names on `ctx` so they are re-used across functions and across rtobj builds.
    if idx == nil { return "$tmp_intr" }
    if ctx == nil { return "$tmp_intr" + oren_int_to_string(idx) }
    var intr = ctx["__x64_tmp_intr_names"]
    if intr == nil {
        intr = []
        ctx["__x64_tmp_intr_names"] = intr
    }
    if idx >= 0 && idx < oren_list_len(intr) {
        return oren_list_get(intr, idx)
    }
    // Extend (rare path): grow until index idx exists.
    var j = oren_list_len(intr)
    while j <= idx {
        oren_list_push(intr, "$tmp_intr" + oren_int_to_string(j))
        j = iadd(j, 1)
    }
    ctx["__x64_tmp_intr_names"] = intr
    return oren_list_get(intr, idx)
}

fn _intr_tmp_push(ctx, n) {
    var cur = 0
    if ctx["intr_tmp_cursor"] != nil { cur = ctx["intr_tmp_cursor"] }
    var lim = 0
    if ctx["intr_tmp_limit"] != nil { lim = ctx["intr_tmp_limit"] }

    if n < 0 {
        err(ctx, "x64 native v0: invalid intrinsic temp request")
        return nil
    }
    if iadd(cur, n) > lim {
        err(ctx, "x64 native v0: intrinsic temp overflow (need " + oren_int_to_string(n) + ")")
        return nil
    }

    ctx["intr_tmp_cursor"] = iadd(cur, n)
    return cur
}

fn _intr_tmp_pop(ctx, base) {
    if base == nil { return nil }
    ctx["intr_tmp_cursor"] = base
    return nil
}

fn _intr_tmp_off(ctx, locals, idx) {
    if idx == nil {
        err(ctx, "x64 native v0: intrinsic temp idx is nil")
        return nil
    }

    // PERF (stage2-native compiler):
    // Avoid allocating a fresh string for `$tmp_intrN` on every intrinsic lowering.
    // Reuse cached names from `_x64_tmp_intr_name(ctx, idx)`.
    var nm = _x64_tmp_intr_name(ctx, idx)
    var off = nil
    if locals != nil { off = locals[nm] }
    if off == nil {
        err(ctx, "x64 native v0: missing intrinsic temp slot " + nm)
        return nil
    }
    return off
}
