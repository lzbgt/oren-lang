// Intrinsic temp allocator for x64 native v0.
//
// Problem:
// Many intrinsic lowerings need to spill evaluated args into stack slots so they can
// freely use registers for the actual implementation. If those spill slots are fixed
// names (e.g. `$tmp1..$tmp7`), nested expression evaluation can clobber the outer
// intrinsic's spilled args (e.g. `{ "a": {"b": 7} }` where the outer `oren_map_set_{int,str}`
// evaluates a nested map literal as its value).
//
// Solution:
// Reserve a pool of stack slots `$tmp_intr0..$tmp_intr<N-1>` per function, and treat
// the pool as a simple bump allocator with explicit push/pop to support nesting.

fn _x64_tmp_intr_name(ctx, idx) {
    // Return a stable string name for intrinsic temp slot `idx`.
    //
    // PERF (stage2-native compiler):
    // Many x64 lowering helpers construct `{"type":"Identifier","value":"$tmp_intrN"}` AST nodes.
    // If each call does `"$tmp_intr" + int_to_string(idx)`, we allocate lots of tiny strings.
    //
    // Cache the names on `ctx` so they are re-used across functions and across rtobj builds.
    // Intrinsic temp indices are integers; keep the API scalar-only (avoid relying on `x == nil`).
    if idx <= 0 { return "$tmp_intr" }
    if ctx == nil { return "$tmp_intr" + oren_int_to_string(idx) }
    var intr = ctx["__x64_tmp_intr_names"]
    if intr == nil {
        intr = []
        ctx["__x64_tmp_intr_names"] = intr
    }
    if idx >= 0 && idx < oren_list_len(intr) {
        return oren_list_get(intr, idx)
    }
    // Extend (rare path): grow until index idx exists.
    var j = oren_list_len(intr)
    while j <= idx {
        oren_list_push(intr, "$tmp_intr" + oren_int_to_string(j))
        j = iadd(j, 1)
    }
    ctx["__x64_tmp_intr_names"] = intr
    return oren_list_get(intr, idx)
}

fn _intr_tmp_push(ctx, n) {
    // Native-runtime robustness:
    // `nil/false/0` can collapse to 0 in some contexts today, so using 0 as a sentinel is unsafe.
    //
    // Reserve slot 0 and use 1-based intrinsic-temp indices so `base==0` never aliases `nil`.
    var cur = 1
    if ctx["intr_tmp_cursor"] != nil { cur = ctx["intr_tmp_cursor"] }
    if cur == 0 { cur = 1 }
    var lim = 0
    if ctx["intr_tmp_limit"] != nil { lim = ctx["intr_tmp_limit"] }

    if n < 0 {
        err(ctx, "x64 native v0: invalid intrinsic temp request")
        return nil
    }
    if iadd(cur, n) > lim {
        err(ctx, "x64 native v0: intrinsic temp overflow (need " + oren_int_to_string(n) + ")")
        return nil
    }

    ctx["intr_tmp_cursor"] = iadd(cur, n)
    return cur
}

fn _intr_tmp_pop(ctx, base) {
    if base == nil { return nil }
    // Defensive: treat `0` as the reserved base slot.
    if base == 0 { ctx["intr_tmp_cursor"] = 1 } else { ctx["intr_tmp_cursor"] = base }
    return nil
}

fn _intr_tmp_off(ctx, locals, idx) {
    // Intrinsic temp indices are 1-based (0 is reserved).
    if idx <= 0 {
        err(ctx, "x64 native v0: intrinsic temp idx is missing/invalid")
        return 0
    }

    // Fast path: per-function intrinsic-temp pool base offset.
    //
    // Each slot is an 8-byte word at:
    //   [rbp - (intr_tmp_base_off + idx*8)]
    //
    // Use only `iadd` here so stage1 (C runtime) doesn't pay the cost of generic `*`/`<<`.
    if ctx != nil && ctx["intr_tmp_base_off"] != nil {
        if idx < 0 { err(ctx, "x64 native v0: intrinsic temp idx < 0"); return 0 }
        var lim = 0
        if ctx["intr_tmp_limit"] != nil { lim = ctx["intr_tmp_limit"] }
        if lim != 0 && idx >= lim {
            err(ctx, "x64 native v0: intrinsic temp idx out of range (idx=" + oren_int_to_string(idx) +
                     " lim=" + oren_int_to_string(lim) + ")")
            return 0
        }
        var base = ctx["intr_tmp_base_off"]
        var scale = iadd(idx, idx)   // *2
        scale = iadd(scale, scale)   // *4
        scale = iadd(scale, scale)   // *8
        return iadd(base, scale)
    }

    // Fallback (compat/debug): named locals `$tmp_intrN`.
    //
    // PERF NOTE:
    // This path should not run for the current x64 backend, but keeping it provides
    // a clearer error surface if some older lowering still constructs `$tmp_intrN` identifiers.
    var nm = _x64_tmp_intr_name(ctx, idx)
    var off = nil
    if locals != nil { off = locals[nm] }
    // Native-runtime robustness:
    // - `locals[nm]` can produce 0 for a missing key today (nil carrier).
    // - Real stack offsets are never 0 in this backend (start at 8), so `off == nil` is a safe
    //   missing check here even in the current untagged mode.
    if off == nil || off == 0 {
        err(ctx, "x64 native v0: missing intrinsic temp slot " + nm)
        return 0
    }
    return off
}
