fn _emit_intrinsic_atomic_add_x64(ctx, expr, locals) {
    // atomic_add(ptr, val) -> old value (fetch_add)
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 2 { err(ctx, "x64 native v0: atomic_add expects 2 args"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: atomic_add does not support spread"); return nil }

    // Must not keep `ptr` only in a register across nested expression evaluation.
    var base = _intr_tmp_push(ctx, 1)
    if base == nil { return nil }
    var tmp_ptr = _intr_tmp_off(ctx, locals, base + 0)
    if tmp_ptr == nil { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals) // ptr -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ptr, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals) // addend -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, 0))         // rdx = addend
    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_ptr)                   // rcx = ptr
    bytes_extend(ctx["code"], insn_lock_xadd_mr64_r64(1, 2))   // lock xadd [rcx], rdx (rdx := old)
    bytes_extend(ctx["code"], insn_mov_r64_r64(0, 2))          // rax = old

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_atomic_cas_x64(ctx, expr, locals) {
    // atomic_cas(ptr, expected, new) -> old value
    var args = expr["args"]
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: atomic_cas expects 3 args"); return nil }
    if expr["spread"] != nil { err(ctx, "x64 native v0: atomic_cas does not support spread"); return nil }

    // We need to preserve ptr and expected across evaluation of `new`.
    var base = _intr_tmp_push(ctx, 2)
    if base == nil { return nil }
    var tmp_ptr = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_exp = _intr_tmp_off(ctx, locals, base + 1)
    if tmp_ptr == nil || tmp_exp == nil { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals) // ptr -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ptr, 0)

    _emit_eval_int_to_rax(ctx, args[1], locals) // expected -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_exp, 0)

    _emit_eval_int_to_rax(ctx, args[2], locals) // new -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    bytes_extend(ctx["code"], insn_mov_r64_r64(2, 0))          // rdx = new

    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_ptr)                   // rcx = ptr
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_exp)                   // rax = expected (implicit cmpxchg operand)
    bytes_extend(ctx["code"], insn_lock_cmpxchg_mr64_r64(1, 2))// lock cmpxchg [rcx], rdx  (rax := old)

    _intr_tmp_pop(ctx, base)
    return nil
}

