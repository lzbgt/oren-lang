fn _x64_atomic_args(ctx, expr, arity, arity_msg, spread_msg) {
    var args = expr["args"]
    if args == nil || oren_list_len(args) != arity { err(ctx, arity_msg); return nil }
    if expr["spread"] != nil { err(ctx, spread_msg); return nil }
    return args
}

fn _x64_atomic_add_args(ctx, expr) {
    var arity_msg = "x64 native v0: atomic_add expects 2 args"
    var spread_msg = "x64 native v0: atomic_add does not support spread"
    return _x64_atomic_args(ctx, expr, 2, arity_msg, spread_msg)
}

fn _x64_atomic_cas_args(ctx, expr) {
    var arity_msg = "x64 native v0: atomic_cas expects 3 args"
    var spread_msg = "x64 native v0: atomic_cas does not support spread"
    return _x64_atomic_args(ctx, expr, 3, arity_msg, spread_msg)
}

fn _x64_atomic_eval_spill_arg(ctx, locals, arg, tmp) {
    _emit_eval_int_to_rax(ctx, arg, locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp, 0)
    return true
}

fn _x64_atomic_ptr_state(ctx, locals) {
    var base = _intr_tmp_push(ctx, 1)
    if oren_type_tag(base) == 0 { return nil }
    var tmp_ptr = _intr_tmp_off(ctx, locals, base + 0)
    if oren_type_tag(tmp_ptr) == 0 { _intr_tmp_pop(ctx, base); return nil }
    return [base, tmp_ptr]
}

fn _x64_atomic_cas_state(ctx, locals) {
    var base = _intr_tmp_push(ctx, 2)
    if oren_type_tag(base) == 0 { return nil }
    var tmp_ptr = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_exp = _intr_tmp_off(ctx, locals, base + 1)
    if oren_type_tag(tmp_ptr) == 0 || oren_type_tag(tmp_exp) == 0 { _intr_tmp_pop(ctx, base); return nil }
    return [base, tmp_ptr, tmp_exp]
}

fn _emit_intrinsic_atomic_add_x64(ctx, expr, locals) {
    // atomic_add(ptr, val) -> old value (fetch_add)
    var args = _x64_atomic_add_args(ctx, expr)
    if args == nil { return nil }

    // Must not keep `ptr` only in a register across nested expression evaluation.
    var state = _x64_atomic_ptr_state(ctx, locals)
    if state == nil { return nil }
    var base = state[0]
    var tmp_ptr = state[1]

    if _x64_atomic_eval_spill_arg(ctx, locals, args[0], tmp_ptr) == nil { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, args[1], locals) // addend -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0))         // rdx = addend
    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_ptr)                   // rcx = ptr
    bytes_extend(ctx["code"], core.insn_lock_xadd_mr64_r64(1, 2))   // lock xadd [rcx], rdx (rdx := old)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 2))          // rax = old

    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_atomic_cas_x64(ctx, expr, locals) {
    // atomic_cas(ptr, expected, new) -> old value
    var args = _x64_atomic_cas_args(ctx, expr)
    if args == nil { return nil }

    // We need to preserve ptr and expected across evaluation of `new`.
    var state = _x64_atomic_cas_state(ctx, locals)
    if state == nil { return nil }
    var base = state[0]
    var tmp_ptr = state[1]
    var tmp_exp = state[2]

    if _x64_atomic_eval_spill_arg(ctx, locals, args[0], tmp_ptr) == nil { _intr_tmp_pop(ctx, base); return nil }
    if _x64_atomic_eval_spill_arg(ctx, locals, args[1], tmp_exp) == nil { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, args[2], locals) // new -> rax
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, 0))          // rdx = new

    _emit_mov_r64_mrbp(ctx, 1, 0 - tmp_ptr)                   // rcx = ptr
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_exp)                   // rax = expected (implicit cmpxchg operand)
    bytes_extend(ctx["code"], core.insn_lock_cmpxchg_mr64_r64(1, 2))// lock cmpxchg [rcx], rdx  (rax := old)

    _intr_tmp_pop(ctx, base)
    return nil
}
