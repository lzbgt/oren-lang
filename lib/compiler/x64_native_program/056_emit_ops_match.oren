    var x_name = lcg_op["name"]
    if x_name == nil || _x64_str_eq_bytes(x_name, idx_name) || _x64_str_eq_bytes(x_name, n_name) { return nil }
    if _x64_match_local_inty(ctx, locals, x_name) != true { return nil }
    return x_name
}

fn _x64_match_fast_lcg_update(lcg_op, x_name) {
    var lcg = _x64_match_lcg_update(lcg_op["expr"], x_name)
    if lcg == nil { return nil }
    return lcg
}

fn _x64_match_fast_lcg_mod_ok(ctx, locals, ids, x_name, mod_name, mod_const) {
    var idx_name = ids["idx"]
    var n_name = ids["n"]
    if mod_name != nil {
        if _x64_str_eq_bytes(mod_name, idx_name) || _x64_str_eq_bytes(mod_name, n_name) || _x64_str_eq_bytes(mod_name, x_name) { return false }
        if _x64_match_local_inty(ctx, locals, mod_name) != true { return false }
        return true
    }
    if mod_const == nil || mod_const <= 0 { return false }
    return true
}

fn _x64_pack_fast_lcg_source(x_name, lcg) {
    var mod_name = lcg["mod"]
    var mod_const = lcg["mod_const"]
    return {"x": x_name, "mod": mod_name, "mod_const": mod_const, "mul": lcg["mul"], "add": lcg["add"]}
}

fn _x64_match_fast_lcg_source(ctx, locals, ids, lcg_op) {
    var x_name = _x64_match_fast_lcg_source_name(ctx, locals, ids, lcg_op)
    if x_name == nil { return nil }
    var lcg = _x64_match_fast_lcg_update(lcg_op, x_name)
    if lcg == nil { return nil }
    if _x64_match_fast_lcg_mod_ok(ctx, locals, ids, x_name, lcg["mod"], lcg["mod_const"]) != true { return nil }
    return _x64_pack_fast_lcg_source(x_name, lcg)
}

fn _x64_match_fast_lcg_sum_accumulator(ctx, locals, ids, lcg, sum_op) {
    var idx_name = ids["idx"]
    var n_name = ids["n"]
    var x_name = lcg["x"]
    if sum_op == nil || sum_op["op"] != "assign_i32" { return nil }
    var sum_name = sum_op["name"]
    if sum_name == nil { return nil }
    if _x64_str_eq_bytes(sum_name, idx_name) || _x64_str_eq_bytes(sum_name, n_name) || _x64_str_eq_bytes(sum_name, x_name) { return nil }
    if _x64_match_local_inty(ctx, locals, sum_name) != true { return nil }

    var sum_info = _x64_match_sum_mod_update(sum_op["expr"], sum_name, x_name, idx_name, lcg["mod"], lcg["mod_const"])
    if sum_info == nil { return nil }
    if _x64_expr_is_inty(ctx, sum_op["expr"]) != true { return nil }
    return {"sum": sum_name, "mod_x": sum_info["mod_x"], "mod_i": sum_info["mod_i"]}
}

fn _x64_match_fast_lcg_sum_while(ctx, op, locals) {
    var ids = _x64_match_fast_lcg_sum_condition(ctx, op, locals)
    if ids == nil { return nil }
    var ops = _x64_match_fast_lcg_sum_body_ops(op, ids["idx"])
    if ops == nil { return nil }
    var lcg = _x64_match_fast_lcg_source(ctx, locals, ids, ops["lcg_op"])
    if lcg == nil { return nil }
    var sum = _x64_match_fast_lcg_sum_accumulator(ctx, locals, ids, lcg, ops["sum_op"])
    if sum == nil { return nil }

    return {
        "idx": ids["idx"],
        "n": ids["n"],
        "x": lcg["x"],
        "sum": sum["sum"],
        "mod": lcg["mod"],
        "mod_const": lcg["mod_const"],
        "mul": lcg["mul"],
        "add": lcg["add"],
        "mod_x": sum["mod_x"],
        "mod_i": sum["mod_i"]
    }
}

fn _x64_match_counted_loop_condition(op) {
    if op == nil || op["op"] != "while" { return nil }
    var cond = op["cond"]
    if cond == nil || cond["type"] != "Infix" { return nil }
    if cond["op"] != "<" { return nil }
    var idx_name = _x64_is_ident(cond["left"])
    if idx_name == nil { return nil }
    return {"idx": idx_name, "right": cond["right"]}
}

fn _x64_match_counted_loop_bound(right, allow_const_bound) {
    var n_name = _x64_is_ident(right)
    var n_const = nil
    if n_name == nil {
        if allow_const_bound != true { return nil }
        n_const = _x64_parse_int_lit_expr(right)
        if n_const == nil { return nil }
    }
    return {"n": n_name, "n_const": n_const}
}

fn _x64_match_counted_loop_locals(ctx, locals, idx_name, n_name, n_const) {
    if locals == nil { return false }
    var off_idx = locals[idx_name]
    if oren_type_tag(off_idx) == 0 { return false }
    if ctx["locals_inty"] != nil {
        if ctx["locals_inty"][idx_name] != true { return false }
        if n_name != nil && ctx["locals_inty"][n_name] != true { return false }
    }
    if n_name != nil {
        var off_n = locals[n_name]
        if oren_type_tag(off_n) == 0 { return false }
    } else if n_const < 0 {
        return false
    }
    return true
}

fn _x64_match_counted_loop_body(op, idx_name) {
    var body = op["body"]
    if body == nil { return nil }
    var n = oren_list_len(body)
    if n < 1 { return nil }
    var last = body[n - 1]
    if _x64_is_simple_inc_op(last, idx_name) != true { return nil }
    return {"body": body, "body_n": n}
}

fn _x64_match_fast_counted_int_loop_bound(ctx, op, locals, allow_const_bound) {
    var cond = _x64_match_counted_loop_condition(op)
    if cond == nil { return nil }
    var bound = _x64_match_counted_loop_bound(cond["right"], allow_const_bound)
    if bound == nil { return nil }
    var idx_name = cond["idx"]
    var n_name = bound["n"]
    var n_const = bound["n_const"]
    if _x64_match_counted_loop_locals(ctx, locals, idx_name, n_name, n_const) != true { return nil }
    var body_info = _x64_match_counted_loop_body(op, idx_name)
    if body_info == nil { return nil }
    var body = body_info["body"]
    var n = body_info["body_n"]
    return {"idx": idx_name, "n": n_name, "n_const": n_const, "body": body, "body_n": n}
}

fn _x64_match_fast_push_loop_body(ctx, locals, loop, list_kind) {
    var body = loop["body"]
    var n = loop["body_n"]
    var lists = []
    var pushes = []
    var i = 0
    while i < n - 1 {
        var info = _x64_match_fast_push_loop_step(ctx, locals, body[i], list_kind, lists)
        if info == nil { return nil }
        _x64_match_fast_push_record_step(lists, pushes, info)
        i = i + 1
    }
    if oren_list_len(lists) == 0 { return nil }
    if _x64_match_fast_push_values_independent(pushes, lists) != true { return nil }
    return {"lists": lists, "pushes": pushes}
}

fn _x64_match_fast_push_call_info(ctx, exp, list_kind) {
    if list_kind == "list_int" { return _x64_is_list_int_push_call(ctx, exp) }
    return _x64_is_list_push_call(ctx, exp)
}

fn _x64_match_fast_push_validate_info(ctx, locals, info, list_kind, lists) {
    if info == nil { return false }
    var list_name = info["list"]
    if oren_type_tag(locals[list_name]) == 0 { return false }
    if _x64_list_contains(lists, list_name) { return false }
    if list_kind == "list_int" && _x64_expr_is_inty(ctx, info["value"]) != true { return false }
    return true
}

fn _x64_match_fast_push_loop_step(ctx, locals, st, list_kind, lists) {
    if st == nil || st["op"] != "expr" { return nil }
    var info = _x64_match_fast_push_call_info(ctx, st["expr"], list_kind)
    if _x64_match_fast_push_validate_info(ctx, locals, info, list_kind, lists) != true { return nil }
    return info
}

fn _x64_match_fast_push_record_step(lists, pushes, info) {
    oren_list_push(lists, info["list"])
    oren_list_push(pushes, info)
    return nil
}

fn _x64_match_fast_push_values_independent(pushes, lists) {
    var pi = 0
    while pi < oren_list_len(pushes) {
        if _x64_expr_uses_any_ident(pushes[pi]["value"], lists) { return false }
        pi = pi + 1
    }
    return true
}

fn _x64_match_fast_push_while(ctx, op, locals, list_kind) {
    var loop = _x64_match_fast_counted_int_loop_bound(ctx, op, locals, true)
    if loop == nil { return nil }
    var body = _x64_match_fast_push_loop_body(ctx, locals, loop, list_kind)
    if body == nil { return nil }
    return {"idx": loop["idx"], "n": loop["n"], "n_const": loop["n_const"], "lists": body["lists"], "pushes": body["pushes"]}
}

fn _x64_match_fast_list_int_push_while(ctx, op, locals) {
    return _x64_match_fast_push_while(ctx, op, locals, "list_int")
}

fn _x64_match_fast_list_push_while(ctx, op, locals) {
    return _x64_match_fast_push_while(ctx, op, locals, "list")
}

fn _x64_match_fast_counted_int_loop(ctx, op, locals) {
    return _x64_match_fast_counted_int_loop_bound(ctx, op, locals, false)
}

fn _x64_match_fast_list_int_get_sum_body(ctx, locals, loop) {
    return _x64_match_fast_get_sum_body(ctx, locals, loop, true)
}

fn _x64_match_fast_get_step(ctx, body, i, idx_name, locals, use_list_int) {
    if use_list_int == true {
        return _x64_match_sum_add_list_int_get_step(ctx, body, i, idx_name, locals)
    }
    return _x64_match_sum_add_list_get_step(ctx, body, i, idx_name, locals)
}

fn _x64_match_fast_get_sum_name(sum_name, info) {
    if sum_name == nil { return info["sum"] }
    if _x64_str_eq_bytes(sum_name, info["sum"]) != true { return nil }
    return sum_name
}

fn _x64_match_fast_get_validate_sum(ctx, locals, sum_name, step, use_list_int) {
    if oren_type_tag(locals[sum_name]) == 0 { return false }
    if use_list_int != true { return true }
    if ctx["locals_inty"] != nil && ctx["locals_inty"][sum_name] != true { return false }
    if step["sum_expr_inty_ok"] != true && _x64_expr_is_inty(ctx, step["sum_op"]["expr"]) != true { return false }
    return true
}

fn _x64_match_fast_get_record_load(lists, loads, list_name) {
    if _x64_list_contains(lists, list_name) == false { oren_list_push(lists, list_name) }
    oren_list_push(loads, list_name)
    return nil
}

fn _x64_match_fast_get_accumulate_step(ctx, locals, state, step, use_list_int) {
    var info = step["info"]
    var sum_name = _x64_match_fast_get_sum_name(state["sum"], info)
    if sum_name == nil { return nil }
    if _x64_match_fast_get_validate_sum(ctx, locals, sum_name, step, use_list_int) != true { return nil }
    var list_name = info["list"]
    if oren_type_tag(locals[list_name]) == 0 { return nil }
    _x64_match_fast_get_record_load(state["lists"], state["loads"], list_name)
    state["sum"] = sum_name
    return state
}

fn _x64_match_fast_get_sum_body(ctx, locals, loop, use_list_int) {
    var body = loop["body"]
    var idx_name = loop["idx"]
    var n = loop["body_n"]
    var state = {"sum": nil, "lists": [], "loads": []}
    var i = 0
    while i < n - 1 {
        var step = _x64_match_fast_get_step(ctx, body, i, idx_name, locals, use_list_int)
        if step == nil { return nil }
        if _x64_match_fast_get_accumulate_step(ctx, locals, state, step, use_list_int) == nil { return nil }
        i = step["next_i"]
    }
    var sum_name = state["sum"]
    if sum_name == nil { return nil }
    if oren_list_len(state["loads"]) == 0 { return nil }
    var sum_inty = false
    if ctx["locals_inty"] != nil && ctx["locals_inty"][sum_name] == true { sum_inty = true }
    return {"sum": sum_name, "lists": state["lists"], "loads": state["loads"], "sum_inty": sum_inty}
}

fn _x64_list_int_fast_sum_dot_enabled() {
    return true
}

fn _x64_match_fast_list_int_get_sum_while(ctx, op, locals) {
    if _x64_list_int_fast_sum_dot_enabled() != true { return nil }
    var loop = _x64_match_fast_counted_int_loop(ctx, op, locals)
    if loop == nil { return nil }
    var body = _x64_match_fast_list_int_get_sum_body(ctx, locals, loop)
    if body == nil { return nil }
    return {
        "idx": loop["idx"],
        "n": loop["n"],
        "sum": body["sum"],
        "lists": body["lists"],
        "loads": body["loads"],
        "sum_inty": body["sum_inty"]
    }
}

fn _x64_match_fast_list_get_sum_body(ctx, locals, loop) {
    return _x64_match_fast_get_sum_body(ctx, locals, loop, false)
}

fn _x64_match_fast_list_get_sum_while(ctx, op, locals) {
    var loop = _x64_match_fast_counted_int_loop(ctx, op, locals)
    if loop == nil { return nil }
    var body = _x64_match_fast_list_get_sum_body(ctx, locals, loop)
    if body == nil { return nil }
    // The x64 boxed-list fast path keeps the running sum/value in registers. Its dynamic-add
    // branch calls runtime helpers, and internal Oren calls are treated as all-register volatile.
    // Keep the fast path only when the sum is proven integer and no dynamic string/add calls emit.
    if body["sum_inty"] != true { return nil }
    return {
        "idx": loop["idx"],
        "n": loop["n"],
        "sum": body["sum"],
        "lists": body["lists"],
        "loads": body["loads"],
        "sum_inty": body["sum_inty"]
    }
}

fn _x64_match_fast_dot_step(ctx, body, i, idx_name, locals, use_list_int) {
    if use_list_int == true {
        return _x64_match_sum_add_list_int_mul_get_step(ctx, body, i, idx_name, locals)
    }
    return _x64_match_sum_add_list_mul_get_step(ctx, body, i, idx_name, locals)
}

fn _x64_match_fast_dot_sum_name(sum_name, info) {
    if sum_name == nil { return info["sum"] }
    if _x64_str_eq_bytes(sum_name, info["sum"]) != true { return nil }
    return sum_name
}

fn _x64_match_fast_dot_validate_sum(ctx, locals, sum_name, step, use_list_int) {
    if oren_type_tag(locals[sum_name]) == 0 { return false }
    if ctx["locals_inty"] != nil && ctx["locals_inty"][sum_name] != true { return false }
    if use_list_int == true && step["sum_expr_inty_ok"] != true && _x64_expr_is_inty(ctx, step["sum_op"]["expr"]) != true { return false }
    return true
}

fn _x64_match_fast_dot_validate_lists(locals, info) {
    var left_list = info["left"]
    var right_list = info["right"]
    if oren_type_tag(locals[left_list]) == 0 || oren_type_tag(locals[right_list]) == 0 { return false }
    return true
}

fn _x64_match_fast_dot_record_lists(lists, info) {
    var left_list = info["left"]
    var right_list = info["right"]
    if _x64_list_contains(lists, left_list) == false { oren_list_push(lists, left_list) }
    if _x64_list_contains(lists, right_list) == false { oren_list_push(lists, right_list) }
    return nil
}

fn _x64_match_fast_dot_record_mul(muls, info) {
    oren_list_push(muls, {"left": info["left"], "right": info["right"]})
    return nil
}

fn _x64_match_fast_dot_accumulate_step(ctx, locals, state, step, use_list_int) {
    var info = step["info"]
    var sum_name = _x64_match_fast_dot_sum_name(state["sum"], info)
    if sum_name == nil { return nil }
    if _x64_match_fast_dot_validate_sum(ctx, locals, sum_name, step, use_list_int) != true { return nil }
    if _x64_match_fast_dot_validate_lists(locals, info) != true { return nil }
    _x64_match_fast_dot_record_lists(state["lists"], info)
    _x64_match_fast_dot_record_mul(state["muls"], info)
    state["sum"] = sum_name
    return state
}

fn _x64_match_fast_dot_accumulate_body(ctx, locals, loop, use_list_int) {
    var body = loop["body"]
    var idx_name = loop["idx"]
    var n = loop["body_n"]
    var state = {"sum": nil, "lists": [], "muls": []}
    var i = 0
    while i < n - 1 {
        var step = _x64_match_fast_dot_step(ctx, body, i, idx_name, locals, use_list_int)
        if step == nil { return nil }
        if _x64_match_fast_dot_accumulate_step(ctx, locals, state, step, use_list_int) == nil { return nil }
        i = step["next_i"]
    }
    if state["sum"] == nil { return nil }
    if oren_list_len(state["muls"]) == 0 { return nil }
    return {"sum": state["sum"], "lists": state["lists"], "muls": state["muls"]}
}

fn _x64_match_fast_dot_while(ctx, op, locals, use_list_int) {
    var loop = _x64_match_fast_counted_int_loop(ctx, op, locals)
    if loop == nil { return nil }
    var body = _x64_match_fast_dot_accumulate_body(ctx, locals, loop, use_list_int)
    if body == nil { return nil }
    return {"idx": loop["idx"], "n": loop["n"], "sum": body["sum"], "lists": body["lists"], "muls": body["muls"]}
}

fn _x64_match_fast_list_int_dot_while(ctx, op, locals) {
    if _x64_list_int_fast_sum_dot_enabled() != true { return nil }
    return _x64_match_fast_dot_while(ctx, op, locals, true)
}

fn _x64_match_fast_list_dot_while(ctx, op, locals) {
    if _x64_env_enabled_default_false("OREN_X64_FAST_LIST_DOT") != true { return nil }
    return _x64_match_fast_dot_while(ctx, op, locals, false)
}
