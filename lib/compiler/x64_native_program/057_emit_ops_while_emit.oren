fn _x64_fastmod_recip_u64(d) {
    if d == nil { return nil }
    if d < 3 { return nil }
    // Keep math in signed i64 range: require d <= 2^31-1.
    if d > 2147483647 { return nil }
    var base = 4294967296
    var q1 = base / d
    var r1 = base - (q1 * d)
    var q0 = (r1 * base) / d
    return (q1 * base) + q0
}

fn _emit_fastmod_u64_const_x64(ctx, n_reg, d_reg, recip, dst_reg, tmp_recip_reg, labels, local_fixups, tag) {
