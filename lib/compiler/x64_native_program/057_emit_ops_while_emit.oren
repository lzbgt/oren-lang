fn _x64_list_fast_trace_append_info(msg, info) {
    if info != nil {
        if info["idx"] != nil { msg = msg + " idx=" + info["idx"] }
        if info["n"] != nil { msg = msg + " n=" + info["n"] }
        if info["sum"] != nil { msg = msg + " sum=" + info["sum"] }
        if info["lists"] != nil { msg = msg + " lists=" + oren_int_to_string(oren_list_len(info["lists"])) }
        if info["loads"] != nil { msg = msg + " loads=" + oren_int_to_string(oren_list_len(info["loads"])) }
        if info["muls"] != nil { msg = msg + " muls=" + oren_int_to_string(oren_list_len(info["muls"])) }
    }
    return msg
}

fn _trace_x64_list_fast_loop(ctx, kind, info) {
