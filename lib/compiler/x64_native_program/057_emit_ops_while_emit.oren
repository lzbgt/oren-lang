}

fn _x64_fast_list_int_push_validate_tracked_list(ctx, st, l_slow, local_fixups) {
    if _x64_fast_push_validate_tracked_node(ctx, l_slow, local_fixups) != true { return false }
    _x64_fast_push_validate_tracked_kind(ctx, 8, l_slow, local_fixups)
    _x64_fast_push_validate_list_magic(ctx, st["slot_list"], l_slow, local_fixups)
    return true
}

fn _x64_fast_list_int_push_validate_count_and_buf(ctx, prep, st, labels, l_slow, local_fixups) {
    var l_cap_ok = _new_label(ctx, "list_push_cap_ok")
    _x64_fast_list_int_push_reserve_if_needed(ctx, prep, labels, local_fixups, st["slot_list"], l_cap_ok)

    // count == i
    _emit_mov_r64_mrbp(ctx, 10, 0 - st["slot_list"])
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    _emit_mov_r64_mrbp(ctx, 9, 0 - prep["off_idx"])
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_slow)

    // buf -> slot
    _emit_mov_r64_mrbp(ctx, 10, 0 - st["slot_list"])
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 16))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    _emit_mov_mrbp_r64(ctx, 0 - st["slot_buf"], 0)
    return nil
}

fn _x64_fast_list_int_push_validate_one_list(ctx, prep, locals, labels, label_names, local_fixups, li) {
    var st = _x64_fast_list_int_push_list_state(ctx, prep, locals, li)
    if st == nil { return false }
    var l_slow = label_names["slow"]

    _x64_fast_list_int_push_capture_list(ctx, st, l_slow, local_fixups)
    if _x64_fast_list_int_push_validate_tracked_list(ctx, st, l_slow, local_fixups) != true { return false }
    _x64_fast_list_int_push_validate_count_and_buf(ctx, prep, st, labels, l_slow, local_fixups)
    return true
}

fn _x64_fast_list_int_push_validate_lists(ctx, prep, locals, labels, label_names, local_fixups) {
    var list_count = prep["list_count"]

    _x64_fast_list_int_push_emit_entry_gates(ctx, prep, label_names, local_fixups)
    var li = 0
    while li < list_count {
        if _x64_fast_list_int_push_validate_one_list(ctx, prep, locals, labels, label_names, local_fixups, li) != true { return false }
        li = li + 1
    }
    return true
}

fn _x64_fast_push_list_index(lists, list_count, list_name) {
    var list_index = 0
    while list_index < list_count {
        if _x64_str_eq_bytes(lists[list_index], list_name) { return list_index }
        list_index = list_index + 1
