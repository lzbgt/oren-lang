        _emit_mov_r64_mrbp(ctx, a0, 0 - slot_list)
        _emit_mov_r64_mrbp(ctx, a1, 0 - off_n)
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(a2, 8))
        _emit_call_rel32_named_x64(ctx, "oren_trace_list_reserve_fast")
