fn _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, loop_cond_label, loop_end_label) {
    var cond_label = _new_label(ctx, "while_cond")
    var body_label = _new_label(ctx, "while_body")
    var end_label2 = _new_label(ctx, "while_end")

    _emit_label(ctx, labels, cond_label)
    if _x64_native_block_weighted_gas_enabled(ctx) == true {
        _emit_native_gas_note_x64(ctx, 2)
    }
    _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, 1023)
    var dynamic_cond_note = nil
    var dynamic_cond_start = nil
    if _x64_native_dynamic_emitter_gas_enabled(ctx) == true {
        dynamic_cond_note = _emit_native_gas_note_x64_patchable_u32(ctx)
        dynamic_cond_start = bytes_len(ctx["code"])
    }
    _emit_jcc_false_for_cond_x64(ctx, op["cond"], locals, local_fixups, end_label2)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    if dynamic_cond_note != nil && dynamic_cond_start != nil {
        _patch_native_gas_note_x64_u32(ctx, dynamic_cond_note, bytes_len(ctx["code"]) - dynamic_cond_start)
    }

    _emit_label(ctx, labels, body_label)
    _emit_ops_in_fn(ctx, op["body"], locals, labels, local_fixups, epilogue_label, platform, cond_label, end_label2)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    _emit_jmp_to_label(ctx, local_fixups, cond_label)
    _emit_label(ctx, labels, end_label2)
    return nil
}

fn _emit_trace_list_header_x64(ctx, list_reg, op, kind) {
    if ctx == nil { return nil }
    if ctx["trace_native_list_hdr"] == nil { return nil }

    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    var a1_enc = abi.int_arg_reg(ctx["abi"], 1)
    var a2_enc = abi.int_arg_reg(ctx["abi"], 2)
    if oren_type_tag(a0_enc) == 0 || oren_type_tag(a1_enc) == 0 || oren_type_tag(a2_enc) == 0 {
        err(ctx, "x64 native v0: missing ABI arg regs for list trace")
        return nil
    }

    var a0 = a0_enc - 1
    var a1 = a1_enc - 1
    var a2 = a2_enc - 1
    if a0 != list_reg { bytes_extend(ctx["code"], core.insn_mov_r64_r64(a0, list_reg)) }
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(a1, op))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(a2, kind))
    var call_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_call_rel32(0))
    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "oren_trace_list_header"})
    return nil
}

