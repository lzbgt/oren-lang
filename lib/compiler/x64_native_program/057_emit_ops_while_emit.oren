fn _x64_fast_push_alloc_base(ctx, locals, inputs, offsets) {
    var list_count = inputs["list_count"]
    var extra = 0
    if inputs["n"] == nil { extra = 1 }
    var base = _intr_tmp_push(ctx, iadd(list_count, list_count) + extra)
    if oren_type_tag(base) == 0 { return nil }
    var off_n = offsets["off_n"]
    if inputs["n"] == nil {
