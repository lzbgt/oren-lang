fn _x64_fast_push_emit_indexed_buffer_store(ctx, prep, slots) {
    _emit_mov_r64_mrbp(ctx, 10, 0 - prep["off_idx"])
    _emit_mov_r64_mrbp(ctx, 11, 0 - slots["buf"])
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 10))
    bytes_extend(ctx["code"], core.insn_shl_r64_imm8(12, 3))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(12, 11))
    bytes_extend(ctx["code"], core.insn_mov_mr64_r64(12, 0))
    return nil
}

fn _x64_fast_push_emit_value_store(ctx, prep, locals, push) {
    var slots = _x64_fast_push_value_store_slots(ctx, prep, locals, push)
    if slots == nil { return false }
    if _x64_fast_push_emit_value_to_rax(ctx, locals, push) != true { return false }
    _x64_fast_push_emit_indexed_buffer_store(ctx, prep, slots)
    return true
}

fn _x64_fast_list_int_push_emit_loop(ctx, prep, locals, labels, label_names, local_fixups) {
    var pushes = prep["pushes"]
    var off_idx = prep["off_idx"]
    var off_n = prep["off_n"]
    var l_fast_cond = label_names["cond"]
    var l_fast_end = label_names["end"]

    _emit_label(ctx, labels, l_fast_cond)
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    _emit_mov_r64_mrbp(ctx, 9, 0 - off_n)
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_end)

    _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, 1023)

    var pi = 0
    while pi < oren_list_len(pushes) {
        if _x64_fast_push_emit_value_store(ctx, prep, locals, pushes[pi]) != true { return false }
        pi = pi + 1
    }

    // i++
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(0, 1))
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 0)

    _emit_jmp_to_label(ctx, local_fixups, l_fast_cond)

    _emit_label(ctx, labels, l_fast_end)
    return true
}

fn _x64_fast_list_int_push_update_counts(ctx, prep, locals) {
    var list_count = prep["list_count"]
    var base = prep["base"]
    var off_idx = prep["off_idx"]

    // Update list counts after loop exit.
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_idx)
    var li2 = 0
    while li2 < list_count {
        var slot_list3 = _intr_tmp_off(ctx, locals, base + li2 * 2)
        if oren_type_tag(slot_list3) == 0 { return false }
        _emit_mov_r64_mrbp(ctx, 13, 0 - slot_list3)
        bytes_extend(ctx["code"], core.insn_mov_mr64_r64(13, 10))
        _emit_trace_list_header_ring_x64(ctx, 13, 7, 8) // list_int_push / LIST_INT
