    return list_count
}

fn _x64_fast_push_slots(ctx, prep, locals, list_index) {
    var base = prep["base"]
    var slot_list = _intr_tmp_off(ctx, locals, base + list_index * 2)
    var slot_buf = _intr_tmp_off(ctx, locals, base + list_index * 2 + 1)
    if oren_type_tag(slot_list) == 0 || oren_type_tag(slot_buf) == 0 { return nil }
