fn _x64_fastmod_recip_u64(d) {
    if d == nil { return nil }
    if d < 3 { return nil }
    // Keep math in signed i64 range: require d <= 2^31-1.
    if d > 2147483647 { return nil }
    var base = 4294967296
    var q1 = base / d
    var r1 = base - (q1 * d)
    var q0 = (r1 * base) / d
    return (q1 * base) + q0
}

fn _emit_fastmod_u64_const_x64(ctx, n_reg, d_reg, recip, dst_reg, tmp_recip_reg, labels, local_fixups, tag) {
    if ctx == nil || recip == nil { return nil }
    if tmp_recip_reg == nil { return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(tmp_recip_reg, recip))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, n_reg)) // rax = n
    bytes_extend(ctx["code"], core.insn_mul_r64(tmp_recip_reg)) // rdx:rax = n * recip
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 2)) // rax = q (high)
    bytes_extend(ctx["code"], core.insn_imul_r64_r64(0, d_reg)) // rax = q * d
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, n_reg)) // rdx = n
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(2, 0)) // rdx = r
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(2, d_reg))
    var l_ok = _new_label(ctx, "fastmod_ok_" + tag)
    _emit_jcc_to_label(ctx, local_fixups, "lt", l_ok)
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(2, d_reg))
    _emit_label(ctx, labels, l_ok)
    if dst_reg != 2 { bytes_extend(ctx["code"], core.insn_mov_r64_r64(dst_reg, 2)) }
    return nil
}

