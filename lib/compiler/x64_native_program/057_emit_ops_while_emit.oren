}

fn _x64_fast_list_int_push_emit_entry_gates(ctx, prep, label_names, local_fixups) {
    var off_idx = prep["off_idx"]
    var off_n = prep["off_n"]
    var l_slow = label_names["slow"]

    // i < 0 => slow
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_slow)

    // n < 0 => slow
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_n)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_slow)
    return nil
}

fn _x64_fast_list_int_push_reserve_if_needed(ctx, prep, labels, local_fixups, slot_list, l_cap_ok) {
    var off_n = prep["off_n"]
    var a0 = prep["a0"]
    var a1 = prep["a1"]
    var a2 = prep["a2"]
    var trace_reserve = prep["trace_reserve"]

    // cap >= n (else reserve)
    _emit_mov_r64_mrbp(ctx, 10, 0 - slot_list)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 8))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    _emit_mov_r64_mrbp(ctx, 9, 0 - off_n)
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_cap_ok)

    // list_int_reserve(list, n)
    if trace_reserve {
        _emit_mov_r64_mrbp(ctx, a0, 0 - slot_list)
        _emit_mov_r64_mrbp(ctx, a1, 0 - off_n)
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(a2, 8))
        _emit_call_rel32_named_x64(ctx, "oren_trace_list_reserve_fast")
    }
    _emit_mov_r64_mrbp(ctx, a0, 0 - slot_list)
    _emit_mov_r64_mrbp(ctx, a1, 0 - off_n)
    _emit_call_rel32_named_x64(ctx, "oren_list_int_reserve")

    _emit_label(ctx, labels, l_cap_ok)
    return nil
}

fn _x64_fast_list_int_push_list_state(ctx, prep, locals, li) {
    var base = prep["base"]
    var list_name = prep["lists"][li]
    var off_list = locals[list_name]
    if oren_type_tag(off_list) == 0 { return nil }
    var slot_list = _intr_tmp_off(ctx, locals, base + li * 2)
    var slot_buf = _intr_tmp_off(ctx, locals, base + li * 2 + 1)
    if oren_type_tag(slot_list) == 0 || oren_type_tag(slot_buf) == 0 { return nil }
    return {"off_list": off_list, "slot_list": slot_list, "slot_buf": slot_buf}
}

fn _x64_fast_list_int_push_capture_list(ctx, st, l_slow, local_fixups) {
    // list -> slot
    _emit_mov_r64_mrbp(ctx, 0, 0 - st["off_list"])
