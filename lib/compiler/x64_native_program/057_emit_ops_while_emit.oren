    var a2 = a2_enc - 1
    if a0 != list_reg { bytes_extend(ctx["code"], core.insn_mov_r64_r64(a0, list_reg)) }
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(a1, op))
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(a2, kind))
    var call_pos = bytes_len(ctx["code"])
