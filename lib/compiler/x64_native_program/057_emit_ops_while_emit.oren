fn _x64_fast_list_get_sum_emit_single(ctx, locals, labels, local_fixups, lists, loads, list_count, base, off_sum, off_idx, unique_lists, sum_inty, a0, a1) {
    _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, 1023)

    // sum -> rdx. Avoid r14/r15: x64 native uses them as allocator registers across calls.
    _emit_mov_r64_mrbp(ctx, 2, 0 - off_sum)

    var pi = 0
    while pi < oren_list_len(loads) {
