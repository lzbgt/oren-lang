        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(0, inputs["n_const"]))
        _emit_mov_mrbp_r64(ctx, 0 - n_slot, 0)
        off_n = n_slot
    }
    return {"base": base, "off_n": off_n}
}

