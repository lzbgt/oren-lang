    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 1279870019))
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_slow)
