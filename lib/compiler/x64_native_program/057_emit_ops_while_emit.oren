fn _emit_fast_lcg_sum_while_x64(ctx, op, info, locals, labels, local_fixups, epilogue_label, platform) {
    if ctx == nil || op == nil || info == nil { return nil }
    if locals == nil { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }
    if ctx["runtime_injected"] != true { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }

    var prep = _x64_fast_lcg_prepare(ctx, info, locals)
    if prep == nil { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }
    var mod_name = prep["mod"]
    var mod_const = prep["mod_const"]
    var mul = prep["mul"]
    var add = prep["add"]
    var mod_x = prep["mod_x"]
    var mod_i = prep["mod_i"]
    var sum_cap = prep["sum_cap"]
    var mod_recip = prep["mod_recip"]
    var modx_recip = prep["modx_recip"]
    var modi_recip = prep["modi_recip"]
    var use_fastmod = prep["use_fastmod"]
    var off_idx = prep["off_idx"]
    var off_n = prep["off_n"]
    var off_x = prep["off_x"]
    var off_sum = prep["off_sum"]
    var off_mod = prep["off_mod"]
    var base = prep["base"]
    var off_i_mod = prep["off_i_mod"]

    var l_slow = _new_label(ctx, "lcg_sum_slow")
    var l_fast_cond = _new_label(ctx, "lcg_sum_cond")
    var l_fast_cond_mod = _new_label(ctx, "lcg_sum_cond_mod")
    var l_fast_end = _new_label(ctx, "lcg_sum_end")
    var l_fast_single = _new_label(ctx, "lcg_sum_single")
    var l_fast_end_mod = _new_label(ctx, "lcg_sum_end_mod")
    var l_done = _new_label(ctx, "lcg_sum_done")

    // mod <= 0 => slow
    if mod_name != nil {
        _emit_mov_r64_mrbp(ctx, 12, 0 - off_mod)
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(12, mod_const))
    }
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(12, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_slow)

    // i/n/x/sum < 0 => full-mod fast loop
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "lt", l_fast_cond_mod)
    _emit_mov_r64_mrbp(ctx, 1, 0 - off_n)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(1, 0))
    _emit_jcc_to_label(ctx, local_fixups, "lt", l_fast_cond_mod)
    _emit_mov_r64_mrbp(ctx, 2, 0 - off_x)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(2, 0))
    _emit_jcc_to_label(ctx, local_fixups, "lt", l_fast_cond_mod)
    _emit_mov_r64_mrbp(ctx, 4, 0 - off_sum)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(4, 0))
    _emit_jcc_to_label(ctx, local_fixups, "lt", l_fast_cond_mod)

    // mod < (mod_x + mod_i) => full-mod fast loop
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(9, sum_cap))
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(12, 9))
    _emit_jcc_to_label(ctx, local_fixups, "lt", l_fast_cond_mod)

    // constants in callee-saved regs (survive runtime calls)
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(13, mul))  // r13 = mul
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(14, add))  // r14 = add
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(15, mod_x)) // r15 = mod_x
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(3, mod_i)) // rbx = mod_i

    // tick (r8) for throttled safepoint
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8))

    // load loop vars into regs once
    _emit_mov_r64_mrbp(ctx, 9, 0 - off_idx) // r9 = i
    _emit_mov_r64_mrbp(ctx, 1, 0 - off_n)   // rcx = n
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_x)  // r10 = x
    _emit_mov_r64_mrbp(ctx, 11, 0 - off_sum) // r11 = sum
    if mod_name != nil {
        _emit_mov_r64_mrbp(ctx, 12, 0 - off_mod) // r12 = mod
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(12, mod_const))
    }

    // i_mod = i % mod_i (fast path only)
    if use_fastmod == true {
        _emit_fastmod_u64_const_x64(ctx, 9, 3, modi_recip, 7, 6, labels, local_fixups, "lcg_i_mod")
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 9))
        bytes_extend(ctx["code"], core.insn_xor_r64_r64(2, 2)) // rdx = 0
        bytes_extend(ctx["code"], core.insn_div_r64(3)) // rbx
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 2)) // rdi = rdx
    }

    _emit_label(ctx, labels, l_fast_cond)
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(9, 1))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_end)

    // Inline throttled safepoint without per-iter tick loads/stores.
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(8, 1))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 8))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(0, 4095))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_sp_skip = _new_label(ctx, "lcg_sum_sp_skip")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_sp_skip)
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 9)
    _emit_mov_mrbp_r64(ctx, 0 - off_x, 10)
    _emit_mov_mrbp_r64(ctx, 0 - off_sum, 11)
    _emit_mov_mrbp_r64(ctx, 0 - off_i_mod, 7)
    _emit_gc_safepoint_call_x64(ctx)
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8)) // reset tick after safepoint
    _emit_mov_r64_mrbp(ctx, 9, 0 - off_idx)
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_x)
    _emit_mov_r64_mrbp(ctx, 11, 0 - off_sum)
    _emit_mov_r64_mrbp(ctx, 7, 0 - off_i_mod)
    _emit_mov_r64_mrbp(ctx, 1, 0 - off_n)
    _emit_label(ctx, labels, l_sp_skip)

    // If i + 1 >= n, run single-iter path.
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 9))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(0, 1))
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 1))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_single)

    var rep = 0
    while rep < 2 {
        _x64_fast_lcg_emit_unsigned_step(ctx, use_fastmod, mod_recip, modx_recip, labels, local_fixups)
        rep = rep + 1
    }

    // i += 2
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(9, 2))
    _emit_jmp_to_label(ctx, local_fixups, l_fast_cond)

    _emit_label(ctx, labels, l_fast_single)

    _x64_fast_lcg_emit_unsigned_step(ctx, use_fastmod, mod_recip, modx_recip, labels, local_fixups)

    // i++
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(9, 1))
    _emit_jmp_to_label(ctx, local_fixups, l_fast_cond)

    _emit_label(ctx, labels, l_fast_end)
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 9)
    _emit_mov_mrbp_r64(ctx, 0 - off_x, 10)
    _emit_mov_mrbp_r64(ctx, 0 - off_sum, 11)
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_fast_cond_mod)
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx) // rax = i
    _emit_mov_r64_mrbp(ctx, 1, 0 - off_n)   // rcx = n
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 1))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_end_mod)

    // Inline throttled safepoint without per-iter tick loads/stores.
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(8, 1))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 8))
    bytes_extend(ctx["code"], core.insn_and_r64_imm32(0, 4095))
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    var l_sp_skip_mod = _new_label(ctx, "lcg_sum_sp_skip_mod")
    _emit_jcc_to_label(ctx, local_fixups, "ne", l_sp_skip_mod)
    _emit_gc_safepoint_call_x64(ctx)
    bytes_extend(ctx["code"], core.insn_xor_r64_r64(8, 8)) // reset tick after safepoint
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(9, 4095))
    _emit_label(ctx, labels, l_sp_skip_mod)

    // reload i/x/sum/mod
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx) // rax = i
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_x)  // r10 = x
    _emit_mov_r64_mrbp(ctx, 11, 0 - off_sum) // r11 = sum
    if mod_name != nil {
        _emit_mov_r64_mrbp(ctx, 12, 0 - off_mod) // r12 = mod
    } else {
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(12, mod_const))
    }

    // x = x*mul + add
    bytes_extend(ctx["code"], core.insn_imul_r64_r64(10, 13))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(10, 14))

    // x = x % mod
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_idiv_r64(12))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 2)) // r10 = rdx

    // term_x = x % mod_x
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_idiv_r64(15))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(6, 2)) // rsi = rdx

    // term_i = i % mod_i
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_idiv_r64(3)) // rbx
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(7, 2)) // rdi = rdx

    // sum = (sum + term_x + term_i) % mod
    bytes_extend(ctx["code"], core.insn_add_r64_r64(11, 6))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(11, 7))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 11))
    bytes_extend(ctx["code"], core.insn_cqo())
    bytes_extend(ctx["code"], core.insn_idiv_r64(12))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(11, 2)) // r11 = rdx

    _emit_mov_mrbp_r64(ctx, 0 - off_x, 10)
    _emit_mov_mrbp_r64(ctx, 0 - off_sum, 11)

    // i++
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(0, 1))
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 0)

    _emit_jmp_to_label(ctx, local_fixups, l_fast_cond_mod)

    _emit_label(ctx, labels, l_fast_end_mod)
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _emit_label(ctx, labels, l_slow)
    _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    _emit_label(ctx, labels, l_done)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _x64_fast_list_get_sum_prepare(ctx, info, locals) {
