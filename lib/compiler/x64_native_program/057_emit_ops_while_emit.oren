    oren_list_push(ctx["fixups"], {"type": "call_rel32", "pos": call_pos, "name": "oren_trace_list_header"})
    return nil
}

fn _x64_list_fast_trace_base_msg(ctx, kind) {
    var fnn = "?"
    if ctx["cur_fn_name"] != nil { fnn = ctx["cur_fn_name"] }
    return "[x64_list_fast] fn=" + fnn + " kind=" + kind
}

fn _x64_list_fast_trace_append_info(msg, info) {
    if info != nil {
        if info["idx"] != nil { msg = msg + " idx=" + info["idx"] }
        if info["n"] != nil { msg = msg + " n=" + info["n"] }
        if info["sum"] != nil { msg = msg + " sum=" + info["sum"] }
        if info["lists"] != nil { msg = msg + " lists=" + oren_int_to_string(oren_list_len(info["lists"])) }
        if info["loads"] != nil { msg = msg + " loads=" + oren_int_to_string(oren_list_len(info["loads"])) }
        if info["muls"] != nil { msg = msg + " muls=" + oren_int_to_string(oren_list_len(info["muls"])) }
    }
    return msg
}

fn _trace_x64_list_fast_loop(ctx, kind, info) {
    if ctx == nil { return nil }
    if ctx["trace_x64_list_fast"] == nil { return nil }
    var msg = _x64_list_fast_trace_base_msg(ctx, kind)
    msg = _x64_list_fast_trace_append_info(msg, info)
    print(msg)
    return nil
}

fn _x64_env_enabled_default_false(name) {
    var v = oren_env(name)
    if v == "1" || v == "true" { return true }
    return false
}

fn _x64_fastmod_recip_u64(d) {
    if d == nil { return nil }
    if d < 3 { return nil }
    // Keep math in signed i64 range: require d <= 2^31-1.
    if d > 2147483647 { return nil }
    var base = 4294967296
    var q1 = base / d
    var r1 = base - (q1 * d)
    var q0 = (r1 * base) / d
    return (q1 * base) + q0
}

fn _emit_fastmod_u64_const_x64(ctx, n_reg, d_reg, recip, dst_reg, tmp_recip_reg, labels, local_fixups, tag) {
    if ctx == nil || recip == nil { return nil }
    if tmp_recip_reg == nil { return nil }
    bytes_extend(ctx["code"], core.insn_mov_r64_imm64(tmp_recip_reg, recip))
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, n_reg)) // rax = n
    bytes_extend(ctx["code"], core.insn_mul_r64(tmp_recip_reg)) // rdx:rax = n * recip
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 2)) // rax = q (high)
    bytes_extend(ctx["code"], core.insn_imul_r64_r64(0, d_reg)) // rax = q * d
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(2, n_reg)) // rdx = n
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(2, 0)) // rdx = r
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(2, d_reg))
    var l_ok = _new_label(ctx, "fastmod_ok_" + tag)
    _emit_jcc_to_label(ctx, local_fixups, "lt", l_ok)
    bytes_extend(ctx["code"], core.insn_sub_r64_r64(2, d_reg))
    _emit_label(ctx, labels, l_ok)
    if dst_reg != 2 { bytes_extend(ctx["code"], core.insn_mov_r64_r64(dst_reg, 2)) }
    return nil
}

fn _x64_fast_push_abi_state(ctx, trace_reserve_requested) {
    var a0_enc = abi.int_arg_reg(ctx["abi"], 0)
    var a1_enc = abi.int_arg_reg(ctx["abi"], 1)
    if oren_type_tag(a0_enc) == 0 || oren_type_tag(a1_enc) == 0 { return nil }
    var a0 = a0_enc - 1
    var a1 = a1_enc - 1
    var trace_reserve = trace_reserve_requested == true
    var a2 = 0
    if trace_reserve {
        var a2_enc = abi.int_arg_reg(ctx["abi"], 2)
        if oren_type_tag(a2_enc) == 0 { trace_reserve = false }
        else { a2 = a2_enc - 1 }
    }
    return {"a0": a0, "a1": a1, "a2": a2, "trace_reserve": trace_reserve}
}

fn _x64_fast_push_inputs(info) {
    var lists = info["lists"]
    return {
        "idx": info["idx"],
        "n": info["n"],
        "n_const": info["n_const"],
        "lists": lists,
        "pushes": info["pushes"],
        "list_count": oren_list_len(lists)
    }
}

fn _x64_fast_push_local_offsets(locals, inputs) {
    var n_name = inputs["n"]
    var off_n = nil
    if n_name != nil { off_n = locals[n_name] }
    var off_idx = locals[inputs["idx"]]
    if oren_type_tag(off_idx) == 0 { return nil }
    if n_name != nil && oren_type_tag(off_n) == 0 { return nil }
    if n_name == nil && inputs["n_const"] == nil { return nil }
    return {"off_idx": off_idx, "off_n": off_n}
}

fn _x64_fast_push_alloc_base(ctx, locals, inputs, offsets) {
    var list_count = inputs["list_count"]
    var extra = 0
    if inputs["n"] == nil { extra = 1 }
    var base = _intr_tmp_push(ctx, iadd(list_count, list_count) + extra)
    if oren_type_tag(base) == 0 { return nil }
    var off_n = offsets["off_n"]
    if inputs["n"] == nil {
        var n_slot = _intr_tmp_off(ctx, locals, base + list_count * 2)
        if oren_type_tag(n_slot) == 0 {
            _intr_tmp_pop(ctx, base)
            return nil
        }
        bytes_extend(ctx["code"], core.insn_mov_r64_imm64(0, inputs["n_const"]))
        _emit_mov_mrbp_r64(ctx, 0 - n_slot, 0)
        off_n = n_slot
    }
    return {"base": base, "off_n": off_n}
}

fn _x64_fast_push_pack_prepare(abi_state, inputs, offsets, slots) {
    return {
        "a0": abi_state["a0"],
        "a1": abi_state["a1"],
        "a2": abi_state["a2"],
        "trace_reserve": abi_state["trace_reserve"],
        "idx": inputs["idx"],
        "n": inputs["n"],
        "lists": inputs["lists"],
        "pushes": inputs["pushes"],
        "off_idx": offsets["off_idx"],
        "off_n": slots["off_n"],
        "list_count": inputs["list_count"],
        "base": slots["base"]
    }
}

fn _x64_fast_push_prepare_common(ctx, info, locals, trace_reserve_requested) {
    var abi_state = _x64_fast_push_abi_state(ctx, trace_reserve_requested)
    if abi_state == nil { return nil }
    var inputs = _x64_fast_push_inputs(info)
    var offsets = _x64_fast_push_local_offsets(locals, inputs)
    if offsets == nil { return nil }
    var slots = _x64_fast_push_alloc_base(ctx, locals, inputs, offsets)
    if slots == nil { return nil }
    return _x64_fast_push_pack_prepare(abi_state, inputs, offsets, slots)
}

fn _x64_fast_list_int_push_prepare(ctx, info, locals) {
    return _x64_fast_push_prepare_common(ctx, info, locals,
        oren_env("OREN_TRACE_NATIVE_LIST_RESERVE") != nil)
