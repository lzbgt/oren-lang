fn _x64_fast_list_get_sum_emit_loop(ctx, prep, locals, labels, local_fixups, get_labels) {
    _emit_label(ctx, labels, get_labels["cond"])
    _emit_mov_r64_mrbp(ctx, 10, 0 - prep["off_idx"])
