    _emit_mov_r64_mrbp(ctx, a0, 0 - slot_list)
    _emit_mov_r64_mrbp(ctx, a1, 0 - off_n)
    _emit_call_rel32_named_x64(ctx, "oren_list_int_reserve")

    _emit_label(ctx, labels, l_cap_ok)
    return nil
}

