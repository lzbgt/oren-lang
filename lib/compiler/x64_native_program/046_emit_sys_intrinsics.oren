// x64-native: sys_* intrinsics (Tier‑1 runtime injection enabler).
//
// Native runtime sources (`lib/runtime_native/**`) define `sys_*` stubs so the source parses/links,
// but correct native binaries must *lower* these call sites to the platform ABI:
// - Linux: direct syscalls
// - Windows: Win32 API via PE IAT
//
// x64 Tier‑1 does not inject the full native runtime yet, but implementing core sys_* intrinsics
// now keeps semantics future-proof and enables incremental runtime injection.

fn _emit_intrinsic_sys_write_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 3 { err(ctx, "x64 native v0: sys_write expects 3 args"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_write does not support spread"); return nil }

    // Spill args LTR.
    var base = _intr_tmp_push(ctx, 3)
    if base == nil { return nil }
    var tmp_fd = _intr_tmp_off(ctx, locals, base + 0)
    var tmp_ptr = _intr_tmp_off(ctx, locals, base + 1)
    var tmp_len = _intr_tmp_off(ctx, locals, base + 2)
    if tmp_fd == nil || tmp_ptr == nil || tmp_len == nil { _intr_tmp_pop(ctx, base); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals) // fd
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_fd, 0)
    _emit_eval_int_to_rax(ctx, args[1], locals) // ptr
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_ptr, 0)
    _emit_eval_int_to_rax(ctx, args[2], locals) // len
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return nil }
    _emit_mov_mrbp_r64(ctx, 0 - tmp_len, 0)

    var labels = {}
    var local_fixups = []
    var l_ret0 = _new_label(ctx, "sys_write_ret0")
    var l_done = _new_label(ctx, "sys_write_done")

    // if len <= 0 => return 0
    _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_len)
    bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "le", l_ret0)

    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" {
        // Windows: map fd 1/2 to STDOUT/STDERR and call:
        //   h = GetStdHandle(id)
        //   WriteFile(h, ptr, (u32)len, &written, NULL)
        //
        // Returns bytes written (best-effort), or 0 on failure.

        // Default id = STD_OUTPUT_HANDLE (-11), if fd==2 => STD_ERROR_HANDLE (-12).
        bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 4294967285)) // ecx = -11
        _emit_mov_r64_mrbp(ctx, 0, 0 - tmp_fd)
        bytes_extend(ctx["code"], insn_cmp_r64_imm32(0, 2))
        var l_fd_done = _new_label(ctx, "sys_write_fd_done")
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_fd_done)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(1, 4294967284)) // ecx = -12
        _emit_label(ctx, labels, l_fd_done)

        // call GetStdHandle
        var mov_iat0 = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
        oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat0 + 3, "data_label": "IAT_GetStdHandle"})
        bytes_extend(ctx["code"], insn_call_rax())

        // rcx = handle
        bytes_extend(ctx["code"], insn_mov_r64_r64(1, 0))
        // rdx = ptr
        _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_ptr)
        // r8  = len (low 32 used by WinAPI)
        _emit_mov_r64_mrbp(ctx, 8, 0 - tmp_len)

        // lpOverlapped (arg5) = NULL at [rsp+0x20]; bytesWritten storage at [rsp+0x28].
        bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(32, 0))
        bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(36, 0))
        bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(40, 0))
        bytes_extend(ctx["code"], insn_mov_mrsp_disp8_imm32(44, 0))
        bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(9, 40)) // r9 = &written

        // call WriteFile
        var mov_iat1 = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
        oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat1 + 3, "data_label": "IAT_WriteFile"})
        bytes_extend(ctx["code"], insn_call_rax())

        // if eax == 0 => failure => return 0
        bytes_extend(ctx["code"], insn_cmp_r32_imm32(0, 0))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_ret0)

        // rax = *(u64*)(&written)
        bytes_extend(ctx["code"], insn_lea_r64_rsp_disp8(10, 40))
        bytes_extend(ctx["code"], insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], insn_mov_rax_mrax())
        _emit_jmp_to_label(ctx, local_fixups, l_done)
    } else {
        // Linux x86_64: write(fd, ptr, len) via syscall.
        //
        // rax = 1
        // rdi = fd
        // rsi = ptr
        // rdx = len
        _emit_mov_r64_mrbp(ctx, 7, 0 - tmp_fd)
        _emit_mov_r64_mrbp(ctx, 6, 0 - tmp_ptr)
        _emit_mov_r64_mrbp(ctx, 2, 0 - tmp_len)
        bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1))
        bytes_extend(ctx["code"], insn_syscall())
        _emit_jmp_to_label(ctx, local_fixups, l_done)
    }

    _emit_label(ctx, labels, l_ret0)
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 0))
    bytes_extend(ctx["code"], insn_cdqe())
    _emit_label(ctx, labels, l_done)
    _patch_local_fixups(ctx, labels, local_fixups)
    _intr_tmp_pop(ctx, base)
    return nil
}

fn _emit_intrinsic_sys_exit_x64(ctx, expr, locals, args) {
    if ctx == nil { return nil }
    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: sys_exit expects 1 arg"); return nil }
    if expr != nil && expr["spread"] != nil { err(ctx, "x64 native v0: sys_exit does not support spread"); return nil }

    _emit_eval_int_to_rax(ctx, args[0], locals)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

    var platform = ctx["platform"]
    if platform != nil && platform["os"] == "windows" {
        // ExitProcess((u32)code)
        bytes_extend(ctx["code"], insn_mov_r32_r32(1, 0)) // mov ecx, eax
        var mov_iat0 = oren_list_len(ctx["code"])
        bytes_extend(ctx["code"], insn_mov_rax_mrip_disp32(0))
        oren_list_push(ctx["fixups"], {"type": "rip_data32", "pos": mov_iat0 + 3, "data_label": "IAT_ExitProcess"})
        bytes_extend(ctx["code"], insn_call_rax())
        bytes_extend(ctx["code"], insn_ret())
        return nil
    }

    // Linux: exit(code) syscall
    bytes_extend(ctx["code"], insn_mov_r32_r32(7, 0)) // mov edi, eax
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 60))
    bytes_extend(ctx["code"], insn_syscall())
    bytes_extend(ctx["code"], insn_ret())
    return nil
}

