fn _data_add_cstr_newline(ctx, s) {
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    var b = oren_bytes_from_string(s)
    // Append newline and NUL for tooling visibility.
    bytes_push(b, 10)
    bytes_push(b, 0)
    // 8B align (helps future u64 reads; harmless for strings).
    while core.int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = oren_list_len(ctx["data"])
    bytes_extend(ctx["data"], b)
    // Return {"off": int, "len": int} where len excludes trailing NUL.
    return {"off": off, "len": oren_list_len(b) - 1}
}

fn _data_add_cstr0(ctx, s) {
    // Add a NUL-terminated C string to the appended data blob and return its byte offset.
    //
    // Unlike `_data_add_cstr_newline`, this does NOT append a newline; it is intended for
    // language-level `"string literal"` values represented as raw pointers (native runtime model).
    //
    // Deduping:
    // - For correctness it's not required (native string comparisons use strcmp-style logic),
    //   but it reduces binary size and makes pointer identity stable for repeated literals.
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if ctx["cstr0_offs"] == nil { ctx["cstr0_offs"] = {} }

    if s == nil { s = "" }
    if ctx["cstr0_offs"][s] != nil { return ctx["cstr0_offs"][s] }

    var b = oren_bytes_from_string(s)
    bytes_push(b, 0)
    while core.int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = oren_list_len(ctx["data"])
    bytes_extend(ctx["data"], b)
    ctx["cstr0_offs"][s] = off
    return off
}

fn _data_add_fnobj(ctx, fn_name) {
    // Create (or reuse) a function-value object in the appended data blob.
    //
    // Layout (16 bytes):
    //   [0] code_ptr (u64)  -- patched by emitter
    //   [8] env_ptr  (u64)  -- 0 for now (no closures in x64 v0)
    //
    // Tier‑1 convergence note (rolling):
    // - `code_ptr` is intended to point at a uniform callable wrapper
    //   (`__oren_fnwrap_*` / `__oren_lambda_*`) so indirect calls are:
    //     wrapper(env_ptr, args_list)
    // - `env_ptr` is reserved for closures (captures); for now it is always 0 in
    //   the x64 native backend.
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if ctx["fnobj_offs"] == nil { ctx["fnobj_offs"] = {} }
    if ctx["fnobj_offs"][fn_name] != nil { return ctx["fnobj_offs"][fn_name] }

    while core.int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = oren_list_len(ctx["data"])
    // code_ptr placeholder (8 bytes)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)
    // env_ptr = 0 (8 bytes)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)

    ctx["fnobj_offs"][fn_name] = off
    oren_list_push(ctx["fixups"], {"type": "data_fnobj_code_ptr", "data_off": off, "name": fn_name})
    return off
}

fn _data_add_u64(ctx, val) {
    // Append a raw u64 to the data blob and return its byte offset.
    //
    // x64 native uses the appended data blob for:
    // - string literals
    // - fnobj records (function values)
    // - best-effort panic symbolication tables
    // - (rolling) mutable globals like call-depth counters (requires writable mappings)
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    while core.int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = oren_list_len(ctx["data"])
    push_u64_le(ctx["data"], val)
    return off
}

fn _data_add_zeros(ctx, nbytes) {
    // Reserve `nbytes` of zero-initialized space in the appended data blob and return its offset.
    //
    // Intended for small mutable buffers used by the entry stub (e.g. reading env vars on Win64)
    // without touching the stack layout required by the ABI.
    if ctx == nil { return nil }
    if nbytes == nil || nbytes <= 0 { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    // Keep pointers 8-byte aligned so later u64 reads/writes remain well-formed.
    while core.int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = oren_list_len(ctx["data"])
    var i = 0
    while i < nbytes { bytes_push(ctx["data"], 0); i = i + 1 }
    return off
}

fn _data_reserve_call_depth_guard(ctx) {
    // Reserve global storage for the x64 native call depth guard.
    //
    // Note: x64 v0 does not yet inject the full native runtime, so we keep this minimal
    // and self-contained (counter + max in the data blob, updated by compiler-inserted code).
    if ctx == nil { return nil }
    if ctx["call_depth_off"] != nil { return nil }

    var max0 = 8192
    if ctx["platform"] != nil && ctx["platform"]["call_depth_max"] != nil {
        max0 = ctx["platform"]["call_depth_max"]
    }
    if max0 == nil { max0 = 8192 }
    else if max0 < 0 { max0 = 8192 }
    else if max0 == 0 { max0 = -1 } // u64max => "no limit"
    var off_depth = _data_add_u64(ctx, 0)
    var off_max = _data_add_u64(ctx, max0)
    if off_depth == nil || off_max == nil { err(ctx, "x64 native v0: failed to reserve call depth globals"); return nil }
    ctx["call_depth_off"] = off_depth
    ctx["call_depth_max_off"] = off_max
    return nil
}

fn _emit_linux_write_cstr(ctx, s) {
    // Emit SYS_write(1, s_ptr, len) where s_ptr is a RIP-relative pointer to appended data.
    var meta = _data_add_cstr_newline(ctx, s)
    if meta == nil { return nil }
    var data_off = meta["off"]
    var nbytes = meta["len"]

    // rax = 1 (SYS_write), rdi = 1 (stdout), rsi = &data, rdx = len
    bytes_extend(ctx["code"], insn_mov_r32_imm32(0, 1)) // eax=1
    bytes_extend(ctx["code"], insn_mov_r32_imm32(7, 1)) // edi=1

    var lea_pos = oren_list_len(ctx["code"])
    bytes_extend(ctx["code"], insn_lea_rsi_rip_disp32(0)) // patch disp32
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea_rsi", "pos": lea_pos + 3, "data_off": data_off})

    bytes_extend(ctx["code"], insn_mov_r32_imm32(2, nbytes)) // edx=len
    bytes_extend(ctx["code"], insn_syscall())
    return nil
}

fn _data_reserve_symtab(ctx, sym_names) {
    // Reserve a symbol table region in the appended data blob.
    //
    // This is used by the x64 native panic stack trace to map return addresses to
    // function names without needing a full debug-info pipeline.
    //
    // Layout (in ctx["data"]):
    //   symtab_off + 0: u32 count
    //   symtab_off + 4: u32 reserved (0)
    //   symtab_off + 8: entries[count] each entry is u64:
    //       low 32: function code offset (u32)
    //       high 32: name string offset in data blob (u32)
    //
    // The table is filled later, after all functions have been compiled and
    // their code offsets are known. We reserve first so `symtab_off` is stable
    // during codegen (RIP-relative LEA fixups).
    if ctx == nil { return nil }
    if sym_names == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }

    // 8-byte align for u64 reads.
    while core.int_mod(oren_list_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var symtab_off = oren_list_len(ctx["data"])
    var count = oren_list_len(sym_names)
    var total = 8 + count * 8
    var i = 0
    while i < total { bytes_push(ctx["data"], 0); i = i + 1 }

    ctx["symtab_off"] = symtab_off
    ctx["symtab_count"] = count
    ctx["symtab_names"] = sym_names
    return symtab_off
}

fn _data_finalize_symtab(ctx) {
    // Fill the reserved symtab region (see `_data_reserve_symtab`).
    if ctx == nil { return nil }
    var symtab_off = ctx["symtab_off"]
    var sym_names = ctx["symtab_names"]
    if symtab_off == nil || sym_names == nil { return nil }

    var count = oren_list_len(sym_names)
    // Header is patched after we know how many valid entries we wrote.
    set_u32_le(ctx["data"], symtab_off + 0, 0)
    set_u32_le(ctx["data"], symtab_off + 4, 0)

    // Build entries as {off:int, name:string, name_off:int} then sort descending by off.
    // Descending order lets symbol resolution pick the closest preceding function via:
    //   if off_target >= entry.off { return entry.name }
    var entries = []

    var i = 0
    while i < count {
        var nm = sym_names[i]
        if nm == nil { i = i + 1; continue }

        var off = nil
        if nm == "__entry_stub__" {
            off = 0
        } else if ctx["functions"] != nil {
            off = ctx["functions"][nm]
        }
        if off == nil {
            err(ctx, "x64 native v0: symtab missing function offset for " + nm)
            // Do not create a bogus entry that matches everything.
            i = i + 1
            continue
        }

        var name_off = _data_add_cstr0(ctx, nm)
        if name_off == nil {
            err(ctx, "x64 native v0: symtab failed to store name " + nm)
            i = i + 1
            continue
        }

        oren_list_push(entries, {"off": off, "name": nm, "name_off": name_off})
        i = i + 1
    }

    // Insertion sort (descending by off). Small N expected; keep deterministic.
    var si = 1
    while si < oren_list_len(entries) {
        var key = entries[si]
        var k_off = key["off"]
        var k = si - 1
        while k >= 0 {
            if entries[k]["off"] >= k_off { break }
            entries[k + 1] = entries[k]
            k = k - 1
        }
        entries[k + 1] = key
        si = si + 1
    }

    // Write entries into the reserved table region (truncate/pad if needed).
    // NOTE: we reserved `count` entries, but we may have fewer if errors occurred.
    var write_n = oren_list_len(entries)
    if write_n > count { write_n = count }
    set_u32_le(ctx["data"], symtab_off + 0, write_n)
    var j = 0
    while j < write_n {
        var e = entries[j]
        var e_off = e["off"]
        var e_name_off = e["name_off"]
        // entry word at: symtab_off + 8 + j*8
        var pos = symtab_off + 8 + j * 8
        set_u32_le(ctx["data"], pos + 0, core.int_mod(e_off, 4294967296))
        set_u32_le(ctx["data"], pos + 4, core.int_mod(e_name_off, 4294967296))
        j = j + 1
    }
    return nil
}
