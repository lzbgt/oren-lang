fn _data_add_cstr_newline(ctx, s) {
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if s == nil { s = "" }
    // 8B align (helps future u64 reads; harmless for strings).
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = bytes_len(ctx["data"])
    // Avoid allocating an intermediate `list<int>` for large compiler workloads.
    // Append bytes (excluding NUL), then newline+NUL.
    var n = oren_string_len(s)
    if n > 1048576 {
        s = oren_string_slice(s, 0, 1048576)
        n = 1048576
    } // safety cap
    bytes_extend_string(ctx["data"], s)
    // Append newline and NUL for tooling visibility.
    bytes_push(ctx["data"], 10)
    bytes_push(ctx["data"], 0)
    // Re-align after the write (keeps following tables u64-friendly).
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    // Return {"off": int, "len": int} where len excludes trailing NUL.
    return {"off": off, "len": n + 1}
}

fn _x64_data_cstr_eq_bytes(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _data_add_cstr0_cached(ctx, s) {
    if ctx == nil { return 0 }
    if s == nil || s == 0 { s = "" }
    if oren_is_string(s) != true { return _data_add_cstr0(ctx, s) }
    var names = ctx["x64_cstr0_mru_names"]
    var offs = ctx["x64_cstr0_mru_offs"]
    if names == nil || offs == nil {
        names = []
        offs = []
        ctx["x64_cstr0_mru_names"] = names
        ctx["x64_cstr0_mru_offs"] = offs
    }
    var i = 0
    var n = oren_list_len(names)
    while i < n {
        if _x64_data_cstr_eq_bytes(names[i], s) == true { return offs[i] }
        i = i + 1
    }

    var off = _data_add_cstr0(ctx, s)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return off }
    var cap = 32
    if n < cap {
        oren_list_push(names, s)
        oren_list_push(offs, off)
        return off
    }
    var next = ctx["x64_cstr0_mru_next"]
    if oren_type_tag(next) == 0 { next = 0 }
    names[next] = s
    offs[next] = off
    next = next + 1
    if next >= cap { next = 0 }
    ctx["x64_cstr0_mru_next"] = next
    return off
}

fn _data_add_cstr0(ctx, s) {
    // Add a NUL-terminated C string to the appended data blob and return its byte offset.
    //
    // Unlike `_data_add_cstr_newline`, this does NOT append a newline; it is intended for
    // language-level `"string literal"` values represented as raw pointers (native runtime model).
    //
    // Deduping:
    // - For correctness it's not required (native string comparisons use strcmp-style logic),
    //   but it reduces binary size and makes pointer identity stable for repeated literals.
    if ctx == nil { return 0 }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if ctx["cstr0_offs"] == nil { ctx["cstr0_offs"] = {} }
    if ctx["cstr0_list"] == nil { ctx["cstr0_list"] = [] }

    // In native mode, some call sites use raw 0 as a "null string pointer" sentinel.
    // Treat it as an empty string here so string-y emitters don't crash during cross-target builds.
    if s == 0 { s = "" }
    // Defensive: a corrupted/invalid AST (usually from a bad astbin cache) can surface a non-string
    // value here. Avoid panicking inside `oren_string_len` (hard crash) and instead report a
    // compiler error so callers can fall back or advise `oren clean`.
    if oren_is_string(s) != true {
        var tn = "<?>"
        var tt = nil
        var val_extra = ""
        if s != 0 {
            tn = oren_type_name(s)
            tt = oren_type_tag(s)
            // When the native runtime returns 0 for "missing" (common map APIs),
            // a missing key can surface as an `int 0` here. Include the raw value
            // to make debugging cache/AST corruption less guessy.
            if tt == 1 { val_extra = " val=" + oren_int_to_string(s) }
        }
        var extra = ""
        if tt != nil { extra = " tag=" + oren_int_to_string(tt) }
        var fn_extra = ""
        if ctx != nil && ctx["cur_fn_name"] != nil { fn_extra = " cur_fn=" + ctx["cur_fn_name"] }
        err(ctx, "x64 native v0: _data_add_cstr0 expects string, got " + tn + extra + val_extra + fn_extra)
        return 0
    }
    // Dedup lookup:
    // `oren_map_get*` returns the `nil` singleton for missing keys (not raw 0).
    // Avoid using `0` as the only sentinel here; detect "present" using `oren_type_tag`.
    var existing_enc = nil
    if ctx["cstr0_offs"] != nil { existing_enc = ctx["cstr0_offs"][s] }
    if oren_type_tag(existing_enc) == 1 && existing_enc != 0 { return existing_enc - 1 }

    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = bytes_len(ctx["data"])
    // Append bytes including trailing NUL (cstr0).
    var n0 = oren_string_len(s)
    if n0 > 1048576 {
        s = oren_string_slice(s, 0, 1048576)
        n0 = 1048576
    } // safety cap
    bytes_extend_string(ctx["data"], s)
    bytes_push(ctx["data"], 0)
    ctx["cstr0_offs"][s] = off + 1
    // Track the unique byte offsets so the entry stub can register all literals once at startup
    // (avoids per-use `oren_ensure_tracked` overhead in compiler workloads).
    oren_list_push(ctx["cstr0_list"], off)
    return off
}

fn _data_add_cstr0_nodedup(ctx, s) {
    // Fast path for compiler-synthesized top-level string global assignments.
    //
    // The normal `_data_add_cstr0` path deduplicates by string key, which is useful for binary
    // size but is expensive inside the synthesized `__top_level__` body. These globals are
    // source-order constants, so appending directly is safe; the startup cstr0 table still tracks
    // each pointer once.
    if ctx == nil { return 0 }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if ctx["cstr0_list"] == nil { ctx["cstr0_list"] = [] }
    if s == nil || s == 0 { s = "" }
    if oren_is_string(s) != true {
        var tn = oren_type_name(s)
        err(ctx, "x64 native v0: _data_add_cstr0_nodedup expects string, got " + tn)
        return 0
    }
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = bytes_len(ctx["data"])
    var n0 = oren_string_len(s)
    if n0 > 1048576 {
        s = oren_string_slice(s, 0, 1048576)
        n0 = 1048576
    }
    bytes_extend_string(ctx["data"], s)
    bytes_push(ctx["data"], 0)
    oren_list_push(ctx["cstr0_list"], off)
    return off
}

fn _data_cstr0_table_slot_off(ctx) {
    if ctx == nil { return nil }
    var slot_enc = ctx["cstr0_table_slot_enc"]
    if slot_enc <= 0 { return nil }
    return slot_enc - 1
}

fn _data_cstr0_runtime_count(ctx) {
    if ctx == nil { return 0 }
    var rt_offs_u8 = ctx["rtobj_cstr0_offsets_u8"]
    if rt_offs_u8 != nil && oren_is_u8_buf(rt_offs_u8) == true {
        return oren_buf_len(rt_offs_u8) / 8
    }
    var rt_offs_enc = ctx["rtobj_cstr0_list_enc"]
    if rt_offs_enc != nil { return oren_list_len(rt_offs_enc) }
    return 0
}

fn _data_append_runtime_cstr0_offsets(ctx) {
    if ctx == nil { return nil }
    var rt_offs_u8 = ctx["rtobj_cstr0_offsets_u8"]
    if rt_offs_u8 != nil && oren_is_u8_buf(rt_offs_u8) == true {
        bytes_extend_u8_buf(ctx["data"], rt_offs_u8)
        return nil
    }
    var rt_offs_enc = ctx["rtobj_cstr0_list_enc"]
    if rt_offs_enc == nil { return nil }
    var ri = 0
    while ri < oren_list_len(rt_offs_enc) {
        var off_enc = rt_offs_enc[ri]
        if oren_type_tag(off_enc) == 1 && off_enc > 0 {
            push_u64_le(ctx["data"], off_enc - 1)
        }
        ri = ri + 1
    }
    return nil
}

fn _data_append_user_cstr0_offsets(ctx, offs, user_count) {
    if ctx == nil { return nil }
    var i = 0
    while i < user_count {
        push_u64_le(ctx["data"], offs[i])
        i = i + 1
    }
    return nil
}

fn _data_patch_cstr0_table_slot(ctx, slot_off, table_off) {
    if ctx == nil { return nil }
    // table_off fits in u32 for all practical binaries, so hi32 is 0.
    set_u32_le(ctx["data"], slot_off + 0, core.int_mod(table_off, 4294967296))
    set_u32_le(ctx["data"], slot_off + 4, 0)
    return nil
}

fn _data_finalize_cstr0_table(ctx) {
    // Build a compact table of all unique embedded C-string literals so the program entry stub can
    // register them once via `oren_init_static_cstr0_table` (native runtime).
    //
    // Layout (u64 slots, little-endian) stored in the appended data blob:
    //   [0] table_off  (u64)  -- offset of this table from data base
    //   [1] count      (u64)  -- number of offsets
    //   [2..] offs[i]  (u64)  -- each is a byte offset of a NUL-terminated cstr0 literal
    //
    // The entry stub computes `table_ptr = data_base + table_off`, and the runtime computes:
    //   data_base = table_ptr - table_off
    //
    // This is PIE-safe (no absolute pointers in `.data`) and works across x64/arm64 emitters.
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }

    var slot_off = _data_cstr0_table_slot_off(ctx)
    if slot_off == nil {
        // If the backend didn't reserve a slot, do nothing (rolling safety).
        return nil
    }

    var offs = ctx["cstr0_list"]
    if offs == nil { offs = [] }
    var rt_count = _data_cstr0_runtime_count(ctx)
    var user_count = oren_list_len(offs)

    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var table_off = bytes_len(ctx["data"])

    // Always emit a table (even if empty) so entry stubs can call init unconditionally.
    push_u64_le(ctx["data"], table_off)
    push_u64_le(ctx["data"], rt_count + user_count)
    _data_append_runtime_cstr0_offsets(ctx)
    _data_append_user_cstr0_offsets(ctx, offs, user_count)

    // Write table_off into the reserved slot as a u64 (little-endian).
    _data_patch_cstr0_table_slot(ctx, slot_off, table_off)
    return table_off
}

fn _data_add_fnobj(ctx, fn_name) {
    // Create (or reuse) a function-value object in the appended data blob.
    //
    // Layout (16 bytes):
    //   [0] code_ptr (u64)  -- patched by emitter
    //   [8] env_ptr  (u64)  -- 0 for now (no closures in x64 v0)
    //
    // Tier‑1 convergence note (rolling):
    // - `code_ptr` is intended to point at a uniform callable wrapper
    //   (`__oren_fnwrap_*` / `__oren_lambda_*`) so indirect calls are:
    //     wrapper(env_ptr, args_list)
    // - `env_ptr` is reserved for closures (captures); for now it is always 0 in
    //   the x64 native backend.
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    if ctx["fnobj_offs"] == nil { ctx["fnobj_offs"] = {} }
    // Store offsets as `off+1` so a real offset of 0 is representable while still using `nil`
    // as the map sentinel for "missing/uninitialized" (call sites decode with `enc-1`).
    var existing_enc = ctx["fnobj_offs"][fn_name]
    if oren_type_tag(existing_enc) == 1 {
        if existing_enc > 0 { return existing_enc - 1 }
    }

    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = bytes_len(ctx["data"])
    // code_ptr placeholder (8 bytes)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)
    // env_ptr = 0 (8 bytes)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)
    bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0); bytes_push(ctx["data"], 0)

    ctx["fnobj_offs"][fn_name] = off + 1
    oren_list_push(ctx["fixups"], {"type": "data_fnobj_code_ptr", "data_off": off, "name": fn_name})
    return off
}

fn _data_add_u64(ctx, val) {
    // Append a raw u64 to the data blob and return its byte offset.
    //
    // x64 native uses the appended data blob for:
    // - string literals
    // - fnobj records (function values)
    // - best-effort panic symbolication tables
    // - (rolling) mutable globals like tracking list heads (requires writable mappings)
    if ctx == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = bytes_len(ctx["data"])
    push_u64_le(ctx["data"], val)
    return off
}

fn _data_add_zeros(ctx, nbytes) {
    // Reserve `nbytes` of zero-initialized space in the appended data blob and return its offset.
    //
    // Intended for small mutable buffers used by the entry stub (e.g. reading env vars on Win64)
    // without touching the stack layout required by the ABI.
    if ctx == nil { return nil }
    if nbytes == nil || nbytes <= 0 { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }
    // Keep pointers 8-byte aligned so later u64 reads/writes remain well-formed.
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var off = bytes_len(ctx["data"])
    bytes_extend_zeros(ctx["data"], nbytes)
    return off
}

fn _emit_linux_write_cstr(ctx, s) {
    // Emit SYS_write(1, s_ptr, len) where s_ptr is a RIP-relative pointer to appended data.
    var meta = _data_add_cstr_newline(ctx, s)
    if meta == nil { return nil }
    var data_off = meta["off"]
    var nbytes = meta["len"]

    // rax = 1 (SYS_write), rdi = 1 (stdout), rsi = &data, rdx = len
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(0, 1)) // eax=1
    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(7, 1)) // edi=1

    var lea_pos = bytes_len(ctx["code"])
    bytes_extend(ctx["code"], core.insn_lea_rsi_rip_disp32(0)) // patch disp32
    oren_list_push(ctx["fixups"], {"type": "rip_data_lea_rsi", "pos": lea_pos + 3, "data_off": data_off})

    bytes_extend(ctx["code"], core.insn_mov_r32_imm32(2, nbytes)) // edx=len
    bytes_extend(ctx["code"], core.insn_syscall())
    return nil
}

fn _data_reserve_symtab(ctx, sym_names) {
    // Reserve a symbol table region in the appended data blob.
    //
    // This is used by the x64 native panic stack trace to map return addresses to
    // function names without needing a full debug-info pipeline.
    //
    // Layout (in ctx["data"]):
    //   symtab_off + 0: u32 count
    //   symtab_off + 4: u32 reserved (0)
    //   symtab_off + 8: entries[count] each entry is u64:
    //       low 32: function code offset (u32)
    //       high 32: name string offset in data blob (u32)
    //
    // The table is filled later, after all functions have been compiled and
    // their code offsets are known. We reserve first so `symtab_off` is stable
    // during codegen (RIP-relative LEA fixups).
    if ctx == nil { return nil }
    if sym_names == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }

    // 8-byte align for u64 reads.
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var symtab_off = bytes_len(ctx["data"])
    var count = oren_list_len(sym_names)
    var total = 8 + count * 8
    var i = 0
    while i < total { bytes_push(ctx["data"], 0); i = i + 1 }

    // Store offsets as `off+1` so offset 0 is representable while still using `nil` as the
    // sentinel for "missing/uninitialized" (call sites decode with `enc-1`).
    ctx["symtab_off"] = symtab_off + 1
    ctx["symtab_count"] = count
    ctx["symtab_names"] = sym_names
    return symtab_off
}

fn _x64_data_rtobj_decode_enc0(enc) {
    if oren_type_tag(enc) == 1 && enc > 0 { return enc - 1 }
    return nil
}

fn _x64_data_string_eq(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    if oren_type_tag(a) != 4 { return false }
    if oren_type_tag(b) != 4 { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        var ba = oren_string_byte_at_unchecked(a, i) & 255
        var bb = oren_string_byte_at_unchecked(b, i) & 255
        if ba != bb { return false }
        i = i + 1
    }
    return true
}

fn _x64_data_lookup_function_offset(ctx, nm) {
    if ctx == nil || nm == nil { return nil }
    var fns = ctx["functions"]
    if fns != nil {
        var off0 = fns[nm]
        if oren_type_tag(off0) != 0 { return off0 }
    }
    var comp = ctx["runtime_x64_fn_offsets_compact"]
    var base = ctx["runtime_x64_fn_offsets_base_code"]
    if base == nil { base = 0 }
    if comp != nil {
        var names = comp["names"]
        var offs = comp["offs_enc"]
        var i = 0
        while names != nil && i < oren_list_len(names) {
            if _x64_data_string_eq(names[i], nm) {
                var off1 = nil
                if offs != nil { off1 = _x64_data_rtobj_decode_enc0(offs[i]) }
                if off1 != nil { return base + off1 }
            }
            i = i + 1
        }
    }
    var enc_map = ctx["runtime_x64_fn_offsets_enc"]
    if enc_map != nil {
        var off_enc = enc_map[nm]
        var off2 = _x64_data_rtobj_decode_enc0(off_enc)
        if off2 != nil { return base + off2 }
    }
    return nil
}

fn _data_symtab_state(ctx) {
    var symtab_off_enc = ctx["symtab_off"]
    var sym_names = ctx["symtab_names"]
    if oren_type_tag(symtab_off_enc) != 1 { return nil }
    if symtab_off_enc <= 0 { return nil }
    if sym_names == nil { return nil }
    return {"off": symtab_off_enc - 1, "names": sym_names, "count": oren_list_len(sym_names)}
}

fn _data_reset_reserved_symtab_header(ctx, symtab_off) {
    // Header is patched after we know how many valid entries we wrote.
    set_u32_le(ctx["data"], symtab_off + 0, 0)
    set_u32_le(ctx["data"], symtab_off + 4, 0)
    return nil
}

fn _data_symtab_offset_enc(ctx, nm) {
    if nm == "__entry_stub__" { return 1 }
    var off0 = _x64_data_lookup_function_offset(ctx, nm)
    if oren_type_tag(off0) != 0 { return off0 + 1 }
    return 0
}

fn _data_symtab_display_name(ctx, nm) {
    if ctx["symtab_display"] != nil && ctx["symtab_display"][nm] != nil {
        return ctx["symtab_display"][nm]
    }
    return nm
}

fn _data_symtab_collect_one_entry(ctx, nm) {
    if nm == nil { return nil }

    // Encode offsets as `off+1` so a real offset 0 (`__entry_stub__`) is representable.
    var off_enc = _data_symtab_offset_enc(ctx, nm)
    if off_enc == 0 {
        err(ctx, "x64 native v0: symtab missing function offset for " + nm)
        // Do not create a bogus entry that matches everything.
        return nil
    }

    var name_off = _data_add_cstr0(ctx, _data_symtab_display_name(ctx, nm))
    // name_off can legitimately be 0; `_data_add_cstr0` is ctx-local and cannot fail here.
    return {"off_enc": off_enc, "name": nm, "name_off": name_off}
}

fn _data_symtab_collect_entries(ctx, sym_names) {
    var entries = []
    var i = 0
    while i < oren_list_len(sym_names) {
        var e = _data_symtab_collect_one_entry(ctx, sym_names[i])
        if e != nil { oren_list_push(entries, e) }
        i = i + 1
    }
    return entries
}

fn _data_symtab_sort_entries(entries) {
    // Insertion sort (descending by off). Small N expected; keep deterministic.
    var si = 1
    while si < oren_list_len(entries) {
        var key = entries[si]
        var k_off = key["off_enc"]
        var k = si - 1
        while k >= 0 {
            if entries[k]["off_enc"] >= k_off { break }
            entries[k + 1] = entries[k]
            k = k - 1
        }
        entries[k + 1] = key
        si = si + 1
    }
    return nil
}

fn _data_symtab_write_entries(ctx, symtab_off, entries, count) {
    // Write entries into the reserved table region (truncate/pad if needed).
    // NOTE: we reserved `count` entries, but we may have fewer if errors occurred.
    var write_n = oren_list_len(entries)
    if write_n > count { write_n = count }
    set_u32_le(ctx["data"], symtab_off + 0, write_n)
    var j = 0
    while j < write_n {
        var e = entries[j]
        var e_off = e["off_enc"] - 1
        var e_name_off = e["name_off"]
        // entry word at: symtab_off + 8 + j*8
        var pos = symtab_off + 8 + j * 8
        set_u32_le(ctx["data"], pos + 0, core.int_mod(e_off, 4294967296))
        set_u32_le(ctx["data"], pos + 4, core.int_mod(e_name_off, 4294967296))
        j = j + 1
    }
    return nil
}

fn _data_finalize_symtab(ctx) {
    // Fill the reserved symtab region (see `_data_reserve_symtab`).
    if ctx == nil { return nil }
    // Offsets can legitimately be 0; store/read as `off+1` so offset 0 is representable while
    // still using `nil` as the sentinel for "missing" (call sites decode with `enc-1`).
    var st = _data_symtab_state(ctx)
    if st == nil { return nil }
    var symtab_off = st["off"]
    var sym_names = st["names"]
    var count = st["count"]
    _data_reset_reserved_symtab_header(ctx, symtab_off)

    // Build entries as {off:int, name:string, name_off:int} then sort descending by off.
    // Descending order lets symbol resolution pick the closest preceding function via:
    //   if off_target >= entry.off { return entry.name }
    var entries = _data_symtab_collect_entries(ctx, sym_names)
    _data_symtab_sort_entries(entries)
    _data_symtab_write_entries(ctx, symtab_off, entries, count)
    return nil
}

fn _data_reserve_linetab(ctx, cap_entries) {
    // Reserve a line table region in the appended data blob for best-effort call-site mapping.
    //
    // This is intended for x64 native panic stack traces, to display:
    //   <fn>@<def_file>:<def_line> @<call_file>:<call_line> +0x...
    //
    // Unlike DWARF/PDB, this table is:
    // - best-effort (statement/op granularity)
    // - compact and deterministic (fixed cap; sorted by code offset)
    // - embedded in the appended data blob and resolved via RIP-relative addressing
    //
    // Layout (in ctx["data"]):
    //   linetab_off + 0: u32 count
    //   linetab_off + 4: u32 reserved (0)
    //   linetab_off + 8: entries[cap] each entry is u64:
    //       low 32: code offset (u32) at which this location applies
    //       high 32: loc string offset (u32) in data blob (NUL-terminated)
    //
    // The table is filled later by `_data_finalize_linetab`, after compilation.
    if ctx == nil { return nil }
    if oren_type_tag(cap_entries) == 0 || cap_entries <= 0 { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }

    // 8-byte align for u64 reads.
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var linetab_off = bytes_len(ctx["data"])
    var total = 8 + cap_entries * 8
    var i = 0
    while i < total { bytes_push(ctx["data"], 0); i = i + 1 }

    ctx["linetab_off"] = linetab_off
    ctx["linetab_cap"] = cap_entries
    ctx["linetab_entries"] = []
    ctx["linetab_loc_offs"] = {}
    // Cheap dedup across sequential ops (keeps size down when many ops share a line).
    ctx["linetab_last_code_off"] = nil
    ctx["linetab_last_loc_off"] = nil
    return linetab_off
}

fn _data_finalize_linetab(ctx) {
    // Fill the reserved linetab region (see `_data_reserve_linetab`).
    if ctx == nil { return nil }
    var linetab_off = ctx["linetab_off"]
    var cap_entries = ctx["linetab_cap"]
    var entries_in = ctx["linetab_entries"]
    if oren_type_tag(linetab_off) != 1 { return nil }
    if linetab_off <= 0 { return nil }
    if oren_type_tag(cap_entries) != 1 { return nil }
    if cap_entries <= 0 { return nil }
    if entries_in == nil { return nil }

    // Header patched after we know how many entries we wrote.
    set_u32_le(ctx["data"], linetab_off + 0, 0)
    set_u32_le(ctx["data"], linetab_off + 4, 0)

    // Copy entries then sort descending by off.
    // Descending order lets runtime resolution pick the closest preceding entry via:
    //   if off_target >= entry.off { return entry.loc }
    var entries = []
    var i = 0
    while i < oren_list_len(entries_in) {
        var e0 = entries_in[i]
        if e0 != nil && e0["off"] != nil && e0["loc_off"] != nil {
            oren_list_push(entries, e0)
        }
        i = i + 1
    }

    // Insertion sort (descending by off). Small N expected; keep deterministic.
    var si = 1
    while si < oren_list_len(entries) {
        var key = entries[si]
        var k_off = key["off"]
        var k = si - 1
        while k >= 0 {
            if entries[k]["off"] >= k_off { break }
            entries[k + 1] = entries[k]
            k = k - 1
        }
        entries[k + 1] = key
        si = si + 1
    }

    var write_n = oren_list_len(entries)
    if write_n > cap_entries { write_n = cap_entries }
    set_u32_le(ctx["data"], linetab_off + 0, write_n)

    var j = 0
    while j < write_n {
        var e = entries[j]
        var e_off = e["off"]
        var e_loc_off = e["loc_off"]
        var pos = linetab_off + 8 + j * 8
        set_u32_le(ctx["data"], pos + 0, core.int_mod(e_off, 4294967296))
        set_u32_le(ctx["data"], pos + 4, core.int_mod(e_loc_off, 4294967296))
        j = j + 1
    }
    return nil
}

fn _data_dbginfo_slot_off(ctx, platform) {
    if ctx == nil { return nil }
    if platform == nil || platform["debug"] != true { return nil }
    var slot_enc = ctx["dbginfo_table_slot_enc"]
    if oren_type_tag(slot_enc) != 1 { return nil }
    if slot_enc <= 0 { return nil }
    return slot_enc - 1
}

fn _data_collect_dbginfo_entries(ctx) {
    var fns = ctx["functions"]
    if fns == nil { fns = {} }
    var entries = []
    oren_list_push(entries, {"name": "__entry_stub__", "off": 0})
    var idx = 0
    var pair = [nil, nil]
    while 1 {
        var ok = oren_iter_next_entry(fns, idx, pair)
        if ok == 0 { break }
        var nm = pair[0]
        var off = pair[1]
        if nm != nil && nm != "" && off != nil && off >= 0 {
            oren_list_push(entries, {"name": nm, "off": off})
        }
        idx = idx + 1
    }
    return entries
}

fn _data_sort_dbginfo_entries_by_off(entries) {
    var si = 1
    while si < oren_list_len(entries) {
        var key = entries[si]
        var k_off = key["off"]
        var k = si - 1
        while k >= 0 {
            if entries[k]["off"] <= k_off { break }
            entries[k + 1] = entries[k]
            k = k - 1
        }
        entries[k + 1] = key
        si = si + 1
    }
    return entries
}

fn _data_dbginfo_display_name(ctx, nm0) {
    if ctx != nil && ctx["symtab_display"] != nil && nm0 != nil && ctx["symtab_display"][nm0] != nil {
        return ctx["symtab_display"][nm0]
    }
    if nm0 == nil { return "" }
    return nm0
}

fn _data_emit_one_dbginfo_entry(ctx, platform, entries, i, code_len) {
    var e = entries[i]
    var nm0 = e["name"]
    var start_off = e["off"]
    var end_off = code_len
    if i + 1 < oren_list_len(entries) {
        end_off = entries[i + 1]["off"]
    }
    // Offsets are always integers (0 is valid). Treat missing offsets as a bug upstream.
    if end_off < start_off { end_off = start_off }

    var text_base = abi.x64_v0_text_base_addr(platform)
    push_u64_le(ctx["data"], text_base + start_off)
    push_u64_le(ctx["data"], text_base + end_off)

    var disp = _data_dbginfo_display_name(ctx, nm0)
    var nb_len = oren_string_len(disp)
    push_u64_le(ctx["data"], nb_len)
    bytes_extend_string(ctx["data"], disp)
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }

    // File/line/column/parameter metadata is reserved for later native debug data.
    push_u64_le(ctx["data"], 0)
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    push_u64_le(ctx["data"], 0)
    push_u64_le(ctx["data"], 0)
    push_u64_le(ctx["data"], 0)
    return nil
}

fn _data_emit_dbginfo_entries(ctx, platform, entries) {
    var code_len = 0
    if ctx["code"] != nil { code_len = bytes_len(ctx["code"]) }
    var i = 0
    while i < oren_list_len(entries) {
        _data_emit_one_dbginfo_entry(ctx, platform, entries, i, code_len)
        i = i + 1
    }
    return nil
}

fn _data_patch_dbginfo_table_slot(ctx, slot_off, table_off) {
    var lo = core.int_mod(table_off, 4294967296)
    var hi = 0
    if table_off >= 4294967296 { hi = table_off / 4294967296 }
    set_u32_le(ctx["data"], slot_off + 0, lo)
    set_u32_le(ctx["data"], slot_off + 4, core.int_mod(hi, 4294967296))
    return nil
}

fn _data_finalize_dbginfo_table(ctx, platform) {
    // Emit an embedded debug-info table (function-range map) for runtime symbolication.
    //
    // Runtime consumer: `lib/runtime_native/110_mem_diag.oren`
    // - `oren_set_debug_info(ptr, static_addr)` installs this table
    // - `oren_resolve_symbol(pc)` uses range checks to return the best matching function name
    //
    // Table layout (u64-aligned, little-endian), at `table_ptr`:
    //   [0] count (u64)
    //   then `count` entries, each:
    //     start_pc (u64)  -- inclusive
    //     end_pc   (u64)  -- exclusive
    //     name_len (u64), name_bytes[name_len], align8
    //     file_len (u64), file_bytes[file_len], align8
    //     line (u64), col (u64)
    //     p_count (u64)   -- 0 for now (no param metadata)
    //
    // Notes (rolling, x64 v0):
    // - x64 emitters are fixed-base and do not emit relocations, so PCs are resolved using
    //   absolute addresses `text_base + code_off`.
    // - We only emit this in debug builds to keep release artifacts small.
    var slot_off = _data_dbginfo_slot_off(ctx, platform)
    if slot_off == nil { return nil }
    if ctx["data"] == nil { ctx["data"] = bytes_new() }

    // Collect entries (name + code offset). Include a synthetic entry for the entry stub.
    var entries = _data_collect_dbginfo_entries(ctx)
    _data_sort_dbginfo_entries_by_off(entries)

    // Align `.data` to 8B for u64 reads.
    while core.int_mod(bytes_len(ctx["data"]), 8) != 0 { bytes_push(ctx["data"], 0) }
    var table_off = bytes_len(ctx["data"])

    // Build the table.
    push_u64_le(ctx["data"], oren_list_len(entries))
    _data_emit_dbginfo_entries(ctx, platform, entries)

    // Patch table_off into the reserved slot as a u64 (little-endian).
    _data_patch_dbginfo_table_slot(ctx, slot_off, table_off)
    return table_off
}
