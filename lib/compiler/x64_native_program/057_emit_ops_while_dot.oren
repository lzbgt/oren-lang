        "end": _new_label(ctx, "list_dot_end"),
        "done": _new_label(ctx, "list_dot_done")
    }
}

fn _x64_fast_list_dot_emit_entry_gates(ctx, prep, labels, local_fixups) {
    var off_idx = prep["off_idx"]
    var off_n = prep["off_n"]
    var l_slow = labels["slow"]

    // i < 0 => slow
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_idx)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_slow)

    // n < 0 => slow
    _emit_mov_r64_mrbp(ctx, 0, 0 - off_n)
    bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
    _emit_jcc_to_label(ctx, local_fixups, "l", l_slow)
    return nil
}

fn _x64_fast_list_dot_validate_lists(ctx, prep, locals, local_fixups, l_slow) {
    var lists = prep["lists"]
    var list_count = prep["list_count"]
    var base = prep["base"]
    var off_n = prep["off_n"]

    var li = 0
    while li < list_count {
        var list_name = lists[li]
        var off_list = locals[list_name]
        if oren_type_tag(off_list) == 0 { _intr_tmp_pop(ctx, base); return false }
        var slot_list = _intr_tmp_off(ctx, locals, base + li * 2)
        var slot_buf = _intr_tmp_off(ctx, locals, base + li * 2 + 1)
        if oren_type_tag(slot_list) == 0 || oren_type_tag(slot_buf) == 0 {
            _intr_tmp_pop(ctx, base)
            return false
        }

        // list -> slot
        _emit_mov_r64_mrbp(ctx, 0, 0 - off_list)
        _emit_mov_mrbp_r64(ctx, 0 - slot_list, 0)
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 0))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_slow)

        // tracked node
        _emit_find_tracked_node_x64(ctx, 0, 11)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { _intr_tmp_pop(ctx, base); return false }
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(11, 0))
        _emit_jcc_to_label(ctx, local_fixups, "e", l_slow)

        // kind == LIST (2)
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 11))
        bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], core.insn_mov_r64_mr64(10, 10))
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(10, 2))
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_slow)

        // magic check
        _emit_mov_r64_mrbp(ctx, 0, 0 - slot_list)
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(10, 0))
        bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 24))
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
        bytes_extend(ctx["code"], core.insn_cmp_r64_imm32(0, 1279870019))
        _emit_jcc_to_label(ctx, local_fixups, "ne", l_slow)

        // count >= n
        _emit_mov_r64_mrbp(ctx, 10, 0 - slot_list)
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
        _emit_mov_r64_mrbp(ctx, 9, 0 - off_n)
        bytes_extend(ctx["code"], core.insn_cmp_r64_r64(0, 9))
        _emit_jcc_to_label(ctx, local_fixups, "l", l_slow)

        // buf -> slot
        _emit_mov_r64_mrbp(ctx, 10, 0 - slot_list)
        bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 16))
        bytes_extend(ctx["code"], core.insn_mov_r64_r64(0, 10))
        bytes_extend(ctx["code"], core.insn_mov_rax_mrax())
        _emit_mov_mrbp_r64(ctx, 0 - slot_buf, 0)

        li = li + 1
    }
    return true
}

fn _x64_fast_list_dot_init_unique_cursors(ctx, prep, locals) {
    var unique_lists = prep["unique_lists"]
    if unique_lists != true { return true }

    var list_count = prep["list_count"]
    var base = prep["base"]
    var off_idx = prep["off_idx"]

    _emit_mov_r64_mrbp(ctx, 10, 0 - off_idx)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 10))
    bytes_extend(ctx["code"], core.insn_shl_r64_imm8(12, 3))
    var li_init = 0
    while li_init < list_count {
        var slot_buf_init = _intr_tmp_off(ctx, locals, base + li_init * 2 + 1)
        if oren_type_tag(slot_buf_init) == 0 { return false }
        _emit_mov_r64_mrbp(ctx, 11, 0 - slot_buf_init)
        bytes_extend(ctx["code"], core.insn_add_r64_r64(11, 12))
        _emit_mov_mrbp_r64(ctx, 0 - slot_buf_init, 11)
        li_init = li_init + 1
    }
    return true
}

fn _x64_fast_list_dot_emit_loop_header(ctx, prep, locals, labels, label_names, local_fixups) {
    var off_idx = prep["off_idx"]
    var off_n = prep["off_n"]
    var off_sum = prep["off_sum"]
    var l_fast_cond = label_names["cond"]
    var l_fast_end = label_names["end"]

    _emit_label(ctx, labels, l_fast_cond)
    _emit_mov_r64_mrbp(ctx, 10, 0 - off_idx)
    _emit_mov_r64_mrbp(ctx, 9, 0 - off_n)
    bytes_extend(ctx["code"], core.insn_cmp_r64_r64(10, 9))
    _emit_jcc_to_label(ctx, local_fixups, "ge", l_fast_end)

    _emit_gc_safepoint_throttled_x64(ctx, locals, labels, local_fixups, 1023)

    // sum -> r13
    _emit_mov_r64_mrbp(ctx, 13, 0 - off_sum)
    return nil
}

fn _x64_fast_list_dot_find_mul_slots(ctx, prep, locals, mul) {
    var lists = prep["lists"]
    var list_count = prep["list_count"]
    var base = prep["base"]
    var left_list = mul["left"]
    var right_list = mul["right"]

    var li_left = 0
    while li_left < list_count {
        if _x64_str_eq_bytes(lists[li_left], left_list) { break }
        li_left = li_left + 1
    }
    var li_right = 0
    while li_right < list_count {
        if _x64_str_eq_bytes(lists[li_right], right_list) { break }
        li_right = li_right + 1
    }
    var slot_buf_left = _intr_tmp_off(ctx, locals, base + li_left * 2 + 1)
    var slot_buf_right = _intr_tmp_off(ctx, locals, base + li_right * 2 + 1)
    if oren_type_tag(slot_buf_left) == 0 || oren_type_tag(slot_buf_right) == 0 { return nil }
    return {"left": slot_buf_left, "right": slot_buf_right}
}

fn _x64_fast_list_dot_emit_unique_single_step(ctx, slots) {
    var slot_buf_left = slots["left"]
    var slot_buf_right = slots["right"]

    // left value -> r14 (advance cursor)
    _emit_mov_r64_mrbp(ctx, 12, 0 - slot_buf_left)
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(14, 12))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(12, 8))
    _emit_mov_mrbp_r64(ctx, 0 - slot_buf_left, 12)

    // right value -> r15 (advance cursor)
    _emit_mov_r64_mrbp(ctx, 11, 0 - slot_buf_right)
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(15, 11))
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(11, 8))
    _emit_mov_mrbp_r64(ctx, 0 - slot_buf_right, 11)

    bytes_extend(ctx["code"], core.insn_imul_r64_r64(14, 15))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(13, 14))
    return nil
}

fn _x64_fast_list_dot_emit_indexed_value(ctx, slot_buf, dst_reg) {
    _emit_mov_r64_mrbp(ctx, 11, 0 - slot_buf)
    bytes_extend(ctx["code"], core.insn_mov_r64_r64(12, 10))
    bytes_extend(ctx["code"], core.insn_shl_r64_imm8(12, 3))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(12, 11))
    bytes_extend(ctx["code"], core.insn_mov_r64_mr64(dst_reg, 12))
    return nil
}

fn _x64_fast_list_dot_emit_indexed_single_step(ctx, slots) {
    _x64_fast_list_dot_emit_indexed_value(ctx, slots["left"], 14)
    _x64_fast_list_dot_emit_indexed_value(ctx, slots["right"], 15)
    bytes_extend(ctx["code"], core.insn_imul_r64_r64(14, 15))
    bytes_extend(ctx["code"], core.insn_add_r64_r64(13, 14))
    return nil
}

fn _x64_fast_list_dot_emit_single_step(ctx, prep, locals, mul) {
    var slots = _x64_fast_list_dot_find_mul_slots(ctx, prep, locals, mul)
    if slots == nil { return false }
    if prep["unique_lists"] == true {
        _x64_fast_list_dot_emit_unique_single_step(ctx, slots)
    } else {
        _x64_fast_list_dot_emit_indexed_single_step(ctx, slots)
    }
    return true
}

fn _x64_fast_list_dot_emit_single_tail(ctx, prep) {
    var off_idx = prep["off_idx"]
    var off_sum = prep["off_sum"]
    _emit_mov_mrbp_r64(ctx, 0 - off_sum, 13)

    // i++
    bytes_extend(ctx["code"], core.insn_add_r64_imm32(10, 1))
    _emit_mov_mrbp_r64(ctx, 0 - off_idx, 10)
    return nil
}

fn _x64_fast_list_dot_emit_single(ctx, prep, locals) {
    var muls = prep["muls"]
    var mi = 0
    while mi < oren_list_len(muls) {
        var mul = muls[mi]
        if _x64_fast_list_dot_emit_single_step(ctx, prep, locals, mul) != true { return false }
        mi = mi + 1
    }
    _x64_fast_list_dot_emit_single_tail(ctx, prep)
    return true
}

fn _emit_fast_list_dot_while_x64(ctx, op, info, locals, labels, local_fixups, epilogue_label, platform) {
    if ctx == nil || op == nil || info == nil { return nil }
    if locals == nil { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }
    if ctx["runtime_injected"] != true { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }

    var prep = _x64_fast_list_dot_prepare(ctx, info, locals)
    if prep == nil { return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil) }
    var base = prep["base"]

    var dot_labels = _x64_fast_list_dot_labels(ctx)
    var l_slow = dot_labels["slow"]
    var l_done = dot_labels["done"]

    _x64_fast_list_dot_emit_entry_gates(ctx, prep, dot_labels, local_fixups)
    if _x64_fast_list_dot_validate_lists(ctx, prep, locals, local_fixups, l_slow) != true {
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    }

    if _x64_fast_list_dot_init_unique_cursors(ctx, prep, locals) != true {
        _intr_tmp_pop(ctx, base)
        return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    }

    _x64_fast_list_dot_emit_loop_header(ctx, prep, locals, labels, dot_labels, local_fixups)
    if _x64_fast_list_dot_emit_single(ctx, prep, locals) != true {
        _intr_tmp_pop(ctx, base)
        return _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    }

    _emit_jmp_to_label(ctx, local_fixups, dot_labels["cond"])

    _emit_label(ctx, labels, dot_labels["end"])
    _emit_jmp_to_label(ctx, local_fixups, l_done)

    _intr_tmp_pop(ctx, base)

    _emit_label(ctx, labels, l_slow)
    _emit_while_generic_x64(ctx, op, locals, labels, local_fixups, epilogue_label, platform, nil, nil)
    _emit_label(ctx, labels, l_done)
    return nil
}
