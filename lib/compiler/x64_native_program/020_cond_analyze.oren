fn _cond_check(ctx, cond) {
    // Supported cond forms (rolling v0):
    // - Any int-ish expression, using language truthiness semantics (0 is false).
    // - Comparison infix: == != < <= > >= (keeps "cmp+Jcc" lowering compact).
    if cond == nil { err(ctx, "x64 native v0: missing condition"); return nil }

    // Comparison form is a special-case: we currently only support comparing
    // an evaluated LHS expression against a restricted RHS subset (rolling forward).
    if _cond_is_cmp_infix(cond) != nil {
        var op = cond["op"]
        var l = cond["left"]
        var r = cond["right"]
        if l == nil || r == nil { err(ctx, "x64 native v0: condition infix missing operands"); return nil }
        _expr_int_check(ctx, l, nil)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        _expr_int_check(ctx, r, nil)
        return nil
    }

    // Truthy expression form.
    // Special-case `!x` so `if !x { ... }` works without needing full bool lowering in v0.
    if cond["type"] == "Prefix" && cond["op"] == "!" {
        var r2 = cond["right"]
        if r2 == nil { err(ctx, "x64 native v0: condition prefix ! missing operand"); return nil }
        if _cond_is_cmp_infix(r2) != nil { return nil }
        _expr_int_check(ctx, r2, nil)
        return nil
    }
    _expr_int_check(ctx, cond, nil)
    return nil
}

fn _cond_is_cmp_infix(cond) {
    if cond == nil { return nil }
    if cond["type"] != "Infix" { return nil }
    var op = cond["op"]
    if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return 1 }
    return nil
}

fn _cond_false_cc(cond_op) {
    // Return the Jcc condition code for "cond is false", given `cond_op`.
    if cond_op == "==" { return "ne" }
    if cond_op == "!=" { return "e" }
    if cond_op == "<" { return "ge" }
    if cond_op == "<=" { return "g" }
    if cond_op == ">" { return "le" }
    if cond_op == ">=" { return "l" }
    return nil
}

fn _cond_true_cc(cond_op) {
    // Return the Jcc condition code for "cond is true", given `cond_op`.
    if cond_op == "==" { return "e" }
    if cond_op == "!=" { return "ne" }
    if cond_op == "<" { return "l" }
    if cond_op == "<=" { return "le" }
    if cond_op == ">" { return "g" }
    if cond_op == ">=" { return "ge" }
    return nil
}

fn contains_curly_braces(s) {
    // Match the shared compiler helper semantics:
    // treat "{}" as a formatting marker for `print(fmt, ...)`.
    var i = 0
    var len = oren_string_len(s)
    while i < len - 1 {
        if oren_string_char_at(s, i) == "{" {
            if oren_string_char_at(s, i + 1) == "}" { return true }
        }
        i = i + 1
    }
    return false
}

fn _x64_tmp_counter_next(ctx, key) {
    if ctx == nil { return 0 }
    if ctx[key] == nil { ctx[key] = 0 }
    var n = ctx[key]
    ctx[key] = n + 1
    return n
}

fn _x64_print_tmp_name(ctx, prefix) {
    // Generate deterministic, collision-resistant temp names for x64 op lowering.
    var n = _x64_tmp_counter_next(ctx, "x64_print_tmp_counter")
    return prefix + oren_int_to_string(n)
}

fn _x64_print_emit_build_list_ops(ctx, ops, tok, args, start_idx) {
    // Synthesize:
    //   var tmp = oren_new_list(0)
    //   tmp.push(args[start_idx])
    //   ...
    //
    // Returns tmp variable name.
    if ops == nil { return nil }
    if args == nil { args = [] }

    var tmp = _x64_print_tmp_name(ctx, "__oren_print_args_")
    var new_list_call = {
        "type": "Call",
        "fn": {"type": "Identifier", "token": nil, "value": "oren_new_list"},
        "args": [{"type": "Integer", "token": nil, "value": "0"}],
    }
    _expr_int_check(ctx, new_list_call, nil)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    oren_list_push(ops, {"op": "var_i32", "tok": tok, "name": tmp, "expr": new_list_call})

    var i = start_idx
    while i < oren_list_len(args) {
        var ai = args[i]
        if ai == nil { err(ctx, "x64 native: print missing arg"); return nil }
        _expr_int_check(ctx, ai, nil)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        var push_call = {
            "type": "Call",
            "fn": {"type": "Identifier", "token": nil, "value": "oren_list_push"},
            "args": [{"type": "Identifier", "token": nil, "value": tmp}, ai],
        }
        _expr_int_check(ctx, push_call, nil)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        oren_list_push(ops, {"op": "expr", "tok": tok, "expr": push_call})
        i = i + 1
    }
    return tmp
}

fn _x64_print_lower_to_runtime_ops(ctx, ops, tok, call_expr) {
    // Lower `print(...)` statement into explicit calls to injected native runtime helpers.
    //
    // We do this as an x64-backend-only lowering step (post-DCE) so:
    // - x64 can converge quickly to arm64 semantics without requiring global front-end rewrites
    // - printing stays capsule-safe (runtime sys_write gating)
    //
    // NOTE: these runtime helpers must be pinned as DCE roots (see native_runtime_bundle.oren),
    // because the calls are synthesized after DCE and are not visible in the linked AST.
    if call_expr == nil { return nil }
    var args = call_expr["args"]
    if args == nil { args = [] }
    var argc = oren_list_len(args)
    var spread = call_expr["spread"]

    var arg0 = nil
    if argc > 0 { arg0 = args[0] }

    var is_fmt = false
    if arg0 != nil && arg0["type"] == "String" && contains_curly_braces(arg0["value"]) {
        if argc > 1 || spread != nil { is_fmt = true }
    }

    if spread != nil {
        _expr_int_check(ctx, spread, nil)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        if is_fmt {
            // fmt, fixed..., ...spread
            var fixed_name = _x64_print_emit_build_list_ops(ctx, ops, tok, args, 1)
            if fixed_name == nil { return nil }
            var call_fmt_sp = {
                "type": "Call",
                "fn": {"type": "Identifier", "token": nil, "value": "oren_print_fmt_spread"},
                "args": [arg0,
                         {"type": "Identifier", "token": nil, "value": fixed_name},
                         spread],
            }
            _expr_int_check(ctx, call_fmt_sp, nil)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            oren_list_push(ops, {"op": "expr", "tok": tok, "expr": call_fmt_sp})
            return nil
        }

        // fixed..., ...spread
        var fixed_name2 = _x64_print_emit_build_list_ops(ctx, ops, tok, args, 0)
        if fixed_name2 == nil { return nil }
        var call_sp = {
            "type": "Call",
            "fn": {"type": "Identifier", "token": nil, "value": "oren_print_spread"},
            "args": [{"type": "Identifier", "token": nil, "value": fixed_name2}, spread],
        }
        _expr_int_check(ctx, call_sp, nil)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        oren_list_push(ops, {"op": "expr", "tok": tok, "expr": call_sp})
        return nil
    }

    if is_fmt {
        // fmt, fixed...
        var fixed_name3 = _x64_print_emit_build_list_ops(ctx, ops, tok, args, 1)
        if fixed_name3 == nil { return nil }
        var call_fmt = {
            "type": "Call",
            "fn": {"type": "Identifier", "token": nil, "value": "oren_print_fmt"},
            "args": [arg0, {"type": "Identifier", "token": nil, "value": fixed_name3}],
        }
        _expr_int_check(ctx, call_fmt, nil)
        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        oren_list_push(ops, {"op": "expr", "tok": tok, "expr": call_fmt})
        return nil
    }

    // Non-format.
    if argc == 0 {
        var call_nl = {
            "type": "Call",
            "fn": {"type": "Identifier", "token": nil, "value": "oren_print_list"},
            "args": [{"type": "Nil", "token": nil}],
        }
    _expr_int_check(ctx, call_nl, nil)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        oren_list_push(ops, {"op": "expr", "tok": tok, "expr": call_nl})
        return nil
    }
    if argc == 1 {
    _expr_int_check(ctx, arg0, nil)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        var call_one = {
            "type": "Call",
            "fn": {"type": "Identifier", "token": nil, "value": "oren_print"},
            "args": [arg0],
        }
    _expr_int_check(ctx, call_one, nil)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
        oren_list_push(ops, {"op": "expr", "tok": tok, "expr": call_one})
        return nil
    }

    var fixed_name4 = _x64_print_emit_build_list_ops(ctx, ops, tok, args, 0)
    if fixed_name4 == nil { return nil }
    var call_list = {
        "type": "Call",
        "fn": {"type": "Identifier", "token": nil, "value": "oren_print_list"},
        "args": [{"type": "Identifier", "token": nil, "value": fixed_name4}],
    }
    _expr_int_check(ctx, call_list, nil)
    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
    oren_list_push(ops, {"op": "expr", "tok": tok, "expr": call_list})
    return nil
}

fn _cond_false_cc_for_cond(cond) {
    // After `_emit_cmp_from_cond`, flags are:
    // - comparison: based on `cmp lhs, rhs`
    // - truthy expr: based on `cmp expr, 0`
    if _cond_is_cmp_infix(cond) != nil { return _cond_false_cc(cond["op"]) }
    if cond != nil && cond["type"] == "Prefix" && cond["op"] == "!" {
        // !x is false when x is truthy (x != 0)
        var inner = cond["right"]
        if _cond_is_cmp_infix(inner) != nil {
            // !(lhs op rhs) is false when (lhs op rhs) is true.
            return _cond_true_cc(inner["op"])
        }
        return "ne"
    }
    // expr is false when expr == 0
    return "e"
}

fn _analyze_stmt_list_to_ops(ctx, stmts) {
    var ops = []
    if stmts == nil { return ops }
    var i = 0
    while i < oren_list_len(stmts) {
        var st = stmts[i]
        if st == nil { i = i + 1; continue }
        var t = st["type"]
        var tok = st["token"]
        if t == "Block" {
            // Rolling: allow naked blocks as statements and treat them as an inline statement list.
            // x64 native uses a single function-scope locals model, so this is a safe flattening.
            var inner = _analyze_stmt_list_to_ops(ctx, st["stmts"])
            if inner == nil { return nil }
            var k0 = 0
            while k0 < oren_list_len(inner) { oren_list_push(ops, inner[k0]); k0 = k0 + 1 }
            i = i + 1
            continue
        }
        if t == "Function" {
            // Local function declaration (rolling): `fn name(params...) { ... }` in statement position.
            //
            // x64 native v0 lowers this as:
            //   var name = fn(params...) { ... }
            //
            // so calls to `name(...)` inside the enclosing function become indirect calls through a
            // first-class fn object (uniform callable ABI). This keeps semantics aligned with arm64
            // without needing a separate "nested function hoisting" pass in the x64 backend.
            var nmf = st["name"]
            if nmf == nil || nmf == "" { err(ctx, "x64 native v0: function decl missing name"); return nil }
            st["decl_name"] = nmf
            st["name"] = "" // convert to lambda literal
            oren_list_push(ops, {"op": "var_i32", "tok": tok, "name": nmf, "expr": st})
            i = i + 1
            continue
        }
        if t == "Var" {
            var name_node = st["name"]
            var v0 = st["value"]
            if name_node == nil || name_node["type"] != "Identifier" { err(ctx, "x64 native v0: var name must be identifier"); return nil }
            if v0 == nil { err(ctx, "x64 native v0: var init missing"); return nil }
            oren_list_push(ops, {"op": "var_i32", "tok": tok, "name": name_node["value"], "expr": v0})
            i = i + 1
            continue
        }
        if t == "ExprStmt" {
            var e = st["expr"]
            if e == nil { i = i + 1; continue }
            if tok == nil { tok = e["token"] }
            // Some parts of the pipeline represent statement-forms as an ExprStmt wrapper.
            // Accept common control-flow nodes here to avoid backend fragility as the AST evolves.
            if e["type"] == "If" || e["type"] == "While" || e["type"] == "For" {
                var tmp = _analyze_stmt_list_to_ops(ctx, [e])
                if tmp == nil { return nil }
                // Splice in the ops produced by the wrapped statement.
                var k = 0
                while k < oren_list_len(tmp) { oren_list_push(ops, tmp[k]); k = k + 1 }
                i = i + 1
                continue
            }
            if e["type"] == "SpawnExpr" {
                // `spawn f(...)` can appear in statement position; evaluate and discard the result.
                _expr_int_check(ctx, e, nil)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
                oren_list_push(ops, {"op": "expr", "tok": tok, "expr": e})
                i = i + 1
                continue
            }
            if e["type"] == "Function" {
                // Some parser paths wrap statement-form `fn name(...) { ... }` as an ExprStmt.
                // Normalize to the same lowering as the direct `t == "Function"` case.
                var nmf2 = e["name"]
                if nmf2 == nil || nmf2 == "" { err(ctx, "x64 native v0: function decl missing name"); return nil }
                e["decl_name"] = nmf2
                e["name"] = "" // convert to lambda literal
                oren_list_push(ops, {"op": "var_i32", "tok": tok, "name": nmf2, "expr": e})
                i = i + 1
                continue
            }
            if e["type"] == "Call" {
                var callee = e["fn"]
                var args = e["args"]
                if callee != nil && callee["type"] == "Identifier" && callee["value"] == "print" {
                    // Tier‑1 parity: when native runtime injection is enabled (default),
                    // lower `print(...)` to runtime helpers so:
                    // - printing supports multi-arg, fmt, and spread (same semantics as arm64)
                    // - capsule sys_write gating applies (no direct syscall/WinAPI bypass)
                    if ctx != nil && ctx["inject_runtime"] == true {
                        _x64_print_lower_to_runtime_ops(ctx, ops, tok, e)
                        if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
                        i = i + 1
                        continue
                    }

                    // Bring-up mode: keep the legacy x64-only print lowering.
                    if args == nil || oren_list_len(args) != 1 { err(ctx, "x64 native v0: print expects 1 arg"); return nil }
                    var a0 = args[0]
                    if a0 == nil { err(ctx, "x64 native v0: print missing arg"); return nil }

                    // Fast-path: print("literal") uses the OS-specific cstr write helper.
                    if a0["type"] == "String" {
                        oren_list_push(ops, {"op": "print_cstr", "tok": tok, "value": a0["value"]})
                        i = i + 1
                        continue
                    }

                    // Rolling bring-up: allow printing any expression that evaluates to a string pointer.
                    _expr_int_check(ctx, a0, nil)
                    if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
                    oren_list_push(ops, {"op": "print_str_expr", "tok": tok, "expr": a0})
                    i = i + 1
                    continue
                }

                // Generic call expression statement: evaluate and discard return.
                _expr_int_check(ctx, e, nil)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
                oren_list_push(ops, {"op": "expr", "tok": tok, "expr": e})
                i = i + 1
                continue
            }
            err(ctx, "x64 native v0: unsupported expr statement: " + e["type"])
            return nil
        }
        if t == "Assign" {
            var name_node2 = st["name"]
            var v2 = st["value"]
            if name_node2 == nil || name_node2["type"] != "Identifier" { err(ctx, "x64 native v0: assign name must be identifier"); return nil }
            if v2 == nil { err(ctx, "x64 native v0: assign missing value"); return nil }
            oren_list_push(ops, {"op": "assign_i32", "tok": tok, "name": name_node2["value"], "expr": v2})
            i = i + 1
            continue
        }
        if t == "Set" {
            // Statement assignment to a non-identifier lvalue (rolling):
            // - index assignment: xs[i] = v   ->   expr-stmt: oren_index_set(xs, i, v)
            //
            // Note: Member assignment (`obj.field = v`) is not part of the x64 v0 subset yet.
            var left = st["left"]
            var v3 = st["value"]
            if left == nil { err(ctx, "x64 native v0: set missing left"); return nil }
            if v3 == nil { err(ctx, "x64 native v0: set missing value"); return nil }

            if left["type"] == "Index" {
                var recv = left["left"]
                var idx = left["index"]
                if recv == nil || idx == nil { err(ctx, "x64 native v0: set index missing operands"); return nil }
                var call = {
                    "type": "Call",
                    "fn": {"type": "Identifier", "token": nil, "value": "oren_index_set"},
                    "args": [recv, idx, v3],
                }
                // Rolling x64 Tier‑1: map index assignment always infers key kind at runtime,
                // so do not propagate any compile-time hints here.
                // Preserve receiver kind when known so codegen can avoid dynamic LIST/MAP dispatch.
                if left["recv_kind"] != nil { call["recv_kind"] = left["recv_kind"] }
                _expr_int_check(ctx, call, nil)
                if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
                oren_list_push(ops, {"op": "expr", "tok": tok, "expr": call})
                i = i + 1
                continue
            }

            err(ctx, "x64 native v0: unsupported set left: " + left["type"])
            return nil
        }
        if t == "Return" {
            var v = st["value"]
            if v == nil { err(ctx, "x64 native v0: return missing value"); return nil }
            oren_list_push(ops, {"op": "return", "tok": tok, "expr": v})
            i = i + 1
            continue
        }
        if t == "If" {
            _cond_check(ctx, st["cond"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            var then_block = st["consq"]
            var else_node = st["alt"]
            if then_block == nil || then_block["type"] != "Block" { err(ctx, "x64 native v0: if then must be Block"); return nil }
            var then_ops = _analyze_stmt_list_to_ops(ctx, then_block["stmts"])
            if then_ops == nil { return nil }
            var else_ops = []
            if else_node != nil {
                if else_node["type"] == "Block" {
                    else_ops = _analyze_stmt_list_to_ops(ctx, else_node["stmts"])
                    if else_ops == nil { return nil }
                } else if else_node["type"] == "If" {
                    // else-if chain: represent as else { if ... }
                    var tmp = _analyze_stmt_list_to_ops(ctx, [else_node])
                    if tmp == nil { return nil }
                    else_ops = tmp
                } else {
                    err(ctx, "x64 native v0: unsupported else node: " + else_node["type"])
                    return nil
                }
            }
            oren_list_push(ops, {"op": "if", "tok": tok, "cond": st["cond"], "then": then_ops, "else": else_ops})
            i = i + 1
            continue
        }
        if t == "While" {
            _cond_check(ctx, st["cond"])
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }
            var body = st["body"]
            if body == nil || body["type"] != "Block" { err(ctx, "x64 native v0: while body must be Block"); return nil }
            var body_ops = _analyze_stmt_list_to_ops(ctx, body["stmts"])
            if body_ops == nil { return nil }
            oren_list_push(ops, {"op": "while", "tok": tok, "cond": st["cond"], "body": body_ops})
            i = i + 1
            continue
        }
        if t == "For" {
            // Support a tiny subset:
            // - `for <cond> { ... }` (cond-only form)
            // - `for var i = 0; <cond>; i = i + 1 { ... }` (3-clause form)
            var init = st["init"]
            var cond = st["cond"]
            var post = st["post"]
            var body3 = st["body"]
            if body3 == nil || body3["type"] != "Block" { err(ctx, "x64 native v0: for body must be Block"); return nil }
            if cond == nil { err(ctx, "x64 native v0: for missing cond"); return nil }
            _cond_check(ctx, cond)
            if ctx["errors"] != nil && oren_list_len(ctx["errors"]) > 0 { return nil }

            // Cond-only form => lower to while.
            if init == nil && post == nil {
                var bops = _analyze_stmt_list_to_ops(ctx, body3["stmts"])
                if bops == nil { return nil }
                oren_list_push(ops, {"op": "while", "tok": tok, "cond": cond, "body": bops})
                i = i + 1
                continue
            }

            // 3-clause form: init and post must be present.
            if init == nil || post == nil {
                err(ctx, "x64 native v0: for init/post required in 3-clause form")
                return nil
            }
            var init_ops = _analyze_stmt_list_to_ops(ctx, [init])
            if init_ops == nil { return nil }
            var post_ops = _analyze_stmt_list_to_ops(ctx, [post])
            if post_ops == nil { return nil }
            var body_ops2 = _analyze_stmt_list_to_ops(ctx, body3["stmts"])
            if body_ops2 == nil { return nil }

            // Restrict post to a single simple update for now (prevents weird continue behavior).
            if oren_list_len(post_ops) != 1 || !_is_x64_for_post_ok(post_ops[0]) {
                err(ctx, "x64 native v0: for post must be simple update")
                return nil
            }
            oren_list_push(ops, {"op": "for", "tok": tok, "init": init_ops, "cond": cond, "post": post_ops, "body": body_ops2})
            i = i + 1
            continue
        }
        if t == "Break" {
            oren_list_push(ops, {"op": "break", "tok": tok})
            i = i + 1
            continue
        }
        if t == "Continue" {
            oren_list_push(ops, {"op": "continue", "tok": tok})
            i = i + 1
            continue
        }
        err(ctx, "x64 native v0: unsupported stmt: " + t)
        return nil
    }
    return ops
}

fn _is_x64_for_post_ok(post_op) {
    // x64 native v0 restriction: keep post as a single "simple" update so `continue`
    // can reliably jump to post then re-check cond.
    //
    // Rolling extension:
    // - allow index assignment lowering (`xs[i] = v`) which is represented as:
    //   op="expr" with expr=`oren_index_set(xs, i, v)`
    if post_op == nil { return 0 }
    var op = post_op["op"]
    if op == "assign_i32" { return 1 }
    if op != "expr" { return 0 }

    var e = post_op["expr"]
    if e == nil || e["type"] != "Call" { return 0 }
    var fn0 = e["fn"]
    if fn0 == nil || fn0["type"] != "Identifier" { return 0 }
    if fn0["value"] != "oren_index_set" { return 0 }
    // Arity sanity (container, index, value)
    var args = e["args"]
    if args == nil || oren_list_len(args) != 3 { return 0 }
    return 1
}
