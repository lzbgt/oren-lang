// x64 native: condition helpers + stmt-to-ops lowering.
//
// Rolling goal: converge Tier‑1 native backends (arm64 + x86_64) toward a shared
// lowering pipeline. The x64 backend originally owned the stmt→ops lowering logic;
// it is now extracted into `lib/compiler/native_ops_v0.oren` so other native backends
// can reuse it during backend architecture unification.

// Condition helpers (used by x64 emitters, e.g. cmp+Jcc lowering).
fn _cond_is_cmp_infix(cond) { return nops.native_cond_is_cmp_infix(cond) }
fn _cond_false_cc(cond_op) { return nops.native_cond_false_cc(cond_op) }
fn _cond_true_cc(cond_op) { return nops.native_cond_true_cc(cond_op) }
fn _cond_false_cc_for_cond(cond) { return nops.native_cond_false_cc_for_cond(cond) }

// Statement lowering (used by x64 native function compilation).
fn _analyze_stmt_list_to_ops(ctx, stmts) { return nops.native_analyze_stmt_list_to_ops(ctx, stmts) }
