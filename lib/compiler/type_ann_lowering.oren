import ast "ast.oren"

// Type annotation lowering (rolling).
//
// Goal (P0 stepping stone):
// - Give type annotations immediate, cross-backend value-level meaning without
//   requiring stable byte layouts yet.
// - Specifically:
//   - when constructing a struct/class, normalize annotated field values via
//     deterministic wrap/truncate casts (u8/i8/u16/i16/u32/i32/etc).
//   - when declaring annotated locals (`var x: u8 = ...`), normalize the
//     initializer value.
//   - when declaring annotated function params/returns (`fn f(x: u8): u8`),
//     normalize values at the function boundary (entry + return).
//
// Why this approach:
// - Works across all backends (C/native/bytecode) because it rewrites AST.
// - Avoids introducing runtime vtables or reflection.
// - Keeps attributes for metadata, not the type system.
//
// Non-goals (future work):
// - Exact-size in-memory layout for non-packed structs (FFI/HPC).
// - Float32 rounding semantics (needs explicit representation support).

fn int_lit(v) { return {"type": "Integer", "token": nil, "value": v} }

fn mask_expr(x, mask_str) {
    return ast.new_infix(nil, x, "&", int_lit(mask_str))
}

fn xor_expr(x, imm_str) {
    return ast.new_infix(nil, x, "^", int_lit(imm_str))
}

fn sub_expr(x, imm_str) {
    return ast.new_infix(nil, x, "-", int_lit(imm_str))
}

fn neq_zero_expr(x) {
    // Normalize to a bool with numeric semantics where possible (int/float: != 0),
    // while still producing a proper BOOL value in the C backend (tagged bool type).
    //
    // NOTE:
    // - We intentionally do NOT use generic truthiness here: the C backend currently treats
    //   all non-nil non-bool values as truthy (including int 0), which breaks `bool` annotations.
    // - `oren_bool_norm` is a small runtime helper implemented per-backend.
    return ast.new_call(nil, {"type": "Identifier", "token": nil, "value": "oren_bool_norm"}, [x])
}

fn normalize_kind_for_value_cast(kind) {
    if kind == nil { return nil }

    // Strip optional namespace prefix.
    if oren_string_len(kind) > 5 {
        if oren_string_slice(kind, 0, 5) == "oren." {
            kind = oren_string_slice(kind, 5, oren_string_len(kind))
        }
    }

    // Treat endian tags as the same width for value-level casts.
    if kind == "u16be" || kind == "u16le" { return "u16" }
    if kind == "i16be" || kind == "i16le" { return "i16" }
    if kind == "u32be" || kind == "u32le" { return "u32" }
    if kind == "i32be" || kind == "i32le" { return "i32" }
    if kind == "u64be" || kind == "u64le" { return "u64" }
    if kind == "i64be" || kind == "i64le" { return "i64" }

    return kind
}

fn cast_expr_for_kind(kind, expr) {
    // Value-level cast semantics (wrap/truncate).
    //
    // IMPORTANT: do not use `if` expressions here.
    // The bytecode backend currently compiles `if` as expression-with-nil result.
    if expr == nil { return expr }
    var k = normalize_kind_for_value_cast(kind)
    if k == nil { return expr }

    if k == "u8" { return mask_expr(expr, "255") }
    if k == "i8" { return sub_expr(xor_expr(mask_expr(expr, "255"), "128"), "128") }

    if k == "u16" { return mask_expr(expr, "65535") }
    if k == "i16" { return sub_expr(xor_expr(mask_expr(expr, "65535"), "32768"), "32768") }

    if k == "u32" { return mask_expr(expr, "4294967295") }
    if k == "i32" { return sub_expr(xor_expr(mask_expr(expr, "4294967295"), "2147483648"), "2147483648") }

    // v0 ints are machine-sized signed. Keep i64 as identity; u64 is best-effort.
    if k == "i64" || k == "u64" { return expr }

    // bool is normalized to a boolean value.
    if k == "bool" { return neq_zero_expr(expr) }

    if k == "f32" {
        // Round to float32 precision (deterministic boundary).
        // Lowered as a call so C/bytecode backends can implement it as a runtime helper.
        return ast.new_call(nil, {"type": "Identifier", "token": nil, "value": "oren_f32_round"}, [expr])
    }
    // f64 is the default float precision in v0.
    return expr
}

fn lower_expr_in_place(expr, type_kinds, ret_kind) {
    if expr == nil { return nil }
    var t = expr["type"]

    if t == "Function" {
        // Descend into function bodies so annotations on types declared at top-level
        // apply to constructor calls inside functions.
        // Also: normalize annotated params/returns at function boundaries.
        var fn_ret = expr["ret_ann_type"]
        if fn_ret == nil { fn_ret = ret_kind }

        // Normalize annotated params at entry by inserting `x = cast(x)` at the top of the body.
        var params = expr["params"]
        if params != nil && oren_list_len(params) > 0 {
            var pre = []
            var i0 = 0
            while i0 < oren_list_len(params) {
                var pid = params[i0]
                if pid != nil && pid["ann_type"] != nil {
                    var nm = pid["value"]
                    var lhs = {"type": "Identifier", "token": nil, "value": nm}
                    var rhs = cast_expr_for_kind(pid["ann_type"], {"type": "Identifier", "token": nil, "value": nm})
                    oren_list_push(pre, ast.new_assign(nil, lhs, rhs))
                }
                i0 = i0 + 1
            }
            if oren_list_len(pre) > 0 {
                var body = expr["body"]
                if body != nil && body["type"] == "Block" {
                    var old = body["stmts"]
                    var out = []
                    var j0 = 0
                    while j0 < oren_list_len(pre) {
                        oren_list_push(out, pre[j0])
                        j0 = j0 + 1
                    }
                    var k0 = 0
                    while k0 < oren_list_len(old) {
                        oren_list_push(out, old[k0])
                        k0 = k0 + 1
                    }
                    body["stmts"] = out
                }
            }
        }

        lower_stmt_in_place(expr["body"], type_kinds, fn_ret)
        return expr
    }

    if t == "Prefix" {
        expr["right"] = lower_expr_in_place(expr["right"], type_kinds, ret_kind)
        return expr
    }
    if t == "Infix" {
        expr["left"] = lower_expr_in_place(expr["left"], type_kinds, ret_kind)
        expr["right"] = lower_expr_in_place(expr["right"], type_kinds, ret_kind)
        return expr
    }
    if t == "If" {
        // If-as-statement/expression (expression result is currently nil in bytecode backend).
        expr["cond"] = lower_expr_in_place(expr["cond"], type_kinds, ret_kind)
        lower_stmt_in_place(expr["consq"], type_kinds, ret_kind)
        if expr["alt"] != nil { lower_stmt_in_place(expr["alt"], type_kinds, ret_kind) }
        return expr
    }
    if t == "Array" {
        var xs = expr["elements"]
        var i = 0
        while i < oren_list_len(xs) {
            xs[i] = lower_expr_in_place(xs[i], type_kinds, ret_kind)
            i = i + 1
        }
        return expr
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i2 = 0
        while i2 < oren_list_len(ps) {
            ps[i2]["key"] = lower_expr_in_place(ps[i2]["key"], type_kinds, ret_kind)
            ps[i2]["value"] = lower_expr_in_place(ps[i2]["value"], type_kinds, ret_kind)
            i2 = i2 + 1
        }
        return expr
    }
    if t == "Index" {
        expr["left"] = lower_expr_in_place(expr["left"], type_kinds, ret_kind)
        expr["index"] = lower_expr_in_place(expr["index"], type_kinds, ret_kind)
        return expr
    }
    if t == "Member" {
        expr["left"] = lower_expr_in_place(expr["left"], type_kinds, ret_kind)
        return expr
    }
    if t == "SpawnExpr" {
        expr["call"] = lower_expr_in_place(expr["call"], type_kinds, ret_kind)
        return expr
    }
    if t == "Call" {
        // Rewrite children first.
        expr["fn"] = lower_expr_in_place(expr["fn"], type_kinds, ret_kind)
        var args = expr["args"]
        var i3 = 0
        while i3 < oren_list_len(args) {
            args[i3] = lower_expr_in_place(args[i3], type_kinds, ret_kind)
            i3 = i3 + 1
        }
        if expr["spread"] != nil {
            expr["spread"] = lower_expr_in_place(expr["spread"], type_kinds, ret_kind)
        }

        // Struct/class constructor normalization:
        // If callee is an Identifier that names a known type, cast args by field annotation.
        var fn_expr = expr["fn"]
        if fn_expr != nil && fn_expr["type"] == "Identifier" {
            var name = fn_expr["value"]
            var kinds = type_kinds[name]
            if kinds != nil {
                // Apply casts positionally if arity matches.
                if oren_list_len(kinds) == oren_list_len(args) {
                    var j = 0
                    while j < oren_list_len(args) {
                        if kinds[j] != nil {
                            args[j] = cast_expr_for_kind(kinds[j], args[j])
                        }
                        j = j + 1
                    }
                }
            }
        }
        return expr
    }

    // Leaf expressions.
    return expr
}

fn lower_stmt_in_place(stmt, type_kinds, ret_kind) {
    if stmt == nil { return nil }
    var t = stmt["type"]

    if t == "Block" {
        var stmts = stmt["stmts"]
        var i = 0
        while i < oren_list_len(stmts) {
            lower_stmt_in_place(stmts[i], type_kinds, ret_kind)
            i = i + 1
        }
        return stmt
    }
    if t == "StmtList" {
        var xs = stmt["stmts"]
        var i2 = 0
        while i2 < oren_list_len(xs) {
            lower_stmt_in_place(xs[i2], type_kinds, ret_kind)
            i2 = i2 + 1
        }
        return stmt
    }
    if t == "Var" {
        stmt["value"] = lower_expr_in_place(stmt["value"], type_kinds, ret_kind)
        // Annotated local/short-var normalization: `var x: u8 = ...`.
        var nm = stmt["name"]
        if nm != nil && nm["ann_type"] != nil {
            stmt["value"] = cast_expr_for_kind(nm["ann_type"], stmt["value"])
        }
        return stmt
    }
    if t == "Assign" {
        stmt["value"] = lower_expr_in_place(stmt["value"], type_kinds, ret_kind)
        return stmt
    }
    if t == "Set" {
        stmt["left"] = lower_expr_in_place(stmt["left"], type_kinds, ret_kind)
        stmt["value"] = lower_expr_in_place(stmt["value"], type_kinds, ret_kind)
        return stmt
    }
    if t == "Return" {
        stmt["value"] = lower_expr_in_place(stmt["value"], type_kinds, ret_kind)
        if ret_kind != nil {
            stmt["value"] = cast_expr_for_kind(ret_kind, stmt["value"])
        }
        return stmt
    }
    if t == "ExprStmt" {
        stmt["expr"] = lower_expr_in_place(stmt["expr"], type_kinds, ret_kind)
        return stmt
    }
    if t == "While" {
        stmt["cond"] = lower_expr_in_place(stmt["cond"], type_kinds, ret_kind)
        lower_stmt_in_place(stmt["body"], type_kinds, ret_kind)
        return stmt
    }
    if t == "For" {
        if stmt["init"] != nil { lower_stmt_in_place(stmt["init"], type_kinds, ret_kind) }
        if stmt["cond"] != nil { stmt["cond"] = lower_expr_in_place(stmt["cond"], type_kinds, ret_kind) }
        if stmt["post"] != nil { lower_stmt_in_place(stmt["post"], type_kinds, ret_kind) }
        lower_stmt_in_place(stmt["body"], type_kinds, ret_kind)
        return stmt
    }
    if t == "Spawn" {
        stmt["call"] = lower_expr_in_place(stmt["call"], type_kinds, ret_kind)
        return stmt
    }
    if t == "Switch" {
        stmt["value"] = lower_expr_in_place(stmt["value"], type_kinds, ret_kind)
        var cases = stmt["cases"]
        var ci = 0
        while ci < oren_list_len(cases) {
            var vals = cases[ci]["values"]
            var vi = 0
            while vi < oren_list_len(vals) {
                vals[vi] = lower_expr_in_place(vals[vi], type_kinds, ret_kind)
                vi = vi + 1
            }
            lower_stmt_in_place(cases[ci]["body"], type_kinds, ret_kind)
            ci = ci + 1
        }
        if stmt["default"] != nil { lower_stmt_in_place(stmt["default"], type_kinds, ret_kind) }
        return stmt
    }

    return stmt
}

fn collect_type_kinds_in_stmt(stmt, type_kinds) {
    if stmt == nil { return nil }
    var t = stmt["type"]

    if t == "Type" {
        var tname = stmt["name"]["value"]
        var fields = stmt["fields"]
        var kinds = []
        var j = 0
        while j < oren_list_len(fields) {
            var fid = fields[j]
            if fid != nil && fid["ann_type"] != nil {
                oren_list_push(kinds, fid["ann_type"])
            } else {
                oren_list_push(kinds, nil)
            }
            j = j + 1
        }
        type_kinds[tname] = kinds
        return nil
    }

    if t == "Block" {
        var xs = stmt["stmts"]
        var i = 0
        while i < oren_list_len(xs) {
            collect_type_kinds_in_stmt(xs[i], type_kinds)
            i = i + 1
        }
        return nil
    }
    if t == "StmtList" {
        var xs2 = stmt["stmts"]
        var i2 = 0
        while i2 < oren_list_len(xs2) {
            collect_type_kinds_in_stmt(xs2[i2], type_kinds)
            i2 = i2 + 1
        }
        return nil
    }
    if t == "ExprStmt" {
        var e = stmt["expr"]
        if e != nil && e["type"] == "Function" {
            // Type decls inside function bodies (if allowed) should also be collected.
            collect_type_kinds_in_stmt(e["body"], type_kinds)
        }
        return nil
    }
    if t == "While" {
        collect_type_kinds_in_stmt(stmt["body"], type_kinds)
        return nil
    }
    if t == "For" {
        if stmt["init"] != nil { collect_type_kinds_in_stmt(stmt["init"], type_kinds) }
        if stmt["post"] != nil { collect_type_kinds_in_stmt(stmt["post"], type_kinds) }
        collect_type_kinds_in_stmt(stmt["body"], type_kinds)
        return nil
    }
    if t == "Switch" {
        var cases = stmt["cases"]
        var ci = 0
        while ci < oren_list_len(cases) {
            collect_type_kinds_in_stmt(cases[ci]["body"], type_kinds)
            ci = ci + 1
        }
        if stmt["default"] != nil { collect_type_kinds_in_stmt(stmt["default"], type_kinds) }
        return nil
    }

    return nil
}

fn lower_linked_program_in_place(linked) {
    if linked == nil { return nil }

    // Build mapping: TypeName -> [field_kind_or_nil...]
    var type_kinds = {}
    var stmts = linked["statements"]
    var i = 0
    while i < oren_list_len(stmts) {
        collect_type_kinds_in_stmt(stmts[i], type_kinds)
        i = i + 1
    }

    // Rewrite expressions in all statements.
    i = 0
    while i < oren_list_len(stmts) {
        lower_stmt_in_place(stmts[i], type_kinds, nil)
        i = i + 1
    }

    linked["type_kinds"] = type_kinds
    return linked
}
