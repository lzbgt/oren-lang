// Linux arm64 ABI constants used by the syscall-first native backend.
//
// Policy:
// - Prefer repo-owned constants (this file + docs/refs) over depending on host SDK headers.
// - System headers may be used for audit/verification, but must not be a build dependency.
//
// References (vendored for audit):
// - `docs/refs/linux_asm_generic_unistd.h`
// - `docs/refs/linux_arm64_unistd.h`

// --- Syscall numbers (arm64, Linux) ---
// NOTE: Numbers below are from `docs/refs/linux_asm_generic_unistd.h`.
fn linux_sys_getcwd() { return 17 }
fn linux_sys_mkdirat() { return 34 }
fn linux_sys_unlinkat() { return 35 }
fn linux_sys_renameat() { return 38 }
fn linux_sys_faccessat() { return 48 }
fn linux_sys_openat() { return 56 }
fn linux_sys_close() { return 57 }
fn linux_sys_pipe2() { return 59 }
fn linux_sys_getdents64() { return 61 }
fn linux_sys_read() { return 63 }
fn linux_sys_write() { return 64 }
fn linux_sys_fcntl() { return 25 }
fn linux_sys_dup() { return 23 }
fn linux_sys_dup3() { return 24 }
fn linux_sys_ioctl() { return 29 }
fn linux_sys_kill() { return 129 }
fn linux_sys_gettimeofday() { return 169 }
fn linux_sys_getsockname() { return 204 }
fn linux_sys_getpeername() { return 205 }
fn linux_sys_setsockopt() { return 208 }
fn linux_sys_getsockopt() { return 209 }
fn linux_sys_shutdown() { return 210 }
fn linux_sys_execve() { return 221 }
fn linux_sys_wait4() { return 260 }
fn linux_sys_socket() { return 198 }
fn linux_sys_bind() { return 200 }
fn linux_sys_listen() { return 201 }
fn linux_sys_accept() { return 202 }
fn linux_sys_connect() { return 203 }
fn linux_sys_sendto() { return 206 }
fn linux_sys_recvfrom() { return 207 }
fn linux_sys_newfstatat() { return 79 }
fn linux_sys_fstat() { return 80 }
fn linux_sys_nanosleep() { return 101 }
fn linux_sys_clone() { return 220 }
fn linux_sys_gettid() { return 178 }
fn linux_sys_exit() { return 93 }
fn linux_sys_exit_group() { return 94 }
fn linux_sys_mmap() { return 222 }

// Repo-owned open(2) flag constants (Linux).
// Used by syscall-first native backend; do not rely on glibc headers at build time.
fn linux_open_flag_creat() { return 64 }   // O_CREAT = 0x0040
fn linux_open_flag_trunc() { return 512 }  // O_TRUNC = 0x0200

// --- Syscall instruction ABI (arm64, Linux) ---
// Linux AArch64 syscall convention:
// - syscall number in X8
// - `svc #0`
fn linux_syscall_reg() { return 8 }
fn linux_svc_imm() { return 0 }

// --- Linux AT_* constants (syscall args) ---
fn linux_at_fdcwd() { return -100 } // AT_FDCWD (relative to current working directory)
fn linux_at_symlink_nofollow() { return 256 } // 0x100
fn linux_at_removedir() { return 512 } // 0x200

// --- mmap constants (Linux) ---
//
// Repo-owned constants used by the syscall-first allocator path.
// Verified against `docs/refs/linux_*` (audit-only; not a build dependency).
//
// prot bits:
//   PROT_READ  = 0x1
//   PROT_WRITE = 0x2
// flags bits:
//   MAP_PRIVATE   = 0x02
//   MAP_ANONYMOUS = 0x20
fn linux_mmap_prot_read_write() { return 3 } // PROT_READ|PROT_WRITE
fn linux_mmap_flags_private_anon() { return 34 } // MAP_PRIVATE|MAP_ANONYMOUS (0x22)
