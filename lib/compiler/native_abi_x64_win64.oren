// Windows x64 (Win64) ABI (integer subset).
//
// Registers use the x64_core numbering:
// - 0: rax, 1: rcx, 2: rdx, 8: r8, 9: r9

fn x64_win64() {
    return {
        // Integer/pointer args: rcx, rdx, r8, r9
        "int_arg_regs": [1, 2, 8, 9],
        // Win64 requires 32B shadow space reserved by the caller for every call.
        "caller_shadow_bytes": 32,
        // v0: we reserve 64B in each function frame:
        // - 32B shadow + scratch for stack args used by WriteFile and future FFI.
        "callee_call_area_bytes": 64,
    }
}
