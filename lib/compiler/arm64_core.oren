import bb "bytes_builder.oren"

// --- Binary Utils ---
// Re-export shared byte-builder helpers so backend code stays readable.
fn bytes_new() { return bb.bytes_new() }
fn bytes_len(b) { return bb.bytes_len(b) }
fn bytes_push(b, v) { return bb.bytes_push(b, v) }
fn bytes_extend(b, other) { return bb.bytes_extend(b, other) }
fn bytes_extend_zeros(b, n) { return bb.bytes_extend_zeros(b, n) }
fn bytes_extend_list(b, xs) { return bb.bytes_extend_list(b, xs) }
fn bytes_extend_u8_buf(b, ubuf) { return bb.bytes_extend_u8_buf(b, ubuf) }
fn bytes_set_u8(b, idx, v) { return bb.bytes_set_u8(b, idx, v) }
fn bytes_finalize(b) { return bb.bytes_finalize(b) }

// --- Codegen Scopes (native backend locals) ---
//
// The native backend tracks locals as SP-relative offsets derived from `ctx["stack_size"]`.
// Blocks restore SP at runtime, so we must also restore the compiler's locals bindings when
// leaving a block. Otherwise stale offsets alias later locals (e.g. parent/child branches).
//
// We implement lexical scopes with an undo log:
// - scope_enter_codegen(): push a scope frame
// - scope_mark_declared_codegen(name, prev_off, prev_floaty, prev_stringy): record previous binding
// - scope_exit_codegen(): restore previous bindings
//
fn scope_enter_codegen(ctx) {
    var prev = ctx["scope"]
    ctx["scope"] = {"prev": prev, "undo": [], "names": {}}
}

fn scope_current_codegen(ctx) {
    return ctx["scope"]
}

fn scope_mark_declared_codegen(ctx, name, prev_off, prev_floaty, prev_stringy, prev_list_stringy) {
    var scope = scope_current_codegen(ctx)
    if scope == nil {
        scope_enter_codegen(ctx)
        scope = scope_current_codegen(ctx)
    }
    scope["names"][name] = 1
    oren_list_push(scope["undo"], {"name": name, "prev": prev_off, "prev_floaty": prev_floaty, "prev_stringy": prev_stringy, "prev_list_stringy": prev_list_stringy})
}

fn scope_exit_codegen(ctx) {
    var scope = ctx["scope"]
    if scope == nil { return nil }

    var undo = scope["undo"]
    var i = oren_list_len(undo) - 1
    while i >= 0 {
        var u = undo[i]
        var name = u["name"]
        var prev = u["prev"]
        if prev == nil {
            ctx["locals"][name] = nil
        } else {
            ctx["locals"][name] = prev
        }
        // Best-effort: restore floatiness metadata if present.
        // This enables "float operator parity" in the native backend without a full type system.
        if ctx["locals_floaty"] != nil {
            var pf = u["prev_floaty"]
            if pf == nil {
                ctx["locals_floaty"][name] = nil
            } else {
                ctx["locals_floaty"][name] = pf
            }
        }
        if ctx["locals_stringy"] != nil {
            var ps = u["prev_stringy"]
            if ps == nil {
                ctx["locals_stringy"][name] = nil
            } else {
                ctx["locals_stringy"][name] = ps
            }
        }
        if ctx["locals_list_stringy"] != nil {
            var pls = u["prev_list_stringy"]
            if pls == nil {
                ctx["locals_list_stringy"][name] = nil
            } else {
                ctx["locals_list_stringy"][name] = pls
            }
        }
        i = i - 1
    }

    ctx["scope"] = scope["prev"]
    return nil
}

fn set_u32_le(buf, offset, n) {
    // Delegate to the bytes builder fast path (1 bounds check + raw stores).
    return bb.bytes_set_u32_le(buf, offset, n)
}

fn align_up(n, align) {
    return (n + align - 1) / align * align
}

fn ceil_div(a, b) {
    return (a + b - 1) / b
}

fn int_mod(a, b) { return a - (a / b) * b }

fn emit_sub_sp_any(ctx, bytes) {
    // SUB SP, SP, #imm12 (imm12 max 4095). Keep 16B alignment.
    var n = bytes
    while n > 0 {
        var chunk = n
        if chunk > 4080 { chunk = 4080 } // 255 * 16 keeps alignment and fits imm12
        push_u32_le(ctx["code"], insn_sub_sp(chunk))
        n = n - chunk
    }
}

fn emit_add_sp_any(ctx, bytes) {
    // ADD SP, SP, #imm12 (imm12 max 4095). Keep 16B alignment.
    var n = bytes
    while n > 0 {
        var chunk = n
        if chunk > 4080 { chunk = 4080 } // 255 * 16 keeps alignment and fits imm12
        push_u32_le(ctx["code"], insn_add_sp(chunk))
        n = n - chunk
    }
}

fn emit_load_ptr_from_base_plus(ctx, dst, base, offset_bytes) {
    // Load *(u64*)(base + offset_bytes) into dst.
    if offset_bytes == 0 {
        push_u32_le(ctx["code"], insn_ldr_ptr(dst, base))
        return nil
    }

    if offset_bytes >= -256 && offset_bytes <= 255 {
        push_u32_le(ctx["code"], insn_ldur_reg(dst, base, offset_bytes))
        return nil
    }

    // addr = base + offset
    emit_load_u64_imm(ctx, 11, offset_bytes)
    push_u32_le(ctx["code"], insn_add_reg(12, base, 11))
    push_u32_le(ctx["code"], insn_ldr_ptr(dst, 12))
    return nil
}

fn int_from_string(s) {
    var i = 0
    var n = 0
    var neg = false
    if oren_string_len(s) > 0 {
        var c0 = oren_string_char_at(s, 0)
        if c0 == "-" { neg = true; i = 1 }
        else {
            if c0 == "+" { i = 1 }
        }
    }

    var base = 10
    if i + 1 < oren_string_len(s) && oren_string_char_at(s, i) == "0" {
        var c1 = oren_string_char_at(s, i + 1)
        if c1 == "x" || c1 == "X" { base = 16; i = i + 2 }
        else {
            if c1 == "b" || c1 == "B" { base = 2; i = i + 2 }
            else {
                if c1 == "o" || c1 == "O" { base = 8; i = i + 2 }
            }
        }
    }
    while i < oren_string_len(s) {
        var ch = oren_string_char_at(s, i)
        var digit = 0
        if ch == "_" { i = i + 1; continue }
        if ch == "0" { digit = 0 }
        if ch == "1" { digit = 1 }
        if ch == "2" { digit = 2 }
        if ch == "3" { digit = 3 }
        if ch == "4" { digit = 4 }
        if ch == "5" { digit = 5 }
        if ch == "6" { digit = 6 }
        if ch == "7" { digit = 7 }
        if ch == "8" { digit = 8 }
        if ch == "9" { digit = 9 }
        if base == 16 {
            if ch == "a" || ch == "A" { digit = 10 }
            if ch == "b" || ch == "B" { digit = 11 }
            if ch == "c" || ch == "C" { digit = 12 }
            if ch == "d" || ch == "D" { digit = 13 }
            if ch == "e" || ch == "E" { digit = 14 }
            if ch == "f" || ch == "F" { digit = 15 }
        }
        n = n * base + digit
        i = i + 1
    }
    if neg { return -n }
    return n
}

fn contains_curly_braces(s) {
    var i = 0
    var len = oren_string_len(s)
    while i < len - 1 {
        if oren_string_char_at(s, i) == "{" {
            if oren_string_char_at(s, i + 1) == "}" { return true }
        }
        i = i + 1
    }
    return false
}

fn push_u32_le(buf, n) {
    return bb.bytes_push_u32_le(buf, n)
}

fn push_u32_be(buf, n) {
    bytes_push(buf, int_mod(n / 16777216, 256))
    bytes_push(buf, int_mod(n / 65536, 256))
    bytes_push(buf, int_mod(n / 256, 256))
    bytes_push(buf, int_mod(n, 256))
}

fn push_u64_le(buf, n) {
    return bb.bytes_push_u64_le(buf, n)
}

// --- ARM64 Instructions ---

fn insn_ret() { return 3596551104 } // RET (0xD65F03C0)

fn insn_movz(reg, imm16) {
    // MOVZ Xreg, #imm16
    return 3531603968 + (imm16 * 32) + reg
}

fn insn_mov_reg(rd, rn) {
    // MOV Xrd, Xrn (alias of ORR Xrd, XZR, Xrn)
    return 2852127712 + (rn * 65536) + rd // 0xAA0003E0 base
}

fn insn_sxtw(rd, rn) {
    // SXTW Xrd, Wrn (sign-extend 32-bit -> 64-bit).
    //
    // Verified via clang:
    //   sxtw x0, w0 => 0x93407C00
    return 2470476800 + (rn * 32) + rd // 0x93407C00 base
}

fn insn_uxtw(rd, rn) {
    // UXTW Xrd, Wrn (zero-extend 32-bit -> 64-bit).
    //
    // Verified via clang:
    //   uxtw x0, w0 => 0xD3407C00 (alias: ubfx x0, x0, #0, #32)
    return 3544218624 + (rn * 32) + rd // 0xD3407C00 base
}

fn insn_movn(rd, imm) {
    return 2457862144 + (imm * 32) + rd
}

fn insn_svc(imm) {
    return 3556769793 + (imm * 32)
}

fn insn_add_sp(imm) {
    // ADD SP, SP, #imm12 (shift=0)
    // Verified via clang:
    //   add sp, sp, #16 => 0x910043FF
    return 2432697343 + (imm * 1024)
}

fn insn_str_x0_sp(offset) {
    // STR X0, [SP, #imm12<<3] (unsigned offset encoding, scaled by 8)
    // Verified via clang:
    //   str x0, [sp]       => 0xF90003E0
    //   str x7, [sp,#24]   => 0xF9000FE7
    return 4177527776 + ((offset / 8) * 1024)
}

fn insn_ldr_reg_sp(reg, offset) {
    // LDR Xt, [SP, #imm12<<3] (unsigned offset encoding, scaled by 8)
    // Verified via clang:
    //   ldr x0, [sp]       => 0xF94003E0
    //   ldr x6, [sp,#16]   => 0xF9400BE6
    return 4181722080 + ((offset / 8) * 1024) + reg
}

fn insn_ldr_x0_sp(offset) {
    return insn_ldr_reg_sp(0, offset)
}

fn insn_sub_imm(rd, rn, imm) {
    // SUB Xrd, Xrn, #imm (imm12, shift=0)
    return 3506438144 + (imm * 1024) + (rn * 32) + rd // base 0xD1000000
}

fn insn_stur_reg(rt, rn, offset) {
    // STUR Xt, [Xn, #imm9] (unscaled signed byte offset, imm9 range [-256,255])
    var imm9 = offset
    if imm9 < 0 { imm9 = imm9 + 512 } // 2's complement 9-bit
    return 4160749568 + (imm9 * 4096) + (rn * 32) + rt // base 0xF8000000
}

fn insn_ldur_reg(rt, rn, offset) {
    // LDUR Xt, [Xn, #imm9] (unscaled signed byte offset, imm9 range [-256,255])
    var imm9 = offset
    if imm9 < 0 { imm9 = imm9 + 512 } // 2's complement 9-bit
    return 4164943872 + (imm9 * 4096) + (rn * 32) + rt // base 0xF8400000
}

fn emit_load_u64_imm(ctx, reg, val) {
    // Load unsigned immediate into Xreg using MOVZ/MOVK sequence.
    var low = int_mod(val, 65536)
    push_u32_le(ctx["code"], insn_movz(reg, low))

    var rest = val / 65536
    var shift = 1
    while rest > 0 {
        var part = int_mod(rest, 65536)
        push_u32_le(ctx["code"], insn_movk(reg, part, shift))
        rest = rest / 65536
        shift = shift + 1
    }
}

fn emit_load_i64_imm(ctx, reg, val) {
    // Load signed immediate into Xreg.
    //
    // Used for ABI constants like AT_FDCWD=-100 where we want:
    // - repo-owned constants (no platform headers)
    // - no magic MOVN immediates spread through syscall lowering
    //
    // Encoding strategy:
    // - val >= 0: MOVZ/MOVK sequence via emit_load_u64_imm
    // - -65536 <= val < 0: MOVN reg, (abs(val)-1) (since MOVN yields -imm16-1)
    // - otherwise: load abs(val) and negate with XZR - abs
    if val >= 0 {
        emit_load_u64_imm(ctx, reg, val)
        return nil
    }

    // Special-case INT64_MIN: abs(INT64_MIN) overflows in two's complement.
    // Emit the bit-pattern directly: 0x8000_0000_0000_0000.
    var i64_min = 0 - (1 << 63)
    if val == i64_min {
        push_u32_le(ctx["code"], insn_movz(reg, 0))
        push_u32_le(ctx["code"], insn_movk(reg, 32768, 3)) // 0x8000 << 48
        return nil
    }

    var abs = 0 - val
    if abs <= 65536 {
        push_u32_le(ctx["code"], insn_movn(reg, abs - 1))
        return nil
    }

    emit_load_u64_imm(ctx, reg, abs)
    push_u32_le(ctx["code"], insn_sub_reg(reg, 31, reg))
    return nil
}

fn emit_add_sp_offset_to_reg(ctx, reg, offset) {
    // Emit: Xreg = SP + offset (offset in bytes, may be negative).
    if offset == 0 {
        push_u32_le(ctx["code"], insn_add_imm(reg, 31, 0))
        return nil
    }

    if offset > 0 {
        if offset <= 4095 {
            push_u32_le(ctx["code"], insn_add_imm(reg, 31, offset))
            return nil
        }
        emit_load_u64_imm(ctx, reg, offset)
        push_u32_le(ctx["code"], insn_add_reg(reg, 31, reg))
        return nil
    }

    // offset < 0
    var abs = 0 - offset
    if abs <= 4095 {
        push_u32_le(ctx["code"], insn_sub_imm(reg, 31, abs))
        return nil
    }
    emit_load_u64_imm(ctx, reg, abs)
    push_u32_le(ctx["code"], insn_sub_reg(reg, 31, reg))
    return nil
}

fn emit_ldr_reg_sp_any(ctx, reg, offset) {
    // Safe stack load helper:
    // - prefers scaled LDR [SP, #imm12*8] when possible
    // - falls back to LDUR [SP, #imm9] for small signed offsets
    // - otherwise materializes the address into a scratch register and loads via [Xtmp]
    if offset >= 0 && int_mod(offset, 8) == 0 && offset <= (4095 * 8) {
        push_u32_le(ctx["code"], insn_ldr_reg_sp(reg, offset))
        return nil
    }

    if offset >= -256 && offset <= 255 {
        push_u32_le(ctx["code"], insn_ldur_reg(reg, 31, offset))
        return nil
    }

    var scratch = 15
    if reg == scratch { scratch = 14 }
    emit_add_sp_offset_to_reg(ctx, scratch, offset)
    push_u32_le(ctx["code"], insn_ldr_ptr(reg, scratch))
    return nil
}

fn emit_str_reg_sp_any(ctx, reg, offset) {
    // Safe stack store helper (see emit_ldr_reg_sp_any for rationale).
    if offset >= 0 && int_mod(offset, 8) == 0 && offset <= (4095 * 8) {
        push_u32_le(ctx["code"], insn_str_reg_sp(reg, offset))
        return nil
    }

    if offset >= -256 && offset <= 255 {
        push_u32_le(ctx["code"], insn_stur_reg(reg, 31, offset))
        return nil
    }

    var scratch = 15
    if reg == scratch { scratch = 14 }
    emit_add_sp_offset_to_reg(ctx, scratch, offset)
    push_u32_le(ctx["code"], insn_str_ptr(reg, scratch))
    return nil
}

fn insn_add_reg(rd, rn, rm) {
    return 2332033024 + (rm * 65536) + (rn * 32) + rd
}

fn insn_and_reg(rd, rn, rm) {
    // AND Xd, Xn, Xm
    // Verified via clang:
    //   and x3, x4, x5 => 0x8A050083
    return 2315255808 + (rm * 65536) + (rn * 32) + rd
}

fn insn_orr_reg(rd, rn, rm) {
    // ORR Xd, Xn, Xm
    // Verified via clang:
    //   orr x6, x7, x8 => 0xAA0800E6
    return 2852126720 + (rm * 65536) + (rn * 32) + rd
}

fn insn_eor_reg(rd, rn, rm) {
    // EOR Xd, Xn, Xm
    // Verified via clang:
    //   eor x9, x10, x11 => 0xCA0B0149
    return 3388997632 + (rm * 65536) + (rn * 32) + rd
}

fn insn_lslv(rd, rn, rm) {
    return 2596282368 + (rm * 65536) + (rn * 32) + rd
}

fn insn_lsrv(rd, rn, rm) {
    return 2596283392 + (rm * 65536) + (rn * 32) + rd
}

fn insn_cmp_reg(rn, rm) {
    // CMP Xn, Xm (alias of SUBS XZR, Xn, Xm)
    // Verified via clang:
    //   cmp x12, x13 => 0xEB0D019F
    return 3942645791 + (rm * 65536) + (rn * 32)
}

fn insn_cset(rd, cond) {
    // Alias for CSINC Xd, XZR, XZR, invert(cond)
    // Verified via clang:
    //   cset x14, eq => 0x9A9F17EE
    //   cset x15, ne => 0x9A9F07EF
    return 2594113504 + ((cond ^ 1) * 4096) + rd
}

fn insn_b(off) {
    if off < 0 {
        off = off + 67108864 // 2^26
    }
    return 335544320 + off
}

fn insn_b_cond(off, cond) {
    if off < 0 {
        off = off + 524288 // 2^19
    }
    return 1409286144 + (off * 32) + cond
}

fn insn_bl(off) {
    if off < 0 {
        off = off + 67108864
    }
    return 2483027968 + off
}

fn insn_blr(rn) {
    // BLR Xrn (branch with link to register)
    // Encoding: 0xD63F0000 | (rn << 5)
    return 3594452992 + (rn * 32)
}

fn insn_sub_sp(imm) {
    // SUB SP, SP, #imm12 (shift=0)
    // Verified via clang:
    //   sub sp, sp, #32 => 0xD10083FF
    return 3506439167 + (imm * 1024)
}

fn insn_sub_reg(rd, rn, rm) {
    return 3405774848 + (rm * 65536) + (rn * 32) + rd
}

fn insn_stp_pre() {
    return 2847898621
}

fn insn_ldp_post() {
    return 2831252477
}

fn insn_stp_pair_pre(rt, rt2, rn, offset) {
    // STP Xt, Xt2, [Xn, #imm7<<3]!
    //
    // Pair store with pre-index addressing (writes back to base).
    // Encodes a signed imm7 scaled by 8 bytes.
    //
    // Verified via clang:
    //   stp x19, x20, [sp, #-16]! => 0xA9BF53F3
    //   stp x21, x22, [sp, #-32]! => 0xA9BE5BF5
    // Note: derive sign from `offset` (not `imm7`) to avoid any surprises from
    // integer division semantics on negative numbers across backends.
    var imm7 = offset / 8
    if offset < 0 { imm7 = imm7 + 128 } // 2's complement 7-bit
    // Base: 0xA9800000
    return 2843738112 + (imm7 * 32768) + (rt2 * 1024) + (rn * 32) + rt
}

fn insn_ldp_pair_post(rt, rt2, rn, offset) {
    // LDP Xt, Xt2, [Xn], #imm7<<3
    //
    // Pair load with post-index addressing (writes back to base).
    // Encodes a signed imm7 scaled by 8 bytes.
    //
    // Verified via clang:
    //   ldp x19, x20, [sp], #16 => 0xA8C153F3
    //   ldp x21, x22, [sp], #32 => 0xA8C25BF5
    var imm7 = offset / 8
    if offset < 0 { imm7 = imm7 + 128 } // 2's complement 7-bit
    // Base: 0xA8C00000
    return 2831155200 + (imm7 * 32768) + (rt2 * 1024) + (rn * 32) + rt
}

fn insn_mov_fp_sp() {
    return 2432697341
}

fn insn_mov_sp_fp() {
    return 2432697279
}

fn insn_str_reg_pre(i) {
    return 4162752480 + i
}

fn insn_str_reg_sp(reg, offset) {
    // STR Xt, [SP, #imm12<<3] (unsigned offset encoding, scaled by 8)
    // Verified via clang:
    //   str x0, [sp]       => 0xF90003E0
    //   str x7, [sp,#24]   => 0xF9000FE7
    return 4177527776 + ((offset / 8) * 1024) + reg
}

fn insn_dup_2d(vd, rn) {
    // DUP Vd.2D, Xn
    // Verified via clang:
    //   dup v4.2d, x0 => 0x4E080C04
    // Base: 0x4E080C00
    return 1309150208 + (rn * 32) + vd
}

fn insn_dup_4s(vd, rn) {
    // DUP Vd.4S, Wn
    // Verified via clang:
    //   dup v4.4s, w0 => 0x4E040C04
    // Base: 0x4E040C00
    return 1308888064 + (rn * 32) + vd
}

fn insn_add_2d(vd, vn, vm) {
    // ADD Vd.2D, Vn.2D, Vm.2D
    // Verified via clang:
    //   add v4.2d, v2.2d, v3.2d => 0x4EE38444
    // Base: 0x4EE08400
    return 1323336704 + (vm * 65536) + (vn * 32) + vd
}

fn insn_sub_2d(vd, vn, vm) {
    // SUB Vd.2D, Vn.2D, Vm.2D
    // Verified via clang:
    //   sub v4.2d, v2.2d, v3.2d => 0x6EE38444
    // Base: 0x6EE08400
    return 1860207616 + (vm * 65536) + (vn * 32) + vd
}

fn insn_and_16b(vd, vn, vm) {
    return 1310727168 + (vm * 65536) + (vn * 32) + vd
}

fn insn_orr_16b(vd, vn, vm) {
    return 1319115776 + (vm * 65536) + (vn * 32) + vd
}

fn insn_eor_16b(vd, vn, vm) {
    return 1847598080 + (vm * 65536) + (vn * 32) + vd
}

fn insn_umov_d0(rd, vn) {
    return 1309162496 + (vn * 32) + rd
}

fn insn_fmov_d_x(rd, rn) {
    // FMOV Dd, Xn (Move general-purpose register to SIMD/FP register)
    // Opcode: 0x9E670000 = 2657550336
    return 2657550336 + (rn * 32) + rd
}

fn insn_fmov_s_w(sd, rn) {
    // FMOV Sd, Wn (Move 32-bit general-purpose register to SIMD/FP register)
    // Verified via clang:
    //   fmov s0, w0 => 0x1E270000 = 505872384
    return 505872384 + (rn * 32) + sd
}

fn insn_fmov_w_s(rd, sn) {
    // FMOV Wd, Sn (Move SIMD/FP register to 32-bit general-purpose register)
    // Verified via clang:
    //   fmov w0, s0 => 0x1E260000 = 505806848
    return 505806848 + (sn * 32) + rd
}

fn insn_umov_x_d(rd, rn) {
    // UMOV Xd, Vn.D[0] (Move SIMD/FP register to general-purpose register)
    // Opcode: 0x4E083C00 = 1309162496
    return 1309162496 + (rn * 32) + rd
}

fn insn_umov_x_d1(rd, rn) {
    // UMOV Xd, Vn.D[1]
    // Verified via clang:
    //   umov x1, v4.d[1] => 0x4E183C81
    // Base: 0x4E183C00
    return 1310211072 + (rn * 32) + rd
}

fn insn_fadd(rd, rn, rm) {
    // FADD Dd, Dn, Dm: 0x1E602800 = 509618176
    return 509618176 + (rm * 65536) + (rn * 32) + rd
}

fn insn_fcmp(rn, rm) {
    // FCMP Dn, Dm: 0x1E602000 = 509616128
    return 509616128 + (rm * 65536) + (rn * 32)
}

fn insn_fsub(rd, rn, rm) {
    // FSUB Dd, Dn, Dm: 0x1E603800 = 509622272
    return 509622272 + (rm * 65536) + (rn * 32) + rd
}

fn insn_fmul(rd, rn, rm) {
    // FMUL Dd, Dn, Dm: 0x1E600800 = 509609984
    return 509609984 + (rm * 65536) + (rn * 32) + rd
}

fn insn_fdiv(rd, rn, rm) {
    // FDIV Dd, Dn, Dm: 0x1E601800 = 509614080
    return 509614080 + (rm * 65536) + (rn * 32) + rd
}

fn insn_scvtf(rd, rn) {
    // SCVTF Dd, Xn: 0x9E620000
    return 2657222656 + (rn * 32) + rd
}

fn insn_fcvtzs(rd, rn) {
    // FCVTZS Xd, Dn: 0x9E780000
    return 2658664448 + (rn * 32) + rd
}

fn insn_fcvt_s_from_d(sd, dn) {
    // FCVT Sd, Dn (double -> single)
    // Verified by assembling:
    //   fcvt s0, d0  => 0x1E624000
    //   fcvt s3, d5  => 0x1E6240A3  (base + (dn<<5) + sd)
    return 509755392 + (dn * 32) + sd // 0x1E624000
}

fn insn_fcvt_d_from_s(dd, sn) {
    // FCVT Dd, Sn (single -> double)
    // Verified by assembling:
    //   fcvt d0, s0  => 0x1E22C000
    //   fcvt d7, s9  => 0x1E22C127  (base + (sn<<5) + dd)
    return 505593856 + (sn * 32) + dd // 0x1E22C000
}

fn insn_mul_4s(vd, vn, vm) {
    return 1319148544 + (vm * 65536) + (vn * 32) + vd
}

fn insn_add_4s(vd, vn, vm) {
    // ADD Vd.4S, Vn.4S, Vm.4S
    // Verified via clang:
    //   add v0.4s, v0.4s, v1.4s => 0x4EA18400
    // Base: 0x4EA08400
    return 1319142400 + (vm * 65536) + (vn * 32) + vd
}

fn insn_fadd_4s(vd, vn, vm) {
    // FADD Vd.4S, Vn.4S, Vm.4S
    // Verified via clang:
    //   fadd v0.4s, v0.4s, v1.4s => 0x4E21D400
    // Base: 0x4E20D400
    return 1310774272 + (vm * 65536) + (vn * 32) + vd
}

fn insn_fadd_2d(vd, vn, vm) {
    // FADD Vd.2D, Vn.2D, Vm.2D
    // Verified via clang:
    //   fadd v3.2d, v1.2d, v2.2d => 0x4E62D423
    // Base: 0x4E60D400
    return 1314968576 + (vm * 65536) + (vn * 32) + vd
}

fn insn_fmul_4s(vd, vn, vm) {
    // FMUL Vd.4S, Vn.4S, Vm.4S
    // Verified via clang:
    //   fmul v0.4s, v0.4s, v1.4s => 0x6E21DC00
    // Base: 0x6E20DC00
    return 1847647232 + (vm * 65536) + (vn * 32) + vd
}

fn insn_fmul_2d(vd, vn, vm) {
    // FMUL Vd.2D, Vn.2D, Vm.2D
    // Verified via clang:
    //   fmul v4.2d, v1.2d, v2.2d => 0x6E62DC24
    // Base: 0x6E60DC00
    return 1851841536 + (vm * 65536) + (vn * 32) + vd
}

fn insn_fadd_s(sd, sn, sm) {
    // FADD Sd, Sn, Sm
    // Verified via clang:
    //   fadd s0, s0, s1 => 0x1E212800
    // Base: 0x1E202800
    return 505423872 + (sm * 65536) + (sn * 32) + sd
}

fn insn_fmul_s(sd, sn, sm) {
    // FMUL Sd, Sn, Sm
    // Verified via clang:
    //   fmul s0, s0, s1 => 0x1E210800
    // Base: 0x1E200800
    return 505415680 + (sm * 65536) + (sn * 32) + sd
}

fn insn_fcvtl_2d_from_2s(vd, vn) {
    // FCVTL Vd.2D, Vn.2S (widen float32 -> float64, low lanes)
    // Verified via clang:
    //   fcvtl v2.2d, v0.2s => 0x0E617802
    // Base: 0x0E617800
    return 241268736 + (vn * 32) + vd
}

fn insn_fcvtl2_2d_from_4s(vd, vn) {
    // FCVTL2 Vd.2D, Vn.4S (widen float32 -> float64, high lanes)
    // Verified via clang:
    //   fcvtl2 v3.2d, v0.4s => 0x4E617803
    // Base: 0x4E617800
    return 1315010560 + (vn * 32) + vd
}

fn insn_smull_2d(vd, vn, vm) {
    // SMULL Vd.2D, Vn.2S, Vm.2S
    // Verified via clang:
    //   smull v2.2d, v0.2s, v1.2s => 0x0EA1C002
    // Base: 0x0EA0C000
    return 245415936 + (vm * 65536) + (vn * 32) + vd
}

fn insn_smull2_2d(vd, vn, vm) {
    // SMULL2 Vd.2D, Vn.4S, Vm.4S
    // Verified via clang:
    //   smull2 v3.2d, v0.4s, v1.4s => 0x4EA1C003
    // Base: 0x4EA0C000
    return 1319157760 + (vm * 65536) + (vn * 32) + vd
}

fn insn_addp_2d(vd, vn, vm) {
    // ADDP Vd.2D, Vn.2D, Vm.2D (pairwise add)
    // Verified via clang:
    //   addp v5.2d, v4.2d, v4.2d => 0x4EE4BC85
    // Base: 0x4EE0BC00
    return 1323351040 + (vm * 65536) + (vn * 32) + vd
}

fn insn_ldr_q(vt, rn) {
    // LDR Qt, [Xn] (unsigned offset imm=0)
    // Verified via clang:
    //   ldr q0, [x0] => 0x3DC00000
    //   ldr q1, [x1] => 0x3DC00021
    // Base: 0x3DC00000
    return 1035993088 + (rn * 32) + vt
}

fn insn_str_q(vt, rn) {
    // STR Qt, [Xn] (unsigned offset imm=0)
    // Verified via clang:
    //   str q0, [x2] => 0x3D800040
    // Base: 0x3D800000
    return 1031798784 + (rn * 32) + vt
}

fn insn_str_q_off(vt, rn, offset) {
    // STR Qt, [Xn, #imm12<<4] (unsigned offset encoding, scaled by 16)
    // Verified via clang:
    //   str q2, [sp]      => 0x3D8003E2
    //   str q3, [sp,#16]  => 0x3D8007E3
    return 1031798784 + ((offset / 16) * 1024) + (rn * 32) + vt
}

fn insn_ldr_ptr(rd, rn) {
    // LDR Xd, [Xn] with imm = 0 (unsigned offset encoding)
    // Verified via clang:
    //   ldr x0, [x1] => 0xF9400020
    return 4181721088 + (rn * 32) + rd
}

fn insn_str_ptr(rd, rn) {
    // STR Xt, [Xn] with imm = 0 (unsigned offset encoding)
    // Verified via clang:
    //   str x2, [x3] => 0xF9000062
    return 4177526784 + (rn * 32) + rd
}

fn insn_ldr_w(rt, rn, offset) {
    // LDR Wt, [Xn, #imm12<<2] (unsigned offset encoding, scaled by 4)
    // Verified via clang:
    //   ldr w0, [x2]      => 0xB9400040
    //   ldr w3, [x4,#12]  => 0xB9400C83
    // Base: 0xB9400000
    return 3107979264 + ((offset / 4) * 1024) + (rn * 32) + rt
}

fn insn_str_w(rt, rn, offset) {
    // STR Wt, [Xn, #imm12<<2] (unsigned offset encoding, scaled by 4)
    // Verified via clang:
    //   str w0, [x2]      => 0xB9000040
    //   str w3, [x4,#12]  => 0xB9000C83
    // Base: 0xB9000000
    return 3103784960 + ((offset / 4) * 1024) + (rn * 32) + rt
}

fn insn_ldrsw(rt, rn, offset) {
    // LDRSW Xt, [Xn, #imm12<<2] (signed load 32-bit, sign-extend to 64-bit)
    // Verified via clang:
    //   ldrsw x2, [x3]      => 0xB9800062
    //   ldrsw x4, [x5, #12] => 0xB9800CA4
    // Base: 0xB9800000
    return 3112173568 + ((offset / 4) * 1024) + (rn * 32) + rt
}

fn insn_strb(rt, rn) {
    // STRB Wt, [Xn] with imm = 0 (unsigned offset encoding)
    // Verified via clang:
    //   strb w1, [x2] => 0x39000041
    return 956301312 + (rn * 32) + rt
}

fn insn_add_imm(rd, rn, imm) {
    return 2432696320 + (imm * 1024) + (rn * 32) + rd
}

fn insn_ldadd(rs, rt, rn) {
    // LDADD Xs, Xt, [Xn]
    // Verified via clang:
    //   ldadd x8, x9, [x10] => 0xF8280149
    return 4162846720 + (rs * 65536) + (rn * 32) + rt
}

fn insn_cas(rs, rt, rn) {
    // CAS Xs, Xt, [Xn]
    // Verified via clang:
    //   cas x11, x12, [x13] => 0xC8AB7DAC
    // Base: 0xC8A07C00
    return 3365960704 + (rs * 65536) + (rn * 32) + rt
}

fn insn_ldaxr(rt, rn) {
    // LDAXR Xt, [Xn]
    // Encoding (arm64): 0xC85FFC00 | (rn << 5) | rt
    // Verified via clang:
    //   ldaxr x3, [x4] => 0xC85FFC83
    return 3361733632 + (rn * 32) + rt
}

fn insn_stlxr(rs, rt, rn) {
    // STLXR Ws, Xt, [Xn]
    // Encoding (arm64): 0xC800FC00 | (rs << 16) | (rn << 5) | rt
    // Note: status register is a W-reg (lower 32 bits of Xrs).
    // Verified via clang:
    //   stlxr w5, x6, [x7] => 0xC805FCE6
    return 3355507712 + (rs * 65536) + (rn * 32) + rt
}

fn insn_clrex() {
    // CLREX
    // Verified via clang:
    //   clrex => 0xD5033F5F
    return 3573759839
}

fn insn_ldrb(rt, rn) {
    // LDRB Wt, [Xn] with imm = 0 (unsigned offset encoding)
    // Verified via clang:
    //   ldrb w4, [x5] => 0x394000A4
    return 960495616 + (rn * 32) + rt
}

fn insn_mul(rd, rn, rm) {
    return 2600467456 + (rm * 65536) + (32 * 1024) + (rn * 32) + rd
}

fn insn_udiv(rd, rn, rm) {
    // UDIV Xrd, Xrn, Xrm
    return 2596276224 + (rm * 65536) + (rn * 32) + rd // base 0x9AC00800
}

fn insn_sdiv(rd, rn, rm) {
    // SDIV Xrd, Xrn, Xrm
    // Verified via clang + otool:
    //   sdiv x0, x1, x0 => 0x9AC00C20
    // Base: 0x9AC00C00
    return 2596277248 + (rm * 65536) + (rn * 32) + rd
}

fn insn_movk(reg, imm16, shift_idx) {
    return 4068474880 + (shift_idx * 2097152) + (imm16 * 32) + reg
}

fn insn_adr(reg, imm) {
    if imm < 0 {
        imm = imm + 2097152 // 2^21
    }
    var lo = imm & 3
    var hi = imm / 4
    return 268435456 + (lo * 536870912) + (hi * 32) + reg
}

fn insn_adrp(reg, imm_pages) {
    // ADRP Xd, <label>@PAGE
    //
    // Encodes a signed 21-bit PC-relative immediate in units of 4KB pages.
    // The effective address is: (PC_page + imm_pages*4096).
    //
    // Verified via clang (Mach-O @PAGE / @PAGEOFF pattern):
    //   adrp x16, _sym@PAGE => 0x90000010   (when page delta == 0)
    //
    // Encoding (A64):
    // - base opcode: 0x90000000
    // - immlo: bits[30:29] = imm[1:0]
    // - immhi: bits[23:5]  = imm[20:2]
    // - rd:    bits[4:0]
    var imm = imm_pages
    if imm < 0 {
        imm = imm + 2097152 // 2^21 pages
    }
    var immlo = imm & 3
    var immhi = imm / 4
    return 2415919104 + (immlo * 536870912) + (immhi * 32) + reg // 0x90000000
}

fn insn_br(rn) {
    // BR Xn
    // Encoding: 0xD61F0000 | (rn << 5)
    return 3592355840 + (rn * 32)
}

