fn _opt_collect_list_pushes_stmt(stmt, out) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            _opt_collect_list_pushes_stmt(ss[i], out)
            i = i + 1
        }
        return nil
    }
    if t == "While" {
        _opt_collect_list_pushes_expr(stmt["cond"], out)
        _opt_collect_list_pushes_stmt(stmt["body"], out)
        return nil
    }
    if t == "For" {
        _opt_collect_list_pushes_stmt(stmt["init"], out)
        _opt_collect_list_pushes_expr(stmt["cond"], out)
        _opt_collect_list_pushes_expr(stmt["post"], out)
        _opt_collect_list_pushes_stmt(stmt["body"], out)
        return nil
    }
    if t == "ExprStmt" { return _opt_collect_list_pushes_expr(stmt["expr"], out) }
    if t == "Assign" { return _opt_collect_list_pushes_expr(stmt["value"], out) }
    if t == "Var" { return _opt_collect_list_pushes_expr(stmt["value"], out) }
    if t == "Set" {
        _opt_collect_list_pushes_expr(stmt["left"], out)
        _opt_collect_list_pushes_expr(stmt["value"], out)
        return nil
    }
    if t == "Return" { return _opt_collect_list_pushes_expr(stmt["value"], out) }
    if t == "Function" { return nil } // avoid nested functions
    return nil
}


fn _opt_collect_list_int_pushes_stmt(stmt, out) {
    if stmt == nil { return nil }
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            _opt_collect_list_int_pushes_stmt(ss[i], out)
            i = i + 1
        }
        return nil
    }
    if t == "While" {
        _opt_collect_list_int_pushes_expr(stmt["cond"], out)
        _opt_collect_list_int_pushes_stmt(stmt["body"], out)
        return nil
    }
    if t == "For" {
        _opt_collect_list_int_pushes_stmt(stmt["init"], out)
        _opt_collect_list_int_pushes_expr(stmt["cond"], out)
        _opt_collect_list_int_pushes_expr(stmt["post"], out)
        _opt_collect_list_int_pushes_stmt(stmt["body"], out)
        return nil
    }
    if t == "ExprStmt" { return _opt_collect_list_int_pushes_expr(stmt["expr"], out) }
    if t == "Assign" { return _opt_collect_list_int_pushes_expr(stmt["value"], out) }
    if t == "Var" { return _opt_collect_list_int_pushes_expr(stmt["value"], out) }
    if t == "Set" {
        _opt_collect_list_int_pushes_expr(stmt["left"], out)
        _opt_collect_list_int_pushes_expr(stmt["value"], out)
        return nil
    }
    if t == "Return" { return _opt_collect_list_int_pushes_expr(stmt["value"], out) }
    if t == "Function" { return nil } // avoid nested functions
    return nil
}


fn _opt_rewrite_list_pushes_expr(expr, list_names) {
    if expr == nil || list_names == nil { return false }
    var changed = false
    var t = expr["type"]
    if t == "Call" {
        var fnn = expr["fn"]
        var nm = nil
        if fnn != nil && fnn["type"] == "Identifier" { nm = fnn["value"] }
        var args = expr["args"]
        if nm != nil && (nm == "oren_list_push" || nm == "STD_list_push") {
            if args != nil && oren_list_len(args) >= 2 {
                var recv = args[0]
                if recv != nil && recv["type"] == "Identifier" {
                    var rnm = recv["value"]
                    if rnm != nil && list_names[rnm] == true {
                        fnn["value"] = "oren_list_push_unchecked"
                        changed = true
                    }
                }
            }
        }
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                if _opt_rewrite_list_pushes_expr(args[i], list_names) { changed = true }
                i = i + 1
            }
        }
        if expr["spread"] != nil {
            if _opt_rewrite_list_pushes_expr(expr["spread"], list_names) { changed = true }
        }
        return changed
    }
    if t == "Prefix" { return _opt_rewrite_list_pushes_expr(expr["right"], list_names) }
    if t == "Infix" {
        if _opt_rewrite_list_pushes_expr(expr["left"], list_names) { changed = true }
        if _opt_rewrite_list_pushes_expr(expr["right"], list_names) { changed = true }
        return changed
    }
    if t == "If" {
        if _opt_rewrite_list_pushes_expr(expr["cond"], list_names) { changed = true }
        if _opt_rewrite_list_pushes_stmt(expr["consq"], list_names) { changed = true }
        if expr["alt"] != nil && _opt_rewrite_list_pushes_stmt(expr["alt"], list_names) { changed = true }
        return changed
    }
    if t == "Array" {
        var xs = expr["elements"]
        var i2 = 0
        while i2 < oren_list_len(xs) {
            if _opt_rewrite_list_pushes_expr(xs[i2], list_names) { changed = true }
            i2 = i2 + 1
        }
        return changed
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i3 = 0
        while i3 < oren_list_len(ps) {
            if _opt_rewrite_list_pushes_expr(ps[i3]["key"], list_names) { changed = true }
            if _opt_rewrite_list_pushes_expr(ps[i3]["value"], list_names) { changed = true }
            i3 = i3 + 1
        }
        return changed
    }
    if t == "Index" {
        if _opt_rewrite_list_pushes_expr(expr["left"], list_names) { changed = true }
        if _opt_rewrite_list_pushes_expr(expr["index"], list_names) { changed = true }
        return changed
    }
    if t == "Member" { return _opt_rewrite_list_pushes_expr(expr["left"], list_names) }
    if t == "Function" { return false }
    return false
}


fn _opt_rewrite_list_pushes_stmt(stmt, list_names) {
    if stmt == nil || list_names == nil { return false }
    var changed = false
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            if _opt_rewrite_list_pushes_stmt(ss[i], list_names) { changed = true }
            i = i + 1
        }
        return changed
    }
    if t == "While" {
        if _opt_rewrite_list_pushes_expr(stmt["cond"], list_names) { changed = true }
        if _opt_rewrite_list_pushes_stmt(stmt["body"], list_names) { changed = true }
        return changed
    }
    if t == "For" {
        if _opt_rewrite_list_pushes_stmt(stmt["init"], list_names) { changed = true }
        if _opt_rewrite_list_pushes_expr(stmt["cond"], list_names) { changed = true }
        if _opt_rewrite_list_pushes_expr(stmt["post"], list_names) { changed = true }
        if _opt_rewrite_list_pushes_stmt(stmt["body"], list_names) { changed = true }
        return changed
    }
    if t == "ExprStmt" { return _opt_rewrite_list_pushes_expr(stmt["expr"], list_names) }
    if t == "Assign" { return _opt_rewrite_list_pushes_expr(stmt["value"], list_names) }
    if t == "Var" { return _opt_rewrite_list_pushes_expr(stmt["value"], list_names) }
    if t == "Set" {
        if _opt_rewrite_list_pushes_expr(stmt["left"], list_names) { changed = true }
        if _opt_rewrite_list_pushes_expr(stmt["value"], list_names) { changed = true }
        return changed
    }
    if t == "Return" { return _opt_rewrite_list_pushes_expr(stmt["value"], list_names) }
    if t == "If" {
        if _opt_rewrite_list_pushes_expr(stmt["cond"], list_names) { changed = true }
        if _opt_rewrite_list_pushes_stmt(stmt["consq"], list_names) { changed = true }
        if stmt["alt"] != nil && _opt_rewrite_list_pushes_stmt(stmt["alt"], list_names) { changed = true }
        return changed
    }
    if t == "Function" { return false }
    return false
}


fn _opt_rewrite_list_int_pushes_expr(expr, list_names, safe_ints) {
    if expr == nil || list_names == nil || safe_ints == nil { return false }
    var changed = false
    var t = expr["type"]
    if t == "Call" {
        var fnn = expr["fn"]
        var nm = nil
        if fnn != nil && fnn["type"] == "Identifier" { nm = fnn["value"] }
        var args = expr["args"]
        if nm != nil && (nm == "oren_list_int_push" || nm == "STD_list_int_push") {
            if args != nil && oren_list_len(args) >= 2 {
                var recv = args[0]
                var val = args[1]
                if recv != nil && recv["type"] == "Identifier" {
                    var rnm = recv["value"]
                    if rnm != nil && list_names[rnm] == true {
                        if _opt_backend_allows_list_int_unchecked() == true && _opt_is_safe_int_expr(val, safe_ints) {
                            fnn["value"] = "oren_list_int_push_unchecked"
                            changed = true
                        }
                    }
                }
            }
        }
        if args != nil {
            var i = 0
            while i < oren_list_len(args) {
                if _opt_rewrite_list_int_pushes_expr(args[i], list_names, safe_ints) { changed = true }
                i = i + 1
            }
        }
        if expr["spread"] != nil {
            if _opt_rewrite_list_int_pushes_expr(expr["spread"], list_names, safe_ints) { changed = true }
        }
        return changed
    }
    if t == "Prefix" { return _opt_rewrite_list_int_pushes_expr(expr["right"], list_names, safe_ints) }
    if t == "Infix" {
        if _opt_rewrite_list_int_pushes_expr(expr["left"], list_names, safe_ints) { changed = true }
        if _opt_rewrite_list_int_pushes_expr(expr["right"], list_names, safe_ints) { changed = true }
        return changed
    }
    if t == "If" {
        if _opt_rewrite_list_int_pushes_expr(expr["cond"], list_names, safe_ints) { changed = true }
        if _opt_rewrite_list_int_pushes_stmt(expr["consq"], list_names, safe_ints) { changed = true }
        if expr["alt"] != nil && _opt_rewrite_list_int_pushes_stmt(expr["alt"], list_names, safe_ints) { changed = true }
        return changed
    }
    if t == "Array" {
        var xs = expr["elements"]
        var i2 = 0
        while i2 < oren_list_len(xs) {
            if _opt_rewrite_list_int_pushes_expr(xs[i2], list_names, safe_ints) { changed = true }
            i2 = i2 + 1
        }
        return changed
    }
    if t == "Hash" {
        var ps = expr["pairs"]
        var i3 = 0
        while i3 < oren_list_len(ps) {
            if _opt_rewrite_list_int_pushes_expr(ps[i3]["key"], list_names, safe_ints) { changed = true }
            if _opt_rewrite_list_int_pushes_expr(ps[i3]["value"], list_names, safe_ints) { changed = true }
            i3 = i3 + 1
        }
        return changed
    }
    if t == "Index" {
        if _opt_rewrite_list_int_pushes_expr(expr["left"], list_names, safe_ints) { changed = true }
        if _opt_rewrite_list_int_pushes_expr(expr["index"], list_names, safe_ints) { changed = true }
        return changed
    }
    if t == "Member" { return _opt_rewrite_list_int_pushes_expr(expr["left"], list_names, safe_ints) }
    if t == "Function" { return false }
    return false
}


fn _opt_rewrite_list_int_pushes_stmt(stmt, list_names, safe_ints) {
    if stmt == nil || list_names == nil || safe_ints == nil { return false }
    var changed = false
    var t = stmt["type"]
    if t == "Block" {
        var ss = stmt["stmts"]
        var i = 0
        while i < oren_list_len(ss) {
            if _opt_rewrite_list_int_pushes_stmt(ss[i], list_names, safe_ints) { changed = true }
            i = i + 1
        }
        return changed
    }
    if t == "While" {
        if _opt_rewrite_list_int_pushes_expr(stmt["cond"], list_names, safe_ints) { changed = true }
        if _opt_rewrite_list_int_pushes_stmt(stmt["body"], list_names, safe_ints) { changed = true }
        return changed
    }
    if t == "For" {
        if _opt_rewrite_list_int_pushes_stmt(stmt["init"], list_names, safe_ints) { changed = true }
        if _opt_rewrite_list_int_pushes_expr(stmt["cond"], list_names, safe_ints) { changed = true }
        if _opt_rewrite_list_int_pushes_expr(stmt["post"], list_names, safe_ints) { changed = true }
        if _opt_rewrite_list_int_pushes_stmt(stmt["body"], list_names, safe_ints) { changed = true }
        return changed
    }
    if t == "ExprStmt" { return _opt_rewrite_list_int_pushes_expr(stmt["expr"], list_names, safe_ints) }
    if t == "Assign" { return _opt_rewrite_list_int_pushes_expr(stmt["value"], list_names, safe_ints) }
    if t == "Var" { return _opt_rewrite_list_int_pushes_expr(stmt["value"], list_names, safe_ints) }
    if t == "Set" {
        if _opt_rewrite_list_int_pushes_expr(stmt["left"], list_names, safe_ints) { changed = true }
        if _opt_rewrite_list_int_pushes_expr(stmt["value"], list_names, safe_ints) { changed = true }
        return changed
    }
    if t == "Return" { return _opt_rewrite_list_int_pushes_expr(stmt["value"], list_names, safe_ints) }
    if t == "If" {
        if _opt_rewrite_list_int_pushes_expr(stmt["cond"], list_names, safe_ints) { changed = true }
        if _opt_rewrite_list_int_pushes_stmt(stmt["consq"], list_names, safe_ints) { changed = true }
        if stmt["alt"] != nil && _opt_rewrite_list_int_pushes_stmt(stmt["alt"], list_names, safe_ints) { changed = true }
        return changed
    }
    if t == "Function" { return false }
    return false
}


fn _opt_map_clone(m) {
    var out = {}
    if m != nil {
        for k in m {
            out[k] = m[k]
        }
    }
    return out
}

fn _opt_list_reserve_expr_hint(expr) {
    if expr == nil { return "nil" }
    var t = expr["type"]
    if t == "Identifier" { return expr["value"] }
    if t == "Integer" { return expr["value"] }
    return t
}


fn _opt_insert_list_reserve_in_block(block, last_list_lit, last_list_lit_len, last_list_lit_intsafe, last_list_int_new, last_int_safe) {
    if block == nil || block["type"] != "Block" { return nil }
    var ss = block["stmts"]
    if ss == nil { return nil }
    var trace = oren_env("OREN_TRACE_LIST_RESERVE") != nil

    if last_list_lit == nil { last_list_lit = {} }
    if last_list_lit_len == nil { last_list_lit_len = {} }
    if last_list_lit_intsafe == nil { last_list_lit_intsafe = {} }
    if last_list_int_new == nil { last_list_int_new = {} }
    if last_int_safe == nil { last_int_safe = {} }
    var out = []
    var i = 0
    while i < oren_list_len(ss) {
        var st = ss[i]
        var is_top_assign = st != nil && (st["type"] == "Var" || st["type"] == "Assign")
        if is_top_assign {
            var nm = opthelp.is_ident(st["name"])
            if nm != nil {
                var v = st["value"]
                var list_lit = false
                var list_int_new = false
                var lit_len = -1
                var lit_int_safe = false
                var alias_name = nil
                if v != nil && v["type"] == "Identifier" { alias_name = v["value"] }
                if v != nil && v["type"] == "Call" {
                    var fnv = v["fn"]
                    if fnv != nil && fnv["type"] == "Identifier" {
                        var fn_name = fnv["value"]
                        if fn_name == "oren_new_list_int" || fn_name == "oren_arena_new_list_int" ||
                           fn_name == "oren_arena_new_list_int_auto" {
                            list_int_new = true
                        }
                        if fn_name == "oren_new_list" || fn_name == "oren_list_new_cap" ||
                           fn_name == "oren_arena_new_list" || fn_name == "oren_arena_new_list_auto" {
                            list_lit = true
                            lit_len = 0
                            lit_int_safe = false
                        }
                    }
                }
                if v != nil && v["type"] == "Array" {
                    list_lit = true
                    var els = v["elements"]
                    if els != nil { lit_len = oren_list_len(els) }
                    lit_int_safe = true
                    if els != nil {
                        var ei = 0
                        while ei < oren_list_len(els) {
                            if _opt_is_safe_int_expr(els[ei], last_int_safe) != true {
                                lit_int_safe = false
                                break
                            }
                            ei = ei + 1
                        }
                    }
                } else if alias_name != nil {
                    if last_list_lit[alias_name] == true { list_lit = true }
                    var alias_len = last_list_lit_len[alias_name]
                    if alias_len != nil { lit_len = alias_len }
                    if last_list_lit_intsafe[alias_name] == true { lit_int_safe = true }
                    if last_list_int_new[alias_name] == true { list_int_new = true }
                }
                last_list_lit[nm] = list_lit
                last_list_lit_len[nm] = lit_len
                last_list_lit_intsafe[nm] = lit_int_safe
                last_list_int_new[nm] = list_int_new
                if _opt_is_safe_int_expr(v, last_int_safe) { last_int_safe[nm] = true }
                else { last_int_safe[nm] = false }
            }
        }

        if st != nil && st["type"] == "While" {
            var cond = st["cond"]
            var n_expr = nil
            var n_ok = false
            var idx_name = nil
            if cond != nil && cond["type"] == "Infix" && cond["op"] == "<" {
                var left_name = opthelp.is_ident(cond["left"])
                var right = cond["right"]
                if left_name != nil && right != nil {
                    if _opt_is_safe_int_expr(right, last_int_safe) {
                        n_expr = right
                        n_ok = true
                        idx_name = left_name
                    }
                }
            }

            if n_ok {
                var pushes = {}
                var pushes_int = {}
                _opt_collect_list_pushes_stmt(st["body"], pushes)
                _opt_collect_list_int_pushes_stmt(st["body"], pushes_int)
                var assigned = {}
                opthelp.collect_assigned_names_stmt(assigned, st["body"])
                var safe_ints = _opt_map_clone(last_int_safe)
                if idx_name != nil { safe_ints[idx_name] = true }
                if pushes != nil {
                    for list_name in pushes {
                        if last_list_lit[list_name] == true && pushes_int[list_name] != true {
                            var reserve_expr = n_expr
