// --- UDP (syscall-first) ---
//
// Goal: provide a minimal datagram substrate for stdlib layering:
// - bind local loopback (port may be 0 for ephemeral)
// - sendto / recvfrom with timeout (no hangs)
// - introspect bound port via getsockname

@cap.requires(domain="NET")
fn oren_udp_bind_local(port) {
    native_capsule_require(CAP_NET, "NET")
    port = native_canon_i32_arg(port)
    var init_rc = native_net_init_once()
    if init_rc < 0 { return init_rc }
    // Bind to 127.0.0.1:<port> for loopback-only tests and simple local services.
    var fd = sys_socket(OREN_AF_INET, OREN_SOCK_DGRAM, 0)
    if fd < 0 { return fd }

    // Allow quick reuse during tests.
    var one = malloc(8)
    if one == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(one, 8, 0)
    ptr_set(one, 1)
    var sroc = sys_setsockopt(fd, OREN_SOL_SOCKET, OREN_SO_REUSEADDR, one, 4)
    free(one)
    if sroc < 0 {
        sys_close(fd)
        return sroc
    }

    // Non-blocking to avoid hanging on unexpected kernel behavior; we always wait with kqueue/epoll.
    var nb = oren_tcp_set_nonblock(fd)
    if nb < 0 {
        sys_close(fd)
        return nb
    }

    var sa = oren_tcp_sockaddr_in(0, port) // 127.0.0.1
    if sa == 0 {
        sys_close(fd)
        return 0 - 22 // EINVAL
    }
    var brc = sys_bind(fd, sa, 16)
    free(sa)
    if brc < 0 {
        sys_close(fd)
        return brc
    }
    return fd
}

@cap.requires(domain="NET")
fn oren_udp_sockname_port(fd) {
    native_capsule_require(CAP_NET, "NET")
    var sa = malloc(16)
    if sa == 0 { return 0 - 12 } // ENOMEM
    oren_track_alloc(sa, 16, 0)
    var lenp = malloc(8)
    if lenp == 0 { free(sa); return 0 - 12 } // ENOMEM
    oren_track_alloc(lenp, 8, 0)
    ptr_set(lenp, 16)

    var rc = sys_getsockname(fd, sa, lenp)
    if rc < 0 {
        free(sa)
        free(lenp)
        return rc
    }

    // Port is network-order u16 at bytes 2..3 for both Darwin and Linux sockaddr_in.
    var hi = ptr_get_byte(sa + 2)
    var lo = ptr_get_byte(sa + 3)
    var port = (hi << 8) | lo
    free(sa)
    free(lenp)
    return port
}

@cap.requires(domain="NET")
fn oren_udp_sendto(fd, ip, port, buf, len, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    timeout_ms = native_canon_timeout_ms_arg(timeout_ms)
    len = native_canon_i32_arg(len)
    port = native_canon_i32_arg(port)
    if len <= 0 { return 0 }

    var sa = oren_tcp_sockaddr_in(ip, port)
    if sa == 0 { return 0 - 22 } // EINVAL

    var deadline_ns = 0
    if timeout_ms > 0 {
        var t0 = oren_time_unix_ns()
        if t0 != 0 {
            deadline_ns = t0 + timeout_ms * 1000000
        }
    }
    var spins = 0

    while 1 {
        var w0 = sys_sendto(fd, buf, len, 0, sa, 16)
        // EAGAIN/EWOULDBLOCK:
        // - macOS: 35
        // - Linux: 11
        if w0 != 0 - 35 && w0 != 0 - 11 {
            free(sa)
            return w0
        }

        var rem_ms = timeout_ms
        if deadline_ns != 0 {
            var now = oren_time_unix_ns()
            if now != 0 {
                var rem_ns = deadline_ns - now
                if rem_ns <= 0 { free(sa); return 0 - 60 } // ETIMEDOUT
                rem_ms = rem_ns / 1000000
                if rem_ms < 0 { rem_ms = 0 }
            }
        }

        var n = oren_fd_wait_writable(fd, rem_ms)
        if n == 0 {
            // Same robustness policy as TCP: retry once before trusting a timeout.
            var w1 = sys_sendto(fd, buf, len, 0, sa, 16)
            if w1 != 0 - 35 && w1 != 0 - 11 {
                free(sa)
                return w1
            }
            if deadline_ns != 0 {
                var now2 = oren_time_unix_ns()
                if now2 != 0 && now2 < deadline_ns { continue }
            }
            if timeout_ms > 0 {
                spins = spins + 1
                if spins < 64 { continue }
            }
            free(sa)
            return 0 - 60 // ETIMEDOUT
        }
        if n < 0 { free(sa); return n }
        // Wait satisfied; loop back and attempt send again.
    }
}

@cap.requires(domain="NET")
fn oren_udp_recvfrom_into(fd, buf, len, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    timeout_ms = native_canon_timeout_ms_arg(timeout_ms)
    len = native_canon_i32_arg(len)
    if len <= 0 { return 0 }

    var deadline_ns = 0
    if timeout_ms > 0 {
        var t0 = oren_time_unix_ns()
        if t0 != 0 {
            deadline_ns = t0 + timeout_ms * 1000000
        }
    }
    var spins = 0

    while 1 {
        var r0 = sys_recvfrom(fd, buf, len, 0, 0, 0)
        if r0 != 0 - 35 && r0 != 0 - 11 { return r0 }

        var rem_ms = timeout_ms
        if deadline_ns != 0 {
            var now = oren_time_unix_ns()
            if now != 0 {
                var rem_ns = deadline_ns - now
                if rem_ns <= 0 { return 0 - 60 } // ETIMEDOUT
                rem_ms = rem_ns / 1000000
                if rem_ms < 0 { rem_ms = 0 }
            }
        }

        var n = oren_fd_wait_readable(fd, rem_ms)
        if n == 0 {
            var r1 = sys_recvfrom(fd, buf, len, 0, 0, 0)
            if r1 != 0 - 35 && r1 != 0 - 11 { return r1 }
            if deadline_ns != 0 {
                var now2 = oren_time_unix_ns()
                if now2 != 0 && now2 < deadline_ns { continue }
            }
            if timeout_ms > 0 {
                spins = spins + 1
                if spins < 64 { continue }
            }
            return 0 - 60 // ETIMEDOUT
        }
        if n < 0 { return n }
        // Wait satisfied; loop back and attempt recv again.
    }
}

@cap.requires(domain="NET")
fn oren_udp_recvfrom_into_with_addr(fd, buf, len, timeout_ms, sa_out, sa_lenp) {
    // Like `oren_udp_recvfrom_into`, but also captures the remote sockaddr.
    //
    // - `sa_out` must point to at least 16 bytes (sockaddr_in)
    // - `sa_lenp` must point to at least 4 bytes (socklen_t/int); it will be set to 16 before recv.
    //
    // Return:
    // - bytes read (>=0) on success
    // - negative errno on failure
    native_capsule_require(CAP_NET, "NET")
    timeout_ms = native_canon_timeout_ms_arg(timeout_ms)
    len = native_canon_i32_arg(len)
    if len <= 0 { return 0 }
    if sa_out == 0 { return 0 - 22 } // EINVAL
    if sa_lenp == 0 { return 0 - 22 } // EINVAL

    var deadline_ns = 0
    if timeout_ms > 0 {
        var t0 = oren_time_unix_ns()
        if t0 != 0 {
            deadline_ns = t0 + timeout_ms * 1000000
        }
    }
    var spins = 0

    // Always treat as sockaddr_in for the syscall-first Tier‑1 surface.
    // Caller may reuse `sa_out`/`sa_lenp` across calls.
    ptr_set(sa_lenp, 16)

    while 1 {
        ptr_set(sa_lenp, 16)
        var r0 = sys_recvfrom(fd, buf, len, 0, sa_out, sa_lenp)
        if r0 != 0 - 35 && r0 != 0 - 11 { return r0 }

        var rem_ms = timeout_ms
        if deadline_ns != 0 {
            var now = oren_time_unix_ns()
            if now != 0 {
                var rem_ns = deadline_ns - now
                if rem_ns <= 0 { return 0 - 60 } // ETIMEDOUT
                rem_ms = rem_ns / 1000000
                if rem_ms < 0 { rem_ms = 0 }
            }
        }

        var n = oren_fd_wait_readable(fd, rem_ms)
        if n == 0 {
            ptr_set(sa_lenp, 16)
            var r1 = sys_recvfrom(fd, buf, len, 0, sa_out, sa_lenp)
            if r1 != 0 - 35 && r1 != 0 - 11 { return r1 }
            if deadline_ns != 0 {
                var now2 = oren_time_unix_ns()
                if now2 != 0 && now2 < deadline_ns { continue }
            }
            if timeout_ms > 0 {
                spins = spins + 1
                if spins < 64 { continue }
            }
            return 0 - 60 // ETIMEDOUT
        }
        if n < 0 { return n }
        // Wait satisfied; loop back and attempt recv again.
    }
}

@cap.requires(domain="NET")
fn oren_udp_close(fd) {
    native_capsule_require(CAP_NET, "NET")
    if fd < 0 { return 0 }
    sys_close(fd)
    return 0
}
