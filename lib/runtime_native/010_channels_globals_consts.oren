var GLOBAL_OFF_PROC_ALLOWED_PIDS_PTR = 240
var GLOBAL_OFF_PROC_ALLOWED_PIDS_LEN = 248
var GLOBAL_OFF_PROC_ALLOWED_PIDS_CAP = 256
var GLOBAL_OFF_ENABLE_SIMD = 264
var GLOBAL_OFF_RAW_MMAP_THRESHOLD = 272
var GLOBAL_OFF_BUF_ALIGN = 280
var GLOBAL_OFF_BUF_FORCE_MMAP = 288
var GLOBAL_OFF_BUF_PAYLOAD_LIMIT = 296
var GLOBAL_OFF_CALL_DEPTH = 304
var GLOBAL_OFF_CALL_DEPTH_MAX = 312
var GLOBAL_OFF_NET_FD_CAPS_MAP_KEYS_PTR = 320
var GLOBAL_OFF_NET_FD_CAPS_MAP_VALS_PTR = 328
var GLOBAL_OFF_NET_FD_CAPS_MAP_CAP = 336
var GLOBAL_OFF_NET_FD_CAPS_MAP_LEN = 344
var GLOBAL_OFF_NET_FD_CAPS_LOCK = 352

// Reserve extra room for rolling ABI growth.
var GLOBAL_SLOTS_RESERVED = 56

// IMPORTANT (native backend rolling):
// These offsets are ABI constants for the runtime, but the native backend does not yet reliably
// execute global initializers (and global var writes are still rolling in some paths).
//
// To keep Tier‑1 semantics correct, the accessors below use literal offsets rather than reading
// `GLOBAL_OFF_*` vars at runtime.
fn global_get_allocs() { return ptr_get(iadd(oren_globals(), 0)) }
fn global_set_allocs(v) { ptr_set(iadd(oren_globals(), 0), v) }

fn global_get_roots() { return ptr_get(iadd(oren_globals(), 8)) }
fn global_set_roots(v) { ptr_set(iadd(oren_globals(), 8), v) }

