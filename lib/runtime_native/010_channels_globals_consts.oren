// --- Channels (portable; rolling) ---
//
// Native channel representations (rolling):
// - macOS/Linux: pipe pair list `[rfd, wfd]` (fd readiness integrates with select/netpoll)
// - Windows: in-memory channel struct (see `lib/runtime_native/011_channels_mem.oren`)
fn oren_new_channel() {
    if g_target_os == 3 {
        return native_chan_new_mem_default()
    }
    return oren_pipe() // Returns [r, w]
}

fn _chan_pipe_wait_fd(fd, want_write) {
    if fd < 0 { return 0 - 22 }
    if oren_green_in_green() == true && native_netpoll_supported() == true {
        var g = oren_green_current_g_or0()
        if g != 0 {
            var rc0 = native_netpoll_init_once()
            if rc0 < 0 { return rc0 }
            while 1 {
                ptr_set(g + green_g_off_io_fd(), fd)
                ptr_set(g + green_g_off_io_kind(), want_write)
                ptr_set(g + green_g_off_io_ready(), 0)
                ptr_set(g + green_g_off_io_active(), 1)
                var arc = native_netpoll_arm_fd(fd, want_write, g)
                if arc < 0 {
                    ptr_set(g + green_g_off_io_active(), 0)
                    return arc
                }
                // Approximate "wait forever" using a long sleep; the netpoller forces an early wake
                // on readiness.
                oren_green_sleep_ns(60000000000) // 60s
                native_netpoll_disarm_fd(fd, want_write)
                var ok = ptr_get(g + green_g_off_io_ready())
                ptr_set(g + green_g_off_io_active(), 0)
                ptr_set(g + green_g_off_io_ready(), 0)
                if ok != 0 { return 1 }
            }
        }
    }
    sys_nanosleep(1000000) // 1ms backoff on non-green paths
    return 1
}

fn oren_chan_send(ch, val) {
    if native_chan_is_mem(ch) == 1 {
        return native_chan_send_mem(ch, val)
    }
    var w = oren_list_get(ch, 1)
    var buf = malloc(8)
    if buf == 0 { return 0 }
    ptr_set(buf, val)
    var sent = 0
    while sent < 8 {
        var n = sys_write(w, buf + sent, 8 - sent)
        n = native_canon_i32_arg(n)
        if n > 0 {
            sent = sent + n
            continue
        }
        // EAGAIN/EWOULDBLOCK: macOS=35, Linux=11
        if n == 0 - 35 || n == 0 - 11 {
            var ready = _chan_pipe_wait_fd(w, 1)
            if ready < 0 {
                free(buf)
                return 0
            }
            continue
        }
        free(buf)
        return 0
    }
    free(buf)
    return 1
}

fn oren_chan_recv(ch) {
    if native_chan_is_mem(ch) == 1 {
        return native_chan_recv_mem(ch)
    }
    var r = oren_list_get(ch, 0)
    var buf = malloc(8)
    if buf == 0 { return 0 }
    var got = 0
    while got < 8 {
        var n = sys_read(r, buf + got, 8 - got)
        n = native_canon_i32_arg(n)
        if n > 0 {
            got = got + n
            continue
        }
        // EAGAIN/EWOULDBLOCK: macOS=35, Linux=11
        if n == 0 - 35 || n == 0 - 11 {
            var ready = _chan_pipe_wait_fd(r, 0)
            if ready < 0 {
                free(buf)
                return 0
            }
            continue
        }
        free(buf)
        return 0
    }
    var val = ptr_get(buf)
    free(buf)
    return val
}

// --- Native GC/Heap Tracking ---
fn oren_pipe() {
    var buf = malloc(16)
    if buf == 0 { return oren_new_list(0) }
    
    var res = sys_pipe(buf)
    // POSIX: pipe2 returns 0 on success and -errno on failure.
    // Treat any non-zero return as failure (strict) so backend return-value clobbers are caught.
    if res != 0 { free(buf); return oren_new_list(0) }
    
    var r = ptr_get(buf)
    var w = ptr_get(iadd(buf, 8))
    free(buf)
    if r >= 0 {
        var rfl = sys_fcntl_getfl(r)
        if rfl >= 0 { sys_fcntl_setfl(r, rfl | OREN_O_NONBLOCK) }
    }
    if w >= 0 {
        var wfl = sys_fcntl_getfl(w)
        if wfl >= 0 { sys_fcntl_setfl(w, wfl | OREN_O_NONBLOCK) }
    }
    
    var l = oren_new_list(2)
    oren_list_push(l, r)
    oren_list_push(l, w)
    return l
}

// --- Native GC/Heap Tracking ---

// We use a string literal in a function to get a stable pointer to writable memory for globals.
// Layout (8-byte slots):
//   0:allocs
//   8:roots
//   16:lock_owner_tid
//   24:free_nodes
//   32:threads
//   40:argc
//   48:argv
//   56:lock_recurse_count
//   64:envp
//   72:free_blocks
//   80:capsule_mode (0|1) (rolling: deny-by-default capability enforcement)
//   88:cap_allow_mask (bitmask; rolling)
//   96:fs_allow_prefixes_ptr (cstr: CSV prefixes) (rolling)
//   104:fs_allow_read_prefixes_ptr (cstr: CSV prefixes) (rolling)
//   112:fs_allow_write_prefixes_ptr (cstr: CSV prefixes) (rolling)
//   120:fs_mounts_ptr (cstr: CSV mounts; legacy applies to both) (rolling)
//   128:fs_mounts_read_ptr (cstr: CSV mounts) (rolling)
//   136:fs_mounts_write_ptr (cstr: CSV mounts) (rolling)
//   144:net_allow_loopback (0|1) (rolling)
//   152:net_allow_tcp_connect_ptr (cstr: CSV endpoints) (rolling)
//   160:net_allow_tcp_listen_ptr (cstr: CSV endpoints) (rolling)
//   208:net_tcp_connect_map_ptr (cstr: CSV mappings) (rolling)
//   216:net_tcp_listen_map_ptr (cstr: CSV mappings) (rolling)
//   224:net_fd_caps_ptr (bytes: fd->kind table) (rolling)
//   232:net_fd_caps_len (max fds) (rolling)
//   168:proc_allow_system (0|1) (rolling)
//   176:proc_allow_exec_prefixes_ptr (cstr: CSV prefixes) (rolling)
//   184:proc_inherit_env (0|1) (rolling)
//   192:proc_allow_env_keys_ptr (cstr: CSV keys) (rolling)
//   200:proc_allow_argv_ptr (cstr: CSV command specs) (rolling)
//   240:proc_allowed_pids_ptr (u64[] raw, len=cap; 0 means empty slot) (rolling)
//   248:proc_allowed_pids_len (count) (rolling)
//   256:proc_allowed_pids_cap (capacity) (rolling)
//   264:enable_simd (0|1) (rolling; runtime opt-in for SIMD fast paths)
//   272:raw_mmap_threshold_bytes (>=0; 0 disables mmap; rolling)
//   280:buf_align (8|16|32|64; rolling)
//   288:buf_force_mmap (0|1; rolling)
//   296:buf_payload_limit_bytes (0 means unlimited; rolling)
//   304:call_depth (rolling; stack safety)
//   312:call_depth_max (rolling; stack safety)
//   320:net_fd_caps_map_keys_ptr (u64[] raw; open-addressing keys) (rolling)
//   328:net_fd_caps_map_vals_ptr (u8[] raw; per-key kind) (rolling)
//   336:net_fd_caps_map_cap (entry count; power of two) (rolling)
//   344:net_fd_caps_map_len (live entries) (rolling)
//   352:net_fd_caps_lock (spinlock; 0|1) (rolling)
//   360:result_value (rolling; `oren_set_result` / `oren_get_result`)
//   368:value_nil   (native backend: `nil` singleton value)
//   376:value_false (native backend: `false` singleton value)
//   384:value_true  (native backend: `true` singleton value)
//   416:os_thread_count (u64; number of registered OS threads; rolling)
//   424:gc_stw_state (u64; 0=running, 1=stop-the-world requested; rolling)
//   432:gc_stw_parked (u64; parked OS-thread count excluding collector; rolling)
//   440:gc_stw_owner_node (u64; Thread Node pointer of collector; rolling)
//   472:native_run_json_enabled (u64; 0|1)
//   480:native_run_json_start_ns (u64)
//   488:native_run_json_printed (u64; 0|1)
//   496:native_gas_safepoint_ticks (u64; rolling v0 gas evidence)
var g_storage = 0

fn oren_globals() {
    return g_storage
}

// NOTE (ABI hygiene; rolling):
