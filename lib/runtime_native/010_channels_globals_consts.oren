// Native backend value helpers (Tier‑1):
// `nil`, `false`, `true` are runtime singletons under the native backend.
// These helpers keep runtime code from accidentally treating raw 0 as `nil`.
fn native_value_nil() { return global_get_value_nil() }
fn native_value_false() { return global_get_value_false() }
fn native_value_true() { return global_get_value_true() }

fn native_value_is_nil(v) {
    var vn = native_value_nil()
    if vn == 0 { return false }
    return (v - vn) == 0
}

fn native_value_is_false(v) {
    var vf = native_value_false()
    if vf == 0 { return false }
    return (v - vf) == 0
}

fn native_value_is_true(v) {
    var vt = native_value_true()
    if vt == 0 { return false }
    return (v - vt) == 0
}

fn native_value_is_falsey(v) {
    if native_value_is_nil(v) { return true }
    return native_value_is_false(v)
}

fn native_simd_enabled() { return global_get_enable_simd() }

// SIMD feature gates (rolling):
//
// We keep SIMD globally toggleable via `global_get_enable_simd()`, but we also
// gate known-problematic kernels so correctness stays non-negotiable.
//
// Status (2025-12-22):
// - `simd_dot_f32_ptr` is validated by `tests/native/test_simd_suite.oren` for
//   the vector-sized path; tails are handled in Oren wrapper code for now to
//   keep bit-exact semantics (fractional + odd-n guardrails).
// - f32 1x4 / 4x4 higher-level APIs are enabled; the current implementation is
//   built from tail-safe dot kernels (not the direct f32 4x4 microkernel).
fn native_simd_f32_dot_enabled() { return 1 }
fn native_simd_f32_dot4_enabled() { return 1 }

