// --- Channels (Pipe-based) ---
fn oren_new_channel() {
    return oren_pipe() // Returns [r, w]
}

fn oren_chan_send(ch, val) {
    var w = oren_list_get(ch, 1)
    var buf = malloc(8)
    if buf == 0 { return 0 }
    ptr_set(buf, val)
    sys_write(w, buf, 8)
    // free(buf) - no free yet
    return 1
}

fn oren_chan_recv(ch) {
    var r = oren_list_get(ch, 0)
    var buf = malloc(8)
    if buf == 0 { return 0 }
    sys_read(r, buf, 8)
    var val = ptr_get(buf)
    // free(buf)
    return val
}

// --- Native GC/Heap Tracking ---
fn oren_pipe() {
    var buf = malloc(16)
    if buf == 0 { return oren_new_list(0) }
    
    var res = sys_pipe(buf)
    if res != 0 { return oren_new_list(0) }
    
    var r = ptr_get(buf)
    var w = ptr_get(iadd(buf, 8))
    
    var l = oren_new_list(2)
    oren_list_push(l, r)
    oren_list_push(l, w)
    return l
}

// --- Native GC/Heap Tracking ---

// We use a string literal in a function to get a stable pointer to writable memory for globals.
// Layout (8-byte slots):
//   0:allocs
//   8:roots
//   16:lock_owner_tid
//   24:free_nodes
//   32:threads
//   40:argc
//   48:argv
//   56:lock_recurse_count
//   64:envp
//   72:free_blocks
//   80:capsule_mode (0|1) (rolling: deny-by-default capability enforcement)
//   88:cap_allow_mask (bitmask; rolling)
//   96:fs_allow_prefixes_ptr (cstr: CSV prefixes) (rolling)
//   104:fs_allow_read_prefixes_ptr (cstr: CSV prefixes) (rolling)
//   112:fs_allow_write_prefixes_ptr (cstr: CSV prefixes) (rolling)
//   120:fs_mounts_ptr (cstr: CSV mounts; legacy applies to both) (rolling)
//   128:fs_mounts_read_ptr (cstr: CSV mounts) (rolling)
//   136:fs_mounts_write_ptr (cstr: CSV mounts) (rolling)
//   144:net_allow_loopback (0|1) (rolling)
//   152:net_allow_tcp_connect_ptr (cstr: CSV endpoints) (rolling)
//   160:net_allow_tcp_listen_ptr (cstr: CSV endpoints) (rolling)
//   208:net_tcp_connect_map_ptr (cstr: CSV mappings) (rolling)
//   216:net_tcp_listen_map_ptr (cstr: CSV mappings) (rolling)
//   224:net_fd_caps_ptr (bytes: fd->kind table) (rolling)
//   232:net_fd_caps_len (max fds) (rolling)
//   168:proc_allow_system (0|1) (rolling)
//   176:proc_allow_exec_prefixes_ptr (cstr: CSV prefixes) (rolling)
//   184:proc_inherit_env (0|1) (rolling)
//   192:proc_allow_env_keys_ptr (cstr: CSV keys) (rolling)
//   200:proc_allow_argv_ptr (cstr: CSV command specs) (rolling)
//   240:proc_allowed_pids_ptr (u64[] raw, len=cap; 0 means empty slot) (rolling)
//   248:proc_allowed_pids_len (count) (rolling)
//   256:proc_allowed_pids_cap (capacity) (rolling)
//   264:enable_simd (0|1) (rolling; runtime opt-in for SIMD fast paths)
//   272:raw_mmap_threshold_bytes (>=0; 0 disables mmap; rolling)
//   280:buf_align (8|16|32|64; rolling)
//   288:buf_force_mmap (0|1; rolling)
//   296:buf_payload_limit_bytes (0 means unlimited; rolling)
var g_storage = 0

fn oren_globals() {
    return g_storage
}

// NOTE (ABI hygiene; rolling):
// - Keep a single authoritative definition of global slot offsets.
// - Do not reuse slots for unrelated purposes.
// - Prefer global_get_*/global_set_* helpers over raw offsets.
var GLOBAL_SLOT_BYTES = 8
var GLOBAL_OFF_ALLOCS = 0
var GLOBAL_OFF_ROOTS = 8
var GLOBAL_OFF_LOCK_OWNER_TID = 16
var GLOBAL_OFF_FREE_NODES = 24
var GLOBAL_OFF_THREADS = 32
var GLOBAL_OFF_ARGC = 40
var GLOBAL_OFF_ARGV = 48
var GLOBAL_OFF_LOCK_RECURSE_COUNT = 56
var GLOBAL_OFF_ENVP = 64
var GLOBAL_OFF_FREE_BLOCKS = 72
var GLOBAL_OFF_CAPSULE_MODE = 80
var GLOBAL_OFF_CAP_ALLOW_MASK = 88
var GLOBAL_OFF_FS_ALLOW_PREFIXES_PTR = 96
var GLOBAL_OFF_FS_ALLOW_READ_PREFIXES_PTR = 104
var GLOBAL_OFF_FS_ALLOW_WRITE_PREFIXES_PTR = 112
var GLOBAL_OFF_FS_MOUNTS_PTR = 120
var GLOBAL_OFF_FS_MOUNTS_READ_PTR = 128
var GLOBAL_OFF_FS_MOUNTS_WRITE_PTR = 136
var GLOBAL_OFF_NET_ALLOW_LOOPBACK = 144
var GLOBAL_OFF_NET_ALLOW_TCP_CONNECT_PTR = 152
var GLOBAL_OFF_NET_ALLOW_TCP_LISTEN_PTR = 160
var GLOBAL_OFF_NET_TCP_CONNECT_MAP_PTR = 208
var GLOBAL_OFF_NET_TCP_LISTEN_MAP_PTR = 216
var GLOBAL_OFF_NET_FD_CAPS_PTR = 224
var GLOBAL_OFF_NET_FD_CAPS_LEN = 232
var GLOBAL_OFF_PROC_ALLOW_SYSTEM = 168
var GLOBAL_OFF_PROC_ALLOW_EXEC_PREFIXES_PTR = 176
var GLOBAL_OFF_PROC_INHERIT_ENV = 184
var GLOBAL_OFF_PROC_ALLOW_ENV_KEYS_PTR = 192
var GLOBAL_OFF_PROC_ALLOW_ARGV_PTR = 200
var GLOBAL_OFF_PROC_ALLOWED_PIDS_PTR = 240
var GLOBAL_OFF_PROC_ALLOWED_PIDS_LEN = 248
var GLOBAL_OFF_PROC_ALLOWED_PIDS_CAP = 256
var GLOBAL_OFF_ENABLE_SIMD = 264
var GLOBAL_OFF_RAW_MMAP_THRESHOLD = 272
var GLOBAL_OFF_BUF_ALIGN = 280
var GLOBAL_OFF_BUF_FORCE_MMAP = 288
var GLOBAL_OFF_BUF_PAYLOAD_LIMIT = 296

// Reserve extra room for rolling ABI growth.
var GLOBAL_SLOTS_RESERVED = 56

fn global_get_allocs() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_ALLOCS)) }
fn global_set_allocs(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_ALLOCS), v) }

fn global_get_roots() { return ptr_get(iadd(oren_globals(), GLOBAL_OFF_ROOTS)) }
fn global_set_roots(v) { ptr_set(iadd(oren_globals(), GLOBAL_OFF_ROOTS), v) }

