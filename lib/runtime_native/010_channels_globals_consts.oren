fn global_get_proc_allowed_pids_len() { return ptr_get(iadd(oren_globals(), 248)) }
fn global_set_proc_allowed_pids_len(v) { ptr_set(iadd(oren_globals(), 248), v) }

fn global_get_proc_allowed_pids_cap() { return ptr_get(iadd(oren_globals(), 256)) }
fn global_set_proc_allowed_pids_cap(v) { ptr_set(iadd(oren_globals(), 256), v) }

// Capsule/capability mask bits (rolling; native backend only).
var CAP_FS = 1
var CAP_NET = 2
var CAP_PROC = 4
var CAP_ENV = 8
var CAP_TIME = 16
var CAP_RNG = 32

// Oren-level open(2) flags (rolling ABI; translated by native codegen).
//
// Design:
// - Lower 2 bits match POSIX access modes: 0=RDONLY, 1=WRONLY, 2=RDWR.
// - Higher bits are Oren-stable feature flags and must be translated to OS-specific
//   O_* bits in `arm64_native_expr_syscalls.oren` (Darwin/Linux differ).
var OREN_O_CREAT = 256
var OREN_O_TRUNC = 512
var OREN_O_NONBLOCK = 1024
var OREN_O_APPEND = 2048

// POSIX socket constants used by syscall-first runtime (no SDK headers).
// Values are stable across Darwin/Linux for IPv4 + TCP/UDP in practice.
var OREN_AF_INET = 2
// NOTE: AF_INET6 differs across Darwin/Linux:
// - macOS: 30
// - Linux: 10
// We initialize this deterministically in `native_runtime_init` based on target_os.
var OREN_AF_INET6 = 30
var OREN_AF_UNIX = 1
var OREN_SOCK_STREAM = 1
var OREN_SOCK_DGRAM = 2
var OREN_IPPROTO_TCP = 6
var OREN_IPPROTO_UDP = 17
// TCP-level sockopt IDs (rolling ABI; used with `level=OREN_IPPROTO_TCP`).
// Values are stable across Darwin/Linux/Windows for the Tier‑1 surface.
var OREN_TCP_NODELAY = 1

// Oren-level getsockopt/setsockopt constants (rolling ABI).
// These are translated to OS-specific values in the native syscall lowering layer.
var OREN_SOL_SOCKET = 1
var OREN_SO_REUSEADDR = 2
var OREN_SO_ERROR = 4
// NOTE: SO_TYPE differs across OSes; `native_runtime_init` sets this per target.
var OREN_SO_TYPE = 3
// Matches Linux SO_KEEPALIVE (9) so x64-linux syscall intrinsics (pass-through)
// work without a translation table. Darwin/Windows translate this value.
var OREN_SO_KEEPALIVE = 9

// Typed buffer tags:
// `ore_iter_next` needs BUF_TAG_U8 early to support `for x in u8_buf`.
// Keep this as a top-level constant so the native backend doesn't depend on
// global forward references (rolling parser/codegen constraint).
var BUF_TAG_U8 = 5
var BUF_TAG_I32 = 1
var BUF_TAG_I64 = 2
var BUF_TAG_F32 = 3
var BUF_TAG_F64 = 4

// Capsule per-fd kind tags (rolling; native backend only).
// Stored in `net_fd_caps_ptr` (byte-per-fd).
//
// NOTE: In rolling mode this table is shared for:
// - NET sockets (stream/listen/dgram)
// - PROC IPC fds (pipes used by spawn/join)
var FD_KIND_NONE = 0
var FD_KIND_TCP_STREAM = 1
var FD_KIND_TCP_LISTEN = 2
var FD_KIND_UDP_DGRAM = 3
var FD_KIND_PROC_PIPE = 10
var FD_KIND_KQUEUE = 20
var FD_KIND_EPOLL = 21

// NET wait backend detection (rolling):
// - macOS: kqueue/kevent is available
// - Linux: kqueue does not exist
//
// Values:
// - -1: unknown (not detected yet)
// -  0: no kqueue backend
// -  1: has kqueue backend
var g_net_has_kqueue = -1

// Windows WinSock init state (rolling):
// - 0: WSAStartup not called yet
// - 1: WSAStartup completed successfully
//
// NOTE: This is intentionally a plain runtime global (not a GC root). It is set
// by `native_runtime_init` because global initializers are not reliably executed
// by the native backend during bring-up.
var g_net_wsa_inited = 0

// Native target OS (rolling):
// - 0: unknown (should not happen after runtime init)
// - 1: macOS
// - 2: Linux
// - 3: Windows
var g_target_os = 0

// Darwin syscall-first OS thread substrate registration state (rolling):
// - 0: not registered (do not call bsdthread_create from the runtime)
// - 1: registered with runtime-owned threadstart/wqthread stubs
var g_darwin_bsdthread_registered = 0
// Best-effort debugging aid: last return value from `bsdthread_register` bring-up.
// 0 means "success" (as per syscall convention); negative values are -errno.
var g_darwin_bsdthread_register_last_rv = 0

// Rolling select fairness cursor (native runtime):
// - Used by `oren_select` / `oren_select_recv` to avoid always picking case 0 when multiple are ready.
// - In AVM this cursor is per-task; in native runtime (no scheduler yet) we keep a single global cursor.
var g_select_cursor = 0

// Native capsule effect-gate counters (rolling v0).
//
// Scope:
// - Counts only the central capsule domain-gate checks (`native_capsule_require*`).
// - Resource-level allowlist outcomes after the domain gate are tracked separately below.
var g_native_capsule_effect_gate_total = 0
var g_native_capsule_effect_gate_denied = 0
var g_native_capsule_effect_gate_any = 0
var g_native_capsule_effect_gate_fs = 0
var g_native_capsule_effect_gate_net = 0
var g_native_capsule_effect_gate_proc = 0
var g_native_capsule_effect_gate_env = 0
var g_native_capsule_effect_gate_time = 0
var g_native_capsule_effect_gate_rng = 0

fn native_capsule_effect_gate_counters_reset() {
    g_native_capsule_effect_gate_total = 0
    g_native_capsule_effect_gate_denied = 0
    g_native_capsule_effect_gate_any = 0
    g_native_capsule_effect_gate_fs = 0
    g_native_capsule_effect_gate_net = 0
    g_native_capsule_effect_gate_proc = 0
    g_native_capsule_effect_gate_env = 0
    g_native_capsule_effect_gate_time = 0
    g_native_capsule_effect_gate_rng = 0
    return 0
}

fn native_capsule_effect_gate_note(mask_bits, denied, is_any) {
    if global_get_capsule_mode() != 1 { return 0 }
    g_native_capsule_effect_gate_total = g_native_capsule_effect_gate_total + 1
    if denied != 0 {
        g_native_capsule_effect_gate_denied = g_native_capsule_effect_gate_denied + 1
    }
    if is_any != 0 {
        g_native_capsule_effect_gate_any = g_native_capsule_effect_gate_any + 1
        return 0
    }
    if (mask_bits & CAP_FS) != 0 { g_native_capsule_effect_gate_fs = g_native_capsule_effect_gate_fs + 1 }
    if (mask_bits & CAP_NET) != 0 { g_native_capsule_effect_gate_net = g_native_capsule_effect_gate_net + 1 }
    if (mask_bits & CAP_PROC) != 0 { g_native_capsule_effect_gate_proc = g_native_capsule_effect_gate_proc + 1 }
    if (mask_bits & CAP_ENV) != 0 { g_native_capsule_effect_gate_env = g_native_capsule_effect_gate_env + 1 }
    if (mask_bits & CAP_TIME) != 0 { g_native_capsule_effect_gate_time = g_native_capsule_effect_gate_time + 1 }
    if (mask_bits & CAP_RNG) != 0 { g_native_capsule_effect_gate_rng = g_native_capsule_effect_gate_rng + 1 }
    return 0
}

fn native_capsule_effect_gate_total() { return g_native_capsule_effect_gate_total }
fn native_capsule_effect_gate_denied() { return g_native_capsule_effect_gate_denied }
fn native_capsule_effect_gate_any() { return g_native_capsule_effect_gate_any }
fn native_capsule_effect_gate_fs() { return g_native_capsule_effect_gate_fs }
fn native_capsule_effect_gate_net() { return g_native_capsule_effect_gate_net }
fn native_capsule_effect_gate_proc() { return g_native_capsule_effect_gate_proc }
fn native_capsule_effect_gate_env() { return g_native_capsule_effect_gate_env }
fn native_capsule_effect_gate_time() { return g_native_capsule_effect_gate_time }
fn native_capsule_effect_gate_rng() { return g_native_capsule_effect_gate_rng }

fn native_runtime_heap_used_bytes() {
    if oren_globals() == 0 { return 0 }

    // Runtime-observed, best-effort live heap summary for `OREN_NATIVE_RUN_JSON=1`.
    //
    // This scans the GC allocation tracking list at report time instead of maintaining a second
    // counter through every allocation/free/reuse path. That keeps v0 ledger export tied to the
    // existing runtime source of truth and avoids making the GC reuse paths more fragile.
    var total = 0
    var cur = global_get_allocs()
    var limit = 10000000
    while cur != 0 && limit > 0 {
        var size = ptr_get(iadd(cur, 8))
        var state = ptr_get(iadd(cur, 24))
        if size > 0 && state != 1 {
            total = total + size
        }
        cur = ptr_get(iadd(cur, 32))
        limit = limit - 1
    }
    return total
}

fn native_runtime_gas_reset() {
    if oren_globals() == 0 { return 0 }
    global_set_native_gas_safepoint_ticks(0)
    return 0
}

fn native_runtime_gas_note(amount) {
    if oren_globals() == 0 { return 0 }
    if amount == nil { return 0 }
    if amount <= 0 { return 0 }
    var v = global_get_native_gas_safepoint_ticks()
    global_set_native_gas_safepoint_ticks(v + amount)
    return 0
}

fn native_runtime_gas_note_safepoint() {
    return native_runtime_gas_note(1)
}

fn native_runtime_gas_safepoint_ticks() {
    if oren_globals() == 0 { return 0 }
    return global_get_native_gas_safepoint_ticks()
}

fn native_capsule_effect_gate_summary_json() {
    var line = "{\"schema\":\"oren.native-capsule-effect-gates.v0\",\"kind\":\"domain_gates\""
    line = line + ",\"available\":true"
    if global_get_capsule_mode() == 1 {
        line = line + ",\"capsule\":true"
    } else {
        line = line + ",\"capsule\":false"
    }
    line = line + ",\"total\":" + oren_int_to_string(g_native_capsule_effect_gate_total)
    line = line + ",\"denied\":" + oren_int_to_string(g_native_capsule_effect_gate_denied)
    line = line + ",\"any\":" + oren_int_to_string(g_native_capsule_effect_gate_any)
    line = line + ",\"domains\":{"
    line = line + "\"FS\":" + oren_int_to_string(g_native_capsule_effect_gate_fs)
    line = line + ",\"NET\":" + oren_int_to_string(g_native_capsule_effect_gate_net)
    line = line + ",\"PROC\":" + oren_int_to_string(g_native_capsule_effect_gate_proc)
    line = line + ",\"ENV\":" + oren_int_to_string(g_native_capsule_effect_gate_env)
    line = line + ",\"TIME\":" + oren_int_to_string(g_native_capsule_effect_gate_time)
    line = line + ",\"RNG\":" + oren_int_to_string(g_native_capsule_effect_gate_rng)
    line = line + "}}"
    return line
}

// Native capsule resource-check counters (rolling v0).
//
// Scope:
// - Counts concrete allow/deny decisions made *after* a domain gate succeeds.
// - This is intentionally narrower than a full effect ledger: it tracks selected FS/NET/PROC
//   resource policy outcomes, not gas/heap accounting or byte counts.
var NATIVE_CAP_RES_FS_PATH = 1
var NATIVE_CAP_RES_FS_MOUNT = 2
var NATIVE_CAP_RES_NET_SOCKET = 3
var NATIVE_CAP_RES_NET_ENDPOINT = 4
var NATIVE_CAP_RES_NET_FD = 5
var NATIVE_CAP_RES_NET_ACCEPT = 6
var NATIVE_CAP_RES_PROC_SYSTEM = 7
var NATIVE_CAP_RES_PROC_EXEC = 8
var NATIVE_CAP_RES_PROC_ARGV = 9
var NATIVE_CAP_RES_PROC_WAIT = 10
var NATIVE_CAP_RES_PROC_KILL = 11

var g_native_capsule_resource_check_total = 0
var g_native_capsule_resource_check_denied = 0
var g_native_capsule_resource_fs_path_allowed = 0
var g_native_capsule_resource_fs_path_denied = 0
var g_native_capsule_resource_fs_mount_allowed = 0
var g_native_capsule_resource_fs_mount_denied = 0
var g_native_capsule_resource_net_socket_allowed = 0
var g_native_capsule_resource_net_socket_denied = 0
var g_native_capsule_resource_net_endpoint_allowed = 0
var g_native_capsule_resource_net_endpoint_denied = 0
var g_native_capsule_resource_net_fd_allowed = 0
var g_native_capsule_resource_net_fd_denied = 0
var g_native_capsule_resource_net_accept_allowed = 0
var g_native_capsule_resource_net_accept_denied = 0
var g_native_capsule_resource_proc_system_allowed = 0
var g_native_capsule_resource_proc_system_denied = 0
var g_native_capsule_resource_proc_exec_allowed = 0
var g_native_capsule_resource_proc_exec_denied = 0
var g_native_capsule_resource_proc_argv_allowed = 0
var g_native_capsule_resource_proc_argv_denied = 0
var g_native_capsule_resource_proc_wait_allowed = 0
var g_native_capsule_resource_proc_wait_denied = 0
var g_native_capsule_resource_proc_kill_allowed = 0
var g_native_capsule_resource_proc_kill_denied = 0

fn native_capsule_resource_check_counters_reset() {
    g_native_capsule_resource_check_total = 0
    g_native_capsule_resource_check_denied = 0
    g_native_capsule_resource_fs_path_allowed = 0
    g_native_capsule_resource_fs_path_denied = 0
    g_native_capsule_resource_fs_mount_allowed = 0
    g_native_capsule_resource_fs_mount_denied = 0
    g_native_capsule_resource_net_socket_allowed = 0
    g_native_capsule_resource_net_socket_denied = 0
    g_native_capsule_resource_net_endpoint_allowed = 0
    g_native_capsule_resource_net_endpoint_denied = 0
    g_native_capsule_resource_net_fd_allowed = 0
    g_native_capsule_resource_net_fd_denied = 0
    g_native_capsule_resource_net_accept_allowed = 0
    g_native_capsule_resource_net_accept_denied = 0
    g_native_capsule_resource_proc_system_allowed = 0
    g_native_capsule_resource_proc_system_denied = 0
    g_native_capsule_resource_proc_exec_allowed = 0
    g_native_capsule_resource_proc_exec_denied = 0
    g_native_capsule_resource_proc_argv_allowed = 0
    g_native_capsule_resource_proc_argv_denied = 0
    g_native_capsule_resource_proc_wait_allowed = 0
    g_native_capsule_resource_proc_wait_denied = 0
    g_native_capsule_resource_proc_kill_allowed = 0
    g_native_capsule_resource_proc_kill_denied = 0
    return 0
}

fn native_capsule_resource_check_note(kind, denied) {
    if global_get_capsule_mode() != 1 { return 0 }
    var is_denied = 0
    if denied != 0 { is_denied = 1 }

    g_native_capsule_resource_check_total = g_native_capsule_resource_check_total + 1
    if is_denied != 0 {
        g_native_capsule_resource_check_denied = g_native_capsule_resource_check_denied + 1
    }

    if kind == NATIVE_CAP_RES_FS_PATH {
        if is_denied != 0 { g_native_capsule_resource_fs_path_denied = g_native_capsule_resource_fs_path_denied + 1 }
        else { g_native_capsule_resource_fs_path_allowed = g_native_capsule_resource_fs_path_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_FS_MOUNT {
        if is_denied != 0 { g_native_capsule_resource_fs_mount_denied = g_native_capsule_resource_fs_mount_denied + 1 }
        else { g_native_capsule_resource_fs_mount_allowed = g_native_capsule_resource_fs_mount_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_NET_SOCKET {
        if is_denied != 0 { g_native_capsule_resource_net_socket_denied = g_native_capsule_resource_net_socket_denied + 1 }
        else { g_native_capsule_resource_net_socket_allowed = g_native_capsule_resource_net_socket_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_NET_ENDPOINT {
        if is_denied != 0 { g_native_capsule_resource_net_endpoint_denied = g_native_capsule_resource_net_endpoint_denied + 1 }
        else { g_native_capsule_resource_net_endpoint_allowed = g_native_capsule_resource_net_endpoint_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_NET_FD {
        if is_denied != 0 { g_native_capsule_resource_net_fd_denied = g_native_capsule_resource_net_fd_denied + 1 }
        else { g_native_capsule_resource_net_fd_allowed = g_native_capsule_resource_net_fd_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_NET_ACCEPT {
        if is_denied != 0 { g_native_capsule_resource_net_accept_denied = g_native_capsule_resource_net_accept_denied + 1 }
        else { g_native_capsule_resource_net_accept_allowed = g_native_capsule_resource_net_accept_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_PROC_SYSTEM {
        if is_denied != 0 { g_native_capsule_resource_proc_system_denied = g_native_capsule_resource_proc_system_denied + 1 }
        else { g_native_capsule_resource_proc_system_allowed = g_native_capsule_resource_proc_system_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_PROC_EXEC {
        if is_denied != 0 { g_native_capsule_resource_proc_exec_denied = g_native_capsule_resource_proc_exec_denied + 1 }
        else { g_native_capsule_resource_proc_exec_allowed = g_native_capsule_resource_proc_exec_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_PROC_ARGV {
        if is_denied != 0 { g_native_capsule_resource_proc_argv_denied = g_native_capsule_resource_proc_argv_denied + 1 }
        else { g_native_capsule_resource_proc_argv_allowed = g_native_capsule_resource_proc_argv_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_PROC_WAIT {
        if is_denied != 0 { g_native_capsule_resource_proc_wait_denied = g_native_capsule_resource_proc_wait_denied + 1 }
        else { g_native_capsule_resource_proc_wait_allowed = g_native_capsule_resource_proc_wait_allowed + 1 }
        return 0
    }
    if kind == NATIVE_CAP_RES_PROC_KILL {
        if is_denied != 0 { g_native_capsule_resource_proc_kill_denied = g_native_capsule_resource_proc_kill_denied + 1 }
        else { g_native_capsule_resource_proc_kill_allowed = g_native_capsule_resource_proc_kill_allowed + 1 }
        return 0
    }
    return 0
}

fn native_capsule_resource_check_total() { return g_native_capsule_resource_check_total }
fn native_capsule_resource_check_denied() { return g_native_capsule_resource_check_denied }
fn native_capsule_resource_fs_path_allowed() { return g_native_capsule_resource_fs_path_allowed }
fn native_capsule_resource_fs_path_denied() { return g_native_capsule_resource_fs_path_denied }
fn native_capsule_resource_fs_mount_allowed() { return g_native_capsule_resource_fs_mount_allowed }
fn native_capsule_resource_fs_mount_denied() { return g_native_capsule_resource_fs_mount_denied }

fn native_capsule_resource_json_pair(name, allowed, denied) {
    var line = "\"" + name + "\":{\"allowed\":" + oren_int_to_string(allowed)
    line = line + ",\"denied\":" + oren_int_to_string(denied) + "}"
    return line
}

fn native_capsule_resource_check_summary_json() {
    var line = "{\"schema\":\"oren.native-capsule-resource-checks.v0\",\"kind\":\"resource_checks\""
    line = line + ",\"available\":true"
    if global_get_capsule_mode() == 1 {
        line = line + ",\"capsule\":true"
    } else {
        line = line + ",\"capsule\":false"
    }
    line = line + ",\"total\":" + oren_int_to_string(g_native_capsule_resource_check_total)
    line = line + ",\"denied\":" + oren_int_to_string(g_native_capsule_resource_check_denied)
    line = line + ",\"resources\":{"
    line = line + native_capsule_resource_json_pair("fs_path", g_native_capsule_resource_fs_path_allowed, g_native_capsule_resource_fs_path_denied)
    line = line + "," + native_capsule_resource_json_pair("fs_mount", g_native_capsule_resource_fs_mount_allowed, g_native_capsule_resource_fs_mount_denied)
    line = line + "," + native_capsule_resource_json_pair("net_socket", g_native_capsule_resource_net_socket_allowed, g_native_capsule_resource_net_socket_denied)
    line = line + "," + native_capsule_resource_json_pair("net_endpoint", g_native_capsule_resource_net_endpoint_allowed, g_native_capsule_resource_net_endpoint_denied)
    line = line + "," + native_capsule_resource_json_pair("net_fd", g_native_capsule_resource_net_fd_allowed, g_native_capsule_resource_net_fd_denied)
    line = line + "," + native_capsule_resource_json_pair("net_accept", g_native_capsule_resource_net_accept_allowed, g_native_capsule_resource_net_accept_denied)
    line = line + "," + native_capsule_resource_json_pair("proc_system", g_native_capsule_resource_proc_system_allowed, g_native_capsule_resource_proc_system_denied)
    line = line + "," + native_capsule_resource_json_pair("proc_exec", g_native_capsule_resource_proc_exec_allowed, g_native_capsule_resource_proc_exec_denied)
    line = line + "," + native_capsule_resource_json_pair("proc_argv", g_native_capsule_resource_proc_argv_allowed, g_native_capsule_resource_proc_argv_denied)
    line = line + "," + native_capsule_resource_json_pair("proc_wait", g_native_capsule_resource_proc_wait_allowed, g_native_capsule_resource_proc_wait_denied)
    line = line + "," + native_capsule_resource_json_pair("proc_kill", g_native_capsule_resource_proc_kill_allowed, g_native_capsule_resource_proc_kill_denied)
    line = line + "}}"
    return line
}

// Linux epoll constants (stable on Linux; unused on macOS).
// Used by syscall-first NET wait to avoid libc poll/select shims.
var OREN_EPOLL_CTL_ADD = 1
var OREN_EPOLL_CTL_DEL = 2
var OREN_EPOLL_CTL_MOD = 3
var OREN_EPOLLIN = 1
var OREN_EPOLLOUT = 4

// Linux `struct epoll_event` layout used by epoll syscalls can differ by arch:
// - x86_64: packed (12 bytes), data @4
// - arm64:  aligned (16 bytes), data @8
//
// Rolling: native runtime init probes the active kernel ABI once at startup and fills these.
var OREN_EPOLL_EVENT_BYTES = 0
var OREN_EPOLL_EVENT_OFF_EVENTS = 0
var OREN_EPOLL_EVENT_OFF_DATA = 0

// fcntl(2) commands used for fd duplication (stable across Darwin/Linux).
// Verified via Apple SDK headers for macOS (audit only; not a build dependency).
var FCNTL_F_DUPFD = 0
var FCNTL_F_DUPFD_CLOEXEC = 67
