// Capsule/capability mask bits (rolling; native backend only).
var CAP_FS = 1
var CAP_NET = 2
var CAP_PROC = 4
var CAP_ENV = 8
var CAP_TIME = 16

// Oren-level open(2) flags (rolling ABI; translated by native codegen).
//
// Design:
// - Lower 2 bits match POSIX access modes: 0=RDONLY, 1=WRONLY, 2=RDWR.
// - Higher bits are Oren-stable feature flags and must be translated to OS-specific
//   O_* bits in `arm64_native_expr_syscalls.oren` (Darwin/Linux differ).
var OREN_O_CREAT = 256
var OREN_O_TRUNC = 512
var OREN_O_NONBLOCK = 1024

// POSIX socket constants used by syscall-first runtime (no SDK headers).
// Values are stable across Darwin/Linux for IPv4 + TCP/UDP in practice.
var OREN_AF_INET = 2
// NOTE: AF_INET6 differs across Darwin/Linux:
// - macOS: 30
// - Linux: 10
// We initialize this deterministically in `native_runtime_init` based on target_os.
var OREN_AF_INET6 = 30
var OREN_AF_UNIX = 1
var OREN_SOCK_STREAM = 1
var OREN_SOCK_DGRAM = 2
var OREN_IPPROTO_TCP = 6
var OREN_IPPROTO_UDP = 17

// Oren-level getsockopt/setsockopt constants (rolling ABI).
// These are translated to OS-specific values in the native syscall lowering layer.
var OREN_SOL_SOCKET = 1
var OREN_SO_REUSEADDR = 2
var OREN_SO_ERROR = 4

// Typed buffer tags:
// `ore_iter_next` needs BUF_TAG_U8 early to support `for x in u8_buf`.
// Keep this as a top-level constant so the native backend doesn't depend on
// global forward references (rolling parser/codegen constraint).
var BUF_TAG_U8 = 5
var BUF_TAG_I32 = 1
var BUF_TAG_I64 = 2
var BUF_TAG_F32 = 3
var BUF_TAG_F64 = 4

// Capsule per-fd kind tags (rolling; native backend only).
// Stored in `net_fd_caps_ptr` (byte-per-fd).
//
// NOTE: In rolling mode this table is shared for:
// - NET sockets (stream/listen/dgram)
// - PROC IPC fds (pipes used by spawn/join)
var FD_KIND_NONE = 0
var FD_KIND_TCP_STREAM = 1
var FD_KIND_TCP_LISTEN = 2
var FD_KIND_UDP_DGRAM = 3
var FD_KIND_PROC_PIPE = 10
var FD_KIND_KQUEUE = 20
var FD_KIND_EPOLL = 21

// NET wait backend detection (rolling):
// - macOS: kqueue/kevent is available
// - Linux: kqueue does not exist
//
// Values:
// - -1: unknown (not detected yet)
// -  0: no kqueue backend
// -  1: has kqueue backend
var g_net_has_kqueue = -1

// Native target OS (rolling):
// - 0: unknown (should not happen after runtime init)
// - 1: macOS
// - 2: Linux
var g_target_os = 0

// Linux epoll constants (stable on Linux; unused on macOS).
// Used by syscall-first NET wait to avoid libc poll/select shims.
var OREN_EPOLL_CTL_ADD = 1
var OREN_EPOLL_CTL_DEL = 2
var OREN_EPOLL_CTL_MOD = 3
var OREN_EPOLLIN = 1
var OREN_EPOLLOUT = 4

// fcntl(2) commands used for fd duplication (stable across Darwin/Linux).
// Verified via Apple SDK headers for macOS (audit only; not a build dependency).
var FCNTL_F_DUPFD = 0
var FCNTL_F_DUPFD_CLOEXEC = 67
