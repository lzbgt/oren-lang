// --- Green entry trampoline (runs on a task stack) ---
//
// This must never return. It executes the task's target callable, then yields
// back to the scheduler.
var g_trace_green_entry_args = -1
var g_trace_green_entry_args_envp = 0
var g_trace_green_entry_args_argv = 0
var g_trace_green_entry_args_argc = 0
var g_trace_green_entry_args_guard = -1
var g_trace_green_entry_args_guard_envp = 0
var g_trace_green_entry_args_guard_argv = 0
var g_trace_green_entry_args_guard_argc = 0
var g_trace_green_entry_args_guard_light = -1
var g_trace_green_entry_args_guard_light_envp = 0
var g_trace_green_entry_args_guard_light_argv = 0
var g_trace_green_entry_args_guard_light_argc = 0
var g_trace_green_entry_args_scan = -1
var g_trace_green_entry_args_scan_envp = 0
var g_trace_green_entry_args_scan_argv = 0
var g_trace_green_entry_args_scan_argc = 0

fn _green_trace_entry_args_enabled() {
    if g_trace_green_entry_args == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_entry_args == 0 {
        if cur_envp == g_trace_green_entry_args_envp &&
           cur_argv == g_trace_green_entry_args_argv &&
           cur_argc == g_trace_green_entry_args_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_ENTRY_ARGS")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_green_entry_args == -1 || g_trace_green_entry_args == 0 {
            g_trace_green_entry_args = 0
            g_trace_green_entry_args_envp = cur_envp
            g_trace_green_entry_args_argv = cur_argv
            g_trace_green_entry_args_argc = cur_argc
        }
        return false
    }
    g_trace_green_entry_args = 1
    g_trace_green_entry_args_envp = cur_envp
    g_trace_green_entry_args_argv = cur_argv
    g_trace_green_entry_args_argc = cur_argc
    return true
}

fn _green_trace_entry_args(fn_obj, args_list) {
    if _green_trace_entry_args_enabled() != true { return 0 }
    var node = native_alloc_index_get(args_list)
    if node == 0 { node = native_alloc_index_recover_ptr(args_list) }
    var kind = 0
    if node != 0 { kind = ptr_get(iadd(node, 16)) }
    var magic = 0
    var len = 0
    var cap = 0
    var buf = 0
    if node != 0 && (kind == 2 || kind == list_int_kind()) {
        magic = ptr_get(iadd(args_list, 24))
        len = ptr_get(iadd(args_list, 0))
        cap = ptr_get(iadd(args_list, 8))
        buf = ptr_get(iadd(args_list, 16))
    }
    var small = 0
    if args_list < 4096 { small = 1 }
    print("trace: green_entry_args fn=" + oren_int_to_string(fn_obj) +
          " list=" + oren_int_to_string(args_list) +
          " node=" + oren_int_to_string(node) +
          " kind=" + oren_int_to_string(kind) +
          " magic=" + oren_int_to_string(magic) +
          " len=" + oren_int_to_string(len) +
          " cap=" + oren_int_to_string(cap) +
          " buf=" + oren_int_to_string(buf) +
          " small=" + oren_int_to_string(small))
    return 0
}

fn _green_trace_entry_args_guard_enabled() {
    if g_trace_green_entry_args_guard == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_entry_args_guard == 0 {
        if cur_envp == g_trace_green_entry_args_guard_envp &&
           cur_argv == g_trace_green_entry_args_guard_argv &&
           cur_argc == g_trace_green_entry_args_guard_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_ENTRY_ARGS_GUARD")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_green_entry_args_guard == -1 || g_trace_green_entry_args_guard == 0 {
            g_trace_green_entry_args_guard = 0
            g_trace_green_entry_args_guard_envp = cur_envp
            g_trace_green_entry_args_guard_argv = cur_argv
            g_trace_green_entry_args_guard_argc = cur_argc
        }
        return false
    }
    g_trace_green_entry_args_guard = 1
    g_trace_green_entry_args_guard_envp = cur_envp
    g_trace_green_entry_args_guard_argv = cur_argv
    g_trace_green_entry_args_guard_argc = cur_argc
    return true
}

fn _green_trace_entry_args_scan_enabled() {
    if g_trace_green_entry_args_scan == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_entry_args_scan == 0 {
        if cur_envp == g_trace_green_entry_args_scan_envp &&
           cur_argv == g_trace_green_entry_args_scan_argv &&
           cur_argc == g_trace_green_entry_args_scan_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_ENTRY_ARGS_SCAN")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_green_entry_args_scan == -1 || g_trace_green_entry_args_scan == 0 {
            g_trace_green_entry_args_scan = 0
            g_trace_green_entry_args_scan_envp = cur_envp
            g_trace_green_entry_args_scan_argv = cur_argv
            g_trace_green_entry_args_scan_argc = cur_argc
        }
        return false
    }
    g_trace_green_entry_args_scan = 1
    g_trace_green_entry_args_scan_envp = cur_envp
    g_trace_green_entry_args_scan_argv = cur_argv
    g_trace_green_entry_args_scan_argc = cur_argc
    return true
}

fn _green_trace_entry_args_guard_light_enabled() {
    if g_trace_green_entry_args_guard_light == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_entry_args_guard_light == 0 {
        if cur_envp == g_trace_green_entry_args_guard_light_envp &&
           cur_argv == g_trace_green_entry_args_guard_light_argv &&
           cur_argc == g_trace_green_entry_args_guard_light_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_ENTRY_ARGS_GUARD_LIGHT")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_green_entry_args_guard_light == -1 || g_trace_green_entry_args_guard_light == 0 {
            g_trace_green_entry_args_guard_light = 0
            g_trace_green_entry_args_guard_light_envp = cur_envp
            g_trace_green_entry_args_guard_light_argv = cur_argv
            g_trace_green_entry_args_guard_light_argc = cur_argc
        }
        return false
    }
    g_trace_green_entry_args_guard_light = 1
    g_trace_green_entry_args_guard_light_envp = cur_envp
    g_trace_green_entry_args_guard_light_argv = cur_argv
    g_trace_green_entry_args_guard_light_argc = cur_argc
    return true
}

fn _green_entry_args_guard(fn_obj, args_list) {
    if _green_trace_entry_args_guard_enabled() != true { return 0 }
    if args_list == 0 {
        print("trace: green_entry_args_guard args_list=0 fn=" + oren_int_to_string(fn_obj))
        oren_panic("green entry args_list is nil")
        return 0
    }
    if args_list < 4096 {
        print("trace: green_entry_args_guard small args_list=" + oren_int_to_string(args_list) +
              " fn=" + oren_int_to_string(fn_obj))
        oren_panic("green entry args_list is small int")
        return 0
    }
    if _green_trace_entry_args_guard_light_enabled() == true {
        print("trace: green_entry_args_guard light args_list=" + oren_int_to_string(args_list) +
              " fn=" + oren_int_to_string(fn_obj))
        return 0
    }
    var node = native_alloc_index_get(args_list)
    if node == 0 { node = native_alloc_index_recover_ptr(args_list) }
    if node == 0 {
        native_alloc_index_rebuild_live()
        node = native_alloc_index_get(args_list)
    }
    if node == 0 {
        if _green_trace_entry_args_scan_enabled() == true {
            native_alloc_index_scan_ptr_debug(args_list, 0)
        }
        print("trace: green_entry_args_guard node=0 args_list=" + oren_int_to_string(args_list) +
              " fn=" + oren_int_to_string(fn_obj))
        oren_panic("green entry args_list not tracked")
        return 0
    }
    var kind = ptr_get(iadd(node, 16))
    if kind != 2 && kind != list_int_kind() {
        print("trace: green_entry_args_guard kind=" + oren_int_to_string(kind) +
              " args_list=" + oren_int_to_string(args_list) +
              " fn=" + oren_int_to_string(fn_obj))
        oren_panic("green entry args_list not a list")
        return 0
    }
    return 0
}

@oren.keep
fn __oren_green_entry() {
    var g = _green_thread_current_g_or0()
    if g == 0 {
        // Should never happen; abort loudly in debug mode.
        sys_exit(920)
        return 0
    }
    _green_last_ops_put(6, g, 0, 0)
    var fn_obj = ptr_get(g + green_g_off_fn_obj())
    var args_list = ptr_get(g + green_g_off_args_list())
    _green_args_stamp_guard("entry", g)
    _green_entry_args_guard(fn_obj, args_list)
    _green_trace_entry_args(fn_obj, args_list)
    var ret = oren_call_obj_list(fn_obj, args_list)
    ptr_set(g + green_g_off_result(), ret)
    // IMPORTANT (worker-mode join safety):
    // Do NOT publish DONE on the task's stack.
    //
    // A host thread blocked in `oren_green_join_timeout` can wake spuriously (ulock/futex mismatch)
    // and observe the state transition without being explicitly woken, then eagerly call
    // `_green_cleanup_g(g)` which `munmap`s this green stack while we're still executing on it.
    //
    // Publish EXITING and immediately switch back to the scheduler; the scheduler finalizes DONE
    // and wakes joiners from the scheduler stack (race-free).
    ptr_set(g + green_g_off_state(), green_g_state_exiting())
    // Save stack pointer into the stack node so GC can scan this stack while paused.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, get_sp()) }
    // Switch back to scheduler.
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { sys_exit(921); return 0 }
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(ctx_g, sched_ctx)
    // If resumed, hard exit (bug).
    sys_exit(905)
    return 0
}
