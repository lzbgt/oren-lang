// --- Optional background scheduler workers (Stage N2 groundwork) ---
var g_trace_green_spawn_alloc_stride = 1
var g_trace_green_spawn_alloc_stride_envp = 0
var g_trace_green_spawn_alloc_stride_argv = 0
var g_trace_green_spawn_alloc_stride_argc = 0
var g_trace_green_spawn_alloc_count = 0
var g_trace_green_spawn_alloc_guard = -1
var g_trace_green_spawn_alloc_guard_envp = 0
var g_trace_green_spawn_alloc_guard_argv = 0
var g_trace_green_spawn_alloc_guard_argc = 0
var g_trace_green_spawn_ring = -1
var g_trace_green_spawn_ring_cap = 0
var g_trace_green_spawn_ring_ptr = 0
var g_trace_green_spawn_ring_head = 0
var g_trace_green_spawn_ring_envp = 0
var g_trace_green_spawn_ring_argv = 0
var g_trace_green_spawn_ring_argc = 0

fn _green_trace_spawn_alloc_stride_value() {
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_spawn_alloc_stride_envp == cur_envp &&
       g_trace_green_spawn_alloc_stride_argv == cur_argv &&
       g_trace_green_spawn_alloc_stride_argc == cur_argc {
        return g_trace_green_spawn_alloc_stride
    }
    var stride = 1
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_SPAWN_ALLOC_STRIDE")
    if v != 0 && ptr_get_byte(v) != 0 && ptr_get_byte(v) != 48 {
        var parsed = oren_int_from_string(v)
        if parsed > 0 { stride = parsed }
    }
    g_trace_green_spawn_alloc_stride = stride
    g_trace_green_spawn_alloc_stride_envp = cur_envp
    g_trace_green_spawn_alloc_stride_argv = cur_argv
    g_trace_green_spawn_alloc_stride_argc = cur_argc
    return stride
}

fn _green_trace_spawn_alloc_guard_enabled() {
    if g_trace_green_spawn_alloc_guard == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_spawn_alloc_guard == 0 {
        if cur_envp == g_trace_green_spawn_alloc_guard_envp &&
           cur_argv == g_trace_green_spawn_alloc_guard_argv &&
           cur_argc == g_trace_green_spawn_alloc_guard_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_SPAWN_ALLOC_GUARD")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_green_spawn_alloc_guard == -1 || g_trace_green_spawn_alloc_guard == 0 {
            g_trace_green_spawn_alloc_guard = 0
            g_trace_green_spawn_alloc_guard_envp = cur_envp
            g_trace_green_spawn_alloc_guard_argv = cur_argv
            g_trace_green_spawn_alloc_guard_argc = cur_argc
        }
        return false
    }
    g_trace_green_spawn_alloc_guard = 1
    g_trace_green_spawn_alloc_guard_envp = cur_envp
    g_trace_green_spawn_alloc_guard_argv = cur_argv
    g_trace_green_spawn_alloc_guard_argc = cur_argc
    return true
}

fn _green_spawn_ring_enabled() {
    if g_trace_green_spawn_ring == 1 && g_trace_green_spawn_ring_ptr != 0 {
        return true
    }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_spawn_ring == 0 {
        if cur_envp == g_trace_green_spawn_ring_envp &&
           cur_argv == g_trace_green_spawn_ring_argv &&
           cur_argc == g_trace_green_spawn_ring_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_SPAWN_RING")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_green_spawn_ring == -1 || g_trace_green_spawn_ring == 0 {
            g_trace_green_spawn_ring = 0
            g_trace_green_spawn_ring_envp = cur_envp
            g_trace_green_spawn_ring_argv = cur_argv
            g_trace_green_spawn_ring_argc = cur_argc
        }
        return false
    }
    g_trace_green_spawn_ring = 1
    g_trace_green_spawn_ring_envp = cur_envp
    g_trace_green_spawn_ring_argv = cur_argv
    g_trace_green_spawn_ring_argc = cur_argc
    if g_trace_green_spawn_ring_cap <= 0 { g_trace_green_spawn_ring_cap = 128 }
    var v_cap = native_envp_get_value_ptr("OREN_TRACE_GREEN_SPAWN_RING_CAP")
    if v_cap != 0 && ptr_get_byte(v_cap) != 0 && ptr_get_byte(v_cap) != 48 {
        var parsed = oren_int_from_string(v_cap)
        if parsed > 0 { g_trace_green_spawn_ring_cap = parsed }
    }
    if g_trace_green_spawn_ring_ptr == 0 && g_trace_green_spawn_ring_cap > 0 {
        var bytes = g_trace_green_spawn_ring_cap * 64
        var buf = native_malloc_raw_or_mmap(bytes)
        if buf == 0 || buf == -1 {
            g_trace_green_spawn_ring = 0
            return false
        }
        var slots = g_trace_green_spawn_ring_cap * 8
        var i = 0
        while i < slots {
            ptr_set(iadd(buf, i * 8), 0)
            i = i + 1
        }
        g_trace_green_spawn_ring_ptr = buf
        g_trace_green_spawn_ring_head = 0
    }
    if g_trace_green_spawn_ring_ptr == 0 || g_trace_green_spawn_ring_cap <= 0 {
        g_trace_green_spawn_ring = 0
        return false
    }
    return true
}

fn _green_spawn_ring_put(args_list, fn_obj, node, kind, len, cap, buf, magic) {
    if _green_spawn_ring_enabled() != true { return 0 }
    var capn = g_trace_green_spawn_ring_cap
    if capn <= 0 { return 0 }
    var base = g_trace_green_spawn_ring_ptr
    if base == 0 { return 0 }
    var idx = g_trace_green_spawn_ring_head % capn
    var off = idx * 64
    ptr_set(iadd(base, off), args_list)
    ptr_set(iadd(base, off + 8), fn_obj)
    ptr_set(iadd(base, off + 16), node)
    ptr_set(iadd(base, off + 24), kind)
    ptr_set(iadd(base, off + 32), len)
    ptr_set(iadd(base, off + 40), cap)
    ptr_set(iadd(base, off + 48), buf)
    ptr_set(iadd(base, off + 56), magic)
    g_trace_green_spawn_ring_head = g_trace_green_spawn_ring_head + 1
    return 0
}

fn _green_spawn_ring_dump_last(limit, reason) {
    if _green_spawn_ring_enabled() != true { return 0 }
    var capn = g_trace_green_spawn_ring_cap
    if capn <= 0 { return 0 }
    var base = g_trace_green_spawn_ring_ptr
    if base == 0 { return 0 }
    if limit <= 0 { limit = 32 }
    if limit > capn { limit = capn }
    print("[green_spawn_ring_dump] reason=" + reason +
          " head=" + oren_int_to_string(g_trace_green_spawn_ring_head) +
          " cap=" + oren_int_to_string(capn))
    var head = g_trace_green_spawn_ring_head
    var step = 0
    while step < limit {
        var pos = head - 1 - step
        if pos < 0 { pos = pos + capn }
        if pos < 0 { break }
        var idx = pos % capn
        var off = idx * 64
        var args_list = ptr_get(iadd(base, off))
        var fn_obj = ptr_get(iadd(base, off + 8))
        var node = ptr_get(iadd(base, off + 16))
        if args_list != 0 || fn_obj != 0 || node != 0 {
            var kind = ptr_get(iadd(base, off + 24))
            var len = ptr_get(iadd(base, off + 32))
            var cap = ptr_get(iadd(base, off + 40))
            var buf = ptr_get(iadd(base, off + 48))
            var magic = ptr_get(iadd(base, off + 56))
            print("[green_spawn_ring] idx=" + oren_int_to_string(idx) +
                  " age=" + oren_int_to_string(step) +
                  " args_list=" + oren_int_to_string(args_list) +
                  " fn=" + oren_int_to_string(fn_obj) +
                  " node=" + oren_int_to_string(node) +
                  " kind=" + oren_int_to_string(kind) +
                  " len=" + oren_int_to_string(len) +
                  " cap=" + oren_int_to_string(cap) +
                  " buf=" + oren_int_to_string(buf) +
                  " magic=" + oren_int_to_string(magic))
        }
        step = step + 1
    }
    return 0
}

@oren.keep
fn oren_green_start_workers(n) {
    _green_init_if_needed()
    if _green_enabled() != true { return -1 }
    if n <= 0 { return -1 }
    if n > 64 { n = 64 }
    // Rolling safety:
    // The native heap/GC model is not concurrency-correct yet. Multiple background workers
    // can execute green tasks concurrently on multiple OS threads, which is unsafe until:
    // - the allocator is made thread-safe (or allocation is mediated by a world lock), AND
    // - GC safepoints/roots are well-defined across threads.
    //
    // Default to 1 worker (still useful: join can block on addr while the worker drains the scheduler).
    // Opt-in for experimentation only.
    if n > 1 {
        var v = native_envp_get_value_ptr("OREN_GREEN_WORKERS_UNSAFE_PARALLEL")
        var unsafe_ok = 0
        if v != 0 && ptr_get_byte(v) != 0 && ptr_get_byte(v) != 48 { unsafe_ok = 1 }

        // Safe experimentation mode: allow multiple workers only if a world-lock is enabled.
        // This keeps allocator/GC correctness bounded while exercising the scheduler topology.
        var wl_ok = g_green_world_lock_enabled
        var vw = native_envp_get_value_ptr("OREN_GREEN_WORKERS_WORLD_LOCK")
        if vw != 0 && ptr_get_byte(vw) != 0 && ptr_get_byte(vw) != 48 { wl_ok = 1 }

        if unsafe_ok == 0 && wl_ok != 0 {
            // Ensure the world lock is actually initialized/enabled (env can request it).
            if g_green_world_lock_word == 0 {
                var w = sys_mmap_private_anon(4096)
                if w == 0 || w == -1 || w < 4096 { exit(938) }
                ptr_set(w, 0)
                g_green_world_lock_word = w
            }
            g_green_world_lock_enabled = 1
        }

        if unsafe_ok == 0 && wl_ok == 0 {
            n = 1
        }
    }
    if g_green_workers_started != 0 { return 0 }

    // Rolling safety: do not enable background workers while currently executing on a green stack.
    // A worker could start draining the scheduler concurrently with this OS thread, which is not
    // concurrency-safe until allocator/GC are made multi-thread correct.
    var ts_pre = _green_thread_state_for_current_thread_or0()
    if ts_pre != 0 && ptr_get(ts_pre + green_t_off_current_g()) != 0 { return -1 }

	    var s = _green_get_state()
	    if s == 0 { return -1 }

    // Ensure we have enough P objects reachable from the scheduler root.
    //
    // Notes (rolling, GMP-ready):
    // - The scheduler supports a basic global runq + bounded under-lock work stealing (see `010_green_core.oren`),
    //   so runnable work can migrate across Ps in worker mode.
    // - Spawns from inside a running G still prefer the current P for locality; overflow goes to the global runq.
    if n > 1 {
        _green_lock_acquire()
        var cur_count = _green_state_p_count(s)
        if cur_count < n {
            var tail = _green_state_p0(s)
            if tail == 0 { _green_lock_release(); return -1 }
            while _green_p_next(tail) != 0 {
                tail = _green_p_next(tail)
            }
            var id = cur_count
	            while id < n {
	                var p = _green_alloc_struct(green_p_bytes())
	                if p == 0 { exit(925) }
	                var runq_mask = _green_p_runq_mask_default()
	                var runq_buf = _green_alloc_struct((runq_mask + 1) * 8)
	                if runq_buf == 0 { exit(935) }
                var j = 0
	                while j <= runq_mask {
	                    ptr_set(runq_buf + j * 8, 0)
	                    j = j + 1
	                }
	                _green_retag_struct(runq_buf, (runq_mask + 1) * 8)
	                _green_p_set_runq_buf(p, runq_buf)
	                _green_p_set_runq_head(p, 0)
	                _green_p_set_runq_tail(p, 0)
	                _green_p_set_runq_mask(p, runq_mask)
	                _green_p_set_sleep_head(p, 0)
	                _green_p_set_sleep_tail(p, 0)
	                ptr_set(p + green_p_off_id(), id)
	                _green_p_set_next(p, 0)
	                _green_p_set_owner_tid(p, 0)
	                _green_p_set_idle_next(p, 0)
	                _green_retag_struct(p, green_p_bytes())
	                _green_idle_p_push_locked(s, p)
	                _green_p_set_next(tail, p)
	                tail = p
	                id = id + 1
	            }
            _green_state_set_p_count(s, n)
        }
        _green_lock_release()
    }

    // Reserve each P for its intended worker before any ownership assertions run.
    // This prevents any non-worker OS thread from accidentally "claiming" a worker P during bring-up.
    //
    // Stage N3 direction (M<P): reserve only Ps that correspond to real workers.
    // Extra Ps must remain free (owner_tid==0) so workers can acquire them later.
    _green_lock_acquire()
    var p_res = _green_state_p0(s)
	    while p_res != 0 {
	        var owner0 = _green_p_owner_tid(p_res)
	        // Rolling safety: fail early if a host thread already claimed any P.
	        // Otherwise worker entry will hard-fail when it tries to claim its reserved P.
	        if owner0 != 0 { _green_lock_release(); return -1 }
	        if _green_p_id(p_res) < n {
	            _green_idle_p_remove_locked(s, p_res)
	            _green_p_set_owner_tid(p_res, _green_p_owner_reserved_tid(p_res))
	        }
	        p_res = _green_p_next(p_res)
	    }
    _green_lock_release()

    // Allocate the wake/park word page (one page; u64 slots).
    // Worker `i` parks on `g_green_worker_wake_word + i*8`.
    if g_green_worker_wake_word == 0 {
        var word = sys_mmap_private_anon(4096)
        if word == 0 || word == -1 || word < 4096 { exit(922) }
        g_green_worker_wake_word = word
    }
    // Allocate the worker tid table page (one page; u64 slots indexed by worker id).
    if g_green_worker_tid_word == 0 {
        var tword = sys_mmap_private_anon(4096)
        if tword == 0 || tword == -1 || tword < 4096 { exit(941) }
        g_green_worker_tid_word = tword
    }
    // Clear wake/tid slots for the workers we're about to start (stabilizes fixtures).
    var i0 = 0
    while i0 < n {
        ptr_set(g_green_worker_wake_word + i0 * 8, 0)
        ptr_set(g_green_worker_tid_word + i0 * 8, 0)
        i0 = i0 + 1
    }

    // Publish worker mode *before* spawning OS threads so worker entry sees consistent state.
    // (Without this, a worker could start running and treat itself as "host mode" briefly.)
    g_green_worker_count = n
    if g_green_workers_ready_word != 0 && g_green_workers_ready_word != -1 && g_green_workers_ready_word >= 4096 {
        ptr_set(g_green_workers_ready_word, 0)
    }
    g_green_workers_started = 1

    // Spawn N background workers. These threads run forever; they are intentionally not joined.
    var start_addr = oren_code_addr(__oren_green_worker_entry)
    if start_addr == 0 { exit(923) }

    var i = 0
    while i < n {
        var p = _green_state_p_by_id_or0(s, i)
        if p == 0 { p = _green_state_p0(s) }
        var h = oren_os_thread_spawn(start_addr, p)
        if h == 0 || h == -1 || h < 0 { exit(924) }
        i = i + 1
    }
    // Best-effort: wait briefly for workers to reach the scheduler loop (stabilizes fixtures).
    // Keep bounded so start_workers stays fast, but allow more headroom on slow hosts (qemu).
    var tries = 0
    while tries < 500 {
        if g_green_workers_ready_word != 0 && g_green_workers_ready_word != -1 && g_green_workers_ready_word >= 4096 {
            if ptr_get(g_green_workers_ready_word) >= n { break }
        }
        // Stay STW-friendly while waiting for worker bring-up.
        oren_gc_safepoint()
        if g_green_workers_ready_word != 0 && g_green_workers_ready_word != -1 && g_green_workers_ready_word >= 4096 {
            var cur = ptr_get(g_green_workers_ready_word)
            oren_wait_on_addr(g_green_workers_ready_word, cur, 1000) // 1ms
        } else {
            sys_nanosleep(1000000) // 1ms
        }
        tries = tries + 1
    }
    // Wake all workers so they immediately start draining runq/sleepq.
    _green_workers_wake_if_started()
    return 0
}

@oren.keep
fn __oren_green_worker_entry(arg_ptr) {
    // Ensure this OS thread is registered very early so:
    // - GC stack scanning has a stable "top" bound for future deep calls
    // - STW GC accounting sees this OS thread
    oren_register_thread(get_sp())

    _green_init_if_needed()
    if _green_enabled() != true { return 0 }
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }

    // Bind this M to a P (rolling).
    var p0 = 0
    if arg_ptr != 0 && arg_ptr >= 4096 { p0 = arg_ptr }
    if p0 == 0 {
        var s = _green_get_state()
        if s != 0 { p0 = _green_state_p0(s) }
    }
    if p0 != 0 { _green_thread_set_p(ts, p0) }
    // Record the reserved worker id for this OS thread (used for per-worker wake slots and fixtures).
    // Convention: worker_id == reserved P id.
    var worker_id = 0
    if p0 != 0 {
        worker_id = _green_p_id(p0)
        if worker_id < 0 || worker_id >= 64 { worker_id = 0 }
    }
    _green_thread_set_worker_id(ts, worker_id)
    // Claim initial P ownership for this M (must succeed before running).
    var tid = sys_gettid()
    if tid == 0 { exit(928) }
    // Publish worker tid for fixtures (best-effort).
    if g_green_worker_tid_word != 0 && g_green_worker_tid_word != -1 && g_green_worker_tid_word >= 4096 {
        ptr_set(g_green_worker_tid_word + worker_id * 8, tid)
    }
    if p0 != 0 {
        var s0 = _green_get_state()
        if s0 == 0 { exit(929) }
        _green_lock_acquire()
        var rc_own = _green_p_ensure_owned_by_tid_locked(s0, p0, tid)
        _green_lock_release()
        if rc_own != 0 { exit(929) }
    }

    // Signal "ready" once per worker after it can safely run scheduler code.
    // This is used only by fixtures to stabilize bring-up sequencing.
    _green_atomic_inc_u64(g_green_workers_ready_word)

    while true {
        // STW GC robustness: if a collector requests stop-the-world, park here on the scheduler stack.
        // (Without this, a worker parked in the kernel could prevent `oren_gc_collect()` from observing all threads parked.)
        oren_gc_safepoint()

        // Run until idle (no runnable tasks and no sleepers).
        _green_poll_until(0)
        // Park strategy (Stage N2 robustness):
        // - Prefer parking on the wake word (efficient for runq injections).
        // - If there are sleeping tasks, park *with a timeout* so timers are driven even when
        //   no external wake arrives.
        //
        // This makes worker-mode sleepers reliable even if `_green_poll_until(0)` returns early.
        // Release P while parked idle (future-proof for M<P).
        var ts2 = _green_thread_state_for_current_thread_or0()
        var p2 = 0
        if ts2 != 0 { p2 = _green_thread_p_or0(ts2) }
        if p2 != 0 {
            var s2 = _green_get_state()
            _green_lock_acquire()
            _green_p_release_if_owned_by_tid_locked(s2, p2, tid)
            // Allow M<P: when this worker wakes, it must acquire any idle P before running Oren code.
            _green_thread_set_p(ts2, 0)
            _green_lock_release()
        }

        var next_wake = _green_next_wake_ns_all()
        if next_wake != 0 {
            var now = _green_time_now_ns()
            if now != 0 {
                var sleep_ns = next_wake - now
                if sleep_ns < 0 { sleep_ns = 0 }
                var sleep_us = sleep_ns / 1000
                if sleep_us <= 0 { sleep_us = 1 }
                if sleep_us > 10000 { sleep_us = 10000 } // cap to 10ms for responsiveness

                if g_green_worker_wake_word != 0 {
                    var wptr = g_green_worker_wake_word + worker_id * 8
                    oren_m_park_word_wait(wptr, sleep_us)
                } else {
                    sys_nanosleep(sleep_us * 1000)
                }
                continue
            }
        }

        // No sleepers (or no clock): park until someone posts a wake token.
        // IMPORTANT (STW GC): do not park indefinitely; use a bounded timeout so we can observe STW requests.
        if g_green_worker_wake_word != 0 {
            var park_us = _green_worker_idle_park_us()
            if park_us <= 0 { park_us = 10000 }
            var wptr2 = g_green_worker_wake_word + worker_id * 8
            oren_m_park_word_wait(wptr2, park_us)
        } else {
            // Fallback: avoid busy spin if wake word isn't initialized.
            sys_nanosleep(1000000) // 1ms
        }
    }
    return 0
}

fn _green_ensure_p_count_locked(s, want_count) {
    if s == 0 { return -1 }
    if want_count <= 0 { return -1 }
    if want_count > 64 { want_count = 64 }

    var cur_count = _green_state_p_count(s)
    if cur_count >= want_count { return 0 }

    var tail = _green_state_p0(s)
    if tail == 0 { return -1 }
    while _green_p_next(tail) != 0 {
        tail = _green_p_next(tail)
    }

    var id = cur_count
    while id < want_count {
        var p = _green_alloc_struct(green_p_bytes())
        if p == 0 { exit(925) }
        var runq_mask = _green_p_runq_mask_default()
        var runq_buf = _green_alloc_struct((runq_mask + 1) * 8)
        if runq_buf == 0 { exit(935) }
        var j = 0
        while j <= runq_mask {
            ptr_set(runq_buf + j * 8, 0)
            j = j + 1
        }
        _green_retag_struct(runq_buf, (runq_mask + 1) * 8)
        _green_p_set_runq_buf(p, runq_buf)
        _green_p_set_runq_head(p, 0)
        _green_p_set_runq_tail(p, 0)
        _green_p_set_runq_mask(p, runq_mask)
        _green_p_set_sleep_head(p, 0)
	        _green_p_set_sleep_tail(p, 0)
        ptr_set(p + green_p_off_id(), id)
        _green_p_set_next(p, 0)
        _green_p_set_owner_tid(p, 0)
        _green_p_set_idle_next(p, 0)
        _green_retag_struct(p, green_p_bytes())
        _green_idle_p_push_locked(s, p)
        _green_p_set_next(tail, p)
        tail = p
        id = id + 1
	    }
    _green_state_set_p_count(s, want_count)
    return 0
}

@oren.keep
fn oren_green_set_p_count(n) {
    _green_init_if_needed()
    if _green_enabled() != true { return -1 }
    if n <= 0 { return -1 }
    if n > 64 { n = 64 }
    // Rolling safety: do not allow changing P count once background workers are started.
    // (Future: allow grow + spawn additional Ms.)
    if g_green_workers_started != 0 { return -1 }

    // Must not run from inside a green task: we mutate scheduler topology.
    var ts = _green_thread_state_for_current_thread_or0()
    if ts != 0 && ptr_get(ts + green_t_off_current_g()) != 0 { return -1 }

    var s = _green_get_state()
    if s == 0 { return -1 }

    _green_lock_acquire()
    var rc = _green_ensure_p_count_locked(s, n)
    _green_lock_release()
    return rc
}

