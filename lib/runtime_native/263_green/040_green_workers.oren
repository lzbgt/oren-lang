    if _green_enabled() != true { return 0 - 1 }
    var p = _green_current_p_or0()
    if p == 0 { return 0 - 1 }
    if p < 4096 { return 0 - 1 }
    return _green_p_id(p)
}

@oren.keep
fn oren_green_poll_until(deadline_ns) {
    // Host-thread scheduler drive hook (rolling; Stage N3 bring-up).
    //
    // This is intentionally low-level and currently used by fixtures to validate
    // multi-P behavior without enabling unsafe parallel workers.
    _green_init_if_needed()
    if _green_enabled() != true { return -1 }

    // Must not be called from inside a green task (it would clobber scheduler invariants).
    var ts = _green_thread_state_for_current_thread_or0()
    if ts != 0 && ptr_get(ts + green_t_off_current_g()) != 0 { return -1 }

    // Worker-mode: background workers drive the scheduler loop; do not also drive it on the host.
    if g_green_workers_started != 0 { return -1 }

    _green_poll_until_budget(deadline_ns, 0)
    return 0
}

@oren.keep
fn oren_green_poll_steps(max_steps) {
    // Host-thread bounded scheduler drive hook (rolling; Stage N3 bring-up).
    //
    // Runs at most `max_steps` green task context switches, then returns even if
    // runnable tasks remain. Used by single-thread multi-P fixtures.
    if max_steps <= 0 { return 0 }
    _green_init_if_needed()
    if _green_enabled() != true { return -1 }

    var ts = _green_thread_state_for_current_thread_or0()
    if ts != 0 && ptr_get(ts + green_t_off_current_g()) != 0 { return -1 }
    if g_green_workers_started != 0 { return -1 }

    _green_poll_until_budget(0, max_steps)
    return 0
}

// Public hooks used by spawn/join/sleep/yield.
@oren.keep
fn oren_green_current_g_or0() {
    // Fast path: if green runtime was never initialized, we are not inside a green task.
    // Avoid allocating per-thread green scheduler state from unrelated runtime calls like `oren_yield()`.
    if g_green_inited == 0 { return 0 }
    if _green_enabled() != true { return 0 }
    return _green_thread_current_g_or0()
}

@oren.keep
fn oren_green_is_g(ptr) {
    return _green_is_g(ptr)
}

@oren.keep
fn oren_green_is_done(ptr) {
    if _green_is_g(ptr) != true { return false }
    return ptr_get(ptr + green_g_off_state()) == green_g_state_done()
}

fn _green_spawn_alloc_g(fn_obj, args_list) {
    // Allocate a runnable G with its own stack/context, but do not enqueue it.
    _green_init_if_needed()
    if _green_enabled() != true { return 0 }

    var stack_bytes = _green_alloc_stack_bytes()
    var base = sys_mmap_private_anon(stack_bytes)
    if base == 0 || base == -1 || base < 4096 { exit(906) }
    var top = base + stack_bytes
    // Keep stack aligned for ABI rules. Leave a small redzone.
    top = top - 32
    // Avoid relying on negative immediate masks: `(0 - 16)` can be mishandled by rolling
    // native backends when lowering wide immediates. Align down via arithmetic instead.
    top = (top / 16) * 16
    @cfg(arch="x64") top = top - 8 // ctx_switch resumes via `ret`, so rsp+8 must be 16-byte aligned

    var ctx_ptr = sys_mmap_private_anon(green_ctx_bytes())
    if ctx_ptr == 0 || ctx_ptr == -1 || ctx_ptr < 4096 { exit(907) }

    // Create a stack node for GC scanning while this task is parked.
    var node = oren_register_stack(top + 32)
    if node == 0 { exit(908) }

    // Build task object (GC-managed struct so fn_obj/args_list are visible to GC).
    var g = _green_alloc_struct(green_g_bytes())
    if g == 0 { exit(909) }
    ptr_set(g + green_g_off_magic(), green_g_magic())
    ptr_set(g + green_g_off_ctx(), ctx_ptr)
    ptr_set(g + green_g_off_stack_base(), base)
    ptr_set(g + green_g_off_stack_size(), stack_bytes)
    ptr_set(g + green_g_off_stack_top(), top + 32)
    ptr_set(g + green_g_off_stack_node(), node)
    ptr_set(g + green_g_off_fn_obj(), fn_obj)
    ptr_set(g + green_g_off_args_list(), args_list)
    ptr_set(g + green_g_off_result(), 0)
    ptr_set(g + green_g_off_state(), green_g_state_runnable())
    ptr_set(g + green_g_off_wake_ns(), 0)
    ptr_set(g + green_g_off_detached(), 0)
    ptr_set(g + green_g_off_next(), 0)
    ptr_set(g + green_g_off_io_fd(), 0)
    ptr_set(g + green_g_off_io_kind(), 0)
    ptr_set(g + green_g_off_io_ready(), 0)
    ptr_set(g + green_g_off_io_active(), 0)
    ptr_set(g + green_g_off_io_epoch(), 0)
    ptr_set(g + green_g_off_word_wait_addr(), 0)
    ptr_set(g + green_g_off_word_wait_expected(), 0)
    ptr_set(g + green_g_off_word_wait_rc(), 0)
    ptr_set(g + green_g_off_args_stamp_ptr(), 0)
    ptr_set(g + green_g_off_args_stamp_len(), 0)
    ptr_set(g + green_g_off_args_stamp_cap(), 0)
    ptr_set(g + green_g_off_args_stamp_buf(), 0)
    ptr_set(g + green_g_off_args_stamp_magic(), 0)
    _green_retag_struct(g, green_g_bytes())
    var guard_on = _green_trace_spawn_alloc_guard_enabled()
    var stamp_on = _green_trace_args_stamp_enabled()
    var ring_on = _green_spawn_ring_enabled()
    var node_guard = 0
    if guard_on == true || stamp_on == true || ring_on == true {
        node_guard = _green_args_list_node(args_list, 1)
        if guard_on == true && node_guard == 0 {
            print("trace: green_spawn_alloc args_list untracked args=" +
                  oren_int_to_string(args_list) +
                  " fn=" + oren_int_to_string(fn_obj))
            if args_list != 0 && args_list >= 4096 {
                var raw_len = ptr_get(iadd(args_list, 0))
                var raw_cap = ptr_get(iadd(args_list, 8))
                var raw_buf = ptr_get(iadd(args_list, 16))
                var raw_magic = ptr_get(iadd(args_list, 24))
                print("trace: green_spawn_alloc args_list raw len=" +
                      oren_int_to_string(raw_len) +
                      " cap=" + oren_int_to_string(raw_cap) +
                      " buf=" + oren_int_to_string(raw_buf) +
                      " magic=" + oren_int_to_string(raw_magic))
                native_list_debug_node(args_list)
                _list_trace_dump(args_list)
            }
            _green_spawn_ring_dump_last(32, "spawn_alloc_untracked")
            oren_panic("green spawn_alloc: args_list untracked")
            return 0
        }
    }
    var kind = 0
    var magic = 0
    var len = 0
    var cap = 0
    var buf = 0
    if stamp_on == true || ring_on == true {
        if args_list != 0 && args_list >= 4096 {
            len = ptr_get(iadd(args_list, 0))
            cap = ptr_get(iadd(args_list, 8))
            buf = ptr_get(iadd(args_list, 16))
            magic = ptr_get(iadd(args_list, 24))
        }
        if node_guard != 0 { kind = ptr_get(iadd(node_guard, 16)) }
        if ring_on == true {
            _green_spawn_ring_put(args_list, fn_obj, node_guard, kind, len, cap, buf, magic)
        }
    }
    if stamp_on == true {
        var stride = _green_trace_spawn_alloc_stride_value()
        var log_it = 1
        if stride > 1 {
            g_trace_green_spawn_alloc_count = g_trace_green_spawn_alloc_count + 1
            if (g_trace_green_spawn_alloc_count % stride) != 0 { log_it = 0 }
        }
        if log_it != 0 {
            print("trace: green_spawn_alloc args_list=" + oren_int_to_string(args_list) +
                  " node=" + oren_int_to_string(node_guard) +
                  " kind=" + oren_int_to_string(kind) +
                  " len=" + oren_int_to_string(len) +
                  " cap=" + oren_int_to_string(cap) +
                  " buf=" + oren_int_to_string(buf) +
                  " magic=" + oren_int_to_string(magic))
        }
    }
    _green_args_stamp_set("spawn_alloc", g)
    _green_runq_guard("spawn_alloc", g)

    // Initialize context to start at __oren_green_entry on the new stack.
    var entry_pc = oren_code_addr(__oren_green_entry)
    oren_ctx_init(ctx_ptr, top, entry_pc)
    return g
}

@oren.keep
fn oren_green_spawn(fn_obj, args_list) {
    var root_count = 0
    if fn_obj != 0 {
        native_gc_root_push(fn_obj)
        root_count = root_count + 1
    }
    if args_list != 0 {
        // Keep host-side spawn arguments visible across the world-lock/alloc path even if the
        // only live references are transient locals/registers on the spawning thread.
        native_gc_root_push(args_list)
        root_count = root_count + 1
    }
    if _green_trace_args_stamp_enabled() == true {
        var node = _green_args_list_node(args_list, 1)
        var kind = 0
        var magic = 0
        var len = 0
        var cap = 0
        var buf = 0
        if args_list != 0 && args_list >= 4096 {
            len = ptr_get(iadd(args_list, 0))
            cap = ptr_get(iadd(args_list, 8))
            buf = ptr_get(iadd(args_list, 16))
            magic = ptr_get(iadd(args_list, 24))
        }
        if node != 0 { kind = ptr_get(iadd(node, 16)) }
        print("trace: green_spawn args_list=" + oren_int_to_string(args_list) +
              " node=" + oren_int_to_string(node) +
              " kind=" + oren_int_to_string(kind) +
              " len=" + oren_int_to_string(len) +
              " cap=" + oren_int_to_string(cap) +
              " buf=" + oren_int_to_string(buf) +
              " magic=" + oren_int_to_string(magic))
    }
    var wl = _green_world_lock_host_enter()
    if _green_trace_args_stamp_enabled() == true {
        var node2 = _green_args_list_node(args_list, 1)
        var kind2 = 0
        var magic2 = 0
        var len2 = 0
        var cap2 = 0
        var buf2 = 0
        if args_list != 0 && args_list >= 4096 {
            len2 = ptr_get(iadd(args_list, 0))
            cap2 = ptr_get(iadd(args_list, 8))
            buf2 = ptr_get(iadd(args_list, 16))
            magic2 = ptr_get(iadd(args_list, 24))
        }
        if node2 != 0 { kind2 = ptr_get(iadd(node2, 16)) }
        print("trace: green_spawn wl args_list=" + oren_int_to_string(args_list) +
              " node=" + oren_int_to_string(node2) +
              " kind=" + oren_int_to_string(kind2) +
              " len=" + oren_int_to_string(len2) +
              " cap=" + oren_int_to_string(cap2) +
              " buf=" + oren_int_to_string(buf2) +
              " magic=" + oren_int_to_string(magic2))
    }
    var g = _green_spawn_alloc_g(fn_obj, args_list)
    if g == 0 {
        _green_world_lock_host_exit(wl)
        native_gc_root_pop(root_count)
        return 0
    }

    // Spawning policy (rolling, GMP-ready):
    // - If we're currently inside a green task, enqueue locally to the current P (locality).
    // - Otherwise, enqueue into the global run queue so any worker P can pick it up (cross-P injection).
    var ts = _green_thread_state_for_current_thread_or0()
    var cur_g = 0
    if ts != 0 { cur_g = ptr_get(ts + green_t_off_current_g()) }
    if cur_g != 0 {
        _green_runq_push(g)
    } else {
        _green_global_runq_push(g)
    }
    _green_world_lock_host_exit(wl)
    native_gc_root_pop(root_count)
    return g
}

@oren.keep
fn oren_green_debug_spawn_call_list_to_p(p_id, fn_obj, args_list) {
    // Fixture helper: allocate a runnable G and enqueue it into a specific P's local runq.
    //
    // This enables deterministic worker scheduling tests by:
    // - preparing runnable work while workers are parked, and
    // - explicitly waking a chosen worker via `oren_green_debug_wake_worker(worker_id)`.
    //
    // Notes:
    // - This does NOT auto-wake workers. Caller must wake explicitly.
    // - Must not be called in-green.
    if p_id < 0 { return 0 }
    if p_id >= 64 { return 0 }
    var ts0 = _green_thread_state_for_current_thread_or0()
    if ts0 != 0 && ptr_get(ts0 + green_t_off_current_g()) != 0 { return 0 }

    var root_count = 0
    if fn_obj != 0 {
        native_gc_root_push(fn_obj)
        root_count = root_count + 1
    }
    if args_list != 0 {
        native_gc_root_push(args_list)
        root_count = root_count + 1
    }
    var wl = _green_world_lock_host_enter()
    var g = _green_spawn_alloc_g(fn_obj, args_list)
    if g == 0 {
        _green_world_lock_host_exit(wl)
        native_gc_root_pop(root_count)
        return 0
    }

    var s = _green_get_state()
    if s == 0 {
        _green_world_lock_host_exit(wl)
        native_gc_root_pop(root_count)
        return 0
    }
    _green_lock_acquire()
    var p = _green_state_p_by_id_or0(s, p_id)
    if p == 0 { p = _green_state_p0(s) }
    if p != 0 {
        _green_runq_push_locked(p, s, g)
    }
    _green_lock_release()
    _green_world_lock_host_exit(wl)
    native_gc_root_pop(root_count)
    return g
}

@oren.keep
fn oren_green_join_timeout(g, timeout_ms) {
    if g == 0 { return 0 }
    if _green_is_g(g) != true { return -1 }
    _green_init_if_needed()
    if _green_enabled() != true { return -1 }

    var st = ptr_get(g + green_g_off_state())
    if st == green_g_state_done() {
        var r0 = ptr_get(g + green_g_off_result())
        _green_cleanup_g(g)
        return r0
    }

    var t = timeout_ms
    var in_green = false
    if _green_thread_current_g_or0() != 0 { in_green = true }

    // timeout_ms < 0 => wait forever
    if t < 0 {
        if in_green {
            while ptr_get(g + green_g_off_state()) != green_g_state_done() {
                // Cooperative wait: yield so the scheduler can run other tasks.
                oren_green_yield()
            }
            var r = ptr_get(g + green_g_off_result())
            _green_cleanup_g(g)
            return r
        }

	        // Stage N2 worker mode: the scheduler runs on background OS threads; join blocks on addr.
        if g_green_workers_started != 0 {
            var state_ptr = g + green_g_off_state()
            while true {
                var wl0 = _green_world_lock_host_enter()
                var cur = ptr_get(state_ptr)
                if cur == green_g_state_done() {
                    _green_world_lock_host_exit(wl0)
                    break
                }
                _green_world_lock_host_exit(wl0)
                // STW GC robustness:
                // A host-thread joiner is still an OS thread that must be able to reach safepoints.
                // Avoid sleeping forever in a kernel wait here.
                oren_gc_safepoint()
                var rcw = oren_wait_on_addr(state_ptr, cur, 10000) // 10ms
                if rcw != 0 && rcw != -60 { return rcw }
            }
            var wl1 = _green_world_lock_host_enter()
            var r2 = ptr_get(g + green_g_off_result())
            _green_cleanup_g(g)
            _green_world_lock_host_exit(wl1)
            return r2
        }

        // Stage N1: drive the scheduler on this OS thread.
        while ptr_get(g + green_g_off_state()) != green_g_state_done() {
            _green_poll_until(0)
        }
        var r3 = ptr_get(g + green_g_off_result())
        _green_cleanup_g(g)
        return r3
    }

    // timeout_ms == 0 => probe only
    if t == 0 {
        if ptr_get(g + green_g_off_state()) == green_g_state_done() {
            var r2 = ptr_get(g + green_g_off_result())
            _green_cleanup_g(g)
            return r2
        }
        return 0 - 60
    }

    if in_green {
        // Cooperative bounded wait (best-effort): yield/sleep until deadline.
        var start2 = _green_time_now_ns()
        if start2 == 0 {
            var i2 = 0
            while i2 < t {
                if ptr_get(g + green_g_off_state()) == green_g_state_done() {
                    var rr = ptr_get(g + green_g_off_result())
                    _green_cleanup_g(g)
                    return rr
                }
                // Avoid burning CPU: sleep 1ms in green-space.
                oren_green_sleep_ns(1000000)
                i2 = i2 + 1
            }
            ptr_set(g + green_g_off_detached(), 1)
            return 0 - 60
        }
        var deadline2 = start2 + t * 1000000
        while 1 {
            if ptr_get(g + green_g_off_state()) == green_g_state_done() {
                var rr2 = ptr_get(g + green_g_off_result())
                _green_cleanup_g(g)
                return rr2
            }
            var now2 = _green_time_now_ns()
            if now2 == 0 { break }
            if now2 >= deadline2 { break }
            var rem2 = deadline2 - now2
            if rem2 > 1000000 {
                oren_green_sleep_ns(1000000)
            } else {
                oren_green_yield()
            }
        }
        ptr_set(g + green_g_off_detached(), 1)
        return 0 - 60
    }

    // Stage N2 worker mode: block on addr with a bounded timeout.
    if g_green_workers_started != 0 {
        var state_ptr2 = g + green_g_off_state()
        var timeout_us = t * 1000
        while true {
            var wl2 = _green_world_lock_host_enter()
            var cur2 = ptr_get(state_ptr2)
            if cur2 == green_g_state_done() {
                _green_world_lock_host_exit(wl2)
                break
            }
            _green_world_lock_host_exit(wl2)
            var rcw2 = oren_wait_on_addr(state_ptr2, cur2, timeout_us)
            if rcw2 == -60 {
                var wl3 = _green_world_lock_host_enter()
                ptr_set(g + green_g_off_detached(), 1)
                _green_world_lock_host_exit(wl3)
                return -60
            }
            if rcw2 != 0 { return rcw2 }
            // Woken or spurious; re-check state.
        }
        var wl4 = _green_world_lock_host_enter()
        var r_done = ptr_get(g + green_g_off_result())
        _green_cleanup_g(g)
        _green_world_lock_host_exit(wl4)
        return r_done
    }

    var start = _green_time_now_ns()
    if start == 0 {
        // Fallback: run a small bounded loop.
        var i = 0
        while i < t {
            if ptr_get(g + green_g_off_state()) == green_g_state_done() {
                var r3 = ptr_get(g + green_g_off_result())
                _green_cleanup_g(g)
                return r3
            }
            _green_poll_until(0)
            i = i + 1
        }
        ptr_set(g + green_g_off_detached(), 1)
        return 0 - 60
    }

    var deadline = start + t * 1000000
    while 1 {
        if ptr_get(g + green_g_off_state()) == green_g_state_done() {
            var r4 = ptr_get(g + green_g_off_result())
            _green_cleanup_g(g)
            return r4
        }
        var now = _green_time_now_ns()
        if now == 0 { break }
        if now >= deadline { break }
        _green_poll_until(deadline)
    }

    // Timeout: detach (do not kill; safe semantics matches Windows join_timeout).
    ptr_set(g + green_g_off_detached(), 1)
    return 0 - 60
}

@oren.keep
fn oren_green_sleep_ns(ns) {
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }
    var g = ptr_get(ts + green_t_off_current_g())
    if g == 0 { return 0 }
    if ns <= 0 { return 0 }
    var now = _green_time_now_ns()
    if now == 0 {
        // If no clock (rolling bring-up), yield best-effort without depending on
        // higher-level yield helpers.
        sys_sched_yield()
        return 0
    }
    var wake_ns = now + ns
    ptr_set(g + green_g_off_wake_ns(), wake_ns)
    ptr_set(g + green_g_off_state(), green_g_state_sleeping())
    // Save SP into stack node for GC scanning while sleeping.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, get_sp()) }
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(ctx_g, sched_ctx)
    return 0
}

@oren.keep
fn oren_green_yield() {
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }
    var g = ptr_get(ts + green_t_off_current_g())
    if g == 0 { return 0 }
    ptr_set(g + green_g_off_state(), green_g_state_runnable())
    // Save SP into stack node for GC scanning while parked.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, get_sp()) }
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(ctx_g, sched_ctx)
    return 0
}

fn _green_word_wait_list_push_locked(s, g) {
    if s == 0 || g == 0 { return 0 }
    var head = _green_state_word_wait_head(s)
    ptr_set(g + green_g_off_next(), head)
    _green_state_set_word_wait_head(s, g)
    return 0
}

fn _green_word_wait_list_remove_and_wake_all_locked(s, addr) {
    // Caller holds scheduler lock.
    if s == 0 { return 0 }
    var prev = 0
    var cur = _green_state_word_wait_head(s)
    var woke_any = 0
    while cur != 0 {
        var next = ptr_get(cur + green_g_off_next())
        if _green_g_word_wait_addr(cur) == addr {
            // Remove from list.
            if prev == 0 {
                _green_state_set_word_wait_head(s, next)
            } else {
                ptr_set(prev + green_g_off_next(), next)
            }
            ptr_set(cur + green_g_off_next(), 0)
            _green_g_set_word_wait_addr(cur, 0)
            _green_g_set_word_wait_expected(cur, 0)
            _green_g_set_word_wait_rc(cur, 0)
            ptr_set(cur + green_g_off_wake_ns(), 0)
            ptr_set(cur + green_g_off_state(), green_g_state_runnable())
            _green_global_runq_push_locked(s, cur)
            woke_any = 1
            cur = next
            continue
        }
        prev = cur
        cur = next
    }
    return woke_any
}

@oren.keep
fn oren_green_wait_on_addr_forever(addr, expected) {
    // Park the current green task until `oren_wake_all_addr(addr)` is called
    // (or until the value changes and a spurious wake occurs).
    //
    // This is used by `oren_wait_on_addr(..., timeout_us=0)` to avoid blocking the scheduler OS thread
    // in the kernel wait primitive (correctness-first for N:1 green scheduling).
    if addr == 0 || addr < 4096 { return -5 }
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return -1 }
    var g = ptr_get(ts + green_t_off_current_g())
    if g == 0 { return -1 }
    var s = _green_get_state()
    if s == 0 { return -1 }

    // Avoid missed wakeups by checking the word while holding the scheduler lock.
    _green_lock_acquire()
    if ptr_get(addr) != expected {
        _green_lock_release()
        return 0
    }

    // Record wait metadata (for wake-by-address).
    _green_g_set_word_wait_addr(g, addr)
    _green_g_set_word_wait_expected(g, expected)
    _green_g_set_word_wait_rc(g, 0)
    ptr_set(g + green_g_off_wake_ns(), 0)
    ptr_set(g + green_g_off_state(), green_g_state_word_wait())

    // Save SP into stack node for GC scanning while parked.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, get_sp()) }

    _green_word_wait_list_push_locked(s, g)
    _green_lock_release()

    // Switch back to scheduler stack.
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(ctx_g, sched_ctx)
    return 0
}

@oren.keep
fn oren_green_wait_on_addr_timeout(addr, expected, timeout_us) {
    // Park the current green task until either:
    // - `oren_wake_all_addr(addr)` is called (wake-driven), OR
    // - the timeout elapses (portable timeout code `-60`).
    //
    // Used by `oren_wait_on_addr(..., timeout_us>0)` when invoked from inside a green task, so bounded
    // lock-contention waits do not kernel-block the scheduler OS thread.
    if timeout_us <= 0 { return oren_green_wait_on_addr_forever(addr, expected) }
    if addr == 0 || addr < 4096 { return -5 }
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return -1 }
    var g = ptr_get(ts + green_t_off_current_g())
    if g == 0 { return -1 }
    var s = _green_get_state()
    if s == 0 { return -1 }

    // Compute deadline using the scheduler monotonic time base.
    var now_ns = _green_time_now_ns()
    if now_ns == 0 {
        // No clock: best-effort bounded yield via nanosleep (keeps semantics safe but may block briefly).
        // This should be rare on Tier‑1.
        sys_nanosleep(timeout_us * 1000)
        // Timeout reached from the caller's perspective.
        if ptr_get(addr) == expected { return 0 - 60 }
        return 0
    }
    var deadline_ns = now_ns + timeout_us * 1000

    _green_lock_acquire()
    if ptr_get(addr) != expected {
        _green_lock_release()
        return 0
    }

    // Record wait metadata (for wake-by-address / timeout wake).
    _green_g_set_word_wait_addr(g, addr)
    _green_g_set_word_wait_expected(g, expected)
    _green_g_set_word_wait_rc(g, 0)
    ptr_set(g + green_g_off_wake_ns(), deadline_ns)
    ptr_set(g + green_g_off_state(), green_g_state_word_wait())

    // Save SP into stack node for GC scanning while parked.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, get_sp()) }

    _green_word_wait_list_push_locked(s, g)
    _green_lock_release()

    // Switch back to scheduler stack.
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(ctx_g, sched_ctx)

    // After wake: return the timeout code if the scheduler woke us due to deadline.
    var rc = _green_g_word_wait_rc(g)
    if rc != 0 {
        // Clear so future parks do not observe stale timeout results.
        _green_g_set_word_wait_rc(g, 0)
        return rc
    }
    return 0
}

@oren.keep
fn oren_green_wake_all_addr(addr) {
    // Wake all green tasks parked via `oren_green_wait_on_addr_forever`.
    //
    // Note: this is best-effort and does not validate that the word changed.
    if g_green_inited == 0 { return 0 }
    if addr == 0 || addr < 4096 { return 0 }
    var s = _green_get_state()
    if s == 0 { return 0 }

    _green_lock_acquire()
    var woke_any = _green_word_wait_list_remove_and_wake_all_locked(s, addr)
    _green_lock_release()
    if woke_any != 0 { _green_workers_wake_if_started() }
    return 0
}
