}

fn _green_worker_try_acquire_any_p_locked(s, tid) {
    // Worker-mode helper: try to acquire some free P (owner_tid==0) for this tid.
    // Returns the acquired P pointer, or 0 if none available.
    if s == 0 { return 0 }
    if tid == 0 { return 0 }
    // Prefer the explicit idle-P pool (Stage N3 groundwork).
    var got = _green_idle_p_pop_and_acquire_locked(s, tid)
    if got != 0 { return got }
    var p = _green_state_p0(s)
    while p != 0 {
        var owner = _green_p_owner_tid(p)
        if owner == 0 {
            _green_idle_p_remove_locked(s, p)
            _green_p_set_owner_tid(p, tid)
            // Debug: record acquisition.
            var dbg = g_green_debug_word
            if dbg != 0 && dbg != -1 && dbg >= 4096 {
                _green_atomic_inc_u64(dbg + 24)
                ptr_set(dbg + 40, _green_p_id(p))
            }
            return p
        }
        p = _green_p_next(p)
    }
    return 0
}

fn _green_p_release_if_owned_by_tid_locked(s, p, tid) {
    if s == 0 { return 0 }
    if p == 0 { return 0 }
    if tid == 0 { return 0 }
    var owner = _green_p_owner_tid(p)
    if owner == tid {
        _green_p_set_owner_tid(p, 0)
        _green_idle_p_push_locked(s, p)
        // Debug: record release.
        var dbg = g_green_debug_word
        if dbg != 0 && dbg != -1 && dbg >= 4096 {
            _green_atomic_inc_u64(dbg + 32)
            ptr_set(dbg + 48, _green_p_id(p))
        }
        return 0
    }
    return 0
}

fn _green_workers_wake_if_started() {
    if g_green_workers_started == 0 { return 0 }
    var base = g_green_worker_wake_word
    if base == 0 { return 0 }
    // Best-effort: post wake tokens and wake all parked workers.
    // (Per-worker slots enable deterministic wake for fixtures.)
    var wc = g_green_worker_count
    var i = 0
    while i < wc {
        oren_m_park_word_wake(base + i * 8)
        i = i + 1
    }
    // Also wake the POSIX netpoller (if enabled) so an idle worker blocked in kevent/epoll wakes immediately.
    if g_target_os != 3 {
        native_netpoll_wake()
    }
    return 0
}

@oren.keep
fn oren_green_debug_idle_p_requeue(p_id) {
    // Fixture helper: move an idle P to the tail of the idle-P queue (to deterministically control FIFO order).
    _green_init_if_needed()
    if _green_enabled() != true { return -1 }
    if p_id < 0 { return -1 }
    if p_id >= 64 { return -1 }
    var s = _green_get_state()
    if s == 0 { return -1 }
    _green_lock_acquire()
    var p = _green_state_p_by_id_or0(s, p_id)
    if p == 0 {
        _green_lock_release()
        return -1
    }
    if _green_p_owner_tid(p) != 0 {
        _green_lock_release()
        return 0 - 16 // -EBUSY
    }
    // Remove then append to tail.
    _green_idle_p_remove_locked(s, p)
    _green_idle_p_push_locked(s, p)
    _green_lock_release()
    return 0
}

fn _green_netpoll_drain_ready(ts, now_ns, max_events) {
    // Drain up to max_events ready tokens from the netpoller (timeout=0) and mark the corresponding Gs
    // as ready to wake on the next sleeper scan.
    //
    // Token contract (rolling):
    // - token is a G pointer; it must remain valid even if the wait times out (G continues running).
    if g_target_os == 3 { return 0 }
    if g_green_inited == 0 { return 0 }
    if now_ns == 0 { return 0 }
    // Initialize lazily; ignore ENOSYS.
    if native_netpoll_init_once() < 0 { return 0 }
    var scratch = _green_thread_netpoll_scratch_or0(ts)
    var n = 0
    while n < max_events {
        if scratch != 0 {
            var got = native_netpoll_poll_many_scratch(0, scratch, green_t_netpoll_scratch_bytes())
            if got <= 0 { break }
            var i = 0
            while i < got {
                if n >= max_events { break }
                var tok = ptr_get(scratch + i * 8)
                if tok != 0 {
                    if _green_is_g(tok) == true {
                        // Netpoll v1 token: tok is the G pointer.
                        // Ignore stale tokens (wait already completed/timed out).
                        if ptr_get(tok + green_g_off_io_active()) != 0 {
                            ptr_set(tok + green_g_off_io_ready(), 1)
                            // Force a wake on the next `_green_wake_ready_all(now_ns)` pass.
                            ptr_set(tok + green_g_off_wake_ns(), now_ns)
                        }
                    } else {
                        // Netpoll v2 token: tok is a small tracked struct describing which select-case became ready.
                        if native_netpoll_is_wait_token(tok) == true {
                            var g = ptr_get(tok + native_netpoll_wait_off_g())
                            if _green_is_g(g) == true {
                                if ptr_get(g + green_g_off_io_active()) != 0 {
                                    var want_epoch = ptr_get(tok + native_netpoll_wait_off_epoch())
                                    if want_epoch == ptr_get(g + green_g_off_io_epoch()) {
                                        ptr_set(tok + native_netpoll_wait_off_ready(), 1)
                                        ptr_set(g + green_g_off_io_ready(), 1)
                                        ptr_set(g + green_g_off_wake_ns(), now_ns)
                                    }
                                }
                            }
                        }
                    }
                }
                i = i + 1
                n = n + 1
            }
        } else {
            // Fallback (should be rare): poll one token at a time.
            var tok2 = native_netpoll_poll_one(0)
            if tok2 == 0 { break }
            if _green_is_g(tok2) == true {
                if ptr_get(tok2 + green_g_off_io_active()) != 0 {
                    ptr_set(tok2 + green_g_off_io_ready(), 1)
                    ptr_set(tok2 + green_g_off_wake_ns(), now_ns)
                }
            } else {
                if native_netpoll_is_wait_token(tok2) == true {
                    var g2 = ptr_get(tok2 + native_netpoll_wait_off_g())
                    if _green_is_g(g2) == true {
                        if ptr_get(g2 + green_g_off_io_active()) != 0 {
                            var want_epoch2 = ptr_get(tok2 + native_netpoll_wait_off_epoch())
                            if want_epoch2 == ptr_get(g2 + green_g_off_io_epoch()) {
                                ptr_set(tok2 + native_netpoll_wait_off_ready(), 1)
                                ptr_set(g2 + green_g_off_io_ready(), 1)
                                ptr_set(g2 + green_g_off_wake_ns(), now_ns)
                            }
                        }
                    }
                }
            }
            n = n + 1
        }
    }
    return 0
}

fn _green_lock_acquire() {
    // Dedicated lock for green scheduler state (runq/sleepq/zombies/P list).
    // This avoids coupling scheduler progress to the runtime global lock (used heavily by allocator/GC metadata).
    var lock_ptr = g_green_sched_lock_word
    if lock_ptr == 0 { return 0 }
    var tid = sys_gettid()
    if tid == 0 {
        // If background workers are enabled, we require a stable non-zero tid to avoid
        // colliding with the "unlocked" sentinel 0.
        if g_green_workers_started != 0 { exit(930) }
        return 0
    }
    var spin = 0
    while atomic_cas(lock_ptr, 0, tid) != 0 {
        spin = spin + 1
        if spin > 1000 {
            var owner = ptr_get(lock_ptr)
            if owner != 0 {
                // STW GC robustness: do not block indefinitely while holding no safepoint polls.
                // Parkable waits must allow `oren_gc_collect()` to complete when multiple OS threads exist.
                oren_gc_safepoint()
                oren_wait_on_addr(lock_ptr, owner, 1000) // 1ms
            }
            spin = 0
        }
    }
    return 0
}

fn _green_lock_release() {
    var lock_ptr = g_green_sched_lock_word
    if lock_ptr == 0 { return 0 }
    var tid = sys_gettid()
    if tid == 0 {
        if g_green_workers_started != 0 { exit(930) }
        return 0
    }
    atomic_cas(lock_ptr, tid, 0)
    oren_wake_all_addr(lock_ptr)
    return 0
}

fn _green_runq_push_local_locked(p, g) {
    if p == 0 || g == 0 { return 0 }
    var buf = _green_p_runq_buf(p)
    var mask = _green_p_runq_mask(p)
    if buf == 0 || mask == 0 { return 0 }

    var head = _green_p_runq_head(p)
    var tail = _green_p_runq_tail(p)
    var cap = mask + 1
    if tail - head >= cap {
        // Full: caller should overflow to global queue.
        return 0 - 60
    }

    var was_empty = 0
    if tail == head { was_empty = 1 }

    var idx = tail & mask
    ptr_set(buf + idx * 8, g)
    _green_p_set_runq_tail(p, tail + 1)
    return was_empty
}

fn _green_runq_pop_local_locked(p) {
    if p == 0 { return 0 }
    var buf = _green_p_runq_buf(p)
    var mask = _green_p_runq_mask(p)
    if buf == 0 || mask == 0 { return 0 }

    var head = _green_p_runq_head(p)
    var tail = _green_p_runq_tail(p)
    if head == tail { return 0 }

    // Owner pop from tail (LIFO).
    tail = tail - 1
    var idx = tail & mask
    var g = ptr_get(buf + idx * 8)
    ptr_set(buf + idx * 8, 0)
    _green_p_set_runq_tail(p, tail)
    return g
}

fn _green_runq_steal_one_from_locked(victim_p) {
    if victim_p == 0 { return 0 }
    var buf = _green_p_runq_buf(victim_p)
    var mask = _green_p_runq_mask(victim_p)
    if buf == 0 || mask == 0 { return 0 }

    var head = _green_p_runq_head(victim_p)
    var tail = _green_p_runq_tail(victim_p)
    if head == tail { return 0 }

    // Steal from head (FIFO).
    var idx = head & mask
    var g = ptr_get(buf + idx * 8)
    ptr_set(buf + idx * 8, 0)
    _green_p_set_runq_head(victim_p, head + 1)
    return g
}

fn _green_runq_push_locked(p, s, g) {
    if p == 0 || s == 0 || g == 0 { return 0 }
    _green_g_set_next(g, 0)
    var rc = _green_runq_push_local_locked(p, g)
    if rc == -60 {
        // Local overflow: push into global runq (fairness / overflow queue).
        return _green_global_runq_push_locked(s, g)
    }
    return rc
}

fn _green_runq_pop_locked(p) {
    return _green_runq_pop_local_locked(p)
}

fn _green_global_runq_push_locked(s, g) {
    if s == 0 || g == 0 { return 0 }
    var was_empty = 0
    _green_g_set_next(g, 0)
    var head = _green_state_glob_run_head(s)
    if head == 0 {
        was_empty = 1
        _green_state_set_glob_run_head(s, g)
        _green_state_set_glob_run_tail(s, g)
        return was_empty
    }
    var tail = _green_state_glob_run_tail(s)
    if tail != 0 { _green_g_set_next(tail, g) }
    _green_state_set_glob_run_tail(s, g)
    return was_empty
}

fn _green_global_runq_pop_locked(s) {
    if s == 0 { return 0 }
    var head = _green_state_glob_run_head(s)
    if head == 0 { return 0 }
    var next = _green_g_next(head)
    _green_state_set_glob_run_head(s, next)
    if next == 0 {
        _green_state_set_glob_run_tail(s, 0)
    }
    _green_g_set_next(head, 0)
    return head
}

fn _green_global_runq_push(g) {
    var s = _green_get_state()
    if s == 0 || g == 0 { return 0 }
    _green_lock_acquire()
    var was_empty = _green_global_runq_push_locked(s, g)
    _green_lock_release()
    if was_empty != 0 { _green_workers_wake_if_started() }
    return 0
}

fn _green_global_runq_pop() {
    var s = _green_get_state()
    if s == 0 { return 0 }
    _green_lock_acquire()
    var g = _green_global_runq_pop_locked(s)
    _green_lock_release()
    return g
}

fn _green_runq_push_p(p, g) {
    var s = _green_get_state()
    if p == 0 || s == 0 || g == 0 { return 0 }
    _green_lock_acquire()
    var was_empty = _green_runq_push_locked(p, s, g)
    _green_lock_release()
    if was_empty != 0 { _green_workers_wake_if_started() }
    return 0
}

fn _green_runq_pop_p(p) {
    if p == 0 { return 0 }
    _green_lock_acquire()
    var g = _green_runq_pop_locked(p)
    _green_lock_release()
    return g
}

fn _green_runq_push(g) {
    var p = _green_current_p_or0()
    return _green_runq_push_p(p, g)
}

fn _green_runq_pop() {
    var p = _green_current_p_or0()
    return _green_runq_pop_p(p)
}

fn _green_sleepq_push_locked(p, g) {
    if p == 0 || g == 0 { return 0 }
    _green_g_set_next(g, 0)
    var head = _green_p_sleep_head(p)
    if head == 0 {
        _green_p_set_sleep_head(p, g)
        _green_p_set_sleep_tail(p, g)
        return 0
    }
    var tail = _green_p_sleep_tail(p)
    if tail != 0 { _green_g_set_next(tail, g) }
    _green_p_set_sleep_tail(p, g)
    return 0
}

fn _green_sleepq_push_p(p, g) {
    if p == 0 || g == 0 { return 0 }
    _green_lock_acquire()
    _green_sleepq_push_locked(p, g)
    _green_lock_release()
    // If a worker is parked (or parked-with-timeout), nudge it to re-evaluate the next wake deadline.
    _green_workers_wake_if_started()
    return 0
}

fn _green_sleepq_push(g) {
    var p = _green_current_p_or0()
    return _green_sleepq_push_p(p, g)
}

fn _green_zombie_push(g) {
    var s = _green_get_state()
    if s == 0 || g == 0 { return 0 }
    _green_lock_acquire()
    // Simple LIFO for zombies.
    var head = _green_state_zomb_head(s)
    _green_g_set_next(g, head)
    _green_state_set_zomb_head(s, g)
    _green_lock_release()
    return 0
}

fn _green_cleanup_g(g) {
    if g == 0 { return 0 }
    var stack_base = ptr_get(g + green_g_off_stack_base())
    var stack_size = ptr_get(g + green_g_off_stack_size())
    var ctx_ptr = ptr_get(g + green_g_off_ctx())
    var node = ptr_get(g + green_g_off_stack_node())

    if node != 0 {
        oren_unregister_stack(node)
        ptr_set(g + green_g_off_stack_node(), 0)
    }
    if stack_base != 0 && stack_size > 0 {
        sys_munmap(stack_base, stack_size)
        ptr_set(g + green_g_off_stack_base(), 0)
        ptr_set(g + green_g_off_stack_size(), 0)
        ptr_set(g + green_g_off_stack_top(), 0)
    }
    if ctx_ptr != 0 {
        sys_munmap(ctx_ptr, green_ctx_bytes())
        ptr_set(g + green_g_off_ctx(), 0)
    }
    // Clear references to reduce accidental retention.
    ptr_set(g + green_g_off_fn_obj(), 0)
    ptr_set(g + green_g_off_args_list(), 0)
    return 0
}

fn _green_zombie_drain() {
    var s = _green_get_state()
    if s == 0 { return 0 }
    _green_lock_acquire()
    var cur = _green_state_zomb_head(s)
    _green_state_set_zomb_head(s, 0)
    _green_lock_release()
    while cur != 0 {
        var next = _green_g_next(cur)
        _green_g_set_next(cur, 0)
        _green_cleanup_g(cur)
        cur = next
    }
    return 0
}

fn _green_wake_ready_p(p, now_ns) {
    if p == 0 { return 0 }
    if now_ns == 0 { return 0 }
    _green_lock_acquire()
    var s = _green_get_state()
    var prev = 0
    var cur = _green_p_sleep_head(p)
    var new_tail = 0
    var woke_any = 0
    while cur != 0 {
        var next = _green_g_next(cur)
        var wake_ns = ptr_get(cur + green_g_off_wake_ns())
        if wake_ns != 0 && now_ns >= wake_ns {
            // Remove from sleep list.
            if prev == 0 {
                _green_p_set_sleep_head(p, next)
            } else {
                _green_g_set_next(prev, next)
            }
            if next == 0 { new_tail = prev }
            _green_g_set_next(cur, 0)
            ptr_set(cur + green_g_off_state(), green_g_state_runnable())
            if s != 0 {
                _green_runq_push_locked(p, s, cur)
            }
            woke_any = 1
            cur = next
            continue
        }
        prev = cur
        cur = next
    }
    if _green_p_sleep_head(p) == 0 {
        _green_p_set_sleep_tail(p, 0)
    } else if new_tail != 0 {
        _green_p_set_sleep_tail(p, new_tail)
    }
    _green_lock_release()
    if woke_any != 0 { _green_workers_wake_if_started() }
    return 0
}

fn _green_wake_ready_all(now_ns) {
    if now_ns == 0 { return 0 }
    var s = _green_get_state()
    if s == 0 { return 0 }

    var woke_any = 0
    _green_lock_acquire()
    var p = _green_state_p0(s)
    while p != 0 {
        var prev = 0
        var cur = _green_p_sleep_head(p)
        var new_tail = 0
        while cur != 0 {
            var next = _green_g_next(cur)
            var wake_ns = ptr_get(cur + green_g_off_wake_ns())
            if wake_ns != 0 && now_ns >= wake_ns {
                // Remove from sleep list.
                if prev == 0 {
                    _green_p_set_sleep_head(p, next)
                } else {
                    _green_g_set_next(prev, next)
                }
                if next == 0 { new_tail = prev }
                _green_g_set_next(cur, 0)
                ptr_set(cur + green_g_off_state(), green_g_state_runnable())
                _green_runq_push_locked(p, s, cur)
                woke_any = 1
                cur = next
                continue
            }
            prev = cur
            cur = next
        }
        if _green_p_sleep_head(p) == 0 {
            _green_p_set_sleep_tail(p, 0)
        } else if new_tail != 0 {
            _green_p_set_sleep_tail(p, new_tail)
        }
        p = _green_p_next(p)
    }
    _green_lock_release()
    if woke_any != 0 { _green_workers_wake_if_started() }
    return 0
}

fn _green_next_wake_ns_p(p) {
    if p == 0 { return 0 }
    if p < 4096 { exit(941) }
    _green_lock_acquire()
    var cur = _green_p_sleep_head(p)
    var best = 0
    while cur != 0 {
        if _green_is_g(cur) != true { exit(942) }
        var w = ptr_get(cur + green_g_off_wake_ns())
        if w != 0 {
            if best == 0 || w < best { best = w }
        }
        cur = _green_g_next(cur)
    }
    _green_lock_release()
    return best
}

fn _green_next_wake_ns_all() {
    var s = _green_get_state()
    if s == 0 { return 0 }
    var best = 0
    _green_lock_acquire()
    var p = _green_state_p0(s)
    while p != 0 {
        var cur = _green_p_sleep_head(p)
        while cur != 0 {
            if _green_is_g(cur) != true { exit(942) }
            var w = ptr_get(cur + green_g_off_wake_ns())
            if w != 0 {
                if best == 0 || w < best { best = w }
            }
            cur = _green_g_next(cur)
        }
        p = _green_p_next(p)
    }
    _green_lock_release()
    return best
}

fn _green_next_wake_ns() {
    var p = _green_current_p_or0()
    return _green_next_wake_ns_p(p)
}

fn _green_sched_switch_to(g) {
    if g == 0 { return 0 }
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }

    _green_thread_set_current_g(ts, g)
    // Mark running (best-effort; not externally visible yet).
    ptr_set(g + green_g_off_state(), green_g_state_runnable())
    // Save scheduler-stack SP into the OS-thread node so GC can scan it while we run on the green stack.
    var sched_node = _green_thread_sched_stack_node_or0(ts)
    if sched_node != 0 { ptr_set(sched_node + 8, get_sp()) }
    // Clear saved_sp for this stack node so GC uses current SP heuristic.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, 0) }
    // Switch from scheduler context to task context.
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(sched_ctx, ctx_g)
    // Returned from task via yield/sleep/done.
    _green_thread_set_current_g(ts, 0)
    // We are back on scheduler stack; clear the saved_sp hint.
    if sched_node != 0 { ptr_set(sched_node + 8, 0) }
    return 0
}

fn _green_runq_size_locked(p) {
    if p == 0 { return 0 }
    var head = _green_p_runq_head(p)
    var tail = _green_p_runq_tail(p)
    if tail < head { return 0 }
    return tail - head
}

fn _green_runq_steal_batch_locked(dst_p, s, max_n) {
    if dst_p == 0 || s == 0 { return 0 }
    if max_n <= 0 { max_n = 1 }
    if max_n > 32 { max_n = 32 }

    // Choose the most loaded victim P (by runq size) to reduce thrash and keep stealing stable.
    // (This is under the scheduler lock today; later atomics-based stealing can use a different policy.)
    var best_p = 0
    var best_sz = 0
    var cur = _green_state_p0(s)
    while cur != 0 {
        if cur != dst_p {
            var sz = _green_runq_size_locked(cur)
            if sz > best_sz {
                best_sz = sz
                best_p = cur
            }
        }
        cur = _green_p_next(cur)
    }

    if best_p != 0 && best_sz > 0 {
        // Steal up to half (bounded), so we don't immediately thrash.
        var want = best_sz / 2
        if want < 1 { want = 1 }
        if want > max_n { want = max_n }

        var first = 0
        var i = 0
        while i < want {
            var g = _green_runq_steal_one_from_locked(best_p)
            if g == 0 { break }
            if first == 0 {
                first = g
            } else {
                // Queue the rest locally (overflowing to global as needed).
                _green_runq_push_locked(dst_p, s, g)
            }
            i = i + 1
        }
        if first != 0 {
            // Debug counters: record steals for regression fixtures (best-effort).
            var dbg = g_green_debug_word
            if dbg != 0 && dbg != -1 && dbg >= 4096 {
                _green_atomic_inc_u64(dbg + 8)
                ptr_set(dbg + 16, _green_p_id(best_p))
            }
        }
        return first
    }
    return 0
}

fn _green_runq_pop_any_locked(p, s, prefer_global) {
    if p == 0 || s == 0 { return 0 }
    var g = 0
    if prefer_global != 0 {
        g = _green_global_runq_pop_locked(s)
        if g != 0 { return g }
    }
    g = _green_runq_pop_locked(p)
    if g != 0 { return g }
    // If local is empty, allow the global queue as a fallback.
    g = _green_global_runq_pop_locked(s)
    if g != 0 { return g }
    // Last resort before idling: attempt a small bounded steal batch.
    return _green_runq_steal_batch_locked(p, s, 4)
}
