@oren.keep
fn oren_green_debug_tid() {
    // Debug/testing helper: expose the runtime's notion of OS-thread id.
    // (On supported Tier‑1 hosts this is a stable non-zero id for the lifetime of the thread.)
    return sys_gettid()
}

@oren.keep
fn oren_green_debug_p_owner_tid(p_id) {
    // Debug/testing helper: observe P ownership (0 = unclaimed, negative = reserved sentinel, positive = tid).
    _green_init_if_needed()
    if _green_enabled() != true { return 0 }
    if p_id < 0 { return 0 }
    if p_id >= 64 { return 0 }
    var s = _green_get_state()
    if s == 0 { return 0 }
    _green_lock_acquire()
    var p = _green_state_p_by_id_or0(s, p_id)
    var v = 0
    if p != 0 { v = _green_p_owner_tid(p) }
    _green_lock_release()
    return v
}

@oren.keep
fn oren_green_debug_worker_count() {
    return g_green_worker_count
}

@oren.keep
fn oren_green_debug_workers_ready_count() {
    var p = g_green_workers_ready_word
    if p == 0 || p == -1 || p < 4096 { return 0 }
    return ptr_get(p)
}

@oren.keep
fn oren_green_set_world_lock_mode(enable) {
    // Test/dev-only knob:
    // Enable a world lock so multiple green scheduler workers can exist while still ensuring
    // only one OS thread executes Oren code on a green stack at a time.
    //
    // Must be set before `oren_green_start_workers`.
    _green_init_if_needed()
    if _green_enabled() != true { return -1 }
    if g_green_workers_started != 0 { return -1 }
    // Must not run in-green.
    var ts0 = _green_thread_state_for_current_thread_or0()
    if ts0 != 0 && ptr_get(ts0 + green_t_off_current_g()) != 0 { return -1 }

    if enable != 0 {
        if g_green_world_lock_word == 0 {
            var w = sys_mmap_private_anon(4096)
            if w == 0 || w == -1 || w < 4096 { exit(938) }
            ptr_set(w, 0)
            g_green_world_lock_word = w
        }
        g_green_world_lock_enabled = 1
    } else {
        g_green_world_lock_enabled = 0
    }
    return 0
}

@oren.keep
fn oren_green_debug_reset() {
    var p = g_green_debug_word
    if p == 0 || p == -1 || p < 4096 { return 0 }
    ptr_set(p + 0, 0)
    ptr_set(p + 8, 0)
    ptr_set(p + 16, 0)
    ptr_set(p + 24, 0)
    ptr_set(p + 32, 0)
    ptr_set(p + 40, 0)
    ptr_set(p + 48, 0)
    ptr_set(p + 56, 0)
    ptr_set(p + 64, 0)
    ptr_set(p + 72, 0)
    return 0
}

fn _green_idle_p_remove_locked(s, target_p) {
    if s == 0 { return 0 }
    if target_p == 0 { return 0 }
    var prev = 0
    var cur = _green_state_idle_p_head(s)
    while cur != 0 {
        var next = _green_p_idle_next(cur)
        if cur == target_p {
            if prev == 0 {
                _green_state_set_idle_p_head(s, next)
            } else {
                _green_p_set_idle_next(prev, next)
            }
            if next == 0 {
                // Removed tail.
                _green_state_set_idle_p_tail(s, prev)
            }
            _green_p_set_idle_next(cur, 0)
            return 1
        }
        prev = cur
        cur = next
    }
    return 0
}

fn _green_idle_p_push_locked(s, p) {
    if s == 0 { return 0 }
    if p == 0 { return 0 }
    // Keep the queue free of duplicates (best-effort, bounded by p_count<=64).
    _green_idle_p_remove_locked(s, p)
    if _green_p_owner_tid(p) != 0 { return 0 }
    _green_p_set_idle_next(p, 0)
    var head = _green_state_idle_p_head(s)
    var tail = _green_state_idle_p_tail(s)
    if head == 0 {
        _green_state_set_idle_p_head(s, p)
        _green_state_set_idle_p_tail(s, p)
    } else {
        if tail != 0 {
            _green_p_set_idle_next(tail, p)
        }
        _green_state_set_idle_p_tail(s, p)
    }
    return 0
}

fn _green_idle_p_pop_and_acquire_locked(s, tid) {
    if s == 0 { return 0 }
    if tid == 0 { return 0 }
    while true {
        var p = _green_state_idle_p_head(s)
        if p == 0 { return 0 }
        var next = _green_p_idle_next(p)
        _green_state_set_idle_p_head(s, next)
        if next == 0 {
            _green_state_set_idle_p_tail(s, 0)
        }
        _green_p_set_idle_next(p, 0)
            if _green_p_owner_tid(p) == 0 {
                _green_p_set_owner_tid(p, tid)
                // Debug: record acquisition.
                var dbg = g_green_debug_word
                if dbg != 0 && dbg != -1 && dbg >= 4096 {
                    _green_atomic_inc_u64(dbg + 24)
                    ptr_set(dbg + 40, _green_p_id(p))
                    ptr_set(dbg + 56, tid)
                    var pid = _green_p_id(p)
                    if pid >= 0 && pid < 64 {
                        var mask = ptr_get(dbg + 72)
                        ptr_set(dbg + 72, mask | (1 << pid))
                    }
                }
                return p
            }
        // Stale entry: ignore and keep draining.
    }
    return 0
}

fn _green_p_ensure_owned_by_tid_locked(s, p, tid) {
    if s == 0 { return -1 }
    if p == 0 { return -1 }
    if tid == 0 { return -1 }
    var owner = _green_p_owner_tid(p)
    if owner == tid { return 0 }
    var reserved = _green_p_owner_reserved_tid(p)
    if owner == 0 || owner == reserved {
        if owner == 0 {
            // Ensure this P is not still present in the idle-P list.
            _green_idle_p_remove_locked(s, p)
        }
        _green_p_set_owner_tid(p, tid)
        // Debug: record ownership reacquisition.
        var dbg = g_green_debug_word
        if dbg != 0 && dbg != -1 && dbg >= 4096 {
            _green_atomic_inc_u64(dbg + 24)
            ptr_set(dbg + 40, _green_p_id(p))
            ptr_set(dbg + 56, tid)
            var pid = _green_p_id(p)
            if pid >= 0 && pid < 64 {
                var mask = ptr_get(dbg + 72)
                ptr_set(dbg + 72, mask | (1 << pid))
            }
        }
        return 0
    }
    return 0 - 16 // -EBUSY
}

fn _green_worker_try_acquire_any_p_locked(s, tid) {
    // Worker-mode helper: try to acquire some free P (owner_tid==0) for this tid.
    // Returns the acquired P pointer, or 0 if none available.
    if s == 0 { return 0 }
    if tid == 0 { return 0 }
    // Prefer the explicit idle-P pool (Stage N3 groundwork).
    var got = _green_idle_p_pop_and_acquire_locked(s, tid)
    if got != 0 { return got }
    var p = _green_state_p0(s)
    while p != 0 {
        var owner = _green_p_owner_tid(p)
        if owner == 0 {
            _green_idle_p_remove_locked(s, p)
            _green_p_set_owner_tid(p, tid)
            // Debug: record acquisition.
            var dbg = g_green_debug_word
            if dbg != 0 && dbg != -1 && dbg >= 4096 {
                _green_atomic_inc_u64(dbg + 24)
                ptr_set(dbg + 40, _green_p_id(p))
                ptr_set(dbg + 56, tid)
                var pid = _green_p_id(p)
                if pid >= 0 && pid < 64 {
                    var mask = ptr_get(dbg + 72)
                    ptr_set(dbg + 72, mask | (1 << pid))
                }
            }
            return p
        }
        p = _green_p_next(p)
    }
    return 0
}

fn _green_p_release_if_owned_by_tid_locked(s, p, tid) {
    if s == 0 { return 0 }
    if p == 0 { return 0 }
    if tid == 0 { return 0 }
