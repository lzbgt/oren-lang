fn _green_trace_args_stamp_stride_value() {
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_args_stamp_stride_envp == cur_envp &&
       g_trace_green_args_stamp_stride_argv == cur_argv &&
       g_trace_green_args_stamp_stride_argc == cur_argc {
        return g_trace_green_args_stamp_stride
    }
    var stride = 1
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_ARGS_STAMP_STRIDE")
    if v != 0 && ptr_get_byte(v) != 0 && ptr_get_byte(v) != 48 {
        var parsed = oren_int_from_string(v)
        if parsed > 0 { stride = parsed }
    }
    g_trace_green_args_stamp_stride = stride
    g_trace_green_args_stamp_stride_envp = cur_envp
    g_trace_green_args_stamp_stride_argv = cur_argv
    g_trace_green_args_stamp_stride_argc = cur_argc
    return stride
}

fn _green_poll_cache_guard_enabled() {
    if g_trace_green_poll_cache_guard == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_poll_cache_guard == 0 {
        if cur_envp == g_trace_green_poll_cache_guard_envp &&
           cur_argv == g_trace_green_poll_cache_guard_argv &&
           cur_argc == g_trace_green_poll_cache_guard_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_POLL_CACHE_GUARD")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_green_poll_cache_guard == -1 || g_trace_green_poll_cache_guard == 0 {
            g_trace_green_poll_cache_guard = 0
            g_trace_green_poll_cache_guard_envp = cur_envp
            g_trace_green_poll_cache_guard_argv = cur_argv
            g_trace_green_poll_cache_guard_argc = cur_argc
        }
        return false
    }
    g_trace_green_poll_cache_guard = 1
    g_trace_green_poll_cache_guard_envp = cur_envp
    g_trace_green_poll_cache_guard_argv = cur_argv
    g_trace_green_poll_cache_guard_argc = cur_argc
    if g_trace_green_poll_cache_guard_every == 0 {
        var ev = native_envp_get_value_ptr("OREN_TRACE_GREEN_POLL_CACHE_GUARD_EVERY")
        if ev != 0 {
            var n = native_parse_i64_dec_cstr_or_neg1(ev)
            if n > 0 {
                if n > 1000000 { n = 1000000 }
                g_trace_green_poll_cache_guard_every = n
            }
        }
        if g_trace_green_poll_cache_guard_every <= 0 { g_trace_green_poll_cache_guard_every = 1 }
    }
    return true
}

fn _green_last_ops_enabled() {
    if g_trace_green_last_ops == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_last_ops == 0 {
        if cur_envp == g_trace_green_last_ops_envp &&
           cur_argv == g_trace_green_last_ops_argv &&
           cur_argc == g_trace_green_last_ops_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_LAST_OPS")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_green_last_ops == -1 || g_trace_green_last_ops == 0 {
            g_trace_green_last_ops = 0
            g_trace_green_last_ops_envp = cur_envp
            g_trace_green_last_ops_argv = cur_argv
            g_trace_green_last_ops_argc = cur_argc
        }
        return false
    }
    g_trace_green_last_ops = 1
    g_trace_green_last_ops_envp = cur_envp
    g_trace_green_last_ops_argv = cur_argv
    g_trace_green_last_ops_argc = cur_argc
    if g_trace_green_last_ops_cap == 0 {
        var cap = 128
        var cv = native_envp_get_value_ptr("OREN_TRACE_GREEN_LAST_OPS_CAP")
        if cv != 0 {
            var n = native_parse_i64_dec_cstr_or_neg1(cv)
            if n > 0 {
                if n < 16 { n = 16 }
                if n > 4096 { n = 4096 }
                cap = n
            }
        }
        g_trace_green_last_ops_cap = cap
    }
    if g_trace_green_last_ops_every == 0 {
        var ev = native_envp_get_value_ptr("OREN_TRACE_GREEN_LAST_OPS_EVERY_TICKS")
        if ev != 0 {
            var n = native_parse_i64_dec_cstr_or_neg1(ev)
            if n > 0 {
                if n < 1 { n = 1 }
                if n > 1000000 { n = 1000000 }
                g_trace_green_last_ops_every = n
            }
        }
    }
    if g_trace_green_last_ops_ptr == 0 {
        var bytes = g_trace_green_last_ops_cap * 48
        var buf = sys_mmap_private_anon(bytes)
        if buf == 0 || buf == -1 || buf < 4096 {
            g_trace_green_last_ops = 0
            return false
        }
        var i = 0
        while i < bytes {
            ptr_set_byte(buf + i, 0)
            i = i + 1
        }
        g_trace_green_last_ops_ptr = buf
        g_trace_green_last_ops_head = 0
    }
    return true
}

fn _green_last_ops_put(op, g, extra, extra2) {
    if _green_last_ops_enabled() != true { return 0 }
    var cap = g_trace_green_last_ops_cap
    if cap <= 0 { return 0 }
    var base_ptr = g_trace_green_last_ops_ptr
    if base_ptr == 0 { return 0 }
    var fn_obj = 0
    var args_list = 0
    if g >= 4096 && ptr_get(g + green_g_off_magic()) == green_g_magic() {
        fn_obj = ptr_get(g + green_g_off_fn_obj())
        args_list = ptr_get(g + green_g_off_args_list())
    }
    var head = g_trace_green_last_ops_head
    var idx = head % cap
    var slot = base_ptr + idx * 48
    ptr_set(slot + 0, op)
    ptr_set(slot + 8, g)
    ptr_set(slot + 16, fn_obj)
    ptr_set(slot + 24, args_list)
    ptr_set(slot + 32, extra)
    ptr_set(slot + 40, extra2)
    g_trace_green_last_ops_head = head + 1
    return 0
}

fn _green_last_ops_name(op) {
    if op == 1 { return "push_local" }
    if op == 2 { return "pop_local" }
    if op == 3 { return "steal_one" }
    if op == 4 { return "push_global" }
    if op == 5 { return "pop_global" }
    if op == 6 { return "entry" }
    return "unknown"
}

@oren.keep
fn oren_green_last_ops_dump() {
    if _green_last_ops_enabled() != true { return 0 }
    var cap = g_trace_green_last_ops_cap
    if cap <= 0 { return 0 }
    var base_ptr = g_trace_green_last_ops_ptr
    if base_ptr == 0 { return 0 }
    var head = g_trace_green_last_ops_head
    var n = head
    if n > cap { n = cap }
    var start = head - n
    print("trace: green_last_ops head=" + oren_int_to_string(head) +
          " cap=" + oren_int_to_string(cap) +
          " n=" + oren_int_to_string(n))
    var i = 0
    while i < n {
        var idx = (start + i) % cap
        var slot = base_ptr + idx * 48
        var op = ptr_get(slot + 0)
        var g = ptr_get(slot + 8)
        var fn_obj = ptr_get(slot + 16)
        var args_list = ptr_get(slot + 24)
        var extra = ptr_get(slot + 32)
        var extra2 = ptr_get(slot + 40)
        print("[green_last_op] idx=" + oren_int_to_string(idx) +
              " op=" + _green_last_ops_name(op) +
              " g=" + oren_int_to_string(g) +
              " fn=" + oren_int_to_string(fn_obj) +
              " args=" + oren_int_to_string(args_list) +
              " extra=" + oren_int_to_string(extra) +
              " extra2=" + oren_int_to_string(extra2))
        i = i + 1
    }
    return 0
}

fn _green_last_ops_maybe_dump(tick) {
    if _green_last_ops_enabled() != true { return 0 }
    var every = g_trace_green_last_ops_every
    if every <= 0 { return 0 }
    var last = g_trace_green_last_ops_last_tick
    if tick - last >= every {
        g_trace_green_last_ops_last_tick = tick
        oren_green_last_ops_dump()
    }
    return 0
}

fn _green_poll_cache_guard(label, ts, s, p, tick) {
    if _green_poll_cache_guard_enabled() != true { return 0 }
    var every = g_trace_green_poll_cache_guard_every
    if every > 1 {
        var rem = tick % every
        if rem != 0 { return 0 }
    }
    if ts == 0 || ts < 4096 {
        print("trace: green_poll_cache_guard " + label + " ts=" + oren_int_to_string(ts))
        oren_panic("green poll cache guard: bad ts")
        return 0
    }
    var ts_node = native_alloc_index_get(ts)
    if ts_node == 0 {
        print("trace: green_poll_cache_guard " + label + " ts=" + oren_int_to_string(ts) + " node=0")
        oren_panic("green poll cache guard: ts untracked")
        return 0
    }
    var ts_kind = ptr_get(iadd(ts_node, 16))
    if ts_kind != 4 {
        print("trace: green_poll_cache_guard " + label + " ts=" + oren_int_to_string(ts) +
              " node=" + oren_int_to_string(ts_node) + " kind=" + oren_int_to_string(ts_kind))
        oren_panic("green poll cache guard: ts kind")
        return 0
    }
    if s == 0 || s < 4096 {
        print("trace: green_poll_cache_guard " + label + " s=" + oren_int_to_string(s))
        oren_panic("green poll cache guard: bad s")
        return 0
    }
    var s_node = native_alloc_index_get(s)
    if s_node == 0 {
        print("trace: green_poll_cache_guard " + label + " s=" + oren_int_to_string(s) + " node=0")
        oren_panic("green poll cache guard: s untracked")
        return 0
    }
    var s_kind = ptr_get(iadd(s_node, 16))
    if s_kind != 4 {
        print("trace: green_poll_cache_guard " + label + " s=" + oren_int_to_string(s) +
              " node=" + oren_int_to_string(s_node) + " kind=" + oren_int_to_string(s_kind))
        oren_panic("green poll cache guard: s kind")
        return 0
    }
    if p != 0 {
        if p < 4096 {
            print("trace: green_poll_cache_guard " + label + " p=" + oren_int_to_string(p) + " small=1")
            oren_panic("green poll cache guard: small p")
            return 0
        }
        var p_node = native_alloc_index_get(p)
        if p_node == 0 {
            print("trace: green_poll_cache_guard " + label + " p=" + oren_int_to_string(p) + " node=0")
            oren_panic("green poll cache guard: p untracked")
            return 0
        }
        var p_kind = ptr_get(iadd(p_node, 16))
        if p_kind != 4 {
            print("trace: green_poll_cache_guard " + label + " p=" + oren_int_to_string(p) +
                  " node=" + oren_int_to_string(p_node) + " kind=" + oren_int_to_string(p_kind))
            oren_panic("green poll cache guard: p kind")
            return 0
        }
        var runq_buf = ptr_get(p + green_p_off_runq_buf())
        if runq_buf != 0 && runq_buf < 4096 {
            print("trace: green_poll_cache_guard " + label + " p=" + oren_int_to_string(p) +
                  " runq_buf=" + oren_int_to_string(runq_buf))
            oren_panic("green poll cache guard: bad runq_buf")
            return 0
        }
    }
    return 0
}

fn _green_args_guard_core(label, g) {
    if g == 0 { return 0 }
    if g < 4096 {
        print("trace: green_runq_guard " + label + " g=" + oren_int_to_string(g) + " small=1")
        oren_panic("green runq guard: small g")
        return 0
    }
    var magic = ptr_get(g + green_g_off_magic())
    if magic != green_g_magic() {
        print("trace: green_runq_guard " + label + " g=" + oren_int_to_string(g) +
              " magic=" + oren_int_to_string(magic))
        oren_panic("green runq guard: bad g magic")
        return 0
    }
    var args_list = ptr_get(g + green_g_off_args_list())
    if args_list == 0 { return 0 }
    if args_list < 4096 {
        print("trace: green_runq_guard " + label + " args=" + oren_int_to_string(args_list) + " small=1")
        oren_panic("green runq guard: small args_list")
        return 0
    }
    var node = _green_args_list_node(args_list, 1)
    if node == 0 {
        var magic = ptr_get(g + green_g_off_magic())
        var state = ptr_get(g + green_g_off_state())
        var fn_obj = ptr_get(g + green_g_off_fn_obj())
        var stack_node = ptr_get(g + green_g_off_stack_node())
        var stamp_ptr = ptr_get(g + green_g_off_args_stamp_ptr())
        var stamp_len = ptr_get(g + green_g_off_args_stamp_len())
        var stamp_cap = ptr_get(g + green_g_off_args_stamp_cap())
        var stamp_buf = ptr_get(g + green_g_off_args_stamp_buf())
        var stamp_magic = ptr_get(g + green_g_off_args_stamp_magic())
        print("trace: green_runq_guard " + label + " g=" + oren_int_to_string(g) +
              " magic=" + oren_int_to_string(magic) +
              " state=" + oren_int_to_string(state) +
              " stack_node=" + oren_int_to_string(stack_node) +
              " fn=" + oren_int_to_string(fn_obj) +
              " args=" + oren_int_to_string(args_list))
        print("trace: green_runq_guard " + label +
              " stamp ptr=" + oren_int_to_string(stamp_ptr) +
              " len=" + oren_int_to_string(stamp_len) +
              " cap=" + oren_int_to_string(stamp_cap) +
              " buf=" + oren_int_to_string(stamp_buf) +
              " magic=" + oren_int_to_string(stamp_magic))
        print("trace: green_runq_guard " + label + " args=" + oren_int_to_string(args_list) + " node=0")
        oren_panic("green runq guard: args_list untracked")
        return 0
    }
    var kind = ptr_get(iadd(node, 16))
    if kind != 2 {
        print("trace: green_runq_guard " + label + " args=" + oren_int_to_string(args_list) +
              " node=" + oren_int_to_string(node) + " kind=" + oren_int_to_string(kind))
        oren_panic("green runq guard: args_list kind")
        return 0
    }
    if ptr_get(iadd(args_list, 24)) != list_magic() {
        print("trace: green_runq_guard " + label + " args=" + oren_int_to_string(args_list) +
              " magic=" + oren_int_to_string(ptr_get(iadd(args_list, 24))))
        oren_panic("green runq guard: args_list magic")
        return 0
    }
    return args_list
}

fn _green_args_stamp_set(label, g) {
    if _green_trace_args_stamp_enabled() != true { return 0 }
    if g == 0 { return 0 }
    ptr_set(g + green_g_off_args_stamp_ptr(), 0)
    ptr_set(g + green_g_off_args_stamp_len(), 0)
    ptr_set(g + green_g_off_args_stamp_cap(), 0)
    ptr_set(g + green_g_off_args_stamp_buf(), 0)
    ptr_set(g + green_g_off_args_stamp_magic(), 0)
    var args_list = _green_args_guard_core(label, g)
    if args_list == 0 { return 0 }
    ptr_set(g + green_g_off_args_stamp_ptr(), args_list)
    ptr_set(g + green_g_off_args_stamp_len(), ptr_get(iadd(args_list, 0)))
    ptr_set(g + green_g_off_args_stamp_cap(), ptr_get(iadd(args_list, 8)))
    ptr_set(g + green_g_off_args_stamp_buf(), ptr_get(iadd(args_list, 16)))
    ptr_set(g + green_g_off_args_stamp_magic(), ptr_get(iadd(args_list, 24)))
    var stride = _green_trace_args_stamp_stride_value()
    if stride > 1 {
        g_trace_green_args_stamp_count = g_trace_green_args_stamp_count + 1
        if (g_trace_green_args_stamp_count % stride) != 0 { return 0 }
    }
    print("trace: green_args_stamp set " + label +
          " g=" + oren_int_to_string(g) +
          " args=" + oren_int_to_string(args_list) +
          " len=" + oren_int_to_string(ptr_get(iadd(args_list, 0))) +
          " cap=" + oren_int_to_string(ptr_get(iadd(args_list, 8))) +
          " buf=" + oren_int_to_string(ptr_get(iadd(args_list, 16))) +
          " magic=" + oren_int_to_string(ptr_get(iadd(args_list, 24))))
    return 0
}

fn _green_args_stamp_check(label, g, args_list) {
    if _green_trace_args_stamp_enabled() != true { return 0 }
    if g == 0 { return 0 }
    var stamp_ptr = ptr_get(g + green_g_off_args_stamp_ptr())
    if stamp_ptr == 0 { return 0 }
    if stamp_ptr - args_list != 0 {
        print("trace: green_args_stamp " + label + " ptr=" + oren_int_to_string(args_list) +
              " stamp_ptr=" + oren_int_to_string(stamp_ptr))
        oren_panic("green args stamp: ptr mismatch")
        return 0
    }
    var stamp_len = ptr_get(g + green_g_off_args_stamp_len())
    var stamp_cap = ptr_get(g + green_g_off_args_stamp_cap())
    var stamp_buf = ptr_get(g + green_g_off_args_stamp_buf())
    var stamp_magic = ptr_get(g + green_g_off_args_stamp_magic())
    var cur_len = ptr_get(iadd(args_list, 0))
    var cur_cap = ptr_get(iadd(args_list, 8))
    var cur_buf = ptr_get(iadd(args_list, 16))
    var cur_magic = ptr_get(iadd(args_list, 24))
    if stamp_len - cur_len != 0 ||
       stamp_cap - cur_cap != 0 ||
       stamp_buf - cur_buf != 0 ||
       stamp_magic - cur_magic != 0 {
        print("trace: green_args_stamp " + label + " list=" + oren_int_to_string(args_list) +
              " stamp_len=" + oren_int_to_string(stamp_len) +
              " cur_len=" + oren_int_to_string(cur_len) +
              " stamp_cap=" + oren_int_to_string(stamp_cap) +
              " cur_cap=" + oren_int_to_string(cur_cap) +
              " stamp_buf=" + oren_int_to_string(stamp_buf) +
              " cur_buf=" + oren_int_to_string(cur_buf) +
              " stamp_magic=" + oren_int_to_string(stamp_magic) +
              " cur_magic=" + oren_int_to_string(cur_magic))
        oren_panic("green args stamp: header mismatch")
        return 0
    }
    return 0
}

fn _green_args_stamp_guard(label, g) {
    if _green_trace_args_stamp_enabled() != true { return 0 }
    var args_list = _green_args_guard_core(label, g)
    if args_list == 0 { return 0 }
    _green_args_stamp_check(label, g, args_list)
    return 0
}

fn _green_runq_guard(label, g) {
    if _green_runq_guard_enabled() != true { return 0 }
    var args_list = _green_args_guard_core(label, g)
    if args_list == 0 { return 0 }
    _green_args_stamp_check(label, g, args_list)
    return 0
}

fn _green_alloc_struct(size) {
    // Green-task runtime needs a small GC-visible struct allocation hook, but we cannot
    // depend on `oren_alloc_struct` ordering (defined later in 120_first_class_fn.oren).
    //
    // Allocate raw first and let callers publish kind=STRUCT only after all pointer fields
    // are initialized. Otherwise forced GC can conservatively follow garbage pointers.
    return malloc(size)
}

fn _green_retag_struct(ptr, size) {
    if ptr == 0 { return 0 }
    var node = native_gc_find_node_nolock(ptr)
    if node == 0 {
        native_alloc_index_rebuild_live()
        node = native_gc_find_node_nolock(ptr)
    }
    if node == 0 && oren_globals() != 0 {
        // Last-resort: ensure the struct is tracked so GC can scan scheduler state.
        oren_track_alloc_new(ptr, size, 4)
        node = native_gc_find_node_nolock(ptr)
    }
    if node != 0 {
        // node.kind at offset 16
        ptr_set(iadd(node, 16), 4)
    }
    return ptr
}

fn _green_find_current_stack_node_or0() {
    // Best-effort "which stack am I on?" heuristic.
    //
    // Reimplemented locally (instead of calling TIME internals) so it stays reachable even when
    // the native build is single-threaded and the TIME per-thread path is pruned.
    if oren_globals() == 0 { return 0 }
    var sp = get_sp()
    var node = global_get_threads()
    var max_scan = 8388608 // 8MB
    while node != 0 {
        var top = ptr_get(node)
        if sp < top {
            var diff = top - sp
            if diff < max_scan { return node }
        }
        node = ptr_get(node + 16)
    }
    return 0
}

fn _green_alloc_stack_bytes() {
    // Default 1 MiB per green stack (rolling).
    // Env override: OREN_GREEN_STACK_KB=<n> (clamped).
    var kb = 1024
    var v = native_envp_get_value_ptr("OREN_GREEN_STACK_KB")
    if v != 0 {
        var n = native_parse_i64_dec_cstr_or_neg1(v)
        if n > 0 {
            if n < 64 { n = 64 }
            if n > 16384 { n = 16384 }
            kb = n
        }
    }
    return kb * 1024
}

fn _green_init_if_needed() {
    if _green_enabled() != true { return 0 }
    if g_green_inited != 0 { return 0 }

    // Allocate scheduler state as a GC-managed struct and root it.
    var s = _green_alloc_struct(green_s_bytes())
    if s == 0 { exit(901) }

    // Allocate the scheduler-private lock word (one page; u64 at offset 0).
    // This lock protects scheduler state without coupling to the runtime global lock.
    if g_green_sched_lock_word == 0 {
        var lword = sys_mmap_private_anon(4096)
        if lword == 0 || lword == -1 || lword < 4096 { exit(900) }
        ptr_set(lword, 0)
        g_green_sched_lock_word = lword
    }
    // Allocate debug counters (one page; u64 at offsets).
    if g_green_debug_word == 0 {
        var dword = sys_mmap_private_anon(4096)
        if dword == 0 || dword == -1 || dword < 4096 { exit(899) }
        ptr_set(dword, 0)
        g_green_debug_word = dword
    }
    // Allocate a worker readiness counter word (one page; u64 at offset 0).
    // This is best-effort and used only by fixtures to stabilize bring-up sequencing.
    if g_green_workers_ready_word == 0 {
        var rword = sys_mmap_private_anon(4096)
        if rword == 0 || rword == -1 || rword < 4096 { exit(898) }
        ptr_set(rword, 0)
        g_green_workers_ready_word = rword
    }
    // Allocate P0 (single-P default; more Ps are optional/unsafe today).
    var p0 = _green_alloc_struct(green_p_bytes())
    if p0 == 0 { exit(902) }
    // Allocate local runq buffer as a GC-scanned "struct" so runnable G pointers are retained.
    var runq_mask = _green_p_runq_mask_default()
    var runq_buf = _green_alloc_struct((runq_mask + 1) * 8)
    if runq_buf == 0 { exit(903) }
    // Explicitly clear the buffer (malloc is not guaranteed to be zeroed).
    var i = 0
    while i <= runq_mask {
        ptr_set(runq_buf + i * 8, 0)
        i = i + 1
    }
    _green_retag_struct(runq_buf, (runq_mask + 1) * 8)
    _green_p_set_runq_buf(p0, runq_buf)
    _green_p_set_runq_head(p0, 0)
    _green_p_set_runq_tail(p0, 0)
    _green_p_set_runq_mask(p0, runq_mask)
    _green_p_set_sleep_head(p0, 0)
    _green_p_set_sleep_tail(p0, 0)
    ptr_set(p0 + green_p_off_id(), 0)
    _green_p_set_next(p0, 0)
    _green_p_set_owner_tid(p0, 0)
    _green_p_set_idle_next(p0, 0)
    _green_retag_struct(p0, green_p_bytes())

    _green_state_set_p0(s, p0)
    _green_state_set_p_count(s, 1)
    _green_state_set_zomb_head(s, 0)
    _green_state_set_glob_run_head(s, 0)
    _green_state_set_glob_run_tail(s, 0)
    _green_state_set_idle_p_head(s, 0)
    _green_state_set_idle_p_tail(s, 0)
    _green_state_set_word_wait_head(s, 0)
    _green_idle_p_push_locked(s, p0)
    _green_retag_struct(s, green_s_bytes())
    _green_set_state(s)
    native_gc_register_root_tag(s, 5)

    // Per-OS-thread scheduler context buffers are allocated lazily in
    // `_green_thread_state_for_current_thread_or0()`.

    g_green_inited = 1
    return 0
}

fn _green_atomic_inc_u64(word_ptr) {
    if word_ptr == 0 { return 0 }
    while true {
        var old = ptr_get(word_ptr)
        var new = iadd(old, 1)
        if atomic_cas(word_ptr, old, new) == old { return new }
    }
    return 0
}

fn _green_world_lock_acquire() {
    if g_green_world_lock_enabled == 0 { return 0 }
    var lock_ptr = g_green_world_lock_word
    if lock_ptr == 0 { return 0 }
    var tid = sys_gettid()
    if tid == 0 { exit(939) }
    var spin = 0
    while atomic_cas(lock_ptr, 0, tid) != 0 {
        spin = spin + 1
        if spin > 1000 {
            var owner = ptr_get(lock_ptr)
            if owner != 0 {
                // STW GC robustness: never block indefinitely while waiting to enter Oren code.
                oren_gc_safepoint()
                oren_wait_on_addr(lock_ptr, owner, 1000) // 1ms
            }
            spin = 0
        }
    }
    return 0
}

fn _green_world_lock_release() {
    if g_green_world_lock_enabled == 0 { return 0 }
    var lock_ptr = g_green_world_lock_word
    if lock_ptr == 0 { return 0 }
    var tid = sys_gettid()
    if tid == 0 { exit(939) }
    atomic_cas(lock_ptr, tid, 0)
    oren_wake_all_addr(lock_ptr)
    return 0
}

fn _green_world_lock_host_enabled() {
    if g_green_world_lock_enabled == 0 { return 0 }
    if g_green_workers_started == 0 { return 0 }
    if g_green_world_lock_word == 0 { return 0 }
    return 1
}

fn _green_world_lock_host_enter() {
    if _green_world_lock_host_enabled() == 0 { return 0 }
    var lock_ptr = g_green_world_lock_word
    if lock_ptr == 0 { return 0 }
    var tid = sys_gettid()
    if tid == 0 { return 0 }
    if ptr_get(lock_ptr) == tid { return 2 } // already held by this thread
    _green_world_lock_acquire()
    return 1
}

fn _green_world_lock_host_exit(token) {
    if token == 1 {
        _green_world_lock_release()
    }
    return 0
}

@oren.keep
fn oren_green_debug_worker_tid(worker_id) {
    // Fixture helper: get worker tid for worker_id (reserved P id).
    if worker_id < 0 { return 0 }
    if worker_id >= 64 { return 0 }
    var p = g_green_worker_tid_word
    if p == 0 || p == -1 || p < 4096 { return 0 }
    return ptr_get(p + worker_id * 8)
}

@oren.keep
fn oren_green_debug_wake_worker(worker_id) {
    // Fixture helper: post a wake token for a specific worker.
    if worker_id < 0 { return -1 }
    if worker_id >= 64 { return -1 }
    if g_green_workers_started == 0 { return -1 }
    var base = g_green_worker_wake_word
    if base == 0 || base == -1 || base < 4096 { return -1 }
    var wc = g_green_worker_count
    if worker_id >= wc { return -1 }
    return oren_m_park_word_wake(base + worker_id * 8)
}

@oren.keep
fn oren_green_debug_clear_worker_wake(worker_id) {
    // Fixture helper: clear a pending wake token (best-effort).
    if worker_id < 0 { return -1 }
    if worker_id >= 64 { return -1 }
    var base = g_green_worker_wake_word
    if base == 0 || base == -1 || base < 4096 { return -1 }
    ptr_set(base + worker_id * 8, 0)
    return 0
}

