// --- Native green tasks (rolling; GMP-ready) ---
//
// Goal (Stage N1, per `docs/DESIGN.md#runtime-and-stdlib-layering`):
// - Provide an in-process lightweight task substrate so:
//   - macOS/Linux native `spawn` no longer uses fork+pipe
//   - heap/GC/locks are in a single shared address space (required for correctness later)
// - Keep the runtime shape aligned with the eventual G-M-P model:
//   - Today: single M (one OS thread) + cooperative scheduling
//   - Later: multiple M + multiple P (work-stealing, netpoller, etc.)
//
// NOTE (rolling):
// - This first landing is intentionally conservative: correctness first, then throughput.
// - This does NOT yet make blocking syscalls non-blocking across tasks, except for `sleep`.

fn _green_p_runq_cap(p) { return _green_p_runq_mask(p) + 1 }

fn _green_p_runq_mask_default() {
    // Default per-P local runq capacity (power of two).
    // Keep bounded: too large increases GC scanning overhead; too small increases global queue pressure.
    return 255 // cap=256
}

fn _green_state_p_by_id_or0(s, id) {
    if s == 0 { return 0 }
    var p = _green_state_p0(s)
    while p != 0 {
        if ptr_get(p + green_p_off_id()) == id { return p }
        p = _green_p_next(p)
    }
    return 0
}

fn _green_current_p_or0() {
    // Best-effort: use thread-local P binding. Fallback to P0.
    // NOTE: this may lazily allocate thread-local scheduler state.
    var ts = _green_thread_state_for_current_thread_or0()
    var s = _green_get_state()
    if ts == 0 {
        if s == 0 { return 0 }
        return _green_state_p0(s)
    }
    var p = _green_thread_p_or0(ts)
    if p != 0 { return p }
    if s == 0 { return 0 }
    var p0 = _green_state_p0(s)
    if p0 != 0 { _green_thread_set_p(ts, p0) }
    return p0
}

fn _green_is_g(ptr) {
    if ptr == 0 { return false }
    // Avoid crashing on small integers: treat <4096 as not a pointer.
    if ptr < 4096 { return false }
    // Best-effort: check magic first.
    return ptr_get(ptr + green_g_off_magic()) == green_g_magic()
}

fn _green_trace_runq_enabled() {
    if g_trace_green_runq == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_green_runq == 0 {
        if cur_envp == g_trace_green_runq_envp &&
           cur_argv == g_trace_green_runq_argv &&
           cur_argc == g_trace_green_runq_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_GREEN_RUNQ_ARGS")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_green_runq == -1 || g_trace_green_runq == 0 {
            g_trace_green_runq = 0
            g_trace_green_runq_envp = cur_envp
            g_trace_green_runq_argv = cur_argv
            g_trace_green_runq_argc = cur_argc
        }
        return false
    }
    g_trace_green_runq = 1
    g_trace_green_runq_envp = cur_envp
    g_trace_green_runq_argv = cur_argv
    g_trace_green_runq_argc = cur_argc
    return true
}

fn _green_trace_runq_event(label, g) {
    if _green_trace_runq_enabled() != true { return 0 }
    if g == 0 {
        print("trace: green_runq " + label + " g=0")
        return 0
    }
    if g < 4096 {
        print("trace: green_runq " + label + " g=" + oren_int_to_string(g) + " small=1")
        return 0
    }
    var node = native_alloc_index_get(g)
    if node == 0 { node = native_alloc_index_recover_ptr(g) }
    var kind = 0
    if node != 0 { kind = ptr_get(iadd(node, 16)) }
    var magic = 0
    var fn_obj = 0
    var args_list = 0
    var args_node = 0
    var args_kind = 0
    if node != 0 && kind == 4 {
        magic = ptr_get(g + green_g_off_magic())
        fn_obj = ptr_get(g + green_g_off_fn_obj())
        args_list = ptr_get(g + green_g_off_args_list())
        if args_list >= 4096 {
            args_node = _green_args_list_node(args_list, 1)
            if args_node != 0 { args_kind = ptr_get(iadd(args_node, 16)) }
        }
    }
    print("trace: green_runq " + label +
          " g=" + oren_int_to_string(g) +
          " node=" + oren_int_to_string(node) +
          " kind=" + oren_int_to_string(kind) +
          " magic=" + oren_int_to_string(magic) +
          " fn=" + oren_int_to_string(fn_obj) +
          " args=" + oren_int_to_string(args_list) +
          " args_node=" + oren_int_to_string(args_node) +
          " args_kind=" + oren_int_to_string(args_kind))
    return 0
}

fn _green_args_list_node(args_list, allow_retrack) {
    if args_list == 0 { return 0 }
    var node = native_alloc_index_get(args_list)
    if node == 0 { node = native_alloc_index_recover_ptr(args_list) }
    if node == 0 && allow_retrack == 1 {
        native_alloc_index_rebuild_live()
        node = native_alloc_index_get(args_list)
        if node == 0 { node = native_alloc_index_recover_ptr(args_list) }
    }
    if node == 0 && allow_retrack == 1 {
        if args_list >= 4096 && ptr_get(iadd(args_list, 24)) == list_magic() {
            var cap = ptr_get(iadd(args_list, 8))
            var len = ptr_get(iadd(args_list, 0))
            if cap >= 0 && cap < 1048576 && len >= 0 && len <= cap {
                var total = 32
                if cap > 0 { total = total + cap * 8 }
                oren_track_alloc_new(args_list, total, 2)
                node = native_alloc_index_get(args_list)
            }
        }
    }
    return node
}

