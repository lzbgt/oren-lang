fn _green_poll_until_budget(deadline_ns, max_steps) {
    // deadline_ns == 0 means "run until no runnable work" (but still drive sleepers minimally).
    _green_init_if_needed()
    if _green_enabled() != true { return 0 }
    // Rolling safety:
    // Default to the conservative mode (re-fetch per-thread scheduler state each iteration).
    // Cached mode is opt-in (env `OREN_GREEN_POLL_CACHE=1` or `oren_green_set_poll_cache_mode(1)`).
    //
    // Motivation:
    // - Historically, caching `ts`/`p` across iterations could surface backend register/stack
    //   preservation bugs as "locals collapse into small ints" and later segfault in `ptr_get`.
    // - The default mode keeps worker scheduling robust while backends evolve.
    var cache = 0
    if _green_poll_cache() { cache = 1 }
    // Cached poll mode is opt-in even in worker mode. When workers are active, we
    // must refresh cached P bindings across ownership transitions (see p-epoch below).

    var ts = 0
    var s = 0
    var p = 0
    var p_epoch = 0

    if cache != 0 {
        // One-time fetch for the cached path.
        ts = _green_thread_state_for_current_thread_or0()
        if ts == 0 { return 0 }
        s = _green_get_state()
        if s == 0 { return 0 }
        p = _green_thread_p_or0(ts)
        p_epoch = _green_thread_p_epoch(ts)
        // In worker mode (Stage N3 / M<P evolution), a worker may intentionally clear its thread-local
        // P binding while parked. Do not forcibly rebind to P0 here; let the worker acquire from the
        // idle-P pool under the lock below.
        if p == 0 && g_green_workers_started == 0 {
            p = _green_state_p0(s)
            if p != 0 { _green_thread_set_p(ts, p) }
        }
        if g_green_workers_started == 0 {
            if p == 0 { return 0 }
            if p < 4096 { exit(940) }
        } else {
            if p != 0 && p < 4096 { exit(940) }
        }
        _green_poll_cache_guard("init", ts, s, p)
    }
    var tick = 0
    var steps_left = max_steps

    while 1 {
        if cache == 0 {
            // Ensure per-thread scheduler state exists for this OS thread.
            ts = _green_thread_state_for_current_thread_or0()
            if ts == 0 { return 0 }
            s = _green_get_state()
            if s == 0 { return 0 }

            p = _green_thread_p_or0(ts)
            if p == 0 && g_green_workers_started == 0 {
                p = _green_state_p0(s)
                if p != 0 { _green_thread_set_p(ts, p) }
            }
            if g_green_workers_started == 0 {
                if p == 0 { return 0 }
                if p < 4096 { exit(940) }
            } else {
                if p != 0 && p < 4096 { exit(940) }
            }
        } else {
            // Cached mode: keep cheap sanity checks so corruption fails fast/loud.
            //
            // NOTE (worker mode / M<P evolution):
            // a worker can intentionally clear its thread-local P binding while parked, so `p` may become 0.
            // Allow refreshing `p` without abandoning cached mode entirely.
            if ts == 0 || s == 0 { return 0 }
            var epoch_now = _green_thread_p_epoch(ts)
            if p_epoch != epoch_now {
                p_epoch = epoch_now
                p = _green_thread_p_or0(ts)
            }
            if p == 0 { p = _green_thread_p_or0(ts) }
            if p == 0 && g_green_workers_started == 0 {
                p = _green_state_p0(s)
                if p != 0 { _green_thread_set_p(ts, p) }
            }
            if g_green_workers_started == 0 {
                if p == 0 { return 0 }
                if p < 4096 { exit(940) }
            } else {
                if p != 0 && p < 4096 { exit(940) }
            }
            _green_poll_cache_guard("loop", ts, s, p)
        }
        if g_green_workers_started != 0 {
            // Stage N3: enforce "an M runs Oren code only while holding a P".
            //
            // Rolling semantics:
            // - an idle worker may temporarily set `P.owner_tid=0` while blocked (release)
            // - a parked worker may also clear its thread-local P binding (to allow M<P acquisition)
            // - upon wake, the worker must acquire some P before running Oren code
            var tid = sys_gettid()
            if tid == 0 { exit(926) }
            _green_lock_acquire()

            var rc_own = 0
            if p != 0 {
                rc_own = _green_p_ensure_owned_by_tid_locked(s, p, tid)
                if rc_own == (0 - 16) {
                    // This M lost its bound P (or another M acquired it while we were parked).
                    // Clear the binding and acquire any available P.
                    p = 0
                    _green_thread_set_p(ts, 0)
                }
            }
            if p == 0 {
                var alt = _green_worker_try_acquire_any_p_locked(s, tid)
                if alt != 0 {
                    p = alt
                    _green_thread_set_p(ts, alt)
                    rc_own = 0
                } else {
                    rc_own = 0 - 16 // -EBUSY
                }
            }

            _green_lock_release()
            if rc_own == (0 - 16) {
                // No P available: treat as idle for now and let the worker park.
                return 0
            }
            if rc_own != 0 { exit(927) }
        }

        // World-lock mode (safe multi-worker bring-up):
        // When multiple workers exist and the native allocator/GC are not concurrency-correct,
        // ensure only one OS thread executes scheduler+task code at a time.
        var wl = 0
        if g_green_workers_started != 0 && g_green_worker_count > 1 && g_green_world_lock_enabled != 0 {
            _green_world_lock_acquire()
            wl = 1
        }

        // Fairness tick: periodically prefer draining from the global run queue even if the local
        // runq is non-empty, so spawns from non-green threads cannot starve indefinitely.
        tick = tick + 1

        // Drain detached tasks that completed.
        _green_zombie_drain()

        var now = _green_time_now_ns()
        if now != 0 {
            // Drain ready IO events (netpoller) and mark their Gs as ready-to-wake at `now`.
            // Keep this bounded so a storm of IO events can't starve runnable work.
            _green_netpoll_drain_ready(ts, now, 32)

            // Wake sleepers across all Ps (future-proof for M < P and for global timeouts).
            _green_wake_ready_all(now)
            if deadline_ns != 0 && now >= deadline_ns {
                if wl != 0 { _green_world_lock_release() }
                return 0
            }
        }

        // Prefer the global run queue periodically for fairness.
        var prefer_global = 0
        if (tick & 31) == 0 { prefer_global = 1 }

        _green_lock_acquire()
        var g = _green_runq_pop_any_locked(p, s, prefer_global)
        _green_lock_release()
        if g != 0 {
            _green_sched_switch_to(g)
            // After returning, decide whether to requeue.
            var st = ptr_get(g + green_g_off_state())
            if st == green_g_state_runnable() {
                _green_runq_push_p(p, g)
            } else if st == green_g_state_exiting() {
                // Finalize DONE on the scheduler stack, then wake joiners waiting on the state word.
                ptr_set(g + green_g_off_state(), green_g_state_done())
                oren_wake_all_addr(g + green_g_off_state())
                // Detached tasks are cleaned immediately by scheduler.
                if ptr_get(g + green_g_off_detached()) != 0 {
                    _green_zombie_push(g)
                }
            } else if st == green_g_state_done() {
                // Detached tasks are cleaned immediately by scheduler.
                if ptr_get(g + green_g_off_detached()) != 0 {
                    _green_zombie_push(g)
                }
            } else if st == green_g_state_word_wait() {
                // Parked on the scheduler word-wait list (wait-on-address).
                // Already enqueued by the waiter before switching back to the scheduler.
            } else {
                // sleeping: enqueue into sleepq now that the task context is saved/paused.
                _green_sleepq_push_p(p, g)
            }
            if max_steps > 0 {
                steps_left = steps_left - 1
                if steps_left <= 0 {
                    if wl != 0 { _green_world_lock_release() }
                    return 0
                }
            }
            if wl != 0 { _green_world_lock_release() }
            continue
        }

        // No runnable tasks. If no sleepers, we're idle.
        var next_wake = _green_next_wake_ns_all()
        if next_wake == 0 {
            if wl != 0 { _green_world_lock_release() }
            return 0
        }

        // Idle sleep: do not oversleep past the join deadline.
        var now2 = _green_time_now_ns()
        if now2 == 0 {
            // Rolling robustness: if the clock is unavailable or temporarily fails, do not
            // treat this as "idle". Returning would let worker threads park forever while
            // sleepers exist, which can deadlock joins.
            if wl != 0 { _green_world_lock_release() }
            sys_nanosleep(1000000) // 1ms
            continue
        }
        var sleep_ns = next_wake - now2
        if sleep_ns <= 0 {
            // Should be woken on next iteration.
            if wl != 0 { _green_world_lock_release() }
            continue
        }
        // Debug: count idle loop iterations (regression guard for "idle does not spin").
        var dbg_idle = g_green_debug_word
        if dbg_idle != 0 && dbg_idle != -1 && dbg_idle >= 4096 {
            _green_atomic_inc_u64(dbg_idle)
        }
        if deadline_ns != 0 {
            var rem = deadline_ns - now2
            if rem <= 0 {
                if wl != 0 { _green_world_lock_release() }
                return 0
            }
            if sleep_ns > rem { sleep_ns = rem }
        }
        if g_netpoll_inited != 0 && native_netpoll_can_block() == true {
            // STW GC robustness: before blocking in the kernel readiness wait, poll the STW state.
            // If a collector requested stop-the-world, park on this scheduler stack now.
            oren_gc_safepoint()
            if g_green_workers_started != 0 {
                // Release P while blocked in kevent/epoll (future-proof for M<P).
                // Also clear the thread-local P binding so on wake we can acquire any idle P.
                var tid2 = sys_gettid()
                if tid2 != 0 {
                    _green_lock_acquire()
                    _green_p_release_if_owned_by_tid_locked(s, p, tid2)
                    _green_thread_set_p(ts, 0)
                    _green_lock_release()
                    p = 0
                }
            }
            // Prefer blocking in the kernel readiness wait:
            // - wakes on IO readiness (netpoll tokens)
            // - wakes on explicit runtime nudge (wake pipe)
            // - wakes on timeout to re-check sleepers and join deadlines
            //
            // With netpoll + wake pipe, we can safely sleep longer than the old 10ms clamp:
            // - runnable work injection wakes via `_green_workers_wake_if_started()` -> `native_netpoll_wake()`
            // - IO readiness wakes via netpoll tokens
            // Keep a conservative upper bound anyway so a broken wake path cannot stall forever.
            //
            // Worker-mode STW note:
            // STW safepoints are cooperative; a worker blocked in kevent/epoll/select must wake so it
            // can observe stop-the-world requests and park.
            //
            // Rolling improvement:
            // - STW now explicitly calls `native_netpoll_wake()` when it begins/ends.
            // - If the poll backend has a working wake mechanism, we can safely sleep "long" (bounded)
            //   without a 10ms polling clamp.
            //
            // Robust fallback:
            // - On Windows in capsule mode, a wake socket may be unavailable; in that case, keep a
            //   short bound so STW and other nudges are observed promptly via periodic wakeups.
            if g_green_workers_started != 0 {
                if native_netpoll_can_wake() == true {
                    if sleep_ns > 1000000000 { sleep_ns = 1000000000 } // 1s
                } else {
                    if sleep_ns > 10000000 { sleep_ns = 10000000 } // 10ms
                }
            } else {
                if sleep_ns > 1000000000 { sleep_ns = 1000000000 } // 1s
            }
            var sleep_ms = sleep_ns / 1000000
            if sleep_ms <= 0 { sleep_ms = 1 }
            var want_wl = wl
            if wl != 0 {
                _green_world_lock_release()
                wl = 0
            }
            var scratch2 = _green_thread_netpoll_scratch_or0(ts)
            if scratch2 != 0 {
                var got = native_netpoll_poll_many_scratch(sleep_ms, scratch2, green_t_netpoll_scratch_bytes())
                if got > 0 {
                    // Re-acquire P before touching runtime heap state.
                    // Keep lock ordering consistent with the main loop: scheduler lock -> world lock.
                    if g_green_workers_started != 0 {
                        var tid3 = sys_gettid()
                        if tid3 != 0 {
                            _green_lock_acquire()
                            var rc_own2 = 0
                            if p != 0 {
                                rc_own2 = _green_p_ensure_owned_by_tid_locked(s, p, tid3)
                                if rc_own2 == (0 - 16) {
                                    p = 0
                                    _green_thread_set_p(ts, 0)
                                }
                            }
                            if p == 0 {
                                var alt2 = _green_worker_try_acquire_any_p_locked(s, tid3)
                                if alt2 != 0 {
                                    p = alt2
                                    _green_thread_set_p(ts, alt2)
                                    rc_own2 = 0
                                } else {
                                    rc_own2 = 0 - 16
                                }
                            }
                            _green_lock_release()
                            if rc_own2 != 0 { exit(927) }
                        }
                    }
                    if want_wl != 0 {
                        _green_world_lock_acquire()
                        wl = 1
                    }
                    // Consume tokens: mark corresponding Gs as ready-to-wake.
                    var now3 = _green_time_now_ns()
                    if now3 == 0 { now3 = now2 }
                    if now3 != 0 {
                        var i2 = 0
                        while i2 < got {
                            var tok = ptr_get(scratch2 + i2 * 8)
                            if tok != 0 { _green_netpoll_mark_ready(tok, now3) }
                            i2 = i2 + 1
                        }
                    }
                }
            } else {
                var tok = native_netpoll_poll_one(sleep_ms)
                if tok != 0 {
                    // Re-acquire P before touching runtime heap state.
                    // Keep lock ordering consistent with the main loop: scheduler lock -> world lock.
                    if g_green_workers_started != 0 {
                        var tid3 = sys_gettid()
                        if tid3 != 0 {
                            _green_lock_acquire()
                            var rc_own2 = 0
                            if p != 0 {
                                rc_own2 = _green_p_ensure_owned_by_tid_locked(s, p, tid3)
                                if rc_own2 == (0 - 16) {
                                    p = 0
                                    _green_thread_set_p(ts, 0)
                                }
                            }
                            if p == 0 {
                                var alt2 = _green_worker_try_acquire_any_p_locked(s, tid3)
                                if alt2 != 0 {
                                    p = alt2
                                    _green_thread_set_p(ts, alt2)
                                    rc_own2 = 0
                                } else {
                                    rc_own2 = 0 - 16
                                }
                            }
                            _green_lock_release()
                            if rc_own2 != 0 { exit(927) }
                        }
                    }
                    if want_wl != 0 {
                        _green_world_lock_acquire()
                        wl = 1
                    }
                    // Consume the token: mark the corresponding G as ready-to-wake.
                    var now3 = _green_time_now_ns()
                    if now3 == 0 { now3 = now2 }
                    if now3 != 0 {
                        _green_netpoll_mark_ready(tok, now3)
                    }
                }
            }
            if wl != 0 { _green_world_lock_release() }
            continue
        }

        // Clamp to avoid huge sleeps in rolling mode; keep responsiveness when netpoll is unavailable.
        if sleep_ns > 10000000 { sleep_ns = 10000000 } // 10ms
        if g_green_workers_started != 0 && g_green_worker_wake_word != 0 {
            // Worker-mode: park on the per-worker wake word with a timeout.
            var wptr = g_green_worker_wake_word
            var wid = _green_thread_worker_id_or_neg1(ts)
            if wid >= 0 && wid < g_green_worker_count {
                wptr = g_green_worker_wake_word + wid * 8
            }
            var tid2 = sys_gettid()
            if tid2 != 0 {
                _green_lock_acquire()
                _green_p_release_if_owned_by_tid_locked(s, p, tid2)
                _green_thread_set_p(ts, 0)
                _green_lock_release()
                p = 0
            }
            var sleep_us = sleep_ns / 1000
            if sleep_us <= 0 { sleep_us = 1 }
            if wl != 0 { _green_world_lock_release() }
            oren_m_park_word_wait(wptr, sleep_us)
        } else {
            if wl != 0 { _green_world_lock_release() }
            sys_nanosleep(sleep_ns)
        }
    }
}

fn _green_poll_until(deadline_ns) {
    return _green_poll_until_budget(deadline_ns, 0)
}
