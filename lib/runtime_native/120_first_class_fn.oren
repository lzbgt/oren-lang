// --- First-class functions (native backend) ---
//
// Representation (tracked allocation kind=6):
//   [0] code_ptr (u64)  - entrypoint taking (env, args_list)
//   [8] env_ptr  (u64)  - closure environment (typically a list), or 0
@oren.keep
fn oren_func(code_ptr, env_ptr) {
    if code_ptr == 0 { return 0 }
    var obj = malloc(16)
    if obj == 0 { exit(320) }
    ptr_set(obj, code_ptr)
    ptr_set(iadd(obj, 8), env_ptr)
    // Update kind to 6 (FUNC) so GC can traverse env_ptr.
    var node = oren_find_node(obj)
    if node != 0 {
        ptr_set(iadd(node, 16), 6)
    }
    return obj
}

// Spawn a callable object with an args list.
//
// This is the syscall-first native analogue of the C backend's spawn-callable helper.
// It returns the same handle layout expected by `oren_join(handle)`:
//   [0]  pid (u64)
//   [8]  read_fd (u64)
//   [16] got (u64)        - number of bytes already read into inline result buffer
//   [24] result_buf (u64) - inline 8-byte result buffer (filled by is_done/join)
@oren.keep
fn oren_spawn_call_list(fn_obj, args_list) {
    var pipe_buf = malloc(16)
    if pipe_buf == 0 { exit(321) }
    var rv = sys_pipe(pipe_buf)
    // Linux pipe2 returns 0 on success and -errno on failure.
    // Treat any negative return as failure so the runtime remains robust even if
    // a backend temporarily clobbers the syscall return value with a non-negative scratch.
    if rv < 0 { exit(322) }

    var rfd = ptr_get(pipe_buf)
    var wfd = ptr_get(iadd(pipe_buf, 8))

    // IMPORTANT (fork hygiene):
    // Use `oren_fork()` (not raw `sys_fork()`) so the child resets any inherited
    // in-memory locks before doing further allocations/capsule bookkeeping.
    var pid = oren_fork()
    if pid == 0 {
        // Child
        var dbg = native_envp_get_value_ptr("OREN_DEBUG_SPAWN")
        if dbg != 0 {
            if ptr_get_byte(dbg) != 0 {
                print("spawn debug (child):")
                print("  pipe.rfd=" + oren_int_to_string(rfd))
                print("  pipe.wfd=" + oren_int_to_string(wfd))
            }
        }
        sys_close(rfd)
        var ret = 0
        if dbg != 0 {
            if ptr_get_byte(dbg) != 0 {
                print("  fn_obj=" + oren_int_to_string(fn_obj))
                if fn_obj != 0 {
                    print("  fn.code_ptr=" + oren_int_to_string(ptr_get(fn_obj)))
                    print("  fn.env_ptr=" + oren_int_to_string(ptr_get(iadd(fn_obj, 8))))
                }
                print("  args_list=" + oren_int_to_string(args_list))
                print("  args_len=" + oren_int_to_string(oren_list_len(args_list)))
                if oren_list_len(args_list) > 0 {
                    print("  args[0]=" + oren_int_to_string(oren_list_get(args_list, 0)))
                }
            }
        }

        ret = oren_call_obj_list(fn_obj, args_list)
        if dbg != 0 {
            if ptr_get_byte(dbg) != 0 {
                print("  ret=" + oren_int_to_string(ret))
            }
        }
        // Reuse the pre-fork heap buffer as the 8-byte write buffer.
        // This avoids taking the allocator lock in the child before user code runs.
        ptr_set(pipe_buf, ret)
        sys_write(wfd, pipe_buf, 8)
        sys_close(wfd)
        exit(0)
        return 0
    }

        // Parent
    sys_close(wfd)
    var dbg_p = native_envp_get_value_ptr("OREN_DEBUG_SPAWN")
    if dbg_p != 0 {
        if ptr_get_byte(dbg_p) != 0 {
            print("spawn debug (parent):")
            print("  pid=" + oren_int_to_string(pid))
            print("  pipe.rfd=" + oren_int_to_string(rfd))
            print("  pipe.wfd=" + oren_int_to_string(wfd))
        }
    }
    free(pipe_buf)

    var handle = malloc(32)
    if handle == 0 { exit(324) }
    ptr_set(handle, pid)
    ptr_set(iadd(handle, 8), rfd)
    ptr_set(iadd(handle, 16), 0) // got
    ptr_set(iadd(handle, 24), 0) // result_buf
    return handle
}

// --- Windows x64 Tier‑1: thread entry for language `spawn` ---
//
// Windows does not have fork/exec; the x64 backend lowers `spawn` to CreateThread, passing
// a pointer to a small arg struct.
//
// Arg layout (written by the x64 code generator):
//   [0]  fn_obj
//   [8]  args_list
//   [16] result_ptr (u64*)
//   [24] auto_free (u64; 0=normal, 1=detach cleanup by thread)
//
// Returns a DWORD (u32) to satisfy CreateThread's LPTHREAD_START_ROUTINE signature.
// The actual Oren result is written to *result_ptr.
@oren.keep
fn __oren_win_spawn_thread_entry(arg_ptr) {
    if arg_ptr == 0 { return 0 }
    // Tier‑1 Windows correctness: register the thread so:
    // - allocator locks have a stable per-thread identity (`sys_gettid`)
    // - call-depth tracking can attach to the thread node when available
    // - future GC stack scanning can discover this thread deterministically
    //
    // Note: we conservatively use the current SP as the "top" hint, matching the entry stub's
    // behavior for the main thread (registered near startup).
    oren_register_thread(get_sp())

    var dbg = native_envp_get_value_ptr("OREN_DEBUG_SPAWN")
    var dbg_on = false
    if dbg != 0 {
        if ptr_get_byte(dbg) != 0 { dbg_on = true }
    }
    var fn_obj = ptr_get(iadd(arg_ptr, 0))
    var args_list = ptr_get(iadd(arg_ptr, 8))
    var out_ptr = ptr_get(iadd(arg_ptr, 16))
    if dbg_on {
        print("spawn debug (win thread):")
        print("  arg_ptr=" + oren_int_to_string(arg_ptr))
        print("  fn_obj=" + oren_int_to_string(fn_obj))
        if fn_obj != 0 {
            print("  fn.code_ptr=" + oren_int_to_string(ptr_get(fn_obj)))
            print("  fn.env_ptr=" + oren_int_to_string(ptr_get(iadd(fn_obj, 8))))
        }
        print("  args_list=" + oren_int_to_string(args_list))
        if args_list != 0 {
            print("  args_len=" + oren_int_to_string(oren_list_len(args_list)))
        }
        print("  out_ptr=" + oren_int_to_string(out_ptr))
    }
    if out_ptr != 0 {
        var ret = oren_call_obj_list(fn_obj, args_list)
        ptr_set(out_ptr, ret)
    }
    // Detach support (Tier‑1 safety):
    // `oren_join_timeout` on Windows may "detach" a thread on timeout to avoid
    // `TerminateThread` (unsafe: can deadlock the process if a lock is held).
    //
    // In detach mode, the joiner closes its handle and drops the join-handle object;
    // the thread cleans up its own arg/result allocations before returning.
    var auto_free = ptr_get(iadd(arg_ptr, 24))
    if auto_free != 0 {
        if out_ptr != 0 { free(out_ptr) }
        free(arg_ptr)
    }
    return 0
}

