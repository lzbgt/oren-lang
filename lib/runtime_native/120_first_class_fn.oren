// --- First-class functions (native backend) ---
//
// Representation (tracked allocation kind=6):
//   [0] code_ptr (u64)  - entrypoint taking (env, args_list)
//   [8] env_ptr  (u64)  - closure environment (typically a list), or 0
// strcmp tracing (Win11 lexer crash triage).
// Enabled by OREN_TRACE_STRCMP=1; default off.
var g_trace_strcmp = -1
var g_strcmp_depth = 0

fn _trace_strcmp_enabled() {
    if g_trace_strcmp != -1 { return g_trace_strcmp == 1 }
    var v = native_envp_get_value_ptr("OREN_TRACE_STRCMP")
    if v != 0 && ptr_get_byte(v) != 0 && ptr_get_byte(v) != 48 { g_trace_strcmp = 1 } else { g_trace_strcmp = 0 }
    return g_trace_strcmp == 1
}

@oren.keep
fn oren_func(code_ptr, env_ptr) {
    if code_ptr == 0 { return 0 }
    // IMPORTANT (native runtime model):
    // Function objects must be tracked allocations with kind=6 so:
    // - `oren_is_func` can classify them cheaply via `oren_find_node`
    // - GC can traverse the closure environment pointer at +8
    //
    // Do not rely on "malloc then patch kind" because some runtime paths intentionally keep
    // small raw allocations untracked (for cstr0 pools, argv/envp, etc).
    var obj = malloc_k(16, 6)
    if obj == 0 { exit(320) }
    if obj == -1 { exit(320) }
    ptr_set(obj, code_ptr)
    ptr_set(iadd(obj, 8), env_ptr)
    return obj
}

// Safe type predicate: must not panic.
//
// Notes:
// - Function objects are tracked allocations with kind=6 (see `oren_func`).
// - There is no magic footer today; rely on `oren_find_node` to avoid treating arbitrary integers as pointers.
@oren.keep
fn oren_is_func(v) {
    if v == 0 || native_value_is_nil(v) { return false }
    var node = oren_find_node(v)
    if node == 0 { return false }
    return ptr_get(iadd(node, 16)) == 6
}

// Spawn a callable object with an args list.
//
// This is the syscall-first native analogue of the C backend's spawn-callable helper.
// It returns the same handle layout expected by `oren_join(handle)`:
//   [0]  pid (u64)
//   [8]  read_fd (u64)
//   [16] got (u64)        - number of bytes already read into inline result buffer
//   [24] result_buf (u64) - inline 8-byte result buffer (filled by is_done/join)
@oren.keep
fn oren_spawn_call_list(fn_obj, args_list) {
    // Preferred path (Stage N1 native concurrency):
    // If the in-process green-task runtime is enabled, `spawn` becomes lightweight and shares memory
    // (required for correct future GC/concurrency behavior).
    //
    // Escape hatch: set `OREN_NO_GREEN=1` to disable green tasks.
    //
    // Notes (rolling):
    // - On POSIX, the fallback is legacy fork+pipe.
    // - On Windows (no fork), the fallback is a runtime-owned OS-thread spawn.
    var g = oren_green_spawn(fn_obj, args_list)
    if g != 0 { return g }

    // Windows has no fork(2). If green tasks are disabled/unavailable, fall back to OS threads.
    if g_target_os == 3 {
        return _oren_spawn_call_list_windows_thread(fn_obj, args_list)
    }

    var pipe_buf = malloc(16)
    if pipe_buf == 0 { exit(321) }
    var rv = sys_pipe(pipe_buf)
    // Linux pipe2 returns 0 on success and -errno on failure.
    // Treat any non-zero return as failure (strict) so backend return-value clobbers are caught.
    if rv != 0 { exit(322) }

    var rfd = ptr_get(pipe_buf)
    var wfd = ptr_get(iadd(pipe_buf, 8))

    // IMPORTANT (fork hygiene):
    // Use `oren_fork()` (not raw `sys_fork()`) so the child resets any inherited
    // in-memory locks before doing further allocations/capsule bookkeeping.
    var pid = oren_fork()
    if pid == 0 {
        // Child
        var dbg = native_envp_get_value_ptr("OREN_DEBUG_SPAWN")
        if dbg != 0 {
            if ptr_get_byte(dbg) != 0 {
                print("spawn debug (child):")
                print("  pipe.rfd=" + oren_int_to_string(rfd))
                print("  pipe.wfd=" + oren_int_to_string(wfd))
            }
        }
        sys_close(rfd)
        var ret = 0
        if dbg != 0 {
            if ptr_get_byte(dbg) != 0 {
                print("  fn_obj=" + oren_int_to_string(fn_obj))
                if fn_obj != 0 {
                    print("  fn.code_ptr=" + oren_int_to_string(ptr_get(fn_obj)))
                    print("  fn.env_ptr=" + oren_int_to_string(ptr_get(iadd(fn_obj, 8))))
                }
                print("  args_list=" + oren_int_to_string(args_list))
                print("  args_len=" + oren_int_to_string(oren_list_len(args_list)))
                if oren_list_len(args_list) > 0 {
                    print("  args[0]=" + oren_int_to_string(oren_list_get(args_list, 0)))
                }
            }
        }

        ret = oren_call_obj_list(fn_obj, args_list)
        if dbg != 0 {
            if ptr_get_byte(dbg) != 0 {
                print("  ret=" + oren_int_to_string(ret))
            }
        }
        // Reuse the pre-fork heap buffer as the 8-byte write buffer.
        // This avoids taking the allocator lock in the child before user code runs.
        ptr_set(pipe_buf, ret)
        sys_write(wfd, pipe_buf, 8)
        sys_close(wfd)
        exit(0)
        return 0
    }

        // Parent
    sys_close(wfd)
    var dbg_p = native_envp_get_value_ptr("OREN_DEBUG_SPAWN")
    if dbg_p != 0 {
        if ptr_get_byte(dbg_p) != 0 {
            print("spawn debug (parent):")
            print("  pid=" + oren_int_to_string(pid))
            print("  pipe.rfd=" + oren_int_to_string(rfd))
            print("  pipe.wfd=" + oren_int_to_string(wfd))
        }
    }
    free(pipe_buf)

    var handle = malloc(32)
    if handle == 0 { exit(324) }
    ptr_set(handle, pid)
    ptr_set(iadd(handle, 8), rfd)
    ptr_set(iadd(handle, 16), 0) // got
    ptr_set(iadd(handle, 24), 0) // result_buf
    return handle
}

// --- Windows Tier‑1: thread fallback for language `spawn` ---
//
// This allocates the same handle layout expected by `oren_join(_timeout)` on Windows:
//   [0]  os_thread_handle (runtime-owned "M" handle; mmap-backed)
//   [8]  result_ptr    (u64*)
//   [16] arg_ptr       (spawn arg struct ptr; freed by join unless detached)
//
// Thread arg struct layout (consumed by `__oren_win_spawn_thread_entry`):
//   [0]  fn_obj
//   [8]  args_list
//   [16] result_ptr
//   [24] auto_free (u64; set to 1 by join_timeout detach)
@oren.keep
@cfg(os="windows")
fn oren_windows_os_thread_spawn_call_list(fn_obj, args_list) {
    return _oren_spawn_call_list_windows_thread(fn_obj, args_list)
}

fn _oren_spawn_call_list_windows_thread(fn_obj, args_list) {
    if fn_obj == 0 { return 0 }

    // result_ptr = malloc_raw(8)
    var result_ptr = malloc_raw(8)
    if result_ptr == 0 || result_ptr == -1 { exit(325) }
    ptr_set(result_ptr, 0)

    // arg_ptr = malloc_raw(32)
    var arg_ptr = malloc_raw(32)
    if arg_ptr == 0 || arg_ptr == -1 { exit(326) }
    ptr_set(iadd(arg_ptr, 0), fn_obj)
    ptr_set(iadd(arg_ptr, 8), args_list)
    ptr_set(iadd(arg_ptr, 16), result_ptr)
    ptr_set(iadd(arg_ptr, 24), 0) // auto_free=0 (normal join)

    // start_ptr = &__oren_win_spawn_thread_entry
    var start_ptr = oren_code_addr(__oren_win_spawn_thread_entry)
    // Route OS-thread creation through the runtime-owned M substrate so the runtime flips into
    // multi-thread mode before the new thread can run (avoids a brief window where the new thread
    // can observe single-thread fast paths).
    var h = oren_os_thread_spawn(start_ptr, arg_ptr)

    var handle = malloc_raw(24)
    if handle == 0 || handle == -1 { exit(327) }
    ptr_set(iadd(handle, 0), h)
    ptr_set(iadd(handle, 8), result_ptr)
    ptr_set(iadd(handle, 16), arg_ptr)
    return handle
}

// --- Windows x64 Tier‑1: thread entry for language `spawn` ---
//
// Windows does not have fork/exec; if green tasks are unavailable, `oren_spawn_call_list`
// falls back to CreateThread, passing a pointer to a small arg struct.
//
// Arg layout (written by `_oren_spawn_call_list_windows_thread`):
//   [0]  fn_obj
//   [8]  args_list
//   [16] result_ptr (u64*)
//   [24] auto_free (u64; 0=normal, 1=detach cleanup by thread)
//
// Returns a DWORD (u32) to satisfy CreateThread's LPTHREAD_START_ROUTINE signature.
// The actual Oren result is written to *result_ptr.
@oren.keep
fn __oren_win_spawn_thread_entry(arg_ptr) {
    if arg_ptr == 0 { return 0 }
    // Tier‑1 Windows correctness: register the thread so:
    // - allocator locks have a stable per-thread identity (`sys_gettid`)
    // - call-depth tracking can attach to the thread node when available
    // - future GC stack scanning can discover this thread deterministically
    //
    // Note: we conservatively use the current SP as the "top" hint, matching the entry stub's
    // behavior for the main thread (registered near startup).
    oren_register_thread(get_sp())

    var dbg = native_envp_get_value_ptr("OREN_DEBUG_SPAWN")
    var dbg_on = false
    if dbg != 0 {
        if ptr_get_byte(dbg) != 0 { dbg_on = true }
    }
    var fn_obj = ptr_get(iadd(arg_ptr, 0))
    var args_list = ptr_get(iadd(arg_ptr, 8))
    var out_ptr = ptr_get(iadd(arg_ptr, 16))
    if dbg_on {
        print("spawn debug (win thread):")
        print("  arg_ptr=" + oren_int_to_string(arg_ptr))
        print("  fn_obj=" + oren_int_to_string(fn_obj))
        if fn_obj != 0 {
            print("  fn.code_ptr=" + oren_int_to_string(ptr_get(fn_obj)))
            print("  fn.env_ptr=" + oren_int_to_string(ptr_get(iadd(fn_obj, 8))))
        }
        print("  args_list=" + oren_int_to_string(args_list))
        if args_list != 0 {
            print("  args_len=" + oren_int_to_string(oren_list_len(args_list)))
        }
        print("  out_ptr=" + oren_int_to_string(out_ptr))
    }
    if out_ptr != 0 {
        var ret = oren_call_obj_list(fn_obj, args_list)
        ptr_set(out_ptr, ret)
    }
    // Detach support (Tier‑1 safety):
    // `oren_join_timeout` on Windows may "detach" a thread on timeout to avoid
    // `TerminateThread` (unsafe: can deadlock the process if a lock is held).
    //
    // In detach mode, the joiner closes its handle and drops the join-handle object;
    // the thread cleans up its own arg/result allocations before returning.
    var auto_free = ptr_get(iadd(arg_ptr, 24))
    if auto_free != 0 {
        if out_ptr != 0 { free(out_ptr) }
        free(arg_ptr)
    }

    // STW GC correctness:
    // This CreateThread-based language `spawn` path registers an OS-thread node via `oren_register_thread`.
    // Thread nodes are mmap-backed metadata and persist after thread exit; mark the node DEAD so future
    // STW collections do not wait for an exited thread to park at a safepoint.
    native_time_mark_thread_dead_current()
    return 0
}

// ... existing code ...

// Centralized struct allocation hook (uses the compiler's special-cased malloc).
fn oren_alloc_struct(size) {
    var ptr = malloc(size)
    // Update kind to 4 (STRUCT)
    var node = oren_find_node(ptr)
    if node != 0 {
        ptr_set(iadd(node, 16), 4)
    }
    return ptr
}

fn oren_free_struct(ptr) {
    // Best-effort explicit free for large struct buffers.
    // (Allocator is bump-based; `free` marks the node as freed so GC can reclaim metadata.)
    return free(ptr)
}

@oren.keep
fn strcmp(s1, s2) {
    // Nil-safe lexicographic compare for NUL-terminated strings.
    // This is intentionally defensive: native codegen may still compare against 0 in rolling mode.
    var trace = _trace_strcmp_enabled()
    if trace == true {
        g_strcmp_depth = iadd(g_strcmp_depth, 1)
        if g_strcmp_depth > 2000 {
            print("strcmp: depth overflow depth=" + oren_int_to_string(g_strcmp_depth))
            exit(296)
        }
    }
    if s1 - 0 == 0 {
        if s2 - 0 == 0 {
            if trace == true { g_strcmp_depth = g_strcmp_depth - 1 }
            return 0
        }
        if trace == true { g_strcmp_depth = g_strcmp_depth - 1 }
        return -1
    }
    if s2 - 0 == 0 {
        if trace == true { g_strcmp_depth = g_strcmp_depth - 1 }
        return 1
    }
    var i = 0
    while 1 {
        var b1 = ptr_get_byte(iadd(s1, i))
        var b2 = ptr_get_byte(iadd(s2, i))
        if b1 == 0 {
            if b2 == 0 {
                if trace == true { g_strcmp_depth = g_strcmp_depth - 1 }
                return 0
            }
            if trace == true { g_strcmp_depth = g_strcmp_depth - 1 }
            return -1
        }
        if b2 == 0 {
            if trace == true { g_strcmp_depth = g_strcmp_depth - 1 }
            return 1
        }
        if b1 < b2 {
            if trace == true { g_strcmp_depth = g_strcmp_depth - 1 }
            return -1
        }
        if b1 > b2 {
            if trace == true { g_strcmp_depth = g_strcmp_depth - 1 }
            return 1
        }
        i = iadd(i, 1)
    }
    if trace == true { g_strcmp_depth = g_strcmp_depth - 1 }
    return 0
}


@oren.keep
fn oren_add(a, b) {
    // Native v0: `+` is overloaded for:
    // - integers (default)
    // - strings (C-string concat), including embedded literals (cstr0 pool) and tracked heap strings.
    if native_is_string_ptr(a) != 0 {
        if native_is_string_ptr(b) != 0 {
            return string_concat(a, b)
        }
    }
    return iadd(a, b)
}

@oren.keep
fn oren_mod(a, b) {
    // Deterministic signed remainder with explicit error on:
    // - modulo by zero
    // - i64_min % -1 (would imply division overflow)
    //
    if b == 0 {
        oren_panic("modulo by zero")
        return 0
    }

    // INT64_MIN = -(1<<63). In Oren's rolling int model, this constant is safe.
    var i64_min = 0 - (1 << 63)
    if a == i64_min && b == -1 {
        oren_panic("modulo overflow (i64_min % -1)")
        return 0
    }

    // Trunc-to-zero remainder identity:
    //   a == (a / b) * b + (a % b)
    // so:
    //   a % b == a - (a / b) * b
    var q = a / b
    return a - (q * b)
}

fn oren_int_to_string(n) {
    var buf = malloc(32)
    if buf == 0 { exit(300) }
    var i = 0
    var neg = 0
    // Avoid overflow on INT64_MIN by doing digit extraction in the negative domain.
    //
    // In two's complement, `-INT64_MIN` is not representable, so `n=-n` would be wrong.
    // Use a classic trick:
    // - keep `n` <= 0 for the digit loop
    // - remainder will be in [-9..0], so digit is `0 - rem`
    if n < 0 {
        neg = 1
    } else {
        n = 0 - n
    }
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        while n != 0 {
            var q = n / 10
            // Avoid generic `*` lowering in the native backend: q*10 = (q<<3)+(q<<1).
            var q10 = iadd(q << 3, q << 1)
            var rem = n - q10 // in [-9..0] under trunc-to-zero division
            var digit = 0 - rem
            ptr_set_byte(iadd(buf, i), iadd(48, digit))
            i = iadd(i, 1)
            n = q
        }
        if neg == 1 {
            ptr_set_byte(iadd(buf, i), 45)
            i = iadd(i, 1)
        }
        // reverse
        var s = 0
        var e = i - 1
        while s < e {
            var t = ptr_get_byte(iadd(buf, s))
            ptr_set_byte(iadd(buf, s), ptr_get_byte(iadd(buf, e)))
            ptr_set_byte(iadd(buf, e), t)
            s = iadd(s, 1)
            e = iadd(e, -1)
        }
    }
    ptr_set_byte(iadd(buf, i), 0) // null term
    oren_track_alloc(buf, 32, 1) // 1=STRING
    return buf
}
