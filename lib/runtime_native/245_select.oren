// --- Select (native runtime; pipe-based channels; rolling) ---
//
// This implements the same *data encoding* as AVM `oren_select` / `oren_select_recv`,
// but against the native runtime's current channel representation:
//
// - native channels are pipe pairs: `ch = [rfd, wfd]` (see `oren_new_channel`)
// - recv case descriptor: `[0, ch]`
// - send case descriptor: `[1, ch, val]`
//
// Native-only convenience:
// - Passing `ch` directly as a case item is treated as a recv case.
//
// OS wait backends:
// - macOS: kqueue/kevent (works for pipes and sockets)
// - Linux: epoll (works for pipes and sockets)
// - Windows: not supported yet for pipe-based channels (needs IOCP or a different channel impl)
//
// Return value contract (matches AVM rolling):
// - returns `[idx, payload]`
//   - payload is the received value for recv cases
//   - payload is `1` for send cases (rolling "ok")

fn _select_is_list(v) {
    var node = oren_find_node(v)
    if node == 0 { return 0 }
    if ptr_get(iadd(node, 16)) != 2 { return 0 } // kind==LIST
    return 1
}

fn _select_kqueue_event_has(evbuf, nready, want_kind, fd) {
    // want_kind: 0=read, 1=write
    // kqueue filter:
    // - read:  EVFILT_READ  == -1 == 0xFFFF
    // - write: EVFILT_WRITE == -2 == 0xFFFE
    var j = 0
    while j < nready {
        var base = evbuf + j * 32
        if ptr_get(base + 0) == fd {
            var lo = ptr_get_byte(base + 8)
            var hi = ptr_get_byte(base + 9)
            var filt_u16 = lo | (hi << 8)
            if want_kind == 0 {
                if filt_u16 == 65535 { return 1 }
            } else {
                if filt_u16 == 65534 { return 1 }
            }
        }
        j = j + 1
    }
    return 0
}

fn _select_epoll_event_has(evbuf, nready, want_kind, fd) {
    // want_kind: 0=read, 1=write
    var j = 0
    while j < nready {
        var stride = OREN_EPOLL_EVENT_BYTES
        if stride == 0 { stride = 16 }
        var base = evbuf + j * stride
        var mask = oren_ptr_get_u32_le(base + 0)
        var data_off = OREN_EPOLL_EVENT_OFF_DATA
        if data_off == 0 { data_off = 8 }
        var d = oren_ptr_get_u64_le(base + data_off)
        if d == fd {
            if want_kind == 0 {
                var m = mask & OREN_EPOLLIN
                if m != 0 { return 1 }
            } else {
                var m2 = mask & OREN_EPOLLOUT
                if m2 != 0 { return 1 }
            }
        }
        j = j + 1
    }
    return 0
}

@oren.keep
fn oren_select(cases) {
    // NOTE: This is a blocking primitive (matches AVM select semantics).
    // Do not call this with an empty case list unless you intend to block forever.
    if _select_is_list(cases) == 0 { return 0 }
    var ncases = oren_list_len(cases)
    if ncases <= 0 { return 0 }
    // Windows: pipe-based channels are not implemented; return ENOSYS.
    if g_target_os == 3 { return 0 - 78 } // ENOSYS

    var kinds = malloc(ncases * 8)
    var fds = malloc(ncases * 8)
    var chans = malloc(ncases * 8)
    var vals = malloc(ncases * 8)
    if kinds == 0 || fds == 0 || chans == 0 || vals == 0 {
        if kinds != 0 { free(kinds) }
        if fds != 0 { free(fds) }
        if chans != 0 { free(chans) }
        if vals != 0 { free(vals) }
        return 0
    }

    // Parse cases into flat arrays.
    // kinds[i] = -1 invalid, 0 recv, 1 send
    // fds[i]   = rfd (recv) or wfd (send)
    // chans[i] = channel object (list [rfd,wfd])
    // vals[i]  = send value (send) or 0 (recv)
    var nread = 0
    var nwrite = 0
    var i = 0
    while i < ncases {
        ptr_set(iadd(kinds, i * 8), -1)
        ptr_set(iadd(fds, i * 8), 0)
        ptr_set(iadd(chans, i * 8), 0)
        ptr_set(iadd(vals, i * 8), 0)

        var cv = oren_list_get(cases, i)
        var kind = -1
        var ch = 0
        var sendv = 0

        if _select_is_list(cv) == 1 {
            var clen = oren_list_len(cv)
            if clen == 2 {
                var k0 = oren_list_get(cv, 0)
                var a1 = oren_list_get(cv, 1)
                // Recv descriptor [0, ch]
                if k0 == 0 && _select_is_list(a1) == 1 {
                    kind = 0
                    ch = a1
                } else {
                    // Native convenience: treat the list itself as a channel recv case.
                    kind = 0
                    ch = cv
                }
            } else {
                if clen == 3 {
                    var k0s = oren_list_get(cv, 0)
                    var a1s = oren_list_get(cv, 1)
                    // Send descriptor [1, ch, val]
                    if k0s == 1 && _select_is_list(a1s) == 1 {
                        kind = 1
                        ch = a1s
                        sendv = oren_list_get(cv, 2)
                    }
                }
            }
        }

        if kind == 0 || kind == 1 {
            // Expect channel to be a pipe pair [rfd,wfd].
            // Best-effort: if malformed, keep it as invalid.
            if _select_is_list(ch) == 1 {
                var fd = 0
                if kind == 0 { fd = oren_list_get(ch, 0) } else { fd = oren_list_get(ch, 1) }
                ptr_set(iadd(kinds, i * 8), kind)
                ptr_set(iadd(fds, i * 8), fd)
                ptr_set(iadd(chans, i * 8), ch)
                ptr_set(iadd(vals, i * 8), sendv)
                if kind == 0 { nread = nread + 1 } else { nwrite = nwrite + 1 }
            }
        }
        i = i + 1
    }

    if nread + nwrite <= 0 {
        free(kinds)
        free(fds)
        free(chans)
        free(vals)
        return 0
    }

    // Wait until at least one case is ready, then select deterministically using a round-robin cursor.
    while 1 {
        var nready = 0
        var evbuf = 0

        if g_target_os == 1 {
            // --- macOS: kqueue ---
            var nfds = nread + nwrite
            var kq = sys_kqueue()
            if kq < 0 {
                free(kinds); free(fds); free(chans); free(vals)
                return kq
            }

            var change = malloc(nfds * 32)
            if change == 0 { sys_close(kq); free(kinds); free(fds); free(chans); free(vals); return 0 - 12 } // ENOMEM
            var evs = malloc(nfds * 32)
            if evs == 0 { sys_close(kq); free(change); free(kinds); free(fds); free(chans); free(vals); return 0 - 12 }

            // Zero-fill change list (required for deterministic unused fields).
            var zi = 0
            while zi < nfds * 32 { ptr_set_byte(change + zi, 0); zi = zi + 1 }

            // Build changelist.
            var kflags = 1 | 4 | 16 // EV_ADD | EV_ENABLE | EV_ONESHOT
            var ci = 0
            var j = 0
            while j < ncases {
                var k = ptr_get(iadd(kinds, j * 8))
                if k == 0 || k == 1 {
                    var fdj = ptr_get(iadd(fds, j * 8))
                    var base = change + ci * 32
                    ptr_set(base + 0, fdj)
                    if k == 0 {
                        // EVFILT_READ == -1
                        ptr_set_byte(base + 8, 255)
                        ptr_set_byte(base + 9, 255)
                    } else {
                        // EVFILT_WRITE == -2
                        ptr_set_byte(base + 8, 254)
                        ptr_set_byte(base + 9, 255)
                    }
                    ptr_set_byte(base + 10, kflags & 255)
                    ptr_set_byte(base + 11, (kflags >> 8) & 255)
                    ptr_set(base + 16, 0)
                    ptr_set(base + 24, 0)
                    ci = ci + 1
                }
                j = j + 1
            }

            // Block indefinitely (timeout_ptr = NULL).
            nready = sys_kevent(kq, change, nfds, evs, nfds, 0)
            sys_close(kq)
            free(change)
            if nready <= 0 {
                free(evs)
                if nready < 0 {
                    free(kinds); free(fds); free(chans); free(vals)
                    return nready
                }
                // Spurious wakeup / no events; keep blocking.
                continue
            }
            evbuf = evs
        } else {
            // --- Linux: epoll ---
            var nfds2 = nread + nwrite
            var epfd = sys_epoll_create1(0)
            if epfd < 0 {
                free(kinds); free(fds); free(chans); free(vals)
                return epfd
            }

            // Linux epoll syscall ABI is arch-dependent (packed on x86_64, aligned on arm64).
            // `native_runtime_init` probes the active layout once and fills:
            //   - OREN_EPOLL_EVENT_BYTES
            //   - OREN_EPOLL_EVENT_OFF_DATA
            var evsz = OREN_EPOLL_EVENT_BYTES
            if evsz == 0 { evsz = 16 }
            var data_off2 = OREN_EPOLL_EVENT_OFF_DATA
            if data_off2 == 0 { data_off2 = 8 }
            var ev = malloc(evsz)
            if ev == 0 { sys_close(epfd); free(kinds); free(fds); free(chans); free(vals); return 0 - 12 } // ENOMEM
            var out = malloc(nfds2 * evsz)
            if out == 0 { sys_close(epfd); free(ev); free(kinds); free(fds); free(chans); free(vals); return 0 - 12 }

            // Register all fds (best-effort; assumes no duplicates).
            var k = 0
            while k < ncases {
                var kk = ptr_get(iadd(kinds, k * 8))
                if kk == 0 || kk == 1 {
                    var fd = ptr_get(iadd(fds, k * 8))
                    // Zero-fill ev
                    var z = 0
                    while z < evsz { ptr_set_byte(ev + z, 0); z = z + 1 }
                    if kk == 0 { oren_ptr_set_u32_le(ev + 0, OREN_EPOLLIN) }
                    else { oren_ptr_set_u32_le(ev + 0, OREN_EPOLLOUT) }
                    oren_ptr_set_u64_le(ev + data_off2, fd)
                    var rc = sys_epoll_ctl(epfd, OREN_EPOLL_CTL_ADD, fd, ev)
                    if rc < 0 {
                        sys_close(epfd)
                        free(ev)
                        free(out)
                        free(kinds); free(fds); free(chans); free(vals)
                        return rc
                    }
                }
                k = k + 1
            }

            // Block indefinitely (timeout_ms = -1).
            nready = sys_epoll_pwait(epfd, out, nfds2, -1, 0, 0)
            sys_close(epfd)
            free(ev)
            if nready <= 0 {
                free(out)
                if nready < 0 {
                    free(kinds); free(fds); free(chans); free(vals)
                    return nready
                }
                continue
            }
            evbuf = out
        }

        // Deterministic selection: scan cases starting at the rolling cursor.
        var start = g_select_cursor % ncases
        var off = 0
        var picked = -1
        while off < ncases {
            var idx = (start + off) % ncases
            var k = ptr_get(iadd(kinds, idx * 8))
            if k == 0 || k == 1 {
                var fd = ptr_get(iadd(fds, idx * 8))
                var ok = 0
                if g_target_os == 1 {
                    ok = _select_kqueue_event_has(evbuf, nready, k, fd)
                } else {
                    ok = _select_epoll_event_has(evbuf, nready, k, fd)
                }
                if ok == 1 { picked = idx; break }
            }
            off = off + 1
        }

        free(evbuf)

        if picked >= 0 {
            var pk = ptr_get(iadd(kinds, picked * 8))
            var ch = ptr_get(iadd(chans, picked * 8))
            var payload = 0
            if pk == 0 {
                payload = oren_chan_recv(ch)
            } else {
                var v = ptr_get(iadd(vals, picked * 8))
                oren_chan_send(ch, v)
                payload = 1
            }

            var pair = oren_new_list(2)
            oren_list_push(pair, picked)
            oren_list_push(pair, payload)
            g_select_cursor = (picked + 1) % ncases

            free(kinds)
            free(fds)
            free(chans)
            free(vals)
            return pair
        }

        // Spurious events that don't match any case; keep waiting.
    }
}

@oren.keep
fn oren_select_recv(chs) {
    // Rolling: implemented in terms of the general select parser.
    // This preserves AVM semantics where `oren_select_recv([ch1, ch2])` blocks until any has a value.
    return oren_select(chs)
}
