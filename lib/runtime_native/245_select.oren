// --- Select (native runtime; channels; rolling) ---
//
// This implements the same *data encoding* as AVM `oren_select` / `oren_select_recv`,
// but against the native runtime's channel representations:
//
// - macOS/Linux: pipe pairs `ch = [rfd, wfd]` (see `oren_new_channel`)
// - Windows: in-memory channels (see `lib/runtime_native/011_channels_mem.oren`)
// - recv case descriptor: `[0, ch]`
// - send case descriptor: `[1, ch, val]`
//
// Native-only convenience:
// - Passing `ch` directly as a case item is treated as a recv case.
//
// OS wait backends:
// - macOS: kqueue/kevent (works for pipes and sockets)
// - Linux: epoll (works for pipes and sockets)
// - Windows: supported for in-memory channels (pipe-based channels still need IOCP/overlapped IO)
//
// Return value contract (matches AVM rolling):
// - returns `[idx, payload]`
//   - payload is the received value for recv cases
//   - payload is `1` for send cases (rolling "ok")

fn _select_is_list(v) {
    var node = oren_find_node(v)
    if node == 0 { return 0 }
    if ptr_get(iadd(node, 16)) != 2 { return 0 } // kind==LIST
    return 1
}

fn _select_kqueue_event_has(evbuf, nready, want_kind, fd) {
    // want_kind: 0=read, 1=write
    // kqueue filter:
    // - read:  EVFILT_READ  == -1 == 0xFFFF
    // - write: EVFILT_WRITE == -2 == 0xFFFE
    var j = 0
    while j < nready {
        var base = evbuf + j * 32
        if ptr_get(base + 0) == fd {
            var lo = ptr_get_byte(base + 8)
            var hi = ptr_get_byte(base + 9)
            var filt_u16 = lo | (hi << 8)
            if want_kind == 0 {
                if filt_u16 == 65535 { return 1 }
            } else {
                if filt_u16 == 65534 { return 1 }
            }
        }
        j = j + 1
    }
    return 0
}

fn _select_epoll_event_has(evbuf, nready, want_kind, fd) {
    // want_kind: 0=read, 1=write
    var j = 0
    while j < nready {
        var stride = OREN_EPOLL_EVENT_BYTES
        if stride == 0 { stride = 16 }
        var base = evbuf + j * stride
        var mask = oren_ptr_get_u32_le(base + 0)
        var data_off = OREN_EPOLL_EVENT_OFF_DATA
        if data_off == 0 { data_off = 8 }
        var d = oren_ptr_get_u64_le(base + data_off)
        if d == fd {
            if want_kind == 0 {
                var m = mask & OREN_EPOLLIN
                if m != 0 { return 1 }
            } else {
                var m2 = mask & OREN_EPOLLOUT
                if m2 != 0 { return 1 }
            }
        }
        j = j + 1
    }
    return 0
}

fn _select_in_green() {
    // Detect whether the current OS thread is executing on a green stack (Stage N1/N2).
    // If so, a fully-blocking select would stall the whole scheduler on that M.
    return oren_green_in_green() == true
}

fn _select_wait_in_green_netpoll_v2(kinds, fds, chans, vals, ncases) {
    // Netpoll v2 green select:
    // - Use the shared scheduler netpoller (kqueue/epoll) directly.
    // - Avoid per-wake probe polling (no temporary per-select kqueue/epoll allocations).
    // - Preserve deterministic selection (`g_select_cursor`) by tracking a full ready-set
    //   for the current select attempt.
    //
    // Token model:
    // - arm each fd with token=wait_struct_ptr (one per case)
    // - scheduler sets wait.ready=1 when the OS reports readiness
    // - after wake, scan waits deterministically and perform the chosen recv/send
    if ncases <= 0 { return 0 }
    if g_target_os == 3 { return 0 - 78 } // ENOSYS
    if _select_in_green() != true { return 0 - 22 } // EINVAL
    if native_netpoll_supported() != true { return 0 - 78 } // ENOSYS

    var g = oren_green_current_g_or0()
    if g == 0 { return 0 - 22 }

    var rc0 = native_netpoll_init_once()
    if rc0 < 0 { return rc0 }

    // Bump per-G IO epoch so stale tokens from a previous select call can be rejected safely.
    var epoch = ptr_get(g + green_g_off_io_epoch()) + 1
    if epoch == 0 { epoch = 1 }
    ptr_set(g + green_g_off_io_epoch(), epoch)

    // Map case idx -> wait struct pointer (for O(1) ready checks during deterministic scan).
    var wait_ptrs = malloc(ncases * 8)
    if wait_ptrs == 0 { return 0 - 12 } // ENOMEM
    var zi = 0
    while zi < ncases * 8 { ptr_set_byte(wait_ptrs + zi, 0); zi = zi + 1 }

    // Root all wait structs so GC cannot reclaim them while the kernel holds their token pointers.
    var wait_roots = oren_new_list(ncases)
    if wait_roots == 0 {
        free(wait_ptrs)
        return 0 - 12
    }

    // Allocate per-case wait nodes once for this select call.
    var i = 0
    while i < ncases {
        var k = ptr_get(iadd(kinds, i * 8))
        if k == 0 || k == 1 {
            var fd = ptr_get(iadd(fds, i * 8))
            if fd >= 0 {
                var w = oren_alloc_struct(native_netpoll_wait_bytes())
                if w == 0 {
                    free(wait_ptrs)
                    return 0 - 12
                }
                ptr_set(w + native_netpoll_wait_off_magic(), native_netpoll_wait_magic())
                ptr_set(w + native_netpoll_wait_off_g(), g)
                ptr_set(w + native_netpoll_wait_off_case_idx(), i)
                ptr_set(w + native_netpoll_wait_off_epoch(), epoch)
                ptr_set(w + native_netpoll_wait_off_ready(), 0)
                ptr_set(iadd(wait_ptrs, i * 8), w)
                oren_list_push(wait_roots, w)
            }
        }
        i = i + 1
    }

    // Wait loop: arm -> sleep -> disarm -> pick ready -> retry on timeout/spurious.
    while 1 {
        // Mark this G as IO-active so netpoll tokens can wake it.
        ptr_set(g + green_g_off_io_ready(), 0)
        ptr_set(g + green_g_off_io_active(), 1)

        // Arm all case fds with token=wait-node pointer.
        i = 0
        while i < ncases {
            var k2 = ptr_get(iadd(kinds, i * 8))
            if k2 == 0 || k2 == 1 {
                var fd2 = ptr_get(iadd(fds, i * 8))
                var w2 = ptr_get(iadd(wait_ptrs, i * 8))
                if fd2 >= 0 && w2 != 0 {
                    ptr_set(w2 + native_netpoll_wait_off_ready(), 0)
                    var arc = native_netpoll_arm_fd(fd2, k2, w2)
                    if arc < 0 {
                        // Best-effort cleanup on partial arm.
                        var j = 0
                        while j < ncases {
                            var kk = ptr_get(iadd(kinds, j * 8))
                            if kk == 0 || kk == 1 {
                                var fdd = ptr_get(iadd(fds, j * 8))
                                if fdd >= 0 { native_netpoll_disarm_fd(fdd, kk) }
                            }
                            j = j + 1
                        }
                        ptr_set(g + green_g_off_io_active(), 0)
                        ptr_set(g + green_g_off_io_ready(), 0)
                        free(wait_ptrs)
                        return arc
                    }
                }
            }
            i = i + 1
        }

        // Park "forever" (rolling approximation):
        // - select has no timeout, but `oren_green_sleep_ns` requires a finite wake time so the
        //   scheduler can compute next-wake deadlines.
        // - The scheduler netpoller forces wake_ns=now on readiness, waking us early.
        oren_green_sleep_ns(60000000000) // 60s

        // Best-effort disarm on wake (timeout or readiness).
        i = 0
        while i < ncases {
            var k3 = ptr_get(iadd(kinds, i * 8))
            if k3 == 0 || k3 == 1 {
                var fd3 = ptr_get(iadd(fds, i * 8))
                if fd3 >= 0 { native_netpoll_disarm_fd(fd3, k3) }
            }
            i = i + 1
        }

        // Clear IO-active state so stale tokens can be ignored.
        ptr_set(g + green_g_off_io_active(), 0)
        ptr_set(g + green_g_off_io_ready(), 0)

        // Deterministic selection: scan cases starting at the rolling cursor.
        var start = g_select_cursor % ncases
        var off = 0
        var picked = -1
        while off < ncases {
            var idx = (start + off) % ncases
            var w = ptr_get(iadd(wait_ptrs, idx * 8))
            if w != 0 {
                if ptr_get(w + native_netpoll_wait_off_ready()) != 0 {
                    picked = idx
                    break
                }
            }
            off = off + 1
        }

        if picked >= 0 {
            var pk = ptr_get(iadd(kinds, picked * 8))
            var ch = ptr_get(iadd(chans, picked * 8))
            var payload = 0
            if pk == 0 {
                payload = oren_chan_recv(ch)
            } else {
                var v = ptr_get(iadd(vals, picked * 8))
                oren_chan_send(ch, v)
                payload = 1
            }

            var pair = oren_new_list(2)
            oren_list_push(pair, picked)
            oren_list_push(pair, payload)
            g_select_cursor = (picked + 1) % ncases

            free(wait_ptrs)
            free(kinds)
            free(fds)
            free(chans)
            free(vals)
            return pair
        }

        // Timeout/spurious wake. Re-arm and keep waiting.
    }
}

fn _select_wait_windows_mem_channels(cases, ncases) {
    // Windows-only fast path: implement select over in-memory channels.
    //
    // We intentionally do NOT attempt to support pipe-based channels on Windows here.
    // For fd readiness on Windows we want an IOCP-based netpoller (future work).
    if g_target_os != 3 { return 0 - 22 } // EINVAL
    if ncases <= 0 { return 0 }

    var kinds = malloc(ncases * 8)
    var chans = malloc(ncases * 8)
    var vals = malloc(ncases * 8)
    if kinds == 0 || chans == 0 || vals == 0 {
        if kinds != 0 { free(kinds) }
        if chans != 0 { free(chans) }
        if vals != 0 { free(vals) }
        return 0 - 12 // ENOMEM
    }

    // Parse cases into flat arrays.
    // kinds[i] = -1 invalid, 0 recv, 1 send
    // chans[i] = mem-channel pointer
    // vals[i]  = send value (send) or 0 (recv)
    var i = 0
    while i < ncases {
        ptr_set(iadd(kinds, i * 8), -1)
        ptr_set(iadd(chans, i * 8), 0)
        ptr_set(iadd(vals, i * 8), 0)

        var cv = oren_list_get(cases, i)
        var kind = -1
        var ch = 0
        var sendv = 0

        if _select_is_list(cv) == 1 {
            var clen = oren_list_len(cv)
            if clen == 2 {
                var k0 = oren_list_get(cv, 0)
                var a1 = oren_list_get(cv, 1)
                // Recv descriptor [0, ch]
                if k0 == 0 {
                    kind = 0
                    ch = a1
                } else {
                    // Windows: a list case item is not a channel (pipe channel lists are unsupported).
                    kind = -1
                }
            } else {
                if clen == 3 {
                    var k0s = oren_list_get(cv, 0)
                    var a1s = oren_list_get(cv, 1)
                    // Send descriptor [1, ch, val]
                    if k0s == 1 {
                        kind = 1
                        ch = a1s
                        sendv = oren_list_get(cv, 2)
                    }
                }
            }
        } else {
            // Native convenience: treat direct channel pointer as recv case.
            if native_chan_is_mem(cv) == 1 {
                kind = 0
                ch = cv
            }
        }

        if kind != 0 && kind != 1 {
            free(kinds); free(chans); free(vals)
            return 0 - 22 // EINVAL
        }
        if native_chan_is_mem(ch) != 1 {
            // Pipe-based channels are not supported on Windows. Treat as ENOSYS.
            free(kinds); free(chans); free(vals)
            return 0 - 78 // ENOSYS
        }

        ptr_set(iadd(kinds, i * 8), kind)
        ptr_set(iadd(chans, i * 8), ch)
        ptr_set(iadd(vals, i * 8), sendv)
        i = i + 1
    }

    var recv_buf = malloc(8)
    if recv_buf == 0 { free(kinds); free(chans); free(vals); return 0 - 12 }

    // Ensure the shared seq word exists for the sleep path.
    _chan_mem_global_seq_init_if_needed()
    var in_green = _select_in_green()

    while 1 {
        var picked = -1
        var payload = 0

        // Deterministic round-robin scan starting at `g_select_cursor`.
        var off = 0
        while off < ncases {
            var idx = (g_select_cursor + off) % ncases
            var k = ptr_get(iadd(kinds, idx * 8))
            var ch2 = ptr_get(iadd(chans, idx * 8))
            if k == 0 {
                var okr = native_chan_try_recv_mem(ch2, recv_buf)
                if okr == 1 {
                    picked = idx
                    payload = ptr_get(recv_buf)
                    break
                }
                if okr < 0 {
                    free(recv_buf); free(kinds); free(chans); free(vals)
                    return okr
                }
            } else {
                var v = ptr_get(iadd(vals, idx * 8))
                var oks = native_chan_try_send_mem(ch2, v)
                if oks == 1 {
                    picked = idx
                    payload = 1
                    break
                }
                if oks < 0 {
                    free(recv_buf); free(kinds); free(chans); free(vals)
                    return oks
                }
            }
            off = off + 1
        }

        if picked >= 0 {
            var pair = oren_new_list(2)
            oren_list_push(pair, picked)
            oren_list_push(pair, payload)
            g_select_cursor = (picked + 1) % ncases
            free(recv_buf)
            free(kinds)
            free(chans)
            free(vals)
            return pair
        }

        // Nothing ready: sleep until any mem-channel signals a state change.
        var p = g_chan_mem_global_seq_word
        if p != 0 {
            var expected = ptr_get(p)
            if in_green {
                // Correctness-first (rolling):
                // In a green task, do not block the scheduler OS thread in a kernel wait.
                // Park the current G briefly and re-scan.
                oren_green_sleep_ns(1000000) // 1ms
            } else {
                oren_gc_safepoint()
                oren_wait_on_addr(p, expected, 1000) // 1ms
            }
        } else {
            // Should not happen; best-effort yield to avoid spinning.
            if in_green {
                oren_green_sleep_ns(1000000)
            } else {
                oren_gc_safepoint()
            }
        }
    }
    return 0
}

@oren.keep
fn oren_select(cases) {
    // NOTE: This is a blocking primitive (matches AVM select semantics).
    // Do not call this with an empty case list unless you intend to block forever.
    if _select_is_list(cases) == 0 { return 0 }
    var ncases = oren_list_len(cases)
    if ncases <= 0 { return 0 }
    if g_target_os == 3 {
        return _select_wait_windows_mem_channels(cases, ncases)
    }

    var kinds = malloc(ncases * 8)
    var fds = malloc(ncases * 8)
    var chans = malloc(ncases * 8)
    var vals = malloc(ncases * 8)
    if kinds == 0 || fds == 0 || chans == 0 || vals == 0 {
        if kinds != 0 { free(kinds) }
        if fds != 0 { free(fds) }
        if chans != 0 { free(chans) }
        if vals != 0 { free(vals) }
        return 0
    }

    // Parse cases into flat arrays.
    // kinds[i] = -1 invalid, 0 recv, 1 send
    // fds[i]   = rfd (recv) or wfd (send)
    // chans[i] = channel object (list [rfd,wfd])
    // vals[i]  = send value (send) or 0 (recv)
    var nread = 0
    var nwrite = 0
    var i = 0
    while i < ncases {
        ptr_set(iadd(kinds, i * 8), -1)
        ptr_set(iadd(fds, i * 8), 0)
        ptr_set(iadd(chans, i * 8), 0)
        ptr_set(iadd(vals, i * 8), 0)

        var cv = oren_list_get(cases, i)
        var kind = -1
        var ch = 0
        var sendv = 0

        if _select_is_list(cv) == 1 {
            var clen = oren_list_len(cv)
            if clen == 2 {
                var k0 = oren_list_get(cv, 0)
                var a1 = oren_list_get(cv, 1)
                // Recv descriptor [0, ch]
                if k0 == 0 && _select_is_list(a1) == 1 {
                    kind = 0
                    ch = a1
                } else {
                    // Native convenience: treat the list itself as a channel recv case.
                    kind = 0
                    ch = cv
                }
            } else {
                if clen == 3 {
                    var k0s = oren_list_get(cv, 0)
                    var a1s = oren_list_get(cv, 1)
                    // Send descriptor [1, ch, val]
                    if k0s == 1 && _select_is_list(a1s) == 1 {
                        kind = 1
                        ch = a1s
                        sendv = oren_list_get(cv, 2)
                    }
                }
            }
        }

        if kind == 0 || kind == 1 {
            // Expect channel to be a pipe pair [rfd,wfd].
            // Best-effort: if malformed, keep it as invalid.
            if _select_is_list(ch) == 1 {
                var fd = 0
                if kind == 0 { fd = oren_list_get(ch, 0) } else { fd = oren_list_get(ch, 1) }
                ptr_set(iadd(kinds, i * 8), kind)
                ptr_set(iadd(fds, i * 8), fd)
                ptr_set(iadd(chans, i * 8), ch)
                ptr_set(iadd(vals, i * 8), sendv)
                if kind == 0 { nread = nread + 1 } else { nwrite = nwrite + 1 }
            }
        }
        i = i + 1
    }

    if nread + nwrite <= 0 {
        free(kinds)
        free(fds)
        free(chans)
        free(vals)
        return 0
    }

    // Rolling contract (native select):
    // - duplicate fds across cases are rejected (EINVAL).
    //
    // Why:
    // - The legacy non-green epoll path registers each fd once (duplicates would be an error).
    // - The green netpoll v2 path arms oneshot readiness with per-case tokens; duplicates would
    //   cause token overwrites and break deterministic selection.
    var di = 0
    while di < ncases {
        var kdi = ptr_get(iadd(kinds, di * 8))
        if kdi == 0 || kdi == 1 {
            var fdi = ptr_get(iadd(fds, di * 8))
            if fdi >= 0 {
                var dj = 0
                while dj < di {
                    var kdj = ptr_get(iadd(kinds, dj * 8))
                    if kdj == 0 || kdj == 1 {
                        var fdj = ptr_get(iadd(fds, dj * 8))
                        if fdj == fdi {
                            free(kinds)
                            free(fds)
                            free(chans)
                            free(vals)
                            return 0 - 22 // EINVAL
                        }
                    }
                    dj = dj + 1
                }
            }
        }
        di = di + 1
    }

    // Wait until at least one case is ready, then select deterministically using a round-robin cursor.
    var in_green = _select_in_green()
    if in_green {
        // Green select must not block the scheduler OS thread.
        // Use the shared scheduler netpoller directly (netpoll v2).
        return _select_wait_in_green_netpoll_v2(kinds, fds, chans, vals, ncases)
    }
    while 1 {
        var nready = 0
        var evbuf = 0

        if g_target_os == 1 {
            // --- macOS: kqueue ---
            var nfds = nread + nwrite
            var kq = sys_kqueue()
            if kq < 0 {
                free(kinds); free(fds); free(chans); free(vals)
                return kq
            }

            var change = malloc(nfds * 32)
            if change == 0 { sys_close(kq); free(kinds); free(fds); free(chans); free(vals); return 0 - 12 } // ENOMEM
            var evs = malloc(nfds * 32)
            if evs == 0 { sys_close(kq); free(change); free(kinds); free(fds); free(chans); free(vals); return 0 - 12 }

            // Zero-fill change list (required for deterministic unused fields).
            var zi = 0
            while zi < nfds * 32 { ptr_set_byte(change + zi, 0); zi = zi + 1 }

            // Build changelist.
            var kflags = 1 | 4 | 16 // EV_ADD | EV_ENABLE | EV_ONESHOT
            var ci = 0
            var j = 0
            while j < ncases {
                var k = ptr_get(iadd(kinds, j * 8))
                if k == 0 || k == 1 {
                    var fdj = ptr_get(iadd(fds, j * 8))
                    var base = change + ci * 32
                    ptr_set(base + 0, fdj)
                    if k == 0 {
                        // EVFILT_READ == -1
                        ptr_set_byte(base + 8, 255)
                        ptr_set_byte(base + 9, 255)
                    } else {
                        // EVFILT_WRITE == -2
                        ptr_set_byte(base + 8, 254)
                        ptr_set_byte(base + 9, 255)
                    }
                    ptr_set_byte(base + 10, kflags & 255)
                    ptr_set_byte(base + 11, (kflags >> 8) & 255)
                    ptr_set(base + 16, 0)
                    ptr_set(base + 24, 0)
                    ci = ci + 1
                }
                j = j + 1
            }

            nready = sys_kevent(kq, change, nfds, evs, nfds, 0)
            sys_close(kq)
            free(change)
            if nready <= 0 {
                free(evs)
                if nready < 0 {
                    free(kinds); free(fds); free(chans); free(vals)
                    return nready
                }
                continue
            }
            evbuf = evs
        } else {
            // --- Linux: epoll ---
            var nfds2 = nread + nwrite
            var epfd = sys_epoll_create1(0)
            if epfd < 0 {
                free(kinds); free(fds); free(chans); free(vals)
                return epfd
            }

            // Linux epoll syscall ABI is arch-dependent (packed on x86_64, aligned on arm64).
            // `native_runtime_init` probes the active layout once and fills:
            //   - OREN_EPOLL_EVENT_BYTES
            //   - OREN_EPOLL_EVENT_OFF_DATA
            var evsz = OREN_EPOLL_EVENT_BYTES
            if evsz == 0 { evsz = 16 }
            var data_off2 = OREN_EPOLL_EVENT_OFF_DATA
            if data_off2 == 0 { data_off2 = 8 }
            var ev = malloc(evsz)
            if ev == 0 { sys_close(epfd); free(kinds); free(fds); free(chans); free(vals); return 0 - 12 } // ENOMEM
            var out = malloc(nfds2 * evsz)
            if out == 0 { sys_close(epfd); free(ev); free(kinds); free(fds); free(chans); free(vals); return 0 - 12 }

            // Register all fds (best-effort; assumes no duplicates).
            var k = 0
            while k < ncases {
                var kk = ptr_get(iadd(kinds, k * 8))
                if kk == 0 || kk == 1 {
                    var fd = ptr_get(iadd(fds, k * 8))
                    // Zero-fill ev
                    var z = 0
                    while z < evsz { ptr_set_byte(ev + z, 0); z = z + 1 }
                    if kk == 0 { oren_ptr_set_u32_le(ev + 0, OREN_EPOLLIN) }
                    else { oren_ptr_set_u32_le(ev + 0, OREN_EPOLLOUT) }
                    oren_ptr_set_u64_le(ev + data_off2, fd)
                    var rc = sys_epoll_ctl(epfd, OREN_EPOLL_CTL_ADD, fd, ev)
                    if rc < 0 {
                        sys_close(epfd)
                        free(ev)
                        free(out)
                        free(kinds); free(fds); free(chans); free(vals)
                        return rc
                    }
                }
                k = k + 1
            }

            nready = sys_epoll_pwait(epfd, out, nfds2, -1, 0, 0)
            sys_close(epfd)
            free(ev)
            if nready <= 0 {
                free(out)
                if nready < 0 {
                    free(kinds); free(fds); free(chans); free(vals)
                    return nready
                }
                continue
            }
            evbuf = out
        }

        // Deterministic selection: scan cases starting at the rolling cursor.
        var start = g_select_cursor % ncases
        var off = 0
        var picked = -1
        while off < ncases {
            var idx = (start + off) % ncases
            var k = ptr_get(iadd(kinds, idx * 8))
            if k == 0 || k == 1 {
                var fd = ptr_get(iadd(fds, idx * 8))
                var ok = 0
                if g_target_os == 1 {
                    ok = _select_kqueue_event_has(evbuf, nready, k, fd)
                } else {
                    ok = _select_epoll_event_has(evbuf, nready, k, fd)
                }
                if ok == 1 { picked = idx; break }
            }
            off = off + 1
        }

        free(evbuf)

        if picked >= 0 {
            var pk = ptr_get(iadd(kinds, picked * 8))
            var ch = ptr_get(iadd(chans, picked * 8))
            var payload = 0
            if pk == 0 {
                payload = oren_chan_recv(ch)
            } else {
                var v = ptr_get(iadd(vals, picked * 8))
                oren_chan_send(ch, v)
                payload = 1
            }

            var pair = oren_new_list(2)
            oren_list_push(pair, picked)
            oren_list_push(pair, payload)
            g_select_cursor = (picked + 1) % ncases

            free(kinds)
            free(fds)
            free(chans)
            free(vals)
            return pair
        }

        // Spurious events that don't match any case; keep waiting.
    }
}

@oren.keep
fn oren_select_recv(chs) {
    // Rolling: implemented in terms of the general select parser.
    // This preserves AVM semantics where `oren_select_recv([ch1, ch2])` blocks until any has a value.
    return oren_select(chs)
}
