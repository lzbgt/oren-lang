// --- Iteration (generic `for x in ...`) ---
// Iterator contract:
//   oren_iter_next(container, idx) -> [ok, value]
// Where ok is 1 when value exists, 0 when iteration is complete.
//
// Native backend note:
// - Lists and maps are heap objects with magic tags.
// - Strings are raw pointers (C strings); iteration stops at NUL byte.
// - "bytes" in native v0 is typically `list<int 0..255>` (from `oren_read_bytes`).
fn oren_iter_next(container, idx) {
    // Compute result first, then allocate the return list last.
    // This avoids reliance on any particular native backend local/param storage strategy.
    var ok = 0
    var val = 0

    if container != 0 && idx >= 0 {
        // Avoid unsafe probing of arbitrary large integers: only dereference pointers that are
        // tracked by the native GC list, or use a string-style byte read as a last resort.
        var node = oren_find_node(container)
        if node != 0 {
            var kind = ptr_get(iadd(node, 16))

            // List: yield elements.
            if kind == 2 {
                var count = ptr_get(container)

                // Typed buffer views are represented as lists for portability:
                // - slice view:   [buf, off, len]
                // - strided view: [buf, off, len, stride]
                //
                // `for x in view` should iterate the underlying buffer values, not the metadata fields.
                if (count == 3 || count == 4) && idx >= 0 {
                    var b = oren_list_get(container, 0)
                    var off = oren_list_get(container, 1)
                    var n = oren_list_get(container, 2)
                    var stride = 1
                    if count == 4 { stride = oren_list_get(container, 3) }

                    if off >= 0 && n >= 0 && stride > 0 && idx < n {
                        var bnode = oren_find_node(b)
                        if bnode != 0 {
                            var bkind = ptr_get(iadd(bnode, 16))
                            if bkind == 7 {
                                if ptr_get(b + 24) == buf_magic() {
                                    var tag = ptr_get(b + 32)
                                    var blen = ptr_get(b + 0)
                                    var elem_idx = off + (idx * stride)
                                    if elem_idx >= 0 && elem_idx < blen {
                                        var data = native_buf_data_ptr(b)
                                        if tag == BUF_TAG_U8 {
                                            ok = 1
                                            val = ptr_get_byte(data + elem_idx) & 255
                                        } else {
                                            if tag == BUF_TAG_I32 {
                                                ok = 1
                                                val = oren_ptr_get_i32_le(data + elem_idx * 4)
                                            } else {
                                                if tag == BUF_TAG_I64 {
                                                    ok = 1
                                                    val = oren_ptr_get_i64_le(data + elem_idx * 8)
                                                } else {
                                                    if tag == BUF_TAG_F32 {
                                                        ok = 1
                                                        val = oren_u32_bits_to_f32(oren_ptr_get_u32_le(data + elem_idx * 4))
                                                    } else {
                                                        if tag == BUF_TAG_F64 {
                                                            ok = 1
                                                            val = oren_u64_bits_to_f64(oren_ptr_get_u64_le(data + elem_idx * 8))
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if ok == 0 && idx < count {
                    ok = 1
                    // Use the well-tested list accessor to avoid relying on raw buffer math here.
                    val = oren_list_get(container, idx)
                }
            } else {
                // Map: yield keys in deterministic order (stored sorted).
                if kind == 3 {
                    // Iterable map protocol (rolling): allow maps to represent stream-like iterables.
                    //
                    // Used by std/iter.oren:
                    //   {"__iter":"range","start":0,"end":N,"step":1}
                    //
                    // Normal maps still iterate keys deterministically.
                    var it = oren_map_get(container, "__iter")
                    // Important native backend safety note:
                    // - Values are not tagged at runtime, so we must not call `strcmp` on an integer.
                    // - The stdlib `range(...)` helper uses a string literal "range", so pointer equality
                    //   is sufficient and avoids crashing on non-string values.
                    if it == "range" {
                        var start = oren_map_get(container, "start")
                        var end = oren_map_get(container, "end")
                        var step = oren_map_get(container, "step")
                        if step != 0 {
                            var v = start + (idx * step)
                            if step > 0 {
                                if v < end { ok = 1; val = v }
                            } else {
                                if step < 0 {
                                    if v > end { ok = 1; val = v }
                                }
                            }
                        }
                    } else {
                    var count2 = ptr_get(container + 0)
                    if idx < count2 {
                        ok = 1
                        val = oren_map_key_at(container, idx)
                    }
                    }
                } else {
                    // Typed buffers: allow numeric buffers to be iterated.
                    //
                    // Notes:
                    // - buf is a native heap object with:
                    //   - len @ +0
                    //   - data ptr @ +16
                    //   - magic @ +24
                    //   - tag @ +32
                    // - We read raw little-endian payload and return:
                    //   - i32/i64 -> int
                    //   - f32/f64 -> float bits (native float container)
                    if kind == 7 {
                        if ptr_get(container + 24) == buf_magic() {
                            var tag = ptr_get(container + 32)
                            var n = ptr_get(container + 0)
                            if idx < n {
                                var data = native_buf_data_ptr(container)
                                if tag == BUF_TAG_U8 {
                                    ok = 1
                                    val = ptr_get_byte(data + idx) & 255
                                } else {
                                    if tag == BUF_TAG_I32 {
                                        ok = 1
                                        val = oren_ptr_get_i32_le(data + idx * 4)
                                    } else {
                                        if tag == BUF_TAG_I64 {
                                            ok = 1
                                            val = oren_ptr_get_i64_le(data + idx * 8)
                                        } else {
                                            if tag == BUF_TAG_F32 {
                                                ok = 1
                                                val = oren_u32_bits_to_f32(oren_ptr_get_u32_le(data + idx * 4))
                                            } else {
                                                if tag == BUF_TAG_F64 {
                                                    ok = 1
                                                    val = oren_u64_bits_to_f64(oren_ptr_get_u64_le(data + idx * 8))
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        // String: yield byte codepoints until NUL terminator.
                        var ch = ptr_get_byte(iadd(container, idx))
                        if ch != 0 {
                            ok = 1
                            val = ch
                        }
                    }
                }
            }
        } else {
            // Fallback: allow iterating a raw pointer as a C string (best-effort).
            // Keep the old behavior for untracked pointers, but do not attempt this for small ints.
            if container >= 4096 {
                var ch2 = ptr_get_byte(iadd(container, idx))
                if ch2 != 0 {
                    ok = 1
                    val = ch2
                }
            }
        }
    }

    // NOTE (rolling native backend):
    // Construct the `[ok, value]` pair by directly writing into the list buffer.
    var out = oren_new_list(2)
    var out_buf = ptr_get(out + 16)
    ptr_set(out, 2) // count
    ptr_set(out_buf + 0, ok)
    ptr_set(out_buf + 8, val)
    return out
}

// Return a freshly allocated byte buffer (list) from a string literal pointer.
fn oren_string_eq(a, b) {
    if a == 0 { return false }
    if b == 0 { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if ptr_get_byte(a + i) != ptr_get_byte(b + i) { return false }
        i = i + 1
    }
    return true
}

fn oren_bytes_from_string_ptr(s_ptr) {
    var len = oren_string_len(s_ptr)
    var lst = oren_new_list(len)
    var i = 0
    while i < len {
        var b = ptr_get_byte(s_ptr + i)
        oren_list_push(lst, b)
        i = i + 1
    }
    return lst
}

// Public wrapper (portable name used by stdlib/compiler):
// Build a byte list from a string pointer.
fn oren_bytes_from_string(s) {
    return oren_bytes_from_string_ptr(s)
}

// Build a string (NUL-terminated) from a list<int 0..255>.
// This is the inverse of `oren_bytes_from_string(...)` in other backends.
fn oren_string_from_bytes(bytes) {
    if bytes == 0 { return 0 }
    var n = oren_list_len(bytes)
    if n < 0 { return 0 }
    var out = malloc(n + 1)
    if out == 0 { return 0 }
    var i = 0
    while i < n {
        var b = oren_list_get(bytes, i)
        // Best-effort clamp for rolling native mode.
        if b < 0 { b = 0 }
        if b > 255 { b = 255 }
        ptr_set_byte(out + i, b)
        i = i + 1
    }
    ptr_set_byte(out + n, 0)
    oren_track_alloc(out, n + 1, 1) // 1=STRING
    return out
}

fn string_concat(a, b) {
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    var buf = malloc(la + lb + 1)
    if buf == 0 { exit(301) }
    
    var i = 0
    while i < la {
        ptr_set_byte(buf + i, ptr_get_byte(a + i))
        i = i + 1
    }
    
    var j = 0
    while j < lb {
        ptr_set_byte(buf + la + j, ptr_get_byte(b + j))
        j = j + 1
    }
    ptr_set_byte(buf + la + lb, 0)
    oren_track_alloc(buf, la + lb + 1, 1)
    return buf
}

