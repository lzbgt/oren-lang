// --- Iteration (generic `for x in ...`) ---
// Iterator contract:
//   oren_iter_next(container, idx, out_pair) -> [ok, value]
// Where ok is 1 when value exists, 0 when iteration is complete.
//
// Native backend note:
// - Lists and maps are heap objects with magic tags.
// - Strings are raw pointers (C strings); iteration stops at NUL byte.
// - "bytes" in native v0 is typically `list<int 0..255>` (from `oren_read_bytes`).
fn oren_iter_next(container, idx, out_pair) {
    // Compute result first, then allocate the return list last.
    // This avoids reliance on any particular native backend local/param storage strategy.
    var ok = 0
    var val = 0

    if container != 0 && idx >= 0 {
        // Avoid unsafe probing of arbitrary large integers: only dereference pointers that are
        // tracked by the native GC list, or use a string-style byte read as a last resort.
        var node = oren_find_node(container)
        if node != 0 {
            var kind = ptr_get(iadd(node, 16))

            // List<int>: yield elements (no view protocol).
            if kind == list_int_kind() {
                var count = ptr_get(container)
                if idx < count {
                    var buf = ptr_get(iadd(container, 16))
                    if buf != 0 {
                        ok = 1
                        val = ptr_get(iadd(buf, idx * 8))
                    }
                }
            }
            // List: yield elements (or view protocol for typed buffers).
            else if kind == 2 {
                var count = ptr_get(container)
                var is_buf_view = 0

                // Typed-buffer view protocol (rolling, std/buffer):
                // - slice view:   [buf, off, len]
                // - strided view: [buf, off, len, stride]
                // - matrix view:  [buf, off, rows, cols, row_stride]
                //
                // These are represented as *lists* (not maps) to keep hot-loop overhead small.
                // `for x in view` must iterate underlying values, not the metadata list.
                if (count == 3 || count == 4 || count == 5) && idx >= 0 {
                    var buf0 = oren_list_get(container, 0)
                    var bnode0 = oren_find_node(buf0)
                    if bnode0 != 0 && ptr_get(iadd(bnode0, 16)) == 7 && ptr_get(buf0 + 24) == buf_magic() {
                        // Treat this list as a view container (do not fall back to iterating metadata).
                        is_buf_view = 1
                        var tag0 = ptr_get(buf0 + 32)
                        var blen0 = ptr_get(buf0 + 0)
                        var data0 = native_buf_data_ptr(buf0)

                        // Common validity checks.
                        if data0 != 0 && blen0 >= 0 {
                            // Slice view: [buf, off, len]
                            if count == 3 {
                                var off0 = oren_list_get(container, 1)
                                var n0 = oren_list_get(container, 2)
                                if off0 >= 0 && n0 >= 0 && idx < n0 {
                                    if off0 <= blen0 {
                                        var maxn0 = blen0 - off0
                                        if n0 <= maxn0 {
                                            ok = 1
                                            var at = off0 + idx
                                            if tag0 == BUF_TAG_U8 {
                                                val = ptr_get_byte(data0 + at) & 255
                                            } else if tag0 == BUF_TAG_I32 {
                                                val = oren_ptr_get_i32_le(data0 + (at << 2))
                                            } else if tag0 == BUF_TAG_I64 {
                                                val = oren_ptr_get_i64_le(data0 + (at << 3))
                                            } else if tag0 == BUF_TAG_F32 {
                                                val = oren_u32_bits_to_f32(oren_ptr_get_u32_le(data0 + (at << 2)))
                                            } else if tag0 == BUF_TAG_F64 {
                                                val = oren_u64_bits_to_f64(oren_ptr_get_u64_le(data0 + (at << 3)))
                                            } else {
                                                ok = 0
                                            }
                                        }
                                    }
                                }
                            }

                            // Strided view: [buf, off, len, stride]
                            else if count == 4 {
                                var off1 = oren_list_get(container, 1)
                                var n1 = oren_list_get(container, 2)
                                var stride1 = oren_list_get(container, 3)
                                if off1 >= 0 && n1 >= 0 && stride1 > 0 && idx < n1 {
                                    if n1 == 0 {
                                        // empty
                                    } else if off1 <= blen0 {
                                        // Bounds check using division to avoid overflow:
                                        // last index = off + (n-1)*stride must be < blen
                                        var max_last = blen0 - 1
                                        if blen0 == 0 { max_last = -1 }
                                        if max_last >= off1 {
                                            var max_steps = (max_last - off1) / stride1
                                            var need_steps = n1 - 1
                                            if need_steps <= max_steps {
                                                ok = 1
                                                var at2 = off1 + idx * stride1
                                                if tag0 == BUF_TAG_U8 {
                                                    val = ptr_get_byte(data0 + at2) & 255
                                                } else if tag0 == BUF_TAG_I32 {
                                                    val = oren_ptr_get_i32_le(data0 + (at2 << 2))
                                                } else if tag0 == BUF_TAG_I64 {
                                                    val = oren_ptr_get_i64_le(data0 + (at2 << 3))
                                                } else if tag0 == BUF_TAG_F32 {
                                                    val = oren_u32_bits_to_f32(oren_ptr_get_u32_le(data0 + (at2 << 2)))
                                                } else if tag0 == BUF_TAG_F64 {
                                                    val = oren_u64_bits_to_f64(oren_ptr_get_u64_le(data0 + (at2 << 3)))
                                                } else {
                                                    ok = 0
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Matrix view: [buf, off, rows, cols, row_stride] (row-major)
                            else if count == 5 {
                                var offm = oren_list_get(container, 1)
                                var rows = oren_list_get(container, 2)
                                var cols = oren_list_get(container, 3)
                                var row_stride = oren_list_get(container, 4)
                                if offm >= 0 && rows >= 0 && cols >= 0 && row_stride > 0 {
                                    var total = rows * cols
                                    if idx < total && total >= 0 {
                                        if total == 0 {
                                            // empty
                                        } else if offm <= blen0 {
                                            // Bounds: last element index = off + (rows-1)*row_stride + (cols-1)
                                            var max_last2 = blen0 - 1
                                            if blen0 == 0 { max_last2 = -1 }
                                            if max_last2 >= offm {
                                                // Require enough rows (row_stride steps) and cols within a row.
                                                var max_rows = (max_last2 - offm) / row_stride
                                                if (rows - 1) <= max_rows && cols > 0 {
                                                    var max_cols = max_last2 - (offm + (rows - 1) * row_stride)
                                                    if (cols - 1) <= max_cols {
                                                        ok = 1
                                                        var r = idx / cols
                                                        var c = idx - (r * cols)
                                                        var at3 = offm + r * row_stride + c
                                                        if tag0 == BUF_TAG_U8 {
                                                            val = ptr_get_byte(data0 + at3) & 255
                                                        } else if tag0 == BUF_TAG_I32 {
                                                            val = oren_ptr_get_i32_le(data0 + (at3 << 2))
                                                        } else if tag0 == BUF_TAG_I64 {
                                                            val = oren_ptr_get_i64_le(data0 + (at3 << 3))
                                                        } else if tag0 == BUF_TAG_F32 {
                                                            val = oren_u32_bits_to_f32(oren_ptr_get_u32_le(data0 + (at3 << 2)))
                                                        } else if tag0 == BUF_TAG_F64 {
                                                            val = oren_u64_bits_to_f64(oren_ptr_get_u64_le(data0 + (at3 << 3)))
                                                        } else {
                                                            ok = 0
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Default list iteration (elements).
                if ok == 0 && is_buf_view == 0 && idx < count {
                    ok = 1
                    // Use the well-tested list accessor to avoid relying on raw buffer math here.
                    val = oren_list_get(container, idx)
                }
            } else {
                // Map: yield keys in deterministic order (stored sorted).
                if kind == 3 {
                    // Iterable map protocol (rolling): allow maps to represent stream-like iterables.
                    //
                    // Used by std/iter.oren:
                    //   {"__iter":"range","start":0,"end":N,"step":1}
                    //
                    // Normal maps still iterate keys deterministically.
                    var it = oren_map_get_str(container, "__iter")
                    // Important native backend safety note:
                    // - Values are not tagged at runtime, so we must not call `strcmp` on an integer.
                    // - Do not rely on pointer equality of string literals across modules/rtobj caches.
                    //   Prefer string-bytes equality, guarded by `oren_is_string(...)`.
                    if it == "range" || (it != 0 && oren_is_string(it) && oren_string_eq(it, "range")) {
                        var start = oren_map_get_str(container, "start")
                        var end = oren_map_get_str(container, "end")
                        var step = oren_map_get_str(container, "step")
                        if step != 0 {
                            var v = start + (idx * step)
                            if step > 0 {
                                if v < end { ok = 1; val = v }
                            } else {
                                if step < 0 {
                                    if v > end { ok = 1; val = v }
                                }
                            }
                        }
                    } else {
                        // Iterable map protocol (rolling): list slice view.
                        //
                        // Produced by std:list.slice_view(xs, off, n):
                        //   {"__iter":"list_slice","base":xs,"off":off,"len":n}
                        //
                        // Safety + determinism rules:
                        // - Only accept if `base` is a tracked list.
                        // - Treat malformed values as empty iteration (do not crash).
                        // - Use subtraction bounds checks to avoid overflow on `off + len`.
                        if it == "list_slice" || (it != 0 && oren_is_string(it) && oren_string_eq(it, "list_slice")) {
                            var base = oren_map_get_str(container, "base")
                            var off2 = oren_map_get_str(container, "off")
                            var n2 = oren_map_get_str(container, "len")

                            if base != 0 && off2 >= 0 && n2 >= 0 && idx < n2 {
                                var bnode2 = oren_find_node(base)
                                if bnode2 != 0 {
                                    var bkind2 = ptr_get(iadd(bnode2, 16))
                                    if bkind2 == 2 {
                                        var bcount2 = ptr_get(base)
                                        if off2 <= bcount2 {
                                            var max_n2 = bcount2 - off2
                                            if n2 <= max_n2 {
                                                ok = 1
                                                val = oren_list_get(base, off2 + idx)
                                            }
                                        }
                                    }
                                }
                            }
                        } else {
                            var count2 = ptr_get(container + 0)
                            if idx < count2 {
                                ok = 1
                                val = oren_map_key_at(container, idx)
                            }
                        }
                    }
                } else {
                    // Typed buffers: allow numeric buffers to be iterated.
                    //
                    // Notes:
                    // - buf is a native heap object with:
                    //   - len @ +0
                    //   - data ptr @ +16
                    //   - magic @ +24
                    //   - tag @ +32
                    // - We read raw little-endian payload and return:
                    //   - i32/i64 -> int
                    //   - f32/f64 -> float bits (native float container)
                    if kind == 7 {
                        if ptr_get(container + 24) == buf_magic() {
                            var tag = ptr_get(container + 32)
                            var n = ptr_get(container + 0)
                            if idx < n {
                                var data = native_buf_data_ptr(container)
                                if tag == BUF_TAG_U8 {
                                    ok = 1
                                    val = ptr_get_byte(data + idx) & 255
                                } else {
                                    if tag == BUF_TAG_I32 {
                                        ok = 1
                                        val = oren_ptr_get_i32_le(data + idx * 4)
                                    } else {
                                        if tag == BUF_TAG_I64 {
                                            ok = 1
                                            val = oren_ptr_get_i64_le(data + idx * 8)
                                        } else {
                                            if tag == BUF_TAG_F32 {
                                                ok = 1
                                                val = oren_u32_bits_to_f32(oren_ptr_get_u32_le(data + idx * 4))
                                            } else {
                                                if tag == BUF_TAG_F64 {
                                                    ok = 1
                                                    val = oren_u64_bits_to_f64(oren_ptr_get_u64_le(data + idx * 8))
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    } else {
                        // String: yield byte codepoints until NUL terminator.
                        var ch = ptr_get_byte(iadd(container, idx))
                        if ch != 0 {
                            ok = 1
                            val = ch
                        }
                    }
                }
            }
        } else {
            // Fallback: allow iterating a raw pointer as a C string (best-effort).
            // Keep the old behavior for untracked pointers, but do not attempt this for small ints.
            if container >= 4096 {
                var ch2 = ptr_get_byte(iadd(container, idx))
                if ch2 != 0 {
                    ok = 1
                    val = ch2
                }
            }
        }
    }

    // NOTE (rolling native backend):
    // Fill a provided out-pair when possible to avoid per-iteration allocations in `for x in ...`.
    var out = out_pair
    if out != 0 {
        // Safety: do not probe `out+...` unless `out` is a tracked list pointer.
        var onode = oren_find_node(out)
        if onode != 0 && ptr_get(iadd(onode, 16)) == 2 && ptr_get(out + 24) == list_magic() {
            var cap = ptr_get(out + 8)
            var buf = ptr_get(out + 16)
            if cap < 2 || buf == 0 { out = 0 }
        } else {
            out = 0
        }
    }
    if out == 0 {
        out = oren_new_list(2)
    }
    var out_buf = ptr_get(out + 16)
    ptr_set(out, 2) // count
    ptr_set(out_buf + 0, ok)
    ptr_set(out_buf + 8, val)
    return out
}

// Return a freshly allocated byte-native buffer from a string literal pointer.
fn oren_string_eq(a, b) {
    // Fast path: avoid a separate length pass.
    // Semantics (rolling): treat nil as not-equal (even nil==nil is false here).
    if a == 0 || native_value_is_nil(a) { return false }
    if b == 0 || native_value_is_nil(b) { return false }
    // Safety (native backend):
    // Values are not tagged at runtime; never call `strcmp` on non-strings.
    // `native_is_string_ptr` is a safe predicate (tracked STRING or embedded cstr0 literal).
    if native_is_string_ptr(a) == 0 { return false }
    if native_is_string_ptr(b) == 0 { return false }
    return strcmp(a, b) == 0
}

fn oren_bytes_from_string_ptr(s_ptr) {
    // Build a u8_buf from a NUL-terminated string pointer.
    //
    // PERF (native backend + compiler workloads):
    // Keep bytes in their canonical carrier instead of boxing each byte into a list slot.
    if s_ptr == 0 || native_value_is_nil(s_ptr) { return oren_u8_buf_new_uninit(0) }
    var len = oren_string_len(s_ptr)
    if len < 0 { return oren_err(4, "bytes_from_string: invalid string") }
    var out = oren_u8_buf_new_uninit(len)
    if oren_is_err(out) { return out }
    var data = native_buf_data_ptr(out)
    if data == 0 && len > 0 {
        return oren_err(8, "bytes_from_string: alloc failed")
    }
    if len > 0 { oren_memcpy(data, s_ptr, len) }
    return out
}

// Public wrapper (portable name used by stdlib/compiler):
// Build byte-native u8 buffer from a string pointer.
fn oren_bytes_from_string(s) {
    return oren_bytes_from_string_ptr(s)
}

fn oren_u8_buf_from_string_slice(s, start, len) {
    if s == 0 || native_value_is_nil(s) { return oren_err(4, "u8_buf_from_string_slice: s must be string") }
    if native_is_string_ptr(s) == 0 { return oren_err(4, "u8_buf_from_string_slice: s must be string") }
    if start < 0 || len < 0 { return oren_err(4, "u8_buf_from_string_slice: negative range") }
    var total = oren_string_len(s)
    if total < 0 { return oren_err(4, "u8_buf_from_string_slice: invalid string") }
    if native_bytes_range_ok(total, start, len) != true { return oren_err(4, "u8_buf_from_string_slice: out of bounds") }
    var out = oren_u8_buf_new_uninit(len)
    if oren_is_err(out) { return out }
    var data = native_buf_data_ptr(out)
    if data == 0 && len > 0 { return oren_err(8, "u8_buf_from_string_slice: alloc failed") }
    if len > 0 { oren_memcpy(data, s + start, len) }
    return out
}

fn oren_u8_buf_copy_from_string_slice(out, s, start, len) {
    if native_bytes_is_u8_buf(out) != true { return oren_err(4, "u8_buf_copy_from_string_slice: out must be u8_buf") }
    if s == 0 || native_value_is_nil(s) { return oren_err(4, "u8_buf_copy_from_string_slice: s must be string") }
    if native_is_string_ptr(s) == 0 { return oren_err(4, "u8_buf_copy_from_string_slice: s must be string") }
    if start < 0 || len < 0 { return oren_err(4, "u8_buf_copy_from_string_slice: negative range") }
    var out_len = ptr_get(out + 0)
    if out_len != len { return oren_err(4, "u8_buf_copy_from_string_slice: length mismatch") }
    var total = oren_string_len(s)
    if total < 0 { return oren_err(4, "u8_buf_copy_from_string_slice: invalid string") }
    if native_bytes_range_ok(total, start, len) != true { return oren_err(4, "u8_buf_copy_from_string_slice: out of bounds") }
    var data = native_buf_data_ptr(out)
    if data == 0 && len > 0 { return oren_err(8, "u8_buf_copy_from_string_slice: payload is nil") }
    if len > 0 { oren_memcpy(data, s + start, len) }
    return out
}

fn oren_u8_buf_copy_from_string_slice_at(out, dst_start, s, start, len) {
    if native_bytes_is_u8_buf(out) != true { return oren_err(4, "u8_buf_copy_from_string_slice_at: out must be u8_buf") }
    if s == 0 || native_value_is_nil(s) { return oren_err(4, "u8_buf_copy_from_string_slice_at: s must be string") }
    if native_is_string_ptr(s) == 0 { return oren_err(4, "u8_buf_copy_from_string_slice_at: s must be string") }
    if dst_start < 0 || start < 0 || len < 0 { return oren_err(4, "u8_buf_copy_from_string_slice_at: negative range") }
    var out_len = ptr_get(out + 0)
    var total = oren_string_len(s)
    if total < 0 { return oren_err(4, "u8_buf_copy_from_string_slice_at: invalid string") }
    if native_bytes_range_ok(out_len, dst_start, len) != true { return oren_err(4, "u8_buf_copy_from_string_slice_at: out of bounds") }
    if native_bytes_range_ok(total, start, len) != true { return oren_err(4, "u8_buf_copy_from_string_slice_at: out of bounds") }
    var data = native_buf_data_ptr(out)
    if data == 0 && len > 0 { return oren_err(8, "u8_buf_copy_from_string_slice_at: payload is nil") }
    if len > 0 { oren_memcpy(data + dst_start, s + start, len) }
    return out
}

// Build a string (NUL-terminated) from a byte container.
// This is the inverse of `oren_bytes_from_string(...)` in other backends.
fn oren_string_from_bytes(bytes) {
    if bytes == 0 { return 0 }
    if native_bytes_is_u8_buf(bytes) == true {
        return oren_string_from_bytes_slice(bytes, 0, ptr_get(bytes + 0))
    }
    var total = oren_bytes_len(bytes)
    if oren_is_err(total) { return 0 }
    var out2 = oren_string_from_bytes_slice(bytes, 0, total)
    if oren_is_err(out2) { return 0 }
    return out2
}

fn string_concat(a, b) {
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    var buf = malloc(la + lb + 1)
    if buf == 0 { exit(301) }
    
    if la > 0 { oren_memcpy(buf, a, la) }
    if lb > 0 { oren_memcpy(buf + la, b, lb) }
    ptr_set_byte(buf + la + lb, 0)
    oren_track_alloc(buf, la + lb + 1, 1)
    return buf
}

fn oren_string_join(parts) {
    // Join list<string> into one string with a single allocation.
    if parts == nil { return "" }
    var n = oren_list_len(parts)
    if n <= 0 { return "" }

    var total = 0
    var i = 0
    while i < n {
        var s = oren_list_get(parts, i)
        if s != nil {
            var ln = oren_string_len(s)
            if ln > 0 { total = total + ln }
        }
        i = i + 1
    }

    var out = malloc(total + 1)
    if out == 0 { exit(302) }

    var off = 0
    i = 0
    while i < n {
        var s2 = oren_list_get(parts, i)
        if s2 != nil {
            var ln2 = oren_string_len(s2)
            if ln2 > 0 {
                oren_memcpy(out + off, s2, ln2)
                off = off + ln2
            }
        }
        i = i + 1
    }
    ptr_set_byte(out + total, 0)
    oren_track_alloc(out, total + 1, 1) // 1=STRING
    return out
}
