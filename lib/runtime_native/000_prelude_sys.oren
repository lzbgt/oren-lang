// - sys_wsarecv(sock, buf_ptr, buf_len, flags_ptr, bytes_ptr, overlapped_ptr) -> 0 or -errno
// - sys_wsarecvfrom(sock, buf_ptr, buf_len, flags_ptr, bytes_ptr, overlapped_ptr, sa_out, sa_lenp) -> 0 or -errno
// - sys_wsasend(sock, buf_ptr, buf_len, flags, bytes_ptr, overlapped_ptr) -> 0 or -errno
// - sys_wsa_get_last_error() -> WSA error code (or -ENOSYS if not available)
//
// Notes:
// - These are used for IOCP bring-up (completion-based NET operations). They should treat
//   WSA_IO_PENDING (queued) as success (0), because completion will be delivered later.
