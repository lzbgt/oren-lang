fn sys_mkdir(path, mode) {
    // Stub only. Native backends lower call sites to real syscalls / CreateDirectoryA.
    // If this executes in a native binary, something is badly wrong; returning 0 keeps
    // failures obvious (subsequent FS ops will fail).
    return 0
}
