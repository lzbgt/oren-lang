fn print_hex(n) {
    // Best-effort hex printer for debugging (no libc).
    // Prints exactly 16 hex digits (u64) plus newline.
    var buf = malloc(17)
    if buf == 0 { return 0 }
    var i = 0
    var hex = "0123456789abcdef"
    while i < 16 {
        var shift = (15 - i) * 4
        var digit = (n >> shift) & 15
        var ch = oren_string_byte_at_unchecked(hex, digit)
        ptr_set_byte(buf + i, ch)
        i = i + 1
    }
    ptr_set_byte(buf + 16, 10) // newline
    sys_write(1, buf, 17)
    return 0
}

fn stack_trace() {
    print("Traceback (most recent call first):")
    var sp = get_sp()
    var fp = get_fp()
    var max_fp = sp + 1048576 // 1 MiB above current SP (best-effort corruption guard)
    var i = 0
    while fp != 0 {
        if i > 20 {
            print("  ... (truncated)")
            return 0
        }
        // Best-effort safety guards:
        // - require frame pointer to be within a reasonable range relative to SP
        // - require 8-byte alignment
        if fp < sp {
            print("  ... (invalid fp < sp)")
            return 0
        }
        if fp > max_fp {
            print("  ... (invalid fp > sp+1MiB)")
            return 0
        }
        var align_bits = fp & 7
        if align_bits != 0 {
            print("  ... (unaligned fp)")
            return 0
        }
        var lr = ptr_get(iadd(fp, 8))
        // Prefer the embedded debug-info table (when present) via `oren_resolve_symbol`,
        // falling back to the backend's best-effort `resolve_symbol` intrinsic.
        var name = oren_resolve_symbol(lr)
        // Prefer language-level string `+` over manual `string_concat` chains.
        print("  at " + name + " (pc=" + oren_int_to_string(lr) + ")")
        // print_hex(lr)
        var next = ptr_get(fp)
        if next != 0 && next <= fp {
            print("  ... (corrupt fp chain)")
            return 0
        }
        fp = next
        i = i + 1
    }
}

// NOTE (native backend): `sys_*` are compiler intrinsics.
//
// Their *call sites* are lowered directly to syscalls by the native backend codegen
// (see `lib/compiler/arm64_native_expr_syscalls.oren`), including calls from this
// injected runtime itself.
//
// These stub bodies exist only so the source parses/links during self-hosting and
// so the same source can be typechecked/loaded by other backends while the project
// is still rolling. They should never execute in a correctly built native binary.
