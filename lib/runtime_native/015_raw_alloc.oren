// --- Raw allocation helpers (native backend; syscall-first robustness) ---
//
// `malloc_raw` is a native-backend intrinsic intended for runtime metadata allocations
// that must NOT be tracked by the mark/sweep GC.
//
// Rolling reality:
// - When bringing up new OS/ABI targets, `malloc_raw` can temporarily return invalid
//   values (0, small, or negative -errno style).
// - Early runtime init code must stay robust: prefer a syscall-first `mmap` fallback.
//
// IMPORTANT: this module must not depend on later runtime helpers (strings, heap, etc).
// Keep it leaf-ish and safe for use during `native_runtime_init`.

// Native-backend intrinsic (stub for parsing/other backends).
fn malloc_raw(size) { return 0 }

// Dedicated raw arena for runtime metadata (tracking nodes, tables, etc).
// Keep it separate from the GC heap to avoid aliasing/corruption in rolling builds.
var g_raw_arena_ptr = 0
var g_raw_arena_limit = 0

fn native_raw_arena_alloc(size) {
    if size == 0 { return 0 }
    if size < 0 { return 0 }
    var want = size
    var rem = want % 16
    if rem != 0 { want = iadd(want, 16 - rem) }

    var cur = g_raw_arena_ptr
    var lim = g_raw_arena_limit
    if cur == 0 || iadd(cur, want) > lim {
        var chunk = 65536
        if want > chunk { chunk = want }
        var base = sys_mmap_private_anon(chunk)
        if base == 0 { return 0 }
        if base == -1 { return 0 }
        if native_is_neg_i64(base) == true { return 0 }
        if base < 4096 { return 0 }
        g_raw_arena_ptr = iadd(base, want)
        g_raw_arena_limit = iadd(base, chunk)
        return base
    }

    g_raw_arena_ptr = iadd(cur, want)
    return cur
}

// RAW mmap header for large runtime allocations (and typed-buffer payloads):
// [magic:u64, total_len:u64, backend:u64, ...padding... ] (64 bytes)
//
// Placed in the early raw-alloc module so both:
// - typed buffers (payload mmap)
// - the allocator free-path (RAW_MMAP kind)
// can share a single definition even when runtime profiles exclude HPC surfaces.
fn raw_magic() { return 5715707079776360240 } // 0x4f52454e52415730 ("ORENRAW0") as u64 (rolling)
fn raw_hdr_size() { return 64 }

fn native_is_neg_i64(x) {
    // Signed negativity predicate for syscall-first paths that return -errno.
    return x < 0
}

fn native_cstr_len(cstr_ptr) {
    // Best-effort NUL-terminated length (bounded) for emergency diagnostics.
    if cstr_ptr == 0 { return 0 }
    var i = 0
    while i < 65536 {
        if ptr_get_byte(iadd(cstr_ptr, i)) == 0 { return i }
        i = i + 1
    }
    return 65536
}

fn native_abort(msg_cstr) {
    // Fail-fast helper that avoids heap allocation (safe even if allocator is corrupted).
    if msg_cstr != 0 {
        sys_write(2, msg_cstr, native_cstr_len(msg_cstr))
    }
    exit(199)
    return 0
}

fn native_malloc_raw_or_mmap(size) {
    // Robust raw allocator:
    // - Prefer a dedicated raw arena (separate from GC heap)
    // - Fall back to a direct anonymous mmap if arena fails
    var p = native_raw_arena_alloc(size)
    if p != 0 { return p }

    var q = sys_mmap_private_anon(size)
    if q == 0 { return 0 }
    if q == -1 { native_abort("native_malloc_raw_or_mmap: sys_mmap_private_anon returned -1\n") }
    if native_is_neg_i64(q) == true { return 0 }
    if q < 4096 { return 0 }
    return q
}
