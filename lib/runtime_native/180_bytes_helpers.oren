// --- Bytes helpers (portable API surface; native runtime implementation) ---
//
// In native mode we represent "bytes" as:
// - `list<int 0..255>` (legacy; still supported)
// - `LIST_INT` read carriers (packed int-list byte sources)
// - `u8_buf` (preferred; zero-copy IO + pack_view compatible)
//
// These helpers unify the surface so higher-level libraries can be backend-agnostic.

fn oren_bytes_len(bytes) {
    if bytes == 0 { return oren_err(4, "bytes_len: bytes is nil") }
    if native_bytes_is_list(bytes) == true { return ptr_get(bytes) }
    if native_bytes_is_list_int(bytes) == true { return ptr_get(bytes) }
    if native_bytes_is_u8_buf(bytes) == true { return ptr_get(bytes + 0) }
    return oren_err(4, "bytes_len expects list<int>, LIST_INT, or u8_buf")
}

fn native_bytes_range_ok(count, start, len) {
    if count < 0 { return false }
    if start < 0 { return false }
    if len < 0 { return false }
    if start > count { return false }
    return len <= count - start
}

fn native_bytes_copy_span(bytes, start, len, dst) {
    if bytes == 0 { return oren_err(4, "bytes_copy_span: bytes is nil") }
    if dst == 0 && len > 0 { return oren_err(8, "bytes_copy_span: destination is nil") }
    var total = oren_bytes_len(bytes)
    if oren_is_err(total) { return total }
    if native_bytes_range_ok(total, start, len) != true { return oren_err(4, "bytes_copy_span: out of bounds") }
    if len == 0 { return 0 }

    if native_bytes_is_u8_buf(bytes) == true {
        var data = native_buf_data_ptr(bytes)
        if data == 0 { return oren_err(4, "bytes_copy_span: buf payload is nil") }
        oren_memcpy(dst, data + start, len)
        return 0
    }

    var list_buf = ptr_get(bytes + 16)
    if list_buf == 0 { return oren_err(4, "bytes_copy_span: list buffer is nil") }
    var i = 0
    while i < len {
        var b = ptr_get(list_buf + (start + i) * 8)
        if b < 0 || b > 255 { return oren_err(4, "bytes_copy_span: byte out of range") }
        ptr_set_byte(dst + i, b & 255)
        i = i + 1
    }
    return 0
}

fn native_bytes_copy_span_to_int_list(bytes, start, len, dst_list) {
    if bytes == 0 { return oren_err(4, "bytes_copy_span_to_int_list: bytes is nil") }
    if dst_list == 0 { return oren_err(8, "bytes_copy_span_to_int_list: destination is nil") }
    var total = oren_bytes_len(bytes)
    if oren_is_err(total) { return total }
    if native_bytes_range_ok(total, start, len) != true { return oren_err(4, "bytes_copy_span_to_int_list: out of bounds") }
    var out_buf = ptr_get(dst_list + 16)
    if out_buf == 0 && len > 0 { return oren_err(8, "bytes_copy_span_to_int_list: alloc failed") }

    if native_bytes_is_u8_buf(bytes) == true {
        var data = native_buf_data_ptr(bytes)
        if data == 0 && len > 0 { return oren_err(4, "bytes_copy_span_to_int_list: buf payload is nil") }
        var i = 0
        while i < len {
            ptr_set(out_buf + i * 8, ptr_get_byte(data + start + i) & 255)
            i = i + 1
        }
        ptr_set(dst_list, len)
        return 0
    }

    var list_buf = ptr_get(bytes + 16)
    if list_buf == 0 && len > 0 { return oren_err(4, "bytes_copy_span_to_int_list: list buffer is nil") }
    var j = 0
    while j < len {
        var b = ptr_get(list_buf + (start + j) * 8)
        if b < 0 || b > 255 { return oren_err(4, "bytes_copy_span_to_int_list: byte out of range") }
        ptr_set(out_buf + j * 8, b)
        j = j + 1
    }
    ptr_set(dst_list, len)
    return 0
}

// Build a string from a slice of a byte container.
// Used by the compiler's parallel module pipeline to decode astbin without per-byte boxing.
@oren.keep
	fn oren_string_from_bytes_slice(bytes, start, len) {
    if bytes == 0 { return oren_err(4, "string_from_bytes_slice: bytes is nil") }
    if start < 0 || len < 0 { return oren_err(4, "string_from_bytes_slice: negative range") }

    if native_bytes_is_u8_buf(bytes) == true {
        var count = ptr_get(bytes + 0)
        if native_bytes_range_ok(count, start, len) != true { return oren_err(4, "string_from_bytes_slice: out of bounds") }
        var src = native_buf_data_ptr(bytes)
        if src == 0 && len > 0 { return oren_err(4, "string_from_bytes_slice: buf payload is nil") }
		    var out_direct = 0
		    if bytes_untracked_strings_enabled() == 0 {
		        out_direct = malloc_k(len + 1, 1)
		    } else {
		        out_direct = malloc(len + 1)
		    }
		    if out_direct == 0 { return oren_err(8, "string_from_bytes_slice: alloc failed") }
        if len > 0 { oren_memcpy(out_direct, src + start, len) }
		    ptr_set_byte(out_direct + len, 0)
		    return out_direct
    }

    var total = oren_bytes_len(bytes)
    if oren_is_err(total) { return oren_err(4, "string_from_bytes_slice expects list<int>, LIST_INT, or u8_buf") }
    if native_bytes_range_ok(total, start, len) != true { return oren_err(4, "string_from_bytes_slice: out of bounds") }

	    // If tracking is enabled, allocate as a tracked STRING directly (single tracking call).
	    // When untracked mode is enabled, we fall back to `malloc` and skip the extra tracking,
	    // preserving the existing "best-effort" semantics (strings are not guaranteed to be kind=1).
	    var out = 0
	    if bytes_untracked_strings_enabled() == 0 {
	        out = malloc_k(len + 1, 1)
	    } else {
	        out = malloc(len + 1)
	    }
	    if out == 0 { return oren_err(8, "string_from_bytes_slice: alloc failed") }

    var rc = native_bytes_copy_span(bytes, start, len, out)
    if oren_is_err(rc) {
        free(out)
        return rc
    }
	    ptr_set_byte(out + len, 0)
	    return out
	}

// Cached env flag to avoid repeated envp lookups in hot paths.
var g_untracked_strings = -1
fn bytes_untracked_strings_enabled() {
    if g_untracked_strings == 0 || g_untracked_strings == 1 { return g_untracked_strings }
    var v = native_envp_get_value_ptr("OREN_UNTRACKED_STRINGS")
    var on = 0
    if v != 0 {
        var b0 = ptr_get_byte(v) & 255
        if b0 != 0 && b0 != 48 { on = 1 } // not empty and not '0'
    }
    g_untracked_strings = on
    return g_untracked_strings
}

// Build a u8_buf from a slice of a byte container.
// Used by tooling (astbin decode) to avoid per-byte `oren_bytes_get_u8`/`oren_buf_store_u8` loops.
@oren.keep
fn oren_u8_buf_from_bytes_slice(bytes, start, len) {
    if bytes == 0 { return oren_err(4, "u8_buf_from_bytes_slice: bytes is nil") }
    if start < 0 || len < 0 { return oren_err(4, "u8_buf_from_bytes_slice: negative range") }

    if native_bytes_is_u8_buf(bytes) == true {
        var count = ptr_get(bytes + 0)
        if native_bytes_range_ok(count, start, len) != true { return oren_err(4, "u8_buf_from_bytes_slice: out of bounds") }
        var out_direct = oren_u8_buf_new_uninit(len)
        if oren_is_err(out_direct) { return out_direct }
        if len == 0 { return out_direct }
        var src = native_buf_data_ptr(bytes)
        var dst = native_buf_data_ptr(out_direct)
        if src == 0 || dst == 0 { return oren_err(8, "u8_buf_from_bytes_slice: alloc failed") }
        oren_memcpy(dst, src + start, len)
        return out_direct
    }

    var total = oren_bytes_len(bytes)
    if oren_is_err(total) { return oren_err(4, "u8_buf_from_bytes_slice expects list<int>, LIST_INT, or u8_buf") }
    if native_bytes_range_ok(total, start, len) != true { return oren_err(4, "u8_buf_from_bytes_slice: out of bounds") }

    var out = oren_u8_buf_new_uninit(len)
    if oren_is_err(out) { return out }
    if len == 0 { return out }

    var dst = native_buf_data_ptr(out)
    if dst == 0 { return oren_err(8, "u8_buf_from_bytes_slice: alloc failed") }

    var rc = native_bytes_copy_span(bytes, start, len, dst)
    if oren_is_err(rc) { return rc }
    return out
}

fn bytes_hex_nibble(c) {
    // Return 0..15 or -1.
    if c >= 48 && c <= 57 { return c - 48 } // '0'..'9'
    if c >= 97 && c <= 102 { return c - 87 } // 'a'..'f'
    if c >= 65 && c <= 70 { return c - 55 } // 'A'..'F'
    return -1
}

fn oren_bytes_from_hex(s) {
    if s == 0 { return oren_err(4, "bytes_from_hex: string is nil") }
    var n = oren_string_len(s)
    if n < 0 { return oren_err(4, "bytes_from_hex: invalid string") }
    var n_is_odd = n & 1
    if n_is_odd != 0 { return oren_err(4, "bytes_from_hex: odd length") }
    var outn = n / 2
    var out = oren_u8_buf_new_uninit(outn)
    if oren_is_err(out) { return out }
    var outp = native_buf_data_ptr(out)
    if outp == 0 && outn != 0 { return oren_err(8, "bytes_from_hex: alloc failed") }
    var i = 0
    while i < outn {
        var c0 = ptr_get_byte(s + i * 2 + 0)
        var c1 = ptr_get_byte(s + i * 2 + 1)
        var hi = bytes_hex_nibble(c0)
        var lo = bytes_hex_nibble(c1)
        if hi < 0 || lo < 0 { return oren_err(4, "bytes_from_hex: invalid hex digit") }
        ptr_set_byte(outp + i, ((hi << 4) | lo) & 255)
        i = i + 1
    }
    return out
}

fn bytes_hex_char(n) {
    // n is 0..15
    if n < 10 { return 48 + n } // '0'..'9'
    return 87 + n // 'a'..'f'
}

		fn oren_bytes_to_hex(bytes) {
		    var n = oren_bytes_len(bytes)
		    if oren_is_err(n) { return n }
		    var out = malloc_k(n * 2 + 1, 1)
		    if out == 0 { return oren_err(8, "bytes_to_hex: alloc failed") }
	    if native_bytes_is_u8_buf(bytes) == true {
	        var data = native_buf_data_ptr(bytes)
	        if data == 0 && n > 0 { return oren_err(4, "bytes_to_hex: buf payload is nil") }
	        var i = 0
	        while i < n {
	            var b = ptr_get_byte(data + i) & 255
	            ptr_set_byte(out + i * 2 + 0, bytes_hex_char((b >> 4) & 15))
	            ptr_set_byte(out + i * 2 + 1, bytes_hex_char(b & 15))
	            i = i + 1
	        }
	    } else {
	        var list_buf = ptr_get(bytes + 16)
	        if list_buf == 0 && n > 0 { return oren_err(4, "bytes_to_hex: list buffer is nil") }
	        var j = 0
	        while j < n {
	            var b2 = ptr_get(list_buf + j * 8)
	            if b2 < 0 || b2 > 255 { return oren_err(4, "bytes_to_hex: byte out of range") }
	            ptr_set_byte(out + j * 2 + 0, bytes_hex_char((b2 >> 4) & 15))
	            ptr_set_byte(out + j * 2 + 1, bytes_hex_char(b2 & 15))
	            j = j + 1
	        }
	    }
		    ptr_set_byte(out + n * 2, 0)
		    return out
		}

fn oren_bytes_unpack(bytes) {
    var n = oren_bytes_len(bytes)
    if oren_is_err(n) { return n }
    var out = oren_new_list(n)
    var rc = native_bytes_copy_span_to_int_list(bytes, 0, n, out)
    if oren_is_err(rc) { return rc }
    return out
}

fn oren_bytes_pack(xs) {
    if xs == 0 { return oren_err(4, "bytes_pack: list is nil") }
    if native_bytes_is_list(xs) != true && native_bytes_is_list_int(xs) != true { return oren_err(4, "bytes_pack expects list<int 0..255> or LIST_INT") }
    var n = ptr_get(xs)
    var out = oren_u8_buf_new_uninit(n)
    if oren_is_err(out) { return out }
    var outp = native_buf_data_ptr(out)
    if outp == 0 && n != 0 { return oren_err(8, "bytes_pack: alloc failed") }
    var rc = native_bytes_copy_span(xs, 0, n, outp)
    if oren_is_err(rc) { return rc }
    return out
}

fn oren_bool_norm(x) {
    // Native backend values are untagged; treat "bool" as numeric != 0.
    // This matches the value-level meaning we want for `bool` annotations.
    return x != 0
}

fn oren_ptr_alloc(bytes) {
    // Portable name for allocating a raw byte region for ABI/FFI struct layouts.
    // In the native backend, `malloc` is syscall-first and GC-tracked.
    return malloc(bytes)
}

fn oren_ptr_free(ptr) {
    free(ptr)
    return 0
}
