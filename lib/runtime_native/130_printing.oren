// --- Printing ---
fn print_int_no_nl(n) {
    var buf = malloc(32)
    if buf == 0 { exit(300) }
    var i = 0
    var neg = 0
    if n < 0 {
        neg = 1
        n = -n
    }
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        while n > 0 {
            var digit = n - (n / 10) * 10
            ptr_set_byte(buf + i, 48 + digit)
            i = i + 1
            n = n / 10
        }
        if neg == 1 {
            ptr_set_byte(buf + i, 45)
            i = i + 1
        }
        // reverse
        var s = 0
        var e = i - 1
        while s < e {
            var t = ptr_get_byte(buf + s)
            ptr_set_byte(buf + s, ptr_get_byte(buf + e))
            ptr_set_byte(buf + e, t)
            s = s + 1
            e = e - 1
        }
    }
    sys_write(1, buf, i)
    return 0
}

fn print_int(n) {
    print_int_no_nl(n)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn oren_print_any_no_nl(val) {
    var node = oren_find_node(val)
    if node != 0 {
        var kind = ptr_get(node + 16)
        if kind == 1 { // STRING
            var len = oren_string_len(val)
            sys_write(1, val, len)
            return 0
        }
    }
    print_int_no_nl(val)
    return 0
}

fn oren_print_fmt(fmt, args) {
    // fmt is string ptr, args is list ptr
    var len = oren_string_len(fmt)
    var i = 0
    var arg_idx = 0
    var arg_count = 0
    if args != 0 { arg_count = oren_list_len(args) }
    
    while i < len {
        var c = ptr_get_byte(fmt + i)
        if c == 123 { // '{'
            if i + 1 < len {
                if ptr_get_byte(fmt + i + 1) == 125 { // '}'
                    if arg_idx < arg_count {
                        var val = oren_list_get(args, arg_idx)
                        oren_print_any_no_nl(val)
                        arg_idx = arg_idx + 1
                    } else {
                        // Print {}
                        sys_write(1, fmt + i, 2)
                    }
                    i = i + 2
                } else {
                    sys_write(1, fmt + i, 1)
                    i = i + 1
                }
            } else {
                sys_write(1, fmt + i, 1)
                i = i + 1
            }
        } else {
            sys_write(1, fmt + i, 1)
            i = i + 1
        }
    }
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn print_bytes(ptr, len) {
    sys_write(1, ptr, len)
}

fn oren_print(v) {
    oren_print_any_no_nl(v)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn oren_print_list(args_list) {
    // Print list elements separated by spaces and trailing newline.
    if args_list == 0 {
        var nl = malloc(1)
        ptr_set_byte(nl, 10)
        sys_write(1, nl, 1)
        return 0
    }
    var n = oren_list_len(args_list)
    var i = 0
    while i < n {
        var v = oren_list_get(args_list, i)
        oren_print_any_no_nl(v)
        if i < n - 1 {
            var sp = malloc(1)
            ptr_set_byte(sp, 32)
            sys_write(1, sp, 1)
        }
        i = i + 1
    }
    var nl2 = malloc(1)
    ptr_set_byte(nl2, 10)
    sys_write(1, nl2, 1)
    return 0
}

fn oren_print_fmt_list(fmt, args_list) { return oren_print_fmt(fmt, args_list) }

fn oren_print_spread(fixed_args, spread_list) {
    var args = oren_new_list(0)
    if fixed_args != 0 {
        var n0 = oren_list_len(fixed_args)
        var i0 = 0
        while i0 < n0 {
            oren_list_push(args, oren_list_get(fixed_args, i0))
            i0 = i0 + 1
        }
    }
    if spread_list != 0 {
        var n1 = oren_list_len(spread_list)
        var i1 = 0
        while i1 < n1 {
            oren_list_push(args, oren_list_get(spread_list, i1))
            i1 = i1 + 1
        }
    }
    return oren_print_list(args)
}

fn oren_print_fmt_spread(fmt, fixed_args, spread_list) {
    var args = oren_new_list(0)
    if fixed_args != 0 {
        var n0 = oren_list_len(fixed_args)
        var i0 = 0
        while i0 < n0 {
            oren_list_push(args, oren_list_get(fixed_args, i0))
            i0 = i0 + 1
        }
    }
    if spread_list != 0 {
        var n1 = oren_list_len(spread_list)
        var i1 = 0
        while i1 < n1 {
            oren_list_push(args, oren_list_get(spread_list, i1))
            i1 = i1 + 1
        }
    }
    return oren_print_fmt(fmt, args)
}

fn oren_call_obj_spread(fn_obj, fixed_args, spread_list) {
    var args = oren_new_list(0)
    if fixed_args != 0 {
        var n0 = oren_list_len(fixed_args)
        var i0 = 0
        while i0 < n0 {
            oren_list_push(args, oren_list_get(fixed_args, i0))
            i0 = i0 + 1
        }
    }
    if spread_list != 0 {
        var n1 = oren_list_len(spread_list)
        var i1 = 0
        while i1 < n1 {
            oren_list_push(args, oren_list_get(spread_list, i1))
            i1 = i1 + 1
        }
    }
    return oren_call_obj_list(fn_obj, args)
}

fn list_magic() { return 1279870019 } // 'LIST'
fn map_magic() { return 1296121168 } // 'MAP\0' (rolling; used only for type discrimination in native runtime)

fn oren_new_map(cap) {
    // Map header layout mirrors list layout for safety and future growth:
    //   [count][cap][entries_ptr][magic][dirty_sort]
    // Where entries_ptr points to an array of entries:
    //   [key][key_kind][value]  (24 bytes each, 8-byte aligned)
    //
    // Rationale:
    // - The previous v0 layout stored entries inline after the header and attempted to
    //   "grow" by mutating cap without resizing the allocation. That caused OOB writes
    //   for maps created with cap=0 (e.g. `{}`) and corrupted the allocator metadata.
    // - By using an indirection (entries_ptr) we can grow like lists, without needing
    //   to update every reference to the map pointer.
    if cap < 0 { cap = 0 }
    if cap > 0 && cap < 4 { cap = 4 }

    // Header layout (40 bytes):
    // - count      @ +0
    // - cap        @ +8
    // - entries ptr@ +16
    // - magic      @ +24
    // - dirty_sort @ +32  (0=sorted, 1=needs sort for deterministic iteration)
    var header = malloc(40)
    if header == 0 { exit(1) }
    if header == -1 { exit(1) }
    oren_track_alloc(header, 40, 0)

    var buf = 0
    // Map entry layout (24 bytes, 8-byte aligned):
    //   [0]  key
    //   [8]  key_kind (0=int, 1=string)
    //   [16] value
    //
    // This allows the native runtime to support int-keyed maps used by the compiler
    // (e.g. `type_scopes: {0: {...}}`) without relying on unsafe `strcmp` on integers.
    if cap > 0 {
        buf = malloc(cap * 24)
        if buf == 0 { exit(1) }
        if buf == -1 { exit(1) }
        oren_track_alloc(buf, cap * 24, 0)
    }

    ptr_set(header + 0, 0)       // count
    ptr_set(header + 8, cap)     // cap
    ptr_set(header + 16, buf)    // entries_ptr
    ptr_set(header + 24, map_magic())
    ptr_set(header + 32, 0)      // dirty_sort

    // Mark map header kind for GC traversal (kind=3 => MAP).
    var node = oren_find_node(header)
    if node != 0 { ptr_set(iadd(node, 16), 3) }
    return header
}

fn _oren_map_check(m) {
    if m == 0 { oren_panic("map op on nil") }
    if m < 4096 { oren_panic("map op on non-pointer") }
    if ptr_get(m + 24) != map_magic() { oren_panic("map op on non-map") }
    return 0
}

fn _oren_assert_string_ptr(k) {
    // Native v0 uses raw integers for non-pointer values, so we MUST NOT call `strcmp`
    // on arbitrary integers.
    //
    // Strings can be:
    // - tracked heap strings (created by runtime helpers, GC-visible)
    // - untracked constant C strings emitted by the native backend
    if k == 0 { oren_panic("map: string key is nil") }
    if k < 4096 { oren_panic("map: string key is not a pointer") }
    var node = oren_find_node(k)
    if node != 0 {
        if ptr_get(iadd(node, 16)) != 1 { oren_panic("map: key is not a string") }
    }
    return 0
}

fn _oren_map_set_kind(m, k, v, k_kind) {
    _oren_map_check(m)

    if k_kind != 0 && k_kind != 1 { oren_panic("map_set: invalid key kind") }
    if k_kind == 1 {
        // String keys must be valid C strings (non-nil pointer).
        _oren_assert_string_ptr(k)
    }

    var count = ptr_get(m + 0)
    var cap = ptr_get(m + 8)
    if count < 0 { count = 0; ptr_set(m + 0, 0) }
    if cap < 0 { cap = 0; ptr_set(m + 8, 0) }

    var buf = ptr_get(m + 16)
    if buf == 0 && cap > 0 { oren_panic("map_set: buf missing") }
    if cap == 0 && buf != 0 { oren_panic("map_set: cap/buf mismatch") }

    // Update existing entry if key already present.
    var i = 0
    while i < count {
        var off = i * 24
        var ek = ptr_get(buf + off + 0)
        var ek_kind = ptr_get(buf + off + 8)
        if ek_kind == k_kind {
            if k_kind == 0 {
                if ek == k {
                    ptr_set(buf + off + 16, v)
                    return v
                }
            } else {
                if strcmp(ek, k) == 0 {
                    ptr_set(buf + off + 16, v)
                    return v
                }
            }
        }
        i = i + 1
    }

    // Grow if needed (like lists).
    if count >= cap {
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        var new_buf = malloc(new_cap * 24)
        if new_buf == 0 { oren_panic("map_set: out of memory") }
        if new_buf == -1 { oren_panic("map_set: out of memory") }
        oren_track_alloc(new_buf, new_cap * 24, 0)
        var ci = 0
        while ci < count {
            var from = buf + ci * 24
            var to = new_buf + ci * 24
            ptr_set(to + 0, ptr_get(from + 0))   // key
            ptr_set(to + 8, ptr_get(from + 8))   // key_kind
            ptr_set(to + 16, ptr_get(from + 16)) // value
            ci = ci + 1
        }
        buf = new_buf
        cap = new_cap
        ptr_set(m + 8, cap)
        ptr_set(m + 16, buf)
    }

    // Append new entry (O(1)) and mark dirty; we sort lazily on iteration.
    // This avoids O(n^2) insertion behavior for large maps while keeping deterministic iteration.
    var offn = count * 24
    ptr_set(buf + offn + 0, k)
    ptr_set(buf + offn + 8, k_kind)
    ptr_set(buf + offn + 16, v)
    ptr_set(m + 0, count + 1)
    ptr_set(m + 32, 1)
    return v
}

fn oren_map_set_int(m, k, v) {
    return _oren_map_set_kind(m, k, v, 0)
}

fn oren_map_set_str(m, k, v) {
    return _oren_map_set_kind(m, k, v, 1)
}

fn oren_map_set(m, k, v) {
    // Default API: string-keyed maps.
    //
    // Int-keyed maps must call `oren_map_set_int` explicitly.
    _oren_assert_string_ptr(k)
    return _oren_map_set_kind(m, k, v, 1)
}

fn map_cmp_keys(a_kind, a_key, b_kind, b_key) {
    if a_kind == b_kind {
        if a_kind == 0 {
            if a_key < b_key { return -1 }
            if a_key > b_key { return 1 }
            return 0
        }
        return strcmp(a_key, b_key)
    }
    // int keys first
    if a_kind == 0 { return -1 }
    return 1
}

fn map_swap_entry(buf, i, j) {
    if i == j { return 0 }
    var offi = i * 24
    var offj = j * 24

    var ki = ptr_get(buf + offi + 0)
    var ki_kind = ptr_get(buf + offi + 8)
    var vi = ptr_get(buf + offi + 16)

    ptr_set(buf + offi + 0, ptr_get(buf + offj + 0))
    ptr_set(buf + offi + 8, ptr_get(buf + offj + 8))
    ptr_set(buf + offi + 16, ptr_get(buf + offj + 16))

    ptr_set(buf + offj + 0, ki)
    ptr_set(buf + offj + 8, ki_kind)
    ptr_set(buf + offj + 16, vi)
    return 0
}

fn map_entry_cmp_to_pivot(buf, idx, pk, pk_kind) {
    var off = idx * 24
    var ek = ptr_get(buf + off + 0)
    var ek_kind = ptr_get(buf + off + 8)
    return map_cmp_keys(ek_kind, ek, pk_kind, pk)
}

fn map_qsort_entries(buf, lo, hi) {
    if lo >= hi { return 0 }
    var mid = lo + (hi - lo) / 2
    var offp = mid * 24
    var pk = ptr_get(buf + offp + 0)
    var pk_kind = ptr_get(buf + offp + 8)

    var i = lo
    var j = hi
    while i <= j {
        while true {
            if map_entry_cmp_to_pivot(buf, i, pk, pk_kind) < 0 {
                i = i + 1
            } else {
                break
            }
        }
        while true {
            if map_entry_cmp_to_pivot(buf, j, pk, pk_kind) > 0 {
                j = j - 1
            } else {
                break
            }
        }
        if i <= j {
            map_swap_entry(buf, i, j)
            i = i + 1
            j = j - 1
        }
    }
    if lo < j { map_qsort_entries(buf, lo, j) }
    if i < hi { map_qsort_entries(buf, i, hi) }
    return 0
}

fn oren_map_ensure_sorted(m) {
    if m == 0 { return 0 }
    if ptr_get(m + 24) != map_magic() { return 0 }
    if ptr_get(m + 32) == 0 { return 0 }
    var count = ptr_get(m + 0)
    if count <= 1 {
        ptr_set(m + 32, 0)
        return 0
    }
    var buf = ptr_get(m + 16)
    map_qsort_entries(buf, 0, count - 1)
    ptr_set(m + 32, 0)
    return 0
}

fn _oren_map_get_kind(m, k, k_kind) {
    if m == 0 { return 0 }
    if ptr_get(m + 24) != map_magic() { return 0 }

    if k_kind != 0 && k_kind != 1 { oren_panic("map_get: invalid key kind") }
    if k_kind == 1 {
        if k == 0 { return 0 }
        _oren_assert_string_ptr(k)
    }

    var count = ptr_get(m + 0)
    var buf = ptr_get(m + 16)
    var i = 0
    while i < count {
        var off = i * 24
        var kp = ptr_get(buf + off + 0)
        var kp_kind = ptr_get(buf + off + 8)
        if kp_kind == k_kind {
            if k_kind == 0 {
                if kp == k { return ptr_get(buf + off + 16) }
            } else {
                if strcmp(kp, k) == 0 { return ptr_get(buf + off + 16) }
            }
        }
        i = i + 1
    }
    return 0
}

fn oren_map_get_int(m, k) {
    return _oren_map_get_kind(m, k, 0)
}

fn oren_map_get_str(m, k) {
    return _oren_map_get_kind(m, k, 1)
}

fn oren_map_get(m, k) {
    // Default API: string-keyed maps.
    //
    // Int-keyed maps must call `oren_map_get_int` explicitly.
    if k == 0 { return 0 }
    _oren_assert_string_ptr(k)
    return _oren_map_get_kind(m, k, 1)
}

fn oren_map_len(m) {
    if m == 0 { return 0 }
    if ptr_get(m + 24) != map_magic() { return 0 }
    return ptr_get(m + 0)
}

fn oren_map_key_at(m, idx) {
    if m == 0 { return 0 }
    if ptr_get(m + 24) != map_magic() { return 0 }
    oren_map_ensure_sorted(m)
    var count = ptr_get(m + 0)
    if idx < 0 { return 0 }
    if idx >= count { return 0 }
    var buf = ptr_get(m + 16)
    return ptr_get(buf + idx * 24)
}
