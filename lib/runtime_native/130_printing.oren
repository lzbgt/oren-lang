// --- Printing ---
fn print_int_no_nl(n) {
    var buf = malloc(32)
    if buf == 0 { exit(300) }
    var i = 0
    var neg = 0
    if n < 0 {
        neg = 1
        n = -n
    }
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        while n > 0 {
            var digit = n - (n / 10) * 10
            ptr_set_byte(buf + i, 48 + digit)
            i = i + 1
            n = n / 10
        }
        if neg == 1 {
            ptr_set_byte(buf + i, 45)
            i = i + 1
        }
        // reverse
        var s = 0
        var e = i - 1
        while s < e {
            var t = ptr_get_byte(buf + s)
            ptr_set_byte(buf + s, ptr_get_byte(buf + e))
            ptr_set_byte(buf + e, t)
            s = s + 1
            e = e - 1
        }
    }
    sys_write(1, buf, i)
    return 0
}

fn print_int(n) {
    print_int_no_nl(n)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn oren_print_any_no_nl(val) {
    var node = oren_find_node(val)
    if node != 0 {
        var kind = ptr_get(node + 16)
        if kind == 1 { // STRING
            var len = oren_string_len(val)
            sys_write(1, val, len)
            return 0
        }
    }
    print_int_no_nl(val)
    return 0
}

@oren.keep
fn oren_print_fmt(fmt, args) {
    // fmt is string ptr, args is list ptr
    var len = oren_string_len(fmt)
    var i = 0
    var arg_idx = 0
    var arg_count = 0
    if args != 0 { arg_count = oren_list_len(args) }
    
    while i < len {
        var c = ptr_get_byte(fmt + i)
        if c == 123 { // '{'
            if i + 1 < len {
                if ptr_get_byte(fmt + i + 1) == 125 { // '}'
                    if arg_idx < arg_count {
                        var val = oren_list_get(args, arg_idx)
                        oren_print_any_no_nl(val)
                        arg_idx = arg_idx + 1
                    } else {
                        // Print {}
                        sys_write(1, fmt + i, 2)
                    }
                    i = i + 2
                } else {
                    sys_write(1, fmt + i, 1)
                    i = i + 1
                }
            } else {
                sys_write(1, fmt + i, 1)
                i = i + 1
            }
        } else {
            sys_write(1, fmt + i, 1)
            i = i + 1
        }
    }
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

fn print_bytes(ptr, len) {
    sys_write(1, ptr, len)
}

@oren.keep
fn oren_print(v) {
    oren_print_any_no_nl(v)
    var nl = malloc(1)
    ptr_set_byte(nl, 10)
    sys_write(1, nl, 1)
    return 0
}

@oren.keep
fn oren_print_list(args_list) {
    // Print list elements separated by spaces and trailing newline.
    if args_list == 0 {
        var nl = malloc(1)
        ptr_set_byte(nl, 10)
        sys_write(1, nl, 1)
        return 0
    }
    var n = oren_list_len(args_list)
    var i = 0
    while i < n {
        var v = oren_list_get(args_list, i)
        oren_print_any_no_nl(v)
        if i < n - 1 {
            var sp = malloc(1)
            ptr_set_byte(sp, 32)
            sys_write(1, sp, 1)
        }
        i = i + 1
    }
    var nl2 = malloc(1)
    ptr_set_byte(nl2, 10)
    sys_write(1, nl2, 1)
    return 0
}

fn oren_print_fmt_list(fmt, args_list) { return oren_print_fmt(fmt, args_list) }

@oren.keep
fn oren_print_spread(fixed_args, spread_list) {
    var args = oren_new_list(0)
    if fixed_args != 0 {
        var n0 = oren_list_len(fixed_args)
        var i0 = 0
        while i0 < n0 {
            oren_list_push(args, oren_list_get(fixed_args, i0))
            i0 = i0 + 1
        }
    }
    if spread_list != 0 {
        var n1 = oren_list_len(spread_list)
        var i1 = 0
        while i1 < n1 {
            oren_list_push(args, oren_list_get(spread_list, i1))
            i1 = i1 + 1
        }
    }
    return oren_print_list(args)
}

@oren.keep
fn oren_print_fmt_spread(fmt, fixed_args, spread_list) {
    var args = oren_new_list(0)
    if fixed_args != 0 {
        var n0 = oren_list_len(fixed_args)
        var i0 = 0
        while i0 < n0 {
            oren_list_push(args, oren_list_get(fixed_args, i0))
            i0 = i0 + 1
        }
    }
    if spread_list != 0 {
        var n1 = oren_list_len(spread_list)
        var i1 = 0
        while i1 < n1 {
            oren_list_push(args, oren_list_get(spread_list, i1))
            i1 = i1 + 1
        }
    }
    return oren_print_fmt(fmt, args)
}

@oren.keep
fn oren_call_obj_spread(fn_obj, fixed_args, spread_list) {
    var args = oren_new_list(0)
    if fixed_args != 0 {
        var n0 = oren_list_len(fixed_args)
        var i0 = 0
        while i0 < n0 {
            oren_list_push(args, oren_list_get(fixed_args, i0))
            i0 = i0 + 1
        }
    }
    if spread_list != 0 {
        var n1 = oren_list_len(spread_list)
        var i1 = 0
        while i1 < n1 {
            oren_list_push(args, oren_list_get(spread_list, i1))
            i1 = i1 + 1
        }
    }
    return oren_call_obj_list(fn_obj, args)
}

fn list_magic() { return 1279870019 } // 'LIST'
fn map_magic() { return 1296121168 } // 'MAP\0' (rolling; used only for type discrimination in native runtime)

// --- Native map fast index (Tier‑1 perf/correctness) ---
//
// The self-hosted compiler uses maps pervasively (interning, symbol tables, AST metadata).
// A linear-scan `map_get`/`map_set` makes parsing large sources O(n^2) and can hang stage2-native.
//
// For native runtime, maintain an open-addressing hash index that maps key->entry index.
// We still keep the entries array for deterministic iteration (sorted on demand).
//
// Hash slot encoding (u64):
// - 0: empty
// - 1: tombstone
// - >=2: entry_index + 2
fn _map_hash_empty() { return 0 }
fn _map_hash_tomb() { return 1 }

// IMPORTANT (compiler self-hosting perf):
// Most compiler-internal maps are tiny (AST nodes: {"type": "...", ...}).
// Allocating and clearing a hash table for every such map dominates runtime.
//
// Below this entry count, we use linear scans and keep `hash_ptr/hash_cap` at 0.
// When a map grows beyond this threshold, we build and maintain a hash index.
fn _map_hash_threshold_entries() { return 32 }

fn _map_hash_int(k) {
    // 64-bit multiplicative hash (Knuth).
    return k * 11400714819323198485
}

fn _map_hash_str(s) {
    // FNV-1a 64-bit over NUL-terminated bytes.
    var h = 1469598103934665603
    var i = 0
    while 1 {
        var b = ptr_get_byte(iadd(s, i)) & 255
        if b == 0 { break }
        h = (h ^ b) * 1099511628211
        i = iadd(i, 1)
    }
    return h
}

fn _map_hash_key(k, k_kind) {
    if k_kind == 0 { return _map_hash_int(k) }
    return _map_hash_str(k)
}

fn _map_hash_cap_for_entries(n_entries) {
    // Keep load factor <= ~0.75.
    var need = n_entries * 2
    if need < 8 { need = 8 }
    var cap = 8
    while cap < need { cap = cap * 2 }
    return cap
}

fn _map_hash_clear(tab, cap) {
    if tab == 0 { return 0 }
    var i = 0
    while i < cap {
        ptr_set(iadd(tab, i << 3), 0)
        i = iadd(i, 1)
    }
    return 0
}

fn _map_hash_init_or_resize(m, want_entries) {
    var want_cap = _map_hash_cap_for_entries(want_entries)
    var tab = ptr_get(iadd(m, 40))
    var cap = ptr_get(iadd(m, 48))
    if tab == 0 || cap == 0 || cap < want_cap {
        tab = malloc_k(want_cap * 8, 0)
        if tab == 0 { oren_panic("map: hash alloc failed") }
        if tab == -1 { oren_panic("map: hash alloc failed") }
        ptr_set(iadd(m, 40), tab)
        ptr_set(iadd(m, 48), want_cap)
        cap = want_cap
    }
    _map_hash_clear(tab, cap)
    return 0
}

fn _map_hash_rebuild_for(m, want_entries) {
    var count = ptr_get(iadd(m, 0))
    var buf = ptr_get(iadd(m, 16))
    var n_entries = count
    if want_entries != nil && want_entries > n_entries { n_entries = want_entries }

    // Do not allocate hash tables for tiny maps (compiler AST nodes).
    if n_entries < _map_hash_threshold_entries() {
        // Keep hash_ptr/hash_cap at 0 and rely on linear scans.
        ptr_set(iadd(m, 40), 0)
        ptr_set(iadd(m, 48), 0)
        return 0
    }
    if n_entries <= 0 || buf == 0 {
        // Ensure a minimal table exists once we cross the threshold.
        _map_hash_init_or_resize(m, 0)
        return 0
    }

    _map_hash_init_or_resize(m, n_entries)
    var tab = ptr_get(iadd(m, 40))
    var cap = ptr_get(iadd(m, 48))
    var mask = cap - 1

    var ei = 0
    while ei < count {
        var base = iadd(buf, ei * 24)
        var k = ptr_get(iadd(base, 0))
        var k_kind = ptr_get(iadd(base, 8))

        var h = _map_hash_key(k, k_kind)
        var idx = h & mask
        var first_tomb = -1
        var rem = cap
        while 1 {
            if rem <= 0 { oren_panic("map: hash rebuild probe exhausted") }
            rem = rem - 1
            var slot = ptr_get(iadd(tab, idx << 3))
            if slot == _map_hash_empty() {
                if first_tomb >= 0 { idx = first_tomb }
                ptr_set(iadd(tab, idx << 3), iadd(ei, 2))
                break
            }
            if slot == _map_hash_tomb() {
                if first_tomb < 0 { first_tomb = idx }
            }
            idx = iadd(idx, 1) & mask
        }

        ei = iadd(ei, 1)
    }
    return 0
}

fn _map_hash_rebuild(m) { return _map_hash_rebuild_for(m, nil) }

// Debug/interop helper: return runtime type tag compatible with the C backend enum values.
// This is best-effort for native mode: ints/bools share the same immediate representation.
@oren.keep
fn oren_type_tag(v) {
    // Mirror lib/runtime.h OrenType enum values:
    //   0 nil, 1 int, 2 float, 3 bool, 4 string, 5 py_obj, 6 list, 7 map, 8 func,
    //   9..13 typed buffers.
    if v == 0 { return 0 } // nil (native uses 0)
    if oren_is_string(v) == true { return 4 }
    if oren_is_list(v) == true { return 6 }
    if oren_is_map(v) == true { return 7 }
    if oren_is_buf(v) == true {
        // typed buffer tags follow the C enum ordering (u8=9, i32=10, i64=11, f32=12, f64=13)
        if oren_is_u8_buf(v) == true { return 9 }
        // Best-effort: unknown buffer kind.
        return 9
    }
    // Best-effort: treat all other immediates as ints.
    return 1
}

// Debug/interop helper: stable string name for the runtime type tag.
// Intended for logging and basic reflection in user code (e.g. varargs dispatch).
//
// Note: native backend tagging is still rolling; this reflects the best-effort tag returned by
// `oren_type_tag` (ints/bools/floats may all report "int" today).
@oren.keep
fn oren_type_name(v) {
    var t = oren_type_tag(v)
    if t == 0 { return "nil" }
    if t == 1 { return "int" }
    if t == 2 { return "float" }
    if t == 3 { return "bool" }
    if t == 4 { return "string" }
    if t == 5 { return "py_obj" }
    if t == 6 { return "list" }
    if t == 7 { return "map" }
    if t == 8 { return "func" }
    if t == 9 { return "u8_buf" }
    if t == 10 { return "i32_buf" }
    if t == 11 { return "i64_buf" }
    if t == 12 { return "f32_buf" }
    if t == 13 { return "f64_buf" }
    return "unknown"
}

// Safe type predicate: must not panic.
@oren.keep
fn oren_is_map(v) {
    if v == 0 { return false }
    var node = oren_find_node(v)
    if node == 0 { return false }
    if ptr_get(iadd(node, 16)) != 3 { return false }
    if ptr_get(iadd(v, 24)) != map_magic() { return false }
    return true
}

			@oren.keep
			fn oren_new_map(cap) {
    // Map header layout mirrors list layout for safety and future growth:
    //   [count][cap][entries_ptr][magic][dirty_sort]
    // Where entries_ptr points to an array of entries:
    //   [key][key_kind][value]  (24 bytes each, 8-byte aligned)
    //
    // Rationale:
    // - The previous v0 layout stored entries inline after the header and attempted to
    //   "grow" by mutating cap without resizing the allocation. That caused OOB writes
    //   for maps created with cap=0 (e.g. `{}`) and corrupted the allocator metadata.
    // - By using an indirection (entries_ptr) we can grow like lists, without needing
    //   to update every reference to the map pointer.
    if cap < 0 { cap = 0 }
    if cap > 0 && cap < 4 { cap = 4 }

    // Header layout (56 bytes):
    // - count      @ +0
    // - cap        @ +8
    // - entries ptr@ +16
    // - magic      @ +24
    // - dirty_sort @ +32  (0=sorted, 1=needs sort for deterministic iteration)
    // - hash_ptr   @ +40  (u64 ptr to slot table; 0 means uninitialized)
    // - hash_cap   @ +48  (u64 number of slots; 0 means uninitialized)
    // Performance (native tooling / stage2-native compiler):
    // Allocate header + initial entries buffer in a single tracked block to reduce the
    // allocation+tracking count for the common "many tiny maps" workload (AST nodes).
    //
    // We still keep an `entries_ptr` indirection so growth can switch to an out-of-line buffer.
    var total = 56
    if cap > 0 { total = total + cap * 24 }
    var header = malloc_k(total, 3)
    if header == 0 { exit(1) }
    if header == -1 { exit(1) }

    var buf = 0
    // Map entry layout (24 bytes, 8-byte aligned):
    //   [0]  key
    //   [8]  key_kind (0=int, 1=string)
    //   [16] value
    //
    // This allows the native runtime to support int-keyed maps used by the compiler
    // (e.g. `type_scopes: {0: {...}}`) without relying on unsafe `strcmp` on integers.
    if cap > 0 {
        buf = iadd(header, 56)
    }

    ptr_set(iadd(header, 0), 0)       // count
    ptr_set(iadd(header, 8), cap)     // cap
    ptr_set(iadd(header, 16), buf)    // entries_ptr
    ptr_set(iadd(header, 24), map_magic())
    ptr_set(iadd(header, 32), 0)      // dirty_sort
    ptr_set(iadd(header, 40), 0)      // hash_ptr
    ptr_set(iadd(header, 48), 0)      // hash_cap
	    return header
			}

// Cross-backend helper: allocate an empty map with reserved capacity.
// In native runtime, `oren_new_map(cap)` already has "capacity constructor" semantics.
@oren.keep
fn oren_map_new_cap(cap) {
    return oren_new_map(cap)
}

fn _oren_map_check(m) {
    if m == 0 { oren_panic("map op on nil") }
    // Safety: do not dereference arbitrary large integers as pointers.
    // Require a tracked heap object, then validate kind+magic.
    var node = oren_find_node(m)
    if node == 0 { oren_panic("map op on non-map") }
    if ptr_get(iadd(node, 16)) != 3 { oren_panic("map op on non-map") }
    if ptr_get(iadd(m, 24)) != map_magic() { oren_panic("map op on non-map") }
    return 0
}

// Map-only entry iteration: fill out_pair[0]=key out_pair[1]=value.
// Returns 1 if entry exists at idx, 0 otherwise.
@oren.keep
fn oren_iter_next_entry(m, idx, out_pair) {
    // Native runtime note:
    // In native v0, `nil` is represented as integer 0, so we must NOT treat `idx==0`
    // as "missing". Callers pass `idx=0` to access the first entry.
    if idx < 0 { return 0 }
    if out_pair == 0 { oren_panic("iter_next_entry expects out_pair list") }
    // out_pair must be a list with capacity >= 2.
    var node = oren_find_node(out_pair)
    if node == 0 { oren_panic("iter_next_entry expects out_pair list") }
    if ptr_get(iadd(node, 16)) != 2 { oren_panic("iter_next_entry expects out_pair list") }
    if ptr_get(out_pair + 24) != list_magic() { oren_panic("iter_next_entry expects out_pair list") }
    if ptr_get(out_pair + 8) < 2 { oren_panic("iter_next_entry expects out_pair cap>=2") }

    _oren_map_check(m)
    var count = ptr_get(iadd(m, 0))
    if idx < 0 || idx >= count { return 0 }
    var buf = ptr_get(iadd(m, 16))
    if buf == 0 { return 0 }

    var off = idx * 24
    var base = iadd(buf, off)
    var k = ptr_get(iadd(base, 0))
    var v = ptr_get(iadd(base, 16))

    // Ensure out_pair count>=2.
    if ptr_get(iadd(out_pair, 0)) < 2 { ptr_set(iadd(out_pair, 0), 2) }
    var obuf = ptr_get(iadd(out_pair, 16))
    ptr_set(iadd(obuf, 0), k)
    ptr_set(iadd(obuf, 8), v)
    return 1
}

fn _oren_assert_string_ptr(k) {
    // Native v0 uses raw integers for non-pointer values, so we MUST NOT call `strcmp`
    // on arbitrary integers.
    //
    // Contract (rolling):
    // - string values that flow through generic container ops are tracked heap strings (kind=1)
    // - embedded string literals are registered once at startup via `oren_init_static_cstr0_table`
    if k == 0 { oren_panic("map: string key is nil") }
    var node = oren_find_node(k)
    if node == 0 { oren_panic("map: string key is not tracked") }
    if ptr_get(iadd(node, 16)) != 1 { oren_panic("map: key is not a string") }
    return 0
}

fn _oren_map_set_kind(m, k, v, k_kind) {
    _oren_map_check(m)

    if k_kind != 0 && k_kind != 1 { oren_panic("map_set: invalid key kind") }
    if k_kind == 1 {
        // String keys must be valid C strings (non-nil pointer).
        _oren_assert_string_ptr(k)
    }

    var count = ptr_get(iadd(m, 0))
    var cap = ptr_get(iadd(m, 8))
    if count < 0 { count = 0; ptr_set(iadd(m, 0), 0) }
    if cap < 0 { cap = 0; ptr_set(iadd(m, 8), 0) }

    var buf = ptr_get(iadd(m, 16))
    if buf == 0 && cap > 0 { oren_panic("map_set: buf missing") }
    if cap == 0 && buf != 0 { oren_panic("map_set: cap/buf mismatch") }

    var want = iadd(count, 1)

    // For tiny maps, avoid allocating a hash table; do a linear scan/update/append.
    var tab = ptr_get(iadd(m, 40))
    var hcap = ptr_get(iadd(m, 48))
    if tab == 0 || hcap == 0 {
        if want < _map_hash_threshold_entries() {
            // Update if key exists.
            if count > 0 && buf != 0 {
                var si = 0
                while si < count {
                    var base0 = iadd(buf, si * 24)
                    var ek0 = ptr_get(iadd(base0, 0))
                    var ek_kind0 = ptr_get(iadd(base0, 8))
                    if ek_kind0 == k_kind {
                        if k_kind == 0 {
                            if ek0 == k {
                                ptr_set(iadd(base0, 16), v)
                                return v
                            }
                        } else {
                            if strcmp(ek0, k) == 0 {
                                ptr_set(iadd(base0, 16), v)
                                return v
                            }
                        }
                    }
                    si = iadd(si, 1)
                }
            }

            // Grow if needed (like lists).
            if count >= cap {
                var new_cap0 = cap * 2
                if new_cap0 < 4 { new_cap0 = 4 }
                var new_buf0 = malloc_k(new_cap0 * 24, 0)
                if new_buf0 == 0 { oren_panic("map_set: out of memory") }
                if new_buf0 == -1 { oren_panic("map_set: out of memory") }
                var ci0 = 0
                while ci0 < count {
                    var from0 = iadd(buf, ci0 * 24)
                    var to0 = iadd(new_buf0, ci0 * 24)
                    ptr_set(iadd(to0, 0), ptr_get(iadd(from0, 0)))
                    ptr_set(iadd(to0, 8), ptr_get(iadd(from0, 8)))
                    ptr_set(iadd(to0, 16), ptr_get(iadd(from0, 16)))
                    ci0 = iadd(ci0, 1)
                }
                buf = new_buf0
                cap = new_cap0
                ptr_set(iadd(m, 8), cap)
                ptr_set(iadd(m, 16), buf)
            }

            // Append new entry.
            var offn0 = count * 24
            var base2_0 = iadd(buf, offn0)
            ptr_set(iadd(base2_0, 0), k)
            ptr_set(iadd(base2_0, 8), k_kind)
            ptr_set(iadd(base2_0, 16), v)
            ptr_set(iadd(m, 0), iadd(count, 1))
            ptr_set(iadd(m, 32), 1)
            return v
        }

        // Crossed threshold: build hash index and continue in hashed mode.
        _map_hash_rebuild_for(m, want)
        tab = ptr_get(iadd(m, 40))
        hcap = ptr_get(iadd(m, 48))
    } else {
        // Resize when load factor exceeds ~0.75.
        if want * 4 >= hcap * 3 {
            _map_hash_rebuild_for(m, want)
            tab = ptr_get(iadd(m, 40))
            hcap = ptr_get(iadd(m, 48))
        }
    }

    // Hash mode: probe via hash index for update/insert.
    if tab == 0 || hcap == 0 { oren_panic("map_set: missing hash table") }
    var mask = hcap - 1
    var idx = _map_hash_key(k, k_kind) & mask
    var first_tomb = -1
    var rem = hcap
    while 1 {
        if rem <= 0 { oren_panic("map_set: hash probe exhausted") }
        rem = rem - 1
        var slot = ptr_get(iadd(tab, idx << 3))
        if slot == _map_hash_empty() { break }
        if slot == _map_hash_tomb() {
            if first_tomb < 0 { first_tomb = idx }
        } else {
            var ei = slot - 2
            if ei >= 0 && ei < count {
                var base = iadd(buf, ei * 24)
                var ek = ptr_get(iadd(base, 0))
                var ek_kind = ptr_get(iadd(base, 8))
                if ek_kind == k_kind {
                    if k_kind == 0 {
                        if ek == k {
                            ptr_set(iadd(base, 16), v)
                            return v
                        }
                    } else {
                        if strcmp(ek, k) == 0 {
                            ptr_set(iadd(base, 16), v)
                            return v
                        }
                    }
                }
            } else {
                // Stale index (should not happen): rebuild once and retry.
                _map_hash_rebuild_for(m, want)
                return _oren_map_set_kind(m, k, v, k_kind)
            }
        }
        idx = iadd(idx, 1) & mask
    }

    // Grow if needed (like lists).
    if count >= cap {
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        var new_buf = malloc_k(new_cap * 24, 0)
        if new_buf == 0 { oren_panic("map_set: out of memory") }
        if new_buf == -1 { oren_panic("map_set: out of memory") }
        var ci = 0
        while ci < count {
            var from = iadd(buf, ci * 24)
            var to = iadd(new_buf, ci * 24)
            ptr_set(iadd(to, 0), ptr_get(iadd(from, 0)))   // key
            ptr_set(iadd(to, 8), ptr_get(iadd(from, 8)))   // key_kind
            ptr_set(iadd(to, 16), ptr_get(iadd(from, 16))) // value
            ci = iadd(ci, 1)
        }
        buf = new_buf
        cap = new_cap
        ptr_set(iadd(m, 8), cap)
        ptr_set(iadd(m, 16), buf)
    }

    // Append new entry (O(1)) and mark dirty; we sort lazily on iteration.
    // This avoids O(n^2) insertion behavior for large maps while keeping deterministic iteration.
    var offn = count * 24
    var base2 = iadd(buf, offn)
    ptr_set(iadd(base2, 0), k)
    ptr_set(iadd(base2, 8), k_kind)
    ptr_set(iadd(base2, 16), v)
    ptr_set(iadd(m, 0), iadd(count, 1))
    ptr_set(iadd(m, 32), 1)

    // Insert into hash index (idx currently points at an empty slot).
    var ins = idx
    if first_tomb >= 0 { ins = first_tomb }
    ptr_set(iadd(tab, ins << 3), iadd(count, 2))
    return v
}

@oren.keep
fn oren_map_set_int(m, k, v) {
    return _oren_map_set_kind(m, k, v, 0)
}

@oren.keep
fn oren_map_set_str(m, k, v) {
    return _oren_map_set_kind(m, k, v, 1)
}

// Unsafe/fast-path (tooling/internal): assumes `m` is a valid map pointer and the key kind is correct.
// This avoids repeated `oren_find_node` checks in compiler hot paths (astbin decode, parsing).
fn _oren_map_set_kind_unchecked(m, k, v, k_kind) {
    // No `_oren_map_check` / `_oren_assert_string_ptr` here by design.
    if m == 0 { oren_panic("map_set_unchecked on nil"); return 0 }
    if k_kind != 0 && k_kind != 1 { oren_panic("map_set_unchecked: invalid key kind"); return 0 }

    var count = ptr_get(iadd(m, 0))
    var cap = ptr_get(iadd(m, 8))
    if count < 0 { count = 0; ptr_set(iadd(m, 0), 0) }
    if cap < 0 { cap = 0; ptr_set(iadd(m, 8), 0) }

    var buf = ptr_get(iadd(m, 16))
    if buf == 0 && cap > 0 { oren_panic("map_set_unchecked: buf missing"); return 0 }
    if cap == 0 && buf != 0 { oren_panic("map_set_unchecked: cap/buf mismatch"); return 0 }

    var want = iadd(count, 1)

    // Tiny maps: linear scan/update/append.
    var tab = ptr_get(iadd(m, 40))
    var hcap = ptr_get(iadd(m, 48))
    if tab == 0 || hcap == 0 {
        if want < _map_hash_threshold_entries() {
            if count > 0 && buf != 0 {
                var si = 0
                while si < count {
                    var base0 = iadd(buf, si * 24)
                    var ek0 = ptr_get(iadd(base0, 0))
                    var ek_kind0 = ptr_get(iadd(base0, 8))
                    if ek_kind0 == k_kind {
                        if k_kind == 0 {
                            if ek0 == k { ptr_set(iadd(base0, 16), v); return v }
                        } else {
                            if strcmp(ek0, k) == 0 { ptr_set(iadd(base0, 16), v); return v }
                        }
                    }
                    si = iadd(si, 1)
                }
            }

            if count >= cap {
                var new_cap0 = cap * 2
                if new_cap0 < 4 { new_cap0 = 4 }
                var new_buf0 = malloc_k(new_cap0 * 24, 0)
                if new_buf0 == 0 { oren_panic("map_set_unchecked: out of memory"); return 0 }
                if new_buf0 == -1 { oren_panic("map_set_unchecked: out of memory"); return 0 }
                var ci0 = 0
                while ci0 < count {
                    var from0 = iadd(buf, ci0 * 24)
                    var to0 = iadd(new_buf0, ci0 * 24)
                    ptr_set(iadd(to0, 0), ptr_get(iadd(from0, 0)))
                    ptr_set(iadd(to0, 8), ptr_get(iadd(from0, 8)))
                    ptr_set(iadd(to0, 16), ptr_get(iadd(from0, 16)))
                    ci0 = iadd(ci0, 1)
                }
                buf = new_buf0
                cap = new_cap0
                ptr_set(iadd(m, 8), cap)
                ptr_set(iadd(m, 16), buf)
            }

            var offn0 = count * 24
            var base2_0 = iadd(buf, offn0)
            ptr_set(iadd(base2_0, 0), k)
            ptr_set(iadd(base2_0, 8), k_kind)
            ptr_set(iadd(base2_0, 16), v)
            ptr_set(iadd(m, 0), iadd(count, 1))
            ptr_set(iadd(m, 32), 1)
            return v
        }

        // Crossed threshold: build hash index and continue in hashed mode.
        _map_hash_rebuild_for(m, want)
        tab = ptr_get(iadd(m, 40))
        hcap = ptr_get(iadd(m, 48))
    } else {
        if want * 4 >= hcap * 3 {
            _map_hash_rebuild_for(m, want)
            tab = ptr_get(iadd(m, 40))
            hcap = ptr_get(iadd(m, 48))
        }
    }

    if tab == 0 || hcap == 0 { oren_panic("map_set_unchecked: missing hash table"); return 0 }

    var mask = hcap - 1
    var idx = _map_hash_key(k, k_kind) & mask
    var first_tomb = -1
    var rem = hcap
    while 1 {
        if rem <= 0 { oren_panic("map_set_unchecked: hash probe exhausted"); return 0 }
        rem = rem - 1
        var slot = ptr_get(iadd(tab, idx << 3))
        if slot == _map_hash_empty() { break }
        if slot == _map_hash_tomb() {
            if first_tomb < 0 { first_tomb = idx }
        } else {
            var ei = slot - 2
            if ei >= 0 && ei < count {
                var base = iadd(buf, ei * 24)
                var ek = ptr_get(iadd(base, 0))
                var ek_kind = ptr_get(iadd(base, 8))
                if ek_kind == k_kind {
                    if k_kind == 0 {
                        if ek == k { ptr_set(iadd(base, 16), v); return v }
                    } else {
                        if strcmp(ek, k) == 0 { ptr_set(iadd(base, 16), v); return v }
                    }
                }
            } else {
                _map_hash_rebuild_for(m, want)
                return _oren_map_set_kind_unchecked(m, k, v, k_kind)
            }
        }
        idx = iadd(idx, 1) & mask
    }

    if count >= cap {
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        var new_buf = malloc_k(new_cap * 24, 0)
        if new_buf == 0 { oren_panic("map_set_unchecked: out of memory"); return 0 }
        if new_buf == -1 { oren_panic("map_set_unchecked: out of memory"); return 0 }
        var ci = 0
        while ci < count {
            var from = iadd(buf, ci * 24)
            var to = iadd(new_buf, ci * 24)
            ptr_set(iadd(to, 0), ptr_get(iadd(from, 0)))
            ptr_set(iadd(to, 8), ptr_get(iadd(from, 8)))
            ptr_set(iadd(to, 16), ptr_get(iadd(from, 16)))
            ci = iadd(ci, 1)
        }
        buf = new_buf
        cap = new_cap
        ptr_set(iadd(m, 8), cap)
        ptr_set(iadd(m, 16), buf)
    }

    var offn = count * 24
    var base2 = iadd(buf, offn)
    ptr_set(iadd(base2, 0), k)
    ptr_set(iadd(base2, 8), k_kind)
    ptr_set(iadd(base2, 16), v)
    ptr_set(iadd(m, 0), iadd(count, 1))
    ptr_set(iadd(m, 32), 1)

    var ins = idx
    if first_tomb >= 0 { ins = first_tomb }
    ptr_set(iadd(tab, ins << 3), iadd(count, 2))
    return v
}

@oren.keep
fn oren_map_set_int_unchecked(m, k, v) {
    return _oren_map_set_kind_unchecked(m, k, v, 0)
}

@oren.keep
fn oren_map_set_str_unchecked(m, k, v) {
    return _oren_map_set_kind_unchecked(m, k, v, 1)
}

// Unsafe builder fast-path (tooling/internal):
// Append a new entry without doing a duplicate-key lookup.
//
// Intended for astbin decode where:
// - the map was created via `oren_map_new_cap(n)` (so cap is sufficient)
// - keys are known-unique for the serialized representation
//
// This avoids O(n^2) behavior from repeated linear scans on tiny maps.
@oren.keep
fn oren_map_push_entry_int_unchecked(m, k, v) {
    if m == 0 { oren_panic("map_push_entry_int_unchecked on nil"); return v }
    var count = ptr_get(iadd(m, 0))
    var cap = ptr_get(iadd(m, 8))
    if count < 0 { count = 0; ptr_set(iadd(m, 0), 0) }
    if cap < 0 { cap = 0; ptr_set(iadd(m, 8), 0) }
    if count >= cap { oren_panic("map_push_entry_int_unchecked: capacity exceeded"); return v }
    var buf = ptr_get(iadd(m, 16))
    if buf == 0 && cap > 0 { oren_panic("map_push_entry_int_unchecked: buf missing"); return v }
    var base = iadd(buf, count * 24)
    ptr_set(iadd(base, 0), k)
    ptr_set(iadd(base, 8), 0)
    ptr_set(iadd(base, 16), v)
    ptr_set(iadd(m, 0), iadd(count, 1))
    ptr_set(iadd(m, 32), 1) // dirty_sort
    return v
}

@oren.keep
fn oren_map_push_entry_str_unchecked(m, k, v) {
    if m == 0 { oren_panic("map_push_entry_str_unchecked on nil"); return v }
    var count = ptr_get(iadd(m, 0))
    var cap = ptr_get(iadd(m, 8))
    if count < 0 { count = 0; ptr_set(iadd(m, 0), 0) }
    if cap < 0 { cap = 0; ptr_set(iadd(m, 8), 0) }
    if count >= cap { oren_panic("map_push_entry_str_unchecked: capacity exceeded"); return v }
    var buf = ptr_get(iadd(m, 16))
    if buf == 0 && cap > 0 { oren_panic("map_push_entry_str_unchecked: buf missing"); return v }
    var base = iadd(buf, count * 24)
    ptr_set(iadd(base, 0), k)
    ptr_set(iadd(base, 8), 1)
    ptr_set(iadd(base, 16), v)
    ptr_set(iadd(m, 0), iadd(count, 1))
    ptr_set(iadd(m, 32), 1) // dirty_sort
    return v
}

// Finalize after bulk appends (native backend builds hash index if needed).
@oren.keep
fn oren_map_build_finalize_unchecked(m, want_entries) {
    if m == 0 { return 0 }
    _map_hash_rebuild_for(m, want_entries)
    return m
}

@oren.keep
fn oren_map_set(m, k, v) {
    // Rolling v0 map key kind inference (native runtime):
    // - ints are raw and untracked
    // - strings are tracked heap strings (kind=1)
    var node = oren_find_node(k)
    if node == 0 { return _oren_map_set_kind(m, k, v, 0) }
    var kind = ptr_get(iadd(node, 16))
    if kind == 1 { return _oren_map_set_kind(m, k, v, 1) }
    oren_panic("map_set: unsupported key type (need int or string)")
    return 0
}

fn map_cmp_keys(a_kind, a_key, b_kind, b_key) {
    if a_kind == b_kind {
        if a_kind == 0 {
            if a_key < b_key { return -1 }
            if a_key > b_key { return 1 }
            return 0
        }
        return strcmp(a_key, b_key)
    }
    // int keys first
    if a_kind == 0 { return -1 }
    return 1
}

fn map_swap_entry(buf, i, j) {
    if i == j { return 0 }
    var offi = i * 24
    var offj = j * 24

    var ki = ptr_get(buf + offi + 0)
    var ki_kind = ptr_get(buf + offi + 8)
    var vi = ptr_get(buf + offi + 16)

    ptr_set(buf + offi + 0, ptr_get(buf + offj + 0))
    ptr_set(buf + offi + 8, ptr_get(buf + offj + 8))
    ptr_set(buf + offi + 16, ptr_get(buf + offj + 16))

    ptr_set(buf + offj + 0, ki)
    ptr_set(buf + offj + 8, ki_kind)
    ptr_set(buf + offj + 16, vi)
    return 0
}

fn map_entry_cmp_to_pivot(buf, idx, pk, pk_kind) {
    var off = idx * 24
    var ek = ptr_get(buf + off + 0)
    var ek_kind = ptr_get(buf + off + 8)
    return map_cmp_keys(ek_kind, ek, pk_kind, pk)
}

fn map_qsort_entries(buf, lo, hi) {
    if lo >= hi { return 0 }
    var mid = lo + (hi - lo) / 2
    var offp = mid * 24
    var pk = ptr_get(buf + offp + 0)
    var pk_kind = ptr_get(buf + offp + 8)

    var i = lo
    var j = hi
    while i <= j {
        while true {
            if map_entry_cmp_to_pivot(buf, i, pk, pk_kind) < 0 {
                i = i + 1
            } else {
                break
            }
        }
        while true {
            if map_entry_cmp_to_pivot(buf, j, pk, pk_kind) > 0 {
                j = j - 1
            } else {
                break
            }
        }
        if i <= j {
            map_swap_entry(buf, i, j)
            i = i + 1
            j = j - 1
        }
    }
    if lo < j { map_qsort_entries(buf, lo, j) }
    if i < hi { map_qsort_entries(buf, i, hi) }
    return 0
}

fn oren_map_ensure_sorted(m) {
    if m == 0 { return 0 }
    var node = oren_find_node(m)
    if node == 0 { return 0 }
    if ptr_get(iadd(node, 16)) != 3 { return 0 }
    if ptr_get(iadd(m, 24)) != map_magic() { return 0 }
    if ptr_get(iadd(m, 32)) == 0 { return 0 }
    var count = ptr_get(iadd(m, 0))
    if count <= 1 {
        ptr_set(iadd(m, 32), 0)
        return 0
    }
    var buf = ptr_get(iadd(m, 16))
    map_qsort_entries(buf, 0, count - 1)
    ptr_set(iadd(m, 32), 0)
    // Sorting changes entry order, so the hash index (entry_index -> slot) must be rebuilt.
    _map_hash_rebuild(m)
    return 0
}

fn _oren_map_get_kind(m, k, k_kind) {
    if m == 0 { return 0 }
    var node = oren_find_node(m)
    if node == 0 { return 0 }
    if ptr_get(iadd(node, 16)) != 3 { return 0 }
    if ptr_get(iadd(m, 24)) != map_magic() { return 0 }

    if k_kind != 0 && k_kind != 1 { oren_panic("map_get: invalid key kind") }
    if k_kind == 1 {
        if k == 0 { return 0 }
        _oren_assert_string_ptr(k)
    }

    var count = ptr_get(iadd(m, 0))
    var buf = ptr_get(iadd(m, 16))

    // Tiny maps: linear scan is faster than maintaining a hash table (AST nodes).
    if count <= 0 || buf == 0 { return 0 }
    var tab = ptr_get(iadd(m, 40))
    var cap = ptr_get(iadd(m, 48))
    if tab == 0 || cap == 0 {
        var i0 = 0
        while i0 < count {
            var off0 = i0 * 24
            var base0 = iadd(buf, off0)
            var kp0 = ptr_get(iadd(base0, 0))
            var kp0_kind = ptr_get(iadd(base0, 8))
            if kp0_kind == k_kind {
                if k_kind == 0 {
                    if kp0 == k { return ptr_get(iadd(base0, 16)) }
                } else {
                    if strcmp(kp0, k) == 0 { return ptr_get(iadd(base0, 16)) }
                }
            }
            i0 = iadd(i0, 1)
        }
        return 0
    }

    // Hash mode: O(1) average lookups.
    var mask = cap - 1
    var idx = _map_hash_key(k, k_kind) & mask
    var rem = cap
    while 1 {
        if rem <= 0 { break }
        rem = rem - 1
        var slot = ptr_get(iadd(tab, idx << 3))
        if slot == _map_hash_empty() { return 0 }
        if slot != _map_hash_tomb() {
            var ei = slot - 2
            if ei >= 0 && ei < count {
                var base = iadd(buf, ei * 24)
                var kp = ptr_get(iadd(base, 0))
                var kp_kind = ptr_get(iadd(base, 8))
                if kp_kind == k_kind {
                    if k_kind == 0 {
                        if kp == k { return ptr_get(iadd(base, 16)) }
                    } else {
                        if strcmp(kp, k) == 0 { return ptr_get(iadd(base, 16)) }
                    }
                }
            } else {
                // Stale index (should not happen): rebuild once and retry.
                _map_hash_rebuild(m)
                return _oren_map_get_kind(m, k, k_kind)
            }
        }
        idx = iadd(idx, 1) & mask
    }

    // Fallback: linear scan (should only happen for very small maps or during bringup).
    var i = 0
    while i < count {
        var off = i * 24
        var base2 = iadd(buf, off)
        var kp2 = ptr_get(iadd(base2, 0))
        var kp2_kind = ptr_get(iadd(base2, 8))
        if kp2_kind == k_kind {
            if k_kind == 0 {
                if kp2 == k { return ptr_get(iadd(base2, 16)) }
            } else {
                if strcmp(kp2, k) == 0 { return ptr_get(iadd(base2, 16)) }
            }
        }
        i = iadd(i, 1)
    }
    return 0
}

@oren.keep
fn oren_map_get_int(m, k) {
    return _oren_map_get_kind(m, k, 0)
}

@oren.keep
fn oren_map_get_str(m, k) {
    return _oren_map_get_kind(m, k, 1)
}

@oren.keep
fn oren_map_get(m, k) {
    // Rolling v0 map key kind inference (native runtime):
    // - ints are raw and untracked
    // - strings are tracked heap strings (kind=1)
    var node = oren_find_node(k)
    if node == 0 { return _oren_map_get_kind(m, k, 0) }
    var kind = ptr_get(iadd(node, 16))
    if kind == 1 { return _oren_map_get_kind(m, k, 1) }
    oren_panic("map_get: unsupported key type (need int or string)")
    return 0
}

fn oren_map_len(m) {
    if m == 0 { return 0 }
    var node = oren_find_node(m)
    if node == 0 { return 0 }
    if ptr_get(iadd(node, 16)) != 3 { return 0 }
    if ptr_get(iadd(m, 24)) != map_magic() { return 0 }
    return ptr_get(iadd(m, 0))
}

fn oren_map_key_at(m, idx) {
    if m == 0 { return 0 }
    var node = oren_find_node(m)
    if node == 0 { return 0 }
    if ptr_get(iadd(node, 16)) != 3 { return 0 }
    if ptr_get(iadd(m, 24)) != map_magic() { return 0 }
    oren_map_ensure_sorted(m)
    var count = ptr_get(iadd(m, 0))
    if idx < 0 { return 0 }
    if idx >= count { return 0 }
    var buf = ptr_get(iadd(m, 16))
    return ptr_get(iadd(buf, idx * 24))
}
