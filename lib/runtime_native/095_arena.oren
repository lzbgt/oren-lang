// --- Arena allocation (native runtime; rolling) ---
//
// Purpose: fast, resettable allocation for loop-local objects to reduce GC overhead.
// This is a best-effort primitive; callers must ensure arena lifetimes do not escape.

// Arena state (single arena shared across the process).
var g_arena_depth = 0
var g_arena_ptr = 0
var g_arena_limit = 0
var g_arena_base = 0
var g_arena_bytes_used = 0
var g_arena_bytes_cap = 0
var g_arena_inited = 0
var g_arena_auto_enabled = 1
var g_arena_auto_inited = 0
var g_arena_iter_cap_inited = 0
var g_arena_iter_bytes_cap = 0

// Arena tracing (optional; enable via OREN_TRACE_ARENA=1).
var g_arena_trace_enabled = 0
var g_arena_alloc_count = 0
var g_arena_alloc_bytes = 0
var g_arena_spill_count = 0
var g_arena_spill_bytes = 0
var g_arena_push_count = 0
var g_arena_pop_count = 0
var g_arena_epoch_reset_count = 0
var g_arena_mmap_fail_count = 0
var g_arena_iter_active = 0
var g_arena_iter_push_count = 0
var g_arena_iter_pop_count = 0
var g_arena_iter_spill_count = 0
var g_arena_iter_spill_bytes = 0

// Arena stack (per-depth checkpoints for ptr/limit/base/bytes_used).
var g_arena_stack_ptr = 0
var g_arena_stack_cap = 0

// Arena tracking table stack (per-depth hash tables).
var g_arena_table_stack_ptr = 0
var g_arena_table_stack_cap = 0

fn native_arena_chunk_size() { return 1048576 } // 1 MiB (rolling)

fn native_env_is_falsey(ptr) {
    if ptr == 0 { return 0 }
    var b0 = ptr_get_byte(ptr)
    if b0 == 0 { return 1 }
    if b0 == 48 { // "0"
        if ptr_get_byte(iadd(ptr, 1)) == 0 { return 1 }
        return 0
    }
    if b0 == 102 || b0 == 70 { // "false"
        var b1 = ptr_get_byte(iadd(ptr, 1))
        var b2 = ptr_get_byte(iadd(ptr, 2))
        var b3 = ptr_get_byte(iadd(ptr, 3))
        var b4 = ptr_get_byte(iadd(ptr, 4))
        if (b1 == 97 || b1 == 65) &&
           (b2 == 108 || b2 == 76) &&
           (b3 == 115 || b3 == 83) &&
           (b4 == 101 || b4 == 69) &&
           ptr_get_byte(iadd(ptr, 5)) == 0 {
            return 1
        }
        return 0
    }
    if b0 == 111 || b0 == 79 { // "off"
        var b1 = ptr_get_byte(iadd(ptr, 1))
        var b2 = ptr_get_byte(iadd(ptr, 2))
        if (b1 == 102 || b1 == 70) &&
           (b2 == 102 || b2 == 70) &&
           ptr_get_byte(iadd(ptr, 3)) == 0 {
            return 1
        }
        return 0
    }
    return 0
}

fn native_arena_auto_enabled() {
    if g_arena_auto_inited == 0 {
        g_arena_auto_enabled = 1
        var v = native_envp_get_value_ptr("OREN_ARENA_AUTO_LOOP")
        if v != 0 {
            if native_env_is_falsey(v) != 0 { g_arena_auto_enabled = 0 }
        }
        g_arena_auto_inited = 1
    }
    return g_arena_auto_enabled
}

fn native_arena_align16(n) {
    var out = n
    var rem = out % 16
    if rem != 0 { out = iadd(out, 16 - rem) }
    return out
}

fn native_arena_stack_entry_bytes() { return 48 }
fn native_arena_table_stack_entry_bytes() { return 32 }

fn native_arena_stack_ensure(depth) {
    if depth <= 0 { return 0 }
    if g_arena_stack_cap >= depth { return 0 }
    var cap = g_arena_stack_cap
    if cap <= 0 { cap = 8 }
    while cap < depth { cap = cap * 2 }
    var entry = native_arena_stack_entry_bytes()
    var bytes = cap * entry
    var new_ptr = native_malloc_raw_or_mmap(bytes)
    if new_ptr == 0 { return 0 }
    var i = 0
    while i < cap {
        var off = i * entry
        ptr_set(iadd(new_ptr, off), 0)
        ptr_set(iadd(new_ptr, off + 8), 0)
        ptr_set(iadd(new_ptr, off + 16), 0)
        ptr_set(iadd(new_ptr, off + 24), 0)
        ptr_set(iadd(new_ptr, off + 32), 0)
        ptr_set(iadd(new_ptr, off + 40), 0)
        i = i + 1
    }
    if g_arena_stack_ptr != 0 {
        var j = 0
        while j < g_arena_stack_cap {
            var offj = j * entry
            ptr_set(iadd(new_ptr, offj), ptr_get(iadd(g_arena_stack_ptr, offj)))
            ptr_set(iadd(new_ptr, offj + 8), ptr_get(iadd(g_arena_stack_ptr, offj + 8)))
            ptr_set(iadd(new_ptr, offj + 16), ptr_get(iadd(g_arena_stack_ptr, offj + 16)))
            ptr_set(iadd(new_ptr, offj + 24), ptr_get(iadd(g_arena_stack_ptr, offj + 24)))
            ptr_set(iadd(new_ptr, offj + 32), ptr_get(iadd(g_arena_stack_ptr, offj + 32)))
            ptr_set(iadd(new_ptr, offj + 40), ptr_get(iadd(g_arena_stack_ptr, offj + 40)))
            j = j + 1
        }
    }
    g_arena_stack_ptr = new_ptr
    g_arena_stack_cap = cap
    return 0
}

fn native_arena_stack_save(depth) {
    if g_arena_stack_ptr == 0 { return 0 }
    var off = (depth - 1) * native_arena_stack_entry_bytes()
    ptr_set(iadd(g_arena_stack_ptr, off), g_arena_ptr)
    ptr_set(iadd(g_arena_stack_ptr, off + 8), g_arena_limit)
    ptr_set(iadd(g_arena_stack_ptr, off + 16), g_arena_base)
    ptr_set(iadd(g_arena_stack_ptr, off + 24), g_arena_bytes_used)
    ptr_set(iadd(g_arena_stack_ptr, off + 32), g_arena_bytes_cap)
    ptr_set(iadd(g_arena_stack_ptr, off + 40), g_arena_iter_active)
    return 0
}

fn native_arena_stack_restore(depth) {
    if g_arena_stack_ptr == 0 { return 0 }
    var off = (depth - 1) * native_arena_stack_entry_bytes()
    g_arena_ptr = ptr_get(iadd(g_arena_stack_ptr, off))
    g_arena_limit = ptr_get(iadd(g_arena_stack_ptr, off + 8))
    g_arena_base = ptr_get(iadd(g_arena_stack_ptr, off + 16))
    g_arena_bytes_used = ptr_get(iadd(g_arena_stack_ptr, off + 24))
    g_arena_bytes_cap = ptr_get(iadd(g_arena_stack_ptr, off + 32))
    g_arena_iter_active = ptr_get(iadd(g_arena_stack_ptr, off + 40))
    return 0
}

fn native_arena_table_stack_ensure(depth) {
    if depth <= 0 { return 0 }
    if g_arena_table_stack_cap >= depth { return 0 }
    var cap = g_arena_table_stack_cap
    if cap <= 0 { cap = 8 }
    while cap < depth { cap = cap * 2 }
    var bytes = cap * native_arena_table_stack_entry_bytes()
    var new_ptr = native_malloc_raw_or_mmap(bytes)
    if new_ptr == 0 { return 0 }
    var i = 0
    while i < cap {
        var off = i * 32
        ptr_set(iadd(new_ptr, off), 0)
        ptr_set(iadd(new_ptr, off + 8), 0)
        ptr_set(iadd(new_ptr, off + 16), 0)
        ptr_set(iadd(new_ptr, off + 24), 0)
        i = i + 1
    }
    if g_arena_table_stack_ptr != 0 {
        var j = 0
        while j < g_arena_table_stack_cap {
            var offj = j * 32
            ptr_set(iadd(new_ptr, offj), ptr_get(iadd(g_arena_table_stack_ptr, offj)))
            ptr_set(iadd(new_ptr, offj + 8), ptr_get(iadd(g_arena_table_stack_ptr, offj + 8)))
            ptr_set(iadd(new_ptr, offj + 16), ptr_get(iadd(g_arena_table_stack_ptr, offj + 16)))
            ptr_set(iadd(new_ptr, offj + 24), ptr_get(iadd(g_arena_table_stack_ptr, offj + 24)))
            j = j + 1
        }
    }
    g_arena_table_stack_ptr = new_ptr
    g_arena_table_stack_cap = cap
    return 0
}

fn native_arena_table_slot_ptr(depth) {
    if depth <= 0 { return 0 }
    if g_arena_table_stack_ptr == 0 { return 0 }
    return iadd(g_arena_table_stack_ptr, (depth - 1) * 32)
}

fn native_arena_init_once() {
    if g_arena_inited != 0 { return 0 }
    g_arena_inited = 1
    g_arena_bytes_cap = 0
    var v_cap = native_envp_get_value_ptr("OREN_ARENA_CAP_BYTES")
    if v_cap != 0 {
        var cap = native_parse_i64_dec_cstr_or_neg1(v_cap)
        if cap > 0 { g_arena_bytes_cap = cap }
    }
    return 0
}

fn native_arena_iter_cap() {
    if g_arena_iter_cap_inited == 0 {
        g_arena_iter_cap_inited = 1
        g_arena_iter_bytes_cap = 0
        var v_cap = native_envp_get_value_ptr("OREN_ARENA_ITER_CAP_BYTES")
        if v_cap != 0 {
            var cap = native_parse_i64_dec_cstr_or_neg1(v_cap)
            if cap > 0 { g_arena_iter_bytes_cap = cap }
        }
    }
    return g_arena_iter_bytes_cap
}

fn native_arena_trace_enable() {
    g_arena_trace_enabled = 1
    return 0
}

fn native_arena_trace_dump_and_reset() {
    if g_arena_trace_enabled == 0 { return 0 }
    print("[arena] allocs=" + oren_int_to_string(g_arena_alloc_count) +
        " alloc_bytes=" + oren_int_to_string(g_arena_alloc_bytes) +
        " spills=" + oren_int_to_string(g_arena_spill_count) +
        " spill_bytes=" + oren_int_to_string(g_arena_spill_bytes) +
        " push=" + oren_int_to_string(g_arena_push_count) +
        " pop=" + oren_int_to_string(g_arena_pop_count) +
        " iter_push=" + oren_int_to_string(g_arena_iter_push_count) +
        " iter_pop=" + oren_int_to_string(g_arena_iter_pop_count) +
        " iter_spills=" + oren_int_to_string(g_arena_iter_spill_count) +
        " iter_spill_bytes=" + oren_int_to_string(g_arena_iter_spill_bytes) +
        " epoch_reset=" + oren_int_to_string(g_arena_epoch_reset_count) +
        " mmap_fail=" + oren_int_to_string(g_arena_mmap_fail_count))
    g_arena_alloc_count = 0
    g_arena_alloc_bytes = 0
    g_arena_spill_count = 0
    g_arena_spill_bytes = 0
    g_arena_push_count = 0
    g_arena_pop_count = 0
    g_arena_iter_push_count = 0
    g_arena_iter_pop_count = 0
    g_arena_iter_spill_count = 0
    g_arena_iter_spill_bytes = 0
    g_arena_epoch_reset_count = 0
    g_arena_mmap_fail_count = 0
    return 0
}

fn native_arena_alloc_raw(size) {
    if g_arena_depth <= 0 { return 0 }
    if size <= 0 { return 0 }
    if g_arena_inited == 0 { native_arena_init_once() }
    var want = native_arena_align16(size)
    if g_arena_bytes_cap > 0 {
        var next = g_arena_bytes_used + want
        if next > g_arena_bytes_cap {
            if g_arena_trace_enabled != 0 {
                g_arena_spill_count = g_arena_spill_count + 1
                g_arena_spill_bytes = g_arena_spill_bytes + want
                if g_arena_iter_active != 0 {
                    g_arena_iter_spill_count = g_arena_iter_spill_count + 1
                    g_arena_iter_spill_bytes = g_arena_iter_spill_bytes + want
                }
            }
            return 0
        }
    }
    var cur = g_arena_ptr
    var lim = g_arena_limit
    if cur == 0 || iadd(cur, want) > lim {
        var chunk = native_arena_chunk_size()
        if want > chunk { chunk = want }
        var base = sys_mmap_private_anon(chunk)
        if base == 0 {
            if g_arena_trace_enabled != 0 { g_arena_mmap_fail_count = g_arena_mmap_fail_count + 1 }
            return 0
        }
        if base == -1 {
            if g_arena_trace_enabled != 0 { g_arena_mmap_fail_count = g_arena_mmap_fail_count + 1 }
            return 0
        }
        if native_is_neg_i64(base) == true {
            if g_arena_trace_enabled != 0 { g_arena_mmap_fail_count = g_arena_mmap_fail_count + 1 }
            return 0
        }
        if base < 4096 {
            if g_arena_trace_enabled != 0 { g_arena_mmap_fail_count = g_arena_mmap_fail_count + 1 }
            return 0
        }
        g_arena_base = base
        g_arena_ptr = iadd(base, want)
        g_arena_limit = iadd(base, chunk)
        g_arena_bytes_used = g_arena_bytes_used + want
        if g_arena_trace_enabled != 0 {
            g_arena_alloc_count = g_arena_alloc_count + 1
            g_arena_alloc_bytes = g_arena_alloc_bytes + want
        }
        return base
    }
    g_arena_ptr = iadd(cur, want)
    g_arena_bytes_used = g_arena_bytes_used + want
    if g_arena_trace_enabled != 0 {
        g_arena_alloc_count = g_arena_alloc_count + 1
        g_arena_alloc_bytes = g_arena_alloc_bytes + want
    }
    return cur
}

fn native_arena_table_clear_depth(depth) {
    var slot = native_arena_table_slot_ptr(depth)
    if slot == 0 { return 0 }
    var table = ptr_get(slot)
    if table == 0 { return 0 }
    ptr_set(iadd(slot, 16), 0)
    var gen = ptr_get(iadd(slot, 24))
    gen = gen + 1
    if gen <= 0 {
        gen = 1
        var cap = ptr_get(iadd(slot, 8))
        var i = 0
        while i < cap {
            var off = i * 16
            ptr_set(iadd(table, off), 0)
            ptr_set(iadd(table, off + 8), 0)
            i = i + 1
        }
    }
    ptr_set(iadd(slot, 24), gen)
    return 0
}

fn native_arena_table_init_depth(depth, min_cap) {
    var slot = native_arena_table_slot_ptr(depth)
    if slot == 0 { return 0 }
    var cap = ptr_get(iadd(slot, 8))
    if cap != 0 { return 0 }
    cap = 1024
    if min_cap != nil && min_cap > cap {
        while cap < min_cap { cap = cap * 2 }
    }
    if cap > 1048576 { cap = 1048576 }
    var bytes = cap * 16
    var table = native_malloc_raw_or_mmap(bytes)
    if table == 0 { return 0 }
    ptr_set(slot, table)
    ptr_set(iadd(slot, 8), cap)
    ptr_set(iadd(slot, 16), 0)
    ptr_set(iadd(slot, 24), 1)
    var i = 0
    while i < cap {
        var off = i * 16
        ptr_set(iadd(table, off), 0)
        ptr_set(iadd(table, off + 8), 0)
        i = i + 1
    }
    return 0
}

fn native_arena_table_prepare_depth(depth) {
    var slot = native_arena_table_slot_ptr(depth)
    if slot == 0 { return 0 }
    var cap = ptr_get(iadd(slot, 8))
    if cap == 0 {
        native_arena_table_init_depth(depth, 1024)
        return 0
    }
    native_arena_table_clear_depth(depth)
    return 0
}

fn native_arena_table_grow_depth(depth) {
    var slot = native_arena_table_slot_ptr(depth)
    if slot == 0 { return 0 }
    var old_ptr = ptr_get(slot)
    var old_cap = ptr_get(iadd(slot, 8))
    if old_cap == 0 { return 0 }
    var gen = ptr_get(iadd(slot, 24))
    var new_cap = old_cap * 2
    if new_cap < 1024 { new_cap = 1024 }
    if new_cap > 1048576 { return 0 }
    var bytes = new_cap * 16
    var new_ptr = native_malloc_raw_or_mmap(bytes)
    if new_ptr == 0 { return 0 }
    var i = 0
    while i < new_cap {
        var off = i * 16
        ptr_set(iadd(new_ptr, off), 0)
        ptr_set(iadd(new_ptr, off + 8), 0)
        i = i + 1
    }
    ptr_set(slot, new_ptr)
    ptr_set(iadd(slot, 8), new_cap)
    ptr_set(iadd(slot, 16), 0)
    var j = 0
    while j < old_cap {
        var offj = j * 16
        var entry = ptr_get(iadd(old_ptr, offj))
        if entry != 0 {
            var entry_gen = ptr_get(iadd(old_ptr, offj + 8))
            if entry_gen == gen { native_arena_table_put_depth(entry, depth) }
        }
        j = j + 1
    }
    return 0
}

fn native_arena_table_put_depth(node, depth) {
    if depth <= 0 { return 0 }
    var slot = native_arena_table_slot_ptr(depth)
    if slot == 0 { return 0 }
    var cap = ptr_get(iadd(slot, 8))
    if cap == 0 {
        native_arena_table_init_depth(depth, 1024)
        cap = ptr_get(iadd(slot, 8))
    }
    if cap == 0 { return 0 }
    var len = ptr_get(iadd(slot, 16))
    if len * 4 >= cap * 3 {
        native_arena_table_grow_depth(depth)
        cap = ptr_get(iadd(slot, 8))
        len = ptr_get(iadd(slot, 16))
    }
    var table = ptr_get(slot)
    var gen = ptr_get(iadd(slot, 24))
    var p = ptr_get(node)
    if p == 0 { return 0 }
    var mask = cap - 1
    var idx = native_alloc_index_hash(p) & mask
    var rem = cap
    while true {
        if rem <= 0 { return 0 }
        rem = rem - 1
        var off = idx * 16
        var slot_entry = ptr_get(iadd(table, off))
        var slot_gen = 0
        if slot_entry != 0 { slot_gen = ptr_get(iadd(table, off + 8)) }
        if slot_entry == 0 || slot_gen != gen {
            ptr_set(iadd(table, off), node)
            ptr_set(iadd(table, off + 8), gen)
            ptr_set(iadd(slot, 16), len + 1)
            return 0
        }
        if ptr_get(slot_entry) == p {
            ptr_set(iadd(table, off), node)
            ptr_set(iadd(table, off + 8), gen)
            return 0
        }
        idx = iadd(idx, 1) & mask
    }
    return 0
}

fn native_arena_table_put(node) {
    return native_arena_table_put_depth(node, g_arena_depth)
}

fn native_arena_find_node_nolock(ptr) {
    if g_arena_depth <= 0 { return 0 }
    if ptr == 0 { return 0 }
    if ptr < 4096 { return 0 }
    var depth = g_arena_depth
    while depth > 0 {
        var slot = native_arena_table_slot_ptr(depth)
        if slot != 0 {
            var table = ptr_get(slot)
            var cap = ptr_get(iadd(slot, 8))
            if table != 0 && cap != 0 {
                var gen = ptr_get(iadd(slot, 24))
                var mask = cap - 1
                var idx = native_alloc_index_hash(ptr) & mask
                var rem = cap
                while true {
                    if rem <= 0 { break }
                    rem = rem - 1
                    var off = idx * 16
                    var entry = ptr_get(iadd(table, off))
                    if entry == 0 { break }
                    if ptr_get(iadd(table, off + 8)) != gen { break }
                    if ptr_get(entry) == ptr { return entry }
                    idx = iadd(idx, 1) & mask
                }
            }
        }
        depth = depth - 1
    }
    return 0
}

fn native_arena_track(ptr, size, kind) {
    if g_arena_depth <= 0 { return ptr }
    if ptr == 0 { return 0 }
    if ptr < 4096 { return ptr }
    var node = native_arena_alloc_raw(48)
    if node == 0 { return ptr }
    ptr_set(node, ptr)
    ptr_set(iadd(node, 8), size)
    ptr_set(iadd(node, 16), kind)
    ptr_set(iadd(node, 24), 0)
    ptr_set(iadd(node, 32), 0)
    ptr_set(iadd(node, 40), native_node_magic())
    native_arena_table_put(node)
    return ptr
}

fn native_arena_alloc_k(size, kind) {
    var p = native_arena_alloc_raw(size)
    if p != 0 {
        native_arena_track(p, size, kind)
        return p
    }
    return malloc_k(size, kind)
}

fn native_arena_push() {
    if g_arena_inited == 0 { native_arena_init_once() }
    var next = g_arena_depth + 1
    native_arena_stack_ensure(next)
    native_arena_table_stack_ensure(next)
    g_arena_depth = next
    native_arena_stack_save(next)
    native_arena_table_prepare_depth(next)
    if g_arena_trace_enabled != 0 { g_arena_push_count = g_arena_push_count + 1 }
    return 0
}

fn native_arena_iter_push() {
    native_arena_push()
    var cap = native_arena_iter_cap()
    if cap > 0 { g_arena_bytes_cap = cap }
    g_arena_iter_active = 1
    if g_arena_trace_enabled != 0 { g_arena_iter_push_count = g_arena_iter_push_count + 1 }
    return 0
}

fn native_arena_iter_pop() {
    if g_arena_trace_enabled != 0 { g_arena_iter_pop_count = g_arena_iter_pop_count + 1 }
    return native_arena_pop()
}

fn native_arena_pop() {
    if g_arena_depth <= 0 { return 0 }
    var depth = g_arena_depth
    g_arena_depth = depth - 1
    if g_arena_trace_enabled != 0 { g_arena_pop_count = g_arena_pop_count + 1 }
    native_find_cache_clear()
    if g_arena_stack_ptr != 0 {
        native_arena_stack_restore(depth)
    } else if g_arena_depth == 0 {
        if g_arena_base != 0 {
            g_arena_ptr = g_arena_base
        } else {
            g_arena_ptr = 0
            g_arena_limit = 0
        }
        g_arena_bytes_used = 0
    }
    native_arena_table_clear_depth(depth)
    if g_arena_trace_enabled != 0 {
        g_arena_epoch_reset_count = g_arena_epoch_reset_count + 1
        if g_arena_depth == 0 { native_arena_trace_dump_and_reset() }
    }
    return 0
}

@oren.keep
fn oren_arena_push() { return native_arena_push() }

@oren.keep
fn oren_arena_pop() { return native_arena_pop() }

@oren.keep
fn oren_arena_iter_push() { return native_arena_iter_push() }

@oren.keep
fn oren_arena_iter_pop() { return native_arena_iter_pop() }

fn native_arena_new_list(cap) {
    if cap < 0 { cap = 0 }
    var total = 32
    if cap > 0 { total = total + cap * 8 }
    var header = native_arena_alloc_k(total, 2)
    if header == 0 { exit(200) }
    if header == -1 { exit(200) }
    var site = _alloc_site_list_header()
    native_alloc_site_bump(site)
    var buf = 0
    if cap > 0 { buf = iadd(header, 32) }
    ptr_set(iadd(header, 0), 0)
    ptr_set(iadd(header, 8), cap)
    ptr_set(iadd(header, 16), buf)
    ptr_set(iadd(header, 24), list_magic())
    trace_list_alloc_emit(header, 2, total, site, 2)
    if trace_list_track_consume() != 0 {
        print("[list_track] arena_alloc ptr=" + oren_int_to_string(header) +
              " kind=2 size=" + oren_int_to_string(total))
    }
    return header
}

fn native_arena_new_list_int(cap) {
    if cap < 0 { cap = 0 }
    var total = 32
    if cap > 0 { total = total + cap * 8 }
    var header = native_arena_alloc_k(total, list_int_kind())
    if header == 0 { exit(200) }
    if header == -1 { exit(200) }
    var site = _alloc_site_list_int_header()
    native_alloc_site_bump(site)
    var buf = 0
    if cap > 0 { buf = iadd(header, 32) }
    ptr_set(iadd(header, 0), 0)
    ptr_set(iadd(header, 8), cap)
    ptr_set(iadd(header, 16), buf)
    ptr_set(iadd(header, 24), list_magic())
    trace_list_alloc_emit(header, list_int_kind(), total, site, 2)
    if trace_list_track_consume() != 0 {
        print("[list_track] arena_alloc ptr=" + oren_int_to_string(header) +
              " kind=" + oren_int_to_string(list_int_kind()) +
              " size=" + oren_int_to_string(total))
    }
    return header
}

@oren.keep
fn oren_arena_new_list(cap) {
    return native_arena_new_list(cap)
}

@oren.keep
fn oren_arena_new_list_int(cap) {
    return native_arena_new_list_int(cap)
}

@oren.keep
fn oren_arena_new_list_auto(cap) {
    if native_arena_auto_enabled() != 0 { return native_arena_new_list(cap) }
    return oren_new_list(cap)
}

@oren.keep
fn oren_arena_new_list_int_auto(cap) {
    if native_arena_auto_enabled() != 0 { return native_arena_new_list_int(cap) }
    return oren_new_list_int(cap)
}
