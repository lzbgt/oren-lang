fn native_capsule_require_proc_system() {
    // `oren_system(_timeout)` is considered a convenience API and is intentionally
    // blocked in capsule mode unless explicitly enabled (it executes a shell).
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }
    if global_get_proc_allow_system() == 1 { return 0 }
    print("CAPSULE DENY: PROC_SYSTEM")
    exit(81)
    return 0
}

fn native_capsule_require_proc_exec(path) {
    // Deny-by-default subprocess exec in capsule mode unless an explicit exec prefix allowlist is provided.
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }
    var prefs = global_get_proc_allow_exec_prefixes_ptr()
    if native_capsule_fs_path_allowed(path, prefs) { return 0 }
    print("CAPSULE DENY: PROC_EXEC")
    exit(80)
    return 0
}

fn native_capsule_proc_match_token(arg, tok_ptr, tok_len) {
    // Supports:
    // - "*" wildcard token (matches any string, including empty)
    // - "<prefix>*" suffix-wildcard token (matches any string starting with <prefix>)
    if tok_len == 1 {
        if ptr_get_byte(tok_ptr) == 42 { return true } // '*'
    }

    if arg == 0 { return false }

    // Prefix wildcard: "abc*" matches "abc", "abcd", "abcXYZ", ...
    // Rolling: we only support '*' as the last byte to keep the matcher simple and deterministic.
    if tok_len > 1 {
        if ptr_get_byte(tok_ptr + (tok_len - 1)) == 42 { // '*'
            var plen = tok_len - 1
            var i2 = 0
            while i2 < plen {
                var ac2 = ptr_get_byte(arg + i2)
                if ac2 == 0 { return false }
                if ac2 != ptr_get_byte(tok_ptr + i2) { return false }
                i2 = i2 + 1
                if i2 > 4096 { return false }
            }
            return true
        }
    }

    var i = 0
    while i < tok_len {
        var ac = ptr_get_byte(arg + i)
        if ac == 0 { return false }
        if ac != ptr_get_byte(tok_ptr + i) { return false }
        i = i + 1
        if i > 4096 { return false }
    }
    // Must end exactly here.
    if ptr_get_byte(arg + tok_len) != 0 { return false }
    return true
}

fn native_capsule_require_proc_argv(exec_path, argv_ptrs, argc) {
    // argv allowlist (capsule mode):
    // - Deny-by-default when PROC is enabled in capsule mode.
    // - Allowlist is configured via OREN_PROC_ALLOW_ARGV.
    //
    // Format:
    //   OREN_PROC_ALLOW_ARGV="<path>|<argv0>[|<arg1>...],<path>|...,..."
    //
    // Matching:
    // - First field must match exec_path exactly.
    // - Remaining fields match argv[0..] exactly.
    // - A trailing "*" token matches any remaining argv items (including none).
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }

    var allow = global_get_proc_allow_argv_ptr()
    if allow == 0 {
        print("CAPSULE DENY: PROC_ARGV (missing OREN_PROC_ALLOW_ARGV)")
        exit(82)
        return 0
    }
    if ptr_get_byte(allow) == 0 {
        print("CAPSULE DENY: PROC_ARGV (empty OREN_PROC_ALLOW_ARGV)")
        exit(82)
        return 0
    }

    var n = native_cstr_len(allow)
    var i = 0
    var start = 0
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(allow + i) }
        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var spec_start = start
            var spec_end = i
            while spec_start < spec_end && ptr_get_byte(allow + spec_start) == 32 { spec_start = spec_start + 1 }
            while spec_end > spec_start && ptr_get_byte(allow + spec_end - 1) == 32 { spec_end = spec_end - 1 }

            if spec_end > spec_start {
                // Parse exec_path token (up to first '|')
                var bar = -1
                var j = spec_start
                while j < spec_end {
                    if ptr_get_byte(allow + j) == 124 { bar = j; break } // '|'
                    j = j + 1
                }

                if bar != -1 {
                    var p0 = spec_start
                    var p1 = bar
                    while p0 < p1 && ptr_get_byte(allow + p0) == 32 { p0 = p0 + 1 }
                    while p1 > p0 && ptr_get_byte(allow + p1 - 1) == 32 { p1 = p1 - 1 }
                    var plen = p1 - p0
                    if plen > 0 {
                        // Compare exec_path
                        var match_path = native_capsule_proc_match_token(exec_path, allow + p0, plen)
                        if match_path {
                            // Parse argv tokens and compare.
                            var ok = true
                            var argi = 0
                            var tstart = bar + 1
                            var saw_trailing_star = false
                            while tstart <= spec_end {
                                var tend = tstart
                                while tend < spec_end && ptr_get_byte(allow + tend) != 124 { tend = tend + 1 }

                                // Trim token
                                var a0 = tstart
                                var a1 = tend
                                while a0 < a1 && ptr_get_byte(allow + a0) == 32 { a0 = a0 + 1 }
                                while a1 > a0 && ptr_get_byte(allow + a1 - 1) == 32 { a1 = a1 - 1 }
                                var alen = a1 - a0
                                if alen <= 0 { ok = false }
                                else {
                                    // Trailing "*" matches rest.
                                    if alen == 1 && ptr_get_byte(allow + a0) == 42 {
                                        // '*' token
                                        if tend == spec_end {
                                            saw_trailing_star = true
                                            break
                                        }
                                    }

                                    if argi >= argc { ok = false }
                                    else {
                                        var arg = ptr_get(argv_ptrs + (argi * 8))
                                        if native_capsule_proc_match_token(arg, allow + a0, alen) != true { ok = false }
                                    }
                                }

                                if ok != true { break }
                                argi = argi + 1
                                if tend == spec_end { break }
                                tstart = tend + 1
                            }

                            if ok {
                                if saw_trailing_star { return 0 }
                                if argi == argc { return 0 }
                            }
                        }
                    }
                }
            }

            start = i + 1
        }
        i = i + 1
    }

    print("CAPSULE DENY: PROC_ARGV")
    exit(82)
    return 0
}

fn native_capsule_proc_register_pid(pid) {
    // Register a child pid as "owned" by this process so capsule mode can allow
    // wait/kill only for those pids.
    if global_get_capsule_mode() != 1 { return 0 }
    if pid <= 0 { return 0 }
    var tab = global_get_proc_allowed_pids_ptr()
    if tab == 0 { return 0 }
    var cap = global_get_proc_allowed_pids_cap()
    if cap <= 0 { return 0 }
    var len = global_get_proc_allowed_pids_len()
    if len < 0 { len = 0 }

    // Already present?
    var i = 0
    while i < cap {
        var v = ptr_get(iadd(tab, i * 8))
        if v == pid { return 0 }
        i = i + 1
    }

    // Insert into first empty slot.
    i = 0
    while i < cap {
        if ptr_get(iadd(tab, i * 8)) == 0 {
            ptr_set(iadd(tab, i * 8), pid)
            global_set_proc_allowed_pids_len(len + 1)
            return 0
        }
        i = i + 1
    }
    return 0
}

fn native_capsule_proc_pid_allowed(pid) {
    if global_get_capsule_mode() != 1 { return true }
    if pid <= 0 { return false }
    var tab = global_get_proc_allowed_pids_ptr()
    if tab == 0 { return false }
    var cap = global_get_proc_allowed_pids_cap()
    if cap <= 0 { return false }
    var i = 0
    while i < cap {
        if ptr_get(iadd(tab, i * 8)) == pid { return true }
        i = i + 1
    }
    return false
}

fn native_argv_ptrs_count(argv_ptrs) {
    // Count argv pointers until NULL, capped.
    if argv_ptrs == 0 { return 0 }
    var i = 0
    while i < 4096 {
        var p = ptr_get(iadd(argv_ptrs, i * 8))
        if p == 0 { return i }
        i = i + 1
    }
    return -1
}

fn native_capsule_sys_getcwd_pre() {
    // Reading the host cwd leaks host FS state; require FS enrollment in capsule mode.
    native_capsule_require(CAP_FS, "FS")
    return 0
}

fn native_capsule_sys_clone_pre() {
    // clone is a process/thread creation primitive; require PROC enrollment in capsule mode.
    native_capsule_require(CAP_PROC, "PROC")
    return 0
}

fn native_capsule_sys_bsdthread_register_pre() {
    // bsdthread_register initializes the OS thread substrate; treat it as PROC-domain in capsule mode.
    native_capsule_require(CAP_PROC, "PROC")
    return 0
}

fn native_capsule_sys_fork_pre() {
    // PROC is required for fork in capsule mode.
    native_capsule_require(CAP_PROC, "PROC")
    return 0
}

fn native_capsule_sys_fork_post(pid) {
    // Register the returned pid so raw sys_wait4/sys_kill can operate on it in capsule mode.
    // This is required for syscall-first spawn/join (fork+pipe) to work under PROC-only enrollment.
    native_capsule_proc_register_pid(pid)
    return pid
}

fn native_capsule_sys_gettimeofday_pre(tv_ptr, tz_ptr, abs_ptr) {
    // Enforce TIME enrollment at raw sys_gettimeofday boundary (no bypass).
    native_capsule_require(CAP_TIME, "TIME")
    return 0
}

fn native_capsule_sys_nanosleep_pre(ns) {
    // Enforce TIME enrollment at raw sys_nanosleep boundary (no bypass).
    //
    // Optimization: ns<=0 is a no-op; allow it without TIME to avoid surprising callers.
    if ns <= 0 { return ns }
    native_capsule_require(CAP_TIME, "TIME")
    return ns
}

fn native_capsule_sys_kqueue_pre() {
    // Enforce enrollment on raw sys_kqueue (no bypass).
    //
    // kqueue/kevent are a general "event loop" primitive used by multiple domains:
    // - TIME: syscall-first sleep (nanosleep on macOS uses kevent timeout)
    // - NET: socket readiness waits / connect timeouts
    // - PROC: cancellable waits / IPC support
    //
    // Rolling rule: allow if any of NET/PROC/TIME is enrolled.
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    return 0
}

fn native_capsule_sys_kqueue_post(kq_fd) {
    // Tag returned kqueue fd so fd-based syscalls (close/fcntl) enforce the right domain.
    if global_get_capsule_mode() != 1 { return kq_fd }
    if kq_fd < 0 { return kq_fd }
    native_capsule_net_fd_kind_set(kq_fd, FD_KIND_KQUEUE)
    return kq_fd
}

fn native_capsule_sys_kevent_pre() {
    // Enforce enrollment on raw sys_kevent (no bypass).
    // Rolling rule: allow if any of NET/PROC/TIME is enrolled.
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    return 0
}

fn native_capsule_sys_epoll_create1_pre(flags) {
    // Enforce enrollment on raw sys_epoll_create1 (no bypass).
    // Rolling rule: allow if any of NET/PROC/TIME is enrolled.
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    return flags
}

fn native_capsule_sys_epoll_create1_post(epfd) {
    // Tag returned epoll fd so fd-based syscalls (close/fcntl) enforce the right domain.
    if global_get_capsule_mode() != 1 { return epfd }
    if epfd < 0 { return epfd }
    native_capsule_net_fd_kind_set(epfd, FD_KIND_EPOLL)
    return epfd
}

fn native_capsule_sys_epoll_ctl_pre(epfd, op, fd, event_ptr) {
    // Enforce enrollment on raw sys_epoll_ctl (no bypass).
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    // Ensure the epoll fd itself is within an allowed domain.
    native_capsule_require_fd_domain(epfd)
    // Ensure the target fd is within an allowed domain (NET socket, PROC pipe, etc).
    native_capsule_require_fd_domain(fd)
    return 0
}

fn native_capsule_sys_epoll_pwait_pre(epfd, events_ptr, maxevents, timeout_ms, sigmask_ptr, sigsetsize) {
    // Enforce enrollment on raw sys_epoll_pwait (no bypass).
    // Rolling rule: allow if any of NET/PROC/TIME is enrolled.
    native_capsule_require_any(CAP_NET | CAP_PROC | CAP_TIME, "NET,PROC,TIME")
    native_capsule_require_fd_domain(epfd)
    return 0
}

fn native_capsule_sys_execve_pre(path, argv_ptrs, envp_ptrs) {
    // Enforce PROC enrollment on raw sys_execve (no bypass).
    //
    // Returns the envp pointer to use for the syscall:
    // - non-capsule: returns envp_ptrs unchanged
    // - capsule: returns a filtered envp that preserves OREN_* capsule enforcement
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return envp_ptrs }

    native_capsule_require_proc_exec(path)

    var argc = native_argv_ptrs_count(argv_ptrs)
    if argc <= 0 {
        print("CAPSULE DENY: PROC_ARGV (invalid argv)")
        exit(80)
    }
    native_capsule_require_proc_argv(path, argv_ptrs, argc)

    // Ignore the caller-provided envp to prevent "escape capsule" by env filtering.
    var envp = native_runtime_get_envp_for_proc_child()
    if envp == 0 { exit(127) }
    return envp
}

fn native_capsule_sys_wait4_pre(pid, options) {
    // Enforce PROC enrollment on raw sys_wait4 (no bypass).
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }
    // Deny pid=-1/0 in capsule mode for now; require explicit registered child pid.
    if pid <= 0 {
        print("CAPSULE DENY: PROC_WAIT")
        exit(80)
    }
    if native_capsule_proc_pid_allowed(pid) != true {
        print("CAPSULE DENY: PROC_WAIT")
        exit(80)
    }
    return 0
}

fn native_capsule_sys_kill_pre(pid, signum) {
    // Enforce PROC enrollment on raw sys_kill (no bypass).
    native_capsule_require(CAP_PROC, "PROC")
    if global_get_capsule_mode() != 1 { return 0 }
    if pid <= 0 {
        print("CAPSULE DENY: PROC_KILL")
        exit(80)
    }
    if native_capsule_proc_pid_allowed(pid) != true {
        print("CAPSULE DENY: PROC_KILL")
        exit(80)
    }
    if signum < 0 || signum > 64 {
        print("CAPSULE DENY: PROC_KILL")
        exit(80)
    }
    return 0
}

