    var ea = native_buf_check(a, BUF_TAG_F64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F64, 8)
    if oren_is_err(eb) { return eb }
    if out_off < 0 || a_off < 0 || b0_off < 0 || b1_off < 0 || b2_off < 0 || b3_off < 0 || n < 0 { return oren_err(4, "buf_dot_f64_4_slice_into: negative arg") }

    var no = ptr_get(out + 0)
    if out_off > no || no - out_off < 4 { return oren_err(4, "buf_dot_f64_4_slice_into: out range out of bounds") }

    var na = ptr_get(a + 0)
    var nb = ptr_get(b + 0)
    if a_off > na { return oren_err(4, "buf_dot_f64_4_slice_into: a_off out of bounds") }
    if n > na - a_off { return oren_err(4, "buf_dot_f64_4_slice_into: a range out of bounds") }
    if b0_off > nb || b1_off > nb || b2_off > nb || b3_off > nb { return oren_err(4, "buf_dot_f64_4_slice_into: b_off out of bounds") }
    if n > nb - b0_off || n > nb - b1_off || n > nb - b2_off || n > nb - b3_off { return oren_err(4, "buf_dot_f64_4_slice_into: b range out of bounds") }

    // Native SIMD fast path: 1×4 dot microkernel intrinsic (single-pass over A).
    // Uses strict lane extraction + scalar accumulation to preserve deterministic k-order semantics.
    if native_simd_enabled() != 0 && n >= 2 {
        var outp = native_buf_data_ptr(out) + out_off * 8
        var pa = native_buf_data_ptr(a) + a_off * 8
        var pb0 = native_buf_data_ptr(b) + b0_off * 8
        var pb1 = native_buf_data_ptr(b) + b1_off * 8
        var pb2 = native_buf_data_ptr(b) + b2_off * 8
        var pb3 = native_buf_data_ptr(b) + b3_off * 8
        simd_dot_f64_4_ptr(outp, pa, pb0, pb1, pb2, pb3, n)
        return out
    }

    // Scalar fallback: deterministic, fixed increasing-k order.
    var s0 = 0.0
    var s1 = 0.0
    var s2 = 0.0
    var s3 = 0.0
    var i = 0
    while i < n {
        var av = oren_buf_load_f64(a, a_off + i)
        s0 = s0 + av * oren_buf_load_f64(b, b0_off + i)
        s1 = s1 + av * oren_buf_load_f64(b, b1_off + i)
        s2 = s2 + av * oren_buf_load_f64(b, b2_off + i)
        s3 = s3 + av * oren_buf_load_f64(b, b3_off + i)
        i = i + 1
    }
    oren_buf_store_f64(out, out_off + 0, s0)
    oren_buf_store_f64(out, out_off + 1, s1)
    oren_buf_store_f64(out, out_off + 2, s2)
    oren_buf_store_f64(out, out_off + 3, s3)
    return out
}

