fn __oren_crash_footer_handler(sig) {
    if g_crash_footer_handled != 0 {
        sys_exit(139)
        return 0
    }
    g_crash_footer_handled = 1
    // Signal-safe-ish crash footer: avoid allocations and higher-level string ops.
    native_crash_footer_write_cstr("[crash_footer_raw] signal=")
    native_crash_footer_write_u64(sig)
    native_crash_footer_write_cstr(" alloc_index_zeroed=")
    native_crash_footer_write_u64(g_alloc_index_list_zeroed_count)
    native_crash_footer_write_cstr(" alloc_index_bad=")
    native_crash_footer_write_u64(g_alloc_index_list_bad_count)
    native_crash_footer_write_cstr(" alloc_index_len=")
    native_crash_footer_write_u64(g_alloc_index_len)
    native_crash_footer_write_cstr(" alloc_index_cap=")
    native_crash_footer_write_u64(g_alloc_index_cap)
    native_crash_footer_write_cstr(" list_hdr_ring_ptr=")
    native_crash_footer_write_u64(g_trace_list_hdr_ring_ptr)
    native_crash_footer_write_cstr(" list_hdr_ring_guard=")
    native_crash_footer_write_u64(g_trace_list_hdr_ring_ptr_guard)
    native_crash_footer_write_cstr(" list_hdr_ring_cap=")
    native_crash_footer_write_u64(g_trace_list_hdr_ring_cap)
    native_crash_footer_write_cstr(" list_hdr_ring_head=")
    native_crash_footer_write_u64(g_trace_list_hdr_ring_head)
    native_crash_footer_write_cstr("\n")
    if g_trace_list_hdr_ring_ptr != 0 && g_trace_list_hdr_ring_cap > 0 {
        native_crash_footer_dump_list_hdr_ring_raw(16)
    }
    print("[crash_footer] signal=" + oren_int_to_string(sig) +
        " alloc_index_zeroed=" + oren_int_to_string(g_alloc_index_list_zeroed_count) +
        " alloc_index_bad=" + oren_int_to_string(g_alloc_index_list_bad_count) +
        " alloc_index_len=" + oren_int_to_string(g_alloc_index_len) +
        " alloc_index_cap=" + oren_int_to_string(g_alloc_index_cap))
    if g_trace_list_hdr_ring_ptr != 0 {
        native_list_header_ring_dump_all()
    } else {
        print("[crash_footer] list_hdr_ring=0")
    }
    sys_exit(139)
    return 0
}

fn native_crash_footer_dump_list_hdr_ring_raw(max_entries) {
    var base = g_trace_list_hdr_ring_ptr
    var cap = g_trace_list_hdr_ring_cap
    if base == 0 || cap <= 0 { return 0 }
    if max_entries <= 0 { return 0 }
    if g_trace_list_hdr_ring_ptr_guard != 0 &&
       g_trace_list_hdr_ring_ptr_guard != 1 {
        return 0
    }
    var entries = max_entries
    if entries > cap { entries = cap }
    var head = g_trace_list_hdr_ring_head
    var head_idx = head % cap
    var start = head_idx - entries
    if start < 0 { start = start + cap }
    native_crash_footer_write_cstr("[crash_footer_raw] ring_dump entries=")
    native_crash_footer_write_u64(entries)
    native_crash_footer_write_cstr(" head_idx=")
    native_crash_footer_write_u64(head_idx)
    native_crash_footer_write_cstr(" start=")
    native_crash_footer_write_u64(start)
    native_crash_footer_write_cstr("\n")
    var i = 0
    while i < entries {
        var idx = start + i
        if idx >= cap { idx = idx - cap }
        var off = idx * 56
        var list = ptr_get(iadd(base, off))
        var op = ptr_get(iadd(base, off + 8))
        var len = ptr_get(iadd(base, off + 16))
        var list_cap = ptr_get(iadd(base, off + 24))
        var buf = ptr_get(iadd(base, off + 32))
        var magic = ptr_get(iadd(base, off + 40))
        var kind = ptr_get(iadd(base, off + 48))
        native_crash_footer_write_cstr("[crash_footer_raw] ring idx=")
        native_crash_footer_write_u64(idx)
        native_crash_footer_write_cstr(" list=")
        native_crash_footer_write_u64(list)
        native_crash_footer_write_cstr(" op=")
        native_crash_footer_write_u64(op)
        native_crash_footer_write_cstr(" len=")
        native_crash_footer_write_u64(len)
        native_crash_footer_write_cstr(" cap=")
        native_crash_footer_write_u64(list_cap)
        native_crash_footer_write_cstr(" buf=")
        native_crash_footer_write_u64(buf)
        native_crash_footer_write_cstr(" magic=")
        native_crash_footer_write_u64(magic)
        native_crash_footer_write_cstr(" kind=")
        native_crash_footer_write_u64(kind)
        native_crash_footer_write_cstr("\n")
        i = i + 1
    }
    return 0
}

fn native_install_crash_footer() {
    if g_trace_crash_footer == 0 { return 0 }
    if g_crash_footer_buf == 0 {
        var cap = 128
        var buf = native_malloc_raw_or_mmap(cap)
        if buf != 0 {
            g_crash_footer_buf = buf
            g_crash_footer_buf_cap = cap
        }
    }
    if g_trace_list_hdr_ring_ptr == 0 {
        native_list_header_ring_force_enable()
    }
    native_install_crash_altstack()
    var handler = oren_code_addr(__oren_crash_footer_handler)
    if handler == 0 { return 0 }
    native_install_crash_sigaction(10, handler)
    native_install_crash_sigaction(11, handler)
    if g_crash_footer_installed == 0 {
        g_crash_footer_installed = 1
        print("[crash_footer] installed")
    }
    return 0
}

fn native_install_crash_sigaction(sig, handler) {
    if g_target_os != 1 {
        __oren_signal(sig, handler)
        return 0
    }
    var act = native_crash_sigaction_ptr()
    if act == 0 {
        __oren_signal(sig, handler)
        return 0
    }
    native_crash_sigaction_init(act, handler)
    __oren_sigaction(sig, act, 0)
    return 0
}

fn native_crash_sigaction_ptr() {
    if g_crash_footer_sigaction_struct != 0 { return g_crash_footer_sigaction_struct }
    var buf = native_malloc_raw_or_mmap(32)
    if buf == 0 { return 0 }
    g_crash_footer_sigaction_struct = buf
    return buf
}

fn native_crash_sigaction_init(act, handler) {
    // struct sigaction (Darwin): [handler ptr, mask(u32)+flags(u32)]
    ptr_set(act, handler)
    var flags = crash_sig_flag_onstack()
    var mask_flags = (flags << 32) | 0
    ptr_set(iadd(act, 8), mask_flags)
    return 0
}

fn crash_sig_flag_onstack() { return 1 } // SA_ONSTACK (0x0001)
fn crash_sigstk_size() { return 131072 } // SIGSTKSZ

fn native_install_crash_altstack() {
    if g_target_os != 1 { return 0 }
    if g_crash_footer_altstack != 0 { return 0 }
    var size = crash_sigstk_size()
    var stack = native_malloc_raw_or_mmap(size)
    if stack == 0 { return 0 }
    var ss = native_malloc_raw_or_mmap(32)
    if ss == 0 { return 0 }
    ptr_set(ss, stack)
    ptr_set(iadd(ss, 8), size)
    ptr_set(iadd(ss, 16), 0) // ss_flags
    g_crash_footer_altstack = stack
    g_crash_footer_altstack_size = size
    g_crash_footer_sigaltstack_struct = ss
    __oren_sigaltstack(ss, 0)
    return 0
}

fn native_crash_footer_write_cstr(msg_cstr) {
    if msg_cstr == 0 { return 0 }
    sys_write(2, msg_cstr, native_cstr_len(msg_cstr))
    return 0
}

fn native_crash_footer_write_u64(n) {
    var buf = g_crash_footer_buf
    var cap = g_crash_footer_buf_cap
    if buf == 0 || cap <= 0 { return 0 }
    var i = 0
    if n == 0 {
        ptr_set_byte(buf, 48)
        i = 1
    } else {
        var v = n
        while v > 0 && i < cap {
            var digit = v % 10
            ptr_set_byte(iadd(buf, i), 48 + digit)
            v = v / 10
            i = i + 1
        }
    }
    if i <= 0 { return 0 }
    var left = 0
    var right = i - 1
    while left < right {
        var a = ptr_get_byte(iadd(buf, left))
        var b = ptr_get_byte(iadd(buf, right))
        ptr_set_byte(iadd(buf, left), b)
        ptr_set_byte(iadd(buf, right), a)
        left = left + 1
        right = right - 1
    }
    sys_write(2, buf, i)
    return 0
}

@oren.keep
fn native_runtime_init_gc_mode(default_enabled) {
    // default_enabled is provided by the compiler from `--no-gc`.
    g_gc_enabled = default_enabled

    // Runtime override: allow disabling GC via environment variable.
    // Any non-empty value disables scanning/collection.
    var v = native_envp_get_value_ptr("OREN_NO_GC")
    if v != 0 {
        if ptr_get_byte(v) != 0 { g_gc_enabled = 0 }
    }

    // Auto-GC policy (opt-in; compiler/test harness can enable via env).
    //
    // Env:
    // - OREN_GC_AUTO=1 enables auto-collection
    // - OREN_GC_ALLOC_THRESHOLD=<n> triggers a collection request after n tracked allocations
    //   (0 disables auto-GC even if OREN_GC_AUTO is set)
    g_gc_auto_enabled = 0
    g_gc_alloc_threshold = 200000
    g_gc_allocs_since_collect = 0
    g_gc_auto_pending = 0
    g_gc_reuse_blocks = 0
    g_gc_reuse_lists = 0
    g_gc_reuse_maps = 0
    g_gc_reuse_structs = 0
    g_gc_reuse_zero = 0
    g_gc_reuse_scan_cap = 0
    g_gc_reuse_buckets = 0
    g_gc_trace_alloc_kind = 0
    g_trace_alloc_index = 0
    g_trace_alloc_index_zeroed = 0
    g_trace_alloc_index_list_bad_ring_recent = 0
    g_trace_alloc_index_remove_time = 0
    g_trace_list_panic_footer = 0
    g_trace_crash_footer = 0
    g_crash_footer_handled = 0
    g_trace_track_alloc_time = 0
    g_trace_alloc_site = 0
    g_trace_arena = 0
    g_trace_gc_reuse = 0
    g_trace_gc_reuse_summary = 0
    g_trace_freed_lists = 0
    g_trace_freed_lists_cap = 0
    g_trace_gc_stack_ranges = 0
    g_trace_gc_stack_ranges_cap = 0
    g_trace_gc_reuse_bad_list = 0
    g_trace_gc_reuse_bad_list_cap = 0
    g_trace_gc_reuse_bad_list_safe = 0
    g_trace_gc_reuse_bad_list_ring_recent = 0
    g_trace_gc_reuse_bad_list_ring_pre = 0
    g_trace_gc_reuse_bad_list_kind_flip = 0
    g_trace_gc_reuse_list_hdr_trace = 0
    g_trace_gc_list_hdr_ok_cap = 0
    g_trace_gc_list_hdr_kind_cap = 0
    g_trace_alloc_kind_change_cap = 0
    g_trace_alloc_kind_change_ptr = 0
    g_trace_alloc_kind_change_node = 0
    g_trace_gc_reuse_node_magic = 0
    g_trace_gc_reuse_node_magic_cap = 0
    g_trace_gc_reuse_alloc_node = 0
    g_trace_gc_reuse_alloc_node_cap = 0
    g_trace_gc_reuse_alloc_index_dup = 0
    g_trace_gc_reuse_alloc_index_dup_cap = 0
    g_trace_gc_list_hdr_poison_dumped = 0
    g_trace_gc_free_list_headers = 0
    g_trace_gc_free_list_headers_cap = 0
    g_trace_gc_free_list_put = 0
    g_trace_gc_free_list_put_cap = 0
    g_trace_gc_free_list_take = 0
    g_trace_gc_free_list_take_cap = 0
    g_trace_gc_free_list_take_count = 0
    g_trace_gc_free_list_hdr_ring = 0
    g_trace_gc_free_list_hdr_ring_every = 0
    g_trace_gc_free_list_hdr_ring_cap = 0
    g_trace_gc_free_list_hdr_ring_recent = 0
    g_trace_gc_free_list_hdr_ring_left = 0
    g_trace_gc_free_list_hdr_ring_seen = 0
    g_trace_gc_free_list_hdr_ring_all = 0
    g_gc_reuse_verbose = 0
    g_gc_reuse_verbose_cap = 0
    g_gc_reuse_verbose_left = 0
    g_gc_poison_list_headers = 0
    g_alloc_site_ptr = 0
    g_alloc_site_cap = 0
    g_alloc_site_total = 0

    var v_auto = native_envp_get_value_ptr("OREN_GC_AUTO")
    if v_auto != 0 {
        if ptr_get_byte(v_auto) != 0 && ptr_get_byte(v_auto) != 48 { // not empty and not '0'
            g_gc_auto_enabled = 1
        }
    }

    var v_thr = native_envp_get_value_ptr("OREN_GC_ALLOC_THRESHOLD")
    if v_thr != 0 {
        var thr = native_parse_i64_dec_cstr_or_neg1(v_thr)
        if thr >= 0 { g_gc_alloc_threshold = thr }
    }
    if g_gc_alloc_threshold == 0 { g_gc_auto_enabled = 0 }

    var v_reuse = native_envp_get_value_ptr("OREN_GC_REUSE_BLOCKS")
    if v_reuse != 0 {
        if ptr_get_byte(v_reuse) != 0 && ptr_get_byte(v_reuse) != 48 { // not empty and not '0'
            g_gc_reuse_blocks = 1
        }
    }
    if g_gc_reuse_blocks != 0 { g_gc_reuse_zero = 1 }
    var v_reuse_lists = native_envp_get_value_ptr("OREN_GC_REUSE_LISTS")
    if v_reuse_lists != 0 {
        if ptr_get_byte(v_reuse_lists) != 0 && ptr_get_byte(v_reuse_lists) != 48 {
            g_gc_reuse_lists = 1
        }
    }
    var v_reuse_lists_unsafe = native_envp_get_value_ptr("OREN_GC_REUSE_LISTS_UNSAFE")
    var reuse_lists_unsafe = 0
    if v_reuse_lists_unsafe != 0 {
        if ptr_get_byte(v_reuse_lists_unsafe) != 0 && ptr_get_byte(v_reuse_lists_unsafe) != 48 {
            reuse_lists_unsafe = 1
        }
    }
    // Rolling safety: list reuse under auto-GC can expose missing-root bugs (use-after-free).
    if g_gc_auto_enabled != 0 && reuse_lists_unsafe == 0 {
        g_gc_reuse_lists = 0
    }
    var v_reuse_maps = native_envp_get_value_ptr("OREN_GC_REUSE_MAPS")
    if v_reuse_maps != 0 {
        if ptr_get_byte(v_reuse_maps) != 0 && ptr_get_byte(v_reuse_maps) != 48 {
            g_gc_reuse_maps = 1
        }
    }
    var v_reuse_structs = native_envp_get_value_ptr("OREN_GC_REUSE_STRUCTS")
    if v_reuse_structs != 0 {
        if ptr_get_byte(v_reuse_structs) != 0 && ptr_get_byte(v_reuse_structs) != 48 {
            g_gc_reuse_structs = 1
        }
    }
    var v_reuse_zero = native_envp_get_value_ptr("OREN_GC_REUSE_ZERO")
    if v_reuse_zero != 0 {
        if ptr_get_byte(v_reuse_zero) != 0 && ptr_get_byte(v_reuse_zero) != 48 {
            g_gc_reuse_zero = 1
        } else {
            g_gc_reuse_zero = 0
        }
    }
    var v_reuse_scan_cap = native_envp_get_value_ptr("OREN_GC_REUSE_SCAN_CAP")
    if v_reuse_scan_cap != 0 {
        var scan_cap = native_parse_i64_dec_cstr_or_neg1(v_reuse_scan_cap)
        if scan_cap > 0 { g_gc_reuse_scan_cap = scan_cap }
    }
    var v_reuse_buckets = native_envp_get_value_ptr("OREN_GC_REUSE_BUCKETS")
    if v_reuse_buckets != 0 {
        if ptr_get_byte(v_reuse_buckets) != 0 && ptr_get_byte(v_reuse_buckets) != 48 {
            g_gc_reuse_buckets = 1
        }
    }
    var v_poison_lists = native_envp_get_value_ptr("OREN_GC_POISON_LIST_HEADERS")
    if v_poison_lists != 0 {
        if ptr_get_byte(v_poison_lists) != 0 && ptr_get_byte(v_poison_lists) != 48 {
            g_gc_poison_list_headers = 1
        }
    }

    var v_trace_alloc = native_envp_get_value_ptr("OREN_TRACE_GC_ALLOC_KIND")
    if v_trace_alloc != 0 {
        if ptr_get_byte(v_trace_alloc) != 0 && ptr_get_byte(v_trace_alloc) != 48 {
            g_gc_trace_alloc_kind = 1
        }
    }

    // Ensure the main thread is registered for stack scanning when GC is enabled.
    if g_gc_enabled != 0 {
        oren_register_thread(get_sp())
    }
    var v_trace_index = native_envp_get_value_ptr("OREN_TRACE_ALLOC_INDEX")
    if v_trace_index != 0 {
        if ptr_get_byte(v_trace_index) != 0 && ptr_get_byte(v_trace_index) != 48 {
            g_trace_alloc_index = 1
            g_alloc_index_rebuild_cap = 0
            g_alloc_index_dedup_cap = 0
            var v_cap = native_envp_get_value_ptr("OREN_TRACE_ALLOC_INDEX_REBUILD_CAP")
            if v_cap != 0 {
                var cap = native_parse_i64_dec_cstr_or_neg1(v_cap)
                if cap > 0 { g_alloc_index_rebuild_cap = cap }
            }
            var v_dedup_cap = native_envp_get_value_ptr("OREN_TRACE_ALLOC_INDEX_DEDUP_CAP")
            if v_dedup_cap != 0 {
                var dcap = native_parse_i64_dec_cstr_or_neg1(v_dedup_cap)
                if dcap > 0 { g_alloc_index_dedup_cap = dcap }
            }
            var v_zeroed = native_envp_get_value_ptr("OREN_TRACE_ALLOC_INDEX_ZEROED")
            if v_zeroed != 0 {
                if ptr_get_byte(v_zeroed) != 0 && ptr_get_byte(v_zeroed) != 48 {
                    g_trace_alloc_index_zeroed = 1
                }
            }
            var v_ring_recent = native_envp_get_value_ptr("OREN_TRACE_ALLOC_INDEX_LIST_BAD_RING_RECENT")
            if v_ring_recent != 0 {
                var recent = native_parse_i64_dec_cstr_or_neg1(v_ring_recent)
                if recent > 0 { g_trace_alloc_index_list_bad_ring_recent = recent }
            }
        }
    }
    var v_trace_index_remove = native_envp_get_value_ptr("OREN_TRACE_ALLOC_INDEX_REMOVE_TIME")
    if v_trace_index_remove != 0 {
        if ptr_get_byte(v_trace_index_remove) != 0 && ptr_get_byte(v_trace_index_remove) != 48 {
            g_trace_alloc_index_remove_time = 1
        }
    }
    var v_trace_alloc_time = native_envp_get_value_ptr("OREN_TRACE_TRACK_ALLOC_TIME")
    if v_trace_alloc_time != 0 {
        if ptr_get_byte(v_trace_alloc_time) != 0 && ptr_get_byte(v_trace_alloc_time) != 48 {
            g_trace_track_alloc_time = 1
        }
    }
    var v_trace_site = native_envp_get_value_ptr("OREN_TRACE_ALLOC_SITE")
    if v_trace_site != 0 {
        if ptr_get_byte(v_trace_site) != 0 && ptr_get_byte(v_trace_site) != 48 {
            g_trace_alloc_site = 1
        }
    }
    var v_trace_reuse = native_envp_get_value_ptr("OREN_TRACE_GC_REUSE")
    if v_trace_reuse != 0 {
        if ptr_get_byte(v_trace_reuse) != 0 && ptr_get_byte(v_trace_reuse) != 48 {
            g_trace_gc_reuse = 1
        }
    }
    var v_trace_reuse_summary = native_envp_get_value_ptr("OREN_TRACE_GC_REUSE_SUMMARY")
    if v_trace_reuse_summary != 0 {
        if ptr_get_byte(v_trace_reuse_summary) != 0 && ptr_get_byte(v_trace_reuse_summary) != 48 {
            g_trace_gc_reuse_summary = 1
            g_trace_gc_reuse = 1
        }
    }
    var v_trace_freed = native_envp_get_value_ptr("OREN_TRACE_GC_FREED_LISTS")
    if v_trace_freed != 0 {
        if ptr_get_byte(v_trace_freed) != 0 && ptr_get_byte(v_trace_freed) != 48 {
            g_trace_freed_lists = 1
        }
    }
    var v_trace_freed_cap = native_envp_get_value_ptr("OREN_TRACE_GC_FREED_LISTS_CAP")
    if v_trace_freed_cap != 0 {
        var cap = native_parse_i64_dec_cstr_or_neg1(v_trace_freed_cap)
        if cap > 0 { g_trace_freed_lists_cap = cap }
    }
    var v_trace_bad_list = native_envp_get_value_ptr("OREN_TRACE_GC_REUSE_BAD_LIST")
    if v_trace_bad_list != 0 {
        if ptr_get_byte(v_trace_bad_list) != 0 && ptr_get_byte(v_trace_bad_list) != 48 {
            g_trace_gc_reuse_bad_list = 1
        }
    }
    var v_trace_bad_list_cap = native_envp_get_value_ptr("OREN_TRACE_GC_REUSE_BAD_LIST_CAP")
    if v_trace_bad_list_cap != 0 {
        var cap = native_parse_i64_dec_cstr_or_neg1(v_trace_bad_list_cap)
        if cap > 0 { g_trace_gc_reuse_bad_list_cap = cap }
    }
    var v_trace_bad_list_safe = native_envp_get_value_ptr("OREN_TRACE_GC_REUSE_BAD_LIST_SAFE")
    if v_trace_bad_list_safe != 0 {
        if ptr_get_byte(v_trace_bad_list_safe) != 0 && ptr_get_byte(v_trace_bad_list_safe) != 48 {
            g_trace_gc_reuse_bad_list_safe = 1
        }
    }
    var v_trace_bad_list_recent = native_envp_get_value_ptr("OREN_TRACE_GC_REUSE_BAD_LIST_RING_RECENT")
    if v_trace_bad_list_recent != 0 {
        var cap = native_parse_i64_dec_cstr_or_neg1(v_trace_bad_list_recent)
        if cap > 0 { g_trace_gc_reuse_bad_list_ring_recent = cap }
    }
    var v_trace_bad_list_pre = native_envp_get_value_ptr("OREN_TRACE_GC_REUSE_BAD_LIST_RING_PRE")
    if v_trace_bad_list_pre != 0 {
        var cap = native_parse_i64_dec_cstr_or_neg1(v_trace_bad_list_pre)
        if cap > 0 { g_trace_gc_reuse_bad_list_ring_pre = cap }
    }
    var v_trace_bad_list_kind_flip = native_envp_get_value_ptr("OREN_TRACE_GC_REUSE_BAD_LIST_KIND_FLIP")
    if v_trace_bad_list_kind_flip != 0 {
        if ptr_get_byte(v_trace_bad_list_kind_flip) != 0 && ptr_get_byte(v_trace_bad_list_kind_flip) != 48 {
            g_trace_gc_reuse_bad_list_kind_flip = 1
        }
    }
    var v_trace_list_hdr = native_envp_get_value_ptr("OREN_TRACE_GC_REUSE_LIST_HDR")
    if v_trace_list_hdr != 0 {
        var cap = native_parse_i64_dec_cstr_or_neg1(v_trace_list_hdr)
        if cap > 0 {
            g_trace_gc_reuse_list_hdr_trace = cap
            g_gc_reuse_list_hdr_trace_cap = cap
        }
    }
    var v_trace_hdr_ok = native_envp_get_value_ptr("OREN_TRACE_GC_LIST_HDR_OK")
    if v_trace_hdr_ok != 0 {
        var cap = native_parse_i64_dec_cstr_or_neg1(v_trace_hdr_ok)
        if cap > 0 { g_trace_gc_list_hdr_ok_cap = cap }
    }
    var v_trace_hdr_kind = native_envp_get_value_ptr("OREN_TRACE_GC_LIST_HDR_KIND")
