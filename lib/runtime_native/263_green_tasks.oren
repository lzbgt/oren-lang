// --- Native green tasks (rolling; GMP-ready) ---
//
// Goal (Stage N1, per `docs/NATIVE_GMP_SCHEDULER.md`):
// - Provide an in-process lightweight task substrate so:
//   - macOS/Linux native `spawn` no longer uses fork+pipe
//   - heap/GC/locks are in a single shared address space (required for correctness later)
// - Keep the runtime shape aligned with the eventual G-M-P model:
//   - Today: single M (one OS thread) + cooperative scheduling
//   - Later: multiple M + multiple P (work-stealing, netpoller, etc.)
//
// NOTE (rolling):
// - This first landing is intentionally conservative: correctness first, then throughput.
// - This does NOT yet make blocking syscalls non-blocking across tasks, except for `sleep`.

// Context buffer size (bytes). The native backend's `oren_ctx_*` intrinsics treat this
// as an opaque blob and expect at least the platform's required save slots.
fn green_ctx_bytes() { return 128 }

// Green task struct layout (bytes).
//
// IMPORTANT (native runtime init model; rolling):
// Avoid relying on non-zero global initializers for offset constants. Keep these as
// tiny functions so the native backend can inline them as immediates reliably.
fn green_g_off_magic() { return 0 }
fn green_g_off_ctx() { return 8 }
fn green_g_off_stack_base() { return 16 }
fn green_g_off_stack_size() { return 24 }
fn green_g_off_stack_top() { return 32 }
fn green_g_off_stack_node() { return 40 }
fn green_g_off_fn_obj() { return 48 }
fn green_g_off_args_list() { return 56 }
fn green_g_off_result() { return 64 }
fn green_g_off_state() { return 72 }
fn green_g_off_wake_ns() { return 80 }
fn green_g_off_detached() { return 88 }
fn green_g_off_next() { return 96 }
fn green_g_bytes() { return 104 }

// Green states.
fn green_g_state_runnable() { return 1 }
fn green_g_state_sleeping() { return 2 }
fn green_g_state_done() { return 3 }

// Magic for identifying a green task pointer.
// "ORENGRN1" (ASCII) packed into u64.
fn green_g_magic() { return 5716837919880455729 }

// Scheduler state struct layout (bytes).
//
// Rolling refactor (2026-01-16+):
// move runnable/sleep queues under a `P` ("processor") object so the runtime layout
// matches the eventual Go-like G-M-P model:
// - `S` holds the global scheduler state (Ps list + zombies + global run queue)
// - each `P` holds local runq/sleepq (later: timers, caches, netpoller hooks)
fn green_s_off_p0() { return 0 }        // u64: default P pointer
fn green_s_off_p_count() { return 8 }   // u64: number of Ps (>=1 once initialized)
fn green_s_off_zomb_head() { return 16 } // u64: zombie list head
fn green_s_off_glob_run_head() { return 24 } // u64: global runnable queue head (cross-P injection / fairness)
fn green_s_off_glob_run_tail() { return 32 } // u64: global runnable queue tail
fn green_s_bytes() { return 40 }

// Per-P state struct layout (bytes).
//
// Rolling (2026-01-16+): represent the per-P runnable queue as a ring buffer (Go-like work-stealing deque),
// with overflow to the scheduler's global run queue.
//
// Deque policy (aligned with eventual M:N work stealing):
// - the owning `M` pops from the **tail** (LIFO, good locality)
// - stealing `M` takes from the **head** (FIFO fairness)
//
// In rolling bring-up we still guard operations with the runtime global lock; the layout keeps the
// eventual atomics path straightforward.
fn green_p_off_runq_buf() { return 0 }   // u64: pointer to GC-scanned u64[] storing G pointers
fn green_p_off_runq_head() { return 8 }  // u64: pop index (monotonic)
fn green_p_off_runq_tail() { return 16 } // u64: push/pop index (moves up/down in deque mode)
fn green_p_off_runq_mask() { return 24 } // u64: cap-1 (power of two)
fn green_p_off_sleep_head() { return 32 }
fn green_p_off_sleep_tail() { return 40 }
fn green_p_off_id() { return 48 }        // small int id (0..p_count-1)
fn green_p_off_next() { return 56 }      // u64: next P in the scheduler's P list (0 for end)
fn green_p_off_owner_tid() { return 64 } // u64: sys_gettid() of owning M (0 when unclaimed)
fn green_p_bytes() { return 72 }

var g_green_inited = 0
var g_green_enabled_checked = 0
// IMPORTANT (native runtime init model; rolling):
// Avoid relying on non-zero global initializers for feature flags. Initialize to 0 and
// set the default in `_green_enabled()` on first use.
var g_green_enabled = 0

var g_green_state = 0        // rooted GC object (struct)

// Stage N2 groundwork: optional background scheduler workers ("M").
// Default remains Stage N1 N:1 (scheduler is driven by join/poll on the calling thread).
var g_green_workers_started = 0
var g_green_worker_wake_word = 0 // u64* (mmap page), used with oren_m_park_word_wait/wake

// Per-OS-thread green scheduler state (rolling):
// - Stage N1 ran on a single OS thread and used globals for scheduler context/current-G.
// - Stage N2 needs multiple OS threads ("M"), so this state must be per-OS-thread.
//
// We stash a pointer in the OS-thread node (which is mmap-sized 4096 bytes) at an appended offset.
// IMPORTANT: do NOT use this on stack nodes created by `oren_register_stack` (those can be 56 bytes).
fn green_thread_node_off_green_state() { return 64 }

fn green_t_off_sched_ctx() { return 0 }        // u64: scheduler ctx buffer ptr (mmap, green_ctx_bytes)
fn green_t_off_current_g() { return 8 }        // u64: currently running G ptr (0 on scheduler stack)
fn green_t_off_sched_stack_node() { return 16 } // u64: OS-thread node for this scheduler stack (for GC scanning)
fn green_t_off_p() { return 24 }               // u64: current P pointer (rolling; required for Stage N2)
fn green_t_off_tick() { return 32 }            // u64: scheduler tick for fairness / periodic global polling
fn green_t_bytes() { return 40 }

fn _green_thread_state_for_current_thread_or0() {
    if oren_globals() == 0 { return 0 }
    // Ensure we have an OS-thread node for this thread (idempotent by tid).
    var os_node = oren_register_thread(get_sp())
    if os_node == 0 || os_node == -1 || os_node < 4096 { return 0 }
    var ts = ptr_get(os_node + green_thread_node_off_green_state())
    if ts != 0 {
        if ts == -1 || ts < 4096 { return 0 }
        return ts
    }

    // Allocate a thread-local state blob. Use mmap to avoid relying on any GC-managed allocator.
    var ts0 = sys_mmap_private_anon(4096)
    if ts0 == 0 || ts0 == -1 || ts0 < 4096 { exit(910) }

    var sched_ctx = sys_mmap_private_anon(green_ctx_bytes())
    if sched_ctx == 0 || sched_ctx == -1 || sched_ctx < 4096 { exit(911) }

    ptr_set(ts0 + green_t_off_sched_ctx(), sched_ctx)
    ptr_set(ts0 + green_t_off_current_g(), 0)
    ptr_set(ts0 + green_t_off_sched_stack_node(), os_node)
    // Default P binding: P0 (single-P mode). Caller may override (Stage N2/unsafe parallel).
    // NOTE: `_green_init_if_needed()` must have run before this on all normal paths.
    var s = _green_get_state()
    var p0 = 0
    if s != 0 { p0 = _green_state_p0(s) }
    ptr_set(ts0 + green_t_off_p(), p0)
    ptr_set(ts0 + green_t_off_tick(), 0)

    // Publish into the OS-thread node (thread-local; no atomic required).
    ptr_set(os_node + green_thread_node_off_green_state(), ts0)
    return ts0
}

fn _green_thread_current_g_or0() {
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }
    return ptr_get(ts + green_t_off_current_g())
}

fn _green_thread_set_current_g(ts, g) { ptr_set(ts + green_t_off_current_g(), g); return 0 }
fn _green_thread_sched_ctx_or0(ts) { return ptr_get(ts + green_t_off_sched_ctx()) }
fn _green_thread_sched_stack_node_or0(ts) { return ptr_get(ts + green_t_off_sched_stack_node()) }
fn _green_thread_p_or0(ts) { return ptr_get(ts + green_t_off_p()) }
fn _green_thread_set_p(ts, p) { ptr_set(ts + green_t_off_p(), p); return 0 }
fn _green_thread_tick(ts) { return ptr_get(ts + green_t_off_tick()) }
fn _green_thread_set_tick(ts, v) { ptr_set(ts + green_t_off_tick(), v); return 0 }

fn _green_enabled() {
    if g_green_enabled_checked == 0 {
        // Default: enabled (Stage N1). Allow env to disable.
        g_green_enabled = 1
        // Env gate (rolling escape hatch):
        // - OREN_NO_GREEN=1 disables green tasks and keeps legacy spawn behavior (fork+pipe) on POSIX.
        var v = native_envp_get_value_ptr("OREN_NO_GREEN")
        if v != 0 {
            if ptr_get_byte(v) != 0 && ptr_get_byte(v) != 48 { // not empty and not '0'
                g_green_enabled = 0
            }
        }
        g_green_enabled_checked = 1
    }
    return g_green_enabled != 0
}

fn _green_get_state() { return g_green_state }
fn _green_set_state(p) { g_green_state = p; return 0 }

fn _green_state_p0(s) { return ptr_get(s + green_s_off_p0()) }
fn _green_state_p_count(s) { return ptr_get(s + green_s_off_p_count()) }
fn _green_state_zomb_head(s) { return ptr_get(s + green_s_off_zomb_head()) }
fn _green_state_glob_run_head(s) { return ptr_get(s + green_s_off_glob_run_head()) }
fn _green_state_glob_run_tail(s) { return ptr_get(s + green_s_off_glob_run_tail()) }

fn _green_state_set_p0(s, v) { ptr_set(s + green_s_off_p0(), v); return 0 }
fn _green_state_set_p_count(s, v) { ptr_set(s + green_s_off_p_count(), v); return 0 }
fn _green_state_set_zomb_head(s, v) { ptr_set(s + green_s_off_zomb_head(), v); return 0 }
fn _green_state_set_glob_run_head(s, v) { ptr_set(s + green_s_off_glob_run_head(), v); return 0 }
fn _green_state_set_glob_run_tail(s, v) { ptr_set(s + green_s_off_glob_run_tail(), v); return 0 }

fn _green_g_next(g) { return ptr_get(g + green_g_off_next()) }
fn _green_g_set_next(g, v) { ptr_set(g + green_g_off_next(), v); return 0 }

fn _green_p_runq_buf(p) { return ptr_get(p + green_p_off_runq_buf()) }
fn _green_p_runq_head(p) { return ptr_get(p + green_p_off_runq_head()) }
fn _green_p_runq_tail(p) { return ptr_get(p + green_p_off_runq_tail()) }
fn _green_p_runq_mask(p) { return ptr_get(p + green_p_off_runq_mask()) }
fn _green_p_sleep_head(p) { return ptr_get(p + green_p_off_sleep_head()) }
fn _green_p_sleep_tail(p) { return ptr_get(p + green_p_off_sleep_tail()) }
fn _green_p_next(p) { return ptr_get(p + green_p_off_next()) }
fn _green_p_owner_tid(p) { return ptr_get(p + green_p_off_owner_tid()) }

fn _green_p_set_runq_buf(p, v) { ptr_set(p + green_p_off_runq_buf(), v); return 0 }
fn _green_p_set_runq_head(p, v) { ptr_set(p + green_p_off_runq_head(), v); return 0 }
fn _green_p_set_runq_tail(p, v) { ptr_set(p + green_p_off_runq_tail(), v); return 0 }
fn _green_p_set_runq_mask(p, v) { ptr_set(p + green_p_off_runq_mask(), v); return 0 }
fn _green_p_set_sleep_head(p, v) { ptr_set(p + green_p_off_sleep_head(), v); return 0 }
fn _green_p_set_sleep_tail(p, v) { ptr_set(p + green_p_off_sleep_tail(), v); return 0 }
fn _green_p_set_next(p, v) { ptr_set(p + green_p_off_next(), v); return 0 }
fn _green_p_set_owner_tid(p, v) { ptr_set(p + green_p_off_owner_tid(), v); return 0 }

fn _green_p_runq_cap(p) { return _green_p_runq_mask(p) + 1 }

fn _green_p_runq_mask_default() {
    // Default per-P local runq capacity (power of two).
    // Keep bounded: too large increases GC scanning overhead; too small increases global queue pressure.
    return 255 // cap=256
}

fn _green_state_p_by_id_or0(s, id) {
    if s == 0 { return 0 }
    var p = _green_state_p0(s)
    while p != 0 {
        if ptr_get(p + green_p_off_id()) == id { return p }
        p = _green_p_next(p)
    }
    return 0
}

fn _green_current_p_or0() {
    // Best-effort: use thread-local P binding. Fallback to P0.
    // NOTE: this may lazily allocate thread-local scheduler state.
    var ts = _green_thread_state_for_current_thread_or0()
    var s = _green_get_state()
    if ts == 0 {
        if s == 0 { return 0 }
        return _green_state_p0(s)
    }
    var p = _green_thread_p_or0(ts)
    if p != 0 { return p }
    if s == 0 { return 0 }
    var p0 = _green_state_p0(s)
    if p0 != 0 { _green_thread_set_p(ts, p0) }
    return p0
}

fn _green_is_g(ptr) {
    if ptr == 0 { return false }
    // Avoid crashing on small integers: treat <4096 as not a pointer.
    if ptr < 4096 { return false }
    // Best-effort: check magic first.
    return ptr_get(ptr + green_g_off_magic()) == green_g_magic()
}

fn _green_alloc_struct(size) {
    // Green-task runtime needs a small GC-visible struct allocation hook, but we cannot
    // depend on `oren_alloc_struct` ordering (defined later in 120_first_class_fn.oren).
    //
    // Match the behavior of `oren_alloc_struct`: allocate via the compiler's special-cased
    // malloc and then tag the node kind as STRUCT so GC can scan fields conservatively.
    var ptr = malloc(size)
    var node = oren_find_node(ptr)
    if node != 0 {
        // node.kind at offset 16
        ptr_set(iadd(node, 16), 4)
    }
    return ptr
}

fn _green_find_current_stack_node_or0() {
    // Best-effort "which stack am I on?" heuristic.
    //
    // Reimplemented locally (instead of calling TIME internals) so it stays reachable even when
    // the native build is single-threaded and the TIME per-thread path is pruned.
    if oren_globals() == 0 { return 0 }
    var sp = get_sp()
    var node = global_get_threads()
    var max_scan = 8388608 // 8MB
    while node != 0 {
        var top = ptr_get(node)
        if sp < top {
            var diff = top - sp
            if diff < max_scan { return node }
        }
        node = ptr_get(node + 16)
    }
    return 0
}

fn _green_alloc_stack_bytes() {
    // Default 1 MiB per green stack (rolling).
    // Env override: OREN_GREEN_STACK_KB=<n> (clamped).
    var kb = 1024
    var v = native_envp_get_value_ptr("OREN_GREEN_STACK_KB")
    if v != 0 {
        var n = native_parse_i64_dec_cstr_or_neg1(v)
        if n > 0 {
            if n < 64 { n = 64 }
            if n > 16384 { n = 16384 }
            kb = n
        }
    }
    return kb * 1024
}

fn _green_init_if_needed() {
    if _green_enabled() != true { return 0 }
    if g_green_inited != 0 { return 0 }

    // Allocate scheduler state as a GC-managed struct and root it.
    var s = _green_alloc_struct(green_s_bytes())
    if s == 0 { exit(901) }
    // Allocate P0 (single-P default; more Ps are optional/unsafe today).
    var p0 = _green_alloc_struct(green_p_bytes())
    if p0 == 0 { exit(902) }
    // Allocate local runq buffer as a GC-scanned "struct" so runnable G pointers are retained.
    var runq_mask = _green_p_runq_mask_default()
    var runq_buf = _green_alloc_struct((runq_mask + 1) * 8)
    if runq_buf == 0 { exit(903) }
    // Explicitly clear the buffer (malloc is not guaranteed to be zeroed).
    var i = 0
    while i <= runq_mask {
        ptr_set(runq_buf + i * 8, 0)
        i = i + 1
    }
    _green_p_set_runq_buf(p0, runq_buf)
    _green_p_set_runq_head(p0, 0)
    _green_p_set_runq_tail(p0, 0)
    _green_p_set_runq_mask(p0, runq_mask)
    _green_p_set_sleep_head(p0, 0)
    _green_p_set_sleep_tail(p0, 0)
    ptr_set(p0 + green_p_off_id(), 0)
    _green_p_set_next(p0, 0)
    _green_p_set_owner_tid(p0, 0)

    _green_state_set_p0(s, p0)
    _green_state_set_p_count(s, 1)
    _green_state_set_zomb_head(s, 0)
    _green_state_set_glob_run_head(s, 0)
    _green_state_set_glob_run_tail(s, 0)
    _green_set_state(s)
    native_gc_register_root(s)

    // Per-OS-thread scheduler context buffers are allocated lazily in
    // `_green_thread_state_for_current_thread_or0()`.

    g_green_inited = 1
    return 0
}

fn _green_workers_wake_if_started() {
    if g_green_workers_started == 0 { return 0 }
    if g_green_worker_wake_word == 0 { return 0 }
    // Best-effort: post a wake token and wake all parked workers.
    oren_m_park_word_wake(g_green_worker_wake_word)
    return 0
}

fn _green_runq_push_local_locked(p, g) {
    if p == 0 || g == 0 { return 0 }
    var buf = _green_p_runq_buf(p)
    var mask = _green_p_runq_mask(p)
    if buf == 0 || mask == 0 { return 0 }

    var head = _green_p_runq_head(p)
    var tail = _green_p_runq_tail(p)
    var cap = mask + 1
    if tail - head >= cap {
        // Full: caller should overflow to global queue.
        return 0 - 60
    }

    var was_empty = 0
    if tail == head { was_empty = 1 }

    var idx = tail & mask
    ptr_set(buf + idx * 8, g)
    _green_p_set_runq_tail(p, tail + 1)
    return was_empty
}

fn _green_runq_pop_local_locked(p) {
    if p == 0 { return 0 }
    var buf = _green_p_runq_buf(p)
    var mask = _green_p_runq_mask(p)
    if buf == 0 || mask == 0 { return 0 }

    var head = _green_p_runq_head(p)
    var tail = _green_p_runq_tail(p)
    if head == tail { return 0 }

    // Owner pop from tail (LIFO).
    tail = tail - 1
    var idx = tail & mask
    var g = ptr_get(buf + idx * 8)
    ptr_set(buf + idx * 8, 0)
    _green_p_set_runq_tail(p, tail)
    return g
}

fn _green_runq_steal_one_from_locked(victim_p) {
    if victim_p == 0 { return 0 }
    var buf = _green_p_runq_buf(victim_p)
    var mask = _green_p_runq_mask(victim_p)
    if buf == 0 || mask == 0 { return 0 }

    var head = _green_p_runq_head(victim_p)
    var tail = _green_p_runq_tail(victim_p)
    if head == tail { return 0 }

    // Steal from head (FIFO).
    var idx = head & mask
    var g = ptr_get(buf + idx * 8)
    ptr_set(buf + idx * 8, 0)
    _green_p_set_runq_head(victim_p, head + 1)
    return g
}

fn _green_runq_push_locked(p, s, g) {
    if p == 0 || s == 0 || g == 0 { return 0 }
    _green_g_set_next(g, 0)
    var rc = _green_runq_push_local_locked(p, g)
    if rc == -60 {
        // Local overflow: push into global runq (fairness / overflow queue).
        return _green_global_runq_push_locked(s, g)
    }
    return rc
}

fn _green_runq_pop_locked(p) {
    return _green_runq_pop_local_locked(p)
}

fn _green_global_runq_push_locked(s, g) {
    if s == 0 || g == 0 { return 0 }
    var was_empty = 0
    _green_g_set_next(g, 0)
    var head = _green_state_glob_run_head(s)
    if head == 0 {
        was_empty = 1
        _green_state_set_glob_run_head(s, g)
        _green_state_set_glob_run_tail(s, g)
        return was_empty
    }
    var tail = _green_state_glob_run_tail(s)
    if tail != 0 { _green_g_set_next(tail, g) }
    _green_state_set_glob_run_tail(s, g)
    return was_empty
}

fn _green_global_runq_pop_locked(s) {
    if s == 0 { return 0 }
    var head = _green_state_glob_run_head(s)
    if head == 0 { return 0 }
    var next = _green_g_next(head)
    _green_state_set_glob_run_head(s, next)
    if next == 0 {
        _green_state_set_glob_run_tail(s, 0)
    }
    _green_g_set_next(head, 0)
    return head
}

fn _green_global_runq_push(g) {
    var s = _green_get_state()
    if s == 0 || g == 0 { return 0 }
    acquire_lock()
    var was_empty = _green_global_runq_push_locked(s, g)
    release_lock()
    if was_empty != 0 { _green_workers_wake_if_started() }
    return 0
}

fn _green_global_runq_pop() {
    var s = _green_get_state()
    if s == 0 { return 0 }
    acquire_lock()
    var g = _green_global_runq_pop_locked(s)
    release_lock()
    return g
}

fn _green_runq_push_p(p, g) {
    var s = _green_get_state()
    if p == 0 || s == 0 || g == 0 { return 0 }
    acquire_lock()
    var was_empty = _green_runq_push_locked(p, s, g)
    release_lock()
    if was_empty != 0 { _green_workers_wake_if_started() }
    return 0
}

fn _green_runq_pop_p(p) {
    if p == 0 { return 0 }
    acquire_lock()
    var g = _green_runq_pop_locked(p)
    release_lock()
    return g
}

fn _green_runq_push(g) {
    var p = _green_current_p_or0()
    return _green_runq_push_p(p, g)
}

fn _green_runq_pop() {
    var p = _green_current_p_or0()
    return _green_runq_pop_p(p)
}

fn _green_sleepq_push_locked(p, g) {
    if p == 0 || g == 0 { return 0 }
    _green_g_set_next(g, 0)
    var head = _green_p_sleep_head(p)
    if head == 0 {
        _green_p_set_sleep_head(p, g)
        _green_p_set_sleep_tail(p, g)
        return 0
    }
    var tail = _green_p_sleep_tail(p)
    if tail != 0 { _green_g_set_next(tail, g) }
    _green_p_set_sleep_tail(p, g)
    return 0
}

fn _green_sleepq_push_p(p, g) {
    if p == 0 || g == 0 { return 0 }
    acquire_lock()
    _green_sleepq_push_locked(p, g)
    release_lock()
    return 0
}

fn _green_sleepq_push(g) {
    var p = _green_current_p_or0()
    return _green_sleepq_push_p(p, g)
}

fn _green_zombie_push(g) {
    var s = _green_get_state()
    if s == 0 || g == 0 { return 0 }
    acquire_lock()
    // Simple LIFO for zombies.
    var head = _green_state_zomb_head(s)
    _green_g_set_next(g, head)
    _green_state_set_zomb_head(s, g)
    release_lock()
    return 0
}

fn _green_cleanup_g(g) {
    if g == 0 { return 0 }
    var stack_base = ptr_get(g + green_g_off_stack_base())
    var stack_size = ptr_get(g + green_g_off_stack_size())
    var ctx_ptr = ptr_get(g + green_g_off_ctx())
    var node = ptr_get(g + green_g_off_stack_node())

    if node != 0 {
        oren_unregister_stack(node)
        ptr_set(g + green_g_off_stack_node(), 0)
    }
    if stack_base != 0 && stack_size > 0 {
        sys_munmap(stack_base, stack_size)
        ptr_set(g + green_g_off_stack_base(), 0)
        ptr_set(g + green_g_off_stack_size(), 0)
        ptr_set(g + green_g_off_stack_top(), 0)
    }
    if ctx_ptr != 0 {
        sys_munmap(ctx_ptr, green_ctx_bytes())
        ptr_set(g + green_g_off_ctx(), 0)
    }
    // Clear references to reduce accidental retention.
    ptr_set(g + green_g_off_fn_obj(), 0)
    ptr_set(g + green_g_off_args_list(), 0)
    return 0
}

fn _green_zombie_drain() {
    var s = _green_get_state()
    if s == 0 { return 0 }
    acquire_lock()
    var cur = _green_state_zomb_head(s)
    _green_state_set_zomb_head(s, 0)
    release_lock()
    while cur != 0 {
        var next = _green_g_next(cur)
        _green_g_set_next(cur, 0)
        _green_cleanup_g(cur)
        cur = next
    }
    return 0
}

fn _green_wake_ready_p(p, now_ns) {
    if p == 0 { return 0 }
    if now_ns == 0 { return 0 }
    acquire_lock()
    var s = _green_get_state()
    var prev = 0
    var cur = _green_p_sleep_head(p)
    var new_tail = 0
    var woke_any = 0
    while cur != 0 {
        var next = _green_g_next(cur)
        var wake_ns = ptr_get(cur + green_g_off_wake_ns())
        if wake_ns != 0 && now_ns >= wake_ns {
            // Remove from sleep list.
            if prev == 0 {
                _green_p_set_sleep_head(p, next)
            } else {
                _green_g_set_next(prev, next)
            }
            if next == 0 { new_tail = prev }
            _green_g_set_next(cur, 0)
            ptr_set(cur + green_g_off_state(), green_g_state_runnable())
            if s != 0 {
                _green_runq_push_locked(p, s, cur)
            }
            woke_any = 1
            cur = next
            continue
        }
        prev = cur
        cur = next
    }
    if _green_p_sleep_head(p) == 0 {
        _green_p_set_sleep_tail(p, 0)
    } else if new_tail != 0 {
        _green_p_set_sleep_tail(p, new_tail)
    }
    release_lock()
    if woke_any != 0 { _green_workers_wake_if_started() }
    return 0
}

fn _green_next_wake_ns_p(p) {
    if p == 0 { return 0 }
    acquire_lock()
    var cur = _green_p_sleep_head(p)
    var best = 0
    while cur != 0 {
        var w = ptr_get(cur + green_g_off_wake_ns())
        if w != 0 {
            if best == 0 || w < best { best = w }
        }
        cur = _green_g_next(cur)
    }
    release_lock()
    return best
}

fn _green_next_wake_ns() {
    var p = _green_current_p_or0()
    return _green_next_wake_ns_p(p)
}

fn _green_sched_switch_to(g) {
    if g == 0 { return 0 }
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }

    _green_thread_set_current_g(ts, g)
    // Mark running (best-effort; not externally visible yet).
    ptr_set(g + green_g_off_state(), green_g_state_runnable())
    // Save scheduler-stack SP into the OS-thread node so GC can scan it while we run on the green stack.
    var sched_node = _green_thread_sched_stack_node_or0(ts)
    if sched_node != 0 { ptr_set(sched_node + 8, get_sp()) }
    // Clear saved_sp for this stack node so GC uses current SP heuristic.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, 0) }
    // Switch from scheduler context to task context.
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(sched_ctx, ctx_g)
    // Returned from task via yield/sleep/done.
    _green_thread_set_current_g(ts, 0)
    // We are back on scheduler stack; clear the saved_sp hint.
    if sched_node != 0 { ptr_set(sched_node + 8, 0) }
    return 0
}

fn _green_runq_size_locked(p) {
    if p == 0 { return 0 }
    var head = _green_p_runq_head(p)
    var tail = _green_p_runq_tail(p)
    if tail < head { return 0 }
    return tail - head
}

fn _green_runq_steal_batch_locked(dst_p, s, max_n) {
    if dst_p == 0 || s == 0 { return 0 }
    if max_n <= 0 { max_n = 1 }
    if max_n > 32 { max_n = 32 }

    var cur = _green_state_p0(s)
    while cur != 0 {
        if cur != dst_p {
            var sz = _green_runq_size_locked(cur)
            if sz > 0 {
                // Steal up to half (bounded), so we don't immediately thrash.
                var want = sz / 2
                if want < 1 { want = 1 }
                if want > max_n { want = max_n }

                var first = 0
                var i = 0
                while i < want {
                    var g = _green_runq_steal_one_from_locked(cur)
                    if g == 0 { break }
                    if first == 0 {
                        first = g
                    } else {
                        // Queue the rest locally (overflowing to global as needed).
                        _green_runq_push_locked(dst_p, s, g)
                    }
                    i = i + 1
                }
                return first
            }
        }
        cur = _green_p_next(cur)
    }
    return 0
}

fn _green_runq_pop_any_locked(p, s, prefer_global) {
    if p == 0 || s == 0 { return 0 }
    var g = 0
    if prefer_global != 0 {
        g = _green_global_runq_pop_locked(s)
        if g != 0 { return g }
    }
    g = _green_runq_pop_locked(p)
    if g != 0 { return g }
    // If local is empty, allow the global queue as a fallback.
    g = _green_global_runq_pop_locked(s)
    if g != 0 { return g }
    // Last resort before idling: attempt a small bounded steal batch.
    return _green_runq_steal_batch_locked(p, s, 4)
}

fn _green_poll_until(deadline_ns) {
    // deadline_ns == 0 means "run until no runnable work" (but still drive sleepers minimally).
    _green_init_if_needed()
    if _green_enabled() != true { return 0 }
    // Ensure per-thread scheduler state exists for this OS thread.
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }
    var s = _green_get_state()
    if s == 0 { return 0 }
    var p = _green_thread_p_or0(ts)
    if p == 0 {
        p = _green_state_p0(s)
        if p != 0 { _green_thread_set_p(ts, p) }
    }
    if p == 0 { return 0 }
    if g_green_workers_started != 0 {
        // Enforce "an M runs Oren code only while holding a P" by requiring this thread to
        // match the owning tid for its bound P (Stage N3 correctness prerequisite).
        var tid = sys_gettid()
        if tid == 0 { exit(926) }
        var owner = _green_p_owner_tid(p)
        if owner == 0 || owner != tid { exit(927) }
    }

    while 1 {
        // Fairness tick: allow periodic draining from the global run queue even if the local runq
        // is non-empty, so spawns from non-green threads cannot starve indefinitely.
        var tick = _green_thread_tick(ts) + 1
        _green_thread_set_tick(ts, tick)

        // Drain detached tasks that completed.
        _green_zombie_drain()

        var now = oren_time_unix_ns()
        if now != 0 {
            _green_wake_ready_p(p, now)
            if deadline_ns != 0 && now >= deadline_ns { return 0 }
        }

        // Prefer the global run queue periodically for fairness.
        var prefer_global = 0
        if (tick & 31) == 0 { prefer_global = 1 }

        acquire_lock()
        var g = _green_runq_pop_any_locked(p, s, prefer_global)
        release_lock()
        if g != 0 {
            _green_sched_switch_to(g)
            // After returning, decide whether to requeue.
            var st = ptr_get(g + green_g_off_state())
            if st == green_g_state_runnable() {
                _green_runq_push_p(p, g)
            } else if st == green_g_state_done() {
                // Detached tasks are cleaned immediately by scheduler.
                if ptr_get(g + green_g_off_detached()) != 0 {
                    _green_zombie_push(g)
                }
            } else {
                // sleeping: enqueue into sleepq now that the task context is saved/paused.
                _green_sleepq_push_p(p, g)
            }
            continue
        }

        // No runnable tasks. If no sleepers, we're idle.
        var next_wake = _green_next_wake_ns_p(p)
        if next_wake == 0 {
            return 0
        }

        // Idle sleep: do not oversleep past the join deadline.
        var now2 = oren_time_unix_ns()
        if now2 == 0 { return 0 }
        var sleep_ns = next_wake - now2
        if sleep_ns <= 0 {
            // Should be woken on next iteration.
            continue
        }
        if deadline_ns != 0 {
            var rem = deadline_ns - now2
            if rem <= 0 { return 0 }
            if sleep_ns > rem { sleep_ns = rem }
        }
        // Clamp to avoid huge sleeps in rolling mode; keep responsiveness.
        if sleep_ns > 10000000 { sleep_ns = 10000000 } // 10ms
        sys_nanosleep(sleep_ns)
    }
}

// --- Green entry trampoline (runs on a task stack) ---
//
// This must never return. It executes the task's target callable, then yields
// back to the scheduler.
@oren.keep
fn __oren_green_entry() {
    var g = _green_thread_current_g_or0()
    if g == 0 {
        // Should never happen; abort loudly in debug mode.
        sys_exit(920)
        return 0
    }
    var fn_obj = ptr_get(g + green_g_off_fn_obj())
    var args_list = ptr_get(g + green_g_off_args_list())
    var ret = oren_call_obj_list(fn_obj, args_list)
    ptr_set(g + green_g_off_result(), ret)
    ptr_set(g + green_g_off_state(), green_g_state_done())
    // Wake joiners waiting on state transitions (Stage N2 join waits on addr).
    oren_wake_all_addr(g + green_g_off_state())
    // Save stack pointer into the stack node so GC can scan this stack while paused.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, get_sp()) }
    // Switch back to scheduler.
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { sys_exit(921); return 0 }
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(ctx_g, sched_ctx)
    // If resumed, hard exit (bug).
    sys_exit(905)
    return 0
}

// --- Optional background scheduler workers (Stage N2 groundwork) ---
@oren.keep
fn oren_green_start_workers(n) {
    _green_init_if_needed()
    if _green_enabled() != true { return -1 }
    if n <= 0 { return -1 }
    if n > 64 { n = 64 }
    // Rolling safety:
    // The native heap/GC model is not concurrency-correct yet. Multiple background workers
    // can execute green tasks concurrently on multiple OS threads, which is unsafe until:
    // - the allocator is made thread-safe (or allocation is mediated by a world lock), AND
    // - GC safepoints/roots are well-defined across threads.
    //
    // Default to 1 worker (still useful: join can block on addr while the worker drains the scheduler).
    // Opt-in for experimentation only.
    if n > 1 {
        var v = native_envp_get_value_ptr("OREN_GREEN_WORKERS_UNSAFE_PARALLEL")
        if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 { // empty or '0'
            n = 1
        }
    }
    if g_green_workers_started != 0 { return 0 }
    var s = _green_get_state()
    if s == 0 { return -1 }

    // Ensure we have enough P objects reachable from the scheduler root.
    // NOTE: without work stealing, spawning is biased to the current thread's P. This is fine for
    // rolling bring-up; it still allows nested spawns within tasks to stay local to the worker's P.
    if n > 1 {
        acquire_lock()
        var cur_count = _green_state_p_count(s)
        if cur_count < n {
            var tail = _green_state_p0(s)
            if tail == 0 { release_lock(); return -1 }
            while _green_p_next(tail) != 0 {
                tail = _green_p_next(tail)
            }
            var id = cur_count
            while id < n {
                var p = _green_alloc_struct(green_p_bytes())
                if p == 0 { exit(925) }
                var runq_mask = _green_p_runq_mask_default()
                var runq_buf = _green_alloc_struct((runq_mask + 1) * 8)
                if runq_buf == 0 { exit(935) }
                var j = 0
                while j <= runq_mask {
                    ptr_set(runq_buf + j * 8, 0)
                    j = j + 1
                }
                _green_p_set_runq_buf(p, runq_buf)
                _green_p_set_runq_head(p, 0)
                _green_p_set_runq_tail(p, 0)
                _green_p_set_runq_mask(p, runq_mask)
                _green_p_set_sleep_head(p, 0)
                _green_p_set_sleep_tail(p, 0)
                ptr_set(p + green_p_off_id(), id)
                _green_p_set_next(p, 0)
                _green_p_set_owner_tid(p, 0)
                _green_p_set_next(tail, p)
                tail = p
                id = id + 1
            }
            _green_state_set_p_count(s, n)
        }
        release_lock()
    }

    // Allocate the wake/park word (one page; u64 at offset 0).
    var word = sys_mmap_private_anon(4096)
    if word == 0 || word == -1 || word < 4096 { exit(922) }
    ptr_set(word, 0)
    g_green_worker_wake_word = word

    // Spawn N background workers. These threads run forever; they are intentionally not joined.
    var start_addr = oren_code_addr(__oren_green_worker_entry)
    if start_addr == 0 { exit(923) }

    var i = 0
    while i < n {
        var p = _green_state_p_by_id_or0(s, i)
        if p == 0 { p = _green_state_p0(s) }
        var h = oren_os_thread_spawn(start_addr, p)
        if h == 0 || h == -1 || h < 0 { exit(924) }
        i = i + 1
    }

    g_green_workers_started = 1
    // Wake all workers so they immediately start draining runq/sleepq.
    _green_workers_wake_if_started()
    return 0
}

@oren.keep
fn __oren_green_worker_entry(arg_ptr) {
    // Ensure this OS thread is registered very early so:
    // - GC stack scanning has a stable "top" bound for future deep calls
    // - STW GC accounting sees this OS thread
    oren_register_thread(get_sp())

    _green_init_if_needed()
    if _green_enabled() != true { return 0 }
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }

    // Bind this M to a P (rolling: no "exclusive P ownership" enforcement yet).
    var p0 = 0
    if arg_ptr != 0 && arg_ptr >= 4096 { p0 = arg_ptr }
    if p0 == 0 {
        var s = _green_get_state()
        if s != 0 { p0 = _green_state_p0(s) }
    }
    if p0 != 0 { _green_thread_set_p(ts, p0) }
    if p0 != 0 {
        // Claim P ownership for this M. Fail loudly if misconfigured to share a P.
        var tid = sys_gettid()
        if tid == 0 { exit(928) }
        acquire_lock()
        var owner = _green_p_owner_tid(p0)
        if owner == 0 {
            _green_p_set_owner_tid(p0, tid)
        } else if owner != tid {
            release_lock()
            exit(929)
        }
        release_lock()
    }

    while true {
        // Run until idle (no runnable tasks and no sleepers).
        _green_poll_until(0)
        // Park until someone posts a wake token (runq became non-empty, or an external wake).
        if g_green_worker_wake_word != 0 {
            oren_m_park_word_wait(g_green_worker_wake_word, 0)
        } else {
            // Fallback: avoid busy spin if wake word isn't initialized.
            sys_nanosleep(1000000) // 1ms
        }
    }
    return 0
}

// Public hooks used by spawn/join/sleep/yield.
@oren.keep
fn oren_green_current_g_or0() {
    // Fast path: if green runtime was never initialized, we are not inside a green task.
    // Avoid allocating per-thread green scheduler state from unrelated runtime calls like `oren_yield()`.
    if g_green_inited == 0 { return 0 }
    if _green_enabled() != true { return 0 }
    return _green_thread_current_g_or0()
}

@oren.keep
fn oren_green_is_g(ptr) {
    return _green_is_g(ptr)
}

@oren.keep
fn oren_green_is_done(ptr) {
    if _green_is_g(ptr) != true { return false }
    return ptr_get(ptr + green_g_off_state()) == green_g_state_done()
}

@oren.keep
fn oren_green_spawn(fn_obj, args_list) {
    _green_init_if_needed()
    if _green_enabled() != true { return 0 }

    var stack_bytes = _green_alloc_stack_bytes()
    var base = sys_mmap_private_anon(stack_bytes)
    if base == 0 || base == -1 || base < 4096 { exit(906) }
    var top = base + stack_bytes
    // Keep stack 16-byte aligned. Leave a small redzone.
    top = top - 32
    // Avoid relying on negative immediate masks: `(0 - 16)` can be mishandled by rolling
    // native backends when lowering wide immediates. Align down via arithmetic instead.
    top = (top / 16) * 16

    var ctx_ptr = sys_mmap_private_anon(green_ctx_bytes())
    if ctx_ptr == 0 || ctx_ptr == -1 || ctx_ptr < 4096 { exit(907) }

    // Create a stack node for GC scanning while this task is parked.
    var node = oren_register_stack(top + 32)
    if node == 0 { exit(908) }

    // Build task object (GC-managed struct so fn_obj/args_list are visible to GC).
    var g = _green_alloc_struct(green_g_bytes())
    if g == 0 { exit(909) }
    ptr_set(g + green_g_off_magic(), green_g_magic())
    ptr_set(g + green_g_off_ctx(), ctx_ptr)
    ptr_set(g + green_g_off_stack_base(), base)
    ptr_set(g + green_g_off_stack_size(), stack_bytes)
    ptr_set(g + green_g_off_stack_top(), top + 32)
    ptr_set(g + green_g_off_stack_node(), node)
    ptr_set(g + green_g_off_fn_obj(), fn_obj)
    ptr_set(g + green_g_off_args_list(), args_list)
    ptr_set(g + green_g_off_result(), 0)
    ptr_set(g + green_g_off_state(), green_g_state_runnable())
    ptr_set(g + green_g_off_wake_ns(), 0)
    ptr_set(g + green_g_off_detached(), 0)
    ptr_set(g + green_g_off_next(), 0)

    // Initialize context to start at __oren_green_entry on the new stack.
    var entry_pc = oren_code_addr(__oren_green_entry)
    oren_ctx_init(ctx_ptr, top, entry_pc)

    // Spawning policy (rolling, GMP-ready):
    // - If we're currently inside a green task, enqueue locally to the current P (locality).
    // - Otherwise, enqueue into the global run queue so any worker P can pick it up (cross-P injection).
    var ts = _green_thread_state_for_current_thread_or0()
    var cur_g = 0
    if ts != 0 { cur_g = ptr_get(ts + green_t_off_current_g()) }
    if cur_g != 0 {
        _green_runq_push(g)
    } else {
        _green_global_runq_push(g)
    }
    return g
}

@oren.keep
fn oren_green_join_timeout(g, timeout_ms) {
    if g == 0 { return 0 }
    if _green_is_g(g) != true { return -1 }
    _green_init_if_needed()
    if _green_enabled() != true { return -1 }

    var st = ptr_get(g + green_g_off_state())
    if st == green_g_state_done() {
        var r0 = ptr_get(g + green_g_off_result())
        _green_cleanup_g(g)
        return r0
    }

    var t = timeout_ms
    var in_green = false
    if _green_thread_current_g_or0() != 0 { in_green = true }

    // timeout_ms < 0 => wait forever
    if t < 0 {
        if in_green {
            while ptr_get(g + green_g_off_state()) != green_g_state_done() {
                // Cooperative wait: yield so the scheduler can run other tasks.
                oren_green_yield()
            }
            var r = ptr_get(g + green_g_off_result())
            _green_cleanup_g(g)
            return r
        }

        // Stage N2 worker mode: the scheduler runs on background OS threads; join blocks on addr.
        if g_green_workers_started != 0 {
            var state_ptr = g + green_g_off_state()
            while true {
                var cur = ptr_get(state_ptr)
                if cur == green_g_state_done() { break }
                var rcw = oren_wait_on_addr(state_ptr, cur, 0)
                if rcw != 0 { return rcw }
            }
            var r2 = ptr_get(g + green_g_off_result())
            _green_cleanup_g(g)
            return r2
        }

        // Stage N1: drive the scheduler on this OS thread.
        while ptr_get(g + green_g_off_state()) != green_g_state_done() {
            _green_poll_until(0)
        }
        var r3 = ptr_get(g + green_g_off_result())
        _green_cleanup_g(g)
        return r3
    }

    // timeout_ms == 0 => probe only
    if t == 0 {
        if ptr_get(g + green_g_off_state()) == green_g_state_done() {
            var r2 = ptr_get(g + green_g_off_result())
            _green_cleanup_g(g)
            return r2
        }
        return 0 - 60
    }

    if in_green {
        // Cooperative bounded wait (best-effort): yield/sleep until deadline.
        var start2 = oren_time_unix_ns()
        if start2 == 0 {
            var i2 = 0
            while i2 < t {
                if ptr_get(g + green_g_off_state()) == green_g_state_done() {
                    var rr = ptr_get(g + green_g_off_result())
                    _green_cleanup_g(g)
                    return rr
                }
                // Avoid burning CPU: sleep 1ms in green-space.
                oren_green_sleep_ns(1000000)
                i2 = i2 + 1
            }
            ptr_set(g + green_g_off_detached(), 1)
            return 0 - 60
        }
        var deadline2 = start2 + t * 1000000
        while 1 {
            if ptr_get(g + green_g_off_state()) == green_g_state_done() {
                var rr2 = ptr_get(g + green_g_off_result())
                _green_cleanup_g(g)
                return rr2
            }
            var now2 = oren_time_unix_ns()
            if now2 == 0 { break }
            if now2 >= deadline2 { break }
            var rem2 = deadline2 - now2
            if rem2 > 1000000 {
                oren_green_sleep_ns(1000000)
            } else {
                oren_green_yield()
            }
        }
        ptr_set(g + green_g_off_detached(), 1)
        return 0 - 60
    }

    // Stage N2 worker mode: block on addr with a bounded timeout.
    if g_green_workers_started != 0 {
        var state_ptr2 = g + green_g_off_state()
        var timeout_us = t * 1000
        while true {
            var cur2 = ptr_get(state_ptr2)
            if cur2 == green_g_state_done() { break }
            var rcw2 = oren_wait_on_addr(state_ptr2, cur2, timeout_us)
            if rcw2 == -60 {
                ptr_set(g + green_g_off_detached(), 1)
                return -60
            }
            if rcw2 != 0 { return rcw2 }
            // Woken or spurious; re-check state.
        }
        var r_done = ptr_get(g + green_g_off_result())
        _green_cleanup_g(g)
        return r_done
    }

    var start = oren_time_unix_ns()
    if start == 0 {
        // Fallback: run a small bounded loop.
        var i = 0
        while i < t {
            if ptr_get(g + green_g_off_state()) == green_g_state_done() {
                var r3 = ptr_get(g + green_g_off_result())
                _green_cleanup_g(g)
                return r3
            }
            _green_poll_until(0)
            i = i + 1
        }
        ptr_set(g + green_g_off_detached(), 1)
        return 0 - 60
    }

    var deadline = start + t * 1000000
    while 1 {
        if ptr_get(g + green_g_off_state()) == green_g_state_done() {
            var r4 = ptr_get(g + green_g_off_result())
            _green_cleanup_g(g)
            return r4
        }
        var now = oren_time_unix_ns()
        if now == 0 { break }
        if now >= deadline { break }
        _green_poll_until(deadline)
    }

    // Timeout: detach (do not kill; safe semantics matches Windows join_timeout).
    ptr_set(g + green_g_off_detached(), 1)
    return 0 - 60
}

@oren.keep
fn oren_green_sleep_ns(ns) {
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }
    var g = ptr_get(ts + green_t_off_current_g())
    if g == 0 { return 0 }
    if ns <= 0 { return 0 }
    var now = oren_time_unix_ns()
    if now == 0 {
        // If no clock (rolling bring-up), yield best-effort without depending on
        // higher-level yield helpers.
        sys_sched_yield()
        return 0
    }
    ptr_set(g + green_g_off_wake_ns(), now + ns)
    ptr_set(g + green_g_off_state(), green_g_state_sleeping())
    // Save SP into stack node for GC scanning while sleeping.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, get_sp()) }
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(ctx_g, sched_ctx)
    return 0
}

@oren.keep
fn oren_green_yield() {
    var ts = _green_thread_state_for_current_thread_or0()
    if ts == 0 { return 0 }
    var g = ptr_get(ts + green_t_off_current_g())
    if g == 0 { return 0 }
    ptr_set(g + green_g_off_state(), green_g_state_runnable())
    // Save SP into stack node for GC scanning while parked.
    var node = ptr_get(g + green_g_off_stack_node())
    if node != 0 { ptr_set(node + 8, get_sp()) }
    var ctx_g = ptr_get(g + green_g_off_ctx())
    var sched_ctx = _green_thread_sched_ctx_or0(ts)
    oren_ctx_switch(ctx_g, sched_ctx)
    return 0
}
