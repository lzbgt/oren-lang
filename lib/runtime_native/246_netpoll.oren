// --- Netpoller (native runtime; rolling) ---
//
// Goal (Stage N2/N3 groundwork):
// - Provide a syscall-first readiness multiplexer (kqueue on macOS, epoll on Linux)
// - Allow the green scheduler to block in the kernel (no busy polling) and wake when:
//   - an fd becomes ready, or
//   - the scheduler is nudged (wake pipe), or
//   - a timeout expires (timers/sleepers)
//
// Design (v0):
// - Single process-global poller for POSIX targets (macOS/Linux).
// - Tokens are opaque u64 payloads stored in kevent.udata / epoll_event.data, returned to the scheduler.
// - A self-pipe is registered so other runtime paths can wake a blocked poller without relying on timeouts.
//
// Rolling limitation:
// - This does not provide a general cancellation map; callers must make token use safe (e.g. token points to a long-lived object).
// - Windows readiness defaults to select-v0. When `OREN_NETPOLL_WIN_IOCP=1`, IOCP is used with a
//   readiness bridge (zero-byte overlapped WSARecv/WSASend) for green-task waits; full completion-based
//   socket ops remain future work (see `docs/WINDOWS_IOCP_NETPOLL.md`).

var g_netpoll_inited = 0
var g_netpoll_fd = 0
var g_netpoll_wake_rfd = 0
var g_netpoll_wake_wfd = 0

// Rolling Windows backend selector:
// - 0: select-v0 (watch table + select batching)
// - 1: IOCP (planned; completion-based; not implemented yet)
//
// NOTE: this is intentionally a runtime selection knob so we can land IOCP incrementally
// behind an opt-in env flag without breaking Tier‑1 bring-up.
var g_netpoll_win_backend = 0

// Windows backend ids (rolling):
// - select-v0 remains the Tier‑1 correctness default
// - IOCP is opt-in (env `OREN_NETPOLL_WIN_IOCP=1`) until completion-based NET ops are implemented
fn _netpoll_win_backend_select_v0() { return 0 }
fn _netpoll_win_backend_iocp() { return 1 }

// Windows netpoll v0 state (rolling):
// - There is no kqueue/epoll; we use WinSock select() over a watched set (FD_SETSIZE=64 per call).
// - Tokens are stored in a process-global watch table protected by a small lock.
// - Polling batches the watch table (round-robin) so the total watch table can exceed 64.
// - Optional wake socket:
//   - In non-capsule mode, we create a loopback UDP socket and include it in readfds to break select.
//   - In capsule mode, we only create the wake socket if loopback endpoints are explicitly allowed.
//
// NOTE:
// This is intentionally not IOCP yet; it exists to unblock green-task NET readiness waits on Tier‑1 Windows.
fn _netpoll_watch_max() { return 1024 }
var g_netpoll_watch_cursor = 0
var g_netpoll_watch_lock_word = 0  // pointer to u64 lock word (0 unlocked, 1 locked)
var g_netpoll_watch_n = 0
var g_netpoll_watch_fds = 0        // u64[_netpoll_watch_max()]
var g_netpoll_watch_kinds = 0      // u64[_netpoll_watch_max()] (0=read, 1=write)
var g_netpoll_watch_tokens = 0     // u64[_netpoll_watch_max()] (token pointers)
var g_netpoll_win_wake_sa = 0      // sockaddr_in ptr (16 bytes), or 0
var g_netpoll_win_wake_sa_len = 0  // 16

// IOCP helper state (rolling; Windows only):
// - free list for IOCP wait nodes
// - shared dummy buffer + flags pointer for zero-byte readiness posts
var g_netpoll_iocp_free_head = 0
var g_netpoll_iocp_free_lock_word = 0 // pointer to u64 lock word
var g_netpoll_iocp_dummy_buf = 0
var g_netpoll_iocp_flags_ptr = 0

fn _netpoll_env_truthy(name) {
    var p = native_envp_get_value_ptr(name)
    if p == 0 { return 0 }
    var b = ptr_get_byte(p)
    if b == 0 { return 0 }
    if b == 48 { return 0 } // '0'
    return 1
}

fn _netpoll_windows_backend_select() {
    // Decide which Windows netpoll backend to use.
    //
    // Default is select-v0 (correctness-first, minimal dependencies).
    // Opt-in: OREN_NETPOLL_WIN_IOCP=1 requests IOCP once implemented.
    if _netpoll_env_truthy("OREN_NETPOLL_WIN_IOCP") == 1 { return _netpoll_win_backend_iocp() }
    return _netpoll_win_backend_select_v0()
}

fn native_netpoll_is_iocp_backend() {
    if g_target_os != 3 { return false }
    if g_netpoll_win_backend == _netpoll_win_backend_iocp() { return true }
    return false
}

fn _native_netpoll_windows_init_iocp_once() {
    // Initialize the Windows IOCP poll core (CreateIoCompletionPort + wake support).
    //
    // IMPORTANT (rolling v1 scope):
    // This does not implement socket readiness yet. IOCP is completion-based, so we need
    // either:
    // - Strategy A: a readiness bridge with per-operation wait nodes + cancellation, or
    // - Strategy B: completion-driven socket operations (preferred end state).
    //
    // For now this deliverable provides:
    // - `native_netpoll_wake()` via `PostQueuedCompletionStatus` (no loopback dependency)
    // - `native_netpoll_poll_many_scratch` via `GetQueuedCompletionStatusEx`
    if g_target_os != 3 { return 0 - 78 } // ENOSYS
    if g_netpoll_fd != 0 { return 0 }
    // INVALID_HANDLE_VALUE = (HANDLE)(LONG_PTR)-1
    var port = sys_create_io_completion_port(0 - 1, 0, 0, 0)
    if port < 0 { return port }
    if port == 0 { return 0 - 5 } // EIO-ish; should not happen if intrinsic lowering is correct
    g_netpoll_fd = port
    // Wake socket is not used in IOCP mode.
    g_netpoll_wake_rfd = 0
    g_netpoll_wake_wfd = 0
    g_netpoll_win_wake_sa = 0
    g_netpoll_win_wake_sa_len = 0
    if g_netpoll_iocp_free_lock_word == 0 {
        g_netpoll_iocp_free_lock_word = malloc(8)
        if g_netpoll_iocp_free_lock_word == 0 { return 0 - 12 }
        ptr_set(g_netpoll_iocp_free_lock_word, 0)
    }
    if g_netpoll_iocp_dummy_buf == 0 {
        g_netpoll_iocp_dummy_buf = malloc_raw(1)
        if g_netpoll_iocp_dummy_buf == 0 || g_netpoll_iocp_dummy_buf == -1 { return 0 - 12 }
        ptr_set_byte(g_netpoll_iocp_dummy_buf, 0)
    }
    if g_netpoll_iocp_flags_ptr == 0 {
        g_netpoll_iocp_flags_ptr = malloc_raw(8)
        if g_netpoll_iocp_flags_ptr == 0 || g_netpoll_iocp_flags_ptr == -1 { return 0 - 12 }
        ptr_set(g_netpoll_iocp_flags_ptr, 0)
    }
    return 0
}

fn native_netpoll_supported() {
    // Rolling support:
    // - macOS/Linux: kqueue/epoll backend.
    // - Windows: select()-based backend requires WinSock init; IOCP poll core does not.
    if g_target_os == 3 {
        // IMPORTANT (cap boundary):
        // Do not attempt to initialize WinSock here; keep it behind `native_net_init_once()`.
        //
        // Exception: the rolling IOCP poll core + wake deliverable does not require WinSock initialization
        // (it is kernel32-only). Allow enabling IOCP for wake-only fixtures even when the NET stack is absent.
        if _netpoll_env_truthy("OREN_NETPOLL_WIN_IOCP") == 1 { return true }
        if g_net_wsa_inited != 1 { return false }
    }
    // Allow a rolling escape hatch for debugging.
    if _netpoll_env_truthy("OREN_NO_NETPOLL") == 1 { return false }
    return true
}

fn native_netpoll_can_block() {
    // Whether it is meaningful for the scheduler to block in `native_netpoll_poll_*`.
    //
    // POSIX has a wake pipe registered, so it can always block once initialized.
    // Windows can block if either:
    // - it has watched sockets, or
    // - it has a wake socket (so select can be broken on demand).
    if g_netpoll_inited == 0 { return false }
    if g_target_os == 3 {
        if g_netpoll_win_backend == _netpoll_win_backend_iocp() {
            // IOCP can always block once initialized (even with no watched sockets).
            if g_netpoll_fd != 0 { return true }
            return false
        }
        if g_netpoll_watch_n > 0 { return true }
        if g_netpoll_wake_rfd != 0 { return true }
        return false
    }
    if g_netpoll_wake_rfd != 0 { return true }
    return false
}

fn native_netpoll_can_wake() {
    // Whether `native_netpoll_wake()` is expected to break a blocking poll immediately.
    //
    // Why this matters:
    // - In worker-mode green scheduling we want to block "long" for efficiency.
    // - But stop-the-world GC and other runtime nudges must still wake pollers promptly.
    //
    // If this is false, callers should keep their poll timeouts bounded (fallback is periodic wake).
    if g_netpoll_inited == 0 { return false }
    if g_target_os == 3 {
        if g_netpoll_win_backend == _netpoll_win_backend_iocp() {
            // IOCP wake does not require a loopback socket.
            if g_netpoll_fd == 0 { return false }
            return true
        }
        if g_netpoll_wake_wfd == 0 { return false }
        if g_netpoll_win_wake_sa == 0 { return false }
        return true
    }
    if g_netpoll_wake_wfd == 0 { return false }
    return true
}

fn _netpoll_windows_wake_allowed() {
    // In capsule mode, creating a loopback wake socket must respect NET enrollment:
    // - we only create it if loopback endpoints are explicitly allowed.
    //
    // In non-capsule mode, always allow (not a security boundary).
    if global_get_capsule_mode() != 1 { return true }
    if global_get_net_allow_loopback() == 1 { return true }
    return false
}

fn _native_netpoll_drain_wake_fd_into(buf, buf_len) {
    if g_netpoll_wake_rfd == 0 { return 0 }
    // Drain until EAGAIN/EWOULDBLOCK.
    while 1 {
        var n = 0
        if g_target_os == 3 {
            n = sys_recv(g_netpoll_wake_rfd, buf, buf_len, 0)
        } else {
            n = sys_read(g_netpoll_wake_rfd, buf, buf_len)
        }
        // Linux: -11; macOS: -35; Windows: -11 (WSAEWOULDBLOCK normalized in syscall lowering)
        if n == 0 - 11 || n == 0 - 35 { break }
        if n <= 0 { break }
    }
    return 0
}

fn _netpoll_watch_lock_acquire() {
    // Small portable lock (wait-on-address semantics).
    //
    // Conventions match `oren_wait_on_addr`:
    // - op=1: compare-and-wait
    // - wake op=257: wake all
    var lock_ptr = g_netpoll_watch_lock_word
    if lock_ptr == 0 { return 0 }
    var spin = 0
    while atomic_cas(lock_ptr, 0, 1) != 0 {
        spin = spin + 1
        if spin > 1000 {
            // Wait while the lock is still held (value==1).
            //
            // IMPORTANT (green scheduling):
            // This lock can be contended while executing inside a green task (e.g. in-green fd waits).
            // Do NOT kernel-block the scheduler OS thread in that case.
            //
            // `oren_wait_on_addr` is green-aware:
            // - in-green: parks on the scheduler-owned word-wait list (wake-driven; no kernel block)
            // - non-green: uses the OS wait primitive with a bounded timeout
            oren_wait_on_addr(lock_ptr, 1, 1000) // 1ms
            spin = 0
        }
    }
    return 0
}

fn _netpoll_watch_lock_release() {
    var lock_ptr = g_netpoll_watch_lock_word
    if lock_ptr == 0 { return 0 }
    atomic_cas(lock_ptr, 1, 0)
    // Wake both kernel waiters and any green waiters parked via the scheduler word-wait list.
    oren_wake_all_addr(lock_ptr)
    return 0
}

fn _netpoll_iocp_lock_acquire() {
    var lock_ptr = g_netpoll_iocp_free_lock_word
    if lock_ptr == 0 { return 0 }
    var spin = 0
    while atomic_cas(lock_ptr, 0, 1) != 0 {
        spin = spin + 1
        if spin > 1000 {
            oren_wait_on_addr(lock_ptr, 1, 1000) // 1ms
            spin = 0
        }
    }
    return 0
}

fn _netpoll_iocp_lock_release() {
    var lock_ptr = g_netpoll_iocp_free_lock_word
    if lock_ptr == 0 { return 0 }
    atomic_cas(lock_ptr, 1, 0)
    oren_wake_all_addr(lock_ptr)
    return 0
}

fn _netpoll_watch_take_token_locked(fd, kind) {
    // Remove first matching (fd, kind) from the watch table and return its token.
    // Caller must hold `_netpoll_watch_lock_acquire()`.
    var nn = g_netpoll_watch_n
    var ii = 0
    while ii < nn {
        var f2 = ptr_get(g_netpoll_watch_fds + ii * 8)
        var k2 = ptr_get(g_netpoll_watch_kinds + ii * 8)
        if f2 == fd && k2 == kind {
            var tok = ptr_get(g_netpoll_watch_tokens + ii * 8)
            var last = nn - 1
            if last != ii {
                ptr_set(g_netpoll_watch_fds + ii * 8, ptr_get(g_netpoll_watch_fds + last * 8))
                ptr_set(g_netpoll_watch_kinds + ii * 8, ptr_get(g_netpoll_watch_kinds + last * 8))
                ptr_set(g_netpoll_watch_tokens + ii * 8, ptr_get(g_netpoll_watch_tokens + last * 8))
            }
            ptr_set(g_netpoll_watch_fds + last * 8, 0)
            ptr_set(g_netpoll_watch_kinds + last * 8, 0)
            ptr_set(g_netpoll_watch_tokens + last * 8, 0)
            g_netpoll_watch_n = last
            return tok
        }
        ii = ii + 1
    }
    return 0
}

fn _netpoll_windows_init_watch_table_if_needed() {
    if g_netpoll_watch_lock_word == 0 {
        g_netpoll_watch_lock_word = malloc(8)
        if g_netpoll_watch_lock_word == 0 { return 0 - 12 } // ENOMEM
        ptr_set(g_netpoll_watch_lock_word, 0)
    }
    if g_netpoll_watch_fds == 0 {
        var maxn = _netpoll_watch_max()
        g_netpoll_watch_fds = malloc(maxn * 8)
        g_netpoll_watch_kinds = malloc(maxn * 8)
        g_netpoll_watch_tokens = malloc(maxn * 8)
        if g_netpoll_watch_fds == 0 || g_netpoll_watch_kinds == 0 || g_netpoll_watch_tokens == 0 {
            if g_netpoll_watch_fds != 0 { free(g_netpoll_watch_fds); g_netpoll_watch_fds = 0 }
            if g_netpoll_watch_kinds != 0 { free(g_netpoll_watch_kinds); g_netpoll_watch_kinds = 0 }
            if g_netpoll_watch_tokens != 0 { free(g_netpoll_watch_tokens); g_netpoll_watch_tokens = 0 }
            return 0 - 12 // ENOMEM
        }
        var zi0 = 0
        while zi0 < maxn * 8 {
            ptr_set_byte(g_netpoll_watch_fds + zi0, 0)
            ptr_set_byte(g_netpoll_watch_kinds + zi0, 0)
            ptr_set_byte(g_netpoll_watch_tokens + zi0, 0)
            zi0 = zi0 + 1
        }
    }
    g_netpoll_watch_n = 0
    g_netpoll_watch_cursor = 0
    return 0
}

fn native_netpoll_init_once() {
    if native_netpoll_supported() != true { return 0 - 78 } // ENOSYS
    if g_netpoll_inited != 0 { return 0 }

    // Thread-safety:
    // - Multiple green worker threads can concurrently reach here (e.g. first fd wait on each M).
    // - Use the runtime global lock to serialize initialization and publish the globals atomically.
    acquire_lock()
    if g_netpoll_inited != 0 { release_lock(); return 0 }

    // Windows backend:
    // - No kqueue/epoll fd.
    // - Watch table is stored in-process and polled via WinSock select().
    if g_target_os == 3 {
        // Select backend once.
        g_netpoll_win_backend = _netpoll_windows_backend_select()
        if g_netpoll_win_backend == _netpoll_win_backend_iocp() {
            // Attempt IOCP init. If unimplemented/unavailable, fall back to select-v0.
            var iocp_rc = _native_netpoll_windows_init_iocp_once()
            if iocp_rc == 0 {
                var wrc = _netpoll_windows_init_watch_table_if_needed()
                if wrc < 0 {
                    release_lock()
                    return wrc
                }
                g_netpoll_inited = 1
                release_lock()
                return 0
            }
            // Fall back to select-v0 for rolling Tier‑1 correctness.
            g_netpoll_win_backend = _netpoll_win_backend_select_v0()
        }
        if g_netpoll_inited != 0 { release_lock(); return 0 }
        var wrc2 = _netpoll_windows_init_watch_table_if_needed()
        if wrc2 < 0 {
            release_lock()
            return wrc2
        }

        // Best-effort: create an internal wake socket on loopback so `native_netpoll_wake()` can
        // break a blocking select() immediately.
        //
        // In capsule mode, respect loopback enrollment (no bypass).
        if g_netpoll_wake_rfd == 0 && _netpoll_windows_wake_allowed() == true {
            var fd = sys_socket(OREN_AF_INET, OREN_SOCK_DGRAM, 17) // IPPROTO_UDP
            if fd >= 0 {
                // Bind to 127.0.0.1:0 (ephemeral).
                var sa = malloc(16)
                if sa != 0 {
                    var zi2 = 0
                    while zi2 < 16 { ptr_set_byte(sa + zi2, 0); zi2 = zi2 + 1 }
                    // sockaddr_in (Linux/Windows layout):
                    //   u16 family @0 (LE)
                    //   u16 port   @2 (BE)
                    //   u32 addr   @4 (bytes)
                    ptr_set_byte(sa + 0, OREN_AF_INET)
                    ptr_set_byte(sa + 1, 0)
                    ptr_set_byte(sa + 4, 127)
                    ptr_set_byte(sa + 5, 0)
                    ptr_set_byte(sa + 6, 0)
                    ptr_set_byte(sa + 7, 1)
                    var brc = sys_bind(fd, sa, 16)
                    if brc >= 0 {
                        // Query the bound port via getsockname.
                        var out_sa = malloc(32)
                        var lenp = malloc(8)
                        if out_sa != 0 && lenp != 0 {
                            ptr_set(lenp, 32)
                            var grc = sys_getsockname(fd, out_sa, lenp)
                            if grc >= 0 {
                                // Copy port into our sockaddr_in buffer.
                                ptr_set_byte(sa + 2, ptr_get_byte(out_sa + 2))
                                ptr_set_byte(sa + 3, ptr_get_byte(out_sa + 3))
                                g_netpoll_wake_rfd = fd
                                g_netpoll_wake_wfd = fd
                                g_netpoll_win_wake_sa = sa
                                g_netpoll_win_wake_sa_len = 16
                                // Non-blocking so drain never blocks.
                                sys_fcntl_setfl(fd, OREN_O_NONBLOCK)
                            } else {
                                free(sa)
                            }
                        } else {
                            free(sa)
                        }
                        if out_sa != 0 { free(out_sa) }
                        if lenp != 0 { free(lenp) }
                    } else {
                        free(sa)
                    }
                }
                if g_netpoll_wake_rfd == 0 {
                    // If wake socket creation failed, close the temporary fd.
                    sys_close(fd)
                }
            }
        }

        // Use a non-zero sentinel so callers can treat "poller exists" uniformly.
        g_netpoll_fd = 1
        g_netpoll_inited = 1
        release_lock()
        return 0
    }

    // Create a wake pipe.
    var buf = malloc(16)
    if buf == 0 { release_lock(); return 0 - 12 } // ENOMEM
    var prc = sys_pipe(buf)
    if prc != 0 { free(buf); release_lock(); return prc }
    var rfd = ptr_get(buf + 0)
    var wfd = ptr_get(buf + 8)
    free(buf)
    if rfd < 0 || wfd < 0 { release_lock(); return 0 - 5 } // EIO-ish

    // Best-effort: make the read end non-blocking so drain never blocks.
    var fl = sys_fcntl_getfl(rfd)
    if fl >= 0 {
        sys_fcntl_setfl(rfd, fl | OREN_O_NONBLOCK)
    }

    // Create poll backend.
    var pfd = 0
    if g_target_os == 1 {
        pfd = sys_kqueue()
    } else {
        pfd = sys_epoll_create1(0)
    }
    if pfd < 0 {
        sys_close(rfd)
        sys_close(wfd)
        release_lock()
        return pfd
    }

    // Register the wake pipe rfd:
    // - token=0 is reserved for wake events
    if g_target_os == 1 {
        // Darwin kevent: add persistent EVFILT_READ watch for rfd.
        var change = malloc(32)
        if change == 0 { sys_close(pfd); sys_close(rfd); sys_close(wfd); release_lock(); return 0 - 12 }
        var zi = 0
        while zi < 32 { ptr_set_byte(change + zi, 0); zi = zi + 1 }
        // ident @0, filter @8 (i16), flags @10 (u16), udata @24
        ptr_set(change + 0, rfd)
        // EVFILT_READ == -1
        ptr_set_byte(change + 8, 255)
        ptr_set_byte(change + 9, 255)
        var flags = 1 | 4 // EV_ADD | EV_ENABLE
        ptr_set_byte(change + 10, flags & 255)
        ptr_set_byte(change + 11, (flags >> 8) & 255)
        ptr_set(change + 24, 0) // token
        var rc = sys_kevent(pfd, change, 1, 0, 0, 0)
        free(change)
        if rc < 0 {
            sys_close(pfd); sys_close(rfd); sys_close(wfd)
            release_lock()
            return rc
        }
    } else {
        // Linux epoll: register EPOLLIN for rfd (persistent).
        var evsz = OREN_EPOLL_EVENT_BYTES
        if evsz == 0 { evsz = 16 }
        var data_off = OREN_EPOLL_EVENT_OFF_DATA
        if data_off == 0 { data_off = 8 }
        var ev = malloc(evsz)
        if ev == 0 { sys_close(pfd); sys_close(rfd); sys_close(wfd); release_lock(); return 0 - 12 }
        var zi2 = 0
        while zi2 < evsz { ptr_set_byte(ev + zi2, 0); zi2 = zi2 + 1 }
        oren_ptr_set_u32_le(ev + 0, OREN_EPOLLIN)
        oren_ptr_set_u64_le(ev + data_off, 0) // token
        var rc2 = sys_epoll_ctl(pfd, OREN_EPOLL_CTL_ADD, rfd, ev)
        free(ev)
        if rc2 < 0 {
            sys_close(pfd); sys_close(rfd); sys_close(wfd)
            release_lock()
            return rc2
        }
    }

    g_netpoll_fd = pfd
    g_netpoll_wake_rfd = rfd
    g_netpoll_wake_wfd = wfd
    g_netpoll_inited = 1
    release_lock()
    return 0
}

fn native_netpoll_wake() {
    // Wake the poller by writing one byte into the wake pipe.
    //
    // IMPORTANT (threading; rolling):
    // Do not call `native_netpoll_init_once()` here.
    // - The wake path can be triggered from multiple OS threads (e.g. host thread injecting work).
    // - Keep this path allocation-free and syscall-minimal: it should never attempt to create fds
    //   or configure the poll backend.
    // - The scheduler/IO wait paths are responsible for initializing the poller once.
    if g_netpoll_inited == 0 { return 0 }
    if g_target_os == 3 {
        if g_netpoll_win_backend == _netpoll_win_backend_iocp() {
            // IOCP backend: explicit wake, no loopback dependency.
            if g_netpoll_fd == 0 { return 0 }
            // completion_key=0 is reserved (poller ignores); overlapped_ptr=NULL
            sys_post_queued_completion_status(g_netpoll_fd, 0, 0, 0)
            return 0
        }
        // Windows backend: best-effort wake via loopback UDP socket (if available).
        // If unavailable (capsule policy, failure), scheduler waits remain bounded by timeouts.
        if g_netpoll_wake_wfd == 0 { return 0 }
        if g_netpoll_win_wake_sa == 0 { return 0 }
        sys_sendto(g_netpoll_wake_wfd, "x", 1, 0, g_netpoll_win_wake_sa, g_netpoll_win_wake_sa_len)
        return 0
    }
    if g_netpoll_wake_wfd == 0 { return 0 }
    sys_write(g_netpoll_wake_wfd, "x", 1)
    return 0
}

fn _native_netpoll_drain_wake_pipe_into(buf, buf_len) {
    if g_netpoll_wake_rfd == 0 { return 0 }
    return _native_netpoll_drain_wake_fd_into(buf, buf_len)
}

fn _native_netpoll_drain_wake_pipe() {
    var buf = malloc(64)
    if buf == 0 { return 0 }
    _native_netpoll_drain_wake_pipe_into(buf, 64)
    free(buf)
    return 0
}

// --- Netpoll tokens (v1 -> v2) ---
//
// v1 token contract:
// - token == G pointer (green task)
//
// v2 token contract (rolling; used by `oren_select` to avoid per-wake probe polling):
// - token == pointer to a small tracked struct that encodes:
//   - which G to wake
//   - which select-case index became ready
//   - an epoch to reject stale events safely
//
// This lets the scheduler wake the correct green task and mark a precise ready set
// without allocating a temporary kqueue/epoll per wake.
fn native_netpoll_wait_off_magic() { return 0 }      // u64: magic tag
fn native_netpoll_wait_off_g() { return 8 }          // u64: G pointer
fn native_netpoll_wait_off_case_idx() { return 16 }  // u64: select case index
fn native_netpoll_wait_off_epoch() { return 24 }     // u64: epoch (stale-event reject)
fn native_netpoll_wait_off_ready() { return 32 }     // u64: 0|1 (set by scheduler)
fn native_netpoll_wait_bytes() { return 40 }

// "ORENPWL1" (ASCII) packed into u64 (little-endian).
fn native_netpoll_wait_magic() { return 3552310208510644815 }

fn native_netpoll_is_wait_token(ptr) {
    if ptr == 0 { return false }
    if ptr < 4096 { return false }
    return ptr_get(ptr + native_netpoll_wait_off_magic()) == native_netpoll_wait_magic()
}

// Windows IOCP wait node (rolling; overlapped-first future):
//
// Layout:
// - [0..31]   OVERLAPPED / WSAOVERLAPPED (Win64 layout, 32 bytes)
// - [32..]    netpoll wait metadata (magic + G + epoch + ready + bytes + rc)
//
// The token pointer returned by IOCP is the OVERLAPPED pointer, so we place the
// magic after the OVERLAPPED header and use a dedicated predicate to detect it.
fn native_iocp_wait_off_magic() { return 32 }      // u64: magic tag (same as netpoll wait)
fn native_iocp_wait_off_g() { return 40 }          // u64: G pointer
fn native_iocp_wait_off_case_idx() { return 48 }   // u64: select case index (if used)
fn native_iocp_wait_off_epoch() { return 56 }      // u64: epoch (stale-event reject)
fn native_iocp_wait_off_ready() { return 64 }      // u64: 0|1 (set by scheduler)
fn native_iocp_wait_off_bytes() { return 72 }      // u64: bytes transferred (best-effort)
fn native_iocp_wait_off_rc() { return 80 }         // i64: completion rc (future)
fn native_iocp_wait_off_next() { return 88 }       // u64: free-list next
fn native_iocp_wait_bytes() { return 96 }

fn native_netpoll_is_iocp_wait_token(ptr) {
    if ptr == 0 { return false }
    if ptr < 4096 { return false }
    return ptr_get(ptr + native_iocp_wait_off_magic()) == native_netpoll_wait_magic()
}

fn native_netpoll_iocp_wait_reset(ptr) {
    if ptr == 0 { return 0 }
    var i = 0
    while i < 32 {
        ptr_set_byte(ptr + i, 0)
        i = i + 1
    }
    ptr_set(ptr + native_iocp_wait_off_ready(), 0)
    ptr_set(ptr + native_iocp_wait_off_bytes(), 0)
    ptr_set(ptr + native_iocp_wait_off_rc(), 0)
    return 0
}

fn native_netpoll_iocp_wait_alloc() {
    if g_netpoll_iocp_free_lock_word == 0 { return 0 }
    _netpoll_iocp_lock_acquire()
    var head = g_netpoll_iocp_free_head
    if head != 0 {
        g_netpoll_iocp_free_head = ptr_get(head + native_iocp_wait_off_next())
        _netpoll_iocp_lock_release()
    } else {
        _netpoll_iocp_lock_release()
        head = malloc_raw(native_iocp_wait_bytes())
        if head == 0 || head == -1 { return 0 }
    }
    ptr_set(head + native_iocp_wait_off_magic(), native_netpoll_wait_magic())
    ptr_set(head + native_iocp_wait_off_g(), 0)
    ptr_set(head + native_iocp_wait_off_case_idx(), 0)
    ptr_set(head + native_iocp_wait_off_epoch(), 0)
    ptr_set(head + native_iocp_wait_off_ready(), 0)
    ptr_set(head + native_iocp_wait_off_bytes(), 0)
    ptr_set(head + native_iocp_wait_off_rc(), 0)
    ptr_set(head + native_iocp_wait_off_next(), 0)
    native_netpoll_iocp_wait_reset(head)
    return head
}

fn native_netpoll_iocp_wait_recycle(ptr) {
    if ptr == 0 { return 0 }
    ptr_set(ptr + native_iocp_wait_off_g(), 0)
    ptr_set(ptr + native_iocp_wait_off_case_idx(), 0)
    ptr_set(ptr + native_iocp_wait_off_epoch(), 0)
    ptr_set(ptr + native_iocp_wait_off_ready(), 0)
    ptr_set(ptr + native_iocp_wait_off_bytes(), 0)
    ptr_set(ptr + native_iocp_wait_off_rc(), 0)
    _netpoll_iocp_lock_acquire()
    ptr_set(ptr + native_iocp_wait_off_next(), g_netpoll_iocp_free_head)
    g_netpoll_iocp_free_head = ptr
    _netpoll_iocp_lock_release()
    return 0
}

fn native_netpoll_iocp_wait_orphan(ptr) {
    if ptr == 0 { return 0 }
    // Mark as orphan; scheduler will recycle on completion.
    ptr_set(ptr + native_iocp_wait_off_g(), 0)
    return 0
}

fn _netpoll_iocp_associate_fd(fd) {
    if g_netpoll_fd == 0 { return 0 - 78 } // ENOSYS
    // Associate socket with IOCP (idempotent).
    var rc = sys_create_io_completion_port(fd, g_netpoll_fd, 0, 0)
    if rc < 0 { return rc }
    if rc == 0 { return 0 - 5 }
    return 0
}

fn _netpoll_iocp_post_recv(fd, ov_ptr) {
    if g_netpoll_iocp_dummy_buf == 0 || g_netpoll_iocp_flags_ptr == 0 { return 0 - 78 }
    return sys_wsarecv(fd, g_netpoll_iocp_dummy_buf, 0, g_netpoll_iocp_flags_ptr, ov_ptr)
}

fn _netpoll_iocp_post_send(fd, ov_ptr) {
    if g_netpoll_iocp_dummy_buf == 0 { return 0 - 78 }
    return sys_wsasend(fd, g_netpoll_iocp_dummy_buf, 0, 0, ov_ptr)
}

fn native_netpoll_arm_fd(fd, want_write, token) {
    // Register interest in fd readiness and associate it with `token`.
    // Caller must ensure `token` stays valid (or is safely ignorable) until disarmed.
    var rc0 = native_netpoll_init_once()
    if rc0 < 0 { return rc0 }
    if g_netpoll_fd == 0 { return 0 - 78 } // ENOSYS
    if fd < 0 { return 0 - 22 } // EINVAL
    if token == 0 { return 0 - 22 } // reserved for wake pipe

    if g_target_os == 3 {
        if g_netpoll_win_backend == _netpoll_win_backend_iocp() {
            if native_netpoll_is_iocp_wait_token(token) != true { return 0 - 22 }
            if g_netpoll_watch_fds == 0 || g_netpoll_watch_tokens == 0 || g_netpoll_watch_kinds == 0 { return 0 - 12 }
            var arc0 = _netpoll_iocp_associate_fd(fd)
            if arc0 < 0 { return arc0 }
            native_netpoll_iocp_wait_reset(token)

            var old_tok = 0
            var replaced = 0
            _netpoll_watch_lock_acquire()
            var n = g_netpoll_watch_n
            var i = 0
            while i < n {
                var f = ptr_get(g_netpoll_watch_fds + i * 8)
                var k = ptr_get(g_netpoll_watch_kinds + i * 8)
                if f == fd && k == want_write {
                    old_tok = ptr_get(g_netpoll_watch_tokens + i * 8)
                    ptr_set(g_netpoll_watch_tokens + i * 8, token)
                    replaced = 1
                    _netpoll_watch_lock_release()
                    break
                }
                i = i + 1
            }
            if replaced == 0 {
                if n >= _netpoll_watch_max() {
                    _netpoll_watch_lock_release()
                    return 0 - 28 // ENOSPC
                }
                ptr_set(g_netpoll_watch_fds + n * 8, fd)
                ptr_set(g_netpoll_watch_kinds + n * 8, want_write)
                ptr_set(g_netpoll_watch_tokens + n * 8, token)
                g_netpoll_watch_n = n + 1
                _netpoll_watch_lock_release()
            }
            if old_tok != 0 {
                sys_cancel_io_ex(fd, old_tok)
            }

            var rc_iocp = 0
            if want_write != 0 {
                rc_iocp = _netpoll_iocp_post_send(fd, token)
            } else {
                rc_iocp = _netpoll_iocp_post_recv(fd, token)
            }
            if rc_iocp < 0 {
                _netpoll_watch_lock_acquire()
                _netpoll_watch_take_token_locked(fd, want_write)
                _netpoll_watch_lock_release()
                return rc_iocp
            }
            return 0
        }
        // Windows select()-based oneshot registration.
        // Key is (fd, want_write).
        if g_netpoll_watch_fds == 0 || g_netpoll_watch_tokens == 0 || g_netpoll_watch_kinds == 0 { return 0 - 12 }
        _netpoll_watch_lock_acquire()
        var n = g_netpoll_watch_n
        var i = 0
        while i < n {
            var f = ptr_get(g_netpoll_watch_fds + i * 8)
            var k = ptr_get(g_netpoll_watch_kinds + i * 8)
            if f == fd && k == want_write {
                // Last-wins update (rolling; matches epoll MOD semantics for repeated arms).
                ptr_set(g_netpoll_watch_tokens + i * 8, token)
                _netpoll_watch_lock_release()
                // If a poller is currently blocked in select(), break it so it rebuilds its fd_set.
                native_netpoll_wake()
                return 0
            }
            i = i + 1
        }
        if n >= _netpoll_watch_max() {
            _netpoll_watch_lock_release()
            return 0 - 28 // ENOSPC
        }
        ptr_set(g_netpoll_watch_fds + n * 8, fd)
        ptr_set(g_netpoll_watch_kinds + n * 8, want_write)
        ptr_set(g_netpoll_watch_tokens + n * 8, token)
        g_netpoll_watch_n = n + 1
        _netpoll_watch_lock_release()
        native_netpoll_wake()
        return 0
    }

    if g_target_os == 1 {
        // Darwin kevent oneshot.
        var change = malloc(32)
        if change == 0 { return 0 - 12 }
        var zi = 0
        while zi < 32 { ptr_set_byte(change + zi, 0); zi = zi + 1 }
        ptr_set(change + 0, fd)
        if want_write != 0 {
            // EVFILT_WRITE == -2
            ptr_set_byte(change + 8, 254)
            ptr_set_byte(change + 9, 255)
        } else {
            // EVFILT_READ == -1
            ptr_set_byte(change + 8, 255)
            ptr_set_byte(change + 9, 255)
        }
        var flags = 1 | 4 | 16 // EV_ADD | EV_ENABLE | EV_ONESHOT
        ptr_set_byte(change + 10, flags & 255)
        ptr_set_byte(change + 11, (flags >> 8) & 255)
        ptr_set(change + 24, token)
        var rc = sys_kevent(g_netpoll_fd, change, 1, 0, 0, 0)
        free(change)
        return rc
    }

    // Linux epoll oneshot.
    var evsz = OREN_EPOLL_EVENT_BYTES
    if evsz == 0 { evsz = 16 }
    var data_off = OREN_EPOLL_EVENT_OFF_DATA
    if data_off == 0 { data_off = 8 }
    var ev = malloc(evsz)
    if ev == 0 { return 0 - 12 }
    var zi2 = 0
    while zi2 < evsz { ptr_set_byte(ev + zi2, 0); zi2 = zi2 + 1 }
    var mask = 0
    if want_write != 0 { mask = OREN_EPOLLOUT } else { mask = OREN_EPOLLIN }
    // EPOLLONESHOT: 0x40000000
    mask = mask | 1073741824
    oren_ptr_set_u32_le(ev + 0, mask)
    oren_ptr_set_u64_le(ev + data_off, token)

    // ADD, or MOD if already registered.
    var rc1 = sys_epoll_ctl(g_netpoll_fd, OREN_EPOLL_CTL_ADD, fd, ev)
    if rc1 < 0 {
        if rc1 == 0 - 17 {
            rc1 = sys_epoll_ctl(g_netpoll_fd, OREN_EPOLL_CTL_MOD, fd, ev)
        }
    }
    free(ev)
    return rc1
}

fn native_netpoll_disarm_fd(fd, want_write) {
    // Best-effort cancellation for timeout paths.
    if g_netpoll_inited == 0 { return 0 }
    if g_netpoll_fd == 0 { return 0 }
    if fd < 0 { return 0 }
    if g_target_os == 3 {
        if g_netpoll_win_backend == _netpoll_win_backend_iocp() {
            if g_netpoll_watch_fds == 0 { return 0 }
            _netpoll_watch_lock_acquire()
            var tok = _netpoll_watch_take_token_locked(fd, want_write)
            _netpoll_watch_lock_release()
            if tok != 0 {
                sys_cancel_io_ex(fd, tok)
            }
            return 0
        }
        if g_netpoll_watch_fds == 0 { return 0 }
        _netpoll_watch_lock_acquire()
        var n = g_netpoll_watch_n
        var i = 0
        while i < n {
            var f = ptr_get(g_netpoll_watch_fds + i * 8)
            var k = ptr_get(g_netpoll_watch_kinds + i * 8)
            if f == fd && k == want_write {
                // Swap-remove.
                var last = n - 1
                if last != i {
                    ptr_set(g_netpoll_watch_fds + i * 8, ptr_get(g_netpoll_watch_fds + last * 8))
                    ptr_set(g_netpoll_watch_kinds + i * 8, ptr_get(g_netpoll_watch_kinds + last * 8))
                    ptr_set(g_netpoll_watch_tokens + i * 8, ptr_get(g_netpoll_watch_tokens + last * 8))
                }
                ptr_set(g_netpoll_watch_fds + last * 8, 0)
                ptr_set(g_netpoll_watch_kinds + last * 8, 0)
                ptr_set(g_netpoll_watch_tokens + last * 8, 0)
                g_netpoll_watch_n = last
                break
            }
            i = i + 1
        }
        _netpoll_watch_lock_release()
        // If a poller is blocked in select(), break it so it observes the removal promptly.
        native_netpoll_wake()
        return 0
    }
    if g_target_os == 1 {
        var change = malloc(32)
        if change == 0 { return 0 }
        var zi = 0
        while zi < 32 { ptr_set_byte(change + zi, 0); zi = zi + 1 }
        ptr_set(change + 0, fd)
        if want_write != 0 {
            ptr_set_byte(change + 8, 254); ptr_set_byte(change + 9, 255)
        } else {
            ptr_set_byte(change + 8, 255); ptr_set_byte(change + 9, 255)
        }
        var flags = 2 // EV_DELETE
        ptr_set_byte(change + 10, flags & 255)
        ptr_set_byte(change + 11, (flags >> 8) & 255)
        var rc = sys_kevent(g_netpoll_fd, change, 1, 0, 0, 0)
        free(change)
        // Ignore ENOENT / errors in rolling mode.
        return 0
    }
    // Linux epoll DEL ignores ev ptr.
    sys_epoll_ctl(g_netpoll_fd, OREN_EPOLL_CTL_DEL, fd, 0)
    return 0
}

fn native_netpoll_poll_many_scratch(timeout_ms, scratch, scratch_bytes) {
    // Allocation-free poll helper that returns up to 8 tokens at once.
    //
    // Layout (common):
    // - scratch[0..63] is used as an output u64 tokens array (up to 8 tokens)
    //
    // Additional internal scratch is used per backend (kqueue/epoll) so we do not allocate.
    //
    // Returns: count (0..8). Tokens are written at `scratch + i*8` for i in [0,count).
    if g_netpoll_inited == 0 { return 0 }
    if g_netpoll_fd == 0 { return 0 }
    if timeout_ms < 0 { timeout_ms = 0 }
    if scratch == 0 { return 0 }
    if scratch_bytes < 64 { return 0 }

    if g_target_os == 3 {
        if g_netpoll_win_backend == _netpoll_win_backend_iocp() {
            // Windows IOCP backend (poll core + wake).
            //
            // Scratch layout:
            // - scratch[0..63] output tokens (u64[8])
            // - scratch[64..] OVERLAPPED_ENTRY[8] (32 bytes each) + removed_count slot (8 bytes)
            //
            // Token strategy (rolling v1):
            // - reserved: completion_key==0 is used for wake events (ignored by scheduler)
            // - future: completion_key will be a stable token pointer (likely an IO wait node)
            //
            // NOTE: this does not yet implement readiness watches. Until NET ops post completions,
            // the only expected completion is the wake event posted by `native_netpoll_wake()`.
            if g_netpoll_fd == 0 { return 0 }
            if timeout_ms < 0 { timeout_ms = 0 }

            // Clamp if wake is unavailable (should not happen for IOCP).
            if native_netpoll_can_wake() != true {
                if timeout_ms > 10 { timeout_ms = 10 }
            }

            var entry_bytes = 32
            var cap = 8
            var entries = scratch + 64
            var removed_ptr = scratch + 64 + entry_bytes * cap
            if scratch_bytes < 64 + entry_bytes * cap + 8 { return 0 }
            ptr_set(removed_ptr, 0)

            var rc = sys_get_queued_completion_status_ex(g_netpoll_fd, entries, cap, removed_ptr, timeout_ms, 0)
            if rc < 0 {
                // Timeout returns -60 (mapped from WAIT_TIMEOUT).
                if rc == 0 - 60 { return 0 }
                return 0
            }

            // Parse completions.
            //
            // OVERLAPPED_ENTRY (Win64) layout snapshot (repo-saved MS docs):
            // - lpCompletionKey @0 (u64)
            // - lpOverlapped     @8 (u64)
            // - Internal         @16 (u64)
            // - dwNumberOfBytesTransferred @24 (u32)
            //
            // We read only key+overlapped so we can ignore wake events and pass tokens through.
            var n = ptr_get(removed_ptr)
            if n < 0 { n = 0 }
            if n > 8 { n = 8 }
            var outn = 0
            var i = 0
            while i < n {
                var ent = entries + i * entry_bytes
                var key = ptr_get(ent + 0)
                var ov = ptr_get(ent + 8)
                // Token selection (rolling):
                // - Wake events use key==0 and ov==0 and are ignored.
                // - For real I/O completions, prefer the per-operation OVERLAPPED pointer
                //   (ov!=0). This is required for IOCP readiness/overlapped operations where
                //   the completion key is per-handle, not per-operation.
                // - If ov is 0 but key is non-zero, fall back to key (legacy / wake-like cases).
                var tok = 0
                if ov != 0 {
                    tok = ov
                } else if key != 0 {
                    tok = key
                }
                if ov != 0 {
                    if native_netpoll_is_iocp_wait_token(ov) == true {
                        var nbytes = oren_ptr_get_u32_le(ent + 24)
                        ptr_set(ov + native_iocp_wait_off_bytes(), nbytes)
                    }
                }
                if tok != 0 {
                    if outn < 8 {
                        ptr_set(scratch + outn * 8, tok)
                        outn = outn + 1
                    }
                }
                i = i + 1
            }
            return outn
        }
        // Windows select() backend.
        //
        // Scratch layout:
        // - scratch[0..63] output tokens (u64[8])
        // - scratch[64..] temporary fd_set buffers + timeval
        // - scratch[...] drain buf (64)
        //
        // fd_set layout (Windows x64):
        //   u32 fd_count @0
        //   u32 pad      @4
        //   SOCKET fd_array[FD_SETSIZE] @8   (FD_SETSIZE=64)
        var set_bytes = 8 + 8 * 64
        var readfds = scratch + 64
        var writefds = scratch + 64 + set_bytes
        var tv = scratch + 64 + set_bytes + set_bytes
        var drain = scratch + 64 + set_bytes + set_bytes + 16
        if scratch_bytes < 64 + set_bytes + set_bytes + 16 + 64 { return 0 }

        // Zero the full fd_set buffers.
        // WinSock has been observed to copy/scan the full array even when fd_count is small.
        var zi0 = 0
        while zi0 < set_bytes {
            ptr_set_byte(readfds + zi0, 0)
            ptr_set_byte(writefds + zi0, 0)
            zi0 = zi0 + 1
        }

        // Clamp: if we cannot reliably wake a blocking select(), keep bounded sleeps so:
        // - new registrations are observed promptly
        // - worker-mode safepoints remain responsive (STW is cooperative)
        if timeout_ms < 0 { timeout_ms = 0 }
        if native_netpoll_can_wake() != true {
            if timeout_ms > 10 { timeout_ms = 10 }
        }

        // Build fd_sets from the current watch table (bounded to FD_SETSIZE).
        // Use a rolling cursor to avoid starving watches beyond the first 64 entries.
        //
        // Reserve one read slot for the wake socket if present.
        var want_wake = 0
        if g_netpoll_wake_rfd != 0 && g_netpoll_win_wake_sa != 0 { want_wake = 1 }

        var nr = 0
        var nw = 0
        _netpoll_watch_lock_acquire()
        var n = g_netpoll_watch_n
        var wake_slot = 0
        if want_wake == 1 { wake_slot = 1 }
        if want_wake == 1 {
            // Place wake socket at the start of readfds.
            oren_ptr_set_u64_le(readfds + 8 + 0 * 8, g_netpoll_wake_rfd)
            nr = 1
        }
        var start = 0
        if n > 0 {
            start = g_netpoll_watch_cursor % n
        }
        var scan = 0
        var cap_r = 64 - wake_slot
        var cap_w = 64
        while scan < n {
            // Limit to FD_SETSIZE total per set (read/write are independent).
            if (nr - wake_slot) >= cap_r && nw >= cap_w { break }
            var idx = (start + scan) % n
            var fd = ptr_get(g_netpoll_watch_fds + idx * 8)
            var k = ptr_get(g_netpoll_watch_kinds + idx * 8)
            if fd >= 0 {
                if k == 1 {
                    if nw < 64 {
                        oren_ptr_set_u64_le(writefds + 8 + nw * 8, fd)
                        nw = nw + 1
                    }
                } else {
                    // Skip adding the wake fd twice (it can also appear in the watch table).
                    if want_wake == 1 && fd == g_netpoll_wake_rfd {
                        // no-op
                    } else {
                        if nr < 64 {
                            oren_ptr_set_u64_le(readfds + 8 + nr * 8, fd)
                            nr = nr + 1
                        }
                    }
                }
            }
            scan = scan + 1
            // Stop early once both sets are full.
            if (nr - wake_slot) >= cap_r && nw >= cap_w { break }
        }
        if n > 0 {
            // Advance cursor for fairness (round-robin).
            g_netpoll_watch_cursor = (start + scan + 1) % n
        } else {
            g_netpoll_watch_cursor = 0
        }
        oren_ptr_set_u32_le(readfds + 0, nr)
        oren_ptr_set_u32_le(writefds + 0, nw)
        _netpoll_watch_lock_release()

        // If we have nothing to poll, don't block here (let the scheduler use its park-word idle path).
        if nr == 0 && nw == 0 { return 0 }

        // timeval (Windows uses 32-bit longs even on x64: LLP64).
        var sec = timeout_ms / 1000
        var usec = (timeout_ms - sec * 1000) * 1000
        if sec < 0 { sec = 0 }
        if sec > 4294967295 { sec = 4294967295 }
        if usec < 0 { usec = 0 }
        if usec > 4294967295 { usec = 4294967295 }
        oren_ptr_set_u32_le(tv + 0, sec)
        oren_ptr_set_u32_le(tv + 4, usec)

        var rptr = readfds
        var wptr = writefds
        if nr == 0 { rptr = 0 }
        if nw == 0 { wptr = 0 }

        var rc = sys_select(0, rptr, wptr, 0, tv)
        if rc <= 0 { return rc }

        // Consume ready sockets and remove them from the watch table (oneshot).
        var out_n = 0
        _netpoll_watch_lock_acquire()

        // Read set
        var rr = oren_ptr_get_u32_le(readfds + 0)
        var ri = 0
        while ri < rr {
            if out_n >= 8 { break }
            var fd_ready = oren_ptr_get_u64_le(readfds + 8 + ri * 8)
            if want_wake == 1 && fd_ready == g_netpoll_wake_rfd {
                _native_netpoll_drain_wake_fd_into(drain, 64)
                ri = ri + 1
                continue
            }
            var tok = _netpoll_watch_take_token_locked(fd_ready, 0)
            if tok != 0 {
                ptr_set(scratch + out_n * 8, tok)
                out_n = out_n + 1
            }
            ri = ri + 1
        }

        // Write set
        var ww = oren_ptr_get_u32_le(writefds + 0)
        var wi = 0
        while wi < ww {
            if out_n >= 8 { break }
            var fd_ready2 = oren_ptr_get_u64_le(writefds + 8 + wi * 8)
            var tok2 = _netpoll_watch_take_token_locked(fd_ready2, 1)
            if tok2 != 0 {
                ptr_set(scratch + out_n * 8, tok2)
                out_n = out_n + 1
            }
            wi = wi + 1
        }

        _netpoll_watch_lock_release()
        return out_n
    }

    if g_target_os == 1 {
        // Darwin kqueue:
        // - reserve scratch[0..63] for output tokens
        // - use scratch[64..319] for up to 8 kevents (8*32)
        // - use scratch[320..335] for timespec (16)
        // - use scratch[336..399] for wake drain buf (64)
        var evs = scratch + 64
        var ts = scratch + 64 + 256
        var drain = scratch + 64 + 256 + 16
        if scratch_bytes < 64 + 256 + 16 + 64 { return 0 }

        if timeout_ms != 0 {
            ptr_set(ts + 0, timeout_ms / 1000)
            ptr_set(ts + 8, (timeout_ms - (timeout_ms / 1000) * 1000) * 1000000)
        } else {
            ptr_set(ts + 0, 0)
            ptr_set(ts + 8, 0)
        }

        var n = sys_kevent(g_netpoll_fd, 0, 0, evs, 8, ts)
        if n <= 0 { return 0 }
        var i = 0
        var out_n = 0
        while i < n {
            var base = evs + i * 32
            var udata = ptr_get(base + 24)
            if udata == 0 {
                _native_netpoll_drain_wake_pipe_into(drain, 64)
            } else {
                ptr_set(scratch + out_n * 8, udata)
                out_n = out_n + 1
            }
            i = i + 1
        }
        return out_n
    }

    // Linux epoll:
    // - reserve scratch[0..63] for output tokens
    // - use scratch[64..] for up to 8 epoll_event structs
    // - append wake drain buf (64 bytes)
    var evsz = OREN_EPOLL_EVENT_BYTES
    if evsz == 0 { evsz = 16 }
    var data_off = OREN_EPOLL_EVENT_OFF_DATA
    if data_off == 0 { data_off = 8 }
    if 64 + evsz * 8 + 64 > scratch_bytes { return 0 }
    var evbuf = scratch + 64
    var drain2 = scratch + 64 + evsz * 8

    var n2 = sys_epoll_pwait(g_netpoll_fd, evbuf, 8, timeout_ms, 0, 0)
    if n2 <= 0 { return 0 }
    var j = 0
    var out_n2 = 0
    while j < n2 {
        var base2 = evbuf + j * evsz
        var d = oren_ptr_get_u64_le(base2 + data_off)
        if d == 0 {
            _native_netpoll_drain_wake_pipe_into(drain2, 64)
        } else {
            ptr_set(scratch + out_n2 * 8, d)
            out_n2 = out_n2 + 1
        }
        j = j + 1
    }
    return out_n2
}

fn native_netpoll_poll_one_scratch(timeout_ms, scratch, scratch_bytes) {
    // Allocation-free poll helper intended for scheduler hot paths.
    //
    // scratch must point to writable memory of at least scratch_bytes.
    // Returns one token (u64) or 0 if none / only wake.
    if g_netpoll_inited == 0 { return 0 }
    if g_netpoll_fd == 0 { return 0 }
    if timeout_ms < 0 { timeout_ms = 0 }
    if scratch == 0 { return 0 }
    if g_target_os == 3 {
        // Reuse the many-token poller; return the first token if any.
        var got = native_netpoll_poll_many_scratch(timeout_ms, scratch, scratch_bytes)
        if got <= 0 { return 0 }
        return ptr_get(scratch + 0)
    }
    if scratch_bytes < 256 { return 0 }

    if g_target_os == 1 {
        // Darwin kqueue: each kevent is 32 bytes. Use space for up to 8 events.
        var evs = scratch
        var ts = scratch + 256
        if scratch_bytes < 256 + 16 + 64 { return 0 }

        if timeout_ms != 0 {
            ptr_set(ts + 0, timeout_ms / 1000)
            ptr_set(ts + 8, (timeout_ms - (timeout_ms / 1000) * 1000) * 1000000)
        } else {
            ptr_set(ts + 0, 0)
            ptr_set(ts + 8, 0)
        }

        var n = sys_kevent(g_netpoll_fd, 0, 0, evs, 8, ts)
        if n <= 0 { return 0 }
        var i = 0
        var tok = 0
        while i < n {
            var base = evs + i * 32
            var udata = ptr_get(base + 24)
            if udata == 0 {
                _native_netpoll_drain_wake_pipe_into(scratch + 256 + 16, 64)
            } else {
                tok = udata
                break
            }
            i = i + 1
        }
        return tok
    }

    // Linux epoll.
    var evsz = OREN_EPOLL_EVENT_BYTES
    if evsz == 0 { evsz = 16 }
    var data_off = OREN_EPOLL_EVENT_OFF_DATA
    if data_off == 0 { data_off = 8 }
    if evsz * 8 + 64 > scratch_bytes { return 0 }
    var out = scratch
    var n2 = sys_epoll_pwait(g_netpoll_fd, out, 8, timeout_ms, 0, 0)
    if n2 <= 0 { return 0 }
    var j = 0
    var tok2 = 0
    while j < n2 {
        var base2 = out + j * evsz
        var d = oren_ptr_get_u64_le(base2 + data_off)
        if d == 0 {
            _native_netpoll_drain_wake_pipe_into(scratch + evsz * 8, 64)
        } else {
            tok2 = d
            break
        }
        j = j + 1
    }
    return tok2
}

fn native_netpoll_poll_one(timeout_ms) {
    // Wait for up to timeout_ms and return one token (or 0 if none / only wake).
    // timeout_ms<0 is treated as 0 (no wait).
    if g_netpoll_inited == 0 { return 0 }
    if g_netpoll_fd == 0 { return 0 }
    if timeout_ms < 0 { timeout_ms = 0 }

    if g_target_os == 3 {
        // Fallback (allocating) helper: use a temporary scratch buffer.
        var scratch = malloc(2048)
        if scratch == 0 { return 0 }
        var zi0 = 0
        while zi0 < 2048 { ptr_set_byte(scratch + zi0, 0); zi0 = zi0 + 1 }
        var got = native_netpoll_poll_many_scratch(timeout_ms, scratch, 2048)
        var tok = 0
        if got > 0 { tok = ptr_get(scratch + 0) }
        free(scratch)
        return tok
    }

    if g_target_os == 1 {
        var evs = malloc(32 * 8)
        if evs == 0 { return 0 }
        var zi = 0
        while zi < 32 * 8 { ptr_set_byte(evs + zi, 0); zi = zi + 1 }
        var ts = 0
        if timeout_ms != 0 {
            ts = malloc(16)
            if ts != 0 {
                ptr_set(ts + 0, timeout_ms / 1000)
                ptr_set(ts + 8, (timeout_ms - (timeout_ms / 1000) * 1000) * 1000000)
            }
        } else {
            ts = malloc(16)
            if ts != 0 { ptr_set(ts + 0, 0); ptr_set(ts + 8, 0) }
        }
        var n = sys_kevent(g_netpoll_fd, 0, 0, evs, 8, ts)
        if ts != 0 { free(ts) }
        if n <= 0 { free(evs); return 0 }
        var i = 0
        var tok = 0
        while i < n {
            var base = evs + i * 32
            var udata = ptr_get(base + 24)
            if udata == 0 {
                _native_netpoll_drain_wake_pipe()
            } else {
                tok = udata
                break
            }
            i = i + 1
        }
        free(evs)
        return tok
    }

    // Linux epoll.
    var evsz = OREN_EPOLL_EVENT_BYTES
    if evsz == 0 { evsz = 16 }
    var data_off = OREN_EPOLL_EVENT_OFF_DATA
    if data_off == 0 { data_off = 8 }
    var out = malloc(evsz * 8)
    if out == 0 { return 0 }
    var zi2 = 0
    while zi2 < evsz * 8 { ptr_set_byte(out + zi2, 0); zi2 = zi2 + 1 }
    var n2 = sys_epoll_pwait(g_netpoll_fd, out, 8, timeout_ms, 0, 0)
    if n2 <= 0 { free(out); return 0 }
    var j = 0
    var tok2 = 0
    while j < n2 {
        var base2 = out + j * evsz
        var d = oren_ptr_get_u64_le(base2 + data_off)
        if d == 0 {
            _native_netpoll_drain_wake_pipe()
        } else {
            tok2 = d
            break
        }
        j = j + 1
    }
    free(out)
    return tok2
}
