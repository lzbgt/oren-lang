// --- ENV (syscall-free; reads process initial envp block) ---
//
// Returns pointer to value substring for KEY in envp ("KEY=VALUE"), or 0 if not found.
// NOTE: This returns a pointer into the process environment strings (not a copy).
@cap.requires(domain="ENV")
fn oren_getenv(key) {
    // Keep this leaf-like (no calls) to avoid any cross-call local slot issues
    // while the native backend ABI is still rolling.
    if key == 0 { return 0 }

    // Inline capsule check to keep this function leaf-like:
    // - if capsule mode is disabled, allow ENV reads
    // - if enabled and ENV is not allowed, return 0 (as if missing)
    //
    // NOTE: use literal offsets; native backend global var init/write is still rolling.
    var g = g_storage
    if g == 0 { return 0 }
    var capsule = ptr_get(iadd(g, 80)) // capsule_mode
    if capsule != 0 {
        var allow = ptr_get(iadd(g, 88)) // cap_allow_mask
        // CAP_ENV = 8 (see native_runtime_init constants).
        if (allow & 8) == 0 { return 0 }
    }

    // Use literal offsets (native backend global var init/write is still rolling).
    var envp = ptr_get(iadd(g, 64)) // envp

    // If envp wasn't captured at entry, derive it from argv/argc layout:
    // envp starts right after argv[argc] and the NULL terminator.
    var argc = ptr_get(iadd(g, 40)) // argc
    var argv = ptr_get(iadd(g, 48)) // argv
    if envp == 0 {
        if argv == 0 { return 0 }
        envp = iadd(argv, (iadd(argc, 1)) * 8)
    }
    if envp == 0 { return 0 }

    // key_len = strlen(key)
    var key_len = 0
    // Hard cap to avoid hangs if `key` is malformed / unterminated.
    while key_len < 4096 {
        if ptr_get_byte(iadd(key, key_len)) == 0 { break }
        key_len = key_len + 1
    }
    if key_len >= 4096 { return 0 }

    // Hard cap to avoid hangs if envp is malformed / unterminated.
    var i = 0
    while i < 4096 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { return 0 }

        // Check prefix match "KEY="
        var j = 0
        while j < key_len {
            if ptr_get_byte(iadd(ent, j)) != ptr_get_byte(iadd(key, j)) {
                j = -1
                break
            }
            j = j + 1
        }

        if j != -1 {
            if ptr_get_byte(iadd(ent, key_len)) == 61 { // '='
                return iadd(ent, key_len + 1)
            }
        }

        i = i + 1
    }
    return 0
}

// Portable name used across backends (AVM/C/native).
// Returns a string pointer (value) or nil if not present.
@cap.requires(domain="ENV")
fn oren_env(name) {
    // Copy the returned env value into a tracked heap string so it can safely flow through:
    // - `+` concatenation (`oren_add` only concatenates tracked strings in native mode)
    // - printing (`oren_print` prints tracked strings; otherwise prints as int)
    //
    // `oren_getenv` remains a low-level "view into envp" helper.
    var v = oren_getenv(name)
    if v == 0 { return 0 }
    return oren_string_slice(v, 0, oren_string_len(v))
}
