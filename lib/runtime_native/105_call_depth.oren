// --- Call Depth Guard (stack safety; rolling) ---
//
// Motivation:
// - Deep recursion can overflow the host OS stack non-deterministically.
// - We want a deterministic, tunable failure mode before a hard crash.
//
// Design (v0):
// - A global call-depth counter tracked by compiler-inserted hooks:
//     - `oren_call_depth_enter()` at function/lambda entry
//     - `oren_call_depth_exit()` at function exit / return
// - A configurable maximum:
//     - default: 8192
//     - env override: `OREN_CALL_DEPTH_MAX=<n>` (applied once envp is known)
//
// Notes:
// - This is process-global, not per-thread. That is sufficient for current single-threaded
//   tier-1 bootstrap, but must be upgraded to per-thread tracking for production multithreading.
//   (Tracked in docs/TODOS.md.)

fn native_runtime_call_depth_apply_env() {
    // Apply env override after envp is captured.
    //
    // Any invalid or zero value falls back to default.
    if g_storage == 0 { return 0 }

    var max = ptr_get(iadd(g_storage, 312))
    if max <= 0 { max = 8192 }
    // Rolling safety: if something corrupt writes a ridiculous max, clamp to default.
    if max > 100000000 { max = 8192 }

    var v = native_envp_get_value_ptr("OREN_CALL_DEPTH_MAX")
    if v != 0 {
        var parsed = native_parse_i64_dec_cstr_or_neg1(v)
        if parsed > 0 { max = parsed }
    }
    if max <= 0 { max = 8192 }
    if max > 100000000 { max = 8192 }
    ptr_set(iadd(g_storage, 312), max)
    return 0
}

fn oren_call_depth_enter() {
    // Keep this leaf-like and allocation-free.
    if g_panicking == 1 { return 0 }
    // IMPORTANT:
    // Do not call helpers like `oren_globals()` or `global_get_*` here.
    // The native backend inserts `oren_call_depth_enter()` into *all* functions,
    // including those helpers; calling them here would recurse indefinitely.
    var g = g_storage
    if g == 0 { return 0 }

    // Prefer per-thread call-depth tracking (production direction).
    // Find current thread node based on SP heuristics (same as GC stack scanning).
    var sp = get_sp()
    var node = ptr_get(iadd(g, GLOBAL_OFF_THREADS))
    while node != 0 {
        var top = ptr_get(node)
        if sp < top {
            var diff = top - sp
            // 8MB = 8388608
            if diff < 8388608 {
                // call_depth @ node+24
                var d_ptr2 = iadd(node, 24)
                var d0 = ptr_get(d_ptr2)
                if d0 < 0 { d0 = 0; ptr_set(d_ptr2, 0) }
                if d0 > 100000000 { d0 = 0; ptr_set(d_ptr2, 0) }
                var d = iadd(d0, 1)
                ptr_set(d_ptr2, d)

                var max = ptr_get(iadd(g, 312))
                if max <= 0 { max = 8192 }
                if max > 100000000 { max = 8192 }
                if d > max {
                    g_panicking = 1
                    oren_panic("call depth exceeded")
                }
                return 0
            }
        }
        node = ptr_get(iadd(node, 16))
    }

    // Fallback: if a thread node is not registered yet, track process-global depth.
    // This keeps behavior deterministic in rolling bootstrap stages.
    var d_ptr = iadd(g, 304)
    var d0g = ptr_get(d_ptr)
    if d0g < 0 { d0g = 0; ptr_set(d_ptr, 0) }
    if d0g > 100000000 { d0g = 0; ptr_set(d_ptr, 0) }
    var d2 = iadd(d0g, 1)
    ptr_set(d_ptr, d2)

    var max = ptr_get(iadd(g, 312))
    if max <= 0 { max = 8192 }
    if max > 100000000 { max = 8192 }

    if d2 > max {
        // Disable call-depth checks (and runtime locks) while panicking so diagnostics can print.
        g_panicking = 1
        oren_panic("call depth exceeded")
    }
    return 0
}

fn oren_call_depth_exit() {
    // Keep this leaf-like and allocation-free.
    // Same rule as enter(): no helper calls here (avoid recursion).
    var g = g_storage
    if g == 0 { return 0 }

    // Prefer per-thread call-depth tracking.
    var sp = get_sp()
    var node = ptr_get(iadd(g, GLOBAL_OFF_THREADS))
    while node != 0 {
        var top = ptr_get(node)
        if sp < top {
            var diff = top - sp
            if diff < 8388608 {
                var d_ptr2 = iadd(node, 24)
                var d = ptr_get(d_ptr2)
                if d > 0 { ptr_set(d_ptr2, iadd(d, -1)) }
                return 0
            }
        }
        node = ptr_get(iadd(node, 16))
    }

    // Fallback: process-global depth.
    var d_ptr = iadd(g, 304)
    var d0 = ptr_get(d_ptr)
    if d0 > 0 { ptr_set(d_ptr, iadd(d0, -1)) }
    return 0
}
