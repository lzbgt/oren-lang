// --- Call Depth Guard (stack safety; rolling) ---
//
// Motivation:
// - Deep recursion can overflow the host OS stack non-deterministically.
// - We want a deterministic, tunable failure mode before a hard crash.
//
// Design (v0):
// - A global call-depth counter tracked by compiler-inserted hooks:
//     - `oren_call_depth_enter()` at function/lambda entry
//     - `oren_call_depth_exit()` at function exit / return
// - A configurable maximum:
//     - default: 8192
//     - env override: `OREN_CALL_DEPTH_MAX=<n>` (applied once envp is known)
//
// Notes:
// - This is process-global, not per-thread. That is sufficient for current single-threaded
//   tier-1 bootstrap, but must be upgraded to per-thread tracking for production multithreading.
//   (Tracked in docs/TODOS.md.)

// STW safepoint polling throttle for multi-OS-thread mode (rolling).
//
// Rationale:
// - The compiler inserts `oren_gc_safepoint()` at loop headers, but long-running code can also
//   spend time in call-heavy non-loop paths (parsers, visitors, recursion, etc.).
// - Piggyback on the existing compiler-inserted call-depth hooks so OS threads reach STW
//   safepoints in bounded time even when not in tight loops.
//
// This counter is best-effort and process-global (same as v0 call_depth).
// Once we have production multithreading, this should become per-thread.
var g_call_depth_safepoint_tick = 0

fn native_call_depth_safepoint_poll_throttled() {
    // Keep this leaf-ish and allocation-free. Best-effort only.
    if g_gc_enabled == 0 { return 0 }
    // No STW coordination needed in single-threaded mode.
    if g_runtime_single_threaded == 1 { return 0 }

    // Throttle: poll every 1024 function entries (keeps overhead low).
    var t = g_call_depth_safepoint_tick
    if t < 0 { t = 0 }
    t = iadd(t, 1)
    g_call_depth_safepoint_tick = t
    if (t & 1023) != 0 { return 0 }

    // Poll the STW state word and park if a collector requested it.
    // This is cooperative and only applies once >1 OS thread exists.
    native_gc_stw_poll_and_park()
    return 0
}

fn native_runtime_call_depth_apply_env() {
    // Apply env override after envp is captured.
    //
    // Config contract:
    // - missing/invalid => keep default
    // - 0 => unlimited (disable deterministic call-depth abort)
    if g_storage == 0 { return 0 }

    var max = ptr_get(iadd(g_storage, 312))
    if max < 0 { max = 8192 }
    // Rolling safety: if something corrupt writes a ridiculous max, clamp to default.
    if max > 100000000 { max = 8192 }

    var v = native_envp_get_value_ptr("OREN_CALL_DEPTH_MAX")
    if v != 0 {
        var parsed = native_parse_i64_dec_cstr_or_neg1(v)
        if parsed == 0 { max = 0 }
        else if parsed > 0 { max = parsed }
    }
    if max < 0 { max = 8192 }
    if max > 100000000 { max = 8192 }
    ptr_set(iadd(g_storage, 312), max)
    return 0
}

@oren.keep
fn oren_call_depth_enter() {
    // Keep this leaf-like and allocation-free.
    //
    // IMPORTANT:
    // Do not call helpers like `oren_globals()` or `global_get_*` here.
    // The native backend inserts `oren_call_depth_enter()` into *all* functions,
    // including those helpers; calling them here would recurse indefinitely.
    if g_panicking == 1 { return 0 }
    var g = g_storage
    if g == 0 { return 0 }

    // Multi-OS-thread mode: hit a throttled STW safepoint poll at function entry.
    // This complements loop-header safepoint injection and reduces the risk of long
    // non-loop call-heavy code delaying a stop-the-world request indefinitely.
    native_call_depth_safepoint_poll_throttled()

    // Unlimited mode: skip tracking entirely (no deterministic abort).
    var max0 = ptr_get(iadd(g, 312))
    if max0 == 0 { return 0 }

    // Fast path: compiler-style single-threaded workloads.
    // This avoids scanning thread nodes and keeps stack/register pressure low.
    if g_runtime_single_threaded == 1 {
        var d_ptr = iadd(g, 304)
        var d0 = ptr_get(d_ptr)
        if d0 < 0 { d0 = 0; ptr_set(d_ptr, 0) }
        if d0 > 100000000 { d0 = 0; ptr_set(d_ptr, 0) }
        var d = iadd(d0, 1)
        ptr_set(d_ptr, d)

        var max = max0
        if max < 0 { max = 8192 }
        if max > 100000000 { max = 8192 }
        if d > max {
            // Disable call-depth checks (and runtime locks) while panicking so diagnostics can print.
            g_panicking = 1
            oren_panic("call depth exceeded")
        }
        return 0
    }

    // Slow path: attempt per-thread call-depth tracking via SP heuristics.
    return native_call_depth_enter_slow(g, max0)
}

fn native_call_depth_enter_slow(g, max0) {
    // Prefer per-thread call-depth tracking (production direction).
    // Find current thread node based on SP heuristics (same as GC stack scanning).
    var sp = get_sp()
    // Use literal offsets (native backend global var init/write is still rolling).
    var node = ptr_get(iadd(g, 32)) // threads
    while node != 0 {
        var top = ptr_get(node)
        if sp < top {
            var diff = top - sp
            // 8MB = 8388608
            if diff < 8388608 {
                // call_depth @ node+24
                var d_ptr2 = iadd(node, 24)
                var d0 = ptr_get(d_ptr2)
                if d0 < 0 { d0 = 0; ptr_set(d_ptr2, 0) }
                if d0 > 100000000 { d0 = 0; ptr_set(d_ptr2, 0) }
                var d = iadd(d0, 1)
                ptr_set(d_ptr2, d)

                var max = max0
                if max < 0 { max = 8192 }
                if max > 100000000 { max = 8192 }
                if d > max {
                    g_panicking = 1
                    oren_panic("call depth exceeded")
                }
                return 0
            }
        }
        node = ptr_get(iadd(node, 16))
    }

    // Fallback: if a thread node is not registered yet, track process-global depth.
    var d_ptr = iadd(g, 304)
    var d0g = ptr_get(d_ptr)
    if d0g < 0 { d0g = 0; ptr_set(d_ptr, 0) }
    if d0g > 100000000 { d0g = 0; ptr_set(d_ptr, 0) }
    var d2 = iadd(d0g, 1)
    ptr_set(d_ptr, d2)

    var max = max0
    if max < 0 { max = 8192 }
    if max > 100000000 { max = 8192 }
    if d2 > max {
        g_panicking = 1
        oren_panic("call depth exceeded")
    }
    return 0
}

@oren.keep
fn oren_call_depth_exit() {
    // Keep this leaf-like and allocation-free.
    // Same rule as enter(): no helper calls here (avoid recursion).
    var g = g_storage
    if g == 0 { return 0 }

    // Unlimited mode: we skipped increments; skip decrements too.
    if ptr_get(iadd(g, 312)) == 0 { return 0 }

    // Fast path: single-threaded workloads (process-global depth only).
    if g_runtime_single_threaded == 1 {
        var d_ptr = iadd(g, 304)
        var d0 = ptr_get(d_ptr)
        if d0 > 0 { ptr_set(d_ptr, iadd(d0, -1)) }
        return 0
    }

    return native_call_depth_exit_slow(g)
}

fn native_call_depth_exit_slow(g) {
    // Prefer per-thread call-depth tracking.
    var sp = get_sp()
    var node = ptr_get(iadd(g, 32)) // threads
    while node != 0 {
        var top = ptr_get(node)
        if sp < top {
            var diff = top - sp
            if diff < 8388608 {
                var d_ptr2 = iadd(node, 24)
                var d = ptr_get(d_ptr2)
                if d > 0 { ptr_set(d_ptr2, iadd(d, -1)) }
                return 0
            }
        }
        node = ptr_get(iadd(node, 16))
    }

    // Fallback: process-global depth.
    var d_ptr = iadd(g, 304)
    var d0 = ptr_get(d_ptr)
    if d0 > 0 { ptr_set(d_ptr, iadd(d0, -1)) }
    return 0
}
