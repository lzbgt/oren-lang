fn _list_hdr_ring_put(op, list, kind) {
    if _list_hdr_ring_enabled() != true { return 0 }
    if g_trace_list_hdr_ring_ptr == 0 { return 0 }
    if g_trace_list_hdr_ring_cap <= 0 { return 0 }

    _list_hdr_ring_check_ptr_guard_change(op, list, kind)
    if g_trace_list_hdr_ring_ptr_guard != 0 && g_trace_list_hdr_ring_ptr_guard != 1 {
        var guard_val = g_trace_list_hdr_ring_ptr_guard
        if guard_val > 4096 {
            var allocs = native_gc_ptr_in_allocs(guard_val)
            var free_other = native_free_blocks_count_ptr_in_list(global_free_blocks_ptr(), guard_val)
            print("[list_hdr_ring_ptr_guard_corrupt] val=" + oren_int_to_string(guard_val) +
                  " allocs=" + oren_int_to_string(allocs) +
                  " free_other=" + oren_int_to_string(free_other))
        }
        _list_hdr_ring_set_ptr_guard(0, "corrupt", op, list, kind)
    }

    if g_trace_list_hdr_ring_ptr_guard != 0 && g_storage != 0 {
        if g_trace_list_hdr_ring_ptr == g_storage || g_trace_list_hdr_ring_dup_seen_ptr == g_storage {
            print("[list_hdr_ring_ptr_guard] op=" + oren_int_to_string(op) +
                  " list=" + oren_int_to_string(list) +
                  " kind=" + oren_int_to_string(kind) +
                  " ring_ptr=" + oren_int_to_string(g_trace_list_hdr_ring_ptr) +
                  " dup_seen_ptr=" + oren_int_to_string(g_trace_list_hdr_ring_dup_seen_ptr) +
                  " head=" + oren_int_to_string(g_trace_list_hdr_ring_head) +
                  " dup_seen_head=" + oren_int_to_string(g_trace_list_hdr_ring_dup_seen_head))
            _list_hdr_ring_set_ptr_guard(0, "g_storage", op, list, kind)
        }
    }

    if g_trace_list_hdr_ring_ptr_guard != 0 {
        var dup_head = g_trace_list_hdr_ring_dup_seen_head
        if dup_head > 4294967296 {
            var allocs = native_gc_ptr_in_allocs(dup_head)
            var free_other = native_free_blocks_count_ptr_in_list(global_free_blocks_ptr(), dup_head)
            if allocs > 0 || free_other > 0 {
                print("[list_hdr_ring_dup_seen_head_ptr] head=" + oren_int_to_string(dup_head) +
                      " allocs=" + oren_int_to_string(allocs) +
                      " free_other=" + oren_int_to_string(free_other) +
                      " op=" + oren_int_to_string(op) +
                      " list=" + oren_int_to_string(list) +
                      " kind=" + oren_int_to_string(kind))
                _list_hdr_ring_set_ptr_guard(0, "dup_seen_head_ptr", op, list, kind)
            }
        }
    }
    if list == 0 || list < 4096 { return 0 }
    if op != 1 && op != 2 && op != 3 && op != 4 && op != 5 && op != 6 && op != 7 && op != 8 &&
       op != 9 && op != 10 && op != 11 && op != 12 && op != 90 && op != 91 { return 0 }
    if g_trace_list_hdr_ring_watch_ptr != 0 &&
       g_trace_list_hdr_ring_watch_left > 0 &&
       g_trace_list_hdr_ring_watch_ptr - list == 0 {
        print("[list_hdr_ring_put] list=" + oren_int_to_string(list) +
              " op=" + oren_int_to_string(op) +
              " kind=" + oren_int_to_string(kind) +
              " head=" + oren_int_to_string(g_trace_list_hdr_ring_head) +
              " left=" + oren_int_to_string(g_trace_list_hdr_ring_watch_left))
        g_trace_list_hdr_ring_watch_left = g_trace_list_hdr_ring_watch_left - 1
        if g_trace_list_hdr_ring_watch_left <= 0 {
            g_trace_list_hdr_ring_watch_ptr = 0
        }
    }
    if g_trace_list_hdr_ring_dup != 0 && g_trace_list_hdr_ring_dup_cap > 0 {
        var base = g_trace_list_hdr_ring_ptr
        var i = 0
        var found = 0
        var found_idx = 0
        var found_op = 0
        var found_len = 0
        var found_cap = 0
        var found_buf = 0
        var found_magic = 0
        var found_kind = 0
        while i < g_trace_list_hdr_ring_cap {
            var off = i * 56
            var p = ptr_get(iadd(base, off))
            if p == list {
                found = 1
                found_idx = i
                found_op = ptr_get(iadd(base, off + 8))
                found_len = ptr_get(iadd(base, off + 16))
                found_cap = ptr_get(iadd(base, off + 24))
                found_buf = ptr_get(iadd(base, off + 32))
                found_magic = ptr_get(iadd(base, off + 40))
                found_kind = ptr_get(iadd(base, off + 48))
                break
            }
            i = i + 1
        }
        if found != 0 {
            var dup_seen_ptr = g_trace_list_hdr_ring_dup_seen_ptr
            var dup_seen_cap = g_trace_list_hdr_ring_dup_seen_cap
            var already = 0
            if dup_seen_ptr != 0 && dup_seen_cap > 0 {
                var j = 0
                while j < dup_seen_cap {
                    var seen_ptr = ptr_get(iadd(dup_seen_ptr, j * 8))
                    if seen_ptr == list {
                        already = 1
                        break
                    }
                    j = j + 1
                }
            }
            var do_print = 1
            if already != 0 { do_print = 0 }
            if do_print != 0 {
                g_trace_list_hdr_ring_dup_cap = g_trace_list_hdr_ring_dup_cap - 1
                print("[list_hdr_ring_dup] list=" + oren_int_to_string(list) +
                      " prev_idx=" + oren_int_to_string(found_idx) +
                      " prev_op=" + oren_int_to_string(found_op) +
                      " prev_kind=" + oren_int_to_string(found_kind) +
                      " prev_len=" + oren_int_to_string(found_len) +
                      " prev_cap=" + oren_int_to_string(found_cap) +
                      " prev_buf=" + oren_int_to_string(found_buf) +
                      " prev_magic=" + oren_int_to_string(found_magic) +
                      " new_op=" + oren_int_to_string(op) +
                      " new_kind=" + oren_int_to_string(kind))
                if dup_seen_ptr != 0 && dup_seen_cap > 0 {
                    var insert_idx = g_trace_list_hdr_ring_dup_seen_head % dup_seen_cap
                    ptr_set(iadd(dup_seen_ptr, insert_idx * 8), list)
                    g_trace_list_hdr_ring_dup_seen_head = g_trace_list_hdr_ring_dup_seen_head + 1
                }
            }
        }
    }
    var idx = g_trace_list_hdr_ring_head % g_trace_list_hdr_ring_cap
    var off = idx * 56
    var base = g_trace_list_hdr_ring_ptr
    ptr_set(iadd(base, off), list)
    ptr_set(iadd(base, off + 8), op)
    ptr_set(iadd(base, off + 16), ptr_get(iadd(list, 0)))
    ptr_set(iadd(base, off + 24), ptr_get(iadd(list, 8)))
    ptr_set(iadd(base, off + 32), ptr_get(iadd(list, 16)))
    ptr_set(iadd(base, off + 40), ptr_get(iadd(list, 24)))
    ptr_set(iadd(base, off + 48), kind)
    g_trace_list_hdr_ring_head = g_trace_list_hdr_ring_head + 1
    return 0
}

