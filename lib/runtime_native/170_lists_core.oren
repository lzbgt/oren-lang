@oren.keep
fn native_list_header_ring_dump_last(list, limit) {
    if g_trace_list_hdr_ring_ptr == 0 { return 0 }
    if g_trace_list_hdr_ring_cap <= 0 { return 0 }
    if list == 0 || list < 4096 { return 0 }
    if limit <= 0 { return 0 }
    var cap = g_trace_list_hdr_ring_cap
    var head = g_trace_list_hdr_ring_head
    var base = g_trace_list_hdr_ring_ptr
    var printed = 0
    var step = 0
    while step < cap && printed < limit {
        var idx = head - 1 - step
        if idx < 0 {
            var add = ((-idx) / cap) + 1
            idx = idx + add * cap
        }
        idx = idx - (idx / cap) * cap
        var off = idx * 56
        var p = ptr_get(iadd(base, off))
        if p == list {
            var op = ptr_get(iadd(base, off + 8))
            var len = ptr_get(iadd(base, off + 16))
            var cap_v = ptr_get(iadd(base, off + 24))
            var buf = ptr_get(iadd(base, off + 32))
            var magic = ptr_get(iadd(base, off + 40))
            var kind = ptr_get(iadd(base, off + 48))
            print("[list_hdr_ring_recent] list=" + oren_int_to_string(list) +
                  " idx=" + oren_int_to_string(idx) +
                  " age=" + oren_int_to_string(step) +
                  " op=" + oren_int_to_string(op) +
                  " kind=" + oren_int_to_string(kind) +
                  " len=" + oren_int_to_string(len) +
                  " cap=" + oren_int_to_string(cap_v) +
                  " buf=" + oren_int_to_string(buf) +
                  " magic=" + oren_int_to_string(magic))
            printed = printed + 1
        }
        step = step + 1
    }
    return 0
}

@oren.keep
fn native_list_header_ring_dump_last_pre(list, limit) {
    if g_trace_list_hdr_ring_ptr == 0 { return 0 }
    if g_trace_list_hdr_ring_cap <= 0 { return 0 }
    if list == 0 || list < 4096 { return 0 }
    if limit <= 0 { return 0 }
    var cap = g_trace_list_hdr_ring_cap
    var head = g_trace_list_hdr_ring_head
    var base = g_trace_list_hdr_ring_ptr
    var printed = 0
    var step = 0
    while step < cap && printed < limit {
        var idx = head - 1 - step
        if idx < 0 {
            var add = ((-idx) / cap) + 1
            idx = idx + add * cap
        }
        idx = idx - (idx / cap) * cap
        var off = idx * 56
        var p = ptr_get(iadd(base, off))
        if p == list {
            var op = ptr_get(iadd(base, off + 8))
            var len = ptr_get(iadd(base, off + 16))
            var cap_v = ptr_get(iadd(base, off + 24))
            var buf = ptr_get(iadd(base, off + 32))
            var magic = ptr_get(iadd(base, off + 40))
            var kind = ptr_get(iadd(base, off + 48))
            print("[list_hdr_ring_pre] list=" + oren_int_to_string(list) +
                  " idx=" + oren_int_to_string(idx) +
                  " age=" + oren_int_to_string(step) +
                  " op=" + oren_int_to_string(op) +
                  " kind=" + oren_int_to_string(kind) +
                  " len=" + oren_int_to_string(len) +
                  " cap=" + oren_int_to_string(cap_v) +
                  " buf=" + oren_int_to_string(buf) +
                  " magic=" + oren_int_to_string(magic))
            printed = printed + 1
        }
        step = step + 1
    }
    return 0
}

@oren.keep
fn native_list_header_ring_filter_set(list) {
    g_trace_list_hdr_ring_filter_ptr = list
    return 0
}

@oren.keep
fn native_list_header_ring_dump_all() {
    if g_trace_list_hdr_ring_ptr == 0 { return 0 }
    if g_trace_list_hdr_ring_cap <= 0 { return 0 }
    var base = g_trace_list_hdr_ring_ptr
    var filter_ptr = g_trace_list_hdr_ring_filter_ptr
    var printed = 0
    var i = 0
    while i < g_trace_list_hdr_ring_cap {
        var off = i * 56
        var p = ptr_get(iadd(base, off))
        if p != 0 && (filter_ptr == 0 || p - filter_ptr == 0) {
            var op = ptr_get(iadd(base, off + 8))
            var len = ptr_get(iadd(base, off + 16))
            var cap = ptr_get(iadd(base, off + 24))
            var buf = ptr_get(iadd(base, off + 32))
            var magic = ptr_get(iadd(base, off + 40))
            var kind = ptr_get(iadd(base, off + 48))
            print("[list_hdr_ring] idx=" + oren_int_to_string(i) +
                  " list=" + oren_int_to_string(p) +
                  " op=" + oren_int_to_string(op) +
                  " kind=" + oren_int_to_string(kind) +
                  " len=" + oren_int_to_string(len) +
                  " cap=" + oren_int_to_string(cap) +
                  " buf=" + oren_int_to_string(buf) +
                  " magic=" + oren_int_to_string(magic))
            printed = printed + 1
        }
        i = i + 1
    }
    if filter_ptr != 0 && printed == 0 {
        print("[list_hdr_ring_filter_miss] list=" + oren_int_to_string(filter_ptr))
    }
    if filter_ptr != 0 {
        g_trace_list_hdr_ring_filter_ptr = 0
    }
    return 0
}

@oren.keep
fn native_list_header_ring_enable() {
    _list_hdr_ring_enabled()
    return 0
}

// Force-enable the list header ring for guardrail traces (e.g., reuse bad-list dumps),
// even if the usual env gates were not set.
@oren.keep
fn native_list_header_ring_force_enable() {
    if g_trace_list_hdr_ring_ptr != 0 { return 0 }
    if g_trace_list_hdr_ring_cap <= 0 { g_trace_list_hdr_ring_cap = 4096 }
    var bytes = g_trace_list_hdr_ring_cap * 56
    var buf = native_malloc_raw_or_mmap(bytes)
    if buf == 0 { return 0 }
    var i = 0
    while i < g_trace_list_hdr_ring_cap {
        var off = i * 56
        ptr_set(iadd(buf, off), 0)
        ptr_set(iadd(buf, off + 8), 0)
        ptr_set(iadd(buf, off + 16), 0)
        ptr_set(iadd(buf, off + 24), 0)
        ptr_set(iadd(buf, off + 32), 0)
        ptr_set(iadd(buf, off + 40), 0)
        ptr_set(iadd(buf, off + 48), 0)
        i = i + 1
    }
    g_trace_list_hdr_ring = 1
    g_trace_list_hdr_ring_ptr = buf
    g_trace_list_hdr_ring_head = 0
    return 0
}
fn _list_corrupt_enabled() {
    if g_trace_list_corrupt == 1 { return true }
    if g_trace_list_corrupt == 0 { return false }
    var v = native_envp_get_value_ptr("OREN_TRACE_LIST_CORRUPT")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_list_corrupt == -1 { g_trace_list_corrupt = 0 }
        return false
    }
    g_trace_list_corrupt = 1
    var v_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_CORRUPT_CAP")
    if v_cap != 0 && ptr_get_byte(v_cap) != 0 {
        var cap = oren_int_from_string(v_cap)
        if cap > 0 { g_trace_list_corrupt_cap = cap }
    }
    if g_trace_list_corrupt_cap <= 0 { g_trace_list_corrupt_cap = 128 }
    return true
}

fn _list_corrupt_check(list, stage) {
    if _list_corrupt_enabled() != true { return 0 }
    if g_trace_list_corrupt_cap <= 0 { return 0 }
    if list == 0 || list < 4096 { return 0 }
    var len = ptr_get(iadd(list, 0))
    var cap = ptr_get(iadd(list, 8))
    var buf = ptr_get(iadd(list, 16))
    var magic = ptr_get(iadd(list, 24))
    var bad = 0
    if magic != list_magic() {
        bad = 1
    } else if cap < 0 || len < 0 {
        bad = 1
    } else if cap == 0 {
        if len != 0 { bad = 1 }
        if buf != 0 { bad = 1 }
    } else {
        if buf == 0 || buf < 4096 { bad = 1 }
        if len > cap { bad = 1 }
    }
    if bad == 0 { return 0 }
    g_trace_list_corrupt_cap = g_trace_list_corrupt_cap - 1
    print("trace: list_corrupt stage=" + oren_int_to_string(stage) +
        " list=" + oren_int_to_string(list) +
        " len=" + oren_int_to_string(len) +
        " cap=" + oren_int_to_string(cap) +
        " buf=" + oren_int_to_string(buf) +
        " magic=" + oren_int_to_string(magic))
    native_list_debug_node(list)
    _list_trace_dump(list)
    return 0
}

fn _list_trace_dump(list) {
    if list == 0 || list < 4096 { return 0 }
    print("trace: list_trace_dump list=" + oren_int_to_string(list))
    native_list_debug_node(list)
    trace_list_alloc_ring_dump(list)
    native_list_header_ring_dump(list)
    return 0
}

fn _list_alloc_buf(list, bytes, new_cap, kind, alloc_site, err_code) {
    var use_arena = false
    if native_arena_find_node_nolock(list) != 0 { use_arena = true }
    _list_buf_req_trace_emit(list, kind, new_cap, bytes, use_arena)
    var new_buf = 0
    if use_arena == true {
        new_buf = native_arena_alloc_raw(bytes)
        if new_buf != 0 && new_buf != -1 { native_alloc_site_bump(alloc_site) }
        if new_buf == 0 {
            new_buf = malloc_k(bytes, 0)
            if new_buf != 0 && new_buf != -1 { native_alloc_site_bump(alloc_site) }
        }
    } else {
        new_buf = malloc_k(bytes, 0)
        if new_buf != 0 && new_buf != -1 { native_alloc_site_bump(alloc_site) }
    }
    if new_buf == 0 { exit(err_code) }
    if new_buf == -1 { exit(err_code) }
    if _list_buf_trace_enabled() == true {
        if g_trace_list_buf_cap > 0 {
            g_trace_list_buf_cap = g_trace_list_buf_cap - 1
            var kind = 0
            if list != 0 && list >= 4096 {
                var node = _list_find_node(list)
                if node != 0 { kind = ptr_get(iadd(node, 16)) }
            }
            print("[list_buf] list=" + oren_int_to_string(list) +
                  " kind=" + oren_int_to_string(kind) +
                  " bytes=" + oren_int_to_string(bytes) +
                  " site=" + oren_int_to_string(alloc_site) +
                  " arena=" + oren_int_to_string(use_arena) +
                  " buf=" + oren_int_to_string(new_buf))
        }
    }
    return new_buf
}

fn _list_trace_emit(op, list, kind) {
    if list == 0 || list < 4096 { return 0 }
    _list_hdr_ring_put(op, list, kind)
    if _list_trace_enabled() != true { return 0 }
    if g_trace_list_header_cap <= 0 { return 0 }
    g_trace_list_header_cap = g_trace_list_header_cap - 1
    var len = ptr_get(iadd(list, 0))
    var cap = ptr_get(iadd(list, 8))
    var buf = ptr_get(iadd(list, 16))
    var magic = ptr_get(iadd(list, 24))
    print("[list_hdr] op=" + oren_int_to_string(op) +
        " list=" + oren_int_to_string(list) +
        " kind=" + oren_int_to_string(kind) +
        " len=" + oren_int_to_string(len) +
        " cap=" + oren_int_to_string(cap) +
        " buf=" + oren_int_to_string(buf) +
        " magic=" + oren_int_to_string(magic))
    return 0
}

fn _list_hdr_reinit_trace_emit(list, kind, total, cap, prev_len, prev_cap, prev_buf, prev_magic, src, rec_node) {
    if g_trace_list_hdr_reinit_checked == 0 {
        var v_trace = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_REINIT")
        if v_trace != 0 && ptr_get_byte(v_trace) != 0 && ptr_get_byte(v_trace) != 48 {
            g_trace_list_hdr_reinit = 1
        }
        var v_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_REINIT_CAP")
        if v_cap != 0 {
            var capv = native_parse_i64_dec_cstr_or_neg1(v_cap)
            if capv > 0 { g_trace_list_hdr_reinit_cap = capv }
        }
        var v_ptr = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_REINIT_PTR")
        if v_ptr != 0 {
            var ptrv = native_parse_i64_dec_cstr_or_neg1(v_ptr)
            if ptrv > 0 { g_trace_list_hdr_reinit_ptr = ptrv }
        }
        var v_node = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_REINIT_NODE")
        if v_node != 0 {
            var nodev = native_parse_i64_dec_cstr_or_neg1(v_node)
            if nodev > 0 { g_trace_list_hdr_reinit_node = nodev }
        }
        if g_trace_list_hdr_reinit_cap <= 0 { g_trace_list_hdr_reinit_cap = 8 }
        g_trace_list_hdr_reinit_checked = 1
    }
    if g_trace_list_hdr_reinit == 0 { return 0 }
    if g_trace_list_hdr_reinit_cap <= 0 { return 0 }
    var seen = 0
    if g_trace_freed_lists != 0 {
        seen = native_gc_freed_list_seen(list)
    }
    var want_poison = list_magic_poison()
    var want_magic = list_magic()
    var node = rec_node
    if node == 0 { node = native_alloc_index_get(list) }
    if g_trace_list_hdr_reinit_ptr != 0 && list - g_trace_list_hdr_reinit_ptr != 0 { return 0 }
    if g_trace_list_hdr_reinit_node != 0 && node - g_trace_list_hdr_reinit_node != 0 { return 0 }
    if g_trace_list_hdr_reinit_ptr == 0 && g_trace_list_hdr_reinit_node == 0 {
        if node == 0 && seen == 0 && prev_magic - want_poison != 0 && prev_magic - want_magic != 0 { return 0 }
    }
    g_trace_list_hdr_reinit_cap = g_trace_list_hdr_reinit_cap - 1
    print("[list_hdr_reinit] src=" + src +
          " ptr=" + oren_int_to_string(list) +
          " kind=" + oren_int_to_string(kind) +
          " total=" + oren_int_to_string(total) +
          " cap=" + oren_int_to_string(cap) +
          " prev_len=" + oren_int_to_string(prev_len) +
          " prev_cap=" + oren_int_to_string(prev_cap) +
          " prev_buf=" + oren_int_to_string(prev_buf) +
          " prev_magic=" + oren_int_to_string(prev_magic) +
          " freed_seen=" + oren_int_to_string(seen) +
          " node=" + oren_int_to_string(node))
    return 0
}

fn _list_ctor_trace_emit(stage, list, kind, total, cap_req, node) {
    if g_trace_list_ctor_checked == 0 {
        var v_trace = native_envp_get_value_ptr("OREN_TRACE_LIST_CTOR")
        if v_trace != 0 && ptr_get_byte(v_trace) != 0 && ptr_get_byte(v_trace) != 48 {
            g_trace_list_ctor = 1
        }
        var v_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_CTOR_CAP")
        if v_cap != 0 {
            var capv = native_parse_i64_dec_cstr_or_neg1(v_cap)
            if capv > 0 { g_trace_list_ctor_cap = capv }
        }
        var v_ptr = native_envp_get_value_ptr("OREN_TRACE_LIST_CTOR_PTR")
        if v_ptr != 0 {
            var ptrv = native_parse_i64_dec_cstr_or_neg1(v_ptr)
            if ptrv > 0 { g_trace_list_ctor_ptr = ptrv }
        }
        var v_node = native_envp_get_value_ptr("OREN_TRACE_LIST_CTOR_NODE")
        if v_node != 0 {
            var nodev = native_parse_i64_dec_cstr_or_neg1(v_node)
            if nodev > 0 { g_trace_list_ctor_node = nodev }
        }
        if g_trace_list_ctor_cap <= 0 { g_trace_list_ctor_cap = 16 }
        g_trace_list_ctor_checked = 1
    }
    if g_trace_list_ctor == 0 { return 0 }
    if g_trace_list_ctor_cap <= 0 { return 0 }
    if g_trace_list_ctor_ptr != 0 && list - g_trace_list_ctor_ptr != 0 { return 0 }
    if g_trace_list_ctor_node != 0 && node - g_trace_list_ctor_node != 0 { return 0 }
    g_trace_list_ctor_cap = g_trace_list_ctor_cap - 1
    var len = ptr_get(iadd(list, 0))
    var cap = ptr_get(iadd(list, 8))
    var buf = ptr_get(iadd(list, 16))
    var magic = ptr_get(iadd(list, 24))
    print("[list_ctor] stage=" + stage +
          " ptr=" + oren_int_to_string(list) +
          " kind=" + oren_int_to_string(kind) +
          " total=" + oren_int_to_string(total) +
          " cap_req=" + oren_int_to_string(cap_req) +
          " len=" + oren_int_to_string(len) +
          " cap=" + oren_int_to_string(cap) +
          " buf=" + oren_int_to_string(buf) +
          " magic=" + oren_int_to_string(magic) +
          " node=" + oren_int_to_string(node))
    return 0
}

@oren.keep
fn oren_trace_list_header(list, op, kind) {
    return _list_trace_emit(op, list, kind)
}
