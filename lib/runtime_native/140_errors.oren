// --- Structured errors (rolling, portable) ---
// Convention matches C/AVM:
//   error = map {"__err": true, "code": int, "msg": string}
//
// NOTE (native v0 representation):
// Values are not fully tagged at runtime, so `oren_is_err` must be safe for arbitrary integers.
// This convention uses a tagged map pointer (map_magic) so `oren_is_err` can discriminate reliably
// without probing memory at untracked/non-pointer values.
fn oren_err(code, msg) {
    var m = oren_new_map(8)
    oren_map_set_str(m, "__err", 1)
    oren_map_set_str(m, "code", code)
    oren_map_set_str(m, "msg", msg)
    return m
}

fn oren_is_err(v) {
    // Safe for arbitrary ints:
    // - integers can be >= 4096 (e.g. 16909060), so we must NOT probe memory
    //   at `v+24` unless `v` is a tracked heap pointer.
    if v == 0 { return false }
    var node = oren_find_node(v)
    if node == 0 { return false }
    // Prevent false positives: strings/lists/bufs are also tracked heap pointers, but do not
    // share the map header layout. Only maps (kind=3) can be structured errors.
    if ptr_get(iadd(node, 16)) != 3 { return false }
    if ptr_get(v + 24) != map_magic() { return false }
    var marker = oren_map_get_str(v, "__err")
    // Missing key returns `nil` under the native backend (singleton pointer), not integer 0.
    if marker == nil { return false }
    return true
}

fn oren_err_code(v) {
    if oren_is_err(v) != true { return -1 }
    return oren_map_get_str(v, "code")
}

fn oren_err_msg(v) {
    if oren_is_err(v) != true { return nil }
    return oren_map_get_str(v, "msg")
}
