// --- SHA-256 (compiler/runtime utility) ---
//
// Implemented here (in Oren) so the native backend can self-host without libc.
//
// Kept in a separate file so smaller runtime profiles (e.g. `lib/runtime_native_core.oren`)
// can exclude it to keep cold runtime-object builds bounded.

fn sha256_u32(x) { return x & 4294967295 }

fn sha256_rotr32(x, n) {
    // x is treated as an unsigned 32-bit value carried in an int (0..2^32-1).
    return sha256_u32((x >> n) | ((x << (32 - n)) & 4294967295))
}

fn sha256_ch(x, y, z) {
    // (x & y) ^ (~x & z), with ~ constrained to 32 bits.
    var nx = x ^ 4294967295
    return sha256_u32((x & y) ^ (nx & z))
}

fn sha256_maj(x, y, z) {
    return sha256_u32((x & y) ^ (x & z) ^ (y & z))
}

fn sha256_big_s0(x) { return sha256_u32(sha256_rotr32(x, 2) ^ sha256_rotr32(x, 13) ^ sha256_rotr32(x, 22)) }
fn sha256_big_s1(x) { return sha256_u32(sha256_rotr32(x, 6) ^ sha256_rotr32(x, 11) ^ sha256_rotr32(x, 25)) }
fn sha256_small_s0(x) { return sha256_u32(sha256_rotr32(x, 7) ^ sha256_rotr32(x, 18) ^ (x >> 3)) }
fn sha256_small_s1(x) { return sha256_u32(sha256_rotr32(x, 17) ^ sha256_rotr32(x, 19) ^ (x >> 10)) }

fn sha256_k_init(k) {
    // SHA-256 round constants (first 32 bits of the fractional parts of the cube roots of the first 64 primes).
    //
    // Stored as u32 values in 8-byte slots (ptr_set/ptr_get) for fast access in native mode.
    ptr_set(k + 0 * 8, 1116352408);  ptr_set(k + 1 * 8, 1899447441);  ptr_set(k + 2 * 8, 3049323471);  ptr_set(k + 3 * 8, 3921009573)
    ptr_set(k + 4 * 8, 961987163);   ptr_set(k + 5 * 8, 1508970993);  ptr_set(k + 6 * 8, 2453635748);  ptr_set(k + 7 * 8, 2870763221)
    ptr_set(k + 8 * 8, 3624381080);  ptr_set(k + 9 * 8, 310598401);   ptr_set(k + 10 * 8, 607225278);  ptr_set(k + 11 * 8, 1426881987)
    ptr_set(k + 12 * 8, 1925078388); ptr_set(k + 13 * 8, 2162078206); ptr_set(k + 14 * 8, 2614888103); ptr_set(k + 15 * 8, 3248222580)
    ptr_set(k + 16 * 8, 3835390401); ptr_set(k + 17 * 8, 4022224774); ptr_set(k + 18 * 8, 264347078);  ptr_set(k + 19 * 8, 604807628)
    ptr_set(k + 20 * 8, 770255983);  ptr_set(k + 21 * 8, 1249150122); ptr_set(k + 22 * 8, 1555081692); ptr_set(k + 23 * 8, 1996064986)
    ptr_set(k + 24 * 8, 2554220882); ptr_set(k + 25 * 8, 2821834349); ptr_set(k + 26 * 8, 2952996808); ptr_set(k + 27 * 8, 3210313671)
    ptr_set(k + 28 * 8, 3336571891); ptr_set(k + 29 * 8, 3584528711); ptr_set(k + 30 * 8, 113926993);  ptr_set(k + 31 * 8, 338241895)
    ptr_set(k + 32 * 8, 666307205);  ptr_set(k + 33 * 8, 773529912);  ptr_set(k + 34 * 8, 1294757372); ptr_set(k + 35 * 8, 1396182291)
    ptr_set(k + 36 * 8, 1695183700); ptr_set(k + 37 * 8, 1986661051); ptr_set(k + 38 * 8, 2177026350); ptr_set(k + 39 * 8, 2456956037)
    ptr_set(k + 40 * 8, 2730485921); ptr_set(k + 41 * 8, 2820302411); ptr_set(k + 42 * 8, 3259730800); ptr_set(k + 43 * 8, 3345764771)
    ptr_set(k + 44 * 8, 3516065817); ptr_set(k + 45 * 8, 3600352804); ptr_set(k + 46 * 8, 4094571909); ptr_set(k + 47 * 8, 275423344)
    ptr_set(k + 48 * 8, 430227734);  ptr_set(k + 49 * 8, 506948616);  ptr_set(k + 50 * 8, 659060556);  ptr_set(k + 51 * 8, 883997877)
    ptr_set(k + 52 * 8, 958139571);  ptr_set(k + 53 * 8, 1322822218); ptr_set(k + 54 * 8, 1537002063); ptr_set(k + 55 * 8, 1747873779)
    ptr_set(k + 56 * 8, 1955562222); ptr_set(k + 57 * 8, 2024104815); ptr_set(k + 58 * 8, 2227730452); ptr_set(k + 59 * 8, 2361852424)
    ptr_set(k + 60 * 8, 2428436474); ptr_set(k + 61 * 8, 2756734187); ptr_set(k + 62 * 8, 3204031479); ptr_set(k + 63 * 8, 3329325298)
    return 0
}

fn sha256_transform(state_ptr, data_ptr, k_ptr, w_ptr) {
    // state_ptr points to 8 u32 values in 8-byte slots.
    // data_ptr points to 64 bytes.
    // k_ptr points to 64 u32 constants in 8-byte slots.
    // w_ptr points to 64 u32 words in 8-byte slots (scratch).

    // Message schedule W[0..63]
    var i = 0
    while i < 16 {
        var j = i * 4
        var b0 = ptr_get_byte(data_ptr + j + 0) & 255
        var b1 = ptr_get_byte(data_ptr + j + 1) & 255
        var b2 = ptr_get_byte(data_ptr + j + 2) & 255
        var b3 = ptr_get_byte(data_ptr + j + 3) & 255
        var u = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        ptr_set(w_ptr + i * 8, sha256_u32(u))
        i = i + 1
    }
    while i < 64 {
        var w15 = ptr_get(w_ptr + (i - 15) * 8)
        var w2 = ptr_get(w_ptr + (i - 2) * 8)
        var s0 = sha256_small_s0(w15)
        var s1 = sha256_small_s1(w2)
        var wi = sha256_u32(ptr_get(w_ptr + (i - 16) * 8) + s0 + ptr_get(w_ptr + (i - 7) * 8) + s1)
        ptr_set(w_ptr + i * 8, wi)
        i = i + 1
    }

    // Working variables
    var a = ptr_get(state_ptr + 0 * 8)
    var b = ptr_get(state_ptr + 1 * 8)
    var c = ptr_get(state_ptr + 2 * 8)
    var d = ptr_get(state_ptr + 3 * 8)
    var e = ptr_get(state_ptr + 4 * 8)
    var f = ptr_get(state_ptr + 5 * 8)
    var g = ptr_get(state_ptr + 6 * 8)
    var h = ptr_get(state_ptr + 7 * 8)

    i = 0
    while i < 64 {
        var t1 = sha256_u32(h + sha256_big_s1(e) + sha256_ch(e, f, g) + ptr_get(k_ptr + i * 8) + ptr_get(w_ptr + i * 8))
        var t2 = sha256_u32(sha256_big_s0(a) + sha256_maj(a, b, c))
        h = g
        g = f
        f = e
        e = sha256_u32(d + t1)
        d = c
        c = b
        b = a
        a = sha256_u32(t1 + t2)
        i = i + 1
    }

    // Add the compressed chunk to the current hash value
    ptr_set(state_ptr + 0 * 8, sha256_u32(ptr_get(state_ptr + 0 * 8) + a))
    ptr_set(state_ptr + 1 * 8, sha256_u32(ptr_get(state_ptr + 1 * 8) + b))
    ptr_set(state_ptr + 2 * 8, sha256_u32(ptr_get(state_ptr + 2 * 8) + c))
    ptr_set(state_ptr + 3 * 8, sha256_u32(ptr_get(state_ptr + 3 * 8) + d))
    ptr_set(state_ptr + 4 * 8, sha256_u32(ptr_get(state_ptr + 4 * 8) + e))
    ptr_set(state_ptr + 5 * 8, sha256_u32(ptr_get(state_ptr + 5 * 8) + f))
    ptr_set(state_ptr + 6 * 8, sha256_u32(ptr_get(state_ptr + 6 * 8) + g))
    ptr_set(state_ptr + 7 * 8, sha256_u32(ptr_get(state_ptr + 7 * 8) + h))
    return 0
}

fn oren_sha256_range(bytes, start, length) {
    if bytes == nil || bytes == 0 { oren_panic("sha256_range expects bytes") }
    // NOTE (native backend / rolling semantics):
    // Treat `start`/`length` as required integers and validate via numeric bounds below.
    // Avoid `== nil` checks on numeric inputs; use a type/tag check instead.
    if oren_type_tag(start) != 1 || oren_type_tag(length) != 1 { oren_panic("sha256_range: start/length must be int") }
    if start < 0 || length < 0 { oren_panic("sha256_range: negative range") }

    var n_total = oren_bytes_len(bytes)
    if oren_is_err(n_total) { oren_panic("sha256_range expects list<int> or u8_buf") }
    if start + length > n_total { oren_panic("sha256_range: out of bounds") }

    // Allocate state + scratch (freed before return).
    var state = malloc(8 * 8)
    var data = malloc(64)
    var k = malloc(64 * 8)
    var w = malloc(64 * 8)
    if state == 0 || data == 0 || k == 0 || w == 0 { oren_panic("sha256_range: alloc failed") }
    sha256_k_init(k)

    // Initial hash values (SHA-256 IV).
    ptr_set(state + 0 * 8, 1779033703)
    ptr_set(state + 1 * 8, 3144134277)
    ptr_set(state + 2 * 8, 1013904242)
    ptr_set(state + 3 * 8, 2773480762)
    ptr_set(state + 4 * 8, 1359893119)
    ptr_set(state + 5 * 8, 2600822924)
    ptr_set(state + 6 * 8, 528734635)
    ptr_set(state + 7 * 8, 1541459225)

    // Fast path: avoid per-byte dynamic checks by handling list/u8_buf directly.
    var is_list = native_bytes_is_list(bytes)
    var is_u8buf = false
    var list_buf = 0
    var buf_ptr = 0
    if is_list != true {
        is_u8buf = native_bytes_is_u8_buf(bytes)
    }
    if is_list == true {
        list_buf = ptr_get(bytes + 16)
        if list_buf == 0 { oren_panic("sha256_range: list buffer is nil") }
    } else {
        if is_u8buf == true {
            buf_ptr = native_buf_data_ptr(bytes)
            if buf_ptr == 0 { oren_panic("sha256_range: buf payload is nil") }
        } else {
            oren_panic("sha256_range expects list<int 0..255> or u8_buf")
        }
    }

    // Hash full 64-byte blocks first to avoid per-byte loop overhead on large inputs
    // (critical for compiler build cache: hashing compiler binaries + expanded runtime bundles).
    var off = 0
    if is_list != true {
        // u8_buf: contiguous bytes (fast path).
        var src_ptr = iadd(buf_ptr, start)
        while off + 64 <= length {
            sha256_transform(state, iadd(src_ptr, off), k, w)
            off = off + 64
        }
        // Copy remainder (<64) into `data` for padding+final block.
        var rem = length - off
        var i = 0
        while i < rem {
            ptr_set_byte(data + i, ptr_get_byte(iadd(src_ptr, off + i)) & 255)
            i = i + 1
        }
        // Pad: append 0x80, then zeros, then big-endian bit length.
        var bitlen = length * 8
        ptr_set_byte(data + rem, 128)
        var used = rem + 1
        if used > 56 {
            while used < 64 { ptr_set_byte(data + used, 0); used = used + 1 }
            sha256_transform(state, data, k, w)
            used = 0
        }
        while used < 56 { ptr_set_byte(data + used, 0); used = used + 1 }
        // Store bitlen as big-endian u64 at data[56..63].
        ptr_set_byte(data + 63, (bitlen >> 0) & 255)
        ptr_set_byte(data + 62, (bitlen >> 8) & 255)
        ptr_set_byte(data + 61, (bitlen >> 16) & 255)
        ptr_set_byte(data + 60, (bitlen >> 24) & 255)
        ptr_set_byte(data + 59, (bitlen >> 32) & 255)
        ptr_set_byte(data + 58, (bitlen >> 40) & 255)
        ptr_set_byte(data + 57, (bitlen >> 48) & 255)
        ptr_set_byte(data + 56, (bitlen >> 56) & 255)
        sha256_transform(state, data, k, w)
    } else {
        // list<int>: build 64-byte blocks in `data`, then transform.
        while off + 64 <= length {
            var j = 0
            while j < 64 {
                var byte = ptr_get(list_buf + (start + off + j) * 8)
                if byte < 0 || byte > 255 { oren_panic("sha256_range: byte out of range") }
                ptr_set_byte(data + j, byte)
                j = j + 1
            }
            sha256_transform(state, data, k, w)
            off = off + 64
        }
        var rem2 = length - off
        var k0 = 0
        while k0 < rem2 {
            var byte2 = ptr_get(list_buf + (start + off + k0) * 8)
            if byte2 < 0 || byte2 > 255 { oren_panic("sha256_range: byte out of range") }
            ptr_set_byte(data + k0, byte2)
            k0 = k0 + 1
        }
        var bitlen2 = length * 8
        ptr_set_byte(data + rem2, 128)
        var used2 = rem2 + 1
        if used2 > 56 {
            while used2 < 64 { ptr_set_byte(data + used2, 0); used2 = used2 + 1 }
            sha256_transform(state, data, k, w)
            used2 = 0
        }
        while used2 < 56 { ptr_set_byte(data + used2, 0); used2 = used2 + 1 }
        ptr_set_byte(data + 63, (bitlen2 >> 0) & 255)
        ptr_set_byte(data + 62, (bitlen2 >> 8) & 255)
        ptr_set_byte(data + 61, (bitlen2 >> 16) & 255)
        ptr_set_byte(data + 60, (bitlen2 >> 24) & 255)
        ptr_set_byte(data + 59, (bitlen2 >> 32) & 255)
        ptr_set_byte(data + 58, (bitlen2 >> 40) & 255)
        ptr_set_byte(data + 57, (bitlen2 >> 48) & 255)
        ptr_set_byte(data + 56, (bitlen2 >> 56) & 255)
        sha256_transform(state, data, k, w)
    }

    // Produce digest bytes in big-endian word order.
    var out = oren_new_list(0)
    var wi = 0
    while wi < 8 {
        var v = ptr_get(state + wi * 8)
        oren_list_push(out, (v >> 24) & 255)
        oren_list_push(out, (v >> 16) & 255)
        oren_list_push(out, (v >> 8) & 255)
        oren_list_push(out, v & 255)
        wi = wi + 1
    }

    free(w)
    free(k)
    free(data)
    free(state)
    return out
}

fn oren_sha256_string(s) {
    if s == 0 { oren_panic("sha256_string expects string") }
    // IMPORTANT: use `oren_string_len` (unbounded) rather than `native_cstr_len` (capped),
    // otherwise long source strings (>64KB) would truncate and cause cache key collisions.
    var n = oren_string_len(s)
    // Hash the string's bytes (excluding NUL terminator) without building a list<int> first.
    //
    // This is important for toolchain workloads that hash many large sources (build cache keys).
    // Avoiding `oren_bytes_from_string` keeps allocations and GC pressure bounded.
    var state = malloc(8 * 8)
    var data = malloc(64)
    var k = malloc(64 * 8)
    var w = malloc(64 * 8)
    if state == 0 || data == 0 || k == 0 || w == 0 { oren_panic("sha256_string: alloc failed") }
    sha256_k_init(k)

    // Initialize state (same IV as sha256_range).
    ptr_set(state + 0 * 8, 1779033703)
    ptr_set(state + 1 * 8, 3144134277)
    ptr_set(state + 2 * 8, 1013904242)
    ptr_set(state + 3 * 8, 2773480762)
    ptr_set(state + 4 * 8, 1359893119)
    ptr_set(state + 5 * 8, 2600822924)
    ptr_set(state + 6 * 8, 528734635)
    ptr_set(state + 7 * 8, 1541459225)

    // Hash full blocks directly from the string memory to avoid per-byte copy overhead.
    var off = 0
    while off + 64 <= n {
        sha256_transform(state, iadd(s, off), k, w)
        off = off + 64
    }
    var rem = n - off
    var i = 0
    while i < rem {
        ptr_set_byte(data + i, ptr_get_byte(iadd(s, off + i)) & 255)
        i = i + 1
    }

    // Pad: append 0x80, then zeros, then 64-bit bitlen in big-endian.
    var bitlen = n * 8
    ptr_set_byte(data + rem, 128)
    var used = rem + 1
    if used > 56 {
        while used < 64 { ptr_set_byte(data + used, 0); used = used + 1 }
        sha256_transform(state, data, k, w)
        used = 0
    }
    while used < 56 { ptr_set_byte(data + used, 0); used = used + 1 }
    // 64-bit length big-endian at data[56..63].
    var j = 0
    while j < 8 {
        var shift = (7 - j) * 8
        var b = (bitlen >> shift) & 255
        ptr_set_byte(data + 56 + j, b)
        j = j + 1
    }
    sha256_transform(state, data, k, w)

    // Emit digest bytes list<int 0..255> (32 bytes).
    var out = oren_new_list(32)
    var di = 0
    while di < 32 {
        var word = ptr_get(state + (di / 4) * 8) & 4294967295
        var off = (3 - (di & 3)) * 8
        var byte = (word >> off) & 255
        oren_list_push(out, byte)
        di = di + 1
    }

    // Free temporary buffers to keep allocs list small even when GC is disabled.
    free(state)
    free(data)
    free(k)
    free(w)

    return out
}
