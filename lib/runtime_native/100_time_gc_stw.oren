// --- Stop-the-world (STW) GC safepoints (native runtime; rolling) ---
//
// Goal:
// - Make `oren_gc_collect()` safe once more than one OS thread exists.
//
// Design constraints (Tier‑1):
// - Must be libc-free and cross-platform (uses `oren_wait_on_addr` / `oren_wake_all_addr`).
// - Must not require a full M:N scheduler yet; this is a minimal "park at safepoints" protocol.
//
// Globals storage layout (see `lib/runtime_native/010_channels_globals_consts.oren`):
// - 424: gc_stw_state       (0=running, 1=stop requested, 2=collector preparing)
// - 432: gc_stw_parked      (number of parked OS threads excluding collector)
// - 440: gc_stw_owner_node  (Thread Node pointer of collector, best-effort)
fn native_gc_stw_state_ptr() {
    var g = oren_globals()
    if g == 0 { return 0 }
    return iadd(g, 424)
}
fn native_gc_stw_parked_ptr() {
    var g = oren_globals()
    if g == 0 { return 0 }
    return iadd(g, 432)
}
fn native_gc_stw_owner_ptr() {
    var g = oren_globals()
    if g == 0 { return 0 }
    return iadd(g, 440)
}

fn native_atomic_inc_u64(word_ptr) {
    if word_ptr == 0 { return 0 }
    while true {
        var old = ptr_get(word_ptr)
        var new = iadd(old, 1)
        if atomic_cas(word_ptr, old, new) == old { return new }
    }
    return 0
}

fn native_atomic_load_u64(word_ptr) {
    if word_ptr == 0 { return 0 }
    // Best-effort atomic load (CAS 0->0).
    return atomic_cas(word_ptr, 0, 0)
}

fn native_gc_stw_begin() {
    if oren_globals() == 0 { return 0 }
    var trace = native_envp_get_value_ptr("OREN_TRACE_GC_STW")
    var trace_on = 0
    if trace != 0 && ptr_get_byte(trace) != 0 { trace_on = 1 }
    var trace_waiters = native_envp_get_value_ptr("OREN_TRACE_GC_STW_WAITERS")
    var trace_waiters_on = 0
    if trace_waiters != 0 && ptr_get_byte(trace_waiters) != 0 { trace_waiters_on = 1 }
    var stw_ptr = native_gc_stw_state_ptr()
    var parked_ptr = native_gc_stw_parked_ptr()
    var owner_ptr = native_gc_stw_owner_ptr()
    if stw_ptr == 0 || parked_ptr == 0 || owner_ptr == 0 { return 0 }

    // Claim the STW controller role:
    // - CAS 0->2 ("preparing") so other threads do not park yet (avoids losing parked-count increments).
    // - If another collector is active, wait until the word changes.
    while true {
        var s = ptr_get(stw_ptr)
        if s == 0 {
            if atomic_cas(stw_ptr, 0, 2) == 0 { break }
            continue
        }
        // Best-effort: sleep while state is unchanged.
        oren_wait_on_addr(stw_ptr, s, 1000000)
    }

    // Initialize per-collection coordination state.
    ptr_set(parked_ptr, 0)
    // Identify the collector thread so it does NOT park at safepoints during STW.
    //
    // Why this is required (Tier‑1 correctness):
    // The native backend inserts `oren_gc_safepoint()` into loop headers for long-running
    // compiler/tooling workloads. `native_gc_collect()` (and its helpers like stack scanning)
    // contains loops, so the collector thread can hit an injected safepoint while STW is active.
    //
    // If the collector parks itself (owner not set), STW deadlocks permanently.
    //
    // Robustness:
    // - Prefer the per-OS-thread `sys_gettid()` identity path in `native_time_current_thread_node_or0()`.
    // - If the main thread is not registered yet, register it now (idempotent on Tier‑1).
    var owner_node = native_time_current_thread_node_or0()
    if owner_node == 0 {
        owner_node = oren_register_thread(get_sp())
    }
    ptr_set(owner_ptr, owner_node)

    // Publish the stop request (2->1) and wake threads waiting on the state word.
    ptr_set(stw_ptr, 1)
    oren_wake_all_addr(stw_ptr)
    // If any green worker OS thread is blocked inside the netpoll readiness wait,
    // break it out immediately so it can observe STW and park.
    //
    // Without this, worker-mode scheduling would have to poll with a short timeout (10ms),
    // wasting CPU and adding tail latency to GC pauses.
    native_netpoll_wake()

    // Wait for all other *live* OS threads to park.
    //
    // NOTE (rolling correctness): `oren_register_thread` is idempotent and a thread node can outlive
    // the OS thread itself (nodes are mmap-backed metadata and are not GC-managed). If we relied on a
    // monotonically-increasing "threads ever registered" counter, STW would deadlock after a thread exits.
    //
    // Instead, count only OS-thread nodes that are not marked DEAD, and exclude the collector itself.
    var expected = native_gc_stw_expected_parked_count(owner_node)
    if trace_on != 0 {
        print("trace: gc_stw_begin owner=" + oren_int_to_string(owner_node) +
              " expected=" + oren_int_to_string(expected))
    }

    var waits = 0
    while expected > 0 {
        var cur = native_atomic_load_u64(parked_ptr)
        if cur >= expected { break }
        // Wait until parked count changes (threads wake us when they park).
        oren_wait_on_addr(parked_ptr, cur, 1000000)
        waits = waits + 1
        if trace_waiters_on != 0 {
            var cur2 = native_atomic_load_u64(parked_ptr)
            if cur2 < expected {
                if waits <= 2 || (waits % 5) == 0 {
                    native_gc_stw_trace_waiters(owner_node, cur2, expected, waits)
                }
            }
        }
    }

    // Ensure parked threads have published saved_sp before GC scans stacks.
    if expected > 0 {
        var THREAD_NODE_FLAG_OS_THREAD = 1
        var THREAD_NODE_FLAG_DEAD = 4
        var cur2 = global_get_threads()
        while cur2 != 0 {
            var flags2 = ptr_get(iadd(cur2, 48))
            if (flags2 & THREAD_NODE_FLAG_OS_THREAD) != 0 {
                if (flags2 & THREAD_NODE_FLAG_DEAD) == 0 {
                    if owner_node == 0 || cur2 - owner_node != 0 {
                        var saved_ptr = iadd(cur2, 80)
                        var saved = ptr_get(saved_ptr)
                        var sched_saved = ptr_get(iadd(cur2, 72))
                        var backup_saved = ptr_get(iadd(cur2, 8))
                        var stack_size = ptr_get(iadd(cur2, 88))
                        var ready = 0
                        if saved != 0 || sched_saved != 0 || backup_saved != 0 || stack_size != 0 { ready = 1 }
                        var tries = 0
                        while ready == 0 && tries < 200 {
                            oren_wait_on_addr(saved_ptr, 0, 1000)
                            saved = ptr_get(saved_ptr)
                            sched_saved = ptr_get(iadd(cur2, 72))
                            backup_saved = ptr_get(iadd(cur2, 8))
                            stack_size = ptr_get(iadd(cur2, 88))
                            if saved != 0 || sched_saved != 0 || backup_saved != 0 || stack_size != 0 { ready = 1 }
                            tries = tries + 1
                        }
                        if trace_on != 0 && ready == 0 {
                            var node_tid0 = ptr_get(iadd(cur2, 56))
                            print("trace: gc_stw_saved_timeout node=" + oren_int_to_string(cur2) +
                                  " tid=" + oren_int_to_string(node_tid0) +
                                  " sched=" + oren_int_to_string(sched_saved) +
                                  " backup=" + oren_int_to_string(backup_saved) +
                                  " stack_size=" + oren_int_to_string(stack_size))
                        }
                    }
                }
            }
            cur2 = ptr_get(iadd(cur2, 16))
        }
    }
    return 0
}

fn native_gc_stw_expected_parked_count(owner_node) {
    if oren_globals() == 0 { return 0 }
    var THREAD_NODE_FLAG_OS_THREAD = 1
    var THREAD_NODE_FLAG_DEAD = 4

    if g_runtime_single_threaded == 0 { acquire_lock() }
    var cur = global_get_threads()
    var n = 0
    while cur != 0 {
        var flags = ptr_get(iadd(cur, 48))
        if (flags & THREAD_NODE_FLAG_OS_THREAD) != 0 {
            if (flags & THREAD_NODE_FLAG_DEAD) == 0 {
                if owner_node == 0 || cur - owner_node != 0 {
                    n = n + 1
                }
            }
        }
        cur = ptr_get(iadd(cur, 16))
    }
    if g_runtime_single_threaded == 0 { release_lock() }
    return n
}

fn native_gc_stw_trace_waiters(owner_node, parked, expected, waits) {
    var THREAD_NODE_FLAG_OS_THREAD = 1
    var THREAD_NODE_FLAG_STW_PARKED = 2
    var THREAD_NODE_FLAG_DEAD = 4
    print("trace: gc_stw_wait parked=" + oren_int_to_string(parked) +
          " expected=" + oren_int_to_string(expected) +
          " waits=" + oren_int_to_string(waits))
    var cur = global_get_threads()
    while cur != 0 {
        var flags = ptr_get(iadd(cur, 48))
        if (flags & THREAD_NODE_FLAG_OS_THREAD) != 0 &&
           (flags & THREAD_NODE_FLAG_DEAD) == 0 &&
           (owner_node == 0 || cur - owner_node != 0) &&
           (flags & THREAD_NODE_FLAG_STW_PARKED) == 0 {
            var tid = ptr_get(iadd(cur, 56))
            var saved = ptr_get(iadd(cur, 80))
            var backup_saved = ptr_get(iadd(cur, 8))
            var sched_saved = ptr_get(iadd(cur, 72))
            var stack_size = ptr_get(iadd(cur, 88))
            print("trace: gc_stw_waiter node=" + oren_int_to_string(cur) +
                  " tid=" + oren_int_to_string(tid) +
                  " flags=" + oren_int_to_string(flags) +
                  " saved=" + oren_int_to_string(saved) +
                  " backup=" + oren_int_to_string(backup_saved) +
                  " sched=" + oren_int_to_string(sched_saved) +
                  " stack_size=" + oren_int_to_string(stack_size))
        }
        cur = ptr_get(iadd(cur, 16))
    }
    return 0
}

fn native_gc_stw_end() {
    if oren_globals() == 0 { return 0 }
    var stw_ptr = native_gc_stw_state_ptr()
    var parked_ptr = native_gc_stw_parked_ptr()
    var owner_ptr = native_gc_stw_owner_ptr()
    if stw_ptr == 0 || parked_ptr == 0 || owner_ptr == 0 { return 0 }

    // Release: set running and wake all waiters parked on the state word.
    ptr_set(owner_ptr, 0)
    ptr_set(parked_ptr, 0)
    ptr_set(stw_ptr, 0)
    oren_wake_all_addr(stw_ptr)
    // Also wake any blocked pollers so "world resumes" quickly even if the next
    // scheduler idle timeout would otherwise be long.
    native_netpoll_wake()
    return 0
}

fn native_gc_stw_poll_and_park() {
    if oren_globals() == 0 { return 0 }
    var trace = native_envp_get_value_ptr("OREN_TRACE_GC_STW")
    var trace_on = 0
    if trace != 0 && ptr_get_byte(trace) != 0 { trace_on = 1 }
    var stw_ptr = native_gc_stw_state_ptr()
    if stw_ptr == 0 { return 0 }

    // Fast path: no stop requested.
    var s = ptr_get(stw_ptr)
    if s == 0 { return 0 }

    // If the collector is in "preparing" mode, wait until it transitions (2->1 or 2->0).
    while s == 2 {
        oren_wait_on_addr(stw_ptr, 2, 1000000)
        s = ptr_get(stw_ptr)
    }
    if s == 0 { return 0 }

    // Now s==1: park at safepoint.
    var node = native_time_current_thread_node_or0()
    if node == 0 {
        if trace_on != 0 { print("trace: gc_stw_poll node=0 tid=" + oren_int_to_string(sys_gettid())) }
        return 0
    }
    // Determine which stack node should receive the saved_sp.
    // Prefer the current green stack (if any), otherwise use the OS-thread stack node.
    var saved_node = node
    var ts = ptr_get(node + green_thread_node_off_green_state())
    if ts != 0 && ts != -1 && ts >= 4096 {
        var g = ptr_get(ts + green_t_off_current_g())
        if g != 0 && g != -1 && g >= 4096 {
            var g_node = ptr_get(g + green_g_off_stack_node())
            if g_node != 0 && g_node != -1 && g_node >= 4096 { saved_node = g_node }
        }
    }

    // Collector thread does not park.
    var owner_ptr = native_gc_stw_owner_ptr()
    var owner = 0
    if owner_ptr != 0 { owner = ptr_get(owner_ptr) }
    if owner != 0 {
        // Pointer equality without `==` to avoid any string-aware compare lowering.
        if node - owner == 0 { return 0 }
    }

    // Set saved_sp so GC can scan this non-current thread.
    // Use an atomic CAS loop to ensure visibility before the parked-count increment.
    var sp_now = get_sp()
    var THREAD_NODE_FLAG_OS_THREAD = 1
    var saved_ptr = iadd(saved_node, 8)
    var saved_flags = ptr_get(iadd(saved_node, 48))
    if (saved_flags & THREAD_NODE_FLAG_OS_THREAD) != 0 {
        saved_ptr = iadd(saved_node, 80)
    }
    while true {
        var old_sp = ptr_get(saved_ptr)
        if atomic_cas(saved_ptr, old_sp, sp_now) == old_sp { break }
    }
    // Backup to legacy saved_sp slot for OS-thread nodes (rolling robustness).
    if saved_node - node == 0 && (saved_flags & THREAD_NODE_FLAG_OS_THREAD) != 0 {
        var backup_ptr = iadd(node, 8)
        while true {
            var old_backup = ptr_get(backup_ptr)
            if atomic_cas(backup_ptr, old_backup, sp_now) == old_backup { break }
        }
    }
    // Wake any collector waiting for saved_sp visibility.
    oren_wake_all_addr(saved_ptr)
    if trace_on != 0 {
        var node_tid = ptr_get(iadd(node, 56))
        var saved_off = saved_ptr - saved_node
        print("trace: gc_stw_park node=" + oren_int_to_string(node) +
              " tid=" + oren_int_to_string(node_tid) +
              " saved=" + oren_int_to_string(ptr_get(saved_ptr)) +
              " saved_node=" + oren_int_to_string(saved_node) +
              " saved_off=" + oren_int_to_string(saved_off) +
              " saved_flags=" + oren_int_to_string(saved_flags))
    }

    // Mark this thread node as parked (bit1 in flags) and bump parked count once.
    var flags_ptr = iadd(node, 48)
    var THREAD_NODE_FLAG_STW_PARKED = 2
    while true {
        var f = ptr_get(flags_ptr)
        if (f & THREAD_NODE_FLAG_STW_PARKED) != 0 { break }
        if atomic_cas(flags_ptr, f, f | THREAD_NODE_FLAG_STW_PARKED) == f {
            var parked_ptr = native_gc_stw_parked_ptr()
            if parked_ptr != 0 {
                native_atomic_inc_u64(parked_ptr)
                // Wake the collector waiting on parked-count changes.
                oren_wake_all_addr(parked_ptr)
            }
            break
        }
    }

    // Sleep until the collector releases STW (state becomes 0).
    while ptr_get(stw_ptr) == 1 {
        oren_wait_on_addr(stw_ptr, 1, 1000000)
    }

    // Clear saved_sp and parked flag on resume (atomic best-effort).
    while true {
        var old_saved = ptr_get(saved_ptr)
        if atomic_cas(saved_ptr, old_saved, 0) == old_saved { break }
    }
    while true {
        var f0 = ptr_get(flags_ptr)
        if atomic_cas(flags_ptr, f0, f0 & -3) == f0 { break }
    }
    return 0
}
