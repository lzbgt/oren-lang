// Portable wait-on-address primitive for the native runtime (rolling).
//
// The runtime uses `sys_ulock_wait/sys_ulock_wake` as a cross-platform substrate:
// - macOS: ulock syscalls
// - Linux: futex(FUTEX_WAIT_PRIVATE/FUTEX_WAKE_PRIVATE)
// - Windows: WaitOnAddress/WakeByAddressAll
//
// Conventions (fact, enforced by tests where applicable):
// - operation=1 is treated as "compare-and-wait"
// - operation=257 (1|0x100) is treated as "wake all waiters"
// - timeout uses portable `-60` for timeout (Darwin ETIMEDOUT); Linux is normalized to -60.

// Wait until `*(addr)` is not equal to `expected` (or until timeout).
//
// Notes:
// - On Linux, futex waits on a 32-bit word; only the low 32 bits of `expected` are observed.
// - On Windows, WaitOnAddress uses a byte compare; we currently use AddressSize=8 in the backend.
//
// Return:
// - 0 on wake/spurious wake
// - -60 on timeout
// - other negative errno on failure
fn oren_wait_on_addr(addr, expected, timeout_us) {
    // Treat low addresses as invalid pointers; many runtime subsystems use >=4096 as the
    // minimal "looks like a real mapping" guard.
    if addr == 0 || addr < 4096 { return -5 } // EIO-ish

    // Correct semantics:
    // - If the value is already not equal to `expected`, return 0 (no blocking needed).
    // - If the underlying primitive reports "value mismatch" (racy check), normalize it to 0.
    //
    // This matters for lock/park loops that do:
    //   CAS -> if failed: wait_on_addr(expected=cur)
    // If the value changes between the CAS and the sleep, the kernel can report a mismatch
    // (Linux futex: -EAGAIN) instead of sleeping.
    var cur = ptr_get(addr)
    if g_target_os == 2 {
        // Linux futex observes only the low 32 bits.
        if (cur & 4294967295) != (expected & 4294967295) { return 0 }
        expected = expected & 4294967295
    } else {
        if cur != expected { return 0 }
    }

    // Green-task friendliness (rolling):
    // If this call happens inside a green task, do NOT block the scheduler OS thread forever
    // in the kernel wait primitive.
    //
    // Scope (intentionally narrow for now):
    // - Only intercept the "forever" case (`timeout_us == 0`) to avoid deadlocks where the
    //   waker is itself a green task that cannot run while the scheduler OS thread is blocked.
    // - Bounded waits (`timeout_us > 0`) keep using the OS primitive so wake-by-address remains
    //   event-driven and latency stays low under contention.
    //
    // Note: this is a bridge until the scheduler grows a first-class "word wait" wait-list.
    if timeout_us == 0 && oren_green_current_g_or0() != 0 {
        while true {
            var cur2 = ptr_get(addr)
            if g_target_os == 2 {
                if (cur2 & 4294967295) != expected { return 0 }
            } else {
                if cur2 != expected { return 0 }
            }
            // Keep the scheduler responsive: sleep in small slices (not a busy spin).
            oren_green_sleep_ns(1000000) // 1ms
        }
    }

    // Use a literal op code (avoid non-zero global initializers in the native runtime bundle).
    var rc = sys_ulock_wait(1, addr, expected, timeout_us)

    // Normalize spurious/mismatch cases to 0:
    // - Linux futex: EAGAIN (-11) when *addr != expected at the moment of the check
    // - Darwin ulock: value mismatch can show up as EBUSY (-16) or EAGAIN (-35) depending on kernel path
    // - Any platform: EINTR (-4) may happen; callers already loop
    if rc == -11 || rc == -16 || rc == -35 || rc == -4 { return 0 }
    return rc
}

// Wake all threads waiting on `addr` via `oren_wait_on_addr`.
// Returns 0 on success, or -errno.
fn oren_wake_all_addr(addr) {
    // 257 == 1|0x100 (wake-all), matching the wake-all encoding used elsewhere in the runtime.
    return sys_ulock_wake(257, addr, 0)
}
