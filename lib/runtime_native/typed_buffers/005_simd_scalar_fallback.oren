    _simd_store_u64_le(out_ptr + 0, oren_f64_to_u64_bits(c00)); _simd_store_u64_le(out_ptr + 8, oren_f64_to_u64_bits(c01)); _simd_store_u64_le(out_ptr + 16, oren_f64_to_u64_bits(c02)); _simd_store_u64_le(out_ptr + 24, oren_f64_to_u64_bits(c03))
    _simd_store_u64_le(out_ptr + 32, oren_f64_to_u64_bits(c10)); _simd_store_u64_le(out_ptr + 40, oren_f64_to_u64_bits(c11)); _simd_store_u64_le(out_ptr + 48, oren_f64_to_u64_bits(c12)); _simd_store_u64_le(out_ptr + 56, oren_f64_to_u64_bits(c13))
    _simd_store_u64_le(out_ptr + 64, oren_f64_to_u64_bits(c20)); _simd_store_u64_le(out_ptr + 72, oren_f64_to_u64_bits(c21)); _simd_store_u64_le(out_ptr + 80, oren_f64_to_u64_bits(c22)); _simd_store_u64_le(out_ptr + 88, oren_f64_to_u64_bits(c23))
    _simd_store_u64_le(out_ptr + 96, oren_f64_to_u64_bits(c30)); _simd_store_u64_le(out_ptr + 104, oren_f64_to_u64_bits(c31)); _simd_store_u64_le(out_ptr + 112, oren_f64_to_u64_bits(c32)); _simd_store_u64_le(out_ptr + 120, oren_f64_to_u64_bits(c33))
