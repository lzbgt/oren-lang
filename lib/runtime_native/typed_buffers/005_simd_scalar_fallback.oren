fn simd_gemm_i32_4x4_ptr(out_ptr, a0_ptr, a1_ptr, a2_ptr, a3_ptr, b0_ptr, b1_ptr, b2_ptr, b3_ptr, n) {
    var c00 = 0; var c01 = 0; var c02 = 0; var c03 = 0
    var c10 = 0; var c11 = 0; var c12 = 0; var c13 = 0
    var c20 = 0; var c21 = 0; var c22 = 0; var c23 = 0
    var c30 = 0; var c31 = 0; var c32 = 0; var c33 = 0
    var i = 0
    while i < n {
        var off = i * 4
        var a0 = _simd_load_i32_le(a0_ptr + off)
        var a1 = _simd_load_i32_le(a1_ptr + off)
        var a2 = _simd_load_i32_le(a2_ptr + off)
        var a3 = _simd_load_i32_le(a3_ptr + off)
        var b0 = _simd_load_i32_le(b0_ptr + off)
        var b1 = _simd_load_i32_le(b1_ptr + off)
        var b2 = _simd_load_i32_le(b2_ptr + off)
        var b3 = _simd_load_i32_le(b3_ptr + off)
        c00 = c00 + a0 * b0; c01 = c01 + a0 * b1; c02 = c02 + a0 * b2; c03 = c03 + a0 * b3
        c10 = c10 + a1 * b0; c11 = c11 + a1 * b1; c12 = c12 + a1 * b2; c13 = c13 + a1 * b3
        c20 = c20 + a2 * b0; c21 = c21 + a2 * b1; c22 = c22 + a2 * b2; c23 = c23 + a2 * b3
        c30 = c30 + a3 * b0; c31 = c31 + a3 * b1; c32 = c32 + a3 * b2; c33 = c33 + a3 * b3
        i = i + 1
    }
    _simd_store_u64_le(out_ptr + 0, c00); _simd_store_u64_le(out_ptr + 8, c01); _simd_store_u64_le(out_ptr + 16, c02); _simd_store_u64_le(out_ptr + 24, c03)
    _simd_store_u64_le(out_ptr + 32, c10); _simd_store_u64_le(out_ptr + 40, c11); _simd_store_u64_le(out_ptr + 48, c12); _simd_store_u64_le(out_ptr + 56, c13)
    _simd_store_u64_le(out_ptr + 64, c20); _simd_store_u64_le(out_ptr + 72, c21); _simd_store_u64_le(out_ptr + 80, c22); _simd_store_u64_le(out_ptr + 88, c23)
    _simd_store_u64_le(out_ptr + 96, c30); _simd_store_u64_le(out_ptr + 104, c31); _simd_store_u64_le(out_ptr + 112, c32); _simd_store_u64_le(out_ptr + 120, c33)
    return out_ptr
}

fn simd_gemm_f64_4x4_ptr(out_ptr, a0_ptr, a1_ptr, a2_ptr, a3_ptr, b0_ptr, b1_ptr, b2_ptr, b3_ptr, n) {
    var c00: f64 = 0.0; var c01: f64 = 0.0; var c02: f64 = 0.0; var c03: f64 = 0.0
    var c10: f64 = 0.0; var c11: f64 = 0.0; var c12: f64 = 0.0; var c13: f64 = 0.0
    var c20: f64 = 0.0; var c21: f64 = 0.0; var c22: f64 = 0.0; var c23: f64 = 0.0
    var c30: f64 = 0.0; var c31: f64 = 0.0; var c32: f64 = 0.0; var c33: f64 = 0.0
    var i = 0
    while i < n {
        var off = i * 8
        var a0 = oren_u64_bits_to_f64(_simd_load_u64_le(a0_ptr + off))
        var a1 = oren_u64_bits_to_f64(_simd_load_u64_le(a1_ptr + off))
        var a2 = oren_u64_bits_to_f64(_simd_load_u64_le(a2_ptr + off))
        var a3 = oren_u64_bits_to_f64(_simd_load_u64_le(a3_ptr + off))
        var b0 = oren_u64_bits_to_f64(_simd_load_u64_le(b0_ptr + off))
        var b1 = oren_u64_bits_to_f64(_simd_load_u64_le(b1_ptr + off))
        var b2 = oren_u64_bits_to_f64(_simd_load_u64_le(b2_ptr + off))
        var b3 = oren_u64_bits_to_f64(_simd_load_u64_le(b3_ptr + off))
        c00 = c00 + a0 * b0; c01 = c01 + a0 * b1; c02 = c02 + a0 * b2; c03 = c03 + a0 * b3
        c10 = c10 + a1 * b0; c11 = c11 + a1 * b1; c12 = c12 + a1 * b2; c13 = c13 + a1 * b3
        c20 = c20 + a2 * b0; c21 = c21 + a2 * b1; c22 = c22 + a2 * b2; c23 = c23 + a2 * b3
        c30 = c30 + a3 * b0; c31 = c31 + a3 * b1; c32 = c32 + a3 * b2; c33 = c33 + a3 * b3
        i = i + 1
    }
    _simd_store_u64_le(out_ptr + 0, oren_f64_to_u64_bits(c00)); _simd_store_u64_le(out_ptr + 8, oren_f64_to_u64_bits(c01)); _simd_store_u64_le(out_ptr + 16, oren_f64_to_u64_bits(c02)); _simd_store_u64_le(out_ptr + 24, oren_f64_to_u64_bits(c03))
    _simd_store_u64_le(out_ptr + 32, oren_f64_to_u64_bits(c10)); _simd_store_u64_le(out_ptr + 40, oren_f64_to_u64_bits(c11)); _simd_store_u64_le(out_ptr + 48, oren_f64_to_u64_bits(c12)); _simd_store_u64_le(out_ptr + 56, oren_f64_to_u64_bits(c13))
    _simd_store_u64_le(out_ptr + 64, oren_f64_to_u64_bits(c20)); _simd_store_u64_le(out_ptr + 72, oren_f64_to_u64_bits(c21)); _simd_store_u64_le(out_ptr + 80, oren_f64_to_u64_bits(c22)); _simd_store_u64_le(out_ptr + 88, oren_f64_to_u64_bits(c23))
    _simd_store_u64_le(out_ptr + 96, oren_f64_to_u64_bits(c30)); _simd_store_u64_le(out_ptr + 104, oren_f64_to_u64_bits(c31)); _simd_store_u64_le(out_ptr + 112, oren_f64_to_u64_bits(c32)); _simd_store_u64_le(out_ptr + 120, oren_f64_to_u64_bits(c33))
    return out_ptr
}

fn simd_gemm_f32_4x4_ptr(out_ptr, a0_ptr, a1_ptr, a2_ptr, a3_ptr, b0_ptr, b1_ptr, b2_ptr, b3_ptr, n) {
