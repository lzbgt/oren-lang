fn simd_reduce_sum_f64_ptr(a_ptr, n) {
    var sum: f64 = 0.0
    var i = 0
    while i < n {
        var off = i * 8
        sum = sum + oren_u64_bits_to_f64(_simd_load_u64_le(a_ptr + off))
        i = i + 1
    }
    return oren_f64_to_u64_bits(sum)
}

fn simd_scale_f32_ptr(dst_ptr, a_ptr, scalar_bits, n) {
    var s = oren_u32_bits_to_f32(scalar_bits)
    var i = 0
    while i < n {
        var off = i * 4
        var x = oren_u32_bits_to_f32(_simd_load_u32_le(a_ptr + off))
        var out = x * s
        _simd_store_u32_le(dst_ptr + off, oren_f32_to_u32_bits(out))
        i = i + 1
    }
    return dst_ptr
}

fn simd_scale_i32_ptr(dst_ptr, a_ptr, scalar, n) {
    var i = 0
    while i < n {
        var off = i * 4
        var x = _simd_load_i32_le(a_ptr + off)
        _simd_store_u32_le(dst_ptr + off, x * scalar)
        i = i + 1
    }
    return dst_ptr
}

fn simd_axpy_f32_ptr(dst_ptr, alpha_bits, x_ptr, y_ptr, n) {
    var a = oren_u32_bits_to_f32(alpha_bits)
    var i = 0
    while i < n {
        var off = i * 4
        var x = oren_u32_bits_to_f32(_simd_load_u32_le(x_ptr + off))
        var y = oren_u32_bits_to_f32(_simd_load_u32_le(y_ptr + off))
        var out = (a * x) + y
        _simd_store_u32_le(dst_ptr + off, oren_f32_to_u32_bits(out))
        i = i + 1
    }
    return dst_ptr
}

fn simd_axpy_i32_ptr(dst_ptr, alpha, x_ptr, y_ptr, n) {
    var i = 0
    while i < n {
        var off = i * 4
        var x = _simd_load_i32_le(x_ptr + off)
        var y = _simd_load_i32_le(y_ptr + off)
        _simd_store_u32_le(dst_ptr + off, (alpha * x) + y)
        i = i + 1
    }
    return dst_ptr
}

