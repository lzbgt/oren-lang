// Scalar fallback implementations for SIMD pointer kernels.
//
// Motivation:
// - arm64 native backend inlines many `simd_*_ptr` calls as compiler intrinsics.
// - x64 native backend is converging toward arm64 parity and currently injects the
//   full native runtime by default; without definitions, unresolved `simd_*_ptr`
//   symbols break compilation even if the SIMD fast paths are never executed.
//
// Contract:
// - These implementations are **semantics-first** and backend-agnostic.
// - They operate on the canonical typed-buffer payload encoding (little-endian).
// - If a backend has a true SIMD intrinsic, it may still override these calls
//   at codegen time (by-name intrinsic lowering).

fn _simd_load_u32_le(p) {
    var b0 = ptr_get_byte(p + 0) & 255
    var b1 = ptr_get_byte(p + 1) & 255
    var b2 = ptr_get_byte(p + 2) & 255
    var b3 = ptr_get_byte(p + 3) & 255
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

fn _simd_store_u32_le(p, u) {
    var x = u & 4294967295
    ptr_set_byte(p + 0, x & 255)
    ptr_set_byte(p + 1, (x >> 8) & 255)
    ptr_set_byte(p + 2, (x >> 16) & 255)
    ptr_set_byte(p + 3, (x >> 24) & 255)
    return 0
}

fn _simd_load_i32_le(p) {
    var u = _simd_load_u32_le(p)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn _simd_load_u64_le(p) {
    var u = 0
    var i = 0
    while i < 8 {
        var b = ptr_get_byte(p + i) & 255
        u = u | (b << (i * 8))
        i = i + 1
    }
    return u
}

fn _simd_store_u64_le(p, v) {
    var i = 0
    while i < 8 {
        ptr_set_byte(p + i, (v >> (i * 8)) & 255)
        i = i + 1
    }
    return 0
}

fn simd_add_i32_ptr(dst_ptr, a_ptr, b_ptr, n) {
    var i = 0
    while i < n {
        var off = i * 4
        var x = _simd_load_i32_le(a_ptr + off)
        var y = _simd_load_i32_le(b_ptr + off)
        _simd_store_u32_le(dst_ptr + off, x + y)
        i = i + 1
    }
    return dst_ptr
}

fn simd_mul_i32_ptr(dst_ptr, a_ptr, b_ptr, n) {
    var i = 0
    while i < n {
        var off = i * 4
        var x = _simd_load_i32_le(a_ptr + off)
        var y = _simd_load_i32_le(b_ptr + off)
        _simd_store_u32_le(dst_ptr + off, x * y)
        i = i + 1
    }
    return dst_ptr
}

fn simd_add_i64_ptr(dst_ptr, a_ptr, b_ptr, n) {
    var i = 0
    while i < n {
        var off = i * 8
        var x = _simd_load_u64_le(a_ptr + off)
        var y = _simd_load_u64_le(b_ptr + off)
        _simd_store_u64_le(dst_ptr + off, x + y)
        i = i + 1
    }
    return dst_ptr
}

fn simd_add_f32_ptr(dst_ptr, a_ptr, b_ptr, n) {
    var i = 0
    while i < n {
        var off = i * 4
        var ax = oren_u32_bits_to_f32(_simd_load_u32_le(a_ptr + off))
        var by = oren_u32_bits_to_f32(_simd_load_u32_le(b_ptr + off))
        var out = ax + by
        _simd_store_u32_le(dst_ptr + off, oren_f32_to_u32_bits(out))
        i = i + 1
    }
    return dst_ptr
}

fn simd_mul_f32_ptr(dst_ptr, a_ptr, b_ptr, n) {
    var i = 0
    while i < n {
        var off = i * 4
        var ax = oren_u32_bits_to_f32(_simd_load_u32_le(a_ptr + off))
        var by = oren_u32_bits_to_f32(_simd_load_u32_le(b_ptr + off))
        var out = ax * by
        _simd_store_u32_le(dst_ptr + off, oren_f32_to_u32_bits(out))
        i = i + 1
    }
    return dst_ptr
}

