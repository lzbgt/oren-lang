}

fn simd_dot_i32_ptr(a_ptr, b_ptr, n) {
    var sum = 0
    var i = 0
    while i < n {
        var off = i * 4
        var ax = _simd_load_i32_le(a_ptr + off)
        var by = _simd_load_i32_le(b_ptr + off)
        sum = sum + (ax * by)
        i = i + 1
    }
    return sum
}

fn simd_dot_f32_ptr(a_ptr, b_ptr, n) {
    var sum: f64 = 0.0
    var i = 0
    while i < n {
        var off = i * 4
        var ax = oren_u32_bits_to_f32(_simd_load_u32_le(a_ptr + off))
        var by = oren_u32_bits_to_f32(_simd_load_u32_le(b_ptr + off))
        sum = sum + (ax * by)
        i = i + 1
    }
    return oren_f64_to_u64_bits(sum)
}

fn simd_dot_f64_ptr(a_ptr, b_ptr, n) {
    var sum: f64 = 0.0
    var i = 0
    while i < n {
        var off = i * 8
        var ax = oren_u64_bits_to_f64(_simd_load_u64_le(a_ptr + off))
        var by = oren_u64_bits_to_f64(_simd_load_u64_le(b_ptr + off))
        sum = sum + (ax * by)
        i = i + 1
    }
    return oren_f64_to_u64_bits(sum)
}

fn simd_dot_i32_4_ptr(out_ptr, a_ptr, b0_ptr, b1_ptr, b2_ptr, b3_ptr, n) {
    var s0 = 0
    var s1 = 0
    var s2 = 0
    var s3 = 0
    var i = 0
    while i < n {
        var off = i * 4
        var av = _simd_load_i32_le(a_ptr + off)
        s0 = s0 + av * _simd_load_i32_le(b0_ptr + off)
        s1 = s1 + av * _simd_load_i32_le(b1_ptr + off)
        s2 = s2 + av * _simd_load_i32_le(b2_ptr + off)
        s3 = s3 + av * _simd_load_i32_le(b3_ptr + off)
        i = i + 1
    }
    _simd_store_u64_le(out_ptr + 0, s0)
    _simd_store_u64_le(out_ptr + 8, s1)
    _simd_store_u64_le(out_ptr + 16, s2)
    _simd_store_u64_le(out_ptr + 24, s3)
    return out_ptr
}

fn simd_dot_f32_4_ptr(out_ptr, a_ptr, b0_ptr, b1_ptr, b2_ptr, b3_ptr, n) {
    var s0: f64 = 0.0
    var s1: f64 = 0.0
    var s2: f64 = 0.0
    var s3: f64 = 0.0
    var i = 0
    while i < n {
        var off = i * 4
        var av = oren_u32_bits_to_f32(_simd_load_u32_le(a_ptr + off))
        s0 = s0 + av * oren_u32_bits_to_f32(_simd_load_u32_le(b0_ptr + off))
        s1 = s1 + av * oren_u32_bits_to_f32(_simd_load_u32_le(b1_ptr + off))
        s2 = s2 + av * oren_u32_bits_to_f32(_simd_load_u32_le(b2_ptr + off))
        s3 = s3 + av * oren_u32_bits_to_f32(_simd_load_u32_le(b3_ptr + off))
        i = i + 1
    }
    _simd_store_u64_le(out_ptr + 0, oren_f64_to_u64_bits(s0))
    _simd_store_u64_le(out_ptr + 8, oren_f64_to_u64_bits(s1))
    _simd_store_u64_le(out_ptr + 16, oren_f64_to_u64_bits(s2))
    _simd_store_u64_le(out_ptr + 24, oren_f64_to_u64_bits(s3))
    return out_ptr
}

