    return out
}

fn oren_buf_add_i64(a, b) {
    var ea = native_buf_check(a, BUF_TAG_I64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_add_i64: length mismatch") }
    var out = oren_i64_buf_new(n)
    if oren_is_err(out) { return out }
    var r = oren_buf_add_i64_into(out, a, b)
    if oren_is_err(r) { return r }
    return out
}

