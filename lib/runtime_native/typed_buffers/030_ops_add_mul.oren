// Split from lib/runtime_native/200_typed_buffers.oren (440-694)
fn oren_buf_add_i32(a, b) {
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_add_i32: length mismatch") }
    var out = oren_i32_buf_new(n)
    if oren_is_err(out) { return out }
    var i = 0
    while i < n {
        var x = oren_buf_load_i32(a, i)
        var y = oren_buf_load_i32(b, i)
        oren_buf_store_i32(out, i, x + y)
        i = i + 1
    }
    return out
}

