    var ea = native_buf_check(a, BUF_TAG_F64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) { return oren_err(4, "buf_mul_f64: length mismatch") }
    var out = oren_f64_buf_new(n)
