fn oren_buf_add_i32_into(dst, a, b) {
    var ed = native_buf_check(dst, BUF_TAG_I32, 4)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_I32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) || n != ptr_get(dst + 0) { return oren_err(4, "buf_add_i32_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 4 {
        var pd = native_buf_data_ptr(dst)
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        simd_add_i32_ptr(pd, pa, pb, n)
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_i32(dst, i, oren_buf_load_i32(a, i) + oren_buf_load_i32(b, i))
        i = i + 1
    }
    return dst
}

fn oren_buf_add_f32_into(dst, a, b) {
    var ed = native_buf_check(dst, BUF_TAG_F32, 4)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_F32, 4)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F32, 4)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) || n != ptr_get(dst + 0) { return oren_err(4, "buf_add_f32_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 4 {
        var pd = native_buf_data_ptr(dst)
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        simd_add_f32_ptr(pd, pa, pb, n)
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_f32(dst, i, oren_buf_load_f32(a, i) + oren_buf_load_f32(b, i))
        i = i + 1
    }
    return dst
}

fn oren_buf_add_i64_into(dst, a, b) {
    var ed = native_buf_check(dst, BUF_TAG_I64, 8)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_I64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) || n != ptr_get(dst + 0) { return oren_err(4, "buf_add_i64_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 2 {
        var pd = native_buf_data_ptr(dst)
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        simd_add_i64_ptr(pd, pa, pb, n)
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_i64(dst, i, oren_buf_load_i64(a, i) + oren_buf_load_i64(b, i))
        i = i + 1
    }
    return dst
}

fn oren_buf_add_f64_into(dst, a, b) {
    var ed = native_buf_check(dst, BUF_TAG_F64, 8)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_F64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) || n != ptr_get(dst + 0) { return oren_err(4, "buf_add_f64_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 2 {
        var pd = native_buf_data_ptr(dst)
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        var n2 = n - (n % 2)
        if n2 >= 2 {
            simd_add_f64_ptr(pd, pa, pb, n2)
        }
        if n2 != n {
            oren_buf_store_f64(dst, n2, oren_buf_load_f64(a, n2) + oren_buf_load_f64(b, n2))
        }
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_f64(dst, i, oren_buf_load_f64(a, i) + oren_buf_load_f64(b, i))
        i = i + 1
    }
    return dst
}

fn oren_buf_mul_i64_into(dst, a, b) {
    var ed = native_buf_check(dst, BUF_TAG_I64, 8)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_I64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_I64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) || n != ptr_get(dst + 0) { return oren_err(4, "buf_mul_i64_into: length mismatch") }

    // NOTE: no native SIMD fast path for i64 mul today (NEON does not support 2x i64 lane mul).
    var i = 0
    while i < n {
        oren_buf_store_i64(dst, i, oren_buf_load_i64(a, i) * oren_buf_load_i64(b, i))
        i = i + 1
    }
    return dst
}

fn oren_buf_mul_f64_into(dst, a, b) {
    var ed = native_buf_check(dst, BUF_TAG_F64, 8)
    if oren_is_err(ed) { return ed }
    var ea = native_buf_check(a, BUF_TAG_F64, 8)
    if oren_is_err(ea) { return ea }
    var eb = native_buf_check(b, BUF_TAG_F64, 8)
    if oren_is_err(eb) { return eb }
    var n = ptr_get(a + 0)
    if n != ptr_get(b + 0) || n != ptr_get(dst + 0) { return oren_err(4, "buf_mul_f64_into: length mismatch") }

    if native_simd_enabled() != 0 && n >= 2 {
        var pd = native_buf_data_ptr(dst)
        var pa = native_buf_data_ptr(a)
        var pb = native_buf_data_ptr(b)
        var n2 = n - (n % 2)
        if n2 >= 2 {
            simd_mul_f64_ptr(pd, pa, pb, n2)
        }
        if n2 != n {
            oren_buf_store_f64(dst, n2, oren_buf_load_f64(a, n2) * oren_buf_load_f64(b, n2))
        }
        return dst
    }

    var i = 0
    while i < n {
        oren_buf_store_f64(dst, i, oren_buf_load_f64(a, i) * oren_buf_load_f64(b, i))
        i = i + 1
    }
    return dst
}

