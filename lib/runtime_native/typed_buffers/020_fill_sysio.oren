// Split from lib/runtime_native/200_typed_buffers.oren (355-439)
fn oren_buf_fill_u8(buf, v) {
    var err = native_buf_check(buf, BUF_TAG_U8, 1)
    if oren_is_err(err) { return err }
    if v < 0 || v > 255 { return oren_err(4, "buf_fill_u8: byte out of range") }
    var n = ptr_get(buf + 0)
    var data = native_buf_data_ptr(buf)
    var i = 0
    while i < n {
        ptr_set_byte(data + i, v)
        i = i + 1
    }
    return buf
}

fn sys_read_u8_buf(fd, buf, off, nbytes) {
    var err = native_buf_check(buf, BUF_TAG_U8, 1)
    if oren_is_err(err) { return err }
    if off < 0 || nbytes < 0 { return oren_err(4, "sys_read_u8_buf: negative offset/len") }
    var n = ptr_get(buf + 0)
    if off > n { return oren_err(4, "sys_read_u8_buf: offset out of bounds") }
    if off + nbytes > n { return oren_err(4, "sys_read_u8_buf: length out of bounds") }
    var data = native_buf_data_ptr(buf)
    return sys_read(fd, data + off, nbytes)
}

fn sys_read_u8_buf_unchecked(fd, buf, off, nbytes) {
    // Hot-path helper for compiler/runtime cache IO.
    //
    // `sys_read_u8_buf` defensively validates the buffer by calling `native_buf_check`,
    // which may consult GC metadata (`oren_find_node`). That can become a measurable
    // overhead in compiler workloads that perform many chunked reads.
    //
    // This unchecked variant assumes `buf` is a valid u8_buf allocated by the runtime,
    // and only performs cheap bounds checks before issuing the syscall.
    if buf == 0 { return oren_err(4, "sys_read_u8_buf_unchecked: nil buf") }
    if off < 0 || nbytes < 0 { return oren_err(4, "sys_read_u8_buf_unchecked: negative offset/len") }
    var n = ptr_get(buf + 0)
    if off > n { return oren_err(4, "sys_read_u8_buf_unchecked: offset out of bounds") }
    if off + nbytes > n { return oren_err(4, "sys_read_u8_buf_unchecked: length out of bounds") }
    var data = native_buf_data_ptr(buf)
    return sys_read(fd, data + off, nbytes)
}

fn sys_write_u8_buf(fd, buf, off, nbytes) {
    var err = native_buf_check(buf, BUF_TAG_U8, 1)
    if oren_is_err(err) { return err }
    if off < 0 || nbytes < 0 { return oren_err(4, "sys_write_u8_buf: negative offset/len") }
    var n = ptr_get(buf + 0)
    if off > n { return oren_err(4, "sys_write_u8_buf: offset out of bounds") }
    if off + nbytes > n { return oren_err(4, "sys_write_u8_buf: length out of bounds") }
    var data = native_buf_data_ptr(buf)
    return sys_write(fd, data + off, nbytes)
}

// Bulk helpers (scalar baseline; SIMD can replace later).
fn oren_buf_fill_i32(buf, v) {
    var err = native_buf_check(buf, BUF_TAG_I32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var data = native_buf_data_ptr(buf)
    var u = v & 4294967295
    var i = 0
    while i < n {
        var off = i * 4
        ptr_set_byte(data + off + 0, u & 255)
        ptr_set_byte(data + off + 1, (u >> 8) & 255)
        ptr_set_byte(data + off + 2, (u >> 16) & 255)
        ptr_set_byte(data + off + 3, (u >> 24) & 255)
        i = i + 1
    }
    return buf
}

fn oren_buf_fill_i64(buf, v) {
    var err = native_buf_check(buf, BUF_TAG_I64, 8)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var data = native_buf_data_ptr(buf)
    var i = 0
    while i < n {
        var off = i * 8
        ptr_set_byte(data + off + 0, v & 255)
        ptr_set_byte(data + off + 1, (v >> 8) & 255)
        ptr_set_byte(data + off + 2, (v >> 16) & 255)
        ptr_set_byte(data + off + 3, (v >> 24) & 255)
        ptr_set_byte(data + off + 4, (v >> 32) & 255)
        ptr_set_byte(data + off + 5, (v >> 40) & 255)
        ptr_set_byte(data + off + 6, (v >> 48) & 255)
        ptr_set_byte(data + off + 7, (v >> 56) & 255)
        i = i + 1
    }
    return buf
}

fn oren_buf_fill_f32(buf, v: f64) {
    var err = native_buf_check(buf, BUF_TAG_F32, 4)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var data = native_buf_data_ptr(buf)
    var bits = oren_f32_to_u32_bits(v)
    var i = 0
    while i < n {
        var off = i * 4
        ptr_set_byte(data + off + 0, bits & 255)
        ptr_set_byte(data + off + 1, (bits >> 8) & 255)
        ptr_set_byte(data + off + 2, (bits >> 16) & 255)
        ptr_set_byte(data + off + 3, (bits >> 24) & 255)
        i = i + 1
    }
    return buf
}

fn oren_buf_fill_f64(buf, v: f64) {
    var err = native_buf_check(buf, BUF_TAG_F64, 8)
    if oren_is_err(err) { return err }
    var n = ptr_get(buf + 0)
    var data = native_buf_data_ptr(buf)
    var i = 0
    while i < n {
        var off = i * 8
        ptr_set_byte(data + off + 0, v & 255)
        ptr_set_byte(data + off + 1, (v >> 8) & 255)
        ptr_set_byte(data + off + 2, (v >> 16) & 255)
        ptr_set_byte(data + off + 3, (v >> 24) & 255)
        ptr_set_byte(data + off + 4, (v >> 32) & 255)
        ptr_set_byte(data + off + 5, (v >> 40) & 255)
        ptr_set_byte(data + off + 6, (v >> 48) & 255)
        ptr_set_byte(data + off + 7, (v >> 56) & 255)
        i = i + 1
    }
    return buf
}
