// --- TIME (syscall-first) ---
//
// Provide a minimal “sleep” primitive without libc.
// We keep TIME intentionally small in v0: higher-level deadlines/cancellation can be built on top.
//
// sys_nanosleep(ns) is a native-backend intrinsic implemented per-OS:
// - macOS: kqueue/kevent timeout (no libc shims)
// - Linux: nanosleep syscall
//
// Returns 0 on success, or -errno.
@cap.requires(domain="TIME")
fn oren_sleep_ns(ns) {
    native_capsule_require(CAP_TIME, "TIME")
    if ns <= 0 { return 0 }
    // Primary path: native intrinsic sleep.
    //
    // Rolling safety (x86_64 bring-up):
    // Some platforms/environments can temporarily have a stubbed or failing nanosleep path.
    // To keep Tier‑1 semantics stable (and to keep join-timeout contracts meaningful),
    // we fall back to a gettimeofday-based spin if the observed elapsed time is suspiciously low.
    var t0 = oren_time_unix_ns()
    var rc = sys_nanosleep(ns)
    var t1 = oren_time_unix_ns()
    // Debugging aid (Tier‑1 bring-up): diagnose environments where nanosleep/time are stubbed
    // or failing. Keep output bounded: only print for "long" sleeps.
    var dbg_sleep = native_envp_get_value_ptr("OREN_DEBUG_SLEEP")
    var dbg_sleep_all = native_envp_get_value_ptr("OREN_DEBUG_SLEEP_ALL")
    var do_log = false
    if dbg_sleep_all != 0 {
        if ptr_get_byte(dbg_sleep_all) != 0 { do_log = true }
    }
    if do_log != true && dbg_sleep != 0 {
        if ptr_get_byte(dbg_sleep) != 0 {
            if ns >= 1000000000 { do_log = true }
        }
    }
    if do_log {
        print("sleep debug: ns=" + oren_int_to_string(ns) + " rc=" + oren_int_to_string(rc) + " t0=" + oren_int_to_string(t0) + " t1=" + oren_int_to_string(t1))
    }
    if t0 != 0 && t1 != 0 {
        var dt = t1 - t0
        // If we asked for a positive sleep and got essentially no time advancement,
        // treat it as a no-op and spin until the deadline (best-effort).
        if dt >= 0 && dt < (ns / 4) {
            var deadline = t0 + ns
            var guard = 0
            while guard < 100000000 {
                var now = oren_time_unix_ns()
                if now == 0 { break }
                if now >= deadline { break }
                guard = guard + 1
            }
        }
    }
    return rc
}

@cap.requires(domain="TIME")
fn oren_sleep_ms(ms) {
    native_capsule_require(CAP_TIME, "TIME")
    if ms <= 0 { return 0 }
    // ms -> ns
    return oren_sleep_ns(ms * 1000000)
}

fn oren_kill(pid, signum) {
    return sys_kill(pid, signum)
}

// Reusable scratch buffers for time syscalls (native runtime).
//
// Avoid per-call `malloc/free` in time helpers:
// - reduces allocator churn in compiler workloads
// - avoids crashes if `free()` / reuse lists are still rolling on some platforms
// - keeps `oren_time_now_ns()` safe to call from tracing/profiling paths
//
// NOTE (Tier‑1 correctness):
// In multi-threaded native programs (Windows `spawn`), TIME must not use shared mutable scratch
// without synchronization. The fast path uses per-thread scratch stored in the thread node.
// These globals are kept as a single-thread fallback (and as an emergency fallback if a
// thread node is not discoverable).
var g_time_tv_buf = 0   // 16 bytes (single-thread fallback)
var g_time_abs_buf = 0  // 8 bytes  (single-thread fallback)

fn native_time_current_thread_node_or0() {
    // Best-effort "which thread am I on?" heuristic shared with call-depth + GC stack scanning.
    //
    // Returns a Thread Node pointer or 0 if unknown/not registered yet.
    if oren_globals() == 0 { return 0 }

    // Prefer OS-thread identity when available:
    // - `sys_gettid()` is stable per OS thread on Tier‑1 (macOS/Linux/Windows).
    // - `oren_register_thread` stores it at node+56 (OS thread nodes only).
    //
    // This avoids relying on the "sp within 8MB of top" heuristic, which can fail on:
    // - larger-than-8MB stacks
    // - stacks mapped close together (false positives/negatives).
    var tid = sys_gettid()
    if tid != 0 {
        var THREAD_NODE_FLAG_OS_THREAD = 1
        var node0 = global_get_threads()
        while node0 != 0 {
            var flags = ptr_get(iadd(node0, 48))
            if (flags & THREAD_NODE_FLAG_OS_THREAD) != 0 {
                if ptr_get(iadd(node0, 56)) == tid { return node0 }
            }
            node0 = ptr_get(iadd(node0, 16))
        }
    }

    // Fallback: stack-window heuristic (works for green stacks registered via `oren_register_stack`).
    var sp = get_sp()
    var node = global_get_threads()
    var max_scan = 8388608 // 8MB
    while node != 0 {
        var top = ptr_get(node)
        if sp < top {
            var diff = top - sp
            if diff < max_scan { return node }
        }
        node = ptr_get(iadd(node, 16))
    }
    return 0
}

fn native_time_thread_tv_buf(node) {
    // Per-thread `struct timeval` scratch (16 bytes).
    // Stored at node+32.
    if node == 0 { return 0 }
    var tv = ptr_get(iadd(node, 32))
    if tv != 0 { return tv }
    var p = sys_mmap_private_anon(16)
    if p == 0 || p == -1 || p < 4096 { return 0 }
    ptr_set(iadd(node, 32), p)
    return p
}

fn native_time_thread_abs_buf(node) {
    // Per-thread monotonic scratch (8 bytes).
    // Stored at node+40.
    if node == 0 { return 0 }
    var abs_ptr = ptr_get(iadd(node, 40))
    if abs_ptr != 0 { return abs_ptr }
    var p = sys_mmap_private_anon(8)
    if p == 0 || p == -1 || p < 4096 { return 0 }
    ptr_set(iadd(node, 40), p)
    return p
}

// Wall time in nanoseconds since Unix epoch (best-effort; not monotonic).
fn oren_time_unix_ns() {
    // struct timeval { tv_sec(u64), tv_usec(u64) } (we use 2x u64 for simplicity)
    var tv = 0
    if g_runtime_single_threaded == 1 {
        // Single-thread fast path: globals are safe and avoid thread-node scanning.
        if g_time_tv_buf == 0 {
            g_time_tv_buf = native_malloc_raw_or_mmap(16)
            if g_time_tv_buf == 0 { return 0 }
        }
        tv = g_time_tv_buf
    } else {
        // Multi-thread: use per-thread scratch stored in the thread node.
        var node = native_time_current_thread_node_or0()
        tv = native_time_thread_tv_buf(node)
        if tv == 0 {
            // Fallback: serialized global scratch (rare; keeps behavior deterministic).
            acquire_lock()
            if g_time_tv_buf == 0 { g_time_tv_buf = native_malloc_raw_or_mmap(16) }
            tv = g_time_tv_buf
            release_lock()
            if tv == 0 { return 0 }
        }
    }
    ptr_set(tv + 0, 0)
    ptr_set(tv + 8, 0)
    
    var rc = sys_gettimeofday(tv, 0, 0)
    var sec = 0
    var usec = 0
    if rc >= 0 {
        sec = ptr_get(tv + 0)
        usec = ptr_get(tv + 8)
    }
    
    if rc < 0 { return 0 }
    return sec * 1000000000 + usec * 1000
}

// Rolling alias used by stdlib + AVM parity.
fn oren_time_now_ns() {
    return oren_time_unix_ns()
}

// Monotonic “raw” time. For correctness, treat as compare-only (do not assume units).
// On Linux, this will be nanoseconds (via clock_gettime64 monotonic in the intrinsic).
// On macOS, this is mach_absolute_time units (returned by gettimeofday's 3rd out-arg).
fn oren_time_mono_raw() {
    var tv = 0
    var abs_ptr = 0
    if g_runtime_single_threaded == 1 {
        if g_time_tv_buf == 0 {
            g_time_tv_buf = native_malloc_raw_or_mmap(16)
            if g_time_tv_buf == 0 { return 0 }
        }
        if g_time_abs_buf == 0 {
            g_time_abs_buf = native_malloc_raw_or_mmap(8)
            if g_time_abs_buf == 0 { return 0 }
        }
        tv = g_time_tv_buf
        abs_ptr = g_time_abs_buf
    } else {
        var node = native_time_current_thread_node_or0()
        tv = native_time_thread_tv_buf(node)
        abs_ptr = native_time_thread_abs_buf(node)
        if tv == 0 || abs_ptr == 0 {
            // Emergency fallback: shared scratch under lock.
            acquire_lock()
            if g_time_tv_buf == 0 { g_time_tv_buf = native_malloc_raw_or_mmap(16) }
            if g_time_abs_buf == 0 { g_time_abs_buf = native_malloc_raw_or_mmap(8) }
            tv = g_time_tv_buf
            abs_ptr = g_time_abs_buf
            release_lock()
            if tv == 0 || abs_ptr == 0 { return 0 }
        }
    }
    ptr_set(tv + 0, 0)
    ptr_set(tv + 8, 0)
    ptr_set(abs_ptr, 0)
    
    var rc = sys_gettimeofday(tv, 0, abs_ptr)
    var t = 0
    if rc >= 0 {
        t = ptr_get(abs_ptr)
    }
    
    if rc < 0 { return 0 }
    return t
}

	@oren.keep
fn oren_register_thread(top) {
    // Thread Node (rolling):
    // - [top, saved_sp, next] must stay at offsets 0/8/16 because GC stack scanning depends on it.
    // - Additional fields may be appended for tier-1 runtime services.
    //
    // Layout (8-byte slots):
    //   0: top
    //   8: saved_sp
    //   16: next
    //   24: call_depth (stack safety)
    //   32: time_tv_buf (TIME scratch; 16 bytes)
    //   40: time_abs_buf (TIME scratch; 8 bytes)
    //   48: flags (bitmask; rolling)
    //   56: os_tid (u64; stable per-OS-thread identity for idempotent registration)
    //
		    // Size: 64 bytes
		    //
		    // Flags (bitmask):
		    // - bit0: OS thread node (vs. a green-stack node registered for GC scanning)
		    var THREAD_NODE_FLAG_OS_THREAD = 1
		    // - bit1: STW parked (set by GC safepoints)
			    // Runtime metadata:
			    // - Thread nodes must never be GC-managed (they are referenced by the GC scanner).
			    // - `oren_register_thread` can run concurrently with the main thread during OS-thread bring-up.
			    // - The "single-thread" fast-path allocator is not concurrency-safe, so allocate via a raw
		    //   syscall-backed page to avoid any shared allocator state races.
		    //
			    // NOTE: we intentionally over-allocate (1 page) to keep the allocator out of the path.
			    // If/when we have a concurrency-safe raw allocator, we can shrink this to 56 bytes.
			    //
			    // Idempotency:
			    // - Some OS-thread start stubs register threads automatically.
			    // - Tests and early bring-up code sometimes also call `oren_register_thread(get_sp())`.
			    // - Without dedupe, we would double-count OS threads and create duplicate nodes,
			    //   which breaks stop-the-world GC waiting (and inflates stack scans).
			    //
			    // Use `sys_gettid()` to dedupe per OS thread, and return an existing node if present.
			    var tid = sys_gettid()
			    if tid != 0 && oren_globals() != 0 {
			        var cur0 = global_get_threads()
			        while cur0 != 0 {
			            var flags0 = ptr_get(iadd(cur0, 48))
			            if (flags0 & THREAD_NODE_FLAG_OS_THREAD) != 0 {
			                var t0 = ptr_get(iadd(cur0, 56))
			                if t0 == tid {
			                    // Keep existing top (do not shrink the scan window).
			                    return cur0
			                }
			            }
			            cur0 = ptr_get(iadd(cur0, 16))
			        }
			    }

			    var node = sys_mmap_private_anon(4096)
			    if node != 0 && node != -1 && node >= 4096 {
			        ptr_set(node, top)
			        ptr_set(iadd(node, 8), 0) // saved_sp
			        ptr_set(iadd(node, 24), 0) // call_depth
			        ptr_set(iadd(node, 32), 0) // time_tv_buf
			        ptr_set(iadd(node, 40), 0) // time_abs_buf
			        ptr_set(iadd(node, 48), THREAD_NODE_FLAG_OS_THREAD)
			        ptr_set(iadd(node, 56), tid)
		        
			        // Publish the node:
			        //
			        // Single-thread mode:
			        // - Use lock-free CAS on the global thread-list head (safe during early bring-up).
			        //
			        // Multi-thread mode:
			        // - Use the runtime global lock so this does not race with `oren_register_stack` /
			        //   `oren_unregister_stack`, which mutate the same list under `acquire_lock()`.
			        //
			        // Without this split, a concurrent CAS insertion can be lost if another thread
			        // performs a non-atomic head write under the lock.
			        if g_runtime_single_threaded == 0 {
			            acquire_lock()
			            var prev_head2 = global_get_threads()
			            ptr_set(iadd(node, 16), prev_head2)
			            global_set_threads(node)
			            release_lock()
			        } else {
			            var threads_ptr = iadd(oren_globals(), 32) // GLOBAL_OFF_THREADS
			            while 1 {
			                var prev_head = ptr_get(threads_ptr)
			                ptr_set(iadd(node, 16), prev_head)
			                // atomic_cas returns the *old* value. Success iff old == expected.
			                if atomic_cas(threads_ptr, prev_head, node) == prev_head { break }
			            }
			        }

		        // Update OS-thread count and single-thread fast path.
	        //
	        // This intentionally tracks only OS threads (not green stacks), so green-task mode
	        // can preserve the single-thread fast path.
		        var count_ptr = iadd(oren_globals(), 416) // GLOBAL_OFF_OS_THREAD_COUNT (rolling)
		        while 1 {
		            var old = ptr_get(count_ptr)
		            var new = iadd(old, 1)
		            // atomic_cas returns the *old* value. Success iff old == expected.
		            if atomic_cas(count_ptr, old, new) == old {
		                if old != 0 { g_runtime_single_threaded = 0 }
		                break
		            }
		        }
	    }
	    return node
	}

// Register a non-OS stack node for GC scanning (native green tasks Stage N1).
//
// This must NOT disable the "single-thread" fast paths: green tasks share a single OS thread
// and run cooperatively, so using global scratch without locks remains safe.
@oren.keep
fn oren_register_stack(top) {
    if oren_globals() == 0 { return 0 }
    // Same node layout as `oren_register_thread`, but flags=0.
    var node = native_malloc_raw_or_mmap(56)
    if node == 0 { return 0 }
    ptr_set(node, top)
    ptr_set(iadd(node, 8), 0) // saved_sp
    ptr_set(iadd(node, 24), 0) // call_depth (unused for stacks today)
    ptr_set(iadd(node, 32), 0) // time_tv_buf (unused)
    ptr_set(iadd(node, 40), 0) // time_abs_buf (unused)
    ptr_set(iadd(node, 48), 0) // flags

    acquire_lock()
    var prev_head = global_get_threads()
    ptr_set(iadd(node, 16), prev_head)
    global_set_threads(node)
    release_lock()
    return node
}

@oren.keep
fn oren_unregister_stack(node) {
    if node == 0 { return 0 }
    if oren_globals() == 0 { return 0 }
    acquire_lock()
    var prev = 0
    var cur = global_get_threads()
    while cur != 0 {
        if cur == node {
            var next = ptr_get(iadd(cur, 16))
            if prev == 0 {
                global_set_threads(next)
            } else {
                ptr_set(iadd(prev, 16), next)
            }
            break
        }
        prev = cur
        cur = ptr_get(iadd(cur, 16))
    }
    release_lock()
    return 0
}

fn get_sp() { return 0 } // Intrinsic

// GC mode toggle (native backend):
// - enabled (default): conservative mark/sweep from stack + registered roots
// - disabled (deterministic/manual): disable scanning/collection; keep tracking so `free()` can reuse blocks
var g_gc_enabled = 1

// Auto-GC (native backend; rolling):
//
// The native runtime GC is conservative mark/sweep. For long-running tools like the compiler
// self-host build (stage2 native), we need a bounded-memory mode so RSS doesn't climb into
// multi‑GB territory.
//
// Strategy:
// - Count tracked allocations in `oren_track_alloc` (compiler inserts it after malloc).
// - When the threshold is reached, set a pending flag.
// - A safepoint (`oren_gc_safepoint`) initiates collection in a safe place.
//
// NOTE: we only auto-collect in single-threaded programs for now. The native GC scans
// stacks without a stop-the-world protocol; collecting while other threads run would be unsafe.
var g_gc_auto_enabled = 0
var g_gc_alloc_threshold = 200000
var g_gc_allocs_since_collect = 0
var g_gc_auto_pending = 0

@oren.keep
fn native_runtime_init_gc_mode(default_enabled) {
    // default_enabled is provided by the compiler from `--no-gc`.
    g_gc_enabled = default_enabled

    // Runtime override: allow disabling GC via environment variable.
    // Any non-empty value disables scanning/collection.
    var v = native_envp_get_value_ptr("OREN_NO_GC")
    if v != 0 {
        if ptr_get_byte(v) != 0 { g_gc_enabled = 0 }
    }

    // Auto-GC policy (opt-in; compiler/test harness can enable via env).
    //
    // Env:
    // - OREN_GC_AUTO=1 enables auto-collection
    // - OREN_GC_ALLOC_THRESHOLD=<n> triggers a collection request after n tracked allocations
    //   (0 disables auto-GC even if OREN_GC_AUTO is set)
    g_gc_auto_enabled = 0
    g_gc_alloc_threshold = 200000
    g_gc_allocs_since_collect = 0
    g_gc_auto_pending = 0

    var v_auto = native_envp_get_value_ptr("OREN_GC_AUTO")
    if v_auto != 0 {
        if ptr_get_byte(v_auto) != 0 && ptr_get_byte(v_auto) != 48 { // not empty and not '0'
            g_gc_auto_enabled = 1
        }
    }

    var v_thr = native_envp_get_value_ptr("OREN_GC_ALLOC_THRESHOLD")
    if v_thr != 0 {
        var thr = native_parse_i64_dec_cstr_or_neg1(v_thr)
        if thr >= 0 { g_gc_alloc_threshold = thr }
    }
    if g_gc_alloc_threshold == 0 { g_gc_auto_enabled = 0 }
    return 0
}

fn native_gc_single_threaded() {
    if oren_globals() == 0 { return true }
    acquire_lock()
    // Treat this as "single OS thread" (not "single stack node"), so green stacks
    // registered for GC scanning do not disable auto-GC / safepoints.
    var THREAD_NODE_FLAG_OS_THREAD = 1
    var count = 0
    var cur = global_get_threads()
    while cur != 0 {
        if (ptr_get(iadd(cur, 48)) & THREAD_NODE_FLAG_OS_THREAD) != 0 {
            count = count + 1
            if count > 1 { break }
        }
        cur = ptr_get(iadd(cur, 16))
    }
    var ok = true
    if count > 1 { ok = false }
    release_lock()
    return ok
}

// --- Stop-the-world (STW) GC safepoints (native runtime; rolling) ---
//
// Goal:
// - Make `oren_gc_collect()` safe once more than one OS thread exists.
//
// Design constraints (Tier‑1):
// - Must be libc-free and cross-platform (uses `oren_wait_on_addr` / `oren_wake_all_addr`).
// - Must not require a full M:N scheduler yet; this is a minimal "park at safepoints" protocol.
//
// Globals storage layout (see `lib/runtime_native/010_channels_globals_consts.oren`):
// - 424: gc_stw_state       (0=running, 1=stop requested, 2=collector preparing)
// - 432: gc_stw_parked      (number of parked OS threads excluding collector)
// - 440: gc_stw_owner_node  (Thread Node pointer of collector, best-effort)
fn native_gc_stw_state_ptr() {
    var g = oren_globals()
    if g == 0 { return 0 }
    return iadd(g, 424)
}
fn native_gc_stw_parked_ptr() {
    var g = oren_globals()
    if g == 0 { return 0 }
    return iadd(g, 432)
}
fn native_gc_stw_owner_ptr() {
    var g = oren_globals()
    if g == 0 { return 0 }
    return iadd(g, 440)
}

fn native_atomic_inc_u64(word_ptr) {
    if word_ptr == 0 { return 0 }
    while true {
        var old = ptr_get(word_ptr)
        var new = iadd(old, 1)
        if atomic_cas(word_ptr, old, new) == old { return new }
    }
    return 0
}

fn native_gc_stw_begin() {
    if oren_globals() == 0 { return 0 }
    var stw_ptr = native_gc_stw_state_ptr()
    var parked_ptr = native_gc_stw_parked_ptr()
    var owner_ptr = native_gc_stw_owner_ptr()
    if stw_ptr == 0 || parked_ptr == 0 || owner_ptr == 0 { return 0 }

    // Claim the STW controller role:
    // - CAS 0->2 ("preparing") so other threads do not park yet (avoids losing parked-count increments).
    // - If another collector is active, wait until the word changes.
    while true {
        var s = ptr_get(stw_ptr)
        if s == 0 {
            if atomic_cas(stw_ptr, 0, 2) == 0 { break }
            continue
        }
        // Best-effort: sleep while state is unchanged.
        oren_wait_on_addr(stw_ptr, s, 1000000)
    }

    // Initialize per-collection coordination state.
    ptr_set(parked_ptr, 0)
    // Identify the collector thread so it does NOT park at safepoints during STW.
    //
    // Why this is required (Tier‑1 correctness):
    // The native backend inserts `oren_gc_safepoint()` into loop headers for long-running
    // compiler/tooling workloads. `native_gc_collect()` (and its helpers like stack scanning)
    // contains loops, so the collector thread can hit an injected safepoint while STW is active.
    //
    // If the collector parks itself (owner not set), STW deadlocks permanently.
    //
    // Robustness:
    // - Prefer the per-OS-thread `sys_gettid()` identity path in `native_time_current_thread_node_or0()`.
    // - If the main thread is not registered yet, register it now (idempotent on Tier‑1).
    var owner_node = native_time_current_thread_node_or0()
    if owner_node == 0 {
        owner_node = oren_register_thread(get_sp())
    }
    ptr_set(owner_ptr, owner_node)

    // Publish the stop request (2->1) and wake threads waiting on the state word.
    ptr_set(stw_ptr, 1)
    oren_wake_all_addr(stw_ptr)

    // Wait for all other OS threads to park.
    var total = global_get_os_thread_count()
    var expected = 0
    if total > 0 { expected = total - 1 }

    while expected > 0 {
        var cur = ptr_get(parked_ptr)
        if cur >= expected { break }
        // Wait until parked count changes (threads wake us when they park).
        oren_wait_on_addr(parked_ptr, cur, 1000000)
    }
    return 0
}

fn native_gc_stw_end() {
    if oren_globals() == 0 { return 0 }
    var stw_ptr = native_gc_stw_state_ptr()
    var parked_ptr = native_gc_stw_parked_ptr()
    var owner_ptr = native_gc_stw_owner_ptr()
    if stw_ptr == 0 || parked_ptr == 0 || owner_ptr == 0 { return 0 }

    // Release: set running and wake all waiters parked on the state word.
    ptr_set(owner_ptr, 0)
    ptr_set(parked_ptr, 0)
    ptr_set(stw_ptr, 0)
    oren_wake_all_addr(stw_ptr)
    return 0
}

fn native_gc_stw_poll_and_park() {
    if oren_globals() == 0 { return 0 }
    var stw_ptr = native_gc_stw_state_ptr()
    if stw_ptr == 0 { return 0 }

    // Fast path: no stop requested.
    var s = ptr_get(stw_ptr)
    if s == 0 { return 0 }

    // If the collector is in "preparing" mode, wait until it transitions (2->1 or 2->0).
    while s == 2 {
        oren_wait_on_addr(stw_ptr, 2, 1000000)
        s = ptr_get(stw_ptr)
    }
    if s == 0 { return 0 }

    // Now s==1: park at safepoint.
    var node = native_time_current_thread_node_or0()
    if node == 0 { return 0 }

    // Collector thread does not park.
    var owner_ptr = native_gc_stw_owner_ptr()
    var owner = 0
    if owner_ptr != 0 { owner = ptr_get(owner_ptr) }
    if owner != 0 {
        // Pointer equality without `==` to avoid any string-aware compare lowering.
        if node - owner == 0 { return 0 }
    }

    // Set saved_sp so GC can scan this non-current thread.
    ptr_set(iadd(node, 8), get_sp())

    // Mark this thread node as parked (bit1 in flags) and bump parked count once.
    var flags_ptr = iadd(node, 48)
    var f = ptr_get(flags_ptr)
    var THREAD_NODE_FLAG_STW_PARKED = 2
    if (f & THREAD_NODE_FLAG_STW_PARKED) == 0 {
        ptr_set(flags_ptr, f | THREAD_NODE_FLAG_STW_PARKED)
        var parked_ptr = native_gc_stw_parked_ptr()
        if parked_ptr != 0 {
            native_atomic_inc_u64(parked_ptr)
            // Wake the collector waiting on parked-count changes.
            oren_wake_all_addr(parked_ptr)
        }
    }

    // Sleep until the collector releases STW (state becomes 0).
    while ptr_get(stw_ptr) == 1 {
        oren_wait_on_addr(stw_ptr, 1, 1000000)
    }

    // Clear saved_sp and parked flag on resume.
    ptr_set(iadd(node, 8), 0)
    ptr_set(flags_ptr, ptr_get(flags_ptr) & -3)
    return 0
}

// --- Allocation index (native runtime) ---
//
// The GC scans large memory ranges conservatively (stack words). A linear scan of the alloc
// registry on every candidate word becomes catastrophically slow for compiler workloads.
//
// Maintain an open-addressing hash table mapping `ptr -> alloc_node` so `oren_find_node`
// is O(1) average.
var g_alloc_index_ptr = 0
var g_alloc_index_cap = 0
var g_alloc_index_len = 0
var g_alloc_index_tomb = 1 // sentinel (not a valid pointer)
// Rolling robustness: set when a probe loop exhausts its cap bound.
// This should be impossible in a healthy open-addressing table (we resize before full),
// so treat it as a corruption signal and rebuild the table on the next lookup.
var g_alloc_index_probe_exhausted = 0

// --- Static kind tracking (native runtime) ---
//
// Some pointers are valid "values" in the native runtime model but should not be treated as
// GC-managed heap allocations (e.g. platform-provided stable pointers or "static" buffers).
//
// Static-kind tracking attaches a lightweight metadata node (40 bytes) to such pointers so
// `oren_find_node(ptr)` can classify them (kind!=0) without forcing a heap copy.
var g_static_allocs = 0

// --- Embedded cstr0 literal membership (native runtime) ---
//
// The native compiler embeds string literals into a single NUL-terminated byte pool ("cstr0").
// Those bytes live in the binary's data segment and MUST NOT be tracked as GC allocations:
// - tracking them as alloc-nodes makes GC conservatively "see" literals as heap pointers,
//   inflating mark work in compiler workloads
// - allocating per-literal tracking nodes can be a startup hotspot for large binaries
//
// Instead, we build a dedicated open-addressing set of literal start pointers at process entry.
// This lets runtime code safely answer "is this pointer a string?" without creating alloc nodes.
var g_cstr0_set_ptr = 0
var g_cstr0_set_cap = 0
var g_cstr0_set_len = 0
// Optional quick reject for pointer-like integers: if outside [min,max], it cannot be a cstr0 literal.
var g_cstr0_min_ptr = 0
var g_cstr0_max_ptr = 0

fn native_alloc_index_mmap_table(bytes) {
    // IMPORTANT (Tier‑1 correctness):
    // Allocate the alloc-index table via a dedicated anonymous mmap instead of `malloc_raw`.
    //
    // Why:
    // - On arm64 native, the rolling bump allocator for `malloc_raw` shares machinery with the GC heap.
    // - A single overlap/corruption bug can cause the index table (raw metadata) to alias tracked nodes,
    //   making `oren_find_node` crash after a GC sweep.
    //
    // By pinning the table in its own mapping, we eliminate aliasing with tracked allocations.
    var q = sys_mmap_private_anon(bytes)
    if q == 0 { exit(311) }
    if q == -1 { exit(312) }
    if q < 0 { exit(313) }
    if q < 4096 { exit(314) }
    return q
}

fn native_alloc_index_hash(ptr) {
    // Multiplicative hash (Knuth) for 64-bit keys. Shift away low alignment bits.
    var x = ptr / 16
    return x * 11400714819323198485
}

fn native_cstr0_set_clear(table_ptr, cap) {
    if table_ptr == 0 { return 0 }
    var i = 0
    while i < cap {
        ptr_set(iadd(table_ptr, i << 3), 0)
        i = i + 1
    }
    return 0
}

fn native_cstr0_set_init_min(min_cap) {
    if g_cstr0_set_cap != 0 { return 0 }
    var cap = 1024
    if min_cap != nil && min_cap > cap {
        // Round up by doubling from a power-of-two seed (mirrors alloc-index init policy).
        // NOTE: do not try to "power-of-two normalize" by repeatedly doubling a non-power-of-two
        // value; that never converges.
        while cap < min_cap { cap = cap * 2 }
    }

    // Keep mmap size bounded in pathological builds (rolling safety).
    // cap is entry count (u64 slots), table size is cap*8 bytes.
    if cap > 4194304 { cap = 4194304 } // 32 MiB table

    var table = native_alloc_index_mmap_table(cap << 3)
    if table == 0 { return 0 }
    native_cstr0_set_clear(table, cap)
    g_cstr0_set_ptr = table
    g_cstr0_set_cap = cap
    g_cstr0_set_len = 0
    g_cstr0_min_ptr = 0
    g_cstr0_max_ptr = 0
    return 0
}

fn native_cstr0_set_put(ptr) {
    if ptr == 0 { return 0 }
    if ptr < 4096 { return 0 }
    if g_cstr0_set_ptr == 0 || g_cstr0_set_cap == 0 { return 0 }
    var mask = g_cstr0_set_cap - 1
    var idx = native_alloc_index_hash(ptr) & mask
    var rem = g_cstr0_set_cap
    while true {
        if rem <= 0 { return 0 }
        rem = rem - 1
        var slot = ptr_get(iadd(g_cstr0_set_ptr, idx << 3))
        if slot == 0 {
            ptr_set(iadd(g_cstr0_set_ptr, idx << 3), ptr)
            g_cstr0_set_len = iadd(g_cstr0_set_len, 1)
            // Track min/max for quick reject.
            // IMPORTANT: avoid pointer-vs-pointer `<`/`>` here. On x64, comparisons can lower
            // through string-aware compare which consults `native_is_string_ptr` and can recurse.
            if g_cstr0_min_ptr == 0 {
                g_cstr0_min_ptr = ptr
            } else {
                if (ptr - g_cstr0_min_ptr) < 0 { g_cstr0_min_ptr = ptr }
            }
            if g_cstr0_max_ptr == 0 {
                g_cstr0_max_ptr = ptr
            } else {
                if (ptr - g_cstr0_max_ptr) > 0 { g_cstr0_max_ptr = ptr }
            }
            return 0
        }
        if slot - ptr == 0 { return 0 }
        idx = iadd(idx, 1) & mask
    }
    return 0
}

fn native_cstr0_set_has(ptr) {
    if ptr == 0 { return 0 }
    if ptr < 4096 { return 0 }
    if g_cstr0_set_ptr == 0 || g_cstr0_set_cap == 0 { return 0 }
    // Quick reject for obvious non-pointers (and most integer values).
    // IMPORTANT: avoid pointer-vs-pointer `<`/`>` here (see note in `native_cstr0_set_put`).
    if g_cstr0_min_ptr != 0 {
        if (ptr - g_cstr0_min_ptr) < 0 { return 0 }
    }
    if g_cstr0_max_ptr != 0 {
        if (ptr - g_cstr0_max_ptr) > 0 { return 0 }
    }

    var mask = g_cstr0_set_cap - 1
    var idx = native_alloc_index_hash(ptr) & mask
    var rem = g_cstr0_set_cap
    while true {
        if rem <= 0 { return 0 }
        rem = rem - 1
        var slot = ptr_get(iadd(g_cstr0_set_ptr, idx << 3))
        if slot == 0 { return 0 }
        if slot - ptr == 0 { return 1 }
        idx = iadd(idx, 1) & mask
    }
    return 0
}

@oren.keep
fn native_is_string_ptr(ptr) {
    // Return 1 iff `ptr` is safe to treat as a C string in native v0:
    // - tracked heap string allocation (kind=1)
    // - embedded cstr0 literal start pointer (from the program's data blob)
    if ptr == 0 { return 0 }
    if ptr < 4096 { return 0 }

    // Fast path: tracked heap string kind.
    var node = native_alloc_index_get(ptr)
    if node != 0 {
        var k = ptr_get(iadd(node, 16))
        if k == 1 { return 1 }
    }

    // Fast path: embedded literal membership.
    if native_cstr0_set_has(ptr) != 0 { return 1 }
    return 0
}

fn native_alloc_index_clear(table_ptr, cap) {
    if table_ptr == 0 { return 0 }
    var i = 0
    while i < cap {
        // Use shift instead of multiply (native backend mul lowering is still rolling in some paths).
        ptr_set(iadd(table_ptr, i << 3), 0)
        i = i + 1
    }
    return 0
}

fn native_alloc_index_init_min(min_cap) {
    if g_alloc_index_cap != 0 { return 0 }
    var cap = 1024
    if min_cap != nil && min_cap > cap { cap = min_cap }
    // Ensure power-of-two cap (keep it simple: round up by doubling).
    //
    // IMPORTANT:
    // Parenthesize the bit-test so it parses as:
    //   (cap & (cap - 1)) != 0
    // rather than:
    //   cap & ((cap - 1) != 0)
    while (cap & (cap - 1)) != 0 { cap = cap * 2 }
    var table = native_alloc_index_mmap_table(cap * 8)
    if table == 0 { return 0 }
    native_alloc_index_clear(table, cap)
    g_alloc_index_ptr = table
    g_alloc_index_cap = cap
    g_alloc_index_len = 0
    return 0
}

fn native_alloc_index_get(ptr) {
    if ptr == 0 { return 0 }
    if ptr < 4096 { return 0 }
    if g_alloc_index_ptr == 0 || g_alloc_index_cap == 0 { return 0 }
    var mask = g_alloc_index_cap - 1
    var idx = native_alloc_index_hash(ptr) & mask
    // Bound probing to avoid non-termination if the table becomes corrupted or saturated.
    // If we cannot find an empty slot within `cap` probes, treat as a miss.
    var rem = g_alloc_index_cap
    while true {
        if rem <= 0 {
            g_alloc_index_probe_exhausted = 1
            return 0
        }
        rem = rem - 1
        var slot = ptr_get(iadd(g_alloc_index_ptr, idx << 3))
        if slot == 0 { return 0 }
        // IMPORTANT (Tier‑1 correctness):
        // Avoid `slot != g_alloc_index_tomb` here.
        //
        // On some native backends, `==/!=` can lower to a string-aware compare that consults
        // tracking metadata. That compare uses `native_alloc_index_get`, which would recurse
        // back into this function and stack-overflow during early runtime init.
        //
        // Use arithmetic + compare-to-0 so the backend can lower it as a raw integer compare.
        if slot - g_alloc_index_tomb != 0 {
            // Rolling safety: treat any non-pointer slot payload as a tombstone.
            // This prevents segfaults if a buggy codegen path scribbles over the table.
            if slot < 4096 {
