// --- Binary I/O (byte-accurate) ---
// Note: implemented via syscalls (see codegen intrinsics for sys_open/sys_read/sys_write/sys_close).

@cap.requires(domain="FS")
fn oren_write_bytes(path, bytes) {
    var pair = native_capsule_fs_path_resolve_pair(path, 1)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    var flags = 1 | OREN_O_CREAT | OREN_O_TRUNC // WRONLY|CREAT|TRUNC (Oren-level flags)
    var fd = sys_open(rpath, flags, 420) // 0644
    if fd < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - fd, "write_bytes: sys_open failed")
    }

    var n = 0
    var buf = 0
    var owned_buf = 0

    if native_bytes_is_u8_buf(bytes) == true {
        // Zero-copy write from typed buffer payload.
        n = ptr_get(bytes + 0)
        if n > 0 {
            buf = native_buf_data_ptr(bytes)
            if buf == 0 {
                sys_close(fd)
                if owned == 1 { free(rpath) }
                return oren_err(4, "write_bytes: u8_buf payload is nil")
            }
        }
    } else {
        // Legacy path: list<int 0..255>
        n = oren_list_len(bytes)
        if n > 0 {
            buf = malloc(n)
            owned_buf = 1
            if buf == 0 {
                sys_close(fd)
                if owned == 1 { free(rpath) }
                return oren_err(12, "write_bytes: alloc failed")
            }
            var i = 0
            while i < n {
                var v = bytes[i]
                if v < 0 || v > 255 {
                    sys_close(fd)
                    free(buf)
                    if owned == 1 { free(rpath) }
                    return oren_err(4, "write_bytes: byte out of range")
                }
                ptr_set_byte(buf + i, v)
                i = i + 1
            }
        }
    }

    if n > 0 {
        // Handle short writes and propagate errno deterministically.
        var off = 0
        while off < n {
            var wn = sys_write(fd, buf + off, n - off)
            if wn < 0 {
                sys_close(fd)
                if owned_buf == 1 { free(buf) }
                if owned == 1 { free(rpath) }
                return oren_err(0 - wn, "write_bytes: sys_write failed")
            }
            if wn == 0 {
                sys_close(fd)
                if owned_buf == 1 { free(buf) }
                if owned == 1 { free(rpath) }
                return oren_err(5, "write_bytes: sys_write made no progress")
            }
            off = off + wn
        }
    }
    if owned_buf == 1 { free(buf) }

    var crc = sys_close(fd)
    if crc < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - crc, "write_bytes: sys_close failed")
    }
    if owned == 1 { free(rpath) }
    return 0
}

@cap.requires(domain="FS")
fn oren_read_bytes(path) {
    var pair = native_capsule_fs_path_resolve_pair(path, 0)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    var st = oren_stat_alloc()
    var src = sys_stat(rpath, st)
    if src < 0 {
        free(st)
        if owned == 1 { free(rpath) }
        return oren_err(0 - src, "read_bytes: sys_stat failed")
    }
    var size = oren_stat_get_size(st)
    free(st)
    if size < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(4, "read_bytes: invalid size")
    }
    if size > 2147483647 {
        if owned == 1 { free(rpath) }
        return oren_err(4, "read_bytes: file too large")
    }

    var fd = sys_open(rpath, 0, 0) // O_RDONLY
    if fd < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - fd, "read_bytes: sys_open failed")
    }

    var out = oren_new_list_int(size)
    var out_buf = ptr_get(iadd(out, 16))
    if size == 0 {
        var crc0 = sys_close(fd)
        if crc0 < 0 {
            if owned == 1 { free(rpath) }
            return oren_err(0 - crc0, "read_bytes: sys_close failed")
        }
        if owned == 1 { free(rpath) }
        return out
    }
    var buf = malloc(1048576)
    if buf == 0 {
        sys_close(fd)
        if owned == 1 { free(rpath) }
        return oren_err(12, "read_bytes: alloc failed")
    }

    var off = 0
    while off < size {
        var want = size - off
        if want > 1048576 { want = 1048576 }
        var rn = sys_read(fd, buf, want)
        if rn < 0 {
            sys_close(fd)
            free(buf)
            if owned == 1 { free(rpath) }
            return oren_err(0 - rn, "read_bytes: sys_read failed")
        }
        if rn == 0 {
            sys_close(fd)
            free(buf)
            if owned == 1 { free(rpath) }
            return oren_err(5, "read_bytes: unexpected EOF")
        }
        var i = 0
        while i < rn {
            ptr_set(iadd(out_buf, (off + i) * 8), ptr_get_byte(buf + i))
            i = i + 1
        }
        off = off + rn
    }
    ptr_set(iadd(out, 0), size)

    free(buf)
    var crc = sys_close(fd)
    if crc < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - crc, "read_bytes: sys_close failed")
    }
    if owned == 1 { free(rpath) }
    return out
}

@cap.requires(domain="FS")
fn oren_read_u8_buf(path) {
    // Read a file into a typed byte buffer (u8_buf) without boxing each byte as an int.
    // This is critical for compiler pipelines that hash/cache large artifacts.
    var pair = native_capsule_fs_path_resolve_pair(path, 0)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    // Stat size first so we can do a single allocation.
    var st = oren_stat_alloc()
    var src = sys_stat(rpath, st)
    if src < 0 {
        free(st)
        if owned == 1 { free(rpath) }
        // IMPORTANT (tooling / caches):
        // Missing files must not hard-exit the process; compiler caches probe optional
        // paths and treat ENOENT as a normal cache miss.
        return oren_err(0 - src, "read_u8_buf: sys_stat failed")
    }
    var size = oren_stat_get_size(st)
    free(st)
    if size < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(4, "read_u8_buf: invalid size")
    }
    // Guard against pathological sizes (u8_buf len is u32).
    if size > 4294967295 {
        if owned == 1 { free(rpath) }
        return oren_err(4, "read_u8_buf: file too large")
    }

    var fd = sys_open(rpath, 0, 0) // O_RDONLY
    if fd < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - fd, "read_u8_buf: sys_open failed")
    }

    // Allocate uninitialized: we immediately overwrite every byte via `sys_read`.
    // This avoids an O(n) byte-zeroing loop in `native_buf_new` for ~MiB buffers,
    // which can dominate compiler IO (rtobj cache reads, hashing).
    var out = oren_u8_buf_new_uninit(size)
    if oren_is_err(out) {
        sys_close(fd)
        if owned == 1 { free(rpath) }
        return out
    }
    var off = 0
    while off < size {
        var want = size - off
        // Use a larger chunk size to reduce syscall/loop overhead in compiler workloads
        // (rtobj cache reads, hashing, etc). Short reads are still handled correctly.
        if want > 1048576 { want = 1048576 } // 1 MiB
        // `out` is a fresh u8_buf allocated by the runtime, so we can skip the
        // heavier `native_buf_check` in the hot read loop.
        var rn = sys_read_u8_buf_unchecked(fd, out, off, want)
        if rn < 0 {
            sys_close(fd)
            if owned == 1 { free(rpath) }
            return oren_err(0 - rn, "read_u8_buf: sys_read failed")
        }
        if rn == 0 {
            // Unexpected EOF: keep behavior deterministic by failing fast.
            sys_close(fd)
            if owned == 1 { free(rpath) }
            return oren_err(5, "read_u8_buf: unexpected EOF")
        }
        off = off + rn
    }

    var crc = sys_close(fd)
    if crc < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - crc, "read_u8_buf: sys_close failed")
    }
    if owned == 1 { free(rpath) }
    return out
}

// Text I/O helpers (portable names used by the compiler and stdlib).
//
// Native backend representation notes:
// - string is a raw pointer to a NUL-terminated byte sequence
// - bytes is a list<int 0..255>
//
// These helpers bridge the two by using existing `*_bytes` and conversion helpers.

@cap.requires(domain="FS")
fn oren_read_file(path) {
    // Returns a string pointer (NUL-terminated).
    //
    // IMPORTANT (performance, compiler self-hosting):
    // The compiler reads a lot of source code. Reading via `oren_read_bytes` (list<int>)
    // boxes every byte and can be catastrophically slow under the native runtime.
    //
    // Prefer a direct bulk-read into a single malloc'd NUL-terminated buffer.
    // This keeps the string representation correct while avoiding typed-buffer plumbing
    // in the compiler hot path.
    //
    // Failure behavior:
    // - return an error map (do NOT hard-exit)
    // This must match the C runtime contract: compiler caches probe optional paths
    // and treat ENOENT as a normal cache miss.
    var trace = native_envp_get_value_ptr("OREN_TRACE_READ_FILE")
    if trace != 0 {
        print("[read_file] path=" + path)
    }
    var pair = native_capsule_fs_path_resolve_pair(path, 0)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)
    if trace != 0 {
        print("[read_file] resolve done owned=" + oren_int_to_string(owned))
    }

    // Stat size first so we can do a single allocation and a bounded read loop.
    var st = oren_stat_alloc()
    var src = sys_stat(rpath, st)
    if src < 0 {
        free(st)
        if owned == 1 { free(rpath) }
        if trace != 0 { print("[read_file] sys_stat failed rc=" + oren_int_to_string(src)) }
        return oren_err(0 - src, "read_file: sys_stat failed")
    }
    var size = oren_stat_get_size(st)
    free(st)
    if size < 0 {
        if owned == 1 { free(rpath) }
        if trace != 0 { print("[read_file] invalid size") }
        return oren_err(4, "read_file: invalid size")
    }
    if trace != 0 { print("[read_file] size=" + oren_int_to_string(size)) }

    var fd = sys_open(rpath, 0, 0) // O_RDONLY
    if fd < 0 {
        if owned == 1 { free(rpath) }
        if trace != 0 { print("[read_file] sys_open failed rc=" + oren_int_to_string(fd)) }
        return oren_err(0 - fd, "read_file: sys_open failed")
    }

    // Allocate string buffer (+1 for NUL).
    var out = malloc(size + 1)
    if out == 0 {
        sys_close(fd)
        if owned == 1 { free(rpath) }
        return oren_err(12, "read_file: alloc failed")
    }

    var off = 0
    while off < size {
        var want = size - off
        if want > 1048576 { want = 1048576 } // 1 MiB
        var rn = sys_read(fd, out + off, want)
        if rn < 0 {
            sys_close(fd)
            if owned == 1 { free(rpath) }
            free(out)
            return oren_err(0 - rn, "read_file: sys_read failed")
        }
        if rn == 0 {
            // Unexpected EOF: keep behavior deterministic by failing fast.
            sys_close(fd)
            if owned == 1 { free(rpath) }
            free(out)
            return oren_err(5, "read_file: unexpected EOF")
        }
        off = off + rn
    }

    ptr_set_byte(out + size, 0)
    oren_track_alloc(out, size + 1, 1) // STRING
    var crc = sys_close(fd)
    if crc < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - crc, "read_file: sys_close failed")
    }

    if owned == 1 { free(rpath) }
    return out
}

@cap.requires(domain="FS")
fn oren_write_file(path, content) {
    // Write a native string directly as bytes without materializing list<int>.
    var pair = native_capsule_fs_path_resolve_pair(path, 1)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    var flags = 1 | OREN_O_CREAT | OREN_O_TRUNC // WRONLY|CREAT|TRUNC (Oren-level flags)
    var fd = sys_open(rpath, flags, 420) // 0644
    if fd < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - fd, "write_file: sys_open failed")
    }

    var n = oren_string_len(content)
    if n > 0 {
        var off = 0
        while off < n {
            var wn = sys_write(fd, content + off, n - off)
            if wn < 0 {
                sys_close(fd)
                if owned == 1 { free(rpath) }
                return oren_err(0 - wn, "write_file: sys_write failed")
            }
            if wn == 0 {
                sys_close(fd)
                if owned == 1 { free(rpath) }
                return oren_err(5, "write_file: sys_write made no progress")
            }
            off = off + wn
        }
    }

    var crc = sys_close(fd)
    if crc < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - crc, "write_file: sys_close failed")
    }
    if owned == 1 { free(rpath) }
    return 0
}

@cap.requires(domain="FS")
fn oren_append_file(path, content) {
    // Append a native string directly as bytes. Used by dense compiler phase
    // tracing so logging does not repeatedly read and rewrite the whole file.
    var pair = native_capsule_fs_path_resolve_pair(path, 1)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    var flags = 1 | OREN_O_CREAT | OREN_O_APPEND // WRONLY|CREAT|APPEND (Oren-level flags)
    var fd = sys_open(rpath, flags, 420) // 0644
    if fd < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - fd, "append_file: sys_open failed")
    }

    var n = oren_string_len(content)
    if n > 0 {
        var off = 0
        while off < n {
            var wn = sys_write(fd, content + off, n - off)
            if wn < 0 {
                sys_close(fd)
                if owned == 1 { free(rpath) }
                return oren_err(0 - wn, "append_file: sys_write failed")
            }
            if wn == 0 {
                sys_close(fd)
                if owned == 1 { free(rpath) }
                return oren_err(5, "append_file: sys_write made no progress")
            }
            off = off + wn
        }
    }

    var crc = sys_close(fd)
    if crc < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - crc, "append_file: sys_close failed")
    }
    if owned == 1 { free(rpath) }
    return 0
}

@cap.requires(domain="FS")
fn oren_chmod(path, mode) {
    // Set permissions on a file or directory.
    //
    // Used by the compiler to set the executable bit on generated binaries.
    // Lowered to a syscall by the native backend (with capsule FS enforcement).
    return sys_chmod(path, mode)
}

fn _oren_path_is_sep(ch) {
    if ch == 47 { return true } // '/'
    if ch == 92 { return true } // '\\'
    return false
}

fn _oren_mode_is_dir(mode) {
    // POSIX file type mask (0170000) and directory bit (0040000).
    //
    // `sys_stat` writes a stable OrenStatV0 ABI where `mode` is a u32 with POSIX-like bits.
    // This keeps `mkdir -p` semantics correct (EEXIST only ignored for directories).
    var ft = mode & 61440 // 0170000
    if ft == 16384 { return true } // 0040000
    return false
}

fn _oren_mode_is_reg(mode) {
    // POSIX regular file: 0100000 (32768) under 0170000 mask.
    var ft = mode & 61440 // 0170000
    if ft == 32768 { return true } // 0100000
    return false
}

fn _oren_norm_sep_for_target(ch) {
    // Normalize path separators for the target OS.
    // Windows: prefer '\\' for syscalls.
    if g_target_os == 3 {
        if ch == 47 { return 92 } // '/' -> '\\'
    }
    return ch
}

@cap.requires(domain="FS")
fn oren_is_file(path) {
    // Returns true if the path exists and is a regular file, else false.
    // Uses sys_stat to follow symlinks (matches `test -f` behavior).
    if path == 0 { return false }
    if ptr_get_byte(path) == 0 { return false }

    var pair = native_capsule_fs_path_resolve_pair(path, 0)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    var st = oren_stat_alloc()
    var rc = sys_stat(rpath, st)
    if rc < 0 {
        free(st)
        if owned == 1 { free(rpath) }
        return false
    }
    var mode = oren_stat_get_mode(st)
    free(st)
    if owned == 1 { free(rpath) }
    return _oren_mode_is_reg(mode)
}

@cap.requires(domain="FS")
fn _oren_is_dir(path) {
    if path == 0 { return false }
    if ptr_get_byte(path) == 0 { return false }
    var st = oren_stat_alloc()
    var rc = sys_stat(path, st)
    if rc < 0 {
        free(st)
        return false
    }
    var mode = oren_stat_get_mode(st)
    free(st)
    return _oren_mode_is_dir(mode)
}

@cap.requires(domain="FS")
fn oren_mkdir_p(path) {
    // Recursive directory creation.
    //
    // Return convention (syscall-like):
    // - 0 on success
    // - negative errno on failure
    if path == 0 { return 0 }
    if ptr_get_byte(path) == 0 { return 0 }

    var n = oren_string_len(path)
    if n <= 0 { return 0 }

    var buf = malloc(n + 1)
    if buf == 0 { return 0 - 12 } // -ENOMEM
    var i = 0
    while i < n {
        var ch = ptr_get_byte(path + i)
        ptr_set_byte(buf + i, _oren_norm_sep_for_target(ch))
        i = i + 1
    }
    ptr_set_byte(buf + n, 0)

    var mode = 493 // 0755

    i = 0
    while i < n {
        var ch = ptr_get_byte(buf + i)
        if _oren_path_is_sep(ch) {
            if i != 0 {
                // Skip repeated separators to avoid empty segments.
                var prev = ptr_get_byte(buf + (i - 1))
                if _oren_path_is_sep(prev) != true {
                    // Skip drive prefix "C:\" on Windows-style paths.
                    if i == 2 && ptr_get_byte(buf + 1) == 58 {
                        // no-op
                    } else {
                        ptr_set_byte(buf + i, 0)
                        // mkdir -p should treat the current directory "." as a no-op segment.
                        // This matters on Windows, where attempting to sys_mkdir(".") can return
                        // -EEXIST but sys_stat(".") may not reliably report as a directory in our
                        // minimal FS bridge, causing spurious failures in compiler tooling.
                        var rc = 0
                        if ptr_get_byte(buf) != 46 || ptr_get_byte(buf + 1) != 0 {
                            rc = sys_mkdir(buf, mode)
                        }
                        if rc < 0 {
                            if rc == 0 - 17 { // -EEXIST
                                // Do not call `_oren_is_dir` here: on x64-windows the native backend
                                // has had correctness issues around some bool-returning function calls,
                                // which can make `_oren_is_dir(...)` spuriously return false even when
                                // `sys_stat` reports a directory. Inline the stat+mode check instead.
                                var stx = oren_stat_alloc()
                                var srx = sys_stat(buf, stx)
                                if srx < 0 {
                                    free(stx)
                                    free(buf)
                                    return rc
                                }
                                var modex = oren_stat_get_mode(stx)
                                free(stx)
                                if _oren_mode_is_dir(modex) != true {
                                    free(buf)
                                    return rc
                                }
                            } else {
                                free(buf)
                                return rc
                            }
                        }
                        ptr_set_byte(buf + i, ch)
                    }
                }
            }
        }
        i = i + 1
    }

    var rc2 = 0
    if ptr_get_byte(buf) != 46 || ptr_get_byte(buf + 1) != 0 {
        rc2 = sys_mkdir(buf, mode)
    }
    if rc2 < 0 {
        if rc2 == 0 - 17 {
            // Same as above: inline stat+mode check instead of calling `_oren_is_dir`.
            var st2 = oren_stat_alloc()
            var sr2 = sys_stat(buf, st2)
            if sr2 < 0 {
                free(st2)
                free(buf)
                return rc2
            }
            var mode2 = oren_stat_get_mode(st2)
            free(st2)
            if _oren_mode_is_dir(mode2) != true {
                free(buf)
                return rc2
            }
        } else {
            free(buf)
            return rc2
        }
    }
    free(buf)
    return 0
}

@cap.requires(domain="FS")
fn oren_unlink(path) {
    // rm -f semantics for files:
    // - 0 on success
    // - 0 if path does not exist
    // - negative errno otherwise
    if path == 0 { return 0 }
    if ptr_get_byte(path) == 0 { return 0 }
    var rc = sys_unlink(path)
    if rc < 0 {
        if rc == 0 - 2 { return 0 } // -ENOENT
        return rc
    }
    return 0
}

@cap.requires(domain="FS")
fn oren_rmdir(path) {
    // Best-effort directory removal:
    // - 0 on success
    // - 0 if path does not exist
    // - negative errno otherwise
    if path == 0 { return 0 }
    if ptr_get_byte(path) == 0 { return 0 }
    var rc = sys_rmdir(path)
    if rc < 0 {
        if rc == 0 - 2 { return 0 } // -ENOENT
        return rc
    }
    return 0
}

fn _oren_path_join(a, b) {
    if a == 0 || b == 0 { return 0 }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la <= 0 { return b }
    if lb <= 0 { return a }

    var last = ptr_get_byte(a + (la - 1))
    var need_sep = true
    if _oren_path_is_sep(last) { need_sep = false }

    var sep = 47 // '/'
    if g_target_os == 3 { sep = 92 } // '\\'

    var extra = 0
    if need_sep { extra = 1 }
    var out = malloc(la + extra + lb + 1)
    if out == 0 { exit(302) }
    var i = 0
    while i < la {
        ptr_set_byte(out + i, _oren_norm_sep_for_target(ptr_get_byte(a + i)))
        i = i + 1
    }
    var off = la
    if need_sep {
        ptr_set_byte(out + off, sep)
        off = off + 1
    }
    var j = 0
    while j < lb {
        ptr_set_byte(out + off + j, _oren_norm_sep_for_target(ptr_get_byte(b + j)))
        j = j + 1
    }
    ptr_set_byte(out + off + lb, 0)
    oren_track_alloc(out, la + extra + lb + 1, 1) // STRING
    return out
}

fn _oren_lstat_mode(path) {
    var st = oren_stat_alloc()
    var rc = sys_lstat(path, st)
    if rc < 0 {
        free(st)
        return [rc, 0]
    }
    var mode = oren_stat_get_mode(st)
    free(st)
    return [0, mode]
}

@cap.requires(domain="FS")
fn oren_rm_rf(path) {
    // Recursive delete (rm -rf semantics).
    // - 0 on success (including missing paths)
    // - negative errno on failure
    if path == 0 { return 0 }
    if ptr_get_byte(path) == 0 { return 0 }

    var pair = _oren_lstat_mode(path)
    var rc = pair[0]
    var mode = pair[1]
    if rc < 0 {
        if rc == 0 - 2 { return 0 } // -ENOENT
        return rc
    }

    if _oren_mode_is_dir(mode) == true {
        var ents = oren_readdir(path)
        if oren_is_err(ents) {
            var code = oren_err_code(ents)
            if code == 2 { return 0 } // missing
            return 0 - code
        }
        var n = oren_list_len(ents)
        var i = 0
        while i < n {
            var name = ents[i]
            // Skip '.' and '..' defensively.
            if name != "." && name != ".." {
                var child = _oren_path_join(path, name)
                var rr = oren_rm_rf(child)
                if rr < 0 { return rr }
            }
            i = i + 1
        }
        var rd = sys_rmdir(path)
        if rd < 0 {
            if rd == 0 - 2 { return 0 }
            return rd
        }
        return 0
    }

    return oren_unlink(path)
}

@cap.requires(domain="FS")
fn oren_rename(from, to) {
    // Rename a filesystem entry.
    //
    // Return convention (syscall-like): 0 on success, negative errno on failure.
    // The syscall lowering already applies capsule FS enforcement for sys_rename.
    return sys_rename(from, to)
}


@cap.requires(domain="FS")
fn oren_readdir(path) {
    // Returns a list of entry names (strings) in the directory at `path`.
    // Implemented via syscalls (sys_open + sys_getdirentries64 + sys_close) and is capsule-safe.
    //
    // Record formats supported (detected per-entry):
    // - Darwin: struct dirent64 (sys/dirent.h): name @ +21, namlen @ +18 (u16)
    // - Linux:  linux_dirent64 (getdents64):      name @ +19, no namlen field

    var pair = native_capsule_fs_path_resolve_pair(path, 0)
    var rpath = ptr_get(pair + 0)
    var owned = ptr_get(pair + 8)
    free(pair)

    var fd = sys_open(rpath, 0, 0) // O_RDONLY
    if fd < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - fd, "readdir: sys_open failed")
    }

    var out = oren_new_list(0)

    var buf = malloc(4096)
    if buf == 0 {
        sys_close(fd)
        if owned == 1 { free(rpath) }
        return oren_err(12, "readdir: alloc failed")
    }

    var pos = malloc(8)
    if pos == 0 {
        sys_close(fd)
        free(buf)
        if owned == 1 { free(rpath) }
        return oren_err(12, "readdir: alloc failed")
    }
    ptr_set(pos, 0)

    while 1 {
        var n = sys_getdirentries64(fd, buf, 4096, pos)
        if n == 0 { break }
        if n < 0 {
            sys_close(fd)
            free(pos)
            free(buf)
            if owned == 1 { free(rpath) }
            return oren_err(0 - n, "readdir: sys_getdirentries64 failed")
        }

        var off = 0
        while off < n {
            // d_reclen is u16 little-endian at offset 16 in both Darwin and Linux formats.
            var r0 = ptr_get_byte(buf + off + 16)
            var r1 = ptr_get_byte(buf + off + 17)
            var reclen = r0 | (r1 << 8)
            if reclen <= 0 { break }
            if off + reclen > n { break }

            // Try Darwin format first (has namlen u16 at +18).
            var b18 = ptr_get_byte(buf + off + 18)
            var b19 = ptr_get_byte(buf + off + 19)
            var namlen = b18 | (b19 << 8)

            var name_ptr = buf + off + 19
            var name_len = 0

            // Darwin: name starts at +21 and namlen must fit in record.
            if namlen >= 0 {
                if 21 + namlen <= reclen {
                    name_ptr = buf + off + 21
                    name_len = namlen
                }
            }

            // Linux fallback: name starts at +19 and is NUL-terminated.
            if name_len == 0 {
                name_ptr = buf + off + 19
                var max_len = reclen - 19
                var k = 0
                while k < max_len {
                    if ptr_get_byte(name_ptr + k) == 0 { break }
                    k = k + 1
                }
                name_len = k
            }

            // Skip empty / '.' / '..'
            var skip = false
            if name_len <= 0 { skip = true }
            if skip != true {
                if name_len == 1 {
                    if ptr_get_byte(name_ptr) == 46 { skip = true }
                }
                if name_len == 2 {
                    if ptr_get_byte(name_ptr) == 46 {
                        if ptr_get_byte(name_ptr + 1) == 46 { skip = true }
                    }
                }
            }

            if skip != true {
                var s2 = malloc(name_len + 1)
                if s2 == 0 {
                    sys_close(fd)
                    free(pos)
                    free(buf)
                    if owned == 1 { free(rpath) }
                    return oren_err(12, "readdir: alloc failed")
                }
                if name_len > 0 { oren_memcpy(s2, name_ptr, name_len) }
                ptr_set_byte(s2 + name_len, 0)
                oren_track_alloc(s2, name_len + 1, 1) // STRING
                oren_list_push(out, s2)
            }

            off = off + reclen
        }
    }

    free(pos)
    free(buf)
    var crc = sys_close(fd)
    if crc < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(0 - crc, "readdir: sys_close failed")
    }
    if owned == 1 { free(rpath) }
    return out
}
