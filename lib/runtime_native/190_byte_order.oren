// --- Byte-order helpers (network parsing / serialization) ---
//
// In native v0, "bytes" are typically `list<int 0..255>`.
// These helpers are deterministic and libc-free.

// Pointer byte-order helpers (native syscall-first path).
//
// Use case:
// - syscalls read into a raw pointer buffer (returned by malloc)
// - libraries parse/serialize structured packets directly from/to that buffer
//
// IMPORTANT:
// - These functions do NOT bounds-check (they only have a pointer, no length).
// - They are unaligned-safe because they use ptr_get_byte/ptr_set_byte.
// - All encodings are canonical little-endian in memory when using *_le helpers,
//   and big-endian for *_be helpers.
//
// NOTE: like the list<bytes> helpers, `u64` values above MAX_I64 are not representable
// in v0's signed int container; the bit pattern is still correct for negative values.

fn oren_ptr_get_u8(p) { return ptr_get_byte(p) & 255 }
fn oren_ptr_set_u8(p, v) { ptr_set_byte(p, v & 255); return v & 255 }

fn oren_ptr_get_u16_be(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    return (b0 << 8) | b1
}
fn oren_ptr_get_u16_le(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    return (b1 << 8) | b0
}
fn oren_ptr_get_i16_be(p) {
    var u = oren_ptr_get_u16_be(p)
    if u >= 32768 { return u - 65536 }
    return u
}
fn oren_ptr_get_i16_le(p) {
    var u = oren_ptr_get_u16_le(p)
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_ptr_set_u16_be(p, v) {
    var u = v & 65535
    oren_ptr_set_u8(p + 0, (u >> 8) & 255)
    oren_ptr_set_u8(p + 1, u & 255)
    return u
}
fn oren_ptr_set_u16_le(p, v) {
    var u = v & 65535
    oren_ptr_set_u8(p + 0, u & 255)
    oren_ptr_set_u8(p + 1, (u >> 8) & 255)
    return u
}
fn oren_ptr_set_i16_be(p, v) {
    var u = v & 65535
    oren_ptr_set_u8(p + 0, (u >> 8) & 255)
    oren_ptr_set_u8(p + 1, u & 255)
    if u >= 32768 { return u - 65536 }
    return u
}
fn oren_ptr_set_i16_le(p, v) {
    var u = v & 65535
    oren_ptr_set_u8(p + 0, u & 255)
    oren_ptr_set_u8(p + 1, (u >> 8) & 255)
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_ptr_get_u32_be(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    var b2 = oren_ptr_get_u8(p + 2)
    var b3 = oren_ptr_get_u8(p + 3)
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}
fn oren_ptr_get_u32_le(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    var b2 = oren_ptr_get_u8(p + 2)
    var b3 = oren_ptr_get_u8(p + 3)
    return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0
}
fn oren_ptr_get_i32_be(p) {
    var u = oren_ptr_get_u32_be(p)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}
fn oren_ptr_get_i32_le(p) {
    var u = oren_ptr_get_u32_le(p)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_ptr_set_u32_be(p, v) {
    var u = v & 4294967295
    oren_ptr_set_u8(p + 0, (u >> 24) & 255)
    oren_ptr_set_u8(p + 1, (u >> 16) & 255)
    oren_ptr_set_u8(p + 2, (u >> 8) & 255)
    oren_ptr_set_u8(p + 3, u & 255)
    return u
}
fn oren_ptr_set_u32_le(p, v) {
    var u = v & 4294967295
    oren_ptr_set_u8(p + 0, u & 255)
    oren_ptr_set_u8(p + 1, (u >> 8) & 255)
    oren_ptr_set_u8(p + 2, (u >> 16) & 255)
    oren_ptr_set_u8(p + 3, (u >> 24) & 255)
    return u
}
fn oren_ptr_set_i32_be(p, v) {
    var u = v & 4294967295
    oren_ptr_set_u8(p + 0, (u >> 24) & 255)
    oren_ptr_set_u8(p + 1, (u >> 16) & 255)
    oren_ptr_set_u8(p + 2, (u >> 8) & 255)
    oren_ptr_set_u8(p + 3, u & 255)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}
fn oren_ptr_set_i32_le(p, v) {
    var u = v & 4294967295
    oren_ptr_set_u8(p + 0, u & 255)
    oren_ptr_set_u8(p + 1, (u >> 8) & 255)
    oren_ptr_set_u8(p + 2, (u >> 16) & 255)
    oren_ptr_set_u8(p + 3, (u >> 24) & 255)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_ptr_get_u64_be(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    var b2 = oren_ptr_get_u8(p + 2)
    var b3 = oren_ptr_get_u8(p + 3)
    var b4 = oren_ptr_get_u8(p + 4)
    var b5 = oren_ptr_get_u8(p + 5)
    var b6 = oren_ptr_get_u8(p + 6)
    var b7 = oren_ptr_get_u8(p + 7)
    return (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7
}
fn oren_ptr_get_u64_le(p) {
    var b0 = oren_ptr_get_u8(p + 0)
    var b1 = oren_ptr_get_u8(p + 1)
    var b2 = oren_ptr_get_u8(p + 2)
    var b3 = oren_ptr_get_u8(p + 3)
    var b4 = oren_ptr_get_u8(p + 4)
    var b5 = oren_ptr_get_u8(p + 5)
    var b6 = oren_ptr_get_u8(p + 6)
    var b7 = oren_ptr_get_u8(p + 7)
    return (b7 << 56) | (b6 << 48) | (b5 << 40) | (b4 << 32) | (b3 << 24) | (b2 << 16) | (b1 << 8) | b0
}
fn oren_ptr_get_i64_be(p) { return oren_ptr_get_u64_be(p) }
fn oren_ptr_get_i64_le(p) { return oren_ptr_get_u64_le(p) }

fn oren_ptr_set_u64_be(p, v) {
    oren_ptr_set_u8(p + 0, (v >> 56) & 255)
    oren_ptr_set_u8(p + 1, (v >> 48) & 255)
    oren_ptr_set_u8(p + 2, (v >> 40) & 255)
    oren_ptr_set_u8(p + 3, (v >> 32) & 255)
    oren_ptr_set_u8(p + 4, (v >> 24) & 255)
    oren_ptr_set_u8(p + 5, (v >> 16) & 255)
    oren_ptr_set_u8(p + 6, (v >> 8) & 255)
    oren_ptr_set_u8(p + 7, v & 255)
    return v
}
fn oren_ptr_set_u64_le(p, v) {
    oren_ptr_set_u8(p + 0, v & 255)
    oren_ptr_set_u8(p + 1, (v >> 8) & 255)
    oren_ptr_set_u8(p + 2, (v >> 16) & 255)
    oren_ptr_set_u8(p + 3, (v >> 24) & 255)
    oren_ptr_set_u8(p + 4, (v >> 32) & 255)
    oren_ptr_set_u8(p + 5, (v >> 40) & 255)
    oren_ptr_set_u8(p + 6, (v >> 48) & 255)
    oren_ptr_set_u8(p + 7, (v >> 56) & 255)
    return v
}
fn oren_ptr_set_i64_be(p, v) { return oren_ptr_set_u64_be(p, v) }
fn oren_ptr_set_i64_le(p, v) { return oren_ptr_set_u64_le(p, v) }

fn native_bytes_as_list_node(bytes) {
    if bytes == 0 { return 0 }
    if bytes < 4096 { return 0 }
    // Avoid probing memory at `bytes+...` unless this is a tracked heap pointer.
    return oren_find_node(bytes)
}

fn native_bytes_is_list(bytes) {
    var node = native_bytes_as_list_node(bytes)
    if node == 0 { return false }
    // Lists are tracked with kind=2 in the GC registry.
    if ptr_get(iadd(node, 16)) != 2 { return false }
    // Redundant sanity check: header magic.
    if ptr_get(bytes + 24) != list_magic() { return false }
    return true
}

fn native_bytes_is_list_int(bytes) {
    var node = _list_find_node_known_kind(bytes, list_int_kind())
    if node == 0 { return false }
    if ptr_get(iadd(node, 16)) != list_int_kind() { return false }
    if ptr_get(bytes + 24) != list_magic() { return false }
    return true
}

fn native_bytes_is_u8_buf(bytes) {
    // Treat u8 typed buffers as a byte container for packet parsing + pack_view.
    if bytes == 0 { return false }
    if bytes < 4096 { return false }
    var node = oren_find_node(bytes)
    if node == 0 { return false }
    if ptr_get(iadd(node, 16)) != 7 { return false } // BUF
    if ptr_get(bytes + 24) != buf_magic() { return false }
    if ptr_get(bytes + 32) != BUF_TAG_U8 { return false }
    if ptr_get(bytes + 8) != 1 { return false }
    return true
}

fn native_bytes_span_ok(count, idx, width) {
    if count < 0 { return false }
    if idx < 0 { return false }
    if width < 1 || width > 8 { return false }
    if idx > count { return false }
    return width <= count - idx
}

fn oren_bytes_get_u8(bytes, idx) {
    // Return structured errors (not panic) so protocol parsing can be safe and
    // deterministic across backends (matches C/AVM conventions).
    if bytes == 0 { return oren_err(4, "bytes_get_u8: bytes is nil") }
    if native_bytes_is_list(bytes) == true {
        var count = ptr_get(bytes)
        if native_bytes_span_ok(count, idx, 1) != true { return oren_err(4, "bytes_get_u8: index out of bounds") }
        var buf = ptr_get(bytes + 16)
        if buf == 0 { return oren_err(4, "bytes_get_u8: list buffer is nil") }
        var v = ptr_get(buf + idx * 8)
        if v < 0 || v > 255 { return oren_err(4, "bytes_get_u8: byte out of range") }
        return v
    }
    if native_bytes_is_list_int(bytes) == true {
        var counti = ptr_get(bytes)
        if native_bytes_span_ok(counti, idx, 1) != true { return oren_err(4, "bytes_get_u8: index out of bounds") }
        var bufi = ptr_get(bytes + 16)
        if bufi == 0 { return oren_err(4, "bytes_get_u8: list buffer is nil") }
        var vi = ptr_get(bufi + idx * 8)
        if vi < 0 || vi > 255 { return oren_err(4, "bytes_get_u8: byte out of range") }
        return vi
    }
    if native_bytes_is_u8_buf(bytes) == true {
        var count2 = ptr_get(bytes + 0)
        if native_bytes_span_ok(count2, idx, 1) != true { return oren_err(4, "bytes_get_u8: index out of bounds") }
        var data = native_buf_data_ptr(bytes)
        if data == 0 { return oren_err(4, "bytes_get_u8: buf payload is nil") }
        return ptr_get_byte(data + idx) & 255
    }
    return oren_err(4, "bytes_get_u8 expects list<int 0..255>, LIST_INT, or u8_buf")
}

fn oren_bytes_set_u8(bytes, idx, v) {
    if bytes == 0 { return oren_err(4, "bytes_set_u8: bytes is nil") }
    if v < 0 || v > 255 { return oren_err(4, "bytes_set_u8: byte out of range") }
    if native_bytes_is_list(bytes) == true {
        var count = ptr_get(bytes)
        if native_bytes_span_ok(count, idx, 1) != true { return oren_err(4, "bytes_set_u8: index out of bounds") }
        var buf = ptr_get(bytes + 16)
        if buf == 0 { return oren_err(4, "bytes_set_u8: list buffer is nil") }
        ptr_set(buf + idx * 8, v)
        return v
    }
    if native_bytes_is_u8_buf(bytes) == true {
        var count2 = ptr_get(bytes + 0)
        if native_bytes_span_ok(count2, idx, 1) != true { return oren_err(4, "bytes_set_u8: index out of bounds") }
        var data = native_buf_data_ptr(bytes)
        if data == 0 { return oren_err(4, "bytes_set_u8: buf payload is nil") }
        ptr_set_byte(data + idx, v)
        return v
    }
    return oren_err(4, "bytes_set_u8 expects list<int 0..255> or u8_buf")
}

fn native_bytes_set_span(bytes, idx, width, b0, b1, b2, b3, b4, b5, b6, b7) {
    if bytes == 0 { return oren_err(4, "bytes_set_span: bytes is nil") }
    if native_bytes_is_list(bytes) == true {
        var count = ptr_get(bytes)
        if native_bytes_span_ok(count, idx, width) != true { return oren_err(4, "bytes_set_span: index out of bounds") }
        var buf = ptr_get(bytes + 16)
        if buf == 0 { return oren_err(4, "bytes_set_span: list buffer is nil") }
        if width > 0 { ptr_set(buf + (idx + 0) * 8, b0 & 255) }
        if width > 1 { ptr_set(buf + (idx + 1) * 8, b1 & 255) }
        if width > 2 { ptr_set(buf + (idx + 2) * 8, b2 & 255) }
        if width > 3 { ptr_set(buf + (idx + 3) * 8, b3 & 255) }
        if width > 4 { ptr_set(buf + (idx + 4) * 8, b4 & 255) }
        if width > 5 { ptr_set(buf + (idx + 5) * 8, b5 & 255) }
        if width > 6 { ptr_set(buf + (idx + 6) * 8, b6 & 255) }
        if width > 7 { ptr_set(buf + (idx + 7) * 8, b7 & 255) }
        return 0
    }
    if native_bytes_is_u8_buf(bytes) == true {
        var count2 = ptr_get(bytes + 0)
        if native_bytes_span_ok(count2, idx, width) != true { return oren_err(4, "bytes_set_span: index out of bounds") }
        var data = native_buf_data_ptr(bytes)
        if data == 0 { return oren_err(4, "bytes_set_span: buf payload is nil") }
        if width > 0 { ptr_set_byte(data + idx + 0, b0 & 255) }
        if width > 1 { ptr_set_byte(data + idx + 1, b1 & 255) }
        if width > 2 { ptr_set_byte(data + idx + 2, b2 & 255) }
        if width > 3 { ptr_set_byte(data + idx + 3, b3 & 255) }
        if width > 4 { ptr_set_byte(data + idx + 4, b4 & 255) }
        if width > 5 { ptr_set_byte(data + idx + 5, b5 & 255) }
        if width > 6 { ptr_set_byte(data + idx + 6, b6 & 255) }
        if width > 7 { ptr_set_byte(data + idx + 7, b7 & 255) }
        return 0
    }
    return oren_err(4, "bytes_set_span expects list<int 0..255> or u8_buf")
}

fn native_bytes_get_span_u64(bytes, idx, width, little) {
    if bytes == 0 { return oren_err(4, "bytes_get_span: bytes is nil") }
    if native_bytes_is_list(bytes) == true {
        var count = ptr_get(bytes)
        if native_bytes_span_ok(count, idx, width) != true { return oren_err(4, "bytes_get_span: index out of bounds") }
        var buf = ptr_get(bytes + 16)
        if buf == 0 { return oren_err(4, "bytes_get_span: list buffer is nil") }
        var acc = 0
        var i = 0
        while i < width {
            var b = ptr_get(buf + (idx + i) * 8)
            if b < 0 || b > 255 { return oren_err(4, "bytes_get_span: byte out of range") }
            if little == true {
                acc = acc | (b << (i * 8))
            } else {
                acc = (acc << 8) | b
            }
            i = i + 1
        }
        return acc
    }
    if native_bytes_is_list_int(bytes) == true {
        var counti = ptr_get(bytes)
        if native_bytes_span_ok(counti, idx, width) != true { return oren_err(4, "bytes_get_span: index out of bounds") }
        var bufi = ptr_get(bytes + 16)
        if bufi == 0 { return oren_err(4, "bytes_get_span: list buffer is nil") }
        var acci = 0
        var ii = 0
        while ii < width {
            var bi = ptr_get(bufi + (idx + ii) * 8)
            if bi < 0 || bi > 255 { return oren_err(4, "bytes_get_span: byte out of range") }
            if little == true {
                acci = acci | (bi << (ii * 8))
            } else {
                acci = (acci << 8) | bi
            }
            ii = ii + 1
        }
        return acci
    }
    if native_bytes_is_u8_buf(bytes) == true {
        var count2 = ptr_get(bytes + 0)
        if native_bytes_span_ok(count2, idx, width) != true { return oren_err(4, "bytes_get_span: index out of bounds") }
        var data = native_buf_data_ptr(bytes)
        if data == 0 { return oren_err(4, "bytes_get_span: buf payload is nil") }
        var acc2 = 0
        var j = 0
        while j < width {
            var b2 = ptr_get_byte(data + idx + j) & 255
            if little == true {
                acc2 = acc2 | (b2 << (j * 8))
            } else {
                acc2 = (acc2 << 8) | b2
            }
            j = j + 1
        }
        return acc2
    }
    return oren_err(4, "bytes_get_span expects list<int 0..255>, LIST_INT, or u8_buf")
}

fn oren_bytes_get_u16_be(bytes, idx) {
    return native_bytes_get_span_u64(bytes, idx, 2, false)
}

fn oren_bytes_get_u16_le(bytes, idx) {
    return native_bytes_get_span_u64(bytes, idx, 2, true)
}

fn oren_bytes_get_i16_be(bytes, idx) {
    var u = oren_bytes_get_u16_be(bytes, idx)
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_bytes_get_i16_le(bytes, idx) {
    var u = oren_bytes_get_u16_le(bytes, idx)
    if u >= 32768 { return u - 65536 }
    return u
}

// Endian-aware writes (masking / truncating semantics; no allocation).
// These write the low N bits of `v` into `bytes` and return the canonical value.

fn oren_bytes_set_u16_be(bytes, idx, v) {
    var u = v & 65535
    var rc = native_bytes_set_span(bytes, idx, 2, (u >> 8) & 255, u & 255, 0, 0, 0, 0, 0, 0)
    if oren_is_err(rc) { return rc }
    return u
}

fn oren_bytes_set_u16_le(bytes, idx, v) {
    var u = v & 65535
    var rc = native_bytes_set_span(bytes, idx, 2, u & 255, (u >> 8) & 255, 0, 0, 0, 0, 0, 0)
    if oren_is_err(rc) { return rc }
    return u
}

fn oren_bytes_set_i16_be(bytes, idx, v) {
    var u = v & 65535
    var rc = native_bytes_set_span(bytes, idx, 2, (u >> 8) & 255, u & 255, 0, 0, 0, 0, 0, 0)
    if oren_is_err(rc) { return rc }
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_bytes_set_i16_le(bytes, idx, v) {
    var u = v & 65535
    var rc = native_bytes_set_span(bytes, idx, 2, u & 255, (u >> 8) & 255, 0, 0, 0, 0, 0, 0)
    if oren_is_err(rc) { return rc }
    if u >= 32768 { return u - 65536 }
    return u
}

fn oren_bytes_put_u16_be(bytes, idx, v) {
    if v < 0 || v > 65535 { oren_panic("u16 out of range") }
    native_bytes_set_span(bytes, idx, 2, (v >> 8) & 255, v & 255, 0, 0, 0, 0, 0, 0)
    return bytes
}

fn oren_bytes_put_u16_le(bytes, idx, v) {
    if v < 0 || v > 65535 { oren_panic("u16 out of range") }
    native_bytes_set_span(bytes, idx, 2, v & 255, (v >> 8) & 255, 0, 0, 0, 0, 0, 0)
    return bytes
}

fn oren_bytes_get_u32_be(bytes, idx) {
    return native_bytes_get_span_u64(bytes, idx, 4, false)
}

fn oren_bytes_get_u32_le(bytes, idx) {
    return native_bytes_get_span_u64(bytes, idx, 4, true)
}

fn oren_bytes_get_i32_be(bytes, idx) {
    var u = oren_bytes_get_u32_be(bytes, idx)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_bytes_get_i32_le(bytes, idx) {
    var u = oren_bytes_get_u32_le(bytes, idx)
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_bytes_set_u32_be(bytes, idx, v) {
    var u = v & 4294967295
    var rc = native_bytes_set_span(bytes, idx, 4, (u >> 24) & 255, (u >> 16) & 255, (u >> 8) & 255, u & 255, 0, 0, 0, 0)
    if oren_is_err(rc) { return rc }
    return u
}

fn oren_bytes_set_u32_le(bytes, idx, v) {
    var u = v & 4294967295
    var rc = native_bytes_set_span(bytes, idx, 4, u & 255, (u >> 8) & 255, (u >> 16) & 255, (u >> 24) & 255, 0, 0, 0, 0)
    if oren_is_err(rc) { return rc }
    return u
}

fn oren_bytes_set_i32_be(bytes, idx, v) {
    var u = v & 4294967295
    var rc = native_bytes_set_span(bytes, idx, 4, (u >> 24) & 255, (u >> 16) & 255, (u >> 8) & 255, u & 255, 0, 0, 0, 0)
    if oren_is_err(rc) { return rc }
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_bytes_set_i32_le(bytes, idx, v) {
    var u = v & 4294967295
    var rc = native_bytes_set_span(bytes, idx, 4, u & 255, (u >> 8) & 255, (u >> 16) & 255, (u >> 24) & 255, 0, 0, 0, 0)
    if oren_is_err(rc) { return rc }
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn oren_bytes_get_u64_be(bytes, idx) {
    return native_bytes_get_span_u64(bytes, idx, 8, false)
}

fn oren_bytes_get_u64_le(bytes, idx) {
    return native_bytes_get_span_u64(bytes, idx, 8, true)
}

fn oren_bytes_get_i64_be(bytes, idx) {
    // v0 note: Oren ints are signed int64; `u64` values above MAX_I64 are not representable.
    // The bit pattern is still correct for negative values (two's complement).
    return oren_bytes_get_u64_be(bytes, idx)
}

fn oren_bytes_get_i64_le(bytes, idx) {
    return oren_bytes_get_u64_le(bytes, idx)
}

fn oren_bytes_set_u64_be(bytes, idx, v) {
    var rc = native_bytes_set_span(bytes, idx, 8, (v >> 56) & 255, (v >> 48) & 255, (v >> 40) & 255, (v >> 32) & 255, (v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255)
    if oren_is_err(rc) { return rc }
    return v
}

fn oren_bytes_set_u64_le(bytes, idx, v) {
    var rc = native_bytes_set_span(bytes, idx, 8, v & 255, (v >> 8) & 255, (v >> 16) & 255, (v >> 24) & 255, (v >> 32) & 255, (v >> 40) & 255, (v >> 48) & 255, (v >> 56) & 255)
    if oren_is_err(rc) { return rc }
    return v
}

fn oren_bytes_set_i64_be(bytes, idx, v) {
    return oren_bytes_set_u64_be(bytes, idx, v)
}

fn oren_bytes_set_i64_le(bytes, idx, v) {
    return oren_bytes_set_u64_le(bytes, idx, v)
}

fn oren_bytes_put_u32_be(bytes, idx, v) {
    if v < 0 || v > 4294967295 { oren_panic("u32 out of range") }
    native_bytes_set_span(bytes, idx, 4, (v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255, 0, 0, 0, 0)
    return bytes
}

fn oren_bytes_put_u32_le(bytes, idx, v) {
    if v < 0 || v > 4294967295 { oren_panic("u32 out of range") }
    native_bytes_set_span(bytes, idx, 4, v & 255, (v >> 8) & 255, (v >> 16) & 255, (v >> 24) & 255, 0, 0, 0, 0)
    return bytes
}

// Generic index helpers used by frontend/lowerings that still target
// `oren_index_get` / `oren_index_set` directly (rolling).
//
// Semantics (rolling; matches C backend + `tests/native/test_list_append_grow.oren`):
// - Reads: lists are bounds-checked; maps return nil for missing keys.
// - Lists: `xs[i] = v` grows `xs` to length `i+1` if needed; new slots become `nil`.
// - Maps: `m[key] = v` inserts/replaces and returns `v`.
@oren.keep
fn oren_index_get(container, index) {
    return oren_list_get(container, index)
}

@oren.keep
fn oren_index_set(container, index, value) {
    if container == 0 {
        oren_panic("index_set on nil")
        return 0
    }

    // Native v0 safety rule:
    // - values are "i64 carriers" (ints and pointers share the same representation)
    // - therefore we MUST NOT probe memory at `container+...` unless `container` is a tracked heap pointer.
    //
    // Use the tracked-allocation registry (same contract as other container ops):
    // - kind==2 => LIST
    // - kind==3 => MAP
    var node = oren_find_node(container)
    if node == 0 {
        oren_panic("index_set on non-container (expected list or map)")
        return 0
    }
    var kind = ptr_get(iadd(node, 16))
    if kind == 2 {
        return oren_list_set(container, index, value)
    }
    if kind == list_int_kind() {
        return oren_list_int_set(container, index, value)
    }
    if kind == 3 {
        // Maps: delegate key-kind selection to `oren_map_set`, which uses tracked allocation metadata
        // to distinguish int keys (raw/untracked) from string keys (tracked kind=1).
        return oren_map_set(container, index, value)
    }

    oren_panic("index_set on non-container (expected list or map)")
    return 0
}
