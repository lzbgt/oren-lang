// --- Darwin OS threads (macOS) ---
//
// This module provides:
// - (optional) runtime-owned `bsdthread_register` entry stubs (threadstart + wqthread)
// - a minimal OS-thread spawn/join primitive used to bootstrap Stage N2 (GMP, M:N)
//
// Design goals (rolling):
// - Prefer a syscall-first path when possible, but remain correct when the process already
//   has a libpthread substrate installed by dyld (common on modern macOS).
// - Keep the initial implementation small and testable; scheduler/GMP comes later.

// FFI boundary for macOS pthread primitives.
//
// NOTE: This is gated behind `@cfg(os="macos")` so other Tier-1 targets do not pick up
// macOS-only link dependencies from the shared runtime bundle.
@cfg(os="macos")
@ffi.libc
@ffi.ret("i32")
ffi {
    pthread_create as __oren_pthread_create
    pthread_join as __oren_pthread_join
}

// OrenDarwinThread layout (raw allocation; not GC-managed).
//
// IMPORTANT:
// - The kernel uses the `pthread` pointer (4th arg to `bsdthread_create`) as the base of the
//   per-thread pthread/TSD area. On arm64 macOS, the TSD offset is assumed to be compatible with
//   libpthread’s `struct pthread_s` (`tsd_offset` = 224 on LP64).
// - Therefore, do NOT place Oren join/result metadata inside the pthread area; kernel/libplatform
//   TSD fast-path writes may clobber it.
//
// We allocate:
// - one anonymous mapping for [stack bytes ...][pthread area (16KiB)]
// - one anonymous mapping for the Oren join handle / metadata
//
// Offsets are 8-byte slots (u64).
fn _darwin_thr_off_freeaddr() { return 0 }     // base address to free
fn _darwin_thr_off_freesize() { return 8 }    // byte size to free
fn _darwin_thr_off_done() { return 16 }       // 0 while running; 1 when done
fn _darwin_thr_off_result() { return 24 }     // result value (u64)
fn _darwin_thr_off_fn_obj() { return 32 }     // Oren function object (kind=6)
fn _darwin_thr_off_args_list() { return 40 }  // args list
fn _darwin_thr_off_pthread() { return 48 }    // pthread/TSD area base (for best-effort kport lookup)
fn _darwin_thr_off_kind() { return 56 }       // 0=bsdthread stack mapping, 1=libpthread thread
fn _darwin_thr_off_thread() { return 64 }     // pthread_t (u64)
fn _darwin_thr_bytes() { return 72 }

fn _darwin_thr_stack_bytes_default() {
    // Rolling default: 1 MiB per OS thread stack.
    // (GMP will later use smaller per-G stacks; Ms need a real OS stack.)
    return 1048576
}

fn _darwin_thr_new_stack_and_struct(stack_bytes) {
    // Allocate:
    // - stack+pthread mapping (freed by `bsdthread_terminate` on thread exit)
    // - separate metadata mapping (freed by joiner)
    if stack_bytes <= 0 { stack_bytes = _darwin_thr_stack_bytes_default() }
    var pthread_size = 16384
    var total = stack_bytes + pthread_size
    var base = sys_mmap_private_anon(total)
    if base == 0 || base == -1 || base < 4096 { return 0 }
    var pthread_area = base + stack_bytes

    // Metadata mapping (16KiB) so it is page-aligned and safe for ulock waits.
    var meta = sys_mmap_private_anon(16384)
    if meta == 0 || meta == -1 || meta < 4096 {
        sys_munmap(base, total)
        return 0
    }

    // Initialize metadata fields used by both:
    // - runtime-owned threadstart stub (when `bsdthread_register` succeeds)
    // - "already registered" threadstart substrate (when we pass a user_func)
    ptr_set(meta + _darwin_thr_off_freeaddr(), base)
    ptr_set(meta + _darwin_thr_off_freesize(), total)
    ptr_set(meta + _darwin_thr_off_done(), 0)
    ptr_set(meta + _darwin_thr_off_result(), 0)
    ptr_set(meta + _darwin_thr_off_fn_obj(), 0)
    ptr_set(meta + _darwin_thr_off_args_list(), 0)
    ptr_set(meta + _darwin_thr_off_pthread(), pthread_area)
    ptr_set(meta + _darwin_thr_off_kind(), 0)
    ptr_set(meta + _darwin_thr_off_thread(), 0)
    return meta
}

fn _darwin_thr_new_meta_only() {
    // Metadata-only handle used when we create an OS thread via libpthread.
    // (No custom stack mapping; pthread owns the stack lifetime.)
    var meta = sys_mmap_private_anon(16384)
    if meta == 0 || meta == -1 || meta < 4096 { return 0 }
    ptr_set(meta + _darwin_thr_off_freeaddr(), 0)
    ptr_set(meta + _darwin_thr_off_freesize(), 0)
    ptr_set(meta + _darwin_thr_off_done(), 0)
    ptr_set(meta + _darwin_thr_off_result(), 0)
    ptr_set(meta + _darwin_thr_off_fn_obj(), 0)
    ptr_set(meta + _darwin_thr_off_args_list(), 0)
    ptr_set(meta + _darwin_thr_off_pthread(), 0)
    ptr_set(meta + _darwin_thr_off_kind(), 1)
    ptr_set(meta + _darwin_thr_off_thread(), 0)
    return meta
}

// --- Runtime-owned bsdthread entry stubs ---
//
// NOTE: The kernel jumps directly to `threadstart` and `wqthread` pointers registered via
// `bsdthread_register(366)`. These must never return.

@oren.keep
fn __oren_darwin_thread_start(self, kport, fun, arg, stacksize, flags) {
    // `fun/arg/stacksize/flags` are passed by the kernel according to the bsdthread ABI.
    // In the syscall-first runtime:
    // - `self` is the pthread object page base (used by the kernel for TSD).
    // - `arg` carries a pointer to our metadata page (OrenDarwinThread), passed as `func_arg`.
    // We ignore `fun` for v0.
    //
    // If the kernel calls this, we are already in a new OS thread.
    // Register it so allocator/GC can discover the stack conservatively.
    //
    // Debug escape hatch: allow disabling thread registration to isolate crashes in early
    // bring-up (should never be used in production).
    var no_reg = native_envp_get_value_ptr("OREN_NO_THREAD_REGISTER")
    if no_reg == 0 || ptr_get_byte(no_reg) == 0 {
        oren_register_thread(get_sp())
    }

    if self == 0 || arg == 0 {
        // Fail-fast: without `self` we can't locate stack freeaddr/freesize or join state.
        exit(941)
    }

    // Run the stored Oren function object.
    var meta = arg
    var fn_obj = ptr_get(meta + _darwin_thr_off_fn_obj())
    var args_list = ptr_get(meta + _darwin_thr_off_args_list())
    var ret = 0
    if fn_obj != 0 {
        ret = oren_call_obj_list(fn_obj, args_list)
    }
    ptr_set(meta + _darwin_thr_off_result(), ret)
    ptr_set(meta + _darwin_thr_off_done(), 1)
    // Wake any joiners waiting on `done`.
    // operation=UL_COMPARE_AND_WAIT|ULF_WAKE_ALL = 1|0x100 = 257
    sys_ulock_wake(257, meta + _darwin_thr_off_done(), 0)

    // Terminate the OS thread and release its stack mapping.
    // stackaddr/freesize mirror libpthread’s bsdthread_terminate usage.
    var freeaddr = ptr_get(meta + _darwin_thr_off_freeaddr())
    var freesize = ptr_get(meta + _darwin_thr_off_freesize())
    sys_bsdthread_terminate(freeaddr, freesize, kport, 0)
    // Should not return.
    while 1 { sys_sched_yield() }
    return 0
}

@oren.keep
fn __oren_darwin_start_wqthread(self, kport, a2, a3, a4, a5) {
    // Workqueue threads are not part of the syscall-first runtime plan yet.
    //
    // If this stub is invoked, something requested a workqueue thread in this process.
    // Crash fast so we discover the dependency and can implement the correct integration.
    //
    // NOTE: returning here is UB; the kernel expects this to never return.
    // Keep args referenced to avoid any rolling-mode "unused local" edge cases.
    if self == -1 || kport == -1 || a2 == -1 || a3 == -1 || a4 == -1 || a5 == -1 { exit(943) }
    exit(942)
    while 1 { sys_sched_yield() }
    return 0
}

// User function pointer passed to `bsdthread_create` when our runtime-owned threadstart is installed.
//
// Our `__oren_darwin_thread_start` implementation ignores the `fun` argument, so this should
// never be invoked. Keep it present as a non-zero pointer for strict syscall argument validation.
@oren.keep
fn __oren_darwin_bsdthread_user_func_unused(meta) { return 0 }

// --- libpthread-backed OS thread entry (common macOS dyld path) ---
//
// This is used when `bsdthread_register` cannot install runtime-owned threadstart stubs
// (most common case: dyld/libsystem_pthread already registered).
@oren.keep
fn __oren_darwin_pthread_thread_entry(meta) {
    if meta == 0 { return 0 }
    // Register this OS thread with the Oren runtime so allocator/GC can discover it.
    //
    // Debug escape hatch: allow disabling thread registration to isolate crashes in early
    // bring-up (should never be used in production).
    var no_reg = native_envp_get_value_ptr("OREN_NO_THREAD_REGISTER")
    if no_reg == 0 || ptr_get_byte(no_reg) == 0 {
        oren_register_thread(get_sp())
    }

    var fn_obj = ptr_get(meta + _darwin_thr_off_fn_obj())
    var args_list = ptr_get(meta + _darwin_thr_off_args_list())
    var ret = 0
    if fn_obj != 0 {
        ret = oren_call_obj_list(fn_obj, args_list)
    }
    ptr_set(meta + _darwin_thr_off_result(), ret)
    ptr_set(meta + _darwin_thr_off_done(), 1)
    // Wake any waiters using ulock (non-blocking is_done path).
    sys_ulock_wake(257, meta + _darwin_thr_off_done(), 0)
    return 0
}

// --- Minimal spawn/join surface (Darwin only) ---
//
// This is intentionally not wired into `spawn` yet. It is a substrate used by the
// upcoming Stage N2 GMP scheduler and by targeted tests.

fn oren_darwin_os_thread_spawn_call_list(fn_obj, args_list) {
    if g_target_os != 1 { return 0 }
    if fn_obj == 0 { return 0 }
    if oren_is_func(fn_obj) != true { return 0 }

    // Path selection:
    // - If our runtime-owned `bsdthread_register` succeeded (rv > 0), we can create threads via
    //   `bsdthread_create` and start them inside `__oren_darwin_thread_start` (syscall-first).
    // - Otherwise, fall back to libpthread (`pthread_create`), which correctly initializes the
    //   pthread self/signature and avoids `_pthread_start` traps.
    if g_darwin_bsdthread_register_last_rv > 0 {
        var meta0 = _darwin_thr_new_stack_and_struct(_darwin_thr_stack_bytes_default())
        if meta0 == 0 { return 0 }

        ptr_set(meta0 + _darwin_thr_off_fn_obj(), fn_obj)
        ptr_set(meta0 + _darwin_thr_off_args_list(), args_list)
        var base0 = ptr_get(meta0 + _darwin_thr_off_freeaddr())
        var total0 = ptr_get(meta0 + _darwin_thr_off_freesize())
        var pthread_area0 = ptr_get(meta0 + _darwin_thr_off_pthread())
        if base0 == 0 || total0 <= 0 || pthread_area0 == 0 {
            sys_munmap(meta0, 16384)
            if base0 != 0 && total0 > 0 { sys_munmap(base0, total0) }
            return 0
        }

        // Always set PTHREAD_START_CUSTOM (0x01000000) to satisfy kernel validation.
        var PTHREAD_START_CUSTOM = 16777216
        var rv0 = sys_bsdthread_create(__oren_darwin_bsdthread_user_func_unused, meta0, pthread_area0, pthread_area0, PTHREAD_START_CUSTOM)
        if rv0 == -1 || rv0 < 0 {
            sys_munmap(meta0, 16384)
            sys_munmap(base0, total0)
            return 0
        }
        return meta0
    }

    var meta = _darwin_thr_new_meta_only()
    if meta == 0 { return 0 }
    ptr_set(meta + _darwin_thr_off_fn_obj(), fn_obj)
    ptr_set(meta + _darwin_thr_off_args_list(), args_list)

    var start_addr = oren_code_addr(__oren_darwin_pthread_thread_entry)
    if start_addr == 0 {
        sys_munmap(meta, 16384)
        return 0
    }
    // pthread_create(&thread, NULL, start_routine, arg)
    var rc = __oren_pthread_create(meta + _darwin_thr_off_thread(), 0, start_addr, meta)
    if rc != 0 {
        sys_munmap(meta, 16384)
        return 0
    }
    return meta
}

fn oren_darwin_os_thread_is_done(handle) {
    if handle == 0 { return false }
    if ptr_get(handle + _darwin_thr_off_done()) != 0 { return true }
    return false
}

fn oren_darwin_os_thread_join(handle) {
    if handle == 0 { return 0 }
    var kind = ptr_get(handle + _darwin_thr_off_kind())
    if kind == 1 {
        // libpthread join: pthread_join blocks until completion, so no ulock wait needed.
        var thr = ptr_get(handle + _darwin_thr_off_thread())
        var rc = __oren_pthread_join(thr, 0)
        if rc != 0 { exit(946) }
        var ret1 = ptr_get(handle + _darwin_thr_off_result())
        sys_munmap(handle, 16384)
        return ret1
    }

    // syscall-first join: wait for the worker to set `done`, then read result.
    // Bounded wait to avoid a silent hang when the kernel thread substrate is misconfigured.
    var tries = 0
    while ptr_get(handle + _darwin_thr_off_done()) == 0 {
        sys_ulock_wait(1, handle + _darwin_thr_off_done(), 0, 10000000)
        tries = tries + 1
        if ptr_get(handle + _darwin_thr_off_done()) != 0 { break }
        if tries >= 3 { exit(945) }
    }
    var ret0 = ptr_get(handle + _darwin_thr_off_result())
    sys_munmap(handle, 16384)
    return ret0
}
