// Cross-platform stat helpers (Oren-owned ABI).
//
// The syscall-first surface (`sys_stat/sys_lstat/sys_fstat`) writes an Oren-defined
// stable layout into the caller-provided buffer. Do not assume host `struct stat`
// layouts in user code or tests.
//
// Layout: see `lib/compiler/native_stat_abi.oren` (OrenStatV0, 64 bytes, little-endian).

fn oren_stat_size_bytes() { return 64 }
fn oren_stat_off_size() { return 0 }
fn oren_stat_off_mode() { return 8 }
fn oren_stat_off_atime_ns() { return 16 }
fn oren_stat_off_mtime_ns() { return 24 }
fn oren_stat_off_ctime_ns() { return 32 }

fn oren_stat_alloc() {
    var n = oren_stat_size_bytes()
    var p = malloc(n)
    if p == 0 { exit(286) }
    var i = 0
    while i < n {
        ptr_set_byte(p + i, 0)
        i = i + 1
    }
    return p
}

fn oren_stat_get_size(st_ptr) {
    if st_ptr == 0 { return 0 }
    return oren_ptr_get_i64_le(st_ptr + oren_stat_off_size())
}

fn oren_stat_get_mode(st_ptr) {
    if st_ptr == 0 { return 0 }
    return oren_ptr_get_u32_le(st_ptr + oren_stat_off_mode())
}

fn oren_stat_get_atime_ns(st_ptr) {
    if st_ptr == 0 { return 0 }
    return oren_ptr_get_i64_le(st_ptr + oren_stat_off_atime_ns())
}

fn oren_stat_get_mtime_ns(st_ptr) {
    if st_ptr == 0 { return 0 }
    return oren_ptr_get_i64_le(st_ptr + oren_stat_off_mtime_ns())
}

fn oren_stat_get_ctime_ns(st_ptr) {
    if st_ptr == 0 { return 0 }
    return oren_ptr_get_i64_le(st_ptr + oren_stat_off_ctime_ns())
}

// Hot-path scratch buffer for `sys_stat` ABI writes.
//
// Used by `oren_file_stat_size_mtime_ns` (compiler/tooling dependency scan) to avoid:
// - per-call `malloc+free` churn
// - per-call zeroing loops
//
// Rolling note:
// - Today native runtime has no true threads; this is safe.
// - Once M:N native scheduling introduces real OS threads, this must become TLS or be
//   protected by a lock (or `sys_stat` should grow a direct "size+mtime" intrinsic).
var g_stat_scratch = 0

fn _oren_stat_scratch_ptr() {
    if g_stat_scratch != 0 { return g_stat_scratch }
    var n = oren_stat_size_bytes()
    // Untracked, leak-by-design, bounded: shared scratch buffer.
    var p = malloc(n)
    if p == 0 { exit(286) }
    g_stat_scratch = p
    return p
}

@cap.requires(domain="FS")
fn oren_file_stat_size_mtime_ns(path) {
    // Return [size_bytes, mtime_ns] (list<int> length 2), or an error map.
    //
    // This is used by compiler/tooling hot paths (build cache / dependency scanning) to avoid
    // reading large source files just to decide whether a cached record is still valid.
    // Avoid allocating the 16-byte resolve pair on non-capsule runs (common for local dev).
    var rpath = path
    var owned = 0
    if global_get_capsule_mode() == 1 {
        var pair = native_capsule_fs_path_resolve_pair(path, 0)
        rpath = ptr_get(pair + 0)
        owned = ptr_get(pair + 8)
        free(pair)
    } else {
        native_capsule_require(CAP_FS, "FS")
    }

    var st = _oren_stat_scratch_ptr()
    var rc = sys_stat(rpath, st)
    if rc < 0 {
        if owned == 1 { free(rpath) }
        return oren_err(2, "sys_stat failed")
    }
    var size = oren_stat_get_size(st)
    var mtime = oren_stat_get_mtime_ns(st)
    if owned == 1 { free(rpath) }
    return [size, mtime]
}
