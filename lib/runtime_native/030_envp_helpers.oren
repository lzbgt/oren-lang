fn native_cstr_len(s) {
    if s == 0 { return 0 }
    var n = 0
    while n < 65536 {
        if ptr_get_byte(iadd(s, n)) == 0 { return n }
        n = n + 1
    }
    return 65536
}

fn native_envp_get_value_ptr(key_cstr) {
    // Low-level envp scanner for early init and capsule enforcement.
    // Returns pointer to value substring for KEY in envp ("KEY=VALUE"), or 0 if not found.
    if key_cstr == 0 { return 0 }

    var envp = global_get_envp()
    if envp == 0 { return 0 }

    var key_len = native_cstr_len(key_cstr)
    if key_len <= 0 { return 0 }
    if key_len >= 4096 { return 0 }

    var i = 0
    while i < 4096 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { return 0 }

        // Check prefix match "KEY="
        var j = 0
        while j < key_len {
            if ptr_get_byte(iadd(ent, j)) != ptr_get_byte(iadd(key_cstr, j)) {
                j = -1
                break
            }
            j = j + 1
        }

        if j != -1 {
            if ptr_get_byte(iadd(ent, key_len)) == 61 { // '='
                return iadd(ent, key_len + 1)
            }
        }
        i = i + 1
    }
    return 0
}

fn native_envp_get_entry_ptr(key_cstr) {
    // Returns pointer to the full "KEY=VALUE" entry in envp, or 0 if not found.
    if key_cstr == 0 { return 0 }

    var envp = global_get_envp()
    if envp == 0 { return 0 }

    var key_len = native_cstr_len(key_cstr)
    if key_len <= 0 { return 0 }
    if key_len >= 4096 { return 0 }

    var i = 0
    while i < 4096 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { return 0 }

        var j = 0
        while j < key_len {
            if ptr_get_byte(iadd(ent, j)) != ptr_get_byte(iadd(key_cstr, j)) {
                j = -1
                break
            }
            j = j + 1
        }

        if j != -1 {
            if ptr_get_byte(iadd(ent, key_len)) == 61 { // '='
                return ent
            }
        }

        i = i + 1
    }
    return 0
}

fn native_parse_cap_allow_mask(csv_cstr) {
    if csv_cstr == 0 { return 0 }

    var mask = 0
    var i = 0
    var start = 0
    var n = native_cstr_len(csv_cstr)
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(csv_cstr, i)) }

        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var tok_start = start
            var tok_end = i
            // Trim spaces
            while tok_start < tok_end && ptr_get_byte(iadd(csv_cstr, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(csv_cstr, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            var tok_len = tok_end - tok_start
            if tok_len > 0 {
                // ASCII fold to uppercase for matching (a-z -> A-Z).
                var b0 = ptr_get_byte(iadd(csv_cstr, tok_start + 0))
                if b0 >= 97 && b0 <= 122 { b0 = b0 - 32 }

                if tok_len == 2 {
                    var b1 = ptr_get_byte(iadd(csv_cstr, tok_start + 1))
                    if b1 >= 97 && b1 <= 122 { b1 = b1 - 32 }
                    // FS
                    if b0 == 70 && b1 == 83 { mask = mask | CAP_FS }
                } else {
                    if tok_len == 3 {
                        var b1a = ptr_get_byte(iadd(csv_cstr, tok_start + 1))
                        var b2a = ptr_get_byte(iadd(csv_cstr, tok_start + 2))
                        if b1a >= 97 && b1a <= 122 { b1a = b1a - 32 }
                        if b2a >= 97 && b2a <= 122 { b2a = b2a - 32 }
                        // NET / ENV
                        if b0 == 78 && b1a == 69 && b2a == 84 {
                            mask = mask | CAP_NET
                        } else {
                            if b0 == 69 && b1a == 78 && b2a == 86 { mask = mask | CAP_ENV }
                        }
                    } else {
                        if tok_len == 4 {
                            var b1b = ptr_get_byte(iadd(csv_cstr, tok_start + 1))
                            var b2b = ptr_get_byte(iadd(csv_cstr, tok_start + 2))
                            var b3b = ptr_get_byte(iadd(csv_cstr, tok_start + 3))
                            if b1b >= 97 && b1b <= 122 { b1b = b1b - 32 }
                            if b2b >= 97 && b2b <= 122 { b2b = b2b - 32 }
                            if b3b >= 97 && b3b <= 122 { b3b = b3b - 32 }
                            // PROC / TIME
                            if b0 == 80 && b1b == 82 && b2b == 79 && b3b == 67 {
                                mask = mask | CAP_PROC
                            } else {
                                if b0 == 84 && b1b == 73 && b2b == 77 && b3b == 69 { mask = mask | CAP_TIME }
                            }
                        }
                    }
                }
            }

            start = i + 1
        }
        i = i + 1
    }
    return mask
}

// --- Windows env block → POSIX envp ---
//
// Win32 `GetEnvironmentStringsA()` returns an environment "block" in the form:
//   "K=V\\0K2=V2\\0...\\0\\0"
//
// The native runtime expects a POSIX-style `envp`:
//   [ptr to "K=V\\0", ptr to "K2=V2\\0", ..., 0]
//
// The x86_64 Windows entry stub uses this helper to convert the Win32 env block into
// an `envp` pointer array that can be scanned by `native_envp_get_value_ptr`.
//
// Notes:
// - We intentionally do not free the Win32 env block (the pointers in envp refer to it).
// - The runtime env scanners are bounded to 4096 entries for safety; we match that cap here.
@oren.keep
fn native_envp_build_from_win_envblock(env_block) {
    if env_block == 0 { return 0 }

    // First pass: count entries (bounded).
    var p = env_block
    var count = 0
    // Bound total bytes scanned so malformed blocks cannot spin forever.
    var scanned = 0
    while scanned < 1048576 { // 1 MiB
        var b0 = ptr_get_byte(p)
        if b0 == 0 {
            var b1 = ptr_get_byte(iadd(p, 1))
            if b1 == 0 { break } // end of block (double NUL)
        }

        count = count + 1
        if count >= 4096 { break }
        var n = native_cstr_len(p)
        // Defensive: `native_cstr_len` returns at most 65536.
        scanned = scanned + n + 1
        p = iadd(p, n + 1)
    }
    if count <= 0 { return 0 }

    // Allocate envp pointer array: (count + 1) * 8 bytes (u64 pointers), terminated by NULL.
    //
    // Use raw allocation: envp is not part of the tracked heap object model.
    var bytes = (count + 1) * 8
    var envp = malloc_raw(bytes)
    if envp == 0 { exit(203) }
    if envp == -1 { exit(203) }

    // Second pass: fill pointers.
    p = env_block
    var i = 0
    while i < count {
        ptr_set(iadd(envp, i * 8), p)
        var n2 = native_cstr_len(p)
        p = iadd(p, n2 + 1)
        i = i + 1
    }
    ptr_set(iadd(envp, count * 8), 0)
    return envp
}
