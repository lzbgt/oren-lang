// --- Args ---
fn oren_args() {
    var argc = global_get_argc()
    var argv = global_get_argv()
    if argc <= 0 { return oren_new_list(0) }
    if argv == 0 { return oren_new_list(0) }

    var out = oren_new_list(argc)
    var i = 0
    while i < argc {
        var s = ptr_get(argv + i * 8)
        // Copy argv strings into tracked heap strings so downstream code can reliably:
        // - print them as strings (oren_print checks GC-kind=STRING)
        // - concatenate them via `+` (native runtime `oren_add` concatenates only tracked strings)
        //
        // This also avoids "raw pointer treated as int" issues throughout the self-hosted compiler.
        if s != 0 {
            var ss = oren_string_slice(s, 0, oren_string_len(s))
            oren_list_push(out, ss)
        } else {
            oren_list_push(out, 0)
        }
        i = i + 1
    }
    return out
}
