// --- Yield (native runtime; rolling) ---
//
// This file defines a minimal `oren_yield()` surface that matches the AVM intent:
// “yield to other runnable work”.
//
// Native runtime reality today:
// - language `spawn` prefers the in-process green scheduler when it is enabled
// - fallback remains OS/process/thread substrate specific
//
// This function is now a tiered yield hook:
// - inside a green task: yield directly to the green scheduler
// - on a host thread with green runtime already active and no background workers:
//   drive one cooperative green scheduling step
// - otherwise: fall back to the OS yield hint (`sched_yield`, `Sleep(0)`, or best-effort no-op)
//
// Contract:
// - returns 0 on success; may return -errno on failed syscall paths.
@oren.keep
fn oren_yield() {
    // Green-task path: switch directly back to the scheduler.
    if oren_green_current_g_or0() != 0 {
        return oren_green_yield()
    }

    // Host-thread path:
    // If the green runtime is already active and background workers are not owning scheduling,
    // drive one cooperative step here. This keeps default native host/green orchestration aligned
    // with the shipped `spawn` semantics without initializing green state for unrelated callers.
    if g_green_inited != 0 && _green_enabled() == true && g_green_workers_started == 0 {
        var rc = oren_green_poll_steps(1)
        if rc == 0 { return 0 }
    }

    return sys_sched_yield()
}

@oren.keep
fn oren_yield_stmt() {
    oren_yield()
    return nil
}

@oren.keep
fn oren_yield_value(value) {
    oren_yield()
    return value
}

fn _oren_yield_exchange_resume_wait(resume_ch) {
    var sel = oren_select_recv([resume_ch])
    if oren_type_name(sel) == "list" && oren_list_len(sel) >= 2 {
        return sel[1]
    }
    return sel
}

@oren.keep
fn oren_yield_exchange(yield_ch, resume_ch, value) {
    oren_chan_send(yield_ch, value)
    oren_yield()
    return _oren_yield_exchange_resume_wait(resume_ch)
}
