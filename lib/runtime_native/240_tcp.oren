// --- TCP/IP (syscall-first) ---
// Notes:
// - macOS/BSD socket structs are built manually (byte-by-byte) without libc.
// - All potentially-blocking operations use kqueue/kevent with a caller-provided timeout.
// - Return convention: functions return fd/nbytes on success, or negative errno on failure.
//
// IMPORTANT (rolling): avoid relying on initialized global integer vars for numeric constants.
// Use numeric literals inside the functions to keep behavior robust during bootstrap.

fn oren_tcp_parse_ipv4_into(ip, out4_ptr) {
    if ip == 0 { return 0 }
    if out4_ptr == 0 { return 0 }

    var part = 0
    var acc = 0
    var digits = 0
    var i = 0
    while 1 {
        var ch = ptr_get_byte(ip + i)
        if ch == 0 { break }
        if ch >= 48 {
            if ch <= 57 {
                acc = acc * 10 + (ch - 48)
                if acc > 255 { return 0 }
                digits = digits + 1
            } else {
                return 0
            }
        } else {
            if ch == 46 {
                if digits == 0 { return 0 }
                if part >= 3 { return 0 }
                ptr_set_byte(out4_ptr + part, acc)
                part = part + 1
                acc = 0
                digits = 0
            } else {
                return 0
            }
        }
        i = i + 1
    }

    if part != 3 { return 0 }
    if digits == 0 { return 0 }
    ptr_set_byte(out4_ptr + 3, acc)
    return 1
}

fn oren_tcp_sockaddr_in(ip, port) {
    // struct sockaddr_in:
    //
    // - macOS/BSD layout (16 bytes):
    //     u8  sin_len
    //     u8  sin_family
    //     u16 sin_port (big-endian)
    //     u32 sin_addr (bytes)
    //     u8  sin_zero[8]
    //
    // - Linux layout (16 bytes):
    //     u16 sin_family (little-endian)
    //     u16 sin_port   (big-endian)
    //     u32 sin_addr   (bytes)
    //     u8  sin_zero[8]
    //
    // Rolling portability rule:
    // - Do not rely on host SDK headers.
    // - Select layout by probing kqueue availability once (macOS has it, Linux doesn't).
    var sa = malloc(16)
    if sa == 0 { return 0 }
    if sa == -1 { return 0 }
    oren_track_alloc(sa, 16, 0)

    // zero-fill
    var zi = 0
    while zi < 16 {
        ptr_set_byte(sa + zi, 0)
        zi = zi + 1
    }

    // Ensure we know whether this target has kqueue.
    // In rolling mode, native codegen should pass target_os into native_runtime_init,
    // which sets g_net_has_kqueue deterministically. Keep this probe as a last-resort
    // fallback for older binaries.
    if g_net_has_kqueue == -1 {
        var kq0 = sys_kqueue()
        if kq0 < 0 { g_net_has_kqueue = 0 }
        else { g_net_has_kqueue = 1; sys_close(kq0) }
    }

    if g_net_has_kqueue == 1 {
        // macOS/BSD: len + family
        ptr_set_byte(sa + 0, 16) // len
        ptr_set_byte(sa + 1, OREN_AF_INET) // AF_INET
    } else {
        // Linux: family u16 LE at [0..1]
        ptr_set_byte(sa + 0, OREN_AF_INET)
        ptr_set_byte(sa + 1, 0)
    }

    // port in network order
    var hi = (port >> 8) & 255
    var lo = port & 255
    ptr_set_byte(sa + 2, hi)
    ptr_set_byte(sa + 3, lo)

    // address bytes
    if ip == 0 {
        // default: 127.0.0.1
        ptr_set_byte(sa + 4, 127)
        ptr_set_byte(sa + 5, 0)
        ptr_set_byte(sa + 6, 0)
        ptr_set_byte(sa + 7, 1)
    } else {
        var ok = oren_tcp_parse_ipv4_into(ip, sa + 4)
        if ok == 0 { return 0 }
    }

    return sa
}

fn oren_sockaddr_in6(ip6_bytes, port) {
    // struct sockaddr_in6:
    //
    // - macOS/BSD (28 bytes):
    //     u8  sin6_len
    //     u8  sin6_family
    //     u16 sin6_port (big-endian)
    //     u32 sin6_flowinfo (native-endian; little on arm64)
    //     u8  sin6_addr[16]
    //     u32 sin6_scope_id (native-endian; little on arm64)
    //
    // - Linux (28 bytes):
    //     u16 sin6_family (little-endian)
    //     u16 sin6_port   (big-endian)
    //     u32 sin6_flowinfo (little-endian)
    //     u8  sin6_addr[16]
    //     u32 sin6_scope_id (little-endian)
    //
    // Input:
    // - ip6_bytes: bytes container (list<int 0..255> or u8_buf) of length 16; if nil => ::1.
    var sa = malloc(28)
    if sa == 0 { return 0 }
    oren_track_alloc(sa, 28, 0)

    // zero-fill
    var zi = 0
    while zi < 28 {
        ptr_set_byte(sa + zi, 0)
        zi = zi + 1
    }

    if g_target_os == 1 {
        // macOS/BSD
        ptr_set_byte(sa + 0, 28)
        ptr_set_byte(sa + 1, OREN_AF_INET6)
    } else {
        // Linux: family u16 LE
        ptr_set_byte(sa + 0, OREN_AF_INET6 & 255)
        ptr_set_byte(sa + 1, (OREN_AF_INET6 >> 8) & 255)
    }

    // port in network order
    ptr_set_byte(sa + 2, (port >> 8) & 255)
    ptr_set_byte(sa + 3, port & 255)

    // addr bytes
    if ip6_bytes == 0 {
        // default ::1 (last byte = 1)
        ptr_set_byte(sa + 8 + 15, 1)
    } else {
        var n = oren_bytes_len(ip6_bytes)
        if oren_is_err(n) { return 0 }
        if n != 16 { return 0 }
        var i = 0
        while i < 16 {
            var b = oren_bytes_get_u8(ip6_bytes, i)
            if b < 0 || b > 255 { return 0 }
            ptr_set_byte(sa + 8 + i, b)
            i = i + 1
        }
    }
    return sa
}

fn oren_sockaddr_un(path) {
    // struct sockaddr_un:
    // - macOS/BSD: len(u8) + family(u8) + path[104], sizeof=106
    // - Linux: family(u16) + path[108], sizeof=110
    //
    // Input:
    // - path: string (NUL not required; we NUL-terminate if room)
    if path == 0 { return 0 }
    var n = oren_string_len(path)
    if n < 0 { return 0 }

    if g_target_os == 1 {
        var sa = malloc(106)
        if sa == 0 { return 0 }
        oren_track_alloc(sa, 106, 0)
        var zi = 0
        while zi < 106 { ptr_set_byte(sa + zi, 0); zi = zi + 1 }
        ptr_set_byte(sa + 0, 106)
        ptr_set_byte(sa + 1, OREN_AF_UNIX)
        var i = 0
        while i < n {
            if i >= 104 { break }
            ptr_set_byte(sa + 2 + i, ptr_get_byte(path + i))
            i = i + 1
        }
        // NUL terminate if there is space
        if i < 104 { ptr_set_byte(sa + 2 + i, 0) }
        return sa
    }

    // Linux
    var sa2 = malloc(110)
    if sa2 == 0 { return 0 }
    oren_track_alloc(sa2, 110, 0)
    var zj = 0
    while zj < 110 { ptr_set_byte(sa2 + zj, 0); zj = zj + 1 }
    ptr_set_byte(sa2 + 0, OREN_AF_UNIX)
    ptr_set_byte(sa2 + 1, 0)
    var j = 0
    while j < n {
        if j >= 108 { break }
        ptr_set_byte(sa2 + 2 + j, ptr_get_byte(path + j))
        j = j + 1
    }
    if j < 108 { ptr_set_byte(sa2 + 2 + j, 0) }
    return sa2
}

@cap.requires(domain="NET")
fn oren_tcp_set_nonblock(fd) {
    native_capsule_require(CAP_NET, "NET")
    var flags = sys_fcntl_getfl(fd)
    if flags < 0 { return flags }
    var r = sys_fcntl_setfl(fd, flags | OREN_O_NONBLOCK)
    return r
}

@cap.requires(domain="NET")
fn native_net_init_once() {
    // Windows requires WinSock initialization (WSAStartup) before any socket operations.
    //
    // Design:
    // - keep the host effect behind the NET capability boundary
    // - avoid doing it in the entry stub (keeps capsule policy explicit)
    // - no-op on non-Windows targets
    native_capsule_require(CAP_NET, "NET")
    if g_target_os != 3 { return 0 }
    if g_net_wsa_inited == 1 { return 0 }

    // WSADATA is ~400 bytes; allocate a little slack (rolling).
    var ws = malloc(512)
    if ws == 0 { return 0 - 12 } // ENOMEM
    oren_track_alloc(ws, 512, 0)
    var rc = sys_wsa_startup(ws)
    free(ws)
    if rc < 0 { return rc }
    g_net_wsa_inited = 1
    return 0
}

@cap.requires(domain="NET")
fn oren_tcp_wait_kqueue(fd, filter, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    // Returns 1 if ready, 0 if timed out, or negative errno.
    if timeout_ms < 0 { timeout_ms = 0 }
    if g_net_has_kqueue == 0 { return 0 - 78 } // ENOSYS
    var kq = sys_kqueue()
    if g_net_has_kqueue == -1 {
        // First-time detection.
        if kq < 0 {
            g_net_has_kqueue = 0
            return 0 - 78 // ENOSYS
        }
        g_net_has_kqueue = 1
    } else {
        if kq < 0 { return kq }
    }

    var change = malloc(32)
    if change == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(change, 32, 0)
    var ev = malloc(32)
    if ev == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(ev, 32, 0)

    // Zero-fill the kevent structs (malloc does not promise zeroed memory).
    var zi = 0
    while zi < 32 {
        ptr_set_byte(change + zi, 0)
        ptr_set_byte(ev + zi, 0)
        zi = zi + 1
    }

    // struct kevent:
    // ident (u64) @0
    // filter (i16) @8
    // flags (u16)  @10
    // fflags (u32) @12
    // data (i64)   @16
    // udata (ptr)  @24
    ptr_set(change + 0, fd)
    ptr_set_byte(change + 8, filter & 255)
    ptr_set_byte(change + 9, (filter >> 8) & 255)
    var kflags = 1 | 4 | 16 // EV_ADD | EV_ENABLE | EV_ONESHOT
    ptr_set_byte(change + 10, kflags & 255)
    ptr_set_byte(change + 11, (kflags >> 8) & 255)
    ptr_set(change + 16, 0)
    ptr_set(change + 24, 0)

    // timespec*
    var ts = 0
    ts = malloc(16)
    if ts == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(ts, 16, 0)
    var sec = timeout_ms / 1000
    var nsec = (timeout_ms - sec * 1000) * 1000000
    ptr_set(ts + 0, sec)
    ptr_set(ts + 8, nsec)

    var n = sys_kevent(kq, change, 1, ev, 1, ts)
    sys_close(kq)
    // Avoid leaking temporaries; free() is deterministic and reuses blocks.
    free(change)
    free(ev)
    free(ts)
    return n
}

@cap.requires(domain="NET")
fn oren_fd_wait_epoll(fd, events_mask, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    // Returns 1 if ready, 0 if timed out, or negative errno.
    //
    // Linux only. Darwin does not have epoll (return -ENOSYS).
    if g_target_os == 1 { return 0 - 78 } // ENOSYS
    // Rolling determinism rule: avoid accidental hangs. Treat negative timeout as "no wait".
    if timeout_ms < 0 { timeout_ms = 0 }

    var epfd = sys_epoll_create1(0)
    if epfd < 0 { return epfd }

    // Linux epoll syscall ABI is arch-dependent (packed on x86_64, aligned on arm64).
    // `native_runtime_init` probes the active layout once and fills:
    //   - OREN_EPOLL_EVENT_BYTES
    //   - OREN_EPOLL_EVENT_OFF_DATA
    var evsz = OREN_EPOLL_EVENT_BYTES
    if evsz == 0 { evsz = 16 }
    var data_off = OREN_EPOLL_EVENT_OFF_DATA
    if data_off == 0 { data_off = 8 }
    var ev = malloc(evsz)
    if ev == 0 { sys_close(epfd); return 0 - 12 } // ENOMEM
    oren_track_alloc(ev, evsz, 0)
    var out = malloc(evsz)
    if out == 0 { sys_close(epfd); free(ev); return 0 - 12 } // ENOMEM
    oren_track_alloc(out, evsz, 0)

    var zi = 0
    while zi < evsz {
        ptr_set_byte(ev + zi, 0)
        ptr_set_byte(out + zi, 0)
        zi = zi + 1
    }

    oren_ptr_set_u32_le(ev + 0, events_mask)
    oren_ptr_set_u64_le(ev + data_off, fd)

    var rc = sys_epoll_ctl(epfd, OREN_EPOLL_CTL_ADD, fd, ev)
    if rc < 0 {
        sys_close(epfd)
        free(ev)
        free(out)
        return rc
    }

    var n = sys_epoll_pwait(epfd, out, 1, timeout_ms, 0, 0)
    sys_close(epfd)
    free(ev)
    free(out)
    if n > 0 { return 1 }
    return n
}

@cap.requires(domain="NET")
fn oren_fd_wait_select_one(fd, want_write, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    // Windows-only readiness wait using WinSock select().
    //
    // Returns 1 if ready, 0 if timed out, or negative errno.
    if g_target_os != 3 { return 0 - 78 } // ENOSYS
    if timeout_ms < 0 { timeout_ms = 0 }

    // fd_set (Windows, x64):
    //   u32 fd_count @0
    //   u32 pad      @4
    //   SOCKET fd0   @8
    var fds = malloc(16)
    if fds == 0 { return 0 - 12 } // ENOMEM
    var zi = 0
    while zi < 16 { ptr_set_byte(fds + zi, 0); zi = zi + 1 }
    oren_ptr_set_u32_le(fds + 0, 1)
    oren_ptr_set_u64_le(fds + 8, fd)

    // timeval (Windows uses 32-bit longs even on x64: LLP64).
    //   u32 tv_sec  @0
    //   u32 tv_usec @4
    var tv = malloc(16)
    if tv == 0 { free(fds); return 0 - 12 } // ENOMEM
    zi = 0
    while zi < 16 { ptr_set_byte(tv + zi, 0); zi = zi + 1 }
    var sec = timeout_ms / 1000
    var usec = (timeout_ms - sec * 1000) * 1000
    // Clamp to u32 range (select uses 32-bit fields).
    if sec < 0 { sec = 0 }
    if sec > 4294967295 { sec = 4294967295 }
    if usec < 0 { usec = 0 }
    if usec > 4294967295 { usec = 4294967295 }
    oren_ptr_set_u32_le(tv + 0, sec)
    oren_ptr_set_u32_le(tv + 4, usec)

    // select ignores nfds on Windows; keep it 0 for determinism.
    var rc = 0
    if want_write == 1 {
        rc = sys_select(0, 0, fds, 0, tv)
    } else {
        rc = sys_select(0, fds, 0, 0, tv)
    }
    free(fds)
    free(tv)
    if rc > 0 { return 1 }
    return rc
}

@cap.requires(domain="NET")
fn oren_fd_wait_readable(fd, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if g_target_os == 3 {
        return oren_fd_wait_select_one(fd, 0, timeout_ms)
    }
    if g_net_has_kqueue == 1 {
        return oren_tcp_wait_kqueue(fd, -1, timeout_ms) // EVFILT_READ
    }
    return oren_fd_wait_epoll(fd, OREN_EPOLLIN, timeout_ms)
}

@cap.requires(domain="NET")
fn oren_fd_wait_writable(fd, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if g_target_os == 3 {
        return oren_fd_wait_select_one(fd, 1, timeout_ms)
    }
    if g_net_has_kqueue == 1 {
        return oren_tcp_wait_kqueue(fd, -2, timeout_ms) // EVFILT_WRITE
    }
    return oren_fd_wait_epoll(fd, OREN_EPOLLOUT, timeout_ms)
}

@cap.requires(domain="NET")
fn oren_fd_wait_any_kqueue(fds, filter, timeout_ms, out_fd_ptr) {
    native_capsule_require(CAP_NET, "NET")
    // Wait for any fd in `fds` to be ready for `filter`.
    // Returns 1 if ready (writes ready fd to out_fd_ptr), 0 if timed out, or negative errno.
    if fds == nil { return 0 - 22 } // EINVAL
    if out_fd_ptr == 0 { return 0 - 22 } // EINVAL
    var nfds = oren_list_len(fds)
    if nfds <= 0 { return 0 - 22 } // EINVAL

    // Match existing NET wait semantics: negative timeout means "no wait" (avoid hangs).
    if timeout_ms < 0 { timeout_ms = 0 }
    if g_net_has_kqueue == 0 { return 0 - 78 } // ENOSYS (no kqueue backend)

    var kq = sys_kqueue()
    if g_net_has_kqueue == -1 {
        // First-time detection.
        if kq < 0 {
            g_net_has_kqueue = 0
            return 0 - 78 // ENOSYS
        }
        g_net_has_kqueue = 1
    } else {
        if kq < 0 { return kq }
    }

    // struct kevent size is 32 bytes on Darwin.
    var change = malloc(nfds * 32)
    if change == 0 { sys_close(kq); return 0 - 12 } // ENOMEM
    oren_track_alloc(change, nfds * 32, 0)
    var ev = malloc(32)
    if ev == 0 { sys_close(kq); free(change); return 0 - 12 } // ENOMEM
    oren_track_alloc(ev, 32, 0)

    // Zero-fill changelist and event buffer.
    var zi = 0
    while zi < nfds * 32 {
        ptr_set_byte(change + zi, 0)
        zi = zi + 1
    }
    zi = 0
    while zi < 32 {
        ptr_set_byte(ev + zi, 0)
        zi = zi + 1
    }

    // struct kevent layout:
    // ident (u64) @0
    // filter (i16) @8
    // flags (u16)  @10
    // fflags (u32) @12
    // data (i64)   @16
    // udata (ptr)  @24
    var kflags = 1 | 4 | 16 // EV_ADD | EV_ENABLE | EV_ONESHOT
    var i = 0
    while i < nfds {
        var fd = oren_list_get(fds, i)
        var base = change + i * 32
        ptr_set(base + 0, fd)
        ptr_set_byte(base + 8, filter & 255)
        ptr_set_byte(base + 9, (filter >> 8) & 255)
        ptr_set_byte(base + 10, kflags & 255)
        ptr_set_byte(base + 11, (kflags >> 8) & 255)
        ptr_set(base + 16, 0)
        ptr_set(base + 24, 0)
        i = i + 1
    }

    // timespec*
    var ts = malloc(16)
    if ts == 0 { sys_close(kq); free(change); free(ev); return 0 - 12 } // ENOMEM
    oren_track_alloc(ts, 16, 0)
    var sec = timeout_ms / 1000
    var nsec = (timeout_ms - sec * 1000) * 1000000
    ptr_set(ts + 0, sec)
    ptr_set(ts + 8, nsec)

    var n = sys_kevent(kq, change, nfds, ev, 1, ts)
    sys_close(kq)
    if n > 0 {
        // ready ident is a u64 at ev[0].
        var ready_fd = ptr_get(ev + 0)
        ptr_set(out_fd_ptr, ready_fd)
        n = 1
    }
    free(change)
    free(ev)
    free(ts)
    return n
}

@cap.requires(domain="NET")
fn oren_fd_wait_any_epoll(fds, events_mask, timeout_ms, out_fd_ptr) {
    native_capsule_require(CAP_NET, "NET")
    // Returns 1 if ready (writes ready fd to out_fd_ptr), 0 if timed out, or negative errno.
    // Linux only. Darwin does not have epoll.
    if g_target_os == 1 { return 0 - 78 } // ENOSYS
    if fds == nil { return 0 - 22 } // EINVAL
    if out_fd_ptr == 0 { return 0 - 22 } // EINVAL
    var nfds = oren_list_len(fds)
    if nfds <= 0 { return 0 - 22 } // EINVAL

    // Rolling determinism rule: avoid accidental hangs. Treat negative timeout as "no wait".
    if timeout_ms < 0 { timeout_ms = 0 }
    var epfd = sys_epoll_create1(0)
    if epfd < 0 { return epfd }

    // Linux epoll syscall ABI is arch-dependent (packed on x86_64, aligned on arm64).
    // `native_runtime_init` probes the active layout once and fills:
    //   - OREN_EPOLL_EVENT_BYTES
    //   - OREN_EPOLL_EVENT_OFF_DATA
    var evsz = OREN_EPOLL_EVENT_BYTES
    if evsz == 0 { evsz = 16 }
    var data_off = OREN_EPOLL_EVENT_OFF_DATA
    if data_off == 0 { data_off = 8 }
    var ev = malloc(evsz)
    if ev == 0 { sys_close(epfd); return 0 - 12 } // ENOMEM
    oren_track_alloc(ev, evsz, 0)
    var out = malloc(evsz)
    if out == 0 { sys_close(epfd); free(ev); return 0 - 12 } // ENOMEM
    oren_track_alloc(out, evsz, 0)

    var zi = 0
    while zi < evsz {
        ptr_set_byte(ev + zi, 0)
        ptr_set_byte(out + zi, 0)
        zi = zi + 1
    }

    // Register all fds.
    var i = 0
    while i < nfds {
        var fd = oren_list_get(fds, i)
        // Set per-fd data so the returned event includes the ready fd.
        oren_ptr_set_u32_le(ev + 0, events_mask)
        oren_ptr_set_u64_le(ev + data_off, fd)
        var rc = sys_epoll_ctl(epfd, OREN_EPOLL_CTL_ADD, fd, ev)
        if rc < 0 {
            sys_close(epfd)
            free(ev)
            free(out)
            return rc
        }
        i = i + 1
    }

    var n = sys_epoll_pwait(epfd, out, 1, timeout_ms, 0, 0)
    sys_close(epfd)
    if n > 0 {
        var ready_fd = oren_ptr_get_u64_le(out + data_off)
        ptr_set(out_fd_ptr, ready_fd)
        n = 1
    }
    free(ev)
    free(out)
    return n
}

@cap.requires(domain="NET")
fn oren_fd_wait_any_readable(fds, timeout_ms, out_fd_ptr) {
    native_capsule_require(CAP_NET, "NET")
    if g_target_os == 3 {
        // Minimal Windows implementation: build a single fd_set and return the first ready fd.
        if fds == nil { return 0 - 22 } // EINVAL
        if out_fd_ptr == 0 { return 0 - 22 } // EINVAL
        var nfds = oren_list_len(fds)
        if nfds <= 0 { return 0 - 22 } // EINVAL
        // Windows FD_SETSIZE default is 64; keep v0 explicit.
        if nfds > 64 { return 0 - 22 } // EINVAL
        if timeout_ms < 0 { timeout_ms = 0 }

        var set = malloc(8 + 8 * 64)
        if set == 0 { return 0 - 12 } // ENOMEM
        oren_track_alloc(set, 8 + 8 * 64, 0)
        var zi = 0
        while zi < 8 + 8 * 64 { ptr_set_byte(set + zi, 0); zi = zi + 1 }
        oren_ptr_set_u32_le(set + 0, nfds)
        var i = 0
        while i < nfds {
            oren_ptr_set_u64_le(set + 8 + i * 8, oren_list_get(fds, i))
            i = i + 1
        }

        var tv = malloc(16)
        if tv == 0 { free(set); return 0 - 12 } // ENOMEM
        oren_track_alloc(tv, 16, 0)
        zi = 0
        while zi < 16 { ptr_set_byte(tv + zi, 0); zi = zi + 1 }
        var sec = timeout_ms / 1000
        var usec = (timeout_ms - sec * 1000) * 1000
        if sec < 0 { sec = 0 }
        if sec > 4294967295 { sec = 4294967295 }
        if usec < 0 { usec = 0 }
        if usec > 4294967295 { usec = 4294967295 }
        oren_ptr_set_u32_le(tv + 0, sec)
        oren_ptr_set_u32_le(tv + 4, usec)

        var rc = sys_select(0, set, 0, 0, tv)
        if rc > 0 {
            // select compacts the set to ready fds and updates fd_count.
            var ready = oren_ptr_get_u64_le(set + 8)
            ptr_set(out_fd_ptr, ready)
            rc = 1
        }
        free(set)
        free(tv)
        return rc
    }
    if g_net_has_kqueue == 1 {
        return oren_fd_wait_any_kqueue(fds, -1, timeout_ms, out_fd_ptr) // EVFILT_READ
    }
    return oren_fd_wait_any_epoll(fds, OREN_EPOLLIN, timeout_ms, out_fd_ptr)
}

@cap.requires(domain="NET")
fn oren_fd_wait_any_writable(fds, timeout_ms, out_fd_ptr) {
    native_capsule_require(CAP_NET, "NET")
    if g_target_os == 3 {
        if fds == nil { return 0 - 22 } // EINVAL
        if out_fd_ptr == 0 { return 0 - 22 } // EINVAL
        var nfds = oren_list_len(fds)
        if nfds <= 0 { return 0 - 22 } // EINVAL
        if nfds > 64 { return 0 - 22 } // EINVAL
        if timeout_ms < 0 { timeout_ms = 0 }

        var set = malloc(8 + 8 * 64)
        if set == 0 { return 0 - 12 } // ENOMEM
        oren_track_alloc(set, 8 + 8 * 64, 0)
        var zi = 0
        while zi < 8 + 8 * 64 { ptr_set_byte(set + zi, 0); zi = zi + 1 }
        oren_ptr_set_u32_le(set + 0, nfds)
        var i = 0
        while i < nfds {
            oren_ptr_set_u64_le(set + 8 + i * 8, oren_list_get(fds, i))
            i = i + 1
        }

        var tv = malloc(16)
        if tv == 0 { free(set); return 0 - 12 } // ENOMEM
        oren_track_alloc(tv, 16, 0)
        zi = 0
        while zi < 16 { ptr_set_byte(tv + zi, 0); zi = zi + 1 }
        var sec = timeout_ms / 1000
        var usec = (timeout_ms - sec * 1000) * 1000
        if sec < 0 { sec = 0 }
        if sec > 4294967295 { sec = 4294967295 }
        if usec < 0 { usec = 0 }
        if usec > 4294967295 { usec = 4294967295 }
        oren_ptr_set_u32_le(tv + 0, sec)
        oren_ptr_set_u32_le(tv + 4, usec)

        var rc = sys_select(0, 0, set, 0, tv)
        if rc > 0 {
            var ready = oren_ptr_get_u64_le(set + 8)
            ptr_set(out_fd_ptr, ready)
            rc = 1
        }
        free(set)
        free(tv)
        return rc
    }
    if g_net_has_kqueue == 1 {
        return oren_fd_wait_any_kqueue(fds, -2, timeout_ms, out_fd_ptr) // EVFILT_WRITE
    }
    return oren_fd_wait_any_epoll(fds, OREN_EPOLLOUT, timeout_ms, out_fd_ptr)
}

@cap.requires(domain="NET")
fn oren_tcp_connect(ip, port, timeout_ms) {
    native_capsule_require_net_connect(ip, port)
    var init_rc = native_net_init_once()
    if init_rc < 0 { return init_rc }
    var fd = sys_socket(OREN_AF_INET, OREN_SOCK_STREAM, OREN_IPPROTO_TCP)
    if fd < 0 { return fd }

    // Non-blocking + explicit wait for connect completion.
    var nb = oren_tcp_set_nonblock(fd)
    if nb < 0 {
        sys_close(fd)
        return nb
    }

    var sa = oren_tcp_sockaddr_in(ip, port)
    if sa == 0 {
        sys_close(fd)
        return 0 - 22 // EINVAL
    }

    var rc = sys_connect(fd, sa, 16)
    free(sa)
    if rc == 0 { return fd }
    // EINPROGRESS:
    // - macOS: 36
    // - Linux: 115
    if rc != 0 - 36 && rc != 0 - 115 {
        sys_close(fd)
        return rc
    }

    // Check SO_ERROR to determine connect result.
    var soerr_buf = malloc(8)
    if soerr_buf == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(soerr_buf, 8, 0)
    ptr_set(soerr_buf, 0)
    var olen = malloc(8)
    if olen == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(olen, 8, 0)
    ptr_set(olen, 4)

    // Readiness wait for connect completion:
    // - macOS: kqueue-backed
    // - Linux: epoll-backed (syscall-first, no libc)
    var n = oren_fd_wait_writable(fd, timeout_ms)
    if n == 0 {
        free(soerr_buf)
        free(olen)
        sys_close(fd)
        return 0 - 60 // ETIMEDOUT
    }
    if n < 0 {
        free(soerr_buf)
        free(olen)
        sys_close(fd)
        return n
    }

    var grc = sys_getsockopt(fd, OREN_SOL_SOCKET, OREN_SO_ERROR, soerr_buf, olen)
    if grc < 0 {
        free(soerr_buf)
        free(olen)
        sys_close(fd)
        return grc
    }
    var soerr = ptr_get(soerr_buf)
    free(soerr_buf)
    free(olen)
    if soerr != 0 {
        sys_close(fd)
        return 0 - soerr
    }

    return fd
}

@cap.requires(domain="NET")
fn oren_tcp_listen_local(port) {
    native_capsule_require_net_listen(0, port)
    var init_rc = native_net_init_once()
    if init_rc < 0 { return init_rc }
    var fd = sys_socket(OREN_AF_INET, OREN_SOCK_STREAM, OREN_IPPROTO_TCP)
    if fd < 0 { return fd }

    // Allow quick reuse during tests.
    var one = malloc(8)
    if one == 0 { sys_close(fd); return 0 - 12 } // ENOMEM
    oren_track_alloc(one, 8, 0)
    ptr_set(one, 1)
    var sroc = sys_setsockopt(fd, OREN_SOL_SOCKET, OREN_SO_REUSEADDR, one, 4)
    free(one)
    if sroc < 0 {
        sys_close(fd)
        return sroc
    }

    var nb = oren_tcp_set_nonblock(fd)
    if nb < 0 {
        sys_close(fd)
        return nb
    }

    var sa = oren_tcp_sockaddr_in(0, port) // 127.0.0.1
    if sa == 0 {
        sys_close(fd)
        return 0 - 22 // EINVAL
    }

    var brc = sys_bind(fd, sa, 16)
    free(sa)
    if brc < 0 {
        sys_close(fd)
        return brc
    }

    var lrc = sys_listen(fd, 16)
    if lrc < 0 {
        sys_close(fd)
        return lrc
    }

    return fd
}

@cap.requires(domain="NET")
fn oren_tcp_accept(listen_fd, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    var n = oren_fd_wait_readable(listen_fd, timeout_ms)
    if n == 0 { return 0 - 60 } // ETIMEDOUT
    if n < 0 { return n }
    var fd = sys_accept(listen_fd, 0, 0)
    if fd < 0 { return fd }
    // Ensure accepted sockets are non-blocking on all OSes.
    // Some platforms do not reliably inherit O_NONBLOCK from the listening fd.
    var nb = oren_tcp_set_nonblock(fd)
    if nb < 0 {
        sys_close(fd)
        return nb
    }
    return fd
}

@cap.requires(domain="NET")
fn oren_tcp_read_into(fd, buf, len, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if len <= 0 { return 0 }

    // The socket is non-blocking, and readiness waits can be spuriously satisfied
    // across OSes (or race with close/reset). Treat EAGAIN/EWOULDBLOCK as retry
    // until the caller timeout elapses.
    //
    // IMPORTANT: never return `0` on EAGAIN here.
    // For TCP stream reads, `0` is the only reliable "EOF/closed" indicator.
    var deadline_ns = 0
    if timeout_ms > 0 {
        var t0 = oren_time_unix_ns()
        if t0 != 0 {
            deadline_ns = t0 + timeout_ms * 1000000
        }
    }

    while 1 {
        // Try the nonblocking recv first. This avoids relying solely on readiness waits:
        // - reduces syscall overhead when data is already buffered
        // - hardens against occasional readiness false-negatives (observed flakiness on some WinSock/select paths)
        var r0 = sys_recvfrom(fd, buf, len, 0, 0, 0)
        // EAGAIN/EWOULDBLOCK:
        // - macOS: 35
        // - Linux/Windows: 11 (Windows WSAEWOULDBLOCK is normalized in syscall lowering)
        if r0 != 0 - 35 && r0 != 0 - 11 { return r0 }

        var rem_ms = timeout_ms
        if deadline_ns != 0 {
            var now = oren_time_unix_ns()
            if now != 0 {
                var rem_ns = deadline_ns - now
                if rem_ns <= 0 { return 0 - 60 } // ETIMEDOUT
                rem_ms = rem_ns / 1000000
                if rem_ms < 0 { rem_ms = 0 }
            }
        }

        var n = oren_fd_wait_readable(fd, rem_ms)
        if n == 0 {
            // WinSock `select` can be flaky under load on some hosts (sporadic false timeouts).
            // Before returning ETIMEDOUT, retry `recv` and, if we still have time budget,
            // continue the loop instead of trusting the timeout result.
            var r1 = sys_recvfrom(fd, buf, len, 0, 0, 0)
            if r1 != 0 - 35 && r1 != 0 - 11 { return r1 }
            if deadline_ns != 0 {
                var now2 = oren_time_unix_ns()
                if now2 != 0 && now2 < deadline_ns { continue }
            }
            return 0 - 60 // ETIMEDOUT
        }
        if n < 0 { return n }
        // Wait satisfied; loop back and attempt recv again.
    }
}

@cap.requires(domain="NET")
fn oren_tcp_write_from(fd, buf, len, timeout_ms) {
    native_capsule_require(CAP_NET, "NET")
    if len <= 0 { return 0 }

    // `sys_sendto` can return partial writes on stream sockets.
    // The NET surface in tests + stdlib expects "write len bytes or fail/timed out".
    //
    // Keep this bounded by caller-provided timeout (no hangs).
    var deadline_ns = 0
    if timeout_ms > 0 {
        var t0 = oren_time_unix_ns()
        if t0 != 0 {
            deadline_ns = t0 + timeout_ms * 1000000
        }
    }

    var off = 0
    while off < len {
        // Try the nonblocking send first (common fast path).
        var w0 = sys_sendto(fd, iadd(buf, off), len - off, 0, 0, 0)
        if w0 == 0 - 35 || w0 == 0 - 11 {
            // Need to wait for writability.
            var rem_ms = timeout_ms
            if deadline_ns != 0 {
                var now = oren_time_unix_ns()
                if now != 0 {
                    var rem_ns = deadline_ns - now
                    if rem_ns <= 0 { return 0 - 60 } // ETIMEDOUT
                    rem_ms = rem_ns / 1000000
                    if rem_ms < 0 { rem_ms = 0 }
                }
            }

            var n = oren_fd_wait_writable(fd, rem_ms)
            if n == 0 {
                // Same robustness policy as reads: if the wait reports a timeout but we still
                // have a deadline budget, retry instead of returning ETIMEDOUT immediately.
                if deadline_ns != 0 {
                    var now2 = oren_time_unix_ns()
                    if now2 != 0 && now2 < deadline_ns { continue }
                }
                return 0 - 60 // ETIMEDOUT
            }
            if n < 0 { return n }
            continue
        }
        if w0 < 0 { return w0 }
        if w0 == 0 { return 0 - 5 } // EIO (avoid infinite loop)
        off = off + w0
    }
    return len
}

@cap.requires(domain="NET")
fn oren_tcp_close(fd) {
    native_capsule_require(CAP_NET, "NET")
    if fd < 0 { return 0 }
    // best-effort shutdown; ignore errors
    sys_shutdown(fd, 2) // SHUT_RDWR
    sys_close(fd)
    return 0
}
