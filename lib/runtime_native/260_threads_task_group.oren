var g_task_group_runtime_groups = {}
var g_task_group_runtime_next_id = -900000000000000000

fn _task_group_runtime_ensure_state() {
    if oren_type_name(g_task_group_runtime_groups) != "map" {
        g_task_group_runtime_groups = {}
    }
    if oren_type_name(g_task_group_runtime_next_id) != "int" {
        g_task_group_runtime_next_id = -900000000000000000
    }
}

fn _task_group_runtime_state_or_nil(group) {
    _task_group_runtime_ensure_state()
    if oren_type_name(group) != "int" { return nil }
    var state = g_task_group_runtime_groups[group]
    if oren_type_name(state) == "list" {
        state = {
            "members": state,
            "default_policy": {},
        }
        g_task_group_runtime_groups[group] = state
    }
    if oren_type_name(state) != "map" { return nil }
    var members = oren_map_get_str(state, "members")
    if oren_type_name(members) != "list" {
        members = []
        oren_map_set_str(state, "members", members)
    }
    var policy = oren_map_get_str(state, "default_policy")
    if oren_type_name(policy) != "map" {
        policy = {}
        oren_map_set_str(state, "default_policy", policy)
    }
    return state
}

fn _task_group_runtime_members_or_nil(group) {
    var state = _task_group_runtime_state_or_nil(group)
    if oren_type_name(state) != "map" { return nil }
    var members = oren_map_get_str(state, "members")
    if oren_type_name(members) != "list" { return nil }
    return members
}

fn _task_group_runtime_policy_or_nil(group) {
    var state = _task_group_runtime_state_or_nil(group)
    if oren_type_name(state) != "map" { return nil }
    var policy = oren_map_get_str(state, "default_policy")
    if oren_type_name(policy) != "map" { return nil }
    return policy
}

fn _task_group_runtime_has_member(members, target) {
    var i = 0
    var n = oren_list_len(members)
    while i < n {
        if members[i] == target { return true }
        i = i + 1
    }
    return false
}

fn _task_group_runtime_member_kind(target) {
    if oren_task_is_handle(target) == true { return "task" }
    var tn = oren_type_name(target)
    if tn == "generator" || tn == "generator_context" { return tn }
    return nil
}

fn _task_group_runtime_member_live(target) {
    return _task_group_runtime_member_kind(target) != nil
}

fn _task_group_runtime_members_compact(group) {
    var members = _task_group_runtime_members_or_nil(group)
    if oren_type_name(members) != "list" { return nil }
    var out = []
    var i = 0
    var n = oren_list_len(members)
    while i < n {
        var target = members[i]
        if _task_group_runtime_member_live(target) == true {
            if _task_group_runtime_has_member(out, target) != true {
                oren_list_push(out, target)
            }
        }
        i = i + 1
    }
    var state = _task_group_runtime_state_or_nil(group)
    if oren_type_name(state) == "map" {
        oren_map_set_str(state, "members", out)
    }
    return out
}

@oren.keep
fn oren_task_is_handle(handle) {
    if handle == 0 { return false }
    if oren_green_is_g(handle) { return true }
    return false
}

@oren.keep
fn oren_task_is_done(handle) {
    if oren_task_is_handle(handle) != true { return false }
    if oren_green_is_g(handle) { return oren_green_is_done(handle) }
    return false
}

@oren.keep
fn oren_task_current_handle() {
    var g = oren_green_current_g_or0()
    if g == 0 { return nil }
    return g
}

@oren.keep
fn oren_task_request_cancel(handle, reason) {
    if oren_task_is_handle(handle) != true {
        return oren_err(4, "oren_task_request_cancel: expected task handle")
    }
    if ptr_get(handle + green_g_off_cancel_requested()) == 0 {
        ptr_set(handle + green_g_off_cancel_requested(), 1)
        ptr_set(handle + green_g_off_cancel_reason(), reason)
    }
    return nil
}

@oren.keep
fn oren_task_is_cancel_requested(handle) {
    if oren_task_is_handle(handle) != true { return false }
    return ptr_get(handle + green_g_off_cancel_requested()) != 0
}

@oren.keep
fn oren_task_cancel_reason(handle) {
    if oren_task_is_handle(handle) != true { return nil }
    return ptr_get(handle + green_g_off_cancel_reason())
}

fn _task_runtime_stop_result(status, result, reason, detach_result) {
    return {
        "status": status,
        "result": result,
        "reason": reason,
        "detach_result": detach_result,
    }
}

fn _task_runtime_delay_before_cancel(handle, delay_ms) {
    if delay_ms <= 0 { return 0 }
    if oren_green_is_g(handle) == true && g_green_workers_started == 0 && _green_enabled() == true {
        var start_ns = _green_time_now_ns()
        if start_ns != 0 {
            var deadline_ns = start_ns + delay_ms * 1000000
            while 1 {
                var now_ns = _green_time_now_ns()
                if now_ns == 0 { break }
                if now_ns >= deadline_ns { return 0 }
                _green_poll_until(deadline_ns)
            }
        }
    }
    return oren_sleep_ms(delay_ms)
}

@oren.keep
fn oren_task_cancel_now(handle, reason) {
    if oren_task_is_handle(handle) != true {
        return oren_err(4, "oren_task_cancel_now: expected task handle")
    }
    if oren_task_is_done(handle) != true {
        var req = oren_task_request_cancel(handle, reason)
        if oren_is_err(req) == true { return req }
    }
    var rv = oren_join_timeout(handle, 0)
    if oren_is_err(rv) == true { return rv }
    if rv == -60 {
        var detach_rv = nil
        if oren_task_is_handle(handle) == true {
            detach_rv = oren_detach(handle)
            if oren_is_err(detach_rv) == true {
                return _task_runtime_stop_result("detach_error", rv, reason, detach_rv)
            }
        }
        return _task_runtime_stop_result("detached", rv, reason, detach_rv)
    }
    return _task_runtime_stop_result("joined", rv, reason, nil)
}

@oren.keep
fn oren_task_cancel_wait(handle, wait_ms, reason) {
    if oren_task_is_handle(handle) != true {
        return oren_err(4, "oren_task_cancel_wait: expected task handle")
    }
    if oren_type_name(wait_ms) != "int" {
        return oren_err(4, "oren_task_cancel_wait: expected int wait_ms")
    }
    if wait_ms <= 0 {
        return oren_task_cancel_now(handle, reason)
    }
    if oren_task_is_done(handle) != true {
        var req = oren_task_request_cancel(handle, reason)
        if oren_is_err(req) == true { return req }
    }
    var rv = oren_join_timeout(handle, wait_ms)
    if oren_is_err(rv) == true { return rv }
    if rv == -60 {
        var detach_rv = nil
        if oren_task_is_handle(handle) == true {
            detach_rv = oren_detach(handle)
            if oren_is_err(detach_rv) == true {
                return _task_runtime_stop_result("detach_error", rv, reason, detach_rv)
            }
        }
        return _task_runtime_stop_result("detached", rv, reason, detach_rv)
    }
    return _task_runtime_stop_result("joined", rv, reason, nil)
}

@oren.keep
fn oren_task_cancel_after_wait(handle, delay_ms, wait_ms, reason) {
    if oren_task_is_handle(handle) != true {
        return oren_err(4, "oren_task_cancel_after_wait: expected task handle")
    }
    if oren_type_name(delay_ms) != "int" {
        return oren_err(4, "oren_task_cancel_after_wait: expected int delay_ms")
    }
    if oren_type_name(wait_ms) != "int" {
        return oren_err(4, "oren_task_cancel_after_wait: expected int wait_ms")
    }
    var delay_rv = _task_runtime_delay_before_cancel(handle, delay_ms)
    if oren_is_err(delay_rv) == true { return delay_rv }
    return oren_task_cancel_wait(handle, wait_ms, reason)
}

@oren.keep
fn oren_task_stop_capabilities() {
    return {
        "immediate_cancel_now": true,
        "cancel_request_state": true,
        "bounded_wait_native_call": true,
        "delayed_wait_native_call": true,
        "blocking_native_call_scheduler": true,
    }
}

@oren.keep
fn oren_task_group_new() {
    _task_group_runtime_ensure_state()
    var id = g_task_group_runtime_next_id
    g_task_group_runtime_next_id = g_task_group_runtime_next_id - 1
    g_task_group_runtime_groups[id] = {
        "members": [],
        "default_policy": {},
    }
    return id
}

@oren.keep
fn oren_task_group_is_handle(group) {
    return oren_type_name(_task_group_runtime_state_or_nil(group)) == "map"
}

@oren.keep
fn oren_task_group_add(group, target) {
    var members = _task_group_runtime_members_compact(group)
    if oren_type_name(members) != "list" { return nil }
    if _task_group_runtime_member_live(target) != true { return nil }
    if _task_group_runtime_has_member(members, target) != true {
        oren_list_push(members, target)
        var state = _task_group_runtime_state_or_nil(group)
        if oren_type_name(state) == "map" {
            oren_map_set_str(state, "members", members)
        }
    }
    return target
}

@oren.keep
fn oren_task_group_count(group) {
    var members = _task_group_runtime_members_compact(group)
    if oren_type_name(members) != "list" { return 0 }
    return oren_list_len(members)
}

@oren.keep
fn oren_task_group_members(group) {
    var members = _task_group_runtime_members_compact(group)
    if oren_type_name(members) != "list" { return [] }
    var out = []
    var i = 0
    var n = oren_list_len(members)
    while i < n {
        oren_list_push(out, members[i])
        i = i + 1
    }
    return out
}

@oren.keep
fn oren_task_group_member_kinds(group) {
    var members = _task_group_runtime_members_compact(group)
    if oren_type_name(members) != "list" { return [] }
    var out = []
    var i = 0
    var n = oren_list_len(members)
    while i < n {
        var kind = _task_group_runtime_member_kind(members[i])
        if kind != nil {
            oren_list_push(out, kind)
        }
        i = i + 1
    }
    return out
}

@oren.keep
fn oren_task_group_member_snapshot(group) {
    var members = _task_group_runtime_members_compact(group)
    if oren_type_name(members) != "list" { return [[], []] }
    var refs = []
    var kinds = []
    var i = 0
    var n = oren_list_len(members)
    while i < n {
        var kind = _task_group_runtime_member_kind(members[i])
        if kind != nil {
            oren_list_push(refs, members[i])
            oren_list_push(kinds, kind)
        }
        i = i + 1
    }
    return [refs, kinds]
}

@oren.keep
fn oren_task_group_snapshot(group) {
    var state = _task_group_runtime_state_or_nil(group)
    if oren_type_name(state) != "map" { return [[], [], nil] }
    var members = _task_group_runtime_members_compact(group)
    if oren_type_name(members) != "list" { return [[], [], nil] }
    var policy = oren_map_get_str(state, "default_policy")
    if oren_type_name(policy) != "map" { policy = nil }
    var refs = []
    var kinds = []
    var i = 0
    var n = oren_list_len(members)
    while i < n {
        var kind = _task_group_runtime_member_kind(members[i])
        if kind != nil {
            oren_list_push(refs, members[i])
            oren_list_push(kinds, kind)
        }
        i = i + 1
    }
    return [refs, kinds, policy]
}

@oren.keep
fn oren_task_group_take_snapshot(group) {
    var state = _task_group_runtime_state_or_nil(group)
    if oren_type_name(state) != "map" { return [[], [], nil] }
    var members = _task_group_runtime_members_compact(group)
    if oren_type_name(members) != "list" { return [[], [], nil] }
    var policy = oren_map_get_str(state, "default_policy")
    if oren_type_name(policy) != "map" { policy = nil }
    var refs = []
    var kinds = []
    var i = 0
    var n = oren_list_len(members)
    while i < n {
        var kind = _task_group_runtime_member_kind(members[i])
        if kind != nil {
            oren_list_push(refs, members[i])
            oren_list_push(kinds, kind)
        }
        i = i + 1
    }
    oren_map_set_str(state, "members", [])
    return [refs, kinds, policy]
}

@oren.keep
fn oren_task_group_clear(group) {
    if oren_task_group_is_handle(group) == true {
        var state = _task_group_runtime_state_or_nil(group)
        if oren_type_name(state) == "map" {
            oren_map_set_str(state, "members", [])
        }
    }
    return nil
}

@oren.keep
fn oren_task_group_default_policy(group) {
    var policy = _task_group_runtime_policy_or_nil(group)
    if oren_type_name(policy) != "map" { return nil }
    return policy
}

@oren.keep
fn oren_task_group_set_default_policy(group, policy) {
    var state = _task_group_runtime_state_or_nil(group)
    if oren_type_name(state) != "map" { return nil }
    oren_map_set_str(state, "default_policy", policy)
    return policy
}

@oren.keep
fn oren_task_group_spawn_call_list(group, fn_obj, args_list) {
    if oren_task_group_is_handle(group) != true {
        return oren_err(4, "oren_task_group_spawn_call_list: expected runtime task group")
    }
    if oren_type_name(args_list) != "list" {
        return oren_err(4, "oren_task_group_spawn_call_list: expected list args_list")
    }
    if _green_enabled() != true {
        return oren_err(7, "oren_task_group_spawn_call_list: runtime task groups require green-task scheduler")
    }
    var handle = oren_spawn_call_list(fn_obj, args_list)
    if oren_task_is_handle(handle) != true {
        return oren_err(7, "oren_task_group_spawn_call_list: spawn did not produce safe task handle")
    }
    oren_task_group_add(group, handle)
    return handle
}
