		        if new_cap < 4 { new_cap = 4 }
	        var new_buf = _list_alloc_buf(list, new_cap * 8, _alloc_site_list_buf(), 211)
		        var i = 0
		        while i < count {
		            ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
		            i = iadd(i, 1)
	        }
	        buf = new_buf
	        cap = new_cap
	        ptr_set(iadd(list, 8), cap)
	        ptr_set(iadd(list, 16), buf)
	    }
    ptr_set(iadd(buf, count * 8), value)
    ptr_set(iadd(list, 0), iadd(count, 1))
    _list_corrupt_check(list, 3) // list_push
    _list_trace_emit(4, list, 2) // list_push
    // Language-level semantics: `oren_list_push` is statement-like and returns `nil`.
    // (The list header pointer is stable and does not need to be returned.)
    return nil
}

