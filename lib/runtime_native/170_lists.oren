fn _list_reserve_fail_emit(stage, list, node, expected_kind, new_cap) {
    if _list_reserve_fail_enabled() != true { return 0 }
    print("[list_reserve_fail] stage=" + oren_int_to_string(stage) +
          " list=" + oren_int_to_string(list) +
          " node=" + oren_int_to_string(node) +
          " expect_kind=" + oren_int_to_string(expected_kind) +
          " new_cap=" + oren_int_to_string(new_cap))
    var hdr_len = 0
    var hdr_cap = 0
    var hdr_buf = 0
    var hdr_magic = 0
    if list != 0 && list >= 4096 {
        hdr_len = ptr_get(iadd(list, 0))
        hdr_cap = ptr_get(iadd(list, 8))
        hdr_buf = ptr_get(iadd(list, 16))
        hdr_magic = ptr_get(iadd(list, 24))
    }
    print("[list_reserve_fail] hdr_len=" + oren_int_to_string(hdr_len) +
          " hdr_cap=" + oren_int_to_string(hdr_cap) +
          " hdr_buf=" + oren_int_to_string(hdr_buf) +
          " hdr_magic=" + oren_int_to_string(hdr_magic))
    if node != 0 {
        var nk = ptr_get(iadd(node, 16))
        print("[list_reserve_fail] node_kind=" + oren_int_to_string(nk))
    }
    return 0
}

