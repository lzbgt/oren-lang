        if new_cap < want { new_cap = want }
        var bytes = _list_bytes_for_cap(new_cap)
        var new_buf = _list_alloc_buf(list, bytes, new_cap, list_int_kind(), _alloc_site_list_int_buf(), 212)

        var i = 0
