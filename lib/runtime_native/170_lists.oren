    if ptr_get(iadd(v, 24)) != list_magic() { return false }
    return true
}

@oren.keep
fn oren_list_int_len(list) {
    if list == nil { return 0 }
    var node = _list_find_node(list)
    if node == 0 {
        native_alloc_index_rebuild_live()
        node = _list_find_node(list)
    }
    if node == 0 {
        node = native_alloc_index_recover_ptr(list)
    }
    if node == 0 {
        if list >= 4096 && ptr_get(iadd(list, 24)) == list_magic() {
            var cap = ptr_get(iadd(list, 8))
            if cap >= 0 && cap < 1048576 {
                var total = 32
                if cap > 0 { total = total + cap * 8 }
                oren_track_alloc_new(list, total, list_int_kind())
                node = _list_find_node(list)
            }
        }
    }
    if node == 0 { _list_trace_dump(list); oren_panic("list_int_len on non-list"); return 0 }
    if ptr_get(iadd(node, 16)) != list_int_kind() { _list_trace_dump(list); oren_panic("list_int_len on non-list"); return 0 }
    if ptr_get(iadd(list, 24)) != list_magic() { _list_trace_dump(list); oren_panic("list_int_len on non-list"); return 0 }
    return ptr_get(iadd(list, 0))
}

