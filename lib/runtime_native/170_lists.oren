@oren.keep
fn oren_list_get(list, idx) {
    if list == nil {
        oren_panic("Indexing on nil")
        return nil
    }
    var count = 0
    if _list_assume_list_enabled() != true {
        // Safety: do not dereference arbitrary large integers as pointers.
        // `x[i]` is defined for lists and maps; reject other values deterministically.
        var node = _list_find_node(list)
        if node == 0 { oren_panic("Indexing on non-container"); return nil }
	    var kind = ptr_get(iadd(node, 16))
	    if kind != 2 && kind != list_int_kind() {
	        if kind == 3 {
                // Not a list: treat as map indexing.
                // Key kind is selected by `oren_map_get` using tracking metadata.
                return oren_map_get(list, idx)
            }
            oren_panic("Indexing on non-container")
		    return nil
	    }
	    if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("Indexing on non-list"); return nil }
	    count = ptr_get(iadd(list, 0))
    } else {
        count = ptr_get(iadd(list, 0))
    }
    if idx < 0 { 
        oren_panic("Index out of bounds (negative)")
        return nil
    }
    if idx >= count { 
        oren_panic("Index out of bounds")
        return nil
    }
	    var buf = ptr_get(iadd(list, 16))
	    return ptr_get(iadd(buf, idx * 8))
}

// Set list element, growing the list as needed. Returns the written value.
//
// Language-level semantics (rolling, matches C backend + tests):
// - `xs[i] = v` on a list grows `xs` to length `i+1` if needed.
// - New slots are initialized to `nil`.
@oren.keep
fn oren_list_set(list, idx, value) {
    if list == nil { oren_panic("list_set on nil"); return nil }
    // Safety: do not dereference arbitrary large integers as pointers.
	    var count = 0
        var is_list_int = 0
        if _list_assume_list_enabled() != true {
	        var node = _list_find_node(list)
	        if node == 0 { oren_panic("list_set on non-list"); return nil }
	        var kind = ptr_get(iadd(node, 16))
	        if kind == list_int_kind() {
	            is_list_int = 1
	        } else if kind != 2 {
	            oren_panic("list_set on non-list"); return nil
	        }
	        if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("list_set on non-list") }
	        count = ptr_get(iadd(list, 0))
        } else {
            count = ptr_get(iadd(list, 0))
        }
        if is_list_int != 0 { _list_int_check_value(value) }
	    if idx < 0 { oren_panic("Index out of bounds (negative)") }
	    var want = iadd(idx, 1)
	    var cap = ptr_get(iadd(list, 8))
	    var buf = ptr_get(iadd(list, 16))

    if want > cap {
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        if new_cap < want { new_cap = want }
        var alloc_site = _alloc_site_list_buf()
        if is_list_int != 0 { alloc_site = _alloc_site_list_int_buf() }
        var new_buf = _list_alloc_buf(list, new_cap * 8, alloc_site, 212)

        var i = 0
        while i < count {
            ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
            i = iadd(i, 1)
        }
        if is_list_int != 0 {
            // Initialize new slots to 0 for list<int>.
            while i < want {
                ptr_set(iadd(new_buf, i * 8), 0)
                i = iadd(i, 1)
            }
        } else {
            // Initialize new slots to nil.
            while i < want {
                ptr_set(iadd(new_buf, i * 8), nil)
                i = iadd(i, 1)
            }
        }

        buf = new_buf
        cap = new_cap
        ptr_set(iadd(list, 8), cap)
        ptr_set(iadd(list, 16), buf)
    } else {
        if buf == 0 {
            // cap may be 0 for an empty list, but then want>cap and we would have allocated above.
            // If we reach here, treat it as a runtime invariant violation.
            oren_panic("list buffer is nil")
            return nil
        }
        // Grow count in-place; ensure newly exposed slots are nil.
        var j = count
        while j < want {
            ptr_set(iadd(buf, j * 8), nil)
            j = iadd(j, 1)
        }
    }

    ptr_set(iadd(buf, idx * 8), value)
    if want > count { ptr_set(iadd(list, 0), want) }
    _list_corrupt_check(list, 4) // list_set
    return value
}
