fn _list_assume_list_enabled() {
    if g_list_assume_list != -1 { return g_list_assume_list == 1 }
    var v = native_envp_get_value_ptr("OREN_LIST_ASSUME_LIST")
    if v != 0 && ptr_get_byte(v) != 0 && ptr_get_byte(v) != 48 {
        g_list_assume_list = 1
    } else {
        g_list_assume_list = 0
    }
    return g_list_assume_list == 1
}

fn _list_find_node(list) {
    var node = oren_find_node(list)
    if node != 0 { return node }
    return native_arena_find_node_nolock(list)
}

fn _list_trace_enabled() {
    if g_trace_list_header == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_list_header == 0 {
        if cur_envp == g_trace_list_header_envp &&
           cur_argv == g_trace_list_header_argv &&
           cur_argc == g_trace_list_header_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_LIST_HEADER")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_list_header == -1 || g_trace_list_header == 0 {
            g_trace_list_header = 0
            g_trace_list_header_envp = cur_envp
            g_trace_list_header_argv = cur_argv
            g_trace_list_header_argc = cur_argc
        }
        return false
    }
    g_trace_list_header = 1
    var v_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_HEADER_CAP")
    if v_cap != 0 && ptr_get_byte(v_cap) != 0 {
        var cap = oren_int_from_string(v_cap)
        if cap > 0 { g_trace_list_header_cap = cap }
    }
    if g_trace_list_header_cap <= 0 { g_trace_list_header_cap = 1024 }
    return true
}

fn _list_hdr_ring_enabled() {
    if g_trace_list_hdr_ring == 1 { return true }
    var cur_envp = global_get_envp()
    var cur_argv = global_get_argv()
    var cur_argc = global_get_argc()
    if g_trace_list_hdr_ring == 0 {
        if cur_envp == g_trace_list_hdr_ring_envp &&
           cur_argv == g_trace_list_hdr_ring_argv &&
           cur_argc == g_trace_list_hdr_ring_argc {
            return false
        }
    }
    var v = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_RING")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        var v_gc = native_envp_get_value_ptr("OREN_TRACE_GC_FREE_LIST_HDR_RING")
        var v_gc_all = native_envp_get_value_ptr("OREN_TRACE_GC_FREE_LIST_HDR_RING_ALL")
        if (v_gc == 0 || ptr_get_byte(v_gc) == 0 || ptr_get_byte(v_gc) == 48) &&
           (v_gc_all == 0 || ptr_get_byte(v_gc_all) == 0 || ptr_get_byte(v_gc_all) == 48) {
            if g_trace_list_hdr_ring == -1 || g_trace_list_hdr_ring == 0 {
                g_trace_list_hdr_ring = 0
                g_trace_list_hdr_ring_envp = cur_envp
                g_trace_list_hdr_ring_argv = cur_argv
                g_trace_list_hdr_ring_argc = cur_argc
            }
            return false
        }
    }
    g_trace_list_hdr_ring = 1
    var v_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_RING_CAP")
    if v_cap != 0 && ptr_get_byte(v_cap) != 0 {
        var cap = oren_int_from_string(v_cap)
        if cap > 0 { g_trace_list_hdr_ring_cap = cap }
    }
    if g_trace_list_hdr_ring_cap <= 0 { g_trace_list_hdr_ring_cap = 4096 }
    var bytes = g_trace_list_hdr_ring_cap * 56
    var buf = native_malloc_raw_or_mmap(bytes)
    if buf == 0 { g_trace_list_hdr_ring = 0; return false }
    var i = 0
    while i < g_trace_list_hdr_ring_cap {
        var off = i * 56
        ptr_set(iadd(buf, off), 0)
        ptr_set(iadd(buf, off + 8), 0)
        ptr_set(iadd(buf, off + 16), 0)
        ptr_set(iadd(buf, off + 24), 0)
        ptr_set(iadd(buf, off + 32), 0)
        ptr_set(iadd(buf, off + 40), 0)
        ptr_set(iadd(buf, off + 48), 0)
        i = i + 1
    }
    g_trace_list_hdr_ring_ptr = buf
    g_trace_list_hdr_ring_head = 0
    var v_dup = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_RING_DUP")
    if v_dup != 0 && ptr_get_byte(v_dup) != 0 && ptr_get_byte(v_dup) != 48 {
        g_trace_list_hdr_ring_dup = 1
    }
    var v_dup_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_RING_DUP_CAP")
    if v_dup_cap != 0 && ptr_get_byte(v_dup_cap) != 0 {
        var cap = oren_int_from_string(v_dup_cap)
        if cap > 0 { g_trace_list_hdr_ring_dup_cap = cap }
    }
    if g_trace_list_hdr_ring_dup != 0 && g_trace_list_hdr_ring_dup_cap <= 0 {
        g_trace_list_hdr_ring_dup_cap = 64
    }
    if g_trace_list_hdr_ring_dup != 0 {
        var v_dup_seen_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_RING_DUP_SEEN_CAP")
        if v_dup_seen_cap != 0 && ptr_get_byte(v_dup_seen_cap) != 0 {
            var cap = oren_int_from_string(v_dup_seen_cap)
            if cap > 0 { g_trace_list_hdr_ring_dup_seen_cap = cap }
        }
        if g_trace_list_hdr_ring_dup_seen_cap <= 0 {
            g_trace_list_hdr_ring_dup_seen_cap = g_trace_list_hdr_ring_dup_cap
        }
        if g_trace_list_hdr_ring_dup_seen_cap <= 0 {
            g_trace_list_hdr_ring_dup_seen_cap = 64
        }
        if g_trace_list_hdr_ring_dup_seen_ptr == 0 {
            var bytes = g_trace_list_hdr_ring_dup_seen_cap * 8
            var dup_buf = native_malloc_raw_or_mmap(bytes)
            if dup_buf != 0 {
                var k = 0
                while k < g_trace_list_hdr_ring_dup_seen_cap {
                    ptr_set(iadd(dup_buf, k * 8), 0)
                    k = k + 1
                }
                g_trace_list_hdr_ring_dup_seen_ptr = dup_buf
                g_trace_list_hdr_ring_dup_seen_head = 0
            }
        }
    }
    return true
}

