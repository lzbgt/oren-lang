    g_trace_list_reserve_copy_bytes_list_int = 0
    g_trace_list_reserve_alloc_bytes_list = 0
    g_trace_list_reserve_alloc_bytes_list_int = 0
    g_trace_list_reserve_calls_list = 0
    g_trace_list_reserve_calls_list_int = 0
