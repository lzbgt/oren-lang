// --- Lists ---
// Layout: [count][capacity][buffer_ptr][magic]
	@oren.keep
	fn oren_new_list(cap) {
	    if cap < 0 { cap = 0 }
	    // Performance (native tooling / stage2-native compiler):
	    // Allocate header + initial buffer in a single tracked block to cut allocation+tracking
	    // overhead in half for the common "many small lists" workload (AST/IR graphs).
	    //
	    // Layout remains stable:
	    //   [count][capacity][buffer_ptr][magic]
	    // When cap>0, buffer_ptr points to inline storage at header+32.
	    var total = 32
	    if cap > 0 { total = total + cap * 8 }
	    var header = malloc_k(total, 2)
	    if header == 0 { exit(200) }
	    if header == -1 { exit(200) }
	    var buf = 0
	    if cap > 0 {
	        buf = iadd(header, 32)
	    }
	    ptr_set(iadd(header, 0), 0)       // count
	    ptr_set(iadd(header, 8), cap)     // capacity
	    ptr_set(iadd(header, 16), buf)    // data buffer
	    ptr_set(iadd(header, 24), list_magic())
		    return header
			}

// Cross-backend helper: allocate an empty list with reserved capacity.
// In native runtime, `oren_new_list(cap)` already has "capacity constructor" semantics.
@oren.keep
fn oren_list_new_cap(cap) {
    return oren_new_list(cap)
}

@oren.keep
fn oren_list_len(list) {
    if list == nil { return 0 }
    // Safety: do not dereference arbitrary large integers as pointers.
    // Rely on the tracked-alloc metadata (native) / runtime tracking (C) to discriminate.
    var node = oren_find_node(list)
    if node == 0 {
        if oren_getenv("OREN_TRACE_LIST_CHECK") != 0 {
            print("trace: list_len node=0 list=" + oren_int_to_string(list))
        }
        oren_panic("list_len on non-list")
        return 0
    }
    if ptr_get(iadd(node, 16)) != 2 {
        if oren_getenv("OREN_TRACE_LIST_CHECK") != 0 {
            print("trace: list_len kind=" + oren_int_to_string(ptr_get(iadd(node, 16))) +
                  " list=" + oren_int_to_string(list) +
                  " node=" + oren_int_to_string(node))
        }
        oren_panic("list_len on non-list")
        return 0
    }
    if ptr_get(iadd(list, 24)) != list_magic() {
        if oren_getenv("OREN_TRACE_LIST_CHECK") != 0 {
            print("trace: list_len magic=" + oren_int_to_string(ptr_get(iadd(list, 24))) +
                  " want=" + oren_int_to_string(list_magic()) +
                  " list=" + oren_int_to_string(list))
        }
        oren_panic("list_len on non-list")
        return 0
    }
    return ptr_get(iadd(list, 0))
}

// Safe type predicate: must not panic.
@oren.keep
fn oren_is_list(v) {
    if v == nil { return false }
	    var node = oren_find_node(v)
	    if node == 0 { return false }
	    if ptr_get(iadd(node, 16)) != 2 { return false }
	    if ptr_get(iadd(v, 24)) != list_magic() { return false }
	    return true
}

	@oren.keep
	fn oren_list_push(list, value) {
	    if list == nil {
	        oren_panic("list_push on nil")
	        return nil
	    }
	    // Safety: do not dereference arbitrary large integers as pointers.
		    var node = oren_find_node(list)
		    if node == 0 { oren_panic("list_push: untracked ptr"); return 0 }
		    if ptr_get(iadd(node, 16)) != 2 { oren_panic("list_push: wrong kind"); return 0 }
		    if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("list_push: bad magic"); return 0 }
		    var count = ptr_get(iadd(list, 0))
		    var cap = ptr_get(iadd(list, 8))
			    var buf = ptr_get(iadd(list, 16))
			    if count >= cap {
		        var new_cap = cap * 2
		        if new_cap < 4 { new_cap = 4 }
		        var new_buf = malloc_k(new_cap * 8, 0)
	        if new_buf == 0 { exit(211) }
	        if new_buf == -1 { exit(211) }
		        var i = 0
		        while i < count {
		            ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
		            i = iadd(i, 1)
	        }
	        buf = new_buf
	        cap = new_cap
	        ptr_set(iadd(list, 8), cap)
	        ptr_set(iadd(list, 16), buf)
	    }
    ptr_set(iadd(buf, count * 8), value)
    ptr_set(iadd(list, 0), iadd(count, 1))
    // Language-level semantics: `oren_list_push` is statement-like and returns `nil`.
    // (The list header pointer is stable and does not need to be returned.)
    return nil
}

// Unsafe/fast-path (tooling/internal): push without `oren_find_node` / kind/magic validation.
// Used by compiler hot paths (astbin decode) where the container provenance is trusted.
@oren.keep
fn oren_list_push_unchecked(list, value) {
    if list == nil { oren_panic("list_push_unchecked on nil"); return nil }
    var count = ptr_get(iadd(list, 0))
    var cap = ptr_get(iadd(list, 8))
	    var buf = ptr_get(iadd(list, 16))
	    if count >= cap {
	        var new_cap = cap * 2
	        if new_cap < 4 { new_cap = 4 }
	        var new_buf = malloc_k(new_cap * 8, 0)
	        if new_buf == 0 { exit(211) }
	        if new_buf == -1 { exit(211) }
	        var i = 0
	        while i < count {
	            ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
	            i = iadd(i, 1)
        }
        buf = new_buf
        cap = new_cap
        ptr_set(iadd(list, 8), cap)
        ptr_set(iadd(list, 16), buf)
    }
    ptr_set(iadd(buf, count * 8), value)
    ptr_set(iadd(list, 0), iadd(count, 1))
    return nil
}

@oren.keep
fn oren_list_get(list, idx) {
    if list == nil {
        oren_panic("Indexing on nil")
        return nil
    }
    // Safety: do not dereference arbitrary large integers as pointers.
    // `x[i]` is defined for lists and maps; reject other values deterministically.
    var node = oren_find_node(list)
    if node == 0 { oren_panic("Indexing on non-container"); return nil }
	    var kind = ptr_get(iadd(node, 16))
	    if kind != 2 {
	        if kind == 3 {
            // Not a list: treat as map indexing.
            // Key kind is selected by `oren_map_get` using tracking metadata.
            return oren_map_get(list, idx)
        }
        oren_panic("Indexing on non-container")
	        return nil
	    }
	    if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("Indexing on non-list"); return nil }
	    var count = ptr_get(iadd(list, 0))
    if idx < 0 { 
        oren_panic("Index out of bounds (negative)")
        return nil
    }
    if idx >= count { 
        oren_panic("Index out of bounds")
        return nil
    }
	    var buf = ptr_get(iadd(list, 16))
	    return ptr_get(iadd(buf, idx * 8))
}

// Set list element, growing the list as needed. Returns the written value.
//
// Language-level semantics (rolling, matches C backend + tests):
// - `xs[i] = v` on a list grows `xs` to length `i+1` if needed.
// - New slots are initialized to `nil`.
@oren.keep
fn oren_list_set(list, idx, value) {
    if list == nil { oren_panic("list_set on nil"); return nil }
    // Safety: do not dereference arbitrary large integers as pointers.
	    var node = oren_find_node(list)
	    if node == 0 { oren_panic("list_set on non-list"); return nil }
	    if ptr_get(iadd(node, 16)) != 2 { oren_panic("list_set on non-list"); return nil }
	    if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("list_set on non-list") }
	    var count = ptr_get(iadd(list, 0))
	    if idx < 0 { oren_panic("Index out of bounds (negative)") }
	    var want = iadd(idx, 1)
	    var cap = ptr_get(iadd(list, 8))
	    var buf = ptr_get(iadd(list, 16))

    if want > cap {
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        if new_cap < want { new_cap = want }
        var new_buf = malloc_k(new_cap * 8, 0)
        if new_buf == 0 { exit(212) }
        if new_buf == -1 { exit(212) }

        var i = 0
        while i < count {
            ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
            i = iadd(i, 1)
        }
        // Initialize new slots to nil.
        while i < want {
            ptr_set(iadd(new_buf, i * 8), nil)
            i = iadd(i, 1)
        }

        buf = new_buf
        cap = new_cap
        ptr_set(iadd(list, 8), cap)
        ptr_set(iadd(list, 16), buf)
    } else {
        if buf == 0 {
            // cap may be 0 for an empty list, but then want>cap and we would have allocated above.
            // If we reach here, treat it as a runtime invariant violation.
            oren_panic("list buffer is nil")
            return nil
        }
        // Grow count in-place; ensure newly exposed slots are nil.
        var j = count
        while j < want {
            ptr_set(iadd(buf, j * 8), nil)
            j = iadd(j, 1)
        }
    }

    ptr_set(iadd(buf, idx * 8), value)
    if want > count { ptr_set(iadd(list, 0), want) }
    return value
}
