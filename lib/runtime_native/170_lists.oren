fn _list_reserve_bytes_bump(kind, count, new_cap) {
    if _list_reserve_bytes_enabled() != true { return 0 }
    if new_cap <= 0 { return 0 }
    var alloc_bytes = new_cap * 8
    var copy_bytes = 0
    if count > 0 { copy_bytes = count * 8 }
    if kind == list_int_kind() {
        g_trace_list_reserve_copy_bytes_list_int = g_trace_list_reserve_copy_bytes_list_int + copy_bytes
        g_trace_list_reserve_alloc_bytes_list_int = g_trace_list_reserve_alloc_bytes_list_int + alloc_bytes
        g_trace_list_reserve_calls_list_int = g_trace_list_reserve_calls_list_int + 1
    } else {
        g_trace_list_reserve_copy_bytes_list = g_trace_list_reserve_copy_bytes_list + copy_bytes
        g_trace_list_reserve_alloc_bytes_list = g_trace_list_reserve_alloc_bytes_list + alloc_bytes
        g_trace_list_reserve_calls_list = g_trace_list_reserve_calls_list + 1
    }
    return 0
}

fn native_list_reserve_bytes_dump_and_reset() {
    if _list_reserve_bytes_enabled() != true { return 0 }
    var total_alloc = g_trace_list_reserve_alloc_bytes_list + g_trace_list_reserve_alloc_bytes_list_int
    var total_copy = g_trace_list_reserve_copy_bytes_list + g_trace_list_reserve_copy_bytes_list_int
    if total_alloc == 0 &&
       total_copy == 0 &&
       g_trace_list_reserve_calls_list == 0 &&
       g_trace_list_reserve_calls_list_int == 0 {
        return 0
    }
    print("[list_reserve_bytes] alloc_total=" + oren_int_to_string(total_alloc) +
          " copy_total=" + oren_int_to_string(total_copy) +
          " list_alloc_bytes=" + oren_int_to_string(g_trace_list_reserve_alloc_bytes_list) +
          " list_copy_bytes=" + oren_int_to_string(g_trace_list_reserve_copy_bytes_list) +
