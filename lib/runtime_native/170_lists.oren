// Force-enable the list header ring for guardrail traces (e.g., reuse bad-list dumps),
// even if the usual env gates were not set.
@oren.keep
fn native_list_header_ring_force_enable() {
    if g_trace_list_hdr_ring_ptr != 0 { return 0 }
    if g_trace_list_hdr_ring_cap <= 0 { g_trace_list_hdr_ring_cap = 4096 }
    var bytes = g_trace_list_hdr_ring_cap * 56
    var buf = native_malloc_raw_or_mmap(bytes)
    if buf == 0 { return 0 }
    var i = 0
    while i < g_trace_list_hdr_ring_cap {
        var off = i * 56
        ptr_set(iadd(buf, off), 0)
        ptr_set(iadd(buf, off + 8), 0)
        ptr_set(iadd(buf, off + 16), 0)
        ptr_set(iadd(buf, off + 24), 0)
        ptr_set(iadd(buf, off + 32), 0)
        ptr_set(iadd(buf, off + 40), 0)
        ptr_set(iadd(buf, off + 48), 0)
        i = i + 1
    }
    g_trace_list_hdr_ring = 1
    g_trace_list_hdr_ring_ptr = buf
    g_trace_list_hdr_ring_head = 0
    return 0
}
fn _list_corrupt_enabled() {
    if g_trace_list_corrupt == 1 { return true }
    if g_trace_list_corrupt == 0 { return false }
    var v = native_envp_get_value_ptr("OREN_TRACE_LIST_CORRUPT")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_list_corrupt == -1 { g_trace_list_corrupt = 0 }
        return false
    }
    g_trace_list_corrupt = 1
    var v_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_CORRUPT_CAP")
    if v_cap != 0 && ptr_get_byte(v_cap) != 0 {
        var cap = oren_int_from_string(v_cap)
        if cap > 0 { g_trace_list_corrupt_cap = cap }
    }
    if g_trace_list_corrupt_cap <= 0 { g_trace_list_corrupt_cap = 128 }
    return true
}

fn _list_corrupt_check(list, stage) {
    if _list_corrupt_enabled() != true { return 0 }
    if g_trace_list_corrupt_cap <= 0 { return 0 }
    if list == 0 || list < 4096 { return 0 }
    var len = ptr_get(iadd(list, 0))
    var cap = ptr_get(iadd(list, 8))
    var buf = ptr_get(iadd(list, 16))
    var magic = ptr_get(iadd(list, 24))
    var bad = 0
    if magic != list_magic() {
        bad = 1
    } else if cap < 0 || len < 0 {
        bad = 1
    } else if cap == 0 {
        if len != 0 { bad = 1 }
        if buf != 0 { bad = 1 }
    } else {
        if buf == 0 || buf < 4096 { bad = 1 }
        if len > cap { bad = 1 }
    }
    if bad == 0 { return 0 }
    g_trace_list_corrupt_cap = g_trace_list_corrupt_cap - 1
    print("trace: list_corrupt stage=" + oren_int_to_string(stage) +
        " list=" + oren_int_to_string(list) +
        " len=" + oren_int_to_string(len) +
        " cap=" + oren_int_to_string(cap) +
        " buf=" + oren_int_to_string(buf) +
        " magic=" + oren_int_to_string(magic))
    native_list_debug_node(list)
    _list_trace_dump(list)
    return 0
}

fn _list_trace_dump(list) {
    if list == 0 || list < 4096 { return 0 }
    print("trace: list_trace_dump list=" + oren_int_to_string(list))
    native_list_debug_node(list)
    trace_list_alloc_ring_dump(list)
    native_list_header_ring_dump(list)
    return 0
}

fn _list_alloc_buf(list, bytes, new_cap, kind, alloc_site, err_code) {
    var use_arena = false
    if native_arena_find_node_nolock(list) != 0 { use_arena = true }
    _list_buf_req_trace_emit(list, kind, new_cap, bytes, use_arena)
    var new_buf = 0
    if use_arena == true {
        new_buf = native_arena_alloc_raw(bytes)
        if new_buf != 0 && new_buf != -1 { native_alloc_site_bump(alloc_site) }
        if new_buf == 0 {
            new_buf = malloc_k(bytes, 0)
            if new_buf != 0 && new_buf != -1 { native_alloc_site_bump(alloc_site) }
        }
    } else {
        new_buf = malloc_k(bytes, 0)
        if new_buf != 0 && new_buf != -1 { native_alloc_site_bump(alloc_site) }
    }
    if new_buf == 0 { exit(err_code) }
    if new_buf == -1 { exit(err_code) }
    if _list_buf_trace_enabled() == true {
        if g_trace_list_buf_cap > 0 {
            g_trace_list_buf_cap = g_trace_list_buf_cap - 1
            var kind = 0
            if list != 0 && list >= 4096 {
                var node = _list_find_node(list)
                if node != 0 { kind = ptr_get(iadd(node, 16)) }
            }
            print("[list_buf] list=" + oren_int_to_string(list) +
                  " kind=" + oren_int_to_string(kind) +
                  " bytes=" + oren_int_to_string(bytes) +
                  " site=" + oren_int_to_string(alloc_site) +
                  " arena=" + oren_int_to_string(use_arena) +
                  " buf=" + oren_int_to_string(new_buf))
        }
    }
    return new_buf
}

fn _list_trace_emit(op, list, kind) {
    if list == 0 || list < 4096 { return 0 }
    _list_hdr_ring_put(op, list, kind)
    if _list_trace_enabled() != true { return 0 }
    if g_trace_list_header_cap <= 0 { return 0 }
    g_trace_list_header_cap = g_trace_list_header_cap - 1
    var len = ptr_get(iadd(list, 0))
    var cap = ptr_get(iadd(list, 8))
    var buf = ptr_get(iadd(list, 16))
    var magic = ptr_get(iadd(list, 24))
    print("[list_hdr] op=" + oren_int_to_string(op) +
        " list=" + oren_int_to_string(list) +
        " kind=" + oren_int_to_string(kind) +
        " len=" + oren_int_to_string(len) +
        " cap=" + oren_int_to_string(cap) +
        " buf=" + oren_int_to_string(buf) +
        " magic=" + oren_int_to_string(magic))
    return 0
}

@oren.keep
fn oren_trace_list_header(list, op, kind) {
    return _list_trace_emit(op, list, kind)
}

@oren.keep
fn oren_list_len(list) {
    if list == nil { return 0 }
    if _list_assume_list_enabled() != true {
        // Safety: do not dereference arbitrary large integers as pointers.
        // Rely on the tracked-alloc metadata (native) / runtime tracking (C) to discriminate.
        var node = _list_find_node(list)
        if node == 0 {
            native_alloc_index_rebuild_live()
            node = _list_find_node(list)
        }
        if node == 0 {
            node = native_alloc_index_recover_ptr(list)
        }
        if node == 0 {
            if list >= 4096 && ptr_get(iadd(list, 24)) == list_magic() {
                var cap = ptr_get(iadd(list, 8))
                if cap >= 0 && cap < 1048576 {
                    var total = 32
                    if cap > 0 { total = total + cap * 8 }
                    oren_track_alloc_new(list, total, 2)
                    node = _list_find_node(list)
                }
            }
        }
        if node == 0 {
            print("trace: list_len node=0 list=" + oren_int_to_string(list))
            oren_panic("list_len on non-list")
            return 0
        }
        var k = ptr_get(iadd(node, 16))
        if k != 2 && k != list_int_kind() {
            print("trace: list_len kind=" + oren_int_to_string(k) +
                  " list=" + oren_int_to_string(list) +
                  " node=" + oren_int_to_string(node))
            oren_panic("list_len on non-list")
            return 0
        }
        if ptr_get(iadd(list, 24)) != list_magic() {
            print("trace: list_len magic=" + oren_int_to_string(ptr_get(iadd(list, 24))) +
                  " want=" + oren_int_to_string(list_magic()) +
                  " list=" + oren_int_to_string(list))
            oren_panic("list_len on non-list")
            return 0
        }
    }
    return ptr_get(iadd(list, 0))
}

@oren.keep
fn oren_list_clear(list) {
    if list == nil { return nil }
    if _list_assume_list_enabled() != true {
        var node = _list_find_node(list)
        if node == 0 { oren_panic("list_clear on non-list"); return nil }
        var k = ptr_get(iadd(node, 16))
        if k != 2 { oren_panic("list_clear on non-list"); return nil }
        if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("list_clear on non-list"); return nil }
    }
    ptr_set(iadd(list, 0), 0)
    _list_trace_emit(10, list, 2) // list_clear
    return nil
}

// Unsafe/fast-path (tooling/internal): clear list without find_node/magic checks.
@oren.keep
fn oren_list_clear_unchecked(list) {
    if list == nil { return nil }
    ptr_set(iadd(list, 0), 0)
    return nil
}

@oren.keep
fn oren_list_reserve(list, new_cap) {
    if list == nil { return nil }
    if new_cap == nil { return nil }
    if native_value_is_true(new_cap) || native_value_is_false(new_cap) {
        oren_panic("list_reserve expects int (got bool)")
        return nil
    }
    if native_gc_find_node_nolock(new_cap) != 0 {
        oren_panic("list_reserve expects int (got pointer)")
        return nil
    }
    if new_cap < 0 { return nil }
    if _list_assume_list_enabled() != true {
        // Safety: do not dereference arbitrary large integers as pointers.
        var node = _list_find_node(list)
        if node == 0 {
            // Best-effort: rebuild alloc index in case it is stale/corrupted.
            native_alloc_index_rebuild_live()
            node = _list_find_node(list)
        }
        if node == 0 {
            node = native_alloc_index_recover_ptr(list)
        }
        if node == 0 {
            if list >= 4096 && ptr_get(iadd(list, 24)) == list_magic() {
                var cap2 = ptr_get(iadd(list, 8))
                if cap2 >= 0 && cap2 < 1048576 {
                    var total2 = 32
                    if cap2 > 0 { total2 = total2 + cap2 * 8 }
                    oren_track_alloc_new(list, total2, 2)
                    node = _list_find_node(list)
                }
            }
        }
        if node == 0 {
            native_list_reserve_panic(list, new_cap, 1)
            oren_panic("list_reserve on non-list")
            return nil
        }
        var k = ptr_get(iadd(node, 16))
        if k != 2 {
            native_alloc_index_rebuild_live()
            node = _list_find_node(list)
            k = 0
            if node != 0 { k = ptr_get(iadd(node, 16)) }
            if k != 2 {
                if list >= 4096 && ptr_get(iadd(list, 24)) == list_magic() {
                    var cap3 = ptr_get(iadd(list, 8))
                    if cap3 >= 0 && cap3 < 1048576 {
                        var total3 = 32
                        if cap3 > 0 { total3 = total3 + cap3 * 8 }
                        oren_track_alloc_new(list, total3, 2)
                        node = _list_find_node(list)
                        k = 0
                        if node != 0 { k = ptr_get(iadd(node, 16)) }
                    }
                }
            }
            if k != 2 {
                native_list_reserve_panic(list, new_cap, 2)
                oren_panic("list_reserve on non-list")
                return nil
            }
        }
        if ptr_get(iadd(list, 24)) != list_magic() {
            native_list_reserve_panic(list, new_cap, 3)
            oren_panic("list_reserve on non-list")
            return nil
        }
    }
    var cap = ptr_get(iadd(list, 8))
    if cap < 0 {
        native_list_reserve_panic(list, new_cap, 4)
        oren_panic("list_reserve on corrupt list")
        return nil
    }
    if cap > list_max_cap() {
        native_list_reserve_panic(list, new_cap, 5)
        oren_panic("list_reserve on corrupt list")
        return nil
    }
    var count = ptr_get(iadd(list, 0))
    var buf = ptr_get(iadd(list, 16))
    _list_reserve_trace_emit(2, list, cap, new_cap, buf, 1)
    if new_cap <= cap { return nil }
    var bytes = _list_bytes_for_cap(new_cap)
    var new_buf = _list_alloc_buf(list, bytes, new_cap, 2, _alloc_site_list_buf(), 211)
    var i = 0
    while i < count {
        ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
        i = i + 1
    }
    _list_reserve_bytes_bump(2, count, new_cap)
    ptr_set(iadd(list, 8), new_cap)
    ptr_set(iadd(list, 16), new_buf)
    _list_reserve_trace_emit(2, list, new_cap, new_cap, new_buf, 2)
    _list_corrupt_check(list, 1) // list_reserve
