// --- Lists ---
// Layout: [count][capacity][buffer_ptr][magic]
fn list_int_kind() { return 8 } // LIST_INT (unboxed int list)
	@oren.keep
fn oren_new_list(cap) {
    if cap < 0 { cap = 0 }
	    // Performance (native tooling / stage2-native compiler):
	    // Allocate header + initial buffer in a single tracked block to cut allocation+tracking
	    // overhead in half for the common "many small lists" workload (AST/IR graphs).
	    //
	    // Layout remains stable:
	    //   [count][capacity][buffer_ptr][magic]
	    // When cap>0, buffer_ptr points to inline storage at header+32.
	    var total = 32
	    if cap > 0 { total = total + cap * 8 }
    var header = malloc_k(total, 2)
    if header == 0 { exit(200) }
    if header == -1 { exit(200) }
    var site = _alloc_site_list_header()
    native_alloc_site_bump(site)
    var buf = 0
	    if cap > 0 {
	        buf = iadd(header, 32)
	    }
	    ptr_set(iadd(header, 0), 0)       // count
	    ptr_set(iadd(header, 8), cap)     // capacity
	    ptr_set(iadd(header, 16), buf)    // data buffer
    ptr_set(iadd(header, 24), list_magic())
    trace_list_alloc_emit(header, 2, total, site, 1)
    _list_trace_emit(1, header, 2) // new_list
    return header
			}

// --- List<int> (unboxed) ---
@oren.keep
fn oren_new_list_int(cap) {
    if cap < 0 { cap = 0 }
    var total = 32
    if cap > 0 { total = total + cap * 8 }
    var header = malloc_k(total, list_int_kind())
    if header == 0 { exit(200) }
    if header == -1 { exit(200) }
    var site = _alloc_site_list_int_header()
    native_alloc_site_bump(site)
    var buf = 0
    if cap > 0 {
        buf = iadd(header, 32)
    }
    ptr_set(iadd(header, 0), 0)       // count
    ptr_set(iadd(header, 8), cap)     // capacity
    ptr_set(iadd(header, 16), buf)    // data buffer
    ptr_set(iadd(header, 24), list_magic())
    trace_list_alloc_emit(header, list_int_kind(), total, site, 1)
    _list_trace_emit(2, header, list_int_kind()) // new_list_int
    return header
}

@oren.keep
fn _list_int_check_value(v) {
    if native_value_is_nil(v) { oren_panic("list_int expects int (got nil)"); return 0 }
    if native_value_is_true(v) || native_value_is_false(v) {
        oren_panic("list_int expects int (got bool)"); return 0
    }
    // If v is tracked, it's not an int (ints are untracked immediates).
    if native_gc_find_node_nolock(v) != 0 {
        oren_panic("list_int expects int (got pointer)")
    }
    return 0
}

// Cross-backend helper: allocate an empty list with reserved capacity.
// In native runtime, `oren_new_list(cap)` already has "capacity constructor" semantics.
@oren.keep
fn oren_list_new_cap(cap) {
    return oren_new_list(cap)
}

// Performance bench / opt-in unsafe mode:
// When set, skip `oren_find_node`/magic checks in list ops.
// Enable with OREN_LIST_ASSUME_LIST=1.
var g_list_assume_list = -1
var g_trace_list_header = -1
var g_trace_list_header_cap = 0
var g_trace_list_corrupt = -1
var g_trace_list_corrupt_cap = 0
var g_trace_list_hdr_ring = -1
var g_trace_list_hdr_ring_cap = 0
var g_trace_list_hdr_ring_ptr = 0
var g_trace_list_hdr_ring_head = 0

fn _list_assume_list_enabled() {
    if g_list_assume_list != -1 { return g_list_assume_list == 1 }
    var v = native_envp_get_value_ptr("OREN_LIST_ASSUME_LIST")
    if v != 0 && ptr_get_byte(v) != 0 && ptr_get_byte(v) != 48 {
        g_list_assume_list = 1
    } else {
        g_list_assume_list = 0
    }
    return g_list_assume_list == 1
}

fn _list_find_node(list) {
    var node = oren_find_node(list)
    if node != 0 { return node }
    return native_arena_find_node_nolock(list)
}

fn _list_trace_enabled() {
    if g_trace_list_header == 1 { return true }
    var v = native_envp_get_value_ptr("OREN_TRACE_LIST_HEADER")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_list_header == -1 { g_trace_list_header = 0 }
        return false
    }
    g_trace_list_header = 1
    var v_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_HEADER_CAP")
    if v_cap != 0 && ptr_get_byte(v_cap) != 0 {
        var cap = oren_int_from_string(v_cap)
        if cap > 0 { g_trace_list_header_cap = cap }
    }
    if g_trace_list_header_cap <= 0 { g_trace_list_header_cap = 1024 }
    return true
}

fn _list_hdr_ring_enabled() {
    if g_trace_list_hdr_ring == 1 { return true }
    var v = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_RING")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_list_hdr_ring == -1 { g_trace_list_hdr_ring = 0 }
        return false
    }
    g_trace_list_hdr_ring = 1
    var v_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_HDR_RING_CAP")
    if v_cap != 0 && ptr_get_byte(v_cap) != 0 {
        var cap = oren_int_from_string(v_cap)
        if cap > 0 { g_trace_list_hdr_ring_cap = cap }
    }
    if g_trace_list_hdr_ring_cap <= 0 { g_trace_list_hdr_ring_cap = 4096 }
    var bytes = g_trace_list_hdr_ring_cap * 56
    var buf = native_malloc_raw_or_mmap(bytes)
    if buf == 0 { g_trace_list_hdr_ring = 0; return false }
    var i = 0
    while i < g_trace_list_hdr_ring_cap {
        var off = i * 56
        ptr_set(iadd(buf, off), 0)
        ptr_set(iadd(buf, off + 8), 0)
        ptr_set(iadd(buf, off + 16), 0)
        ptr_set(iadd(buf, off + 24), 0)
        ptr_set(iadd(buf, off + 32), 0)
        ptr_set(iadd(buf, off + 40), 0)
        ptr_set(iadd(buf, off + 48), 0)
        i = i + 1
    }
    g_trace_list_hdr_ring_ptr = buf
    g_trace_list_hdr_ring_head = 0
    return true
}

fn _list_hdr_ring_put(op, list, kind) {
    if _list_hdr_ring_enabled() != true { return 0 }
    if g_trace_list_hdr_ring_ptr == 0 { return 0 }
    if g_trace_list_hdr_ring_cap <= 0 { return 0 }
    if list == 0 || list < 4096 { return 0 }
    if op != 1 && op != 2 && op != 3 && op != 6 { return 0 }
    var idx = g_trace_list_hdr_ring_head % g_trace_list_hdr_ring_cap
    var off = idx * 56
    var base = g_trace_list_hdr_ring_ptr
    ptr_set(iadd(base, off), list)
    ptr_set(iadd(base, off + 8), op)
    ptr_set(iadd(base, off + 16), ptr_get(iadd(list, 0)))
    ptr_set(iadd(base, off + 24), ptr_get(iadd(list, 8)))
    ptr_set(iadd(base, off + 32), ptr_get(iadd(list, 16)))
    ptr_set(iadd(base, off + 40), ptr_get(iadd(list, 24)))
    ptr_set(iadd(base, off + 48), kind)
    g_trace_list_hdr_ring_head = g_trace_list_hdr_ring_head + 1
    return 0
}

@oren.keep
fn native_list_header_ring_dump(list) {
    if g_trace_list_hdr_ring_ptr == 0 { return 0 }
    if g_trace_list_hdr_ring_cap <= 0 { return 0 }
    if list == 0 || list < 4096 { return 0 }
    var base = g_trace_list_hdr_ring_ptr
    var i = 0
    while i < g_trace_list_hdr_ring_cap {
        var off = i * 56
        var p = ptr_get(iadd(base, off))
        if p == list {
            var op = ptr_get(iadd(base, off + 8))
            var len = ptr_get(iadd(base, off + 16))
            var cap = ptr_get(iadd(base, off + 24))
            var buf = ptr_get(iadd(base, off + 32))
            var magic = ptr_get(iadd(base, off + 40))
            var kind = ptr_get(iadd(base, off + 48))
            print("[list_hdr_ring] list=" + oren_int_to_string(list) +
                  " op=" + oren_int_to_string(op) +
                  " kind=" + oren_int_to_string(kind) +
                  " len=" + oren_int_to_string(len) +
                  " cap=" + oren_int_to_string(cap) +
                  " buf=" + oren_int_to_string(buf) +
                  " magic=" + oren_int_to_string(magic))
        }
        i = i + 1
    }
    return 0
}
fn _list_corrupt_enabled() {
    if g_trace_list_corrupt == 1 { return true }
    var v = native_envp_get_value_ptr("OREN_TRACE_LIST_CORRUPT")
    if v == 0 || ptr_get_byte(v) == 0 || ptr_get_byte(v) == 48 {
        if g_trace_list_corrupt == -1 { g_trace_list_corrupt = 0 }
        return false
    }
    g_trace_list_corrupt = 1
    var v_cap = native_envp_get_value_ptr("OREN_TRACE_LIST_CORRUPT_CAP")
    if v_cap != 0 && ptr_get_byte(v_cap) != 0 {
        var cap = oren_int_from_string(v_cap)
        if cap > 0 { g_trace_list_corrupt_cap = cap }
    }
    if g_trace_list_corrupt_cap <= 0 { g_trace_list_corrupt_cap = 128 }
    return true
}

fn _list_corrupt_check(list, stage) {
    if _list_corrupt_enabled() != true { return 0 }
    if g_trace_list_corrupt_cap <= 0 { return 0 }
    if list == 0 || list < 4096 { return 0 }
    var len = ptr_get(iadd(list, 0))
    var cap = ptr_get(iadd(list, 8))
    var buf = ptr_get(iadd(list, 16))
    var magic = ptr_get(iadd(list, 24))
    var bad = 0
    if magic != list_magic() {
        bad = 1
    } else if cap == 0 {
        if buf != 0 { bad = 1 }
    } else {
        if buf == 0 || buf < 4096 { bad = 1 }
    }
    if bad == 0 { return 0 }
    g_trace_list_corrupt_cap = g_trace_list_corrupt_cap - 1
    print("trace: list_corrupt stage=" + oren_int_to_string(stage) +
        " list=" + oren_int_to_string(list) +
        " len=" + oren_int_to_string(len) +
        " cap=" + oren_int_to_string(cap) +
        " buf=" + oren_int_to_string(buf) +
        " magic=" + oren_int_to_string(magic))
    native_list_debug_node(list)
    return 0
}

fn _list_alloc_buf(list, bytes, alloc_site, err_code) {
    var use_arena = false
    if native_arena_find_node_nolock(list) != 0 { use_arena = true }
    var new_buf = 0
    if use_arena == true {
        new_buf = native_arena_alloc_raw(bytes)
        if new_buf == 0 {
            new_buf = malloc_k(bytes, 0)
            if new_buf != 0 && new_buf != -1 { native_alloc_site_bump(alloc_site) }
        }
    } else {
        new_buf = malloc_k(bytes, 0)
        if new_buf != 0 && new_buf != -1 { native_alloc_site_bump(alloc_site) }
    }
    if new_buf == 0 { exit(err_code) }
    if new_buf == -1 { exit(err_code) }
    return new_buf
}

fn _list_trace_emit(op, list, kind) {
    if list == 0 || list < 4096 { return 0 }
    _list_hdr_ring_put(op, list, kind)
    if _list_trace_enabled() != true { return 0 }
    if g_trace_list_header_cap <= 0 { return 0 }
    g_trace_list_header_cap = g_trace_list_header_cap - 1
    var len = ptr_get(iadd(list, 0))
    var cap = ptr_get(iadd(list, 8))
    var buf = ptr_get(iadd(list, 16))
    var magic = ptr_get(iadd(list, 24))
    print("[list_hdr] op=" + oren_int_to_string(op) +
        " list=" + oren_int_to_string(list) +
        " kind=" + oren_int_to_string(kind) +
        " len=" + oren_int_to_string(len) +
        " cap=" + oren_int_to_string(cap) +
        " buf=" + oren_int_to_string(buf) +
        " magic=" + oren_int_to_string(magic))
    return 0
}

@oren.keep
fn oren_trace_list_header(list, op, kind) {
    return _list_trace_emit(op, list, kind)
}

@oren.keep
fn oren_list_len(list) {
    if list == nil { return 0 }
    if _list_assume_list_enabled() != true {
        // Safety: do not dereference arbitrary large integers as pointers.
        // Rely on the tracked-alloc metadata (native) / runtime tracking (C) to discriminate.
        var node = _list_find_node(list)
        if node == 0 {
            print("trace: list_len node=0 list=" + oren_int_to_string(list))
            oren_panic("list_len on non-list")
            return 0
        }
        var k = ptr_get(iadd(node, 16))
        if k != 2 && k != list_int_kind() {
            print("trace: list_len kind=" + oren_int_to_string(k) +
                  " list=" + oren_int_to_string(list) +
                  " node=" + oren_int_to_string(node))
            oren_panic("list_len on non-list")
            return 0
        }
        if ptr_get(iadd(list, 24)) != list_magic() {
            print("trace: list_len magic=" + oren_int_to_string(ptr_get(iadd(list, 24))) +
                  " want=" + oren_int_to_string(list_magic()) +
                  " list=" + oren_int_to_string(list))
            oren_panic("list_len on non-list")
            return 0
        }
    }
    return ptr_get(iadd(list, 0))
}

@oren.keep
fn oren_list_reserve(list, new_cap) {
    if list == nil { return nil }
    if new_cap == nil { return nil }
    if native_value_is_true(new_cap) || native_value_is_false(new_cap) {
        oren_panic("list_reserve expects int (got bool)")
        return nil
    }
    if native_gc_find_node_nolock(new_cap) != 0 {
        oren_panic("list_reserve expects int (got pointer)")
        return nil
    }
    if new_cap < 0 { return nil }
    if _list_assume_list_enabled() != true {
        // Safety: do not dereference arbitrary large integers as pointers.
        var node = _list_find_node(list)
        if node == 0 {
            native_list_reserve_panic(list, new_cap, 1)
            oren_panic("list_reserve on non-list")
            return nil
        }
        if ptr_get(iadd(node, 16)) != 2 {
            native_list_reserve_panic(list, new_cap, 2)
            oren_panic("list_reserve on non-list")
            return nil
        }
        if ptr_get(iadd(list, 24)) != list_magic() {
            native_list_reserve_panic(list, new_cap, 3)
            oren_panic("list_reserve on non-list")
            return nil
        }
    }
    var cap = ptr_get(iadd(list, 8))
    if new_cap <= cap { return nil }
    var count = ptr_get(iadd(list, 0))
    var buf = ptr_get(iadd(list, 16))
    var new_buf = _list_alloc_buf(list, new_cap * 8, _alloc_site_list_buf(), 211)
    var i = 0
    while i < count {
        ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
        i = i + 1
    }
    ptr_set(iadd(list, 8), new_cap)
    ptr_set(iadd(list, 16), new_buf)
    _list_corrupt_check(list, 1) // list_reserve
    _list_trace_emit(3, list, 2) // list_reserve
    return nil
}

@oren.keep
fn native_list_len_panic(list, stage) {
    // stage: 1=node missing, 2=kind mismatch, 3=magic mismatch
    print("trace: list_len panic stage=" + oren_int_to_string(stage) +
          " list=" + oren_int_to_string(list))
    var node = _list_find_node(list)
    if node == 0 {
        print("trace: list_len node=0")
    } else {
        print("trace: list_len node=" + oren_int_to_string(node) +
              " kind=" + oren_int_to_string(ptr_get(iadd(node, 16))))
    }
    if list != 0 && list >= 4096 {
        print("trace: list_len magic=" + oren_int_to_string(ptr_get(iadd(list, 24))) +
              " want=" + oren_int_to_string(list_magic()))
        print("trace: list_len count=" + oren_int_to_string(ptr_get(iadd(list, 0))) +
              " cap=" + oren_int_to_string(ptr_get(iadd(list, 8))) +
              " buf=" + oren_int_to_string(ptr_get(iadd(list, 16))))
    }
    if stage == 3 {
        native_list_debug_node(list)
    }
    oren_panic("list_len on non-list")
    return 0
}

@oren.keep
fn native_list_reserve_panic(list, new_cap, stage) {
    // stage: 1=node missing, 2=kind mismatch, 3=magic mismatch
    print("trace: list_reserve panic stage=" + oren_int_to_string(stage) +
          " list=" + oren_int_to_string(list) +
          " new_cap=" + oren_int_to_string(new_cap))
    var node = _list_find_node(list)
    if node == 0 {
        print("trace: list_reserve node=0")
    } else {
        print("trace: list_reserve node=" + oren_int_to_string(node) +
              " kind=" + oren_int_to_string(ptr_get(iadd(node, 16))))
    }
    var arena_node = native_arena_find_node_nolock(list)
    var in_arena = 0
    if g_arena_base != 0 && list >= g_arena_base && list < g_arena_limit { in_arena = 1 }
    print("trace: list_reserve arena_depth=" + oren_int_to_string(g_arena_depth) +
          " arena_node=" + oren_int_to_string(arena_node) +
          " arena_base=" + oren_int_to_string(g_arena_base) +
          " arena_ptr=" + oren_int_to_string(g_arena_ptr) +
          " arena_limit=" + oren_int_to_string(g_arena_limit) +
          " arena_range=" + oren_int_to_string(in_arena))
    if list != 0 && list >= 4096 {
        print("trace: list_reserve magic=" + oren_int_to_string(ptr_get(iadd(list, 24))) +
              " want=" + oren_int_to_string(list_magic()))
        print("trace: list_reserve count=" + oren_int_to_string(ptr_get(iadd(list, 0))) +
              " cap=" + oren_int_to_string(ptr_get(iadd(list, 8))) +
              " buf=" + oren_int_to_string(ptr_get(iadd(list, 16))))
    }
    if stage == 1 {
        native_list_debug_node(list)
    }
}

fn native_list_debug_node(list) {
    if list == 0 || list < 4096 { return 0 }
    var node = _list_find_node(list)
    if node == 0 {
        print("trace: list_debug node=0 list=" + oren_int_to_string(list))
        return 0
    }
    var n_ptr = ptr_get(node)
    var n_size = ptr_get(iadd(node, 8))
    var n_kind = ptr_get(iadd(node, 16))
    var n_freed = ptr_get(iadd(node, 24))
    var n_next = ptr_get(iadd(node, 32))
    var n_magic = ptr_get(iadd(node, 40))
    print("trace: list_debug node_ptr=" + oren_int_to_string(n_ptr) +
          " size=" + oren_int_to_string(n_size) +
          " kind=" + oren_int_to_string(n_kind) +
          " freed=" + oren_int_to_string(n_freed) +
          " next=" + oren_int_to_string(n_next) +
          " magic=" + oren_int_to_string(n_magic))
    if n_ptr - list != 0 {
        print("trace: list_debug node_ptr_mismatch list=" + oren_int_to_string(list) +
              " node_ptr=" + oren_int_to_string(n_ptr))
    }

    // Check alloc-index entry (if present).
    var idx = native_alloc_index_get(list)
    if idx == 0 {
        print("trace: list_debug alloc_index miss list=" + oren_int_to_string(list))
    } else if idx - node != 0 {
        print("trace: list_debug alloc_index mismatch idx=" + oren_int_to_string(idx) +
              " node=" + oren_int_to_string(node))
    }

    // Scan allocs list for node membership (bounded).
    var seen_alloc = 0
    var cur = global_get_allocs()
    var limit = 200000
    while cur != 0 && limit > 0 {
        if cur - node == 0 { seen_alloc = 1; break }
        cur = ptr_get(iadd(cur, 32))
        limit = limit - 1
    }
    if seen_alloc == 1 {
        print("trace: list_debug node_in_allocs=1")
    } else {
        print("trace: list_debug node_in_allocs=0")
    }

    // Scan free blocks list for node membership (bounded).
    var seen_free = 0
    var cur_free = global_get_free_blocks()
    limit = 200000
    while cur_free != 0 && limit > 0 {
        if cur_free - node == 0 { seen_free = 1; break }
        cur_free = ptr_get(iadd(cur_free, 32))
        limit = limit - 1
    }
    if seen_free == 1 {
        print("trace: list_debug node_in_free_blocks=1")
    } else {
        print("trace: list_debug node_in_free_blocks=0")
    }
    return 0
}

// Safe type predicate: must not panic.
@oren.keep
fn oren_is_list(v) {
    if v == nil { return false }
	    var node = oren_find_node(v)
	    if node == 0 { return false }
	    if ptr_get(iadd(node, 16)) != 2 { return false }
	    if ptr_get(iadd(v, 24)) != list_magic() { return false }
	    return true
}

// Safe type predicate: list<int> (unboxed list).
@oren.keep
fn oren_is_list_int(v) {
    if v == nil { return false }
    var node = oren_find_node(v)
    if node == 0 { return false }
    if ptr_get(iadd(node, 16)) != list_int_kind() { return false }
    if ptr_get(iadd(v, 24)) != list_magic() { return false }
    return true
}

@oren.keep
fn oren_list_int_len(list) {
    if list == nil { return 0 }
    var node = _list_find_node(list)
    if node == 0 { oren_panic("list_int_len on non-list"); return 0 }
    if ptr_get(iadd(node, 16)) != list_int_kind() { oren_panic("list_int_len on non-list"); return 0 }
    if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("list_int_len on non-list"); return 0 }
    return ptr_get(iadd(list, 0))
}

// Unsafe/fast-path (tooling/internal): list<int> len without find_node/magic checks.
// Used by compiler hot paths where list provenance is already validated.
@oren.keep
fn oren_list_int_len_unchecked(list) {
    if list == nil { return 0 }
    return ptr_get(iadd(list, 0))
}

@oren.keep
fn oren_list_int_reserve(list, new_cap) {
    if list == nil { return nil }
    if new_cap == nil { return nil }
    if native_value_is_true(new_cap) || native_value_is_false(new_cap) {
        oren_panic("list_int_reserve expects int (got bool)")
        return nil
    }
    if native_gc_find_node_nolock(new_cap) != 0 {
        oren_panic("list_int_reserve expects int (got pointer)")
        return nil
    }
    if new_cap < 0 { return nil }
    var node = _list_find_node(list)
    if node == 0 { oren_panic("list_int_reserve on non-list"); return nil }
    if ptr_get(iadd(node, 16)) != list_int_kind() { oren_panic("list_int_reserve on non-list"); return nil }
    if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("list_int_reserve on non-list"); return nil }
    var cap = ptr_get(iadd(list, 8))
    if new_cap <= cap { return nil }
    var count = ptr_get(iadd(list, 0))
    var buf = ptr_get(iadd(list, 16))
