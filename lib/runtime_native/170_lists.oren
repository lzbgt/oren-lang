// --- Lists ---
// Layout: [count][capacity][buffer_ptr][magic]
fn list_int_kind() { return 8 } // LIST_INT (unboxed int list)
fn list_max_cap() { return 1073741824 } // 1 << 30 (matches GC list cap corruption guard)

fn _list_bytes_for_cap(cap) {
    if cap <= 0 { return 0 }
    if cap > list_max_cap() {
        print("trace: list_cap too large cap=" + oren_int_to_string(cap) +
              " max=" + oren_int_to_string(list_max_cap()))
        oren_panic("list cap too large")
        return 0
    }
    return cap * 8
}
	@oren.keep
fn oren_new_list(cap) {
    if cap < 0 { cap = 0 }
    // Performance (native tooling / stage2-native compiler):
	    // Allocate header + initial buffer in a single tracked block to cut allocation+tracking
	    // overhead in half for the common "many small lists" workload (AST/IR graphs).
	    //
    // Layout remains stable:
    //   [count][capacity][buffer_ptr][magic]
    // When cap>0, buffer_ptr points to inline storage at header+32.
    var total = 32 + _list_bytes_for_cap(cap)
    _list_hdr_req_trace_emit(2, cap, total, 1)
    _list_new_cap_emit(2, cap, total, 1)
    var header = malloc_k(total, 2)
    if header == 0 { exit(200) }
    if header == -1 { exit(200) }
    var site = _alloc_site_list_header()
    native_alloc_site_bump(site)
    var buf = 0
    if cap > 0 {
        buf = iadd(header, 32)
    }
    ptr_set(iadd(header, 0), 0)       // count
    ptr_set(iadd(header, 8), cap)     // capacity
    ptr_set(iadd(header, 16), buf)    // data buffer
    ptr_set(iadd(header, 24), list_magic())
    if native_alloc_index_get(header) == 0 {
        var rec = native_alloc_index_recover_ptr(header)
        if rec == 0 { oren_track_alloc_new(header, total, 2) }
    }
    trace_list_alloc_emit(header, 2, total, site, 1)
    _list_trace_emit(1, header, 2) // new_list
    return header
}

// --- List<int> (unboxed) ---
@oren.keep
fn oren_new_list_int(cap) {
    if cap < 0 { cap = 0 }
    var total = 32 + _list_bytes_for_cap(cap)
    _list_hdr_req_trace_emit(list_int_kind(), cap, total, 1)
    _list_new_cap_emit(list_int_kind(), cap, total, 1)
    var header = malloc_k(total, list_int_kind())
    if header == 0 { exit(200) }
    if header == -1 { exit(200) }
    var site = _alloc_site_list_int_header()
    native_alloc_site_bump(site)
    var buf = 0
    if cap > 0 {
        buf = iadd(header, 32)
    }
    ptr_set(iadd(header, 0), 0)       // count
    ptr_set(iadd(header, 8), cap)     // capacity
    ptr_set(iadd(header, 16), buf)    // data buffer
    ptr_set(iadd(header, 24), list_magic())
    if native_alloc_index_get(header) == 0 {
        var rec2 = native_alloc_index_recover_ptr(header)
        if rec2 == 0 { oren_track_alloc_new(header, total, list_int_kind()) }
    }
    trace_list_alloc_emit(header, list_int_kind(), total, site, 1)
    _list_trace_emit(2, header, list_int_kind()) // new_list_int
    return header
}

@oren.keep
fn _list_int_check_value(v) {
    if native_value_is_nil(v) { oren_panic("list_int expects int (got nil)"); return 0 }
    if native_value_is_true(v) || native_value_is_false(v) {
        oren_panic("list_int expects int (got bool)"); return 0
    }
    // If v is tracked, it's not an int (ints are untracked immediates).
    if native_gc_find_node_nolock(v) != 0 {
        oren_panic("list_int expects int (got pointer)")
    }
    return 0
}

// Cross-backend helper: allocate an empty list with reserved capacity.
// In native runtime, `oren_new_list(cap)` already has "capacity constructor" semantics.
@oren.keep
fn oren_list_new_cap(cap) {
    return oren_new_list(cap)
}

// Performance bench / opt-in unsafe mode:
// When set, skip `oren_find_node`/magic checks in list ops.
// Enable with OREN_LIST_ASSUME_LIST=1.
