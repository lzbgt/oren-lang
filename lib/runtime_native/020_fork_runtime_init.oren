// --- Fork hygiene (rolling; syscall-first) ---
// After fork(), the child process inherits any in-memory locks held at the moment of fork.
// Our native runtime allocator uses an in-memory lock keyed by a thread-id token.
// If a lock is held by the parent at fork time, the child must reset those lock fields
// before doing further allocations, or it can deadlock (classic "fork while locked" issue).
//
// This is not a "pthread atfork" shim; it's purely internal runtime hygiene for fork-based v0 features.
fn native_runtime_after_fork_child() {
    var g = oren_globals()
    if g == 0 { return 0 }
    // lock_owner_tid
    global_set_lock(0)
    // lock_recurse_count
    global_set_lock_count(0)
    return 0
}

fn oren_fork() {
    var pid = sys_fork()
    if pid == 0 {
        native_runtime_after_fork_child()
    }
    return pid
}

fn native_init_epoll_event_layout_linux() {
    // Linux epoll syscall ABI: `struct epoll_event` layout differs by arch.
    //
    // Observed (2026-01-06):
    // - x86_64: packed 12-byte layout, data @4 (WSL2)
    // - arm64:  16-byte layout, data @8 (Ubuntu arm64 container)
    //
    // We probe once at runtime init so the same portable runtime source works for both.
    //
    // Defaults (safe for arm64; overridden on packed kernels):
    OREN_EPOLL_EVENT_BYTES = 16
    OREN_EPOLL_EVENT_OFF_EVENTS = 0
    OREN_EPOLL_EVENT_OFF_DATA = 8

    if g_target_os != 2 { return 0 } // only Linux uses epoll

    // Probe strategy:
    // - create a pipe
    // - register the write fd with EPOLLOUT and set `data` to a marker value
    // - do a non-blocking epoll_pwait(timeout=0) and check where the kernel wrote `data`
    //
    // IMPORTANT: we must not write overlapping `u64` values at both candidate offsets (4 and 8),
    // because they overlap by 4 bytes. Instead we use a marker with `low32 == high32` so the
    // 8-byte window at offset 4 and the 8-byte window at offset 8 decode to the same `data` value.
    var marker32 = 287454020 // 0x11223344
    var marker64 = marker32 | (marker32 << 32)
    var pipe_buf = native_malloc_raw_or_mmap(16)
    if pipe_buf == 0 { return 0 }
    var prc = sys_pipe(pipe_buf)
    if prc != 0 { return 0 }
    var rfd = ptr_get(pipe_buf + 0)
    var wfd = ptr_get(pipe_buf + 8)

    var epfd = sys_epoll_create1(0)
    if epfd < 0 {
        sys_close(rfd); sys_close(wfd)
        return 0
    }

    var ev = native_malloc_raw_or_mmap(16)
    var out = native_malloc_raw_or_mmap(32)
    if ev == 0 || out == 0 {
        sys_close(epfd); sys_close(rfd); sys_close(wfd)
        return 0
    }

    // Zero-fill the control event buffer.
    var zi = 0
    while zi < 16 { ptr_set_byte(ev + zi, 0); zi = zi + 1 }

    // Fill the data bytes (4..15) with the marker32 pattern so `epoll_ctl` works regardless of packing.
    // (The probe only needs the returned event buffer layout.)
    oren_ptr_set_u32_le(ev + 0, OREN_EPOLLOUT)
    oren_ptr_set_u32_le(ev + 4, marker32)
    oren_ptr_set_u32_le(ev + 8, marker32)
    oren_ptr_set_u32_le(ev + 12, marker32)

    var rc = sys_epoll_ctl(epfd, OREN_EPOLL_CTL_ADD, wfd, ev)
    if rc < 0 {
        sys_close(epfd); sys_close(rfd); sys_close(wfd)
        return 0
    }

    zi = 0
    while zi < 32 { ptr_set_byte(out + zi, 0); zi = zi + 1 }

    // Non-blocking: pipe write end should be immediately writable.
    var n = sys_epoll_pwait(epfd, out, 1, 0, 0, 0)
    sys_close(epfd)
    sys_close(rfd)
    sys_close(wfd)

    if n > 0 {
        var d4 = oren_ptr_get_u64_le(out + 4)
        var d8 = oren_ptr_get_u64_le(out + 8)
        if d4 == marker64 {
            OREN_EPOLL_EVENT_BYTES = 12
            OREN_EPOLL_EVENT_OFF_DATA = 4
        } else if d8 == marker64 {
            OREN_EPOLL_EVENT_BYTES = 16
            OREN_EPOLL_EVENT_OFF_DATA = 8
        }
    }
    return 0
}

@oren.keep
fn native_runtime_init(target_os) {
    // The native backend is still rolling and does not reliably run global initializers
    // before entering the runtime. Ensure globals used by early allocation are safe.
    // IMPORTANT (Tier‑1 native backends):
    // `g_storage` must already be initialized by the entry stub before any Oren code executes.
    //
    // Reason: the native backend represents `nil/false/true` as runtime singletons stored in
    // globals storage, and boolean operations (including those used inside `native_runtime_init`)
    // depend on those singletons being available.
    //
    // Do not clear `g_storage` here.
    //
    // However, it is safe (and required for determinism) to initialize newly-added
    // rolling control slots that live in globals storage *after* the value singletons.
    //
    // In particular, stop-the-world GC coordination uses wait-on-address on these words,
    // so leaving them uninitialized could deadlock the runtime on some targets.
    if oren_globals() != 0 {
        ptr_set(iadd(oren_globals(), 424), 0) // GLOBAL_OFF_GC_STW_STATE
        ptr_set(iadd(oren_globals(), 432), 0) // GLOBAL_OFF_GC_STW_PARKED
        ptr_set(iadd(oren_globals(), 440), 0) // GLOBAL_OFF_GC_STW_OWNER_NODE
    }

    // --- Critical runtime globals (must not rely on global initializers) ---
    //
    // These live across multiple runtime modules, but `native_runtime_init` is the first
    // guaranteed entrypoint on all native targets.
    //
    // NOTE:
    // - `g_alloc_index_tomb` must be non-zero and <4096 so it never aliases a valid tracked pointer.
    // - `g_runtime_single_threaded` enables the fast-path in `oren_find_node`/locking for compiler-style
    //   single-threaded workloads (stage2-native).
    //
    // IMPORTANT:
    // Do not assume other globals are zeroed. Explicitly reset the allocation index and cstr0
    // membership set so early runtime code (and the entry stub) can safely initialize them.
    g_alloc_index_ptr = 0
    g_alloc_index_cap = 0
    g_alloc_index_len = 0
    g_alloc_index_probe_exhausted = 0
    g_static_allocs = 0
    g_cstr0_set_ptr = 0
    g_cstr0_set_cap = 0
    g_cstr0_set_len = 0
    g_cstr0_min_ptr = 0
    g_cstr0_max_ptr = 0
    g_alloc_index_tomb = 1
    g_runtime_single_threaded = 1

    // NET wait backend probe state (must not rely on global initializers).
    g_target_os = target_os
    g_net_wsa_inited = 0
    // Prefer target knowledge from codegen over probing syscalls at runtime.
    // This avoids unnecessary OS feature probes in tight paths and keeps behavior
    // deterministic across nested execution.
    if target_os == 1 {
        // macOS: kqueue exists
        g_net_has_kqueue = 1
    } else {
        // Linux (and any other non-macOS target): treat as no kqueue
        g_net_has_kqueue = 0
    }

    // IMPORTANT: today the native backend does not reliably run global initializers
    // before entering the runtime. Treat these as "constants" that must be set here.
    GLOBAL_SLOT_BYTES = 8
    GLOBAL_OFF_ALLOCS = 0
    GLOBAL_OFF_ROOTS = 8
    GLOBAL_OFF_LOCK_OWNER_TID = 16
    GLOBAL_OFF_FREE_NODES = 24
    GLOBAL_OFF_THREADS = 32
    GLOBAL_OFF_ARGC = 40
    GLOBAL_OFF_ARGV = 48
    GLOBAL_OFF_LOCK_RECURSE_COUNT = 56
    GLOBAL_OFF_ENVP = 64
    GLOBAL_OFF_FREE_BLOCKS = 72
    GLOBAL_OFF_CAPSULE_MODE = 80
    GLOBAL_OFF_CAP_ALLOW_MASK = 88
    GLOBAL_OFF_FS_ALLOW_PREFIXES_PTR = 96
    GLOBAL_OFF_FS_ALLOW_READ_PREFIXES_PTR = 104
    GLOBAL_OFF_FS_ALLOW_WRITE_PREFIXES_PTR = 112
    GLOBAL_OFF_FS_MOUNTS_PTR = 120
    GLOBAL_OFF_FS_MOUNTS_READ_PTR = 128
    GLOBAL_OFF_FS_MOUNTS_WRITE_PTR = 136
    GLOBAL_OFF_NET_ALLOW_LOOPBACK = 144
    GLOBAL_OFF_NET_ALLOW_TCP_CONNECT_PTR = 152
    GLOBAL_OFF_NET_ALLOW_TCP_LISTEN_PTR = 160
    GLOBAL_OFF_NET_TCP_CONNECT_MAP_PTR = 208
    GLOBAL_OFF_NET_TCP_LISTEN_MAP_PTR = 216
    GLOBAL_OFF_NET_FD_CAPS_PTR = 224
    GLOBAL_OFF_NET_FD_CAPS_LEN = 232
    GLOBAL_OFF_NET_FD_CAPS_MAP_KEYS_PTR = 320
    GLOBAL_OFF_NET_FD_CAPS_MAP_VALS_PTR = 328
    GLOBAL_OFF_NET_FD_CAPS_MAP_CAP = 336
    GLOBAL_OFF_NET_FD_CAPS_MAP_LEN = 344
    GLOBAL_OFF_NET_FD_CAPS_LOCK = 352
    GLOBAL_OFF_PROC_ALLOW_SYSTEM = 168
    GLOBAL_OFF_PROC_ALLOW_EXEC_PREFIXES_PTR = 176
    GLOBAL_OFF_PROC_INHERIT_ENV = 184
    GLOBAL_OFF_PROC_ALLOW_ENV_KEYS_PTR = 192
    GLOBAL_OFF_PROC_ALLOW_ARGV_PTR = 200
    GLOBAL_OFF_PROC_ALLOWED_PIDS_PTR = 240
    GLOBAL_OFF_PROC_ALLOWED_PIDS_LEN = 248
    GLOBAL_OFF_PROC_ALLOWED_PIDS_CAP = 256
    GLOBAL_OFF_ENABLE_SIMD = 264
    GLOBAL_OFF_RAW_MMAP_THRESHOLD = 272
    GLOBAL_OFF_BUF_ALIGN = 280
    GLOBAL_OFF_BUF_FORCE_MMAP = 288
    GLOBAL_OFF_BUF_PAYLOAD_LIMIT = 296
    GLOBAL_OFF_CALL_DEPTH = 304
    GLOBAL_OFF_CALL_DEPTH_MAX = 312
    GLOBAL_OFF_VALUE_NIL = 368
    GLOBAL_OFF_VALUE_FALSE = 376
    GLOBAL_OFF_VALUE_TRUE = 384
    GLOBAL_OFF_GC_STW_STATE = 424
    GLOBAL_OFF_GC_STW_PARKED = 432
    GLOBAL_OFF_GC_STW_OWNER_NODE = 440
    GLOBAL_SLOTS_RESERVED = 56

    // IMPORTANT: do not rely on global initializers for these constants.
    // Capability mask bits (used by capsule runtime enforcement).
    CAP_FS = 1
    CAP_NET = 2
    CAP_PROC = 4
    CAP_ENV = 8
    CAP_TIME = 16
    CAP_RNG = 32

    // Oren-level open(2) flags (translated by native syscall lowering).
    OREN_O_CREAT = 256
    OREN_O_TRUNC = 512
    OREN_O_NONBLOCK = 1024

    // POSIX socket constants.
    OREN_AF_INET = 2
    // AF_INET6 differs across macOS/Linux.
    //
    // Windows uses the same sockaddr_in6 layout as Linux but a different AF_INET6 value (23).
    if target_os == 1 { OREN_AF_INET6 = 30 }
    else if target_os == 3 { OREN_AF_INET6 = 23 }
    else { OREN_AF_INET6 = 10 }
    OREN_AF_UNIX = 1
    OREN_SOCK_STREAM = 1
    OREN_SOCK_DGRAM = 2
    OREN_IPPROTO_TCP = 6
    OREN_IPPROTO_UDP = 17
    OREN_TCP_NODELAY = 1

    // Sockopt constants (Oren-level; translated by native syscall lowering).
    OREN_SOL_SOCKET = 1
    OREN_SO_REUSEADDR = 2
    OREN_SO_ERROR = 4
    // Matches Linux SO_KEEPALIVE (9); Darwin/Windows translate from this Oren-level ID.
    OREN_SO_KEEPALIVE = 9

    // Typed buffer tags.
    //
    // IMPORTANT:
    // The native backend treats the injected runtime as a library and does not rely on
    // top-level global initializers to run before `native_runtime_init`.
    //
    // These constants are used by:
    // - typed-buffer alloc/load/store helpers
    // - `oren_iter_next` typed-buffer iteration (Tier-1 fixture hard gate)
    BUF_TAG_U8 = 5
    BUF_TAG_I32 = 1
    BUF_TAG_I64 = 2
    BUF_TAG_F32 = 3
    BUF_TAG_F64 = 4

    // Per-fd kind tags (capsule hardening).
    FD_KIND_NONE = 0
    FD_KIND_TCP_STREAM = 1
    FD_KIND_TCP_LISTEN = 2
    FD_KIND_UDP_DGRAM = 3
    FD_KIND_PROC_PIPE = 10
    FD_KIND_KQUEUE = 20
    FD_KIND_EPOLL = 21

    FCNTL_F_DUPFD = 0
    FCNTL_F_DUPFD_CLOEXEC = 67

    // Linux epoll constants (unused on macOS; safe to define).
    OREN_EPOLL_CTL_ADD = 1
    OREN_EPOLL_CTL_DEL = 2
    OREN_EPOLL_CTL_MOD = 3
    OREN_EPOLLIN = 1
    OREN_EPOLLOUT = 4
    native_init_epoll_event_layout_linux()

    // Globals storage is owned by the entry stub (Tier‑1 bootstrap).
    // Keep the value singletons as stable, distinct addresses inside the storage arena.
    //
    // Contract:
    // - these pointers are NOT tracked heap allocations
    // - their contents are irrelevant; only pointer identity matters
    var v_nil = iadd(g_storage, 392)
    var v_false = iadd(g_storage, 400)
    var v_true = iadd(g_storage, 408)
    global_set_value_nil(v_nil)
    global_set_value_false(v_false)
    global_set_value_true(v_true)
    // Root the slots (not the values) so mark phase can load+mark them deterministically.
    native_gc_register_root(iadd(g_storage, 368))
    native_gc_register_root(iadd(g_storage, 376))
    native_gc_register_root(iadd(g_storage, 384))

    // Defaults for allocator policy (rolling):
    // - threshold: 1 MiB (matches C runtime)
    // - align: 64 bytes (cache-line / NEON friendly)
    // - force_mmap: off
    // - payload_limit: unlimited (0)
    global_set_raw_mmap_threshold(1048576)
    global_set_buf_align(64)
    global_set_buf_force_mmap(0)
    global_set_buf_payload_limit(0)

    // Stack safety (rolling):
    // - call_depth is tracked by compiler-inserted enter/exit hooks in the native backend
    // - call_depth_max is a runtime-configurable budget (env override applied later once envp is known)
    //
    // Default mirrors C backend: 8192 nested calls.
    //
    // Use literal offsets here so this stays correct even if offset globals are still rolling.
    // (See lib/runtime_native/105_call_depth.oren.)
    ptr_set(iadd(g_storage, 304), 0)    // call_depth
    ptr_set(iadd(g_storage, 312), 8192) // call_depth_max

    // NET per-fd capability tags (rolling; capsule hardening).
    // We intentionally keep this simple: a byte-per-fd kind table.
    //
    // NOTE:
    // - This is not a general-purpose fd table; it only exists to prevent bypass
    //   via raw `sys_*` NET syscalls in capsule mode.
    // - Allocation uses malloc_raw so GC never reclaims it.
    var max_fds = 4096
    var caps = native_malloc_raw_or_mmap(max_fds)
    if caps == 0 { exit(302) }
    var zi = 0
    while zi < max_fds {
        ptr_set_byte(caps + zi, 0)
        zi = zi + 1
    }
    global_set_net_fd_caps_ptr(caps)
    global_set_net_fd_caps_len(max_fds)

    // NET fd kind overflow map (rolling; capsule hardening).
    //
    // Why:
    // - POSIX fds are small dense integers, so a byte-per-fd table is efficient.
    // - Windows SOCKET/HANDLE values are pointer-sized and can be large/sparse, so an
    //   array indexed by fd is not viable.
    //
    // Approach:
    // - Keep the small dense table for fast-path fds < max_fds.
    // - Add an open-addressing hash map for any fd >= max_fds (and for future sparse cases).
    //
    // Encoding:
    // - keys are stored as (fd + 2), with:
    //     0 => empty
    //     1 => tombstone
    // - vals is a byte-per-entry kind.
    var map_cap = 16384
    var keys = native_malloc_raw_or_mmap(map_cap * 8)
    var vals = native_malloc_raw_or_mmap(map_cap)
    if keys == 0 || vals == 0 { exit(303) }
    zi = 0
    while zi < map_cap {
        ptr_set(iadd(keys, zi * 8), 0)
        ptr_set_byte(vals + zi, 0)
        zi = zi + 1
    }
    global_set_net_fd_caps_map_keys_ptr(keys)
    global_set_net_fd_caps_map_vals_ptr(vals)
    global_set_net_fd_caps_map_cap(map_cap)
    global_set_net_fd_caps_map_len(0)
    global_set_net_fd_caps_lock(0)

    // PROC allowed pid table (rolling; capsule hardening).
    //
    // Tracks subprocess pids created by syscall-first spawn so raw sys_wait4/sys_kill
    // cannot target arbitrary host processes in capsule mode.
    var pid_cap = 1024
    var ptab = native_malloc_raw_or_mmap(pid_cap * 8)
    if ptab == 0 { exit(304) }
    zi = 0
    while zi < pid_cap {
        ptr_set(iadd(ptab, zi * 8), 0)
        zi = zi + 1
    }
    global_set_proc_allowed_pids_ptr(ptab)
    global_set_proc_allowed_pids_len(0)
    global_set_proc_allowed_pids_cap(pid_cap)
    return 0
}

// macOS syscall-first threading init (Darwin bsdthread + ulock model).
//
// NOTE:
// - This is intentionally "best-effort" for now: if the process is already
//   registered (because the host runtime registered earlier), the syscall
//   will fail with EINVAL; we treat that as non-fatal for v0.
// - For Oren's syscall-first runtime we want the kernel threadstart function
//   to be OUR stub (emitted by the native backend), not libpthread.
//
// Args are code pointers to the native backend's thread entry stubs.
fn native_runtime_threading_init(threadstart, wqthread) {
    // Syscall-first thread substrate registration for Darwin.
    //
    // IMPORTANT:
    // - This uses the kernel syscall ABI (xnu `bsd_kern_syscalls.master`, syscall 366), not
    //   libpthread's `__bsdthread_register` wrapper ABI.
    // - Different macOS releases / kernel pthread substrates accept different "shapes" of the
    //   register call. For syscall-first bring-up, we try a small set of compatible parameterizations
    //   and treat failure as "threading unavailable" rather than killing the whole process.
    //
    // Signature:
    //   sys_bsdthread_register(threadstart, wqthread, flags, stack_addr_hint, targetconc_ptr, dispatchqueue_offset, tsd_offset)
    //
    // Kernel references:
    // - xnu: `bsd_kern_syscalls.master` entry 366
    // - xnu: `bsd_pthread_pthread_shims.c` forwards to pthread substrate (register / register2)
    // - libpthread OSS: `kern/kern_internal.h` + `kern/kern_support.c` show the "registration blob"
    //   contract used by the legacy register path.

    // libpthread’s LP64 pthread_t size is rounded to a page (commonly 16 KiB on arm64 macOS).
    // For syscall-first bring-up we match that baseline.
    var pthread_size_guess = 16384
    var reg_size = 56

    // Critical: macOS arm64 assumes a fixed `pthread_t` -> TSD base relationship for fast paths.
    // Apple OSS libpthread documents this as:
    // - `_PTHREAD_STRUCT_DIRECT_TSD_OFFSET` = 224 on LP64
    // - `offsetof(struct pthread_s, tsd) == 224` (LP64)
    //
    // If the kernel pthread substrate rejects non-standard offsets, registration will fail with EINVAL.
    var tsd_off = 224

    // Build a packed `_pthread_registration_data` blob (56 bytes).
    // Layout (bytes):
    //   0:  u64 version
    //   8:  u64 dispatch_queue_offset
    //   16: u64 main_qos (out)
    //   24: u32 tsd_offset
    //   28: u32 return_to_kernel_offset
    //   32: u32 mach_thread_self_offset
    //   36: u64 stack_addr_hint (out; unaligned in packed struct)
    //   44: u32 mutex_default_policy (out)
    //   48: u32 joinable_offset_bits
    //   52: u32 wq_quantum_expiry_offset
    var reg = native_malloc_raw_or_mmap(reg_size)
    if reg == 0 { exit(944) }
    oren_ptr_set_u64_le(reg + 0, reg_size) // version == sizeof(struct _pthread_registration_data)
    // libpthread sets dispatch_queue_offset = __PTK_LIBDISPATCH_KEY0 * sizeof(void *) = 20*8 = 160.
    // Keep it in-range even when libdispatch isn't used by syscall-first binaries.
    oren_ptr_set_u64_le(reg + 8, 160)
    oren_ptr_set_u64_le(reg + 16, 0) // main_qos (copy-out)
    oren_ptr_set_u32_le(reg + 24, tsd_off)
    // `return_to_kernel_offset` and `mach_thread_self_offset` are TSD-base-relative byte offsets.
    // Apple OSS `tsd_private.h` documents the low TSD slots used by libsystem:
    //   __TSD_MACH_THREAD_SELF  (slot 3)  => 3*8 = 24 bytes
    //   __TSD_RETURN_TO_KERNEL (slot 5)  => 5*8 = 40 bytes
    //
    // These are required for the kernel to copy out the thread port into TSD for libpthread fast paths.
    oren_ptr_set_u32_le(reg + 28, 40)
    oren_ptr_set_u32_le(reg + 32, 24)
    // stack_addr_hint (copy-out) lives at an unaligned offset in the packed struct; write bytes.
    oren_ptr_set_u64_le(reg + 36, 0)
    oren_ptr_set_u32_le(reg + 44, 0)
    // libpthread uses `CHAR_BIT * (offsetof(struct pthread_s, tl_policy) + 1)`; LP64 tl_policy offset is 48.
    // => 8 * (48 + 1) = 392. Keep this plausible for kernel-side joinability bookkeeping.
    oren_ptr_set_u32_le(reg + 48, 392)
    // libpthread sets wq_quantum_expiry_offset = __PTK_LIBDISPATCH_KEY10 * sizeof(void *) = 120*8 = 960.
    oren_ptr_set_u32_le(reg + 52, 960)

    // NOTE: in the current Darwin pthread kernel substrate, the registration syscall follows the
    // legacy "init-blob" contract (see Apple OSS `kern/kern_support.c::_bsdthread_register`).
    //
    // Syscall arguments are interpreted as:
    // - flags: pthsize (PTHREAD_SIZE)
    // - stack_addr_hint: pthread_init_data pointer (copy-in/out struct)
    // - targetconc_ptr: pthread_init_data_size (value, not a pointer)
    // - dispatchqueue_offset: used if pthread_init_data == 0, otherwise ignored (we pass it for completeness)
    // - tsd_offset: ignored by legacy path (the blob's `tsd_offset` is used instead)
    var rv = sys_bsdthread_register(threadstart, wqthread, pthread_size_guess, reg, reg_size, 160, 0)

    // Best-effort policy:
    // - If we cannot register, don't kill the process: leave threading disabled and let tests/programs run.
    // - When registration succeeds, enable the OS-thread API (oren_darwin_os_thread_*).
    g_darwin_bsdthread_register_last_rv = rv
    // Kernel returns:
    // - >=0: success (feature bits; may be 0 on some kernel/substrate combinations)
    // - -EINVAL (-22): already registered (common when dyld/libsystem already installed pthread substrate)
    //
    // Treat any non-negative return as success so syscall-first binaries can still use
    // `bsdthread_create` even when the kernel reports "no feature bits".
    if rv >= 0 || rv == -22 { g_darwin_bsdthread_registered = 1 }
    return rv
}

@oren.keep
fn native_runtime_set_args(argc, argv) {
    global_set_argc(argc)
    global_set_argv(argv)
    return 0
}

@oren.keep
fn native_runtime_set_envp(envp) {
    // Keep this function leaf-like (no calls) to avoid any stack-offset bugs
    // while the compiler/runtime ABI is still evolving.
    global_set_envp(envp)
    return 0
}
