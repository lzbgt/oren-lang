// Bounds + nil checks remain to keep semantics identical for safe list<int> paths.
@oren.keep
fn oren_list_int_get_unchecked(list, idx) {
    if list == nil { oren_panic("list_int_get_unchecked on nil"); return nil }
    var count = ptr_get(iadd(list, 0))
    if idx < 0 { oren_panic("Index out of bounds (negative)"); return nil }
    if idx >= count { oren_panic("Index out of bounds"); return nil }
    var buf = ptr_get(iadd(list, 16))
    return ptr_get(iadd(buf, idx * 8))
}

@oren.keep
fn oren_list_int_set(list, idx, value) {
    if list == nil { oren_panic("list_int_set on nil"); return nil }
    var node = _list_find_node_known_kind(list, list_int_kind())
    if node == 0 { _list_trace_dump(list); oren_panic("list_int_set on non-list"); return nil }
    if ptr_get(iadd(node, 16)) != list_int_kind() { _list_trace_dump(list); oren_panic("list_int_set on non-list"); return nil }
    if ptr_get(iadd(list, 24)) != list_magic() { _list_trace_dump(list); oren_panic("list_int_set on non-list") }
    _list_int_check_value(value)

    var count = ptr_get(iadd(list, 0))
    if idx < 0 { oren_panic("Index out of bounds (negative)") }
    var want = iadd(idx, 1)
    var cap = ptr_get(iadd(list, 8))
    var buf = ptr_get(iadd(list, 16))

    if want > cap {
        if cap < 0 || cap > list_max_cap() {
            _list_trace_dump(list)
            oren_panic("list_int_set on corrupt list")
            return nil
        }
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        if new_cap < want { new_cap = want }
        var bytes = _list_bytes_for_cap(new_cap)
        var new_buf = _list_alloc_buf(list, bytes, new_cap, list_int_kind(), _alloc_site_list_int_buf(), 212)

        var i = 0
        while i < count {
            ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
            i = iadd(i, 1)
        }
        _list_reserve_bytes_bump(list_int_kind(), count, new_cap)
        // Initialize new slots to 0.
        while i < want {
            ptr_set(iadd(new_buf, i * 8), 0)
            i = iadd(i, 1)
        }

        buf = new_buf
        cap = new_cap
        ptr_set(iadd(list, 8), cap)
        ptr_set(iadd(list, 16), buf)
    } else {
        if buf == 0 { oren_panic("list_int_set: buf nil") }
    }

    ptr_set(iadd(buf, idx * 8), value)
    if want > count { ptr_set(iadd(list, 0), want) }
    _list_corrupt_check(list, 14) // list_int_set
    _list_trace_emit(11, list, list_int_kind()) // list_int_set
    return value
}

	@oren.keep
fn oren_list_push(list, value) {
    if list == nil {
        oren_panic("list_push on nil")
        return nil
    }
    if _list_assume_list_enabled() != true {
        // Safety: do not dereference arbitrary large integers as pointers.
	    var node = _list_find_node_known_kind(list, 2)
	    if node == 0 { oren_panic("list_push: untracked ptr"); return 0 }
	    if ptr_get(iadd(node, 16)) != 2 { oren_panic("list_push: wrong kind"); return 0 }
	    if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("list_push: bad magic"); return 0 }
    }
	    var count = ptr_get(iadd(list, 0))
	    var cap = ptr_get(iadd(list, 8))
			    var buf = ptr_get(iadd(list, 16))
			    if count >= cap {
			        if cap < 0 || cap > list_max_cap() {
			            _list_trace_dump(list)
			            oren_panic("list_push on corrupt list")
			            return nil
			        }
			        var new_cap = cap * 2
			        if new_cap < 4 { new_cap = 4 }
		        var bytes = _list_bytes_for_cap(new_cap)
		        var new_buf = _list_alloc_buf(list, bytes, new_cap, 2, _alloc_site_list_buf(), 211)
		        var i = 0
	        while i < count {
	            ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
	            i = iadd(i, 1)
	        }
	        _list_reserve_bytes_bump(2, count, new_cap)
        buf = new_buf
	        cap = new_cap
	        ptr_set(iadd(list, 8), cap)
	        ptr_set(iadd(list, 16), buf)
	    }
    ptr_set(iadd(buf, count * 8), value)
    ptr_set(iadd(list, 0), iadd(count, 1))
    _list_corrupt_check(list, 3) // list_push
    _list_trace_emit(4, list, 2) // list_push
    // Language-level semantics: `oren_list_push` is statement-like and returns `nil`.
    // (The list header pointer is stable and does not need to be returned.)
    return nil
}

// Unsafe/fast-path (tooling/internal): push without `oren_find_node` / kind/magic validation.
// Used by compiler hot paths (astbin decode) where the container provenance is trusted.
@oren.keep
fn oren_list_push_unchecked(list, value) {
    if list == nil { oren_panic("list_push_unchecked on nil"); return nil }
    var count = ptr_get(iadd(list, 0))
    var cap = ptr_get(iadd(list, 8))
	    var buf = ptr_get(iadd(list, 16))
	    if count >= cap {
	        if cap < 0 || cap > list_max_cap() {
	            oren_panic("list_push_unchecked on corrupt list")
	            return nil
	        }
	        var new_cap = cap * 2
	        if new_cap < 4 { new_cap = 4 }
	        var bytes = _list_bytes_for_cap(new_cap)
	        var new_buf = _list_alloc_buf(list, bytes, new_cap, 2, _alloc_site_list_buf(), 211)
	        var i = 0
	        while i < count {
	            ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
	            i = iadd(i, 1)
        }
        _list_reserve_bytes_bump(2, count, new_cap)
        buf = new_buf
        cap = new_cap
        ptr_set(iadd(list, 8), cap)
        ptr_set(iadd(list, 16), buf)
    }
    ptr_set(iadd(buf, count * 8), value)
    ptr_set(iadd(list, 0), iadd(count, 1))
    _list_corrupt_check(list, 2) // list_push_unchecked
    _list_trace_emit(5, list, 2) // list_push_unchecked
    return nil
}

@oren.keep
fn oren_list_get(list, idx) {
    if list == nil {
        oren_panic("Indexing on nil")
        return nil
    }
    var count = 0
    if _list_assume_list_enabled() != true {
        // Safety: do not dereference arbitrary large integers as pointers.
        // `x[i]` is defined for lists and maps; reject other values deterministically.
        var node = _list_find_node_resilient(list)
        if node == 0 {
            _list_get_bad_emit(1, list, idx, node, 0)
            _list_trace_dump(list)
            oren_panic("Indexing on non-container")
            return nil
        }
        var kind = ptr_get(iadd(node, 16))
        if kind != 2 && kind != list_int_kind() {
            if kind == 3 {
                // Not a list: treat as map indexing.
                // Key kind is selected by `oren_map_get` using tracking metadata.
                return oren_map_get(list, idx)
            }
            native_alloc_index_rebuild_live()
            node = _list_find_node_resilient(list)
            if node != 0 {
                kind = ptr_get(iadd(node, 16))
                if kind == 3 {
                    return oren_map_get(list, idx)
                }
                if kind == 2 || kind == list_int_kind() {
                    // fall through to list handling
                } else {
                    _list_get_bad_emit(2, list, idx, node, kind)
                    _list_trace_dump(list)
                    oren_panic("Indexing on non-container")
                    return nil
                }
            } else {
                _list_get_bad_emit(3, list, idx, node, 0)
                _list_trace_dump(list)
                oren_panic("Indexing on non-container")
                return nil
            }
        }
        if ptr_get(iadd(list, 24)) != list_magic() {
            _list_get_bad_emit(4, list, idx, node, kind)
            _list_trace_dump(list)
            oren_panic("Indexing on non-list")
            return nil
        }
        count = ptr_get(iadd(list, 0))
    } else {
        count = ptr_get(iadd(list, 0))
    }
    if idx < 0 { 
        oren_panic("Index out of bounds (negative)")
        return nil
    }
    if idx >= count { 
        oren_panic("Index out of bounds")
        return nil
    }
	    var buf = ptr_get(iadd(list, 16))
	    return ptr_get(iadd(buf, idx * 8))
}

// Set list element, growing the list as needed. Returns the written value.
//
// Language-level semantics (rolling, matches C backend + tests):
// - `xs[i] = v` on a list grows `xs` to length `i+1` if needed.
// - New slots are initialized to `nil`.
@oren.keep
fn oren_list_set(list, idx, value) {
    if list == nil { oren_panic("list_set on nil"); return nil }
    // Safety: do not dereference arbitrary large integers as pointers.
	    var count = 0
        var is_list_int = 0
        if _list_assume_list_enabled() != true {
	        var node = _list_find_node_resilient(list)
	        if node == 0 { oren_panic("list_set on non-list"); return nil }
	        var kind = ptr_get(iadd(node, 16))
	        if kind == list_int_kind() {
	            is_list_int = 1
	        } else if kind != 2 {
	            oren_panic("list_set on non-list"); return nil
	        }
	        if ptr_get(iadd(list, 24)) != list_magic() { oren_panic("list_set on non-list") }
	        count = ptr_get(iadd(list, 0))
        } else {
            count = ptr_get(iadd(list, 0))
        }
        if is_list_int != 0 { _list_int_check_value(value) }
	    if idx < 0 { oren_panic("Index out of bounds (negative)") }
	    var want = iadd(idx, 1)
	    var cap = ptr_get(iadd(list, 8))
	    var buf = ptr_get(iadd(list, 16))

    if want > cap {
        if cap < 0 || cap > list_max_cap() {
            _list_trace_dump(list)
            oren_panic("list_set on corrupt list")
            return nil
        }
        var new_cap = cap * 2
        if new_cap < 4 { new_cap = 4 }
        if new_cap < want { new_cap = want }
        var alloc_site = _alloc_site_list_buf()
        var kind = 2
        if is_list_int != 0 {
            alloc_site = _alloc_site_list_int_buf()
            kind = list_int_kind()
        }
        var bytes = _list_bytes_for_cap(new_cap)
        var new_buf = _list_alloc_buf(list, bytes, new_cap, kind, alloc_site, 212)

        var i = 0
        while i < count {
            ptr_set(iadd(new_buf, i * 8), ptr_get(iadd(buf, i * 8)))
            i = iadd(i, 1)
        }
        if is_list_int != 0 {
            _list_reserve_bytes_bump(list_int_kind(), count, new_cap)
        } else {
            _list_reserve_bytes_bump(2, count, new_cap)
        }
        if is_list_int != 0 {
            // Initialize new slots to 0 for list<int>.
            while i < want {
                ptr_set(iadd(new_buf, i * 8), 0)
                i = iadd(i, 1)
            }
        } else {
            // Initialize new slots to nil.
            while i < want {
                ptr_set(iadd(new_buf, i * 8), nil)
                i = iadd(i, 1)
            }
        }

        buf = new_buf
        cap = new_cap
        ptr_set(iadd(list, 8), cap)
        ptr_set(iadd(list, 16), buf)
    } else {
        if buf == 0 {
            // cap may be 0 for an empty list, but then want>cap and we would have allocated above.
            // If we reach here, treat it as a runtime invariant violation.
            oren_panic("list buffer is nil")
            return nil
        }
        // Grow count in-place; ensure newly exposed slots are nil.
        var j = count
        while j < want {
            ptr_set(iadd(buf, j * 8), nil)
            j = iadd(j, 1)
        }
    }

    ptr_set(iadd(buf, idx * 8), value)
    if want > count { ptr_set(iadd(list, 0), want) }
    _list_corrupt_check(list, 4) // list_set
    _list_trace_emit(9, list, 2) // list_set
    return value
}
