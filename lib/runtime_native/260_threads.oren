// --- Threads ---
@cap.requires(domain="PROC")
fn oren_system(cmd) {
    native_capsule_require(CAP_PROC, "PROC")
    return oren_system_timeout(cmd, -1)
}

fn native_runtime_get_envp_ptr() {
    // Preserve parent environment without libc.
    // Prefer the envp captured at process entry; fallback to deriving envp from argv/argc.
    var envp = global_get_envp()
    if envp == 0 {
        var argc = global_get_argc()
        var parent_argv = global_get_argv()
        if parent_argv != 0 {
            // Cap derived pointer math so a corrupted argc can't walk arbitrarily.
            if argc >= 0 && argc <= 1048576 {
                envp = iadd(parent_argv, (iadd(argc, 1)) * 8)
            }
        }
    }
    if envp == 0 {
        envp = malloc(8) // 1 pointer (NULL-terminated)
        if envp == 0 { return 0 }
        ptr_set(envp, 0)
    }
    return envp
}

fn native_csv_has_key(csv_cstr, key_ptr, key_len) {
    if csv_cstr == 0 { return false }
    if key_ptr == 0 { return false }
    if key_len <= 0 { return false }

    var n = native_cstr_len(csv_cstr)
    var i = 0
    var start = 0
    while i <= n {
        var ch = 0
        if i < n { ch = ptr_get_byte(iadd(csv_cstr, i)) }

        var is_sep = false
        if i == n { is_sep = true }
        if ch == 44 { is_sep = true } // ','

        if is_sep {
            var tok_start = start
            var tok_end = i
            while tok_start < tok_end && ptr_get_byte(iadd(csv_cstr, tok_start)) == 32 { tok_start = tok_start + 1 }
            while tok_end > tok_start && ptr_get_byte(iadd(csv_cstr, tok_end - 1)) == 32 { tok_end = tok_end - 1 }

            if tok_end - tok_start == key_len {
                var j = 0
                var ok = true
                while j < key_len {
                    if ptr_get_byte(iadd(csv_cstr, tok_start + j)) != ptr_get_byte(iadd(key_ptr, j)) {
                        ok = false
                        j = key_len
                    } else {
                        j = j + 1
                    }
                }
                if ok { return true }
            }

            start = i + 1
        }
        i = i + 1
    }
    return false
}

fn native_envp_push_unique(out, oi, max_out, ptr) {
    if ptr == 0 { return oi }
    var j = 0
    while j < oi {
        if ptr_get(out + (j * 8)) == ptr { return oi }
        j = j + 1
    }
    if oi >= max_out { return oi }
    ptr_set(out + (oi * 8), ptr)
    return oi + 1
}

// --- Windows PROC helpers (CreateProcessA command line + environment block) ---
//
// Windows uses:
// - A single command-line string (`lpCommandLine`) rather than argv[]
// - A double-NUL-terminated environment block rather than envp[]
//
// To keep the syscall-first model consistent, the runtime builds those blobs and
// calls `sys_win_createprocess(...)`, which is a Windows-only compiler intrinsic
// lowered by the x86_64 native backend via PE IAT.

fn native_windows_cmdline_quoted_len(arg) {
    // Returns the number of bytes written by `native_windows_cmdline_write_quoted`.
    //
    // We always quote args to keep parsing deterministic, and escape according to the
    // MSVC / CommandLineToArgvW rules:
    // - backslashes are doubled when they precede a quote or the end of the string
    // - a quote is escaped by a preceding backslash
    //
    // Encoding:
    //   " ... "  (ASCII quotes)
    //
    // Empty arg becomes: ""
    if arg == 0 { return 2 }
    var len = 1 // opening '"'
    var bs = 0
    var i = 0
    while true {
        var ch = ptr_get_byte(iadd(arg, i))
        if ch == 0 { break }
        if ch == 92 { // '\\'
            bs = bs + 1
            i = i + 1
            continue
        }
        if ch == 34 { // '"'
            // (2*bs + 1) backslashes + '"'  => 2*bs + 2 bytes
            len = len + (bs * 2) + 2
            bs = 0
            i = i + 1
            continue
        }
        // Normal char: bs backslashes + char
        len = len + bs + 1
        bs = 0
        i = i + 1
    }
    // End: double remaining backslashes before closing quote.
    len = len + (bs * 2)
    len = len + 1 // closing '"'
    return len
}

fn native_windows_cmdline_write_quoted(dst, pos, arg) {
    // Writes a quoted+escaped arg at dst[pos..] and returns the updated pos.
    if dst == 0 { return pos }
    // Opening quote
    ptr_set_byte(iadd(dst, pos), 34)
    pos = pos + 1
    if arg == 0 {
        // Closing quote
        ptr_set_byte(iadd(dst, pos), 34)
        return pos + 1
    }

    var bs = 0
    var i = 0
    while true {
        var ch = ptr_get_byte(iadd(arg, i))
        if ch == 0 { break }
        if ch == 92 { // '\\'
            bs = bs + 1
            i = i + 1
            continue
        }
        if ch == 34 { // '"'
            // Emit 2*bs + 1 backslashes
            var k = 0
            var need = bs * 2 + 1
            while k < need {
                ptr_set_byte(iadd(dst, pos), 92)
                pos = pos + 1
                k = k + 1
            }
            // Emit quote
            ptr_set_byte(iadd(dst, pos), 34)
            pos = pos + 1
            bs = 0
            i = i + 1
            continue
        }

        // Emit bs backslashes
        var j = 0
        while j < bs {
            ptr_set_byte(iadd(dst, pos), 92)
            pos = pos + 1
            j = j + 1
        }
        bs = 0
        // Emit char
        ptr_set_byte(iadd(dst, pos), ch)
        pos = pos + 1
        i = i + 1
    }

    // End: emit 2*bs backslashes before closing quote.
    var t = 0
    var tail = bs * 2
    while t < tail {
        ptr_set_byte(iadd(dst, pos), 92)
        pos = pos + 1
        t = t + 1
    }

    // Closing quote
    ptr_set_byte(iadd(dst, pos), 34)
    return pos + 1
}

fn native_windows_cmdline_needs_quotes(arg) {
    // Decide whether an argument must be quoted for a Windows command line.
    //
    // Rationale:
    // - We used to quote *every* arg, but that breaks some programs that do their own
    //   option parsing on the raw command line (notably `cmd.exe`, where quoting `/C`
    //   makes it fail to recognize the switch).
    // - For most programs, quoting only when necessary is both deterministic and compatible.
    //
    // Quote when:
    // - empty string (would disappear otherwise)
    // - contains whitespace (space/tab/newline)
    // - contains a double quote (needs escaping)
    if arg == 0 { return true }
    var ch0 = ptr_get_byte(arg)
    if ch0 == 0 { return true } // empty => must be ""

    var i = 0
    while i < 4096 {
        var ch = ptr_get_byte(iadd(arg, i))
        if ch == 0 { break }
        if ch == 32 { return true } // space
        if ch == 9 { return true }  // tab
        if ch == 10 { return true } // '\n'
        if ch == 13 { return true } // '\r'
        if ch == 34 { return true } // '"'
        i = i + 1
    }
    return false
}

fn native_windows_cmdline_write_plain(dst, pos, arg) {
    // Writes arg as-is (no surrounding quotes) and returns updated pos.
    if dst == 0 { return pos }
    if arg == 0 { return pos }
    var i = 0
    while i < 4096 {
        var ch = ptr_get_byte(iadd(arg, i))
        if ch == 0 { break }
        ptr_set_byte(iadd(dst, pos), ch)
        pos = pos + 1
        i = i + 1
    }
    return pos
}

fn native_windows_cmdline_arg_len(arg) {
    if native_windows_cmdline_needs_quotes(arg) { return native_windows_cmdline_quoted_len(arg) }
    return native_cstr_len(arg)
}

fn native_windows_cmdline_write_arg(dst, pos, arg) {
    if native_windows_cmdline_needs_quotes(arg) { return native_windows_cmdline_write_quoted(dst, pos, arg) }
    return native_windows_cmdline_write_plain(dst, pos, arg)
}

fn native_windows_cmdline_from_argvp(argvp, argc) {
    // Build a mutable NUL-terminated Windows command line from a c argv[] pointer array.
    if argvp == 0 { return 0 }
    if argc <= 0 { return 0 }

    // Pass 1: compute total length.
    var total = 0
    var i = 0
    while i < argc {
        var a = ptr_get(iadd(argvp, i * 8))
        if i > 0 { total = total + 1 } // space
        total = total + native_windows_cmdline_arg_len(a)
        i = i + 1
    }

    var buf = malloc(total + 1)
    if buf == 0 { return 0 }

    // Pass 2: write.
    var pos = 0
    i = 0
    while i < argc {
        var a2 = ptr_get(iadd(argvp, i * 8))
        if i > 0 {
            ptr_set_byte(iadd(buf, pos), 32) // space
            pos = pos + 1
        }
        pos = native_windows_cmdline_write_arg(buf, pos, a2)
        i = i + 1
    }
    ptr_set_byte(iadd(buf, pos), 0)
    return buf
}

fn native_windows_envblock_from_envp(envp) {
    // Build a double-NUL-terminated environment block for CreateProcessA.
    // Returns malloc()'d memory that the caller must free.
    //
    // If envp == 0, returns 0 (inherit environment).
    if envp == 0 { return 0 }

    // Compute total bytes including final double NUL.
    var total = 1 // final extra NUL
    var i = 0
    while i < 65536 {
        var ent = ptr_get(iadd(envp, i * 8))
        if ent == 0 { break }
        var l = native_cstr_len(ent)
        // Defensive cap to avoid unbounded allocation.
        if l < 0 || l > 1048576 { return 0 }
        total = total + l + 1
        i = i + 1
    }

    var block = malloc(total + 1)
    if block == 0 { return 0 }

    var pos = 0
    i = 0
    while i < 65536 {
        var ent2 = ptr_get(iadd(envp, i * 8))
        if ent2 == 0 { break }
        var j = 0
        while true {
            var ch = ptr_get_byte(iadd(ent2, j))
            if ch == 0 { break }
            ptr_set_byte(iadd(block, pos), ch)
            pos = pos + 1
            j = j + 1
        }
        // NUL terminator for this entry
        ptr_set_byte(iadd(block, pos), 0)
        pos = pos + 1
        i = i + 1
    }

    // Final double NUL
    ptr_set_byte(iadd(block, pos), 0)
    ptr_set_byte(iadd(block, pos + 1), 0)
    return block
}

fn native_windows_envblock_for_proc_child() {
    // Build an env block for a proc child using the same capsule policy as POSIX execve.
    //
    // Returns malloc()'d memory (or 0 to inherit), caller must free when non-zero.
    if global_get_capsule_mode() != 1 {
        // Non-capsule: inherit the host environment by passing envblock=NULL to CreateProcessA.
        //
        // This keeps `oren_system`/`oren_proc_spawn` robust even when the entry stub envp
        // capture/conversion is still rolling on Windows.
        return 0
    }

    var parent_envp = native_runtime_get_envp_ptr()
    if global_get_proc_inherit_env() == 1 {
        return native_windows_envblock_from_envp(parent_envp)
    }

    var keys = global_get_proc_allow_env_keys_ptr()
    var max_out = 256
    var out = malloc((max_out + 1) * 8)
    if out == 0 { return 0 }
    var oi = 0

    // Mandatory capsule env (kept small and focused).
    var must_capsule = native_envp_get_entry_ptr("OREN_CAPSULE")
    if must_capsule != 0 { oi = native_envp_push_unique(out, oi, max_out, must_capsule) }
    else { oi = native_envp_push_unique(out, oi, max_out, "OREN_CAPSULE=1") }
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_CAP_ALLOW_DOMAINS"))
    // FS enrollment
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_ALLOW_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_ALLOW_READ_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_ALLOW_WRITE_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_MOUNTS"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_MOUNTS_READ"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_MOUNTS_WRITE"))
    // NET enrollment
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_ALLOW_LOOPBACK"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_ALLOW_TCP_CONNECT"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_ALLOW_TCP_LISTEN"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_TCP_CONNECT_MAP"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_TCP_LISTEN_MAP"))
    // PROC enrollment
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_EXEC_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_SYSTEM"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_INHERIT_ENV"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_ENV_KEYS"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_ARGV"))

    // Optional allowlisted keys from parent env.
    if keys != 0 {
        var i = 0
        while i < 4096 && oi < max_out {
            var ent = ptr_get(iadd(parent_envp, i * 8))
            if ent == 0 { break }

            var key_len = 0
            while key_len < 256 {
                var ch = ptr_get_byte(iadd(ent, key_len))
                if ch == 0 { key_len = 0; break }
                if ch == 61 { break } // '='
                key_len = key_len + 1
            }
            if key_len > 0 && key_len < 256 {
                if native_csv_has_key(keys, ent, key_len) {
                    oi = native_envp_push_unique(out, oi, max_out, ent)
                }
            }
            i = i + 1
        }
    }

    ptr_set(out + (oi * 8), 0)
    var block = native_windows_envblock_from_envp(out)
    free(out)
    return block
}

fn native_runtime_get_envp_for_proc_child() {
    // Determine envp for subprocess exec in the child (after fork, before execve).
    //
    // Policy (capsule mode):
    // - If OREN_PROC_INHERIT_ENV=1 => inherit all env.
    // - Else build a filtered env consisting of:
    //     - Mandatory OREN_* capsule controls (so the child cannot "escape capsule" by env filtering)
    //     - Plus keys allowlisted by OREN_PROC_ALLOW_ENV_KEYS (if set).
    //
    // Non-capsule: inherit all env.
    var parent_envp = native_runtime_get_envp_ptr()
    if global_get_capsule_mode() != 1 { return parent_envp }

    if global_get_proc_inherit_env() == 1 { return parent_envp }

    var keys = global_get_proc_allow_env_keys_ptr()

    // Conservative cap; we don't want huge env arrays during bootstrap.
    var max_out = 256
    var out = malloc((max_out + 1) * 8)
    if out == 0 { return 0 }
    var oi = 0

    // --- Mandatory capsule env entries (best-effort) ---
    // Keep this list small and focused: only OREN_* capability and resource enrollment vars.
    // These are NOT secrets; they are the mechanism that prevents child escape.
    var must_capsule = native_envp_get_entry_ptr("OREN_CAPSULE")
    if must_capsule != 0 {
        oi = native_envp_push_unique(out, oi, max_out, must_capsule)
    } else {
        // The parent is in capsule mode, so this should exist, but be robust anyway.
        oi = native_envp_push_unique(out, oi, max_out, "OREN_CAPSULE=1")
    }
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_CAP_ALLOW_DOMAINS"))
    // FS enrollment
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_ALLOW_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_ALLOW_READ_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_ALLOW_WRITE_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_MOUNTS"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_MOUNTS_READ"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_FS_MOUNTS_WRITE"))
    // NET enrollment
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_ALLOW_LOOPBACK"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_ALLOW_TCP_CONNECT"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_ALLOW_TCP_LISTEN"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_TCP_CONNECT_MAP"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_NET_TCP_LISTEN_MAP"))
    // PROC enrollment
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_EXEC_PREFIXES"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_SYSTEM"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_INHERIT_ENV"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_ENV_KEYS"))
    oi = native_envp_push_unique(out, oi, max_out, native_envp_get_entry_ptr("OREN_PROC_ALLOW_ARGV"))

    // --- Optional allowlisted parent env keys ---
    if keys != 0 {
        var i = 0
        while i < 4096 && oi < max_out {
            var ent = ptr_get(iadd(parent_envp, i * 8))
            if ent == 0 { break }

            var key_len = 0
            while key_len < 256 {
                var ch = ptr_get_byte(iadd(ent, key_len))
                if ch == 0 { key_len = 0; break }
                if ch == 61 { break } // '='
                key_len = key_len + 1
            }

            if key_len > 0 && key_len < 256 {
                if native_csv_has_key(keys, ent, key_len) {
                    oi = native_envp_push_unique(out, oi, max_out, ent)
                }
            }
            i = i + 1
        }
    }

    ptr_set(out + (oi * 8), 0)
    return out
}

fn _win_proc_debug_enabled() {
    // Debug helper for the Windows CreateProcessA bring-up path.
    // Enabled only when explicitly set to avoid affecting Tier‑1 fixture output.
    var v = oren_getenv("OREN_DEBUG_WIN_PROC")
    if v == 0 { return false }
    if ptr_get_byte(v) == 0 { return false }
    return true
}

fn _win_proc_debug_dump_cstr(prefix, p, max_bytes) {
    if prefix == 0 { prefix = "" }
    if max_bytes == nil || max_bytes <= 0 { max_bytes = 64 }
    if max_bytes > 256 { max_bytes = 256 }

    print(prefix + "ptr=" + oren_int_to_string(p))
    if p == 0 { return 0 }

    var out = prefix + "bytes="
    var i = 0
    while i < max_bytes {
        var b = ptr_get_byte(iadd(p, i)) & 255
        out = out + oren_int_to_string(b)
        if b == 0 { break }
        if i + 1 < max_bytes { out = out + "," }
        i = i + 1
    }
    print(out)
    return 0
}

@cap.requires(domain="PROC")
fn oren_proc_spawn(path, argv, timeout_ms) {
    // Syscall-first subprocess spawn (no libc, no PATH search).
    //
    // - path: explicit exec path (e.g. "/usr/bin/true")
    // - argv: list of argv entries (including argv0), or [] for default argv0=path
    // - timeout_ms < 0: wait forever
    // - timeout_ms >= 0: poll wait4(WNOHANG) up to timeout_ms iterations (rolling: not wall-clock)
    //
    // Returns wait status (raw), or negative on internal failure, or -60 on timeout.
    native_capsule_require_proc_exec(path)
    if path == 0 { return -1 }

    var argc = 0
    if argv != 0 { argc = oren_list_len(argv) }

    // Ensure argv0 exists.
    var out_argc = argc
    if out_argc < 1 { out_argc = 1 }

    var child_argv = malloc((out_argc + 1) * 8) // argv pointers + NULL
    if child_argv == 0 { return -1 }

    var i = 0
    while i < out_argc {
        var a = 0
        if argc == 0 {
            if i == 0 { a = path }
        } else {
            a = argv[i]
            if i == 0 && a == 0 { a = path }
        }
        // Best-effort validation: require a NUL-terminated string within a cap.
        if native_cstr_len(a) >= 4096 {
            free(child_argv)
            return -1
        }
        ptr_set(child_argv + (i * 8), a)
        i = i + 1
    }
    ptr_set(child_argv + (out_argc * 8), 0)

    // In capsule mode, enforce argv allowlist before forking.
    native_capsule_require_proc_argv(path, child_argv, out_argc)

    // Windows does not support fork/exec; use CreateProcessA-based spawn+wait.
    //
    // Contract: preserve the existing "raw wait status" return convention:
    // - exit_code 0 => status 0
    // - exit_code n => status (n & 0xFF) << 8
    if g_target_os == 3 {
        var cmdline = native_windows_cmdline_from_argvp(child_argv, out_argc)
        if cmdline == 0 {
            free(child_argv)
            return -1
        }
        var envblock = native_windows_envblock_for_proc_child()
        // envblock may be 0 (inherit env), which is valid.

        if _win_proc_debug_enabled() {
            print("WIN_PROC_DEBUG app=" + path)
            _win_proc_debug_dump_cstr("WIN_PROC_DEBUG cmdline_", cmdline, 160)
            print("WIN_PROC_DEBUG envblock_ptr=" + oren_int_to_string(envblock) + " timeout_ms=" + oren_int_to_string(timeout_ms))
        }

        var rc = sys_win_createprocess(path, cmdline, envblock, timeout_ms)
        if _win_proc_debug_enabled() {
            print("WIN_PROC_DEBUG sys_win_createprocess rc=" + oren_int_to_string(rc))
        }
        free(cmdline)
        if envblock != 0 { free(envblock) }
        free(child_argv)
        return rc
    }

    var pid = oren_fork()
    if pid < 0 {
        free(child_argv)
        // Preserve syscall errno style (-errno) to keep failures actionable.
        return pid
    }

    if pid == 0 {
        var envp = native_runtime_get_envp_for_proc_child()
        if envp == 0 { exit(127) }
        sys_execve(path, child_argv, envp)
        exit(127)
    }

    // Parent: record ownership so capsule sys_wait4/sys_kill cannot target arbitrary pids.
    native_capsule_proc_register_pid(pid)

    // Parent: wait4(pid, &status, options, 0)
    free(child_argv)
    var status_ptr = malloc(8)
    if status_ptr == 0 { return -1 }
    ptr_set(status_ptr, 0)

    if timeout_ms < 0 {
        while 1 {
            var wpid = sys_wait4(pid, status_ptr, 0, 0)
            if wpid == pid {
                var status = ptr_get(status_ptr)
                free(status_ptr)
                return status
            }
            if wpid == (0 - 4) { // EINTR
                // Retry a blocking wait when interrupted by a signal.
                continue
            }
            if wpid < 0 {
                free(status_ptr)
                // Preserve syscall errno style (-errno) to keep failures actionable.
                return wpid
            }
        }
    }

    // Poll: wait4(..., WNOHANG=1) until budget exhausted (deterministic; no TIME domain required).
    var remaining = timeout_ms
    while remaining > 0 {
        var wpid2 = sys_wait4(pid, status_ptr, 1, 0) // WNOHANG
        if wpid2 == pid {
            var status2 = ptr_get(status_ptr)
            free(status_ptr)
            return status2
        }
        if wpid2 == (0 - 4) { // EINTR
            // Retry without consuming timeout budget on signal interrupts.
            continue
        }
        if wpid2 < 0 {
            free(status_ptr)
            // Preserve syscall errno style (-errno) to keep failures actionable.
            return wpid2
        }
        remaining = remaining - 1
    }

    // Timeout: kill child and reap to avoid zombies.
    oren_kill(pid, 9) // SIGKILL
    sys_wait4(pid, status_ptr, 0, 0) // best-effort reap
    free(status_ptr)
    return 0 - 60 // ETIMEDOUT (BSD)
}

fn oren_system_timeout(cmd, timeout_ms) {
    // Syscall-first `system(3)` equivalent with an optional timeout.
    //
    // In capsule mode this is intentionally blocked unless explicitly enabled:
    // it executes a shell (/bin/sh -c), which is too powerful to allow by default.
    native_capsule_require_proc_system()

    if cmd == 0 { return -1 }
    if g_target_os == 3 {
        // Windows: use cmd.exe /C <cmd>
        //
        // Rolling robustness:
        // Prefer a stable absolute path over relying on entry-stub env capture on Windows.
        // In some remote/SSH configurations the environment block conversion is still rolling,
        // and using COMSPEC can produce non-deterministic results.
        var comspec = "C:\\Windows\\System32\\cmd.exe"
        var args = [comspec, "/C", cmd]
        return oren_proc_spawn(comspec, args, timeout_ms)
    }

    // POSIX (macOS/Linux): `system` requires a shell. In minimal/container environments
    // `/bin/sh` may not exist, so we do deterministic shell discovery:
    //
    // 1) If `OREN_SYSTEM_SHELL` is set:
    //    - it must be an absolute path
    //    - it must exist and be executable
    //    - if invalid, return `-ENOENT` (do NOT silently fall back)
    // 2) If `SHELL` is set to an absolute, executable path, use it.
    // 3) Try common absolute shells: /bin/sh, /usr/bin/sh, /bin/bash, /usr/bin/bash
    //
    // If no shell is found, return `-ENOENT` so callers can fall back to `oren_proc_spawn(...)`.

    fn _system_shell_is_exec_abs(path) {
        if path == 0 { return 0 }
        // Absolute path only (no PATH search in syscall-first runtime).
        if ptr_get_byte(path) != 47 { return 0 } // '/'
        // X_OK = 1 on POSIX.
        var rc = sys_access(path, 1)
        if rc == 0 { return 1 }
        return 0
    }

    fn _system_find_shell() {
        var override = oren_getenv("OREN_SYSTEM_SHELL")
        if override != 0 {
            if _system_shell_is_exec_abs(override) == 1 { return override }
            // Explicit override is authoritative: invalid override is an error.
            return 0 - 2 // ENOENT
        }

        var sh = oren_getenv("SHELL")
        if _system_shell_is_exec_abs(sh) == 1 { return sh }

        if _system_shell_is_exec_abs("/bin/sh") == 1 { return "/bin/sh" }
        if _system_shell_is_exec_abs("/usr/bin/sh") == 1 { return "/usr/bin/sh" }
        if _system_shell_is_exec_abs("/bin/bash") == 1 { return "/bin/bash" }
        if _system_shell_is_exec_abs("/usr/bin/bash") == 1 { return "/usr/bin/bash" }
        return 0
    }

    var shell = _system_find_shell()
    if shell < 0 { return shell }
    if shell == 0 { return 0 - 2 } // ENOENT

    var args = [shell, "-c", cmd]
    return oren_proc_spawn(shell, args, timeout_ms)
}

fn oren_net_get(url) {
    // Minimal HTTP/1.0 GET for native backend (macOS v0):
    // - Supports: http://<ipv4>[:port][/path]
    // - No TLS, no DNS, no chunked transfer decoding.
    if url == 0 { return 0 }

    // Require "http://"
    var prefix = "http://"
    var pl = oren_string_len(prefix)
    var ul = oren_string_len(url)
    if ul < pl { return 0 }
    var pi = 0
    while pi < pl {
        if ptr_get_byte(url + pi) != ptr_get_byte(prefix + pi) { return 0 }
        pi = pi + 1
    }

    var pos = pl
    // Find '/' for path start
    var slash = -1
    var i = pos
    while i < ul {
        if ptr_get_byte(url + i) == 47 { slash = i; break } // '/'
        i = i + 1
    }
    if slash == -1 { slash = ul }

    // Find ':' for port separator (only within host segment)
    var colon = -1
    i = pos
    while i < slash {
        if ptr_get_byte(url + i) == 58 { colon = i; break } // ':'
        i = i + 1
    }

    var host_end = slash
    if colon != -1 { host_end = colon }
    var host = oren_string_slice(url, pos, host_end)
    if host == 0 { return 0 }

    var port = 80
    if colon != -1 {
        var port_s = oren_string_slice(url, colon + 1, slash)
        var pv = oren_int_from_string(port_s)
        if pv <= 0 { return 0 }
        port = pv
    }

    var path = "/"
    if slash < ul {
        path = oren_string_slice(url, slash, ul)
        if path == 0 { return 0 }
    }

    // Connect (5s timeout)
    var fd = oren_tcp_connect(host, port, 5000)
    if fd < 0 { return 0 }

    // Build request: "GET <path> HTTP/1.0\r\nHost: <host>\r\nConnection: close\r\n\r\n"
    //
    // Prefer language-level string `+` (modern grammar) over manual `string_concat` chains.
    var req = "GET " + path + " HTTP/1.0\r\nHost: " + host + "\r\nConnection: close\r\n\r\n"
    var req_len = oren_string_len(req)
    var wr = oren_tcp_write_from(fd, req, req_len, 5000)
    if wr < 0 {
        oren_tcp_close(fd)
        return 0
    }

    // Read entire response into a growing buffer.
    var cap = 4096
    var used = 0
    var buf = malloc(cap)
    if buf == 0 {
        oren_tcp_close(fd)
        return 0
    }

    while 1 {
        var tmp = malloc(1024)
        if tmp == 0 { break }
        var n = oren_tcp_read_into(fd, tmp, 1024, 5000)
        if n <= 0 {
            free(tmp)
            break
        }

        // Ensure capacity for used+n
        while used + n > cap {
            var new_cap = cap * 2
            if new_cap < used + n { new_cap = used + n }
            var new_buf = malloc(new_cap)
            if new_buf == 0 { break }
            oren_memcpy(new_buf, buf, used)
            free(buf)
            buf = new_buf
            cap = new_cap
        }
        oren_memcpy(buf + used, tmp, n)
        used = used + n
        free(tmp)
    }

    oren_tcp_close(fd)

    // Find header terminator "\r\n\r\n"
    var body_off = 0
    i = 0
    while i + 3 < used {
        if ptr_get_byte(buf + i) == 13 {
            if ptr_get_byte(buf + i + 1) == 10 {
                if ptr_get_byte(buf + i + 2) == 13 {
                    if ptr_get_byte(buf + i + 3) == 10 {
                        body_off = i + 4
                        break
                    }
                }
            }
        }
        i = i + 1
    }

    if body_off < 0 { body_off = 0 }
    if body_off > used { body_off = used }

    var body_len = used - body_off
    var out = malloc(body_len + 1)
    if out == 0 {
        free(buf)
        return 0
    }
    oren_memcpy(out, buf + body_off, body_len)
    ptr_set_byte(out + body_len, 0)
    oren_track_alloc(out, body_len + 1, 1)
    free(buf)
    return out
}

fn free(ptr) {
    if ptr == 0 { return 0 }
    if oren_globals() == 0 { return 0 }
    acquire_lock()

    // Deterministic/manual-friendly free:
    // - remove from allocs list immediately
    // - push into free_blocks so future malloc() can reuse the block
    //
    // This must work even when GC scanning is disabled (`--no-gc` / OREN_NO_GC=1).
    var prev = 0
    var cur = global_get_allocs()
    while cur != 0 {
        var next = ptr_get(iadd(cur, 32))
        if ptr_get(cur) == ptr {
            if prev == 0 {
                global_set_allocs(next)
            } else {
                ptr_set(iadd(prev, 32), next)
            }
            var kind = ptr_get(iadd(cur, 16))
            ptr_set(iadd(cur, 24), 0) // clear freed/mark flags

            if kind == 9 {
                // RAW_MMAP: return to OS now; do not keep for reuse.
                var base = ptr - raw_hdr_size()
                if ptr_get(base + 0) == raw_magic() {
                    var total = ptr_get(base + 8)
                    var backend = ptr_get(base + 16)
                    if backend == 1 && total > 0 {
                        sys_munmap(base, total)
                    }
                }
                // Reuse tracking node storage.
                ptr_set(cur, 0)
                ptr_set(iadd(cur, 8), 40)
                ptr_set(iadd(cur, 16), 0)
                ptr_set(iadd(cur, 24), 0)
                ptr_set(iadd(cur, 32), global_get_free_nodes())
                global_set_free_nodes(cur)
            } else {
                ptr_set(iadd(cur, 32), global_get_free_blocks())
                global_set_free_blocks(cur)
            }
            release_lock()
            return 0
        }
        prev = cur
        cur = next
    }

    release_lock()
    return 0
}

fn native_fd_set_nonblock(fd0) {
    var fl = sys_fcntl_getfl(fd0)
    if fl < 0 { return fl }
    var nb = fl & OREN_O_NONBLOCK
    if nb != 0 { return 0 }
    return sys_fcntl_setfl(fd0, fl | OREN_O_NONBLOCK)
}

fn native_fd_set_blocking(fd0) {
    var fl = sys_fcntl_getfl(fd0)
    if fl < 0 { return fl }
    var nb = fl & OREN_O_NONBLOCK
    if nb == 0 { return 0 }
    // Clear the NONBLOCK bit without relying on bitwise-not (keep semantics stable in rolling mode).
    var fl2 = fl ^ OREN_O_NONBLOCK
    return sys_fcntl_setfl(fd0, fl2)
}

fn oren_join_timeout(handle, timeout_ms) {
    if handle == 0 { return 0 }

    // Windows Tier‑1: `spawn` is lowered to CreateThread(...) by the x64 native backend.
    // Handle layout (opaque to user code):
    //   [0]  thread_handle (HANDLE, u64)
    //   [8]  result_ptr    (u64*)
    //   [16] arg_ptr       (spawn arg struct ptr; freed by join)
    //
    // Thread arg struct layout:
    //   [0]  fn_obj
    //   [8]  args_list
    //   [16] result_ptr
    //   [24] auto_free (u64; set by join_timeout detach)
    //
    // NOTE: This is intentionally separate from POSIX fork+pipe semantics; the goal is
    // Tier‑1 correctness first, then backend unification.
    if g_target_os == 3 {
        var h = ptr_get(handle)
        var result_ptr = ptr_get(handle + 8)
        var arg_ptr = ptr_get(handle + 16)

        if h == 0 {
            if result_ptr != 0 { free(result_ptr) }
            if arg_ptr != 0 { free(arg_ptr) }
            free(handle)
            return -1
        }

        // Wait model (Windows):
        // - timeout_ms < 0 => wait forever (blocking).
        // - timeout_ms == 0 => non-blocking probe; on timeout keep handle alive.
        // - timeout_ms > 0 => wait up to N ms; on timeout detach safely (no TerminateThread).
        if timeout_ms == 0 {
            var rc0 = sys_win_wait_single_object(h, 0)
            if rc0 == 0 {
                // Completed: fall through to result extraction + cleanup below.
            } else {
                if rc0 == (0 - 60) { return 0 - 60 }
                // Unexpected failure: close + cleanup to avoid leaking handles/allocations.
                sys_win_close_handle(h)
                if result_ptr != 0 { free(result_ptr) }
                if arg_ptr != 0 { free(arg_ptr) }
                free(handle)
                return rc0
            }
        } else if timeout_ms < 0 {
            var rcw = sys_win_wait_single_object(h, -1)
            if rcw != 0 {
                sys_win_close_handle(h)
                if result_ptr != 0 { free(result_ptr) }
                if arg_ptr != 0 { free(arg_ptr) }
                free(handle)
                return rcw
            }
        } else {
            var rcw2 = sys_win_wait_single_object(h, timeout_ms)
            if rcw2 != 0 {
                if rcw2 == (0 - 60) {
                    // Timeout: detach instead of TerminateThread (unsafe). The running thread will
                    // free its own arg/result buffers if we set auto_free=1 in the arg struct.
                    if arg_ptr != 0 { ptr_set(arg_ptr + 24, 1) }
                    sys_win_close_handle(h)
                    free(handle)
                    return 0 - 60
                }
                // Unexpected failure: close + cleanup to avoid leaking handles/allocations.
                sys_win_close_handle(h)
                if result_ptr != 0 { free(result_ptr) }
                if arg_ptr != 0 { free(arg_ptr) }
                free(handle)
                return rcw2
            }
        }

        var ret_val = 0
        if result_ptr != 0 { ret_val = ptr_get(result_ptr) }
        sys_win_close_handle(h)
        if result_ptr != 0 { free(result_ptr) }
        if arg_ptr != 0 { free(arg_ptr) }
        free(handle)
        return ret_val
    }

    // Spawn handle layout (native backend, macOS v0 fork+pipe):
    //   [0]  pid (u64)
    //   [8]  read_fd (u64)
    //   [16] got (u64)        - bytes read into inline result buffer
    //   [24] result_buf (u64) - inline 8-byte result buffer

    // IMPORTANT: use `iadd` for raw pointer arithmetic.
    //
    // The native runtime implements `+` via `oren_add` (string concat when both operands are tracked strings),
    // which is correct for language semantics but is not appropriate for low-level pointer offsets in the
    // syscall-first runtime.
    //
    // Using `iadd` here keeps join semantics deterministic and avoids accidental container/type probing.
    var pid = ptr_get(handle)
    var fd = ptr_get(iadd(handle, 8))
    var got_slot = iadd(handle, 16)
    var got = ptr_get(got_slot)
    var res_buf = iadd(handle, 24)

    if fd <= 0 {
        // No readable pipe => treat as failed join.
        free(handle)
        return -1
    }

    // Join semantics (rolling, syscall-first, no libc poll/select dependency):
    // - `timeout_ms < 0`: wait forever; reads until 8 bytes available.
    // - `timeout_ms == 0`: non-blocking probe; on "not ready" return -60 (ETIMEDOUT) and keep handle alive.
    // - `timeout_ms > 0`: wait up to N ms (real-time budget via nanosleep); on timeout kill+reap child to avoid zombies.
    //
    // Completion is defined as "we have read exactly 8 bytes (u64 result) from the pipe".
    //
    // NOTE: Unlike the old implementation, we do NOT call wait4(WNOHANG) for probing because that
    // would reap the child and make later `oren_join(handle)` unreliable. Instead, we probe the pipe.
    if timeout_ms == 0 {
        var nb = native_fd_set_nonblock(fd)
        if nb < 0 {
            sys_close(fd)
            sys_wait4(pid, 0, 0, 0) // best-effort reap
            free(handle)
            return nb
        }
        if got < 8 {
            var n0 = sys_read(fd, iadd(res_buf, got), 8 - got)
            // EAGAIN/EWOULDBLOCK: macOS=35, Linux=11
            if n0 == 0 - 35 || n0 == 0 - 11 { return 0 - 60 }
            if n0 < 0 {
                sys_close(fd)
                sys_wait4(pid, 0, 0, 0) // best-effort reap
                free(handle)
                return n0
            }
            if n0 == 0 { return 0 - 60 } // EOF or not ready => treat as not done for probe
            got = got + n0
            ptr_set(got_slot, got)
        }
        if got < 8 { return 0 - 60 }
        // Fall through to cleanup below.
    } else if timeout_ms < 0 {
        // Ensure blocking behavior so we don't spin if an earlier probe set O_NONBLOCK.
        native_fd_set_blocking(fd)
        while got < 8 {
            var n1 = sys_read(fd, iadd(res_buf, got), 8 - got)
            if n1 == 0 { break } // EOF
            if n1 < 0 {
                // If non-blocking leaks through, treat EAGAIN as "wait a bit".
                if n1 == 0 - 35 || n1 == 0 - 11 {
                    sys_nanosleep(1000000) // 1ms
                    continue
                }
                sys_close(fd)
                sys_wait4(pid, 0, 0, 0) // best-effort reap
                free(handle)
                return n1
            }
            got = got + n1
            ptr_set(got_slot, got)
        }
        if got < 8 {
            sys_close(fd)
            sys_wait4(pid, 0, 0, 0)
            free(handle)
            return -1
        }
        // Fall through to cleanup below.
    } else {
        var remaining = timeout_ms
        var nb2 = native_fd_set_nonblock(fd)
        if nb2 < 0 {
            sys_close(fd)
            sys_wait4(pid, 0, 0, 0)
            free(handle)
            return nb2
        }
        while remaining > 0 {
            if got < 8 {
                var n2 = sys_read(fd, iadd(res_buf, got), 8 - got)
                if n2 > 0 {
                    got = got + n2
                    ptr_set(got_slot, got)
                } else if n2 < 0 {
                    if n2 != 0 - 35 && n2 != 0 - 11 {
                        sys_close(fd)
                        sys_wait4(pid, 0, 0, 0)
                        free(handle)
                        return n2
                    }
                }
            }
            if got >= 8 { break }
            sys_nanosleep(1000000) // 1ms
            remaining = remaining - 1
        }
        if got < 8 {
            // Timeout: kill child and reap to avoid zombies.
            oren_kill(pid, 9) // SIGKILL
            sys_wait4(pid, 0, 0, 0) // best-effort reap
            sys_close(fd)
            free(handle)
            return 0 - 60 // ETIMEDOUT (BSD)
        }
        // Fall through to cleanup below.
    }

    sys_close(fd)
    // Reap child (best-effort).
    sys_wait4(pid, 0, 0, 0)
    var ret_val = ptr_get(res_buf)
    free(handle)
    return ret_val
}

fn oren_join(handle) {
    return oren_join_timeout(handle, -1)
}

// Probe whether a `spawn` handle has completed without consuming the handle.
//
// For the POSIX v0 fork+pipe substrate, we treat "done" as "the 8-byte result is available on the pipe".
// This avoids `wait4(WNOHANG)` probes, which would reap the child and make later `oren_join(handle)` unreliable.
fn oren_is_done(handle) {
    if handle == 0 { return false }

    // Windows Tier‑1 (CreateThread): probe via WaitForSingleObject(0).
    if g_target_os == 3 {
        var h = ptr_get(handle)
        if h == 0 { return false }
        var rc = sys_win_wait_single_object(h, 0)
        if rc == 0 { return true }
        return false
    }

    var got = ptr_get(iadd(handle, 16))
    if got >= 8 { return true }

    var fd = ptr_get(iadd(handle, 8))
    if fd <= 0 { return false }

    // Best-effort non-blocking read into inline buffer.
    var fl = sys_fcntl_getfl(fd)
    if fl >= 0 {
        var nb = fl & OREN_O_NONBLOCK
        if nb == 0 {
            sys_fcntl_setfl(fd, fl | OREN_O_NONBLOCK)
        }
    }

    var n = sys_read(fd, iadd(iadd(handle, 24), got), 8 - got)
    if n > 0 {
        got = got + n
        ptr_set(iadd(handle, 16), got)
    } else if n < 0 {
        // EAGAIN/EWOULDBLOCK: macOS=35, Linux=11
        if n == 0 - 35 || n == 0 - 11 { return false }
        // Unexpected read failure: treat as not done (caller will hit join error path later).
        return false
    }

    return got >= 8
}
