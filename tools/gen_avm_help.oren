import ap "../lib/std/argparse.oren"

fn c_escape_line(s) {
    // Escape a single line for a C string literal.
    if s == nil { return "" }
    var out = ""
    var i = 0
    while i < oren_string_len(s) {
        var c = oren_string_slice(s, i, i + 1)
        if c == "\\" { out = out + "\\\\" }
        else {
            if c == "\"" { out = out + "\\\"" }
            else { out = out + c }
        }
        i = i + 1
    }
    return out
}

fn build_avm_cli_spec() {
    var p = ap.new_parser("avm", "AVM bytecode runner (deterministic, capability-governed)")
    var r = ap.root(p)

    // Disasm / inspect
    ap.cmd_flag(r, "--disasm", nil, "Disassemble bytecode and exit")
    ap.cmd_flag(r, "--disasm-consts", nil, "Disassemble including constants and exit")
    ap.cmd_flag(r, "--disasm-json", nil, "Disassemble to JSON and exit")
    ap.cmd_flag(r, "--disasm-consts-json", nil, "Disassemble incl. constants to JSON and exit")
    ap.cmd_flag(r, "--inspect", nil, "Inspect .obc header/policy/job without executing and exit")
    ap.cmd_flag(r, "--inspect-json", nil, "Inspect (JSON) without executing and exit")

    // Trace / debug
    ap.cmd_flag(r, "--trace", nil, "Print execution trace")
    ap.cmd_option(r, "--trace-limit", nil, "int", 0, "Limit trace lines (0 = no limit)")
    ap.cmd_option(r, "--breakpc", nil, "int", 0, "Break when PC reaches N")
    ap.cmd_flag(r, "--print-stack", nil, "Print VM stack at exit")
    ap.cmd_flag(r, "--print-pause-json", nil, "If paused, print pause JSON to stdout")

    // Snapshot / resume
    ap.cmd_option(r, "--snapshot-in", nil, "string", "", "Resume from snapshot file")
    ap.cmd_option(r, "--snapshot-out", nil, "string", "", "Write snapshot on pause")
    ap.cmd_option(r, "--step-limit", nil, "int", 0, "Pause after N executed steps (0 = unlimited)")

    // Budgets / timeouts
    ap.cmd_option(r, "--timeout-ms", nil, "int", 0, "Wall-time deadline in milliseconds (0 = none)")

    // Repeat / hashes / logs
    ap.cmd_option(r, "--repeat", nil, "int", 1, "Run program N times (for stability checks)")
    ap.cmd_flag(r, "--print-state-hash", nil, "Print state hash at exit")
    ap.cmd_flag(r, "--print-result-hash", nil, "Print result hash at exit")
    ap.cmd_flag(r, "--print-trace-hash", nil, "Print trace hash at exit")
    ap.cmd_flag(r, "--print-trace-bytes-hex", nil, "Print trace bytes as hex at exit")
    ap.cmd_flag(r, "--print-record-log-hex", nil, "Print record/replay log as hex at exit")
    ap.cmd_flag(r, "--print-mem-stats", nil, "Print VM memory stats at exit")
    ap.cmd_flag(r, "--print-rss", nil, "Print resident set size (host) at exit")
    ap.cmd_flag(r, "--print-run-json", nil, "Print run result JSON at exit")

    // Policy/job scans
    ap.cmd_flag(r, "--print-policy", nil, "Print policy section and exit")
    ap.cmd_flag(r, "--print-policy-json", nil, "Print policy section (JSON) and exit")
    ap.cmd_flag(r, "--print-job", nil, "Print job section and exit")
    ap.cmd_flag(r, "--print-job-json", nil, "Print job section (JSON) and exit")

    // Verification / capsule modes
    ap.cmd_flag(r, "--verify-strict", nil, "Reject unknown fields/values in .obc")
    ap.cmd_flag(r, "--capsule", nil, "Alias for: strict, deny-by-default (capability safe defaults)")
    ap.cmd_flag(r, "--untrusted", nil, "Alias for: strict, deny-by-default (capability safe defaults)")

    // Capability policy toggles
    ap.cmd_flag(r, "--deny-by-default", nil, "Deny all domains unless allowlisted")
    ap.cmd_option(r, "--allow-domains", nil, "string", "", "CSV of allowed domain ids (e.g. 0,1,6)")
    ap.cmd_option(r, "--fs-allow-prefixes", nil, "string", "", "CSV of allowed FS path prefixes")

    // Virtual backends
    ap.cmd_option(r, "--fs-backend", nil, "string", "host", "FS backend: host|vfs")
    ap.cmd_option(r, "--proc-backend", nil, "string", "host", "PROC backend: host|vproc")
    ap.cmd_option(r, "--proc-exit-code", nil, "int", 0, "PROC fixture: forced exit code")
    ap.cmd_option(r, "--proc-fixtures-hex", nil, "string", "", "PROC fixtures (hex)")
    ap.cmd_option(r, "--net-backend", nil, "string", "host", "NET backend: host|vnet")
    ap.cmd_option(r, "--net-fixtures-hex", nil, "string", "", "NET fixtures (hex)")

    // Args
    ap.cmd_positional(r, "file.obc", true, "Input bytecode file")
    return p
}

fn main() {
    var p = build_avm_cli_spec()
    var lines = ap.render_help_lines(p, nil)
    oren_list_push(lines, "Notes:")
    oren_list_push(lines, "  - Program args are passed after `--`, e.g. `avm prog.obc -- a b c`.")
    oren_list_push(lines, "  - Gas budget is controlled via env `AVM_GAS`.")

    print("/* AUTO-GENERATED by tools/gen_avm_help.oren")
    print(" * Source of truth: tools/gen_avm_help.oren + lib/std/argparse.oren")
    print(" */")
    print("#ifndef AVM_HELP_INC")
    print("#define AVM_HELP_INC")
    print("")
    print("static const char* AVM_HELP_TEXT =")
    var i = 0
    while i < oren_list_len(lines) {
        print("\"" + c_escape_line(lines[i]) + "\\n\"")
        i = i + 1
    }
    print(";")
    print("")
    print("#endif")
}
