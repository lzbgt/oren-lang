fn main() {
    print("pipe/fork/listen-fn: start")
    var ch = oren_pipe()
    var r = oren_list_get(ch, 0)
    var w = oren_list_get(ch, 1)

    var pid = sys_fork()
    if pid < 0 { exit(820) }
    if pid == 0 {
        sys_close(r)
        var fd = oren_tcp_listen_local(40000)
        var out = malloc(8)
        if out == 0 { exit(821) }
        ptr_set(out, fd)
        sys_write(w, out, 8)
        sys_close(w)
        if fd < 0 { exit(822) }
        oren_tcp_close(fd)
        exit(0)
    }

    sys_close(w)
    var buf = malloc(8); if buf == 0 { exit(823) }
    var n = sys_read(r, buf, 8)
    if n != 8 { exit(824) }
    var v = ptr_get(buf)
    sys_close(r)
    var st = malloc(8); ptr_set(st, 0)
    sys_wait4(pid, st, 0, 0)
    if v < 0 { exit(825) }
    print("pipe/fork/listen-fn: OK")
}

main()

