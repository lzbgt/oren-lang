fn main() {
    print("parent: start")
    var pid = oren_fork()
    if pid < 0 { exit(720) }
    if pid == 0 {
        print("child: start")
        var fd = sys_socket(2, 1, 6)
        if fd < 0 { exit(721) }
        print("child: socket ok")
        var p = malloc(8)
        if p == 0 { exit(722) }
        ptr_set(p, 123)
        print("child: malloc ok")
        sys_close(fd)
        exit(0)
    }
    var st = malloc(8); ptr_set(st, 0)
    sys_wait4(pid, st, 0, 0)
    print("parent: done")
}

main()

