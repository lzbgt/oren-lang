fn main() {
    // AVM gas/time benchmark.
    //
    // This program is intentionally infinite; the host runs it with AVM_GAS=...
    // to stop it safely and measure throughput.
    //
    // Keep it "pure compute" (no FS/NET/PROC/TIME/RNG) so it measures the core
    // interpreter dispatch + basic arithmetic/control flow.
    var x = 0
    var y = 1
    while 1 {
        // A mix of ops to avoid an empty loop being "too cheap" relative to
        // typical bytecode workloads.
        x = x + y
        y = y + 1
        if y > 1000000 {
            y = 1
        }
        if x > 2000000000 {
            x = 0
        }
    }
}

main()
