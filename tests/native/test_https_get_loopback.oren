import http "std:net/http"
import tcp "std:net/tcp"
import tls "std:net/tls"
import base64 "std:encoding/base64"
import fixture "./fixture_tls_p12.oren"

fn _cstr_from_string(s) {
    if s == nil { s = "" }
    var n = oren_string_len(s)
    if n < 0 { n = 0 }
    if n > 128 { n = 128 }
    var p = malloc(n + 1)
    if p == 0 { return 0 }
    var i = 0
    while i < n {
        ptr_set_byte(p + i, oren_string_byte_at_unchecked(s, i) & 255)
        i = i + 1
    }
    ptr_set_byte(p + n, 0)
    return p
}

fn _str_eq_bytes(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _cstr_lit_server() {
    // "server\0"
    var p = malloc(7)
    if p == 0 { return 0 }
    ptr_set_byte(p + 0, 115)
    ptr_set_byte(p + 1, 101)
    ptr_set_byte(p + 2, 114)
    ptr_set_byte(p + 3, 118)
    ptr_set_byte(p + 4, 101)
    ptr_set_byte(p + 5, 114)
    ptr_set_byte(p + 6, 0)
    return p
}

fn u16be_at(p, off) {
    var hi = ptr_get_byte(p + off) & 255
    var lo = ptr_get_byte(p + off + 1) & 255
    return (hi << 8) | lo
}

fn _env_truthy(name) {
    var p = oren_getenv(name)
    if p == 0 { return 0 }
    var b = ptr_get_byte(p)
    if b == 0 { return 0 }
    if b == 48 { return 0 } // '0'
    return 1
}

fn _ensure_workers_for_spawned_servers(test_name) {
    // `spawn` prefers in-process green tasks on Tier‑1 (including Windows).
    // These loopback fixtures run servers concurrently with blocking client operations,
    // so enable worker mode up front.
    if _env_truthy("OREN_NO_GREEN") == 1 { return 0 }
    var rcw = oren_green_start_workers(1)
    if rcw != 0 {
        print(test_name + ": FAIL cannot start green workers rc=" + oren_int_to_string(rcw))
        exit(109)
    }
    return 0
}

fn _find_header_end(buf, used) {
    // Return index after "\r\n\r\n", or 0 if not found.
    if buf == 0 { return 0 }
    if used < 4 { return 0 }
    var i = 0
    while i + 3 < used {
        if (ptr_get_byte(buf + i) & 255) == 13 &&
           (ptr_get_byte(buf + i + 1) & 255) == 10 &&
           (ptr_get_byte(buf + i + 2) & 255) == 13 &&
           (ptr_get_byte(buf + i + 3) & 255) == 10 {
            return i + 4
        }
        i = i + 1
    }
    return 0
}

@cfg(not_os="macos,linux,windows")
fn main() {
    // HTTPS/TLS provider bring-up starts on macOS; other Tier‑1 OS providers are tracked in docs/NET_TLS.md.
    exit(0)
}

fn server_impl(listen_fd, pfx_b64) {
    var pkcs12_bytes = base64.decode_bytes(pfx_b64)
    if oren_is_err(pkcs12_bytes) { return 101 }
    var n = oren_buf_len(pkcs12_bytes)
    if oren_is_err(n) || n != fixture.pkcs12_len() { return 102 }

    var fd = tcp.accept(listen_fd, 5000)
    if fd < 0 { return 11 }
    var r = tls.wrap_server_pkcs12(fd, 5000, pkcs12_bytes, fixture.passphrase(), nil)
    if oren_map_get_str(r, "ok") != 1 {
        var errv = oren_map_get_str(r, "err")
        if errv != 0 { print("https_loopback: server wrap FAIL: " + oren_intern_cstr(errv)) }
        return 12
    }
    var conn = oren_map_get_str(r, "conn")
    if conn == 0 { return 13 }

    // Read until the end of the HTTP header (best-effort).
    var cap = 8192
    var buf = malloc(cap)
    if buf == 0 { tls.close(conn); return 14 }
    var tmp = malloc(1024)
    if tmp == 0 { free(buf); tls.close(conn); return 15 }
    var used = 0
    var hdr_end = 0
    while used < cap && hdr_end == 0 {
        var rn = tls.read_into(conn, tmp, 1024, 5000)
        if rn <= 0 { break }
        if used + rn > cap { break }
        oren_memcpy(buf + used, tmp, rn)
        used = used + rn
        hdr_end = _find_header_end(buf, used)
    }
    free(tmp)
    free(buf)

    // Minimal HTTP response.
    var body = "HELLO"
    var resp = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\n" + body
    var wr = tls.write_from(conn, resp, oren_string_len(resp), 5000)
    free(resp)
    tls.close(conn)
    if wr < 0 { return 16 }
    return 0
}

@cfg(os="macos,linux,windows")
fn server_main(listen_fd, pfx_b64) {
    // Portable spawn entrypoint: return value is carried to the joiner across OS.
    // Do not call `exit(...)` here (Windows spawn is thread-based).
    return server_impl(listen_fd, pfx_b64)
}

@cfg(os="macos,linux")
fn main_server() {
    var args = oren_args()
    if args == nil || oren_list_len(args) < 3 { exit(60) }
    if _str_eq_bytes(args[1], "server") != true { exit(61) }
    var listen_fd = oren_int_from_string(args[2])
    if listen_fd < 0 { exit(62) }
    exit(server_main(listen_fd, fixture.pkcs12_b64()))
}

@cfg(os="linux")
fn main_client() {
    var expected_leaf_sha256_hex = fixture.leaf_sha256_hex()

    // Bind ephemeral loopback port.
    var listen_fd = oren_tcp_listen_local(0)
    if listen_fd < 0 { exit(3) }

    // getsockname to find the bound port.
    var sa = malloc(32)
    if sa == 0 { exit(4) }
    var lenp = malloc(8)
    if lenp == 0 { exit(5) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { exit(6) }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { exit(7) }

    // Linux correctness: the TLS provider is OpenSSL-based and fork-safe; run server in child without exec.
    // Keep `listen_fd` open in the parent until after the client request to avoid any fork/clone FD-table quirks.
    var pid = sys_fork()
    if pid < 0 { exit(75) }
    if pid == 0 {
        exit(server_main(listen_fd, fixture.pkcs12_b64()))
    }

    var url = "https://127.0.0.1:" + oren_int_to_string(port) + "/"
    // Exercise ALPN client offer plumbing (provider may ignore it). Even if "h2" is offered,
    // this loopback server only speaks HTTP/1.1, so negotiation should fall back cleanly.
    var tls_opts = {"insecure_skip_verify": 1, "pin_cert_sha256_hex": expected_leaf_sha256_hex, "server_name": "oren.test", "alpn": ["h2", "http/1.1"]}
    var rr = http.get_response_opts(url, 5000, {"tls": tls_opts})
    free(url)

    var okv = oren_map_get_str(rr, "ok")
    if okv != 1 {
        var errv = oren_map_get_str(rr, "err")
        if errv != 0 { print("https_loopback: FAIL: " + oren_intern_cstr(errv)) }
        exit(8)
    }
    if oren_map_get_str(rr, "status") != 200 {
        http.response_free(rr)
        exit(9)
    }
    var body = oren_map_get_str(rr, "body")
    if body == 0 || _str_eq_bytes(body, "HELLO") != true {
        http.response_free(rr)
        exit(10)
    }
    http.response_free(rr)

    var status_ptr = malloc(8)
    if status_ptr == 0 { exit(40) }
    ptr_set(status_ptr, 0)
    var wpid = sys_wait4(pid, status_ptr, 0, 0)
    if wpid != pid { exit(41) }
    var status = ptr_get(status_ptr)
    free(status_ptr)
    if status != 0 { exit(42) }

    tcp.close(listen_fd)
    exit(0)
}

@cfg(os="macos")
fn main_client() {
    var expected_leaf_sha256_hex = fixture.leaf_sha256_hex()

    // Bind ephemeral loopback port.
    var listen_fd = oren_tcp_listen_local(0)
    if listen_fd < 0 { exit(3) }

    // For fork+exec server mode we must ensure the listening fd survives exec.
    // On some platforms `listen_local` may set CLOEXEC; duplicate it with plain F_DUPFD.
    var exec_fd = listen_fd
    var dfd = sys_fcntl(listen_fd, FCNTL_F_DUPFD, 0)
    if dfd >= 0 { exec_fd = dfd }

    // getsockname to find the bound port.
    var sa = malloc(32)
    if sa == 0 { exit(4) }
    var lenp = malloc(8)
    if lenp == 0 { exit(5) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { exit(6) }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { exit(7) }

    var pid = oren_fork()
    if pid < 0 { exit(75) }
    if pid == 0 {
        // Darwin correctness: avoid post-fork CoreFoundation/Security; exec a fresh process.
        var argvp0 = global_get_argv()
        if argvp0 == 0 { exit(70) }
        var self_path = ptr_get(argvp0 + 0)
        if self_path == 0 { exit(71) }

        var role_cstr = _cstr_lit_server()
        if role_cstr == 0 { exit(72) }
        var fd_cstr = _cstr_from_string(oren_int_to_string(exec_fd))
        if fd_cstr == 0 { exit(73) }
        var argvp = malloc(4 * 8)
        if argvp == 0 { exit(74) }
        ptr_set(argvp + 0, self_path)
        ptr_set(argvp + 8, role_cstr)
        ptr_set(argvp + 16, fd_cstr)
        ptr_set(argvp + 24, 0)

        sys_execve(self_path, argvp, global_get_envp())
        exit(127)
    }

    tcp.close(listen_fd)
    if exec_fd != listen_fd { tcp.close(exec_fd) }

    var url = "https://127.0.0.1:" + oren_int_to_string(port) + "/"
    // Exercise ALPN client offer plumbing (provider may ignore it).
    var tls_opts = {"insecure_skip_verify": 1, "pin_cert_sha256_hex": expected_leaf_sha256_hex, "server_name": "oren.test", "alpn": ["h2", "http/1.1"]}
    var rr = http.get_response_opts(url, 5000, {"tls": tls_opts})
    free(url)

    var okv = oren_map_get_str(rr, "ok")
    if okv != 1 {
        var errv = oren_map_get_str(rr, "err")
        if errv != 0 { print("https_loopback: FAIL: " + oren_intern_cstr(errv)) }
        exit(8)
    }
    if oren_map_get_str(rr, "status") != 200 {
        http.response_free(rr)
        exit(9)
    }
    var body = oren_map_get_str(rr, "body")
    if body == 0 || _str_eq_bytes(body, "HELLO") != true {
        http.response_free(rr)
        exit(10)
    }
    http.response_free(rr)

    var status_ptr = malloc(8)
    if status_ptr == 0 { exit(40) }
    ptr_set(status_ptr, 0)
    var wpid = sys_wait4(pid, status_ptr, 0, 0)
    if wpid != pid { exit(41) }
    var status = ptr_get(status_ptr)
    free(status_ptr)
    if status != 0 { exit(42) }
    exit(0)
}

@cfg(os="windows")
fn main_client() {
    var expected_leaf_sha256_hex = fixture.leaf_sha256_hex()

    // Bind ephemeral loopback port.
    var listen_fd = oren_tcp_listen_local(0)
    if listen_fd < 0 { exit(3) }

    // getsockname to find the bound port.
    var sa = malloc(32)
    if sa == 0 { exit(4) }
    var lenp = malloc(8)
    if lenp == 0 { exit(5) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { exit(6) }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { exit(7) }

    _ensure_workers_for_spawned_servers("https_loopback")

    // Windows spawn is thread-based; run the HTTPS server inline without fork/exec.
    var h = spawn server_main(listen_fd, fixture.pkcs12_b64())

    var url = "https://127.0.0.1:" + oren_int_to_string(port) + "/"
    // Exercise ALPN client offer plumbing (provider may ignore it).
    var tls_opts = {"insecure_skip_verify": 1, "pin_cert_sha256_hex": expected_leaf_sha256_hex, "server_name": "oren.test", "alpn": ["h2", "http/1.1"]}
    var rr = http.get_response_opts(url, 5000, {"tls": tls_opts})
    free(url)

    var okv = oren_map_get_str(rr, "ok")
    if okv != 1 {
        var errv = oren_map_get_str(rr, "err")
        if errv != 0 { print("https_loopback: FAIL: " + oren_intern_cstr(errv)) }
        oren_join_timeout(h, 5000)
        exit(8)
    }
    if oren_map_get_str(rr, "status") != 200 {
        http.response_free(rr)
        oren_join_timeout(h, 5000)
        exit(9)
    }
    var body = oren_map_get_str(rr, "body")
    if body == 0 || _str_eq_bytes(body, "HELLO") != true {
        http.response_free(rr)
        oren_join_timeout(h, 5000)
        exit(10)
    }
    http.response_free(rr)

    var sr = oren_join_timeout(h, 5000)
    if sr != 0 { exit(42) }
    tcp.close(listen_fd)
    exit(0)
}

@cfg(os="macos,linux")
fn main() {
    var args = oren_args()
    if args != nil && oren_list_len(args) >= 2 && _str_eq_bytes(args[1], "server") == true {
        return main_server()
    }
    return main_client()
}

@cfg(os="windows")
fn main() { return main_client() }
