import json "../../lib/std/json.oren"

fn fail(code) {
    print("native smoke suite FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    fail(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

fn assert_streq(a, b, code) {
    // String equality in v0 can be pointer-based; use strcmp for content equality.
    if strcmp(a, b) == 0 { return 0 }
    fail(code)
}

fn sum_rec(n) {
    if n <= 0 { return 0 }
    return n + sum_rec(n - 1)
}

fn add(a, b) { return a + b }

fn worker(x) { return x }

fn main() {
    // --- core arithmetic / bool / bit ops ---
    assert_eq(add(2, 3), 5, 10)
    assert_true(true, 11)
    assert_true(!false, 12)
    assert_eq((1 | 2), 3, 13)
    assert_eq((5 ^ 1), 4, 14)
    assert_eq((1 << 5), 32, 15)
    assert_eq((32 >> 5), 1, 16)

    // --- recursion (stack + call discipline) ---
    // sum 1..2000 = 2000*2001/2 = 2001000
    assert_eq(sum_rec(2000), 2001000, 20)

    // --- lists + for-in + break/continue ---
    var xs = [1, 2, 3, 4]
    xs[1] = 20
    assert_eq(xs[1], 20, 30)

    var s = 0
    for x in xs {
        if x == 20 { continue }
        s = s + x
    }
    assert_eq(s, 1 + 3 + 4, 31)

    // --- deterministic map iteration order (keys) ---
    var m = {"b": 1, "a": 2}
    var ks = []
    for k in m {
        oren_list_push(ks, k)
    }
    assert_eq(oren_list_len(ks), 2, 40)
    assert_streq(ks[0], "a", 41)
    assert_streq(ks[1], "b", 42)

    // --- string char_at must be portable across backends ---
    // It returns a 1-byte string (not an int codepoint).
    assert_streq(oren_string_char_at("abc", 0), "a", 43)
    assert_streq(oren_string_char_at("abc", 2), "c", 44)

    // --- std/json (portable, explicit JsonValue) ---
    var jr = json.decode("{\"b\":2,\"a\":1,\"s\":\"x\\\\n\\\"y\"}")
    assert_eq(jr["ok"], 1, 45)
    var jout = json.encode(jr["v"])
    // Debug-on-fail (native backend has no robust string concat with literals yet).
    if strcmp(jout, "{\"a\":1,\"b\":2,\"s\":\"x\\\\n\\\"y\"}") != 0 {
        print("json encode mismatch; got:")
        print(jout)
        print("expected:")
        print("{\"a\":1,\"b\":2,\"s\":\"x\\\\n\\\"y\"}")
        fail(46)
    }

    // --- function values + lambdas + capture-by-value ---
    var f = add
    assert_eq(f(10, 1), 11, 50)

    var xcap = 10
    var g = |y| xcap + y
    xcap = 999 // capture-by-value check (g should still see 10)
    assert_eq(g(1), 11, 51)

    // spawn a callable stored in a variable
    var t1 = spawn g(5)
    var r1 = oren_join(t1)
    assert_eq(r1, 15, 52)

    // --- multi-line lambda body + spawn ---
    var base = 3
    var h = |n| {
        var acc = base
        var i = 0
        while i < n {
            acc = acc + i
            i = i + 1
        }
        return acc
    }
    base = 100
    assert_eq(h(4), 9, 60) // 3 + (0+1+2+3)

    var t2 = spawn h(5)
    var r2 = oren_join(t2)
    assert_eq(r2, 13, 61) // 3 + (0+1+2+3+4)

    // --- spawn args + join ---
    var t3 = spawn worker(42)
    var r3 = oren_join(t3)
    assert_eq(r3, 42, 70)

    print("native smoke suite OK")
    exit(0)
}

main()
