fn fail(code) {
    print("FAIL test_read_bytes")
    exit(code)
}

fn main() {
    var path = "build/native_test_read_bytes.bin"
    // Use a slightly larger payload to exercise chunked sys_read loops.
    // Include 0x00 and 0xFF to ensure binary-safe roundtrip.
    var bytes = []
    var i = 0
    while i < 10000 {
        var v = i & 255
        if i == 123 { v = 0 }
        if i == 456 { v = 255 }
        oren_list_push(bytes, v)
        i = i + 1
    }
    oren_write_bytes(path, bytes)

    var out = oren_read_bytes(path)
    if oren_list_len(out) != oren_list_len(bytes) { fail(1) }

    var i = 0
    while i < oren_list_len(bytes) {
        if out[i] != bytes[i] { fail(2) }
        i = i + 1
    }

    print("native read_bytes OK")
    exit(0)
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
