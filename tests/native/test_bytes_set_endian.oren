import buffer "../../lib/std/buffer.oren"

fn fail(code) {
    print("native bytes_set_endian FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

fn main() {
    var b16 = [0, 0]
    assert_eq(oren_bytes_set_u16_be(b16, 0, 4660), 4660, 10) // 0x1234
    assert_eq(oren_bytes_get_u16_be(b16, 0), 4660, 11)
    assert_eq(b16[0], 18, 12)
    assert_eq(b16[1], 52, 13)

    var b16le = [0, 0]
    assert_eq(oren_bytes_set_u16_le(b16le, 0, 4660), 4660, 20)
    assert_eq(oren_bytes_get_u16_le(b16le, 0), 4660, 21)
    assert_eq(b16le[0], 52, 22)
    assert_eq(b16le[1], 18, 23)

    var b16n = [0, 0]
    assert_eq(oren_bytes_set_i16_be(b16n, 0, -2), -2, 30)
    assert_eq(oren_bytes_get_i16_be(b16n, 0), -2, 31)
    assert_eq(b16n[0], 255, 32)
    assert_eq(b16n[1], 254, 33)

    var b32 = [0, 0, 0, 0]
    assert_eq(oren_bytes_set_u32_be(b32, 0, 16909060), 16909060, 40) // 0x01020304
    assert_eq(oren_bytes_get_u32_be(b32, 0), 16909060, 41)
    assert_eq(b32[0], 1, 42)
    assert_eq(b32[1], 2, 43)
    assert_eq(b32[2], 3, 44)
    assert_eq(b32[3], 4, 45)

    var b32le = [0, 0, 0, 0]
    assert_eq(oren_bytes_set_u32_le(b32le, 0, 16909060), 16909060, 50)
    assert_eq(oren_bytes_get_u32_le(b32le, 0), 16909060, 51)
    assert_eq(b32le[0], 4, 52)
    assert_eq(b32le[1], 3, 53)
    assert_eq(b32le[2], 2, 54)
    assert_eq(b32le[3], 1, 55)

    var b32n = [0, 0, 0, 0]
    assert_eq(oren_bytes_set_i32_be(b32n, 0, -2), -2, 60)
    assert_eq(oren_bytes_get_i32_be(b32n, 0), -2, 61)
    assert_eq(b32n[0], 255, 62)
    assert_eq(b32n[3], 254, 63)

    var b64 = [0, 0, 0, 0, 0, 0, 0, 0]
    assert_eq(oren_bytes_set_u64_be(b64, 0, 72623859790382856), 72623859790382856, 70)
    assert_eq(oren_bytes_get_u64_be(b64, 0), 72623859790382856, 71)
    assert_eq(b64[0], 1, 72)
    assert_eq(b64[7], 8, 73)

    var b64le = [0, 0, 0, 0, 0, 0, 0, 0]
    assert_eq(oren_bytes_set_u64_le(b64le, 0, 72623859790382856), 72623859790382856, 74)
    assert_eq(oren_bytes_get_u64_le(b64le, 0), 72623859790382856, 75)
    assert_eq(b64le[0], 8, 76)
    assert_eq(b64le[7], 1, 77)

    var b64n = [0, 0, 0, 0, 0, 0, 0, 0]
    assert_eq(oren_bytes_set_i64_be(b64n, 0, -2), -2, 78)
    assert_eq(oren_bytes_get_i64_be(b64n, 0), -2, 79)
    assert_eq(b64n[0], 255, 80)
    assert_eq(b64n[7], 254, 81)

    var ub: []u8 = buffer.u8_new(8)
    assert_eq(oren_is_err(ub), false, 90)
    assert_eq(oren_bytes_set_u64_be(ub, 0, 72623859790382856), 72623859790382856, 91)
    assert_eq(oren_buf_load_u8(ub, 0), 1, 92)
    assert_eq(oren_buf_load_u8(ub, 7), 8, 93)
    assert_eq(oren_bytes_set_u64_le(ub, 0, 72623859790382856), 72623859790382856, 94)
    assert_eq(oren_buf_load_u8(ub, 0), 8, 95)
    assert_eq(oren_buf_load_u8(ub, 7), 1, 96)

    var li = oren_new_list_int(0)
    oren_list_int_push(li, 1)
    oren_list_int_push(li, 2)
    oren_list_int_push(li, 3)
    oren_list_int_push(li, 4)
    oren_list_int_push(li, 5)
    oren_list_int_push(li, 6)
    oren_list_int_push(li, 7)
    oren_list_int_push(li, 8)
    assert_eq(oren_bytes_get_u8(li, 0), 1, 100)
    assert_eq(oren_bytes_get_u16_be(li, 0), 258, 101)
    assert_eq(oren_bytes_get_u32_le(li, 0), 67305985, 102)
    assert_eq(oren_bytes_get_u64_be(li, 0), 72623859790382856, 103)
    assert_eq(oren_is_err(oren_bytes_get_u16_be(li, 7)), true, 104)

    print("native bytes_set_endian OK")
    exit(0)
}
