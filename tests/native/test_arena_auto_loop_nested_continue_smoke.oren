fn main() {
    var i = 0
    var sum = 0
    while i < 3 {
        var xs = []
        var j = 0
        while j < 3 {
            if j == 1 {
                j = j + 1
                continue
            }
            oren_list_push(xs, j)
            sum = sum + j
            j = j + 1
        }
        if oren_list_len(xs) != 2 {
            exit(43)
        }
        i = i + 1
    }
    if sum != 6 {
        exit(44)
    }
}
