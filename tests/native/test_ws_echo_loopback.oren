import ws "std:net/ws"
import dns "std:net/dns"
import udp "std:net/udp"
import tcp "std:net/tcp"

fn u16be_at(p, off) {
    var hi = ptr_get_byte(p + off) & 255
    var lo = ptr_get_byte(p + off + 1) & 255
    return (hi << 8) | lo
}

fn _env_truthy(name) {
    var p = oren_getenv(name)
    if p == 0 { return 0 }
    var b = ptr_get_byte(p)
    if b == 0 { return 0 }
    if b == 48 { return 0 } // '0'
    return 1
}

fn _make_text_payload(n) {
    var s = malloc_k(n + 1, 1)
    if s == 0 { return 0 }
    var i = 0
    while i < n {
        ptr_set_byte(s + i, 65 + (i % 26))
        i = i + 1
    }
    ptr_set_byte(s + n, 0)
    return s
}

fn _make_binary_payload(n) {
    var b = oren_u8_buf_new_uninit(n)
    var p = native_buf_data_ptr(b)
    var i = 0
    while i < n {
        ptr_set_byte(p + i, (i * 37 + 11) & 255)
        i = i + 1
    }
    return b
}

fn _bytes_equal(a, b) {
    if oren_is_u8_buf(a) != true { return 0 }
    if oren_is_u8_buf(b) != true { return 0 }
    var n = oren_bytes_len(a)
    if oren_bytes_len(b) != n { return 0 }
    var ap = native_buf_data_ptr(a)
    var bp = native_buf_data_ptr(b)
    var i = 0
    while i < n {
        if (ptr_get_byte(ap + i) & 255) != (ptr_get_byte(bp + i) & 255) { return 0 }
        i = i + 1
    }
    return 1
}

fn _write_all_raw(fd, ptr0, n, timeout_ms) {
    var off = 0
    while off < n {
        var w = tcp.write_from_raw(fd, ptr0 + off, n - off, timeout_ms)
        if w < 0 { return w }
        if w == 0 { return 0 - 104 }
        off = off + w
    }
    return 0
}

fn _ws_mask_byte(m0, m1, m2, m3, i) {
    var r = i % 4
    if r == 1 { return m1 & 255 }
    if r == 2 { return m2 & 255 }
    if r == 3 { return m3 & 255 }
    return m0 & 255
}

fn _send_masked_frame_raw(fd, fin, opcode, ptr0, n, timeout_ms, seed) {
    var hdr = malloc(14)
    if hdr == 0 { return 0 - 12 }
    var ext = 0
    if n < 126 { ext = 0 }
    else if n < 65536 { ext = 2 }
    else { ext = 8 }
    var hdr_len = 2 + ext + 4
    var b0 = opcode & 15
    if fin == 1 { b0 = b0 | 128 }
    ptr_set_byte(hdr + 0, b0)
    if ext == 0 {
        ptr_set_byte(hdr + 1, 128 | (n & 127))
    } else if ext == 2 {
        ptr_set_byte(hdr + 1, 128 | 126)
        ptr_set_byte(hdr + 2, (n >> 8) & 255)
        ptr_set_byte(hdr + 3, n & 255)
    } else {
        ptr_set_byte(hdr + 1, 128 | 127)
        var idx8 = 0
        while idx8 < 8 {
            var shift = (7 - idx8) * 8
            ptr_set_byte(hdr + 2 + idx8, (n >> shift) & 255)
            idx8 = idx8 + 1
        }
    }
    var mask_off = 2 + ext
    var m0 = (seed + 17) & 255
    var m1 = (seed + 53) & 255
    var m2 = (seed + 97) & 255
    var m3 = (seed + 193) & 255
    ptr_set_byte(hdr + mask_off + 0, m0)
    ptr_set_byte(hdr + mask_off + 1, m1)
    ptr_set_byte(hdr + mask_off + 2, m2)
    ptr_set_byte(hdr + mask_off + 3, m3)

    var rc = _write_all_raw(fd, hdr, hdr_len, timeout_ms)
    free(hdr)
    if rc < 0 { return rc }
    if n <= 0 { return 0 }

    var payload = malloc(n)
    if payload == 0 { return 0 - 12 }
    var i = 0
    while i < n {
        var b = ptr_get_byte(ptr0 + i) & 255
        ptr_set_byte(payload + i, b ^ _ws_mask_byte(m0, m1, m2, m3, i))
        i = i + 1
    }
    rc = _write_all_raw(fd, payload, n, timeout_ms)
    free(payload)
    return rc
}

fn _send_fragmented_text_client(conn, text, n, timeout_ms) {
    var fd = conn["fd"]
    var a = 2
    var b = (n - a) / 2
    var c = n - a - b
    var rc = _send_masked_frame_raw(fd, 0, 1, text, a, timeout_ms, 11)
    if rc < 0 { return rc }
    rc = _send_masked_frame_raw(fd, 0, 0, text + a, b, timeout_ms, 29)
    if rc < 0 { return rc }
    return _send_masked_frame_raw(fd, 1, 0, text + a + b, c, timeout_ms, 47)
}

fn _send_fragmented_bytes_client(conn, bytes, timeout_ms) {
    var n = oren_bytes_len(bytes)
    var p = native_buf_data_ptr(bytes)
    var a = 3
    var b = (n - a) / 2
    var c = n - a - b
    var fd = conn["fd"]
    var rc = _send_masked_frame_raw(fd, 0, 2, p, a, timeout_ms, 71)
    if rc < 0 { return rc }
    rc = _send_masked_frame_raw(fd, 0, 0, p + a, b, timeout_ms, 89)
    if rc < 0 { return rc }
    return _send_masked_frame_raw(fd, 1, 0, p + a + b, c, timeout_ms, 107)
}

fn _ensure_workers_for_spawned_servers(test_name) {
    // `spawn` prefers in-process green tasks on Tier‑1 (including Windows).
    if _env_truthy("OREN_NO_GREEN") == 1 { return 0 }
    var rcw = oren_green_start_workers(1)
    if rcw != 0 {
        print(test_name + ": FAIL cannot start green workers rc=" + oren_int_to_string(rcw))
        exit(109)
    }
    return 0
}

fn _skip_qname(buf, n, off) {
    // Skip a DNS QNAME (no compression expected in queries).
    var i = off
    while 1 {
        if i >= n { return -1 }
        var l = ptr_get_byte(buf + i) & 255
        i = i + 1
        if l == 0 { return i }
        if l > 63 { return -1 }
        i = i + l
    }
}

fn dns_server_one_a(fd, ip0, ip1, ip2, ip3) {
    // Minimal authoritative DNS server for one query (A/IN).
    // Replies with a single A record containing (ip0..ip3).
    var buf = malloc(512)
    if buf == 0 { return 60 }
    var sa = malloc(16)
    if sa == 0 { free(buf); return 61 }
    var lenp = malloc(8)
    if lenp == 0 { free(buf); free(sa); return 62 }
    ptr_set(lenp, 16)

    var rn = udp.recv_from_into_raw(fd, buf, 512, 5000, sa, lenp)
    if rn < 0 {
        free(buf)
        free(sa)
        free(lenp)
        return 63
    }
    if rn < 12 {
        free(buf)
        free(sa)
        free(lenp)
        return 64
    }

    // Validate the query shape: one question.
    var qd = u16be_at(buf, 4)
    if qd != 1 {
        free(buf)
        free(sa)
        free(lenp)
        return 65
    }

    var qend = _skip_qname(buf, rn, 12)
    if qend < 0 || qend + 4 > rn {
        free(buf)
        free(sa)
        free(lenp)
        return 66
    }

    // QTYPE + QCLASS should be A/IN.
    var qtype = u16be_at(buf, qend + 0)
    var qclass = u16be_at(buf, qend + 2)
    if qtype != 1 || qclass != 1 {
        free(buf)
        free(sa)
        free(lenp)
        return 67
    }
    qend = qend + 4

    // Build response:
    // - copy the whole question section verbatim
    // - append 1 answer: NAME pointer to 0x0c, TYPE A, CLASS IN, TTL 0, RDLEN 4, RDATA ip
    var resp = malloc(512)
    if resp == 0 {
        free(buf)
        free(sa)
        free(lenp)
        return 68
    }
    // ID
    ptr_set_byte(resp + 0, ptr_get_byte(buf + 0))
    ptr_set_byte(resp + 1, ptr_get_byte(buf + 1))
    // Flags: 0x8180 (response, recursion available, no error)
    ptr_set_byte(resp + 2, 129)
    ptr_set_byte(resp + 3, 128)
    // QDCOUNT=1
    ptr_set_byte(resp + 4, 0)
    ptr_set_byte(resp + 5, 1)
    // ANCOUNT=1
    ptr_set_byte(resp + 6, 0)
    ptr_set_byte(resp + 7, 1)
    // NSCOUNT=0, ARCOUNT=0
    ptr_set_byte(resp + 8, 0)
    ptr_set_byte(resp + 9, 0)
    ptr_set_byte(resp + 10, 0)
    ptr_set_byte(resp + 11, 0)

    // Copy question bytes [12..qend)
    var qi = 12
    var roff = 12
    while qi < qend {
        ptr_set_byte(resp + roff, ptr_get_byte(buf + qi))
        qi = qi + 1
        roff = roff + 1
    }

    // Answer NAME: compression pointer to QNAME at offset 12 (0xC00C).
    ptr_set_byte(resp + roff + 0, 192)
    ptr_set_byte(resp + roff + 1, 12)
    // TYPE=A, CLASS=IN
    ptr_set_byte(resp + roff + 2, 0)
    ptr_set_byte(resp + roff + 3, 1)
    ptr_set_byte(resp + roff + 4, 0)
    ptr_set_byte(resp + roff + 5, 1)
    // TTL=0
    ptr_set_byte(resp + roff + 6, 0)
    ptr_set_byte(resp + roff + 7, 0)
    ptr_set_byte(resp + roff + 8, 0)
    ptr_set_byte(resp + roff + 9, 0)
    // RDLEN=4
    ptr_set_byte(resp + roff + 10, 0)
    ptr_set_byte(resp + roff + 11, 4)
    // RDATA: IPv4 bytes
    ptr_set_byte(resp + roff + 12, ip0 & 255)
    ptr_set_byte(resp + roff + 13, ip1 & 255)
    ptr_set_byte(resp + roff + 14, ip2 & 255)
    ptr_set_byte(resp + roff + 15, ip3 & 255)
    var resp_len = roff + 16

    // Extract source port from sockaddr_in and reply to loopback.
    var src_port = u16be_at(sa, 2)
    var wn = udp.send_to_raw(fd, "127.0.0.1", src_port, resp, resp_len, 2000)

    free(buf)
    free(resp)
    free(sa)
    free(lenp)
    if wn != resp_len { return 69 }
    return 0
}

fn server(listen_fd) {
    // Accept + handshake, then echo single-frame and fragmented text/binary frames.
    // Keep timeouts a bit generous on remote Win11 hosts (rolling: avoid flaky scheduling timeouts).
    var conn = ws.accept(listen_fd, 10000)
    if oren_is_err(conn) {
        print("ws_echo_loopback: server accept FAIL: " + oren_err_msg(conn))
        return 10
    }
    if conn == 0 { return 11 }

    var s = conn.recv_text(10000)
    if oren_is_err(s) {
        print("ws_echo_loopback: server recv FAIL: " + oren_err_msg(s))
        return 12
    }
    if s == 0 { return 13 }

    var wr = conn.send_text_server(s, 10000)
    free(s)
    if oren_is_err(wr) {
        print("ws_echo_loopback: server send FAIL: " + oren_err_msg(wr))
        return 14
    }

    var bs = conn.recv_bytes(10000)
    if oren_is_err(bs) {
        print("ws_echo_loopback: server recv bytes FAIL: " + oren_err_msg(bs))
        return 15
    }
    if oren_is_u8_buf(bs) != true { return 16 }

    wr = conn.send_bytes_server(bs, 10000)
    if oren_is_err(wr) {
        print("ws_echo_loopback: server send bytes FAIL: " + oren_err_msg(wr))
        return 17
    }

    var fs = conn.recv_text(10000)
    if oren_is_err(fs) {
        print("ws_echo_loopback: server recv fragmented text FAIL: " + oren_err_msg(fs))
        return 18
    }
    if fs == 0 { return 19 }
    wr = conn.send_text_server(fs, 10000)
    free(fs)
    if oren_is_err(wr) {
        print("ws_echo_loopback: server send fragmented text FAIL: " + oren_err_msg(wr))
        return 20
    }

    var fbs = conn.recv_bytes(10000)
    if oren_is_err(fbs) {
        print("ws_echo_loopback: server recv fragmented bytes FAIL: " + oren_err_msg(fbs))
        return 21
    }
    if oren_is_u8_buf(fbs) != true { return 22 }
    wr = conn.send_bytes_server(fbs, 10000)
    if oren_is_err(wr) {
        print("ws_echo_loopback: server send fragmented bytes FAIL: " + oren_err_msg(wr))
        return 23
    }

    conn.close()
    return 0
}

fn run_one(listen_fd, url, resolver) {
    // One server accept+echo, one client connect+ping+text+recv.
    var h = spawn server(listen_fd)

    // Keep a single exit path so we always join the server thread.
    var rc = 0
    var conn = 0
    var text = 0
    var bytes = nil
    var frag_bytes = nil

    var c = 0
    if resolver != nil {
        c = ws.connect_resolver(url, 5000, resolver)
    } else {
        c = ws.connect(url, 5000)
    }

    if oren_is_err(c) {
        print("ws_echo_loopback: FAIL connect: " + oren_err_msg(c))
        rc = 20
    } else {
        conn = c

        // Exercise ping/pong handling (Tier‑1): send ping before the text echo.
        //
        // Debug knob:
        //   OREN_WS_NO_PING=1  (skip ping to isolate protocol parsing vs NET substrate issues)
        var do_ping = 1
        if oren_env("OREN_WS_NO_PING") != nil { do_ping = 0 }
        if do_ping == 1 {
            // Server `ws.recv_text` should auto-respond with pong and continue waiting for text.
            // Client `ws.recv_text` should ignore pong and continue waiting for the echoed text.
            var prc = ws.send_ping_client(conn, "hi", 5000)
            if prc < 0 {
                print("ws_echo_loopback: FAIL ping (errno=" + oren_int_to_string(0 - prc) + ")")
                rc = 21
            }
        }

        if rc == 0 {
            text = _make_text_payload(5003)
            if text == 0 {
                print("ws_echo_loopback: FAIL payload alloc")
                rc = 25
            }
        }

        if rc == 0 {
            var wr = conn.send_text_client(text, 5000)
            if oren_is_err(wr) {
                print("ws_echo_loopback: FAIL send: " + oren_err_msg(wr))
                rc = 21
            } else {
                var body = conn.recv_text(10000)
                if oren_is_err(body) {
                    print("ws_echo_loopback: FAIL recv: " + oren_err_msg(body))
                    rc = 22
                } else {
                    if body == 0 { rc = 23 }
                    else if strcmp(body, text) != 0 {
                        print("ws_echo_loopback: FAIL mismatch")
                        print(body)
                        free(body)
                        rc = 24
                    } else {
                        free(body)
                    }
                }
            }
            free(text)
            text = 0
        }

        if rc == 0 {
            bytes = _make_binary_payload(4101)
            var bprc = ws.send_ping_client(conn, "bytes", 5000)
            if oren_is_err(bprc) {
                print("ws_echo_loopback: FAIL ping before bytes: " + oren_err_msg(bprc))
                rc = 26
            }
        }

        if rc == 0 {
            var ping_bytes = _make_binary_payload(5)
            if oren_is_err(ping_bytes) {
                print("ws_echo_loopback: FAIL binary ping alloc")
                rc = 37
            } else {
                var pbp = native_buf_data_ptr(ping_bytes)
                ptr_set_byte(pbp + 0, 0)
                ptr_set_byte(pbp + 1, 255)
                ptr_set_byte(pbp + 2, 1)
                ptr_set_byte(pbp + 3, 254)
                ptr_set_byte(pbp + 4, 2)
                var pbprc = ws.send_ping_bytes_client(conn, ping_bytes, 5000)
                if pbprc < 0 {
                    print("ws_echo_loopback: FAIL binary ping before bytes (errno=" + oren_int_to_string(0 - pbprc) + ")")
                    rc = 38
                }
            }
        }

        if rc == 0 {
            var pong_bytes = _make_binary_payload(4)
            if oren_is_err(pong_bytes) {
                print("ws_echo_loopback: FAIL binary pong alloc")
                rc = 39
            } else {
                var pop = native_buf_data_ptr(pong_bytes)
                ptr_set_byte(pop + 0, 3)
                ptr_set_byte(pop + 1, 252)
                ptr_set_byte(pop + 2, 4)
                ptr_set_byte(pop + 3, 251)
                var poprc = conn.send_pong_bytes_client(pong_bytes, 5000)
                if oren_is_err(poprc) {
                    print("ws_echo_loopback: FAIL binary pong before bytes: " + oren_err_msg(poprc))
                    rc = 40
                }
            }
        }

        if rc == 0 {
            var bwr = conn.send_bytes_client(bytes, 5000)
            if oren_is_err(bwr) {
                print("ws_echo_loopback: FAIL send bytes: " + oren_err_msg(bwr))
                rc = 26
            } else {
                var body_bytes = conn.recv_bytes(10000)
                if oren_is_err(body_bytes) {
                    print("ws_echo_loopback: FAIL recv bytes: " + oren_err_msg(body_bytes))
                    rc = 27
                } else if _bytes_equal(body_bytes, bytes) != 1 {
                    print("ws_echo_loopback: FAIL bytes mismatch")
                    rc = 28
                }
            }
        }

        if rc == 0 {
            text = _make_text_payload(257)
            if text == 0 {
                print("ws_echo_loopback: FAIL fragmented payload alloc")
                rc = 29
            } else {
                var fwr = _send_fragmented_text_client(conn, text, 257, 5000)
                if fwr < 0 {
                    print("ws_echo_loopback: FAIL send fragmented text (errno=" + oren_int_to_string(0 - fwr) + ")")
                    rc = 31
                } else {
                    var fbody = conn.recv_text(10000)
                    if oren_is_err(fbody) {
                        print("ws_echo_loopback: FAIL recv fragmented text: " + oren_err_msg(fbody))
                        rc = 32
                    } else if strcmp(fbody, text) != 0 {
                        print("ws_echo_loopback: FAIL fragmented text mismatch")
                        rc = 33
                    }
                    if fbody != 0 && oren_is_err(fbody) != true { free(fbody) }
                }
                free(text)
                text = 0
            }
        }

        if rc == 0 {
            frag_bytes = _make_binary_payload(257)
            var fbwr = _send_fragmented_bytes_client(conn, frag_bytes, 5000)
            if fbwr < 0 {
                print("ws_echo_loopback: FAIL send fragmented bytes (errno=" + oren_int_to_string(0 - fbwr) + ")")
                rc = 34
            } else {
                var fbody_bytes = conn.recv_bytes(10000)
                if oren_is_err(fbody_bytes) {
                    print("ws_echo_loopback: FAIL recv fragmented bytes: " + oren_err_msg(fbody_bytes))
                    rc = 35
                } else if _bytes_equal(fbody_bytes, frag_bytes) != 1 {
                    print("ws_echo_loopback: FAIL fragmented bytes mismatch")
                    rc = 36
                }
            }
        }
    }

    if text != 0 { free(text) }
    if conn != 0 { conn.close() }

    var sr = oren_join_timeout(h, 15000)
    if sr != 0 && rc == 0 {
        rc = 30
    }
    // On failure, always print the server thread result too (bounded debug signal).
    if rc != 0 {
        print("ws_echo_loopback: server_rc=" + oren_int_to_string(sr))
    }

    return rc
}

fn run_case() {
    // Loopback-only, timeout-bounded, OS-neutral.
    var listen_fd = oren_tcp_listen_local(0) // port 0 => ephemeral
    if listen_fd < 0 { return 1 }

    // Determine the chosen port via getsockname.
    var sa = malloc(32)
    if sa == 0 { return 2 }
    var lenp = malloc(8)
    if lenp == 0 { return 3 }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { return 0 - grc }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { return 4 }

    var url = "ws://127.0.0.1:" + oren_int_to_string(port) + "/"
    var rc = run_one(listen_fd, url, 0)
    free(url)
    if rc != 0 {
        oren_tcp_close(listen_fd)
        return rc
    }

    // Hostname path: serve a loopback DNS A record so the test stays offline and deterministic.
    var sfd = udp.bind_local_raw(0)
    if sfd < 0 { oren_tcp_close(listen_fd); return 50 }
    var sport = udp.sockname_port_raw(sfd)
    if sport <= 0 { udp.close_raw(sfd); oren_tcp_close(listen_fd); return 51 }
    var dh = spawn dns_server_one_a(sfd, 127, 0, 0, 1)

    var url2 = "ws://oren.test:" + oren_int_to_string(port) + "/"
    var res = dns.resolver("127.0.0.1", sport, 2000)
    var rc2 = run_one(listen_fd, url2, res)
    free(url2)
    var dsr = oren_join_timeout(dh, 5000)
    udp.close_raw(sfd)
    if dsr != 0 && rc2 == 0 { rc2 = 52 }
    if rc2 != 0 {
        oren_tcp_close(listen_fd)
        return rc2
    }

    oren_tcp_close(listen_fd)
    return rc
}

fn run_low_level_helpers() {
    var u = ws.parse_url("ws://127.0.0.1:1234/chat?room=1#frag")
    if oren_is_err(u) {
        print("ws_echo_loopback: FAIL parse_url err=" + oren_err_msg(u))
        return 70
    }
    if strcmp(u["scheme"], "ws") != 0 { return 71 }
    if strcmp(u["host"], "127.0.0.1") != 0 { return 72 }
    if u["port"] != 1234 { return 73 }
    if strcmp(u["path"], "/chat?room=1#frag") != 0 { return 74 }
    if strcmp(u["request_target"], "/chat?room=1") != 0 { return 78 }

    var bad = ws.parse_url("ftp://127.0.0.1/")
    if !oren_is_err(bad) { return 75 }

    var key = ws.client_key_base64()
    if oren_is_err(key) {
        print("ws_echo_loopback: FAIL client_key err=" + oren_err_msg(key))
        return 76
    }
    if oren_string_len(key) != 24 { return 77 }
    return 0
}

fn main() {
    // Optional stress knob for flaky platform bring-up:
    //   OREN_WS_ECHO_N=<n>  (defaults to 1)
    //
    // Keep output bounded: only print one OK line and stop on first failure.
    var iters = 1
    var env_n = oren_env("OREN_WS_ECHO_N")
    if env_n != nil {
        var n = oren_int_from_string(env_n)
        if n > 0 { iters = n }
    }

    _ensure_workers_for_spawned_servers("ws_echo_loopback")

    var helper_rc = run_low_level_helpers()
    if helper_rc != 0 {
        print("ws_echo_loopback: FAIL low_level rc=" + oren_int_to_string(helper_rc))
        exit(helper_rc)
    }

    var i = 0
    while i < iters {
        var rc = run_case()
        if rc != 0 {
            print("ws_echo_loopback: FAIL iter=" + oren_int_to_string(i) + " rc=" + oren_int_to_string(rc))
            exit(rc)
        }
        i = i + 1
    }

    print("ws_echo_loopback: OK")
    exit(0)
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
