import ws "std:net/ws"
import dns "std:net/dns"
import udp "std:net/udp"

fn u16be_at(p, off) {
    var hi = ptr_get_byte(p + off) & 255
    var lo = ptr_get_byte(p + off + 1) & 255
    return (hi << 8) | lo
}

fn _env_truthy(name) {
    var p = oren_getenv(name)
    if p == 0 { return 0 }
    var b = ptr_get_byte(p)
    if b == 0 { return 0 }
    if b == 48 { return 0 } // '0'
    return 1
}

fn _ensure_workers_for_spawned_servers(test_name) {
    if g_target_os == 3 { return 0 }
    if _env_truthy("OREN_NO_GREEN") == 1 { return 0 }
    var rcw = oren_green_start_workers(1)
    if rcw != 0 {
        print(test_name + ": FAIL cannot start green workers rc=" + oren_int_to_string(rcw))
        exit(109)
    }
    return 0
}

fn _skip_qname(buf, n, off) {
    // Skip a DNS QNAME (no compression expected in queries).
    var i = off
    while 1 {
        if i >= n { return -1 }
        var l = ptr_get_byte(buf + i) & 255
        i = i + 1
        if l == 0 { return i }
        if l > 63 { return -1 }
        i = i + l
    }
}

fn dns_server_one_a(fd, ip0, ip1, ip2, ip3) {
    // Minimal authoritative DNS server for one query (A/IN).
    // Replies with a single A record containing (ip0..ip3).
    var buf = malloc(512)
    if buf == 0 { return 60 }
    var sa = malloc(16)
    if sa == 0 { free(buf); return 61 }
    var lenp = malloc(8)
    if lenp == 0 { free(buf); free(sa); return 62 }
    ptr_set(lenp, 16)

    var rn = udp.recv_from_into(fd, buf, 512, 5000, sa, lenp)
    if rn < 0 {
        free(buf)
        free(sa)
        free(lenp)
        return 63
    }
    if rn < 12 {
        free(buf)
        free(sa)
        free(lenp)
        return 64
    }

    // Validate the query shape: one question.
    var qd = u16be_at(buf, 4)
    if qd != 1 {
        free(buf)
        free(sa)
        free(lenp)
        return 65
    }

    var qend = _skip_qname(buf, rn, 12)
    if qend < 0 || qend + 4 > rn {
        free(buf)
        free(sa)
        free(lenp)
        return 66
    }

    // QTYPE + QCLASS should be A/IN.
    var qtype = u16be_at(buf, qend + 0)
    var qclass = u16be_at(buf, qend + 2)
    if qtype != 1 || qclass != 1 {
        free(buf)
        free(sa)
        free(lenp)
        return 67
    }
    qend = qend + 4

    // Build response:
    // - copy the whole question section verbatim
    // - append 1 answer: NAME pointer to 0x0c, TYPE A, CLASS IN, TTL 0, RDLEN 4, RDATA ip
    var resp = malloc(512)
    if resp == 0 {
        free(buf)
        free(sa)
        free(lenp)
        return 68
    }
    // ID
    ptr_set_byte(resp + 0, ptr_get_byte(buf + 0))
    ptr_set_byte(resp + 1, ptr_get_byte(buf + 1))
    // Flags: 0x8180 (response, recursion available, no error)
    ptr_set_byte(resp + 2, 129)
    ptr_set_byte(resp + 3, 128)
    // QDCOUNT=1
    ptr_set_byte(resp + 4, 0)
    ptr_set_byte(resp + 5, 1)
    // ANCOUNT=1
    ptr_set_byte(resp + 6, 0)
    ptr_set_byte(resp + 7, 1)
    // NSCOUNT=0, ARCOUNT=0
    ptr_set_byte(resp + 8, 0)
    ptr_set_byte(resp + 9, 0)
    ptr_set_byte(resp + 10, 0)
    ptr_set_byte(resp + 11, 0)

    // Copy question bytes [12..qend)
    var qi = 12
    var roff = 12
    while qi < qend {
        ptr_set_byte(resp + roff, ptr_get_byte(buf + qi))
        qi = qi + 1
        roff = roff + 1
    }

    // Answer NAME: compression pointer to QNAME at offset 12 (0xC00C).
    ptr_set_byte(resp + roff + 0, 192)
    ptr_set_byte(resp + roff + 1, 12)
    // TYPE=A, CLASS=IN
    ptr_set_byte(resp + roff + 2, 0)
    ptr_set_byte(resp + roff + 3, 1)
    ptr_set_byte(resp + roff + 4, 0)
    ptr_set_byte(resp + roff + 5, 1)
    // TTL=0
    ptr_set_byte(resp + roff + 6, 0)
    ptr_set_byte(resp + roff + 7, 0)
    ptr_set_byte(resp + roff + 8, 0)
    ptr_set_byte(resp + roff + 9, 0)
    // RDLEN=4
    ptr_set_byte(resp + roff + 10, 0)
    ptr_set_byte(resp + roff + 11, 4)
    // RDATA: IPv4 bytes
    ptr_set_byte(resp + roff + 12, ip0 & 255)
    ptr_set_byte(resp + roff + 13, ip1 & 255)
    ptr_set_byte(resp + roff + 14, ip2 & 255)
    ptr_set_byte(resp + roff + 15, ip3 & 255)
    var resp_len = roff + 16

    // Extract source port from sockaddr_in and reply to loopback.
    var src_port = u16be_at(sa, 2)
    var wn = udp.send_to(fd, "127.0.0.1", src_port, resp, resp_len, 2000)

    free(buf)
    free(resp)
    free(sa)
    free(lenp)
    if wn != resp_len { return 69 }
    return 0
}

fn server(listen_fd) {
    // Accept + handshake, then echo one text frame.
    // Keep timeouts a bit generous on remote Win11 hosts (rolling: avoid flaky scheduling timeouts).
    var r = ws.accept(listen_fd, 10000)
    var okv = oren_map_get_str(r, "ok")
    if okv != 1 {
        var errv = oren_map_get_str(r, "err")
        if errv != 0 {
            var es = oren_intern_cstr(errv)
            print("ws_echo_loopback: server accept FAIL: " + es)
        } else {
            print("ws_echo_loopback: server accept FAIL: ok=" + oren_int_to_string(okv))
        }
        return 10
    }
    var conn = oren_map_get_str(r, "conn")
    if conn == 0 { return 11 }

    var msg = ws.recv_text(conn, 10000)
    var mok = oren_map_get_str(msg, "ok")
    if mok != 1 {
        var merr = oren_map_get_str(msg, "err")
        if merr != 0 {
            var mes = oren_intern_cstr(merr)
            print("ws_echo_loopback: server recv FAIL: " + mes)
        } else {
            print("ws_echo_loopback: server recv FAIL: ok=" + oren_int_to_string(mok))
        }
        return 12
    }
    var s = oren_map_get_str(msg, "v")
    if s == 0 { return 13 }

    var wr = ws.send_text_server(conn, s, 10000)
    free(s)
    if wr < 0 {
        print("ws_echo_loopback: server send FAIL (errno=" + oren_int_to_string(0 - wr) + ")")
        return 14
    }

    ws.close(conn)
    return 0
}

fn _print_connect_fail(c, okv) {
    var errv = oren_map_get_str(c, "err")
    if errv != 0 {
        // `errv` can be an untracked C-string in rolling mode; intern it so string ops are safe.
        var es = oren_intern_cstr(errv)
        print("ws_echo_loopback: FAIL connect: " + es)
    } else {
        print("ws_echo_loopback: FAIL connect: ok=" + oren_int_to_string(okv))
    }
    // Bounded dump of the returned map for debugging (up to 8 entries).
    var count = ptr_get(c + 0)
    var buf = ptr_get(c + 16)
    var i = 0
    while i < count && i < 8 {
        var base = buf + i * 24
        var k = ptr_get(base + 0)
        var kk = ptr_get(base + 8)
        var v = ptr_get(base + 16)
        if kk == 1 {
            print("ws_echo_loopback: entry key=" + k + " v=" + oren_int_to_string(v))
        } else {
            print("ws_echo_loopback: entry key_int=" + oren_int_to_string(k) + " v=" + oren_int_to_string(v))
        }
        i = i + 1
    }
    return 0
}

fn run_one(listen_fd, url, resolver) {
    // One server accept+echo, one client connect+ping+text+recv.
    var h = spawn server(listen_fd)

    // Keep a single exit path so we always join the server thread.
    var rc = 0
    var conn = 0

    var c = 0
    if resolver != nil {
        c = ws.connect_resolver(url, 5000, resolver)
    } else {
        c = ws.connect(url, 5000)
    }

    // Avoid relying on `c["ok"]` key-kind inference in rolling mode; use the typed runtime accessor.
    var okv = oren_map_get_str(c, "ok")
    if okv != 1 {
        _print_connect_fail(c, okv)
        rc = 20
    } else {
        conn = oren_map_get_str(c, "conn")

        // Exercise ping/pong handling (Tier‑1): send ping before the text echo.
        //
        // Debug knob:
        //   OREN_WS_NO_PING=1  (skip ping to isolate protocol parsing vs NET substrate issues)
        var do_ping = 1
        if oren_env("OREN_WS_NO_PING") != nil { do_ping = 0 }
        if do_ping == 1 {
            // Server `ws.recv_text` should auto-respond with pong and continue waiting for text.
            // Client `ws.recv_text` should ignore pong and continue waiting for the echoed text.
            var prc = ws.send_ping_client(conn, "hi", 5000)
            if prc < 0 {
                print("ws_echo_loopback: FAIL ping (errno=" + oren_int_to_string(0 - prc) + ")")
                rc = 21
            }
        }

        if rc == 0 {
            var text = "PING"
            var wr = ws.send_text_client(conn, text, 5000)
            if wr < 0 {
                print("ws_echo_loopback: FAIL send (errno=" + oren_int_to_string(0 - wr) + ")")
                rc = 21
            } else {
                var rr = ws.recv_text(conn, 10000)
                // Prefer typed map access; do not rely on key-kind inference in tests.
                var rok = oren_map_get_str(rr, "ok")
                if rok != 1 {
                    var rerr = oren_map_get_str(rr, "err")
                    if rerr != 0 {
                        var rerr_s = oren_intern_cstr(rerr)
                        print("ws_echo_loopback: FAIL recv: " + rerr_s)
                    } else {
                        print("ws_echo_loopback: FAIL recv: ok=" + oren_int_to_string(rok))
                    }
                    rc = 22
                } else {
                    var body = oren_map_get_str(rr, "v")
                    if body == 0 { rc = 23 }
                    else if strcmp(body, "PING") != 0 {
                        print("ws_echo_loopback: FAIL mismatch")
                        print(body)
                        free(body)
                        rc = 24
                    } else {
                        free(body)
                    }
                }
            }
        }
    }

    if conn != 0 { ws.close(conn) }

    var sr = oren_join_timeout(h, 15000)
    if sr != 0 && rc == 0 {
        rc = 30
    }
    // On failure, always print the server thread result too (bounded debug signal).
    if rc != 0 {
        print("ws_echo_loopback: server_rc=" + oren_int_to_string(sr))
    }

    return rc
}

fn run_case() {
    // Loopback-only, timeout-bounded, OS-neutral.
    var listen_fd = oren_tcp_listen_local(0) // port 0 => ephemeral
    if listen_fd < 0 { return 1 }

    // Determine the chosen port via getsockname.
    var sa = malloc(32)
    if sa == 0 { return 2 }
    var lenp = malloc(8)
    if lenp == 0 { return 3 }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { return 0 - grc }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { return 4 }

    var url = "ws://127.0.0.1:" + oren_int_to_string(port) + "/"
    var rc = run_one(listen_fd, url, 0)
    free(url)
    if rc != 0 {
        oren_tcp_close(listen_fd)
        return rc
    }

    // Hostname path: serve a loopback DNS A record so the test stays offline and deterministic.
    var sfd = udp.bind_local(0)
    if sfd < 0 { oren_tcp_close(listen_fd); return 50 }
    var sport = udp.sockname_port(sfd)
    if sport <= 0 { udp.close(sfd); oren_tcp_close(listen_fd); return 51 }
    var dh = spawn dns_server_one_a(sfd, 127, 0, 0, 1)

    var url2 = "ws://oren.test:" + oren_int_to_string(port) + "/"
    var res = dns.resolver("127.0.0.1", sport, 2000)
    var rc2 = run_one(listen_fd, url2, res)
    free(url2)
    var dsr = oren_join_timeout(dh, 5000)
    udp.close(sfd)
    if dsr != 0 && rc2 == 0 { rc2 = 52 }
    if rc2 != 0 {
        oren_tcp_close(listen_fd)
        return rc2
    }

    oren_tcp_close(listen_fd)
    return rc
}

fn main() {
    // Optional stress knob for flaky platform bring-up:
    //   OREN_WS_ECHO_N=<n>  (defaults to 1)
    //
    // Keep output bounded: only print one OK line and stop on first failure.
    var iters = 1
    var env_n = oren_env("OREN_WS_ECHO_N")
    if env_n != nil {
        var n = oren_int_from_string(env_n)
        if n > 0 { iters = n }
    }

    _ensure_workers_for_spawned_servers("ws_echo_loopback")

    var i = 0
    while i < iters {
        var rc = run_case()
        if rc != 0 {
            print("ws_echo_loopback: FAIL iter=" + oren_int_to_string(i) + " rc=" + oren_int_to_string(rc))
            exit(rc)
        }
        i = i + 1
    }

    print("ws_echo_loopback: OK")
    exit(0)
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
