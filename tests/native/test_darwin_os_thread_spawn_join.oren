// Darwin OS-thread smoke:
// - prefer syscall-first `bsdthread_register` + `bsdthread_create` when possible
// - fall back to libpthread (`pthread_create`/`pthread_join`) when dyld already registered
//
// This is a targeted regression test for Stage N2 groundwork:
// - entry stub registers runtime-owned bsdthread entrypoints
// - runtime can spawn a real OS thread that runs Oren code
// - join observes the result and cleans up the remaining metadata page
//
// On non-macOS targets this test is a no-op and exits 0.

fn worker() {
    // Keep the worker allocation-free to avoid exercising GC/allocator concurrency yet.
    return 1234567
}

fn main() {
    if g_target_os != 1 {
        print("skip: darwin os-thread test (not macos)")
        exit(0)
    }

    var trace = oren_env("OREN_TRACE_DARWIN_THREADS")
    if trace != nil && trace != "" {
        print("darwin os-thread: bsdthread_register rv=" + oren_int_to_string(g_darwin_bsdthread_register_last_rv) +
              " registered=" + oren_int_to_string(g_darwin_bsdthread_registered))
    }

    var fn_obj = worker
    var args = oren_new_list(0)
    var h = oren_darwin_os_thread_spawn_call_list(fn_obj, args)
    if h == 0 {
        print("fail: darwin os-thread spawn failed (bsdthread_register rv=" + oren_int_to_string(g_darwin_bsdthread_register_last_rv) + ")")
        exit(3)
    }
    var ret = oren_darwin_os_thread_join(h)
    if ret != 1234567 {
        print("darwin os-thread: bad ret=" + oren_int_to_string(ret))
        exit(4)
    }
    print("darwin os-thread: ok")
    exit(0)
}
