fn sum9(a, b, c, d, e, f, g, h, i) {
    return a + b + c + d + e + f + g + h + i
}

fn main() {
    // Exercises native AAPCS64 stack argument passing (arg8+).
    // 1..9 => 45
    var v = sum9(1, 2, 3, 4, 5, 6, 7, 8, 9)
    if v == 45 { exit(0) } else { exit(1) }
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
