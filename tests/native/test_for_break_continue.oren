fn main() {
    // Nested while: break should only exit inner loop.
    var i = 0
    var sum = 0
    while i < 3 {
        var j = 0
        while j < 5 {
            if j == 2 { break }
            sum = sum + 1
            j = j + 1
        }
        i = i + 1
    }
    if sum != 6 { exit(901) } // 3 * (0,1)

    // for: continue must execute post (otherwise this loop can hang at k==2).
    var ksum = 0
    for var k = 0; k < 5; k = k + 1 {
        if k == 2 { continue }
        ksum = ksum + 1
    }
    if ksum != 4 { exit(902) }

    // Nested for:
    // - inner continue should run inner post (b++)
    // - inner break should only exit inner loop
    var cnt = 0
    for var a = 0; a < 3; a = a + 1 {
        for var b = 0; b < 5; b = b + 1 {
            if b == 2 { continue }
            if b == 4 { break }
            cnt = cnt + 1
        }
    }
    if cnt != 9 { exit(903) } // per a: b=0,1,3 => 3; 3*3 = 9

    print("for/break/continue OK")
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
