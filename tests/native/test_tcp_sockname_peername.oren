fn u16be_at(p, off) {
    var hi = ptr_get_byte(p + off)
    var lo = ptr_get_byte(p + off + 1)
    return (hi << 8) | lo
}

fn ipv4_eq(p, off, a, b, c, d) {
    if ptr_get_byte(p + off + 0) != a { return 0 }
    if ptr_get_byte(p + off + 1) != b { return 0 }
    if ptr_get_byte(p + off + 2) != c { return 0 }
    if ptr_get_byte(p + off + 3) != d { return 0 }
    return 1
}

fn main() {
    // Validates syscall-first sockaddr introspection:
    // - sys_getpeername
    // - sys_getsockname
    //
    // Loopback-only and timeout-bounded (no external network).

    var ch = oren_pipe()
    var r = oren_list_get(ch, 0)
    var w = oren_list_get(ch, 1)

    var pid = sys_fork()
    if pid < 0 { exit(700) }

    if pid == 0 {
        // Child: server
        sys_close(r)

        var port = 40001
        var lfd = oren_tcp_listen_local(port)
        if lfd < 0 { exit(701) }

        var pbuf = malloc(8)
        if pbuf == 0 { exit(702) }
        ptr_set(pbuf, port)
        var wn0 = sys_write(w, pbuf, 8)
        if wn0 != 8 { exit(703) }
        sys_close(w)

        var cfd = oren_tcp_accept(lfd, 2000)
        if cfd < 0 { exit(704) }

        // Keep connection alive briefly; parent performs getsockname/getpeername.
        var inb = malloc(1)
        if inb == 0 { exit(705) }
        var rn = oren_tcp_read_into(cfd, inb, 1, 2000)
        if rn < 0 { exit(0 - rn) }

        oren_tcp_close(cfd)
        oren_tcp_close(lfd)
        exit(0)
    }

    // Parent: client
    sys_close(w)
    var pbuf2 = malloc(8)
    if pbuf2 == 0 { exit(710) }
    var got = 0
    while got < 8 {
        var n = sys_read(r, pbuf2 + got, 8 - got)
        if n <= 0 { exit(711) }
        got = got + n
    }
    var port2 = ptr_get(pbuf2)
    if port2 < 1 { exit(712) }
    sys_close(r)

    var cfd2 = oren_tcp_connect("127.0.0.1", port2, 2000)
    if cfd2 < 0 { exit(0 - cfd2) }

    // --- getpeername (remote should be 127.0.0.1:port2) ---
    var peer_sa = malloc(16)
    if peer_sa == 0 { exit(720) }
    var peer_lenp = malloc(8)
    if peer_lenp == 0 { exit(721) }
    ptr_set(peer_lenp, 16)

    var prc = sys_getpeername(cfd2, peer_sa, peer_lenp)
    if prc < 0 { exit(0 - prc) }

    if ptr_get_byte(peer_sa + 1) != 2 { exit(722) } // AF_INET
    var peer_port = u16be_at(peer_sa, 2)
    if peer_port != port2 { exit(723) }
    if ipv4_eq(peer_sa, 4, 127, 0, 0, 1) == 0 { exit(724) }

    // --- getsockname (local should be loopback with an ephemeral port) ---
    var sock_sa = malloc(16)
    if sock_sa == 0 { exit(730) }
    var sock_lenp = malloc(8)
    if sock_lenp == 0 { exit(731) }
    ptr_set(sock_lenp, 16)

    var src = sys_getsockname(cfd2, sock_sa, sock_lenp)
    if src < 0 { exit(0 - src) }
    if ptr_get_byte(sock_sa + 1) != 2 { exit(732) } // AF_INET
    if ipv4_eq(sock_sa, 4, 127, 0, 0, 1) == 0 { exit(733) }
    var local_port = u16be_at(sock_sa, 2)
    if local_port == 0 { exit(734) }

    // Nudge the server so it can exit cleanly.
    var one = malloc(1)
    if one == 0 { exit(740) }
    ptr_set_byte(one + 0, 88)
    var wn1 = oren_tcp_write_from(cfd2, one, 1, 2000)
    if wn1 != 1 { exit(741) }

    oren_tcp_close(cfd2)

    var st = malloc(8)
    if st == 0 { exit(742) }
    ptr_set(st, 0)
    sys_wait4(pid, st, 0, 0)

    print("tcp sockname/peername: OK")
    exit(0)
}

main()

