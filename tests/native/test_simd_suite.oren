fn fail(code, msg) {
    oren_fail(code, "test_simd_suite: " + msg)
    return 1
}

fn assert_eq_i64(got, want, code, msg) {
    if got == want { return 0 }
    print("assert_eq failed: code=" + oren_int_to_string(code))
    print("  got=" + oren_int_to_string(got))
    print("  want=" + oren_int_to_string(want))
    return fail(code, msg)
}

fn f32_bits_at(buf, idx) {
    return oren_f32_to_u32_bits(oren_buf_load_f32(buf, idx))
}

fn f64_bits_at(buf, idx) {
    return oren_f64_to_u64_bits(oren_buf_load_f64(buf, idx))
}

fn hash_u32_mix(h, x) {
    // Simple wrap-around mixer (deterministic).
    return (h * 16777619) + x
}

fn hash_u64_mix(h, x) {
    // Same idea as hash_u32_mix, but for 64-bit words.
    return (h * 1099511628211) + x
}

fn run_dot_i32() {
    var n = 1024
    var a = oren_i32_buf_new(n)
    var b = oren_i32_buf_new(n)
    if oren_is_err(a) { return fail(100, "alloc a (i32 dot)") }
    if oren_is_err(b) { return fail(101, "alloc b (i32 dot)") }

    var i = 0
    while i < n {
        oren_buf_store_i32(a, i, (i * 3) - 7)
        oren_buf_store_i32(b, i, (i * 5) + 11)
        i = i + 1
    }

    var ref = 0
    i = 0
    while i < n {
        ref = ref + (oren_buf_load_i32(a, i) * oren_buf_load_i32(b, i))
        i = i + 1
    }

    var dot = oren_buf_dot_i32(a, b)
    if oren_is_err(dot) { return fail(102, "dot returned err (i32)") }
    if assert_eq_i64(dot, ref, 103, "dot mismatch (i32)") != 0 { return 1 }

    print("DOT_I32=" + oren_int_to_string(dot))
    return 0
}

fn run_dot_i32_4_microkernel() {
    // 1x4 dot microkernel boundary for i32: compute 4 dot products at once into an i64 buffer.
    var n = 256
    var a = oren_i32_buf_new(n)
    var b = oren_i32_buf_new(4 * n)
    var out = oren_i64_buf_new(4)
    if oren_is_err(a) { return fail(150, "alloc a (i32 dot_4)") }
    if oren_is_err(b) { return fail(151, "alloc b (i32 dot_4)") }
    if oren_is_err(out) { return fail(152, "alloc out (i32 dot_4)") }

    var i = 0
    while i < n {
        var av = (i * 3) - 7
        var b0 = (i * 5) + 11
        var b1 = (i * 7) - 13
        var b2 = (i * 11) + 17
        var b3 = (i * 13) - 19
        oren_buf_store_i32(a, i, av)
        oren_buf_store_i32(b, 0 * n + i, b0)
        oren_buf_store_i32(b, 1 * n + i, b1)
        oren_buf_store_i32(b, 2 * n + i, b2)
        oren_buf_store_i32(b, 3 * n + i, b3)
        i = i + 1
    }

    var ref0 = 0
    var ref1 = 0
    var ref2 = 0
    var ref3 = 0
    i = 0
    while i < n {
        var aa = oren_buf_load_i32(a, i)
        ref0 = ref0 + aa * oren_buf_load_i32(b, 0 * n + i)
        ref1 = ref1 + aa * oren_buf_load_i32(b, 1 * n + i)
        ref2 = ref2 + aa * oren_buf_load_i32(b, 2 * n + i)
        ref3 = ref3 + aa * oren_buf_load_i32(b, 3 * n + i)
        i = i + 1
    }

    var r = oren_buf_dot_i32_4_slice_into(out, 0, a, 0, b, 0 * n, 1 * n, 2 * n, 3 * n, n)
    if oren_is_err(r) { return fail(153, "dot_i32_4 returned err") }

    if oren_buf_load_i64(out, 0) != ref0 { return fail(160, "dot_i32_4 mismatch [0]") }
    if oren_buf_load_i64(out, 1) != ref1 { return fail(161, "dot_i32_4 mismatch [1]") }
    if oren_buf_load_i64(out, 2) != ref2 { return fail(162, "dot_i32_4 mismatch [2]") }
    if oren_buf_load_i64(out, 3) != ref3 { return fail(163, "dot_i32_4 mismatch [3]") }

    print("DOT_I32_4_0=" + oren_int_to_string(ref0))
    return 0
}

fn run_i32_buf_ops() {
    var n = 1024
    var a = oren_i32_buf_new(n)
    var b = oren_i32_buf_new(n)
    var out_add = oren_i32_buf_new(n)
    var out_mul = oren_i32_buf_new(n)
    if oren_is_err(a) { return fail(200, "alloc a (i32 ops)") }
    if oren_is_err(b) { return fail(201, "alloc b (i32 ops)") }
    if oren_is_err(out_add) { return fail(202, "alloc out_add (i32 ops)") }
    if oren_is_err(out_mul) { return fail(203, "alloc out_mul (i32 ops)") }

    var i = 0
    while i < n {
        oren_buf_store_i32(a, i, (i * 7) - 12345)
        oren_buf_store_i32(b, i, (i * 11) + 999)
        i = i + 1
    }

    var ref_add_sum = 0
    var ref_mul_sum = 0
    i = 0
    while i < n {
        var xa = oren_buf_load_i32(a, i)
        var xb = oren_buf_load_i32(b, i)
        oren_buf_store_i32(out_add, i, xa + xb)
        oren_buf_store_i32(out_mul, i, xa * xb)
        ref_add_sum = ref_add_sum + oren_buf_load_i32(out_add, i)
        ref_mul_sum = ref_mul_sum + oren_buf_load_i32(out_mul, i)
        i = i + 1
    }

    var out2_add = oren_i32_buf_new(n)
    var out2_mul = oren_i32_buf_new(n)
    if oren_is_err(out2_add) { return fail(204, "alloc out2_add (i32 ops)") }
    if oren_is_err(out2_mul) { return fail(205, "alloc out2_mul (i32 ops)") }

    var r1 = oren_buf_add_i32_into(out2_add, a, b)
    if oren_is_err(r1) { return fail(206, "buf_add_i32_into err") }
    var r2 = oren_buf_mul_i32_into(out2_mul, a, b)
    if oren_is_err(r2) { return fail(207, "buf_mul_i32_into err") }

    var got_add_sum = 0
    var got_mul_sum = 0
    i = 0
    while i < n {
        got_add_sum = got_add_sum + oren_buf_load_i32(out2_add, i)
        got_mul_sum = got_mul_sum + oren_buf_load_i32(out2_mul, i)
        i = i + 1
    }

    if got_add_sum != ref_add_sum { return fail(220, "add sum mismatch (i32)") }
    if got_mul_sum != ref_mul_sum { return fail(221, "mul sum mismatch (i32)") }

    print("I32_ADD_SUM=" + oren_int_to_string(got_add_sum))
    print("I32_MUL_SUM=" + oren_int_to_string(got_mul_sum))
    return 0
}

fn run_f32_buf_ops() {
    var n = 1024
    var a = oren_f32_buf_new(n)
    var b = oren_f32_buf_new(n)
    var out_add = oren_f32_buf_new(n)
    var out_mul = oren_f32_buf_new(n)
    if oren_is_err(a) { return fail(300, "alloc a (f32 ops)") }
    if oren_is_err(b) { return fail(301, "alloc b (f32 ops)") }
    if oren_is_err(out_add) { return fail(302, "alloc out_add (f32 ops)") }
    if oren_is_err(out_mul) { return fail(303, "alloc out_mul (f32 ops)") }

    var i = 0
    while i < n {
        oren_buf_store_f32(a, i, f64(i % 97) - 41.0)
        oren_buf_store_f32(b, i, f64((i * 3) % 89) - 22.0)
        i = i + 1
    }

    i = 0
    while i < n {
        var xa = oren_buf_load_f32(a, i)
        var xb = oren_buf_load_f32(b, i)
        oren_buf_store_f32(out_add, i, xa + xb)
        oren_buf_store_f32(out_mul, i, xa * xb)
        i = i + 1
    }

    var out2_add = oren_f32_buf_new(n)
    var out2_mul = oren_f32_buf_new(n)
    if oren_is_err(out2_add) { return fail(304, "alloc out2_add (f32 ops)") }
    if oren_is_err(out2_mul) { return fail(305, "alloc out2_mul (f32 ops)") }

    var r1 = oren_buf_add_f32_into(out2_add, a, b)
    if oren_is_err(r1) { return fail(306, "buf_add_f32_into err") }
    var r2 = oren_buf_mul_f32_into(out2_mul, a, b)
    if oren_is_err(r2) { return fail(307, "buf_mul_f32_into err") }

    var h_add = 2166136261
    var h_mul = 2166136261
    i = 0
    while i < n {
        var refA = f32_bits_at(out_add, i)
        var gotA = f32_bits_at(out2_add, i)
        if refA != gotA { return fail(320, "add bits mismatch (f32)") }
        var refM = f32_bits_at(out_mul, i)
        var gotM = f32_bits_at(out2_mul, i)
        if refM != gotM { return fail(321, "mul bits mismatch (f32)") }
        h_add = hash_u32_mix(h_add, gotA)
        h_mul = hash_u32_mix(h_mul, gotM)
        i = i + 1
    }

    print("F32_ADD_HASH=" + oren_int_to_string(h_add))
    print("F32_MUL_HASH=" + oren_int_to_string(h_mul))
    return 0
}

fn run_dot_f32() {
    var n = 1024
    var a = oren_f32_buf_new(n)
    var b = oren_f32_buf_new(n)
    if oren_is_err(a) { return fail(400, "alloc a (f32 dot)") }
    if oren_is_err(b) { return fail(401, "alloc b (f32 dot)") }

    var i = 0
    while i < n {
        oren_buf_store_f32(a, i, f64(i % 97) - 41.0)
        oren_buf_store_f32(b, i, f64((i * 3) % 89) - 22.0)
        i = i + 1
    }

    var ref = 0.0
    i = 0
    while i < n {
        ref = ref + (oren_buf_load_f32(a, i) * oren_buf_load_f32(b, i))
        i = i + 1
    }

    var dot = oren_buf_dot_f32(a, b)
    if oren_is_err(dot) { return fail(402, "dot returned err (f32)") }

    var ref_bits = oren_f64_to_u64_bits(ref)
    var dot_bits = oren_f64_to_u64_bits(dot)
    if ref_bits != dot_bits { return fail(420, "dot mismatch (f32)") }

    print("DOT_F32_BITS=" + oren_int_to_string(dot_bits))
    return 0
}

fn run_dot_f32_4_microkernel() {
    // 1x4 dot microkernel boundary for f32: compute 4 dot products at once into an f64 buffer.
    var n = 256
    var a = oren_f32_buf_new(n)
    var b = oren_f32_buf_new(4 * n)
    var out = oren_f64_buf_new(4)
    if oren_is_err(a) { return fail(430, "alloc a (f32 dot_4)") }
    if oren_is_err(b) { return fail(431, "alloc b (f32 dot_4)") }
    if oren_is_err(out) { return fail(432, "alloc out (f32 dot_4)") }

    var i = 0
    while i < n {
        // Keep values modest; f32 rounding happens at store boundary deterministically.
        var av = f64(i % 97) - 41.0
        var b0 = f64((i * 3) % 89) - 22.0
        var b1 = f64((i * 5) % 83) - 17.0
        var b2 = f64((i * 7) % 79) - 13.0
        var b3 = f64((i * 11) % 73) - 9.0
        oren_buf_store_f32(a, i, av)
        oren_buf_store_f32(b, 0 * n + i, b0)
        oren_buf_store_f32(b, 1 * n + i, b1)
        oren_buf_store_f32(b, 2 * n + i, b2)
        oren_buf_store_f32(b, 3 * n + i, b3)
        i = i + 1
    }

    var ref0 = 0.0
    var ref1 = 0.0
    var ref2 = 0.0
    var ref3 = 0.0
    i = 0
    while i < n {
        var aa = oren_buf_load_f32(a, i)
        ref0 = ref0 + aa * oren_buf_load_f32(b, 0 * n + i)
        ref1 = ref1 + aa * oren_buf_load_f32(b, 1 * n + i)
        ref2 = ref2 + aa * oren_buf_load_f32(b, 2 * n + i)
        ref3 = ref3 + aa * oren_buf_load_f32(b, 3 * n + i)
        i = i + 1
    }

    var r = oren_buf_dot_f32_4_slice_into(out, 0, a, 0, b, 0 * n, 1 * n, 2 * n, 3 * n, n)
    if oren_is_err(r) { return fail(433, "dot_f32_4 returned err") }

    var ref0_bits = oren_f64_to_u64_bits(ref0)
    var ref1_bits = oren_f64_to_u64_bits(ref1)
    var ref2_bits = oren_f64_to_u64_bits(ref2)
    var ref3_bits = oren_f64_to_u64_bits(ref3)
    var got0_bits = f64_bits_at(out, 0)
    var got1_bits = f64_bits_at(out, 1)
    var got2_bits = f64_bits_at(out, 2)
    var got3_bits = f64_bits_at(out, 3)
    if ref0_bits != got0_bits { return fail(440, "dot_f32_4 mismatch [0]") }
    if ref1_bits != got1_bits { return fail(441, "dot_f32_4 mismatch [1]") }
    if ref2_bits != got2_bits { return fail(442, "dot_f32_4 mismatch [2]") }
    if ref3_bits != got3_bits { return fail(443, "dot_f32_4 mismatch [3]") }

    print("DOT_F32_4_BITS0=" + oren_int_to_string(got0_bits))
    return 0
}

fn run_dot_f64_4_microkernel() {
    // 1x4 dot microkernel boundary for f64: compute 4 dot products at once into an f64 buffer.
    var n = 256
    var a = oren_f64_buf_new(n)
    var b = oren_f64_buf_new(4 * n)
    var out = oren_f64_buf_new(4)
    if oren_is_err(a) { return fail(450, "alloc a (f64 dot_4)") }
    if oren_is_err(b) { return fail(451, "alloc b (f64 dot_4)") }
    if oren_is_err(out) { return fail(452, "alloc out (f64 dot_4)") }

    var i = 0
    while i < n {
        // Keep values moderate and deterministic.
        var av = (f64(i % 101) - 50.0) * 0.125
        var b0 = (f64((i * 3) % 97) - 48.0) * 0.25
        var b1 = (f64((i * 5) % 89) - 44.0) * 0.5
        var b2 = (f64((i * 7) % 83) - 41.0) * 0.75
        var b3 = (f64((i * 11) % 79) - 39.0) * 1.25
        oren_buf_store_f64(a, i, av)
        oren_buf_store_f64(b, 0 * n + i, b0)
        oren_buf_store_f64(b, 1 * n + i, b1)
        oren_buf_store_f64(b, 2 * n + i, b2)
        oren_buf_store_f64(b, 3 * n + i, b3)
        i = i + 1
    }

    var ref0 = 0.0
    var ref1 = 0.0
    var ref2 = 0.0
    var ref3 = 0.0
    i = 0
    while i < n {
        var aa = oren_buf_load_f64(a, i)
        ref0 = ref0 + aa * oren_buf_load_f64(b, 0 * n + i)
        ref1 = ref1 + aa * oren_buf_load_f64(b, 1 * n + i)
        ref2 = ref2 + aa * oren_buf_load_f64(b, 2 * n + i)
        ref3 = ref3 + aa * oren_buf_load_f64(b, 3 * n + i)
        i = i + 1
    }

    var r = oren_buf_dot_f64_4_slice_into(out, 0, a, 0, b, 0 * n, 1 * n, 2 * n, 3 * n, n)
    if oren_is_err(r) { return fail(453, "dot_f64_4 returned err") }

    var ref0_bits = oren_f64_to_u64_bits(ref0)
    var ref1_bits = oren_f64_to_u64_bits(ref1)
    var ref2_bits = oren_f64_to_u64_bits(ref2)
    var ref3_bits = oren_f64_to_u64_bits(ref3)
    var got0_bits = f64_bits_at(out, 0)
    var got1_bits = f64_bits_at(out, 1)
    var got2_bits = f64_bits_at(out, 2)
    var got3_bits = f64_bits_at(out, 3)
    if ref0_bits != got0_bits { return fail(454, "dot_f64_4 mismatch [0]") }
    if ref1_bits != got1_bits { return fail(455, "dot_f64_4 mismatch [1]") }
    if ref2_bits != got2_bits { return fail(456, "dot_f64_4 mismatch [2]") }
    if ref3_bits != got3_bits { return fail(457, "dot_f64_4 mismatch [3]") }

    print("DOT_F64_4_BITS0=" + oren_int_to_string(got0_bits))
    return 0
}

fn run_gemm_f32_4x4_microkernel() {
    // 4x4 GEMM microkernel boundary for f32: compute 16 dot products (4 rows x 4 cols) in one pass.
    var n = 128
    var a = oren_f32_buf_new(4 * n)
    var b = oren_f32_buf_new(4 * n)
    var out = oren_f64_buf_new(16)
    if oren_is_err(a) { return fail(460, "alloc a (f32 gemm_4x4)") }
    if oren_is_err(b) { return fail(461, "alloc b (f32 gemm_4x4)") }
    if oren_is_err(out) { return fail(462, "alloc out (f32 gemm_4x4)") }

    var i = 0
    while i < n {
        // Distinct row/col patterns to avoid accidental symmetry.
        var a0 = (f64(i % 97) - 41.0) * 0.125
        var a1 = (f64((i * 3) % 89) - 22.0) * 0.25
        var a2 = (f64((i * 5) % 83) - 17.0) * 0.5
        var a3 = (f64((i * 7) % 79) - 13.0) * 0.75

        var b0 = (f64((i * 11) % 73) - 9.0) * 0.1
        var b1 = (f64((i * 13) % 71) - 7.0) * 0.2
        var b2 = (f64((i * 17) % 67) - 5.0) * 0.3
        var b3 = (f64((i * 19) % 61) - 3.0) * 0.4

        // A rows are stored sequentially: row r at offset r*n.
        oren_buf_store_f32(a, 0 * n + i, a0)
        oren_buf_store_f32(a, 1 * n + i, a1)
        oren_buf_store_f32(a, 2 * n + i, a2)
        oren_buf_store_f32(a, 3 * n + i, a3)

        // B columns stored sequentially as column-major slices (same layout expected by microkernel signature).
        oren_buf_store_f32(b, 0 * n + i, b0)
        oren_buf_store_f32(b, 1 * n + i, b1)
        oren_buf_store_f32(b, 2 * n + i, b2)
        oren_buf_store_f32(b, 3 * n + i, b3)

        i = i + 1
    }

    // Reference (deterministic scalar, f64 accumulation).
    var ref = oren_f64_buf_new(16)
    if oren_is_err(ref) { return fail(463, "alloc ref (f32 gemm_4x4)") }
    var r = 0
    while r < 4 {
        var c = 0
        while c < 4 {
            var s = 0.0
            i = 0
            while i < n {
                var av = oren_buf_load_f32(a, r * n + i)
                var bv = oren_buf_load_f32(b, c * n + i)
                s = s + av * bv
                i = i + 1
            }
            oren_buf_store_f64(ref, r * 4 + c, s)
            c = c + 1
        }
        r = r + 1
    }

    var rr = oren_buf_gemm_f32_4x4_slice_into(out, 0, a, 0 * n, 1 * n, 2 * n, 3 * n, b, 0 * n, 1 * n, 2 * n, 3 * n, n)
    if oren_is_err(rr) { return fail(464, "gemm_f32_4x4 returned err") }

    var idx = 0
    while idx < 16 {
        var ref_bits = f64_bits_at(ref, idx)
        var got_bits = f64_bits_at(out, idx)
        if ref_bits != got_bits {
            print("GEMM_4X4_MISMATCH_IDX=" + oren_int_to_string(idx))
            print("GEMM_4X4_REF_BITS=" + oren_int_to_string(ref_bits))
            print("GEMM_4X4_GOT_BITS=" + oren_int_to_string(got_bits))
            return fail(470, "gemm_f32_4x4 mismatch")
        }
        idx = idx + 1
    }

    print("GEMM_4X4_OK=1")
    return 0
}

fn run_gemm_f64_4x4_microkernel() {
    // 4x4 GEMM microkernel boundary for f64: compute 16 dot products (4 rows x 4 cols) in one pass.
    //
    // This test is also a determinism guard: SIMD and scalar paths must be bit-identical.
    // Choose values that are *not* all exactly representable so any accidental FMA/reassociation shows up.
    var n = 65 // odd to exercise tail
    var a = oren_f64_buf_new(4 * n)
    var b = oren_f64_buf_new(4 * n)
    var out = oren_f64_buf_new(16)
    if oren_is_err(a) { return fail(475, "alloc a (f64 gemm_4x4)") }
    if oren_is_err(b) { return fail(476, "alloc b (f64 gemm_4x4)") }
    if oren_is_err(out) { return fail(477, "alloc out (f64 gemm_4x4)") }

    var i = 0
    while i < n {
        // Use mixed patterns; include non-power-of-two fractions (0.1/0.2/0.3/0.4) to avoid accidental exactness.
        var a0 = (f64(i % 97) - 41.0) * 0.125 + 0.1
        var a1 = (f64((i * 3) % 89) - 22.0) * 0.25 + 0.2
        var a2 = (f64((i * 5) % 83) - 17.0) * 0.5 + 0.3
        var a3 = (f64((i * 7) % 79) - 13.0) * 0.75 + 0.4

        var b0 = (f64((i * 11) % 73) - 9.0) * 0.1 + 0.125
        var b1 = (f64((i * 13) % 71) - 7.0) * 0.2 + 0.25
        var b2 = (f64((i * 17) % 67) - 5.0) * 0.3 + 0.5
        var b3 = (f64((i * 19) % 61) - 3.0) * 0.4 + 0.75

        // A rows stored sequentially: row r at offset r*n.
        oren_buf_store_f64(a, 0 * n + i, a0)
        oren_buf_store_f64(a, 1 * n + i, a1)
        oren_buf_store_f64(a, 2 * n + i, a2)
        oren_buf_store_f64(a, 3 * n + i, a3)

        // B columns stored sequentially as column-major slices (layout expected by microkernel signature).
        oren_buf_store_f64(b, 0 * n + i, b0)
        oren_buf_store_f64(b, 1 * n + i, b1)
        oren_buf_store_f64(b, 2 * n + i, b2)
        oren_buf_store_f64(b, 3 * n + i, b3)
        i = i + 1
    }

    // Reference (deterministic scalar, strict k-order).
    var ref = oren_f64_buf_new(16)
    if oren_is_err(ref) { return fail(478, "alloc ref (f64 gemm_4x4)") }
    var r = 0
    while r < 4 {
        var c = 0
        while c < 4 {
            var s = 0.0
            i = 0
            while i < n {
                s = s + oren_buf_load_f64(a, r * n + i) * oren_buf_load_f64(b, c * n + i)
                i = i + 1
            }
            oren_buf_store_f64(ref, r * 4 + c, s)
            c = c + 1
        }
        r = r + 1
    }

    var rr = oren_buf_gemm_f64_4x4_slice_into(out, 0, a, 0 * n, 1 * n, 2 * n, 3 * n, b, 0 * n, 1 * n, 2 * n, 3 * n, n)
    if oren_is_err(rr) { return fail(479, "gemm_f64_4x4 returned err") }

    var h = 1469598103934665603
    var idx = 0
    while idx < 16 {
        var ref_bits = f64_bits_at(ref, idx)
        var got_bits = f64_bits_at(out, idx)
        if ref_bits != got_bits {
            print("GEMM_F64_4X4_MISMATCH_IDX=" + oren_int_to_string(idx))
            print("GEMM_F64_4X4_REF_BITS=" + oren_int_to_string(ref_bits))
            print("GEMM_F64_4X4_GOT_BITS=" + oren_int_to_string(got_bits))
            return fail(480, "gemm_f64_4x4 mismatch")
        }
        h = hash_u64_mix(h, got_bits)
        idx = idx + 1
    }

    print("GEMM_F64_4X4_HASH=" + oren_int_to_string(h))
    return 0
}

fn run_gemm_i32_4x4_microkernel() {
    // 4x4 GEMM microkernel boundary for i32: compute 16 dot products (4 rows x 4 cols) in one pass.
    // Output is i64 (wrap semantics are still deterministic; we keep inputs small to avoid overflow).
    var n = 65 // odd to exercise tail
    var a = oren_i32_buf_new(4 * n)
    var b = oren_i32_buf_new(4 * n)
    var out = oren_i64_buf_new(16)
    if oren_is_err(a) { return fail(485, "alloc a (i32 gemm_4x4)") }
    if oren_is_err(b) { return fail(486, "alloc b (i32 gemm_4x4)") }
    if oren_is_err(out) { return fail(487, "alloc out (i32 gemm_4x4)") }

    var i = 0
    while i < n {
        // Distinct row/col patterns; include negatives.
        var a0 = (i * 3) - 7
        var a1 = (i * 5) - 11
        var a2 = (i * 7) - 13
        var a3 = (i * 11) - 17

        var b0 = (i * 2) + 19
        var b1 = (i * 3) - 23
        var b2 = (i * 5) + 29
        var b3 = (i * 7) - 31

        oren_buf_store_i32(a, 0 * n + i, a0)
        oren_buf_store_i32(a, 1 * n + i, a1)
        oren_buf_store_i32(a, 2 * n + i, a2)
        oren_buf_store_i32(a, 3 * n + i, a3)

        // Column-major slices.
        oren_buf_store_i32(b, 0 * n + i, b0)
        oren_buf_store_i32(b, 1 * n + i, b1)
        oren_buf_store_i32(b, 2 * n + i, b2)
        oren_buf_store_i32(b, 3 * n + i, b3)
        i = i + 1
    }

    // Reference (scalar i64 accumulation).
    var ref = oren_i64_buf_new(16)
    if oren_is_err(ref) { return fail(488, "alloc ref (i32 gemm_4x4)") }
    var r = 0
    while r < 4 {
        var c = 0
        while c < 4 {
            var s = 0
            i = 0
            while i < n {
                s = s + (oren_buf_load_i32(a, r * n + i) * oren_buf_load_i32(b, c * n + i))
                i = i + 1
            }
            oren_buf_store_i64(ref, r * 4 + c, s)
            c = c + 1
        }
        r = r + 1
    }

    var rr = oren_buf_gemm_i32_4x4_slice_into(out, 0, a, 0 * n, 1 * n, 2 * n, 3 * n, b, 0 * n, 1 * n, 2 * n, 3 * n, n)
    if oren_is_err(rr) { return fail(489, "gemm_i32_4x4 returned err") }

    var idx = 0
    while idx < 16 {
        var got = oren_buf_load_i64(out, idx)
        var want = oren_buf_load_i64(ref, idx)
        if got != want {
            print("GEMM_I32_4X4_MISMATCH_IDX=" + oren_int_to_string(idx))
            print("GEMM_I32_4X4_GOT=" + oren_int_to_string(got))
            print("GEMM_I32_4X4_WANT=" + oren_int_to_string(want))
            return fail(490, "gemm_i32_4x4 mismatch")
        }
        idx = idx + 1
    }

    print("GEMM_I32_4X4_OK=1")
    return 0
}

fn run_reduce_sum_f32() {
    var n = 2048
    var a = oren_f32_buf_new(n)
    if oren_is_err(a) { return fail(500, "alloc a (reduce_sum f32)") }

    var i = 0
    while i < n {
        // Keep values modest to reduce overflow/NaN risk while still exercising SIMD.
        oren_buf_store_f32(a, i, (f64(i % 257) - 100.0) * 0.125)
        i = i + 1
    }

    var ref = 0.0
    i = 0
    while i < n {
        ref = ref + oren_buf_load_f32(a, i)
        i = i + 1
    }

    var sum = oren_buf_reduce_sum_f32(a)
    if oren_is_err(sum) { return fail(501, "reduce_sum returned err (f32)") }

    var ref_bits = oren_f64_to_u64_bits(ref)
    var sum_bits = oren_f64_to_u64_bits(sum)
    if ref_bits != sum_bits { return fail(520, "reduce_sum mismatch (f32)") }

    print("SUM_F32_BITS=" + oren_int_to_string(sum_bits))
    return 0
}

fn run_axpy_f32() {
    var n = 1024
    var x = oren_f32_buf_new(n)
    var y = oren_f32_buf_new(n)
    var out_ref = oren_f32_buf_new(n)
    var out_got = oren_f32_buf_new(n)
    if oren_is_err(x) { return fail(600, "alloc x (axpy f32)") }
    if oren_is_err(y) { return fail(601, "alloc y (axpy f32)") }
    if oren_is_err(out_ref) { return fail(602, "alloc out_ref (axpy f32)") }
    if oren_is_err(out_got) { return fail(603, "alloc out_got (axpy f32)") }

    var i = 0
    while i < n {
        oren_buf_store_f32(x, i, f64(i % 97) - 41.0)
        oren_buf_store_f32(y, i, f64((i * 5) % 113) - 55.0)
        i = i + 1
    }

    // Use a non-exact float to ensure we match true float32 mul+add semantics (not f64 fused math).
    var alpha = 0.1
    var alpha_bits = oren_f32_to_u32_bits(alpha)
    var alpha32 = oren_u32_bits_to_f32(alpha_bits)
    i = 0
    while i < n {
        var xv = oren_buf_load_f32(x, i)
        var yv = oren_buf_load_f32(y, i)
        var m = oren_u32_bits_to_f32(oren_f32_to_u32_bits(alpha32 * xv))
        var outv = oren_u32_bits_to_f32(oren_f32_to_u32_bits(m + yv))
        oren_buf_store_f32(out_ref, i, outv)
        i = i + 1
    }

    var r = oren_buf_axpy_f32_into(out_got, alpha, x, y)
    if oren_is_err(r) { return fail(604, "axpy_f32_into returned err") }

    var h = 2166136261
    i = 0
    while i < n {
        var refB = f32_bits_at(out_ref, i)
        var gotB = f32_bits_at(out_got, i)
        if refB != gotB {
            print("AXPY_F32_MISMATCH_IDX=" + oren_int_to_string(i))
            print("AXPY_F32_REF_BITS=" + oren_int_to_string(refB))
            print("AXPY_F32_GOT_BITS=" + oren_int_to_string(gotB))
            return fail(620, "axpy bits mismatch (f32)")
        }
        h = hash_u32_mix(h, gotB)
        i = i + 1
    }

    print("AXPY_F32_HASH=" + oren_int_to_string(h))
    return 0
}

fn run_axpy_i32() {
    var n = 1024
    var x = oren_i32_buf_new(n)
    var y = oren_i32_buf_new(n)
    var out_ref = oren_i32_buf_new(n)
    var out_got = oren_i32_buf_new(n)
    if oren_is_err(x) { return fail(700, "alloc x (axpy i32)") }
    if oren_is_err(y) { return fail(701, "alloc y (axpy i32)") }
    if oren_is_err(out_ref) { return fail(702, "alloc out_ref (axpy i32)") }
    if oren_is_err(out_got) { return fail(703, "alloc out_got (axpy i32)") }

    var i = 0
    while i < n {
        oren_buf_store_i32(x, i, (i * 13) - 999)
        oren_buf_store_i32(y, i, (i * 7) + 12345)
        i = i + 1
    }

    var alpha = 7
    i = 0
    while i < n {
        var xv = oren_buf_load_i32(x, i)
        var yv = oren_buf_load_i32(y, i)
        // i32 wrap semantics
        oren_buf_store_i32(out_ref, i, (alpha * xv) + yv)
        i = i + 1
    }

    var r = oren_buf_axpy_i32_into(out_got, alpha, x, y)
    if oren_is_err(r) { return fail(704, "axpy_i32_into returned err") }

    var sum = 0
    i = 0
    while i < n {
        var refV = oren_buf_load_i32(out_ref, i)
        var gotV = oren_buf_load_i32(out_got, i)
        if refV != gotV {
            print("AXPY_I32_MISMATCH_IDX=" + oren_int_to_string(i))
            print("AXPY_I32_REF=" + oren_int_to_string(refV))
            print("AXPY_I32_GOT=" + oren_int_to_string(gotV))
            return fail(720, "axpy mismatch (i32)")
        }
        sum = sum + gotV
        i = i + 1
    }

    print("AXPY_I32_SUM=" + oren_int_to_string(sum))
    return 0
}

fn run_scale_f32_into() {
    var n = 1024
    var a = oren_f32_buf_new(n)
    var out_ref = oren_f32_buf_new(n)
    var out_got = oren_f32_buf_new(n)
    if oren_is_err(a) { return fail(800, "alloc a (scale f32)") }
    if oren_is_err(out_ref) { return fail(801, "alloc out_ref (scale f32)") }
    if oren_is_err(out_got) { return fail(802, "alloc out_got (scale f32)") }

    var i = 0
    while i < n {
        oren_buf_store_f32(a, i, f64(i % 97) - 41.0)
        i = i + 1
    }

    // Use a non-exact float to ensure scalar boundary + SIMD use the same float32 semantics.
    var s = 0.1
    var sbits = oren_f32_to_u32_bits(s)
    var s32 = oren_u32_bits_to_f32(sbits)
    i = 0
    while i < n {
        var av = oren_buf_load_f32(a, i)
        var outv = oren_u32_bits_to_f32(oren_f32_to_u32_bits(av * s32))
        oren_buf_store_f32(out_ref, i, outv)
        i = i + 1
    }

    var r = oren_buf_scale_f32_into(out_got, a, s)
    if oren_is_err(r) { return fail(803, "scale_f32_into returned err") }

    var h = 2166136261
    i = 0
    while i < n {
        var refB = f32_bits_at(out_ref, i)
        var gotB = f32_bits_at(out_got, i)
        if refB != gotB {
            print("SCALE_F32_MISMATCH_IDX=" + oren_int_to_string(i))
            print("SCALE_F32_REF_BITS=" + oren_int_to_string(refB))
            print("SCALE_F32_GOT_BITS=" + oren_int_to_string(gotB))
            return fail(820, "scale bits mismatch (f32)")
        }
        h = hash_u32_mix(h, gotB)
        i = i + 1
    }

    print("SCALE_F32_HASH=" + oren_int_to_string(h))
    return 0
}

fn run_scale_i32_into() {
    var n = 1024
    var a = oren_i32_buf_new(n)
    var out_ref = oren_i32_buf_new(n)
    var out_got = oren_i32_buf_new(n)
    if oren_is_err(a) { return fail(900, "alloc a (scale i32)") }
    if oren_is_err(out_ref) { return fail(901, "alloc out_ref (scale i32)") }
    if oren_is_err(out_got) { return fail(902, "alloc out_got (scale i32)") }

    var i = 0
    while i < n {
        oren_buf_store_i32(a, i, (i * 13) - 999)
        i = i + 1
    }

    var s = 7
    i = 0
    while i < n {
        oren_buf_store_i32(out_ref, i, oren_buf_load_i32(a, i) * s)
        i = i + 1
    }

    var r = oren_buf_scale_i32_into(out_got, a, s)
    if oren_is_err(r) { return fail(903, "scale_i32_into returned err") }

    var sum = 0
    i = 0
    while i < n {
        var refV = oren_buf_load_i32(out_ref, i)
        var gotV = oren_buf_load_i32(out_got, i)
        if refV != gotV {
            print("SCALE_I32_MISMATCH_IDX=" + oren_int_to_string(i))
            print("SCALE_I32_REF=" + oren_int_to_string(refV))
            print("SCALE_I32_GOT=" + oren_int_to_string(gotV))
            return fail(920, "scale mismatch (i32)")
        }
        sum = sum + gotV
        i = i + 1
    }

    print("SCALE_I32_SUM=" + oren_int_to_string(sum))
    return 0
}

fn run_i64_buf_ops() {
    var n = 513 // odd length
    var a = oren_i64_buf_new(n)
    var b = oren_i64_buf_new(n)
    var out_ref = oren_i64_buf_new(n)
    var out_got = oren_i64_buf_new(n)
    if oren_is_err(a) { return fail(950, "alloc a (i64)") }
    if oren_is_err(b) { return fail(951, "alloc b (i64)") }
    if oren_is_err(out_ref) { return fail(952, "alloc out_ref (i64)") }
    if oren_is_err(out_got) { return fail(953, "alloc out_got (i64)") }

    var i = 0
    while i < n {
        oren_buf_store_i64(a, i, (i * 7) - 123456)
        oren_buf_store_i64(b, i, (i * 11) + 7777)
        i = i + 1
    }

    i = 0
    while i < n {
        oren_buf_store_i64(out_ref, i, oren_buf_load_i64(a, i) + oren_buf_load_i64(b, i))
        i = i + 1
    }

    var r = oren_buf_add_i64_into(out_got, a, b)
    if oren_is_err(r) { return fail(954, "buf_add_i64_into err") }

    var sum = 0
    i = 0
    while i < n {
        var refV = oren_buf_load_i64(out_ref, i)
        var gotV = oren_buf_load_i64(out_got, i)
        if refV != gotV { return fail(960, "add mismatch (i64)") }
        sum = sum + gotV
        i = i + 1
    }
    print("I64_ADD_SUM=" + oren_int_to_string(sum))
    return 0
}

fn run_f64_buf_ops() {
    var n = 513 // odd length to test tail handling
    var a = oren_f64_buf_new(n)
    var b = oren_f64_buf_new(n)
    var out_add_ref = oren_f64_buf_new(n)
    var out_mul_ref = oren_f64_buf_new(n)
    var out_add_got = oren_f64_buf_new(n)
    var out_mul_got = oren_f64_buf_new(n)
    if oren_is_err(a) { return fail(1000, "alloc a (f64)") }
    if oren_is_err(b) { return fail(1001, "alloc b (f64)") }
    if oren_is_err(out_add_ref) { return fail(1002, "alloc out_add_ref (f64)") }
    if oren_is_err(out_mul_ref) { return fail(1003, "alloc out_mul_ref (f64)") }
    if oren_is_err(out_add_got) { return fail(1004, "alloc out_add_got (f64)") }
    if oren_is_err(out_mul_got) { return fail(1005, "alloc out_mul_got (f64)") }

    var i = 0
    while i < n {
        // Integers are exactly representable in f64, keeps bitwise comparisons stable.
        oren_buf_store_f64(a, i, f64(i % 97) - 41.0)
        oren_buf_store_f64(b, i, f64((i * 3) % 89) - 22.0)
        i = i + 1
    }

    i = 0
    while i < n {
        var xa = oren_buf_load_f64(a, i)
        var xb = oren_buf_load_f64(b, i)
        oren_buf_store_f64(out_add_ref, i, xa + xb)
        oren_buf_store_f64(out_mul_ref, i, xa * xb)
        i = i + 1
    }

    var r1 = oren_buf_add_f64_into(out_add_got, a, b)
    if oren_is_err(r1) { return fail(1006, "buf_add_f64_into err") }
    var r2 = oren_buf_mul_f64_into(out_mul_got, a, b)
    if oren_is_err(r2) { return fail(1007, "buf_mul_f64_into err") }

    var h_add = 1469598103934665603
    var h_mul = 1469598103934665603
    i = 0
    while i < n {
        var refA = f64_bits_at(out_add_ref, i)
        var gotA = f64_bits_at(out_add_got, i)
        if refA != gotA {
            print("F64_ADD_MISMATCH_IDX=" + oren_int_to_string(i))
            print("F64_ADD_REF_BITS=" + oren_int_to_string(refA))
            print("F64_ADD_GOT_BITS=" + oren_int_to_string(gotA))
            return fail(1020, "add bits mismatch (f64)")
        }
        var refM = f64_bits_at(out_mul_ref, i)
        var gotM = f64_bits_at(out_mul_got, i)
        if refM != gotM {
            print("F64_MUL_MISMATCH_IDX=" + oren_int_to_string(i))
            print("F64_MUL_REF_BITS=" + oren_int_to_string(refM))
            print("F64_MUL_GOT_BITS=" + oren_int_to_string(gotM))
            return fail(1021, "mul bits mismatch (f64)")
        }
        h_add = hash_u64_mix(h_add, gotA)
        h_mul = hash_u64_mix(h_mul, gotM)
        i = i + 1
    }
    print("F64_ADD_HASH=" + oren_int_to_string(h_add))
    print("F64_MUL_HASH=" + oren_int_to_string(h_mul))

    // dot + reduce_sum (f64): compare bitwise.
    var ref_dot = 0.0
    var ref_sum = 0.0
    i = 0
    while i < n {
        ref_dot = ref_dot + (oren_buf_load_f64(a, i) * oren_buf_load_f64(b, i))
        ref_sum = ref_sum + oren_buf_load_f64(a, i)
        i = i + 1
    }
    var got_dot = oren_buf_dot_f64(a, b)
    if oren_is_err(got_dot) { return fail(1030, "dot_f64 err") }
    var got_sum = oren_buf_reduce_sum_f64(a)
    if oren_is_err(got_sum) { return fail(1031, "reduce_sum_f64 err") }
    if oren_f64_to_u64_bits(ref_dot) != oren_f64_to_u64_bits(got_dot) { return fail(1032, "dot mismatch (f64)") }
    if oren_f64_to_u64_bits(ref_sum) != oren_f64_to_u64_bits(got_sum) { return fail(1033, "reduce_sum mismatch (f64)") }
    print("DOT_F64_BITS=" + oren_int_to_string(oren_f64_to_u64_bits(got_dot)))
    print("SUM_F64_BITS=" + oren_int_to_string(oren_f64_to_u64_bits(got_sum)))
    return 0
}

fn main() {
    // Runner compares scalar vs SIMD output; keep stable, parseable key/value lines.
    print("SIMD_ENABLED=" + oren_int_to_string(native_simd_enabled()))

    if run_dot_i32() != 0 { return 1 }
    if run_dot_i32_4_microkernel() != 0 { return 1 }
    if run_i32_buf_ops() != 0 { return 1 }
    if run_f32_buf_ops() != 0 { return 1 }
    if run_dot_f32() != 0 { return 1 }
    if run_dot_f32_4_microkernel() != 0 { return 1 }
    if run_dot_f64_4_microkernel() != 0 { return 1 }
    if run_gemm_f32_4x4_microkernel() != 0 { return 1 }
    if run_gemm_f64_4x4_microkernel() != 0 { return 1 }
    if run_gemm_i32_4x4_microkernel() != 0 { return 1 }
    if run_reduce_sum_f32() != 0 { return 1 }
    if run_axpy_f32() != 0 { return 1 }
    if run_axpy_i32() != 0 { return 1 }
    if run_scale_f32_into() != 0 { return 1 }
    if run_scale_i32_into() != 0 { return 1 }
    if run_i64_buf_ops() != 0 { return 1 }
    if run_f64_buf_ops() != 0 { return 1 }

    return 0
}
