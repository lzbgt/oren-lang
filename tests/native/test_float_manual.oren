var a = 1.5
var b = 2.5
var c = fadd(a, b)
// 1.5 + 2.5 = 4.0
var expected = 4.0

if c != expected {
    print("Mismatch:")
    // print(c) // Prints bits as int
    // print(expected)
    exit(1)
}

var d = fsub(b, a) // 2.5 - 1.5 = 1.0
if d != 1.0 { exit(2) }

var e = fmul(a, 2.0) // 1.5 * 2.0 = 3.0
if e != 3.0 { exit(3) }

var f = fdiv(3.0, 1.5) // 3.0 / 1.5 = 2.0
if f != 2.0 { exit(4) }

print("Float OK")