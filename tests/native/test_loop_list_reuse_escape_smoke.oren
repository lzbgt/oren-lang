fn main() {
    // If loop-list reuse is incorrectly applied when the list escapes,
    // all entries in `out` will alias the same list or contain cleared data.
    var out = []
    var i = 0
    while i < 3 {
        var xs = []
        var j = 0
        while j < 2 {
            oren_list_push(xs, i + j)
            j = j + 1
        }
        oren_list_push(out, xs)
        i = i + 1
    }

    if oren_list_len(out) != 3 { exit(41) }
    var a = oren_list_get(out, 0)
    var b = oren_list_get(out, 1)
    var c = oren_list_get(out, 2)

    // Lists should not alias each other.
    if a == b || b == c || a == c { exit(42) }

    if oren_list_get(a, 0) != 0 || oren_list_get(a, 1) != 1 { exit(43) }
    if oren_list_get(b, 0) != 1 || oren_list_get(b, 1) != 2 { exit(44) }
    if oren_list_get(c, 0) != 2 || oren_list_get(c, 1) != 3 { exit(45) }
}
