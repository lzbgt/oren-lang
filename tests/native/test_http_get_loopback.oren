import http "std:net/http"
import dns "std:net/dns"
import udp "std:net/udp"

fn u16be_at(p, off) {
    var hi = ptr_get_byte(p + off) & 255
    var lo = ptr_get_byte(p + off + 1) & 255
    return (hi << 8) | lo
}

fn _env_truthy(name) {
    var p = oren_getenv(name)
    if p == 0 { return 0 }
    var b = ptr_get_byte(p)
    if b == 0 { return 0 }
    if b == 48 { return 0 } // '0'
    return 1
}

fn _ensure_workers_for_spawned_servers(test_name) {
    // `spawn` prefers in-process green tasks on Tier‑1 (including Windows).
    // These loopback fixtures run servers concurrently with blocking client operations,
    // so enable worker mode up front.
    if _env_truthy("OREN_NO_GREEN") == 1 { return 0 }
    var rcw = oren_green_start_workers(1)
    if rcw != 0 {
        print(test_name + ": FAIL cannot start green workers rc=" + oren_int_to_string(rcw))
        exit(109)
    }
    return 0
}

fn assert_hello_bytes(resp: http.Response, code) {
    var bs = resp.bytes()
    if oren_is_err(bs) {
        print("http_get_loopback: FAIL response bytes error: " + oren_err_msg(bs))
        return code
    }
    if oren_is_u8_buf(bs) != true {
        print("http_get_loopback: FAIL response bytes not u8_buf")
        return code + 1
    }
    if oren_bytes_len(bs) != 5 {
        print("http_get_loopback: FAIL response bytes len")
        return code + 2
    }
    if oren_bytes_get_u8(bs, 0) != 72 || oren_bytes_get_u8(bs, 1) != 69 || oren_bytes_get_u8(bs, 2) != 76 || oren_bytes_get_u8(bs, 3) != 76 || oren_bytes_get_u8(bs, 4) != 79 {
        print("http_get_loopback: FAIL response bytes payload")
        return code + 3
    }
    return 0
}

fn _skip_qname(buf, n, off) {
    // Skip a DNS QNAME (no compression expected in queries).
    var i = off
    while 1 {
        if i >= n { return -1 }
        var l = ptr_get_byte(buf + i) & 255
        i = i + 1
        if l == 0 { return i }
        if l > 63 { return -1 }
        i = i + l
    }
}

fn dns_server_one_a(fd, ip0, ip1, ip2, ip3) {
    // Minimal authoritative DNS server for one query (A/IN).
    // Replies with a single A record containing (ip0..ip3).
    var buf = malloc(512)
    if buf == 0 { return 60 }
    var sa = malloc(16)
    if sa == 0 { free(buf); return 61 }
    var lenp = malloc(8)
    if lenp == 0 { free(buf); free(sa); return 62 }
    ptr_set(lenp, 16)

    var rn = udp.recv_from_into_raw(fd, buf, 512, 5000, sa, lenp)
    if rn < 0 {
        free(buf)
        free(sa)
        free(lenp)
        return 63
    }
    if rn < 12 {
        free(buf)
        free(sa)
        free(lenp)
        return 64
    }

    // Validate the query shape: one question.
    var qd = u16be_at(buf, 4)
    if qd != 1 {
        free(buf)
        free(sa)
        free(lenp)
        return 65
    }

    var qend = _skip_qname(buf, rn, 12)
    if qend < 0 || qend + 4 > rn {
        free(buf)
        free(sa)
        free(lenp)
        return 66
    }

    // QTYPE + QCLASS should be A/IN.
    var qtype = u16be_at(buf, qend + 0)
    var qclass = u16be_at(buf, qend + 2)
    if qtype != 1 || qclass != 1 {
        free(buf)
        free(sa)
        free(lenp)
        return 67
    }
    qend = qend + 4

    // Build response:
    // - copy the whole question section verbatim
    // - append 1 answer: NAME pointer to 0x0c, TYPE A, CLASS IN, TTL 0, RDLEN 4, RDATA ip
    var resp = malloc(512)
    if resp == 0 {
        free(buf)
        free(sa)
        free(lenp)
        return 68
    }
    // ID
    ptr_set_byte(resp + 0, ptr_get_byte(buf + 0))
    ptr_set_byte(resp + 1, ptr_get_byte(buf + 1))
    // Flags: 0x8180 (response, recursion available, no error)
    ptr_set_byte(resp + 2, 129)
    ptr_set_byte(resp + 3, 128)
    // QDCOUNT=1
    ptr_set_byte(resp + 4, 0)
    ptr_set_byte(resp + 5, 1)
    // ANCOUNT=1
    ptr_set_byte(resp + 6, 0)
    ptr_set_byte(resp + 7, 1)
    // NSCOUNT=0, ARCOUNT=0
    ptr_set_byte(resp + 8, 0)
    ptr_set_byte(resp + 9, 0)
    ptr_set_byte(resp + 10, 0)
    ptr_set_byte(resp + 11, 0)

    // Copy question bytes [12..qend)
    var qi = 12
    var roff = 12
    while qi < qend {
        ptr_set_byte(resp + roff, ptr_get_byte(buf + qi))
        qi = qi + 1
        roff = roff + 1
    }

    // Answer NAME: compression pointer to QNAME at offset 12 (0xC00C).
    ptr_set_byte(resp + roff + 0, 192)
    ptr_set_byte(resp + roff + 1, 12)
    // TYPE=A, CLASS=IN
    ptr_set_byte(resp + roff + 2, 0)
    ptr_set_byte(resp + roff + 3, 1)
    ptr_set_byte(resp + roff + 4, 0)
    ptr_set_byte(resp + roff + 5, 1)
    // TTL=0
    ptr_set_byte(resp + roff + 6, 0)
    ptr_set_byte(resp + roff + 7, 0)
    ptr_set_byte(resp + roff + 8, 0)
    ptr_set_byte(resp + roff + 9, 0)
    // RDLEN=4
    ptr_set_byte(resp + roff + 10, 0)
    ptr_set_byte(resp + roff + 11, 4)
    // RDATA: IPv4 bytes
    ptr_set_byte(resp + roff + 12, ip0 & 255)
    ptr_set_byte(resp + roff + 13, ip1 & 255)
    ptr_set_byte(resp + roff + 14, ip2 & 255)
    ptr_set_byte(resp + roff + 15, ip3 & 255)
    var resp_len = roff + 16

    // Extract source port from sockaddr_in and reply to loopback.
    var src_port = u16be_at(sa, 2)
    var wn = udp.send_to_raw(fd, "127.0.0.1", src_port, resp, resp_len, 2000)

    free(buf)
    free(resp)
    free(sa)
    free(lenp)
    if wn != resp_len { return 69 }
    return 0
}

fn server(listen_fd, mode) {
    // mode:
    // - 0: Content-Length body
    // - 1: Transfer-Encoding: chunked body
    var fd = oren_tcp_accept(listen_fd, 5000)
    if fd < 0 { return 11 }

    // Best-effort: read and ignore the request bytes.
    //
    // Some OSes can report ECONNRESET/ECONNABORTED when a server closes a socket while
    // unread request bytes are still pending. This test focuses on the HTTP client;
    // make the loopback server behave like a well-formed peer.
    var req_scratch = malloc(512)
    if req_scratch != 0 {
        oren_tcp_read_into(fd, req_scratch, 512, 2000)
        free(req_scratch)
    }

    var resp = 0
    if mode == 0 {
        resp = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nHELLO"
    } else {
        // Chunked framing:
        //   2;ext\r\nHE\r\n3\r\nLLO\r\n0\r\n\r\n
        resp = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n2;foo=bar\r\nHE\r\n3\r\nLLO\r\n0\r\n\r\n"
    }

    var n = oren_tcp_write_from(fd, resp, oren_string_len(resp), 5000)
    if n < 0 {
        oren_tcp_close(fd)
        return 12
    }

    oren_tcp_close(fd)
    return 0
}

fn run_case(mode) {
    // Loopback-only, timeout-bounded, OS-neutral (no fork required).
    var listen_fd = oren_tcp_listen_local(0) // port 0 => ephemeral
    if listen_fd < 0 { return 10 }

    // Determine the chosen port via getsockname.
    var sa = malloc(32)
    if sa == 0 { return 20 }
    var lenp = malloc(8)
    if lenp == 0 { return 21 }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { return 0 - grc }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { return 22 }

    // Spawn server after binding so it doesn't race with the connect.
    // (We serve 2 requests: direct IPv4 + hostname via DNS-resolved IPv4.)
    var h0 = spawn server(listen_fd, mode)

    var url = "http://127.0.0.1:" + oren_int_to_string(port) + "/"
    var r = http.get(url, 2000)
    free(url)
    if oren_is_err(r) {
        print("http_get_loopback: FAIL http.get: " + oren_err_msg(r))
        return 30
    }
    var body = r.text()
    if body == 0 { r.free(); return 31 }
    if strcmp(body, "HELLO") != 0 {
        print("http_get_loopback: FAIL body mismatch")
        print(body)
        r.free()
        return 32
    }
    r.free()

    var sr0 = oren_join_timeout(h0, 5000)
    if sr0 != 0 { return 40 }

    // Structured response API: status + headers + body.
    var h0b = spawn server(listen_fd, mode)
    var urlb = "http://127.0.0.1:" + oren_int_to_string(port) + "/"
    var rr = http.get(urlb, 2000)
    free(urlb)
    if oren_is_err(rr) {
        print("http_get_loopback: FAIL http.get structured: " + oren_err_msg(rr))
        oren_join_timeout(h0b, 5000)
        return 41
    }
    if rr.status != 200 {
        print("http_get_loopback: FAIL status != 200")
        http.response_free(rr)
        oren_join_timeout(h0b, 5000)
        return 42
    }
    var b0 = rr.text()
    if b0 == 0 {
        http.response_free(rr)
        oren_join_timeout(h0b, 5000)
        return 43
    }
    if strcmp(b0, "HELLO") != 0 {
        print("http_get_loopback: FAIL body mismatch (response)")
        print(b0)
        http.response_free(rr)
        oren_join_timeout(h0b, 5000)
        return 44
    }
    var bsrc = assert_hello_bytes(rr, 49)
    if bsrc != 0 {
        http.response_free(rr)
        oren_join_timeout(h0b, 5000)
        return bsrc
    }
    if mode == 0 {
        var hv0 = http.headers_get(rr.headers, "content-length")
        if hv0 == nil || strcmp(hv0, "5") != 0 {
            print("http_get_loopback: FAIL missing/invalid content-length")
            if hv0 != nil { print(hv0) }
            http.response_free(rr)
            oren_join_timeout(h0b, 5000)
            return 45
        }
    } else {
        var hv1 = http.headers_get(rr.headers, "transfer-encoding")
        if hv1 == nil {
            print("http_get_loopback: FAIL missing transfer-encoding")
            http.response_free(rr)
            oren_join_timeout(h0b, 5000)
            return 46
        }
        // Minimal check: value contains "chunked" case-insensitive.
        var s = hv1
        var sl = oren_string_len(s)
        var found = 0
        var ii = 0
        while ii + 6 < sl {
            var c0 = (ptr_get_byte(s + ii) & 255)
            var c1 = (ptr_get_byte(s + ii + 1) & 255)
            var c2 = (ptr_get_byte(s + ii + 2) & 255)
            var c3 = (ptr_get_byte(s + ii + 3) & 255)
            var c4 = (ptr_get_byte(s + ii + 4) & 255)
            var c5 = (ptr_get_byte(s + ii + 5) & 255)
            var c6 = (ptr_get_byte(s + ii + 6) & 255)
            if (c0 | 32) == 99 && (c1 | 32) == 104 && (c2 | 32) == 117 && (c3 | 32) == 110 && (c4 | 32) == 107 && (c5 | 32) == 101 && (c6 | 32) == 100 {
                found = 1
                break
            }
            ii = ii + 1
        }
        if found != 1 {
            print("http_get_loopback: FAIL transfer-encoding not chunked")
            print(hv1)
            http.response_free(rr)
            oren_join_timeout(h0b, 5000)
            return 47
        }
    }
    http.response_free(rr)
    var sr0b = oren_join_timeout(h0b, 5000)
    if sr0b != 0 { return 48 }

    var h0c = spawn server(listen_fd, mode)
    var urlc = "http://127.0.0.1:" + oren_int_to_string(port) + "/"
    // Canonical object-style API: default timeout plus receiver text method.
    // Keep the response bound so native-owned response allocations are freed.
    var tb_resp = http.get(urlc)
    free(urlc)
    if oren_is_err(tb_resp) {
        print("http_get_loopback: FAIL chained http.get: " + oren_err_msg(tb_resp))
        oren_join_timeout(h0c, 5000)
        return 49
    }
    var tb = tb_resp.text()
    if strcmp(tb, "HELLO") != 0 {
        print("http_get_loopback: FAIL body mismatch (chained text)")
        print(tb)
        tb_resp.free()
        oren_join_timeout(h0c, 5000)
        return 62
    }
    tb_resp.free()
    var sr0c = oren_join_timeout(h0c, 5000)
    if sr0c != 0 { return 63 }

    var h0d = spawn server(listen_fd, mode)
    var urld = "http://127.0.0.1:" + oren_int_to_string(port) + "/"
    var trr = http.get(urld, 2000)
    free(urld)
    if oren_is_err(trr) {
        print("http_get_loopback: FAIL second http.get: " + oren_err_msg(trr))
        oren_join_timeout(h0d, 5000)
        return 64
    }
    if trr.status != 200 || trr.text() == 0 || strcmp(trr.text(), "HELLO") != 0 {
        print("http_get_loopback: FAIL second response payload")
        http.response_free(trr)
        oren_join_timeout(h0d, 5000)
        return 65
    }
    http.response_free(trr)
    var sr0d = oren_join_timeout(h0d, 5000)
    if sr0d != 0 { return 66 }

    var h0e = spawn server(listen_fd, mode)
    var urle = "http://127.0.0.1:" + oren_int_to_string(port) + "/"
    var req_resp = http.request("GET", urle)
    free(urle)
    if oren_is_err(req_resp) {
        print("http_get_loopback: FAIL default request: " + oren_err_msg(req_resp))
        oren_join_timeout(h0e, 5000)
        return 68
    }
    if req_resp.status != 200 || req_resp.text() == 0 || strcmp(req_resp.text(), "HELLO") != 0 {
        print("http_get_loopback: FAIL default request payload")
        req_resp.free()
        oren_join_timeout(h0e, 5000)
        return 69
    }
    req_resp.free()
    var sr0e = oren_join_timeout(h0e, 5000)
    if sr0e != 0 { return 70 }

    var te = http.get(nil, 0)
    if oren_is_err(te) != true { return 67 }

    // Hostname path: serve a loopback DNS A record so the test stays offline and deterministic.
    var sfd = udp.bind_local_raw(0)
    if sfd < 0 { return 50 }
    var sport = udp.sockname_port_raw(sfd)
    if sport <= 0 { udp.close_raw(sfd); return 51 }
    var dh = spawn dns_server_one_a(sfd, 127, 0, 0, 1)

    var h1 = spawn server(listen_fd, mode)
    var url2 = "http://oren.test:" + oren_int_to_string(port) + "/"
    var res = dns.resolver("127.0.0.1", sport, 2000)
    var r2 = http.get_resolver(url2, 2000, res)
    free(url2)
    if oren_is_err(r2) {
        print("http_get_loopback: FAIL get_resolver: " + oren_err_msg(r2))
        udp.close_raw(sfd)
        oren_join_timeout(h1, 5000)
        oren_join_timeout(dh, 5000)
        return 52
    }
    var body2 = r2.text()
    if body2 == 0 {
        udp.close_raw(sfd)
        oren_join_timeout(h1, 5000)
        oren_join_timeout(dh, 5000)
        return 53
    }
    if strcmp(body2, "HELLO") != 0 {
        print("http_get_loopback: FAIL body mismatch (hostname)")
        print(body2)
        r2.free()
        udp.close_raw(sfd)
        oren_join_timeout(h1, 5000)
        oren_join_timeout(dh, 5000)
        return 54
    }
    r2.free()

    var sr1 = oren_join_timeout(h1, 5000)
    if sr1 != 0 { udp.close_raw(sfd); return 55 }
    var dsr = oren_join_timeout(dh, 5000)
    if dsr != 0 { udp.close_raw(sfd); return 56 }

    // Structured API with explicit resolver (hostname, offline).
    // The DNS helper handles one query, so spawn a fresh one.
    var dh2 = spawn dns_server_one_a(sfd, 127, 0, 0, 1)
    var h2 = spawn server(listen_fd, mode)
    var url3 = "http://oren.test:" + oren_int_to_string(port) + "/"
    var res2 = dns.resolver("127.0.0.1", sport, 2000)
    var rr2 = http.get_resolver(url3, 2000, res2)
    free(url3)
    dns.resolver_free(res2)
    if oren_is_err(rr2) {
        print("http_get_loopback: FAIL get_resolver structured: " + oren_err_msg(rr2))
        oren_join_timeout(h2, 5000)
        oren_join_timeout(dh2, 5000)
        udp.close_raw(sfd)
        return 57
    }
    if rr2.status != 200 {
        print("http_get_loopback: FAIL status != 200 (hostname)")
        http.response_free(rr2)
        oren_join_timeout(h2, 5000)
        oren_join_timeout(dh2, 5000)
        udp.close_raw(sfd)
        return 58
    }
    var b3 = rr2.text()
    if b3 == 0 || strcmp(b3, "HELLO") != 0 {
        print("http_get_loopback: FAIL body mismatch (hostname response)")
        if b3 != 0 { print(b3) }
        http.response_free(rr2)
        oren_join_timeout(h2, 5000)
        oren_join_timeout(dh2, 5000)
        udp.close_raw(sfd)
        return 59
    }
    http.response_free(rr2)
    var sr2 = oren_join_timeout(h2, 5000)
    if sr2 != 0 { oren_join_timeout(dh2, 5000); udp.close_raw(sfd); return 60 }
    var dsr2 = oren_join_timeout(dh2, 5000)
    if dsr2 != 0 { udp.close_raw(sfd); return 61 }

    udp.close_raw(sfd)

    oren_tcp_close(listen_fd)
    return 0
}

fn main() {
    _ensure_workers_for_spawned_servers("http_get_loopback")

    var rc0 = run_case(0)
    if rc0 != 0 { exit(rc0) }
    var rc1 = run_case(1)
    if rc1 != 0 { exit(rc1) }
    print("http_get_loopback: OK")
    exit(0)
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
