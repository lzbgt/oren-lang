fn main() {
    var xs = []
    xs[0] = 0
    if oren_list_len(xs) != 1 { exit(10) }
    if xs[0] != 0 { exit(11) }

    xs[1] = 1
    if oren_list_len(xs) != 2 { exit(12) }
    if xs[1] != 1 { exit(13) }

    xs[99] = 99
    if oren_list_len(xs) != 100 { exit(14) }
    if xs[99] != 99 { exit(15) }
    if xs[50] != nil { exit(16) }
    exit(0)
}

