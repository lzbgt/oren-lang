import dns "std:net/dns"
import hostutil "std:net/host"
import udp "std:net/udp"

fn u16be_at(p, off) {
    var hi = ptr_get_byte(p + off) & 255
    var lo = ptr_get_byte(p + off + 1) & 255
    return (hi << 8) | lo
}

fn _env_truthy(name) {
    var p = oren_getenv(name)
    if p == 0 { return 0 }
    var b = ptr_get_byte(p)
    if b == 0 { return 0 }
    if b == 48 { return 0 } // '0'
    return 1
}

fn _ensure_workers_for_spawned_servers() {
    // `spawn` prefers in-process green tasks on Tier‑1 (including Windows).
    // For loopback fixtures that run a server and then do a blocking client call on the main thread,
    // enable worker mode so the server green task can run concurrently.
    if _env_truthy("OREN_NO_GREEN") == 1 { return 0 } // legacy fork+pipe spawn (green disabled)
    var rcw = oren_green_start_workers(1)
    if rcw != 0 {
        print("dns_loopback: FAIL cannot start green workers rc=" + oren_int_to_string(rcw))
        exit(109)
    }
    return 0
}

fn _skip_qname(buf, n, off) {
    // Skip a DNS QNAME (no compression expected in queries).
    var i = off
    while 1 {
        if i >= n { return -1 }
        var l = ptr_get_byte(buf + i) & 255
        i = i + 1
        if l == 0 { return i }
        if l > 63 { return -1 }
        i = i + l
    }
}

fn server(fd, ip0, ip1, ip2, ip3) {
    // Minimal authoritative DNS server for one query.
    // Replies with a single A record containing (ip0..ip3).
    var buf = malloc(512)
    if buf == 0 { return 10 }
    var sa = malloc(16)
    if sa == 0 { free(buf); return 11 }
    var lenp = malloc(8)
    if lenp == 0 { free(buf); free(sa); return 12 }
    ptr_set(lenp, 16)

    var rn = udp.recv_from_into(fd, buf, 512, 5000, sa, lenp)
    if rn < 0 {
        free(buf)
        free(sa)
        free(lenp)
        return 13
    }
    if rn < 12 {
        free(buf)
        free(sa)
        free(lenp)
        return 14
    }

    // Validate the query shape: one question.
    var qd = (ptr_get_byte(buf + 4) & 255) << 8 | (ptr_get_byte(buf + 5) & 255)
    if qd != 1 {
        free(buf)
        free(sa)
        free(lenp)
        return 15
    }

    var qend = _skip_qname(buf, rn, 12)
    if qend < 0 || qend + 4 > rn {
        free(buf)
        free(sa)
        free(lenp)
        return 16
    }

    // QTYPE + QCLASS should be A/IN.
    var qtype = u16be_at(buf, qend + 0)
    var qclass = u16be_at(buf, qend + 2)
    if qtype != 1 || qclass != 1 {
        free(buf)
        free(sa)
        free(lenp)
        return 17
    }
    qend = qend + 4

    // Build response:
    // - copy the whole question section verbatim
    // - append 1 answer: NAME pointer to 0x0c, TYPE A, CLASS IN, TTL 0, RDLEN 4, RDATA ip
    var resp = malloc(512)
    if resp == 0 {
        free(buf)
        free(sa)
        free(lenp)
        return 18
    }
    // ID
    ptr_set_byte(resp + 0, ptr_get_byte(buf + 0))
    ptr_set_byte(resp + 1, ptr_get_byte(buf + 1))
    // Flags: 0x8180 (response, recursion available, no error)
    ptr_set_byte(resp + 2, 129)
    ptr_set_byte(resp + 3, 128)
    // QDCOUNT=1
    ptr_set_byte(resp + 4, 0)
    ptr_set_byte(resp + 5, 1)
    // ANCOUNT=1
    ptr_set_byte(resp + 6, 0)
    ptr_set_byte(resp + 7, 1)
    // NSCOUNT=0, ARCOUNT=0
    ptr_set_byte(resp + 8, 0)
    ptr_set_byte(resp + 9, 0)
    ptr_set_byte(resp + 10, 0)
    ptr_set_byte(resp + 11, 0)

    // Copy question bytes [12..qend)
    var qi = 12
    var roff = 12
    while qi < qend {
        ptr_set_byte(resp + roff, ptr_get_byte(buf + qi))
        qi = qi + 1
        roff = roff + 1
    }

    // Answer NAME: compression pointer to QNAME at offset 12 (0xC00C).
    ptr_set_byte(resp + roff + 0, 192)
    ptr_set_byte(resp + roff + 1, 12)
    // TYPE=A, CLASS=IN
    ptr_set_byte(resp + roff + 2, 0)
    ptr_set_byte(resp + roff + 3, 1)
    ptr_set_byte(resp + roff + 4, 0)
    ptr_set_byte(resp + roff + 5, 1)
    // TTL=0
    ptr_set_byte(resp + roff + 6, 0)
    ptr_set_byte(resp + roff + 7, 0)
    ptr_set_byte(resp + roff + 8, 0)
    ptr_set_byte(resp + roff + 9, 0)
    // RDLEN=4
    ptr_set_byte(resp + roff + 10, 0)
    ptr_set_byte(resp + roff + 11, 4)
    // RDATA: IPv4 bytes
    ptr_set_byte(resp + roff + 12, ip0 & 255)
    ptr_set_byte(resp + roff + 13, ip1 & 255)
    ptr_set_byte(resp + roff + 14, ip2 & 255)
    ptr_set_byte(resp + roff + 15, ip3 & 255)
    var resp_len = roff + 16

    // Extract source port from sockaddr_in and reply to loopback.
    var src_port = u16be_at(sa, 2)
    var wn = udp.send_to(fd, "127.0.0.1", src_port, resp, resp_len, 2000)

    free(buf)
    free(resp)
    free(sa)
    free(lenp)
    if wn != resp_len { return 19 }
    return 0
}

fn main() {
    _ensure_workers_for_spawned_servers()

    // Bind a loopback UDP socket to act as an authoritative DNS server.
    var sfd = udp.bind_local(0)
    if sfd < 0 { exit(100) }
    var sport = udp.sockname_port(sfd)
    if sport <= 0 { exit(101) }

    // Reply with a non-loopback address to ensure client parses the answer bytes (not hard-coded).
    var h = spawn server(sfd, 10, 11, 12, 13)

    var r = dns.query_a("oren.test", "127.0.0.1", sport, 2000)
    if r["ok"] != 1 {
        print("dns_loopback: FAIL " + r["err"])
        exit(110)
    }
    var ip = r["ip"]
    if ip == 0 { exit(111) }
    if strcmp(ip, "10.11.12.13") != 0 {
        print("dns_loopback: FAIL ip=" + ip)
        free(ip)
        exit(112)
    }
    free(ip)

    var sr = oren_join_timeout(h, 5000)
    if sr != 0 { exit(120) }

    var h2 = spawn server(sfd, 20, 21, 22, 23)
    var ip2 = dns.try_query_a("oren.test", "127.0.0.1", sport, 2000)
    if oren_is_err(ip2) {
        print("dns_loopback: FAIL try_query_a " + oren_err_msg(ip2))
        exit(121)
    }
    if strcmp(ip2, "20.21.22.23") != 0 {
        print("dns_loopback: FAIL try_query_a ip=" + ip2)
        free(ip2)
        exit(122)
    }
    free(ip2)
    var sr2 = oren_join_timeout(h2, 5000)
    if sr2 != 0 { exit(123) }

    var e = dns.try_query_a("oren.test", nil, 53, 0)
    if oren_is_err(e) != true { exit(124) }

    var hr = hostutil.try_resolve_host_ipv4("dns_loopback", "127.0.0.1", 0, nil)
    if oren_is_err(hr) { exit(125) }
    if hr["owned"] != 0 || strcmp(hr["ip"], "127.0.0.1") != 0 { exit(126) }
    var he = hostutil.try_resolve_host_ipv4("dns_loopback", nil, 0, nil)
    if oren_is_err(he) != true { exit(127) }

    udp.close(sfd)
    print("dns_loopback: OK")
    exit(0)
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
