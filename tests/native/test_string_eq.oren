fn main() {
    // String comparisons must be lexical by content (not pointer identity),
    // at least for obvious stringy expressions in the native backend.

    if "a" == "b" { exit(1) }
    if "a" != "a" { exit(2) }
    if ("a" + "b") != "ab" { exit(3) }
    if "ab" < "aa" { exit(4) }
    if "ab" <= "aa" { exit(5) }
    if "ab" > "b" { exit(6) }
    if "ab" >= "b" { exit(7) }

    // Cover common runtime string-producing calls (must compare by content in native backend).
    if oren_string_char_at("abc", 0) != "a" { exit(8) }
    if ("a" + "b") != "ab" { exit(9) }
    if oren_realpath("x/./y") != "x/y" { exit(10) }

    // Comparing string pointers with nil must be safe (must NOT call strcmp).
    var s = "abc"
    if s == nil { exit(11) }
    if nil == s { exit(12) }

    var t = nil
    if t != nil { exit(13) }
    if t == "abc" { exit(14) }
    if "abc" == t { exit(15) }

    print("native string_eq OK")
    exit(0)
}

main()
