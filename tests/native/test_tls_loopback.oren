import tcp "std:net/tcp"
import tls "std:net/tls"
import base64 "std:encoding/base64"
import fixture "./fixture_tls_p12.oren"
import spawner "./fixture_tls_spawn.oren"

fn _cstr_from_string(s) {
    if s == nil { s = "" }
    var n = oren_string_len(s)
    if n < 0 { n = 0 }
    // Keep argv args small and safe.
    if n > 128 { n = 128 }
    var p = malloc(n + 1)
    if p == 0 { return 0 }
    var i = 0
    while i < n {
        ptr_set_byte(p + i, oren_string_byte_at_unchecked(s, i) & 255)
        i = i + 1
    }
    ptr_set_byte(p + n, 0)
    return p
}

fn _str_eq_bytes(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _cstr_lit_server() {
    // "server\0"
    var p = malloc(7)
    if p == 0 { return 0 }
    ptr_set_byte(p + 0, 115)
    ptr_set_byte(p + 1, 101)
    ptr_set_byte(p + 2, 114)
    ptr_set_byte(p + 3, 118)
    ptr_set_byte(p + 4, 101)
    ptr_set_byte(p + 5, 114)
    ptr_set_byte(p + 6, 0)
    return p
}

fn u16be_at(p, off) {
    var hi = ptr_get_byte(p + off) & 255
    var lo = ptr_get_byte(p + off + 1) & 255
    return (hi << 8) | lo
}

@cfg(not_os="macos,linux,windows")
fn main() {
    // TLS provider bring-up starts on macOS; other Tier‑1 OS providers are tracked in docs/DESIGN.md#tls-provider-availability.
    exit(0)
}

fn server_impl(listen_fd, pfx_b64) {
    var pkcs12_bytes = base64.decode_bytes(pfx_b64)
    if oren_is_err(pkcs12_bytes) {
        print("tls_loopback: server FAIL base64 decode")
        return 101
    }
    var n = oren_buf_len(pkcs12_bytes)
    if oren_is_err(n) || n != fixture.pkcs12_len() {
        print("tls_loopback: server FAIL pkcs12 len=" + oren_int_to_string(n))
        return 102
    }
    if native_buf_data_ptr(pkcs12_bytes) == 0 {
        print("tls_loopback: server FAIL pkcs12 data ptr nil")
        return 103
    }

    var fd = tcp.accept(listen_fd, 5000)
    if fd < 0 { return 11 }

    // Server-side ALPN matrix (rolling):
    // - Windows Schannel: server-side selection is wired (fixture asserts negotiated protocol).
    // - Linux OpenSSL: server-side selection is wired (via `SSL_CTX_set_alpn_select_cb`).
    // - macOS SecureTransport: ALPN list is configured, but negotiated protocol is not asserted yet (best-effort).
    var srv_opts = {"alpn": ["http/1.1"]}
    var r = tls.wrap_server_pkcs12(fd, 5000, pkcs12_bytes, fixture.passphrase(), srv_opts)
    var ok = oren_map_get_str(r, "ok")
    if ok != 1 {
        var es = oren_map_get_str(r, "err")
        if es != 0 {
            print("tls_loopback: server wrap FAIL: " + es)
        }
        return 12
    }
    var conn = oren_map_get_str(r, "conn")
    if conn == 0 { return 13 }

    var buf = malloc(16)
    if buf == 0 { tls.close(conn); return 14 }
    var n = tls.read_into(conn, buf, 4, 5000)
    if n != 4 {
        free(buf)
        tls.close(conn)
        return 15
    }
    var wr = tls.write_from(conn, buf, 4, 5000)
    free(buf)
    tls.close(conn)
    if wr != 4 { return 16 }
    return 0
}

@cfg(os="macos,linux,windows")
fn server_main(listen_fd, pfx_b64) {
    // Portable spawn entrypoint:
    // - The fork-based spawn runtimes (C backend and native POSIX path) capture the return value
    //   and terminate the worker process after writing it to the join pipe.
    // - The Windows spawn runtime (thread-based) stores the return value for `oren_join`.
    //
    // Do NOT call `exit(...)` here; that would terminate the whole process under Windows.
    return server_impl(listen_fd, pfx_b64)
}

@cfg(os="windows")
fn _tls_client_impl(port, expected_leaf_sha256_hex) {
    var fd = tcp.connect("127.0.0.1", port, 5000)
    if fd < 0 { return 8 }

    // Deterministic offline fixture:
    // - insecure_skip_verify bypasses platform trust stores
    // - pin_cert_sha256_hex is enforced by std:net/tls.wrap_client
    // Exercise client-side ALPN plumbing as well (TLS provider may ignore it on some OS).
    var tls_opts = {"insecure_skip_verify": 1, "pin_cert_sha256_hex": expected_leaf_sha256_hex, "alpn": ["h2", "http/1.1"]}
    var cr = tls.wrap_client(fd, "oren.test", 5000, tls_opts)
    var ok = oren_map_get_str(cr, "ok")
    if ok != 1 {
        var es = oren_map_get_str(cr, "err")
        if es != 0 { print("tls_loopback: FAIL client wrap: " + es) }
        return 9
    }
    var conn = oren_map_get_str(cr, "conn")
    if conn == 0 { return 10 }

    // Windows Schannel: server selects "http/1.1" from the client offer.
    var ar = tls.negotiated_alpn(conn)
    if oren_map_get_str(ar, "ok") != 1 {
        tls.close(conn)
        return 11
    }
    var ap = oren_map_get_str(ar, "v")
    if ap == nil || _str_eq_bytes(ap, "http/1.1") != true {
        tls.close(conn)
        return 12
    }

    var msg = "PING"
    var wr = tls.write_from(conn, msg, 4, 5000)
    if wr != 4 {
        tls.close(conn)
        return 20
    }
    var buf = malloc(16)
    if buf == 0 {
        tls.close(conn)
        return 21
    }
    var rn = tls.read_into(conn, buf, 4, 5000)
    if rn != 4 {
        free(buf)
        tls.close(conn)
        return 22
    }
    if ptr_get_byte(buf + 0) != 80 || ptr_get_byte(buf + 1) != 73 || ptr_get_byte(buf + 2) != 78 || ptr_get_byte(buf + 3) != 71 {
        free(buf)
        tls.close(conn)
        return 23
    }
    free(buf)

    // Cross-check leaf hash query works (pinning is enforced already).
    var hr = tls.peer_cert_sha256_hex(conn)
    var hok = oren_map_get_str(hr, "ok")
    if hok != 1 {
        tls.close(conn)
        return 30
    }
    var hv = oren_map_get_str(hr, "v")
    if hv == 0 || _str_eq_bytes(hv, expected_leaf_sha256_hex) != true {
        print("tls_loopback: FAIL cert pin mismatch")
        print("got=" + hv)
        print("want=" + expected_leaf_sha256_hex)
        tls.close(conn)
        return 31
    }

    tls.close(conn)
    return 0
}

@cfg(os="windows")
fn main_client() {
    var expected_leaf_sha256_hex = fixture.leaf_sha256_hex()

    // Bind ephemeral loopback port.
    var listen_fd = oren_tcp_listen_local(0)
    if listen_fd < 0 { exit(3) }

    // getsockname to find the bound port.
    var sa = malloc(32)
    if sa == 0 { exit(4) }
    var lenp = malloc(8)
    if lenp == 0 { exit(5) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { exit(6) }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { exit(7) }

    var args_srv = oren_new_list(0)
    oren_list_push(args_srv, listen_fd)
    oren_list_push(args_srv, fixture.pkcs12_b64())
    var h = spawner.tls_spawn(server_main, args_srv)
    if h == 0 { exit(100) }

    var args_cli = oren_new_list(0)
    oren_list_push(args_cli, port)
    oren_list_push(args_cli, expected_leaf_sha256_hex)
    var hc = spawner.tls_spawn(_tls_client_impl, args_cli)
    if hc == 0 { exit(101) }

    var rc2 = oren_join_timeout(hc, 5000)
    var sr2 = oren_join_timeout(h, 5000)
    tcp.close(listen_fd)
    if rc2 != 0 { exit(rc2) }
    if sr2 != 0 { exit(50) }
    exit(0)
}

@cfg(os="linux")
fn main_client() {
    // Deterministic loopback TLS fixture:
    // - PKCS#12 contains a self-signed cert for CN/SAN "oren.test" and 127.0.0.1.
    // - Client pins the leaf certificate SHA-256 (DER).

    var pfx_b64 = fixture.pkcs12_b64()
    var expected_leaf_sha256_hex = fixture.leaf_sha256_hex()

    // Bind ephemeral loopback port.
    var listen_fd = oren_tcp_listen_local(0)
    if listen_fd < 0 { exit(3) }

    // getsockname to find the bound port.
    var sa = malloc(32)
    if sa == 0 { exit(4) }
    var lenp = malloc(8)
    if lenp == 0 { exit(5) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { exit(6) }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { exit(7) }

    var pid = sys_fork()
    if pid < 0 { exit(75) }
    if pid == 0 {
        // Linux correctness: avoid exec; accept+TLS runs fine in the post-fork child.
        exit(server_main(listen_fd, pfx_b64))
    }

    var fd = tcp.connect("127.0.0.1", port, 5000)
    if fd < 0 { exit(8) }

    // Exercise client-side ALPN plumbing as well (TLS provider may ignore it on some OS).
    var tls_opts = {"insecure_skip_verify": 1, "pin_cert_sha256_hex": expected_leaf_sha256_hex, "alpn": ["h2", "http/1.1"]}
    var cr = tls.wrap_client(fd, "oren.test", 5000, tls_opts)
    var ok = oren_map_get_str(cr, "ok")
    if ok != 1 {
        var es = oren_map_get_str(cr, "err")
        if es != 0 { print("tls_loopback: FAIL client wrap: " + es) }
        exit(9)
    }
    var conn = oren_map_get_str(cr, "conn")
    if conn == 0 { exit(10) }

    // Linux OpenSSL: server selects "http/1.1" from the client offer.
    var ar = tls.negotiated_alpn(conn)
    if oren_map_get_str(ar, "ok") != 1 { tls.close(conn); exit(11) }
    var ap = oren_map_get_str(ar, "v")
    if ap == nil || _str_eq_bytes(ap, "http/1.1") != true { tls.close(conn); exit(12) }

    var msg = "PING"
    var wr = tls.write_from(conn, msg, 4, 5000)
    if wr != 4 {
        tls.close(conn)
        exit(20)
    }
    var buf = malloc(16)
    if buf == 0 {
        tls.close(conn)
        exit(21)
    }
    var rn = tls.read_into(conn, buf, 4, 5000)
    if rn != 4 {
        free(buf)
        tls.close(conn)
        exit(22)
    }
    if ptr_get_byte(buf + 0) != 80 || ptr_get_byte(buf + 1) != 73 || ptr_get_byte(buf + 2) != 78 || ptr_get_byte(buf + 3) != 71 {
        free(buf)
        tls.close(conn)
        exit(23)
    }
    free(buf)

    var hr = tls.peer_cert_sha256_hex(conn)
    var hok = oren_map_get_str(hr, "ok")
    if hok != 1 {
        tls.close(conn)
        exit(30)
    }
    var hv = oren_map_get_str(hr, "v")
    if hv == 0 || _str_eq_bytes(hv, expected_leaf_sha256_hex) != true {
        print("tls_loopback: FAIL cert pin mismatch")
        print("got=" + hv)
        print("want=" + expected_leaf_sha256_hex)
        tls.close(conn)
        exit(31)
    }

    tls.close(conn)
    // Wait for the server process to exit; require status==0.
    var status_ptr = malloc(8)
    if status_ptr == 0 { exit(40) }
    ptr_set(status_ptr, 0)
    var wpid = sys_wait4(pid, status_ptr, 0, 0)
    if wpid != pid { exit(41) }
    var status = ptr_get(status_ptr)
    free(status_ptr)
    if status != 0 { exit(42) }
    tcp.close(listen_fd)
    exit(0)
}

@cfg(os="macos")
fn main_client() {
    // Deterministic loopback TLS fixture:
    // - PKCS#12 contains a self-signed cert for CN/SAN "oren.test" and 127.0.0.1.
    // - Client pins the leaf certificate SHA-256 (DER).

    var pfx_b64 = fixture.pkcs12_b64()

    var expected_leaf_sha256_hex = fixture.leaf_sha256_hex()

    // Bind ephemeral loopback port.
    var listen_fd = oren_tcp_listen_local(0)
    if listen_fd < 0 { exit(3) }

    var exec_fd = listen_fd
    var dfd = sys_fcntl(listen_fd, FCNTL_F_DUPFD, 0)
    if dfd >= 0 { exec_fd = dfd }

    // getsockname to find the bound port.
    var sa = malloc(32)
    if sa == 0 { exit(4) }
    var lenp = malloc(8)
    if lenp == 0 { exit(5) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { exit(6) }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { exit(7) }

    // IMPORTANT (Darwin correctness):
    // `spawn` in the syscall-first native runtime is fork-based; calling CoreFoundation/Security
    // APIs in a post-fork child (without exec) can break due to inherited libSystem/libmalloc state.
    //
    // For TLS bring-up we exec a fresh copy of the current binary in "server" mode so the server
    // runs with a clean libSystem state.
    var argvp0 = global_get_argv()
    if argvp0 == 0 { exit(70) }
    var self_path = ptr_get(argvp0 + 0)
    if self_path == 0 { exit(71) }

    var role_cstr = _cstr_lit_server()
    if role_cstr == 0 { exit(72) }
    var fd_cstr = _cstr_from_string(oren_int_to_string(exec_fd))
    if fd_cstr == 0 { exit(73) }
    var argvp = malloc(4 * 8)
    if argvp == 0 { exit(74) }
    ptr_set(argvp + 0, self_path)
    ptr_set(argvp + 8, role_cstr)
    ptr_set(argvp + 16, fd_cstr)
    ptr_set(argvp + 24, 0)

    var pid = oren_fork()
    if pid < 0 { exit(75) }
    if pid == 0 {
        sys_execve(self_path, argvp, global_get_envp())
        exit(127)
    }
    free(argvp)
    free(fd_cstr)
    free(role_cstr)

    tcp.close(listen_fd)
    if exec_fd != listen_fd { tcp.close(exec_fd) }

    var fd = tcp.connect("127.0.0.1", port, 5000)
    if fd < 0 {
        exit(8)
    }

    // Exercise client-side ALPN plumbing as well (TLS provider may ignore it on some OS).
    var tls_opts = {"insecure_skip_verify": 1, "pin_cert_sha256_hex": expected_leaf_sha256_hex, "alpn": ["h2", "http/1.1"]}
    var cr = tls.wrap_client(fd, "oren.test", 5000, tls_opts)
    var ok = oren_map_get_str(cr, "ok")
    if ok != 1 {
        var es = oren_map_get_str(cr, "err")
        if es != 0 { print("tls_loopback: FAIL client wrap: " + es) }
        exit(9)
    }
    var conn = oren_map_get_str(cr, "conn")
    if conn == 0 {
        exit(10)
    }

    // macOS SecureTransport: ALPN negotiation/observation is currently treated as best-effort;
    // the loopback fixture does not assert a negotiated protocol yet (tracked in docs/DESIGN.md#tls-provider-availability).
    var ar = tls.negotiated_alpn(conn)
    if oren_map_get_str(ar, "ok") != 1 {
        tls.close(conn)
        exit(11)
    }
    var ap = oren_map_get_str(ar, "v")
    if ap != nil {
        // Best-effort: if the provider reports a negotiated protocol, ensure it matches the
        // server's advertised single-protocol list ("http/1.1") for this fixture.
        if _str_eq_bytes(ap, "http/1.1") != true {
            tls.close(conn)
            exit(12)
        }
    }

    var msg = "PING"
    var wr = tls.write_from(conn, msg, 4, 5000)
    if wr != 4 {
        tls.close(conn)
        exit(20)
    }
    var buf = malloc(16)
    if buf == 0 {
        tls.close(conn)
        exit(21)
    }
    var rn = tls.read_into(conn, buf, 4, 5000)
    if rn != 4 {
        free(buf)
        tls.close(conn)
        exit(22)
    }
    if ptr_get_byte(buf + 0) != 80 || ptr_get_byte(buf + 1) != 73 || ptr_get_byte(buf + 2) != 78 || ptr_get_byte(buf + 3) != 71 {
        free(buf)
        tls.close(conn)
        exit(23)
    }
    free(buf)

    var hr = tls.peer_cert_sha256_hex(conn)
    var hok = oren_map_get_str(hr, "ok")
    if hok != 1 {
        tls.close(conn)
        exit(30)
    }
    var hv = oren_map_get_str(hr, "v")
    if hv == 0 || _str_eq_bytes(hv, expected_leaf_sha256_hex) != true {
        print("tls_loopback: FAIL cert pin mismatch")
        print("got=" + hv)
        print("want=" + expected_leaf_sha256_hex)
        tls.close(conn)
        exit(31)
    }

    tls.close(conn)
    // Wait for the server process to exit; require status==0.
    var status_ptr = malloc(8)
    if status_ptr == 0 { exit(40) }
    ptr_set(status_ptr, 0)
    var wpid = sys_wait4(pid, status_ptr, 0, 0)
    if wpid != pid { exit(41) }
    var status = ptr_get(status_ptr)
    free(status_ptr)
    if status != 0 { exit(42) }
    exit(0)
}

@cfg(os="macos,linux")
fn main_server() {
    var args = oren_args()
    if args == nil || oren_list_len(args) < 3 {
        print("tls_loopback: server usage: <bin> server <listen_fd>")
        exit(60)
    }
    if _str_eq_bytes(args[1], "server") != true { exit(61) }
    var listen_fd = oren_int_from_string(args[2])
    if listen_fd < 0 { exit(62) }

    var pfx_b64 = fixture.pkcs12_b64()
    exit(server_main(listen_fd, pfx_b64))
}

@cfg(os="macos,linux")
fn main() {
    var args = oren_args()
    if args != nil && oren_list_len(args) >= 2 {
        if _str_eq_bytes(args[1], "server") == true { return main_server() }
    }
    return main_client()
}
