fn main() {
    // Sanity check: portable nonblocking flags via syscall-first fcntl helpers.
    //
    // This test intentionally uses a pipe (no network required).
    //
    // Expectations:
    // - sys_fcntl_getfl returns Oren-level flags (access bits + OREN_O_NONBLOCK when set)
    // - sys_fcntl_setfl accepts Oren-level flags and applies OS-specific O_NONBLOCK correctly

    var buf = malloc(16)
    if buf == 0 { exit(2) }
    var rc = sys_pipe(buf)
    if rc < 0 { exit(3) }

    var rfd = ptr_get(buf + 0)
    var wfd = ptr_get(buf + 8)

    var f0 = sys_fcntl_getfl(rfd)
    if f0 < 0 { exit(4) }
    
    // pipes are typically O_RDONLY on the read end (0), but we only require it to be a valid access mode.
    var f0_mode = f0 & 3
    if f0_mode > 2 { exit(5) }

    var r1 = sys_fcntl_setfl(rfd, f0 | OREN_O_NONBLOCK)
    if r1 < 0 { exit(6) }

    var f1 = sys_fcntl_getfl(rfd)
    if f1 < 0 { exit(7) }
    var f1_nonblock = f1 & OREN_O_NONBLOCK
    if f1_nonblock == 0 { exit(8) }

    sys_close(rfd)
    sys_close(wfd)
    print("ok")
}
