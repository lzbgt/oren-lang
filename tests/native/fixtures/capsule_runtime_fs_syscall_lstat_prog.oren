fn main() {
    // Raw sys_lstat capsule FS test:
    // - In capsule mode, sys_lstat must be enforced at syscall boundary (no bypass).
    // - With OREN_FS_MOUNTS_READ=v/=... and allow domains FS, lstat("v/link") should be allowed.
    //
    // IMPORTANT (rolling, OS-neutral):
    // Do not assert platform `struct stat` field offsets here. This fixture only checks that:
    // - mount enrollment is enforced
    // - syscall returns success for an allowed path
    //
    // Use a generously-sized buffer so the kernel can write its native struct layout.
    var st = malloc(512)
    if st == 0 { exit(3) }
    var rc = sys_lstat("v/link", st)
    if rc < 0 { exit(2) }
    print("ok")
}
