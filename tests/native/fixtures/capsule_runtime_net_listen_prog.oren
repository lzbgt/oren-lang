fn main() {
    // Runtime capsule NET test (listen):
    // - oren_tcp_listen_local must be subject to runtime capsule enforcement.
    // - Binding to port 0 asks the kernel for an ephemeral port, avoiding test flakiness.
    var fd = oren_tcp_listen_local(0)
    if fd < 0 {
        print("listen_failed")
        exit(1)
    }
    oren_tcp_close(fd)
    print("ok")
}
