fn main() {
    // Raw sys_rmdir capsule FS test:
    // - In capsule mode, sys_rmdir must be enforced at syscall boundary (no bypass).
    // - With OREN_FS_MOUNTS_WRITE=v/=... and allow domains FS, rmdir("v/dir") should be allowed.
    var rc = sys_rmdir("v/dir")
    if rc < 0 { exit(2) }
    print("ok")
}

