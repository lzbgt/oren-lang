fn main() {
    // Raw sys_stat capsule FS test:
    // - In capsule mode, sys_stat must be enforced at syscall boundary (no bypass).
    // - With OREN_FS_MOUNTS_READ=v/=... and allow domains FS, stat("v/in.txt") should be allowed.
    //
    // IMPORTANT (rolling, OS-neutral):
    // Do not assert platform `struct stat` field offsets here. This fixture only checks that:
    // - mount enrollment is enforced
    // - syscall returns success for an allowed path
    //
    // Use the Oren-owned Stat ABI buffer.
    var st = oren_stat_alloc()
    if st == 0 { exit(3) }
    var rc = sys_stat("v/in.txt", st)
    if rc < 0 { exit(2) }
    print("ok")
}
