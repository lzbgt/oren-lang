fn rec(n) {
    if n == 0 { return 0 }
    // Non-tail recursion: keep one frame per call so call-depth guards can be tested.
    // Use a non-constant post-recursion op so tail-modulo-const optimizations do not apply.
    return rec(n - 1) + n
}

// With stack safety enabled (C backend call-depth guard), this must fail
// deterministically rather than overflowing the host OS stack.
rec(2048)
