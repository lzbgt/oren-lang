fn main() {
    // Raw sys_rename capsule FS test:
    // - In capsule mode, sys_rename must be enforced at syscall boundary (no bypass).
    // - With OREN_FS_MOUNTS_WRITE=v/=... and allow domains FS, renaming "v/a.txt" -> "v/b.txt" should be allowed.
    var rc = sys_rename("v/a.txt", "v/b.txt")
    if rc < 0 { exit(2) }
    print("ok")
}

