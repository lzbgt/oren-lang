fn main() {
    // Raw sys_open capsule FS test (write via mount mapping):
    // - In capsule mode, sys_open must be enforced at syscall boundary (no bypass).
    // - With OREN_FS_MOUNTS_WRITE=v/=... and allow domains FS, opening "v/out.bin" for write should be allowed.
    // - Without write mount enrollment, it should be denied.
    var flags = 1 | OREN_O_CREAT | OREN_O_TRUNC // WRONLY|CREAT|TRUNC (Oren-level flags)
    var fd = sys_open("v/out.bin", flags, 420) // 0644
    if fd < 0 { exit(2) }
    var buf = malloc(1)
    if buf == 0 { exit(3) }
    ptr_set_byte(buf + 0, 90) // 'Z'
    var n = sys_write(fd, buf, 1)
    sys_close(fd)
    if n != 1 { exit(4) }
    print("ok")
}
