fn main() {
    // Raw sys_execve capsule test (envp enforcement):
    // - Execute /usr/bin/printenv OREN_CAPSULE
    // - Even if the caller provides an envp without OREN_CAPSULE, capsule mode must
    //   inject the mandatory OREN_* enforcement variables so the child cannot escape.

    var argv = malloc(24)
    if argv == 0 { exit(127) }
    ptr_set(argv + 0, "/usr/bin/printenv")
    ptr_set(argv + 8, "OREN_CAPSULE")
    ptr_set(argv + 16, 0)

    // Caller-provided envp does NOT include OREN_CAPSULE.
    var envp = malloc(16)
    if envp == 0 { exit(127) }
    ptr_set(envp + 0, "FOO=1")
    ptr_set(envp + 8, 0)

    sys_execve("/usr/bin/printenv", argv, envp)
    exit(127)
}

