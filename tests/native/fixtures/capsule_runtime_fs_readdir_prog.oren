fn main() {
    // Runtime-level readdir test (built on sys_getdirentries64):
    // - must be capsule-safe (path resolution + syscalls).
    // - must return names including "in.txt".
    //
    // This test intentionally uses language-level `==` on strings returned from a list.
    // The native backend must treat `names[i]` as stringy when `names` comes from `oren_readdir`.
    var names = oren_readdir("v/dir")
    if names == 0 { exit(2) }

    var found = false
    var n = oren_list_len(names)
    var i = 0
    while i < n {
        if names[i] == "in.txt" { found = true }
        i = i + 1
    }
    if found != true { exit(3) }
    print("ok")
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
