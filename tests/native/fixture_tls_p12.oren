// Shared deterministic TLS fixture for native NET loopback tests (macOS + Linux providers).
//
// - The PKCS#12 contains a self-signed certificate for CN/SAN "oren.test" and 127.0.0.1.
// - Client tests should use `insecure_skip_verify=1` + pinning to keep tests offline and deterministic.

fn pkcs12_b64() {
    return ""
}

fn leaf_sha256_hex() {
    return "c24c5f71bfc800afa108fe44d110b13365e139769f31661e75b37cfcb1b4bb7a"
}

fn pkcs12_len() { return 2587 }

fn passphrase() { return "orenpass" }
