// FFI return kinds: pointer-sized and size_t.
//
// Purpose (rolling):
// - Accept `@ffi.ret("ptr")` and `@ffi.ret("usize")` as explicit ABI metadata.
// - On Tier‑1 (arm64/x64), both are 64-bit returns and do not require register normalization,
//   but they are useful for self-documenting bindings and future 32-bit bring-up.
//
// This fixture is a compile-only gate for x64-linux/x64-windows.

@cfg(os="windows")
@ffi.dll("kernel32.dll")
@ffi.ret("ptr")
ffi GetModuleHandleA

@cfg(os="linux")
@ffi.link("libc.so.6")
@ffi.ret("ptr")
ffi malloc

@cfg(os="linux")
@ffi.link("libc.so.6")
@ffi.ret("usize")
ffi strlen

@cfg(os="windows")
fn main() {
    // GetModuleHandleA(NULL) returns the handle of the file used to create the calling process.
    var h = GetModuleHandleA(0)
    if h == 0 { return 1 }
    return 0
}

@cfg(os="linux")
fn main() {
    var p = malloc(8)
    if p == 0 { return 2 }
    if strlen("abc") != 3 { return 3 }
    return 0
}

@cfg(not_os="windows,linux")
fn main() { return 0 }

