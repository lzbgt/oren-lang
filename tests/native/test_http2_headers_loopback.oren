// HTTP/2 HEADERS + HPACK loopback over TLS (rolling).
//
// Purpose:
// - Exercise the full “HTTP/2 control plane” IO path on Tier‑1:
//   - TLS ALPN "h2"
//   - client connection preface + SETTINGS
//   - HEADERS carrying an HPACK header block (incl Huffman)
//   - server response HEADERS + DATA + END_STREAM
//
// Scope (still intentionally small):
// - single stream (id=1)
// - no flow control / no WINDOW_UPDATE handling
// - no PRIORITY / PADDED
// - no HPACK dynamic table size updates beyond the default

import tcp "std:net/tcp"
import tls "std:net/tls"
import base64 "std:encoding/base64"
import h2 "std:net/http2"
import hpack "std:net/hpack"
import h2c "std:net/http2_client"
import list "std:list"
import fixture "./fixture_tls_p12.oren"
import spawner "./fixture_tls_spawn.oren"

fn _cstr_from_string(s) {
    if s == nil { s = "" }
    var n = oren_string_len(s)
    if n < 0 { n = 0 }
    if n > 128 { n = 128 }
    var p = malloc(n + 1)
    if p == 0 { return 0 }
    var i = 0
    while i < n {
        ptr_set_byte(p + i, oren_string_byte_at_unchecked(s, i) & 255)
        i = i + 1
    }
    ptr_set_byte(p + n, 0)
    return p
}

fn _str_eq_bytes(a, b) {
    if a == nil && b == nil { return true }
    if a == nil || b == nil { return false }
    var la = oren_string_len(a)
    var lb = oren_string_len(b)
    if la != lb { return false }
    var i = 0
    while i < la {
        if (oren_string_byte_at_unchecked(a, i) & 255) != (oren_string_byte_at_unchecked(b, i) & 255) { return false }
        i = i + 1
    }
    return true
}

fn _cstr_lit_server() {
    // "server\0"
    var p = malloc(7)
    if p == 0 { return 0 }
    ptr_set_byte(p + 0, 115)
    ptr_set_byte(p + 1, 101)
    ptr_set_byte(p + 2, 114)
    ptr_set_byte(p + 3, 118)
    ptr_set_byte(p + 4, 101)
    ptr_set_byte(p + 5, 114)
    ptr_set_byte(p + 6, 0)
    return p
}

fn u16be_at(ptr0, off) {
    var a = ptr_get_byte(ptr0 + off) & 255
    var b = ptr_get_byte(ptr0 + off + 1) & 255
    return a * 256 + b
}

fn _read_exact(conn, buf, need, timeout_ms) {
    if need < 0 { return 0 - 22 }
    var off = 0
    while off < need {
        var n = tls.read_into(conn, buf + off, need - off, timeout_ms)
        if n < 0 { return n }
        if n == 0 { return 0 - 104 }
        off = off + n
    }
    return 0
}

fn _write_all_ptr(conn, ptr0, n, timeout_ms) {
    if n < 0 { return 0 - 22 }
    var off = 0
    while off < n {
        var w = tls.write_from(conn, ptr0 + off, n - off, timeout_ms)
        if w < 0 { return w }
        if w == 0 { return 0 - 104 }
        off = off + w
    }
    return 0
}

fn _write_all_str(conn, s, n, timeout_ms) {
    return _write_all_ptr(conn, s, n, timeout_ms)
}

fn _write_all_bytes(conn, b, timeout_ms) {
    if b == nil { return 0 }
    var n = oren_buf_len(b)
    if oren_is_err(n) { return 0 - 22 }
    if n == 0 { return 0 }
    var p = native_buf_data_ptr(b)
    if p == 0 { return 0 - 22 }
    return _write_all_ptr(conn, p, n, timeout_ms)
}

@cfg(os="windows,linux")
fn _must_be_h2(proto) {
    if proto == nil { return 0 }
    if _str_eq_bytes(proto, "h2") != true { return 0 - 1 }
    return 0
}

@cfg(os="macos")
fn _must_be_h2(proto) {
    if proto == nil { return 0 }
    if _str_eq_bytes(proto, "h2") != true { return 0 - 1 }
    return 0
}

fn _read_frame(conn, timeout_ms) {
    var hdr = malloc(16)
    if hdr == 0 { return {"ok": 0, "err": "alloc hdr"} }
    var rr = _read_exact(conn, hdr, 9, timeout_ms)
    if rr != 0 { free(hdr); return {"ok": 0, "err": "read header"} }
    var fh = h2.parse_frame_header(hdr)
    if fh["ok"] != 1 { free(hdr); return {"ok": 0, "err": "parse header"} }
    var n = fh["len"]
    var payload = oren_u8_buf_new(n)
    if oren_is_err(payload) { free(hdr); return {"ok": 0, "err": "alloc payload"} }
    if n > 0 {
        var p = native_buf_data_ptr(payload)
        if p == 0 { free(hdr); return {"ok": 0, "err": "payload ptr"} }
        rr = _read_exact(conn, p, n, timeout_ms)
        if rr != 0 { free(hdr); return {"ok": 0, "err": "read payload"} }
    }
    free(hdr)
    return {"ok": 1, "type": fh["type"], "flags": fh["flags"], "stream": fh["stream"], "payload": payload}
}

fn _concat_bytes2(a, b) {
    // Concatenate two u8_buf into a new u8_buf.
    if a == nil { a = oren_u8_buf_new(0) }
    if b == nil { b = oren_u8_buf_new(0) }
    var na = oren_buf_len(a)
    var nb = oren_buf_len(b)
    if oren_is_err(na) || oren_is_err(nb) { return oren_err(4, "concat: bad buf") }
    var out = oren_u8_buf_new(na + nb)
    if oren_is_err(out) { return out }
    var p = native_buf_data_ptr(out)
    if p == 0 && (na + nb) > 0 { return oren_err(4, "concat: ptr nil") }
    if na > 0 {
        var pa = native_buf_data_ptr(a)
        if pa == 0 { return oren_err(4, "concat: pa nil") }
        var i = 0
        while i < na {
            ptr_set_byte(p + i, ptr_get_byte(pa + i) & 255)
            i = i + 1
        }
    }
    if nb > 0 {
        var pb = native_buf_data_ptr(b)
        if pb == 0 { return oren_err(4, "concat: pb nil") }
        var j = 0
        while j < nb {
            ptr_set_byte(p + na + j, ptr_get_byte(pb + j) & 255)
            j = j + 1
        }
    }
    return out
}

fn _read_header_block(conn, first_fr, timeout_ms) {
    // Assemble a complete header block from HEADERS + optional CONTINUATION frames.
    if first_fr == nil { return {"ok": 0, "err": "nil frame"} }
    if first_fr["type"] != h2.FRAME_HEADERS { return {"ok": 0, "err": "not HEADERS"} }

    var stream = first_fr["stream"]
    var flags = first_fr["flags"]
    var hb = first_fr["payload"]
    if (flags & h2.FLAG_END_HEADERS) != 0 {
        return {"ok": 1, "b": hb, "flags": flags}
    }

    // Must read one or more CONTINUATION frames on the same stream until END_HEADERS.
    while true {
        var fr = _read_frame(conn, timeout_ms)
        if fr["ok"] != 1 { return {"ok": 0, "err": "read continuation"} }
        if fr["type"] != h2.FRAME_CONTINUATION { return {"ok": 0, "err": "expected CONTINUATION"} }
        if fr["stream"] != stream { return {"ok": 0, "err": "continuation stream mismatch"} }
        hb = _concat_bytes2(hb, fr["payload"])
        if oren_is_err(hb) { return {"ok": 0, "err": "concat failed"} }
        if (fr["flags"] & h2.FLAG_END_HEADERS) != 0 {
            // END_HEADERS on the last CONTINUATION; return original HEADERS flags too (END_STREAM etc).
            return {"ok": 1, "b": hb, "flags": flags}
        }
    }
}

fn _send_headers_fragmented(conn, stream_id, headers_flags, header_block, split_at, timeout_ms) {
    // Send HEADERS + optional CONTINUATION.
    //
    // Caller must decide whether END_STREAM should be on HEADERS.
    if split_at == nil { split_at = 0 }
    if split_at < 0 { split_at = 0 }
    var n = oren_buf_len(header_block)
    if oren_is_err(n) { return 0 - 22 }
    if split_at == 0 || split_at >= n {
        // Single HEADERS.
        return _send_frame(conn, h2.FRAME_HEADERS, headers_flags | h2.FLAG_END_HEADERS, stream_id, header_block, timeout_ms)
    }

    // Split.
    var p = native_buf_data_ptr(header_block)
    if p == 0 { return 0 - 22 }
    var b0 = oren_u8_buf_new(split_at)
    var b1 = oren_u8_buf_new(n - split_at)
    if oren_is_err(b0) || oren_is_err(b1) { return 0 - 12 }
    var p0 = native_buf_data_ptr(b0)
    var p1 = native_buf_data_ptr(b1)
    if p0 == 0 || p1 == 0 { return 0 - 12 }
    var i = 0
    while i < split_at {
        ptr_set_byte(p0 + i, ptr_get_byte(p + i) & 255)
        i = i + 1
    }
    var j = 0
    while j < (n - split_at) {
        ptr_set_byte(p1 + j, ptr_get_byte(p + split_at + j) & 255)
        j = j + 1
    }

    // HEADERS without END_HEADERS.
    var rc = _send_frame(conn, h2.FRAME_HEADERS, headers_flags, stream_id, b0, timeout_ms)
    if rc != 0 { return rc }
    // CONTINUATION with END_HEADERS.
    return _send_frame(conn, h2.FRAME_CONTINUATION, h2.FLAG_END_HEADERS, stream_id, b1, timeout_ms)
}

fn _send_frame(conn, typ, flags, stream_id, payload_bytes, timeout_ms) {
    var hdr = malloc(16)
    if hdr == 0 { return 0 - 12 }
    var n = 0
    var p = 0
    if payload_bytes != nil {
        n = oren_buf_len(payload_bytes)
        if oren_is_err(n) { free(hdr); return 0 - 22 }
        if n > 0 {
            p = native_buf_data_ptr(payload_bytes)
            if p == 0 { free(hdr); return 0 - 22 }
        }
    }
    var rc = h2.write_frame_header(hdr, n, typ, flags, stream_id)
    if rc != 0 { free(hdr); return rc }
    var wr = _write_all_ptr(conn, hdr, 9, timeout_ms)
    if wr != 0 { free(hdr); return wr }
    if n > 0 {
        wr = _write_all_ptr(conn, p, n, timeout_ms)
        if wr != 0 { free(hdr); return wr }
    }
    free(hdr)
    return 0
}

fn _expect_headers_list(hs, expect) {
    if list.len(hs) != list.len(expect) { return 0 - 1 }
    var i = 0
    while i < list.len(expect) {
        var g = hs[i]
        var e = expect[i]
        if _str_eq_bytes(g["name"], e["name"]) != true { return 0 - 2 }
        if _str_eq_bytes(g["value"], e["value"]) != true { return 0 - 3 }
        i = i + 1
    }
    return 0
}

fn _expect_body_ok(body) {
    if body == nil { return 0 - 1 }
    if oren_buf_len(body) != 2 { return 0 - 2 }
    var p = native_buf_data_ptr(body)
    if p == 0 { return 0 - 3 }
    if (ptr_get_byte(p + 0) & 255) != 111 { return 0 - 4 } // 'o'
    if (ptr_get_byte(p + 1) & 255) != 107 { return 0 - 5 } // 'k'
    return 0
}

fn _client_roundtrip(conn) {
    // Use stdlib HTTP/2 client facade to avoid re-embedding frame logic in tests.
    var c = h2c.try_new(conn, 5000, {"settings": [[h2.SETTINGS_ENABLE_PUSH, 0]]})
    if oren_is_err(c) { return 0 - 11 }
    var rr = h2c.try_request(c, [
        {"name": ":method", "value": "GET"},
        {"name": ":scheme", "value": "https"},
        {"name": ":path", "value": "/"},
        {"name": ":authority", "value": "oren.test", "index": "inc"}
    ], nil, {"split_headers_at": 8})
    if oren_is_err(rr) { return 0 - 12 }
    if rr["status"] != 200 { return 0 - 13 }
    return _expect_body_ok(rr["body"])
}

fn server_impl(listen_fd, pfx_b64) {
    var fd = tcp.accept(listen_fd, 5000)
    if fd < 0 { return 11 }

    var pkcs12_bytes = base64.decode_bytes(pfx_b64)
    if oren_is_err(pkcs12_bytes) { return 101 }

    var srv_opts = {"alpn": ["h2", "http/1.1"]}
    var conn = tls.try_wrap_server_pkcs12(fd, 5000, pkcs12_bytes, fixture.passphrase(), srv_opts)
    if oren_is_err(conn) { return 12 }
    if conn == 0 { return 13 }

    var al = conn.negotiated_alpn()
    if oren_is_err(al) != true {
        var rc0 = _must_be_h2(al)
        if rc0 != 0 { tls.close(conn); return 14 }
    }

    // Preface.
    var pre = malloc(h2.CLIENT_PREFACE_LEN)
    if pre == 0 { tls.close(conn); return 15 }
    var rr0 = _read_exact(conn, pre, h2.CLIENT_PREFACE_LEN, 5000)
    if rr0 != 0 { free(pre); tls.close(conn); return 16 }
    free(pre)

    // SETTINGS (client). Require non-ACK.
    var fr = _read_frame(conn, 5000)
    if fr["ok"] != 1 { tls.close(conn); return 17 }
    if fr["type"] != h2.FRAME_SETTINGS { tls.close(conn); return 18 }
    if fr["stream"] != 0 { tls.close(conn); return 19 }
    if fr["flags"] != 0 { tls.close(conn); return 19 }
    // Expect a small deterministic SETTINGS payload from the client.
    var sm = h2.try_parse_settings_payload(fr["payload"])
    if oren_is_err(sm) { tls.close(conn); return 190 }
    if oren_map_get_int(sm, h2.SETTINGS_ENABLE_PUSH) != 0 { tls.close(conn); return 191 }

    // Respond with server SETTINGS (empty), then ACK client SETTINGS.
    var wr0 = _send_frame(conn, h2.FRAME_SETTINGS, 0, 0, oren_u8_buf_new(0), 5000)
    if wr0 != 0 { tls.close(conn); return 20 }
    wr0 = _send_frame(conn, h2.FRAME_SETTINGS, h2.FLAG_ACK, 0, oren_u8_buf_new(0), 5000)
    if wr0 != 0 { tls.close(conn); return 201 }

    // Read ACK for server SETTINGS.
    fr = _read_frame(conn, 5000)
    if fr["ok"] != 1 { tls.close(conn); return 202 }
    if fr["type"] != h2.FRAME_SETTINGS || fr["stream"] != 0 || fr["flags"] != h2.FLAG_ACK || oren_buf_len(fr["payload"]) != 0 { tls.close(conn); return 203 }

    // HEADERS (request) on stream 1.
    fr = _read_frame(conn, 5000)
    if fr["ok"] != 1 { tls.close(conn); return 21 }
    if fr["type"] != h2.FRAME_HEADERS { tls.close(conn); return 22 }
    if fr["stream"] != 1 { tls.close(conn); return 23 }
    if (fr["flags"] & h2.FLAG_PADDED) != 0 { tls.close(conn); return 24 }
    if (fr["flags"] & h2.FLAG_PRIORITY) != 0 { tls.close(conn); return 25 }
    // Assemble header block (HEADERS + CONTINUATION).
    var hb0 = _read_header_block(conn, fr, 5000)
    if hb0["ok"] != 1 { tls.close(conn); return 26 }

    var tbl = hpack.table_new(4096)
    var dr = hpack.decode_header_block(tbl, hb0["b"])
    if dr["ok"] != 1 { tls.close(conn); return 27 }
    var hs = dr["headers"]
    var exp = [
        {"name": ":method", "value": "GET"},
        {"name": ":scheme", "value": "https"},
        {"name": ":path", "value": "/"},
        {"name": ":authority", "value": "oren.test"}
    ]
    var okh = _expect_headers_list(hs, exp)
    if okh != 0 { tls.close(conn); return 28 }

    // Response HEADERS (fragmented) + DATA "ok".
    var rt = hpack.table_new(4096)
    var hr = hpack.encode_header_block(rt, [
        {"name": ":status", "value": "200"},
        {"name": "content-length", "value": "2", "index": "no"}
    ], {"huffman": 1})
    if hr["ok"] != 1 { tls.close(conn); return 29 }
    // Force CONTINUATION coverage by splitting if possible.
    var hflags = 0
    wr0 = _send_headers_fragmented(conn, 1, hflags, hr["b"], 8, 5000)
    if wr0 != 0 { tls.close(conn); return 30 }

    var data = oren_bytes_pack([111, 107]) // "ok"
    wr0 = _send_frame(conn, h2.FRAME_DATA, h2.FLAG_END_STREAM, 1, data, 5000)
    if wr0 != 0 { tls.close(conn); return 31 }

    tls.close(conn)
    return 0
}

@cfg(os="macos,linux,windows")
fn server_main(listen_fd, pfx_b64) {
    // Portable spawn entrypoint: return value is carried to the joiner across OS.
    // Do not call `exit(...)` here (Windows spawn is thread-based).
    return server_impl(listen_fd, pfx_b64)
}

@cfg(not_os="macos,linux,windows")
fn main() { exit(0) }

@cfg(os="windows")
fn _http2_headers_client_impl(port, expected_leaf_sha256_hex) {
    var tls_opts = {"insecure_skip_verify": 1, "pin_cert_sha256_hex": expected_leaf_sha256_hex, "server_name": "oren.test", "alpn": ["h2", "http/1.1"]}
    var conn = tls.try_connect("127.0.0.1", port, 5000, tls_opts)
    if oren_is_err(conn) { return 7 }
    if conn == 0 { return 8 }

    var al = conn.negotiated_alpn()
    if oren_is_err(al) != true {
        var rc0 = _must_be_h2(al)
        if rc0 != 0 { tls.close(conn); return 9 }
    }

    var rc_roundtrip = _client_roundtrip(conn)
    if rc_roundtrip != 0 { tls.close(conn); return 10 }

    tls.close(conn)
    return 0
}

@cfg(os="windows")
fn main_client() {
    var expected_leaf_sha256_hex = fixture.leaf_sha256_hex()
    var listen_fd = tcp.listen_local(0)
    if listen_fd < 0 { exit(3) }

    var sa = malloc(32)
    if sa == 0 { exit(4) }
    var lenp = malloc(8)
    if lenp == 0 { exit(5) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { exit(6) }
    var port = u16be_at(sa, 2)
    free(lenp)
    free(sa)

    var args_srv = oren_new_list(0)
    oren_list_push(args_srv, listen_fd)
    oren_list_push(args_srv, fixture.pkcs12_b64())
    var h = spawner.tls_spawn(server_main, args_srv)
    if h == 0 { exit(100) }

    var args_cli = oren_new_list(0)
    oren_list_push(args_cli, port)
    oren_list_push(args_cli, expected_leaf_sha256_hex)
    var hc = spawner.tls_spawn(_http2_headers_client_impl, args_cli)
    if hc == 0 { exit(101) }

    var rc2 = oren_join_timeout(hc, 5000)
    var sr2 = oren_join_timeout(h, 5000)
    tcp.close(listen_fd)
    if rc2 != 0 { exit(rc2) }
    if sr2 != 0 { exit(31) }
    exit(0)
}

@cfg(os="windows")
fn main() { return main_client() }

@cfg(os="linux")
fn main_client() {
    var pfx_b64 = fixture.pkcs12_b64()
    var expected_leaf_sha256_hex = fixture.leaf_sha256_hex()

    var listen_fd = oren_tcp_listen_local(0)
    if listen_fd < 0 { exit(3) }

    var sa = malloc(32)
    if sa == 0 { exit(4) }
    var lenp = malloc(8)
    if lenp == 0 { exit(5) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { exit(6) }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { exit(7) }

    var pid = sys_fork()
    if pid < 0 { exit(75) }
    if pid == 0 {
        exit(server_main(listen_fd, pfx_b64))
    }

    var fd = tcp.connect("127.0.0.1", port, 5000)
    if fd < 0 { exit(8) }
    var tls_opts = {"insecure_skip_verify": 1, "pin_cert_sha256_hex": expected_leaf_sha256_hex, "server_name": "oren.test", "alpn": ["h2", "http/1.1"]}
    var conn = tls.try_wrap_client(fd, "oren.test", 5000, tls_opts)
    if oren_is_err(conn) { exit(9) }
    if conn == 0 { exit(10) }

    var al = conn.negotiated_alpn()
    if oren_is_err(al) != true {
        var rc0 = _must_be_h2(al)
        if rc0 != 0 { tls.close(conn); exit(11) }
    }

    var rc_roundtrip = _client_roundtrip(conn)
    if rc_roundtrip != 0 { tls.close(conn); exit(12) }

    tls.close(conn)

    var status_ptr = malloc(8)
    if status_ptr == 0 { exit(33) }
    ptr_set(status_ptr, 0)
    var wpid = sys_wait4(pid, status_ptr, 0, 0)
    if wpid != pid { free(status_ptr); exit(34) }
    var status = ptr_get(status_ptr)
    free(status_ptr)
    tcp.close(listen_fd)
    if status != 0 { exit(35) }
    exit(0)
}

@cfg(os="macos")
fn main_client() {
    var expected_leaf_sha256_hex = fixture.leaf_sha256_hex()

    var listen_fd = oren_tcp_listen_local(0)
    if listen_fd < 0 { exit(3) }

    var exec_fd = listen_fd
    var dfd = sys_fcntl(listen_fd, FCNTL_F_DUPFD, 0)
    if dfd >= 0 { exec_fd = dfd }

    var sa = malloc(32)
    if sa == 0 { exit(4) }
    var lenp = malloc(8)
    if lenp == 0 { exit(5) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(listen_fd, sa, lenp)
    if grc < 0 { exit(6) }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { exit(7) }

    var pid = sys_fork()
    if pid < 0 { exit(75) }
    if pid == 0 {
        var path = _cstr_from_string(oren_args()[0])
        var arg0 = _cstr_from_string(oren_args()[0])
        var arg1 = _cstr_lit_server()
        var arg2 = _cstr_from_string(oren_int_to_string(exec_fd))
        var argv = malloc(32)
        if argv != 0 {
            ptr_set(argv + 0, arg0)
            ptr_set(argv + 8, arg1)
            ptr_set(argv + 16, arg2)
            ptr_set(argv + 24, 0)
            sys_execve(path, argv, 0)
        }
        exit(127)
    }

    var fd = tcp.connect("127.0.0.1", port, 5000)
    if fd < 0 { exit(8) }
    var tls_opts = {"insecure_skip_verify": 1, "pin_cert_sha256_hex": expected_leaf_sha256_hex, "server_name": "oren.test", "alpn": ["h2", "http/1.1"]}
    var conn = tls.try_wrap_client(fd, "oren.test", 5000, tls_opts)
    if oren_is_err(conn) { exit(9) }
    if conn == 0 { exit(10) }

    var al = conn.negotiated_alpn()
    if oren_is_err(al) != true {
        var rc0 = _must_be_h2(al)
        if rc0 != 0 { tls.close(conn); exit(11) }
    }

    var rc_roundtrip = _client_roundtrip(conn)
    if rc_roundtrip != 0 { tls.close(conn); exit(12) }

    tls.close(conn)

    var status_ptr = malloc(8)
    if status_ptr == 0 { exit(33) }
    ptr_set(status_ptr, 0)
    var wpid = sys_wait4(pid, status_ptr, 0, 0)
    if wpid != pid { free(status_ptr); exit(34) }
    var status = ptr_get(status_ptr)
    free(status_ptr)
    tcp.close(listen_fd)
    if status != 0 { exit(35) }
    exit(0)
}

@cfg(os="macos,linux")
fn main() {
    // For macOS, support fork+exec server mode (SecureTransport constraint).
    if oren_list_len(oren_args()) >= 2 && _str_eq_bytes(oren_args()[1], "server") {
        if oren_list_len(oren_args()) < 3 { exit(2) }
        var fd = oren_int_from_string(oren_args()[2])
        exit(server_main(fd, fixture.pkcs12_b64()))
    }
    return main_client()
}
