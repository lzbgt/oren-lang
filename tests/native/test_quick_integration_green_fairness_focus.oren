// Focused native quick-integration slice for the current stage1 global-runq fairness crash.
//
// This keeps only the topology prelude and the fairness test body, with knobs to isolate whether
// the failure needs the topology prelude, the full mixed hog+short path, or only one spawn shape.
//
// @include "qi/000_prelude.oren"
// @include "qi/100_tests_basic.oren"
// @include "qi/200_tests_wait_gc.oren"
// @include "qi/300_tests_green.oren"

fn _qi_green_fairness_focus_iters() {
    var v = oren_env("OREN_QI_STRESS_ITERS")
    if v == nil || v == "" { return 4 }
    var n = oren_int_from_string(v)
    if n <= 0 { return 4 }
    if n > 1000 { return 1000 }
    return n
}

fn _qi_green_fairness_focus_mode() {
    var v = oren_env("OREN_QI_GREEN_FAIRNESS_MODE")
    if v == nil || v == "" { return "full" }
    if strcmp(v, "short_only") == 0 { return "short_only" }
    if strcmp(v, "hogs_only") == 0 { return "hogs_only" }
    return "full"
}

fn _qi_green_fairness_focus_include_topology() {
    return _qi_env_truthy("OREN_QI_GREEN_FAIRNESS_INCLUDE_TOPOLOGY")
}

fn _qi_green_fairness_focus_hogs(mode) {
    if strcmp(mode, "short_only") == 0 { return 0 }
    return 8
}

fn _qi_green_fairness_focus_shorts(mode) {
    if strcmp(mode, "hogs_only") == 0 { return 0 }
    return 40
}

fn _qi_green_fairness_focus_step(msg) {
    trace("QI: green fairness focus " + msg)
}

fn main() {
    if oren_getenv("OREN_QI_TRACE") != 0 { g_qi_trace_on = 1 }

    var iters = _qi_green_fairness_focus_iters()
    var mode = _qi_green_fairness_focus_mode()
    var include_topology = _qi_green_fairness_focus_include_topology()
    var hogs = _qi_green_fairness_focus_hogs(mode)
    var shorts = _qi_green_fairness_focus_shorts(mode)

    if include_topology {
        _qi_green_fairness_focus_step("prelude test_green_topology_rejects_after_workers")
        test_green_topology_rejects_after_workers()
    }

    var i = 0
    while i < iters {
        var iter_s = oren_int_to_string(i + 1) + "/" + oren_int_to_string(iters)
        _qi_green_fairness_focus_step("iter=" + iter_s + " before test_green_global_runq_fairness_counts mode=" + mode + " hogs=" + oren_int_to_string(hogs) + " shorts=" + oren_int_to_string(shorts))
        test_green_global_runq_fairness_counts(hogs, shorts)
        _qi_green_fairness_focus_step("iter=" + iter_s + " done mode=" + mode)
        i = i + 1
    }

    print("ok: qi green fairness focus")
    exit(0)
}

main()
