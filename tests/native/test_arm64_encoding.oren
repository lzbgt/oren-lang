import core "../../lib/compiler/arm64_core.oren"

fn expect_u32(got, want, code) {
    if got != want {
        print("ARM64 encoding mismatch: got=" + oren_int_to_string(got) + " want=" + oren_int_to_string(want))
        exit(code)
    }
}

fn main() {
    // Loads/stores (golden values documented in lib/compiler/arm64_core.oren).
    expect_u32(core.insn_ldr_q(0, 0), 0x3DC00000, 100)
    expect_u32(core.insn_ldr_q(1, 1), 0x3DC00021, 101)
    expect_u32(core.insn_str_q(0, 2), 0x3D800040, 102)

    // STR Q with unsigned-offset encoding scaled by 16.
    // sp is register 31.
    expect_u32(core.insn_str_q_off(2, 31, 0), 0x3D8003E2, 110)
    expect_u32(core.insn_str_q_off(3, 31, 16), 0x3D8007E3, 111)

    // 32-bit loads/stores (unsigned offset encoding scaled by 4).
    expect_u32(core.insn_ldr_w(0, 2, 0), 0xB9400040, 120)
    expect_u32(core.insn_ldr_w(3, 4, 12), 0xB9400C83, 121)
    expect_u32(core.insn_str_w(0, 2, 0), 0xB9000040, 122)
    expect_u32(core.insn_str_w(3, 4, 12), 0xB9000C83, 123)

    // Signed 32->64 load (LDRSW) uses the same scaling as LDR W (imm12<<2).
    expect_u32(core.insn_ldrsw(2, 3, 0), 0xB9800062, 130)
    expect_u32(core.insn_ldrsw(4, 5, 12), 0xB9800CA4, 131)

    // Prologue/epilogue helpers.
    expect_u32(core.insn_stp_pre(), 0xA9BF7BFD, 135)    // stp x29, x30, [sp, #-16]!
    expect_u32(core.insn_mov_fp_sp(), 0x910003FD, 136)  // mov x29, sp
    expect_u32(core.insn_mov_sp_fp(), 0x910003BF, 137)  // mov sp, x29
    expect_u32(core.insn_ldp_post(), 0xA8C17BFD, 138)   // ldp x29, x30, [sp], #16
    expect_u32(core.insn_ret(), 0xD65F03C0, 139)
    expect_u32(core.insn_stp_pair_pre(19, 20, 31, -16), 0xA9BF53F3, 140) // stp x19, x20, [sp, #-16]!
    expect_u32(core.insn_ldp_pair_post(19, 20, 31, 16), 0xA8C153F3, 141) // ldp x19, x20, [sp], #16
    expect_u32(core.insn_stp_pair_pre(21, 22, 31, -32), 0xA9BE5BF5, 142) // stp x21, x22, [sp, #-32]!
    expect_u32(core.insn_ldp_pair_post(21, 22, 31, 32), 0xA8C25BF5, 143) // ldp x21, x22, [sp], #32

    // Basic integer ops + branches (assembled via clang on arm64-darwin).
    expect_u32(core.insn_add_imm(1, 2, 0), 0x91000041, 150)   // add x1, x2, #0
    expect_u32(core.insn_add_imm(1, 2, 123), 0x9101EC41, 151) // add x1, x2, #123
    expect_u32(core.insn_sub_imm(3, 4, 9), 0xD1002483, 152)   // sub x3, x4, #9
    expect_u32(core.insn_add_reg(5, 6, 7), 0x8B0700C5, 153)   // add x5, x6, x7
    expect_u32(core.insn_sub_reg(8, 9, 10), 0xCB0A0128, 154)  // sub x8, x9, x10
    expect_u32(core.insn_and_reg(3, 4, 5), 0x8A050083, 155)   // and x3, x4, x5
    expect_u32(core.insn_orr_reg(6, 7, 8), 0xAA0800E6, 156)   // orr x6, x7, x8
    expect_u32(core.insn_eor_reg(9, 10, 11), 0xCA0B0149, 157) // eor x9, x10, x11
    expect_u32(core.insn_cmp_reg(12, 13), 0xEB0D019F, 158)    // cmp x12, x13
    expect_u32(core.insn_cset(14, 0), 0x9A9F17EE, 159)        // cset x14, eq
    expect_u32(core.insn_cset(15, 1), 0x9A9F07EF, 160)        // cset x15, ne
    expect_u32(core.insn_add_sp(16), 0x910043FF, 161)         // add sp, sp, #16
    expect_u32(core.insn_sub_sp(32), 0xD10083FF, 162)         // sub sp, sp, #32
    expect_u32(core.insn_b(0), 0x14000000, 163)               // b .
    expect_u32(core.insn_bl(0), 0x94000000, 164)              // bl .
    expect_u32(core.insn_b_cond(0, 0), 0x54000000, 165)       // b.eq .
    expect_u32(core.insn_blr(11), 0xD63F0160, 166)            // blr x11
    expect_u32(core.insn_br(12), 0xD61F0180, 167)             // br x12
    expect_u32(core.insn_b(-1), 0x17FFFFFF, 168)              // b back 1 insn
    expect_u32(core.insn_b_cond(-1, 0), 0x54FFFFE0, 169)      // b.eq back 1 insn

    // PC-relative addressing.
    expect_u32(core.insn_adr(13, 0), 0x1000000D, 170) // adr x13, .
    expect_u32(core.insn_adrp(16, 0), 0x90000010, 171) // adrp x16, _sym@PAGE (page delta 0)
    expect_u32(core.insn_adr(3, 8), 0x10000043, 172)  // adr x3, +8 bytes
    expect_u32(core.insn_b(2), 0x14000002, 173)       // b forward 2 insns
    expect_u32(core.insn_adr(5, -4), 0x10FFFFE5, 174) // adr x5, -4 bytes

    // Unscaled signed-byte offset loads/stores.
    expect_u32(core.insn_stur_reg(1, 2, -8), 0xF81F8041, 180) // stur x1, [x2, #-8]
    expect_u32(core.insn_ldur_reg(3, 4, -16), 0xF85F0083, 181) // ldur x3, [x4, #-16]

    // Basic integer loads/stores (imm=0).
    expect_u32(core.insn_ldr_ptr(0, 1), 0xF9400020, 185) // ldr x0, [x1]
    expect_u32(core.insn_str_ptr(2, 3), 0xF9000062, 186) // str x2, [x3]
    expect_u32(core.insn_ldrb(4, 5), 0x394000A4, 187)    // ldrb w4, [x5]
    expect_u32(core.insn_ldr_reg_sp(0, 0), 0xF94003E0, 188) // ldr x0, [sp]
    expect_u32(core.insn_ldr_reg_sp(6, 16), 0xF9400BE6, 189) // ldr x6, [sp,#16]
    expect_u32(core.insn_str_x0_sp(0), 0xF90003E0, 190) // str x0, [sp]
    expect_u32(core.insn_str_reg_sp(7, 24), 0xF9000FE7, 191) // str x7, [sp,#24]

    // Atomics / barriers (clang-assembled on arm64-darwin).
    expect_u32(core.insn_strb(1, 2), 0x39000041, 210)        // strb w1, [x2]
    expect_u32(core.insn_ldaxr(3, 4), 0xC85FFC83, 211)       // ldaxr x3, [x4]
    expect_u32(core.insn_stlxr(5, 6, 7), 0xC805FCE6, 212)    // stlxr w5, x6, [x7]
    expect_u32(core.insn_clrex(), 0xD5033F5F, 213)           // clrex
    expect_u32(core.insn_ldadd(8, 9, 10), 0xF8280149, 214)   // ldadd x8, x9, [x10]
    expect_u32(core.insn_cas(11, 12, 13), 0xC8AB7DAC, 215)   // cas x11, x12, [x13]

    // Load/patch immediates (MOVZ/MOVK/MOVN).
    expect_u32(core.insn_movz(5, 0x1234), 0xD2824685, 190)    // mov x5, #0x1234
    expect_u32(core.insn_movk(5, 0x5678, 1), 0xF2AACF05, 191) // movk x5, #0x5678, lsl #16
    expect_u32(core.insn_movn(6, 0), 0x92800006, 192)         // mov x6, #-1

    // Register <-> vector moves/broadcasts.
    expect_u32(core.insn_dup_2d(4, 0), 0x4E080C04, 140) // dup v4.2d, x0
    expect_u32(core.insn_dup_4s(4, 0), 0x4E040C04, 141) // dup v4.4s, w0
    expect_u32(core.insn_fmov_s_w(0, 0), 0x1E270000, 142) // fmov s0, w0
    expect_u32(core.insn_fmov_w_s(0, 0), 0x1E260000, 143) // fmov w0, s0
    expect_u32(core.insn_umov_x_d1(1, 4), 0x4E183C81, 144) // umov x1, v4.d[1]

    // Vector ops: add/sub.
    expect_u32(core.insn_add_2d(4, 2, 3), 0x4EE38444, 160) // add v4.2d, v2.2d, v3.2d
    expect_u32(core.insn_sub_2d(4, 2, 3), 0x6EE38444, 161) // sub v4.2d, v2.2d, v3.2d
    expect_u32(core.insn_add_4s(0, 0, 1), 0x4EA18400, 162) // add v0.4s, v0.4s, v1.4s

    // A couple of SIMD scalar/vector arithmetic encodings (also golden in arm64_core.oren).
    expect_u32(core.insn_fadd_4s(0, 0, 1), 0x4E21D400, 200)
    expect_u32(core.insn_fadd_2d(3, 1, 2), 0x4E62D423, 201)
    expect_u32(core.insn_fmul_4s(0, 0, 1), 0x6E21DC00, 202)
    expect_u32(core.insn_fmul_2d(4, 1, 2), 0x6E62DC24, 203)
    expect_u32(core.insn_fadd_s(0, 0, 1), 0x1E212800, 204)
    expect_u32(core.insn_fmul_s(0, 0, 1), 0x1E210800, 205)

    // Widening/long ops (lane widening + pairwise add).
    expect_u32(core.insn_fcvtl_2d_from_2s(2, 0), 0x0E617802, 220)  // fcvtl v2.2d, v0.2s
    expect_u32(core.insn_fcvtl2_2d_from_4s(3, 0), 0x4E617803, 221) // fcvtl2 v3.2d, v0.4s
    expect_u32(core.insn_smull_2d(2, 0, 1), 0x0EA1C002, 222)       // smull v2.2d, v0.2s, v1.2s
    expect_u32(core.insn_smull2_2d(3, 0, 1), 0x4EA1C003, 223)      // smull2 v3.2d, v0.4s, v1.4s
    expect_u32(core.insn_addp_2d(5, 4, 4), 0x4EE4BC85, 224)        // addp v5.2d, v4.2d, v4.2d

    print("arm64 encoding OK")
    exit(0)
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
