fn test_green_worker_wake_while_sleepers() {
    trace("QI: test_green_worker_wake_while_sleepers")
    if g_target_os == 3 { return 0 }

    // Ensure background worker mode is active.
    var rc = oren_green_start_workers(1)
    assert_eq(rc, 0, 490)

    // Spawn a sleeper so the worker goes into the "sleep until next wake" path.
    // Then inject runnable work from the main thread and verify it completes quickly.
    trace("QI: spawn sleeper")
    var h_sleep = spawn worker_green_sleep_400ms_then_ret2()

    // Give the worker a moment to run and park/sleep on the sleeper deadline.
    trace("QI: host sleep 20ms")
    oren_sleep_ms(20)

    trace("QI: spawn runnable batch")
    var hs = []
    var i = 0
    while i < 10 {
        var h = spawn worker_green_ret_one()
        oren_list_push(hs, h)
        i = i + 1
    }
    trace("QI: join runnable batch")
    i = 0
    while i < oren_list_len(hs) {
        var hh = oren_list_get(hs, i)
        var r = oren_join_timeout(hh, 200)
        assert_eq(r, 1, 491)
        i = i + 1
    }

    trace("QI: join sleeper")
    var r2 = oren_join_timeout(h_sleep, 2000)
    assert_eq(r2, 2, 492)
    return 0
}

fn test_green_workers_many_tasks_bounded() {
    trace("QI: test_green_workers_many_tasks_bounded")
    if g_target_os == 3 { return 0 }

    // Ensure background worker mode is active.
    var rc = oren_green_start_workers(1)
    assert_eq(rc, 0, 520)

    // Stress: spawn many short green tasks and ensure joins are bounded (no hangs).
    var hs = []
    var i = 0
    while i < 200 {
        var h = 0
        if (i & 7) == 0 {
            h = spawn worker_green_sleep_1ms_then_ret_one()
        } else {
            h = spawn worker_green_ret_one()
        }
        oren_list_push(hs, h)
        i = i + 1
    }

    i = 0
    while i < oren_list_len(hs) {
        var hh = oren_list_get(hs, i)
        var r = oren_join_timeout(hh, 2000)
        assert_eq(r, 1, 521)
        i = i + 1
    }
    return 0
}

fn test_green_poll_cache_does_not_corrupt_p_ptr() {
    trace("QI: test_green_poll_cache_does_not_corrupt_p_ptr")
    // Regression guard for cached scheduler locals (`OREN_GREEN_POLL_CACHE=1`).
    //
    // Historical failure mode (cached mode only):
    // - scheduler locals (notably `P* p`) could be clobbered across a context switch and collapse
    //   into a small integer (e.g. `2`), later crashing in `ptr_get(p + off)` or tripping the
    //   fast-fail `exit(940)` guard in `_green_poll_until_budget`.
    //
    // Keep this test small and deterministic: just stress many ctx switches in cached mode.
    if _qi_env_truthy("OREN_GREEN_POLL_CACHE") != true { return 0 }
    if _qi_env_truthy("OREN_NO_GREEN") == true { return 0 }
    if g_target_os == 3 { return 0 } // Windows uses a different spawn substrate today.

    // Ensure the cached knob is latched even if the runtime hasn't consulted env yet.
    oren_green_set_poll_cache_mode(1)

    var hs = []
    var i = 0
    // Keep bounded for qemu-x86_64 gates; still forces many context switches.
    while i < 20 {
        var h = spawn worker_green_yield_then_ret()
        oren_list_push(hs, h)
        i = i + 1
    }

    i = 0
    while i < oren_list_len(hs) {
        var hh = oren_list_get(hs, i)
        var r = oren_join_timeout(hh, _qi_timeout_ms(2000))
        assert_eq(r, 77, 522)
        i = i + 1
    }

    // Host-thread should still have a valid P binding after driving the scheduler.
    var pid = oren_green_current_p_id()
    assert_eq(pid, 0, 523)
    return 0
}

fn test_proc_system_windows() {
    trace("QI: test_proc_system_windows")
    if g_target_os != 3 { return 0 }
    // Windows: `oren_system` is implemented via CreateProcessA + cmd.exe /C.
    // Assert the PROC substrate is wired correctly for the x64-windows native backend gate.
    var rc = oren_system_timeout("echo native quick integration proc ok", -1)
    assert_eq(rc, 0, 470)
    return 0
}

