fn test_green_multi_p_single_thread_poll_steal() {
    trace("QI: test_green_multi_p_single_thread_poll_steal")
    // Green tasks are the default `spawn` path on macOS/Linux today.
    // Windows uses CreateThread for `spawn`, so skip this test there.
    if g_target_os == 3 { return 0 }

    // Reset debug counters: this fixture should force at least one steal.
    oren_green_debug_reset()

    // Ensure at least 3 Ps exist.
    var rc_pc = oren_green_set_p_count(3)
    assert_eq(rc_pc, 0, 525)
    if oren_green_p_count() < 3 { fail(526) }

    // Bind to P2 so local spawns land on P2.
    var rc_b2 = oren_green_bind_p(2)
    assert_eq(rc_b2, 0, 527)
    assert_eq(oren_green_current_p_id(), 2, 528)

    // Reset globals for this fixture.
    g_green_multi_p_handles = []
    g_green_multi_p_expect = []

    // Spawn seed task (injected via global runq). It will run on P2 and enqueue children into P2 local runq.
    var h_seed = spawn worker_green_seed_multi_p_local_queue()

    // Run exactly two context switches on P2:
    // - seed task (from global queue) enqueues children into P2 local runq
    // - the last-spawned sleeper runs and parks in P2 sleepq
    var rc_poll = oren_green_poll_steps(2)
    assert_eq(rc_poll, 0, 530)

    // Children should not be done yet (only the seed task ran for one slice).
    var i = 0
    while i < oren_list_len(g_green_multi_p_handles) {
        var h = oren_list_get(g_green_multi_p_handles, i)
        if oren_green_is_done(h) == true { fail(531) }
        i = i + 1
    }

    // Rebind to P0 and drive the scheduler until idle. With local+global empty on P0,
    // it must steal from P2's local runq to make progress.
    var rc_b0 = oren_green_bind_p(0)
    assert_eq(rc_b0, 0, 532)
    assert_eq(oren_green_current_p_id(), 0, 533)
    var rc_poll2 = oren_green_poll_until(0)
    assert_eq(rc_poll2, 0, 534)

    // Regression guard: P0 must steal from P2 to make progress (local+global empty on P0).
    // Verify the stealing path was exercised.
    assert_true(oren_green_debug_steal_count() > 0, 585)
    assert_eq(oren_green_debug_last_steal_p_id(), 2, 586)

    // Join all seeded child tasks and validate their results.
    i = 0
    while i < oren_list_len(g_green_multi_p_handles) {
        var hh = oren_list_get(g_green_multi_p_handles, i)
        var expect = oren_list_get(g_green_multi_p_expect, i)
        var r = oren_join_timeout(hh, 2000)
        assert_eq(r, expect, 535)
        i = i + 1
    }

    // Also join the seed task (it yielded once, then should complete on subsequent polls/steals).
    var rseed = oren_join_timeout(h_seed, 2000)
    assert_eq(rseed, 0, 536)
    return 0
}

fn test_green_p_acquire_release_blocks_start_workers() {
    trace("QI: test_green_p_acquire_release_blocks_start_workers")
    if g_target_os == 3 { return 0 }

    // Ensure we start clean (best-effort; should be a no-op in normal runs).
    oren_green_release_p()

    var tid = oren_green_debug_tid()
    if tid == 0 { fail(588) }

    // Ensure multiple Ps exist so we can switch ownership deterministically.
    var rc_pc = oren_green_set_p_count(2)
    assert_eq(rc_pc, 0, 589)

    // Acquire P1 and validate ownership.
    var rc_a1 = oren_green_acquire_p(1)
    assert_eq(rc_a1, 0, 590)
    assert_eq(oren_green_current_p_id(), 1, 591)
    assert_eq(oren_green_debug_p_owner_tid(1), tid, 592)

    // Switching ownership should auto-release the previous P.
    var rc_a0 = oren_green_acquire_p(0)
    assert_eq(rc_a0, 0, 593)
    assert_eq(oren_green_current_p_id(), 0, 594)
    assert_eq(oren_green_debug_p_owner_tid(0), tid, 595)
    assert_eq(oren_green_debug_p_owner_tid(1), 0, 596)

    // Starting workers while any P is claimed by a host thread must fail early (no hard abort later).
    assert_eq(oren_green_start_workers(1), -1, 597)

    // After releasing, starting workers should succeed (validated by the next fixture).
    var rc_rel = oren_green_release_p()
    assert_eq(rc_rel, 0, 598)
    assert_eq(oren_green_debug_p_owner_tid(0), 0, 599)
    return 0
}

fn test_green_idle_p_pool_acquire_any() {
    trace("QI: test_green_idle_p_pool_acquire_any")
    if g_target_os == 3 { return 0 }

    // Ensure we start clean (best-effort).
    oren_green_release_p()

    var tid = oren_green_debug_tid()
    if tid == 0 { fail(640) }

    // Ensure multiple Ps exist so we can validate the idle pool deterministically.
    var rc_pc = oren_green_set_p_count(3)
    assert_eq(rc_pc, 0, 641)
    assert_true(oren_green_p_count() >= 3, 642)

    // Acquire P1 then release it: it must become available again via the idle-P pool.
    var rc_a1 = oren_green_acquire_p(1)
    assert_eq(rc_a1, 0, 643)
    assert_eq(oren_green_debug_p_owner_tid(1), tid, 644)
    var rc_rel = oren_green_release_p()
    assert_eq(rc_rel, 0, 645)
    assert_eq(oren_green_debug_p_owner_tid(1), 0, 646)

    // Acquire any free P: should succeed and return an owned P id.
    var got = oren_green_acquire_any_p()
    assert_true(got >= 0, 647)
    assert_true(got < 3, 648)
    assert_eq(oren_green_debug_p_owner_tid(got), tid, 649)

    // Cleanup.
    oren_green_release_p()
    assert_eq(oren_green_debug_p_owner_tid(got), 0, 650)
    return 0
}

fn test_green_p_count_api() {
    trace("QI: test_green_p_count_api")
    if g_target_os == 3 { return 0 }

    // The green runtime initializes with exactly one P.
    var c0 = oren_green_p_count()
    assert_eq(c0, 1, 537)

    // P count can be increased before workers start (no shrink in rolling mode).
    var rc = oren_green_set_p_count(4)
    assert_eq(rc, 0, 538)
    var c1 = oren_green_p_count()
    assert_eq(c1, 4, 539)

    // Current thread P binding can be changed before workers start (Stage N3 plumbing).
    var rc_b0 = oren_green_bind_p(0)
    assert_eq(rc_b0, 0, 540)
    assert_eq(oren_green_current_p_id(), 0, 541)
    var rc_b2 = oren_green_bind_p(2)
    assert_eq(rc_b2, 0, 542)
    assert_eq(oren_green_p_count(), 4, 543)
    assert_eq(oren_green_current_p_id(), 2, 544)
    return 0
}

fn test_green_topology_rejects_after_workers() {
    trace("QI: test_green_topology_rejects_after_workers")
    if g_target_os == 3 { return 0 }

    // Ensure worker mode is active (idempotent).
    var rcw = oren_green_start_workers(1)
    assert_eq(rcw, 0, 545)

    // Once workers start, changing P count / binding / polling is rejected (rolling safety).
    assert_eq(oren_green_set_p_count(5), -1, 546)
    assert_eq(oren_green_bind_p(0), -1, 547)
    assert_eq(oren_green_poll_until(0), -1, 548)
    assert_eq(oren_green_poll_steps(1), -1, 549)
    return 0
}

fn test_green_global_runq_fairness() {
    trace("QI: test_green_global_runq_fairness")
    // Green tasks are the default `spawn` path on macOS/Linux today.
    // Windows uses CreateThread for `spawn`, so skip this test there.
    if g_target_os == 3 { return 0 }

    // Ensure background worker mode is active.
    var rc = oren_green_start_workers(1)
    assert_eq(rc, 0, 484)

    // Meta page used as a stop flag shared between the main thread and green tasks.
    // (This test intentionally avoids GC-visible allocations inside the hog tasks.)
    var meta = sys_mmap_private_anon(4096)
    if meta == 0 || meta == -1 || meta < 4096 { fail(485) }
    ptr_set(meta + _off_green_hog_stop(), 0)

    // Spawn perpetual hog tasks. They will quickly migrate to the worker's local runq (P) and keep it non-empty.
    var hogs = []
    var i = 0
    while i < 8 {
        var h = spawn worker_green_hog_until_stop(meta)
        oren_list_push(hogs, h)
        i = i + 1
    }

    // Spawn short tasks from the main thread (outside green context). These are injected via the global runq.
    // Without fairness, these can starve indefinitely if the local runq is never empty.
    var hs = []
    i = 0
    while i < 40 {
        var h2 = spawn worker_green_ret_one()
        oren_list_push(hs, h2)
        i = i + 1
    }

    i = 0
    while i < oren_list_len(hs) {
        var hh = oren_list_get(hs, i)
        var r = oren_join_timeout(hh, _qi_timeout_ms(2000))
        assert_eq(r, 1, 486)
        i = i + 1
    }

    // Stop hog tasks and join them so they don't leak into later tests.
    ptr_set(meta + _off_green_hog_stop(), 1)
    i = 0
    while i < oren_list_len(hogs) {
        var hh2 = oren_list_get(hogs, i)
        var r2 = oren_join_timeout(hh2, _qi_timeout_ms(2000))
        assert_eq(r2, 0, 487)
        i = i + 1
    }
    sys_munmap(meta, 4096)
    return 0
}

fn test_green_ctx_switch_alloc_integrity() {
    trace("QI: test_green_ctx_switch_alloc_integrity")
    if g_target_os == 3 { return 0 }

    // Spawn two green tasks that heavily interleave allocations + yields.
