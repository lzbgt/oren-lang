fn test_std_buffer_smoke() {
    trace("QI: test_std_buffer_smoke")
    var i32b = bufferm.i32_new(2)
    assert_true(oren_is_err(i32b) == false, 7840)
    assert_eq(bufferm.len(i32b), 2, 7841)
    var i32s = bufferm.store_i32(i32b, 0, -7)
    assert_true(oren_is_err(i32s) == false, 7842)
    assert_eq(i32s, i32b, 7843)
    assert_eq(bufferm.load_i32(i32b, 0), -7, 7844)
    assert_true(oren_is_err(bufferm.load_i32(i32b, 2)), 7845)

    var i64b = bufferm.i64_new(2)
    assert_true(oren_is_err(i64b) == false, 7846)
    var i64s = bufferm.store_i64(i64b, 1, 4294967296)
    assert_true(oren_is_err(i64s) == false, 7847)
    assert_eq(i64s, i64b, 7848)
    assert_eq(bufferm.load_i64(i64b, 1), 4294967296, 7849)
    var i32_list = bufferm.i32_unpack_list(i32b)
    assert_true(oren_is_err(i32_list) == false, 7923)
    assert_eq(oren_list_len(i32_list), 2, 7924)
    assert_eq(i32_list[0], -7, 7925)
    var i32_pack_try = bufferm.i32_pack_list_int([5, 6])
    assert_true(oren_is_err(i32_pack_try) == false, 7926)
    var i32_pack_list = bufferm.i32_unpack_list(i32_pack_try)
    assert_true(oren_is_err(i32_pack_list) == false, 7927)
    assert_eq(i32_pack_list[1], 6, 7928)
    var i32_into = bufferm.i32_new(2)
    assert_true(oren_is_err(i32_into) == false, 7930)
    assert_true(oren_is_err(bufferm.i32_pack_list_int_into(i32_into, [5, 6])) == false, 7931)
    assert_eq(bufferm.i32_unpack_list(i32_into)[0], 5, 7932)
    assert_true(oren_is_err(bufferm.i32_pack_list_int([2147483648])), 7929)
    var i64_pack_try = bufferm.i64_pack_list_int([8, 9, 4294967296])
    assert_true(oren_is_err(i64_pack_try) == false, 8590)
    var i64_pack_list = bufferm.i64_unpack_list(i64_pack_try)
    assert_true(oren_is_err(i64_pack_list) == false, 8591)
    assert_eq(i64_pack_list[2], 4294967296, 8592)
    var i64_into = bufferm.i64_new(2)
    assert_true(oren_is_err(i64_into) == false, 8593)
    assert_true(oren_is_err(bufferm.i64_pack_list_int_into(i64_into, [10, 11])) == false, 8594)
    assert_eq(bufferm.i64_unpack_list(i64_into)[1], 11, 8595)
    assert_true(oren_is_err(bufferm.i64_pack_list_int_into(i64_into, [1])), 8596)
    assert_true(oren_is_err(bufferm.i32_pack_list_int_into(i64_into, [10, 11])), 99596)
    var f32_pack_try = bufferm.f32_pack_list([1.5, 2.5, 3.5])
    assert_true(oren_is_err(f32_pack_try) == false, 8597)
    var f32_pack_list = bufferm.f32_unpack_list(f32_pack_try)
    assert_true(oren_is_err(f32_pack_list) == false, 8598)
    assert_eq(oren_list_len(f32_pack_list), 3, 8599)
    var f32_into = bufferm.f32_new(2)
    assert_true(oren_is_err(f32_into) == false, 8600)
    assert_true(oren_is_err(bufferm.f32_pack_list_into(f32_into, [4.5, 5.5])) == false, 8601)
    assert_eq(oren_list_len(bufferm.f32_unpack_list(f32_into)), 2, 8602)
    assert_true(oren_is_err(bufferm.f32_pack_list_into(f32_into, [1.0])), 8603)
    var f64_pack_try = bufferm.f64_pack_list([6.25, 7.25])
    assert_true(oren_is_err(f64_pack_try) == false, 8604)
    var f64_pack_list = bufferm.f64_unpack_list(f64_pack_try)
    assert_true(oren_is_err(f64_pack_list) == false, 8605)
    assert_eq(oren_list_len(f64_pack_list), 2, 8606)
    var f64_into = bufferm.f64_new(2)
    assert_true(oren_is_err(f64_into) == false, 8607)
    assert_true(oren_is_err(bufferm.f64_pack_list_into(f64_into, [8.25, 9.25])) == false, 8608)
    assert_eq(oren_list_len(bufferm.f64_unpack_list(f64_into)), 2, 8609)
    assert_true(oren_is_err(bufferm.f64_pack_list_into(f64_into, [1.0])), 8610)
    var i32_copy_src = bufferm.i32_pack_list_int([12, 13])
    assert_true(oren_is_err(i32_copy_src) == false, 8611)
    var i32_copy_dst = bufferm.i32_new(2)
    assert_true(oren_is_err(i32_copy_dst) == false, 8612)
    assert_true(oren_is_err(bufferm.i32_copy_from_i32_buf(i32_copy_dst, i32_copy_src)) == false, 8613)
    assert_eq(bufferm.i32_unpack_list(i32_copy_dst)[1], 13, 8614)
    assert_true(oren_is_err(bufferm.i32_copy_from_i32_buf(i32_copy_dst, bufferm.i32_new(3))), 8615)
    assert_true(oren_is_err(bufferm.i32_copy_from_i32_buf(i32_copy_dst, bufferm.u8_from_string("AB"))), 8616)
    var i64_copy_src = bufferm.i64_pack_list_int([14, 15])
    assert_true(oren_is_err(i64_copy_src) == false, 8617)
    var i64_copy_dst = bufferm.i64_new(2)
    assert_true(oren_is_err(i64_copy_dst) == false, 8618)
    assert_true(oren_is_err(bufferm.i64_copy_from_i64_buf(i64_copy_dst, i64_copy_src)) == false, 8619)
    assert_eq(bufferm.i64_unpack_list(i64_copy_dst)[0], 14, 8620)
    assert_true(oren_is_err(bufferm.i64_copy_from_i64_buf(i64_copy_dst, bufferm.i64_new(3))), 8621)
    assert_true(oren_is_err(bufferm.i64_copy_from_i64_buf(i64_copy_dst, bufferm.u8_from_string("AB"))), 8622)
    var f32_copy_src = bufferm.f32_pack_list([6.5, 7.5])
    assert_true(oren_is_err(f32_copy_src) == false, 8623)
    var f32_copy_dst = bufferm.f32_new(2)
    assert_true(oren_is_err(f32_copy_dst) == false, 8624)
    assert_true(oren_is_err(bufferm.f32_copy_from_f32_buf(f32_copy_dst, f32_copy_src)) == false, 8625)
    assert_eq(oren_list_len(bufferm.f32_unpack_list(f32_copy_dst)), 2, 8626)
    assert_true(oren_is_err(bufferm.f32_copy_from_f32_buf(f32_copy_dst, bufferm.f32_new(3))), 8627)
    assert_true(oren_is_err(bufferm.f32_copy_from_f32_buf(f32_copy_dst, bufferm.u8_from_string("AB"))), 8628)
    var f64_copy_src = bufferm.f64_pack_list([10.25, 11.25])
    assert_true(oren_is_err(f64_copy_src) == false, 8629)
    var f64_copy_dst = bufferm.f64_new(2)
    assert_true(oren_is_err(f64_copy_dst) == false, 8630)
    assert_true(oren_is_err(bufferm.f64_copy_from_f64_buf(f64_copy_dst, f64_copy_src)) == false, 8631)
    assert_eq(oren_list_len(bufferm.f64_unpack_list(f64_copy_dst)), 2, 8632)
    assert_true(oren_is_err(bufferm.f64_copy_from_f64_buf(f64_copy_dst, bufferm.f64_new(3))), 8633)
    assert_true(oren_is_err(bufferm.f64_copy_from_f64_buf(f64_copy_dst, bufferm.u8_from_string("AB"))), 8634)
    var u8_from = bufferm.u8_from_string("AB")
    assert_true(oren_is_err(u8_from) == false, 7930)
    assert_streq(bufferm.u8_to_string(u8_from), "AB", 7931)
    var u8_list = bufferm.u8_unpack(u8_from)
    assert_true(oren_is_err(u8_list) == false, 7932)
    assert_eq(oren_list_len(u8_list), 2, 7933)
    assert_eq(u8_list[0], 65, 7934)
    assert_eq(u8_list[1], 66, 7935)
    var u8_pack = bufferm.u8_pack([67, 68])
    assert_true(oren_is_err(u8_pack) == false, 7936)
    assert_streq(bufferm.u8_to_string(u8_pack), "CD", 7937)
    assert_true(oren_is_err(bufferm.u8_pack([256])), 7938)
    assert_true(oren_is_err(bufferm.u8_pack(123)), 7939)
    assert_true(oren_is_err(bufferm.u8_from_string(123)), 7940)
    var u8_from_bytes = bufferm.u8_from_bytes(bytesm.from_string("EF"))
    assert_true(oren_is_err(u8_from_bytes) == false, 7962)
    assert_streq(bufferm.u8_to_string(u8_from_bytes), "EF", 7963)
    var u8_from_bytes_slice = bufferm.u8_from_bytes_slice(bytesm.from_string("hello"), 1, 3)
    assert_true(oren_is_err(u8_from_bytes_slice) == false, 7964)
    assert_streq(bufferm.u8_to_string(u8_from_bytes_slice), "ell", 7965)
    var u8_to_bytes = bufferm.u8_to_bytes(u8_pack)
    assert_true(oren_is_err(u8_to_bytes) == false, 7966)
    assert_streq(bytesm.to_string(u8_to_bytes), "CD", 7967)
    var u8_copy_dst = bufferm.u8_new(2)
    assert_true(oren_is_err(u8_copy_dst) == false, 8635)
    assert_true(oren_is_err(bufferm.u8_copy_from_u8_buf(u8_copy_dst, u8_pack)) == false, 8636)
    assert_streq(bufferm.u8_to_string(u8_copy_dst), "CD", 8637)
    assert_true(oren_is_err(bufferm.u8_copy_from_bytes(u8_copy_dst, bytesm.from_string("EF"))) == false, 8638)
    assert_streq(bufferm.u8_to_string(u8_copy_dst), "EF", 8639)
    assert_true(oren_is_err(bufferm.u8_copy_from_bytes_slice(u8_copy_dst, bytesm.from_string("WXYZ"), 1, 2)) == false, 8701)
    assert_streq(bufferm.u8_to_string(u8_copy_dst), "XY", 8702)
    assert_true(oren_is_err(bufferm.u8_copy_from_string(u8_copy_dst, "GH")) == false, 8640)
    assert_streq(bufferm.u8_to_string(u8_copy_dst), "GH", 8641)
    assert_true(oren_is_err(bufferm.u8_copy_from_string_slice(u8_copy_dst, "LMNO", 1, 2)) == false, 8730)
    assert_streq(bufferm.u8_to_string(u8_copy_dst), "MN", 8731)
    assert_true(oren_is_err(bufferm.u8_copy_from_u8_buf(u8_copy_dst, bufferm.u8_new(3))), 8642)
    assert_true(oren_is_err(bufferm.u8_copy_from_u8_buf(u8_copy_dst, i32_copy_src)), 8643)
    assert_true(oren_is_err(bufferm.u8_copy_from_bytes(u8_copy_dst, bytesm.from_string("XYZ"))), 8644)
    assert_true(oren_is_err(bufferm.u8_copy_from_bytes_slice(u8_copy_dst, bytesm.from_string("WXYZ"), 1, 3)), 8703)
    assert_true(oren_is_err(bufferm.u8_copy_from_string(u8_copy_dst, "JKL")), 8645)
    assert_true(oren_is_err(bufferm.u8_from_string_slice("nope", 0, 5)), 8732)
    assert_true(oren_is_err(bufferm.u8_copy_from_string_slice(u8_copy_dst, "JKL", 0, 3)), 8733)
    assert_true(oren_is_err(bufferm.u8_from_bytes("nope")), 7968)
    assert_true(oren_is_err(bufferm.u8_from_bytes_slice("nope", 0, 1)), 7969)
    assert_true(oren_is_err(bufferm.u8_to_bytes("nope")), 7970)

    var slice = bufferm.slice_new(i32b, 0, 2)
    assert_true(oren_is_err(slice) == false, 7894)
    assert_true(oren_is_err(bufferm.slice_new(i32b, "x", 1)), 7895)
    assert_eq(bufferm.slice_load_i32(slice, 0), -7, 7896)
    var slice_store = bufferm.slice_store_i32(slice, 1, 9)
    assert_true(oren_is_err(slice_store) == false, 7897)
    assert_eq(slice_store, i32b, 7898)
    assert_eq(bufferm.slice_load_i32(slice, 1), 9, 7899)
    assert_true(oren_is_err(bufferm.slice_load_i32(slice, 2)), 7900)
    var sub = bufferm.slice_slice(slice, 1, 1)
    assert_true(oren_is_err(sub) == false, 7901)
    assert_eq(bufferm.slice_len(sub), 1, 7902)
    assert_eq(bufferm.slice_load_i32(sub, 0), 9, 7903)

    var u8_view_buf = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_view_buf) == false, 7971)
    var u8_slice = bufferm.slice_new(u8_view_buf, 1, 3)
    assert_true(oren_is_err(u8_slice) == false, 7972)
    assert_streq(bufferm.slice_to_string(u8_slice), "BCD", 7973)
    var u8_slice_bytes = bufferm.slice_to_bytes(u8_slice)
    assert_true(oren_is_err(u8_slice_bytes) == false, 7974)
    assert_streq(bytesm.to_string(u8_slice_bytes), "BCD", 7975)
    var u8_slice_list = bufferm.slice_unpack_u8(u8_slice)
    assert_true(oren_is_err(u8_slice_list) == false, 8005)
    assert_eq(u8_slice_list[0], 66, 8006)
    assert_eq(u8_slice_list[2], 68, 8007)
    var u8_slice_buf = bufferm.slice_to_u8_buf(u8_slice)
    assert_true(oren_is_err(u8_slice_buf) == false, 7989)
    assert_streq(bufferm.u8_to_string(u8_slice_buf), "BCD", 7990)
    assert_true(oren_is_err(bufferm.slice_copy_from_bytes(u8_slice, bytesm.from_string("xyz"))) == false, 7976)
    assert_streq(bufferm.u8_to_string(u8_view_buf), "AxyzE", 7977)
    var u8_view_buf_slice = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_view_buf_slice) == false, 8704)
    var u8_slice_bytes = bufferm.slice_new(u8_view_buf_slice, 1, 3)
    assert_true(oren_is_err(u8_slice_bytes) == false, 8705)
    assert_true(oren_is_err(bufferm.slice_copy_from_bytes_slice(u8_slice_bytes, bytesm.from_string("vwxyz"), 1, 3)) == false, 8706)
    assert_streq(bufferm.u8_to_string(u8_view_buf_slice), "AwxyE", 8707)
    var u8_from_string_slice = bufferm.u8_from_string_slice("hello", 1, 3)
    assert_true(oren_is_err(u8_from_string_slice) == false, 8734)
    assert_streq(bufferm.u8_to_string(u8_from_string_slice), "ell", 8735)
    var u8_view_buf2 = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_view_buf2) == false, 7991)
    var u8_slice2 = bufferm.slice_new(u8_view_buf2, 1, 3)
    assert_true(oren_is_err(u8_slice2) == false, 7992)
    assert_true(oren_is_err(bufferm.slice_copy_from_string(u8_slice2, "mno")) == false, 7993)
    assert_streq(bufferm.u8_to_string(u8_view_buf2), "AmnoE", 7994)
    var u8_view_buf4 = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_view_buf4) == false, 8736)
    var u8_slice4 = bufferm.slice_new(u8_view_buf4, 1, 3)
    assert_true(oren_is_err(u8_slice4) == false, 8737)
    assert_true(oren_is_err(bufferm.slice_copy_from_string_slice(u8_slice4, "lmnop", 1, 3)) == false, 8738)
    assert_streq(bufferm.u8_to_string(u8_view_buf4), "AmnoE", 8739)
    var u8_view_buf3 = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_view_buf3) == false, 8008)
    var u8_slice3 = bufferm.slice_new(u8_view_buf3, 1, 3)
    assert_true(oren_is_err(u8_slice3) == false, 8009)
    assert_true(oren_is_err(bufferm.slice_copy_from_u8_buf(u8_slice3, bufferm.u8_from_string("pqr"))) == false, 8010)
    assert_streq(bufferm.u8_to_string(u8_view_buf3), "ApqrE", 8011)
    assert_true(oren_is_err(bufferm.slice_to_string("nope")), 7978)
    assert_true(oren_is_err(bufferm.slice_copy_from_bytes(u8_slice, bytesm.from_string("xy"))), 7979)
    assert_true(oren_is_err(bufferm.slice_copy_from_bytes_slice(u8_slice_bytes, bytesm.from_string("vw"), 0, 2)), 8708)
    assert_true(oren_is_err(bufferm.slice_unpack_u8("nope")), 8012)
    assert_true(oren_is_err(bufferm.slice_to_u8_buf("nope")), 7995)
    assert_true(oren_is_err(bufferm.slice_copy_from_string(u8_slice2, "xy")), 7996)
    assert_true(oren_is_err(bufferm.slice_copy_from_string_slice(u8_slice4, "xy", 0, 2)), 8740)
    assert_true(oren_is_err(bufferm.slice_copy_from_u8_buf(u8_slice3, bufferm.u8_from_string("xy"))), 8013)

    var stride = bufferm.strided_new(i32b, 0, 2, 1)
    assert_true(oren_is_err(stride) == false, 7904)
    assert_true(oren_is_err(bufferm.strided_new(i32b, 0, 2, 0)), 7905)
    assert_eq(bufferm.strided_len(stride), 2, 7906)
    assert_eq(bufferm.strided_load_i32(stride, 1), 9, 7907)
    var stride_store = bufferm.strided_store_i32(stride, 0, 11)
    assert_true(oren_is_err(stride_store) == false, 7908)
    assert_eq(stride_store, i32b, 7909)
    assert_eq(bufferm.strided_load_i32(stride, 0), 11, 7910)
    assert_true(oren_is_err(bufferm.strided_load_i32(stride, 2)), 7911)
    var u8_stride_buf = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_stride_buf) == false, 7980)
    var u8_stride = bufferm.strided_new(u8_stride_buf, 0, 3, 2)
    assert_true(oren_is_err(u8_stride) == false, 7981)
    assert_streq(bufferm.strided_to_string(u8_stride), "ACE", 7982)
    var u8_stride_bytes = bufferm.strided_to_bytes(u8_stride)
    assert_true(oren_is_err(u8_stride_bytes) == false, 7983)
    assert_streq(bytesm.to_string(u8_stride_bytes), "ACE", 7984)
    var u8_stride_list = bufferm.strided_unpack_u8(u8_stride)
    assert_true(oren_is_err(u8_stride_list) == false, 8014)
    assert_eq(u8_stride_list[0], 65, 8015)
    assert_eq(u8_stride_list[2], 69, 8016)
    var u8_stride_buf2 = bufferm.strided_to_u8_buf(u8_stride)
    assert_true(oren_is_err(u8_stride_buf2) == false, 7997)
    assert_streq(bufferm.u8_to_string(u8_stride_buf2), "ACE", 7998)
    assert_true(oren_is_err(bufferm.strided_copy_from_bytes(u8_stride, bytesm.from_string("xyz"))) == false, 7985)
    assert_streq(bufferm.u8_to_string(u8_stride_buf), "xByDz", 7986)
    var u8_stride_buf_slice = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_stride_buf_slice) == false, 8709)
    var u8_stride_bytes = bufferm.strided_new(u8_stride_buf_slice, 0, 3, 2)
    assert_true(oren_is_err(u8_stride_bytes) == false, 8710)
    assert_true(oren_is_err(bufferm.strided_copy_from_bytes_slice(u8_stride_bytes, bytesm.from_string("uvwxy"), 1, 3)) == false, 8711)
    assert_streq(bufferm.u8_to_string(u8_stride_buf_slice), "vBwDx", 8712)
    var u8_stride_buf3 = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_stride_buf3) == false, 7999)
    var u8_stride2 = bufferm.strided_new(u8_stride_buf3, 0, 3, 2)
    assert_true(oren_is_err(u8_stride2) == false, 8000)
    assert_true(oren_is_err(bufferm.strided_copy_from_string(u8_stride2, "uvw")) == false, 8001)
    assert_streq(bufferm.u8_to_string(u8_stride_buf3), "uBvDw", 8002)
    var u8_stride_buf5 = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_stride_buf5) == false, 8741)
    var u8_stride4 = bufferm.strided_new(u8_stride_buf5, 0, 3, 2)
    assert_true(oren_is_err(u8_stride4) == false, 8742)
    assert_true(oren_is_err(bufferm.strided_copy_from_string_slice(u8_stride4, "uvwxy", 1, 3)) == false, 8743)
    assert_streq(bufferm.u8_to_string(u8_stride_buf5), "vBwDx", 8744)
    var u8_stride_buf4 = bufferm.u8_from_string("ABCDE")
    assert_true(oren_is_err(u8_stride_buf4) == false, 8017)
    var u8_stride3 = bufferm.strided_new(u8_stride_buf4, 0, 3, 2)
    assert_true(oren_is_err(u8_stride3) == false, 8018)
    assert_true(oren_is_err(bufferm.strided_copy_from_u8_buf(u8_stride3, bufferm.u8_from_string("rst"))) == false, 8019)
    assert_streq(bufferm.u8_to_string(u8_stride_buf4), "rBsDt", 8020)
    assert_true(oren_is_err(bufferm.strided_to_string("nope")), 7987)
    assert_true(oren_is_err(bufferm.strided_copy_from_bytes(u8_stride, bytesm.from_string("xy"))), 7988)
    assert_true(oren_is_err(bufferm.strided_copy_from_bytes_slice(u8_stride_bytes, bytesm.from_string("uv"), 0, 2)), 8713)
    assert_true(oren_is_err(bufferm.strided_unpack_u8("nope")), 8021)
    assert_true(oren_is_err(bufferm.strided_to_u8_buf("nope")), 8003)
    assert_true(oren_is_err(bufferm.strided_copy_from_string(u8_stride2, "uv")), 8004)
    assert_true(oren_is_err(bufferm.strided_copy_from_string_slice(u8_stride4, "uv", 0, 2)), 8745)
    assert_true(oren_is_err(bufferm.strided_copy_from_u8_buf(u8_stride3, bufferm.u8_from_string("rs"))), 8022)

    var matb = bufferm.i32_new(4)
    assert_true(oren_is_err(matb) == false, 7912)
    assert_true(oren_is_err(bufferm.store_i32(matb, 0, 1)) == false, 7913)
    assert_true(oren_is_err(bufferm.store_i32(matb, 1, 2)) == false, 7914)
    assert_true(oren_is_err(bufferm.store_i32(matb, 2, 3)) == false, 7915)
    assert_true(oren_is_err(bufferm.store_i32(matb, 3, 4)) == false, 7916)
