    var r = oren_read_u8_buf("__qi_missing_file_should_not_exist__u8.bin")
    assert_true(oren_is_err(r), 74)
}

fn test_read_file_missing_returns_err() {
    trace("QI: test_read_file_missing_returns_err")
    var r = oren_read_file("__qi_missing_file_should_not_exist__s.txt")
    assert_true(oren_is_err(r), 75)
}

fn test_numeric_casts() {
    assert_eq(ints.u8(256 + 5), 5, 100)
    assert_eq(ints.u8(-1), 255, 101)
    assert_eq(ints.i8(255), -1, 102)
    assert_eq(ints.i8(128), -128, 103)
    assert_eq(ints.u16(65536 + 7), 7, 110)
    assert_eq(ints.u16(-1), 65535, 111)
    assert_eq(ints.i16(65535), -1, 112)
    assert_eq(ints.i16(32768), -32768, 113)
    assert_eq(ints.u32(4294967296 + 9), 9, 120)
    assert_eq(ints.u32(-1), 4294967295, 121)
    assert_eq(ints.i32(4294967295), -1, 122)
    assert_eq(ints.i32(2147483648), -2147483648, 123)
    assert_eq(u8(1.9), 1, 130)
    assert_eq(i32(-1.9), -1, 131)
    assert_eq(f64(1), 1.0, 132)
}

fn test_float_and_bytes() {
    var a = 1.5
    var b = 2.5
    assert_eq(a + b, 4.0, 200)
    assert_eq(b - a, 1.0, 201)
    assert_eq(a * 2.0, 3.0, 202)
    assert_eq(3.0 / a, 2.0, 203)

    var b32 = F32Box(16777217.0)
    assert_eq(b32.x, 16777216.0, 210)

    var hx = "00ff1020"
    var bb = oren_bytes_from_hex(hx)
    assert_true(oren_is_err(bb) == false, 220)
    assert_eq(oren_bytes_len(bb), 4, 221)
    assert_streq(oren_bytes_to_hex(bb), hx, 222)
    var sum = 0
    for x in bb { sum = sum + x }
    assert_eq(sum, 0 + 255 + 16 + 32, 223)

    var pkt = [69, 0, 0, 84, 192, 168, 0, 1, 8, 8, 8, 8]
    assert_eq(pack_view("PV_H", pkt, 0).v, 69, 230)
    assert_eq(pack_view("PV_H", pkt, 0).len, 84, 231)
    assert_eq(pack_view("PV_H", pkt, 0).src, 3232235521, 232)
    assert_eq(pack_view("PV_H", pkt, 0).dst, 134744072, 233)
}

fn test_json() {
    var jr = json.decode("{\"b\":2,\"a\":1,\"s\":\"x\\\\n\\\"y\"}")
    assert_eq(jr["ok"], 1, 300)
    var out = json.encode(jr["v"])
    assert_streq(out, "{\"a\":1,\"b\":2,\"s\":\"x\\\\n\\\"y\"}", 301)
}

fn test_ui_headless() {
    trace("QI: test_ui_headless")

    var b = ui_core.box("b", 2, 2)
    b["p"]["bg"] = "#ff0000ff"
    var t = ui_core.text("t", "hi", 2, 1)
    t["p"]["color"] = "#00ff00ff"
    var root = ui_core.column("root", [b, t])

    var opts = {"clear_color": "#00000000"}
    var cmds = ui_render.render(root, opts)
    assert_eq(oren_list_len(cmds), 3, 310)

    var w = 2
    var h = 3
    var vr = ui_cmds.validate(cmds, w, h, {"strict_bounds": 1})
    assert_true(vr == 0, 311)
    assert_true(oren_is_err(ui_cmds.validate(cmds, "x", h, {"strict_bounds": 1})), 323)
    var bad_bg = ui_raster.rasterize([], 1, 1, {"clear_color": "red"})
    assert_true(oren_is_err(bad_bg) == true, 324)
    assert_eq(oren_err_code(bad_bg), 4, 325)
    assert_streq(oren_err_msg(bad_bg), "rasterize: clear_color: color must be #RRGGBB or #RRGGBBAA", 326)

    var img = ui_raster.rasterize(cmds, w, h, {"strict_bounds": 1})
    assert_true(oren_is_err(img) == false, 312)

    var n = oren_buf_len(img)
    assert_true(oren_is_err(n) == false, 313)
    assert_eq(n, w * h * 4, 314)

    assert_eq(oren_buf_load_u8(img, 0), 255, 315)
    assert_eq(oren_buf_load_u8(img, 1), 0, 316)
    assert_eq(oren_buf_load_u8(img, 2), 0, 317)
    assert_eq(oren_buf_load_u8(img, 3), 255, 318)

    var idx_t0 = (2 * w + 0) * 4
    assert_eq(oren_buf_load_u8(img, idx_t0 + 0), 0, 319)
    assert_eq(oren_buf_load_u8(img, idx_t0 + 1), 255, 320)
    assert_eq(oren_buf_load_u8(img, idx_t0 + 2), 0, 321)
    assert_eq(oren_buf_load_u8(img, idx_t0 + 3), 255, 322)
}

fn test_spawn_join() {
    var h = spawn worker_sleep_short()
    var r0 = oren_join_timeout(h, 0)
    assert_eq(r0, 0 - 60, 400)
    var r1 = oren_join(h)
    assert_eq(r1, 55, 401)
}

fn test_select() {
    trace("QI: test_select")
    var c1 = oren_new_channel()
    var c2 = oren_new_channel()
    if c1 == 0 || c2 == 0 { fail(450) }

    trace("QI: select_recv")
    oren_chan_send(c2, 111)
    var sel = oren_select_recv([c1, c2])
    if sel == 0 { fail(451) }
    assert_eq(oren_list_len(sel), 2, 452)
    assert_eq(oren_list_get(sel, 0), 1, 453)
    assert_eq(oren_list_get(sel, 1), 111, 454)

    trace("QI: select send #1")
    var s1 = oren_select([[1, c1, 11], [1, c2, 22]])
    if s1 == 0 { fail(455) }
    assert_eq(oren_list_len(s1), 2, 456)
    assert_eq(oren_list_get(s1, 1), 1, 457)
    var idx1 = oren_list_get(s1, 0)
    if idx1 == 0 {
        assert_eq(oren_chan_recv(c1), 11, 458)
    } else {
        assert_eq(oren_chan_recv(c2), 22, 459)
    }

    trace("QI: select send #2")
    var s2 = oren_select([[1, c1, 33], [1, c2, 44]])
    if s2 == 0 { fail(460) }
    assert_eq(oren_list_len(s2), 2, 461)
    assert_eq(oren_list_get(s2, 1), 1, 462)
    var idx2 = oren_list_get(s2, 0)
    if idx2 == 0 {
        assert_eq(oren_chan_recv(c1), 33, 463)
    } else {
        assert_eq(oren_chan_recv(c2), 44, 464)
    }
    return 0
}
