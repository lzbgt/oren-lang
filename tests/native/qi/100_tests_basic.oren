fn test_boxed_list_dot_sum() {
    trace("QI: test_boxed_list_dot_sum")
    var n = 4096
    var xs = []
    var ys = []
    var i = 0
    while i < n {
        var v = (i * 3 + 7) % 1000
        var w = (i * 5 + 11) % 1000
        oren_list_push(xs, v)
        oren_list_push(ys, w)
        i = i + 1
    }

    var expected_sum = 0
    var expected_dot = 0
    i = 0
    while i < n {
        var v2 = (i * 3 + 7) % 1000
        var w2 = (i * 5 + 11) % 1000
        expected_sum = expected_sum + v2
        expected_dot = expected_dot + v2 * w2
        i = i + 1
    }

    var sum = 0
    i = 0
    while i < n {
        sum = sum + xs[i]
        i = i + 1
    }
    if sum != expected_sum {
        print("QI: boxed list sum mismatch got=" + oren_int_to_string(sum) +
            " expected=" + oren_int_to_string(expected_sum))
        fail(780)
    }

    var dot = 0
    i = 0
    while i < n {
        dot = dot + xs[i] * ys[i]
        i = i + 1
    }
    if dot != expected_dot {
        print("QI: boxed list dot mismatch got=" + oren_int_to_string(dot) +
            " expected=" + oren_int_to_string(expected_dot))
        fail(781)
    }

    var sum_commuted = 0
    i = 0
    while i < n {
        sum_commuted = xs[i] + sum_commuted
        i = i + 1
    }
    if sum_commuted != expected_sum {
        print("QI: boxed list commuted sum mismatch got=" + oren_int_to_string(sum_commuted) +
            " expected=" + oren_int_to_string(expected_sum))
        fail(782)
    }

    var dot_commuted = 0
    i = 0
    while i < n {
        dot_commuted = xs[i] * ys[i] + dot_commuted
        i = i + 1
    }
    if dot_commuted != expected_dot {
        print("QI: boxed list commuted dot mismatch got=" + oren_int_to_string(dot_commuted) +
            " expected=" + oren_int_to_string(expected_dot))
        fail(783)
    }

    var sum_temp = 0
    i = 0
    while i < n {
        var x = xs[i]
        sum_temp = x + sum_temp
        i = i + 1
    }
    if sum_temp != expected_sum {
        print("QI: boxed list temp sum mismatch got=" + oren_int_to_string(sum_temp) +
            " expected=" + oren_int_to_string(expected_sum))
        fail(784)
    }

    var dot_temp = 0
    i = 0
    while i < n {
        var p = xs[i] * ys[i]
        dot_temp = p + dot_temp
        i = i + 1
    }
    if dot_temp != expected_dot {
        print("QI: boxed list temp dot mismatch got=" + oren_int_to_string(dot_temp) +
            " expected=" + oren_int_to_string(expected_dot))
        fail(785)
    }
    return 0
}

fn test_string_literals_static() {
    trace("QI: test_string_literals_static")
    // GC correctness/perf: embedded string literals must NOT become GC-managed heap allocations.
    // They live in the binary's data segment and are recognized via the cstr0 literal pool.
    var before = native_mem_live_count()
    var before_roots = native_mem_roots_count()
    // Identical literals should be de-duplicated into the cstr0 pool (pointer identity stable).
    var p1 = "qi_static_lit"
    var p2 = "qi_static_lit"
    // Pointer identity compare (avoid string-aware `==`).
    assert_true((p1 - p2) == 0, 69)
    // Literal pointers are NOT tracked as GC alloc nodes.
    assert_true(oren_find_node(p1) == 0, 70)
    // But they must still be recognized as strings for printing/concat/map keys.
    assert_true(native_is_string_ptr(p1) != 0, 71)
    assert_true(native_cstr0_set_has(p1) != 0, 72)
    var after = native_mem_live_count()
    assert_eq(after, before, 73)
    var after_roots = native_mem_roots_count()
    assert_eq(after_roots, before_roots, 74)
}

fn test_type_tag_varargs() {
    trace("QI: test_type_tag_varargs")

    fn tags_of(...args) {
        var out = []
        for v in args { oren_list_push(out, oren_type_tag(v)) }
        return out
    }

    // std:reflect constants must match the runtime contract.
    assert_eq(reflect.TAG_NIL, 0, 970)
    assert_eq(reflect.TAG_INT, 1, 971)
    assert_eq(reflect.TAG_FLOAT, 2, 972)
    assert_eq(reflect.TAG_BOOL, 3, 973)
    assert_eq(reflect.TAG_STRING, 4, 974)
    assert_eq(reflect.TAG_FUNC, 8, 9741)
    assert_eq(reflect.TAG_LIST, 6, 975)
    assert_eq(reflect.TAG_MAP, 7, 976)
    assert_eq(reflect.TAG_I32_BUF, 10, 977)

    var v_nil = nil
    var v_bool = true
    var v_int = 123
    var v_float = 1.25
    var v_str = "x"
    var v_func = add
    var v_list = []
    var v_map = {"k": 1}
    var v_buf = oren_i32_buf_new(0)
    var v_struct = F32Box(1.0)

    var tags = tags_of(v_nil, v_bool, v_int, v_float, v_str, v_func, v_list, v_map, v_buf, v_struct)
    assert_eq(oren_list_len(tags), 10, 76)
    assert_eq(tags[0], 0, 77) // nil
    assert_eq(tags[1], 3, 771) // bool
    assert_eq(tags[2], 1, 78) // int
    // Note: native backend is still rolling toward full tagged values; float tag may be best-effort.
    assert_true(tags[3] == 1 || tags[3] == 2, 781) // float (int/float)
    assert_eq(tags[4], 4, 79) // string
    assert_eq(tags[5], 8, 791) // func
    assert_eq(tags[6], 6, 80) // list
    assert_eq(tags[7], 7, 81) // map
    assert_eq(tags[8], 10, 82) // i32_buf
    assert_eq(tags[9], 7, 89) // struct is map-shaped in rolling v0

    assert_streq(oren_type_name(v_nil), "nil", 83)
    assert_streq(oren_type_name(v_bool), "bool", 831)
    assert_streq(oren_type_name(v_int), "int", 84)
    var n_float = oren_type_name(v_float)
    assert_true(n_float == "int" || n_float == "float", 841)
    assert_streq(oren_type_name(v_str), "string", 85)
    assert_streq(oren_type_name(v_func), "func", 851)
    assert_streq(oren_type_name(v_list), "list", 86)
    assert_streq(oren_type_name(v_map), "map", 87)
    assert_streq(oren_type_name(v_buf), "i32_buf", 88)
    assert_streq(oren_type_name(v_struct), "F32Box", 90)

    // std:reflect wrappers must match the raw runtime helpers.
    assert_eq(reflect.tag(v_nil), 0, 978)
    assert_streq(reflect.name(v_struct), "F32Box", 979)
}

fn test_read_u8_buf_missing_returns_err() {
    trace("QI: test_read_u8_buf_missing_returns_err")
    // Tooling contract: FS helpers must return structured errors (not hard-exit) so compiler caches
    // can probe optional files and treat ENOENT as a normal miss.
    var r = oren_read_u8_buf("__qi_missing_file_should_not_exist__u8.bin")
    assert_true(oren_is_err(r), 74)
}

fn test_read_file_missing_returns_err() {
    trace("QI: test_read_file_missing_returns_err")
    // Tooling contract: `oren_read_file` must match the stage1 runtime behavior:
    // return an error map on failure (not exit), so optional cache probes don't abort the process.
    var r = oren_read_file("__qi_missing_file_should_not_exist__s.txt")
    assert_true(oren_is_err(r), 75)
}

fn test_numeric_casts() {
    // Unchecked casts (wrap/truncate).
    assert_eq(ints.u8(256 + 5), 5, 100)
    assert_eq(ints.u8(-1), 255, 101)
    assert_eq(ints.i8(255), -1, 102)
    assert_eq(ints.i8(128), -128, 103)

    assert_eq(ints.u16(65536 + 7), 7, 110)
    assert_eq(ints.u16(-1), 65535, 111)
    assert_eq(ints.i16(65535), -1, 112)
    assert_eq(ints.i16(32768), -32768, 113)

    assert_eq(ints.u32(4294967296 + 9), 9, 120)
    assert_eq(ints.u32(-1), 4294967295, 121)
    assert_eq(ints.i32(4294967295), -1, 122)
    assert_eq(ints.i32(2147483648), -2147483648, 123)

    // Cast sugar (compiler-lowered) must work without stdlib imports.
    assert_eq(u8(1.9), 1, 130)
    assert_eq(i32(-1.9), -1, 131)
    assert_eq(f64(1), 1.0, 132)
}

fn test_float_and_bytes() {
    var a = 1.5
    var b = 2.5
    assert_eq(a + b, 4.0, 200)
    assert_eq(b - a, 1.0, 201)
    assert_eq(a * 2.0, 3.0, 202)
    assert_eq(3.0 / a, 2.0, 203)

    // f32 rounding: 16777217 (2^24+1) is not representable in float32; it rounds to 16777216.
    var b32 = F32Box(16777217.0)
    assert_eq(b32.x, 16777216.0, 210)

    // bytes hex helpers + iteration.
    var hx = "00ff1020"
    var bb = oren_bytes_from_hex(hx)
    assert_true(oren_is_err(bb) == false, 220)
    assert_eq(oren_bytes_len(bb), 4, 221)
    assert_streq(oren_bytes_to_hex(bb), hx, 222)
    var sum = 0
    for x in bb { sum = sum + x }
    assert_eq(sum, 0 + 255 + 16 + 32, 223)

    // pack_view (network-order parsing story).
    var pkt = [69, 0, 0, 84, 192, 168, 0, 1, 8, 8, 8, 8]
    assert_eq(pack_view("PV_H", pkt, 0).v, 69, 230)
    assert_eq(pack_view("PV_H", pkt, 0).len, 84, 231)
    assert_eq(pack_view("PV_H", pkt, 0).src, 3232235521, 232)
    assert_eq(pack_view("PV_H", pkt, 0).dst, 134744072, 233)
}

fn test_json() {
    // JSON encode should be stable with deterministic map ordering.
    var jr = json.decode("{\"b\":2,\"a\":1,\"s\":\"x\\\\n\\\"y\"}")
    assert_eq(jr["ok"], 1, 300)
    var out = json.encode(jr["v"])
    assert_streq(out, "{\"a\":1,\"b\":2,\"s\":\"x\\\\n\\\"y\"}", 301)
}

fn test_ui_headless() {
    // Headless UI core (portable, deterministic):
    // - tree -> layout -> render command buffer -> raster RGBA bytes
    //
    // This intentionally avoids any OS windowing. It should work on all native targets.
    trace("QI: test_ui_headless")

    var b = ui_core.box("b", 2, 2)
    b["p"]["bg"] = "#ff0000ff" // solid red
    var t = ui_core.text("t", "hi", 2, 1)
    t["p"]["color"] = "#00ff00ff" // solid green
    var root = ui_core.column("root", [b, t])

    var opts = {"clear_color": "#00000000"} // transparent black
    var cmds = ui_render.render(root, opts)
    assert_eq(oren_list_len(cmds), 3, 310) // clear + fill_rect + text marker

    // Layout result for this tree is 2x3; validate/rasterize in strict mode.
    var w = 2
    var h = 3
    var vr = ui_cmds.validate(cmds, w, h, {"strict_bounds": 1})
    assert_true(vr == 0, 311)
    assert_true(oren_is_err(ui_cmds.validate(cmds, "x", h, {"strict_bounds": 1})), 323)
    var bad_bg = ui_raster.rasterize([], 1, 1, {"clear_color": "red"})
    assert_true(oren_is_err(bad_bg) == true, 324)
    assert_eq(oren_err_code(bad_bg), 4, 325)
    assert_streq(oren_err_msg(bad_bg), "rasterize: clear_color: color must be #RRGGBB or #RRGGBBAA", 326)

    var img = ui_raster.rasterize(cmds, w, h, {"strict_bounds": 1})
    assert_true(oren_is_err(img) == false, 312)

    var n = oren_buf_len(img)
    assert_true(oren_is_err(n) == false, 313)
    assert_eq(n, w * h * 4, 314)

    // Pixel checks:
    // - box at (0,0) size 2x2 is red
    // - text at y=2 draws 1 green pixel per character at x=0..len-1
    assert_eq(oren_buf_load_u8(img, 0), 255, 315) // (0,0) R
    assert_eq(oren_buf_load_u8(img, 1), 0, 316)   // (0,0) G
    assert_eq(oren_buf_load_u8(img, 2), 0, 317)   // (0,0) B
    assert_eq(oren_buf_load_u8(img, 3), 255, 318) // (0,0) A

    var idx_t0 = (2 * w + 0) * 4
    assert_eq(oren_buf_load_u8(img, idx_t0 + 0), 0, 319)   // (0,2) R
    assert_eq(oren_buf_load_u8(img, idx_t0 + 1), 255, 320) // (0,2) G
    assert_eq(oren_buf_load_u8(img, idx_t0 + 2), 0, 321)   // (0,2) B
    assert_eq(oren_buf_load_u8(img, idx_t0 + 3), 255, 322) // (0,2) A
}

fn test_spawn_join() {
    // `timeout_ms == 0` is a non-blocking probe:
    // - if not finished, returns ETIMEDOUT but must NOT cancel/kill the spawned worker
    // - a later `oren_join` must still return the worker's value.
    var h = spawn worker_sleep_short()
    var r0 = oren_join_timeout(h, 0)
    assert_eq(r0, 0 - 60, 400) // ETIMEDOUT (BSD)
    var r1 = oren_join(h)
    assert_eq(r1, 55, 401)
}

fn test_select() {
    trace("QI: test_select")
    // Rolling: on Windows, select works over in-memory channels (not pipe fds).

    var c1 = oren_new_channel()
    var c2 = oren_new_channel()
    if c1 == 0 || c2 == 0 { fail(450) }

    // select-recv returns [idx, val] where idx is the chosen channel index.
    trace("QI: select_recv")
    oren_chan_send(c2, 111)
    var sel = oren_select_recv([c1, c2])
    if sel == 0 { fail(451) }
    assert_eq(oren_list_len(sel), 2, 452)
    assert_eq(oren_list_get(sel, 0), 1, 453)
    assert_eq(oren_list_get(sel, 1), 111, 454)

    // select-send returns [idx, 1] and the value must be readable from that channel.
    // Run twice to exercise the rolling fairness cursor update path (`g_select_cursor`).
    trace("QI: select send #1")
    var s1 = oren_select([[1, c1, 11], [1, c2, 22]])
    if s1 == 0 { fail(455) }
    assert_eq(oren_list_len(s1), 2, 456)
    assert_eq(oren_list_get(s1, 1), 1, 457)
    var idx1 = oren_list_get(s1, 0)
    if idx1 == 0 {
        assert_eq(oren_chan_recv(c1), 11, 458)
    } else {
        assert_eq(oren_chan_recv(c2), 22, 459)
    }

    trace("QI: select send #2")
    var s2 = oren_select([[1, c1, 33], [1, c2, 44]])
    if s2 == 0 { fail(460) }
    assert_eq(oren_list_len(s2), 2, 461)
    assert_eq(oren_list_get(s2, 1), 1, 462)
    var idx2 = oren_list_get(s2, 0)
    if idx2 == 0 {
        assert_eq(oren_chan_recv(c1), 33, 463)
    } else {
        assert_eq(oren_chan_recv(c2), 44, 464)
    }
    return 0
}

fn _qi_select_recv_one(ch) {
    // Run inside a green task: `oren_select` must not block the scheduler OS thread.
    var sel = oren_select_recv([ch])
    if sel == 0 { return 0 - 5 } // EIO-ish
    if oren_list_len(sel) != 2 { return 0 - 5 }
    return oren_list_get(sel, 1)
}

fn _qi_select_send_delayed(ch, v) {
    // Ensure the receiver enters select before we send (otherwise a blocking select would not deadlock).
    // Use green-space sleep so we do not block the OS thread.
    oren_green_sleep_ns(5000000) // 5ms
    oren_chan_send(ch, v)
    return 0
}

fn _qi_select_send_fairness_in_green(c1, c2) {
    // Run inside a green task: multi-case `oren_select` must preserve deterministic cursor behavior
    // without doing per-wake probe polling (netpoll v2 path).
    var s1 = oren_select([[1, c1, 11], [1, c2, 22]])
    if s1 == 0 { return 0 - 5 }
    if oren_list_len(s1) != 2 { return 0 - 5 }
    if oren_list_get(s1, 1) != 1 { return 0 - 5 }
    var idx1 = oren_list_get(s1, 0)
    if idx1 == 0 {
        if oren_chan_recv(c1) != 11 { return 0 - 5 }
    } else {
        if oren_chan_recv(c2) != 22 { return 0 - 5 }
    }

    var s2 = oren_select([[1, c1, 33], [1, c2, 44]])
    if s2 == 0 { return 0 - 5 }
    if oren_list_len(s2) != 2 { return 0 - 5 }
    if oren_list_get(s2, 1) != 1 { return 0 - 5 }
    var idx2 = oren_list_get(s2, 0)
    if idx2 == 0 {
        if oren_chan_recv(c1) != 33 { return 0 - 5 }
    } else {
        if oren_chan_recv(c2) != 44 { return 0 - 5 }
    }

    // Cursor should advance, so with both cases always writable, we should not pick the same index twice.
    if idx1 == idx2 { return 0 - 5 }
    return 0
}

fn test_select_in_green_workers() {
    trace("QI: test_select_in_green_workers")
    // Rolling:
    // - POSIX: in-green select over pipe channels uses netpoll v2.
    // - Windows: in-green select over mem-channels parks on the shared global seq word via `oren_wait_on_addr`
    //   (wake-driven; no polling), but it must still not block the scheduler OS thread.

    // Run under Stage N2 worker mode with a bounded join timeout so regressions cannot hang the suite:
    // - if `oren_select` blocks the worker OS thread, the sender will never run and join_timeout will return -60.
    var rcw = oren_green_start_workers(1)
    assert_eq(rcw, 0, 560)

    var c = oren_new_channel()
    if c == 0 { fail(561) }

    var recv_h = spawn _qi_select_recv_one(c)
    var send_h = spawn _qi_select_send_delayed(c, 777)

    var r = oren_join_timeout(recv_h, 200)
    assert_eq(r, 777, 562)
    // Best-effort cleanup: sender should be done quickly too.
    oren_join_timeout(send_h, 200)
    return 0
}

fn test_select_multi_case_in_green_workers() {
    trace("QI: test_select_multi_case_in_green_workers")

    var rcw = oren_green_start_workers(1)
    assert_eq(rcw, 0, 563)

    var c1 = oren_new_channel()
    var c2 = oren_new_channel()
    if c1 == 0 || c2 == 0 { fail(564) }

    var h = spawn _qi_select_send_fairness_in_green(c1, c2)
    var r = oren_join_timeout(h, 500)
    assert_eq(r, 0, 565)
    return 0
}

fn _qi_select_recv_block_forever(ch) {
    // Block in select forever (rolling: uses a long finite sleep internally).
    // Used to validate that the scheduler blocks in netpoll instead of spinning.
    var sel = oren_select_recv([ch])
    if sel == 0 { return 0 - 5 }
    if oren_list_len(sel) != 2 { return 0 - 5 }
    return oren_list_get(sel, 1)
}

fn test_select_idle_does_not_spin_cpu() {
    trace("QI: test_select_idle_does_not_spin_cpu")
    // Rolling:
    // - POSIX: select blocks in netpoll.
    // - Windows: mem-channel select parks the G and wakes explicitly (no 1ms polling loop).

    // Ensure worker mode is active and the scheduler can block in netpoll.
    var rcw = oren_green_start_workers(1)
    assert_eq(rcw, 0, 566)
    trace("QI: idle spin: workers started")

    // Reset idle counter (global debug page).
    oren_green_debug_reset()
    trace("QI: idle spin: debug reset")

    var c = oren_new_channel()
    if c == 0 { fail(567) }
    trace("QI: idle spin: channel created")

    // Spawn a receiver that blocks in select; do NOT send yet.
    var h = spawn _qi_select_recv_block_forever(c)
    trace("QI: idle spin: recv spawned h=" + oren_int_to_string(h))

    // Sleep on the host thread so the worker's scheduler loop is responsible for idling.
    // If the worker spins (polling with timeout=0), idle_iters will climb quickly.
    sys_nanosleep(200000000) // 200ms
    trace("QI: idle spin: host slept")

    var iters = oren_green_debug_idle_iters()
    trace("QI: idle spin: iters=" + oren_int_to_string(iters))
    // Heuristic bound (rolling): idle should block in kevent/epoll with a ~1s timeout clamp,
    // so we expect <= a handful of idle iterations over 200ms.
    assert_true(iters >= 0, 568)
    assert_true(iters <= 20, 569)
    trace("QI: idle spin: iters ok")
    trace("QI: idle spin: pre-send h=" + oren_int_to_string(h))

    // Wake and join to avoid leaking a blocked green task in the test suite.
    oren_chan_send(c, 999)
    trace("QI: idle spin: sent h=" + oren_int_to_string(h))
    var r = oren_join_timeout(h, 500)
    assert_eq(r, 999, 570)
    trace("QI: idle spin: joined")
    return 0
}

fn test_arena_list_smoke() {
    trace("QI: test_arena_list_smoke")
    oren_arena_push()
    var xs = oren_arena_new_list(8)
    if xs == 0 { fail(4100) }
    oren_list_push(xs, 1)
    oren_list_push(xs, 2)
    assert_eq(oren_list_len(xs), 2, 4101)
    var ys = oren_arena_new_list_int(8)
    if ys == 0 { fail(4102) }
    oren_list_int_push(ys, 10)
    oren_list_int_push(ys, 20)
    assert_eq(oren_list_int_len(ys), 2, 4103)
    oren_arena_pop()

    // Ensure arena can be reused after reset.
    oren_arena_push()
    var zs = oren_arena_new_list(4)
    if zs == 0 { fail(4104) }
    oren_list_push(zs, 7)
    assert_eq(oren_list_len(zs), 1, 4105)
    oren_arena_pop()
    return 0
}

fn test_arena_loop_attrs() {
    trace("QI: test_arena_loop_attrs")
    var sum = 0
    var i = 0
    @oren.arena
    while i < 3 {
        var xs = [i, i + 1]
        sum = sum + xs[0]
        i = i + 1
    }
    assert_true(sum >= 3, 4110)

    var ys = []
    i = 0
    @oren.noarena
    while i < 2 {
        oren_list_push(ys, i)
        i = i + 1
    }
    assert_eq(oren_list_len(ys), 2, 4111)
    return 0
}
