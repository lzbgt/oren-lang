    assert_true(oren_is_err(bufferm.try_f32_mat_copy_from_rows(packed_f32_mat, [[1.5], [2.5]])), 8192)
    assert_true(oren_is_err(bufferm.try_f32_mat_copy_from_flat(packed_f32_mat, [1.5, 2.5, 3.5])), 8226)
    assert_true(oren_is_err(bufferm.try_f32_mat_to_f32_buf("nope")), 8341)
    assert_true(oren_is_err(bufferm.try_f32_mat_copy_from_f32_buf(packed_f32_mat, bufferm.f32_new(3))), 8342)
    assert_true(oren_is_err(bufferm.try_f32_mat_copy_from_f32_buf(packed_f32_mat, bufferm.try_u8_from_string("ABCD"))), 8343)
    assert_true(oren_is_err(bufferm.try_slice_to_f32_buf("nope")), 8457)
    assert_true(oren_is_err(bufferm.try_strided_copy_from_f32_buf(f32_col1_view, bufferm.try_u8_from_string("AB"))), 8458)
    assert_true(oren_is_err(bufferm.try_mat_row_copy_from_list_f32(packed_f32_mat, 0, [1.0])), 8289)

    var f64m = bufferm.f64_new(4)
    assert_true(oren_is_err(f64m) == false, 8038)
    assert_true(oren_is_err(bufferm.try_store_f64(f64m, 0, 1.5)) == false, 8039)
    assert_true(oren_is_err(bufferm.try_store_f64(f64m, 1, 2.5)) == false, 8040)
    assert_true(oren_is_err(bufferm.try_store_f64(f64m, 2, 3.5)) == false, 8041)
    assert_true(oren_is_err(bufferm.try_store_f64(f64m, 3, 4.5)) == false, 8042)
    var matf64 = bufferm.try_mat_view_new(f64m, 0, 2, 2, 2)
    assert_true(oren_is_err(matf64) == false, 8043)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(matf64, 1, 1)) == false, 8044)
    var matf64s = bufferm.try_mat_store_f64(matf64, 0, 0, 9.5)
    assert_true(oren_is_err(matf64s) == false, 8045)
    assert_eq(matf64s, f64m, 8046)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(matf64, 0, 0)) == false, 8047)
    var packed_f64_mat = bufferm.try_f64_mat_pack_rows([[1.5, 2.5], [3.5, 4.5]])
    assert_true(oren_is_err(packed_f64_mat) == false, 8193)
    var unpacked_f64_rows = bufferm.try_f64_mat_unpack_rows(packed_f64_mat)
    assert_true(oren_is_err(unpacked_f64_rows) == false, 8194)
    assert_eq(oren_list_len(unpacked_f64_rows), 2, 8195)
    assert_eq(oren_list_len(unpacked_f64_rows[0]), 2, 8196)
    assert_eq(oren_list_len(unpacked_f64_rows[1]), 2, 8197)
    assert_true(oren_is_err(bufferm.try_f64_mat_copy_from_rows(packed_f64_mat, [[9.5, 8.5], [7.5, 6.5]])) == false, 8203)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 0, 0)) == false, 8198)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 1, 1)) == false, 8199)
    var copied_f64_flat = bufferm.try_f64_mat_unpack_flat(packed_f64_mat)
    assert_true(oren_is_err(copied_f64_flat) == false, 8227)
    assert_eq(oren_list_len(copied_f64_flat), 4, 8228)
    assert_true(oren_is_err(bufferm.try_f64_mat_copy_from_flat(packed_f64_mat, [1.25, 2.25, 3.25, 4.25])) == false, 8230)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 0, 0)) == false, 8231)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 1, 1)) == false, 8232)
    var copied_f64_buf = bufferm.try_f64_mat_to_f64_buf(packed_f64_mat)
    assert_true(oren_is_err(copied_f64_buf) == false, 8344)
    assert_eq(bufferm.try_len(copied_f64_buf), 4, 8345)
    assert_true(oren_is_err(bufferm.try_load_f64(copied_f64_buf, 0)) == false, 8346)
    assert_true(oren_is_err(bufferm.try_load_f64(copied_f64_buf, 3)) == false, 8347)
    var src_f64_buf = bufferm.f64_new(4)
    assert_true(oren_is_err(src_f64_buf) == false, 8348)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_buf, 0, 10.25)) == false, 8349)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_buf, 1, 11.25)) == false, 8350)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_buf, 2, 12.25)) == false, 8351)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_buf, 3, 13.25)) == false, 8352)
    assert_true(oren_is_err(bufferm.try_f64_mat_copy_from_f64_buf(packed_f64_mat, src_f64_buf)) == false, 8353)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 0, 0)) == false, 8354)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 1, 1)) == false, 8355)
    var f64_row0 = bufferm.try_mat_row_unpack_f64(packed_f64_mat, 0)
    assert_true(oren_is_err(f64_row0) == false, 8290)
    assert_eq(oren_list_len(f64_row0), 2, 8291)
    var f64_row0_view = bufferm.try_mat_row_slice(packed_f64_mat, 0)
    assert_true(oren_is_err(f64_row0_view) == false, 8459)
    var f64_row0_buf_direct = bufferm.try_slice_to_f64_buf(f64_row0_view)
    assert_true(oren_is_err(f64_row0_buf_direct) == false, 8460)
    assert_eq(bufferm.try_len(f64_row0_buf_direct), 2, 8461)
    assert_true(oren_is_err(bufferm.try_load_f64(f64_row0_buf_direct, 0)) == false, 8462)
    assert_true(oren_is_err(bufferm.try_load_f64(f64_row0_buf_direct, 1)) == false, 8463)
    var src_f64_row_view_buf = bufferm.f64_new(2)
    assert_true(oren_is_err(src_f64_row_view_buf) == false, 8464)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_row_view_buf, 0, 14.25)) == false, 8465)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_row_view_buf, 1, 15.25)) == false, 8466)
    assert_true(oren_is_err(bufferm.try_slice_copy_from_f64_buf(f64_row0_view, src_f64_row_view_buf)) == false, 8467)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 0, 0)) == false, 8468)
    var f64_row0_mat_buf = bufferm.try_mat_row_to_f64_buf(packed_f64_mat, 0)
    assert_true(oren_is_err(f64_row0_mat_buf) == false, 8469)
    assert_eq(bufferm.try_len(f64_row0_mat_buf), 2, 8470)
    assert_true(oren_is_err(bufferm.try_mat_row_copy_from_list_f64(packed_f64_mat, 0, [5.25, 6.25])) == false, 8292)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 0, 0)) == false, 8293)
    var f64_col0 = bufferm.try_mat_col_unpack_f64(packed_f64_mat, 0)
    assert_true(oren_is_err(f64_col0) == false, 8294)
    assert_eq(oren_list_len(f64_col0), 2, 8295)
    var f64_col0_view = bufferm.try_mat_col_strided(packed_f64_mat, 0)
    assert_true(oren_is_err(f64_col0_view) == false, 8471)
    var f64_col0_buf_direct = bufferm.try_strided_to_f64_buf(f64_col0_view)
    assert_true(oren_is_err(f64_col0_buf_direct) == false, 8472)
    assert_eq(bufferm.try_len(f64_col0_buf_direct), 2, 8473)
    assert_true(oren_is_err(bufferm.try_load_f64(f64_col0_buf_direct, 0)) == false, 8474)
    assert_true(oren_is_err(bufferm.try_load_f64(f64_col0_buf_direct, 1)) == false, 8475)
    var src_f64_col_view_buf = bufferm.f64_new(2)
    assert_true(oren_is_err(src_f64_col_view_buf) == false, 8476)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_col_view_buf, 0, 16.25)) == false, 8477)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_col_view_buf, 1, 17.25)) == false, 8478)
    assert_true(oren_is_err(bufferm.try_strided_copy_from_f64_buf(f64_col0_view, src_f64_col_view_buf)) == false, 8479)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 1, 0)) == false, 8480)
    var f64_col0_mat_buf = bufferm.try_mat_col_to_f64_buf(packed_f64_mat, 0)
    assert_true(oren_is_err(f64_col0_mat_buf) == false, 8481)
    assert_eq(bufferm.try_len(f64_col0_mat_buf), 2, 8482)
    assert_true(oren_is_err(bufferm.try_mat_col_copy_from_list_f64(packed_f64_mat, 0, [7.25, 8.25])) == false, 8296)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 1, 0)) == false, 8297)
    var f64_diag = bufferm.try_mat_diag_unpack_f64(packed_f64_mat)
    assert_true(oren_is_err(f64_diag) == false, 8549)
    assert_eq(oren_list_len(f64_diag), 2, 8550)
    var f64_diag_buf = bufferm.try_mat_diag_to_f64_buf(packed_f64_mat)
    assert_true(oren_is_err(f64_diag_buf) == false, 8551)
    assert_eq(bufferm.try_len(f64_diag_buf), 2, 8552)
    assert_true(oren_is_err(bufferm.try_mat_diag_copy_from_list_f64(packed_f64_mat, [9.25, 10.25])) == false, 8553)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 0, 0)) == false, 8554)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 1, 1)) == false, 8555)
    var src_f64_diag_buf = bufferm.f64_new(2)
    assert_true(oren_is_err(src_f64_diag_buf) == false, 8556)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_diag_buf, 0, 11.25)) == false, 8557)
    assert_true(oren_is_err(bufferm.try_store_f64(src_f64_diag_buf, 1, 12.25)) == false, 8558)
    assert_true(oren_is_err(bufferm.try_mat_diag_copy_from_f64_buf(packed_f64_mat, src_f64_diag_buf)) == false, 8559)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 0, 0)) == false, 8560)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(packed_f64_mat, 1, 1)) == false, 8561)
    assert_true(oren_is_err(bufferm.try_mat_rows("nope")), 8048)
    assert_true(oren_is_err(bufferm.try_f64_mat_pack_rows([[1.5], [2.5, 3.5]])), 8200)
    assert_true(oren_is_err(bufferm.try_f64_mat_copy_from_rows(packed_f64_mat, [[1.5], [2.5]])), 8201)
    assert_true(oren_is_err(bufferm.try_f64_mat_copy_from_flat(packed_f64_mat, [1.5, 2.5, 3.5])), 8233)
    assert_true(oren_is_err(bufferm.try_f64_mat_to_f64_buf("nope")), 8356)
    assert_true(oren_is_err(bufferm.try_f64_mat_copy_from_f64_buf(packed_f64_mat, bufferm.f64_new(3))), 8357)
    assert_true(oren_is_err(bufferm.try_f64_mat_copy_from_f64_buf(packed_f64_mat, bufferm.try_u8_from_string("ABCD"))), 8358)
    assert_true(oren_is_err(bufferm.try_mat_col_copy_from_list_f64(packed_f64_mat, 0, [1.0])), 8298)
    assert_true(oren_is_err(bufferm.try_mat_load_f64(matf64, 2, 0)), 8049)

    return 0
}

@pack
struct PV_H {
    v: u8,
    t: u8,
    len: u16be,
    src: u32be,
    dst: u32be
}

struct F32Box {
    x: f32
}

fn test_core() {
    trace("QI: test_core begin")
    // Arithmetic / bool / bit ops.
    assert_eq(2 + 3, 5, 10)
    assert_true(true, 11)
    assert_true(!false, 12)
    assert_eq((1 | 2), 3, 13)
    assert_eq((255 & 7), 7, 131)
    assert_eq((10 & 255), 10, 132)
    assert_eq((5 ^ 1), 4, 14)
    assert_eq((1 << 5), 32, 15)
    assert_eq((32 >> 5), 1, 16)
    assert_eq(7 / 3, 2, 17)
    assert_eq(-7 / 3, -2, 18)
    assert_eq(7 / -3, -2, 19)
    assert_eq(-7 / -3, 2, 20)

    trace("QI: test_core yield")
    // Yield is a best-effort OS scheduling hint today (future: native greenlet scheduler).
    // It must be callable and bounded on all Tier‑1 platforms.
    var ynorm = oren_yield_stmt()
    if ynorm != nil { fail(136) }
    yield
    var yrc = oren_yield()
    if yrc != 0 {
        print("QI: oren_yield failed rc=" + oren_int_to_string(yrc))
        fail(137)
    }
    
    // Pointer byte stores/loads must work (critical for typed buffers, hashing, IO).
    var p0 = oren_ptr_alloc(16)
    if p0 == 0 { fail(133) }
    ptr_set_byte(p0 + 0, 123)
    ptr_set_byte(p0 + 1, 45)
    var w0 = ptr_get(p0)
    assert_eq(w0 & 255, 123, 134)
    assert_eq((w0 >> 8) & 255, 45, 135)
    oren_ptr_free(p0)

    // Multi-arg calling convention (native ABI) sanity.
    assert_eq(add3(1, 2, 3), 6, 136)

    // Type-strict equality parity (critical):
    // - `nil` must be distinct from numeric zero
    // - `false` must be distinct from numeric zero
    // - `nil` must be distinct from `false`
    //
    // NOTE (rolling):
    // The compiler rejects provably-scalar `== nil` comparisons as a correctness guardrail.
    // Exercise the equality behavior through unknown-typed values (map flows) so the test
    // still probes the native backend hazard surface until full tagged values land.
    var m0 = {"z": 0, "f": false, "n": nil}
    var z0 = m0["z"]
    var f0 = m0["f"]
    var n0 = m0["n"]

    if z0 == nil { fail(1001) }
    if nil == z0 { fail(1002) }
    if z0 == false { fail(1003) }
    if false == z0 { fail(1004) }
    if 0 == false { fail(1005) }
    if false == 0 { fail(1006) }
    if n0 == false { fail(1007) }
    if false == n0 { fail(1008) }
    if n0 != nil { fail(1009) }

    // Truthiness parity (docs/LANGUAGE.md):
    // - falsey: `nil`, `false`
    // - truthy: everything else (including int 0)
    if 0 { } else { fail(1010) }
    if nil { fail(1011) }
    if false { fail(1012) }
    if !0 { fail(1013) }
    if !nil { } else { fail(1014) }
    assert_true((0 && nil) == false, 1015)
    assert_true((0 || nil) == true, 1016)
    assert_true((nil || 0) == true, 1017)
    assert_true((nil && 0) == false, 1018)

    trace("QI: test_core string literal pooling")
    // Critical perf/correctness invariant (native backend):
    // - string literals are deduped into a single cstr0 pool
    // - literals are recognized as strings via `oren_init_static_cstr0_table`
    // - literals must NOT be tracked as GC heap allocations
    //
    // These checks are intentionally pointer-identity based (do not use `==` for strings).
    var lit0 = "qi_literal_pool_test"
    var lit1 = "qi_literal_pool_test"
    if (lit0 - lit1) != 0 { fail(3100) }
    assert_true(oren_is_string(lit0), 3101)
    if oren_find_node(lit0) != 0 { fail(3102) }

    trace("QI: test_core reflection func")
    // Reflection v0 (native backend):
    // `std:reflect.tag/name` must be able to discriminate first-class function values so varargs
    // and logging can safely dispatch.
    var fn0 = add
    assert_eq(reflect.tag(fn0), reflect.TAG_FUNC, 3110)
    assert_streq(reflect.name(fn0), "func", 3111)

    trace("QI: test_core lists")
    // Lists + for-in + break/continue.
    var xs = [1, 2, 3, 4]
    xs[1] = 20
    assert_eq(xs[1], 20, 30)
    var s = 0
    for x in xs {
        if x == 20 { continue }
        s = s + x
    }
    assert_eq(s, 1 + 3 + 4, 31)

    trace("QI: test_core iterable-map protocol")
    // Iterable map protocol safety + robustness (native backend):
    // - Runtime must not call strcmp on non-strings.
    // - Do not rely on literal pointer equality: a user can construct an equal string that
    //   is not the same pointer as the cstr0 literal.
    //
    // Regression: "__iter" set to a heap string "range" must behave like the stdlib protocol.
    var it = "ra" + "nge" // heap string, not necessarily pointer-equal to the literal "range"
    assert_true(oren_is_string(it), 3210)
    assert_streq(it, "range", 3211)
    var m_it = {"__iter": it, "start": 0, "end": 4, "step": 1}
    var ys = []
    for v in m_it { oren_list_push(ys, v) }
    assert_eq(oren_list_len(ys), 4, 3212)
    assert_eq(ys[0], 0, 3213)
    assert_eq(ys[1], 1, 3214)
    assert_eq(ys[2], 2, 3215)
    assert_eq(ys[3], 3, 3216)

    trace("QI: test_core empty list lowering int")
    var li = []
    oren_list_push(li, 1)
    oren_list_int_push(li, 2)
    assert_eq(oren_list_int_len(li), 2, 3220)
    assert_eq(oren_list_int_get(li, 0), 1, 3221)
    assert_eq(oren_list_int_get(li, 1), 2, 3222)

    trace("QI: test_core empty list stays boxed")
    var lb = []
    var m0 = {"k": 1}
    oren_list_push(lb, m0)
    assert_eq(oren_list_len(lb), 1, 3223)
    var m1 = oren_list_get(lb, 0)
    assert_eq(m1["k"], 1, 3224)

    trace("QI: test_core typed buffer views")
    // Typed-buffer view iteration (std/buffer protocol):
    // - slice view:   [buf, off, len]
    // - strided view: [buf, off, len, stride]
    //
    // `for x in view` must iterate underlying buffer values, not the metadata list.

    // Sanity: `oren_is_err` must treat integer 0 as "not an error".
    // Many runtime helpers return 0 on success (e.g. native_buf_check).
    var ie0 = oren_is_err(0)
    if ie0 {
        print("QI: BUG: oren_is_err(0) returned true")
        fail(3190)
    }
    var b = oren_i32_buf_new(6)
    if oren_is_err(b) {
        print("QI: oren_i32_buf_new failed")
        fail(3200)
    }
    var chk0 = native_buf_check(b, BUF_TAG_I32, 4)
    if chk0 != 0 {
        print("QI: BUG: native_buf_check(b) returned err=" + oren_int_to_string(chk0))
        fail(3191)
    }
    if oren_is_err(chk0) {
        print("QI: BUG: oren_is_err(native_buf_check_ok)=1")
        fail(3192)
    }
    var bi = 0
    while bi < 6 {
        var st = oren_buf_store_i32(b, bi, (bi + 1) * 10) // 10,20,30,40,50,60
        if oren_is_err(st) {
            print("QI: oren_buf_store_i32 failed idx=" + oren_int_to_string(bi))
            fail(3201)
        }
        if g_qi_trace_on != 0 && bi == 0 {
            print("QI: store_i32 ret=" + oren_int_to_string(st) + " buf=" + oren_int_to_string(b))
        }
        if st != b { fail(3204) }
        bi = bi + 1
    }
    // Sanity: typed-buffer stores/loads must work before testing the view iterator protocol.
    if g_qi_trace_on != 0 {
        var dp = oren_buf_data_ptr_unchecked(b)
        print("QI: buf hdr len=" + oren_int_to_string(ptr_get(b + 0)))
        print("QI: buf hdr elem_size=" + oren_int_to_string(ptr_get(b + 8)))
        print("QI: buf hdr magic=" + oren_int_to_string(ptr_get(b + 24)))
        print("QI: buf hdr tag=" + oren_int_to_string(ptr_get(b + 32)) + " BUF_TAG_I32=" + oren_int_to_string(BUF_TAG_I32))
        print("QI: buf hdr data=" + oren_int_to_string(ptr_get(b + 16)))
        print("QI: buf hdr data_ptr=" + oren_int_to_string(ptr_get(b + 40)))
        print("QI: buf payload ptr=" + oren_int_to_string(dp))
        if dp != 0 {
            fn dump4(off) {
                return oren_int_to_string(ptr_get_byte(dp + off + 0) & 255) + "," +
                    oren_int_to_string(ptr_get_byte(dp + off + 1) & 255) + "," +
                    oren_int_to_string(ptr_get_byte(dp + off + 2) & 255) + "," +
                    oren_int_to_string(ptr_get_byte(dp + off + 3) & 255)
            }
            print("QI: buf bytes @0..3   = " + dump4(0))
            print("QI: buf bytes @4..7   = " + dump4(4))
            print("QI: buf bytes @8..11  = " + dump4(8))
            print("QI: buf bytes @12..15 = " + dump4(12))
            print("QI: buf bytes @16..19 = " + dump4(16))
            print("QI: buf bytes @20..23 = " + dump4(20))
            print("QI: buf u64 @0  = " + oren_int_to_string(ptr_get(dp + 0)))
            print("QI: buf u64 @8  = " + oren_int_to_string(ptr_get(dp + 8)))
            print("QI: buf u64 @16 = " + oren_int_to_string(ptr_get(dp + 16)))
        }
    }
    var r2 = oren_buf_load_i32(b, 2)
    if oren_is_err(r2) { fail(3202) }
    assert_eq(r2, 30, 3203)
    var b_node = oren_find_node(ptr_get(b + 16))
    if b_node == 0 { fail(3205) }
    // Regression guard: typed-buffer heap payloads are raw tracked storage, not LIST_INT.
    if ptr_get(iadd(b_node, 16)) == list_int_kind() { fail(3206) }
    // Force a collection after additional list_int churn so GC must keep the buffer alive
    // without ever classifying the payload as a list_int header.
    var buf_keep = [b]
    var churn = []
    var ci = 0
    while ci < 128 {
        var li2 = oren_new_list_int(0)
        oren_list_int_push(li2, ci)
        oren_list_push(churn, li2)
        ci = ci + 1
    }
    oren_gc_collect()
    assert_eq(oren_buf_load_i32(oren_list_get(buf_keep, 0), 2), 30, 3207)
    var view = [b, 2, 3] // 30,40,50
    var s2 = 0
    for x2 in view { s2 = s2 + x2 }
    assert_eq(s2, 120, 32)
    var view2 = [b, 1, 3, 2] // 20,40,60
    var s3 = 0
    for x3 in view2 { s3 = s3 + x3 }
    assert_eq(s3, 120, 33)

    trace("QI: test_core maps")
    // Deterministic map iteration order (keys).
    var m = {"b": 1, "a": 2}
    var ks = []
    for k in m { oren_list_push(ks, k) }
    assert_eq(oren_list_len(ks), 2, 40)
    assert_streq(ks[0], "a", 41)
    assert_streq(ks[1], "b", 42)

    // Map lookup semantics:
    // - present key yields the stored value (even if it is numeric zero)
    // - missing key yields `nil`
    var m2 = {"x": 0}
    var v0 = m2["x"]
    assert_eq(v0, 0, 46)
    if v0 == nil { fail(1020) }
    assert_true(m2["missing"] == nil, 1021)

    trace("QI: test_core strings")
    // String operations (portable).
    var st = "a" + "b" + "c"
    assert_eq(oren_string_len(st), 3, 43)
    assert_streq(oren_string_char_at(st, 0), "a", 44)
    assert_streq(oren_string_char_at(st, 2), "c", 45)

    trace("QI: test_core function_values")
    // Function values + spread calls.
    var f = add
    assert_eq(f(10, 1), 11, 50)
    var xs3 = [2, 3]
    assert_eq(add3(1, xs3...), 6, 51)
    // Runtime function value (ensures native backends can synthesize `__oren_fnwrap_*` on-demand
    // for injected runtime functions too, not just user-defined functions).
    var glen = oren_list_len
    assert_eq(glen([1, 2, 3]), 3, 52)

    trace("QI: test_core recursion")
    // Recursion depth (moderate): sum 1..2000 = 2001000.
    assert_eq(sum_rec(2000), 2001000, 60)
    trace("QI: test_core end")
}

fn test_list_set_clear_stress() {
    trace("QI: test_list_set_clear_stress")
    var xs = []
    // Ensure list<int> header so list_set/list_int_set exercise unboxed paths.
    var li = oren_new_list_int(0)
    oren_list_int_push(li, 0)
    var i = 0
    while i < 64 {
        oren_list_set(xs, i, i)
        // list_set should route to list<int> fast path when the list is unboxed.
        oren_list_set(li, i, i)
        i = i + 1
    }
    assert_eq(oren_list_len(xs), 64, 3300)
    assert_eq(oren_list_int_len(li), 64, 3301)
    oren_gc_collect()
    i = 0
    while i < 64 {
        assert_eq(xs[i], i, 3302)
        assert_eq(oren_list_int_get(li, i), i, 3303)
        i = i + 1
    }
    oren_list_clear(xs)
    oren_list_int_clear(li)
    assert_eq(oren_list_len(xs), 0, 3304)
    assert_eq(oren_list_int_len(li), 0, 3305)

    // Exercise list<int> set growth after a clear.
    i = 0
    while i < 32 {
        oren_list_int_set(li, i, i + 1)
        i = i + 1
    }
    assert_eq(oren_list_int_len(li), 32, 3306)
    assert_eq(oren_list_int_get(li, 0), 1, 3307)
    assert_eq(oren_list_int_get(li, 31), 32, 3308)

    // Rolling ABI guard: list<int> payload slots are 8-byte unboxed integer values.
    assert_true(oren_is_list_int(li), 3309)
    assert_eq(oren_list_int_slot_stride_bytes(), 8, 3310)
    var data = oren_list_int_data_ptr(li)
    assert_true(data != 0, 3311)
    assert_eq(oren_list_int_data_ptr_unchecked(li), data, 3312)
    assert_eq(oren_list_int_data_ptr_unchecked(nil), 0, 3313)
    assert_eq(ptr_get(data + 0), 1, 3314)
    assert_eq(ptr_get(data + 8), 2, 3315)
    assert_eq(ptr_get(data + 16), 3, 3316)
    assert_eq(oren_list_int_reduce_sum_slots(li), 528, 3319)
    assert_eq(oren_list_int_reduce_sum_slots_unchecked(li), 528, 3320)
    assert_eq(oren_list_int_dot_slots(li, li), 11440, 3321)
    assert_eq(oren_list_int_dot_slots_unchecked(li, li), 11440, 3322)
    assert_eq(oren_list_int_reduce_sum_slots(nil), 0, 3323)
    assert_eq(oren_list_int_dot_slots(nil, nil), 0, 3324)
    assert_eq(oren_list_int_reduce_sum_slots_unchecked(nil), 0, 3330)
    assert_eq(oren_list_int_dot_slots_unchecked(nil, nil), 0, 3331)
    var li_short = oren_new_list_int(0)
    oren_list_int_push(li_short, 1)
    var raw_sum_bad = oren_list_int_reduce_sum_slots([1, "x"])
    assert_true(oren_is_err(raw_sum_bad), 3332)
    assert_eq(oren_err_code(raw_sum_bad), 4, 3333)
    var raw_dot_bad = oren_list_int_dot_slots(li, li_short)
    assert_true(oren_is_err(raw_dot_bad), 3334)
    assert_eq(oren_err_code(raw_dot_bad), 4, 3335)
    var raw_dot_nil = oren_list_int_dot_slots(li, nil)
    assert_true(oren_is_err(raw_dot_nil), 3336)
    assert_eq(oren_err_code(raw_dot_nil), 4, 3337)

    oren_list_int_set(li, 1, 44)
    assert_eq(ptr_get(data + 8), 44, 3317)
    assert_eq(oren_list_int_get(li, 1), 44, 3318)
    assert_eq(oren_list_int_reduce_sum_slots_unchecked(li), 570, 3325)
    assert_eq(oren_list_int_dot_slots_unchecked(li, li), 13372, 3326)

    var sum_commuted = 0
    i = 0
    while i < oren_list_int_len(li) {
        sum_commuted = oren_list_int_get(li, i) + sum_commuted
        i = i + 1
    }
    assert_eq(sum_commuted, 570, 3327)

    var dot_commuted = 0
    i = 0
    while i < oren_list_int_len(li) {
        dot_commuted = oren_list_int_get(li, i) * oren_list_int_get(li, i) + dot_commuted
        i = i + 1
    }
    assert_eq(dot_commuted, 13372, 3328)

    var sum_temp = 0
    i = 0
    while i < oren_list_int_len(li) {
        var x = oren_list_int_get(li, i)
        sum_temp = x + sum_temp
        i = i + 1
    }
    assert_eq(sum_temp, 570, 3329)

    var dot_temp = 0
    i = 0
    while i < oren_list_int_len(li) {
        var p = oren_list_int_get(li, i) * oren_list_int_get(li, i)
        dot_temp = p + dot_temp
        i = i + 1
    }
    assert_eq(dot_temp, 13372, 3330)
    oren_gc_collect()
    return 0
}

