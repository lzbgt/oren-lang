import http "std:net/http"
import udp "std:net/udp"

fn fill5(buf, a, b, c, d, e) {
    ptr_set_byte(buf + 0, a)
    ptr_set_byte(buf + 1, b)
    ptr_set_byte(buf + 2, c)
    ptr_set_byte(buf + 3, d)
    ptr_set_byte(buf + 4, e)
    return 0
}

fn eq5(buf, a, b, c, d, e) {
    if ptr_get_byte(buf + 0) != a { return 0 }
    if ptr_get_byte(buf + 1) != b { return 0 }
    if ptr_get_byte(buf + 2) != c { return 0 }
    if ptr_get_byte(buf + 3) != d { return 0 }
    if ptr_get_byte(buf + 4) != e { return 0 }
    return 1
}

fn u16be_at(p, off) {
    var hi = ptr_get_byte(p + off)
    var lo = ptr_get_byte(p + off + 1)
    return (hi << 8) | lo
}

fn ipv4_eq(p, off, a, b, c, d) {
    if ptr_get_byte(p + off + 0) != a { return 0 }
    if ptr_get_byte(p + off + 1) != b { return 0 }
    if ptr_get_byte(p + off + 2) != c { return 0 }
    if ptr_get_byte(p + off + 3) != d { return 0 }
    return 1
}

fn fail(code) {
    print("net suite: FAIL " + oren_int_to_string(code))
    exit(code)
}

fn test_tcp_loopback() {
    // Loopback-only TCP smoke test (no external network).
    // Single-process: listen, connect, accept, then exchange data with timeouts.
    // This keeps the suite OS-neutral (no dependency on fork/pipe semantics).

    var lfd = oren_tcp_listen_local(0) // port 0 => ephemeral
    if lfd < 0 { fail(600) }

    // Determine the port chosen by the OS via getsockname.
    var sa = malloc(32)
    if sa == 0 { fail(601) }
    var lenp = malloc(8)
    if lenp == 0 { fail(602) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(lfd, sa, lenp)
    if grc < 0 { fail(0 - grc) }
    var port = u16be_at(sa, 2)
    if port <= 0 { fail(603) }

    // Client connects first; accept picks up the queued connection.
    var cfd2 = oren_tcp_connect("127.0.0.1", port, 2000)
    if cfd2 < 0 { fail(0 - cfd2) }

    var cfd = oren_tcp_accept(lfd, 2000)
    if cfd < 0 { fail(604) }

    // Client -> server: "hello"
    var outb2 = malloc(5)
    if outb2 == 0 { fail(610) }
    fill5(outb2, 104, 101, 108, 108, 111) // "hello"
    var wn2 = oren_tcp_write_from(cfd2, outb2, 5, 2000)
    if wn2 != 5 { fail(611) }

    var inb = malloc(5)
    if inb == 0 { fail(612) }
    var rn = oren_tcp_read_into(cfd, inb, 5, 2000)
    if rn != 5 { fail(613) }
    if eq5(inb, 104, 101, 108, 108, 111) == 0 { fail(614) } // "hello"

    // Server -> client: "world"
    var outb = malloc(5)
    if outb == 0 { fail(615) }
    fill5(outb, 119, 111, 114, 108, 100) // "world"
    var wn = oren_tcp_write_from(cfd, outb, 5, 2000)
    if wn != 5 { fail(616) }

    var inb2 = malloc(5)
    if inb2 == 0 { fail(617) }
    var rn2 = oren_tcp_read_into(cfd2, inb2, 5, 2000)
    if rn2 != 5 { fail(618) }
    if eq5(inb2, 119, 111, 114, 108, 100) == 0 { fail(619) } // "world"

    oren_tcp_close(cfd2)
    oren_tcp_close(cfd)
    oren_tcp_close(lfd)
    return 0
}

fn test_tcp_send_recv_intrinsics() {
    // Validates syscall-first sys_send/sys_recv intrinsics.
    // Loopback-only, timeout-bounded (no hangs), single-process (no fork/pipe).

    var lfd = oren_tcp_listen_local(0)
    if lfd < 0 { fail(800) }

    var sa = malloc(32)
    if sa == 0 { fail(801) }
    var lenp = malloc(8)
    if lenp == 0 { fail(802) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(lfd, sa, lenp)
    if grc < 0 { fail(0 - grc) }
    var port = u16be_at(sa, 2)
    if port <= 0 { fail(803) }

    var cfd2 = oren_tcp_connect("127.0.0.1", port, 2000)
    if cfd2 < 0 { fail(0 - cfd2) }

    var cfd = oren_tcp_accept(lfd, 2000)
    if cfd < 0 { fail(804) }

    // Client -> server: sys_send + sys_recv path (wait-based readiness).
    var wn_ready2 = oren_fd_wait_writable(cfd2, 2000)
    if wn_ready2 <= 0 { fail(830) }
    var outb2 = malloc(5)
    if outb2 == 0 { fail(831) }
    fill5(outb2, 104, 101, 108, 108, 111) // "hello"
    var wn2 = sys_send(cfd2, outb2, 5, 0)
    if wn2 != 5 { fail(832) }

    var rn_ready = oren_fd_wait_readable(cfd, 2000)
    if rn_ready <= 0 { fail(833) }
    var inb = malloc(5)
    if inb == 0 { fail(834) }
    var rn = sys_recv(cfd, inb, 5, 0)
    if rn != 5 { fail(835) }
    if eq5(inb, 104, 101, 108, 108, 111) == 0 { fail(836) } // "hello"

    // Server -> client: response
    var wn_ready = oren_fd_wait_writable(cfd, 2000)
    if wn_ready <= 0 { fail(840) }
    var outb = malloc(5)
    if outb == 0 { fail(841) }
    fill5(outb, 119, 111, 114, 108, 100) // "world"
    var wn = sys_send(cfd, outb, 5, 0)
    if wn != 5 { fail(842) }

    var rn_ready2 = oren_fd_wait_readable(cfd2, 2000)
    if rn_ready2 <= 0 { fail(843) }
    var inb2 = malloc(5)
    if inb2 == 0 { fail(844) }
    var rn2 = sys_recv(cfd2, inb2, 5, 0)
    if rn2 != 5 { fail(845) }
    if eq5(inb2, 119, 111, 114, 108, 100) == 0 { fail(846) } // "world"

    oren_tcp_close(cfd2)
    oren_tcp_close(cfd)
    oren_tcp_close(lfd)
    return 0
}

fn test_tcp_sockname_peername() {
    // Validates syscall-first sockaddr introspection:
    // - sys_getpeername
    // - sys_getsockname
    //
    // Loopback-only and timeout-bounded (no external network).

    // Single-process: listen, connect, accept, then perform sockaddr introspection.
    var lfd = oren_tcp_listen_local(0)
    if lfd < 0 { fail(700) }

    var sa0 = malloc(32)
    if sa0 == 0 { fail(701) }
    var lenp0 = malloc(8)
    if lenp0 == 0 { fail(702) }
    ptr_set(lenp0, 32)
    var grc0 = sys_getsockname(lfd, sa0, lenp0)
    if grc0 < 0 { fail(0 - grc0) }
    var port2 = u16be_at(sa0, 2)
    if port2 <= 0 { fail(703) }

    var cfd2 = oren_tcp_connect("127.0.0.1", port2, 2000)
    if cfd2 < 0 { fail(0 - cfd2) }

    var cfd = oren_tcp_accept(lfd, 2000)
    if cfd < 0 { fail(704) }

    var peer_sa = malloc(16)
    if peer_sa == 0 { fail(720) }
    var peer_lenp = malloc(8)
    if peer_lenp == 0 { fail(721) }
    ptr_set(peer_lenp, 16)

    var prc = sys_getpeername(cfd2, peer_sa, peer_lenp)
    if prc < 0 { fail(0 - prc) }

    // sockaddr_in layout differs by OS:
    // - macOS/BSD: [0]=len, [1]=family (AF_INET)
    // - Linux:     [0]=family (u16 LE), [1]=0
    var fam1 = ptr_get_byte(peer_sa + 1)
    if fam1 != OREN_AF_INET {
        if ptr_get_byte(peer_sa + 0) != OREN_AF_INET { fail(722) } // AF_INET
    }
    var peer_port = u16be_at(peer_sa, 2)
    if peer_port != port2 { fail(723) }
    if ipv4_eq(peer_sa, 4, 127, 0, 0, 1) == 0 { fail(724) }

    var sock_sa = malloc(16)
    if sock_sa == 0 { fail(730) }
    var sock_lenp = malloc(8)
    if sock_lenp == 0 { fail(731) }
    ptr_set(sock_lenp, 16)

    var src = sys_getsockname(cfd2, sock_sa, sock_lenp)
    if src < 0 { fail(0 - src) }
    var fam2 = ptr_get_byte(sock_sa + 1)
    if fam2 != OREN_AF_INET {
        if ptr_get_byte(sock_sa + 0) != OREN_AF_INET { fail(732) } // AF_INET
    }
    if ipv4_eq(sock_sa, 4, 127, 0, 0, 1) == 0 { fail(733) }
    var local_port = u16be_at(sock_sa, 2)
    if local_port == 0 { fail(734) }

    // Nudge the server side so we know the socket is live.
    var one = malloc(1)
    if one == 0 { fail(740) }
    ptr_set_byte(one + 0, 88)
    var wn1 = oren_tcp_write_from(cfd2, one, 1, 2000)
    if wn1 != 1 { fail(741) }

    var inb = malloc(1)
    if inb == 0 { fail(742) }
    var rn = oren_tcp_read_into(cfd, inb, 1, 2000)
    if rn != 1 { fail(743) }

    oren_tcp_close(cfd2)
    oren_tcp_close(cfd)
    oren_tcp_close(lfd)
    return 0
}

fn test_http_helpers() {
    // HTTP stdlib sanity (no fork/threads required):
    // - URL parsing (host/port/path)
    // - request formatting (GET)
    //
    // Full loopback `http.get_text` should live in a separate suite once we have
    // a Tier‑1 cross‑OS concurrency primitive (thread/spawn) for Windows.

    var pu = http._parse_http_url("http://127.0.0.1:8080/abc")
    if pu["ok"] != 1 { fail(1001) }
    if strcmp(pu["host"], "127.0.0.1") != 0 { fail(1002) }
    if pu["port"] != 8080 { fail(1003) }
    if strcmp(pu["path"], "/abc") != 0 { fail(1004) }

    var pu2 = http._parse_http_url("http://127.0.0.1/")
    if pu2["ok"] != 1 { fail(1010) }
    if pu2["port"] != 80 { fail(1011) }
    if strcmp(pu2["path"], "/") != 0 { fail(1012) }

    var req = http._build_get_request("127.0.0.1", "/abc")
    if req == 0 { fail(1020) }
    if http._starts_with(req, "GET /abc HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n") == 0 { fail(1021) }
    free(req)
    return 0
}

fn test_tcp_timeouts() {
    // Ensure timeout-bounded operations return -ETIMEDOUT (-60) and do not hang.

    // accept timeout on an idle listener
    var port = 40010
    var lfd = oren_tcp_listen_local(port)
    if lfd < 0 { fail(900) }
    var afd = oren_tcp_accept(lfd, 10)
    if afd != 0 - 60 { fail(901) }
    oren_tcp_close(lfd)

    // read timeout on an established connection with no data (single-process)
    var lfd2 = oren_tcp_listen_local(0)
    if lfd2 < 0 { fail(910) }

    var sa = malloc(32)
    if sa == 0 { fail(911) }
    var lenp = malloc(8)
    if lenp == 0 { fail(912) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(lfd2, sa, lenp)
    if grc < 0 { fail(0 - grc) }
    var port2 = u16be_at(sa, 2)
    if port2 <= 0 { fail(913) }

    var cfd2 = oren_tcp_connect("127.0.0.1", port2, 2000)
    if cfd2 < 0 { fail(914) }
    var cfd = oren_tcp_accept(lfd2, 2000)
    if cfd < 0 { fail(915) }

    // Server observes no data within a short deadline.
    var one = malloc(1)
    if one == 0 { fail(916) }
    var rn = oren_tcp_read_into(cfd, one, 1, 20)
    if rn != 0 - 60 { fail(917) } // ETIMEDOUT

    oren_tcp_close(cfd)
    oren_tcp_close(cfd2)
    oren_tcp_close(lfd2)
    return 0
}

fn test_tcp_sockopt_keepalive() {
    // Validate portable socket option IDs for syscall-first net.
    // This should succeed on all Tier‑1 native targets (macOS/Linux/Windows).

    var lfd = oren_tcp_listen_local(0)
    if lfd < 0 { fail(950) }

    var sa = malloc(32)
    if sa == 0 { fail(951) }
    var lenp = malloc(8)
    if lenp == 0 { fail(952) }
    ptr_set(lenp, 32)
    var grc = sys_getsockname(lfd, sa, lenp)
    if grc < 0 { fail(0 - grc) }
    var port = u16be_at(sa, 2)
    free(sa)
    free(lenp)
    if port <= 0 { fail(953) }

    var cfd2 = oren_tcp_connect("127.0.0.1", port, 2000)
    if cfd2 < 0 { fail(0 - cfd2) }
    var cfd = oren_tcp_accept(lfd, 2000)
    if cfd < 0 { fail(954) }

    var one = malloc(8)
    if one == 0 { fail(955) }
    ptr_set(one, 1)
    var sroc = sys_setsockopt(cfd2, OREN_SOL_SOCKET, OREN_SO_KEEPALIVE, one, 4)
    free(one)
    if sroc < 0 { fail(0 - sroc) }

    // TCP_NODELAY is a TCP-level sockopt (level=IPPROTO_TCP).
    var one2 = malloc(8)
    if one2 == 0 { fail(956) }
    ptr_set(one2, 1)
    var nrc = sys_setsockopt(cfd2, OREN_IPPROTO_TCP, OREN_TCP_NODELAY, one2, 4)
    free(one2)
    if nrc < 0 { fail(0 - nrc) }

    oren_tcp_close(cfd)
    oren_tcp_close(cfd2)
    oren_tcp_close(lfd)
    return 0
}

fn test_udp_loopback() {
    // Loopback-only UDP smoke test (no external network).
    //
    // - Uses ephemeral port for the receiver to avoid fixed-port collisions.
    // - All operations are timeout-bounded (no hangs).

    var rfd = udp.bind_local(0)
    if rfd < 0 { fail(1100) }
    var rport = udp.sockname_port(rfd)
    if rport <= 0 { fail(1101) }

    var sfd = udp.bind_local(0)
    if sfd < 0 { fail(1102) }
    var sport = udp.sockname_port(sfd)
    if sport <= 0 { fail(1103) }

    var outb = malloc(4)
    if outb == 0 { fail(1104) }
    fill5(outb, 112, 105, 110, 103, 0) // "ping" + NUL (we only send 4 bytes)
    var wn = udp.send_to(sfd, "127.0.0.1", rport, outb, 4, 2000)
    if wn != 4 { fail(1105) }

    var inb = malloc(4)
    if inb == 0 { fail(1106) }

    // Also validate the source address from recvfrom.
    var sa = malloc(16)
    if sa == 0 { fail(1107) }
    var lenp = malloc(8)
    if lenp == 0 { fail(1108) }
    ptr_set(lenp, 16)

    var rn = udp.recv_from_into(rfd, inb, 4, 2000, sa, lenp)
    if rn != 4 { fail(1109) }
    if ptr_get_byte(inb + 0) != 112 { fail(1110) } // p
    if ptr_get_byte(inb + 1) != 105 { fail(1111) } // i
    if ptr_get_byte(inb + 2) != 110 { fail(1112) } // n
    if ptr_get_byte(inb + 3) != 103 { fail(1113) } // g

    // sockaddr_in layout differs by OS:
    // - macOS/BSD: [0]=len, [1]=family (AF_INET)
    // - Linux/Windows: [0]=family (u16 LE), [1]=0
    var fam = ptr_get_byte(sa + 1)
    if fam != OREN_AF_INET {
        if ptr_get_byte(sa + 0) != OREN_AF_INET { fail(1114) }
    }
    if ipv4_eq(sa, 4, 127, 0, 0, 1) == 0 { fail(1115) }
    if u16be_at(sa, 2) != sport { fail(1116) }

    free(sa)
    free(lenp)

    // Ensure timeouts are enforced on empty reads.
    var rn2 = udp.recv_into(rfd, inb, 4, 10)
    if rn2 != 0 - 60 { fail(1117) } // ETIMEDOUT

    udp.close(sfd)
    udp.close(rfd)
}

fn main() {
    test_tcp_loopback()
    test_tcp_sockname_peername()
    test_tcp_send_recv_intrinsics()
    test_tcp_timeouts()
    test_tcp_sockopt_keepalive()
    test_udp_loopback()
    test_http_helpers()
    print("net suite: OK")
    exit(0)
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
