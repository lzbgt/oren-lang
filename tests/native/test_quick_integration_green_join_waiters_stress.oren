// Focused in-process stress fixture for the first GC/STW join-waiter collector tails.
//
// This loops the two tests that first raise `expected=3` and `expected=4` parked-thread counts
// in the stage1 green-cache rerun logs, so a single process can exercise that region repeatedly.
//
// @include "qi/000_prelude.oren"
// @include "qi/200_tests_wait_gc.oren"

fn _qi_stress_iters() {
    var v = oren_env("OREN_QI_STRESS_ITERS")
    if v == nil || v == "" { return 4 }
    var n = oren_int_from_string(v)
    if n <= 0 { return 4 }
    if n > 1000 { return 1000 }
    return n
}

fn _qi_step(msg) {
    trace("QI: green join waiter stress " + msg)
}

fn _qi_stress_mode() {
    var v = oren_env("OREN_QI_STRESS_MODE")
    if v == nil || v == "" { return "both" }
    if strcmp(v, "green") == 0 { return "green" }
    if strcmp(v, "os") == 0 { return "os" }
    return "both"
}

fn main() {
    if oren_getenv("OREN_QI_TRACE") != 0 { g_qi_trace_on = 1 }
    // Keep the same worker-related prelude that the passing late-tail fixture uses before the
    // first `expected=3` / `expected=4` collector waits. This avoids depending on implicit
    // scheduler state from unrelated earlier quick-integration tests.
    _qi_step("prelude test_green_workers_join")
    test_green_workers_join()
    _qi_step("prelude test_green_worker_release_acquire_p_when_parked")
    test_green_worker_release_acquire_p_when_parked()
    _qi_step("prelude test_gc_collect_does_not_deadlock_with_green_worker_idle")
    test_gc_collect_does_not_deadlock_with_green_worker_idle()
    _qi_step("prelude test_gc_stw_os_thread_collect_scans_parked_stack")
    test_gc_stw_os_thread_collect_scans_parked_stack()
    _qi_step("prelude test_gc_stw_wakes_netpoll_blocked_threads")
    test_gc_stw_wakes_netpoll_blocked_threads()
    var iters = _qi_stress_iters()
    var mode = _qi_stress_mode()
    var i = 0
    while i < iters {
        if strcmp(mode, "os") != 0 {
            _qi_step("iter=" + oren_int_to_string(i + 1) +
                     "/" + oren_int_to_string(iters) +
                     " before test_gc_collect_does_not_deadlock_with_green_join_waiter")
            test_gc_collect_does_not_deadlock_with_green_join_waiter()
        }
        if strcmp(mode, "green") != 0 {
            _qi_step("iter=" + oren_int_to_string(i + 1) +
                     "/" + oren_int_to_string(iters) +
                     " before test_gc_collect_does_not_deadlock_with_os_thread_join_waiter")
            test_gc_collect_does_not_deadlock_with_os_thread_join_waiter()
        }
        _qi_step("iter=" + oren_int_to_string(i + 1) +
                 "/" + oren_int_to_string(iters) +
                 " done mode=" + mode)
        i = i + 1
    }
    print("ok: qi green join waiters stress")
    exit(0)
}

main()
