fn fill5(buf, a, b, c, d, e) {
    ptr_set_byte(buf + 0, a)
    ptr_set_byte(buf + 1, b)
    ptr_set_byte(buf + 2, c)
    ptr_set_byte(buf + 3, d)
    ptr_set_byte(buf + 4, e)
    return 0
}

fn eq5(buf, a, b, c, d, e) {
    if ptr_get_byte(buf + 0) != a { return 0 }
    if ptr_get_byte(buf + 1) != b { return 0 }
    if ptr_get_byte(buf + 2) != c { return 0 }
    if ptr_get_byte(buf + 3) != d { return 0 }
    if ptr_get_byte(buf + 4) != e { return 0 }
    return 1
}

fn main() {
    // Validates syscall-first sys_send/sys_recv intrinsics.
    // Loopback-only, timeout-bounded using kqueue/kevent (no hangs).
    //
    // IMPORTANT: This test intentionally calls sys_send/sys_recv directly
    // (not the higher-level oren_tcp_* wrappers) to lock down the ABI surface.

    var ch = oren_pipe()
    var r = oren_list_get(ch, 0)
    var w = oren_list_get(ch, 1)

    var pid = sys_fork()
    if pid < 0 { exit(800) }

    if pid == 0 {
        // Child: server
        sys_close(r)

        var port = 40002
        var lfd = oren_tcp_listen_local(port)
        if lfd < 0 { exit(801) }

        var pbuf = malloc(8)
        if pbuf == 0 { exit(802) }
        ptr_set(pbuf, port)
        var wn0 = sys_write(w, pbuf, 8)
        if wn0 != 8 { exit(803) }
        sys_close(w)

        var cfd = oren_tcp_accept(lfd, 2000)
        if cfd < 0 { exit(804) }

        // Wait readable then recv 5 bytes.
        var rn_ready = oren_tcp_wait_kqueue(cfd, -1, 2000)
        if rn_ready <= 0 { exit(805) }
        var inb = malloc(5)
        if inb == 0 { exit(806) }
        var rn = sys_recv(cfd, inb, 5, 0)
        if rn != 5 { exit(807) }
        if eq5(inb, 104, 101, 108, 108, 111) == 0 { exit(808) } // "hello"

        // Wait writable then send 5 bytes.
        var wn_ready = oren_tcp_wait_kqueue(cfd, -2, 2000)
        if wn_ready <= 0 { exit(809) }
        var outb = malloc(5)
        if outb == 0 { exit(810) }
        fill5(outb, 119, 111, 114, 108, 100) // "world"
        var wn = sys_send(cfd, outb, 5, 0)
        if wn != 5 { exit(811) }

        oren_tcp_close(cfd)
        oren_tcp_close(lfd)
        exit(0)
    }

    // Parent: client
    sys_close(w)
    var pbuf2 = malloc(8)
    if pbuf2 == 0 { exit(820) }
    var got = 0
    while got < 8 {
        var n = sys_read(r, pbuf2 + got, 8 - got)
        if n <= 0 { exit(821) }
        got = got + n
    }
    var port2 = ptr_get(pbuf2)
    if port2 < 1 { exit(822) }
    sys_close(r)

    var cfd2 = oren_tcp_connect("127.0.0.1", port2, 2000)
    if cfd2 < 0 { exit(0 - cfd2) }

    // Wait writable then send 5 bytes.
    var wn_ready2 = oren_tcp_wait_kqueue(cfd2, -2, 2000)
    if wn_ready2 <= 0 { exit(830) }
    var outb2 = malloc(5)
    if outb2 == 0 { exit(831) }
    fill5(outb2, 104, 101, 108, 108, 111) // "hello"
    var wn2 = sys_send(cfd2, outb2, 5, 0)
    if wn2 != 5 { exit(832) }

    // Wait readable then recv 5 bytes.
    var rn_ready2 = oren_tcp_wait_kqueue(cfd2, -1, 2000)
    if rn_ready2 <= 0 { exit(833) }
    var inb2 = malloc(5)
    if inb2 == 0 { exit(834) }
    var rn2 = sys_recv(cfd2, inb2, 5, 0)
    if rn2 != 5 { exit(835) }
    if eq5(inb2, 119, 111, 114, 108, 100) == 0 { exit(836) } // "world"

    oren_tcp_close(cfd2)

    var st = malloc(8)
    if st == 0 { exit(837) }
    ptr_set(st, 0)
    sys_wait4(pid, st, 0, 0)

    print("tcp send/recv: OK")
    exit(0)
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
