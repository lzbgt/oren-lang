fn main() {
    var xs = [10, 20, 30]
    var sum = 0
    for x in xs {
        sum = sum + x
    }
    if sum != 60 { exit(901) }

    // Nested for-in should not collide internal state vars.
    var cnt = 0
    for a in [1, 2] {
        for b in [3, 4, 5] {
            cnt = cnt + 1
        }
    }
    if cnt != 6 { exit(902) }

    print("for-in list OK")
}

// NOTE: `fn main()` is invoked automatically by the runtime entrypoint.
