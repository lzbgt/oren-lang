fn bump(box) {
    box[0] = box[0] + 1
    return 1
}

fn main() {
    // Literals and truthiness
    if !true { exit(1) }
    if false { exit(2) }
    if nil { exit(3) }

    // Prefix ops
    if !(!false) { exit(4) }
    if !true { exit(5) }

    // Bit ops
    if (~0) != -1 { exit(10) }
    if (1 & 3) != 1 { exit(11) }
    if (1 | 2) != 3 { exit(12) }
    if (5 ^ 1) != 4 { exit(13) }
    if (1 << 5) != 32 { exit(14) }
    if (32 >> 5) != 1 { exit(15) }

    // Short-circuit && / ||
    var box = [0]

    if false && bump(box) != 0 { exit(20) }
    if box[0] != 0 { exit(21) }

    if !(true || bump(box) != 0) { exit(22) }
    if box[0] != 0 { exit(23) }

    print("bool/bit ops OK")
    exit(0)
}
