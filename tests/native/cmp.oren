fn main() {
    var a = 10
    var b = 20
    var c = 10

    // Comparisons yield bool values (not 0/1 ints). Count trues explicitly.
    var total = 0
    if a < b { total = total + 1 }
    if a > b { total = total + 1 }
    if a == c { total = total + 1 }
    if a != b { total = total + 1 }
    if total == 3 { exit(0) } else { exit(1) }
}
