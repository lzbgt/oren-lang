fn counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn cancel_probe_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -910 }
    var seed = args[0]
    var resumed = yield seed in co
    if gen.is_cancel_requested(co) != true { return -911 }
    var reason = gen.cancel_reason(co)
    if oren_type_name(reason) != "int" { return -912 }
    return resumed + reason
}

fn capture_context_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -920 }
    var cells = args[0]
    var seed = args[1]
    cells[0] = co
    var resumed = yield seed in co
    return resumed + 1
}

fn _group_bad_map() {
