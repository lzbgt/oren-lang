import gen "std:generator"
import list "std:list"
import reflect "std:reflect"
import task "std:task"
import tg "std:task_group"
import time "std:time"

fn counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn quick_task(seed) {
    return seed + 100
}

fn slow_task(seed) {
    time.sleep_ms(30)
    return seed + 200
}

fn blocked_task(ch) {
    return oren_chan_recv(ch)
}

fn delayed_send_task(args) {
    var ch = args[0]
    var value = args[1]
    var delay_ms = args[2]
    if delay_ms > 0 { time.sleep_ms(delay_ms) }
    oren_chan_send(ch, value)
    return 0
}

fn stop_joined(result, expected) {
    if oren_type_name(result) != "map" { return false }
    if result["status"] != "joined" { return false }
    if result["result"] != expected { return false }
    return true
}

fn stop_detached(result, reason) {
    if oren_type_name(result) != "map" { return false }
    if result["status"] != "detached" { return false }
    if result["result"] != -60 { return false }
    if result["reason"] != reason { return false }
    return true
}

fn stop_joined_or_detached(result, expected_joined, reason) {
    if stop_detached(result, reason) == true { return true }
    if stop_joined(result, expected_joined) != true { return false }
    if result["reason"] != reason { return false }
    return true
}

fn run_task_group_task_surface_v0() {
    var policy0 = {"mode": "stop", "timeout_ms": 0, "grace_ms": 1, "reason": 401}
    var group0 = tg.new(policy0)
    if oren_is_err(group0) == true { return 191000 }
    policy0["reason"] = 999
    var copied0 = tg.default_policy(group0)
    if oren_is_err(copied0) == true || copied0["reason"] != 401 { return 191001 }

    var task0 = spawn quick_task(1)
    var task1 = spawn quick_task(2)
    if oren_is_err(tg.add(group0, task0)) == true { return 191002 }
    if oren_is_err(tg.extend(group0, [task1])) == true { return 191003 }
    if tg.count(group0) != 2 { return 191004 }
    var members0 = tg.members(group0)
    if oren_is_err(members0) == true || list.len(members0) != 2 { return 191005 }
    list.push(members0, task0)
    if tg.count(group0) != 2 { return 191006 }

    if oren_is_err(tg.stop_policy(group0, nil)) != true { return 191007 }
    if oren_is_err(tg.stop_policy_wait(group0, nil)) != true { return 191008 }
    if oren_is_err(tg.terminal_results(group0)) != true { return 191009 }

    var join0 = tg.join_all(group0, 2000)
    if oren_is_err(join0) == true || join0[0] != 101 || join0[1] != 102 { return 191010 }

    var mixed_gen = gen.start(counter_worker, [60])
    var mixed_task = spawn quick_task(3)
    var mixed_group = tg.from_list([mixed_gen, mixed_task], nil)
    if oren_is_err(mixed_group) == true { return 191011 }
    if oren_is_err(tg.join_all(mixed_group, 0)) != true { return 191012 }
    if task.join(mixed_task) != 103 { return 191013 }
    if gen.close(mixed_gen) != nil { return 191014 }

    if oren_is_err(tg.add(group0, 123)) != true { return 191015 }
    if oren_is_err(tg.extend(group0, [123])) != true { return 191016 }

    var rt_policy0 = {"mode": "stop", "timeout_ms": 25, "reason": 700}
    var rtg0 = tg.new_runtime_with_policy(rt_policy0)
    if oren_is_err(rtg0) == true { return 191017 }
    rt_policy0["reason"] = 999
    if tg.is_runtime_group(rtg0) != true { return 191018 }
    if tg.is_group(rtg0) != true { return 191019 }
    if reflect.is_task_group(rtg0) != true { return 191020 }
    if reflect.is_task_group(group0) != true { return 191021 }
    if tg.count(rtg0) != 0 { return 191022 }
    var rtm0 = tg.members(rtg0)
    if oren_is_err(rtm0) == true || list.len(rtm0) != 0 { return 191023 }
    var rtp0 = tg.default_policy(rtg0)
    if oren_is_err(rtp0) == true || rtp0["reason"] != 700 || rtp0["timeout_ms"] != 25 { return 191024 }
    rtp0["reason"] = 1234
    var rtp1 = tg.default_policy(rtg0)
    if oren_is_err(rtp1) == true || rtp1["reason"] != 700 { return 191025 }
    if oren_is_err(tg.set_default_policy(rtg0, {"mode": "stop", "timeout_ms": 30, "grace_ms": 1, "reason": 701})) == true { return 191026 }
    var rtp2 = tg.default_policy(rtg0)
    if oren_is_err(rtp2) == true || rtp2["reason"] != 701 || rtp2["timeout_ms"] != 30 || rtp2["grace_ms"] != 1 { return 191027 }
    if oren_type_name(tg.stop_policy(rtg0, nil)) != "list" { return 191028 }
    if oren_is_err(tg.spawn_call_list(group0, quick_task, [1])) != true { return 191029 }

    var rth0 = tg.spawn_call_list(rtg0, quick_task, [4])
    if task.is_handle(rth0) != true { return 191030 }
    var rth1 = spawn quick_task(5)
    if oren_is_err(tg.add(rtg0, rth1)) == true { return 191031 }
    if tg.count(rtg0) != 2 { return 191032 }
    var rtj0 = tg.join_all(rtg0, 2000)
    if oren_is_err(rtj0) == true || rtj0[0] != 104 || rtj0[1] != 105 { return 191033 }
    if tg.count(rtg0) != 0 { return 191034 }

    var rtg1 = tg.from_task_list([spawn quick_task(6), spawn quick_task(7)])
    if oren_is_err(rtg1) == true { return 191035 }
    if tg.is_runtime_group(rtg1) != true { return 191036 }
    var rtj1 = tg.join_all(rtg1, 2000)
    if oren_is_err(rtj1) == true || rtj1[0] != 106 || rtj1[1] != 107 { return 191037 }
    if tg.count(rtg1) != 0 { return 191038 }

    var rtg2 = tg.new_runtime()
    if oren_is_err(rtg2) == true { return 191039 }
    var rth2 = tg.spawn_call_list(rtg2, slow_task, [8])
    if task.is_handle(rth2) != true { return 191040 }
    if tg.detach_all(rtg2) != 1 { return 191041 }
    if tg.count(rtg2) != 0 { return 191042 }
    if oren_is_err(tg.add(rtg2, 123)) != true { return 191043 }

    var rtg3 = tg.new_runtime_with_policy({"timeout_ms": 20, "grace_ms": 0, "reason": 901})
    if oren_is_err(rtg3) == true { return 191044 }
    var rtj3 = tg.spawn_call_list(rtg3, quick_task, [9])
    if task.is_handle(rtj3) != true { return 191045 }
    var rtw3 = tg.stop_policy(rtg3, nil)
    if oren_is_err(rtw3) == true || list.len(rtw3) != 1 { return 191046 }
    if tg.count(rtg3) != 0 { return 191047 }
    var rtr3 = tg.join_watchers(rtw3, 2000)
    if oren_is_err(rtr3) == true || stop_joined(rtr3[0], 109) != true || rtr3[0]["reason"] != 901 { return 191048 }

    var rtg4 = tg.new_runtime()
    if oren_is_err(rtg4) == true { return 191049 }
    var ch4 = oren_new_channel()
    var sender4 = spawn delayed_send_task([ch4, 910, 50])
    var rts4 = tg.spawn_call_list(rtg4, blocked_task, [ch4])
    if task.is_handle(rts4) != true { return 191050 }
    if oren_is_err(tg.set_default_policy(rtg4, {"timeout_ms": 0, "grace_ms": 0, "reason": 902})) == true { return 191051 }
    var rtr4 = tg.stop_policy_wait(rtg4, nil)
    if oren_is_err(rtr4) == true || list.len(rtr4) != 1 { return 191052 }
    if stop_joined_or_detached(rtr4[0], 910, 902) != true { return 191053 }
    if task.join(sender4) != 0 { return 191054 }
    if tg.count(rtg4) != 0 { return 191055 }

    var dl5 = time.now_ns() + 50000000
    var rtg5 = tg.from_task_list_with_policy([spawn quick_task(11)], {"deadline_ns": dl5, "grace_ms": 0, "reason": 903})
    if oren_is_err(rtg5) == true { return 191056 }
    var rtr5 = tg.stop_policy_wait(rtg5, nil)
    if oren_is_err(rtr5) == true || list.len(rtr5) != 1 { return 191057 }
    if stop_joined(rtr5[0], 111) != true || rtr5[0]["reason"] != 903 { return 191058 }

    var rtg6 = tg.new_runtime()
    if oren_is_err(rtg6) == true { return 191059 }
    if task.is_handle(tg.spawn_call_list(rtg6, slow_task, [10])) != true { return 191060 }
    if oren_is_err(tg.stop_policy(rtg6, {"mode": "request_cancel"})) != true { return 191060 }
    if oren_is_err(tg.stop_policy_wait(rtg6, {"timeout_ms": 0, "deadline_ns": 0})) != true { return 191061 }
    if oren_is_err(tg.detach_all(rtg6)) == true { return 191062 }

    var rtg7 = tg.new_runtime_with_policy({"timeout_ms": 0, "grace_ms": 0, "reason": 904})
    if oren_is_err(rtg7) == true { return 191063 }
    var rts7 = tg.spawn_call_list(rtg7, slow_task, [12])
    if task.is_handle(rts7) != true { return 191064 }
    var rtr7 = tg.stop_policy_wait(rtg7, {"join_timeout_ms": 200})
    if oren_is_err(rtr7) == true || list.len(rtr7) != 1 { return 191065 }
    if stop_joined(rtr7[0], 212) != true || rtr7[0]["reason"] != 904 { return 191066 }
    if tg.count(rtg7) != 0 { return 191067 }

    var doneg0 = gen.start(counter_worker, [70])
    if oren_is_err(gen.next(doneg0)) == true { return 191068 }
    if oren_is_err(gen.send(doneg0, 4)) == true { return 191069 }
    var doneg0rv = gen.send(doneg0, 9)
    if oren_is_err(doneg0rv) == true || doneg0rv["done"] != true || doneg0rv["return"] != 14 { return 191070 }
    var rtg8 = tg.from_runtime_list([spawn quick_task(13), doneg0], {"mode": "stop", "timeout_ms": 0, "grace_ms": 0, "reason": 905})
    if oren_is_err(rtg8) == true || tg.count(rtg8) != 2 { return 191071 }
    var rtm8 = tg.members(rtg8)
    if oren_is_err(rtm8) == true || list.len(rtm8) != 2 { return 191072 }
    var rtr8 = tg.stop_policy_wait(rtg8, nil)
    if oren_is_err(rtr8) == true || list.len(rtr8) != 2 { return 191073 }
    if stop_joined_or_detached(rtr8[0], 113, 905) != true || rtr8[1] != 14 { return 191074 }
    if tg.count(rtg8) != 0 { return 191075 }

    var doneg1 = gen.start(counter_worker, [80])
    if oren_is_err(gen.next(doneg1)) == true { return 191076 }
    if oren_is_err(gen.send(doneg1, 5)) == true { return 191077 }
    var doneg1rv = gen.send(doneg1, 11)
    if oren_is_err(doneg1rv) == true || doneg1rv["done"] != true || doneg1rv["return"] != 16 { return 191078 }
    var rtg9 = tg.from_runtime_list([doneg1], nil)
    if oren_is_err(rtg9) == true { return 191079 }
    var terms9 = tg.terminal_results(rtg9)
    if oren_is_err(terms9) == true || list.len(terms9) != 1 || terms9[0] != 16 { return 191080 }

    return 0
}
