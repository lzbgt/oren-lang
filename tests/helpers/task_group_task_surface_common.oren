import gen "std:generator"
import list "std:list"
import reflect "std:reflect"
import task "std:task"
import tg "std:task_group"
import time "std:time"

fn counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn quick_task(seed) {
    return seed + 100
}

fn slow_task(seed) {
    time.sleep_ms(30)
    return seed + 200
}

fn run_task_group_task_surface_v0() {
    var policy0 = {"mode": "stop", "timeout_ms": 0, "grace_ms": 1, "reason": 401}
    var group0 = tg.new(policy0)
    if oren_is_err(group0) == true { return 191000 }
    policy0["reason"] = 999
    var copied0 = tg.default_policy(group0)
    if oren_is_err(copied0) == true || copied0["reason"] != 401 { return 191001 }

    var task0 = spawn quick_task(1)
    var task1 = spawn quick_task(2)
    if oren_is_err(tg.add(group0, task0)) == true { return 191002 }
    if oren_is_err(tg.extend(group0, [task1])) == true { return 191003 }
    if tg.count(group0) != 2 { return 191004 }
    var members0 = tg.members(group0)
    if oren_is_err(members0) == true || list.len(members0) != 2 { return 191005 }
    list.push(members0, task0)
    if tg.count(group0) != 2 { return 191006 }

    if oren_is_err(tg.stop_policy(group0, nil)) != true { return 191007 }
    if oren_is_err(tg.stop_policy_wait(group0, nil)) != true { return 191008 }
    if oren_is_err(tg.terminal_results(group0)) != true { return 191009 }

    var join0 = tg.join_all(group0, 2000)
    if oren_is_err(join0) == true || join0[0] != 101 || join0[1] != 102 { return 191010 }

    var mixed_gen = gen.start(counter_worker, [60])
    var mixed_task = spawn quick_task(3)
    var mixed_group = tg.from_list([mixed_gen, mixed_task], nil)
    if oren_is_err(mixed_group) == true { return 191011 }
    if oren_is_err(tg.join_all(mixed_group, 0)) != true { return 191012 }
    if task.join(mixed_task) != 103 { return 191013 }
    if gen.close(mixed_gen) != nil { return 191014 }

    if oren_is_err(tg.add(group0, 123)) != true { return 191015 }
    if oren_is_err(tg.extend(group0, [123])) != true { return 191016 }

    var rtg0 = tg.new_runtime()
    if oren_is_err(rtg0) == true { return 191017 }
    if tg.is_runtime_group(rtg0) != true { return 191018 }
    if tg.is_group(rtg0) != true { return 191019 }
    if reflect.is_task_group(rtg0) != true { return 191020 }
    if reflect.is_task_group(group0) != true { return 191021 }
    if tg.count(rtg0) != 0 { return 191022 }
    var rtm0 = tg.members(rtg0)
    if oren_is_err(rtm0) == true || list.len(rtm0) != 0 { return 191023 }
    if oren_is_err(tg.default_policy(rtg0)) != true { return 191024 }
    if oren_is_err(tg.stop_policy(rtg0, nil)) != true { return 191025 }
    if oren_is_err(tg.spawn_call_list(group0, quick_task, [1])) != true { return 191026 }

    var rth0 = tg.spawn_call_list(rtg0, quick_task, [4])
    if task.is_handle(rth0) != true { return 191027 }
    var rth1 = spawn quick_task(5)
    if oren_is_err(tg.add(rtg0, rth1)) == true { return 191028 }
    if tg.count(rtg0) != 2 { return 191029 }
    var rtj0 = tg.join_all(rtg0, 2000)
    if oren_is_err(rtj0) == true || rtj0[0] != 104 || rtj0[1] != 105 { return 191030 }
    if tg.count(rtg0) != 0 { return 191031 }

    var rtg1 = tg.from_task_list([spawn quick_task(6), spawn quick_task(7)])
    if oren_is_err(rtg1) == true { return 191032 }
    if tg.is_runtime_group(rtg1) != true { return 191033 }
    var rtj1 = tg.join_all(rtg1, 2000)
    if oren_is_err(rtj1) == true || rtj1[0] != 106 || rtj1[1] != 107 { return 191034 }
    if tg.count(rtg1) != 0 { return 191035 }

    var rtg2 = tg.new_runtime()
    if oren_is_err(rtg2) == true { return 191036 }
    var rth2 = tg.spawn_call_list(rtg2, slow_task, [8])
    if task.is_handle(rth2) != true { return 191037 }
    if tg.detach_all(rtg2) != 1 { return 191038 }
    if tg.count(rtg2) != 0 { return 191039 }
    if oren_is_err(tg.add(rtg2, mixed_gen)) != true { return 191040 }

    return 0
}
