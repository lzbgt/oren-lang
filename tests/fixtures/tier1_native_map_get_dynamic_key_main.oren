// Tier‑1 native parity: map get must work with a dynamic string key when the key kind is
// explicit (via annotation), and must use string content compare (not pointer equality).
//
// Native Tier‑1 does not infer key kinds at runtime. Dynamic keys must be annotated as
// `string` so codegen selects `oren_map_get_str`.
//
// Gated by `OREN_REMOTE_RUN=1` (Win11 + WSL2 x86_64). See: docs/REMOTE_X64_ENV.md

fn main() {
    var m = {}
    m["ab"] = 7

    // Build a distinct NUL-terminated "ab" at runtime (different pointer).
    var k = malloc_raw(3)
    ptr_set_byte(k, 97) // 'a'
    ptr_set_byte(iadd(k, 1), 98) // 'b'
    ptr_set_byte(iadd(k, 2), 0)
    oren_track_alloc(k, 3, 1) // 1=STRING

    // Dynamic-key lookup must succeed and use string compare (not pointer equality).
    if m[k] != 7 { return 1 }

    // Deterministic miss for an int key not present.
    var k0 = 0
    if m[k0] != 0 { return 2 }

    print("tier1 map get dynamic key ok")
    return 0
}

