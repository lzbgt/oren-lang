// Tier‑1 x86_64 native parity: map get must work with a dynamic string key even when the
// map was populated using a literal key.
//
// This validates:
// - the map entry stores key kind per-entry
// - lookup infers key kind using value metadata (tracked allocations for strings)
// - string equality path is taken when required (not just pointer equality)
//
// Gated by `OREN_REMOTE_RUN=1` (Win11 + WSL2 x86_64). See: docs/REMOTE_X64_ENV.md

fn main() {
    var m = {}
    m["ab"] = 7

    // Build a distinct NUL-terminated "ab" at runtime (different pointer).
    var k = malloc_raw(3)
    ptr_set_byte(k, 97) // 'a'
    ptr_set_byte(iadd(k, 1), 98) // 'b'
    ptr_set_byte(iadd(k, 2), 0)
    oren_track_alloc(k, 3, 1) // 1=STRING

    // Dynamic-key lookup must succeed and use string compare (not pointer equality).
    if m[k] != 7 { return 1 }

    // Nil key => miss (0), matches `oren_map_get` contract.
    var nil_key = 0
    if m[nil_key] != 0 { return 2 }

    print("tier1 map get dynamic key ok")
    return 0
}

