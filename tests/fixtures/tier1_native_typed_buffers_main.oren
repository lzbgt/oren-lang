fn main() {
    // Tier‑1 requirement: typed buffers are the HPC foundation and must work
    // identically on:
    // - Linux x86_64 SysV
    // - Windows x64
    //
    // This fixture intentionally exercises:
    // - alloc/new
    // - store/load
    // - float32 boundary via f32 bitcasts
    // - iteration over buffers (iterator contract)

    // --- i32 ---
    var bi = oren_i32_buf_new(4)
    if oren_buf_len(bi) != 4 { return 10 }
    oren_buf_store_i32(bi, 0, 7)
    oren_buf_store_i32(bi, 1, -3)
    oren_buf_store_i32(bi, 2, 123456)
    oren_buf_store_i32(bi, 3, -123456)
    if oren_buf_load_i32(bi, 0) != 7 { return 11 }
    if oren_buf_load_i32(bi, 1) != -3 { return 12 }
    if oren_buf_load_i32(bi, 2) != 123456 { return 13 }
    if oren_buf_load_i32(bi, 3) != -123456 { return 14 }

    // Iteration over typed buffers is implemented via `oren_iter_next` on other backends,
    // but Tier‑1 x64 native bring-up first gates the core buffer API (new/load/store/len).
    var sum = 0
    var i = 0
    while i < oren_buf_len(bi) {
        sum = sum + oren_buf_load_i32(bi, i)
        i = i + 1
    }
    if sum != 7 + (-3) + 123456 + (-123456) { return 15 }

    // --- u8 ---
    var bu = oren_u8_buf_new(3)
    oren_buf_store_u8(bu, 0, 0)
    oren_buf_store_u8(bu, 1, 255)
    oren_buf_store_u8(bu, 2, 128)
    if oren_buf_load_u8(bu, 0) != 0 { return 20 }
    if oren_buf_load_u8(bu, 1) != 255 { return 21 }
    if oren_buf_load_u8(bu, 2) != 128 { return 22 }

    // --- f32 ---
    var bf32 = oren_f32_buf_new(2)
    var v0 = 1.5
    var v1 = -2.25
    oren_buf_store_f32(bf32, 0, v0)
    oren_buf_store_f32(bf32, 1, v1)
    var r0 = oren_buf_load_f32(bf32, 0)
    var r1 = oren_buf_load_f32(bf32, 1)
    if oren_f32_to_u32_bits(r0) != 1069547520 { return 30 } // 0x3fc00000
    if oren_f32_to_u32_bits(r1) != 3222274048 { return 31 } // 0xc0100000

    // --- f64 ---
    var bf64 = oren_f64_buf_new(1)
    oren_buf_store_f64(bf64, 0, 1.0)
    var r64 = oren_buf_load_f64(bf64, 0)
    if oren_f64_to_u64_bits(r64) != 4607182418800017408 { return 40 } // 0x3ff0000000000000

    print("tier1 typed buffers ok")
    return 0
}
