fn main() {
    print("tier1 forin typed buffers ok")

    // Direct iteration over a typed buffer (BUF).
    var b = oren_i32_buf_new(6)
    var i = 0
    while i < 6 {
        oren_buf_store_i32(b, i, (i + 1) * 10)
        i = i + 1
    }
    var s = 0
    for x in b { s = s + x }
    if s != 210 { return 10 }

    // View iteration: [buf, off, len]
    var view = [b, 2, 3]
    var s2 = 0
    for x2 in view { s2 = s2 + x2 }
    if s2 != 120 { return 20 }

    // Strided view iteration: [buf, off, len, stride]
    var view2 = [b, 1, 3, 2]
    var s3 = 0
    var expect = [20, 40, 60]
    var j = 0
    for x3 in view2 {
        if j >= 3 { return 31 }
        if x3 != expect[j] { return 32 }
        s3 = s3 + x3
        j = j + 1
    }
    if j != 3 { return 33 }
    if s3 != 120 { return 30 }

    // U8 buffer iteration yields 0..255 ints.
    var bu = oren_u8_buf_new(3)
    oren_buf_store_u8(bu, 0, 65)
    oren_buf_store_u8(bu, 1, 66)
    oren_buf_store_u8(bu, 2, 67)
    var s4 = 0
    for ch in bu { s4 = s4 + ch }
    if s4 != 198 { return 40 }

    return 0
}
