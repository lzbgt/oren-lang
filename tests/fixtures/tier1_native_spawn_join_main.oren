// Tier‑1 x86_64 native: language-level `spawn` + `oren_join(_timeout)` must work on:
// - Linux x86_64 (green-task spawn by default; POSIX fork+pipe fallback when `OREN_NO_GREEN=1`)
// - Windows x64 (green-task spawn by default; OS-thread fallback when `OREN_NO_GREEN=1`)
//
// This fixture is executed only in the remote x64 gate (Win11 + WSL2) because the host
// dev machine may be arm64 and cannot run x86_64 native outputs locally.

fn worker_add(a, b) {
    return a + b
}

fn worker_sleep_long() {
    // Intentionally longer than the join timeout budget.
    oren_sleep_ms(5000)
    return 123
}

fn worker_ulock_signal(p) {
    // Give the main thread a moment to enter sys_ulock_wait in the common case.
    // This is intentionally best-effort (race-safe): sys_ulock_wait may return -EAGAIN if
    // the value changed before it started waiting.
    oren_sleep_ms(50)
    ptr_set(p, 2)
    sys_ulock_wake(257, p, 0)
    return 0
}

fn main() {
    // Spawn a lambda with capture-by-value.
    var base = 10
    var f = |y| base + y
    base = 999
    var h1 = spawn f(5)
    var r1 = oren_join(h1)
    if r1 != 15 { return 10 }

    // Spawn a named function (direct call lowered through callable ABI).
    var h2 = spawn worker_add(40, 2)
    var r2 = oren_join(h2)
    if r2 != 42 { return 11 }

    // Join timeout contract (rolling): should deterministically return -ETIMEDOUT (BSD 60).
    var h3 = spawn worker_sleep_long()
    var r3 = oren_join_timeout(h3, 20)
    if r3 != 0 - 60 { return 12 }

    // Runtime correctness: sys_ulock_wait/sys_ulock_wake must be a portable "wait-on-address"
    // primitive on Tier‑1 x64 targets (Windows+WSL2).
    //
    // This specifically guards the native runtime global lock implementation, which parks
    // after spinning.
    var p = malloc(8)
    if p == 0 { return 13 }
    ptr_set(p, 1)
    var h4 = spawn worker_ulock_signal(p)
    var r4 = sys_ulock_wait(1, p, 1, 0)
    if r4 != 0 && r4 != 0 - 11 { return 14 } // 11=EAGAIN
    var r4j = oren_join(h4)
    if r4j != 0 { return 15 }
    if ptr_get(p) != 2 { return 16 }

    print("tier1 spawn join ok")
    return 0
}
