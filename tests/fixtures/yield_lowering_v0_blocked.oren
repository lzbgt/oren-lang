fn blocked_multi_yield() {
    yield
    yield
    return 0
}

fn blocked_nested_literal() {
    var f = || 7
    yield
    return f()
}

fn blocked_non_top_level() {
    if true {
        yield
    }
    return 0
}

fn main() {
    var keep = [blocked_multi_yield, blocked_nested_literal, blocked_non_top_level]
    return oren_list_len(keep) - 3
}
