import nir "../../lib/compiler/native_ir_v0.oren"

fn fail(code, msg) {
    print("native_ir_validator_v0 FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(v, code, msg) {
    if v == true { return nil }
    fail(code, msg)
}

fn assert_false(v, code, msg) {
    if v == false { return nil }
    fail(code, msg)
}

fn valid_ir() {
    var ir = nir.module(nir.target("x64", "linux", "sysv"))
    ir["imports"] = ["oren_add"]
    ir["exports"] = ["main"]

    var roots = [nir.root("acc", "tagged")]
    var helper = nir.runtime_helper_call("oren_add", ["acc", "one"], "acc", ["rax", "rcx"], true, roots, "enter_exit")
    var ops = [
        nir.op_const("one", "int", "1"),
        nir.op_local_get("acc0", "acc"),
        nir.op_binary("cond0", "!=", "acc0", "one"),
        nir.op_call("call0", "helper_fn", ["acc0"], "direct"),
        nir.op_expr_result("call0"),
        helper
    ]
    var entry = nir.block("entry", ops, nir.term_branch("cond0", "ret", "slow"))
    var ret = nir.block("ret", [], nir.term_return("acc"))
    var slow = nir.block("slow", [], nir.term_panic("slow path"))
    var fn0 = nir.function("main", 0, 2, [entry, ret, slow])
    fn0["roots"] = roots
    fn0["helper_calls"] = [helper]
    oren_list_push(ir["functions"], fn0)
    return ir
}

fn assert_valid() {
    var res = nir.validate_module(valid_ir())
    assert_true(res["ok"], 10, "valid IR rejected")
    assert_true(oren_list_len(res["errors"]) == 0, 11, "valid IR returned errors")
}

fn assert_bad_abi() {
    var ir = valid_ir()
    ir["target"] = nir.target("x64", "windows", "sysv")
    var res = nir.validate_module(ir)
    assert_false(res["ok"], 20, "bad ABI accepted")
    assert_true(oren_list_len(res["errors"]) > 0, 21, "bad ABI missing error")
}

fn assert_missing_safepoint_roots() {
    var ir = valid_ir()
    var fn0 = ir["functions"][0]
    fn0["helper_calls"][0]["roots"] = nil
    fn0["blocks"][0]["ops"][5]["roots"] = nil
    var res = nir.validate_module(ir)
    assert_false(res["ok"], 30, "safepoint without roots accepted")
    assert_true(oren_list_len(res["errors"]) > 0, 31, "safepoint missing error")
}

fn assert_empty_safepoint_roots_allowed() {
    var ir = valid_ir()
    var fn0 = ir["functions"][0]
    fn0["helper_calls"][0]["roots"] = []
    fn0["blocks"][0]["ops"][5]["roots"] = []
    var res = nir.validate_module(ir)
    assert_true(res["ok"], 35, "explicit empty safepoint roots rejected")
}

fn assert_unknown_branch_target() {
    var ir = valid_ir()
    ir["functions"][0]["blocks"][0]["terminator"] = nir.term_branch("cond0", "ret", "missing")
    var res = nir.validate_module(ir)
    assert_false(res["ok"], 40, "unknown branch target accepted")
    assert_true(oren_list_len(res["errors"]) > 0, 41, "unknown target missing error")
}

fn assert_duplicate_function() {
    var ir = valid_ir()
    oren_list_push(ir["functions"], ir["functions"][0])
    var res = nir.validate_module(ir)
    assert_false(res["ok"], 50, "duplicate function accepted")
    assert_true(oren_list_len(res["errors"]) > 0, 51, "duplicate function missing error")
}

fn assert_bad_op_shape() {
    var ir = valid_ir()
    ir["functions"][0]["blocks"][0]["ops"][0] = nir.op_binary("bad", "+", "lhs", nil)
    var res = nir.validate_module(ir)
    assert_false(res["ok"], 60, "bad binary op accepted")
    assert_true(oren_list_len(res["errors"]) > 0, 61, "bad binary op missing error")
}

fn assert_bad_call_args() {
    var ir = valid_ir()
    ir["functions"][0]["blocks"][0]["ops"][3]["args"] = "not-list"
    var res = nir.validate_module(ir)
    assert_false(res["ok"], 70, "bad call args accepted")
    assert_true(oren_list_len(res["errors"]) > 0, 71, "bad call args missing error")
}

fn main() {
    if nir.schema_version() != "native_ir_v0" { fail(1, "schema version") }
    assert_valid()
    assert_bad_abi()
    assert_missing_safepoint_roots()
    assert_empty_safepoint_roots_allowed()
    assert_unknown_branch_target()
    assert_duplicate_function()
    assert_bad_op_shape()
    assert_bad_call_args()
    print("native_ir_validator_v0 OK")
    return 0
}
