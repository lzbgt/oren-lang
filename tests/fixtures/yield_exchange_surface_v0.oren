fn add1_exchange(x) {
    return x + 1
}

fn exchange_var(out_ch, in_ch, seed) {
    var resumed = oren_yield_exchange(out_ch, in_ch, seed + 1)
    return resumed + 10
}

fn exchange_return(out_ch, in_ch, seed) {
    return oren_yield_exchange(out_ch, in_ch, seed + 2)
}

fn exchange_call_arg(out_ch, in_ch, seed) {
    return add1_exchange(oren_yield_exchange(out_ch, in_ch, seed + 3))
}

fn exchange_stmt(out_ch, in_ch, seed) {
    oren_yield_exchange(out_ch, in_ch, seed + 4)
    return seed + 5
}

fn exchange_syntax_var(out_ch, in_ch, seed) {
    var resumed = yield (seed + 5) in (out_ch, in_ch)
    return resumed + 20
}

fn exchange_syntax_return(out_ch, in_ch, seed) {
    return yield (seed + 6) in (out_ch, in_ch)
}

fn exchange_syntax_call_arg(out_ch, in_ch, seed) {
    return add1_exchange(yield (seed + 7) in (out_ch, in_ch))
}

fn exchange_syntax_stmt(out_ch, in_ch, seed) {
    yield (seed + 8) in (out_ch, in_ch)
    return seed + 9
}

fn exchange_syntax_nil(out_ch, in_ch, seed) {
    var resumed = yield in (out_ch, in_ch)
    return resumed + seed
}

fn exchange_context_var(co, args) {
    if oren_type_name(co) != "generator_context" { return -3000 }
    var seed = args[0]
    var resumed = yield (seed + 9) in co
    return resumed + 16
}

fn exchange_context_return(co, args) {
    if oren_type_name(co) != "generator_context" { return -3010 }
    var seed = args[0]
    return yield (seed + 10) in co
}

fn exchange_context_call_arg(co, args) {
    if oren_type_name(co) != "generator_context" { return -3020 }
    var seed = args[0]
    return add1_exchange(yield (seed + 11) in co)
}

fn exchange_context_stmt(co, args) {
    if oren_type_name(co) != "generator_context" { return -3030 }
    var seed = args[0]
    yield (seed + 12) in co
    return seed + 13
}

fn exchange_context_nil(co, args) {
    if oren_type_name(co) != "generator_context" { return -3040 }
    var seed = args[0]
    var resumed = yield in co
    return resumed + seed
}

fn exchange_context_bad(seed) {
    return yield (seed + 99) in 123
}

fn exchange_host_green_reply_after_yield(out_ch, in_ch, delta) {
    var seen = oren_chan_recv(out_ch)
    oren_yield()
    oren_chan_send(in_ch, seen + delta)
    return delta
}

fn exchange_host_green_helper(seed, delta) {
    var out = oren_new_channel()
    var inp = oren_new_channel()
    var h = spawn exchange_host_green_reply_after_yield(out, inp, delta)
    var resumed = oren_yield_exchange(out, inp, seed)
    var joined = oren_join(h)
    if joined != delta { return -3100 }
    return resumed
}

fn exchange_host_green_syntax(seed, delta) {
    var out = oren_new_channel()
    var inp = oren_new_channel()
    var h = spawn exchange_host_green_reply_after_yield(out, inp, delta)
    var resumed = yield seed in (out, inp)
    var joined = oren_join(h)
    if joined != delta { return -3110 }
    return resumed
}

fn main() {
    var out1 = oren_new_channel()
    var in1 = oren_new_channel()
    var h1 = spawn exchange_var(out1, in1, 40)
    oren_yield()
    var y1 = oren_chan_recv(out1)
    if y1 != 41 { return 1000 + y1 }
    oren_chan_send(in1, 7)
    oren_yield()
    var r1 = oren_join(h1)
    if r1 != 17 { return 1100 + r1 }

    var out2 = oren_new_channel()
    var in2 = oren_new_channel()
    var h2 = spawn exchange_return(out2, in2, 50)
    oren_yield()
    var y2 = oren_chan_recv(out2)
    if y2 != 52 { return 1200 + y2 }
    oren_chan_send(in2, 8)
    oren_yield()
    var r2 = oren_join(h2)
    if r2 != 8 { return 1300 + r2 }

    var out3 = oren_new_channel()
    var in3 = oren_new_channel()
    var h3 = spawn exchange_call_arg(out3, in3, 60)
    oren_yield()
    var y3 = oren_chan_recv(out3)
    if y3 != 63 { return 1400 + y3 }
    oren_chan_send(in3, 9)
    oren_yield()
    var r3 = oren_join(h3)
    if r3 != 10 { return 1500 + r3 }

    var out4 = oren_new_channel()
    var in4 = oren_new_channel()
    var h4 = spawn exchange_stmt(out4, in4, 70)
    oren_yield()
    var y4 = oren_chan_recv(out4)
    if y4 != 74 { return 1600 + y4 }
    oren_chan_send(in4, 10)
    oren_yield()
    var r4 = oren_join(h4)
    if r4 != 75 { return 1700 + r4 }

    var out5 = oren_new_channel()
    var in5 = oren_new_channel()
    var h5 = spawn exchange_syntax_var(out5, in5, 80)
    oren_yield()
    var y5 = oren_chan_recv(out5)
    if y5 != 85 { return 1800 + y5 }
    oren_chan_send(in5, 11)
    oren_yield()
    var r5 = oren_join(h5)
    if r5 != 31 { return 1900 + r5 }

    var out6 = oren_new_channel()
    var in6 = oren_new_channel()
    var h6 = spawn exchange_syntax_return(out6, in6, 90)
    oren_yield()
    var y6 = oren_chan_recv(out6)
    if y6 != 96 { return 2000 + y6 }
    oren_chan_send(in6, 12)
    oren_yield()
    var r6 = oren_join(h6)
    if r6 != 12 { return 2100 + r6 }

    var out7 = oren_new_channel()
    var in7 = oren_new_channel()
    var h7 = spawn exchange_syntax_call_arg(out7, in7, 100)
    oren_yield()
    var y7 = oren_chan_recv(out7)
    if y7 != 107 { return 2200 + y7 }
    oren_chan_send(in7, 13)
    oren_yield()
    var r7 = oren_join(h7)
    if r7 != 14 { return 2300 + r7 }

    var out8 = oren_new_channel()
    var in8 = oren_new_channel()
    var h8 = spawn exchange_syntax_stmt(out8, in8, 110)
    oren_yield()
    var y8 = oren_chan_recv(out8)
    if y8 != 118 { return 2400 + y8 }
    oren_chan_send(in8, 14)
    oren_yield()
    var r8 = oren_join(h8)
    if r8 != 119 { return 2500 + r8 }

    var out9 = oren_new_channel()
    var in9 = oren_new_channel()
    var h9 = spawn exchange_syntax_nil(out9, in9, 120)
    oren_yield()
    var y9 = oren_chan_recv(out9)
    if y9 != nil { return 2600 }
    oren_chan_send(in9, 15)
    oren_yield()
    var r9 = oren_join(h9)
    if r9 != 135 { return 2700 + r9 }

    var g10 = oren_generator_start(exchange_context_var, [130])
    var c10 = oren_generator_next(g10)
    if oren_is_err(c10) == true { return 2800 }
    if c10["value"] != 139 { return 2801 }
    var c10r = oren_generator_send(g10, 16)
    if oren_is_err(c10r) == true { return 2802 }
    if c10r["return"] != 32 { return 2803 + c10r["return"] }

    var g11 = oren_generator_start(exchange_context_return, [140])
    var c11 = oren_generator_next(g11)
    if oren_is_err(c11) == true { return 2810 }
    if c11["value"] != 150 { return 2811 }
    var c11r = oren_generator_send(g11, 17)
    if oren_is_err(c11r) == true { return 2812 }
    if c11r["return"] != 17 { return 2813 + c11r["return"] }

    var g12 = oren_generator_start(exchange_context_call_arg, [150])
    var c12 = oren_generator_next(g12)
    if oren_is_err(c12) == true { return 2820 }
    if c12["value"] != 161 { return 2821 }
    var c12r = oren_generator_send(g12, 18)
    if oren_is_err(c12r) == true { return 2822 }
    if c12r["return"] != 19 { return 2823 + c12r["return"] }

    var g13 = oren_generator_start(exchange_context_stmt, [160])
    var c13 = oren_generator_next(g13)
    if oren_is_err(c13) == true { return 2830 }
    if c13["value"] != 172 { return 2831 }
    var c13r = oren_generator_send(g13, 19)
    if oren_is_err(c13r) == true { return 2832 }
    if c13r["return"] != 173 { return 2833 + c13r["return"] }

    var g14 = oren_generator_start(exchange_context_nil, [170])
    var c14 = oren_generator_next(g14)
    if oren_is_err(c14) == true { return 2840 }
    if c14["value"] != nil { return 2841 }
    var c14r = oren_generator_send(g14, 20)
    if oren_is_err(c14r) == true { return 2842 }
    if c14r["return"] != 190 { return 2843 + c14r["return"] }

    var bad_ctx = exchange_context_bad(200)
    if oren_is_err(bad_ctx) != true { return 2850 }

    var host0 = exchange_host_green_helper(210, 21)
    if host0 != 231 { return 2860 + host0 }

    var host1 = exchange_host_green_syntax(220, 22)
    if host1 != 242 { return 2870 + host1 }

    return 0
}
