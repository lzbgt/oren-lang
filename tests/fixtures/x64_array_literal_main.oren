// x64-native fixture (Tier-1 bring-up):
// - exercises list literal lowering: `[a, b, c]`
// - exercises list indexing `xs[i]` and index assignment `xs[i] = v`
//
// Intended to be executed in remote-run mode on Win11 + WSL2:
//   OREN_REMOTE_RUN=1 ./oretest --target macos

fn main() {
    var xs = [10, 11, 12, 13]

    if oren_list_len(xs) != 4 { return 1 }
    if xs[0] != 10 { return 2 }
    if xs[3] != 13 { return 3 }

    xs[2] = 99
    if xs[2] != 99 { return 4 }

    return 0
}

