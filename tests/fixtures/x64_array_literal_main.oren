// x64-native fixture (Tier-1 bring-up):
// - exercises list literal lowering: `[a, b, c]`
// - exercises list indexing `xs[i]` and index assignment `xs[i] = v`
//
// Run on real x86_64 hosts (Win11 + WSL2) via:
//   ./scripts/verify_native_matrix.sh --targets x64-win-tier1 --tier1-src tests/fixtures/x64_array_literal_main.oren
//   ./scripts/verify_native_matrix.sh --targets x64-wsl-tier1 --tier1-src tests/fixtures/x64_array_literal_main.oren

fn main() {
    var xs = [10, 11, 12, 13]

    if oren_list_len(xs) != 4 { return 1 }
    if xs[0] != 10 { return 2 }
    if xs[3] != 13 { return 3 }

    xs[2] = 99
    if xs[2] != 99 { return 4 }

    return 0
}
