import gen "std:generator"

fn inner_worker(co, args) {
    var box = args[0]
    var seed = args[1]
    var r0 = gen.on_close(co, || { oren_list_push(box, seed + 1); return nil })
    if oren_is_err(r0) == true { return -10 }
    var resumed = yield seed in co
    return resumed + seed + 20
}

@oren.generator
fn outer(box, seed) {
    var r0 = gen.on_close(|| { oren_list_push(box, seed + 2); return nil })
    if oren_is_err(r0) == true { return -11 }
    var inner = gen.start(inner_worker, [box, seed])
    return yield from inner
}

fn main() {
    var box = []
    var g = outer(box, 4)
    var s0 = gen.next(g)
    if oren_is_err(s0) == true { return 1 }
    if s0["value"] != 4 { return 2 }
    var closed = gen.close(g)
    if oren_is_err(closed) == true { return 3 }
    if oren_list_len(box) != 2 { return 4 }
    if box[0] != 5 { return 5 }
    if box[1] != 6 { return 6 }
    return 0
}
