// x86_64 native backend fixture (rolling bring-up):
// - exercises short-circuit `&&` / `||` (must not evaluate RHS when not needed)

fn hang() {
    // If this runs, the program hangs.
    while 1 { }
    return 0
}

fn main() {
    // Must not call hang()
    // Validate results while preserving short-circuit behavior:
    // - `false && <rhs>` must be false without evaluating <rhs>
    // - `true || <rhs>` must be true without evaluating <rhs>
    var c0 = false && hang() != 0
    if c0 != false { return 10 }
    var c1 = true || hang() != 0
    if c1 != true { return 11 }

    // Must evaluate RHS when needed
    var a = false || (1 < 2) // => 1
    var b = true && (2 < 1)  // => 0
    return a + b + 4
}
