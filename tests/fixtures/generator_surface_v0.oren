import gen "std:generator"
import reflect "../../lib/std/reflect.oren"

fn counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    if oren_type_tag(co) != reflect.TAG_GENERATOR_CONTEXT { return -901 }
    if reflect.is_generator_context(co) != true { return -902 }
    if reflect.is_list(co) == true { return -903 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn nil_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -910 }
    var seed = args[0]
    yield in co
    return seed + 7
}

fn collect_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -920 }
    var seed = args[0]
    var i = 0
    while i < 3 {
        yield (seed + i) in co
        i = i + 1
    }
    return seed + 30
}

fn cancel_probe_worker(co, args) {
