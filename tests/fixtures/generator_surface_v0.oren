    if oren_generator_cancel_reason(co) != nil { return -925 }
    var seed = args[0]
    var reason = args[1]
    var resumed = yield seed in co
    if gen.is_cancel_requested(co) != true { return -926 }
    if oren_generator_is_cancel_requested(co) != true { return -927 }
    if gen.cancel_reason(co) != reason { return -928 }
    if oren_generator_cancel_reason(co) != reason { return -929 }
    return resumed + reason
}

