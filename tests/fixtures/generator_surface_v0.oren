import gen "std:generator"

fn counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn nil_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -910 }
    var seed = args[0]
    yield in co
    return seed + 7
}

fn collect_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -920 }
    var seed = args[0]
    var i = 0
    while i < 3 {
        yield (seed + i) in co
        i = i + 1
    }
    return seed + 30
}

fn delegate_inner_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -930 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 50
}

fn delegate_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -931 }
    var inner = gen.start(delegate_inner_worker, [args[0]])
    var retv = gen.delegate(co, inner)
    return retv + 7
}

fn delegate_outer_direct_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -932 }
    var inner = oren_generator_start(delegate_inner_worker, [args[0]])
    var retv = oren_generator_delegate(co, inner)
    return retv + 9
}

fn delegate_collect_inner(co, args) {
    if oren_type_name(co) != "generator_context" { return -933 }
    var seed = args[0]
    var i = 0
    while i < 3 {
        yield (seed + i) in co
        i = i + 1
    }
    return seed + 30
}

fn delegate_collect_outer(co, args) {
    if oren_type_name(co) != "generator_context" { return -934 }
    var inner = gen.start(delegate_collect_inner, [args[0]])
    var retv = gen.delegate(co, inner)
    return retv + 11
}

fn exchange_bad_context(seed) {
    return yield (seed + 99) in 123
}

@oren.generator
fn decl_counter(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
fn decl_nil(seed) {
    yield
    return seed + 7
}

@oren.generator
fn decl_collect(seed) {
    var i = 0
    while i < 3 {
        yield (seed + i)
        i = i + 1
    }
    return seed + 30
}

@oren.generator
var decl_var_counter = fn(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
var decl_var_lambda = |seed| {
    var resumed = yield (seed + 2)
    return resumed + 9
}

fn main() {
    var c1 = oren_new_channel()
    var c2 = oren_new_channel()
    if c1 == 0 || c2 == 0 { return 80 }

    oren_chan_send(c2, 111)
    var sel = oren_select_recv([c1, c2])
    if sel == 0 { return 81 }
    if oren_list_len(sel) != 2 { return 82 }
    if sel[0] != 1 || sel[1] != 111 { return 83 }

    var raw1 = oren_select([[1, c1, 11], [1, c2, 22]])
    if raw1 == 0 { return 84 }
    if oren_list_len(raw1) != 2 || raw1[1] != 1 { return 85 }
    var raw_idx1 = raw1[0]
    if raw_idx1 == 0 {
        if oren_chan_recv(c1) != 11 { return 86 }
    } else {
        if oren_chan_recv(c2) != 22 { return 87 }
    }

    var raw2 = oren_select([[1, c1, 33], [1, c2, 44]])
    if raw2 == 0 { return 88 }
    if oren_list_len(raw2) != 2 || raw2[1] != 1 { return 89 }
    var raw_idx2 = raw2[0]
    if raw_idx2 == 0 {
        if oren_chan_recv(c1) != 33 { return 90 }
    } else {
        if oren_chan_recv(c2) != 44 { return 91 }
    }
    if raw_idx1 == raw_idx2 { return 92 }

    var g1 = gen.start(counter_worker, [40])
    if oren_type_name(g1) != "generator" { return 93 }
    var s0 = gen.next(g1)
    if oren_is_err(s0) == true { return 100 }
    if s0["ok"] != true || s0["done"] != false || s0["value"] != 41 { return 101 }
    var s1 = gen.send(g1, 2)
    if oren_is_err(s1) == true { return 102 }
    if s1["ok"] != true || s1["value"] != 42 { return 103 }
    var s2 = gen.send(g1, 7)
    if oren_is_err(s2) == true { return 104 }
    if s2["done"] != true || s2["return"] != 12 { return 105 }
    if gen.is_done(g1) != true || gen.return_value(g1) != 12 { return 106 }

    var g1b = oren_generator_start(counter_worker, [20])
    if oren_type_name(g1b) != "generator" { return 107 }
    var sb0 = oren_generator_next(g1b)
    if oren_is_err(sb0) == true { return 161 }
    if sb0["ok"] != true || sb0["value"] != 21 { return 162 }
    var sb1 = oren_generator_send(g1b, 2)
    if oren_is_err(sb1) == true { return 163 }
    if sb1["ok"] != true || sb1["value"] != 22 { return 164 }
    var sb2 = oren_generator_send(g1b, 7)
    if oren_is_err(sb2) == true { return 165 }
    if sb2["done"] != true || sb2["return"] != 12 { return 166 }
    if oren_generator_is_done(g1b) != true || oren_generator_return_value(g1b) != 12 { return 167 }
    var bad_ctx = exchange_bad_context(20)
    if oren_is_err(bad_ctx) != true { return 168 }
    var bad_next = oren_generator_next(123)
    if oren_is_err(bad_next) != true { return 169 }
    var bad_send = oren_generator_send(123, 1)
    if oren_is_err(bad_send) != true { return 170 }
    var bad_collect = oren_generator_collect(123)
    if oren_is_err(bad_collect) != true { return 171 }
    if oren_generator_is_done(123) != false { return 172 }
    if oren_generator_return_value(123) != nil { return 173 }

    var g2 = gen.start(nil_worker, [60])
    var n0 = gen.next(g2)
    if oren_is_err(n0) == true { return 110 }
    if n0["ok"] != true || n0["value"] != nil { return 111 }
    var n1 = gen.send(g2, 3)
    if oren_is_err(n1) == true { return 112 }
    if n1["done"] != true || n1["return"] != 67 { return 113 }

    var g3 = gen.start(counter_worker, [10])
    var bad = gen.send(g3, 99)
    if oren_is_err(bad) != true { return 120 }

    var g4 = gen.start(collect_worker, [5])
    var xs = gen.collect(g4)
    if oren_is_err(xs) == true { return 130 }
    if oren_list_len(xs) != 3 { return 131 }
    if xs[0] != 5 || xs[1] != 6 || xs[2] != 7 { return 132 }
    if gen.return_value(g4) != 35 { return 133 }

    var g4b = gen.start(collect_worker, [9])
    var ys = []
    for y in g4b { oren_list_push(ys, y) }
    if oren_list_len(ys) != 3 { return 134 }
    if ys[0] != 9 || ys[1] != 10 || ys[2] != 11 { return 135 }
    if gen.is_done(g4b) != true || gen.return_value(g4b) != 39 { return 136 }

    var g4c = gen.start(delegate_outer_worker, [30])
    var dg0 = gen.next(g4c)
    if oren_is_err(dg0) == true { return 1361 }
    if dg0["ok"] != true || dg0["value"] != 31 { return 1362 }
    var dg1 = gen.send(g4c, 2)
    if oren_is_err(dg1) == true { return 1363 }
    if dg1["ok"] != true || dg1["value"] != 32 { return 1364 }
    var dg2 = gen.send(g4c, 7)
    if oren_is_err(dg2) == true { return 1365 }
    if dg2["done"] != true || dg2["return"] != 64 { return 1366 }
    if gen.is_done(g4c) != true || gen.return_value(g4c) != 64 { return 1367 }

    var g4d = gen.start(delegate_outer_direct_worker, [40])
    var dd0 = gen.next(g4d)
    if oren_is_err(dd0) == true { return 1368 }
    if dd0["ok"] != true || dd0["value"] != 41 { return 1369 }
    var dd1 = gen.send(g4d, 3)
    if oren_is_err(dd1) == true { return 1370 }
    if dd1["ok"] != true || dd1["value"] != 43 { return 1371 }
    var dd2 = gen.send(g4d, 8)
    if oren_is_err(dd2) == true { return 1372 }
    if dd2["done"] != true || dd2["return"] != 67 { return 1373 }

    var g4e = gen.start(delegate_collect_outer, [5])
    var dxs2 = gen.collect(g4e)
    if oren_is_err(dxs2) == true { return 1374 }
    if oren_list_len(dxs2) != 3 { return 1375 }
    if dxs2[0] != 5 || dxs2[1] != 6 || dxs2[2] != 7 { return 1376 }
    if gen.return_value(g4e) != 46 { return 1377 }

    var g4f = gen.start(delegate_collect_outer, [9])
    var dsum2 = 0
    for dv2 in g4f { dsum2 = dsum2 + dv2 }
    if dsum2 != 30 { return 1378 }
    if gen.is_done(g4f) != true || gen.return_value(g4f) != 50 { return 1379 }

    var g5 = decl_counter(40)
    if oren_type_name(g5) != "generator" { return 139 }
    var d0 = gen.next(g5)
    if oren_is_err(d0) == true { return 140 }
    if d0["ok"] != true || d0["done"] != false || d0["value"] != 41 { return 141 }
    var d1 = gen.send(g5, 2)
    if oren_is_err(d1) == true { return 142 }
    if d1["ok"] != true || d1["value"] != 42 { return 143 }
    var d2 = gen.send(g5, 7)
    if oren_is_err(d2) == true { return 144 }
    if d2["done"] != true || d2["return"] != 12 { return 145 }

    var g6 = decl_nil(60)
    var dn0 = gen.next(g6)
    if oren_is_err(dn0) == true { return 146 }
    if dn0["ok"] != true || dn0["value"] != nil { return 147 }
    var dn1 = gen.send(g6, 3)
    if oren_is_err(dn1) == true { return 148 }
    if dn1["done"] != true || dn1["return"] != 67 { return 149 }

    var g7 = decl_collect(5)
    var dxs = gen.collect(g7)
    if oren_is_err(dxs) == true { return 150 }
    if oren_list_len(dxs) != 3 { return 151 }
    if dxs[0] != 5 || dxs[1] != 6 || dxs[2] != 7 { return 152 }
    if gen.return_value(g7) != 35 { return 153 }

    var g7d = decl_collect(8)
    var dsum = 0
    for dv in g7d { dsum = dsum + dv }
    if dsum != 27 { return 1531 }
    if gen.is_done(g7d) != true || gen.return_value(g7d) != 38 { return 1532 }

    var g7b = decl_var_counter(40)
    if oren_type_name(g7b) != "generator" { return 174 }
    var dv0 = gen.next(g7b)
    if oren_is_err(dv0) == true { return 175 }
    if dv0["ok"] != true || dv0["done"] != false || dv0["value"] != 41 { return 176 }
    var dv1 = gen.send(g7b, 2)
    if oren_is_err(dv1) == true { return 177 }
    if dv1["ok"] != true || dv1["value"] != 42 { return 178 }
    var dv2 = gen.send(g7b, 7)
    if oren_is_err(dv2) == true { return 179 }
    if dv2["done"] != true || dv2["return"] != 12 { return 180 }

    var g7c = decl_var_lambda(30)
    if oren_type_name(g7c) != "generator" { return 181 }
    var dl0 = gen.next(g7c)
    if oren_is_err(dl0) == true { return 182 }
    if dl0["ok"] != true || dl0["done"] != false || dl0["value"] != 32 { return 183 }
    var dl1 = gen.send(g7c, 4)
    if oren_is_err(dl1) == true { return 184 }
    if dl1["done"] != true || dl1["return"] != 13 { return 185 }

    var bad_delegate_ctx = gen.delegate(123, g1)
    if oren_is_err(bad_delegate_ctx) != true { return 186 }
    var bad_delegate_inner = gen.delegate(123, 456)
    if oren_is_err(bad_delegate_inner) != true { return 187 }
    var bad_delegate_direct = oren_generator_delegate(123, 456)
    if oren_is_err(bad_delegate_direct) != true { return 188 }

    var local_bias = 7
    fn local_add(a, b) {
        return a + b + local_bias
    }
    local_bias = 100
    if local_add(1, 2) != 10 { return 154 }

    var local_gen_bias = 100
    @oren.generator
    fn local_decl(seed) {
        var resumed = yield (seed + local_gen_bias)
        return resumed + local_gen_bias
    }
    local_gen_bias = 999
    var g8 = local_decl(5)
    var l0 = gen.next(g8)
    if oren_is_err(l0) == true { return 155 }
    if l0["ok"] != true || l0["done"] != false || l0["value"] != 105 { return 156 }
    var l1 = gen.send(g8, 4)
    if oren_is_err(l1) == true { return 157 }
    if l1["done"] != true || l1["return"] != 104 { return 158 }

    var local_var_bias = 30
    @oren.generator
    var local_var_decl = fn(seed) {
        var resumed = yield (seed + local_var_bias)
        return resumed + local_var_bias
    }
    local_var_bias = 999
    var g9 = local_var_decl(5)
    var lv0 = gen.next(g9)
    if oren_is_err(lv0) == true { return 186 }
    if lv0["ok"] != true || lv0["done"] != false || lv0["value"] != 35 { return 187 }
    var lv1 = gen.send(g9, 4)
    if oren_is_err(lv1) == true { return 188 }
    if lv1["done"] != true || lv1["return"] != 34 { return 189 }

    var g10 = decl_nil(70)
    var nil_count = 0
    for nv in g10 {
        if nv != nil { return 190 }
        nil_count = nil_count + 1
    }
    if nil_count != 1 { return 191 }
    if gen.is_done(g10) != true || gen.return_value(g10) != 77 { return 192 }

    return 0
}
