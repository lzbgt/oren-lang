import buffer "std:buffer"
import linalg "std:linalg"

fn fail(code) {
    print("native linalg typed-buffer runtime profile smoke FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

var a: []f64 = buffer.f64_new(3)
var b: []f64 = buffer.f64_new(3)
if oren_is_err(a) { fail(1) }
if oren_is_err(b) { fail(2) }

oren_buf_store_f64(a, 0, 1.0)
oren_buf_store_f64(a, 1, 2.0)
oren_buf_store_f64(a, 2, 3.0)
oren_buf_store_f64(b, 0, 4.0)
oren_buf_store_f64(b, 1, 5.0)
oren_buf_store_f64(b, 2, 6.0)

assert_eq(oren_buf_data_mod(a, 64), 0, 10)
assert_eq(linalg.try_dot_f64_buf(a, b), 32.0, 11)
assert_eq(linalg.try_reduce_sum_f64_buf(a), 6.0, 12)

var mf_a: []f32 = buffer.f32_new(4)
var mf_b: []f32 = buffer.f32_new(16)
if oren_is_err(mf_a) { fail(20) }
if oren_is_err(mf_b) { fail(21) }
oren_buf_store_f32(mf_a, 0, 1.0)
oren_buf_store_f32(mf_a, 1, 2.0)
oren_buf_store_f32(mf_a, 2, 3.0)
oren_buf_store_f32(mf_a, 3, 4.0)
var mf_i = 0
while mf_i < 16 {
    oren_buf_store_f32(mf_b, mf_i, 0.0)
    mf_i = mf_i + 1
}
oren_buf_store_f32(mf_b, 0, 1.0)
oren_buf_store_f32(mf_b, 5, 1.0)
oren_buf_store_f32(mf_b, 10, 1.0)
oren_buf_store_f32(mf_b, 15, 1.0)
var mf_o: []f32 = linalg.try_matmul_f32_buf(mf_a, mf_b, 1, 4, 4)
if oren_is_err(mf_o) { fail(22) }
assert_eq(oren_buf_load_f32(mf_o, 0), 1.0, 23)
assert_eq(oren_buf_load_f32(mf_o, 1), 2.0, 24)
assert_eq(oren_buf_load_f32(mf_o, 2), 3.0, 25)
assert_eq(oren_buf_load_f32(mf_o, 3), 4.0, 26)

var m64_o: []f64 = linalg.try_matmul_f64_buf(a, b, 1, 3, 1)
if oren_is_err(m64_o) { fail(30) }
assert_eq(oren_buf_load_f64(m64_o, 0), 32.0, 31)

print("native linalg typed-buffer runtime profile smoke OK")
exit(0)
