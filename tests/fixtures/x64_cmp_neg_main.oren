// x86_64 native backend fixture (rolling bring-up):
// - exercises signed comparisons involving negative immediates
// - ensures `cdqe`/sign-extension paths are consistent
//
// Expected:
//   x=-1, y=0:
//   x < y  => true  (+1)
//   x <= y => true  (+2)
//   x > y  => false (+0)
//   x >= y => false (+0)
//   x == y => false (+0)
//   x != y => true  (+32)
// => return 35

fn main() {
    var x = -1
    var y = 0
    var c = 0

    if x < y { c = c + 1 }
    if x <= y { c = c + 2 }
    if x > y { c = c + 4 }
    if x >= y { c = c + 8 }
    if x == y { c = c + 16 }
    if x != y { c = c + 32 }

    return c
}
