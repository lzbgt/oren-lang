@oren.package(runtime_profile="capsule", cap_allow_domains="TIME,RNG", budget_gas=100000, budget_heap_bytes=1048576, budget_wall_ms=1000)
var avm_package_policy = 1

fn main() {
    oren_rand_seed(12345)
    var t = oren_time_now_ns()
    var r = oren_rand_u64()
    oren_set_result({"t": t, "r": r})
}

main()
