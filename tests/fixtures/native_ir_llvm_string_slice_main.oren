// Native IR LLVM string slice smoke:
// - proves generated oren_string_slice materialization composes with dynamic concat, len, and eq

fn main() {
    var source = "abcdef"
    var start = 1
    var end = 4
    var s = oren_string_slice(source, start, end)
    var expected = "bcd"
    if oren_string_eq(s, expected) == false {
        return 1
    }
    if oren_string_len(s) != 3 {
        return 2
    }
    var suffix = "e"
    var joined = s + suffix
    if oren_string_eq(joined, "bcde") == false {
        return 3
    }
    if oren_string_len(joined) != 4 {
        return 4
    }
    var unchecked = oren_string_slice_unchecked(joined, 1, 3)
    if oren_string_eq(unchecked, "cd") == false {
        return 5
    }
    if oren_string_len(unchecked) != 2 {
        return 6
    }
    var picked = ""
    if oren_string_len(source) == 6 {
        picked = s
    } else {
        picked = suffix
    }
    var joined_after_branch = picked + suffix
    if oren_string_eq(joined_after_branch, "bcde") == false {
        return 7
    }
    var branch_slice = oren_string_slice(joined_after_branch, 1, 3)
    if oren_string_eq(branch_slice, "cd") == false {
        return 8
    }
    return 0
}
