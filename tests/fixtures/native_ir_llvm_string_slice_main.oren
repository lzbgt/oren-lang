// Native IR LLVM string slice smoke:
// - proves generated oren_string_slice materialization composes with len and eq

fn main() {
    var source = "abcdef"
    var start = 1
    var end = 4
    var s = oren_string_slice(source, start, end)
    if oren_string_eq(s, "bcd") == false {
        return 1
    }
    if oren_string_len(s) != 3 {
        return 2
    }
    return 0
}
