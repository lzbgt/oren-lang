// x64-native fixture (Tier-1 bring-up):
// - validates small-integer keys for maps work end-to-end on x64
//   (map literal + m[k] + m[k]=v)
//
// Rolling x64 v0 limitation:
// - keys are classified by a heuristic: key < 4096 => int, else string-pointer.
//   This will be replaced by a tagged value representation in a later milestone.
//
// Run on real x86_64 hosts (Win11 + WSL2) via:
//   ./scripts/verify_native_matrix.sh --targets x64-win-tier1 --tier1-src tests/fixtures/x64_map_int_key_main.oren
//   ./scripts/verify_native_matrix.sh --targets x64-wsl-tier1 --tier1-src tests/fixtures/x64_map_int_key_main.oren

fn main() {
    var m = {1: 10, 2: 20}

    if oren_map_len(m) != 2 { return 1 }
    if m[1] != 10 { return 2 }
    if m[2] != 20 { return 3 }
    if m[3] != 0 { return 4 }

    // Insert new key via index assignment.
    m[3] = 30
    if oren_map_len(m) != 3 { return 5 }
    if m[3] != 30 { return 6 }

    // Update existing key.
    var k = 2
    m[k] = 99
    if m[2] != 99 { return 7 }

    return 0
}
