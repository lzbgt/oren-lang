// x64-native fixture (Tier-1 bring-up):
// - validates nested map literals `{ "a": {"b": 7} }` behave correctly on x64
// - guards against intrinsic temp clobbering during nested literal construction
//
// Run on real x86_64 hosts (Win11 + WSL2) via:
//   ./scripts/verify_native_matrix.sh --targets x64-win-tier1 --tier1-src tests/fixtures/x64_nested_map_literal_main.oren
//   ./scripts/verify_native_matrix.sh --targets x64-wsl-tier1 --tier1-src tests/fixtures/x64_nested_map_literal_main.oren

fn main() {
    var m = {"a": {"b": 7}}
    if oren_map_len(m) != 1 { return 1 }

    var inner = oren_map_get_str(m, "a")
    if inner == 0 { return 2 }
    if inner == m { return 3 }
    if oren_map_len(inner) != 1 { return 4 }

    if oren_map_get_str(inner, "b") != 7 { return 5 }
    return 0
}
