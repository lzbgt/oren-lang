fn before_ready() {
    return 0
}

fn after_ready() {
    return 0
}

fn ready_worker() {
    before_ready()
    yield
    after_ready()
    return 1
}

fn ready_live_local(seed) {
    var acc = seed + 1
    yield
    return acc
}

fn ready_multi_yield(seed) {
    var acc = seed
    yield
    acc = acc + 1
    yield
    return acc + 1
}

fn main() {
    return ready_worker() + ready_live_local(40) + ready_multi_yield(10) - 54
}
