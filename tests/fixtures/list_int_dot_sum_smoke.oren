import list "std:list"
import linalg "std:linalg"

fn main() {
    var n = 10000
    var xs = list.int_new(n)
    var ys = list.int_new(n)
    var lit = [1, 2, 3, 4]
    if list.len(lit) != 4 { exit(10) }
    if lit[2] != 3 { exit(11) }
    var i = 0
    while i < n {
        var v = (i * 3 + 7) % 1000
        var w = (i * 5 + 11) % 1000
        list.int_push(xs, v)
        list.int_push(ys, w)
        i = i + 1
    }

    var expected_sum = 0
    var expected_dot = 0
    i = 0
    while i < n {
        var v2 = (i * 3 + 7) % 1000
        var w2 = (i * 5 + 11) % 1000
        expected_sum = expected_sum + v2
        expected_dot = expected_dot + v2 * w2
        i = i + 1
    }

    var sum = 0
    var dot = 0
    i = 0
    while i < n {
        var xv = xs[i]
        var yv = ys[i]
        sum = sum + xv
        dot = dot + xv * yv
        i = i + 1
    }

    if sum != expected_sum {
        print("list_int_dot_sum: sum mismatch got=" + oren_int_to_string(sum) +
            " expected=" + oren_int_to_string(expected_sum))
        exit(1)
    }
    if dot != expected_dot {
        print("list_int_dot_sum: dot mismatch got=" + oren_int_to_string(dot) +
            " expected=" + oren_int_to_string(expected_dot))
        exit(2)
    }

    var slot_sum = linalg.reduce_sum_i64_list_int_slots(xs)
    if slot_sum != expected_sum {
        print("list_int_dot_sum: slot sum mismatch got=" + oren_int_to_string(slot_sum) +
            " expected=" + oren_int_to_string(expected_sum))
        exit(3)
    }
    var slot_dot = linalg.dot_i64_list_int_slots(xs, ys)
    if slot_dot != expected_dot {
        print("list_int_dot_sum: slot dot mismatch got=" + oren_int_to_string(slot_dot) +
            " expected=" + oren_int_to_string(expected_dot))
        exit(4)
    }
    if linalg.reduce_sum_i64_list_int_slots(lit) != 10 { exit(5) }
    if linalg.dot_i64_list_int_slots(lit, [4, 5, 6, 7]) != 60 { exit(6) }
    if oren_is_err(linalg.dot_i64_list_int_slots([1, 2], [1])) != true { exit(7) }
    if oren_is_err(linalg.reduce_sum_i64_list_int_slots([1, "x"])) != true { exit(8) }

    print("sum=" + oren_int_to_string(sum))
    print("dot=" + oren_int_to_string(dot))
    print("ok: list<int> dot sum")
    return 0
}
