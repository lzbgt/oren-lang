// Structured error smoke (native quick integration).
//
// Validates std:result helpers on a guaranteed error path.

import r "../../lib/std/result.oren"
import list "std:list"
import buffer "std:buffer"
import base64 "std:encoding/base64"
import strings "std:strings"
import bytes "std:bytes"
import pem "std:crypto/pem"
import ui_cmds "std:ui/commands"
import ui_color "std:ui/color"
import ui_raster "std:ui/raster"
import linalg "std:linalg"

fn smoke_result_double(x) { return x * 2 }
fn smoke_result_positive(x) {
    if x <= 0 { return r.err(4, "not positive") }
    return x
}
fn smoke_result_tag(e) { return r.with_context(e, "tagged") }
fn smoke_result_recover(e) {
    if r.code(e) == 4 { return 77 }
    return e
}

fn smoke_buffer_slice_views(i32b) {
    var s_ok2 = buffer.try_slice_new(i32b, 0, 2)
    if r.is_err(s_ok2) { return 186 }
    var sv = buffer.try_slice_load_i32(s_ok2, 0)
    if r.is_err(sv) || sv != -7 { return 188 }
    var ss = buffer.try_slice_store_i32(s_ok2, 1, 9)
    if r.is_err(ss) || ss != i32b { return 189 }
    var sv2 = buffer.try_slice_load_i32(s_ok2, 1)
    if r.is_err(sv2) || sv2 != 9 { return 190 }
    var s_bad_idx = buffer.try_slice_load_i32(s_ok2, 2)
    if r.is_err(s_bad_idx) != true { return 191 }
    var s_sub = buffer.try_slice_slice(s_ok2, 1, 1)
    if r.is_err(s_sub) || buffer.try_slice_len(s_sub) != 1 { return 192 }
    var s_sub_v = buffer.try_slice_load_i32(s_sub, 0)
    if r.is_err(s_sub_v) || s_sub_v != 9 { return 193 }
    var u8_view_buf = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_view_buf) { return 210 }
    var u8_slice = buffer.try_slice_new(u8_view_buf, 1, 3)
    if r.is_err(u8_slice) { return 211 }
    var u8_slice_s = buffer.try_slice_to_string(u8_slice)
    if r.is_err(u8_slice_s) || u8_slice_s != "BCD" { return 212 }
    var u8_slice_b = buffer.try_slice_to_bytes(u8_slice)
    if r.is_err(u8_slice_b) || bytes.try_to_string(u8_slice_b) != "BCD" { return 213 }
    var u8_slice_list = buffer.try_slice_unpack_u8(u8_slice)
    if r.is_err(u8_slice_list) || oren_list_len(u8_slice_list) != 3 || u8_slice_list[0] != 66 || u8_slice_list[2] != 68 { return 240 }
    var u8_slice_buf = buffer.try_slice_to_u8_buf(u8_slice)
    if r.is_err(u8_slice_buf) || buffer.try_u8_to_string(u8_slice_buf) != "BCD" { return 226 }
    var u8_slice_copy = buffer.try_slice_copy_from_bytes(u8_slice, bytes.try_from_string("xyz"))
    if r.is_err(u8_slice_copy) || u8_slice_copy != u8_view_buf { return 214 }
    var u8_view_s = buffer.try_u8_to_string(u8_view_buf)
    if r.is_err(u8_view_s) || u8_view_s != "AxyzE" { return 215 }
    var u8_view_buf_slice = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_view_buf_slice) { return 1201 }
    var u8_slice_bytes = buffer.try_slice_new(u8_view_buf_slice, 1, 3)
    if r.is_err(u8_slice_bytes) { return 1202 }
    var u8_slice_copy_bytes = buffer.try_slice_copy_from_bytes_slice(u8_slice_bytes, bytes.try_from_string("vwxyz"), 1, 3)
    if r.is_err(u8_slice_copy_bytes) || u8_slice_copy_bytes != u8_view_buf_slice { return 1203 }
    var u8_view_slice_s = buffer.try_u8_to_string(u8_view_buf_slice)
    if r.is_err(u8_view_slice_s) || u8_view_slice_s != "AwxyE" { return 1204 }
    var u8_view_buf2 = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_view_buf2) { return 227 }
    var u8_slice2 = buffer.try_slice_new(u8_view_buf2, 1, 3)
    if r.is_err(u8_slice2) { return 228 }
    var u8_slice_copy_s = buffer.try_slice_copy_from_string(u8_slice2, "mno")
    if r.is_err(u8_slice_copy_s) || u8_slice_copy_s != u8_view_buf2 { return 229 }
    var u8_view_s2 = buffer.try_u8_to_string(u8_view_buf2)
    if r.is_err(u8_view_s2) || u8_view_s2 != "AmnoE" { return 230 }
    var u8_view_buf4 = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_view_buf4) { return 1238 }
    var u8_slice4 = buffer.try_slice_new(u8_view_buf4, 1, 3)
    if r.is_err(u8_slice4) { return 1239 }
    var u8_slice_copy_s2 = buffer.try_slice_copy_from_string_slice(u8_slice4, "lmnop", 1, 3)
    if r.is_err(u8_slice_copy_s2) || u8_slice_copy_s2 != u8_view_buf4 { return 1240 }
    var u8_view_s4 = buffer.try_u8_to_string(u8_view_buf4)
    if r.is_err(u8_view_s4) || u8_view_s4 != "AmnoE" { return 1241 }
    var u8_view_buf3 = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_view_buf3) { return 241 }
    var u8_slice3 = buffer.try_slice_new(u8_view_buf3, 1, 3)
    if r.is_err(u8_slice3) { return 242 }
    var u8_src3 = buffer.try_u8_from_string("pqr")
    if r.is_err(u8_src3) { return 243 }
    var u8_slice_copy_buf = buffer.try_slice_copy_from_u8_buf(u8_slice3, u8_src3)
    if r.is_err(u8_slice_copy_buf) || u8_slice_copy_buf != u8_view_buf3 { return 244 }
    var u8_view_s3 = buffer.try_u8_to_string(u8_view_buf3)
    if r.is_err(u8_view_s3) || u8_view_s3 != "ApqrE" { return 245 }
    var bad_u8_slice_s = buffer.try_slice_to_string("nope")
    if r.is_err(bad_u8_slice_s) != true { return 216 }
    var bad_u8_slice_copy = buffer.try_slice_copy_from_bytes(u8_slice, bytes.try_from_string("xy"))
    if r.is_err(bad_u8_slice_copy) != true { return 217 }
    var bad_u8_slice_copy_bytes = buffer.try_slice_copy_from_bytes_slice(u8_slice_bytes, bytes.try_from_string("vw"), 0, 2)
    if r.is_err(bad_u8_slice_copy_bytes) != true { return 1205 }
    var bad_u8_slice_list = buffer.try_slice_unpack_u8("nope")
    if r.is_err(bad_u8_slice_list) != true { return 246 }
    var bad_u8_slice_buf = buffer.try_slice_to_u8_buf("nope")
    if r.is_err(bad_u8_slice_buf) != true { return 231 }
    var bad_u8_slice_copy_s = buffer.try_slice_copy_from_string(u8_slice2, "xy")
    if r.is_err(bad_u8_slice_copy_s) != true { return 232 }
    var bad_u8_slice_copy_s2 = buffer.try_slice_copy_from_string_slice(u8_slice4, "xy", 0, 2)
    if r.is_err(bad_u8_slice_copy_s2) != true { return 1242 }
    var bad_u8_slice_copy_buf = buffer.try_slice_copy_from_u8_buf(u8_slice3, buffer.try_u8_from_string("xy"))
    if r.is_err(bad_u8_slice_copy_buf) != true { return 247 }
    return 0
}

fn smoke_buffer_strided_views(i32b) {
    var stride_ok = buffer.try_strided_new(i32b, 0, 2, 1)
    if r.is_err(stride_ok) { return 194 }
    var stride_bad = buffer.try_strided_new(i32b, 0, 2, 0)
    if r.is_err(stride_bad) != true { return 195 }
    var stride_v = buffer.try_strided_load_i32(stride_ok, 1)
    if r.is_err(stride_v) || stride_v != 9 { return 196 }
    var stride_set = buffer.try_strided_store_i32(stride_ok, 0, 11)
    if r.is_err(stride_set) || stride_set != i32b { return 197 }
    var stride_v2 = buffer.try_strided_load_i32(stride_ok, 0)
    if r.is_err(stride_v2) || stride_v2 != 11 { return 198 }
    var stride_bad_idx = buffer.try_strided_load_i32(stride_ok, 2)
    if r.is_err(stride_bad_idx) != true { return 199 }
    var u8_stride_buf = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_stride_buf) { return 218 }
    var u8_stride = buffer.try_strided_new(u8_stride_buf, 0, 3, 2)
    if r.is_err(u8_stride) { return 219 }
    var u8_stride_s = buffer.try_strided_to_string(u8_stride)
    if r.is_err(u8_stride_s) || u8_stride_s != "ACE" { return 220 }
    var u8_stride_b = buffer.try_strided_to_bytes(u8_stride)
    if r.is_err(u8_stride_b) || bytes.try_to_string(u8_stride_b) != "ACE" { return 221 }
    var u8_stride_list = buffer.try_strided_unpack_u8(u8_stride)
    if r.is_err(u8_stride_list) || oren_list_len(u8_stride_list) != 3 || u8_stride_list[0] != 65 || u8_stride_list[2] != 69 { return 248 }
    var u8_stride_buf2 = buffer.try_strided_to_u8_buf(u8_stride)
    if r.is_err(u8_stride_buf2) || buffer.try_u8_to_string(u8_stride_buf2) != "ACE" { return 233 }
    var u8_stride_copy = buffer.try_strided_copy_from_bytes(u8_stride, bytes.try_from_string("xyz"))
    if r.is_err(u8_stride_copy) || u8_stride_copy != u8_stride_buf { return 222 }
    var u8_stride_buf_s = buffer.try_u8_to_string(u8_stride_buf)
    if r.is_err(u8_stride_buf_s) || u8_stride_buf_s != "xByDz" { return 223 }
    var u8_stride_buf_slice = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_stride_buf_slice) { return 1206 }
    var u8_stride_bytes = buffer.try_strided_new(u8_stride_buf_slice, 0, 3, 2)
    if r.is_err(u8_stride_bytes) { return 1207 }
    var u8_stride_copy_bytes = buffer.try_strided_copy_from_bytes_slice(u8_stride_bytes, bytes.try_from_string("uvwxy"), 1, 3)
    if r.is_err(u8_stride_copy_bytes) || u8_stride_copy_bytes != u8_stride_buf_slice { return 1208 }
    var u8_stride_slice_s = buffer.try_u8_to_string(u8_stride_buf_slice)
    if r.is_err(u8_stride_slice_s) || u8_stride_slice_s != "vBwDx" { return 1209 }
    var u8_stride_buf3 = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_stride_buf3) { return 234 }
    var u8_stride2 = buffer.try_strided_new(u8_stride_buf3, 0, 3, 2)
    if r.is_err(u8_stride2) { return 235 }
    var u8_stride_copy_s = buffer.try_strided_copy_from_string(u8_stride2, "uvw")
    if r.is_err(u8_stride_copy_s) || u8_stride_copy_s != u8_stride_buf3 { return 236 }
    var u8_stride_s2 = buffer.try_u8_to_string(u8_stride_buf3)
    if r.is_err(u8_stride_s2) || u8_stride_s2 != "uBvDw" { return 237 }
    var u8_stride_buf5 = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_stride_buf5) { return 1243 }
    var u8_stride4 = buffer.try_strided_new(u8_stride_buf5, 0, 3, 2)
    if r.is_err(u8_stride4) { return 1244 }
    var u8_stride_copy_s2 = buffer.try_strided_copy_from_string_slice(u8_stride4, "uvwxy", 1, 3)
    if r.is_err(u8_stride_copy_s2) || u8_stride_copy_s2 != u8_stride_buf5 { return 1245 }
    var u8_stride_s4 = buffer.try_u8_to_string(u8_stride_buf5)
    if r.is_err(u8_stride_s4) || u8_stride_s4 != "vBwDx" { return 1246 }
    var u8_stride_buf4 = buffer.try_u8_from_string("ABCDE")
    if r.is_err(u8_stride_buf4) { return 249 }
    var u8_stride3 = buffer.try_strided_new(u8_stride_buf4, 0, 3, 2)
    if r.is_err(u8_stride3) { return 250 }
    var u8_src4 = buffer.try_u8_from_string("rst")
    if r.is_err(u8_src4) { return 251 }
    var u8_stride_copy_buf = buffer.try_strided_copy_from_u8_buf(u8_stride3, u8_src4)
    if r.is_err(u8_stride_copy_buf) || u8_stride_copy_buf != u8_stride_buf4 { return 252 }
    var u8_stride_s3 = buffer.try_u8_to_string(u8_stride_buf4)
    if r.is_err(u8_stride_s3) || u8_stride_s3 != "rBsDt" { return 253 }
    var bad_u8_stride_s = buffer.try_strided_to_string("nope")
    if r.is_err(bad_u8_stride_s) != true { return 224 }
    var bad_u8_stride_copy = buffer.try_strided_copy_from_bytes(u8_stride, bytes.try_from_string("xy"))
    if r.is_err(bad_u8_stride_copy) != true { return 225 }
    var bad_u8_stride_copy_bytes = buffer.try_strided_copy_from_bytes_slice(u8_stride_bytes, bytes.try_from_string("uv"), 0, 2)
    if r.is_err(bad_u8_stride_copy_bytes) != true { return 1210 }
    var bad_u8_stride_list = buffer.try_strided_unpack_u8("nope")
    if r.is_err(bad_u8_stride_list) != true { return 254 }
    var bad_u8_stride_buf = buffer.try_strided_to_u8_buf("nope")
    if r.is_err(bad_u8_stride_buf) != true { return 238 }
    var bad_u8_stride_copy_s = buffer.try_strided_copy_from_string(u8_stride2, "uv")
    if r.is_err(bad_u8_stride_copy_s) != true { return 239 }
    var bad_u8_stride_copy_s2 = buffer.try_strided_copy_from_string_slice(u8_stride4, "uv", 0, 2)
    if r.is_err(bad_u8_stride_copy_s2) != true { return 1247 }
    var bad_u8_stride_copy_buf = buffer.try_strided_copy_from_u8_buf(u8_stride3, buffer.try_u8_from_string("rs"))
    if r.is_err(bad_u8_stride_copy_buf) != true { return 255 }
    return 0
}

fn smoke_buffer_core() {
    // std:buffer structured errors
    var ub = buffer.u8_new(3)
    var ub_len = buffer.try_len(ub)
    if r.is_err(ub_len) || ub_len != 3 { return 36 }
    var ub_bad = buffer.try_load_u8(ub, 3)
    if r.is_err(ub_bad) != true { return 37 }
    var ub_bad_set = buffer.try_store_u8(ub, 0, 300)
    if r.is_err(ub_bad_set) != true { return 38 }
    var i32b = buffer.i32_new(2)
    if r.is_err(i32b) { return 39 }
    var i32s = buffer.try_store_i32(i32b, 0, -7)
    if r.is_err(i32s) || i32s != i32b { return 40 }
    var i32v = buffer.try_load_i32(i32b, 0)
    if r.is_err(i32v) || i32v != -7 { return 41 }
    var i32_bad = buffer.try_load_i32(i32b, 2)
    if r.is_err(i32_bad) != true { return 42 }
    var i64b = buffer.i64_new(2)
    if r.is_err(i64b) { return 43 }
    var i64s = buffer.try_store_i64(i64b, 1, 4294967296)
    if r.is_err(i64s) || i64s != i64b { return 44 }
    var i64v = buffer.try_load_i64(i64b, 1)
    if r.is_err(i64v) || i64v != 4294967296 { return 45 }
    var i32_list = buffer.try_i32_unpack_list(i32b)
    if r.is_err(i32_list) || oren_list_len(i32_list) != 2 || i32_list[0] != -7 || i32_list[1] != 0 { return 46 }
    var i32_pack_try = buffer.try_i32_pack_list_int([5, 6])
    if r.is_err(i32_pack_try) { return 47 }
    var i32_pack_list = buffer.try_i32_unpack_list(i32_pack_try)
    if r.is_err(i32_pack_list) || oren_list_len(i32_pack_list) != 2 || i32_pack_list[1] != 6 { return 48 }
    var i32_pack_bad = buffer.try_i32_pack_list_int([2147483648])
    if r.is_err(i32_pack_bad) != true { return 49 }
    var i64_pack_try = buffer.try_i64_pack_list_int([8, 9, 4294967296])
    if r.is_err(i64_pack_try) { return 673 }
    var i64_pack_list = buffer.try_i64_unpack_list(i64_pack_try)
    if r.is_err(i64_pack_list) || oren_list_len(i64_pack_list) != 3 || i64_pack_list[2] != 4294967296 { return 674 }
    var i64_into = buffer.i64_new(2)
    if r.is_err(i64_into) { return 675 }
    if r.is_err(buffer.try_i64_pack_list_int_into(i64_into, [10, 11])) { return 676 }
    var i64_into_list = buffer.try_i64_unpack_list(i64_into)
    if r.is_err(i64_into_list) || i64_into_list[1] != 11 { return 677 }
    if r.is_err(buffer.try_i64_pack_list_int_into(i64_into, [1])) != true { return 678 }
    if r.is_err(buffer.try_i32_pack_list_int_into(i64_into, [10, 11])) != true { return 16790 }
    var f32_pack_try = buffer.try_f32_pack_list([1.5, 2.5, 3.5])
    if r.is_err(f32_pack_try) { return 679 }
    var f32_pack_list = buffer.try_f32_unpack_list(f32_pack_try)
    if r.is_err(f32_pack_list) || oren_list_len(f32_pack_list) != 3 { return 680 }
    var f32_into = buffer.f32_new(2)
    if r.is_err(f32_into) { return 681 }
    if r.is_err(buffer.try_f32_pack_list_into(f32_into, [4.5, 5.5])) { return 682 }
    var f32_into_list = buffer.try_f32_unpack_list(f32_into)
    if r.is_err(f32_into_list) || oren_list_len(f32_into_list) != 2 { return 683 }
    if r.is_err(buffer.try_f32_pack_list_into(f32_into, [1.0])) != true { return 684 }
    var f64_pack_try = buffer.try_f64_pack_list([6.25, 7.25])
    if r.is_err(f64_pack_try) { return 685 }
    var f64_pack_list = buffer.try_f64_unpack_list(f64_pack_try)
    if r.is_err(f64_pack_list) || oren_list_len(f64_pack_list) != 2 { return 686 }
    var f64_into = buffer.f64_new(2)
    if r.is_err(f64_into) { return 687 }
    if r.is_err(buffer.try_f64_pack_list_into(f64_into, [8.25, 9.25])) { return 688 }
    var f64_into_list = buffer.try_f64_unpack_list(f64_into)
    if r.is_err(f64_into_list) || oren_list_len(f64_into_list) != 2 { return 689 }
    if r.is_err(buffer.try_f64_pack_list_into(f64_into, [1.0])) != true { return 690 }
    var u8_from = buffer.try_u8_from_string("AB")
    if r.is_err(u8_from) { return 50 }
    var u8_text = buffer.try_u8_to_string(u8_from)
    if r.is_err(u8_text) || u8_text != "AB" { return 51 }
    var u8_list = buffer.try_u8_unpack(u8_from)
    if r.is_err(u8_list) || oren_list_len(u8_list) != 2 || u8_list[0] != 65 || u8_list[1] != 66 { return 52 }
    var u8_pack = buffer.try_u8_pack([67, 68])
    if r.is_err(u8_pack) { return 53 }
    var u8_pack_text = buffer.try_u8_to_string(u8_pack)
    if r.is_err(u8_pack_text) || u8_pack_text != "CD" { return 54 }
    var u8_pack_bad = buffer.try_u8_pack([256])
    if r.is_err(u8_pack_bad) != true { return 55 }
    var u8_pack_bad_type = buffer.try_u8_pack(123)
    if r.is_err(u8_pack_bad_type) != true { return 56 }
    var u8_from_bad = buffer.try_u8_from_string(123)
    if r.is_err(u8_from_bad) != true { return 57 }
    var f32b = buffer.f32_new(2)
    if r.is_err(f32b) { return 58 }
    var f32s = buffer.try_store_f32(f32b, 0, 1.5)
    if r.is_err(f32s) || f32s != f32b { return 59 }
    var f32v = buffer.try_load_f32(f32b, 0)
    if r.is_err(f32v) { return 60 }
    var f32_bad = buffer.try_load_f32(f32b, 2)
    if r.is_err(f32_bad) != true { return 61 }
    var f64b = buffer.f64_new(2)
    if r.is_err(f64b) { return 62 }
    var f64s = buffer.try_store_f64(f64b, 1, -0.5)
    if r.is_err(f64s) || f64s != f64b { return 63 }
    var f64v = buffer.try_load_f64(f64b, 1)
    if r.is_err(f64v) { return 64 }
    var f64_bad = buffer.try_load_f64(f64b, 3)
    if r.is_err(f64_bad) != true { return 65 }
    var rc = smoke_buffer_slice_views(i32b)
    if rc != 0 { return rc }
    rc = smoke_buffer_strided_views(i32b)
    if rc != 0 { return rc }

    return 0
}

fn smoke_list_int_slot_ops() {
    var xs = list.int_new(4)
    var lit = [4, 5, 6, 7]
    if oren_is_err(xs) { return 16791 }
    list.int_push(xs, 1)
    list.int_push(xs, 2)
    list.int_push(xs, 3)
    list.int_push(xs, 4)
    var short = list.int_new(1)
    if oren_is_err(short) { return 16790 }
    list.int_push(short, 1)
    if oren_list_int_slot_stride_bytes() != 8 { return 16792 }
    if oren_list_int_reduce_sum_slots(xs) != 10 { return 16793 }
    if oren_list_int_reduce_sum_slots_unchecked(xs) != 10 { return 16794 }
    if oren_list_int_dot_slots(xs, xs) != 30 { return 16795 }
    if oren_list_int_dot_slots_unchecked(xs, xs) != 30 { return 16796 }
    if oren_list_int_reduce_sum_slots(nil) != 0 { return 16797 }
    if oren_list_int_dot_slots(nil, nil) != 0 { return 16798 }
    if oren_list_int_reduce_sum_slots_unchecked(nil) != 0 { return 16799 }
