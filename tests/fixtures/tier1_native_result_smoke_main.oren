    if r.is_err(us) || us != "AB" { return 92 }
    var us2 = bytes.to_string(ub3)
    if r.is_err(us2) || us2 != "AB" { return 93 }
    var from_buf = bytes.try_from_u8_buf(ub3)
    if r.is_err(from_buf) || bytes.try_to_string(from_buf) != "AB" { return 94 }
    var to_buf = bytes.try_to_u8_buf(bytes.try_from_string("CD"))
    if r.is_err(to_buf) || buffer.try_u8_to_string(to_buf) != "CD" { return 95 }
    var bad_from_buf = bytes.try_from_u8_buf("nope")
    if r.is_err(bad_from_buf) != true { return 96 }
    var bad_to_buf = bytes.try_to_u8_buf(123)
    if r.is_err(bad_to_buf) != true { return 97 }
    var str_slice = bytes.try_to_string_slice(bytes.try_from_string("hello"), 1, 3)
    if r.is_err(str_slice) || str_slice != "ell" { return 98 }
    var buf_slice = bytes.try_to_u8_buf_slice(bytes.try_from_string("hello"), 1, 3)
    if r.is_err(buf_slice) || buffer.try_u8_to_string(buf_slice) != "ell" { return 99 }
    var bad_str_slice = bytes.try_to_string_slice("nope", 0, 1)
    if r.is_err(bad_str_slice) != true { return 100 }
    var bad_buf_slice = bytes.try_to_u8_buf_slice("nope", 0, 1)
    if r.is_err(bad_buf_slice) != true { return 101 }
    var ui_bad_fb = ui_cmds.validate([], "x", 1, nil)
    if r.is_err(ui_bad_fb) != true { return 909 }
    var u8_from_bytes = buffer.try_u8_from_bytes(bytes.try_from_string("EF"))
    if r.is_err(u8_from_bytes) || buffer.try_u8_to_string(u8_from_bytes) != "EF" { return 102 }
    var u8_from_bytes_slice = buffer.try_u8_from_bytes_slice(bytes.try_from_string("hello"), 1, 3)
    if r.is_err(u8_from_bytes_slice) || buffer.try_u8_to_string(u8_from_bytes_slice) != "ell" { return 103 }
    var u8_to_bytes = buffer.try_u8_to_bytes(ub3)
    if r.is_err(u8_to_bytes) || bytes.try_to_string(u8_to_bytes) != "AB" { return 104 }
    var i32_copy_src = buffer.try_i32_pack_list_int([12, 13])
    if r.is_err(i32_copy_src) { return 1101 }
    var i32_copy_dst = buffer.i32_new(2)
    if r.is_err(i32_copy_dst) { return 1102 }
    if r.is_err(buffer.try_i32_copy_from_i32_buf(i32_copy_dst, i32_copy_src)) { return 1103 }
    var i32_copy_list = buffer.try_i32_unpack_list(i32_copy_dst)
    if r.is_err(i32_copy_list) || i32_copy_list[0] != 12 || i32_copy_list[1] != 13 { return 1104 }
    if r.is_err(buffer.try_i32_copy_from_i32_buf(i32_copy_dst, buffer.i32_new(3))) != true { return 1105 }
    if r.is_err(buffer.try_i32_copy_from_i32_buf(i32_copy_dst, buffer.try_u8_from_string("AB"))) != true { return 1106 }
    var i64_copy_src = buffer.try_i64_pack_list_int([14, 15])
    if r.is_err(i64_copy_src) { return 1107 }
    var i64_copy_dst = buffer.i64_new(2)
    if r.is_err(i64_copy_dst) { return 1108 }
    if r.is_err(buffer.try_i64_copy_from_i64_buf(i64_copy_dst, i64_copy_src)) { return 1109 }
    var i64_copy_list = buffer.try_i64_unpack_list(i64_copy_dst)
    if r.is_err(i64_copy_list) || i64_copy_list[0] != 14 || i64_copy_list[1] != 15 { return 1110 }
    if r.is_err(buffer.try_i64_copy_from_i64_buf(i64_copy_dst, buffer.i64_new(3))) != true { return 1111 }
    if r.is_err(buffer.try_i64_copy_from_i64_buf(i64_copy_dst, buffer.try_u8_from_string("AB"))) != true { return 1112 }
    var f32_copy_src = buffer.try_f32_pack_list([6.5, 7.5])
    if r.is_err(f32_copy_src) { return 1113 }
    var f32_copy_dst = buffer.f32_new(2)
    if r.is_err(f32_copy_dst) { return 1114 }
    if r.is_err(buffer.try_f32_copy_from_f32_buf(f32_copy_dst, f32_copy_src)) { return 1115 }
    var f32_copy_list = buffer.try_f32_unpack_list(f32_copy_dst)
    if r.is_err(f32_copy_list) || oren_list_len(f32_copy_list) != 2 { return 1116 }
    if r.is_err(buffer.try_f32_copy_from_f32_buf(f32_copy_dst, buffer.f32_new(3))) != true { return 1117 }
    if r.is_err(buffer.try_f32_copy_from_f32_buf(f32_copy_dst, buffer.try_u8_from_string("AB"))) != true { return 1118 }
    var f64_copy_src = buffer.try_f64_pack_list([10.25, 11.25])
    if r.is_err(f64_copy_src) { return 1119 }
    var f64_copy_dst = buffer.f64_new(2)
    if r.is_err(f64_copy_dst) { return 1120 }
    if r.is_err(buffer.try_f64_copy_from_f64_buf(f64_copy_dst, f64_copy_src)) { return 1121 }
    var f64_copy_list = buffer.try_f64_unpack_list(f64_copy_dst)
    if r.is_err(f64_copy_list) || oren_list_len(f64_copy_list) != 2 { return 1122 }
    if r.is_err(buffer.try_f64_copy_from_f64_buf(f64_copy_dst, buffer.f64_new(3))) != true { return 1123 }
    if r.is_err(buffer.try_f64_copy_from_f64_buf(f64_copy_dst, buffer.try_u8_from_string("AB"))) != true { return 1124 }
    var u8_copy_dst = buffer.u8_new(2)
    if r.is_err(u8_copy_dst) { return 1125 }
    if r.is_err(buffer.try_u8_copy_from_u8_buf(u8_copy_dst, ub3)) { return 1126 }
    if buffer.try_u8_to_string(u8_copy_dst) != "AB" { return 1127 }
    if r.is_err(buffer.try_u8_copy_from_bytes(u8_copy_dst, bytes.try_from_string("EF"))) { return 1128 }
    if buffer.try_u8_to_string(u8_copy_dst) != "EF" { return 1129 }
    if r.is_err(buffer.try_u8_copy_from_bytes_slice(u8_copy_dst, bytes.try_from_string("WXYZ"), 1, 2)) { return 1136 }
    if buffer.try_u8_to_string(u8_copy_dst) != "XY" { return 1137 }
    if r.is_err(buffer.try_u8_copy_from_string(u8_copy_dst, "GH")) { return 1130 }
    if buffer.try_u8_to_string(u8_copy_dst) != "GH" { return 1131 }
    if r.is_err(buffer.try_u8_copy_from_string_slice(u8_copy_dst, "LMNO", 1, 2)) { return 1225 }
    if buffer.try_u8_to_string(u8_copy_dst) != "MN" { return 1226 }
    if r.is_err(buffer.try_u8_copy_from_u8_buf(u8_copy_dst, buffer.u8_new(3))) != true { return 1132 }
    if r.is_err(buffer.try_u8_copy_from_u8_buf(u8_copy_dst, i32_copy_src)) != true { return 1133 }
    if r.is_err(buffer.try_u8_copy_from_bytes(u8_copy_dst, bytes.try_from_string("XYZ"))) != true { return 1134 }
    if r.is_err(buffer.try_u8_copy_from_bytes_slice(u8_copy_dst, bytes.try_from_string("WXYZ"), 1, 3)) != true { return 1138 }
    if r.is_err(buffer.try_u8_copy_from_string(u8_copy_dst, "JKL")) != true { return 1135 }
    if r.is_err(buffer.try_u8_from_string_slice("nope", 0, 5)) != true { return 1227 }
    if r.is_err(buffer.try_u8_copy_from_string_slice(u8_copy_dst, "JKL", 0, 3)) != true { return 1228 }
    var bad_u8_from_bytes = buffer.try_u8_from_bytes("nope")
    if r.is_err(bad_u8_from_bytes) != true { return 105 }
    var bad_u8_from_bytes_slice = buffer.try_u8_from_bytes_slice("nope", 0, 1)
    if r.is_err(bad_u8_from_bytes_slice) != true { return 106 }
    var bad_u8_to_bytes = buffer.try_u8_to_bytes("nope")
    if r.is_err(bad_u8_to_bytes) != true { return 107 }

    return 0
}

fn smoke_ui_result_surface() {
    var okc = ui_color.parse_hex("#010203")
    if r.is_err(okc) { return 1300 }
    if okc["r"] != 1 || okc["g"] != 2 || okc["b"] != 3 || okc["a"] != 255 { return 1301 }
    var badc = ui_color.parse_hex("red")
    if r.is_err(badc) != true { return 1302 }
    if oren_err_code(badc) != 4 { return 1303 }
    if oren_err_msg(badc) != "color must be #RRGGBB or #RRGGBBAA" { return 1304 }
    var bad_bg = ui_raster.rasterize([], 1, 1, {"clear_color": "red"})
    if r.is_err(bad_bg) != true { return 1305 }
    if oren_err_code(bad_bg) != 4 { return 1306 }
    if oren_err_msg(bad_bg) != "rasterize: clear_color: color must be #RRGGBB or #RRGGBBAA" { return 1307 }
    return 0
}

fn main() {
    // Non-existent file => error
    var v = oren_read_file("__oren_result_smoke_missing__.txt")
    if r.is_err(v) != true { return 1 }

    // unwrap_or should return fallback on error.
    var s = r.unwrap_or(v, "fallback")
    if s != "fallback" { return 2 }

    // errno adapter should map negative rc to err.
    var e = r.ok_or_errno(0 - 12, "alloc") // -ENOMEM
    if r.is_err(e) != true { return 3 }
    if oren_err_code(e) != 12 { return 4 }

    // ok_or_errno should pass through success.
    var okv = r.ok_or_errno(5, "read")
    if okv != 5 { return 5 }
    if r.code(okv) != nil || r.msg(okv) != nil { return 1500 }
    if r.map_ok(21, smoke_result_double) != 42 { return 1501 }
    var e_keep = r.map_ok(e, smoke_result_double)
    if r.is_err(e_keep) != true || r.code(e_keep) != 12 { return 1502 }
    if r.and_then(9, smoke_result_positive) != 9 { return 1503 }
    var e_chain = r.and_then(0, smoke_result_positive)
    if r.is_err(e_chain) != true || r.code(e_chain) != 4 { return 1504 }
    var e_tagged = r.map_err(e_chain, smoke_result_tag)
    if r.is_err(e_tagged) != true || r.msg(e_tagged) != "tagged: not positive" { return 1505 }
    if r.map_err(19, smoke_result_tag) != 19 { return 1506 }
    if r.or_else(e_chain, smoke_result_recover) != 77 { return 1507 }
    if r.or_else(88, smoke_result_recover) != 88 { return 1508 }

    // std:list structured error helpers
    var xs = [1, 2]
    var okv = list.try_get(xs, 1)
    if r.is_err(okv) { return 6 }
    if okv != 2 { return 7 }

    var oob = list.try_get(xs, 3)
    if r.is_err(oob) != true { return 8 }
    var bad_idx = list.try_get(xs, "x")
    if r.is_err(bad_idx) != true { return 901 }

    var bad = list.try_set(xs, -1, 0)
    if r.is_err(bad) != true { return 9 }
    var bad_copy = list.slice_copy(xs, "x", 1)
    if r.is_err(bad_copy) != true { return 902 }
    var bad_view = list.slice_view(xs, "x", 1)
    var bad_view_count = 0
    for _x in bad_view { bad_view_count = bad_view_count + 1 }
    if bad_view_count != 0 { return 903 }

    var last = list.try_last(xs)
    if r.is_err(last) || last != 2 { return 10 }

    var empty = []
    var empty_last = list.try_last(empty)
    if r.is_err(empty_last) != true { return 11 }

    var ui_smoke = smoke_ui_result_surface()
    if ui_smoke != 0 { return ui_smoke }

    // std:buffer structured errors
    var b = buffer.u8_new(4)
    var s = buffer.slice_new(b, 0, 4)
    if r.is_err(s) { return 12 }
    var bad_slice = buffer.slice_new(b, 3, 4)
    if r.is_err(bad_slice) != true { return 13 }

    // std:encoding/base64 errors
    var b64_bad = base64.decode_bytes("!!!")
    if r.is_err(b64_bad) != true { return 14 }
    var b64_bad_in = base64.encode_bytes(123)
    if r.is_err(b64_bad_in) != true { return 15 }
    var b64_ws = base64.decode_bytes_strict("TQ==\n")
    if r.is_err(b64_ws) != true { return 16 }
    var b64_ok = base64.decode_bytes_strict("TQ==")
    if r.is_err(b64_ok) { return 17 }
    var b64_ok_len = bytes.try_len(b64_ok)
    if r.is_err(b64_ok_len) || b64_ok_len != 1 { return 18 }
    var pem_bad = pem.decode_blocks_strict("-----BEGIN CERT-----\nTQ== \n-----END CERT-----\n")
    if r.is_err(pem_bad) != true { return 19 }
    var pem_ok = pem.decode_blocks_strict("-----BEGIN CERT-----\nTQ==\n-----END CERT-----")
    if r.is_err(pem_ok) { return 20 }

    // std:strings structured errors
    var bad_len = strings.try_len(123)
    if r.is_err(bad_len) != true { return 21 }
    var ch = strings.try_char_at("hi", 1)
    if r.is_err(ch) || ch != "i" { return 22 }
    var bad_char_ty = strings.try_char_at("hi", "x")
    if r.is_err(bad_char_ty) != true { return 904 }
    var bad_slice = strings.try_slice("hi", 0, 3)
    if r.is_err(bad_slice) != true { return 23 }
    var bad_slice_ty = strings.try_slice("hi", "x", 1)
    if r.is_err(bad_slice_ty) != true { return 905 }

    // std:bytes structured errors
    var b = bytes.from_hex("00ff")
    if r.is_err(b) { return 24 }
    var bl = bytes.try_len(b)
    if r.is_err(bl) || bl != 2 { return 25 }
    var bv = bytes.try_get_u8(b, 1)
    if r.is_err(bv) || bv != 255 { return 26 }
    var bad_b = bytes.try_get_u8(b, 3)
    if r.is_err(bad_b) != true { return 27 }
    var bad_b_ty = bytes.try_get_u8(b, "x")
    if r.is_err(bad_b_ty) != true { return 906 }
    var bad_set = bytes.try_set_u8(b, 0, 300)
    if r.is_err(bad_set) != true { return 28 }
    var bad_set_ty = bytes.try_set_u8(b, "x", 1)
    if r.is_err(bad_set_ty) != true { return 907 }
    var bad_hex = bytes.try_from_hex("zz")
    if r.is_err(bad_hex) != true { return 29 }
    var hex = bytes.try_to_hex(b)
    if r.is_err(hex) || hex != "00ff" { return 30 }

    var pkt = bytes.from_hex("12340102030405060708")
    if r.is_err(pkt) { return 31 }
    var v16 = bytes.try_get_u16_be(pkt, 0)
    if r.is_err(v16) || v16 != 4660 { return 32 }
    var v32 = bytes.try_get_u32_be(pkt, 2)
    if r.is_err(v32) || v32 != 16909060 { return 33 }
    var v64 = bytes.try_get_u64_be(pkt, 2)
    if r.is_err(v64) || v64 != 72623859790382856 { return 34 }
    var bad_u32 = bytes.try_get_u32_be(pkt, 7)
    if r.is_err(bad_u32) != true { return 35 }

    var rc = smoke_buffer_core()
    if rc != 0 { return rc }
    rc = smoke_list_int_slot_ops()
    if rc != 0 { return rc }
    rc = smoke_buffer_matrix_u8()
    if rc != 0 { return rc }
    rc = smoke_buffer_matrix_numeric()
    if rc != 0 { return rc }
    rc = smoke_bytes_tail_and_bridge()
    if rc != 0 { return rc }
    return 0
}
