    var g32 = bytes.try_get_i32_le(buf8, 0)
    if r.is_err(g32) || g32 != -2 { return 63 }
    var bad_put = bytes.try_put_u16_be(buf8, 7, 1)
    if r.is_err(bad_put) != true { return 64 }
    var bad_put_i32 = bytes.try_put_i32_le(buf8, 5, 1)
    if r.is_err(bad_put_i32) != true { return 65 }
    var bad_range = bytes.try_set_u16_be(buf8, 0, 70000)
    if r.is_err(bad_range) != true { return 66 }
    var s64 = bytes.try_set_u64_be(buf8, 0, 72623859790382856)
    if r.is_err(s64) || s64 != 72623859790382856 { return 67 }
    var g64 = bytes.try_get_u64_be(buf8, 0)
    if r.is_err(g64) || g64 != 72623859790382856 { return 68 }
    var p64 = bytes.try_put_u64_le(buf8, 0, 72623859790382856)
    if r.is_err(p64) || p64 != buf8 { return 69 }
    var gp64 = bytes.try_get_u64_le(buf8, 0)
