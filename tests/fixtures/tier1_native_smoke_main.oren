import reflect "../../lib/std/reflect.oren"

// Tier‑1 native smoke / living spec (rolling).
//
// This fixture is intentionally integration-first:
// - one program covers most Tier‑1 semantics
// - it runs on: arm64-macos, arm64-linux (docker), x64-windows (remote), x64-linux (remote wsl)
// - it is also re-run under mode switches to validate deterministic failure contracts.
//
// NOTE: Keep this fast. Avoid large loops; prefer many small deterministic assertions.

// --- Top-level globals + statements (Tier‑1 parity) ---
//
// Validates that `__top_level__` runs before `main` and that global initializers are evaluated.
var TL_G = 40
var TL_H = 1 + 1
var TL_SEEN = 0
TL_SEEN = TL_G + TL_H // 42

// --- Struct constructors (Tier‑1 parity) ---
//
// `struct` constructors must compile and behave consistently across arch/OS.
// x86_64 native synthesizes constructors to match arm64.

struct User { id, name }

struct Pair { a, b }

fn add7(a, b, c, d, e, f, g) {
    return a + b + c + d + e + f + g
}

fn sum1(x, ...rest) {
    var s = x
    var i = 0
    while i < oren_list_len(rest) {
        s = s + rest[i]
        i = i + 1
    }
    return s
}

fn inc(x) { return x + 1 }

fn boom() {
    return 1 / 0
}

fn bool_norm_val(b: bool) {
    return b
}

fn add2(a, b, ...rest) {
    // Returning something avoids unused warnings; the call should abort before this matters.
    return a + b + oren_list_len(rest)
}

fn sum_rec(n) {
    // Non-tail recursion (not eligible for current TCO rewrite rules):
    // return f(n-1) + n
    if n <= 0 { return 0 }
    return sum_rec(n - 1) + n
}

fn map_key_param_i64(k: i64) {
    // Regression (Tier‑1 x64 bring-up):
    //
    // - Numeric type annotations should imply "int kind" for map key-kind inference.
    // - x64 native v0 must accept `oren_trunc_int` inserted by `type_ann_lowering` for `: i64`.
    var m = {}
    m[k] = 123
    return m[k]
}

fn worker_add(a, b) {
    return a + b
}

fn worker_sleep_long() {
    // Intentionally longer than the join timeout budget.
    oren_sleep_ms(5000)
    return 123
}

fn stacktrace_leaf() {
    // Validates Tier‑1 x64 symbolication path:
    // - runtime `stack_trace()` calls `oren_resolve_symbol(pc)` for each frame
    // - x64 native must install the embedded debug-info table so symbols are not "???"
    var fp = get_fp()
    var lr = ptr_get(iadd(fp, 8))
    var nm = oren_resolve_symbol(lr)
    if oren_string_eq(nm, "???") {
        print("tier1 stack trace unresolved pc=" + oren_int_to_string(lr))
        return 79
    }
    stack_trace()
    print("tier1 stack trace ok")
    return 0
}

fn stacktrace_mid() {
    return stacktrace_leaf()
}

fn main() {
    print("tier1 smoke: main entered")
    // Tier‑1: argv must be exposed to the injected runtime on:
    // - Linux x86_64 (SysV entry stack)
    // - Windows x64 (no CRT: entry stub must synthesize argv)
    var argc_dbg = global_get_argc()
    var argv_dbg = global_get_argv()
    print("tier1 smoke: raw argc=" + oren_int_to_string(argc_dbg))
    print("tier1 smoke: raw argv=" + oren_int_to_string(argv_dbg))
    var argv0_ptr = 0
    if argv_dbg != 0 {
        var p0 = ptr_get(argv_dbg + 0)
        argv0_ptr = p0
        print("tier1 smoke: argv0 ptr=" + oren_int_to_string(p0))
        if p0 != 0 {
            var b0 = ptr_get_byte(p0 + 0) & 255
            var b1 = ptr_get_byte(p0 + 1) & 255
            var b2 = ptr_get_byte(p0 + 2) & 255
            var b3 = ptr_get_byte(p0 + 3) & 255
            print("tier1 smoke: argv0 bytes=" + oren_int_to_string(b0) + "," + oren_int_to_string(b1) + "," + oren_int_to_string(b2) + "," + oren_int_to_string(b3))
        }
    }
    var args = oren_args()
    print("tier1 smoke: args returned")
    var n = oren_list_len(args)
    var mode = ""
    if n >= 4 {
        mode = args[3]
    }

    // Mode switches are used by the remote x86_64 gate to validate deterministic-failure
    // contracts using *one* compiled Tier‑1 artifact (fast upload + fast cross-compilation).
    if mode == "MODE_ABORT" {
        // Not enough args to satisfy fixed params (needs 2).
        // x64 native should deterministically abort(1) (checked via remote-run).
        // Use an indirect call so the runtime arity contract is exercised even when
        // the compiler can statically know the callee name.
        //
        // This keeps the abort contract focused (arity mismatch => panic+exit(1))
        // without depending on spread lowering details in this mode.
        var f = add2
        return f(1)
    }
    if mode == "MODE_CALL_DEPTH" {
        // Validate that x64 native entry stubs honor the runtime env override:
        //   OREN_CALL_DEPTH_MAX=<n>
        //
        // Expected behavior:
        // - Default (no env override): returns 0.
        // - With `OREN_CALL_DEPTH_MAX=8`: should deterministically abort(1) via "call depth exceeded".
        //
        // Depth 50 is safe under the default max (8192), but should exceed max=8 quickly.
        var s0 = sum_rec(50)
        // 1..50 sum = 1275; keep a deterministic sanity check.
        if s0 != 1275 { return 101 }
        print("tier1 call depth ok")
        return 0
    }
    if mode == "MODE_MOD0" {
        // Tier-1 modulo contract: `%` must panic with a modulo-specific message,
        // matching the shared runtime helper `oren_mod` (arm64 + x86_64).
        var _ = 1 % 0
        // Unreachable: panic exits(1).
        return 0
    }

    // Runtime init sanity (Tier‑1): the x86_64 entry stub must run the injected native runtime init
    // pipeline before user code, so runtime-global reads are safe.
    print("SIMD_ENABLED=" + oren_int_to_string(native_simd_enabled()))

    // Sanity: printing works (remote-run checks substring).
    print("tier1 smoke ok")
    // Tier‑1 parity: x86_64 native must print non-literal string expressions too.
    var dyn = "dyn ok"
    print("tier1 smoke " + dyn)


    // --- Top-level globals + statements ---
    if TL_G != 40 { return 901 }
    if TL_H != 2 { return 902 }
    if TL_SEEN != 42 { return 903 }

    // --- Type constructors ---
    var u0 = User(7, "alice")
    if u0["id"] != 7 { return 910 }
    if oren_string_eq(u0["name"], "alice") == false { return 911 }
    // First-class constructor values.
    var U = User
    var u1 = U(8, "bob")
    if u1["id"] != 8 { return 912 }
    if oren_string_eq(u1["name"], "bob") == false { return 913 }
    // Another constructor to ensure multi-field order is stable.
    var p0 = Pair(1, 2)
    if p0["a"] != 1 { return 914 }
    if p0["b"] != 2 { return 915 }

    // --- Reflection v0 contract (Tier‑1) ---
    //
    // `oren_type_tag`/`oren_type_name` are the foundation for varargs processing and
    // safe generic code. For native v0, numeric immediates may still be best-effort
    // (`int` vs `float`), but non-numeric kinds must be stable across all Tier‑1 targets.
    var rv_nil = nil
    var rv_bool = true
    var rv_int = 123
    var rv_str = "tier1_ref_str"
    var rv_func = inc
    var rv_list = []
    var rv_map = {"k": 1}
    var rv_u8 = oren_u8_buf_new(0)

    if reflect.tag(rv_nil) != reflect.TAG_NIL { return 960 }
    if reflect.tag(rv_bool) != reflect.TAG_BOOL { return 961 }
    if reflect.tag(rv_int) != reflect.TAG_INT { return 962 }
    if reflect.tag(rv_str) != reflect.TAG_STRING { return 963 }
    if reflect.tag(rv_func) != reflect.TAG_FUNC { return 964 }
    if reflect.tag(rv_list) != reflect.TAG_LIST { return 965 }
    if reflect.tag(rv_map) != reflect.TAG_MAP { return 966 }
    if reflect.tag(rv_u8) != reflect.TAG_U8_BUF { return 967 }

    if oren_string_eq(reflect.name(rv_nil), "nil") == false { return 968 }
    if oren_string_eq(reflect.name(rv_bool), "bool") == false { return 969 }
    if oren_string_eq(reflect.name(rv_int), "int") == false { return 970 }
    if oren_string_eq(reflect.name(rv_str), "string") == false { return 971 }
    if oren_string_eq(reflect.name(rv_func), "func") == false { return 972 }
    if oren_string_eq(reflect.name(rv_list), "list") == false { return 973 }
    if oren_string_eq(reflect.name(rv_map), "map") == false { return 974 }
    if oren_string_eq(reflect.name(rv_u8), "u8_buf") == false { return 975 }

    // Rolling v0: structs are map-shaped (tag==map), but must expose a stable type name
    // via `__oren_type` so user code can dispatch on it.
    if reflect.tag(u0) != reflect.TAG_MAP { return 976 }
    if oren_string_eq(reflect.name(u0), "User") == false { return 977 }

    // --- Runtime tracking APIs (arm64/x64 unified via injected runtime) ---
    //
    // String literals are embedded cstr0 pointers and are intentionally NOT tracked as heap allocations
    // (GC + tracking metadata would be a major startup/GC cost for compiler workloads).
    //
    // Instead, the runtime must recognize them via the startup-built cstr0 membership set:
    // `native_is_string_ptr(lit)` returns true even when `oren_find_node(lit)` is 0.
    var litp0 = "trk_literal_pool"
    var litp1 = "trk_literal_pool"
    // Pointer identity compare (avoid string-aware `==`).
    if (litp0 - litp1) != 0 {
        print("tier1 trk: cstr0 pool did not dedupe identical literals")
        return 919
    }
    if native_is_string_ptr("trk_literal") == 0 { return 920 }
    if oren_find_node("trk_literal") != 0 { return 921 }

    // Small integers must never be treated as heap pointers by the tracking model.
    if oren_find_node(1) != 0 { return 922 }
    if oren_find_node(4095) != 0 { return 923 }

    // `oren_intern_cstr` copies an unowned/untracked C-string into a tracked heap string.
    //
    // IMPORTANT:
    // Passing a cstr0 literal directly returns the literal pointer unchanged (no heap copy),
    // so we use argv0 (platform-provided bytes) as a representative unowned C-string pointer.
    if argv0_ptr == 0 { return 924 }
    var intern0 = oren_intern_cstr(argv0_ptr)
    if intern0 == 0 { return 924 }
    if native_is_string_ptr(intern0) == 0 {
        // Diagnostic breadcrumbs (Tier‑1 x64 windows bring-up):
        // Keep output bounded and only emit on failure.
        print("tier1 trk: intern0 not string ptr=" + oren_int_to_string(intern0))
        // Runtime globals live in injected runtime; they are in the global namespace in native v0.
        print("tier1 trk: alloc_index_cap=" + oren_int_to_string(g_alloc_index_cap))
        var dbg_node0 = oren_find_node(intern0)
        print("tier1 trk: find_node=" + oren_int_to_string(dbg_node0))
        if dbg_node0 != 0 {
            print("tier1 trk: kind=" + oren_int_to_string(ptr_get(dbg_node0 + 16)))
        }
        // Check whether the alloc list contains a node for this ptr (index insert vs list insert).
        var cur0 = global_get_allocs()
        var hit0 = 0
        var steps0 = 0
        while cur0 != 0 && steps0 < 64 {
            if ptr_get(cur0) - intern0 == 0 { hit0 = 1; break }
            cur0 = ptr_get(cur0 + 32)
            steps0 = steps0 + 1
        }
        print("tier1 trk: alloc_list_hit=" + oren_int_to_string(hit0) + " steps=" + oren_int_to_string(steps0))
        // Sample a few alloc nodes to see what *is* tracked (bounded).
        var cur1 = global_get_allocs()
        var j0 = 0
        while cur1 != 0 && j0 < 6 {
            var p0 = ptr_get(cur1)
            var k0 = ptr_get(cur1 + 16)
            print("tier1 trk: alloc[" + oren_int_to_string(j0) + "] ptr=" + oren_int_to_string(p0) + " kind=" + oren_int_to_string(k0))
            cur1 = ptr_get(cur1 + 32)
            j0 = j0 + 1
        }
        return 925
    }
    var node1 = oren_find_node(intern0)
    if node1 == 0 {
        print("tier1 trk: intern0 missing node ptr=" + oren_int_to_string(intern0))
        print("tier1 trk: alloc_index_cap=" + oren_int_to_string(g_alloc_index_cap))
        return 926
    }
    var kind1 = ptr_get(node1 + 16)
    if kind1 != 1 { return 927 }
    // Re-run to ensure the helper remains deterministic and safe (idempotent on pointer identity).
    var intern1 = oren_intern_cstr(argv0_ptr)
    if (intern1 - intern0) != 0 {
        // Diagnostic breadcrumbs (Tier‑1): cache stability regression.
        // Keep output bounded; only emit on failure.
        print("tier1 trk: intern mismatch argv0_ptr=" + oren_int_to_string(argv0_ptr))
        print("tier1 trk: intern0=" + oren_int_to_string(intern0))
        print("tier1 trk: intern1=" + oren_int_to_string(intern1))
        print("tier1 trk: argv0 is_string=" + oren_int_to_string(native_is_string_ptr(argv0_ptr)))
        print("tier1 trk: intern1 is_string=" + oren_int_to_string(native_is_string_ptr(intern1)))
        print("tier1 trk: intern1 node=" + oren_int_to_string(oren_find_node(intern1)))
        // Directly query the cache map to see whether it contains the entry.
        print("tier1 trk: cache_map=" + oren_int_to_string(g_intern_cstr_cache))
        if g_intern_cstr_cache != 0 {
            print("tier1 trk: cache_len=" + oren_int_to_string(oren_map_len(g_intern_cstr_cache)))
            var cached_dbg = oren_map_get_int(g_intern_cstr_cache, argv0_ptr)
            print("tier1 trk: cache_get=" + oren_int_to_string(cached_dbg))
            print("tier1 trk: cache_get_is_nil=" + oren_int_to_string(native_value_is_nil(cached_dbg)))
        }
        return 928
    }

    // --- String ops (extra coverage; keep fast) ---
    if oren_string_len("abc") != 3 { return 930 }
    var ch = oren_string_char_at("abc", 1)
    var bch = ptr_get_byte(ch) & 255
    if bch != 98 { return 931 } // 'b'
    var cc = oren_char(65)
    var bcc = ptr_get_byte(cc) & 255
    if bcc != 65 { return 932 } // 'A'
    if oren_string_eq("ab", "ab") == false { return 933 }
    if oren_string_eq("ab", "ac") == true { return 934 }

    // Language-level string compare lowering (must be content-based, not pointer-compare).
    var ab_lt_ac = "ab" < "ac"
    if ab_lt_ac != true { return 935 }
    var ab_le_ab = "ab" <= "ab"
    if ab_le_ab != true { return 936 }
    var ab_gt_ac = "ab" > "ac"
    if ab_gt_ac != false { return 937 }
    var ab_ge_ac = "ab" >= "ac"
    if ab_ge_ac != false { return 938 }

    // --- Control flow: break/continue and bit ops ---
    var w = 0
    var t = 0
    while w < 10 {
        w = w + 1
        var odd = w & 1
        if odd == 0 { continue }
        t = t + w
        if w >= 7 { break }
    }
    if t != 16 { return 940 }

    // Calls across reg+stack args.
    if add7(1, 2, 3, 4, 5, 6, 7) != 28 { return 10 }

    // Varargs + spread semantics.
    var xs = [2, 3]
    if sum1(1, xs...) != 6 { return 20 }

    // Local `fn name(...) { ... }` declaration sugar (Tier‑1 parity):
    // inside blocks, `fn name(...) { ... }` lowers to `var name = fn (...) { ... }`.
    //
    // This is important for arch unification: nested functions must compile via the
    // uniform callable ABI (lambda wrappers), not via backend-specific hacks.
    var cap2 = 7
    fn add_local(a, b) { return a + b + cap2 }
    cap2 = 999
    if add_local(1, 2) != 10 { return 21 }
    fn count_local(x, ...rest) { return x + oren_list_len(rest) }
    if count_local(10) != 10 { return 22 }
    if count_local(10, 1, 2, 3) != 13 { return 23 }
    print("tier1 local fn ok")

    // List ops + index.
    var ys = [1]
    oren_list_push(ys, 2)
    if ys[1] != 2 { return 30 }

    // for-in (iterator contract).
    var s = 0
    for v in ys { s = s + v }
    if s != 3 { return 40 }

    // Tier‑1 requirement: atomic intrinsics must behave identically on:
    // - Linux x86_64 SysV
    // - Windows x64
    //
    // Contract:
    // - atomic_add(ptr, v) returns the old value and stores old+v
    // - atomic_cas(ptr, expected, new) returns the old value and stores new iff old==expected
    var p = malloc(8)
    if p == 0 { return 41 }
    if p == -1 { return 41 }
    ptr_set(p, 10)
    var old = atomic_add(p, 5)
    if old != 10 { return 42 }
    if ptr_get(p) != 15 { return 43 }
    var cas0 = atomic_cas(p, 15, 20)
    if cas0 != 15 { return 44 }
    if ptr_get(p) != 20 { return 45 }
    var cas1 = atomic_cas(p, 999, 30)
    if cas1 != 20 { return 46 }
    if ptr_get(p) != 20 { return 47 }
    print("tier1 atomics ok")

    // Tier‑1 requirement: typed buffers are the HPC foundation and must work
    // identically on:
    // - Linux x86_64 SysV
    // - Windows x64
    //
    // This fixture intentionally exercises:
    // - alloc/new
    // - store/load
    // - float32 boundary via f32 bitcasts
    // - buffer views + for-in iteration contract
    //
    // --- i32 ---
    var bi = oren_i32_buf_new(4)
    if oren_buf_len(bi) != 4 { return 48 }
    oren_buf_store_i32(bi, 0, 7)
    oren_buf_store_i32(bi, 1, -3)
    oren_buf_store_i32(bi, 2, 123456)
    oren_buf_store_i32(bi, 3, -123456)
    if oren_buf_load_i32(bi, 0) != 7 { return 49 }
    if oren_buf_load_i32(bi, 1) != -3 { return 50 }
    if oren_buf_load_i32(bi, 2) != 123456 { return 51 }
    if oren_buf_load_i32(bi, 3) != -123456 { return 52 }
    var sum = 0
    var i = 0
    while i < oren_buf_len(bi) {
        sum = sum + oren_buf_load_i32(bi, i)
        i = i + 1
    }
    if sum != 7 + (-3) + 123456 + (-123456) { return 53 }

    // --- u8 ---
    var bu = oren_u8_buf_new(3)
    oren_buf_store_u8(bu, 0, 0)
    oren_buf_store_u8(bu, 1, 255)
    oren_buf_store_u8(bu, 2, 128)
    if oren_buf_load_u8(bu, 0) != 0 { return 54 }
    if oren_buf_load_u8(bu, 1) != 255 { return 55 }
    if oren_buf_load_u8(bu, 2) != 128 { return 56 }

    // --- f32 ---
    var bf32 = oren_f32_buf_new(2)
    var v0 = 1.5
    var v1 = -2.25
    oren_buf_store_f32(bf32, 0, v0)
    oren_buf_store_f32(bf32, 1, v1)
    var r0 = oren_buf_load_f32(bf32, 0)
    var r1 = oren_buf_load_f32(bf32, 1)
    if oren_f32_to_u32_bits(r0) != 1069547520 { return 57 } // 0x3fc00000
    if oren_f32_to_u32_bits(r1) != 3222274048 { return 58 } // 0xc0100000

    // --- f64 ---
    var bf64 = oren_f64_buf_new(1)
    oren_buf_store_f64(bf64, 0, 1.0)
    var r64 = oren_buf_load_f64(bf64, 0)
    if oren_f64_to_u64_bits(r64) != 4607182418800017408 { return 59 } // 0x3ff0000000000000

    print("tier1 typed buffers ok")

    // Direct iteration over a typed buffer (BUF) + views.
    var b = oren_i32_buf_new(6)
    var ii = 0
    while ii < 6 {
        oren_buf_store_i32(b, ii, (ii + 1) * 10)
        ii = ii + 1
    }
    var s1 = 0
    for x in b { s1 = s1 + x }
    if s1 != 210 { return 60 }

    // View iteration: [buf, off, len]
    var view = [b, 2, 3]
    var s2 = 0
    for x2 in view { s2 = s2 + x2 }
    if s2 != 120 { return 61 }

    // Strided view iteration: [buf, off, len, stride]
    var view2 = [b, 1, 3, 2]
    var s3 = 0
    var expect = [20, 40, 60]
    var j = 0
    for x3 in view2 {
        if j >= 3 { return 62 }
        if x3 != expect[j] { return 63 }
        s3 = s3 + x3
        j = j + 1
    }
    if j != 3 { return 64 }
    if s3 != 120 { return 65 }

    // U8 buffer iteration yields 0..255 ints.
    var bu2 = oren_u8_buf_new(3)
    oren_buf_store_u8(bu2, 0, 65)
    oren_buf_store_u8(bu2, 1, 66)
    oren_buf_store_u8(bu2, 2, 67)
    var s4 = 0
    for ch in bu2 { s4 = s4 + ch }
    if s4 != 198 { return 66 }
    print("tier1 forin typed buffers ok")

    // Map ops + index assignment/get with literal keys (including int >= 4096).
    print("tier1 map begin")
    var m = {"a": 7}
    print("tier1 map literal ok")
    m["b"] = 8
    print("tier1 map set b ok")
    if m["a"] != 7 { return 50 }
    if m["b"] != 8 { return 51 }
    print("tier1 map get literal ok")
    m[50000] = 9
    print("tier1 map set int ok")
    if m[50000] != 9 { return 52 }
    // Map ops with *non-literal* keys (x64 Tier‑1 must not rely on `key < 4096` heuristics).
    var k = 50000
    m[k] = 10
    print("tier1 map set dyn int ok")
    if m[k] != 10 { return 53 }
    var ks = "c"
    m[ks] = 11
    print("tier1 map set dyn str ok")
    if m[ks] != 11 { return 54 }
    if map_key_param_i64(50000) != 123 { return 55 }
    print("tier1 map ok")

    // First-class function values + indirect call.
    print("tier1 fnval begin")
    var f = inc
    if f(4) != 5 { return 60 }
    print("tier1 fnval fixed ok")

    // First-class function values for varargs functions:
    // - indirect call must route through the uniform-call wrapper and preserve varargs packing.
    var g = sum1
    if g(1, 2, 3) != 6 { return 61 }
    print("tier1 fnval varargs ok")

    // Lambdas as values (capture-free).
    print("tier1 lambda begin")
    var h = |x| x + 2
    if h(3) != 5 { return 62 }

    // Lambdas with captures (capture-by-value).
    var z = 40
    var addz = |x| x + z
    z = 100
    if addz(2) != 42 { return 63 }
    print("tier1 lambda ok")

    // Bool annotation lowering (`: bool`) must normalize to 0/1 deterministically.
    if bool_norm_val(0) != 0 { return 64 }
    if bool_norm_val(2) != 1 { return 65 }

    // Truthiness guardrail (Tier‑1 parity):
    // - only `nil` and `false` are falsey
    // - numeric `0` is truthy
    var truth_seen = 0
    var truth_x0 = 0
    if truth_x0 { truth_seen = 1 } else { truth_seen = 2 }
    if truth_seen != 1 {
        print("tier1 truthiness: int 0 should be truthy")
        return 67
    }
    var truth_xnil = nil
    truth_seen = 0
    if truth_xnil { truth_seen = 1 } else { truth_seen = 2 }
    if truth_seen != 2 {
        print("tier1 truthiness: nil should be falsey")
        return 68
    }
    var truth_xfalse = false
    truth_seen = 0
    if truth_xfalse { truth_seen = 1 } else { truth_seen = 2 }
    if truth_seen != 2 {
        print("tier1 truthiness: false should be falsey")
        return 69
    }

    // Short-circuit sanity (must not evaluate RHS when unnecessary).
    // Tier‑1: boolean short-circuiting should prevent evaluating RHS when LHS is `false`.
    // Do not use numeric `0` here: under native backend, booleans are runtime singletons (`false`/`true`),
    // and only `nil`/`false` are falsey (numeric 0 is truthy).
    if false && boom() != 0 { return 70 }

    // Tier‑1: language-level spawn/join must work on Windows (thread-based) and Linux (POSIX).
    // Spawn a lambda with capture-by-value.
    print("tier1 spawn begin")
    print("tier1 lock before spawn owner=" + oren_int_to_string(global_get_lock()) + " count=" + oren_int_to_string(global_get_lock_count()))
    var base = 10
    var f2 = |y| base + y
    base = 999
    var h1 = spawn f2(5)
    print("tier1 spawn h1 ok")
    print("tier1 lock after spawn owner=" + oren_int_to_string(global_get_lock()) + " count=" + oren_int_to_string(global_get_lock_count()))
    var r1 = oren_join(h1)
    print("tier1 join h1 ok")
    if r1 != 15 { return 71 }

    // Spawn a named function (direct call lowered through callable ABI).
    var h2 = spawn worker_add(40, 2)
    print("tier1 spawn h2 ok")
    var r2 = oren_join(h2)
    print("tier1 join h2 ok")
    if r2 != 42 { return 72 }

    // Join timeout contract (rolling): should deterministically return -ETIMEDOUT (BSD 60).
    var h3 = spawn worker_sleep_long()
    print("tier1 spawn h3 ok")
    var r3 = oren_join_timeout(h3, 20)
    if r3 != 0 - 60 {
        print("tier1 join_timeout unexpected r3=" + oren_int_to_string(r3))
        return 73
    }
    print("tier1 spawn join ok")

    // Contract: when args are provided, validate them; otherwise skip.
    print("ARGS_LEN=" + oren_int_to_string(n))
    if n >= 3 {
        if oren_string_eq(args[1], "ARG_A") == false { return 74 }
        if oren_string_eq(args[2], "ARG_B") == false { return 75 }
        print("tier1 args ok")
    }

    // Tier‑1 stack traces: exercise symbolication without forcing a crash.
    if stacktrace_mid() != 0 { return 76 }

    // PROC substrate smoke (Tier‑1):
    // - ensures `oren_system` and the Windows CreateProcess path are wired correctly
    // - keeps the smoke program OS-neutral (`oren_system` should work on Windows + Linux)
    var rc = oren_system("echo tier1 smoke proc ok")
    print("tier1 proc system rc=" + oren_int_to_string(rc))
    if rc != 0 { return 80 }
    print("tier1 proc ok")

    return 0
}
