// x64-native fixture (Tier-1 bring-up):
// - validates stdlib-style namespace calls work on x64:
//     import list "std:list"
//     list.push(xs, v)
//     list.len(xs)
//
// Run on real x86_64 hosts (Win11 + WSL2) via:
//   ./scripts/verify_native_matrix.sh --targets x64-win-tier1 --tier1-src tests/fixtures/x64_std_list_namespace_main.oren
//   ./scripts/verify_native_matrix.sh --targets x64-wsl-tier1 --tier1-src tests/fixtures/x64_std_list_namespace_main.oren

import list "std:list"

fn main() {
    var xs = []
    list.push(xs, 7)
    list.push(xs, 8)
    list.push(xs, 9)

    if list.len(xs) != 3 { return 1 }
    if xs[0] != 7 { return 2 }
    if xs[2] != 9 { return 3 }

    return 0
}
