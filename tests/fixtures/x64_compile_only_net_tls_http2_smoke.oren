// x64 compile-only smoke for the native NET/TLS/HTTP2 stack.
//
// Purpose:
// - Provide a single source file that forces module resolution + typechecking of:
//   - std:net/tls
//   - std:net/http
//   - std:net/http2
//   - std:net/hpack
//   - std:net/http2_client
//   - std:net/ws
//
// This fixture is intentionally *not* executed by the x64 compile-only gate; it only
// needs to compile for x64-linux and x64-windows under both stage1 and stage2.
//
// Why:
// - Remote Win11/WSL2 execution can be intermittently blocked by connectivity.
// - We still want a fast local regression guard that these modules remain buildable on x86_64.

import tcp "std:net/tcp"
import dns "std:net/dns"
import tls "std:net/tls"
import ctls "std:crypto/tls"
import tls_linux "std:net/tls_linux_openssl"
import tls_macos "std:net/tls_macos_securetransport"
import tls_win "std:net/tls_windows_schannel"
import http "std:net/http"
import h2 "std:net/http2"
import hpack "std:net/hpack"
import h2c "std:net/http2_client"
import ws "std:net/ws"
import rand "std:crypto/rand"
import pem "std:crypto/pem"

@cfg(os="linux")
fn _provider_try_refs(fd, conn) {
    var _pc = tls_linux.try_wrap_client(fd, "oren.test", 1, {"insecure_skip_verify": 1})
    var _ps = tls_linux.try_wrap_server_pkcs12(fd, 1, 0, "", {})
    var _pr = tls_linux.try_read_into(conn, 0, 0, 1)
    var _pw = tls_linux.try_write_from(conn, 0, 0, 1)
    var _pp = tls_linux.try_peer_cert_sha256_hex(conn)
    var _pa = tls_linux.try_negotiated_alpn(conn)
    var _px = tls_linux.try_close(conn)
    return 0
}

@cfg(os="macos")
fn _provider_try_refs(fd, conn) {
    var _pc = tls_macos.try_wrap_client(fd, "oren.test", 1, {"insecure_skip_verify": 1})
    var _ps = tls_macos.try_wrap_server_pkcs12(fd, 1, 0, "", {})
    var _pr = tls_macos.try_read_into(conn, 0, 0, 1)
    var _pw = tls_macos.try_write_from(conn, 0, 0, 1)
    var _pp = tls_macos.try_peer_cert_sha256_hex(conn)
    var _pa = tls_macos.try_negotiated_alpn(conn)
    var _px = tls_macos.try_close(conn)
    return 0
}

@cfg(os="windows")
fn _provider_try_refs(fd, conn) {
    var _pc = tls_win.try_wrap_client(fd, "oren.test", 1, {"insecure_skip_verify": 1})
    var _ps = tls_win.try_wrap_server_pkcs12(fd, 1, 0, "", {})
    var _pr = tls_win.try_read_into(conn, 0, 0, 1)
    var _pw = tls_win.try_write_from(conn, 0, 0, 1)
    var _pp = tls_win.try_peer_cert_sha256_hex(conn)
    var _pa = tls_win.try_negotiated_alpn(conn)
    var _px = tls_win.try_close(conn)
    return 0
}

@cfg(not_os="macos,linux,windows")
fn _provider_try_refs(fd, conn) {
    return 0
}

fn main() {
    // Keep runtime behavior trivial. The x64 compile-only gate does not run this program.
    //
    // We still reference a representative set of symbols in a dead branch so:
    // - the parser resolves imports,
    // - typechecking covers key APIs,
    // - codegen has to include these modules in the compilation unit.
    if 0 == 1 {
        // TCP symbol reference (link surface).
        var fd = tcp.connect("127.0.0.1", 443, 1)

        // DNS default resolver (Win11 uses iphlpapi; POSIX uses /etc/resolv.conf).
        // This stays in a dead branch so the compile-only gate can typecheck the surface
        // without requiring host filesystem state.
        var _dr = dns.default_resolver(1)

        // TLS symbol reference (type surface).
        var cr = tls.wrap_client(fd, "oren.test", 1, {"insecure_skip_verify": 1, "alpn": ["h2", "http/1.1"]})
        var _try_conn = tls.try_connect("127.0.0.1", 443, 1, {"insecure_skip_verify": 1, "alpn": ["h2", "http/1.1"]})
        var _try_conn_alpn = _try_conn.negotiated_alpn()
        var ok = oren_map_get_str(cr, "ok")
        if ok == 1 {
            var conn = oren_map_get_str(cr, "conn")
            var _al = tls.negotiated_alpn(conn)
            var _try_al = tls.negotiated_alpn(conn)
            // Crypto-facing TLS facade path (should remain a stable import; currently an alias layer).
            var _cr2 = ctls.wrap_client(fd, "oren.test", 1, {"insecure_skip_verify": 1, "alpn": ["h2", "http/1.1"]})
            var _tcr2 = ctls.try_wrap_client(fd, "oren.test", 1, {"insecure_skip_verify": 1, "alpn": ["h2", "http/1.1"]})
            var _tcr2_alpn = _tcr2.negotiated_alpn()
            var _ptr = _provider_try_refs(fd, conn)

            // HTTP/1.1 surface (TLS-backed request/response helper).
            // Note: we do not actually dial; this is just a type/symbol coverage hook.
            var _rr = http.get_opts("https://127.0.0.1/", 1, {"tls": {"insecure_skip_verify": 1}})
            http.response_free(_rr)

            // WSS surface (WebSocket over TLS).
            var _wr = ws.connect_resolver_opts("wss://127.0.0.1/", 1, 0, {"tls": {"insecure_skip_verify": 1}})
            var _wpu = ws.try_parse_url("wss://127.0.0.1/")
            var _wk = ws.try_client_key_base64()

            // Client wrapper surface (http2_client).
            var _c = h2c.new(conn, 1, {"settings": [[h2.SETTINGS_ENABLE_PUSH, 0]]})
            var _tc = h2c.try_new(conn, 1, {"settings": [[h2.SETTINGS_ENABLE_PUSH, 0]]})
            var _tc_state = _tc.raw_state()
            var _tc_resp = _tc.request([
                {"name": ":method", "value": "GET"},
                {"name": ":scheme", "value": "https"},
                {"name": ":path", "value": "/"},
                {"name": ":authority", "value": "oren.test"}
            ], nil, {})
            var _tc_resp_text = _tc_resp.text()
        }

        // HTTP/2 framing surface.
        var hdr = malloc(16)
        var _fh = h2.parse_frame_header(hdr)
        var _tfh = h2.try_parse_frame_header(hdr)
        var _wr = h2.write_frame_header(hdr, 0, h2.FRAME_SETTINGS, 0, 0)
        var _twr = h2.try_write_frame_header(hdr, 0, h2.FRAME_SETTINGS, 0, 0)
        var _pref = h2.CLIENT_PREFACE
        var _plen = h2.CLIENT_PREFACE_LEN

        // HPACK encode/decode surface.
        var t = hpack.table_new(4096)
        var hb = hpack.encode_header_block(t, [
            {"name": ":method", "value": "GET"},
            {"name": ":path", "value": "/"}
        ], {"huffman": 0})
        var _dr = hpack.decode_header_block(t, hb)

        // Crypto helpers (host effects) - keep these behind a dead branch; we only want buildability.
        var _rb = rand.try_bytes(16)
        var _pem = pem.try_decode_blocks("-----BEGIN CERTIFICATE-----\\nZm9v\\n-----END CERTIFICATE-----\\n")

        // (http2_client symbols referenced above)
    }
    exit(0)
}
