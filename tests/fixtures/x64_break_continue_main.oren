// Minimal x64-native fixture (rolling bring-up):
// - exercises `break` and `continue` inside `while`
// Expected logic:
//   x: 1..4 (break at 4), skip y++ at x==2
//   => y = 3

fn main() {
    var x = 0
    var y = 0
    while x != 5 {
        x = x + 1
        if x == 2 {
            continue
        }
        y = y + 1
        if x == 4 {
            break
        }
    }
    return y
}

