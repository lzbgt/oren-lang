// x64-native fixture (Tier-1 bring-up):
// - exercises list intrinsics (oren_new_list / oren_list_push / len / get / set)
// - triggers grow path (cap=0 then push many)
//
// Run on real x86_64 hosts (Win11 + WSL2) via:
//   ./scripts/verify_native_matrix.sh --targets x64-win-tier1 --tier1-src tests/fixtures/x64_list_ops_main.oren
//   ./scripts/verify_native_matrix.sh --targets x64-wsl-tier1 --tier1-src tests/fixtures/x64_list_ops_main.oren

fn main() {
    var xs = oren_new_list(0)

    var i = 0
    while i < 10 {
        oren_list_push(xs, i)
        i = i + 1
    }

    if oren_list_len(xs) != 10 { return 1 }
    if xs[5] != 5 { return 2 }

    xs[5] = 99
    if xs[5] != 99 { return 3 }

    return 0
}
