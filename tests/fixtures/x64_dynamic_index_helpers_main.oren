// x64-native fixture (Tier-1 bring-up):
// - forces parameter-local unknown receiver/key kinds for dynamic index get/set
// - covers generic `oren_index_get` / `oren_index_set` lowering without running target binaries

fn dyn_get(container, key) {
    return container[key]
}

fn dyn_set(container, key, value) {
    container[key] = value
    return container[key]
}

fn main() {
    var m = {"a": 1}
    var xs = []
    xs[0] = 3

    if dyn_get(m, "a") != 1 { return 1 }
    if dyn_set(m, "b", 2) != 2 { return 2 }
    if dyn_get(xs, 0) != 3 { return 3 }
    if dyn_set(xs, 1, 4) != 4 { return 4 }
    return 0
}
