// x64-native fixture (Tier-1 bring-up):
// - validates nested calls used as call arguments are correct
// - guards against clobbering when arg spilling is not re-entrant
//
// Run on real x86_64 hosts (Win11 + WSL2) via:
//   ./scripts/verify_native_matrix.sh --targets x64-win-tier1 --tier1-src tests/fixtures/x64_nested_call_args_main.oren
//   ./scripts/verify_native_matrix.sh --targets x64-wsl-tier1 --tier1-src tests/fixtures/x64_nested_call_args_main.oren

fn add2(a, b) { return a + b }

fn main() {
    // add2(3, 7) => 10, but both args are computed via nested calls.
    return add2(add2(1, 2), add2(3, 4))
}
