// Expected to fail under: `./oren build ...`
//
// Rationale:
// - The nil-compare guard is always-on (even without `--typecheck`).
// - A common footgun is treating `== nil` as “missing” and then using the value
//   as a scalar later (native backend historically aliases `0`/`nil` in some paths).
//
// This is the same pattern as `nil_guard_bad_late_scalar_nil_compare.oren`, but at
// top-level (no `fn main()`), so we also cover the synthesized `__top_level__` path.
var cfg = {"timeout_ms": 0}
var t = cfg["timeout_ms"]
if t == nil { exit(0) }
var u = i64(t) + 1
if u > 0 { exit(0) }
exit(1)
