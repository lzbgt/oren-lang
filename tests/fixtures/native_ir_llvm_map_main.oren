// Native IR LLVM map descriptor smoke:
// - proves empty and non-empty Hash literals lower into runtime-owned map descriptors
// - proves semantic descriptor-backed string-key set/get and map length
// - proves nested map descriptors survive helper safepoints and forced GC
// - proves struct records lower through map-shaped constructor/member semantics

struct RecordBox { name, payload }

fn main() {
    var literal = {"first": 31, "second": 37}
    if oren_map_len(literal) != 2 { return 20 }
    if literal["first"] != 31 { return 21 }
    if literal["second"] != 37 { return 22 }
    literal["first"] = 41
    if oren_map_len(literal) != 2 { return 23 }
    if literal["first"] != 41 { return 24 }
    var dyn_name = oren_string_slice("xrecordy", 1, 7)
    var box = RecordBox(dyn_name, literal)
    if oren_string_eq(box.name, "record") != true { return 25 }
    var literal_payload = box.payload
    if literal_payload["second"] != 37 { return 26 }

    var m = {}
    m["alpha"] = 7
    m["beta"] = 11
    if oren_map_len(m) != 2 { return 1 }
    if m["alpha"] != 7 { return 2 }
    if m["beta"] != 11 { return 3 }
    m["alpha"] = 13
    if oren_map_len(m) != 2 { return 4 }
    if m["alpha"] != 13 { return 5 }
    if m["beta"] != 11 { return 6 }
    var alpha2 = oren_string_slice("zalphaq", 1, 6)
    if oren_string_eq(alpha2, "alpha") != true { return 7 }
    if m[alpha2] != 13 { return 8 }
    m[alpha2] = 17
    if oren_map_len(m) != 2 { return 9 }
    if m["alpha"] != 17 { return 10 }
    box.payload = m
    var swapped_payload = box.payload
    if swapped_payload["alpha"] != 17 { return 27 }

    var parent_list = [m]
    if oren_string_len("gc") != 2 { return 11 }
    var from_list = parent_list[0]
    if from_list["alpha"] != 17 { return 12 }

    var holder = {}
    holder["child"] = {}
    holder["child"]["nested"] = 23
    if oren_string_len("gc") != 2 { return 13 }
    var from_map = holder["child"]
    if from_map["nested"] != 23 { return 14 }
    return 0
}
