// x86_64 native backend fixture (rolling bring-up):
// - exercises int division `/` and modulo `%` (trunc toward zero)

fn main() {
    var a = 7
    // Keep the divisor non-trivial so the x64 backend exercises its divisor-eval path.
    var b = 1 + 2 // 3
    var q = a / b   // 2
    var r = a % b   // 1
    return q + r + 10 // 13
}
