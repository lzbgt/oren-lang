// x64-native fixture (Tier-1 bring-up):
// - exercises syscall-first bump allocator (`malloc`)
// - exercises pointer load/store intrinsics (`ptr_get`, `ptr_set`, byte variants)
//
// Run on real x86_64 hosts (Win11 + WSL2) via:
//   ./scripts/verify_native_matrix.sh --targets x64-win-tier1 --tier1-src tests/fixtures/x64_malloc_ptr_main.oren
//   ./scripts/verify_native_matrix.sh --targets x64-wsl-tier1 --tier1-src tests/fixtures/x64_malloc_ptr_main.oren

fn main() {
    // Allocate 16 bytes and treat it as two u64 slots.
    var p = malloc(16)
    if p == 0 { return 99 }

    ptr_set(p, 41)
    ptr_set(iadd(p, 8), 1)

    var a = ptr_get(p)
    var b = ptr_get(iadd(p, 8))
    if a != 41 { return 1 }
    if b != 1 { return 2 }

    // Byte store/load should be 0..255 (zero-extended on load).
    ptr_set_byte(iadd(p, 8), 255)
    var c = ptr_get_byte(iadd(p, 8))
    if c != 255 { return 3 }

    return 0
}
