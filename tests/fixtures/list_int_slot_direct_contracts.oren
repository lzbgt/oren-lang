import list "std:list"

fn _make_list(vals) {
    var xs = list.int_new(oren_list_len(vals))
    if oren_is_err(xs) { return xs }
    var i = 0
    while i < oren_list_len(vals) {
        list.int_push(xs, vals[i])
        i = i + 1
    }
    return xs
}

fn _print_err(v, code) {
    if oren_is_err(v) != true { return code }
    print(oren_int_to_string(oren_err_code(v)) + ":" + oren_err_msg(v))
    return 0
}

fn main() {
    var args = oren_args()
    var mode = ""
    if oren_list_len(args) >= 2 {
        mode = args[1]
    }

    var xs = _make_list([1, 2, 3, 4])
    if oren_is_err(xs) { return 10 }
    var ys = _make_list([5, 6, 7, 8])
    if oren_is_err(ys) { return 11 }

    if mode == "MODE_DOT_LEFT_NIL" {
        print(oren_int_to_string(oren_list_int_dot_slots_unchecked(nil, ys)))
        return 91
    }
    if mode == "MODE_DOT_RIGHT_NIL" {
        print(oren_int_to_string(oren_list_int_dot_slots_unchecked(xs, nil)))
        return 92
    }
    if mode == "MODE_DOT_LEN_MISMATCH" {
        var short = _make_list([5, 6, 7])
        if oren_is_err(short) { return 12 }
        print(oren_int_to_string(oren_list_int_dot_slots_unchecked(xs, short)))
        return 93
    }
    if mode == "MODE_CHECKED_SUM_NON_LIST" {
        return _print_err(oren_list_int_reduce_sum_slots([1, "x"]), 94)
    }
    if mode == "MODE_CHECKED_DOT_LEFT_NIL" {
        return _print_err(oren_list_int_dot_slots(nil, ys), 95)
    }
    if mode == "MODE_CHECKED_DOT_NON_LIST" {
        return _print_err(oren_list_int_dot_slots([1, "x"], ys), 96)
    }
    if mode == "MODE_CHECKED_DOT_LEN_MISMATCH" {
        var short_checked = _make_list([5, 6, 7])
        if oren_is_err(short_checked) { return 13 }
        return _print_err(oren_list_int_dot_slots(xs, short_checked), 97)
    }

    if oren_list_int_reduce_sum_slots(nil) != 0 { return 20 }
    if oren_list_int_reduce_sum_slots_unchecked(nil) != 0 { return 21 }
    if oren_list_int_dot_slots(nil, nil) != 0 { return 22 }
    if oren_list_int_dot_slots_unchecked(nil, nil) != 0 { return 23 }
    if oren_list_int_reduce_sum_slots(xs) != 10 { return 24 }
    if oren_list_int_reduce_sum_slots_unchecked(xs) != 10 { return 25 }
    if oren_list_int_dot_slots(xs, ys) != 70 { return 26 }
    if oren_list_int_dot_slots_unchecked(xs, ys) != 70 { return 27 }
    if oren_list_int_reduce_sum_slots_try_fast(nil) != 0 { return 28 }
    if oren_list_int_reduce_sum_slots_try_fast(xs) != 10 { return 29 }
    if oren_list_int_reduce_sum_slots_try_fast([1, "x"]) != nil { return 30 }
    if oren_list_int_dot_slots_try_fast(nil, nil) != 0 { return 31 }
    if oren_list_int_dot_slots_try_fast(xs, ys) != 70 { return 32 }
    if oren_list_int_dot_slots_try_fast(xs, nil) != nil { return 33 }
    if oren_list_int_dot_slots_try_fast([1, "x"], ys) != nil { return 34 }
    var short_try = _make_list([5, 6, 7])
    if oren_is_err(short_try) { return 35 }
    if oren_is_err(oren_list_int_dot_slots_try_fast(xs, short_try)) != true { return 36 }
    print("ok: list_int_slot_direct_contracts")
    return 0
}
