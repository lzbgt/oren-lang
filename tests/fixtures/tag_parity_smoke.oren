import buffer "std:buffer"

fn emit(label, v) {
    print(label + ":" + oren_int_to_string(oren_type_tag(v)) + ":" + oren_type_name(v))
}

fn id(x) { return x }
fn id2(x) { return x }

fn assert_tag_eq(label, got, want) {
    if got == want { return 0 }
    print("tag_parity: " + label + " expected_tag=" + oren_int_to_string(want) +
          " got_tag=" + oren_int_to_string(got))
    exit(3)
}

fn assert_str_eq(label, got, want) {
    if oren_string_eq(got, want) == true { return 0 }
    print("tag_parity: " + label + " expected=" + want + " got=" + got)
    exit(2)
}

fn assert_true(label, cond) {
    if cond { return 0 }
    print("tag_parity: " + label + " expected true")
    exit(4)
}

fn assert_false(label, cond) {
    if cond { 
        print("tag_parity: " + label + " expected false")
        exit(5)
    }
    return 0
}

fn main() {
    var xs = [1, 2]
    var xs_int = oren_new_list_int(0)
    oren_list_int_push(xs_int, 1)
    var m = {"k": 1}
    var tm = {"__oren_type": "Widget", "v": 7}
    var b = buffer.u8_new(4)
    var b32 = buffer.i32_new(2)
    var b64 = buffer.i64_new(2)
    var bf32 = buffer.f32_new(2)
    var bf64 = buffer.f64_new(2)
    var f = id
    var empty_list = []
    var empty_map = {}
    var empty_str = ""

    print("ok: tag parity")
    emit("nil", nil)
    emit("true", true)
    emit("false", false)
    emit("int", 1)
    emit("string", "hi")
    emit("list", xs)
    emit("list_int", xs_int)
    emit("map", m)
    emit("type_map", tm)
    emit("func", f)
    emit("u8_buf", b)
    emit("i32_buf", b32)
    emit("i64_buf", b64)
    emit("f32_buf", bf32)
    emit("f64_buf", bf64)

    assert_tag_eq("nil", oren_type_tag(nil), 0)
    assert_tag_eq("bool_true", oren_type_tag(true), 3)
    assert_tag_eq("bool_false", oren_type_tag(false), 3)
    assert_tag_eq("int", oren_type_tag(1), 1)
    assert_tag_eq("string", oren_type_tag("hi"), 4)
    assert_tag_eq("list", oren_type_tag(xs), 6)
    assert_tag_eq("list_int", oren_type_tag(xs_int), 6)
    assert_tag_eq("map", oren_type_tag(m), 7)
    assert_tag_eq("func", oren_type_tag(f), 8)
    assert_tag_eq("u8_buf", oren_type_tag(b), 9)
    assert_tag_eq("i32_buf", oren_type_tag(b32), 10)
    assert_tag_eq("i64_buf", oren_type_tag(b64), 11)
    assert_tag_eq("f32_buf", oren_type_tag(bf32), 12)
    assert_tag_eq("f64_buf", oren_type_tag(bf64), 13)

    assert_str_eq("nil", oren_type_name(nil), "nil")
    assert_str_eq("bool_true", oren_type_name(true), "bool")
    assert_str_eq("bool_false", oren_type_name(false), "bool")
    assert_str_eq("int", oren_type_name(1), "int")
    assert_str_eq("string", oren_type_name("hi"), "string")
    assert_str_eq("list", oren_type_name(xs), "list")
    assert_str_eq("list_int", oren_type_name(xs_int), "list")
    assert_str_eq("map", oren_type_name(m), "map")
    assert_str_eq("type_map", oren_type_name(tm), "Widget")
    assert_str_eq("func", oren_type_name(f), "func")
    assert_str_eq("u8_buf", oren_type_name(b), "u8_buf")
    assert_str_eq("i32_buf", oren_type_name(b32), "i32_buf")
    assert_str_eq("i64_buf", oren_type_name(b64), "i64_buf")
    assert_str_eq("f32_buf", oren_type_name(bf32), "f32_buf")
    assert_str_eq("f64_buf", oren_type_name(bf64), "f64_buf")

    assert_false("truth_nil", nil)
    assert_false("truth_false", false)
    assert_true("truth_true", true)
    assert_true("truth_int_zero", 0)
    assert_true("truth_int_one", 1)
    assert_true("truth_empty_string", empty_str)
    assert_true("truth_string", "hi")
    assert_true("truth_empty_list", empty_list)
    assert_true("truth_list", xs)
    assert_true("truth_list_int", xs_int)
    assert_true("truth_empty_map", empty_map)
    assert_true("truth_map", m)
    assert_true("truth_float_zero", 0.0)
    assert_true("truth_float_neg", -1.25)

    if 1 == 1.0 {
        print("tag_parity: int_float_eq expected false")
        exit(6)
    }
    if 1 != 1.0 {
        // ok
    } else {
        print("tag_parity: int_float_ne expected true")
        exit(8)
    }
    if 1 != 1 {
        print("tag_parity: int_eq expected true")
        exit(7)
    }
    if 1.0 != 1.0 {
        print("tag_parity: float_eq expected true")
        exit(11)
    }
    if 1 < 2.0 {
        // ok
    } else {
        print("tag_parity: mixed_lt expected true")
        exit(12)
    }
    if 2.0 <= 2 {
        // ok
    } else {
        print("tag_parity: mixed_le expected true")
        exit(13)
    }
    if 3.0 > 4 {
        print("tag_parity: mixed_gt expected false")
        exit(14)
    }
    if 4.0 >= 4 {
        // ok
    } else {
        print("tag_parity: mixed_ge expected true")
        exit(15)
    }
    if "a" < "b" {
        // ok
    } else {
        print("tag_parity: string_lt expected true")
        exit(16)
    }
    if "b" > "a" {
        // ok
    } else {
        print("tag_parity: string_gt expected true")
        exit(17)
    }
    if "a" <= "a" {
        // ok
    } else {
        print("tag_parity: string_le expected true")
        exit(18)
    }
    if "b" >= "b" {
        // ok
    } else {
        print("tag_parity: string_ge expected true")
        exit(19)
    }
    if "a" == "a" {
        // ok
    } else {
        print("tag_parity: string_eq expected true")
        exit(20)
    }
    if "a" != "a" {
        print("tag_parity: string_ne expected false")
        exit(21)
    }
    if "1" == 1 {
        print("tag_parity: str_int_eq expected false")
        exit(22)
    }
    if "1" != 1 {
        // ok
    } else {
        print("tag_parity: str_int_ne expected true")
        exit(23)
    }
    if nil == nil {
        // ok
    } else {
        print("tag_parity: nil_eq expected true")
        exit(29)
    }
    if nil != nil {
        print("tag_parity: nil_ne expected false")
        exit(30)
    }
    if nil == "" {
        print("tag_parity: nil_string_eq expected false")
        exit(31)
    }
    if false == 0 {
        print("tag_parity: false_zero_eq expected false")
        exit(32)
    }
    if false != 0 {
        // ok
    } else {
        print("tag_parity: false_zero_ne expected true")
        exit(33)
    }
    if true != true {
        print("tag_parity: true_eq expected true")
        exit(34)
    }
    if false != false {
        print("tag_parity: false_eq expected true")
        exit(35)
    }
    var la = []
    var lb = []
    var lc = la
    if la == lb {
        print("tag_parity: list_eq expected false")
        exit(25)
    }
    if la != lc {
        print("tag_parity: list_alias_eq expected true")
        exit(26)
    }
    var lia = oren_new_list_int(0)
    var lib = oren_new_list_int(0)
    var lic = lia
    if lia == lib {
        print("tag_parity: list_int_eq expected false")
        exit(27)
    }
    if lia != lic {
        print("tag_parity: list_int_alias_eq expected true")
        exit(28)
    }
    var ma = {"x": 1}
    var mb = {"x": 1}
    var mc = ma
    if ma == mb {
        print("tag_parity: map_eq expected false")
        exit(36)
    }
    if ma != mc {
        print("tag_parity: map_alias_eq expected true")
        exit(37)
    }
    var ba = oren_u8_buf_new(1)
    var bb = oren_u8_buf_new(1)
    var bc = ba
    oren_buf_store_u8(ba, 0, 7)
    oren_buf_store_u8(bb, 0, 7)
    if ba == bb {
        print("tag_parity: u8_buf_eq expected false")
        exit(40)
    }
    if ba != bc {
        print("tag_parity: u8_buf_alias_eq expected true")
        exit(41)
    }
    var bia = buffer.i32_new(1)
    var bib = buffer.i32_new(1)
    var bic = bia
    buffer.try_store_i32(bia, 0, 9)
    buffer.try_store_i32(bib, 0, 9)
    if bia == bib {
        print("tag_parity: i32_buf_eq expected false")
        exit(42)
    }
    if bia != bic {
        print("tag_parity: i32_buf_alias_eq expected true")
        exit(43)
    }
    var fa = id
    var fb = id2
    var fc = fa
    if fa == fb {
        print("tag_parity: func_eq expected false")
        exit(38)
    }
    if fa != fc {
        print("tag_parity: func_alias_eq expected true")
        exit(39)
    }
    if true == 1 {
        print("tag_parity: bool_int_eq expected false")
        exit(24)
    }
    var mk = {"1": 10, 1: 20}
    if mk["1"] != 10 {
        print("tag_parity: map_str_key mismatch")
        exit(9)
    }
    if mk[1] != 20 {
        print("tag_parity: map_int_key mismatch")
        exit(10)
    }
    return 0
}
