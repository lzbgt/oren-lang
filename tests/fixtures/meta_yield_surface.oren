fn no_yield() {
    return 1
}

fn one_yield() {
    yield
    return 0
}

fn control_yield() {
    if true {
        yield
    }
    while false {
        yield
    }
    return 0
}

fn nested_only() {
    var f = || {
        yield
        return 7
    }
    return 0
}

fn param_across(arg) {
    yield
    return arg
}

fn local_across() {
    var acc = 1
    yield
    return acc
}

fn dead_local_after_block() {
    {
        var tmp = 1
        yield
    }
    return 0
}

fn multi_local_order(a) {
    var x = a
    var y = x + 1
    yield
    return y + x
}

fn yield_with_nested_fn() {
    var f = || 7
    yield
    return 0
}

fn ready_prefix_suffix() {
    no_yield()
    yield
    no_yield()
    return 9
}

fn multi_top_level_ready(seed) {
    var acc = seed
    yield
    acc = acc + 1
    yield
    return acc + 1
}

fn branch_only_yield() {
    if true {
        yield
    }
    return 0
}
