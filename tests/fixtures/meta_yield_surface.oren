fn no_yield() {
    return 1
}

fn one_yield() {
    yield
    return 0
}

fn control_yield() {
    if true {
        yield
    }
    while false {
        yield
    }
    return 0
}

fn nested_only() {
    var f = || {
        yield
        return 7
    }
    return 0
}

fn param_across(arg) {
    yield
    return arg
}

fn local_across() {
    var acc = 1
    yield
    return acc
}

fn dead_local_after_block() {
    {
        var tmp = 1
        yield
    }
    return 0
}

fn multi_local_order(a) {
    var x = a
    var y = x + 1
    yield
    return y + x
}

fn yield_with_nested_fn() {
    var f = || 7
    yield
    return f()
}

fn ready_prefix_suffix() {
    no_yield()
    yield
    no_yield()
    return 9
}

fn multi_top_level_ready(seed) {
    var acc = seed
    yield
    acc = acc + 1
    yield
    return acc + 1
}

fn branch_only_yield() {
    if true {
        yield
    }
    return 0
}

fn value_nil_expr() {
    return yield
}

fn value_expr(seed) {
    var x = yield (seed + 1)
    return x
}

fn value_stmt(seed) {
    yield seed
    return seed + 3
}

fn nested_value_only() {
    var f = || {
        return yield 7
    }
    return 0
}

fn add1_meta(x) {
    return x + 1
}

fn value_return(seed) {
    return yield (seed + 2)
}

fn value_call_arg(seed) {
    return add1_meta(yield seed)
}

fn exchange_var(seed, out_ch, in_ch) {
    var x = oren_yield_exchange(out_ch, in_ch, seed + 1)
    return x
}

fn exchange_return(seed, out_ch, in_ch) {
    return oren_yield_exchange(out_ch, in_ch, seed + 2)
}

fn exchange_stmt(seed, out_ch, in_ch) {
    oren_yield_exchange(out_ch, in_ch, seed + 3)
    return seed
}

fn exchange_call_arg(seed, out_ch, in_ch) {
    return add1_meta(oren_yield_exchange(out_ch, in_ch, seed + 4))
}

fn exchange_syntax_var(seed, out_ch, in_ch) {
    var x = yield (seed + 5) in (out_ch, in_ch)
    return x
}

fn exchange_syntax_nil(seed, out_ch, in_ch) {
    var x = yield in (out_ch, in_ch)
    return x + seed
}

fn exchange_syntax_return(seed, out_ch, in_ch) {
    return yield (seed + 6) in (out_ch, in_ch)
}

fn exchange_syntax_stmt(seed, out_ch, in_ch) {
    yield (seed + 7) in (out_ch, in_ch)
    return seed
}

fn exchange_syntax_call_arg(seed, out_ch, in_ch) {
    return add1_meta(yield (seed + 8) in (out_ch, in_ch))
}

fn exchange_context_var(seed, co) {
    var x = yield (seed + 9) in co
    return x
}

fn exchange_context_nil(seed, co) {
    var x = yield in co
    return x + seed
}

fn exchange_context_return(seed, co) {
    return yield (seed + 10) in co
}

fn exchange_context_stmt(seed, co) {
    yield (seed + 11) in co
    return seed
}

fn exchange_context_call_arg(seed, co) {
    return add1_meta(yield (seed + 12) in co)
}

fn exchange_nested_only() {
    var f = || {
        return oren_yield_exchange(1, 2, 3)
    }
    return 0
}

@oren.generator
var meta_decl_var = fn(seed) {
    var resumed = yield (seed + 13)
    return resumed + seed
}

@oren.generator
var meta_decl_lambda = |seed| {
    yield
    return seed + 14
}
