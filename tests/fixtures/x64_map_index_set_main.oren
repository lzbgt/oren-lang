// x64-native fixture (Tier-1 bring-up):
// - validates map index assignment `m[key] = v` works on x64
// - validates cross-pointer string equality (update existing key via different pointer)
//
// Run on real x86_64 hosts (Win11 + WSL2) via:
//   ./scripts/verify_native_matrix.sh --targets x64-win-tier1 --tier1-src tests/fixtures/x64_map_index_set_main.oren
//   ./scripts/verify_native_matrix.sh --targets x64-wsl-tier1 --tier1-src tests/fixtures/x64_map_index_set_main.oren

fn main() {
    var m = {"a": 1, "b": 2}

    // Insert via index assignment.
    m["c"] = 3
    if oren_map_len(m) != 3 { return 1 }
    if m["c"] != 3 { return 2 }

    // Update existing entry using a different pointer with the same bytes "c\0".
    var k = malloc_raw(2)
    ptr_set_byte(k, 99) // 'c'
    ptr_set_byte(iadd(k, 1), 0)
    m[k] = 9
    if oren_map_len(m) != 3 { return 3 }
    if m["c"] != 9 { return 4 }

    return 0
}
