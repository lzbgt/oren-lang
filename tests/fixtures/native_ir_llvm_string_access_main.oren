// Native IR LLVM string access smoke:
// - proves generated byte/char helper access over constant string tokens

fn main() {
    var b0 = oren_string_byte_at_unchecked("abcdef", 2)
    if b0 != 99 {
        return 1
    }
    var b1 = oren_string_byte_at_unchecked("abcdef", 5)
    if b1 != 102 {
        return 2
    }
    var c0 = oren_string_char_at("abcdef", 3)
    if oren_string_eq(c0, "d") == false {
        return 3
    }
    var c1 = oren_string_char_at_unchecked("abcdef", 5)
    if oren_string_eq(c1, "f") == false {
        return 4
    }
    return 0
}
