// Native IR LLVM list layout smoke:
// - proves array literals lower to descriptor-backed lists
// - proves indexed reads use the generated list get helper
// - proves descriptor-backed mutation and list roots survive helper safepoints
// - proves descriptor-backed push growth and list length helpers
// - proves nested list element provenance feeds descriptor string helpers
// - proves dynamic integer index writes on unknown list descriptor inputs

fn main() {
    var xs = [3, 4, 5]
    if xs[0] != 3 { return 1 }
    if xs[1] != 4 { return 2 }
    if xs[2] != 5 { return 3 }

    var picked = xs
    if picked[1] != 4 { return 4 }
    xs[1] = 9
    if picked[1] != 9 { return 5 }

    var dyn = "ab" + "cd"
    var words = [dyn]
    dyn = "released"
    if oren_string_len("trigger") != 7 { return 6 }
    if oren_string_eq(words[0], "abcd") != true { return 7 }

    var grown = [10]
    oren_list_push(grown, 11)
    oren_list_push(grown, 12)
    oren_list_push(grown, 13)
    oren_list_push(grown, 14)
    if oren_list_len(grown) != 5 { return 8 }
    if grown[4] != 14 { return 9 }

    var nested_dyn = "ne" + "st"
    var child = [nested_dyn]
    var parent = [child]
    nested_dyn = "released-nested"
    child = [0]
    if oren_string_len("nested-trigger") != 14 { return 10 }
    if oren_string_eq(parent[0][0] + "ed", "nested") != true { return 11 }

    var list_holder = {}
    list_holder["xs"] = [41, 42, 43]
    var list_key = "xs"
    if oren_string_len("list") == 4 {
        list_key = oren_string_slice("zxsq", 1, 3)
    } else {
        list_key = "xs"
    }
    var unknown_list = list_holder[list_key]
    unknown_list[1] = 77
    if unknown_list[1] != 77 { return 12 }
    return 0
}
