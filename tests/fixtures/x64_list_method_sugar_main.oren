// x64-native fixture (Tier-1 bring-up):
// - validates that high-level list method sugar lowers correctly for the x64 backend:
//     xs.len()   -> oren_list_len(xs)
//     xs.push(v) -> oren_list_push(xs, v)
//     xs.get(i)  -> xs[i]
//
// Run on real x86_64 hosts (Win11 + WSL2) via:
//   ./scripts/verify_native_matrix.sh --targets x64-win-tier1 --tier1-src tests/fixtures/x64_list_method_sugar_main.oren
//   ./scripts/verify_native_matrix.sh --targets x64-wsl-tier1 --tier1-src tests/fixtures/x64_list_method_sugar_main.oren

fn main() {
    var xs = []

    xs.push(1)
    xs.push(2)
    xs.push(3)

    if xs.len() != 3 { return 1 }
    if xs.get(0) != 1 { return 2 }
    if xs[2] != 3 { return 3 }

    xs[1] = 99
    if xs[1] != 99 { return 4 }

    return 0
}
