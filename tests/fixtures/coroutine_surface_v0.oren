fn counter_worker(co, args) {
    if reflect.is_generator_context(co) != true { return -100 }
    if reflect.is_coroutine_context(co) != true { return -101 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn list_worker(co, args) {
    if reflect.is_generator_context(co) != true { return -110 }
    var seed = args[0]
    var i = 0
    while i < 3 {
        yield (seed + i) in co
        i = i + 1
    }
    return seed + 30
}

fn cancel_probe_worker(co, args) {
    if reflect.is_generator_context(co) != true { return -115 }
    if coro.is_cancel_requested(co) != false { return -116 }
    if coro.cancel_reason(co) != nil { return -117 }
    var seed = args[0]
    var reason = args[1]
    var resumed = yield seed in co
    if coro.is_cancel_requested(co) != true { return -118 }
    if coro.cancel_reason(co) != reason { return -119 }
    return resumed + reason
}

fn capture_context_counter_worker(co, args) {
    if reflect.is_generator_context(co) != true { return -1195 }
    if reflect.is_coroutine_context(co) != true { return -1196 }
    var cells = args[0]
    var seed = args[1]
    cells[0] = co
    var resumed = yield seed in co
    return resumed + 1
}

fn cancel_delegate_outer_worker(co, args) {
    if reflect.is_generator_context(co) != true { return -1191 }
    var inner = coro.start(cancel_probe_worker, [args[0], args[1]])
    var retv = coro.delegate(co, inner)
    if oren_is_err(retv) == true { return -1192 }
