    var retv = coro.delegate_step(co, inner, step0)
    if oren_is_err(retv) == true { return -143 }
    return retv + 13
}

fn hook_worker(co, args) {
    if reflect.is_generator_context(co) != true { return -150 }
    var box = args[0]
    var base = args[1]
    var r0 = coro.on_finalize(co, || { oren_list_push(box, base + 1); return nil })
    if oren_is_err(r0) == true { return -151 }
    var r1 = coro.on_close(co, || { oren_list_push(box, base + 2); return nil })
    if oren_is_err(r1) == true { return -152 }
    var resumed = yield base in co
    return resumed + base + 5
}

fn hook_err_worker(co, args) {
    if reflect.is_generator_context(co) != true { return -160 }
    var box = args[0]
    var r0 = coro.on_close(co, || { oren_list_push(box, 1); return nil })
    if oren_is_err(r0) == true { return -161 }
    var r1 = coro.on_close(co, || { oren_list_push(box, 2); return oren_err(79, "coroutine close hook boom") })
    if oren_is_err(r1) == true { return -162 }
    yield 1 in co
    return 0
}

