var G = 40
// Non-constant global initializer: should be evaluated in `__top_level__` before `main`.
var H = 1 + 1
var SEEN = 0

// Top-level statement execution must run before `main`.
print("tier1 globals top-level pre-main")
SEEN = 1

fn main() {
    if G != 40 { return 1 }
    if H != 2 { return 2 }
    if SEEN != 1 { return 3 }
    print("tier1 globals top-level ok")
    return 0
}
