import math "../../lib/std/math.oren"

fn fail(code) {
    print("module math FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    fail(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

fn assert_close(a: f64, b: f64, eps: f64, code) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code)
}

// ints
assert_eq(math.abs_i(0), 0, 10)
assert_eq(math.abs_i(5), 5, 11)
assert_eq(math.abs_i(0 - 5), 5, 12)

assert_eq(math.min_i(1, 2), 1, 20)
assert_eq(math.max_i(1, 2), 2, 21)
assert_eq(math.clamp_i(5, 0, 10), 5, 22)
assert_eq(math.clamp_i(0 - 5, 0, 10), 0, 23)
assert_eq(math.clamp_i(99, 0, 10), 10, 24)

// floats
assert_eq(math.abs_f(0.0), 0.0, 30)
assert_eq(math.abs_f(1.25), 1.25, 31)
assert_eq(math.abs_f(0.0 - 1.25), 1.25, 32)
assert_eq(math.fabs(0.0 - 1.25), 1.25, 33)

assert_eq(math.min_f(1.0, 2.0), 1.0, 40)
assert_eq(math.max_f(1.0, 2.0), 2.0, 41)
assert_eq(math.clamp_f(5.0, 0.0, 10.0), 5.0, 42)
assert_eq(math.clamp_f(0.0 - 5.0, 0.0, 10.0), 0.0, 43)
assert_eq(math.clamp_f(99.0, 0.0, 10.0), 10.0, 44)
assert_eq(math.clamp(5.0, 0.0, 10.0), 5.0, 122)
assert_eq(math.clamp(0.0 - 5.0, 0.0, 10.0), 0.0, 123)
assert_eq(math.clamp(99.0, 0.0, 10.0), 10.0, 124)
assert_eq(math.saturate(0.0 - 0.25), 0.0, 125)
assert_eq(math.saturate(1.25), 1.0, 126)
assert_eq(math.sign(3.0), 1.0, 145)
assert_eq(math.sign(0.0 - 3.0), 0.0 - 1.0, 146)
assert_eq(math.sign(0.0), 0.0, 147)
assert_eq(math.step(0.5, 0.25), 0.0, 148)
assert_eq(math.step(0.5, 0.5), 1.0, 149)
assert_eq(math.step(0.5, 0.75), 1.0, 150)
assert_close(math.fract(3.75), 0.75, 1e-12, 151)
assert_close(math.fract(0.0 - 1.25), 0.75, 1e-12, 152)
assert_eq(math.fract(4.0), 0.0, 153)
assert_true(oren_is_err(math.sign(math.nan())), 154)
assert_true(oren_is_err(math.step(math.nan(), 1.0)), 155)
assert_true(oren_is_err(math.fract(math.inf())), 156)
assert_close(math.smoothstep(0.0, 1.0, 0.5), 0.5, 1e-12, 127)
assert_eq(math.smoothstep(0.0, 1.0, 0.0 - 1.0), 0.0, 128)
assert_eq(math.smoothstep(0.0, 1.0, 2.0), 1.0, 129)
assert_close(math.smootherstep(0.0, 1.0, 0.5), 0.5, 1e-12, 130)
assert_close(math.smootherstep(2.0, 4.0, 3.0), 0.5, 1e-12, 131)
assert_true(oren_is_err(math.clamp(1.0, 2.0, 1.0)), 132)
assert_true(oren_is_err(math.smoothstep(1.0, 1.0, 1.0)), 133)
assert_true(oren_is_err(math.smootherstep(math.nan(), 1.0, 0.5)), 134)
assert_eq(math.fmin(1.0, 2.0), 1.0, 45)
assert_eq(math.fmax(1.0, 2.0), 2.0, 46)
assert_close(math.lerp(2.0, 10.0, 0.25), 4.0, 1e-12, 47)
assert_eq(math.lerp(2.0, 10.0, 0.0), 2.0, 48)
assert_eq(math.lerp(2.0, 10.0, 1.0), 10.0, 49)
assert_close(math.lerp(2.0, 10.0, 1.5), 14.0, 1e-12, 68)
assert_close(math.lerp(1e308, 0.0 - 1e308, 0.5), 0.0, 1e292, 69)
assert_true(oren_is_err(math.lerp(1.0, math.nan(), 0.5)), 79)
assert_close(math.inverse_lerp(2.0, 10.0, 6.0), 0.5, 1e-12, 135)
assert_close(math.inverse_lerp(10.0, 2.0, 6.0), 0.5, 1e-12, 136)
assert_close(math.inverse_lerp(2.0, 10.0, 14.0), 1.5, 1e-12, 137)
assert_close(math.remap(0.0, 10.0, 100.0, 200.0, 2.5), 125.0, 1e-12, 138)
assert_close(math.remap(0.0, 10.0, 100.0, 200.0, 15.0), 250.0, 1e-12, 139)
assert_close(math.remap_clamped(0.0, 10.0, 100.0, 200.0, 15.0), 200.0, 1e-12, 140)
assert_close(math.remap_clamped(0.0, 10.0, 100.0, 200.0, 0.0 - 5.0), 100.0, 1e-12, 141)
assert_true(oren_is_err(math.inverse_lerp(1.0, 1.0, 1.0)), 142)
assert_true(oren_is_err(math.inverse_lerp(0.0, math.inf(), 1.0)), 143)
assert_true(oren_is_err(math.remap(0.0, 1.0, 0.0, math.nan(), 0.5)), 144)
assert_close(math.midpoint(2.0, 10.0), 6.0, 1e-12, 107)
assert_close(math.midpoint(1e308, 0.0 - 1e308), 0.0, 1e292, 108)
assert_true(math.is_inf(math.midpoint(math.inf(), 4.0)), 109)
assert_true(math.is_inf(math.midpoint(math.inf(), math.inf())), 110)
assert_true(oren_is_err(math.midpoint(math.inf(), math.neg_inf())), 111)
assert_true(oren_is_err(math.midpoint(1.0, math.nan())), 112)
assert_true(!math.signbit(math.fabs(0.0 - 2.0)), 91)
assert_eq(math.fmin(math.nan(), 2.0), 2.0, 92)
assert_eq(math.fmin(2.0, math.nan()), 2.0, 93)
assert_eq(math.fmax(math.nan(), 2.0), 2.0, 94)
assert_eq(math.fmax(2.0, math.nan()), 2.0, 95)
assert_true(math.isclose(1000000.0, 1000000.5, 1e-6, 0.0), 157)
assert_true(!math.isclose(1000000.0, 1000002.0, 1e-6, 0.0), 158)
assert_true(math.isclose_abs(0.00000001, 0.0, 0.00000002), 159)
assert_true(!math.isclose_abs(0.00000003, 0.0, 0.00000002), 160)
assert_true(math.isclose(math.inf(), math.inf(), 0.0, 0.0), 161)
assert_true(!math.isclose(math.inf(), 1.0, 1.0, 1.0), 162)
assert_true(!math.isclose(math.nan(), math.nan(), 1.0, 1.0), 163)
assert_true(oren_is_err(math.isclose(1.0, 1.0, 0.0 - 1.0, 0.0)), 164)
assert_true(oren_is_err(math.isclose_abs(1.0, 1.0, math.inf())), 165)
var copy_neg = math.copysign(1.0, 0.0 - 1.0)
assert_eq(copy_neg, 0.0 - 1.0, 166)
assert_true(math.signbit(copy_neg), 167)
var copy_pos = math.copysign(0.0 - 1.0, 0.0)
assert_eq(copy_pos, 1.0, 168)
assert_true(!math.signbit(copy_pos), 169)
var copy_nan = math.copysign(math.nan(), 0.0 - 1.0)
assert_true(math.is_nan(copy_nan), 170)
assert_true(math.signbit(copy_nan), 171)

// NaN predicate (IEEE-ish). 0.0/0.0 should yield NaN.
var nanv = 0.0 / 0.0
assert_true(math.is_nan(nanv), 50)
assert_true(math.is_nan(0.0) != true, 51)
assert_true(math.is_nan(math.nan()), 52)
assert_true(math.isnan(nanv), 53)
assert_true(math.isinf(math.inf()), 54)
assert_true(math.isfinite(3.0), 55)
assert_true(math.isnormal(1.0), 56)
assert_true(math.isunordered(math.nan(), 1.0), 57)
assert_true(math.isunordered(1.0, math.nan()), 58)
assert_true(!math.isunordered(1.0, 2.0), 59)
assert_eq(math.fpclassify(math.nan()), "nan", 98)
assert_eq(math.fpclassify(math.inf()), "infinite", 99)
assert_eq(math.fpclassify(0.0), "zero", 100)
assert_eq(math.fpclassify(math.pow2i(0 - 1074)), "subnormal", 101)
assert_eq(math.fpclassify(1.0), "normal", 102)

// real-valued power
assert_close(math.pow(2.0, -1.0), 0.5, 1e-12, 60)
assert_close(math.power(2.0, 4.3), 19.698311, 1e-5, 61)
assert_close(math.pow(-2.0, 3.0), -8.0, 1e-12, 62)
assert_close(math.pow(-2.0, -3.0), -0.125, 1e-12, 63)
assert_true(oren_is_err(math.pow(-2.0, 0.5)), 64)
assert_close(math.pow(1.0, math.inf()), 1.0, 1e-12, 65)
assert_close(math.pow(-1.0, math.inf()), 1.0, 1e-12, 66)
assert_true(math.is_inf(math.pow(0.5, math.neg_inf())), 67)

// C/C++ mathlib aliases and common functions
assert_eq(math.trunc(1.9), 1.0, 70)
assert_eq(math.trunc(0.0 - 1.9), -1.0, 71)
assert_close(math.fmod(5.5, 2.0), 1.5, 1e-12, 72)
assert_close(math.fmod(0.0 - 5.5, 2.0), -1.5, 1e-12, 73)
assert_close(math.log(3.0), math.ln(3.0), 1e-12, 74)
assert_close(math.log10(1000.0), 3.0, 1e-10, 75)
assert_close(math.exp10(3.0), 1000.0, 1e-6, 76)
assert_close(math.hypot(3.0, 4.0), 5.0, 1e-12, 80)
assert_close(math.hypot3(2.0, 3.0, 6.0), 7.0, 1e-12, 103)
assert_close(math.hypot3(3000000.0, 4000000.0, 12000000.0), 13000000.0, 1e-6, 104)
assert_true(math.is_inf(math.hypot3(1.0, math.inf(), 2.0)), 105)
assert_true(oren_is_err(math.hypot3(1.0, math.nan(), 2.0)), 106)
assert_true(oren_is_err(math.fmod(1.0, 0.0)), 81)
var remq = math.remquo(7.0, 2.0)
assert_close(remq[0], 0.0 - 1.0, 1e-12, 113)
assert_eq(remq[1], 4, 114)
var remq_neg = math.remquo(0.0 - 7.0, 2.0)
assert_close(remq_neg[0], 1.0, 1e-12, 115)
assert_eq(remq_neg[1], 0 - 4, 116)
assert_true(oren_is_err(math.remquo(1.0, 0.0)), 117)
assert_eq(math.lround(2.5), 3, 118)
assert_eq(math.llround(0.0 - 2.5), 0 - 3, 119)
assert_eq(math.lrint(2.5), 2, 120)
assert_eq(math.llrint(3.5), 4, 121)
assert_true(math.isgreater(2.0, 1.0), 82)
assert_true(!math.isgreater(math.nan(), 1.0), 83)
assert_true(math.isgreaterequal(2.0, 2.0), 84)
assert_true(math.isless(1.0, 2.0), 85)
assert_true(!math.isless(1.0, math.nan()), 86)
assert_true(math.islessequal(2.0, 2.0), 87)
assert_true(math.islessgreater(1.0, 2.0), 88)
assert_true(!math.islessgreater(2.0, 2.0), 89)
assert_true(!math.islessgreater(math.nan(), 2.0), 90)
assert_true(math.is_nan(math.fmin(math.nan(), math.nan())), 96)
assert_true(math.is_nan(math.fmax(math.nan(), math.nan())), 97)

print("module math OK")
exit(0)
