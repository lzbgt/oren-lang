import json "../../lib/std/json.oren"
import strings "../../lib/std/strings.oren"

fn assert(cond, msg) {
    if !cond {
        print("ASSERT FAIL: " + msg)
        exit(1)
    }
}

fn test_decode_encode() {
    // Input JSON contains an escaped newline (`\\n`) and an escaped quote (`\\\"`).
    var r = json.decode("{\"b\":2,\"a\":1,\"s\":\"x\\\\n\\\"y\"}")
    assert(r["ok"] == 1, "decode ok")
    var out = json.encode(r["v"])
    // keys are stored/iterated deterministically; encoder emits without spaces.
    assert(strings.streq(out, "{\"a\":1,\"b\":2,\"s\":\"x\\\\n\\\"y\"}"), "encode deterministic + escapes")
    var out2 = json.encode(r["v"])
    assert(oren_is_err(out2) != true && strings.streq(out2, out), "encode deterministic + escapes")
}

fn test_int_zero_not_null() {
    var v = json.jint(0)
    assert(strings.streq(json.encode(v), "0"), "int zero encodes as number")
    var rn = json.decode("null")
    assert(rn["ok"] == 1, "decode null ok")
    assert(strings.streq(json.encode(rn["v"]), "null"), "null encodes as null")
}

fn test_nested() {
    var r = json.decode("{\"x\":[true,false,null,3]}")
    assert(r["ok"] == 1, "decode nested ok")
    var out = json.encode(r["v"])
    assert(strings.streq(out, "{\"x\":[true,false,null,3]}"), "nested roundtrip")
}

fn test_parse() {
    var v = json.parse("{\"x\":5}")
    assert(oren_is_err(v) != true, "parse ok")
    assert(v["o"]["x"]["i"] == 5, "parse value")
    var e = json.parse("{")
    assert(oren_is_err(e) == true, "parse err")
}

fn test_method_json() {
    var v = "{\"x\":5}".json()
    assert(oren_is_err(v) != true, "string literal json method")
    assert(v["o"]["x"]["i"] == 5, "string literal json value")

    var s = "{\"y\":6}"
    var v2 = s.json()
    assert(oren_is_err(v2) != true, "inferred string json method")
    assert(v2["o"]["y"]["i"] == 6, "inferred string json value")

    var out = "{\"z\":7}".json().text()
    assert(strings.streq(out, "{\"z\":7}"), "json value text chain")
}

test_decode_encode()
test_int_zero_not_null()
test_nested()
test_parse()
test_method_json()
print("ok")
exit(0)
