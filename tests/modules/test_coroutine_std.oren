    assert_eq(coro.cancel_reason(c1st0), 86, 2448717)
    assert_true(coro.terminal_result(c1st0) == nil, 2448718)

    var c1sat0 = coro.start(counter_worker, [30])
    var c1sat0s0 = coro.next(c1sat0)
    assert_true(oren_is_err(c1sat0s0) == false, 2448719)
    assert_eq(c1sat0s0["value"], 31, 2448720)
    var c1sat0w = coro.stop_at(c1sat0, 0, 0, 87)
    assert_true(oren_is_err(c1sat0w) == false, 2448721)
    var c1sat0wr = oren_join_timeout(c1sat0w, 2000)
    assert_true(oren_is_err(c1sat0wr) == false, 2448722)
    assert_true(c1sat0wr == nil, 2448723)
    assert_true(coro.is_done(c1sat0) == true, 2448724)
    assert_true(coro.is_closed(c1sat0) == true, 2448725)
    assert_true(coro.is_cancel_requested(c1sat0) == true, 2448726)
    assert_eq(coro.cancel_reason(c1sat0), 87, 2448727)

    var c1st1 = coro.start(counter_worker, [18])
    assert_true(oren_is_err(coro.next(c1st1)) == false, 2448728)
    assert_true(oren_is_err(coro.send(c1st1, 4)) == false, 2448729)
    var c1st1done = coro.send(c1st1, 9)
    assert_true(oren_is_err(c1st1done) == false, 2448730)
    assert_true(c1st1done["done"] == true, 2448731)
    assert_eq(c1st1done["return"], 14, 2448732)
    var c1st1w = coro.stop_after(c1st1, 0, 1, 120)
    assert_true(oren_is_err(c1st1w) == false, 2448733)
    var c1st1wr = oren_join_timeout(c1st1w, 2000)
    assert_true(oren_is_err(c1st1wr) == false, 2448734)
    assert_eq(c1st1wr, 14, 2448735)
    assert_true(coro.is_cancel_requested(c1st1) == false, 2448736)
    assert_true(coro.cancel_reason(c1st1) == nil, 2448737)
    assert_eq(coro.terminal_result(c1st1), 14, 2448738)

    var c1ctxcells = [nil]
    var c1ctx0 = coro.start(capture_context_counter_worker, [c1ctxcells, 61])
    var c1ctx0s0 = coro.next(c1ctx0)
    assert_true(oren_is_err(c1ctx0s0) == false, 2448739)
    assert_eq(c1ctx0s0["value"], 61, 2448740)
    var c1ctxco = c1ctxcells[0]
    assert_true(reflect.is_coroutine_context(c1ctxco) == true, 2448741)
    var c1ctx0w = coro.stop_after(c1ctxco, 0, 0, 88)
    assert_true(oren_is_err(c1ctx0w) == false, 2448742)
    var c1ctx0wr = oren_join_timeout(c1ctx0w, 2000)
    assert_true(oren_is_err(c1ctx0wr) == false, 2448743)
    assert_true(c1ctx0wr == nil, 2448744)
    assert_true(coro.is_done(c1ctx0) == true, 2448745)
