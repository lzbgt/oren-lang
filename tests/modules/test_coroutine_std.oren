import coro "../../lib/std/coroutine.oren"
import reflect "../../lib/std/reflect.oren"

fn fail(code) {
    print("module coroutine_std FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    fail(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

fn counter_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 100)
    assert_true(reflect.is_coroutine_context(co) == true, 101)
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn list_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 110)
    var seed = args[0]
    var i = 0
    while i < 3 {
        yield (seed + i) in co
        i = i + 1
    }
    return seed + 30
}

fn cancel_probe_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 115)
    assert_true(coro.is_cancel_requested(co) == false, 116)
    assert_true(coro.cancel_reason(co) == nil, 117)
    var seed = args[0]
    var reason = args[1]
    var resumed = yield seed in co
    assert_true(coro.is_cancel_requested(co) == true, 118)
    assert_eq(coro.cancel_reason(co), reason, 119)
    return resumed + reason
}

fn capture_context_counter_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 1195)
    assert_true(reflect.is_coroutine_context(co) == true, 1196)
    var cells = args[0]
    var seed = args[1]
    cells[0] = co
    var resumed = yield seed in co
    return resumed + 1
}

fn cancel_delegate_outer_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 1191)
    var inner = coro.start(cancel_probe_worker, [args[0], args[1]])
    var retv = coro.delegate(co, inner)
    if oren_is_err(retv) == true { return -1192 }
    return retv
}

fn cancel_delegate_capture_outer_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 1193)
    var cells = args[0]
    var inner = coro.start(cancel_probe_worker, [args[1], args[2]])
    cells[0] = inner
    var retv = coro.delegate(co, inner)
    if oren_is_err(retv) == true { return -1194 }
    return retv
}

fn delegate_inner_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 120)
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 50
}

fn delegate_outer_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 130)
    var inner = coro.start(delegate_inner_worker, [args[0]])
    var retv = coro.delegate(co, inner)
    if oren_is_err(retv) == true { return -131 }
    return retv + 21
}

fn delegate_step_outer_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 140)
    var inner = coro.start(delegate_inner_worker, [args[0]])
    var step0 = coro.next(inner)
    if oren_is_err(step0) == true { return -141 }
    assert_true(step0["ok"] == true, 142)
    assert_eq(step0["value"], args[0] + 1, 143)
    var retv = coro.delegate_step(co, inner, step0)
    if oren_is_err(retv) == true { return -144 }
    return retv + 13
}

fn hook_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 150)
    var box = args[0]
    var base = args[1]
    var r0 = coro.on_finalize(co, || { oren_list_push(box, base + 1); return nil })
    if oren_is_err(r0) == true { return -151 }
    var r1 = coro.on_close(co, || { oren_list_push(box, base + 2); return nil })
    if oren_is_err(r1) == true { return -152 }
    var resumed = yield base in co
    return resumed + base + 5
}

fn hook_err_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 160)
    var box = args[0]
    var r0 = coro.on_close(co, || { oren_list_push(box, 1); return nil })
    if oren_is_err(r0) == true { return -161 }
    var r1 = coro.on_close(co, || { oren_list_push(box, 2); return oren_err(79, "coroutine close hook boom") })
    if oren_is_err(r1) == true { return -162 }
    yield 1 in co
    return 0
}

fn main() {
    var c0 = coro.start(counter_worker, [40])
    assert_eq(oren_type_name(c0), "generator", 1)
    assert_true(reflect.is_coroutine(c0) == true, 2)
    assert_true(reflect.is_coroutine_context(123) == false, 201)
    assert_true(coro.is_started(c0) == false, 202)
    assert_true(coro.current_step(c0) == nil, 203)
    assert_true(coro.is_closed(c0) == false, 2031)
    assert_true(coro.terminal_error(c0) == nil, 2032)
    var c0s0 = coro.next(c0)
    assert_true(oren_is_err(c0s0) == false, 3)
    assert_eq(c0s0["value"], 41, 4)
    var c0peek0 = coro.current_step(c0)
    assert_true(c0peek0 != nil, 204)
    assert_true(c0peek0["ok"] == true, 205)
    assert_true(c0peek0["done"] == false, 206)
    assert_eq(c0peek0["value"], 41, 207)
    assert_true(coro.is_started(c0) == true, 208)
    var c0s1 = coro.send(c0, 2)
    assert_true(oren_is_err(c0s1) == false, 5)
    assert_eq(c0s1["value"], 42, 6)
    var c0peek1 = coro.current_step(c0)
    assert_true(c0peek1 != nil, 209)
    assert_eq(c0peek1["value"], 42, 210)
    var c0s2 = coro.send(c0, 7)
    assert_true(oren_is_err(c0s2) == false, 7)
    assert_true(c0s2["done"] == true, 8)
    assert_eq(c0s2["return"], 12, 9)
    assert_true(coro.is_done(c0) == true, 10)
    assert_eq(coro.return_value(c0), 12, 11)
    assert_eq(coro.terminal_result(c0), 12, 2113)
    assert_true(coro.current_step(c0) == nil, 211)
    assert_true(coro.is_closed(c0) == false, 2111)
    assert_true(coro.terminal_error(c0) == nil, 2112)
    var c0term = coro.start(counter_worker, [41])
    assert_true(oren_is_err(coro.terminal_result(c0term)) == true, 2114)
    assert_true(coro.close(c0term) == nil, 2115)

    assert_true(oren_is_err(coro.next(123)) == true, 12)
    assert_true(oren_is_err(coro.send(123, 1)) == true, 13)
    assert_true(oren_is_err(coro.collect(123)) == true, 14)
    assert_true(oren_is_err(coro.close(123)) == true, 15)
    assert_true(oren_is_err(coro.cancel(123, 1)) == true, 1501)
    assert_true(oren_is_err(coro.request_cancel(123, 1)) == true, 151)
    assert_true(oren_is_err(coro.request_cancel_after(123, 0, 1)) == true, 1511)
    assert_true(oren_is_err(coro.cancel_after(123, 0, 1)) == true, 1512)
    assert_true(oren_is_err(coro.request_cancel_at(123, 0, 1)) == true, 1513)
    assert_true(oren_is_err(coro.cancel_at(123, 0, 1)) == true, 1514)
    assert_true(coro.is_done(123) == false, 16)
    assert_true(coro.return_value(123) == nil, 17)
    assert_true(coro.is_started(123) == false, 212)
    assert_true(coro.is_cancel_requested(123) == false, 2121)
    assert_true(coro.cancel_reason(123) == nil, 2122)
    assert_true(coro.current_step(123) == nil, 213)
    assert_true(coro.is_closed(123) == false, 2131)
    assert_true(coro.terminal_error(123) == nil, 2132)
    assert_true(oren_is_err(coro.terminal_result(123)) == true, 2133)

    var c1 = coro.start(list_worker, [5])
    var xs = coro.collect(c1)
    assert_true(oren_is_err(xs) == false, 18)
    assert_eq(oren_list_len(xs), 3, 19)
    assert_eq(xs[0], 5, 20)
    assert_eq(xs[1], 6, 21)
    assert_eq(xs[2], 7, 22)
    assert_true(coro.is_done(c1) == true, 23)
    assert_eq(coro.return_value(c1), 35, 24)
    assert_true(coro.is_closed(c1) == false, 241)
    assert_true(coro.terminal_error(c1) == nil, 242)

    var c1b = coro.start(cancel_probe_worker, [50, 70])
    assert_true(coro.is_cancel_requested(c1b) == false, 2421)
    assert_true(coro.cancel_reason(c1b) == nil, 2422)
    var c1bs0 = coro.next(c1b)
    assert_true(oren_is_err(c1bs0) == false, 2423)
    assert_eq(c1bs0["value"], 50, 2424)
    var c1breq0 = coro.request_cancel(c1b, 70)
    assert_true(oren_is_err(c1breq0) == false, 2425)
    assert_true(c1breq0 == nil, 2426)
    assert_true(coro.is_cancel_requested(c1b) == true, 2427)
    assert_eq(coro.cancel_reason(c1b), 70, 2428)
    var c1breq1 = coro.request_cancel(c1b, 99)
    assert_true(oren_is_err(c1breq1) == false, 2429)
    assert_eq(coro.cancel_reason(c1b), 70, 2430)
    var c1bs1 = coro.send(c1b, 3)
    assert_true(oren_is_err(c1bs1) == false, 2431)
    assert_true(c1bs1["done"] == true, 2432)
    assert_eq(c1bs1["return"], 73, 2433)
    assert_true(coro.is_done(c1b) == true, 2434)
    assert_eq(coro.return_value(c1b), 73, 2435)
    assert_true(coro.is_closed(c1b) == false, 2436)
    assert_true(coro.terminal_error(c1b) == nil, 2437)
    assert_eq(coro.terminal_result(c1b), 73, 24371)
    assert_true(coro.is_cancel_requested(c1b) == true, 2438)
    assert_eq(coro.cancel_reason(c1b), 70, 2439)

    var c1bt = coro.start(cancel_probe_worker, [55, 75])
    var c1bts0 = coro.next(c1bt)
    assert_true(oren_is_err(c1bts0) == false, 24391)
    assert_eq(c1bts0["value"], 55, 24392)
    var c1btw = coro.request_cancel_after(c1bt, 0, 75)
    assert_true(oren_is_err(c1btw) == false, 24393)
    var c1btwr = oren_join_timeout(c1btw, 2000)
    assert_true(oren_is_err(c1btwr) == false, 24394)
    assert_true(c1btwr == nil, 24395)
    assert_true(coro.is_cancel_requested(c1bt) == true, 24396)
