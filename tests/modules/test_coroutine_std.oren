    var c1bts1 = coro.send(c1bt, 4)
    assert_true(oren_is_err(c1bts1) == false, 24398)
    assert_true(c1bts1["done"] == true, 24399)
    assert_eq(c1bts1["return"], 79, 24400)

    var c1btbad = coro.request_cancel_after(c1bt, "bad", 1)
    assert_true(oren_is_err(c1btbad) == true, 244001)
    var c1btabad = coro.request_cancel_at(c1bt, "bad", 1)
    assert_true(oren_is_err(c1btabad) == true, 2440011)
    var c1stopbad0 = coro.stop_after(123, 0, 0, 1)
    assert_true(oren_is_err(c1stopbad0) == true, 2440012)
    var c1stopbad1 = coro.stop_after(c1bt, "bad", 0, 1)
    assert_true(oren_is_err(c1stopbad1) == true, 2440013)
    var c1stopbad2 = coro.stop_after(c1bt, 0, "bad", 1)
    assert_true(oren_is_err(c1stopbad2) == true, 2440014)
    var c1stopatbad0 = coro.stop_at(123, 0, 0, 1)
    assert_true(oren_is_err(c1stopatbad0) == true, 2440015)
    var c1stopatbad1 = coro.stop_at(c1bt, "bad", 0, 1)
    assert_true(oren_is_err(c1stopatbad1) == true, 2440016)
    var c1stopatbad2 = coro.stop_at(c1bt, 0, "bad", 1)
    assert_true(oren_is_err(c1stopatbad2) == true, 2440017)

    var c1btn = coro.start(cancel_probe_worker, [56, 76])
    var c1btns0 = coro.next(c1btn)
    assert_true(oren_is_err(c1btns0) == false, 244002)
    assert_eq(c1btns0["value"], 56, 244003)
    var c1btnw = coro.request_cancel_after(c1btn, nil, 76)
    assert_true(oren_is_err(c1btnw) == false, 244004)
    var c1btnwr = oren_join_timeout(c1btnw, 2000)
    assert_true(oren_is_err(c1btnwr) == false, 244005)
    assert_true(c1btnwr == nil, 244006)
    assert_true(coro.is_cancel_requested(c1btn) == true, 244007)
    assert_eq(coro.cancel_reason(c1btn), 76, 244008)
    var c1btns1 = coro.send(c1btn, 4)
    assert_true(oren_is_err(c1btns1) == false, 244009)
    assert_true(c1btns1["done"] == true, 244010)
    assert_eq(c1btns1["return"], 80, 244011)

    var c1bat = coro.start(cancel_probe_worker, [57, 77])
    var c1bats0 = coro.next(c1bat)
    assert_true(oren_is_err(c1bats0) == false, 244012)
    assert_eq(c1bats0["value"], 57, 244013)
    var c1batw = coro.request_cancel_at(c1bat, 0, 77)
    assert_true(oren_is_err(c1batw) == false, 244014)
    var c1batwr = oren_join_timeout(c1batw, 2000)
    assert_true(oren_is_err(c1batwr) == false, 244015)
    assert_true(c1batwr == nil, 244016)
    assert_true(coro.is_cancel_requested(c1bat) == true, 244017)
    assert_eq(coro.cancel_reason(c1bat), 77, 244018)
    var c1bats1 = coro.send(c1bat, 4)
    assert_true(oren_is_err(c1bats1) == false, 244019)
    assert_true(c1bats1["done"] == true, 244020)
    assert_eq(c1bats1["return"], 81, 244021)

    var c1c = coro.start(cancel_delegate_outer_worker, [60, 80])
    var c1cs0 = coro.next(c1c)
    assert_true(oren_is_err(c1cs0) == false, 2440)
    assert_eq(c1cs0["value"], 60, 2441)
    var c1creq0 = coro.request_cancel(c1c, 80)
    assert_true(oren_is_err(c1creq0) == false, 2442)
    assert_true(coro.is_cancel_requested(c1c) == true, 2443)
    assert_eq(coro.cancel_reason(c1c), 80, 2444)
    var c1cs1 = coro.send(c1c, 4)
    assert_true(oren_is_err(c1cs1) == false, 2445)
    assert_true(c1cs1["done"] == true, 2446)
    assert_eq(c1cs1["return"], 84, 2447)

    var c1d = coro.start(counter_worker, [20])
    var c1ds0 = coro.next(c1d)
    assert_true(oren_is_err(c1ds0) == false, 24471)
    assert_eq(c1ds0["value"], 21, 24472)
    var c1dc0 = coro.cancel(c1d, 71)
    assert_true(oren_is_err(c1dc0) == false, 24473)
    assert_true(c1dc0 == nil, 24474)
    assert_true(coro.is_done(c1d) == true, 24475)
    assert_true(coro.is_closed(c1d) == true, 24476)
    assert_true(coro.return_value(c1d) == nil, 24477)
    assert_true(coro.terminal_error(c1d) == nil, 24478)
    assert_true(coro.terminal_result(c1d) == nil, 244781)
    assert_true(coro.is_cancel_requested(c1d) == true, 24479)
    assert_eq(coro.cancel_reason(c1d), 71, 24480)
    var c1dstep = coro.next(c1d)
    assert_true(oren_is_err(c1dstep) == false, 24481)
    assert_true(c1dstep["done"] == true, 24482)
    assert_true(c1dstep["return"] == nil, 24483)
    var c1dc1 = coro.cancel(c1d, 99)
    assert_true(oren_is_err(c1dc1) == false, 24484)
    assert_true(c1dc1 == nil, 24485)
    assert_eq(coro.cancel_reason(c1d), 71, 24486)

    var c1dt = coro.start(counter_worker, [22])
    var c1dts0 = coro.next(c1dt)
    assert_true(oren_is_err(c1dts0) == false, 244861)
    assert_eq(c1dts0["value"], 23, 244862)
    var c1dtw = coro.cancel_after(c1dt, 0, 81)
    assert_true(oren_is_err(c1dtw) == false, 244863)
    var c1dtwr = oren_join_timeout(c1dtw, 2000)
    assert_true(oren_is_err(c1dtwr) == false, 244864)
    assert_true(c1dtwr == nil, 244865)
    assert_true(coro.is_done(c1dt) == true, 244866)
    assert_true(coro.is_closed(c1dt) == true, 244867)
    assert_true(coro.is_cancel_requested(c1dt) == true, 244868)
    assert_eq(coro.cancel_reason(c1dt), 81, 244869)

    var c1dtn = coro.start(counter_worker, [24])
    var c1dtns0 = coro.next(c1dtn)
    assert_true(oren_is_err(c1dtns0) == false, 2448691)
    assert_eq(c1dtns0["value"], 25, 2448692)
    var c1dtnw = coro.cancel_after(c1dtn, -5, 83)
    assert_true(oren_is_err(c1dtnw) == false, 2448693)
    var c1dtnwr = oren_join_timeout(c1dtnw, 2000)
    assert_true(oren_is_err(c1dtnwr) == false, 2448694)
    assert_true(c1dtnwr == nil, 2448695)
    assert_true(coro.is_done(c1dtn) == true, 2448696)
    assert_true(coro.is_closed(c1dtn) == true, 2448697)
    assert_true(coro.is_cancel_requested(c1dtn) == true, 2448698)
    assert_eq(coro.cancel_reason(c1dtn), 83, 2448699)

    var c1dat = coro.start(counter_worker, [26])
    var c1dats0 = coro.next(c1dat)
    assert_true(oren_is_err(c1dats0) == false, 2448700)
    assert_eq(c1dats0["value"], 27, 2448701)
    var c1datdeadline = oren_time_now_ns() + 2000000
    var c1datw = coro.cancel_at(c1dat, c1datdeadline, 85)
    assert_true(oren_is_err(c1datw) == false, 2448702)
    var c1datwr = oren_join_timeout(c1datw, 2000)
    assert_true(oren_is_err(c1datwr) == false, 2448703)
    assert_true(c1datwr == nil, 2448704)
    assert_true(coro.is_done(c1dat) == true, 2448705)
    assert_true(coro.is_closed(c1dat) == true, 2448706)
    assert_true(coro.is_cancel_requested(c1dat) == true, 2448707)
    assert_eq(coro.cancel_reason(c1dat), 85, 2448708)

    var c1st0 = coro.start(counter_worker, [28])
    var c1st0s0 = coro.next(c1st0)
    assert_true(oren_is_err(c1st0s0) == false, 2448709)
    assert_eq(c1st0s0["value"], 29, 2448710)
    var c1st0w = coro.stop_after(c1st0, 0, 0, 86)
    assert_true(oren_is_err(c1st0w) == false, 2448711)
    var c1st0wr = oren_join_timeout(c1st0w, 2000)
    assert_true(oren_is_err(c1st0wr) == false, 2448712)
    assert_true(c1st0wr == nil, 2448713)
    assert_true(coro.is_done(c1st0) == true, 2448714)
