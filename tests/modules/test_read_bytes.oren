fn fail(msg) {
    oren_system("echo FAIL: " + msg)
    oren_exit(1)
}

fn run() {
    var path = "build/test_read_bytes.bin"
    var bytes = [0, 1, 0, 2, 255, 128, 64, 0, 10]
    oren_write_bytes(path, bytes)

    var out = oren_read_bytes(path)
    if oren_list_len(out) != oren_list_len(bytes) {
        fail("length mismatch")
    }

    var i = 0
    while i < oren_list_len(bytes) {
        if out[i] != bytes[i] {
            fail("byte mismatch at " + oren_int_to_string(i))
        }
        i = i + 1
    }

    print("read_bytes OK")
}

run()
