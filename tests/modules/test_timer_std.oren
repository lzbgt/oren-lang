import result "../../lib/std/result.oren"
import timer "../../lib/std/timer.oren"

fn fail(code) {
    print("module timer_std FAIL " + oren_int_to_string(code))
    exit(code)
}

var now = timer.now_ns()
if timer.ms_to_ns(2) != 2000000 { fail(30) }
if timer.ns_to_ms_floor(1999999) != 1 { fail(31) }
if timer.ns_to_ms_ceil(1) != 1 { fail(32) }
if timer.ns_to_ms_ceil(2000000) != 2 { fail(33) }
if !result.is_err(timer.ms_to_ns(-1)) { fail(34) }
if !result.is_err(timer.ns_to_ms_floor(-1)) { fail(35) }
if !result.is_err(timer.ns_to_ms_ceil(-1)) { fail(36) }
var dn = timer.deadline_after_ns(0)
if result.is_err(dn) { fail(37) }
if dn < now { fail(38) }
if !result.is_err(timer.deadline_after_ns(-1)) { fail(39) }

var d0 = timer.deadline_after_ms(0)
if result.is_err(d0) { fail(1) }
if d0 < now { fail(2) }
if timer.remaining_ns(now - 1) != 0 { fail(3) }
if timer.remaining_ms(now - 1) != 0 { fail(4) }
if !timer.expired(now - 1) { fail(5) }
if timer.expired(now + 1000000000) { fail(6) }
if !result.is_err(timer.deadline_after_ms(-1)) { fail(7) }

var w0 = timer.watch_deadline("ready", timer.now_ns())
if w0["kind"] != "timer" || w0["id"] != "ready" { fail(10) }
if w0["deadline_ns"] > timer.now_ns() { fail(11) }

var wf = timer.watch_after_ms("future", 1000)
if result.is_err(wf) { fail(12) }
if wf["kind"] != "timer" || wf["id"] != "future" { fail(13) }
if wf["deadline_ns"] <= timer.now_ns() { fail(14) }
var wfn = timer.watch_after_ns("future-ns", 1000000)
if result.is_err(wfn) { fail(15) }
if wfn["kind"] != "timer" || wfn["id"] != "future-ns" { fail(16) }
if wfn["deadline_ns"] <= timer.now_ns() { fail(17) }
if !result.is_err(timer.watch_after_ns("bad", -1)) { fail(18) }

var it = timer.interval("tick", 1)
if result.is_err(it) { fail(20) }
if it["kind"] != "timer" || it["id"] != "tick" || it["period_ns"] != 1000000 { fail(21) }
var it2 = timer.advance_interval({"kind": "timer", "id": "tick", "deadline_ns": timer.now_ns() - 1000000, "period_ns": 1000000})
if result.is_err(it2) { fail(22) }
if it2["deadline_ns"] <= timer.now_ns() { fail(23) }
if it2["period_ns"] != 1000000 { fail(24) }
if !result.is_err(timer.interval("bad", 0)) { fail(25) }
if !result.is_err(timer.advance_interval({"kind": "timer", "id": "bad", "period_ns": 0})) { fail(26) }
var itn = timer.interval_ns("tick-ns", 1000000)
if result.is_err(itn) { fail(40) }
if itn["kind"] != "timer" || itn["id"] != "tick-ns" || itn["period_ns"] != 1000000 { fail(41) }
if !result.is_err(timer.interval_ns("bad-ns", 0)) { fail(42) }

print("module timer_std OK")
exit(0)
