// Regression: `as` cast operator parses and lowers to builtin cast semantics.

fn fail(code) {
    print("module as_cast FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

// Integer cast
assert_eq(4294967295 as i32, -1, 10)

// Float32 rounding boundary:
// - 16777217.0 (2^24+1) rounds to 16777216.0 in float32.
// - 16777218.0 (2^24+2) is representable in float32.
var a = 16777217.0 as f32
assert_eq(a, 16777216.0, 20)

// Precedence: `as` must bind tighter than `+` here.
// Desired parse: 1.0 + (16777217.0 as f32) = 1.0 + 16777216.0 = 16777217.0
var x = 1.0 + 16777217.0 as f32
assert_eq(x, 16777217.0, 30)

// Parenthesized cast-after-add produces different rounding:
// (1.0 + 16777217.0) as f32 = 16777218.0 as f32 = 16777218.0
var y = (1.0 + 16777217.0) as f32
assert_eq(y, 16777218.0, 31)

print("module as_cast OK")
exit(0)

