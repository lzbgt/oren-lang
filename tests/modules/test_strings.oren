import s "../../lib/std/strings.oren"

fn assert(cond, msg) {
    if !cond {
        print("ASSERT FAIL: " + msg)
        exit(1)
    }
}

fn test_strings() {
    assert(s.starts_with("hello", "he"), "starts_with")
    assert(!s.starts_with("hello", "ha"), "starts_with false")
    assert(s.ends_with("hello", "lo"), "ends_with")
    assert(!s.ends_with("hello", "ll"), "ends_with false")
    assert(s.contains("hello", "ell"), "contains")
    assert(!s.contains("hello", "xyz"), "contains false")
    assert(s.index_of("hello", "ell") == 1, "index_of")
    assert(s.index_of("hello", "xyz") == -1, "index_of missing")
    assert(s.trim("  hi\t") == "hi", "trim")
    // C runtime: oren_string_char_at must return a 1-byte string.
    assert(oren_string_char_at("abc", 0) == "a", "char_at 0")
    assert(oren_string_char_at("abc", 2) == "c", "char_at 2")
}

test_strings()
print("ok")
exit(0)

