import s "../../lib/std/strings.oren"

fn assert(cond, msg) {
    if !cond {
        print("ASSERT FAIL: " + msg)
        exit(1)
    }
}

fn test_strings() {
    assert(s.starts_with("hello", "he"), "starts_with")
    assert(!s.starts_with("hello", "ha"), "starts_with false")
    assert(s.try_starts_with("hello", "he"), "try_starts_with")
    assert(!s.try_starts_with("hello", "ha"), "try_starts_with false")
    assert(oren_is_err(s.try_starts_with(123, "he")), "try_starts_with bad s")
    assert(oren_is_err(s.try_starts_with("hello", 123)), "try_starts_with bad prefix")
    assert(s.ends_with("hello", "lo"), "ends_with")
    assert(!s.ends_with("hello", "ll"), "ends_with false")
    assert(s.try_ends_with("hello", "lo"), "try_ends_with")
    assert(!s.try_ends_with("hello", "ll"), "try_ends_with false")
    assert(oren_is_err(s.try_ends_with("hello", 123)), "try_ends_with bad suffix")
    assert(s.contains("hello", "ell"), "contains")
    assert(!s.contains("hello", "xyz"), "contains false")
    assert(s.try_contains("hello", "ell"), "try_contains")
    assert(!s.try_contains("hello", "xyz"), "try_contains false")
    assert(oren_is_err(s.try_contains(123, "ell")), "try_contains bad s")
    assert(s.index_of("hello", "ell") == 1, "index_of")
    assert(s.index_of("hello", "xyz") == -1, "index_of missing")
    assert(s.try_index_of("hello", "ell") == 1, "try_index_of")
    assert(s.try_index_of("hello", "xyz") == -1, "try_index_of missing")
    assert(oren_is_err(s.try_index_of("hello", 123)), "try_index_of bad sub")
    assert(s.try_streq("same", "same"), "try_streq")
    assert(!s.try_streq("same", "diff"), "try_streq false")
    assert(oren_is_err(s.try_streq("same", 123)), "try_streq bad rhs")
    assert(s.trim("  hi\t") == "hi", "trim")
    assert(s.try_trim("  hi\t") == "hi", "try_trim")
    assert(oren_is_err(s.try_trim(123)), "try_trim bad s")
    // C runtime: oren_string_char_at must return a 1-byte string.
    assert(oren_string_char_at("abc", 0) == "a", "char_at 0")
    assert(oren_string_char_at("abc", 2) == "c", "char_at 2")
}

test_strings()
print("ok")
exit(0)
