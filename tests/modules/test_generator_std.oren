fn defer_finalize_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -996 }
    var box = args[0]
    var base = args[1]
    defer { oren_list_push(box, base + 1); return nil } in co
    defer { oren_list_push(box, base + 2); return nil } in co
    var resumed = yield base in co
    return resumed + base + 41
}

