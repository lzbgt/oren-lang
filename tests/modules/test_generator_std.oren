    defer { oren_list_push(box, base + 2); return nil }
    var inner = gen.start(defer_finalize_chain_inner_worker, [box, base])
    var retv = yield from inner
    if oren_is_err(retv) == true { return -999 }
    return retv + 1
}

fn bad_on_close_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -975 }
    var bad0 = gen.on_close(co, 123)
    if oren_is_err(bad0) != true { return -976 }
    var bad1 = oren_generator_on_close(co, 123)
    if oren_is_err(bad1) != true { return -977 }
    var bad2 = gen.on_finalize(co, 123)
    if oren_is_err(bad2) != true { return -978 }
    var bad3 = oren_generator_on_finalize(co, 123)
    if oren_is_err(bad3) != true { return -979 }
    return 1
}

fn main() {
    var g = gen.start(counter_worker, [40])
    assert_eq(oren_type_tag(g), reflect.TAG_GENERATOR, 8)
    assert_eq(oren_type_name(g), "generator", 9)
    assert_true(reflect.is_generator(g) == true, 91)
    assert_true(reflect.is_list(g) == false, 92)
    assert_true(gen.is_started(g) == false, 93)
    assert_true(gen.current_step(g) == nil, 94)
    assert_true(gen.is_closed(g) == false, 941)
    assert_true(gen.terminal_error(g) == nil, 942)
    var s0 = gen.next(g)
    if oren_is_err(s0) == true { fail(10) }
    assert_true(s0["ok"] == true, 11)
    assert_true(s0["done"] == false, 12)
    assert_eq(s0["value"], 41, 13)
    var gs0 = gen.current_step(g)
    assert_true(gs0 != nil, 95)
    assert_true(gs0["ok"] == true, 96)
    assert_true(gs0["done"] == false, 97)
    assert_eq(gs0["value"], 41, 98)
    assert_true(gen.is_started(g) == true, 99)

    var s1 = gen.send(g, 2)
    if oren_is_err(s1) == true { fail(14) }
    assert_true(s1["ok"] == true, 15)
    assert_eq(s1["value"], 42, 16)
    assert_eq(gen.current_step(g)["value"], 42, 100)

    var s2 = gen.send(g, 7)
    if oren_is_err(s2) == true { fail(17) }
    assert_true(s2["ok"] == false, 18)
    assert_true(s2["done"] == true, 19)
    assert_eq(s2["return"], 12, 20)
    assert_true(gen.is_done(g) == true, 21)
    assert_eq(gen.return_value(g), 12, 22)
    assert_eq(gen.terminal_result(g), 12, 10101)
    assert_true(gen.current_step(g) == nil, 101)
    assert_true(gen.is_closed(g) == false, 102)
    assert_true(gen.terminal_error(g) == nil, 103)
    var g_term_live = gen.start(counter_worker, [41])
    assert_true(oren_is_err(gen.terminal_result(g_term_live)) == true, 10102)
    assert_true(gen.close(g_term_live) == nil, 10103)

    var g2 = gen.start(nil_worker, [60])
    var n0 = gen.next(g2)
    if oren_is_err(n0) == true { fail(30) }
    assert_true(n0["ok"] == true, 31)
    assert_true(n0["value"] == nil, 32)
    var n1 = gen.send(g2, 3)
    if oren_is_err(n1) == true { fail(33) }
    assert_true(n1["done"] == true, 34)
    assert_eq(n1["return"], 67, 35)

    var bias = 100
    var closure_worker = |co, args| {
        var seed = args[0]
        var r = yield (seed + bias) in co
        return r + bias
    }
    bias = 999
    var g3 = gen.start(closure_worker, [5])
    var c0 = gen.next(g3)
    if oren_is_err(c0) == true { fail(40) }
    assert_eq(c0["value"], 105, 41)
    var c1 = gen.send(g3, 4)
    if oren_is_err(c1) == true { fail(42) }
    assert_eq(c1["return"], 104, 43)

    var g4 = gen.start(counter_worker, [10])
    var bad = gen.send(g4, 99)
    assert_true(oren_is_err(bad) == true, 50)
    assert_true(oren_is_err(gen.next(123)) == true, 51)
    assert_true(oren_is_err(gen.send(123, 1)) == true, 52)
    assert_true(oren_is_err(gen.collect(123)) == true, 53)
    assert_true(oren_is_err(gen.close(123)) == true, 531)
    assert_true(oren_is_err(oren_generator_close(123)) == true, 532)
    assert_true(oren_is_err(gen.cancel(123, 1)) == true, 5320)
    assert_true(oren_is_err(gen.request_cancel(123, 1)) == true, 5321)
    assert_true(oren_is_err(gen.request_cancel_after(123, 0, 1)) == true, 53211)
    assert_true(oren_is_err(gen.cancel_after(123, 0, 1)) == true, 53212)
    assert_true(oren_is_err(gen.request_cancel_at(123, 0, 1)) == true, 53213)
    assert_true(oren_is_err(gen.cancel_at(123, 0, 1)) == true, 53214)
    assert_true(gen.is_started(123) == false, 533)
    assert_true(gen.is_cancel_requested(123) == false, 5331)
    assert_true(gen.cancel_reason(123) == nil, 5332)
    assert_true(gen.current_step(123) == nil, 534)
    assert_true(gen.is_closed(123) == false, 5341)
    assert_true(gen.terminal_error(123) == nil, 5342)
    assert_true(oren_is_err(gen.terminal_result(123)) == true, 5343)
    assert_true(gen.is_done(123) == false, 54)
    assert_true(gen.return_value(123) == nil, 55)

    fn list_worker(co, args) {
        if oren_type_name(co) != "generator_context" { return -920 }
        var seed = args[0]
        var i = 0
        while i < 3 {
            yield (seed + i) in co
            i = i + 1
        }
        return seed + 30
    }

    var g5 = gen.start(list_worker, [5])
    var xs = gen.collect(g5)
    if oren_is_err(xs) == true { fail(60) }
    assert_eq(oren_list_len(xs), 3, 61)
    assert_eq(xs[0], 5, 62)
    assert_eq(xs[1], 6, 63)
    assert_eq(xs[2], 7, 64)
    assert_true(gen.is_done(g5) == true, 65)
    assert_eq(gen.return_value(g5), 35, 66)

    var g5i = gen.start(list_worker, [9])
    var ys = []
    for y in g5i { oren_list_push(ys, y) }
    assert_eq(oren_list_len(ys), 3, 661)
    assert_eq(ys[0], 9, 662)
    assert_eq(ys[1], 10, 663)
    assert_eq(ys[2], 11, 664)
    assert_true(gen.is_done(g5i) == true, 665)
    assert_eq(gen.return_value(g5i), 39, 666)

    var g5c0 = gen.start(counter_worker, [15])
    var close0 = gen.close(g5c0)
    assert_true(oren_is_err(close0) == false, 6661)
    assert_true(close0 == nil, 6662)
    assert_true(gen.is_done(g5c0) == true, 6663)
    assert_true(gen.return_value(g5c0) == nil, 6664)
    var close0step = gen.next(g5c0)
    assert_true(oren_is_err(close0step) == false, 6665)
    assert_true(close0step["done"] == true, 6666)
    assert_true(close0step["return"] == nil, 6667)
    var close0xs = gen.collect(g5c0)
    assert_true(oren_is_err(close0xs) == false, 6668)
    assert_eq(oren_list_len(close0xs), 0, 6669)

    var g5r0 = gen.start(cancel_probe_worker, [50, 70])
    assert_true(gen.is_cancel_requested(g5r0) == false, 66691)
    assert_true(gen.cancel_reason(g5r0) == nil, 66692)
    var g5r0s0 = gen.next(g5r0)
    assert_true(oren_is_err(g5r0s0) == false, 66693)
    assert_eq(g5r0s0["value"], 50, 66694)
    var g5r0req0 = gen.request_cancel(g5r0, 70)
    assert_true(oren_is_err(g5r0req0) == false, 66695)
    assert_true(g5r0req0 == nil, 66696)
    assert_true(gen.is_cancel_requested(g5r0) == true, 66697)
    assert_eq(gen.cancel_reason(g5r0), 70, 66698)
    var g5r0req1 = gen.request_cancel(g5r0, 99)
    assert_true(oren_is_err(g5r0req1) == false, 66699)
    assert_eq(gen.cancel_reason(g5r0), 70, 66700)
