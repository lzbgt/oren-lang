    if oren_type_name(co) != "generator_context" { return -997 }
    var box = args[0]
    defer { oren_list_push(box, 1); return nil } in co
    defer { oren_list_push(box, 2); return oren_err(79, "defer finalize boom") } in co
    yield 1 in co
    return 321
}

