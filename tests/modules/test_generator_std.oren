import gen "../../lib/std/generator.oren"

fn fail(code) {
    print("module generator_std FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    fail(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

fn counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn nil_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -910 }
    var seed = args[0]
    yield in co
    return seed + 7
}

fn delegate_inner_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -930 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 50
}

fn delegate_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -931 }
    var inner = gen.start(delegate_inner_worker, [args[0]])
    var retv = gen.delegate(co, inner)
    return retv + 7
}

fn delegate_outer_direct_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -932 }
    var inner = oren_generator_start(delegate_inner_worker, [args[0]])
    var retv = oren_generator_delegate(co, inner)
    return retv + 9
}

fn delegate_syntax_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -939 }
    var inner = gen.start(delegate_inner_worker, [args[0]])
    var retv = yield from inner in co
    if oren_is_err(retv) == true { return -940 }
    return retv + 17
}

fn delegate_syntax_started_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -941 }
    var inner = gen.start(delegate_inner_worker, [args[0]])
    var step0 = gen.next(inner)
    if oren_is_err(step0) == true { return -942 }
    assert_true(step0["ok"] == true, 6815)
    assert_eq(step0["value"], args[0] + 1, 6816)
    var retv = yield from inner in co
    if oren_is_err(retv) == true { return -943 }
    return retv + 19
}

fn delegate_step_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -933 }
    var inner = gen.start(delegate_inner_worker, [args[0]])
    var step0 = gen.next(inner)
    if oren_is_err(step0) == true { return -934 }
    assert_true(step0["ok"] == true, 6811)
    assert_eq(step0["value"], args[0] + 1, 6812)
    var retv = gen.delegate_step(co, inner, step0)
    if oren_is_err(retv) == true { return -935 }
    return retv + 13
}

fn delegate_step_outer_direct_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -936 }
    var inner = oren_generator_start(delegate_inner_worker, [args[0]])
    var step0 = oren_generator_next(inner)
    if oren_is_err(step0) == true { return -937 }
    assert_true(step0["ok"] == true, 6813)
    assert_eq(step0["value"], args[0] + 1, 6814)
    var retv = oren_generator_delegate_step(co, inner, step0)
    if oren_is_err(retv) == true { return -938 }
    return retv + 15
}

fn delegate_chain_inner_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -946 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 70
}

fn delegate_chain_middle_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -947 }
    var cells = args[0]
    var seed = args[1]
    var inner = gen.start(delegate_chain_inner_worker, [seed])
    cells[1] = inner
    var retv = yield from inner in co
    if oren_is_err(retv) == true { return -948 }
    return retv + 30
}

fn delegate_chain_started_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -949 }
    var cells = args[0]
    var seed = args[1]
    var middle = gen.start(delegate_chain_middle_worker, [cells, seed])
    cells[0] = middle
    var step0 = gen.next(middle)
    if oren_is_err(step0) == true { return -950 }
    assert_true(step0["ok"] == true, 6819)
    assert_eq(step0["value"], seed + 1, 6820)
    var retv = yield from middle in co
    if oren_is_err(retv) == true { return -951 }
    return retv + 40
}

@oren.generator
fn decl_counter(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
fn decl_nil(seed) {
    yield
    return seed + 7
}

@oren.generator
fn decl_collect(seed) {
    var i = 0
    while i < 3 {
        yield (seed + i)
        i = i + 1
    }
    return seed + 30
}

@oren.generator
var decl_var_counter = fn(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
var decl_var_lambda = |seed| {
    var resumed = yield (seed + 2)
    return resumed + 9
}

@oren.generator
fn decl_delegate(seed) {
    var inner = gen.start(delegate_inner_worker, [seed])
    var retv = yield from inner
    return retv + 21
}

@oren.generator
fn decl_delegate_started(seed) {
    var inner = gen.start(delegate_inner_worker, [seed])
    var step0 = gen.next(inner)
    if oren_is_err(step0) == true { return -944 }
    assert_true(step0["ok"] == true, 6817)
    assert_eq(step0["value"], seed + 1, 6818)
    var retv = yield from inner
    if oren_is_err(retv) == true { return -945 }
    return retv + 23
}

@oren.generator
fn decl_delegate_chain(cells, seed) {
    var middle = gen.start(delegate_chain_middle_worker, [cells, seed])
    cells[0] = middle
    var retv = yield from middle
    if oren_is_err(retv) == true { return -952 }
    return retv + 41
}

fn close_hook_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -960 }
    var box = args[0]
    var base = args[1]
    var r0 = gen.on_close(co, || { oren_list_push(box, base + 1); return nil })
    if oren_is_err(r0) == true { return -961 }
    var r1 = oren_generator_on_close(co, || { oren_list_push(box, base + 2); return nil })
    if oren_is_err(r1) == true { return -962 }
    var resumed = yield base in co
    return resumed + base + 5
}

fn close_hook_err_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -963 }
    var box = args[0]
    var r0 = gen.on_close(co, || { oren_list_push(box, 1); return nil })
    if oren_is_err(r0) == true { return -964 }
    var r1 = gen.on_close(co, || { oren_list_push(box, 2); return oren_err(77, "close hook boom") })
    if oren_is_err(r1) == true { return -965 }
    yield 1 in co
    return 0
}

fn close_hook_chain_inner_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -966 }
    var box = args[0]
    var base = args[1]
    var r0 = gen.on_close(co, || { oren_list_push(box, base + 1); return nil })
    if oren_is_err(r0) == true { return -967 }
    var resumed = yield base in co
    return resumed + base + 11
}

fn close_hook_chain_middle_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -968 }
    var box = args[0]
    var base = args[1]
    var r0 = gen.on_close(co, || { oren_list_push(box, base + 2); return nil })
    if oren_is_err(r0) == true { return -969 }
    var inner = gen.start(close_hook_chain_inner_worker, [box, base])
    var retv = yield from inner in co
    if oren_is_err(retv) == true { return -970 }
    return retv + 1
}

