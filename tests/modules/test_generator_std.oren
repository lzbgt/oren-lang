import gen "../../lib/std/generator.oren"

fn fail(code) {
    print("module generator_std FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    fail(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

fn counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn nil_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -910 }
    var seed = args[0]
    yield in co
    return seed + 7
}

fn delegate_inner_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -930 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 50
}

fn delegate_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -931 }
    var inner = gen.start(delegate_inner_worker, [args[0]])
    var retv = gen.delegate(co, inner)
    return retv + 7
}

fn delegate_outer_direct_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -932 }
    var inner = oren_generator_start(delegate_inner_worker, [args[0]])
    var retv = oren_generator_delegate(co, inner)
    return retv + 9
}

fn delegate_syntax_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -939 }
    var inner = gen.start(delegate_inner_worker, [args[0]])
    var retv = yield from inner in co
    if oren_is_err(retv) == true { return -940 }
    return retv + 17
}

fn delegate_syntax_started_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -941 }
    var inner = gen.start(delegate_inner_worker, [args[0]])
    var step0 = gen.next(inner)
    if oren_is_err(step0) == true { return -942 }
    assert_true(step0["ok"] == true, 6815)
    assert_eq(step0["value"], args[0] + 1, 6816)
    var retv = yield from inner in co
    if oren_is_err(retv) == true { return -943 }
    return retv + 19
}

fn delegate_step_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -933 }
    var inner = gen.start(delegate_inner_worker, [args[0]])
    var step0 = gen.next(inner)
    if oren_is_err(step0) == true { return -934 }
    assert_true(step0["ok"] == true, 6811)
    assert_eq(step0["value"], args[0] + 1, 6812)
    var retv = gen.delegate_step(co, inner, step0)
    if oren_is_err(retv) == true { return -935 }
    return retv + 13
}

fn delegate_step_outer_direct_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -936 }
    var inner = oren_generator_start(delegate_inner_worker, [args[0]])
    var step0 = oren_generator_next(inner)
    if oren_is_err(step0) == true { return -937 }
    assert_true(step0["ok"] == true, 6813)
    assert_eq(step0["value"], args[0] + 1, 6814)
    var retv = oren_generator_delegate_step(co, inner, step0)
    if oren_is_err(retv) == true { return -938 }
    return retv + 15
}

@oren.generator
fn decl_counter(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
fn decl_nil(seed) {
    yield
    return seed + 7
}

@oren.generator
fn decl_collect(seed) {
    var i = 0
    while i < 3 {
        yield (seed + i)
        i = i + 1
    }
    return seed + 30
}

@oren.generator
var decl_var_counter = fn(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
var decl_var_lambda = |seed| {
    var resumed = yield (seed + 2)
    return resumed + 9
}

@oren.generator
fn decl_delegate(seed) {
    var inner = gen.start(delegate_inner_worker, [seed])
    var retv = yield from inner
    return retv + 21
}

@oren.generator
fn decl_delegate_started(seed) {
    var inner = gen.start(delegate_inner_worker, [seed])
    var step0 = gen.next(inner)
    if oren_is_err(step0) == true { return -944 }
    assert_true(step0["ok"] == true, 6817)
    assert_eq(step0["value"], seed + 1, 6818)
    var retv = yield from inner
    if oren_is_err(retv) == true { return -945 }
    return retv + 23
}

fn main() {
    var g = gen.start(counter_worker, [40])
    assert_eq(oren_type_name(g), "generator", 9)
    var s0 = gen.next(g)
    if oren_is_err(s0) == true { fail(10) }
    assert_true(s0["ok"] == true, 11)
    assert_true(s0["done"] == false, 12)
    assert_eq(s0["value"], 41, 13)

    var s1 = gen.send(g, 2)
    if oren_is_err(s1) == true { fail(14) }
    assert_true(s1["ok"] == true, 15)
    assert_eq(s1["value"], 42, 16)

    var s2 = gen.send(g, 7)
    if oren_is_err(s2) == true { fail(17) }
    assert_true(s2["ok"] == false, 18)
    assert_true(s2["done"] == true, 19)
    assert_eq(s2["return"], 12, 20)
    assert_true(gen.is_done(g) == true, 21)
    assert_eq(gen.return_value(g), 12, 22)

    var g2 = gen.start(nil_worker, [60])
    var n0 = gen.next(g2)
    if oren_is_err(n0) == true { fail(30) }
    assert_true(n0["ok"] == true, 31)
    assert_true(n0["value"] == nil, 32)
    var n1 = gen.send(g2, 3)
    if oren_is_err(n1) == true { fail(33) }
    assert_true(n1["done"] == true, 34)
    assert_eq(n1["return"], 67, 35)

    var bias = 100
    var closure_worker = |co, args| {
        var seed = args[0]
        var r = yield (seed + bias) in co
        return r + bias
    }
    bias = 999
    var g3 = gen.start(closure_worker, [5])
    var c0 = gen.next(g3)
    if oren_is_err(c0) == true { fail(40) }
    assert_eq(c0["value"], 105, 41)
    var c1 = gen.send(g3, 4)
    if oren_is_err(c1) == true { fail(42) }
    assert_eq(c1["return"], 104, 43)

    var g4 = gen.start(counter_worker, [10])
    var bad = gen.send(g4, 99)
    assert_true(oren_is_err(bad) == true, 50)
    assert_true(oren_is_err(gen.next(123)) == true, 51)
    assert_true(oren_is_err(gen.send(123, 1)) == true, 52)
    assert_true(oren_is_err(gen.collect(123)) == true, 53)
    assert_true(oren_is_err(gen.close(123)) == true, 531)
    assert_true(oren_is_err(oren_generator_close(123)) == true, 532)
    assert_true(gen.is_done(123) == false, 54)
    assert_true(gen.return_value(123) == nil, 55)

    fn list_worker(co, args) {
        if oren_type_name(co) != "generator_context" { return -920 }
        var seed = args[0]
        var i = 0
        while i < 3 {
            yield (seed + i) in co
            i = i + 1
        }
        return seed + 30
    }

    var g5 = gen.start(list_worker, [5])
    var xs = gen.collect(g5)
    if oren_is_err(xs) == true { fail(60) }
    assert_eq(oren_list_len(xs), 3, 61)
    assert_eq(xs[0], 5, 62)
    assert_eq(xs[1], 6, 63)
    assert_eq(xs[2], 7, 64)
    assert_true(gen.is_done(g5) == true, 65)
    assert_eq(gen.return_value(g5), 35, 66)

    var g5i = gen.start(list_worker, [9])
    var ys = []
    for y in g5i { oren_list_push(ys, y) }
    assert_eq(oren_list_len(ys), 3, 661)
    assert_eq(ys[0], 9, 662)
    assert_eq(ys[1], 10, 663)
    assert_eq(ys[2], 11, 664)
    assert_true(gen.is_done(g5i) == true, 665)
    assert_eq(gen.return_value(g5i), 39, 666)

    var g5c0 = gen.start(counter_worker, [15])
    var close0 = gen.close(g5c0)
    assert_true(oren_is_err(close0) == false, 6661)
    assert_true(close0 == nil, 6662)
    assert_true(gen.is_done(g5c0) == true, 6663)
    assert_true(gen.return_value(g5c0) == nil, 6664)
    var close0step = gen.next(g5c0)
    assert_true(oren_is_err(close0step) == false, 6665)
    assert_true(close0step["done"] == true, 6666)
    assert_true(close0step["return"] == nil, 6667)
    var close0xs = gen.collect(g5c0)
    assert_true(oren_is_err(close0xs) == false, 6668)
    assert_eq(oren_list_len(close0xs), 0, 6669)

    var g5c1 = gen.start(counter_worker, [25])
    var close1step = gen.next(g5c1)
    assert_true(oren_is_err(close1step) == false, 6670)
    assert_eq(close1step["value"], 26, 6671)
    var close1 = gen.close(g5c1)
    assert_true(oren_is_err(close1) == false, 6672)
    assert_true(close1 == nil, 6673)
    assert_true(gen.is_done(g5c1) == true, 6674)
    assert_true(gen.return_value(g5c1) == nil, 6675)
    var close1done = gen.send(g5c1, 99)
    assert_true(oren_is_err(close1done) == false, 6676)
    assert_true(close1done["done"] == true, 6677)
    assert_true(close1done["return"] == nil, 6678)

    var g5c2 = gen.start(counter_worker, [35])
    assert_true(oren_is_err(gen.next(g5c2)) == false, 6679)
    assert_true(oren_is_err(gen.send(g5c2, 4)) == false, 6680)
    var close2done = gen.send(g5c2, 9)
    assert_true(oren_is_err(close2done) == false, 6681)
    assert_eq(close2done["return"], 14, 6682)
    var close2 = gen.close(g5c2)
    assert_true(oren_is_err(close2) == false, 6683)
    assert_eq(close2, 14, 6684)
    assert_eq(gen.return_value(g5c2), 14, 6685)

    var g5c3 = oren_generator_start(counter_worker, [18])
    var close3 = oren_generator_close(g5c3)
    assert_true(oren_is_err(close3) == false, 6686)
    assert_true(close3 == nil, 6687)
    assert_true(oren_generator_is_done(g5c3) == true, 6688)
    assert_true(oren_generator_return_value(g5c3) == nil, 6689)

    var g5c4 = decl_delegate(45)
    var close4step = gen.next(g5c4)
    assert_true(oren_is_err(close4step) == false, 6690)
    assert_eq(close4step["value"], 46, 6691)
    var close4 = gen.close(g5c4)
    assert_true(oren_is_err(close4) == false, 6692)
    assert_true(close4 == nil, 6693)
    assert_true(gen.is_done(g5c4) == true, 6694)
    assert_true(gen.return_value(g5c4) == nil, 6695)

    var g5d = gen.start(delegate_outer_worker, [30])
    var ds0 = gen.next(g5d)
    if oren_is_err(ds0) == true { fail(667) }
    assert_eq(ds0["value"], 31, 668)
    var ds1 = gen.send(g5d, 2)
    if oren_is_err(ds1) == true { fail(669) }
    assert_eq(ds1["value"], 32, 670)
    var ds2 = gen.send(g5d, 7)
    if oren_is_err(ds2) == true { fail(671) }
    assert_eq(ds2["return"], 64, 672)

    var g5e = gen.start(delegate_outer_direct_worker, [40])
    var dd0 = gen.next(g5e)
    if oren_is_err(dd0) == true { fail(673) }
    assert_eq(dd0["value"], 41, 674)
    var dd1 = gen.send(g5e, 3)
    if oren_is_err(dd1) == true { fail(675) }
    assert_eq(dd1["value"], 43, 676)
    var dd2 = gen.send(g5e, 8)
    if oren_is_err(dd2) == true { fail(677) }
    assert_eq(dd2["return"], 67, 678)

    var g5es = gen.start(delegate_syntax_outer_worker, [20])
    var dys0 = gen.next(g5es)
    if oren_is_err(dys0) == true { fail(6781) }
    assert_eq(dys0["value"], 21, 6782)
    var dys1 = gen.send(g5es, 2)
    if oren_is_err(dys1) == true { fail(6783) }
    assert_eq(dys1["value"], 22, 6784)
    var dys2 = gen.send(g5es, 7)
    if oren_is_err(dys2) == true { fail(6785) }
    assert_eq(dys2["return"], 74, 6786)

    var g5et = gen.start(delegate_syntax_started_outer_worker, [25])
    var dyt0 = gen.next(g5et)
    if oren_is_err(dyt0) == true { fail(6787) }
    assert_eq(dyt0["value"], 26, 6788)
    var dyt1 = gen.send(g5et, 3)
    if oren_is_err(dyt1) == true { fail(6789) }
    assert_eq(dyt1["value"], 28, 6790)
    var dyt2 = gen.send(g5et, 8)
    if oren_is_err(dyt2) == true { fail(6791) }
    assert_eq(dyt2["return"], 77, 6792)

    var g5f = gen.start(delegate_step_outer_worker, [50])
    var dstep0 = gen.next(g5f)
    if oren_is_err(dstep0) == true { fail(679) }
    assert_eq(dstep0["value"], 51, 680)
    var dstep1 = gen.send(g5f, 4)
    if oren_is_err(dstep1) == true { fail(681) }
    assert_eq(dstep1["value"], 54, 682)
    var dstep2 = gen.send(g5f, 8)
    if oren_is_err(dstep2) == true { fail(683) }
    assert_eq(dstep2["return"], 71, 684)

    var g5g = gen.start(delegate_step_outer_direct_worker, [60])
    var ddir0 = gen.next(g5g)
    if oren_is_err(ddir0) == true { fail(685) }
    assert_eq(ddir0["value"], 61, 686)
    var ddir1 = gen.send(g5g, 5)
    if oren_is_err(ddir1) == true { fail(687) }
    assert_eq(ddir1["value"], 65, 688)
    var ddir2 = gen.send(g5g, 9)
    if oren_is_err(ddir2) == true { fail(689) }
    assert_eq(ddir2["return"], 74, 690)

    assert_true(oren_is_err(gen.delegate(123, g5)) == true, 679)
    assert_true(oren_is_err(gen.delegate(123, 456)) == true, 680)
    assert_true(oren_is_err(oren_generator_delegate(123, 456)) == true, 681)
    var started_inner = gen.start(delegate_inner_worker, [70])
    var started_step = gen.next(started_inner)
    if oren_is_err(started_step) == true { fail(691) }
    assert_true(oren_is_err(gen.delegate_step(123, started_inner, started_step)) == true, 692)
    assert_true(oren_is_err(gen.delegate_step([], 456, started_step)) == true, 693)
    assert_true(oren_is_err(gen.delegate_step([], started_inner, 789)) == true, 694)
    var started_step1 = gen.send(started_inner, 6)
    if oren_is_err(started_step1) == true { fail(695) }
    assert_eq(started_step1["value"], 76, 696)
    var started_step2 = gen.send(started_inner, 10)
    if oren_is_err(started_step2) == true { fail(697) }
    assert_eq(started_step2["return"], 60, 698)

    var local_bias = 7
    fn local_add(a, b) {
        return a + b + local_bias
    }
    local_bias = 100
    assert_eq(local_add(1, 2), 10, 67)

    var local_gen_bias = 100
    @oren.generator
    fn local_decl(seed) {
        var resumed = yield (seed + local_gen_bias)
        return resumed + local_gen_bias
    }
    local_gen_bias = 999
    var g5b = local_decl(5)
    var lg0 = gen.next(g5b)
    if oren_is_err(lg0) == true { fail(68) }
    assert_eq(lg0["value"], 105, 69)
    var lg1 = gen.send(g5b, 4)
    if oren_is_err(lg1) == true { fail(70) }
    assert_eq(lg1["return"], 104, 71)

    var g6 = decl_counter(40)
    assert_eq(oren_type_name(g6), "generator", 88)
    var d0 = gen.next(g6)
    if oren_is_err(d0) == true { fail(72) }
    assert_eq(d0["value"], 41, 73)
    var d1 = gen.send(g6, 2)
    if oren_is_err(d1) == true { fail(74) }
    assert_eq(d1["value"], 42, 75)
    var d2 = gen.send(g6, 7)
    if oren_is_err(d2) == true { fail(76) }
    assert_eq(d2["return"], 12, 77)

    var g7 = decl_nil(60)
    var dn0 = gen.next(g7)
    if oren_is_err(dn0) == true { fail(78) }
    assert_true(dn0["value"] == nil, 79)
    var dn1 = gen.send(g7, 3)
    if oren_is_err(dn1) == true { fail(80) }
    assert_eq(dn1["return"], 67, 81)

    var g8 = decl_collect(5)
    var dxs = gen.collect(g8)
    if oren_is_err(dxs) == true { fail(82) }
    assert_eq(oren_list_len(dxs), 3, 83)
    assert_eq(dxs[0], 5, 84)
    assert_eq(dxs[1], 6, 85)
    assert_eq(dxs[2], 7, 86)
    assert_eq(gen.return_value(g8), 35, 87)

    var g8i = decl_collect(8)
    var dsum = 0
    for dv in g8i { dsum = dsum + dv }
    assert_eq(dsum, 27, 871)
    assert_true(gen.is_done(g8i) == true, 872)
    assert_eq(gen.return_value(g8i), 38, 873)

    var g9 = decl_var_counter(40)
    assert_eq(oren_type_name(g9), "generator", 89)
    var dv0 = gen.next(g9)
    if oren_is_err(dv0) == true { fail(90) }
    assert_eq(dv0["value"], 41, 91)
    var dv1 = gen.send(g9, 2)
    if oren_is_err(dv1) == true { fail(92) }
    assert_eq(dv1["value"], 42, 93)
    var dv2 = gen.send(g9, 7)
    if oren_is_err(dv2) == true { fail(94) }
    assert_eq(dv2["return"], 12, 95)

    var g10 = decl_var_lambda(30)
    assert_eq(oren_type_name(g10), "generator", 96)
    var dl0 = gen.next(g10)
    if oren_is_err(dl0) == true { fail(97) }
    assert_eq(dl0["value"], 32, 98)
    var dl1 = gen.send(g10, 4)
    if oren_is_err(dl1) == true { fail(99) }
    assert_eq(dl1["return"], 13, 100)

    var g10b = decl_delegate(30)
    var yd0 = gen.next(g10b)
    if oren_is_err(yd0) == true { fail(1001) }
    assert_eq(yd0["value"], 31, 1002)
    var yd1 = gen.send(g10b, 4)
    if oren_is_err(yd1) == true { fail(1003) }
    assert_eq(yd1["value"], 34, 1004)
    var yd2 = gen.send(g10b, 9)
    if oren_is_err(yd2) == true { fail(1005) }
    assert_eq(yd2["return"], 80, 1006)

    var g10c = decl_delegate_started(35)
    var yz0 = gen.next(g10c)
    if oren_is_err(yz0) == true { fail(1007) }
    assert_eq(yz0["value"], 36, 1008)
    var yz1 = gen.send(g10c, 5)
    if oren_is_err(yz1) == true { fail(1009) }
    assert_eq(yz1["value"], 40, 1010)
    var yz2 = gen.send(g10c, 10)
    if oren_is_err(yz2) == true { fail(1011) }
    assert_eq(yz2["return"], 83, 1012)

    var local_var_bias = 30
    @oren.generator
    var local_var_decl = fn(seed) {
        var resumed = yield (seed + local_var_bias)
        return resumed + local_var_bias
    }
    local_var_bias = 999
    var g11 = local_var_decl(5)
    var lv0 = gen.next(g11)
    if oren_is_err(lv0) == true { fail(101) }
    assert_eq(lv0["value"], 35, 102)
    var lv1 = gen.send(g11, 4)
    if oren_is_err(lv1) == true { fail(103) }
    assert_eq(lv1["return"], 34, 104)

    var g12 = decl_nil(70)
    var nil_count = 0
    for nv in g12 {
        assert_true(nv == nil, 105)
        nil_count = nil_count + 1
    }
    assert_eq(nil_count, 1, 106)
    assert_true(gen.is_done(g12) == true, 107)
    assert_eq(gen.return_value(g12), 77, 108)

    print("module generator_std OK")
    exit(0)
}
