import list "../../lib/std/list.oren"

fn assert(cond, msg) {
    if !cond {
        print("ASSERT FAIL: " + msg)
        exit(1)
    }
}

fn test_list_try_helpers() {
    var xs = [1, 2]
    assert(list.try_len(xs) == 2, "try_len")
    assert(list.try_is_empty(xs) == false, "try_is_empty false")
    assert(list.try_is_empty([]) == true, "try_is_empty true")
    assert(oren_is_err(list.try_is_empty(123)), "try_is_empty bad xs")

    var pushed = list.try_push(xs, 3)
    assert(oren_is_err(pushed) == false, "try_push ok")
    assert(list.try_len(xs) == 3, "try_push len")
    assert(list.try_last(xs) == 3, "try_push last")
    assert(oren_is_err(list.try_push(123, 1)), "try_push bad xs")

    assert(list.try_get(xs, 1) == 2, "try_get")
    assert(oren_is_err(list.try_get(xs, "x")), "try_get bad index")
    assert(oren_is_err(list.try_get(xs, 3)), "try_get oob")

    var setv = list.try_set(xs, 1, 22)
    assert(oren_is_err(setv) == false, "try_set ok")
    assert(list.try_get(xs, 1) == 22, "try_set value")
    assert(oren_is_err(list.try_set(xs, -1, 0)), "try_set oob")

    var copied = list.try_clone(xs)
    assert(oren_is_err(copied) == false, "try_clone ok")
    assert(list.try_len(copied) == 3, "try_clone len")
    assert(list.try_get(copied, 1) == 22, "try_clone value")
    assert(oren_is_err(list.try_clone(123)), "try_clone bad xs")

    var sliced = list.try_slice_copy(xs, 1, 2)
    assert(oren_is_err(sliced) == false, "try_slice_copy ok")
    assert(list.try_len(sliced) == 2, "try_slice_copy len")
    assert(list.try_get(sliced, 0) == 22, "try_slice_copy value")
    assert(oren_is_err(list.try_slice_copy(xs, "x", 1)), "try_slice_copy bad off")
    assert(oren_is_err(list.try_slice_copy(xs, 2, 3)), "try_slice_copy range")
}

test_list_try_helpers()
print("ok")
exit(0)
