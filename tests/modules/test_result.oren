import r "../../lib/std/result.oren"
import ui_color "std:ui/color"

fn double_ok(x) {
    return x * 2
}

fn parse_positive(x) {
    if x <= 0 { return r.err(4, "not positive") }
    return x
}

fn tag_error(e) {
    return r.with_context(e, "tagged")
}

fn recover_default(e) {
    if r.code(e) == 4 { return 77 }
    return e
}

var v = oren_read_file("__definitely_not_a_real_file__.txt")
var s = r.unwrap_or(v, "fallback")

if s == "fallback" {
    // errno/syscall wrapper regression
    var e = r.ok_or_errno(0 - 12, "alloc") // -ENOMEM
    if r.is_err(e) != true {
        print("Result FAIL (expected err)")
        exit(1)
    }
    if oren_err_code(e) != 12 {
        print("Result FAIL (bad errno)")
        exit(1)
    }
    var okv = r.ok_or_errno(5, "read")
    if okv != 5 {
        print("Result FAIL (ok passthrough)")
        exit(1)
    }
    if r.code(okv) != nil || r.msg(okv) != nil {
        print("Result FAIL (ok code/msg)")
        exit(1)
    }

    if r.map_ok(21, double_ok) != 42 {
        print("Result FAIL (map_ok)")
        exit(1)
    }
    var e_keep = r.map_ok(e, double_ok)
    if r.is_err(e_keep) != true || r.code(e_keep) != 12 {
        print("Result FAIL (map_ok err passthrough)")
        exit(1)
    }
    if r.and_then(9, parse_positive) != 9 {
        print("Result FAIL (and_then ok)")
        exit(1)
    }
    var e_chain = r.and_then(0, parse_positive)
    if r.is_err(e_chain) != true || r.code(e_chain) != 4 {
        print("Result FAIL (and_then err)")
        exit(1)
    }
    var e_tagged = r.map_err(e_chain, tag_error)
    if r.is_err(e_tagged) != true || r.code(e_tagged) != 4 {
        print("Result FAIL (map_err err)")
        exit(1)
    }
    if r.msg(e_tagged) != "tagged: not positive" {
        print("Result FAIL (map_err msg)")
        exit(1)
    }
    if r.map_err(19, tag_error) != 19 {
        print("Result FAIL (map_err ok passthrough)")
        exit(1)
    }
    if r.or_else(e_chain, recover_default) != 77 {
        print("Result FAIL (or_else recover)")
        exit(1)
    }
    if r.or_else(88, recover_default) != 88 {
        print("Result FAIL (or_else ok passthrough)")
        exit(1)
    }

    var c = ui_color.parse_hex("red")
    if r.is_err(c) != true {
        print("Result FAIL (ui color err expected)")
        exit(1)
    }
    if oren_err_code(c) != 4 {
        print("Result FAIL (ui color code)")
        exit(1)
    }

    print("Result OK")
    exit(0)
}

print("Result FAIL")
exit(1)
