import r "../../lib/std/result.oren"
import ui_color "std:ui/color"

var v = oren_read_file("__definitely_not_a_real_file__.txt")
var s = r.unwrap_or(v, "fallback")

if s == "fallback" {
    // errno/syscall wrapper regression
    var e = r.ok_or_errno(0 - 12, "alloc") // -ENOMEM
    if r.is_err(e) != true {
        print("Result FAIL (expected err)")
        exit(1)
    }
    if oren_err_code(e) != 12 {
        print("Result FAIL (bad errno)")
        exit(1)
    }
    var okv = r.ok_or_errno(5, "read")
    if okv != 5 {
        print("Result FAIL (ok passthrough)")
        exit(1)
    }

    var c = ui_color.parse_hex("red")
    if r.is_err(c) != true {
        print("Result FAIL (ui color err expected)")
        exit(1)
    }
    if oren_err_code(c) != 4 {
        print("Result FAIL (ui color code)")
        exit(1)
    }

    print("Result OK")
    exit(0)
}

print("Result FAIL")
exit(1)
