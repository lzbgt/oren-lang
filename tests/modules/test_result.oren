import r "../../lib/std/result.oren"
import ui_color "std:ui/color"
import json "../../lib/std/json.oren"

fn double_ok(x) {
    return x * 2
}

fn parse_positive(x) {
    if x <= 0 { return r.err(4, "not positive") }
    return x
}

fn tag_error(e) {
    return r.with_context(e, "tagged")
}

fn recover_default(e) {
    if r.code(e) == 4 { return 77 }
    return e
}

var v = oren_read_file("__definitely_not_a_real_file__.txt")
var s = r.unwrap_or(v, "fallback")

if s == "fallback" {
    // errno/syscall wrapper regression
    var e = r.ok_or_errno(0 - 12, "alloc") // -ENOMEM
    if r.is_err(e) != true {
        print("Result FAIL (expected err)")
        exit(1)
    }
    if oren_err_code(e) != 12 {
        print("Result FAIL (bad errno)")
        exit(1)
    }
    var okv = r.ok_or_errno(5, "read")
    if okv != 5 {
        print("Result FAIL (ok passthrough)")
        exit(1)
    }
    if r.code(okv) != nil || r.msg(okv) != nil {
        print("Result FAIL (ok code/msg)")
        exit(1)
    }

    if r.map_ok(21, double_ok) != 42 {
        print("Result FAIL (map_ok)")
        exit(1)
    }
    var e_keep = r.map_ok(e, double_ok)
    if r.is_err(e_keep) != true || r.code(e_keep) != 12 {
        print("Result FAIL (map_ok err passthrough)")
        exit(1)
    }
    if r.and_then(9, parse_positive) != 9 {
        print("Result FAIL (and_then ok)")
        exit(1)
    }
    var e_chain = r.and_then(0, parse_positive)
    if r.is_err(e_chain) != true || r.code(e_chain) != 4 {
        print("Result FAIL (and_then err)")
        exit(1)
    }
    var e_tagged = r.map_err(e_chain, tag_error)
    if r.is_err(e_tagged) != true || r.code(e_tagged) != 4 {
        print("Result FAIL (map_err err)")
        exit(1)
    }
    if r.msg(e_tagged) != "tagged: not positive" {
        print("Result FAIL (map_err msg)")
        exit(1)
    }
    if r.map_err(19, tag_error) != 19 {
        print("Result FAIL (map_err ok passthrough)")
        exit(1)
    }
    if r.or_else(e_chain, recover_default) != 77 {
        print("Result FAIL (or_else recover)")
        exit(1)
    }
    if r.or_else(88, recover_default) != 88 {
        print("Result FAIL (or_else ok passthrough)")
        exit(1)
    }
    var legacy_ok = {"ok": 1, "v": 123}
    if r.from_ok_map(legacy_ok) != 123 {
        print("Result FAIL (from_ok_map ok)")
        exit(1)
    }
    var legacy_err = {"ok": 0, "err": "legacy failed"}
    var legacy_struct_err = r.from_ok_map(legacy_err)
    if r.is_err(legacy_struct_err) != true || r.code(legacy_struct_err) != 4 {
        print("Result FAIL (from_ok_map err)")
        exit(1)
    }
    if r.msg(legacy_struct_err) != "legacy failed" {
        print("Result FAIL (from_ok_map err msg)")
        exit(1)
    }
    var legacy_bad = r.from_ok_map({"v": 1})
    if r.is_err(legacy_bad) != true || r.code(legacy_bad) != 4 {
        print("Result FAIL (from_ok_map missing ok)")
        exit(1)
    }
    var ok_map = r.to_ok_map(55)
    if ok_map["ok"] != 1 || ok_map["v"] != 55 {
        print("Result FAIL (to_ok_map ok)")
        exit(1)
    }
    var err_map = r.to_ok_map(e_chain)
    if err_map["ok"] != 0 || err_map["code"] != 4 || err_map["err"] != "not positive" {
        print("Result FAIL (to_ok_map err)")
        exit(1)
    }
    var parsed_json = r.from_ok_map(json.decode("{\"n\":3}"))
    if r.is_err(parsed_json) == true || parsed_json["t"] != "object" || parsed_json["o"]["n"]["i"] != 3 {
        print("Result FAIL (from_ok_map json)")
        exit(1)
    }
    var bad_json = r.from_ok_map(json.decode("{"))
    if r.is_err(bad_json) != true || r.code(bad_json) != 4 {
        print("Result FAIL (from_ok_map json err)")
        exit(1)
    }
    var parsed_json2 = json.try_decode("{\"n\":4}")
    if r.is_err(parsed_json2) == true || parsed_json2["o"]["n"]["i"] != 4 {
        print("Result FAIL (json.try_decode ok)")
        exit(1)
    }
    var bad_json2 = json.try_decode("{")
    if r.is_err(bad_json2) != true || r.code(bad_json2) != 4 {
        print("Result FAIL (json.try_decode err)")
        exit(1)
    }
    var c = ui_color.parse_hex("red")
    if r.is_err(c) != true {
        print("Result FAIL (ui color err expected)")
        exit(1)
    }
    if oren_err_code(c) != 4 {
        print("Result FAIL (ui color code)")
        exit(1)
    }

    print("Result OK")
    exit(0)
}

print("Result FAIL")
exit(1)
