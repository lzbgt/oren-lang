// Test helper module for cross-module typed iteration.
//
// This module intentionally does not declare `trait Iterable` itself; it relies on
// the root module to declare it. In rolling v0, traits are metadata-only and `impl`
// blocks are lowered to plain functions, so this is a valid pattern.

struct MyRange {
    start: i32,
    end: i32,
    step: i32
}

fn new_range(start, end, step) {
    return MyRange(start, end, step)
}

impl Iterable for MyRange {
    fn iter_next(self, idx, out_pair) {
        var ok = 0
        var val = nil
        if idx >= 0 && self.step != 0 {
            var v = self.start + idx * self.step
            var ok_fwd = self.step > 0 && v < self.end
            var ok_bwd = self.step < 0 && v > self.end
            if ok_fwd || ok_bwd {
                ok = 1
                val = v
            }
        }
        var out = out_pair
        if out == nil { out = [0, nil] }
        out[0] = ok
        out[1] = val
        return out
    }
}
