assert_true(oren_is_err(vec2.erfc(0.0, math.nan())), 247, "erfc nan errors")
assert_true(oren_is_err(vec2.degrees(math.inf(), 0.0)), 301, "degrees inf errors")
assert_true(oren_is_err(vec2.wrap(1.0, 2.0, 0.0, 3.0, 1.0, 2.0)), 302, "wrap range errors")
assert_true(oren_is_err(vec2.angle_delta_degrees(math.inf(), 0.0, 1.0, 2.0)), 303, "angle_delta_degrees inf errors")
assert_true(oren_is_err(vec2.lerp_angle_degrees(0.0, 1.0, 2.0, 3.0, math.nan())), 304, "lerp_angle_degrees nan errors")
assert_true(oren_is_err(vec2.sin(math.inf(), 0.0)), 134, "sin inf errors")
assert_true(oren_is_err(vec2.tan(0.0, math.nan())), 135, "tan nan errors")
assert_true(oren_is_err(vec2.sin_cos(math.inf(), 0.0)), 155, "sin_cos inf errors")
assert_true(oren_is_err(vec2.sinh(math.inf(), 0.0)), 174, "sinh inf errors")
assert_true(oren_is_err(vec2.cosh(0.0, math.nan())), 175, "cosh nan errors")
assert_true(oren_is_err(vec2.acosh(0.5, 1.0)), 176, "acosh domain errors")
assert_true(oren_is_err(vec2.atanh(1.0, 0.0)), 177, "atanh domain errors")
assert_true(oren_is_err(vec2.asin(1.1, 0.0)), 148, "asin domain errors")
