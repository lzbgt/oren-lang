import vec2 "../../lib/std/math/vec2.oren"
import math "../../lib/std/math.oren"

fn fail(code, msg) {
    print("module math vec2 FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_close(a: f64, b: f64, eps: f64, code, msg) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code, msg)
}

assert_close(vec2.length_sq(3.0, 4.0), 25.0, 1e-12, 10, "length_sq")
assert_close(vec2.length(3.0, 4.0), 5.0, 1e-12, 11, "length")
assert_close(vec2.distance_sq(1.0, 2.0, 4.0, 6.0), 25.0, 1e-12, 12, "distance_sq")
assert_close(vec2.distance(1.0, 2.0, 4.0, 6.0), 5.0, 1e-12, 13, "distance")
assert_close(vec2.dot(1.0, 2.0, 3.0, 4.0), 11.0, 1e-12, 14, "dot")
assert_close(vec2.cross(1.0, 0.0, 0.0, 1.0), 1.0, 1e-12, 15, "cross positive")
assert_close(vec2.cross(0.0, 1.0, 1.0, 0.0), 0.0 - 1.0, 1e-12, 16, "cross negative")

var a = vec2.add(1.0, 2.0, 3.0, 4.0)
assert_true(!oren_is_err(a), 17, "add ok")
assert_close(a[0], 4.0, 0.0, 18, "add x")
assert_close(a[1], 6.0, 0.0, 19, "add y")

var n = vec2.normalize(3.0, 4.0)
assert_true(!oren_is_err(n), 20, "normalize ok")
assert_close(n[0], 0.6, 1e-12, 21, "normalize x")
assert_close(n[1], 0.8, 1e-12, 22, "normalize y")

var z = vec2.normalize_or_zero(0.0, 0.0)
assert_true(!oren_is_err(z), 23, "normalize_or_zero ok")
assert_close(z[0], 0.0, 0.0, 24, "normalize_or_zero x")
assert_close(z[1], 0.0, 0.0, 25, "normalize_or_zero y")

assert_close(vec2.angle(0.0, 1.0), math.pi() / 2.0, 1e-12, 30, "angle up")
var u = vec2.from_angle(math.pi() / 2.0)
assert_true(!oren_is_err(u), 31, "from_angle ok")
assert_close(u[0], 0.0, 1e-12, 32, "from_angle x")
assert_close(u[1], 1.0, 1e-12, 33, "from_angle y")

var r = vec2.rotate(1.0, 0.0, math.pi() / 2.0)
assert_true(!oren_is_err(r), 34, "rotate ok")
assert_close(r[0], 0.0, 1e-12, 35, "rotate x")
assert_close(r[1], 1.0, 1e-12, 36, "rotate y")

var s = vec2.sub(5.0, 7.0, 2.0, 3.0)
assert_true(!oren_is_err(s), 37, "sub ok")
assert_close(s[0], 3.0, 0.0, 38, "sub x")
assert_close(s[1], 4.0, 0.0, 39, "sub y")

var sc = vec2.scale(2.0, 0.0 - 3.0, 2.5)
assert_true(!oren_is_err(sc), 44, "scale ok")
assert_close(sc[0], 5.0, 0.0, 45, "scale x")
assert_close(sc[1], 0.0 - 7.5, 0.0, 46, "scale y")

var l = vec2.lerp(0.0, 10.0, 10.0, 0.0, 0.25)
assert_true(!oren_is_err(l), 47, "lerp ok")
assert_close(l[0], 2.5, 0.0, 48, "lerp x")
assert_close(l[1], 7.5, 0.0, 49, "lerp y")

var mn = vec2.min(3.0, 0.0 - 4.0, 2.0, 5.0)
assert_true(!oren_is_err(mn), 50, "min ok")
assert_close(mn[0], 2.0, 0.0, 51, "min x")
assert_close(mn[1], 0.0 - 4.0, 0.0, 52, "min y")

var mx = vec2.max(3.0, 0.0 - 4.0, 2.0, 5.0)
assert_true(!oren_is_err(mx), 53, "max ok")
assert_close(mx[0], 3.0, 0.0, 66, "max x")
assert_close(mx[1], 5.0, 0.0, 67, "max y")

var p = vec2.project(3.0, 4.0, 1.0, 0.0)
assert_true(!oren_is_err(p), 54, "project ok")
assert_close(p[0], 3.0, 0.0, 55, "project x")
assert_close(p[1], 0.0, 0.0, 56, "project y")

var q = vec2.reject(3.0, 4.0, 1.0, 0.0)
assert_true(!oren_is_err(q), 57, "reject ok")
assert_close(q[0], 0.0, 0.0, 58, "reject x")
assert_close(q[1], 4.0, 0.0, 59, "reject y")

var rf = vec2.reflect(1.0, 0.0 - 2.0, 0.0, 1.0)
assert_true(!oren_is_err(rf), 60, "reflect ok")
assert_close(rf[0], 1.0, 0.0, 61, "reflect x")
assert_close(rf[1], 2.0, 0.0, 62, "reflect y")

var cl = vec2.clamp(0.0 - 2.0, 7.0, 0.0, 1.0, 5.0, 6.0)
assert_true(!oren_is_err(cl), 68, "clamp ok")
assert_close(cl[0], 0.0, 0.0, 69, "clamp x")
assert_close(cl[1], 6.0, 0.0, 70, "clamp y")

assert_true(oren_is_err(vec2.normalize(0.0, 0.0)), 40, "normalize zero errors")
assert_true(oren_is_err(vec2.length(math.inf(), 1.0)), 41, "length inf errors")
assert_true(oren_is_err(vec2.dot(1.0, 2.0, math.nan(), 4.0)), 42, "dot nan errors")
assert_true(oren_is_err(vec2.rotate(1.0, 0.0, math.inf())), 43, "rotate inf angle errors")
assert_true(oren_is_err(vec2.project(1.0, 2.0, 0.0, 0.0)), 63, "project zero errors")
assert_true(oren_is_err(vec2.reflect(1.0, 2.0, 0.0, 0.0)), 64, "reflect zero normal errors")
assert_true(oren_is_err(vec2.scale(1.0, 2.0, math.inf())), 65, "scale inf errors")
assert_true(oren_is_err(vec2.min(1.0, 2.0, math.nan(), 3.0)), 71, "min nan errors")
assert_true(oren_is_err(vec2.clamp(1.0, 2.0, 5.0, 0.0, 4.0, 3.0)), 72, "clamp bounds errors")

print("module math vec2 OK")
exit(0)
