import ap "../../lib/std/argparse.oren"

fn assert(cond, msg) {
    if !cond {
        print("ASSERT FAIL: " + msg)
        exit(1)
    }
}

fn streq(a, b) {
    if a == nil || b == nil { return false }
    if oren_string_len(a) != oren_string_len(b) { return false }
    var i = 0
    while i < oren_string_len(a) {
        if oren_string_char_at(a, i) != oren_string_char_at(b, i) { return false }
        i = i + 1
    }
    return true
}

fn starts_with(s, pref) {
    if s == nil || pref == nil { return false }
    if oren_string_len(s) < oren_string_len(pref) { return false }
    var i = 0
    while i < oren_string_len(pref) {
        if oren_string_char_at(s, i) != oren_string_char_at(pref, i) { return false }
        i = i + 1
    }
    return true
}

fn has_line(lines, want) {
    var i = 0
    while i < oren_list_len(lines) {
        if streq(lines[i], want) { return true }
        i = i + 1
    }
    return false
}

fn has_line_prefix(lines, pref) {
    var i = 0
    while i < oren_list_len(lines) {
        if starts_with(lines[i], pref) { return true }
        i = i + 1
    }
    return false
}

fn test_help_render() {
    var p = ap.new_parser("tool", "demo tool")
    var c = ap.add_command(p, "run", "run the tool")
    ap.cmd_flag(c, "--verbose", "-v", "verbose mode")
    ap.cmd_option(c, "--out", "-o", "string", "a.out", "output path")
    ap.cmd_option(c, "--n", nil, "int", 3, "count")
    ap.cmd_positional(c, "file", true, "input file")

    var root_lines = ap.render_help_lines(p, nil)
    assert(oren_list_len(root_lines) > 0, "root help non-empty")
    assert(root_lines[0] == "demo tool", "root desc")

    assert(has_line(root_lines, "Commands:"), "root shows Commands:")
    assert(has_line_prefix(root_lines, "  run"), "root shows run command")

    var run_lines = ap.render_help_lines(p, "run")
    assert(oren_list_len(run_lines) > 0, "run help non-empty")

    assert(has_line(run_lines, "Options:"), "run shows Options:")
    assert(has_line_prefix(run_lines, "  --verbose"), "run shows --verbose")
}

fn test_parse() {
    var p = ap.new_parser("tool", "demo tool")
    var c = ap.add_command(p, "run", "run the tool")
    ap.cmd_flag(c, "--verbose", "-v", "verbose mode")
    ap.cmd_option(c, "--out", "-o", "string", "a.out", "output path")
    ap.cmd_option(c, "--n", nil, "int", 3, "count")
    ap.cmd_positional(c, "file", true, "input file")

    var argv = ["run", "-v", "--out=bin", "--n", "7", "in.txt", "--", "x", "y"]
    var r = ap.parse(p, argv)
    if r["ok"] != true {
        if r["err"] != nil { print("parse err: " + r["err"]) }
        if r["help"] != nil { print(r["help"]) }
        assert(false, "parse ok")
    }
    assert(r["cmd"] == "run", "cmd")
    assert(r["opts"]["verbose"] == true, "verbose")
    assert(r["opts"]["out"] == "bin", "out")
    assert(r["opts"]["n"] == 7, "n")
    assert(r["pos"][0] == "in.txt", "pos file")
    assert(r["rest"][0] == "x", "rest x")
    assert(r["rest"][1] == "y", "rest y")
}

fn test_try_parse() {
    var p = ap.new_parser("tool", "demo tool")
    var c = ap.add_command(p, "run", "run the tool")
    ap.cmd_flag(c, "--verbose", "-v", "verbose mode")
    ap.cmd_option(c, "--out", "-o", "string", "a.out", "output path")
    ap.cmd_positional(c, "file", true, "input file")

    var ok = ap.try_parse(p, ["run", "--verbose", "--out", "bin", "in.txt"])
    assert(oren_is_err(ok) != true, "try_parse success is direct map")
    assert(ok["ok"] == true, "try_parse ok flag")
    assert(ok["opts"]["verbose"] == true, "try_parse verbose")
    assert(ok["opts"]["out"] == "bin", "try_parse out")
    assert(ok["pos"][0] == "in.txt", "try_parse positional")

    var help = ap.try_parse(p, ["run", "--help"])
    assert(oren_is_err(help) != true, "try_parse help is direct map")
    assert(help["ok"] == false, "try_parse help ok=false")
    assert(help["code"] == 0, "try_parse help code")
    assert(help["help"] != nil, "try_parse help text")

    var bad = ap.try_parse(p, ["run", "--missing", "in.txt"])
    assert(oren_is_err(bad) == true, "try_parse parse error becomes oren_err")
    assert(oren_err_code(bad) == 2, "try_parse parse error code")
    assert(oren_err_msg(bad) != nil, "try_parse parse error message")
}

fn test_no_flag_sets_false() {
    var p = ap.new_parser("tool", "demo tool")
    var c = ap.add_command(p, "run", "run the tool")
    ap.cmd_flag(c, "--verbose", "-v", "verbose mode")

    var r0 = ap.parse(p, ["run", "--verbose"])
    assert(r0["ok"] == true, "verbose parse ok")
    assert(r0["opts"]["verbose"] == true, "verbose true")

    var r1 = ap.parse(p, ["run", "--no-verbose"])
    assert(r1["ok"] == true, "no-verbose parse ok")
    assert(r1["opts"]["verbose"] == false, "verbose false via --no-verbose")
}

fn test_counted_flags() {
    var p = ap.new_parser("tool", "demo tool")
    var c = ap.add_command(p, "run", "run the tool")
    ap.cmd_flag_count(c, "--verbose", "-v", "verbosity level")

    var r0 = ap.parse(p, ["run"])
    assert(r0["ok"] == true, "count default parse ok")
    assert(r0["opts"]["verbose"] == 0, "count default 0")

    var r1 = ap.parse(p, ["run", "-vvv"])
    assert(r1["ok"] == true, "count -vvv parse ok")
    assert(r1["opts"]["verbose"] == 3, "count -vvv => 3")

    var r2 = ap.parse(p, ["run", "--verbose", "--verbose"])
    assert(r2["ok"] == true, "count repeated long parse ok")
    assert(r2["opts"]["verbose"] == 2, "count repeated long => 2")
}

fn test_all_opts_merge() {
    var p = ap.new_parser("tool", "demo tool")
    ap.cmd_flag(ap.root(p), "--trace", "-t", "trace mode")
    var c = ap.add_command(p, "run", "run the tool")
    ap.cmd_option(c, "--out", "-o", "string", "a.out", "output path")

    var r = ap.parse(p, ["--trace", "run", "--out", "bin"])
    assert(r["ok"] == true, "merge parse ok")
    assert(r["root_opts"]["trace"] == true, "root trace")
    assert(r["opts"]["out"] == "bin", "cmd out")
    assert(r["all_opts"]["trace"] == true, "all_opts includes root")
    assert(r["all_opts"]["out"] == "bin", "all_opts includes cmd")
}

fn test_help_early_exit() {
    var p = ap.new_parser("tool", "demo tool")
    var c = ap.add_command(p, "run", "run the tool")
    ap.cmd_flag(c, "--verbose", "-v", "verbose mode")

    var argv = ["run", "--help"]
    var r = ap.parse(p, argv)
    assert(r["ok"] == false, "help returns ok=false")
    assert(r["code"] == 0, "help code 0")
    assert(r["help"] != nil, "help text present")
}

test_help_render()
test_parse()
test_try_parse()
test_no_flag_sets_false()
test_counted_flags()
test_all_opts_merge()
test_help_early_exit()
print("ok")
exit(0)
