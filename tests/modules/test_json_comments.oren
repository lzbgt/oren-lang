import json "../../lib/std/json.oren"

fn assert(cond, msg) {
    if !cond {
        print("ASSERT FAIL: " + msg)
        exit(1)
    }
}

fn test_line_comments() {
    var s = "// leading\n" +
        "{\n" +
        "  // key comment\n" +
        "  \"a\": 1, // trailing\n" +
        "  \"b\": true\n" +
        "}// end\n"
    var r = json.decode(s)
    assert(r["ok"] == 1, "decode with // comments")
    var out = json.encode(r["v"])
    assert(out == "{\"a\":1,\"b\":true}", "canonical encode")
}

fn test_block_comments() {
    var s = "{/*a*/\"a\":1,/*b*/\"b\":false/*end*/}"
    var r = json.decode(s)
    assert(r["ok"] == 1, "decode with /* */ comments")
    var out = json.encode(r["v"])
    assert(out == "{\"a\":1,\"b\":false}", "canonical encode")
}

test_line_comments()
test_block_comments()
print("ok")
exit(0)
