import bytes "../../lib/std/bytes.oren"
import fs "../../lib/std/fs.oren"

fn fail(code) {
    print("module fs_std FAIL " + oren_int_to_string(code))
    exit(code)
}

fn has_name(names, want) {
    var i = 0
    while i < oren_list_len(names) {
        if names[i] == want { return true }
        i = i + 1
    }
    return false
}

var text_path = "build/tmp/std_fs_text.txt"
var bytes_path = "build/tmp/std_fs_bytes.bin"

var wt = fs.write_text(text_path, "hello fs")
if oren_is_err(wt) { fail(1) }
if fs.exists(text_path) != true { fail(2) }
if fs.exists("build/tmp/std_fs_missing.txt") != false { fail(3) }

var rt = fs.read_text(text_path)
if oren_is_err(rt) { fail(4) }
if rt != "hello fs" { fail(5) }
if !oren_is_err(fs.read_text("build/tmp/std_fs_missing.txt")) { fail(6) }

var src = bytes.pack([1, 2, 3, 255])
if oren_is_err(src) { fail(10) }
var wb = fs.write_bytes(bytes_path, src)
if oren_is_err(wb) { fail(11) }

var rb = fs.read_u8_buf(bytes_path)
if oren_is_err(rb) { fail(12) }
if bytes.len(rb) != 4 { fail(13) }
if bytes.get_u8(rb, 0) != 1 { fail(14) }
if bytes.get_u8(rb, 3) != 255 { fail(15) }

var legacy = fs.read_byte_list(bytes_path)
if oren_is_err(legacy) { fail(16) }
if oren_list_len(legacy) != 4 { fail(17) }
if legacy[1] != 2 || legacy[3] != 255 { fail(18) }

var names = fs.list_dir("build/tmp")
if oren_is_err(names) { fail(20) }
if has_name(names, "std_fs_text.txt") != true { fail(21) }
if has_name(names, "std_fs_bytes.bin") != true { fail(22) }

var root = "build/tmp"
var wt2 = fs.write_text_under(root, ["std_fs_under.txt"], "under root")
if oren_is_err(wt2) { fail(30) }
if fs.exists_under(root, ["std_fs_under.txt"]) != true { fail(31) }
if fs.read_text_under(root, ["std_fs_under.txt"]) != "under root" { fail(32) }
var sub_names = fs.list_dir_under(root, [])
if oren_is_err(sub_names) { fail(33) }
if has_name(sub_names, "std_fs_under.txt") != true { fail(34) }

var wb2 = fs.write_bytes_under(root, ["std_fs_under.bin"], src)
if oren_is_err(wb2) { fail(35) }
var rb2 = fs.read_u8_buf_under(root, ["std_fs_under.bin"])
if oren_is_err(rb2) { fail(36) }
if bytes.len(rb2) != 4 || bytes.get_u8(rb2, 3) != 255 { fail(37) }
var legacy2 = fs.read_byte_list_under(root, ["std_fs_under.bin"])
if oren_is_err(legacy2) { fail(38) }
if oren_list_len(legacy2) != 4 || legacy2[0] != 1 { fail(39) }

if !oren_is_err(fs.write_text_under(root, ["..", "escape.txt"], "bad")) { fail(40) }
if !oren_is_err(fs.read_text_under(root, ["/etc/passwd"])) { fail(41) }
if !oren_is_err(fs.exists_under(root, ["..", "escape.txt"])) { fail(42) }

print("module fs_std OK")
exit(0)
