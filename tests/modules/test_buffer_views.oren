import buffer "../../lib/std/buffer.oren"
import bytes "../../lib/std/bytes.oren"
import linalg "../../lib/std/linalg.oren"

fn fail(code) {
    print("module buffer_views FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    fail(code)
}

// Smoke: i32 buffer basic load/store.
var b: []i32 = buffer.i32_new(6)
assert_true(!oren_is_err(b), 10)

var i = 0
while i < 6 {
    var r = oren_buf_store_i32(b, i, 10 + i)
    assert_true(!oren_is_err(r), 11 + i)
    i = i + 1
}
assert_eq(oren_buf_load_i32(b, 0), 10, 20)
assert_eq(oren_buf_load_i32(b, 5), 15, 21)

// Slice view (zero-copy)
// Also validates that `[]T` parses in more than one place (locals + fn params).
fn buf_len_i32(x: []i32): i64 { return oren_buf_len(x) }
var b_alias: []i32 = b
assert_eq(buf_len_i32(b_alias), 6, 29)
var u8_into: []u8 = buffer.u8_new(3)
assert_true(!oren_is_err(u8_into), 86)
assert_true(!oren_is_err(buffer.u8_pack_into(u8_into, [65, 66, 67])), 87)
assert_eq(buffer.u8_to_string(u8_into), "ABC", 88)
assert_true(oren_is_err(buffer.u8_pack_into(u8_into, [1, 2])), 89)
assert_true(oren_is_err(buffer.u8_pack_into(u8_into, [1, 2, 300])), 90)
assert_eq(buffer.u8_to_string(u8_into), "ABC", 91)
var u8_stride_back: []u8 = buffer.u8_from_string("a_b_c")
assert_true(!oren_is_err(u8_stride_back), 92)
var u8_stride = buffer.strided_new(u8_stride_back, 0, 3, 2)
assert_true(!oren_is_err(u8_stride), 93)
assert_true(!oren_is_err(buffer.strided_copy_from_string(u8_stride, "XYZ")), 94)
assert_eq(buffer.u8_to_string(u8_stride_back), "X_Y_Z", 95)
assert_true(!oren_is_err(buffer.strided_copy_from_bytes(u8_stride, [49, 50, 51])), 96)
assert_eq(buffer.u8_to_string(u8_stride_back), "1_2_3", 97)
assert_true(!oren_is_err(buffer.strided_copy_from_u8_buf(u8_stride, buffer.u8_from_string("uvw"))), 98)
assert_eq(buffer.u8_to_string(u8_stride_back), "u_v_w", 99)
var u8_stride_out: []u8 = buffer.strided_to_u8_buf(u8_stride)
assert_true(!oren_is_err(u8_stride_out), 100)
assert_eq(buffer.u8_to_string(u8_stride_out), "uvw", 101)
assert_eq(buffer.strided_to_string(u8_stride), "uvw", 102)
var slice = buffer.slice_new(b, 2, 3)
assert_true(!oren_is_err(slice), 30)
assert_eq(buffer.slice_len(slice), 3, 31)
assert_eq(buffer.slice_load_i32(slice, 0), 12, 32)
assert_eq(buffer.slice_load_i32(slice, 2), 14, 33)

// Write through view.
var w = buffer.slice_store_i32(slice, 1, 99)
assert_true(!oren_is_err(w), 34)
var got = oren_buf_load_i32(b, 3)
assert_eq(got, 99, 35)

// Slice of slice (still zero-copy).
var sub = buffer.slice_slice(slice, 1, 2)
assert_true(!oren_is_err(sub), 36)
assert_eq(buffer.slice_len(sub), 2, 37)
assert_eq(buffer.slice_load_i32(sub, 0), 99, 38)
assert_eq(buffer.slice_load_i32(sub, 1), 14, 39)

// `for x in <typed-buffer view>` must iterate values (not the metadata list).
var sum = 0
for x in slice {
    sum = sum + x
}
assert_eq(sum, 12 + 99 + 14, 40)

// f32 matrix view over a flat buffer
var fb: []f32 = buffer.f32_new(4)
assert_true(!oren_is_err(fb), 40)
oren_buf_store_f32(fb, 0, 1.0)
oren_buf_store_f32(fb, 1, 2.0)
oren_buf_store_f32(fb, 2, 3.0)
oren_buf_store_f32(fb, 3, 4.0)
var m = buffer.mat_view_new(fb, 0, 2, 2, 2)
assert_true(!oren_is_err(m), 41)
assert_eq(buffer.mat_load_f32(m, 0, 0), 1.0, 42)
assert_eq(buffer.mat_load_f32(m, 1, 0), 3.0, 43)

// Ensure store path works and preserves float32 boundary determinism (via runtime store_f32).
buffer.mat_store_f32(m, 1, 1, 123.25)
assert_eq(oren_buf_load_f32(fb, 3), f32(123.25), 44)

// Strided view over a buffer (every 2nd element)
var bs: []i32 = buffer.i32_new(8)
assert_true(!oren_is_err(bs), 45)
i = 0
while i < 8 {
    oren_buf_store_i32(bs, i, i + 1) // 1..8
    i = i + 1
}
var st = buffer.strided_new(bs, 0, 4, 2) // [1,3,5,7]
assert_true(!oren_is_err(st), 46)
assert_eq(buffer.strided_len(st), 4, 47)
assert_eq(buffer.strided_load_i32(st, 0), 1, 48)
assert_eq(buffer.strided_load_i32(st, 3), 7, 49)
var sum2 = 0
for x in st {
    sum2 = sum2 + x
}
assert_eq(sum2, 1 + 3 + 5 + 7, 50)

// Buffer dot (i32)
var b2 = buffer.i32_new(6)
assert_true(!oren_is_err(b2), 50)
i = 0
while i < 6 {
    var r2 = oren_buf_store_i32(b2, i, 1)
    assert_true(!oren_is_err(r2), 51 + i)
    i = i + 1
}
assert_eq(oren_buf_load_i32(b2, 0), 1, 58)
assert_eq(oren_buf_load_i32(b2, 5), 1, 59)
assert_eq(oren_buf_reduce_sum_i32(b2), 6, 60)
var d = oren_buf_dot_i32(b, b2)
if oren_is_err(d) {
    print("module buffer_views dot_i32 err")
    exit(62)
}
var expected = 10 + 11 + 12 + 99 + 14 + 15
if d != expected {
    print("module buffer_views dot_i32 mismatch got=" + oren_int_to_string(d) + " expected=" + oren_int_to_string(expected))
    exit(63)
}

// Dot over views (slice + strided) via std/linalg helpers.
var d_view = linalg.dot_i32_view(slice, slice)
assert_true(!oren_is_err(d_view), 64)
assert_eq(d_view, 12 * 12 + 99 * 99 + 14 * 14, 65)

var d_strided = linalg.dot_i32_view(st, st) // [1,3,5,7] dot itself
assert_true(!oren_is_err(d_strided), 66)
assert_eq(d_strided, 1 * 1 + 3 * 3 + 5 * 5 + 7 * 7, 67)

// Matmul over strided matrix views (padding in row_stride).
var Aback: []f32 = buffer.f32_new(9)
var Bback: []f32 = buffer.f32_new(12)
assert_true(!oren_is_err(Aback), 70)
assert_true(!oren_is_err(Bback), 71)

// A is 2x3, row_stride=4, off=1
oren_buf_store_f32(Aback, 1 + 0 * 4 + 0, 1.0)
oren_buf_store_f32(Aback, 1 + 0 * 4 + 1, 2.0)
oren_buf_store_f32(Aback, 1 + 0 * 4 + 2, 3.0)
oren_buf_store_f32(Aback, 1 + 1 * 4 + 0, 4.0)
oren_buf_store_f32(Aback, 1 + 1 * 4 + 1, 5.0)
oren_buf_store_f32(Aback, 1 + 1 * 4 + 2, 6.0)
var A = buffer.mat_view_new(Aback, 1, 2, 3, 4)
assert_true(!oren_is_err(A), 72)

// B is 3x2, row_stride=3, off=2
oren_buf_store_f32(Bback, 2 + 0 * 3 + 0, 7.0)
oren_buf_store_f32(Bback, 2 + 0 * 3 + 1, 8.0)
oren_buf_store_f32(Bback, 2 + 1 * 3 + 0, 9.0)
oren_buf_store_f32(Bback, 2 + 1 * 3 + 1, 10.0)
oren_buf_store_f32(Bback, 2 + 2 * 3 + 0, 11.0)
oren_buf_store_f32(Bback, 2 + 2 * 3 + 1, 12.0)
var B = buffer.mat_view_new(Bback, 2, 3, 2, 3)
assert_true(!oren_is_err(B), 73)

var C = linalg.matmul_f32_mat_view(A, B)
assert_true(!oren_is_err(C), 74)
assert_eq(oren_buf_len(C), 4, 75)
assert_eq(oren_buf_load_f32(C, 0), 58.0, 76)
assert_eq(oren_buf_load_f32(C, 1), 64.0, 77)
assert_eq(oren_buf_load_f32(C, 2), 139.0, 78)
assert_eq(oren_buf_load_f32(C, 3), 154.0, 79)

var u8back: []u8 = buffer.u8_new(4)
assert_true(!oren_is_err(u8back), 80)
var u8m = buffer.mat_view_new(u8back, 0, 2, 2, 2)
assert_true(!oren_is_err(u8m), 81)
assert_true(!oren_is_err(buffer.u8_mat_copy_from_flat(u8m, [65, 66, 67, 68])), 82)
assert_eq(buffer.u8_mat_to_string(u8m), "ABCD", 83)
assert_true(!oren_is_err(buffer.u8_mat_copy_from_rows(u8m, [[49, 50], [51, 52]])), 84)
assert_eq(buffer.u8_mat_to_string(u8m), "1234", 85)
var u8pad: []u8 = buffer.u8_from_string("xABxCD")
assert_true(!oren_is_err(u8pad), 86)
var u8pad_m = buffer.mat_view_new(u8pad, 1, 2, 2, 3)
assert_true(!oren_is_err(u8pad_m), 87)
assert_eq(buffer.u8_to_string(buffer.u8_mat_to_u8_buf(u8pad_m)), "ABCD", 88)
assert_eq(buffer.u8_mat_to_string(u8pad_m), "ABCD", 89)
assert_eq(bytes.to_string(buffer.u8_mat_to_bytes(u8pad_m)), "ABCD", 90)

print("module buffer_views OK")
exit(0)
