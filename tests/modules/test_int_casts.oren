import ints "../../lib/std/ints.oren"

if ints.u8(256 + 5) != 5 { exit(1) }
if ints.u8(-1) != 255 { exit(2) }
if ints.i8(255) != -1 { exit(3) }
if ints.i8(128) != -128 { exit(4) }

if ints.u16(65536 + 7) != 7 { exit(5) }
if ints.u16(-1) != 65535 { exit(6) }
if ints.i16(65535) != -1 { exit(7) }
if ints.i16(32768) != -32768 { exit(8) }

if ints.u32(4294967296 + 9) != 9 { exit(9) }
if ints.u32(-1) != 4294967295 { exit(10) }
if ints.i32(4294967295) != -1 { exit(11) }
if ints.i32(2147483648) != -2147483648 { exit(12) }

if ints.u8(1.9) != 1 { exit(13) }
if ints.u8(-1.9) != 255 { exit(14) }
if ints.i32(1.9) != 1 { exit(15) }
if ints.i32(-1.9) != -1 { exit(16) }

print("module int_casts OK")
exit(0)
