// Regression: type annotations are language-level (not attributes) and must have
// immediate compile-time meaning for deterministic code.
//
// Rolling semantics (v0):
// - struct/class values are immutable handles
// - field type annotations normalize values at construction time (wrap/truncate)
// - this must work cross-backend (C/native/bytecode) because it is an AST lowering

struct H {
    a: u8,
    b: i8,
    c: u16,
    d: i16,
    e: u32,
    f: i32,
    ok: bool
}

var h = H(
    256 + 5,          // u8 -> 5
    255,              // i8 -> -1
    65536 + 7,        // u16 -> 7
    65535,            // i16 -> -1
    4294967296 + 9,   // u32 -> 9
    4294967295,       // i32 -> -1
    123               // bool -> true
)

if h.a != 5 { exit(1) }
if h.b != -1 { exit(2) }
if h.c != 7 { exit(3) }
if h.d != -1 { exit(4) }
if h.e != 9 { exit(5) }
if h.f != -1 { exit(6) }
if h.ok != true { exit(7) }

struct BoolBox {
    ok: bool
}
var bf = BoolBox(false)
if bf.ok == true { exit(70) }
var bt = BoolBox(true)
if bt.ok != true { exit(71) }
var bc = BoolBox(3 == 4)
if bc.ok == true { exit(72) }

// f32 rounding: 16777217 (2^24+1) is not representable in float32; it rounds to 16777216.
struct F32Box {
    x: f32
}
var b = F32Box(16777217.0)
if b.x != 16777216.0 { exit(8) }

fn check_f32_box_param(x: F32Box): i64 {
    if x.x != 16777216.0 { return 9 }
    return 0
}

fn read_f32_box(x: F32Box): f64 {
    return x.x
}

fn check_f32_box_local(): i64 {
    var lb = F32Box(16777217.0)
    if lb.x != 16777216.0 { return 10 }
    return 0
}

if check_f32_box_param(b) != 0 { exit(9) }
if check_f32_box_local() != 0 { exit(10) }
if read_f32_box(b) != 16777216.0 { exit(11) }

print("module typed_struct_fields OK")
exit(0)
