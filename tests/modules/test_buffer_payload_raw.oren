import buffer "../../lib/std/buffer.oren"

fn fail(code) {
    print("module buffer_payload_raw FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

// Typed buffer payloads must be tracked as RAW bytes (opaque/unscanned), not as pointer-containing memory.
// This is a core HPC guarantee: payload bytes must never be treated as GC pointers.

var b0: []i32 = buffer.i32_new(0)
assert_eq(oren_buf_payload_is_raw(b0), true, 10)

var b1: []i32 = buffer.i32_new(8)
assert_eq(oren_buf_payload_is_raw(b1), true, 20)

var b2: []f32 = buffer.f32_new(8)
assert_eq(oren_buf_payload_is_raw(b2), true, 30)

print("module buffer_payload_raw OK")
exit(0)

