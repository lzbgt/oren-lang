import buffer "../../lib/std/buffer.oren"
import bytes "../../lib/std/bytes.oren"

fn fail(code) {
    print("module u8_buf_bytes_helpers FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    fail(code)
}

// Create a u8 buffer and write bytes into it.
var b: []u8 = buffer.u8_new(8)
assert_true(!oren_is_err(b), 10)

assert_true(!oren_is_err(oren_buf_store_u8(b, 0, 0x01)), 11)
assert_true(!oren_is_err(oren_buf_store_u8(b, 1, 0x02)), 12)
assert_true(!oren_is_err(oren_buf_store_u8(b, 2, 0x03)), 13)
assert_true(!oren_is_err(oren_buf_store_u8(b, 3, 0x04)), 14)

// bytes_get_* helpers must work on u8 buffers as "bytes".
assert_eq(oren_bytes_get_u16_be(b, 0), 0x0102, 20)
assert_eq(oren_bytes_get_u16_le(b, 0), 0x0201, 21)
assert_eq(oren_bytes_get_u32_be(b, 0), 0x01020304, 22)
assert_eq(oren_bytes_get_u32_le(b, 0), 0x04030201, 23)

// bytes_set_* helpers must also work on u8 buffers as "bytes" (in-place).
assert_true(!oren_is_err(oren_bytes_set_u16_be(b, 4, 0xABCD)), 30)
assert_eq(oren_buf_load_u8(b, 4), 0xAB, 31)
assert_eq(oren_buf_load_u8(b, 5), 0xCD, 32)

assert_true(!oren_is_err(oren_bytes_set_u32_le(b, 0, 0x11223344)), 40)
assert_eq(oren_buf_load_u8(b, 0), 0x44, 41)
assert_eq(oren_buf_load_u8(b, 1), 0x33, 42)
assert_eq(oren_buf_load_u8(b, 2), 0x22, 43)
assert_eq(oren_buf_load_u8(b, 3), 0x11, 44)

var bv = bytes.view(b, "test.u8_buf")
assert_true(!oren_is_err(bv), 50)
assert_eq(bytes.view_len(bv), 8, 51)
assert_eq(bytes.view_get_u8(bv, 0), 0x44, 52)
assert_eq(bytes.view_get_u32_le(bv, 0), 0x11223344, 53)
assert_eq(bytes.view_get_u16_be(bv, 0), 0x4433, 54)
assert_eq(bytes.view_get_u32_be(bv, 0), 0x44332211, 55)
assert_eq(bytes.view_get_u64_be(bv, 0), 0x44332211ABCD0000, 56)
assert_eq(bytes.view_get_u16_le(bv, 0), 0x3344, 57)
var bv_data = bytes.view_bytes(bv)
var bv_ptr = bytes.view_ptr(bv)
assert_eq(bytes.view_get_u16_le_from(bv_data, bv_ptr, 0), 0x3344, 58)
assert_eq(bytes.view_get_u32_le_from(bv_data, bv_ptr, 0), 0x11223344, 59)
assert_eq(bytes.view_get_u64_le_from(bv_data, bv_ptr, 0), 0x0000ABCD11223344, 60)

var lv = bytes.view([0x44, 0x33, 0x22, 0x11], "test.list")
assert_true(!oren_is_err(lv), 70)
assert_eq(bytes.view_len(lv), 4, 71)
assert_eq(bytes.view_get_u8(lv, 1), 0x33, 72)
assert_eq(bytes.view_get_u32_le(lv, 0), 0x11223344, 73)
assert_true(oren_is_err(bytes.view_get_u32_le(lv, 1)) == true, 74)
assert_eq(bytes.view_get_u16_be(lv, 0), 0x4433, 75)
assert_eq(bytes.view_get_u32_be(lv, 0), 0x44332211, 76)
assert_true(oren_is_err(bytes.view_get_u64_be(lv, 0)) == true, 77)
assert_eq(bytes.view_get_u16_le(lv, 0), 0x3344, 78)
assert_true(oren_is_err(bytes.view_get_u16_le(lv, 3)) == true, 79)
var lv_data = bytes.view_bytes(lv)
var lv_ptr = bytes.view_ptr(lv)
assert_eq(bytes.view_get_u16_le_from(lv_data, lv_ptr, 0), 0x3344, 80)
assert_eq(bytes.view_get_u32_le_from(lv_data, lv_ptr, 0), 0x11223344, 81)
assert_true(oren_is_err(bytes.view_get_u64_le_from(lv_data, lv_ptr, 0)) == true, 82)

print("module u8_buf_bytes_helpers OK")
exit(0)
