import bytes "std:bytes"

trait AliasBytesMarker {
    fn marker(self);
}

impl AliasBytesMarker for bytes {
    fn marker(self) { return "ok" }
}

fn main() {
    if bytes.from_string("x").marker() != "ok" {
        print("builtin type alias method FAIL")
        exit(1)
    }
    print("builtin type alias method OK")
    exit(0)
}

main()
