import math "../../lib/std/math.oren"

fn fail(code) {
    print("module math_rounding FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

// floor/ceil
assert_eq(math.floor(1.0), 1.0, 10)
assert_eq(math.floor(1.2), 1.0, 11)
assert_eq(math.floor(-1.2), -2.0, 12)

assert_eq(math.ceil(1.0), 1.0, 20)
assert_eq(math.ceil(1.2), 2.0, 21)
assert_eq(math.ceil(-1.2), -1.0, 22)

// round half away from zero
assert_eq(math.round(1.49), 1.0, 30)
assert_eq(math.round(1.5), 2.0, 31)
assert_eq(math.round(-1.49), -1.0, 32)
assert_eq(math.round(-1.5), -2.0, 33)

// -0.0 sign must be preserved through rounding (bit-level check).
assert_eq(bitcast[u64](math.round(-0.0)), bitcast[u64](-0.0), 40)
assert_eq(bitcast[u64](math.floor(-0.0)), bitcast[u64](-0.0), 41)
assert_eq(bitcast[u64](math.ceil(-0.0)), bitcast[u64](-0.0), 42)

print("module math_rounding OK")
exit(0)

