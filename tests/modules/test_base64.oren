import base64 "../../lib/std/encoding/base64.oren"
import bytes "../../lib/std/bytes.oren"

fn fail(code, msg) {
    print("module base64 FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_err(x, code, msg) {
    if oren_is_err(x) == true { return 0 }
    fail(code, msg)
}

var encoded = base64.encode_bytes([77, 97, 110])
assert_true(oren_is_err(encoded) != true, 10, "encode_bytes ok")
assert_true(encoded == "TWFu", 11, "encode_bytes value")
assert_true(base64.encode(bytes.from_string("Man")) == "TWFu", 12, "encode canonical value")
assert_true(bytes.from_string("Man").base64() == "TWFu", 13, "bytes base64 method value")
assert_true(base64.encode_bytes(bytes.from_string("Many")) == "TWFueQ==", 14, "encode u8_buf direct value")

var decoded = base64.decode_bytes("TWFu")
assert_true(oren_is_err(decoded) != true, 20, "parse_bytes ok")
assert_true(bytes.len(decoded) == 3, 21, "parse_bytes len")
assert_true(bytes.get_u8(decoded, 0) == 77, 22, "parse_bytes byte0")
assert_true(bytes.get_u8(decoded, 1) == 97, 23, "parse_bytes byte1")
assert_true(bytes.get_u8(decoded, 2) == 110, 24, "parse_bytes byte2")

var decoded_ws = base64.decode_bytes("TQ==\n")
assert_true(oren_is_err(decoded_ws) != true, 30, "parse_bytes accepts whitespace")
assert_true(bytes.len(decoded_ws) == 1, 31, "parse_bytes whitespace len")
assert_true(bytes.get_u8(decoded_ws, 0) == 77, 32, "parse_bytes whitespace byte")

var strict_ok = base64.decode_bytes_strict("TQ==")
assert_true(oren_is_err(strict_ok) != true, 40, "parse_bytes_strict ok")
assert_true(bytes.get_u8(strict_ok, 0) == 77, 41, "parse_bytes_strict byte")
assert_true(base64.decode("TWFu").text() == "Man", 42, "decode canonical text")
assert_true("TWFu".base64_bytes().text() == "Man", 43, "string base64 bytes method")
assert_true("TWFu".base64_bytes_strict().text() == "Man", 44, "string base64 strict method")
assert_true(base64.encode_url(bytes.pack([251, 255, 255])) == "-___", 45, "base64url alphabet")
assert_true(base64.encode_url(bytes.from_string("Ma")) == "TWE", 46, "base64url unpadded")
assert_true(bytes.from_string("Man").base64_url() == "TWFu", 47, "bytes base64url method")
assert_true(base64.encode_url(bytes.from_string("Many")) == "TWFueQ", 52, "base64url u8_buf direct")
assert_true(base64.decode_url("-___").hex() == "fbffff", 48, "base64url decode alphabet")
assert_true(base64.decode_url("TWE").text() == "Ma", 49, "base64url decode unpadded")
assert_true(base64.decode_url("TWE=").text() == "Ma", 50, "base64url decode padded")
assert_true("TWFu".base64_url_bytes().text() == "Man", 51, "string base64url bytes method")

assert_err(base64.encode_bytes(123), 60, "encode_bytes invalid input")
assert_err(base64.decode_bytes("!!!"), 61, "parse_bytes invalid alphabet")
assert_err(base64.decode_bytes("TQ="), 62, "parse_bytes invalid length")
assert_err(base64.decode_bytes_strict("TQ==\n"), 63, "parse_bytes_strict rejects whitespace")
assert_err(base64.decode_bytes("TW=u"), 64, "parse_bytes rejects third-char padding without fourth")
assert_err(base64.decode_bytes("TQ==TQ=="), 65, "parse_bytes rejects data after padded group")
assert_err(base64.decode_bytes("TQ==\nTQ=="), 66, "parse_bytes rejects data after padded group with whitespace")
assert_err(base64.decode_url("TWF+"), 67, "base64url rejects standard plus")
assert_err(base64.decode_url("TWF/"), 68, "base64url rejects standard slash")
assert_err(base64.decode_url("T WFu"), 69, "base64url rejects whitespace")
assert_err(base64.decode_url("T"), 70, "base64url rejects impossible length")
assert_err(base64.decode_url("T=WF"), 71, "base64url rejects interior padding")
assert_err(base64.decode_bytes("TR=="), 72, "parse_bytes rejects nonzero one-byte padding bits")
assert_err(base64.decode_bytes("TWH="), 73, "parse_bytes rejects nonzero two-byte padding bits")
assert_err(base64.decode_url("TR"), 74, "base64url rejects nonzero one-byte padding bits")
assert_err(base64.decode_url("TWH"), 75, "base64url rejects nonzero two-byte padding bits")

print("module base64 OK")
exit(0)
