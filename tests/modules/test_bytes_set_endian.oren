// Module/C backend regression: endian-aware writes to list<int> must exist.

import buffer "../../lib/std/buffer.oren"

var b16 = [0, 0]
if oren_bytes_set_u16_be(b16, 0, 4660) != 4660 { exit(1) }
if b16[0] != 18 || b16[1] != 52 { exit(2) }
if oren_bytes_get_u16_be(b16, 0) != 4660 { exit(3) }

var b16n = [0, 0]
if oren_bytes_set_i16_be(b16n, 0, -2) != -2 { exit(4) }
if b16n[0] != 255 || b16n[1] != 254 { exit(5) }
if oren_bytes_get_i16_be(b16n, 0) != -2 { exit(6) }

var b32 = [0, 0, 0, 0]
if oren_bytes_set_u32_be(b32, 0, 16909060) != 16909060 { exit(7) }
if b32[0] != 1 || b32[1] != 2 || b32[2] != 3 || b32[3] != 4 { exit(8) }
if oren_bytes_get_u32_be(b32, 0) != 16909060 { exit(9) }

var b32n = [0, 0, 0, 0]
if oren_bytes_set_i32_be(b32n, 0, -2) != -2 { exit(10) }
if b32n[0] != 255 || b32n[3] != 254 { exit(11) }
if oren_bytes_get_i32_be(b32n, 0) != -2 { exit(12) }

var b64 = [0, 0, 0, 0, 0, 0, 0, 0]
if oren_bytes_set_u64_be(b64, 0, 72623859790382856) != 72623859790382856 { exit(13) } // 0x0102030405060708
if b64[0] != 1 || b64[1] != 2 || b64[6] != 7 || b64[7] != 8 { exit(14) }
if oren_bytes_get_u64_be(b64, 0) != 72623859790382856 { exit(15) }

var b64le = [0, 0, 0, 0, 0, 0, 0, 0]
if oren_bytes_set_u64_le(b64le, 0, 72623859790382856) != 72623859790382856 { exit(16) }
if b64le[0] != 8 || b64le[7] != 1 { exit(17) }
if oren_bytes_get_u64_le(b64le, 0) != 72623859790382856 { exit(18) }

var b64n = [0, 0, 0, 0, 0, 0, 0, 0]
if oren_bytes_set_i64_be(b64n, 0, -2) != -2 { exit(19) }
if b64n[0] != 255 || b64n[7] != 254 { exit(20) }
if oren_bytes_get_i64_be(b64n, 0) != -2 { exit(21) }

var ub: []u8 = buffer.u8_new(8)
if oren_is_err(ub) { exit(22) }
if oren_bytes_set_u64_be(ub, 0, 72623859790382856) != 72623859790382856 { exit(23) }
if oren_bytes_get_u64_be(ub, 0) != 72623859790382856 { exit(24) }
if oren_buf_load_u8(ub, 0) != 1 || oren_buf_load_u8(ub, 7) != 8 { exit(25) }
if oren_bytes_set_u64_le(ub, 0, 72623859790382856) != 72623859790382856 { exit(26) }
if oren_bytes_get_u64_le(ub, 0) != 72623859790382856 { exit(27) }
if oren_buf_load_u8(ub, 0) != 8 || oren_buf_load_u8(ub, 7) != 1 { exit(28) }

if oren_is_err(oren_bytes_get_u16_be([0, 256], 0)) == false { exit(29) }
if oren_is_err(oren_bytes_get_u16_be([0], 0)) == false { exit(30) }
if oren_is_err(oren_bytes_set_u16_be([0], 0, 1)) == false { exit(31) }
var boxed_len_ok = [1, 2, 3]
if oren_bytes_len(boxed_len_ok) != 3 { exit(54) }

var li = oren_new_list_int(0)
oren_list_int_push(li, 65)
oren_list_int_push(li, 66)
oren_list_int_push(li, 67)
oren_list_int_push(li, 68)
if oren_bytes_len(li) != 4 { exit(32) }
if oren_bytes_get_u16_be(li, 1) != 16963 { exit(33) }
if oren_bytes_get_u32_le(li, 0) != 1145258561 { exit(34) }
if oren_bytes_to_hex(li) != "41424344" { exit(35) }
var li_packed = oren_bytes_pack(li)
if oren_is_err(li_packed) { exit(36) }
if oren_bytes_get_u8(li_packed, 3) != 68 { exit(37) }
var li_empty = oren_new_list_int(0)
var li_empty_packed = oren_bytes_pack(li_empty)
if oren_is_err(li_empty_packed) { exit(48) }
if oren_bytes_len(li_empty_packed) != 0 { exit(49) }
var li_xs = oren_bytes_unpack(li)
if oren_is_err(li_xs) { exit(38) }
if li_xs[2] != 67 { exit(39) }
var li_empty_xs = oren_bytes_unpack(li_empty)
if oren_is_err(li_empty_xs) { exit(50) }
if oren_list_len(li_empty_xs) != 0 { exit(51) }
var li_s = oren_string_from_bytes_slice(li, 1, 2)
if oren_is_err(li_s) { exit(40) }
if li_s != "BC" { exit(41) }
var li_buf = oren_u8_buf_from_bytes_slice(li, 1, 3)
if oren_is_err(li_buf) { exit(42) }
if oren_bytes_len(li_buf) != 3 { exit(43) }
if oren_bytes_get_u8(li_buf, 0) != 66 || oren_bytes_get_u8(li_buf, 2) != 68 { exit(44) }
if oren_is_err(oren_u8_buf_from_bytes_slice(li, 3, 2)) == false { exit(45) }

var bad_li = oren_new_list_int(0)
oren_list_int_push(bad_li, 65)
oren_list_int_push(bad_li, 300)
if oren_is_err(oren_string_from_bytes_slice(bad_li, 0, 2)) == false { exit(46) }
if oren_is_err(oren_u8_buf_from_bytes_slice(bad_li, 0, 2)) == false { exit(47) }
if oren_is_err(oren_bytes_pack(bad_li)) == false { exit(52) }
if oren_is_err(oren_bytes_unpack(bad_li)) == false { exit(53) }

print("module bytes_set_endian OK")
exit(0)
