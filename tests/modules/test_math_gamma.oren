import math "../../lib/std/math.oren"

fn fail(code, msg) {
    print("module math gamma FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_close(a: f64, b: f64, eps: f64, code, msg) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code, msg)
}

assert_close(math.tgamma(1.0), 1.0, 1e-9, 10, "gamma one")
assert_close(math.tgamma(5.0), 24.0, 1e-7, 11, "gamma factorial")
assert_close(math.tgamma(0.5), 1.772453850905516, 1e-9, 12, "gamma half")
assert_close(math.tgamma(1.5), 0.886226925452758, 1e-9, 13, "gamma three halves")
assert_close(math.tgamma(0.0 - 0.5), 0.0 - 3.544907701811032, 1e-8, 14, "gamma negative half")

assert_close(math.lgamma(1.0), 0.0, 1e-12, 20, "lgamma one")
assert_close(math.lgamma(5.0), math.ln(24.0), 1e-10, 21, "lgamma factorial")
assert_close(math.lgamma(0.5), 0.5723649429247001, 1e-10, 22, "lgamma half")
assert_close(math.lgamma(0.0 - 0.5), math.ln(3.544907701811032), 1e-9, 23, "lgamma negative half")
assert_close(math.exp(math.lgamma(6.0)), math.tgamma(6.0), 1e-6, 24, "exp lgamma roundtrip")

assert_true(math.is_inf(math.tgamma(math.inf())), 30, "tgamma inf")
assert_true(math.is_inf(math.lgamma(math.inf())), 31, "lgamma inf")
assert_true(oren_is_err(math.tgamma(0.0)), 40, "tgamma zero pole")
assert_true(oren_is_err(math.tgamma(0.0 - 2.0)), 41, "tgamma negative integer pole")
assert_true(oren_is_err(math.lgamma(0.0 - 3.0)), 42, "lgamma negative integer pole")
assert_true(oren_is_err(math.tgamma(0.0 / 0.0)), 43, "tgamma nan")
assert_true(oren_is_err(math.lgamma(0.0 / 0.0)), 44, "lgamma nan")
assert_true(oren_is_err(math.tgamma(math.neg_inf())), 45, "tgamma neg inf")
assert_true(oren_is_err(math.lgamma(math.neg_inf())), 46, "lgamma neg inf")

print("module math gamma OK")
exit(0)
