fn fail(msg) {
    print("FAIL")
    print(msg)
    oren_exit(1)
}

fn main() {
    // This test is intended to run with:
    //   --fs-backend vfs
    // so FS domain calls do not touch the host filesystem.
    var path = "build/avm_vfs_should_not_write.bin"
    var bytes = [1, 2, 3, 4, 5, 255, 0]
    oren_write_bytes(path, bytes)

    var out = oren_read_bytes(path)
    if oren_list_len(out) != 7 { fail("length mismatch") }
    if out[0] != 1 { fail("mismatch 0") }
    if out[1] != 2 { fail("mismatch 1") }
    if out[2] != 3 { fail("mismatch 2") }
    if out[3] != 4 { fail("mismatch 3") }
    if out[4] != 5 { fail("mismatch 4") }
    if out[5] != 255 { fail("mismatch 5") }
    if out[6] != 0 { fail("mismatch 6") }

    oren_exit(0)
}

main()

