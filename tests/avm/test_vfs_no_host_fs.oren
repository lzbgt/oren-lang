fn fail(msg) {
    print("FAIL")
    print(msg)
    oren_exit(1)
}

fn main() {
    // This test is intended to run with:
    //   --fs-backend vfs
    // so FS domain calls do not touch the host filesystem.
    var path = "build/avm_vfs_should_not_write.bin"
    var bytes = [1, 2, 3, 4, 5, 255, 0]
    oren_write_bytes(path, bytes)

    var out = oren_read_u8_buf(path)
    if oren_bytes_len(out) != 7 { fail("length mismatch") }
    if oren_bytes_get_u8(out, 0) != 1 { fail("mismatch 0") }
    if oren_bytes_get_u8(out, 1) != 2 { fail("mismatch 1") }
    if oren_bytes_get_u8(out, 2) != 3 { fail("mismatch 2") }
    if oren_bytes_get_u8(out, 3) != 4 { fail("mismatch 3") }
    if oren_bytes_get_u8(out, 4) != 5 { fail("mismatch 4") }
    if oren_bytes_get_u8(out, 5) != 255 { fail("mismatch 5") }
    if oren_bytes_get_u8(out, 6) != 0 { fail("mismatch 6") }

    var large_path = "build/avm_vfs_large.bin"
    var large = []
    var i = 0
    while i < 70000 {
        oren_list_push(large, (i * 37) & 255)
        i = i + 1
    }
    oren_write_bytes(large_path, large)
    var large_out = oren_read_u8_buf(large_path)
    if oren_bytes_len(large_out) != 70000 { fail("large length mismatch") }
    if oren_bytes_get_u8(large_out, 0) != 0 { fail("large mismatch 0") }
    if oren_bytes_get_u8(large_out, 65535) != ((65535 * 37) & 255) { fail("large mismatch 65535") }
    if oren_bytes_get_u8(large_out, 69999) != ((69999 * 37) & 255) { fail("large mismatch 69999") }

    var list_int_path = "build/avm_vfs_list_int_copy.bin"
    var large_list_int = oren_read_bytes(large_path)
    oren_write_bytes(list_int_path, large_list_int)
    var list_int_out = oren_read_u8_buf(list_int_path)
    if oren_bytes_len(list_int_out) != 70000 { fail("list_int length mismatch") }
    if oren_bytes_get_u8(list_int_out, 0) != 0 { fail("list_int mismatch 0") }
    if oren_bytes_get_u8(list_int_out, 65535) != ((65535 * 37) & 255) { fail("list_int mismatch 65535") }
    if oren_bytes_get_u8(list_int_out, 69999) != ((69999 * 37) & 255) { fail("list_int mismatch 69999") }

    oren_exit(0)
}

main()
