@myorg.tag(name="avm-std-math-quat")

import quat "../../lib/std/math/quat.oren"
import math "../../lib/std/math.oren"

fn fail(code, msg) {
    print("avm std math quat FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_close(a: f64, b: f64, eps: f64, code, msg) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code, msg)
}

assert_close(quat.length(0.0, 0.0, 0.0, 2.0), 2.0, 1e-12, 10, "length")
var n = quat.normalize(0.0, 0.0, 0.0, 2.0)
assert_true(!oren_is_err(n), 20, "normalize ok")
assert_close(n[3], 1.0, 0.0, 21, "normalize w")

var qz = quat.from_axis_angle(0.0, 0.0, 1.0, math.pi() / 2.0)
assert_true(!oren_is_err(qz), 30, "axis angle ok")
var v = quat.rotate_vec3(qz[0], qz[1], qz[2], qz[3], 1.0, 0.0, 0.0)
assert_true(!oren_is_err(v), 31, "rotate ok")
assert_close(v[0], 0.0, 1e-9, 32, "rotate x")
assert_close(v[1], 1.0, 1e-9, 33, "rotate y")

assert_true(oren_is_err(quat.normalize(0.0, 0.0, 0.0, 0.0)), 40, "normalize zero errors")
assert_true(oren_is_err(quat.from_axis_angle(0.0, 0.0, 0.0, 1.0)), 41, "axis zero errors")

print("avm std math quat OK")
exit(0)
