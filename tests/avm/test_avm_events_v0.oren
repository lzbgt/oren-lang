import events "std:avm/events"
import time "std:time"

fn main() {
    if events.event_read() != 1 { exit(1) }
    if events.event_write() != 2 { exit(2) }
    if events.event_read_write() != 3 { exit(3) }
    if events.watch_cancel("c0")["kind"] != "cancel" { exit(10) }
    if events.watch_fs("fs0")["kind"] != "fs" { exit(12) }
    if events.watch_package("pkg0")["kind"] != "package" { exit(13) }

    var now = time.now_ns()
    var ev = events.select_once([{"kind": "timer", "id": "t0", "deadline_ns": now}])
    if oren_is_err(ev) { exit(4) }
    if ev["kind"] != "timer" || ev["id"] != "t0" || ev["index"] != 0 { exit(5) }

    var none = events.select_once([{"kind": "timer", "id": "future", "deadline_ns": now + 1000000000}])
    if oren_is_err(none) || none != nil { exit(6) }

    var no_cancel = events.select_once([events.watch_cancel("c0")])
    if oren_is_err(no_cancel) || no_cancel != nil { exit(11) }
    var no_fs = events.select_once([events.watch_fs("fs0")])
    if oren_is_err(no_fs) || no_fs != nil { exit(14) }
    var no_pkg = events.select_once([events.watch_package("pkg0")])
    if oren_is_err(no_pkg) || no_pkg != nil { exit(15) }

    var waited = events.select([{"kind": "timer", "id": "late", "deadline_ns": time.now_ns() + 1000000}], 10)
    if oren_is_err(waited) { exit(7) }
    if waited["kind"] != "timer" || waited["id"] != "late" { exit(8) }

    var bad = events.select_once([{"kind": "bad"}])
    if !oren_is_err(bad) { exit(9) }

    print("avm events v0 ok")
    exit(0)
}

main()
