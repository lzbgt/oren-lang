    assert_true(oren_is_err(buffer.try_f64_mat_copy_from_rows(packed_f64_mat, [[1.5], [2.5]])))
    assert_true(oren_is_err(buffer.try_f64_mat_copy_from_flat(packed_f64_mat, [1.5, 2.5, 3.5])))
    assert_true(oren_is_err(buffer.try_f64_mat_to_f64_buf("nope")))
    assert_true(oren_is_err(buffer.try_f64_mat_copy_from_f64_buf(packed_f64_mat, buffer.f64_new(3))))
    assert_true(oren_is_err(buffer.try_f64_mat_copy_from_f64_buf(packed_f64_mat, buffer.try_u8_from_string("ABCD"))))
    assert_true(oren_is_err(buffer.try_mat_col_copy_from_list_f64(packed_f64_mat, 0, [1.0])))
    assert_true(oren_is_err(buffer.try_mat_load_i64(mat64, 2, 0)))
    assert_true(oren_is_err(buffer.try_mat_load_f64(matf64, 2, 0)))

    print("avm std buffer views portable ok")
    return 0
}
