@myorg.tag(name="avm-std-buffer-views-portable")

import buffer "../../lib/std/buffer.oren"
import bytesm "../../lib/std/bytes.oren"

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_true(x) {
    if x { return 0 }
    fail()
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn main() {
    var i32b = buffer.i32_new(4)
    assert_true(!oren_is_err(i32b))
    assert_true(!oren_is_err(buffer.try_store_i32(i32b, 0, 1)))
    assert_true(!oren_is_err(buffer.try_store_i32(i32b, 1, 2)))
    assert_true(!oren_is_err(buffer.try_store_i32(i32b, 2, 3)))
    assert_true(!oren_is_err(buffer.try_store_i32(i32b, 3, 4)))
    assert_eq(buffer.try_i32_unpack_list(i32b)[3], 4)
    var i32p = buffer.try_i32_pack_list_int([5, 6, 7])
    assert_true(!oren_is_err(i32p))
    assert_eq(buffer.try_i32_unpack_list(i32p)[2], 7)
    assert_true(oren_is_err(buffer.try_i32_pack_list_int([2147483648])))
    var i64p = buffer.try_i64_pack_list_int([8, 9, 4294967296])
    assert_true(!oren_is_err(i64p))
    assert_eq(buffer.try_i64_unpack_list(i64p)[2], 4294967296)
    var i64_into = buffer.i64_new(2)
    assert_true(!oren_is_err(i64_into))
    assert_true(!oren_is_err(buffer.try_i64_pack_list_int_into(i64_into, [10, 11])))
    assert_eq(buffer.try_i64_unpack_list(i64_into)[1], 11)
    assert_true(oren_is_err(buffer.try_i64_pack_list_int_into(i64_into, [1])))
    var f32p = buffer.try_f32_pack_list([1.5, 2.5, 3.5])
    assert_true(!oren_is_err(f32p))
    assert_eq(buffer.try_f32_unpack_list(f32p)[1], 2.5)
    var f32_into = buffer.f32_new(2)
    assert_true(!oren_is_err(f32_into))
    assert_true(!oren_is_err(buffer.try_f32_pack_list_into(f32_into, [4.5, 5.5])))
    assert_eq(buffer.try_f32_unpack_list(f32_into)[0], 4.5)
    assert_true(oren_is_err(buffer.try_f32_pack_list_into(f32_into, [1.0])))
    var f64p = buffer.try_f64_pack_list([6.25, 7.25])
    assert_true(!oren_is_err(f64p))
    assert_eq(buffer.try_f64_unpack_list(f64p)[1], 7.25)
    var f64_into = buffer.f64_new(2)
    assert_true(!oren_is_err(f64_into))
    assert_true(!oren_is_err(buffer.try_f64_pack_list_into(f64_into, [8.25, 9.25])))
    assert_eq(buffer.try_f64_unpack_list(f64_into)[0], 8.25)
    assert_true(oren_is_err(buffer.try_f64_pack_list_into(f64_into, [1.0])))

    var ub = buffer.try_u8_from_string("AB")
    assert_true(!oren_is_err(ub))
    assert_eq(buffer.try_u8_to_string(ub), "AB")
    var ub_list = buffer.try_u8_unpack(ub)
    assert_eq(ub_list[0], 65)
    assert_eq(ub_list[1], 66)
    var ub2 = buffer.try_u8_pack([67, 68])
    assert_true(!oren_is_err(ub2))
    assert_eq(buffer.try_u8_to_string(ub2), "CD")
    assert_true(oren_is_err(buffer.try_u8_pack([256])))
    assert_true(oren_is_err(buffer.try_u8_pack(123)))
    assert_true(oren_is_err(buffer.try_u8_from_string(123)))
    var ub_from_bytes = buffer.try_u8_from_bytes(bytesm.try_from_string("EF"))
    assert_true(!oren_is_err(ub_from_bytes))
    assert_eq(buffer.try_u8_to_string(ub_from_bytes), "EF")
    var ub_from_bytes_slice = buffer.try_u8_from_bytes_slice(bytesm.try_from_string("hello"), 1, 3)
    assert_true(!oren_is_err(ub_from_bytes_slice))
    assert_eq(buffer.try_u8_to_string(ub_from_bytes_slice), "ell")
    var ub_to_bytes = buffer.try_u8_to_bytes(ub2)
    assert_true(!oren_is_err(ub_to_bytes))
    assert_eq(bytesm.try_to_string(ub_to_bytes), "CD")
    assert_true(oren_is_err(buffer.try_u8_from_bytes("nope")))
    assert_true(oren_is_err(buffer.try_u8_from_bytes_slice("nope", 0, 1)))
    assert_true(oren_is_err(buffer.try_u8_to_bytes("nope")))

    var slice = buffer.try_slice_new(i32b, 1, 2)
    assert_true(!oren_is_err(slice))
    assert_eq(buffer.try_slice_len(slice), 2)
    assert_eq(buffer.try_slice_load_i32(slice, 0), 2)
    assert_true(!oren_is_err(buffer.try_slice_store_i32(slice, 1, 9)))
    assert_eq(buffer.try_slice_load_i32(slice, 1), 9)
    assert_true(oren_is_err(buffer.try_slice_new(i32b, "x", 1)))
    assert_true(oren_is_err(buffer.try_slice_load_i32(slice, 2)))

    var stride = buffer.try_strided_new(i32b, 0, 2, 2)
    assert_true(!oren_is_err(stride))
    assert_eq(buffer.try_strided_len(stride), 2)
    assert_eq(buffer.try_strided_load_i32(stride, 0), 1)
    assert_eq(buffer.try_strided_load_i32(stride, 1), 9)
    assert_true(!oren_is_err(buffer.try_strided_store_i32(stride, 1, 11)))
    assert_eq(buffer.try_strided_load_i32(stride, 1), 11)
    assert_true(oren_is_err(buffer.try_strided_new(i32b, 0, 2, 0)))
    assert_true(oren_is_err(buffer.try_strided_load_i32(stride, 2)))

    var ub3 = buffer.try_u8_from_string("ABCDE")
    assert_true(!oren_is_err(ub3))
    var u8slice = buffer.try_slice_new(ub3, 1, 3)
    assert_true(!oren_is_err(u8slice))
    assert_eq(buffer.try_slice_to_string(u8slice), "BCD")
    var slice_bytes = buffer.try_slice_to_bytes(u8slice)
    assert_true(!oren_is_err(slice_bytes))
    assert_eq(bytesm.try_to_string(slice_bytes), "BCD")
    var slice_list = buffer.try_slice_unpack_u8(u8slice)
    assert_true(!oren_is_err(slice_list))
    assert_eq(slice_list[0], 66)
    assert_eq(slice_list[2], 68)
    var slice_buf = buffer.try_slice_to_u8_buf(u8slice)
    assert_true(!oren_is_err(slice_buf))
    assert_eq(buffer.try_u8_to_string(slice_buf), "BCD")
    assert_true(!oren_is_err(buffer.try_slice_copy_from_bytes(u8slice, bytesm.try_from_string("xyz"))))
    assert_eq(buffer.try_u8_to_string(ub3), "AxyzE")
    var ub3b = buffer.try_u8_from_string("ABCDE")
    assert_true(!oren_is_err(ub3b))
    var u8slice2 = buffer.try_slice_new(ub3b, 1, 3)
    assert_true(!oren_is_err(u8slice2))
    assert_true(!oren_is_err(buffer.try_slice_copy_from_string(u8slice2, "mno")))
    assert_eq(buffer.try_u8_to_string(ub3b), "AmnoE")
    var ub3c = buffer.try_u8_from_string("ABCDE")
    assert_true(!oren_is_err(ub3c))
    var u8slice3 = buffer.try_slice_new(ub3c, 1, 3)
    assert_true(!oren_is_err(u8slice3))
    assert_true(!oren_is_err(buffer.try_slice_copy_from_u8_buf(u8slice3, buffer.try_u8_from_string("pqr"))))
    assert_eq(buffer.try_u8_to_string(ub3c), "ApqrE")
    assert_true(oren_is_err(buffer.try_slice_to_string("nope")))
    assert_true(oren_is_err(buffer.try_slice_copy_from_bytes(u8slice, bytesm.try_from_string("xy"))))
    assert_true(oren_is_err(buffer.try_slice_unpack_u8("nope")))
    assert_true(oren_is_err(buffer.try_slice_to_u8_buf("nope")))
    assert_true(oren_is_err(buffer.try_slice_copy_from_string(u8slice2, "xy")))
    assert_true(oren_is_err(buffer.try_slice_copy_from_u8_buf(u8slice3, buffer.try_u8_from_string("xy"))))

    var ub4 = buffer.try_u8_from_string("ABCDE")
    assert_true(!oren_is_err(ub4))
    var u8stride = buffer.try_strided_new(ub4, 0, 3, 2)
    assert_true(!oren_is_err(u8stride))
    assert_eq(buffer.try_strided_to_string(u8stride), "ACE")
    var stride_bytes = buffer.try_strided_to_bytes(u8stride)
    assert_true(!oren_is_err(stride_bytes))
    assert_eq(bytesm.try_to_string(stride_bytes), "ACE")
    var stride_list = buffer.try_strided_unpack_u8(u8stride)
    assert_true(!oren_is_err(stride_list))
    assert_eq(stride_list[0], 65)
    assert_eq(stride_list[2], 69)
    var stride_buf = buffer.try_strided_to_u8_buf(u8stride)
    assert_true(!oren_is_err(stride_buf))
    assert_eq(buffer.try_u8_to_string(stride_buf), "ACE")
    assert_true(!oren_is_err(buffer.try_strided_copy_from_bytes(u8stride, bytesm.try_from_string("xyz"))))
    assert_eq(buffer.try_u8_to_string(ub4), "xByDz")
    var ub4b = buffer.try_u8_from_string("ABCDE")
    assert_true(!oren_is_err(ub4b))
    var u8stride2 = buffer.try_strided_new(ub4b, 0, 3, 2)
    assert_true(!oren_is_err(u8stride2))
    assert_true(!oren_is_err(buffer.try_strided_copy_from_string(u8stride2, "uvw")))
    assert_eq(buffer.try_u8_to_string(ub4b), "uBvDw")
    var ub4c = buffer.try_u8_from_string("ABCDE")
    assert_true(!oren_is_err(ub4c))
    var u8stride3 = buffer.try_strided_new(ub4c, 0, 3, 2)
    assert_true(!oren_is_err(u8stride3))
    assert_true(!oren_is_err(buffer.try_strided_copy_from_u8_buf(u8stride3, buffer.try_u8_from_string("rst"))))
    assert_eq(buffer.try_u8_to_string(ub4c), "rBsDt")
    assert_true(oren_is_err(buffer.try_strided_to_string("nope")))
    assert_true(oren_is_err(buffer.try_strided_copy_from_bytes(u8stride, bytesm.try_from_string("xy"))))
    assert_true(oren_is_err(buffer.try_strided_unpack_u8("nope")))
    assert_true(oren_is_err(buffer.try_strided_to_u8_buf("nope")))
    assert_true(oren_is_err(buffer.try_strided_copy_from_string(u8stride2, "uv")))
    assert_true(oren_is_err(buffer.try_strided_copy_from_u8_buf(u8stride3, buffer.try_u8_from_string("rs"))))

    var mat = buffer.try_mat_view_new(i32b, 0, 2, 2, 2)
    assert_true(!oren_is_err(mat))
    assert_eq(buffer.try_mat_rows(mat), 2)
    assert_eq(buffer.try_mat_cols(mat), 2)
    assert_eq(buffer.try_mat_row_stride(mat), 2)
    var mat_row1 = buffer.try_mat_row_slice(mat, 1)
    assert_true(!oren_is_err(mat_row1))
    assert_eq(buffer.try_slice_len(mat_row1), 2)
    assert_eq(buffer.try_slice_load_i32(mat_row1, 0), 11)
    assert_eq(buffer.try_slice_load_i32(mat_row1, 1), 4)
    var mat_col1 = buffer.try_mat_col_strided(mat, 1)
    assert_true(!oren_is_err(mat_col1))
    assert_eq(buffer.try_strided_len(mat_col1), 2)
    assert_eq(buffer.try_strided_load_i32(mat_col1, 0), 2)
    assert_eq(buffer.try_strided_load_i32(mat_col1, 1), 4)
    var matsub = buffer.try_mat_subview(mat, 0, 1, 2, 1)
    assert_true(!oren_is_err(matsub))
    assert_eq(buffer.try_mat_rows(matsub), 2)
    assert_eq(buffer.try_mat_cols(matsub), 1)
    assert_eq(buffer.try_mat_load_i32(matsub, 1, 0), 4)
    var matdiag = buffer.try_mat_diag_strided(mat)
    assert_true(!oren_is_err(matdiag))
    assert_eq(buffer.try_strided_len(matdiag), 2)
    assert_eq(buffer.try_strided_load_i32(matdiag, 0), 1)
    assert_eq(buffer.try_strided_load_i32(matdiag, 1), 4)
    assert_eq(buffer.try_mat_load_i32(mat, 0, 1), 2)
    assert_eq(buffer.try_mat_load_i32(mat, 1, 0), 11)
    assert_true(!oren_is_err(buffer.try_mat_store_i32(mat, 1, 1, 13)))
    assert_eq(buffer.try_mat_load_i32(mat, 1, 1), 13)
    assert_true(oren_is_err(buffer.try_mat_load_i32(mat, 2, 0)))

    var ubm = buffer.try_u8_from_string("ABCxDEFy")
    assert_true(!oren_is_err(ubm))
    var matu8 = buffer.try_mat_view_new(ubm, 0, 2, 3, 4)
    assert_true(!oren_is_err(matu8))
    var mat_u8_row = buffer.try_mat_row_slice(matu8, 1)
    assert_true(!oren_is_err(mat_u8_row))
    assert_eq(buffer.try_slice_to_string(mat_u8_row), "DEF")
    var mat_u8_col = buffer.try_mat_col_strided(matu8, 1)
    assert_true(!oren_is_err(mat_u8_col))
    assert_eq(buffer.try_strided_to_string(mat_u8_col), "BE")
    var mat_u8_sub = buffer.try_mat_subview(matu8, 0, 1, 2, 2)
    assert_true(!oren_is_err(mat_u8_sub))
    var mat_u8_sub_row = buffer.try_mat_row_slice(mat_u8_sub, 1)
    assert_true(!oren_is_err(mat_u8_sub_row))
    assert_eq(buffer.try_slice_to_string(mat_u8_sub_row), "EF")
    var mat_u8_diag = buffer.try_mat_diag_strided(matu8)
    assert_true(!oren_is_err(mat_u8_diag))
    assert_eq(buffer.try_strided_to_string(mat_u8_diag), "AE")
    var mat_u8_row0_bytes = buffer.try_mat_row_to_bytes(matu8, 0)
    assert_true(!oren_is_err(mat_u8_row0_bytes))
    assert_eq(bytesm.try_to_string(mat_u8_row0_bytes), "ABC")
    var mat_u8_row1_buf = buffer.try_mat_row_to_u8_buf(matu8, 1)
    assert_true(!oren_is_err(mat_u8_row1_buf))
    assert_eq(buffer.try_u8_to_string(mat_u8_row1_buf), "DEF")
    var mat_u8_row0_list = buffer.try_mat_row_unpack_u8(matu8, 0)
    assert_true(!oren_is_err(mat_u8_row0_list))
    assert_eq(mat_u8_row0_list[0], 65)
    assert_eq(mat_u8_row0_list[2], 67)
    var mat_u8_col1_buf = buffer.try_mat_col_to_u8_buf(matu8, 1)
    assert_true(!oren_is_err(mat_u8_col1_buf))
    assert_eq(buffer.try_u8_to_string(mat_u8_col1_buf), "BE")
    var mat_u8_col1_bytes = buffer.try_mat_col_to_bytes(matu8, 1)
    assert_true(!oren_is_err(mat_u8_col1_bytes))
    assert_eq(bytesm.try_to_string(mat_u8_col1_bytes), "BE")
    var mat_u8_col1_list = buffer.try_mat_col_unpack_u8(matu8, 1)
    assert_true(!oren_is_err(mat_u8_col1_list))
    assert_eq(mat_u8_col1_list[0], 66)
    assert_eq(mat_u8_col1_list[1], 69)
    var diag_string_mat = buffer.try_u8_mat_pack_strings(["AB", "CD"])
    assert_true(!oren_is_err(diag_string_mat))
    assert_eq(buffer.try_mat_diag_to_string(diag_string_mat), "AD")
    var diag_string_bytes = buffer.try_mat_diag_to_bytes(diag_string_mat)
    assert_true(!oren_is_err(diag_string_bytes))
    assert_eq(bytesm.try_to_string(diag_string_bytes), "AD")
    var diag_string_buf = buffer.try_mat_diag_to_u8_buf(diag_string_mat)
    assert_true(!oren_is_err(diag_string_buf))
    assert_eq(buffer.try_u8_to_string(diag_string_buf), "AD")
    var diag_string_list = buffer.try_mat_diag_unpack_u8(diag_string_mat)
    assert_true(!oren_is_err(diag_string_list))
    assert_eq(diag_string_list[0], 65)
    assert_eq(diag_string_list[1], 68)
    assert_true(!oren_is_err(buffer.try_mat_diag_copy_from_string(diag_string_mat, "xy")))
    assert_eq(buffer.try_mat_diag_to_string(diag_string_mat), "xy")
    var diag_string_bytes_src = bytesm.try_from_string("pq")
    assert_true(!oren_is_err(diag_string_bytes_src))
    assert_true(!oren_is_err(buffer.try_mat_diag_copy_from_bytes(diag_string_mat, diag_string_bytes_src)))
    assert_eq(buffer.try_mat_diag_to_string(diag_string_mat), "pq")
    var diag_string_buf_src = buffer.try_u8_from_string("rs")
    assert_true(!oren_is_err(diag_string_buf_src))
    assert_true(!oren_is_err(buffer.try_mat_diag_copy_from_u8_buf(diag_string_mat, diag_string_buf_src)))
    assert_eq(buffer.try_mat_diag_to_string(diag_string_mat), "rs")
    var mat_u8_cells = buffer.try_u8_mat_pack_strings(["ABC", "DEF"])
    assert_true(!oren_is_err(mat_u8_cells))
    assert_eq(buffer.try_mat_load_u8(mat_u8_cells, 0, 1), 66)
    assert_true(!oren_is_err(buffer.try_mat_store_u8(mat_u8_cells, 1, 2, 90)))
    assert_eq(buffer.try_mat_load_u8(mat_u8_cells, 1, 2), 90)
    assert_eq(buffer.try_mat_row_to_string(mat_u8_cells, 1), "DEZ")
    assert_true(oren_is_err(buffer.try_mat_store_u8(mat_u8_cells, 0, 0, 256)))
    assert_true(oren_is_err(buffer.try_mat_load_u8(mat_u8_cells, 2, 0)))
    assert_true(oren_is_err(buffer.try_mat_row_slice(matu8, 2)))
    assert_true(oren_is_err(buffer.try_mat_col_strided(matu8, 3)))
    assert_true(oren_is_err(buffer.try_mat_subview(matu8, 1, 2, 2, 2)))
    assert_true(oren_is_err(buffer.try_mat_row_slice("nope", 0)))
    assert_true(oren_is_err(buffer.try_mat_col_strided("nope", 0)))
    assert_true(oren_is_err(buffer.try_mat_subview("nope", 0, 0, 1, 1)))
    assert_true(oren_is_err(buffer.try_mat_diag_strided("nope")))
    assert_true(oren_is_err(buffer.try_mat_diag_to_string("nope")))
    assert_true(oren_is_err(buffer.try_mat_row_to_string("nope", 0)))
    assert_true(oren_is_err(buffer.try_mat_col_copy_from_string("nope", 0, "ab")))
    var packed_i32_mat = buffer.try_i32_mat_pack_rows([[10, 20], [30, 40]])
    assert_true(!oren_is_err(packed_i32_mat))
    assert_eq(buffer.try_mat_rows(packed_i32_mat), 2)
    assert_eq(buffer.try_mat_cols(packed_i32_mat), 2)
    assert_eq(buffer.try_mat_load_i32(packed_i32_mat, 1, 0), 30)
    var unpacked_i32_rows = buffer.try_i32_mat_unpack_rows(packed_i32_mat)
    assert_true(!oren_is_err(unpacked_i32_rows))
    assert_eq(unpacked_i32_rows[0][1], 20)
    assert_eq(unpacked_i32_rows[1][0], 30)
    assert_true(!oren_is_err(buffer.try_i32_mat_copy_from_rows(packed_i32_mat, [[1, 2], [3, 4]])))
    var copied_i32_rows = buffer.try_i32_mat_unpack_rows(packed_i32_mat)
    assert_true(!oren_is_err(copied_i32_rows))
    assert_eq(copied_i32_rows[0][0], 1)
    assert_eq(copied_i32_rows[1][1], 4)
    var copied_i32_flat = buffer.try_i32_mat_unpack_flat(packed_i32_mat)
    assert_true(!oren_is_err(copied_i32_flat))
    assert_eq(copied_i32_flat[0], 1)
    assert_eq(copied_i32_flat[3], 4)
    assert_true(!oren_is_err(buffer.try_i32_mat_copy_from_flat(packed_i32_mat, [9, 8, 7, 6])))
    assert_eq(buffer.try_mat_load_i32(packed_i32_mat, 0, 0), 9)
    assert_eq(buffer.try_mat_load_i32(packed_i32_mat, 1, 1), 6)
    var copied_i32_buf = buffer.try_i32_mat_to_i32_buf(packed_i32_mat)
    assert_true(!oren_is_err(copied_i32_buf))
    assert_eq(buffer.try_len(copied_i32_buf), 4)
    assert_eq(buffer.try_load_i32(copied_i32_buf, 0), 9)
    assert_eq(buffer.try_load_i32(copied_i32_buf, 3), 6)
    var src_i32_buf = buffer.i32_new(4)
    assert_true(!oren_is_err(src_i32_buf))
    assert_true(!oren_is_err(buffer.try_store_i32(src_i32_buf, 0, 51)))
    assert_true(!oren_is_err(buffer.try_store_i32(src_i32_buf, 1, 52)))
    assert_true(!oren_is_err(buffer.try_store_i32(src_i32_buf, 2, 53)))
    assert_true(!oren_is_err(buffer.try_store_i32(src_i32_buf, 3, 54)))
    assert_true(!oren_is_err(buffer.try_i32_mat_copy_from_i32_buf(packed_i32_mat, src_i32_buf)))
    assert_eq(buffer.try_mat_load_i32(packed_i32_mat, 0, 0), 51)
    assert_eq(buffer.try_mat_load_i32(packed_i32_mat, 1, 1), 54)
    var i32_row0_view = buffer.try_mat_row_slice(packed_i32_mat, 0)
    assert_true(!oren_is_err(i32_row0_view))
    var i32_row0_list = buffer.try_slice_unpack_i32(i32_row0_view)
    assert_true(!oren_is_err(i32_row0_list))
    assert_eq(i32_row0_list[0], 51)
    assert_eq(i32_row0_list[1], 52)
    assert_true(!oren_is_err(buffer.try_slice_copy_from_list_i32(i32_row0_view, [11, 12])))
    assert_eq(buffer.try_mat_load_i32(packed_i32_mat, 0, 0), 11)
    assert_eq(buffer.try_mat_load_i32(packed_i32_mat, 0, 1), 12)
    var i32_row0_buf_direct = buffer.try_slice_to_i32_buf(i32_row0_view)
    assert_true(!oren_is_err(i32_row0_buf_direct))
    assert_eq(buffer.try_len(i32_row0_buf_direct), 2)
    assert_eq(buffer.try_load_i32(i32_row0_buf_direct, 0), 11)
    assert_eq(buffer.try_load_i32(i32_row0_buf_direct, 1), 12)
    var src_i32_row_view_buf = buffer.i32_new(2)
    assert_true(!oren_is_err(src_i32_row_view_buf))
    assert_true(!oren_is_err(buffer.try_store_i32(src_i32_row_view_buf, 0, 61)))
