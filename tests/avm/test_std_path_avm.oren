import path "std:path"

fn fail(code) {
    print("avm std path FAIL " + oren_int_to_string(code))
    oren_exit(code)
}

fn assert_eq(actual, expected, code) {
    if actual != expected {
        print("expected " + expected + " got " + actual)
        fail(code)
    }
}

fn main() {
    assert_eq(path.sep(), "/", 1)
    if path.is_abs("/pkg/scene.os3d") != true { fail(2) }
    if path.is_abs("pkg/scene.os3d") != false { fail(3) }

    assert_eq(path.normalize("/a//b/./c/"), "/a/b/c", 10)
    assert_eq(path.normalize("a/b/../c"), "a/c", 11)
    assert_eq(path.normalize("../../a"), "../../a", 12)
    assert_eq(path.normalize("/../a"), "/a", 13)

    assert_eq(path.join(["/pkg", "scenes", "../scene.os3d"]), "/pkg/scene.os3d", 20)
    assert_eq(path.dirname("/pkg/scene/cube.os3d"), "/pkg/scene", 30)
    assert_eq(path.basename("/pkg/scene/cube.os3d"), "cube.os3d", 31)
    assert_eq(path.extname("cube.os3d"), ".os3d", 32)

    var parts = path.split("/a//./b")
    if oren_is_err(parts) { fail(40) }
    if oren_list_len(parts) != 3 { fail(41) }
    if parts[0] != "a" || parts[1] != "." || parts[2] != "b" { fail(42) }

    if !oren_is_err(path.normalize(7)) { fail(50) }
    if !oren_is_err(path.join(["a", 7])) { fail(51) }

    print("avm std path OK")
    oren_exit(0)
}

main()
