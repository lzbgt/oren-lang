@myorg.tag(name="avm-std-math-core")

import math "../../lib/std/math.oren"

fn fail(code, msg) {
    print("avm std math core FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_close(a, b, eps, code, msg) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code, msg)
}

assert_true(math.abs_i(0 - 5) == 5, 10, "abs_i")
assert_true(math.min_i(1, 2) == 1, 11, "min_i")
assert_true(math.max_i(1, 2) == 2, 12, "max_i")
assert_true(math.clamp_i(99, 0, 10) == 10, 13, "clamp_i high")
assert_true(math.clamp_i(0 - 5, 0, 10) == 0, 14, "clamp_i low")

assert_close(math.abs_f(0.0 - 1.25), 1.25, 1e-12, 20, "abs_f")
assert_close(math.fabs(0.0 - 1.25), 1.25, 1e-12, 21, "fabs")
assert_close(math.fmin(1.0, 2.0), 1.0, 1e-12, 22, "fmin")
assert_close(math.fmax(1.0, 2.0), 2.0, 1e-12, 23, "fmax")
assert_true(!math.signbit(math.fabs(0.0 - 2.0)), 97, "fabs clears finite negative sign")
assert_close(math.fmin(math.nan(), 2.0), 2.0, 1e-12, 98, "fmin left nan")
assert_close(math.fmin(2.0, math.nan()), 2.0, 1e-12, 99, "fmin right nan")
assert_close(math.fmax(math.nan(), 2.0), 2.0, 1e-12, 100, "fmax left nan")
assert_close(math.fmax(2.0, math.nan()), 2.0, 1e-12, 101, "fmax right nan")
assert_true(math.is_nan(math.fmin(math.nan(), math.nan())), 102, "fmin both nan")
assert_true(math.is_nan(math.fmax(math.nan(), math.nan())), 103, "fmax both nan")
assert_close(math.lerp(2.0, 10.0, 0.25), 4.0, 1e-12, 109, "lerp quarter")
assert_close(math.lerp(2.0, 10.0, 0.0), 2.0, 0.0, 110, "lerp t0")
assert_close(math.lerp(2.0, 10.0, 1.0), 10.0, 0.0, 111, "lerp t1")
assert_close(math.lerp(2.0, 10.0, 1.5), 14.0, 1e-12, 112, "lerp extrapolate")
assert_close(math.lerp(1e308, 0.0 - 1e308, 0.5), 0.0, 1e292, 113, "lerp huge midpoint")
assert_true(oren_is_err(math.lerp(1.0, math.nan(), 0.5)), 114, "lerp nan")
assert_close(math.midpoint(2.0, 10.0), 6.0, 1e-12, 115, "midpoint simple")
assert_close(math.midpoint(1e308, 0.0 - 1e308), 0.0, 1e292, 116, "midpoint opposite huge")
assert_true(math.is_inf(math.midpoint(math.inf(), 4.0)), 117, "midpoint finite inf")
assert_true(math.is_inf(math.midpoint(math.inf(), math.inf())), 118, "midpoint same inf")
assert_true(oren_is_err(math.midpoint(math.inf(), math.neg_inf())), 119, "midpoint opposite inf")
assert_true(oren_is_err(math.midpoint(1.0, math.nan())), 120, "midpoint nan")
assert_close(math.clamp_f(99.0, 0.0, 10.0), 10.0, 1e-12, 24, "clamp_f high")
assert_close(math.clamp_f(0.0 - 5.0, 0.0, 10.0), 0.0, 1e-12, 25, "clamp_f low")
assert_close(math.clamp(5.0, 0.0, 10.0), 5.0, 1e-12, 134, "clamp pass")
assert_close(math.clamp(0.0 - 5.0, 0.0, 10.0), 0.0, 1e-12, 135, "clamp low")
assert_close(math.clamp(99.0, 0.0, 10.0), 10.0, 1e-12, 136, "clamp high")
assert_close(math.saturate(0.0 - 0.25), 0.0, 0.0, 137, "saturate low")
assert_close(math.saturate(1.25), 1.0, 0.0, 138, "saturate high")
assert_close(math.smoothstep(0.0, 1.0, 0.5), 0.5, 1e-12, 139, "smoothstep midpoint")
assert_close(math.smoothstep(0.0, 1.0, 0.0 - 1.0), 0.0, 0.0, 140, "smoothstep low")
assert_close(math.smoothstep(0.0, 1.0, 2.0), 1.0, 0.0, 141, "smoothstep high")
assert_close(math.smootherstep(0.0, 1.0, 0.5), 0.5, 1e-12, 142, "smootherstep midpoint")
assert_close(math.smootherstep(2.0, 4.0, 3.0), 0.5, 1e-12, 143, "smootherstep remap")
assert_true(oren_is_err(math.clamp(1.0, 2.0, 1.0)), 144, "clamp invalid range")
assert_true(oren_is_err(math.smoothstep(1.0, 1.0, 1.0)), 145, "smoothstep invalid edge")
assert_true(oren_is_err(math.smootherstep(math.nan(), 1.0, 0.5)), 146, "smootherstep nan")
assert_close(math.radians(180.0), math.pi(), 1e-12, 26, "radians half turn")
assert_close(math.radians(360.0), math.tau(), 1e-12, 27, "radians full turn")
assert_close(math.degrees(math.pi() / 2.0), 90.0, 1e-12, 28, "degrees right angle")
assert_close(math.degrees(math.radians(12.5)), 12.5, 1e-12, 29, "degrees/radians roundtrip")

assert_close(math.floor(1.9), 1.0, 1e-12, 30, "floor positive")
assert_close(math.floor(0.0 - 1.1), 0.0 - 2.0, 1e-12, 31, "floor negative")
assert_close(math.ceil(1.1), 2.0, 1e-12, 32, "ceil positive")
assert_close(math.ceil(0.0 - 1.9), 0.0 - 1.0, 1e-12, 33, "ceil negative")
assert_close(math.round(1.5), 2.0, 1e-12, 34, "round positive half")
assert_close(math.round(0.0 - 1.5), 0.0 - 2.0, 1e-12, 35, "round negative half")
assert_close(math.trunc(1.9), 1.0, 1e-12, 36, "trunc positive")
assert_close(math.trunc(0.0 - 1.9), 0.0 - 1.0, 1e-12, 37, "trunc negative")
assert_close(math.round_even(2.5), 2.0, 1e-12, 38, "round_even tie low")
assert_close(math.round_even(3.5), 4.0, 1e-12, 39, "round_even tie high")
assert_close(math.nearbyint(0.0 - 2.5), 0.0 - 2.0, 1e-12, 40, "nearbyint tie")
assert_close(math.rint(0.0 - 3.5), 0.0 - 4.0, 1e-12, 41, "rint tie")
assert_true(math.lround(1.5) == 2, 128, "lround half")
assert_true(math.llround(0.0 - 1.5) == 0 - 2, 129, "llround half")
assert_true(math.lrint(2.5) == 2, 130, "lrint tie even")
assert_true(math.llrint(3.5) == 4, 131, "llrint tie even")
assert_true(oren_is_err(math.lround(math.nan())), 132, "lround nan")
assert_true(oren_is_err(math.lrint(math.inf())), 133, "lrint inf")

assert_close(math.fmod(5.5, 2.0), 1.5, 1e-12, 50, "fmod positive")
assert_close(math.fmod(0.0 - 5.5, 2.0), 0.0 - 1.5, 1e-12, 51, "fmod negative")
assert_true(oren_is_err(math.fmod(1.0, 0.0)), 52, "fmod zero divisor")
assert_close(math.remainder(5.5, 2.0), 0.0 - 0.5, 1e-12, 53, "remainder nearest quotient")
assert_close(math.remainder(5.0, 2.0), 1.0, 1e-12, 54, "remainder tie even low")
assert_close(math.remainder(7.0, 2.0), 0.0 - 1.0, 1e-12, 55, "remainder tie even high")
assert_close(math.remainder(0.0 - 7.0, 2.0), 1.0, 1e-12, 56, "remainder negative tie")
assert_true(oren_is_err(math.remainder(1.0, 0.0)), 57, "remainder zero divisor")
var rq = math.remquo(7.0, 2.0)
assert_close(rq[0], 0.0 - 1.0, 1e-12, 121, "remquo tie remainder")
assert_true(rq[1] == 4, 122, "remquo tie quotient")
var rq_neg = math.remquo(0.0 - 7.0, 2.0)
assert_close(rq_neg[0], 1.0, 1e-12, 123, "remquo negative remainder")
assert_true(rq_neg[1] == 0 - 4, 124, "remquo negative quotient")
var rq_inf = math.remquo(5.0, math.inf())
assert_close(rq_inf[0], 5.0, 0.0, 125, "remquo infinite divisor remainder")
assert_true(rq_inf[1] == 0, 126, "remquo infinite divisor quotient")
assert_true(oren_is_err(math.remquo(1.0, 0.0)), 127, "remquo zero divisor")

var nanv = 0.0 / 0.0
assert_true(math.is_nan(nanv), 60, "is_nan")
assert_true(!math.is_finite(math.inf()), 61, "is_finite inf")
assert_true(math.is_finite(3.0), 62, "is_finite normal")
assert_true(math.is_inf(math.inf()), 63, "is_inf")
assert_true(math.is_nan(math.nan()), 80, "nan helper")
assert_true(math.isnan(nanv), 81, "isnan alias")
assert_true(math.isinf(math.inf()), 82, "isinf alias")
assert_true(math.isfinite(3.0), 83, "isfinite alias")
assert_true(math.isnormal(1.0), 84, "isnormal alias")
assert_true(math.isunordered(math.nan(), 1.0), 85, "isunordered left")
assert_true(math.isunordered(1.0, math.nan()), 86, "isunordered right")
assert_true(!math.isunordered(1.0, 2.0), 87, "isunordered false")
assert_true(math.isgreater(2.0, 1.0), 88, "isgreater true")
assert_true(!math.isgreater(math.nan(), 1.0), 89, "isgreater unordered")
assert_true(math.isgreaterequal(2.0, 2.0), 90, "isgreaterequal equal")
assert_true(math.isless(1.0, 2.0), 91, "isless true")
assert_true(!math.isless(1.0, math.nan()), 92, "isless unordered")
assert_true(math.islessequal(2.0, 2.0), 93, "islessequal equal")
assert_true(math.islessgreater(1.0, 2.0), 94, "islessgreater true")
assert_true(!math.islessgreater(2.0, 2.0), 95, "islessgreater equal")
assert_true(!math.islessgreater(math.nan(), 2.0), 96, "islessgreater unordered")
assert_true(math.signbit(0.0 - 1.0), 64, "signbit negative")
assert_true(!math.signbit(0.0), 65, "signbit positive zero")
assert_true(math.is_normal(1.0), 66, "is_normal one")
assert_true(!math.is_normal(0.0), 67, "is_normal zero")
assert_true(math.is_subnormal(math.pow2i(0 - 1074)), 68, "is_subnormal smallest")
assert_true(!math.is_subnormal(1.0), 69, "is_subnormal normal")
assert_true(math.fpclassify(math.nan()) == "nan", 104, "fpclassify nan")
assert_true(math.fpclassify(math.inf()) == "infinite", 105, "fpclassify infinite")
assert_true(math.fpclassify(0.0) == "zero", 106, "fpclassify zero")
assert_true(math.fpclassify(math.pow2i(0 - 1074)) == "subnormal", 107, "fpclassify subnormal")
assert_true(math.fpclassify(1.0) == "normal", 108, "fpclassify normal")

var neg_one = math.copysign(1.0, 0.0 - 1.0)
assert_close(neg_one, 0.0 - 1.0, 1e-12, 60, "copysign negative")
assert_true(math.signbit(neg_one), 61, "copysign signbit")
var pos_one = math.copysign(0.0 - 1.0, 0.0)
assert_close(pos_one, 1.0, 1e-12, 62, "copysign positive")
assert_true(!math.signbit(pos_one), 63, "copysign positive signbit")

print("avm std math core OK")
exit(0)
