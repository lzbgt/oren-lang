@oren.generator
fn avm_decl_counter(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
fn avm_decl_nil(seed) {
    yield
    return seed + 7
}

@oren.generator
fn avm_decl_collect(seed) {
    var i = 0
    while i < 3 {
        yield (seed + i)
        i = i + 1
    }
    return seed + 30
}

@oren.generator
var avm_decl_var_counter = fn(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
var avm_decl_var_lambda = |seed| {
    var resumed = yield (seed + 2)
    return resumed + 9
}

@oren.generator
fn avm_decl_delegate(seed) {
    var inner = gen.start(avm_delegate_inner_worker, [seed])
    var retv = yield from inner
    return retv + 21
}

@oren.generator
fn avm_decl_delegate_started(seed) {
    var inner = gen.start(avm_delegate_inner_worker, [seed])
