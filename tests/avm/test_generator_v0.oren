import gen "../../lib/std/generator.oren"

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    print("test_generator_v0 FAIL " + oren_int_to_string(code))
    oren_exit(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    assert_eq(0, 1, code)
}

fn avm_counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn avm_nil_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -910 }
    var seed = args[0]
    yield in co
    return seed + 7
}

fn avm_collect_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -920 }
    var seed = args[0]
    var i = 0
    while i < 3 {
        yield (seed + i) in co
        i = i + 1
    }
    return seed + 30
}

fn avm_delegate_inner_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -930 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 50
}

fn avm_delegate_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -931 }
    var inner = gen.start(avm_delegate_inner_worker, [args[0]])
    var retv = gen.delegate(co, inner)
    return retv + 7
}

fn avm_delegate_outer_direct_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -932 }
    var inner = oren_generator_start(avm_delegate_inner_worker, [args[0]])
    var retv = oren_generator_delegate(co, inner)
    return retv + 9
}

fn avm_delegate_syntax_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -935 }
    var inner = gen.start(avm_delegate_inner_worker, [args[0]])
    var retv = yield from inner in co
    assert_true(oren_is_err(retv) == false, 3087)
    return retv + 17
}

fn avm_delegate_syntax_started_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -936 }
    var inner = gen.start(avm_delegate_inner_worker, [args[0]])
    var step0 = gen.next(inner)
    assert_true(oren_is_err(step0) == false, 3088)
    assert_eq(step0["value"], args[0] + 1, 3089)
    var retv = yield from inner in co
    assert_true(oren_is_err(retv) == false, 3090)
    return retv + 19
}

fn avm_delegate_step_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -933 }
    var inner = gen.start(avm_delegate_inner_worker, [args[0]])
    var step0 = gen.next(inner)
    assert_true(oren_is_err(step0) == false, 3081)
    assert_eq(step0["value"], args[0] + 1, 3082)
    var retv = gen.delegate_step(co, inner, step0)
    assert_true(oren_is_err(retv) == false, 3083)
    return retv + 13
}

fn avm_delegate_step_outer_direct_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -934 }
    var inner = oren_generator_start(avm_delegate_inner_worker, [args[0]])
    var step0 = oren_generator_next(inner)
    assert_true(oren_is_err(step0) == false, 3084)
    assert_eq(step0["value"], args[0] + 1, 3085)
    var retv = oren_generator_delegate_step(co, inner, step0)
    assert_true(oren_is_err(retv) == false, 3086)
    return retv + 15
}

fn avm_delegate_chain_inner_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -937 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 70
}

fn avm_delegate_chain_middle_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -938 }
    var cells = args[0]
    var seed = args[1]
    var inner = gen.start(avm_delegate_chain_inner_worker, [seed])
    cells[1] = inner
    var retv = yield from inner in co
    assert_true(oren_is_err(retv) == false, 3094)
    return retv + 30
}

fn avm_delegate_chain_started_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -939 }
    var cells = args[0]
    var seed = args[1]
    var middle = gen.start(avm_delegate_chain_middle_worker, [cells, seed])
    cells[0] = middle
    var step0 = gen.next(middle)
    assert_true(oren_is_err(step0) == false, 3095)
    assert_eq(step0["value"], seed + 1, 3096)
    var retv = yield from middle in co
    assert_true(oren_is_err(retv) == false, 3097)
    return retv + 40
}

@oren.generator
fn avm_decl_counter(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
fn avm_decl_nil(seed) {
    yield
    return seed + 7
}

@oren.generator
fn avm_decl_collect(seed) {
    var i = 0
    while i < 3 {
        yield (seed + i)
        i = i + 1
    }
    return seed + 30
}

@oren.generator
var avm_decl_var_counter = fn(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
var avm_decl_var_lambda = |seed| {
    var resumed = yield (seed + 2)
    return resumed + 9
}

@oren.generator
fn avm_decl_delegate(seed) {
    var inner = gen.start(avm_delegate_inner_worker, [seed])
    var retv = yield from inner
    return retv + 21
}

@oren.generator
fn avm_decl_delegate_started(seed) {
    var inner = gen.start(avm_delegate_inner_worker, [seed])
    var step0 = gen.next(inner)
    assert_true(oren_is_err(step0) == false, 3091)
    assert_eq(step0["value"], seed + 1, 3092)
    var retv = yield from inner
    assert_true(oren_is_err(retv) == false, 3093)
    return retv + 23
}

@oren.generator
fn avm_decl_delegate_chain(cells, seed) {
    var middle = gen.start(avm_delegate_chain_middle_worker, [cells, seed])
    cells[0] = middle
    var retv = yield from middle
    assert_true(oren_is_err(retv) == false, 3098)
    return retv + 41
}

fn avm_close_hook_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -960 }
    var box = args[0]
    var base = args[1]
    var r0 = gen.on_close(co, || { oren_list_push(box, base + 1); return nil })
    if oren_is_err(r0) == true { return -961 }
    var r1 = oren_generator_on_close(co, || { oren_list_push(box, base + 2); return nil })
    if oren_is_err(r1) == true { return -962 }
    var resumed = yield base in co
    return resumed + base + 5
}

fn avm_close_hook_err_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -963 }
    var box = args[0]
    var r0 = gen.on_close(co, || { oren_list_push(box, 1); return nil })
    if oren_is_err(r0) == true { return -964 }
    var r1 = gen.on_close(co, || { oren_list_push(box, 2); return oren_err(77, "close hook boom") })
    if oren_is_err(r1) == true { return -965 }
    yield 1 in co
    return 0
}

fn avm_close_hook_chain_inner_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -966 }
    var box = args[0]
    var base = args[1]
    var r0 = gen.on_close(co, || { oren_list_push(box, base + 1); return nil })
    if oren_is_err(r0) == true { return -967 }
    var resumed = yield base in co
    return resumed + base + 11
}

fn avm_close_hook_chain_middle_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -968 }
    var box = args[0]
    var base = args[1]
    var r0 = gen.on_close(co, || { oren_list_push(box, base + 2); return nil })
    if oren_is_err(r0) == true { return -969 }
    var inner = gen.start(avm_close_hook_chain_inner_worker, [box, base])
    var retv = yield from inner in co
    assert_true(oren_is_err(retv) == false, 3099)
    return retv + 1
}

@oren.generator
fn avm_decl_close_hook(box, base) {
    var r0 = gen.on_close(|| { oren_list_push(box, base + 10); return nil })
    assert_true(oren_is_err(r0) == false, 3100)
    var r1 = oren_generator_on_close(|| { oren_list_push(box, base + 20); return nil })
    assert_true(oren_is_err(r1) == false, 3101)
    var resumed = yield (base + 1)
    return resumed + base + 100
}

fn avm_bad_on_close_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -975 }
    var bad0 = gen.on_close(co, 123)
    if oren_is_err(bad0) != true { return -976 }
    var bad1 = oren_generator_on_close(co, 123)
    if oren_is_err(bad1) != true { return -977 }
    return 1
}

fn test_step_protocol() {
    var g = gen.start(avm_counter_worker, [40])
    assert_eq(oren_type_name(g), "generator", 9)
    var s0 = gen.next(g)
    assert_true(oren_is_err(s0) == false, 10)
    assert_true(s0["ok"] == true, 11)
    assert_eq(s0["value"], 41, 12)
    var s1 = gen.send(g, 2)
    assert_true(oren_is_err(s1) == false, 13)
    assert_eq(s1["value"], 42, 14)
    var s2 = gen.send(g, 7)
    assert_true(oren_is_err(s2) == false, 15)
    assert_true(s2["done"] == true, 16)
    assert_eq(s2["return"], 12, 17)
    assert_true(gen.is_done(g) == true, 18)
    assert_eq(gen.return_value(g), 12, 19)
}

fn test_nil_and_collect() {
    var g0 = gen.start(avm_nil_worker, [60])
    var n0 = gen.next(g0)
    assert_true(oren_is_err(n0) == false, 20)
    assert_true(n0["value"] == nil, 21)
    var n1 = gen.send(g0, 3)
    assert_true(oren_is_err(n1) == false, 22)
    assert_eq(n1["return"], 67, 23)

    var g1 = gen.start(avm_collect_worker, [5])
    var xs = gen.collect(g1)
    assert_true(oren_is_err(xs) == false, 24)
    assert_eq(oren_list_len(xs), 3, 25)
    assert_eq(xs[0], 5, 26)
    assert_eq(xs[1], 6, 27)
    assert_eq(xs[2], 7, 28)
    assert_eq(gen.return_value(g1), 35, 29)

    var g2 = gen.start(avm_collect_worker, [9])
    var ys = []
    for y in g2 { oren_list_push(ys, y) }
    assert_eq(oren_list_len(ys), 3, 291)
    assert_eq(ys[0], 9, 292)
    assert_eq(ys[1], 10, 293)
    assert_eq(ys[2], 11, 294)
    assert_true(gen.is_done(g2) == true, 295)
    assert_eq(gen.return_value(g2), 39, 296)

    var g3 = gen.start(avm_delegate_outer_worker, [30])
    var d0 = gen.next(g3)
    assert_true(oren_is_err(d0) == false, 297)
    assert_eq(d0["value"], 31, 298)
    var d1 = gen.send(g3, 2)
    assert_true(oren_is_err(d1) == false, 299)
    assert_eq(d1["value"], 32, 300)
    var d2 = gen.send(g3, 7)
    assert_true(oren_is_err(d2) == false, 301)
    assert_eq(d2["return"], 64, 302)

    var g4 = gen.start(avm_delegate_outer_direct_worker, [40])
    var dd0 = gen.next(g4)
    assert_true(oren_is_err(dd0) == false, 303)
    assert_eq(dd0["value"], 41, 304)
    var dd1 = gen.send(g4, 3)
    assert_true(oren_is_err(dd1) == false, 305)
    assert_eq(dd1["value"], 43, 306)
    var dd2 = gen.send(g4, 8)
    assert_true(oren_is_err(dd2) == false, 307)
    assert_eq(dd2["return"], 67, 308)

    var g4s = gen.start(avm_delegate_syntax_outer_worker, [20])
    var dys0 = gen.next(g4s)
    assert_true(oren_is_err(dys0) == false, 30801)
    assert_eq(dys0["value"], 21, 30802)
    var dys1 = gen.send(g4s, 2)
    assert_true(oren_is_err(dys1) == false, 30803)
    assert_eq(dys1["value"], 22, 30804)
    var dys2 = gen.send(g4s, 7)
    assert_true(oren_is_err(dys2) == false, 30805)
    assert_eq(dys2["return"], 74, 30806)

    var g4t = gen.start(avm_delegate_syntax_started_outer_worker, [25])
    var dyt0 = gen.next(g4t)
    assert_true(oren_is_err(dyt0) == false, 30807)
    assert_eq(dyt0["value"], 26, 30808)
    var dyt1 = gen.send(g4t, 3)
    assert_true(oren_is_err(dyt1) == false, 30809)
    assert_eq(dyt1["value"], 28, 30810)
    var dyt2 = gen.send(g4t, 8)
    assert_true(oren_is_err(dyt2) == false, 30811)
    assert_eq(dyt2["return"], 77, 30812)

    var g5 = gen.start(avm_delegate_step_outer_worker, [50])
    var ds0 = gen.next(g5)
    assert_true(oren_is_err(ds0) == false, 309)
    assert_eq(ds0["value"], 51, 310)
    var ds1 = gen.send(g5, 4)
    assert_true(oren_is_err(ds1) == false, 311)
    assert_eq(ds1["value"], 54, 312)
    var ds2 = gen.send(g5, 8)
    assert_true(oren_is_err(ds2) == false, 313)
    assert_eq(ds2["return"], 71, 314)

    var g6 = gen.start(avm_delegate_step_outer_direct_worker, [60])
    var dsd0 = gen.next(g6)
    assert_true(oren_is_err(dsd0) == false, 315)
    assert_eq(dsd0["value"], 61, 316)
    var dsd1 = gen.send(g6, 5)
    assert_true(oren_is_err(dsd1) == false, 317)
    assert_eq(dsd1["value"], 65, 318)
    var dsd2 = gen.send(g6, 9)
    assert_true(oren_is_err(dsd2) == false, 319)
    assert_eq(dsd2["return"], 74, 320)
}

fn test_initial_send_err() {
    var g = gen.start(avm_counter_worker, [10])
    var bad = gen.send(g, 99)
    assert_true(oren_is_err(bad) == true, 30)
    assert_true(oren_is_err(gen.next(123)) == true, 31)
    assert_true(oren_is_err(gen.send(123, 1)) == true, 32)
    assert_true(oren_is_err(gen.collect(123)) == true, 33)
    assert_true(oren_is_err(gen.close(123)) == true, 331)
    assert_true(oren_is_err(oren_generator_close(123)) == true, 332)
    assert_true(gen.is_done(123) == false, 34)
    assert_true(gen.return_value(123) == nil, 35)
    assert_true(oren_is_err(gen.delegate(123, g)) == true, 351)
    assert_true(oren_is_err(gen.delegate(123, 456)) == true, 352)
    assert_true(oren_is_err(oren_generator_delegate(123, 456)) == true, 353)
    var started_inner = gen.start(avm_delegate_inner_worker, [70])
    var started_step = gen.next(started_inner)
    assert_true(oren_is_err(started_step) == false, 354)
    assert_true(oren_is_err(gen.delegate_step(123, started_inner, started_step)) == true, 355)
    assert_true(oren_is_err(gen.delegate_step([], 456, started_step)) == true, 356)
    assert_true(oren_is_err(gen.delegate_step([], started_inner, 789)) == true, 357)
    assert_true(oren_is_err(gen.on_close(123, || nil)) == true, 3571)
    assert_true(oren_is_err(oren_generator_on_close(123, || nil)) == true, 3572)
    var started_step1 = gen.send(started_inner, 6)
    assert_true(oren_is_err(started_step1) == false, 358)
    assert_eq(started_step1["value"], 76, 359)
    var started_step2 = gen.send(started_inner, 10)
    assert_true(oren_is_err(started_step2) == false, 360)
    assert_eq(started_step2["return"], 60, 361)

    var g_bad = gen.start(avm_bad_on_close_worker, [])
    var bad_done = gen.next(g_bad)
    assert_true(oren_is_err(bad_done) == false, 3611)
    assert_true(bad_done["done"] == true, 3612)
    assert_eq(bad_done["return"], 1, 3613)
}

fn test_close_surface() {
    var g0 = gen.start(avm_counter_worker, [15])
    var close0 = gen.close(g0)
    assert_true(oren_is_err(close0) == false, 362)
    assert_true(close0 == nil, 363)
    assert_true(gen.is_done(g0) == true, 364)
    assert_true(gen.return_value(g0) == nil, 365)
    var close0step = gen.next(g0)
    assert_true(oren_is_err(close0step) == false, 366)
    assert_true(close0step["done"] == true, 367)
    assert_true(close0step["return"] == nil, 368)
    var close0xs = gen.collect(g0)
    assert_true(oren_is_err(close0xs) == false, 369)
    assert_eq(oren_list_len(close0xs), 0, 370)

    var g1 = gen.start(avm_counter_worker, [25])
    var c1s0 = gen.next(g1)
    assert_true(oren_is_err(c1s0) == false, 371)
    assert_eq(c1s0["value"], 26, 372)
    var close1 = gen.close(g1)
    assert_true(oren_is_err(close1) == false, 373)
    assert_true(close1 == nil, 374)
    assert_true(gen.is_done(g1) == true, 375)
    assert_true(gen.return_value(g1) == nil, 376)
    var close1done = gen.send(g1, 99)
    assert_true(oren_is_err(close1done) == false, 377)
    assert_true(close1done["done"] == true, 378)
    assert_true(close1done["return"] == nil, 379)

    var g2 = gen.start(avm_counter_worker, [35])
    assert_true(oren_is_err(gen.next(g2)) == false, 380)
    assert_true(oren_is_err(gen.send(g2, 4)) == false, 381)
    var c2done = gen.send(g2, 9)
    assert_true(oren_is_err(c2done) == false, 382)
    assert_eq(c2done["return"], 14, 383)
    var close2 = gen.close(g2)
    assert_true(oren_is_err(close2) == false, 384)
    assert_eq(close2, 14, 385)
    assert_eq(gen.return_value(g2), 14, 386)

    var g3 = oren_generator_start(avm_counter_worker, [18])
    var close3 = oren_generator_close(g3)
    assert_true(oren_is_err(close3) == false, 387)
    assert_true(close3 == nil, 388)
    assert_true(oren_generator_is_done(g3) == true, 389)
    assert_true(oren_generator_return_value(g3) == nil, 390)

    var g4 = avm_decl_delegate(45)
    var c4s0 = gen.next(g4)
    assert_true(oren_is_err(c4s0) == false, 391)
    assert_eq(c4s0["value"], 46, 392)
    var close4 = gen.close(g4)
    assert_true(oren_is_err(close4) == false, 393)
    assert_true(close4 == nil, 394)
    assert_true(gen.is_done(g4) == true, 395)
    assert_true(gen.return_value(g4) == nil, 396)

    var close_cells0 = [nil, nil]
    var g5 = gen.start(avm_delegate_chain_started_outer_worker, [close_cells0, 55])
    var c5s0 = gen.next(g5)
    assert_true(oren_is_err(c5s0) == false, 397)
    assert_eq(c5s0["value"], 56, 398)
    var c5mid = close_cells0[0]
    var c5inner = close_cells0[1]
    assert_true(gen.is_done(c5mid) == false, 399)
    assert_true(gen.is_done(c5inner) == false, 400)
    var close5 = gen.close(g5)
    assert_true(oren_is_err(close5) == false, 401)
    assert_true(close5 == nil, 402)
    assert_true(gen.is_done(g5) == true, 403)
    assert_true(gen.return_value(g5) == nil, 404)
    assert_true(gen.is_done(c5mid) == true, 405)
    assert_true(gen.return_value(c5mid) == nil, 406)
    assert_true(gen.is_done(c5inner) == true, 407)
    assert_true(gen.return_value(c5inner) == nil, 408)
    var c5mid_done = gen.next(c5mid)
    assert_true(oren_is_err(c5mid_done) == false, 409)
    assert_true(c5mid_done["done"] == true, 410)
    assert_true(c5mid_done["return"] == nil, 411)
    var c5inner_done = gen.next(c5inner)
    assert_true(oren_is_err(c5inner_done) == false, 412)
    assert_true(c5inner_done["done"] == true, 413)
    assert_true(c5inner_done["return"] == nil, 414)

    var close_cells1 = [nil, nil]
    var g6 = avm_decl_delegate_chain(close_cells1, 65)
    var c6s0 = gen.next(g6)
    assert_true(oren_is_err(c6s0) == false, 415)
    assert_eq(c6s0["value"], 66, 416)
    var c6mid = close_cells1[0]
    var c6inner = close_cells1[1]
    assert_true(gen.is_done(c6mid) == false, 417)
    assert_true(gen.is_done(c6inner) == false, 418)
    var close6 = gen.close(g6)
    assert_true(oren_is_err(close6) == false, 419)
    assert_true(close6 == nil, 420)
    assert_true(gen.is_done(g6) == true, 421)
    assert_true(gen.return_value(g6) == nil, 422)
    assert_true(gen.is_done(c6mid) == true, 423)
    assert_true(gen.return_value(c6mid) == nil, 424)
    assert_true(gen.is_done(c6inner) == true, 425)
    assert_true(gen.return_value(c6inner) == nil, 426)

    var hook_box0 = []
    var g7 = gen.start(avm_close_hook_worker, [hook_box0, 80])
    var c7s0 = gen.next(g7)
    assert_true(oren_is_err(c7s0) == false, 427)
    assert_eq(c7s0["value"], 80, 428)
    var close7 = gen.close(g7)
    assert_true(oren_is_err(close7) == false, 429)
    assert_eq(oren_list_len(hook_box0), 2, 430)
    assert_eq(hook_box0[0], 82, 431)
    assert_eq(hook_box0[1], 81, 432)
    assert_true(gen.is_done(g7) == true, 433)

    var hook_box1 = []
    var g8 = avm_decl_close_hook(hook_box1, 90)
    var c8s0 = gen.next(g8)
    assert_true(oren_is_err(c8s0) == false, 434)
    assert_eq(c8s0["value"], 91, 435)
    var close8 = gen.close(g8)
    assert_true(oren_is_err(close8) == false, 436)
    assert_eq(oren_list_len(hook_box1), 2, 437)
    assert_eq(hook_box1[0], 110, 438)
    assert_eq(hook_box1[1], 100, 439)
    assert_true(gen.is_done(g8) == true, 440)

    var hook_box2 = []
    var g9 = gen.start(avm_close_hook_err_worker, [hook_box2])
    var c9s0 = gen.next(g9)
    assert_true(oren_is_err(c9s0) == false, 441)
    assert_eq(c9s0["value"], 1, 442)
    var close9 = gen.close(g9)
    assert_true(oren_is_err(close9) == true, 443)
    assert_eq(oren_list_len(hook_box2), 2, 444)
    assert_eq(hook_box2[0], 2, 445)
    assert_eq(hook_box2[1], 1, 446)
    assert_true(gen.is_done(g9) == true, 447)
    assert_true(gen.return_value(g9) == nil, 448)
}

fn test_generator_decl_syntax() {
    var g0 = avm_decl_counter(40)
    assert_eq(oren_type_name(g0), "generator", 39)
    var s0 = gen.next(g0)
    assert_true(oren_is_err(s0) == false, 40)
    assert_eq(s0["value"], 41, 41)
    var s1 = gen.send(g0, 2)
    assert_true(oren_is_err(s1) == false, 42)
    assert_eq(s1["value"], 42, 43)
    var s2 = gen.send(g0, 7)
    assert_true(oren_is_err(s2) == false, 44)
    assert_eq(s2["return"], 12, 45)

    var g1 = avm_decl_nil(60)
    var n0 = gen.next(g1)
    assert_true(oren_is_err(n0) == false, 46)
    assert_true(n0["value"] == nil, 47)
    var n1 = gen.send(g1, 3)
    assert_true(oren_is_err(n1) == false, 48)
    assert_eq(n1["return"], 67, 49)

    var g2 = avm_decl_collect(5)
    var xs = gen.collect(g2)
    assert_true(oren_is_err(xs) == false, 50)
    assert_eq(oren_list_len(xs), 3, 51)
    assert_eq(xs[0], 5, 52)
    assert_eq(xs[1], 6, 53)
    assert_eq(xs[2], 7, 54)
    assert_eq(gen.return_value(g2), 35, 55)

    var g3 = avm_decl_collect(8)
    var dsum = 0
    for dv in g3 { dsum = dsum + dv }
    assert_eq(dsum, 27, 551)
    assert_true(gen.is_done(g3) == true, 552)
    assert_eq(gen.return_value(g3), 38, 553)

    var g4 = avm_decl_delegate(30)
    var y0 = gen.next(g4)
    assert_true(oren_is_err(y0) == false, 554)
    assert_eq(y0["value"], 31, 555)
    var y1 = gen.send(g4, 4)
    assert_true(oren_is_err(y1) == false, 556)
    assert_eq(y1["value"], 34, 557)
    var y2 = gen.send(g4, 9)
    assert_true(oren_is_err(y2) == false, 558)
    assert_eq(y2["return"], 80, 559)

    var g5 = avm_decl_delegate_started(35)
    var z0 = gen.next(g5)
    assert_true(oren_is_err(z0) == false, 560)
    assert_eq(z0["value"], 36, 561)
    var z1 = gen.send(g5, 5)
    assert_true(oren_is_err(z1) == false, 562)
    assert_eq(z1["value"], 40, 563)
    var z2 = gen.send(g5, 10)
    assert_true(oren_is_err(z2) == false, 564)
    assert_eq(z2["return"], 83, 565)

}

fn test_local_generator_decl_syntax() {
    var local_bias = 7
    fn local_add(a, b) {
        return a + b + local_bias
    }
    local_bias = 100
    assert_eq(local_add(1, 2), 10, 56)

    var local_gen_bias = 100
    @oren.generator
    fn local_decl(seed) {
        var resumed = yield (seed + local_gen_bias)
        return resumed + local_gen_bias
    }
    local_gen_bias = 999
    var g = local_decl(5)
    var s0 = gen.next(g)
    assert_true(oren_is_err(s0) == false, 57)
    assert_eq(s0["value"], 105, 58)
    var s1 = gen.send(g, 4)
    assert_true(oren_is_err(s1) == false, 59)
    assert_eq(s1["return"], 104, 60)
}

fn test_generator_var_decl_syntax() {
    var g0 = avm_decl_var_counter(40)
    assert_eq(oren_type_name(g0), "generator", 61)
    var s0 = gen.next(g0)
    assert_true(oren_is_err(s0) == false, 62)
    assert_eq(s0["value"], 41, 63)
    var s1 = gen.send(g0, 2)
    assert_true(oren_is_err(s1) == false, 64)
    assert_eq(s1["value"], 42, 65)
    var s2 = gen.send(g0, 7)
    assert_true(oren_is_err(s2) == false, 66)
    assert_eq(s2["return"], 12, 67)

    var g1 = avm_decl_var_lambda(30)
    assert_eq(oren_type_name(g1), "generator", 68)
    var l0 = gen.next(g1)
    assert_true(oren_is_err(l0) == false, 69)
    assert_eq(l0["value"], 32, 70)
    var l1 = gen.send(g1, 4)
    assert_true(oren_is_err(l1) == false, 71)
    assert_eq(l1["return"], 13, 72)

    var local_var_bias = 30
    @oren.generator
    var local_var_decl = fn(seed) {
        var resumed = yield (seed + local_var_bias)
        return resumed + local_var_bias
    }
    local_var_bias = 999
    var g2 = local_var_decl(5)
    var v0 = gen.next(g2)
    assert_true(oren_is_err(v0) == false, 73)
    assert_eq(v0["value"], 35, 74)
    var v1 = gen.send(g2, 4)
    assert_true(oren_is_err(v1) == false, 75)
    assert_eq(v1["return"], 34, 76)

    var g3 = avm_decl_nil(70)
    var nil_count = 0
    for nv in g3 {
        assert_true(nv == nil, 77)
        nil_count = nil_count + 1
    }
    assert_eq(nil_count, 1, 78)
    assert_true(gen.is_done(g3) == true, 79)
    assert_eq(gen.return_value(g3), 77, 80)
}

fn main() {
    test_step_protocol()
    test_nil_and_collect()
    test_initial_send_err()
    test_close_surface()
    test_generator_decl_syntax()
    test_local_generator_decl_syntax()
    test_generator_var_decl_syntax()
    print("test_generator_v0: OK")
    oren_exit(0)
}
