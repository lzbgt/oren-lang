import gen "../../lib/std/generator.oren"

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    print("test_generator_v0 FAIL " + oren_int_to_string(code))
    oren_exit(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    assert_eq(0, 1, code)
}

fn avm_counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn avm_nil_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -910 }
    var seed = args[0]
    yield in co
    return seed + 7
}

fn avm_collect_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -920 }
    var seed = args[0]
    var i = 0
    while i < 3 {
        yield (seed + i) in co
        i = i + 1
    }
    return seed + 30
}

fn avm_delegate_inner_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -930 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 50
}

fn avm_delegate_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -931 }
    var inner = gen.start(avm_delegate_inner_worker, [args[0]])
    var retv = gen.delegate(co, inner)
    return retv + 7
}

fn avm_delegate_outer_direct_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -932 }
    var inner = oren_generator_start(avm_delegate_inner_worker, [args[0]])
    var retv = oren_generator_delegate(co, inner)
    return retv + 9
}

fn avm_delegate_step_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -933 }
    var inner = gen.start(avm_delegate_inner_worker, [args[0]])
    var step0 = gen.next(inner)
    assert_true(oren_is_err(step0) == false, 3081)
    assert_eq(step0["value"], args[0] + 1, 3082)
    var retv = gen.delegate_step(co, inner, step0)
    assert_true(oren_is_err(retv) == false, 3083)
    return retv + 13
}

fn avm_delegate_step_outer_direct_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -934 }
    var inner = oren_generator_start(avm_delegate_inner_worker, [args[0]])
    var step0 = oren_generator_next(inner)
    assert_true(oren_is_err(step0) == false, 3084)
    assert_eq(step0["value"], args[0] + 1, 3085)
    var retv = oren_generator_delegate_step(co, inner, step0)
    assert_true(oren_is_err(retv) == false, 3086)
    return retv + 15
}

@oren.generator
fn avm_decl_counter(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
fn avm_decl_nil(seed) {
    yield
    return seed + 7
}

@oren.generator
fn avm_decl_collect(seed) {
    var i = 0
    while i < 3 {
        yield (seed + i)
        i = i + 1
    }
    return seed + 30
}

@oren.generator
var avm_decl_var_counter = fn(seed) {
    var resumed0 = yield (seed + 1)
    var resumed1 = yield (seed + resumed0)
    return resumed1 + 5
}

@oren.generator
var avm_decl_var_lambda = |seed| {
    var resumed = yield (seed + 2)
    return resumed + 9
}

fn test_step_protocol() {
    var g = gen.start(avm_counter_worker, [40])
    assert_eq(oren_type_name(g), "generator", 9)
    var s0 = gen.next(g)
    assert_true(oren_is_err(s0) == false, 10)
    assert_true(s0["ok"] == true, 11)
    assert_eq(s0["value"], 41, 12)
    var s1 = gen.send(g, 2)
    assert_true(oren_is_err(s1) == false, 13)
    assert_eq(s1["value"], 42, 14)
    var s2 = gen.send(g, 7)
    assert_true(oren_is_err(s2) == false, 15)
    assert_true(s2["done"] == true, 16)
    assert_eq(s2["return"], 12, 17)
    assert_true(gen.is_done(g) == true, 18)
    assert_eq(gen.return_value(g), 12, 19)
}

fn test_nil_and_collect() {
    var g0 = gen.start(avm_nil_worker, [60])
    var n0 = gen.next(g0)
    assert_true(oren_is_err(n0) == false, 20)
    assert_true(n0["value"] == nil, 21)
    var n1 = gen.send(g0, 3)
    assert_true(oren_is_err(n1) == false, 22)
    assert_eq(n1["return"], 67, 23)

    var g1 = gen.start(avm_collect_worker, [5])
    var xs = gen.collect(g1)
    assert_true(oren_is_err(xs) == false, 24)
    assert_eq(oren_list_len(xs), 3, 25)
    assert_eq(xs[0], 5, 26)
    assert_eq(xs[1], 6, 27)
    assert_eq(xs[2], 7, 28)
    assert_eq(gen.return_value(g1), 35, 29)

    var g2 = gen.start(avm_collect_worker, [9])
    var ys = []
    for y in g2 { oren_list_push(ys, y) }
    assert_eq(oren_list_len(ys), 3, 291)
    assert_eq(ys[0], 9, 292)
    assert_eq(ys[1], 10, 293)
    assert_eq(ys[2], 11, 294)
    assert_true(gen.is_done(g2) == true, 295)
    assert_eq(gen.return_value(g2), 39, 296)

    var g3 = gen.start(avm_delegate_outer_worker, [30])
    var d0 = gen.next(g3)
    assert_true(oren_is_err(d0) == false, 297)
    assert_eq(d0["value"], 31, 298)
    var d1 = gen.send(g3, 2)
    assert_true(oren_is_err(d1) == false, 299)
    assert_eq(d1["value"], 32, 300)
    var d2 = gen.send(g3, 7)
    assert_true(oren_is_err(d2) == false, 301)
    assert_eq(d2["return"], 64, 302)

    var g4 = gen.start(avm_delegate_outer_direct_worker, [40])
    var dd0 = gen.next(g4)
    assert_true(oren_is_err(dd0) == false, 303)
    assert_eq(dd0["value"], 41, 304)
    var dd1 = gen.send(g4, 3)
    assert_true(oren_is_err(dd1) == false, 305)
    assert_eq(dd1["value"], 43, 306)
    var dd2 = gen.send(g4, 8)
    assert_true(oren_is_err(dd2) == false, 307)
    assert_eq(dd2["return"], 67, 308)

    var g5 = gen.start(avm_delegate_step_outer_worker, [50])
    var ds0 = gen.next(g5)
    assert_true(oren_is_err(ds0) == false, 309)
    assert_eq(ds0["value"], 51, 310)
    var ds1 = gen.send(g5, 4)
    assert_true(oren_is_err(ds1) == false, 311)
    assert_eq(ds1["value"], 54, 312)
    var ds2 = gen.send(g5, 8)
    assert_true(oren_is_err(ds2) == false, 313)
    assert_eq(ds2["return"], 71, 314)

    var g6 = gen.start(avm_delegate_step_outer_direct_worker, [60])
    var dsd0 = gen.next(g6)
    assert_true(oren_is_err(dsd0) == false, 315)
    assert_eq(dsd0["value"], 61, 316)
    var dsd1 = gen.send(g6, 5)
    assert_true(oren_is_err(dsd1) == false, 317)
    assert_eq(dsd1["value"], 65, 318)
    var dsd2 = gen.send(g6, 9)
    assert_true(oren_is_err(dsd2) == false, 319)
    assert_eq(dsd2["return"], 74, 320)
}

fn test_initial_send_err() {
    var g = gen.start(avm_counter_worker, [10])
    var bad = gen.send(g, 99)
    assert_true(oren_is_err(bad) == true, 30)
    assert_true(oren_is_err(gen.next(123)) == true, 31)
    assert_true(oren_is_err(gen.send(123, 1)) == true, 32)
    assert_true(oren_is_err(gen.collect(123)) == true, 33)
    assert_true(gen.is_done(123) == false, 34)
    assert_true(gen.return_value(123) == nil, 35)
    assert_true(oren_is_err(gen.delegate(123, g)) == true, 351)
    assert_true(oren_is_err(gen.delegate(123, 456)) == true, 352)
    assert_true(oren_is_err(oren_generator_delegate(123, 456)) == true, 353)
    var started_inner = gen.start(avm_delegate_inner_worker, [70])
    var started_step = gen.next(started_inner)
    assert_true(oren_is_err(started_step) == false, 354)
    assert_true(oren_is_err(gen.delegate_step(123, started_inner, started_step)) == true, 355)
    assert_true(oren_is_err(gen.delegate_step([], 456, started_step)) == true, 356)
    assert_true(oren_is_err(gen.delegate_step([], started_inner, 789)) == true, 357)
    var started_step1 = gen.send(started_inner, 6)
    assert_true(oren_is_err(started_step1) == false, 358)
    assert_eq(started_step1["value"], 76, 359)
    var started_step2 = gen.send(started_inner, 10)
    assert_true(oren_is_err(started_step2) == false, 360)
    assert_eq(started_step2["return"], 60, 361)
}

fn test_generator_decl_syntax() {
    var g0 = avm_decl_counter(40)
    assert_eq(oren_type_name(g0), "generator", 39)
    var s0 = gen.next(g0)
    assert_true(oren_is_err(s0) == false, 40)
    assert_eq(s0["value"], 41, 41)
    var s1 = gen.send(g0, 2)
    assert_true(oren_is_err(s1) == false, 42)
    assert_eq(s1["value"], 42, 43)
    var s2 = gen.send(g0, 7)
    assert_true(oren_is_err(s2) == false, 44)
    assert_eq(s2["return"], 12, 45)

    var g1 = avm_decl_nil(60)
    var n0 = gen.next(g1)
    assert_true(oren_is_err(n0) == false, 46)
    assert_true(n0["value"] == nil, 47)
    var n1 = gen.send(g1, 3)
    assert_true(oren_is_err(n1) == false, 48)
    assert_eq(n1["return"], 67, 49)

    var g2 = avm_decl_collect(5)
    var xs = gen.collect(g2)
    assert_true(oren_is_err(xs) == false, 50)
    assert_eq(oren_list_len(xs), 3, 51)
    assert_eq(xs[0], 5, 52)
    assert_eq(xs[1], 6, 53)
    assert_eq(xs[2], 7, 54)
    assert_eq(gen.return_value(g2), 35, 55)

    var g3 = avm_decl_collect(8)
    var dsum = 0
    for dv in g3 { dsum = dsum + dv }
    assert_eq(dsum, 27, 551)
    assert_true(gen.is_done(g3) == true, 552)
    assert_eq(gen.return_value(g3), 38, 553)

}

fn test_local_generator_decl_syntax() {
    var local_bias = 7
    fn local_add(a, b) {
        return a + b + local_bias
    }
    local_bias = 100
    assert_eq(local_add(1, 2), 10, 56)

    var local_gen_bias = 100
    @oren.generator
    fn local_decl(seed) {
        var resumed = yield (seed + local_gen_bias)
        return resumed + local_gen_bias
    }
    local_gen_bias = 999
    var g = local_decl(5)
    var s0 = gen.next(g)
    assert_true(oren_is_err(s0) == false, 57)
    assert_eq(s0["value"], 105, 58)
    var s1 = gen.send(g, 4)
    assert_true(oren_is_err(s1) == false, 59)
    assert_eq(s1["return"], 104, 60)
}

fn test_generator_var_decl_syntax() {
    var g0 = avm_decl_var_counter(40)
    assert_eq(oren_type_name(g0), "generator", 61)
    var s0 = gen.next(g0)
    assert_true(oren_is_err(s0) == false, 62)
    assert_eq(s0["value"], 41, 63)
    var s1 = gen.send(g0, 2)
    assert_true(oren_is_err(s1) == false, 64)
    assert_eq(s1["value"], 42, 65)
    var s2 = gen.send(g0, 7)
    assert_true(oren_is_err(s2) == false, 66)
    assert_eq(s2["return"], 12, 67)

    var g1 = avm_decl_var_lambda(30)
    assert_eq(oren_type_name(g1), "generator", 68)
    var l0 = gen.next(g1)
    assert_true(oren_is_err(l0) == false, 69)
    assert_eq(l0["value"], 32, 70)
    var l1 = gen.send(g1, 4)
    assert_true(oren_is_err(l1) == false, 71)
    assert_eq(l1["return"], 13, 72)

    var local_var_bias = 30
    @oren.generator
    var local_var_decl = fn(seed) {
        var resumed = yield (seed + local_var_bias)
        return resumed + local_var_bias
    }
    local_var_bias = 999
    var g2 = local_var_decl(5)
    var v0 = gen.next(g2)
    assert_true(oren_is_err(v0) == false, 73)
    assert_eq(v0["value"], 35, 74)
    var v1 = gen.send(g2, 4)
    assert_true(oren_is_err(v1) == false, 75)
    assert_eq(v1["return"], 34, 76)

    var g3 = avm_decl_nil(70)
    var nil_count = 0
    for nv in g3 {
        assert_true(nv == nil, 77)
        nil_count = nil_count + 1
    }
    assert_eq(nil_count, 1, 78)
    assert_true(gen.is_done(g3) == true, 79)
    assert_eq(gen.return_value(g3), 77, 80)
}

fn main() {
    test_step_protocol()
    test_nil_and_collect()
    test_initial_send_err()
    test_generator_decl_syntax()
    test_local_generator_decl_syntax()
    test_generator_var_decl_syntax()
    print("test_generator_v0: OK")
    oren_exit(0)
}
