fn avm_finalize_hook_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -982 }
    var box = args[0]
    var base = args[1]
    var r0 = gen.on_finalize(co, || { oren_list_push(box, base + 1); return nil })
    if oren_is_err(r0) == true { return -983 }
    var r1 = oren_generator_on_finalize(co, || { oren_list_push(box, base + 2); return nil })
    if oren_is_err(r1) == true { return -984 }
    var r2 = gen.on_close(co, || { oren_list_push(box, base + 3); return nil })
    if oren_is_err(r2) == true { return -985 }
    var resumed = yield base in co
    return resumed + base + 7
}

