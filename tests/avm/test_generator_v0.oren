import gen "../../lib/std/generator.oren"
import reflect "../../lib/std/reflect.oren"

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    print("test_generator_v0 FAIL " + oren_int_to_string(code))
    oren_exit(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    assert_eq(0, 1, code)
}

fn avm_counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -900 }
    if oren_type_tag(co) != reflect.TAG_GENERATOR_CONTEXT { return -901 }
    if reflect.is_generator_context(co) != true { return -902 }
    if reflect.is_list(co) == true { return -903 }
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn avm_nil_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -910 }
    var seed = args[0]
    yield in co
    return seed + 7
}

fn avm_collect_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -920 }
    var seed = args[0]
    var i = 0
    while i < 3 {
        yield (seed + i) in co
        i = i + 1
    }
    return seed + 30
}

fn avm_cancel_probe_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -921 }
    assert_true(gen.is_cancel_requested(co) == false, 3091)
    assert_true(gen.cancel_reason(co) == nil, 3092)
    var seed = args[0]
    var reason = args[1]
    var resumed = yield seed in co
    assert_true(gen.is_cancel_requested(co) == true, 3093)
    assert_eq(gen.cancel_reason(co), reason, 3094)
    return resumed + reason
}

fn avm_capture_context_counter_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -924 }
    var cells = args[0]
    var seed = args[1]
    cells[0] = co
    var resumed = yield seed in co
    return resumed + 1
}

fn avm_cancel_delegate_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -922 }
    var inner = gen.start(avm_cancel_probe_worker, [args[0], args[1]])
    var retv = gen.delegate(co, inner)
    assert_true(oren_is_err(retv) == false, 3095)
    return retv
}

fn avm_cancel_delegate_capture_outer_worker(co, args) {
    if oren_type_name(co) != "generator_context" { return -923 }
    var cells = args[0]
    var inner = gen.start(avm_cancel_probe_worker, [args[1], args[2]])
    cells[0] = inner
    var retv = gen.delegate(co, inner)
    assert_true(oren_is_err(retv) == false, 3096)
    return retv
}

