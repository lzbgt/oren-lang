fn fail() {
    // Force a non-zero VM exit by triggering an index error.
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_true(x) {
    if x { return 0 }
    fail()
}

fn assert_false(x) {
    if x { fail() }
}

fn bump(box) {
    box[0] = box[0] + 1
    return 1
}

fn main() {
    // Literals and truthiness
    assert_true(true)
    assert_false(false)
    assert_false(nil)

    // Prefix ops
    assert_true(!false)
    assert_false(!true)

    // Bit ops
    if ~0 != -1 { fail() }
    var bit_and = 1 & 3
    if bit_and != 1 { fail() }
    var bit_or = 1 | 2
    if bit_or != 3 { fail() }
    var bit_xor = 5 ^ 1
    if bit_xor != 4 { fail() }
    if 1 << 5 != 32 { fail() }
    if 32 >> 5 != 1 { fail() }

    // Short-circuit && / ||
    var box = [0]

    if false && bump(box) != 0 { fail() }
    if box[0] != 0 { fail() }

    if !(true || bump(box) != 0) { fail() }
    if box[0] != 0 { fail() }

    // BOOL comparisons must work
    if true == false { fail() }
    if true != true { fail() }
    if false == false != true { fail() }

    print("avm bool/bit ops OK")
}

main()
