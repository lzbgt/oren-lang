fn assert_eq(a, b) {
    if a != b {
        print("test_yield_exchange_v0 FAIL")
        exit(1)
    }
}

fn avm_exchange_worker(out_ch, in_ch, seed) {
    var resumed = oren_yield_exchange(out_ch, in_ch, seed + 1)
    return resumed + 5
}

fn avm_exchange_call_arg_worker(out_ch, in_ch, seed) {
    return oren_int_to_string(oren_yield_exchange(out_ch, in_ch, seed + 2))
}

fn avm_exchange_syntax_worker(out_ch, in_ch, seed) {
    var resumed = yield (seed + 3) in (out_ch, in_ch)
    return resumed + 6
}

fn avm_exchange_syntax_nil_worker(out_ch, in_ch, seed) {
    var resumed = yield in (out_ch, in_ch)
    return resumed + seed
}

fn avm_exchange_host_reply_after_yield(out_ch, in_ch, delta) {
    var seen = oren_chan_recv(out_ch)
    oren_yield()
    oren_chan_send(in_ch, seen + delta)
    return delta
}

fn test_exchange_var() {
    var out = oren_new_channel()
    var inp = oren_new_channel()
    var h = spawn avm_exchange_worker(out, inp, 40)
    oren_yield()
    assert_eq(oren_chan_recv(out), 41)
    oren_chan_send(inp, 7)
    oren_yield()
    assert_eq(oren_join(h), 12)
}

fn test_exchange_call_arg() {
    var out = oren_new_channel()
    var inp = oren_new_channel()
    var h = spawn avm_exchange_call_arg_worker(out, inp, 50)
    oren_yield()
    assert_eq(oren_chan_recv(out), 52)
    oren_chan_send(inp, 9)
    oren_yield()
    assert_eq(oren_join(h), "9")
}

fn test_exchange_source_syntax() {
    var out = oren_new_channel()
    var inp = oren_new_channel()
    var h = spawn avm_exchange_syntax_worker(out, inp, 60)
    oren_yield()
    assert_eq(oren_chan_recv(out), 63)
    oren_chan_send(inp, 10)
    oren_yield()
    assert_eq(oren_join(h), 16)
}

fn test_exchange_source_nil() {
    var out = oren_new_channel()
    var inp = oren_new_channel()
    var h = spawn avm_exchange_syntax_nil_worker(out, inp, 70)
    oren_yield()
    assert_eq(oren_chan_recv(out), nil)
    oren_chan_send(inp, 11)
    oren_yield()
    assert_eq(oren_join(h), 81)
}

fn test_exchange_host_green_helper() {
    var out = oren_new_channel()
    var inp = oren_new_channel()
    var h = spawn avm_exchange_host_reply_after_yield(out, inp, 21)
    assert_eq(oren_yield_exchange(out, inp, 90), 111)
    assert_eq(oren_join(h), 21)
}

fn test_exchange_host_green_syntax() {
    var out = oren_new_channel()
    var inp = oren_new_channel()
    var h = spawn avm_exchange_host_reply_after_yield(out, inp, 22)
    assert_eq(yield 91 in (out, inp), 113)
    assert_eq(oren_join(h), 22)
}

fn main() {
    test_exchange_var()
    test_exchange_call_arg()
    test_exchange_source_syntax()
    test_exchange_source_nil()
    test_exchange_host_green_helper()
    test_exchange_host_green_syntax()
    print("test_yield_exchange_v0: OK")
    return 0
}
