fn fail() {
    // Force a non-zero VM exit by triggering an index error.
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_eq(a, b) {
    if a != b { fail() }
}

fn main() {
    var m = {
        "x": [1, 2, 3],
        "y": {"z": 4}
    }
    var l = [
        [10, 20],
        [30]
    ]
    var n = {
        "a": {"b": [5]}
    }

    var s = {"m": m, "l": l, "n": n}

    assert_eq(s["m"]["x"][1], 2)
    assert_eq(s["m"]["y"]["z"], 4)
    assert_eq(s["l"][0][1], 20)
    assert_eq(s["n"]["a"]["b"][0], 5)

    var xs = s["m"]["x"]
    xs[1] = 42
    assert_eq(s["m"]["x"][1], 42)

    var y = s["m"]["y"]
    y["z"] = 7
    assert_eq(s["m"]["y"]["z"], 7)

    print("avm nested containers OK")
}

main()

