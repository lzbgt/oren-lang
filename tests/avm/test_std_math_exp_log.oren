@myorg.tag(name="avm-std-math-exp-log")

import math "../../lib/std/math.oren"

fn fail(code, msg) {
    print("avm std math exp/log FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_close(a, b, eps, code, msg) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code, msg)
}

assert_close(math.exp(0.0), 1.0, 1e-12, 10, "exp(0)")
assert_close(math.exp2(10.0), 1024.0, 1e-9, 11, "exp2(10)")
assert_close(math.exp2(0.0 - 3.0), 0.125, 1e-12, 12, "exp2(-3)")
assert_close(math.exp10(3.0), 1000.0, 1e-6, 13, "exp10(3)")
assert_close(math.expm1(1.0), 1.718281828459045, 1e-10, 14, "expm1(1)")
assert_close(math.expm1(1e-9), 1.0000000005e-9, 1e-18, 15, "expm1(small)")

assert_close(math.ln(1.0), 0.0, 1e-12, 20, "ln(1)")
assert_close(math.log(3.0), math.ln(3.0), 1e-12, 21, "log alias")
assert_close(math.log2(8.0), 3.0, 1e-10, 22, "log2(8)")
assert_close(math.log10(1000.0), 3.0, 1e-10, 23, "log10(1000)")
assert_close(math.log1p(1.0), 0.6931471805599453, 1e-10, 24, "log1p(1)")
assert_close(math.log1p(1e-9), 9.999999995e-10, 1e-18, 25, "log1p(small)")

assert_close(math.exp(math.ln(3.0)), 3.0, 1e-10, 30, "exp(ln(3))")
assert_close(math.ln(math.exp(2.0)), 2.0, 1e-10, 31, "ln(exp(2))")
assert_close(math.exp2(math.log2(5.0)), 5.0, 1e-10, 32, "exp2(log2(5))")
assert_close(math.log1p(math.expm1(0.125)), 0.125, 1e-10, 33, "log1p(expm1)")
assert_close(math.expm1(math.log1p(0.125)), 0.125, 1e-10, 34, "expm1(log1p)")
assert_close(math.erf(1.0), 0.8427007929497149, 3e-7, 35, "erf(1)")
assert_close(math.erfc(1.0), 0.1572992070502851, 3e-7, 36, "erfc(1)")
assert_close(math.erf(2.0), 0.9953222650189527, 3e-7, 37, "erf(2)")
assert_close(math.erfc(2.0), 0.004677734981047266, 3e-7, 38, "erfc(2)")
assert_close(math.erf(1.25) + math.erfc(1.25), 1.0, 1e-12, 39, "erf erfc sum")

var sinh_one: f64 = math.sinh(1.0)
var cosh_one: f64 = math.cosh(1.0)
var tanh_one: f64 = math.tanh(1.0)
assert_close(sinh_one, 1.1752011936438014, 1e-10, 40, "sinh(1)")
assert_close(math.sinh(0.0 - 1.0), 0.0 - 1.1752011936438014, 1e-10, 41, "sinh(-1)")
assert_close(cosh_one, 1.5430806348152437, 1e-10, 42, "cosh(1)")
assert_close(math.cosh(0.0 - 1.0), cosh_one, 1e-12, 43, "cosh even")
assert_close(tanh_one, 0.7615941559557649, 1e-10, 44, "tanh(1)")
assert_close(math.tanh(0.0 - 1.0), 0.0 - 0.7615941559557649, 1e-10, 45, "tanh(-1)")
assert_close(cosh_one * cosh_one - sinh_one * sinh_one, 1.0, 1e-9, 46, "hyperbolic identity")
assert_close(sinh_one / cosh_one, tanh_one, 1e-10, 47, "tanh ratio")
assert_close(math.asinh(sinh_one), 1.0, 1e-9, 48, "asinh(sinh(1))")
assert_close(math.acosh(cosh_one), 1.0, 1e-9, 49, "acosh(cosh(1))")
assert_close(math.atanh(tanh_one), 1.0, 1e-9, 50, "atanh(tanh(1))")

assert_true(oren_is_err(math.exp(0.0 / 0.0)), 60, "exp(NaN) must err")
assert_true(oren_is_err(math.log2(0.0 - 1.0)), 61, "log2(negative) must err")
assert_true(math.is_inf(math.log2(0.0)), 62, "log2(0) must be -inf")
assert_true(math.is_inf(math.exp2(2048.0)), 63, "exp2 overflow must be inf")
assert_close(math.exp2(0.0 - 2048.0), 0.0, 1e-12, 64, "exp2 underflow")
assert_true(oren_is_err(math.sinh(0.0 / 0.0)), 65, "sinh(NaN) must err")
assert_true(oren_is_err(math.cosh(0.0 / 0.0)), 66, "cosh(NaN) must err")
assert_true(oren_is_err(math.tanh(0.0 / 0.0)), 67, "tanh(NaN) must err")
assert_true(math.is_inf(math.sinh(math.neg_inf())), 68, "sinh(-inf) must be inf")
assert_true(math.signbit(math.sinh(math.neg_inf())), 69, "sinh(-inf) sign")
assert_true(math.is_inf(math.cosh(math.neg_inf())), 70, "cosh(-inf) must be inf")
assert_close(math.tanh(math.inf()), 1.0, 0.0, 71, "tanh(+inf)")
assert_close(math.tanh(math.neg_inf()), 0.0 - 1.0, 0.0, 72, "tanh(-inf)")
assert_true(oren_is_err(math.asinh(0.0 / 0.0)), 73, "asinh(NaN) must err")
assert_true(oren_is_err(math.acosh(0.0 / 0.0)), 74, "acosh(NaN) must err")
assert_true(oren_is_err(math.atanh(0.0 / 0.0)), 75, "atanh(NaN) must err")
assert_true(oren_is_err(math.acosh(0.5)), 76, "acosh domain")
assert_true(oren_is_err(math.atanh(1.5)), 77, "atanh domain")
var atanh_one: f64 = math.atanh(1.0)
assert_true(math.is_inf(atanh_one), 78, "atanh(+1) must be inf")
assert_true(!math.signbit(atanh_one), 79, "atanh(+1) sign")
var atanh_neg_one: f64 = math.atanh(0.0 - 1.0)
assert_true(math.is_inf(atanh_neg_one), 80, "atanh(-1) must be inf")
assert_true(math.signbit(atanh_neg_one), 81, "atanh(-1) sign")
assert_true(oren_is_err(math.expm1(0.0 / 0.0)), 82, "expm1(NaN) must err")
assert_true(oren_is_err(math.log1p(0.0 / 0.0)), 83, "log1p(NaN) must err")
assert_true(oren_is_err(math.log1p(0.0 - 1.5)), 84, "log1p domain")
var log1p_neg_one: f64 = math.log1p(0.0 - 1.0)
assert_true(math.is_inf(log1p_neg_one), 85, "log1p(-1) must be inf")
assert_true(math.signbit(log1p_neg_one), 86, "log1p(-1) sign")
assert_close(math.erf(math.inf()), 1.0, 0.0, 87, "erf(+inf)")
assert_close(math.erf(math.neg_inf()), 0.0 - 1.0, 0.0, 88, "erf(-inf)")
assert_close(math.erfc(math.inf()), 0.0, 0.0, 89, "erfc(+inf)")
assert_close(math.erfc(math.neg_inf()), 2.0, 0.0, 90, "erfc(-inf)")
assert_true(oren_is_err(math.erf(0.0 / 0.0)), 91, "erf(NaN) must err")
assert_true(oren_is_err(math.erfc(0.0 / 0.0)), 92, "erfc(NaN) must err")

print("avm std math exp/log OK")
exit(0)
