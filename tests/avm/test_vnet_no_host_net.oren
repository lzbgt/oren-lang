import http "std:net/avm/http"
import socket "std:net/avm/socket"

fn fail(msg) {
    print("FAIL")
    print(msg)
    oren_exit(1)
}

fn main() {
    // This test is intended to run with:
    //   --net-backend vnet --net-fixtures-hex <...>
    // so NET domain calls do not touch the host network.
    var req = http.get("u")
    if oren_is_err(req) { fail("unexpected request error") }
    if http.text(req) != "ok" { fail("unexpected functional text body") }
    if req.text() != "ok" { fail("unexpected receiver text body") }
    if http.get("u").text() != "ok" { fail("unexpected chained text body") }
    var req_get_fragment = http.get("u#frag")
    if oren_is_err(req_get_fragment) { fail("unexpected get fragment request error") }
    if req_get_fragment.url != "u" { fail("unexpected get fragment url") }
    if req_get_fragment.text() != "ok" { fail("unexpected get fragment body") }
    var req_query = http.request("GET", "u?old=1", {"query": [["q", "hello world"]]})
    if oren_is_err(req_query) { fail("unexpected query request error") }
    if req_query.url != "u?q=hello%20world" { fail("unexpected query request url") }
    if req_query.text() != "query" { fail("unexpected query body") }
    var req_append = http.request("GET", "u?old=1", {"append_query": [["q", "hello world"]]})
    if oren_is_err(req_append) { fail("unexpected append request error") }
    if req_append.url != "u?old=1&q=hello%20world" { fail("unexpected append request url") }
    if req_append.text() != "append" { fail("unexpected append body") }
    var req_fragment = http.request("GET", "u?old=1#frag", {"append_query": [["q", "hello world"]]})
    if oren_is_err(req_fragment) { fail("unexpected fragment request error") }
    if req_fragment.url != "u?old=1&q=hello%20world" { fail("unexpected fragment request url") }
    if req_fragment.text() != "append" { fail("unexpected fragment body") }
    if socket.clean_spec("tcp://127.0.0.1:7/path?x=1#frag") != "tcp://127.0.0.1:7/path?x=1" { fail("unexpected clean tcp spec") }
    if socket.clean_spec("udp://[::1]:53#frag") != "udp://[::1]:53" { fail("unexpected clean udp spec") }
    if !oren_is_err(socket.clean_spec("tcp://::1:7")) { fail("unexpected valid bare ipv6 spec") }
    oren_exit(0)
}

main()
