@myorg.tag(name="avm-bytes-set-endian")

import list "std:list"
import bytes "std:bytes"

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn main() {
    // list<int> path
    var l16 = [0, 0]
    assert_eq(oren_bytes_set_u16_be(l16, 0, 4660), 4660)
    assert_eq(l16[0], 18)
    assert_eq(l16[1], 52)
    assert_eq(oren_bytes_get_u16_be(l16, 0), 4660)

    var l16n = [0, 0]
    assert_eq(oren_bytes_set_i16_be(l16n, 0, -2), -2)
    assert_eq(l16n[0], 255)
    assert_eq(l16n[1], 254)
    assert_eq(oren_bytes_get_i16_be(l16n, 0), -2)

    var l32 = [0, 0, 0, 0]
    assert_eq(oren_bytes_set_u32_be(l32, 0, 16909060), 16909060)
    assert_eq(l32[0], 1)
    assert_eq(l32[3], 4)
    assert_eq(oren_bytes_get_u32_be(l32, 0), 16909060)

    var l32n = [0, 0, 0, 0]
    assert_eq(oren_bytes_set_i32_be(l32n, 0, -2), -2)
    assert_eq(l32n[0], 255)
    assert_eq(l32n[3], 254)
    assert_eq(oren_bytes_get_i32_be(l32n, 0), -2)

    var li = list.int_new(0)
    list.int_push(li, 1)
    list.int_push(li, 2)
    list.int_push(li, 3)
    list.int_push(li, 4)
    list.int_push(li, 5)
    list.int_push(li, 6)
    list.int_push(li, 7)
    list.int_push(li, 8)
    assert_eq(oren_bytes_get_u8(li, 0), 1)
    assert_eq(oren_bytes_get_u16_be(li, 0), 258)
    assert_eq(oren_bytes_get_u32_le(li, 0), 67305985)
    assert_eq(oren_bytes_get_u64_be(li, 0), 72623859790382856)
    assert_eq(oren_bytes_set_u8(li, 0, 170), 170)
    assert_eq(oren_bytes_get_u8(li, 0), 170)
    assert_eq(oren_bytes_set_u16_le(li, 1, 4660), 4660)
    assert_eq(oren_bytes_get_u16_le(li, 1), 4660)
    assert_eq(oren_bytes_set_i16_be(li, 3, -2), -2)
    assert_eq(oren_bytes_get_i16_be(li, 3), -2)
    assert_eq(oren_bytes_set_u32_be(li, 0, 16909060), 16909060)
    assert_eq(oren_bytes_get_u32_be(li, 0), 16909060)
    assert_eq(oren_bytes_set_i32_le(li, 0, -2), -2)
    assert_eq(oren_bytes_get_i32_le(li, 0), -2)
    assert_eq(oren_bytes_set_u64_be(li, 0, 72623859790382856), 72623859790382856)
    assert_eq(oren_bytes_get_u64_be(li, 0), 72623859790382856)
    assert_eq(oren_bytes_set_i64_le(li, 0, -2), -2)
    assert_eq(oren_bytes_get_i64_le(li, 0), -2)

    // bytes path
    var b = oren_bytes_from_hex("0000")
    if oren_is_err(b) { fail() }
    assert_eq(oren_bytes_set_u16_be(b, 0, 4660), 4660)
    assert_eq(oren_bytes_get_u8(b, 0), 18)
    assert_eq(oren_bytes_get_u8(b, 1), 52)
    assert_eq(oren_bytes_get_u16_be(b, 0), 4660)
    assert_eq(bytes.get_u16_be(b, 0), 4660)
    assert_eq(bytes.get_u16_le(b, 0), 13330)
    var b8 = oren_bytes_from_hex("0102030405060708")
    if oren_is_err(b8) { fail() }
    assert_eq(bytes.get_u32_be(b8, 0), 16909060)
    assert_eq(bytes.get_u32_le(b8, 0), 67305985)
    assert_eq(bytes.get_u64_be(b8, 0), 72623859790382856)
    assert_eq(bytes.get_u64_le(b8, 0), 578437695752307201)
    if oren_is_err(bytes.get_u32_be(b8, 5)) == false { fail() }

    print("avm bytes_set_endian OK")
}

main()
