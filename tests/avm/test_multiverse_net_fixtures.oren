fn main() {
    // Parent universe reads a child .obc as BYTES, then runs it as a nested universe
    // via the AVM capability domain (domain 8).
    //
    // Makefile builds the child .obc at:
    //   build/multiverse_child_net.obc
    var child_obc = oren_read_bytes("build/multiverse_child_net.obc")

    // Child must be able to use CORE (domain 0) and NET (domain 4).
    var allowed = (1 << 0) + (1 << 4)

    // AVMNET01 fixtures: 1 entry mapping url="u" -> body="ok"
    var net_fx = oren_bytes_from_hex("41564d4e45543031010000000100000075020000006f6b")

    var cfg = {
        "deterministic": true,
        "gas_limit": 1000000,
        "allowed_domains": allowed,
        "net_backend": 1,
        "net_fixtures": net_fx
    }

    var r1 = oren_avm_run_obc_bytes(child_obc, cfg)
    oren_set_result({"exit_code": r1["exit_code"], "log_len": oren_bytes_len(r1["record_log"])})
}

main()

