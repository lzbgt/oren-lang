import list "std:list"

fn fail() {
    // Force a non-zero VM exit by triggering an index error.
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_eq(a, b) {
    if a != b { fail() }
}

fn main() {
    var xs = list.int_new(2)
    list.int_reserve(xs, 8)

    var i = 0
    while i < 4 {
        list.int_push(xs, i * 2)
        i = i + 1
    }

    assert_eq(list.int_len(xs), 4)
    assert_eq(list.int_get(xs, 0), 0)
    assert_eq(list.int_get(xs, 3), 6)

    xs[1] = 99
    assert_eq(xs[1], 99)

    list.int_set(xs, 2, 77)
    assert_eq(list.int_get(xs, 2), 77)

    var ys = list.int_new(1)
    for var j = 0; j < 4; j = j + 1 {
        list.int_push(ys, (j * 3 + 1) % 10)
    }
    assert_eq(list.int_len(ys), 4)
    assert_eq(list.int_get(ys, 0), 1)
    assert_eq(list.int_get(ys, 3), 0)

    var a = list.int_new(1)
    var b = list.int_new(1)
    var k = 0
    while k < 3 {
        list.int_push(a, k + 10)
        list.int_push(b, k * 2)
        k = k + 1
    }
    assert_eq(list.int_len(a), 3)
    assert_eq(list.int_len(b), 3)
    assert_eq(list.int_get(a, 2), 12)
    assert_eq(list.int_get(b, 2), 4)

    var c = list.int_new(1)
    var d = list.int_new(1)
    var e = list.int_new(1)
    for var m = 0; m < 3; m = m + 1 {
        list.int_push(c, m + 1)
        list.int_push(d, m + 2)
        list.int_push(e, m + 3)
    }
    assert_eq(list.int_len(c), 3)
    assert_eq(list.int_len(d), 3)
    assert_eq(list.int_len(e), 3)
    assert_eq(list.int_get(c, 2), 3)
    assert_eq(list.int_get(d, 2), 4)
    assert_eq(list.int_get(e, 2), 5)

    print("avm list<int> OK")
}

main()
