        ]
    })
    assert_true(oren_is_err(from_draw_override) == false)
    assert_eq(from_draw_override[2]["id"], 79)
    assert_eq(from_draw_override[3]["op"], "model3d")
    assert_eq(from_draw_override[3]["id"], 80)
    assert_eq(from_draw_override[3]["material_id"], 78)
    assert_eq(from_draw_override[3]["x"], 1)
    assert_eq(from_draw_override[4]["id"], 80)
    var override_buf = ui_raster.rasterize(from_draw_override, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(override_buf) == false)
    assert_eq(_px(override_buf, 4, 1, 0, 2), 255)

    var from_group = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "indexed",
                "id": 81,
                "name": "group-mesh",
                "vertices_xyz": [[0, 0, 0], [1, 0, 0], [0, 1, 0]],
                "faces": [[0, 1, 2]],
                "color": "#00ff00"
            }
        ],
        "materials": [
            {"id": 82, "name": "group-green", "base_color": "#00ff00ff"}
        ],
        "model_templates": [
            {"name": "group-template", "mesh": "group-mesh", "material": "group-green", "transform": {"position_xyz": [1, 0, 0], "scale_milli": 1000}}
        ],
        "instance_groups": [
            {
                "transform": {"position_xyz": [1, 1, 0], "scale_milli": 2000},
                "instances": [
                    {"id": 83, "name": "grouped", "template": "group-template"}
                ]
            }
        ],
        "draw": ["grouped"]
    })
    assert_true(oren_is_err(from_group) == false)
    assert_eq(from_group[2]["x"], 3)
    assert_eq(from_group[2]["y"], 1)
    assert_eq(from_group[2]["scale_milli"], 2000)
    var group_buf = ui_raster.rasterize(from_group, 6, 6, {"strict_bounds": true})
    assert_true(oren_is_err(group_buf) == false)
    assert_eq(_px(group_buf, 6, 3, 1, 1), 255)

    var bin = scene_binary(vertices, indices, true)
    assert_true(oren_is_err(bin) == false)
    var from_bin = scene3d.commands_from_binary(bin)
    assert_true(oren_is_err(from_bin) == false)
    assert_eq(oren_list_len(from_bin), 9)
    assert_eq(from_bin[0]["op"], "mesh3d_indexed")
    assert_eq(from_bin[1]["op"], "material3d")
    assert_eq(from_bin[2]["op"], "model3d")
    assert_eq(from_bin[3]["op"], "push_camera_ortho")
    assert_eq(from_bin[4]["op"], "draw_model3d")
    assert_eq(from_bin[5]["op"], "pop_camera")
    assert_true(ui_cmds.validate(from_bin, 4, 4, {"strict_bounds": true}) == 0)
    var bin_buf = ui_raster.rasterize(from_bin, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(bin_buf) == false)
    assert_eq(_px(bin_buf, 4, 1, 1, 0), 0)
    assert_eq(_px(bin_buf, 4, 1, 1, 1), 255)
    assert_eq(_px(bin_buf, 4, 1, 1, 2), 0)
    assert_true(oren_is_err(scene3d.commands_from_binary(bytes.pack([79, 83]))) == true)

    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"bad\"}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"instances\":[{\"id\":1,\"template\":\"missing\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"indexed\",\"id\":1,\"vertices_xyz\":[[0,0,0]],\"faces\":[[0,1,2]],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"indexed\",\"id\":1,\"vertices_xyz\":[[0,0,0]],\"quads\":[[0,1,2,3]],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"indexed\",\"id\":1,\"vertices_xyz\":[[0,0,0]],\"faces\":[[0,0,0]],\"transform\":{\"scale_xyz_milli\":[1000,0,1000]},\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"quads_xyz\":[[[0,0,0],[1,0,0],[1,1,0]]],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"triangles_xyz\":[[[0,0,0],[1,0,0],[0,1,0]]],\"scale_xyz_milli\":[1000,1000],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"boxes_xyz\":[{\"min\":[0,0,0],\"max\":[1,1,1]}],\"scale_xyz_milli\":[1000,-1,1000],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"boxes_xyz\":[{\"min\":[0,0,0],\"max\":[0,1,1]}],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"prisms_xy\":[{\"points\":[[0,0],[1,0]],\"z_min\":0,\"z_max\":1}],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"cylinders_z\":[{\"center\":[0,0],\"radius\":1,\"z_min\":0,\"z_max\":1,\"segments\":2}],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"cones_z\":[{\"center\":[0,0],\"radius\":0,\"z_min\":0,\"z_max\":1}],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"spheres_xyz\":[{\"center\":[0,0,0],\"radius\":1,\"segments\":4,\"rings\":1}],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"ellipsoids_xyz\":[{\"center\":[0,0,0],\"radii\":[1,0,1]}],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"toruses_xyz\":[{\"center\":[0,0,0],\"major_radius\":1,\"minor_radius\":1}],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles\",\"id\":1,\"capsules_z\":[{\"center\":[0,0],\"radius\":1,\"z_min\":0,\"z_max\":1,\"segments\":3}],\"color\":\"#ffffff\"}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"models\":[{\"id\":1,\"mesh_id\":2,\"position_xyz\":[1,2]}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"models\":[{\"id\":1,\"mesh_id\":2,\"transform\":{\"scale_milli\":0}}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"instance_groups\":[{\"transform\":{\"scale_milli\":0},\"instances\":[]}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"instance_groups\":[{\"transform\":{\"position_xyz\":[0,0,0]}}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"meshes\":[{\"kind\":\"triangles_rgba\",\"id\":1,\"triangles_xyz_rgba\":[{\"vertices\":[[0,0,0],[1,0,0],[0,1,0]],\"color\":\"nope\"}]}]}")) == true)
    assert_true(oren_is_err(scene3d.commands_from_json_at("{\"schema\":\"oren.ui.scene3d.v0\",\"animations\":[{\"target\":\"missing\",\"keyframes\":[{\"time_milli\":0,\"position_xyz\":[0,0,0]}]}]}", 0)) == true)
    assert_true(oren_is_err(scene3d.commands_from_json("{\"schema\":\"oren.ui.scene3d.v0\",\"materials\":[{\"id\":1,\"base_color\":\"#ffffff\",\"opacity_milli\":1200}]}")) == true)
    assert_true(oren_is_err(scene3d.commands(nil)) == true)
    exit(0)
}

main()
