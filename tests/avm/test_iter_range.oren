import iter "../../lib/std/iter.oren"

fn fail(code) {
    print("avm iter_range FAIL " + oren_int_to_string(code))
    oren_exit(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

// range(n): 0..(n-1)
var sum0 = 0
for x in iter.range(5) {
    sum0 = sum0 + x
}
assert_eq(sum0, 10, 10)

// range3: negative step
var xs = []
var r = iter.range3(10, 0, 0 - 4)
assert_eq(r["__iter"], "range", 18)
assert_eq(r["start"], 10, 19)
assert_eq(r["end"], 0, 24)
assert_eq(r["step"], 0 - 4, 25)

for x in r {
    oren_list_push(xs, x)
}
var nxs = oren_list_len(xs)
if nxs != 3 {
    fail(20)
}
assert_eq(xs[0], 10, 21)
assert_eq(xs[1], 6, 22)
assert_eq(xs[2], 2, 23)

// step == 0: empty (must not hang)
var count0 = 0
for _ in iter.range3(0, 1000000, 0) {
    count0 = count0 + 1
    if count0 > 0 { fail(30) }
}
assert_eq(count0, 0, 31)

print("avm iter_range OK")
oren_exit(0)
