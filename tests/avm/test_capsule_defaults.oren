fn main() {
    // In capsule mode, AVM must deny effectful domains by default (FS/PROC/ENV),
    // but still allow CORE + EXIT so programs can compute and terminate.

    var w = oren_write_file("build/avm_capsule_should_not_write.txt", "x")
    if !oren_is_err(w) { oren_exit(1) }

    var rc = oren_system("sh -c 'echo hi > build/avm_capsule_should_not_write2.txt'")
    if !oren_is_err(rc) { oren_exit(1) }

    var p = oren_env("PATH")
    if !oren_is_err(p) { oren_exit(1) }

    oren_exit(0)
}

main()

