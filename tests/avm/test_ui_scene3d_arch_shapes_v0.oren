    assert_true(oren_is_err(from_curbs) == false)
    assert_eq(from_curbs[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_curbs[0]["triangles"]), 864)
    assert_eq(_i32_at(from_curbs[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_curbs[0]["triangles"], 4), 2)
    assert_eq(_i32_at(from_curbs[0]["triangles"], 8), 8)
    assert_eq(_i32_at(from_curbs[0]["triangles"], 12), 5)
    assert_eq(_i32_at(from_curbs[0]["triangles"], 16), 2)
    assert_eq(_i32_at(from_curbs[0]["triangles"], 20), 8)
    assert_eq(_i32_at(from_curbs[0]["triangles"], 32), 8)
    assert_true(ui_cmds.validate(from_curbs, 7, 5, {"strict_bounds": true}) == 0)

    var from_posts = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 167,
                "posts_xy": [
                    {"points": [[2, 2], [5, 2]], "width": 2, "z_min": 1, "z_max": 4}
