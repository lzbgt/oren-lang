// AVM headless UI test: std:ui/scene3d generated architectural-shape assets.

import scene3d "std:ui/scene3d"
import ui_cmds "std:ui/commands"
import ui_raster "std:ui/raster"
import bytes "std:bytes"

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_true(x) {
    if x { return 0 }
    fail()
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn _px(buf, w, x, y, chan) {
    return oren_bytes_get_u8(buf, (y * w + x) * 4 + chan)
}

fn _i32_at(buf, off) {
    var u = oren_bytes_get_u8(buf, off + 0) +
        oren_bytes_get_u8(buf, off + 1) * 256 +
        oren_bytes_get_u8(buf, off + 2) * 65536 +
        oren_bytes_get_u8(buf, off + 3) * 16777216
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn main() {
    var from_walls = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 157,
                "walls_xy": [
                    {"points": [[1, 1], [4, 1], [4, 3]], "z_min": 1, "z_max": 3}
                ],
                "transform": {"translation_xyz": [1, 0, 5]},
                "color": "#6688aa"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 157}],
        "destroy": true
    })
    assert_true(oren_is_err(from_walls) == false)
    assert_eq(from_walls[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_walls[0]["triangles"]), 144)
    assert_eq(_i32_at(from_walls[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_walls[0]["triangles"], 4), 1)
    assert_eq(_i32_at(from_walls[0]["triangles"], 8), 6)
    assert_eq(_i32_at(from_walls[0]["triangles"], 12), 5)
    assert_eq(_i32_at(from_walls[0]["triangles"], 16), 1)
    assert_eq(_i32_at(from_walls[0]["triangles"], 20), 6)
    assert_eq(_i32_at(from_walls[0]["triangles"], 32), 8)
    assert_true(ui_cmds.validate(from_walls, 7, 5, {"strict_bounds": true}) == 0)

    var from_rooms = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 158,
                "rooms_xy": [
                    {"points": [[1, 1], [4, 1], [4, 3], [1, 3]], "z_min": 1, "z_max": 3}
                ],
                "transform": {"translation_xyz": [1, 0, 5]},
                "color": "#446688"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 158}],
        "destroy": true
    })
    assert_true(oren_is_err(from_rooms) == false)
    assert_eq(from_rooms[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_rooms[0]["triangles"]), 432)
    assert_eq(_i32_at(from_rooms[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_rooms[0]["triangles"], 4), 1)
    assert_eq(_i32_at(from_rooms[0]["triangles"], 8), 6)
    assert_eq(_i32_at(from_rooms[0]["triangles"], 12), 5)
    assert_eq(_i32_at(from_rooms[0]["triangles"], 16), 3)
    assert_eq(_i32_at(from_rooms[0]["triangles"], 20), 6)
    assert_eq(_i32_at(from_rooms[0]["triangles"], 32), 6)
    assert_true(ui_cmds.validate(from_rooms, 7, 5, {"strict_bounds": true}) == 0)

    var from_ramps = scene3d.commands_from_asset({
