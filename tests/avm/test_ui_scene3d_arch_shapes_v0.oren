    assert_true(oren_is_err(from_stairs) == false)
    assert_eq(from_stairs[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_stairs[0]["triangles"]), 288)
    assert_eq(_i32_at(from_stairs[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_stairs[0]["triangles"], 4), 2)
    assert_eq(_i32_at(from_stairs[0]["triangles"], 8), 6)
    assert_eq(_i32_at(from_stairs[0]["triangles"], 12), 2)
    assert_eq(_i32_at(from_stairs[0]["triangles"], 16), 0)
    assert_eq(_i32_at(from_stairs[0]["triangles"], 20), 6)
    assert_eq(_i32_at(from_stairs[0]["triangles"], 32), 7)
    assert_true(ui_cmds.validate(from_stairs, 8, 5, {"strict_bounds": true}) == 0)

    var from_gable_roofs = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 162,
                "gable_roofs_xy": [
                    {"from": [1, 1], "to": [5, 1], "width": 2, "z_eave": 1, "z_ridge": 4}
                ],
                "transform": {"translation_xyz": [1, 0, 5]},
                "color": "#ccaa44"
            }
