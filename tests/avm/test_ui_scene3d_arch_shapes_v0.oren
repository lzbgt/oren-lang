    assert_true(oren_is_err(from_gable_roofs) == false)
    assert_eq(from_gable_roofs[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_gable_roofs[0]["triangles"]), 216)
    assert_eq(_i32_at(from_gable_roofs[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_gable_roofs[0]["triangles"], 4), 2)
    assert_eq(_i32_at(from_gable_roofs[0]["triangles"], 8), 6)
    assert_eq(_i32_at(from_gable_roofs[0]["triangles"], 12), 6)
    assert_eq(_i32_at(from_gable_roofs[0]["triangles"], 16), 2)
    assert_eq(_i32_at(from_gable_roofs[0]["triangles"], 20), 6)
