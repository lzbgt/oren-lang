    assert_true(ui_cmds.validate(from_gable_roofs, 8, 5, {"strict_bounds": true}) == 0)

    var from_pyramids = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 161,
                "pyramids_xy": [
                    {"points": [[1, 1], [4, 1], [4, 3], [1, 3]], "z_base": 1, "apex": [2, 2, 4]}
                ],
