    assert_true(oren_is_err(from_posts) == false)
    assert_eq(from_posts[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_posts[0]["triangles"]), 864)
    assert_eq(_i32_at(from_posts[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_posts[0]["triangles"], 4), 1)
    assert_eq(_i32_at(from_posts[0]["triangles"], 8), 3)
    assert_eq(_i32_at(from_posts[0]["triangles"], 12), 4)
    assert_eq(_i32_at(from_posts[0]["triangles"], 16), 1)
    assert_eq(_i32_at(from_posts[0]["triangles"], 20), 3)
    assert_eq(_i32_at(from_posts[0]["triangles"], 432), 5)
    assert_true(ui_cmds.validate(from_posts, 8, 5, {"strict_bounds": true}) == 0)

    var from_fences = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 165,
                "fences_xy": [
                    {"points": [[2, 2], [4, 2]], "post_width": 2, "rail_width": 2, "z_min": 0, "z_max": 3, "rail_z_min": 1, "rail_z_max": 2}
                ],
                "transform": {"translation_xyz": [1, 0, 0]},
                "color": "#335577"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 165}],
        "destroy": true
    })
    assert_true(oren_is_err(from_fences) == false)
    assert_eq(from_fences[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_fences[0]["triangles"]), 1296)
    assert_eq(_i32_at(from_fences[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_fences[0]["triangles"], 4), 1)
    assert_eq(_i32_at(from_fences[0]["triangles"], 8), 0)
    assert_eq(_i32_at(from_fences[0]["triangles"], 432), 4)
    assert_true(ui_cmds.validate(from_fences, 7, 5, {"strict_bounds": true}) == 0)
    var fence_buf = ui_raster.rasterize(from_fences, 7, 5, {"strict_bounds": true})
    assert_true(oren_is_err(fence_buf) == false)
    assert_eq(_px(fence_buf, 7, 3, 2, 0), 51)
    assert_eq(_px(fence_buf, 7, 3, 2, 1), 85)

    var from_multi_rail_fences = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 166,
                "fences_xy": [
                    {
                        "points": [[2, 2], [4, 2]],
                        "post_width": 2,
                        "z_min": 0,
                        "z_max": 4,
                        "rails": [
                            {"width": 2, "z_min": 1, "z_max": 2},
                            {"width": 2, "z_min": 3, "z_max": 4}
                        ]
                    }
                ],
                "transform": {"translation_xyz": [1, 0, 0]},
                "color": "#553377"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 166}],
        "destroy": true
    })
    assert_true(oren_is_err(from_multi_rail_fences) == false)
    assert_eq(from_multi_rail_fences[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_multi_rail_fences[0]["triangles"]), 1728)
    assert_eq(_i32_at(from_multi_rail_fences[0]["triangles"], 864), 3)
    assert_eq(_i32_at(from_multi_rail_fences[0]["triangles"], 868), 3)
    assert_eq(_i32_at(from_multi_rail_fences[0]["triangles"], 872), 2)
    assert_eq(_i32_at(from_multi_rail_fences[0]["triangles"], 1296), 3)
    assert_eq(_i32_at(from_multi_rail_fences[0]["triangles"], 1304), 4)
    assert_true(ui_cmds.validate(from_multi_rail_fences, 7, 5, {"strict_bounds": true}) == 0)

    var from_stairs = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 160,
                "stairs_xy": [
                    {"from": [1, 1], "to": [5, 1], "width": 2, "z_from": 1, "z_to": 3, "steps": 2}
                ],
                "transform": {"translation_xyz": [1, 0, 5]},
