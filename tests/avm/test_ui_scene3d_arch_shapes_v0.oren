                "transform": {"translation_xyz": [1, 0, 5]},
                "color": "#88aa44"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 159}],
        "destroy": true
    })
    assert_true(oren_is_err(from_ramps) == false)
    assert_eq(from_ramps[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_ramps[0]["triangles"]), 72)
    assert_eq(_i32_at(from_ramps[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_ramps[0]["triangles"], 4), 2)
    assert_eq(_i32_at(from_ramps[0]["triangles"], 8), 6)
    assert_eq(_i32_at(from_ramps[0]["triangles"], 12), 5)
    assert_eq(_i32_at(from_ramps[0]["triangles"], 16), 2)
    assert_eq(_i32_at(from_ramps[0]["triangles"], 20), 8)
    assert_true(ui_cmds.validate(from_ramps, 7, 5, {"strict_bounds": true}) == 0)

    var from_solid_ramps = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 163,
                "solid_ramps_xy": [
                    {"from": [1, 1], "to": [4, 1], "width": 2, "z_base": 0, "z_from": 1, "z_to": 3}
                ],
                "transform": {"translation_xyz": [1, 0, 5]},
                "color": "#779944"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 163}],
        "destroy": true
