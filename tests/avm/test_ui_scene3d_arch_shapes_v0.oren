    assert_true(oren_is_err(from_solid_ramps) == false)
    assert_eq(from_solid_ramps[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_solid_ramps[0]["triangles"]), 432)
    assert_eq(_i32_at(from_solid_ramps[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_solid_ramps[0]["triangles"], 4), 2)
    assert_eq(_i32_at(from_solid_ramps[0]["triangles"], 8), 6)
    assert_eq(_i32_at(from_solid_ramps[0]["triangles"], 12), 5)
    assert_eq(_i32_at(from_solid_ramps[0]["triangles"], 16), 2)
    assert_eq(_i32_at(from_solid_ramps[0]["triangles"], 20), 8)
    assert_eq(_i32_at(from_solid_ramps[0]["triangles"], 80), 5)
    assert_true(ui_cmds.validate(from_solid_ramps, 7, 5, {"strict_bounds": true}) == 0)

    var from_curbs = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 164,
                "curbs_xy": [
                    {"points": [[1, 1], [4, 1], [4, 3]], "width": 2, "z_min": 1, "z_max": 3}
