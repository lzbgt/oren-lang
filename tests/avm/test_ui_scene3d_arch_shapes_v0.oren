    assert_eq(from_pyramids[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_pyramids[0]["triangles"]), 216)
    assert_eq(_i32_at(from_pyramids[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_pyramids[0]["triangles"], 4), 1)
    assert_eq(_i32_at(from_pyramids[0]["triangles"], 8), 6)
    assert_eq(_i32_at(from_pyramids[0]["triangles"], 12), 5)
    assert_eq(_i32_at(from_pyramids[0]["triangles"], 16), 3)
    assert_eq(_i32_at(from_pyramids[0]["triangles"], 20), 6)
    assert_eq(_i32_at(from_pyramids[0]["triangles"], 96), 3)
    assert_eq(_i32_at(from_pyramids[0]["triangles"], 100), 2)
    assert_eq(_i32_at(from_pyramids[0]["triangles"], 104), 9)
    assert_true(ui_cmds.validate(from_pyramids, 7, 5, {"strict_bounds": true}) == 0)

    print("ui scene3d arch shapes ok")
}
