// AVM headless UI test: std:ui/avm GFX mailbox v0

import ui_avm "std:ui/avm"
import bytes "std:bytes"

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn assert_bytes_eq(bs, xs) {
    assert_eq(bytes.try_len(bs), oren_list_len(xs))
    var i = 0
    while i < oren_list_len(xs) {
        assert_eq(bytes.try_get_u8(bs, i), xs[i])
        i = i + 1
    }
}

fn main() {
    var cmds = [
        {"op": "fill_rect", "x": 0, "y": 0, "w": 4, "h": 2, "color": "#102030"},
        {"op": "stroke_rect", "x": 0, "y": 0, "w": 4, "h": 3, "width": 1, "color": "#ffff00"},
        {"op": "stroke_line", "x1": 0, "y1": 0, "x2": 3, "y2": 2, "width": 1, "color": "#ff0000"},
        {"op": "circle", "cx": 2, "cy": 1, "r": 1, "fill": true, "color": "#00ff00"},
        {"op": "fill_triangle", "x1": 0, "y1": 2, "x2": 1, "y2": 1, "x3": 3, "y3": 2, "color": "#0000ff"}
    ]
    var opts = {
        "strict_bounds": true,
        "scale_milli": 3000,
        "sequence": 7,
        "drawable_w": 12,
        "drawable_h": 9,
        "target_hz_milli": 120000
    }
    var frame = ui_avm.frame_bytes(cmds, 4, 3, opts)
    assert_bytes_eq(frame, [
        79, 71, 70, 48, 1, 0, 40, 0,
        4, 0, 0, 0, 3, 0, 0, 0, 184, 11, 0, 0, 5, 0, 0, 0,
        7, 0, 0, 0, 12, 0, 0, 0, 9, 0, 0, 0, 192, 212, 1, 0,
        1, 0, 20, 0,
        0, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0, 0, 2, 0, 0, 0,
        16, 32, 48, 255,
        6, 0, 24, 0,
        0, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0, 0, 3, 0, 0, 0,
        1, 0, 0, 0, 255, 255, 0, 255,
        3, 0, 24, 0,
        0, 0, 0, 0, 0, 0, 0, 0, 3, 0, 0, 0, 2, 0, 0, 0,
        1, 0, 0, 0, 255, 0, 0, 255,
        4, 0, 20, 0,
        2, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0,
        0, 255, 0, 255,
        5, 0, 28, 0,
        0, 0, 0, 0, 2, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0,
        3, 0, 0, 0, 2, 0, 0, 0, 0, 0, 255, 255
    ])
    assert_eq(ui_avm.pull_event_bytes(), nil)
    assert_eq(ui_avm.present_frame(cmds, 4, 3, opts), 0)

    var clip_frame = ui_avm.frame_bytes([
        {"op": "push_clip_rect", "x": 1, "y": 0, "w": 2, "h": 2},
        {"op": "fill_rect", "x": 0, "y": 0, "w": 4, "h": 2, "color": "#abcdef"},
        {"op": "pop_clip"}
