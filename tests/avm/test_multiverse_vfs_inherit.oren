fn store_u8(out, pos, v) {
    var rc = oren_buf_store_u8(out, pos, v)
    if oren_is_err(rc) {
        return rc
    }
    return pos + 1
}

fn store_u32_le(out, pos, v) {
    pos = store_u8(out, pos, v & 255)
    if oren_is_err(pos) { return pos }
    pos = store_u8(out, pos, (v >> 8) & 255)
    if oren_is_err(pos) { return pos }
    pos = store_u8(out, pos, (v >> 16) & 255)
    if oren_is_err(pos) { return pos }
    return store_u8(out, pos, (v >> 24) & 255)
}

fn copy_bytes(out, pos, xs) {
    var n = oren_bytes_len(xs)
    var i = 0
    while i < n {
        pos = store_u8(out, pos, oren_bytes_get_u8(xs, i))
        if oren_is_err(pos) { return pos }
        i = i + 1
    }
    return pos
}

fn build_vfs_fixtures_one_file(path, body_bytes) {
    // AVMVFS01 format:
    //   magic[8]="AVMVFS01"
    //   u32 count
    //   repeated:
    //     u32 path_len, path bytes
    //     u32 body_len, body bytes
    var path_bytes = oren_bytes_from_string(path)
    if oren_is_err(path_bytes) {
        return path_bytes
    }
    var path_len = oren_bytes_len(path_bytes)
    if oren_is_err(path_len) {
        return path_len
    }
    var body_len = oren_bytes_len(body_bytes)
    if oren_is_err(body_len) {
        return body_len
    }
    var total = 8 + 4 + 4 + path_len + 4 + body_len
    var out = oren_u8_buf_new_uninit(total)
    if oren_is_err(out) {
        return out
    }

    // "AVMVFS01"
    var pos = 0
    pos = store_u8(out, pos, 65) // A
    if oren_is_err(pos) { return pos }
    pos = store_u8(out, pos, 86) // V
    if oren_is_err(pos) { return pos }
    pos = store_u8(out, pos, 77) // M
    if oren_is_err(pos) { return pos }
    pos = store_u8(out, pos, 86) // V
    if oren_is_err(pos) { return pos }
    pos = store_u8(out, pos, 70) // F
    if oren_is_err(pos) { return pos }
    pos = store_u8(out, pos, 83) // S
    if oren_is_err(pos) { return pos }
    pos = store_u8(out, pos, 48) // 0
    if oren_is_err(pos) { return pos }
    pos = store_u8(out, pos, 49) // 1
    if oren_is_err(pos) { return pos }

    pos = store_u32_le(out, pos, 1)
    if oren_is_err(pos) { return pos }

    pos = store_u32_le(out, pos, path_len)
    if oren_is_err(pos) { return pos }
    pos = copy_bytes(out, pos, path_bytes)
    if oren_is_err(pos) { return pos }

    pos = store_u32_le(out, pos, body_len)
    if oren_is_err(pos) { return pos }
    pos = copy_bytes(out, pos, body_bytes)
    if oren_is_err(pos) { return pos }

    return out
}

fn main() {
    // This test validates two P0 safety properties:
    // 1) VirtualFS layering: a grandchild universe inherits the parent's VirtualFS state.
    // 2) FS allow-prefix enrollment is hierarchical: nested universes inherit parent FS restrictions.

    // Load fixture obcs from host FS (allowed by runner prefix "build/").
    var child1_obc = oren_read_u8_buf("build/multiverse_child_vfs_inherit.obc")
    if oren_is_err(child1_obc) {
        print("FAIL: read child vfs inherit obc")
        print(oren_err_code(child1_obc))
        print(oren_err_msg(child1_obc))
        oren_exit(1)
    }

    var gc_obc = oren_read_u8_buf("build/multiverse_grandchild_read_x.obc")
    if oren_is_err(gc_obc) {
        print("FAIL: read grandchild obc")
        print(oren_err_code(gc_obc))
        print(oren_err_msg(gc_obc))
        oren_exit(1)
    }
    // Inject grandchild obc into the child universe's VirtualFS under path "g.obc".
    var vfs_fx = build_vfs_fixtures_one_file("g.obc", gc_obc)
    if oren_is_err(vfs_fx) {
        print("FAIL: vfs fixture build error")
        print(oren_err_code(vfs_fx))
        print(oren_err_msg(vfs_fx))
        oren_exit(1)
    }

    // Allow CORE + FS + EXIT + AVM (nested universe).
    var allowed_child = (1 << 0) + (1 << 1) + (1 << 6) + (1 << 8)

    var cfg1 = {
        "deterministic": true,
        "gas_limit": 1000000,
        "allowed_domains": allowed_child,
        "fs_backend": 1,
        "vfs_fixtures": vfs_fx
    }

    var r1 = oren_avm_run_obc_bytes(child1_obc, cfg1)
    if oren_is_err(r1) {
        print("FAIL: child vfs_inherit run error")
        print(oren_err_code(r1))
        print(oren_err_msg(r1))
        oren_exit(1)
    }

    // Now validate FS allow-prefix inheritance: child runs with host FS backend and must not
    // widen access beyond the parent's --fs-allow-prefixes setting (runner uses build/).
    var child2_obc = oren_read_u8_buf("build/multiverse_child_host_fs_prefix_probe.obc")
    if oren_is_err(child2_obc) {
        print("FAIL: read child host fs prefix probe obc")
        print(oren_err_code(child2_obc))
        print(oren_err_msg(child2_obc))
        oren_exit(1)
    }
    var cfg2 = {
        "deterministic": true,
        "gas_limit": 1000000,
        "allowed_domains": (1 << 0) + (1 << 1) + (1 << 6),
        "fs_backend": 0
    }
    var r2 = oren_avm_run_obc_bytes(child2_obc, cfg2)
    if oren_is_err(r2) {
        print("FAIL: child fs_prefix run error")
        print(oren_err_code(r2))
        print(oren_err_msg(r2))
        oren_exit(1)
    }

    oren_set_result({
        "vfs_inherit_exit": r1["exit_code"],
        "fs_prefix_exit": r2["exit_code"],
        "log1_len": oren_bytes_len(r1["record_log"]),
        "log2_len": oren_bytes_len(r2["record_log"])
    })

    if r1["exit_code"] != 0 {
        print("FAIL: child vfs_inherit exit_code")
        print(r1["exit_code"])
        var e1 = r1["last_error"]
        if oren_is_err(e1) {
            print("child vfs_inherit err_code")
            print(oren_err_code(e1))
            print("child vfs_inherit err_msg")
            print(oren_err_msg(e1))
        } else {
            print("child vfs_inherit last_error=nil")
        }
        oren_exit(1)
    }
    if r2["exit_code"] != 0 {
        print("FAIL: child fs_prefix exit_code")
        print(r2["exit_code"])
        var e2 = r2["last_error"]
        if oren_is_err(e2) {
            print("child fs_prefix err_code")
            print(oren_err_code(e2))
            print("child fs_prefix err_msg")
            print(oren_err_msg(e2))
        } else {
            print("child fs_prefix last_error=nil")
        }
        oren_exit(2)
    }
    oren_exit(0)
}

main()
