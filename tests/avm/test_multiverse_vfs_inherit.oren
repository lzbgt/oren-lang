fn push_u32_le(out, v) {
    var b0 = v & 255
    var b1 = (v >> 8) & 255
    var b2 = (v >> 16) & 255
    var b3 = (v >> 24) & 255
    oren_list_push(out, b0)
    oren_list_push(out, b1)
    oren_list_push(out, b2)
    oren_list_push(out, b3)
}

fn append_bytes(out, xs) {
    var n = oren_bytes_len(xs)
    var i = 0
    while i < n {
        oren_list_push(out, oren_bytes_get_u8(xs, i))
        i = i + 1
    }
}

fn build_vfs_fixtures_one_file(path, body_bytes) {
    // AVMVFS01 format:
    //   magic[8]="AVMVFS01"
    //   u32 count
    //   repeated:
    //     u32 path_len, path bytes
    //     u32 body_len, body bytes
    var out = []

    // "AVMVFS01"
    oren_list_push(out, 65) // A
    oren_list_push(out, 86) // V
    oren_list_push(out, 77) // M
    oren_list_push(out, 86) // V
    oren_list_push(out, 70) // F
    oren_list_push(out, 83) // S
    oren_list_push(out, 48) // 0
    oren_list_push(out, 49) // 1

    push_u32_le(out, 1)

    var path_bytes = oren_bytes_from_string(path)
    push_u32_le(out, oren_bytes_len(path_bytes))
    append_bytes(out, path_bytes)

    push_u32_le(out, oren_bytes_len(body_bytes))
    append_bytes(out, body_bytes)

    return oren_bytes_pack(out)
}

fn main() {
    // This test validates two P0 safety properties:
    // 1) VirtualFS layering: a grandchild universe inherits the parent's VirtualFS state.
    // 2) FS allow-prefix enrollment is hierarchical: nested universes inherit parent FS restrictions.

    // Load fixture obcs from host FS (allowed by runner prefix "build/").
    var child1_obc = oren_read_u8_buf("build/multiverse_child_vfs_inherit.obc")

    var gc_obc = oren_read_u8_buf("build/multiverse_grandchild_read_x.obc")
    // Inject grandchild obc into the child universe's VirtualFS under path "g.obc".
    var vfs_fx = build_vfs_fixtures_one_file("g.obc", gc_obc)

    // Allow CORE + FS + EXIT + AVM (nested universe).
    var allowed_child = (1 << 0) + (1 << 1) + (1 << 6) + (1 << 8)

    var cfg1 = {
        "deterministic": true,
        "gas_limit": 1000000,
        "allowed_domains": allowed_child,
        "fs_backend": 1,
        "vfs_fixtures": vfs_fx
    }

    var r1 = oren_avm_run_obc_bytes(child1_obc, cfg1)

    // Now validate FS allow-prefix inheritance: child runs with host FS backend and must not
    // widen access beyond the parent's --fs-allow-prefixes setting (runner uses build/).
    var child2_obc = oren_read_u8_buf("build/multiverse_child_host_fs_prefix_probe.obc")
    var cfg2 = {
        "deterministic": true,
        "gas_limit": 1000000,
        "allowed_domains": (1 << 0) + (1 << 1) + (1 << 6),
        "fs_backend": 0
    }
    var r2 = oren_avm_run_obc_bytes(child2_obc, cfg2)

    oren_set_result({
        "vfs_inherit_exit": r1["exit_code"],
        "fs_prefix_exit": r2["exit_code"],
        "log1_len": oren_bytes_len(r1["record_log"]),
        "log2_len": oren_bytes_len(r2["record_log"])
    })

    if r1["exit_code"] != 0 {
        print("FAIL: child vfs_inherit exit_code")
        print(r1["exit_code"])
        var e1 = r1["last_error"]
        if oren_is_err(e1) {
            print("child vfs_inherit err_code")
            print(oren_err_code(e1))
            print("child vfs_inherit err_msg")
            print(oren_err_msg(e1))
        } else {
            print("child vfs_inherit last_error=nil")
        }
        oren_exit(1)
    }
    if r2["exit_code"] != 0 {
        print("FAIL: child fs_prefix exit_code")
        print(r2["exit_code"])
        var e2 = r2["last_error"]
        if oren_is_err(e2) {
            print("child fs_prefix err_code")
            print(oren_err_code(e2))
            print("child fs_prefix err_msg")
            print(oren_err_msg(e2))
        } else {
            print("child fs_prefix last_error=nil")
        }
        oren_exit(2)
    }
    oren_exit(0)
}

main()
