fn fail(msg) {
    print("FAIL")
    print(msg)
    oren_exit(1)
}

fn main() {
    var path = "build/avm_test_read_bytes.bin"
    var bytes = [0, 1, 0, 2, 255, 128, 64, 0, 10]
    oren_write_bytes(path, bytes)

    var out = oren_read_bytes(path)
    if oren_list_len(out) != 9 { fail("length mismatch") }
    if out[0] != 0 { fail("mismatch at 0") }
    if out[1] != 1 { fail("mismatch at 1") }
    if out[2] != 0 { fail("mismatch at 2") }
    if out[3] != 2 { fail("mismatch at 3") }
    if out[4] != 255 { fail("mismatch at 4") }
    if out[5] != 128 { fail("mismatch at 5") }
    if out[6] != 64 { fail("mismatch at 6") }
    if out[7] != 0 { fail("mismatch at 7") }
    if out[8] != 10 { fail("mismatch at 8") }

    var large_path = "build/avm_test_read_bytes_large.bin"
    var large = []
    var i = 0
    while i < 70000 {
        oren_list_push(large, (i * 37) & 255)
        i = i + 1
    }
    oren_write_bytes(large_path, large)
    var large_out = oren_read_bytes(large_path)
    if oren_list_len(large_out) != 70000 { fail("large length mismatch") }
    if large_out[0] != 0 { fail("large mismatch at 0") }
    if large_out[65535] != ((65535 * 37) & 255) { fail("large mismatch at 65535") }
    if large_out[69999] != ((69999 * 37) & 255) { fail("large mismatch at 69999") }

    var copy_path = "build/avm_test_read_bytes_copy.bin"
    oren_write_bytes(copy_path, large_out)
    var copy = oren_read_u8_buf(copy_path)
    if oren_bytes_len(copy) != 70000 { fail("copy length mismatch") }
    if oren_bytes_get_u8(copy, 0) != 0 { fail("copy mismatch at 0") }
    if oren_bytes_get_u8(copy, 65535) != ((65535 * 37) & 255) { fail("copy mismatch at 65535") }
    if oren_bytes_get_u8(copy, 69999) != ((69999 * 37) & 255) { fail("copy mismatch at 69999") }

    print("avm read_bytes OK")
}
