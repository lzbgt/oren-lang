// AVM headless UI test: std:ui/scene3d asset transform lowering.

import scene3d "std:ui/scene3d"
import ui_cmds "std:ui/commands"
import ui_raster "std:ui/raster"
import bytes "std:bytes"

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_true(x) {
    if x { return 0 }
    fail()
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn _px(buf, w, x, y, chan) {
    return oren_bytes_get_u8(buf, (y * w + x) * 4 + chan)
}

fn _i32_at(buf, off) {
    var u = oren_bytes_get_u8(buf, off + 0) +
        oren_bytes_get_u8(buf, off + 1) * 256 +
        oren_bytes_get_u8(buf, off + 2) * 65536 +
        oren_bytes_get_u8(buf, off + 3) * 16777216
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn main() {
    var from_scaled_coords = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 137,
                "triangles_xyz": [
                    [[1, 1, 0], [2, 1, 0], [1, 2, 0]]
                ],
                "transform": {"scale_xyz_milli": [2000, 1000, 1000]},
                "color": "#22aa00"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 137}],
        "destroy": true
    })
    assert_true(oren_is_err(from_scaled_coords) == false)
    assert_true(ui_cmds.validate(from_scaled_coords, 5, 4, {"strict_bounds": true}) == 0)
    var scaled_coord_buf = ui_raster.rasterize(from_scaled_coords, 5, 4, {"strict_bounds": true})
    assert_true(oren_is_err(scaled_coord_buf) == false)
    assert_eq(_px(scaled_coord_buf, 5, 2, 1, 0), 34)
    assert_eq(_px(scaled_coord_buf, 5, 2, 1, 1), 170)

    var from_rotated_coords = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 138,
                "triangles_xyz": [
                    [[1, 0, 3], [2, 0, 3], [1, 1, 3]]
                ],
                "transform": {"scale_xyz_milli": [2000, 1000, 1000], "rotation_z_milli_deg": 90000},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_rotated_coords) == false)
    assert_eq(oren_bytes_get_u8(from_rotated_coords[0]["triangles"], 0), 0)
    assert_eq(oren_bytes_get_u8(from_rotated_coords[0]["triangles"], 4), 2)
    assert_eq(oren_bytes_get_u8(from_rotated_coords[0]["triangles"], 8), 3)

    var from_xyz_rotated_coords = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 238,
                "triangles_xyz": [
                    [[1, 0, 0], [2, 0, 0], [1, 1, 0]]
                ],
                "transform": {"scale_xyz_milli": [2000, 1000, 1000], "rotation_xyz_milli_deg": [0, 90000, 0]},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_xyz_rotated_coords) == false)
    assert_eq(_i32_at(from_xyz_rotated_coords[0]["triangles"], 0), 0)
    assert_eq(_i32_at(from_xyz_rotated_coords[0]["triangles"], 4), 0)
    assert_eq(_i32_at(from_xyz_rotated_coords[0]["triangles"], 8), -2)

    var from_pivot_rotated_coords = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 338,
                "triangles_xyz": [
                    [[2, 1, 0], [3, 1, 0], [2, 2, 0]]
                ],
                "transform": {"pivot_xyz": [1, 1, 0], "rotation_z_milli_deg": 90000},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_pivot_rotated_coords) == false)
    assert_eq(_i32_at(from_pivot_rotated_coords[0]["triangles"], 0), 1)
    assert_eq(_i32_at(from_pivot_rotated_coords[0]["triangles"], 4), 2)
    assert_eq(_i32_at(from_pivot_rotated_coords[0]["triangles"], 8), 0)

    var from_translated_coords = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 438,
                "triangles_xyz": [
                    [[1, 0, 3], [2, 0, 3], [1, 1, 3]]
                ],
                "transform": {"translation_xyz": [5, -2, 7]},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_translated_coords) == false)
    assert_eq(_i32_at(from_translated_coords[0]["triangles"], 0), 6)
    assert_eq(_i32_at(from_translated_coords[0]["triangles"], 4), -2)
    assert_eq(_i32_at(from_translated_coords[0]["triangles"], 8), 10)

    var from_indexed_xy = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "indexed",
                "id": 340,
                "vertices_xy": [[0, 0], [2, 0], [2, 2], [0, 2]],
                "quads": [[0, 1, 2, 3]],
                "transform": {"translation_xyz": [1, 0, 5]},
                "color": "#00ffff"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 340}],
        "destroy": true
    })
    assert_true(oren_is_err(from_indexed_xy) == false)
    assert_eq(from_indexed_xy[0]["op"], "mesh3d_indexed")
    assert_eq(bytes.len(from_indexed_xy[0]["vertices"]), 48)
    assert_eq(_i32_at(from_indexed_xy[0]["vertices"], 0), 1)
    assert_eq(_i32_at(from_indexed_xy[0]["vertices"], 4), 0)
    assert_eq(_i32_at(from_indexed_xy[0]["vertices"], 8), 5)
    assert_true(ui_cmds.validate(from_indexed_xy, 4, 4, {"strict_bounds": true}) == 0)
    var indexed_xy_buf = ui_raster.rasterize(from_indexed_xy, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(indexed_xy_buf) == false)
    assert_eq(_px(indexed_xy_buf, 4, 2, 1, 1), 255)
    assert_eq(_px(indexed_xy_buf, 4, 2, 1, 2), 255)

    var from_scaled_indexed_xy = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "indexed",
                "id": 341,
                "vertices_xy": [[1, 2]],
                "faces": [[0, 0, 0]],
                "transform": {"scale_xyz_milli": [2000, 500, 2000], "translation_xyz": [0, 0, 3]},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_scaled_indexed_xy) == false)
    assert_eq(_i32_at(from_scaled_indexed_xy[0]["vertices"], 0), 2)
    assert_eq(_i32_at(from_scaled_indexed_xy[0]["vertices"], 4), 1)
    assert_eq(_i32_at(from_scaled_indexed_xy[0]["vertices"], 8), 3)

    var from_scaled_indexed = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "indexed",
                "id": 139,
                "vertices_xyz": [[1, 2, 3]],
                "faces": [[0, 0, 0]],
                "transform": {"scale_xyz_milli": [2000, 500, 2000]},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_scaled_indexed) == false)
    assert_eq(oren_bytes_get_u8(from_scaled_indexed[0]["vertices"], 0), 2)
    assert_eq(oren_bytes_get_u8(from_scaled_indexed[0]["vertices"], 4), 1)
    assert_eq(oren_bytes_get_u8(from_scaled_indexed[0]["vertices"], 8), 6)

    var from_rotated_indexed = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "indexed",
                "id": 239,
                "vertices_xyz": [[1, 0, 3]],
                "faces": [[0, 0, 0]],
                "transform": {"scale_xyz_milli": [2000, 1000, 1000], "rotation_z_milli_deg": 90000},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_rotated_indexed) == false)
    assert_eq(oren_bytes_get_u8(from_rotated_indexed[0]["vertices"], 0), 0)
    assert_eq(oren_bytes_get_u8(from_rotated_indexed[0]["vertices"], 4), 2)
    assert_eq(oren_bytes_get_u8(from_rotated_indexed[0]["vertices"], 8), 3)

    var from_scaled_box = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 140,
                "boxes_xyz": [
                    {"min": [1, 2, 3], "max": [2, 3, 4]}
                ],
                "transform": {"scale_xyz_milli": [2000, 500, 2000]},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_scaled_box) == false)
    assert_eq(oren_bytes_get_u8(from_scaled_box[0]["triangles"], 0), 2)
    assert_eq(oren_bytes_get_u8(from_scaled_box[0]["triangles"], 4), 1)
    assert_eq(oren_bytes_get_u8(from_scaled_box[0]["triangles"], 8), 6)

    var from_rotated_box = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 240,
                "boxes_xyz": [
                    {"min": [1, 0, 3], "max": [2, 1, 4]}
                ],
                "transform": {"scale_xyz_milli": [2000, 1000, 1000], "rotation_z_milli_deg": 90000},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_rotated_box) == false)
    assert_eq(oren_bytes_get_u8(from_rotated_box[0]["triangles"], 0), 0)
    assert_eq(oren_bytes_get_u8(from_rotated_box[0]["triangles"], 4), 2)
    assert_eq(oren_bytes_get_u8(from_rotated_box[0]["triangles"], 8), 3)

    var from_xyz_rotated_box = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 241,
                "boxes_xyz": [
                    {"min": [1, 0, 3], "max": [2, 1, 4]}
                ],
                "transform": {"rotation_xyz_milli_deg": [90000, 0, 0]},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_xyz_rotated_box) == false)
    assert_eq(_i32_at(from_xyz_rotated_box[0]["triangles"], 0), 1)
    assert_eq(_i32_at(from_xyz_rotated_box[0]["triangles"], 4), -3)
    assert_eq(_i32_at(from_xyz_rotated_box[0]["triangles"], 8), 0)

    var from_pivot_rotated_box = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 341,
                "boxes_xyz": [
                    {"min": [1, 1, 0], "max": [3, 3, 1]}
                ],
                "transform": {"pivot_xyz": [2, 2, 0], "rotation_z_milli_deg": 90000},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_pivot_rotated_box) == false)
    assert_eq(_i32_at(from_pivot_rotated_box[0]["triangles"], 0), 3)
    assert_eq(_i32_at(from_pivot_rotated_box[0]["triangles"], 4), 1)
    assert_eq(_i32_at(from_pivot_rotated_box[0]["triangles"], 8), 0)

    var from_translated_box = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 441,
                "boxes_xyz": [
                    {"min": [1, 1, 0], "max": [3, 3, 1]}
                ],
                "transform": {"pivot_xyz": [2, 2, 0], "rotation_z_milli_deg": 90000, "translation_xyz": [10, 0, 5]},
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_translated_box) == false)
    assert_eq(_i32_at(from_translated_box[0]["triangles"], 0), 13)
    assert_eq(_i32_at(from_translated_box[0]["triangles"], 4), 1)
    assert_eq(_i32_at(from_translated_box[0]["triangles"], 8), 5)

    exit(0)
}

main()
