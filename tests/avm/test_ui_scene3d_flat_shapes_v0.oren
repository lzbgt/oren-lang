    var from_rounded_rects = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 151,
                "rounded_rects_xy": [
                    {"min": [1, 1], "max": [5, 5], "radius": 1, "corner_segments": 1, "z": 1}
                ],
                "transform": {"translation_xyz": [1, 0, 5]},
                "color": "#88cc44"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 151}],
        "destroy": true
    })
    assert_true(oren_is_err(from_rounded_rects) == false)
    assert_eq(from_rounded_rects[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_rounded_rects[0]["triangles"]), 288)
    assert_eq(_i32_at(from_rounded_rects[0]["triangles"], 0), 4)
    assert_eq(_i32_at(from_rounded_rects[0]["triangles"], 4), 3)
    assert_eq(_i32_at(from_rounded_rects[0]["triangles"], 8), 6)
    assert_true(ui_cmds.validate(from_rounded_rects, 7, 7, {"strict_bounds": true}) == 0)
    var rounded_rect_buf = ui_raster.rasterize(from_rounded_rects, 7, 7, {"strict_bounds": true})
    assert_true(oren_is_err(rounded_rect_buf) == false)
    assert_eq(_px(rounded_rect_buf, 7, 4, 3, 0), 136)
    assert_eq(_px(rounded_rect_buf, 7, 4, 3, 1), 204)
    assert_eq(_px(rounded_rect_buf, 7, 4, 3, 2), 68)

    var from_rgba_coords = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles_rgba",
                "id": 48,
                "triangles_xyz_rgba": [
                    {
                        "vertices": [[1, 1, 0], [2, 1, 0], [1, 2, 0]],
                        "color": "#0000ffff"
                    }
                ]
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 48}],
        "destroy": true
    })
    assert_true(oren_is_err(from_rgba_coords) == false)
    assert_eq(from_rgba_coords[0]["op"], "mesh3d_rgba")
    assert_true(ui_cmds.validate(from_rgba_coords, 4, 4, {"strict_bounds": true}) == 0)
    var rgba_coord_buf = ui_raster.rasterize(from_rgba_coords, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(rgba_coord_buf) == false)
    assert_eq(_px(rgba_coord_buf, 4, 1, 1, 2), 255)

    var from_scaled_rgba_coords = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles_rgba",
                "id": 148,
                "triangles_xyz_rgba": [
                    {
                        "vertices": [[1, 2, 3], [2, 2, 3], [1, 3, 3]],
                        "color": "#112233ff"
                    }
                ],
                "scale_xyz_milli": [2000, 500, 2000]
            }
        ]
    })
    assert_true(oren_is_err(from_scaled_rgba_coords) == false)
    assert_eq(oren_bytes_get_u8(from_scaled_rgba_coords[0]["triangles"], 0), 2)
    assert_eq(oren_bytes_get_u8(from_scaled_rgba_coords[0]["triangles"], 4), 1)
    assert_eq(oren_bytes_get_u8(from_scaled_rgba_coords[0]["triangles"], 8), 6)
    assert_eq(oren_bytes_get_u8(from_scaled_rgba_coords[0]["triangles"], 36), 17)

    var from_rotated_rgba_coords = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles_rgba",
                "id": 248,
                "triangles_xyz_rgba": [
                    {
                        "vertices": [[1, 0, 3], [2, 0, 3], [1, 1, 3]],
                        "color": "#112233ff"
                    }
                ],
                "transform": {"scale_xyz_milli": [2000, 1000, 1000], "rotation_z_milli_deg": 90000}
            }
        ]
    })
    assert_true(oren_is_err(from_rotated_rgba_coords) == false)
    assert_eq(oren_bytes_get_u8(from_rotated_rgba_coords[0]["triangles"], 0), 0)
    assert_eq(oren_bytes_get_u8(from_rotated_rgba_coords[0]["triangles"], 4), 2)
    assert_eq(oren_bytes_get_u8(from_rotated_rgba_coords[0]["triangles"], 8), 3)
    assert_eq(oren_bytes_get_u8(from_rotated_rgba_coords[0]["triangles"], 36), 17)

    var from_triangles_xy_rgba = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles_rgba",
                "id": 348,
                "triangles_xy_rgba": [
                    {"points": [[0, 0], [2, 0], [0, 2]], "z": 1, "color": "#112233ff"}
                ],
                "transform": {"translation_xyz": [1, 0, 5]}
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 348}],
        "destroy": true
    })
    assert_true(oren_is_err(from_triangles_xy_rgba) == false)
    assert_eq(from_triangles_xy_rgba[0]["op"], "mesh3d_rgba")
    assert_eq(bytes.len(from_triangles_xy_rgba[0]["triangles"]), 40)
    assert_eq(_i32_at(from_triangles_xy_rgba[0]["triangles"], 0), 1)
    assert_eq(_i32_at(from_triangles_xy_rgba[0]["triangles"], 4), 0)
    assert_eq(_i32_at(from_triangles_xy_rgba[0]["triangles"], 8), 6)
    assert_eq(oren_bytes_get_u8(from_triangles_xy_rgba[0]["triangles"], 36), 17)
    assert_true(ui_cmds.validate(from_triangles_xy_rgba, 4, 4, {"strict_bounds": true}) == 0)
    var triangles_xy_rgba_buf = ui_raster.rasterize(from_triangles_xy_rgba, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(triangles_xy_rgba_buf) == false)
    assert_eq(_px(triangles_xy_rgba_buf, 4, 2, 1, 0), 17)
    assert_eq(_px(triangles_xy_rgba_buf, 4, 2, 1, 1), 34)
    assert_eq(_px(triangles_xy_rgba_buf, 4, 2, 1, 2), 51)

    var from_quads_xy_rgba = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles_rgba",
                "id": 349,
                "quads_xy_rgba": [
                    {"points_xy": [[0, 0], [2, 0], [2, 2], [0, 2]], "z_milli": 1, "color": "#445566ff"}
                ],
                "transform": {"translation_xyz": [1, 0, 5]}
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 349}],
        "destroy": true
    })
    assert_true(oren_is_err(from_quads_xy_rgba) == false)
    assert_eq(from_quads_xy_rgba[0]["op"], "mesh3d_rgba")
    assert_eq(bytes.len(from_quads_xy_rgba[0]["triangles"]), 80)
    assert_eq(_i32_at(from_quads_xy_rgba[0]["triangles"], 0), 1)
    assert_eq(_i32_at(from_quads_xy_rgba[0]["triangles"], 4), 0)
    assert_eq(_i32_at(from_quads_xy_rgba[0]["triangles"], 8), 6)
    assert_eq(oren_bytes_get_u8(from_quads_xy_rgba[0]["triangles"], 36), 68)
    assert_eq(oren_bytes_get_u8(from_quads_xy_rgba[0]["triangles"], 76), 68)
    assert_true(ui_cmds.validate(from_quads_xy_rgba, 4, 4, {"strict_bounds": true}) == 0)
    var quads_xy_rgba_buf = ui_raster.rasterize(from_quads_xy_rgba, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(quads_xy_rgba_buf) == false)
    assert_eq(_px(quads_xy_rgba_buf, 4, 2, 1, 0), 68)
    assert_eq(_px(quads_xy_rgba_buf, 4, 2, 1, 1), 85)
    assert_eq(_px(quads_xy_rgba_buf, 4, 2, 1, 2), 102)

    exit(0)
}

main()
