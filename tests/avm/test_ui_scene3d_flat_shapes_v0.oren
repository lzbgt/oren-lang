// AVM headless UI test: std:ui/scene3d generated flat-shape assets.

import scene3d "std:ui/scene3d"
import ui_cmds "std:ui/commands"
import ui_raster "std:ui/raster"
import bytes "std:bytes"

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_true(x) {
    if x { return 0 }
    fail()
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn _px(buf, w, x, y, chan) {
    return oren_bytes_get_u8(buf, (y * w + x) * 4 + chan)
}

fn _i32_at(buf, off) {
    var u = oren_bytes_get_u8(buf, off + 0) +
        oren_bytes_get_u8(buf, off + 1) * 256 +
        oren_bytes_get_u8(buf, off + 2) * 65536 +
        oren_bytes_get_u8(buf, off + 3) * 16777216
    if u >= 2147483648 { return u - 4294967296 }
    return u
}

fn main() {
    var from_triangles_xy = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 242,
                "triangles_xy": [
                    {"points": [[0, 0], [2, 0], [0, 2]], "z": 1}
                ],
                "transform": {"translation_xyz": [1, 0, 5]},
                "color": "#44cc88"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 242}],
        "destroy": true
    })
    assert_true(oren_is_err(from_triangles_xy) == false)
    assert_eq(from_triangles_xy[0]["op"], "mesh3d")
    assert_eq(bytes.len(from_triangles_xy[0]["triangles"]), 36)
    assert_eq(_i32_at(from_triangles_xy[0]["triangles"], 0), 1)
    assert_eq(_i32_at(from_triangles_xy[0]["triangles"], 4), 0)
    assert_eq(_i32_at(from_triangles_xy[0]["triangles"], 8), 6)
    assert_true(ui_cmds.validate(from_triangles_xy, 4, 4, {"strict_bounds": true}) == 0)
    var triangles_xy_buf = ui_raster.rasterize(from_triangles_xy, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(triangles_xy_buf) == false)
    assert_eq(_px(triangles_xy_buf, 4, 2, 1, 0), 68)
    assert_eq(_px(triangles_xy_buf, 4, 2, 1, 1), 204)
    assert_eq(_px(triangles_xy_buf, 4, 2, 1, 2), 136)

    var from_triangles_xy_points_xy = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 244,
                "triangles_xy": [
                    {"points_xy": [[2, 3], [4, 3], [2, 5]], "z_milli": 7}
                ],
                "color": "#ffffff"
            }
        ]
    })
    assert_true(oren_is_err(from_triangles_xy_points_xy) == false)
    assert_eq(bytes.len(from_triangles_xy_points_xy[0]["triangles"]), 36)
    assert_eq(_i32_at(from_triangles_xy_points_xy[0]["triangles"], 0), 2)
    assert_eq(_i32_at(from_triangles_xy_points_xy[0]["triangles"], 4), 3)
    assert_eq(_i32_at(from_triangles_xy_points_xy[0]["triangles"], 8), 7)

