// AVM smoke: bare `yield` now covers top-level split-dispatch plus branch/block passthrough cases.

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn worker(limit) {
    var i = 0
    while i < limit {
        yield
        i = i + 1
    }
    return limit
}

fn local_after_yield(seed) {
    var acc = seed + 1
    yield
    return acc
}

fn param_after_yield(seed) {
    yield
    return seed + 1
}

fn multi_after_yield(seed) {
    var acc = seed
    yield
    acc = acc + 1
    yield
    return acc + 1
}

fn branch_after_yield(seed) {
    if true {
        yield
    }
    return seed + 1
}

fn block_after_yield(seed) {
    {
        var tmp = seed + 1
        yield
    }
    return seed + 1
}

fn main() {
    assert_eq(oren_yield_stmt(), nil)
    yield
    assert_eq(local_after_yield(4), 5)
    assert_eq(param_after_yield(7), 8)
    assert_eq(multi_after_yield(10), 12)
    assert_eq(branch_after_yield(20), 21)
    assert_eq(block_after_yield(30), 31)
    var h = spawn worker(3)
    assert_eq(oren_join(h), 3)
    exit(0)
}
