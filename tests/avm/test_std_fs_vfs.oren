import bytes "std:bytes"
import fs "std:fs"

fn fail(code) {
    print("avm std fs FAIL " + oren_int_to_string(code))
    oren_exit(code)
}

fn has_name(names, want) {
    var i = 0
    while i < oren_list_len(names) {
        if names[i] == want { return true }
        i = i + 1
    }
    return false
}

fn main() {
    var wt = fs.write_text("v/dir/in.txt", "hello vfs")
    if oren_is_err(wt) { fail(1) }
    if fs.exists("v/dir/in.txt") != true { fail(2) }
    if fs.exists("v/dir/missing.txt") != false { fail(3) }

    var rt = fs.read_text("v/dir/in.txt")
    if oren_is_err(rt) { fail(4) }
    if rt != "hello vfs" { fail(5) }
    if !oren_is_err(fs.read_text("v/dir/missing.txt")) { fail(6) }

    var src = bytes.pack([7, 8, 9, 255])
    if oren_is_err(src) { fail(10) }
    var wb = fs.write_bytes("v/dir/data.bin", src)
    if oren_is_err(wb) { fail(11) }

    var rb = fs.read_u8_buf("v/dir/data.bin")
    if oren_is_err(rb) { fail(12) }
    if bytes.len(rb) != 4 { fail(13) }
    if bytes.get_u8(rb, 0) != 7 { fail(14) }
    if bytes.get_u8(rb, 3) != 255 { fail(15) }

    var legacy = fs.read_byte_list("v/dir/data.bin")
    if oren_is_err(legacy) { fail(16) }
    if oren_list_len(legacy) != 4 { fail(17) }
    if legacy[1] != 8 || legacy[3] != 255 { fail(18) }

    var names = fs.list_dir("v/dir")
    if oren_is_err(names) { fail(20) }
    if has_name(names, "data.bin") != true { fail(21) }
    if has_name(names, "in.txt") != true { fail(22) }

    var wt2 = fs.write_text_under("v/dir", ["under.txt"], "under root")
    if oren_is_err(wt2) { fail(30) }
    if fs.exists_under("v/dir", ["under.txt"]) != true { fail(31) }
    if fs.read_text_under("v/dir", ["under.txt"]) != "under root" { fail(32) }
    var sub_names = fs.list_dir_under("v/dir", [])
    if oren_is_err(sub_names) { fail(33) }
    if has_name(sub_names, "under.txt") != true { fail(34) }

    var wb2 = fs.write_bytes_under("v/dir", ["under.bin"], src)
    if oren_is_err(wb2) { fail(35) }
    var rb2 = fs.read_u8_buf_under("v/dir", ["under.bin"])
    if oren_is_err(rb2) { fail(36) }
    if bytes.len(rb2) != 4 || bytes.get_u8(rb2, 3) != 255 { fail(37) }
    var legacy2 = fs.read_byte_list_under("v/dir", ["under.bin"])
    if oren_is_err(legacy2) { fail(38) }
    if oren_list_len(legacy2) != 4 || legacy2[0] != 7 { fail(39) }

    if !oren_is_err(fs.write_text_under("v/dir", ["..", "escape.txt"], "bad")) { fail(40) }
    if !oren_is_err(fs.read_text_under("v/dir", ["/etc/passwd"])) { fail(41) }
    if !oren_is_err(fs.exists_under("v/dir", ["..", "escape.txt"])) { fail(42) }

    print("avm std fs OK")
    oren_exit(0)
}

main()
