import sha256 "std:crypto/sha256"
import sha1 "std:crypto/sha1"
import x509 "std:crypto/x509"
import bytes "std:bytes"
import list "std:list"

fn fail(msg) {
    print("FAIL: " + msg)
    oren_exit(1)
}

fn streq(a, b) {
    var ab = oren_bytes_from_string(a)
    var bb = oren_bytes_from_string(b)
    var an = oren_bytes_len(ab)
    if an != oren_bytes_len(bb) { return false }
    var i = 0
    while i < an {
        if oren_bytes_get_u8(ab, i) != oren_bytes_get_u8(bb, i) { return false }
        i = i + 1
    }
    return true
}

fn assert_eq(got, want, label) {
    if got == want { return nil }
    if streq(got, want) { return nil }
    {
        print("label=" + label)
        print("got =" + got)
        print("want=" + want)
        fail("mismatch")
    }
}

fn main() {
    // Test vectors (SHA-256):
    // - ""    => e3b0c442...
    // - "abc" => ba7816bf...
    var empty = oren_bytes_pack([])
    var got0 = sha256.sha256_hex(empty)
    assert_eq(got0, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "empty")
    var got0_repeat = sha256.sha256_hex(empty)
    assert_eq(got0_repeat, got0, "empty repeat")

    var abc = oren_bytes_from_string("abc")
    var got1 = sha256.sha256_hex(abc)
    assert_eq(got1, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "abc")
    assert_eq(sha256.sha256_hex([97, 98, 99]), got1, "sha256 list fallback")
    assert_eq(sha256.hex(bytes.from_string("abc")), got1, "sha256 canonical hex")
    assert_eq(bytes.from_string("abc").sha256_hex(), got1, "sha256 method hex")
    assert_eq(bytes.from_string("abc").sha256().hex(), got1, "sha256 chained digest hex")
    assert_eq(sha256.sha256_hex_string("abc"), got1, "sha256 string hex")
    assert_eq(sha256.hex_string("abc"), got1, "sha256 string hex alias")
    assert_eq(bytes.to_hex(sha256.sha256_string("abc")), got1, "sha256 string digest")
    assert_eq(oren_bytes_to_hex(oren_sha256_range(abc, 0, 3)), got1, "sha256 native u8 range")
    assert_eq(oren_bytes_to_hex(oren_sha256_range([97, 98, 99], 0, 3)), got1, "sha256 native list range")
    var abc_li = list.int_new(0)
    list.int_push(abc_li, 97)
    list.int_push(abc_li, 98)
    list.int_push(abc_li, 99)
    assert_eq(oren_bytes_to_hex(oren_sha256_range(abc_li, 0, 3)), got1, "sha256 native list_int range")
    var long_list = []
    var long_list_int = list.int_new(0)
    var long_i = 0
    while long_i < 70000 {
        var long_b = (long_i * 37 + 11) & 255
        oren_list_push(long_list, long_b)
        list.int_push(long_list_int, long_b)
        long_i = long_i + 1
    }
    var long_hash = "3c43d02a5c493c6c534dda8983b3da6d13cf36f155491e4d6553c0a88f5b817d"
    assert_eq(oren_bytes_to_hex(oren_sha256_range(long_list, 0, 70000)), long_hash, "sha256 AVM long boxed list range")
    assert_eq(oren_bytes_to_hex(oren_sha256_range(long_list_int, 0, 70000)), long_hash, "sha256 AVM long list_int range")
    var got1_repeat = sha256.sha256_hex(abc)
    assert_eq(got1_repeat, got1, "abc repeat")
    var multiblock = oren_bytes_from_string("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    var got2 = sha256.sha256_hex(multiblock)
    assert_eq(got2, "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "sha256 multiblock")
    var bad = sha256.sha256_hex(123)
    if oren_is_err(bad) != true {
        fail("sha256_hex bad input should return err")
    }
    var bad_list = sha256.sha256_bytes([0, 256])
    if oren_is_err(bad_list) != true {
        fail("sha256_bytes bad list should return err")
    }

    var sha1_abc = sha1.sha1_hex(abc)
    assert_eq(sha1_abc, "a9993e364706816aba3e25717850c26c9cd0d89d", "sha1 abc")
    assert_eq(sha1.sha1_hex([97, 98, 99]), sha1_abc, "sha1 list fallback")
    assert_eq(sha1.sha1_hex(abc_li), sha1_abc, "sha1 list_int fallback")
    assert_eq(sha1.hex(bytes.from_string("abc")), sha1_abc, "sha1 canonical hex")
    assert_eq(bytes.from_string("abc").sha1_hex(), sha1_abc, "sha1 method hex")
    assert_eq(bytes.from_string("abc").sha1().hex(), sha1_abc, "sha1 chained digest hex")
    assert_eq(sha1.sha1_hex_string("abc"), sha1_abc, "sha1 string hex")
    assert_eq(sha1.hex_string("abc"), sha1_abc, "sha1 string hex alias")
    assert_eq(bytes.to_hex(sha1.sha1_string("abc")), sha1_abc, "sha1 string digest")
    var sha1_multiblock = sha1.sha1_hex(multiblock)
    assert_eq(sha1_multiblock, "84983e441c3bd26ebaae4aa1f95129e5e54670f1", "sha1 multiblock")
    assert_eq(sha1.sha1_hex_string("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), sha1_multiblock, "sha1 string multiblock")
    assert_eq(sha1.sha1_hex(long_list_int), sha1.sha1_hex(long_list), "sha1 AVM long list_int range")
    var sha1_bad = sha1.sha1_bytes(123)
    if oren_is_err(sha1_bad) != true {
        fail("sha1_bytes bad input should return err")
    }
    var sha1_bad_list = sha1.sha1_bytes([0, 256])
    if oren_is_err(sha1_bad_list) != true {
        fail("sha1_bytes bad list should return err")
    }
    var sha1_bad_string = sha1.sha1_string(123)
    if oren_is_err(sha1_bad_string) != true {
        fail("sha1_string bad input should return err")
    }

    var x509_abc = x509.sha256_hex_der(abc)
    assert_eq(x509_abc, got1, "x509 sha256 der")
    var x509_bad = x509.sha256_hex_der(123)
    if oren_is_err(x509_bad) != true {
        fail("sha256_hex_der bad input should return err")
    }

    print("sha256 vectors OK")
    oren_exit(0)
}

main()
