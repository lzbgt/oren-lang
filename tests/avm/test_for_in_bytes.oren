fn main() {
    var b = oren_bytes_from_hex("00010203")
    if oren_is_err(b) { oren_exit(1) }
    var h = 0
    for x in b {
        h = (h << 7) + (h << 1) + h + x
    }
    var want = 0
    want = (want << 7) + (want << 1) + want + 0
    want = (want << 7) + (want << 1) + want + 1
    want = (want << 7) + (want << 1) + want + 2
    want = (want << 7) + (want << 1) + want + 3
    if h != want { oren_exit(1) }
    print("avm for-in bytes OK")
}

main()
