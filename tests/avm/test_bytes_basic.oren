fn main() {
    var from_s = oren_bytes_from_string("ok")
    if oren_is_u8_buf(from_s) != true { oren_exit(101) }
    if oren_bytes_len(from_s) != 2 { oren_exit(102) }
    if oren_bytes_get_u8(from_s, 0) != 111 { oren_exit(103) }
    if oren_bytes_get_u8(from_s, 1) != 107 { oren_exit(104) }
    if oren_string_from_bytes(from_s) != "ok" { oren_exit(105) }
    var from_s_xs = oren_bytes_unpack(from_s)
    if oren_is_err(from_s_xs) { oren_exit(113) }
    if oren_bytes_len(from_s_xs) != 2 { oren_exit(125) }
    if oren_string_from_bytes(from_s_xs) != "ok" { oren_exit(114) }
    if oren_bytes_to_hex(from_s_xs) != "6f6b" { oren_exit(121) }
    var boxed_ok = [111, 107]
    if oren_bytes_len(boxed_ok) != 2 { oren_exit(126) }
    if oren_bytes_to_hex(boxed_ok) != "6f6b" { oren_exit(122) }
    var boxed_bad = [65, 300]
    if oren_is_err(oren_bytes_to_hex(boxed_bad)) == false { oren_exit(123) }
    var empty_s = oren_bytes_from_string("")
    if oren_is_u8_buf(empty_s) != true { oren_exit(106) }
    if oren_bytes_len(empty_s) != 0 { oren_exit(107) }
    if oren_string_from_bytes(empty_s) != "" { oren_exit(108) }

    // Construct bytes from hex (includes 0x00 and 0xff).
    var b = oren_bytes_from_hex("00ff1020")
    if oren_is_err(b) { oren_exit(1) }

    if oren_bytes_len(b) != 4 { oren_exit(1) }
    if oren_bytes_get_u8(b, 0) != 0 { oren_exit(1) }
    if oren_bytes_get_u8(b, 1) != 255 { oren_exit(1) }

    // Mutate deterministically.
    oren_bytes_set_u8(b, 2, 171) // 0xab
    if oren_bytes_get_u8(b, 2) != 171 { oren_exit(1) }

    // Roundtrip to hex.
    var hx = oren_bytes_to_hex(b)
    if oren_is_err(hx) { oren_exit(1) }
    if hx != "00ffab20" { oren_exit(1) }

    // Pack/unpack roundtrip.
    var xs = oren_bytes_unpack(b)
    if oren_is_err(xs) { oren_exit(1) }
    if oren_type_tag(xs) != 6 { oren_exit(109) }
    if oren_list_len(xs) != 4 { oren_exit(1) }
    if xs[2] != 171 { oren_exit(1) }
    var empty_xs = oren_bytes_unpack(empty_s)
    if oren_is_err(empty_xs) { oren_exit(110) }
    if oren_type_tag(empty_xs) != 6 { oren_exit(111) }
    if oren_list_len(empty_xs) != 0 { oren_exit(112) }

    var packed_empty_li = oren_new_list_int(0)
    var packed_empty = oren_bytes_pack(packed_empty_li)
    if oren_is_err(packed_empty) { oren_exit(115) }
    if oren_bytes_len(packed_empty) != 0 { oren_exit(116) }
    var unpacked_empty = oren_bytes_unpack(packed_empty_li)
    if oren_is_err(unpacked_empty) { oren_exit(117) }
    if oren_list_len(unpacked_empty) != 0 { oren_exit(118) }

    var bad_li = oren_new_list_int(0)
    oren_list_int_push(bad_li, 65)
    oren_list_int_push(bad_li, 300)
    if oren_is_err(oren_bytes_pack(bad_li)) == false { oren_exit(119) }
    if oren_is_err(oren_bytes_unpack(bad_li)) == false { oren_exit(120) }
    if oren_is_err(oren_bytes_to_hex(bad_li)) == false { oren_exit(124) }

    var b2 = oren_bytes_pack(xs)
    if oren_is_err(b2) { oren_exit(1) }
    if oren_bytes_to_hex(b2) != "00ffab20" { oren_exit(1) }

    // Explicitly publish result for consensus hashing.
    oren_set_result(hx)
}

main()
