fn main() {
    var s = "ABC"
    var h = 0
    for ch in s {
        // 131 = 128 + 2 + 1, avoid `*` (bytecode backend doesn't implement MUL yet).
        h = (h << 7) + (h << 1) + h + ch
    }
    var want = 0
    want = (want << 7) + (want << 1) + want + 65
    want = (want << 7) + (want << 1) + want + 66
    want = (want << 7) + (want << 1) + want + 67
    if h != want { oren_exit(1) }
    print("avm for-in string OK")
}

main()
