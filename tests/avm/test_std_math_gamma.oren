@myorg.tag(name="avm-std-math-gamma")

import math "../../lib/std/math.oren"

fn fail(code, msg) {
    print("avm std math gamma FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_close(a: f64, b: f64, eps: f64, code, msg) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code, msg)
}

assert_close(math.tgamma(1.0), 1.0, 1e-9, 10, "tgamma(1)")
assert_close(math.tgamma(5.0), 24.0, 1e-7, 11, "tgamma(5)")
assert_close(math.tgamma(0.5), 1.772453850905516, 1e-9, 12, "tgamma(1/2)")
assert_close(math.tgamma(0.0 - 0.5), 0.0 - 3.544907701811032, 1e-8, 13, "tgamma(-1/2)")
assert_close(math.lgamma(5.0), math.ln(24.0), 1e-10, 20, "lgamma(5)")
assert_close(math.lgamma(0.5), 0.5723649429247001, 1e-10, 21, "lgamma(1/2)")
assert_close(math.exp(math.lgamma(6.0)), math.tgamma(6.0), 1e-6, 22, "exp(lgamma)")

assert_true(math.is_inf(math.tgamma(math.inf())), 30, "tgamma(+inf)")
assert_true(math.is_inf(math.lgamma(math.inf())), 31, "lgamma(+inf)")
assert_true(oren_is_err(math.tgamma(0.0)), 40, "tgamma pole")
assert_true(oren_is_err(math.lgamma(0.0 - 2.0)), 41, "lgamma pole")
assert_true(oren_is_err(math.tgamma(0.0 / 0.0)), 42, "tgamma NaN")
assert_true(oren_is_err(math.lgamma(math.neg_inf())), 43, "lgamma -inf")

print("avm std math gamma OK")
exit(0)
