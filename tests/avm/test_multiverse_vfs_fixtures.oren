fn main() {
    // Parent universe reads a child .obc as BYTES, then runs it as a nested universe
    // via the AVM capability domain (domain 8).
    //
    // Makefile builds the child .obc at:
    //   build/multiverse_child_vfs.obc
    var child_obc = oren_read_bytes("build/multiverse_child_vfs.obc")

    // Child must be able to use CORE (domain 0) and FS (domain 1).
    var allowed = (1 << 0) + (1 << 1)

    // AVMVFS01 fixtures: 1 entry mapping path="x" -> body="ok"
    var vfs_fx = oren_bytes_from_hex("41564d5646533031010000000100000078020000006f6b")

    var cfg = {
        "deterministic": true,
        "gas_limit": 1000000,
        "allowed_domains": allowed,
        "fs_backend": 1,
        "vfs_fixtures": vfs_fx
    }

    var r1 = oren_avm_run_obc_bytes(child_obc, cfg)
    oren_set_result({"exit_code": r1["exit_code"], "log_len": oren_bytes_len(r1["record_log"])})
}

main()

