@myorg.tag(name="avm-std-math-decompose")

import math "../../lib/std/math.oren"

fn fail(code, msg) {
    print("avm std math decompose FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_close(a, b, eps, code, msg) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code, msg)
}

fn assert_frexp(x, mantissa, exp, eps, code, msg) {
    var p = math.frexp(x)
    if oren_is_err(p) { fail(code, msg + " returned err") }
    assert_close(p[0], mantissa, eps, code + 1, msg + " mantissa")
    assert_true(p[1] == exp, code + 2, msg + " exp")
    assert_close(math.ldexp(p[0], p[1]), x, eps, code + 3, msg + " roundtrip")
}

assert_frexp(12.0, 0.75, 4, 1e-12, 10, "frexp positive normal")
assert_frexp(0.0 - 12.0, 0.0 - 0.75, 4, 1e-12, 20, "frexp negative normal")
assert_frexp(0.15625, 0.625, 0 - 2, 1e-12, 30, "frexp fractional normal")

var z = math.frexp(0.0)
assert_true(!oren_is_err(z), 40, "frexp zero ok")
assert_close(z[0], 0.0, 0.0, 41, "frexp zero mantissa")
assert_true(z[1] == 0, 42, "frexp zero exp")

var tiny = math.pow2i(0 - 1074)
assert_true(tiny > 0.0, 50, "pow2i smallest subnormal")
assert_frexp(tiny, 0.5, 0 - 1073, 0.0, 51, "frexp smallest subnormal")
assert_close(math.ldexp(0.5, 0 - 1073), tiny, 0.0, 55, "ldexp smallest subnormal")

assert_close(math.ldexp(1.5, 3), 12.0, 1e-12, 60, "ldexp scale up")
assert_close(math.ldexp(12.0, 0 - 3), 1.5, 1e-12, 61, "ldexp scale down")
assert_true(math.is_inf(math.ldexp(1.0, 2048)), 62, "ldexp overflow")
assert_close(math.ldexp(1.0, 0 - 2048), 0.0, 0.0, 63, "ldexp underflow")
assert_true(math.is_inf(math.ldexp(math.inf(), 5)), 64, "ldexp inf")
assert_true(oren_is_err(math.ldexp(0.0 / 0.0, 1)), 65, "ldexp nan error")
assert_true(oren_is_err(math.frexp(0.0 / 0.0)), 66, "frexp nan error")
assert_close(math.scalbn(1.5, 4), 24.0, 1e-12, 67, "scalbn scale")
assert_close(math.scalbln(24.0, 0 - 4), 1.5, 1e-12, 68, "scalbln scale")
assert_close(math.fdim(7.25, 2.0), 5.25, 1e-12, 69, "fdim positive")
assert_close(math.fdim(2.0, 7.25), 0.0, 0.0, 70, "fdim zero")
assert_true(math.ilogb(1.0) == 0, 71, "ilogb one")
assert_true(math.ilogb(8.0) == 3, 72, "ilogb eight")
assert_true(math.ilogb(0.125) == 0 - 3, 73, "ilogb fraction")
assert_true(math.ilogb(tiny) == 0 - 1074, 74, "ilogb tiny")
assert_close(math.logb(8.0), 3.0, 0.0, 75, "logb eight")
assert_true(math.is_inf(math.logb(math.inf())), 76, "logb inf")
assert_true(oren_is_err(math.ilogb(0.0)), 77, "ilogb zero error")
assert_true(oren_is_err(math.logb(0.0)), 78, "logb zero error")

var m = math.modf(0.0 - 12.75)
if oren_is_err(m) { fail(100, "modf negative err") }
assert_close(m[0], 0.0 - 0.75, 1e-12, 101, "modf negative frac")
assert_close(m[1], 0.0 - 12.0, 1e-12, 102, "modf negative integral")
var mi = math.modf(0.0 - 12.0)
if oren_is_err(mi) { fail(110, "modf negative integer err") }
assert_close(mi[0], 0.0, 0.0, 111, "modf negative integer frac")
assert_true(oren_is_err(math.modf(0.0 / 0.0)), 120, "modf nan error")

assert_close(math.hypot(3.0, 4.0), 5.0, 1e-12, 70, "hypot classic")
assert_close(math.hypot(0.0 - 3.0, 4.0), 5.0, 1e-12, 71, "hypot signs")
assert_close(math.hypot(0.0, 0.0), 0.0, 0.0, 72, "hypot zero")
assert_close(math.hypot(3000000.0, 4000000.0), 5000000.0, 1e-6, 73, "hypot scaled")
assert_true(math.is_inf(math.hypot(math.inf(), 1.0)), 74, "hypot inf")
assert_true(oren_is_err(math.hypot(0.0 / 0.0, 1.0)), 75, "hypot nan error")
assert_close(math.hypot3(2.0, 3.0, 6.0), 7.0, 1e-12, 76, "hypot3 classic")
assert_close(math.hypot3(3000000.0, 4000000.0, 12000000.0), 13000000.0, 1e-6, 79, "hypot3 scaled")
assert_true(math.is_inf(math.hypot3(1.0, math.inf(), 2.0)), 90, "hypot3 inf")
assert_true(oren_is_err(math.hypot3(1.0, 0.0 / 0.0, 2.0)), 91, "hypot3 nan error")

assert_close(math.cbrt(27.0), 3.0, 1e-12, 80, "cbrt exact positive")
assert_close(math.cbrt(0.0 - 27.0), 0.0 - 3.0, 1e-12, 81, "cbrt exact negative")
assert_close(math.cbrt(0.125), 0.5, 1e-12, 82, "cbrt fractional")
assert_close(math.cbrt(2.0), 1.2599210498948732, 1e-12, 83, "cbrt irrational")
assert_close(math.cbrt(math.pow2i(0 - 54)), math.pow2i(0 - 18), 1e-24, 84, "cbrt subnormal scale")
assert_close(math.cbrt(0.0), 0.0, 0.0, 85, "cbrt zero")
assert_true(math.is_inf(math.cbrt(math.inf())), 86, "cbrt inf")
assert_true(math.is_inf(math.cbrt(math.neg_inf())), 87, "cbrt neg inf")
assert_true(math.signbit(math.cbrt(math.neg_inf())), 88, "cbrt neg inf sign")
assert_true(oren_is_err(math.cbrt(0.0 / 0.0)), 89, "cbrt nan error")

var tiny_up = math.nextafter(0.0, 1.0)
assert_close(tiny_up, tiny, 0.0, 130, "nextafter smallest positive")
assert_close(math.nextafter(tiny_up, 0.0), 0.0, 0.0, 131, "nextafter back to zero")
var one_up = math.nextafter(1.0, 2.0)
assert_true(one_up > 1.0, 132, "nextafter one up")
assert_close(math.nextafter(one_up, 1.0), 1.0, 0.0, 133, "nextafter one back")
var one_down = math.nextafter(1.0, 0.0)
assert_true(one_down < 1.0, 134, "nextafter one down")
assert_true(one_down > 0.999999999999999, 135, "nextafter one down close")
assert_close(math.nexttoward(1.0, 2.0), one_up, 0.0, 136, "nexttoward alias")
assert_true(oren_is_err(math.nextafter(0.0 / 0.0, 1.0)), 137, "nextafter nan")
assert_close(math.nextup(1.0), one_up, 0.0, 138, "nextup one")
assert_close(math.nextdown(1.0), one_down, 0.0, 139, "nextdown one")
assert_close(math.nextup(0.0), tiny, 0.0, 140, "nextup zero")
assert_close(math.nextdown(0.0), 0.0 - tiny, 0.0, 141, "nextdown zero")
assert_true(oren_is_err(math.nextup(0.0 / 0.0)), 142, "nextup nan")
assert_true(oren_is_err(math.nextdown(0.0 / 0.0)), 143, "nextdown nan")

print("avm std math decompose OK")
exit(0)
