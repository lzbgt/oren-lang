// AVM headless UI test: std:ui/scene3d generated solid-shape assets.

import scene3d "std:ui/scene3d"
import ui_cmds "std:ui/commands"
import ui_raster "std:ui/raster"

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_true(x) {
    if x { return 0 }
    fail()
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn _px(buf, w, x, y, chan) {
    return oren_bytes_get_u8(buf, (y * w + x) * 4 + chan)
}

fn main() {
    var from_cylinders = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 42,
                "cylinders_z": [
                    {"center": [1, 1], "radius": 1, "z_min": 0, "z_max": 1, "segments": 4}
                ],
                "color": "#0088ff"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 42}],
        "destroy": true
    })
    assert_true(oren_is_err(from_cylinders) == false)
    assert_eq(from_cylinders[0]["op"], "mesh3d")
    assert_true(ui_cmds.validate(from_cylinders, 4, 4, {"strict_bounds": true}) == 0)
    var cylinder_buf = ui_raster.rasterize(from_cylinders, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(cylinder_buf) == false)
    assert_eq(_px(cylinder_buf, 4, 1, 1, 1), 136)
    assert_eq(_px(cylinder_buf, 4, 1, 1, 2), 255)

    var from_cones = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 43,
                "cones_z": [
                    {"center": [1, 1], "radius": 1, "z_min": 0, "z_max": 1, "segments": 4}
                ],
                "color": "#ff8800"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 43}],
        "destroy": true
    })
    assert_true(oren_is_err(from_cones) == false)
    assert_eq(from_cones[0]["op"], "mesh3d")
    assert_true(ui_cmds.validate(from_cones, 4, 4, {"strict_bounds": true}) == 0)
    var cone_buf = ui_raster.rasterize(from_cones, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(cone_buf) == false)
    assert_eq(_px(cone_buf, 4, 1, 1, 0), 255)
    assert_eq(_px(cone_buf, 4, 1, 1, 1), 136)

    var from_spheres = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 44,
                "spheres_xyz": [
                    {"center": [1, 1, 1], "radius": 1, "segments": 4, "rings": 2}
                ],
                "color": "#cc44ff"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 44}],
        "destroy": true
    })
    assert_true(oren_is_err(from_spheres) == false)
    assert_eq(from_spheres[0]["op"], "mesh3d")
    assert_true(ui_cmds.validate(from_spheres, 4, 4, {"strict_bounds": true}) == 0)
    var sphere_buf = ui_raster.rasterize(from_spheres, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(sphere_buf) == false)
    assert_eq(_px(sphere_buf, 4, 1, 1, 0), 204)
    assert_eq(_px(sphere_buf, 4, 1, 1, 2), 255)

    var from_ellipsoids = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 45,
                "ellipsoids_xyz": [
                    {"center": [1, 1, 1], "radii": [1, 1, 2], "segments": 4, "rings": 2}
                ],
                "color": "#44ccff"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 45}],
        "destroy": true
    })
    assert_true(oren_is_err(from_ellipsoids) == false)
    assert_eq(from_ellipsoids[0]["op"], "mesh3d")
    assert_true(ui_cmds.validate(from_ellipsoids, 4, 4, {"strict_bounds": true}) == 0)
    var ellipsoid_buf = ui_raster.rasterize(from_ellipsoids, 4, 4, {"strict_bounds": true})
    assert_true(oren_is_err(ellipsoid_buf) == false)
    assert_eq(_px(ellipsoid_buf, 4, 1, 1, 1), 204)
    assert_eq(_px(ellipsoid_buf, 4, 1, 1, 2), 255)

    var from_toruses = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 46,
                "toruses_xyz": [
                    {"center": [3, 3, 1], "major_radius": 2, "minor_radius": 1, "major_segments": 4, "minor_segments": 4}
                ],
                "color": "#22ffaa"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 46}],
        "destroy": true
    })
    assert_true(oren_is_err(from_toruses) == false)
    assert_eq(from_toruses[0]["op"], "mesh3d")
    assert_true(ui_cmds.validate(from_toruses, 7, 7, {"strict_bounds": true}) == 0)
    var torus_buf = ui_raster.rasterize(from_toruses, 7, 7, {"strict_bounds": true})
    assert_true(oren_is_err(torus_buf) == false)
    assert_eq(_px(torus_buf, 7, 5, 3, 0), 34)
    assert_eq(_px(torus_buf, 7, 5, 3, 1), 255)

    var from_capsules = scene3d.commands_from_asset({
        "meshes": [
            {
                "kind": "triangles",
                "id": 47,
                "capsules_z": [
                    {"center": [3, 3], "radius": 1, "z_min": 1, "z_max": 2, "segments": 4, "rings": 2}
                ],
                "color": "#ff66dd"
            }
        ],
        "draw": [{"op": "draw_mesh3d", "id": 47}],
        "destroy": true
    })
    assert_true(oren_is_err(from_capsules) == false)
    assert_eq(from_capsules[0]["op"], "mesh3d")
    assert_true(ui_cmds.validate(from_capsules, 7, 7, {"strict_bounds": true}) == 0)
    var capsule_buf = ui_raster.rasterize(from_capsules, 7, 7, {"strict_bounds": true})
    assert_true(oren_is_err(capsule_buf) == false)
    assert_eq(_px(capsule_buf, 7, 4, 3, 0), 255)
    assert_eq(_px(capsule_buf, 7, 4, 3, 1), 102)

    exit(0)
}

main()
