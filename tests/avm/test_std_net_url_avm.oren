import neturl "std:net/url"

fn fail(code) {
    print("avm std net url FAIL " + oren_int_to_string(code))
    oren_exit(code)
}

fn check(u, scheme, host, port, path, code) {
    if oren_is_err(u) { fail(code) }
    if u["scheme"] != scheme { fail(code + 1) }
    if u["host"] != host { fail(code + 2) }
    if u["port"] != port { fail(code + 3) }
    if u["path"] != path { fail(code + 4) }
}

fn check_auth(u, authority, path_only, query, target, code) {
    if oren_is_err(u) { fail(code) }
    if u["authority"] != authority { fail(code + 1) }
    if u["path_only"] != path_only { fail(code + 2) }
    if u["query"] != query { fail(code + 3) }
    if u["request_target"] != target { fail(code + 4) }
}

fn main() {
    check(neturl.parse_http("http://example.com"), "http", "example.com", 80, "/", 10)
    check(neturl.parse_http("https://example.com:8443/a/b?q=1"), "https", "example.com", 8443, "/a/b?q=1", 20)
    check(neturl.parse_ws("ws://127.0.0.1:9000/chat"), "ws", "127.0.0.1", 9000, "/chat", 30)
    check(neturl.parse("wss://example.org"), "wss", "example.org", 443, "/", 40)
    check_auth(neturl.parse_http("http://example.com?x=1#frag"), "example.com", "/", "x=1", "/?x=1", 90)
    check_auth(neturl.parse_http("http://[::1]:8080/a?b=1"), "[::1]:8080", "/a", "b=1", "/a?b=1", 100)
    var ip6 = neturl.parse_ws("ws://[2001:db8::1]/chat")
    check(ip6, "ws", "2001:db8::1", 80, "/chat", 110)
    check_auth(ip6, "[2001:db8::1]", "/chat", "", "/chat", 120)

    var u = neturl.parse_http("https://example.com:8443/a/b?q=hello+world&x=%2B#frag")
    if oren_is_err(u) { fail(50) }
    if u["path_only"] != "/a/b" || u["query"] != "q=hello+world&x=%2B" || u["request_target"] != "/a/b?q=hello+world&x=%2B" { fail(51) }
    if neturl.path_part(u["path"]) != "/a/b" { fail(52) }
    if neturl.query_part(u["path"]) != "q=hello+world&x=%2B" { fail(53) }
    if neturl.fragment_part(u["path"]) != "frag" { fail(74) }
    if neturl.without_fragment("https://example.com/a?b=1#frag") != "https://example.com/a?b=1" { fail(77) }
    if neturl.request_target(u["path"]) != "/a/b?q=hello+world&x=%2B" { fail(75) }
    if neturl.request_target("#frag") != "/" { fail(76) }
    if neturl.encode_component("a b+c/%") != "a%20b%2Bc%2F%25" { fail(54) }
    if neturl.decode_component("a%20b%2Bc%2F%25") != "a b+c/%" { fail(55) }
    if neturl.decode_query_component("a+b%2Bc") != "a b+c" { fail(56) }
    if !oren_is_err(neturl.decode_component("%xz")) { fail(57) }
    var params = neturl.query_params("/search?q=hello+world&empty=&flag&x=%2B")
    if oren_is_err(params) { fail(58) }
    if oren_list_len(params) != 4 { fail(59) }
    if params[0][0] != "q" || params[0][1] != "hello world" { fail(60) }
    if params[2][0] != "flag" || params[2][1] != "" { fail(61) }
    if params[3][0] != "x" || params[3][1] != "+" { fail(62) }
    if neturl.query_get("/search?q=hello+world&x=%2B", "q") != "hello world" { fail(63) }
    if neturl.build_query([["q", "hello world"], ["x", "+"]]) != "q=hello%20world&x=%2B" { fail(64) }
    if neturl.with_query("/search?old=1#frag", [["q", "hello world"]]) != "/search?q=hello%20world#frag" { fail(65) }
    if neturl.with_query("/search?old=1#frag", []) != "/search#frag" { fail(66) }
    if neturl.append_query("/search?old=1#frag", [["q", "hello world"]]) != "/search?old=1&q=hello%20world#frag" { fail(67) }
    if neturl.append_query("/search?#frag", [["q", "x"]]) != "/search?q=x#frag" { fail(68) }
    if neturl.origin("https://EXAMPLE.com:443/a?x=1#frag") != "https://example.com" { fail(80) }
    if neturl.origin("http://example.com:8080/a") != "http://example.com:8080" { fail(81) }
    if neturl.origin("ws://[2001:DB8::1]:9000/chat") != "ws://[2001:db8::1]:9000" { fail(82) }
    if neturl.same_origin("https://example.com/a", "https://EXAMPLE.com:443/b?x=1") != true { fail(83) }
    if neturl.same_origin("https://example.com", "http://example.com") != false { fail(84) }
    if neturl.same_origin("wss://[::1]/a", "wss://[::1]:443/b") != true { fail(85) }
    if !oren_is_err(neturl.origin("ftp://example.com")) { fail(86) }

    if !oren_is_err(neturl.parse_http("ftp://example.com")) { fail(70) }
    if !oren_is_err(neturl.parse_ws("http://example.com")) { fail(71) }
    if !oren_is_err(neturl.parse_http("http:///missing")) { fail(72) }
    if !oren_is_err(neturl.parse_http("http://example.com:0")) { fail(73) }
    if !oren_is_err(neturl.parse_http("http://user:pass@example.com/")) { fail(130) }
    if !oren_is_err(neturl.parse_http("http://::1/")) { fail(131) }
    if !oren_is_err(neturl.parse_http("http://[::1")) { fail(132) }
    if !oren_is_err(neturl.parse_http("http://example.com:65536/")) { fail(133) }

    print("avm std net url OK")
    oren_exit(0)
}

main()
