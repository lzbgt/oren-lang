import neturl "std:net/url"

fn fail(code) {
    print("avm std net url FAIL " + oren_int_to_string(code))
    oren_exit(code)
}

fn check(u, scheme, host, port, path, code) {
    if oren_is_err(u) { fail(code) }
    if u["scheme"] != scheme { fail(code + 1) }
    if u["host"] != host { fail(code + 2) }
    if u["port"] != port { fail(code + 3) }
    if u["path"] != path { fail(code + 4) }
}

fn main() {
    check(neturl.parse_http("http://example.com"), "http", "example.com", 80, "/", 10)
    check(neturl.parse_http("https://example.com:8443/a/b?q=1"), "https", "example.com", 8443, "/a/b?q=1", 20)
    check(neturl.parse_ws("ws://127.0.0.1:9000/chat"), "ws", "127.0.0.1", 9000, "/chat", 30)
    check(neturl.parse("wss://example.org"), "wss", "example.org", 443, "/", 40)

    var u = neturl.parse_http("https://example.com:8443/a/b?q=hello+world&x=%2B#frag")
    if oren_is_err(u) { fail(50) }
    if u["path_only"] != "/a/b" || u["query"] != "q=hello+world&x=%2B" { fail(51) }
    if neturl.path_part(u["path"]) != "/a/b" { fail(52) }
    if neturl.query_part(u["path"]) != "q=hello+world&x=%2B" { fail(53) }
    if neturl.encode_component("a b+c/%") != "a%20b%2Bc%2F%25" { fail(54) }
    if neturl.decode_component("a%20b%2Bc%2F%25") != "a b+c/%" { fail(55) }
    if neturl.decode_query_component("a+b%2Bc") != "a b+c" { fail(56) }
    if !oren_is_err(neturl.decode_component("%xz")) { fail(57) }
    var params = neturl.query_params("/search?q=hello+world&empty=&flag&x=%2B")
    if oren_is_err(params) { fail(58) }
    if oren_list_len(params) != 4 { fail(59) }
    if params[0][0] != "q" || params[0][1] != "hello world" { fail(60) }
    if params[2][0] != "flag" || params[2][1] != "" { fail(61) }
    if params[3][0] != "x" || params[3][1] != "+" { fail(62) }
    if neturl.query_get("/search?q=hello+world&x=%2B", "q") != "hello world" { fail(63) }
    if neturl.build_query([["q", "hello world"], ["x", "+"]]) != "q=hello%20world&x=%2B" { fail(64) }

    if !oren_is_err(neturl.parse_http("ftp://example.com")) { fail(70) }
    if !oren_is_err(neturl.parse_ws("http://example.com")) { fail(71) }
    if !oren_is_err(neturl.parse_http("http:///missing")) { fail(72) }
    if !oren_is_err(neturl.parse_http("http://example.com:0")) { fail(73) }

    print("avm std net url OK")
    oren_exit(0)
}

main()
