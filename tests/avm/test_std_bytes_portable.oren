@myorg.tag(name="avm-std-bytes-portable")

import assertm "../../lib/std/assert.oren"
import bufferm "../../lib/std/buffer.oren"
import bytesm "../../lib/std/bytes.oren"
import listm "../../lib/std/list.oren"
import stringsm "../../lib/std/strings.oren"

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_true(x) {
    if x { return 0 }
    fail()
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn test_bytes_conversions() {
    var bs = bytesm.from_string("ok")
    assert_true(!oren_is_err(bs))
    assert_true(oren_is_u8_buf(bs) == true)
    assert_eq(bytesm.to_string(bs), "ok")
    var method_bs = "ok".bytes()
    assert_true(oren_is_u8_buf(method_bs) == true)
    assert_eq(method_bs.text(), "ok")

    var packed = bytesm.pack([1, 2, 3])
    assert_true(!oren_is_err(packed))
    assert_true(oren_is_u8_buf(packed) == true)
    assert_eq(bytesm.get_u8(packed, 1), 2)
    var unpacked = bytesm.unpack(packed)
    assert_true(!oren_is_err(unpacked))
    assert_eq(oren_type_tag(unpacked), 6)
    assert_eq(oren_list_len(unpacked), 3)
    assert_eq(unpacked[0], 1)
    assert_eq(unpacked[1], 2)
    assert_eq(unpacked[2], 3)
    var empty_unpacked = bytesm.unpack(bytesm.from_string(""))
    assert_true(!oren_is_err(empty_unpacked))
    assert_eq(oren_type_tag(empty_unpacked), 6)
    assert_eq(oren_list_len(empty_unpacked), 0)

    assert_true(oren_is_err(bytesm.from_string(123)))
    assert_true(oren_is_err(bytesm.pack(123)))
    assert_true(oren_is_err(bytesm.pack([1, 256])))
    assert_true(oren_is_err(bytesm.unpack("nope")))

    var sub = bytesm.slice(bytesm.from_string("hello"), 1, 3)
    assert_true(!oren_is_err(sub))
    assert_eq(bytesm.to_string(sub), "ell")
    assert_true(oren_is_err(bytesm.slice(bs, -1, 1)))

    var cat = bytesm.concat(bytesm.from_string("ab"), bytesm.from_string("CD"))
    assert_true(!oren_is_err(cat))
    assert_eq(bytesm.to_string(cat), "abCD")
    assert_eq(bytesm.from_string("ab").concat(bytesm.from_string("CD")).text(), "abCD")
    assert_eq(bytesm.to_string(bytesm.concat([65], bytesm.from_string("BC"))), "ABC")
    assert_true(oren_is_err(bytesm.concat(123, cat)))

    var dst = bytesm.from_string("hello")
    assert_true(!oren_is_err(dst))
    assert_true(!oren_is_err(bytesm.copy_into(dst, 1, bytesm.from_string("XY"), 0, 2)))
    assert_eq(bytesm.to_string(dst), "hXYlo")
    assert_true(!oren_is_err(bytesm.set_u8(dst, 0, 72)))
    assert_eq(bytesm.to_string(dst), "HXYlo")
    assert_true(oren_is_err(bytesm.set_u8(dst, 0, 300)))
    assert_true(oren_is_err(bytesm.copy_into(dst, 4, bytesm.from_string("XY"), 0, 2)))
    assert_true(oren_is_err(bytesm.get_u8(dst, "x")))
    assert_true(oren_is_err(bytesm.set_u8(dst, "x", 1)))
    assert_true(oren_is_err(bytesm.copy_into(dst, "x", bytesm.from_string("XY"), 0, 1)))

    var list_dst = [97, 98]
    assert_true(!oren_is_err(bytesm.set_u8(list_dst, 1, 67)))
    assert_true(!oren_is_err(bytesm.copy_into(list_dst, 0, bytesm.from_string("Z"), 0, 1)))
    assert_eq(bytesm.get_u8(list_dst, 0), 90)
    assert_eq(bytesm.to_string(list_dst), "ZC")

    var ub_dst = bufferm.u8_from_string("hello")
    var ub_src = bufferm.u8_from_string("ABCD")
    assert_true(!oren_is_err(bytesm.copy_into(ub_dst, 1, ub_src, 1, 2)))
    assert_eq(bufferm.u8_to_string(ub_dst), "hBClo")
    assert_true(!oren_is_err(bytesm.copy_into(ub_dst, 3, [88, 89], 0, 2)))
    assert_eq(bufferm.u8_to_string(ub_dst), "hBCXY")
    var overlap = bufferm.u8_from_string("abcdef")
    assert_true(!oren_is_err(bytesm.copy_into(overlap, 2, overlap, 0, 4)))
    assert_eq(bufferm.u8_to_string(overlap), "ababcd")
    var list_overlap = [97, 98, 99, 100, 101, 102]
    assert_true(!oren_is_err(bytesm.copy_into(list_overlap, 2, list_overlap, 0, 4)))
    assert_eq(bytesm.to_string(list_overlap), "ababcd")
    var list_int_overlap = listm.int_new(0)
    assert_true(!oren_is_err(listm.int_push(list_int_overlap, 97)))
    assert_true(!oren_is_err(listm.int_push(list_int_overlap, 98)))
    assert_true(!oren_is_err(listm.int_push(list_int_overlap, 99)))
    assert_true(!oren_is_err(listm.int_push(list_int_overlap, 100)))
    assert_true(!oren_is_err(listm.int_push(list_int_overlap, 101)))
    assert_true(!oren_is_err(listm.int_push(list_int_overlap, 102)))
    assert_true(!oren_is_err(bytesm.copy_into(list_int_overlap, 2, list_int_overlap, 0, 4)))
    assert_eq(bytesm.to_string(list_int_overlap), "ababcd")
}

fn test_bytes_from_hex() {
    var hx = bytesm.from_hex("00ffA10b")
    assert_true(!oren_is_err(hx))
    assert_true(oren_is_u8_buf(hx) == true)
    assert_eq(bytesm.len(hx), 4)
    assert_eq(bytesm.get_u8(hx, 0), 0)
    assert_eq(bytesm.get_u8(hx, 1), 255)
    assert_eq(bytesm.get_u8(hx, 2), 161)
    assert_eq(bytesm.get_u8(hx, 3), 11)
    assert_eq(bytesm.to_hex(hx), "00ffa10b")
    assert_eq(bytesm.to_hex([0, 15, 255]), "000fff")
    assert_eq(bytesm.to_hex(bytesm.pack([])), "")
    assert_true(oren_is_err(bytesm.from_hex("abc")))
    assert_true(oren_is_err(bytesm.from_hex("00x0")))
    assert_true(oren_is_err(bytesm.from_hex(123)))
    assert_true(oren_is_err(bytesm.to_hex(123)))
}

fn test_bytes_u8_buf_to_string() {
    var ub = oren_u8_buf_new(2)
    assert_true(!oren_is_err(ub))
    assert_true(!oren_is_err(oren_buf_store_u8(ub, 0, 65)))
    assert_true(!oren_is_err(oren_buf_store_u8(ub, 1, 66)))
    assert_eq(bytesm.to_string(ub), "AB")
    assert_eq(bytesm.to_string(ub), "AB")

    var from_buf = bytesm.from_u8_buf(ub)
    assert_true(!oren_is_err(from_buf))
    assert_eq(bytesm.to_string(from_buf), "AB")

    assert_eq(bytesm.to_string_slice(bytesm.from_string("hello"), 1, 3), "ell")
    assert_eq(bytesm.from_string("hello").slice(1, 3).text(), "ell")
    var slice_buf = bytesm.to_u8_buf_slice(bytesm.from_string("hello"), 1, 3)
    assert_true(!oren_is_err(slice_buf))
    assert_eq(bufferm.u8_to_string(slice_buf), "ell")

    var to_buf = bytesm.to_u8_buf(bytesm.from_string("CD"))
    assert_true(!oren_is_err(to_buf))
    assert_eq(bufferm.u8_to_string(to_buf), "CD")

    assert_true(oren_is_err(bytesm.from_u8_buf("nope")))
    assert_true(oren_is_err(bytesm.to_u8_buf(123)))
    assert_true(oren_is_err(bytesm.to_string_slice("nope", 0, 1)))
    assert_true(oren_is_err(bytesm.to_u8_buf_slice("nope", 0, 1)))
    assert_true(oren_is_err(bytesm.to_string_slice(bytesm.from_string("hi"), 1, 2)))
    assert_true(oren_is_err(bytesm.to_u8_buf_slice(bytesm.from_string("hi"), 1, 2)))
}

fn test_bytes_endian_writes() {
    var ub = bufferm.u8_from_string("........")
    assert_true(!oren_is_err(ub))
    assert_eq(bytesm.set_u16_be(ub, 0, 4660), 4660)
    assert_eq(bytesm.get_u16_be(ub, 0), 4660)
    assert_true(!oren_is_err(bytesm.put_i16_le(ub, 0, -2)))
    assert_eq(bytesm.get_i16_le(ub, 0), -2)
    assert_eq(bytesm.set_u32_le(ub, 0, 16909060), 16909060)
    assert_eq(bytesm.get_u32_le(ub, 0), 16909060)
    assert_true(!oren_is_err(bytesm.put_i32_be(ub, 0, -2)))
    assert_eq(bytesm.get_i32_be(ub, 0), -2)
    assert_eq(bytesm.set_u64_be(ub, 0, 72623859790382856), 72623859790382856)
    assert_eq(bytesm.get_u64_be(ub, 0), 72623859790382856)
    assert_true(!oren_is_err(bytesm.put_i64_le(ub, 0, -2)))
    assert_eq(bytesm.get_i64_le(ub, 0), -2)
    assert_true(!oren_is_err(bytesm.put_i64_be(ub, 0, -2)))
    assert_eq(bytesm.get_i64_be(ub, 0), -2)
    assert_true(oren_is_err(bytesm.put_u16_be(ub, 7, 1)))
    assert_true(oren_is_err(bytesm.put_u64_be(ub, 0, -1)))

    var listb = [0, 0, 0, 0]
    assert_true(!oren_is_err(bytesm.put_u16_be(listb, 0, 4660)))
    assert_eq(bytesm.get_u16_be(listb, 0), 4660)
    assert_eq(bytesm.set_u32_le(listb, 0, 16909060), 16909060)
    assert_eq(bytesm.get_u32_le(listb, 0), 16909060)
}

fn test_assert_streq_portable() {
    assertm.assert_streq("ok", "ok", "avm std assert_streq portable")
}

fn test_list_and_strings_validation() {
    assert_true(oren_is_err(stringsm.char_at("hi", "x")))
    assert_true(oren_is_err(stringsm.slice("hi", "x", 1)))
    assert_true(oren_is_err(listm.slice_copy([1, 2], "x", 1)))
    var bad = listm.slice_view([1, 2], "x", 1)
    var count = 0
    for _x in bad { count = count + 1 }
    assert_eq(count, 0)
}

fn main() {
    test_bytes_conversions()
    test_bytes_from_hex()
    test_bytes_u8_buf_to_string()
    test_bytes_endian_writes()
    test_assert_streq_portable()
    test_list_and_strings_validation()
    return 0
}
