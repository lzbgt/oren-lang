@myorg.tag(name="avm-std-bytes-portable")

import assertm "../../lib/std/assert.oren"
import bufferm "../../lib/std/buffer.oren"
import bytesm "../../lib/std/bytes.oren"

fn fail() {
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_true(x) {
    if x { return 0 }
    fail()
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn test_bytes_conversions() {
    var bs = bytesm.try_from_string("ok")
    assert_true(!oren_is_err(bs))
    assert_eq(bytesm.try_to_string(bs), "ok")

    var packed = bytesm.try_pack([1, 2, 3])
    assert_true(!oren_is_err(packed))
    var unpacked = bytesm.try_unpack(packed)
    assert_true(!oren_is_err(unpacked))
    assert_eq(oren_list_len(unpacked), 3)
    assert_eq(unpacked[0], 1)
    assert_eq(unpacked[1], 2)
    assert_eq(unpacked[2], 3)

    assert_true(oren_is_err(bytesm.try_from_string(123)))
    assert_true(oren_is_err(bytesm.try_pack(123)))
    assert_true(oren_is_err(bytesm.try_unpack("nope")))

    var sub = bytesm.try_slice(bytesm.try_from_string("hello"), 1, 3)
    assert_true(!oren_is_err(sub))
    assert_eq(bytesm.try_to_string(sub), "ell")
    assert_true(oren_is_err(bytesm.try_slice(bs, -1, 1)))

    var cat = bytesm.try_concat(bytesm.try_from_string("ab"), bytesm.try_from_string("CD"))
    assert_true(!oren_is_err(cat))
    assert_eq(bytesm.try_to_string(cat), "abCD")
    assert_true(oren_is_err(bytesm.try_concat(123, cat)))

    var dst = bytesm.try_from_string("hello")
    assert_true(!oren_is_err(dst))
    assert_true(!oren_is_err(bytesm.try_copy_into(dst, 1, bytesm.try_from_string("XY"), 0, 2)))
    assert_eq(bytesm.try_to_string(dst), "hXYlo")
    assert_true(oren_is_err(bytesm.try_copy_into(dst, 4, bytesm.try_from_string("XY"), 0, 2)))
}

fn test_bytes_u8_buf_to_string() {
    var ub = oren_u8_buf_new(2)
    assert_true(!oren_is_err(ub))
    assert_true(!oren_is_err(oren_buf_store_u8(ub, 0, 65)))
    assert_true(!oren_is_err(oren_buf_store_u8(ub, 1, 66)))
    assert_eq(bytesm.try_to_string(ub), "AB")
    assert_eq(bytesm.to_string(ub), "AB")

    var from_buf = bytesm.try_from_u8_buf(ub)
    assert_true(!oren_is_err(from_buf))
    assert_eq(bytesm.try_to_string(from_buf), "AB")

    var to_buf = bytesm.try_to_u8_buf(bytesm.try_from_string("CD"))
    assert_true(!oren_is_err(to_buf))
    assert_eq(bufferm.try_u8_to_string(to_buf), "CD")

    assert_true(oren_is_err(bytesm.try_from_u8_buf("nope")))
    assert_true(oren_is_err(bytesm.try_to_u8_buf(123)))
}

fn test_assert_streq_portable() {
    assertm.assert_streq("ok", "ok", "avm std assert_streq portable")
}

fn main() {
    test_bytes_conversions()
    test_bytes_u8_buf_to_string()
    test_assert_streq_portable()
    return 0
}
