@myorg.tag(name="avm-smoke-suite")

fn fail() {
    // Force a non-zero VM exit by triggering an index error.
    var a = [1]
    var x = a[2]
    print(x)
}

fn assert_true(x) {
    if x { return 0 }
    fail()
}

fn assert_eq(a, b) {
    if a == b { return 0 }
    fail()
}

fn inc(x) { return x + 1 }

fn sum_rec(n) {
    if n <= 0 { return 0 }
    return n + sum_rec(n - 1)
}

fn test_calls() {
    // Exercises CALL/RET stack discipline.
    var i = 0
    var x = 0
    while i < 10000 {
        x = inc(x)
        i = i + 1
    }
    assert_eq(x, 10000)
}

fn test_recursion() {
    // Exercises recursion depth and call frames.
    // sum 1..2000 = 2000*2001/2 = 2001000
    assert_eq(sum_rec(2000), 2001000)
}

fn test_bytes() {
    var b = oren_bytes_from_hex("00ff1020")
    if oren_is_err(b) { fail() }

    assert_eq(oren_bytes_len(b), 4)
    assert_eq(oren_bytes_get_u8(b, 0), 0)
    assert_eq(oren_bytes_get_u8(b, 1), 255)

    oren_bytes_set_u8(b, 2, 171) // 0xab
    assert_eq(oren_bytes_get_u8(b, 2), 171)

    var hx = oren_bytes_to_hex(b)
    if oren_is_err(hx) { fail() }
    assert_eq(hx, "00ffab20")

    // Bytes iteration is part of the generic `for x in ...` story.
    var sum = 0
    for x in b {
        sum = sum + x
    }
    // 0 + 255 + 171 + 32
    assert_eq(sum, 458)
}

fn test_map_order() {
    // Deterministic map ordering should make iteration stable regardless of insertion.
    var m = {"b": 1, "a": 2}
    var ks = []
    for k in m {
        oren_list_push(ks, k)
    }
    assert_eq(oren_list_len(ks), 2)
    assert_eq(ks[0], "a")
    assert_eq(ks[1], "b")
}

fn test_control_flow() {
    var xs = [1, 2, 3]
    var s = 0
    for x in xs {
        if x == 2 { continue }
        s = s + x
    }
    assert_eq(s, 4) // 1 + 3

    var j = 0
    while 1 {
        j = j + 1
        if j == 3 { break }
    }
    assert_eq(j, 3)
}

fn main() {
    test_calls()
    test_recursion()
    test_bytes()
    test_map_order()
    test_control_flow()

    print("avm smoke suite OK")
}

main()
