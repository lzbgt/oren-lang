@myorg.tag(name="avm-std-math-vec2")

import vec2 "../../lib/std/math/vec2.oren"
import math "../../lib/std/math.oren"

fn fail(code, msg) {
    print("avm std math vec2 FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_close(a: f64, b: f64, eps: f64, code, msg) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code, msg)
}

assert_close(vec2.length(3.0, 4.0), 5.0, 1e-12, 10, "length")
assert_close(vec2.distance(1.0, 2.0, 4.0, 6.0), 5.0, 1e-12, 11, "distance")
assert_close(vec2.dot(1.0, 2.0, 3.0, 4.0), 11.0, 1e-12, 12, "dot")
assert_close(vec2.cross(1.0, 0.0, 0.0, 1.0), 1.0, 1e-12, 13, "cross")
var a = vec2.add(1.0, 2.0, 3.0, 4.0)
assert_true(!oren_is_err(a), 14, "add ok")
assert_close(a[1], 6.0, 0.0, 15, "add y")
var ab = vec2.abs(0.0 - 3.0, 4.0)
assert_true(!oren_is_err(ab), 44, "abs ok")
assert_close(ab[0], 3.0, 0.0, 45, "abs x")
var sg = vec2.sign(0.0 - 3.0, 0.0)
assert_true(!oren_is_err(sg), 46, "sign ok")
assert_close(sg[0], 0.0 - 1.0, 0.0, 47, "sign x")
var rd = vec2.round(1.5, 0.0 - 1.5)
assert_true(!oren_is_err(rd), 49, "round ok")
assert_close(rd[1], 0.0 - 2.0, 0.0, 50, "round y")
var fr = vec2.fract(3.75, 0.0 - 1.25)
assert_true(!oren_is_err(fr), 51, "fract ok")
assert_close(fr[1], 0.75, 1e-12, 52, "fract y")
var st = vec2.step(0.5, 0.5, 0.25, 0.75)
assert_true(!oren_is_err(st), 54, "step ok")
assert_close(st[1], 1.0, 0.0, 55, "step y")
var sm = vec2.smoothstep(0.0, 0.0, 1.0, 2.0, 0.5, 1.0)
assert_true(!oren_is_err(sm), 56, "smoothstep ok")
assert_close(sm[0], 0.5, 1e-12, 57, "smoothstep x")
var il = vec2.inverse_lerp(0.0, 10.0, 10.0, 20.0, 2.5, 15.0)
assert_true(!oren_is_err(il), 59, "inverse_lerp ok")
assert_close(il[1], 0.5, 1e-12, 60, "inverse_lerp y")
var rc = vec2.remap_clamped(0.0, 10.0, 10.0, 20.0, 100.0, 200.0, 200.0, 400.0, 20.0, 5.0)
assert_true(!oren_is_err(rc), 61, "remap_clamped ok")
assert_close(rc[0], 200.0, 1e-12, 62, "remap_clamped x")
var sn = vec2.sin(0.0, math.pi() / 2.0)
assert_true(!oren_is_err(sn), 64, "sin ok")
assert_close(sn[1], 1.0, 1e-10, 65, "sin y")
var asn = vec2.asin(0.0, 0.5)
assert_true(!oren_is_err(asn), 67, "asin ok")
assert_close(asn[1], math.pi() / 6.0, 1e-10, 68, "asin y")
var a2 = vec2.atan2(1.0, 1.0, 1.0, 0.0 - 1.0)
assert_true(!oren_is_err(a2), 69, "atan2 ok")
assert_close(a2[1], 3.0 * math.pi() / 4.0, 1e-12, 70, "atan2 y")
var mn = vec2.min(3.0, 0.0 - 4.0, 2.0, 5.0)
assert_true(!oren_is_err(mn), 16, "min ok")
assert_close(mn[0], 2.0, 0.0, 17, "min x")
var cl = vec2.clamp(0.0 - 2.0, 7.0, 0.0, 1.0, 5.0, 6.0)
assert_true(!oren_is_err(cl), 18, "clamp ok")
assert_close(cl[1], 6.0, 0.0, 19, "clamp y")

var n = vec2.normalize(3.0, 4.0)
assert_true(!oren_is_err(n), 20, "normalize ok")
assert_close(n[0], 0.6, 1e-12, 21, "normalize x")
assert_close(n[1], 0.8, 1e-12, 22, "normalize y")

var r = vec2.rotate(1.0, 0.0, math.pi() / 2.0)
assert_true(!oren_is_err(r), 30, "rotate ok")
assert_close(r[0], 0.0, 1e-12, 31, "rotate x")
assert_close(r[1], 1.0, 1e-12, 32, "rotate y")
var p = vec2.project(3.0, 4.0, 1.0, 0.0)
assert_true(!oren_is_err(p), 33, "project ok")
assert_close(p[0], 3.0, 0.0, 34, "project x")
assert_close(p[1], 0.0, 0.0, 35, "project y")
var rf = vec2.reflect(1.0, 0.0 - 2.0, 0.0, 1.0)
assert_true(!oren_is_err(rf), 36, "reflect ok")
assert_close(rf[1], 2.0, 0.0, 37, "reflect y")

assert_true(oren_is_err(vec2.normalize(0.0, 0.0)), 40, "normalize zero errors")
assert_true(oren_is_err(vec2.length(math.inf(), 1.0)), 41, "length inf errors")
assert_true(oren_is_err(vec2.project(1.0, 2.0, 0.0, 0.0)), 42, "project zero errors")
assert_true(oren_is_err(vec2.clamp(1.0, 2.0, 5.0, 0.0, 4.0, 3.0)), 43, "clamp bounds errors")
assert_true(oren_is_err(vec2.sign(1.0, math.nan())), 48, "sign nan errors")
assert_true(oren_is_err(vec2.fract(math.inf(), 1.0)), 53, "fract inf errors")
assert_true(oren_is_err(vec2.smoothstep(1.0, 0.0, 0.5, 1.0, 0.75, 0.5)), 58, "smoothstep edge errors")
assert_true(oren_is_err(vec2.inverse_lerp(0.0, 1.0, 0.0, 2.0, 0.5, 1.5)), 63, "inverse_lerp range errors")
assert_true(oren_is_err(vec2.sin(math.inf(), 0.0)), 66, "sin inf errors")
assert_true(oren_is_err(vec2.asin(1.1, 0.0)), 71, "asin domain errors")

print("avm std math vec2 OK")
exit(0)
