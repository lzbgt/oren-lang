fn fail(msg) {
    print("FAIL")
    print(msg)
    oren_exit(1)
}

fn assert_true(x, msg) {
    if x { return 0 }
    fail(msg)
}

fn main() {
    // This test is intended to run with:
    //   --fs-backend host
    //   --deny-by-default --allow-domains "0,1,6"
    //   --fs-mounts-read  "v/=build/mnt_avm/"
    //   --fs-mounts-write "v/=build/mnt_avm/"
    //
    // The program uses ONLY virtual paths (v/...), and the host mapping is an external enrollment.

    var vpath = "v/out.txt"
    var content = "mount ok"

    var w = oren_write_file(vpath, content)
    if oren_is_err(w) { fail("write via mount failed") }

    var s = oren_read_file(vpath)
    if oren_is_err(s) { fail("read via mount failed") }
    assert_true(s == content, "content mismatch")


    // Host-path allow-as-is (parity with native mounts):
    // If the program passes an already-host-resolved path that is within an enrolled host prefix,
    // it should be allowed.
    var host_path = "build/mnt_avm/out_host.txt"
    var content2 = "host ok"
    var w3 = oren_write_file(host_path, content2)
    if oren_is_err(w3) { fail("write via host path under mount failed") }

    // Read it back via BOTH virtual and host forms.
    var s3 = oren_read_file("v/out_host.txt")
    if oren_is_err(s3) { fail("read via virtual path (host-written) failed") }
    assert_true(s3 == content2, "content mismatch (virtual read)")

    var s4 = oren_read_file(host_path)
    if oren_is_err(s4) { fail("read via host path under mount failed") }
    assert_true(s4 == content2, "content mismatch (host read)")

    // Paths that do not match any configured mount must be denied when mounts are present.
    var deny_path = "build/avm_mount_deny.txt"
    var w2 = oren_write_file(deny_path, "nope")
    assert_true(oren_is_err(w2), "expected mount deny for non-mounted path")

    oren_exit(0)
}

main()

