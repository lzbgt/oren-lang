@myorg.tag(name="avm-std-math-trig")

import math "../../lib/std/math.oren"

fn fail(code, msg) {
    print("avm std math trig FAIL " + oren_int_to_string(code) + ": " + msg)
    exit(code)
}

fn assert_true(x, code, msg) {
    if x { return 0 }
    fail(code, msg)
}

fn assert_close(a, b, eps, code, msg) {
    var d = a - b
    if d < 0.0 { d = 0.0 - d }
    if d <= eps { return 0 }
    fail(code, msg)
}

var PI = math.pi()
var TAU = math.tau()

assert_close(math.sin(0.0), 0.0, 1e-15, 10, "sin(0)")
assert_close(math.cos(0.0), 1.0, 1e-15, 11, "cos(0)")
assert_close(math.sin(PI / 2.0), 1.0, 1e-10, 12, "sin(pi/2)")
assert_close(math.cos(PI), -1.0, 1e-10, 13, "cos(pi)")
assert_close(math.sin(0.0 - PI / 2.0), -1.0, 1e-10, 14, "sin(-pi/2)")
assert_close(math.tan(0.0), 0.0, 1e-15, 15, "tan(0)")
assert_close(math.tan(PI / 4.0), 1.0, 5e-10, 16, "tan(pi/4)")
assert_close(math.tan(0.0 - PI / 4.0), -1.0, 5e-10, 17, "tan(-pi/4)")
assert_close(math.tan(PI / 6.0), 0.5773502691896257, 5e-10, 18, "tan(pi/6)")

assert_close(math.atan(1.0), PI / 4.0, 1e-12, 20, "atan(1)")
assert_close(math.atan(-1.0), 0.0 - PI / 4.0, 1e-12, 21, "atan(-1)")
assert_close(math.atan2(1.0, 1.0), PI / 4.0, 1e-12, 22, "atan2 q1")
assert_close(math.atan2(1.0, -1.0), 3.0 * PI / 4.0, 1e-12, 23, "atan2 q2")
assert_close(math.atan2(-1.0, -1.0), 0.0 - 3.0 * PI / 4.0, 1e-12, 24, "atan2 q3")
assert_close(math.atan2(-1.0, 1.0), 0.0 - PI / 4.0, 1e-12, 25, "atan2 q4")
assert_close(math.atan2(0.0, -1.0), PI, 1e-12, 26, "atan2 positive zero negative x")
assert_close(math.atan2(1.0, 0.0), PI / 2.0, 1e-12, 27, "atan2 positive y zero x")

assert_close(math.asin(0.0), 0.0, 0.0, 70, "asin zero")
assert_close(math.asin(0.5), PI / 6.0, 1e-10, 71, "asin half")
assert_close(math.asin(-0.5), 0.0 - PI / 6.0, 1e-10, 72, "asin negative half")
assert_close(math.asin(1.0), PI / 2.0, 1e-12, 73, "asin one")
assert_close(math.asin(-1.0), 0.0 - PI / 2.0, 1e-12, 74, "asin negative one")
assert_close(math.acos(1.0), 0.0, 0.0, 75, "acos one")
assert_close(math.acos(0.5), PI / 3.0, 1e-10, 76, "acos half")
assert_close(math.acos(-0.5), 2.0 * PI / 3.0, 1e-10, 77, "acos negative half")
assert_close(math.acos(-1.0), PI, 1e-12, 78, "acos negative one")

var x = 12345.6789
var xp = x + TAU
assert_true(xp != x, 30, "x+tau must be representable")

var s1 = math.sin(x)
if oren_is_err(s1) { fail(31, "sin returned err") }
var c1 = math.cos(x)
if oren_is_err(c1) { fail(32, "cos returned err") }
var sc1 = math.sincos(x)
if oren_is_err(sc1) { fail(300, "sincos returned err") }
assert_close(sc1[0], s1, 0.0, 301, "sincos sin matches")
assert_close(sc1[1], c1, 0.0, 302, "sincos cos matches")
var s2 = math.sin(xp)
if oren_is_err(s2) { fail(33, "sin x+tau returned err") }
var c2 = math.cos(xp)
if oren_is_err(c2) { fail(34, "cos x+tau returned err") }
assert_close(s1, s2, 1e-10, 35, "sin periodicity")
assert_close(c1, c2, 1e-10, 36, "cos periodicity")
var t1 = math.tan(x)
if oren_is_err(t1) { fail(361, "tan returned err") }
var t2 = math.tan(xp)
if oren_is_err(t2) { fail(362, "tan x+tau returned err") }
assert_close(t1, t2, 1e-10, 363, "tan periodicity")

var sn = math.sin(0.0 - x)
if oren_is_err(sn) { fail(37, "sin negative returned err") }
var cn = math.cos(0.0 - x)
if oren_is_err(cn) { fail(38, "cos negative returned err") }
assert_close(sn, 0.0 - s1, 1e-10, 39, "sin odd symmetry")
assert_close(cn, c1, 1e-10, 40, "cos even symmetry")

var huge = 1099511627776.0 // 2^40, beyond Cody-Waite; forces Payne-Hanek reduction.
var huge_next = huge + TAU
assert_true(huge_next != huge, 41, "huge+tau must be representable")
var hs1 = math.sin(huge)
if oren_is_err(hs1) { fail(42, "huge sin returned err") }
var hs2 = math.sin(huge_next)
if oren_is_err(hs2) { fail(43, "huge sin x+tau returned err") }
var hc1 = math.cos(huge)
if oren_is_err(hc1) { fail(44, "huge cos returned err") }
var hsc = math.sincos(huge)
if oren_is_err(hsc) { fail(303, "huge sincos returned err") }
assert_close(hsc[0], hs1, 0.0, 304, "huge sincos sin matches")
assert_close(hsc[1], hc1, 0.0, 305, "huge sincos cos matches")
var hc2 = math.cos(huge_next)
if oren_is_err(hc2) { fail(45, "huge cos x+tau returned err") }
assert_close(hs1, hs2, 1e-4, 46, "huge sin periodicity")
assert_close(hc1, hc2, 1e-4, 47, "huge cos periodicity")
var hsn = math.sin(0.0 - huge)
if oren_is_err(hsn) { fail(48, "huge negative sin returned err") }
var hcn = math.cos(0.0 - huge)
if oren_is_err(hcn) { fail(49, "huge negative cos returned err") }
assert_close(hsn, 0.0 - hs1, 1e-8, 50, "huge sin odd symmetry")
assert_close(hcn, hc1, 1e-8, 51, "huge cos even symmetry")

assert_true(oren_is_err(math.sin(math.inf())), 60, "sin(inf) must err")
assert_true(oren_is_err(math.cos(math.inf())), 61, "cos(inf) must err")
assert_true(oren_is_err(math.sincos(math.inf())), 69, "sincos(inf) must err")
assert_true(oren_is_err(math.atan(0.0 / 0.0)), 62, "atan(NaN) must err")
assert_true(oren_is_err(math.tan(math.inf())), 63, "tan(inf) must err")
assert_true(oren_is_err(math.tan(0.0 / 0.0)), 64, "tan(NaN) must err")
assert_true(oren_is_err(math.asin(1.1)), 65, "asin domain must err")
assert_true(oren_is_err(math.acos(-1.1)), 66, "acos domain must err")
assert_true(oren_is_err(math.asin(0.0 / 0.0)), 67, "asin(NaN) must err")
assert_true(oren_is_err(math.acos(0.0 / 0.0)), 68, "acos(NaN) must err")

print("avm std math trig OK")
exit(0)
