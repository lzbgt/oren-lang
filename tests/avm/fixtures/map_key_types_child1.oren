fn main() {
    var m = {}

    // Insert in one order.
    m[nil] = 1
    m[false] = 2
    m[true] = 3
    m[0] = 4
    m[1] = 5
    m["a"] = 6
    m["b"] = 7

    // Exercise GET_INDEX for all supported key types.
    var s = 0
    s = s + m[nil]
    s = s + m[false]
    s = s + m[true]
    s = s + m[0]
    s = s + m[1]
    s = s + m["a"]
    s = s + m["b"]

    print(s)
}

main()

