fn fail(code, msg) {
    print("FAIL " + oren_int_to_string(code))
    print(msg)
    oren_exit(code)
}

fn u8_at(bs, pos) {
    var v = oren_bytes_get_u8(bs, pos)
    if oren_is_err(v) { fail(9000 + pos, "bytes_get_u8 err") }
    return v
}

fn u32_le_at(bs, pos) {
    var b0 = u8_at(bs, pos + 0)
    var b1 = u8_at(bs, pos + 1)
    var b2 = u8_at(bs, pos + 2)
    var b3 = u8_at(bs, pos + 3)
    return (b0 & 255) | ((b1 & 255) << 8) | ((b2 & 255) << 16) | ((b3 & 255) << 24)
}

fn store_u32_le(outp, off, v) {
    ptr_set_byte(outp + off + 0, v & 255)
    ptr_set_byte(outp + off + 1, (v >> 8) & 255)
    ptr_set_byte(outp + off + 2, (v >> 16) & 255)
    ptr_set_byte(outp + off + 3, (v >> 24) & 255)
    return off + 4
}

fn byte_seq_len(xs) {
    if oren_is_list(xs) { return oren_list_len(xs) }
    return oren_bytes_len(xs)
}

fn byte_seq_get_u8(xs, i) {
    if oren_is_u8_buf(xs) { return ptr_get_byte(oren_buf_data_ptr_unchecked(xs) + i) & 255 }
    return oren_bytes_get_u8(xs, i)
}

fn copy_bytes_to_ptr(outp, off, xs) {
    var n = byte_seq_len(xs)
    var i = 0
    while i < n {
        ptr_set_byte(outp + off + i, byte_seq_get_u8(xs, i) & 255)
        i = i + 1
    }
    return off + n
}

fn build_vfs_fixtures(files) {
    // AVMVFS01 format:
    //   magic[8]="AVMVFS01"
    //   u32 count
    //   repeated:
    //     u32 path_len, path bytes
    //     u32 body_len, body bytes
    if files == nil { files = [] }
    var file_count = oren_list_len(files)
    var total = 8 + 4

    var i = 0
    while i < file_count {
        var f = files[i]
        var path = f["path"]
        var body = f["body"]
        if path == nil { path = "" }
        if body == nil { body = [] }
        var path_bytes = oren_bytes_from_string(path)
        total = total + 4 + byte_seq_len(path_bytes) + 4 + byte_seq_len(body)
        i = i + 1
    }

    var out = oren_u8_buf_new_uninit(total)
    var outp = oren_buf_data_ptr_unchecked(out)
    var off = 0

    // "AVMVFS01"
    ptr_set_byte(outp + off + 0, 65) // A
    ptr_set_byte(outp + off + 1, 86) // V
    ptr_set_byte(outp + off + 2, 77) // M
    ptr_set_byte(outp + off + 3, 86) // V
    ptr_set_byte(outp + off + 4, 70) // F
    ptr_set_byte(outp + off + 5, 83) // S
    ptr_set_byte(outp + off + 6, 48) // 0
    ptr_set_byte(outp + off + 7, 49) // 1
    off = off + 8

    off = store_u32_le(outp, off, file_count)

    i = 0
    while i < file_count {
        var f2 = files[i]
        var path2 = f2["path"]
        var body2 = f2["body"]
        if path2 == nil { path2 = "" }
        if body2 == nil { body2 = [] }

        var path_bytes2 = oren_bytes_from_string(path2)
        off = store_u32_le(outp, off, byte_seq_len(path_bytes2))
        off = copy_bytes_to_ptr(outp, off, path_bytes2)
        off = store_u32_le(outp, off, byte_seq_len(body2))
        off = copy_bytes_to_ptr(outp, off, body2)

        i = i + 1
    }

    return out
}

fn vfs_extract_body(snapshot_bytes, want_path_str) {
    // Returns BYTES for body, or err via fail().
    if oren_bytes_len(snapshot_bytes) < 12 { fail(100, "snapshot too short") }
    // Magic "AVMVFS01"
    if u8_at(snapshot_bytes, 0) != 65 { fail(101, "bad magic") } // A
    if u8_at(snapshot_bytes, 7) != 49 { fail(102, "bad magic") } // 1

    var pos = 8
    var cnt = u32_le_at(snapshot_bytes, pos)
    pos = pos + 4

    var want = oren_bytes_from_string(want_path_str)
    var want_len = byte_seq_len(want)

    var i = 0
    while i < cnt {
        var pl = u32_le_at(snapshot_bytes, pos)
        pos = pos + 4

        var is_match = 0
        if pl == want_len {
            is_match = 1
            var j = 0
            while j < pl {
                if u8_at(snapshot_bytes, pos + j) != oren_bytes_get_u8(want, j) { is_match = 0 }
                j = j + 1
            }
        }
        pos = pos + pl

        var bl = u32_le_at(snapshot_bytes, pos)
        pos = pos + 4

        if is_match != 0 {
            return oren_u8_buf_from_bytes_slice(snapshot_bytes, pos, bl)
        }

        pos = pos + bl
        i = i + 1
    }

    pos = 8 + 4
    i = 0
    while i < cnt {
        var pl2 = u32_le_at(snapshot_bytes, pos)
        pos = pos + 4
        var name_bytes = []
        var j2 = 0
        while j2 < pl2 {
            oren_list_push(name_bytes, u8_at(snapshot_bytes, pos + j2))
            j2 = j2 + 1
        }
        print("snapshot path: " + oren_string_from_bytes(name_bytes))
        pos = pos + pl2
        var bl2 = u32_le_at(snapshot_bytes, pos)
        pos = pos + 4 + bl2
        i = i + 1
    }
    fail(110, "path not found in vfs snapshot: " + want_path_str)
    return 0
}

fn main() {
    // Parent (host) provides:
    // - compiler `.obc`
    // - stdlib bundle `.obc` (OBX exports)
    var compiler_obc = oren_read_u8_buf("build/oren_compiler.obc")

    var stdlib_obc_bytes = oren_read_u8_buf("build/stdlib_bundle.obc")

    var src_bytes = oren_read_u8_buf("tests/fixtures/ios_avm/compilerkit_app_scale.oren")
    if oren_is_err(src_bytes) {
        print("source read error: " + oren_err_msg(src_bytes))
        fail(120, "app-scale source read failed")
    }

    var files = [
        {"path": "src.oren", "body": src_bytes},
        {"path": "stdlib.obc", "body": stdlib_obc_bytes}
    ]
    var vfs_fx = build_vfs_fixtures(files)

    var cfg_compile = {
        "deterministic": true,
        "gas_limit": 500000000,
        "fs_backend": 1,
        "vfs_fixtures": vfs_fx,
        "argv": [
            "oren",
            "build",
            "src.oren",
            "--backend", "bytecode",
            "--platform", "arm64-macos",
            "--no-cache",
            "--deterministic",
            "--stdlib-mode", "obc",
            "--stdlib-obc", "stdlib.obc",
            "-o", "out.obc"
        ]
    }

    var cr = oren_avm_run_obc_bytes(compiler_obc, cfg_compile)
    if oren_is_err(cr) {
        print("compiler child launch error: " + oren_err_msg(cr))
        fail(199, "compiler child launch failed")
    }
    if cr["exit_code"] != 0 {
        print("compiler child exit_code=" + oren_int_to_string(cr["exit_code"]))
        var e = cr["last_error"]
        if oren_is_err(e) {
            print("err_code=" + oren_int_to_string(oren_err_code(e)))
            print("err_msg=" + oren_err_msg(e))
        }
        fail(200, "compiler child failed")
    }

    var snap = cr["vfs_snapshot"]
    if oren_is_err(snap) { fail(201, "vfs_snapshot is err") }
    if snap == nil { fail(202, "vfs_snapshot is nil") }

    var program_obc = vfs_extract_body(snap, "out.obc")

    var cfg_run = {
        "deterministic": true,
        "gas_limit": 1000000,
        "allowed_domains": (1 << 0) + (1 << 2) + (1 << 6)
    }
    var pr = oren_avm_run_obc_bytes(program_obc, cfg_run)
    if pr["exit_code"] != 7 {
        print("program exit_code=" + oren_int_to_string(pr["exit_code"]))
        var pe = pr["last_error"]
        if oren_is_err(pe) {
            print("program err_code=" + oren_int_to_string(oren_err_code(pe)))
            print("program err_msg=" + oren_err_msg(pe))
        }
        fail(300, "compiled program exit_code mismatch")
    }

    print("compiler in avm vfs stdlib obc OK")
    oren_exit(0)
}

main()
