import coro "../../lib/std/coroutine.oren"
import reflect "../../lib/std/reflect.oren"

fn fail(code) {
    print("avm coroutine_v0 FAIL " + oren_int_to_string(code))
    exit(code)
}

fn assert_true(x, code) {
    if x { return 0 }
    fail(code)
}

fn assert_eq(a, b, code) {
    if a == b { return 0 }
    fail(code)
}

fn counter_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 100)
    assert_true(reflect.is_coroutine_context(co) == true, 101)
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 5
}

fn list_worker(co, args) {
    var seed = args[0]
    var i = 0
    while i < 3 {
        yield (seed + i) in co
        i = i + 1
    }
    return seed + 30
}

fn cancel_probe_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 115)
    assert_true(coro.is_cancel_requested(co) == false, 116)
    assert_true(coro.cancel_reason(co) == nil, 117)
    var seed = args[0]
    var reason = args[1]
    var resumed = yield seed in co
    assert_true(coro.is_cancel_requested(co) == true, 118)
    assert_eq(coro.cancel_reason(co), reason, 119)
    return resumed + reason
}

fn cancel_delegate_outer_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 1191)
    var inner = coro.start(cancel_probe_worker, [args[0], args[1]])
    var retv = coro.delegate(co, inner)
    assert_true(oren_is_err(retv) == false, 1192)
    return retv
}

fn cancel_delegate_capture_outer_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 1193)
    var cells = args[0]
    var inner = coro.start(cancel_probe_worker, [args[1], args[2]])
    cells[0] = inner
    var retv = coro.delegate(co, inner)
    assert_true(oren_is_err(retv) == false, 1194)
    return retv
}

fn delegate_inner_worker(co, args) {
    var seed = args[0]
    var resumed0 = yield (seed + 1) in co
    var resumed1 = yield (seed + resumed0) in co
    return resumed1 + 50
}

fn delegate_outer_worker(co, args) {
    var inner = coro.start(delegate_inner_worker, [args[0]])
    var retv = coro.delegate(co, inner)
    if oren_is_err(retv) == true { return -120 }
    return retv + 21
}

fn delegate_step_outer_worker(co, args) {
    var inner = coro.start(delegate_inner_worker, [args[0]])
    var step0 = coro.next(inner)
    if oren_is_err(step0) == true { return -130 }
    assert_eq(step0["value"], args[0] + 1, 131)
    var retv = coro.delegate_step(co, inner, step0)
    if oren_is_err(retv) == true { return -132 }
    return retv + 13
}

fn hook_worker(co, args) {
    var box = args[0]
    var base = args[1]
    var r0 = coro.on_finalize(co, || { oren_list_push(box, base + 1); return nil })
    if oren_is_err(r0) == true { return -140 }
    var r1 = coro.on_close(co, || { oren_list_push(box, base + 2); return nil })
    if oren_is_err(r1) == true { return -141 }
    var resumed = yield base in co
    return resumed + base + 5
}

fn hook_err_worker(co, args) {
    assert_true(reflect.is_generator_context(co) == true, 160)
    var box = args[0]
    var r0 = coro.on_close(co, || { oren_list_push(box, 1); return nil })
    assert_true(oren_is_err(r0) == false, 161)
    var r1 = coro.on_close(co, || { oren_list_push(box, 2); return oren_err(79, "coroutine close hook boom") })
    assert_true(oren_is_err(r1) == false, 162)
    yield 1 in co
    return 0
}

fn main() {
    var c0 = coro.start(counter_worker, [40])
    assert_eq(oren_type_name(c0), "generator", 1)
    assert_true(reflect.is_coroutine(c0) == true, 2)
    assert_true(reflect.is_coroutine_context(123) == false, 201)
    assert_true(coro.is_started(c0) == false, 202)
    assert_true(coro.current_step(c0) == nil, 203)
    assert_true(coro.is_closed(c0) == false, 2031)
    assert_true(coro.terminal_error(c0) == nil, 2032)
    var c0s0 = coro.next(c0)
    assert_eq(c0s0["value"], 41, 3)
    var c0peek0 = coro.current_step(c0)
    assert_true(c0peek0 != nil, 204)
    assert_true(c0peek0["ok"] == true, 205)
    assert_true(c0peek0["done"] == false, 206)
    assert_eq(c0peek0["value"], 41, 207)
    assert_true(coro.is_started(c0) == true, 208)
    var c0s1 = coro.send(c0, 2)
    assert_eq(c0s1["value"], 42, 4)
    var c0peek1 = coro.current_step(c0)
    assert_true(c0peek1 != nil, 209)
    assert_eq(c0peek1["value"], 42, 210)
    var c0s2 = coro.send(c0, 7)
    assert_eq(c0s2["return"], 12, 5)
    assert_true(coro.is_done(c0) == true, 6)
    assert_eq(coro.return_value(c0), 12, 7)
    assert_true(coro.current_step(c0) == nil, 211)
    assert_true(coro.is_closed(c0) == false, 2111)
    assert_true(coro.terminal_error(c0) == nil, 2112)

    assert_true(oren_is_err(coro.next(123)) == true, 8)
    assert_true(oren_is_err(coro.send(123, 1)) == true, 9)
    assert_true(oren_is_err(coro.collect(123)) == true, 10)
    assert_true(oren_is_err(coro.close(123)) == true, 11)
    assert_true(oren_is_err(coro.cancel(123, 1)) == true, 1101)
    assert_true(oren_is_err(coro.request_cancel(123, 1)) == true, 111)
    assert_true(oren_is_err(coro.request_cancel_after(123, 0, 1)) == true, 1111)
    assert_true(oren_is_err(coro.cancel_after(123, 0, 1)) == true, 1112)
    assert_true(coro.is_started(123) == false, 212)
    assert_true(coro.is_cancel_requested(123) == false, 2121)
    assert_true(coro.cancel_reason(123) == nil, 2122)
    assert_true(coro.current_step(123) == nil, 213)
    assert_true(coro.is_closed(123) == false, 2131)
    assert_true(coro.terminal_error(123) == nil, 2132)

    var c1 = coro.start(list_worker, [5])
    var xs = coro.collect(c1)
    assert_eq(oren_list_len(xs), 3, 12)
    assert_eq(xs[0], 5, 13)
    assert_eq(xs[1], 6, 14)
    assert_eq(xs[2], 7, 15)
    assert_eq(coro.return_value(c1), 35, 16)
    assert_true(coro.is_closed(c1) == false, 1611)
    assert_true(coro.terminal_error(c1) == nil, 1612)

    var c1b = coro.start(cancel_probe_worker, [50, 70])
    assert_true(coro.is_cancel_requested(c1b) == false, 1613)
    assert_true(coro.cancel_reason(c1b) == nil, 1614)
    var c1bs0 = coro.next(c1b)
    assert_true(oren_is_err(c1bs0) == false, 1615)
    assert_eq(c1bs0["value"], 50, 1616)
    var c1breq0 = coro.request_cancel(c1b, 70)
    assert_true(oren_is_err(c1breq0) == false, 1617)
    assert_true(c1breq0 == nil, 1618)
    assert_true(coro.is_cancel_requested(c1b) == true, 1619)
    assert_eq(coro.cancel_reason(c1b), 70, 1620)
    var c1breq1 = coro.request_cancel(c1b, 99)
    assert_true(oren_is_err(c1breq1) == false, 1621)
    assert_eq(coro.cancel_reason(c1b), 70, 1622)
    var c1bs1 = coro.send(c1b, 3)
    assert_true(oren_is_err(c1bs1) == false, 1623)
    assert_true(c1bs1["done"] == true, 1624)
    assert_eq(c1bs1["return"], 73, 1625)
    assert_true(coro.is_done(c1b) == true, 1626)
    assert_eq(coro.return_value(c1b), 73, 1627)
    assert_true(coro.is_closed(c1b) == false, 1628)
    assert_true(coro.terminal_error(c1b) == nil, 1629)
    assert_true(coro.is_cancel_requested(c1b) == true, 1630)
    assert_eq(coro.cancel_reason(c1b), 70, 1631)

    var c1bt = coro.start(cancel_probe_worker, [55, 75])
    var c1bt0 = coro.next(c1bt)
    assert_true(oren_is_err(c1bt0) == false, 16311)
    assert_eq(c1bt0["value"], 55, 16312)
    var c1btw = coro.request_cancel_after(c1bt, 0, 75)
    assert_true(oren_is_err(c1btw) == false, 16313)
    var c1btwr = oren_join_timeout(c1btw, 2000)
    assert_true(oren_is_err(c1btwr) == false, 16314)
    assert_true(c1btwr == nil, 16315)
    assert_true(coro.is_cancel_requested(c1bt) == true, 16316)
    assert_eq(coro.cancel_reason(c1bt), 75, 16317)
    var c1bt1 = coro.send(c1bt, 4)
    assert_true(oren_is_err(c1bt1) == false, 16318)
    assert_true(c1bt1["done"] == true, 16319)
    assert_eq(c1bt1["return"], 79, 16320)

    var c1btbad = coro.request_cancel_after(c1bt, "bad", 1)
    assert_true(oren_is_err(c1btbad) == true, 163201)

    var c1btn = coro.start(cancel_probe_worker, [56, 76])
    var c1btn0 = coro.next(c1btn)
    assert_true(oren_is_err(c1btn0) == false, 163202)
    assert_eq(c1btn0["value"], 56, 163203)
    var c1btnw = coro.request_cancel_after(c1btn, nil, 76)
    assert_true(oren_is_err(c1btnw) == false, 163204)
    var c1btnwr = oren_join_timeout(c1btnw, 2000)
    assert_true(oren_is_err(c1btnwr) == false, 163205)
    assert_true(c1btnwr == nil, 163206)
    assert_true(coro.is_cancel_requested(c1btn) == true, 163207)
    assert_eq(coro.cancel_reason(c1btn), 76, 163208)
    var c1btn1 = coro.send(c1btn, 4)
    assert_true(oren_is_err(c1btn1) == false, 163209)
    assert_true(c1btn1["done"] == true, 163210)
    assert_eq(c1btn1["return"], 80, 163211)

    var c1c = coro.start(cancel_delegate_outer_worker, [60, 80])
    var c1cs0 = coro.next(c1c)
    assert_true(oren_is_err(c1cs0) == false, 1632)
    assert_eq(c1cs0["value"], 60, 1633)
    var c1creq0 = coro.request_cancel(c1c, 80)
    assert_true(oren_is_err(c1creq0) == false, 1634)
    assert_true(coro.is_cancel_requested(c1c) == true, 1635)
    assert_eq(coro.cancel_reason(c1c), 80, 1636)
    var c1cs1 = coro.send(c1c, 4)
    assert_true(oren_is_err(c1cs1) == false, 1637)
    assert_true(c1cs1["done"] == true, 1638)
    assert_eq(c1cs1["return"], 84, 1639)

    var c1d = coro.start(counter_worker, [20])
    var c1ds0 = coro.next(c1d)
    assert_true(oren_is_err(c1ds0) == false, 1640)
    assert_eq(c1ds0["value"], 21, 1641)
    var c1dc0 = coro.cancel(c1d, 71)
    assert_true(oren_is_err(c1dc0) == false, 1642)
    assert_true(c1dc0 == nil, 1643)
    assert_true(coro.is_done(c1d) == true, 1644)
    assert_true(coro.is_closed(c1d) == true, 1645)
    assert_true(coro.return_value(c1d) == nil, 1646)
    assert_true(coro.terminal_error(c1d) == nil, 1647)
    assert_true(coro.is_cancel_requested(c1d) == true, 1648)
    assert_eq(coro.cancel_reason(c1d), 71, 1649)
    var c1dstep = coro.next(c1d)
    assert_true(oren_is_err(c1dstep) == false, 1650)
    assert_true(c1dstep["done"] == true, 1651)
    assert_true(c1dstep["return"] == nil, 1652)
    var c1dc1 = coro.cancel(c1d, 99)
    assert_true(oren_is_err(c1dc1) == false, 1653)
    assert_true(c1dc1 == nil, 1654)
    assert_eq(coro.cancel_reason(c1d), 71, 1655)

    var c1dt = coro.start(counter_worker, [22])
    var c1dt0 = coro.next(c1dt)
    assert_true(oren_is_err(c1dt0) == false, 16551)
    assert_eq(c1dt0["value"], 23, 16552)
    var c1dtw = coro.cancel_after(c1dt, 0, 81)
    assert_true(oren_is_err(c1dtw) == false, 16553)
    var c1dtwr = oren_join_timeout(c1dtw, 2000)
    assert_true(oren_is_err(c1dtwr) == false, 16554)
    assert_true(c1dtwr == nil, 16555)
    assert_true(coro.is_done(c1dt) == true, 16556)
    assert_true(coro.is_closed(c1dt) == true, 16557)
    assert_true(coro.is_cancel_requested(c1dt) == true, 16558)
    assert_eq(coro.cancel_reason(c1dt), 81, 16559)

    var c1dtn = coro.start(counter_worker, [24])
    var c1dtn0 = coro.next(c1dtn)
    assert_true(oren_is_err(c1dtn0) == false, 165591)
    assert_eq(c1dtn0["value"], 25, 165592)
    var c1dtnw = coro.cancel_after(c1dtn, -5, 83)
    assert_true(oren_is_err(c1dtnw) == false, 165593)
    var c1dtnwr = oren_join_timeout(c1dtnw, 2000)
    assert_true(oren_is_err(c1dtnwr) == false, 165594)
    assert_true(c1dtnwr == nil, 165595)
    assert_true(coro.is_done(c1dtn) == true, 165596)
    assert_true(coro.is_closed(c1dtn) == true, 165597)
    assert_true(coro.is_cancel_requested(c1dtn) == true, 165598)
    assert_eq(coro.cancel_reason(c1dtn), 83, 165599)

    var c1dcells = [nil]
    var c1e = coro.start(cancel_delegate_capture_outer_worker, [c1dcells, 60, 80])
    var c1es0 = coro.next(c1e)
    assert_true(oren_is_err(c1es0) == false, 1656)
    assert_eq(c1es0["value"], 60, 1657)
    var c1einner = c1dcells[0]
    assert_true(reflect.is_coroutine(c1einner) == true, 1658)
    var c1ec0 = coro.cancel(c1e, 80)
    assert_true(oren_is_err(c1ec0) == false, 1659)
    assert_true(c1ec0 == nil, 1660)
    assert_true(coro.is_done(c1e) == true, 1661)
    assert_true(coro.is_closed(c1e) == true, 1662)
    assert_true(coro.is_cancel_requested(c1e) == true, 1663)
    assert_eq(coro.cancel_reason(c1e), 80, 1664)
    assert_true(coro.is_done(c1einner) == true, 1665)
    assert_true(coro.is_closed(c1einner) == true, 1666)
    assert_true(coro.is_cancel_requested(c1einner) == true, 1667)
    assert_eq(coro.cancel_reason(c1einner), 80, 1668)

    var c1f = coro.start(counter_worker, [15])
    var c1fs0 = coro.next(c1f)
    assert_true(oren_is_err(c1fs0) == false, 1669)
    assert_eq(c1fs0["value"], 16, 1670)
    var c1fs1 = coro.send(c1f, 4)
    assert_true(oren_is_err(c1fs1) == false, 1671)
    assert_eq(c1fs1["value"], 19, 1672)
    var c1fs2 = coro.send(c1f, 9)
    assert_true(oren_is_err(c1fs2) == false, 1673)
    assert_true(c1fs2["done"] == true, 1674)
    assert_eq(c1fs2["return"], 14, 1675)
    var c1fc0 = coro.cancel(c1f, 120)
    assert_true(oren_is_err(c1fc0) == false, 1676)
    assert_eq(c1fc0, 14, 1677)
    assert_true(coro.is_cancel_requested(c1f) == false, 1678)
    assert_true(coro.cancel_reason(c1f) == nil, 1679)

    var c1ft = coro.start(counter_worker, [18])
    var c1ft0 = coro.next(c1ft)
    assert_true(oren_is_err(c1ft0) == false, 16791)
    assert_eq(c1ft0["value"], 19, 16792)
    var c1ft1 = coro.send(c1ft, 4)
    assert_true(oren_is_err(c1ft1) == false, 16793)
    assert_eq(c1ft1["value"], 22, 16794)
    var c1ft2 = coro.send(c1ft, 9)
    assert_true(oren_is_err(c1ft2) == false, 16795)
    assert_true(c1ft2["done"] == true, 16796)
    assert_eq(c1ft2["return"], 14, 16797)
    var c1fth = coro.cancel_after(c1ft, 0, 120)
    assert_true(oren_is_err(c1fth) == false, 16798)
    var c1ftw = oren_join_timeout(c1fth, 2000)
    assert_true(oren_is_err(c1ftw) == false, 16799)
    assert_eq(c1ftw, 14, 16800)
    assert_true(coro.is_cancel_requested(c1ft) == false, 16801)
    assert_true(coro.cancel_reason(c1ft) == nil, 16802)

    var c2 = coro.start(delegate_outer_worker, [30])
    assert_eq(coro.next(c2)["value"], 31, 17)
    assert_eq(coro.send(c2, 4)["value"], 34, 18)
    assert_eq(coro.send(c2, 9)["return"], 80, 19)

    var c3 = coro.start(delegate_step_outer_worker, [50])
    assert_eq(coro.next(c3)["value"], 51, 20)
    assert_eq(coro.send(c3, 4)["value"], 54, 21)
    assert_eq(coro.send(c3, 8)["return"], 71, 22)

    var box = []
    var c4 = coro.start(hook_worker, [box, 80])
    assert_eq(coro.next(c4)["value"], 80, 23)
    assert_eq(coro.current_step(c4)["value"], 80, 214)
    assert_true(coro.close(c4) == nil, 24)
    assert_true(coro.current_step(c4) == nil, 215)
    assert_true(coro.is_closed(c4) == true, 2151)
    assert_true(coro.terminal_error(c4) == nil, 2152)
    assert_true(coro.is_cancel_requested(c4) == false, 2153)
    assert_true(coro.cancel_reason(c4) == nil, 2154)
    assert_eq(oren_list_len(box), 2, 25)
    assert_eq(box[0], 82, 26)
    assert_eq(box[1], 81, 27)

    var c4b = coro.start(counter_worker, [15])
    var c4bs0 = coro.next(c4b)
    assert_true(oren_is_err(c4bs0) == false, 271)
    assert_eq(c4bs0["value"], 16, 272)
    var c4breq0 = coro.request_cancel(c4b, 90)
    assert_true(oren_is_err(c4breq0) == false, 273)
    var c4bclose = coro.close(c4b)
    assert_true(oren_is_err(c4bclose) == false, 274)
    assert_true(c4bclose == nil, 275)
    assert_true(coro.is_done(c4b) == true, 276)
    assert_true(coro.is_closed(c4b) == true, 277)
    assert_true(coro.is_cancel_requested(c4b) == true, 278)
    assert_eq(coro.cancel_reason(c4b), 90, 279)

    var err_box = []
    var c5 = coro.start(hook_err_worker, [err_box])
    assert_eq(coro.next(c5)["value"], 1, 28)
    assert_true(oren_is_err(coro.close(c5)) == true, 29)
    assert_true(coro.is_done(c5) == true, 30)
    assert_true(coro.is_closed(c5) == true, 31)
    assert_true(oren_is_err(coro.terminal_error(c5)) == true, 32)
    assert_true(coro.return_value(c5) == nil, 33)
    assert_eq(oren_list_len(err_box), 2, 34)
    assert_eq(err_box[0], 2, 35)
    assert_eq(err_box[1], 1, 36)

    print("avm coroutine_v0 OK")
}
